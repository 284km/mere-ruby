// RubyVM::AbstractSyntaxTree::Node objects, made from the tree m_ast.mere
// built (m_ast_out.mere) -- the last step of RubyVM::AbstractSyntaxTree.parse.
//
// Every node of the tree is made at once: an object of the class with the
// instance variables its readers answer (the prelude's `class Node` in
// m_driver.mere has the attr_readers), and its children as ast.c's
// node_children lists them (ao_children). No Ruby runs; a tree of ruby's
// test files is a million nodes, three times over in test_ast.
//
//   @type @children @first_lineno @first_column @last_lineno @last_column
//   @node_id   the node's number in the tree, parents first
//   @__ast     what the whole tree shares (script lines, tokens), as given
//   @__xl      only on a node that answers more than its own location in
//              #locations: the others, each [line, column, line, column] or nil

// (the node type names by number, filled at the first tree)
let ao_names = vec_new ();
let ao_names_init = fn (u: unit) ->
  if vec_len ao_names > 0 then ()
  else list_iter (str_split (ao_type_names ()) " ") (fn (nm: str) -> (let _ = vec_push ao_names (sym_note nm) in ()));

// An Integer of the decoded tree (pm_ig: sign, word count, 32-bit words from
// the least significant) as the value it is.
let ast_int_val = fn (neg: int) -> fn (ig: int) ->
  let n = vec_get pm_ig (ig + 1) in
  if n == 0 then VInt 0
  else if n == 1 then (let w = vec_get pm_ig (ig + 2) in VInt (if neg == 1 then 0 - w else w))
  else if n == 2 && vec_get pm_ig (ig + 3) < 2147483648 then
    (let v = vec_get pm_ig (ig + 3) * 4294967296 + vec_get pm_ig (ig + 2) in VInt (if neg == 1 then 0 - v else v))
  else
    (let rec dec = fn (i: int) -> fn (acc: str) ->
       if i < 0 then acc else dec (i - 1) (big_add_s (big_mul_s acc "4294967296") (str_of_int (vec_get pm_ig (ig + 2 + i)))) in
     let d = dec (n - 1) "0" in
     norm_big (if neg == 1 then "-" ++ d else d));

// The Node of the record `root` and everything under it.
//   astv      the value every node's @__ast is
//   symof     the Symbol a name is, in the program's encoding or, when
//             its second argument names one, in that (id_of_enc)
//   lit_slow  the value of a literal this file does not make itself (a
//             Rational, an imaginary, a Regexp, an Encoding), by its offset
//             in ao_l
let ast_obj_build = fn (root: int) -> fn (astv: Val) -> fn symof -> fn lit_slow ->
  let _ = ao_names_init () in
  let idx = "type" ++ chr 2 ++ "children" ++ chr 2 ++ "first_lineno" ++ chr 2 ++ "first_column" ++ chr 2
            ++ "last_lineno" ++ chr 2 ++ "last_column" ++ chr 2 ++ "node_id" ++ chr 2 ++ "__ast" in
  let idx_xl = idx ++ chr 2 ++ "__xl" in
  region AOB {
    // (how many nodes are made: the next node's id)
    let made = vec_new () in
    let _ = vec_push made 0 in
    let lit = fn (l: int) ->
      (let k = vec_get ao_l l in
       if k == 1 then ast_int_val (vec_get ao_l (l + 1)) (vec_get ao_l (l + 2))
       else if k == 2 then VFlt (float_of_bits (vec_get ao_l (l + 1)) (vec_get ao_l (l + 2)))
       else if k == 5 then mkstr_e (vec_get ao_s (vec_get ao_l (l + 1))) (ao_enc_name (vec_get ao_l (l + 2)))
       else lit_slow l) in
    let rec node = fn (r: int) ->
      (let _ = ao_children r in
       // (the children are copied out: making a child's node reuses ao_k)
       let nk = vec_len ao_k in
       let rec copy = fn (i: int) -> if i >= nk then (Nil : int list) else Cons (vec_get ao_k i, copy (i + 1)) in
       let ks = copy 0 in
       let id = alloc_oid obj_cls in
       let _ = map_set obj_cls id "RubyVM::AbstractSyntaxTree::Node" in
       let nid = vec_get made 0 in
       let _ = vec_set made 0 (nid + 1) in
       let b = a_beg r in
       let e = a_end r in
       let x = vec_get ao_n (r + 3) in
       let sid = str_of_int id ++ "@" in
       let _ = iv_file_new sid (if x != 0 then idx_xl else idx) in
       let _ = iv_put_new ivars_g (sid ++ "type") (VSym (vec_get ao_names (a_ty r))) in
       let _ = iv_put_new ivars_g (sid ++ "first_lineno") (VInt (ao_lineno b)) in
       let _ = iv_put_new ivars_g (sid ++ "first_column") (VInt (ao_column b)) in
       let _ = iv_put_new ivars_g (sid ++ "last_lineno") (VInt (ao_lineno e)) in
       let _ = iv_put_new ivars_g (sid ++ "last_column") (VInt (ao_column e)) in
       let _ = iv_put_new ivars_g (sid ++ "node_id") (VInt nid) in
       let _ = iv_put_new ivars_g (sid ++ "__ast") astv in
       let _ = (if x == 0 then ()
                else
                  (let nx = vec_get ao_x x in
                   let rec xs = fn (i: int) ->
                     if i >= nx then (Nil : Val list)
                     else
                       (let xb = vec_get ao_x (x + 1 + i * 2) in
                        let xe = vec_get ao_x (x + 2 + i * 2) in
                        let v = (if xb < 0 then VNil
                                 else arr_new (Cons (VInt (ao_lineno xb), Cons (VInt (ao_column xb),
                                               Cons (VInt (ao_lineno xe), Cons (VInt (ao_column xe), Nil)))))) in
                        Cons (v, xs (i + 1))) in
                   iv_put_new ivars_g (sid ++ "__xl") (arr_new (xs 0)))) in
       let kv = kids ks in
       let _ = iv_put_new ivars_g (sid ++ "children") (arr_new kv) in
       VObj id)
    and kids = fn (ks: int list) ->
      (match ks with
       | Nil -> (Nil : Val list)
       | Cons (k, t) -> (let v = kid k in Cons (v, kids t)))
    and kid = fn (k: int) ->
      (let t = k_tag k in
       let v = k_val k in
       if t == 0 then VNil
       else if t == 1 then node v
       else if t == 2 then symof (vec_get ao_s v) (id_enc_mark v)
       else if t == 3 then VInt v
       else if t == 4 then lit v
       else if t == 5 then VBool (v == 1)
       else
         (let n = vec_get ao_a v in
          let rec each = fn (i: int) ->
            if i >= n then (Nil : Val list) else (let x = kid (vec_get ao_a (v + 1 + i)) in Cons (x, each (i + 1))) in
          arr_new (each 0))) in
    let rootv = node root in
    // (counted toward the next collection, as m_prism_load.mere's nodes are)
    let _ = vec_set qv_ctr 3 (vec_get qv_ctr 3 + vec_get made 0 * 512) in
    rootv
  };
