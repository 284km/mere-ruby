// The C side of native extensions: every extern the interpreter declares for
// it, in one module. A target with no C beside it (the Wasm build's source
// tree, tools/nothreads_tree.sh) puts m_native_none.mere in this file's place.
// (the first probes: not part of a proposed production API)
extern fn mr_probe_load: str -> int;
extern fn mr_probe_error: unit -> str;
extern fn mr_probe_find: str -> int;
extern fn mr_probe_call: int -> float -> float -> float;
extern fn mr_probe_hold: int -> int;
extern fn mr_probe_held: unit -> int;
extern fn mr_probe_mark: unit -> int;
extern fn mr_probe_slot_put: int -> int -> int;
extern fn mr_probe_slot_get: int -> int;
extern fn mr_probe_watch_string: int -> int;
extern fn mr_probe_watched_string: unit -> int;
extern fn mr_probe_echo_token: int -> int;
import "tools/native_probe/reentry.mere";
import "tools/native_probe/exception_api.mere";
