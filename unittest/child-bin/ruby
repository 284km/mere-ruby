#!/bin/sh
# PATH and /usr/bin/env ruby children must use the selected side too.
# Do not silently fall back to a host Ruby when the measurement is unset.
case "${UNITTEST_CHILD_RUBY:-}" in
  /*) exec "$UNITTEST_CHILD_RUBY" "$@" ;;
  *) echo 'measurement ruby: an absolute UNITTEST_CHILD_RUBY is required' >&2; exit 2 ;;
esac
