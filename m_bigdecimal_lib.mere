    "\n" ++
    "    # kind: :finite (c > 0), :zero, :inf, :nan; sign +1/-1\n" ++
    "    def __make(kind, sign, c = 0, e = 0)\n" ++
    "      @__making = true\n" ++
    "      begin\n" ++
    "        o = allocate\n" ++
    "      ensure\n" ++
    "        @__making = false\n" ++
    "      end\n" ++
