    "class BigDecimal < Numeric\n" ++
    "  VERSION = \"4.0.1\"\n" ++
    "  BASE = 1_000_000_000\n" ++
    "\n" ++
    "  EXCEPTION_ALL = 0xff\n" ++
    "  EXCEPTION_INFINITY = 0x01\n" ++
    "  EXCEPTION_NaN = 0x02\n" ++
    "  EXCEPTION_UNDERFLOW = 0x04\n" ++
    "  EXCEPTION_OVERFLOW = 0x01\n" ++
    "  EXCEPTION_ZERODIVIDE = 0x10\n" ++
    "\n" ++
    "  ROUND_MODE = 0x100\n" ++
    "  ROUND_UP = 1\n" ++
    "  ROUND_DOWN = 2\n" ++
    "  ROUND_HALF_UP = 3\n" ++
    "  ROUND_HALF_DOWN = 4\n" ++
    "  ROUND_CEILING = 5\n" ++
    "  ROUND_FLOOR = 6\n" ++
    "  ROUND_HALF_EVEN = 7\n" ++
    "\n" ++
    "  SIGN_NaN = 0\n" ++
    "  SIGN_POSITIVE_ZERO = 1\n" ++
    "  SIGN_NEGATIVE_ZERO = -1\n" ++
