    "\n" ++
    "    def save_exception_mode\n" ++
    "      saved = __exception_mode\n" ++
    "      yield\n" ++
    "    ensure\n" ++
    "      Thread.current[:\"BigDecimal.exception_mode\"] = saved\n" ++
    "    end\n" ++
    "\n" ++
    "    def save_rounding_mode\n" ++
    "      saved = __rounding_mode\n" ++
    "      yield\n" ++
    "    ensure\n" ++
    "      Thread.current[:\"BigDecimal.rounding_mode\"] = saved\n" ++
    "    end\n" ++
    "\n" ++
    "    def save_limit\n" ++
    "      saved = __limit\n" ++
    "      yield\n" ++
    "    ensure\n" ++
