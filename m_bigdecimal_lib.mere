    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- the parts -----------------------------------------------------------\n" ++
    "\n" ++
    "  def __kind = @kind\n" ++
    "  def __sign = @sign\n" ++
    "  def __c = @c\n" ++
    "  def __e = @e\n" ++
