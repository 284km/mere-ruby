    "    # ---- the thread-local modes (rb_thread_local_aref, as the extension) --\n" ++
    "\n" ++
    "    def __exception_mode = (Thread.current[:\"BigDecimal.exception_mode\"] ||= 0)\n" ++
    "    def __rounding_mode = (Thread.current[:\"BigDecimal.rounding_mode\"] ||= ROUND_HALF_UP)\n" ++
    "    def __limit = (Thread.current[:\"BigDecimal.precision_limit\"] ||= 0)\n" ++
