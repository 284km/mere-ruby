    "    return Internal.infinity_computation_result if infinite? == 1\n" ++
    "\n" ++
    "    raise FloatDomainError, 'sqrt of negative value' if self < 0\n" ++
    "    raise FloatDomainError, \"sqrt of 'NaN'(Not a Number)\" if nan?\n" ++
    "    return self if zero?\n" ++
    "\n" ++
    "    if prec == 0\n" ++
