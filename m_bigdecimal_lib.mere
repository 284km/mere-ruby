    "          next if (f & bit) == 0\n" ++
    "          fo = val ? (fo | bit) : (fo & ~bit)\n" ++
    "        end\n" ++
    "        Thread.current[:\"BigDecimal.exception_mode\"] = fo\n" ++
    "        return fo\n" ++
    "      end\n" ++
