    "      end\n" ++
    "      v\n" ++
    "    end\n" ++
    "\n" ++
    "    def __exception(flag, msg, always = false)\n" ++
    "      raise FloatDomainError, msg if always || (__exception_mode & flag) != 0\n" ++
    "    end\n" ++
