    "    precs = [prec + BigDecimal.double_fig]\n" ++
    "    precs << 2 + precs.last / 2 while precs.last > BigDecimal.double_fig\n" ++
    "    precs.reverse_each do |p|\n" ++
    "      y = y.add(x.div(y, p), p).div(2, p)\n" ++
    "    end\n" ++
    "    y._decimal_shift(ex).mult(1, prec)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "# Core BigMath methods for BigDecimal (log, exp) are defined here.\n" ++
    "# Other methods (sin, cos, atan) are defined in 'bigdecimal/math.rb'.\n" ++
    "module BigMath\n" ++
    "  module_function\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.log(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the natural logarithm of +decimal+ to the specified number of\n" ++
    "  # digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is zero or negative, raises Math::DomainError.\n" ++
    "  #\n" ++
    "  # If +decimal+ is positive infinity, returns Infinity.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  def log(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :log)\n" ++
    "    raise Math::DomainError, 'Complex argument for BigMath.log' if Complex === x\n" ++
    "\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :log)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    raise Math::DomainError, 'Negative argument for log' if x < 0\n" ++
    "    return -BigDecimal::Internal.infinity_computation_result if x.zero?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x.infinite?\n" ++
    "    return BigDecimal(0) if x == 1\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    BigDecimal.save_limit do\n" ++
    "      BigDecimal.limit(0)\n" ++
    "      if x > 10 || x < 0.1\n" ++
    "        log10 = log(BigDecimal(10), prec2)\n" ++
    "        exponent = x.exponent\n" ++
    "        x = x._decimal_shift(-exponent)\n" ++
    "        if x < 0.3\n" ++
    "          x *= 10\n" ++
    "          exponent -= 1\n" ++
    "        end\n" ++
    "        return (log10 * exponent).add(log(x, prec2), prec)\n" ++
    "      end\n" ++
    "\n" ++
    "      x_minus_one_exponent = (x - 1).exponent\n" ++
    "\n" ++
    "      # log(x) = log(sqrt(sqrt(sqrt(sqrt(x))))) * 2**sqrt_steps\n" ++
    "      sqrt_steps = [Integer.sqrt(prec2) + 3 * x_minus_one_exponent, 0].max\n" ++
    "\n" ++
    "      lg2 = 0.3010299956639812\n" ++
    "      sqrt_prec = prec2 + [-x_minus_one_exponent, 0].max + (sqrt_steps * lg2).ceil\n" ++
    "\n" ++
    "      sqrt_steps.times do\n" ++
    "        x = x.sqrt(sqrt_prec)\n" ++
    "      end\n" ++
    "\n" ++
    "      # Taylor series for log(x) around 1\n" ++
    "      # log(x) = -log((1 + X) / (1 - X)) where X = (x - 1) / (x + 1)\n" ++
    "      # log(x) = 2 * (X + X**3 / 3 + X**5 / 5 + X**7 / 7 + ...)\n" ++
    "      x = (x - 1).div(x + 1, sqrt_prec)\n" ++
    "      y = x\n" ++
    "      x2 = x.mult(x, prec2)\n" ++
    "      1.step do |i|\n" ++
    "        n = prec2 + x.exponent - y.exponent + x2.exponent\n" ++
    "        break if n <= 0 || x.zero?\n" ++
    "        x = x.mult(x2.round(n - x2.exponent), n)\n" ++
    "        y = y.add(x.div(2 * i + 1, n), prec2)\n" ++
    "      end\n" ++
    "\n" ++
    "      y.mult(2 ** (sqrt_steps + 1), prec)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # Taylor series for exp(x) around 0\n" ++
    "  private_class_method def _exp_taylor(x, prec) # :nodoc:\n" ++
    "    xn = BigDecimal(1)\n" ++
    "    y = BigDecimal(1)\n" ++
    "    1.step do |i|\n" ++
    "      n = prec + xn.exponent\n" ++
    "      break if n <= 0 || xn.zero?\n" ++
    "      xn = xn.mult(x, n).div(i, n)\n" ++
    "      y = y.add(xn, prec)\n" ++
    "    end\n" ++
    "    y\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.exp(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the value of e (the base of natural logarithms) raised to the\n" ++
    "  # power of +decimal+, to the specified number of digits of precision.\n" ++
    "  #\n" ++
    "  # If +decimal+ is infinity, returns Infinity.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  def exp(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :exp)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :exp)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return x.positive? ? BigDecimal::Internal.infinity_computation_result : BigDecimal(0) if x.infinite?\n" ++
    "    return BigDecimal(1) if x.zero?\n" ++
    "\n" ++
    "    # exp(x * 10**cnt) = exp(x)**(10**cnt)\n" ++
    "    cnt = x < -1 || x > 1 ? x.exponent : 0\n" ++
    "    prec2 = prec + BigDecimal.double_fig + cnt\n" ++
    "    x = x._decimal_shift(-cnt)\n" ++
    "\n" ++
    "    # Calculation of exp(small_prec) is fast because calculation of x**n is fast\n" ++
    "    # Calculation of exp(small_abs) converges fast.\n" ++
    "    # exp(x) = exp(small_prec_part + small_abs_part) = exp(small_prec_part) * exp(small_abs_part)\n" ++
    "    x_small_prec = x.round(Integer.sqrt(prec2))\n" ++
    "    y = _exp_taylor(x_small_prec, prec2).mult(_exp_taylor(x.sub(x_small_prec, prec2), prec2), prec2)\n" ++
    "\n" ++
    "    # calculate exp(x * 10**cnt) from exp(x)\n" ++
    "    # exp(x * 10**k) = exp(x * 10**(k - 1)) ** 10\n" ++
    "    cnt.times do\n" ++
    "      y2 = y.mult(y, prec2)\n" ++
    "      y5 = y2.mult(y2, prec2).mult(y, prec2)\n" ++
    "      y = y5.mult(y5, prec2)\n" ++
    "    end\n" ++
    "\n" ++
    "    y.mult(1, prec)\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "bigdecimal/util" then
    "# frozen_string_literal: false\n" ++
    "#\n" ++
    "#--\n" ++
    "# bigdecimal/util extends various native classes to provide the #to_d method,\n" ++
    "# and provides BigDecimal#to_d and BigDecimal#to_digits.\n" ++
    "#++\n" ++
    "\n" ++
    "require 'bigdecimal'\n" ++
    "\n" ++
    "class Integer < Numeric\n" ++
    "  # call-seq:\n" ++
    "  #     int.to_d  -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns the value of +int+ as a BigDecimal.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal'\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     42.to_d   # => 0.42e2\n" ++
    "  #\n" ++
    "  # See also Kernel.BigDecimal.\n" ++
    "  #\n" ++
    "  def to_d\n" ++
    "    BigDecimal(self)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "\n" ++
    "class Float < Numeric\n" ++
    "  # call-seq:\n" ++
    "  #     float.to_d             -> bigdecimal\n" ++
    "  #     float.to_d(precision)  -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns the value of +float+ as a BigDecimal.\n" ++
    "  # The +precision+ parameter is used to determine the number of\n" ++
    "  # significant digits for the result. When +precision+ is set to +0+,\n" ++
    "  # the number of digits to represent the float being converted is determined\n" ++
    "  # automatically.\n" ++
    "  # The default +precision+ is +0+.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal'\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     0.5.to_d         # => 0.5e0\n" ++
    "  #     1.234.to_d       # => 0.1234e1\n" ++
    "  #     1.234.to_d(2)    # => 0.12e1\n" ++
    "  #\n" ++
    "  # See also Kernel.BigDecimal.\n" ++
    "  #\n" ++
    "  def to_d(precision=0)\n" ++
    "    BigDecimal(self, precision)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "\n" ++
    "class String\n" ++
    "  # call-seq:\n" ++
    "  #     str.to_d  -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns the result of interpreting leading characters in +str+\n" ++
    "  # as a BigDecimal.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal'\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     \"0.5\".to_d             # => 0.5e0\n" ++
    "  #     \"123.45e1\".to_d        # => 0.12345e4\n" ++
    "  #     \"45.67 degrees\".to_d   # => 0.4567e2\n" ++
    "  #\n" ++
    "  # See also Kernel.BigDecimal.\n" ++
    "  #\n" ++
    "  def to_d\n" ++
    "    BigDecimal.interpret_loosely(self)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "\n" ++
    "class BigDecimal < Numeric\n" ++
    "  # call-seq:\n" ++
    "  #     a.to_digits -> string\n" ++
    "  #\n" ++
    "  # Converts a BigDecimal to a String of the form \"nnnnnn.mmm\".\n" ++
    "  # This method is deprecated; use BigDecimal#to_s(\"F\") instead.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     d = BigDecimal(\"3.14\")\n" ++
    "  #     d.to_digits                  # => \"3.14\"\n" ++
    "  #\n" ++
    "  def to_digits\n" ++
    "    if self.nan? || self.infinite? || self.zero?\n" ++
    "      self.to_s\n" ++
    "    else\n" ++
    "      i       = self.to_i.to_s\n" ++
    "      _,f,_,z = self.frac.split\n" ++
    "      i + \".\" + (\"0\"*(-z)) + f\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #     a.to_d -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns self.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     d = BigDecimal(\"3.14\")\n" ++
    "  #     d.to_d                       # => 0.314e1\n" ++
    "  #\n" ++
    "  def to_d\n" ++
    "    self\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "\n" ++
    "class Rational < Numeric\n" ++
    "  # call-seq:\n" ++
    "  #     rat.to_d(precision)  -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns the value as a BigDecimal.\n" ++
    "  #\n" ++
    "  # The +precision+ parameter is used to determine the number of\n" ++
    "  # significant digits for the result. When +precision+ is set to +0+,\n" ++
    "  # the number of digits to represent the float being converted is determined\n" ++
    "  # automatically.\n" ++
    "  # The default +precision+ is +0+.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal'\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     Rational(22, 7).to_d(3)   # => 0.314e1\n" ++
    "  #\n" ++
    "  # See also Kernel.BigDecimal.\n" ++
    "  #\n" ++
    "  def to_d(precision=0)\n" ++
    "    BigDecimal(self, precision)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "\n" ++
    "class Complex < Numeric\n" ++
    "  # call-seq:\n" ++
    "  #     cmp.to_d             -> bigdecimal\n" ++
    "  #     cmp.to_d(precision)  -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns the value as a BigDecimal.\n" ++
    "  # If the imaginary part is not +0+, an error is raised\n" ++
    "  #\n" ++
    "  # The +precision+ parameter is used to determine the number of\n" ++
    "  # significant digits for the result. When +precision+ is set to +0+,\n" ++
    "  # the number of digits to represent the float being converted is determined\n" ++
    "  # automatically.\n" ++
    "  # The default +precision+ is +0+.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal'\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     Complex(0.1234567, 0).to_d(4)   # => 0.1235e0\n" ++
    "  #     Complex(Rational(22, 7), 0).to_d(3)   # => 0.314e1\n" ++
    "  #     Complex(1, 1).to_d   # raises ArgumentError\n" ++
    "  #\n" ++
    "  # See also Kernel.BigDecimal.\n" ++
    "  #\n" ++
    "  def to_d(precision=0)\n" ++
    "    BigDecimal(self) unless self.imag.zero? # to raise error\n" ++
    "\n" ++
    "    BigDecimal(self.real, precision)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "\n" ++
    "class NilClass\n" ++
    "  # call-seq:\n" ++
    "  #     nil.to_d -> bigdecimal\n" ++
    "  #\n" ++
    "  # Returns nil represented as a BigDecimal.\n" ++
    "  #\n" ++
    "  #     require 'bigdecimal'\n" ++
    "  #     require 'bigdecimal/util'\n" ++
    "  #\n" ++
    "  #     nil.to_d   # => 0.0\n" ++
    "  #\n" ++
    "  def to_d\n" ++
    "    BigDecimal(0)\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "bigdecimal/math" then
    "# frozen_string_literal: false\n" ++
    "require 'bigdecimal'\n" ++
    "\n" ++
    "#\n" ++
    "#--\n" ++
    "# Contents:\n" ++
    "#   sqrt(x, prec)\n" ++
    "#   cbrt(x, prec)\n" ++
    "#   hypot(x, y, prec)\n" ++
    "#   sin (x, prec)\n" ++
    "#   cos (x, prec)\n" ++
    "#   tan (x, prec)\n" ++
    "#   asin(x, prec)\n" ++
    "#   acos(x, prec)\n" ++
    "#   atan(x, prec)\n" ++
    "#   atan2(y, x, prec)\n" ++
    "#   sinh (x, prec)\n" ++
    "#   cosh (x, prec)\n" ++
    "#   tanh (x, prec)\n" ++
    "#   asinh(x, prec)\n" ++
    "#   acosh(x, prec)\n" ++
    "#   atanh(x, prec)\n" ++
    "#   log2 (x, prec)\n" ++
    "#   log10(x, prec)\n" ++
    "#   log1p(x, prec)\n" ++
    "#   expm1(x, prec)\n" ++
    "#   erf (x, prec)\n" ++
    "#   erfc(x, prec)\n" ++
    "#   gamma(x, prec)\n" ++
    "#   lgamma(x, prec)\n" ++
    "#   frexp(x)\n" ++
    "#   ldexp(x, exponent)\n" ++
    "#   PI  (prec)\n" ++
    "#   E   (prec) == exp(1.0,prec)\n" ++
    "#\n" ++
    "# where:\n" ++
    "#   x, y ... BigDecimal number to be computed.\n" ++
    "#   prec ... Number of digits to be obtained.\n" ++
    "#++\n" ++
    "#\n" ++
    "# Provides mathematical functions.\n" ++
    "#\n" ++
    "# Example:\n" ++
    "#\n" ++
    "#   require \"bigdecimal/math\"\n" ++
    "#\n" ++
    "#   include BigMath\n" ++
    "#\n" ++
    "#   a = BigDecimal((PI(49)/2).to_s)\n" ++
    "#   puts sin(a,100) # => 0.9999999999...9999999986e0\n" ++
    "#\n" ++
    "module BigMath\n" ++
    "  module_function\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   sqrt(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the square root of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.sqrt(BigDecimal('2'), 32).to_s\n" ++
    "  #   #=> \"0.14142135623730950488016887242097e1\"\n" ++
    "  #\n" ++
    "  def sqrt(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :sqrt)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :sqrt)\n" ++
    "    x.sqrt(prec)\n" ++
    "  end\n" ++
    "\n" ++
    "\n" ++
    "  # Returns [sign, reduced_x] where reduced_x is in -pi/2..pi/2\n" ++
    "  # and satisfies sin(x) = sign * sin(reduced_x)\n" ++
    "  # If add_half_pi is true, adds pi/2 to x before reduction.\n" ++
    "  # Precision of pi is adjusted to ensure reduced_x has the required precision.\n" ++
    "  private_class_method def _sin_periodic_reduction(x, prec, add_half_pi: false) # :nodoc:\n" ++
    "    return [1, x] if -Math::PI/2 <= x && x <= Math::PI/2 && !add_half_pi\n" ++
    "\n" ++
    "    mod_prec = prec + BigDecimal.double_fig\n" ++
    "    pi_extra_prec = [x.exponent, 0].max + BigDecimal.double_fig\n" ++
    "    while true\n" ++
    "      pi = PI(mod_prec + pi_extra_prec)\n" ++
    "      half_pi = pi / 2\n" ++
    "      div, mod = (add_half_pi ? x + pi : x + half_pi).divmod(pi)\n" ++
    "      mod -= half_pi\n" ++
    "      if mod.zero? || mod_prec + mod.exponent <= 0\n" ++
    "        # mod is too small to estimate required pi precision\n" ++
    "        mod_prec = mod_prec * 3 / 2 + BigDecimal.double_fig\n" ++
    "      elsif mod_prec + mod.exponent < prec\n" ++
    "        # Estimate required precision of pi\n" ++
    "        mod_prec = prec - mod.exponent + BigDecimal.double_fig\n" ++
    "      else\n" ++
    "        return [div % 2 == 0 ? 1 : -1, mod.mult(1, prec)]\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   cbrt(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the cube root of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.cbrt(BigDecimal('2'), 32).to_s\n" ++
    "  #   #=> \"0.12599210498948731647672106072782e1\"\n" ++
    "  #\n" ++
    "  def cbrt(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :cbrt)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :cbrt)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result * x.infinite? if x.infinite?\n" ++
    "    return BigDecimal(0) if x.zero?\n" ++
    "\n" ++
    "    x = -x if neg = x < 0\n" ++
    "    ex = x.exponent / 3\n" ++
    "    x = x._decimal_shift(-3 * ex)\n" ++
    "    y = BigDecimal(Math.cbrt(x.to_f), 0)\n" ++
    "    precs = [prec + BigDecimal.double_fig]\n" ++
    "    precs << 2 + precs.last / 2 while precs.last > BigDecimal.double_fig\n" ++
    "    precs.reverse_each do |p|\n" ++
    "      y = (2 * y + x.div(y, p).div(y, p)).div(3, p)\n" ++
    "    end\n" ++
    "    y._decimal_shift(ex).mult(neg ? -1 : 1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   hypot(x, y, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Returns sqrt(x**2 + y**2) to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.hypot(BigDecimal('1'), BigDecimal('2'), 32).to_s\n" ++
    "  #   #=> \"0.22360679774997896964091736687313e1\"\n" ++
    "  #\n" ++
    "  def hypot(x, y, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :hypot)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :hypot)\n" ++
    "    y = BigDecimal::Internal.coerce_to_bigdecimal(y, prec, :hypot)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan? || y.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x.infinite? || y.infinite?\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    sqrt(x.mult(x, prec2) + y.mult(y, prec2), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   sin(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the sine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is Infinity or NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.sin(BigMath.PI(5)/4, 32).to_s\n" ++
    "  #   #=> \"0.70710807985947359435812921837984e0\"\n" ++
    "  #\n" ++
    "  def sin(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :sin)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :sin)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.infinite? || x.nan?\n" ++
    "    n    = prec + BigDecimal.double_fig\n" ++
    "    one  = BigDecimal(\"1\")\n" ++
    "    two  = BigDecimal(\"2\")\n" ++
    "    sign, x = _sin_periodic_reduction(x, n)\n" ++
    "    x1   = x\n" ++
    "    x2   = x.mult(x,n)\n" ++
    "    y    = x\n" ++
    "    d    = y\n" ++
    "    i    = one\n" ++
    "    z    = one\n" ++
    "    while d.nonzero? && ((m = n - (y.exponent - d.exponent).abs) > 0)\n" ++
    "      m = BigDecimal.double_fig if m < BigDecimal.double_fig\n" ++
    "      x1  = -x2.mult(x1,n)\n" ++
    "      i  += two\n" ++
    "      z  *= (i-one) * i\n" ++
    "      d   = x1.div(z,m)\n" ++
    "      y  += d\n" ++
    "    end\n" ++
    "    y = BigDecimal(\"1\") if y > 1\n" ++
    "    y.mult(sign, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   cos(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the cosine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is Infinity or NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.cos(BigMath.PI(16), 32).to_s\n" ++
    "  #   #=> \"-0.99999999999999999999999999999997e0\"\n" ++
    "  #\n" ++
    "  def cos(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :cos)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :cos)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.infinite? || x.nan?\n" ++
    "    sign, x = _sin_periodic_reduction(x, prec + BigDecimal.double_fig, add_half_pi: true)\n" ++
    "    sign * sin(x, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   tan(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the tangent of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is Infinity or NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.tan(BigDecimal(\"0.0\"), 4).to_s\n" ++
    "  #   #=> \"0.0\"\n" ++
    "  #\n" ++
    "  #   BigMath.tan(BigMath.PI(24) / 4, 32).to_s\n" ++
    "  #   #=> \"0.99999999999999999999999830836025e0\"\n" ++
    "  #\n" ++
    "  def tan(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :tan)\n" ++
    "    sin(x, prec + BigDecimal.double_fig).div(cos(x, prec + BigDecimal.double_fig), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   asin(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the arcsine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.asin(BigDecimal('0.5'), 32).to_s\n" ++
    "  #   #=> \"0.52359877559829887307710723054658e0\"\n" ++
    "  #\n" ++
    "  def asin(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :asin)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :asin)\n" ++
    "    raise Math::DomainError, \"Out of domain argument for asin\" if x < -1 || x > 1\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    cos = (1 - x**2).sqrt(prec2)\n" ++
    "    if cos.zero?\n" ++
    "      PI(prec2).div(x > 0 ? 2 : -2, prec)\n" ++
    "    else\n" ++
    "      atan(x.div(cos, prec2), prec)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   acos(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the arccosine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.acos(BigDecimal('0.5'), 32).to_s\n" ++
    "  #   #=> \"0.10471975511965977461542144610932e1\"\n" ++
    "  #\n" ++
    "  def acos(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :acos)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :acos)\n" ++
    "    raise Math::DomainError, \"Out of domain argument for acos\" if x < -1 || x > 1\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    return (PI(prec2) / 2).sub(asin(x, prec2), prec) if x < 0\n" ++
    "    return PI(prec2).div(2, prec) if x.zero?\n" ++
    "\n" ++
    "    sin = (1 - x**2).sqrt(prec2)\n" ++
    "    atan(sin.div(x, prec2), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   atan(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the arctangent of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.atan(BigDecimal('-1'), 32).to_s\n" ++
    "  #   #=> \"-0.78539816339744830961566084581988e0\"\n" ++
    "  #\n" ++
    "  def atan(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :atan)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :atan)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    n = prec + BigDecimal.double_fig\n" ++
    "    pi = PI(n)\n" ++
    "    x = -x if neg = x < 0\n" ++
    "    return pi.div(neg ? -2 : 2, prec) if x.infinite?\n" ++
    "    return pi.div(neg ? -4 : 4, prec) if x.round(n) == 1\n" ++
    "    x = BigDecimal(\"1\").div(x, n) if inv = x > 1\n" ++
    "    x = (-1 + sqrt(1 + x.mult(x, n), n)).div(x, n) if dbl = x > 0.5\n" ++
    "    y = x\n" ++
    "    d = y\n" ++
    "    t = x\n" ++
    "    r = BigDecimal(\"3\")\n" ++
    "    x2 = x.mult(x,n)\n" ++
    "    while d.nonzero? && ((m = n - (y.exponent - d.exponent).abs) > 0)\n" ++
    "      m = BigDecimal.double_fig if m < BigDecimal.double_fig\n" ++
    "      t = -t.mult(x2,n)\n" ++
    "      d = t.div(r,m)\n" ++
    "      y += d\n" ++
    "      r += 2\n" ++
    "    end\n" ++
    "    y *= 2 if dbl\n" ++
    "    y = pi / 2 - y if inv\n" ++
    "    y = -y if neg\n" ++
    "    y.mult(1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   atan2(decimal, decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the arctangent of y and x to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.atan2(BigDecimal('-1'), BigDecimal('1'), 32).to_s\n" ++
    "  #   #=> \"-0.78539816339744830961566084581988e0\"\n" ++
    "  #\n" ++
    "  def atan2(y, x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :atan2)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :atan2)\n" ++
    "    y = BigDecimal::Internal.coerce_to_bigdecimal(y, prec, :atan2)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan? || y.nan?\n" ++
    "\n" ++
    "    if x.infinite? || y.infinite?\n" ++
    "      one = BigDecimal(1)\n" ++
    "      zero = BigDecimal(0)\n" ++
    "      x = x.infinite? ? (x > 0 ? one : -one) : zero\n" ++
    "      y = y.infinite? ? (y > 0 ? one : -one) : y.sign * zero\n" ++
    "    end\n" ++
    "\n" ++
    "    return x.sign >= 0 ? BigDecimal(0) : y.sign * PI(prec) if y.zero?\n" ++
    "\n" ++
    "    y = -y if neg = y < 0\n" ++
    "    xlarge = y.abs < x.abs\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    if x > 0\n" ++
    "      v = xlarge ? atan(y.div(x, prec2), prec) : PI(prec2) / 2 - atan(x.div(y, prec2), prec2)\n" ++
    "    else\n" ++
    "      v = xlarge ? PI(prec2) - atan(-y.div(x, prec2), prec2) : PI(prec2) / 2 + atan(x.div(-y, prec2), prec2)\n" ++
    "    end\n" ++
    "    v.mult(neg ? -1 : 1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   sinh(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the hyperbolic sine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.sinh(BigDecimal('1'), 32).to_s\n" ++
    "  #   #=> \"0.11752011936438014568823818505956e1\"\n" ++
    "  #\n" ++
    "  def sinh(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :sinh)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :sinh)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result * x.infinite? if x.infinite?\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    prec2 -= x.exponent if x.exponent < 0\n" ++
    "    e = exp(x, prec2)\n" ++
    "    (e - BigDecimal(1).div(e, prec2)).div(2, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   cosh(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the hyperbolic cosine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.cosh(BigDecimal('1'), 32).to_s\n" ++
    "  #   #=> \"0.15430806348152437784779056207571e1\"\n" ++
    "  #\n" ++
    "  def cosh(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :cosh)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :cosh)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x.infinite?\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    e = exp(x, prec2)\n" ++
    "    (e + BigDecimal(1).div(e, prec2)).div(2, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   tanh(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the hyperbolic tangent of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.tanh(BigDecimal('1'), 32).to_s\n" ++
    "  #   #=> \"0.76159415595576488811945828260479e0\"\n" ++
    "  #\n" ++
    "  def tanh(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :tanh)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :tanh)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal(x.infinite?) if x.infinite?\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig + [-x.exponent, 0].max\n" ++
    "    e = exp(x, prec2)\n" ++
    "    einv = BigDecimal(1).div(e, prec2)\n" ++
    "    (e - einv).div(e + einv, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   asinh(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the inverse hyperbolic sine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.asinh(BigDecimal('1'), 32).to_s\n" ++
    "  #   #=> \"0.88137358701954302523260932497979e0\"\n" ++
    "  #\n" ++
    "  def asinh(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :asinh)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :asinh)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result * x.infinite? if x.infinite?\n" ++
    "    return -asinh(-x, prec) if x < 0\n" ++
    "\n" ++
    "    sqrt_prec = prec + [-x.exponent, 0].max + BigDecimal.double_fig\n" ++
    "    log(x + sqrt(x**2 + 1, sqrt_prec), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   acosh(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the inverse hyperbolic cosine of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.acosh(BigDecimal('2'), 32).to_s\n" ++
    "  #   #=> \"0.1316957896924816708625046347308e1\"\n" ++
    "  #\n" ++
    "  def acosh(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :acosh)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :acosh)\n" ++
    "    raise Math::DomainError, \"Out of domain argument for acosh\" if x < 1\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x.infinite?\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "\n" ++
    "    log(x + sqrt(x**2 - 1, prec + BigDecimal.double_fig), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   atanh(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the inverse hyperbolic tangent of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.atanh(BigDecimal('0.5'), 32).to_s\n" ++
    "  #   #=> \"0.54930614433405484569762261846126e0\"\n" ++
    "  #\n" ++
    "  def atanh(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :atanh)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :atanh)\n" ++
    "    raise Math::DomainError, \"Out of domain argument for atanh\" if x < -1 || x > 1\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x == 1\n" ++
    "    return -BigDecimal::Internal.infinity_computation_result if x == -1\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    (log(x + 1, prec2) - log(1 - x, prec2)).div(2, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.log2(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the base 2 logarithm of +decimal+ to the specified number of\n" ++
    "  # digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is zero or negative, raises Math::DomainError.\n" ++
    "  #\n" ++
    "  # If +decimal+ is positive infinity, returns Infinity.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.log2(BigDecimal('3'), 32).to_s\n" ++
    "  #   #=> \"0.15849625007211561814537389439478e1\"\n" ++
    "  #\n" ++
    "  def log2(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :log2)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :log2)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x.infinite? == 1\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig * 3 / 2\n" ++
    "    v = log(x, prec2).div(log(BigDecimal(2), prec2), prec2)\n" ++
    "    # Perform half-up rounding to calculate log2(2**n)==n correctly in every rounding mode\n" ++
    "    v = v.round(prec + BigDecimal.double_fig - (v.exponent < 0 ? v.exponent : 0), BigDecimal::ROUND_HALF_UP)\n" ++
    "    v.mult(1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.log10(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the base 10 logarithm of +decimal+ to the specified number of\n" ++
    "  # digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is zero or negative, raises Math::DomainError.\n" ++
    "  #\n" ++
    "  # If +decimal+ is positive infinity, returns Infinity.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.log10(BigDecimal('3'), 32).to_s\n" ++
    "  #   #=> \"0.47712125471966243729502790325512e0\"\n" ++
    "  #\n" ++
    "  def log10(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :log10)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :log10)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal::Internal.infinity_computation_result if x.infinite? == 1\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig * 3 / 2\n" ++
    "    v = log(x, prec2).div(log(BigDecimal(10), prec2), prec2)\n" ++
    "    # Perform half-up rounding to calculate log10(10**n)==n correctly in every rounding mode\n" ++
    "    v = v.round(prec + BigDecimal.double_fig - (v.exponent < 0 ? v.exponent : 0), BigDecimal::ROUND_HALF_UP)\n" ++
    "    v.mult(1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.log1p(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes log(1 + decimal) to the specified number of digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.log1p(BigDecimal('0.1'), 32).to_s\n" ++
    "  #   #=> \"0.95310179804324860043952123280765e-1\"\n" ++
    "  #\n" ++
    "  def log1p(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :log1p)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :log1p)\n" ++
    "    raise Math::DomainError, 'Out of domain argument for log1p' if x < -1\n" ++
    "\n" ++
    "    return log(x + 1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.expm1(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes exp(decimal) - 1 to the specified number of digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.expm1(BigDecimal('0.1'), 32).to_s\n" ++
    "  #   #=> \"0.10517091807564762481170782649025e0\"\n" ++
    "  #\n" ++
    "  def expm1(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :expm1)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :expm1)\n" ++
    "    return BigDecimal(-1) if x.infinite? == -1\n" ++
    "\n" ++
    "    exp_prec = prec\n" ++
    "    if x < -1\n" ++
    "      # log10(exp(x)) = x * log10(e)\n" ++
    "      lg_e = 0.4342944819032518\n" ++
    "      exp_prec = prec + (lg_e * x).ceil + BigDecimal.double_fig\n" ++
    "    elsif x < 1\n" ++
    "      exp_prec = prec - x.exponent + BigDecimal.double_fig\n" ++
    "    else\n" ++
    "      exp_prec = prec\n" ++
    "    end\n" ++
    "\n" ++
    "    return BigDecimal(-1) if exp_prec <= 0\n" ++
    "\n" ++
    "    exp = exp(x, exp_prec)\n" ++
    "\n" ++
    "    if exp.exponent > prec + BigDecimal.double_fig\n" ++
    "      # Workaroudn for https://github.com/ruby/bigdecimal/issues/464\n" ++
    "      exp\n" ++
    "    else\n" ++
    "      exp.sub(1, prec)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  #   erf(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the error function of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.erf(BigDecimal('1'), 32).to_s\n" ++
    "  #   #=> \"0.84270079294971486934122063508261e0\"\n" ++
    "  #\n" ++
    "  def erf(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :erf)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :erf)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal(x.infinite?) if x.infinite?\n" ++
    "    return BigDecimal(0) if x == 0\n" ++
    "    return -erf(-x, prec) if x < 0\n" ++
    "    return BigDecimal(1) if x > 5000000000 # erf(5000000000) > 1 - 1e-10000000000000000000\n" ++
    "\n" ++
    "    if x > 8\n" ++
    "      xf = x.to_f\n" ++
    "      log10_erfc = -xf ** 2 / Math.log(10) - Math.log10(xf * Math::PI ** 0.5)\n" ++
    "      erfc_prec = [prec + log10_erfc.ceil, 1].max\n" ++
    "      erfc = _erfc_asymptotic(x, erfc_prec)\n" ++
    "      if erfc\n" ++
    "        # Workaround for https://github.com/ruby/bigdecimal/issues/464\n" ++
    "        return BigDecimal(1) if erfc.exponent < -prec - BigDecimal.double_fig\n" ++
    "\n" ++
    "        return BigDecimal(1).sub(erfc, prec)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    x_smallprec = x.mult(1, Integer.sqrt(prec2) / 2)\n" ++
    "    # Taylor series of x with small precision is fast\n" ++
    "    erf1 = _erf_taylor(x_smallprec, BigDecimal(0), BigDecimal(0), prec2)\n" ++
    "    # Taylor series converges quickly for small x\n" ++
    "    _erf_taylor(x - x_smallprec, x_smallprec, erf1, prec2).mult(1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   erfc(decimal, numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the complementary error function of +decimal+ to the specified number of digits of\n" ++
    "  # precision, +numeric+.\n" ++
    "  #\n" ++
    "  # If +decimal+ is NaN, returns NaN.\n" ++
    "  #\n" ++
    "  #   BigMath.erfc(BigDecimal('10'), 32).to_s\n" ++
    "  #   #=> \"0.20884875837625447570007862949578e-44\"\n" ++
    "  #\n" ++
    "  def erfc(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :erfc)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :erfc)\n" ++
    "    return BigDecimal::Internal.nan_computation_result if x.nan?\n" ++
    "    return BigDecimal(1 - x.infinite?) if x.infinite?\n" ++
    "    return BigDecimal(1).sub(erf(x, prec + BigDecimal.double_fig), prec) if x < 0\n" ++
    "    return BigDecimal(0) if x > 5000000000 # erfc(5000000000) < 1e-10000000000000000000 (underflow)\n" ++
    "\n" ++
    "    if x >= 8\n" ++
    "      y = _erfc_asymptotic(x, prec)\n" ++
    "      return y.mult(1, prec) if y\n" ++
    "    end\n" ++
    "\n" ++
    "    # erfc(x) = 1 - erf(x) < exp(-x**2)/x/sqrt(pi)\n" ++
    "    # Precision of erf(x) needs about log10(exp(-x**2)) extra digits\n" ++
    "    log10 = 2.302585092994046\n" ++
    "    high_prec = prec + BigDecimal.double_fig + (x.ceil**2 / log10).ceil\n" ++
    "    BigDecimal(1).sub(erf(x, high_prec), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # Calculates erf(x + a)\n" ++
    "  private_class_method def _erf_taylor(x, a, erf_a, prec) # :nodoc:\n" ++
    "    return erf_a if x.zero?\n" ++
    "    # Let f(x+a) = erf(x+a)*exp((x+a)**2)*sqrt(pi)/2\n" ++
    "    #            = c0 + c1*x + c2*x**2 + c3*x**3 + c4*x**4 + ...\n" ++
    "    # f'(x+a) = 1+2*(x+a)*f(x+a)\n" ++
    "    # f'(x+a) = c1 + 2*c2*x + 3*c3*x**2 + 4*c4*x**3 + 5*c5*x**4 + ...\n" ++
    "    #         = 1+2*(x+a)*(c0 + c1*x + c2*x**2 + c3*x**3 + c4*x**4 + ...)\n" ++
    "    # therefore,\n" ++
    "    # c0 = f(a)\n" ++
    "    # c1 = 2 * a * c0 + 1\n" ++
    "    # c2 = (2 * c0 + 2 * a * c1) / 2\n" ++
    "    # c3 = (2 * c1 + 2 * a * c2) / 3\n" ++
    "    # c4 = (2 * c2 + 2 * a * c3) / 4\n" ++
    "    #\n" ++
    "    # All coefficients are positive when a >= 0\n" ++
    "\n" ++
    "    scale = BigDecimal(2).div(sqrt(PI(prec), prec), prec)\n" ++
    "    c_prev = erf_a.div(scale.mult(exp(-a*a, prec), prec), prec)\n" ++
    "    c_next = (2 * a * c_prev).add(1, prec).mult(x, prec)\n" ++
    "    sum = c_prev.add(c_next, prec)\n" ++
    "\n" ++
    "    2.step do |k|\n" ++
    "      cn = (c_prev.mult(x, prec) + a * c_next).mult(2, prec).mult(x, prec).div(k, prec)\n" ++
    "      sum = sum.add(cn, prec)\n" ++
    "      c_prev, c_next = c_next, cn\n" ++
    "      break if [c_prev, c_next].all? \{ |c| c.zero?  || (c.exponent < sum.exponent - prec) \}\n" ++
    "    end\n" ++
    "    value = sum.mult(scale.mult(exp(-(x + a).mult(x + a, prec), prec), prec), prec)\n" ++
    "    value > 1 ? BigDecimal(1) : value\n" ++
    "  end\n" ++
    "\n" ++
    "  private_class_method def _erfc_asymptotic(x, prec) # :nodoc:\n" ++
    "    # Let f(x) = erfc(x)*sqrt(pi)*exp(x**2)/2\n" ++
    "    # f(x) satisfies the following differential equation:\n" ++
    "    # 2*x*f(x) = f'(x) + 1\n" ++
    "    # From the above equation, we can derive the following asymptotic expansion:\n" ++
    "    # f(x) = (0..kmax).sum \{ (-1)**k * (2*k)! / 4**k / k! / x**(2*k)) \} / x\n" ++
    "\n" ++
    "    # This asymptotic expansion does not converge.\n" ++
    "    # But if there is a k that satisfies (2*k)! / 4**k / k! / x**(2*k) < 10**(-prec),\n" ++
    "    # It is enough to calculate erfc within the given precision.\n" ++
    "    # Using Stirling's approximation, we can simplify this condition to:\n" ++
    "    # sqrt(2)/2 + k*log(k) - k - 2*k*log(x) < -prec*log(10)\n" ++
    "    # and the left side is minimized when k = x**2.\n" ++
    "    prec += BigDecimal.double_fig\n" ++
    "    xf = x.to_f\n" ++
    "    kmax = (1..(xf ** 2).floor).bsearch do |k|\n" ++
    "      Math.log(2) / 2 + k * Math.log(k) - k - 2 * k * Math.log(xf) < -prec * Math.log(10)\n" ++
    "    end\n" ++
    "    return unless kmax\n" ++
    "\n" ++
    "    sum = BigDecimal(1)\n" ++
    "    x2 = x.mult(x, prec)\n" ++
    "    d = BigDecimal(1)\n" ++
    "    (1..kmax).each do |k|\n" ++
    "      d = d.div(x2, prec).mult(1 - 2 * k, prec).div(2, prec)\n" ++
    "      sum = sum.add(d, prec)\n" ++
    "    end\n" ++
    "    sum.div(exp(x2, prec).mult(PI(prec).sqrt(prec), prec), prec).div(x, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.gamma(decimal, numeric)    -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the gamma function of +decimal+ to the specified number of\n" ++
    "  # digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.gamma(BigDecimal('0.5'), 32).to_s\n" ++
    "  #   #=> \"0.17724538509055160272981674833411e1\"\n" ++
    "  #\n" ++
    "  def gamma(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :gamma)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :gamma)\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    if x < 0.5\n" ++
    "      raise Math::DomainError, 'Numerical argument is out of domain - gamma' if x.frac.zero?\n" ++
    "\n" ++
    "      # Euler's reflection formula: gamma(z) * gamma(1-z) = pi/sin(pi*z)\n" ++
    "      pi = PI(prec2)\n" ++
    "      sin = _sinpix(x, pi, prec2)\n" ++
    "      return pi.div(gamma(1 - x, prec2).mult(sin, prec2), prec)\n" ++
    "    elsif x.frac.zero? && x < 1000 * prec\n" ++
    "      return _gamma_positive_integer(x, prec2).mult(1, prec)\n" ++
    "    end\n" ++
    "\n" ++
    "    a, sum = _gamma_spouge_sum_part(x, prec2)\n" ++
    "    (x + (a - 1)).power(x - 0.5, prec2).mult(BigMath.exp(1 - x, prec2), prec2).mult(sum, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   BigMath.lgamma(decimal, numeric)    -> [BigDecimal, Integer]\n" ++
    "  #\n" ++
    "  # Computes the natural logarithm of the absolute value of the gamma function\n" ++
    "  # of +decimal+ to the specified number of digits of precision, +numeric+ and its sign.\n" ++
    "  #\n" ++
    "  #   BigMath.lgamma(BigDecimal('0.5'), 32)\n" ++
    "  #   #=> [0.57236494292470008707171367567653e0, 1]\n" ++
    "  #\n" ++
    "  def lgamma(x, prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :lgamma)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, prec, :lgamma)\n" ++
    "    prec2 = prec + BigDecimal.double_fig\n" ++
    "    if x < 0.5\n" ++
    "      return [BigDecimal::INFINITY, 1] if x.frac.zero?\n" ++
    "\n" ++
    "      loop do\n" ++
    "        # Euler's reflection formula: gamma(z) * gamma(1-z) = pi/sin(pi*z)\n" ++
    "        pi = PI(prec2)\n" ++
    "        sin = _sinpix(x, pi, prec2)\n" ++
    "        log_gamma = BigMath.log(pi, prec2).sub(lgamma(1 - x, prec2).first + BigMath.log(sin.abs, prec2), prec)\n" ++
    "        return [log_gamma, sin > 0 ? 1 : -1] if prec2 + log_gamma.exponent > prec + BigDecimal.double_fig\n" ++
    "\n" ++
    "        # Retry with higher precision if loss of significance is too large\n" ++
    "        prec2 = prec2 * 3 / 2\n" ++
    "      end\n" ++
    "    elsif x.frac.zero? && x < 1000 * prec\n" ++
    "      log_gamma = BigMath.log(_gamma_positive_integer(x, prec2), prec)\n" ++
    "      [log_gamma, 1]\n" ++
    "    else\n" ++
    "      # if x is close to 1 or 2, increase precision to reduce loss of significance\n" ++
    "      diff1_exponent = (x - 1).exponent\n" ++
    "      diff2_exponent = (x - 2).exponent\n" ++
    "      extremely_near_one = diff1_exponent < -prec2\n" ++
    "      extremely_near_two = diff2_exponent < -prec2\n" ++
    "\n" ++
    "      if extremely_near_one || extremely_near_two\n" ++
    "        # If x is extreamely close to base = 1 or 2, linear interpolation is accurate enough.\n" ++
    "        # Taylor expansion at x = base is: (x - base) * digamma(base) + (x - base) ** 2 * trigamma(base) / 2 + ...\n" ++
    "        # And we can ignore (x - base) ** 2 and higher order terms.\n" ++
    "        base = extremely_near_one ? 1 : 2\n" ++
    "        d = BigDecimal(1)._decimal_shift(1 - prec2)\n" ++
    "        log_gamma_d, sign = lgamma(base + d, prec2)\n" ++
    "        return [log_gamma_d.mult(x - base, prec2).div(d, prec), sign]\n" ++
    "      end\n" ++
    "\n" ++
    "      prec2 += [-diff1_exponent, -diff2_exponent, 0].max\n" ++
    "      a, sum = _gamma_spouge_sum_part(x, prec2)\n" ++
    "      log_gamma = BigMath.log(sum, prec2).add((x - 0.5).mult(BigMath.log(x.add(a - 1, prec2), prec2), prec2) + 1 - x, prec)\n" ++
    "      [log_gamma, 1]\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # Returns sum part: sqrt(2*pi) and c[k]/(x+k) terms of Spouge's approximation\n" ++
    "  private_class_method def _gamma_spouge_sum_part(x, prec) # :nodoc:\n" ++
    "    x -= 1\n" ++
    "    # Spouge's approximation\n" ++
    "    # x! = (x + a)**(x + 0.5) * exp(-x - a) * (sqrt(2 * pi)  + (1..a - 1).sum\{|k| c[k] / (x + k) \} + epsilon)\n" ++
    "    # where c[k] = (-1)**k * (a - k)**(k - 0.5) * exp(a - k) / (k - 1)!\n" ++
    "    # and epsilon is bounded by a**(-0.5) * (2 * pi) ** (-a - 0.5)\n" ++
    "\n" ++
    "    # Estimate required a for given precision\n" ++
    "    a = (prec / Math.log10(2 * Math::PI)).ceil\n" ++
    "\n" ++
    "    # Calculate exponent of c[k] in low precision to estimate required precision\n" ++
    "    low_prec = 16\n" ++
    "    log10f = Math.log(10)\n" ++
    "    x_low_prec = x.mult(1, low_prec)\n" ++
    "    loggamma_k = 0\n" ++
    "    ck_exponents = (1..a-1).map do |k|\n" ++
    "      loggamma_k += Math.log10(k - 1) if k > 1\n" ++
    "      -loggamma_k - k / log10f + (k - 0.5) * Math.log10(a - k) - BigMath.log10(x_low_prec.add(k, low_prec), low_prec)\n" ++
    "    end\n" ++
    "\n" ++
    "    # Estimate exponent of sum by Stirling's approximation\n" ++
    "    approx_sum_exponent = x < 1 ? -Math.log10(a) / 2 : Math.log10(2 * Math::PI) / 2 + x_low_prec.add(0.5, low_prec) * Math.log10(x_low_prec / x_low_prec.add(a, low_prec))\n" ++
    "\n" ++
    "    # Determine required precision of c[k]\n" ++
    "    prec2 = [ck_exponents.max.ceil - approx_sum_exponent.floor, 0].max + prec\n" ++
    "\n" ++
    "    einv = BigMath.exp(-1, prec2)\n" ++
    "    sum = (PI(prec) * 2).sqrt(prec).mult(BigMath.exp(-a, prec), prec)\n" ++
    "    y = BigDecimal(1)\n" ++
    "    (1..a - 1).each do |k|\n" ++
    "      # c[k] = (-1)**k * (a - k)**(k - 0.5) * exp(-k) / (k-1)! / (x + k)\n" ++
    "      y = y.div(1 - k, prec2) if k > 1\n" ++
    "      y = y.mult(einv, prec2)\n" ++
    "      z = y.mult(BigDecimal((a - k) ** k), prec2).div(BigDecimal(a - k).sqrt(prec2).mult(x.add(k, prec2), prec2), prec2)\n" ++
    "      # sum += c[k] / (x + k)\n" ++
    "      sum = sum.add(z, prec2)\n" ++
    "    end\n" ++
    "    [a, sum]\n" ++
    "  end\n" ++
    "\n" ++
    "  private_class_method def _gamma_positive_integer(x, prec) # :nodoc:\n" ++
    "    return x if x == 1\n" ++
    "    numbers = (1..x - 1).map \{|i| BigDecimal(i) \}\n" ++
    "    while numbers.size > 1\n" ++
    "      numbers = numbers.each_slice(2).map \{|a, b| b ? a.mult(b, prec) : a \}\n" ++
    "    end\n" ++
    "    numbers.first\n" ++
    "  end\n" ++
    "\n" ++
    "  # Returns sin(pi * x), for gamma reflection formula calculation\n" ++
    "  private_class_method def _sinpix(x, pi, prec) # :nodoc:\n" ++
    "    x = x % 2\n" ++
    "    sign = x > 1 ? -1 : 1\n" ++
    "    x %= 1\n" ++
    "    x = 1 - x if x > 0.5 # to avoid sin(pi*x) loss of precision for x close to 1\n" ++
    "    sign * sin(x.mult(pi, prec), prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   frexp(x) -> [BigDecimal, Integer]\n" ++
    "  #\n" ++
    "  # Decomposes +x+ into a normalized fraction and an integral power of ten.\n" ++
    "  #\n" ++
    "  #   BigMath.frexp(BigDecimal(123.456))\n" ++
    "  #   #=> [0.123456e0, 3]\n" ++
    "  #\n" ++
    "  def frexp(x)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, 0, :frexp)\n" ++
    "    return [x, 0] unless x.finite?\n" ++
    "\n" ++
    "    exponent = x.exponent\n" ++
    "    [x._decimal_shift(-exponent), exponent]\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   ldexp(fraction, exponent) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Inverse of +frexp+.\n" ++
    "  # Returns the value of fraction * 10**exponent.\n" ++
    "  #\n" ++
    "  #   BigMath.ldexp(BigDecimal(\"0.123456e0\"), 3)\n" ++
    "  #   #=> 0.123456e3\n" ++
    "  #\n" ++
    "  def ldexp(x, exponent)\n" ++
    "    x = BigDecimal::Internal.coerce_to_bigdecimal(x, 0, :ldexp)\n" ++
    "    x.finite? ? x._decimal_shift(exponent) : x\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   PI(numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes the value of pi to the specified number of digits of precision,\n" ++
    "  # +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.PI(32).to_s\n" ++
    "  #   #=> \"0.31415926535897932384626433832795e1\"\n" ++
    "  #\n" ++
    "  def PI(prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :PI)\n" ++
    "    n      = prec + BigDecimal.double_fig\n" ++
    "    zero   = BigDecimal(\"0\")\n" ++
    "    one    = BigDecimal(\"1\")\n" ++
    "    two    = BigDecimal(\"2\")\n" ++
    "\n" ++
    "    m25    = BigDecimal(\"-0.04\")\n" ++
    "    m57121 = BigDecimal(\"-57121\")\n" ++
    "\n" ++
    "    pi     = zero\n" ++
    "\n" ++
    "    d = one\n" ++
    "    k = one\n" ++
    "    t = BigDecimal(\"-80\")\n" ++
    "    while d.nonzero? && ((m = n - (pi.exponent - d.exponent).abs) > 0)\n" ++
    "      m = BigDecimal.double_fig if m < BigDecimal.double_fig\n" ++
    "      t   = t*m25\n" ++
    "      d   = t.div(k,m)\n" ++
    "      k   = k+two\n" ++
    "      pi  = pi + d\n" ++
    "    end\n" ++
    "\n" ++
    "    d = one\n" ++
    "    k = one\n" ++
    "    t = BigDecimal(\"956\")\n" ++
    "    while d.nonzero? && ((m = n - (pi.exponent - d.exponent).abs) > 0)\n" ++
    "      m = BigDecimal.double_fig if m < BigDecimal.double_fig\n" ++
    "      t   = t.div(m57121,n)\n" ++
    "      d   = t.div(k,m)\n" ++
    "      pi  = pi + d\n" ++
    "      k   = k+two\n" ++
    "    end\n" ++
    "    pi.mult(1, prec)\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   E(numeric) -> BigDecimal\n" ++
    "  #\n" ++
    "  # Computes e (the base of natural logarithms) to the specified number of\n" ++
    "  # digits of precision, +numeric+.\n" ++
    "  #\n" ++
    "  #   BigMath.E(32).to_s\n" ++
    "  #   #=> \"0.27182818284590452353602874713527e1\"\n" ++
    "  #\n" ++
    "  def E(prec)\n" ++
    "    prec = BigDecimal::Internal.coerce_validate_prec(prec, :E)\n" ++
    "    exp(1, prec)\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "bigdecimal/jacobian" then
    "# frozen_string_literal: false\n" ++
    "\n" ++
    "require 'bigdecimal'\n" ++
    "\n" ++
    "warn \"'bigdecimal/jacobian' is deprecated and will be removed in a future release.\"\n" ++
    "\n" ++
    "# require 'bigdecimal/jacobian'\n" ++
    "#\n" ++
    "# Provides methods to compute the Jacobian matrix of a set of equations at a\n" ++
    "# point x. In the methods below:\n" ++
    "#\n" ++
    "# f is an Object which is used to compute the Jacobian matrix of the equations.\n" ++
    "# It must provide the following methods:\n" ++
    "#\n" ++
    "# f.values(x):: returns the values of all functions at x\n" ++
    "#\n" ++
    "# f.zero:: returns 0.0\n" ++
    "# f.one:: returns 1.0\n" ++
    "# f.two:: returns 2.0\n" ++
    "# f.ten:: returns 10.0\n" ++
    "#\n" ++
    "# f.eps:: returns the convergence criterion (epsilon value) used to determine whether two values are considered equal. If |a-b| < epsilon, the two values are considered equal.\n" ++
    "#\n" ++
    "# x is the point at which to compute the Jacobian.\n" ++
    "#\n" ++
    "# fx is f.values(x).\n" ++
    "#\n" ++
    "module Jacobian\n" ++
    "  module_function\n" ++
    "\n" ++
    "  # Determines the equality of two numbers by comparing to zero, or using the epsilon value\n" ++
    "  def isEqual(a,b,zero=0.0,e=1.0e-8)\n" ++
    "    aa = a.abs\n" ++
    "    bb = b.abs\n" ++
    "    if aa == zero &&  bb == zero then\n" ++
    "      true\n" ++
    "    else\n" ++
    "      if ((a-b)/(aa+bb)).abs < e then\n" ++
    "        true\n" ++
    "      else\n" ++
    "        false\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "\n" ++
    "  # Computes the derivative of +f[i]+ at +x[i]+.\n" ++
    "  # +fx+ is the value of +f+ at +x+.\n" ++
    "  def dfdxi(f,fx,x,i)\n" ++
    "    nRetry = 0\n" ++
    "    n = x.size\n" ++
    "    xSave = x[i]\n" ++
    "    ok = 0\n" ++
    "    ratio = f.ten*f.ten*f.ten\n" ++
    "    dx = x[i].abs/ratio\n" ++
    "    dx = fx[i].abs/ratio if isEqual(dx,f.zero,f.zero,f.eps)\n" ++
    "    dx = f.one/f.ten     if isEqual(dx,f.zero,f.zero,f.eps)\n" ++
    "    until ok>0 do\n" ++
    "      deriv = []\n" ++
    "      nRetry += 1\n" ++
    "      if nRetry > 100\n" ++
    "        raise \"Singular Jacobian matrix. No change at x[\" + i.to_s + \"]\"\n" ++
    "      end\n" ++
    "      dx = dx*f.two\n" ++
    "      x[i] += dx\n" ++
    "      fxNew = f.values(x)\n" ++
    "      for j in 0...n do\n" ++
    "        if !isEqual(fxNew[j],fx[j],f.zero,f.eps) then\n" ++
    "          ok += 1\n" ++
    "          deriv <<= (fxNew[j]-fx[j])/dx\n" ++
    "        else\n" ++
    "          deriv <<= f.zero\n" ++
    "        end\n" ++
    "      end\n" ++
    "      x[i] = xSave\n" ++
    "    end\n" ++
    "    deriv\n" ++
    "  end\n" ++
    "\n" ++
    "  # Computes the Jacobian of +f+ at +x+. +fx+ is the value of +f+ at +x+.\n" ++
    "  def jacobian(f,fx,x)\n" ++
    "    n = x.size\n" ++
    "    dfdx = Array.new(n*n)\n" ++
    "    for i in 0...n do\n" ++
    "      df = dfdxi(f,fx,x,i)\n" ++
    "      for j in 0...n do\n" ++
    "        dfdx[j*n+i] = df[j]\n" ++
    "      end\n" ++
    "    end\n" ++
    "    dfdx\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "bigdecimal/ludcmp" then
    "# frozen_string_literal: false\n" ++
    "require 'bigdecimal'\n" ++
    "\n" ++
    "warn \"'bigdecimal/ludcmp' is deprecated and will be removed in a future release.\"\n" ++
    "\n" ++
    "#\n" ++
    "# Solves a*x = b for x, using LU decomposition.\n" ++
    "#\n" ++
    "module LUSolve\n" ++
    "  module_function\n" ++
    "\n" ++
    "  # Performs LU decomposition of the n by n matrix a.\n" ++
    "  def ludecomp(a,n,zero=0,one=1)\n" ++
    "    prec = BigDecimal.limit(nil)\n" ++
    "    ps     = []\n" ++
    "    scales = []\n" ++
    "    for i in 0...n do  # pick up largest(abs. val.) element in each row.\n" ++
    "      ps <<= i\n" ++
    "      nrmrow  = zero\n" ++
    "      ixn = i*n\n" ++
    "      for j in 0...n do\n" ++
    "        biggst = a[ixn+j].abs\n" ++
    "        nrmrow = biggst if biggst>nrmrow\n" ++
    "      end\n" ++
    "      if nrmrow>zero then\n" ++
    "        scales <<= one.div(nrmrow,prec)\n" ++
    "      else\n" ++
    "        raise \"Singular matrix\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "    n1          = n - 1\n" ++
    "    for k in 0...n1 do # Gaussian elimination with partial pivoting.\n" ++
    "      biggst  = zero;\n" ++
    "      for i in k...n do\n" ++
    "        size = a[ps[i]*n+k].abs*scales[ps[i]]\n" ++
    "        if size>biggst then\n" ++
    "          biggst = size\n" ++
    "          pividx  = i\n" ++
    "        end\n" ++
    "      end\n" ++
    "      raise \"Singular matrix\" if biggst<=zero\n" ++
    "      if pividx!=k then\n" ++
    "        j = ps[k]\n" ++
    "        ps[k] = ps[pividx]\n" ++
    "        ps[pividx] = j\n" ++
    "      end\n" ++
    "      pivot   = a[ps[k]*n+k]\n" ++
    "      for i in (k+1)...n do\n" ++
    "        psin = ps[i]*n\n" ++
    "        a[psin+k] = mult = a[psin+k].div(pivot,prec)\n" ++
    "        if mult!=zero then\n" ++
    "          pskn = ps[k]*n\n" ++
    "          for j in (k+1)...n do\n" ++
    "            a[psin+j] -= mult.mult(a[pskn+j],prec)\n" ++
    "          end\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "    raise \"Singular matrix\" if a[ps[n1]*n+n1] == zero\n" ++
    "    ps\n" ++
    "  end\n" ++
    "\n" ++
    "  # Solves a*x = b for x, using LU decomposition.\n" ++
    "  #\n" ++
    "  # a is a matrix, b is a constant vector, x is the solution vector.\n" ++
    "  #\n" ++
    "  # ps is the pivot, a vector which indicates the permutation of rows performed\n" ++
    "  # during LU decomposition.\n" ++
    "  def lusolve(a,b,ps,zero=0.0)\n" ++
    "    prec = BigDecimal.limit(nil)\n" ++
    "    n = ps.size\n" ++
    "    x = []\n" ++
    "    for i in 0...n do\n" ++
    "      dot = zero\n" ++
    "      psin = ps[i]*n\n" ++
    "      for j in 0...i do\n" ++
    "        dot = a[psin+j].mult(x[j],prec) + dot\n" ++
    "      end\n" ++
    "      x <<= b[ps[i]] - dot\n" ++
    "    end\n" ++
    "    (n-1).downto(0) do |i|\n" ++
    "      dot = zero\n" ++
    "      psin = ps[i]*n\n" ++
    "      for j in (i+1)...n do\n" ++
    "        dot = a[psin+j].mult(x[j],prec) + dot\n" ++
    "      end\n" ++
    "      x[i]  = (x[i]-dot).div(a[psin+i],prec)\n" ++
    "    end\n" ++
    "    x\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "bigdecimal/newton" then
    "# frozen_string_literal: false\n" ++
    "require \"bigdecimal/ludcmp\"\n" ++
    "require \"bigdecimal/jacobian\"\n" ++
    "\n" ++
    "warn \"'bigdecimal/newton' is deprecated and will be removed in a future release.\"\n" ++
    "\n" ++
    "#\n" ++
    "# newton.rb\n" ++
    "#\n" ++
    "# Solves the nonlinear algebraic equation system f = 0 by Newton's method.\n" ++
    "# This program is not dependent on BigDecimal.\n" ++
    "#\n" ++
    "# To call:\n" ++
    "#    n = nlsolve(f,x)\n" ++
    "#  where n is the number of iterations required,\n" ++
    "#        x is the initial value vector\n" ++
    "#        f is an Object which is used to compute the values of the equations to be solved.\n" ++
    "# It must provide the following methods:\n" ++
    "#\n" ++
    "# f.values(x):: returns the values of all functions at x\n" ++
    "#\n" ++
    "# f.zero:: returns 0.0\n" ++
    "# f.one:: returns 1.0\n" ++
    "# f.two:: returns 2.0\n" ++
    "# f.ten:: returns 10.0\n" ++
    "#\n" ++
    "# f.eps:: returns the convergence criterion (epsilon value) used to determine whether two values are considered equal. If |a-b| < epsilon, the two values are considered equal.\n" ++
    "#\n" ++
    "# On exit, x is the solution vector.\n" ++
    "#\n" ++
    "module Newton\n" ++
    "  include LUSolve\n" ++
    "  include Jacobian\n" ++
    "  module_function\n" ++
    "\n" ++
    "  def norm(fv,zero=0.0) # :nodoc:\n" ++
    "    s = zero\n" ++
    "    n = fv.size\n" ++
    "    for i in 0...n do\n" ++
    "      s += fv[i]*fv[i]\n" ++
    "    end\n" ++
    "    s\n" ++
    "  end\n" ++
    "\n" ++
    "  # See also Newton\n" ++
    "  def nlsolve(f,x)\n" ++
    "    nRetry = 0\n" ++
    "    n = x.size\n" ++
    "\n" ++
    "    f0 = f.values(x)\n" ++
    "    zero = f.zero\n" ++
    "    one  = f.one\n" ++
    "    two  = f.two\n" ++
    "    p5 = one/two\n" ++
    "    d  = norm(f0,zero)\n" ++
    "    minfact = f.ten*f.ten*f.ten\n" ++
    "    minfact = one/minfact\n" ++
    "    e = f.eps\n" ++
    "    while d >= e do\n" ++
    "      nRetry += 1\n" ++
    "      # Not yet converged. => Compute Jacobian matrix\n" ++
    "      dfdx = jacobian(f,f0,x)\n" ++
    "      # Solve dfdx*dx = -f0 to estimate dx\n" ++
    "      dx = lusolve(dfdx,f0,ludecomp(dfdx,n,zero,one),zero)\n" ++
    "      fact = two\n" ++
    "      xs = x.dup\n" ++
    "      begin\n" ++
    "        fact *= p5\n" ++
    "        if fact < minfact then\n" ++
    "          raise \"Failed to reduce function values.\"\n" ++
    "        end\n" ++
    "        for i in 0...n do\n" ++
    "          x[i] = xs[i] - dx[i]*fact\n" ++
    "        end\n" ++
    "        f0 = f.values(x)\n" ++
    "        dn = norm(f0,zero)\n" ++
    "      end while(dn>=d)\n" ++
    "      d = dn\n" ++
    "    end\n" ++
    "    nRetry\n" ++
    "  end\n" ++
    "end\n"
  else "";
