    "\n" ++
    "  ROUNDING_NAMES = \{\n" ++
    "    up: ROUND_UP, down: ROUND_DOWN, half_up: ROUND_HALF_UP, half_down: ROUND_HALF_DOWN,\n" ++
    "    ceil: ROUND_CEILING, floor: ROUND_FLOOR, half_even: ROUND_HALF_EVEN,\n" ++
    "    default: ROUND_HALF_UP, truncate: ROUND_DOWN, banker: ROUND_HALF_EVEN, ceiling: ROUND_CEILING\n" ++
    "  \}.freeze\n" ++
    "  private_constant :ROUNDING_NAMES\n" ++
