    "        # Estimate (y*log(x)).exponent\n" ++
    "        logx_exponent = x < 2 ? (x - 1).exponent : Math.log10(x.exponent).round\n" ++
    "        ylogx_exponent = y.exponent + logx_exponent\n" ++
