    "           when ROUND_UP then true\n" ++
    "           when ROUND_DOWN then false\n" ++
    "           when ROUND_HALF_UP then twice >= den\n" ++
    "           when ROUND_HALF_DOWN then twice > den\n" ++
    "           when ROUND_HALF_EVEN then twice > den || (twice == den && q.odd?)\n" ++
    "           when ROUND_CEILING then !neg\n" ++
    "           when ROUND_FLOOR then neg\n" ++
    "           else twice >= den\n" ++
