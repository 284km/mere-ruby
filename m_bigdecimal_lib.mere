    "    (__msd.div(BASE_FIG)) - (@e.div(BASE_FIG)) + 1\n" ++
    "  end\n" ++
    "\n" ++
    "  def __coerce_prec(prec)\n" ++
    "    prec = __words * BASE_FIG if prec == 0\n" ++
    "    prec < 2 * DOUBLE_FIG ? 2 * DOUBLE_FIG : prec\n" ++
    "  end\n" ++
    "\n" ++
    "  def __operand!(v, prec = 0)\n" ++
    "    b = BigDecimal.__operand(v, __coerce_prec(prec))\n" ++
    "    return b if b\n" ++
    "    s = (v.nil? || v == true || v == false || v.is_a?(Symbol) || v.is_a?(Integer)) ? v.inspect : v.class.to_s\n" ++
    "    raise TypeError, \"#\{s\} can't be coerced into BigDecimal\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def __coercible?(v) = v.is_a?(BigDecimal) || v.is_a?(Integer) || v.is_a?(Float) || v.is_a?(Rational)\n" ++
    "\n" ++
    "  # what the other operand's coerce makes of it (rb_num_coerce_bin)\n" ++
    "  def __via_coerce(v, op)\n" ++
    "    unless v.respond_to?(:coerce)\n" ++
    "      raise TypeError, \"#\{__cname(v)\} can't be coerced into BigDecimal\"\n" ++
    "    end\n" ++
    "    a, b = v.coerce(self)\n" ++
    "    a.public_send(op, b)\n" ++
    "  end\n" ++
    "\n" ++
    "  def __cname(v) = (v.nil? || v == true || v == false || v.is_a?(Integer) || v.is_a?(Float)) ? v.inspect : v.class.to_s\n" ++
    "\n" ++
    "  # ---- predicates and parts ---------------------------------------------------\n" ++
    "\n" ++
    "  def nan? = @kind == :nan\n" ++
    "  def infinite? = @kind == :inf ? @sign : nil\n" ++
    "  def finite? = @kind == :finite || @kind == :zero\n" ++
    "  def zero? = @kind == :zero\n" ++
    "  def nonzero? = @kind == :zero ? nil : self\n" ++
    "\n" ++
    "  def sign\n" ++
    "    case @kind\n" ++
    "    when :nan then SIGN_NaN\n" ++
    "    when :zero then @sign > 0 ? SIGN_POSITIVE_ZERO : SIGN_NEGATIVE_ZERO\n" ++
    "    when :inf then @sign > 0 ? SIGN_POSITIVE_INFINITE : SIGN_NEGATIVE_INFINITE\n" ++
    "    else @sign > 0 ? SIGN_POSITIVE_FINITE : SIGN_NEGATIVE_FINITE\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def exponent = @kind == :finite ? __msd + 1 : 0\n" ++
    "\n" ++
    "  def precision\n" ++
    "    return 0 unless @kind == :finite\n" ++
    "    m = __msd\n" ++
    "    (m >= 0 ? m + 1 : 0) + scale\n" ++
    "  end\n" ++
    "\n" ++
    "  def scale = @kind == :finite && @e < 0 ? -@e : 0\n" ++
    "\n" ++
    "  def precision_scale = [precision, scale]\n" ++
    "\n" ++
    "  def n_significant_digits = @kind == :finite ? @c.to_s.length : 0\n" ++
    "\n" ++
    "  def split\n" ++
    "    digits = case @kind\n" ++
    "             when :nan then \"NaN\"\n" ++
    "             when :inf then \"Infinity\"\n" ++
    "             when :zero then \"0\"\n" ++
    "             else @c.to_s\n" ++
    "             end\n" ++
    "    s = @kind == :nan ? 0 : (@sign < 0 ? -1 : 1)\n" ++
    "    [s, digits, 10, exponent]\n" ++
    "  end\n" ++
    "\n" ++
    "  def hash\n" ++
    "    case @kind\n" ++
    "    when :finite then [@sign, @c, @e].hash\n" ++
    "    when :zero then 1.hash\n" ++
    "    when :nan then 0.hash\n" ++
    "    else (3 * @sign).hash\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def dup = self\n" ++
    "  alias clone dup\n" ++
    "\n" ++
    "  # ---- conversions -------------------------------------------------------------\n" ++
    "\n" ++
    "  def __check_num!\n" ++
    "    if @kind == :nan\n" ++
    "      raise FloatDomainError, \"Computation results in 'NaN' (Not a Number)\"\n" ++
    "    elsif @kind == :inf\n" ++
    "      raise FloatDomainError, @sign > 0 ? \"Computation results in 'Infinity'\" : \"Computation results in '-Infinity'\"\n" ++
    "    end\n" ++
    "  end\n" ++
    "  private :__check_num!\n" ++
    "\n" ++
    "  def to_i\n" ++
    "    __check_num!\n" ++
    "    return 0 if @kind == :zero\n" ++
    "    v = @e >= 0 ? @c * 10**@e : @c / 10**(-@e)\n" ++
    "    @sign < 0 ? -v : v\n" ++
    "  end\n" ++
    "  alias to_int to_i\n" ++
    "\n" ++
    "  def to_r\n" ++
    "    __check_num!\n" ++
    "    return Rational(0, 1) if @kind == :zero\n" ++
    "    num = @sign < 0 ? -@c : @c\n" ++
    "    @e >= 0 ? Rational(num * 10**@e, 1) : Rational(num, 10**(-@e))\n" ++
    "  end\n" ++
    "\n" ++
    "  def to_f\n" ++
    "    case @kind\n" ++
    "    when :nan then return Float::NAN\n" ++
    "    when :inf then return @sign > 0 ? Float::INFINITY : -Float::INFINITY\n" ++
    "    when :zero then return @sign > 0 ? 0.0 : -0.0\n" ++
    "    end\n" ++
    "    e10 = exponent\n" ++
    "    if e10 > 308 + BASE_FIG\n" ++
    "      BigDecimal.__exception(EXCEPTION_OVERFLOW, \"BigDecimal to Float conversion\")\n" ++
    "      return @sign > 0 ? Float::INFINITY : -Float::INFINITY\n" ++
    "    end\n" ++
    "    if e10 < -307 - 15\n" ++
    "      BigDecimal.__exception(EXCEPTION_UNDERFLOW, \"BigDecimal to Float conversion\")\n" ++
    "      return @sign > 0 ? 0.0 : -0.0\n" ++
    "    end\n" ++
    "    f = to_s.to_f\n" ++
    "    if f.infinite?\n" ++
    "      BigDecimal.__exception(EXCEPTION_OVERFLOW, \"BigDecimal to Float conversion\")\n" ++
    "    elsif f == 0.0\n" ++
    "      BigDecimal.__exception(EXCEPTION_UNDERFLOW, \"BigDecimal to Float conversion\")\n" ++
    "      f = @sign > 0 ? 0.0 : -0.0\n" ++
    "    end\n" ++
    "    f\n" ++
    "  end\n" ++
    "\n" ++
    "  def coerce(other)\n" ++
    "    b = __operand!(other)\n" ++
    "    [BigDecimal.__check(b), self]\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- printing ----------------------------------------------------------------\n" ++
    "\n" ++
    "  def __special_s(plus)\n" ++
    "    case @kind\n" ++
    "    when :nan then \"NaN\"\n" ++
    "    when :inf then @sign > 0 ? (plus == 1 ? \" Infinity\" : plus == 2 ? \"+Infinity\" : \"Infinity\") : \"-Infinity\"\n" ++
    "    when :zero\n" ++
    "      return \"-0.0\" if @sign < 0\n" ++
    "      plus == 1 ? \" 0.0\" : plus == 2 ? \"+0.0\" : \"0.0\"\n" ++
    "    end\n" ++
    "  end\n" ++
    "  private :__special_s\n" ++
    "\n" ++
    "  def to_s(fmt = nil) = __format(fmt).dup.force_encoding(Encoding::US_ASCII)\n" ++
    "\n" ++
    "  # (not through #to_s: an override of to_s leaves inspect alone)\n" ++
    "  def inspect = __format(nil).dup.force_encoding(Encoding::BINARY)\n" ++
    "\n" ++
    "  def __format(fmt)\n" ++
    "    plus = 0\n" ++
    "    group = 0\n" ++
    "    f_format = false\n" ++
    "    if fmt.is_a?(String)\n" ++
    "      s = fmt\n" ++
    "      if s.start_with?(\" \")\n" ++
    "        plus = 1\n" ++
    "        s = s[1..]\n" ++
    "      elsif s.start_with?(\"+\")\n" ++
    "        plus = 2\n" ++
    "        s = s[1..]\n" ++
    "      end\n" ++
    "      s.each_char do |ch|\n" ++
    "        next if ch.match?(/\\s/)\n" ++
    "        unless ch.match?(/\\d/)\n" ++
    "          f_format = true if ch == \"F\" || ch == \"f\"\n" ++
    "          break\n" ++
    "        end\n" ++
    "        group = group * 10 + ch.to_i\n" ++
    "      end\n" ++
    "    elsif !fmt.nil?\n" ++
    "      m = Integer(fmt)\n" ++
    "      raise ArgumentError, \"argument must be positive\" if m <= 0\n" ++
    "      group = m\n" ++
    "    end\n" ++
    "    sp = __special_s(plus)\n" ++
    "    return sp if sp\n" ++
    "    head = @sign < 0 ? \"-\" : plus == 1 ? \" \" : plus == 2 ? \"+\" : \"\"\n" ++
    "    digits = @c.to_s\n" ++
    "    if f_format\n" ++
    "      point = digits.length + @e # digits before the point\n" ++
    "      if point <= 0\n" ++
    "        ip = \"0\"\n" ++
    "        fp = \"0\" * -point + digits\n" ++
    "      elsif @e >= 0\n" ++
    "        ip = digits + \"0\" * @e\n" ++
    "        fp = \"\"\n" ++
    "      else\n" ++
    "        ip = digits[0, point]\n" ++
    "        fp = digits[point..]\n" ++
    "      end\n" ++
    "      if group > 0\n" ++
    "        ip = ip.reverse.scan(/.\{1,#\{group\}\}/).join(\" \").reverse if ip != \"0\" || point > 0\n" ++
    "        fp = fp.scan(/.\{1,#\{group\}\}/).join(\" \")\n" ++
    "      end\n" ++
    "      fp = \"0\" if fp.empty?\n" ++
    "      head + ip + \".\" + fp\n" ++
    "    else\n" ++
    "      mant = group > 0 ? digits.scan(/.\{1,#\{group\}\}/).join(\" \") : digits\n" ++
    "      head + \"0.\" + mant + \"e\" + exponent.to_s\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def _dump(_limit = nil) = \"#\{__words * BASE_FIG\}:#\{to_s\}\"\n" ++
    "\n" ++
    "  # ---- arithmetic ----------------------------------------------------------------\n" ++
    "\n" ++
    "  def +@ = self\n" ++
    "\n" ++
    "  def -@\n" ++
    "    case @kind\n" ++
    "    when :nan then self\n" ++
    "    else BigDecimal.__make(@kind, -@sign, @c, @e)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def abs\n" ++
    "    return self if @kind == :nan\n" ++
    "    BigDecimal.__make(@kind, 1, @c, @e)\n" ++
    "  end\n" ++
    "\n" ++
    "  # sum or difference (op +1 / -1), exact, then prec digits or the limit\n" ++
    "  def __addsub(b, op, prec)\n" ++
    "    return BigDecimal.__check(self) if @kind == :nan\n" ++
    "    return BigDecimal.__check(b) if b.__kind == :nan\n" ++
    "    bs = b.__sign * op\n" ++
    "    if @kind == :inf || b.__kind == :inf\n" ++
    "      if @kind == :inf && b.__kind == :inf\n" ++
    "        return BigDecimal.__check(@sign == bs ? self : BigDecimal.__nan)\n" ++
    "      end\n" ++
    "      return BigDecimal.__check(@kind == :inf ? self : BigDecimal.__inf(bs))\n" ++
    "    end\n" ++
    "    if @kind == :zero && b.__kind == :zero\n" ++
    "      r = BigDecimal.__zero(@sign < 0 && bs < 0 ? -1 : 1)\n" ++
    "    elsif @kind == :zero\n" ++
    "      r = BigDecimal.__make(:finite, bs, b.__c, b.__e)\n" ++
    "    elsif b.__kind == :zero\n" ++
    "      r = self\n" ++
    "    else\n" ++
    "      e = [@e, b.__e].min\n" ++
    "      x = (@sign * @c) * 10**(@e - e) + (bs * b.__c) * 10**(b.__e - e)\n" ++
    "      r = x == 0 ? BigDecimal.__zero(1) : BigDecimal.__make(:finite, x < 0 ? -1 : 1, x.abs, e)\n" ++
    "    end\n" ++
    "    r = prec > 0 ? r.__sigdigits(prec) : r.__limited\n" ++
    "    BigDecimal.__check(r)\n" ++
    "  end\n" ++
    "  protected :__addsub\n" ++
    "\n" ++
    "  def +(other)\n" ++
    "    return __via_coerce(other, :+) unless __coercible?(other)\n" ++
    "    __addsub(__operand!(other), 1, 0)\n" ++
    "  end\n" ++
    "\n" ++
    "  def -(other)\n" ++
    "    return __via_coerce(other, :-) unless __coercible?(other)\n" ++
    "    __addsub(__operand!(other), -1, 0)\n" ++
    "  end\n" ++
    "\n" ++
    "  def add(other, n)\n" ++
    "    n = __prec_arg(n)\n" ++
    "    __addsub(__operand!(other, n), 1, n)\n" ++
    "  end\n" ++
    "\n" ++
    "  def sub(other, n)\n" ++
    "    n = __prec_arg(n)\n" ++
    "    __addsub(__operand!(other, n), -1, n)\n" ++
    "  end\n" ++
    "\n" ++
    "  def __prec_arg(n)\n" ++
    "    n = Integer(n)\n" ++
    "    raise ArgumentError, \"negative precision\" if n < 0\n" ++
    "    n\n" ++
    "  end\n" ++
    "  private :__prec_arg\n" ++
    "\n" ++
    "  def __mult(b, prec)\n" ++
    "    return BigDecimal.__check(BigDecimal.__nan) if @kind == :nan || b.__kind == :nan\n" ++
    "    s = @sign * b.__sign\n" ++
    "    if @kind == :inf || b.__kind == :inf\n" ++
    "      return BigDecimal.__check(BigDecimal.__nan) if @kind == :zero || b.__kind == :zero\n" ++
    "      return BigDecimal.__check(BigDecimal.__inf(s))\n" ++
    "    end\n" ++
    "    r = if @kind == :zero || b.__kind == :zero\n" ++
    "          BigDecimal.__zero(s)\n" ++
    "        else\n" ++
    "          BigDecimal.__make(:finite, s, @c * b.__c, @e + b.__e)\n" ++
    "        end\n" ++
    "    r = prec > 0 ? r.__sigdigits(prec) : r.__limited\n" ++
    "    BigDecimal.__check(r)\n" ++
    "  end\n" ++
    "  protected :__mult\n" ++
    "\n" ++
    "  def *(other)\n" ++
    "    return __via_coerce(other, :*) unless __coercible?(other)\n" ++
    "    __mult(__operand!(other), 0)\n" ++
    "  end\n" ++
    "\n" ++
    "  def mult(other, n)\n" ++
    "    n = __prec_arg(n)\n" ++
    "    __mult(__operand!(other, n), n)\n" ++
    "  end\n" ++
    "\n" ++
    "  # a / b to ix significant digits (BigDecimal_div2 with digits)\n" ++
    "  def __divide(b, ix)\n" ++
    "    return BigDecimal.__check(BigDecimal.__nan) if @kind == :nan || b.__kind == :nan\n" ++
    "    s = @sign * b.__sign\n" ++
    "    if @kind == :inf\n" ++
    "      return BigDecimal.__check(BigDecimal.__nan) if b.__kind == :inf\n" ++
    "      return BigDecimal.__check(BigDecimal.__inf(s))\n" ++
    "    end\n" ++
    "    return BigDecimal.__check(BigDecimal.__zero(s)) if b.__kind == :inf\n" ++
    "    if b.__kind == :zero\n" ++
    "      if @kind == :zero\n" ++
    "        BigDecimal.__exception(EXCEPTION_NaN, \"Computation results to 'NaN'\")\n" ++
    "        return BigDecimal.__check(BigDecimal.__nan)\n" ++
    "      end\n" ++
    "      BigDecimal.__exception(EXCEPTION_ZERODIVIDE, \"Divide by zero\")\n" ++
    "      return BigDecimal.__check(BigDecimal.__inf(s))\n" ++
    "    end\n" ++
    "    return BigDecimal.__zero(s) if @kind == :zero\n" ++
    "    if ix == 0\n" ++
    "      ix = [precision, b.precision].max + DOUBLE_FIG\n" ++
    "      ix = 2 * DOUBLE_FIG if ix < 2 * DOUBLE_FIG\n" ++
    "      l = BigDecimal.__limit\n" ++
    "      ix = l if l > 0 && l < ix\n" ++
    "    end\n" ++
    "    # exact quotient, scaled to keep ix + 1 significant digits and more\n" ++
    "    num = @c\n" ++
    "    den = b.__c\n" ++
    "    e = @e - b.__e\n" ++
    "    shift = ix + 2 + den.to_s.length - num.to_s.length\n" ++
    "    shift = 0 if shift < 0\n" ++
    "    num *= 10**shift\n" ++
    "    e -= shift\n" ++
    "    q, r = num.divmod(den)\n" ++
    "    # the remainder decides a half-way case, as the extension's sticky digit\n" ++
    "    q = q * 10 + (r == 0 ? 0 : 1)\n" ++
    "    e -= 1\n" ++
    "    v = BigDecimal.__make(:finite, s, q, e)\n" ++
    "    BigDecimal.__check(v.__sigdigits(ix))\n" ++
    "  end\n" ++
    "  protected :__divide\n" ++
    "\n" ++
    "  def /(other)\n" ++
    "    return __via_coerce(other, :/) unless __coercible?(other)\n" ++
    "    __divide(__operand!(other), 0)\n" ++
    "  end\n" ++
    "\n" ++
    "  def quo(other, n = nil)\n" ++
    "    if n.nil? || (n = __prec_arg(n)) == 0\n" ++
    "      return __via_coerce(other, :quo) unless __coercible?(other)\n" ++
    "      return __divide(__operand!(other), 0)\n" ++
    "    end\n" ++
    "    __divide(__operand!(other, n), n)\n" ++
    "  end\n" ++
    "\n" ++
    "  def div(other, n = nil)\n" ++
    "    if n.nil?\n" ++
    "      return __via_coerce(other, :div) unless __coercible?(other)\n" ++
    "      d, = __divmod(__operand!(other), false)\n" ++
    "      return d.to_i\n" ++
    "    end\n" ++
    "    n = __prec_arg(n)\n" ++
    "    __divide(__operand!(other, n), n)\n" ++
    "  end\n" ++
    "\n" ++
    "  # [quotient, modulus] as the extension's BigDecimal_DoDivmod: floored (or\n" ++
    "  # truncated) quotient, exact remainder\n" ++
    "  def __divmod(b, truncate)\n" ++
    "    if @kind == :nan || b.__kind == :nan || (@kind == :inf && b.__kind == :inf)\n" ++
    "      return [BigDecimal.__nan, BigDecimal.__nan]\n" ++
    "    end\n" ++
    "    raise ZeroDivisionError, \"divided by 0\" if b.__kind == :zero\n" ++
    "    if @kind == :inf\n" ++
    "      return [BigDecimal.__inf(@sign == b.__sign ? 1 : -1), BigDecimal.__nan]\n" ++
    "    end\n" ++
    "    return [BigDecimal.__zero(1), self] if @kind == :zero\n" ++
    "    if b.__kind == :inf\n" ++
    "      if !truncate && @sign * b.__sign < 0\n" ++
    "        return [BigDecimal.__make(:finite, -1, 1, 0), b]\n" ++
    "      end\n" ++
    "      return [BigDecimal.__zero(1), self]\n" ++
    "    end\n" ++
    "    e = [@e, b.__e].min\n" ++
    "    x = @sign * @c * 10**(@e - e)\n" ++
    "    y = b.__sign * b.__c * 10**(b.__e - e)\n" ++
    "    if truncate\n" ++
    "      q = x.abs / y.abs\n" ++
    "      q = -q if (x < 0) != (y < 0)\n" ++
    "      m = x - q * y\n" ++
    "    else\n" ++
    "      q, m = x.divmod(y)\n" ++
    "    end\n" ++
    "    qv = q == 0 ? BigDecimal.__zero(1) : BigDecimal.__make(:finite, q < 0 ? -1 : 1, q.abs, 0)\n" ++
    "    mv = m == 0 ? BigDecimal.__zero(@sign) : BigDecimal.__make(:finite, m < 0 ? -1 : 1, m.abs, e)\n" ++
    "    [qv, mv]\n" ++
    "  end\n" ++
    "  protected :__divmod\n" ++
    "\n" ++
    "  def %(other)\n" ++
    "    return __via_coerce(other, :%) unless __coercible?(other)\n" ++
    "    _, m = __divmod(__operand!(other), false)\n" ++
    "    BigDecimal.__check(m)\n" ++
    "  end\n" ++
    "  alias modulo %\n" ++
    "\n" ++
    "  def remainder(other)\n" ++
    "    return __via_coerce(other, :remainder) unless __coercible?(other)\n" ++
    "    _, m = __divmod(__operand!(other), true)\n" ++
    "    BigDecimal.__check(m)\n" ++
    "  end\n" ++
    "\n" ++
    "  def divmod(other)\n" ++
    "    return __via_coerce(other, :divmod) unless __coercible?(other)\n" ++
    "    d, m = __divmod(__operand!(other), false)\n" ++
    "    [BigDecimal.__check(d).to_i, BigDecimal.__check(m)]\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- rounding --------------------------------------------------------------------\n" ++
    "\n" ++
    "  def __round_mode_for(n, mode)\n" ++
    "    BigDecimal.__check(__round_at(n, mode))\n" ++
    "  end\n" ++
    "  private :__round_mode_for\n" ++
    "\n" ++
    "  def round(*args)\n" ++
    "    n = 0\n" ++
    "    to_int = false\n" ++
    "    sw = BigDecimal.__rounding_mode\n" ++
    "    case args.size\n" ++
    "    when 0\n" ++
    "      to_int = true\n" ++
    "    when 1\n" ++
    "      if args[0].is_a?(Hash)\n" ++
    "        sw = BigDecimal.__rounding_option(args[0])\n" ++
    "        to_int = true\n" ++
    "      else\n" ++
    "        n = Integer(args[0])\n" ++
    "        to_int = true if n < 1\n" ++
    "      end\n" ++
    "    when 2\n" ++
    "      n = Integer(args[0])\n" ++
    "      sw = args[1].is_a?(Hash) ? BigDecimal.__rounding_option(args[1]) : BigDecimal.__check_rounding_mode(args[1])\n" ++
    "    else\n" ++
    "      raise ArgumentError, \"wrong number of arguments (given #\{args.size\}, expected 0..2)\"\n" ++
    "    end\n" ++
    "    r = __round_mode_for(n, sw)\n" ++
    "    to_int ? r.to_i : r\n" ++
    "  end\n" ++
    "\n" ++
    "  def __trunc_like(args, mode)\n" ++
    "    raise ArgumentError, \"wrong number of arguments (given #\{args.size\}, expected 0..1)\" if args.size > 1\n" ++
    "    n = args.empty? ? 0 : Integer(args[0])\n" ++
    "    r = __round_mode_for(n, mode)\n" ++
    "    args.empty? ? r.to_i : r\n" ++
    "  end\n" ++
    "  private :__trunc_like\n" ++
    "\n" ++
    "  def truncate(*args) = __trunc_like(args, ROUND_DOWN)\n" ++
    "  def floor(*args) = __trunc_like(args, ROUND_FLOOR)\n" ++
    "  def ceil(*args) = __trunc_like(args, ROUND_CEILING)\n" ++
    "\n" ++
    "  def fix\n" ++
    "    return self unless @kind == :finite\n" ++
    "    __round_at(0, ROUND_DOWN)\n" ++
    "  end\n" ++
    "\n" ++
    "  def frac\n" ++
    "    return self unless @kind == :finite\n" ++
    "    return BigDecimal.__zero(@sign) if @e >= 0\n" ++
    "    m = @c % 10**(-@e)\n" ++
    "    m == 0 ? BigDecimal.__zero(@sign) : BigDecimal.__make(:finite, @sign, m, @e)\n" ++
    "  end\n" ++
    "\n" ++
    "  # self * 10**i, exactly\n" ++
    "  def _decimal_shift(i)\n" ++
    "    i = Integer(i)\n" ++
    "    return self unless @kind == :finite\n" ++
    "    BigDecimal.__make(:finite, @sign, @c, @e + i)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- comparison -----------------------------------------------------------------\n" ++
    "\n" ++
    "  def <=>(other)\n" ++
    "    unless __coercible?(other)\n" ++
    "      return (other.respond_to?(:coerce) ? (begin; a, b = other.coerce(self); a <=> b; rescue StandardError; nil; end) : nil)\n" ++
    "    end\n" ++
    "    b = __operand!(other)\n" ++
    "    return nil if @kind == :nan || b.__kind == :nan\n" ++
    "    __cmp(b)\n" ++
    "  end\n" ++
    "\n" ++
    "  def __cmp(b)\n" ++
    "    av = __rank\n" ++
    "    bv = b.__rank\n" ++
    "    return av <=> bv if av != bv\n" ++
    "    return 0 if @kind == :inf || @kind == :zero\n" ++
    "    # magnitudes differ in the leading digit's place before any alignment\n" ++
    "    am = __msd\n" ++
    "    bm = b.__msd\n" ++
    "    return (am <=> bm) * @sign if am != bm\n" ++
    "    e = [@e, b.__e].min\n" ++
    "    (@sign * @c * 10**(@e - e)) <=> (b.__sign * b.__c * 10**(b.__e - e))\n" ++
    "  end\n" ++
    "  protected :__cmp\n" ++
    "\n" ++
    "  # -2: -Infinity, -1: negative, 0: zero, 1: positive, 2: +Infinity\n" ++
    "  def __rank\n" ++
    "    case @kind\n" ++
    "    when :inf then 2 * @sign\n" ++
    "    when :zero then 0\n" ++
    "    else @sign\n" ++
    "    end\n" ++
    "  end\n" ++
    "  protected :__rank\n" ++
    "\n" ++
    "  def ==(other)\n" ++
    "    unless __coercible?(other)\n" ++
    "      return false unless other.respond_to?(:coerce)\n" ++
    "      begin\n" ++
    "        a, b = other.coerce(self)\n" ++
    "        return a == b\n" ++
    "      rescue StandardError\n" ++
    "        return false\n" ++
    "      end\n" ++
    "    end\n" ++
    "    b = __operand!(other)\n" ++
    "    return false if @kind == :nan || b.__kind == :nan\n" ++
    "    __cmp(b) == 0\n" ++
    "  end\n" ++
    "  alias === ==\n" ++
    "  alias eql? ==\n" ++
    "\n" ++
    "  def __relop(other, op)\n" ++
    "    unless __coercible?(other)\n" ++
    "      begin\n" ++
    "        raise NoMethodError unless other.respond_to?(:coerce)\n" ++
    "        a, b = other.coerce(self)\n" ++
    "      rescue StandardError\n" ++
    "        raise ArgumentError, \"comparison of BigDecimal with #\{__cname(other)\} failed\"\n" ++
    "      end\n" ++
    "      return a.public_send(op, b)\n" ++
    "    end\n" ++
    "    b = __operand!(other)\n" ++
    "    return false if @kind == :nan || b.__kind == :nan\n" ++
    "    __cmp(b).public_send(op, 0)\n" ++
    "  end\n" ++
    "  private :__relop\n" ++
    "\n" ++
    "  def <(other) = __relop(other, :<)\n" ++
    "  def <=(other) = __relop(other, :<=)\n" ++
    "  def >(other) = __relop(other, :>)\n" ++
    "  def >=(other) = __relop(other, :>=)\n" ++
    "\n" ++
    "  INFINITY = __make(:inf, 1)\n" ++
    "  NAN = __make(:nan, 0)\n" ++
    "end\n" ++
    "\n" ++
    "module Kernel\n" ++
    "  def BigDecimal(val, digs = nil, exception: true)\n" ++
    "    unless digs.nil?\n" ++
    "      digs = Integer(digs)\n" ++
    "      if digs < 0\n" ++
    "        return nil unless exception\n" ++
    "        raise ArgumentError, \"negative precision\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "    BigDecimal.__convert(val, digs, exception)\n" ++
    "  end\n" ++
    "  module_function :BigDecimal\n" ++
    "end\n"
  else if str_eq n "bigdecimal" then
    "if RUBY_ENGINE == 'jruby'\n" ++
    "  JRuby::Util.load_ext(\"org.jruby.ext.bigdecimal.BigDecimalLibrary\")\n" ++
    "\n" ++
    "  class BigDecimal\n" ++
    "    def _decimal_shift(i) # :nodoc:\n" ++
    "      to_java.move_point_right(i).to_d\n" ++
    "    end\n" ++
    "  end\n" ++
    "else\n" ++
    "  require 'bigdecimal.so'\n" ++
    "end\n" ++
    "\n" ++
    "class BigDecimal\n" ++
    "  module Internal # :nodoc:\n" ++
    "\n" ++
    "    # Coerce x to BigDecimal with the specified precision.\n" ++
    "    # TODO: some methods (example: BigMath.exp) require more precision than specified to coerce.\n" ++
    "    def self.coerce_to_bigdecimal(x, prec, method_name) # :nodoc:\n" ++
    "      case x\n" ++
    "      when BigDecimal\n" ++
    "        return x\n" ++
    "      when Integer, Float\n" ++
    "        return BigDecimal(x, 0)\n" ++
    "      when Rational\n" ++
    "        return BigDecimal(x, [prec, 2 * BigDecimal.double_fig].max)\n" ++
    "      end\n" ++
    "      raise ArgumentError, \"#\{x.inspect\} can't be coerced into BigDecimal\"\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.coerce_validate_prec(prec, method_name, accept_zero: false) # :nodoc:\n" ++
    "      unless Integer === prec\n" ++
    "        original = prec\n" ++
    "        # Emulate Integer.try_convert for ruby < 3.1\n" ++
    "        if prec.respond_to?(:to_int)\n" ++
    "          prec = prec.to_int\n" ++
    "        else\n" ++
    "          raise TypeError, \"no implicit conversion of #\{original.class\} into Integer\"\n" ++
    "        end\n" ++
    "        raise TypeError, \"can't convert #\{original.class\} to Integer\" unless Integer === prec\n" ++
    "      end\n" ++
    "\n" ++
    "      if accept_zero\n" ++
    "        raise ArgumentError, \"Negative precision for #\{method_name\}\" if prec < 0\n" ++
    "      else\n" ++
    "        raise ArgumentError, \"Zero or negative precision for #\{method_name\}\" if prec <= 0\n" ++
    "      end\n" ++
    "      prec\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.infinity_computation_result # :nodoc:\n" ++
    "      if BigDecimal.mode(BigDecimal::EXCEPTION_ALL).anybits?(BigDecimal::EXCEPTION_INFINITY)\n" ++
    "        raise FloatDomainError, \"Computation results in 'Infinity'\"\n" ++
    "      end\n" ++
    "      BigDecimal::INFINITY\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.nan_computation_result # :nodoc:\n" ++
    "      if BigDecimal.mode(BigDecimal::EXCEPTION_ALL).anybits?(BigDecimal::EXCEPTION_NaN)\n" ++
    "        raise FloatDomainError, \"Computation results to 'NaN'\"\n" ++
    "      end\n" ++
    "      BigDecimal::NAN\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  #  call-seq:\n" ++
    "  #    self ** other -> bigdecimal\n" ++
    "  #\n" ++
    "  #  Returns the \\BigDecimal value of +self+ raised to power +other+:\n" ++
    "  #\n" ++
    "  #    b = BigDecimal('3.14')\n" ++
    "  #    b ** 2              # => 0.98596e1\n" ++
    "  #    b ** 2.0            # => 0.98596e1\n" ++
    "  #    b ** Rational(2, 1) # => 0.98596e1\n" ++
    "  #\n" ++
    "  #  Related: BigDecimal#power.\n" ++
    "  #\n" ++
    "  def **(y)\n" ++
    "    case y\n" ++
    "    when BigDecimal, Integer, Float, Rational\n" ++
    "      power(y)\n" ++
    "    when nil\n" ++
    "      raise TypeError, 'wrong argument type NilClass'\n" ++
    "    else\n" ++
    "      x, y = y.coerce(self)\n" ++
    "      x**y\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq:\n" ++
    "  #   power(n)\n" ++
    "  #   power(n, prec)\n" ++
    "  #\n" ++
    "  # Returns the value raised to the power of n.\n" ++
    "  #\n" ++
    "  # Also available as the operator **.\n" ++
    "  #\n" ++
    "  def power(y, prec = 0)\n" ++
    "    prec = Internal.coerce_validate_prec(prec, :power, accept_zero: true)\n" ++
    "    x = self\n" ++
    "    y = Internal.coerce_to_bigdecimal(y, prec.nonzero? || n_significant_digits, :power)\n" ++
    "\n" ++
    "    return Internal.nan_computation_result if x.nan? || y.nan?\n" ++
    "    return BigDecimal(1) if y.zero?\n" ++
    "\n" ++
    "    if y.infinite?\n" ++
    "      if x < 0\n" ++
    "        return BigDecimal(0) if x < -1 && y.negative?\n" ++
    "        return BigDecimal(0) if x > -1 && y.positive?\n" ++
    "        raise Math::DomainError, 'Result undefined for negative base raised to infinite power'\n" ++
    "      elsif x < 1\n" ++
    "        return y.positive? ? BigDecimal(0) : BigDecimal::Internal.infinity_computation_result\n" ++
    "      elsif x == 1\n" ++
    "        return BigDecimal(1)\n" ++
    "      else\n" ++
    "        return y.positive? ? BigDecimal::Internal.infinity_computation_result : BigDecimal(0)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    if x.infinite? && y < 0\n" ++
    "      # Computation result will be +0 or -0. Avoid overflow.\n" ++
    "      neg = x < 0 && y.frac.zero? && y % 2 == 1\n" ++
    "      return neg ? -BigDecimal(0) : BigDecimal(0)\n" ++
    "    end\n" ++
    "\n" ++
    "    if x.zero?\n" ++
    "      return BigDecimal(1) if y.zero?\n" ++
    "      return BigDecimal(0) if y > 0\n" ++
    "      if y.frac.zero? && y % 2 == 1 && x.sign == -1\n" ++
    "        return -BigDecimal::Internal.infinity_computation_result\n" ++
    "      else\n" ++
    "        return BigDecimal::Internal.infinity_computation_result\n" ++
    "      end\n" ++
    "    elsif x < 0\n" ++
    "      if y.frac.zero?\n" ++
    "        if y % 2 == 0\n" ++
    "          return (-x).power(y, prec)\n" ++
    "        else\n" ++
    "          return -(-x).power(y, prec)\n" ++
    "        end\n" ++
    "      else\n" ++
    "        raise Math::DomainError, 'Computation results in complex number'\n" ++
    "      end\n" ++
    "    elsif x == 1\n" ++
    "      return BigDecimal(1)\n" ++
    "    end\n" ++
    "\n" ++
    "    limit = BigDecimal.limit\n" ++
    "    frac_part = y.frac\n" ++
    "\n" ++
    "    if frac_part.zero? && prec.zero? && limit.zero?\n" ++
    "      # Infinite precision calculation for `x ** int` and `x.power(int)`\n" ++
    "      int_part = y.fix.to_i\n" ++
    "      int_part = -int_part if (neg = int_part < 0)\n" ++
    "      ans = BigDecimal(1)\n" ++
    "      n = 1\n" ++
    "      xn = x\n" ++
    "      while true\n" ++
    "        ans *= xn if int_part.allbits?(n)\n" ++
    "        n <<= 1\n" ++
    "        break if n > int_part\n" ++
    "        xn *= xn\n" ++
    "        # Detect overflow/underflow before consuming infinite memory\n" ++
    "        if (xn.exponent.abs - 1) * int_part / n >= 0x7FFFFFFFFFFFFFFF\n" ++
    "          return ((xn.exponent > 0) ^ neg ? BigDecimal::Internal.infinity_computation_result : BigDecimal(0)) * (int_part.even? || x > 0 ? 1 : -1)\n" ++
    "        end\n" ++
    "      end\n" ++
    "      return neg ? BigDecimal(1) / ans : ans\n" ++
    "    end\n" ++
    "\n" ++
    "    result_prec = prec.nonzero? || [x.n_significant_digits, y.n_significant_digits, BigDecimal.double_fig].max + BigDecimal.double_fig\n" ++
    "    result_prec = [result_prec, limit].min if prec.zero? && limit.nonzero?\n" ++
    "\n" ++
    "    prec2 = result_prec + BigDecimal.double_fig\n" ++
    "\n" ++
    "    if y < 0\n" ++
    "      inv = x.power(-y, prec2)\n" ++
    "      return BigDecimal(0) if inv.infinite?\n" ++
    "      return BigDecimal::Internal.infinity_computation_result if inv.zero?\n" ++
    "      return BigDecimal(1).div(inv, result_prec)\n" ++
    "    end\n" ++
    "\n" ++
    "    if frac_part.zero? && y.exponent < Math.log(result_prec) * 5 + 20\n" ++
    "      # Use exponentiation by squaring if y is an integer and not too large\n" ++
    "      pow_prec = prec2 + y.exponent\n" ++
    "      n = 1\n" ++
    "      xn = x\n" ++
    "      ans = BigDecimal(1)\n" ++
    "      int_part = y.fix.to_i\n" ++
    "      while true\n" ++
    "        ans = ans.mult(xn, pow_prec) if int_part.allbits?(n)\n" ++
    "        n <<= 1\n" ++
    "        break if n > int_part\n" ++
    "        xn = xn.mult(xn, pow_prec)\n" ++
