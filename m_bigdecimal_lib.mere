    "      if (f & EXCEPTION_ALL) != 0\n" ++
    "        fo = __exception_mode\n" ++
    "        return fo if val.nil?\n" ++
    "        raise ArgumentError, \"second argument must be true or false\" unless val == true || val == false\n" ++
