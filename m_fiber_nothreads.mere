// ---- the Fibers of a build that has no threads ------------------------------
// Compiled in place of m_fiber_coro.mere (same names) for the targets whose
// backend has no coroutines -- the Wasm playground (core Wasm cannot switch
// stacks) and the RV targets. See tools/nothreads_tree.sh.
//
// A fiber here cannot SUSPEND: its body runs to completion on the stack that
// resumed it, the model this interpreter had before fibers could suspend, and
// Fiber.yield / #transfer to a started fiber refuse by name
// (fb_can_suspend). Enumerator#next reads a buffer filled once, as it did.
let fb_can_suspend = false;
// no scheduler here: nothing ever waits for a deadline
let fb_os_sleep = fn (ms: int) -> ();

// no inboxes: an index stands in for one, so the callers keep their shape
let fb_inbox_of = fn (i: int) -> i;

// "switching" to a fiber whose body has already run is naming it as current
// and back; there is no other stack to wake
let fb_switch = fn (from: int) -> fn (to: int) -> map_set fb_st "cur" from;
let fb_hand_over = fn (to: int) -> map_set fb_st "cur" to;

// starting a fiber runs its whole body HERE, with this stack's state put
// aside and put back the way a switch would
let fb_run_body = fn (i: int) -> fn (inbox: int) ->
  let body = map_get fb_bodies i in
  let _ = map_delete fb_bodies i in
  fb_hand_over (body ());
let fb_start_thread = fn (i: int) -> fn (inbox: int) ->
  let me = fb_cur () in
  let _ = fb_ctx_save me in
  let _ = map_set fb_st "cur" i in
  let _ = fb_run_body i inbox in
  let _ = fb_ctx_restore me in
  map_set fb_st "cur" me;
