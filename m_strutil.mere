// String work that answers on its own, with no world and no block: the
// char-set methods (tr / count / delete / squeeze), #scrub, #undump, the
// permissive #to_c / #to_r grammars, crypt(3), padding, and the printing
// (to_s / inspect / puts) every value goes through.
//
// A MODULE, spliced by `import` where these chains used to sit.
// ---- char-set string methods (tr / count / delete / squeeze) -------------
let rec range_chars = fn (lo: int) -> fn (hi: int) ->
  if lo > hi then "" else chr lo ++ range_chars (lo + 1) hi;
// a codepoint range as UTF-8 characters ("あ-う" spans by codepoint).
let rec cp_range_chars = fn (lo: int) -> fn (hi: int) ->
  if lo > hi then "" else utf8_enc lo ++ cp_range_chars (lo + 1) hi;
// expand a tr/count set spec ("a-z0-9") into the explicit character list:
// characters, not bytes; a backslash protects the next character (so "\\-"
// is a hyphen); a trailing "-" is a literal hyphen.
let rec str_expand_set = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len s in
  if i >= n then acc
  else
    let w = utf8_clen s i in
    let c = substring s i (i + w) in
    if str_eq c "\\" && i + w < n then
      (let w2 = utf8_clen s (i + w) in
       str_expand_set s (i + w + w2) (acc ++ substring s (i + w) (i + w + w2)))
    else if i + w < n && str_eq (char_at s (i + w)) "-" && i + w + 1 < n then
      (let lo = (match utf8_cp s i with (cp, _) -> cp) in
       let hi = (match utf8_cp s (i + w + 1) with (cp, _) -> cp) in
       let w3 = utf8_clen s (i + w + 1) in
       if lo > hi then
         (let _ = prim_raise "ArgumentError"
                    ("invalid range \"" ++ substring s i (i + w + 1 + w3) ++ "\" in string transliteration") in "")
       // ⚠ A one-character range is ONE character. ruby 3.2 enumerated it
       //   twice ("a-a" yielded a, a) and this was written against that
       //   reference; ruby 4 does not, and tr's positional pairing is where the
       //   difference shows -- `"123456789".tr("2-23", "xy")` maps 2 to x
       //   under ruby 4 and to y (the second pairing) under 3.2. Membership
       //   cannot tell the two apart, which is why only tr and tr_s moved.
       else str_expand_set s (i + w + 1 + w3) (acc ++ cp_range_chars lo hi))
    else str_expand_set s (i + w) (acc ++ c);
// The character index of `c` in `set` (-1 if absent). These helpers all used to
// walk BYTES: `"日本語".tr("日", "X")` replaced each byte of 日 that appeared in
// the set, producing "XXXX\x9C\xAC..." -- not a string Ruby would ever return.
// On ASCII a byte and a character are the same thing, which is why nothing here
// looked wrong until a test used Japanese.
let rec char_pos_go = fn (set: str) -> fn (c: str) -> fn (i: int) -> fn (k: int) ->
  if i >= str_len set then 0 - 1
  else if str_eq (utf8_char_at set i) c then k
  else char_pos_go set c (i + utf8_clen set i) (k + 1);
// the LAST occurrence: tr's pairing is written left to right and a later
// pair for the same character WINS (the doubled one-character range above).
let rec char_pos_r_go = fn (set: str) -> fn (c: str) -> fn (i: int) -> fn (k: int) -> fn (best: int) ->
  if i >= str_len set then best
  else char_pos_r_go set c (i + utf8_clen set i) (k + 1) (if str_eq (utf8_char_at set i) c then k else best);
let char_pos_r = fn (set: str) -> fn (c: str) -> char_pos_r_go set c 0 0 (0 - 1);

// membership in a single set spec: leading ^ (len>=2) negates; a-z expands.
let str_set_has = fn (set0: str) -> fn (c: str) ->
  if str_len set0 >= 2 && str_eq (char_at set0 0) "^" then
    (if str_contains (str_expand_set (substring set0 1 (str_len set0)) 0 "") c then false else true)
  else str_contains (str_expand_set set0 0 "") c;
// a char passes when it is in EVERY set (Ruby intersects multiple set args).
let rec all_sets_has = fn (sets: str list) -> fn (c: str) ->
  match sets with Nil -> true | Cons (h, t) -> if str_set_has h c then all_sets_has t c else false;

// ruby 4.0: strip / lstrip / rstrip take tr-style SELECTORS (`strip("x")`,
// `strip("a-c")`, `strip("^a")`), intersected the way #count's are; with a
// selector given, whitespace is no longer stripped unless it is selected. A
// selector that is not a String is a TypeError, as for #count.
let strip_selectors = fn (args: Val list) ->
  let rec go = fn (xs: Val list) ->
    (match xs with
     | Nil -> (Nil : str list)
     | Cons (VStr h, t) -> Cons (sget h, go t)
     | Cons (v, _) -> (let _ = conv_err v "String" in (Nil : str list))) in
  go args;
// strip the CHARACTERS (UTF-8 codepoints) every selector admits, from the
// left (`l`) and/or the right (`r`).
let str_strip_sel = fn (s: str) -> fn (sels: str list) -> fn (l: bool) -> fn (r: bool) ->
  let cps = decode_cps s "UTF-8" 0 in
  let hit = fn (cp: int) -> all_sets_has sels (utf8_enc cp) in
  let rec dropl = fn (xs: int list) -> (match xs with Cons (c, t) -> if hit c then dropl t else xs | Nil -> Nil) in
  let rec rev = fn (a: int list) -> fn (b: int list) -> (match a with Nil -> b | Cons (h, t) -> rev t (Cons (h, b))) in
  let a = (if l then dropl cps else cps) in
  let b = (if r then rev (dropl (rev a Nil)) Nil else a) in
  (match encode_cps b "UTF-8" "" with (bytes, _) -> bytes);

let str_tr = fn (s: str) -> fn (from0: str) -> fn (to0: str) ->
  let neg = str_len from0 >= 2 && str_eq (char_at from0 0) "^" in
  let from = str_expand_set (if neg then substring from0 1 (str_len from0) else from0) 0 "" in
  let to = str_expand_set to0 0 "" in
  let tn = str_len to in
  let tcn = utf8_len to in
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let c = utf8_char_at s i in
      let k = char_pos_r from c in
      let hit = if neg then (if k < 0 then true else false) else (if k >= 0 then true else false) in
      let nc = if hit then (if tcn == 0 then ""
                            else if neg then utf8_char to (tcn - 1)
                            else if k >= tcn then utf8_char to (tcn - 1)
                            else utf8_char to k)
               else c in
      go (i + utf8_clen s i) (acc ++ nc) in
  go 0 "";
let str_count_sets = fn (s: str) -> fn (sets: str list) ->
  let rec go = fn (i: int) -> fn (n: int) ->
    if i >= str_len s then n
    else go (i + utf8_clen s i) (if all_sets_has sets (utf8_char_at s i) then n + 1 else n) in
  go 0 0;
let str_delete_sets = fn (s: str) -> fn (sets: str list) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else let c = utf8_char_at s i in
         go (i + utf8_clen s i) (if all_sets_has sets c then acc else acc ++ c) in
  go 0 "";
// collapse runs of the same character (optionally only those in `set`).
let str_squeeze = fn (s: str) -> fn (set0: str) -> fn (use_set: bool) ->
  let rec go = fn (i: int) -> fn (prev: str) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let c = utf8_char_at s i in
      let w = utf8_clen s i in
      if str_eq c prev && (if use_set then str_set_has set0 c else true) then go (i + w) c acc
      else go (i + w) c (acc ++ c) in
  go 0 "" "";
// squeeze against SEVERAL set arguments: ruby intersects them, exactly as
// count and delete do.
let str_squeeze_sets = fn (s: str) -> fn (sets: str list) ->
  let rec go = fn (i: int) -> fn (prev: str) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let c = utf8_char_at s i in
      let w = utf8_clen s i in
      if str_eq c prev && all_sets_has sets c then go (i + w) c acc
      else go (i + w) c (acc ++ c) in
  go 0 "" "";
// tr, but consecutive characters TRANSLATED to the same character collapse
// to one; an untranslated duplicate stays ("hello".tr_s("el","hx") keeps the
// h that was already an h and squeezes only the translated xx).
let str_tr_s = fn (s: str) -> fn (from0: str) -> fn (to0: str) ->
  let neg = str_len from0 >= 2 && str_eq (char_at from0 0) "^" in
  let from = str_expand_set (if neg then substring from0 1 (str_len from0) else from0) 0 "" in
  let to = str_expand_set to0 0 "" in
  let tcn = utf8_len to in
  let rec go = fn (i: int) -> fn (prev: str) -> fn (prev_tr: bool) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let c = utf8_char_at s i in
      let w = utf8_clen s i in
      let k = char_pos_r from c in
      let hit = (if neg then k < 0 else k >= 0) in
      let nc = (if hit then (if tcn == 0 then ""
                             else if neg then utf8_char to (tcn - 1)
                             else if k >= tcn then utf8_char to (tcn - 1)
                             else utf8_char to k)
                else c) in
      if hit && prev_tr && str_eq nc prev then go (i + w) prev true acc
      else go (i + w) nc hit (acc ++ nc) in
  go 0 "" false "";

// ---- String#scrub: replace the byte spans invalid in self's encoding ------
// One BROKEN SEQUENCE is one replacement: the lead byte's advertised length
// capped at the continuation bytes actually present (at least one byte), so
// a truncated character at the end costs one replacement, not one per byte.
let scrub_bad_span = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  let b0 = ord (char_at s i) in
  let want = (if b0 >= 194 && b0 < 224 then 2
              else if b0 >= 224 && b0 < 240 then 3
              else if b0 >= 240 && b0 < 245 then 4 else 1) in
  let rec conts = fn (k: int) -> fn (cnt: int) ->
    if cnt >= want - 1 then cnt
    else if k < n && (let v = ord (char_at s k) in v >= 128 && v < 192) then conts (k + 1) (cnt + 1)
    else cnt in
  1 + conts (i + 1) 0;
// walk s under encoding e, replacing each invalid span with `rep`; answers
// (result, changed). Unicode walks by sequence/unit, US-ASCII by byte;
// everything else is already all-valid (or left alone).
let rb_scrub = fn (s: str) -> fn (e: str) -> fn (rep: str) ->
  let n = str_len s in
  if str_eq e "UTF-8" then
    (let rec go = fn (i: int) -> fn (acc: str) -> fn (ch: bool) ->
       if i >= n then (acc, ch)
       else (match utf8_cp_strict s i with
             | (c, l, ok) ->
               if ok then go (i + l) (acc ++ substring s i (i + l)) ch
               else (let sp = scrub_bad_span s i in go (i + sp) (acc ++ rep) true)) in
     go 0 "" false)
  else if str_eq e "US-ASCII" then
    (let rec go = fn (i: int) -> fn (acc: str) -> fn (ch: bool) ->
       if i >= n then (acc, ch)
       else if ord (char_at s i) < 128 then go (i + 1) (acc ++ char_at s i) ch
       else go (i + 1) (acc ++ rep) true in
     go 0 "" false)
  else if str_eq e "UTF-16LE" || str_eq e "UTF-16BE" then
    (let be = str_eq e "UTF-16BE" in
     let unit = fn (k: int) ->
       (if be then ord (char_at s k) * 256 + ord (char_at s (k + 1))
        else ord (char_at s (k + 1)) * 256 + ord (char_at s k)) in
     let rec go = fn (i: int) -> fn (acc: str) -> fn (ch: bool) ->
       if i >= n then (acc, ch)
       else if i + 1 >= n then (acc ++ rep, true)
       else
         let u = unit i in
         if u >= 55296 && u <= 56319 then
           (if i + 3 < n && (let v = unit (i + 2) in v >= 56320 && v <= 57343)
            then go (i + 4) (acc ++ substring s i (i + 4)) ch
            else go (i + 2) (acc ++ rep) true)
         else if u >= 56320 && u <= 57343 then go (i + 2) (acc ++ rep) true
         else go (i + 2) (acc ++ substring s i (i + 2)) ch in
     go 0 "" false)
  else (s, false);

// decoded codepoints with each INVALID SPAN as one (0-1) marker -- encode's
// :invalid handling replaces per broken sequence, not per broken byte.
let enc_decode_marked = fn (s: str) -> fn (from: str) ->
  let n = str_len s in
  if str_eq from "UTF-8" then
    (let rec go = fn (i: int) ->
       if i >= n then (Nil : int list)
       else (match utf8_cp_strict s i with
             | (c, l, ok) ->
               if ok then Cons (c, go (i + l))
               else Cons (0 - 1, go (i + scrub_bad_span s i))) in
     go 0)
  else if str_eq from "US-ASCII" then
    (let rec go = fn (i: int) ->
       if i >= n then (Nil : int list)
       else (let b = ord (char_at s i) in Cons ((if b < 128 then b else 0 - 1), go (i + 1))) in
     go 0)
  else if str_eq from "UTF-16LE" || str_eq from "UTF-16BE" then
    (let be = str_eq from "UTF-16BE" in
     let unit = fn (k: int) ->
       (if be then ord (char_at s k) * 256 + ord (char_at s (k + 1))
        else ord (char_at s (k + 1)) * 256 + ord (char_at s k)) in
     let rec go = fn (i: int) ->
       if i >= n then (Nil : int list)
       else if i + 1 >= n then Cons (0 - 1, Nil)
       else
         let u = unit i in
         if u >= 55296 && u <= 56319 then
           (if i + 3 < n && (let v = unit (i + 2) in v >= 56320 && v <= 57343)
            then Cons (65536 + (u - 55296) * 1024 + (unit (i + 2) - 56320), go (i + 4))
            else Cons (0 - 1, go (i + 2)))
         else if u >= 56320 && u <= 57343 then Cons (0 - 1, go (i + 2))
         else Cons (u, go (i + 2)) in
     go 0)
  else decode_cps s from 0;

// ---- String#undump: parse the #dump wire format back to the raw string ----
// Answers (bytes, forced-encoding-or-"") or raises ruby's RuntimeErrors.
let rb_undump = fn (s: str) ->
  let n = str_len s in
  let hexv = fn (c: str) ->
    (let o = ord c in
     if o >= 48 && o <= 57 then o - 48
     else if o >= 97 && o <= 102 then o - 87
     else if o >= 65 && o <= 70 then o - 55
     else 0 - 1) in
  if n < 2 || (if str_eq (char_at s 0) "\"" then false else true)
  then (match prim_raise "RuntimeError" "invalid dumped string; not wrapped with '\"' nor '\"...\".force_encoding(\"...\")' form" with _ -> ("", ""))
  else
    let rec go = fn (i: int) -> fn (acc: str) ->
      if i >= n then (match prim_raise "RuntimeError" "unterminated dumped string" with _ -> ("", ""))
      else
        let c = char_at s i in
        if str_eq c "\"" then
          // closed: nothing may follow but a .force_encoding("NAME") tail.
          (let rest = substring s (i + 1) n in
           if str_eq rest "" then (acc, "")
           else if str_len rest > 18 && str_eq (substring rest 0 17) ".force_encoding(\""
                   && str_eq (substring rest (str_len rest - 2) (str_len rest)) "\")" then
             (let nm = substring rest 17 (str_len rest - 2) in
              let canon = enc_find_canon nm in
              if str_eq canon "" then (match prim_raise "RuntimeError" "dumped string has unknown encoding name" with _ -> ("", ""))
              else (acc, canon))
           else (match prim_raise "RuntimeError" "invalid dumped string" with _ -> ("", "")))
        else if ord c == 0 then (match prim_raise "RuntimeError" "string contains null byte" with _ -> ("", ""))
        else if ord c >= 128 then (match prim_raise "RuntimeError" "non-ASCII character detected" with _ -> ("", ""))
        else if str_eq c "\\" then
          (if i + 1 >= n then (match prim_raise "RuntimeError" "unterminated dumped string" with _ -> ("", ""))
           else
             let e2 = char_at s (i + 1) in
             if str_eq e2 "n" then go (i + 2) (acc ++ "\n")
             else if str_eq e2 "t" then go (i + 2) (acc ++ "\t")
             else if str_eq e2 "r" then go (i + 2) (acc ++ chr 13)
             else if str_eq e2 "a" then go (i + 2) (acc ++ chr 7)
             else if str_eq e2 "b" then go (i + 2) (acc ++ chr 8)
             else if str_eq e2 "e" then go (i + 2) (acc ++ chr 27)
             else if str_eq e2 "f" then go (i + 2) (acc ++ chr 12)
             else if str_eq e2 "v" then go (i + 2) (acc ++ chr 11)
             else if str_eq e2 "x" then
               // #dump always writes two hex digits; undump requires both.
               (let h1 = (if i + 2 < n then hexv (char_at s (i + 2)) else 0 - 1) in
                let h2 = (if i + 3 < n then hexv (char_at s (i + 3)) else 0 - 1) in
                if h1 < 0 || h2 < 0 then (match prim_raise "RuntimeError" "invalid hex escape" with _ -> ("", ""))
                else go (i + 4) (acc ++ chr (h1 * 16 + h2)))
             else if str_eq e2 "u" then
               (if i + 2 < n && str_eq (char_at s (i + 2)) "\{" then
                  (let rec hexes = fn (k: int) -> fn (v: int) -> fn (cnt: int) ->
                     (if k < n && str_eq (char_at s k) "}" then (v, k + 1, cnt)
                      else
                        let hv = (if k < n then hexv (char_at s k) else 0 - 1) in
                        if hv < 0 then (0 - 1, k, cnt) else hexes (k + 1) (v * 16 + hv) (cnt + 1)) in
                   match hexes (i + 3) 0 0 with
                   | (v, k2, cnt) ->
                     if v < 0 || cnt == 0 then (match prim_raise "RuntimeError" "invalid Unicode escape" with _ -> ("", ""))
                     else go k2 (acc ++ utf8_enc v))
                else
                  (let d1 = (if i + 2 < n then hexv (char_at s (i + 2)) else 0 - 1) in
                   let d2 = (if i + 3 < n then hexv (char_at s (i + 3)) else 0 - 1) in
                   let d3 = (if i + 4 < n then hexv (char_at s (i + 4)) else 0 - 1) in
                   let d4 = (if i + 5 < n then hexv (char_at s (i + 5)) else 0 - 1) in
                   if d1 < 0 || d2 < 0 || d3 < 0 || d4 < 0
                   then (match prim_raise "RuntimeError" "invalid Unicode escape" with _ -> ("", ""))
                   else go (i + 6) (acc ++ utf8_enc (((d1 * 16 + d2) * 16 + d3) * 16 + d4))))
             else go (i + 2) (acc ++ e2))
        else go (i + 1) (acc ++ c) in
    go 1 "";

// ---- String#to_c / #to_r: ruby's own permissive number grammars -----------
// digits with SINGLE underscores between them ("1_2" is 12; a double
// underscore ENDS the number: "1__2" reads as 1).
let rec toc_digits = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i < str_len s && is_digit (char_at s i) then toc_digits s (i + 1) (acc ++ char_at s i)
  else if i + 1 < str_len s && str_eq (char_at s i) "_" && is_digit (char_at s (i + 1))
  then toc_digits s (i + 2) (acc ++ char_at s (i + 1))
  else (acc, i);
// one unsigned number: (intpart, fracpart, exppart, den-from-slash, nexti).
// Empty intpart means "no number here". The '/' denominator only counts when
// digits follow it; the exponent only when [sign]digits follow the e.
let toc_number = fn (s: str) -> fn (i0: int) ->
  (match toc_digits s i0 "" with
   | (ip, i1) ->
     if str_eq ip "" then ("", "", "", "", i0)
     else
       let (fp, i2) = (if i1 + 1 < str_len s && str_eq (char_at s i1) "." && is_digit (char_at s (i1 + 1))
                       then toc_digits s (i1 + 1) "" else ("", i1)) in
       let (ep, i3) = (if i2 < str_len s && (str_eq (char_at s i2) "e" || str_eq (char_at s i2) "E")
                       then (let sg = (if i2 + 1 < str_len s && (str_eq (char_at s (i2 + 1)) "-" || str_eq (char_at s (i2 + 1)) "+")
                                       then char_at s (i2 + 1) else "") in
                             let ds = (if str_eq sg "" then i2 + 1 else i2 + 2) in
                             match toc_digits s ds "" with
                             | (ed, i9) -> (if str_eq ed "" then ("", i2) else ((if str_eq sg "-" then "-" else "") ++ ed, i9)))
                       else ("", i2)) in
       let (dn, i4) = (if i3 + 1 < str_len s && str_eq (char_at s i3) "/" && is_digit (char_at s (i3 + 1))
                       then toc_digits s (i3 + 1) "" else ("", i3)) in
       (ip, fp, ep, dn, i4));
// the parsed parts as a VALUE: a '/' makes a Rational (a decimal numerator
// folds into it), a '.' or exponent makes a Float, else an Integer.
let toc_value = fn (neg: bool) -> fn (ip: str) -> fn (fp: str) -> fn (ep: str) -> fn (dn: str) ->
  let sgn = (if neg then "-" else "") in
  if str_eq dn "" then
    (if str_eq fp "" && str_eq ep "" then
       (match norm_big (sgn ++ ip) with v -> v)
     else VFlt (float_of_str (sgn ++ ip ++ "." ++ (if str_eq fp "" then "0" else fp) ++ (if str_eq ep "" then "" else "e" ++ ep))))
  else
    (let num = sgn ++ ip ++ fp in
     let den = big_mul_s dn (big_pow "10" (str_len fp) "1") in
     mk_rat_s num den);
let toc_unit = fn (c: str) -> str_eq c "i" || str_eq c "I" || str_eq c "j" || str_eq c "J";
// String#to_c: [ws] [sign] (unit | number [unit | @polar | ±imag]) with
// anything unrecognised ignored (a string with no leading number is (0+0i)).
// The second half of the pair is the index just past what was READ, or -1 when
// nothing was: String#to_c shrugs at the rest, Kernel#Complex refuses it, and
// the two must not read the string with two different parsers.
let rb_str_to_c_x = fn (s: str) ->
  let n = str_len s in
  let rec ws = fn (i: int) -> if i < n && is_ws_ch (char_at s i) then ws (i + 1) else i in
  let i0 = ws 0 in
  let (neg1, i1) = (if i0 < n && str_eq (char_at s i0) "-" then (true, i0 + 1)
                    else if i0 < n && str_eq (char_at s i0) "+" then (false, i0 + 1)
                    else (false, i0)) in
  if i1 < n && toc_unit (char_at s i1) then (VCpx (VInt 0, VInt (if neg1 then 0 - 1 else 1)), i1 + 1)
  else
  match toc_number s i1 with
  | (ip, fp, ep, dn, j) ->
    if str_eq ip "" then (VCpx (VInt 0, VInt 0), 0 - 1)
    else
      let firstv = toc_value neg1 ip fp ep dn in
      if j < n && toc_unit (char_at s j) then (VCpx (VInt 0, firstv), j + 1)
      else if j < n && str_eq (char_at s j) "@" then
        // polar: modulus @ [sign] argument, both floats.
        (let (ng2, k0) = (if j + 1 < n && str_eq (char_at s (j + 1)) "-" then (true, j + 2)
                          else if j + 1 < n && str_eq (char_at s (j + 1)) "+" then (false, j + 2)
                          else (false, j + 1)) in
         match toc_number s k0 with
         | (ip2, fp2, ep2, dn2, k1) ->
           if str_eq ip2 "" then (VCpx (firstv, VInt 0), j)
           else
             let th = toc_value ng2 ip2 fp2 ep2 dn2 in
             (VCpx (VFlt (to_f firstv * cos (to_f th)), VFlt (to_f firstv * sin (to_f th))), k1))
      else if j < n && (str_eq (char_at s j) "+" || str_eq (char_at s j) "-") then
        (let ng2 = str_eq (char_at s j) "-" in
         let k0 = j + 1 in
         if k0 < n && toc_unit (char_at s k0) then (VCpx (firstv, VInt (if ng2 then 0 - 1 else 1)), k0 + 1)
         else
           match toc_number s k0 with
           | (ip2, fp2, ep2, dn2, k1) ->
             // the imaginary part only counts WITH its unit right after it.
             if (if str_eq ip2 "" then false else true) && k1 < n && toc_unit (char_at s k1)
             then (VCpx (firstv, toc_value ng2 ip2 fp2 ep2 dn2), k1 + 1)
             else (VCpx (firstv, VInt 0), j))
      else (VCpx (firstv, VInt 0), j);
let rb_str_to_c = fn (s: str) -> (match rb_str_to_c_x s with (v, _) -> v);
// ...and whether the whole string was that complex number.
let rb_str_to_c_ok = fn (s: str) ->
  let n = str_len s in
  let rec ws = fn (i: int) -> if i < n && is_ws_ch (char_at s i) then ws (i + 1) else i in
  match rb_str_to_c_x s with
  | (v, e) -> (v, e >= 0 && ws e == n);
// the parsed parts as an exact Rational. The EXPONENT counts: "-9.2e2".to_r
// is (-920/1), and dropping ep made it (-46/5).
let rat_of_parts = fn (neg: bool) -> fn (ip: str) -> fn (fp: str) -> fn (ep: str) -> fn (dn: str) ->
  let num0 = (if neg then "-" else "") ++ ip ++ fp in
  let den0 = big_pow "10" (str_len fp) "1" in
  let den1 = (if str_eq dn "" then den0 else big_mul_s den0 dn) in
  let eneg = str_len ep > 0 && str_eq (char_at ep 0) "-" in
  let emag = (if str_len ep == 0 then 0 else int_of_str (big_mag ep)) in
  if emag == 0 then mk_rat_s num0 den1
  else if eneg then mk_rat_s num0 (big_mul_s den1 (big_pow "10" emag "1"))
  else mk_rat_s (big_mul_s num0 (big_pow "10" emag "1")) den1;
// String#to_r: [ws] [sign] digits [. digits] [e exp] [/ digits], (0/1)
// otherwise -- and, as the second half of the pair, whether the WHOLE string
// was that number. String#to_r reads a prefix and shrugs; Kernel#Rational
// refuses what it could not read to the end, and the two must not answer from
// two different readers.
let rb_str_to_r_x = fn (s: str) ->
  let n = str_len s in
  let rec ws = fn (i: int) -> if i < n && is_ws_ch (char_at s i) then ws (i + 1) else i in
  let i0 = ws 0 in
  let (neg1, i1) = (if i0 < n && str_eq (char_at s i0) "-" then (true, i0 + 1)
                    else if i0 < n && str_eq (char_at s i0) "+" then (false, i0 + 1)
                    else (false, i0)) in
  // ".52" has no integer digits, and toc_number needs one to start; ruby reads
  // it as 0.52, so the missing "0" is supplied rather than refused.
  let (zp, i2) = (if i1 + 1 < n && str_eq (char_at s i1) "." && is_digit (char_at s (i1 + 1))
                  then ("0", i1) else ("", i1)) in
  let src = (if str_eq zp "" then s else substring s 0 i2 ++ "0" ++ substring s i2 (str_len s)) in
  let n = str_len src in
  let i1 = i2 in
  match toc_number src i1 with
  | (ip, fp, ep, dn, j) ->
    if str_eq ip "" then (mk_rat_s "0" "1", false)
    else (rat_of_parts neg1 ip fp ep dn, ws j == n);
let rb_str_to_r = fn (s: str) -> (match rb_str_to_r_x s with (v, _) -> v);

// ---- String#crypt: the classic crypt(3), DES with a salt-perturbed E-box --
// A real implementation, not a stub: the tables are FIPS 46's, the salt
// swaps E-expansion entries i and i+24 per set bit of the 12-bit salt, and
// the zero block is encrypted 25 times. Bit lists (MSB first) throughout --
// performance is irrelevant at 25 rounds per call.
let des_parse = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) -> fn (cur: int) -> fn (has: bool) ->
    if i >= n then (if has then Cons (cur, Nil) else (Nil : int list))
    else
      let c = char_at s i in
      if str_eq c " " then (if has then Cons (cur, go (i + 1) 0 false) else go (i + 1) 0 false)
      else go (i + 1) (cur * 10 + (ord c - 48)) true in
  go 0 0 false;
let des_ip = des_parse "58 50 42 34 26 18 10 2 60 52 44 36 28 20 12 4 62 54 46 38 30 22 14 6 64 56 48 40 32 24 16 8 57 49 41 33 25 17 9 1 59 51 43 35 27 19 11 3 61 53 45 37 29 21 13 5 63 55 47 39 31 23 15 7";
let des_fp = des_parse "40 8 48 16 56 24 64 32 39 7 47 15 55 23 63 31 38 6 46 14 54 22 62 30 37 5 45 13 53 21 61 29 36 4 44 12 52 20 60 28 35 3 43 11 51 19 59 27 34 2 42 10 50 18 58 26 33 1 41 9 49 17 57 25";
let des_e = des_parse "32 1 2 3 4 5 4 5 6 7 8 9 8 9 10 11 12 13 12 13 14 15 16 17 16 17 18 19 20 21 20 21 22 23 24 25 24 25 26 27 28 29 28 29 30 31 32 1";
let des_p = des_parse "16 7 20 21 29 12 28 17 1 15 23 26 5 18 31 10 2 8 24 14 32 27 3 9 19 13 30 6 22 11 4 25";
let des_pc1 = des_parse "57 49 41 33 25 17 9 1 58 50 42 34 26 18 10 2 59 51 43 35 27 19 11 3 60 52 44 36 63 55 47 39 31 23 15 7 62 54 46 38 30 22 14 6 61 53 45 37 29 21 13 5 28 20 12 4";
let des_pc2 = des_parse "14 17 11 24 1 5 3 28 15 6 21 10 23 19 12 4 26 8 16 7 27 20 13 2 41 52 31 37 47 55 30 40 51 45 33 48 44 49 39 56 34 53 46 42 50 36 29 32";
let des_shifts = des_parse "1 1 2 2 2 2 2 2 1 2 2 2 2 2 2 1";
let des_s1 = des_parse "14 4 13 1 2 15 11 8 3 10 6 12 5 9 0 7 0 15 7 4 14 2 13 1 10 6 12 11 9 5 3 8 4 1 14 8 13 6 2 11 15 12 9 7 3 10 5 0 15 12 8 2 4 9 1 7 5 11 3 14 10 0 6 13";
let des_s2 = des_parse "15 1 8 14 6 11 3 4 9 7 2 13 12 0 5 10 3 13 4 7 15 2 8 14 12 0 1 10 6 9 11 5 0 14 7 11 10 4 13 1 5 8 12 6 9 3 2 15 13 8 10 1 3 15 4 2 11 6 7 12 0 5 14 9";
let des_s3 = des_parse "10 0 9 14 6 3 15 5 1 13 12 7 11 4 2 8 13 7 0 9 3 4 6 10 2 8 5 14 12 11 15 1 13 6 4 9 8 15 3 0 11 1 2 12 5 10 14 7 1 10 13 0 6 9 8 7 4 15 14 3 11 5 2 12";
let des_s4 = des_parse "7 13 14 3 0 6 9 10 1 2 8 5 11 12 4 15 13 8 11 5 6 15 0 3 4 7 2 12 1 10 14 9 10 6 9 0 12 11 7 13 15 1 3 14 5 2 8 4 3 15 0 6 10 1 13 8 9 4 5 11 12 7 2 14";
let des_s5 = des_parse "2 12 4 1 7 10 11 6 8 5 3 15 13 0 14 9 14 11 2 12 4 7 13 1 5 0 15 10 3 9 8 6 4 2 1 11 10 13 7 8 15 9 12 5 6 3 0 14 11 8 12 7 1 14 2 13 6 15 0 9 10 4 5 3";
let des_s6 = des_parse "12 1 10 15 9 2 6 8 0 13 3 4 14 7 5 11 10 15 4 2 7 12 9 5 6 1 13 14 0 11 3 8 9 14 15 5 2 8 12 3 7 0 4 10 1 13 11 6 4 3 2 12 9 5 15 10 11 14 1 7 6 0 8 13";
let des_s7 = des_parse "4 11 2 14 15 0 8 13 3 12 9 7 5 10 6 1 13 0 11 7 4 9 1 10 14 3 5 12 2 15 8 6 1 4 11 13 12 3 7 14 10 15 6 8 0 5 9 2 6 11 13 8 1 4 10 7 9 5 0 15 14 2 3 12";
let des_s8 = des_parse "13 2 8 4 6 15 11 1 10 9 3 14 5 0 12 7 1 15 13 8 10 3 7 4 12 5 6 11 0 14 9 2 7 11 4 1 9 12 14 2 0 6 10 13 15 3 5 8 2 1 14 7 4 10 8 13 15 12 9 0 3 5 6 11";
let rec des_nth = fn (xs: int list) -> fn (i: int) ->
  match xs with Nil -> 0 | Cons (h, t) -> if i <= 0 then h else des_nth t (i - 1);
// permute: entry k of the result is source bit tab[k]-1 (FIPS is 1-indexed).
let rec des_perm = fn (src: int list) -> fn (tab: int list) ->
  match tab with Nil -> (Nil : int list) | Cons (t, r) -> Cons (des_nth src (t - 1), des_perm src r);
let rec des_xor = fn (a: int list) -> fn (b: int list) ->
  match a with
  | Nil -> (Nil : int list)
  | Cons (x, xs) -> (match b with Nil -> Nil | Cons (y, ys) -> Cons ((if x == y then 0 else 1), des_xor xs ys));
let rec des_take = fn (xs: int list) -> fn (k: int) ->
  if k <= 0 then (Nil : int list) else (match xs with Nil -> Nil | Cons (h, t) -> Cons (h, des_take t (k - 1)));
let rec des_drop = fn (xs: int list) -> fn (k: int) ->
  if k <= 0 then xs else (match xs with Nil -> Nil | Cons (_, t) -> des_drop t (k - 1));
let rec des_app = fn (a: int list) -> fn (b: int list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, des_app t b);
let des_rotl = fn (xs: int list) -> fn (k: int) -> des_app (des_drop xs k) (des_take xs k);
// the 16 round subkeys from the 64-bit key.
let des_ks = fn (key: int list) ->
  let cd0 = des_perm key des_pc1 in
  let rec go = fn (c: int list) -> fn (d: int list) -> fn (sh: int list) ->
    (match sh with
     | Nil -> (Nil : int list list)
     | Cons (k, rest) ->
       let c2 = des_rotl c k in
       let d2 = des_rotl d k in
       Cons (des_perm (des_app c2 d2) des_pc2, go c2 d2 rest)) in
  go (des_take cd0 28) (des_drop cd0 28) des_shifts;
let des_sbox_apply = fn (x: int list) ->
  let boxes = Cons (des_s1, Cons (des_s2, Cons (des_s3, Cons (des_s4, Cons (des_s5, Cons (des_s6, Cons (des_s7, Cons (des_s8, Nil)))))))) in
  let rec go = fn (bits: int list) -> fn (bs: int list list) ->
    (match bs with
     | Nil -> (Nil : int list)
     | Cons (box, brest) ->
       let b0 = des_nth bits 0 in let b1 = des_nth bits 1 in let b2 = des_nth bits 2 in
       let b3 = des_nth bits 3 in let b4 = des_nth bits 4 in let b5 = des_nth bits 5 in
       let row = b0 * 2 + b5 in
       let col = b1 * 8 + b2 * 4 + b3 * 2 + b4 in
       let v = des_nth box (row * 16 + col) in
       let four = Cons (floor_mod (floor_div v 8) 2, Cons (floor_mod (floor_div v 4) 2, Cons (floor_mod (floor_div v 2) 2, Cons (floor_mod v 2, Nil)))) in
       des_app four (go (des_drop bits 6) brest)) in
  go x boxes;
// one whole encryption (IP, 16 rounds, swap, FP) with the SALTED E table.
let des_encrypt = fn (block: int list) -> fn (ks: int list list) -> fn (etab: int list) ->
  let b = des_perm block des_ip in
  let rec rounds = fn (l: int list) -> fn (r: int list) -> fn (keys: int list list) ->
    (match keys with
     | Nil -> des_app r l
     | Cons (k, krest) ->
       let f = des_perm (des_sbox_apply (des_xor (des_perm r etab) k)) des_p in
       rounds r (des_xor l f) krest) in
  des_perm (rounds (des_take b 32) (des_drop b 32) ks) des_fp;
// the ./0-9A-Za-z alphabet crypt shares with its salt.
let crypt_a64v = fn (c: str) ->
  let o = ord c in
  if o == 46 then 0 else if o == 47 then 1
  else if o >= 48 && o <= 57 then o - 46
  else if o >= 65 && o <= 90 then o - 53
  else if o >= 97 && o <= 122 then o - 59
  else 0;
let crypt_a64c = fn (v: int) ->
  if v < 2 then chr (46 + v)
  else if v < 12 then chr (46 + v + 0)
  else if v < 38 then chr (65 + v - 12)
  else chr (97 + v - 38);
let rec des_pow2i = fn (k: int) -> if k <= 0 then 1 else 2 * des_pow2i (k - 1);
let rb_crypt_des = fn (pw: str) -> fn (salt: str) ->
  // key: the low 7 bits of the first 8 password bytes, MSB first.
  let rec keybits = fn (i: int) ->
    if i >= 8 then (Nil : int list)
    else
      let b = (if i < str_len pw then ord (char_at pw i) else 0) in
      let tailb = Cons (floor_mod (floor_div b 2) 2, Cons (floor_mod b 2, Cons (0, Nil))) in
      let midb = Cons (floor_mod (floor_div b 8) 2, Cons (floor_mod (floor_div b 4) 2, tailb)) in
      let eight = Cons (floor_mod (floor_div b 64) 2, Cons (floor_mod (floor_div b 32) 2, Cons (floor_mod (floor_div b 16) 2, midb))) in
      des_app eight (keybits (i + 1)) in
  let ks = des_ks (keybits 0) in
  // the 12-bit salt swaps E entries i and i+24 per set bit.
  let sv = crypt_a64v (char_at salt 0) + crypt_a64v (char_at salt 1) * 64 in
  let etab =
    (let rec build = fn (i: int) ->
       if i >= 48 then (Nil : int list)
       else
         let j = (if i < 12 && floor_mod (floor_div sv (des_pow2i i)) 2 == 1 then i + 24
                  else if i >= 24 && i < 36 && floor_mod (floor_div sv (des_pow2i (i - 24))) 2 == 1 then i - 24
                  else i) in
         Cons (des_nth des_e j, build (i + 1)) in
     build 0) in
  let rec iterate = fn (b: int list) -> fn (k: int) ->
    if k <= 0 then b else iterate (des_encrypt b ks etab) (k - 1) in
  let rec zeros = fn (k: int) -> if k <= 0 then (Nil : int list) else Cons (0, zeros (k - 1)) in
  let out = des_app (iterate (zeros 64) 25) (Cons (0, Cons (0, Nil))) in
  let rec enc11 = fn (bits: int list) -> fn (k: int) ->
    if k >= 11 then ""
    else
      let v = des_nth bits 0 * 32 + des_nth bits 1 * 16 + des_nth bits 2 * 8
              + des_nth bits 3 * 4 + des_nth bits 4 * 2 + des_nth bits 5 in
      crypt_a64c v ++ enc11 (des_drop bits 6) (k + 1) in
  substring salt 0 2 ++ enc11 out 0;

// ---- padding (ljust / rjust / center) ------------------------------------
// Ruby's widths are in characters: `"日本語abcあ".ljust(9, ".")` pads a
// seven-character string to nine. Measured in bytes it was already 12 wide and
// nothing was added at all.
let rec str_pad_to = fn (pad: str) -> fn (k: int) ->
  let pn = utf8_len pad in
  if k <= 0 || pn == 0 then ""
  else if k >= pn then pad ++ str_pad_to pad (k - pn)
  else utf8_substr pad 0 k;
let str_ljust = fn (s: str) -> fn (w: int) -> fn (pad: str) ->
  let n = utf8_len s in if n >= w || str_len pad == 0 then s else s ++ str_pad_to pad (w - n);
let str_rjust = fn (s: str) -> fn (w: int) -> fn (pad: str) ->
  let n = utf8_len s in if n >= w || str_len pad == 0 then s else str_pad_to pad (w - n) ++ s;
let str_center = fn (s: str) -> fn (w: int) -> fn (pad: str) ->
  let n = utf8_len s in
  if n >= w || str_len pad == 0 then s
  else let total = w - n in let left = total / 2 in
    str_pad_to pad left ++ s ++ str_pad_to pad (total - left);

// collect the string values from an argument list (for multi-set count/delete).
let rec collect_str_args = fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (VStr h, t) -> Cons (sget h, collect_str_args t)
  | Cons (_, t) -> collect_str_args t;

// last index of sub in s, or -1.
let rec str_rindex_go = fn (s: str) -> fn (sub: str) -> fn (i: int) ->
  if i < 0 then 0 - 1
  else if str_eq (substring s i (i + str_len sub)) sub then i
  else str_rindex_go s sub (i - 1);

// the source file's magic comment ("# -*- encoding: us-ascii -*-",
// "# coding: utf-8"): the upcased encoding name, or "" if none. Scans the
// first line (the second when the first is a shebang) for "coding".
let rec coding_name_at = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else
    let c = char_at s i in
    if (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || str_eq c "-" || str_eq c "_"
    then char_at s i ++ coding_name_at s (i + 1)
    else "";
let rec scan_coding_line = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else if str_eq (char_at s i) "\n" then ""
  else if i + 6 <= str_len s && str_eq (substring s i (i + 6)) "coding" then
    // skip "coding", optional spaces, ":" or "=", spaces, then the name.
    let rec skip = fn (j: int) ->
      if j >= str_len s then j
      else if str_eq (char_at s j) " " || str_eq (char_at s j) ":" || str_eq (char_at s j) "=" then skip (j + 1)
      else j in
    coding_name_at s (skip (i + 6))
  else scan_coding_line s (i + 1);
let rec line_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i else if str_eq (char_at s i) "\n" then i else line_end s (i + 1);
// `# frozen_string_literal: true|false` in the leading comment lines. THREE
// answers, not two: "on", "off", and ABSENT -- and from ruby 3.4 absent is not
// the same as off. A literal in a file that says nothing is CHILLED: not
// frozen, but `+str` hands back a copy rather than the literal itself, which
// is how 3.4 lets a program take a mutable string without the file having to
// declare anything. Scans the first few comment/blank lines and stops at the
// first line of code, as ruby does.
let src_fsl = fn (src: str) ->
  let n = str_len src in
  let rec scan = fn (i: int) -> fn (seen: int) ->
    if i >= n || seen > 4 then ""
    else
      let e = line_end src i in
      let ln = substring src i e in
      if str_len ln > 0 && str_eq (substring ln 0 1) "#" then
        (let k = str_index_of ln "frozen_string_literal" in
         if k < 0 then scan (e + 1) (seen + 1)
         else
           let rest = substring ln (k + 21) (str_len ln) in
           if str_index_of rest "true" >= 0 then "on"
           else if str_index_of rest "false" >= 0 then "off"
           else scan (e + 1) (seen + 1))
      else if str_len ln == 0 then scan (e + 1) (seen + 1)
      else "" in
  scan 0 0;

let src_coding = fn (src: str) ->
  let start = (if str_len src >= 2 && str_eq (substring src 0 2) "#!" then line_end src 0 + 1 else 0) in
  if start < str_len src && str_eq (char_at src start) "#" then str_upcase (scan_coding_line src start)
  else "";

// index into a Val list (nil beyond the end); supports Ruby negative
// indices (-1 = last).
let rec val_nth = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> if i == 0 then h else val_nth t (i - 1);
// Array#shuffle: pull a random element out at a time. O(n^2) on a list, but
// the arrays this runs on are small and it keeps the shuffle uniform.
// (vtake / vdrop live further down, so the removal is spelled out here.)
let rec val_without_nth = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if i == 0 then t else Cons (h, val_without_nth t (i - 1));
let rec val_shuffle = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then (Nil : Val list)
  else
    let i = mt_rand_int 0 n in
    Cons (val_nth xs i, val_shuffle (val_without_nth xs i) (n - 1));

let rec val_len_i = fn (xs: Val list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + val_len_i t;
// Array set-op / assoc helpers (world-free; used by prim_method).
let rec arr_union_args = fn (args: Val list) -> fn (acc: Val list) ->
  match args with Nil -> acc | Cons (VArr o, rest) -> arr_union_args rest (list_append acc (deref o)) | Cons (_, rest) -> arr_union_args rest acc;
let rec val_subtract = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> if val_member ys h then val_subtract t ys else Cons (h, val_subtract t ys);
let rec arr_intersect_args = fn (args: Val list) -> fn (acc: Val list) ->
  match args with Nil -> acc | Cons (VArr o, rest) -> arr_intersect_args rest (val_intersect acc (deref o)) | Cons (_, rest) -> arr_intersect_args rest acc;
let rec arr_difference_args = fn (args: Val list) -> fn (acc: Val list) ->
  match args with Nil -> acc | Cons (VArr o, rest) -> arr_difference_args rest (val_subtract acc (deref o)) | Cons (_, rest) -> arr_difference_args rest acc;
let rec val_any_in = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with Nil -> false | Cons (h, t) -> if val_member ys h then true else val_any_in t ys;
let rec arr_assoc = fn (xs: Val list) -> fn (k: Val) -> fn (pos: int) ->
  match xs with
  | Nil -> VNil
  | Cons (VArr eid, t) -> if rb_eq (val_nth (deref eid) pos) k then VArr eid else arr_assoc t k pos
  | Cons (_, t) -> arr_assoc t k pos;
let rec int_range_list = fn (i: int) -> fn (n: int) ->
  if i >= n then (Nil : Val list) else Cons (VInt i, int_range_list (i + 1) n);
let rec val_rindex = fn (xs: Val list) -> fn (v: Val) -> fn (i: int) -> fn (best: int) ->
  match xs with Nil -> best | Cons (h, t) -> val_rindex t v (i + 1) (if rb_eq h v then i else best);

// String#succ: increment the rightmost alnum with carry (z->a, 9->0, ...),
// prepending a digit/letter when the carry runs off the left end.
let set_char = fn (s: str) -> fn (i: int) -> fn (c: str) ->
  substring s 0 i ++ c ++ substring s (i + 1) (str_len s);
// succ's alphanumerics are ASCII ONLY: is_alnum is the LEXER's question
// (every byte >= 0x80 is an identifier byte there), and borrowing it here
// made "\xFF" an alphanumeric whose successor was chr 256.
let is_alnum_ascii = fn (c: str) ->
  let o = ord c in (o >= 48 && o <= 57) || (o >= 97 && o <= 122) || (o >= 65 && o <= 90);
// `lastp` is the position of the leftmost alphanumeric the carry wrapped: a
// carry with no alphanumeric further left INSERTS its new digit/letter THERE
// ("/[]9999".succ is "/[]10000", not "1/[]0000" -- the carry skips over
// non-alphanumerics but lands next to the run it grew out of).
let rec succ_at = fn (s: str) -> fn (i: int) -> fn (lastp: int) ->
  if i < 0 then
    (if lastp < 0 then s
     else
       let f = char_at s lastp in
       let ins = (if is_digit f then "1" else if f >= "a" && f <= "z" then "a" else "A") in
       substring s 0 lastp ++ ins ++ substring s lastp (str_len s))
  else
    let c = char_at s i in
    if str_eq c "z" then succ_at (set_char s i "a") (i - 1) i
    else if str_eq c "Z" then succ_at (set_char s i "A") (i - 1) i
    else if str_eq c "9" then succ_at (set_char s i "0") (i - 1) i
    else if is_alnum_ascii c then set_char s i (chr (ord c + 1))
    else succ_at s (i - 1) lastp;
// succ_at only advances alphanumerics — Ruby's rule when the string HAS one.
// With none, Ruby increments the rightmost byte instead (with carry), so
// "*+".succ is "*," and "\xff".succ is "\x01\x00".
let rec succ_byte_at = fn (s: str) -> fn (i: int) ->
  if i < 0 then chr 1 ++ s
  else
    let o = ord (char_at s i) in
    if o == 255 then succ_byte_at (set_char s i (chr 0)) (i - 1)
    else set_char s i (chr (o + 1));
let rec has_alnum_go = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then false
  else if is_alnum_ascii (char_at s i) then true else has_alnum_go s (i + 1);
let str_succ = fn (s: str) ->
  if str_len s == 0 then ""
  else if has_alnum_go s 0 then succ_at s (str_len s - 1) (0 - 1)
  else succ_byte_at s (str_len s - 1);
// String#upto between two one-character ASCII strings walks BYTE values
// ("9".upto("A") passes through ":" .. "@"), where the general walk is
// succ-based and would jump from "9" to "10".
let rec rb_upto_bytes = fn (a: int) -> fn (b: int) -> fn (excl: bool) ->
  if a > b then (Nil : Val list)
  else if excl && a == b then (Nil : Val list)
  else Cons (mkstr (chr a), rb_upto_bytes (a + 1) b excl);

// gather elements at each given index (Array#values_at); negative = from end.
let rec arr_values_at = fn (xs: Val list) -> fn (idxs: Val list) ->
  match idxs with
  | Nil -> Nil
  // an index past the end contributes nil (that IS the answer), so this walks
  // every subscript rather than dropping the ones that miss.
  | Cons (VInt i, t) -> Cons (val_nth xs (if i < 0 then val_len_i xs + i else i), arr_values_at xs t)
  // a RANGE subscript contributes its whole span (`[1,2,3].values_at(0..1)`
  // is [1, 2]), and an out-of-range tail contributes nils, exactly as an
  // integer subscript past the end does.
  | Cons (VRange (lov, hiv, ex), t) ->
    // the bounds rule is rng_slice_bounds', written out here because that
    // function is defined thousands of lines further down -- but with ruby's
    // `err=1` variant: the END is NOT clamped to the length, so a range that
    // runs past the end contributes its whole width as nils
    // (`[].values_at(1..3)` is [nil, nil, nil], not []). Only a negative
    // begin that stays negative after wrapping is out of range.
    (let n = val_len_i xs in
     let st0 = (match lov with VInt a -> a | _ -> 0) in
     let st = (if st0 < 0 then n + st0 else st0) in
     let en = (match hiv with
               | VInt b -> (let b2 = (if b < 0 then n + b else b) in if ex then b2 else b2 + 1)
               | _ -> n) in
     let side = fn (v: Val) -> (match v with VInt a -> str_of_int a | _ -> "") in
     if st < 0 then
       prim_raise "RangeError"
         (side lov ++ (if ex then "..." else "..") ++ side hiv ++ " out of range")
     else
       (let rec span = fn (k: int) ->
          if k >= en then arr_values_at xs t
          else Cons (val_nth xs k, span (k + 1)) in
        span st))
  | Cons (_, t) -> arr_values_at xs t;

let rec val_list_of_strs = fn (ss: str list) ->
  match ss with Nil -> Nil | Cons (h, t) -> Cons (mkstr h, val_list_of_strs t);
// Stamp a freshly built list of Strings with an encoding. #lines / #each_line
// cut their pieces out of the receiver, so each piece wears the RECEIVER's
// encoding -- val_list_of_strs alone left them all UTF-8.
let rec val_strs_tag = fn (xs: Val list) -> fn (e: str) ->
  match xs with
  | Nil -> Nil
  | Cons (VStr h2, t) -> (let _ = senc_set h2 e in Cons (VStr h2, val_strs_tag t e))
  | Cons (h2, t) -> Cons (h2, val_strs_tag t e);
// `lines(chomp: true)`: the same lines with their terminator taken off.
let rec val_map_chomp = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VStr h, t) -> Cons (mkstr (str_chomp (sget h)), val_map_chomp t)
  | Cons (h, t) -> Cons (h, val_map_chomp t);

// split a string into lines, KEEPING the trailing "\n" on each (Ruby's
// String#lines). "a\nb\n" -> ["a\n"; "b\n"], "a" -> ["a"], "" -> [].
let rec str_lines_go = fn (s: str) -> fn (start: int) -> fn (i: int) -> fn (n: int) ->
  if i >= n then (if start < n then Cons (substring s start n, Nil) else Nil)
  else if str_eq (char_at s i) "\n" then
    Cons (substring s start (i + 1), str_lines_go s (i + 1) (i + 1) n)
  else str_lines_go s start (i + 1) n;

// String#split(sep, limit): split fully then, when limited, rejoin the tail
// so at most `limit` parts result and the last keeps the remainder.
let rec strlist_len = fn (xs: str list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + strlist_len t;
let rec strlist_take = fn (xs: str list) -> fn (n: int) ->
  if n <= 0 then Nil else (match xs with Nil -> Nil | Cons (h, t) -> Cons (h, strlist_take t (n - 1)));
let rec strlist_drop = fn (xs: str list) -> fn (n: int) ->
  if n <= 0 then xs else (match xs with Nil -> Nil | Cons (_, t) -> strlist_drop t (n - 1));
let rec strlist_append = fn (xs: str list) -> fn (ys: str list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, strlist_append t ys);
let split_with_limit = fn (s: str) -> fn (sep: str) -> fn (lim: int) ->
  let parts = str_split s sep in
  if lim <= 0 then parts
  else if strlist_len parts <= lim then parts
  else strlist_append (strlist_take parts (lim - 1))
         (Cons (str_join sep (strlist_drop parts (lim - 1)), Nil));
// with no limit (or limit 0) ruby DROPS trailing empty fields; only a
// negative limit keeps them ("1,2,,".split(",") is ["1", "2"]).
let strlist_trim_empty = fn (xs: str list) ->
  let rec rev2 = fn (a: str list) -> fn (b: str list) ->
    (match a with Nil -> b | Cons (h, t) -> rev2 t (Cons (h, b))) in
  let rec lead = fn (a: str list) ->
    (match a with Cons (h, t) -> (if str_eq h "" then lead t else a) | Nil -> (Nil : str list)) in
  rev2 (lead (rev2 xs Nil)) Nil;

// last element / all-but-last / set element i (M10 array mutation).
let rec val_last = fn (xs: Val list) ->
  match xs with Nil -> VNil | Cons (h, t) -> (match t with Nil -> h | _ -> val_last t);
let rec val_init = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> (match t with Nil -> Nil | _ -> Cons (h, val_init t));
// past-the-end writes extend with nils (Ruby's a[5] = x on a short array).
let rec val_set_at = fn (xs: Val list) -> fn (i: int) -> fn (v: Val) ->
  match xs with
  | Nil -> if i <= 0 then Cons (v, Nil) else Cons (VNil, val_set_at Nil (i - 1) v)
  | Cons (h, t) -> if i == 0 then Cons (v, t) else Cons (h, val_set_at t (i - 1) v);

let rec val_contains = fn (xs: Val list) -> fn (v: Val) ->
  match xs with Nil -> false | Cons (h, t) -> if rb_eq h v then true else val_contains t v;

let rec val_index_of = fn (xs: Val list) -> fn (v: Val) -> fn (i: int) ->
  match xs with Nil -> VNil | Cons (h, t) -> if rb_eq h v then VInt i else val_index_of t v (i + 1);

let rec val_count_eq = fn (xs: Val list) -> fn (v: Val) ->
  match xs with Nil -> 0 | Cons (h, t) -> (if rb_eq h v then 1 else 0) + val_count_eq t v;

let rec val_uniq = fn (xs: Val list) -> fn (seen: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if val_contains seen h then val_uniq t seen else Cons (h, val_uniq t (Cons (h, seen)));

let rec val_rev = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with Nil -> acc | Cons (h, t) -> val_rev t (Cons (h, acc));

// insertion sort by cmp_vals (stable enough for the corpus; Ruby's <=>).
let rec val_insert = fn (v: Val) -> fn (xs: Val list) ->
  match xs with
  | Nil -> Cons (v, Nil)
  | Cons (h, t) -> if cmp_vals v h <= 0 then Cons (v, xs) else Cons (h, val_insert v t);
let rec val_sort = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> val_insert h (val_sort t);

let rec val_min = fn (xs: Val list) -> fn (best: Val) ->
  match xs with Nil -> best | Cons (h, t) -> val_min t (if cmp_vals h best < 0 then h else best);
let rec val_max = fn (xs: Val list) -> fn (best: Val) ->
  match xs with Nil -> best | Cons (h, t) -> val_max t (if cmp_vals h best > 0 then h else best);

let rec val_sum = fn (xs: Val list) -> fn (acc: Val) ->
  match xs with Nil -> acc | Cons (h, t) -> val_sum t (arith_bin "+" acc h);

// hash (VHsh flat [k1,v1,k2,v2,...]) accessors.
let rec hash_keys = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (k, rest) -> (match rest with Cons (_, t) -> Cons (k, hash_keys t) | Nil -> Nil);
let rec hash_values = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (_, rest) -> (match rest with Cons (v, t) -> Cons (v, hash_values t) | Nil -> Nil);
// Hash#to_a: a list of [k, v] two-element arrays.
let rec hash_to_a = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (arr_new (Cons (k, Cons (v, Nil))), hash_to_a t) | Nil -> Nil);
let rec hash_get = fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Nil -> VNil
  | Cons (k2, rest) -> (match rest with Cons (v, t) -> if hkey_eql k2 k then v else hash_get t k | Nil -> VNil);
let rec hash_haskey = fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Nil -> false
  | Cons (k2, rest) -> (match rest with Cons (_, t) -> if hkey_eql k2 k then true else hash_haskey t k | Nil -> false);
// Hash#rassoc(value): the first [key, value] pair with that value.
let rec hash_rassoc = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> VNil
  | Cons (k, rest) ->
    (match rest with
     | Cons (v2, t) -> if rb_eq v2 v then arr_new (Cons (k, Cons (v2, Nil))) else hash_rassoc t v
     | Nil -> VNil);
// Hash#fetch_values(*keys): the values in the order asked for.
let rec hash_fetch_values = fn (xs: Val list) -> fn (ks: Val list) ->
  match ks with
  | Nil -> Nil
  | Cons (k, rest) -> Cons (hash_get xs k, hash_fetch_values xs rest);
// Hash#except(*keys): every pair whose key was not named.
let rec hash_except = fn (xs: Val list) -> fn (ks: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       if val_member ks k then hash_except t ks else Cons (k, Cons (v, hash_except t ks))
     | Nil -> Nil);
// Hash#slice is the complement of #except: KEEP the listed keys, in the order
// ruby returns them (the argument order, not the hash's). `slice` used to be an
// unconditional alias of `[]`, which is right for String and Array and wrong
// for Hash -- `{"A"=>"1"}.slice("A")` answered `"1"` instead of `{"A"=>"1"}`.
// A value where a Hash belongs: wrong, and quiet about it.
let rec hash_slice = fn (xs: Val list) -> fn (ks: Val list) ->
  match ks with
  | Nil -> Nil
  | Cons (k, t) ->
    // ⚠ a key whose value IS nil must still be kept, so ask whether the key is
    //   there rather than whether the value is non-nil.
    if hash_haskey xs k then Cons (k, Cons (hash_get xs k, hash_slice xs t))
    else hash_slice xs t;
let rec hash_pairs = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (arr_new (Cons (k, Cons (v, Nil))), hash_pairs t) | Nil -> Nil);
let rec hash_len = fn (xs: Val list) ->
  match xs with Nil -> 0 | Cons (_, rest) -> (match rest with Cons (_, t) -> 1 + hash_len t | Nil -> 0);
// update key k to v (in place order), or append if absent.

let rec hash_put = fn (xs: Val list) -> fn (k: Val) -> fn (v: Val) ->
  match xs with
  | Nil -> Cons (k, Cons (v, Nil))
  | Cons (k2, rest) ->
    (match rest with
     | Cons (v2, t) -> if hkey_eql k2 k then Cons (k2, Cons (v, t)) else Cons (k2, Cons (v2, hash_put t k v))
     | Nil -> Cons (k, Cons (v, Nil)));
// merge other's pairs into base (other wins on conflict).
let rec hash_merge = fn (base: Val list) -> fn (other: Val list) ->
  match other with
  | Nil -> base
  | Cons (k, rest) -> (match rest with Cons (v, t) -> hash_merge (hash_put base k v) t | Nil -> base);
// merge every VHsh argument into base, left to right.
let rec hash_merge_all = fn (base: Val list) -> fn (args: Val list) ->
  match args with
  | Nil -> base
  | Cons (VHsh o, t) -> hash_merge_all (hash_merge base (hderef o)) t
  | Cons (_, t) -> hash_merge_all base t;
// swap keys and values.
// the pairs whose VALUE is not nil (Hash#compact).
let rec hash_drop_nil = fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (v, t)) ->
    (match v with VNil -> hash_drop_nil t | _ -> Cons (k, Cons (v, hash_drop_nil t)))
  | _ -> (Nil : Val list);
let rec hash_invert = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (v, Cons (k, hash_invert t)) | Nil -> Nil);
let rec hash_has_value = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> false
  | Cons (_, rest) -> (match rest with Cons (v2, t) -> if rb_eq v2 v then true else hash_has_value t v | Nil -> false);
let rec hash_key_of = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> VNil
  | Cons (k, rest) -> (match rest with Cons (v2, t) -> if rb_eq v2 v then k else hash_key_of t v | Nil -> VNil);
let rec hash_values_at = fn (xs: Val list) -> fn (keys: Val list) ->
  match keys with Nil -> Nil | Cons (k, t) -> Cons (hash_get xs k, hash_values_at xs t);
// remove key k, returning the new pair list.
let rec hash_del = fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Nil -> Nil
  | Cons (k2, rest) ->
    (match rest with
     | Cons (v2, t) -> if hkey_eql k2 k then t else Cons (k2, Cons (v2, hash_del t k))
     | Nil -> Nil);

// ---- printing (Ruby's to_s / inspect / puts) -----------------------------
let hex_uc_digit = fn (d: int) -> if d < 10 then chr (48 + d) else chr (65 + d - 10);
let rec hex_uc_go = fn (n: int) -> fn (acc: str) -> if n == 0 then acc else hex_uc_go (n / 16) (hex_uc_digit (n - (n / 16) * 16) ++ acc);
let hex_uc = fn (n: int) -> if n == 0 then "0" else hex_uc_go n "";
let hex4 = fn (n: int) ->
  let h = hex_uc n in
  if str_len h >= 4 then h else if str_len h == 3 then "0" ++ h else if str_len h == 2 then "00" ++ h else "000" ++ h;

// escape a string for inspect. Under a UTF-8 default_external (Ruby's usual
// default) a printable non-ASCII codepoint renders as its literal UTF-8 bytes
// (`"あ".inspect` => `"あ"`); only the C1 control range U+0080..U+009F is
// escaped as \uXXXX. (A full Unicode "printable" test would also escape some
// format/unassigned codepoints; this covers the common case.)
let hex2 = fn (n: int) -> let h = hex_uc n in if str_len h >= 2 then h else "0" ++ h;
// `bin` = the string is ASCII-8BIT, where ruby escapes every byte outside
// printable ASCII as \xNN rather than decoding UTF-8 or writing \uXXXX.
// Is there a well-formed UTF-8 sequence at `i`? A byte that starts none is
// not text, and ruby inspects it as \xNN -- which is what makes the bytes of
// `[1.23].pack("E")` readable instead of mojibake.
let rec utf8_cont_ok = fn (s: str) -> fn (i: int) -> fn (endp: int) ->
  if i >= endp then true
  else (let b = ord (char_at s i) in
        if b >= 128 && b < 192 then utf8_cont_ok s (i + 1) endp else false);
let utf8_seq_len = fn (s: str) -> fn (i: int) ->
  let b = ord (char_at s i) in
  if b < 128 then 1
  else if b >= 194 && b < 224 then 2
  else if b >= 224 && b < 240 then 3
  else if b >= 240 && b < 245 then 4
  else 0;
let utf8_seq_ok = fn (s: str) -> fn (i: int) ->
  let n = utf8_seq_len s i in
  if n == 0 || i + n > str_len s then false else utf8_cont_ok s (i + 1) (i + n);

let rec esc_str_b = fn (s: str) -> fn (i: int) -> fn (acc: str) -> fn (bin: bool) ->
  if i >= str_len s then acc
  else
    let c = char_at s i in
    if bin && (ord c >= 128 || ord c < 32 || ord c == 127) then
      (let piece =
         if str_eq c "\n" then "\\n"
         else if str_eq c "\t" then "\\t"
         else if str_eq c "\r" then "\\r"
         else if ord c == 12 then "\\f"
         else if ord c == 11 then "\\v"
         else if ord c == 8 then "\\b"
         else if ord c == 7 then "\\a"
         else if ord c == 27 then "\\e"
         else "\\x" ++ hex2 (ord c) in
       esc_str_b s (i + 1) (acc ++ piece) bin)
    else
    if ord c >= 128 then
      (if utf8_seq_ok s i then
         (let cp = (match utf8_cp s i with (cc, ll) -> cc) in
          let l = (match utf8_cp s i with (cc, ll) -> ll) in
          let esc = if cp >= 128 && cp <= 159 then "\\u" ++ hex4 cp else substring s i (i + l) in
          esc_str_b s (i + l) (acc ++ esc) bin)
       // a byte that starts no valid sequence is shown as itself, in hex
       else esc_str_b s (i + 1) (acc ++ "\\x" ++ hex2 (ord c)) bin)
    else
    let piece =
      if str_eq c "\\" then "\\\\"
      else if str_eq c "\"" then "\\\""
      else if str_eq c "\n" then "\\n"
      else if str_eq c "\t" then "\\t"
      else if str_eq c "\r" then "\\r"
      else if ord c == 12 then "\\f"
      else if ord c == 11 then "\\v"
      else if ord c == 8 then "\\b"
      else if ord c == 7 then "\\a"
      else if ord c == 27 then "\\e"
      // remaining control bytes inspect as \uXXXX in a UTF-8 string; the
      // \xNN form above is for a BINARY one, which is what ruby distinguishes.
      else if ord c < 32 || ord c == 127 then "\\u" ++ hex4 (ord c)
      // a literal #{ / #$ / #@ would read as interpolation: escape the #.
      else if str_eq c "#" && i + 1 < str_len s &&
              (str_eq (char_at s (i + 1)) "\{" || str_eq (char_at s (i + 1)) "$" || str_eq (char_at s (i + 1)) "@")
      then "\\#"
      else c in
    esc_str_b s (i + 1) (acc ++ piece) bin;


// render a float as Ruby does, including Infinity / -Infinity / NaN.
// (NaN fails self-equality; +/-inf is unchanged by halving.)
// insert ".0" before the `e` when the mantissa carries no decimal point.
let rec exp_with_point = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then s
  else if str_eq (char_at s i) "." then s
  else if str_eq (char_at s i) "e" || str_eq (char_at s i) "E" then
    substring s 0 i ++ ".0" ++ substring s i (str_len s)
  else exp_with_point s (i + 1);
// ⚠ RUBY CHOOSES FIXED OR EXPONENTIAL BY WHERE THE DECIMAL POINT LANDS, not
// by how many digits there are. CRuby's flo_to_s goes exponential exactly when
// `decpt < -3 || decpt > DBL_DIG` (15), counting decpt from the first
// significant digit -- so 1e14 prints in full as "100000000000000.0" while
// 1234567890123456.0 (the same 16 digits, decpt 16) prints as
// "1.234567890123456e+15". str_of_float draws the line somewhere else, so
// four of core/float/to_s's rows were on the wrong side of it. The digits
// str_of_float chose are kept; only the placement is re-decided.
//
// the significant digits of a rendered float, with the decimal point's
// position relative to the first of them ("0.0001" -> ("1", -3)).
let rec flt_num_go = fn (s: str) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc
  else let c = char_at s i in
       if str_eq c "0" then flt_num_go s (i + 1) (acc * 10)
       else if str_eq c "1" then flt_num_go s (i + 1) (acc * 10 + 1)
       else if str_eq c "2" then flt_num_go s (i + 1) (acc * 10 + 2)
       else if str_eq c "3" then flt_num_go s (i + 1) (acc * 10 + 3)
       else if str_eq c "4" then flt_num_go s (i + 1) (acc * 10 + 4)
       else if str_eq c "5" then flt_num_go s (i + 1) (acc * 10 + 5)
       else if str_eq c "6" then flt_num_go s (i + 1) (acc * 10 + 6)
       else if str_eq c "7" then flt_num_go s (i + 1) (acc * 10 + 7)
       else if str_eq c "8" then flt_num_go s (i + 1) (acc * 10 + 8)
       else if str_eq c "9" then flt_num_go s (i + 1) (acc * 10 + 9)
       else flt_num_go s (i + 1) acc;
// the signed exponent written after the `e`.
let flt_exp_num = fn (s: str) ->
  if str_len s == 0 then 0
  else if str_eq (substring s 0 1) "-" then 0 - flt_num_go (substring s 1 (str_len s)) 0 0
  else if str_eq (substring s 0 1) "+" then flt_num_go (substring s 1 (str_len s)) 0 0
  else flt_num_go s 0 0;
let rec flt_digs_go = fn (s: str) -> fn (i: int) -> fn (acc: str) -> fn (dp: int) -> fn (seen: bool) ->
  if i >= str_len s then (acc, dp)
  else
    let c = char_at s i in
    // the point only switches sides; it does not move the count
    if str_eq c "." then flt_digs_go s (i + 1) acc dp true
    else if str_eq c "e" || str_eq c "E" then
      (let ex = flt_exp_num (substring s (i + 1) (str_len s)) in (acc, dp + ex))
    else if str_eq c "0" && str_eq acc "" then
      // a leading zero moves the point without contributing a digit
      flt_digs_go s (i + 1) acc (if seen then dp - 1 else dp) seen
    else flt_digs_go s (i + 1) (acc ++ c) (if seen then dp else dp + 1) seen;
// drop trailing zeros from the digit string (they are placement, not value)
let rec flt_trim0 = fn (d: str) ->
  if str_len d > 1 && str_eq (char_at d (str_len d - 1)) "0"
  then flt_trim0 (substring d 0 (str_len d - 1)) else d;
let rec flt_zeros = fn (n: int) -> if n <= 0 then "" else "0" ++ flt_zeros (n - 1);
// add one at position i, carrying left; "" when it carries past the front.
let rec flt_carry = fn (d: str) -> fn (i: int) ->
  if i < 0 then ""
  else
    let c = char_at d i in
    let nx = (if str_eq c "0" then "1" else if str_eq c "1" then "2" else if str_eq c "2" then "3"
              else if str_eq c "3" then "4" else if str_eq c "4" then "5" else if str_eq c "5" then "6"
              else if str_eq c "6" then "7" else if str_eq c "7" then "8" else if str_eq c "8" then "9"
              else "") in
    if str_eq nx "" then flt_carry (substring d 0 i ++ "0" ++ substring d (i + 1) (str_len d)) (i - 1)
    else substring d 0 i ++ nx ++ substring d (i + 1) (str_len d);
// does <digits> with the point at <dp> read back as exactly the magnitude a?
let flt_roundtrips = fn (d: str) -> fn (dp: int) -> fn (a: float) ->
  let ds = substring d 0 1 ++ "." ++ (if str_len d > 1 then substring d 1 (str_len d) else "0")
           ++ "e" ++ str_of_int (dp - 1) in
  float_of_str ds == a;
// the shortest rounded prefix that still reads back as `a`, with the point
// where that prefix puts it. ⚠ a carry out of the FRONT ("99" -> "100") moves
// the point one right and leaves a single digit -- which is exactly how
// 9.88...e-324 becomes ruby's "1.0e-323", a shorter answer than the "9.9e-324"
// that keeping the exponent fixed would have produced.
let rec flt_shorten_go = fn (d: str) -> fn (n: int) -> fn (dp: int) -> fn (a: float) ->
  if n >= str_len d then (d, dp)
  else
    let head = substring d 0 n in
    let nxt = char_at d n in
    let up = str_eq nxt "5" || str_eq nxt "6" || str_eq nxt "7" || str_eq nxt "8" || str_eq nxt "9" in
    let carried = if up then flt_carry head (str_len head - 1) else head in
    let (cand, cdp) = (if str_eq carried "" then ("1", dp + 1) else (carried, dp)) in
    let cand = flt_trim0 cand in
    if flt_roundtrips cand cdp a then (cand, cdp)
    else flt_shorten_go d (n + 1) dp a;
let flt_shorten = fn (d: str) -> fn (dp: int) -> fn (a: float) ->
  if str_len d <= 1 then (d, dp) else flt_shorten_go d 1 dp a;
let flt_exp_str = fn (e: int) ->
  let a = if e < 0 then 0 - e else e in
  let d = str_of_int a in
  (if e < 0 then "-" else "+") ++ (if str_len d < 2 then "0" ++ d else d);
let rb_float_str = fn (f: float) ->
  if (if f == f then false else true) then "NaN"
  else if (if f == 0.0 then false else true) && f * 0.5 == f then (if f > 0.0 then "Infinity" else "-Infinity")
  else if f == 0.0 then (if str_eq (substring (str_of_float f) 0 1) "-" then "-0.0" else "0.0")
  else
    let raw = str_of_float f in
    let neg = str_eq (substring raw 0 1) "-" in
    let body = if neg then substring raw 1 (str_len raw) else raw in
    let (d0, dp) = flt_digs_go body 0 "" 0 false in
    // ⚠ ...and the DIGITS are the shortest that read back as the same value.
    // str_of_float is already shortest for ordinary floats, but for a
    // SUBNORMAL it hands back twelve ("4.94065645841e-324" where ruby writes
    // "5.0e-324") -- every one of those reads back as the same single value,
    // so ruby keeps only the first. Shortened from the left and checked by
    // reading it back, which is the only test that cannot be wrong.
    // the MAGNITUDE is what reads back: the sign is carried separately, and
    // comparing a positive re-read against a negative float never matched.
    let (d, dp) = flt_shorten (flt_trim0 d0) dp (if f < 0.0 then 0.0 - f else f) in
    let sign = if neg then "-" else "" in
    if str_eq d "" then (if neg then "-0.0" else "0.0")
    // transcribed from flo_to_s (numeric.c): with the point INSIDE the digits
    // it is always fixed, however many there are -- 1121489970657575.4 has
    // seventeen and decpt 16, and ruby writes it out in full while
    // 1234567890123456.0 (sixteen digits, decpt 16) goes exponential. Reading
    // the limit as "decpt > DBL_DIG means exponential" got the first wrong.
    else if dp > 0 && dp < str_len d then
      sign ++ substring d 0 dp ++ "." ++ substring d dp (str_len d)
    else if dp > 0 && dp <= 15 then sign ++ d ++ flt_zeros (dp - str_len d) ++ ".0"
    else if dp <= 0 && dp > 0 - 4 then sign ++ "0." ++ flt_zeros (0 - dp) ++ d
    // exponential: one digit, a point, the rest (never empty), e<sign><>=2>
    else sign ++ substring d 0 1 ++ "."
           ++ (if str_len d > 1 then substring d 1 (str_len d) else "0")
           ++ "e" ++ flt_exp_str (dp - 1);

// one side of a Range as it prints: an absent bound (beginless / endless) is
// empty, and every other bound prints as itself.
let rec rng_side_s = fn (v: Val) ->
  match v with VNil -> "" | _ -> to_s v

// 0x + 16 hex digits, the shape Ruby shows an address in. (The one in the
// evaluator's chain is not in scope here.)
and hex16_of = fn (n: int) ->
  let h = int_to_base n 16 in
  let rec pad = fn (k: int) -> fn (acc: str) -> if k <= 0 then acc else pad (k - 1) ("0" ++ acc) in
  pad (16 - str_len h) "" ++ h
and proc_to_s = fn (pid9: int) ->
  let k9 = str_of_int pid9 in
  let where9 = (if map_has proc_src ("f" ++ k9) then
                  (match map_get proc_src ("f" ++ k9) with
                   | VStr h9 -> (let f9 = sget h9 in
                                 if str_eq f9 "" then ""
                                 else " " ++ f9 ++ ":" ++ (match map_get proc_src k9 with VInt l9 -> str_of_int l9 | _ -> "0"))
                   | _ -> "")
                else "") in
  // a Symbol#to_proc names the SYMBOL instead of a source line: it was not
  // written anywhere, and `(&:foobar)` is how ruby says so.
  let where9 = (if map_has proc_symsrc k9
                then " (&:" ++ (match map_get proc_symsrc k9 with VStr h8 -> sget h8 | _ -> "") ++ ")"
                else where9) in
  "#<Proc:0x" ++ hex16_of (pid9 * 8 + 112) ++ where9
  ++ (if map_has lambda_ids k9 then " (lambda)" else "") ++ ">"

and anon_addr_of = fn (c: str) ->
  let i = str_index_of c "_" in
  if i < 0 then 0 else (try_or (fn () -> int_of_str (substring c (i + 1) (str_len c))) 0)
// Where the group that opens at index 0 closes, or -1 if it does not close at
// all. Escapes and character classes are skipped, so `(?i:\))` and `(?i:[)])`
// do not end the group early.
and rx_group_end = fn (p: str) -> fn (i: int) -> fn (depth: int) -> fn (incls: bool) ->
  if i >= str_len p then 0 - 1
  else
    let c9 = char_at p i in
    if str_eq c9 "\\" then rx_group_end p (i + 2) depth incls
    else if incls then (if str_eq c9 "]" then rx_group_end p (i + 1) depth false
                        else rx_group_end p (i + 1) depth true)
    else if str_eq c9 "[" then rx_group_end p (i + 1) depth true
    else if str_eq c9 "(" then rx_group_end p (i + 1) (depth + 1) false
    else if str_eq c9 ")" then (if depth == 1 then i else rx_group_end p (i + 1) (depth - 1) false)
    else rx_group_end p (i + 1) depth false

// Read a `(?...:` header as flags. Only m, i and x and at most one `-` -- a
// header holding anything else (`(?=5)`, `(?<name>`) is not an option group.
// Repeats are allowed and the LAST mention of a flag wins, which is what
// `(?mmmmix-miiiix:)` prints as all-off.
and rx_hdr_flags = fn (h: str) -> fn (i: int) -> fn (on: str) -> fn (off: str) -> fn (neg: bool) ->
  if i >= str_len h then (true, on, off)
  else
    let c9 = char_at h i in
    if str_eq c9 "-" then (if neg then (false, "", "") else rx_hdr_flags h (i + 1) on off true)
    else if str_eq c9 "m" || str_eq c9 "i" || str_eq c9 "x" then
      (if neg then rx_hdr_flags h (i + 1) on (off ++ c9) neg
       else rx_hdr_flags h (i + 1) (on ++ c9) off neg)
    else (false, "", "")

// The `:` that ends a `(?...` header, searched only as far as the group's own
// close (str_index_of has no "from here" form).
and rx_hdr_colon = fn (p: str) -> fn (i: int) -> fn (stop: int) ->
  if i >= stop then 0 - 1
  else if str_eq (char_at p i) ":" then i
  else rx_hdr_colon p (i + 1) stop

// Is the WHOLE pattern one option group? ruby's #to_s lifts its flags into the
// wrapper then -- `/(?i:x)/` prints `(?i-mx:x)` and not `(?-mix:(?i:x))`.
and rx_collapse_opt_group = fn (p: str) ->
  if str_len p < 4 then (false, "", "", p)
  else if (if str_eq (substring p 0 2) "(?" then false else true) then (false, "", "", p)
  else
    let e9 = rx_group_end p 2 1 false in
    if e9 != str_len p - 1 then (false, "", "", p)
    else
      let ci9 = rx_hdr_colon p 2 e9 in
      if ci9 < 0 then (false, "", "", p)
      else
        (match rx_hdr_flags (substring p 2 ci9) 0 "" "" false with
         | (ok9, on9, off9) ->
           if ok9 then (true, on9, off9, substring p (ci9 + 1) e9) else (false, "", "", p))

and to_s = fn (v: Val) ->
  match v with
  | VInt n -> str_of_int n
  | VBig s -> s
  | VRat (n, d) -> n ++ "/" ++ d
  | VCpx (r, i) -> to_s r ++ (if num_isneg_signed i then "-" else "+")
                   ++ to_s (num_mag_signed i) ++ cpx_im_tail i
  | VFlt f -> rb_float_str f
  | VStr s -> let s = sget s in s
  | VBool b -> if b then "true" else "false"
  | VNil -> ""
  | VArr _ -> inspect v
  | VHsh _ -> inspect v
  | VSym s -> s
  // an anonymous class assigned to a constant takes that constant's name --
  // `X = Class.new; puts X` prints X, not the internal bookkeeping name.
  | VClass c ->
    // a singleton class prints as `#<Class:X>`. The predicates for this live
    // further down the file than this function can reach, so the test is spelled
    // out; X being an OBJECT (a numeric bookkeeping id) needs the world to name
    // its class, and that case is answered by the world-aware printer, which is
    // also what handles a singleton of a singleton.
    if str_len c >= 6 && str_eq (substring c 0 5) "(sng:"
       && (if is_digit (char_at c 5) then false else true)
    then "#<Class:" ++ substring c 5 (str_len c - 1) ++ ">"
    else if is_anon_cls c && map_has anon_name c
    then (match map_get anon_name c with
          | VStr h -> sget h
          | _ -> "#<" ++ (if str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_" then "Module" else "Class")
                 ++ ":0x" ++ hex16_of (anon_addr_of c) ++ ">")
    // a module opened with `module m::Q` under an anonymous m keeps the
    // bookkeeping path "AnonModule_1::Q"; ruby prints the owner as it prints
    // and then the path.
    else if is_anon_cls c && str_find_from c "::" 0 > 0 then
      (let i9 = str_find_from c "::" 0 in
       to_s (VClass (substring c 0 i9)) ++ substring c i9 (str_len c))
    // ...and one that was never named shows Ruby's `#<Class:0xADDR>` rather
    // than the internal bookkeeping name. `Class.new.inspect` said
    // "AnonClass_0", which names an implementation detail and, worse, reads as
    // if the class had that name -- `.name` correctly answers nil.
    else if is_anon_cls c then
      (let kind = (if str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_" then "Module"
                   else if str_len c >= 7 && str_eq (substring c 0 7) "Struct_" then "Class"
                   else "Class") in
       "#<" ++ kind ++ ":0x" ++ hex16_of (anon_addr_of c) ++ ">")
    else c
  | VRegex (p, fl, _) ->
    // Regexp#to_s: "(?<on>-<off>:body)" with the m,i,x flags split by state.
    (match rx_collapse_opt_group p with
     | (coll9, gon9, goff9, body9) ->
       let has9 = fn (ch9: str) ->
         // ⚠ the OFF half is read first: it comes after the `-` in the header,
         // and the last mention of a flag wins. `(?mmmmix-miiiix:)` turns all
         // three off, which is what ruby prints.
         (if coll9 then
            (if str_contains goff9 ch9 then false
             else if str_contains gon9 ch9 then true
             else str_contains fl ch9)
          else str_contains fl ch9) in
       let on = (if has9 "m" then "m" else "") ++ (if has9 "i" then "i" else "") ++ (if has9 "x" then "x" else "") in
       let off = (if has9 "m" then "" else "m") ++ (if has9 "i" then "" else "i") ++ (if has9 "x" then "" else "x") in
       "(?" ++ on ++ (if str_eq off "" then "" else "-" ++ off) ++ ":" ++ (if coll9 then body9 else p) ++ ")")
  | VObj id ->
    // Encoding#to_s is its name, MatchData#to_s is the whole match; disp
    // (world-aware) overrides other objects
    if map_has enc_name (str_of_int id) then map_get enc_name (str_of_int id)
    else if map_has md_whole id then map_get md_whole id
    else "#<object>"
  | VRange (lo, hi, excl) ->
    rng_side_s lo ++ (if excl then "..." else "..") ++ rng_side_s hi
  | VExc (_, m) -> m   // Ruby: an exception's to_s is its message
  | VMain -> "main"
  // #<Proc:0xADDR file:line> -- and " (lambda)" for a lambda, which is how
  // ruby tells the two apart in one line of output.
  | VProc pid9 -> proc_to_s pid9
  | VBind _ -> "#<Binding>"

and inspect = fn (v: Val) ->
  match v with
  | VStr s ->
    (let e0 = senc_get s in
     let e = enc_canon_name e0 in
     let sv = sget s in
     // ⚠ A DUMMY encoding is not decoded at ALL, so nothing in it is a
     // character to print: ruby escapes every byte, the printable ASCII ones
     // included -- `"abcd".force_encoding("ISO-2022-JP").inspect` is
     // "\x61\x62\x63\x64", not "abcd". This is the one case where an
     // ascii-compatible encoding still shows its ASCII as \xNN, which is why
     // it has to be asked BEFORE the compatibility question below.
     if enc_is_dummy e then
       (let n9 = str_len sv in
        let rec go9 = fn (i9: int) -> fn (acc9: str) ->
          (if i9 >= n9 then acc9
           else go9 (i9 + 1) (acc9 ++ "\\x" ++ hex2 (ord (char_at sv i9)))) in
        "\"" ++ go9 0 "" ++ "\"")
     else
     // a NON-ASCII-COMPATIBLE string (UTF-16/32) inspects through its
     // codepoints: printable ASCII raw, everything else \uXXXX; a MULTIBYTE
     // ascii-compatible one (EUC-JP, Shift_JIS...) shows each multibyte
     // character as one \x{...} group.
     if (if enc_ascii_compat e then false else true) && (if str_eq e "UTF-7" then false else true) then
       (let rec go = fn (cps: int list) -> fn (acc: str) ->
          (match cps with
           | Nil -> acc
           | Cons (cp, t9) ->
             let piece = (if cp == 34 then "\\\"" else if cp == 92 then "\\\\"
                          else if cp >= 32 && cp < 127 then chr cp
                          else if cp > 65535 then "\\u\{" ++ hex_uc cp ++ "}"
                          else "\\u" ++ hex4 cp) in
             go t9 (acc ++ piece)) in
        "\"" ++ go (decode_cps sv e 0) "" ++ "\"")
     else if enc_ascii_compat e && (if str_eq e "UTF-8" then false else true)
             && (if str_eq e "ASCII-8BIT" then false else true) && (if str_eq e "US-ASCII" then false else true)
             && (str_eq e "EUC-JP" || str_eq e "Shift_JIS" || str_eq e "Windows-31J"
                 || str_eq e "Big5" || str_eq e "EUC-KR" || str_eq e "EUC-TW" || str_eq e "GBK" || str_eq e "GB18030") then
       (let n = str_len sv in
        let rec go = fn (i: int) -> fn (acc: str) ->
          if i >= n then acc
          else
            let b0 = ord (char_at sv i) in
            if b0 < 32 || b0 == 127 then
              (let piece = (if b0 == 10 then "\\n" else if b0 == 9 then "\\t" else if b0 == 13 then "\\r"
                            else if b0 == 12 then "\\f" else if b0 == 11 then "\\v" else if b0 == 8 then "\\b"
                            else if b0 == 7 then "\\a" else if b0 == 27 then "\\e" else "\\x" ++ hex2 b0) in
               go (i + 1) (acc ++ piece))
            else if b0 == 34 then go (i + 1) (acc ++ "\\\"")
            else if b0 == 92 then go (i + 1) (acc ++ "\\\\")
            else if b0 < 128 then go (i + 1) (acc ++ char_at sv i)
            else
              // a MULTIBYTE character shows as one \x{...} group when its
              // trailing byte(s) are present; a lone byte as \xNN.
              (if i + 1 < n && ord (char_at sv (i + 1)) >= 64 then
                 go (i + 2) (acc ++ "\\x\{" ++ hex2 b0 ++ hex2 (ord (char_at sv (i + 1))) ++ "}")
               else go (i + 1) (acc ++ "\\x" ++ hex2 b0)) in
        "\"" ++ go 0 "" ++ "\"")
     else
       "\"" ++ esc_str_b sv 0 "" (str_eq e "ASCII-8BIT" || str_eq e "BINARY" || str_eq e "US-ASCII") ++ "\"")
  | VNil -> "nil"
  | VArr id ->
    if map_has insp_seen ("a" ++ str_of_int id) then "[...]"
    else
      let _ = map_set insp_seen ("a" ++ str_of_int id) 1 in
      let r = "[" ++ join_inspect (deref id) "" ++ "]" in
      let _ = map_delete insp_seen ("a" ++ str_of_int id) in
      r
  // A self-referential HASH used to recurse until the stack died, while the
  // array beside it printed "[...]". One guard, applied to one of the two
  // container kinds -- in both printers.
  | VHsh hid ->
    if map_has insp_seen ("h" ++ str_of_int hid) then "\{...}"
    else
      let _ = map_set insp_seen ("h" ++ str_of_int hid) 1 in
      let r = "\{" ++ join_pairs (hderef hid) "" ++ "}" in
      let _ = map_delete insp_seen ("h" ++ str_of_int hid) in
      r
  // a Range shows its bounds INSPECTED -- `("a".."c").inspect` is
  // `"a".."c"`, where its to_s is `a..c`. An absent bound shows as nothing.
  | VRange (lo, hi, excl) ->
    // A missing bound shows as nothing (`1..`, `..5`) -- but a range with
    // NEITHER bound has to show something, and ruby writes `nil..nil` there.
    (match lo with
     | VNil -> (match hi with VNil -> "nil" | _ -> "")
     | _ -> inspect lo)
    ++ (if excl then "..." else "..")
    ++ (match hi with
        | VNil -> (match lo with VNil -> "nil" | _ -> "")
        | _ -> inspect hi)
  | VRat (n, d) -> "(" ++ to_s v ++ ")"
  | VCpx (r, i) ->
    // Rational components are parenthesized in inspect, and a parenthesized
    // imaginary part takes an explicit *: ((11/25)+(2/25)*i).
    let ia = num_mag_signed i in
    "(" ++ (match r with VRat _ -> "(" ++ to_s r ++ ")" | _ -> to_s r)
        ++ (if num_isneg_signed i then "-" else "+")
        ++ (match ia with VRat _ -> "(" ++ to_s ia ++ ")*i" | _ -> to_s ia ++ cpx_im_tail ia) ++ ")"
  | VRegex (p, fl, _) ->
    // Regexp#inspect shows the m,i,x flags in canonical order.
    // ruby prints the flags in the order "mixn", and `n` is one of them: it
    // was dropped here, so `/x/n.inspect` read `/x/` -- a literal that means
    // something else.
    "/" ++ rx_esc_slashes p 0 "" ++ "/" ++ (if str_contains fl "m" then "m" else "") ++ (if str_contains fl "i" then "i" else "") ++ (if str_contains fl "x" then "x" else "") ++ (if str_contains fl "n" then "n" else "")
  | VSym sy ->
    // a symbol that isn't a plain identifier / valid operator name inspects
    // quoted and escaped (:"foo bar", :"9", :"a\nb").
    // a symbol's name is US-ASCII whenever every byte is -- which is ruby's
    // MECHANISM here, not a special case for symbols: a control byte inspects
    // as \xNN in a US-ASCII string and as \uXXXX in a UTF-8 one. Inspecting
    // through the UTF-8 spelling printed `:"\u0000"` where ruby writes
    // `:"\x00"`, while a symbol with real UTF-8 in it still prints as itself.
    // ...and the ENCODING decides whether the name can be plain at all. A
    // BINARY symbol carrying a high byte is not an identifier (`:"foo\xA4"`),
    // and a symbol in a non-ASCII-compatible encoding (UTF-16/32) is always
    // quoted AND shown through its codepoints -- printing its raw bytes gave
    // `:"f\x00o\x00o\x00"` where ruby writes `:"foo"`. String#inspect already
    // holds both rules, so the name is inspected AS a String wearing the
    // symbol's encoding rather than through a second copy of them.
    (let e9 = enc_canon_name (sym_enc_name sy) in
     let dummy9 = enc_is_dummy e9 in
     if (if dummy9 then false else true)
        && (if str_eq e9 "ASCII-8BIT" then rx_src_all7 sy 0 else enc_ascii_compat e9) && sym_plain sy
     then ":" ++ sy
     else if (if dummy9 then false else true)
             && enc_ascii_compat e9 && (if str_eq e9 "ASCII-8BIT" then rx_src_all7 sy 0 else true)
     then ":\"" ++ esc_str_b sy 0 "" (rx_src_all7 sy 0) ++ "\""
     else ":" ++ inspect (mkstr_e sy e9))
  | VObj id -> if map_has enc_name (str_of_int id) then "#<Encoding:" ++ enc_display_name (map_get enc_name (str_of_int id)) ++ ">" else "#<object>"
  // #<Proc:0xADDR file:line> -- and " (lambda)" for a lambda, which is how
  // ruby tells the two apart in one line of output.
  | VProc pid9 -> proc_to_s pid9
  | VBind _ -> "#<Binding>"
  // an exception inspects as #<ClassName: message>.
  | VExc (c, m) -> "#<" ++ c ++ ": " ++ m ++ ">"
  | _ -> to_s v

and sym_all_digits = fn (sy: str) -> fn (i: int) ->
  if i >= str_len sy then true
  else if is_digit (char_at sy i) then sym_all_digits sy (i + 1)
  else false
and sym_plain = fn (sy: str) ->
  if str_len sy == 0 then false
  else if is_valid_op_sym sy then true
  else
    // optional @ / @@ / $ sigil, then an identifier (?, !, = may end it).
    let st = (if str_len sy >= 2 && str_eq (substring sy 0 2) "@@" then 2
              else if str_eq (char_at sy 0) "@" || str_eq (char_at sy 0) "$" then 1
              else 0) in
    if st >= str_len sy then false
    // `:$&` and friends: a global's name may be one punctuation character, and
    // ruby prints those unquoted.
    else if st == 1 && str_eq (char_at sy 0) "$" && str_len sy == 2
            && is_gvar_punct (char_at sy 1) then true
    // ...and `:$-w`: the dash globals print unquoted too.
    else if st == 1 && str_eq (char_at sy 0) "$" && str_len sy == 3
            && str_eq (char_at sy 1) "-" then true
    // ...and the NUMBERED backref globals, to any number of digits: `:$1234`
    // prints unquoted. The one-punctuation-character case above covers `:$1`
    // and stopped there, so a longer number came out quoted.
    else if st == 1 && str_eq (char_at sy 0) "$" && is_digit (char_at sy 1)
            && sym_all_digits sy 1 then true
    // ...and a SIGILLED name takes no `?`/`!`/`=` ending: `:"$ruby!"` is not a
    // global's name, so ruby quotes it. Only a bare method name may end that
    // way, which is why the two walks differ.
    else if is_alpha (char_at sy st) || str_eq (char_at sy st) "_" then
      (if st == 0 then sym_ident_rest sy (st + 1) else sym_ident_plain sy (st + 1))
    else false

and sym_ident_plain = fn (sy: str) -> fn (i: int) ->
  if i >= str_len sy then true
  else (let c = char_at sy i in
        if is_alnum c || str_eq c "_" then sym_ident_plain sy (i + 1) else false)

and sym_ident_rest = fn (sy: str) -> fn (i: int) ->
  if i >= str_len sy then true
  else
    let c = char_at sy i in
    if is_alnum c || str_eq c "_" then sym_ident_rest sy (i + 1)
    else (str_eq c "?" || str_eq c "!" || str_eq c "=") && i + 1 == str_len sy

  // ...and the backtick, which is Kernel#` -- an operator method like the
  // rest, and the one this list did not have, so `:"`"` printed quoted.
// Regexp.escape: backslash-prefix the metacharacters and spell the control
// whitespace as an escape, matching CRuby's rb_reg_quote byte for byte. Note
// that `/`, `,`, `:`, `<`, `=`, `>`, `!`, `&` and `~` are NOT escaped.
and is_valid_op_sym = fn (sy: str) ->
  str_eq sy "|" ||
  map_has (name_set "is_valid_op_sym") sy
and rx_escape_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let c = char_at s i in
    let piece =
      if str_eq c "\n" then "\\n"
      else if str_eq c "\t" then "\\t"
      else if str_eq c "\r" then "\\r"
      else if ord c == 12 then "\\f"
      else if ord c == 11 then "\\v"
      else if str_eq c " " || str_eq c "#" || str_eq c "$" || str_eq c "(" || str_eq c ")" ||
              str_eq c "*" || str_eq c "+" || str_eq c "-" || str_eq c "." || str_eq c "?" ||
              str_eq c "[" || str_eq c "\\" || str_eq c "]" || str_eq c "^" ||
              str_eq c "\{" || str_eq c "|" || str_eq c "}"
      then "\\" ++ c
      else c in
    rx_escape_go s (i + 1) (acc ++ piece)

and rx_escape = fn (s: str) -> rx_escape_go s 0 ""

// Regexp.union: a string alternative is escaped, a regexp alternative keeps
// its own flags by going in as its to_s form `(?flags:body)`.
and rx_union_go = fn (xs: Val list) -> fn (acc: str) -> fn (first: bool) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    let piece = (match h with
                 | VRegex (_, _, _) -> to_s h
                 | VStr s -> rx_escape (sget s)
                 | VSym s -> rx_escape s
                 | other -> rx_escape (to_s other)) in
    rx_union_go t (if first then piece else acc ++ "|" ++ piece) false

and join_inspect = fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    let piece = if str_eq acc "" then inspect h else acc ++ ", " ++ inspect h in
    join_inspect t piece

// A Symbol prints bare on the left of a Hash pair when its name is a plain
// identifier -- letters, digits and underscores, not starting with a digit,
// optionally ending in `?` or `!`. `:foo=`, `:+` and `:""` are not, and ruby
// prints those as a quoted string with the same colon: `{"foo=": 1}`.
and sym_prints_bare = fn (s: str) ->
  let n = str_len s in
  if n == 0 then false
  else
    let c0 = char_at s 0 in
    if (if is_alpha c0 || str_eq c0 "_" then false else true) then false
    else
      let rec go = fn (i: int) ->
        if i >= n then true
        else
          let c = char_at s i in
          if is_alnum c || str_eq c "_" then go (i + 1)
          else (i == n - 1 && (str_eq c "?" || str_eq c "!")) in
      go 1

// The left-hand side of one Hash pair, separator included. Ruby 3.4 writes a
// Symbol key as `name: `, any other key as `<inspect> => ` -- with spaces,
// where 3.2 wrote `<inspect>=>` for every key. `kins` is the key already
// inspected, which only the non-Symbol branch needs (a Symbol is built from
// its name here, so this works with or without a world).
and hash_key_prefix = fn (k: Val) -> fn (kins: str) ->
  match k with
  | VSym sy -> (if sym_prints_bare sy then sy else inspect (mkstr sy)) ++ ": "
  | _ -> kins ++ " => "

and join_pairs = fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       let pair = hash_key_prefix k (inspect k) ++ inspect v in
       let acc2 = if str_eq acc "" then pair else acc ++ ", " ++ pair in
       join_pairs t acc2
     | Nil -> acc);

// Array#join — placed after to_s (which it uses on each element).
// `es` stringifies a leaf element. Ruby's Array#join calls #to_s on each
// element, so the caller (which has `world`) passes a world-aware es that
// invokes a user-defined to_s on objects; val_join itself predates the
// object machinery, hence the callback rather than a direct invoke.
let rec val_join = fn (es: Val -> str) -> fn (xs: Val list) -> fn (sep: str) -> fn (acc: str) -> fn (first: bool) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    // Ruby joins nested arrays recursively with the same separator.
    let piece = (match h with
                 | VArr id ->
                   if map_has insp_seen ("a" ++ str_of_int id) then ""
                   else let _ = map_set insp_seen ("a" ++ str_of_int id) 1 in
                        let r = val_join es (deref id) sep "" true in
                        let _ = map_delete insp_seen ("a" ++ str_of_int id) in r
                 | _ -> es h) in
    let acc2 = if first then piece else acc ++ sep ++ piece in
    val_join es t sep acc2 false;
