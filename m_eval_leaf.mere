    "class Set\n" ++
    "  include Enumerable\n" ++
    "\n" ++
    "  def self.[](*items)\n" ++
    "    new(items)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby refuses a non-enumerable argument everywhere a Set takes a collection,\n" ++
