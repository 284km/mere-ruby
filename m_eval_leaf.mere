    "      raise ArgumentError, \"different prefix: #\{dest_prefix.inspect} and #\{base_directory.inspect}\"\n" ++
    "    end\n" ++
    "    while !dest_names.empty? && !base_names.empty? && dest_names.first == base_names.first\n" ++
    "      dest_names.shift\n" ++
    "      base_names.shift\n" ++
    "    end\n" ++
    "    if base_names.include? \"..\"\n" ++
    "      raise ArgumentError, \"base_directory has ..: #\{base_directory}\"\n" ++
    "    end\n" ++
    "    base_names.fill(\"..\")\n" ++
    "    relpath_names = base_names + dest_names\n" ++
    "    if relpath_names.empty?\n" ++
