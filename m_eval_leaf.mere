    "module MonitorMixin\n" ++
    "  class ConditionVariable\n" ++
    "    def initialize(monitor); @monitor = monitor; end\n" ++
    "    def wait(timeout = nil); false; end\n" ++
    "    def signal; nil; end\n" ++
    "    def broadcast; nil; end\n" ++
    "  end\n" ++
    "  def initialize(*args)\n" ++
    "    super\n" ++
    "    mon_initialize\n" ++
    "  end\n" ++
    "  def mon_initialize; @mon_count = 0; self; end\n" ++
    "  def mon_enter; @mon_count = (@mon_count || 0) + 1; nil; end\n" ++
    "  def mon_exit; @mon_count = (@mon_count || 1) - 1; nil; end\n" ++
    "  def mon_owned?; (@mon_count || 0) > 0; end\n" ++
    "  def mon_locked?; mon_owned?; end\n" ++
    "  def mon_check_owner; nil; end\n" ++
    "  def mon_try_enter; mon_enter; true; end\n" ++
    "  def try_mon_enter; mon_try_enter; end\n" ++
    "  def mon_synchronize\n" ++
    "    mon_enter\n" ++
    "    begin\n" ++
    "      yield\n" ++
    "    ensure\n" ++
    "      mon_exit\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def synchronize(&b); mon_synchronize(&b); end\n" ++
    "  def new_cond; MonitorMixin::ConditionVariable.new(self); end\n" ++
    "end\n" ++
    "class Monitor\n" ++
    "  include MonitorMixin\n" ++
    "  def initialize; mon_initialize; end\n" ++
    "  def enter; mon_enter; end\n" ++
    "  def exit; mon_exit; end\n" ++
    "  def try_enter; mon_try_enter; end\n" ++
    "  def owned?; mon_owned?; end\n" ++
