    "    else\n" ++
    "      Pathname.new(File.join(*relpath_names))\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    "module Kernel\n" ++
    "  def Pathname(path)\n" ++
    "    path.is_a?(Pathname) ? path : Pathname.new(path)\n" ++
    "  end\n" ++
    "  # a module function, like Integer() and Array(): private as a method,\n" ++
    "  # public as Kernel.Pathname\n" ++
    "  module_function :Pathname\n" ++
    "end\n"
  // Set is pure Ruby in CRuby too (a Hash with true values, which is exactly
  // what this is), but it lives in the stdlib.
  else if str_eq n "set" then
    "class Set\n" ++
    "  include Enumerable\n" ++
    "\n" ++
    "  def self.[](*items)\n" ++
    "    new(items)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby refuses a non-enumerable argument everywhere a Set takes a collection,\n" ++
    "  # and names the two refusals differently: a set operation wants \"a set\", the\n" ++
    "  # rest want \"enumerable\". Answering NoMethodError instead moved the blame to\n" ++
    "  # whichever method was tried first.\n" ++
    "  def self.__enum!(x)\n" ++
    "    unless x.respond_to?(:each_entry) || x.respond_to?(:each)\n" ++
    "      raise ArgumentError, \"value must be enumerable\"\n" ++
    "    end\n" ++
    "    x\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__set!(x)\n" ++
    "    raise ArgumentError, \"value must be a set\" unless x.is_a?(Set)\n" ++
    "    x\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize(enum = nil, &block)\n" ++
    "    @hash = \{}\n" ++
    "    return if enum.nil?\n" ++
    "    Set.__enum!(enum)\n" ++
    "    if block\n" ++
    "      enum.each \{ |x| @hash[block.call(x)] = true }\n" ++
    "    else\n" ++
    "      enum.each \{ |x| @hash[x] = true }\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize_copy(orig)\n" ++
    "    @hash = orig.to_h_internal.dup\n" ++
    "  end\n" ++
    "\n" ++
    "  def to_h_internal\n" ++
    "    @hash\n" ++
    "  end\n" ++
    "  protected :to_h_internal\n" ++
    "\n" ++
    "  # A set being walked refuses the mutations ruby refuses, and ruby is precise\n" ++
    "  # about which: adding a NEW item, merging anything, and replacing all raise;\n" ++
    "  # deleting, subtracting and clearing do not, and re-adding an item that is\n" ++
    "  # already there does not either. Like the inspect guard, the marker is a table\n" ++
    "  # on the class keyed by object_id -- an ivar could not be written on a frozen\n" ++
    "  # set, and a frozen set is still walkable.\n" ++
    "  def self.__iter_ids\n" ++
    "    @__iter_ids ||= \{}\n" ++
    "  end\n" ++
    "\n" ++
    "  def __iterating?\n" ++
    "    Set.__iter_ids.key?(object_id)\n" ++
    "  end\n" ++
    "  private :__iterating?\n" ++
    "\n" ++
    "  # every mutation goes through here, so a frozen Set refuses with ruby's own\n" ++
    "  # message rather than with whatever the inner Hash would have said\n" ++
    "  def __modify!(kind = nil)\n" ++
    "    raise FrozenError, \"can't modify frozen Set: \" + inspect if frozen?\n" ++
    "    if __iterating?\n" ++
    "      raise RuntimeError, \"cannot replace set during iteration\" if kind == :replace\n" ++
    "      raise RuntimeError, \"cannot add to set during iteration\" if kind == :merge\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "  private :__modify!\n" ++
    "\n" ++
    "  def each(&block)\n" ++
    "    return to_enum(:each) \{ size } unless block\n" ++
    "    ids = Set.__iter_ids\n" ++
    "    id = object_id\n" ++
    "    ids[id] = (ids[id] || 0) + 1\n" ++
    "    begin\n" ++
    "      @hash.each_key(&block)\n" ++
    "    ensure\n" ++
    "      n = ids[id] - 1\n" ++
    "      if n > 0\n" ++
    "        ids[id] = n\n" ++
    "      else\n" ++
    "        ids.delete(id)\n" ++
    "      end\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def size\n" ++
    "    @hash.size\n" ++
    "  end\n" ++
    "  alias_method :length, :size\n" ++
    "  alias_method :count, :size\n" ++
    "\n" ++
    "  def empty?\n" ++
    "    @hash.empty?\n" ++
    "  end\n" ++
    "\n" ++
    "  def include?(o)\n" ++
    "    @hash.key?(o)\n" ++
    "  end\n" ++
    "  alias_method :member?, :include?\n" ++
    "  alias_method :===, :include?\n" ++
    "\n" ++
    "  def add(o)\n" ++
    "    __modify!\n" ++
    "    if __iterating? && !include?(o)\n" ++
    "      raise RuntimeError, \"can't add a new item into set during iteration\"\n" ++
    "    end\n" ++
    "    @hash[o] = true\n" ++
    "    self\n" ++
    "  end\n" ++
    "  alias_method :<<, :add\n" ++
    "\n" ++
    "  def add?(o)\n" ++
    "    return nil if include?(o)\n" ++
    "    add(o)\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete(o)\n" ++
    "    __modify!\n" ++
    "    @hash.delete(o)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete?(o)\n" ++
    "    return nil unless include?(o)\n" ++
    "    delete(o)\n" ++
    "  end\n" ++
    "\n" ++
    "  def merge(*enums)\n" ++
    "    __modify!(:merge)\n" ++
    "    enums.each do |e|\n" ++
    "      Set.__enum!(e)\n" ++
    "      e.each \{ |x| @hash[x] = true }\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def replace(enum)\n" ++
    "    __modify!(:replace)\n" ++
    "    Set.__enum!(enum)\n" ++
    "    h = \{}\n" ++
    "    enum.each \{ |x| h[x] = true }\n" ++
    "    @hash = h\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def subtract(enum)\n" ++
    "    __modify!\n" ++
    "    Set.__enum!(enum)\n" ++
    "    enum.each \{ |x| @hash.delete(x) }\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def to_a\n" ++
    "    @hash.keys\n" ++
    "  end\n" ++
    "\n" ++
    "  # to_set(klass = Set, *args) answers self for the plain call and builds a\n" ++
    "  # klass otherwise (the arguments are deprecated in 4.0 but still taken).\n" ++
    "  def to_set(klass = Set, *args, &block)\n" ++
    "    return self if klass == Set && args.empty? && block.nil?\n" ++
    "    klass.new(self, *args, &block)\n" ++
    "  end\n" ++
    "\n" ++
    "  # a copy keeps the comparison MODE: a set that compares by identity dups into\n" ++
    "  # one that still does (ruby carries it through initialize_copy)\n" ++
    "  def dup\n" ++
    "    s = self.class.new\n" ++
    "    s.compare_by_identity if compare_by_identity?\n" ++
    "    s.merge(to_a)\n" ++
    "    s\n" ++
    "  end\n" ++
    "\n" ++
    "  def clear\n" ++
    "    __modify!\n" ++
    "    @hash = \{}\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def __as_set(other)\n" ++
    "    return other if other.is_a?(Set)\n" ++
