    "\n" ++
    "  # disjoint? takes any enumerable, and says so with the other message\n" ++
    "  def disjoint?(other)\n" ++
    "    Set.__enum!(other)\n" ++
    "    os = __as_set(other)\n" ++
    "    (self & os).empty?\n" ++
    "  end\n" ++
    "\n" ++
    "  def intersect?(other)\n" ++
    "    !disjoint?(other)\n" ++
    "  end\n" ++
    "\n" ++
    "  def ==(other)\n" ++
    "    return true if equal?(other)\n" ++
    "    return false unless other.is_a?(Set)\n" ++
    "    # a set that compares by identity is not equal to one that does not, even\n" ++
    "    # when the members would compare equal either way\n" ++
    "    return false unless compare_by_identity? == other.compare_by_identity?\n" ++
    "    size == other.size && to_a.all? \{ |x| other.include?(x) }\n" ++
    "  end\n" ++
    "  alias_method :eql?, :==\n" ++
    "\n" ++
    "  # nil unless one contains the other: 0 equal, -1 proper subset, +1 proper\n" ++
    "  # superset. Anything that is not a Set is not comparable at all.\n" ++
    "  def <=>(other)\n" ++
    "    return nil unless other.is_a?(Set)\n" ++
    "    c = size <=> other.size\n" ++
    "    if c == 0\n" ++
    "      self == other ? 0 : nil\n" ++
    "    elsif c < 0\n" ++
    "      subset?(other) ? -1 : nil\n" ++
    "    else\n" ++
    "      superset?(other) ? 1 : nil\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def hash\n" ++
    "    to_a.sort_by \{ |x| x.to_s }.hash\n" ++
    "  end\n" ++
    "\n" ++
    "  def freeze\n" ++
    "    @hash.freeze\n" ++
    "    super\n" ++
    "  end\n" ++
    "\n" ++
    "  def compare_by_identity\n" ++
    "    __modify!\n" ++
    "    @hash.compare_by_identity\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def compare_by_identity?\n" ++
    "    @hash.compare_by_identity?\n" ++
    "  end\n" ++
    "\n" ++
    "  def classify(&block)\n" ++
    "    return to_enum(:classify) \{ size } unless block\n" ++
    "    h = \{}\n" ++
    "    each do |x|\n" ++
    "      k = block.call(x)\n" ++
    "      h[k] = Set.new unless h.key?(k)\n" ++
    "      h[k].add(x)\n" ++
    "    end\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # A one-argument block groups by its value. A TWO-argument one is a relation,\n" ++
    "  # and the subsets are the strongly connected components of the graph it\n" ++
    "  # describes -- not merely the connected ones, which would join a pair that is\n" ++
    "  # related in one direction only. The block is never asked about (x, x).\n" ++
    "  def divide(&func)\n" ++
    "    return to_enum(:divide) \{ size } unless func\n" ++
    "    return Set.new(classify(&func).values) unless func.arity == 2\n" ++
    "    els = to_a\n" ++
    "    adj = \{}\n" ++
    "    i = 0\n" ++
    "    while i < els.size\n" ++
    "      row = []\n" ++
    "      j = 0\n" ++
    "      while j < els.size\n" ++
    "        row << j if i != j && func.call(els[i], els[j])\n" ++
    "        j += 1\n" ++
    "      end\n" ++
    "      adj[i] = row\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    index = \{}\n" ++
    "    low = \{}\n" ++
    "    onstack = \{}\n" ++
    "    stack = []\n" ++
    "    comps = []\n" ++
    "    counter = [0]\n" ++
    "    visit = nil\n" ++
    "    visit = lambda do |v|\n" ++
    "      index[v] = counter[0]\n" ++
    "      low[v] = counter[0]\n" ++
    "      counter[0] = counter[0] + 1\n" ++
    "      stack.push(v)\n" ++
    "      onstack[v] = true\n" ++
    "      adj[v].each do |w|\n" ++
    "        if !index.key?(w)\n" ++
    "          visit.call(w)\n" ++
    "          low[v] = low[w] if low[w] < low[v]\n" ++
    "        elsif onstack[w]\n" ++
    "          low[v] = index[w] if index[w] < low[v]\n" ++
    "        end\n" ++
    "      end\n" ++
    "      if low[v] == index[v]\n" ++
    "        comp = []\n" ++
    "        loop do\n" ++
    "          w = stack.pop\n" ++
    "          onstack[w] = false\n" ++
    "          comp << els[w]\n" ++
    "          break if w == v\n" ++
    "        end\n" ++
    "        comps << comp\n" ++
    "      end\n" ++
    "    end\n" ++
    "    k = 0\n" ++
    "    while k < els.size\n" ++
    "      visit.call(k) unless index.key?(k)\n" ++
    "      k += 1\n" ++
    "    end\n" ++
    "    Set.new(comps.map \{ |c| Set.new(c) })\n" ++
    "  end\n" ++
    "\n" ++
    "  def __flatten_into(acc, set, seen)\n" ++
    "    raise ArgumentError, \"tried to flatten recursive Set\" if seen.key?(set.object_id)\n" ++
    "    seen[set.object_id] = true\n" ++
    "    set.each do |x|\n" ++
    "      if x.is_a?(Set)\n" ++
    "        __flatten_into(acc, x, seen)\n" ++
    "      else\n" ++
    "        acc << x\n" ++
    "      end\n" ++
    "    end\n" ++
    "    seen.delete(set.object_id)\n" ++
    "    acc\n" ++
    "  end\n" ++
    "  private :__flatten_into\n" ++
    "\n" ++
    "  def flatten\n" ++
    "    Set.new(__flatten_into([], self, \{}))\n" ++
    "  end\n" ++
    "\n" ++
    "  def flatten!\n" ++
    "    return nil unless to_a.any? \{ |x| x.is_a?(Set) }\n" ++
    "    replace(__flatten_into([], self, \{}))\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def join(sep = nil)\n" ++
    "    to_a.join(sep)\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete_if(&block)\n" ++
    "    return to_enum(:delete_if) \{ size } unless block\n" ++
    "    __modify!\n" ++
    "    to_a.each \{ |x| @hash.delete(x) if block.call(x) }\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def keep_if(&block)\n" ++
    "    return to_enum(:keep_if) \{ size } unless block\n" ++
    "    __modify!\n" ++
    "    to_a.each \{ |x| @hash.delete(x) unless block.call(x) }\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # the bang filters answer nil when nothing was removed, as ruby's do\n" ++
    "  def select!(&block)\n" ++
    "    return to_enum(:select!) \{ size } unless block\n" ++
    "    n = size\n" ++
    "    keep_if(&block)\n" ++
    "    size == n ? nil : self\n" ++
    "  end\n" ++
    "  alias_method :filter!, :select!\n" ++
    "\n" ++
    "  def reject!(&block)\n" ++
    "    return to_enum(:reject!) \{ size } unless block\n" ++
    "    n = size\n" ++
    "    delete_if(&block)\n" ++
    "    size == n ? nil : self\n" ++
    "  end\n" ++
    "\n" ++
    "  def map!(&block)\n" ++
    "    return to_enum(:map!) \{ size } unless block\n" ++
    "    replace(to_a.map \{ |x| block.call(x) })\n" ++
    "    self\n" ++
    "  end\n" ++
    "  alias_method :collect!, :map!\n" ++
    "\n" ++
    "  # ruby 4.0 made Set core and its inspect `Set[1, 2]` (a set that contains\n" ++
    "  # itself shows `Set[...]`); a SUBCLASS keeps the older shape, which is what\n" ++
    "  # 4.0.6 prints for one. The recursion guard is a table on the class rather\n" ++
    "  # than an ivar on the instance, because a frozen set still inspects.\n" ++
    "  def self.__insp_ids\n" ++
    "    @__insp_ids ||= \{}\n" ++
    "  end\n" ++
    "\n" ++
    "  def inspect\n" ++
    "    exact = self.class == Set\n" ++
    "    open = exact ? \"Set[\" : \"#<\" + self.class.to_s + \": \{\"\n" ++
    "    close = exact ? \"]\" : \"}>\"\n" ++
    "    ids = Set.__insp_ids\n" ++
    "    return open + \"...\" + close if ids[object_id]\n" ++
    "    ids[object_id] = true\n" ++
    "    begin\n" ++
    "      open + to_a.map \{ |x| x.inspect }.join(\", \") + close\n" ++
    "    ensure\n" ++
    "      ids.delete(object_id)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  alias_method :to_s, :inspect\n" ++
    "end\n" ++
    "\n" ++
    "module Enumerable\n" ++
    "  # to_set forwards its block, so `(1..3).to_set \{ |x| x * x }` is \{1, 4, 9}\n" ++
    // ⚠ ruby 4.0 DEPRECATES the arguments and says so. Only Enumerable's and
    // Range's forms warn, only when an argument is given -- a block alone is
    // not deprecated, and Set#to_set never warns. (Asked of 4.0.6; 3.4.9 says
    // nothing at all, which is why the reference has to be the pinned one.)
    "  def to_set(klass = Set, *args, &block)\n" ++
    "    unless klass == Set && args.empty?\n" ++
    "      warn(\"passing arguments to Enumerable#to_set is deprecated\", uplevel: 1)\n" ++
    "    end\n" ++
    "    klass.new(self, *args, &block)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "class Range\n" ++
    "  # ruby 4.0: Range#to_set refuses an endless range before walking it\n" ++
    "  def to_set(klass = Set, *args, &block)\n" ++
    "    raise RangeError, \"cannot convert endless range to a set\" if self.end.nil?\n" ++
    "    unless klass == Set && args.empty?\n" ++
    "      warn(\"passing arguments to Enumerable#to_set is deprecated\", uplevel: 1)\n" ++
    "    end\n" ++
    "    klass.new(self, *args, &block)\n" ++
    "  end\n" ++
    "end\n"
  // Forwardable / SingleForwardable: delegation built on define_method,
  // where CRuby's builds source strings. Same surface.
  else if str_eq n "forwardable" then
    "module Forwardable\n" ++
    "  def def_instance_delegator(accessor, method, ali = method)\n" ++
    "    accessor = accessor.to_s\n" ++
    "    define_method(ali) do |*args, &block|\n" ++
    "      target = accessor.start_with?(\"@\") ? instance_variable_get(accessor) : __send__(accessor)\n" ++
    "      target.__send__(method, *args, &block)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def def_instance_delegators(accessor, *methods)\n" ++
    "    methods.each do |m|\n" ++
    "      def_instance_delegator(accessor, m)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def instance_delegate(hash)\n" ++
    "    hash.each do |methods, accessor|\n" ++
    "      methods = [methods] unless methods.is_a?(Array)\n" ++
    "      methods.each do |m|\n" ++
    "        def_instance_delegator(accessor, m)\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "  alias_method :def_delegator, :def_instance_delegator\n" ++
    "  alias_method :def_delegators, :def_instance_delegators\n" ++
    "  alias_method :delegate, :instance_delegate\n" ++
    "end\n" ++
    "\n" ++
    "module SingleForwardable\n" ++
    "  def def_single_delegator(accessor, method, ali = method)\n" ++
    "    accessor = accessor.to_s\n" ++
    "    define_singleton_method(ali) do |*args, &block|\n" ++
    "      target = accessor.start_with?(\"@\") ? instance_variable_get(accessor) : __send__(accessor)\n" ++
    "      target.__send__(method, *args, &block)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def def_single_delegators(accessor, *methods)\n" ++
    "    methods.each do |m|\n" ++
    "      def_single_delegator(accessor, m)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  alias_method :def_delegator, :def_single_delegator\n" ++
    "  alias_method :def_delegators, :def_single_delegators\n" ++
    "end\n"
  // Singleton: the memoised instance plus the clone/dup refusals.
  else if str_eq n "singleton" then
    "module Singleton\n" ++
    "  module SingletonClassMethods\n" ++
    "    def instance\n" ++
    "      @singleton__instance__ ||= new\n" ++
    "    end\n" ++
    "    # a marshaled singleton loads back as THE instance\n" ++
    "    def _load(_str)\n" ++
    "      instance\n" ++
    "    end\n" ++
    "  end\n" ++
    "  # ...and dumps as nothing: there is no state to carry\n" ++
    "  def _dump(_depth = -1)\n" ++
    "    \"\"\n" ++
    "  end\n" ++
    "  # ⚠ new and allocate become PRIVATE on the including class: the one\n" ++
    "  # instance is the only way in. They stayed public, so `S.new` made a\n" ++
    "  # second instance of a singleton without complaint. `instance` still\n" ++
    "  # reaches `new` because it calls it on self, receiverless.\n" ++
    "  def self.included(klass)\n" ++
    "    klass.extend(SingletonClassMethods)\n" ++
    "    klass.private_class_method :new, :allocate\n" ++
    "  end\n" ++
    "  def clone\n" ++
    "    raise TypeError, \"can't clone instance of singleton \" + self.class.to_s\n" ++
    "  end\n" ++
    "  def dup\n" ++
    "    raise TypeError, \"can't dup instance of singleton \" + self.class.to_s\n" ++
    "  end\n" ++
    "end\n"
  // StringIO: a String plus a position. CRuby ships it as a C extension,
  // but nothing about it needs C.
  else if str_eq n "stringio" then
    "class StringIO\n" ++
    "  VERSION = \"3.2.0\"\n" ++
    "  MAX_LENGTH = 9223372036854775807\n" ++
    "\n" ++
    "  # ⚠ THE POSITION IS A BYTE OFFSET, as in ruby. It used to be a character\n" ++
    "  #   index, so every multibyte string disagreed: #pos after reading \"é\",\n" ++
    "  #   #getc from a position inside a character, #ungetbyte splitting one,\n" ++
    "  #   #truncate and #write past the end. Every method below indexes bytes\n" ++
    "  #   (byteslice, getbyte, bytesize) and hands out characters only where\n" ++
    "  #   ruby does (#getc, #gets, #read with no length).\n" ++
    "\n" ++
    "  attr_reader :string\n" ++
    "  # ⚠ `attr_accessor :string` gave a plain writer, so `io.string = obj`\n" ++
    "  #   stored WHATEVER it was handed. ruby converts with #to_str and refuses\n" ++
    "  #   what has none, and the assignment also RESETS the stream.\n" ++
    "  def string=(str)\n" ++
    "    str = StringIO.__to_str(str) unless str.is_a?(String)\n" ++
    "    @string = str\n" ++
    "    @pos = 0\n" ++
    "    @lineno = 0\n" ++
    "    str\n" ++
    "  end\n" ++
    "  attr_reader :pos\n" ++
    "  def internal_encoding; nil; end\n" ++
    "\n" ++
    "  # What #set_encoding named, or else the buffer's own encoding -- which\n" ++
    "  # follows the string if its encoding is changed behind the stream's back.\n" ++
    "  def external_encoding\n" ++
    "    @enc || @string.encoding\n" ++
    "  end\n" ++
    "\n" ++
    "  # Sets the buffer's encoding too, unless the buffer is frozen; the stream\n" ++
    "  # still reports the new one.\n" ++
    "  def set_encoding(ext, _int = nil, _opt = nil)\n" ++
    "    enc = if ext.nil?\n" ++
    "            Encoding.default_external\n" ++
    "          elsif ext.is_a?(Encoding)\n" ++
    "            ext\n" ++
    "          else\n" ++
    "            Encoding.find(ext.to_s.split(\":\")[0])\n" ++
    "          end\n" ++
    "    @enc = enc\n" ++
    "    @string.force_encoding(enc) if @string && !@string.frozen?\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.open(string = nil, mode = nil, **opts)\n" ++
    "    io = new(string, mode, **opts)\n" ++
    "    return io unless block_given?\n" ++
    "    begin\n" ++
    "      yield io\n" ++
    "    ensure\n" ++
    "      # ⚠ ruby DROPS the string when the block ends -- `StringIO.open(s) \{ }`\n" ++
    "      #   leaves #string nil, and the spec reads it on the raising path too.\n" ++
    "      io.close\n" ++
    "      io.__drop_string\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def __drop_string\n" ++
    "    @string = nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__to_str(obj)\n" ++
    "    unless obj.respond_to?(:to_str)\n" ++
    "      raise TypeError, \"no implicit conversion of \" + obj.class.to_s + \" into String\"\n" ++
    "    end\n" ++
    "    r = obj.to_str\n" ++
    "    unless r.is_a?(String)\n" ++
    "      raise TypeError, \"can't convert \" + obj.class.to_s + \" to String\"\n" ++
    "    end\n" ++
    "    r\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize(string = nil, mode = nil, **opts)\n" ++
    "    # ⚠ THE STRING ITSELF, not a copy of it: ruby aliases it, which is the\n" ++
    "    #   whole point of `StringIO.new(buf)`. And the conversion is #to_str,\n" ++
    "    #   not #to_s -- a wrong argument must not become a plausible buffer.\n" ++
    "    # no string at all is a new one in the default external encoding\n" ++
    "    string = (+\"\").force_encoding(Encoding.default_external) if string.nil?\n" ++
    "    @string = (string.is_a?(String) ? string : StringIO.__to_str(string))\n" ++
    "    # mode: may come as a keyword instead (both at once is an error)\n" ++
    "    if opts.key?(:mode)\n" ++
    "      raise ArgumentError, \"mode specified twice\" if !mode.nil? && !opts[:mode].nil?\n" ++
    "      mode = opts[:mode] if mode.nil?\n" ++
    "    end\n" ++
    "    @pos = 0\n" ++
    "    @lineno = 0\n" ++
    "    @closed = false\n" ++
    "    @enc = nil\n" ++
    "    mode = StringIO.__to_str(mode) unless mode.nil? || mode.is_a?(Integer) || mode.is_a?(String)\n" ++
    "    # the keyword options may not say again what the mode already says\n" ++
    "    raise ArgumentError, \"both textmode and binmode specified\" if opts[:binmode] && opts[:textmode]\n" ++
    "    if mode.is_a?(String)\n" ++
    "      flags, enc_name = mode.split(\":\", 2)\n" ++
    "      if enc_name && (opts.key?(:encoding) || opts.key?(:external_encoding) || opts.key?(:internal_encoding))\n" ++
    "        raise ArgumentError, \"encoding specified twice\"\n" ++
    "      end\n" ++
    "      raise ArgumentError, \"binmode specified twice\" if flags.include?(\"b\") && opts.key?(:binmode)\n" ++
    "      raise ArgumentError, \"textmode specified twice\" if flags.include?(\"t\") && opts.key?(:textmode)\n" ++
    "      if (flags.include?(\"b\") && opts.key?(:textmode)) || (flags.include?(\"t\") && opts.key?(:binmode))\n" ++
    "        raise ArgumentError, \"both textmode and binmode specified\"\n" ++
    "      end\n" ++
    "      mode = flags\n" ++
    "    end\n" ++
    "    if mode.is_a?(Integer)\n" ++
    "      # IO::RDONLY / WRONLY / RDWR, with APPEND and TRUNC\n" ++
    "      acc = mode & 3\n" ++
    "      @readable = acc != IO::WRONLY\n" ++
    "      @writable = acc != IO::RDONLY\n" ++
    "      @append = (mode & IO::APPEND) != 0\n" ++
    "      trunc = (mode & IO::TRUNC) != 0\n" ++
    "    else\n" ++
    "      # a frozen string is read-only when no mode says otherwise\n" ++
    "      m = mode.nil? ? (@string.frozen? ? \"r\" : \"r+\") : mode.to_s\n" ++
    "      @readable = m.start_with?(\"r\") || m.include?(\"+\")\n" ++
    "      @writable = !m.start_with?(\"r\") || m.include?(\"+\")\n" ++
    "      # ⚠ \"a\" leaves the position at 0 and sends every WRITE to the end,\n" ++
    "      #   even after a seek.\n" ++
    "      @append = m.start_with?(\"a\")\n" ++
    "      trunc = m.start_with?(\"w\")\n" ++
    "    end\n" ++
    "    # a frozen buffer cannot be opened for writing: EACCES, as a read-only\n" ++
    "    # file would be\n" ++
    "    raise Errno::EACCES if @writable && @string.frozen?\n" ++
    "    # what the stream was OPENED as, which close_read/close_write ask about --\n" ++
    "    # the flags above are the CURRENT state and a close clears them.\n" ++
    "    @readable_mode = @readable\n" ++
    "    @writable_mode = @writable\n" ++
    "    # ⚠ `StringIO.new \{ }` does not run the block; it warns and says to use\n" ++
    "    # ::open.\n" ++
    "    warn(\"warning: StringIO::new() does not take block; use StringIO::open() instead\") if block_given?\n" ++
    "    # \"w\" TRUNCATES the string it was given rather than swapping in a fresh\n" ++
    "    # one: the caller still holds the object and expects to see it emptied.\n" ++
    "    @string.replace((+\"\").force_encoding(@string.encoding)) if trunc\n" ++
    "    binmode if opts[:binmode]\n" ++
    "    set_encoding(enc_name.split(\":\")[0]) if enc_name && !enc_name.empty?\n" ++
    "  end\n" ++
    "\n" ++
    "  def close\n" ++
    "    @closed = true\n" ++
    "    @readable = false\n" ++
    "    @writable = false\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def closed?\n" ++
    "    @closed || (!@readable && !@writable)\n" ++
    "  end\n" ++
    "\n" ++
    "  def eof?\n" ++
    "    @pos >= @string.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  def size\n" ++
    "    @string.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  alias length size\n" ++
    "\n" ++
    "  def rewind\n" ++
    "    @pos = 0\n" ++
    "    @lineno = 0\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def seek(amount, whence = 0)\n" ++
    "    # the offset is a CONVERSION, as everywhere ruby takes one.\n" ++
    "    unless amount.is_a?(Integer)\n" ++
    "      unless amount.respond_to?(:to_int)\n" ++
    "        raise TypeError, \"no implicit conversion of \" + amount.class.to_s + \" into Integer\"\n" ++
    "      end\n" ++
    "      amount = amount.to_int\n" ++
    "    end\n" ++
    "    raise IOError, \"closed stream\" if closed?\n" ++
    "    whence = \{ SET: 0, CUR: 1, END: 2 }[whence] || whence if whence.is_a?(Symbol)\n" ++
    "    raise Errno::EINVAL unless whence == 0 || whence == 1 || whence == 2\n" ++
    "    np = if whence == 2\n" ++
    "           @string.bytesize + amount\n" ++
    "         elsif whence == 1\n" ++
    "           @pos + amount\n" ++
    "         else\n" ++
    "           amount\n" ++
    "         end\n" ++
    "    # ⚠ no message: this interpreter prefixes the system text itself.\n" ++
    "    raise Errno::EINVAL if np < 0\n" ++
    "    @pos = np\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  alias tell pos\n" ++
    "\n" ++
    "  # A buffer argument is filled in place (through #to_str) and keeps its\n" ++
    "  # own encoding; a frozen one is refused.\n" ++
    "  def __sio_buf(buf)\n" ++
    "    return nil if buf.nil?\n" ++
    "    buf = StringIO.__to_str(buf) unless buf.is_a?(String)\n" ++
    "    raise FrozenError, \"can't modify frozen String: \" + buf.inspect if buf.frozen?\n" ++
    "    buf\n" ++
    "  end\n" ++
    "\n" ++
    "  def __sio_len(len)\n" ++
    "    return nil if len.nil?\n" ++
    "    unless len.is_a?(Integer)\n" ++
    "      unless len.respond_to?(:to_int)\n" ++
    "        raise TypeError, \"no implicit conversion of \" + len.class.to_s + \" into Integer\"\n" ++
    "      end\n" ++
    "      len = len.to_int\n" ++
    "    end\n" ++
    "    raise ArgumentError, \"negative length \" + len.to_s + \" given\" if len < 0\n" ++
    "    len\n" ++
    "  end\n" ++
    "\n" ++
    "  # #read with a length answers BYTES (a binary string, nil at the end);\n" ++
    "  # without one, the rest of the buffer in its own encoding (\"\" at the end).\n" ++
    "  def read(len = nil, buf = nil)\n" ++
    "    __sio_check_read\n" ++
    "    len = __sio_len(len)\n" ++
    "    buf = __sio_buf(buf)\n" ++
    "    total = @string.bytesize\n" ++
    "    if len.nil?\n" ++
    "      part = @pos >= total ? (+\"\").force_encoding(external_encoding) : @string.byteslice(@pos, total - @pos).force_encoding(external_encoding)\n" ++
    "      @pos = total if @pos < total\n" ++
    "    else\n" ++
    "      if len == 0\n" ++
    "        part = \"\".b\n" ++
    "      elsif @pos >= total\n" ++
    "        buf.replace((+\"\").force_encoding(buf.encoding)) if buf\n" ++
    "        return nil\n" ++
    "      else\n" ++
    "        part = @string.byteslice(@pos, len).b\n" ++
    "        @pos += part.bytesize\n" ++
    "      end\n" ++
    "    end\n" ++
    "    return part unless buf\n" ++
    "    enc = buf.encoding\n" ++
    "    buf.replace(part)\n" ++
    "    buf.force_encoding(enc)\n" ++
    "    buf\n" ++
    "  end\n" ++
    "\n" ++
    "  # The character boundary at or after byte `i`: a limit never splits one.\n" ++
    "  def __sio_char_end(i)\n" ++
    "    total = @string.bytesize\n" ++
    "    return total if i >= total\n" ++
    "    return i unless @string.encoding == Encoding::UTF_8\n" ++
    "    i += 1 while i < total && (@string.getbyte(i) & 0xC0) == 0x80\n" ++
    "    i\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ gets takes a LIMIT as well as a separator -- gets(3), gets(sep, 3) --\n" ++
    "  # and a chomp: keyword. The limit counts bytes, rounded up to the end of\n" ++
    "  # the character it lands in.\n" ++
    "  def gets(sep = $/, limit = nil, chomp: false)\n" ++
    "    $_ = __sio_getline(sep, limit, chomp)\n" ++
    "  end\n" ++
    "\n" ++
    "  # A separator is a String (through #to_str) or, in its place, a limit\n" ++
    "  # (through #to_int); #readlines and #each_line read lines here too, and\n" ++
    "  # only #gets sets $_.\n" ++
    "  def __sio_getline(sep, limit, chomp)\n" ++
    "    __sio_check_read\n" ++
    "    unless sep.nil? || sep.is_a?(String)\n" ++
    "      if sep.is_a?(Integer)\n" ++
    "        limit = sep\n" ++
    "        sep = $/\n" ++
    "      elsif sep.respond_to?(:to_str)\n" ++
    "        sep = sep.to_str\n" ++
    "      elsif sep.respond_to?(:to_int)\n" ++
    "        limit = sep.to_int\n" ++
    "        sep = $/\n" ++
    "      else\n" ++
    "        raise TypeError, \"no implicit conversion of \" + sep.class.to_s + \" into String\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "    unless limit.nil? || limit.is_a?(Integer)\n" ++
    "      raise TypeError, \"no implicit conversion of \" + limit.class.to_s + \" into Integer\" unless limit.respond_to?(:to_int)\n" ++
    "      limit = limit.to_int\n" ++
    "    end\n" ++
    "    limit = nil if limit && limit < 0\n" ++
    "    return nil if eof?\n" ++
    "    return (+\"\").force_encoding(external_encoding) if limit == 0\n" ++
    "    total = @string.bytesize\n" ++
    "    if sep.nil?\n" ++
    "      stop = total\n" ++
    "    else\n" ++
    "      paragraph = sep == \"\"\n" ++
    "      sep = \"\\n\\n\" if paragraph\n" ++
    "      if paragraph\n" ++
    "        @pos += 1 while @pos < total && @string.getbyte(@pos) == 10\n" ++
    "        return nil if @pos >= total\n" ++
    "      end\n" ++
    "      idx = begin\n" ++
    "              @string.byteindex(sep, @pos)\n" ++
    "            rescue IndexError\n" ++
    "              # a position inside a character: search the bytes instead\n" ++
    "              @string.b.byteindex(sep.b, @pos)\n" ++
    "            end\n" ++
    "      stop = idx.nil? ? total : idx + sep.bytesize\n" ++
    "      if paragraph && idx\n" ++
    "        stop += 1 while stop < total && @string.getbyte(stop) == 10\n" ++
    "      end\n" ++
    "    end\n" ++
    "    stop = __sio_char_end(@pos + limit) if limit && @pos + limit < stop\n" ++
    "    line = @string.byteslice(@pos, stop - @pos).force_encoding(external_encoding)\n" ++
    "    @pos = stop\n" ++
    "    @lineno += 1\n" ++
    "    line = __sio_chomp(line, paragraph ? \"\\n\\n\" : sep) if chomp && sep\n" ++
    "    $. = @lineno\n" ++
    "    line\n" ++
    "  end\n" ++
    "\n" ++
    "  def __sio_chomp(line, sep)\n" ++
    "    return line.chomp if sep == \"\\n\"\n" ++
    "    return line.sub(/\\n+\\z/, \"\") if sep == \"\\n\\n\"\n" ++
    "    line.end_with?(sep) ? line[0, line.length - sep.length] : line\n" ++
    "  end\n" ++
    "\n" ++
    "  def readlines(sep = $/, limit = nil, chomp: false)\n" ++
    "    raise ArgumentError, \"invalid limit: 0 for readlines\" if limit == 0 || (sep.is_a?(Integer) && sep == 0)\n" ++
    "    out = []\n" ++
    "    while (line = __sio_getline(sep, limit, chomp))\n" ++
    "      out.push(line)\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  def each_line(sep = $/, limit = nil, chomp: false)\n" ++
    "    return to_enum(:each_line, sep, limit, chomp: chomp) unless block_given?\n" ++
    "    raise ArgumentError, \"invalid limit: 0 for each_line\" if limit == 0 || (sep.is_a?(Integer) && sep == 0)\n" ++
    "    while (line = __sio_getline(sep, limit, chomp))\n" ++
    "      yield line\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  alias each each_line\n" ++
    "\n" ++
    "  # One CHARACTER from the byte position -- or one byte, when the position\n" ++
    "  # is inside a character or the bytes there are not one.\n" ++
    "  def getc\n" ++
    "    __sio_check_read\n" ++
    "    return nil if eof?\n" ++
    "    ch = @string.byteslice(@pos, 4).force_encoding(external_encoding)[0]\n" ++
    "    @pos += ch.bytesize\n" ++
    "    ch\n" ++
    "  end\n" ++
    "\n" ++
    "  # Pushes back before the position: over the bytes just read when there\n" ++
    "  # are enough of them, otherwise in front of what is left (a position past\n" ++
    "  # the end is padded with NULs first).\n" ++
    "  def __sio_unget(s)\n" ++
    "    if @pos > @string.bytesize\n" ++
    "      @string.replace((@string.b + (\"\\0\" * (@pos - @string.bytesize))).force_encoding(@string.encoding))\n" ++
    "    end\n" ++
    "    n = s.bytesize\n" ++
    "    enc = @string.encoding\n" ++
    "    if n <= @pos\n" ++
    "      head = @string.byteslice(0, @pos - n).b\n" ++
    "      tail = @string.byteslice(@pos, @string.bytesize - @pos).b\n" ++
    "      @string.replace((head + s.b + tail).force_encoding(enc))\n" ++
    "      @pos -= n\n" ++
    "    else\n" ++
    "      tail = @string.byteslice(@pos, @string.bytesize - @pos).b\n" ++
    "      @string.replace((s.b + tail).force_encoding(enc))\n" ++
    "      @pos = 0\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def ungetc(c)\n" ++
    "    __sio_check_read\n" ++
    "    return nil if c.nil?\n" ++
    "    c = c.is_a?(Integer) ? c.chr(external_encoding) : StringIO.__to_str(c)\n" ++
    "    __sio_unget(c)\n" ++
    "  end\n" ++
    "\n" ++
    "  # at position 0 this PREPENDS; anywhere else it overwrites the bytes ending\n" ++
    "  # at the position and moves back over them.\n" ++
    "  def ungetbyte(b)\n" ++
    "    return nil if b.nil?\n" ++
    "    __sio_check_read\n" ++
    "    s = b.is_a?(Integer) ? (b & 255).chr : b.to_s\n" ++
    "    __sio_unget(s)\n" ++
    "  end\n" ++
    "\n" ++
    "  def write(*args)\n" ++
    "    __sio_check_write\n" ++
    "    n = 0\n" ++
    "    args.each do |a|\n" ++
    "      s = a.to_s\n" ++
    "      enc = @string.encoding\n" ++
    "      # ⚠ into the stream's encoding, as strio_write converts: a UTF-8\n" ++
    "      # \"hello\" written to a UTF-16BE stream was stored as its UTF-8 bytes.\n" ++
    "      # BINARY and US-ASCII on either side mean the bytes are taken as they are.\n" ++
    "      xe = external_encoding\n" ++
    "      if xe != Encoding::BINARY && xe != Encoding::US_ASCII &&\n" ++
    "         s.encoding != xe && s.encoding != Encoding::BINARY && s.encoding != Encoding::US_ASCII\n" ++
    "        s = begin\n" ++
    "              s.encode(xe)\n" ++
    "            rescue EncodingError\n" ++
    "              s\n" ++
    "            end\n" ++
    "      end\n" ++
    "      @pos = @string.bytesize if @append\n" ++
    "      size = @string.bytesize\n" ++
    "      head = @string.byteslice(0, @pos < size ? @pos : size).b\n" ++
    "      head << (\"\\0\" * (@pos - size)) if @pos > size\n" ++
    "      rest_at = @pos + s.bytesize\n" ++
    "      tail = rest_at < size ? @string.byteslice(rest_at, size - rest_at).b : \"\".b\n" ++
    "      @string.replace((head + s.b + tail).force_encoding(enc))\n" ++
    "      @pos += s.bytesize\n" ++
    "      n += s.bytesize\n" ++
    "    end\n" ++
    "    n\n" ++
    "  end\n" ++
    "\n" ++
    "  def <<(obj)\n" ++
    "    write(obj)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # With no arguments #print writes $_; $, goes between the arguments and\n" ++
    "  # $\\ after them, as IO#print does.\n" ++
    "  def print(*args)\n" ++
    "    args = [$_] if args.empty?\n" ++
    "    args.each_with_index do |a, i|\n" ++
    "      write($,) if $, && i > 0\n" ++
    "      write(a)\n" ++
    "    end\n" ++
    "    write($\\) if $\\\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # An array that contains itself is written as [...], as IO#puts does;\n" ++
    "  # following it went down forever.\n" ++
    "  def puts(*args)\n" ++
    "    __sio_puts(args, \{})\n" ++
    "  end\n" ++
    "\n" ++
    "  def __sio_puts(args, seen)\n" ++
    "    if args.empty?\n" ++
    "      write(\"\\n\")\n" ++
    "      return nil\n" ++
    "    end\n" ++
    "    args.each do |a|\n" ++
    "      unless a.is_a?(Array) || a.is_a?(String) || !a.respond_to?(:to_ary)\n" ++
    "        ary = a.to_ary\n" ++
    "        a = ary if ary.is_a?(Array)\n" ++
    "      end\n" ++
    "      if a.is_a?(Array)\n" ++
    "        if seen[a.__id__]\n" ++
    "          write(\"[...]\\n\")\n" ++
    "          next\n" ++
    "        end\n" ++
    "        seen[a.__id__] = true\n" ++
    "        __sio_puts(a, seen)\n" ++
    "        seen.delete(a.__id__)\n" ++
    "      else\n" ++
    "        s = a.to_s\n" ++
    "        # a #to_s that is not a String is replaced by the default one\n" ++
    "        s = format(\"#<%s:0x%016x>\", a.class.to_s, a.__id__) unless s.is_a?(String)\n" ++
    "        write(s)\n" ++
    "        write(\"\\n\") unless s.end_with?(\"\\n\")\n" ++
    "      end\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def printf(fmt, *args)\n" ++
    "    write(format(fmt, *args))\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # Bytes, and growing pads with NULs.\n" ++
    "  def truncate(len)\n" ++
    "    __sio_check_write\n" ++
    "    unless len.is_a?(Integer)\n" ++
    "      raise TypeError, \"no implicit conversion of \" + len.class.to_s + \" into Integer\" unless len.respond_to?(:to_int)\n" ++
    "      len = len.to_int\n" ++
    "    end\n" ++
    "    raise Errno::EINVAL, \"negative length\" if len < 0\n" ++
    "    size = @string.bytesize\n" ++
    "    enc = @string.encoding\n" ++
    "    if len < size\n" ++
    "      @string.replace(@string.byteslice(0, len).force_encoding(enc))\n" ++
    "    else\n" ++
    "      @string.replace((@string.b + (\"\\0\" * (len - size))).force_encoding(enc))\n" ++
    "    end\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def flush\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def sync\n" ++
    "    true\n" ++
    "  end\n" ++
    "\n" ++
    "  def sync=(v)\n" ++
    "    v\n" ++
    "  end\n" ++
    "\n" ++
    "  def tty?\n" ++
    "    false\n" ++
    "  end\n" ++
    "\n" ++
    "  alias isatty tty?\n" ++
    "\n" ++
    "  def fileno\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # Everything below was measured against the reference ruby rather than\n" ++
    "  # guessed from the name. Two surprises: #putc returns its ARGUMENT (not the\n" ++
    "  # byte written), and #lineno counts calls to #gets -- so readline, readlines\n" ++
    "  # and each_line advance it, and #getc does not.\n" ++
    "\n" ++
    "  def __sio_check_read\n" ++
    "    raise IOError, \"not opened for reading\" unless @readable\n" ++
    "  end\n" ++
    "\n" ++
    "  def __sio_check_write\n" ++
    "    raise IOError, \"not opened for writing\" unless @writable\n" ++
    "  end\n" ++
    "  private :__sio_check_read\n" ++
    "  private :__sio_check_write\n" ++
    "\n" ++
    "  def fsync\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def pid\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def fcntl(*a)\n" ++
    "    raise NotImplementedError, \"fcntl() function is unimplemented on this machine\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def closed_read?\n" ++
    "    !@readable\n" ++
    "  end\n" ++
    "\n" ++
    "  def closed_write?\n" ++
    "    !@writable\n" ++
    "  end\n" ++
    "\n" ++
    "  def lineno\n" ++
    "    @lineno\n" ++
    "  end\n" ++
    "\n" ++
    "  def lineno=(n)\n" ++
    "    @lineno = n\n" ++
    "  end\n" ++
    "\n" ++
    "  def getbyte\n" ++
    "    __sio_check_read\n" ++
    "    return nil if @pos >= @string.bytesize\n" ++
    "    b = @string.getbyte(@pos)\n" ++
    "    @pos += 1\n" ++
    "    b\n" ++
    "  end\n" ++
    "\n" ++
    "  def readbyte\n" ++
    "    b = getbyte\n" ++
    "    raise EOFError, \"end of file reached\" if b.nil?\n" ++
    "    b\n" ++
    "  end\n" ++
    "\n" ++
    "  def readchar\n" ++
    "    c = getc\n" ++
    "    raise EOFError, \"end of file reached\" if c.nil?\n" ++
    "    c\n" ++
    "  end\n" ++
    "\n" ++
    "  def readline(sep = $/, limit = nil, chomp: false)\n" ++
    "    l = gets(sep, limit, chomp: chomp)\n" ++
    "    raise EOFError, \"end of file reached\" if l.nil?\n" ++
    "    l\n" ++
    "  end\n" ++
    "\n" ++
    "  def each_byte\n" ++
    "    __sio_check_read\n" ++
    "    return to_enum(:each_byte) unless block_given?\n" ++
    "    while (b = getbyte)\n" ++
    "      yield b\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def each_char\n" ++
    "    __sio_check_read\n" ++
    "    return to_enum(:each_char) unless block_given?\n" ++
    "    while (c = getc)\n" ++
    "      yield c\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # from the position; a broken sequence is ArgumentError, as String#ord says\n" ++
    "  def each_codepoint\n" ++
    "    return to_enum(:each_codepoint) unless block_given?\n" ++
    "    __sio_check_read\n" ++
    "    while (c = getc)\n" ++
    "      yield c.ord\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def putc(obj)\n" ++
    "    __sio_check_write\n" ++
    "    s = if obj.is_a?(String)\n" ++
    "          obj[0, 1]\n" ++
    "        elsif obj.is_a?(Integer)\n" ++
    "          (obj & 255).chr\n" ++
    "        elsif obj.respond_to?(:to_int)\n" ++
    "          (obj.to_int & 255).chr\n" ++
    "        else\n" ++
    "          raise TypeError, \"no implicit conversion of \" + obj.class.to_s + \" into Integer\"\n" ++
    "        end\n" ++
    "    write(s)\n" ++
    "    obj\n" ++
    "  end\n" ++
    "\n" ++
    "  def sysread(len = nil, buf = nil)\n" ++
    "    __sio_check_read\n" ++
    "    len = __sio_len(len)\n" ++
    "    if len == 0\n" ++
    "      buf = __sio_buf(buf)\n" ++
    "      buf&.replace(\"\")\n" ++
    "      return buf || \"\"\n" ++
    "    end\n" ++
    "    # at the end, a LENGTH asked for is EOFError; no length reads \"\"\n" ++
    "    if eof? && !len.nil?\n" ++
    "      buf = __sio_buf(buf)\n" ++
    "      buf&.replace(\"\")\n" ++
    "      raise EOFError, \"end of file reached\"\n" ++
    "    end\n" ++
    "    read(len, buf)\n" ++
    "  end\n" ++
    "\n" ++
    "  alias readpartial sysread\n" ++
    "\n" ++
    "  # one String (converted with #to_s), and the byte count, as #write\n" ++
    "  def syswrite(s) = write(s)\n" ++
    "\n" ++
    "  # exception: false answers nil at the end instead of raising EOFError\n" ++
    "  def read_nonblock(len = nil, buf = nil, exception: true)\n" ++
    "    return nil if !exception && len != 0 && eof?\n" ++
    "    sysread(len, buf)\n" ++
    "  end\n" ++
    "\n" ++
    "  def write_nonblock(s, exception: true)\n" ++
    "    write(s)\n" ++
    "  end\n" ++
    "\n" ++
    "  def reopen(other = nil, mode = nil)\n" ++
    "    other = other.to_strio if mode.nil? && !other.nil? && !other.is_a?(String) && !other.is_a?(StringIO) && other.respond_to?(:to_strio)\n" ++
    "    if other.is_a?(StringIO)\n" ++
    "      @string = other.string\n" ++
    "      @readable = other.__sio_readable\n" ++
    "      @writable = other.__sio_writable\n" ++
    "      @readable_mode = @readable\n" ++
    "      @writable_mode = @writable\n" ++
    "      @append = false\n" ++
    "      @pos = other.pos\n" ++
    "      @lineno = other.lineno\n" ++
    "      @closed = false\n" ++
    "      return self\n" ++
    "    end\n" ++
    "    initialize(other.nil? ? +\"\" : other, mode)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def __sio_readable = @readable\n" ++
    "  def __sio_writable = @writable\n" ++
    "\n" ++
    "  # A byte-order mark picks the encoding and is stepped over. UTF-32LE's\n" ++
    "  # mark begins with UTF-16LE's, so it is asked first.\n" ++
    "  def set_encoding_by_bom\n" ++
    "    raise FrozenError, \"can't modify frozen StringIO: \" + inspect if frozen?\n" ++
    "    return nil unless @readable\n" ++
    "    b = @string.byteslice(0, 4).bytes\n" ++
    "    enc, len =\n" ++
    "      if b[0, 3] == [0xEF, 0xBB, 0xBF] then [Encoding::UTF_8, 3]\n" ++
    "      elsif b == [0xFF, 0xFE, 0, 0] then [Encoding::UTF_32LE, 4]\n" ++
    "      elsif b == [0, 0, 0xFE, 0xFF] then [Encoding::UTF_32BE, 4]\n" ++
    "      elsif b[0, 2] == [0xFF, 0xFE] then [Encoding::UTF_16LE, 2]\n" ++
    "      elsif b[0, 2] == [0xFE, 0xFF] then [Encoding::UTF_16BE, 2]\n" ++
    "      else [nil, 0]\n" ++
    "      end\n" ++
    "    return nil unless enc\n" ++
    "    set_encoding(enc)\n" ++
    "    @pos = len\n" ++
    "    enc\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby's StringIO has no instance variables to show: its inspect is to_s\n" ++
    "  def inspect\n" ++
    "    to_s\n" ++
    "  end\n" ++
    "end\n" ++
    "class StringIO\n" ++
    "  # ruby's StringIO includes Enumerable, and `StringIO.include?(Enumerable)` is\n" ++
    "  # a spec of its own.\n" ++
    "  include Enumerable\n" ++
    "\n" ++
    "  # `binmode` puts the buffer into ASCII-8BIT, which is what\n" ++
    "  # `external_encoding` reports afterwards.\n" ++
    "  def binmode\n" ++
    "    @enc = Encoding::BINARY\n" ++
    "    @string.force_encoding(Encoding::BINARY) unless @string.frozen?\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # A negative position is EINVAL. StringIO is not a String: there is no\n" ++
    "  # counting from the end here.\n" ++
    "  def pos=(n)\n" ++
    "    n = n.to_int if !n.is_a?(Integer) && n.respond_to?(:to_int)\n" ++
    "    raise Errno::EINVAL if n < 0\n" ++
    "    @pos = n\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ `eof` must BE `eof?`, not call it: the spec compares the two\n" ++
    "  # UnboundMethods.\n" ++
    "  alias_method :eof, :eof?\n" ++
    "\n" ++
    "  # Closing a side is about the MODE it was opened with, and closing it twice\n" ++
    "  # is not an error.\n" ++
    "  def close_read\n" ++
    "    raise IOError, \"closing non-duplex IO for reading\" unless __opened_readable?\n" ++
    "    @readable = false\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def close_write\n" ++
    "    raise IOError, \"closing non-duplex IO for writing\" unless __opened_writable?\n" ++
    "    @writable = false\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def __opened_readable? = @readable_mode\n" ++
    "  def __opened_writable? = @writable_mode\n" ++
    "  private :__opened_readable?, :__opened_writable?\n" ++
    "end\n"
  else if str_eq n "strscan" then
    "class StringScanner\n" ++
    "  # the reference's version: specs choose their examples by it\n" ++
    "  # (`version_is StringScanner::Version, \"3.1.1\"`), and a missing\n" ++
    "  # constant killed the whole file before one example ran\n" ++
    "  Version = \"3.1.6\"\n" ++
    "  Id = \"$Id$\"\n" ++
    "  attr_reader :string\n" ++
    "\n" ++
    "  def initialize(string, _dup = false, fixed_anchor: false)\n" ++
    "    # ⚠ #to_str, not #to_s. `to_s` accepts ANY object and turns it into its\n" ++
    "    #   inspect form, so `StringScanner.new(obj)` scanned the text\n" ++
    "    #   \"#<Obj:0x...>\" instead of refusing -- a wrong argument became a\n" ++
    "    #   plausible subject.\n" ++
    "    unless string.is_a?(String)\n" ++
    "      unless string.respond_to?(:to_str)\n" ++
    "        raise TypeError, \"no implicit conversion of \" + string.class.to_s + \" into String\"\n" ++
    "      end\n" ++
    "      string = string.to_str\n" ++
    "    end\n" ++
    "    @string = string\n" ++
    "    __measure\n" ++
    "    @pos = 0\n" ++
    "    @cp = 0\n" ++
    "    @matched = nil\n" ++
    "    @md = nil\n" ++
    "    @prev_pos = 0\n" ++
    "    @prev_cp = 0\n" ++
    "    @fixed = fixed_anchor ? true : false\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ THE POINTER IS A BYTE OFFSET, as ruby's is. It counted characters, with\n" ++
    "  #   the byte view computed at #pos and #pos= -- and a byte offset inside a\n" ++
    "  #   character is exactly what that model cannot hold: `pos = 1` on \"∂\"\n" ++
    "  #   refused with RangeError, and scan_byte through \"あ\" consumed the whole\n" ++
    "  #   character at once (227, then nil). ruby's scanner is a byte cursor\n" ++
    "  #   that also knows the character index when it is on a boundary.\n" ++
    "  #   So @pos is the bytes and @cp the characters, kept in step as a match\n" ++
    "  #   advances; @cp is nil while the pointer sits inside a character (after\n" ++
    "  #   #pos= or a byte read), and is worked out again when it is asked for.\n" ++
    "  #   The matching engine takes a CHARACTER position, which is why @cp\n" ++
    "  #   exists: matching in place at it is the fast path (see __at).\n" ++
    "  # the subject does not change while it is being scanned, and String#length\n" ++
    "  # walks the whole string, so ask once (and again when #concat grows it).\n" ++
    "  def __measure\n" ++
    "    @len = @string.length\n" ++
    "    @blen = @string.bytesize\n" ++
    "  end\n" ++
    "  private :__measure\n" ++
    "\n" ++
    "  # the character index of the pointer, nil when it is inside a character\n" ++
    "  def __cp\n" ++
    "    return @cp if @cp\n" ++
    "    head = @string.byteslice(0, @pos)\n" ++
    "    tail = @string.byteslice(@pos, @blen - @pos)\n" ++
    "    # a boundary splits no character: the two halves count what the whole does\n" ++
    "    @cp = head.length if head.length + tail.length == @len\n" ++
    "    @cp\n" ++
    "  end\n" ++
    "  private :__cp\n" ++
    "\n" ++
    "  def pos\n" ++
    "    @pos\n" ++
    "  end\n" ++
    "  alias_method :pointer, :pos\n" ++
    "\n" ++
    "  def pos=(n)\n" ++
    "    n = n.to_int if !n.is_a?(Integer) && n.respond_to?(:to_int)\n" ++
    "    n += @blen if n < 0\n" ++
    "    raise RangeError, \"index out of range\" if n < 0 || n > @blen\n" ++
    "    @pos = n\n" ++
    "    @cp = nil\n" ++
    "    n\n" ++
    "  end\n" ++
    "  alias_method :pointer=, :pos=\n" ++
    "\n" ++
    "  # (inside a character it counts the partial one, as the reference does)\n" ++
    "  def charpos\n" ++
    "    __cp || @string.byteslice(0, @pos).length\n" ++
    "  end\n" ++
    "\n" ++
    "  def reset\n" ++
    "    @pos = 0\n" ++
    "    @cp = 0\n" ++
    "    @matched = nil\n" ++
    "    @md = nil\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def terminate\n" ++
    "    @pos = @blen\n" ++
    "    @cp = @len\n" ++
    "    @matched = nil\n" ++
    "    @md = nil\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def eos?\n" ++
    "    @pos >= @blen\n" ++
    "  end\n" ++
    "\n" ++
    "  def rest\n" ++
    "    @string.byteslice(@pos, @blen - @pos) || \"\"\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby: \"rest_size is equivalent to rest.bytesize\"\n" ++
    "  def rest_size\n" ++
    "    @blen - @pos\n" ++
    "  end\n" ++
    "\n" ++
    "  def matched\n" ++
    "    @matched\n" ++
    "  end\n" ++
    "\n" ++
    "  def matched?\n" ++
    "    !@matched.nil?\n" ++
    "  end\n" ++
    "\n" ++
    "  def matched_size\n" ++
    "    @matched.nil? ? nil : @matched.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  # both nil until something matched, and both measured from the match\n" ++
    "  # itself -- after #check the pointer has not moved but the match has\n" ++
    "  def pre_match\n" ++
    "    return nil if @matched.nil?\n" ++
    "    @string.byteslice(0, @mstart)\n" ++
    "  end\n" ++
    "\n" ++
    "  def post_match\n" ++
    "    return nil if @matched.nil?\n" ++
    "    @string.byteslice(@mend, @blen - @mend)\n" ++
    "  end\n" ++
    "\n" ++
    "  # \\G, not \\A: the match happens AT the pointer inside the whole subject.\n" ++
    "  # With \\A the pattern could only be tried against a fresh string, which\n" ++
    "  # is what `rest` was for -- and `rest` copies everything left to scan, so\n" ++
    "  # one scan per token over an N-byte input was O(N^2). CSV.parse on quoted\n" ++
    "  # input spent 6.2 s on 400 rows and 49 s on 1200 because of this.\n" ++
    "  # ⚠ WITH THE PATTERN'S OWN FLAGS: rebuilding it from #source alone\n" ++
    "  #   dropped /i, /m and /x, so `scan(/ab/i)` failed on \"AB\".\n" ++
    "  # The rebuilt pattern is kept per pattern -- compiling it on every token\n" ++
    "  # was the other half of the cost above.\n" ++
    "  def anchored(re)\n" ++
    "    @__anch ||= \{}\n" ++
    "    @__anch[re] ||= Regexp.new(\"\\\\G(?:\" + re.source + \")\", re.options)\n" ++
    "  end\n" ++
    "  private :anchored\n" ++
    "\n" ++
    "  # a pattern is a Regexp or a String (matched as itself); nothing else\n" ++
    "  def __pat(re)\n" ++
    "    return re if re.is_a?(Regexp)\n" ++
    "    return Regexp.new(Regexp.escape(re)) if re.is_a?(String)\n" ++
    "    raise TypeError, \"no implicit conversion of \" + (re.nil? ? \"nil\" : re.class.to_s) + \" into String\"\n" ++
    "  end\n" ++
    "  private :__pat\n" ++
    "\n" ++
    "  # Without fixed_anchor (the default), \\A, ^ and a look-behind see the scan\n" ++
    "  # pointer as the start of the string: such a pattern is tried against the\n" ++
    "  # rest. So is any pattern while the pointer is inside a character, where\n" ++
    "  # there is no character position to match at. Everything else matches in\n" ++
    "  # place, which is what fixed_anchor means and is the fast path.\n" ++
    "  def __on_rest?(re)\n" ++
    "    return true if __cp.nil?\n" ++
    "    !@fixed && (re.source.include?(\"\\\\A\") || re.source.include?(\"^\") || re.source.include?(\"(?<\"))\n" ++
    "  end\n" ++
    "  private :__on_rest?\n" ++
    "\n" ++
    "  # The match of `re` at the pointer (`anchor`) or anywhere after it, as\n" ++
    "  # [MatchData, byte start, byte end, character end or nil]; nil for none.\n" ++
    "  def __at(re, anchor)\n" ++
    "    re = __pat(re)\n" ++
    "    if __on_rest?(re)\n" ++
    "      @__rest ||= \{}\n" ++
    "      key = [re, anchor]\n" ++
    "      r2 = (@__rest[key] ||= anchor ? Regexp.new(\"\\\\A(?:\" + re.source + \")\", re.options) : re)\n" ++
    "      m = r2.match(rest)\n" ++
    "      return nil if m.nil?\n" ++
    "      bs, be = m.byteoffset(0)\n" ++
    "      [m, @pos + bs, @pos + be, @cp && (@cp + m.end(0))]\n" ++
    "    else\n" ++
    "      m = (anchor ? anchored(re) : re).match(@string, @cp)\n" ++
    "      return nil if m.nil?\n" ++
    "      bs, be = m.byteoffset(0)\n" ++
    "      [m, bs, be, m.end(0)]\n" ++
    "    end\n" ++
    "  end\n" ++
    "  private :__at\n" ++
    "\n" ++
    "  # A regexp match took place: it is the last match, whatever the pattern\n" ++
    "  # was written as -- but only a Regexp has groups to name (@rx).\n" ++
    "  def __took(hit, re, advance)\n" ++
    "    m, bs, be, ce = hit\n" ++
    "    @md = m\n" ++
    "    @rx = re.is_a?(Regexp)\n" ++
    "    @matched = m[0]\n" ++
    "    @mstart = bs\n" ++
    "    @mend = be\n" ++
    "    if advance\n" ++
    "      @prev_pos = @pos\n" ++
    "      @prev_cp = @cp\n" ++
    "      @pos = be\n" ++
    "      @cp = ce\n" ++
    "    end\n" ++
    "  end\n" ++
    "  private :__took\n" ++
    "\n" ++
    "  def __miss\n" ++
    "    @md = nil\n" ++
    "    @matched = nil\n" ++
    "  end\n" ++
    "  private :__miss\n" ++
    "\n" ++
    "  def scan(re)\n" ++
    "    hit = __at(re, true)\n" ++
    "    return __miss if hit.nil?\n" ++
    "    __took(hit, re, true)\n" ++
    "    @matched\n" ++
    "  end\n" ++
    "\n" ++
    "  def check(re)\n" ++
    "    hit = __at(re, true)\n" ++
    "    return __miss if hit.nil?\n" ++
    "    __took(hit, re, false)\n" ++
    "    @matched\n" ++
    "  end\n" ++
    "\n" ++
    "  def match?(re)\n" ++
    "    hit = __at(re, true)\n" ++
    "    return __miss if hit.nil?\n" ++
    "    __took(hit, re, false)\n" ++
    "    @matched.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  def skip(re)\n" ++
    "    s = scan(re)\n" ++
    "    s.nil? ? nil : s.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  # A one-character (or one-byte) read is a match too -- of that text, with\n" ++
    "  # no groups: `s[0]` is what it read and `s[:name]` is refused.\n" ++
    "  def __took_text(t)\n" ++
    "    @md = nil\n" ++
    "    @rx = false\n" ++
    "    @prev_pos = @pos\n" ++
    "    @prev_cp = @cp\n" ++
    "    @matched = t\n" ++
    "    @mstart = @pos\n" ++
    "    @pos += t.bytesize\n" ++
    "    @mend = @pos\n" ++
    "  end\n" ++
    "  private :__took_text\n" ++
    "\n" ++
    "  # The groups of the last match, by index or by name (a lexer built on\n" ++
    "  # StringScanner reads its groups this way). After a match that was not a\n" ++
    "  # Regexp's -- a String pattern, getch, get_byte -- there is one group, the\n" ++
    "  # matched text, and no names: ruby refuses a name then (IndexError).\n" ++
    "  def [](i)\n" ++
    "    return nil if @matched.nil?\n" ++
    "    if i.is_a?(Symbol) || i.is_a?(String)\n" ++
    "      raise IndexError, \"undefined group name reference: #\{i}\" unless @rx\n" ++
    "      return @md[i]\n" ++
    "    end\n" ++
    "    i = StringScanner.__idx(i)\n" ++
    "    return @md[i] if @rx\n" ++
    "    (i == 0 || i == -1) ? @matched : nil\n" ++
    "  end\n" ++
    "  def self.__idx(i)\n" ++
    "    return i if i.is_a?(Integer) || i.is_a?(String) || i.is_a?(Symbol)\n" ++
    "    unless i.respond_to?(:to_int)\n" ++
    "      raise TypeError, \"no implicit conversion of \" + i.class.to_s + \" into Integer\"\n" ++
    "    end\n" ++
    "    i.to_int\n" ++
    "  end\n" ++
    "  def captures\n" ++
    "    return nil if @matched.nil?\n" ++
    "    @rx ? @md.captures : []\n" ++
    "  end\n" ++
    "  def values_at(*ix)\n" ++
    "    return nil if @matched.nil?\n" ++
    "    ix.map do |i|\n" ++
    "      self[StringScanner.__idx(i)]\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def size\n" ++
    "    return nil if @matched.nil?\n" ++
    "    @rx ? @md.size : 1\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- searching ----------------------------------------------------------\n" ++
    "  # the shared worker: everything from the pointer through the END of the\n" ++
    "  # first match of `re`, leaving the pointer there. The span comes from the\n" ++
    "  # MatchData rather than from `r.index(m[0])`, which found the FIRST\n" ++
    "  # occurrence of the matched text, not the position it was matched at.\n" ++
    "  def __search(re)\n" ++
    "    hit = __at(re, false)\n" ++
    "    return __miss if hit.nil?\n" ++
    "    start = @pos\n" ++
    "    __took(hit, re, true)\n" ++
    "    @string.byteslice(start, @pos - start)\n" ++
    "  end\n" ++
    "  private :__search\n" ++
    "\n" ++
    "  def scan_until(re)\n" ++
    "    __search(re)\n" ++
    "  end\n" ++
    "\n" ++
    "  def skip_until(re)\n" ++
    "    s = scan_until(re)\n" ++
    "    s.nil? ? nil : s.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  def check_until(re)\n" ++
    "    saved = [@pos, @cp]\n" ++
    "    r = __search(re)\n" ++
    "    @pos, @cp = saved\n" ++
    "    r\n" ++
    "  end\n" ++
    "\n" ++
    "  def exist?(re)\n" ++
    "    saved = [@pos, @cp]\n" ++
    "    r = __search(re)\n" ++
    "    @pos, @cp = saved\n" ++
    "    r.nil? ? nil : r.bytesize\n" ++
    "  end\n" ++
    "\n" ++
    "  # one CHARACTER of the subject's own encoding (a byte, inside one)\n" ++
    "  def getch\n" ++
    "    return nil if eos?\n" ++
    "    cp = __cp\n" ++
    "    c = cp ? @string[cp, 1] : @string.byteslice(@pos, 1)\n" ++
    "    __took_text(c)\n" ++
    "    @cp = cp && cp + 1\n" ++
    "    @matched\n" ++
    "  end\n" ++
    "\n" ++
    "  # BYTES, as ruby counts them: peek(1) of \"é\" is \"\\xC3\"\n" ++
    "  def peek(n)\n" ++
    "    n = n.to_int unless n.is_a?(Integer)\n" ++
    "    raise ArgumentError, \"negative string size (or size too big)\" if n < 0\n" ++
    "    @string.byteslice(@pos, n) || \"\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def unscan\n" ++
    "    # ⚠ UNSCAN NEEDS A MATCH TO UNDO. This reset the position whether or not\n" ++
    "    #   there was one, so a second unscan silently moved the scanner again\n" ++
    "    #   -- the record it was undoing had already been consumed.\n" ++
    "    if @matched.nil?\n" ++
    "      raise StringScanner::Error, \"unscan failed: previous match record not exist\"\n" ++
    "    end\n" ++
    "    @pos = @prev_pos\n" ++
    "    @cp = @prev_cp\n" ++
    "    @matched = nil\n" ++
    "    @md = nil\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ ruby's #inspect SAYS WHERE THE SCANNER IS -- position, length, what was\n" ++
    "  #   just matched and what is ahead -- and this answered a constant\n" ++
    "  #   \"#<StringScanner>\" for every scanner in every state. It is the first\n" ++
    "  #   thing anyone debugging a scan looks at.\n" ++
    "  #   The shapes, asked of the reference: \"fin\" at the end, \"p/len @ ahead\"\n" ++
    "  #   before any match, and \"p/len matched @ ahead\" after one. The two texts\n" ++
    "  #   are clipped to five characters with an ellipsis.\n" ++
    "  # ⚠ the part BEFORE the pointer is up to five characters of the\n" ++
    "  # STRING, not the last match: `scan_until(/is/)` from 0 shows \"This\",\n" ++
    "  # and a pointer moved by #pos= with nothing matched shows its left\n" ++
    "  # context too. Only at 0 is it left out.\n" ++
    "  def inspect\n" ++
    "    return \"#<StringScanner fin>\" if eos?\n" ++
    "    r = rest\n" ++
    "    ahead = r[0, 5].inspect\n" ++
    "    ahead = ahead[0...-1] + \"...\\\"\" if r.length > 5\n" ++
    "    head = \"#<StringScanner \" + @pos.to_s + \"/\" + @blen.to_s\n" ++
    "    return head + \" @ \" + ahead + \">\" if @pos == 0\n" ++
    "    before = @string.byteslice(0, @pos)\n" ++
    "    back = before.length > 5 ? before[-5, 5] : before\n" ++
    "    shown = back.inspect\n" ++
    "    shown = \"\\\"...\" + shown[1..-1] if before.length > 5\n" ++
    "    head + \" \" + shown + \" @ \" + ahead + \">\"\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the names the reference has and this did not ----------------------\n" ++
    "  def concat(str)\n" ++
    "    unless str.is_a?(String) || str.respond_to?(:to_str)\n" ++
    "      raise TypeError, \"no implicit conversion of #\{str.class} into String\"\n" ++
    "    end\n" ++
    "    @string << str.to_str\n" ++
    "    __measure\n" ++
    "    self\n" ++
    "  end\n" ++
    "  alias_method :<<, :concat\n" ++
    "\n" ++
    "  def string=(str)\n" ++
    "    str = str.to_str if !str.is_a?(String) && str.respond_to?(:to_str)\n" ++
    "    raise TypeError, \"no implicit conversion into String\" unless str.is_a?(String)\n" ++
    "    @string = str\n" ++
    "    __measure\n" ++
    "    reset\n" ++
    "    str\n" ++
    "  end\n" ++
    "\n" ++
    "  def beginning_of_line?\n" ++
    "    return true if @pos == 0\n" ++
    "    return nil if @pos > @blen\n" ++
    "    @string.getbyte(@pos - 1) == 10\n" ++
    "  end\n" ++
    "  alias_method :bol?, :beginning_of_line?\n" ++
    "\n" ++
    "  def rest?\n" ++
    "    !eos?\n" ++
    "  end\n" ++
    "\n" ++
    "  def fixed_anchor?\n" ++
    "    @fixed\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the byte-at-a-time readers ----------------------------------------\n" ++
    "  # `get_byte` answers a STRING and `scan_byte` answers the byte's INTEGER\n" ++
    "  # value, though they consume the same byte -- so scan_byte is not an alias.\n" ++
    "  # `peek_byte` is the integer too, and consumes nothing.\n" ++
    "  def get_byte\n" ++
    "    return nil if eos?\n" ++
    "    b = @string.byteslice(@pos, 1)\n" ++
    "    cp = @cp\n" ++
    "    __took_text(b)\n" ++
    "    # still on a boundary after an ASCII byte; otherwise worked out on demand\n" ++
    "    @cp = (cp && b.getbyte(0) < 128) ? cp + 1 : nil\n" ++
    "    b\n" ++
    "  end\n" ++
    "\n" ++
    "  def scan_byte\n" ++
    "    b = get_byte\n" ++
    "    b.nil? ? nil : b.getbyte(0)\n" ++
    "  end\n" ++
    "\n" ++
    "  def peek_byte\n" ++
    "    return nil if eos?\n" ++
    "    @string.getbyte(@pos)\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the *_full family: one call, four answers -------------------------\n" ++
    "  def scan_full(re, advance = true, ret_string = true)\n" ++
    "    saved = [@pos, @cp]\n" ++
    "    m = scan(re)\n" ++
    "    return nil if m.nil?\n" ++
    "    n = m.bytesize\n" ++
    "    @pos, @cp = saved unless advance\n" ++
    "    ret_string ? m : n\n" ++
    "  end\n" ++
    "\n" ++
    "  def search_full(re, advance = true, ret_string = true)\n" ++
    "    saved = [@pos, @cp]\n" ++
    "    r = __search(re)\n" ++
    "    return nil if r.nil?\n" ++
    "    n = r.bytesize\n" ++
    "    @pos, @cp = saved unless advance\n" ++
    "    ret_string ? r : n\n" ++
    "  end\n" ++
    "\n" ++
    "  def named_captures\n" ++
    "    (@md.nil? || !@rx) ? \{} : @md.named_captures\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby 3.4's scan_integer: an optional sign then digits, consumed only if\n" ++
    "  # the whole thing is there; base 16 also accepts the 0x prefix. Those are\n" ++
    "  # the only two bases, and the subject has to be ASCII-compatible text.\n" ++
    "  def scan_integer(base: 10)\n" ++
    "    re =\n" ++
    "      case base\n" ++
    "      when 10 then /[+-]?\\d+/\n" ++
    "      when 16 then /[+-]?(0x)?[0-9a-fA-F]+/\n" ++
    "      else raise ArgumentError, \"Unsupported integer base: #\{base.inspect}, expected 10 or 16\"\n" ++
    "      end\n" ++
    "    unless @string.encoding.ascii_compatible?\n" ++
    "      raise Encoding::CompatibilityError, \"ASCII incompatible encoding: #\{@string.encoding.name}\"\n" ++
    "    end\n" ++
    "    m = scan(re)\n" ++
    "    return nil if m.nil?\n" ++
    "    Integer(m, base)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.must_C_version\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "end\n" ++
    "StringScanner::Error = Class.new(StandardError)\n"
  else if str_eq n "securerandom" then
    "module SecureRandom\n" ++
    "  HEX_CHARS = \"0123456789abcdef\"\n" ++
    "  ALNUM_CHARS = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\"\n" ++
    "\n" ++
    "  # a byte count: nil is the default, anything else converts with #to_int\n" ++
    "  def self.__len(n, default = 16)\n" ++
    "    n = n.nil? ? default : n.to_int\n" ++
    "    raise ArgumentError, \"negative string size (or size too big)\" if n < 0\n" ++
    "    n\n" ++
    "  end\n" ++
    "  private_class_method :__len\n" ++
    "\n" ++
    "  def self.random_bytes(n = nil) = Random.urandom(__len(n))\n" ++
    "  def self.bytes(n) = Random.urandom(__len(n))\n" ++
    "  def self.hex(n = nil) = random_bytes(n).unpack1(\"H*\")\n" ++
    "  def self.base64(n = nil) = [random_bytes(n)].pack(\"m0\")\n" ++
    "  def self.urlsafe_base64(n = nil, padding = false)\n" ++
    "    s = base64(n).tr(\"+/\", \"-_\")\n" ++
    "    padding ? s : s.delete(\"=\")\n" ++
    "  end\n" ++
    "\n" ++
    "  # an Integer below max, from random bytes: Kernel#rand stops at 64 bits\n" ++
    "  def self.__int_below(max)\n" ++
    "    bits = max.bit_length\n" ++
    "    mask = (1 << bits) - 1\n" ++
    "    loop do\n" ++
    "      v = random_bytes((bits + 7) / 8).unpack1(\"H*\").to_i(16) & mask\n" ++
    "      return v if v < max\n" ++
    "    end\n" ++
    "  end\n" ++
    "  private_class_method :__int_below\n" ++
    "\n" ++
    "  def self.random_number(n = 0)\n" ++
    "    case n\n" ++
    "    when nil then Kernel.rand\n" ++
    "    when Integer then n > 0 ? __int_below(n) : Kernel.rand\n" ++
    "    when Float then n > 0 ? Kernel.rand * n : Kernel.rand\n" ++
    "    when Range\n" ++
    "      lo, hi = n.begin, n.end\n" ++
    "      if lo.is_a?(Integer) && hi.is_a?(Integer)\n" ++
    "        span = hi - lo + (n.exclude_end? ? 0 : 1)\n" ++
    "        span > 0 ? lo + __int_below(span) : nil\n" ++
    "      else\n" ++
    "        lo + Kernel.rand * (hi - lo)\n" ++
    "      end\n" ++
    "    when Numeric then Kernel.rand\n" ++
    "    else raise ArgumentError, \"invalid argument - #\{n.inspect}\"\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def self.rand(n = 0) = random_number(n)\n" ++
    "\n" ++
    "  def self.alphanumeric(n = nil, chars: nil)\n" ++
    "    cs = chars || ALNUM_CHARS.chars\n" ++
    "    Array.new(__len(n)) \{ cs[__int_below(cs.size)] }.join\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.uuid\n" ++
    "    h = hex(16)\n" ++
    "    v4 = h[0, 12] + \"4\" + h[13, 3] + \"89ab\"[__int_below(4), 1] + h[17, 15]\n" ++
    "    v4[0, 8] + \"-\" + v4[8, 4] + \"-\" + v4[12, 4] + \"-\" + v4[16, 4] + \"-\" + v4[20, 12]\n" ++
    "  end\n" ++
    "end\n"
  // `time`: the formatters and a parser for the shapes libraries exchange.
  // NOT the full stdlib -- mere-ruby's Time has no zone, so a parsed time
  // without one is UTC where CRuby would make it local.
  else if str_eq n "time" then
    "require \"date\"\n" ++
    "# A subset of the stdlib `time`, built on mere-ruby's Time -- which has no\n" ++
    "# concept of a zone and is always UTC. So `Time.parse(\"2023-11-15 07:13:20\")`\n" ++
    "# reads that as UTC, where CRuby would read it as local time.\n" ++
    "class Time\n" ++
    "  RFC2822_DAY_NAME = %w[Sun Mon Tue Wed Thu Fri Sat]\n" ++
    "  RFC2822_MONTH_NAME = %w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec]\n" ++
    "\n" ++
    "  def self.pad2(n)\n" ++
    "    n < 10 ? \"0\" + n.to_s : n.to_s\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.pad4(n)\n" ++
    "    s = n.to_s\n" ++
    "    s = \"0\" + s while s.length < 4\n" ++
    "    s\n" ++
    "  end\n" ++
    "\n" ++
    "  def iso8601(_fraction_digits = 0)\n" ++
    "    Time.pad4(year) + \"-\" + Time.pad2(month) + \"-\" + Time.pad2(day) +\n" ++
    "      \"T\" + Time.pad2(hour) + \":\" + Time.pad2(min) + \":\" + Time.pad2(sec) + \"Z\"\n" ++
    "  end\n" ++
    "  alias_method :xmlschema, :iso8601\n" ++
    "\n" ++
    "  # httpdate is ALWAYS GMT (the time converted), rfc2822 is the time as it\n" ++
    "  # shows with its own offset and a zero-padded day. Both used to print the\n" ++
    "  # local fields with a fixed suffix, which only happened to be right for a\n" ++
    "  # UTC time.\n" ++
    "  def httpdate\n" ++
    "    t = getutc\n" ++
    "    RFC2822_DAY_NAME[t.wday] + \", \" + Time.pad2(t.day) + \" \" +\n" ++
    "      RFC2822_MONTH_NAME[t.month - 1] + \" \" + Time.pad4(t.year) + \" \" +\n" ++
    "      Time.pad2(t.hour) + \":\" + Time.pad2(t.min) + \":\" + Time.pad2(t.sec) + \" GMT\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def rfc2822\n" ++
    "    RFC2822_DAY_NAME[wday] + \", \" + Time.pad2(day) + \" \" +\n" ++
    "      RFC2822_MONTH_NAME[month - 1] + \" \" + Time.pad4(year) + \" \" +\n" ++
    "      Time.pad2(hour) + \":\" + Time.pad2(min) + \":\" + Time.pad2(sec) + \" \" +\n" ++
    "      (utc? ? \"-0000\" : strftime(\"%z\"))\n" ++
    "  end\n" ++
    "  alias_method :rfc822, :rfc2822\n" ++
    "\n" ++
    "  def self.digits(str)\n" ++
    "    str.scan(/\\d+/).map \{ |s| s.to_i }\n" ++
    "  end\n" ++
    "\n" ++
    "  # The zone a parsed string names: UTC for Z / UTC / GMT / UT, \"+HH:MM\" for\n" ++
    "  # a numeric offset, and nil (local) when it names none. Every parse used\n" ++
    "  # to answer a UTC time whatever the string said.\n" ++
    "  def self.__zone_of(z)\n" ++
    "    return nil if z.nil? || z.empty?\n" ++
    "    return \"UTC\" if z == \"Z\" || z == \"UTC\" || z == \"UT\"\n" ++
    "    return \"+00:00\" if z == \"GMT\"\n" ++
    "    m = /\\A([+-])(\\d\{2}):?(\\d\{2})\\z/.match(z)\n" ++
    "    m ? m[1] + m[2] + \":\" + m[3] : nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__build(y, mo, d, h, mi, s, zone)\n" ++
    "    z = __zone_of(zone)\n" ++
    "    z ? new(y, mo, d, h, mi, s, z) : new(y, mo, d, h, mi, s)\n" ++
    "  end\n" ++
    "\n" ++
    "  # A fraction of a second, exactly: \"52\" after the dot is 52/100.\n" ++
    "  def self.__sec(s, frac)\n" ++
    "    frac ? Rational(s.to_i * 10**frac.length + frac.to_i, 10**frac.length) : s.to_i\n" ++
    "  end\n" ++
    "\n" ++
    "  # RFC 822's zone names and military letters, as seconds east.\n" ++
    "  def self.__zone_secs(z)\n" ++
    "    return 0 if z.nil?\n" ++
    "    return (z[0] == \"-\" ? -1 : 1) * (z[1, 2].to_i * 3600 + z[3, 2].to_i * 60) if /\\A[+-]\\d\{4}\\z/.match?(z)\n" ++
    "    u = z.upcase\n" ++
    "    named = \{ \"UT\" => 0, \"GMT\" => 0, \"EST\" => -5, \"EDT\" => -4, \"CST\" => -6, \"CDT\" => -5,\n" ++
    "              \"MST\" => -7, \"MDT\" => -6, \"PST\" => -8, \"PDT\" => -7 }\n" ++
    "    return named[u] * 3600 if named.key?(u)\n" ++
    "    return 0 if u == \"Z\"\n" ++
    "    i = \"ABCDEFGHIKLMNOPQRSTUVWXY\".index(u)\n" ++
    "    i ? (i < 12 ? (i + 1) : -(i - 11)) * 3600 : 0\n" ++
    "  end\n" ++
    "\n" ++
    "  # Parses the shapes libraries actually exchange: ISO 8601 / XML Schema,\n" ++
    "  # RFC 2822 and HTTP dates. Anything else raises, rather than guessing.\n" ++
    "  def self.parse(str, _now = nil)\n" ++
    "    s = str.to_s.strip\n" ++
    "    m = /\\A(\\d\{4})-(\\d\{2})-(\\d\{2})(?:[Tt ](\\d\{2}):(\\d\{2})(?::(\\d\{2}))?(?:\\.(\\d+))?)?\\s*(Z|UTC|GMT|[+-]\\d\{2}:?\\d\{2})?/.match(s)\n" ++
    "    if m\n" ++
    "      return __build(m[1].to_i, m[2].to_i, m[3].to_i,\n" ++
    "                     (m[4] || \"0\").to_i, (m[5] || \"0\").to_i, __sec(m[6] || \"0\", m[7]), m[8])\n" ++
    "    end\n" ++
    "    return rfc2822(s) if /\\d\{1,2}\\s+[A-Za-z]\{3}\\s+\\d\{2,}/.match?(s)\n" ++
    "    return httpdate(s) if /\\A[A-Za-z]\{3}\\s+[A-Za-z]\{3}\\s+\\d/.match?(s)\n" ++
    "    raise ArgumentError, \"no time information in \" + str.inspect\n" ++
    "  end\n" ++
    "  def self.iso8601(str)\n" ++
    "    parse(str)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.xmlschema(str)\n" ++
    "    parse(str)\n" ++
    "  end\n" ++
    "\n" ++
    "  # RFC 2822 (and 822: two-digit years, zone names, no seconds). The time\n" ++
    "  # shows the offset the string gave; GMT / UT / -0000 is a UTC time.\n" ++
    "  def self.rfc2822(str)\n" ++
    "    m = /\\A\\s*(?:[A-Za-z]\{3}\\s*,\\s*)?(\\d\{1,2})\\s+([A-Za-z]\{3})\\s+(\\d\{2,})\\s+(\\d\{2})\\s*:\\s*(\\d\{2})(?:\\s*:\\s*(\\d\{2}))?\\s*([+-]\\d\{4}|UT|GMT|[ECMP][SD]T|[A-IK-Za-ik-z])/m.match(str)\n" ++
    "    raise ArgumentError, \"not RFC 2822 compliant date: \" + str.inspect unless m\n" ++
    "    mon = RFC2822_MONTH_NAME.index(m[2].capitalize)\n" ++
    "    raise ArgumentError, \"not RFC 2822 compliant date: \" + str.inspect if mon.nil?\n" ++
    "    year = m[3].to_i\n" ++
    "    year += (year < 50 ? 2000 : 1900) if m[3].length < 4\n" ++
    "    off = __zone_secs(m[7])\n" ++
    "    t = utc(year, mon + 1, m[1].to_i, m[4].to_i, m[5].to_i, (m[6] || \"0\").to_i) - off\n" ++
    "    /\\A(-0000|UT|Z)\\z/i.match?(m[7]) ? t : t.getlocal(off)\n" ++
    "  end\n" ++
    "  # ⚠ rfc822 IS rfc2822, one method under two names: the spec compares\n" ++
    "  # the Method objects, and a second `def` that answers the same is a\n" ++
    "  # different method.\n" ++
    "  class << self\n" ++
    "    alias rfc822 rfc2822\n" ++
    "  end\n" ++
    "\n" ++
    "  # HTTP dates, always GMT: RFC 1123 (\"Sun, 06 Nov 1994 08:49:37 GMT\"),\n" ++
    "  # RFC 850 (\"Sunday, 06-Nov-94 08:49:37 GMT\") and asctime\n" ++
    "  # (\"Sun Nov  6 08:49:37 1994\").\n" ++
    "  def self.httpdate(str)\n" ++
    "    if (m = /\\A\\s*[A-Za-z]\{3},\\s+(\\d\{2})\\s+([A-Za-z]\{3})\\s+(\\d\{4})\\s+(\\d\{2}):(\\d\{2}):(\\d\{2})\\s+GMT\\s*\\z/.match(str))\n" ++
    "      d, mo, y, h, mi, s = m[1], m[2], m[3].to_i, m[4], m[5], m[6]\n" ++
    "    elsif (m = /\\A\\s*[A-Za-z]\{6,9},\\s+(\\d\{2})-([A-Za-z]\{3})-(\\d\{2})\\s+(\\d\{2}):(\\d\{2}):(\\d\{2})\\s+GMT\\s*\\z/.match(str))\n" ++
    "      d, mo, y, h, mi, s = m[1], m[2], m[3].to_i, m[4], m[5], m[6]\n" ++
    "      y += (y < 50 ? 2000 : 1900)\n" ++
    "    elsif (m = /\\A\\s*[A-Za-z]\{3}\\s+([A-Za-z]\{3})\\s+(\\d\{1,2})\\s+(\\d\{2}):(\\d\{2}):(\\d\{2})\\s+(\\d\{4})\\s*\\z/.match(str))\n" ++
    "      mo, d, h, mi, s, y = m[1], m[2], m[3], m[4], m[5], m[6].to_i\n" ++
    "    else\n" ++
    "      raise ArgumentError, \"not RFC 2616 compliant date: \" + str.inspect\n" ++
    "    end\n" ++
    "    mon = RFC2822_MONTH_NAME.index(mo.capitalize)\n" ++
    "    raise ArgumentError, \"not RFC 2616 compliant date: \" + str.inspect if mon.nil?\n" ++
    "    utc(y, mon + 1, d.to_i, h.to_i, mi.to_i, s.to_i)\n" ++
    "  end\n" ++
    "end\n"
  // `delegate`: forwarding on method_missing. CRuby's Delegator generates the
  // methods eagerly, so the observable difference is what #methods reports.
  else if str_eq n "delegate" then
    "# `delegate`: forwarding built on method_missing, which is what CRuby's does\n" ++
    "# too (its Delegator generates methods eagerly; this one forwards lazily, so\n" ++
    "# the observable difference is what #methods reports).\n" ++
    "class Delegator\n" ++
    "  def initialize(obj)\n" ++
    "    __setobj__(obj)\n" ++
    "  end\n" ++
    "\n" ++
    "  def method_missing(m, *args, &block)\n" ++
    "    target = __getobj__\n" ++
    "    if target.respond_to?(m)\n" ++
    "      target.__send__(m, *args, &block)\n" ++
    "    else\n" ++
    "      super\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby's own: a method the target has only PRIVATELY (protected\n" ++
    "  # included) is not forwarded, and asking for one with include_private --\n" ++
    "  # which is what #method does -- says so and answers false, so\n" ++
    "  # `delegator.method(:prot)` is a NameError rather than a Method\n" ++
    "  def respond_to_missing?(m, include_private = false)\n" ++
    "    target = __getobj__\n" ++
    "    r = target.respond_to?(m, include_private)\n" ++
    "    if r && include_private && !target.respond_to?(m, false)\n" ++
    "      warn \"delegator does not forward private method \\##\{m}\", uplevel: 3\n" ++
    "      return false\n" ++
    "    end\n" ++
    "    r\n" ++
    "  end\n" ++
    "\n" ++
    "  def respond_to?(m, include_private = false)\n" ++
    "    super || respond_to_missing?(m, include_private)\n" ++
    "  end\n" ++
    "\n" ++
    "  def ==(obj)\n" ++
    "    return true if obj.equal?(self)\n" ++
    "    __getobj__ == obj\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ `!(self == obj)` is not what ruby's Delegator does, and the difference\n" ++
    "  #   shows the moment the delegate defines its own !=: ruby forwards the\n" ++
    "  #   OPERATOR, this asked == and negated it, so a delegate whose != answers\n" ++
    "  #   something other than the negation of its == was never consulted.\n" ++
    "  def !=(obj)\n" ++
    "    return false if obj.equal?(self)\n" ++
    "    __getobj__ != obj\n" ++
    "  end\n" ++
    "\n" ++
    "  # ...and the same for the two unary operators, which ruby's Delegator also\n" ++
    "  # defines rather than leaving to method_missing.\n" ++
    "  def !\n" ++
    "    !__getobj__\n" ++
    "  end\n" ++
    "\n" ++
    "  def eql?(obj)\n" ++
    "    return true if obj.equal?(self)\n" ++
    "    obj.eql?(__getobj__)\n" ++
    "  end\n" ++
    "\n" ++
    "  # (the three method lists are further down, built on __own_methods)\n" ++
    "\n" ++
    "\n" ++
    "  def to_s\n" ++
    "    __getobj__.to_s\n" ++
    "  end\n" ++
    "\n" ++
    "  def inspect\n" ++
    "    __getobj__.inspect\n" ++
    "  end\n" ++
    "\n" ++
    "  def __getobj__\n" ++
    "    raise NotImplementedError, \"#\{self.class}\\#__getobj__ is not implemented\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def __setobj__(_obj)\n" ++
    "    raise NotImplementedError, \"#\{self.class}\\#__setobj__ is not implemented\"\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "class SimpleDelegator < Delegator\n" ++
    "  def __getobj__\n" ++
    "    @delegate_sd_obj\n" ++
    "  end\n" ++
    "\n" ++
    "  def __setobj__(obj)\n" ++
    "    @delegate_sd_obj = obj\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "# ⚠ ruby's DelegateClass DEFINES a forwarder for every public and\n" ++
    "# protected instance method of the class it wraps, and that is how\n" ++
    "# `DelegateClass(Foo).public_instance_methods` comes to list Foo's methods\n" ++
    "# and the protected ones stay protected. Forwarding through method_missing\n" ++
    "# alone made every call work and reflection say nothing. The names\n" ++
    "# Delegator itself answers are left alone, as ruby leaves them.\n" ++
    "def DelegateClass(superclass, &block)\n" ++
    "  klass = Class.new(Delegator)\n" ++
    "  ignores = Delegator.public_instance_methods + [:to_s, :inspect, :=~, :!~, :===]\n" ++
    "  prot = superclass.protected_instance_methods - ignores\n" ++
    "  pub = superclass.public_instance_methods - ignores\n" ++
    "  klass.class_eval do\n" ++
    "    def __getobj__\n" ++
    "      @delegate_dc_obj\n" ++
    "    end\n" ++
    "    def __setobj__(obj)\n" ++
    "      @delegate_dc_obj = obj\n" ++
    "    end\n" ++
    "    prot.each do |m|\n" ++
    "      define_method(m) \{ |*a, &b| __getobj__.__send__(m, *a, &b) }\n" ++
    "      protected m\n" ++
    "    end\n" ++
    "    pub.each do |m|\n" ++
    "      define_method(m) \{ |*a, &b| __getobj__.__send__(m, *a, &b) }\n" ++
    "    end\n" ++
    "  end\n" ++
    "  klass.class_eval(&block) if block\n" ++
    "  klass\n" ++
    "end\n" ++
    "class Delegator\n" ++
    "  # Reflection has to see THROUGH the delegator: `methods` and its neighbours\n" ++
    "  # are the delegate's plus this object's own, which is what makes\n" ++
    "  # `d.methods.include?(:foo)` true for a method only the target defines.\n" ++
    "  # ⚠ ruby writes these as `__getobj__.methods | super`. `super` from a ruby\n" ++
    "  # override cannot reach the builtin `Object#methods` here -- the builtin is\n" ++
    "  # not in a method table for super to find -- so the delegator's OWN side is\n" ++
    "  # taken from its class instead, which is the same set by another door.\n" ++
    "  def __own_methods = self.class.instance_methods(true) | singleton_methods\n" ++
    "\n" ++
    "  def methods(all = true)\n" ++
    "    __getobj__.methods(all) | __own_methods\n" ++
    "  end\n" ++
    "\n" ++
    "  def public_methods(all = true)\n" ++
    "    __getobj__.public_methods(all) | __own_methods\n" ++
    "  end\n" ++
    "\n" ++
    "  # ...and the protected side has the same two halves: the delegate's and\n" ++
    "  # the delegator class's own (an included module's protected methods).\n" ++
    "  def protected_methods(all = true)\n" ++
    "    __getobj__.protected_methods(all) | self.class.protected_instance_methods(true)\n" ++
    "  end\n" ++
    "\n" ++
    "  def hash = __getobj__.hash\n" ++
    "  def eql?(obj) = obj.equal?(self) || obj.eql?(__getobj__)\n" ++
    "  def <=>(obj) = (__getobj__ <=> obj)\n" ++
    "  # ⚠ ruby's Delegator UNDEFINES === from its Kernel copy so it falls to\n" ++
    "  #   method_missing. undef_method cannot remove a builtin here, so it is\n" ++
    "  #   forwarded explicitly instead -- same effect for a caller, and the\n" ++
    "  #   same shape as <=> just above. Without it `d === x` answered\n" ++
    "  #   Object#===, which is identity, for every delegate that defines its\n" ++
    "  #   own.\n" ++
    "  def ===(obj) = (__getobj__ === obj)\n" ++
    "  # ⚠ This froze the DELEGATE and answered self, so `d.freeze; d.frozen?`\n" ++
    "  #   was false -- a delegator that reports itself unfrozen after being\n" ++
    "  #   frozen. `super` is what marks self, and ruby's Delegator#freeze does\n" ++
    "  #   exactly these two lines.\n" ++
    "  def freeze\n" ++
    "    __getobj__.freeze\n" ++
    "    super\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby's own pair: the delegator's ivars (not its @delegate_ one) and\n" ++
    "  # the object it wraps, tagged :__v2__. ⚠ The ivars were two empty\n" ++
    "  # Hashes, so a delegator's own @foo did not survive the round trip.\n" ++
    "  def marshal_dump\n" ++
    "    ivars = instance_variables.reject \{ |var| /\\A@delegate_/ =~ var }\n" ++
    "    [:__v2__, ivars, ivars.map \{ |var| instance_variable_get(var) }, __getobj__]\n" ++
    "  end\n" ++
    "\n" ++
    "  def marshal_load(data)\n" ++
    "    version, vars, values, obj = data\n" ++
    "    if version == :__v2__\n" ++
    "      vars.each_with_index \{ |var, i| instance_variable_set(var, values[i]) }\n" ++
    "      __setobj__(obj)\n" ++
    "    else\n" ++
    "      __setobj__(data)\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n"
  // `tempfile`: a File under a generated name. There is no O_EXCL here, so
  // the name is made unique by a counter and randomness, not by an atomic
  // create -- do not rely on it against a hostile /tmp.
  else if str_eq n "tempfile" then
    "require \"delegate\"\n" ++
    "\n" ++
    "# `tempfile`: a File under a generated name, deleted on #close!/#unlink.\n" ++
    "# mere-ruby has no O_EXCL, so the name is made unique by a counter plus a\n" ++
    "# random suffix rather than by an atomic create.\n" ++
    "class Tempfile < DelegateClass(File)\n" ++
    "  @@sequence = 0\n" ++
    "\n" ++
    "  attr_reader :path\n" ++
    "\n" ++
    "  def self.tmpdir\n" ++
    "    ENV[\"TMPDIR\"] || \"/tmp\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.next_name(basename, extension)\n" ++
    "    @@sequence += 1\n" ++
    "    # no getpid here, so uniqueness comes from a counter plus randomness\n" ++
    "    basename.to_s + \"-\" + @@sequence.to_s + \"-\" +\n" ++
    "      rand(1_000_000_000).to_s + \"-\" + rand(1_000_000_000).to_s + extension.to_s\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.create(basename = \"\", tmpdir = nil, mode: nil, **_opts)\n" ++
    "    t = new(basename, tmpdir)\n" ++
    "    return t unless block_given?\n" ++
    "    begin\n" ++
    "      yield t\n" ++
    "    ensure\n" ++
    "      t.close!\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.open(*args, **opts)\n" ++
    "    t = new(*args, **opts)\n" ++
    "    return t unless block_given?\n" ++
    "    begin\n" ++
    "      yield t\n" ++
    "    ensure\n" ++
    "      t.close\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize(basename = \"\", tmpdir = nil, mode: nil, **_opts)\n" ++
    "    base, ext = if basename.is_a?(Array)\n" ++
    "      [basename[0], basename[1]]\n" ++
    "    else\n" ++
    "      [basename, \"\"]\n" ++
    "    end\n" ++
    "    dir = tmpdir || Tempfile.tmpdir\n" ++
    "    @path = dir + \"/\" + Tempfile.next_name(base, ext)\n" ++
    "    File.write(@path, \"\")\n" ++
    "    @unlinked = false\n" ++
    "    @tmpfile = File.open(@path, \"w+\")\n" ++
    "    super(@tmpfile)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ \"r+\", NOT \"r\". ruby's Tempfile#open reopens READ-WRITE and does\n" ++
    "  # not truncate -- the spec's own name for the example says so -- and\n" ++
    "  # this reopened read-only. Nothing showed it while a write to a\n" ++
    "  # read-only handle was silently buffered; the moment File started\n" ++
    "  # refusing the direction it was not opened for, `t.open; t.puts(x)`\n" ++
    "  # became an IOError. The guard did not break this, it found it.\n" ++
    "  def open\n" ++
    "    @tmpfile.close rescue nil\n" ++
    "    @tmpfile = File.open(@path, \"r+\")\n" ++
    "    __setobj__(@tmpfile)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def close(unlink_now = false)\n" ++
    "    _close\n" ++
    "    unlink if unlink_now\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # the close that close and close! share (protected, as in ruby)\n" ++
    "  def _close\n" ++
    "    @tmpfile.close rescue nil\n" ++
    "  end\n" ++
    "  protected :_close\n" ++
    "\n" ++
    "  def close!\n" ++
    "    close(true)\n" ++
    "  end\n" ++
    "\n" ++
    "  def unlink\n" ++
    "    return if @unlinked\n" ++
    "    File.delete(@path) rescue nil\n" ++
    "    @unlinked = true\n" ++
    "    nil\n" ++
    "  end\n" ++
    "  alias_method :delete, :unlink\n" ++
    "\n" ++
    "  def size\n" ++
    "    @tmpfile.flush rescue nil\n" ++
    "    File.exist?(@path) ? File.size(@path) : 0\n" ++
    "  end\n" ++
    "  alias_method :length, :size\n" ++
    "\n" ++
    "  def to_s\n" ++
    "    @path\n" ++
    "  end\n" ++
    "\n" ++
    "  def inspect\n" ++
    "    \"#<Tempfile:\" + @path + \">\"\n" ++
    "  end\n" ++
    "end\n"
  // `English`: readable names for the punctuation globals, which is exactly a
  // file of `alias $NEW $OLD` lines.
  else if str_eq n "digest" || str_eq n "digest/bubblebabble" || str_eq n "digest/sha1" || str_eq n "digest/sha2" ||
          str_eq n "digest/md5" || str_eq n "digest/sha256" then
    "module Digest\n" ++
    "  M32 = 0xffffffff\n" ++
    "\n" ++
    "  # Digest::Instance is the protocol every digest class mixes in: a class\n" ++
    "  # that includes it and does not implement update() refuses with\n" ++
    "  # RuntimeError, and << is the same method as update, not a copy of it.\n" ++
    "  module Instance\n" ++
    "    def update(str)\n" ++
    "      raise RuntimeError, self.class.to_s + \" does not implement update()\"\n" ++
    "    end\n" ++
    "    alias << update\n" ++
    "  end\n" ++
    "\n" ++
    "  class Base\n" ++
    "    def initialize\n" ++
    "      @buf = +\"\".b\n" ++
    "    end\n" ++
    "\n" ++
    "    def update(s)\n" ++
    "      @buf << s.to_s.b\n" ++
    "      self\n" ++
    "    end\n" ++
    "    alias << update\n" ++
    "\n" ++
    "    def reset\n" ++
    "      @buf = +\"\".b\n" ++
    "      self\n" ++
    "    end\n" ++
    "\n" ++
    "    # ⚠ WITH an argument, ruby RESETS the object: `d << \"test\";\n" ++
    "    # d.hexdigest(str)` digests str alone and leaves d blank, so a later\n" ++
    "    # bare `d.hexdigest` is the empty digest. This returned the class\n" ++
    "    # method's answer and kept @buf, so the \"test\" came back afterwards.\n" ++
    "    def digest(s = nil)\n" ++
    "      if s\n" ++
    "        reset\n" ++
    "        return self.class.digest(s)\n" ++
    "      end\n" ++
    "      self.class.digest(@buf)\n" ++
    "    end\n" ++
    "\n" ++
    "    def hexdigest(s = nil)\n" ++
    "      if s\n" ++
    "        reset\n" ++
    "        return self.class.hexdigest(s)\n" ++
    "      end\n" ++
    "      self.class.hexdigest(@buf)\n" ++
    "    end\n" ++
    "\n" ++
    "    def to_s\n" ++
    "      hexdigest\n" ++
    "    end\n" ++
    "\n" ++
    "    def ==(other)\n" ++
    "      other.respond_to?(:hexdigest) ? hexdigest == other.hexdigest : hexdigest == other.to_s\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.hexdigest(s)\n" ++
    "      digest(s).unpack1(\"H*\")\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.base64digest(s)\n" ++
    "      Digest.b64(digest(s))\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.file(path)\n" ++
    "      # ruby opens the file, so the argument is whatever File.open takes --\n" ++
    "      # including an object that only answers #to_str.\n" ++
    "      new.update(File.binread(path))\n" ++
    "    end\n" ++
    "\n" ++
    "    def base64digest(s = nil)\n" ++
    "      Digest.b64(digest(s))\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # the hex of any String's bytes; String() is not asked, only #to_str\n" ++
    "  def self.hexencode(s)\n" ++
    "    unless String === s\n" ++
    "      raise TypeError, \"no implicit conversion of #\{s.nil? ? 'nil' : s.class} into String\" unless s.respond_to?(:to_str)\n" ++
    "      s = s.to_str\n" ++
    "    end\n" ++
    "    s.unpack1(\"H*\")\n" ++
    "  end\n" ++
    "\n" ++
    "  B64 = (\"A\"..\"Z\").to_a + (\"a\"..\"z\").to_a + (\"0\"..\"9\").to_a + [\"+\", \"/\"]\n" ++
    "\n" ++
    "  def self.b64(bin)\n" ++
    "    bytes = bin.bytes\n" ++
    "    out = +\"\"\n" ++
    "    i = 0\n" ++
    "    while i < bytes.size\n" ++
    "      b0 = bytes[i]\n" ++
    "      b1 = bytes[i + 1]\n" ++
    "      b2 = bytes[i + 2]\n" ++
    "      out << B64[b0 >> 2]\n" ++
    "      out << B64[((b0 & 0x03) << 4) | ((b1 || 0) >> 4)]\n" ++
    "      out << (b1 ? B64[((b1 & 0x0f) << 2) | ((b2 || 0) >> 6)] : \"=\")\n" ++
    "      out << (b2 ? B64[b2 & 0x3f] : \"=\")\n" ++
    "      i += 3\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  # 32-bit helpers shared by SHA1/SHA256/MD5.\n" ++
    "  def self.rotl32(x, n)\n" ++
    "    ((x << n) | (x >> (32 - n))) & M32\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.rotr32(x, n)\n" ++
    "    ((x >> n) | (x << (32 - n))) & M32\n" ++
    "  end\n" ++
    "\n" ++
    "  # message + 0x80 + zero padding to 56 mod 64 + 64-bit length (big endian)\n" ++
    "  def self.pad_be(msg)\n" ++
    "    bitlen = msg.bytesize * 8\n" ++
    "    padded = msg + \"\\x80\".b\n" ++
    "    padded << \"\\x00\".b while padded.bytesize % 64 != 56\n" ++
    "    padded + [bitlen >> 32, bitlen & M32].pack(\"NN\")\n" ++
    "  end\n" ++
    "\n" ++
    "  # same, little-endian length (MD5)\n" ++
    "  def self.pad_le(msg)\n" ++
    "    bitlen = msg.bytesize * 8\n" ++
    "    padded = msg + \"\\x80\".b\n" ++
    "    padded << \"\\x00\".b while padded.bytesize % 64 != 56\n" ++
    "    padded + [bitlen & M32, bitlen >> 32].pack(\"VV\")\n" ++
    "  end\n" ++
    "\n" ++
    "  class SHA1 < Base\n" ++
    "    def self.digest(s)\n" ++
    "      msg = Digest.pad_be(s.to_s.b)\n" ++
    "      h = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]\n" ++
    "      i = 0\n" ++
    "      while i < msg.bytesize\n" ++
    "        w = msg[i, 64].unpack(\"N16\")\n" ++
    "        t = 16\n" ++
    "        while t < 80\n" ++
    "          w[t] = Digest.rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        a, b, c, d, e = h\n" ++
    "        t = 0\n" ++
    "        while t < 80\n" ++
    "          if t < 20\n" ++
    "            f = (b & c) | (~b & d) & M32\n" ++
    "            k = 0x5A827999\n" ++
    "          elsif t < 40\n" ++
    "            f = b ^ c ^ d\n" ++
    "            k = 0x6ED9EBA1\n" ++
    "          elsif t < 60\n" ++
    "            f = (b & c) | (b & d) | (c & d)\n" ++
    "            k = 0x8F1BBCDC\n" ++
    "          else\n" ++
    "            f = b ^ c ^ d\n" ++
    "            k = 0xCA62C1D6\n" ++
    "          end\n" ++
    "          tmp = (Digest.rotl32(a, 5) + (f & M32) + e + k + w[t]) & M32\n" ++
    "          e = d\n" ++
    "          d = c\n" ++
    "          c = Digest.rotl32(b, 30)\n" ++
    "          b = a\n" ++
    "          a = tmp\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        h = [(h[0] + a) & M32, (h[1] + b) & M32, (h[2] + c) & M32,\n" ++
    "             (h[3] + d) & M32, (h[4] + e) & M32]\n" ++
    "        i += 64\n" ++
    "      end\n" ++
    "      h.pack(\"N5\")\n" ++
    "    end\n" ++
    "\n" ++
    "    def digest_length = 20\n" ++
    "    def block_length = 64\n" ++
    "  end\n" ++
    "\n" ++
    "  class SHA256 < Base\n" ++
    "    K = [\n" ++
    "      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,\n" ++
    "      0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,\n" ++
    "      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,\n" ++
    "      0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n" ++
    "      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,\n" ++
    "      0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,\n" ++
    "      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,\n" ++
    "      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n" ++
    "      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,\n" ++
    "      0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,\n" ++
    "      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2\n" ++
    "    ]\n" ++
    "\n" ++
    "    def self.digest(s)\n" ++
    "      msg = Digest.pad_be(s.to_s.b)\n" ++
    "      h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,\n" ++
    "           0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]\n" ++
    "      i = 0\n" ++
    "      while i < msg.bytesize\n" ++
    "        w = msg[i, 64].unpack(\"N16\")\n" ++
    "        t = 16\n" ++
    "        while t < 64\n" ++
    "          s0 = Digest.rotr32(w[t - 15], 7) ^ Digest.rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3)\n" ++
    "          s1 = Digest.rotr32(w[t - 2], 17) ^ Digest.rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10)\n" ++
    "          w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & M32\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        a, b, c, d, e, f, g, hh = h\n" ++
    "        t = 0\n" ++
    "        while t < 64\n" ++
    "          s1 = Digest.rotr32(e, 6) ^ Digest.rotr32(e, 11) ^ Digest.rotr32(e, 25)\n" ++
    "          ch = (e & f) ^ ((~e & M32) & g)\n" ++
    "          t1 = (hh + s1 + ch + K[t] + w[t]) & M32\n" ++
    "          s0 = Digest.rotr32(a, 2) ^ Digest.rotr32(a, 13) ^ Digest.rotr32(a, 22)\n" ++
    "          maj = (a & b) ^ (a & c) ^ (b & c)\n" ++
    "          t2 = (s0 + maj) & M32\n" ++
    "          hh = g\n" ++
    "          g = f\n" ++
    "          f = e\n" ++
    "          e = (d + t1) & M32\n" ++
    "          d = c\n" ++
    "          c = b\n" ++
    "          b = a\n" ++
    "          a = (t1 + t2) & M32\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        n = [a, b, c, d, e, f, g, hh]\n" ++
    "        j = 0\n" ++
    "        while j < 8\n" ++
    "          h[j] = (h[j] + n[j]) & M32\n" ++
    "          j += 1\n" ++
    "        end\n" ++
    "        i += 64\n" ++
    "      end\n" ++
    "      h.pack(\"N8\")\n" ++
    "    end\n" ++
    "\n" ++
    "    def digest_length = 32\n" ++
    "    def block_length = 64\n" ++
    "  end\n" ++
    "\n" ++
    "  class MD5 < Base\n" ++
    "    S = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,\n" ++
    "         5,  9, 14, 20, 5,  9, 14, 20, 5,  9, 14, 20, 5,  9, 14, 20,\n" ++
    "         4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,\n" ++
    "         6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]\n" ++
    "    T = (0...64).map \{ |i| (Math.sin(i + 1).abs * 4294967296).to_i & M32 }\n" ++
    "\n" ++
    "    def self.digest(s)\n" ++
    "      msg = Digest.pad_le(s.to_s.b)\n" ++
    "      h = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]\n" ++
    "      i = 0\n" ++
    "      while i < msg.bytesize\n" ++
    "        m = msg[i, 64].unpack(\"V16\")\n" ++
    "        a, b, c, d = h\n" ++
    "        t = 0\n" ++
    "        while t < 64\n" ++
    "          if t < 16\n" ++
    "            f = (b & c) | ((~b & M32) & d)\n" ++
    "            g = t\n" ++
    "          elsif t < 32\n" ++
    "            f = (d & b) | ((~d & M32) & c)\n" ++
    "            g = (5 * t + 1) % 16\n" ++
    "          elsif t < 48\n" ++
    "            f = b ^ c ^ d\n" ++
    "            g = (3 * t + 5) % 16\n" ++
    "          else\n" ++
    "            f = c ^ (b | (~d & M32))\n" ++
    "            g = (7 * t) % 16\n" ++
    "          end\n" ++
    "          tmp = d\n" ++
    "          d = c\n" ++
    "          c = b\n" ++
    "          b = (b + Digest.rotl32((a + f + T[t] + m[g]) & M32, S[t])) & M32\n" ++
    "          a = tmp\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        h = [(h[0] + a) & M32, (h[1] + b) & M32, (h[2] + c) & M32, (h[3] + d) & M32]\n" ++
    "        i += 64\n" ++
    "      end\n" ++
    "      h.pack(\"V4\")\n" ++
    "    end\n" ++
    "\n" ++
    "    def digest_length = 16\n" ++
    "    def block_length = 64\n" ++
    "  end\n" ++
    "\n" ++
    "  SHA2 = SHA256\n" ++
    "end\n" ++
    "module Digest\n" ++
    "  class Base\n" ++
    "    # The Digest::Instance surface the four digest groups all ask for, and all\n" ++
    "    # of it is one question -- \"what is the digest of what I have been fed\" --\n" ++
    "    # asked with and without resetting.\n" ++
    "    def digest!\n" ++
    "      d = digest\n" ++
    "      reset\n" ++
    "      d\n" ++
    "    end\n" ++
    "\n" ++
    "    def hexdigest!\n" ++
    "      h = hexdigest\n" ++
    "      reset\n" ++
    "      h\n" ++
    "    end\n" ++
    "\n" ++
    "    def length = digest_length\n" ++
    "    alias size length\n" ++
    "\n" ++
    "    def inspect = \"#<#\{self.class.name}: #\{hexdigest}>\"\n" ++
    "\n" ++
    "    # `new` on an INSTANCE is a fresh one of the same class, which is what\n" ++
    "    # Digest::Instance documents and what the reference does.\n" ++
    "    def new = self.class.new\n" ++
    "\n" ++
    "    # ruby compares against anything that answers #to_str as well as against\n" ++
    "    # another digest object, and asking `respond_to?` first is what tells the\n" ++
    "    # two apart.\n" ++
    "    def ==(other)\n" ++
    "      return hexdigest == other.hexdigest if other.respond_to?(:hexdigest)\n" ++
    "      return hexdigest == other.to_str if other.respond_to?(:to_str)\n" ++
    "      false\n" ++
    "    end\n" ++
    "\n" ++
    "    # `#file` on an instance FEEDS the file and answers self; the class method\n" ++
    "    # of the same name answers a new instance. Two methods, two answers.\n" ++
    "    def file(path)\n" ++
    "      update(File.binread(path))\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    "module Digest\n" ++
    "  # SHA-512 and SHA-384, on 32-BIT HALVES.\n" ++
    "  #\n" ++
    "  # ⚠ The obvious version -- one Integer per 64-bit word, masked with\n" ++
    "  # 0xffffffffffffffff -- is CORRECT and unusable here. Measured on this\n" ++
    "  # interpreter: hashing 1000 bytes took 24 seconds and 9.5 GB of resident\n" ++
    "  # memory, against 0.11s and 28 MB for SHA-256, and seven spec files apiece\n" ++
    "  # for SHA-512 and SHA-384 were stopped by the harness's memory cap. The cause\n" ++
    "  # is not the algorithm: a 200,000-iteration loop of `x = (x * 3 + 1) & M32`\n" ++
    "  # runs in 0.39s, and the same loop with a 64-bit mask does not finish in two\n" ++
    "  # minutes. Values past the native int become bignums, every operation on one\n" ++
    "  # allocates, and a method call does not give its memory back.\n" ++
    "  #\n" ++
    "  # So every quantity below is a pair of 32-bit halves, hi and lo, exactly as a\n" ++
    "  # C implementation on a 32-bit machine carries it. Nothing here ever exceeds\n" ++
    "  # 2**32, so nothing here ever allocates a bignum.\n" ++
    "  class SHA512 < Base\n" ++
    "    KHL = [\n" ++
    "      0x428a2f98, 0xd728ae22, 0x71374491, 0x23ef65cd, 0xb5c0fbcf, 0xec4d3b2f, 0xe9b5dba5, 0x8189dbbc,\n" ++
    "      0x3956c25b, 0xf348b538, 0x59f111f1, 0xb605d019, 0x923f82a4, 0xaf194f9b, 0xab1c5ed5, 0xda6d8118,\n" ++
    "      0xd807aa98, 0xa3030242, 0x12835b01, 0x45706fbe, 0x243185be, 0x4ee4b28c, 0x550c7dc3, 0xd5ffb4e2,\n" ++
    "      0x72be5d74, 0xf27b896f, 0x80deb1fe, 0x3b1696b1, 0x9bdc06a7, 0x25c71235, 0xc19bf174, 0xcf692694,\n" ++
    "      0xe49b69c1, 0x9ef14ad2, 0xefbe4786, 0x384f25e3, 0x0fc19dc6, 0x8b8cd5b5, 0x240ca1cc, 0x77ac9c65,\n" ++
    "      0x2de92c6f, 0x592b0275, 0x4a7484aa, 0x6ea6e483, 0x5cb0a9dc, 0xbd41fbd4, 0x76f988da, 0x831153b5,\n" ++
    "      0x983e5152, 0xee66dfab, 0xa831c66d, 0x2db43210, 0xb00327c8, 0x98fb213f, 0xbf597fc7, 0xbeef0ee4,\n" ++
    "      0xc6e00bf3, 0x3da88fc2, 0xd5a79147, 0x930aa725, 0x06ca6351, 0xe003826f, 0x14292967, 0x0a0e6e70,\n" ++
    "      0x27b70a85, 0x46d22ffc, 0x2e1b2138, 0x5c26c926, 0x4d2c6dfc, 0x5ac42aed, 0x53380d13, 0x9d95b3df,\n" ++
    "      0x650a7354, 0x8baf63de, 0x766a0abb, 0x3c77b2a8, 0x81c2c92e, 0x47edaee6, 0x92722c85, 0x1482353b,\n" ++
    "      0xa2bfe8a1, 0x4cf10364, 0xa81a664b, 0xbc423001, 0xc24b8b70, 0xd0f89791, 0xc76c51a3, 0x0654be30,\n" ++
    "      0xd192e819, 0xd6ef5218, 0xd6990624, 0x5565a910, 0xf40e3585, 0x5771202a, 0x106aa070, 0x32bbd1b8,\n" ++
    "      0x19a4c116, 0xb8d2d0c8, 0x1e376c08, 0x5141ab53, 0x2748774c, 0xdf8eeb99, 0x34b0bcb5, 0xe19b48a8,\n" ++
    "      0x391c0cb3, 0xc5c95a63, 0x4ed8aa4a, 0xe3418acb, 0x5b9cca4f, 0x7763e373, 0x682e6ff3, 0xd6b2b8a3,\n" ++
    "      0x748f82ee, 0x5defb2fc, 0x78a5636f, 0x43172f60, 0x84c87814, 0xa1f0ab72, 0x8cc70208, 0x1a6439ec,\n" ++
    "      0x90befffa, 0x23631e28, 0xa4506ceb, 0xde82bde9, 0xbef9a3f7, 0xb2c67915, 0xc67178f2, 0xe372532b,\n" ++
    "      0xca273ece, 0xea26619c, 0xd186b8c7, 0x21c0c207, 0xeada7dd6, 0xcde0eb1e, 0xf57d4f7f, 0xee6ed178,\n" ++
    "      0x06f067aa, 0x72176fba, 0x0a637dc5, 0xa2c898a6, 0x113f9804, 0xbef90dae, 0x1b710b35, 0x131c471b,\n" ++
    "      0x28db77f5, 0x23047d84, 0x32caab7b, 0x40c72493, 0x3c9ebe0a, 0x15c9bebc, 0x431d67c4, 0x9c100d4c,\n" ++
    "      0x4cc5d4be, 0xcb3e42b6, 0x597f299c, 0xfc657e2a, 0x5fcb6fab, 0x3ad6faec, 0x6c44198c, 0x4a475817\n" ++
    "    ]\n" ++
    "\n" ++
    "    IV512 = [\n" ++
    "      0x6a09e667, 0xf3bcc908, 0xbb67ae85, 0x84caa73b, 0x3c6ef372, 0xfe94f82b, 0xa54ff53a, 0x5f1d36f1,\n" ++
    "      0x510e527f, 0xade682d1, 0x9b05688c, 0x2b3e6c1f, 0x1f83d9ab, 0xfb41bd6b, 0x5be0cd19, 0x137e2179\n" ++
    "    ]\n" ++
    "\n" ++
    "    IV384 = [\n" ++
    "      0xcbbb9d5d, 0xc1059ed8, 0x629a292a, 0x367cd507, 0x9159015a, 0x3070dd17, 0x152fecd8, 0xf70e5939,\n" ++
    "      0x67332667, 0xffc00b31, 0x8eb44a87, 0x68581511, 0xdb0c2e0d, 0x64f98fa7, 0x47b5481d, 0xbefa4fa4\n" ++
    "    ]\n" ++
    "\n" ++
    "    # message + 0x80 + zeros to 112 mod 128 + the 128-bit length, big endian\n" ++
    "    def self.pad(msg)\n" ++
    "      bitlen = msg.bytesize * 8\n" ++
    "      padded = msg + \"\\x80\".b\n" ++
    "      padded << \"\\x00\".b while padded.bytesize % 128 != 112\n" ++
    "      padded + [0, 0, bitlen >> 32, bitlen & 0xffffffff].pack(\"N4\")\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.core(s, iv, outwords)\n" ++
    "      m32 = 0xffffffff\n" ++
    "      msg = pad(s.to_s.b)\n" ++
    "      # h[2i], h[2i+1] are the hi and lo halves of state word i\n" ++
    "      h = iv.dup\n" ++
    "      w = []\n" ++
    "      i = 0\n" ++
    "      total = msg.bytesize\n" ++
    "      while i < total\n" ++
    "        n = msg[i, 128].unpack(\"N32\")\n" ++
    "        j = 0\n" ++
    "        while j < 32\n" ++
    "          w[j] = n[j]\n" ++
    "          j += 1\n" ++
    "        end\n" ++
    "        t = 16\n" ++
    "        while t < 80\n" ++
    "          # s0 = rotr(w[t-15], 1) ^ rotr(w[t-15], 8) ^ shr(w[t-15], 7)\n" ++
    "          ah = w[2 * t - 30]\n" ++
    "          al = w[2 * t - 29]\n" ++
    "          s0h = (((ah >> 1) | (al << 31)) ^ ((ah >> 8) | (al << 24)) ^ (ah >> 7)) & m32\n" ++
    "          s0l = (((al >> 1) | (ah << 31)) ^ ((al >> 8) | (ah << 24)) ^ ((al >> 7) | (ah << 25))) & m32\n" ++
    "          # s1 = rotr(w[t-2], 19) ^ rotr(w[t-2], 61) ^ shr(w[t-2], 6)\n" ++
    "          bh = w[2 * t - 4]\n" ++
    "          bl = w[2 * t - 3]\n" ++
    "          s1h = (((bh >> 19) | (bl << 13)) ^ ((bl >> 29) | (bh << 3)) ^ (bh >> 6)) & m32\n" ++
    "          s1l = (((bl >> 19) | (bh << 13)) ^ ((bh >> 29) | (bl << 3)) ^ ((bl >> 6) | (bh << 26))) & m32\n" ++
    "          lo = (w[2 * t - 31] + s0l + w[2 * t - 13] + s1l) & 0xffffffffff\n" ++
    "          carry = lo >> 32\n" ++
    "          w[2 * t + 1] = lo & m32\n" ++
    "          w[2 * t] = (w[2 * t - 32] + s0h + w[2 * t - 14] + s1h + carry) & m32\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        ah = h[0]; al = h[1]; bh = h[2]; bl = h[3]\n" ++
    "        ch = h[4]; cl = h[5]; dh = h[6]; dl = h[7]\n" ++
    "        eh = h[8]; el = h[9]; fh = h[10]; fl = h[11]\n" ++
    "        gh = h[12]; gl = h[13]; hh = h[14]; hl = h[15]\n" ++
    "        t = 0\n" ++
    "        while t < 80\n" ++
    "          # S1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)\n" ++
    "          s1h = (((eh >> 14) | (el << 18)) ^ ((eh >> 18) | (el << 14)) ^ ((el >> 9) | (eh << 23))) & m32\n" ++
    "          s1l = (((el >> 14) | (eh << 18)) ^ ((el >> 18) | (eh << 14)) ^ ((eh >> 9) | (el << 23))) & m32\n" ++
    "          chh = (eh & fh) ^ ((~eh & m32) & gh)\n" ++
    "          chl = (el & fl) ^ ((~el & m32) & gl)\n" ++
    "          k = 2 * t\n" ++
    "          tl = (hl + s1l + chl + KHL[k + 1] + w[k + 1]) & 0xffffffffff\n" ++
    "          carry = tl >> 32\n" ++
    "          t1l = tl & m32\n" ++
    "          t1h = (hh + s1h + chh + KHL[k] + w[k] + carry) & m32\n" ++
    "          # S0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)\n" ++
    "          s0h = (((ah >> 28) | (al << 4)) ^ ((al >> 2) | (ah << 30)) ^ ((al >> 7) | (ah << 25))) & m32\n" ++
    "          s0l = (((al >> 28) | (ah << 4)) ^ ((ah >> 2) | (al << 30)) ^ ((ah >> 7) | (al << 25))) & m32\n" ++
    "          mjh = (ah & bh) ^ (ah & ch) ^ (bh & ch)\n" ++
    "          mjl = (al & bl) ^ (al & cl) ^ (bl & cl)\n" ++
    "          t2l = (s0l + mjl) & 0xffffffffff\n" ++
    "          t2h = (s0h + mjh + (t2l >> 32)) & m32\n" ++
    "          t2l = t2l & m32\n" ++
    "          hh = gh; hl = gl\n" ++
    "          gh = fh; gl = fl\n" ++
    "          fh = eh; fl = el\n" ++
    "          el = (dl + t1l) & 0xffffffffff\n" ++
    "          eh = (dh + t1h + (el >> 32)) & m32\n" ++
    "          el = el & m32\n" ++
    "          dh = ch; dl = cl\n" ++
    "          ch = bh; cl = bl\n" ++
    "          bh = ah; bl = al\n" ++
    "          al = (t1l + t2l) & 0xffffffffff\n" ++
    "          ah = (t1h + t2h + (al >> 32)) & m32\n" ++
    "          al = al & m32\n" ++
    "          t += 1\n" ++
    "        end\n" ++
    "        nw = [ah, al, bh, bl, ch, cl, dh, dl, eh, el, fh, fl, gh, gl, hh, hl]\n" ++
    "        j = 0\n" ++
    "        while j < 8\n" ++
    "          lo = (h[2 * j + 1] + nw[2 * j + 1]) & 0xffffffffff\n" ++
    "          h[2 * j + 1] = lo & m32\n" ++
    "          h[2 * j] = (h[2 * j] + nw[2 * j] + (lo >> 32)) & m32\n" ++
    "          j += 1\n" ++
    "        end\n" ++
    "        i += 128\n" ++
    "      end\n" ++
    "      h[0, outwords * 2].pack(\"N#\{outwords * 2}\")\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.digest(s) = core(s, IV512, 8)\n" ++
    "    def digest_length = 64\n" ++
    "    def block_length = 128\n" ++
    "  end\n" ++
    "\n" ++
    "  class SHA384 < SHA512\n" ++
    "    def self.digest(s) = SHA512.core(s, SHA512::IV384, 6)\n" ++
    "    def digest_length = 48\n" ++
    "    def block_length = 128\n" ++
    "  end\n" ++
    "end\n" ++
    "module Digest\n" ++
    "  # The Bubble Babble Binary Data Encoding (Huima 2000): five characters per\n" ++
    "  # two input bytes, plus a running checksum, wrapped in 'x'. It is a pure\n" ++
    "  # function of the bytes, which is why it lives here rather than in a class.\n" ++
    "  BB_VOWELS = \"aeiouy\"\n" ++
    "  BB_CONSONANTS = \"bcdfghklmnprstvzx\"\n" ++
    "\n" ++
    "  def self.bubblebabble(str)\n" ++
    "    unless str.is_a?(String)\n" ++
    "      raise TypeError, \"no implicit conversion into String\" unless str.respond_to?(:to_str)\n" ++
    "      str = str.to_str\n" ++
    "    end\n" ++
    "    b = str.b.bytes\n" ++
    "    seed = 1\n" ++
    "    out = +\"x\"\n" ++
    "    i = 0\n" ++
    "    rounds = b.size / 2 + 1\n" ++
    "    while i < rounds\n" ++
    "      if i + 1 == rounds && b.size.odd? == false\n" ++
    "        out << BB_VOWELS[seed % 6]\n" ++
    "        out << \"x\"\n" ++
    "        out << BB_VOWELS[seed / 6]\n" ++
    "      elsif i + 1 == rounds\n" ++
    "        byte1 = b[2 * i]\n" ++
    "        out << BB_VOWELS[(((byte1 >> 6) & 3) + seed) % 6]\n" ++
    "        out << BB_CONSONANTS[(byte1 >> 2) & 15]\n" ++
    "        out << BB_VOWELS[((byte1 & 3) + seed / 6) % 6]\n" ++
    "      else\n" ++
    "        byte1 = b[2 * i]\n" ++
    "        byte2 = b[2 * i + 1]\n" ++
    "        out << BB_VOWELS[(((byte1 >> 6) & 3) + seed) % 6]\n" ++
    "        out << BB_CONSONANTS[(byte1 >> 2) & 15]\n" ++
    "        out << BB_VOWELS[((byte1 & 3) + seed / 6) % 6]\n" ++
    "        out << BB_CONSONANTS[(byte2 >> 4) & 15]\n" ++
    "        out << \"-\"\n" ++
    "        out << BB_CONSONANTS[byte2 & 15]\n" ++
    "        seed = (seed * 5 + byte1 * 7 + byte2) % 36\n" ++
    "      end\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    out << \"x\"\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  class Base\n" ++
    "    def bubblebabble = Digest.bubblebabble(digest)\n" ++
    "    def self.bubblebabble(s) = Digest.bubblebabble(digest(s))\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "date" || str_eq n "date_core" then
    "class Date\n" ++
    "  include Comparable\n" ++
    "\n" ++
    "  # mere-ruby's Date is proleptic Gregorian only. CRuby's `start` argument\n" ++
    "  # selects a calendar reform date; these constants exist so callers that\n" ++
    "  # pass one (psych does) work, but they are all the same calendar here.\n" ++
    "  ITALY = 2299161\n" ++
    "  ENGLAND = 2361222\n" ++
    "  GREGORIAN = -Float::INFINITY\n" ++
    "  JULIAN = Float::INFINITY\n" ++
    "\n" ++
    "  # frozen, tables and names alike, as ruby's are\n" ++
    "  ABBR_DAYNAMES = %w[Sun Mon Tue Wed Thu Fri Sat].map(&:freeze).freeze\n" ++
    "  DAYNAMES = %w[Sunday Monday Tuesday Wednesday Thursday Friday Saturday].map(&:freeze).freeze\n" ++
    "  ABBR_MONTHNAMES = ([nil] + %w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec].map(&:freeze)).freeze\n" ++
    "  MONTHNAMES = ([nil] + %w[January February March April May June July August\n" ++
    "                          September October November December].map(&:freeze)).freeze\n" ++
    "\n" ++
    "  # civil -> Julian Day Number (proleptic Gregorian)\n" ++
    "  def self.civil_to_jd(y, m, d)\n" ++
    "    a = (14 - m) / 12\n" ++
    "    y2 = y + 4800 - a\n" ++
    "    m2 = m + 12 * a - 3\n" ++
    "    d + (153 * m2 + 2) / 5 + 365 * y2 + y2 / 4 - y2 / 100 + y2 / 400 - 32045\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.jd_to_civil(jd)\n" ++
    "    a = jd + 32044\n" ++
    "    b = (4 * a + 3) / 146097\n" ++
    "    c = a - 146097 * b / 4\n" ++
    "    d2 = (4 * c + 3) / 1461\n" ++
    "    e = c - 1461 * d2 / 4\n" ++
    "    m2 = (5 * e + 2) / 153\n" ++
    "    day = e - (153 * m2 + 2) / 5 + 1\n" ++
    "    month = m2 + 3 - 12 * (m2 / 10)\n" ++
    "    year = 100 * b + d2 - 4800 + m2 / 10\n" ++
    "    [year, month, day]\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.leap?(y)\n" ++
    "    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.valid_civil?(y, m, d, _start = nil)\n" ++
    "    return false if m < 1 || m > 12 || d < 1\n" ++
    "    d <= days_in_month(y, m)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.days_in_month(y, m)\n" ++
    "    return 29 if m == 2 && leap?(y)\n" ++
    "    [nil, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m]\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.jd(n = 0, _start = nil)\n" ++
    "    allocate.__set_jd(n)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.today(_start = nil)\n" ++
    "    t = Time.now\n" ++
    "    new(t.year, t.month, t.day)\n" ++
    "  end\n" ++
    "\n" ++
    "  # The fields a free-form date names, as ruby's Date._parse finds them:\n" ++
    "  # an ISO date (and time), day and month names, ordinals (5th), numbers\n" ++
    "  # with . / - or space between them (Y-M-D when the first has 3+ digits,\n" ++
    "  # D-M-Y when the last has, else YY-MM-DD), and bare digit runs by length\n" ++
    "  # (DD, DDD year day, MMDD, YYDDD, YYMMDD, YYYYDDD, YYYYMMDD). A two-digit\n" ++
    "  # year is 1969-2068 when comp is true.\n" ++
    "  def self._parse(str, comp = true)\n" ++
    "    raise TypeError, \"no implicit conversion of #\{str.class} into String\" unless str.respond_to?(:to_str)\n" ++
    "    t = str.to_str.downcase\n" ++
    "    h = \{}\n" ++
    "    yy = lambda \{ |y, digits| comp && digits <= 2 ? (y >= 69 ? y + 1900 : y + 2000) : y }\n" ++
    "    mons = %w[jan feb mar apr may jun jul aug sep oct nov dec]\n" ++
    "    days = %w[sun mon tue wed thu fri sat]\n" ++
    "    if (m = t.match(/(\\d\{1,2}):(\\d\{2})(?::(\\d\{2}))?/))\n" ++
    "      h[:hour] = m[1].to_i\n" ++
    "      h[:min] = m[2].to_i\n" ++
    "      h[:sec] = m[3].to_i if m[3]\n" ++
    "      t = t.sub(m[0], \" \")\n" ++
    "    end\n" ++
    "    if (m = t.match(/\\b(sun|mon|tue|wed|thu|fri|sat)[a-z]*/))\n" ++
    "      h[:wday] = days.index(m[1])\n" ++
    "      t = t.sub(m[0], \" \")\n" ++
    "    end\n" ++
    "    mon_re = \"(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\"\n" ++
    "    if (m = t.match(/(-?\\d\{4})-(\\d\{1,2})-(\\d\{1,2})/))\n" ++
    "      h[:year], h[:mon], h[:mday] = m[1].to_i, m[2].to_i, m[3].to_i\n" ++
    "    elsif (m = t.match(/(-?\\d\{3,})[^a-z0-9]*#\{mon_re}[^a-z0-9]*(\\d+)/))\n" ++
    "      h[:year], h[:mon], h[:mday] = m[1].to_i, mons.index(m[2]) + 1, m[3].to_i\n" ++
    "    elsif (m = t.match(/(\\d+)(?:st|nd|rd|th)?[^a-z0-9-]*#\{mon_re}[^a-z0-9-]*(-?\\d+)/))\n" ++
    "      h[:mday], h[:mon], h[:year] = m[1].to_i, mons.index(m[2]) + 1, yy.call(m[3].to_i, m[3].delete(\"-\").size)\n" ++
    "    elsif (m = t.match(/#\{mon_re}[^a-z0-9-]*(\\d+)(st|nd|rd|th)[^a-z0-9-]*(-?\\d+)/))\n" ++
    "      h[:mon], h[:mday], h[:year] = mons.index(m[1]) + 1, m[2].to_i, yy.call(m[4].to_i, m[4].delete(\"-\").size)\n" ++
    "    elsif (m = t.match(/#\{mon_re}[^a-z0-9-]*(\\d+)(?:st|nd|rd|th)/))\n" ++
    "      h[:mon], h[:mday] = mons.index(m[1]) + 1, m[2].to_i\n" ++
    "    elsif (m = t.match(/#\{mon_re}[^a-z0-9-]*(-?\\d\{3,})/))\n" ++
    "      h[:mon], h[:year] = mons.index(m[1]) + 1, m[2].to_i\n" ++
    "    elsif (m = t.match(/#\{mon_re}/))\n" ++
    "      h[:mon] = mons.index(m[1]) + 1\n" ++
    "    elsif (m = t.match(/(-?\\d+)[.\\/ -](\\d+)[.\\/ -](-?\\d+)/))\n" ++
    "      a, b2, c = m[1], m[2], m[3]\n" ++
    "      if a.delete(\"-\").size >= 3\n" ++
    "        h[:year], h[:mon], h[:mday] = a.to_i, b2.to_i, c.to_i\n" ++
    "      elsif c.delete(\"-\").size >= 3\n" ++
    "        h[:mday], h[:mon], h[:year] = a.to_i, b2.to_i, c.to_i\n" ++
    "      else\n" ++
    "        h[:year], h[:mon], h[:mday] = yy.call(a.to_i, a.size), b2.to_i, c.to_i\n" ++
    "      end\n" ++
    "    elsif (m = t.match(/(\\d+)(?:st|nd|rd|th)/))\n" ++
    "      h[:mday] = m[1].to_i\n" ++
    "    elsif (m = t.match(/\\A\\s*(\\d+)\\s*\\z/))\n" ++
    "      d = m[1]\n" ++
    "      case d.size\n" ++
    "      when 2 then h[:mday] = d.to_i\n" ++
    "      when 3 then h[:yday] = d.to_i\n" ++
    "      when 4 then h[:mon], h[:mday] = d[0, 2].to_i, d[2, 2].to_i\n" ++
    "      when 5 then h[:year], h[:yday] = yy.call(d[0, 2].to_i, 2), d[2, 3].to_i\n" ++
    "      when 6 then h[:year], h[:mon], h[:mday] = yy.call(d[0, 2].to_i, 2), d[2, 2].to_i, d[4, 2].to_i\n" ++
    "      when 7 then h[:year], h[:yday] = d[0, 4].to_i, d[4, 3].to_i\n" ++
    "      when 8 then h[:year], h[:mon], h[:mday] = d[0, 4].to_i, d[4, 2].to_i, d[6, 2].to_i\n" ++
    "      end\n" ++
    "    end\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # the civil fields of a _parse hash, the missing ones taken from today\n" ++
    "  def self.__parsed_civil(h)\n" ++
    "    today = Date.today\n" ++
    "    if h[:yday]\n" ++
    "      y = h[:year] || today.year\n" ++
    "      j = civil_to_jd(y, 1, 1) + h[:yday] - 1\n" ++
    "      return jd_to_civil(j)\n" ++
    "    end\n" ++
    "    if h[:wday] && !h[:mday] && !h[:mon]\n" ++
    "      w = h[:wday] == 0 ? 7 : h[:wday]\n" ++
    "      return jd_to_civil(commercial_to_jd(today.cwyear, today.cweek, w))\n" ++
    "    end\n" ++
    "    [h[:year] || today.year, h[:mon] || (h[:mday] ? today.month : 1), h[:mday] || 1]\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.parse(str = \"-4712-01-01\", comp = true, _start = nil, limit: 128)\n" ++
    "    h = _parse(str, comp)\n" ++
    "    raise Date::Error, \"invalid date\" if h.empty? || !(h.key?(:year) || h.key?(:mon) || h.key?(:mday) || h.key?(:yday) || h.key?(:wday))\n" ++
    "    y, m, d = __parsed_civil(h)\n" ++
    "    raise Date::Error, \"invalid date\" unless valid_civil?(y, m, d)\n" ++
    "    new(y, m, d)\n" ++
    "  end\n" ++
    "  # The fields `fmt` names in `str`, as ruby's Date._strptime reports them,\n" ++
    "  # or nil when the text does not follow the format. Composite directives\n" ++
    "  # (%c %D %F %v %+ ...) are spelled out first; a space in the format\n" ++
    "  # matches any run of white space.\n" ++
    "  def self._strptime(str, fmt = \"%F\")\n" ++
    "    comp = \{ \"c\" => \"%a %b %e %H:%M:%S %Y\", \"D\" => \"%m/%d/%y\", \"x\" => \"%m/%d/%y\",\n" ++
    "             \"F\" => \"%Y-%m-%d\", \"v\" => \"%e-%b-%Y\", \"+\" => \"%a %b %e %H:%M:%S %Z %Y\",\n" ++
    "             \"T\" => \"%H:%M:%S\", \"X\" => \"%H:%M:%S\", \"R\" => \"%H:%M\", \"r\" => \"%I:%M:%S %p\", \"h\" => \"%b\" }\n" ++
    "    f = fmt\n" ++
    "    4.times \{ f = f.gsub(/%([cDxFv+TXRrh])/) \{ comp[$1] } }\n" ++
    "    mons = %w[jan feb mar apr may jun jul aug sep oct nov dec]\n" ++
    "    days = %w[sun mon tue wed thu fri sat]\n" ++
    "    h = \{}\n" ++
    "    s = str\n" ++
    "    pos = 0\n" ++
    "    i = 0\n" ++
    "    num = lambda do |width, signed|\n" ++
    "      m = s[pos..].match(signed ? /\\A[-+]?\\d\{1,#\{width}}/ : /\\A\\d\{1,#\{width}}/)\n" ++
    "      return nil unless m\n" ++
    "      pos += m[0].size\n" ++
    "      m[0].to_i\n" ++
    "    end\n" ++
    "    while i < f.size\n" ++
    "      c = f[i]\n" ++
    "      if c == \"%\" && i + 1 < f.size\n" ++
    "        d = f[i + 1]\n" ++
    "        i += 2\n" ++
    "        v = nil\n" ++
    "        case d\n" ++
    "        when \"Y\" then v = num.call(20, true); h[:year] = v\n" ++
    "        when \"y\" then v = num.call(2, false); h[:year] = v && (v >= 69 ? v + 1900 : v + 2000); h[:_y2] = v\n" ++
    "        when \"C\" then v = num.call(2, true); h[:_cent] = v\n" ++
    "        when \"m\" then v = num.call(2, false); h[:mon] = v\n" ++
    "        when \"d\", \"e\"\n" ++
    "          pos += 1 if s[pos] == \" \"\n" ++
    "          v = num.call(2, false); h[:mday] = v\n" ++
    "        when \"j\" then v = num.call(3, false); h[:yday] = v\n" ++
    "        when \"H\", \"k\", \"I\", \"l\"\n" ++
    "          pos += 1 if s[pos] == \" \"\n" ++
    "          v = num.call(2, false); h[:hour] = v\n" ++
    "        when \"M\" then v = num.call(2, false); h[:min] = v\n" ++
    "        when \"S\" then v = num.call(2, false); h[:sec] = v\n" ++
    "        when \"U\" then v = num.call(2, false); h[:wnum0] = v\n" ++
    "        when \"W\" then v = num.call(2, false); h[:wnum1] = v\n" ++
    "        when \"u\" then v = num.call(1, false); h[:cwday] = v\n" ++
    "        when \"w\" then v = num.call(1, false); h[:wday] = v\n" ++
    "        when \"G\" then v = num.call(20, true); h[:cwyear] = v\n" ++
    "        when \"g\" then v = num.call(2, false); h[:cwyear] = v && (v >= 69 ? v + 1900 : v + 2000)\n" ++
    "        when \"V\" then v = num.call(2, false); h[:cweek] = v\n" ++
    "        when \"a\", \"A\", \"b\", \"B\"\n" ++
    "          m = s[pos..].match(/\\A[a-zA-Z]+/)\n" ++
    "          if m\n" ++
    "            w = m[0].downcase\n" ++
    "            list = (d == \"a\" || d == \"A\") ? days : mons\n" ++
    "            k = list.index(w[0, 3])\n" ++
    "            full = (d == \"a\" || d == \"A\") ? %w[sunday monday tuesday wednesday thursday friday saturday] : %w[january february march april may june july august september october november december]\n" ++
    "            if k && (w.size == 3 || full[k] == w)\n" ++
    "              pos += w.size\n" ++
    "              v = k\n" ++
    "              if d == \"a\" || d == \"A\" then h[:wday] = k else h[:mon] = k + 1 end\n" ++
    "            end\n" ++
    "          end\n" ++
    "        when \"p\", \"P\"\n" ++
    "          m = s[pos..].match(/\\A[aApP]\\.?[mM]\\.?/)\n" ++
    "          if m\n" ++
    "            pos += m[0].size\n" ++
    "            v = m[0]\n" ++
    "            h[:_merid] = m[0].downcase.start_with?(\"p\") ? 12 : 0\n" ++
    "          end\n" ++
    "        when \"Z\", \"z\"\n" ++
    "          m = s[pos..].match(/\\A(?:[-+]\\d\{1,2}(?::?\\d\{2})?|[a-zA-Z]+)/)\n" ++
    "          if m\n" ++
    "            pos += m[0].size\n" ++
    "            v = h[:zone] = m[0]\n" ++
    "            if (zm = v.match(/\\A([-+])(\\d\{1,2}):?(\\d\{2})?\\z/))\n" ++
    "              h[:offset] = (zm[1] == \"-\" ? -1 : 1) * (zm[2].to_i * 3600 + zm[3].to_i * 60)\n" ++
    "            elsif %w[utc gmt z].include?(v.downcase)\n" ++
    "              h[:offset] = 0\n" ++
    "            end\n" ++
    "          end\n" ++
    "        when \"%\"\n" ++
    "          v = s[pos] == \"%\" ? (pos += 1) : nil\n" ++
    "        else\n" ++
    "          return nil\n" ++
    "        end\n" ++
    "        return nil if v.nil?\n" ++
    "      elsif c =~ /\\s/\n" ++
    "        i += 1\n" ++
    "        pos += 1 while pos < s.size && s[pos] =~ /\\s/\n" ++
    "      else\n" ++
    "        return nil unless s[pos] == c\n" ++
    "        pos += 1\n" ++
    "        i += 1\n" ++
    "      end\n" ++
    "    end\n" ++
    "    if h.key?(:_cent)\n" ++
    "      c = h.delete(:_cent)\n" ++
    "      y2 = h.delete(:_y2)\n" ++
    "      h[:year] = c * 100 + (y2 || (h[:year] || 0) % 100)\n" ++
    "    end\n" ++
    "    h.delete(:_y2)\n" ++
    "    if h.key?(:_merid)\n" ++
    "      mer = h.delete(:_merid)\n" ++
    "      h[:hour] = h[:hour] % 12 + mer if h[:hour]\n" ++
    "    end\n" ++
    "    h[:leftover] = s[pos..] if pos < s.size\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # the day _strptime's fields name, the missing ones taken from today the way\n" ++
    "  # ruby completes them: a year day, then a month and day, then the commercial\n" ++
    "  # fields, then a week number, then a bare week day.\n" ++
    "  def self.__strptime_jd(h)\n" ++
    "    today = Date.today\n" ++
    "    if h[:yday]\n" ++
    "      return civil_to_jd(h[:year] || today.year, 1, 1) + h[:yday] - 1\n" ++
    "    end\n" ++
    "    if h[:mon] || h[:mday]\n" ++
    "      y = h[:year] || today.year\n" ++
    "      m = h[:mon] || (h[:mday] ? today.month : 1)\n" ++
    "      d = h[:mday] || 1\n" ++
    "      return nil unless valid_civil?(y, m, d)\n" ++
    "      return civil_to_jd(y, m, d)\n" ++
    "    end\n" ++
    "    if h[:cweek] || h[:cwyear] || h[:cwday]\n" ++
    "      return commercial_to_jd(h[:cwyear] || today.cwyear, h[:cweek] || 1, h[:cwday] || 1)\n" ++
    "    end\n" ++
    "    y = h[:year] || today.year\n" ++
    "    jd1 = civil_to_jd(y, 1, 1)\n" ++
    "    wd1 = (jd1 + 1) % 7\n" ++
    "    return jd1 - wd1 + 7 * h[:wnum0] + (h[:wday] || 0) if h[:wnum0]\n" ++
    "    return jd1 - (wd1 + 6) % 7 + 7 * h[:wnum1] + ((h[:wday] || 1) + 6) % 7 if h[:wnum1]\n" ++
    "    if h[:wday]\n" ++
    "      return jd1 - wd1 + h[:wday] if h[:year]\n" ++
    "      return today.jd - today.wday + h[:wday]\n" ++
    "    end\n" ++
    "    civil_to_jd(y, 1, 1)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.strptime(str = \"-4712-01-01\", fmt = \"%F\", _start = nil)\n" ++
    "    h = _strptime(str, fmt)\n" ++
    "    raise Date::Error, \"invalid date\" if h.nil?\n" ++
    "    jd = __strptime_jd(h)\n" ++
    "    raise Date::Error, \"invalid date\" if jd.nil?\n" ++
    "    Date.jd(jd)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.new(y = -4712, m = 1, d = 1, _start = nil)\n" ++
    "    obj = allocate\n" ++
    "    if d < 0\n" ++
    "      d = days_in_month(y, m) + d + 1\n" ++
    "    end\n" ++
    "    raise Date::Error, \"invalid date\" unless valid_civil?(y, m, d)\n" ++
    "    obj.__set_jd(civil_to_jd(y, m, d))\n" ++
    "  end\n" ++
    "\n" ++
    "  class Error < ArgumentError; end\n" ++
    "\n" ++
    "  def __set_jd(n)\n" ++
    "    @jd = n\n" ++
    "    y, m, d = Date.jd_to_civil(n)\n" ++
    "    @year = y\n" ++
    "    @month = m\n" ++
    "    @day = d\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  attr_reader :jd, :year, :month, :day\n" ++
    "\n" ++
    "  alias mon month\n" ++
    "  alias mday day\n" ++
    "\n" ++
    "  def wday = (@jd + 1) % 7\n" ++
    "  def sunday? = wday == 0\n" ++
    "  def monday? = wday == 1\n" ++
    "  def tuesday? = wday == 2\n" ++
    "  def wednesday? = wday == 3\n" ++
    "  def thursday? = wday == 4\n" ++
    "  def friday? = wday == 5\n" ++
    "  def saturday? = wday == 6\n" ++
    "\n" ++
    "  def yday = @jd - Date.civil_to_jd(@year, 1, 1) + 1\n" ++
    "  def leap? = Date.leap?(@year)\n" ++
    "\n" ++
    "  def +(n) = Date.jd(@jd + n.to_i)\n" ++
    "  def -(other)\n" ++
    "    return Date.jd(@jd - other) if other.is_a?(Integer)\n" ++
    "    Rational(@jd - other.jd, 1)\n" ++
    "  end\n" ++
    "\n" ++
    "  def next_day(n = 1) = Date.jd(@jd + n)\n" ++
    "  def prev_day(n = 1) = Date.jd(@jd - n)\n" ++
    "  def succ = next_day\n" ++
    "  alias next succ\n" ++
    "\n" ++
    "  # >> and << move by months, clamping the day to the target month's length\n" ++
    "  def >>(n)\n" ++
    "    total = (@year * 12 + (@month - 1)) + n\n" ++
    "    y = total / 12\n" ++
    "    m = total % 12 + 1\n" ++
    "    d = @day\n" ++
    "    last = Date.days_in_month(y, m)\n" ++
    "    d = last if d > last\n" ++
    "    Date.new(y, m, d)\n" ++
    "  end\n" ++
    "\n" ++
    "  def <<(n)\n" ++
    "    raise TypeError, \"expected numeric\" unless n.is_a?(Numeric)\n" ++
    "    self >> (-n)\n" ++
    "  end\n" ++
    "  def next_month(n = 1) = self >> n\n" ++
    "  def prev_month(n = 1) = self << n\n" ++
    "  def next_year(n = 1) = self >> (12 * n)\n" ++
    "  def prev_year(n = 1) = self << (12 * n)\n" ++
    "\n" ++
    "  def <=>(other)\n" ++
    "    return @jd <=> other.jd if other.is_a?(Date)\n" ++
    "    return @jd <=> other if other.is_a?(Numeric)\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def ==(other) = other.is_a?(Date) && @jd == other.jd\n" ++
    "  def eql?(other) = self == other\n" ++
    "  def hash = @jd.hash\n" ++
    "\n" ++
    "  def to_date = self\n" ++
    "  def to_s = format(\"%04d-%02d-%02d\", @year, @month, @day)\n" ++
    "  def iso8601 = to_s\n" ++
    "  # the day number, the day fraction, the offset and the calendar reform,\n" ++
    "  # as ruby shows them (a proleptic calendar's reform is -Inf / Inf)\n" ++
    "  def inspect\n" ++
    "    st = start\n" ++
    "    sts = st.infinite? ? (st < 0 ? \"-Inf\" : \"Inf\") : st.to_i.to_s\n" ++
    "    \"#<Date: #\{self} ((#\{jd}j,0s,0n),+0s,#\{sts}j)>\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def to_time = Time.local(@year, @month, @day)\n" ++
    "\n" ++
    "  # the one strftime engine (Time.__strf), with a Date's fields: midnight,\n" ++
    "  # at offset zero, and %Q allowed\n" ++
    "  def strftime(fmt = \"%F\")\n" ++
    "    Time.__strf(fmt, [@year, @month, @day, yday, wday, 0, 0, 0, 0, 0, false, \"+00:00\", (jd - 2440588) * 86400, true])\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "class DateTime < Date\n" ++
    "  # ⚠ THIS BUILT A DATE. `Date.new(y, m, d)` allocates the class it is CALLED\n" ++
    "  #   on, and calling it by name means Date -- so `DateTime.new(...).class`\n" ++
    "  #   was Date, `DateTime.instance_methods(false)` was empty, and every\n" ++
    "  #   DateTime-specific method was reached by inheritance from an object\n" ++
    "  #   that is not a DateTime. #iso8601 answered \"2020-01-02\" for that\n" ++
    "  #   reason. `super` runs the same code with self still DateTime.\n" ++
    "  # ⚠ THE SEVENTH ARGUMENT IS THE OFFSET, a fraction of a day, and it was\n" ++
    "  # dropped: every DateTime claimed +00:00. ruby takes a Rational, an\n" ++
    "  # Integer, a Float (rationalized -- 0.7 is 7/10, not the binary fraction)\n" ++
    "  # or \"+HH:MM\"; the civil fields are read AS local to that offset, so only\n" ++
    "  # #offset, #zone and the printers change.\n" ++
    "  def self.new(y = -4712, m = 1, d = 1, h = 0, min = 0, s = 0, off = 0, _start = nil)\n" ++
    "    obj = super(y, m, d)\n" ++
    "    obj.__set_time(h, min, s)\n" ++
    "    obj.__set_offset(Date.__offset_of(off))\n" ++
    "    obj\n" ++
    "  end\n" ++
    "\n" ++
    "  # a DateTime prints the whole timestamp; Date's #to_s is the date alone.\n" ++
    "  def to_s\n" ++
    "    format(\"%04d-%02d-%02dT%02d:%02d:%02d\", year, month, day, hour, minute, second) + __off_s\n" ++
    "  end\n" ++
    "  def inspect = \"#<DateTime: #\{self}>\"\n" ++
    "\n" ++
    "  # ⚠ with the fraction and the OFFSET: this read the local wall clock and\n" ++
    "  # built it at +00:00, so `DateTime.now.to_time` was the local offset away\n" ++
    "  # from Time.now (nine hours, on the machine that found it)\n" ++
    "  def self.now(_start = Date::ITALY)\n" ++
    "    t = Time.now\n" ++
    "    new(t.year, t.month, t.day, t.hour, t.min, t.sec + t.subsec, Rational(t.utc_offset, 86400))\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "class Date\n" ++
    "  def __set_time(h, mi, s)\n" ++
    "    @hour = h\n" ++
    "    @minute = mi\n" ++
    "    @second = s\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def hour = @hour || 0\n" ++
    "  # ⚠ THESE ARE ALIASES, not two methods that answer the same value. The\n" ++
    "  #   specs compare the UnboundMethods -- `DateTime.instance_method(:min)\n" ++
    "  #   == DateTime.instance_method(:minute)` -- and `def min = minute`\n" ++
    "  #   defines a SECOND method that forwards, which is not equal to the\n" ++
    "  #   first. alias_method makes them one.\n" ++
    "  def minute = @minute || 0\n" ++
    "  alias_method :min, :minute\n" ++
    "  def second = @second || 0\n" ++
    "  alias_method :sec, :second\n" ++
    "  # the sub-second part, as a Rational. This model keeps whole seconds, so\n" ++
    "  # it is always zero -- said as a Rational because that is the TYPE the\n" ++
    "  # caller gets from ruby, and an Integer 0 would compare the same and\n" ++
    "  # print differently.\n" ++
    "  def sec_fraction = Rational(0, 1)\n" ++
    "  alias_method :second_fraction, :sec_fraction\n" ++
    "  def offset = @offset || Rational(0, 1)\n" ++
    "  def __set_offset(o)\n" ++
    "    @offset = o\n" ++
    "    self\n" ++
    "  end\n" ++
    "  def self.__offset_of(off)\n" ++
    "    case off\n" ++
    "    when String\n" ++
    "      m = /\\A([+-])(\\d\{2}):?(\\d\{2})\\z/.match(off)\n" ++
    "      return Rational(0, 1) unless m\n" ++
    "      r = Rational(m[2].to_i * 3600 + m[3].to_i * 60, 86400)\n" ++
    "      m[1] == \"-\" ? -r : r\n" ++
    "    when Float then off.rationalize(Rational(1, 864000000))\n" ++
    "    when Integer, Rational then Rational(off)\n" ++
    "    else Rational(0, 1)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def zone = __off_s\n" ++
    "  # ⚠ DateTime#iso8601 answered the DATE only -- Date#iso8601, inherited --\n" ++
    "  #   so a DateTime printed as \"2020-01-02\" where ruby gives the full\n" ++
    "  #   timestamp. It is #to_s here, as it is for Date.\n" ++
    "  def iso8601 = to_s\n" ++
    "end\n" ++
    "class Date\n" ++
    "  # `new` is the shim's constructor; `civil` is the SAME constructor under the\n" ++
    "  # name ruby/spec writes 23 of its 98 date files with.\n" ++
    "  def self.civil(y = -4712, m = 1, d = 1, _start = nil)\n" ++
    "    new(y, m, d, _start)\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- Julian-day flavours. All exact, so the Rational ones stay Rational. ---\n" ++
    "  def ajd = Rational(2 * @jd - 1, 2)\n" ++
    "  def amjd = Rational(2 * @jd - 4800002, 2)\n" ++
    "  def mjd = @jd - 2400001\n" ++
    "  def ld = @jd - 2299160\n" ++
    "  def day_fraction = Rational(0, 1)\n" ++
    "\n" ++
    "  # --- the ISO commercial week date -------------------------------------\n" ++
    "  # Week 1 is the week holding January 4th, and the week starts on Monday.\n" ++
    "  def self.__iso_wday(jd) = ((jd + 1) % 7 == 0 ? 7 : (jd + 1) % 7)\n" ++
    "\n" ++
    "  def self.__monday_of_week1(cwyear)\n" ++
    "    j4 = civil_to_jd(cwyear, 1, 4)\n" ++
    "    j4 - (__iso_wday(j4) - 1)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.commercial_to_jd(cwyear, cweek, cwday)\n" ++
    "    __monday_of_week1(cwyear) + (cweek - 1) * 7 + (cwday - 1)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.commercial(cwyear = -4712, cweek = 1, cwday = 1, _start = nil)\n" ++
    "    raise Date::Error, \"invalid date\" unless valid_commercial?(cwyear, cweek, cwday)\n" ++
    "    jd(commercial_to_jd(cwyear, cweek, cwday), _start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.valid_commercial?(cwyear, cweek, cwday, _start = nil)\n" ++
    "    return false unless cwday.is_a?(Integer) && cweek.is_a?(Integer) && cwyear.is_a?(Integer)\n" ++
    "    # 1..7, or -7..-1 counted back from Sunday; 0 is not a day\n" ++
    "    cwday += 8 if cwday < 0\n" ++
    "    return false if cwday < 1 || cwday > 7\n" ++
    "    if cweek < 0\n" ++
    "      last = __weeks_in_cwyear(cwyear)\n" ++
    "      cweek = last + cweek + 1\n" ++
    "    end\n" ++
    "    return false if cweek < 1 || cweek > __weeks_in_cwyear(cwyear)\n" ++
    "    true\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__weeks_in_cwyear(y)\n" ++
    "    (__monday_of_week1(y + 1) - __monday_of_week1(y)) / 7\n" ++
    "  end\n" ++
    "\n" ++
    "  def cwday = Date.__iso_wday(@jd)\n" ++
    "\n" ++
    "  def cwyear\n" ++
    "    thu = @jd + (4 - Date.__iso_wday(@jd))\n" ++
    "    Date.jd_to_civil(thu)[0]\n" ++
    "  end\n" ++
    "\n" ++
    "  def cweek\n" ++
    "    (@jd - Date.__monday_of_week1(cwyear)) / 7 + 1\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the ordinal (year + day-of-year) date -----------------------------\n" ++
    "  def self.ordinal(y = -4712, d = 1, _start = nil)\n" ++
    "    raise Date::Error, \"invalid date\" unless valid_ordinal?(y, d)\n" ++
    "    first = civil_to_jd(y, 1, 1)\n" ++
    "    len = civil_to_jd(y + 1, 1, 1) - first\n" ++
    "    d = len + d + 1 if d < 0\n" ++
    "    jd(first + d - 1, _start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.valid_ordinal?(y, d, _start = nil)\n" ++
    "    return false unless y.is_a?(Integer) && d.is_a?(Integer)\n" ++
    "    return false if d == 0\n" ++
    "    len = civil_to_jd(y + 1, 1, 1) - civil_to_jd(y, 1, 1)\n" ++
    "    d = len + d + 1 if d < 0\n" ++
    "    d >= 1 && d <= len\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the remaining validity questions ---------------------------------\n" ++
    "  def self.valid_jd?(jd, _start = nil) = jd.is_a?(Numeric)\n" ++
    "  def self.valid_date?(y, m, d, _start = nil) = valid_civil?(y, m, d)\n" ++
    "  # Date::Infinity: the infinities a Date range can end at\n" ++
    "  class Infinity < Numeric\n" ++
    "    def initialize(d = 1)\n" ++
    "      @d = d <=> 0\n" ++
    "    end\n" ++
    "    def d = @d\n" ++
    "    protected :d\n" ++
    "    def zero? = false\n" ++
    "    def finite? = false\n" ++
    "    def infinite? = @d.nonzero?\n" ++
    "    def nan? = @d.zero?\n" ++
    "    def abs = self.class.new\n" ++
    "    def -@ = self.class.new(-@d)\n" ++
    "    def +@ = self.class.new(+@d)\n" ++
    "    def <=>(other)\n" ++
    "      case other\n" ++
    "      when Infinity then @d <=> other.d\n" ++
    "      when Numeric then @d\n" ++
    "      end\n" ++
    "    end\n" ++
    "    def coerce(other)\n" ++
    "      return [-@d, @d] if other.is_a?(Numeric)\n" ++
    "      super\n" ++
    "    end\n" ++
    "    def to_f\n" ++
    "      return 0 if @d == 0\n" ++
    "      @d > 0 ? Float::INFINITY : -Float::INFINITY\n" ++
    "    end\n" ++
    "  end\n" ++
    "  # ISO 8601 calendar dates, extended (2008-02-03) and basic (20080203)\n" ++

    "  def self.iso8601(str = \"-4712-01-01\", _start = nil, limit: 128)\n" ++
    "    h = _iso8601(str)\n" ++
    "    raise Date::Error, \"invalid date\" if h.empty?\n" ++
    "    new(h[:year], h[:mon], h[:mday])\n" ++
    "  end\n" ++
    "  def self.gregorian_leap?(y) = leap?(y)\n" ++
    "  def self.julian_leap?(y) = y % 4 == 0\n" ++
    "\n" ++
    "  # --- iteration ---------------------------------------------------------\n" ++
    "  def step(limit, by = 1)\n" ++
    "    return to_enum(:step, limit, by) unless block_given?\n" ++
    "    raise ArgumentError, \"step can't be 0\" if by == 0\n" ++
    "    d = self\n" ++
    "    if by > 0\n" ++
    "      while d <= limit\n" ++
    "        yield d\n" ++
    "        d = d + by\n" ++
    "      end\n" ++
    "    else\n" ++
    "      while d >= limit\n" ++
    "        yield d\n" ++
    "        d = d + by\n" ++
    "      end\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def upto(max, &block)\n" ++
    "    return to_enum(:upto, max) unless block_given?\n" ++
    "    step(max, 1, &block)\n" ++
    "  end\n" ++
    "\n" ++
    "  def downto(min, &block)\n" ++
    "    return to_enum(:downto, min) unless block_given?\n" ++
    "    step(min, -1, &block)\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the printed forms -------------------------------------------------\n" ++
    "  def asctime = strftime(\"%a %b %e %H:%M:%S %Y\")\n" ++
    "  alias ctime asctime\n" ++
    "\n" ++
    "  alias_method :xmlschema, :iso8601\n" ++
    "\n" ++
    "  def __off_s\n" ++
    "    secs = (offset * 86400).round\n" ++
    "    sign = secs < 0 ? \"-\" : \"+\"\n" ++
    "    secs = secs.abs\n" ++
    "    format(\"%s%02d:%02d\", sign, secs / 3600, (secs % 3600) / 60)\n" ++
    "  end\n" ++
    "\n" ++
    "  def rfc3339\n" ++
    "    format(\"%04d-%02d-%02dT%02d:%02d:%02d%s\", year, month, day, hour, minute, second, __off_s)\n" ++
    "  end\n" ++
    "\n" ++
    "  def rfc2822\n" ++
    "    format(\"%s, %d %s %04d %02d:%02d:%02d +0000\",\n" ++
    "           Date::ABBR_DAYNAMES[wday], day, Date::ABBR_MONTHNAMES[month], year,\n" ++
    "           hour, minute, second)\n" ++
    "  end\n" ++
    "  alias rfc822 rfc2822\n" ++
    "\n" ++
    "  # Date.rfc2822 / DateTime.rfc2822: \"[Day, ]DD Mon YYYY HH:MM[:SS] zone\".\n" ++
    "  # Anything else -- nil included -- is Date::Error \"invalid date\", which\n" ++
    "  # is what ruby raises; the method did not exist at all.\n" ++
    "  def self.rfc2822(str = \"Mon, 1 Jan -4712 00:00:00 +0000\", _start = nil, limit: 128)\n" ++
    "    raise Date::Error, \"invalid date\" unless str.is_a?(String)\n" ++
    "    m = /\\A\\s*(?:[A-Za-z]\{3},\\s*)?(\\d\{1,2})\\s+([A-Za-z]\{3})\\s+(-?\\d+)\\s+(\\d\{2}):(\\d\{2})(?::(\\d\{2}))?/.match(str)\n" ++
    "    raise Date::Error, \"invalid date\" unless m\n" ++
    "    mon = Date::ABBR_MONTHNAMES.index(m[2].capitalize)\n" ++
    "    raise Date::Error, \"invalid date\" unless mon\n" ++
    "    new(m[3].to_i, mon, m[1].to_i)\n" ++
    "  end\n" ++
    "  class << self\n" ++
    "    alias rfc822 rfc2822\n" ++
    "  end\n" ++
    "\n" ++
    "  def httpdate\n" ++
    "    format(\"%s, %02d %s %04d %02d:%02d:%02d GMT\",\n" ++
    "           Date::ABBR_DAYNAMES[wday], day, Date::ABBR_MONTHNAMES[month], year,\n" ++
    "           hour, minute, second)\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- pattern matching --------------------------------------------------\n" ++
    "  def deconstruct_keys(keys)\n" ++
    "    unless keys.nil? || keys.is_a?(Array)\n" ++
    "      raise TypeError, \"wrong argument type #\{keys.class} (expected Array or nil)\"\n" ++
    "    end\n" ++
    "    all = \{ year: year, month: month, day: day, yday: yday, wday: wday }\n" ++
    "    return all if keys.nil?\n" ++
    "    h = \{}\n" ++
    "    keys.each \{ |k| h[k] = all[k] if all.key?(k) }\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  def to_datetime = DateTime.new(year, month, day, hour, minute, second)\n" ++
    "  def infinite? = false\n" ++
    "\n" ++
    "  # --- the calendar-reform accessors, for a shim that has ONE calendar ----\n" ++
    "  # ⚠ This Date is proleptic Gregorian throughout. `start` can therefore only\n" ++
    "  # answer honestly for the one calendar it implements, and the reform-crossing\n" ++
    "  # dates (1582-10-05..14) are a KNOWN GAP rather than something these readers\n" ++
    "  # paper over: they report Gregorian because that is what was computed.\n" ++
    "  def start = 2299161.0\n" ++
    "  def julian? = false\n" ++
    "  def gregorian? = true\n" ++
    "  # `new_start` is a pass-through, the same choice the shim's constructors\n" ++
    "  # already make with their ignored `_start` argument: it keeps a caller that\n" ++
    "  # passes one working (psych does) without claiming to have changed calendars.\n" ++
    "  def new_start(_s = Date::ITALY) = self\n" ++
    "  # `gregorian` and `italy` can answer, because Gregorian-with-ITALY is exactly\n" ++
    "  # what this Date is and what `start` reports.\n" ++
    "  def gregorian = self\n" ++
    "  def italy = self\n" ++
    "  # ⚠ `england` and `julian` are NOT here, and that is the same rule applied the\n" ++
    "  # other way: each names a calendar this implementation does not have, so `self`\n" ++
    "  # would be a WRONG answer (`d.england.start` is 2361222 in ruby, and\n" ++
    "  # `d.julian.julian?` is true) where a NoMethodError is a missing one.\n" ++
    "end\n" ++
    "class Date\n" ++
    "  # --- the calendar reform -------------------------------------------------\n" ++
    "  # Until now this Date was proleptic Gregorian: one formula for all of\n" ++
    "  # history, which is right after 1582-10-15 and up to ten days out before it.\n" ++
    "  # ruby's Date takes a `start` -- the Julian Day on which the Gregorian\n" ++
    "  # calendar took effect -- and uses the JULIAN calendar before it. ITALY\n" ++
    "  # (2299161 = 1582-10-15) is the default, so the ten days 1582-10-05..14\n" ++
    "  # do not exist at all.\n" ++
    "  #\n" ++
    "  # The two conversions below are the same shape with different leap rules:\n" ++
    "  # Julian has a leap year every four, Gregorian skips three centuries in four.\n" ++
    "\n" ++
    "  def self.julian_to_jd(y, m, d)\n" ++
    "    a = (14 - m) / 12\n" ++
    "    y2 = y + 4800 - a\n" ++
    "    m2 = m + 12 * a - 3\n" ++
    "    d + (153 * m2 + 2) / 5 + 365 * y2 + y2 / 4 - 32083\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.gregorian_to_jd(y, m, d)\n" ++
    "    a = (14 - m) / 12\n" ++
    "    y2 = y + 4800 - a\n" ++
    "    m2 = m + 12 * a - 3\n" ++
    "    d + (153 * m2 + 2) / 5 + 365 * y2 + y2 / 4 - y2 / 100 + y2 / 400 - 32045\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.jd_to_julian(jd)\n" ++
    "    c = jd + 32082\n" ++
    "    d2 = (4 * c + 3) / 1461\n" ++
    "    e = c - 1461 * d2 / 4\n" ++
    "    m2 = (5 * e + 2) / 153\n" ++
    "    [d2 - 4800 + m2 / 10, m2 + 3 - 12 * (m2 / 10), e - (153 * m2 + 2) / 5 + 1]\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.jd_to_gregorian(jd)\n" ++
    "    a = jd + 32044\n" ++
    "    b = (4 * a + 3) / 146097\n" ++
    "    c = a - 146097 * b / 4\n" ++
    "    d2 = (4 * c + 3) / 1461\n" ++
    "    e = c - 1461 * d2 / 4\n" ++
    "    m2 = (5 * e + 2) / 153\n" ++
    "    [100 * b + d2 - 4800 + m2 / 10, m2 + 3 - 12 * (m2 / 10), e - (153 * m2 + 2) / 5 + 1]\n" ++
    "  end\n" ++
    "\n" ++
    "  # `start` decides which side of the reform a JULIAN DAY falls on, so the\n" ++
    "  # jd -> civil direction needs no search.\n" ++
    "  def self.jd_to_civil(jd, start = ITALY)\n" ++
    "    jd >= start ? jd_to_gregorian(jd) : jd_to_julian(jd)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ...and civil -> jd needs the answer before it can pick the calendar, so it\n" ++
    "  # computes the Gregorian one and keeps it only if it lands on or after the\n" ++
    "  # reform. A date that lands before it is Julian instead.\n" ++
    "  def self.civil_to_jd(y, m, d, start = ITALY)\n" ++
    "    g = gregorian_to_jd(y, m, d)\n" ++
    "    return g if g >= start\n" ++
    "    julian_to_jd(y, m, d)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ THE TEN DAYS THAT DO NOT EXIST. 1582-10-05..14 convert to a Julian day\n" ++
    "  # that is >= start under the Gregorian rule and < start under the Julian\n" ++
    "  # one -- they belong to neither calendar, and ruby raises for them. This is\n" ++
    "  # the only validity question the proleptic version could not ask.\n" ++
    "  def self.valid_civil?(y, m, d, start = ITALY)\n" ++
    "    return false unless y.is_a?(Integer) && m.is_a?(Integer) && d.is_a?(Integer)\n" ++
    "    m = 13 + m if m < 0\n" ++
    "    return false if m < 1 || m > 12\n" ++
    "    # a negative day counts back from the month's last day in the calendar\n" ++
    "    # the month is in -- October 1582 is 21 days long, so -21 is its 1st.\n" ++
    "    if d < 0\n" ++
    "      ny, nm = m == 12 ? [y + 1, 1] : [y, m + 1]\n" ++
    "      jd = civil_to_jd(ny, nm, 1, start) + d\n" ++
    "      cy, cm, _cd = jd_to_civil(jd, start)\n" ++
    "      return cy == y && cm == m\n" ++
    "    end\n" ++
    "    return false if d < 1 || d > 31\n" ++
    "    jd = civil_to_jd(y, m, d, start)\n" ++
    "    jd_to_civil(jd, start) == [y, m, d]\n" ++
    "  end\n" ++
    "\n" ++
    "  # February's length is the one place the two calendars disagree about a\n" ++
    "  # MONTH rather than about a day, so the leap rule has to follow `start` too.\n" ++
    "  def self.__feb29?(y, start = ITALY)\n" ++
    "    return false unless y % 4 == 0\n" ++
    "    jd = gregorian_to_jd(y, 3, 1)\n" ++
    "    jd >= start ? (y % 100 != 0 || y % 400 == 0) : true\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.days_in_month(y, m)\n" ++
    "    return 31 if [1, 3, 5, 7, 8, 10, 12].include?(m)\n" ++
    "    return 30 if [4, 6, 9, 11].include?(m)\n" ++
    "    __feb29?(y) ? 29 : 28\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ `Date.leap?` is the GREGORIAN rule whatever the date, and only the\n" ++
    "  # INSTANCE `#leap?` follows the calendar its receiver was built on. Making\n" ++
    "  # the class method calendar-aware reads as the tidier rule and is wrong:\n" ++
    "  # `Date.leap?(1500)` is false in ruby though 1500 was a leap year on the\n" ++
    "  # Julian calendar that was in use then.\n" ++
    "  def self.leap?(y)\n" ++
    "    gregorian_leap?(y)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.gregorian_leap?(y) = (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0))\n" ++
    "  def self.julian_leap?(y) = (y % 4 == 0)\n" ++
    "\n" ++
    "  def self.new(y = -4712, m = 1, d = 1, start = ITALY)\n" ++
    "    start = ITALY if start.nil?\n" ++
    "    if d.is_a?(Integer) && d < 0 && m.is_a?(Integer) && m >= 1 && m <= 12 && y.is_a?(Integer)\n" ++
    "      len = (m == 2 && __feb29?(y, start)) ? 29 : days_in_month(y, m)\n" ++
    "      d = len + d + 1\n" ++
    "    end\n" ++
    "    raise Date::Error, \"invalid date\" unless valid_civil?(y, m, d, start)\n" ++
    "    allocate.__set_jd(civil_to_jd(y, m, d, start), start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.civil(y = -4712, m = 1, d = 1, start = ITALY)\n" ++
    "    new(y, m, d, start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.jd(n = 0, start = ITALY)\n" ++
    "    start = ITALY if start.nil?\n" ++
    "    allocate.__set_jd(n.to_i, start)\n" ++
    "  end\n" ++
    "\n" ++
    "  # --- the instance side: each Date now CARRIES its start ------------------\n" ++
    "  def __set_jd(n, start = ITALY)\n" ++
    "    @jd = n\n" ++
    "    @start = start\n" ++
    "    @year, @month, @day = Date.jd_to_civil(n, start)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def start = @start.nil? ? ITALY.to_f : @start.to_f\n" ++
    "  def julian? = @jd < (@start || ITALY)\n" ++
    "  def gregorian? = !julian?\n" ++
    "\n" ++
    "  # `new_start` is a real question now: the same instant, read on a calendar\n" ++
    "  # whose reform is elsewhere.\n" ++
    "  def new_start(s = ITALY)\n" ++
    "    s = ITALY if s.nil?\n" ++
    "    Date.jd(@jd, s)\n" ++
    "  end\n" ++
    "\n" ++
    "  def julian = new_start(Date::JULIAN)\n" ++
    "  def gregorian = new_start(Date::GREGORIAN)\n" ++
    "  def italy = new_start(Date::ITALY)\n" ++
    "  def england = new_start(Date::ENGLAND)\n" ++
    "\n" ++
    "  # arithmetic keeps the calendar it was asked on\n" ++
    "  def +(n) = Date.jd(@jd + n.to_i, @start || ITALY)\n" ++
    "  def next_day(n = 1) = Date.jd(@jd + n, @start || ITALY)\n" ++
    "  def prev_day(n = 1) = Date.jd(@jd - n, @start || ITALY)\n" ++
    "\n" ++
    "  # ⚠ A MONTH STEP CAN LAND IN THE GAP. Clamping the day to the month's\n" ++
    "  # length is the ordinary rule (Jan 31 >> 1 is Feb 28), but in the reform\n" ++
    "  # month the clamped day can still be one of the ten that do not exist --\n" ++
    "  # `Date.civil(1583,10,14).prev_year` is 1582-10-14. ruby walks BACK to the\n" ++
    "  # last day that does exist, which is 1582-10-04, so this does too.\n" ++
    "  def >>(n)\n" ++
    "    # a number of months, floored (<< 1.5 goes back two); nothing else\n" ++
    "    raise TypeError, \"expected numeric\" unless n.is_a?(Numeric)\n" ++
    "    n = n.floor\n" ++
    "    st = @start || ITALY\n" ++
    "    y = @year\n" ++
    "    m = @month + n\n" ++
    "    y += (m - 1) / 12\n" ++
    "    m = (m - 1) % 12 + 1\n" ++
    "    len = (m == 2 && Date.__feb29?(y, st)) ? 29 : Date.days_in_month(y, m)\n" ++
    "    d = @day > len ? len : @day\n" ++
    "    d -= 1 while d > 1 && !Date.valid_civil?(y, m, d, st)\n" ++
    "    Date.new(y, m, d, st)\n" ++
    "  end\n" ++
    "\n" ++
    "  def leap? = Date.__feb29?(@year, @start || ITALY)\n" ++
    "end\n" ++
    "\n" ++
    "class Date\n" ++
    "  # `_rfc3339` and its neighbours answer a HASH of the parts, or an empty one\n" ++
    "  # when the string is not that format -- they parse without constructing.\n" ++
    "  def self._rfc3339(str)\n" ++
    "    m = /\\A\\s*(-?\\d+)-(\\d\{2})-(\\d\{2})[Tt ](\\d\{2}):(\\d\{2}):(\\d\{2})(?:\\.\\d+)?(Z|[+-]\\d\{2}:\\d\{2})?\\s*\\z/.match(str.to_s)\n" ++
    "    return \{} if m.nil?\n" ++
    "    zone = m[7]\n" ++
    "    h = \{ year: m[1].to_i, mon: m[2].to_i, mday: m[3].to_i,\n" ++
    "          hour: m[4].to_i, min: m[5].to_i, sec: m[6].to_i }\n" ++
    "    return h if zone.nil?\n" ++
    "    off = zone == \"Z\" ? 0 : (zone[1, 2].to_i * 3600 + zone[4, 2].to_i * 60) * (zone[0] == \"-\" ? -1 : 1)\n" ++
    "    h[:zone] = zone\n" ++
    "    h[:offset] = off\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # a date and time (RFC 3339's shape), or a calendar date alone,\n" ++
    "  # extended (2008-02-03) or basic (20080203); nil is nothing, and\n" ++
    "  # something that is not a String is a TypeError\n" ++
    "  def self._iso8601(str, limit: 128)\n" ++
    "    return \{} if str.nil?\n" ++
    "    raise TypeError, \"no implicit conversion of #\{str.class} into String\" unless str.respond_to?(:to_str)\n" ++
    "    h = _rfc3339(str.to_str)\n" ++
    "    return h unless h.empty?\n" ++
    "    m = /\\A\\s*([-+]?\\d\{4,})-?(\\d\\d)-?(\\d\\d)\\s*\\z/.match(str.to_str)\n" ++
    "    m ? \{ year: m[1].to_i, mon: m[2].to_i, mday: m[3].to_i } : \{}\n" ++
    "  end\n" ++
    "  def self._xmlschema(str) = _rfc3339(str)\n" ++
    "\n" ++
    "  # ⚠ `valid_civil?` and `valid_date?` are ONE method under two names, and\n" ++
    "  # the spec reads `Date.method(:valid_civil?) == Date.method(:valid_date?)`.\n" ++
    "  # Two definitions with identical bodies answer the same values and fail that.\n" ++
    "  class << self\n" ++
    "    alias_method :valid_date?, :valid_civil?\n" ++
    "  end\n" ++
    "\n" ++
    "  # `+` takes a number. Anything else is a TypeError naming what was wanted,\n" ++
    "  # not a NoMethodError from whatever the argument failed to answer.\n" ++
    "  def +(n)\n" ++
    "    raise TypeError, \"expected numeric\" unless n.is_a?(Numeric)\n" ++
    "    Date.jd(@jd + n.to_i, @start || ITALY)\n" ++
    "  end\n" ++
    "\n" ++
    "  def -(other)\n" ++
    "    return Date.jd(@jd - other.to_i, @start || ITALY) if other.is_a?(Numeric)\n" ++
    "    return Rational(@jd - other.jd, 1) if other.is_a?(Date)\n" ++
    "    raise TypeError, \"expected numeric or date\"\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "# DateTime keeps its time as whole fields plus an exact fraction of a\n" ++
    "# second, and does its arithmetic in (Rational) seconds: + and - move by\n" ++
    "# a fraction of a day, and a difference is a fraction of a day. It used\n" ++
    "# to inherit Date's whole-day arithmetic, so `+ 0.5` did nothing.\n" ++
    "class DateTime < Date\n" ++
    "  def self.civil(y = -4712, m = 1, d = 1, h = 0, min = 0, s = 0, off = 0, start = nil)\n" ++
    "    new(y, m, d, h, min, s, off, start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.parse(str = \"-4712-01-01T00:00:00+00:00\", comp = true, _start = nil, limit: 128)\n" ++
    "    h = Date._parse(str, comp)\n" ++
    "    raise Date::Error, \"invalid date\" if h.empty?\n" ++
    "    y, m, d = Date.__parsed_civil(h)\n" ++
    "    raise Date::Error, \"invalid date\" unless Date.valid_civil?(y, m, d)\n" ++
    "    hr, mi, se = h[:hour] || 0, h[:min] || 0, h[:sec] || 0\n" ++
    "    raise Date::Error, \"invalid date\" if hr > 24 || mi > 59 || se > 60\n" ++
    "    new(y, m, d, hr, mi, se)\n" ++
    "  end\n" ++
    "\n" ++
    "  def __set_time(h, mi, s)\n" ++
    "    @hour = h\n" ++
    "    @minute = mi\n" ++
    "    if s.is_a?(Integer)\n" ++
    "      @second = s\n" ++
    "      @sec_frac = Rational(0, 1)\n" ++
    "    else\n" ++
    "      r = s.is_a?(Float) ? s.rationalize : Rational(s)\n" ++
    "      @second = r.floor\n" ++
    "      @sec_frac = r - @second\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def sec_fraction = @sec_frac || Rational(0, 1)\n" ++
    "  alias_method :second_fraction, :sec_fraction\n" ++
    "  def day_fraction = Rational(hour * 3600 + minute * 60 + second, 86400) + sec_fraction / 86400\n" ++
    "\n" ++
    "  # seconds since jd 0, on the local clock and on UTC\n" ++
    "  def __local_seconds = jd * 86400 + hour * 3600 + minute * 60 + second + sec_fraction\n" ++
    "  def __utc_seconds = __local_seconds - offset * 86400\n" ++
    "\n" ++
    "  def self.__from_local(total, off, start = nil)\n" ++
    "    j = (total / 86400).floor\n" ++
    "    rem = total - j * 86400\n" ++
    "    h = (rem / 3600).floor\n" ++
    "    rem -= h * 3600\n" ++
    "    mi = (rem / 60).floor\n" ++
    "    sec = rem - mi * 60\n" ++
    "    y, m, d = Date.jd_to_civil(j)\n" ++
    "    new(y, m, d, h, mi, sec.denominator == 1 ? sec.to_i : sec, off, start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def +(n)\n" ++
    "    raise TypeError, \"expected numeric\" unless n.is_a?(Numeric)\n" ++
    "    days = n.is_a?(Float) ? n.rationalize : Rational(n)\n" ++
    "    DateTime.__from_local(__local_seconds + days * 86400, offset, @start)\n" ++
    "  end\n" ++
    "\n" ++
    "  def -(other)\n" ++
    "    return self + (-other) if other.is_a?(Numeric)\n" ++
    "    if other.is_a?(DateTime)\n" ++
    "      return Rational(__utc_seconds - other.__utc_seconds, 86400)\n" ++
    "    end\n" ++
    "    return Rational(__utc_seconds - other.jd * 86400, 86400) if other.is_a?(Date)\n" ++
    "    raise TypeError, \"expected numeric or date\"\n" ++
    "  end\n" ++
    "\n" ++
    "  # Time's calendar is always the Gregorian one\n" ++
    "  def to_time\n" ++
    "    gy, gm, gd = Date.jd_to_gregorian(jd)\n" ++
    "    Time.new(gy, gm, gd, hour, minute, second + sec_fraction, __off_s)\n" ++
    "  end\n" ++
    "\n" ++
    "  def deconstruct_keys(keys)\n" ++
    "    unless keys.nil? || keys.is_a?(Array)\n" ++
    "      raise TypeError, \"wrong argument type #\{keys.class} (expected Array or nil)\"\n" ++
    "    end\n" ++
    "    all = \{ year: year, month: month, day: day, yday: yday, wday: wday, hour: hour, min: minute,\n" ++
    "            sec: second, sec_fraction: sec_fraction, zone: zone }\n" ++
    "    return all if keys.nil?\n" ++
    "    h = \{}\n" ++
    "    keys.each \{ |k| h[k] = all[k] if all.key?(k) }\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # the day number, seconds and nanoseconds on UTC, the offset and the reform\n" ++
    "  def inspect\n" ++
    "    u = __utc_seconds\n" ++
    "    j = (u / 86400).floor\n" ++
    "    secs = u - j * 86400\n" ++
    "    whole = secs.floor\n" ++
    "    ns = ((secs - whole) * 1_000_000_000).floor\n" ++
    "    offs = (offset * 86400).round\n" ++
    "    st = start\n" ++
    "    sts = st.infinite? ? (st < 0 ? \"-Inf\" : \"Inf\") : st.to_i.to_s\n" ++
    "    \"#<DateTime: #\{self} ((#\{j}j,#\{whole}s,#\{ns}n),#\{offs < 0 ? '-' : '+'}#\{offs.abs}s,#\{sts}j)>\"\n" ++
    "  end\n" ++
    "\n" ++
    "  # the one strftime engine, with the time of day, the fraction and the\n" ++
    "  # offset this DateTime carries\n" ++
    "  def strftime(fmt = \"%FT%T%:z\")\n" ++
    "    Time.__strf(fmt, [year, month, day, yday, wday, hour, minute, second, sec_fraction,\n" ++
    "                      (offset * 86400).round, false, zone, __utc_seconds - 2440588 * 86400, true])\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "# DateTime.new as date_core's datetime_s_civil checks it. ⚠ It took any\n" ++
    "# fields: an hour of -10 stayed -10, 25 and 1.5 were accepted, a Rational\n" ++
    "# day was dropped. A fraction is allowed only in the LAST argument given\n" ++
    "# (num2int_with_frac), where it carries into the fields below; a negative\n" ++
    "# hour, minute or second counts back from the end of the day, hour or\n" ++
    "# minute; hour 24 is the next day's midnight; and anything else is\n" ++
    "# Date::Error \"invalid date\".\n" ++
    "class DateTime\n" ++
    "  class << self\n" ++
    "    alias_method :__new_fields, :new\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.new(*args)\n" ++
    "    if args.size > 8\n" ++
    "      raise ArgumentError, \"wrong number of arguments (given #\{args.size}, expected 0..8)\"\n" ++
    "    end\n" ++
    "    y, m, d, h, mi, s, off, _st = args\n" ++
    "    n = args.size\n" ++
    "    y = -4712 if y.nil?\n" ++
    "    m = 1 if m.nil?\n" ++
    "    d = 1 if d.nil?\n" ++
    "    h = 0 if h.nil?\n" ++
    "    mi = 0 if mi.nil?\n" ++
    "    s = 0 if s.nil?\n" ++
    "    off = 0 if off.nil?\n" ++
    "    split = lambda do |v, pos|\n" ++
    "      next [v, 0] if v.is_a?(Integer)\n" ++
    "      r = v.is_a?(Numeric) ? v.to_r : v\n" ++
    "      i = r.floor\n" ++
    "      fr = r - i\n" ++
    "      raise Date::Error, \"invalid fraction\" if fr != 0 && n > pos\n" ++
    "      [i, fr]\n" ++
    "    end\n" ++
    "    d, dfr = split.(d, 3)\n" ++
    "    h, hfr = split.(h, 4)\n" ++
    "    mi, mfr = split.(mi, 5)\n" ++
    "    si, sfr = split.(s, 99)\n" ++
    "    h += 24 if h < 0\n" ++
    "    mi += 60 if mi < 0\n" ++
    "    si += 60 if si < 0\n" ++
    "    if h < 0 || h > 24 || mi < 0 || mi > 59 || si < 0 || si > 59 || (h == 24 && (mi > 0 || si > 0))\n" ++
    "      raise Date::Error, \"invalid date\"\n" ++
    "    end\n" ++
    "    next_day = h == 24\n" ++
    "    h = 0 if next_day\n" ++
    "    obj = __new_fields(y, m, d, h, mi, sfr == 0 ? si : si + sfr, off)\n" ++
    "    obj += 1 if next_day\n" ++
    "    carry = dfr * 86400 + hfr * 3600 + mfr * 60\n" ++
    "    obj += Rational(carry, 86400) if carry != 0\n" ++
    "    obj\n" ++
    "  end\n" ++
    "\n" ++
    "  # DateTime.jd with the time of day: the calendar day of that Julian Day\n" ++
    "  # (read in `start`'s calendar), then its clock\n" ++
    "  def self.jd(jd = 0, h = 0, min = 0, s = 0, off = 0, start = Date::ITALY)\n" ++
    "    d = Date.jd(jd, start)\n" ++
    "    new(d.year, d.month, d.day, h, min, s, off)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "# date's own additions to Time: the day, and the instant, in the default\n" ++
    "# calendar reform. The Julian Day comes from Time's proleptic Gregorian\n" ++
    "# fields; the civil fields a Date then shows are its own calendar's.\n" ++
    "class Time\n" ++
    "  def to_date = Date.jd(Date.civil_to_jd(year, mon, mday, Date::GREGORIAN))\n" ++
    "\n" ++
    "  def to_datetime\n" ++
    "    DateTime.jd(Date.civil_to_jd(year, mon, mday, Date::GREGORIAN), hour, min, sec + subsec, Rational(utc_offset, 86400))\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "tmpdir" then
    "# tmpdir: Dir.tmpdir is a primitive; this adds Dir.mktmpdir and the few\n" ++
    "# FileUtils calls it makes (ruby's tmpdir requires fileutils for them).\n" ++
    "module FileUtils\n" ++
    "  def self.remove_entry(path, force = false)\n" ++
    "    if File.directory?(path) && !File.symlink?(path)\n" ++
    "      Dir.children(path).each \{ |c| remove_entry(File.join(path, c), force) }\n" ++
    "      Dir.rmdir(path)\n" ++
    "    elsif File.exist?(path) || File.symlink?(path)\n" ++
    "      File.delete(path)\n" ++
    "    elsif !force\n" ++
    "      raise Errno::ENOENT, path\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "  def self.remove_entry_secure(path, force = false) = remove_entry(path, force)\n" ++
    "  def self.rm_rf(list)\n" ++
    "    Array(list).each \{ |p| remove_entry(p, true) }\n" ++
    "  end\n" ++
    "  def self.mkdir_p(list)\n" ++
    "    Array(list).each do |p|\n" ++
    "      next if File.directory?(p)\n" ++
    "      mkdir_p(File.dirname(p)) unless File.directory?(File.dirname(p))\n" ++
    "      Dir.mkdir(p)\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    "class Dir\n" ++
    "  def self.mktmpdir(prefix_suffix = nil, tmpdir = nil, **options)\n" ++
    "    prefix, suffix =\n" ++
    "      case prefix_suffix\n" ++
    "      when nil then [\"d\", \"\"]\n" ++
    "      when String then [prefix_suffix, \"\"]\n" ++
    "      when Array then [prefix_suffix[0].to_s, prefix_suffix[1].to_s]\n" ++
    "      else raise ArgumentError, \"unexpected prefix_suffix: #\{prefix_suffix.inspect}\"\n" ++
    "      end\n" ++
    "    base = tmpdir || Dir.tmpdir\n" ++
    "    name = \"#\{prefix}#\{Time.now.strftime('%Y%m%d')}-#\{Process.pid}-#\{rand(0x100000000).to_s(36)}#\{suffix}\"\n" ++
    "    path = File.join(base, name)\n" ++
    "    Dir.mkdir(path, 0700)\n" ++
    "    return path unless block_given?\n" ++
    "    begin\n" ++
    "      yield path.dup\n" ++
    "    ensure\n" ++
    "      FileUtils.remove_entry(path)\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "logger" then
    "class Logger\n" ++
    "  module Severity\n" ++
    "    DEBUG = 0\n" ++
    "    INFO = 1\n" ++
    "    WARN = 2\n" ++
    "    ERROR = 3\n" ++
    "    FATAL = 4\n" ++
    "    UNKNOWN = 5\n" ++
    "  end\n" ++
    "  include Severity\n" ++
    "  DEBUG = 0\n" ++
    "  INFO = 1\n" ++
    "  WARN = 2\n" ++
    "  ERROR = 3\n" ++
    "  FATAL = 4\n" ++
    "  UNKNOWN = 5\n" ++
    "\n" ++
    "  SEV_LABEL = [\"DEBUG\", \"INFO\", \"WARN\", \"ERROR\", \"FATAL\", \"ANY\"]\n" ++
    "\n" ++
    "  class Error < RuntimeError; end\n" ++
    "  class ShiftingError < Error; end\n" ++
    "\n" ++
    "  # The destination. A path is opened (and created) on first use; an IO is\n" ++
    "  # written to as it stands and is NOT closed with the logger unless it was\n" ++
    "  # this object that opened it.\n" ++
    "  class LogDevice\n" ++
    "    attr_reader :dev, :filename\n" ++
    "\n" ++
    "    def initialize(log = nil, opt = \{})\n" ++
    "      @dev = nil\n" ++
    "      @filename = nil\n" ++
    "      @owned = false\n" ++
    "      if log.respond_to?(:write) && log.respond_to?(:close)\n" ++
    "        @dev = log\n" ++
    "      elsif log\n" ++
    "        @filename = log.to_s\n" ++
    "        fresh = !File.exist?(@filename)\n" ++
    "        @dev = File.open(@filename, \"a\")\n" ++
    "        @owned = true\n" ++
    "        # ⚠ A FILE THIS OBJECT CREATED GETS THE HEADER LINE, one it was handed\n" ++
    "        # does not. The LogDevice#write spec reads the whole file back and\n" ++
    "        # requires EXACTLY one line, a comment, after writing an empty message.\n" ++
    "        @dev.write(\"# Logfile created on #\{Time.now} by logger.rb/v1.7.0\\n\") if fresh\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    # ⚠ A write failure is REPORTED, per phase, and the phases are\n" ++
    "    # ruby's: a device handed an IO checks for rotation first (its #stat),\n" ++
    "    # which is where a closed stream is noticed -- \"log shifting failed.\"\n" ++
    "    # -- and then the write itself fails as \"log writing failed.\". A\n" ++
    "    # device the Logger opened from a path (shift_age 0) skips the check.\n" ++
    "    # Asked of the reference. The one message here was always \"shifting\",\n" ++
    "    # and the write that raised it never reached a Logger's caller.\n" ++
    "    def write(message)\n" ++
    "      return if @dev.nil?\n" ++
    "      unless @owned\n" ++
    "        begin\n" ++
    "          @dev.stat if @dev.respond_to?(:stat)\n" ++
    "        rescue StandardError => e\n" ++
    "          warn(\"log shifting failed. \" + e.message)\n" ++
    "        end\n" ++
    "      end\n" ++
    "      begin\n" ++
    "        @dev.write(message)\n" ++
    "        @dev.flush if @dev.respond_to?(:flush)\n" ++
    "      rescue StandardError => e\n" ++
    "        warn(\"log writing failed. \" + e.message)\n" ++
    "        return nil\n" ++
    "      end\n" ++
    "      message.to_s.length\n" ++
    "    end\n" ++
    "\n" ++
    "    # ruby closes the device whoever opened it -- the LogDevice#close spec\n" ++
    "    # hands it a File and expects that File to be closed afterwards.\n" ++
    "    def close\n" ++
    "      return if @dev.nil?\n" ++
    "      begin\n" ++
    "        @dev.close unless @dev.closed?\n" ++
    "      rescue StandardError\n" ++
    "      end\n" ++
    "      nil\n" ++
    "    end\n" ++
    "\n" ++
    "    def reopen(log = nil)\n" ++
    "      close\n" ++
    "      @owned = false\n" ++
    "      if log.respond_to?(:write)\n" ++
    "        @dev = log\n" ++
    "      elsif log\n" ++
    "        @filename = log.to_s\n" ++
    "        @dev = File.open(@filename, \"a\")\n" ++
    "        @owned = true\n" ++
    "      elsif @filename\n" ++
    "        @dev = File.open(@filename, \"a\")\n" ++
    "        @owned = true\n" ++
    "      end\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # The default line, which the specs read through `strip_date`:\n" ++
    "  #   \"W, [2026-09-22T12:00:00.000000 #123]  WARN -- progname: message\\n\"\n" ++
    "  class Formatter\n" ++
    "    Format = \"%s, [%s #%d] %5s -- %s: %s\\n\"\n" ++
    "    attr_accessor :datetime_format\n" ++
    "\n" ++
    "    def initialize\n" ++
    "      @datetime_format = nil\n" ++
    "    end\n" ++
    "\n" ++
    "    def call(severity, time, progname, msg)\n" ++
    "      format(Format, severity[0, 1], format_datetime(time), Process.pid,\n" ++
    "             severity, progname, msg2str(msg))\n" ++
    "    end\n" ++
    "\n" ++
    "    def format_datetime(time)\n" ++
    "      if @datetime_format.nil?\n" ++
    "        time.strftime(\"%Y-%m-%dT%H:%M:%S.\") << format(\"%06d\", time.usec)\n" ++
    "      else\n" ++
    "        time.strftime(@datetime_format)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def msg2str(msg)\n" ++
    "      case msg\n" ++
    "      when ::String then msg\n" ++
    "      when ::Exception then \"#\{msg.message} (#\{msg.class})\"\n" ++
    "      else msg.inspect\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  attr_accessor :progname, :formatter\n" ++
    "  attr_reader :level\n" ++
    "\n" ++
    "  def initialize(logdev, _shift_age = 0, _shift_size = 1048576, level: DEBUG,\n" ++
    "                 progname: nil, formatter: nil, datetime_format: nil, **_rest)\n" ++
    "    @level = level\n" ++
    "    @progname = progname\n" ++
    "    @default_formatter = Formatter.new\n" ++
    "    @default_formatter.datetime_format = datetime_format if datetime_format\n" ++
    "    @formatter = formatter\n" ++
    "    @logdev = logdev.nil? ? nil : LogDevice.new(logdev)\n" ++
    "  end\n" ++
    "\n" ++
    "  def level=(v)\n" ++
    "    @level = v.is_a?(Integer) ? v : self.class.__coerce_severity(v)\n" ++
    "  end\n" ++
    "  alias sev_threshold level\n" ++
    "  alias sev_threshold= level=\n" ++
    "\n" ++
    "  def self.__coerce_severity(v)\n" ++
    "    i = SEV_LABEL.index(v.to_s.upcase)\n" ++
    "    raise ArgumentError, \"invalid log level: #\{v}\" if i.nil?\n" ++
    "    i\n" ++
    "  end\n" ++
    "\n" ++
    "  def datetime_format = @default_formatter.datetime_format\n" ++
    "  def datetime_format=(v) = @default_formatter.datetime_format = v\n" ++
    "\n" ++
    "  def debug? = @level <= DEBUG\n" ++
    "  def info? = @level <= INFO\n" ++
    "  def warn? = @level <= WARN\n" ++
    "  def error? = @level <= ERROR\n" ++
    "  def fatal? = @level <= FATAL\n" ++
    "\n" ++
    "  def add(severity, message = nil, progname = nil)\n" ++
    "    severity ||= UNKNOWN\n" ++
    "    return true if @logdev.nil? || severity < @level\n" ++
    "    if message.nil?\n" ++
    "      if block_given?\n" ++
    "        message = yield\n" ++
    "      else\n" ++
    "        message = progname\n" ++
    "        progname = @progname\n" ++
    "      end\n" ++
    "    end\n" ++
    "    progname = @progname if progname.nil?\n" ++
    "    @logdev.write((@formatter || @default_formatter).call(\n" ++
    "      SEV_LABEL[severity] || \"ANY\", Time.now, progname, message))\n" ++
    "    true\n" ++
    "  end\n" ++
    "  alias log add\n" ++
    "\n" ++
    "  def debug(progname = nil, &block) = add(DEBUG, nil, progname, &block)\n" ++
    "  def info(progname = nil, &block) = add(INFO, nil, progname, &block)\n" ++
    "  def warn(progname = nil, &block) = add(WARN, nil, progname, &block)\n" ++
    "  def error(progname = nil, &block) = add(ERROR, nil, progname, &block)\n" ++
    "  def fatal(progname = nil, &block) = add(FATAL, nil, progname, &block)\n" ++
    "  def unknown(progname = nil, &block) = add(UNKNOWN, nil, progname, &block)\n" ++
    "\n" ++
    "  def <<(msg)\n" ++
    "    @logdev.write(msg) unless @logdev.nil?\n" ++
    "  end\n" ++
    "\n" ++
    "  def close\n" ++
    "    @logdev.close unless @logdev.nil?\n" ++
    "  end\n" ++
    "\n" ++
    "  def reopen(logdev = nil)\n" ++
    "    @logdev.reopen(logdev) unless @logdev.nil?\n" ++
    "    self\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "yaml" || str_eq n "psych" then
    "# A YAML *loader* subset: block mappings, block sequences, flow collections,\n" ++
    "# the scalar types Ruby maps, comments, and multiple documents. No emitter, no\n" ++
    "# anchors/aliases, no tags beyond the implicit ones. Enough for the\n" ++
    "# configuration and data files gems actually ship.\n" ++
    "module Psych\n" ++
    "  # the reference's version, which specs gate on (library/yaml)\n" ++
    "  VERSION = \"5.3.1\"\n" ++
    "  class SyntaxError < StandardError; end\n" ++
    "  class DisallowedClass < StandardError; end\n" ++
    "\n" ++
    "  # one physical line, already split into indent / content\n" ++
    "  class Line\n" ++
    "    attr_reader :indent, :text\n" ++
    "    def initialize(indent, text)\n" ++
    "      @indent = indent\n" ++
    "      @text = text\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.strip_comment(s)\n" ++
    "    out = +\"\"\n" ++
    "    i = 0\n" ++
    "    quote = nil\n" ++
    "    while i < s.length\n" ++
    "      c = s[i]\n" ++
    "      if quote\n" ++
    "        out << c\n" ++
    "        if c == \"\\\\\" && quote == '\"' && i + 1 < s.length\n" ++
    "          out << s[i + 1]\n" ++
    "          i += 1\n" ++
    "        elsif c == quote\n" ++
    "          quote = nil\n" ++
    "        end\n" ++
    "      elsif c == '\"' || c == \"'\"\n" ++
    "        quote = c\n" ++
    "        out << c\n" ++
    "      elsif c == \"#\" && (i == 0 || s[i - 1] == \" \" || s[i - 1] == \"\\t\")\n" ++
    "        break\n" ++
    "      else\n" ++
    "        out << c\n" ++
    "      end\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    out.rstrip\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.lines_of(src)\n" ++
    "    out = []\n" ++
    "    open_depth = 0\n" ++
    "    src.to_s.split(\"\\n\", -1).each do |raw|\n" ++
    "      body = strip_comment(raw)\n" ++
    "      next if body.strip.empty?\n" ++
    "      # a flow collection may run over several lines: until its brackets\n" ++
    "      # close, each line continues the one it started on\n" ++
    "      if open_depth > 0\n" ++
    "        out.last.instance_variable_set(:@text, out.last.text + \" \" + body.strip)\n" ++
    "        open_depth += flow_depth(body)\n" ++
    "        next\n" ++
    "      end\n" ++
    "      indent = 0\n" ++
    "      indent += 1 while indent < body.length && body[indent] == \" \"\n" ++
    "      out << Line.new(indent, body[indent..] || \"\")\n" ++
    "      open_depth = flow_depth(body)\n" ++
    "      open_depth = 0 if open_depth < 0\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  # how many [ and \{ this text leaves open, outside quotes\n" ++
    "  def self.flow_depth(s)\n" ++
    "    d = 0\n" ++
    "    quote = nil\n" ++
    "    s.each_char do |c|\n" ++
    "      if quote\n" ++
    "        quote = nil if c == quote\n" ++
    "      elsif c == '\"' || c == \"'\"\n" ++
    "        quote = c\n" ++
    "      elsif c == \"[\" || c == \"\{\"\n" ++
    "        d += 1\n" ++
    "      elsif c == \"]\" || c == \"}\"\n" ++
    "        d -= 1\n" ++
    "      end\n" ++
    "    end\n" ++
    "    d\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- scalars ------------------------------------------------------------\n" ++
    "\n" ++
    "  def self.unescape_double(s)\n" ++
    "    out = +\"\"\n" ++
    "    i = 0\n" ++
    "    while i < s.length\n" ++
    "      c = s[i]\n" ++
    "      if c == \"\\\\\" && i + 1 < s.length\n" ++
    "        i += 1\n" ++
    "        case s[i]\n" ++
    "        when \"n\" then out << \"\\n\"\n" ++
    "        when \"t\" then out << \"\\t\"\n" ++
    "        when \"r\" then out << \"\\r\"\n" ++
    "        when \"0\" then out << \"\\0\"\n" ++
    "        when \"\\\\\" then out << \"\\\\\"\n" ++
    "        when '\"' then out << '\"'\n" ++
    "        else out << s[i]\n" ++
    "        end\n" ++
    "      else\n" ++
    "        out << c\n" ++
    "      end\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  INT_RE = /\\A[-+]?\\d+\\z/\n" ++
    "  # YAML 1.1: a float needs a decimal point, and an exponent needs a SIGN.\n" ++
    "  # So \"1e3\" and \"1.0e3\" are Strings; \"1.0e+3\" and \"1.0E-3\" are Floats.\n" ++
    "  FLOAT_RE = /\\A[-+]?(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][-+]\\d+)?\\z/\n" ++
    "  INF_RE = /\\A[-+]?\\.(?:inf|Inf|INF)\\z/\n" ++
    "  # psych's ScalarScanner: a timestamp and a date. unsafe_load answers them as\n" ++
    "  # Time and Date (load, which permits neither, keeps the text as it always has)\n" ++
    "  TIME_RE = /\\A-?\\d\{4}-\\d\{1,2}-\\d\{1,2}(?:[Tt]|\\s+)\\d\{1,2}:\\d\\d:\\d\\d(?:\\.\\d*)?(?:\\s*(?:Z|[-+]\\d\{1,2}:?(?:\\d\\d)?))?\\z/\n" ++
    "  DATE_RE = /\\A\\d\{4}-(?:1[012]|0\\d|\\d)-(?:[12]\\d|3[01]|0\\d|\\d)\\z/\n" ++
    "\n" ++
    "  # ScalarScanner#parse_time, as psych writes it: the fraction is exact and\n" ++
    "  # cut to microseconds, Z is UTC, no zone is local, and an offset is fixed\n" ++
    "  def self.parse_time(string)\n" ++
    "    date, time = *(string.split(/[ tT]/, 2))\n" ++
    "    yy, m, dd = date.match(/\\A(-?\\d\{4})-(\\d\{1,2})-(\\d\{1,2})/).captures.map \{ |x| x.to_i }\n" ++
    "    md = time.match(/(\\d+:\\d+:\\d+)(?:\\.(\\d*))?\\s*(Z|[-+]\\d+(:\\d\\d)?)?/)\n" ++
    "    hh, mm, ss = md[1].split(\":\").map \{ |x| x.to_i }\n" ++
    "    us = (md[2] ? Rational(\"0.#\{md[2]}\") : 0) * 1000000\n" ++
    "    t = Time.utc(yy, m, dd, hh, mm, ss, us)\n" ++
    "    return t if md[3] == \"Z\"\n" ++
    "    return Time.at(t.to_i, us) unless md[3]\n" ++
    "    tz = md[3].match(/\\A([+\\-]?\\d\{1,2}):?(\\d\{1,2})?\\z/)[1..-1].compact.map \{ |digit| Integer(digit, 10) }\n" ++
    "    offset = tz.first * 3600\n" ++
    "    offset < 0 ? offset -= ((tz[1] || 0) * 60) : offset += ((tz[1] || 0) * 60)\n" ++
    "    Time.new(yy, m, dd, hh, mm, ss + us / 1_000_000r, offset)\n" ++
    "  end\n" ++
    "  NAN_RE = /\\A\\.(?:nan|NaN|NAN)\\z/\n" ++
    "\n" ++
    "  def self.scalar(s)\n" ++
    "    t = s.strip\n" ++
    "    return nil if t.empty?\n" ++
    "    if t.start_with?('\"') && t.end_with?('\"') && t.length >= 2\n" ++
    "      return unescape_double(t[1..-2])\n" ++
    "    end\n" ++
    "    if t.start_with?(\"'\") && t.end_with?(\"'\") && t.length >= 2\n" ++
    "      return t[1..-2].gsub(\"''\", \"'\")\n" ++
    "    end\n" ++
    "    return nil if t == \"~\" || t == \"null\" || t == \"Null\" || t == \"NULL\"\n" ++
    "    # \"!ruby/object:Klass \{ ivars }\": an allocated instance (initialize is not\n" ++
    "    # run) with the mapping's entries as its ivars -- unsafe_load only\n" ++
    "    if @__unsafe && t.start_with?(\"!ruby/object:\")\n" ++
    "      name, rest = t[13..].split(\" \", 2)\n" ++
    "      obj = name.split(\"::\").inject(Object) \{ |m, c| m.const_get(c) }.allocate\n" ++
    "      h = rest ? scalar(rest) : \{}\n" ++
    "      h.each \{ |k, v| obj.instance_variable_set(\"@#\{k}\", v) } if h.is_a?(Hash)\n" ++
    "      return obj\n" ++
    "    end\n" ++
    "    return true if t == \"true\" || t == \"True\" || t == \"TRUE\"\n" ++
    "    return false if t == \"false\" || t == \"False\" || t == \"FALSE\"\n" ++
    "    return t[1..].to_sym if t.start_with?(\":\") && t.length > 1\n" ++
    "    return (t.start_with?(\"-\") ? -Float::INFINITY : Float::INFINITY) if INF_RE.match?(t)\n" ++
    "    return Float::NAN if NAN_RE.match?(t)\n" ++
    "    return t.to_i if INT_RE.match?(t)\n" ++
    "    return t.to_f if FLOAT_RE.match?(t)\n" ++
    "    if @__unsafe\n" ++
    "      return parse_time(t) if TIME_RE.match?(t)\n" ++
    "      if DATE_RE.match?(t)\n" ++
    "        require \"date\"\n" ++
    "        return Date.strptime(t, \"%F\", Date::GREGORIAN)\n" ++
    "      end\n" ++
    "    end\n" ++
    "    if t.start_with?(\"[\") && t.end_with?(\"]\")\n" ++
    "      return flow_seq(t[1..-2])\n" ++
    "    end\n" ++
    "    if t.start_with?(\"\{\") && t.end_with?(\"}\")\n" ++
    "      return flow_map(t[1..-2])\n" ++
    "    end\n" ++
    "    t\n" ++
    "  end\n" ++
    "\n" ++
    "  # split on commas that are not inside quotes or nested brackets\n" ++
    "  def self.split_flow(s)\n" ++
    "    parts = []\n" ++
    "    cur = +\"\"\n" ++
    "    depth = 0\n" ++
    "    quote = nil\n" ++
    "    i = 0\n" ++
    "    while i < s.length\n" ++
    "      c = s[i]\n" ++
    "      if quote\n" ++
    "        cur << c\n" ++
    "        quote = nil if c == quote\n" ++
    "      elsif c == '\"' || c == \"'\"\n" ++
    "        quote = c\n" ++
    "        cur << c\n" ++
    "      elsif c == \"[\" || c == \"\{\"\n" ++
    "        depth += 1\n" ++
    "        cur << c\n" ++
    "      elsif c == \"]\" || c == \"}\"\n" ++
    "        depth -= 1\n" ++
    "        cur << c\n" ++
    "      elsif c == \",\" && depth == 0\n" ++
    "        parts << cur\n" ++
    "        cur = +\"\"\n" ++
    "      else\n" ++
    "        cur << c\n" ++
    "      end\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    parts << cur unless cur.strip.empty? && parts.empty? && s.strip.empty?\n" ++
    "    parts << cur if !cur.strip.empty? && parts.last != cur\n" ++
    "    parts.reject \{ |x| x.strip.empty? }\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.flow_seq(inner)\n" ++
    "    split_flow(inner).map \{ |x| scalar(x) }\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.flow_map(inner)\n" ++
    "    h = \{}\n" ++
    "    split_flow(inner).each do |pair|\n" ++
    "      k, v = split_key(pair)\n" ++
    "      next unless k\n" ++
    "      h[scalar(k)] = scalar(v)\n" ++
    "    end\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # split \"key: value\" at the first colon that ends a key (followed by space\n" ++
    "  # or end of string), skipping quotes. Returns nil when the line is not a pair.\n" ++
    "  def self.split_key(s)\n" ++
    "    quote = nil\n" ++
    "    i = 0\n" ++
    "    while i < s.length\n" ++
    "      c = s[i]\n" ++
    "      if quote\n" ++
    "        quote = nil if c == quote\n" ++
    "      elsif c == '\"' || c == \"'\"\n" ++
    "        quote = c\n" ++
    "      elsif c == \":\" && (i + 1 == s.length || s[i + 1] == \" \")\n" ++
    "        return [s[0, i], s[(i + 1)..] || \"\"]\n" ++
    "      end\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- block structure ----------------------------------------------------\n" ++
    "\n" ++
    "  # parse the lines at `lines[idx]`'s indentation as one node; returns\n" ++
    "  # [value, next_index].\n" ++
    "  def self.parse_node(lines, idx, indent)\n" ++
    "    return [nil, idx] if idx >= lines.size\n" ++
    "    line = lines[idx]\n" ++
    "    return [nil, idx] if line.indent < indent\n" ++
    "    if line.text.start_with?(\"- \") || line.text == \"-\"\n" ++
    "      parse_seq(lines, idx, line.indent)\n" ++
    "    else\n" ++
    "      parse_map(lines, idx, line.indent)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.parse_seq(lines, idx, indent)\n" ++
    "    out = []\n" ++
    "    while idx < lines.size\n" ++
    "      line = lines[idx]\n" ++
    "      break if line.indent < indent\n" ++
    "      break unless line.text.start_with?(\"- \") || line.text == \"-\"\n" ++
    "      rest = line.text == \"-\" ? \"\" : line.text[2..]\n" ++
    "      if rest.strip.empty?\n" ++
    "        idx += 1\n" ++
    "        if idx < lines.size && lines[idx].indent > indent\n" ++
    "          v, idx = parse_node(lines, idx, lines[idx].indent)\n" ++
    "          out << v\n" ++
    "        else\n" ++
    "          out << nil\n" ++
    "        end\n" ++
    "      elsif (kv = split_key(rest))\n" ++
    "        # \"- key: value\" opens a mapping whose keys align past the dash\n" ++
    "        sub = [Line.new(indent + 2, rest)]\n" ++
    "        j = idx + 1\n" ++
    "        while j < lines.size && lines[j].indent > indent\n" ++
    "          sub << lines[j]\n" ++
    "          j += 1\n" ++
    "        end\n" ++
    "        v, = parse_map(sub, 0, indent + 2)\n" ++
    "        out << v\n" ++
    "        idx = j\n" ++
    "      elsif rest.strip.start_with?(\"-\")\n" ++
    "        # \"- - a\" : a nested sequence starting on the same line\n" ++
    "        sub = [Line.new(indent + 2, rest.strip)]\n" ++
    "        j = idx + 1\n" ++
    "        while j < lines.size && lines[j].indent > indent\n" ++
    "          sub << lines[j]\n" ++
    "          j += 1\n" ++
    "        end\n" ++
    "        v, = parse_seq(sub, 0, indent + 2)\n" ++
    "        out << v\n" ++
    "        idx = j\n" ++
    "      else\n" ++
    "        out << scalar(rest)\n" ++
    "        idx += 1\n" ++
    "      end\n" ++
    "    end\n" ++
    "    [out, idx]\n" ++
    "  end\n" ++
    "\n" ++
    "  # the node below `idx` (more indented than `indent`), or nil\n" ++
    "  def self.nested(lines, idx, indent)\n" ++
    "    if idx < lines.size && lines[idx].indent > indent\n" ++
    "      parse_node(lines, idx, lines[idx].indent)\n" ++
    "    else\n" ++
    "      [nil, idx]\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.parse_map(lines, idx, indent)\n" ++
    "    out = \{}\n" ++
    "    while idx < lines.size\n" ++
    "      line = lines[idx]\n" ++
    "      break if line.indent < indent\n" ++
    "      break if line.indent > indent\n" ++
    "      # \"? key\" / \": value\": an EXPLICIT key, which may be any node -- a\n" ++
    "      # sequence below it, or a flow collection -- and its value on a line of\n" ++
    "      # its own\n" ++
    "      if line.text == \"?\" || line.text.start_with?(\"? \")\n" ++
    "        rest = line.text == \"?\" ? \"\" : line.text[2..].strip\n" ++
    "        if rest.empty?\n" ++
    "          key, idx = nested(lines, idx + 1, indent)\n" ++
    "        else\n" ++
    "          key = scalar(rest)\n" ++
    "          idx += 1\n" ++
    "        end\n" ++
    "        val = nil\n" ++
    "        if idx < lines.size && lines[idx].indent == indent && (lines[idx].text == \":\" || lines[idx].text.start_with?(\": \"))\n" ++
    "          vrest = lines[idx].text == \":\" ? \"\" : lines[idx].text[2..].strip\n" ++
    "          if vrest.empty?\n" ++
    "            val, idx = nested(lines, idx + 1, indent)\n" ++
    "          else\n" ++
    "            val = scalar(vrest)\n" ++
    "            idx += 1\n" ++
    "          end\n" ++
    "        end\n" ++
    "        out[key] = val\n" ++
    "        next\n" ++
    "      end\n" ++
    "      kv = split_key(line.text)\n" ++
    "      break unless kv\n" ++
    "      key = scalar(kv[0])\n" ++
    "      rest = kv[1].strip\n" ++
    "      if rest.empty?\n" ++
    "        idx += 1\n" ++
    "        if idx < lines.size && (lines[idx].indent > indent ||\n" ++
    "             (lines[idx].indent == indent && (lines[idx].text.start_with?(\"- \") || lines[idx].text == \"-\")))\n" ++
    "          v, idx = parse_node(lines, idx, lines[idx].indent)\n" ++
    "          out[key] = v\n" ++
    "        else\n" ++
    "          out[key] = nil\n" ++
    "        end\n" ++
    "      else\n" ++
    "        out[key] = scalar(rest)\n" ++
    "        idx += 1\n" ++
    "      end\n" ++
    "    end\n" ++
    "    [out, idx]\n" ++
    "  end\n" ++
    "\n" ++
    "  # ---- documents ----------------------------------------------------------\n" ++
    "\n" ++
    "  def self.split_documents(src)\n" ++
    "    docs = [[]]\n" ++
    "    lines_of(src).each do |line|\n" ++
    "      if line.indent == 0 && (line.text == \"---\" || line.text.start_with?(\"--- \"))\n" ++
    "        docs << []\n" ++
    "        rest = line.text == \"---\" ? \"\" : line.text[4..]\n" ++
    "        docs.last << Line.new(0, rest) unless rest.to_s.strip.empty?\n" ++
    "      elsif line.indent == 0 && line.text == \"...\"\n" ++
    "        docs << []\n" ++
    "      else\n" ++
    "        docs.last << line\n" ++
    "      end\n" ++
    "    end\n" ++
    "    docs.reject(&:empty?)\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ a document can be ONE SCALAR -- \"--- foo\" is the String foo -- or a\n" ++
    "  # literal block (\"--- |-\" and its indented lines). Both went to the\n" ++
    "  # mapping parser, which found no key and answered \{}; that is what\n" ++
    "  # `YAML.load(\"foo\".to_yaml)` returned.\n" ++
    "  def self.parse_document(lines)\n" ++
    "    return nil if lines.empty?\n" ++
    "    first = lines[0].text\n" ++
    "    if first == \"|\" || first == \"|-\"\n" ++
    "      body = lines[1..].map(&:text).join(\"\\n\")\n" ++
    "      return first == \"|\" ? body + \"\\n\" : body\n" ++
    "    end\n" ++
    "    if lines.size == 1 && !(first.start_with?(\"- \") || first == \"-\") && split_key(first).nil?\n" ++
    "      return scalar(first)\n" ++
    "    end\n" ++
    "    v, idx = parse_node(lines, 0, lines[0].indent)\n" ++
    "    # ⚠ a line the structure could not take is an error, not the end of the\n" ++
    "    # document: \"key1: value\\ninvalid_key\" loaded as \{\"key1\"=>\"value\"}\n" ++
    "    if idx < lines.size\n" ++
    "      raise SyntaxError, \"(<unknown>): could not find expected ':' while scanning a simple key\"\n" ++
    "    end\n" ++
    "    v\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.load(src, filename: nil, fallback: nil, symbolize_names: false, **_opts)\n" ++
    "    # an IO is read (Psych.load takes a String or an IO)\n" ++
    "    src = src.read if src.respond_to?(:read)\n" ++
    "    docs = split_documents(src)\n" ++
    "    return fallback if docs.empty?\n" ++
    "    v = parse_document(docs.first)\n" ++
    "    v = deep_symbolize(v) if symbolize_names\n" ++
    "    v.nil? ? fallback : v\n" ++
    "  end\n" ++
    "\n" ++
    "  # unsafe_load: load, with the classes load does not permit -- timestamps,\n" ++
    "  # dates and !ruby/object tags\n" ++
    "  def self.unsafe_load(src, **opts)\n" ++
    "    saved = @__unsafe\n" ++
    "    @__unsafe = true\n" ++
    "    load(src, **opts)\n" ++
    "  ensure\n" ++
    "    @__unsafe = saved\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.safe_load(src, permitted_classes = [], permitted_symbols = [],\n" ++
    "                     aliases = false, filename = nil, **opts)\n" ++
    "    load(src, **opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  # load_stream takes an IO as well as a String, and with a block YIELDS\n" ++
    "  # each document instead of collecting them.\n" ++
    "  def self.load_stream(src, **_opts, &blk)\n" ++
    "    src = src.read if src.respond_to?(:read)\n" ++
    "    docs = split_documents(src).map \{ |d| parse_document(d) }\n" ++
    "    return docs unless blk\n" ++
    "    docs.each(&blk)\n" ++
    "    docs\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.load_file(path, **opts)\n" ++
    "    load(File.read(path), **opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.unsafe_load_file(path, **opts) = load_file(path, **opts)\n" ++
    "  def self.safe_load_file(path, **opts) = load_file(path, **opts)\n" ++
    "\n" ++
    "  def self.parse(src, **_opts)\n" ++
    "    docs = split_documents(src)\n" ++
    "    return false if docs.empty? || src.strip.empty?\n" ++
    "    Nodes::Document.new(parse_document(docs.first))\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.parse_file(path, **opts) = parse(File.read(path), **opts)\n" ++
    "  module Emitter\n" ++
    "    def self.dump(o)\n" ++
    "      \"---\" + top(o)\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.top(o)\n" ++
    "      if o.nil?\n" ++
    "        \"\\n\"\n" ++
    "      elsif collection?(o)\n" ++
    "        if empty_collection?(o)\n" ++
    "          \" \" + (o.is_a?(Hash) ? \"\{}\" : \"[]\") + \"\\n\"\n" ++
    "        else\n" ++
    "          \"\\n\" + block(o, 0)\n" ++
    "        end\n" ++
    "      elsif (t = tagged(o))\n" ++
    "        tag, pairs = t\n" ++
    "        if pairs.nil?\n" ++
    "          \" \" + tag + \"\\n\"\n" ++
    "        elsif pairs.empty?\n" ++
    "          \" \" + tag + \" \{}\\n\"\n" ++
    "        else\n" ++
    "          \" \" + tag + \"\\n\" + map_lines(pairs, 0)\n" ++
    "        end\n" ++
    "      elsif o.is_a?(String) && multiline?(o)\n" ++
    "        \" \" + literal(o, 2)\n" ++
    "      else\n" ++
    "        \" \" + scalar(o) + \"\\n\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.collection?(o)\n" ++
    "      o.is_a?(Hash) || o.is_a?(Array)\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.empty_collection?(o)\n" ++
    "      collection?(o) && o.empty?\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.multiline?(s)\n" ++
    "      s.is_a?(String) && s =~ /\\n(?!\\z)/ ? true : false\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.literal(s, indent)\n" ++
    "      head = s.end_with?(\"\\n\") ? \"|\" : \"|-\"\n" ++
    "      body = s.chomp.split(\"\\n\", -1).map \{ |l| l.empty? ? \"\\n\" : (\" \" * indent) + l + \"\\n\" }.join\n" ++
    "      head + \"\\n\" + body\n" ++
    "    end\n" ++
    "\n" ++
    "    # [tag, pairs] for the objects psych writes with a !ruby/ tag. pairs nil\n" ++
    "    # means the tag carries the whole value on its line.\n" ++
    "    def self.tagged(o)\n" ++
    "      case o\n" ++
    "      when Range\n" ++
    "        [\"!ruby/range\", [[\"begin\", o.begin], [\"end\", o.end], [\"excl\", o.exclude_end?]]]\n" ++
    "      when Struct\n" ++
    "        nm = o.class.name\n" ++
    "        [nm ? \"!ruby/struct:\" + nm : \"!ruby/struct\", o.members.map \{ |m| [m.to_s, o[m]] }]\n" ++
    "      when Exception\n" ++
    "        [\"!ruby/exception:\" + o.class.name, [[\"message\", o.message], [\"backtrace\", o.backtrace]]]\n" ++
    "      when Regexp\n" ++
    "        [\"!ruby/regexp \" + o.inspect, nil]\n" ++
    "      when Class\n" ++
    "        [\"!ruby/class '\" + o.name + \"'\", nil]\n" ++
    "      when Module\n" ++
    "        [\"!ruby/module '\" + o.name + \"'\", nil]\n" ++
    "      when String, Symbol, Integer, Float, TrueClass, FalseClass, NilClass, Array, Hash\n" ++
    "        nil\n" ++
    "      else\n" ++
    "        return nil if o.respond_to?(:strftime)\n" ++
    "        [\"!ruby/object:\" + o.class.name, o.instance_variables.map \{ |iv| [iv.to_s.sub(\"@\", \"\"), o.instance_variable_get(iv)] }]\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.block(o, n)\n" ++
    "      if o.is_a?(Array)\n" ++
    "        o.map \{ |v| item_lines(v, n) }.join\n" ++
    "      else\n" ++
    "        map_lines(o.to_a, n)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.item_lines(v, n)\n" ++
    "      pad = \" \" * n\n" ++
    "      if collection?(v) && !v.empty?\n" ++
    "        inner = block(v, n + 2)\n" ++
    "        pad + \"- \" + inner[(n + 2)..-1]\n" ++
    "      elsif (t = tagged(v))\n" ++
    "        tag, pairs = t\n" ++
    "        if pairs.nil?\n" ++
    "          pad + \"- \" + tag + \"\\n\"\n" ++
    "        elsif pairs.empty?\n" ++
    "          pad + \"- \" + tag + \" \{}\\n\"\n" ++
    "        else\n" ++
    "          pad + \"- \" + tag + \"\\n\" + map_lines(pairs, n + 2)\n" ++
    "        end\n" ++
    "      elsif multiline?(v)\n" ++
    "        pad + \"- \" + literal(v, n + 2)\n" ++
    "      elsif v.nil?\n" ++
    "        pad + \"-\\n\"\n" ++
    "      else\n" ++
    "        pad + \"- \" + scalar(v) + \"\\n\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.map_lines(pairs, n)\n" ++
    "      pad = \" \" * n\n" ++
    "      pairs.map do |k, v|\n" ++
    "        key = pad + key_scalar(k) + \":\"\n" ++
    "        if v.is_a?(Hash) && !v.empty?\n" ++
    "          key + \"\\n\" + block(v, n + 2)\n" ++
    "        elsif v.is_a?(Array) && !v.empty?\n" ++
    "          key + \"\\n\" + block(v, n)\n" ++
    "        elsif (t = tagged(v))\n" ++
    "          tag, prs = t\n" ++
    "          if prs.nil?\n" ++
    "            key + \" \" + tag + \"\\n\"\n" ++
    "          elsif prs.empty?\n" ++
    "            key + \" \" + tag + \" \{}\\n\"\n" ++
    "          else\n" ++
    "            key + \" \" + tag + \"\\n\" + map_lines(prs, n + 2)\n" ++
    "          end\n" ++
    "        elsif multiline?(v)\n" ++
    "          key + \" \" + literal(v, n + 2)\n" ++
    "        elsif v.nil?\n" ++
    "          key + \"\\n\"\n" ++
    "        elsif empty_collection?(v)\n" ++
    "          key + \" \" + (v.is_a?(Hash) ? \"\{}\" : \"[]\") + \"\\n\"\n" ++
    "        else\n" ++
    "          key + \" \" + scalar(v) + \"\\n\"\n" ++
    "        end\n" ++
    "      end.join\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.key_scalar(k)\n" ++
    "      k.nil? ? \"! ''\" : scalar(k)\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.scalar(o)\n" ++
    "      case o\n" ++
    "      when nil then \"\"\n" ++
    "      when true then \"true\"\n" ++
    "      when false then \"false\"\n" ++
    "      when Integer then o.to_s\n" ++
    "      when Float\n" ++
    "        if o.nan? then \".nan\"\n" ++
    "        elsif o.infinite? then (o > 0 ? \".inf\" : \"-.inf\")\n" ++
    "        else o.to_s\n" ++
    "        end\n" ++
    "      when Symbol then \":\" + o.to_s\n" ++
    "      when String then string(o)\n" ++
    "      else\n" ++
    "        if o.respond_to?(:strftime) && o.respond_to?(:utc?)\n" ++
    "          o.strftime(\"%Y-%m-%d %H:%M:%S.%9N\") + (o.utc? ? \" Z\" : \" \" + o.strftime(\"%:z\"))\n" ++
    "        else\n" ++
    "          o.to_s\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.string(s)\n" ++
    "      return \"''\" if s.empty?\n" ++
    "      return dquote(s) if s == \"y\" || s == \"Y\" || s == \"n\" || s == \"N\"\n" ++
    "      return dquote(s) if s =~ /\\A[^[:word:]][^\"]*\\z/\n" ++
    "      return squote(s) if special?(s)\n" ++
    "      return squote(s) if s.include?(\": \") || s.include?(\" #\") || s.end_with?(\":\") || s.end_with?(\" \") || s.start_with?(\" \")\n" ++
    "      s\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.special?(s)\n" ++
    "      s =~ /\\A[-+]?(0|[1-9][0-9_]*)\\z/ ||\n" ++
    "        s =~ /\\A[-+]?0[0-7_]+\\z/ ||\n" ++
    "        s =~ /\\A[-+]?0x[0-9a-fA-F_]+\\z/ ||\n" ++
    "        s =~ /\\A[-+]?0b[01_]+\\z/ ||\n" ++
    "        s =~ /\\A[-+]?(\\d[\\d_]*)?\\.\\d+([eE][-+]?\\d+)?\\z/ ||\n" ++
    "        s =~ /\\A[-+]?\\d[\\d_]*\\.\\z/ ||\n" ++
    "        s =~ /\\A[-+]?\\.(inf|Inf|INF)\\z/ ||\n" ++
    "        s =~ /\\A\\.(nan|NaN|NAN)\\z/ ||\n" ++
    "        s =~ /\\A(yes|no|true|false|on|off)\\z/i ||\n" ++
    "        s =~ /\\A(null|Null|NULL)\\z/ ||\n" ++
    "        s =~ /\\A\\d\{4}-\\d\{1,2}-\\d\{1,2}/ ||\n" ++
    "        s =~ /\\A[-+]?[0-9][0-9_]*(:[0-5]?[0-9])\{1,2}(\\.[0-9_]*)?\\z/ ? true : false\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.dquote(s)\n" ++
    "      '\"' + s.gsub(\"\\\\\") \{ \"\\\\\\\\\" }.gsub('\"') \{ \"\\\\\\\"\" } + '\"'\n" ++
    "    end\n" ++
    "\n" ++
    "    def self.squote(s)\n" ++
    "      \"'\" + s.gsub(\"'\", \"''\") + \"'\"\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # YAML.dump_stream(*objs): one document per object, one after another.\n" ++
    "  def self.dump_stream(*objs)\n" ++
    "    objs.map \{ |o| Emitter.dump(o) }.join\n" ++
    "  end\n" ++
    "\n" ++
    "  # YAML.dump(obj[, io]): the text, or the io it was written to.\n" ++
    "  def self.dump(o, io = nil, **_opts)\n" ++
    "    s = Emitter.dump(o)\n" ++
    "    return s unless io\n" ++
    "    io.write(s)\n" ++
    "    io\n" ++
    "  end\n" ++
    "\n" ++
    "  # YAML.parse answers a document NODE whose #to_ruby is the value -- and\n" ++
    "  # false for a stream with no document in it.\n" ++
    "  module Nodes\n" ++
    "    class Document\n" ++
    "      def initialize(v); @v = v; end\n" ++
    "      def to_ruby(**_opts) = @v\n" ++
    "      alias transform to_ruby\n" ++
    "    end\n" ++
    "  end\n" ++

    "\n" ++
    "  def self.deep_symbolize(v)\n" ++
    "    case v\n" ++
    "    when Hash\n" ++
    "      h = \{}\n" ++
    "      v.each \{ |k, val| h[k.respond_to?(:to_sym) ? k.to_sym : k] = deep_symbolize(val) }\n" ++
    "      h\n" ++
    "    when Array then v.map \{ |x| deep_symbolize(x) }\n" ++
    "    else v\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "YAML = Psych\n" ++
    "\n" ++
    "class Object\n" ++
    "  def to_yaml(**opts) = Psych.dump(self, **opts)\n" ++
    "end\n"
  // Marshal, written in ruby from marshal.c (w_object / r_object_for): the
  // tags, the object table's order and the refusals are the reference's, so a
  // dump from either interpreter loads in the other. Not a feature a program
  // requires: Marshal's dispatcher arm loads it the first time Marshal.dump or
  // Marshal.load is called, so a program that never marshals does not pay
  // for parsing it.
  else if str_eq n "__marshal" then
    "module Marshal\n" ++
    "  # Marshal in ruby, transcribed from marshal.c's w_object and r_object_for:\n" ++
    "  # the same type tags, the same order of the object table, the same\n" ++
    "  # refusals. The format is the reference's byte for byte, so a dump from\n" ++
    "  # either interpreter loads in the other.\n" ++
    "  class << self\n" ++
    "    def dump(obj, a1 = nil, a2 = nil, *rest)\n" ++
    "      if !rest.empty?\n" ++
    "        raise ArgumentError, \"wrong number of arguments (given #\{3 + rest.size}, expected 1..3)\"\n" ++
    "      end\n" ++
    "      limit = -1\n" ++
    "      port = nil\n" ++
    "      n = a2.nil? ? (a1.nil? ? 1 : 2) : 3\n" ++
    "      n = 3 if a2.nil? && !a1.nil? && false\n" ++
    "      if !a2.nil?\n" ++
    "        limit = __int(a2)\n" ++
    "        raise TypeError, \"instance of IO needed\" if a1.nil?\n" ++
    "        port = a1\n" ++
    "      elsif !a1.nil?\n" ++
    "        if Integer === a1\n" ++
    "          limit = a1\n" ++
    "        else\n" ++
    "          port = a1\n" ++
    "        end\n" ++
    "      end\n" ++
    "      if port\n" ++
    "        raise TypeError, \"instance of IO needed\" unless port.respond_to?(:write)\n" ++
    "        port.binmode if port.respond_to?(:binmode)\n" ++
    "      end\n" ++
    "      w = Writer.new\n" ++
    "      w.object(obj, limit)\n" ++
    "      if port\n" ++
    "        port.write(w.out)\n" ++
    "        port\n" ++
    "      else\n" ++
    "        w.out\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def load(source, proc = nil, freeze: false)\n" ++
    "      if String === source\n" ++
    "        src = source\n" ++
    "      elsif source.respond_to?(:to_str)\n" ++
    "        src = source.to_str\n" ++
    "      elsif source.respond_to?(:getbyte) && source.respond_to?(:read)\n" ++
    "        source.binmode if source.respond_to?(:binmode)\n" ++
    "        src = source\n" ++
    "      else\n" ++
    "        raise TypeError, \"instance of IO needed\"\n" ++
    "      end\n" ++
    "      r = Reader.new(src, proc, freeze)\n" ++
    "      major = r.byte\n" ++
    "      minor = r.byte\n" ++
    "      if major != 4 || minor > 8\n" ++
    "        raise TypeError, \"incompatible marshal file format (can't be read)\\n\\tformat version 4.8 required; #\{major}.#\{minor} given\"\n" ++
    "      end\n" ++
    "      r.object\n" ++
    "    end\n" ++
    "    alias restore load\n" ++
    "\n" ++
    "    def __ftext(d)\n" ++
    "      s = d.to_s\n" ++
    "      neg = s.start_with?(\"-\")\n" ++
    "      s = s[1..] if neg\n" ++
    "      if (i = s.index(\"e\"))\n" ++
    "        mant = s[0, i]\n" ++
    "        exp = s[i + 1..].to_i\n" ++
    "        ip, fp = mant.split(\".\")\n" ++
    "        digits = ip + (fp || \"\")\n" ++
    "        decpt = ip.size + exp\n" ++
    "      else\n" ++
    "        ip, fp = s.split(\".\")\n" ++
    "        fp ||= \"\"\n" ++
    "        if ip == \"0\"\n" ++
    "          z = fp[/\\A0*/].size\n" ++
    "          digits = fp[z..]\n" ++
    "          decpt = -z\n" ++
    "        else\n" ++
    "          digits = ip + fp\n" ++
    "          decpt = ip.size\n" ++
    "        end\n" ++
    "      end\n" ++
    "      digits = digits.sub(/0+\\z/, \"\")\n" ++
    "      digits = \"0\" if digits.empty?\n" ++
    "      digs = digits.size\n" ++
    "      out = neg ? +\"-\" : +\"\"\n" ++
    "      if decpt < -3 || decpt > digs\n" ++
    "        out << digits[0]\n" ++
    "        out << \".\" << digits[1..] if digs > 1\n" ++
    "        out << \"e#\{decpt - 1}\"\n" ++
    "      elsif decpt > 0\n" ++
    "        out << digits[0, decpt]\n" ++
    "        out << \".\" << digits[decpt..] if digs > decpt\n" ++
    "      else\n" ++
    "        out << \"0.\" << \"0\" * -decpt << digits\n" ++
    "      end\n" ++
    "      out\n" ++
    "    end\n" ++
    "\n" ++
    "    def __int(v)\n" ++
    "      return v if Integer === v\n" ++
    "      raise TypeError, \"no implicit conversion of #\{v.nil? ? 'nil' : v.class} into Integer\" unless v.respond_to?(:to_int)\n" ++
    "      v.to_int\n" ++
    "    end\n" ++
    "\n" ++
    "    # the class's own name, not whatever a `def self.name` answers (and\n" ++
    "    # without calling it: a spec checks that #name is never asked)\n" ++
    "    def __name(c) = Marshal.__cname(c)\n" ++
    "\n" ++
    "    # rb_path_to_class: each segment looked up AT its namespace, not through\n" ++
    "    # the lexical scope or the ancestors a bare constant would search\n" ++
    "    def __const_at(path)\n" ++
    "      c = ::Object\n" ++
    "      path.split(\"::\").each do |seg|\n" ++
    "        return nil unless Module === c && !seg.empty? && c.const_defined?(seg, false)\n" ++
    "        c = c.const_get(seg, false)\n" ++
    "      end\n" ++
    "      c\n" ++
    "    end\n" ++
    "\n" ++
    "    # w_extended names a module with must_not_be_anonymous(\"class\", ...), so\n" ++
    "    # an anonymous extended module is an \"anonymous class\" too\n" ++
    "    def __path(c, kind = nil)\n" ++
    "      nm = __name(c)\n" ++
    "      kind ||= c.is_a?(Class) ? \"class\" : \"module\"\n" ++
    "      if nm.nil? || nm.start_with?(\"#\")\n" ++
    "        raise TypeError, \"can't dump anonymous #\{kind} #\{c.inspect}\"\n" ++
    "      end\n" ++
    "      found = __const_at(nm)\n" ++
    "      raise TypeError, \"#\{nm} can't be referred to\" unless found.equal?(c) || found == c\n" ++
    "      nm\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  class Writer\n" ++
    "    attr_reader :out\n" ++
    "\n" ++
    "    def initialize\n" ++
    "      @out = \"\\x04\\x08\".b\n" ++
    "      @syms = \{}\n" ++
    "      @data = \{}\n" ++
    "      @nent = 0\n" ++
    "      @userdefs = \{}\n" ++
    "      @zones = \{}\n" ++
    "    end\n" ++
    "\n" ++
    "    def byte(b) = @out << (b & 0xff).chr\n" ++
    "\n" ++
    "    def long(x)\n" ++
    "      raise TypeError, \"long too big to dump\" unless x >= -2**31 && x < 2**31\n" ++
    "      if x == 0\n" ++
    "        @out << \"\\x00\"\n" ++
    "      elsif x > 0 && x < 123\n" ++
    "        @out << (x + 5).chr\n" ++
    "      elsif x < 0 && x > -124\n" ++
    "        @out << ((x - 5) & 0xff).chr\n" ++
    "      else\n" ++
    "        buf = +\"\".b\n" ++
    "        i = 1\n" ++
    "        while i <= 4\n" ++
    "          buf << (x & 0xff).chr\n" ++
    "          x >>= 8\n" ++
    "          if x == 0\n" ++
    "            @out << i.chr << buf\n" ++
    "            return\n" ++
    "          end\n" ++
    "          if x == -1\n" ++
    "            @out << (256 - i).chr << buf\n" ++
    "            return\n" ++
    "          end\n" ++
    "          i += 1\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def bytes(s)\n" ++
    "      s = s.b\n" ++
    "      long(s.bytesize)\n" ++
    "      @out << s\n" ++
    "    end\n" ++
    "\n" ++
    "    # the table key of a non-immediate: its identity, or for a Float (a\n" ++
    "    # flonum in the reference, where equal floats are one object) its bits\n" ++
    "    def key(obj)\n" ++
    "      case obj\n" ++
    "      when Float then [:f, [obj].pack(\"G\")]\n" ++
    "      when Integer then [:i, obj]\n" ++
    "      when Module then [:m, obj.inspect]\n" ++
    "      else\n" ++
    "        id = obj.__id__\n" ++
    "        # a value this interpreter keeps unboxed (a Range, a Rational) has no\n" ++
    "        # identity of its own, so equal ones are one entry\n" ++
    "        id == 0 ? [:v, obj.class, obj] : id\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def remember(obj)\n" ++
    "      @data[key(obj)] = @nent\n" ++
    "      @nent += 1\n" ++
    "    end\n" ++
    "\n" ++
    "    def symbol(sym)\n" ++
    "      if (n = @syms[sym])\n" ++
    "        byte(0x3b) # ;\n" ++
    "        long(n)\n" ++
    "        return\n" ++
    "      end\n" ++
    "      s = sym.to_s\n" ++
    "      enc = s.ascii_only? ? nil : encname(s)\n" ++
    "      byte(0x49) if enc # I\n" ++
    "      byte(0x3a) # :\n" ++
    "      bytes(s)\n" ++
    "      @syms[sym] = @syms.size\n" ++
    "      if enc\n" ++
    "        long(1)\n" ++
    "        encoding(enc, 1)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def unique(name) = symbol(name.to_sym)\n" ++
    "\n" ++
    "    # nil for BINARY, false for US-ASCII, true for UTF-8, else the name\n" ++
    "    def encname(s)\n" ++
    "      # a Regexp subclass instance answers its encoding through a plain one\n" ++
    "      e = (::Regexp === s && !s.class.equal?(::Regexp)) ? ::Regexp.new(s.source, s.options).encoding : s.encoding\n" ++
    "      return nil if e == Encoding::BINARY\n" ++
    "      return false if e == Encoding::US_ASCII\n" ++
    "      return true if e == Encoding::UTF_8\n" ++
    "      e.name.b\n" ++
    "    end\n" ++
    "\n" ++
    "    def encoding(enc, limit)\n" ++
    "      limit += 1 if limit >= 0\n" ++
    "      if enc == true || enc == false\n" ++
    "        symbol(:E)\n" ++
    "        object(enc, limit)\n" ++
    "        1\n" ++
    "      elsif enc.nil?\n" ++
    "        0\n" ++
    "      else\n" ++
    "        symbol(:encoding)\n" ++
    "        object(enc, limit)\n" ++
    "        1\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def ivar_names(obj)\n" ++
    "      # the interpreter's own bookkeeping (@__...) is not the object's state\n" ++
    "      names = obj.instance_variables.reject \{ |n| n.to_s.start_with?(\"@__\") }\n" ++
    "      if Exception === obj\n" ++
    "        names = names.reject \{ |n| n == :@message || n.to_s.start_with?(\"@__\") }\n" ++
    "      elsif defined?(::Data) && ::Data === obj\n" ++
    "        ms = obj.class.members.map \{ |m| :\"@#\{m}\" }\n" ++
    "        names = names - ms\n" ++
    "      end\n" ++
    "      names\n" ++
    "    end\n" ++
    "\n" ++
    "    def ivar_pairs(obj) = ivar_names(obj).map \{ |n| [n, obj.instance_variable_get(n)] }\n" ++
    "\n" ++
    "    # how many pairs the `I` wrapper carries: the encoding, then the ivars\n" ++
    "    def count_ivars(obj, enc)\n" ++
    "      (enc.nil? ? 0 : 1) + ivar_names(obj).size\n" ++
    "    end\n" ++
    "\n" ++
    "    def ivars(num, obj, enc, limit)\n" ++
    "      write_ivars(num, ivar_pairs(obj), enc, limit)\n" ++
    "    end\n" ++
    "\n" ++
    "    def write_ivars(num, pairs, enc, limit)\n" ++
    "      long(num)\n" ++
    "      encoding(enc, limit)\n" ++
    "      pairs.each do |n, v|\n" ++
    "        symbol(n)\n" ++
    "        object(v, limit)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def extended(obj, check)\n" ++
    "      return unless check\n" ++
    "      # asked without MAKING one: most objects have no singleton class\n" ++
    "      sc = Marshal.__sng(obj)\n" ++
    "      return unless sc\n" ++
    "      if !sc.instance_methods(false).empty? || !sc.private_instance_methods(false).empty? || !sc.instance_variables.empty?\n" ++
    "        raise TypeError, \"singleton can't be dumped\"\n" ++
    "      end\n" ++
    "      real = obj.class\n" ++
    "      sc.ancestors.each do |m|\n" ++
    "        next if m.equal?(sc)\n" ++
    "        break if m.equal?(real)\n" ++
    "        next if m.is_a?(Class)\n" ++
    "        byte(0x65) # e\n" ++
    "        unique(Marshal.__path(m, \"class\"))\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def klass(type, obj, check)\n" ++
    "      extended(obj, check)\n" ++
    "      byte(type)\n" ++
    "      unique(Marshal.__path(obj.class))\n" ++
    "    end\n" ++
    "\n" ++
    "    def uclass(obj, base)\n" ++
    "      extended(obj, true)\n" ++
    "      c = obj.class\n" ++
    "      unless c.equal?(base)\n" ++
    "        byte(0x43) # C\n" ++
    "        unique(Marshal.__path(c))\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def float(d)\n" ++
    "      if d.infinite?\n" ++
    "        bytes(d < 0 ? \"-inf\" : \"inf\")\n" ++
    "      elsif d.nan?\n" ++
    "        bytes(\"nan\")\n" ++
    "      elsif d == 0.0\n" ++
    "        bytes(1.0 / d < 0 ? \"-0\" : \"0\")\n" ++
    "      else\n" ++
    "        bytes(Marshal.__ftext(d))\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def bignum(obj)\n" ++
    "      byte(0x6c) # l\n" ++
    "      byte(obj < 0 ? 0x2d : 0x2b)\n" ++
    "      v = obj.abs\n" ++
    "      shorts = []\n" ++
    "      while v > 0\n" ++
    "        shorts << (v & 0xffff)\n" ++
    "        v >>= 16\n" ++
    "      end\n" ++
    "      long(shorts.size)\n" ++
    "      shorts.each \{ |s| @out << (s & 0xff).chr << (s >> 8).chr }\n" ++
    "    end\n" ++
    "\n" ++
    "    UNDUMPABLE = %w[Proc Method UnboundMethod Binding Thread Thread::Mutex Mutex MatchData Enumerator\n" ++
    "                    Enumerator::Lazy Enumerator::Yielder Enumerator::Generator Enumerator::Chain\n" ++
    "                    Enumerator::ArithmeticSequence ObjectSpace::WeakMap ObjectSpace::WeakKeyMap\n" ++
    "                    Thread::Backtrace::Location TracePoint Fiber Ractor Continuation\n" ++
    "                    StringIO StringScanner]\n" ++
    "\n" ++
    "    def data_class_name(obj)\n" ++
    "      c = obj.class\n" ++
    "      c = c.superclass while c && c.name.nil?\n" ++
    "      n = c ? c.name : \"Object\"\n" ++
    "      %w[Mutex Queue SizedQueue ConditionVariable].include?(n) ? \"Thread::#\{n}\" : n\n" ++
    "    end\n" ++
    "\n" ++
    "    # a T_OBJECT in the reference: an instance of no builtin value class\n" ++
    "    def plain_object?(obj)\n" ++
    "      !(::String === obj || ::Array === obj || ::Hash === obj || ::Regexp === obj || ::Range === obj ||\n" ++
    "        ::Struct === obj || ::Time === obj || ::Module === obj || ::Numeric === obj || ::Symbol === obj ||\n" ++
    "        ::Proc === obj || ::Method === obj || ::IO === obj)\n" ++
    "    end\n" ++
    "\n" ++
    "    def object(obj, limit)\n" ++
    "      raise ArgumentError, \"exceed depth limit\" if limit == 0\n" ++
    "      case obj\n" ++
    "      when nil then byte(0x30)\n" ++
    "      when true then byte(0x54)\n" ++
    "      when false then byte(0x46)\n" ++
    "      when Integer\n" ++
    "        if obj >= -2**30 && obj < 2**30\n" ++
    "          byte(0x69) # i\n" ++
    "          long(obj)\n" ++
    "        elsif obj >= -2**62 && obj < 2**62\n" ++
    "          # a Fixnum past 31 bits is written as a Bignum but NOT linked; it\n" ++
    "          # still takes an index, as marshal.c's w_bigfixnum counts one\n" ++
    "          bignum(obj)\n" ++
    "          @nent += 1\n" ++
    "        elsif (n = @data[key(obj)])\n" ++
    "          byte(0x40)\n" ++
    "          long(n)\n" ++
    "        else\n" ++
    "          remember(obj)\n" ++
    "          bignum(obj)\n" ++
    "        end\n" ++
    "      when Symbol then symbol(obj)\n" ++
    "      else\n" ++
    "        if (n = @data[key(obj)])\n" ++
    "          byte(0x40) # @\n" ++
    "          long(n)\n" ++
    "          return\n" ++
    "        end\n" ++
    "        limit -= 1 if limit > 0\n" ++
    "        if Float === obj\n" ++
    "          remember(obj)\n" ++
    "          byte(0x66) # f\n" ++
    "          float(obj)\n" ++
    "          return\n" ++
    "        end\n" ++
    "        # Rational and Complex answer their pair through a private\n" ++
    "        # marshal_dump in the reference\n" ++
    "        md = if ::Rational === obj then [obj.numerator, obj.denominator]\n" ++
    "             elsif ::Complex === obj then [obj.real, obj.imaginary]\n" ++
    "             end\n" ++
    "        if md || obj.respond_to?(:marshal_dump, true)\n" ++
    "          remember(obj)\n" ++
    "          v = md || obj.__send__(:marshal_dump)\n" ++
    "          klass(0x55, obj, false) # U\n" ++
    "          object(v, limit)\n" ++
    "          return\n" ++
    "        end\n" ++
    "        if obj.respond_to?(:_dump, true)\n" ++
    "          if @userdefs[obj.__id__]\n" ++
    "            raise RuntimeError, \"can't dump recursive object using _dump()\"\n" ++
    "          end\n" ++
    "          v = obj.__send__(:_dump, limit)\n" ++
    "          raise TypeError, \"_dump() must return string\" unless String === v\n" ++
    "          if ::Time === obj && obj.method(:_dump).owner.equal?(::Time)\n" ++
    "            # Time's own _dump: its zone, offset and sub-microseconds are\n" ++
    "            # ivars of the dumped String in the reference, after the Time's own\n" ++
    "            enc = nil\n" ++
    "            # a zone name is one frozen string in the reference, so the\n" ++
    "            # second Time in a dump links to the first one's\n" ++
    "            pairs = ivar_pairs(obj) + obj.__send__(:__mdump_ivars).map do |nm, x|\n" ++
    "              String === x ? [nm, (@zones[x] ||= x)] : [nm, x]\n" ++
    "            end\n" ++
    "          else\n" ++
    "            enc = encname(v)\n" ++
    "            pairs = ivar_pairs(v)\n" ++
    "            if pairs.empty? && enc.nil? && !plain_object?(obj)\n" ++
    "              # an object that is not a plain one counts its own ivars (and a\n" ++
    "              # String its encoding), as has_ivars does for them\n" ++
    "              enc = (::String === obj || ::Regexp === obj) ? encname(obj) : nil\n" ++
    "              pairs = ivar_pairs(obj)\n" ++
    "            end\n" ++
    "          end\n" ++
    "          num = pairs.size + (enc.nil? ? 0 : 1)\n" ++
    "          byte(0x49) if num > 0\n" ++
    "          klass(0x75, obj, false) # u\n" ++
    "          bytes(v)\n" ++
    "          if num > 0\n" ++
    "            @userdefs[obj.__id__] = true\n" ++
    "            write_ivars(num, pairs, enc, limit)\n" ++
    "            @userdefs.delete(obj.__id__)\n" ++
    "          end\n" ++
    "          remember(obj)\n" ++
    "          return\n" ++
    "        end\n" ++
    "\n" ++
    "        remember(obj)\n" ++
    "        # Range has no _dump in the reference: its \"compat\" dumper writes a\n" ++
    "        # plain object of class Range with three ivars\n" ++
    "        if Range === obj\n" ++
    "          extended(obj, true)\n" ++
    "          byte(0x6f) # o\n" ++
    "          unique(Marshal.__path(obj.class))\n" ++
    "          extra = ivar_names(obj)\n" ++
    "          long(3 + extra.size)\n" ++
    "          symbol(:excl)\n" ++
    "          object(obj.exclude_end?, limit)\n" ++
    "          symbol(:begin)\n" ++
    "          object(obj.begin, limit)\n" ++
    "          symbol(:end)\n" ++
    "          object(obj.end, limit)\n" ++
    "          extra.each do |nm|\n" ++
    "            symbol(nm)\n" ++
    "            object(obj.instance_variable_get(nm), limit)\n" ++
    "          end\n" ++
    "          return\n" ++
    "        end\n" ++
    "\n" ++
    "        if Class === obj\n" ++
    "          raise TypeError, \"singleton class can't be dumped\" if obj.singleton_class?\n" ++
    "          path = Marshal.__path(obj)\n" ++
    "          enc = path.ascii_only? ? nil : encname(path)\n" ++
    "          byte(0x49) if enc\n" ++
    "          byte(0x63) # c\n" ++
    "          bytes(path)\n" ++
    "          if enc\n" ++
    "            long(1)\n" ++
    "            encoding(enc, 1)\n" ++
    "          end\n" ++
    "          return\n" ++
    "        end\n" ++
    "        if Module === obj\n" ++
    "          path = Marshal.__path(obj)\n" ++
    "          enc = path.ascii_only? ? nil : encname(path)\n" ++
    "          byte(0x49) if enc\n" ++
    "          byte(0x6d) # m\n" ++
    "          bytes(path)\n" ++
    "          if enc\n" ++
    "            long(1)\n" ++
    "            encoding(enc, 1)\n" ++
    "          end\n" ++
    "          return\n" ++
    "        end\n" ++
    "\n" ++
    "        case obj\n" ++
    "        when String\n" ++
    "          enc = encname(obj)\n" ++
    "          num = count_ivars(obj, enc)\n" ++
    "          byte(0x49) if num > 0\n" ++
    "          uclass(obj, ::String)\n" ++
    "          byte(0x22) # \"\n" ++
    "          bytes(obj)\n" ++
    "          ivars(num, obj, enc, limit) if num > 0\n" ++
    "        when Regexp\n" ++
    "          enc = encname(obj)\n" ++
    "          num = count_ivars(obj, enc)\n" ++
    "          byte(0x49) if num > 0\n" ++
    "          uclass(obj, ::Regexp)\n" ++
    "          byte(0x2f) # /\n" ++
    "          bytes(obj.source)\n" ++
    "          o = obj.options\n" ++
    "          # FIXEDENCODING, which a pattern with non-ASCII in it has\n" ++
    "          o |= 16 if encname(obj) == true && !obj.source.ascii_only?\n" ++
    "          byte(o & 0xff)\n" ++
    "          ivars(num, obj, enc, limit) if num > 0\n" ++
    "        when Array\n" ++
    "          num = count_ivars(obj, nil)\n" ++
    "          byte(0x49) if num > 0\n" ++
    "          uclass(obj, ::Array)\n" ++
    "          byte(0x5b) # [\n" ++
    "          len = obj.size\n" ++
    "          long(len)\n" ++
    "          i = 0\n" ++
    "          while i < obj.size\n" ++
    "            object(obj[i], limit)\n" ++
    "            raise RuntimeError, \"array modified during dump\" if len != obj.size\n" ++
    "            i += 1\n" ++
    "          end\n" ++
    "          ivars(num, obj, nil, limit) if num > 0\n" ++
    "        when Hash\n" ++
    "          num = count_ivars(obj, nil)\n" ++
    "          byte(0x49) if num > 0\n" ++
    "          uclass(obj, ::Hash)\n" ++
    "          if obj.compare_by_identity?\n" ++
    "            byte(0x43)\n" ++
    "            symbol(:Hash)\n" ++
    "          end\n" ++
    "          if obj.default_proc\n" ++
    "            raise TypeError, \"can't dump hash with default proc\"\n" ++
    "          elsif obj.default.nil?\n" ++
    "            byte(0x7b) # \{\n" ++
    "          else\n" ++
    "            byte(0x7d) # }\n" ++
    "          end\n" ++
    "          long(obj.size)\n" ++
    "          obj.each_pair do |k, v|\n" ++
    "            object(k, limit)\n" ++
    "            object(v, limit)\n" ++
    "          end\n" ++
    "          object(obj.default, limit) unless obj.default.nil?\n" ++
    "          ivars(num, obj, nil, limit) if num > 0\n" ++
    "        when Struct, (defined?(::Data) ? ::Data : Struct)\n" ++
    "          num = count_ivars(obj, nil)\n" ++
    "          byte(0x49) if num > 0\n" ++
    "          klass(0x53, obj, true) # S\n" ++
    "          ms = obj.class.members\n" ++
    "          vals = Struct === obj ? obj.to_a : obj.deconstruct\n" ++
    "          long(ms.size)\n" ++
    "          ms.each_with_index do |m, i|\n" ++
    "            symbol(m)\n" ++
    "            object(vals[i], limit)\n" ++
    "          end\n" ++
    "          ivars(num, obj, nil, limit) if num > 0\n" ++
    "        when Exception\n" ++
    "          klass(0x6f, obj, true) # o\n" ++
    "          mesg = obj.instance_variable_defined?(:@message) ? obj.instance_variable_get(:@message) : nil\n" ++
    "          if mesg.nil? && !obj.instance_variable_defined?(:@message)\n" ++
    "            m = obj.message\n" ++
    "            mesg = m unless m == Marshal.__name(obj.class)\n" ++
    "          end\n" ++
    "          pairs = [[:mesg, mesg], [:bt, obj.backtrace]]\n" ++
    "          pairs << [:cause, obj.cause] if obj.cause\n" ++
    "          pairs << [:bt_locations, obj.backtrace] if obj.backtrace_locations\n" ++
    "          extra = ivar_names(obj)\n" ++
    "          long(pairs.size + extra.size)\n" ++
    "          pairs.each do |nm, v|\n" ++
    "            symbol(nm)\n" ++
    "            object(v, limit)\n" ++
    "          end\n" ++
    "          extra.each do |nm|\n" ++
    "            symbol(nm)\n" ++
    "            object(obj.instance_variable_get(nm), limit)\n" ++
    "          end\n" ++
    "        else\n" ++
    "          cn = data_class_name(obj)\n" ++
    "          if obj.is_a?(IO) || obj.is_a?(Dir)\n" ++
    "            raise TypeError, \"can't dump #\{obj.class}\"\n" ++
    "          end\n" ++
    "          if %w[Thread::Queue Thread::SizedQueue Thread::ConditionVariable].include?(cn)\n" ++
    "            raise TypeError, \"can't dump #\{cn}\"\n" ++
    "          end\n" ++
    "          if UNDUMPABLE.any? \{ |u| (c = (Object.const_get(u) rescue nil)) && c.is_a?(Module) && obj.is_a?(c) }\n" ++
    "            raise TypeError, \"no _dump_data is defined for class #\{cn}\"\n" ++
    "          end\n" ++
    "          klass(0x6f, obj, true) # o\n" ++
    "          names = ivar_names(obj)\n" ++
    "          long(names.size)\n" ++
    "          names.each do |nm|\n" ++
    "            symbol(nm)\n" ++
    "            object(obj.instance_variable_get(nm), limit)\n" ++
    "          end\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  class Reader\n" ++
    "    STORE = ::Hash.instance_method(:store)\n" ++
    "\n" ++
    "    def initialize(src, proc, freeze)\n" ++
    "      @src = src\n" ++
    "      @str = String === src\n" ++
    "      @pos = 0\n" ++
    "      @syms = []\n" ++
    "      @data = \{}\n" ++
    "      @proc = proc\n" ++
    "      @freeze = freeze\n" ++
    "      @partial = (proc || freeze) ? \{} : nil\n" ++
    "    end\n" ++
    "\n" ++
    "    def too_short = raise(ArgumentError, \"marshal data too short\")\n" ++
    "\n" ++
    "    def byte\n" ++
    "      if @str\n" ++
    "        too_short if @pos >= @src.bytesize\n" ++
    "        b = @src.getbyte(@pos)\n" ++
    "        @pos += 1\n" ++
    "        b\n" ++
    "      else\n" ++
    "        b = @src.getbyte\n" ++
    "        raise EOFError, \"end of file reached\" if b.nil?\n" ++
    "        b\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def long\n" ++
    "      c = byte\n" ++
    "      c -= 256 if c > 127\n" ++
    "      return 0 if c == 0\n" ++
    "      if c > 0\n" ++
    "        return c - 5 if c > 4\n" ++
    "        x = 0\n" ++
    "        c.times \{ |i| x |= byte << (8 * i) }\n" ++
    "        x\n" ++
    "      else\n" ++
    "        return c + 5 if c < -4\n" ++
    "        c = -c\n" ++
    "        x = -1\n" ++
    "        c.times do |i|\n" ++
    "          x &= ~(0xff << (8 * i))\n" ++
    "          x |= byte << (8 * i)\n" ++
    "        end\n" ++
    "        x\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def bytes0(len)\n" ++
    "      return \"\".b if len == 0\n" ++
    "      if @str\n" ++
    "        too_short if @src.bytesize - @pos < len\n" ++
    "        s = @src.byteslice(@pos, len)\n" ++
    "        @pos += len\n" ++
    "        s.b\n" ++
    "      else\n" ++
    "        s = @src.read(len)\n" ++
    "        too_short if s.nil? || s.bytesize != len\n" ++
    "        s.b\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def bytes = bytes0(long)\n" ++
    "\n" ++
    "    def symreal(ivar)\n" ++
    "      s = bytes\n" ++
    "      s.force_encoding(Encoding::US_ASCII) if s.ascii_only?\n" ++
    "      @syms << s\n" ++
    "      idx = nil\n" ++
    "      if ivar\n" ++
    "        n = long\n" ++
    "        while n > 0\n" ++
    "          k = symbol\n" ++
    "          v = object\n" ++
    "          e = enc_for(k, v)\n" ++
    "          idx = e if e\n" ++
    "          n -= 1\n" ++
    "        end\n" ++
    "      end\n" ++
    "      if idx\n" ++
    "        s.force_encoding(idx)\n" ++
    "        raise ArgumentError, \"invalid byte sequence in #\{idx}: #\{s.inspect}\" unless s.valid_encoding?\n" ++
    "      end\n" ++
    "      s\n" ++
    "    end\n" ++
    "\n" ++
    "    def symbol_str\n" ++
    "      ivar = false\n" ++
    "      loop do\n" ++
    "        t = byte\n" ++
    "        case t\n" ++
    "        when 0x49 then ivar = true\n" ++
    "        when 0x3a then return symreal(ivar)\n" ++
    "        when 0x3b\n" ++
    "          raise ArgumentError, \"dump format error (symlink with encoding)\" if ivar\n" ++
    "          n = long\n" ++
    "          raise ArgumentError, \"bad symbol\" if n >= @syms.size\n" ++
    "          return @syms[n]\n" ++
    "        else\n" ++
    "          raise ArgumentError, format(\"dump format error for symbol(0x%x)\", t)\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def symbol = symbol_str.to_sym\n" ++
    "\n" ++
    "    def unique = symbol_str\n" ++
    "\n" ++
    "    # the encoding an ivar pair names, or nil when it is not one\n" ++
    "    def enc_for(k, v)\n" ++
    "      k = k.to_s\n" ++
    "      if k == \"encoding\"\n" ++
    "        Encoding.find(v.to_s)\n" ++
    "      elsif k == \"E\"\n" ++
    "        v == false ? Encoding::US_ASCII : (v == true ? Encoding::UTF_8 : nil)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def entry(v, idx = nil)\n" ++
    "      idx ||= @data.size\n" ++
    "      @data[idx] = v\n" ++
    "      @partial[v.__id__] = true if @partial\n" ++
    "      v\n" ++
    "    end\n" ++
    "\n" ++
    "    def prepare\n" ++
    "      idx = @data.size\n" ++
    "      @data[idx] = :__undef\n" ++
    "      idx\n" ++
    "    end\n" ++
    "\n" ++
    "    def post_proc(v)\n" ++
    "      @proc ? @proc.call(v) : v\n" ++
    "    end\n" ++
    "\n" ++
    "    def leave(v, partial)\n" ++
    "      unless partial\n" ++
    "        @partial.delete(v.__id__) if @partial\n" ++
    "        if @freeze\n" ++
    "          if Module === v\n" ++
    "            # classes and modules are not frozen\n" ++
    "          elsif String === v\n" ++
    "            v = -v\n" ++
    "          else\n" ++
    "            # OBJ_FREEZE: an object's own #freeze is not called\n" ++
    "            Marshal.__freeze(v)\n" ++
    "          end\n" ++
    "        end\n" ++
    "        v = post_proc(v)\n" ++
    "      end\n" ++
    "      v\n" ++
    "    end\n" ++
    "\n" ++
    "    def set_ivars(obj, n)\n" ++
    "      had = false\n" ++
    "      while n > 0\n" ++
    "        k = symbol_str\n" ++
    "        v = object\n" ++
    "        if (e = enc_for(k, v))\n" ++
    "          obj.force_encoding(e) if obj.respond_to?(:force_encoding) && obj.encoding != e\n" ++
    "          had = true\n" ++
    "        elsif k == \"ruby2_keywords_flag\"\n" ++
    "          raise ArgumentError, \"ruby2_keywords flag is given but #\{obj.inspect} is not a Hash\" unless Hash === obj\n" ++
    "        elsif @hidden && !k.start_with?(\"@\")\n" ++
    "          @hidden[k] = v\n" ++
    "        elsif Exception === obj && !k.start_with?(\"@\")\n" ++
    "          case k\n" ++
    "          when \"mesg\" then obj.instance_variable_set(:@message, v)\n" ++
    "          when \"bt\" then obj.set_backtrace(v) if v\n" ++
    "          when \"cause\" then obj.instance_variable_set(:@__cause, v)\n" ++
    "          end\n" ++
    "        elsif defined?(::Range) && Range === obj && !k.start_with?(\"@\")\n" ++
    "          (@range_parts ||= \{})[k] = v\n" ++
    "        else\n" ++
    "          obj.instance_variable_set(k.to_sym, v)\n" ++
    "        end\n" ++
    "        n -= 1\n" ++
    "      end\n" ++
    "      had\n" ++
    "    end\n" ++
    "\n" ++
    "    def r_ivar(obj)\n" ++
    "      n = long\n" ++
    "      if n > 0\n" ++
    "        if Class === obj\n" ++
    "          raise TypeError, \"can't override instance variable of class '#\{obj.name}'\"\n" ++
    "        elsif Module === obj\n" ++
    "          raise TypeError, \"can't override instance variable of module '#\{obj.name}'\"\n" ++
    "        end\n" ++
    "      end\n" ++
    "      set_ivars(obj, n)\n" ++
    "    end\n" ++
    "\n" ++
    "    def path2class(path)\n" ++
    "      v = Marshal.__const_at(path)\n" ++
    "      raise ArgumentError, \"undefined class/module #\{path}\" if v.nil?\n" ++
    "      raise ArgumentError, \"#\{path} does not refer to class\" unless Class === v\n" ++
    "      v\n" ++
    "    end\n" ++
    "\n" ++
    "    def path2module(path)\n" ++
    "      v = Marshal.__const_at(path)\n" ++
    "      raise ArgumentError, \"undefined class/module #\{path}\" if v.nil?\n" ++
    "      raise ArgumentError, \"#\{path} does not refer to module\" unless Module === v && !(Class === v)\n" ++
    "      v\n" ++
    "    end\n" ++
    "\n" ++
    "    def object = object0(false, nil, nil)\n" ++
    "\n" ++
    "    # ivp is a one-element Array standing in for marshal.c's `int *ivp`\n" ++
    "    def object0(partial, ivp, extmod)\n" ++
    "      object_for(partial, ivp, nil, extmod, byte)\n" ++
    "    end\n" ++
    "\n" ++
    "    def object_for(partial, ivp, klass, extmod, type)\n" ++
    "      v = nil\n" ++
    "      case type\n" ++
    "      when 0x40 # @ link\n" ++
    "        id = long\n" ++
    "        raise ArgumentError, \"dump format error (unlinked)\" unless @data.key?(id)\n" ++
    "        v = @data[id]\n" ++
    "        if @partial && !@partial.key?(v.__id__)\n" ++
    "          v = -v if @freeze && String === v\n" ++
    "          v = post_proc(v)\n" ++
    "        end\n" ++
    "      when 0x49 # I\n" ++
    "        iv = [true]\n" ++
    "        v = object0(true, iv, extmod)\n" ++
    "        r_ivar(v) if iv[0]\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x65 # e\n" ++
    "        path = unique\n" ++
    "        m = Marshal.__const_at(path)\n" ++
    "        raise ArgumentError, \"undefined class/module #\{path}\" if m.nil?\n" ++
    "        extmod ||= []\n" ++
    "        if Class === m\n" ++
    "          v = object0(true, nil, nil)\n" ++
    "          raise ArgumentError, \"prepended class #\{path} differs from class #\{v.class}\" unless v.class.equal?(m)\n" ++
    "          sc = v.singleton_class\n" ++
    "          sc.prepend(extmod.pop) until extmod.empty?\n" ++
    "        else\n" ++
    "          raise ArgumentError, \"#\{path} does not refer to module\" unless Module === m\n" ++
    "          extmod.push(m)\n" ++
    "          v = object0(true, nil, extmod)\n" ++
    "          v.extend(extmod.pop) until extmod.empty?\n" ++
    "        end\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x43 # C\n" ++
    "        c = path2class(unique)\n" ++
    "        t2 = byte\n" ++
    "        if c.equal?(::Hash) && (t2 == 0x7b || t2 == 0x7d)\n" ++
    "          v = read_hash(t2, partial, true)\n" ++
    "        else\n" ++
    "          v = object_for(partial, nil, c, extmod, t2)\n" ++
    "          unless c.ancestors.include?(v.class) || v.class.ancestors.include?(c)\n" ++
    "            raise ArgumentError, \"dump format error (user class)\"\n" ++
    "          end\n" ++
    "          v = __retag(v, c)\n" ++
    "        end\n" ++
    "      when 0x30 then v = leave(nil, false)\n" ++
    "      when 0x54 then v = leave(true, false)\n" ++
    "      when 0x46 then v = leave(false, false)\n" ++
    "      when 0x69 then v = leave(long, false)\n" ++
    "      when 0x66 # f\n" ++
    "        s = bytes\n" ++
    "        d = case s\n" ++
    "            when \"nan\" then Float::NAN\n" ++
    "            when \"inf\" then Float::INFINITY\n" ++
    "            when \"-inf\" then -Float::INFINITY\n" ++
    "            else\n" ++
    "              t = s.index(\"\\x00\") ? s[0, s.index(\"\\x00\")] : s\n" ++
    "              Float(t) rescue t.to_f\n" ++
    "            end\n" ++
    "        v = entry(d)\n" ++
    "        v = leave(v, false)\n" ++
    "      when 0x6c # l\n" ++
    "        sign = byte\n" ++
    "        raise ArgumentError, \"invalid Bignum sign\" unless sign == 0x2b || sign == 0x2d\n" ++
    "        len = long\n" ++
    "        raise ArgumentError, \"negative length\" if len < 0\n" ++
    "        raw = bytes0(len * 2)\n" ++
    "        n = 0\n" ++
    "        raw.bytes.reverse_each \{ |b| n = (n << 8) | b }\n" ++
    "        n = -n if sign == 0x2d\n" ++
    "        v = entry(n)\n" ++
    "        v = leave(v, false)\n" ++
    "      when 0x22 # \"\n" ++
    "        v = entry(bytes)\n" ++
    "        v = __retag(v, klass) if klass\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x2f # /\n" ++
    "        src = bytes\n" ++
    "        opts = byte\n" ++
    "        idx = prepare\n" ++
    "        if ivp\n" ++
    "          had = r_ivar(src)\n" ++
    "          ivp[0] = false\n" ++
    "        else\n" ++
    "          had = false\n" ++
    "        end\n" ++
    "        re = Regexp.new(src, opts)\n" ++
    "        re = __retag(re, klass) if klass\n" ++
    "        src.instance_variables.each \{ |n| re.instance_variable_set(n, src.instance_variable_get(n)) }\n" ++
    "        v = entry(re, idx)\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x5b # [\n" ++
    "        len = long\n" ++
    "        raise ArgumentError, \"negative length\" if len < 0\n" ++
    "        v = klass ? __alloc(klass, ::Array) : []\n" ++
    "        v = entry(v)\n" ++
    "        # rb_ary_push, not the class's own << or push\n" ++
    "        len.times \{ Marshal.__push(v, object) }\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x7b, 0x7d\n" ++
    "        v = read_hash(type, partial, false, klass)\n" ++
    "      when 0x53 # S\n" ++
    "        idx = prepare\n" ++
    "        c = path2class(unique)\n" ++
    "        len = long\n" ++
    "        is_data = defined?(::Data) && c < ::Data\n" ++
    "        unless c < Struct || is_data\n" ++
    "          raise TypeError, \"class #\{c} not a struct\"\n" ++
    "        end\n" ++
    "        ms = c.members\n" ++
    "        if ms.size != len\n" ++
    "          raise TypeError, \"struct #\{c} not compatible (struct size differs)\"\n" ++
    "        end\n" ++
    "        v = c.allocate\n" ++
    "        v = entry(v, idx)\n" ++
    "        vals = []\n" ++
    "        ms.each do |m|\n" ++
    "          slot = symbol_str\n" ++
    "          if m.to_s != slot\n" ++
    "            raise TypeError, \"struct #\{c} not compatible (:#\{slot} for :#\{m})\"\n" ++
    "          end\n" ++
    "          vals << object\n" ++
    "        end\n" ++
    "        if is_data\n" ++
    "          ms.each_with_index \{ |m, i| v.instance_variable_set(:\"@#\{m}\", vals[i]) }\n" ++
    "          Marshal.__freeze(v)\n" ++
    "        else\n" ++
    "          vals.each_with_index \{ |x, i| v[i] = x }\n" ++
    "        end\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x75 # u\n" ++
    "        name = unique\n" ++
    "        c = path2class(name)\n" ++
    "        raise TypeError, \"class #\{name} needs to have method '_load'\" unless c.respond_to?(:_load, true)\n" ++
    "        data = bytes\n" ++
    "        timeload = c <= ::Time && c.method(:_load).owner.equal?(::Time.singleton_class)\n" ++
    "        hidden = nil\n" ++
    "        if ivp\n" ++
    "          # Time's zone and offset arrive as ivars of the data, named without\n" ++
    "          # an @; they are handed to Time._load rather than set on the String\n" ++
    "          saved = @hidden\n" ++
    "          @hidden = hidden = \{} if timeload\n" ++
    "          r_ivar(data)\n" ++
    "          @hidden = saved\n" ++
    "          ivp[0] = false\n" ++
    "        end\n" ++
    "        v = timeload ? c.__send__(:_load, data, hidden) : c.__send__(:_load, data)\n" ++
    "        v = entry(v)\n" ++
    "        unless partial\n" ++
    "          Marshal.__freeze(v) if @freeze\n" ++
    "          v = post_proc(v)\n" ++
    "        end\n" ++
    "      when 0x55 # U\n" ++
    "        name = unique\n" ++
    "        c = path2class(name)\n" ++
    "        if c.equal?(::Rational) || c.equal?(::Complex)\n" ++
    "          # built, never allocated: the pair comes first\n" ++
    "          idx = prepare\n" ++
    "          data = object\n" ++
    "          raise ArgumentError, \"marshaled #\{name.downcase} must have an array whose length is 2 but #\{data.size}\" unless Array === data && data.size == 2\n" ++
    "          v = c.equal?(::Rational) ? Rational(data[0], data[1]) : Complex(data[0], data[1])\n" ++
    "          v = entry(v, idx)\n" ++
    "          v = post_proc(v)\n" ++
    "          return v\n" ++
    "        end\n" ++
    "        v = c.allocate\n" ++
    "        extmod.each \{ |m| v.extend(m) } if extmod && !extmod.empty?\n" ++
    "        unless v.respond_to?(:marshal_load, true)\n" ++
    "          raise TypeError, \"instance of #\{name} needs to have method 'marshal_load'\"\n" ++
    "        end\n" ++
    "        v = entry(v)\n" ++
    "        data = object\n" ++
    "        v.__send__(:marshal_load, data)\n" ++
    "        Marshal.__freeze(v) if @freeze\n" ++
    "        v = post_proc(v)\n" ++
    "        extmod.clear if extmod\n" ++
    "      when 0x6f # o\n" ++
    "        idx = prepare\n" ++
    "        c = path2class(unique)\n" ++
    "        if c <= Range\n" ++
    "          v = entry(c.allocate, idx)\n" ++
    "          @range_parts = \{}\n" ++
    "          r_ivar(v)\n" ++
    "          parts = @range_parts\n" ++
    "          @range_parts = nil\n" ++
    "          v = __range(c, parts[\"begin\"], parts[\"end\"], parts[\"excl\"], v)\n" ++
    "          @data[idx] = v\n" ++
    "        else\n" ++
    "          raise ArgumentError, \"dump format error\" unless plain_class?(c)\n" ++
    "          v = entry(c.allocate, idx)\n" ++
    "          r_ivar(v)\n" ++
    "        end\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x64 # d\n" ++
    "        name = unique\n" ++
    "        c = path2class(name)\n" ++
    "        raise ArgumentError, \"dump format error\" if plain_class?(c)\n" ++
    "        v = c.allocate\n" ++
    "        v = entry(v)\n" ++
    "        unless v.respond_to?(:_load_data, true)\n" ++
    "          raise TypeError, \"class #\{name} needs to have instance method '_load_data'\"\n" ++
    "        end\n" ++
    "        r = object0(partial, nil, extmod)\n" ++
    "        v.__send__(:_load_data, r)\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x4d # M (old module)\n" ++
    "        s = bytes\n" ++
    "        v = Marshal.__const_at(s)\n" ++
    "        raise ArgumentError, \"undefined class/module #\{s}\" if v.nil?\n" ++
    "        raise TypeError, \"can't override instance variable of class/module '#\{s}'\" if ivp && ivp[0]\n" ++
    "        v = entry(v)\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x63, 0x6d # c, m\n" ++
    "        s = bytes\n" ++
    "        if ivp && ivp[0]\n" ++
    "          n = long\n" ++
    "          if n > 0\n" ++
    "            k = symbol_str\n" ++
    "            val = object\n" ++
    "            e = enc_for(k, val)\n" ++
    "            s.force_encoding(e) if e\n" ++
    "            n -= 1 if e\n" ++
    "          end\n" ++
    "          ivp[0] = n > 0\n" ++
    "        end\n" ++
    "        v = type == 0x63 ? path2class(s) : path2module(s)\n" ++
    "        if ivp && ivp[0]\n" ++
    "          raise TypeError, \"can't override instance variable of #\{type == 0x63 ? 'class' : 'module'} '#\{s}'\"\n" ++
    "        end\n" ++
    "        v = entry(v)\n" ++
    "        v = leave(v, partial)\n" ++
    "      when 0x3a # :\n" ++
    "        if ivp\n" ++
    "          s = symreal(ivp[0])\n" ++
    "          ivp[0] = false\n" ++
    "        else\n" ++
    "          s = symreal(false)\n" ++
    "        end\n" ++
    "        v = leave(s.to_sym, partial)\n" ++
    "      when 0x3b # ;\n" ++
    "        n = long\n" ++
    "        raise ArgumentError, \"bad symbol\" if n >= @syms.size\n" ++
    "        v = @syms[n].to_sym\n" ++
    "      else\n" ++
    "        raise ArgumentError, format(\"dump format error(0x%x)\", type)\n" ++
    "      end\n" ++
    "      raise ArgumentError, \"dump format error (bad link)\" if v.equal?(:__undef)\n" ++
    "      v\n" ++
    "    end\n" ++
    "\n" ++
    "    def read_hash(type, partial, ident, klass = nil)\n" ++
    "      len = long\n" ++
    "      raise ArgumentError, \"negative length\" if len < 0\n" ++
    "      v = klass ? __alloc(klass, ::Hash) : \{}\n" ++
    "      v.compare_by_identity if ident\n" ++
    "      v = entry(v)\n" ++
    "      len.times do\n" ++
    "        k = object\n" ++
    "        val = object\n" ++
    "        STORE.bind_call(v, k, val)\n" ++
    "      end\n" ++
    "      v.default = object if type == 0x7d\n" ++
    "      leave(v, partial)\n" ++
    "    end\n" ++
    "\n" ++
    "    # an empty instance of c, a subclass of String / Array / Hash, made\n" ++
    "    # without its initialize (rb_obj_alloc)\n" ++
    "    def __alloc(c, base)\n" ++
    "      raise ArgumentError, \"dump format error (user class)\" unless c <= base\n" ++
    "      v = base.new\n" ++
    "      c.equal?(base) ? v : Marshal.__retag(v, c)\n" ++
    "    end\n" ++
    "\n" ++
    "    # an instance of c would be a T_OBJECT: none of the builtin value classes\n" ++
    "    def plain_class?(c)\n" ++
    "      [::String, ::Array, ::Hash, ::Regexp, ::Struct, ::Module, ::Numeric, ::Symbol, ::Range, ::Time,\n" ++
    "       ::Proc, ::Method, ::UnboundMethod, ::IO, ::Dir, ::MatchData, ::Thread].none? \{ |b| c <= b }\n" ++
    "    end\n" ++
    "\n" ++
    "    # the value, now an instance of the subclass c (RBASIC_SET_CLASS)\n" ++
    "    def __retag(v, c)\n" ++
    "      return v if c.nil? || v.class.equal?(c)\n" ++
    "      base = [::String, ::Array, ::Hash, ::Regexp].find \{ |b| b === v }\n" ++
    "      raise ArgumentError, \"dump format error (user class)\" unless base && c <= base\n" ++
    "      if String === v || Array === v || Hash === v\n" ++
    "        Marshal.__retag(v, c)\n" ++
    "      elsif Regexp === v\n" ++
    "        o = c.new(v.source, v.options)\n" ++
    "        v.instance_variables.each \{ |n| o.instance_variable_set(n, v.instance_variable_get(n)) }\n" ++
    "        @data.each \{ |k, x| @data[k] = o if x.equal?(v) }\n" ++
    "        o\n" ++
    "      else\n" ++
    "        v\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def __range(c, b, e, excl, placeholder)\n" ++
    "      r = c.equal?(::Range) ? ::Range.new(b, e, excl) : c.new(b, e, excl)\n" ++
    "      placeholder.instance_variables.each \{ |n| r.instance_variable_set(n, placeholder.instance_variable_get(n)) }\n" ++
    "      r\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "English" then
    "# `English` gives the punctuation globals readable names. mere-ruby aliases the\n" ++
    "# ones it actually tracks; the rest would be lies.\n" ++
    "alias $ERROR_INFO $!\n" ++
    "alias $ERROR_POSITION $@\n" ++
    "alias $FS $;\n" ++
    "alias $FIELD_SEPARATOR $;\n" ++
    "alias $OFS $,\n" ++
    "alias $OUTPUT_FIELD_SEPARATOR $,\n" ++
    "alias $RS $/\n" ++
    "alias $INPUT_RECORD_SEPARATOR $/\n" ++
    "alias $ORS $\\\n" ++
    "alias $OUTPUT_RECORD_SEPARATOR $\\\n" ++
    "alias $INPUT_LINE_NUMBER $.\n" ++
    "alias $NR $.\n" ++
    "alias $LAST_READ_LINE $_\n" ++
    "alias $DEFAULT_OUTPUT $>\n" ++
    "alias $DEFAULT_INPUT $<\n" ++
    "alias $PID $$\n" ++
    "alias $PROCESS_ID $$\n" ++
    "alias $CHILD_STATUS $?\n" ++
    "alias $LAST_MATCH_INFO $~\n" ++
    "alias $IGNORECASE $=\n" ++
    "alias $ARGV $*\n" ++
    "alias $MATCH $&\n" ++
    "alias $PREMATCH $`\n" ++
    "alias $POSTMATCH $'\n" ++
    "alias $LAST_PAREN_MATCH $+\n"
  else if str_eq n "zlib" then
    // The compression is the vendored mgz package, reached through the
    // built-in Zlib module methods (crc32 / adler32 / deflate / inflate /
    // gzip / gunzip). What is Ruby here is the STREAM surface around it:
    // GzipReader reads a whole member and serves it, which is how a gem
    // reads a .gz data file.
    "module Zlib\n" ++
    "  # the version this implementation follows (Zlib::ZLIB_VERSION)\n" ++
    "  def self.zlib_version\n" ++
    "    ZLIB_VERSION\n" ++
    "  end\n" ++
    "  class Error < StandardError; end\n" ++
    "  class BufError < Error; end\n" ++
    "  class NeedDict < Error; end\n" ++
    "  class StreamError < Error; end\n" ++
    "  class MemError < Error; end\n" ++
    "  class VersionError < Error; end\n" ++
    "  class InProgressError < Error; end\n" ++
    "  # zlib's own CRC-32 table (get_crc_table), the reflected 0xEDB88320\n" ++
    "  def self.crc_table\n" ++
    "    (0...256).map do |n|\n" ++
    "      c = n\n" ++
    "      8.times \{ c = (c & 1) == 1 ? 0xEDB88320 ^ (c >> 1) : c >> 1 }\n" ++
    "      c\n" ++
    "    end\n" ++
    "  end\n" ++
    "  class DataError < Error; end\n" ++
    "  class GzipFile\n" ++
    "    class Error < Zlib::Error; end\n" ++
    "    class CRCError < Error; end\n" ++
    "    class LengthError < Error; end\n" ++
    "    class NoFooter < Error; end\n" ++
    "    def close; @io.close if @io.respond_to?(:close); @closed = true; nil; end\n" ++
    "    def closed?; @closed ? true : false; end\n" ++
    "    def finish; close; end\n" ++
    "  end\n" ++
    "  class GzipReader < GzipFile\n" ++
    "    def self.open(path)\n" ++
    "      gz = new(File.open(path, \"rb\"))\n" ++
    "      return gz unless block_given?\n" ++
    "      begin\n" ++
    "        yield gz\n" ++
    "      ensure\n" ++
    "        gz.close\n" ++
    "      end\n" ++
    "    end\n" ++
    "    # The member is read in 2048-byte pieces, as ruby's reader asks its io\n" ++
    "    # (so an io offering only read(len) is enough), and decompressed whole.\n" ++
    "    # The unread part is @data from @i; #pos is @i plus @adj, which ungetc /\n" ++
    "    # ungetbyte move back without moving @i -- the bytes they push are\n" ++
    "    # inserted at @i, so reading them again brings #pos back.\n" ++
    "    def initialize(io, opts = nil, external_encoding: nil, internal_encoding: nil, encoding: nil)\n" ++
    "      @io = io\n" ++
    "      src = +\"\".b\n" ++
    "      if io.respond_to?(:read)\n" ++
    "        while (chunk = io.read(2048)) && !chunk.empty?\n" ++
    "          src << chunk.b\n" ++
    "        end\n" ++
    "      else\n" ++
    "        src = io.to_s.b\n" ++
    "      end\n" ++
    "      @raw_len = src.bytesize\n" ++
    "      @orig = Zlib.gunzip(src).b\n" ++
    "      @data = @orig.dup\n" ++
    "      @i = 0\n" ++
    "      @adj = 0\n" ++
    "      enc = external_encoding || (encoding && encoding.to_s.split(\":\")[0])\n" ++
    "      @enc = enc ? Encoding.find(enc.to_s) : Encoding.default_external\n" ++
    "      # the MTIME is header bytes 4..7, little-endian; the member carries it\n" ++
    "      # whatever the data is, and #mtime answered the epoch for every file.\n" ++
    "      @mtime = Time.at(src.byteslice(4, 4).unpack1(\"V\")) if src.bytesize >= 8\n" ++
    "    end\n" ++
    "    def __rest = @data.byteslice(@i, @data.bytesize - @i)\n" ++
    "    def read(len = nil, buf = nil)\n" ++
    "      unless len.nil?\n" ++
    "        len = Integer(len)\n" ++
    "        raise ArgumentError, \"negative length #\{len} given\" if len < 0\n" ++
    "      end\n" ++
    "      if len.nil?\n" ++
    "        r = __rest.force_encoding(@enc)\n" ++
    "        @i = @data.bytesize\n" ++
    "      else\n" ++
    "        return +\"\".b if len == 0\n" ++
    "        return nil if @i >= @data.bytesize\n" ++
    "        r = @data.byteslice(@i, len)\n" ++
    "        @i += r.bytesize\n" ++
    "      end\n" ++
    "      buf ? buf.replace(r) : r\n" ++
    "    end\n" ++
    "    def readpartial(len, buf = nil)\n" ++
    "      raise EOFError, \"end of file reached\" if eof?\n" ++
    "      read(len, buf)\n" ++
    "    end\n" ++
    "    # gets(sep = $/, limit = nil): nil reads the rest, \"\" is PARAGRAPH mode\n" ++
    "    # (newlines between paragraphs are skipped, a paragraph ends in two)\n" ++
    "    def gets(sep = $/, limit = nil)\n" ++
    "      if sep.is_a?(Integer)\n" ++
    "        limit = sep\n" ++
    "        sep = $/\n" ++
    "      end\n" ++
    "      return nil if @i >= @data.bytesize\n" ++
    "      if sep.nil?\n" ++
    "        stop = @data.bytesize\n" ++
    "      elsif sep == \"\"\n" ++
    "        @i += 1 while @i < @data.bytesize && @data.getbyte(@i) == 10\n" ++
    "        return nil if @i >= @data.bytesize\n" ++
    "        k = @data.index(\"\\n\\n\", @i)\n" ++
    "        stop = k.nil? ? @data.bytesize : k + 2\n" ++
    "      else\n" ++
    "        k = @data.index(sep.b, @i)\n" ++
    "        stop = k.nil? ? @data.bytesize : k + sep.bytesize\n" ++
    "      end\n" ++
    "      stop = @i + limit if limit && limit >= 0 && stop - @i > limit\n" ++
    "      r = @data.byteslice(@i, stop - @i).force_encoding(@enc)\n" ++
    "      @i = stop\n" ++
    "      @i += 1 while sep == \"\" && @i < @data.bytesize && @data.getbyte(@i) == 10\n" ++
    "      @lineno = lineno + 1\n" ++
    "      r\n" ++
    "    end\n" ++
    "    # each_line, eof and tell are ALIASES of each, eof? and pos -- one\n" ++
    "    # method under two names, which is what the specs compare.\n" ++
    "    def each\n" ++
    "      return to_enum(:each) unless block_given?\n" ++
    "      while (line = gets)\n" ++
    "        yield line\n" ++
    "      end\n" ++
    "      self\n" ++
    "    end\n" ++
    "    alias each_line each\n" ++
    "    def readlines\n" ++
    "      out = []\n" ++
    "      while (line = gets)\n" ++
    "        out << line\n" ++
    "      end\n" ++
    "      out\n" ++
    "    end\n" ++
    "    def eof?; @i >= @data.bytesize; end\n" ++
    "    alias eof eof?\n" ++
    "    def pos; @i + @adj; end\n" ++
    "    alias tell pos\n" ++
    "    # back to the start of the member: the io is moved back over what was\n" ++
    "    # read from it, and what ungetc pushed is gone\n" ++
    "    def rewind\n" ++
    "      @io.seek(-@raw_len, IO::SEEK_CUR) if @io.respond_to?(:seek)\n" ++
    "      @data = @orig.dup\n" ++
    "      @i = 0\n" ++
    "      @adj = 0\n" ++
    "      @lineno = 0\n" ++
    "      0\n" ++
    "    end\n" ++
    "    def self.zcat(io, &block)\n" ++
    "      gz = new(io)\n" ++
    "      begin\n" ++
    "        data = gz.read\n" ++
    "        block_given? ? block.call(data) : data\n" ++
    "      ensure\n" ++
    "        gz.close\n" ++
    "      end\n" ++
    "    end\n" ++
    "    def lineno = @lineno ||= 0\n" ++
    "    def lineno=(n) = (@lineno = n)\n" ++
    "    def external_encoding = @enc\n" ++
    "    def unused = nil\n" ++
    "    def getbyte\n" ++
    "      return nil if eof?\n" ++
    "      b = @data.getbyte(@i)\n" ++
    "      @i += 1\n" ++
    "      b\n" ++
    "    end\n" ++
    "    def readbyte\n" ++
    "      b = getbyte\n" ++
    "      raise EOFError, \"end of file reached\" if b.nil?\n" ++
    "      b\n" ++
    "    end\n" ++
    "    def getc\n" ++
    "      return nil if eof?\n" ++
    "      c = @data.byteslice(@i, @data.bytesize - @i).force_encoding(@enc)[0]\n" ++
    "      @i += c.bytesize\n" ++
    "      c\n" ++
    "    end\n" ++
    "    def readchar\n" ++
    "      c = getc\n" ++
    "      raise EOFError, \"end of file reached\" if c.nil?\n" ++
    "      c\n" ++
    "    end\n" ++
    "    def readline\n" ++
    "      l = gets\n" ++
    "      raise EOFError, \"end of file reached\" if l.nil?\n" ++
    "      l\n" ++
    "    end\n" ++
    "    # push back: the bytes go in front of what is unread, and #pos moves back\n" ++
    "    # by as many (it may go below zero)\n" ++
    "    def ungetbyte(b)\n" ++
    "      return nil if b.nil?\n" ++
    "      s = b.is_a?(Integer) ? (b & 0xff).chr.b : b.to_s.b\n" ++
    "      __unget(s)\n" ++
    "    end\n" ++
    "    def ungetc(c)\n" ++
    "      return nil if c.nil?\n" ++
    "      s = c.is_a?(Integer) ? c.chr(@enc).b : c.to_s.b\n" ++
    "      __unget(s)\n" ++
    "    end\n" ++
    "    def __unget(s)\n" ++
    "      @data = @data.byteslice(0, @i) + s + __rest\n" ++
    "      @adj -= s.bytesize\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    def each_byte\n" ++
    "      return to_enum(:each_byte) unless block_given?\n" ++
    "      while (b = getbyte)\n" ++
    "        yield b\n" ++
    "      end\n" ++
    "      self\n" ++
    "    end\n" ++
    "    def each_char\n" ++
    "      return to_enum(:each_char) unless block_given?\n" ++
    "      while (c = getc)\n" ++
    "        yield c\n" ++
    "      end\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "  class GzipWriter < GzipFile\n" ++
    "    def self.open(path)\n" ++
    "      gz = new(File.open(path, \"wb\"))\n" ++
    "      return gz unless block_given?\n" ++
    "      begin\n" ++
    "        yield gz\n" ++
    "      ensure\n" ++
    "        gz.close\n" ++
    "      end\n" ++
    "    end\n" ++
    "    def initialize(io, level = nil, strategy = nil)\n" ++
    "      @io = io\n" ++
    "      @buf = +\"\".b\n" ++
    "    end\n" ++
    "    # ⚠ append IN PLACE. `@buf += s` copies the whole buffer per write,\n" ++
    "    # which is quadratic over a stream of them.\n" ++
    "    # (the first write, even of \"\", is when ruby writes the header)\n" ++
    "    def write(str); @__wrote = true; s = str.to_s; @buf << s; s.bytesize; end\n" ++
    "    def <<(str); write(str); self; end\n" ++
    "    def print(*args)\n" ++
    "      args.each do |a|\n" ++
    "        write(a)\n" ++
    "      end\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    def puts(*args)\n" ++
    "      args.each do |a|\n" ++
    "        s = a.to_s\n" ++
    "        write(s)\n" ++
    "        write(\"\\n\") unless s.end_with?(\"\\n\")\n" ++
    "      end\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    # the requested MTIME goes into header bytes 4..7. The CRC covers the\n" ++
    "    # data only, so the header can be written after compression.\n" ++
    "    def close\n" ++
    "      out = Zlib.gzip(@buf).b\n" ++
    "      out[4, 4] = [@mtime.to_i].pack(\"V\") if @mtime\n" ++
    "      @io.write(out) if @io.respond_to?(:write)\n" ++
    "      @io.close if @io.respond_to?(:close)\n" ++
    "      @closed = true\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    def finish; close; end\n" ++
    "  end\n" ++
    "end\n" ++
    "module Zlib\n" ++
    "  # The one-shot compressors this interpreter has natively (Zlib.deflate /\n" ++
    "  # .inflate / .gzip / .gunzip) are the engine. Everything below is the\n" ++
    "  # STREAMING surface on top of them: input is buffered and the engine is run\n" ++
    "  # once, at `finish`, which is the same answer a chunked stream gives because\n" ++
    "  # deflate is deterministic here.\n" ++
    "  # The shared surface, mixed into ZStream, which Deflate and Inflate\n" ++
    "  # inherit as in ruby. (They were pre-registered as bare MODULES, so this\n" ++
    "  # was mixed into each instead; their class methods are still answered\n" ++
    "  # natively, by name.)\n" ++
    "  module ZStreamCommon\n" ++
    "    def __zinit\n" ++
    "      @in = +\"\".b\n" ++
    "      @out = +\"\".b\n" ++
    "      @closed = false\n" ++
    "      @finished = false\n" ++
    "      @total_in = 0\n" ++
    "      @plain = +\"\".b\n" ++
    "    end\n" ++
    "\n" ++
    "    def total_in = @total_in\n" ++
    "    def total_out = @out.bytesize\n" ++
    "    def avail_in = @in.bytesize\n" ++
    "    def avail_out = 0\n" ++
    "    def avail_out=(n) = n\n" ++
    "    def data_type = Zlib::UNKNOWN\n" ++
    "    # ruby's ZStream#adler is over the UNCOMPRESSED data, which is the input\n" ++
    "    # when deflating and the output when inflating.\n" ++
    "    def adler = Zlib.adler32(@plain)\n" ++
    "    def finished? = @finished\n" ++
    "    alias stream_end? finished?\n" ++
    "    def closed? = @closed\n" ++
    "    alias ended? closed?\n" ++
    "    def close\n" ++
    "      @closed = true\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    alias end close\n" ++
    "    def reset\n" ++
    "      @in = +\"\".b\n" ++
    "      @out = +\"\".b\n" ++
    "      @finished = false\n" ++
    "      @total_in = 0\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    def flush_next_in\n" ++
    "      s = @in\n" ++
    "      @in = +\"\".b\n" ++
    "      s\n" ++
    "    end\n" ++
    "    def flush_next_out\n" ++
    "      s = @out\n" ++
    "      @out = +\"\".b\n" ++
    "      s\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  class ZStream\n" ++
    "    include ZStreamCommon\n" ++
    "    def initialize = __zinit\n" ++
    "  end\n" ++
    "\n" ++
    "  class Deflate < ZStream\n" ++
    "    def initialize(level = nil, window_bits = nil, mem_level = nil, strategy = nil)\n" ++
    "      __zinit\n" ++
    "      @level = level\n" ++
    "    end\n" ++
    "\n" ++
    "    def deflate(str, flush = 0)\n" ++
    "      return finish if str.nil?\n" ++
    "      @in << str.to_s.b\n" ++
    "      @total_in += str.to_s.bytesize\n" ++
    "      +\"\".b\n" ++
    "    end\n" ++
    "\n" ++
    "    def <<(str)\n" ++
    "      deflate(str)\n" ++
    "      self\n" ++
    "    end\n" ++
    "\n" ++
    "    def finish\n" ++
    "      @finished = true\n" ++
    "      @plain = @in\n" ++
    "      @out = Zlib.deflate(@in)\n" ++
    "      @out\n" ++
    "    end\n" ++
    "\n" ++
    "    def flush(_v = nil) = +\"\".b\n" ++
    "\n" ++
    "    # params changes the LEVEL and STRATEGY for what follows. The engine is\n" ++
    "    # one-shot, so the whole stream is compressed at #finish with one setting;\n" ++
    "    # that changes how small the output is and never what it inflates to, so\n" ++
    "    # the call is accepted and recorded rather than refused. (The dictionary\n" ++
    "    # below does change what the stream means, and stays refused.)\n" ++
    "    def params(level, strategy)\n" ++
    "      @level = level\n" ++
    "      @strategy = strategy\n" ++
    "      nil\n" ++
    "    end\n" ++
    "\n" ++
    "    def set_dictionary(_d)\n" ++
    "      raise NotImplementedError, \"Zlib::Deflate#set_dictionary: this deflate is one-shot\"\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ A STREAM, over the native stream decoder (Zlib.__inflate_x): input is\n" ++
    "  # kept until the zlib stream in it is complete, and then the stream is\n" ++
    "  # FINISHED -- what arrived after its end, and whatever is fed later, passes\n" ++
    "  # through unchanged, as zlib's does. It used to inflate whatever it had\n" ++
    "  # and swallow every error, so an incomplete stream finished as \"\", data\n" ++
    "  # after the end vanished, and a preset dictionary was refused outright.\n" ++
    "  # Output is handed out in 16384-byte chunks when a block is given (zlib's\n" ++
    "  # buffer), and what a `break` leaves stays for the next call.\n" ++
    "  class Inflate < ZStream\n" ++
    "    def initialize(window_bits = nil)\n" ++
    "      __zinit\n" ++
    "      @dict = nil\n" ++
    "    end\n" ++
    "\n" ++
    "    def __feed(str)\n" ++
    "      raise Zlib::Error, \"stream is not ready\" if @closed\n" ++
    "      if str.nil?\n" ++
    "        __decode(true) unless @finished\n" ++
    "        return\n" ++
    "      end\n" ++
    "      s = (String === str ? str : str.to_str).b\n" ++
    "      @total_in += s.bytesize\n" ++
    "      if @finished\n" ++
    "        @out << s\n" ++
    "      else\n" ++
    "        @in << s\n" ++
    "        __decode(false)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def __decode(final)\n" ++
    "      st, out, used, _id = Zlib.__inflate_x(@in, @dict)\n" ++
    "      case st\n" ++
    "      when 0\n" ++
    "        @out << out\n" ++
    "        @plain = out\n" ++
    "        @finished = true\n" ++
    "        rest = @in.byteslice(used, @in.bytesize - used)\n" ++
    "        @in = +\"\".b\n" ++
    "        @out << rest\n" ++
    "      when 1\n" ++
    "        raise Zlib::BufError, \"buffer error\" if final\n" ++
    "      when 3\n" ++
    "        raise Zlib::NeedDict, \"need dictionary\"\n" ++
    "      when 4\n" ++
    "        raise Zlib::DataError, \"incorrect data check\"\n" ++
    "      else\n" ++
    "        raise Zlib::DataError, \"invalid compressed data -- format violated\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def __drain\n" ++
    "      if block_given?\n" ++
    "        until @out.empty?\n" ++
    "          chunk = @out.byteslice(0, 16384)\n" ++
    "          @out = @out.byteslice(chunk.bytesize, @out.bytesize - chunk.bytesize)\n" ++
    "          yield chunk\n" ++
    "        end\n" ++
    "        nil\n" ++
    "      else\n" ++
    "        r = @out\n" ++
    "        @out = +\"\".b\n" ++
    "        r\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def inflate(str, buffer: nil, &blk)\n" ++
    "      __feed(str)\n" ++
    "      r = __drain(&blk)\n" ++
    "      buffer && r ? buffer.replace(r) : r\n" ++
    "    end\n" ++
    "\n" ++
    "    def <<(str)\n" ++
    "      __feed(str)\n" ++
    "      self\n" ++
    "    end\n" ++
    "\n" ++
    "    def finish(&blk)\n" ++
    "      __decode(true) unless @finished || @in.empty?\n" ++
    "      __drain(&blk)\n" ++
    "    end\n" ++
    "\n" ++
    "    def total_out = @plain.bytesize\n" ++
    "\n" ++
    "    def sync(_str) = false\n" ++
    "    def sync_point? = false\n" ++
    "\n" ++
    "    # the dictionary a stream asked for (NeedDict); the next decode seeds its\n" ++
    "    # window with it\n" ++
    "    def set_dictionary(d)\n" ++
    "      @dict = (String === d ? d : d.to_str).b\n" ++
    "      d\n" ++
    "    end\n" ++
    "\n" ++
    "    def add_dictionary(d)\n" ++
    "      set_dictionary(d)\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "module Zlib\n" ++
    "  class GzipFile\n" ++
    "    # `wrap` is the constructor the specs use, and it was the one name keeping\n" ++
    "    # most of the GzipReader/GzipWriter files out: they all write\n" ++
    "    # `Zlib::GzipWriter.wrap(io) \{ |gz| ... }` rather than .open(path).\n" ++
    "    # It answers the BLOCK's value, not the io.\n" ++
    "    def self.wrap(io, *args)\n" ++
    "      gz = new(io, *args)\n" ++
    "      return gz unless block_given?\n" ++
    "      begin\n" ++
    "        yield gz\n" ++
    "      ensure\n" ++
    "        gz.close unless gz.closed?\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    # The gzip member header fields. This engine writes a header it does not\n" ++
    "    # let the caller shape, so the writers RECORD what was asked and the\n" ++
    "    # readers answer what the member actually carried.\n" ++
    "    # ...and a CLOSED gzip stream refuses them, as ruby's does.\n" ++
    "    attr_writer :comment, :orig_name\n" ++
    "    def comment\n" ++
    "      raise Zlib::GzipFile::Error, \"closed gzip stream\" if @closed\n" ++
    "      @comment\n" ++
    "    end\n" ++
    "    def orig_name\n" ++
    "      raise Zlib::GzipFile::Error, \"closed gzip stream\" if @closed\n" ++
    "      @orig_name\n" ++
    "    end\n" ++
    "    def mtime = @mtime || Time.at(0)\n" ++
    "    def mtime=(v)\n" ++
    "      raise Zlib::GzipFile::Error, \"header is already written\" if @__wrote\n" ++
    "      @mtime = v.is_a?(Time) ? v : Time.at(v.to_i)\n" ++
    "      v\n" ++
    "    end\n" ++
    "    def level = @level || Zlib::DEFAULT_COMPRESSION\n" ++
    "    def os_code = 3            # Unix, which is what the writer emits\n" ++
    "    def crc = @crc || 0\n" ++
    "    def sync = @sync ? true : false\n" ++
    "    def sync=(v) = (@sync = v)\n" ++
    "    def to_io = @io\n" ++
    "    def closed? = @closed ? true : false\n" ++
    "  end\n" ++
    "\n" ++
    "  class GzipWriter < GzipFile\n" ++
    "    def pos = @buf.to_s.bytesize\n" ++
    "    alias tell pos\n" ++
    "    def flush(_v = nil) = self\n" ++
    "    def printf(fmt, *args) = write(format(fmt, *args))\n" ++
    "    def putc(c)\n" ++
    "      write(c.is_a?(Integer) ? c.chr : c.to_s[0])\n" ++
    "      c\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n"
  // `etc` is a C extension in CRuby. nprocessors is this runtime's truth
  // (thread bodies share one processor here), not a stand-in for the
  // machine's; the account databases and the configuration values are the
  // system's own, read through the tools that answer from the same source
  // (see the note inside).
  else if str_eq n "etc" then
    "module Etc\n" ++
    "  VERSION = \"1.4.6\"\n" ++
    "  def self.nprocessors; 1; end\n" ++
    "  # getlogin(3) is the session's login name, which is what logname(1) prints\n" ++
    "  # (the child shares our session); only when there is none does ruby fall\n" ++
    "  # back to $USER -- $LOGNAME is not consulted.\n" ++
    "  def self.getlogin\n" ++
    "    s = `logname 2>/dev/null`.chomp\n" ++
    "    $?.success? && !s.empty? ? s : ENV['USER']\n" ++
    "  end\n" ++
    "  def self.systmpdir; ENV['TMPDIR'] || '/tmp'; end\n" ++
    "  # this interpreter has no install prefix of its own; the system one\n" ++
    "  def self.sysconfdir; '/etc'; end\n" ++
    "\n" ++
    "  # ⚠ The user and group databases are read through a subprocess, as\n" ++
    "  #   File::Stat is: getpwuid(3) and friends fill a struct, and this host's\n" ++
    "  #   FFI carries ints, floats and strings. The tool is the one that answers\n" ++
    "  #   from the SAME database the C calls use -- getent(1) on Linux (NSS), and\n" ++
    "  #   dscacheutil(1) on macOS, where most accounts are in Directory Services\n" ++
    "  #   and not in /etc/passwd at all. The struct is darwin's (change, uclass\n" ++
    "  #   and expire, which Directory Services leaves 0 / \"\" / 0 for an account).\n" ++
    "  Passwd = Struct.new(:name, :passwd, :uid, :gid, :gecos, :dir, :shell, :change, :uclass, :expire)\n" ++
    "  Group = Struct.new(:name, :passwd, :gid, :mem)\n" ++
    "\n" ++
    "  def self.__linux?\n" ++
    "    @__linux = (`uname -s 2>/dev/null`.strip == \"Linux\") if @__linux.nil?\n" ++
    "    @__linux\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__shq(s) = \"'\" + s.to_s.gsub(\"'\", \"'\\\\\\\\''\") + \"'\"\n" ++
    "\n" ++
    "  # dscacheutil prints \"key: value\" records separated by blank lines.\n" ++
    "  def self.__ds(kind, key = nil, val = nil)\n" ++
    "    q = key ? \" -a #\{key} #\{__shq(val)}\" : \"\"\n" ++
    "    `dscacheutil -q #\{kind}#\{q} 2>/dev/null`.split(/\\n\\s*\\n/).filter_map do |rec|\n" ++
    "      h = \{}\n" ++
    "      rec.each_line do |l|\n" ++
    "        k, v = l.chomp.split(\": \", 2)\n" ++
    "        h[k] = v.to_s if k && !k.empty?\n" ++
    "      end\n" ++
    "      h.empty? ? nil : h\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__getent(db, key = nil)\n" ++
    "    `getent #\{db}#\{key.nil? ? \"\" : \" \" + __shq(key)} 2>/dev/null`.each_line.map \{ |l| l.chomp.split(\":\", -1) }\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__pw_all(key = nil, val = nil)\n" ++
    "    if __linux?\n" ++
    "      __getent(\"passwd\", val).map do |f|\n" ++
    "        Passwd.new(f[0], f[1], f[2].to_i, f[3].to_i, f[4].to_s, f[5].to_s, f[6].to_s, 0, \"\", 0)\n" ++
    "      end\n" ++
    "    else\n" ++
    "      __ds(\"user\", key, val).map do |h|\n" ++
    "        Passwd.new(h[\"name\"], h[\"password\"].to_s, h[\"uid\"].to_i, h[\"gid\"].to_i, h[\"gecos\"].to_s,\n" ++
    "                   h[\"dir\"].to_s, h[\"shell\"].to_s, 0, \"\", 0)\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__gr_all(key = nil, val = nil)\n" ++
    "    if __linux?\n" ++
    "      __getent(\"group\", val).map \{ |f| Group.new(f[0], f[1], f[2].to_i, f[3].to_s.split(\",\")) }\n" ++
    "    else\n" ++
    "      __ds(\"group\", key, val).map do |h|\n" ++
    "        Group.new(h[\"name\"], h[\"password\"].to_s, h[\"gid\"].to_i, h[\"users\"].to_s.split)\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__id_arg(v)\n" ++
    "    return v if v.is_a?(Integer)\n" ++
    "    raise TypeError, \"no implicit conversion from nil to integer\" if v.nil?\n" ++
    "    raise TypeError, \"no implicit conversion of #\{v.class} into Integer\" unless v.respond_to?(:to_int)\n" ++
    "    v.to_int\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.__name_arg(v)\n" ++
    "    return v if v.is_a?(String)\n" ++
    "    raise TypeError, \"no implicit conversion of #\{v.nil? ? 'nil' : v.class} into String\" unless v.respond_to?(:to_str)\n" ++
    "    v.to_str\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.getpwuid(uid = Process.uid)\n" ++
    "    uid = __id_arg(uid)\n" ++
    "    __pw_all(\"uid\", uid).find \{ |p| p.uid == uid } or raise ArgumentError, \"can't find user for #\{uid}\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.getpwnam(name)\n" ++
    "    name = __name_arg(name)\n" ++
    "    __pw_all(\"name\", name).find \{ |p| p.name == name } or raise ArgumentError, \"can't find user for #\{name}\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.getgrgid(gid = Process.gid)\n" ++
    "    gid = __id_arg(gid)\n" ++
    "    __gr_all(\"gid\", gid).find \{ |g| g.gid == gid } or raise ArgumentError, \"can't find group for #\{gid}\"\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.getgrnam(name)\n" ++
    "    name = __name_arg(name)\n" ++
    "    __gr_all(\"name\", name).find \{ |g| g.name == name } or raise ArgumentError, \"can't find group for #\{name}\"\n" ++
    "  end\n" ++
    "\n" ++
    "  # getpwent(3) / getgrent(3): a cursor over the whole database, read once\n" ++
    "  # per pass; set*ent rewinds it and end*ent closes it.\n" ++
    "  def self.setpwent; @__pw = nil; nil; end\n" ++
    "  def self.endpwent; @__pw = nil; nil; end\n" ++
    "  def self.getpwent\n" ++
    "    @__pw ||= [__pw_all, 0]\n" ++
    "    list, i = @__pw\n" ++
    "    @__pw[1] = i + 1\n" ++
    "    list[i]\n" ++
    "  end\n" ++
    "  def self.setgrent; @__gr = nil; nil; end\n" ++
    "  def self.endgrent; @__gr = nil; nil; end\n" ++
    "  def self.getgrent\n" ++
    "    @__gr ||= [__gr_all, 0]\n" ++
    "    list, i = @__gr\n" ++
    "    @__gr[1] = i + 1\n" ++
    "    list[i]\n" ++
    "  end\n" ++
    "\n" ++
    "  # With a block, every entry; without one, the next entry. A second walk\n" ++
    "  # started inside the first is ruby's RuntimeError, since both would share\n" ++
    "  # the one libc cursor.\n" ++
    "  def self.passwd\n" ++
    "    return getpwent unless block_given?\n" ++
    "    raise RuntimeError, \"parallel passwd iteration\" if @__pw_walk\n" ++
    "    begin\n" ++
    "      @__pw_walk = true\n" ++
    "      __pw_all.each \{ |p| yield p }\n" ++
    "    ensure\n" ++
    "      @__pw_walk = false\n" ++
    "      endpwent\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.group\n" ++
    "    return getgrent unless block_given?\n" ++
    "    raise RuntimeError, \"parallel group iteration\" if @__gr_walk\n" ++
    "    begin\n" ++
    "      @__gr_walk = true\n" ++
    "      __gr_all.each \{ |g| yield g }\n" ++
    "    ensure\n" ++
    "      @__gr_walk = false\n" ++
    "      endgrent\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  class Passwd\n" ++
    "    def self.each(&b)\n" ++
    "      return enum_for(:each) unless b\n" ++
    "      Etc.passwd(&b)\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "  class Group\n" ++
    "    def self.each(&b)\n" ++
    "      return enum_for(:each) unless b\n" ++
    "      Etc.group(&b)\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # uname(2), as uname(1) prints its five fields.\n" ++
    "  def self.uname\n" ++
    "    f = `uname -s; uname -n; uname -r; uname -v; uname -m`.split(\"\\n\")\n" ++
    "    \{ sysname: f[0], nodename: f[1], release: f[2], version: f[3], machine: f[4] }\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ The selector numbers are darwin's, as Process's are. sysconf(3) and\n" ++
    "  #   confstr(3) are answered by getconf(1), asked by NAME, which is the part\n" ++
    "  #   that does not change between platforms; a name getconf does not know\n" ++
    "  #   (and a variable it calls \"undefined\") is nil, which is what sysconf\n" ++
    "  #   answers for a limit it has no value for.\n" ++
    "  SC_NAMES = \"2_CHAR_TERM=20 2_C_BIND=18 2_C_DEV=19 2_FORT_DEV=21 2_FORT_RUN=22 2_LOCALEDEF=23 \" \\\n" ++
    "    \"2_PBS=59 2_PBS_ACCOUNTING=60 2_PBS_CHECKPOINT=61 2_PBS_LOCATE=62 2_PBS_MESSAGE=63 2_PBS_TRACK=64 \" \\\n" ++
    "    \"2_SW_DEV=24 2_UPE=25 2_VERSION=17 ADVISORY_INFO=65 AIO_LISTIO_MAX=42 AIO_MAX=43 AIO_PRIO_DELTA_MAX=44 \" \\\n" ++
    "    \"ARG_MAX=1 ASYNCHRONOUS_IO=28 ATEXIT_MAX=107 BARRIERS=66 BC_BASE_MAX=9 BC_DIM_MAX=10 BC_SCALE_MAX=11 \" \\\n" ++
    "    \"BC_STRING_MAX=12 CHILD_MAX=2 CLK_TCK=3 CLOCK_SELECTION=67 COLL_WEIGHTS_MAX=13 CPUTIME=68 \" \\\n" ++
    "    \"DELAYTIMER_MAX=45 EXPR_NEST_MAX=14 FSYNC=38 GETGR_R_SIZE_MAX=70 GETPW_R_SIZE_MAX=71 HOST_NAME_MAX=72 \" \\\n" ++
    "    \"IOV_MAX=56 IPV6=118 JOB_CONTROL=6 LINE_MAX=15 LOGIN_NAME_MAX=73 MAPPED_FILES=47 MEMLOCK=30 \" \\\n" ++
    "    \"MEMLOCK_RANGE=31 MEMORY_PROTECTION=32 MESSAGE_PASSING=33 MONOTONIC_CLOCK=74 MQ_OPEN_MAX=46 \" \\\n" ++
    "    \"MQ_PRIO_MAX=75 NGROUPS_MAX=4 NPROCESSORS_CONF=57 NPROCESSORS_ONLN=58 OPEN_MAX=5 PAGESIZE=29 \" \\\n" ++
    "    \"PAGE_SIZE=29 PHYS_PAGES=200 PRIORITIZED_IO=34 PRIORITY_SCHEDULING=35 RAW_SOCKETS=119 \" \\\n" ++
    "    \"READER_WRITER_LOCKS=76 REALTIME_SIGNALS=36 REGEXP=77 RE_DUP_MAX=16 RTSIG_MAX=48 SAVED_IDS=7 \" \\\n" ++
    "    \"SEMAPHORES=37 SEM_NSEMS_MAX=49 SEM_VALUE_MAX=50 SHARED_MEMORY_OBJECTS=39 SHELL=78 SIGQUEUE_MAX=51 \" \\\n" ++
    "    \"SPAWN=79 SPIN_LOCKS=80 SPORADIC_SERVER=81 SS_REPL_MAX=126 STREAM_MAX=26 SYMLOOP_MAX=120 \" \\\n" ++
    "    \"SYNCHRONIZED_IO=40 THREADS=96 THREAD_ATTR_STACKADDR=82 THREAD_ATTR_STACKSIZE=83 THREAD_CPUTIME=84 \" \\\n" ++
    "    \"THREAD_DESTRUCTOR_ITERATIONS=85 THREAD_KEYS_MAX=86 THREAD_PRIORITY_SCHEDULING=89 \" \\\n" ++
    "    \"THREAD_PRIO_INHERIT=87 THREAD_PRIO_PROTECT=88 THREAD_PROCESS_SHARED=90 THREAD_SAFE_FUNCTIONS=91 \" \\\n" ++
    "    \"THREAD_SPORADIC_SERVER=92 THREAD_STACK_MIN=93 THREAD_THREADS_MAX=94 TIMEOUTS=95 TIMERS=41 \" \\\n" ++
    "    \"TIMER_MAX=52 TRACE=97 TRACE_EVENT_FILTER=98 TRACE_EVENT_NAME_MAX=127 TRACE_INHERIT=99 TRACE_LOG=100 \" \\\n" ++
    "    \"TRACE_NAME_MAX=128 TRACE_SYS_MAX=129 TRACE_USER_EVENT_MAX=130 TTY_NAME_MAX=101 \" \\\n" ++
    "    \"TYPED_MEMORY_OBJECTS=102 TZNAME_MAX=27 V6_ILP32_OFF32=103 V6_ILP32_OFFBIG=104 V6_LP64_OFF64=105 \" \\\n" ++
    "    \"V6_LPBIG_OFFBIG=106 VERSION=8 XOPEN_CRYPT=108 XOPEN_ENH_I18N=109 XOPEN_REALTIME=111 \" \\\n" ++
    "    \"XOPEN_REALTIME_THREADS=112 XOPEN_SHM=113 XOPEN_STREAMS=114 XOPEN_UNIX=115 XOPEN_VERSION=116\"\n" ++
    "  CS_NAMES = \"PATH=1 POSIX_V6_ILP32_OFF32_CFLAGS=2 POSIX_V6_ILP32_OFF32_LDFLAGS=3 POSIX_V6_ILP32_OFF32_LIBS=4 \" \\\n" ++
    "    \"POSIX_V6_ILP32_OFFBIG_CFLAGS=5 POSIX_V6_ILP32_OFFBIG_LDFLAGS=6 POSIX_V6_ILP32_OFFBIG_LIBS=7 \" \\\n" ++
    "    \"POSIX_V6_LP64_OFF64_CFLAGS=8 POSIX_V6_LP64_OFF64_LDFLAGS=9 POSIX_V6_LP64_OFF64_LIBS=10 \" \\\n" ++
    "    \"POSIX_V6_LPBIG_OFFBIG_CFLAGS=11 POSIX_V6_LPBIG_OFFBIG_LDFLAGS=12 POSIX_V6_LPBIG_OFFBIG_LIBS=13 \" \\\n" ++
    "    \"POSIX_V6_WIDTH_RESTRICTED_ENVS=14\"\n" ++
    "  @__sc = \{}\n" ++
    "  SC_NAMES.split.each do |kv|\n" ++
    "    k, v = kv.split(\"=\")\n" ++
    "    const_set(\"SC_#\{k}\", v.to_i)\n" ++
    "    @__sc[v.to_i] ||= k\n" ++
    "  end\n" ++
    "  @__cs = \{}\n" ++
    "  CS_NAMES.split.each do |kv|\n" ++
    "    k, v = kv.split(\"=\")\n" ++
    "    const_set(\"CS_#\{k}\", v.to_i)\n" ++
    "    @__cs[v.to_i] ||= k\n" ++
    "  end\n" ++
    "  send(:remove_const, :SC_NAMES)\n" ++
    "  send(:remove_const, :CS_NAMES)\n" ++
    "\n" ++
    "  def self.__getconf(names)\n" ++
    "    names.each do |n|\n" ++
    "      out = `getconf #\{n} 2>/dev/null`\n" ++
    "      return out.chomp if $?.success?\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.sysconf(n)\n" ++
    "    k = @__sc[__id_arg(n)] or raise Errno::EINVAL, \"sysconf\"\n" ++
    "    alt = case k\n" ++
    "          when /\\A2_/ then [\"POSIX#\{k}\", \"_POSIX#\{k}\"]\n" ++
    "          when \"VERSION\" then [\"_POSIX_VERSION\"]\n" ++
    "          when /\\AXOPEN_/ then [\"_#\{k}\"]\n" ++
    "          else [k, \"_POSIX_#\{k}\", \"_#\{k}\"]\n" ++
    "          end\n" ++
    "    v = __getconf(alt)\n" ++
    "    v =~ /\\A-?\\d+\\z/ ? v.to_i : nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def self.confstr(n)\n" ++
    "    k = @__cs[__id_arg(n)] or raise Errno::EINVAL, \"confstr\"\n" ++
    "    v = __getconf([k, \"_CS_#\{k}\"])\n" ++
    "    v.nil? || v.empty? ? nil : v\n" ++
    "  end\n" ++
    "end\n"
  else ""
and glob_brace_open = fn (p: str) -> fn (i: int) ->
  if i >= str_len p then 0 - 1
  else if str_eq (char_at p i) "\\" then glob_brace_open p (i + 2)
  else if str_eq (char_at p i) "\{" then i
  else glob_brace_open p (i + 1)
and glob_brace_close = fn (p: str) -> fn (i: int) -> fn (d: int) ->
  if i >= str_len p then 0 - 1
  else
    let c = char_at p i in
    if str_eq c "\\" then glob_brace_close p (i + 2) d
    else if str_eq c "\{" then glob_brace_close p (i + 1) (d + 1)
    else if str_eq c "}" then (if d == 1 then i else glob_brace_close p (i + 1) (d - 1))
    else glob_brace_close p (i + 1) d
and glob_brace_split = fn (b: str) -> fn (i: int) -> fn (st: int) -> fn (d: int) ->
  if i >= str_len b then Cons (substring b st i, Nil)
  else
    let c = char_at b i in
    // an escaped character is never a separator: "a\,b" is one alternative
    if str_eq c "\\" then glob_brace_split b (i + 2) st d
    else if str_eq c "\{" then glob_brace_split b (i + 1) st (d + 1)
    else if str_eq c "}" then glob_brace_split b (i + 1) st (d - 1)
    else if str_eq c "," && d == 0 then Cons (substring b st i, glob_brace_split b (i + 1) (i + 1) 0)
    else glob_brace_split b (i + 1) st d
and sappend = fn (a: str list) -> fn (b: str list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, sappend t b)
and glob_last_slash = fn (p: str) -> fn (i: int) -> fn (lim: int) -> fn (best: int) ->
  if i >= lim then best
  else glob_last_slash p (i + 1) lim (if str_eq (char_at p i) "/" then i else best)
and glob_slashes = fn (p: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len p then n else glob_slashes p (i + 1) (if str_eq (char_at p i) "/" then n + 1 else n)
and glob_find = fn (root: str) -> fn (depth: int) ->
  let tmpf = "/tmp/.mrb_glob_" ++ str_of_int (random_int 100000000) in
  let dflag = (if depth > 0 then " -maxdepth " ++ str_of_int depth else "") in
  let _ = run ("cd " ++ shq root ++ " 2> /dev/null && find ." ++ dflag ++ " -print > " ++ shq tmpf ++ " 2> /dev/null") in
  let content = (if file_exists tmpf then read_file tmpf else "") in
  let _ = run ("rm -f " ++ shq tmpf) in
  content
and glob_lines = fn (content: str) -> fn (i: int) ->
  if i >= str_len content then (Nil : str list)
  else
    let e = line_end_from content i in
    let stop = (if e > i && str_eq (char_at content (e - 1)) "\n" then e - 1 else e) in
    let ln = substring content i stop in
    // find prints the root itself as "." and everything else as "./x/y".
    // "." stays a candidate: Ruby's FNM_DOTMATCH globs list it, and without
    // that flag the dot rule filters it out anyway.
    let rel = (if str_len ln > 2 && str_eq (substring ln 0 2) "./" then substring ln 2 (str_len ln)
               else if str_eq ln "." then "." else "") in
    if str_eq rel "" then glob_lines content e else Cons (rel, glob_lines content e)
and glob_drop_opts = fn (args: Val list) ->
  match args with
  | Nil -> (Nil : Val list)
  | Cons (VHsh _, Nil) -> Nil
  | Cons (a, t) -> Cons (a, glob_drop_opts t)
and glob_pat_args = fn (args: Val list) ->
  match args with
  | Nil -> (Nil : str list)
  | Cons (VStr h, t) -> Cons (sget h, glob_pat_args t)
  | Cons (VArr id, t) -> sappend (glob_pat_args (deref id)) (glob_pat_args t)
  | Cons (_, t) -> glob_pat_args t
and glob_drop_dot = fn (xs: str list) ->
  match xs with
  | Nil -> (Nil : str list)
  | Cons (h, t) -> if str_eq h "." then glob_drop_dot t else Cons (h, glob_drop_dot t)
and glob_strs = fn (xs: str list) ->
  match xs with Nil -> (Nil : Val list) | Cons (h, t) -> Cons (mkstr h, glob_strs t)
and in_thread = fn (u: unit) ->
  if map_has thread_flag "n" then (match map_get thread_flag "n" with VBool b -> b | _ -> false) else false
and cpx_realize_args = fn world -> fn (args: Val list) ->
  match args with
  | Nil -> (Nil : Val list)
  | Cons (VCpx (r, i), rest) ->
    (if rb_eq i (VInt 0) then Cons (r, cpx_realize_args world rest)
     else Cons (raise_exc world "TypeError" "not a real", rest))
  | Cons (v, rest) -> Cons (v, cpx_realize_args world rest)
// An open(2) flag word as the equivalent string mode. O_RDONLY/WRONLY/RDWR are
// the low two bits, O_APPEND is 8, O_TRUNC is 1024 (the BSD values, which are
// what File::Constants carries here).
// ⚠ ONE CASE IS AN APPROXIMATION and is named rather than hidden: O_WRONLY
//   WITHOUT O_TRUNC opens for writing at position 0 and keeps what is already
//   in the file, and mere-ruby's File has no string mode that means that --
//   "w" is the nearest and it truncates. Every mode ruby's own `mode` string
//   can express round-trips exactly.
and int_mode_str = fn (n9: int) ->
  let acc = n9 - (n9 / 4) * 4 in
  let app = (n9 / 8) - (n9 / 16) * 2 == 1 in
  let trunc = (n9 / 1024) - (n9 / 2048) * 2 == 1 in
  if acc == 0 then "r"
  else if acc == 2 then (if trunc then "w+" else if app then "a+" else "r+")
  else if app then "a" else "w"

and file_open_obj = fn world -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let path = (match args with Cons (VStr h, _) -> sget h | _ -> "") in
  // ⚠ AN INTEGER MODE WAS READ AS "r". File.new(p, File::WRONLY | File::CREAT)
  //   fell through this match to the default, so the handle was opened for
  //   reading, the file was never created, and a later #write buffered into
  //   something close could not flush. The constants were defined and
  //   deliberately not honoured ("mere-ruby's File does not honour them" --
  //   see m_driver); with the read/write direction now enforced, not honouring
  //   them would turn a silent wrong mode into a refusal, so they are honoured.
  let mode = (match args with
              | Cons (_, Cons (VStr h, _)) -> sget h
              | Cons (_, Cons (VInt n9, _)) -> int_mode_str n9
              | _ -> "r") in
  // a nil path is a conversion refusal, not a missing file named ""
  if (match args with Cons (VNil, _) -> true | _ -> false) then
    raise_exc world "TypeError" "no implicit conversion of nil into String"
  // ⚠ A FIFO's open(2) waits for the other end, and the other end would be
  //   another thread -- which here is this same OS thread, so the open (or
  //   the first read) never returns and the whole process hangs: ruby/spec's
  //   core/file/open "on a FIFO" did exactly that for 600 seconds. Refused by
  //   name instead, for the FIFOs this process made (fifo_paths); one made
  //   elsewhere is not recognised, because telling a FIFO from a file needs
  //   stat(2), which is a subprocess here for every open.
  else if map_has fifo_paths (abs_path_of path) && file_exists path then
    raise_exc world "NotImplementedError"
      ("opening a FIFO would wait for its other end, and every thread here is one OS thread - " ++ path)
  else if (str_contains mode "r" && (if str_contains mode "+" then false else true))
     && (if file_exists path then false else true) then
    raise_exc world "Errno::ENOENT" ("No such file or directory @ rb_sysopen - " ++ path)
  else
    // w truncates at open, so an unwritten-then-closed file ends up empty; a
    // creates the file when it is absent. Either way the open is the moment ruby
    // reports a path it cannot write -- a missing directory above all, which is
    // what `File.open(dir/x, "wb")` hit here and reported as an interpreter
    // placeholder, since a failed primitive write has no ruby exception of its
    // own. The check is the write's own result, not `test -d`: that costs a
    // subprocess per open, and `run` is a constant 127 in the Wasm build, which
    // would make every write in the playground raise.
    let creating = str_contains mode "w"
                   || (str_contains mode "a" && (if file_exists path then false else true)) in
    // BEFORE the write, not after: the primitive write to a path whose directory
    // is missing fails at the Mere level, which is a failure with no ruby
    // exception in it -- the top reported StandardError with no message at all.
    // file_exists answers true for a directory, so the parent is the whole test,
    // and it costs no subprocess (`run` is a constant 127 in the Wasm build).
    if creating && (if file_exists (dirname_of path) then false else true) then
      raise_exc world "Errno::ENOENT" ("No such file or directory @ rb_sysopen - " ++ path)
    // ⚠ A DEVICE IS OPENED AT THE OPEN, because opening one is where it can
    //   refuse: /dev/tty with no controlling terminal exists and cannot be
    //   opened, and the lazy descriptor (file_fd_of) let File.open succeed and
    //   #tty? answer false. The family reports no errno, and ENXIO ("no such
    //   device") is the one open(2) gives for a device that is there and not
    //   configured -- which is the only way a /dev path that exists fails here
    //   short of permissions, and the reference measured for /dev/tty.
    else if str_len path > 5 && str_eq (substring path 0 5) "/dev/" && file_exists path
            && (let fd0 = fd_open path (if str_contains mode "+" || str_contains mode "w" || str_contains mode "a" then "r+" else "r") 438 in
                if fd0 < 0 then true else (let _ = fd_close fd0 in false)) then
      raise_exc world "Errno::ENXIO" ("Device not configured @ rb_sysopen - " ++ path)
    else
    let _ = (if creating then write_file path "" else ()) in
    let id = alloc_oid ocls in
    let _ = map_set ocls id "File" in
    // ⚠ ...with the ARGUMENT's encoding. mkstr makes a UTF-8 string, so
    //   `File.open(p).path` answered UTF-8 for a path that was not -- the same
    //   slip Dir#to_path had, and #path/#to_path read this ivar.
    let pv9 = mkstr path in
    let _ = (match args with
             | Cons (VStr h9, _) -> (match pv9 with VStr n9 -> senc_set n9 (senc_get h9) | _ -> ())
             | _ -> ()) in
    let _ = map_set ivars (str_of_int id ++ "@__f_path") pv9 in
    let _ = map_set ivars (str_of_int id ++ "@__f_mode") (mkstr mode) in
    let _ = map_set ivars (str_of_int id ++ "@__f_buf") (mkstr "") in
    let _ = map_set ivars (str_of_int id ++ "@__f_pos") (VInt 0) in
    // where the write buffer's first byte belongs; see file_flush_obj
    let _ = map_set ivars (str_of_int id ++ "@__f_wpos") (VInt 0) in
    // the default encodings AS THEY ARE NOW: a stream that names none keeps
    // the ones it was opened under (the prelude's #external_encoding reads
    // these), whatever Encoding.default_* say later
    let _ = map_set ivars (str_of_int id ++ "@__f_dext")
              (if map_has def_ext_enc "v" then map_get def_ext_enc "v"
               else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else VNil) in
    let _ = map_set ivars (str_of_int id ++ "@__f_dint")
              (if map_has def_int_enc "v" then map_get def_int_enc "v" else VNil) in
    VObj id
and file_flush_obj = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  let k = str_of_int id in
  let path = (match (if map_has ivars (k ++ "@__f_path") then map_get ivars (k ++ "@__f_path") else VNil) with VStr h -> sget h | _ -> "") in
  let mode = (match (if map_has ivars (k ++ "@__f_mode") then map_get ivars (k ++ "@__f_mode") else VNil) with VStr h -> sget h | _ -> "") in
  let buf = (match (if map_has ivars (k ++ "@__f_buf") then map_get ivars (k ++ "@__f_buf") else VNil) with VStr h -> sget h | _ -> "") in
  // ⚠ THE BUFFER GOES WHERE THE PROGRAM WAS, not on the end. Appending was
  //   right for as long as nothing here could seek and write in the same
  //   session: a "w" starts empty and its position only ever moves forward,
  //   so "splice at the position" and "append" are the same sentence. They
  //   part the moment a program seeks back, truncates, or opens "r+" --
  //   File#truncate's own spec writes ten bytes, truncates to three and
  //   writes again, and ruby leaves the WRITE POINTER at ten, so the gap
  //   between three and ten is NUL-filled and "abc" lands at the end.
  //   Appending made that "123abc". @__f_wpos is where the first byte of the
  //   buffer belongs; the write arm sets it when the buffer leaves empty.
  //
  //   "a" is the exception and stays an append: O_APPEND writes at the end of
  //   the file whatever the position says, and a program that seeks in an
  //   append-mode handle still writes at the end.
  let wpos = (match (if map_has ivars (k ++ "@__f_wpos") then map_get ivars (k ++ "@__f_wpos") else VNil) with
              | VInt n -> n | _ -> 0) in
  let _ =
    (if str_eq buf "" then ()
     else if str_contains mode "a" then
       (let _ = write_file path ((if file_exists path then read_file path else "") ++ buf) in ())
     else if str_contains mode "w" || str_contains mode "+" then
       (let old9 = (if file_exists path then read_file path else "") in
        let head9 = (if str_len old9 >= wpos then substring old9 0 wpos
                     else old9 ++ str_repeat (chr 0) (wpos - str_len old9)) in
        let after9 = wpos + str_len buf in
        let tail9 = (if str_len old9 > after9 then substring old9 after9 (str_len old9) else "") in
        let _ = write_file path (head9 ++ buf ++ tail9) in ())
     else ()) in
  let _ = map_set ivars (k ++ "@__f_wpos") (VInt (wpos + str_len buf)) in
  map_set ivars (k ++ "@__f_buf") (mkstr "")
// The File's REAL DESCRIPTOR, opened the first time something asks for one.
//
// ⚠ LAZILY, and that is the whole design. Until now a File here was a path
//   and a buffer with no descriptor at all, so `fileno` raised
//   NotImplementedError and `IO.new(f.fileno)` had nothing to attach to --
//   which is what five core/io files and eleven IO names are waiting on.
//   Opening one EAGERLY in file_open_obj works and costs a descriptor per
//   File: measured 2026-09-23, six hundred opens with no close reached fd 602,
//   because nothing here closes a File the program forgot about. ruby survives
//   that because its GC finalizes them; this interpreter has no finalizer to
//   hang a close on. A sweep opens thousands of files and asks for a
//   descriptor on almost none of them, so the ones that never ask never pay.
//
//   It is not READ or WRITTEN through yet -- two representations of one file
//   would desync the moment a program wrote through the descriptor, and
//   KNOWN_GAPS names that as the open arc. It is there to BE a descriptor: a
//   number dup(2) accepts, IO.new attaches to, and the kernel refuses the same
//   way after a close.
and file_fd_of = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  let k = str_of_int id in
  if map_has ivars (k ++ "@__f_fd") then
    (match map_get ivars (k ++ "@__f_fd") with VInt fd9 -> fd9 | _ -> 0 - 1)
  else
    (let path = (match (if map_has ivars (k ++ "@__f_path") then map_get ivars (k ++ "@__f_path") else VNil) with
                 | VStr h -> sget h | _ -> "") in
     let mode = (match (if map_has ivars (k ++ "@__f_mode") then map_get ivars (k ++ "@__f_mode") else VNil) with
                 | VStr h -> sget h | _ -> "") in
     // the descriptor is opened with the same access the File was, but never
     // with a truncating "w": the File's own write path owns the content, and
     // a second O_TRUNC here would empty a file this call only meant to name.
     let fdm9 = (if str_contains mode "a" then "a" else if str_contains mode "+" then "r+"
                 else if str_contains mode "w" then "r+" else "r") in
     let fd9 = fd_open path fdm9 438 in
     let _ = map_set ivars (k ++ "@__f_fd") (VInt fd9) in
     // what the descriptor was opened with, which IO.new checks a mode against
     let _ = (if fd9 >= 0 then
                (let _ = fd_forget fd9 in
                 map_set fd_acc fd9 (if str_eq fdm9 "r" then 0 else if str_eq fdm9 "a" then 17 else 2))
              else ()) in
     fd9)

and file_close_obj = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  let k = str_of_int id in
  // one path for getting bytes out, so a close after a flush cannot undo it
  let _ = file_flush_obj world id in
  // ...and the descriptor goes with it. A File that is opened and never closed
  // would otherwise hold one until the process ends, and the spec suite opens
  // thousands.
  // (#autoclose = false leaves it open: the program took it over)
  let keep9 = map_has ivars (k ++ "@__f_keep_fd") && truthy (map_get ivars (k ++ "@__f_keep_fd")) in
  let _ = (match (if map_has ivars (k ++ "@__f_fd") then map_get ivars (k ++ "@__f_fd") else VNil) with
           | VInt fd9 -> (if fd9 >= 0 && (if keep9 then false else true) then (let _ = fd_close fd9 in fd_forget fd9) else ())
           | _ -> ()) in
  let _ = map_delete ivars (k ++ "@__f_fd") in
  // the mode it had, which #reopen onto a path uses again (the prelude's)
  let _ = (match (if map_has ivars (k ++ "@__f_mode") then map_get ivars (k ++ "@__f_mode") else VNil) with
           | VStr h9 -> (if str_eq (sget h9) "" then () else map_set ivars (k ++ "@__f_lastmode") (VStr h9))
           | _ -> ()) in
  map_set ivars (k ++ "@__f_mode") (mkstr "")
and rb_gets = fn (u: unit) ->
  let _ = stdin_line () in
  let s = stdin_buf () in
  let pos = (if map_has stdin_src_pos "p" then map_get stdin_src_pos "p" else 0) in
  if pos >= str_len s then (let _ = map_set globals "_" VNil in VNil)
  else
    let e = line_end_from s pos in
    let _ = map_set stdin_src_pos "p" e in
    // ...and Kernel#gets sets $_ as well, which is what `while gets` and the
    // `-n` idiom read.
    let line9 = mkstr (substring s pos e) in
    let _ = map_set globals "_" line9 in
    let _ = map_set globals "." (VInt ((match (if map_has globals "." then map_get globals "." else VInt 0) with VInt n -> n | _ -> 0) + 1)) in
    line9
and rb_readlines = fn (u: unit) ->
  match rb_gets () with
  | VNil -> Nil
  | v -> Cons (v, rb_readlines ())
and argf_input = fn (u: unit) ->
  let av = (if map_has cli_argv "v" then map_get cli_argv "v" else arr_new Nil) in
  match av with
  | VArr id -> (match deref id with Nil -> argf_stdin_rest () | paths -> argf_concat paths "")
  | _ -> argf_stdin_rest ()
// the rest of standard input from the shared cursor, which it then passes
and argf_stdin_rest = fn (u: unit) ->
  let s9 = stdin_whole () in
  let p9 = stdin_cur () in
  let _ = map_set stdin_src_pos "p" (str_len s9) in
  if p9 >= str_len s9 then "" else substring s9 p9 (str_len s9)
and argf_concat = fn (paths: Val list) -> fn (acc: str) ->
  match paths with
  | Nil -> acc
  | Cons (p, t) ->
    let s = (match p with VStr h -> try_or (fn (u: unit) -> read_file (sget h)) "" | _ -> "") in
    argf_concat t (acc ++ s)
// a hex digit's value, 0 for anything else
and hex_val = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87
  else if o >= 65 && o <= 70 then o - 55
  else 0
and rev_vals = fn (xs: Val list) -> rev_vals_go xs Nil
and rev_vals_go = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_vals_go t (Cons (h, acc))

// n copies of a one-character string, for padding.
and str_repeat = fn (c: str) -> fn (n: int) ->
  if n <= 0 then "" else c ++ str_repeat c (n - 1)
and line_end_from = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i + 1
  else line_end_from s (i + 1)
and io_join_go = fn (args: Val list) -> fn (acc: str) ->
  match args with
  | Nil -> acc
  | Cons (VStr h, t) -> io_join_go t (acc ++ sget h)
  | Cons (h, t) -> io_join_go t (acc ++ to_s h)
and mk_lazy = fn world -> fn (src: Val) -> fn (ops: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  let _ = map_set ocls id "Enumerator::Lazy" in
  let _ = map_set ivars (str_of_int id ++ "@__lz_src") src in
  let _ = map_set ivars (str_of_int id ++ "@__lz_ops") (arr_new ops) in
  VObj id
and lz_src = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  (if map_has ivars (str_of_int id ++ "@__lz_src") then map_get ivars (str_of_int id ++ "@__lz_src") else VNil)
and lz_ops = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  (match (if map_has ivars (str_of_int id ++ "@__lz_ops") then map_get ivars (str_of_int id ++ "@__lz_ops") else VNil) with
   | VArr aid -> deref aid
   | _ -> Nil)
and lz_extend = fn world -> fn (id: int) -> fn (kind: str) -> fn (payload: Val) ->
  let (m9, s9, o9, iv9) = world in
  let nxt = mk_lazy world (lz_src world id) (list_append (lz_ops world id) (Cons (arr_new (Cons (VStr (mkstr_h kind), Cons (payload, Nil))), Nil))) in
  // ⚠ THE EXPLICIT SIZE HAS TO TRAVEL. `Enumerator::Lazy.new(obj, 100)` puts
  //   it in @__lz_size because the source cannot be asked -- an Object does not
  //   answer #size -- and every step built a FRESH lazy without it, so the size
  //   machinery (which handles map/take/drop/zip correctly) started from nil
  //   one link in. `l.size` was 100 and `l.map {}.size` was nil.
  let _ = (if map_has iv9 (str_of_int id ++ "@__lz_size")
           then (match nxt with
                 | VObj nid -> map_set iv9 (str_of_int nid ++ "@__lz_size") (map_get iv9 (str_of_int id ++ "@__lz_size"))
                 | _ -> ())
           else ()) in
  nxt
and mkstr_h = fn (s2: str) -> (match mkstr s2 with VStr h -> h | _ -> 0)
and mk_chain = fn world -> fn (srcs: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  let _ = map_set ocls id "Enumerator::Chain" in
  let _ = map_set ivars (str_of_int id ++ "@__ch") (arr_new srcs) in
  VObj id
and chain_srcs = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  (match (if map_has ivars (str_of_int id ++ "@__ch") then map_get ivars (str_of_int id ++ "@__ch") else VNil) with
   | VArr aid -> deref aid
   | _ -> Nil)
and arr_count_truthy = fn (xs: Val list) -> fn (acc: int) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> arr_count_truthy t (if truthy h then acc + 1 else acc)
and pair_firsts = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> Cons ((match h with VArr aid -> (match deref aid with Cons (a, _) -> a | _ -> h) | _ -> h), pair_firsts t)
and wi_index_block = fn newblk -> fn (off: int) ->
  let bpid = (handle_base + map_len proc_store) in
  let _ = store_proc (str_of_int bpid) newblk in
  let cenv = map_new () in
  let _ = map_set cenv "__wi_blk" (VProc bpid) in
  let _ = map_set cenv "__wi_c" (arr_new (Cons (VInt off, Nil))) in
  let idx = EMethod (EVar "__wi_c", "[]", Cons (EInt 0, Nil)) in
  // a multi-value yield arrives as the whole list, a single one as itself --
  // the same shape the materialising collector uses.
  let elem = ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                    EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                    EVar "__e") in
  // [broke?, value]: a break inside the caller's block has to end the WALK, so
  // the wrapper re-issues it as its own break rather than answering the value.
  let rv = EVar "__wi_r" in
  let got = EMethod (rv, "[]", Cons (EInt 1, Nil)) in
  let body = Cons (SAssign ("__wi_r", EMethod (EVar "__wi_blk", "__wi_call", Cons (elem, Cons (idx, Nil)))),
              Cons (SExpr (EMethod (EVar "__wi_c", "[]=", Cons (EInt 0, Cons (EBin ("+", idx, EInt 1), Nil)))),
              Cons (SIf (Cons ((EMethod (rv, "[]", Cons (EInt 0, Nil)), Cons (SBreak got, Nil)), Nil), Nil),
              Cons (SExpr got, Nil)))) in
  (true, Cons ("*__e", Nil), body, cenv)
and wi_answers_elems = fn (src: str) ->
  str_eq src "select" || str_eq src "filter" || str_eq src "find_all" ||
  str_eq src "reject" || str_eq src "take_while" || str_eq src "drop_while" ||
  str_eq src "sort_by" || str_eq src "minmax_by" || str_eq src "each_entry"
and wi_answers_one_elem = fn (src: str) ->
  str_eq src "find" || str_eq src "detect" || str_eq src "min_by" || str_eq src "max_by"
and wi_unwrap_each = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VArr aid, t) -> Cons (arr_new (pair_firsts (deref aid)), wi_unwrap_each t)
  | Cons (h, t) -> Cons (h, wi_unwrap_each t)
and wi_unwrap_vals = fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (VArr aid, t)) -> Cons (k, Cons (arr_new (pair_firsts (deref aid)), wi_unwrap_vals t))
  | Cons (k, Cons (v, t)) -> Cons (k, Cons (v, wi_unwrap_vals t))
  | _ -> xs
and with_index_pairs_off = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> Cons (arr_new (Cons (h, Cons (VInt i, Nil))), with_index_pairs_off t (i + 1))
and enum_args_str = fn (xs: Val list) ->
  match xs with
  | Nil -> ""
  | Cons (v, Nil) -> inspect v
  | Cons (v, rest) -> inspect v ++ ", " ++ enum_args_str rest
and is_enum_cls = fn (cls: str) ->
  str_eq cls "Enumerator" || str_eq cls "Enumerator::ArithmeticSequence"
and make_aseq = fn world -> fn (recv: Val) -> fn (eargs: Val list) -> fn (b: Val) -> fn (e: Val) -> fn (st: Val) -> fn (excl: bool) ->
  make_aseq_m world recv "step" eargs b e st excl
and make_aseq_m = fn world -> fn (recv: Val) -> fn (meth: str) -> fn (eargs: Val list) -> fn (b: Val) -> fn (e: Val) -> fn (st: Val) -> fn (excl: bool) ->
  let (meths, sup, ocls, ivars) = world in
  // The DRIVING method stays `step` -- @meth is what make_enum_a re-dispatches
  // when the sequence is walked, and `(1..10).%(2)` is not a walk. The name
  // written in the inspect is a separate question, so it gets a slot of its
  // own; using one field for both made `(r % 2).to_a` dispatch `%` again.
  (match make_enum_a world recv "step" eargs with
   | VObj id ->
     let _ = map_set ocls id "Enumerator::ArithmeticSequence" in
     let _ = (if str_eq meth "step" then () else map_set ivars (str_of_int id ++ "@__as_meth") (mkstr meth)) in
     let _ = map_set ivars (str_of_int id ++ "@__as_begin") b in
     let _ = map_set ivars (str_of_int id ++ "@__as_end") e in
     let _ = map_set ivars (str_of_int id ++ "@__as_step") st in
     let _ = map_set ivars (str_of_int id ++ "@__as_excl") (VBool excl) in
     VObj id
   | other -> other)
and aseq_size = fn (b: int) -> fn (e: int) -> fn (st: int) -> fn (excl: bool) ->
  if st == 0 then 0
  else
    let n = (if st > 0 then (if e < b then 0 else (e - b) / st + 1)
             else (if e > b then 0 else (b - e) / (0 - st) + 1)) in
    if excl && n > 0 && (e - b) - ((e - b) / st) * st == 0 then n - 1 else n
and aseq_is_num = fn (v: Val) ->
  match v with VInt _ -> true | VFlt _ -> true | VBig _ -> true | _ -> false
and aseq_to_flt = fn (v: Val) ->
  match v with
  | VInt n -> float_of_int n
  | VFlt f -> f
  | VBig b -> float_of_str b
  | _ -> 0.0
and aseq_size_flt = fn (bf: float) -> fn (ef: float) -> fn (sf: float) -> fn (excl: bool) ->
  let inf = 1.0 / 0.0 in
  let ninf = 0.0 - inf in
  let eps = 2.220446049250313e-16 in
  let fabs = fn (x: float) -> if x < 0.0 then 0.0 - x else x in
  // an infinite step takes the first term, or none if it points away
  if sf == inf then (if bf <= ef then VInt 1 else VInt 0)
  else if sf == ninf then (if bf >= ef then VInt 1 else VInt 0)
  else if sf == 0.0 then VFlt inf
  // an end at infinity never arrives in the step's own direction, and is
  // already behind the start in the other
  else if ef == inf then (if sf > 0.0 then VFlt inf else VInt 0)
  else if ef == ninf then (if sf < 0.0 then VFlt inf else VInt 0)
  else
    let n = (ef - bf) / sf in
    let err0 = (fabs bf + fabs ef + fabs (ef - bf)) / fabs sf * eps in
    let err = (if err0 > 0.5 then 0.5 else err0) in
    if excl then
      (if n <= 0.0 then VInt 0
       else if n < 1.0 then VInt 1
       else (let k = n - err in
             if k >= 9.0e18 then VFlt (k + 1.0)
             else
               // ruby's ruby_float_step_size: after flooring with the error
               // allowance, one more term still counts if it lands strictly
               // before the excluded end -- `(1.0...55.6).step(18.2)` has FOUR
               // terms, the last 55.599999999999994, and the floor alone said
               // three (bugs.ruby-lang.org/issues/16612).
               (let n0 = flt_floor k in
                let d = float_of_int (n0 + 1) * sf + bf in
                let n1 = (if (bf < ef && d < ef) || (bf > ef && d > ef) then n0 + 1 else n0) in
                VInt (n1 + 1))))
    else
      (if n < 0.0 then VInt 0
       else (let k = n + err in
             if k >= 9.0e18 then VFlt (k + 1.0) else VInt (flt_floor k + 1)))
and aseq_kw = fn (pairs: Val list) -> fn (k: str) ->
  (let (f, v) = hash_lookup pairs (VSym k) in if f then v else VNil)
and aseq_kw_str = fn (pairs: Val list) -> fn (acc: str) ->
  match pairs with
  | Cons (VSym k, Cons (v, rest)) -> aseq_kw_str rest (acc ++ (if str_eq acc "" then "" else ", ") ++ k ++ ": " ++ inspect v)
  | Cons (k, Cons (v, rest)) -> aseq_kw_str rest (acc ++ (if str_eq acc "" then "" else ", ") ++ inspect k ++ " => " ++ inspect v)
  | _ -> acc
and aseq_terms = fn (b: int) -> fn (st: int) -> fn (n: int) ->
  if n <= 0 then (Nil : Val list) else Cons (VInt b, aseq_terms (b + st) st (n - 1))
and aseq_hi = fn (v: Val) -> (match v with VInt n -> n | _ -> 0)
and aseq_pct = fn world -> fn (recv: Val) -> fn (args: Val list) ->
  match recv with
  | VRange (lo, hi, excl) ->
    (let st = (match args with Cons (VInt n, _) -> VInt n | _ -> VInt 1) in
     // a BEGINLESS range still makes a sequence -- `(..5) % 2` begins at nil
     // and slices an array from its front. Reading the begin as an Integer
     // refused it as "Integer can't be coerced into Integer" before it was
     // ever built. With NO end either there is nothing numeric to step over,
     // and ruby says so by name.
     let _ = (if (match lo with VNil -> true | _ -> false)
                 && (rng_hi_open hi || (if rng_is_int hi then false else true))
              then prim_raise "ArgumentError"
                     "#step for non-numeric beginless ranges is meaningless"
              else ()) in
     make_aseq_m world recv "%" args (match lo with VNil -> VNil | _ -> VInt (rng_int lo))
       (if rng_hi_open hi then VNil else VInt (rng_int hi)) st excl)
  | _ -> aseq_of world recv args
and aseq_of = fn world -> fn (recv: Val) -> fn (args: Val list) ->
  match recv with
  | VRange (lo, hi, excl) ->
    let st = (match args with Cons (VInt n, _) -> VInt n | Cons (VFlt f, _) -> VFlt f | _ -> VInt 1) in
    // a zero step is refused when the sequence is MADE, not when it is walked:
    // `(1..5).step(0)` is an ArgumentError with or without a block.
    let _ = (match st with
             | VInt 0 -> raise_exc world "ArgumentError" "step can't be 0"
             | VFlt f -> (if f == 0.0 then raise_exc world "ArgumentError" "step can't be 0" else VNil)
             | _ -> VNil) in
    // Float bounds (either side) make a Float sequence, exactly as
    // `1.0.step(2.0, 0.5)` does: make_aseq takes the values as they are.
    (match lo with
     | VFlt _ -> make_aseq world recv args lo (if rng_hi_open hi then VNil else hi) st excl
     | _ ->
       (match hi with
        | VFlt _ -> (if rng_hi_open hi then make_aseq world recv args (match lo with VNil -> VNil | _ -> VInt (rng_int lo)) VNil st excl
                     else make_aseq world recv args (match lo with VNil -> VNil | _ -> VInt (rng_int lo)) hi st excl)
        // (a beginless range keeps its nil begin: the sequence exists, and
        // walking it is what raises)
        | _ -> make_aseq world recv args (match lo with VNil -> VNil | _ -> VInt (rng_int lo)) (if rng_hi_open hi then VNil else VInt (rng_int hi)) st excl))
  | VInt _ -> aseq_of_num world recv args recv
  | VFlt _ -> aseq_of_num world recv args recv
  | _ -> VNil
and aseq_of_num = fn world -> fn (recv: Val) -> fn (args: Val list) -> fn (b: Val) ->
  match args with
  | Cons (VHsh hid, Nil) ->
    (let by9 = aseq_kw (hderef hid) "by" in
     let to9 = aseq_kw (hderef hid) "to" in
     make_aseq world recv args b to9 (match by9 with VNil -> VInt 1 | v -> v) false)
  | Cons (lim9, Cons (st9, _)) -> make_aseq world recv args b lim9 st9 false
  | Cons (lim9, Nil) -> make_aseq world recv args b lim9 (VInt 1) false
  | _ -> make_aseq world recv args b VNil (VInt 1) false
and aseq_inspect_str = fn env -> fn world -> fn (oid: int) ->
  let (meths, sup, ocls, ivars) = world in
  let key = str_of_int oid in
  let rv = (if map_has ivars (key ++ "@recv") then map_get ivars (key ++ "@recv") else VNil) in
  let ea = (match (if map_has ivars (key ++ "@eargs") then map_get ivars (key ++ "@eargs") else VNil) with VArr aid -> deref aid | _ -> Nil) in
  let rec join9 = fn (xs: Val list) -> fn (acc: str) ->
    (match xs with
     | Nil -> acc
     | Cons (VHsh hh, t) -> join9 t (acc ++ (if str_eq acc "" then "" else ", ") ++ aseq_kw_str (hderef hh) "")
     | Cons (x, t) -> join9 t (acc ++ (if str_eq acc "" then "" else ", ") ++ inspect x)) in
  let rs = (match rv with VRange _ -> "(" ++ inspect rv ++ ")" | _ -> inspect rv) in
  let mn = (match (if map_has ivars (key ++ "@__as_meth") then map_get ivars (key ++ "@__as_meth") else VNil) with
            | VStr h -> sget h
            | VSym sy -> sy
            | _ -> "step") in
  // no arguments is no parentheses: ((1..10).step), (1.step)
  (let args9 = join9 ea "" in
   "(" ++ rs ++ "." ++ mn ++ (if str_eq args9 "" then "" else "(" ++ args9 ++ ")") ++ ")")
// an Enumerator over an ALREADY-COMPUTED list that refuses to say how long it
// is. chunk / chunk_while / slice_when answer one: the elements are known (this
// interpreter computes them) but ruby's #size is nil, because the count is
// whatever the block decided and ruby will not run a block to answer #size.
and enum_over = fn world -> fn (xs: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let e = make_enum world (arr_new xs) "each" in
  let _ = (match e with
           | VObj eid -> map_set ivars (str_of_int eid ++ "@__e_size") VNil
           | _ -> ()) in
  e
and make_enum = fn world -> fn (recv: Val) -> fn (meth: str) ->
  make_enum_a world recv meth Nil
// what a PROGRAM'S to_enum / enum_for builds: its #size is nil unless a size
// block was given (`[1, 2, 3].to_enum(:map).size` is nil in ruby -- to_enum
// never borrows the method's own size function). ⚠ Counting by walking gave
// every such enumerator a size, and a walk of `each_entry` / `keep_if` ran the
// method -- `ENV.keep_if.size` emptied ENV, and a receiver whose #each never
// ends never answered. The size block, when there is one, overwrites this.
and make_enum_user = fn world -> fn (recv: Val) -> fn (meth: str) -> fn (eargs: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let e = make_enum_a world recv meth eargs in
  let _ = (match e with
           | VObj eid -> map_set ivars (str_of_int eid ++ "@__e_size") VNil
           | _ -> ()) in
  e
and make_enum_a = fn world -> fn (recv: Val) -> fn (meth: str) -> fn (eargs: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  let _ = map_set ocls id "Enumerator" in
  let _ = map_set ivars (str_of_int id ++ "@recv") recv in
  let _ = map_set ivars (str_of_int id ++ "@meth") (mkstr meth) in
  let _ = (match eargs with Nil -> () | _ -> map_set ivars (str_of_int id ++ "@eargs") (arr_new eargs)) in
  VObj id
and civil_from_days = fn (z0: int) ->
  let z = z0 + 719468 in
  let era = (if z >= 0 then z else z - 146096) / 146097 in
  let doe = z - era * 146097 in
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365 in
  let y = yoe + era * 400 in
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100) in
  let mp = (5 * doy + 2) / 153 in
  let d = doy - (153 * mp + 2) / 5 + 1 in
  let m = (if mp < 10 then mp + 3 else mp - 9) in
  ((if m <= 2 then y + 1 else y), m, d)
and prim_time_epoch = fn world -> fn (v: Val) ->
  let (_, _, _, iv9) = world in
  match v with
  | VObj oid ->
    (if map_has iv9 (str_of_int oid ++ "@__epoch") then map_get iv9 (str_of_int oid ++ "@__epoch")
     else VInt (epoch_of_ord (time_ord_of world v)))
  | _ -> VInt 0
and idiv_floor = fn (a: int) -> fn (b: int) ->
  let q = a / b in if a < 0 && q * b > a then q - 1 else q
and imod = fn (a: int) -> fn (b: int) -> let m = a - (idiv_floor a b) * b in m
and yday_of = fn (y: int) -> fn (m: int) -> fn (d: int) ->
  d + yday_months y 1 m 0
and yday_months = fn (y: int) -> fn (i: int) -> fn (m: int) -> fn (acc: int) ->
  if i >= m then acc else yday_months y (i + 1) m (acc + days_in_month y i)
and days_in_month = fn (y: int) -> fn (m: int) ->
  if m == 2 then (if is_leap_year y then 29 else 28)
  else if m == 4 || m == 6 || m == 9 || m == 11 then 30
  else 31
and is_leap_year = fn (y: int) ->
  (y - (y / 4) * 4 == 0 && (if y - (y / 100) * 100 == 0 then y - (y / 400) * 400 == 0 else true))
and epoch_of_ord = fn (n: int) -> n
and days_from_civil = fn (y0: int) -> fn (m: int) -> fn (d: int) ->
  let y = (if m <= 2 then y0 - 1 else y0) in
  let era = (if y >= 0 then y else y - 399) / 400 in
  let yoe = y - era * 400 in
  let doy = (153 * (if m > 2 then m - 3 else m + 9) + 2) / 5 + d - 1 in
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy in
  era * 146097 + doe - 719468
// ⚠ SUBSECONDS. A Time was epoch SECONDS and nothing else, so #usec answered a
// hard-coded 0, #nsec / #subsec / #to_r / #ceil / #floor did not exist, and
// `Time.at(x.5)` silently dropped the half -- which is also why `t2 - t1` came
// out 0 for a 300-millisecond gap. The nanosecond rides beside the second in
// its own ivar; everything that BUILDS a Time goes through make_time_at_ns, and
// everything that READS one asks time_nsec_of, which answers 0 for a Time made
// before any of this existed.
and time_nsec_of = fn world -> fn (v: Val) ->
  let (_, _, _, iv9) = world in
  match v with
  | VObj oid ->
    (if map_has iv9 (str_of_int oid ++ "@__tn")
     then (match map_get iv9 (str_of_int oid ++ "@__tn") with VInt n -> n | _ -> 0)
     else 0)
  | _ -> 0

and make_time_at_ns = fn world -> fn (secs: int) -> fn (ns: int) ->
  // a negative or overflowing nanosecond borrows from the second, so callers
  // can hand over any pair and get a normalised Time.
  let cs = secs + idiv_floor ns 1000000000 in
  let cn = imod ns 1000000000 in
  let (m9, s9, ocls9, iv9) = world in
  let id = alloc_oid ocls9 in
  let _ = map_set ocls9 id "Time" in
  let _ = map_set iv9 (str_of_int id ++ "@__t") (VInt (time_ord_of_epoch cs)) in
  let _ = map_set time_inst (str_of_int id) (time_ord_of_epoch cs) in
  let _ = map_set time_ltz (str_of_int id) (rb_env_get "TZ") in
  let _ = map_set iv9 (str_of_int id ++ "@__epoch") (VInt cs) in
  let _ = (if cn == 0 then () else map_set iv9 (str_of_int id ++ "@__tn") (VInt cn)) in
  VObj id

// the fractional part as ruby prints it: nothing at all when it is zero, and
// otherwise the digits with trailing zeros trimmed (.5, not .500000000).
and time_frac_str = fn (ns: int) ->
  if ns == 0 then ""
  else "." ++ time_trim_zeros (pad_left_zeros (str_of_int ns) 9)
and time_trim_zeros = fn (s9: str) ->
  let n9 = str_len s9 in
  if n9 <= 1 then s9
  else if str_eq (char_at s9 (n9 - 1)) "0" then time_trim_zeros (substring s9 0 (n9 - 1))
  else s9
// 10**n for n in 0..9, which is all the subsecond rounding needs.
and pow10_int = fn (n: int) -> if n <= 0 then 1 else 10 * pow10_int (n - 1)
and pad_left_zeros = fn (s9: str) -> fn (w: int) ->
  if str_len s9 >= w then s9 else pad_left_zeros ("0" ++ s9) w

// ⚠ LOCAL TIME IS THE SYSTEM'S ZONE, and it was UTC. Every Time that was not
//   explicitly UTC printed and answered its fields as if the machine were at
//   +00:00: on a JST machine `Time.at(0).to_s` was "1970-01-01 00:00:00
//   +0000" where ruby says "09:00:00 +0900", and Time.now was nine hours
//   out. A Time is still its epoch; what it SHOWS is epoch + offset, where
//   the offset is 0 for UTC, the one it was given for a fixed offset
//   (@__off), and otherwise the local zone's offset AT THAT INSTANT.
//
// The local zone comes from date(1), which knows the tz database: per
// (TZ, day), cached, honouring a TZ the program set (ENV overlay included).
// `date -r EPOCH` is BSD's spelling and GNU's is `date -d @EPOCH`; the first
// fails on GNU (-r wants a file) and falls through to the second. Where no
// date(1) answers at all (the Wasm build's `run` is a constant), the zone is
// UTC -- the old answer, now only where there is nothing better to ask.
//
// ⚠ PER DAY WAS TOO COARSE. The first instant asked about in a day decided the
//   whole day, so on a transition day every later question got the first
//   one's answer: EST5EDT's `Time.local(2010, 3, 14, 1, 59, 59) + 1` stayed
//   at -05:00 where ruby moves to -04:00, and whichever of the two came first
//   in a program decided the other. Now the day's two ENDS are asked (the next
//   day shares its start, so a run of days costs about one date(1) each), and
//   only a day whose ends disagree is bisected, once, to the second.
// ---- the tz database, read the way libc reads it --------------------------
// ⚠ ONE date(1) PER QUESTION WAS THE COST OF EVERY LOCAL TIME. Each answer was
//   a shell and a date process, and a local Time needs several (its own
//   instant, the offsets around a transition), so `0.upto(2100) { |y|
//   Time.local(y) }` -- ruby/spec's time_params asks exactly that, in four
//   files -- ran past the harness's budget. The zone is now read from its
//   TZif file once (the TZ name under /usr/share/zoneinfo, or /etc/localtime
//   when TZ is unset) and answered from the transition table, with the
//   file's POSIX footer for instants after the last transition. A TZ that is
//   a POSIX string rather than a file ("PDT8:00:00", what mspec's
//   with_timezone sets) is parsed as one. Only a TZ that is neither still asks
//   date(1).
//
// Everything lives in tz_db as strings, keyed by the TZ value:
//   k            "f" (a file was read), "p" (a POSIX string) or "d" (ask date)
//   n            the number of transitions;  t<i> / y<i> their instant / type
//   o<k> a<k> s<k>  type k's offset, abbreviation and isdst
//   ft           the POSIX footer ("" when there is none)
//   and for a POSIX rule, under a prefix: sn so dn do r1 r2 (see tzp_parse)
and tz_be32 = fn (d: str) -> fn (i: int) ->
  let v = ord (char_at d i) * 16777216 + ord (char_at d (i + 1)) * 65536
          + ord (char_at d (i + 2)) * 256 + ord (char_at d (i + 3)) in
  if v >= 2147483648 then v - 4294967296 else v
and tz_be64 = fn (d: str) -> fn (i: int) ->
  let hi = tz_be32 d i in
  let lo0 = tz_be32 d (i + 4) in
  let lo = (if lo0 < 0 then lo0 + 4294967296 else lo0) in
  hi * 4294967296 + lo
and tz_cstr = fn (d: str) -> fn (i: int) -> fn (lim: int) ->
  if i >= lim || ord (char_at d i) == 0 then "" else char_at d i ++ tz_cstr d (i + 1) lim
and tz_db_put = fn (tz9: str) -> fn (k: str) -> fn (v: str) -> map_set tz_db (tz9 ++ "\n" ++ k) v
and tz_db_get = fn (tz9: str) -> fn (k: str) ->
  if map_has tz_db (tz9 ++ "\n" ++ k) then map_get tz_db (tz9 ++ "\n" ++ k) else ""
and tz_db_int = fn (tz9: str) -> fn (k: str) -> int_of_str (tz_db_get tz9 k)
// the TZif body at `base`: `w` is 4 for version 1's times and 8 after.
// Answers where the body ends, or -1 when the file is shorter than it says.
and tzif_read = fn (tz9: str) -> fn (d: str) -> fn (base: int) -> fn (w: int) ->
  let isutc = tz_be32 d (base + 20) in
  let isstd = tz_be32 d (base + 24) in
  let leap = tz_be32 d (base + 28) in
  let tcnt = tz_be32 d (base + 32) in
  let ycnt = tz_be32 d (base + 36) in
  let ccnt = tz_be32 d (base + 40) in
  let tbase = base + 44 in
  let ibase = tbase + tcnt * w in
  let ybase = ibase + tcnt in
  let cbase = ybase + ycnt * 6 in
  let endb = cbase + ccnt + leap * (w + 4) + isstd + isutc in
  if endb > str_len d then 0 - 1
  else
    (let rec trans = fn (i: int) ->
       (if i >= tcnt then ()
        else (let _ = tz_db_put tz9 ("t" ++ str_of_int i) (str_of_int (if w == 8 then tz_be64 d (tbase + i * 8) else tz_be32 d (tbase + i * 4))) in
              let _ = tz_db_put tz9 ("y" ++ str_of_int i) (str_of_int (ord (char_at d (ibase + i)))) in
              trans (i + 1))) in
     let rec types = fn (k: int) ->
       (if k >= ycnt then ()
        else (let p = ybase + k * 6 in
              let _ = tz_db_put tz9 ("o" ++ str_of_int k) (str_of_int (tz_be32 d p)) in
              let _ = tz_db_put tz9 ("s" ++ str_of_int k) (str_of_int (ord (char_at d (p + 4)))) in
              let _ = tz_db_put tz9 ("a" ++ str_of_int k) (tz_cstr d (cbase + ord (char_at d (p + 5))) (cbase + ccnt)) in
              types (k + 1))) in
     let _ = trans 0 in
     let _ = types 0 in
     let _ = tz_db_put tz9 "n" (str_of_int tcnt) in
     endb)
and tz_has_sub = fn (s: str) -> fn (sub: str) -> fn (i: int) ->
  if i + str_len sub > str_len s then false
  else if str_eq (substring s i (i + str_len sub)) sub then true
  else tz_has_sub s sub (i + 1)
and tz_footer_end = fn (d: str) -> fn (i: int) ->
  if i >= str_len d || str_eq (char_at d i) "\n" then i else tz_footer_end d (i + 1)
// the zone for this TZ value, read once: "f", "p" or "d"
and tz_kind = fn (tz9: str) ->
  let k0 = tz_db_get tz9 "k" in
  if str_len k0 > 0 then k0
  else
    (let nm = (if str_len tz9 > 0 && str_eq (char_at tz9 0) ":" then substring tz9 1 (str_len tz9) else tz9) in
     let path = (if str_eq nm "" then "/etc/localtime"
                 else if str_eq (char_at nm 0) "/" then nm
                 else "/usr/share/zoneinfo/" ++ nm) in
     // a relative name may not climb out of the database
     let safe = (if tz_has_sub nm ".." 0 then false else true) in
     let d = (if safe && file_exists path && (if file_exists (path ++ "/.") then false else true) then read_file path else "") in
     let k = (if str_len d >= 44 && str_eq (substring d 0 4) "TZif" then
                (let v1end = tzif_read tz9 d 0 4 in
                 if v1end < 0 then "d"
                 else if ord (char_at d 4) >= 50 then
                   // version 2+: a second header with 64-bit times, then the footer
                   (let v2end = tzif_read tz9 d v1end 8 in
                    if v2end < 0 then "d"
                    else
                      (let fe = (if v2end < str_len d && str_eq (char_at d v2end) "\n" then tz_footer_end d (v2end + 1) else v2end) in
                       let ft = (if fe > v2end + 1 then substring d (v2end + 1) fe else "") in
                       let ok = (if str_len ft > 0 then tzp_parse tz9 "F" ft else false) in
                       let _ = tz_db_put tz9 "ft" (if ok then ft else "") in
                       "f"))
                 else (let _ = tz_db_put tz9 "ft" "" in "f"))
              else if str_len nm > 0 && tzp_parse tz9 "P" nm then "p"
              else "d") in
     let _ = tz_db_put tz9 "k" k in
     k)
// ---- POSIX TZ strings: std offset [dst [offset] [,start[/time],end[/time]]]
// a zone name: letters, or anything between < and >; its end index
and tzp_name_end = fn (s: str) -> fn (i: int) ->
  if i < str_len s && str_eq (char_at s i) "<" then
    (let rec go = fn (j: int) -> (if j >= str_len s || str_eq (char_at s j) ">" then j else go (j + 1)) in
     go (i + 1))
  else
    (let rec go = fn (j: int) ->
       (if j < str_len s && (let c = ord (char_at s j) in (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) then go (j + 1) else j) in
     go i)
and tzp_name_of = fn (s: str) -> fn (i: int) ->
  let j = tzp_name_end s i in
  if i < str_len s && str_eq (char_at s i) "<" then substring s (i + 1) j else substring s i j
and tzp_name_next = fn (s: str) -> fn (i: int) ->
  let j = tzp_name_end s i in
  if i < str_len s && str_eq (char_at s i) "<" && j < str_len s then j + 1 else j
and tzp_digits = fn (s: str) -> fn (j: int) -> fn (acc: int) ->
  if j < str_len s && is_digit (char_at s j) then tzp_digits s (j + 1) (acc * 10 + ord (char_at s j) - 48) else acc
and tzp_digits_end = fn (s: str) -> fn (j: int) ->
  if j < str_len s && is_digit (char_at s j) then tzp_digits_end s (j + 1) else j
// [+-]hh[:mm[:ss]] as seconds (POSIX's sign), or the end index; -1 = no digits
and tzp_hms_end = fn (s: str) -> fn (i: int) ->
  let i1 = (if i < str_len s && (str_eq (char_at s i) "-" || str_eq (char_at s i) "+") then i + 1 else i) in
  let i2 = tzp_digits_end s i1 in
  if i2 == i1 then 0 - 1
  else
    (let i3 = (if i2 < str_len s && str_eq (char_at s i2) ":" then tzp_digits_end s (i2 + 1) else i2) in
     if i3 > i2 && i3 < str_len s && str_eq (char_at s i3) ":" then tzp_digits_end s (i3 + 1) else i3)
and tzp_hms = fn (s: str) -> fn (i: int) ->
  let sg = (if i < str_len s && str_eq (char_at s i) "-" then 0 - 1 else 1) in
  let i1 = (if i < str_len s && (str_eq (char_at s i) "-" || str_eq (char_at s i) "+") then i + 1 else i) in
  let h = tzp_digits s i1 0 in
  let i2 = tzp_digits_end s i1 in
  let m = (if i2 < str_len s && str_eq (char_at s i2) ":" then tzp_digits s (i2 + 1) 0 else 0) in
  let i3 = (if i2 < str_len s && str_eq (char_at s i2) ":" then tzp_digits_end s (i2 + 1) else i2) in
  let sec = (if i3 > i2 && i3 < str_len s && str_eq (char_at s i3) ":" then tzp_digits s (i3 + 1) 0 else 0) in
  sg * (h * 3600 + m * 60 + sec)
// Parse `s` under prefix `pf`. The stored offsets are ruby's (east positive);
// POSIX writes them west positive. A rule is kept as its two texts.
and tzp_parse = fn (tz9: str) -> fn (pf: str) -> fn (s: str) ->
  let sn = tzp_name_of s 0 in
  let i1 = tzp_name_next s 0 in
  let i2 = tzp_hms_end s i1 in
  if str_len sn < 3 || i2 < 0 then false
  else
    (let so = tzp_hms s i1 in
     let _ = tz_db_put tz9 (pf ++ "sn") sn in
     let _ = tz_db_put tz9 (pf ++ "so") (str_of_int (0 - so)) in
     let dn = tzp_name_of s i2 in
     let i3 = tzp_name_next s i2 in
     if str_len dn == 0 then (let _ = tz_db_put tz9 (pf ++ "dn") "" in i2 == str_len s)
     else
       (let i4 = tzp_hms_end s i3 in
        let dof = (if i4 < 0 then 0 - so + 3600 else 0 - tzp_hms s i3) in
        let i5 = (if i4 < 0 then i3 else i4) in
        let _ = tz_db_put tz9 (pf ++ "dn") dn in
        let _ = tz_db_put tz9 (pf ++ "do") (str_of_int dof) in
        // no rule given: the US one, as libc assumes
        let rules = (if i5 < str_len s && str_eq (char_at s i5) "," then substring s (i5 + 1) (str_len s) else "M3.2.0,M11.1.0") in
        (match str_split rules "," with
         | Cons (r1, Cons (r2, _)) ->
           (let _ = tz_db_put tz9 (pf ++ "r1") r1 in
            let _ = tz_db_put tz9 (pf ++ "r2") r2 in true)
         | _ -> false)))
// the instant, in seconds of local wall time from 1970, that a rule
// "Mm.w.d[/time]", "Jn[/time]" or "n[/time]" names in year y
and tzp_rule_secs = fn (r: str) -> fn (y: int) ->
  let (body, tm) = (match str_split r "/" with
                    | Cons (b9, Cons (t9, _)) -> (b9, tzp_hms t9 0)
                    | _ -> (r, 7200)) in
  let y0 = days_from_civil y 1 1 in
  let day =
    (if str_len body > 0 && str_eq (char_at body 0) "M" then
       (match str_split (substring body 1 (str_len body)) "." with
        | Cons (ms, Cons (ws, Cons (ds, _))) ->
          (let m = int_of_str ms in
           let w = int_of_str ws in
           let dw = int_of_str ds in
           let first = days_from_civil y m 1 in
           let wd1 = imod (first + 4) 7 in
           let d1 = 1 + imod (dw - wd1 + 7) 7 + (w - 1) * 7 in
           let d2 = (if d1 > days_in_month y m then d1 - 7 else d1) in
           days_from_civil y m d2 - y0)
        | _ -> 0)
     else if str_len body > 0 && str_eq (char_at body 0) "J" then
       (let n = int_of_str (substring body 1 (str_len body)) in
        n - 1 + (if is_leap_year y && n >= 60 then 1 else 0))
     else int_of_str body) in
  (y0 + day) * 86400 + tm
// (offset, name) of a POSIX rule under prefix pf at instant ep
and tzp_at = fn (tz9: str) -> fn (pf: str) -> fn (ep: int) ->
  let so = tz_db_int tz9 (pf ++ "so") in
  let sn = tz_db_get tz9 (pf ++ "sn") in
  let dn = tz_db_get tz9 (pf ++ "dn") in
  if str_len dn == 0 then (so, sn)
  else
    (let dof = tz_db_int tz9 (pf ++ "do") in
     let (y, _, _) = civil_from_days (idiv_floor (ep + so) 86400) in
     // the start is written in standard time and the end in daylight time
     let st = tzp_rule_secs (tz_db_get tz9 (pf ++ "r1")) y - so in
     let en = tzp_rule_secs (tz_db_get tz9 (pf ++ "r2")) y - dof in
     let indst = (if st < en then ep >= st && ep < en else (if ep >= en && ep < st then false else true)) in
     if indst then (dof, dn) else (so, sn))
// is this Darwin (whose libc reads the 32-bit table for early instants)?
and tz_darwin = fn (u: unit) ->
  (if map_has tz_db "\ndarwin" then str_eq (map_get tz_db "\ndarwin") "1"
   else (let v = file_exists "/System/Library/CoreServices/SystemVersion.plist" in
         let _ = map_set tz_db "\ndarwin" (if v then "1" else "0") in v))
// the last transition at or before ep lies in [lo, hi)
and tzf_bs = fn (tz9: str) -> fn (ep: int) -> fn (lo: int) -> fn (hi: int) ->
  if hi - lo <= 1 then lo
  else (let mid = lo + (hi - lo) / 2 in
        if tz_db_int tz9 ("t" ++ str_of_int mid) <= ep then tzf_bs tz9 ep mid hi else tzf_bs tz9 ep lo mid)
and tzf_type = fn (tz9: str) -> fn (k: int) ->
  (tz_db_int tz9 ("o" ++ str_of_int k), tz_db_get tz9 ("a" ++ str_of_int k))
// whether the zone is in daylight saving at ep: the type's own isdst flag,
// the POSIX rule's, and for a zone date(1) answers, an offset ahead of the
// smaller of January's and July's
and tz_dst_in = fn (tz9: str) -> fn (ep: int) ->
  let k = tz_kind tz9 in
  if str_eq k "f" then tzf_dst tz9 ep
  else if str_eq k "p" then tzp_dst tz9 "P" ep
  else
    (let (o9, _) = tz_local_date tz9 ep in
     let (y9, _, _) = civil_from_days (idiv_floor (ep + o9) 86400) in
     let (oj9, _) = tz_local_date tz9 (days_from_civil y9 1 1 * 86400 + 43200) in
     let (ol9, _) = tz_local_date tz9 (days_from_civil y9 7 1 * 86400 + 43200) in
     o9 > (if oj9 < ol9 then oj9 else ol9))
and tzp_dst = fn (tz9: str) -> fn (pf: str) -> fn (ep: int) ->
  let (o9, _) = tzp_at tz9 pf ep in
  str_len (tz_db_get tz9 (pf ++ "dn")) > 0 && o9 == tz_db_int tz9 (pf ++ "do") && o9 != tz_db_int tz9 (pf ++ "so")
and tzf_dst = fn (tz9: str) -> fn (ep: int) ->
  let n = tz_db_int tz9 "n" in
  let hasft = str_len (tz_db_get tz9 "ft") > 0 in
  if ep < 0 - 2147483648 && tz_darwin () then tzf_dst tz9 0
  else if n == 0 then (if hasft then tzp_dst tz9 "F" ep else tz_db_int tz9 "s0" == 1)
  else if ep < tz_db_int tz9 "t0" then tz_db_int tz9 "s0" == 1
  else if hasft && ep >= tz_db_int tz9 ("t" ++ str_of_int (n - 1)) then tzp_dst tz9 "F" ep
  else tz_db_int tz9 ("s" ++ tz_db_get tz9 ("y" ++ str_of_int (tzf_bs tz9 ep 0 n))) == 1
// (offset, name) of a TZif zone at instant ep
and tzf_at = fn (tz9: str) -> fn (ep: int) ->
  let n = tz_db_int tz9 "n" in
  let hasft = str_len (tz_db_get tz9 "ft") > 0 in
  // ⚠ before 1901-12-13 (-2**31) Darwin's localtime(3) refuses, and ruby
  //   falls back to the zone as it was at the epoch (time.c's
  //   guess_local_offset): the reference says BST for London there, JST for
  //   Tokyo, EST for New York -- 1970's answers, not the table's LMT.
  if ep < 0 - 2147483648 && tz_darwin () then tzf_at tz9 0
  else if n == 0 then (if hasft then tzp_at tz9 "F" ep else tzf_type tz9 0)
  else if ep < tz_db_int tz9 "t0" then tzf_type tz9 0
  else if hasft && ep >= tz_db_int tz9 ("t" ++ str_of_int (n - 1)) then tzp_at tz9 "F" ep
  else tzf_type tz9 (tz_db_int tz9 ("y" ++ str_of_int (tzf_bs tz9 ep 0 n)))
and tz_at = fn (tz9: str) -> fn (ep: int) ->
  let key = tz9 ++ "|@" ++ str_of_int ep in
  let raw9 = (if map_has tz_cache key then map_get tz_cache key
              else
                (let pre9 = (if str_eq tz9 "" then "" else "TZ=" ++ shq tz9 ++ " ") in
                 let e9 = str_of_int ep in
                 let got9 = (match run_backtick ("(" ++ pre9 ++ "date -r " ++ e9 ++ " '+%z %Z' 2>/dev/null || "
                                                 ++ pre9 ++ "date -d @" ++ e9 ++ " '+%z %Z' 2>/dev/null)") with
                             | VStr h9 -> sget h9 | _ -> "") in
                 let _ = map_set tz_cache key got9 in got9)) in
  // "+0900 JST\n"
  if str_len raw9 >= 5 && (str_eq (char_at raw9 0) "+" || str_eq (char_at raw9 0) "-") then
    (let sg9 = (if str_eq (char_at raw9 0) "-" then 0 - 1 else 1) in
     let hh9 = int_of_str (substring raw9 1 3) in
     let mm9 = int_of_str (substring raw9 3 5) in
     let nm9 = strip_nl (substring raw9 (if str_len raw9 > 6 then 6 else str_len raw9) (str_len raw9)) in
     (sg9 * (hh9 * 3600 + mm9 * 60), nm9))
  else (0, "UTC")
// the first second of [lo, hi] that answers what hi answers (lo does not)
and tz_bisect = fn (tz9: str) -> fn (lo: int) -> fn (hi: int) -> fn (olo: int) -> fn (nlo: str) ->
  if hi - lo <= 1 then hi
  else
    (let mid = lo + (hi - lo) / 2 in
     let (om, nm) = tz_at tz9 mid in
     if om == olo && str_eq nm nlo then tz_bisect tz9 mid hi olo nlo else tz_bisect tz9 lo mid olo nlo)
and tz_local = fn (ep: int) -> tz_local_in (rb_env_get "TZ") ep
// the zone a local Time was made under (see time_ltz), else the current one
and time_tz_of = fn (oid: int) ->
  if map_has time_ltz (str_of_int oid) then map_get time_ltz (str_of_int oid) else rb_env_get "TZ"
and tz_local_in = fn (tz9: str) -> fn (ep: int) ->
  let k = tz_kind tz9 in
  if str_eq k "f" then tzf_at tz9 ep
  else if str_eq k "p" then tzp_at tz9 "P" ep
  else tz_local_date tz9 ep
// ...and where there is no database to read, date(1), per day
and tz_local_date = fn (tz9: str) -> fn (ep: int) ->
  let d0 = idiv_floor ep 86400 * 86400 in
  let (oa, na) = tz_at tz9 d0 in
  let (ob, nb) = tz_at tz9 (d0 + 86400) in
  if oa == ob && str_eq na nb then (oa, na)
  else
    (let key = tz9 ++ "|sw" ++ str_of_int d0 in
     let sw = (if map_has tz_cache key then int_of_str (map_get tz_cache key)
               else (let s9 = tz_bisect tz9 d0 (d0 + 86400) oa na in
                     let _ = map_set tz_cache key (str_of_int s9) in s9)) in
     if ep < sw then (oa, na) else (ob, nb))
and strip_nl = fn (s9: str) ->
  if str_len s9 > 0 && str_eq (char_at s9 (str_len s9 - 1)) "\n" then substring s9 0 (str_len s9 - 1) else s9

// The offset a Time SHOWS: 0 for UTC, its fixed offset, or the local one.
and time_off = fn world -> fn (v: Val) ->
  let (_, _, _, iv9) = world in
  match v with
  | VObj oid ->
    (if map_has iv9 (str_of_int oid ++ "@__utc") then 0
     else if map_has iv9 (str_of_int oid ++ "@__off")
     then (match map_get iv9 (str_of_int oid ++ "@__off") with VInt n9 -> n9 | _ -> 0)
     else (match tz_local_in (time_tz_of oid) (match prim_time_epoch world v with VInt n -> n | _ -> 0) with (o9, _) -> o9))
  | _ -> 0
and time_is_utc = fn world -> fn (v: Val) ->
  let (_, _, _, iv9) = world in
  match v with VObj oid -> map_has iv9 (str_of_int oid ++ "@__utc") | _ -> false
and time_is_fixed = fn world -> fn (v: Val) ->
  let (_, _, _, iv9) = world in
  match v with VObj oid -> map_has iv9 (str_of_int oid ++ "@__off") | _ -> false
// "+0900" / "+09:00" -- the sign always, hours and minutes zero-padded.
and time_off_str = fn (off: int) -> fn (colon: bool) ->
  let a9 = (if off < 0 then 0 - off else off) in
  (if off < 0 then "-" else "+") ++ pad_left_zeros (str_of_int (a9 / 3600)) 2
  ++ (if colon then ":" else "") ++ pad_left_zeros (str_of_int ((a9 / 60) - (a9 / 3600) * 60)) 2
  // #to_s / #inspect show a whole-second remainder too ("+010105")
  ++ (if not colon && a9 - (a9 / 60) * 60 != 0 then pad_left_zeros (str_of_int (a9 - (a9 / 60) * 60)) 2 else "")
// the local calendar fields of a Time: its epoch shifted by what it shows.
and time_local_parts = fn world -> fn (v: Val) ->
  let (w9, _) = time_wall world v in time_parts w9

// The wall clock a Time shows, as (seconds, nanoseconds). A Rational offset
// (Time.new(..., Rational(7201, 2))) moves it by a FRACTION of a second:
// the instant 12:00:00 at +3600.5 reads 13:00:00.5 -- its #sec is 0 --
// while #nsec, and the fraction #inspect prints, stay the instant's own.
// Everything else is epoch + the whole-second offset.
and time_wall = fn world -> fn (v: Val) ->
  let (_, _, _, iv9) = world in
  let ep9 = (match prim_time_epoch world v with VInt n -> n | _ -> 0) in
  let ns9 = time_nsec_of world v in
  match v with
  | VObj o9 when map_has iv9 (str_of_int o9 ++ "@__offx") && not (time_is_utc world v) ->
    (match map_get iv9 (str_of_int o9 ++ "@__offx") with
     | VRat (rn9, rd9) ->
       (let whole9 = int_of_str (big_div_s rn9 rd9) in
        let extra9 = int_of_str (big_div_s (big_mul_s (big_sub_s rn9 (big_mul_s (str_of_int whole9) rd9)) "1000000000") rd9) in
        let tot9 = ns9 + extra9 in
        (ep9 + whole9 + tot9 / 1000000000, tot9 - (tot9 / 1000000000) * 1000000000))
     | _ -> (ep9 + time_off world v, ns9))
  | _ -> (ep9 + time_off world v, ns9)

// "2020-01-02 03:04:05 UTC" -- #to_s never shows the fraction, #inspect does.
and time_str_of = fn world -> fn (v: Val) -> fn (withfrac: bool) ->
  let (_, _, _, iv9) = world in
  let (yy, mo, dd, hh, mi, ss) = time_local_parts world v in
  let utc = time_is_utc world v in
  // a negative year is its sign and then four digits (-0005), not the
  // digits of "-5" zero-padded into "00-5"
  (if yy < 0 then "-" ++ pad_left_zeros (str_of_int (0 - yy)) 4 else pad_left_zeros (str_of_int yy) 4)
  ++ "-" ++ pad_left_zeros (str_of_int mo) 2 ++ "-"
  ++ pad_left_zeros (str_of_int dd) 2 ++ " " ++ pad_left_zeros (str_of_int hh) 2 ++ ":"
  ++ pad_left_zeros (str_of_int mi) 2 ++ ":" ++ pad_left_zeros (str_of_int ss) 2
  ++ (if withfrac then time_frac_str (time_nsec_of world v) else "")
  ++ (if utc then " UTC" else " " ++ time_off_str (time_off world v) false)

// "Thu Jan  2 03:04:05 2020" -- the day of month is SPACE padded, not zero.
and time_asctime = fn world -> fn (v: Val) ->
  let ep = (match prim_time_epoch world v with VInt n -> n | _ -> 0) + time_off world v in
  let (yy, mo, dd, hh, mi, ss) = time_parts ep in
  let w = imod (idiv_floor ep 86400 + 4) 7 in
  time_wday_name w ++ " " ++ time_mon_name mo ++ " "
  ++ (if dd < 10 then " " ++ str_of_int dd else str_of_int dd) ++ " "
  ++ pad_left_zeros (str_of_int hh) 2 ++ ":" ++ pad_left_zeros (str_of_int mi) 2 ++ ":"
  ++ pad_left_zeros (str_of_int ss) 2 ++ " " ++ str_of_int yy
and time_wday_name = fn (w: int) ->
  if w == 0 then "Sun" else if w == 1 then "Mon" else if w == 2 then "Tue"
  else if w == 3 then "Wed" else if w == 4 then "Thu" else if w == 5 then "Fri" else "Sat"
and time_mon_name = fn (m9: int) ->
  if m9 == 1 then "Jan" else if m9 == 2 then "Feb" else if m9 == 3 then "Mar"
  else if m9 == 4 then "Apr" else if m9 == 5 then "May" else if m9 == 6 then "Jun"
  else if m9 == 7 then "Jul" else if m9 == 8 then "Aug" else if m9 == 9 then "Sep"
  else if m9 == 10 then "Oct" else if m9 == 11 then "Nov" else "Dec"

and time_ord_of_epoch = fn (secs: int) -> secs
and time_parts = fn (n: int) ->
  let days = (if n >= 0 then n / 86400 else (n - 86399) / 86400) in
  let rem = n - days * 86400 in
  let (y, m, d) = civil_from_days days in
  (y, m, d, rem / 3600, rem / 60 - (rem / 3600) * 60, rem - (rem / 60) * 60)
and time_ord = fn (args: Val list) ->
  let y = (match args with Cons (VInt a, _) -> a | _ -> 1970) in
  let m = (match args with Cons (_, Cons (VInt a, _)) -> a | _ -> 1) in
  let d = (match args with Cons (_, Cons (_, Cons (VInt a, _))) -> a | _ -> 1) in
  let h = (match args with Cons (_, Cons (_, Cons (_, Cons (VInt a, _)))) -> a | _ -> 0) in
  let mi = (match args with Cons (_, Cons (_, Cons (_, Cons (_, Cons (VInt a, _))))) -> a | _ -> 0) in
  let s = (match args with
           | Cons (_, Cons (_, Cons (_, Cons (_, Cons (_, Cons (VInt a, _)))))) -> a
           | Cons (_, Cons (_, Cons (_, Cons (_, Cons (_, Cons (VFlt f9, _)))))) -> int_of_float f9
           // exactly, not through a Float: 59 + 999999999/10^9 is second 59
           | Cons (_, Cons (_, Cons (_, Cons (_, Cons (_, Cons (VRat (rn9, rd9), _)))))) -> int_of_str (big_div_s rn9 rd9)
           | _ -> 0) in
  days_from_civil y m d * 86400 + h * 3600 + mi * 60 + s
and time_ord_of = fn world -> fn (v: Val) ->
  match v with
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let k = str_of_int id ++ "@__t" in
    if map_has ivars k then (match map_get ivars k with VInt n -> n | _ -> 0 - 1) else (0 - 1)
  | _ -> (0 - 1)
and is_ws_ch = fn (c: str) -> str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r"
  || (str_len c == 1 && (let o = ord c in o == 11 || o == 12))
and lex_skip_ws = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_ws_ch (char_at s i) then lex_skip_ws s (i + 1) else i
and lex_digits = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (acc, i)
  else
    let c = char_at s i in
    if is_digit c then lex_digits s (i + 1) (acc ++ c)
    else if str_eq c "_" && str_len acc > 0 && i + 1 < str_len s && is_digit (char_at s (i + 1))
    then lex_digits s (i + 1) acc
    else (acc, i)
and lex_sign = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) "-" || str_eq (char_at s i) "+")
  then ((if str_eq (char_at s i) "-" then "-" else ""), i + 1)
  else ("", i)
and str_to_f_lenient = fn (s: str) ->
  let i0 = lex_skip_ws s 0 in
  let (sg, i1) = lex_sign s i0 in
  let (ip, i2) = lex_digits s i1 "" in
  // ruby reads ".5" as 0.5, so an empty integer part is fine as long as a
  // fraction follows.
  let (fp, i3) =
    (if i2 < str_len s && str_eq (char_at s i2) "." && i2 + 1 < str_len s && is_digit (char_at s (i2 + 1))
     then (let (d, j) = lex_digits s (i2 + 1) "" in ("." ++ d, j))
     // ...and "1." with nothing after the point but an exponent reads the
     // exponent (ruby 3.4+: "1.e-2".to_f is 0.01, not 1.0)
     else if str_len ip > 0 && i2 + 1 < str_len s && str_eq (char_at s i2) "."
             && (str_eq (char_at s (i2 + 1)) "e" || str_eq (char_at s (i2 + 1)) "E")
     then ("", i2 + 1)
     else ("", i2)) in
  if str_len ip == 0 && str_len fp == 0 then 0.0
  else
    let ip = (if str_len ip == 0 then "0" else ip) in
    let (ex, _) =
      (if i3 < str_len s && (str_eq (char_at s i3) "e" || str_eq (char_at s i3) "E")
       then (let (esg, j0) = lex_sign s (i3 + 1) in
             let (ed, j1) = lex_digits s j0 "" in
             (if str_len ed == 0 then ("", i3) else ("e" ++ esg ++ ed, j1)))
       else ("", i3)) in
    float_of_str (sg ++ ip ++ fp ++ ex)
and vals_len = fn (xs: Val list) -> fn (acc: int) ->
  match xs with Nil -> acc | Cons (_, t) -> vals_len t (acc + 1)
and frame_line = fn (i: int) ->
  (if map_has call_lines i then map_get call_lines i else 0)
and frame_file = fn (i: int) ->
  (if map_has call_files_s i then map_get call_files_s i else "")
and frame_label_at = fn (i: int) ->
  // the bottom of THIS stack. The main stack's is <main>; a fiber's or a
  // thread's is the block its body is -- `Fiber.new { caller(0) }` answers
  // 'block in <main>' and nothing under it -- which the band's first entry
  // (at base - 1) labels like any block frame. Below the base is nothing of
  // this stack's.
  if i <= 0 || i < fb_depth_base () then "<main>"
  else if map_has call_names_s (i - 1) then
    (let n = map_get call_names_s (i - 1) in
     // a block's frame is labelled when it is ASKED for, from its env (see
     // block_label): the label depends on where the block was written, and
     // building it at every block call was a string per iteration
     if str_eq n blk_frame_mark
     then (if map_has fb_env_at (i - 1) then block_label (map_get fb_env_at (i - 1)) else "block in <main>")
     else meth_label n)
  else "?"
// ruby's label for a block's frame: `block in X`, or `block (N levels) in X`
// when it is written inside N-1 other blocks, where X is the label of the
// method, class body, required file or main it is written in. Walked from the
// block's own env up its scope chain: every env with a parent is one more
// block (a define_method body is one too -- ruby calls it `block in
// <class:K>`), and the walk stops at a method frame, at a scope that names
// itself (__scope: a class body, `<top (required)>`), or at the root, which
// is <main>.
and block_label = fn e ->
  let rec up = fn e9 -> fn (lvl: int) ->
    if map_has e9 "__scope" then (lvl, (match map_get e9 "__scope" with VStr h -> sget h | _ -> "<main>"))
    else if map_has e9 "__meth" && (if map_has e9 "__in_dm" then false else true) then
      (lvl, meth_label ((match (if map_has e9 "__defcls" then map_get e9 "__defcls" else VNil) with
                         | VClass c -> c ++ "#"
                         | _ -> "")
                        ++ (match map_get e9 "__meth" with VStr h -> sget h | _ -> "?")))
    else
      (let (has, p9) = lv_parent_of e9 in
       // a lambda's call puts a frame of its own (the env holding its return
       // boundary, __fid) between its body and the env it was written in;
       // that is no block of the program's, and is not a level
       // ...and so does instance_exec / class_exec: the child env that
       // rebinds self (an own "self") is the same block, not one more
       let own9 = (if (map_has e9 "__fid" || map_has e9 "self") && (if map_has e9 "__meth" then false else true) then 0 else 1) in
       if has then up p9 (lvl + own9) else ((if lvl < 1 then 1 else lvl), "<main>")) in
  let (lvl, base) = up e 0 in
  if lvl <= 1 then "block in " ++ base
  else "block (" ++ str_of_int lvl ++ " levels) in " ++ base
and frame_str = fn (i: int) ->
  frame_file i ++ ":" ++ str_of_int (frame_line i) ++ ":in '" ++ frame_label_at i ++ "'"
and caller_list = fn (i: int) ->
  if i < fb_depth_base () then (Nil : Val list) else Cons (mkstr (frame_str i), caller_list (i - 1))
and caller_depth = fn (u: unit) ->
  if map_has struct_ctr "cd" then map_get struct_ctr "cd" else 0
and caller_pick = fn (all: Val list) -> fn (a: Val) ->
  (let n9 = val_list_len all in
   match a with
   | VRange (lo9, hi9, ex9) ->
     (let s9 = (match lo9 with VInt i9 -> (if i9 < 0 then n9 + i9 else i9) | _ -> 0) in
      let e0 = (match hi9 with VInt i9 -> (if i9 < 0 then n9 + i9 else i9) | _ -> n9 - 1) in
      let e9 = (if ex9 && (match hi9 with VInt _ -> true | _ -> false) then e0 - 1 else e0) in
      if s9 < 0 || s9 > n9 then VNil
      else arr_new (vtake (vdrop all s9) (e9 - s9 + 1)))
   | VInt k9 -> (if k9 < 0 || k9 > n9 then VNil else arr_new (vdrop all k9))
   | _ -> arr_new (vdrop all 1))
and caller_pick2 = fn (all: Val list) -> fn (a: Val) -> fn (b: Val) ->
  (match caller_pick all a with
   | VArr id9 -> (match b with
                  | VInt m9 -> arr_new (vtake (deref id9) m9)
                  | _ -> VArr id9)
   | other9 -> other9)
and caller_frames = fn (skip: int) ->
  let cd = caller_depth () in
  // the current frame is a frame: at the top level it is <main>, which is what
  // `caller(0)` answers with there (and `caller` -- skipping it -- is empty)
  let b = fb_depth_base () in
  let here = mkstr (cur_file () ++ ":" ++ str_of_int (cur_line ()) ++ ":in '"
                    ++ (frame_label_at cd) ++ "'") in
  let all = (if cd <= b then Cons (here, (Nil : Val list))
             else Cons (here, caller_list (cd - 1))) in
  vdrop all skip
and vdrop = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then xs else (match xs with Nil -> (Nil : Val list) | Cons (_, t) -> vdrop t (n - 1))
and vtake = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then (Nil : Val list)
  else (match xs with Nil -> (Nil : Val list) | Cons (h, t) -> Cons (h, vtake t (n - 1)))
and bt_last_colon = fn (s: str) -> fn (upto: int) -> fn (best: int) ->
  bt_last_colon_go s 0 upto (0 - 1)
and bt_last_colon_go = fn (s: str) -> fn (i: int) -> fn (upto: int) -> fn (best: int) ->
  if i >= upto then best
  else bt_last_colon_go s (i + 1) upto (if str_eq (char_at s i) ":" then i else best)
and bt_digits = fn (s: str) -> fn (i: int) -> fn (stop: int) -> fn (acc: int) ->
  if i >= stop then acc
  else (let c = char_at s i in
        if ord c >= 48 && ord c <= 57 then bt_digits s (i + 1) stop (acc * 10 + (ord c - 48)) else acc)
and bt_quote_at = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then (0 - 1)
  else if str_eq (char_at s i) "'" then i else bt_quote_at s (i + 1)
and bt_quote_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "'" then i else bt_quote_end s (i + 1)
and seed_builtin_subclass_ivars = fn world -> fn (cls: str) -> fn (id: int) -> fn (args: Val list) ->
  let (m9s, s9s, o9s, ivars) = world in
  let _ = (if exc_is_a world cls "Regexp" then
             (match args with
              | Cons (VStr ph, rest) ->
                (let _ = map_set ivars (str_of_int id ++ "@__rx_src") (mkstr (sget ph)) in
                 let fl = (match rest with
                           | Cons (VInt f, _) -> (if floor_mod f 2 == 1 then "i" else "") ++ (if floor_mod (floor_div f 4) 2 == 1 then "m" else "") ++ (if floor_mod (floor_div f 2) 2 == 1 then "x" else "") ++ (if floor_mod (floor_div f 16) 2 == 1 then "u" else "")
                           | Cons (VBool true, _) -> "i"
                           | _ -> "") in
                 map_set ivars (str_of_int id ++ "@__rx_flags") (mkstr fl))
              | Cons (VRegex (p9, f9, _), _) ->
                (let _ = map_set ivars (str_of_int id ++ "@__rx_src") (mkstr p9) in
                 map_set ivars (str_of_int id ++ "@__rx_flags") (mkstr f9))
              | _ -> ())
           else ()) in
  (if exc_is_a world cls "Range" then
     (match args with
      | Cons (lo9, Cons (hi9, rest)) ->
        (let _ = map_set ivars (str_of_int id ++ "@__rg_lo") lo9 in
         let _ = map_set ivars (str_of_int id ++ "@__rg_hi") hi9 in
         map_set ivars (str_of_int id ++ "@__rg_ex")
           (VBool (match rest with Cons (x9, _) -> truthy x9 | _ -> false)))
      | _ -> ())
   else ())
and is_block_param = fn (p: str) -> str_len p > 0 && str_eq (char_at p 0) "&"
and block_param_name = fn (params: str list) ->
  match params with
  | Nil -> ""
  | Cons (p, r) -> if is_block_param p then substring p 1 (str_len p) else block_param_name r
and strip_block_params = fn (params: str list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) ->
    if is_block_param p || str_eq p empty_bp_marker || str_eq p lambda_blk_marker
    then strip_block_params r else Cons (p, strip_block_params r)
and bind_block_locals = fn cenv -> fn (params: str list) ->
  match params with
  | Nil -> ()
  | Cons (p, r) ->
    let _ = if str_len p > 0 && str_eq (char_at p 0) ";" then map_set cenv (substring p 1 (str_len p)) VNil else () in
    bind_block_locals cenv r
and drop_block_locals = fn (params: str list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if str_len p > 0 && str_eq (char_at p 0) ";" then drop_block_locals r else Cons (p, drop_block_locals r)
and param_names_vals = fn (params: str list) ->
  match params with Nil -> Nil | Cons (p, r) -> Cons (mkstr p, param_names_vals r)
and zsuper_args = fn env -> fn (ps: Val list) ->
  match ps with
  | Nil -> Nil
  | Cons (h, rest) ->
    (match h with
     | VStr p -> let p = sget p in
       if str_len p == 0 then zsuper_args env rest
       else if str_eq (char_at p 0) "&" then zsuper_args env rest
       else if str_eq (char_at p (str_len p - 1)) ":" then zsuper_args env rest
       else if str_eq (char_at p 0) "*" then
         let nm = substring p 1 (str_len p) in
         (if str_eq nm "" || not (lv_has env nm) then zsuper_args env rest
          else (match lv_get env nm with
                | VArr id -> list_append (deref id) (zsuper_args env rest)
                | v -> Cons (v, zsuper_args env rest)))
       else Cons ((if lv_has env p then lv_get env p else VNil), zsuper_args env rest)
     | _ -> zsuper_args env rest)
and zsuper_kw_pairs = fn env -> fn (ps: Val list) ->
  match ps with
  | Nil -> Nil
  | Cons (VStr p, rest) ->
    let p = sget p in
    if str_len p > 1 && str_eq (substring p 0 2) "**" then
      let nm = substring p 2 (str_len p) in
      (if str_eq nm "" then zsuper_kw_pairs env rest
       else if lv_has env nm then (match lv_get env nm with VHsh id -> list_append (hderef id) (zsuper_kw_pairs env rest) | _ -> zsuper_kw_pairs env rest)
       else zsuper_kw_pairs env rest)
    else if str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":" then
      let nm = substring p 0 (str_len p - 1) in
      (if lv_has env nm then Cons (VSym nm, Cons (lv_get env nm, zsuper_kw_pairs env rest)) else zsuper_kw_pairs env rest)
    else zsuper_kw_pairs env rest
  | Cons (_, rest) -> zsuper_kw_pairs env rest
and zsuper_all = fn env -> fn (ps: Val list) ->
  let pos = zsuper_args env ps in
  match zsuper_kw_pairs env ps with
  | Nil -> pos
  | kw -> (match mkhash kw with VHsh id -> let _ = mark_kw id in list_append pos (Cons (VHsh id, Nil)) | h -> list_append pos (Cons (h, Nil)))
and is_kw_param = fn (p: str) ->
  (str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":") ||
  (str_len p > 1 && str_eq (substring p 0 2) "**")
and kw_params = fn (params: str list) ->
  match params with Nil -> Nil | Cons (p, r) -> if is_kw_param p then Cons (p, kw_params r) else kw_params r
and pos_params = fn (params: str list) ->
  match params with Nil -> Nil | Cons (p, r) -> if is_kw_param p then pos_params r else Cons (p, pos_params r)
and mark_r2k_tail = fn (args: Val list) ->
  match args with
  | Cons (VHsh id, Nil) ->
    (if map_has kwarg_marks (str_of_int id) then map_set r2k_marks (str_of_int id) VNil else ())
  | Cons (_, t) -> mark_r2k_tail t
  | Nil -> ()
and unmark_kwargs = fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (VHsh id, r) -> let _ = if map_has kwarg_marks (str_of_int id) then map_delete kwarg_marks (str_of_int id) else () in unmark_kwargs r
  | Cons (_, r) -> unmark_kwargs r
and peel_kw_hash = fn (args: Val list) ->
  match rev_app args Nil with
  | Cons (VHsh xs, rrest) -> if is_kw_hash (VHsh xs) then (rev_app rrest Nil, hderef xs) else (args, (Nil : Val list))
  | _ -> (args, (Nil : Val list))
and str_list_has = fn (xs: str list) -> fn (s: str) ->
  match xs with Nil -> false | Cons (x, r) -> if str_eq x s then true else str_list_has r s
and kw_has_rest = fn (kws: str list) ->
  match kws with Nil -> false | Cons (p, r) -> if str_len p > 1 && str_eq (substring p 0 2) "**" then true else kw_has_rest r
and kw_req_missing = fn (kws: str list) -> fn (defaults: (str * Expr) list) -> fn (kwhash: Val list) ->
  match kws with
  | Nil -> false
  | Cons (p, r) ->
    if str_len p > 1 && str_eq (substring p 0 2) "**" then kw_req_missing r defaults kwhash
    else let nm = substring p 0 (str_len p - 1) in
      if hash_haskey kwhash (VSym nm) then kw_req_missing r defaults kwhash
      else if has_default defaults p then kw_req_missing r defaults kwhash
      else true
and kwhash_drop = fn (kwhash: Val list) -> fn (names: str list) ->
  match kwhash with
  | Cons (k, Cons (v, rest)) ->
    let kn = (match k with VSym s -> s | _ -> "\{nonsym}") in
    if str_list_has names kn then kwhash_drop rest names
    else Cons (k, Cons (v, kwhash_drop rest names))
  | _ -> Nil
and kw_names_of = fn (kws: str list) ->
  match kws with Nil -> Nil | Cons (p, r) ->
    if str_len p > 1 && str_eq (substring p 0 2) "**" then kw_names_of r
    else Cons (substring p 0 (str_len p - 1), kw_names_of r)
// the keywords a call gave that no parameter takes, and the required ones it
// did not give -- ruby's two refusals NAME them ("unknown keywords: :a, :b",
// "missing keyword: :b"), where these said only "unknown keyword"
and kw_unknown_keys = fn (names: str list) -> fn (kwhash: Val list) ->
  match kwhash with
  | Cons (k, Cons (_, rest)) ->
    let kn = (match k with VSym s -> s | _ -> "\{notsym}") in
    if str_list_has names kn then kw_unknown_keys names rest else Cons (k, kw_unknown_keys names rest)
  | _ -> Nil
and kw_missing_names = fn (kws: str list) -> fn (defaults: (str * Expr) list) -> fn (kwhash: Val list) ->
  match kws with
  | Nil -> Nil
  | Cons (p, r) ->
    if str_len p > 1 && str_eq (substring p 0 2) "**" then kw_missing_names r defaults kwhash
    else (let nm = substring p 0 (str_len p - 1) in
          if hash_haskey kwhash (VSym nm) || has_default defaults p then kw_missing_names r defaults kwhash
          else Cons (VSym nm, kw_missing_names r defaults kwhash))
and kw_refusal = fn (what: str) -> fn (ks: Val list) ->
  let rec join = fn (xs: Val list) ->
    (match xs with Nil -> "" | Cons (x, Nil) -> inspect x | Cons (x, t) -> inspect x ++ ", " ++ join t) in
  (match ks with
   | Cons (_, Cons (_, _)) -> what ++ " keywords: " ++ join ks
   | _ -> what ++ " keyword: " ++ join ks)
and kw_has_unknown = fn (names: str list) -> fn (kwhash: Val list) ->
  match kwhash with
  | Nil -> false
  | Cons (k, Cons (v, rest)) ->
    let kn = (match k with VSym s -> s | _ -> "\{notsym}") in
    if str_list_has names kn then kw_has_unknown names rest else true
  | _ -> false
and pos_required = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> 0
  | Cons (p, r) ->
    if tgt_is_splat p then pos_required r defaults
    else if has_default defaults p then pos_required r defaults
    else 1 + pos_required r defaults
and arity_error = fn world -> fn (name: str) -> fn (lo: int) -> fn (hi: int) -> fn (got: int) ->
  let want = (if lo == hi then str_of_int lo else str_of_int lo ++ ".." ++ str_of_int hi) in
  raise_exc world "ArgumentError" ("wrong number of arguments (given " ++ str_of_int got ++ ", expected " ++ want ++ ")")
and req_pre = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then Nil else Cons (p, req_pre r defaults)
and drop_req_pre = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then params else drop_req_pre r defaults
and opt_run = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then Cons (p, opt_run r defaults) else Nil
and drop_opt_run = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then drop_opt_run r defaults else params
and decl_default_names = fn frame -> fn (e: Expr) ->
  match e with
  | EAssign (n, inner) ->
    let _ = (if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then ()
             else if map_has frame n then () else (let _ = map_set frame n VNil in ())) in
    decl_default_names frame inner
  | _ -> ()
and has_default = fn (defaults: (str * Expr) list) -> fn (p: str) ->
  match defaults with Nil -> false | Cons (d, r) -> let (n, _) = d in if str_eq n p then true else has_default r p
and get_default = fn (defaults: (str * Expr) list) -> fn (p: str) ->
  match defaults with Nil -> ENil | Cons (d, r) -> let (n, e) = d in if str_eq n p then e else get_default r p
and bind_strict = fn frame -> fn (name: str) -> fn (params: str list) -> fn (args: Val list) ->
  match params with
  | Nil ->
    (match args with
     | Nil -> ()
     | _ -> (let __fm = ("mere-ruby: wrong number of arguments calling " ++ name) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm))
  | Cons (p, ps) ->
    (match args with
     | Nil -> (let __fm = ("mere-ruby: wrong number of arguments calling " ++ name) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
     | Cons (a, rest_a) -> let _ = map_set frame p a in bind_strict frame name ps rest_a)
and recv_base = fn (nm: str) -> recv_base_go nm 0
and recv_base_go = fn (nm: str) -> fn (i: int) ->
  if i >= str_len nm then nm
  else if str_eq (char_at nm i) "#" then substring nm 0 i
  else recv_base_go nm (i + 1)
and prim_sng_cls = fn world -> fn (recv: Val) -> fn (basecls: str) ->
  let (_, sup2, _, _) = world in
  let hk = hng_key recv in
  let sname = "(sng:" ++ hk ++ ")" in
  let base = if map_has hng_store hk then map_get hng_store hk else basecls in
  let _ = if map_has sup2 sname then () else set_sup sup2 sname base in
  // the class the value had before it got a singleton, for #class to answer
  let _ = if is_sng_cls base then () else map_set hng_sng_base hk base in
  // ...and record it as THIS value's class, which is where dispatch looks. It
  // only built the name and the superclass link before, so a method defined
  // through `obj.singleton_class.define_method(...)` was never found -- while
  // `class << obj`, which does register it, worked. Two ways of opening the
  // same singleton class, one of which did nothing.
  let _ = map_set hng_store hk sname in
  sname
and singleton_cls_of = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  let cur = map_get ocls id in
  if is_sng_cls cur then cur
  else
    let sname = "(sng:" ++ str_of_int id ++ ")" in
    let _ = set_sup sup sname cur in
    let _ = map_set ocls id sname in
    sname
and definee_cls_of = fn env -> fn world ->
  // an explicitly NAMED definee wins: class_exec/module_exec run a block whose
  // definee is the class itself, which the receiver form cannot say (it would
  // resolve to the singleton).
  if lv_has env "__definee_cls" then (match lv_get env "__definee_cls" with VStr h -> sget h | _ -> "")
  else if lv_has env "__definee_recv" then
    (match lv_get env "__definee_recv" with
     | VObj id -> singleton_cls_of world id
     | VClass c -> "(sng:" ++ c ++ ")"
     | VStr h -> hng_cls_of world (VStr h) "String"
     | VArr h -> hng_cls_of world (VArr h) "Array"
     | VHsh h -> hng_cls_of world (VHsh h) "Hash"
     | _ -> "")
  else ""
and is_sng_cls = fn (c: str) ->
  str_len c >= 5 && str_eq (substring c 0 5) "(sng:"
and sng_inner = fn (c: str) -> substring c 5 (str_len c - 1)
and collect_vis_go = fn world -> fn (anc: str list) -> fn names -> fn blocked ->
  fn (want: int) -> fn (recur: bool) -> fn (first: bool) ->
  match anc with
  | Nil -> ()
  | Cons (c9, rest) ->
    let (meths0, _, _, _) = world in
    let pfx = c9 ++ "#" in
    let plen = str_len pfx in
    // an undef'd name is gone from HERE UP, so it is marked before this level's
    // table is read and a superclass definition cannot put it back.
    let _ = map_iter undefs (fn (k: str) -> fn (v: Val) ->
      if str_len k > plen && str_eq (substring k 0 plen) pfx
      then map_set blocked (substring k plen (str_len k)) VNil
      else ()) in
    let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
      if str_len k > plen && str_eq (substring k 0 plen) pfx
         && (if str_contains (substring k plen (str_len k)) "#" then false else true)
      then
        (let nm = substring k plen (str_len k) in
         if map_has names nm || map_has blocked nm then ()
         else
           (let priv = map_has privates k in
            let prot = map_has protecteds k in
            let ok = (if want == 1 then (if priv || prot then false else true)
                      else if want == 2 then priv
                      else if want == 3 then prot
                      else (if priv then false else true)) in
            // the FIRST class that defines a name decides its visibility: a
            // public override of an inherited private method is public, and
            // the inherited entry must not be reconsidered further up.
            if ok then map_set names nm (VSym nm) else map_set blocked nm VNil))
      else ()) in
    // ⚠ ...and a visibility mark with NO BODY at this level decides too.
    //   `class B < A; private :b; end` writes privates["B#b"] and no method
    //   row, so the walk found nothing at B, reached A's public #b and listed
    //   it -- `B.new.methods` included a method B had made private. The mark
    //   is read after the rows, so a level that has both is decided above.
    let mark9 = fn (tbl: str) -> fn (isprot: bool) ->
      map_iter (if isprot then protecteds else privates) (fn (k: str) -> fn (v: Val) ->
        if str_len k > plen && str_eq (substring k 0 plen) pfx
           && (if str_contains (substring k plen (str_len k)) "#" then false else true)
        then
          (let nm = substring k plen (str_len k) in
           if map_has names nm || map_has blocked nm then ()
           else if (if isprot then (want == 3 || want == 0) else want == 2)
           then map_set names nm (VSym nm)
           else map_set blocked nm VNil)
        else ()) in
    let _ = mark9 "p" false in
    let _ = mark9 "p" true in
    // ...and a PUBLIC mark with no body is the same statement the other way:
    //   `module Kernel; public :m; end` for a private Object#m makes a public
    //   Kernel#m, and the walk found nothing at Kernel to list.
    let _ = map_iter vis_marks (fn (k: str) -> fn (v: Val) ->
      if str_len k > plen && str_eq (substring k 0 plen) pfx
         && (if str_contains (substring k plen (str_len k)) "#" then false else true)
         && (if map_has privates k || map_has protecteds k then false else true)
      then
        (let nm = substring k plen (str_len k) in
         if map_has names nm || map_has blocked nm then ()
         else if want == 0 || want == 1 then map_set names nm (VSym nm)
         else map_set blocked nm VNil)
      else ()) in
    // recur = false stops after this level -- unless it is a singleton class,
    // which ruby steps past to reach the object's real class.
    if recur then collect_vis_go world rest names blocked want recur false
    else if first && is_sng_cls c9 then collect_vis_go world rest names blocked want recur false
    else ()
and is_vis_list_name = fn (name: str) ->
  (str_len name == 7 && str_eq name "methods") || (str_len name == 14 && str_eq name "public_methods")
  || (str_len name == 15 && str_eq name "private_methods") || (str_len name == 17 && str_eq name "protected_methods")
and collect_cls_methods = fn world -> fn (cls: str) -> fn names ->
  let (meths0, sup0, _, _) = world in
  let pfx = "(sng:" ++ cls ++ ")#" in
  let plen = str_len pfx in
  let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
    if str_len k > plen && str_eq (substring k 0 plen) pfx
       && (if map_has privates k then false else true)
    then (let nm = substring k plen (str_len k) in if map_has names nm then () else map_set names nm (VSym nm))
    else ()) in
  if map_has sup0 cls then collect_cls_methods world (map_get sup0 cls) names else ()
and metaclass_class = fn (c: str) ->
  if is_sng_cls c then "(sng:" ++ metaclass_class (sng_inner c) ++ ")"
  else if map_has modules c then "Module"
  else "Class"
and sng_supername = fn world -> fn (c: str) ->
  let (_, sup0, _, _) = world in
  if is_sng_cls c then
    (if map_has sup0 c then map_get sup0 c
     else
       let inner = sng_inner c in
       if str_eq inner "BasicObject" then "Class"
       // a module's singleton class descends from Module (the module is an
       // instance of Module), so its class methods' super reaches Module then
       // Object instance methods.
       else if map_has modules inner then "Module"
       else "(sng:" ++ sng_supername world inner ++ ")")
  else if str_eq c "BasicObject" then "BasicObject"
  else if map_has sup0 c then map_get sup0 c
  else if str_eq c "Object" then "BasicObject"
  else "Object"
and first_seg = fn (k: str) ->
  let rec at = fn (i: int) ->
    (if i + 1 >= str_len k then 0 - 1
     else if str_eq (char_at k i) ":" && str_eq (char_at k (i + 1)) ":" then i
     else at (i + 1)) in
  (let i9 = at 0 in if i9 < 0 then k else substring k 0 i9)

and name_anon = fn (cn: str) -> fn (v: Val) -> name_anon_x cn v false

// ⚠ RENAMING a module already named through its anonymous parent. `m = Module.new;
//   m::B = Module.new; ModuleSpecs_CS2 = m` must leave B called
//   "ModuleSpecs_CS2::B" -- but B was named the moment it was assigned, so the
//   "first name wins" guard (which is also what terminates cycles) refused the
//   better one. The RECURSION forces; a fresh naming still does not.
and name_anon_x = fn (cn: str) -> fn (v: Val) -> fn (force: bool) ->
  match v with
  | VClass c ->
    // a name that begins "#<" is a TEMPORARY one, built on an anonymous owner
    // (below); a real constant path replaces it, as in ruby.
    let cur0 = (if map_has anon_name c then (match map_get anon_name c with VStr h9 -> sget h9 | _ -> "") else "") in
    let cur = (if str_len cur0 >= 2 && str_eq (substring cur0 0 2) "#<" then "" else cur0) in
    let owner = first_seg cn in
    // ⚠ ...and an anonymous owner DOES give one: `m::N = Module.new` names N
    //   "#<Module:0x...>::N" -- the owner as it prints, then the path. It is not
    //   propagated to N's own constants (each gets its own when assigned) and
    //   never replaces a name already held, so `q::W = q` stops at one step.
    //   A module opened as `module m::M` already carries its path, so it is
    //   left alone too.
    if is_anon_cls c && is_anon_cls owner && str_eq cur0 "" && str_find_from c "::" 0 < 0 then
      map_set anon_name c (mkstr (to_s (VClass owner) ++ substring cn (str_len owner) (str_len cn)))
    else
    // ⚠ A NAME BUILT ON AN ANONYMOUS OWNER IS NOT A NAME. `m = Module.new;
    //   m::Z = Module.new` would key Z as "AnonModule_2::Z", and storing that
    //   leaks an internal name out of #name AND makes `q::W = q` rename
    //   forever ("Q2", "Q2::W", "Q2::W::W", ... until the process is killed).
    //   Z simply has no name yet; it gets one when the OWNER is assigned to a
    //   constant, which is the recursion below -- and that one replaces the
    //   name the owner's old anonymous path had given it.
    if is_anon_cls c
       && (if is_anon_cls (first_seg cn) then false else true)
       && (if str_eq cur "" then true else force)
       // ⚠ ...and never to a name that EXTENDS the one it already has. A module
       //   that contains itself (`q::W = q`) is renamed by its own recursion:
       //   "Q2", then "Q2::W", then "Q2::W::W", until the process is killed.
       //   Ruby answers "Q2" for both q and q::W -- the first name it got.
       && (if str_eq cur "" then true
           else (if str_len cn > str_len cur && str_eq (substring cn 0 (str_len cur)) cur
                 then false else true))
    then
      (let _ = map_set anon_name c (mkstr cn) in
       let prefix = c ++ "::" in
       let plen = str_len prefix in
       map_iter consts (fn (k: str) -> fn (kv: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) prefix
            && (if str_contains (substring k plen (str_len k)) "::" then false else true)
         then name_anon_x (cn ++ "::" ++ substring k plen (str_len k)) kv true
         else ()))
    else ()
  | _ -> ()
and sng_cls_of_val = fn world -> fn (v: Val) -> fn (enclosing: str) ->
  match v with
  | VObj id -> singleton_cls_of world id
  // the singleton class of a class C is (sng:C) — class methods live there.
  // A singleton class has its own (distinct) singleton class too, so nest:
  // the metaclass of a metaclass is (sng:(sng:C)), enabling deeper chains.
  | VClass c -> "(sng:" ++ c ++ ")"
  | VStr h -> hng_cls_of world (VStr h) "String"
  | VArr h -> hng_cls_of world (VArr h) "Array"
  | VHsh h -> hng_cls_of world (VHsh h) "Hash"
  | _ -> enclosing
and sng_target_cls = fn world -> fn env -> fn (tgt: str) -> fn (enclosing: str) ->
  if str_eq tgt "self" then
    (if lv_has env "self" then sng_cls_of_val world (lv_get env "self") enclosing else enclosing)
  else if lv_has env tgt then sng_cls_of_val world (lv_get env tgt) enclosing
  // `def @obj.m` -- the receiver is an ivar of the current self.
  else if str_len tgt > 1 && str_eq (char_at tgt 0) "@" && lv_has env "self" then
    (match lv_get env "self" with
     | VObj oid ->
       (let (m9v, s9v, o9v, iv9) = world in
        let k9 = str_of_int oid ++ tgt in
        if map_has iv9 k9 then sng_cls_of_val world (map_get iv9 k9) enclosing else enclosing)
     | _ -> enclosing)
  else enclosing
and hng_cls_of = fn world -> fn (recv: Val) -> fn (typename: str) ->
  // the value's SINGLETON class. A subclass tag is the singleton's
  // superclass, never the answer itself: answering the tag made
  // `def s.special` on a tagged string define a method on the CLASS, and
  // every other instance grew it too.
  let (meths, sup, ocls, ivars) = world in
  let k = hng_key recv in
  let cur = (if map_has hng_store k then map_get hng_store k else typename) in
  if is_sng_cls cur then cur
  else
    let sname = "(sng:" ++ k ++ ")" in
    let _ = set_sup sup sname cur in
    let _ = map_set hng_store k sname in
    sname
and display_cls = fn world -> fn (c: str) ->
  let (meths, sup, ocls, ivars) = world in
  if is_sng_cls c then (if map_has sup c then display_cls world (map_get sup c) else "Object")
  else c
and cls_body_writes = fn (s: Stmt) ->
  match s with
  | SDef (_, _, _, _) -> true
  | SAttr (_, _) -> true
  | SAlias (_, _) -> true
  | SUndef _ -> true
  | SInclude (_, _) -> true
  | SClass (_, _, _) -> true
  | SClassE (_, _, _) -> true
  | SVis (_, names) -> (match names with Nil -> false | _ -> true)
  | SAssign (n, _) -> is_upper_first n
  | _ -> false
and cls_frozen_refuses = fn (name: str) -> fn (args: Val list) ->
  (str_len name == 13 && str_eq name "define_method") || (str_len name == 23 && str_eq name "define_singleton_method") ||
  (str_len name == 12 && str_eq name "alias_method") || (str_len name == 13 && str_eq name "remove_method") || (str_len name == 12 && str_eq name "undef_method") ||
  (str_len name == 13 && str_eq name "attr_accessor") || (str_len name == 11 && str_eq name "attr_reader") || (str_len name == 11 && str_eq name "attr_writer") ||
  (str_len name == 4 && str_eq name "attr") || (str_len name == 9 && str_eq name "const_set") || (str_len name == 12 && str_eq name "remove_const") ||
  (str_len name == 7 && str_eq name "include") || (str_len name == 7 && str_eq name "prepend") || (str_len name == 6 && str_eq name "extend") ||
  (str_len name == 21 && str_eq name "instance_variable_set") || (str_len name == 24 && str_eq name "remove_instance_variable") ||
  (str_len name == 20 && str_eq name "private_class_method") || (str_len name == 19 && str_eq name "public_class_method") ||
  (str_len name == 16 && str_eq name "private_constant") || (str_len name == 15 && str_eq name "public_constant") ||
  (str_len name == 14 && str_eq name "ruby2_keywords") ||
  // ...and the class-variable writers, which were not in this list: a frozen
  // class accepted `class_variable_set` and `remove_class_variable` silently.
  (str_len name == 18 && str_eq name "class_variable_set") ||
  (str_len name == 21 && str_eq name "remove_class_variable") ||
  // ...with NAMES. `K.send(:private)` on a frozen class is allowed: it only
  // sets the mode for defs that would follow, and none can.
  (((str_len name == 7 && str_eq name "private") || (str_len name == 6 && str_eq name "public") || (str_len name == 9 && str_eq name "protected"))
   && (match args with Nil -> false | _ -> true))
and exc_cls_of = fn world -> fn (recv: Val) ->
  match recv with
  | VObj oid9 -> (let (_, _, ocls9, _) = world in map_get ocls9 oid9)
  | VExc (c9, _) -> c9
  | _ -> class_name recv
and exc_msg_nl = fn (s9: str) -> fn (i9: int) ->
  if i9 >= str_len s9 then 0 - 1
  else if str_eq (char_at s9 i9) "\n" then i9
  else exc_msg_nl s9 (i9 + 1)
and exc_hl_lines = fn (s9: str) ->
  let e9 = chr 27 in
  // the empty tail (a SINGLE-line message) must be answered before the
  // substring below runs -- `let` is eager, so computing it first made
  // `full_message(highlight: true)` on a one-line message fail outright.
  if str_len s9 == 0 then ""
  else
  let nl9 = exc_msg_nl (substring s9 1 (str_len s9)) 0 in
  (if nl9 < 0 then "\n" ++ e9 ++ "[1m" ++ substring s9 1 (str_len s9) ++ e9 ++ "[m"
  else "\n" ++ e9 ++ "[1m" ++ substring s9 1 (nl9 + 1) ++ e9 ++ "[m"
         ++ exc_hl_lines (substring s9 (nl9 + 1) (str_len s9)))
and exc_dm_kw_pairs = fn (kw9: Val) -> fn (hl: bool) ->
  let given9 = (match kw9 with VHsh h9 -> hderef h9 | _ -> (Nil : Val list)) in
  if exc_kw_has given9 "highlight" then given9
  else list_append given9 (Cons (VSym "highlight", Cons (VBool hl, Nil)))
and exc_kw_has = fn (xs: Val list) -> fn (n9: str) ->
  match xs with
  | Cons (k9, Cons (_, t9)) ->
    (match k9 with VSym s9 -> str_eq s9 n9 | _ -> false) || exc_kw_has t9 n9
  | _ -> false
and exc_cause_bt = fn world -> fn (recv: Val) ->
  match recv with
  | VObj id9 ->
    (let (_, _, _, iv9) = world in
     if map_has iv9 (str_of_int id9 ++ "@__cause_bt") then map_get iv9 (str_of_int id9 ++ "@__cause_bt") else VNil)
  | _ -> VNil
and rev_app_str = fn (xs: (Val * Val) list) -> fn (acc: (Val * Val) list) ->
  match xs with Nil -> acc | Cons (h9, t9) -> rev_app_str t9 (Cons (h9, acc))
and kw_flag = fn (args: Val list) -> fn (k9: str) -> fn (dflt9: bool) ->
  match args with
  | Cons (VHsh h9, _) ->
    (if hash_haskey (hderef h9) (VSym k9)
     then (match hash_get (hderef h9) (VSym k9) with VNil -> false | VBool b9 -> b9 | _ -> true)
     else dflt9)
  | _ -> dflt9
and kw_sym = fn (args: Val list) -> fn (k9: str) -> fn (dflt9: str) ->
  match args with
  | Cons (VHsh h9, _) ->
    (if hash_haskey (hderef h9) (VSym k9)
     then (match hash_get (hderef h9) (VSym k9) with VSym s9 -> s9 | VStr t9 -> sget t9 | _ -> dflt9)
     else dflt9)
  | _ -> dflt9
and bt_strs_of = fn (xs: Val list) ->
  match xs with
  | Nil -> (Nil : str list)
  | Cons (v9, t9) -> Cons ((match v9 with VStr h9 -> sget h9 | _ -> to_s v9), bt_strs_of t9)
and bt_from_lines = fn (xs: str list) ->
  match xs with Nil -> "" | Cons (h9, t9) -> "\tfrom " ++ h9 ++ "\n" ++ bt_from_lines t9
and bt_from_lines_rev = fn (xs: str list) -> fn (n9: int) ->
  match xs with
  | Nil -> ""
  | Cons (h9, t9) -> bt_from_lines_rev t9 (n9 + 1) ++ "\t" ++ str_of_int n9 ++ ": from " ++ h9 ++ "\n"
and for_recv_msg = fn (d: str) ->
  if str_eq d "NilClass" then "nil"
  else if str_eq d "TrueClass" then "true"
  else if str_eq d "FalseClass" then "false"
  else "an instance of " ++ d
and obj_print_cls = fn world -> fn (c: str) ->
  let (_, sup9, _, _) = world in
  if is_sng_cls c then (if map_has sup9 c then map_get sup9 c else "Object") else c
and for_recv_name = fn (v: Val) -> for_recv_msg (class_name v)
// how a `super` that ran out of chain names the receiver. ruby says "for an
// instance of C" for an object, "for class B" for a class (the singleton
// case) and "for nil" / "for true" / "for false" for the three singletons --
// and the message had NONE of it, at all five sites that raise it.
and super_missing_msg = fn (meth: str) -> fn (recv: Val) ->
  "super: no superclass method '" ++ meth ++ "' for "
  ++ (match recv with
      | VClass c9 -> "class " ++ c9
      | VMain -> "main"
      | _ -> for_recv_name recv)
and meth_base = fn (nm: str) ->
  meth_base_go nm 0 0
and meth_base_go = fn (nm: str) -> fn (i: int) -> fn (start: int) ->
  if i >= str_len nm then substring nm start (str_len nm)
  else if str_eq (char_at nm i) "#" then meth_base_go nm (i + 1) (i + 1)
  else meth_base_go nm (i + 1) start
and always_private_meth = fn (name: str) ->
  (str_len name == 10 && str_eq name "initialize") || (str_len name == 15 && str_eq name "initialize_copy") ||
  (str_len name == 16 && str_eq name "initialize_clone") || (str_len name == 14 && str_eq name "initialize_dup") ||
  (str_len name == 19 && str_eq name "respond_to_missing?")
and owns_initialize = fn (c: str) ->
  // The registered classes that DEFINE their own #initialize, so
  // `private_instance_methods(false)` lists it for them. Every other class --
  // including every user class and every module -- inherits BasicObject's and
  // owns nothing, which `(false)` must not report. Asked of the pinned
  // reference over the whole reg_class_list; regenerate it the same way if the
  // list grows.
  (str_len c == 5 && str_eq c "Array")
  || (str_len c == 11 && str_eq c "BasicObject")
  || (str_len c == 5 && str_eq c "Class")
  || (str_len c == 4 && str_eq c "Data")
  || (str_len c == 3 && str_eq c "Dir")
  || (str_len c == 10 && str_eq c "Enumerator")
  // ...and two that reg_class_list does not carry, asked of the reference
  // by name (their #initialize is enum_init)
  || (str_len c == 16 && str_eq c "Enumerator::Lazy")
  || (str_len c == 17 && str_eq c "Enumerator::Chain")
  || (str_len c == 9 && str_eq c "Exception")
  || (str_len c == 5 && str_eq c "Fiber")
  || (str_len c == 4 && str_eq c "File")
  || (str_len c == 11 && str_eq c "FrozenError")
  || (str_len c == 4 && str_eq c "Hash")
  || (str_len c == 2 && str_eq c "IO")
  || (str_len c == 9 && str_eq c "Interrupt")
  || (str_len c == 8 && str_eq c "KeyError")
  || (str_len c == 6 && str_eq c "Module")
  || (str_len c == 5 && str_eq c "Mutex")
  || (str_len c == 9 && str_eq c "NameError")
  || (str_len c == 25 && str_eq c "NoMatchingPatternKeyError")
  || (str_len c == 13 && str_eq c "NoMethodError")
  || (str_len c == 5 && str_eq c "Range")
  || (str_len c == 6 && str_eq c "Regexp")
  || (str_len c == 15 && str_eq c "SignalException")
  || (str_len c == 6 && str_eq c "String")
  || (str_len c == 6 && str_eq c "Struct")
  || (str_len c == 11 && str_eq c "SyntaxError")
  || (str_len c == 15 && str_eq c "SystemCallError")
  || (str_len c == 10 && str_eq c "SystemExit")
  || (str_len c == 6 && str_eq c "Thread")
  || (str_len c == 4 && str_eq c "Time")
  || (str_len c == 18 && str_eq c "UncaughtThrowError")
and activate_refinements = fn (refinery: str) -> fn (i: int) -> fn (n: int) ->
  if i >= n then ()
  else
    let key = refinery ++ "#" ++ str_of_int i in
    let tgt = (match map_get refine_tgt key with VStr h -> sget h | _ -> "") in
    let impl_cls = map_get refine_cls key in
    let _ = if str_eq tgt "" then () else map_set ref_active tgt impl_cls in
    activate_refinements refinery (i + 1) n
and restore_ref_active = fn saved ->
  let cur = map_new () in
  let _ = map_iter ref_active (fn (k: str) -> fn (v: Val) -> map_set cur k v) in
  let _ = map_iter cur (fn (k: str) -> fn (v: Val) -> if map_has ref_active k then map_delete ref_active k else ()) in
  let _ = map_iter saved (fn (k: str) -> fn (v: Val) -> map_set ref_active k v) in
  ()
and errno_names_str = fn (ns: str list) ->
  (match ns with Nil -> "" | Cons (n, t) -> " " ++ n ++ errno_names_str t)
and reg_class_list = fn (ns: str list) ->
  match ns with Nil -> () | Cons (n, t) -> let _ = if map_has consts n then () else map_set consts n (VClass n) in reg_class_list t
and reg_mod_list = fn (ns: str list) ->
  match ns with Nil -> () | Cons (n, t) -> let _ = (if map_has consts n then () else map_set consts n (VClass n)) in let _ = map_set modules n VNil in reg_mod_list t
and body_targets = fn (body: Stmt list) ->
  match body with
  | Nil -> Nil
  | Cons (s, rest) ->
    (match s with
     | SAssign (n, _) -> Cons (n, body_targets rest)
     | SLocalFrom (n, _) -> Cons (n, body_targets rest)
     | SMultiAssign (ts, _) -> list_append_str ts (body_targets rest)
     | SMultiAssignX (ts, _) -> list_append_str (x_target_names ts) (body_targets rest)
     | _ -> body_targets rest)
and declare_clause_targets = fn env -> fn clauses ->
  match clauses with
  | Nil -> ()
  | Cons (cl, rest) ->
    let (c, b) = cl in
    let _ = declare_nils env (body_targets b) in
    declare_clause_targets env rest
and declare_nils = fn env -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n0, rest) ->
    let n = if str_len n0 > 0 && str_eq (char_at n0 0) "*" then substring n0 1 (str_len n0) else n0 in
    let skip = str_len n == 0 || str_eq (char_at n 0) "@" || str_eq (char_at n 0) "$" || is_upper_first n in
    let _ = if skip then () else if lv_has env n then () else lv_set env n VNil in
    declare_nils env rest
and modfunc_promote = fn world -> fn (cls: str) -> fn (names: str list) ->
  let (meths, sup, ocls, ivars) = world in
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let src = cls ++ "#" ++ n in
    let dst = "(sng:" ++ cls ++ ")#" ++ n in
    let _ = if map_has meths src then set_meth meths dst (map_get meths src) else () in
    // ... and with it the LEXICAL SCOPE the method was written in. Without this
    // the copy resolved bare constants from the top level, so a module_function
    // could not see a constant of its own module: bundler's GemHelpers has
    // `module_function :platform_specificity_match`, whose body names
    // PlatformMatch, defined further down the same module. (alias_method copies
    // meth_cref for the same reason.)
    let _ = if map_has meth_cref src then map_set meth_cref dst (map_get meth_cref src) else () in
    // module_function does TWO things, and only the copy was here: the
    // INSTANCE method also becomes private. `module_function :m` on a module
    // that something includes must not give the includer a public `m` --
    // that is the whole point of the pair (Kernel#puts is reachable as
    // Kernel.puts and as a private method of every object, not a public one).
    let _ = if map_has meths src then map_set privates src VNil else () in
    modfunc_promote world cls rest
and vis_arg_names = fn (args: Val list) ->
  match args with
  | Nil -> (Nil : str list)
  | Cons (VSym s, t) -> Cons (s, vis_arg_names t)
  | Cons (VStr h, t) -> Cons (sget h, vis_arg_names t)
  // ...and an ARRAY of names, which `private attr_accessor(:a, :b)` hands over
  // (attr_* answer the symbols they defined) and ruby accepts.
  | Cons (VArr id9, t) -> sappend (vis_arg_names (deref id9)) (vis_arg_names t)
  | Cons (_, t) -> vis_arg_names t
and mark_private_consts = fn (cls: str) -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let _ = map_set private_consts (cls ++ "::" ++ n) VNil in
    mark_private_consts cls rest
and mark_vis_mode = fn meths -> fn (cls: str) -> fn (names: str list) -> fn (mode: str) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let key = cls ++ "#" ++ n in
    // visibility is ONE state, not two independent flags: `protected :m` after
    // a bare `private` has to clear the private mark (rubocop-ast writes
    // `protected :cur_index, :compile_terms, :sync` in a private section, then
    // calls them on a sibling instance).
    let _ = (let _ = if map_has privates key then map_delete privates key else () in
             let _ = if map_has protecteds key then map_delete protecteds key else () in
             let _ = map_set vis_marks key VNil in
             if str_eq mode "private" then let _ = map_set privates key VNil in ()
             else if str_eq mode "protected" then let _ = map_set protecteds key VNil in ()
             else ()) in
    mark_vis_mode meths cls rest mode
and mark_vis = fn meths -> fn (cls: str) -> fn (names: str list) -> fn (priv: bool) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let key = cls ++ "#" ++ n in
    let _ = if priv then map_set privates key VNil
            else if map_has privates key then map_delete privates key else () in
    mark_vis meths cls rest priv
and undef_top = fn meths -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) -> let _ = if map_has meths n then del_meth meths n else () in undef_top meths rest
and builtin_anc_has = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if str_eq cls "" then false
  else if builtin_has_meth cls name then true
  else if map_has sup cls then builtin_anc_has world (map_get sup cls) name
  else false
and is_private_object_method = fn (n: str) -> str_eq n "respond_to_missing?"
and undef_all = fn meths -> fn (cls: str) -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let _ = if map_has meths (cls ++ "#" ++ n) then del_meth meths (cls ++ "#" ++ n) else () in
    let _ = if map_has builtin_alias (cls ++ "#" ++ n) then map_delete builtin_alias (cls ++ "#" ++ n) else () in
    // a tombstone blocks the method from being reached via inheritance.
    let _ = set_undef (cls ++ "#" ++ n) in
    undef_all meths cls rest
and add_attrs = fn world -> fn (cls: str) -> fn (mode: str) -> fn (syms: str list) ->
  let (meths, sup, ocls, ivars) = world in
  match syms with
  | Nil -> ()
  | Cons (name, rest) ->
    let _ =
      if str_eq mode "r" || str_eq mode "rw" then
        set_meth meths (cls ++ "#" ++ name)
          (Meth (Nil, Nil, Cons (SReturn (EIVar name), Nil)))
      else () in
    let _ =
      if str_eq mode "w" || str_eq mode "rw" then
        set_meth meths (cls ++ "#" ++ name ++ "=")
          // the parameter is nameless in ruby (the writer is C-defined), and
          // `parameters` reports it that way: [[:req]].
          (Meth (Cons ("__attr_v", Nil), Nil,
                 Cons (SIVarAssign (name, EVar "__attr_v"), Cons (SReturn (EVar "__attr_v"), Nil))))
      else () in
    add_attrs world cls mode rest
and run_post = fn env -> fn world -> fn blk -> fn (prog: Stmt list) ->
  match prog with
  | Nil -> ()
  | Cons (_, rest) -> run_post env world blk rest
and filter_mid = fn (prog: Stmt list) ->
  match prog with
  | Nil -> Nil
  | Cons (SPreexe _, rest) -> filter_mid rest
  | Cons (s, rest) -> Cons (s, filter_mid rest)
and feature_loaded = fn (full: str) ->
  (match (if map_has globals (gvar_slot "LOADED_FEATURES") then map_get globals (gvar_slot "LOADED_FEATURES") else VNil) with
   | VArr lfid -> val_strs_have (deref lfid) full
   | _ -> false)
and val_strs_have = fn (xs: Val list) -> fn (t: str) ->
  match xs with
  | Nil -> false
  | Cons (VStr h9, r9) -> (if str_eq (sget h9) t then true else val_strs_have r9 t)
  | Cons (_, r9) -> val_strs_have r9 t
and vals_without = fn (xs: Val list) -> fn (s: str) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    (match h with
     | VStr sh -> if str_eq (sget sh) s then vals_without t s else Cons (h, vals_without t s)
     | _ -> Cons (h, vals_without t s))
and is_pseudo_var_name = fn (n: str) ->
  (str_len n >= 8 && str_eq (substring n 0 8) "__FILE__")
  || (str_len n >= 8 && str_eq (substring n 0 8) "__LINE__")
  || (str_len n >= 12 && str_eq (substring n 0 12) "__ENCODING__")
and pseudo_var_assign = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SAssign (n, _) -> is_pseudo_var_name n || pseudo_var_assign rest
     | SDef (_, _, _, b) -> pseudo_var_assign b || pseudo_var_assign rest
     | SClass (_, _, b) -> pseudo_var_assign b || pseudo_var_assign rest
     | SClassE (_, _, b) -> pseudo_var_assign b || pseudo_var_assign rest
     | _ -> pseudo_var_assign rest)
and dyn_const_in_defs = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SDef (_, _, _, b) -> const_assign_here b || dyn_const_in_defs rest
     | SClass (_, _, b) -> dyn_const_in_defs b || dyn_const_in_defs rest
     | SClassE (_, _, b) -> dyn_const_in_defs b || dyn_const_in_defs rest
     | _ -> dyn_const_in_defs rest)
and const_assign_here = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SAssign (n, _) -> is_upper_first n || const_assign_here rest
     // a nested class or module body inside the def is its own scope, and a
     // nested def is another method: neither is this method's body.
     | SClass (_, _, _) -> const_assign_here rest
     | SClassE (_, _, _) -> const_assign_here rest
     | SDef (_, _, _, _) -> const_assign_here rest
     | _ -> const_assign_here rest)
and invalid_flow_in_defs = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SDef (_, _, _, b) -> direct_invalid_flow b || invalid_flow_in_defs rest
     | SClass (_, _, b) -> direct_invalid_flow b || invalid_flow_in_defs rest
     | SClassE (_, _, b) -> direct_invalid_flow b || invalid_flow_in_defs rest
     | _ -> invalid_flow_in_defs rest)
and ends_in_return = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, Nil) -> (match st with SReturn _ -> true | _ -> false)
  | Cons (_, rest) -> ends_in_return rest
and all_branches_return = fn clauses ->
  match clauses with
  | Nil -> true
  | Cons ((_, b), rest) -> ends_in_return b && all_branches_return rest
and has_void_assign = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SLocalFrom (_, s2) ->
       (match s2 with
        | SIf (clauses, els) ->
          (match els with
           | Nil -> has_void_assign rest
           | _ -> (all_branches_return clauses && ends_in_return els) || has_void_assign rest)
        | _ -> has_void_assign rest)
     | SDef (_, _, _, b) -> has_void_assign b || has_void_assign rest
     | SClass (_, _, b) -> has_void_assign b || has_void_assign rest
     | SClassE (_, _, b) -> has_void_assign b || has_void_assign rest
     | _ -> has_void_assign rest)
and direct_invalid_flow = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SExpr e ->
       (match e with
        | EFlow (k, _) -> str_eq k "retry" || str_eq k "redo"
        | _ -> false) || direct_invalid_flow rest
     // next / break / redo directly in a method body (not in a loop or
     // block) are a SyntaxError, like retry.
     | SNext _ -> true
     | SBreak _ -> true
     | _ -> direct_invalid_flow rest)
and drop_file_marks = fn (xs: Stmt list) ->
  match xs with
  | Nil -> Nil
  | Cons (SFile _, t) -> drop_file_marks t
  | Cons (h, t) -> Cons (h, drop_file_marks t)
and flow_throw = fn (kind: str) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr kind) in
  let _ = map_set flow_sig "v" v in
  // name the kind: an escaped break / next / return / throw that nothing
  // caught is otherwise indistinguishable at the top level.
  (let m = "mere-ruby: (unhandled " ++ kind ++ ")" in
   let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)
and flow_rethrow_tagged = fn (kind: str) -> fn (tag: Val) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr kind) in
  let _ = map_set flow_sig "tag" tag in
  let _ = map_set flow_sig "v" v in
  (let m = "mere-ruby: (unhandled " ++ kind ++ ", tagged)" in
   let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)
and catch_tag_active = fn (t: Val) -> fn (d: int) ->
  if d <= 0 then false
  else if map_has catch_depth ("t" ++ str_of_int d) && rb_identical (map_get catch_depth ("t" ++ str_of_int d)) t then true
  else catch_tag_active t (d - 1)
and flow_rethrow = fn (k: str) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr k) in
  let _ = map_set flow_sig "v" v in
  (let m = "mere-ruby: (unhandled " ++ k ++ ")" in
   let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)
and flow_throw_breakret = fn (fid: int) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr "breakret") in
  let _ = map_set flow_sig "fid" (VInt fid) in
  let _ = map_set flow_sig "v" v in
  (let m = "mere-ruby: (unhandled break out of a block)" in
   let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)
and flow_throw_returnret = fn (fid: int) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr "returnret") in
  let _ = map_set flow_sig "fid" (VInt fid) in
  let _ = map_set flow_sig "v" v in
  (let m = "mere-ruby: (unhandled return out of a block)" in
   let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)
and when_any_eq = fn (v: Val) -> fn (xs: Val list) ->
  match xs with Nil -> false | Cons (h, t) -> rb_eq h v || when_any_eq v t
and ref_impl = fn (target: str) ->
  if map_has ref_active target then (match map_get ref_active target with VStr h -> sget h | _ -> "") else ""
and count_splats = fn (ps: Pat list) ->
  match ps with Nil -> 0 | Cons (p, r) -> (match p with PSplatP _ -> 1 | _ -> 0) + count_splats r
and pat_list_len = fn (ps: Pat list) ->
  match ps with Nil -> 0 | Cons (_, r) -> 1 + pat_list_len r
and split_at_splat = fn (elems: Pat list) -> fn (pre: Pat list) ->
  match elems with
  | Nil -> (rev_pats pre, "", (Nil : Pat list))
  | Cons (p, r) ->
    (match p with
     | PSplatP nm -> (rev_pats pre, nm, r)
     | _ -> split_at_splat r (Cons (p, pre)))
and rev_pats = fn (ps: Pat list) -> rev_pats_go ps (Nil : Pat list)
and rev_pats_go = fn (ps: Pat list) -> fn (acc: Pat list) ->
  match ps with Nil -> acc | Cons (p, r) -> rev_pats_go r (Cons (p, acc))
and splat_name_of = fn (p: Pat) -> match p with PSplatP nm -> nm | _ -> ""
and pat_head = fn (ps: Pat list) -> match ps with Cons (p, _) -> p | Nil -> PSplatP ""
and pat_last = fn (ps: Pat list) -> match ps with Nil -> PSplatP "" | Cons (p, Nil) -> p | Cons (_, r) -> pat_last r
and pat_middle = fn (ps: Pat list) ->
  match ps with
  | Nil -> Nil
  | Cons (_, r) -> pat_drop_last r
and pat_drop_last = fn (ps: Pat list) ->
  match ps with
  | Nil -> Nil
  | Cons (_, Nil) -> Nil
  | Cons (p, r) -> Cons (p, pat_drop_last r)
and val_take = fn (xs: Val list) -> fn (k: int) ->
  if k <= 0 then (Nil : Val list)
  else (match xs with Nil -> Nil | Cons (h, t) -> Cons (h, val_take t (k - 1)))
and val_drop = fn (xs: Val list) -> fn (k: int) ->
  if k <= 0 then xs
  else (match xs with Nil -> Nil | Cons (_, t) -> val_drop t (k - 1))
and val_slice = fn (xs: Val list) -> fn (lo: int) -> fn (hi: int) ->
  val_take (val_drop xs lo) (hi - lo)
and hash_key_syms = fn (items: (str * Pat) list) ->
  match items with Nil -> Nil | Cons (kp, r) -> let (k, _) = kp in Cons (VSym k, hash_key_syms r)
and hash_lookup = fn (pairs: Val list) -> fn (target: Val) ->
  match pairs with
  | Nil -> (false, VNil)
  | Cons (k, Cons (v, rest)) -> if rb_eq k target then (true, v) else hash_lookup rest target
  | _ -> (false, VNil)
and hash_only_keys = fn (pairs: Val list) -> fn (items: (str * Pat) list) ->
  match pairs with
  | Nil -> true
  | Cons (k, Cons (_, rest)) -> if item_has_key items k then hash_only_keys rest items else false
  | _ -> true
and item_has_key = fn (items: (str * Pat) list) -> fn (k: Val) ->
  match items with Nil -> false | Cons (kp, r) -> let (nm, _) = kp in (rb_eq (VSym nm) k) || item_has_key r k
and hash_without = fn (pairs: Val list) -> fn (items: (str * Pat) list) ->
  mkhash (hash_without_go pairs items)
and hash_without_go = fn (pairs: Val list) -> fn (items: (str * Pat) list) ->
  match pairs with
  | Cons (k, Cons (v, rest)) -> if item_has_key items k then hash_without_go rest items else Cons (k, Cons (v, hash_without_go rest items))
  | _ -> Nil
and rxp_skip_x = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c " " || str_eq c "\t" || str_eq c "\n" then rxp_skip_x pat (p + 1)
    else if str_eq c "#" then rxp_skip_x pat (rxp_line_end pat p)
    else p
and rxp_line_end = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else if str_eq (char_at pat p) "\n" then p + 1
  else rxp_line_end pat (p + 1)
and rxp_quant = fn (pat: str) -> fn (atom: RNode) -> fn (p: int) -> fn (fl: str) ->
  // x-mode: a quantifier may be separated from its atom by whitespace.
  let p = (if str_contains fl "x" then rxp_skip_x pat p else p) in
  if p >= str_len pat then (atom, p)
  else
    let c = char_at pat p in
    if str_eq c "*" then (let (n2, p2) = rxp_lazy pat atom 0 (0 - 1) (p + 1) fl in rxp_quant pat n2 p2 fl)
    else if str_eq c "+" then (let (n2, p2) = rxp_lazy pat atom 1 (0 - 1) (p + 1) fl in rxp_quant pat n2 p2 fl)
    else if str_eq c "?" then (let (n2, p2) = rxp_lazy pat atom 0 1 (p + 1) fl in rxp_quant pat n2 p2 fl)
    else if str_eq c "\{" then
      (let (found, lo, hi, p2) = rxp_braces pat (p + 1) in
       if found then
         // ⚠ an INTERVAL takes `?` as lazy but NOT `+` as possessive: Onigmo
         //   reads `A{0,1}+` as a repeat of the repeat ((?:A{0,1})+), so the
         //   `+` is left for the next round of rxp_quant
         (if lo == hi then rxp_quant pat (NRep (atom, lo, hi, true)) p2 fl
          else if p2 < str_len pat && str_eq (char_at pat p2) "?" then rxp_quant pat (NRep (atom, lo, hi, false)) (p2 + 1) fl
          else rxp_quant pat (NRep (atom, lo, hi, true)) p2 fl)
       else (atom, p))
    else (atom, p)
and rxp_lazy = fn (pat: str) -> fn (atom: RNode) -> fn (lo: int) -> fn (hi: int) -> fn (p: int) -> fn (fl: str) ->
  let p = (if str_contains fl "x" then rxp_skip_x pat p else p) in
  if p < str_len pat && str_eq (char_at pat p) "?" then (NRep (atom, lo, hi, false), p + 1)
  // a POSSESSIVE quantifier is the greedy one wrapped in an atomic group:
  // `a*+` is exactly `(?>a*)`, which this engine already has. Reading it as
  // plain greedy (the old lenient path) was wrong -- greedy gives back what it
  // took, possessive does not, and ruby's RFC3986 URI pattern depends on it.
  else if p < str_len pat && str_eq (char_at pat p) "+" then
    (NAtomic (NRep (atom, lo, hi, true)), p + 1)
  else (NRep (atom, lo, hi, true), p)
and rxp_braces = fn (pat: str) -> fn (p: int) ->
  let (lo, p2, ok1) = rxp_num pat p 0 false in
  if p2 < str_len pat && str_eq (char_at pat p2) "," then
    (let (hi, p3, ok2) = rxp_num pat (p2 + 1) 0 false in
     if p3 < str_len pat && str_eq (char_at pat p3) "}" && (ok1 || ok2) then
       (let lo2 = (if ok1 then lo else 0) in
        let hi2 = (if ok2 then hi else (0 - 1)) in
        let _ = (if (lo2 > 1000 || hi2 > 1000) && (if map_has rx_lenient "n" then false else true) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: quantifier too large")) in fail "mere-ruby: regexp: quantifier too large") else ()) in
        let _ = (if ok2 && lo2 > hi2 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: bad repeat range")) in fail "mere-ruby: regexp: bad repeat range") else ()) in
        (true, lo2, hi2, p3 + 1))
     else (false, 0, 0, p))
  else if p2 < str_len pat && str_eq (char_at pat p2) "}" && ok1 then
    (let _ = (if lo > 1000 && (if map_has rx_lenient "n" then false else true) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: quantifier too large")) in fail "mere-ruby: regexp: quantifier too large") else ()) in
     (true, lo, lo, p2 + 1))
  else (false, 0, 0, p)
and rxp_num = fn (pat: str) -> fn (p: int) -> fn (acc: int) -> fn (found: bool) ->
  if p < str_len pat && char_at pat p >= "0" && char_at pat p <= "9" then
    rxp_num pat (p + 1) (acc * 10 + int_of_str (char_at pat p)) true
  else (acc, p, found)
and rxp_ord = fn (c: str) -> rxp_ord_go c 0
and rxp_ord_go = fn (c: str) -> fn (n: int) ->
  if n > 255 then 0 else if str_eq (chr n) c then n else rxp_ord_go c (n + 1)
and rxp_oct = fn (pat: str) -> fn (p: int) -> fn (g: int) -> fn (acc: int) -> fn (k: int) ->
  if k > 0 && p < str_len pat && char_at pat p >= "0" && char_at pat p <= "7" then
    rxp_oct pat (p + 1) g (acc * 8 + int_of_str (char_at pat p)) (k - 1)
  else (NChar (chr acc), p, g)
and rxp_hex4 = fn (pat: str) -> fn (p: int) ->
  rxp_hexv (char_at pat p) * 4096 + rxp_hexv (char_at pat (p + 1)) * 256
  + rxp_hexv (char_at pat (p + 2)) * 16 + rxp_hexv (char_at pat (p + 3))
and rxp_u_bytes = fn (bs: str) -> fn (i: int) ->
  if i >= str_len bs then Nil else Cons (NChar (char_at bs i), rxp_u_bytes bs (i + 1))
and rxp_u_cps = fn (xs: str list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    (if str_eq h "" then rxp_u_cps t
     else list_append_node (rxp_u_bytes (utf8_enc (str_to_int_base h 16)) 0) (rxp_u_cps t))
and list_append_node = fn (a: RNode list) -> fn (b: RNode list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, list_append_node t b)
and rxp_hexv = fn (c: str) ->
  if (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F") then str_to_int_base c 16
  else 0 - 1
and rxp_hex = fn (pat: str) -> fn (p: int) -> fn (g: int) ->
  if p >= str_len pat || rxp_hexv (char_at pat p) < 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: invalid hex escape")) in fail "mere-ruby: regexp: invalid hex escape")
  else
    let h1 = rxp_hexv (char_at pat p) in
    if p + 1 < str_len pat && rxp_hexv (char_at pat (p + 1)) >= 0 then
      (NChar (chr (h1 * 16 + rxp_hexv (char_at pat (p + 1)))), p + 2, g)
    else (NChar (chr h1), p + 1, g)
and rxp_flags = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (seen: str) -> fn (neg: bool) ->
  if p >= str_len pat then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unterminated (?flags")) in fail "mere-ruby: regexp: unterminated (?flags")
  else
    let c = char_at pat p in
    if str_eq c ":" then (fl, p + 1, true)
    else if str_eq c ")" then (fl, p + 1, false)
    else if str_eq c "-" then (if neg then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: bad flags")) in fail "mere-ruby: regexp: bad flags") else rxp_flags pat (p + 1) fl seen true)
    else if str_eq c "i" || str_eq c "m" || str_eq c "x" then
      (let fl2 = (if neg then rxp_flag_del fl c else (if str_contains fl c then fl else fl ++ c)) in
       rxp_flags pat (p + 1) fl2 (seen ++ c) neg)
    // a/d/u (char-class semantics selectors) are accepted and ignored.
    else if str_eq c "a" || str_eq c "d" || str_eq c "u" then rxp_flags pat (p + 1) fl seen neg
    else if map_has rx_lenient "n" then rxp_flags pat (p + 1) fl seen neg
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unknown inline flag")) in fail "mere-ruby: regexp: unknown inline flag")
and rxp_flag_del = fn (fl: str) -> fn (c: str) ->
  rxp_flag_del_go fl c 0 ""
and rxp_flag_del_go = fn (fl: str) -> fn (c: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len fl then acc
  else if str_eq (char_at fl i) c then rxp_flag_del_go fl c (i + 1) acc
  else rxp_flag_del_go fl c (i + 1) (acc ++ char_at fl i)
and rxp_close = fn (pat: str) -> fn (p: int) ->
  if p < str_len pat && str_eq (char_at pat p) ")" then p + 1
  else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unmatched (")) in fail "mere-ruby: regexp: unmatched (")
and rxp_skip_group = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unmatched (")) in fail "mere-ruby: regexp: unmatched (")
  else
    let c = char_at pat p in
    if str_eq c "\\" then rxp_skip_group pat (p + 2) depth
    else if str_eq c "[" then rxp_skip_group pat (rxp_skip_class pat (p + 1)) depth
    else if str_eq c "(" then rxp_skip_group pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth == 1 then p + 1 else rxp_skip_group pat (p + 1) (depth - 1))
    else rxp_skip_group pat (p + 1) depth
and rxp_skip_class = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: premature end of char-class")) in fail "mere-ruby: regexp: premature end of char-class")
  else
    let c = char_at pat p in
    if str_eq c "\\" then rxp_skip_class pat (p + 2)
    else if str_eq c "]" then p + 1
    else rxp_skip_class pat (p + 1)
and rxp_name_check = fn (nm: str) ->
  if str_len nm == 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp parse: empty group name")) in fail "mere-ruby: regexp parse: empty group name")
  else
    let c = char_at nm 0 in
    if (c >= "0" && c <= "9") || str_eq c "-" then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp parse: bad group name")) in fail "mere-ruby: regexp parse: bad group name")
    else ()
and lex_innermost = fn (lx: str) ->
  let i = str_rindex_go lx "::" (str_len lx - 2) in
  if i < 0 then lx else substring lx (i + 2) (str_len lx)
and rx_pending_sync = fn (u: unit) ->
  map_set rx_pending "done"
    (if map_has rx_pending "n" then map_get rx_pending "n" else VInt 0)
and rx_key_nl = fn (k: str) -> fn (i: int) ->
  if i >= str_len k then i
  else if str_eq (char_at k i) "\n" then i
  else rx_key_nl k (i + 1)
and rxp_name = fn (pat: str) -> fn (p: int) -> fn (term: str) -> fn (acc: str) ->
  if p >= str_len pat then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unterminated group name")) in fail "mere-ruby: regexp: unterminated group name")
  else if str_eq (char_at pat p) term then (acc, p + 1)
  else rxp_name pat (p + 1) term (acc ++ char_at pat p)
and rxp_class = fn (pat: str) -> fn (p: int) ->
  let (neg, p2) = (if p < str_len pat && str_eq (char_at pat p) "^" then (true, p + 1) else (false, p)) in
  rxp_class_items pat p2 neg Nil true
and rxp_class_items = fn (pat: str) -> fn (p: int) -> fn (neg: bool) -> fn (acc: RCls list) -> fn (first: bool) ->
  if p >= str_len pat then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: premature end of char-class")) in fail "mere-ruby: regexp: premature end of char-class")
  else
    let c = char_at pat p in
    if str_eq c "]" && (if first then false else true) then (rev_app acc Nil, neg, p + 1)
    else if str_eq c "[" && p + 1 < str_len pat && str_eq (char_at pat (p + 1)) ":" then
      (let (nm, negp, p2) = rxp_posix pat (p + 2) in
       rxp_class_items pat p2 neg (Cons (CPosix (nm, negp), acc)) false)
    else if str_eq c "[" && p + 1 < str_len pat && str_eq (char_at pat (p + 1)) "]" then
      // "[]" — a literal '[' then closing... treat '[' as a literal member.
      rxp_class_items pat (p + 1) neg (Cons (CChr "[", acc)) false
    else
      let (lo, p2) = rxp_class_atom pat p in
      (match lo with
       | CChr ch ->
         if p2 + 1 <= str_len pat && p2 < str_len pat && str_eq (char_at pat p2) "-"
            && p2 + 1 < str_len pat && (if str_eq (char_at pat (p2 + 1)) "]" then false else true) then
           (let (hi, p3) = rxp_class_atom pat (p2 + 1) in
            match hi with
            | CChr ch2 -> rxp_class_items pat p3 neg (Cons (CRange (ch, ch2), acc)) false
            | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: bad class range")) in fail "mere-ruby: regexp: bad class range"))
         else rxp_class_items pat p2 neg (Cons (lo, acc)) false
       | _ -> rxp_class_items pat p2 neg (Cons (lo, acc)) false)
and rxp_class_atom = fn (pat: str) -> fn (p: int) ->
  let c = char_at pat p in
  if str_eq c "\\" && p + 1 < str_len pat then
    (let e = char_at pat (p + 1) in
     if str_eq e "d" then (CDigit, p + 2) else if str_eq e "D" then (CNDigit, p + 2)
     else if str_eq e "w" then (CWord, p + 2) else if str_eq e "W" then (CNWord, p + 2)
     else if str_eq e "s" then (CSpace, p + 2) else if str_eq e "S" then (CNSpace, p + 2)
     else if str_eq e "h" then (CHex, p + 2) else if str_eq e "H" then (CNHex, p + 2)
     else if str_eq e "n" then (CChr "\n", p + 2) else if str_eq e "t" then (CChr "\t", p + 2)
     else if str_eq e "r" then (CChr "\r", p + 2)
     else if str_eq e "f" then (CChr (chr 12), p + 2) else if str_eq e "v" then (CChr (chr 11), p + 2)
     else if str_eq e "e" then (CChr (chr 27), p + 2) else if str_eq e "a" then (CChr (chr 7), p + 2)
     else if str_eq e "b" then (CChr (chr 8), p + 2)   // \b inside a class is backspace
     // \uXXXX / \u{X}: one character, as outside a class (`[\u{20}-\u{7e}]`
     // was the letter u and a brace)
     else if str_eq e "u" && p + 2 < str_len pat && str_eq (char_at pat (p + 2)) "\{" then
       (let close = str_find_from pat "}" (p + 3) in
        if close < 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: invalid Unicode list")) in fail "mere-ruby: regexp: invalid Unicode list")
        else (CChr (utf8_enc (str_to_int_base (substring pat (p + 3) close) 16)), close + 1))
     else if str_eq e "u" && p + 5 < str_len pat + 0 && rxp_hexv (char_at pat (p + 2)) >= 0 then
       (CChr (utf8_enc (rxp_hex4 pat (p + 2))), p + 6)
     else if str_eq e "x" then
       (let h1 = rxp_hexv (char_at pat (p + 2)) in
        if h1 < 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: invalid hex escape")) in fail "mere-ruby: regexp: invalid hex escape")
        else if p + 3 < str_len pat && rxp_hexv (char_at pat (p + 3)) >= 0 then
          (CChr (chr (h1 * 16 + rxp_hexv (char_at pat (p + 3)))), p + 4)
        else (CChr (chr h1), p + 3))
     // an OCTAL escape (up to three digits) is one character here too: \000
     // was read as "0" then "00", so `[\000-\b]` never matched NUL
     else if e >= "0" && e <= "7" then
       (let ov = fn (i: int) -> (if i < str_len pat && char_at pat i >= "0" && char_at pat i <= "7"
                                 then int_of_str (char_at pat i) else 0 - 1) in
        let d1 = ov (p + 1) in
        let d2 = ov (p + 2) in
        if d2 < 0 then (CChr (chr d1), p + 2)
        else (let d3 = ov (p + 3) in
              if d3 < 0 then (CChr (chr (d1 * 8 + d2)), p + 3)
              else (CChr (chr ((d1 * 64 + d2 * 8 + d3) - ((d1 * 64 + d2 * 8 + d3) / 256) * 256)), p + 4)))
     else (CChr e, p + 2))
  // A literal in a class is one CHARACTER. As one byte, `[あ-ん]` became a range
  // between two bytes of two different characters, and matching it against a
  // byte of the subject produced "\xE3" -- half a character, and not a string
  // Ruby would ever hand back. Comparing whole UTF-8 characters as strings is
  // the same order as comparing codepoints, so CRange needs nothing else.
  // ... but only when the bytes at p really are one character. utf8_clen trusts
  // the lead byte, so a byte that cannot start a sequence (a continuation byte,
  // or 0xF8+) claimed 2 or 4 bytes and swallowed whatever followed -- including
  // the `]`. excon builds `[#{Regexp.escape((0x80..0xff).map(&:chr).join)}]`,
  // where every member is such a byte: one of them failed to parse, two
  // "worked", three failed again, which is the parity of a swallowed byte.
  else (let l = rxp_clen pat p in (CChr (substring pat p (p + l)), p + l))
and rxp_clen = fn (pat: str) -> fn (p: int) ->
  let n = str_len pat in
  let bt = fn (k: int) -> if k < n then ord (char_at pat k) else 0 in
  let cont = fn (k: int) -> k < n && bt k >= 128 && bt k < 192 in
  let b0 = bt p in
  if b0 < 192 then 1
  else if b0 < 224 then (if cont (p + 1) then 2 else 1)
  else if b0 < 240 then (if cont (p + 1) && cont (p + 2) then 3 else 1)
  else if b0 < 248 then (if cont (p + 1) && cont (p + 2) && cont (p + 3) then 4 else 1)
  else 1
and rxp_posix = fn (pat: str) -> fn (p: int) ->
  let (negp, p2) = (if p < str_len pat && str_eq (char_at pat p) "^" then (true, p + 1) else (false, p)) in
  rxp_posix_name pat p2 negp ""
and rxp_posix_name = fn (pat: str) -> fn (p: int) -> fn (negp: bool) -> fn (acc: str) ->
  if p + 1 < str_len pat && str_eq (char_at pat p) ":" && str_eq (char_at pat (p + 1)) "]" then (acc, negp, p + 2)
  else if p >= str_len pat then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unterminated posix class")) in fail "mere-ruby: regexp: unterminated posix class")
  else rxp_posix_name pat (p + 1) negp (acc ++ char_at pat p)
and rxc_patch = fn prog -> fn (at: int) -> fn (target: int) ->
  match map_get prog at with
  | ISplit (a, b) -> map_set prog at (ISplit ((if a < 0 then target else a), (if b < 0 then target else b)))
  | IJmp _ -> map_set prog at (IJmp target)
  | _ -> ()
and rxc_patch_all = fn prog -> fn (ats: int list) -> fn (target: int) ->
  match ats with Nil -> () | Cons (a, rest) -> let _ = rxc_patch prog a target in rxc_patch_all prog rest target
and rx_named_pairs = fn (tbl: str) -> fn (nms: str list) ->
  match nms with
  | Nil -> Nil
  | Cons (nm, rest) ->
    Cons (mkstr nm,
          Cons (arr_new (md_int_to_vals (md_nums_for (str_split tbl "|") nm)), rx_named_pairs tbl rest))
and md_int_to_vals = fn (xs: int list) ->
  match xs with Nil -> Nil | Cons (h, t) -> Cons (VInt h, md_int_to_vals t)
and meth_params_str = fn (ps: Val list) ->
  match ps with
  | Nil -> ""
  | Cons (h, t) ->
    (let one = (match h with
                | VArr pid ->
                  (match deref pid with
                   | Cons (VSym k, Cons (VSym n, _)) ->
                     (if str_eq k "req" then n
                      else if str_eq k "opt" then n ++ "=..."
                      else if str_eq k "rest" then "*" ++ n
                      else if str_eq k "keyreq" then n ++ ":"
                      else if str_eq k "key" then n ++ ": ..."
                      else if str_eq k "keyrest" then "**" ++ n
                      else if str_eq k "block" then "&" ++ n
                      else n)
                   | Cons (VSym k, _) ->
                     (if str_eq k "rest" then "*" else if str_eq k "keyrest" then "**" else "_")
                   | _ -> "_")
                | _ -> "_") in
     one ++ (match t with Nil -> "" | _ -> ", ") ++ meth_params_str t)
and coerce_str = fn (recv: Val) -> fn (h9: int) ->
  arr_new (Cons (VFlt (rb_flt_parse (sget h9)), Cons (VFlt (to_f recv), Nil)))
and coerce_refuse = fn (o: Val) ->
  match o with
  | VStr h9 -> prim_raise "ArgumentError" ("invalid value for Float(): " ++ inspect (VStr h9))
  | VNil -> prim_raise "TypeError" "can't convert nil into Float"
  | _ -> prim_raise "TypeError" ("can't convert " ++ conv_name o ++ " into Float")
and md_strs_len = fn (xs: str list) ->
  match xs with Nil -> 0 | Cons (_, t) -> 1 + md_strs_len t
and md_first_non_sym = fn (xs: Val list) ->
  match xs with
  | Nil -> ""
  | Cons (VSym _, t) -> md_first_non_sym t
  | Cons (v, _) -> class_name v
and md_sym_names = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VSym s, t) -> Cons (s, md_sym_names t)
  | Cons (VStr h, t) -> Cons (sget h, md_sym_names t)
  | Cons (_, t) -> md_sym_names t
and md_dk_pairs = fn world -> fn ivars -> fn (id: int) -> fn (nms: str list) -> fn (want: str list) ->
  match want with
  | Nil -> Nil
  | Cons (nm, rest) ->
    // ruby stops at the FIRST name the match does not have, so a pattern match
    // fails on the whole clause rather than binding a shorter hash
    (if str_list_has nms nm
     then Cons (VSym nm, Cons (md_by_name world ivars id nm, md_dk_pairs world ivars id nms rest))
     else Nil)
and md_sig = fn ivars -> fn (id: int) ->
  let g = fn (k: str) -> (if map_has ivars (str_of_int id ++ k)
                          then (match map_get ivars (str_of_int id ++ k) with VStr h -> sget h | VInt n -> str_of_int n | _ -> "")
                          else "") in
  g "@__key" ++ chr 1 ++ g "@__src" ++ chr 1 ++ g "@__st" ++ chr 1 ++ g "@__en" ++ chr 1
  ++ md_sig_groups ivars id (md_num_list ivars id)
and md_sig_groups = fn ivars -> fn (id: int) -> fn (ns: int list) ->
  match ns with
  | Nil -> ""
  | Cons (n, t) ->
    (let k1 = str_of_int id ++ "@__st" ++ str_of_int n in
     let k2 = str_of_int id ++ "@__en" ++ str_of_int n in
     (if map_has ivars k1 then (match map_get ivars k1 with VInt a -> str_of_int a | _ -> "") else "-") ++ ":"
     ++ (if map_has ivars k2 then (match map_get ivars k2 with VInt b -> str_of_int b | _ -> "") else "-") ++ ","
     ++ md_sig_groups ivars id t)
and md_find_name_go = fn (items: str list) -> fn (nm: str) ->
  match items with
  | Nil -> (0 - 1)
  | Cons (it, rest) ->
    (let i = str_find_from it "=" 0 in
     if i >= 0 && str_eq (substring it 0 i) nm
     then int_of_str (substring it (i + 1) (str_len it))
     else md_find_name_go rest nm)
and md_by_name = fn world -> fn ivars -> fn (id: int) -> fn (nm: str) ->
  let key = (if map_has ivars (str_of_int id ++ "@__key")
             then (match map_get ivars (str_of_int id ++ "@__key") with VStr h -> sget h | _ -> "") else "") in
  let tbl = (if str_eq key "" then "" else (if map_has rx_prog_names key then (match map_get rx_prog_names key with VStr h -> sget h | _ -> "") else "")) in
  let nums = (if str_eq tbl "" then Nil else md_nums_for (str_split tbl "|") nm) in
  match nums with
  | Nil -> raise_exc world "IndexError" ("undefined group name reference: " ++ nm)
  // the LAST one that participated: `(?<a>x)|(?<a>y)` answers whichever matched
  | _ -> md_last_participating ivars id nums VNil
and md_span_num = fn ivars -> fn (id: int) -> fn (nm: str) ->
  let key = (if map_has ivars (str_of_int id ++ "@__key")
             then (match map_get ivars (str_of_int id ++ "@__key") with VStr h -> sget h | _ -> "") else "") in
  let tbl = (if str_eq key "" then "" else (if map_has rx_prog_names key then (match map_get rx_prog_names key with VStr h -> sget h | _ -> "") else "")) in
  let nums = (if str_eq tbl "" then Nil else md_nums_for (str_split tbl "|") nm) in
  match nums with
  | Nil -> (0 - 2)
  | Cons (first, _) -> md_last_span ivars id nums first
and md_last_span = fn ivars -> fn (id: int) -> fn (ns: int list) -> fn (best: int) ->
  match ns with
  | Nil -> best
  | Cons (k, t) ->
    md_last_span ivars id t (if map_has ivars (str_of_int id ++ "@__st" ++ str_of_int k) then k else best)
and md_last_participating = fn ivars -> fn (id: int) -> fn (ns: int list) -> fn (best: Val) ->
  match ns with
  | Nil -> best
  | Cons (k, t) ->
    md_last_participating ivars id t
      (if map_has ivars (str_of_int id ++ "@" ++ str_of_int k)
       then map_get ivars (str_of_int id ++ "@" ++ str_of_int k) else best)
and md_insp_groups = fn ivars -> fn (id: int) -> fn (i: int) ->
  md_insp_go ivars id (md_num_list ivars id)
and md_insp_go = fn ivars -> fn (id: int) -> fn (ns: int list) ->
  match ns with
  | Nil -> ""
  | Cons (i, rest) ->
    (let v = (if map_has ivars (str_of_int id ++ "@" ++ str_of_int i) then map_get ivars (str_of_int id ++ "@" ++ str_of_int i) else VNil) in
     let key = (if map_has ivars (str_of_int id ++ "@__key")
                then (match map_get ivars (str_of_int id ++ "@__key") with VStr h -> sget h | _ -> "") else "") in
     let nm = (if str_eq key "" || (if map_has rx_prog_names key then false else true) then ""
               else md_name_at (str_split (match map_get rx_prog_names key with VStr h -> sget h | _ -> "") "|") i) in
     " " ++ (if str_eq nm "" then str_of_int i else nm) ++ ":" ++ inspect v
     ++ md_insp_go ivars id rest)
and md_names = fn ivars -> fn (id: int) ->
  let key = (if map_has ivars (str_of_int id ++ "@__key")
             then (match map_get ivars (str_of_int id ++ "@__key") with VStr h -> sget h | _ -> "") else "") in
  if str_eq key "" || (if map_has rx_prog_names key then false else true) then Nil
  else
    (let tbl = (match map_get rx_prog_names key with VStr h -> sget h | _ -> "") in
     if str_eq tbl "" then Nil else md_names_sorted (str_split tbl "|") 1 Nil)
and md_names_sorted = fn (items: str list) -> fn (k: int) -> fn (acc: str list) ->
  if k > 99 then rev_strs acc Nil
  else
    (let hit = md_name_first_at items k in
     if str_eq hit "" then md_names_sorted items (k + 1) acc
     else md_names_sorted items (k + 1) (Cons (hit, acc)))
and md_named_pairs_k = fn world -> fn ivars -> fn (id: int) -> fn (nms: str list) -> fn (symz: bool) ->
  match nms with
  | Nil -> Nil
  | Cons (nm, rest) ->
    Cons ((if symz then VSym nm else mkstr nm),
          Cons (md_by_name world ivars id nm, md_named_pairs_k world ivars id rest symz))
and md_name_at = fn (items: str list) -> fn (k: int) ->
  match items with
  | Nil -> ""
  | Cons (it, rest) ->
    (let i = str_find_from it "=" 0 in
     if i >= 0 && str_list_has (str_split (substring it (i + 1) (str_len it)) ",") (str_of_int k)
     then substring it 0 i else md_name_at rest k)
and md_name_first_at = fn (items: str list) -> fn (k: int) ->
  match items with
  | Nil -> ""
  | Cons (it, rest) ->
    (let i = str_find_from it "=" 0 in
     if i >= 0 && str_eq (md_first_num (substring it (i + 1) (str_len it))) (str_of_int k)
     then substring it 0 i else md_name_first_at rest k)
and md_first_num = fn (lst: str) ->
  (match md_ints_sorted (md_ints_of (str_split lst ",")) Nil with Cons (k, _) -> str_of_int k | Nil -> lst)
// ⚠ IN GROUP ORDER. A name's numbers are recorded as each group CLOSES, so a
//   nested duplicate (`(?<g>h(?<g>.))`) wrote the inner one first: "2,1".
//   "The last group of that name that matched" then meant group 1, and
//   named_captures said {"g" => [2, 1]} where ruby says [1, 2].
and md_nums_for = fn (items: str list) -> fn (nm: str) ->
  match items with
  | Nil -> Nil
  | Cons (it, rest) ->
    (let i = str_find_from it "=" 0 in
     if i >= 0 && str_eq (substring it 0 i) nm
     then md_ints_sorted (md_ints_of (str_split (substring it (i + 1) (str_len it)) ",")) Nil
     else md_nums_for rest nm)
and md_ints_sorted = fn (xs: int list) -> fn (acc: int list) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    (let rec ins = fn (ys: int list) ->
       (match ys with Nil -> Cons (h, Nil) | Cons (y, yt) -> (if h <= y then Cons (h, ys) else Cons (y, ins yt))) in
     md_ints_sorted t (ins acc))
and md_ints_of = fn (xs: str list) ->
  match xs with Nil -> Nil | Cons (h, t) -> Cons (int_of_str h, md_ints_of t)
and rx_names_join = fn (u: unit) ->
  let acc = map_new () in
  // every number, not just the first: `name=1,3`
  let _ = map_iter rx_gnall (fn (k: str) -> fn (v: str) -> map_set acc k v) in
  rx_names_fold acc
and rx_names_fold = fn m ->
  let out = map_new () in
  let _ = map_set out "s" "" in
  let _ = map_iter m (fn (k: str) -> fn (v: str) ->
            map_set out "s" ((map_get out "s") ++ (if str_eq (map_get out "s") "" then "" else "|") ++ k ++ "=" ++ v)) in
  map_get out "s"
and rxv_slot_get = fn (saves: (int * int) list) -> fn (k: int) ->
  match saves with
  | Nil -> 0 - 1
  | Cons ((k2, v), rest) -> if k2 == k then v else rxv_slot_get rest k
and rxv_is_word = fn (c: str) ->
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || str_eq c "_"
and rxv_cls_one = fn (it: RCls) -> fn (c: str) ->
  match it with
  | CChr x -> str_eq x c
  | CRange (lo, hi) -> c >= lo && c <= hi
  | CDigit -> c >= "0" && c <= "9"
  | CNDigit -> if c >= "0" && c <= "9" then false else true
  | CWord -> rxv_is_word c
  | CNWord -> if rxv_is_word c then false else true
  | CSpace -> str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" || str_eq c (chr 12) || str_eq c (chr 11)
  | CNSpace -> if str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" || str_eq c (chr 12) || str_eq c (chr 11) then false else true
  | CHex -> (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
  | CNHex -> if (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F") then false else true
  | CPosix (nm, negp) ->
    let r = rxv_posix nm c in
    if negp then (if r then false else true) else r
and rxv_posix = fn (nm: str) -> fn (c: str) ->
  if str_eq nm "alpha" then (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
  else if str_eq nm "alnum" then (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
  else if str_eq nm "digit" then c >= "0" && c <= "9"
  else if str_eq nm "xdigit" then (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
  else if str_eq nm "space" then str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" || str_eq c (chr 12) || str_eq c (chr 11)
  else if str_eq nm "upper" then c >= "A" && c <= "Z"
  else if str_eq nm "lower" then c >= "a" && c <= "z"
  else if str_eq nm "word" then rxv_is_word c
  else if str_eq nm "blank" then str_eq c " " || str_eq c "\t"
  else if str_eq nm "cntrl" then c < " " || str_eq c (chr 127)
  else if str_eq nm "print" then c >= " " && (if str_eq c (chr 127) then false else true)
  else if str_eq nm "graph" then c > " " && (if str_eq c (chr 127) then false else true)
  else if str_eq nm "punct" then (c > " " && c < "0") || (c > "9" && c < "A") || (c > "Z" && c < "a" && (if str_eq c "_" then false else true)) || (c > "z" && c <= "~")
  else if str_eq nm "ascii" then c <= chr 127
  else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: regexp: unknown posix class")) in fail "mere-ruby: regexp: unknown posix class")
and rxv_cls = fn (items: RCls list) -> fn (neg: bool) -> fn (ci: bool) -> fn (c: str) ->
  let hit = rxv_cls_list items c || (ci && rxv_cls_list items (rxv_swapcase c)) in
  if neg then (if hit then false else true) else hit
and rxv_cls_list = fn (items: RCls list) -> fn (c: str) ->
  match items with Nil -> false | Cons (h, t) -> rxv_cls_one h c || rxv_cls_list t c
and rxv_swapcase = fn (c: str) ->
  if c >= "a" && c <= "z" then str_upcase c
  else if c >= "A" && c <= "Z" then str_downcase_c c
  else c
and str_downcase_c = fn (c: str) ->
  str_downcase_c_go c 0
and str_downcase_c_go = fn (c: str) -> fn (i: int) ->
  if i >= 26 then c
  else if str_eq (char_at "ABCDEFGHIJKLMNOPQRSTUVWXYZ" i) c then char_at "abcdefghijklmnopqrstuvwxyz" i
  else str_downcase_c_go c (i + 1)
// ⚠ THE PROGRAM IS KEYED BY THE INT, not by its decimal spelling. This read
// `map_get prog (str_of_int pc)`, so EVERY instruction the VM executed called
// str_of_int -- which is asprintf: a malloc, a vfprintf and a free, then a
// string hash and a string compare, to fetch one opcode. It was the single
// largest cost in the interpreter under any regexp-heavy program (a profile of
// CSV.parse on quoted input spent more samples in show_int and vfprintf,
// beneath rxv_run, than anywhere else). Mere's Map is generic in its key type;
// nothing ever required this one to be a string.
and rxv_fetch = fn prog -> fn (pc: int) -> map_get prog pc
and rxv_caps_changed = fn (saves: (int * int) list) -> fn (k: int) ->
  rxv_caps_walk saves k Nil
and rxv_caps_walk = fn (saves: (int * int) list) -> fn (k: int) -> fn (newer: (int * int) list) ->
  match saves with
  | Nil -> false
  | Cons ((k2, v), rest) ->
    if k2 == k then rxv_caps_diff newer rest
    else rxv_caps_walk rest k (Cons ((k2, v), newer))
and rxv_caps_diff = fn (newer: (int * int) list) -> fn (older: (int * int) list) ->
  match newer with
  | Nil -> false
  | Cons ((slot, v), rest) ->
    if slot < 100000 && (let old = rxv_slot_get older slot in (if old == v then false else true)) then true
    else rxv_caps_diff rest older
and rx_close = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_close pat (p + 2) depth
    else if str_eq c "[" then rx_close pat (rx_class_end pat (p + 1)) depth
    else if str_eq c "(" then rx_close pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth <= 1 then p else rx_close pat (p + 1) (depth - 1))
    else rx_close pat (p + 1) depth
and rx_next_alt = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then (0 - 1)
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_next_alt pat (p + 2) depth
    else if str_eq c "[" then rx_next_alt pat (rx_class_end pat (p + 1)) depth
    else if str_eq c "(" then rx_next_alt pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth <= 0 then (0 - 1) else rx_next_alt pat (p + 1) (depth - 1))
    else if str_eq c "|" && depth <= 0 then p + 1
    else rx_next_alt pat (p + 1) depth
and rx_alt_scope_end = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_alt_scope_end pat (p + 2) depth
    else if str_eq c "[" then rx_alt_scope_end pat (rx_class_end pat (p + 1)) depth
    else if str_eq c "(" then rx_alt_scope_end pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth <= 0 then p else rx_alt_scope_end pat (p + 1) (depth - 1))
    else rx_alt_scope_end pat (p + 1) depth
and rx_nth_open = fn (pat: str) -> fn (g: int) -> fn (p: int) -> fn (cnt: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_nth_open pat g (p + 2) cnt
    else if str_eq c "[" then rx_nth_open pat g (rx_class_end pat (p + 1)) cnt
    else if str_eq c "(" then (if cnt + 1 == g then p else rx_nth_open pat g (p + 1) (cnt + 1))
    else rx_nth_open pat g (p + 1) cnt
// every write to a capture slot goes through here, so `rx_clear_caps` knows
// how far it has to reach. Without it the clear walked 1..64 on EVERY match
// attempt: 128 str_of_int and 128 map probes for a pattern with no groups.
and rx_cap_set = fn (g: int) -> fn (kind: int) -> fn (v: int) ->
  let _ = (if g > (if map_has rx_wide 0 then map_get rx_wide 0 else 0)
           then map_set rx_wide 0 g else ()) in
  map_set rx_caps (g * 4 + kind) v
and rx_cap_hi = fn (u: unit) -> if map_has rx_wide 0 then map_get rx_wide 0 else 0
and rx_unset_cap = fn (g: int) ->
  let _ = if map_has rx_caps (g * 4) then map_delete rx_caps (g * 4) else () in
  (if map_has rx_caps (g * 4 + 1) then map_delete rx_caps (g * 4 + 1) else ())
and backref_at = fn (s: str) -> fn (i: int) -> fn (cap: str) -> fn (clen: int) ->
  clen > 0 && i + clen <= str_len s && str_eq (substring s i (i + clen)) cap
and rx_count = fn (pat: str) -> fn (ch: str) -> fn (p: int) ->
  rx_count_go pat ch p 0 0
and rx_count_go = fn (pat: str) -> fn (ch: str) -> fn (p: int) -> fn (i: int) -> fn (n: int) ->
  if i >= p then n
  else rx_count_go pat ch p (i + 1) (if str_eq (char_at pat i) ch then n + 1 else n)
and rx_group_hdr = fn (pat: str) -> fn (p: int) ->
  if p < str_len pat && str_eq (char_at pat p) "?" then rx_hdr_end pat (p + 1)
  else p
and rx_hdr_end = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c ":" || str_eq c ">" then p + 1
    else if str_eq c ")" then p   // (?flags) with no body — leave at )
    else rx_hdr_end pat (p + 1)
and rxv_prog_ng = fn prog ->
  // the program's own entry, under a key no instruction can occupy (pc >= 0)
  match map_get prog (0 - 1) with IMeta (_, ng) -> ng | _ -> 0
and rxv_export_caps = fn (saves: (int * int) list) -> fn (ng: int) ->
  let _ = rx_clear_caps 1 in
  rxv_export_go saves ng 1
and rxv_export_go = fn (saves: (int * int) list) -> fn (ng: int) -> fn (g: int) ->
  // 64, not 9: `$1`..`$9` are all ruby exposes as globals, but MatchData
  // answers every group, and ruby's own URI pattern has fifteen.
  if g > ng || g > 64 then ()
  else
    let a = rxv_slot_get saves (2 * g) in
    let b = rxv_slot_get saves (2 * g + 1) in
    let _ = (if a >= 0 && b >= 0 then
               (let _ = rx_cap_set g 0 a in rx_cap_set g 1 b)
             else ()) in
    rxv_export_go saves ng (g + 1)
and rb_scan_tag = fn (xs: Val list) -> fn (e: str) ->
  match xs with
  | Nil -> Nil
  | Cons (VStr h2, t) -> (let _ = senc_set h2 e in Cons (VStr h2, rb_scan_tag t e))
  | Cons (VArr id2, t) -> (let _ = arr_set id2 (rb_scan_tag (deref id2) e) in Cons (VArr id2, rb_scan_tag t e))
  | Cons (h2, t) -> Cons (h2, rb_scan_tag t e)
and rx_name_end = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else if str_eq (char_at pat p) ">" then p
  else rx_name_end pat (p + 1)
and set_named_caps = fn env -> fn (pat: str) -> fn (p: int) -> fn (gidx: int) ->
  if p >= str_len pat then ()
  else
    let c = char_at pat p in
    if str_eq c "\\" then set_named_caps env pat (p + 2) gidx
    else if str_eq c "(" then
      (if p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "?" && str_eq (char_at pat (p + 2)) "<"
          && (let d = char_at pat (p + 3) in (if str_eq d "=" then false else if str_eq d "!" then false else true)) then
         let nend = rx_name_end pat (p + 3) in
         let name = substring pat (p + 3) nend in
         let g = gidx + 1 in
         let _ = lv_set env name (if map_has globals (str_of_int g) then map_get globals (str_of_int g) else VNil) in
         set_named_caps env pat (nend + 1) g
       else if str_eq (char_at pat (p + 1)) "?" then set_named_caps env pat (p + 1) gidx
       else set_named_caps env pat (p + 1) (gidx + 1))
    else set_named_caps env pat (p + 1) gidx
and rx_capture_names = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then Nil
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_capture_names pat (p + 2)
    else if str_eq c "(" && p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "?" && str_eq (char_at pat (p + 2)) "<"
            && (let d = char_at pat (p + 3) in (if str_eq d "=" then false else if str_eq d "!" then false else true)) then
      let nend = rx_name_end pat (p + 3) in
      Cons (substring pat (p + 3) nend, rx_capture_names pat (nend + 1))
    else rx_capture_names pat (p + 1)
and rx_clear_caps = fn (i: int) ->
  let _ = rx_clear_go i (rx_cap_hi ()) in
  map_set rx_wide 0 0
and rx_clear_go = fn (i: int) -> fn (hi: int) ->
  if i > hi then ()
  else
    let _ = if map_has rx_caps (i * 4) then map_delete rx_caps (i * 4) else () in
    let _ = if map_has rx_caps (i * 4 + 1) then map_delete rx_caps (i * 4 + 1) else () in
    rx_clear_go (i + 1) hi
and rx_publish_at = fn world -> fn (sv: str) -> fn (st: int) -> fn (en: int) -> fn (ng: int) -> fn (enc: str) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  // one itoa for the id, not one per field: every ivar key here is
  // `<id>@...`, and there are eight of them on every successful match.
  let idk = str_of_int id in
  let _ = map_set ocls id "MatchData" in
  let _ = map_set globals "~" (VObj id) in
  let _ = map_set ivars (idk ++ "@0") (mkstr_e (substring sv st en) enc) in
  let _ = map_set md_whole id (substring sv st en) in
  // keep the subject and the span, so #pre_match / #post_match / #begin / #end
  // (and $` / $' / $&, which are derived from them) can be answered.
  // the subject, snapshotted once per (subject, encoding) rather than per match
  let srcv = (if map_has rx_src_hnd "h" && str_eq (map_get rx_src_last "s") sv
                 && str_eq (map_get rx_src_last "e") enc
              then VStr (map_get rx_src_hnd "h")
              else (match mkstr_e sv enc with
                    | VStr nh ->
                      (let _ = map_set rx_src_last "s" sv in
                       let _ = map_set rx_src_last "e" enc in
                       let _ = map_set rx_src_hnd "h" nh in VStr nh)
                    | other -> other)) in
  let _ = map_set ivars (idk ++ "@__src") srcv in
  let _ = map_set ivars (idk ++ "@__st") (VInt st) in
  let _ = map_set ivars (idk ++ "@__en") (VInt en) in
  let _ = (if ng >= 0 then map_set ivars (idk ++ "@__ng") (VInt ng) else ()) in
  // the pattern this match came from, so #[](:name) / #names / #named_captures
  // can look its group names up (rx_prog_names, keyed the same way).
  let _ = (if map_has rx_cur "k" then map_set ivars (idk ++ "@__key") (map_get rx_cur "k") else ()) in
  let _ = rx_store_groups ivars id sv 1 enc in
  rx_pub_groups sv 1 true enc
and rx_store_groups = fn ivars -> fn (id: int) -> fn (sv: str) -> fn (g: int) -> fn (enc: str) ->
  if g > rx_cap_hi () then ()
  else
    let ks = g * 4 in let ke = g * 4 + 1 in
    let idk = str_of_int id in let gk = str_of_int g in
    let _ = (if map_has rx_caps ks && map_has rx_caps ke then
               let a = map_get rx_caps ks in let b = map_get rx_caps ke in
               (if b >= a then
                  // the span too, not only the text: #begin(n) / #end(n) had
                  // nothing but group 0's span to answer from, so `begin(1)`
                  // reported where the whole match started
                  (let _ = map_set ivars (idk ++ "@__st" ++ gk) (VInt a) in
                   let _ = map_set ivars (idk ++ "@__en" ++ gk) (VInt b) in
                   map_set ivars (idk ++ "@" ++ gk) (mkstr_e (substring sv a b) enc))
                else ())
             else ()) in
    rx_store_groups ivars id sv (g + 1) enc
and md_num_list = fn ivars -> fn (id: int) ->
  let key = (if map_has ivars (str_of_int id ++ "@__key")
             then (match map_get ivars (str_of_int id ++ "@__key") with VStr h -> sget h | _ -> "") else "") in
  // ...and a pattern with NO named groups keeps its numbered ones: the names
  // table exists for every pattern and is EMPTY for those, which read as
  // "expose nothing" and emptied every #captures in the suite.
  let tbl0 = (if str_eq key "" then "" else (if map_has rx_prog_names key then (match map_get rx_prog_names key with VStr h -> sget h | _ -> "") else "")) in
  if str_eq tbl0 "" then
    md_num_range 1 (if map_has ivars (str_of_int id ++ "@__ng")
                    then (match map_get ivars (str_of_int id ++ "@__ng") with VInt n -> n | _ -> md_max_group ivars id 9)
                    else md_max_group ivars id 9)
  else (let items = str_split tbl0 "|" in md_named_nums items 1 Nil)
and md_num_range = fn (i: int) -> fn (hi: int) ->
  if i > hi then Nil else Cons (i, md_num_range (i + 1) hi)
and md_named_nums = fn (items: str list) -> fn (k: int) -> fn (acc: int list) ->
  if k > 99 then rev_ints acc Nil
  else md_named_nums items (k + 1) (if str_eq (md_name_at items k) "" then acc else Cons (k, acc))
and rev_ints = fn (xs: int list) -> fn (acc: int list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_ints t (Cons (h, acc))
and md_num_at = fn (ns: int list) -> fn (i: int) ->
  match ns with
  | Nil -> 0
  | Cons (h, t) -> if i <= 1 then h else md_num_at t (i - 1)
and md_num_count = fn (ns: int list) ->
  match ns with Nil -> 0 | Cons (_, t) -> 1 + md_num_count t
and md_max_group = fn ivars -> fn (id: int) -> fn (g: int) ->
  if g < 1 then 0 else if map_has ivars (str_of_int id ++ "@" ++ str_of_int g) then g else md_max_group ivars id (g - 1)
and md_collect = fn ivars -> fn (id: int) -> fn (i: int) -> fn (hi: int) ->
  if i > hi then Nil
  else Cons ((if map_has ivars (str_of_int id ++ "@" ++ str_of_int i) then map_get ivars (str_of_int id ++ "@" ++ str_of_int i) else VNil), md_collect ivars id (i + 1) hi)
and md_int_vals = fn (i: int) -> fn (hi: int) ->
  if i >= hi then Nil else Cons (VInt i, md_int_vals (i + 1) hi)
and md_values_go = fn world -> fn ivars -> fn (id: int) -> fn (idxs: Val list) -> fn (all: Val list) ->
  match idxs with
  | Nil -> Nil
  | Cons (VInt n, t) ->
    // an index addresses the EXPOSED list (see md_num_list), and one past its
    // end is nil rather than a group the pattern does not expose
    (let n0 = val_list_len all in
     let i2 = (if n < 0 then n0 + n else n) in
     Cons ((if i2 < 0 || i2 >= n0 then VNil else val_nth all i2), md_values_go world ivars id t all))
  // a name is as good as a number here, as in ruby
  | Cons (VSym nm, t) -> Cons (md_by_name world ivars id nm, md_values_go world ivars id t all)
  | Cons (VStr nh, t) -> Cons (md_by_name world ivars id (sget nh), md_values_go world ivars id t all)
  | Cons (_, t) -> Cons (VNil, md_values_go world ivars id t all)
and matchdata_arr = fn ivars -> fn (id: int) -> fn (start: int) ->
  // the EXPOSED groups (see md_num_list), nil-filling the ones that did not
  // participate; `start` is 0 for #to_a (which leads with the whole match) and
  // 1 for #captures.
  let groups = md_collect_nums ivars id (md_num_list ivars id) in
  if start > 0 then groups
  else Cons ((if map_has ivars (str_of_int id ++ "@0") then map_get ivars (str_of_int id ++ "@0") else VNil), groups)
and md_collect_nums = fn ivars -> fn (id: int) -> fn (ns: int list) ->
  match ns with
  | Nil -> Nil
  | Cons (g, t) ->
    Cons ((if map_has ivars (str_of_int id ++ "@" ++ str_of_int g) then map_get ivars (str_of_int id ++ "@" ++ str_of_int g) else VNil),
          md_collect_nums ivars id t)
// ⚠ `$1..$9` are nine unconditional map writes per match, and a write leaves
// the value it replaced in the map's arena. A pattern with no groups wrote
// nine VNils over nine VNils on every match. Write as far as THIS match
// reaches, clear as far as the LAST one did, and remember which that was.
and rx_pub_groups = fn (sv: str) -> fn (i: int) -> fn (ok: bool) -> fn (enc: str) ->
  let hi = (let h = (if ok then rx_cap_hi () else 0) in if h > 9 then 9 else h) in
  let last = (if map_has rx_wide 1 then map_get rx_wide 1 else 0) in
  let _ = rx_pub_go sv i ok enc (if hi > last then hi else last) in
  map_set rx_wide 1 hi
and rx_pub_go = fn (sv: str) -> fn (i: int) -> fn (ok: bool) -> fn (enc: str) -> fn (lim: int) ->
  if i > lim then ()
  else
    let k_s = i * 4 in
    let k_e = i * 4 + 1 in
    let v = if ok && map_has rx_caps k_s && map_has rx_caps k_e then
              (let a = map_get rx_caps k_s in
               let b = map_get rx_caps k_e in
               if b >= a then mkstr_e (substring sv a b) enc else VNil)
            else VNil in
    let _ = map_set globals (str_of_int i) v in
    rx_pub_go sv (i + 1) ok enc lim
and rx_step = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) ->
  if str_eq (char_at pat p) "." then utf8_clen s i else 1
and rx_elem = fn (pat: str) -> fn (p: int) -> fn (c: str) ->
  let pc = char_at pat p in
  if str_eq pc "." then true
  else if str_eq pc "[" then rx_class_match pat (p + 1) c
  else if str_eq pc "\\" then
    let e = char_at pat (p + 1) in
    if str_eq e "d" then is_digit c
    else if str_eq e "w" then is_alnum c || str_eq c "_"
    else if str_eq e "s" then str_eq c " " || str_eq c "\t" || str_eq c "\n"
    else str_eq c e
  else str_eq pc c
and rx_elen = fn (pat: str) -> fn (p: int) ->
  let c = char_at pat p in
  if str_eq c "\\" && p + 1 < str_len pat then 2
  else if str_eq c "[" then rx_class_end pat (p + 1) - p
  else 1
and rx_class_end = fn (pat: str) -> fn (i: int) ->
  if i >= str_len pat then i
  else if str_eq (char_at pat i) "]" then i + 1
  else if str_eq (char_at pat i) "\\" then rx_class_end pat (i + 2)
  else rx_class_end pat (i + 1)
and rx_class_match = fn (pat: str) -> fn (p: int) -> fn (c: str) ->
  let neg = p < str_len pat && str_eq (char_at pat p) "^" in
  let start = if neg then p + 1 else p in
  let inside = rx_class_test pat start c in
  if neg then (if inside then false else true) else inside
and rx_class_test = fn (pat: str) -> fn (p: int) -> fn (c: str) ->
  if p >= str_len pat || str_eq (char_at pat p) "]" then false
  else if p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "-" && (if str_eq (char_at pat (p + 2)) "]" then false else true) then
    // a range like a-z
    let lo = ord (char_at pat p) in let hi = ord (char_at pat (p + 2)) in let cc = ord c in
    if cc >= lo && cc <= hi then true else rx_class_test pat (p + 3) c
  else if str_eq (char_at pat p) "\\" && p + 1 < str_len pat then
    let e = char_at pat (p + 1) in
    let m = (if str_eq e "d" then is_digit c
             else if str_eq e "w" then is_alnum c || str_eq c "_"
             else if str_eq e "s" then str_eq c " " || str_eq c "\t" || str_eq c "\n"
             else str_eq c e) in
    if m then true else rx_class_test pat (p + 2) c
  else if str_eq (char_at pat p) c then true
  else rx_class_test pat (p + 1) c
and rxe_start = fn (pat: str) ->
  if str_len pat > 0 && str_eq (char_at pat 0) "^" then 1 else 0
and rx_expand_rep = fn (rep: str) -> fn (s: str) -> fn (mst: int) -> fn (men: int) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len rep in
  if i >= n then acc
  else
    let c = char_at rep i in
    if str_eq c "\\" && i + 1 < n then
      let d = char_at rep (i + 1) in
      if str_eq d "&" || str_eq d "0" then rx_expand_rep rep s mst men (i + 2) (acc ++ substring s mst men)
      // \` = everything before the match, \' = everything after it,
      // \+ = the LAST capture group that actually matched.
      else if str_eq d "`" then rx_expand_rep rep s mst men (i + 2) (acc ++ substring s 0 mst)
      else if str_eq d "'" then rx_expand_rep rep s mst men (i + 2) (acc ++ substring s men (str_len s))
      else if str_eq d "+" then
        (let rec lastg = fn (g: int) -> fn (best: str) ->
           if g > 64 then best
           else
             let gs = g * 4 in let ge = g * 4 + 1 in
             (if map_has rx_caps gs && map_has rx_caps ge then
                (let a = map_get rx_caps gs in let b = map_get rx_caps ge in
                 lastg (g + 1) (if b >= a then substring s a b else best))
              else lastg (g + 1) best) in
         rx_expand_rep rep s mst men (i + 2) (acc ++ lastg 1 ""))
      else if is_digit d then
        let g = ord d - 48 in
        let gs = g * 4 in let ge = g * 4 + 1 in
        let piece = if map_has rx_caps gs && map_has rx_caps ge then
                      (let a = map_get rx_caps gs in let b = map_get rx_caps ge in if b >= a then substring s a b else "")
                    else "" in
        rx_expand_rep rep s mst men (i + 2) (acc ++ piece)
      else if str_eq d "\\" then rx_expand_rep rep s mst men (i + 2) (acc ++ "\\")
      // an unknown escape stays as written, backslash included.
      else rx_expand_rep rep s mst men (i + 2) (acc ++ "\\" ++ d)
    else rx_expand_rep rep s mst men (i + 1) (acc ++ c)
and rx_group_count = fn (pat: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len pat then n
  else if str_eq (char_at pat i) "(" &&
          (if i + 1 < str_len pat then (if str_eq (char_at pat (i + 1)) "?" then false else true) else true)
  then rx_group_count pat (i + 1) (n + 1)
  else rx_group_count pat (i + 1) n
and rx_scan_groups = fn (s: str) -> fn (g: int) -> fn (ng: int) ->
  if g > ng then Nil
  else
    let ks = g * 4 in
    let ke = g * 4 + 1 in
    let v = (if map_has rx_caps ks && map_has rx_caps ke then
               (let a = map_get rx_caps ks in let b = map_get rx_caps ke in
                if b >= a then mkstr (substring s a b) else VNil)
             else VNil) in
    Cons (v, rx_scan_groups s (g + 1) ng)
and rx_split_caps = fn (saves: (int * int) list) -> fn (ng: int) -> fn (s: str) -> fn (g: int) -> fn (acc: Val list) ->
  if g > ng then acc
  else
    let a = rxv_slot_get saves (2 * g) in
    let b = rxv_slot_get saves (2 * g + 1) in
    rx_split_caps saves ng s (g + 1) (if a >= 0 && b >= a then Cons (mkstr (substring s a b), acc) else acc)
and rx_split_trim = fn (xs: Val list) ->
  rev_app (rx_split_lead (rev_app xs Nil)) Nil
and rx_split_lead = fn (xs: Val list) ->
  match xs with
  | Cons (VStr h, t) -> if str_eq (sget h) "" then rx_split_lead t else xs
  | _ -> xs
and any_val_truthy = fn (xs: Val list) ->
  match xs with Nil -> false | Cons (h, t) -> truthy h || any_val_truthy t
and stdio_hook = fn world -> fn (slot: str) ->
  (if map_has stdio_bypass slot then VNil
   else if map_has globals slot then
     (match map_get globals slot with
      | VObj id9 ->
        (let (m9, s9, o9, iv9) = world in
         if map_has iv9 (str_of_int id9 ++ "@__io_fd") then VNil else VObj id9)
      | _ -> VNil)
   else VNil)
and p_print = fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (v, t) -> let _ = out_print (inspect v) in p_print t
// the highest numbered parameter (_1..) referenced in a block body, else 0.
// Over-detection is safe (it only relaxes the arity-0 check / grows arity),
// so descend broadly.
// `[[:req, :_1], ...]` (lambda) / `[[:opt, :_1], ...]` (proc) for _1.._n.
// #parameters metadata for an explicit block/lambda parameter list.
// the parameters with a default dropped, and whether any has one: a block's
// defaults are a prologue in its body, so the list alone cannot say.
and params_wo_defaults = fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  match ps with
  | Nil -> Nil
  | Cons ("*__opt", rest) -> params_wo_defaults rest ds
  | Cons (p, rest) -> if bm_has_default ds p then params_wo_defaults rest ds else Cons (p, params_wo_defaults rest ds)
and arr_product2 = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> list_append (pair_with h ys) (arr_product2 t ys)
// File.basename: the path's final component.
// Ruby strips trailing slashes first, so basename("a/") is "a" and the root
// "/" is its own basename.
// File.basename(path, suffix): drop the suffix when it matches, or drop any
// extension when the suffix is ".*".
// The environment, read once into a table. It cannot be read with libc
// getenv: an `extern fn ... -> str` hands back the raw C pointer, which is
// NOT a Mere string, so anything but printing it (str_len, ++, substring)
// reads a garbage length prefix and segfaults. A process's environ does not
// change under it, so one dump plus the write overlay is a faithful ENV —
// and it costs one subprocess instead of one per read.
// Dir.chdir: the process's cwd and the PWD this interpreter reads are ONE
// fact, so they move together. File.expand_path, Dir.pwd, __dir__ and
// require_relative all resolve through PWD, so changing only the process cwd
// would leave every one of them pointing at the directory we just left.
// ⚠ the new PWD is computed TEXTUALLY (path_norm), so a path through a
//   symlink keeps the name it was given -- `Dir.pwd` says /tmp where ruby,
//   which asks getcwd(3), says /private/tmp. Same limit File.realpath has.
// the initial $LOAD_PATH: -I directories, then RUBYLIB, as ruby orders them.
// Empty entries are dropped, so an unset RUBYLIB contributes nothing.
and lp_seed = fn () ->
  let incs = (if map_has cli_inc "v" then (match map_get cli_inc "v" with VStr h -> sget h | _ -> "") else "") in
  drop_empty (list_append_str (split_colon incs 0 "" Nil) (split_colon (env_get "RUBYLIB") 0 "" Nil))
