    "    accept\n" ++
    "  end\n" ++
    "  def listen(backlog)\n" ++
    "    0\n" ++
    "  end\n" ++
    "  def addr\n" ++
    "    [\"AF_INET\", @port.to_i, \"0.0.0.0\", \"0.0.0.0\"]\n" ++
    "  end\n" ++
    "end\n" ++
