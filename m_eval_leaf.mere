    "      end\n" ++
    "    end\n" ++
    "    class SHA256 < Digest\n" ++
    "      def self.__algo\n" ++
    "        \"SHA256\"\n" ++
    "      end\n" ++
    "      def initialize(data = nil)\n" ++
    "        super(\"SHA256\", data)\n" ++
    "      end\n" ++
    "    end\n" ++
    "    class SHA384 < Digest\n" ++
