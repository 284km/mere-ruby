    "\n" ++
    "  # a copy keeps the comparison MODE: a set that compares by identity dups into\n" ++
    "  # one that still does (ruby carries it through initialize_copy)\n" ++
    "  def dup\n" ++
    "    s = self.class.new\n" ++
    "    s.compare_by_identity if compare_by_identity?\n" ++
    "    s.merge(to_a)\n" ++
    "    s\n" ++
    "  end\n" ++
    "\n" ++
    "  def clear\n" ++
    "    __modify!\n" ++
    "    @hash = \{}\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def __as_set(other)\n" ++
    "    return other if other.is_a?(Set)\n" ++
    "    s = Set.new\n" ++
    "    other.each \{ |x| s.add(x) }\n" ++
    "    s\n" ++
    "  end\n" ++
    "  private :__as_set\n" ++
    "\n" ++
    "  def |(other)\n" ++
    "    Set.__enum!(other)\n" ++
    "    s = Set.new(to_a)\n" ++
    "    other.each \{ |x| s.add(x) }\n" ++
    "    s\n" ++
    "  end\n" ++
    "  alias_method :union, :|\n" ++
    "  alias_method :+, :|\n" ++
    "\n" ++
    "  def &(other)\n" ++
    "    Set.__enum!(other)\n" ++
    "    os = __as_set(other)\n" ++
    "    Set.new(to_a.select \{ |x| os.include?(x) })\n" ++
    "  end\n" ++
    "  alias_method :intersection, :&\n" ++
    "\n" ++
    "  def -(other)\n" ++
    "    Set.__enum!(other)\n" ++
    "    os = __as_set(other)\n" ++
    "    Set.new(to_a.reject \{ |x| os.include?(x) })\n" ++
    "  end\n" ++
    "  alias_method :difference, :-\n" ++
    "\n" ++
    "  def ^(other)\n" ++
    "    Set.__enum!(other)\n" ++
    "    os = __as_set(other)\n" ++
    "    (self | os) - (self & os)\n" ++
    "  end\n" ++
    "\n" ++
    "  def subset?(other)\n" ++
    "    Set.__set!(other)\n" ++
    "    to_a.all? \{ |x| other.include?(x) }\n" ++
    "  end\n" ++
    "  alias_method :<=, :subset?\n" ++
    "\n" ++
    "  def superset?(other)\n" ++
    "    Set.__set!(other)\n" ++
    "    other.to_a.all? \{ |x| include?(x) }\n" ++
    "  end\n" ++
    "  alias_method :>=, :superset?\n" ++
    "\n" ++
    "  def proper_subset?(other)\n" ++
    "    Set.__set!(other)\n" ++
    "    size < other.size && subset?(other)\n" ++
    "  end\n" ++
    "  alias_method :<, :proper_subset?\n" ++
    "\n" ++
    "  def proper_superset?(other)\n" ++
    "    Set.__set!(other)\n" ++
    "    size > other.size && superset?(other)\n" ++
    "  end\n" ++
    "  alias_method :>, :proper_superset?\n" ++
    "\n" ++
    "  # disjoint? takes any enumerable, and says so with the other message\n" ++
    "  def disjoint?(other)\n" ++
    "    Set.__enum!(other)\n" ++
    "    os = __as_set(other)\n" ++
    "    (self & os).empty?\n" ++
    "  end\n" ++
    "\n" ++
    "  def intersect?(other)\n" ++
    "    !disjoint?(other)\n" ++
    "  end\n" ++
    "\n" ++
    "  def ==(other)\n" ++
    "    return true if equal?(other)\n" ++
    "    return false unless other.is_a?(Set)\n" ++
    "    # a set that compares by identity is not equal to one that does not, even\n" ++
    "    # when the members would compare equal either way\n" ++
    "    return false unless compare_by_identity? == other.compare_by_identity?\n" ++
    "    size == other.size && to_a.all? \{ |x| other.include?(x) }\n" ++
    "  end\n" ++
    "  alias_method :eql?, :==\n" ++
    "\n" ++
    "  # nil unless one contains the other: 0 equal, -1 proper subset, +1 proper\n" ++
    "  # superset. Anything that is not a Set is not comparable at all.\n" ++
    "  def <=>(other)\n" ++
    "    return nil unless other.is_a?(Set)\n" ++
    "    c = size <=> other.size\n" ++
    "    if c == 0\n" ++
    "      self == other ? 0 : nil\n" ++
    "    elsif c < 0\n" ++
    "      subset?(other) ? -1 : nil\n" ++
    "    else\n" ++
    "      superset?(other) ? 1 : nil\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def hash\n" ++
    "    to_a.sort_by \{ |x| x.to_s }.hash\n" ++
    "  end\n" ++
    "\n" ++
    "  def freeze\n" ++
    "    @hash.freeze\n" ++
    "    super\n" ++
    "  end\n" ++
    "\n" ++
    "  def compare_by_identity\n" ++
    "    __modify!\n" ++
    "    @hash.compare_by_identity\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def compare_by_identity?\n" ++
    "    @hash.compare_by_identity?\n" ++
    "  end\n" ++
    "\n" ++
    "  def classify(&block)\n" ++
    "    return to_enum(:classify) unless block\n" ++
    "    h = \{}\n" ++
    "    each do |x|\n" ++
    "      k = block.call(x)\n" ++
    "      h[k] = Set.new unless h.key?(k)\n" ++
    "      h[k].add(x)\n" ++
    "    end\n" ++
    "    h\n" ++
    "  end\n" ++
    "\n" ++
    "  # A one-argument block groups by its value. A TWO-argument one is a relation,\n" ++
    "  # and the subsets are the strongly connected components of the graph it\n" ++
    "  # describes -- not merely the connected ones, which would join a pair that is\n" ++
    "  # related in one direction only. The block is never asked about (x, x).\n" ++
    "  def divide(&func)\n" ++
    "    return to_enum(:divide) unless func\n" ++
    "    return Set.new(classify(&func).values) unless func.arity == 2\n" ++
    "    els = to_a\n" ++
    "    adj = \{}\n" ++
    "    i = 0\n" ++
    "    while i < els.size\n" ++
    "      row = []\n" ++
    "      j = 0\n" ++
    "      while j < els.size\n" ++
    "        row << j if i != j && func.call(els[i], els[j])\n" ++
    "        j += 1\n" ++
    "      end\n" ++
    "      adj[i] = row\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    index = \{}\n" ++
    "    low = \{}\n" ++
    "    onstack = \{}\n" ++
    "    stack = []\n" ++
    "    comps = []\n" ++
    "    counter = [0]\n" ++
    "    visit = nil\n" ++
    "    visit = lambda do |v|\n" ++
    "      index[v] = counter[0]\n" ++
    "      low[v] = counter[0]\n" ++
    "      counter[0] = counter[0] + 1\n" ++
    "      stack.push(v)\n" ++
    "      onstack[v] = true\n" ++
    "      adj[v].each do |w|\n" ++
    "        if !index.key?(w)\n" ++
    "          visit.call(w)\n" ++
    "          low[v] = low[w] if low[w] < low[v]\n" ++
    "        elsif onstack[w]\n" ++
    "          low[v] = index[w] if index[w] < low[v]\n" ++
    "        end\n" ++
    "      end\n" ++
    "      if low[v] == index[v]\n" ++
    "        comp = []\n" ++
    "        loop do\n" ++
    "          w = stack.pop\n" ++
    "          onstack[w] = false\n" ++
    "          comp << els[w]\n" ++
    "          break if w == v\n" ++
    "        end\n" ++
    "        comps << comp\n" ++
    "      end\n" ++
    "    end\n" ++
    "    k = 0\n" ++
    "    while k < els.size\n" ++
    "      visit.call(k) unless index.key?(k)\n" ++
    "      k += 1\n" ++
    "    end\n" ++
    "    Set.new(comps.map \{ |c| Set.new(c) })\n" ++
    "  end\n" ++
    "\n" ++
    "  def __flatten_into(acc, set, seen)\n" ++
    "    raise ArgumentError, \"tried to flatten recursive Set\" if seen.key?(set.object_id)\n" ++
    "    seen[set.object_id] = true\n" ++
    "    set.each do |x|\n" ++
    "      if x.is_a?(Set)\n" ++
    "        __flatten_into(acc, x, seen)\n" ++
    "      else\n" ++
    "        acc << x\n" ++
    "      end\n" ++
    "    end\n" ++
    "    seen.delete(set.object_id)\n" ++
    "    acc\n" ++
    "  end\n" ++
    "  private :__flatten_into\n" ++
    "\n" ++
    "  def flatten\n" ++
    "    Set.new(__flatten_into([], self, \{}))\n" ++
    "  end\n" ++
    "\n" ++
    "  def flatten!\n" ++
    "    return nil unless to_a.any? \{ |x| x.is_a?(Set) }\n" ++
    "    replace(__flatten_into([], self, \{}))\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def join(sep = nil)\n" ++
    "    to_a.join(sep)\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete_if(&block)\n" ++
    "    return to_enum(:delete_if) unless block\n" ++
    "    __modify!\n" ++
    "    to_a.each \{ |x| @hash.delete(x) if block.call(x) }\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def keep_if(&block)\n" ++
    "    return to_enum(:keep_if) unless block\n" ++
    "    __modify!\n" ++
    "    to_a.each \{ |x| @hash.delete(x) unless block.call(x) }\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # the bang filters answer nil when nothing was removed, as ruby's do\n" ++
    "  def select!(&block)\n" ++
    "    return to_enum(:select!) unless block\n" ++
    "    n = size\n" ++
    "    keep_if(&block)\n" ++
    "    size == n ? nil : self\n" ++
    "  end\n" ++
    "  alias_method :filter!, :select!\n" ++
    "\n" ++
    "  def reject!(&block)\n" ++
    "    return to_enum(:reject!) unless block\n" ++
    "    n = size\n" ++
    "    delete_if(&block)\n" ++
    "    size == n ? nil : self\n" ++
    "  end\n" ++
    "\n" ++
    "  def map!(&block)\n" ++
    "    return to_enum(:map!) unless block\n" ++
    "    replace(to_a.map \{ |x| block.call(x) })\n" ++
    "    self\n" ++
    "  end\n" ++
    "  alias_method :collect!, :map!\n" ++
    "\n" ++
    "  # ruby 4.0 made Set core and its inspect `Set[1, 2]` (a set that contains\n" ++
    "  # itself shows `Set[...]`); a SUBCLASS keeps the older shape, which is what\n" ++
    "  # 4.0.6 prints for one. The recursion guard is a table on the class rather\n" ++
    "  # than an ivar on the instance, because a frozen set still inspects.\n" ++
    "  def self.__insp_ids\n" ++
    "    @__insp_ids ||= \{}\n" ++
    "  end\n" ++
    "\n" ++
    "  def inspect\n" ++
    "    exact = self.class == Set\n" ++
    "    open = exact ? \"Set[\" : \"#<\" + self.class.to_s + \": \{\"\n" ++
    "    close = exact ? \"]\" : \"}>\"\n" ++
    "    ids = Set.__insp_ids\n" ++
    "    return open + \"...\" + close if ids[object_id]\n" ++
    "    ids[object_id] = true\n" ++
    "    begin\n" ++
    "      open + to_a.map \{ |x| x.inspect }.join(\", \") + close\n" ++
    "    ensure\n" ++
    "      ids.delete(object_id)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  alias_method :to_s, :inspect\n" ++
    "end\n" ++
    "\n" ++
    "module Enumerable\n" ++
    "  # to_set forwards its block, so `(1..3).to_set \{ |x| x * x }` is \{1, 4, 9}\n" ++
    // ⚠ ruby 4.0 DEPRECATES the arguments and says so. Only Enumerable's and
    // Range's forms warn, only when an argument is given -- a block alone is
    // not deprecated, and Set#to_set never warns. (Asked of 4.0.6; 3.4.9 says
    // nothing at all, which is why the reference has to be the pinned one.)
    "  def to_set(klass = Set, *args, &block)\n" ++
    "    unless klass == Set && args.empty?\n" ++
    "      warn(\"passing arguments to Enumerable#to_set is deprecated\", uplevel: 1)\n" ++
    "    end\n" ++
    "    klass.new(self, *args, &block)\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "class Range\n" ++
    "  # ruby 4.0: Range#to_set refuses an endless range before walking it\n" ++
    "  def to_set(klass = Set, *args, &block)\n" ++
    "    raise RangeError, \"cannot convert endless range to a set\" if self.end.nil?\n" ++
    "    unless klass == Set && args.empty?\n" ++
    "      warn(\"passing arguments to Enumerable#to_set is deprecated\", uplevel: 1)\n" ++
    "    end\n" ++
    "    klass.new(self, *args, &block)\n" ++
    "  end\n" ++
    "end\n"
  // Forwardable / SingleForwardable: delegation built on define_method,
  // where CRuby's builds source strings. Same surface.
  else if str_eq n "forwardable" then
    "module Forwardable\n" ++
    "  def def_instance_delegator(accessor, method, ali = method)\n" ++
    "    accessor = accessor.to_s\n" ++
    "    define_method(ali) do |*args, &block|\n" ++
    "      target = accessor.start_with?(\"@\") ? instance_variable_get(accessor) : __send__(accessor)\n" ++
    "      target.__send__(method, *args, &block)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def def_instance_delegators(accessor, *methods)\n" ++
    "    methods.each do |m|\n" ++
    "      def_instance_delegator(accessor, m)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def instance_delegate(hash)\n" ++
    "    hash.each do |methods, accessor|\n" ++
    "      methods = [methods] unless methods.is_a?(Array)\n" ++
    "      methods.each do |m|\n" ++
    "        def_instance_delegator(accessor, m)\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "  alias_method :def_delegator, :def_instance_delegator\n" ++
    "  alias_method :def_delegators, :def_instance_delegators\n" ++
    "  alias_method :delegate, :instance_delegate\n" ++
    "end\n" ++
    "\n" ++
    "module SingleForwardable\n" ++
    "  def def_single_delegator(accessor, method, ali = method)\n" ++
    "    accessor = accessor.to_s\n" ++
    "    define_singleton_method(ali) do |*args, &block|\n" ++
    "      target = accessor.start_with?(\"@\") ? instance_variable_get(accessor) : __send__(accessor)\n" ++
    "      target.__send__(method, *args, &block)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def def_single_delegators(accessor, *methods)\n" ++
    "    methods.each do |m|\n" ++
    "      def_single_delegator(accessor, m)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  alias_method :def_delegator, :def_single_delegator\n" ++
    "  alias_method :def_delegators, :def_single_delegators\n" ++
    "end\n"
  // Singleton: the memoised instance plus the clone/dup refusals.
  else if str_eq n "singleton" then
    "module Singleton\n" ++
    "  module SingletonClassMethods\n" ++
    "    def instance\n" ++
    "      @singleton__instance__ ||= new\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def self.included(klass)\n" ++
    "    klass.extend(SingletonClassMethods)\n" ++
    "  end\n" ++
    "  def clone\n" ++
    "    raise TypeError, \"can't clone instance of singleton \" + self.class.to_s\n" ++
    "  end\n" ++
    "  def dup\n" ++
    "    raise TypeError, \"can't dup instance of singleton \" + self.class.to_s\n" ++
    "  end\n" ++
    "end\n"
  // StringIO: a String plus a position. CRuby ships it as a C extension,
  // but nothing about it needs C.
  else if str_eq n "stringio" then
    "class StringIO\n" ++
    "  attr_accessor :string\n" ++
    "  attr_accessor :pos\n" ++
    // the encoding pair every IO answers: nil internally, the string's own
    // externally. csv/writer.rb reads #internal_encoding on the output before
    // it writes a single row, so CSV.generate_line could not run at all.
    "  def internal_encoding; nil; end\n" ++
    "  def external_encoding; @string.encoding; end\n" ++
    "  def set_encoding(*a); self; end\n" ++
    "\n" ++
    "  def self.open(string = \"\", mode = \"r+\")\n" ++
    "    io = new(string, mode)\n" ++
    "    return io unless block_given?\n" ++
    "    begin\n" ++
    "      yield io\n" ++
    "    ensure\n" ++
    "      io.close\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize(string = \"\", mode = \"r+\")\n" ++
    "    @string = string.to_s.dup\n" ++
    "    @pos = 0\n" ++
    "    @closed = false\n" ++
    "    @string = \"\" if mode.to_s.start_with?(\"w\")\n" ++
    "    @pos = @string.length if mode.to_s.start_with?(\"a\")\n" ++
    "  end\n" ++
    "\n" ++
    "  def close\n" ++
    "    @closed = true\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def closed?\n" ++
    "    @closed\n" ++
    "  end\n" ++
    "\n" ++
    "  def eof?\n" ++
    "    @pos >= @string.length\n" ++
    "  end\n" ++
    "\n" ++
    "  def size\n" ++
    "    @string.length\n" ++
    "  end\n" ++
    "\n" ++
    "  def length\n" ++
    "    @string.length\n" ++
    "  end\n" ++
    "\n" ++
    "  def rewind\n" ++
    "    @pos = 0\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def seek(amount, whence = 0)\n" ++
    "    @pos = if whence == 2\n" ++
    "      @string.length + amount\n" ++
    "    elsif whence == 1\n" ++
    "      @pos + amount\n" ++
    "    else\n" ++
    "      amount\n" ++
    "    end\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def tell\n" ++
    "    @pos\n" ++
    "  end\n" ++
    "\n" ++
    "  def read(len = nil)\n" ++
    "    return nil if len && eof?\n" ++
    "    rest = @string[@pos, @string.length - @pos] || \"\"\n" ++
    "    if len.nil?\n" ++
    "      @pos = @string.length\n" ++
    "      rest\n" ++
    "    else\n" ++
    "      part = rest[0, len] || \"\"\n" ++
    "      @pos += part.length\n" ++
    "      part\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def gets(sep = \"\\n\")\n" ++
    // at EOF $_ becomes nil too -- it reports the LAST READ, and there was
    // none. Returning early without touching it left the previous line there.
    "    return ($_ = nil) if eof?\n" ++
    "    idx = @string.index(sep, @pos)\n" ++
    "    if idx.nil?\n" ++
    "      line = @string[@pos, @string.length - @pos]\n" ++
    "      @pos = @string.length\n" ++
    "    else\n" ++
    "      line = @string[@pos, idx + sep.length - @pos]\n" ++
    "      @pos = idx + sep.length\n" ++
    "    end\n" ++
    // `gets` sets $_ to the line it read, wherever it is read from -- the
    // spec checks it through StringIO. It was left nil.
    "    $_ = line\n" ++
    "  end\n" ++
    "\n" ++
    "  def readlines(sep = \"\\n\")\n" ++
    "    out = []\n" ++
    "    while (line = gets(sep))\n" ++
    "      out.push(line)\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  def each_line(sep = \"\\n\")\n" ++
    "    return to_enum(:each_line, sep) unless block_given?\n" ++
    "    while (line = gets(sep))\n" ++
    "      yield line\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def each(sep = \"\\n\", &block)\n" ++
    "    each_line(sep, &block)\n" ++
    "  end\n" ++
    "\n" ++
    "  def getc\n" ++
    "    return nil if eof?\n" ++
    "    ch = @string[@pos, 1]\n" ++
    "    @pos += 1\n" ++
    "    ch\n" ++
    "  end\n" ++
    "\n" ++
    "  def ungetc(_ch)\n" ++
    "    @pos -= 1 if @pos > 0\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def write(*args)\n" ++
    "    n = 0\n" ++
    "    args.each do |a|\n" ++
    "      s = a.to_s\n" ++
    "      n += s.length\n" ++
    "      @string = @string + s\n" ++
    "      @pos = @string.length\n" ++
    "    end\n" ++
    "    n\n" ++
    "  end\n" ++
    "\n" ++
    "  def <<(obj)\n" ++
    "    write(obj)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def print(*args)\n" ++
    "    args.each do |a|\n" ++
    "      write(a)\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def puts(*args)\n" ++
    "    if args.empty?\n" ++
    "      write(\"\\n\")\n" ++
    "      return nil\n" ++
    "    end\n" ++
    "    args.each do |a|\n" ++
    "      if a.is_a?(Array)\n" ++
    "        puts(*a)\n" ++
    "      else\n" ++
    "        s = a.to_s\n" ++
    "        write(s)\n" ++
    "        write(\"\\n\") unless s.end_with?(\"\\n\")\n" ++
    "      end\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def printf(fmt, *args)\n" ++
    "    write(format(fmt, *args))\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def truncate(len)\n" ++
    "    @string = @string[0, len] || \"\"\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def flush\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def sync\n" ++
    "    true\n" ++
    "  end\n" ++
    "\n" ++
    "  def sync=(v)\n" ++
    "    v\n" ++
    "  end\n" ++
    "\n" ++
    "  def tty?\n" ++
    "    false\n" ++
    "  end\n" ++
    "\n" ++
    "  def isatty\n" ++
    "    false\n" ++
    "  end\n" ++
    "\n" ++
    "  def fileno\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def inspect\n" ++
    "    \"#<StringIO>\"\n" ++
    "  end\n" ++
