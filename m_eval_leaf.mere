// The parts of the evaluator that nothing in the evaluator calls back.
//
// 840 of the chain's 1,451 members are in no cycle at all: they were
// written inside `let rec eval_e = ... and ...` because that is where the
// code that needed them was, not because anything needed them to be there.
// Their calls all go UP -- to things declared above the chain, or to each
// other -- so they can be one chain of their own, spliced in ahead of it.
// No forward declaration is needed for any of them; see STRUCTURE.md and
// the SCC column, which is 1 for every name in here.
//
// One `let rec ... and ...` group, so the order inside this file does not
// matter -- it is the order of the FILES that has to respect dependencies.
let rec interp_literal = fn (e: Expr) ->
  match e with
  | EBin (op, l, _) -> str_eq op "+" && interp_literal l
  | EMethod (inner, m, _) -> str_eq m "__regex" && interp_literal inner
  | EStrL x -> str_eq x ""
  | _ -> false
and hsh_key_of = fn (kv: Val) ->
  (match kv with
   | VStr h9 ->
     // ...unless it is ALREADY frozen, in which case ruby stores that very
     // object rather than making another copy of it.
     (if sfrozen_get h9 then kv
      else (let c9 = mkstr_e (sget h9) (senc_get h9) in
            (match c9 with VStr i9 -> (let _ = sfrozen_set i9 in c9) | _ -> c9)))
   | _ -> kv)
and rb_identical = fn (a: Val) -> fn (b: Val) ->
  match a with
  | VArr ia -> (match b with VArr ib -> ia == ib | _ -> false)
  | VObj ia -> (match b with VObj ib -> ia == ib | _ -> false)
  // strings are handles: equal? is object identity, not content equality.
  | VStr ia -> (match b with VStr ib -> ia == ib | _ -> false)
  | VHsh ia -> (match b with VHsh ib -> ia == ib | _ -> false)
  // ⚠ NaN is the one value that is not `==` to ITSELF, and equal? asks about
  //   identity, not equality. A Float here has no separate identity -- two
  //   equal floats ARE the same object in this model -- so the same bits are
  //   the same object, NaN included. `nan.arg.should equal(nan)` and three
  //   other spec rows say exactly that.
  | VFlt x -> (match b with VFlt y -> feq x y || ((if x == x then false else true) && (if y == y then false else true)) | _ -> false)
  | _ -> rb_eq a b
and idx_temp_exprs = fn e2 -> fn (idxs: Val list) -> fn (n: int) ->
  match idxs with
  | Nil -> (Nil : Expr list)
  | Cons (v, rest) -> let nm = "__opi" ++ str_of_int n in let _ = map_set e2 nm v in Cons (EVar nm, idx_temp_exprs e2 rest (n + 1))
and all_digits = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then str_len s > 0
  else if is_digit (char_at s i) then all_digits s (i + 1)
  else false
and gvar_slot = fn (k: str) ->
  if map_has gvar_alias k then (match map_get gvar_alias k with VStr h -> gvar_slot (sget h) | _ -> k) else k
and rx_build_once = fn (body: str) -> fn (fl: str) -> fn (enc: str) -> fn (args: Val list) ->
  if str_contains fl "o" then
    (let site = (match args with Cons (_, Cons (VInt n, _)) -> n | _ -> 0 - 1) in
     if site < 0 then VRegex (body, fl, enc)
     else
       (let f = (if map_has load_ctx "file" then (match map_get load_ctx "file" with VStr h -> sget h | _ -> "") else "") in
        let k = f ++ ":" ++ str_of_int site in
        if map_has rx_once k then map_get rx_once k
        else (let v = VRegex (body, fl, enc) in let _ = map_set rx_once k v in v)))
  else VRegex (body, fl, enc)
and gvar_trace_name = fn (n: str) ->
  gvar_slot (if str_len n > 0 && str_eq (char_at n 0) "$" then substring n 1 (str_len n) else n)
and gvar_readonly = fn (slot: str) ->
  str_eq slot "&" || str_eq slot "`" || str_eq slot "'" || str_eq slot "+"
  || (str_len slot == 1 && slot >= "1" && slot <= "9")
and gvar_readonly_named = fn (n: str) ->
  str_eq n "!" || str_eq n ":" || str_eq n "\"" || str_eq n "<" || str_eq n "?"
  || str_eq n "LOAD_PATH" || str_eq n "-I" || str_eq n "LOADED_FEATURES"
  || str_eq n "FILENAME"
and gvar_must_be_string = fn (n: str) ->
  str_eq n "/" || str_eq n "-0" || str_eq n "\\" || str_eq n ","
and const_assign_key = fn env -> fn (name: str) ->
  let lex0 = (if lv_has env "__cref" then (match lv_get env "__cref" with VStr s2 -> sget s2 | _ -> "") else "") in
  let lex = (if str_eq lex0 "" then cur_lex () else lex0) in
  // ⚠ A SINGLETON innermost segment OWNS the constant by itself. The scope of
  //   `class << self` inside `module M` is "M::(sng:M)" -- the enclosing part
  //   is there so a constant READ in the body continues up M's chain (see
  //   register_class_sng_in) -- but the constant is DEFINED on the singleton,
  //   and `M.singleton_class.constants` looks under "(sng:M)::". Keyed with
  //   the whole scope it landed under "M::(sng:M)::" instead, where no door
  //   could see it: the reflection answered [] and remove_const refused a
  //   constant that was there.
  let owner = const_owner_scope lex in
  if str_eq owner "" then name else owner ++ "::" ++ name

// The part of a lexical scope a constant DEFINED there belongs to. Everything
// but a trailing singleton segment is read-chain only (see const_assign_key).
// ⚠ TRAILING, not anywhere: `class << a; class X; CONST = 1; end; end` has the
//   scope "CS::(sng:117)::X", and X is registered under that whole name -- so
//   stripping back to "(sng:117)::X" put CONST somewhere X's own lookup could
//   not reach. corpus/175 is the witness. Only a scope that ENDS in the
//   singleton is the `class << self` case this rule is for.
and const_owner_scope = fn (lex: str) ->
  let i9 = sng_seg_at lex 0 (0 - 1) in
  if i9 == (0 - 1) then lex else substring lex (i9 + 2) (str_len lex)

// index of the last "::" that is followed by a "(sng:" segment, or -1.
// ⚠ Where a TRAILING singleton segment starts, as the index of the "::" before
//   it (or 0 when the whole scope is one). A singleton segment is
//   "(sng:<inner>)" and its INNER PART MAY ITSELF BE QUALIFIED --
//   "ModuleSpecs::CVars::(sng:ModuleSpecs::CVars)" is one scope with one
//   singleton at the end, and testing "does the tail contain ::" called that
//   two segments and gave up. The test is: the last "(sng:" that begins a
//   segment, with the rest of the string closing it.
and sng_seg_at = fn (k: str) -> fn (i: int) -> fn (best: int) ->
  if i + 4 >= str_len k then best
  else if str_eq (substring k i (i + 5)) "(sng:"
          && (i == 0 || (i >= 2 && str_eq (substring k (i - 2) i) "::"))
          && str_eq (char_at k (str_len k - 1)) ")"
  then sng_seg_at k (i + 1) (if i == 0 then 0 - 2 else i - 2)
  else sng_seg_at k (i + 1) best
and tgt_is_splat = fn (t: str) -> str_len t > 0 && str_eq (char_at t 0) "*"
and is_dsplat = fn (p: str) -> str_len p >= 2 && str_eq (substring p 0 2) "**"
and dsplat_name = fn (ps: str list) ->
  match ps with
  | Nil -> ""
  | Cons (p, r) -> if is_dsplat p then substring p 2 (str_len p) else dsplat_name r
and drop_dsplat = fn (ps: str list) ->
  match ps with
  | Nil -> Nil
  | Cons (p, r) -> if is_dsplat p then drop_dsplat r else Cons (p, drop_dsplat r)
and has_splat = fn (ts: str list) ->
  match ts with Nil -> false | Cons (t, r) -> if tgt_is_splat t then true else has_splat r
and arr_slice = fn (xs: Val list) -> fn (st0: int) -> fn (len: int) ->
  let n = val_list_len xs in
  let st = if st0 < 0 then n + st0 else st0 in
  if st < 0 || st > n || len < 0 then VNil
  else arr_new (vtake (vdrop xs st) len)
and arr_splice = fn (xs: Val list) -> fn (st0: int) -> fn (len0: int) -> fn (v: Val) ->
  let n = val_list_len xs in
  let st1 = if st0 < 0 then n + st0 else st0 in
  let st = if st1 < 0 then 0 else st1 in
  let len = if len0 < 0 then 0 else len0 in
  let pre = (if st <= n then vtake xs st else list_append xs (nil_pad (st - n))) in
  let post = vdrop xs (st + len) in
  let ins = (match v with VArr id2 -> deref id2 | other -> Cons (other, Nil)) in
  list_append pre (list_append ins post)
and nil_pad = fn (k: int) ->
  if k <= 0 then (Nil : Val list) else Cons (VNil, nil_pad (k - 1))
and vlen = fn (xs: Val list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + vlen t
and val_repeat = fn (n: int) -> fn (v: Val) ->
  if n <= 0 then Nil else Cons (v, val_repeat (n - 1) v)
and val_flatten = fn (xs: Val list) -> fn (depth: int) ->
  match xs with
  | Nil -> Nil
  | Cons (VArr id, t) ->
    if depth == 0 then Cons (VArr id, val_flatten t depth)
    else if map_has insp_seen ("a" ++ str_of_int id) then val_flatten t depth
    else
      let _ = map_set insp_seen ("a" ++ str_of_int id) 1 in
      let inner = val_flatten (deref id) (if depth < 0 then depth else depth - 1) in
      let _ = map_delete insp_seen ("a" ++ str_of_int id) in
      list_append inner (val_flatten t depth)
  | Cons (h, t) -> Cons (h, val_flatten t depth)
and val_compact = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VNil, t) -> val_compact t
  | Cons (h, t) -> Cons (h, val_compact t)
and val_tally = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> mkhash acc
  | Cons (h, t) -> let c = (match hash_get acc h with VInt n -> n | _ -> 0) in val_tally t (hash_put acc h (VInt (c + 1)))
and val_minmax = fn (xs: Val list) ->
  match xs with
  | Nil -> arr_new (Cons (VNil, Cons (VNil, Nil)))
  | Cons (h, t) -> arr_new (Cons (val_min t h, Cons (val_max t h, Nil)))
and val_slices = fn (xs: Val list) -> fn (n: int) ->
  match xs with Nil -> Nil | _ -> Cons (arr_new (vtake xs n), val_slices (vdrop xs n) n)
and val_cons_windows = fn (xs: Val list) -> fn (n: int) ->
  if val_list_len xs < n then Nil
  else Cons (arr_new (vtake xs n), val_cons_windows (match xs with Cons (_, t) -> t | Nil -> Nil) n)
and val_to_h = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VArr pid, t) -> (match deref pid with Cons (k, Cons (v, _)) -> Cons (k, Cons (v, val_to_h t)) | _ -> val_to_h t)
  | Cons (_, t) -> val_to_h t
and val_at_or_nil = fn (xs: Val list) -> fn (i: int) ->
  match xs with Nil -> VNil | Cons (h, t) -> if i <= 0 then h else val_at_or_nil t (i - 1)
and val_zip = fn (xs: Val list) -> fn (others: Val list) -> fn (i: int) -> fn (total: int) ->
  if i >= total then Nil
  else Cons (arr_new (Cons (val_at_or_nil xs i, val_zip_row others i)), val_zip xs others (i + 1) total)
and val_zip_row = fn (others: Val list) -> fn (i: int) ->
  match others with
  | Nil -> Nil
  | Cons (VArr id, t) -> Cons (val_at_or_nil (deref id) i, val_zip_row t i)
  | Cons (_, t) -> Cons (VNil, val_zip_row t i)
and val_transpose = fn (rows: Val list) -> fn (col: int) -> fn (ncols: int) ->
  if col >= ncols then Nil
  else Cons (arr_new (val_transpose_col rows col), val_transpose rows (col + 1) ncols)
and val_transpose_col = fn (rows: Val list) -> fn (col: int) ->
  match rows with
  | Nil -> Nil
  | Cons (VArr id, t) -> Cons (val_at_or_nil (deref id) col, val_transpose_col t col)
  | Cons (_, t) -> Cons (VNil, val_transpose_col t col)
and vappend = fn (a: Val list) -> fn (b: Val list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, vappend t b)
and x_is_splat = fn (t: Expr) -> match t with ESplat _ -> true | _ -> false
and xhas_splat = fn (ts: Expr list) ->
  match ts with Nil -> false | Cons (t, r) -> if x_is_splat t then true else xhas_splat r
and xlen = fn (ts: Expr list) -> match ts with Nil -> 0 | Cons (_, t) -> 1 + xlen t
and xbefore_splat = fn (ts: Expr list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if x_is_splat t then Nil else Cons (t, xbefore_splat r)
and xafter_splat = fn (ts: Expr list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if x_is_splat t then r else xafter_splat r
and xsplat_tgt = fn (ts: Expr list) ->
  match ts with
  | Nil -> ENil
  | Cons (t, r) -> (match t with ESplat inner -> inner | _ -> xsplat_tgt r)
and take_until_splat = fn (ts: str list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if tgt_is_splat t then Nil else Cons (t, take_until_splat r)
and after_splat = fn (ts: str list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if tgt_is_splat t then r else after_splat r
and splat_name = fn (ts: str list) ->
  match ts with Nil -> "" | Cons (t, r) -> if tgt_is_splat t then (if str_eq t "*," then "" else substring t 1 (str_len t)) else splat_name r
and list_str_len = fn (ts: str list) -> match ts with Nil -> 0 | Cons (_, t) -> 1 + list_str_len t
and exc_set_cause = fn world -> fn (v: Val) -> fn (cz9: Val) ->
  let (_, _, ocls9, ivars9) = world in
  match v with
  | VObj id9 -> (let _ = map_set ivars9 (str_of_int id9 ++ "@__cause") cz9 in v)
  // the pair representation has nowhere to keep one, so an explicit cause
  // promotes it the same way an in-flight one does (exc_with_cause).
  | VExc (c9, m9) ->
    (match cz9 with
     | VNil -> v
     | _ -> (let id9 = alloc_oid ocls9 in
             let _ = map_set ocls9 id9 c9 in
             let _ = map_set ivars9 (str_of_int id9 ++ "@message") (mkstr m9) in
             let _ = map_set ivars9 (str_of_int id9 ++ "@__cause") cz9 in
             VObj id9))
  | _ -> v
and cause_bt_now = fn (v: Val) ->
  match v with
  | VExc (_, _) ->
    (if map_has raise_bt "v" && map_has globals "!" && rb_eq (map_get globals "!") v
     then map_get raise_bt "v" else VNil)
  | _ -> VNil
and exc_with_cause = fn world -> fn (v: Val) ->
  match v with
  | VExc (c, m) ->
    (if map_has globals "!" then
       (match map_get globals "!" with
        | VNil -> v
        // `raise $!` re-raises the very exception in flight; it is not its own
        // cause, and ruby leaves cause alone for it.
        | prev ->
          (if rb_eq prev v then v
           else
             (let (_, _, ocls9, ivars9) = world in
              let id9 = alloc_oid ocls9 in
              let _ = map_set ocls9 id9 c in
              let _ = map_set ivars9 (str_of_int id9 ++ "@message") (mkstr m) in
              let _ = map_set ivars9 (str_of_int id9 ++ "@__cause") prev in
              let _ = (match cause_bt_now prev with
                       | VNil -> ()
                       | b9 -> map_set ivars9 (str_of_int id9 ++ "@__cause_bt") b9) in
              VObj id9)))
     else v)
  | _ -> v
and errno_ancestor_of = fn world -> fn (cls: str) ->
  let (meths9, sup9, _, _) = world in
  if str_len cls > 7 && str_eq (substring cls 0 7) "Errno::" then cls
  else if map_has sup9 cls then errno_ancestor_of world (map_get sup9 cls)
  else ""
and errno_desc = fn (n: str) ->
  // the oracle's own text first; the hand-written rows below stay as the
  // fallback for a name the table does not carry.
  let _ = errno_build () in
  if map_has errno_txt_tbl n then map_get errno_txt_tbl n
  else if str_eq n "ENOENT" then "No such file or directory"
  else if str_eq n "ECONNREFUSED" then "Connection refused"
  else if str_eq n "ECONNRESET" then "Connection reset by peer"
  else if str_eq n "EADDRINUSE" then "Address already in use"
  else if str_eq n "EPIPE" then "Broken pipe"
  else if str_eq n "EAGAIN" then "Resource temporarily unavailable"
  else if str_eq n "EINPROGRESS" then "Operation now in progress"
  else if str_eq n "EALREADY" then "Operation already in progress"
  else if str_eq n "EISCONN" then "Socket is already connected"
  else if str_eq n "ENOTCONN" then "Socket is not connected"
  else if str_eq n "ETIMEDOUT" then "Operation timed out"
  else if str_eq n "EHOSTUNREACH" then "No route to host"
  else if str_eq n "ENETUNREACH" then "Network is unreachable"
  else if str_eq n "ECONNABORTED" then "Software caused connection abort"
  else if str_eq n "EBADF" then "Bad file descriptor"
  else if str_eq n "EINTR" then "Interrupted system call"
  else if str_eq n "EINVAL" then "Invalid argument"
  else if str_eq n "EMFILE" then "Too many open files"
  else if str_eq n "ENOTDIR" then "Not a directory"
  else if str_eq n "EEXIST" then "File exists"
  else if str_eq n "EACCES" then "Permission denied"
  else if str_eq n "ENOSPC" then "No space left on device"
  else if str_eq n "ESPIPE" then "Illegal seek"
  else if str_eq n "ENOMEM" then "Cannot allocate memory"
  else if str_eq n "EIO" then "Input/output error"
  else if str_eq n "EPROTO" then "Protocol error"
  else if str_eq n "ENOTSUP" then "Operation not supported"
  else ""
and errno_desc_missing = fn (names: str list) ->
  (match names with
   | Nil -> Nil
   | Cons (n, rest) ->
     (let short = (if str_len n > 7 && str_eq (substring n 0 7) "Errno::" then substring n 7 (str_len n) else "") in
      if str_eq short "" then errno_desc_missing rest
      else if str_eq (errno_desc short) "" then Cons (n, errno_desc_missing rest)
      else errno_desc_missing rest))
and errno_message = fn (c: str) -> fn (given: str) -> fn (have_msg: bool) ->
  (let d = errno_desc (substring c 7 (str_len c)) in
   if str_eq d "" then (if have_msg then given else c)
   else if have_msg then d ++ " - " ++ given
   else d)
and make_exc = fn (args: Val list) ->
  match args with
  // bare `raise` yields a RuntimeError whose message is empty (not the
  // class name — that is what `RuntimeError.new` without an arg gives).
  | Nil -> VExc ("RuntimeError", "")
  | Cons (VStr msg, _) -> let msg = sget msg in VExc ("RuntimeError", msg)
  | Cons (VClass c, rest) ->
    (let is_errno = str_len c > 7 && str_eq (substring c 0 7) "Errno::" in
     match rest with
     | Cons (VStr m, _) ->
       (let m = sget m in
        if is_errno then VExc (c, errno_message c m true) else VExc (c, m))
     | _ -> (if is_errno then VExc (c, errno_message c "" false) else VExc (c, c)))
  | Cons (VExc (c, m), _) -> VExc (c, m)
  | Cons (v, _) -> VExc ("RuntimeError", to_s v)
and rescue_matches = fn world -> fn (exc: Val) -> fn (classes: str list) ->
  match exc with
  | VExc (ecls, _) ->
    (match classes with
     | Nil -> exc_is_a world ecls "StandardError"
     | _ -> any_class_matches world ecls classes)
  // a user exception is a live object; match on its class.
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let ecls = map_get ocls id in
    (match classes with
     | Nil -> exc_is_a world ecls "StandardError"
     | _ -> any_class_matches world ecls classes)
  | _ -> false
and any_class_matches = fn world -> fn (ecls: str) -> fn (classes: str list) ->
  match classes with
  | Nil -> false
  | Cons (c, rest) ->
    if exc_is_a world ecls c then true
    // A rescue clause names a CONSTANT, and a constant can hold a class under
    // another name: `Err = Class.new(StandardError)` is how most gems declare
    // one, and `Alias = ArgumentError` happens too. Matching the written name
    // against the exception's class name misses both -- the raise worked, the
    // rescue did not, and the program died with the exception it had just
    // written a handler for. So if the name did not match directly, resolve it
    // and try the class it holds.
    else if (if map_has consts c then true else false)
            && (match map_get consts c with VClass _ -> true | _ -> false)
            && (match map_get consts c with VClass rc -> exc_is_a world ecls rc | _ -> false)
    then true
    else any_class_matches world ecls rest
and exc_is_a = fn world -> fn (ecls: str) -> fn (target: str) ->
  if str_eq ecls target then true
  else
    let (meths, sup, ocls, ivars) = world in
    if map_has sup ecls then exc_is_a world (map_get sup ecls) target else false
and class_names_of = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (VClass c, t) -> Cons (c, class_names_of t) | Cons (_, t) -> class_names_of t
and raise_system_exit = fn world -> fn (status: int) -> fn (msg: str) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  let _ = map_set ocls id "SystemExit" in
  let _ = map_set ivars (str_of_int id ++ "@__status") (VInt status) in
  let _ = map_set ivars (str_of_int id ++ "@message") (mkstr msg) in
  // re_raise never returns (it fails); the VNil gives this a Val type for the
  // primitive dispatchers that call it in value position.
  let _ = re_raise world (VObj id) in
  VNil
and raise_exc_iv = fn world -> fn (cls: str) -> fn (msg: str) -> fn (fields: (str * Val) list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  let _ = map_set ocls id cls in
  let _ = map_set ivars (str_of_int id ++ "@message") (mkstr msg) in
  let rec put = fn (fs: (str * Val) list) ->
    (match fs with
     | Nil -> ()
     | Cons ((nm, v), t) -> (let _ = map_set ivars (str_of_int id ++ "@" ++ nm) v in put t)) in
  let _ = put fields in
  let _ = note_raise_site () in
  let bt9 = arr_new (caller_frames 0) in
  let _ = map_set raise_bt "v" bt9 in
  // ...on the OBJECT as well: #backtrace reads the exception's own @__bt, and
  // an object raised without one answered nil where the pair form answers the
  // frames (`e.backtrace.first` then said undefined method 'first').
  let _ = map_set ivars (str_of_int id ++ "@__bt") bt9 in
  let _ = if map_has prim_missing "n" then map_delete prim_missing "n" else () in
  let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
  let _ = re_raise world (VObj id) in
  VNil
and re_raise = fn world -> fn (exc: Val) ->
  let (meths, sup, ocls, ivars) = world in
  let _ = map_set ivars "$exc" exc in
  (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (exception re-raised past all rescues)")) in fail "mere-ruby: (exception re-raised past all rescues)")
and raise_exc = fn world -> fn (cls: str) -> fn (msg: str) ->
  let (meths, sup, ocls, ivars) = world in
  let _ = map_set ivars "$exc" (VExc (cls, msg)) in
  // remember WHERE, while the loader still knows: load_ctx "file" is restored
  // as each require returns, so by the time an error reaches the top level it
  // names the entry script and not the library that actually failed.
  let _ = (if map_has prim_missing "f" then ()
           else map_set prim_missing "f" (if map_has load_ctx "file" then map_get load_ctx "file" else mkstr "")) in
  // ... and the line and method it happened IN, for the same reason: each frame
  // puts the caller's line back as it unwinds, so by the time this reaches the
  // top level, reading the current line would name the call site instead.
  let _ = note_raise_site () in
  let _ = map_set raise_bt "v" (arr_new (caller_frames 0)) in
  let _ = if map_has prim_missing "n" then map_delete prim_missing "n" else () in
  // a real Ruby exception must never inherit a stale internal-failure message
  let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

  // The message names the class and text it was given. It used to say only
  // "(built-in exception raised)", which is what reaches the terminal whenever a
  // raise escapes before the top level's formatter is in place -- and it named
  // neither what was raised nor why, so the only way to find out was to add a
  // print here. `raise_exc` is holding both arguments; discarding them cost
  // nothing to keep.
  let __what = "mere-ruby: " ++ cls ++ (if str_len msg == 0 then "" else ": " ++ msg) ++ " (raised before the top level could format it)" in
  (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __what)) in fail __what)
and strip_yblk_markers = fn encl -> fn (ps: str list) ->
  match ps with
  | Cons (m, rest) ->
    if str_len m > 9 && str_eq (substring m 0 9) yblk_marker
    then strip_yblk_markers (map_get proc_yblk (substring m 9 (str_len m))) rest
    else (encl, ps)
  | _ -> (encl, ps)
and drop_yblk_params = fn (ps: str list) ->
  match ps with
  | Cons (m, rest) ->
    if str_len m > 9 && str_eq (substring m 0 9) yblk_marker then drop_yblk_params rest else ps
  | _ -> ps
and is_for_params = fn (ps: str list) ->
  match ps with
  | Cons (p0, _) ->
    let p = if str_len p0 > 0 && str_eq (char_at p0 0) "*" then substring p0 1 (str_len p0) else p0 in
    str_len p > 2 && str_eq (substring p 0 3) "__f"
  | _ -> false
and invcmp_id = fn (v: Val) ->
  match v with
  | VStr h -> "s" ++ str_of_int h
  | VObj i -> "o" ++ str_of_int i
  | VArr i -> "a" ++ str_of_int i
  | VHsh i -> "h" ++ str_of_int i
  | VProc i -> "p" ++ str_of_int i
  | _ -> "v" ++ to_s v
and flow_value = fn (f: Flow) ->
  match f with FNext v -> v | FReturn v -> v | FRaise v -> v | FBreak v -> v | FLoopNext v -> v
and bind_block_kws = fn cenv -> fn world -> fn (bdefaults: (str * Expr) list) -> fn (kws: str list) -> fn (kwhash: Val list) ->
  match kws with
  | Nil -> ()
  | Cons (p, rest) ->
    let nm = substring p 0 (str_len p - 1) in
    // a keyword arg that is present binds; a missing OPTIONAL keyword binds nil
    // (the body's nil-check prologue then applies its default); a missing
    // REQUIRED keyword (no default) raises ArgumentError.
    let _ =
      if hash_haskey kwhash (VSym nm) then map_set cenv nm (hash_get kwhash (VSym nm))
      else if has_default bdefaults nm then map_set cenv nm VNil
      else (let _ = raise_exc world "ArgumentError" ("missing keyword: :" ++ nm) in ()) in
    bind_block_kws cenv world bdefaults rest kwhash
and bind_numbered = fn cenv -> fn (argvals: Val list) -> fn (n: int) ->
  if n > 9 then ()
  else
    (match argvals with
     | Nil -> let _ = map_set cenv ("_" ++ str_of_int n) VNil in bind_numbered cenv Nil (n + 1)
     | Cons (a, rest) -> let _ = map_set cenv ("_" ++ str_of_int n) a in bind_numbered cenv rest (n + 1))
and spec_split = fn (spec: str) -> fn (i: int) -> fn (depth: int) -> fn (cur: str) -> fn (acc: str list) ->
  if i >= str_len spec then rev_app (Cons (cur, acc)) Nil
  else
    let c = char_at spec i in
    if str_eq c "(" then spec_split spec (i + 1) (depth + 1) (cur ++ c) acc
    else if str_eq c ")" then spec_split spec (i + 1) (depth - 1) (cur ++ c) acc
    else if str_eq c "," && depth == 0 then spec_split spec (i + 1) depth "" (Cons (cur, acc))
    else spec_split spec (i + 1) depth (cur ++ c) acc
and rng_bs_kind = fn (v: Val) ->
  match v with VInt _ -> 0 | VBig _ -> 0 | VNil -> 0 | VFlt _ -> 1 | _ -> 2
and flt_ord = fn (x: float) ->
  let (sg, e, fr) = flt_bits64 x in
  let m = e * 4503599627370496 + fr in
  if sg == 1 then 0 - m else m
and flt_of_ord = fn (o: int) ->
  let neg = o < 0 in
  let m = (if neg then 0 - o else o) in
  let e = floor_div m 4503599627370496 in
  let fr = floor_mod m 4503599627370496 in
  let a = (if e >= 2047 then 1.0 / 0.0
           else if e == 0 then ldexp (float_of_int fr) (0 - 1074)
           else ldexp (1.0 + float_of_int fr / 4503599627370496.0) (e - 1023)) in
  if neg then 0.0 - a else a
and enum_arg_iter = fn (name: str) ->
  (str_len name == 10 && str_eq name "each_slice") || (str_len name == 9 && str_eq name "each_cons") || (str_len name == 5 && str_eq name "cycle")
  // Every method that YIELDS returns an Enumerator when called without a block
  // -- that is the convention, not a property of the ones listed above, and
  // these eight were yielding without being listed. `{}.each_key` raised
  // NoMethodError where ruby hands back an Enumerator, and ENV inherits the
  // same answer through its hash delegation. The list is the gate's only input
  // (one site: dispatch checks it before the with-block arms), so a name that
  // yields and is missing here has no blockless form at all.
  // bsearch / bsearch_index / the repeated_* generators yield too, and a
  // blockless call to any of them is an Enumerator like every other yielder
  // (these four answered NoMethodError instead).
  // #chunk was the one of the four grouping names this list did not have, so
  // an Enumerable answered chunk_while and slice_when and NoMethodError for
  // chunk -- three names for one shape, and the odd one out was a typo-shaped
  // omission rather than a decision.
and hash_enum_delegate = fn (name: str) ->
  map_has (name_set "hash_enum_delegate") name
and enum_zero_arity = fn (name: str) ->
  map_has (name_set "enum_zero_arity") name
and enum_needs_block = fn (name: str) ->
  map_has (name_set "enum_needs_block") name
and is_enum_method = fn (name: str) ->
  map_has (name_set "is_enum_method") name
and iter_result = fn (f: Flow) -> fn (dflt: Val) ->
  match f with FBreak v -> v | FNext v -> v | other -> dflt
and iter_each_result = fn (f: Flow) -> fn (recv: Val) ->
  match f with FBreak v -> v | _ -> recv
and str_succ_n = fn (cur: str) -> fn (k: int) ->
  if k <= 0 then cur else str_succ_n (str_succ cur) (k - 1)
and every_kth = fn (xs: Val list) -> fn (k: int) -> fn (i: int) -> fn (acc: Val list) ->
  match xs with
  | Nil -> rev_app acc Nil
  | Cons (h, t) -> every_kth t k (i + 1) (if floor_mod i k == 0 then Cons (h, acc) else acc)
and chunk_key_drops = fn (k: Val) ->
  (match k with VNil -> true | VSym s9 -> str_eq s9 "_separator" | _ -> false)
and chunk_key_alone = fn (k: Val) ->
  (match k with VSym s9 -> str_eq s9 "_alone" | _ -> false)
and chunk_check_key = fn world -> fn (k: Val) ->
  (match k with
   | VSym s9 ->
     (if str_len s9 > 0 && str_eq (char_at s9 0) "_"
         && (if str_eq s9 "_alone" then false else true)
         && (if str_eq s9 "_separator" then false else true)
      then (let _ = raise_exc world "RuntimeError"
              "symbols beginning with an underscore are reserved" in ())
      else ())
   | _ -> ())
and pair_key = fn (p: Val) -> match p with VArr id -> (match deref id with Cons (k, _) -> k | _ -> VNil) | _ -> VNil
and pair_val = fn (p: Val) -> match p with VArr id -> (match deref id with Cons (_, Cons (v, _)) -> v | _ -> VNil) | _ -> VNil
and extract_vals = fn (ps: Val list) -> match ps with Nil -> Nil | Cons (h, t) -> Cons (pair_val h, extract_vals t)
and array_new_args = fn (args: Val list) ->
  match args with
  | Cons (VInt n, Cons (d, _)) -> arr_new (val_repeat n d)
  | Cons (VInt n, _) -> arr_new (val_repeat n VNil)
  | Cons (VArr aid, _) -> arr_new (deref aid)
  | _ -> arr_new Nil
and array_new_size = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Cons (VInt n, _) ->
    (if n < 0 then (let _ = raise_exc world "ArgumentError" "negative array size" in 0)
     else if n > 1073741823 then (let _ = raise_exc world "ArgumentError" "array size too big" in 0)
     else n)
  | Cons (VBig _, _) -> (let _ = raise_exc world "ArgumentError" "array size too big" in 0)
  | Nil -> 0
  // an ARRAY as the size (with a second argument) is not a size at all, and
  // neither is a String or any other value that has no #to_int.
  | Cons (other, _) ->
    (let _ = raise_exc world "TypeError"
               ("no implicit conversion of " ++ class_name other ++ " into Integer") in 0)
and hng_key = fn (recv: Val) ->
  match recv with
  | VStr h -> "str:" ++ str_of_int h
  | VArr h -> "arr:" ++ str_of_int h
  | VHsh h -> "hsh:" ++ str_of_int h
  | _ -> ""
and imm_no_singleton = fn (recv: Val) ->
  match recv with VInt _ -> true | VBig _ -> true | VFlt _ -> true | VSym _ -> true | VRat _ -> true | VCpx _ -> true | _ -> false
and body_defines = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (s, rest) ->
    (match s with SDef (_, _, _, _) -> true | SClass (_, _, _) -> true | SClassE (_, _, _) -> true | SAssign (n, _) -> is_upper_first n | _ -> false)
    || body_defines rest
and builtin_rep_val = fn (c: str) ->
  if str_eq c "Integer" then VInt 0
  else if str_eq c "Float" then VFlt 0.0
  else if str_eq c "Rational" then VRat ("0", "1")
  else if str_eq c "Complex" then VCpx (VInt 0, VInt 0)
  else if str_eq c "String" then mkstr ""
  else if str_eq c "Symbol" then VSym ""
  else if str_eq c "Array" then arr_new (Nil : Val list)
  else if str_eq c "Hash" then mkhash (Nil : Val list)
  else if str_eq c "TrueClass" then VBool true
  else if str_eq c "FalseClass" then VBool false
  else if str_eq c "NilClass" then VNil
  else if str_eq c "Range" then VRange (VInt 0, VInt 0, false)
  else if str_eq c "Proc" then VProc 0
  else if str_eq c "Regexp" then VRegex ("", "", "")
  else VMain
  // == / === / != are dispatched the same way (eval_bin_prim, not a table
  // entry), so reflection has to count them as operators too: `Float#===` is
  // the alias of `Float#==` a spec compares as UnboundMethods.
and is_binary_op_name = fn (s: str) ->
  str_eq s "|" ||
  map_has (name_set "is_binary_op_name") s
and blt_alias_lookup = fn world -> fn (anc: str list) -> fn (name: str) ->
  match anc with
  | Nil -> ""
  | Cons (a, rest) ->
    if map_has builtin_alias (a ++ "#" ++ name) then map_get builtin_alias (a ++ "#" ++ name)
    else blt_alias_lookup world rest name
and r2k_root = fn (k: str) ->
  if map_has proc_origin k
  then (match map_get proc_origin k with VInt n9 -> str_of_int n9 | _ -> k)
  else k
and proc_copy = fn (pid: int) ->
  let np = map_len proc_store in
  let nk = str_of_int np in
  let ok = str_of_int pid in
  let _ = map_set proc_store nk (map_get proc_store ok) in
  let _ = (if map_has lambda_ids ok then (let _ = map_set lambda_ids nk (map_get lambda_ids ok) in ()) else ()) in
  let _ = (if map_has proc_arity ok then (let _ = map_set proc_arity nk (map_get proc_arity ok) in ()) else ()) in
  let _ = (if map_has proc_yblk ok then (let _ = map_set proc_yblk nk (map_get proc_yblk ok) in ()) else ()) in
  let _ = (if map_has proc_symsrc ok then (let _ = map_set proc_symsrc nk (map_get proc_symsrc ok) in ()) else ()) in
  let _ = (if map_has proc_home ok then (let _ = map_set proc_home nk (map_get proc_home ok) in ()) else ()) in
  let _ = (if map_has curry_target ok then (let _ = map_set curry_target nk (map_get curry_target ok) in ()) else ()) in
  // the ROOT id, as a VInt: a string here would be a handle into the string
  // store, and this table is not a GC root.
  let _ = map_set proc_origin nk (VInt (int_of_str (r2k_root ok))) in
  // the definition site is two entries: the line under the id, the file under "f" ++ id
  let _ = (if map_has proc_src ok then (let _ = map_set proc_src nk (map_get proc_src ok) in ()) else ()) in
  let _ = (if map_has proc_src ("f" ++ ok) then (let _ = map_set proc_src ("f" ++ nk) (map_get proc_src ("f" ++ ok)) in ()) else ()) in
  np
and set_builtin_alias = fn world -> fn (cls: str) -> fn (n1: str) -> fn (n2: str) ->
  let (meths9, sup9, ocls9, ivars9) = world in
  let src = (if map_has builtin_alias (cls ++ "#" ++ n2)
             then map_get builtin_alias (cls ++ "#" ++ n2) else n2) in
  let _ = (if map_has meths9 (cls ++ "#" ++ n1) then del_meth meths9 (cls ++ "#" ++ n1) else ()) in
  let _ = (if map_has undefs (cls ++ "#" ++ n1) then del_undef (cls ++ "#" ++ n1) else ()) in
  map_set builtin_alias (cls ++ "#" ++ n1) src
and cmp_comparable = fn (a: Val) -> fn (b: Val) ->
  let num = fn (v: Val) -> (match v with VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat (_, _) -> true | _ -> false) in
  (num a && num b)
  || (match (a, b) with
      | (VStr _, VStr _) -> true
      | (VSym _, VSym _) -> true
      | (VNil, VNil) -> true
      | (VBool _, VBool _) -> true
      | _ -> false)
and hash_subset_of = fn world -> fn (xs: Val list) -> fn (ys: Val list) -> fn (ci: bool) ->
  match xs with
  | Cons (k, Cons (v, t)) ->
    (if hash_haskey_x ci ys k && rb_eq (hash_get_x ci ys k) v
     then hash_subset_of world t ys ci else false)
  | _ -> true
and hash_values_of = fn (xs: Val list) ->
  match xs with
  | Cons (_, Cons (v, t)) -> Cons (v, hash_values_of t)
  | _ -> (Nil : Val list)
and hstored_key = fn (hid: int) -> fn (k: Val) ->
  let ki9 = (match k with
             | VObj i9 -> "o" ++ str_of_int i9
             | VArr i9 -> "a" ++ str_of_int i9
             | VHsh i9 -> "h" ++ str_of_int i9
             | _ -> "") in
  if str_eq ki9 "" then "" else str_of_int hid ++ "|" ++ ki9
and elem_has_vobj = fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (h, t) -> (match h with VObj _ -> true | _ -> elem_has_vobj t)
and enc_escape_txt = fn (enc: str) -> fn (s: str) ->
  let rec go = fn (cps: int list) -> fn (acc: str) ->
    (match cps with
     | Nil -> acc
     | Cons (c, t) ->
       go t (acc ++ (if c < 128 then chr c
                     else if c > 65535 then chr 92 ++ "u" ++ chr 123 ++ hex_uc c ++ chr 125
                     else chr 92 ++ "u" ++ hex4 c))) in
  go (decode_cps s enc 0) ""
and hex_pad16 = fn (n: int) ->
  let h = int_to_base n 16 in
  let rec pad = fn (k: int) -> fn (acc: str) -> if k <= 0 then acc else pad (k - 1) ("0" ++ acc) in
  pad (16 - str_len h) "" ++ h
and ivar_names_of = fn iv -> fn (oid: int) ->
  let pfx = str_of_int oid ++ "@" in
  let plen = str_len pfx in
  let tmp = map_new () in
  let _ = map_iter iv (fn (k: str) -> fn (v: Val) ->
    // a Struct member's SLOT is not an instance variable, in any listing
    // (struct_slot): it is where the member lives, not something the object
    // was told to remember.
    if str_len k > plen && str_eq (substring k 0 plen) pfx
       && (if struct_is_slot k then false else true)
    then (let m = map_len tmp in map_set tmp (str_of_int m) (mkstr (substring k plen (str_len k))))
    else ()) in
  ivar_names_go tmp 0 (map_len tmp) Nil
and ivar_names_go = fn tmp -> fn (i: int) -> fn (n: int) -> fn (acc: str list) ->
  if i >= n then rev_app acc Nil
  else ivar_names_go tmp (i + 1) n
         (Cons ((match map_get tmp (str_of_int i) with VStr h -> sget h | _ -> ""), acc))
and vlast = fn (xs: Val list) -> match xs with Cons (x, Nil) -> x | Cons (_, t) -> vlast t | Nil -> VNil
and numbered_digit = fn (s: str) ->
  if str_len s == 2 && str_eq (char_at s 0) "_" && (let d = char_at s 1 in is_digit d && (if str_eq d "0" then false else true))
  then ord (char_at s 1) - 48 else 0
and imax = fn (a: int) -> fn (b: int) -> if a > b then a else b
and bnd_snapshot = fn env ->
  let src9 = lv_flat env in
  let dst9 = map_new () in
  let _ = map_iter src9 (fn (k9: str) -> fn (v9: Val) ->
            if numbered_digit k9 > 0 then () else (let _ = map_set dst9 k9 v9 in ())) in
  dst9
and bnd_is_local = fn (k: str) ->
  (if str_eq k "self" then false
   else if str_len k >= 2 && str_eq (substring k 0 2) "__" then false
   else if numbered_digit k > 0 then false
   else if str_eq k "it" then false
   else true)
and numbered_params_meta = fn (is_lam: bool) -> fn (i: int) -> fn (n: int) ->
  if i > n then Nil
  else Cons (arr_new (Cons (VSym (if is_lam then "req" else "opt"), Cons (VSym ("_" ++ str_of_int i), Nil))), numbered_params_meta is_lam (i + 1) n)
and strip_marker_params = fn (params: str list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) ->
    if str_eq p empty_bp_marker || str_eq p lambda_blk_marker
    then strip_marker_params r else Cons (p, strip_marker_params r)
and blk_arity = fn (is_lam: bool) -> fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  let n = mandatory_pos_count (pos_params ps) ds + (if kw_any ps ds true then 1 else 0) in
  // `**k` is not a positional splat: it does not relax a proc's count.
  // ⚠ ...and an OPTIONAL keyword only relaxes it when there is no REQUIRED
  // one. `->(a, c:, d: 1).arity` is 2 in ruby, not -3: the required `c:` makes
  // the keyword hash mandatory and `d:` cannot un-make it. bm_arity_go, which
  // answers this for a METHOD, has had the rule right all along -- one
  // question with two implementations, and only one of them was asked by the
  // spec that noticed.
  if pos_splat_any ps
     || (is_lam && (block_default_any (pos_params ps) ds
                    || (kw_any ps ds false && (if kw_any ps ds true then false else true))))
  then 0 - (n + 1) else n
and pos_splat_any = fn (ps: str list) ->
  match ps with
  | Nil -> false
  // ⚠ the trailing comma's implicit rest is not a splat for ARITY either:
  // `proc { |x,| }.arity` is 1 in ruby and was -2 here, because the marker
  // this interpreter writes as `*,` looked like `*rest` to the count.
  | Cons ("*,", r) -> pos_splat_any r
  | Cons (p, r) ->
    (str_len p > 0 && str_eq (char_at p 0) "*" && (if str_len p >= 2 && str_eq (substring p 0 2) "**" then false else true))
    || pos_splat_any r
and kw_any = fn (ps: str list) -> fn (ds: (str * Expr) list) -> fn (want_req: bool) ->
  match ps with
  | Nil -> false
  | Cons (p, rest) ->
    (if str_len p >= 2 && str_eq (substring p 0 2) "**" then (if want_req then kw_any rest ds want_req else true)
     else if str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":" then
       (let has = bm_has_default ds p || bm_has_default ds (substring p 0 (str_len p - 1)) in
        if (if want_req then (if has then false else true) else has) then true else kw_any rest ds want_req)
     else kw_any rest ds want_req)
and takes_include_all = fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  positional_slots ps > 1
and takes_optional_second = fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  match ps with
  | Cons (_, Cons (p2, _)) ->
    (if str_len p2 > 0 && (str_eq (char_at p2 0) "*" || str_eq (char_at p2 0) "&") then false
     else if str_len p2 > 0 && str_eq (char_at p2 (str_len p2 - 1)) ":" then false
     else defaults_has ds p2)
  | _ -> false
and defaults_has = fn (ds: (str * Expr) list) -> fn (n: str) ->
  match ds with
  | Nil -> false
  | Cons ((dn, _), t) -> str_eq dn n || defaults_has t n
and positional_slots = fn (ps: str list) ->
  match ps with
  | Nil -> 0
  | Cons (p, rest) ->
    if str_len p > 0 && str_eq (char_at p 0) "&" then positional_slots rest
    else if str_len p > 0 && str_eq (char_at p 0) "*" then 2 + positional_slots rest
    else if str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":" then positional_slots rest
    else 1 + positional_slots rest
and mandatory_pos_count = fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  match ps with
  | Nil -> 0
  | Cons (p, rest) ->
    if str_len p > 0 && (str_eq (char_at p 0) "*" || str_eq (char_at p 0) "&") then mandatory_pos_count rest ds
    else if bm_has_default ds p then mandatory_pos_count rest ds
    else 1 + mandatory_pos_count rest ds
and block_default_any = fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  match ps with
  | Nil -> false
  | Cons (p, rest) -> bm_has_default ds p || block_default_any rest ds
// ⚠ the name a parameter REPORTS, which is not always the name it is stored
// under. Ruby lets `_` repeat in one list, so the parser gives each repeat a
// unique internal key (`_~1`, `_~2`, ...) to bind distinct slots -- and
// #parameters printed those keys: `:"_~1"` in a program's own output, for a
// parameter the program wrote as `_`.
and param_report_name = fn (n: str) ->
  let rec cut = fn (i: int) ->
    if i >= str_len n then n
    else if str_eq (char_at n i) "~" then substring n 0 i
    else cut (i + 1) in
  if str_len n >= 2 && str_eq (substring n 0 2) "_~" then "_" else cut 0
and param_meta_of = fn (is_lam: bool) -> fn (ps: str list) -> fn (ds: (str * Expr) list) ->
  match ps with
  | Nil -> Nil
  // the splat a lambda with defaults carries internally is not a parameter
  | Cons ("*__opt", rest) -> param_meta_of is_lam rest ds
  // ...nor is the sentinel an explicit-but-empty `||` carries. It is stripped
  // before the block RUNS, but #parameters read the list as written and
  // reported `[[:req, :"~emptyparams~"]]` -- a bookkeeping name of this
  // interpreter's, in a program's own output, for a block that takes nothing.
  | Cons ("~emptyparams~", rest) -> param_meta_of is_lam rest ds
  // an attr_writer's argument has no name to report
  | Cons ("__attr_v", rest) -> Cons (arr_new (Cons (VSym "req", Nil)), param_meta_of is_lam rest ds)
  // ...nor is the implicit rest of a TRAILING COMMA (`|x,|`), which this
  // interpreter carries as a splat named ",". It is what makes the block
  // destructure its argument, and ruby does not show it: `proc { |x,| }`
  // answers [[:opt, :x]] and reported [[:opt, :x], [:rest, :","]] here.
  | Cons ("*,", rest) -> param_meta_of is_lam rest ds
  | Cons (p, rest) ->
    let pair =
      (if str_len p >= 2 && str_eq (substring p 0 2) "**" then
         (let n = substring p 2 (str_len p) in
          if str_eq n "nil" then arr_new (Cons (VSym "nokey", Nil))
          // ruby names an anonymous keyrest :** and an anonymous block :&, so
          // the hidden names the parser gives them are reported that way.
          else arr_new (Cons (VSym "keyrest", Cons (VSym (if str_eq n "" || str_eq n "__anonkw" then "**" else param_report_name n), Nil))))
       else if str_len p > 0 && str_eq (char_at p 0) "*" then
         (let n = substring p 1 (str_len p) in
          arr_new (Cons (VSym "rest", Cons (VSym (if str_eq n "" then "*" else param_report_name n), Nil))))
       else if str_len p > 0 && str_eq (char_at p 0) "&" then
         (let n = substring p 1 (str_len p) in
          arr_new (Cons (VSym "block", Cons (VSym (if str_eq n "" || str_eq n "__anonblk" then "&" else param_report_name n), Nil))))
       // a keyword is stored as "name:"; it is required unless it has a default
       else if str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":" then
         (let n = substring p 0 (str_len p - 1) in
          arr_new (Cons (VSym (if bm_has_default ds p || bm_has_default ds n then "key" else "keyreq"), Cons (VSym (param_report_name n), Nil))))
       else if bm_has_default ds p then arr_new (Cons (VSym "opt", Cons (VSym (param_report_name p), Nil)))
       // a block's positional parameters are all optional; a lambda's are not.
       // A destructuring parameter `(a, b)` has no name of its own: ruby 4.0
       // answers `[:opt]` / `[:req]` alone (3.4 said `[:opt, nil]`).
       else if str_len p > 0 && str_eq (char_at p 0) "(" then arr_new (Cons (VSym (if is_lam then "req" else "opt"), Nil))
       else arr_new (Cons (VSym (if is_lam then "req" else "opt"), Cons (VSym (param_report_name p), Nil)))) in
    Cons (pair, param_meta_of is_lam rest ds)
and mark_toplevel_private = fn meths -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let _ = (if map_has meths ("Object#" ++ n) then map_set privates ("Object#" ++ n) VNil else ()) in
    mark_toplevel_private meths rest
and publish_toplevel = fn meths -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let _ = (if map_has meths n then set_meth meths ("Object#" ++ n) (map_get meths n) else ()) in
    // the def already installed a PRIVATE Object entry; `public` lifts the mark.
    let _ = (if map_has privates ("Object#" ++ n) then map_delete privates ("Object#" ++ n) else ()) in
    publish_toplevel meths rest
and at_exit_list = fn (i: int) -> fn (n: int) -> fn (acc: Val list) ->
  if i >= n then acc
  else at_exit_list (i + 1) n (if map_has at_exits (str_of_int i) then Cons (map_get at_exits (str_of_int i), acc) else acc)
and mk_composed = fn world -> fn (inner: Val) -> fn (outer: Val) ->
  let cid = map_len proc_store in
  let _ = store_proc (str_of_int cid) (true, (Nil : str list), (Nil : Stmt list), map_new ()) in
  let _ = map_set comp_inner (str_of_int cid) inner in
  let _ = map_set comp_outer (str_of_int cid) outer in
  let _ = (match inner with
           | VProc ip -> (if map_has lambda_ids (str_of_int ip) then map_set lambda_ids (str_of_int cid) VNil else ())
           | _ -> ()) in
  VProc cid
and mk_curried = fn world -> fn (tgt: int) -> fn (got: Val list) -> fn (want: int) -> fn (like: int) ->
  let cid = map_len proc_store in
  let _ = store_proc (str_of_int cid) (true, (Nil : str list), (Nil : Stmt list), map_new ()) in
  let _ = map_set curry_target (str_of_int cid) (VInt tgt) in
  let _ = map_set curry_args (str_of_int cid) (arr_new got) in
  let _ = map_set curry_arity (str_of_int cid) (VInt want) in
  let _ = (if map_has lambda_ids (str_of_int like) then map_set lambda_ids (str_of_int cid) VNil else ()) in
  VProc cid
and proc_as_block = fn (pid: int) ->
  let t = map_get proc_store (str_of_int pid) in
  // a lambda enforces strict arity; a proc that captured a defining-method
  // block carries a yblk marker so run_block reinstates that block for `yield`.
  let t = (if map_has lambda_ids (str_of_int pid) then
             (match t with (h, ps, b, e) -> (h, Cons (lambda_blk_marker, ps), b, e))
           else t) in
  if map_has proc_yblk (str_of_int pid) then
    (match t with (h, ps, b, e) -> (h, Cons (yblk_marker ++ str_of_int pid, ps), b, e))
  else t
and arg_beats_block = fn (name: str) ->
  (str_len name == 4 && str_eq name "any?") || (str_len name == 4 && str_eq name "all?") || (str_len name == 5 && str_eq name "none?") ||
  (str_len name == 4 && str_eq name "one?") || (str_len name == 5 && str_eq name "count") ||
  (str_len name == 10 && str_eq name "find_index") || (str_len name == 6 && str_eq name "rindex")
and block_supersedes_default = fn world -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  (match args with
   | Cons (_, Cons (_, _)) ->
     (if (str_len name == 5 && str_eq name "fetch") then
        (match recv with
         | VHsh _ -> true
         | VArr _ -> true
         | VObj oid9 -> (let (m9, s9, ocls9, iv9) = world in str_eq (map_get ocls9 oid9) "EnvHash")
         | _ -> false)
      else if (str_len name == 3 && str_eq name "new") then
        (match recv with VClass c9 -> str_eq c9 "Array" | _ -> false)
      else false)
   | _ -> false)
and ivar_arg_name = fn (nm: str) ->
  if str_len nm > 0 && str_eq (char_at nm 0) "@" then substring nm 1 (str_len nm) else nm
and ivar_name_shaped = fn (nm: str) ->
  str_len nm >= 2 && str_eq (char_at nm 0) "@"
  && (if str_eq (char_at nm 1) "@" then false
      // a multibyte first character is a name too (ruby accepts :@\u{1F499});
      // is_alpha only knows ASCII, so the lead byte is admitted directly.
      else is_alpha (char_at nm 1) || ord (char_at nm 1) >= 128)
and cvar_name_shaped = fn (nm: str) ->
  str_len nm >= 3 && str_eq (substring nm 0 2) "@@" && is_alpha (char_at nm 2)
and ivar_name_checked = fn world -> fn (nm: str) ->
  if ivar_name_shaped nm then ivar_arg_name nm
  else (let _ = raise_exc world "NameError"
                  ("'" ++ nm ++ "' is not allowed as an instance variable name") in "")
and cvar_name_checked = fn world -> fn (nm: str) ->
  if cvar_name_shaped nm then ivar_arg_name (ivar_arg_name nm)
  else (let _ = raise_exc world "NameError"
                  ("'" ++ nm ++ "' is not allowed as a class variable name") in "")
and mk_bound_method = fn world -> fn (recv: Val) -> fn (owner: str) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  let id = alloc_oid ocls in
  let _ = map_set ocls id "Method" in
  let _ = map_set ivars (str_of_int id ++ "@__m_name") (mkstr nm) in
  let _ = map_set ivars (str_of_int id ++ "@__m_owner") (mkstr owner) in
  let _ = map_set ivars (str_of_int id ++ "@__m_recv") recv in
  VObj id
and bm_arity_go = fn (params: str list) -> fn (defaults: (str * Expr) list) -> fn (req: int) -> fn (opt: bool) -> fn (kreq: bool) -> fn (kopt: bool) ->
  match params with
  | Nil ->
    (let req = (if kreq then req + 1 else req) in
     if opt || (kopt && (if kreq then false else true)) then 0 - (req + 1) else req)
  | Cons (pp, rest) ->
    if str_len pp >= 2 && str_eq (substring pp 0 2) "**" then
      bm_arity_go rest defaults req opt kreq true
    else if str_len pp > 0 && (str_eq (char_at pp 0) "*" || str_eq (char_at pp 0) "&") then
      bm_arity_go rest defaults req (opt || str_eq (char_at pp 0) "*") kreq kopt
    else if str_len pp > 0 && str_eq (char_at pp (str_len pp - 1)) ":" then
      (if bm_has_default defaults pp then bm_arity_go rest defaults req opt kreq true
       else bm_arity_go rest defaults req opt true kopt)
    else if bm_has_default defaults pp then bm_arity_go rest defaults req true kreq kopt
    else bm_arity_go rest defaults (req + 1) opt kreq kopt
and bm_kind_meta = fn (kind: str) -> fn (n: int) ->
  if n <= 0 then (Nil : Val list)
  else Cons (arr_new (Cons (VSym kind, Nil)), bm_kind_meta kind (n - 1))
and bm_has_default = fn (defaults: (str * Expr) list) -> fn (pp: str) ->
  match defaults with
  | Nil -> false
  | Cons ((dn, _), rest) -> str_eq dn pp || bm_has_default rest pp
and builtin_obj_has = fn (cls: str) -> fn (name: str) ->
  // ENV: one object whose methods all live in the dispatcher, so nothing knew
  // it had any -- `ENV.respond_to?(:each)` was false and `ENV.method(:each)`
  // raised NameError while `ENV.each` iterated. It answers the Hash surface
  // (its arm delegates the rest to a hash copy) plus the keys-and-values
  // methods of its own.
  if str_eq cls "EnvHash" then
    is_hash_method name || is_enum_method name ||
    (str_len name == 2 && str_eq name "[]") || (str_len name == 3 && str_eq name "[]=") || (str_len name == 5 && str_eq name "store") ||
    (str_len name == 5 && str_eq name "fetch") || (str_len name == 6 && str_eq name "delete") || (str_len name == 4 && str_eq name "key?") ||
    (str_len name == 8 && str_eq name "has_key?") || (str_len name == 8 && str_eq name "include?") || (str_len name == 7 && str_eq name "member?") ||
    (str_len name == 10 && str_eq name "has_value?") || (str_len name == 6 && str_eq name "value?") || (str_len name == 3 && str_eq name "key") ||
    (str_len name == 4 && str_eq name "keys") || (str_len name == 6 && str_eq name "values") || (str_len name == 9 && str_eq name "values_at") ||
    (str_len name == 4 && str_eq name "each") || (str_len name == 9 && str_eq name "each_pair") || (str_len name == 8 && str_eq name "each_key") ||
    (str_len name == 10 && str_eq name "each_value") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "length") ||
    (str_len name == 6 && str_eq name "empty?") || (str_len name == 5 && str_eq name "clear") || (str_len name == 4 && str_eq name "to_h") ||
    (str_len name == 7 && str_eq name "to_hash") || (str_len name == 4 && str_eq name "to_a") || (str_len name == 6 && str_eq name "update") ||
    (str_len name == 6 && str_eq name "merge!") || (str_len name == 9 && str_eq name "delete_if") || (str_len name == 7 && str_eq name "keep_if") ||
    (str_len name == 6 && str_eq name "select") || (str_len name == 7 && str_eq name "select!") || (str_len name == 6 && str_eq name "filter") ||
    (str_len name == 7 && str_eq name "filter!") || (str_len name == 6 && str_eq name "reject") || (str_len name == 7 && str_eq name "reject!") ||
    (str_len name == 5 && str_eq name "assoc") || (str_len name == 6 && str_eq name "rassoc") || (str_len name == 6 && str_eq name "invert") ||
    (str_len name == 5 && str_eq name "index") || (str_len name == 5 && str_eq name "slice") || (str_len name == 6 && str_eq name "except") ||
    (str_len name == 3 && str_eq name "dig") || (str_len name == 12 && str_eq name "fetch_values") || (str_len name == 6 && str_eq name "rehash") ||
    (str_len name == 7 && str_eq name "replace") || (str_len name == 5 && str_eq name "shift") || (str_len name == 6 && str_eq name "freeze")
  else if str_eq cls "File" || str_eq cls "IO" then
    (str_len name == 4 && str_eq name "read") || (str_len name == 5 && str_eq name "write") || (str_len name == 5 && str_eq name "print") || (str_len name == 4 && str_eq name "puts") ||
    (str_len name == 2 && str_eq name "<<") || (str_len name == 4 && str_eq name "gets") || (str_len name == 8 && str_eq name "readline") || (str_len name == 9 && str_eq name "each_line") ||
    (str_len name == 9 && str_eq name "readlines") || (str_len name == 4 && str_eq name "to_a") || (str_len name == 5 && str_eq name "close") || (str_len name == 7 && str_eq name "closed?") ||
    (str_len name == 4 && str_eq name "path") || (str_len name == 7 && str_eq name "to_path") || (str_len name == 6 && str_eq name "rewind") || (str_len name == 4 && str_eq name "eof?") ||
    (str_len name == 3 && str_eq name "eof") || (str_len name == 5 && str_eq name "flush") || (str_len name == 4 && str_eq name "sync") || (str_len name == 5 && str_eq name "sync=") ||
    (str_len name == 6 && str_eq name "fileno") || (str_len name == 4 && str_eq name "tty?") || (str_len name == 6 && str_eq name "isatty") ||
    // ...and the encodings, which the dispatcher now answers. respond_to?
    // denying a name the call implements is the same fact spelled two ways.
    (str_len name == 17 && str_eq name "external_encoding") || (str_len name == 17 && str_eq name "internal_encoding") ||
    (str_len name == 12 && str_eq name "set_encoding") ||
    // every object answers these; the IO arm captures the name before the
    // generic path can, so `STDOUT.set_encoding(...).equal?(STDOUT)` raised.
    (str_len name == 6 && str_eq name "equal?") || (str_len name == 9 && str_eq name "object_id") || (str_len name == 7 && str_eq name "frozen?") ||
    (str_len name == 4 && str_eq name "hash") || (str_len name == 3 && str_eq name "dup") || (str_len name == 5 && str_eq name "clone")
  else if str_eq cls "Time" then
    (str_len name == 4 && str_eq name "to_i") || (str_len name == 3 && str_eq name "utc") || (str_len name == 6 && str_eq name "getutc") || (str_len name == 4 && str_eq name "utc?") ||
    (str_len name == 4 && str_eq name "year") || (str_len name == 5 && str_eq name "month") || (str_len name == 3 && str_eq name "mon") || (str_len name == 3 && str_eq name "day") ||
    (str_len name == 4 && str_eq name "mday") || (str_len name == 4 && str_eq name "hour") || (str_len name == 3 && str_eq name "min") || (str_len name == 3 && str_eq name "sec") ||
    (str_len name == 4 && str_eq name "wday") || (str_len name == 4 && str_eq name "yday") || (str_len name == 4 && str_eq name "usec") ||
    // Time compares, which is what makes (t1..t2) a range -- and #== belongs in
    // the list beside #eql?: without it nothing knew a Time answers equality,
    // so an Array of Times compared its elements by identity.
    (str_len name == 3 && str_eq name "<=>") || (str_len name == 1 && str_eq name "<") || (str_len name == 2 && str_eq name "<=") ||
    (str_len name == 1 && str_eq name ">") || (str_len name == 2 && str_eq name ">=") || (str_len name == 4 && str_eq name "eql?") || (str_len name == 2 && str_eq name "==") ||
    (str_len name == 1 && str_eq name "+") || (str_len name == 1 && str_eq name "-")
  // Method and UnboundMethod: their whole surface is in the dispatcher too, so
  // nothing knew a Method had any methods -- `m.respond_to?(:call)` was false
  // while `m.call` worked, and `f >> m` refused the Method as not callable.
  else if str_eq cls "Method" then
    (str_len name == 4 && str_eq name "call") || (str_len name == 2 && str_eq name "()") || (str_len name == 2 && str_eq name "[]") || (str_len name == 3 && str_eq name "===") ||
    (str_len name == 5 && str_eq name "arity") || (str_len name == 4 && str_eq name "name") || (str_len name == 5 && str_eq name "owner") ||
    (str_len name == 8 && str_eq name "receiver") || (str_len name == 10 && str_eq name "parameters") || (str_len name == 15 && str_eq name "source_location") || (str_len name == 3 && str_eq name "box") ||
    (str_len name == 6 && str_eq name "unbind") || (str_len name == 7 && str_eq name "to_proc") || (str_len name == 13 && str_eq name "original_name") ||
    (str_len name == 12 && str_eq name "super_method") || (str_len name == 5 && str_eq name "curry") || (str_len name == 2 && str_eq name ">>") || (str_len name == 2 && str_eq name "<<")
  else if str_eq cls "UnboundMethod" then
    (str_len name == 4 && str_eq name "bind") || (str_len name == 9 && str_eq name "bind_call") || (str_len name == 5 && str_eq name "arity") ||
    (str_len name == 4 && str_eq name "name") || (str_len name == 5 && str_eq name "owner") || (str_len name == 10 && str_eq name "parameters") ||
    (str_len name == 15 && str_eq name "source_location") || (str_len name == 13 && str_eq name "original_name") || (str_len name == 12 && str_eq name "super_method")
  // MatchData: what its arms answer, so `md == md2` routes to the dispatcher
  // instead of comparing identity in the operator path, and respond_to? agrees
  // with the call.
  else if str_eq cls "MatchData" then
    (str_len name == 2 && str_eq name "[]") || (str_len name == 4 && str_eq name "to_a") || (str_len name == 8 && str_eq name "captures") ||
    (str_len name == 14 && str_eq name "named_captures") || (str_len name == 5 && str_eq name "names") || (str_len name == 9 && str_eq name "values_at") ||
    (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "to_s") ||
    (str_len name == 7 && str_eq name "inspect") || (str_len name == 6 && str_eq name "string") || (str_len name == 6 && str_eq name "regexp") ||
    (str_len name == 9 && str_eq name "pre_match") || (str_len name == 10 && str_eq name "post_match") ||
    (str_len name == 5 && str_eq name "begin") || (str_len name == 3 && str_eq name "end") || (str_len name == 6 && str_eq name "offset") ||
    (str_len name == 10 && str_eq name "byteoffset") || (str_len name == 9 && str_eq name "bytebegin") || (str_len name == 7 && str_eq name "byteend") ||
    (str_len name == 5 && str_eq name "match") || (str_len name == 12 && str_eq name "match_length") ||
    (str_len name == 11 && str_eq name "deconstruct") || (str_len name == 16 && str_eq name "deconstruct_keys") ||
    (str_len name == 2 && str_eq name "==") || (str_len name == 4 && str_eq name "eql?") || (str_len name == 4 && str_eq name "hash") ||
    (str_len name == 3 && str_eq name "dup") || (str_len name == 5 && str_eq name "clone")
  else false
and rx_union_refuse = fn world -> fn (v9: Val) ->
  raise_exc world "TypeError"
    ("no implicit conversion of "
     ++ (match v9 with
         | VNil -> "nil"
         | VBool b9 -> (if b9 then "true" else "false")
         | _ -> dispatch_cls_of world v9)
     ++ " into String")
and op_responds = fn (v: Val) -> fn (name: str) ->
  if (str_len name == 1 && str_eq name "!") || (str_len name == 3 && str_eq name "===") then true
  else
    (let arith = (str_len name == 1 && str_eq name "+") || (str_len name == 1 && str_eq name "-") || (str_len name == 1 && str_eq name "*") || (str_len name == 1 && str_eq name "/") || (str_len name == 2 && str_eq name "**") in
     let ord = (str_len name == 1 && str_eq name "<") || (str_len name == 2 && str_eq name "<=") || (str_len name == 1 && str_eq name ">") || (str_len name == 2 && str_eq name ">=") in
     let bits = (str_len name == 1 && str_eq name "&") || (str_len name == 1 && str_eq name "|") || (str_len name == 1 && str_eq name "^") in
     let shift = (str_len name == 2 && str_eq name "<<") || (str_len name == 2 && str_eq name ">>") in
     match v with
     | VInt _ -> arith || ord || bits || shift || (str_len name == 1 && str_eq name "%") || (str_len name == 1 && str_eq name "~") || (str_len name == 2 && str_eq name "[]")
     | VBig _ -> arith || ord || bits || shift || (str_len name == 1 && str_eq name "%") || (str_len name == 1 && str_eq name "~") || (str_len name == 2 && str_eq name "[]")
     | VFlt _ -> arith || ord || (str_len name == 1 && str_eq name "%")
     | VRat (_, _) -> arith || ord || (str_len name == 1 && str_eq name "%")
     | VCpx (_, _) -> arith
     | VStr _ -> ord || (str_len name == 1 && str_eq name "+") || (str_len name == 1 && str_eq name "*") || (str_len name == 1 && str_eq name "%") || (str_len name == 2 && str_eq name "<<")
     // an Array has & and | but NOT ^ (Ruby gives it no symmetric difference)
     | VArr _ -> (str_len name == 1 && str_eq name "+") || (str_len name == 1 && str_eq name "-") || (str_len name == 1 && str_eq name "*") || (str_len name == 2 && str_eq name "<<")
                 || (str_len name == 1 && str_eq name "&") || (str_len name == 1 && str_eq name "|")
     | VHsh _ -> ord
     | VSym _ -> ord || (str_len name == 2 && str_eq name "=~") || (str_len name == 2 && str_eq name "[]")
     | VNil -> bits || (str_len name == 2 && str_eq name "=~")
     | VBool _ -> bits
     | VRange (_, _, _) -> (str_len name == 1 && str_eq name "%")
     // `=~` as well as `~`: respond_to? already answered true for it through
     // the regexp name list, and reflection asks THIS one.
     | VRegex (_, _, _) -> (str_len name == 1 && str_eq name "~") || (str_len name == 2 && str_eq name "=~")
     | VProc _ -> shift
     | _ -> false)
and is_sym_method = fn (name: str) ->
  map_has (name_set "is_sym_method") name
and is_regex_method = fn (name: str) ->
  map_has (name_set "is_regex_method") name
and int_aref_shift = fn (n: int) -> fn (k: int) ->
  if k >= 0 then int_shr_arith n k
  // ⚠ a left shift past the word is not representable here; ruby promotes to
  // a Bignum. Everything the caller can still mask off is zero by then, so
  // this answers 0 rather than an overflowed number.
  else if 0 - k >= 62 then 0
  else n * int_pow 2 (0 - k)
and int_aref_mask = fn (v: int) -> fn (len: int) ->
  if len < 0 then v                       // mask of -1: every bit survives
  // ⚠ 2^63 does not fit. Above that width ruby promotes to a Bignum and this
  // cannot follow: a NEGATIVE value masked to 63 bits or more is a number
  // wider than the machine word, and what comes back here is the unmasked
  // (still negative) value rather than that number.
  else if len >= 63 then v
  else int_bitop "&" v (int_pow 2 len - 1)
and int_aref2_v = fn (n: int) -> fn (beg: int) -> fn (len: int) ->
  int_aref_mask (int_aref_shift n beg) len
and int_aref_bit = fn (recv: Val) -> fn (iv: Val) ->
  (match iv with
   // an index too big to be a machine word: every bit up there is the sign.
   | VBig ib -> (if str_len ib > 0 && str_eq (substring ib 0 1) "-" then VInt 0
                 else (match recv with
                       | VInt n -> VInt (if n < 0 then 1 else 0)
                       | _ -> VInt 0))
   | VInt i ->
     (if i < 0 then VInt 0
      else (match recv with
            | VInt n -> VInt (int_bitop "&" (int_shr_arith n i) 1)
            | VBig b -> VInt (big_bit_at b i)
            | _ -> VInt 0))
   | _ -> VInt 0)
and is_proc_method = fn (name: str) ->
  (str_len name == 4 && str_eq name "call") || (str_len name == 2 && str_eq name "()") || (str_len name == 2 && str_eq name "[]") ||
  (str_len name == 5 && str_eq name "yield") || (str_len name == 3 && str_eq name "===") || (str_len name == 7 && str_eq name "lambda?") || (str_len name == 7 && str_eq name "binding") ||
  (str_len name == 5 && str_eq name "arity") || (str_len name == 10 && str_eq name "parameters") || (str_len name == 7 && str_eq name "to_proc") ||
  (str_len name == 5 && str_eq name "curry")
  // String#=~ is a real method (Object#=~ is not, since ruby 3.2)
  // String#-@ interns, String#+@ unfreezes (see prim_method)
and is_str_method = fn (name: str) ->
  map_has (name_set "is_str_method") name
and is_arr_method = fn (name: str) ->
  map_has (name_set "is_arr_method") name
and is_hash_method = fn (name: str) ->
  map_has (name_set "is_hash_method") name
// the class a method is really DEFINED in. `alias ali pub` in B records B as
// the owner -- which is what #owner answers, in ruby too -- but the definition
// is still A's, and that is what equality is about.
and meth_origin_cls = fn world -> fn (cls: str) -> fn (n: str) ->
  if map_has alias_origin (cls ++ "#" ++ n)
  then (match map_get alias_origin (cls ++ "#" ++ n) with s -> s)
  else cls
and defined_as_name = fn world -> fn (cls: str) -> fn (n: str) ->
  if map_has alias_srcname (cls ++ "#" ++ n)
  then (match map_get alias_srcname (cls ++ "#" ++ n) with s2 -> s2)
  // a MODULE FUNCTION is the same method as the instance method it mirrors, so
  // `Kernel.method(:fail)` collapses onto :raise exactly as
  // `Kernel.instance_method(:fail)` does. The singleton wrapper is not a
  // different class for this question, and canon_alias has no entry under it.
  else if is_sng_cls cls then canon_alias (sng_inner cls) n
  // a Struct's methods are Struct's, under the name the program gave the
  // class: `StructClasses::Car.instance_method(:inspect)` has to collapse onto
  // #to_s the way `Struct`'s does, and this table is keyed by class NAME.
  else if map_has struct_mem cls && str_eq (canon_alias cls n) n then canon_alias "Struct" n
  // a pair Kernel owns (`#then` / `#yield_self`) is that pair for EVERY
  // receiver: `1.method(:then) == 1.method(:yield_self)` asks under Integer,
  // where the row is not and cannot be.
  else if str_eq (canon_alias cls n) n && is_kernel_pub_instance n then canon_alias "Kernel" n
  else canon_alias cls n
and builtin_original_name = fn (cls: str) -> fn (n: str) ->
  if str_eq cls "String" then (if str_eq n "dedup" then "-@" else n)
  else if str_eq cls "Array" then
    (if str_eq n "append" then "push"
     else if str_eq n "prepend" then "unshift"
     else if str_eq n "to_s" then "inspect"
     else n)
  else if str_eq cls "Hash" || str_eq cls "Struct" then
    (if str_eq n "to_s" then "inspect" else n)
  else if str_eq cls "Proc" || str_eq cls "TrueClass" || str_eq cls "FalseClass"
          || str_eq cls "Module" || str_eq cls "Class" then
    (if str_eq n "inspect" then "to_s" else n)
  else if str_eq cls "Queue" || str_eq cls "SizedQueue" then
    (if str_eq n "<<" then "push"
     else if str_eq n "enq" then "push"
     else if str_eq n "deq" then "pop"
     else if str_eq n "shift" then "pop"
     else if str_eq n "size" then "length"
     else n)
  else if str_eq cls "Numeric" then
    (if str_eq n "conj" then "conjugate"
     else if str_eq n "imag" then "imaginary"
     else n)
  else if str_eq cls "Integer" then
    (if str_eq n "magnitude" then "abs"
     else if str_eq n "inspect" then "to_s"
     else n)
  else if str_eq cls "Float" then
    (if str_eq n "inspect" then "to_s" else n)
  else n
and original_name_of = fn world -> fn (cls: str) -> fn (n: str) ->
  // an alias OF an alias names the first definition: the chain is walked, not
  // stepped once (`alias bar foo; alias baz bar` -> baz's original is foo).
  // Bounded by the chain length, and a cycle cannot be built with `alias`.
  original_name_walk world cls n 32
and original_name_walk = fn world -> fn (cls: str) -> fn (n: str) -> fn (fuel: int) ->
  if fuel <= 0 then n
  else if map_has alias_srcname (cls ++ "#" ++ n)
  then (match map_get alias_srcname (cls ++ "#" ++ n) with
        | s2 -> (if str_eq s2 n then n else original_name_walk world cls s2 (fuel - 1)))
  else builtin_original_name cls n
and canon_alias = fn (cls: str) -> fn (n: str) ->
  if str_eq cls "String" then
    (if str_eq n "size" then "length"
     else if str_eq n "===" then "=="
     else if str_eq n "dedup" then "-@"
     else if str_eq n "next" then "succ"
     else if str_eq n "next!" then "succ!"
     else if str_eq n "intern" then "to_sym"
     else if str_eq n "slice" then "[]"
     else if str_eq n "to_str" then "to_s"
     else n)
  else if str_eq cls "Array" then
    (if str_eq n "length" then "size"
     else if str_eq n "append" then "push"
     else if str_eq n "collect" then "map"
     else if str_eq n "collect!" then "map!"
     else if str_eq n "detect" then "find"
     else if str_eq n "filter" then "select"
     else if str_eq n "filter!" then "select!"
     else if str_eq n "index" then "find_index"
     else if str_eq n "prepend" then "unshift"
     else if str_eq n "slice" then "[]"
     else if str_eq n "to_s" then "inspect"
     else n)
  else if str_eq cls "Hash" then
    (if str_eq n "size" then "length"
     else if str_eq n "each" then "each_pair"
     else if str_eq n "filter" then "select"
     else if str_eq n "filter!" then "select!"
     else if str_eq n "has_key?" then "include?"
     else if str_eq n "key?" then "include?"
     else if str_eq n "member?" then "include?"
     else if str_eq n "has_value?" then "value?"
     else if str_eq n "store" then "[]="
     else if str_eq n "update" then "merge!"
     else if str_eq n "to_s" then "inspect"
     else n)
  // Kernel's aliases, from the oracle's words the same way the numeric ones are
  // ("Kernel#fail is an alias of Kernel#raise").
  else if str_eq cls "Kernel" || str_eq cls "Object" then
    (if str_eq n "fail" then "raise"
     else if str_eq n "format" then "sprintf"
     else if str_eq n "enum_for" then "to_enum"
     else if str_eq n "kind_of?" then "is_a?"
     else if str_eq n "then" then "yield_self"
     else n)
  else if str_eq cls "Range" then
    (if str_eq n "entries" then "to_a"
     else if str_eq n "member?" then "include?"
     else n)
  else if str_eq cls "Struct" then
    (if str_eq n "to_s" then "inspect"
     else if str_eq n "filter" then "select"
     else if str_eq n "deconstruct" then "to_a"
     else n)
  // Enumerable keeps five pairs, and the module is the class the specs ask
  // through (`Enumerable.instance_method(:collect)`).
  else if str_eq cls "Enumerable" then
    (if str_eq n "collect" then "map"
     else if str_eq n "collect_concat" then "flat_map"
     else if str_eq n "detect" then "find"
     else if str_eq n "entries" then "to_a"
     else if str_eq n "filter" then "select"
     else if str_eq n "find_all" then "select"
     else if str_eq n "member?" then "include?"
     else if str_eq n "reduce" then "inject"
     else n)
  // Symbol's four pairs. Without them `Symbol.instance_method(:next)` and
  // `(:succ)` were two methods, which is what those specs compare.
  else if str_eq cls "Symbol" then
    (if str_eq n "next" then "succ"
     else if str_eq n "id2name" then "to_s"
     else if str_eq n "intern" then "to_sym"
     else if str_eq n "slice" then "[]"
     else if str_eq n "size" then "length"
     // Symbol#=== IS Symbol#== (a symbol is only ever equal to itself, so the
     // case-equality has nothing else to be). The spec compares the pair as
     // UnboundMethods, which is what this table decides.
     else if str_eq n "===" then "=="
     else n)
  // Proc, Method and UnboundMethod each carry `eql?` as a second name for `==`,
  // and a to_s/inspect pair. The pair that matters is `eql?`: comparing two
  // Method objects with `eql?` went through a different arm from `==` and got
  // object identity, so `m.method(:x).eql?(m.method(:x))` was false where `==`
  // was true -- one relation, answered twice, disagreeing with itself.
  else if str_eq cls "Proc" then
    // #yield, #===, #[] and #() are four more names for #call
    (if str_eq n "eql?" then "=="
     else if str_eq n "inspect" then "to_s"
     else if str_eq n "yield" then "call"
     else if str_eq n "===" then "call"
     else if str_eq n "[]" then "call"
     else if str_eq n "()" then "call"
     else n)
  else if str_eq cls "Method" || str_eq cls "UnboundMethod" then
    (if str_eq n "eql?" then "=="
     else if str_eq n "to_s" then "inspect"
     // #===, #[] and #() are #call under other names, and the specs compare
     // exactly those UnboundMethods
     else if str_eq n "===" || str_eq n "[]" || str_eq n "()" then "call"
     else n)
  else if str_eq cls "MatchData" || str_eq cls "Regexp" then
    (if str_eq n "escape" then "quote"
     else if str_eq n "eql?" then "=="
     // two names for one implementation: the specs compare the UnboundMethods
     else if str_eq n "deconstruct" then "captures"
     else if str_eq n "length" then "size"
     else n)
  else if str_eq cls "TrueClass" then
    (if str_eq n "inspect" then "to_s" else n)
  // FalseClass#^ and NilClass#^ ARE FalseClass#| / NilClass#| (both answer
  // "is the other operand truthy"); TrueClass#^ is not (it negates).
  else if str_eq cls "FalseClass" then
    (if str_eq n "inspect" then "to_s"
     else if str_eq n "^" then "|"
     else n)
  // NilClass#inspect is NOT #to_s: they answer "nil" and "". The three
  // singletons were sharing one arm, which only became visible once Method
  // equality started reaching this table for a primitive receiver.
  else if str_eq cls "NilClass" then
    (if str_eq n "^" then "|" else n)
  else if str_eq cls "Module" || str_eq cls "Class" then
    (if str_eq n "module_eval" then "class_eval"
     else if str_eq n "module_exec" then "class_exec"
     else if str_eq n "inspect" then "to_s"
     else n)
  // ENV (an object, internally class EnvHash): its aliases, from the specs'
  // wording ("ENV.has_key? is an alias of ENV.include?"). ENV is one object
  // rather than a class, so these are compared as Method objects, and Method
  // equality goes through this table.
  else if str_eq cls "EnvHash" then
    (if str_eq n "filter" then "select"
     else if str_eq n "each" then "each_pair"
     else if str_eq n "has_key?" then "include?"
     else if str_eq n "key?" then "include?"
     else if str_eq n "member?" then "include?"
     else if str_eq n "has_value?" then "value?"
     else if str_eq n "length" then "size"
     else if str_eq n "store" then "[]="
     else if str_eq n "update" then "merge!"
     else if str_eq n "filter!" then "select!"
     else n)
  // Queue / SizedQueue: the same five aliases in both classes, so one row.
  // The direction is the spec's own wording ("Queue#deq is an alias of
  // Queue#pop", "Queue#push is an alias of Queue#<<").
  else if str_eq cls "Queue" || str_eq cls "SizedQueue" then
    (if str_eq n "deq" then "pop"
     else if str_eq n "shift" then "pop"
     else if str_eq n "enq" then "<<"
     else if str_eq n "push" then "<<"
     else if str_eq n "length" then "size"
     else n)
  // The numeric tower shares one set of aliases across five classes, so the
  // row is written once and reached by all of them. WHICH name is canonical is
  // not derivable from this implementation -- the arms are written
  // `"rect" || "rectangular"` for the convenience of the code, and ruby says
  // rect is the alias -- so the direction comes from the oracle: each of these
  // is a ruby/spec assertion of the form "X is an alias of Y".
  else if str_eq cls "Symbol" then
    (if str_eq n "===" then "==" else if str_eq n "size" then "length" else n)
  else if str_eq cls "Complex" || str_eq cls "Rational" || str_eq cls "Numeric"
          || str_eq cls "Integer" || str_eq cls "Float" then
    (if str_eq n "angle" then "arg"
     else if str_eq n "phase" then "arg"
     else if str_eq n "conj" then "conjugate"
     else if str_eq n "imag" then "imaginary"
     else if str_eq n "magnitude" then "abs"
     else if str_eq n "rect" then "rectangular"
     else if str_eq n "modulo" then "%"
     // `quo` is NOT one row across the five. Asked of the oracle rather than
     // assumed: Float#quo == Float#fdiv and Float#quo == Float#/ is FALSE,
     // while Complex#quo and Rational#quo ARE their `/`. The shared row said
     // `/` for all five, which is the permissive direction -- it claimed an
     // equality ruby denies, and only stayed invisible because Float#/ is not
     // reflectable here yet.
     else if str_eq n "quo" then
       (if str_eq cls "Float" then "fdiv" else "/")
     // inspect/to_s collapses for Integer and Float and not for Complex or
     // Rational, so this cannot go in the shared list either.
     else if str_eq n "inspect" && (str_eq cls "Integer" || str_eq cls "Float") then "to_s"
     // ...and neither does `===`: it IS `==` for Integer and Float (as it is
     // for String and Symbol) and is NOT for Complex, Rational or Numeric.
     // Asked of the oracle per class, one class at a time.
     else if str_eq n "===" && (str_eq cls "Integer" || str_eq cls "Float") then "=="
     else if str_eq n "to_int" && str_eq cls "Float" then "to_i"
     else if str_eq n "next" && str_eq cls "Integer" then "succ"
     else n)
  else n
and builtin_owns_here = fn (cls: str) -> fn (name: str) ->
  if str_eq cls "String" then is_str_method name
  else if str_eq cls "Array" then is_arr_method name
  else if str_eq cls "Hash" then is_hash_method name
  // Module and Class carry the reflection methods as builtins, so
  // `Module.instance_method(:name)` has to see them -- zeitwerk takes exactly
  // that unbound method and bind_calls it to read a module's real name.
  // rubocop-ast asks `::Range.instance_method(:minmax).owner` to decide
  // whether it has to patch around an old ruby's Range#minmax.
  else if str_eq cls "Range" then
    is_range_method name || range_delegate_name name || is_enum_method name
  // Complex and Rational were missing from this row while their methods were
  // implemented, so `Complex.instance_method(:arg)` raised NameError for a
  // method that answers when called. They are Numerics: same list.
  // ⚠ PER CLASS, not the union. is_num_method is
  // `num_has Integer || num_has Float || num_has Rational || num_has Complex`,
  // and using it here made every one of the five claim every other's methods:
  // `Complex.instance_method(:divmod)` answered a method ruby denies, and the
  // counts read Integer 89 / Float 89 / Rational 88 / Complex 88 / Numeric 89
  // against ruby's 93 / 68 / 65 / 48 / 56. The dispatcher and respond_to?
  // already ask per VALUE (num_has recv name); only reflection asked the union.
  // ⚠ Numeric's OWN list is not unioned in: Complex and Rational undefine most
  // of it (`Complex.instance_method(:divmod)` is a NameError in ruby), so the
  // one name all four really inherit is named on its own.
  else if str_eq cls "Integer" then num_has (VInt 0) name || num_inherited_name name
  else if str_eq cls "Float" then num_has (VFlt 0.0) name || num_inherited_name name
  else if str_eq cls "Rational" then num_has (VRat ("0", "1")) name || num_inherited_name name
  else if str_eq cls "Complex" then num_has (VCpx (VInt 0, VInt 0)) name || num_inherited_name name
  else if str_eq cls "Numeric" then is_numeric_own_method name
  else if str_eq cls "Module" || str_eq cls "Class" then
    is_module_method name
  // Proc had no row at all, so `Proc.instance_method(:call)` -- and every
  // comparison the alias specs make with it -- raised NameError for methods
  // that answer when called.
  else if str_eq cls "Proc" then is_proc_method name
  // Exception had no row at all, so every one of its builtin methods was
  // invisible to reflection AND to `undef`: `class << e; undef
  // :detailed_message; end` raised NameError for a method that answers when
  // called, which is exactly what core/exception/full_message asks for.
  // Enumerated from ruby (`Exception.instance_methods(false)`) and then
  // confirmed one by one by asking THIS interpreter for each as a Method --
  // all twelve answer, so the claim is no wider than the implementation.
  else if str_eq cls "Exception" then is_exception_method name
  // zeitwerk branches on UnboundMethod.method_defined?(:bind_call)
  // Queue and SizedQueue: their methods live in the primitive dispatcher, so
  // without a row here `Queue.instance_method(:deq)` raised NameError for a
  // method that works when called -- and every one of their eleven spec files
  // opens by comparing two of these as UnboundMethods. Enumerated from the
  // dispatcher's own arms rather than from memory.
  else if str_eq cls "Queue" || str_eq cls "SizedQueue" then
    (str_len name == 4 && str_eq name "push") || (str_len name == 2 && str_eq name "<<") || (str_len name == 3 && str_eq name "enq") ||
    (str_len name == 3 && str_eq name "pop") || (str_len name == 5 && str_eq name "shift") || (str_len name == 3 && str_eq name "deq") ||
    (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "length") || (str_len name == 6 && str_eq name "empty?") ||
    (str_len name == 5 && str_eq name "clear") || (str_len name == 5 && str_eq name "close") || (str_len name == 7 && str_eq name "closed?") ||
    (str_len name == 11 && str_eq name "num_waiting") ||
    (str_eq cls "SizedQueue" && ((str_len name == 3 && str_eq name "max") || (str_len name == 4 && str_eq name "max="))) ||
    is_prim_method name
  else if str_eq cls "UnboundMethod" || str_eq cls "Method" then
    // ...every name the dispatcher answers, so `Method.instance_method(:===)`
    // finds the one a spec compares with #call
    builtin_obj_has cls name
  // Comparable's own instance methods: `Comparable.instance_method(:clamp)`
  // is how a spec reaches one, and bind_call runs it against a number.
  else if str_eq cls "Comparable" then
    (str_len name == 5 && str_eq name "clamp") || (str_len name == 8 && str_eq name "between?") || is_binary_op_name name
  // Symbol's own methods (the same set the zero-arity table lists for a
  // Symbol receiver), so `Symbol.instance_method(:size)` finds the method
  // whose pair with :length a spec compares.
  // ...and it is the SAME list the dispatcher answers from, not a copy of it.
  // The copy had drifted: #intern and #slice are dispatched, respond_to? says
  // true and `:a.method(:intern)` builds -- but the copy did not mention them,
  // so `Symbol.instance_method(:intern)` was a NameError for a method that
  // works. Two spec files do nothing but compare that pair.
  else if str_eq cls "Symbol" then is_sym_method name
  // KERNEL's own methods are the module-function list -- the same one
  // private_instance_methods and public_methods enumerate. Without this row
  // `Kernel.instance_method(:raise)` raised NameError for a method every
  // program calls, and the six specs that compare an alias pair as
  // UnboundMethods (fail/raise, format/sprintf, enum_for/to_enum) could not
  // even build the pair.
  else if str_eq cls "Kernel" then
    // both halves: the module functions AND the public instance methods.
    // Asking only the private list made `Kernel.instance_method(:then)` a
    // NameError for a method `1.then { }` runs, which is the same fact
    // answered two ways.
    is_kernel_builtin name || is_kernel_pub_instance name
  // MatchData's methods live in the dispatcher, so reflection could not see
  // them: `MatchData.instance_method(:captures)` was a NameError, and the
  // alias specs compare exactly those UnboundMethods.
  else if str_eq cls "MatchData" then builtin_obj_has "MatchData" name
  // Enumerable had no row, so `Enumerable.instance_method(:map)` raised
  // NameError for a method every Array answers -- and eight of its spec files
  // open by comparing two of these as UnboundMethods.
  else if str_eq cls "Enumerable" then is_enum_method name
  // A Struct class INCLUDES Enumerable, and its own methods are in the user
  // table where reflection already finds them -- but the included half had no
  // row, so `S.instance_method(:map)` was a NameError for a method that
  // `S.new(1).map { }` runs.
  else if str_eq cls "Struct" || map_has struct_mem cls then
    is_enum_method name || is_struct_gen_method name
  else false
and builtin_has_meth = fn (cls: str) -> fn (name: str) ->
  builtin_owns_here cls name || is_prim_method name
and is_exception_method = fn (name: str) ->
  map_has (name_set "is_exception_method") name
and is_struct_gen_method = fn (name: str) ->
  (str_len name == 4 && str_eq name "to_a") || (str_len name == 6 && str_eq name "to_ary") || (str_len name == 6 && str_eq name "values") ||
  (str_len name == 11 && str_eq name "deconstruct") || (str_len name == 7 && str_eq name "members") || (str_len name == 4 && str_eq name "size") ||
  (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "each") || (str_len name == 9 && str_eq name "each_pair") ||
  (str_len name == 4 && str_eq name "to_h") || (str_len name == 2 && str_eq name "==")
and cmp_op_name = fn (name: str) ->
  (str_len name == 1 && str_eq name "<") || (str_len name == 2 && str_eq name "<=") || (str_len name == 1 && str_eq name ">") || (str_len name == 2 && str_eq name ">=") ||
  (str_len name == 2 && str_eq name "==") || (str_len name == 3 && str_eq name "===")
and num_inherited_name = fn (name: str) ->
  (str_len name == 22 && str_eq name "singleton_method_added")
and is_numeric_own_method = fn (name: str) ->
  map_has (name_set "is_numeric_own_method") name
and builtin_cls_name = fn (cls: str) ->
  map_has (name_set "builtin_cls_name") cls
and builtin_class_method = fn (cls: str) -> fn (name: str) ->
  // Complex.rect / .rectangular / .polar are class methods of the primitive
  // layer, so `Complex.method(:rect)` (which a spec compares with
  // `Complex.method(:rectangular)`) has to find them.
  if str_eq cls "Complex" then
    (str_len name == 4 && str_eq name "rect") || (str_len name == 11 && str_eq name "rectangular") || (str_len name == 5 && str_eq name "polar")
  // Regexp's class methods live in the dispatcher too, and `Regexp.escape` is
  // the name a spec compares with `Regexp.quote` as Method objects.
  else if str_eq cls "Regexp" then
    (str_len name == 6 && str_eq name "escape") || (str_len name == 5 && str_eq name "quote") || (str_len name == 5 && str_eq name "union") ||
    (str_len name == 10 && str_eq name "last_match") || (str_len name == 3 && str_eq name "new") || (str_len name == 7 && str_eq name "compile") ||
    (str_len name == 11 && str_eq name "try_convert") || (str_len name == 7 && str_eq name "timeout") || (str_len name == 8 && str_eq name "timeout=") ||
    (str_len name == 12 && str_eq name "linear_time?")
  else if str_eq cls "Process" then (str_len name == 13 && str_eq name "clock_gettime")
  else if str_eq cls "GC" then
    (str_len name == 5 && str_eq name "start") || (str_len name == 6 && str_eq name "enable") || (str_len name == 7 && str_eq name "disable") ||
    (str_len name == 6 && str_eq name "stress") || (str_len name == 7 && str_eq name "stress=")
  // ⚠ Math's list here named SIX of its twenty-eight, so `Math.respond_to?(:log)`
  //   was false about a method that works. The namespaces answer from the one
  //   list their arm is guarded by.
  else ns_class_method cls name
and ns_class_method = fn (cls: str) -> fn (name: str) ->
  // Does the single-namespace arm for this class implement this name? See the
  // filens/dirns/mathns/ions note in name_spec: it guards the arm AND answers
  // respond_to?, so a name the call path handles cannot be denied by
  // reflection and a name it does not handle cannot be swallowed.
  if str_eq cls "File" || str_eq cls "FileTest" then map_has (name_set "filens") name
  else if str_eq cls "IO" then map_has (name_set "ions") name
  else if str_eq cls "Dir" then map_has (name_set "dirns") name
  else if str_eq cls "Math" then map_has (name_set "mathns") name
  else false
and is_module_method = fn (name: str) ->
  map_has (name_set "modmeth") name
and int_method_names = fn (u: unit) ->
  Cons ("to_int", Cons ("to_i", Cons ("to_f", Cons ("to_r", Cons ("to_c", Cons ("abs", Cons
  ("magnitude", Cons ("ceil", Cons ("floor", Cons ("round", Cons ("truncate", Cons ("succ",
  Cons ("next", Cons ("pred", Cons ("chr", Cons ("ord", Cons ("times", Cons ("upto", Cons
  ("downto", Cons ("step", Cons ("divmod", Cons ("fdiv", Cons ("div", Cons ("modulo", Cons
  ("remainder", Cons ("pow", Cons ("gcd", Cons ("lcm", Cons ("digits", Cons ("bit_length",
  Cons ("size", Cons ("even?", Cons ("odd?", Cons ("zero?", Cons ("positive?", Cons
  ("negative?", Cons ("nonzero?", Cons ("integer?", Cons ("finite?", Cons ("infinite?", Cons
  ("between?", Cons ("clamp", Cons ("coerce", Cons ("numerator", Cons ("denominator", Cons
  ("rationalize", Cons ("i", Cons ("real", Cons ("real?", Cons ("imaginary", Cons ("imag",
  Cons ("conjugate", Cons ("conj", Cons ("abs2", Cons ("arg", Cons ("angle", Cons ("phase",
  Cons ("polar", Cons ("rect", Cons ("rectangular", Cons ("quo", Cons ("<=>", Cons ("<",
  Cons ("<=", Cons (">", Cons (">=",
  // ⚠ five names the dispatcher IMPLEMENTS and this list did not claim, so
  // `10.allbits?(2)` answered true while `10.respond_to?(:allbits?)` answered
  // false -- and `Integer.instance_method(:allbits?)` was a NameError for a
  // method that works. Asked of the oracle per class
  // (`Integer.instance_methods(false)`), which is also how the four remaining
  // gaps in that comparison were found.
  Cons ("allbits?", Cons ("anybits?", Cons ("nobits?", Cons ("ceildiv", Cons ("gcdlcm",
  Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
and flt_method_names = fn (u: unit) ->
  Cons ("to_int", Cons ("to_i", Cons ("to_f", Cons ("to_r", Cons ("to_c", Cons ("abs", Cons
  ("magnitude", Cons ("ceil", Cons ("floor", Cons ("round", Cons ("truncate", Cons ("step",
  Cons ("divmod", Cons ("fdiv", Cons ("div", Cons ("modulo", Cons ("remainder", Cons
  ("zero?", Cons ("positive?", Cons ("negative?", Cons ("nonzero?", Cons ("integer?", Cons
  ("finite?", Cons ("infinite?", Cons ("nan?", Cons ("next_float", Cons ("prev_float", Cons
  ("between?", Cons ("clamp", Cons ("coerce", Cons ("numerator", Cons ("denominator", Cons
  ("rationalize", Cons ("i", Cons ("real", Cons ("real?", Cons ("imaginary", Cons ("imag",
  Cons ("conjugate", Cons ("conj", Cons ("abs2", Cons ("arg", Cons ("angle", Cons ("phase",
  Cons ("polar", Cons ("rect", Cons ("rectangular", Cons ("quo", Cons ("<=>", Cons ("<",
  Cons ("<=", Cons (">", Cons (">=",
  Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))
and rat_method_names = fn (u: unit) ->
  Cons ("to_int", Cons ("to_i", Cons ("to_f", Cons ("to_r", Cons ("to_c", Cons ("abs", Cons
  ("magnitude", Cons ("ceil", Cons ("floor", Cons ("round", Cons ("truncate", Cons ("step",
  Cons ("divmod", Cons ("fdiv", Cons ("div", Cons ("modulo", Cons ("remainder", Cons
  ("zero?", Cons ("positive?", Cons ("negative?", Cons ("nonzero?", Cons ("integer?", Cons
  ("finite?", Cons ("infinite?", Cons ("between?", Cons ("clamp", Cons ("coerce", Cons
  ("numerator", Cons ("denominator", Cons ("rationalize", Cons ("i", Cons ("real", Cons
  ("real?", Cons ("imaginary", Cons ("imag", Cons ("conjugate", Cons ("conj", Cons ("abs2",
  Cons ("arg", Cons ("angle", Cons ("phase", Cons ("polar", Cons ("rect", Cons
  ("rectangular", Cons ("quo", Cons ("<=>", Cons ("<", Cons ("<=", Cons (">", Cons (">=",
  Nil))))))))))))))))))))))))))))))))))))))))))))))))))
and cpx_method_names = fn (u: unit) ->
  Cons ("to_int", Cons ("to_i", Cons ("to_f", Cons ("to_r", Cons ("to_c", Cons ("abs", Cons
  ("magnitude", Cons ("fdiv", Cons ("zero?", Cons ("nonzero?", Cons ("integer?", Cons
  ("finite?", Cons ("infinite?", Cons ("coerce", Cons ("numerator", Cons ("denominator",
  Cons ("rationalize", Cons ("real", Cons ("real?", Cons ("imaginary", Cons ("imag", Cons
  ("conjugate", Cons ("conj", Cons ("abs2", Cons ("arg", Cons ("angle", Cons ("phase", Cons
  ("polar", Cons ("rect", Cons ("rectangular", Cons ("quo", Cons ("<=>",
  Nil))))))))))))))))))))))))))))))))
and num_names_for = fn (v: Val) ->
  // Numeric#-@ and #+@ are real methods of every numeric, and of nothing else
  Cons ("-@", Cons ("+@",
  match v with
  | VFlt _ -> flt_method_names ()
  | VRat (_, _) -> rat_method_names ()
  | VCpx (_, _) -> cpx_method_names ()
  | _ -> int_method_names ()))
and num_kind_key = fn (v: Val) ->
  match v with VFlt _ -> "f" | VRat (_, _) -> "r" | VCpx (_, _) -> "c" | _ -> "i"
and num_name_set = fn (v: Val) ->
  let k9 = num_kind_key v in
  if map_has num_names_memo k9 then map_get num_names_memo k9
  else
    (let seen9 = map_new () in
     let rec go9 = fn (xs: str list) ->
       (match xs with Nil -> () | Cons (h9, t9) -> (let _ = map_set seen9 h9 VNil in go9 t9)) in
     let _ = go9 (num_names_for v) in
     let _ = map_set num_names_memo k9 seen9 in
