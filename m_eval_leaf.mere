    "class Pathname\n" ++
    "  SEPARATOR = \"/\"\n" ++
    "  def self.pwd\n" ++
    "    new(Dir.pwd)\n" ++
    "  end\n" ++
    "  def self.getwd\n" ++
    "    new(Dir.pwd)\n" ++
    "  end\n" ++
    "  def initialize(path)\n" ++
    "    @path = path.to_s\n" ++
