  // NOT the padding family: ljust/rjust/center negotiate the receiver's and
  // the pad's encodings themselves, and this post-hoc retag clobbered that.
and range_delegate_name = fn (name: str) ->
  map_has (name_set "range_delegate_name") name
and enc_preserving = fn (name: str) ->
  map_has (name_set "enc_preserving") name
and prim_zero_arity = fn (recv: Val) -> fn (name: str) ->
  let any = (str_len name == 4 && str_eq name "hash") || (str_len name == 6 && str_eq name "freeze") || (str_len name == 7 && str_eq name "frozen?")
            || (str_len name == 3 && str_eq name "dup") || (str_len name == 4 && str_eq name "nil?") in
  if any then true
  else
    let str_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 7 && str_eq name "reverse") || (str_len name == 5 && str_eq name "chars") || (str_len name == 5 && str_eq name "bytes")
                || (str_len name == 10 && str_eq name "codepoints") || (str_len name == 6 && str_eq name "to_sym") || (str_len name == 4 && str_eq name "to_s")
                // (strip / lstrip / rstrip left this list with ruby 4.0: they
                // take selector arguments now, and check them themselves)
                || (str_len name == 4 && str_eq name "to_f")
                || (str_len name == 4 && str_eq name "chop") || (str_len name == 4 && str_eq name "succ")
                || (str_len name == 4 && str_eq name "next") || (str_len name == 7 && str_eq name "inspect") || (str_len name == 6 && str_eq name "to_str")
                || (str_len name == 3 && str_eq name "ord") || (str_len name == 3 && str_eq name "chr") in
    let int_n = (str_len name == 4 && str_eq name "size") || (str_len name == 4 && str_eq name "to_f") || (str_len name == 4 && str_eq name "to_i")
                || (str_len name == 4 && str_eq name "succ") || (str_len name == 4 && str_eq name "next") || (str_len name == 3 && str_eq name "abs")
                || (str_len name == 5 && str_eq name "even?") || (str_len name == 4 && str_eq name "odd?") || (str_len name == 5 && str_eq name "zero?")
                || (str_len name == 9 && str_eq name "positive?") || (str_len name == 9 && str_eq name "negative?") || (str_len name == 3 && str_eq name "ord") in
    let arr_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 7 && str_eq name "reverse") || (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "to_a")
                || (str_len name == 4 && str_eq name "to_h") || (str_len name == 7 && str_eq name "inspect") || (str_len name == 4 && str_eq name "sort")
                || (str_len name == 4 && str_eq name "uniq") || (str_len name == 7 && str_eq name "compact") in
    let hsh_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 4 && str_eq name "keys") || (str_len name == 6 && str_eq name "values") || (str_len name == 4 && str_eq name "to_s")
                || (str_len name == 4 && str_eq name "to_a") || (str_len name == 4 && str_eq name "to_h") || (str_len name == 7 && str_eq name "inspect")
                || (str_len name == 4 && str_eq name "sort") || (str_len name == 4 && str_eq name "uniq") || (str_len name == 7 && str_eq name "compact")
                || (str_len name == 7 && str_eq name "to_proc") in
    let nil_n = (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "to_f") || (str_len name == 4 && str_eq name "to_i")
                || (str_len name == 4 && str_eq name "to_a") || (str_len name == 4 && str_eq name "to_h") || (str_len name == 7 && str_eq name "inspect") in
    let sym_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 6 && str_eq name "to_sym") || (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "succ")
                || (str_len name == 4 && str_eq name "next") || (str_len name == 7 && str_eq name "inspect") || (str_len name == 7 && str_eq name "to_proc") in
    let flt_n = (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "to_f") || (str_len name == 4 && str_eq name "to_i")
                || (str_len name == 7 && str_eq name "inspect") || (str_len name == 3 && str_eq name "abs") || (str_len name == 5 && str_eq name "zero?")
                || (str_len name == 9 && str_eq name "positive?") || (str_len name == 9 && str_eq name "negative?") in
    (match recv with
     | VStr _ -> str_n
     | VInt _ -> int_n
     | VArr _ -> arr_n
     | VHsh _ -> hsh_n
     | VNil -> nil_n
     | VSym _ -> sym_n
     | VFlt _ -> flt_n
     | _ -> false)
and sym_str_method = fn (name: str) ->
  sym_str_resym name || (str_len name == 11 && str_eq name "start_with?") || (str_len name == 9 && str_eq name "end_with?") ||
  (str_len name == 7 && str_eq name "casecmp") || (str_len name == 8 && str_eq name "casecmp?") || (str_len name == 6 && str_eq name "empty?") ||
  (str_len name == 2 && str_eq name "[]") || (str_len name == 5 && str_eq name "slice")
and sym_str_resym = fn (name: str) ->
  (str_len name == 8 && str_eq name "downcase") || (str_len name == 6 && str_eq name "upcase") || (str_len name == 10 && str_eq name "capitalize") ||
  (str_len name == 8 && str_eq name "swapcase") || (str_len name == 4 && str_eq name "succ") || (str_len name == 4 && str_eq name "next")
and cls_display_nw = fn (c: str) ->
  if is_sng_cls c then
    (let inner = sng_inner c in
     if str_len inner > 0 && is_digit (char_at inner 0) then c
     else "#<Class:" ++ cls_display_nw inner ++ ">")
  else if is_anon_cls c then
    (if map_has anon_name c then (match map_get anon_name c with VStr h -> sget h | _ -> c)
     else (let kind = (if str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_" then "Module" else "Class") in
           "#<" ++ kind ++ ":0x" ++ hex16_of (anon_addr_of c) ++ ">"))
  else c
and prim_blame = fn (recv: Val) ->
  (match recv with
   | VClass c -> " for " ++ (if map_has modules c then "module " else "class ") ++ cls_display_nw c
   | VMain -> " for main"
   | VObj _ -> ""
   | other -> " for " ++ for_recv_name other)
and str_set_args = fn (args: Val list) ->
  match args with
  | Nil -> (Nil : str list)
  | Cons (VStr h, t) ->
    let _ = (let e = enc_canon_name (senc_get h) in
             if enc_valid (sget h) e then ()
             else (let _ = prim_raise "ArgumentError" ("invalid byte sequence in " ++ e) in ())) in
    Cons (sget h, str_set_args t)
  | Cons (other, _) ->
    (let _ = prim_raise "TypeError" ("no implicit conversion of " ++ conv_gives_name other ++ " into String") in
     (Nil : str list))
and class_name = fn (recv: Val) ->
  match recv with
  | VInt _ -> "Integer" | VBig _ -> "Integer" | VFlt _ -> "Float" | VStr _ -> "String"
  | VRat _ -> "Rational" | VCpx _ -> "Complex"
  | VBool b -> if b then "TrueClass" else "FalseClass"
  | VNil -> "NilClass" | VArr _ -> "Array" | VHsh _ -> "Hash" | VSym _ -> "Symbol"
  // ⚠ a REFINEMENT is its own class in ruby: `refine String { }` answers
  //   something whose #class is Refinement, a subclass of Module.
  | VRange _ -> "Range"
  | VClass c -> (if str_len c >= 7 && str_eq (substring c 0 7) "Refine_" then "Refinement"
                 else if map_has modules c then "Module" else "Class")
  // ⚠ the object's own class, not the word "Object". A refusal message names
  // the class ruby would name, and a hanging SINGLETON is not it -- `def o.x`
  // makes o's recorded class `#<Class:...>` and ruby still says M3.
  | VObj oid -> obj_cls_name oid
  | VExc (c, _) -> c | VProc _ -> "Proc" | VBind _ -> "Binding" | VRegex _ -> "Regexp" | VMain -> "Object"
and rng_int = fn (v: Val) -> match v with VInt n -> n | VFlt f -> int_of_float f | _ -> 0
and rng_is_int = fn (v: Val) -> match v with VInt _ -> true | _ -> false
and hash_bracket = fn world -> fn (args: Val list) ->
  match args with
  // ⚠ `Hash[other]` copies the PAIRS only. ruby 3.2 carried the identity flag
  //   along and this was written against that reference, with a note that the
  //   spec asked otherwise; ruby 4 leaves the flag behind, which is what the
  //   spec has always said.
  | Cons (VHsh h, Nil) -> mkhash (hderef h)
  | Cons (VArr id, Nil) -> mkhash (hash_from_pairs world (deref id))
  | Nil -> mkhash Nil
  | _ ->
    // a flat list IS the internal shape (k, v, k, v ...)
    (if imod (val_list_len args) 2 == 0 then mkhash args
     else raise_exc world "ArgumentError" "odd number of arguments for Hash")
and hash_from_pairs = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (x, rest) ->
    (match x with
     | VArr pid ->
       (match deref pid with
        | Cons (k, Cons (v, Nil)) -> Cons (k, Cons (v, hash_from_pairs world rest))
        | Cons (k, Nil) -> Cons (k, Cons (VNil, hash_from_pairs world rest))
        | other ->
          (let n = val_list_len other in
           let _ = raise_exc world "ArgumentError"
             ("invalid number of elements (" ++ str_of_int n ++ " for 1..2)") in Nil))
     | _ ->
       (let _ = raise_exc world "ArgumentError" "wrong element type (expected array)" in Nil))
and rng_num_kind = fn (v: Val) ->
  match v with
  | VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat (_, _) -> true
  | _ -> false
and cmp_kind = fn (v: Val) ->
  match v with
  | VInt _ -> "n" | VBig _ -> "n" | VFlt _ -> "n" | VRat (_, _) -> "n"
  | VStr _ -> "s"
  | VSym _ -> "y"
  | VArr _ -> "a"
  | VObj _ -> "o"
  | VClass _ -> "c"
  | _ -> "?"
and cmp_possible = fn (a: Val) -> fn (b: Val) ->
  let ka = cmp_kind a in
  let kb = cmp_kind b in
  if str_eq ka "o" || str_eq kb "o" then true
  else (if str_eq ka "?" then false else true) && str_eq ka kb
and rng_n_from = fn (cur: str) -> fn (stop: str) -> fn (step: int) -> fn (k: int) -> fn (acc: Val list) ->
  if k <= 0 then rev_app acc Nil
  else if (if step > 0 then big_cmp_s cur stop > 0 else big_cmp_s cur stop < 0) then rev_app acc Nil
  else rng_n_from (if step > 0 then big_add_s cur "1" else big_sub_s cur "1") stop step (k - 1)
         (Cons (norm_big cur, acc))
and rat_divmod_pair = fn (a: Val) -> fn (b: Val) ->
  let q = (match rat_arith "/" a b with
           | VRat (qn, qd) -> norm_big (rat_int_mode "floor" qn qd)
           | VInt qi -> VInt qi
           | VBig qb -> norm_big qb
           | VFlt qf -> VInt (flt_floor qf)
           | v -> v) in
  arr_new (Cons (q, Cons (rat_arith "-" a (rat_arith "*" q b), Nil)))
and hash_new_kw = fn world -> fn (args: Val list) ->
  let peel = fn (h: Val) -> fn (rest: Val list) ->
    (let bad = hash_new_kw_bad (match h with VHsh hh -> hderef hh | _ -> Nil) "" 0 in
     if str_eq bad "" then (rest, false)
     else (let _ = raise_exc world "ArgumentError" bad in ((Nil : Val list), true))) in
  match args with
  | Cons (VHsh h, Nil) ->
    (if is_kw_hash (VHsh h) then peel (VHsh h) Nil else (args, false))
  | Cons (d, Cons (VHsh h, Nil)) ->
    (if is_kw_hash (VHsh h) then peel (VHsh h) (Cons (d, Nil)) else (args, false))
  | _ -> (args, false)
and hash_new_kw_bad = fn (xs: Val list) -> fn (acc: str) -> fn (n: int) ->
  match xs with
  | Cons (k, Cons (_, t)) ->
    (if (match k with VSym s9 -> str_eq s9 "capacity" | _ -> false)
     then hash_new_kw_bad t acc n
     else hash_new_kw_bad t (acc ++ (if str_eq acc "" then "" else ", ") ++ inspect k) (n + 1))
  | _ -> (if n == 0 then ""
          else if n == 1 then "unknown keyword: " ++ acc
          else "unknown keywords: " ++ acc)
and rng_int_side = fn (v: Val) ->
  match v with VInt n -> str_of_int n | VBig b -> b | _ -> ""
and rng_int_top = fn (hi: Val) -> fn (excl: bool) ->
  match hi with
  | VInt _ -> (let s = rng_int_side hi in if excl then big_sub_s s "1" else s)
  | VBig _ -> (let s = rng_int_side hi in if excl then big_sub_s s "1" else s)
  | VFlt f ->
    (let t = flt_floor f in
     let s = str_of_int t in
     if excl && float_of_int t == f then big_sub_s s "1" else s)
  | _ -> ""
and rng_int_span = fn (lo_s: str) -> fn (top: str) ->
  if str_eq lo_s "" || str_eq top "" then VNil
  else if big_cmp_s top lo_s < 0 then VInt 0
  else norm_big (big_add_s (big_sub_s top lo_s) "1")
and rng_int_gauss = fn (lo_s: str) -> fn (top: str) ->
  if str_eq lo_s "" || str_eq top "" then VNil
  else if big_cmp_s top lo_s < 0 then VInt 0
  else norm_big (big_div_s (big_mul_s (big_add_s lo_s top)
                                      (big_add_s (big_sub_s top lo_s) "1")) "2")
and rng_walk_from = fn (lo: Val) ->
  match lo with
  | VInt _ -> "" | VBig _ -> "" | VStr _ -> "" | VSym _ -> "" | VObj _ -> ""
  | VNil -> "NilClass"
  | _ -> class_name lo
and rng_overlap = fn (lo1: Val) -> fn (hi1: Val) -> fn (ex1: bool) -> fn (o: Val) ->
  match o with
  | VRange (lo2, hi2, ex2) ->
    (if rng_empty lo1 hi1 ex1 || rng_empty lo2 hi2 ex2 then VBool false
     // boundaries that cannot be compared do not overlap -- ruby answers false
     // for `("a".."c").overlap?(1..3)` rather than raising.
     else if (match (hi1, lo2) with
              | (VNil, _) -> false
              | (_, VNil) -> false
              | _ -> (if cmp_possible hi1 lo2 then false else true)) then VBool false
     else
       // they overlap unless one ends before the other begins
       (let ends_before = fn (hx: Val) -> fn (ly: Val) -> fn (ex: bool) ->
          (match hx with
           | VNil -> false
           | _ -> (match ly with
                   | VNil -> false
                   | _ -> (let c = cmp_vals hx ly in if ex then c <= 0 else c < 0))) in
        VBool ((if ends_before hi1 lo2 ex1 then false else true)
               && (if ends_before hi2 lo1 ex2 then false else true))))
  | _ -> prim_raise "TypeError" ("wrong argument type " ++ class_name o ++ " (expected Range)")
and rng_iter_refusal = fn (lo: Val) -> fn (hi: Val) ->
  let w = rng_walk_from lo in
  if not (str_eq w "") then w
  else (match lo with
        | VStr _ -> (match hi with VStr _ -> "" | VNil -> "" | _ -> "String")
        | VSym _ -> (match hi with VSym _ -> "" | VNil -> "" | _ -> "Symbol")
        // an object range is walked by the arm that has the world to ask
        // #succ; one arriving at the leaf has no walk.
        | VObj _ -> class_name lo
        | _ -> (match hi with VInt _ -> "" | VBig _ -> "" | VFlt _ -> "" | VNil -> "" | _ -> "Integer"))
and rng_covers = fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (v: Val) ->
  if (match lo with VNil -> false | _ -> (if cmp_possible v lo then false else true)) then false
  else if (match hi with VNil -> false | _ -> (if cmp_possible v hi then false else true)) then false
  else
    (match lo with VNil -> true | _ -> cmp_vals v lo >= 0)
    && (match hi with
        | VNil -> true
        | _ -> if excl then cmp_vals v hi < 0 else cmp_vals v hi <= 0)
and rng_empty = fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) ->
  match lo with
  | VNil -> false
  | _ -> (match hi with
          | VNil -> false
          | _ -> (let c = cmp_vals lo hi in if excl then c >= 0 else c > 0))
and rng_slice_bounds = fn (lov: Val) -> fn (hiv: Val) -> fn (ex: bool) -> fn (n: int) ->
  let st0 = (match lov with VInt a -> a | _ -> 0) in
  let st = (if st0 < 0 then n + st0 else st0) in
  let en = (match hiv with
            | VInt b -> (let b2 = (if b < 0 then n + b else b) in if ex then b2 else b2 + 1)
            | _ -> n) in
  (st, en)
and rng_sum = fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (init: Val) ->
  let w = rng_walk_from lo in
  if not (str_eq w "") then prim_raise "TypeError" ("can't iterate from " ++ w)
  else
    (match lo with
     | VInt _ ->
       (match rng_int_gauss (rng_int_side lo) (rng_int_top hi excl) with
        | VNil -> val_sum (range_vals_raw lo hi excl) init
        | g -> val_sum (Cons (g, Nil)) init)
     | VBig _ ->
       (match rng_int_gauss (rng_int_side lo) (rng_int_top hi excl) with
        | VNil -> val_sum (range_vals_raw lo hi excl) init
        | g -> val_sum (Cons (g, Nil)) init)
     | _ -> val_sum (range_vals_raw lo hi excl) init)
and rng_big_vals = fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) ->
  let a = rng_int_side lo in
  let top = rng_int_top hi excl in
  (match rng_int_span a top with
   | VInt n -> (if n > 1000000 then (Nil : Val list) else rng_n_from a top 1 n Nil)
   | _ -> (Nil : Val list))
and range_vals_raw = fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) ->
  match lo with
  | VInt a ->
    (match hi with
     | VInt b -> range_to_a a (if excl then b - 1 else b)
     // an integer range with a Float end stops at floor(end); an exclusive
     // one stops one short when the end is integer-valued.
     | VFlt f ->
       (let t = int_of_float f in
        let fl = (if float_of_int t > f then t - 1 else t) in
        range_to_a a (if excl && feq f (float_of_int fl) then fl - 1 else fl))
     | VBig _ -> rng_big_vals lo hi excl
     | _ -> Nil)
  // a BIGNUM begin walks the same way -- `(2**64..2**64+2).to_a` answered
  // "can't iterate from Integer", which is what an unwalkable begin says.
  | VBig _ ->
    (match hi with
     | VInt _ -> rng_big_vals lo hi excl
     | VBig _ -> rng_big_vals lo hi excl
     | VFlt _ -> rng_big_vals lo hi excl
     | _ -> Nil)
  | VStr slo ->
    (match hi with
     | VStr shi -> rng_str_walk (sget slo) (sget shi) excl 0 Nil
     | _ -> Nil)
  // a SYMBOL range walks its succ the way a String range does -- `(:a..:c)`
  // is [:a, :b, :c] and answered [] here.
  | VSym slo ->
    (match hi with
     | VSym shi -> rng_sym_of (rng_str_walk slo shi excl 0 Nil)
     | _ -> Nil)
  | _ -> Nil
and rng_sym_of = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VStr h, t) -> Cons (VSym (sget h), rng_sym_of t)
  | Cons (x, t) -> Cons (x, rng_sym_of t)
and range_vals = fn world -> fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) ->
  match hi with
  | VNil -> raise_exc_list world "RangeError" "cannot convert endless range to an array"
  | _ ->
    (match lo with
     | VNil -> raise_exc_list world "TypeError" "can't iterate from NilClass"
     | VInt _ -> (match hi with
                  | VInt _ -> range_vals_raw lo hi excl
                  | VFlt _ -> range_vals_raw lo hi excl
                  | VBig _ -> range_vals_raw lo hi excl
                  | _ -> raise_exc_list world "TypeError" "can't iterate from Integer")
     | VBig _ -> (match hi with
                  | VInt _ -> range_vals_raw lo hi excl
                  | VBig _ -> range_vals_raw lo hi excl
                  | VFlt _ -> range_vals_raw lo hi excl
                  | _ -> raise_exc_list world "TypeError" "can't iterate from Integer")
     | VStr _ -> (match hi with
                  | VStr _ -> range_vals_raw lo hi excl
                  | _ -> raise_exc_list world "TypeError" "can't iterate from String")
     | VSym _ -> (match hi with
                  | VSym _ -> range_vals_raw lo hi excl
                  | _ -> raise_exc_list world "TypeError" "can't iterate from Symbol")
     | _ -> raise_exc_list world "TypeError" ("can't iterate from " ++ class_name lo))
and rng_str_take = fn (cur: str) -> fn (n: int) -> fn (acc: Val list) ->
  if n <= 0 then rev_app acc Nil
  else rng_str_take (str_succ cur) (n - 1) (Cons (mkstr cur, acc))
and rng_cp_walk = fn (cp: int) -> fn (last: int) -> fn (excl: bool) -> fn (acc: Val list) ->
  if cp > last then rev_app acc Nil
  else if cp == last then (if excl then rev_app acc Nil else rev_app (Cons (mkstr (utf8_enc cp), acc)) Nil)
  else rng_cp_walk (cp + 1) last excl (Cons (mkstr (utf8_enc cp), acc))
and rng_str_walk = fn (cur: str) -> fn (last: str) -> fn (excl: bool) -> fn (n: int) -> fn (acc: Val list) ->
  // SINGLE-BYTE endpoints, not single-character ones. ruby's String#upto takes
  // the codepoint path only for a single byte; a multi-byte character walks
  // #succ with a comparison bound, and the two disagree once the range spans
  // more than one script: `("\u{999}".."\u{9999}").to_a` is 31 entries in ruby
  // (it stops inside the Bengali block) and 36865 by codepoint.
  //
  // `('Σ'..'Ω')` agreed either way -- succ on Greek IS codepoint+1 -- which is
  // why nothing showed the difference until a range crossed scripts.
  if str_len cur == 1 && str_len last == 1 then
    (let (c1, _) = utf8_cp cur 0 in
     let (c2, _) = utf8_cp last 0 in
     rng_cp_walk c1 c2 excl acc)
  else rng_str_walk_succ cur last excl n acc
and rng_str_walk_succ = fn (cur: str) -> fn (last: str) -> fn (excl: bool) -> fn (n: int) -> fn (acc: Val list) ->
  if n > 100000 then rev_app acc Nil
  else if str_len cur > str_len last then rev_app acc Nil
  else if str_len cur == str_len last && cur > last then rev_app acc Nil
  else if str_eq cur last then (if excl then rev_app acc Nil else rev_app (Cons (mkstr cur, acc)) Nil)
  else rng_str_walk_succ (str_succ cur) last excl (n + 1) (Cons (mkstr cur, acc))
and raise_exc_list = fn world -> fn (cls: str) -> fn (msg: str) ->
  let _ = raise_exc world cls msg in Nil
and range_to_a = fn (i: int) -> fn (last: int) ->
  if i > last then Nil else Cons (VInt i, range_to_a (i + 1) last)
and rb_fmt_to_named = fn (mode: int) ->
  if mode == 1 || mode == 2 then (let _ = prim_raise "ArgumentError" "named after unnumbered or numbered format" in 3) else 3
and rb_fmt_is_type = fn (c: str) ->
  map_has (name_set "rb_fmt_is_type") c
and rb_fmt_posarg = fn (args: Val list) -> fn (k: int) ->
  if k > val_list_len args then (let _ = prim_raise "ArgumentError" "too few arguments" in VNil)
  else val_nth args (k - 1)
and rb_fmt_enc = fn (fenc: str) -> fn (fs: str) -> fn (args: Val list) ->
  match args with
  | Nil -> enc_canon_name fenc
  | Cons (VStr h, t) ->
    let r = enc_compat2 fenc fs (senc_get h) (sget h) in
    (if str_eq r "" then
       (let _ = prim_raise "Encoding::CompatibilityError"
                  ("incompatible character encodings: " ++ enc_canon_name fenc ++ " and " ++ enc_canon_name (senc_get h)) in "")
     else rb_fmt_enc r (fs ++ sget h) t)
  | Cons (_, t) -> rb_fmt_enc fenc fs t
and rb_fmt_name = fn (fmt: str) -> fn (i: int) -> fn (acc: str) -> fn (close: str) ->
  if i >= str_len fmt then (acc, i)
  else if str_eq (char_at fmt i) close then (acc, i + 1)
  else rb_fmt_name fmt (i + 1) (acc ++ char_at fmt i) close
and rb_fmt_digits = fn (fmt: str) -> fn (i: int) -> fn (acc: int) -> fn (seen: bool) ->
  if i < str_len fmt && is_digit (char_at fmt i)
  then rb_fmt_digits fmt (i + 1) (acc * 10 + (ord (char_at fmt i) - 48)) true
  else ((if seen then acc else 0 - 1), i)
and kern_exc_kw = fn (v: Val) ->
  (match v with
   | VHsh h -> (match hash_lookup (hderef h) (VSym "exception") with
                // ⚠ `exception:` takes true or false and NOTHING else, and ruby
                // checks the keyword before it looks at the value -- so
                // `Float("x", exception: 1)` reports the keyword, not the
                // unparsable string. Reading it as "truthy" accepted the
                // caller's mistake and then answered a different error.
                | (true, x) ->
                  (if conv_exc_kw_bad x
                   then (let _ = prim_raise "ArgumentError"
                                   ("expected true or false as exception: " ++ inspect x) in (true, true))
                   else (true, truthy x))
                | _ -> (false, true))
   | _ -> (false, true))
and kern_conv_kw = fn (args: Val list) ->
  match args with
  | Cons (a, Cons (b, Cons (c, Nil))) ->
    (match kern_exc_kw c with (true, r) -> (Cons (a, Cons (b, Nil)), r) | _ -> (args, true))
  | Cons (a, Cons (b, Nil)) ->
    (match kern_exc_kw b with (true, r) -> (Cons (a, Nil), r) | _ -> (args, true))
  | Cons (a, Nil) ->
    (match kern_exc_kw a with (true, r) -> ((Nil : Val list), r) | _ -> (args, true))
  | _ -> (args, true)
and conv_gives_name = fn (v: Val) ->
  match v with
  | VNil -> "nil"
  | VBool b -> (if b then "true" else "false")
  | other -> class_name other
and is_kernel_conv = fn (name: str) ->
  (str_len name == 7 && str_eq name "Integer") || (str_len name == 5 && str_eq name "Float") || (str_len name == 6 && str_eq name "String") ||
  (str_len name == 5 && str_eq name "Array") || (str_len name == 4 && str_eq name "Hash") || (str_len name == 8 && str_eq name "Rational") ||
  (str_len name == 7 && str_eq name "Complex")
and kern_cpx_str = fn world -> fn (h: int) -> fn (raising: bool) ->
  let e = enc_canon_name (senc_get h) in
  // the encoding is checked OUTSIDE the no-exception window (ruby's
  // rb_must_asciicompat runs before it), so this one raises either way.
  if (if enc_ascii_compat e then false else true)
  then (let _ = prim_raise "Encoding::CompatibilityError" ("ASCII incompatible encoding: " ++ e) in VNil)
  else
    let txt = sget h in
    if str_index_of txt (chr 0) >= 0
    then (if raising then (let _ = prim_raise "ArgumentError" "string contains null byte" in VNil) else VNil)
    else
      (match rb_str_to_c_ok txt with
       | (v, true) -> v
       | (_, _) -> (if raising
                    then (let _ = prim_raise "ArgumentError"
                            ("invalid value for convert(): " ++ inspect (VStr h)) in VNil)
                    else VNil))
and conv_protect = fn world -> fn th ->
  let (m0, s0, o0, iv0) = world in
  let prev_bang = (if map_has globals "!" then map_get globals "!" else VNil) in
  let had = map_has iv0 "$exc" in
  let prev_exc = (if had then map_get iv0 "$exc" else VNil) in
  let r = try_or th VNil in
  let _ = conv_clear_raise () in
  let _ = map_set globals "!" prev_bang in
  let _ = (if had then map_set iv0 "$exc" prev_exc
           else (if map_has iv0 "$exc" then map_delete iv0 "$exc" else ())) in
  r
and conv_clear_raise = fn () ->
  let _ = (if map_has prim_missing "i" then map_delete prim_missing "i" else ()) in
  let _ = (if map_has prim_missing "c" then map_delete prim_missing "c" else ()) in
  let _ = (if map_has prim_missing "m" then map_delete prim_missing "m" else ()) in
  let _ = (if map_has prim_missing "f" then map_delete prim_missing "f" else ()) in
  let _ = (if map_has prim_missing "rl" then map_delete prim_missing "rl" else ()) in
  let _ = if map_has prim_missing "rd" then map_delete prim_missing "rd" else () in
  let _ = bi_rescued () in
  let _ = if map_has prim_missing "rbt" then map_delete prim_missing "rbt" else () in
  ()
and kern_unwrap_cpx = fn (v: Val) ->
  match v with VCpx (re, im) -> (if exact_zero_val im then re else v) | other -> other
and kern_is_numeric = fn world -> fn (v: Val) ->
  match v with
  | VInt _ -> true | VBig _ -> true | VFlt _ -> true
  | VRat (_, _) -> true | VCpx (_, _) -> true
  | VObj _ -> exc_is_a world (class_name v) "Numeric"
  | _ -> false
and kern_is_int = fn (v: Val) -> match v with VInt _ -> true | VBig _ -> true | _ -> false
and kern_int_value = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VInt n -> VInt n
  | VBig b -> VBig b
  | VRat (n, d) -> (if str_eq d "1" then norm_big n
                    else (let _ = prim_raise "TypeError" "not an integer" in VInt 0))
  | other -> (let _ = prim_raise "TypeError" "not an integer" in VInt 0)
and flt_is_big_whole = fn (f: float) ->
  f >= 9007199254740992.0 || f <= (0.0 - 9007199254740992.0)
and flt_floor_v = fn (f: float) -> if flt_is_big_whole f then kern_flt_to_int f else VInt (flt_floor f)
and flt_ceil_v  = fn (f: float) -> if flt_is_big_whole f then kern_flt_to_int f else VInt (flt_ceil f)
and flt_round_v = fn (f: float) -> if flt_is_big_whole f then kern_flt_to_int f else VInt (flt_round f)
and flt_trunc_v = fn (f: float) -> if flt_is_big_whole f then kern_flt_to_int f else VInt (int_of_float f)
and kern_flt_to_int = fn (f: float) ->
  let sp = float_special f in
  if str_eq sp "NaN" then (let _ = conv_fail "FloatDomainError" "NaN" in VNil)
  else if str_eq sp "Inf" then
    (let _ = conv_fail "FloatDomainError" (if f < 0.0 then "-Infinity" else "Infinity") in VNil)
  else if f < 9007199254740992.0 && f > (0.0 - 9007199254740992.0) then VInt (int_of_float f)
  else norm_big (flt_to_big_s f)
and rb_int_parse = fn (s0: str) -> rb_int_parse_b s0 0
and rb_int_parse_b = fn (s0: str) -> fn (base0: int) ->
  if base0 == 1 || base0 < 0 || base0 > 36 then
    (let _ = conv_fail "ArgumentError" ("invalid radix " ++ str_of_int base0) in VNil)
  else
  let n0 = str_len s0 in
  let lo = rb_int_ltrim s0 0 in
  let hi = rb_int_rtrim s0 n0 in
  if lo >= hi then (let _ = conv_fail "ArgumentError" ("invalid value for Integer(): \"" ++ s0 ++ "\"") in VNil)
  else
    let (neg, i1) = (let c = char_at s0 lo in
                     if str_eq c "-" then (true, lo + 1)
                     else if str_eq c "+" then (false, lo + 1) else (false, lo)) in
    if i1 >= hi then (let _ = conv_fail "ArgumentError" ("invalid value for Integer(): \"" ++ s0 ++ "\"") in VNil)
    else
      let (base, i2) =
        (if str_eq (char_at s0 i1) "0" && i1 + 1 < hi then
           (let c2 = char_at s0 (i1 + 1) in
            let pb = (if str_eq c2 "x" || str_eq c2 "X" then 16
                      else if str_eq c2 "b" || str_eq c2 "B" then 2
                      else if str_eq c2 "o" || str_eq c2 "O" then 8
                      else if str_eq c2 "d" || str_eq c2 "D" then 10
                      else 0) in
            if base0 == 0 then (if pb == 0 then (8, i1 + 1) else (pb, i1 + 2))
            else if pb == base0 then (base0, i1 + 2)
            else (base0, i1))
         else (if base0 == 0 then (10, i1) else (base0, i1))) in
      let v = rb_int_digits s0 i2 hi base false false (VInt 0) in
      (match v with
       | VInt x -> VInt (if neg then 0 - x else x)
       | VBig s -> norm_big (if neg then "-" ++ s else s)
       | other -> other)
and rb_int_ltrim = fn (s: str) -> fn (i: int) ->
  if i < str_len s && rb_int_is_sp (char_at s i) then rb_int_ltrim s (i + 1) else i
and rb_int_rtrim = fn (s: str) -> fn (j: int) ->
  if j > 0 && rb_int_is_sp (char_at s (j - 1)) then rb_int_rtrim s (j - 1) else j
and rb_int_is_sp = fn (c: str) ->
  let o = ord c in o == 32 || (o >= 9 && o <= 13)
and rb_int_digits = fn (s0: str) -> fn (i: int) -> fn (hi: int) -> fn (base: int) ->
  fn (prev_us: bool) -> fn (seen: bool) -> fn (acc: Val) ->
  if i >= hi then
    (if seen && prev_us == false then acc
     else (let _ = conv_fail "ArgumentError" ("invalid value for Integer(): \"" ++ s0 ++ "\"") in VNil))
  else
    let c = char_at s0 i in
    if str_eq c "_" then
      (if seen == false || prev_us
       then (let _ = conv_fail "ArgumentError" ("invalid value for Integer(): \"" ++ s0 ++ "\"") in VNil)
       else rb_int_digits s0 (i + 1) hi base true seen acc)
    else
      let dv = rb_digit_val_x c in
      (if dv < 0 || dv >= base
       then (let _ = conv_fail "ArgumentError" ("invalid value for Integer(): \"" ++ s0 ++ "\"") in VNil)
       else rb_int_digits s0 (i + 1) hi base false true (rb_int_acc acc base dv))
and rb_int_acc = fn (acc: Val) -> fn (base: int) -> fn (dv: int) ->
  match acc with
  | VInt x -> (if x > (int_max - dv) / base then rb_int_acc (VBig (int_to_base x 10)) base dv else VInt (x * base + dv))
  | VBig s -> VBig (big_add_s (big_mul_s s (int_to_base base 10)) (int_to_base dv 10))
  | _ -> acc
and rb_digit_val_x = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 122 then o - 87
  else if o >= 65 && o <= 90 then o - 55
  else 0 - 1
and rb_hexf = fn (ds: str) -> fn (i: int) -> fn (acc: float) ->
  if i >= str_len ds then acc
  else rb_hexf ds (i + 1) (acc * 16.0 + float_of_int (rb_digit_val_x (char_at ds i)))
and rb_powf = fn (b: float) -> fn (e: int) ->
  if e <= 0 then 1.0 else b * rb_powf b (e - 1)
and rb_flt_parse = fn (s0: str) ->
  let hi = rb_int_rtrim s0 (str_len s0) in
  let lo = rb_int_ltrim s0 0 in
  if lo >= hi then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
  else
    let (neg, i1) = (let c = char_at s0 lo in
                     if str_eq c "-" then (true, lo + 1)
                     else if str_eq c "+" then (false, lo + 1) else (false, lo)) in
    let sgn = (if neg then 0.0 - 1.0 else 1.0) in
    if i1 >= hi then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
    else if str_eq (char_at s0 i1) "0" && i1 + 1 < hi
            && (str_eq (char_at s0 (i1 + 1)) "x" || str_eq (char_at s0 (i1 + 1)) "X") then
      // hex: digits [. digits] [p exp]
      let (ds, i2) = rb_flt_digits s0 (i1 + 2) hi true false false "" in
      let (fs, i3, hdot) = (if i2 < hi && str_eq (char_at s0 i2) "."
                            then (match rb_flt_digits s0 (i2 + 1) hi true false false "" with (a, b) -> (a, b, true))
                            else ("", i2, false)) in
      // ⚠ ...unless a DOT was there: ruby answers 0.0 for "0x." (and "0X."),
      //   with no digits on either side of it. "0x" alone is still refused, so
      //   the dot is what makes the difference -- strtod's own corner, and this
      //   record compares against strtod.
      if str_len ds == 0 && str_len fs == 0 && (if hdot then false else true)
      then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
      // ⚠ ruby 3.2's strtod read a hex FRACTION only together with a p
      //   exponent ("0x0.8" refused where "0x0.8p1" is 1.0) and this was
      //   written against that reference; ruby 4 reads it either way, so
      //   Float("0x0.8") is 0.5.
      else
        let (pexp, i4) =
          (if i3 < hi && (str_eq (char_at s0 i3) "p" || str_eq (char_at s0 i3) "P") then
             (let (pneg, ip) = (if i3 + 1 < hi && str_eq (char_at s0 (i3 + 1)) "-" then (true, i3 + 2)
                                else if i3 + 1 < hi && str_eq (char_at s0 (i3 + 1)) "+" then (false, i3 + 2)
                                else (false, i3 + 1)) in
              let (es, i5) = rb_flt_digits s0 ip hi false false false "" in
              if str_len es == 0 then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in (0, i5))
              else ((if pneg then 0 - int_of_str es else int_of_str es), i5))
           else (0, i3)) in
        if i4 < hi then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
        else
          let iv = rb_hexf ds 0 0.0 in
          let fv = (if str_len fs == 0 then 0.0 else rb_hexf fs 0 0.0 / rb_powf 16.0 (str_len fs)) in
          sgn * (iv + fv) * (if pexp >= 0 then rb_powf 2.0 pexp else 1.0 / rb_powf 2.0 (0 - pexp))
    else
      // decimal: digits [. digits] [e [sign] digits], each digit run allowing
      // single underscores between digits.
      let (ds, i2) = rb_flt_digits s0 i1 hi false false false "" in
      let (fs, i3, dotted) = (if i2 < hi && str_eq (char_at s0 i2) "."
                              then (match rb_flt_digits s0 (i2 + 1) hi false false false "" with (a, b) -> (a, b, true))
                              else ("", i2, false)) in
      if str_len ds == 0 && str_len fs == 0 then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
      // a trailing dot is allowed: ruby 4.0 reads "1." as 1.0 and "1.e3" as
      // 1000.0 (a bare "." is still refused, by the test above).
      else if dotted && str_len fs == 0 && str_len ds == 0 then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
      else
        let (es, i4) =
          (if i3 < hi && (str_eq (char_at s0 i3) "e" || str_eq (char_at s0 i3) "E") then
             (let (eneg, ip) = (if i3 + 1 < hi && str_eq (char_at s0 (i3 + 1)) "-" then (true, i3 + 2)
                                else if i3 + 1 < hi && str_eq (char_at s0 (i3 + 1)) "+" then (false, i3 + 2)
                                else (false, i3 + 1)) in
              let (e1, i5) = rb_flt_digits s0 ip hi false false false "" in
              if str_len e1 == 0 then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in ("", i5))
              else ((if eneg then "-" ++ e1 else e1), i5))
           else ("", i3)) in
        if i4 < hi then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in 0.0)
        else
          float_of_str ((if neg then "-" else "")
                        ++ (if str_len ds == 0 then "0" else ds)
                        ++ (if str_len fs > 0 then "." ++ fs else "")
                        ++ (if str_len es > 0 then "e" ++ es else ""))
and rb_flt_digits = fn (s0: str) -> fn (i: int) -> fn (hi: int) -> fn (hex: bool) ->
  fn (prev_us: bool) -> fn (seen_us: bool) -> fn (acc: str) ->
  if i >= hi then
    (if prev_us then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in (acc, i)) else (acc, i))
  else
    let c = char_at s0 i in
    if str_eq c "_" then
      (if str_len acc == 0 || prev_us
       then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in (acc, i))
       else rb_flt_digits s0 (i + 1) hi hex true true acc)
    else
      let dv = rb_digit_val_x c in
      (if dv < 0 || dv >= (if hex then 16 else 10)
       then (if prev_us then (let _ = conv_fail "ArgumentError" ("invalid value for Float(): \"" ++ s0 ++ "\"") in (acc, i)) else (acc, i))
       // ⚠ ruby 3.2's reader stopped its own strtod at the first underscore and
       //   then required every remaining mantissa character to be a DECIMAL
       //   digit ("0xa1_0" was 0xa10 but "0x1_0a" refused), and this was
       //   written against that reference. ruby 4 reads hex digits on both
       //   sides of an underscore: Float("0x1_f") is 31.0. The rules that did
       //   NOT move are the ones about the underscore's POSITION -- doubled,
       //   leading and trailing are still refused.
       else rb_flt_digits s0 (i + 1) hi hex false seen_us (acc ++ c))
and rb_pad_str = fn (s: str) -> fn (flags: str) -> fn (width: int) ->
  // the width is in characters: `"%-5s" % "あ"` pads a one-character string to
  // five, where measuring bytes made it three wide already
  let len = utf8_len s in
  if width <= len then s
  else if str_contains flags "-" then s ++ str_repeat " " (width - len)
  else str_repeat " " (width - len) ++ s
and rb_pad_num = fn (sign: str) -> fn (ds: str) -> fn (flags: str) -> fn (width: int) ->
  let body = sign ++ ds in
  let len = str_len body in
  if width <= len then body
  else if str_contains flags "-" then body ++ str_repeat " " (width - len)
  else if str_contains flags "0" then sign ++ str_repeat "0" (width - len) ++ ds
  else str_repeat " " (width - len) ++ body
// %a: the float in hexadecimal, normalized -- a subnormal too -- the way
// ruby's BSD__hdtoa writes it: "0x1.8p+3". Answers everything after the
// sign, prefix included. With no precision (prec < 0) the fraction is as long
// as it needs to be; with one it is rounded to that many hex digits, half to
// even, and a carry out of the leading 1 moves the exponent ("%.0a" of 12.0
// is 0x1p+4). `alt` (the # flag) keeps the point when no digit follows it.
and fmt_hexfloat = fn (fv: float) -> fn (prec: int) -> fn (alt: bool) ->
  let (sg, ex, fr) = flt_bits64 fv in
  let point = fn (ds: str) -> (if str_len ds > 0 || alt then "." ++ ds else "") in
  let expo = fn (e: int) -> "p" ++ (if e >= 0 then "+" ++ str_of_int e else "-" ++ str_of_int (0 - e)) in
  let top = pow2i 52 in
  if ex == 0 && fr == 0 then "0x0" ++ point (if prec > 0 then str_repeat "0" prec else "") ++ expo 0
  else
    (let rec norm = fn (m: int) -> fn (e: int) -> (if m >= top then (m - top, e) else norm (m * 2) (e - 1)) in
     let (m, e) = (if ex == 0 then norm fr (0 - 1022) else (fr, ex - 1023)) in
     let (lead, frac, e2) =
       (if prec >= 0 && prec < 13 then
          (let drop9 = 52 - 4 * prec in
           let total = top + m in
           let q0 = bit_shr total drop9 in
           let r = total - bit_shl q0 drop9 in
           let half = (if drop9 > 0 then pow2i (drop9 - 1) else 0) in
           let q = (if drop9 > 0 && (r > half || (r == half && floor_mod q0 2 == 1)) then q0 + 1 else q0) in
           if q >= pow2i (4 * prec + 1) then (1, 0, e + 1)
           else (1, bit_shl (q - pow2i (4 * prec)) drop9, e))
        else (1, m, e)) in
     let rec hexd = fn (k: int) -> fn (acc: str) ->
       (if k >= 13 then acc else hexd (k + 1) (acc ++ char_at "0123456789abcdef" (bit_and (bit_shr frac (48 - 4 * k)) 15))) in
     let all = hexd 0 "" in
     let rec trim = fn (n: int) -> (if n > 0 && str_eq (char_at all (n - 1)) "0" then trim (n - 1) else n) in
     let shown = (if prec < 0 then substring all 0 (trim 13)
                  else if prec <= 13 then substring all 0 prec
                  else all ++ str_repeat "0" (prec - 13)) in
     "0x" ++ str_of_int lead ++ point shown ++ expo e2)
and pow2i = fn (k: int) -> if k <= 0 then 1 else 2 * pow2i (k - 1)
and float_domain_msg = fn (f: float) ->
  if f == f then (if f > 0.0 then "Infinity" else "-Infinity") else "NaN"
and float_special = fn (f: float) ->
  if f == f then
    (if f > 1.7976931348623157e308 || f < (0.0 - 1.7976931348623157e308) then "Inf" else "")
  else "NaN"
and rb_pad_special = fn (sign: str) -> fn (word: str) -> fn (flags: str) -> fn (width: int) ->
  let body = sign ++ word in
  let len = str_len body in
  if width <= len then body
  else if str_contains flags "-" then body ++ str_repeat " " (width - len)
  else str_repeat " " (width - len) ++ body
and ascii_up = fn (s: str) -> ascii_up_go s 0 ""
and ascii_up_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else let c = char_at s i in
       ascii_up_go s (i + 1) (acc ++ (if c >= "a" && c <= "z" then chr (ord c - 32) else c))
and pow10i = fn (p: int) -> if p <= 0 then 1 else 10 * pow10i (p - 1)
and pad_frac = fn (s: str) -> fn (prec: int) ->
  if str_len s >= prec then s else str_repeat "0" (prec - str_len s) ++ s
and round_half_even = fn (x: float) ->
  let n = int_of_float x in
  let frac = x - float_of_int n in
  if frac > 0.5 then n + 1
  else if frac < 0.5 then n
  else if n - (n / 2) * 2 == 0 then n else n + 1
and float_big_int_str = fn (f: float) -> float_big_go f 0
and float_big_go = fn (f: float) -> fn (k: int) ->
  if f >= 9007199254740992.0 then float_big_go (f / 2.0) (k + 1)
  else big_mul_s (int_to_base (int_of_float f) 10) (big_pow "2" k "1")
and fmt_float_abs = fn (av: Val) -> fn (prec: int) ->
  let f0 = to_f av in
  let f = (if f0 < 0.0 then 0.0 - f0 else f0) in
  // 10**19 does not fit in an int, so a precision past that is padded rather
  // than computed (ruby prints the exact binary expansion there).
  let prec = (if prec > 18 then 18 else prec) in
  let pad0 = str_repeat "0" (if prec > 18 then prec - 18 else 0) in
  let scalei = pow10i prec in
  if f >= 9007199254740992.0 then
    (if prec <= 0 then float_big_int_str f
     else float_big_int_str f ++ "." ++ str_repeat "0" prec)
  // the whole value scaled at once keeps a tie a tie (see fmt_sci_abs); only
  // when that product leaves the int range is the split needed.
  else if f * float_of_int scalei < 4600000000000000000.0 then
    let si = round_half_even (f * float_of_int scalei) in
    (if prec == 0 then int_to_base si 10
     else
       let ip = si / scalei in
       let fp = si - ip * scalei in
       int_to_base ip 10 ++ "." ++ pad_frac (int_to_base fp 10) prec)
  else
    let ip0 = int_of_float f in
    let fr0 = round_half_even ((f - float_of_int ip0) * float_of_int scalei) in
    let (ip, fp) = (if fr0 >= scalei then (ip0 + 1, fr0 - scalei) else (ip0, fr0)) in
    (if prec == 0 then int_to_base ip 10
     else int_to_base ip 10 ++ "." ++ pad_frac (int_to_base fp 10) prec)
and sci_norm_up = fn (f: float) -> fn (e: int) -> if f >= 10.0 then sci_norm_up (f / 10.0) (e + 1) else (f, e)
and sci_norm_down = fn (f: float) -> fn (e: int) -> if f < 1.0 then sci_norm_down (f * 10.0) (e - 1) else (f, e)
and fmt_sci_abs = fn (av: Val) -> fn (prec: int) -> fn (upper: bool) ->
  let f0 = to_f av in
  let f = (if f0 < 0.0 then 0.0 - f0 else f0) in
  let (m0, e0) = (if f == 0.0 then (0.0, 0) else (let (m1, e1) = sci_norm_up f 0 in sci_norm_down m1 e1)) in
  let scalei = pow10i prec in
  // Scale the ORIGINAL value once, rather than the mantissa the normalisation
  // loop divided down: `12.345 / 10 * 1000` is 1234.5000000000002, which is no
  // longer the tie that ruby rounds to even (it prints 1.234e+01). One
  // multiply by an exact power of ten keeps the tie a tie. Very large or very
  // small exponents fall back, since 10**19 does not fit in an int.
  let k = prec - e0 in
  let scaled =
    (if k >= 0 then (if k <= 18 then f * float_of_int (pow10i k) else m0 * float_of_int scalei)
     else (if 0 - k <= 18 then f / float_of_int (pow10i (0 - k)) else m0 * float_of_int scalei)) in
  let mr0 = round_half_even scaled in
  let (mr, e) = (if mr0 >= 10 * scalei then (mr0 / 10, e0 + 1) else (mr0, e0)) in
  let ip = mr / scalei in
  let fp = mr - ip * scalei in
  let mant = (if prec == 0 then int_to_base ip 10 else int_to_base ip 10 ++ "." ++ pad_frac (int_to_base fp 10) prec) in
  let eabs = (if e < 0 then 0 - e else e) in
  let estr = (if eabs < 10 then "0" ++ int_to_base eabs 10 else int_to_base eabs 10) in
  mant ++ (if upper then "E" else "e") ++ (if e < 0 then "-" else "+") ++ estr
and g_drop_trailing = fn (s: str) -> fn (ch: str) ->
  let rec go = fn (i: int) -> if i > 0 && str_eq (char_at s (i - 1)) ch then go (i - 1) else i in
  substring s 0 (go (str_len s))
and g_rstrip_zeros = fn (s: str) ->
  if str_contains s "." then
    let a = g_drop_trailing s "0" in
    (if str_len a > 0 && str_eq (char_at a (str_len a - 1)) "." then substring a 0 (str_len a - 1) else a)
  else s
and g_e_index = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then (0 - 1)
  else if str_eq (char_at s i) "e" || str_eq (char_at s i) "E" then i else g_e_index s (i + 1)
and g_exp_of = fn (av: Val) -> fn (p: int) ->
  let s = fmt_sci_abs av (if p > 0 then p - 1 else 0) false in
  let ei = g_e_index s 0 in
  if ei < 0 then 0
  else let rest = substring s (ei + 1) (str_len s) in
       int_of_str (if str_len rest > 0 && str_eq (char_at rest 0) "+" then substring rest 1 (str_len rest) else rest)
and fmt_g_abs = fn (av: Val) -> fn (prec: int) -> fn (upper: bool) -> fn (alt: bool) ->
  let p0 = (if prec < 0 then 6 else prec) in
  let p = (if p0 == 0 then 1 else p0) in
  let x = g_exp_of av p in
  if x >= (0 - 4) && x < p then
    (let q = (let q0 = p - 1 - x in if q0 < 0 then 0 else q0) in
     let body = fmt_float_abs av q in
     if alt then (if q == 0 then body ++ "." else body) else g_rstrip_zeros body)
  else
    let se = fmt_sci_abs av (p - 1) upper in
    let ei = g_e_index se 0 in
    // (with # the point stays even when no digit follows it: "1.e+02")
    (if alt then (if p == 1 && ei > 0 then substring se 0 ei ++ "." ++ substring se ei (str_len se) else se)
     else if ei < 0 then g_rstrip_zeros se
     else g_rstrip_zeros (substring se 0 ei) ++ substring se ei (str_len se))
and rb_fmt_intlike = fn (flags: str) -> fn (width: int) -> fn (prec: int) -> fn (pset: bool) ->
  fn (neg: bool) -> fn (ds0: str) -> fn (base: int) -> fn (pfx: str) ->
  let dots = (if neg then (if base == 10 then false
                           else if str_contains flags "+" then false
                           else if str_contains flags " " then false else true)
              else false) in
  if dots then
    let rd = int_to_base (base - 1) base in
    let comp0 = rb_fmt_comp ds0 base in
    let comp1 = (if pset && prec - 2 > str_len comp0 then str_repeat rd (prec - 2 - str_len comp0) ++ comp0 else comp0) in
    let comp2 = (if pset then comp1
                 else if str_contains flags "0" && (if str_contains flags "-" then false else true)
                         && width - 2 - str_len pfx > str_len comp1
                 then str_repeat rd (width - 2 - str_len pfx - str_len comp1) ++ comp1
                 else comp1) in
    rb_pad_special "" (pfx ++ ".." ++ comp2) flags width
  else
    let ds2 = (if pset && prec == 0 && str_eq ds0 "0" then ""
               else if pset && prec > str_len ds0 then str_repeat "0" (prec - str_len ds0) ++ ds0
               else ds0) in
    let sign = (if neg then "-" else if str_contains flags "+" then "+" else if str_contains flags " " then " " else "") in
    let fl2 = (if pset then rb_flags_no0 flags 0 "" else flags) in
    rb_pad_num (sign ++ pfx) ds2 fl2 width
and rb_flags_no0 = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else rb_flags_no0 s (i + 1) (acc ++ (if str_eq (char_at s i) "0" then "" else char_at s i))
and rb_fmt_comp = fn (ds: str) -> fn (base: int) ->
  let k = str_len ds + 1 in
  let rec go = fn (i: int) -> fn (borrow: int) -> fn (acc: str) ->
    if i >= k then acc
    else
      let sv = (if i < str_len ds then rb_digit_val (char_at ds (str_len ds - 1 - i)) else 0) in
      let d0 = 0 - sv - borrow in
      let (d, b2) = (if d0 < 0 then (d0 + base, 1) else (d0, 0)) in
      go (i + 1) b2 (int_to_base d base ++ acc) in
  let raw = go 0 0 "" in
  let rd = int_to_base (base - 1) base in
  let rec strip = fn (s: str) ->
    if str_len s >= 2 && str_eq (substring s 0 1) rd && str_eq (substring s 1 2) rd
    then strip (substring s 1 (str_len s))
    else s in
  strip raw
and rb_digit_val = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48 else if o >= 97 then o - 87 else o - 55
and range_step_arr = fn (i: int) -> fn (last: int) -> fn (n: int) ->
  if n <= 0 then Nil
  else if i > last then Nil else Cons (VInt i, range_step_arr (i + n) last n)
and with_index_pairs = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> Cons (arr_new (Cons (h, Cons (VInt i, Nil))), with_index_pairs t (i + 1))
and downto_arr = fn (a: int) -> fn (b: int) ->
  if a < b then Nil else Cons (VInt a, downto_arr (a - 1) b)
and str_bytes_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else Cons (VInt (ord (char_at s i)), str_bytes_val s (i + 1))
and str_to_bytevec = fn (s: str) ->
  let v = vec_new () in
  let n = str_len s in
  let rec go = fn (i: int) ->
    if i >= n then v else (let _ = vec_push v (ord (char_at s i)) in go (i + 1)) in
  go 0
and bytevec_to_str = fn v ->
  bytevec_range_str v 0 (vec_len v)
and bytevec_range_str = fn v -> fn (lo: int) -> fn (hi: int) ->
  if hi <= lo then ""
  else if hi - lo == 1 then chr (vec_get v lo)
  else let mid = lo + (hi - lo) / 2 in
       bytevec_range_str v lo mid ++ bytevec_range_str v mid hi
and crc32_cont = fn (crc0: int) -> fn v ->
  let n = vec_len v in
  let rec go = fn (i: int) -> fn (crc: int) ->
    if i >= n then crc else go (i + 1) (crc_byte crc (vec_get v i)) in
  go 0 crc0
and adler32_vec = fn v -> fn (seed: int) ->
  let n = vec_len v in
  let rec go = fn (i: int) -> fn (a: int) -> fn (b: int) ->
    if i >= n then bit_or (bit_shl b 16) a
    else let a2 = floor_mod (a + (vec_get v i : int)) 65521 in
         go (i + 1) a2 (floor_mod (b + a2) 65521) in
  go 0 (bit_and seed 0xFFFF) (bit_and (bit_shr seed 16) 0xFFFF)
and zlib_wrap = fn body -> fn (adler: int) ->
  let out = vec_new () in
  let _ = vec_push out 0x78 in
  let _ = vec_push out 0x9C in
  let n = vec_len body in
  let rec cp = fn (i: int) ->
    if i >= n then () else (let _ = vec_push out (vec_get body i) in cp (i + 1)) in
  let _ = cp 0 in
  let _ = vec_push out (bit_and (bit_shr adler 24) 255) in
  let _ = vec_push out (bit_and (bit_shr adler 16) 255) in
  let _ = vec_push out (bit_and (bit_shr adler 8) 255) in
  let _ = vec_push out (bit_and adler 255) in
  out
and bytevec_pad = fn v ->
  let out = vec_new () in
  let n = vec_len v in
  let rec cp = fn (i: int) ->
    if i >= n then () else (let _ = vec_push out (vec_get v i) in cp (i + 1)) in
  let _ = cp 0 in
  let rec z = fn (i: int) ->
    if i >= 8 then () else (let _ = vec_push out 0 in z (i + 1)) in
  let _ = z 0 in
  out
and zlib_body_start = fn v ->
  if vec_len v >= 2
     && bit_and (vec_get v 0) 15 == 8
     && floor_mod (bit_shl (vec_get v 0) 8 + (vec_get v 1 : int)) 31 == 0
  then 2 else 0
and combos_prepend = fn (h: Val) -> fn (combos: Val list) ->
  match combos with
  | Nil -> Nil
  | Cons (c, rest) -> (match c with VArr id -> Cons (arr_new (Cons (h, deref id)), combos_prepend h rest) | _ -> Cons (c, combos_prepend h rest))
and arr_combinations = fn (xs: Val list) -> fn (k: int) ->
  if k == 0 then Cons (arr_new Nil, Nil)
  else if k < 0 then Nil
  else (match xs with
        | Nil -> Nil
        | Cons (h, t) -> list_append (combos_prepend h (arr_combinations t (k - 1))) (arr_combinations t k))
and pair_with = fn (h: Val) -> fn (ys: Val list) ->
  match ys with Nil -> Nil | Cons (y, t) -> Cons (arr_new (Cons (h, Cons (y, Nil))), pair_with h t)
and arr_product_n = fn (xs: Val list) -> fn (az: Val list) ->
  let rec seed = fn (ys: Val list) ->
    (match ys with Nil -> (Nil : Val list) | Cons (h, t) -> Cons (arr_new (Cons (h, Nil)), seed t)) in
  let rec build = fn (acc: Val list) -> fn (rest: Val list) ->
    (match rest with
     | Nil -> acc
     | Cons (a, t) ->
       (let axs = (match a with VArr aid -> deref aid | _ -> (Nil : Val list)) in
        let rec outer = fn (rs: Val list) ->
          (match rs with
           | Nil -> (Nil : Val list)
           | Cons (r, rt) ->
             (let rxs = (match r with VArr rid -> deref rid | _ -> (Nil : Val list)) in
              let rec inner = fn (bs: Val list) ->
                (match bs with
                 | Nil -> outer rt
                 | Cons (b, bt) -> Cons (arr_new (list_append rxs (Cons (b, Nil))), inner bt)) in
              inner axs)) in
        build (outer acc) t)) in
  build (seed xs) az
and arr_rep_combos = fn (xs: Val list) -> fn (k: int) ->
  if k < 0 then (Nil : Val list)
  else if k == 0 then Cons (arr_new (Nil : Val list), Nil)
  else
    (let n = val_list_len xs in
     if n == 0 then (Nil : Val list)
     else
       (let rec go = fn (start: int) -> fn (k2: int) ->
          (if k2 == 0 then Cons (arr_new (Nil : Val list), Nil)
           else
             (let rec loop = fn (i: int) ->
                (if i >= n then (Nil : Val list)
                 else
                   (let tails = go i (k2 - 1) in
                    let rec pre = fn (ts: Val list) ->
                      (match ts with
                       | Nil -> loop (i + 1)
                       | Cons (t, tt) ->
                         Cons (arr_new (Cons (val_nth xs i,
                                              (match t with VArr tid -> deref tid | _ -> (Nil : Val list)))),
                               pre tt)) in
                    pre tails)) in
              loop start)) in
        go 0 k))
and arr_rep_perms = fn (xs: Val list) -> fn (k: int) ->
  if k < 0 then (Nil : Val list)
  else if k == 0 then Cons (arr_new (Nil : Val list), Nil)
  else
    (let n = val_list_len xs in
     if n == 0 then (Nil : Val list)
     else
       (let rec go = fn (k2: int) ->
          (if k2 == 0 then Cons (arr_new (Nil : Val list), Nil)
           else
             (let tails = go (k2 - 1) in
              let rec loop = fn (i: int) ->
                (if i >= n then (Nil : Val list)
                 else
                   (let rec pre = fn (ts: Val list) ->
                      (match ts with
                       | Nil -> loop (i + 1)
                       | Cons (t, tt) ->
                         Cons (arr_new (Cons (val_nth xs i,
                                              (match t with VArr tid -> deref tid | _ -> (Nil : Val list)))),
                               pre tt)) in
                    pre tails)) in
              loop 0)) in
        go k))
and arr_product_guard = fn (n0: int) -> fn (az: Val list) ->
  match az with
  | Nil -> true
  | Cons (a, t) ->
    (let l = (match a with VArr aid -> val_list_len (deref aid) | _ -> 0) in
     if l == 0 then true
     else if n0 > int_max / l then
       (let _ = prim_raise "RangeError" "too big to product" in false)
     else arr_product_guard (n0 * l) t)
and char_range = fn (i: int) -> fn (last: int) ->
  if i > last then Nil else Cons (mkstr (chr i), char_range (i + 1) last)
and val_list_len = fn (xs: Val list) ->
  match xs with Nil -> 0 | Cons (_, t) -> 1 + val_list_len t
// ⚠ ENV writes are an OVERLAY here (there is no setenv extern), and a child
//   process is started by `sh -c`, which knew nothing of it: `ENV["X"] = "1";
//   system("echo $X")` printed an empty line. Every command line a child is
//   started from carries the overlay in front, as exports and unsets.
and env_sh_prefix = fn (u: unit) ->
  let acc = map_new () in
  let _ = map_iter env_ovr (fn (k: str) -> fn (v: Val) ->
            (let cur = (if map_has acc "s" then map_get acc "s" else "") in
             match v with
             | VStr h -> map_set acc "s" (cur ++ "export " ++ shq (k ++ "=" ++ sget h) ++ "; ")
             | VNil -> map_set acc "s" (cur ++ "unset " ++ shq k ++ " 2>/dev/null; ")
             | _ -> ())) in
  if map_has acc "s" then map_get acc "s" else ""
and run_backtick = fn (cmd: str) ->
  let tmp = "/tmp/mrb_cmd_" ++ str_of_int (getpid ()) ++ ".out" in
  // the command's OWN redirections apply inside the capture: in
  // `cmd 2>&1 > tmp` the 2>&1 took the terminal before stdout moved, so
  // a backtick command ending in 2>&1 lost the stderr it asked for
  // ⚠ The shell that `run` starts moves its own stdout to the capture, writes
  //   down its pid and then EXECS the command's shell -- which execs a simple
  //   command in turn. So the command runs as that very process: its pid is
  //   the one $? reports (ruby's `$?.pid` is the child's), and its parent is
  //   this interpreter (`Process.ppid` in a ruby_exe child answered the
  //   subshell a `( ... ) > tmp` wrapper had forked).
  let pidf = "/tmp/mrb_cmd_" ++ str_of_int (getpid ()) ++ ".pid" in
  let rc9 = run (env_sh_prefix () ++ "exec > " ++ shq tmp ++ "; echo $$ > " ++ shq pidf ++ "; exec sh -c " ++ shq cmd) in
  // the status, for the caller to put in $? (this layer has no world)
  let _ = map_set bt_rc "v" rc9 in
  let _ = map_set bt_rc "p" (if file_exists pidf then str_to_int_base (str_trim_nl (read_file pidf)) 10 else 0 - 1) in
  let out = (if file_exists tmp then read_file tmp else "") in
  let _ = run ("rm -f " ++ shq tmp ++ " " ++ shq pidf) in
  mkstr out
// a pid file's one line, without its newline
and str_trim_nl = fn (s: str) ->
  if str_len s > 0 && str_eq (char_at s (str_len s - 1)) "\n" then substring s 0 (str_len s - 1) else s
and rand_val = fn world -> fn (args: Val list) ->
  match args with
  // the SIGN is ignored here too: `rand(-3)` is `rand(3)`. Only ZERO means
  // "no maximum", which is the Float in [0, 1).
  | Cons (VInt n0, _) -> (let n = (if n0 < 0 then 0 - n0 else n0) in
                          if n == 0 then VFlt (mt_rand_real 0)
                          else VInt (mt_rand_int 0 n))
  // ⚠ a FLOAT max is TRUNCATED first, and the answer is an INTEGER whenever
  //   that leaves at least one: `rand(1.5)` is 0 (an Integer) and `rand(2.5)`
  //   is 0, 1 or 2 -- only a max that truncates to zero (`rand(0.5)`) answers a
  //   Float. Scaling the float directly answered a Float for every one of them.
  | Cons (VFlt f0, _) ->
    // ...and the SIGN is ignored: `rand(-1.5)` is `rand(1.5)`. A negative max
    // took the "no argument" path and answered a Float in [0, 1).
    (let f = (if f0 < 0.0 then 0.0 - f0 else f0) in
     if f == 0.0 then VFlt (mt_rand_real 0)
     else (let n9 = int_of_float f in
           if n9 >= 1 then VInt (mt_rand_int 0 n9)
           else VFlt (mt_rand_real 0 * f)))
  // ⚠ a range with a FLOAT on either end picks a FLOAT in it, and only the
  //   Integer/Integer pair picks an Integer: `rand(1..2.0)` answered nil
  //   because the arm below reads two VInts and nothing else.
  | Cons (VRange (av, bv, excl), _) when
      (match (av, bv) with
       | (VFlt _, VFlt _) -> true | (VFlt _, VInt _) -> true | (VInt _, VFlt _) -> true
       | _ -> false) ->
    (let lo9 = to_f av in
     let hi9 = to_f bv in
     let span9 = hi9 - lo9 in
     if span9 < 0.0 then VNil
     else VFlt (lo9 + mt_rand_real 0 * span9))
  // rand(1..6): only an integer range picks an integer
  | Cons (VRange (av, bv, excl), _) ->
    (match av with
     | VInt a ->
       (match bv with
        | VInt b -> (let span = (if excl then b - a else b - a + 1) in
                     if span <= 0 then VNil else VInt (a + mt_rand_int 0 span))
        | _ -> VNil)
     | _ -> VNil)
  | _ -> VFlt (mt_rand_real 0)
and cvar_cls = fn env -> fn world ->
  // class variables belong to the innermost lexically-enclosing class/module
  // (the method's cref), NOT self's class — so a module method used via
  // `extend` still reads the module's cvar. "" means the top-level scope.
  let (meths, sup, ocls, ivars) = world in
  // purely lexical: no enclosing class/module cref => top-level scope ("").
  // ⚠ A SINGLETON SHARES ITS CLASS'S CLASS-VARIABLE SCOPE. `class C; class <<
  //   self; @@meta = 1; end; end` puts @@meta on C -- `C.class_variables`
  //   names it and a method in either body reads it. The cref there is
  //   "C::(sng:C)", and taken whole it made a second, invisible scope: the
  //   metaclass body wrote a variable the class could not see and vice versa.
  //   Dropping the trailing singleton segment is also why `class << D` at the
  //   TOP level is still an error -- its cref is just "(sng:D)", and what is
  //   left is the empty top-level scope, which is what ruby refuses.
  (if lv_has env "__cref"
   then (match lv_get env "__cref" with
         | VStr s -> cvar_scope_of (sget s)
         | _ -> "")
   else "")

// the lexical scope a class variable written at `lex` belongs to: everything
// but a trailing "(sng:...)" segment (see cvar_cls).
and cvar_scope_of = fn (lex: str) ->
  let i9 = sng_seg_at lex 0 (0 - 1) in
  if i9 == (0 - 1) then lex
  else if i9 < 0 then ""      // the whole scope IS the singleton: top level
  else substring lex 0 i9
and is_kernel_modfunc = fn (name: str) ->
  map_has (name_set "is_kernel_modfunc") name
and kernel_public_instance_names = fn (u: unit) ->
  Cons ("eql?", Cons ("respond_to?", Cons ("remove_instance_variable", Cons ("=~",
  Cons ("!~", Cons ("===", Cons ("<=>", Cons ("class", Cons ("singleton_class",
  Cons ("clone", Cons ("dup", Cons ("itself", Cons ("yield_self", Cons ("then",
  Cons ("tap", Cons ("freeze", Cons ("frozen?", Cons ("inspect", Cons ("methods",
  Cons ("singleton_methods", Cons ("protected_methods", Cons ("private_methods",
  Cons ("public_methods", Cons ("instance_variables", Cons ("instance_variable_get",
  Cons ("instance_variable_set", Cons ("instance_variable_defined?", Cons ("instance_of?",
  Cons ("kind_of?", Cons ("is_a?", Cons ("display", Cons ("method", Cons ("public_method",
  Cons ("singleton_method", Cons ("define_singleton_method", Cons ("object_id",
  Cons ("send", Cons ("public_send", Cons ("extend", Cons ("hash", Cons ("to_s",
  Cons ("nil?", Nil))))))))))))))))))))))))))))))))))))))))))
and kernel_builtin_names = fn (u: unit) ->
  // ⚠ `autoload` and `autoload?` are PRIVATE Kernel methods, and this list is
  // what respond_to? and #private_instance_methods read. Both have worked here
  // all along -- `autoload(:K, path); K` loads the file -- and neither was
  // claimed, so `Kernel.private_instance_methods(false).include?(:autoload)`
  // was false about a method the interpreter has.
  Cons ("autoload", Cons ("autoload?",
  Cons ("select", Cons ("spawn", Cons ("syscall", Cons ("trap", Cons ("putc",
  Cons ("respond_to_missing?", Cons ("initialize_clone", Cons ("initialize_dup",
  // ⚠ chomp / chop / sub / gsub are NOT here: ruby defines them only under -n
  //   or -p (they read and write $_), and `Kernel.private_instance_methods`
  //   does not list them otherwise -- which is what core/kernel/chomp_spec and
  //   chop_spec check. This interpreter has no -n, so the names are absent
  //   rather than conditional.
  Cons ("initialize_copy", Cons ("open", Cons ("exec",
  Cons ("puts", Cons ("p", Cons ("pp", Cons ("print", Cons ("putc",
  Cons ("printf", Cons ("format", Cons ("sprintf", Cons ("raise", Cons ("fail",
  Cons ("loop", Cons ("catch", Cons ("throw", Cons ("proc", Cons ("lambda", Cons ("eval",
  // ⚠ `iterator?` is block_given? under its older name, and ruby still lists
  //   it among Kernel's private instance methods. It was absent here, so a
  //   bare `iterator?` was "undefined local variable or method".
  Cons ("iterator?",
  Cons ("require", Cons ("require_relative", Cons ("block_given?", Cons ("Integer",
  Cons ("Float", Cons ("String", Cons ("Array", Cons ("Hash", Cons ("Rational",
  Cons ("Complex", Cons ("warn", Cons ("rand", Cons ("srand", Cons ("sleep", Cons ("gets",
  // the backtick is a Kernel method like any other once the lexer lets
  // `Kernel.`(cmd)` name it (core/kernel/backtick_spec does exactly that)
  Cons ("`",
  Cons ("exit", Cons ("exit!", Cons ("abort", Cons ("at_exit", Cons ("binding",
  Cons ("set_trace_func", Cons ("caller", Cons ("caller_locations", Cons ("__method__", Cons ("__callee__",
  Cons ("__callee__", Cons ("load", Cons ("system", Cons ("readline", Cons ("readlines",
  Cons ("trace_var", Cons ("untrace_var", Cons ("fork", Cons ("global_variables",
  Cons ("local_variables", Cons ("test", Cons ("__dir__", Cons ("instance_variables_to_inspect", Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
and list_iter_kernel_names = fn (f: str -> unit) ->
  let rec go = fn (xs: str list) ->
    (match xs with Nil -> () | Cons (h, t) -> (let _ = f h in go t)) in
  go (kernel_builtin_names ())
and is_kernel_priv_only = fn (name: str) ->
  (str_len name == 19 && str_eq name "respond_to_missing?") || (str_len name == 15 && str_eq name "initialize_copy")
  || (str_len name == 14 && str_eq name "initialize_dup") || (str_len name == 16 && str_eq name "initialize_clone")
and is_kernel_pub_instance = fn (name: str) ->
  let rec go = fn (xs: str list) ->
    (match xs with Nil -> false | Cons (h, t) -> if str_eq h name then true else go t) in
  go (kernel_public_instance_names ())
and is_kernel_builtin = fn (name: str) ->
  let rec go = fn (xs: str list) ->
    (match xs with Nil -> false | Cons (h, t) -> if str_eq h name then true else go t) in
  go (kernel_builtin_names ())
and has_own_meth = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  (if str_eq cls "" then false
   else if map_has undefs (cls ++ "#" ++ name) then false
   else map_has meths (cls ++ "#" ++ name))
and undef_blocked_anc = fn world -> fn (anc: str list) -> fn (name: str) ->
  let (meths, _, _, _) = world in
  match anc with
  | Nil -> false
  | Cons (a, rest) ->
    if map_has undefs (a ++ "#" ++ name) then true
    else if map_has meths (a ++ "#" ++ name) then false
    else undef_blocked_anc world rest name
and mro_cache_on = fn () ->
  if map_has mro_gen 1 then (match map_get mro_gen 1 with 1 -> false | _ -> true)
  else
    (let off = (if str_eq (env_get "MERE_RUBY_NO_MRO_CACHE") "" then 0 else 1) in
     let _ = map_set mro_gen 1 off in
     (match off with 1 -> false | _ -> true))
and any_mod_has = fn world -> fn (mods: str list) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  match mods with
  | Nil -> false
  | Cons (m, r) -> if map_has meths (m ++ "#" ++ name) then true else any_mod_has world r name
and mod_lookup = fn world -> fn (mods: str list) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  match mods with
  | Nil -> (let __fm = ("mere-ruby: undefined method '" ++ name ++ "'") in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (m, r) -> if map_has meths (m ++ "#" ++ name) then map_get meths (m ++ "#" ++ name) else mod_lookup world r name
and dm_store_closure = fn (key: str) -> fn b ->
  let pid = (handle_base + map_len proc_store) in
  let _ = store_proc (str_of_int pid) b in
  map_set dm_closenv key (VProc pid)
and rx_state_save = fn (u: unit) ->
  if map_has globals "~" then
    (let v = map_get globals "~" in
     match v with
     | VNil -> v
     | _ -> (let _ = map_set globals "~" VNil in v))
  else VNil
and rx_state_restore = fn (v: Val) ->
  let cur = (if map_has globals "~" then map_get globals "~" else VNil) in
  match v with
  | VNil -> (match cur with VNil -> () | _ -> (let _ = map_set globals "~" VNil in ()))
  | _ -> (let _ = map_set globals "~" v in ())
and anc_dedupe = fn (xs: str list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if str_list_has t h then anc_dedupe t else Cons (h, anc_dedupe t)
and anc_vclasses = fn (anc: str list) ->
  match anc with Nil -> Nil | Cons (a, rest) -> Cons (VClass a, anc_vclasses rest)
and first_sep_at = fn (k: str) -> fn (i: int) ->
  // index of the FIRST "::" in a constant path, or -1.
  if i + 1 >= str_len k then 0 - 1
  else if str_eq (char_at k i) ":" && str_eq (char_at k (i + 1)) ":" then i
  else first_sep_at k (i + 1)

and const_seg_ok = fn (t: str) -> fn (i: int) -> fn (n: int) ->
  // one `::`-separated segment of a constant path: an uppercase letter and
  // then identifier characters, and it must not be empty.
  if i >= n then i > 0
  else (let ch = char_at t i in
        if (if i == 0 then is_upper ch
            // ⚠ ...and a NON-ASCII byte is an identifier character after the
            //   first. `CS_CONSTλ` is a constant name in ruby and this refused
            //   it as "wrong constant name", because the tail only allowed
            //   ASCII letters, digits and underscore. The leading character
            //   still has to be an uppercase ASCII letter, which is ruby's
            //   rule and what makes `λ` alone not a constant.
            else (let o9 = ord ch in is_upper ch || (o9 >= 97 && o9 <= 122) || is_digit ch || str_eq ch "_" || o9 >= 128))
        then const_seg_ok t (i + 1) n
        else false)

and is_const_path = fn (s9: str) ->
  // `set_temporary_name` refuses a name that IS a constant path, "to avoid
  // confusion" with a real constant -- so "Foo", "FOO", "F", "::Foo" and
  // "A::B" are refused while "foo", "_Foo", "Foo Bar", "Foo-1", "Foo::" and
  // "foo::Bar" are all accepted. The question is about the WHOLE string, not
  // its first character.
  (let t = (if str_len s9 >= 2 && str_eq (substring s9 0 2) "::" then substring s9 2 (str_len s9) else s9) in
   if str_len t == 0 then false
   else (let rec allsegs = fn (xs: str list) ->
           (match xs with
            | Nil -> true
            | Cons (h9, t9) -> if const_seg_ok h9 0 (str_len h9) then allsegs t9 else false) in
         allsegs (str_split t "::")))

and mod_vclasses = fn (anc: str list) -> fn (self9: str) ->
  // `included_modules` is the ancestor chain filtered to the MODULES, with the
  // receiver itself dropped: `class C; include B; end` (B includes A) answers
  // [B, A, Kernel]. Reading it off ancestors_of is only right because a module
  // no longer walks up to Object (see ancestors_of_raw).
  match anc with
  | Nil -> Nil
  | Cons (a, rest) ->
    if (if str_eq a self9 then true else (if map_has modules a then false else true))
    then mod_vclasses rest self9
    else Cons (VClass a, mod_vclasses rest self9)
and anc_after = fn (anc: str list) -> fn (x: str) ->
  match anc with Nil -> Nil | Cons (a, rest) -> if str_eq a x then rest else anc_after rest x
// ⚠ where `super` resumes when the defining module is NOT in the receiver's
// chain at all. `Mod.instance_method(:m).bind(obj)` is exactly that case, and
// it is the one UnboundMethod#bind exists for: ruby behaves as if Mod sat at
// the FRONT of obj's chain, so super finds obj's own class's m. When the
// module IS in the chain the old rule stands -- `WithMod.new` (which includes
// Mod and defines m below it) finds nothing above Mod, and ruby raises there.
and anc_after_or_all = fn (anc: str list) -> fn (x: str) ->
  if anc_has anc x then anc_after anc x else anc
and lex_autoload_key = fn (cref: str) -> fn (nm: str) ->
  if (if str_eq cref "" then false else true) && map_has autoloads (cref ++ "::" ++ nm) then cref ++ "::" ++ nm
  // ⚠ THE TWIN OF lex_const_key, and it had the same hole. A bare `autoload`
  //   in a `class << self` body registers under self, which is the SINGLETON
  //   ("(sng:M)::AL"), while this walk asked "M::(sng:M)::AL" then "M::AL".
  //   Fixing only the constant walk left the autoload one answering NameError
  //   for the same program with one word changed.
  else if (let ow = const_owner_scope cref in
           (if str_eq ow cref then false else true) && map_has autoloads (ow ++ "::" ++ nm))
  then const_owner_scope cref ++ "::" ++ nm
  else if str_contains cref "::" then lex_autoload_key (strip_last_ns cref) nm
  else if map_has autoloads nm then nm
  else ""
and named_class_of = fn (cref: str) -> fn (nm: str) ->
  if str_eq nm "" || str_eq nm "(module)" then nm
  else
    (let key = lex_const_key cref nm in
     let key = (if str_eq key "" && map_has consts nm then nm else key) in
     if str_eq key "" then nm
     else (match map_get consts key with VClass real -> real | _ -> nm))
and resolve_scope_name = fn (cls: str) -> fn (m: str) ->
  if str_contains m "::" then m
  // a singleton class `(sng:X)` shares X's lexical scope (`class << self;
  // include ModA` inside a namespaced class), so resolve against X.
  else if is_sng_cls cls then resolve_scope_name (sng_inner cls) m
  else if (if str_eq cls "" then false else true) && (map_has consts (cls ++ "::" ++ m) || map_has modules (cls ++ "::" ++ m)) then cls ++ "::" ++ m
  else if str_contains cls "::" then resolve_scope_name (strip_last_ns cls) m
  else m
and strip_last_ns = fn (s: str) -> strip_last_ns_go s (str_len s - 1)
and strip_last_ns_go = fn (s: str) -> fn (i: int) ->
  if i <= 0 then ""
  else if str_eq (char_at s i) ":" && str_eq (char_at s (i - 1)) ":" then substring s 0 (i - 1)
  else strip_last_ns_go s (i - 1)
and dispatch_cls_of = fn world -> fn (recv: Val) ->
  let (meths, sup, ocls, ivars) = world in
  match recv with
  | VObj id -> map_get ocls id
  | VClass c -> c
  // a primitive tagged as a subclass instance reports the subclass (so super
  // resumes above it, reaching the builtin base).
  | _ -> let hk = hng_key recv in
         if (if str_eq hk "" then false else true) && map_has hng_store hk && (if is_sng_cls (map_get hng_store hk) then false else true)
         then map_get hng_store hk else class_name recv
and no_singleton_here = fn world -> fn (recv: Val) -> fn (fallback: str) ->
  let _ = (match recv with
           | VRat (_, _) -> raise_exc_iv world "FrozenError"
               ("can't modify frozen " ++ class_name recv ++ ": " ++ inspect recv)
               (Cons (("__recv", recv), Nil))
           | VCpx (_, _) -> raise_exc_iv world "FrozenError"
               ("can't modify frozen " ++ class_name recv ++ ": " ++ inspect recv)
               (Cons (("__recv", recv), Nil))
           | _ -> raise_exc world "TypeError" "can't define singleton") in
  fallback
and do_extend_one = fn world -> fn (m9: str) -> fn (target: Val) ->
  let sc9 = (match target with
             | VClass c9 -> "(sng:" ++ c9 ++ ")"
             | VObj id9 -> singleton_cls_of world id9
             | VStr _ -> prim_sng_cls world target "String"
             | VArr _ -> prim_sng_cls world target "Array"
             | VHsh _ -> prim_sng_cls world target "Hash"
             | _ -> "") in
  let _ = extend_all world sc9 (Cons (VClass m9, Nil)) in
  // dispatch for a primitive goes through its tagged class, so the singleton
  // has to become that tag or the mixed-in methods are invisible.
  let _ = (match target with
           | VStr _ -> map_set hng_store (hng_key target) sc9
           | VArr _ -> map_set hng_store (hng_key target) sc9
           | VHsh _ -> map_set hng_store (hng_key target) sc9
           | _ -> ()) in
  target
and extend_arg_check = fn world -> fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (VClass c9, rest) ->
    (if map_has modules c9 then extend_arg_check world rest
     else (let _ = raise_exc world "TypeError" "wrong argument type Class (expected Module)" in ()))
  | Cons (other, _) ->
    (let _ = raise_exc world "TypeError"
       ("wrong argument type " ++ class_name other ++ " (expected Module)") in ())
and extend_all = fn world -> fn (sc: str) -> fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (VClass m, rest) ->
    let _ = set_inc sc (if map_has includes sc then (map_get includes sc) ++ "|" ++ m else m) in
    let _ = enum_impl_follow world sc m in
    extend_all world sc rest
  | Cons (_, rest) -> extend_all world sc rest
// `Enumerable` mixed into `base` brings Enumerable__Impl with it -- the
// streaming implementations, in FRONT of the includes list so they are
// searched last.
// ⚠ ONE RULE FOR BOTH DOORS. do_include applied it and extend did not, so
//   `obj.extend Enumerable` gave an object that answered #map (which the
//   block dispatcher reaches by calling #each) and NOT #to_h, #to_a or
//   #first, which live in the Impl -- NoMethodError on the methods that
//   module exists to provide. `include` and `extend` are the same mixin
//   aimed at a class and at a singleton.
and enum_impl_follow = fn world -> fn (base: str) -> fn (mq: str) ->
  if str_eq mq "Enumerable"
     && (if str_eq base "Enumerable__Impl" then false else true)
     && (if map_has includes base then (if str_contains (map_get includes base) "Enumerable__Impl" then false else true) else true)
     && (let (mt9, _, _, _) = world in map_has mt9 "Enumerable__Impl#map")
  then set_inc base ("Enumerable__Impl|" ++ (if map_has includes base then map_get includes base else ""))
  else ()
and ivar_self_key = fn (slf: Val) -> fn (name: str) ->
  match slf with
  | VObj id -> str_of_int id ++ "@" ++ name
  | VMain -> "main@" ++ name
  | VClass c -> "cls:" ++ c ++ "@" ++ name
  | VArr id -> "arr:" ++ str_of_int id ++ "@" ++ name
  | VHsh id -> "hsh:" ++ str_of_int id ++ "@" ++ name
  | VStr id -> "str:" ++ str_of_int id ++ "@" ++ name
  | _ -> ""
and lex_const_key = fn (cref: str) -> fn (name: str) ->
  if (if str_eq cref "" then false else true) && map_has consts (cref ++ "::" ++ name) then cref ++ "::" ++ name
  // ⚠ ASK THE KEY THE WRITE USED. A constant defined in `class << self` is
  //   keyed by const_assign_key under the SINGLETON ALONE -- "(sng:M)::X",
  //   because that is where `M.singleton_class.constants` looks (see
  //   const_owner_scope). This walk strips one segment at a time, so from the
  //   scope "M::(sng:M)" it asked "M::(sng:M)::X", then "M::X", then "X", and
  //   never the one spelling anything is stored under. A `class << self` body
  //   could not read its OWN constant:
  //     module M; class << self; X = 1; def f; X; end; end; end
  //   uri/common.rb is exactly that shape (`module Schemes; class << self;
  //   ReservedChars = ".+-"`), so `require "uri"` died on line 99.
  else if (let ow = const_owner_scope cref in
           (if str_eq ow cref then false else true) && map_has consts (ow ++ "::" ++ name))
  then const_owner_scope cref ++ "::" ++ name
  else if str_contains cref "::" then lex_const_key (strip_last_ns cref) name
  else ""
and anc_drop_object = fn (ancs: str list) ->
  match ancs with
  | Nil -> Nil
  | Cons (a, t) -> if str_eq a "Object" then anc_drop_object t else Cons (a, anc_drop_object t)
and anc_const_go = fn (ancs: str list) -> fn (name: str) ->
  match ancs with
  | Nil -> ""
  | Cons (a, t) -> if map_has consts (a ++ "::" ++ name) then a ++ "::" ++ name else anc_const_go t name
and super_base = fn world -> fn (recv: Val) ->
  match recv with VClass c -> if is_sng_cls c then c else "(sng:" ++ c ++ ")" | _ -> dispatch_cls_of world recv
and is_definition_hook = fn (name: str) ->
  (str_len name == 9 && str_eq name "inherited") || (str_len name == 8 && str_eq name "included") || (str_len name == 8 && str_eq name "extended") ||
  (str_len name == 9 && str_eq name "prepended") || (str_len name == 12 && str_eq name "method_added") ||
  (str_len name == 22 && str_eq name "singleton_method_added") || (str_len name == 14 && str_eq name "method_removed") ||
  (str_len name == 16 && str_eq name "method_undefined") || (str_len name == 24 && str_eq name "singleton_method_removed") ||
  (str_len name == 26 && str_eq name "singleton_method_undefined")
and note_raise_bt = fn world -> fn (exc: Val) ->
  let (m9, s9, o9, ivars9) = world in
  let bt9 = arr_new (caller_frames 0) in
  let _ = map_set raise_bt "v" bt9 in
  let _ = map_set raise_bt "e" exc in
  let _ = map_set raise_bt "eb" bt9 in
  // ⚠ a new raise retires the Locations built for the last one. They are
  //   cached beside the exception they were built for, and the cheap pair
  //   representation is compared by VALUE -- so two bare `raise`s (each a
  //   RuntimeError "unhandled exception") are the same key, and the second
  //   answered the first one's frames.
  let _ = (if map_has raise_bt "lf" then map_delete raise_bt "lf" else ()) in
  (match exc with
   | VObj oid9 ->
     // (a backtrace set to nil is none: `e.set_backtrace(nil); raise e`
     // gets the frames of the new raise)
     (if map_has ivars9 (str_of_int oid9 ++ "@__bt")
         && (match map_get ivars9 (str_of_int oid9 ++ "@__bt") with VNil -> false | _ -> true) then ()
      else map_set ivars9 (str_of_int oid9 ++ "@__bt") bt9)
   | _ -> ())
and lookup_anc = fn world -> fn (anc: str list) -> fn (name: str) ->
  let (meths, _, _, _) = world in
  match anc with
  | Nil -> ""
  | Cons (a, rest) -> if map_has meths (a ++ "#" ++ name) then a else lookup_anc world rest name
and owner_anc = fn world -> fn (anc: str list) -> fn (name: str) ->
  let (meths, _, _, _) = world in
  match anc with
  | Nil -> ""
  | Cons (a, rest) ->
    if map_has meths (a ++ "#" ++ name) || map_has vis_marks (a ++ "#" ++ name) then a
    else owner_anc world rest name
and anc_has = fn (anc: str list) -> fn (want: str) ->
  match anc with Nil -> false | Cons (a, rest) -> if str_eq a want then true else anc_has rest want
and lookup_anc_above = fn world -> fn (anc: str list) -> fn (from: str) -> fn (name: str) ->
  match anc with
  | Nil -> ""
  | Cons (a, rest) -> if str_eq a from then lookup_anc world rest name
                      else lookup_anc_above world rest from name
and make_unbound_method = fn world -> fn (cls: str) -> fn (nm: str) ->
  let (_, _, ocls0, ivars0) = world in
  let id = alloc_oid ocls0 in
  let _ = map_set ocls0 id "UnboundMethod" in
  let _ = map_set ivars0 (str_of_int id ++ "@__um_cls") (mkstr cls) in
  let _ = map_set ivars0 (str_of_int id ++ "@__um_name") (mkstr nm) in
  VObj id
and struct_slot = fn (m: str) -> m ++ chr 1
and struct_is_slot = fn (nm: str) -> str_contains nm (chr 1)
and struct_add_attrs = fn world -> fn (cls: str) -> fn (syms: str list) ->
  let (meths, sup, ocls, ivars) = world in
  match syms with
  | Nil -> ()
  | Cons (name, rest) ->
    let _ = set_meth meths (cls ++ "#" ++ name)
              (Meth (Nil, Nil, Cons (SReturn (EIVar (struct_slot name)), Nil))) in
    let _ = set_meth meths (cls ++ "#" ++ name ++ "=")
              (Meth (Cons ("__attr_v", Nil), Nil,
                     Cons (SIVarAssign (struct_slot name, EVar "__attr_v"),
                           Cons (SReturn (EVar "__attr_v"), Nil)))) in
    struct_add_attrs world cls rest
and struct_ivar_reads = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (EIVar (struct_slot m), struct_ivar_reads r)
and struct_sym_lits = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (ESym m, struct_sym_lits r)
and struct_sym_vals = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (VSym m, struct_sym_vals r)
and struct_kw_nil = fn (args: Val list) ->
  match args with
  | Nil -> false
  | Cons (VHsh h, _) -> (match hash_lookup (hderef h) (VSym "keyword_init") with (true, VNil) -> true | _ -> false)
  | Cons (_, r) -> struct_kw_nil r
and struct_kw_mentioned = fn (args: Val list) ->
  match args with
  | Nil -> false
  | Cons (VHsh h, _) -> (match hash_lookup (hderef h) (VSym "keyword_init") with (true, _) -> true | _ -> false)
  | Cons (_, r) -> struct_kw_mentioned r
and struct_kw_init = fn (args: Val list) ->
  match args with
  | Nil -> false
  | Cons (VHsh h, _) ->
    (match hash_lookup (hderef h) (VSym "keyword_init") with
     | (true, v9) -> truthy v9
     | _ -> false)
  | Cons (_, r) -> struct_kw_init r
and struct_pos_defaults = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons ((m, ENil), struct_pos_defaults r)
and struct_each_body = fn (ms: str list) ->
  Cons (SIf (Cons ((EUn ("!", EVar "block_given?"),
                    // `enum_for(:each) { self.class.members.size }`: Struct#each
                    // knows its size (asked of the class, since a member may
                    // itself be called `size`)
                    Cons (SReturn (ECallB ("enum_for", Cons (ESym "each", Nil), Nil,
                                           Cons (SExpr (EMethod (EMethod (EMethod (ESelf, "class", Nil), "members", Nil), "size", Nil)), Nil))), Nil)), Nil),
             Nil),
        struct_each_yields ms)
and struct_each_yields = fn (ms: str list) ->
  match ms with
  | Nil -> Cons (SReturn ESelf, Nil)
  | Cons (m, r) -> Cons (SExpr (EYield (Cons (EIVar (struct_slot m), Nil))), struct_each_yields r)
and struct_init_body = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (SIVarAssign (struct_slot m, EVar m), struct_init_body r)
and struct_common_src = fn (u: unit) ->
    "  def __member_index(k)\n" ++
    "    ms = members\n" ++
    // a key that is not a NAME is an INDEX, through #to_int: `s[1.5]` and
    // `s.dig(1.5)` are ms[1]. Only an Integer was read as one, so every other
    // number was refused by this guard -- with the message for something that
    // cannot convert at all. nil is ruby's differently-worded refusal.
    "    unless k.is_a?(Integer) || k.is_a?(Symbol) || k.is_a?(String) || k.respond_to?(:to_int)\n" ++
    "      raise TypeError, k.nil? ? \"no implicit conversion from nil to integer\" : \"no implicit conversion of \" + k.class.to_s + \" into Integer\"\n" ++
    "    end\n" ++
    "    k = k.to_int unless k.is_a?(Integer) || k.is_a?(Symbol) || k.is_a?(String)\n" ++
    "    i = k.is_a?(Integer) ? (k < 0 ? ms.size + k : k) : ms.index(k.to_sym)\n" ++
    "    if i.nil?\n" ++
    "      raise NameError, \"no member '\" + k.to_s + \"' in struct\"\n" ++
    "    end\n" ++
    "    if i < 0\n" ++
    "      raise IndexError, \"offset \" + k.to_s + \" too small for struct(size:\" + ms.size.to_s + \")\"\n" ++
    "    end\n" ++
    "    if i >= ms.size\n" ++
    "      raise IndexError, \"offset \" + k.to_s + \" too large for struct(size:\" + ms.size.to_s + \")\"\n" ++
    "    end\n" ++
    "    i\n" ++
    "  end\n" ++
    "  private :__member_index\n" ++
    "\n" ++
    "  def [](k)\n" ++
    "    instance_variable_get(\"@\" + members[__member_index(k)].to_s + 1.chr)\n" ++
    "  end\n" ++
    "\n" ++
    "  def []=(k, v)\n" ++
    "    instance_variable_set(\"@\" + members[__member_index(k)].to_s + 1.chr, v)\n" ++
    "    v\n" ++
    "  end\n" ++
    "\n" ++
    "  def dig(*ks)\n" ++
    // `s.dig` with nothing to dig for is an ArgumentError, not a refusal of the
    // nil that `ks[0]` returns -- Hash#dig and Array#dig both say so and this
    // one answered "no implicit conversion from nil to integer".
    "    if ks.empty?\n" ++
    "      raise ArgumentError, \"wrong number of arguments (given 0, expected 1+)\"\n" ++
    "    end\n" ++
    "    k = ks[0]\n" ++
    "    ms = members\n" ++
    // a key that is not a NAME is an INDEX, through #to_int: `s[1.5]` and
    // `s.dig(1.5)` are ms[1]. Only an Integer was read as one, so every other
    // number was refused by this guard -- with the message for something that
    // cannot convert at all. nil is ruby's differently-worded refusal.
    "    unless k.is_a?(Integer) || k.is_a?(Symbol) || k.is_a?(String) || k.respond_to?(:to_int)\n" ++
    "      raise TypeError, k.nil? ? \"no implicit conversion from nil to integer\" : \"no implicit conversion of \" + k.class.to_s + \" into Integer\"\n" ++
    "    end\n" ++
    "    k = k.to_int unless k.is_a?(Integer) || k.is_a?(Symbol) || k.is_a?(String)\n" ++
    "    i = k.is_a?(Integer) ? (k < 0 ? ms.size + k : k) : ms.index(k.to_sym)\n" ++
    "    return nil if i.nil? || i < 0 || i >= ms.size\n" ++
    "    v = instance_variable_get(\"@\" + ms[i].to_s + 1.chr)\n" ++
    "    return v if ks.size <= 1\n" ++
    "    return nil if v.nil?\n" ++
    // ...and an intermediate that cannot be dug into is named in a TypeError,
    // which is what Hash#dig and Array#dig answer. Calling #dig blind reported
    // the NoMethodError of the value instead, so the same walk had two answers
    // depending on which container it started from.
    "    unless v.respond_to?(:dig)\n" ++
    "      raise TypeError, v.class.to_s + \" does not have #dig method\"\n" ++
    "    end\n" ++
    "    v.dig(*ks.drop(1))\n" ++
    "  end\n" ++
    "\n" ++
    "  def values_at(*ix)\n" ++
    "    ms = members\n" ++
    // a RANGE argument names several members at once, nil-filling past the end
    // -- Array#values_at already answers exactly that, so this asks it instead
    // of writing the rule a second time. Comparing the range with 0 as if it
    // were an index is what raised "comparison of Range with 0 failed".
    "    ix.flat_map do |k|\n" ++
    "      next to_a.values_at(k) if k.is_a?(Range)\n" ++
    // Every other subscript is an INDEX and is read as one through #to_int --
    // a member NAME is not accepted here, as it is by #[] and #dig. Comparing
    // the raw subscript with 0 made `s.values_at(:a)` an ArgumentError about a
    // failed comparison where ruby refuses the conversion.
    "      unless k.is_a?(Integer)\n" ++
    "        unless k.respond_to?(:to_int)\n" ++
    "          raise TypeError, k.nil? ? \"no implicit conversion from nil to integer\" : \"no implicit conversion of \" + k.class.to_s + \" into Integer\"\n" ++
    "        end\n" ++
    "        k = k.to_int\n" ++
    "      end\n" ++
    "      i = k < 0 ? ms.size + k : k\n" ++
    "      if i < 0\n" ++
    "        raise IndexError, \"offset \" + k.to_s + \" too small for struct(size:\" + ms.size.to_s + \")\"\n" ++
    "      end\n" ++
    "      if i >= ms.size\n" ++
    "        raise IndexError, \"offset \" + k.to_s + \" too large for struct(size:\" + ms.size.to_s + \")\"\n" ++
    "      end\n" ++
    "      [instance_variable_get(\"@\" + ms[i].to_s + 1.chr)]\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def to_h(&b)\n" ++
    "    h = \{}\n" ++
    "    members.each do |m|\n" ++
    "      h[m] = instance_variable_get(\"@\" + m.to_s + 1.chr)\n" ++
    "    end\n" ++
    "    return h unless b\n" ++
    "    h.to_h(&b)\n" ++
    "  end\n" ++
    "\n" ++
    "  def each_pair(&b)\n" ++
    "    return to_h.each_pair unless b\n" ++
    "    to_h.each_pair(&b)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    // ⚠ A struct can hold ITSELF (`car[:make] = car`), and comparing or
    // hashing one walked it until the stack gave out. ruby's guards, written
    // with a table of the walks in flight: == and eql? answer true for a
    // PAIR already being compared (rb_exec_recursive_paired), and #hash is
    // decided by the OUTERMOST call, which answers the class's hash alone
    // once any inner one finds itself (rb_exec_recursive_outer) -- so two
    // structs that are eql? through their cycles hash the same.
    // The class is part of the hash, too: `Struct.new(:x).new(1)` and
    // `Struct.new(:y).new(1)` hashed alike, as their to_a does.
    // a keyword_init struct's #initialize (the generated one forwards here):
    // keywords, or one positional Hash of them, and Symbol keys that name
    // members -- every other key is listed in the refusal.
    "  def __struct_kw_init(args, kw)\n" ++
    "    unless args.empty?\n" ++
    "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0)\" if args.size > 1 || !kw.empty? || !(Hash === args[0])\n" ++
    "      kw = args[0]\n" ++
    "    end\n" ++
    "    ms = self.class.members\n" ++
    "    bad = kw.keys.reject \{ |k| Symbol === k && ms.include?(k) }\n" ++
    "    raise ArgumentError, \"unknown keywords: \" + bad.map(&:to_s).join(\", \") unless bad.empty?\n" ++
    "    kw.each \{ |k, v| instance_variable_set(\"@\" + k.to_s + 1.chr, v) }\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def __recur\n" ++
    "    ::Struct.instance_variable_get(:@__recur) || ::Struct.instance_variable_set(:@__recur, \{})\n" ++
    "  end\n" ++
    "  private :__recur\n" ++
    "\n" ++
    "  def hash\n" ++
    "    seen = __recur\n" ++
    "    throw seen[:__hash_outer] if seen.key?([:hash, __id__])\n" ++
    "    outer = !seen.key?(:__hash_outer)\n" ++
    "    seen[:__hash_outer] = Object.new if outer\n" ++
    "    seen[[:hash, __id__]] = true\n" ++
    "    begin\n" ++
    "      return [self.class, *to_a].hash unless outer\n" ++
    "      done = false\n" ++
    "      h = catch(seen[:__hash_outer]) do\n" ++
    "        v = [self.class, *to_a].hash\n" ++
    "        done = true\n" ++
    "        v\n" ++
    "      end\n" ++
    "      done ? h : [self.class].hash\n" ++
    "    ensure\n" ++
    "      seen.delete([:hash, __id__])\n" ++
    "      seen.delete(:__hash_outer) if outer\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def ==(o)\n" ++
    "    return true if equal?(o)\n" ++
    "    return false unless o.class == self.class\n" ++
    "    seen = __recur\n" ++
    "    k = [:==, __id__, o.__id__]\n" ++
    "    return true if seen.key?(k)\n" ++
    "    seen[k] = true\n" ++
    "    begin\n" ++
    "      to_a == o.to_a\n" ++
    "    ensure\n" ++
    "      seen.delete(k)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def eql?(o)\n" ++
    "    return true if equal?(o)\n" ++
    "    return false unless o.class == self.class\n" ++
    "    seen = __recur\n" ++
    "    k = [:eql?, __id__, o.__id__]\n" ++
    "    return true if seen.key?(k)\n" ++
    "    seen[k] = true\n" ++
    "    begin\n" ++
    "      to_a.eql?(o.to_a)\n" ++
    "    ensure\n" ++
    "      seen.delete(k)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def deconstruct_keys(ks)\n" ++
    "    return to_h if ks.nil?\n" ++
    // nil or an Array and nothing else: an Integer answered {} instead of
    // ruby's TypeError, so a `case` pattern with a bad key list matched
    // nothing rather than reporting the bad list.
    "    raise TypeError, \"wrong argument type \" + ks.class.to_s + \" (expected Array or nil)\" unless ks.is_a?(Array)\n" ++
    "    ms = members\n" ++
    "    return \{} if ks.size > ms.size\n" ++
    "    out = \{}\n" ++
    "    ks.each do |k0|\n" ++
    "      k = k0\n" ++
    "      # a key that is neither a name nor an Integer converts by #to_int\n" ++
    "      unless k.is_a?(Integer) || k.is_a?(Symbol) || k.is_a?(String)\n" ++
    "        raise TypeError, \"no implicit conversion of #\{k.class} into Integer\" unless k.respond_to?(:to_int)\n" ++
    "        k = k.to_int\n" ++
    "        raise TypeError, \"can't convert #\{k0.class} to Integer (#\{k0.class}#to_int gives #\{k.class})\" unless k.is_a?(Integer)\n" ++
    "      end\n" ++
    "      if k.is_a?(Integer)\n" ++
    // a NEGATIVE position counts from the end, as it does everywhere else an
    // index is taken -- and the key in the answer is the one that was ASKED
    // (`deconstruct_keys([-1])` is `{-1 => <last>}`, not `{2 => <last>}`).
    // Breaking on `k < 0` treated the whole form as out of range.
    "        break if k >= ms.size || k < 0 - ms.size\n" ++
    "      else\n" ++
    "        break unless ms.include?(k.to_sym)\n" ++
    "      end\n" ++
    "      out[k0] = self[k]\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n"
and struct_members_of_args = fn (args: Val list) ->
  match args with
  | Cons (VStr _, r) -> struct_members_of_args_go r
  // `Struct.new(nil, :foo)` is the explicit "no name" form and its members are
  // [:foo]; nil ANYWHERE ELSE is refused like any other non-name. Only the
  // first position is this door -- reading nil as "skip" everywhere would let
  // `Struct.new(:a, nil)` through, which ruby names in a TypeError.
  | Cons (VNil, r) -> struct_members_of_args_go r
  | _ -> struct_members_of_args_go args
and struct_members_of_args_go = fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (VSym s, r) -> Cons (s, struct_members_of_args_go r)
  | Cons (VStr h, r) -> Cons (sget h, struct_members_of_args_go r)
  // A trailing hash is the `keyword_init:` KEYWORD argument, and it is one only
  // if it says so: `Struct.new(:animal, {name: "chris"})` is a positional Hash
  // and ruby refuses it by name. Accepting every trailing hash meant this
  // interpreter could not tell a keyword from an argument that looks like one.
  | Cons (VHsh h9, Nil) ->
    (if (match hash_lookup (hderef h9) (VSym "keyword_init") with (true, _) -> true | _ -> false)
     then Nil
     else (let _ = prim_raise "TypeError" (inspect (VHsh h9) ++ " is not a symbol nor a string") in Nil))
  | Cons (bad, _) -> (let _ = prim_raise "TypeError" (inspect bad ++ " is not a symbol nor a string") in Nil)
and struct_members_cls = fn world -> fn (anc: str list) ->
  match anc with
  | Nil -> ""
  | Cons (a9, rest9) -> if map_has struct_mem a9 then a9 else struct_members_cls world rest9
and struct_anc_members = fn world -> fn (anc: str list) ->
  match anc with
  | Nil -> false
  | Cons (a9, rest9) -> map_has struct_mem a9 || struct_anc_members world rest9
and struct_dup_check = fn (ms: str list) ->
  match ms with
  | Nil -> ()
  | Cons (m, r) ->
    (if str_list_has r m
     then (let _ = prim_raise "ArgumentError" ("duplicate member: " ++ m) in ())
     else struct_dup_check r)
and stack_dump = fn (cd: int) -> fn (n: int) -> fn (acc: str) ->
  if n <= 0 || cd <= fb_depth_base () then acc
  else
    (let k = cd - 1 in
     let nm = (if map_has call_names_s k then map_get call_names_s k else "?") in
     stack_dump (cd - 1) (n - 1) (acc ++ "  " ++ str_of_int (cd - 1) ++ " " ++ nm ++ "\n"))
and load_path_find = fn world -> fn (p1: str) ->
  // through gvar_slot: `$LOAD_PATH` is an ALIAS of `$:` now, so the long
  // spelling has no slot of its own to read.
  (match (if map_has globals (gvar_slot "LOAD_PATH") then map_get globals (gvar_slot "LOAD_PATH") else VNil) with
   | VArr aid -> load_path_go (deref aid) p1
   | _ -> "")
and load_path_go = fn (dirs: Val list) -> fn (p1: str) ->
  match dirs with
  | Nil -> ""
  | Cons (VStr dh, rest) ->
    (let cand = sget dh ++ "/" ++ p1 in
     if is_reg_file cand then cand else load_path_go rest p1)
  | Cons (_, rest) -> load_path_go rest p1
and basename_of = fn (path: str) ->
  let q = strip_trail_slash path (str_len path - 1) in
  if str_eq q "/" then "/" else basename_go q (str_len q - 1)
and basename_suffix = fn (b: str) -> fn (suf: str) ->
  if str_eq suf ".*" then
    (let e = extname_of b in if str_eq e "" then b else substring b 0 (str_len b - str_len e))
  else if str_len suf > 0 && str_len b > str_len suf &&
          str_eq (substring b (str_len b - str_len suf) (str_len b)) suf
  then substring b 0 (str_len b - str_len suf)
  else b
and basename_go = fn (path: str) -> fn (i: int) ->
  if i < 0 then path
  else if str_eq (char_at path i) "/" then substring path (i + 1) (str_len path)
  else basename_go path (i - 1)
and file_join_go = fn (args: Val list) -> fn (acc: str) ->
  match args with
  | Nil -> acc
  | Cons (v, rest) ->
    let piece = (match v with VStr h -> sget h | _ -> to_s v) in
    file_join_go rest (if str_eq acc "" then piece else acc ++ "/" ++ piece)
and env_load = fn (u: unit) ->
  if map_has env_cache "\0loaded" then ()
  else
    let _ = map_set env_cache "\0loaded" (mkstr "1") in
    env_cache_fill (env_all_pairs ())
and env_cache_fill = fn (ps: (str * str) list) ->
  match ps with
  | Nil -> ()
  | Cons ((k, v), t) -> let _ = map_set env_cache k (mkstr v) in env_cache_fill t
and dir_chdir_to = fn (p: str) ->
  let abs = (if str_len p > 0 && str_eq (char_at p 0) "/" then p else env_get "PWD" ++ "/" ++ p) in
  let rc = chdir p in
  let _ = (if rc == 0 then (let _ = map_set env_cache "PWD" (mkstr (path_norm abs)) in ()) else ()) in
  rc
and env_is_set = fn (k2: str) ->
  let _ = env_load () in map_has env_cache k2
and env_get = fn (k2: str) ->
  let _ = env_load () in
  if map_has env_cache k2 then (match map_get env_cache k2 with VStr h -> sget h | _ -> "") else ""
and split_colon = fn (s: str) -> fn (i: int) -> fn (cur: str) -> fn (acc: str list) ->
  if i >= str_len s then rev_strs_l (Cons (cur, acc)) Nil
  else if str_eq (char_at s i) ":" then split_colon s (i + 1) "" (Cons (cur, acc))
  else split_colon s (i + 1) (cur ++ char_at s i) acc
and rev_strs_l = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_strs_l t (Cons (h, acc))
and add_inc = fn (d: str) ->
  let cur = (if map_has cli_inc "v" then (match map_get cli_inc "v" with VStr h -> sget h | _ -> "") else "") in
  map_set cli_inc "v" (mkstr (if str_eq cur "" then d else cur ++ ":" ++ d))
and drop_empty = fn (xs: str list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if str_eq h "" then drop_empty t else Cons (h, drop_empty t)
// The environment as RUBY sees it: ENV writes overlay the real one (env_ovr),
// and a program that sets ENV["HOME"] has changed what Dir.home and `~` mean.
//
// ⚠ env_get reads the PROCESS environment and knows nothing about that
//   overlay, so `ENV["HOME"] = "/rubyspec_home"; Dir.home` answered the real
//   home -- the same question asked in two spellings, with only one of them
//   reachable from the program. Use this wherever ruby itself reads an
//   environment variable AT CALL TIME. Not for PWD: Dir.pwd is getcwd(3) and
//   ruby ignores ENV["PWD"] for it.
and rb_env_get = fn (k2: str) ->
  if map_has env_ovr k2
  then (match map_get env_ovr k2 with VStr h -> sget h | _ -> "")
  else env_get k2
and env_lookup_v = fn (k2: str) ->
  let v = (if map_has env_ovr k2 then map_get env_ovr k2
           else if env_is_set k2 then mkstr (env_get k2)
           else VNil) in
  // reads carry Encoding.default_internal when set, else the locale (UTF-8).
  (match v with
   | VStr h -> (let _ = senc_set h (env_read_enc ()) in v)
   | _ -> v)
and env_read_enc = fn (u: unit) ->
  (if map_has def_int_enc "v" then
     (match map_get def_int_enc "v" with
      | VObj eid -> (if map_has enc_name (str_of_int eid) then map_get enc_name (str_of_int eid) else "UTF-8")
      | _ -> "UTF-8")
   else "UTF-8")
and env_clone_kw_err = fn (args: Val list) ->
  match args with
  | Cons (VHsh h9, _) -> env_clone_kw_go (hderef h9)
  | _ -> ""
and env_clone_kw_go = fn (xs: Val list) ->
  match xs with
  | Cons (k9, Cons (v9, t9)) ->
    (if (match k9 with VSym s9 -> str_eq s9 "freeze" | _ -> false) then
       (match v9 with
        | VNil -> env_clone_kw_go t9
        | VBool _ -> env_clone_kw_go t9
        | _ -> "unexpected value for freeze: " ++ class_name v9)
     else "unknown keyword: " ++ (match k9 with VSym s9 -> ":" ++ s9 | _ -> to_s k9))
  | _ -> ""
and env_has_value = fn (xs: Val list) -> fn (target: str) ->
  match xs with
  | Cons (_, Cons (v9, t9)) ->
    (match v9 with
     | VStr h9 -> if str_eq (sget h9) target then true else env_has_value t9 target
     | _ -> env_has_value t9 target)
  | _ -> false
and env_all_pairs = fn () ->
  try_or (fn (u: unit) -> env_all_pairs_host ()) (Nil : (str * str) list)
and env_all_pairs_host = fn () ->
  let tmpf = "/tmp/.mrb_env_" ++ str_of_int (random_int 100000000) in
  // ⚠ `env` alone frames its records with a NEWLINE, and a newline is a legal
  // byte inside an environment VALUE -- so the two cannot be told apart. A
  // value of "a\nB=evil" came back as "a" AND as a variable B nobody set: the
  // dump both truncated a value and invented a name. `env -0` frames with a
  // NUL, the one byte a value cannot contain, so the split is exact. Mere
  // strings carry their length, so a NUL travels through read_file and
  // char_at unharmed (that is what makes the framed form readable at all).
  // Where `env` has no -0 (it is not in POSIX) the file comes back with no NUL
  // in it and the old line split runs, ambiguity and all -- the dump is never
  // empty, so "no NUL anywhere" is a reliable signal and not a guess.
  let _ = run ("env -0 > " ++ shq tmpf ++ " 2> /dev/null") in
  let content0 = (if file_exists tmpf then read_file tmpf else "") in
  let framed = str_has_nul content0 0 in
  let content =
    (if framed then content0
     else (let _ = run ("env > " ++ shq tmpf ++ " 2> /dev/null") in
           (if file_exists tmpf then read_file tmpf else ""))) in
  let _ = run ("rm -f " ++ shq tmpf) in
  // `_` is the dump's own doing -- the shell sets it to the command it is
  // about to run, so it names /usr/bin/env and nothing else. It is the one
  // key we can be sure this program does not have (see KNOWN_GAPS for the
  // two we cannot: the shell's PWD and SHLVL).
  env_drop_underscore (if framed then env_pairs_nul content 0 else env_pairs_go content 0)
and str_has_nul = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then false
  else if str_eq (char_at s i) "\0" then true
  else str_has_nul s (i + 1)
and env_pairs_nul = fn (content: str) -> fn (i: int) ->
  if i >= str_len content then (Nil : (str * str) list)
  else
    let e = nul_end_from content i in
    let eq = env_eq_at content i e in
    if eq < 0 then env_pairs_nul content (e + 1)
    else Cons ((substring content i eq, substring content (eq + 1) e), env_pairs_nul content (e + 1))
and nul_end_from = fn (content: str) -> fn (i: int) ->
  if i >= str_len content then str_len content
  else if str_eq (char_at content i) "\0" then i
  else nul_end_from content (i + 1)
and env_drop_underscore = fn (ps: (str * str) list) ->
  match ps with
  | Nil -> Nil
  | Cons ((k, v), t) ->
    if str_eq k "_" && str_len v >= 4 && str_eq (substring v (str_len v - 4) (str_len v)) "/env"
    then env_drop_underscore t
    else Cons ((k, v), env_drop_underscore t)
and env_pairs_go = fn (content: str) -> fn (i: int) ->
  if i >= str_len content then (Nil : (str * str) list)
  else
    let e = line_end_from content i in
    let stop = (if e > i && str_eq (char_at content (e - 1)) "\n" then e - 1 else e) in
    let eq = env_eq_at content i stop in
    if eq < 0 then env_pairs_go content e
    else Cons ((substring content i eq, substring content (eq + 1) stop), env_pairs_go content e)
and env_eq_at = fn (content: str) -> fn (j: int) -> fn (stop: int) ->
  if j >= stop then (0 - 1)
  else if str_eq (char_at content j) "=" then j
  else env_eq_at content (j + 1) stop
and env_hash_list = fn (u: unit) ->
  let ps = env_all_pairs () in
  vappend (env_pairs_hl ps) (env_ovr_only ps)
and env_pairs_hl = fn (ps: (str * str) list) ->
  match ps with
  | Nil -> (Nil : Val list)
  | Cons ((k, v), t) ->
    if map_has env_ovr k then
      (match map_get env_ovr k with
       | VNil -> env_pairs_hl t
       // ⚠ a value stored through ENV[]= is the user's own String, and it
       // leaves with the encoding ENV reads in -- not the one it was written
       // with. Passing it through unchanged left it UTF-8 under a
       // default_internal of IBM437, for the keys' sake but not the values'.
       | ov -> Cons (mkstr_e k (env_read_enc ()),
                     Cons ((match ov with VStr h9 -> mkstr_e (sget h9) (env_read_enc ()) | _ -> ov),
                           env_pairs_hl t)))
    else Cons (mkstr_e k (env_read_enc ()), Cons (mkstr_e v (env_read_enc ()), env_pairs_hl t))
and env_ovr_only = fn (ps: (str * str) list) ->
  let out = map_new () in
  let _ = map_iter env_ovr (fn (k: str) -> fn (v: Val) ->
    match v with
    | VNil -> ()
    | _ -> if spairs_has ps k then () else (let i = map_len out in
             let _ = map_set out (str_of_int i) (mkstr_e k (env_read_enc ())) in
             map_set out (str_of_int (i + 1))
               (match v with VStr h9 -> mkstr_e (sget h9) (env_read_enc ()) | _ -> v))) in
  idx_to_list out 0 (map_len out)
and spairs_has = fn (ps: (str * str) list) -> fn (k: str) ->
  match ps with Nil -> false | Cons ((k2, _), t) -> if str_eq k2 k then true else spairs_has t k
and env_hl_keys = fn (xs: Val list) ->
  match xs with Cons (k, Cons (_, t)) -> Cons (k, env_hl_keys t) | _ -> (Nil : Val list)
and env_hl_values = fn (xs: Val list) ->
  match xs with Cons (_, Cons (v, t)) -> Cons (v, env_hl_values t) | _ -> (Nil : Val list)
and env_hl_pairs = fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (v, t)) -> Cons (arr_new (Cons (k, Cons (v, Nil))), env_hl_pairs t)
  | _ -> (Nil : Val list)
and env_del_keys = fn (ks: Val list) ->
  match ks with
  | Nil -> ()
  | Cons (VStr h, t) -> let _ = map_set env_ovr (sget h) VNil in env_del_keys t
  | Cons (_, t) -> env_del_keys t
and env_key_scan = fn (pairs: (str * str) list) -> fn (target: str) ->
  match pairs with
  | Nil -> VNil
  | Cons ((k2, v2), rest) ->
    if (if map_has env_ovr k2 then false else true) && str_eq v2 target then mkstr k2
    else env_key_scan rest target
and is_reg_file = fn (p1: str) ->
  file_exists p1 && run ("test -f " ++ shq p1 ++ " 2> /dev/null") == 0
// ⚠ A NAME'S LEADING DOTS ARE NOT PART OF ANY EXTENSION, and dropping only
//   the FIRST one was not enough. ".." answered "." and "..foo" answered
//   ".foo"; ruby answers "" for both. The guard `i <= 0` only protects a name
//   whose single dot is at index 0, so the second dot of ".." looked like an
//   ordinary extension dot. Ruby skips the WHOLE leading run first and then
//   looks for the last dot in what is left: "..foo" has none, ".a.b" has one
//   and gives ".b", "foo." still gives "." because its dot follows a letter.
and extname_of = fn (b: str) ->
  let b2 = skip_lead_dots b 0 in
  let i = last_dot_at b2 (str_len b2 - 1) in
  if i <= 0 then "" else substring b2 i (str_len b2)
and skip_lead_dots = fn (b: str) -> fn (i: int) ->
  if i < str_len b && str_eq (char_at b i) "." then skip_lead_dots b (i + 1)
  else substring b i (str_len b)
and last_dot_at = fn (b: str) -> fn (i: int) ->
  if i < 0 then 0 - 1 else if str_eq (char_at b i) "." then i else last_dot_at b (i - 1)
// (expand_path's "~" is xp_tilde in main.mere: HOME, the user database, and
// the refusals ruby makes for either)
// a path made absolute against the cwd, textually
and abs_path_of = fn (p: str) ->
  path_norm (if str_len p > 0 && str_eq (char_at p 0) "/" then p else env_get "PWD" ++ "/" ++ p)
and path_norm = fn (p: str) ->
  let abs = str_len p > 0 && str_eq (char_at p 0) "/" in
  let body = path_join (path_keep (path_split p 0 0 Nil) Nil) in
  if abs then "/" ++ body else if str_eq body "" then "." else body
and path_split = fn (p: str) -> fn (i: int) -> fn (st: int) -> fn (acc: str list) ->
  if i >= str_len p then rev_strs (Cons (substring p st i, acc)) Nil
  else if str_eq (char_at p i) "/" then path_split p (i + 1) (i + 1) (Cons (substring p st i, acc))
  else path_split p (i + 1) st acc
and path_keep = fn (segs: str list) -> fn (acc: str list) ->
  match segs with
  | Nil -> rev_strs acc Nil
  | Cons (sg, t) ->
    if str_eq sg "" || str_eq sg "." then path_keep t acc
    else if str_eq sg ".." then (match acc with Nil -> path_keep t acc | Cons (_, r) -> path_keep t r)
    else path_keep t (Cons (sg, acc))
and rev_strs = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_strs t (Cons (h, acc))
and path_join = fn (xs: str list) ->
  match xs with
  | Nil -> ""
  | Cons (h, Nil) -> h
  | Cons (h, t) -> h ++ "/" ++ path_join t
and shq = fn (s2: str) ->
  "'" ++ shq_go s2 0 "" ++ "'"
and shq_go = fn (s2: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s2 then acc
  else
    let c = char_at s2 i in
    shq_go s2 (i + 1) (acc ++ (if str_eq c "'" then "'\\''" else c))
and stdlib_src = fn (name: str) ->
  let n = (if ends_with_rb name then substring name 0 (str_len name - 3) else name) in
  // socket: CRuby's ext/socket, ported. The address half is DATA and is
  // whole -- Addrinfo keeps the sockaddr as the C struct's bytes (BSD
  // layout), getaddrinfo is raddrinfo.c's numeric fast path and then the
  // "files" half of the C library (/etc/hosts, /etc/services; no DNS client),
  // Socket::Option and Socket::AncillaryData are their structs, and the
  // constants are the pinned reference's. The socket half is what the fd
  // primitives reach: TCP connect/listen/accept in either family, a connected
  // UDP socket, and getsockname/getpeername read back from lsof(8) or /proc.
  // What needs a sockaddr passed IN -- bind(2) to a chosen address, sendto(2),
  // UNIX sockets -- raises NotImplementedError by name, because a socket
  // library that silently does nothing moves the failure away from its cause
  // (see KNOWN_GAPS on `require "enumerator"`).
  // openssl: the half of it that is a HASH FUNCTION, which mere-ruby already
  // ships -- OpenSSL::Digest over Digest, and HMAC written out in ruby (it is
  // two hashes and an xor). TLS, X509 and PKey are NOT defined, not even as
  // classes that raise: a gem that needs them should fail on the constant it
  // actually needs, which names the missing capability, rather than load and
  // fail later somewhere else.
  // data: ruby 3.2's Data, written in ruby rather than in the dispatcher. It
  // is a CLASS GENERATOR like Struct, and everything it generates -- the
  // readers, the frozen instances, #with, the keyword/positional pair that
  // Data.define's classes accept -- is ordinary ruby, so it belongs where a
  // reader can check it against the spec rather than spread over the
  // interpreter. Behind an autoload on the constant (see autoloads "Data"),
  // so a program that never mentions Data does not pay for it and the
  // prelude does not grow.
  // fcntl: the CONSTANTS, which is all of the library a ruby program can use
  // without the syscall behind them. ruby/spec's core/io/reopen requires it on
  // line 4 and mere-ruby died at load -- the whole file, eighty-one specs'
  // worth of group, for a handful of integers. The values are this platform's,
  // asked of the pinned reference.
  // base64: every one of its six methods is a single pack or unpack, so the
  // library IS the two directives (see m_pack.mere). ruby/spec's
  // library/base64 is six files and mere-ruby could not load the name.
  // shellwords: the three functions and their four aliases, written in ruby
  // exactly as the stdlib writes them (one scan with one regexp).
  // io/console: the part of it that is not a terminal. ruby/spec's
  // library/stringio requires it on two files and mere-ruby died at load --
  // the scoreboard calls a load failure CRASH, so two files carried one for a
  // method that is four characters of ruby.
  if str_eq n "io/console" then
    "require \"stringio\"\n" ++
    "\n" ++
    "# io/console adds two methods to StringIO when it is required. Only #getch is\n" ++
    "# here: it is exactly #getc, which this StringIO already answers.\n" ++
    "#\n" ++
    "# #getpass is NOT defined. Its reading is not \"a line without the newline\" --\n" ++
    "# ruby consumes one character more than that, and a method that is close but\n" ++
    "# not the same is a wrong answer where a missing one is an honest refusal.\n" ++
    "class StringIO\n" ++
    "  def getch\n" ++
    "    getc\n" ++
    "  end\n" ++
    "end\n" ++
    ""
  else if str_eq n "shellwords" then
    "module Shellwords\n" ++
    "  module_function\n" ++
    "\n" ++
    "  def shellsplit(line)\n" ++
    "    words = []\n" ++
    "    field = String.new\n" ++
    "    line.scan(/\\G\\s*(?>([^\\s\\\\\\'\\\"]+)|'([^\\']*)'|\"((?:[^\\\"\\\\]|\\\\.)*)\"|(\\\\.?)|(\\S))(\\s|\\z)?/m) do\n" ++
    "      |word, sq, dq, esc, garbage, sep|\n" ++
    "      raise ArgumentError, \"Unmatched quote: #\{line.inspect}\" if garbage\n" ++
    "      field << (word || sq || (dq && dq.gsub(/\\\\([$`\"\\\\\\n])/, '\\\\1')) || esc.gsub(/\\\\(.)/, '\\\\1'))\n" ++
    "      if sep\n" ++
    "        words << field\n" ++
    "        field = String.new\n" ++
    "      end\n" ++
    "    end\n" ++
    "    words\n" ++
    "  end\n" ++
    "\n" ++
    "  def shellescape(str)\n" ++
    "    str = str.to_s\n" ++
    "    return \"''\".dup if str.empty?\n" ++
    "    str = str.dup\n" ++
    "    str.gsub!(/[^A-Za-z0-9_\\-.,:+\\/@\\n]/, \"\\\\\\\\\\\\&\")\n" ++
    "    str.gsub!(/\\n/, \"'\\n'\")\n" ++
    "    str\n" ++
    "  end\n" ++
    "\n" ++
    "  def shelljoin(array)\n" ++
    "    array.map \{ |arg| shellescape(arg) }.join(' ')\n" ++
    "  end\n" ++
    "\n" ++
    "  class << self\n" ++
    "    alias_method :split, :shellsplit\n" ++
    "    alias_method :escape, :shellescape\n" ++
    "    alias_method :join, :shelljoin\n" ++
    "    alias_method :shellwords, :shellsplit\n" ++
    "  end\n" ++
    "end\n" ++
    ""
  else   // observer: the Observable mixin, which is bookkeeping over a hash and has
  // no C behind it at all.
  if str_eq n "observer" then
    "module Observable\n" ++
    "  def add_observer(observer, func = :update)\n" ++
    "    @observer_peers = \{} unless defined? @observer_peers\n" ++
    "    unless observer.respond_to? func\n" ++
    "      raise NoMethodError, \"observer does not respond to `#\{func}'\"\n" ++
    "    end\n" ++
    "    @observer_peers[observer] = func\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete_observer(observer)\n" ++
    "    @observer_peers.delete observer if defined? @observer_peers\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete_observers\n" ++
    "    @observer_peers.clear if defined? @observer_peers\n" ++
    "  end\n" ++
    "\n" ++
    "  def count_observers\n" ++
    "    if defined? @observer_peers\n" ++
    "      @observer_peers.size\n" ++
    "    else\n" ++
    "      0\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def changed(state = true)\n" ++
    "    @observer_state = state\n" ++
    "  end\n" ++
    "\n" ++
    "  def changed?\n" ++
    "    if defined?(@observer_state) && @observer_state\n" ++
    "      true\n" ++
    "    else\n" ++
    "      false\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def notify_observers(*arg)\n" ++
    "    if defined?(@observer_state) && @observer_state\n" ++
    "      if defined? @observer_peers\n" ++
    "        @observer_peers.each do |k, v|\n" ++
    "          k.__send__(v, *arg)\n" ++
    "        end\n" ++
    "      end\n" ++
    "      @observer_state = false\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    ""
  else   // cgi: the ESCAPE half, which is what a program that is not a CGI script
  // wants from it -- escapeHTML and the URI encoders are pure string
  // functions with an exact answer. `require "cgi"`, `"cgi/escape"` and
  // `"cgi/util"` all reach it, as they do in ruby. The request/response half
  // (CGI.new, #out, #header) is NOT here: it needs an environment this
  // interpreter does not run in, and a CGI object that answers nothing useful
  // is worse than a missing name.
  if str_eq n "cgi" || str_eq n "cgi/escape" || str_eq n "cgi/util" then
    "class CGI\n" ++
    "  # the default target encoding of the unescapers, which cgi/escape keeps\n" ++
    "  # as a class variable (the full cgi gem adds the accessors)\n" ++
    "  @@accept_charset = \"UTF-8\" unless class_variable_defined?(:@@accept_charset)\n" ++
    "  module Escape\n" ++
    "    # ⚠ ruby's escapeHTML works on BYTES (it is C), so a string that is\n" ++
    "    # not valid in its encoding is escaped, not refused. gsub refuses such a\n" ++
    "    # string, so the invalid case goes through a binary copy and comes back\n" ++
    "    # tagged as it arrived. A valid string takes the path it always took.\n" ++
    "    def escapeHTML(string)\n" ++
    "      return escapeHTML(string.b).force_encoding(string.encoding) unless string.valid_encoding?\n" ++
    "      string.gsub(/['&\\\"<>]/, \{\n" ++
    "        \"'\" => \"&#39;\",\n" ++
    "        \"&\" => \"&amp;\",\n" ++
    "        '\"' => \"&quot;\",\n" ++
    "        \"<\" => \"&lt;\",\n" ++
    "        \">\" => \"&gt;\",\n" ++
    "      })\n" ++
    "    end\n" ++
    "\n" ++
    "    def unescapeHTML(string)\n" ++
    "      return string unless string.include? \"&\"\n" ++
    "      return unescapeHTML(string.b).force_encoding(string.encoding) unless string.valid_encoding?\n" ++
    "      string.gsub(/&(apos|amp|quot|gt|lt|#[0-9]+|#[xX][0-9A-Fa-f]+);/) do\n" ++
    "        match = $1.dup\n" ++
    "        case match\n" ++
    "        when \"apos\"                then \"'\"\n" ++
    "        when \"amp\"                 then \"&\"\n" ++
    "        when \"quot\"                then '\"'\n" ++
    "        when \"gt\"                  then \">\"\n" ++
    "        when \"lt\"                  then \"<\"\n" ++
    "        when /\\A#0*(\\d+)\\z/        then ($1.to_i).chr\n" ++
    "        when /\\A#x([0-9a-f]+)\\z/i  then ($1.hex).chr\n" ++
    "        else \"&#\{match};\"\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def escape(string)\n" ++
    "      string.to_s.b.gsub(/([^ a-zA-Z0-9_.\\-~]+)/) do |m|\n" ++
    "        '%' + m.unpack('H2' * m.bytesize).join('%').upcase\n" ++
    "      end.tr(' ', '+')\n" ++
    "    end\n" ++
    "\n" ++
    "    # cgi/escape's optimized_unescape: the octets go into a String of the\n" ++
    "    # target encoding (CGI's @@accept_charset unless one is given), and a\n" ++
    "    # result that is not valid there keeps the SOURCE string's encoding\n" ++
    "    def __unescape(string, encoding, plus)\n" ++
    "      unless string.is_a?(String)\n" ++
    "        raise TypeError, \"no implicit conversion of #\{string.nil? ? 'nil' : string.class} into String\" unless string.respond_to?(:to_str)\n" ++
    "        string = string.to_str\n" ++
    "      end\n" ++
    "      encoding = CGI.class_variable_get(:@@accept_charset) if encoding.nil?\n" ++
    "      enc = encoding.is_a?(Encoding) ? encoding : Encoding.find(encoding.to_str)\n" ++
    "      str = plus ? string.b.tr('+', ' ') : string.b\n" ++
    "      str = str.gsub(/((?:%[0-9a-fA-F]\{2})+)/) do |m|\n" ++
    "        [m.delete('%')].pack('H*')\n" ++
    "      end\n" ++
    "      str.force_encoding(enc)\n" ++
    "      str.force_encoding(string.encoding) unless str.valid_encoding?\n" ++
    "      str\n" ++
    "    end\n" ++
    "\n" ++
    "    def unescape(string, encoding = nil) = __unescape(string, encoding, true)\n" ++
    "\n" ++
    "    # RFC 3986: only the unreserved characters stay as they are, and the\n" ++
    "    # argument must be a String (or convert to one)\n" ++
    "    def escapeURIComponent(string)\n" ++
    "      unless string.is_a?(String)\n" ++
    "        raise TypeError, \"no implicit conversion of #\{string.nil? ? 'nil' : string.class} into String\" unless string.respond_to?(:to_str)\n" ++
    "        string = string.to_str\n" ++
    "      end\n" ++
    "      string.b.gsub(/[^a-zA-Z0-9_\\-.~]/) do |m|\n" ++

    "        '%' + m.unpack('H2' * m.bytesize).join('%').upcase\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def unescapeURIComponent(string, encoding = nil) = __unescape(string, encoding, false)\n" ++
    "  end\n" ++
    "\n" ++
    "  module Util\n" ++
    "    include Escape\n" ++
    "\n" ++
    "    def escapeElement(string, *elements)\n" ++
    "      elements = elements[0] if elements[0].kind_of?(Array)\n" ++
    "      unless elements.empty?\n" ++
    "        string.gsub(/<\\/?(?:#\{elements.join(\"|\")})(?!\\w)(?:.|\\n)*?>/i) do\n" ++
    "          CGI.escapeHTML($&)\n" ++
    "        end\n" ++
    "      else\n" ++
    "        string\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def unescapeElement(string, *elements)\n" ++
    "      elements = elements[0] if elements[0].kind_of?(Array)\n" ++
    "      unless elements.empty?\n" ++
    "        string.gsub(/&lt;\\/?(?:#\{elements.join(\"|\")})(?!\\w)(?:.|\\n)*?&gt;/i) do\n" ++
    "          CGI.unescapeHTML($&)\n" ++
    "        end\n" ++
    "      else\n" ++
    "        string\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def rfc1123_date(time)\n" ++
    "      time.getgm.strftime(\"%a, %d %b %Y %H:%M:%S GMT\")\n" ++
    "    end\n" ++
    "\n" ++
    "    alias h escapeHTML\n" ++
    "    module_function :escapeHTML, :unescapeHTML, :escape, :unescape,\n" ++
    "                    :escapeURIComponent, :unescapeURIComponent, :__unescape,\n" ++
    "                    :escapeElement, :unescapeElement, :rfc1123_date\n" ++
    "  end\n" ++
    "\n" ++
    "  include Util\n" ++
    "  class << self\n" ++
    "    include Util\n" ++
    "    public :escapeHTML, :unescapeHTML, :escape, :unescape,\n" ++
    "           :escapeURIComponent, :unescapeURIComponent,\n" ++
    "           :escapeElement, :unescapeElement, :rfc1123_date\n" ++
    "  end\n" ++
    "end\n" ++
    ""
  else if str_eq n "base64" then
    "module Base64\n" ++
    "  module_function\n" ++
    "\n" ++
    "  def encode64(bin)\n" ++
    "    [bin].pack(\"m\")\n" ++
    "  end\n" ++
    "\n" ++
    "  def decode64(str)\n" ++
    "    str.unpack1(\"m\")\n" ++
    "  end\n" ++
    "\n" ++
    "  def strict_encode64(bin)\n" ++
    "    [bin].pack(\"m0\")\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ STRICT means refuse, and the only refusals were the ones unpack\n" ++
    "  # happened to make: \"aGk\" (a length that is not a multiple of four)\n" ++
    "  # decoded to \"hi\" where ruby raises. Checked here, before unpack.\n" ++
    "  def strict_decode64(str)\n" ++
    "    raise ArgumentError, \"invalid base64\" if str.length % 4 != 0\n" ++
    "    str.unpack1(\"m0\")\n" ++
    "  end\n" ++
    "\n" ++
    "  def urlsafe_encode64(bin, padding: true)\n" ++
    "    str = strict_encode64(bin).tr(\"+/\", \"-_\")\n" ++
    "    str = str.delete(\"=\") unless padding\n" ++
    "    str\n" ++
    "  end\n" ++
    "\n" ++
    "  def urlsafe_decode64(str)\n" ++
    "    if !str.end_with?(\"=\") && str.length % 4 != 0\n" ++
    "      str = str.ljust((str.length + 3) & ~3, \"=\")\n" ++
    "      str.tr!(\"-_\", \"+/\")\n" ++
    "    else\n" ++
    "      str = str.tr(\"-_\", \"+/\")\n" ++
    "    end\n" ++
    "    strict_decode64(str)\n" ++
    "  end\n" ++
    "end\n" ++
    ""
  else if str_eq n "fcntl" then
    "module Fcntl\n" ++
    "  VERSION = \"1.3.0\"\n" ++
    "  FD_CLOEXEC = 1\n" ++
    "  F_ALLOCATEALL = 4\n" ++
    "  F_ALLOCATECONTIG = 2\n" ++
    "  F_ALLOCATEPERSIST = 8\n" ++
    "  F_DUPFD = 0\n" ++
    "  F_GETFD = 1\n" ++
    "  F_GETFL = 3\n" ++
    "  F_GETLK = 7\n" ++
    "  F_PEOFPOSMODE = 3\n" ++
    "  F_PREALLOCATE = 42\n" ++
    "  F_RDLCK = 1\n" ++
    "  F_SETFD = 2\n" ++
    "  F_SETFL = 4\n" ++
    "  F_SETLK = 8\n" ++
    "  F_SETLKW = 9\n" ++
    "  F_UNLCK = 2\n" ++
    "  F_VOLPOSMODE = 4\n" ++
    "  F_WRLCK = 3\n" ++
    "  O_ACCMODE = 3\n" ++
    "  O_APPEND = 8\n" ++
    "  O_CREAT = 512\n" ++
    "  O_EXCL = 2048\n" ++
    "  O_NDELAY = 4\n" ++
    "  O_NOCTTY = 131072\n" ++
    "  O_NONBLOCK = 4\n" ++
    "  O_RDONLY = 0\n" ++
    "  O_RDWR = 2\n" ++
    "  O_TRUNC = 1024\n" ++
    "  O_WRONLY = 1\n" ++
    "end\n" ++
    ""
  // Enumerator::Product (ruby 3.2): the Cartesian product of its sources, and
  // ordinary ruby -- a walk and a size. Behind an autoload on the constant, so
  // a program that never mentions it does not pay for it.
  else if str_eq n "enumerator_product" then
    "class Enumerator::Product < Enumerator\n" ++
    "  def initialize(*enums)\n" ++
    "    raise FrozenError, \"can't modify frozen \" + self.class.to_s + \": \" + inspect if frozen?\n" ++
    "    @__enums = enums\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize_copy(other)\n" ++
    "    return self if other.equal?(self)\n" ++
    "    raise FrozenError, \"can't modify frozen \" + self.class.to_s + \": \" + inspect if frozen?\n" ++
    "    raise TypeError, \"initialize_copy should take same class object\" unless other.class == self.class\n" ++
    "    raise ArgumentError, \"uninitialized product\" if other.__enums.nil?\n" ++
    "    @__enums = other.__enums.dup\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def __enums\n" ++
    "    @__enums\n" ++
    "  end\n" ++
    "\n" ++
    "  def each(&block)\n" ++
    "    return to_enum(:each) \{ size } unless block_given?\n" ++
    "    __prod_walk(@__enums, [], &block)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # the Cartesian product, depth first, left-most enumerable slowest. The\n" ++
    "  # accumulator is copied on the way out because the caller keeps the array.\n" ++
    "  def __prod_walk(rest, acc, &block)\n" ++
    "    if rest.empty?\n" ++
    "      block.call(acc.dup)\n" ++
    "    else\n" ++
    "      head = rest[0]\n" ++
    "      tail = rest[1, rest.length - 1] || []\n" ++
    "      __prod_each(head) do |v|\n" ++
    "        acc.push(v)\n" ++
    "        __prod_walk(tail, acc, &block)\n" ++
    "        acc.pop\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby drives each source with #each_entry, not #each -- an object that\n" ++
    "  # defines only each_entry is a valid source, and the spec has one.\n" ++
    "  # (an Enumerable's each_entry IS its each, which also walks an endless\n" ++
    "  # range without materializing it)\n" ++
    "  def __prod_each(e, &blk)\n" ++
    "    if e.is_a?(Enumerable) && e.respond_to?(:each)\n" ++
    "      e.each(&blk)\n" ++
    "    else\n" ++
    "      e.each_entry(&blk)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # the product of the sources' sizes, and nil as soon as one cannot say.\n" ++
    "  # No sources at all is 1: the product of an empty list is one empty tuple,\n" ++
    "  # which is also why `Enumerator::Product.new.each` yields [].\n" ++
    "  def size\n" ++
    "    n = 1\n" ++
    "    @__enums.each do |e|\n" ++
    "      s = e.respond_to?(:size) ? e.size : nil\n" ++
    "      # an Integer, or an infinite Float; anything else means unknown\n" ++
    "      return nil unless s.is_a?(Integer) || (s.is_a?(Float) && s.infinite?)\n" ++
    "      n = n * s\n" ++
    "    end\n" ++
    "    n\n" ++
    "  end\n" ++
    "\n" ++
    "  # taken by walking and stopping, so an infinite source can be taken\n" ++
    "  # from (the Enumerator versions materialize what they walk)\n" ++
    "  def take(n)\n" ++
    "    raise ArgumentError, \"attempt to take negative size\" if n < 0\n" ++
    "    out = []\n" ++
    "    return out if n == 0\n" ++
    "    each do |x|\n" ++
    "      out << x\n" ++
    "      break if out.size >= n\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  def first(*n)\n" ++
    "    return take(n[0]) unless n.empty?\n" ++
    "    each \{ |x| return x }\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def rewind\n" ++
    "    @__enums.each \{ |e| e.rewind if e.respond_to?(:rewind) }\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  # a product that contains itself shows it as ... (the array printer\n" ++
    "  # already guards the arrays around it)\n" ++
    "  def inspect\n" ++
    "    return \"#<Enumerator::Product: uninitialized>\" if @__enums.nil?\n" ++
    "    return \"#<Enumerator::Product: ...>\" if @__inspecting\n" ++
    "    @__inspecting = true\n" ++
    "    begin\n" ++
    "      \"#<Enumerator::Product: #\{@__enums.inspect}>\"\n" ++
    "    ensure\n" ++
    "      @__inspecting = false\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  private :initialize\n" ++
    "  private :initialize_copy\n" ++
    "end\n" ++
    "\n" ++
    "" ++
    ""
  else if str_eq n "data" then
    "class Data\n" ++
    "  # The generated class carries only its readers and its member list; every\n" ++
    "  # shared method lives HERE, on Data, exactly as in ruby -- which is what makes\n" ++
    "  # `Data.define(:a) \{ def initialize(a:); super; end }` work. A block-defined\n" ++
    "  # initialize lands on the generated class and its `super` reaches this one; if\n" ++
    "  # the generated method were on the same class the block would replace it.\n" ++
    "  def self.define(*names, &blk)\n" ++
    "    syms = names.map \{ |n| n.to_sym }\n" ++
    "    c = Class.new(self)\n" ++
    "    c.instance_variable_set(:@__members, syms)\n" ++
    "    c.define_singleton_method(:members) \{ @__members || superclass.members }\n" ++
    "    c.define_singleton_method(:[]) \{ |*a, **k| new(*a, **k) }\n" ++
    "    syms.each do |s|\n" ++
    "      c.send(:define_method, s) \{ instance_variable_get(\"@#\{s}\") }\n" ++
    "    end\n" ++
    "    c.class_eval(&blk) if blk\n" ++
    "    c\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize(*a, **k)\n" ++
    "    ms = self.class.members\n" ++
    "    if !a.empty?\n" ++
    "      if a.size > ms.size\n" ++
    "        raise ArgumentError, \"wrong number of arguments (given #\{a.size}, expected 0..#\{ms.size})\"\n" ++
    "      end\n" ++
    "      h = \{}\n" ++
    "      a.each_with_index \{ |v, i| h[ms[i]] = v }\n" ++
    "      k = h.merge(k)\n" ++
    "    end\n" ++
    "    k = k.map \{ |kk, vv| [kk.to_sym, vv] }.to_h\n" ++
    "    miss = ms - k.keys\n" ++
    "    unless miss.empty?\n" ++
    "      raise ArgumentError, \"missing keyword#\{miss.size > 1 ? 's' : ''}: #\{miss.map \{ |x| x.inspect }.join(', ')}\"\n" ++
    "    end\n" ++
    "    extra = k.keys - ms\n" ++
    "    unless extra.empty?\n" ++
    "      raise ArgumentError, \"unknown keyword#\{extra.size > 1 ? 's' : ''}: #\{extra.map \{ |x| x.inspect }.join(', ')}\"\n" ++
    "    end\n" ++
    "    ms.each \{ |m| instance_variable_set(\"@#\{m}\", k[m]) }\n" ++
    "    freeze\n" ++
    "  end\n" ++
    "\n" ++
    "  def members; self.class.members; end\n" ++
    "\n" ++
    "  def to_h(&b)\n" ++
    "    h = \{}\n" ++
    "    self.class.members.each \{ |m| h[m] = instance_variable_get(\"@#\{m}\") }\n" ++
    "    b ? h.to_h(&b) : h\n" ++
    "  end\n" ++
    "\n" ++
    "  def deconstruct; self.class.members.map \{ |m| instance_variable_get(\"@#\{m}\") }; end\n" ++
    "  # ⚠ NOT `to_h.slice(*ks)`: a pattern match asks for the keys it is about to\n" ++
    "  # bind and STOPS at the first one this data has no member for -- and answers\n" ++
    "  # \{} outright when more keys are asked than there are members, because then\n" ++
    "  # the pattern cannot possibly match. A key may be a String (answered as a\n" ++
    "  # String key) or anything with #to_str.\n" ++
    "  def deconstruct_keys(ks)\n" ++
    "    return to_h if ks.nil?\n" ++
    "    raise TypeError, \"wrong argument type \" + ks.class.to_s + \" (expected Array or nil)\" unless ks.is_a?(Array)\n" ++
    "    h = to_h\n" ++
    "    return \{} if ks.size > h.size\n" ++
    "    out = \{}\n" ++
    "    ks.each do |k0|\n" ++
    "      k = k0\n" ++
    "      unless k.is_a?(Symbol) || k.is_a?(String)\n" ++
    "        raise TypeError, \"#\{k.inspect} is not a symbol nor a string\" unless k.respond_to?(:to_str)\n" ++
    "        k = k.to_str\n" ++
    "        raise TypeError, \"can't convert #\{k0.class} to String (#\{k0.class}#to_str gives #\{k.class})\" unless k.is_a?(String)\n" ++
    "      end\n" ++
    "      sym = k.is_a?(String) ? k.to_sym : k\n" ++
    "      break unless h.key?(sym)\n" ++
    "      out[k] = h[sym]\n" ++
    "    end\n" ++
    "    out\n" ++
    "  end\n" ++
    "\n" ++
    "  # ⚠ `with` must not go through ::new: a program may define its own, and ruby\n" ++
    "  # builds the copy without it (ruby/spec asserts exactly that). allocate plus\n" ++
    "  # the initialize THIS class inherits is what ruby does.\n" ++
    "  def with(**k)\n" ++
    "    return self if k.empty?\n" ++
    "    o = self.class.allocate\n" ++
    "    o.send(:initialize, **to_h.merge(k))\n" ++
    "    o\n" ++
    "  end\n" ++
    "  # a comparison that comes back to the same pair while it is still\n" ++
    "  # running is equal, as ruby's recursive comparison says (it recursed\n" ++
    "  # forever or answered false)\n" ++
    "  def ==(o); o.class == self.class && Data.__eq_guarded(self, o) \{ o.to_h == to_h }; end\n" ++
    "  def eql?(o); o.class == self.class && Data.__eq_guarded(self, o) \{ o.to_h.eql?(to_h) }; end\n" ++
    "  def self.__eq_guarded(a, b)\n" ++
    "    @__eq ||= \{}\n" ++
    "    k = [a.__id__, b.__id__]\n" ++
    "    return true if @__eq[k]\n" ++
    "    @__eq[k] = true\n" ++
    "    begin\n" ++
    "      yield\n" ++
    "    ensure\n" ++
    "      @__eq.delete(k)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def hash; [self.class, to_h].hash; end\n" ++
    "\n" ++
    "  # ⚠ The class's REAL name, not `self.class.name`: a Data class may define\n" ++
    "  # `def self.name` (ruby/spec's own fixture does, answering \"A\") and ruby's\n" ++
    "  # inspect ignores it.\n" ++
    "  def inspect\n" ++
    "    ms = self.class.members\n" ++
    "    nm = Module.instance_method(:name).bind_call(self.class)\n" ++
    "    # a temporary name (nested in an anonymous module) is not shown\n" ++
    "    nm = nil if nm && nm.start_with?(\"#<\")\n" ++
    "    body = ms.map \{ |m| \"#\{m}=#\{instance_variable_get(\"@#\{m}\").inspect}\" }.join(\", \")\n" ++
    "    \"#<data#\{nm ? \" #\{nm}\" : \"\"}#\{body.empty? ? \"\" : \" #\{body}\"}>\"\n" ++
    "  end\n" ++
    "  alias_method :to_s, :inspect\n" ++
    "end\n" ++
    ""
  else if str_eq n "openssl" then
    "require \"digest\"\n" ++
    "module OpenSSL\n" ++
    "  # the gem ruby 4.0 bundles; the refusals below already use its wording\n" ++
    "  VERSION = \"4.0.2\"\n" ++
    "  class OpenSSLError < StandardError; end\n" ++
    "\n" ++
    "  def self.__str(x)\n" ++
    "    return x if String === x\n" ++
    "    raise TypeError, \"no implicit conversion of #\{x.nil? ? 'nil' : x.class} into String\" unless x.respond_to?(:to_str)\n" ++
    "    x.to_str\n" ++
    "  end\n" ++
    "\n" ++
    "  # a byte comparison that does not stop at the first difference\n" ++
    "  def self.fixed_length_secure_compare(a, b)\n" ++
    "    a = __str(a)\n" ++
    "    b = __str(b)\n" ++
    "    raise ArgumentError, \"inputs must be of equal length\" unless a.bytesize == b.bytesize\n" ++
    "    acc = 0\n" ++
    "    ab = a.bytes\n" ++
    "    bb = b.bytes\n" ++
    "    i = 0\n" ++
    "    while i < ab.size\n" ++
    "      acc |= ab[i] ^ bb[i]\n" ++
    "      i += 1\n" ++
    "    end\n" ++
    "    acc == 0\n" ++
    "  end\n" ++
    "\n" ++
    "  # ruby's own definition (lib/openssl.rb): hash both so the lengths agree,\n" ++
    "  # then insist the ORIGINAL objects are equal too\n" ++
    "  def self.secure_compare(a, b)\n" ++
    "    hashed_a = OpenSSL::Digest.digest(\"SHA256\", a)\n" ++
    "    hashed_b = OpenSSL::Digest.digest(\"SHA256\", b)\n" ++
    "    OpenSSL.fixed_length_secure_compare(hashed_a, hashed_b) && a == b\n" ++
    "  end\n" ++
    "\n" ++
    "  # bytes from Random's generator; there is no OpenSSL pool here\n" ++
    "  module Random\n" ++
    "    def self.random_bytes(n) = ::Random.urandom(n)\n" ++
    "    def self.pseudo_bytes(n) = ::Random.urandom(n)\n" ++
    "  end\n" ++
    "  # The digests mere-ruby ships, wearing OpenSSL's names and class shape:\n" ++
    "  # OpenSSL::Digest::SHA256.new.class is OpenSSL::Digest::SHA256, as in ruby.\n" ++
    "  class Digest\n" ++
    "    class DigestError < OpenSSLError; end\n" ++
    "    def self.__impl_for(name)\n" ++
    "      case name.to_s.upcase.gsub(\"-\", \"\")\n" ++
    "      when \"SHA1\" then ::Digest::SHA1\n" ++
    "      when \"SHA256\" then ::Digest::SHA256\n" ++
    "      when \"SHA384\" then ::Digest::SHA384\n" ++
    "      when \"SHA512\" then ::Digest::SHA512\n" ++
    "      when \"MD5\" then ::Digest::MD5\n" ++
    "      else\n" ++
    "        raise DigestError, \"unsupported digest algorithm: #\{name}: unsupported (mere-ruby ships MD5, SHA1, SHA256, SHA384 and SHA512)\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "    def self.__algo\n" ++
    "      nil\n" ++
    "    end\n" ++
    "    def self.digest(name, data = nil)\n" ++
    "      return __impl_for(__algo).digest(OpenSSL.__str(name)) if __algo\n" ++
    "      __impl_for(name).digest(OpenSSL.__str(data))\n" ++
    "    end\n" ++
    "    def self.hexdigest(name, data = nil)\n" ++
    "      return __impl_for(__algo).hexdigest(name) if __algo\n" ++
    "      __impl_for(name).hexdigest(data)\n" ++
    "    end\n" ++
    "    def self.base64digest(name, data = nil)\n" ++
    "      return __impl_for(__algo).base64digest(name) if __algo\n" ++
    "      __impl_for(name).base64digest(data)\n" ++
    "    end\n" ++
    "    def initialize(name = nil, data = nil)\n" ++
    "      # openssl 4.0 wants a String name (the subclasses pass their own)\n" ++
    "      if name.nil? && !self.class.respond_to?(:__algo)\n" ++
    "        raise TypeError, \"no implicit conversion of nil into String\"\n" ++
    "      end\n" ++
    "      # another digest names the algorithm and nothing else: its state stays\n" ++
    "      name = name.name if name.is_a?(OpenSSL::Digest)\n" ++
    "      if !name.nil? && !name.is_a?(String)\n" ++
    "        raise TypeError, \"no implicit conversion of \" + name.class.to_s + \" into String\"\n" ++
    "      end\n" ++
    "      @name = (name || self.class.__algo).to_s.upcase.gsub(\"-\", \"\")\n" ++
    "      # the refusal names the algorithm as it was ASKED for, not as normalised\n" ++
    "      @impl = Digest.__impl_for(name || @name).new\n" ++
    "      update(data) if data\n" ++
    "    end\n" ++
    "    def name\n" ++
    "      @name\n" ++
    "    end\n" ++
    "    # ⚠ #to_str, not #to_s: a mock that answers only #to_str was digested\n" ++
    "    # as its inspect string, and an Object was digested where ruby refuses.\n" ++
    "    def update(data)\n" ++
    "      unless String === data\n" ++
    "        raise TypeError, \"no implicit conversion of #\{data.nil? ? 'nil' : data.class} into String\" unless data.respond_to?(:to_str)\n" ++
    "        data = data.to_str\n" ++
    "      end\n" ++
    "      @impl.update(data)\n" ++
    "      self\n" ++
    "    end\n" ++
    "    def <<(data)\n" ++
    "      update(data)\n" ++
    "    end\n" ++
    "    def digest\n" ++
    "      @impl.digest\n" ++
    "    end\n" ++
    "    def hexdigest\n" ++
    "      @impl.hexdigest\n" ++
    "    end\n" ++
    "    def base64digest\n" ++
    "      @impl.base64digest\n" ++
    "    end\n" ++
    "    def to_s\n" ++
    "      hexdigest\n" ++
    "    end\n" ++
    "    def reset\n" ++
    "      @impl = Digest.__impl_for(@name).new\n" ++
    "      self\n" ++
    "    end\n" ++
    "    def block_length\n" ++
    "      # NOT a constant 64. SHA-384 and SHA-512 are built on 128-byte blocks,\n" ++
    "      # and this answered 64 for them while the digests themselves were right.\n" ++
    "      Digest.__impl_for(@name).new.block_length\n" ++
    "    end\n" ++
    "    def digest_length\n" ++
    "      Digest.__impl_for(@name).digest(\"\").bytesize\n" ++
    "    end\n" ++
    "    class SHA1 < Digest\n" ++
    "      def self.__algo\n" ++
    "        \"SHA1\"\n" ++
    "      end\n" ++
    "      def initialize(data = nil)\n" ++
