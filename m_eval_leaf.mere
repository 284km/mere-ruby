    "  end\n" ++
    "  protected :to_h_internal\n" ++
    "\n" ++
    "  # A set being walked refuses the mutations ruby refuses, and ruby is precise\n" ++
    "  # about which: adding a NEW item, merging anything, and replacing all raise;\n" ++
    "  # deleting, subtracting and clearing do not, and re-adding an item that is\n" ++
    "  # already there does not either. Like the inspect guard, the marker is a table\n" ++
    "  # on the class keyed by object_id -- an ivar could not be written on a frozen\n" ++
    "  # set, and a frozen set is still walkable.\n" ++
    "  def self.__iter_ids\n" ++
