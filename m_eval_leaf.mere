    "    return nil if include?(o)\n" ++
    "    add(o)\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete(o)\n" ++
    "    __modify!\n" ++
    "    @hash.delete(o)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def delete?(o)\n" ++
    "    return nil unless include?(o)\n" ++
    "    delete(o)\n" ++
    "  end\n" ++
    "\n" ++
    "  def merge(*enums)\n" ++
    "    __modify!(:merge)\n" ++
    "    enums.each do |e|\n" ++
    "      Set.__enum!(e)\n" ++
    "      e.each \{ |x| @hash[x] = true }\n" ++
    "    end\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def replace(enum)\n" ++
    "    __modify!(:replace)\n" ++
    "    Set.__enum!(enum)\n" ++
    "    h = \{}\n" ++
    "    enum.each \{ |x| h[x] = true }\n" ++
    "    @hash = h\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
