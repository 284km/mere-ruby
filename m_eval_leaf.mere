    "    Set.__enum!(enum)\n" ++
    "    if block\n" ++
    "      enum.each \{ |x| @hash[block.call(x)] = true }\n" ++
    "    else\n" ++
    "      enum.each \{ |x| @hash[x] = true }\n" ++
    "    end\n" ++
