and num_has = fn (v: Val) -> fn (name: str) -> map_has (num_name_set v) name
  // to_enum / enum_for answer for EVERY receiver here (they build an
  // Enumerator over the named method), so the claim and the implementation
  // agree -- respond_to? said false while the call worked, and
  // `Kernel.instance_method(:to_enum)` raised for a method that answers.
  // `-@` / `+@` are NOT universal: String and Numeric define them and nothing
  // else does. Claiming them for every receiver here made `-obj` answer the
  // OBJECT (prim_method's catch-all arm returns the receiver) instead of
  // dispatching, so a class with a method_missing never saw the message and a
  // class without one never got its NoMethodError -- a wrong answer, silently.
  // They live in is_str_method and num_names_for now, where the receiver is known.
  // #then and #yield_self answer for every receiver the way #tap does; they
  // were implemented and claimed by nobody, so `respond_to?(:then)` was false
  // and `Kernel.instance_method(:then)` raised while `1.then { }` ran.
  // BasicObject's two underscore names are the SAME methods as object_id and
  // send, and the primitive already answered both -- but only `__send__` was
  // claimed here, so the working `__id__` arm was unreachable: the dispatcher
  // refused the name before the primitive ever saw it. A list that governs
  // whether a name exists hides an implementation it forgot to mention.
  // Object#!~ is defined for every object; Object#=~ was REMOVED in ruby 3.2,
  // so it stays per-type (String, Symbol, Regexp define their own).
  // reflection primitives, so respond_to? and implicit-self dispatch reach them
  // ...and #singleton_class, which was implemented and claimed by nobody: a
  // bare `singleton_class` inside a method was "undefined local variable or
  // method", while `self.singleton_class` answered.
  // Object#<=>, which every object has in ruby: `obj.<=>(obj)` is 0 and
  // `obj.<=>(other)` is nil. Claiming it is what makes the EXPLICIT call reach
  // a primitive arm at all (the operator form never goes through the
  // dispatcher). The copy hooks are deliberately NOT claimed here: a claim
  // shadows a user's definition, and dup/clone have to reach the user's
  // initialize_copy, not a no-op primitive.
and is_prim_method = fn (name: str) ->
  map_has (name_set "is_prim_method") name
and str_upto_list = fn (a: str) -> fn (b: str) -> fn (excl: bool) -> fn (n: int) ->
  if n > 100000 then Nil
  else if str_len a > str_len b then Nil
  else if str_len a == str_len b && str_compare a b > 0 then Nil
  else if excl && str_eq a b then Nil
  else
    // a succ that cannot advance would otherwise spin to the guard above.
    let nx = str_succ a in
    Cons (mkstr a, (if str_eq a b || str_eq nx a then Nil else str_upto_list nx b excl (n + 1)))
and str_dump_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let c = char_at s i in
    let o = ord c in
    if o < 128 then str_dump_go s (i + 1) (acc ++ c)
    else
      (match utf8_cp_strict s i with
       | (cp, l, ok) ->
         if ok then
           str_dump_go s (i + l)
             (acc ++ (if cp > 65535 then "\\u\{" ++ hex_up cp ++ "}" else "\\u" ++ hex4 cp))
         else str_dump_go s (i + 1) (acc ++ "\\x" ++ hex2_up o))
and hex_up = fn (n: int) ->
  let d = fn (k: int) -> substring "0123456789ABCDEF" k (k + 1) in
  let rec go = fn (v: int) -> fn (acc: str) ->
    if v == 0 then (if str_eq acc "" then "0" else acc)
    else go (floor_div v 16) (d (floor_mod v 16) ++ acc) in
  go n ""
and hex2_up = fn (n: int) ->
  let d = fn (k: int) -> substring "0123456789ABCDEF" k (k + 1) in
  d (floor_div n 16) ++ d (floor_mod n 16)
and str_concat_vals = fn (args: Val list) ->
  match args with
  | Nil -> ""
  | Cons (v, rest) -> (match v with VStr s -> let s = sget s in s | _ -> to_s v) ++ str_concat_vals rest
  // sub!/gsub! are NOT here: routing them through the scratch-copy path
  // reached the world-free prim, which loses a Hash replacement's default,
  // $~ publication and encoding negotiation -- the world handler in
  // invoke_val_c owns all four forms (bang included) instead.
and str_bang_base_ok = fn (b: str) ->
  map_has (name_set "str_bang_base_ok") b
and val_is_frozen = fn (recv: Val) ->
  match recv with
  | VStr id -> sfrozen_get id
  | VArr id -> cfrozen_get 0 id
  | VHsh id -> cfrozen_get 1 id
  | VObj id -> ofrozen_get id
  | VClass c -> clsfrozen_get c || (is_sng_cls c && ofrozen_key (sng_inner c))
  // a Proc CAN be frozen (`proc {}.freeze.frozen?` is true), and #clone carries
  // that over while #dup drops it -- the same pair of rules the containers
  // follow. This answered false however often it had been frozen.
  | VProc id -> cfrozen_get 2 id
  | VMain -> false
  | _ -> true
and val_frozen_mut = fn (recv: Val) ->
  (match recv with VStr _ -> true | VArr _ -> true | VHsh _ -> true | VObj _ -> true | _ -> false)
  && val_is_frozen recv
and is_mutating_method = fn (name: str) ->
  // retagging bytes mutates the string, so frozen refuses force_encoding
  // (ruby's rule); so does setbyte. bytesplice checks INSIDE the prim -- its
  // arity error comes before the frozen one, so it is not here.
  map_has (name_set "mut") name
  // NOT scrub!: on an already-valid frozen string it mutates nothing and
  // ruby lets it through -- the frozen check happens at the write instead.
  || (let n = str_len name in
      n > 1 && str_eq (char_at name (n - 1)) "!" && (if (str_len name == 6 && str_eq name "scrub!") then false else true))
and is_str_mut = fn (name: str) ->
  (str_len name == 6 && str_eq name "concat") || (str_len name == 7 && str_eq name "replace") || (str_len name == 5 && str_eq name "clear") ||
  (str_len name == 7 && str_eq name "prepend") || (str_len name == 15 && str_eq name "append_as_bytes")
  || (let n = str_len name in
      n > 1 && str_eq (char_at name (n - 1)) "!" && str_bang_base_ok (substring name 0 (n - 1)))
and is_range_method = fn (name: str) ->
  map_has (name_set "is_range_method") name
and rng_hi_open = fn (hi: Val) ->
  match hi with
  | VNil -> true
  | VFlt f -> (if f == 0.0 then false else true) && f * 0.5 == f && f > 0.0
  | _ -> false
  // ...but the no-argument forms are answered from the endpoints below: an
  // endless range (`1..Float::INFINITY`, which is how an arity with no upper
  // bound is written) must never be materialised.
  // NOT the padding family: ljust/rjust/center negotiate the receiver's and
  // the pad's encodings themselves, and this post-hoc retag clobbered that.
and range_delegate_name = fn (name: str) ->
  map_has (name_set "range_delegate_name") name
and enc_preserving = fn (name: str) ->
  map_has (name_set "enc_preserving") name
and prim_zero_arity = fn (recv: Val) -> fn (name: str) ->
  let any = (str_len name == 4 && str_eq name "hash") || (str_len name == 6 && str_eq name "freeze") || (str_len name == 7 && str_eq name "frozen?")
            || (str_len name == 3 && str_eq name "dup") || (str_len name == 4 && str_eq name "nil?") in
  if any then true
  else
    let str_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 7 && str_eq name "reverse") || (str_len name == 5 && str_eq name "chars") || (str_len name == 5 && str_eq name "bytes")
                || (str_len name == 10 && str_eq name "codepoints") || (str_len name == 6 && str_eq name "to_sym") || (str_len name == 4 && str_eq name "to_s")
                // (strip / lstrip / rstrip left this list with ruby 4.0: they
                // take selector arguments now, and check them themselves)
                || (str_len name == 4 && str_eq name "to_f")
                || (str_len name == 4 && str_eq name "chop") || (str_len name == 4 && str_eq name "succ")
                || (str_len name == 4 && str_eq name "next") || (str_len name == 7 && str_eq name "inspect") || (str_len name == 6 && str_eq name "to_str")
                || (str_len name == 3 && str_eq name "ord") || (str_len name == 3 && str_eq name "chr") in
    let int_n = (str_len name == 4 && str_eq name "size") || (str_len name == 4 && str_eq name "to_f") || (str_len name == 4 && str_eq name "to_i")
                || (str_len name == 4 && str_eq name "succ") || (str_len name == 4 && str_eq name "next") || (str_len name == 3 && str_eq name "abs")
                || (str_len name == 5 && str_eq name "even?") || (str_len name == 4 && str_eq name "odd?") || (str_len name == 5 && str_eq name "zero?")
                || (str_len name == 9 && str_eq name "positive?") || (str_len name == 9 && str_eq name "negative?") || (str_len name == 3 && str_eq name "ord") in
    let arr_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 7 && str_eq name "reverse") || (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "to_a")
                || (str_len name == 4 && str_eq name "to_h") || (str_len name == 7 && str_eq name "inspect") || (str_len name == 4 && str_eq name "sort")
                || (str_len name == 4 && str_eq name "uniq") || (str_len name == 7 && str_eq name "compact") in
    let hsh_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 4 && str_eq name "keys") || (str_len name == 6 && str_eq name "values") || (str_len name == 4 && str_eq name "to_s")
                || (str_len name == 4 && str_eq name "to_a") || (str_len name == 4 && str_eq name "to_h") || (str_len name == 7 && str_eq name "inspect")
                || (str_len name == 4 && str_eq name "sort") || (str_len name == 4 && str_eq name "uniq") || (str_len name == 7 && str_eq name "compact")
                || (str_len name == 7 && str_eq name "to_proc") in
    let nil_n = (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "to_f") || (str_len name == 4 && str_eq name "to_i")
                || (str_len name == 4 && str_eq name "to_a") || (str_len name == 4 && str_eq name "to_h") || (str_len name == 7 && str_eq name "inspect") in
    let sym_n = (str_len name == 6 && str_eq name "length") || (str_len name == 4 && str_eq name "size") || (str_len name == 6 && str_eq name "empty?")
                || (str_len name == 6 && str_eq name "to_sym") || (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "succ")
                || (str_len name == 4 && str_eq name "next") || (str_len name == 7 && str_eq name "inspect") || (str_len name == 7 && str_eq name "to_proc") in
    let flt_n = (str_len name == 4 && str_eq name "to_s") || (str_len name == 4 && str_eq name "to_f") || (str_len name == 4 && str_eq name "to_i")
                || (str_len name == 7 && str_eq name "inspect") || (str_len name == 3 && str_eq name "abs") || (str_len name == 5 && str_eq name "zero?")
                || (str_len name == 9 && str_eq name "positive?") || (str_len name == 9 && str_eq name "negative?") in
    (match recv with
     | VStr _ -> str_n
     | VInt _ -> int_n
     | VArr _ -> arr_n
     | VHsh _ -> hsh_n
     | VNil -> nil_n
     | VSym _ -> sym_n
     | VFlt _ -> flt_n
