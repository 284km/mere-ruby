    "  AF_UNSPEC = 0\n" ++
    "  AF_UNIX = 1\n" ++
    "  AF_INET = 2\n" ++
    "  AF_INET6 = 30\n" ++
    "  PF_UNSPEC = 0\n" ++
    "  PF_UNIX = 1\n" ++
    "  PF_INET = 2\n" ++
    "  PF_INET6 = 30\n" ++
    "  SOCK_STREAM = 1\n" ++
    "  SOCK_DGRAM = 2\n" ++
    "  SOL_SOCKET = 65535\n" ++
    "  SO_REUSEADDR = 4\n" ++
    "  SO_KEEPALIVE = 8\n" ++
