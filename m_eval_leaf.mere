    "  def initialize(host = nil, port = nil)\n" ++
    "    port = host if port.nil?\n" ++
    "    @host = \"0.0.0.0\"\n" ++
    "    @port = port.to_i\n" ++
    "    fd = Socket.__listen(@port)\n" ++
    "    raise Errno::EADDRINUSE, \"Address already in use - bind(2) for port #\{port}\" if fd < 0\n" ++
    "    @port = Socket.__port(fd) if @port == 0\n" ++
    "    __setup(fd)\n" ++
    "  end\n" ++
    "  def accept\n" ++
