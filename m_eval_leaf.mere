    "  private :__chop_basename\n" ++
    "\n" ++
    "  def +(other)\n" ++
    "    Pathname.new(__plus(@path, other.to_s))\n" ++
    "  end\n" ++
    "\n" ++
    "  def __plus(path1, path2)\n" ++
    "    prefix2 = path2\n" ++
    "    index_list2 = []\n" ++
    "    basename_list2 = []\n" ++
    "    while (r2 = __chop_basename(prefix2))\n" ++
    "      prefix2, basename2 = r2\n" ++
    "      index_list2.unshift(prefix2.length)\n" ++
    "      basename_list2.unshift(basename2)\n" ++
    "    end\n" ++
    "    return path2 if prefix2 != \"\"\n" ++
    "    prefix1 = path1\n" ++
    "    while true\n" ++
    "      while !basename_list2.empty? && basename_list2.first == \".\"\n" ++
    "        index_list2.shift\n" ++
    "        basename_list2.shift\n" ++
    "      end\n" ++
    "      break unless (r1 = __chop_basename(prefix1))\n" ++
    "      prefix1, basename1 = r1\n" ++
    "      next if basename1 == \".\"\n" ++
    "      if basename1 == \"..\" || basename_list2.empty? || basename_list2.first != \"..\"\n" ++
    "        prefix1 = prefix1 + basename1\n" ++
    "        break\n" ++
    "      end\n" ++
    "      index_list2.shift\n" ++
    "      basename_list2.shift\n" ++
    "    end\n" ++
    "    r1 = __chop_basename(prefix1)\n" ++
    "    if !r1 && (r1 = File.basename(prefix1).include?(\"/\"))\n" ++
    "      while !basename_list2.empty? && basename_list2.first == \"..\"\n" ++
    "        index_list2.shift\n" ++
    "        basename_list2.shift\n" ++
    "      end\n" ++
    "    end\n" ++
    "    if !basename_list2.empty?\n" ++
    "      suffix2 = path2[index_list2.first..-1]\n" ++
    "      r1 ? File.join(prefix1, suffix2) : prefix1 + suffix2\n" ++
    "    else\n" ++
    "      r1 ? prefix1 : File.dirname(prefix1)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  private :__plus\n" ++

    "  alias / +\n" ++
    "  alias === ==\n" ++
    "  def empty?\n" ++
    "    File.directory?(@path) ? Dir.empty?(@path) : File.empty?(@path)\n" ++
    "  end\n" ++
    "  def join(*others)\n" ++
    "    others.inject(self) do |acc, o|\n" ++
    "      acc + o\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def basename(*args)\n" ++
    "    Pathname.new(File.basename(@path, *args))\n" ++
    "  end\n" ++
    "  def dirname\n" ++
    "    Pathname.new(File.dirname(@path))\n" ++
    "  end\n" ++
    "  def parent\n" ++
    "    dirname\n" ++
    "  end\n" ++
    "  def extname\n" ++
    "    File.extname(@path)\n" ++
    "  end\n" ++
    "  def expand_path(*args)\n" ++
    "    Pathname.new(File.expand_path(@path, *args))\n" ++
    "  end\n" ++
    "  def absolute?\n" ++
    "    @path.start_with?(\"/\")\n" ++
    "  end\n" ++
    "  def relative?\n" ++
    "    !absolute?\n" ++
    "  end\n" ++
    "  def root?\n" ++
    "    @path == \"/\"\n" ++
    "  end\n" ++
    "  def exist?\n" ++
    "    File.exist?(@path)\n" ++
    "  end\n" ++
    "  def file?\n" ++
    "    File.file?(@path)\n" ++
    "  end\n" ++
    "  def directory?\n" ++
    "    Dir.exist?(@path)\n" ++
    "  end\n" ++
    "  def size\n" ++
    "    File.size(@path)\n" ++
    "  end\n" ++
    "  def read(*args)\n" ++
    "    File.read(@path, *args)\n" ++
    "  end\n" ++
    "  def readlines(*args)\n" ++
    "    File.readlines(@path, *args)\n" ++
    "  end\n" ++
    "  def binread(*args)\n" ++
    "    File.read(@path, *args)\n" ++
    "  end\n" ++
    "  def write(content)\n" ++
    "    File.write(@path, content)\n" ++
    "  end\n" ++
    "  def open(*args, &block)\n" ++
    "    File.open(@path, *args, &block)\n" ++
    "  end\n" ++
    "  def each_line(&block)\n" ++
    "    readlines.each(&block)\n" ++
    "  end\n" ++
    "  def unlink\n" ++
    "    File.delete(@path)\n" ++
    "  end\n" ++
    "  def delete\n" ++
    "    unlink\n" ++
    "  end\n" ++
    "  def mkdir\n" ++
    "    Dir.mkdir(@path)\n" ++
    "  end\n" ++
    "  def mkpath\n" ++
    "    Dir.mkdir(@path)\n" ++
    "    self\n" ++
    "  end\n" ++
    "  def sub(*args, &block)\n" ++
    "    Pathname.new(@path.sub(*args, &block))\n" ++
    "  end\n" ++
    "  def sub_ext(repl)\n" ++
    "    ext = File.extname(@path)\n" ++
    "    base = ext.empty? ? @path : @path[0, @path.length - ext.length]\n" ++
    "    Pathname.new(base + repl)\n" ++
    "  end\n" ++
    "  def split\n" ++
    "    [dirname, basename]\n" ++
    "  end\n" ++
    "  def each_filename\n" ++
    "    @path.split(\"/\").each do |seg|\n" ++
    "      yield seg unless seg.empty?\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def children\n" ++
    "    Dir.children(@path).sort.map do |c|\n" ++
    "      self + c\n" ++
    "    end\n" ++
    "  end\n" ++
    "  def entries\n" ++
    "    Dir.entries(@path).sort.map do |c|\n" ++
    "      Pathname.new(c)\n" ++
    "    end\n" ++
    "  end\n" ++
    "  # both globs take Dir.glob's flags, and with a block yield each match\n" ++
    "  # and answer nil\n" ++
    "  def glob(pattern, flags = 0, &blk)\n" ++
    "    found = Dir.glob(pattern, flags, base: @path).map do |c|\n" ++
    "      self + c\n" ++
    "    end\n" ++
    "    return found unless blk\n" ++
    "    found.each(&blk)\n" ++
    "    nil\n" ++
    "  end\n" ++
    "  def self.glob(pattern, flags = 0, base: nil, &blk)\n" ++
    "    found = (base ? Dir.glob(pattern, flags, base: base) : Dir.glob(pattern, flags)).map \{ |c| new(c) }\n" ++
    "    return found unless blk\n" ++
    "    found.each(&blk)\n" ++
    "    nil\n" ++
    "  end\n" ++
    "  def birthtime = File.birthtime(@path)\n" ++
    "  def cleanpath\n" ++
    "    parts = []\n" ++
    "    abs = @path.start_with?(\"/\")\n" ++
    "    @path.split(\"/\").each do |seg|\n" ++
    "      next if seg.empty?\n" ++
    "      next if seg == \".\"\n" ++
    "      if seg == \"..\" && !parts.empty? && parts.last != \"..\"\n" ++
    "        parts.pop\n" ++
    "      else\n" ++
    "        parts.push(seg)\n" ++
    "      end\n" ++
    "    end\n" ++
    "    out = parts.join(\"/\")\n" ++
    "    out = \"/\" + out if abs\n" ++
    "    out = \".\" if out.empty?\n" ++
    "    Pathname.new(out)\n" ++
    "  end\n" ++
    "  def realpath\n" ++
    "    expand_path\n" ++
    "  end\n" ++
    "  # realpath, where the last component need not exist\n" ++
    "  def realdirpath(base = nil)\n" ++
