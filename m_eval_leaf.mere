    "    end\n" ++
    "    base_prefix = base_directory\n" ++
    "    base_names = []\n" ++
    "    while (r = __chop_basename(base_prefix))\n" ++
    "      base_prefix, basename = r\n" ++
    "      base_names.unshift basename if basename != \".\"\n" ++
    "    end\n" ++
