    "class TCPSocket < IPSocket\n" ++
    "  def initialize(host = nil, port = nil, local_host = nil, local_port = nil)\n" ++
    "    @host = host\n" ++
    "    @port = port\n" ++
    "    fd = Socket.__connect(host.to_s, port.to_i)\n" ++
