    "  end\n" ++
    "  alias_method :member?, :include?\n" ++
    "  alias_method :===, :include?\n" ++
    "\n" ++
    "  def add(o)\n" ++
    "    __modify!\n" ++
    "    if __iterating? && !include?(o)\n" ++
    "      raise RuntimeError, \"can't add a new item into set during iteration\"\n" ++
    "    end\n" ++
    "    @hash[o] = true\n" ++
    "    self\n" ++
    "  end\n" ++
