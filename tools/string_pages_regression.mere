let require = fn (ok: bool) -> fn (message: str) -> if ok then () else fail message;
let handle = fn v -> match v with VStr n -> n;
let first = handle (mkstr "");
let second = handle (mkstr "retained");
let keep = vec_new ();
let _ = vec_push keep 0;
let _ = vec_push keep 1;
let rec fill = fn (n: int) -> if n <= 0 then () else (let _ = mkstr "discarded" in fill (n - 1));
let rec rounds = fn (n: int) ->
  if n <= 0 then () else
  (let before = str_count () in
   let _ = fill 8192 in
   let last = str_count () - 1 in
   let _ = require (last > before) "handles must increase" in
   let _ = str_pages_sweep keep 2 false in
   let _ = require (map_len str_store == 2) "dead page descriptors retained" in
   let _ = require (map_len str_pg_bytes == 2 && map_len str_pg_changed == 2) "dead page metadata retained" in
   let _ = require (str_eq (sraw first) "") "live empty string lost" in
   let _ = require (str_eq (sraw second) "retained") "live string lost" in
   let _ = require (str_eq (sraw (handle_base + last)) "discarded") "current partial page removed" in
   let _ = require (str_count () == last + 1) "watermark rewound" in
   let _ = require (str_bytes () >= 0) "negative page bytes" in
   rounds (n - 1));
let _ = rounds 200;
let _ = require (str_eq (sraw (handle_base + 4096)) "") "dead handle aliases reused payload";
let _ = sput (handle_base + 4096) "resurrected";
let _ = require (str_eq (sraw (handle_base + 4096)) "") "dead page resurrected";
let _ = sput second "changed";
let _ = require (str_eq (sraw second) "changed") "live mutation lost";
let joined = handle (mkstr_join (Cons ("joined", Cons (" text", Nil))));
let _ = require (str_eq (sraw joined) "joined text") "joined string lost";
let _ = print "sparse pages preserve handles, empty strings, mutation, partial pages and watermarks";
0
