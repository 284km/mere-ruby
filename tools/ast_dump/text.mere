// The text form of a translated tree, a node a line, as
// tools/ast_on_cruby.rb's `text` prints the reference's (AstOracle.text):
// what tools/ast_dump writes and tools/ast_text_diff.rb compares. It is here
// and not in m_ast_out.mere because only this tool prints trees; the
// interpreter makes Node objects from them (m_ast_obj.mere).
let ao_hex_digit = fn (d: int) -> substring "0123456789abcdef" d (d + 1);
let rec ao_hex = fn (v: int) -> if v < 16 then ao_hex_digit v else ao_hex (v / 16) ++ ao_hex_digit (v % 16);
let ao_hex8 = fn (v: int) ->
  let h = ao_hex v in
  substring "00000000" 0 (8 - str_len h) ++ h;
let ao_hex_str = fn (s: str) -> hex_of_bytes (bytes_of_str s);
// an Integer by its words in pm_ig
let ao_int_text = fn (neg: int) -> fn (ig: int) ->
  let n = vec_get pm_ig (ig + 1) in
  let rec go = fn (i: int) -> fn (acc: str) -> fn (lead: bool) ->
    if i < 0 then (if lead then "0" else acc)
    else (let w = vec_get pm_ig (ig + 2 + i) in
          if lead && w == 0 then go (i - 1) acc true
          else go (i - 1) (acc ++ (if lead then ao_hex w else ao_hex8 w)) false) in
  let h = go (n - 1) "" true in
  "I" ++ (if neg == 1 && (if str_eq h "0" then false else true) then "-" else "") ++ h;
// (an Integer of pm_ig as a machine integer, its sign aside; -1 when it has
//  more than 62 bits)
let ao_int_small = fn (ig: int) ->
  let n = vec_get pm_ig (ig + 1) in
  if n == 0 then 0
  else if n == 1 then vec_get pm_ig (ig + 2)
  else if n == 2 && vec_get pm_ig (ig + 3) < 1073741824 then vec_get pm_ig (ig + 3) * 4294967296 + vec_get pm_ig (ig + 2)
  else 0 - 1;
let rec ao_gcd = fn (a: int) -> fn (b: int) -> if b == 0 then a else ao_gcd b (a % b);
// a Rational: Prism gives the literal's digits over a power of ten, ruby
// answers it in lowest terms
let ao_rational_text = fn (num: int) -> fn (den: int) ->
  let a = ao_int_small num in
  let b = ao_int_small den in
  if a < 0 || b <= 0 then "R" ++ ao_int_text (vec_get pm_ig num) num ++ "/" ++ ao_int_text 0 den
  else (let g = ao_gcd a b in
        "RI" ++ (if vec_get pm_ig num == 1 && a != 0 then "-" else "") ++ ao_hex (a / g) ++ "/I" ++ ao_hex (b / g));
let ao_sym_plain = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) ->
    if i >= n then true
    else (let c = ord (char_at s i) in
          // printable, and none of [ ] , * (which the text form itself uses)
          if c < 33 || c > 126 || c == 91 || c == 93 || c == 44 || c == 42 then false else go (i + 1)) in
  n > 0 && go 0;
let rec ao_lit_text = fn (l: int) ->
  let k = vec_get ao_l l in
  if k == 1 then ao_int_text (vec_get ao_l (l + 1)) (vec_get ao_l (l + 2))
  else if k == 2 then "F" ++ ao_hex8 (vec_get ao_l (l + 1)) ++ ao_hex8 (vec_get ao_l (l + 2))
  else if k == 3 then ao_rational_text (vec_get ao_l (l + 1)) (vec_get ao_l (l + 2))
  else if k == 4 then "C" ++ ao_lit_text (vec_get ao_l (l + 1))
  else if k == 5 then "S(" ++ ao_enc_name (vec_get ao_l (l + 2)) ++ ")" ++ ao_hex_str (vec_get ao_s (vec_get ao_l (l + 1)))
  else if k == 6 then "X(" ++ ao_enc_name (vec_get ao_l (l + 3)) ++ "," ++ str_of_int (vec_get ao_l (l + 2)) ++ ")" ++ ao_hex_str (vec_get ao_s (vec_get ao_l (l + 1)))
  else "E(" ++ vec_get ao_s (vec_get ao_l (l + 1)) ++ ")";
let ao_loc_text = fn (b: int) -> fn (e: int) ->
  if b < 0 then "nil"
  else str_of_int (ao_lineno b) ++ ":" ++ str_of_int (ao_column b) ++ "-" ++ str_of_int (ao_lineno e) ++ ":" ++ str_of_int (ao_column e);
// The tree under `root` into `out`, a node a line. `names` is ao_type_names
// split. `locs`: with the other locations.
let ao_text = fn out -> fn names -> fn (root: int) -> fn (locs: bool) ->
  let rec kid = fn (k: int) -> fn kids ->
    (let t = k_tag k in
     let v = k_val k in
     if t == 0 then strbuf_push out "nil"
     else if t == 1 then (let _ = vec_push kids v in strbuf_push out "*")
     else if t == 2 then
       (let s = vec_get ao_s v in
        strbuf_push out (if ao_sym_plain s then ":" ++ s else ":x" ++ ao_hex_str s))
     else if t == 3 then strbuf_push out ("I" ++ ao_hex v)
     else if t == 4 then strbuf_push out (ao_lit_text v)
     else if t == 5 then strbuf_push out (if v == 1 then "true" else "false")
     else
       (let n = vec_get ao_a v in
        let _ = strbuf_push out "[" in
        let rec each = fn (i: int) ->
          if i >= n then ()
          else (let _ = (if i > 0 then strbuf_push out "," else ()) in
                let _ = kid (vec_get ao_a (v + 1 + i)) kids in
                each (i + 1)) in
        let _ = each 0 in
        strbuf_push out "]")) in
  let rec node = fn (r: int) -> fn (depth: int) ->
    region AOT {
      let kids = vec_new () in
      let _ = strbuf_push out (str_repeat " " depth) in
      let _ = strbuf_push out (vec_get names (a_ty r)) in
      let _ = strbuf_push out " " in
      let _ = strbuf_push out (ao_loc_text (a_beg r) (a_end r)) in
      let _ = ao_children r in
      let nk = vec_len ao_k in
      let rec each = fn (i: int) ->
        if i >= nk then ()
        else (let _ = strbuf_push out " " in
              let _ = kid (vec_get ao_k i) kids in
              each (i + 1)) in
      let _ = each 0 in
      let x = vec_get ao_n (r + 3) in
      let _ = (if locs && x != 0 && vec_get ao_x x > 0 then
                 (let nx = vec_get ao_x x in
                  let _ = strbuf_push out " @" in
                  let rec xs = fn (i: int) ->
                    if i >= nx then ()
                    else (let _ = (if i > 0 then strbuf_push out ";" else ()) in
                          let _ = strbuf_push out (ao_loc_text (vec_get ao_x (x + 1 + i * 2)) (vec_get ao_x (x + 2 + i * 2))) in
                          xs (i + 1)) in
                  xs 0)
               else ()) in
      let _ = strbuf_push out "\n" in
      let nkids = vec_len kids in
      let rec sub = fn (i: int) ->
        if i >= nkids then () else (let _ = node (vec_get kids i) (depth + 1) in sub (i + 1)) in
      sub 0
    } in
  node root 0;
