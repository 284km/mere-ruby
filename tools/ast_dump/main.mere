// The Mere translator from Prism's tree to parse.y's, alone: the text form
// of each program's tree, as tools/ast_on_cruby.rb's `text` prints the
// reference's -- so the two can be compared over every file test_ast reads
// in a few seconds, with no mere-ruby build in the loop.
//
//   sh tools/ast_dump/build.sh                 # -> tools/ast_dump/ast_dump
//   tools/ast_dump/ast_dump [--locations] [--tolerant] --out DIR FILE...
//   tools/ast_dump/ast_dump [--locations] [--tolerant] FILE     (to stdout)
//
// --tolerant: the tree of a program that does not parse, as
// RubyVM::AbstractSyntaxTree.parse(src, error_tolerant: true) answers it.
//
// It is the same m_prism_dec.mere / m_ast.mere mere-ruby compiles, over the
// same libprism.
import "../../m_prism_dec.mere";
import "../../m_prism_nodes.mere";
import "../../m_ast_out.mere";
import "../../m_ast.mere";
import "text.mere";

extern fn prism_ser: int -> bytes -> bytes -> bytes;

let rec str_tr_slash = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else str_tr_slash s (i + 1) (acc ++ (if str_eq (char_at s i) "/" then "_" else char_at s i));

// (debug) every child's record comes after its parent's
let rec check_tree = fn (r: int) ->
  let ty = vec_get pm_nd r in
  let base = ty * 16 in
  let rec fields = fn (j: int) ->
    (let k = vec_get prism_sch_k (base + j) in
     if k == 0 then ()
     else
       (let o = r + vec_get prism_sch_o (base + j) in
        let _ = (if k == 110 || k == 78 then
                   (let c = vec_get pm_nd o in
                    if c == 0 then ()
                    else if c <= r then print ("BAD child " ++ str_of_int c ++ " of " ++ str_of_int r ++ " type " ++ str_of_int ty ++ " field " ++ str_of_int j)
                    else check_tree c)
                 else if k == 76 then
                   (let l = vec_get pm_nd o in
                    let n = pm_ls_len l in
                    let rec each = fn (i: int) ->
                      if i >= n then ()
                      else (let c = pm_ls_at l i in
                            let _ = (if c <= r then print ("BAD list child " ++ str_of_int c ++ " of " ++ str_of_int r ++ " type " ++ str_of_int ty ++ " field " ++ str_of_int j ++ " l=" ++ str_of_int l ++ " i=" ++ str_of_int i)
                                     else check_tree c) in
                            each (i + 1)) in
                    each 0)
                 else ()) in
        fields (j + 1))) in
  fields 0;

// (where the last token of `src` ends: after its last byte that is no blank)
let rec last_token_end = fn (src: str) -> fn (i: int) ->
  if i <= 0 then 0
  else (let c = ord (char_at src (i - 1)) in
        if c == 32 || c == 9 || c == 10 || c == 13 then last_token_end src (i - 1) else i);

let dump_one = fn (path: str) -> fn (locs: bool) -> fn (tolerant: bool) -> fn (outdir: str) -> fn names ->
  region ONE {
    let srcb = read_bytes path in
    let src = str_of_bytes srcb in
    // (the options pm_options_read reads: no filepath, line 1, no encoding,
    //  version 3 = CRuby 4.0's grammar, no scopes)
    let opts = bytes_of_hex "0000000001000000000000000000030000000000000000" in
    let ser = prism_ser 0 srcb opts in
    let out = strbuf_new () in
    let ok = pm_decode ser src in
    let _ = (if ok && (match env_var "AST_DUMP_CHECK" with Some v -> str_eq v "1" | None -> false) then check_tree (pm_root ()) else ()) in
    let _ = (if ok then
               (if vec_len pm_er > 0 && (if tolerant then false else true) then strbuf_push out "SyntaxError\n"
                else
                  // (error_tolerant: the tree of a program that did not parse)
                  (let _ = (if vec_len pm_er > 0 then vec_set pm_hd 6 (last_token_end src (str_len src)) else ()) in
                   let root = ast_translate () in
                   ao_text out names root locs))
             else strbuf_push out "UNDECODABLE\n") in
    if str_eq outdir "" then print_no_nl (strbuf_to_str out)
    else write_file (outdir ++ "/" ++ str_tr_slash path 0 "" ++ ".ast") (strbuf_to_str out)
  };

let main_go = fn (u: unit) ->
  let names = vec_new () in
  let _ = list_iter (str_split (ao_type_names ()) " ") (fn (nm: str) -> vec_push names nm) in
  let rec go = fn (xs: str list) -> fn (locs: bool) -> fn (tolerant: bool) -> fn (outdir: str) ->
    match xs with
    | Nil -> ()
    | Cons ("--locations", t) -> go t true tolerant outdir
    | Cons ("--tolerant", t) -> go t locs true outdir
    | Cons ("--out", Cons (d, t)) -> go t locs tolerant d
    | Cons (f, t) -> (let _ = dump_one f locs tolerant outdir names in go t locs tolerant outdir) in
  go (args ()) false false "";

main_go ()
