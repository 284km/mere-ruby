// Exercise the reusable table without the Ruby evaluator or test adapter.
type Val = VInt of int | VNil;
import "../../m_native_handles.mere";
extern fn mr_probe_echo_token: int -> int;
let check = fn (ok: bool) -> fn (name: str) -> if ok then () else fail name;
let value_is = fn (h: int) -> fn (n: int) ->
  match native_handle_get h with VInt v -> v == n | _ -> false;
let a = native_handle_retain (VInt 41);
let b = native_handle_retain VNil;
let _ = check (native_handle_valid b) "nil must have a valid handle";
let _ = check (native_handle_count () == 2) "live count";
let a_slot = map_get native_handle_ids a;
let _ = check (native_handle_release a) "release live";
let _ = check (if native_handle_release a then false else true) "double release refused";
let c = native_handle_retain (VInt 42);
let _ = check (c != a && map_get native_handle_ids c == a_slot) "slot reused without reissuing token";
let _ = check (try_or (fn (u: unit) -> let _ = native_handle_get a in false) true) "old token must not fetch new value";
let _ = check (if native_handle_update a (VInt 99) then false else true) "stale update refused";
let _ = check (value_is c 42) "stale update preserved new value";
let _ = check (native_handle_update c (VInt 43) && value_is c 43) "live update";
let _ = check (if native_handle_valid 0 || native_handle_valid (0 - 1) || native_handle_valid 4294967297 then false else true) "no FFI narrowing before validation";
let _ = check (native_handle_release b && native_handle_release c) "release all";
let rec churn = fn (n: int) ->
  if n == 0 then ()
  else let h = native_handle_retain (VInt n) in
       let _ = check (value_is h n && native_handle_release h) "churn" in
       churn (n - 1);
let _ = churn 10000;
let _ = native_handle_compact ();
let _ = check (native_handle_count () == 0 && native_handle_capacity () == 2) "storage bounded by peak simultaneous handles";
// A fresh process can move the private counter to the boundary to exercise
// exhaustion; the runtime exposes no reset or counter setter to Ruby/C.
let _ = vec_set native_handle_counters 0 (native_handle_max - 1);
let last1 = native_handle_retain (VInt 1);
let last2 = native_handle_retain (VInt 2);
let _ = check (mr_probe_echo_token last1 == 2147483646 && mr_probe_echo_token last2 == 2147483647) "last signed 32-bit tokens cross C";
let _ = check (native_handle_retain (VInt 3) == 0 && native_handle_count () == 2) "exhaustion is atomic";
let _ = check (value_is last1 1 && value_is last2 2) "exhaustion preserves existing roots";
let _ = check (native_handle_release last1 && native_handle_release last2) "exhausted table can release";
let _ = check (native_handle_retain VNil == 0 && native_handle_count () == 0) "released storage cannot wrap token counter";
print "native handle table: passed (reuse, stale ids, nil, 10000 churn, C int32 boundary, exhaustion)"
