// Synchronous, interpreter-thread-only investigation protocol. All VALUEs
// are rooted tokens. No Ruby value pointer or raw C string crosses a callback.
type native_request = { op: int, recv: int, mid: int, argc: int, a0: int, a1: int };
extern fn mr_native_invoke: (native_request -> int) -> int -> int -> int -> int -> int;
extern fn mr_native_load: str -> int;
extern fn mr_native_error: unit -> str;
extern fn mr_native_find: str -> int;
extern fn mr_native_arity: int -> int;
extern fn mr_native_method_name: int -> str;
extern fn mr_native_resources: unit -> int;
extern fn mr_native_depth: unit -> int;
extern fn mr_native_ensures: unit -> int;

extern fn mr_typed_load: str -> int;
extern fn mr_typed_error: unit -> str;
extern fn mr_typed_find: str -> int;
extern fn mr_typed_class_name: int -> str;
extern fn mr_typed_text: unit -> str;
extern fn mr_typed_mark: (int -> int) -> int -> int;
extern fn mr_typed_free: int -> int;
extern fn mr_typed_stat: int -> int;

extern fn mr_typed_class_index: str -> int;
extern fn mr_typed_method_name: int -> str;
extern fn mr_typed_method_info: int -> int -> int;
extern fn mr_typed_loader_stat: int -> int;
