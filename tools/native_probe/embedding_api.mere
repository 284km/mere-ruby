// Experimental singleton embedding lifecycle. Ruby exceptions are recorded as
// metadata and return status 1; status 2 means the lifecycle refuses the call.
// A protected exception remains pending until clear_error or cleanup. Reading
// exception metadata never handles it, and eval refuses to overwrite it.
// No Ruby signal disposition is installed here. Hosts serialize all API calls.
// An explicit Ruby exit!/exec remains process control, not a protected exception.
let vm_phase = map_new ();
let vm_error = map_new ();
let vm_exit_code = map_new ();
let vm_finish_locals = fn () ->
  if map_has top_env_reg 0 && map_has tl_decl "v" then
    (let env = map_get top_env_reg 0 in
     let rec finish = fn (names: str list) -> match names with
       | Nil -> ()
       | Cons (name, rest) ->
         (let _ = (if str_len name == 0 || lv_has env name then ()
                   else lv_set env name VNil) in finish rest) in
     finish (str_split (map_get tl_decl "v") (chr 10)))
  else ();
let vm_clear_pending = fn () ->
  let _ = map_delete ivars_g "$exc" in
  let _ = map_clear prim_missing in
  let _ = map_clear flow_sig in
  let _ = map_clear raise_bt in
  let _ = map_set globals "!" VNil in
  let _ = map_delete cli_opt "synerr" in
  let _ = map_delete cli_opt "synmsg" in
  let _ = map_clear vm_error in
  let _ = map_clear vm_exit_code in ();
// Reporting must not invoke Ruby methods: even Exception#inspect may raise.
// Read stored class/message data so diagnostics cannot replace the exception
// or strand the lifecycle in its busy phase.
let vm_record_diagnostic = fn world -> fn (exc: Val) ->
  let cls = exc_cls_of world exc in
  let message = (match exc with
    | VExc (_, text) -> text
    | VObj id ->
      (let key = str_of_int id ++ "@__exception_message" in
       match (if map_has ivars_g key then map_get ivars_g key else VNil) with
       | VStr h -> sget h | _ -> "")
    | _ -> "") in
  map_set vm_error "diagnostics"
    ((if map_has vm_error "diagnostics" then map_get vm_error "diagnostics" else "")
     ++ cls ++ (if str_eq message "" then "" else ": " ++ message) ++ "\n");
let vm_capture_error = fn (message: str) ->
  let world = (meths_g, cls_sup, obj_cls, ivars_g) in
  let _ = note_extern_refused message in
  let exc = try_or_msg (fn (u: unit) -> pending_exc world)
    (fn (text: str) -> if map_has ivars_g "$exc" then map_get ivars_g "$exc"
                       else VExc ("StandardError", text)) in
  // Primitive refusals can synthesize an exception without publishing it.
  // Keep the actual value rooted and visible to exit hooks through $!.
  let _ = map_set ivars_g "$exc" exc in
  let _ = map_set globals "!" exc in
  let _ = map_clear prim_missing in
  let _ = map_clear flow_sig in
  let cls = exc_cls_of world exc in
  let is_exit = thr_exc_is_exit world exc in
  let _ = map_set vm_error "class" cls in
  let _ = map_set vm_error "pending" "yes" in
  let _ = (if is_exit then () else vm_record_diagnostic world exc) in
  let _ = map_set vm_exit_code "status"
    (if is_exit then match exc with
     | VObj id -> (match (if map_has ivars_g (str_of_int id ++ "@__status") then map_get ivars_g (str_of_int id ++ "@__status") else VNil) with VInt n -> n | _ -> 1)
     | _ -> 1 else 1) in
  let _ = (if fb_live () > 0 then () else vec_set gc_knob 7 0) in
  1;
let vm_setup = fn () ->
  let phase = (if map_has vm_phase "v" then map_get vm_phase "v" else 0) in
  if phase == 1 then 0 else if phase > 1 then 2 else
  let _ = map_set vm_phase "v" 2 in
  let result = try_or_msg (fn (u: unit) ->
    // Give frequently overwritten metadata its own reclaimable storage.
    let _ = map_compact fsl_ctx in
    let _ = map_compact tl_decl in
    let _ = map_compact gc_hold in
    let _ = map_compact gc_state in
    let _ = map_compact gc_live_cls in
    let _ = map_compact fb_off_fn in
    let _ = map_compact lvt_names in
    let _ = vm_clear_pending () in
    let env = map_new () in
    let _ = map_compact env in
    let _ = map_set top_env_reg 0 env in
    let _ = map_set load_ctx "dir" (mkstr ".") in
    let _ = map_set load_ctx "file" (mkstr "(embedded)") in
    let _ = map_set load_ctx "cwd0" (mkstr (proc_cwd ())) in
    let _ = map_set load_ctx "coding" (mkstr "UTF-8") in
    let _ = driver_setup env "" "(embedded)" in 0) vm_capture_error in
  let _ = map_set vm_phase "v" (if result == 0 then 1 else 4) in result;
let vm_eval = fn (source: str) ->
  // Persistent stores copy retained values before this call region closes.
  region EVALUATION {
  if (if map_has vm_phase "v" then map_get vm_phase "v" else 0) != 1 || map_has vm_error "pending" then 2 else
  let _ = map_set vm_phase "v" 2 in
  let _ = vm_clear_pending () in
  let result = try_or_msg (fn (u: unit) ->
    let _ = run_src_mode true source false "(embedded)" in 0) vm_capture_error in
  // Complete missing local cells after evaluation, including protected errors.
  // Before the first assignment, a bare identifier may still call a method;
  // eagerly inserting nil would incorrectly shadow that lexical method call.
  let _ = vm_finish_locals () in
  // Reclaim the replaced metadata after both normal and protected exits.
  let _ = map_compact fsl_ctx in
  let _ = map_compact tl_decl in
  let _ = map_compact gc_hold in
  let _ = map_compact gc_state in
  let _ = map_compact gc_live_cls in
  let _ = map_compact fb_off_fn in
  let _ = map_compact lvt_names in
  let _ = map_set vm_phase "v" 1 in result };
// Explicit host acknowledgement also resets Ruby's pending exception state.
let vm_clear_error = fn () ->
  if (if map_has vm_phase "v" then map_get vm_phase "v" else 0) != 1 then 2
  else (let _ = vm_clear_pending () in 0);
// OpenSSL owns C allocations outside Mere regions. Release only this VM's
// registered owners, after hooks and thread teardown can no longer use them.
let vm_release_native = fn () ->
  let _ = mr_nkf_cleanup () in
  let _ = map_iter openssl_owned (fn (_owner: int) -> fn (handle: int) ->
    let _ = mr_ossl_release handle in ()) in
  let _ = map_clear openssl_owned in
  map_clear openssl_owner;
let vm_cleanup = fn () ->
  let phase = (if map_has vm_phase "v" then map_get vm_phase "v" else 0) in
  if phase == 3 then (if map_has vm_exit_code "cleanup" then map_get vm_exit_code "cleanup" else 0)
  else if phase != 1 && phase != 4 then 2 else
  let _ = map_set vm_phase "v" 2 in
  // Keep the pending error visible to at_exit through $!. Its saved status
  // applies only when no later hook failure or SystemExit replaces it.
  let pending_status = (if map_has vm_exit_code "status" then map_get vm_exit_code "status" else 0) in
  let world = (meths_g, cls_sup, obj_cls, ivars_g) in
  let terminated = vec_new () in
  let _ = vec_push terminated false in
  let result = try_or_msg (fn (u: unit) ->
    let status = (if phase == 4 then 0 - 1 else
      run_at_exits_r world (fn (exc: Val) ->
        let _ = map_set vm_error "class" (exc_cls_of world exc) in
        vm_record_diagnostic world exc)) in
    let _ = sch_terminate_all world in
    let _ = vec_set terminated 0 true in
    let signal = (if map_has at_exit_sig "s" then map_get at_exit_sig "s" else 0) in
    if signal > 0 then 128 + signal else if status >= 0 then status else pending_status)
    (fn (message: str) -> let _ = vm_capture_error message in
      if map_has vm_exit_code "status" then map_get vm_exit_code "status" else 1) in
  // A protected failure in hooks must not skip teardown. Native resources
  // are drained even when scheduler termination itself reports a failure.
  let result = (if vec_get terminated 0 then result else
    try_or_msg (fn (u: unit) -> let _ = sch_terminate_all world in result)
      (fn (message: str) -> let _ = vm_capture_error message in
        if map_has vm_exit_code "status" then map_get vm_exit_code "status" else 1)) in
  let result = try_or_msg (fn (u: unit) -> let _ = vm_release_native () in result)
    (fn (message: str) -> let _ = vm_capture_error message in
      if map_has vm_exit_code "status" then map_get vm_exit_code "status" else 1) in
  let _ = map_set vm_exit_code "cleanup" result in
  let _ = map_set vm_phase "v" 3 in result;
let vm_error_class = fn () -> if map_has vm_error "class" then map_get vm_error "class" else "";
let vm_error_diagnostics = fn () -> if map_has vm_error "diagnostics" then map_get vm_error "diagnostics" else "";
let vm_exception_status = fn () -> if map_has vm_exit_code "status" then map_get vm_exit_code "status" else 0;
