// tools/iseq/native/dump.mere -- the native ISeq compiler run on what
// tools/iseq/native/expect.rb wrote (note 552 §11):
//
//   dump <dir> <label> <n> <path> [<n> <path> ...]
//
// reads <dir>/<n>.pm (Prism's serialized tree) and the source at <path>,
// compiles it and writes <dir>/<n>.got -- the sequences as text, or
// "REFUSED: why" -- to be compared with <dir>/<n>.exp.
import "../../../ic/m_ic_nodes.mere";

let nd_one = fn (dir: str) -> fn (label: str) -> fn (n: str) -> fn (path: str) ->
  let text =
    region NDF {
      let ser = bytes_of_vec (read_file_bytes (dir ++ "/" ++ n ++ ".pm")) in
      let src = bytes_of_vec (read_file_bytes path) in
      let meta = vec_new () in
      let rec fill = fn (i: int) -> if i <= 0 then () else (let _ = vec_push meta 0 in fill (i - 1)) in
      let _ = fill 11 in
      let tr = (ser, src, vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), meta) in
      let es = (vec_new (), vec_new (), vec_new (), vec_new (), vec_new ()) in
      let us = (vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new ()) in
      let cx = (tr, es, us) in
      let why = ic_tree_load tr in
      if (if str_eq why "" then false else true) then "REFUSED: " ++ why ++ "\n"
      else if vec_get meta 3 > 0 then "SYNTAX\n"
      else
        try_or_msg (fn (x: unit) -> ic_canon (ic_to_a cx (ic_compile cx path label)) 0 ++ "\n")
                   (fn (m: str) ->
                      (let k = str_index_of m "IC-REFUSED: " in
                       if k >= 0 then "REFUSED: " ++ substring m (k + 12) (str_len m) ++ "\n"
                       else "FAILED: " ++ m ++ "\n"))
    } in
  write_file (dir ++ "/" ++ n ++ ".got") text;

let nd_main = fn (u: unit) ->
  match args () with
  | Cons (dir, Cons (label, rest)) ->
    (let rec go = fn (xs: str list) ->
       (match xs with
        | Cons (n, Cons (path, t)) -> (let _ = nd_one dir label n path in go t)
        | _ -> ()) in
     go rest)
  | _ -> print "usage: dump <dir> <label> <n> <path> ...";
let _ = nd_main ();
