// tools/iseq/native/tree_dump.mere -- the native compiler's reading of a
// serialized tree, a line a node: what tools/iseq/native/tree_expect.rb
// prints of Prism's own.
//   tree_dump <file.pm> <file.rb>
import "../../../m_ic_tree.mere";

let td_main = fn (u: unit) ->
  match args () with
  | Cons (pm, Cons (rb, _)) ->
    (let ser = bytes_of_vec (read_file_bytes pm) in
     let src = bytes_of_vec (read_file_bytes rb) in
     let meta = vec_new () in
     let rec fill = fn (i: int) -> if i <= 0 then () else (let _ = vec_push meta 0 in fill (i - 1)) in
     let _ = fill 8 in
     let tr = (ser, src, vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), vec_new (), meta) in
     let why = ic_tree_load tr in
     let cx = (tr, 0, 0) in
     if (if str_eq why "" then false else true) then print ("REFUSED: " ++ why)
     else
       (let n = vec_len (ic_nodes cx) / 6 in
        let _ = print ("encoding " ++ ic_enc cx ++ " errors " ++ str_of_int (vec_get meta 3)) in
        let rec go = fn (i: int) ->
          if i >= n then ()
          else
            (let _ = print (ic_type_name (ic_ty cx i) ++ " " ++ str_of_int (ic_nid cx i) ++ " "
                            ++ str_of_int (ic_start_line cx i) ++ ":" ++ str_of_int (ic_start_col cx i) ++ "-"
                            ++ str_of_int (ic_end_line cx i) ++ ":" ++ str_of_int (ic_end_col cx i)
                            ++ " " ++ str_of_int (ic_flags cx i)) in
             go (i + 1)) in
        go 0))
  | _ -> print "usage: tree_dump <file.pm> <file.rb>";
let _ = td_main ();
