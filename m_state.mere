// nothing the absence did not -- and it says it permanently: a container here
// never gives its memory back, so every redundant entry is a permanent one. A
// census of 200k interpolated strings found 1.2M entries in this map, six per
// string, nearly all of them "UTF-8". A string that is already tagged is a
// different matter: setting UTF-8 there is a real change, and has to remove the
// tag rather than skip the write.
let senc_set = fn (id: int) -> fn (nm: str) ->
  if str_eq nm "UTF-8"
  then (if map_has str_enc id
        then (let _ = map_delete str_enc id in ())
        else ())
  else (let _ = map_set str_enc id nm in ());
let senc_get = fn (id: int) -> if map_has str_enc id then map_get str_enc id else "UTF-8";
