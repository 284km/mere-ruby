// holder registers itself (a dynamic string that interns becomes canonical),
// later callers get that same object back.
// MERE_RUBY_INTERN_LOG=1: one stderr line per intern-table hit and
// registration, with the id and the CURRENT length of the canonical's
// content -- a hit whose content length differs from the key's is a
// canonical whose text was overwritten under it (the bundler `Illformed
// requirement [""]` of 2026-09-03 was found through this line).
let intern_log = map_new ();  // "on" -> 1, set by the driver from MERE_RUBY_INTERN_LOG
let intern_log_on = fn (u: unit) -> map_has intern_log "on";
let str_fstring = fn (v: Val) ->
  match v with
  | VStr h ->
