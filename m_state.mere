// table that defines the Encoding constants, so force_encoding / Encoding.find
// accept exactly the names ruby does and refuse the rest.
let enc_alias_canon = map_new ();
// a Symbol made from a non-Unicode / non-ASCII string keeps that encoding;
// VSym is only the name, so the encoding lives here (name -> canonical enc).
let sym_enc = map_new ();
// ⚠ EVERY SYMBOL THE PROGRAM NAMES, whether or not it has run yet. Ruby's
// Symbol.all_symbols includes one written in source that execution has not
// reached, because the parser has already made it -- so the LEXER registers
// them, alongside the ones #to_sym makes at run time.
let sym_all = map_new ();
let sym_note = fn (sy: str) -> let _ = map_set sym_all sy VNil in sy;
// the interned (deduplicated) frozen strings, keyed by encoding + content:
// what `-str` and the literal `.freeze` special form answer.
let str_intern_tbl = map_new ();
// The whole match, by MatchData object id. `to_s` has no world to reach the
// ivars through, and bootstraptest PRINTS its results -- a MatchData that
// printed as "#<object>" is how this was found.
let md_whole = map_new ();
// A Time's instant, by object id. Comparison (cmp_vals) has no world to reach
// the ivars through, and a Range of Times has to be able to compare its
// bounds -- `(t1..t2).cover?(t)` is the case that found this.
let time_inst = map_new ();
