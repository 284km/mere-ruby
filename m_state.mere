let pending_srcproc = map_new ();
let comp_inner = map_new ();     // composed proc id -> the callable run FIRST
let comp_outer = map_new ();     // composed proc id -> the callable run on its result
let curry_target = map_new ();   // curried proc id -> the proc it will call
let curry_args = map_new ();     // curried proc id -> the arguments so far
let curry_arity = map_new ();    // curried proc id -> how many it waits for
