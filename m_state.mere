// class name -> impl_cls class name); register_class save/restores ref_active so a
// `using` inside a module body is scoped to that body (Ruby's lexical scope).
let refine_cnt = map_new ();   // "<refinery>"      -> VInt count
let refine_tgt = map_new ();   // "<refinery>#<i>"  -> VStr target class
let refine_cls = map_new ();   // "<refinery>#<i>"  -> VStr impl_cls class
let ref_active = map_new ();   // "<target>"        -> VStr impl_cls class
