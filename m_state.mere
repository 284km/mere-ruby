// capture key was `"s" ++ str_of_int g`, built fresh on every probe, and the
// publication path probes it about 250 times per match.
let rx_caps = map_new ();
// how wide the tables actually are, so the loops below stop where the groups
// do instead of walking to 64 every time:
//   0  the highest group index written since the last clear
//   1  the highest `$1..$9` global the last publication wrote
let rx_wide = map_new ();
// compiled-regex program cache: "flags<SOH>pattern" -> prog map; rx_bad marks
// patterns the new engine cannot compile (the legacy matcher handles them).
let num_misuse_note = map_new ();
let rx_progs = map_new ();
let rx_bad = map_new ();
// \G anchor position: the start offset of the current search (scan/gsub pass
// it the cursor). \G (IGANCHOR) matches only when the cursor sits exactly
// here, so scan/gsub produce contiguous, gap-free matches like Ruby.
let rx_ganchor = map_new ();
