// subject must wear the subject's encoding, not the default: a MatchData over
// an EUC-JP string answered UTF-8 for #[0] / #pre_match / $& / $1, because the
// substring was built with a bare mkstr and encoding is per-handle.
let mkstr_e = fn (s: str) -> fn (enc: str) ->
