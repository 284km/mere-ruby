  set_nest (if str_eq c "" then cur else (if str_eq cur "" then c else c ++ "\n" ++ cur));
let set_lex = fn (c: str) -> let _ = map_set lex_cref "c" c in ();
// ⚠ ONE value, not two tables. A method captures its cref at `def` time and
// eleven places copy that value around (alias, module_function, define_method,
// a Method rebound...). A second table keyed the same way would need all
// eleven to learn about it, and the one that forgot would answer a stale
// nesting. So the nesting rides INSIDE the cref value, after a \r, and
// meth_cref_of / meth_nest_of split it back out.
let lex_pack = fn (u: unit) -> cur_lex () ++ chr 13 ++ cur_nest ();
let rec pack_at = fn (v: str) -> fn (i: int) ->
  if i >= str_len v then 0 - 1
  else if str_eq (char_at v i) (chr 13) then i
  else pack_at v (i + 1);
let pack_cref = fn (v: str) ->
  let i = pack_at v 0 in if i < 0 then v else substring v 0 i;
let pack_nest = fn (v: str) ->
  let i = pack_at v 0 in if i < 0 then "" else substring v (i + 1) (str_len v);
let meth_cref = map_new ();
// the shared Encoding objects, keyed by canonical name; enc_name maps an
// Encoding object's handle id -> name so the (world-free) printer can format it.
let enc_objs = map_new ();
let enc_name = map_new ();
// every name and alias an encoding is findable by, normalized (upcased,
