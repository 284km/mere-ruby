  map_set mro_gen 0 (n + 1);
let mro_now = fn () -> if map_has mro_gen 0 then map_get mro_gen 0 else 0;
// ⚠ THE ANCESTOR WALK, MEMOISED. `has_meth` asks whether a class or anything
// above it answers a name, and answering it costs about five hash lookups PER
// ANCESTOR LEVEL plus a 23-way class chain -- 26% of a dispatch-heavy profile,
// cumulative, and the same handful of (class, name) pairs over and over. The
// memo is keyed on the generation that `mro_bump ()` moves, which every write
// to sup / includes / prepends / meths / undefs goes through (tools/
// meth_writes_check.sh refuses one that does not). Same shape as mro_mods /
// mro_mods_gen below, and the same MERE_RUBY_NO_MRO_CACHE switch turns it off
// -- which is also how it is tested: the corpus and the spec sweep have to
// give the same answers with the memo off as with it on.
let hm_memo = map_new ();
let hm_memo_gen = map_new ();

let lv_up = map_new ();    // "<frame id>" -> that frame's parent env
let lv_ctr = map_new ();   // "n" -> next frame id
let lv_child = fn parent ->
  let e = map_new () in
  let n = (if map_has lv_ctr "n" then map_get lv_ctr "n" else 0) in
  let _ = map_set lv_ctr "n" (n + 1) in
  let _ = map_set e "__eid" (VInt n) in
  let _ = map_set lv_up n parent in
  e;
// (has_parent, parent). There is no null env, so a root echoes itself back.
let lv_parent_of = fn env ->
  if map_has env "__eid" then
    (match map_get env "__eid" with
     | VInt n ->
       // the parent frame is keyed by the id itself; it used to be keyed by the
       // id's decimal spelling, which is an asprintf on every scope lookup.
       if map_has lv_up n then (true, map_get lv_up n) else (false, env)
     | _ -> (false, env))
  else (false, env);
// the frame that binds `n`, or `env` itself when no frame in the chain does
// (so a fresh assignment declares the local in the innermost frame).
// (found, frame) — the frame in the chain that binds `n`. When nothing binds
// it the flag is false and the frame is meaningless: callers that declare
// (lv_set) must fall back to the INNERMOST env they were handed, or a fresh
// block-local would be created out in the method scope and leak.
let rec lv_owner = fn env -> fn (n: str) ->
  if map_has env n then (true, env)
  else let (has, p) = lv_parent_of env in
       if has then lv_owner p n else (false, env);
// A frame that ESCAPES its call -- a proc/lambda body, a captured yield
// block, a Thread body -- must never be recycled into the frame pool, and
// neither may any parent on its scope chain (the proc reads and writes
// through the chain). Marked at the choke points where an env leaves the
// call's extent; run_meth recycles only unmarked frames.
let rec mark_captured = fn env ->
  if map_has env "__captured" then ()
  else
    let _ = map_set env "__captured" (VBool true) in
    (match lv_parent_of env with
     | (true, p) -> mark_captured p
     | _ -> ());

// The choke points: every proc-shaped store goes through these, so the
// capture marking cannot be forgotten at one of the twenty-two write sites.
// THE FRAME POOL. A method call's frame dies at return unless captured
// (mark_captured above); a dead frame is recycled -- entries wiped, its
// private arena wound back to one warm 4 KB seed (mere v0.1.300) -- and
// parked here for the next call. Frames were the single largest unreclaimed
// share (12 GB of a rubocop load): every call allocated ~1.8 KB of map
// machinery into the default region, permanently. Pooled, a call's frame
// costs its ENTRIES only, in an arena that is handed back at return.
let frame_pool = vec_new ();
// `frame_pool_get` and `frame_pool_put` between them probe this table about
// fifteen times per method call, so the keys are slots:
//   0 n   1 hits   2 news   3 puts   4 drops   5 bytes   6 blk_kept   7 blk_puts
let frame_pool_n = map_new ();
// Can this target measure an arena at all? `map_bytes` / `vec_bytes` report the
// arena BYTES behind a store, and on RV32I -- where a program is the machine --
// a Vec is a plain heap block with no arena behind it, so there is no number to
// give and the call stops.
//
// Asked ONCE, here, and not per call. `frame_pool_put` runs on every frame
// release and `gc_store_bytes` on every pressure check, so a `try_or` inside
// either would install a fail handler in the hottest path in the interpreter.
//
// The false branch does not substitute 0. A byte count of 0 reads as "nothing
// was held", which is a measurement, and this is the absence of one -- so the
// counters are simply not kept, and the diagnostic rows that print them say so.
let arena_measurable = try_or (fn (u: unit) -> let _ = map_bytes frame_pool_n in true) false;
let pool_ctr = fn (k: int) ->
  map_set frame_pool_n k ((if map_has frame_pool_n k then map_get frame_pool_n k else 0) + 1);
let frame_pool_get = fn (u: unit) ->
  let n = (if map_has frame_pool_n 0 then map_get frame_pool_n 0 else 0) in
  if n > 0 then
    (let _ = pool_ctr 1 in
     let _ = map_set frame_pool_n 0 (n - 1) in
     vec_get frame_pool (n - 1))
  else
    (let _ = pool_ctr 2 in
     let f = map_new () in
     let _ = map_recycle f in   // promote: give it its own arena from birth
     f);
let frame_pool_put = fn f ->
  // count the bytes this frame's arena held BEFORE the wind-back: that sum is
  // the deterministic answer to "was anything reclaimed" that peak RSS is not
  // (peak RSS above a few GB varies 2x between identical runs, recorded below).
  let _ =
    if arena_measurable then
      map_set frame_pool_n 5
        ((if map_has frame_pool_n 5 then map_get frame_pool_n 5 else 0) + map_bytes f)
    else () in
  let _ = map_recycle f in
  let n = (if map_has frame_pool_n 0 then map_get frame_pool_n 0 else 0) in
  // cap the pool at the deepest call stack seen; past that, drop the frame
  // (its arena was already wound back, so the residue is the struct alone).
  if n >= 4096 then (pool_ctr 4)
  else
    (let _ = pool_ctr 3 in
     let _ = (if n < vec_len frame_pool then vec_set frame_pool n f
              else vec_push frame_pool f) in
     map_set frame_pool_n 0 (n + 1));

// A BLOCK's env comes from the same pool. It used to be `lv_child cenv`: a
// fresh Map in the default region plus a permanent lv_up entry, per
// invocation, never given back -- so `n.times { }` cost ~450-870 B more per
// iteration than the same loop written as `while`, for the life of the
// process, while a method call had been taking its frame from the pool since
// v0.1.300. Measured before/after in bench/block_env.sh. The lv_up entry
// leaves with the env: the pool IS the on-stack registry that pruning lv_up
// was waiting for (a frame is put back only once it is off the stack).
//
// An env a proc/lambda/Thread body captured is left alone, lv_up entry
// included -- mark_captured painted it and every parent on its chain at the
// choke point (store_proc / store_yblk), and the closure reads and writes
// through that chain later. `for` blocks never come here: they run in the
// enclosing env directly.
let blk_env_get = fn parent ->
  let e = frame_pool_get () in
  let n = (if map_has lv_ctr "n" then map_get lv_ctr "n" else 0) in
  let _ = map_set lv_ctr "n" (n + 1) in
  let _ = map_set e "__eid" (VInt n) in
  let _ = map_set lv_up n parent in
  e;
let blk_env_put = fn e ->
  if map_has e "__captured" then pool_ctr 6
  else
    (let _ = (if map_has e "__eid" then
                (match map_get e "__eid" with
                 | VInt n -> map_delete lv_up n
                 | _ -> ())
              else ()) in
     let _ = pool_ctr 7 in
     frame_pool_put e);

// Per-statement / per-call bookkeeping. These used to be str -> Val maps, and
// every write of an existing key copies the new value into the map's arena --
// a fresh VInt box per statement executed, per call made, orphaning the last
// one -- into the default region, which nothing gives back: 260 MB of a 400k-
// iteration loop's 302 MB default growth was eleven such maps (attributed by
// bench/def_maps.sh, 2026-09-03). An int value is stored by value: the
// overwrite allocates nothing. The str -> str ones (cur_pos_s, call_*_s) go
// through map_set_s below, which writes only when the text changes -- in a
// loop it is the same method at the same depth in the same file every time.
let cur_pos = map_new ();
let cur_pos_s = map_new ();
// ⚠ A NAME-MEMBERSHIP TEST IS A SET LOOKUP, NOT A CHAIN OF COMPARISONS. These
// three predicates ran 23-24 `str_eq` against literals, once per dispatch, and
// the answer for almost every name is "no" -- so almost every call paid all 24.
// Measured on this machine, 2M lookups over a mix of misses and one late hit:
// the 24-way chain 197 ms, one `map_has` 17 ms. Same answers, 11.5x.
// Built on first use from one "|"-joined string rather than as N top-level
// statements: the count of top-level lets is what the C backend's bracket
// depth is made of, and a hundred more of them is a real cost elsewhere.
let name_sets = map_new ();
let name_spec = fn (tag: str) ->
  if str_eq tag "builtin_cls_name" then ("String|Array|Hash|Integer|Float|Numeric|Complex|Rational|Range|"
    ++ "Symbol|TrueClass|FalseClass|NilClass|Kernel|Comparable"
    )
  else if str_eq tag "enc_preserving" then ("upcase|downcase|capitalize|swapcase|reverse|strip|lstrip|rstrip|"
    ++ "chomp|chop|chr|squeeze|tr|tr_s|delete|succ|next|*|slice|[]|gsub|sub|"
    ++ "concat|prepend|replace|delete_prefix|delete_suffix|byteslice|dup|"
    ++ "clone|+|<<"
    )
  else if str_eq tag "enum_needs_block" then ("map|collect|select|filter|reject|detect|find|find_all|rfind|flat_map|"
    ++ "collect_concat|partition|group_by|sort_by|sort_by!|min_by|max_by|"
    ++ "minmax_by|each_with_index|each_with_object|filter_map|take_while|"
    ++ "drop_while|each_entry|chunk|chunk_while|slice_when|reverse_each|"
    ++ "each_char|each_byte|each_line|each_codepoint|each|each_pair|each_key|"
    ++ "each_value|delete_if|keep_if|select!|reject!|filter!|each_index|map!|"
    ++ "collect!|bsearch|bsearch_index|repeated_combination|"
    ++ "repeated_permutation"
    )
  else if str_eq tag "enum_zero_arity" then ("map|collect|select|filter|find_all|reject|flat_map|collect_concat|"
    ++ "partition|group_by|sort_by|sort_by!|min_by|max_by|minmax_by|"
    ++ "filter_map|take_while|drop_while|each_with_index|delete_if|keep_if|"
    ++ "select!|filter!|reject!|each_index|map!|collect!|bsearch|"
    ++ "bsearch_index|reverse_each"
    )
  else if str_eq tag "hash_enum_delegate" then ("one?|first|min|max|minmax|sum|tally|zip|uniq|cycle|grep|grep_v|take|"
    ++ "drop|each_slice|each_cons|inject|reduce|find_index"
    )
  else if str_eq tag "is_arr_method" then ("fetch_values|length|size|push|append|pop|shift|unshift|prepend|map|"
    ++ "collect|map!|collect!|select|filter|select!|filter!|reject|reject!|"
    ++ "find|detect|rfind|find_index|index|rindex|include?|first|last|each|"
    ++ "each_index|each_with_index|each_with_object|reverse|reverse!|"
    ++ "reverse_each|sort|sort!|sort_by|join|flatten|flatten!|compact|"
    ++ "compact!|uniq|uniq!|resolve_feature_path|empty?|[]|[]=|slice|slice!|"
    ++ "concat|reduce|inject|to_a|to_ary|count|min|max|minmax|sum|zip|take|"
    ++ "take_while|drop|drop_while|group_by|partition|flat_map|any?|all?|"
    ++ "none?|one?|delete|delete_at|delete_if|keep_if|clear|replace|fill|"
    ++ "insert|rotate|sample|shuffle|at|fetch|values_at|assoc|tally|"
    ++ "each_slice|each_cons|cycle"
    )
  else if str_eq tag "is_binary_op_name" then "+|-|*|/|%|**|<<|>>|&|^|<|>|<=|>=|<=>|==|===|!="
  else if str_eq tag "is_enum_method" then ("map|collect|select|filter|reject|detect|find|find_index|rfind|index|"
    ++ "any?|all?|none?|count|reduce|inject|each_with_index|to_a|entries|"
    ++ "first|include?|member?|min|max|sort|sum|flat_map|collect_concat|"
    ++ "partition|group_by|each_with_object|filter_map|take_while|drop_while|"
    ++ "take|drop|tally|zip|uniq|compact|chunk_while|chunk|slice_before|"
    ++ "slice_after|slice_when|sort_by|sort_by!|min_by|max_by|minmax|"
    ++ "minmax_by|find_all|one?|grep|grep_v|reverse_each|each_entry|to_h|"
    ++ "cycle"
    )
  else if str_eq tag "is_exception_method" then ("==|backtrace|backtrace_locations|cause|detailed_message|exception|"
    ++ "full_message|inspect|message|respond_to?|set_backtrace|to_s"
    )
  else if str_eq tag "is_hash_method" then ("length|size|[]|[]=|store|fetch|delete|each|each_pair|each_key|"
    ++ "each_value|keys|values|key|key?|has_key?|include?|member?|value?|"
    ++ "has_value?|empty?|map|collect|select|filter|select!|filter!|reject|"
    ++ "reject!|merge|merge!|update|to_a|to_h|to_hash|invert|sort|"
    ++ "compare_by_identity|compare_by_identity?|sort_by|min_by|max_by|count|"
    ++ "sum|find|detect|any?|all?|none?|group_by|partition|each_with_object|"
    ++ "each_with_index|reduce|inject|dig|values_at|fetch_values|"
    ++ "transform_values|transform_keys|delete_if|keep_if|clear|replace|"
    ++ "default|default=|default_proc|default_proc=|compact|except|slice|"
    ++ "flat_map|sort!|first"
    )
  else if str_eq tag "is_kernel_modfunc" then ("puts|p|pp|print|printf|format|sprintf|warn|rand|srand|sleep|gets|"
    ++ "binding|caller|caller_locations|Integer|Float|String|Array|Hash|"
    ++ "Rational|Complex"
    )
  else if str_eq tag "is_numeric_own_method" then ("%|+@|-@|<=>|abs|abs2|angle|arg|ceil|clone|coerce|conj|conjugate|"
    ++ "denominator|div|divmod|dup|eql?|fdiv|finite?|floor|i|imag|imaginary|"
    ++ "infinite?|integer?|magnitude|modulo|negative?|nonzero?|numerator|"
    ++ "phase|polar|positive?|quo|real|real?|rect|rectangular|remainder|"
    ++ "round|singleton_method_added|step|to_c|to_int|truncate|zero?"
    )
  else if str_eq tag "is_op_sym_start" then "=|<|>|+|-|*|/|%|[|!|^|&|~|`"
  else if str_eq tag "is_prim_method" then ("to_s|inspect|class|to_enum|enum_for|nil?|frozen?|freeze|dup|clone|"
    ++ "itself|then|yield_self|tap|is_a?|kind_of?|instance_of?|respond_to?|"
    ++ "send|__send__|public_send|hash|object_id|__id__|==|!=|equal?|eql?|!~|"
    ++ "instance_variable_get|instance_variable_set|"
    ++ "instance_variable_defined?|instance_variables|singleton_class|"
    ++ "methods|public_methods|singleton_methods|method|extend|"
    ++ "define_singleton_method|<=>"
    )
  else if str_eq tag "is_range_method" then ("begin|end|exclude_end?|size|count|length|cover?|include?|member?|"
    ++ "step|to_a|each"
    )
  else if str_eq tag "is_regex_method" then ("match|match?|=~|===|source|options|names|named_captures|casefold?|"
    ++ "encoding|to_s|inspect"
    )
  else if str_eq tag "is_str_method" then ("=~|-@|+@|length|size|empty?|chars|lines|bytes|split|include?|index|"
    ++ "upcase|downcase|capitalize|swapcase|reverse|strip|lstrip|rstrip|"
    ++ "chomp|chop|start_with?|end_with?|sub|gsub|tr|replace|concat|to_i|"
    ++ "to_f|to_sym|each_char|each_line|count|scan|match|match?|slice|succ|"
    ++ "succ!|next|next!|intern|to_str|dedup|===|[]|[]="
    )
  else if str_eq tag "is_sym_method" then ("[]|<=>|=~|capitalize|casecmp|casecmp?|downcase|empty?|encoding|"
    ++ "end_with?|inspect|intern|length|match|match?|next|size|slice|"
    ++ "start_with?|succ|swapcase|to_proc|to_s|to_sym|upcase|id2name|name"
    )
  else if str_eq tag "is_valid_op_sym" then ("+|-|*|/|%|**|==|!=|<|<=|>|>=|<=>|===|=~|!~|<<|>>|[]|[]=|!|~|^|&|+@|"
    ++ "-@|`"
    )
  else if str_eq tag "modmeth" then ("name|ancestors|superclass|instance_methods|instance_method|"
    ++ "method_defined?|instance_variable_get|const_get|const_set|"
    ++ "const_defined?|constants|include?|included_modules|"
    ++ "singleton_class|singleton_class?|class_eval|module_eval|"
    ++ "class_exec|module_exec|<|<=|>|>=|<=>")
  // MODULE'S OWN INSTANCE METHODS, split the way ruby splits them. They live
  // in the dispatcher rather than the method table, so reflection could not
  // see a single one: `Module.private_instance_methods(false)` answered
  // [:initialize] where ruby names twenty, and eighteen core/module files open
  // by asking `Module.should have_private_instance_method(:append_features)`.
  // ⚠ Asked of the pinned reference (Module.public_instance_methods(false) and
  //   the private one), MINUS the four this interpreter does not implement:
  //   const_source_location, refinements, refine, using. Claiming a name the
  //   dispatcher cannot answer is the same defect in the other direction.
  else if str_eq tag "modpub" then ("<|<=|<=>|==|===|>|>=|alias_method|ancestors|attr|attr_accessor|"
    ++ "attr_reader|attr_writer|autoload|autoload?|class_eval|class_exec|"
    ++ "class_variable_defined?|class_variable_get|class_variable_set|"
    ++ "class_variables|const_defined?|const_get|const_missing|const_set|"
    ++ "constants|define_method|deprecate_constant|freeze|include|include?|"
    ++ "included_modules|inspect|instance_method|instance_methods|"
    ++ "method_defined?|module_eval|module_exec|name|prepend|"
    ++ "private_class_method|private_constant|private_instance_methods|"
    ++ "private_method_defined?|protected_instance_methods|"
    ++ "protected_method_defined?|public_class_method|public_constant|"
    ++ "public_instance_method|public_instance_methods|"
    ++ "public_method_defined?|remove_class_variable|remove_method|"
    ++ "set_temporary_name|singleton_class?|to_s|undef_method|"
    ++ "undefined_instance_methods")
  else if str_eq tag "modpriv" then ("append_features|const_added|extend_object|extended|included|"
    ++ "initialize|initialize_clone|method_added|method_removed|"
    ++ "method_undefined|module_function|prepend_features|prepended|private|"
    ++ "protected|public|remove_const|ruby2_keywords")
  // BASICOBJECT'S OWN, split the way ruby splits them. Like Module's and
  // Kernel's they live in the dispatcher, so reflection saw none of them:
  // `BasicObject.public_instance_methods(false)` answered [] where ruby names
  // eight, and thirteen of core/basicobject's fourteen files open by asking.
  else if str_eq tag "bopub" then ("!|!=|==|__id__|__send__|equal?|instance_eval|instance_exec")
  else if str_eq tag "bopriv" then ("initialize|method_missing|singleton_method_added|"
    ++ "singleton_method_removed|singleton_method_undefined")
  // CLASS'S OWN, beside Module's and BasicObject's (same reason: they live in
  // the dispatcher, so reflection could not see one).
  else if str_eq tag "clspub" then ("allocate|attached_object|new|subclasses|superclass")
  else if str_eq tag "clspriv" then ("inherited|initialize")
  // ⚠ CLASS UNDEFINES FIVE OF MODULE'S. They are the mixin machinery, and a
  //   Class is not something you mix in: ruby removes append_features,
  //   extend_object, module_function, prepend_features and refine from Class,
  //   so `Class.private_instance_methods(true)` must not name them even though
  //   Module is an ancestor. (refine is not implemented here, so it is not in
  //   modpriv either -- the other four are.)
  else if str_eq tag "clsundef" then ("append_features|extend_object|module_function|prepend_features|refine")
  // The names each single-namespace arm of the class dispatcher IMPLEMENTS.
  // Those arms used to swallow EVERY name and end in their own NoMethodError,
  // so `File.marker` could not reach a method a program had put on Object and
  // `FileTest.should_not` (mspec's own) was a NoMethodError -- an ordinary
  // class answers both. Guarding each arm with its list lets everything else
  // fall through to the generic class dispatch, and the same list answers
  // respond_to? (builtin_class_method), so the two doors cannot disagree.
  // ⚠ Derived from the arms themselves and checked by tools/ns_names_check.sh.
  else if str_eq tag "filens" then ("absolute_path|absolute_path?|basename|binread|binwrite|delete|"
    ++ "directory?|dirname|"
    ++ "empty?|executable?|executable_real?|exist?|expand_path|extname|file?|"
    ++ "fnmatch|fnmatch?|foreach|identical?|join|link|new|open|path|read|readable?|"
    ++ "readable_real?|readlines|realdirpath|realpath|rename|size|size?|split|symlink|"
    ++ "symlink?|unlink|writable?|writable_real?|write|zero?")
  else if str_eq tag "ions" then ("read|write|binread|binwrite|readlines|foreach")
  else if str_eq tag "dirns" then ("[]|chdir|children|delete|entries|exist?|getwd|glob|home|mkdir|new|"
    ++ "open|pwd|rmdir|tmpdir|unlink")
  else if str_eq tag "mathns" then ("acos|acosh|asin|asinh|atan|atan2|atanh|cbrt|cos|cosh|erf|erfc|exp|"
    ++ "expm1|frexp|gamma|hypot|ldexp|lgamma|log|log10|log1p|log2|sin|sinh|"
    ++ "sqrt|tan|tanh")
  else if str_eq tag "mut" then ("<<|push|append|pop|shift|unshift|prepend|insert|concat|"
    ++ "append_as_bytes|rehash|[]=|store|delete|delete_at|delete_if|"
    ++ "fill|clear|replace|keep_if|update|merge!|force_encoding|setbyte")
  else if str_eq tag "opmeth" then ("==|!=|<=>|===|<|>|<=|>=|+|-|*|/|%|**|<<|>>|!|=~|!~|&|^|~")
  else if str_eq tag "range_delegate_name" then ("each_slice|each_cons|zip|first|last|min|max|take|drop|values_at|"
    ++ "rotate|combination|permutation|each_index|product|join|minmax"
    )
  else if str_eq tag "rb_fmt_is_type" then "d|i|u|s|p|c|b|B|o|x|X|e|E|f|g|G"
  else if str_eq tag "rx_is_meta" then "$|^|*|+|.|?|}|)|>|]|(|[|<"
  else if str_eq tag "str_bang_base_ok" then ("upcase|downcase|capitalize|reverse|strip|succ|next|delete|swapcase|"
    ++ "lstrip|rstrip|chomp|chop|tr|tr_s|squeeze|slice|delete_prefix|"
    ++ "delete_suffix|unicode_normalize|scrub"
    )
  else chr 0 ++ "no such name_set tag";
let name_set = fn (tag: str) ->
  if map_has name_sets tag then map_get name_sets tag
  else
    (let tbl = map_new () in
     let _ = list_iter (str_split (name_spec tag) "|") (fn (n: str) -> map_set tbl n true) in
     let _ = map_set name_sets tag tbl in
     tbl);
let map_set_s = fn tbl -> fn (k: str) -> fn (v: str) ->
  if map_has tbl k && str_eq (map_get tbl k) v then () else map_set tbl k v;
// the same, for a table keyed by an INT. The call-stack tables (call_names_s,
// call_files_s, call_meths_s, call_lines, live_frames) are keyed by the call
// DEPTH or a frame id, and they were keyed by its decimal spelling: nine
// `str_of_int` per method call, each one an asprintf. That was the single
// largest cost in a dispatch-heavy program -- 1,207 of 4,600 samples in
// method_body_flow alone.
let map_set_si = fn tbl -> fn (k: int) -> fn (v: str) ->
  if map_has tbl k && str_eq (map_get tbl k) v then () else map_set tbl k v;
let cur_line = fn () ->
  if map_has cur_pos "l" then map_get cur_pos "l" else 0;
let cur_file = fn () ->
  if map_has cur_pos_s "f" then map_get cur_pos_s "f" else "";
// where the proc was WRITTEN, for #source_location and #to_s. Stamped here
// rather than carried through the AST: every proc goes through store_proc, and
// the executing statement's file and line are the block's own -- a block is
// created as the call that takes it is evaluated.
let proc_src = map_new ();
let proc_symsrc = map_new ();    // Symbol#to_proc's proc id -> the symbol name
let meth_params = map_new ();   // "cls#name" -> the Array of parameter names
let meth_src = map_new ();       // "cls#name" -> line, "f" ++ key -> file
let stamp_meth_src = fn (key: str) ->
  let _ = map_set meth_src key (VInt (cur_line ())) in
  map_set meth_src ("f" ++ key) (mkstr (cur_file ()));
// the definition site of one method is the definition site of another when
// the second was made FROM the first (an alias, or a define_method given a
// Method). The three lines that move it were written out at each `alias` site
// separately; a rule written once per site is a rule with one answer per site.
let copy_meth_src = fn (dst: str) -> fn (src: str) ->
  if map_has meth_src src && map_has meth_src ("f" ++ src)
  then (let _ = map_set meth_src dst (map_get meth_src src) in
        map_set meth_src ("f" ++ dst) (map_get meth_src ("f" ++ src)))
  else ();
// a BLOCK's definition site is the call that takes it, so `stamp_meth_src` is
// right for `define_method(:m) { }`. A PROC handed to define_method was
// written somewhere else entirely and carries its own site -- the call that
// installs it is not where it was defined.
let stamp_meth_src_proc = fn (key: str) -> fn (pk: str) ->
  if map_has proc_src pk && map_has proc_src ("f" ++ pk)
  then (let _ = map_set meth_src key (map_get proc_src pk) in
        map_set meth_src ("f" ++ key) (map_get proc_src ("f" ++ pk)))
  else ();
let store_proc = fn (k: str) -> fn entry ->
  let (_, _, _, penv) = entry in
  let _ = mark_captured penv in
  let _ = (if map_has proc_src k then () else map_set proc_src k (VInt (cur_line ()))) in
  let _ = (if map_has proc_src ("f" ++ k) then () else map_set proc_src ("f" ++ k) (mkstr (cur_file ()))) in
  map_set proc_store k entry;
let store_yblk = fn (k: str) -> fn b ->
  let (_, _, _, cenv) = b in
  let _ = mark_captured cenv in
  map_set proc_yblk k b;

let lv_has = fn env -> fn (n: str) -> let (found, _) = lv_owner env n in found;
let lv_get = fn env -> fn (n: str) ->
  let (found, f) = lv_owner env n in
  if found then map_get f n else VNil;
let lv_set = fn env -> fn (n: str) -> fn (v: Val) ->
  let (found, f) = lv_owner env n in
  map_set (if found then f else env) n v;
// flatten a chain into one detached map (inner shadows outer). `binding` and
// the env copies that install a different self must not write back through
// the chain, so the flattened copy carries no parent link.
let rec lv_flat_into = fn env -> fn d ->
  let (has, p) = lv_parent_of env in
  let _ = if has then lv_flat_into p d else () in
  let _ = map_iter env (fn (k: str) -> fn (v: Val) -> map_set d k v) in
  ();
let lv_flat = fn env ->
  let d = map_new () in
  let _ = lv_flat_into env d in
  let _ = if map_has d "__eid" then map_delete d "__eid" else () in
  d;
// read a map whose keys are "0".."n-1" (insertion order) back into a list;
// used to collect map_iter results (which can only side-effect) into an array.
let rec idx_to_list = fn tmp -> fn (i: int) -> fn (n: int) ->
  if i >= n then (Nil : Val list)
  else Cons (map_get tmp (str_of_int i), idx_to_list tmp (i + 1) n);
