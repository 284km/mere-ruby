// a plain string, not a Val: the collector never sees this table, and a map of
// handles would have to be a GC root (tools/gc_roots_check.sh says so).
let rx_gnall = map_new ();
let rx_gbodies = map_new ();
// Per compiled pattern (same key as rx_progs): its named groups, as
// "name=number|name=number|...". A MatchData answers `m[:name]` from this.
let rx_prog_names = map_new ();
// the cache key of the pattern currently being matched, so the MatchData it
// publishes can name its groups.
let rx_cur = map_new ();
