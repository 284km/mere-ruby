// ASCII-compatible, and neither is any UTF-16/UTF-32 variant.
// ASCII-8BIT is spelled BINARY from ruby 3.4 on, with the old name kept
// beside it -- `#<Encoding:BINARY (ASCII-8BIT)>`. #name and #to_s still answer
// "ASCII-8BIT"; only the inspect shows both.
let enc_display_name = fn (nm: str) ->
  if str_eq nm "ASCII-8BIT" then "BINARY (ASCII-8BIT)" else nm;
let enc_is_dummy = fn (nm: str) ->
  str_eq nm "UTF-16" || str_eq nm "UTF-32" || str_eq nm "IBM037" ||
  str_eq nm "ISO-2022-JP" || str_eq nm "ISO-2022-JP-2" || str_eq nm "ISO-2022-JP-KDDI" ||
  str_eq nm "CP50220" || str_eq nm "CP50221" || str_eq nm "UTF-7";
