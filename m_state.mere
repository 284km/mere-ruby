let str_frozen = map_new ();
let str_chilled = map_new ();
let sfrozen_set = fn (id: int) -> let _ = map_set str_frozen id "1" in ();
// CHILLED (ruby 3.4): a literal from a file with no frozen_string_literal
// comment. Not frozen -- #frozen? is false and it can be mutated -- but `+str`
// answers a copy, which is the whole observable difference.
let schilled_set = fn (id: int) -> let _ = map_set str_chilled (str_of_int id) "1" in ();
let schilled_get = fn (id: int) -> map_has str_chilled (str_of_int id);
let sfrozen_get = fn (id: int) -> map_has str_frozen id;
// frozen state of ordinary objects (keyed by object id string), consulted by
// #frozen? on the object and on its singleton class.
// frozen state of arrays / hashes. Arrays and hashes live in separate stores,
// so their handle ids overlap: the key needs the kind ("a" / "h") or freezing
// array #7 would make hash #7 report frozen too.
let coll_frozen = map_new ();
// ⚠ a TAGGED INT, the same trick the collector uses: `"a" ++ str_of_int id`
// was a concatenation and an asprintf on every #frozen? of a container, and
// #frozen? is asked before every mutating method. 0 array, 1 hash, 2 proc.
let cfrozen_set = fn (k: int) -> fn (id: int) -> let _ = map_set coll_frozen (id * 4 + k) "1" in ();
let cfrozen_get = fn (k: int) -> fn (id: int) -> map_has coll_frozen (id * 4 + k);
let obj_frozen = map_new ();
let ofrozen_set = fn (id: int) -> let _ = map_set obj_frozen id "1" in ();
let ofrozen_get = fn (id: int) -> map_has obj_frozen id;
// the caller has the id as TEXT (a singleton class name carries it), so this
// is the one door that still parses; a non-numeric name is simply not an id.
let ofrozen_key = fn (k: str) ->
  str_len k > 0 && is_digit (char_at k 0) && map_has obj_frozen (int_of_str k);
// A CLASS or MODULE can be frozen too, and then it refuses every change to
// itself: `K.freeze` was a no-op that even left `K.frozen?` answering false,
// so a frozen class kept accepting defs, includes, constants and attrs.
// Keyed by class NAME (a class is named, not identified by an object id).
let cls_frozen = map_new ();
let clsfrozen_set = fn (c: str) -> let _ = map_set cls_frozen c "1" in ();
let clsfrozen_get = fn (c: str) -> map_has cls_frozen c;
let cli_fsl = map_new ();
let fsl_ctx = map_new ();  // "v" -> the current file's magic-comment answer   // key "on" present => --enable-frozen-string-literal
let cli_file = map_new ();  // key "p" -> the running script's path (__FILE__)
let fsl_on = fn () -> map_has cli_fsl "on";
// "on" / "off" / "" (absent). The command-line flags decide for every file;
// otherwise the file's own magic comment does, which the loader records in
// load_ctx "fsl" beside the encoding.
// "on" / "off" / "" (absent). The command-line flags decide for every file;
// otherwise the file's own magic comment does, which the loader records in
// load_ctx "fsl" beside the encoding.
let fsl_state = fn () ->
  if map_has cli_fsl "on" then "on"
  else if map_has cli_fsl "off" then "off"
  else if map_has fsl_ctx "v" then map_get fsl_ctx "v" else "";
let script_file = fn () -> if map_has cli_file "p" then map_get cli_file "p" else "-";
// lexical constant scope (cref): the class whose body is currently being run
// ("" = top level). Captured per method at `def` time (meth_cref) and consulted
// when resolving a bare Constant, so `Const` means the lexically-nearest one.
let lex_cref = map_new ();
let cur_lex = fn () -> if map_has lex_cref "c" then map_get lex_cref "c" else "";
// ⚠ `Module.nesting` is the list of scopes AS WRITTEN, and the cref alone
// cannot reconstruct it: `module A; module B` and `module A::B` leave the same
// cref "A::B" and answer [A::B, A] and [A::B2] respectively. So the list is
// kept beside the cref, pushed and popped by the same setter -- one entry per
// `class`/`module` keyword actually entered, innermost first, joined by \n
// because a scope name can contain "::" but never a newline.
let lex_nest = map_new ();
let cur_nest = fn () -> if map_has lex_nest "n" then map_get lex_nest "n" else "";
let set_nest = fn (s: str) -> let _ = map_set lex_nest "n" s in ();
// entering `c`: it goes on the FRONT of whatever was open.
let push_nest = fn (c: str) ->
