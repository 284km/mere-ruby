// is the one object shape ruby prints WITHOUT an address (`#<struct S a=1>`),
// so it can be reproduced byte for byte -- but only if the member ORDER is
// kept, which the generated #members method cannot be asked for cheaply.
let struct_mem = map_new ();
let fresh_anon = fn (prefix: str) ->
  let n = (if map_has struct_ctr "n" then map_get struct_ctr "n" else 0) in
  let _ = map_set struct_ctr "n" (n + 1) in
  prefix ++ str_of_int n;
// break-through-yield home tracking: each method invocation gets a unique
// frame id; a block captured by a `&blk` param remembers the frame it was
// passed to (its "home"), so a `break` inside it — even after the block has
// been delegated down through other methods — unwinds to that home method.
let next_fid = fn () ->
  let n = (if map_has struct_ctr "f" then map_get struct_ctr "f" else 0) in
  let _ = map_set struct_ctr "f" (n + 1) in
  n + 1;
let proc_home = map_new ();     // str(proc id) -> VInt home-frame-id
let pending_home = map_new ();  // single slot: home fid of a &proc being passed as a block
let live_frames = map_new ();   // fid -> 1 while that method frame is on the stack
// the counter in an internal anonymous name ("AnonClass_7" -> 7), used as the
// address Ruby shows. Stable for the life of the program, like an object id.
let is_anon_cls = fn (c: str) ->
  (str_len c >= 10 && str_eq (substring c 0 10) "AnonClass_") || (str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_")
  // a struct class is anonymous too until something names it: ruby answers
  // nil for `Struct.new(:a).name`, and "Struct::Foo" once it is given one.
  || (str_len c >= 7 && str_eq (substring c 0 7) "Struct_")
  // ...and a REFINEMENT module, which ruby never gives a name: `refine String
  // do ... end` answers a module whose #name is nil, and the block's self is
  // that module. Its internal name is bookkeeping, not a constant.
  || (str_len c >= 7 && str_eq (substring c 0 7) "Refine_");
// name_anon (records a constant name for an anonymous class/module the first
// time it is assigned to a constant) is defined in the mutual-recursion block
// below, since it recurses through the receiver's constants.
// singleton methods on handle-based values (String/Array/Hash): keyed by
// "str:<h>" / "arr:<h>" / "hsh:<h>" -> the value's singleton class name.
// one arena block, reused: 64 KiB is the read size and the write chunk.
let tcp_buf = map_new ();
let tcp_arena = fn () ->
  if map_has tcp_buf "p" then (match map_get tcp_buf "p" with VInt p -> p | _ -> 0)
  else (let p = mem_alloc 65536 in let _ = map_set tcp_buf "p" (VInt p) in p);

let hng_store = map_new ();
// class variables (@@x): "Cls@x" -> value, resolved up the superclass chain.
let cvars = map_new ();
