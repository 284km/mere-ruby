     if map_has str_intern_tbl k then
       (let hit = map_get str_intern_tbl k in
        let _ = (if intern_log_on () then
                   (match hit with
                    | VStr hid -> print_err ("intern: hit \"" ++ sget h ++ "\" -> id " ++ str_of_int hid
                                             ++ " content now \"" ++ sget hid ++ "\"")
                    | _ -> ())
                 else ()) in
