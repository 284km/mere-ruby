  "          @size += data.bytesize\n" ++
  "          unless @skip_check\n" ++
  "            @adler = @format == :gzip ? Zlib.crc32(data, @adler) : Zlib.adler32(data, @adler)\n" ++
  "          end\n" ++
  "          if status < 0\n" ++
  "            @bad = true\n" ++
  "            raise DataError, 'invalid compressed data -- format violated'\n" ++
  "          elsif status == 1\n" ++
  "            @phase = :trailer\n" ++
  "          elsif data.empty? && used == 0\n" ++
  "            return\n" ++
  "          end\n" ++
  "        elsif @phase == :trailer\n" ++
  "          n = @format == :gzip ? 8 : (@format == :zlib ? 4 : 0)\n" ++
  "          return if @in.bytesize < n\n" ++
  "          tail = __consume(n)\n" ++
  "          if @format == :zlib\n" ++
  "            raise DataError, 'incorrect data check' if !@skip_check && tail.unpack1('N') != @adler\n" ++
  "          elsif @format == :gzip\n" ++
  "            crc, size = tail.unpack('V2')\n" ++
  "            raise DataError, 'incorrect data check' if !@skip_check && crc != @adler\n" ++
  "            raise DataError, 'incorrect length check' if !@skip_check && size != (@size & 0xffffffff)\n" ++
  "          end\n" ++
  "          @phase = :done\n" ++
  "          @finished = true\n" ++
  "\n" ++
  "          return\n" ++
  "        else\n" ++
  "          return\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def inflate(str, buffer: nil, &block)\n" ++
  "      __ready\n" ++
  "      @lock.synchronize do\n" ++
  "        if @finished\n" ++
  "          @out << @in\n" ++
  "          @in = +''.b\n" ++
  "          @out << Zlib.__string(str).b unless str.nil?\n" ++
  "          result = str.nil? ? __drain(true, &block) : +''.b\n" ++
  "        else\n" ++
  "          @in << Zlib.__string(str).b unless str.nil?\n" ++
  "          if block\n" ++
  "            loop do\n" ++
  "              before = @total_in\n" ++
  "              produced = @total_out\n" ++
  "              __decode(16384)\n" ++
  "              __drain(@finished) do |chunk|\n" ++
  "                block.call(buffer ? buffer.replace(chunk) : chunk)\n" ++
  "              end\n" ++
  "              break if @finished || (before == @total_in && produced == @total_out)\n" ++
  "            end\n" ++
  "            result = nil\n" ++
  "          else\n" ++
  "            __decode\n" ++
  "            result = __drain(@finished)\n" ++
  "          end\n" ++
  "          raise BufError, 'buffer error' if str.nil? && !@finished\n" ++
  "          if @finished\n" ++
  "            @out << @in\n" ++
  "            @in = +''.b\n" ++
  "          end\n" ++
  "        end\n" ++
  "        buffer && result ? buffer.replace(result) : result\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def <<(str)\n" ++
  "      __ready\n" ++
  "      @lock.synchronize do\n" ++
  "        if @finished\n" ++
  "          @out << @in\n" ++
  "          @in = +''.b\n" ++
  "          @out << Zlib.__string(str).b unless str.nil?\n" ++
  "        else\n" ++
  "          @in << Zlib.__string(str).b unless str.nil?\n" ++
  "          __decode\n" ++
  "          raise BufError, 'buffer error' if str.nil? && !@finished\n" ++
  "        end\n" ++
  "      end\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def finish(&block)\n" ++
  "      __ready\n" ++
  "      @lock.synchronize do\n" ++
  "        __decode unless @finished\n" ++
  "        raise BufError, 'buffer error' unless @finished\n" ++
  "        @out << @in\n" ++
  "        @in = +''.b\n" ++
  "        __drain(true, &block)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def set_dictionary(dict)\n" ++
  "      __ready\n" ++
  "      dict = Zlib.__string(dict).b\n" ++
  "      unless @phase == :dictionary || @wbits < 0\n" ++
  "        raise StreamError, 'stream error'\n" ++
  "      end\n" ++
  "      raise DataError, 'data error' if @dict_id && Zlib.adler32(dict) != @dict_id\n" ++
  "      @history = dict.byteslice(-[32768, dict.bytesize].min, dict.bytesize) || +''.b\n" ++
  "      @phase = :body\n" ++
  "      @adler = 1\n" ++
  "      dict\n" ++
  "    end\n" ++
  "\n" ++
  "    def add_dictionary(dict)\n" ++
  "      __ready\n" ++
  "      dict = Zlib.__string(dict).b\n" ++
  "      @dictionaries[Zlib.adler32(dict)] = dict\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def sync(str)\n" ++
  "      __ready\n" ++
  "      @in << Zlib.__string(str).b\n" ++
  "      marker = @in.index(\"\\x00\\x00\\xff\\xff\".b)\n" ++
  "      if marker\n" ++
  "        __consume(marker + 4)\n" ++
  "        @state = +''.b\n" ++
  "        @history = +''.b\n" ++
  "        # inflateSync treats recovery before a header as raw DEFLATE. After\n" ++
  "        # a header it retains framing, but the lost prefix prevents checking.\n" ++
  "        @format = :raw if @phase == :header\n" ++
  "        @skip_check = true\n" ++
  "        @adler = @format == :zlib ? 1 : 0\n" ++
  "        @phase = :body\n" ++
  "        @bad = false\n" ++
  "        true\n" ++
  "      else\n" ++
  "        @in = @in.byteslice(-[3, @in.bytesize].min, @in.bytesize) || +''.b\n" ++
  "        @state = +''.b\n" ++
  "        @bad = true\n" ++
  "        false\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def sync_point?; __ready; !@state.empty? && @state.unpack1('V') == 1; end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.deflate(str, level = DEFAULT_COMPRESSION, &block)\n" ++
  "    Deflate.deflate(str, level, &block)\n" ++
  "  end\n" ++
  "  def self.inflate(str, &block)\n" ++
  "    Inflate.inflate(str, &block)\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# Gzip framing and bounded IO over the resumable RFC 1951 engine.\n" ++
  "module Zlib\n" ++
  "  class GzipFile\n" ++
  "    class Error < Zlib::Error\n" ++
  "      attr_reader :input\n" ++
  "    end\n" ++
  "    class CRCError < Error; end\n" ++
  "    class LengthError < Error; end\n" ++
  "    class NoFooter < Error; end\n" ++
  "\n" ++
  "    def self.wrap(io, *args, **opts)\n" ++
  "      gz = new(io, *args, **opts)\n" ++
  "      return gz unless block_given?\n" ++
  "      begin\n" ++
  "        yield gz\n" ++
  "      ensure\n" ++
  "        gz.close unless gz.closed?\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def __ready\n" ++
  "      raise Zlib::GzipFile::Error, 'closed gzip stream' if @closed\n" ++
  "    end\n" ++
  "    def closed?; @closed ? true : false; end\n" ++
  "    def to_io; __ready; @io; end\n" ++
  "    def path; @io.path; end\n" ++
  "    def sync; __ready; @sync ? true : false; end\n" ++
  "    def sync=(value); __ready; @sync = value; value; end\n" ++
  "    def mtime; __ready; @mtime; end\n" ++
  "    def orig_name; __ready; @orig_name && @orig_name.dup; end\n" ++
  "    def comment; __ready; @comment && @comment.dup; end\n" ++
  "    def level; __ready; @level; end\n" ++
  "    def os_code; __ready; @os_code || OS_CODE; end\n" ++
  "    def crc; __ready; @crc; end\n" ++
  "    def close\n" ++
  "      return nil if @closed\n" ++
  "      io = finish\n" ++
  "      io.close if io.respond_to?(:close)\n" ++
  "      io\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  class GzipWriter < GzipFile\n" ++
  "    def self.open(path, *args, **opts, &block)\n" ++
  "      io = File.open(path, 'wb')\n" ++
  "      begin\n" ++
  "        wrap(io, *args, **opts, &block)\n" ++
  "      rescue Exception\n" ++
  "        io.close unless io.closed?\n" ++
  "        raise\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def initialize(io, level = DEFAULT_COMPRESSION, strategy = DEFAULT_STRATEGY, **opts)\n" ++
  "      @io = io\n" ++
  "      @level = level.nil? ? DEFAULT_COMPRESSION : Integer(level)\n" ++
  "      @z = Deflate.new(@level, -MAX_WBITS, DEF_MEM_LEVEL, strategy)\n" ++
  "      @closed = false\n" ++
  "      @header_written = false\n" ++
  "      @mtime = Time.now\n" ++
  "      @crc = 0\n" ++
  "      @pos = 0\n" ++
  "      @compressed = +''.b\n" ++
  "      @external = opts[:external_encoding] || opts[:encoding]\n" ++
  "      @internal = opts[:internal_encoding]\n" ++
  "    end\n" ++
  "\n" ++
  "    def __header\n" ++
  "      return if @header_written\n" ++
  "      @header_written = true\n" ++
  "      flags = (@orig_name ? 8 : 0) | (@comment ? 16 : 0)\n" ++
  "      xflags = @level == 9 ? 2 : (@level == 1 ? 4 : 0)\n" ++
  "      @compressed << [31, 139, 8, flags, @mtime.to_i & 0xffffffff, xflags, OS_CODE].pack('C4VC2')\n" ++
  "      @compressed << @orig_name.b << \"\\0\" if @orig_name\n" ++
  "      @compressed << @comment.b << \"\\0\" if @comment\n" ++
  "    end\n" ++
  "\n" ++
  "    def __write_output(force = false)\n" ++
  "      if force || @compressed.bytesize >= 2048\n" ++
  "        @io.write(@compressed) unless @compressed.empty?\n" ++
  "        @compressed = +''.b\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def write(str)\n" ++
  "      __ready\n" ++
  "      s = Zlib.__string(str)\n" ++
  "      s = s.encode(@external) if @external\n" ++
  "      s = s.b\n" ++
  "      __header\n" ++
  "      @crc = Zlib.crc32(s, @crc)\n" ++
  "      @pos += s.bytesize\n" ++
  "      @compressed << @z.deflate(s, @sync ? SYNC_FLUSH : NO_FLUSH)\n" ++
  "      __write_output(@sync)\n" ++
  "      s.bytesize\n" ++
  "    end\n" ++
  "    def <<(str); write(str); self; end\n" ++
  "    def print(*args)\n" ++
  "      args = [$_] if args.empty?\n" ++
  "      args.each \{ |a| write(a.to_s) \}\n" ++
  "      write($\\) if $\\\n" ++
  "      nil\n" ++
  "    end\n" ++
  "    def puts(*args)\n" ++
  "      args = [''] if args.empty?\n" ++
  "      args.each do |a|\n" ++
  "        if a.is_a?(Array)\n" ++
  "          a.each \{ |v| puts(v) \}\n" ++
  "        else\n" ++
  "          s = a.nil? ? '' : a.to_s\n" ++
  "          write(s)\n" ++
  "          write(\"\\n\") unless s.end_with?(\"\\n\")\n" ++
  "        end\n" ++
  "      end\n" ++
  "      nil\n" ++
  "    end\n" ++
  "    def printf(fmt, *args); write(format(fmt, *args)); nil; end\n" ++
  "    def putc(c); write(c.is_a?(Integer) ? (c & 255).chr.b : c.to_s.byteslice(0, 1)); c; end\n" ++
  "    def pos; __ready; @pos; end\n" ++
  "    alias tell pos\n" ++
  "\n" ++
  "    def flush(mode = SYNC_FLUSH)\n" ++
  "      __ready\n" ++
  "      __header\n" ++
  "      @compressed << @z.flush(mode)\n" ++
  "      __write_output(true)\n" ++
  "      @io.flush if @io.respond_to?(:flush)\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def finish\n" ++
  "      __ready\n" ++
  "      __header\n" ++
  "      @compressed << @z.finish << [@crc, @pos & 0xffffffff].pack('V2')\n" ++
  "      __write_output(true)\n" ++
  "      @z.close\n" ++
  "      @closed = true\n" ++
  "      @io\n" ++
  "    end\n" ++
  "\n" ++
  "    def mtime=(value)\n" ++
  "      __ready\n" ++
  "      raise Zlib::GzipFile::Error, 'header is already written' if @header_written\n" ++
  "      @mtime = value.is_a?(Time) ? value : Time.at(Integer(value))\n" ++
  "      value\n" ++
  "    end\n" ++
  "    def orig_name=(value)\n" ++
  "      __ready\n" ++
  "      raise Zlib::GzipFile::Error, 'header is already written' if @header_written\n" ++
  "      @orig_name = Zlib.__string(value).split(\"\\0\", 2).first || ''\n" ++
  "      value\n" ++
  "    end\n" ++
  "    def comment=(value)\n" ++
  "      __ready\n" ++
  "      raise Zlib::GzipFile::Error, 'header is already written' if @header_written\n" ++
  "      @comment = Zlib.__string(value).split(\"\\0\", 2).first || ''\n" ++
  "      value\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  class GzipReader < GzipFile\n" ++
  "    include Enumerable\n" ++
  "    def self.open(path, *args, **opts, &block)\n" ++
  "      io = File.open(path, 'rb')\n" ++
  "      begin\n" ++
  "        wrap(io, *args, **opts, &block)\n" ++
  "      rescue Exception\n" ++
  "        io.close unless io.closed?\n" ++
  "        raise\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def initialize(io, options = nil, **opts)\n" ++
  "      @io = io\n" ++
  "      @options = (options || \{\}).merge(opts)\n" ++
  "      @closed = false\n" ++
  "      @raw_len = 0\n" ++
  "      __reset_reader\n" ++
  "    end\n" ++
  "\n" ++
  "    def __reset_reader\n" ++
  "      @z = Inflate.new(31)\n" ++
  "      @z.instance_variable_set(:@reader_mode, true)\n" ++
  "      @data = +''.b\n" ++
  "      @pushback = +''.b\n" ++
  "      @pos = 0\n" ++
  "      @lineno = 0\n" ++
  "      @crc = 0\n" ++
  "      @ended = false\n" ++
  "      @source_end = false\n" ++
  "      external = @options[:external_encoding] || @options[:encoding]\n" ++
  "      internal = @options[:internal_encoding]\n" ++
  "      if external && external.to_s.include?(':')\n" ++
  "        external, internal = external.to_s.split(':', 2)\n" ++
  "      end\n" ++
  "      @enc = external ? Encoding.find(external.to_s) : Encoding.default_external\n" ++
  "      @internal = internal && internal != '-' ? Encoding.find(internal.to_s) : nil\n" ++
  "      loop do\n" ++
  "        begin\n" ++
  "          break if @z.__header\n" ++
  "        rescue Zlib::DataError\n" ++
  "          __gzip_error(Zlib::GzipFile::Error, 'not in gzip format', @z.instance_variable_get(:@in))\n" ++
  "        end\n" ++
  "        unless __read_input\n" ++
  "          input = @z.instance_variable_get(:@in)\n" ++
  "          __gzip_error(Zlib::GzipFile::Error, 'not in gzip format', input.empty? ? nil : input)\n" ++
  "        end\n" ++
  "      end\n" ++
  "      @mtime = Time.at(@z.instance_variable_get(:@gzip_mtime))\n" ++
  "      @orig_name = @z.instance_variable_get(:@gzip_name)\n" ++
  "      @comment = @z.instance_variable_get(:@gzip_comment)\n" ++
  "      @os_code = @z.instance_variable_get(:@gzip_os)\n" ++
  "      @level = @z.instance_variable_get(:@gzip_level)\n" ++
  "    end\n" ++
  "\n" ++
  "    def __gzip_error(klass, message, input = nil)\n" ++
  "      error = klass.new(message)\n" ++
  "      error.instance_variable_set(:@input, input)\n" ++
  "      raise error\n" ++
  "    end\n" ++
  "\n" ++
  "    def __read_input\n" ++
  "      return false if @source_end\n" ++
  "      begin\n" ++
  "        s = @io.readpartial(2048)\n" ++
  "        s = Zlib.__string(s)\n" ++
  "      rescue NoMethodError\n" ++
  "        s = @io.read(2048)\n" ++
  "      rescue EOFError\n" ++
  "        s = nil\n" ++
  "      end\n" ++
  "      if s.nil? || s.empty?\n" ++
  "        @source_end = true\n" ++
  "        false\n" ++
  "      else\n" ++
  "        s = Zlib.__string(s).b\n" ++
  "        @raw_len += s.bytesize\n" ++
  "        @z.instance_variable_get(:@in) << s\n" ++
  "        true\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def __fill\n" ++
  "      return false if @ended\n" ++
  "      loop do\n" ++
  "        begin\n" ++
  "          @z.__decode(16384)\n" ++
  "        rescue Zlib::DataError => e\n" ++
  "          klass = e.message == 'incorrect length check' ? LengthError : (e.message == 'incorrect data check' ? CRCError : Zlib::GzipFile::Error)\n" ++
  "          __gzip_error(klass, e.message == 'incorrect data check' ? 'invalid compressed data -- crc error' : e.message)\n" ++
  "        end\n" ++
  "        # GzipReader retains the input after the member; it is not decoded data.\n" ++
  "        @data << @z.flush_next_out\n" ++
  "        if @z.finished?\n" ++
  "          @ended = true\n" ++
  "          @unused = @z.instance_variable_get(:@in)\n" ++
  "        end\n" ++
  "        return true unless @data.empty?\n" ++
  "        return false if @ended\n" ++
  "        unless __read_input\n" ++
  "          kind = @z.instance_variable_get(:@phase) == :trailer && @z.instance_variable_get(:@in).empty? ? NoFooter : Zlib::GzipFile::Error\n" ++
  "          __gzip_error(kind, kind == NoFooter ? 'footer is not found' : 'unexpected end of file')\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def read(length = nil, buffer = nil)\n" ++
  "      __ready\n" ++
  "      unless length.nil?\n" ++
  "        length = Integer(length)\n" ++
  "        raise ArgumentError, \"negative length #\{length\} given\" if length < 0\n" ++
  "      end\n" ++
  "      result = +''.b\n" ++
  "      while length.nil? || result.bytesize < length\n" ++
  "        if @pushback.empty? && @data.empty?\n" ++
  "          break unless __fill\n" ++
  "        end\n" ++
  "        source = @pushback.empty? ? @data : @pushback\n" ++
  "        n = length.nil? ? source.bytesize : [source.bytesize, length - result.bytesize].min\n" ++
  "        piece = source.byteslice(0, n)\n" ++
  "        @crc = Zlib.crc32(piece, @crc) if @pushback.empty?\n" ++
  "        result << piece\n" ++
  "        source.replace(source.byteslice(n, source.bytesize - n))\n" ++
  "      end\n" ++
  "      @pos += result.bytesize\n" ++
  "      if length && length > 0 && result.empty?\n" ++
  "        buffer.clear if buffer\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "      if length.nil?\n" ++
  "        result.force_encoding(@enc)\n" ++
  "        result = result.encode(@internal) if @internal\n" ++
  "      end\n" ++
  "      buffer ? buffer.replace(result) : result\n" ++
  "    end\n" ++
  "\n" ++
  "    def readpartial(length, buffer = nil)\n" ++
  "      __ready\n" ++
  "      length = Integer(length)\n" ++
  "      raise ArgumentError, \"negative length #\{length\} given\" if length < 0\n" ++
  "      return buffer ? buffer.replace(+''.b) : +''.b if length == 0\n" ++
  "      if @pushback.empty? && @data.empty?\n" ++
  "        unless __fill\n" ++
  "          buffer.clear if buffer\n" ++
  "          raise EOFError, 'end of file reached'\n" ++
  "        end\n" ++
  "      end\n" ++
  "      read([length, @pushback.bytesize + @data.bytesize].min, buffer)\n" ++
  "    end\n" ++
  "\n" ++
  "    def eof?\n" ++
  "      __ready\n" ++
  "      @pushback.empty? && @data.empty? && !__fill\n" ++
  "    end\n" ++
  "    alias eof eof?\n" ++
  "    def pos; __ready; @pos; end\n" ++
  "    alias tell pos\n" ++
  "    def lineno; __ready; @lineno; end\n" ++
  "    def lineno=(n); __ready; @lineno = Integer(n); end\n" ++
  "    def external_encoding = @enc\n" ++
  "    def unused\n" ++
  "      __ready\n" ++
  "      eof? ? (@unused && !@unused.empty? ? @unused.dup : nil) : nil\n" ++
  "    end\n" ++
  "    def getbyte; s = read(1); s && s.getbyte(0); end\n" ++
  "    def readbyte; getbyte || (raise EOFError, 'end of file reached'); end\n" ++
  "    def getc\n" ++
  "      return nil if eof?\n" ++
  "      s = read(1).force_encoding(@enc)\n" ++
  "      s << read(1).force_encoding(@enc) until s.valid_encoding? || eof?\n" ++
  "      @internal ? s.encode(@internal) : s\n" ++
  "    end\n" ++
  "    def readchar; getc || (raise EOFError, 'end of file reached'); end\n" ++
  "    def ungetbyte(value)\n" ++
  "      __ready\n" ++
  "      return nil if value.nil?\n" ++
  "      s = value.is_a?(Integer) ? (value & 255).chr.b : Zlib.__string(value).b\n" ++
  "      @pushback = s + @pushback\n" ++
  "      @pos -= s.bytesize\n" ++
  "      nil\n" ++
  "    end\n" ++
  "    def ungetc(value)\n" ++
  "      return nil if value.nil?\n" ++
  "      ungetbyte(value.is_a?(Integer) ? value.chr(@enc) : Zlib.__string(value))\n" ++
  "    end\n" ++
  "\n" ++
  "    def gets(separator = $/, limit = nil, chomp: false)\n" ++
  "      __ready\n" ++
  "      if separator.is_a?(Integer)\n" ++
  "        limit = separator\n" ++
  "        separator = $/\n" ++
  "      end\n" ++
  "      limit = Integer(limit) if limit\n" ++
  "      return +''.force_encoding(@enc) if limit == 0\n" ++
  "      return nil if eof?\n" ++
  "      sep = separator.nil? ? nil : Zlib.__string(separator).b\n" ++
  "      paragraph = sep == ''\n" ++
  "      if paragraph\n" ++
  "        while (b = getbyte) == 10; end\n" ++
  "        ungetbyte(b) if b\n" ++
  "        return nil unless b\n" ++
  "        sep = \"\\n\\n\".b\n" ++
  "      end\n" ++
  "      result = +''.b\n" ++
  "      until eof?\n" ++
  "        result << read(1)\n" ++
  "        break if (limit && limit > 0 && result.bytesize >= limit) || (sep && result.end_with?(sep))\n" ++
  "      end\n" ++
  "      until result.dup.force_encoding(@enc).valid_encoding? || eof?\n" ++
  "        result << read(1)\n" ++
  "      end\n" ++
  "      if paragraph\n" ++
  "        while (b = getbyte) == 10; end\n" ++
  "        ungetbyte(b) if b\n" ++
  "      end\n" ++
  "      @lineno += 1\n" ++
  "      result.force_encoding(@enc)\n" ++
  "      result = result.encode(@internal) if @internal\n" ++
  "      result = result.chomp(separator || $/) if chomp\n" ++
  "      result\n" ++
  "    end\n" ++
  "    def readline(*args, **opts); gets(*args, **opts) || (raise EOFError, 'end of file reached'); end\n" ++
  "    def each(*args, **opts)\n" ++
  "      return to_enum(:each, *args, **opts) unless block_given?\n" ++
  "      while (line = gets(*args, **opts)); yield line; end\n" ++
  "      self\n" ++
  "    end\n" ++
  "    alias each_line each\n" ++
  "    def readlines(*args, **opts); each(*args, **opts).to_a; end\n" ++
  "    def each_byte\n" ++
  "      return to_enum(:each_byte) unless block_given?\n" ++
  "      while (b = getbyte); yield b; end\n" ++
  "      self\n" ++
  "    end\n" ++
  "    def each_char\n" ++
  "      return to_enum(:each_char) unless block_given?\n" ++
  "      while (c = getc); yield c; end\n" ++
  "      self\n" ++
  "    end\n" ++
  "    def rewind\n" ++
  "      __ready\n" ++
  "      @io.seek(-@raw_len, IO::SEEK_CUR)\n" ++
  "      @raw_len = 0\n" ++
  "      @z.close\n" ++
  "      __reset_reader\n" ++
  "      0\n" ++
  "    end\n" ++
  "    def finish\n" ++
  "      __ready\n" ++
  "      @z.close\n" ++
  "      @closed = true\n" ++
  "      @io\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.zcat(io, **opts)\n" ++
  "      out = +''.b\n" ++
  "      loop do\n" ++
  "        gz = new(io, **opts)\n" ++
  "        data = gz.read\n" ++
  "        block_given? ? yield(data) : out << data\n" ++
  "        unused = gz.unused\n" ++
  "        gz.finish\n" ++
  "        break unless unused || (io.respond_to?(:eof?) && !io.eof?)\n" ++
  "        io.seek(-unused.bytesize, IO::SEEK_CUR) if unused\n" ++
  "      end\n" ++
  "      block_given? ? nil : out\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.gzip(str, level: DEFAULT_COMPRESSION, strategy: DEFAULT_STRATEGY)\n" ++
  "    z = Deflate.new(level, MAX_WBITS + 16, DEF_MEM_LEVEL, strategy)\n" ++
  "    begin\n" ++
  "      z.deflate(__string(str), FINISH)\n" ++
  "    ensure\n" ++
  "      z.close unless z.closed?\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.gunzip(str)\n" ++
  "    # A minimal IO keeps this helper independent of StringIO's load order.\n" ++
  "    io = GzipStringIO.new(__string(str).b)\n" ++
  "    gz = GzipReader.new(io, external_encoding: Encoding::ASCII_8BIT)\n" ++
  "    begin\n" ++
  "      gz.read\n" ++
  "    ensure\n" ++
  "      gz.finish unless gz.closed?\n" ++
  "    end\n" ++
  "  end\n" ++
  "  class GzipStringIO\n" ++
  "    def initialize(data); @data = data; @pos = 0; end\n" ++
  "    def read(n)\n" ++
  "      return nil if @pos >= @data.bytesize\n" ++
  "      s = @data.byteslice(@pos, n)\n" ++
  "      @pos += s.bytesize\n" ++
  "      s\n" ++
  "    end\n" ++
  "  end\n" ++
  "  private_constant :GzipStringIO\n" ++
  "end\n";
