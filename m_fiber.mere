// ---- Fibers: one coroutine per fiber ----------------------------------------
//
// The evaluator recurses on the C stack, so suspending a Fiber means leaving
// its C stack where it is and coming back to it later. A fiber's body runs on
// a coroutine -- a second stack on this same thread -- and a fiber "switch"
// is: save what this logical stack owns, hand the thread to the target's
// coroutine, and put our state back when something hands it back.
//
// The half that switches stacks -- the coroutines, the switch, starting a
// fiber -- is m_fiber_coro.mere, imported below; a build without coroutines
// swaps in m_fiber_nothreads.mere (tools/nothreads_tree.sh).
//
// Everything here is world-free on purpose: the part that runs Ruby code
// (the fiber body, resume, yield) lives in the evaluator, and it calls these
// with nothing but fiber indices.
//
// Index 0 is the main thread's root fiber. A Ruby Thread's root fiber gets an
// index when its body starts (see Thread.new); it runs on the stack that
// created it, which is waiting below it, and it is entered in the coroutine
// table the first time it switches away.
//
// (Until 2026-09-28 a fiber was an OS thread and a switch a hand-off over
// channels, which leaned on `spawn` not checking what a top-level function
// touches -- Q-179 in the language's open questions. Nothing here spawns now.)

// "cur": the running logical fiber. "next": the next index to hand out.
// "live": fibers started and not yet terminated. While that is above zero,
// some C stack other than the running one holds values no collection can see,
// so nothing may collect (gc_collect's callers ask fb_live).
let fb_st = map_new ();
// index -> the Fiber object (a Val, so a GC root)
let fb_obj = map_new ();
// index -> the fiber that resumed it, to return to on yield or termination
let fb_parent = map_new ();
// index -> 0 created, 1 resumed, 2 suspended, 3 terminated
let fb_state = map_new ();
// index -> the Thread it belongs to (object id; 0 for the main thread)
let fb_thr = map_new ();
// index -> 1 when it is a thread's root fiber
let fb_root = map_new ();
// index -> 1 once it has transferred (or been transferred to)
let fb_xferd = map_new ();
// what crosses a switch: "v" the value. fb_xk "k": 0 a value, 1 an exception
// the other side must re-raise, 2 an exception to raise AT the yield point
// (Fiber#raise), 3 a kill (Fiber#kill)
let fb_xfer = map_new ();
let fb_xk = map_new ();
// the saved contexts of suspended logical stacks (see fb_ctx_save)
let fb_sv = map_new ();
let fb_si = map_new ();
let fb_ss = map_new ();
let fb_sn = map_new ();

let fb_cur = fn (u: unit) -> if map_has fb_st "cur" then map_get fb_st "cur" else 0;
let fb_live = fn (u: unit) -> if map_has fb_st "live" then map_get fb_st "live" else 0;
let fb_live_add = fn (d: int) -> map_set fb_st "live" (fb_live () + d);
let fb_state_of = fn (i: int) -> if map_has fb_state i then map_get fb_state i else 0;
let fb_new_index = fn (u: unit) ->
  let i = (if map_has fb_st "next" then map_get fb_st "next" else 1) in
  let _ = map_set fb_st "next" (i + 1) in
  i;
// A method frame is live on THIS fiber's stack. live_frames used to hold 1;
// it holds the owner's index + 1 now, because a `break` or `return` aimed at a
// frame on another fiber's stack cannot unwind to it -- the frame is suspended
// somewhere else -- and must be a LocalJumpError instead.
let fb_frame_mark = fn (fid: int) -> map_set live_frames fid (fb_cur () + 1);
let fb_frame_live = fn (fid: int) ->
  map_has live_frames fid && map_get live_frames fid == fb_cur () + 1;

// Each fiber owns a band of call depths, so the tables keyed by depth
// (call_names_s, call_lines, ...) never collide between two stacks, and the
// recursion guard counts from the band's base. 20000 is above the guard.
let fb_band = 20000;
let fb_depth_base = fn (u: unit) -> if map_has struct_ctr "base" then map_get struct_ctr "base" else 0;

// ---- saving what a logical stack owns --------------------------------------
// The interpreter keeps its per-stack state in global maps (the depth, the
// flow signal in flight, the exception in flight, the catch tags, $~ ...),
// written as though there were one stack. At a switch the leaving stack's
// entries are copied out, keyed by its index, and put back when it resumes.
// Whole maps for the small ones that are per-stack through and through; single
// keys for maps that also hold process-wide entries.
let fb_key = fn (f: int) -> fn (t: str) -> str_of_int f ++ "|" ++ t;
let fb_save_sv = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let _ = map_set fb_sn b 0 in
  map_iter tbl (fn (k: str) -> fn (v: Val) ->
    let n = map_get fb_sn b in
    let _ = map_set fb_ss (b ++ "#" ++ str_of_int n) k in
    let _ = map_set fb_sv (b ++ "=" ++ k) v in
    map_set fb_sn b (n + 1));
let fb_restore_sv = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let n = (if map_has fb_sn b then map_get fb_sn b else 0) in
  let _ = map_clear tbl in
  let rec go = fn (i: int) ->
    if i >= n then ()
    else (let kk = b ++ "#" ++ str_of_int i in
          let k = map_get fb_ss kk in
          let _ = map_set tbl k (map_get fb_sv (b ++ "=" ++ k)) in
          let _ = map_delete fb_ss kk in
          let _ = map_delete fb_sv (b ++ "=" ++ k) in
          go (i + 1)) in
  let _ = go 0 in
  map_delete fb_sn b;
let fb_save_si = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let _ = map_set fb_sn b 0 in
  map_iter tbl (fn (k: str) -> fn (v: int) ->
    let n = map_get fb_sn b in
    let _ = map_set fb_ss (b ++ "#" ++ str_of_int n) k in
    let _ = map_set fb_si (b ++ "=" ++ k) v in
    map_set fb_sn b (n + 1));
let fb_restore_si = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let n = (if map_has fb_sn b then map_get fb_sn b else 0) in
  let _ = map_clear tbl in
  let rec go = fn (i: int) ->
    if i >= n then ()
    else (let kk = b ++ "#" ++ str_of_int i in
          let k = map_get fb_ss kk in
          let _ = map_set tbl k (map_get fb_si (b ++ "=" ++ k)) in
          let _ = map_delete fb_ss kk in
          let _ = map_delete fb_si (b ++ "=" ++ k) in
          go (i + 1)) in
  let _ = go 0 in
  map_delete fb_sn b;
let fb_save_ss = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let _ = map_set fb_sn b 0 in
  map_iter tbl (fn (k: str) -> fn (v: str) ->
    let n = map_get fb_sn b in
    let _ = map_set fb_ss (b ++ "#" ++ str_of_int n) k in
    let _ = map_set fb_ss (b ++ "=" ++ k) v in
    map_set fb_sn b (n + 1));
let fb_restore_ss = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let n = (if map_has fb_sn b then map_get fb_sn b else 0) in
  let _ = map_clear tbl in
  let rec go = fn (i: int) ->
    if i >= n then ()
    else (let kk = b ++ "#" ++ str_of_int i in
          let k = map_get fb_ss kk in
          let _ = map_set tbl k (map_get fb_ss (b ++ "=" ++ k)) in
          let _ = map_delete fb_ss kk in
          let _ = map_delete fb_ss (b ++ "=" ++ k) in
          go (i + 1)) in
  let _ = go 0 in
  map_delete fb_sn b;
// one key of a map that is otherwise process-wide
let fb_save_k = fn (f: int) -> fn (t: str) -> fn tbl -> fn (k: str) ->
  let kk = fb_key f t ++ "=" ++ k in
  if map_has tbl k then (let _ = map_set fb_sv kk (map_get tbl k) in map_set fb_si (kk ++ "?") 1)
  else map_set fb_si (kk ++ "?") 0;
let fb_restore_k = fn (f: int) -> fn (t: str) -> fn tbl -> fn (k: str) ->
  let kk = fb_key f t ++ "=" ++ k in
  let had = (if map_has fb_si (kk ++ "?") then map_get fb_si (kk ++ "?") else 0) in
  let _ = (if had == 1 then map_set tbl k (map_get fb_sv kk)
           else if map_has tbl k then map_delete tbl k else ()) in
  let _ = (if map_has fb_sv kk then map_delete fb_sv kk else ()) in
  map_delete fb_si (kk ++ "?");

// the match globals: $! $~ $_ and $1..$9
let fb_gvar_keys = Cons ("!", Cons ("~", Cons ("_", Cons ("1", Cons ("2", Cons ("3",
  Cons ("4", Cons ("5", Cons ("6", Cons ("7", Cons ("8", Cons ("9", Nil))))))))))));
let rec fb_save_gvars = fn (f: int) -> fn (ks: str list) ->
  match ks with Nil -> () | Cons (k, r) -> let _ = fb_save_k f "g" globals k in fb_save_gvars f r;
let rec fb_restore_gvars = fn (f: int) -> fn (ks: str list) ->
  match ks with Nil -> () | Cons (k, r) -> let _ = fb_restore_k f "g" globals k in fb_restore_gvars f r;

// ⚠ Most of these maps are EMPTY at most switches, and the first version wrote
// a record for every one anyway -- a key string built and a map written per
// map, four times per round trip: 37 us per Enumerator#next against 4.6 us for
// the thread hand-off itself. Now each stack's saved state carries a mask of
// what was actually there (fb_mask), an empty map writes nothing, and on the
// way back an unsaved map is only emptied if something has put entries in it.
let fb_mask = map_new ();
let rec fb_pow2 = fn (b: int) -> if b <= 0 then 1 else 2 * fb_pow2 (b - 1);
let fb_bit_on = fn (m: int) -> fn (b: int) -> (m / fb_pow2 b) % 2 == 1;
let fb_msave_sv = fn (f: int) -> fn (b: int) -> fn (t: str) -> fn tbl -> fn (m: int) ->
  if map_len tbl == 0 then m else (let _ = fb_save_sv f t tbl in m + fb_pow2 b);
let fb_mrestore_sv = fn (f: int) -> fn (b: int) -> fn (t: str) -> fn tbl -> fn (m: int) ->
  if fb_bit_on m b then fb_restore_sv f t tbl
  else if map_len tbl > 0 then map_clear tbl else ();
let fb_msave_si = fn (f: int) -> fn (b: int) -> fn (t: str) -> fn tbl -> fn (m: int) ->
  if map_len tbl == 0 then m else (let _ = fb_save_si f t tbl in m + fb_pow2 b);
let fb_mrestore_si = fn (f: int) -> fn (b: int) -> fn (t: str) -> fn tbl -> fn (m: int) ->
  if fb_bit_on m b then fb_restore_si f t tbl
  else if map_len tbl > 0 then map_clear tbl else ();
let fb_msave_ss = fn (f: int) -> fn (b: int) -> fn (t: str) -> fn tbl -> fn (m: int) ->
  if map_len tbl == 0 then m else (let _ = fb_save_ss f t tbl in m + fb_pow2 b);
let fb_mrestore_ss = fn (f: int) -> fn (b: int) -> fn (t: str) -> fn tbl -> fn (m: int) ->
  if fb_bit_on m b then fb_restore_ss f t tbl
  else if map_len tbl > 0 then map_clear tbl else ();
// one key: present -> saved and its bit set; absent -> nothing written
let fb_msave_k = fn (f: int) -> fn (b: int) -> fn tbl -> fn (k: str) -> fn (m: int) ->
  if map_has tbl k then (let _ = map_set fb_sv (fb_key f "k" ++ "=" ++ k) (map_get tbl k) in m + fb_pow2 b) else m;
let fb_mrestore_k = fn (f: int) -> fn (b: int) -> fn tbl -> fn (k: str) -> fn (m: int) ->
  if fb_bit_on m b
  then (let kk = fb_key f "k" ++ "=" ++ k in
        let _ = map_set tbl k (map_get fb_sv kk) in
        map_delete fb_sv kk)
  else if map_has tbl k then map_delete tbl k else ();
let fb_msave_ki = fn (f: int) -> fn (b: int) -> fn tbl -> fn (k: str) -> fn (m: int) ->
  if map_has tbl k then (let _ = map_set fb_si (fb_key f "sc" ++ "=" ++ k) (map_get tbl k) in m + fb_pow2 b) else m;
let fb_mrestore_ki = fn (f: int) -> fn (b: int) -> fn tbl -> fn (k: str) -> fn (m: int) ->
  if fb_bit_on m b
  then (let kk = fb_key f "sc" ++ "=" ++ k in
        let _ = map_set tbl k (map_get fb_si kk) in
        map_delete fb_si kk)
  else if map_has tbl k then map_delete tbl k else ();

// the whole-map slots (bits 0-20), then single keys (21-40); the order is the
// bit, so save and restore must list them alike
let rec fb_msave_gvars = fn (f: int) -> fn (b: int) -> fn (ks: str list) -> fn (m: int) ->
  match ks with Nil -> m | Cons (k, r) -> fb_msave_gvars f (b + 1) r (fb_msave_k f b globals k m);
let rec fb_mrestore_gvars = fn (f: int) -> fn (b: int) -> fn (ks: str list) -> fn (m: int) ->
  match ks with Nil -> () | Cons (k, r) -> let _ = fb_mrestore_k f b globals k m in fb_mrestore_gvars f (b + 1) r m;
let fb_ctx_save = fn (f: int) ->
  let m = fb_msave_sv f 0 "tf" thread_flag 0 in
  let m = fb_msave_sv f 1 "fs" flow_sig m in
  let m = fb_msave_sv f 2 "pm" prim_missing m in
  let m = fb_msave_sv f 3 "bt" raise_bt m in
  let m = fb_msave_sv f 4 "ph" pending_home m in
  let m = fb_msave_sv f 5 "lc" load_ctx m in
  let m = fb_msave_sv f 6 "fz" frz_busy m in
  let m = fb_msave_sv f 7 "fk" fm_kw m in
  let m = fb_msave_sv f 8 "bb" bm_bypass m in
  let m = fb_msave_sv f 9 "cd" catch_depth m in
  let m = fb_msave_sv f 10 "ra" ref_active m in
  let m = fb_msave_sv f 11 "ct" cur_thr m in
  let m = fb_msave_si f 12 "cp" cur_pos m in
  let m = fb_msave_si f 13 "bo" blk_ok m in
  let m = fb_msave_si f 14 "ps" pending_srcproc m in
  let m = fb_msave_si f 15 "cs" conv_soft m in
  let m = fb_msave_si f 16 "gb" gc_bare m in
  let m = fb_msave_ss f 17 "cq" cur_pos_s m in
  let m = fb_msave_ss f 18 "xc" lex_cref m in
  let m = fb_msave_ss f 19 "xn" lex_nest m in
  let m = fb_msave_ss f 20 "fl" fsl_ctx m in
  let m = fb_msave_gvars f 21 fb_gvar_keys m in
  let m = fb_msave_k f 33 ivars_g "$exc" m in
  let m = fb_msave_k f 34 trace_fn "busy" m in
  let m = fb_msave_k f 35 trace_fn "tpbusy" m in
  let m = fb_msave_k f 36 trace_fn "gvbusy" m in
  let m = fb_msave_ki f 37 struct_ctr "cd" m in
  let m = fb_msave_ki f 38 struct_ctr "base" m in
  let m = (if map_has rx_wide 1 then (let _ = map_set fb_si (fb_key f "rw") (map_get rx_wide 1) in m + fb_pow2 39) else m) in
  let _ = map_set fb_mask f m in
  // the gc_bare baton must not leak to another stack: a method entered there
  // would skip its unsafe push
  (if map_len gc_bare > 0 then map_clear gc_bare else ());
let fb_ctx_restore = fn (f: int) ->
  let m = (if map_has fb_mask f then map_get fb_mask f else 0) in
  let _ = fb_mrestore_sv f 0 "tf" thread_flag m in
  let _ = fb_mrestore_sv f 1 "fs" flow_sig m in
  let _ = fb_mrestore_sv f 2 "pm" prim_missing m in
  let _ = fb_mrestore_sv f 3 "bt" raise_bt m in
  let _ = fb_mrestore_sv f 4 "ph" pending_home m in
  let _ = fb_mrestore_sv f 5 "lc" load_ctx m in
  let _ = fb_mrestore_sv f 6 "fz" frz_busy m in
  let _ = fb_mrestore_sv f 7 "fk" fm_kw m in
  let _ = fb_mrestore_sv f 8 "bb" bm_bypass m in
  let _ = fb_mrestore_sv f 9 "cd" catch_depth m in
  let _ = fb_mrestore_sv f 10 "ra" ref_active m in
  let _ = fb_mrestore_sv f 11 "ct" cur_thr m in
  let _ = fb_mrestore_si f 12 "cp" cur_pos m in
  let _ = fb_mrestore_si f 13 "bo" blk_ok m in
  let _ = fb_mrestore_si f 14 "ps" pending_srcproc m in
  let _ = fb_mrestore_si f 15 "cs" conv_soft m in
  let _ = fb_mrestore_si f 16 "gb" gc_bare m in
  let _ = fb_mrestore_ss f 17 "cq" cur_pos_s m in
  let _ = fb_mrestore_ss f 18 "xc" lex_cref m in
  let _ = fb_mrestore_ss f 19 "xn" lex_nest m in
  let _ = fb_mrestore_ss f 20 "fl" fsl_ctx m in
  let _ = fb_mrestore_gvars f 21 fb_gvar_keys m in
  let _ = fb_mrestore_k f 33 ivars_g "$exc" m in
  let _ = fb_mrestore_k f 34 trace_fn "busy" m in
  let _ = fb_mrestore_k f 35 trace_fn "tpbusy" m in
  let _ = fb_mrestore_k f 36 trace_fn "gvbusy" m in
  let _ = fb_mrestore_ki f 37 struct_ctr "cd" m in
  let _ = fb_mrestore_ki f 38 struct_ctr "base" m in
  let rk = fb_key f "rw" in
  let _ = (if fb_bit_on m 39 then (let _ = map_set rx_wide 1 (map_get fb_si rk) in map_delete fb_si rk)
           else if map_has rx_wide 1 then map_delete rx_wide 1 else ()) in
  map_delete fb_mask f;

// A fiber's first run starts from the resumer's state with the per-stack
// parts emptied: no flow or exception in flight, no catch tags, not "directly
// inside a Thread block", its own depth band, and the match globals unset.
let rec fb_clear_gvars = fn (ks: str list) ->
  match ks with Nil -> () | Cons (k, r) -> let _ = (if map_has globals k then map_delete globals k else ()) in fb_clear_gvars r;
let fb_ctx_fresh = fn (idx: int) ->
  let _ = map_clear thread_flag in
  let _ = map_clear flow_sig in
  let _ = map_clear prim_missing in
  let _ = map_clear raise_bt in
  let _ = map_clear pending_home in
  let _ = map_clear frz_busy in
  let _ = map_clear fm_kw in
  let _ = map_clear bm_bypass in
  let _ = map_clear catch_depth in
  let _ = map_clear pending_srcproc in
  let _ = map_clear conv_soft in
  let _ = map_clear gc_bare in
  let _ = fb_clear_gvars fb_gvar_keys in
  let _ = (if map_has ivars_g "$exc" then map_delete ivars_g "$exc" else ()) in
  let _ = (if map_has trace_fn "busy" then map_delete trace_fn "busy" else ()) in
  let _ = (if map_has trace_fn "tpbusy" then map_delete trace_fn "tpbusy" else ()) in
  let _ = (if map_has trace_fn "gvbusy" then map_delete trace_fn "gvbusy" else ()) in
  let _ = (if map_has rx_wide 1 then map_delete rx_wide 1 else ()) in
  // the base is one ABOVE the band's start: the body's block is entered at the
  // start and is the bottom frame of this stack -- a fiber's backtrace is its
  // own frames only, and `caller` in the block is empty, as in ruby
  let _ = map_set struct_ctr "cd" (idx * fb_band) in
  map_set struct_ctr "base" (idx * fb_band + 1);

// index -> the fiber's storage Hash (a Val, so a GC root); absent = none yet
let fb_storage = map_new ();
// Thread (object id, 0 = main) -> its Fiber scheduler (a Val, so a GC root)
let fb_sched = map_new ();
// index -> 1 for a fiber made with blocking: true
let fb_blocking = map_new ();
// index -> where a fiber entered by transfer returns when it ends
let fb_ret = map_new ();
// index -> 1 while it is suspended in a #transfer (it may be transferred back to;
// a fiber suspended in Fiber.yield may not)
let fb_sus_x = map_new ();

// put saved entries back OVER a map without emptying it first (the carried
// exception's report fields, laid over the receiver's own)
let fb_overlay_sv = fn (f: int) -> fn (t: str) -> fn tbl ->
  let b = fb_key f t in
  let n = (if map_has fb_sn b then map_get fb_sn b else 0) in
  let rec go = fn (i: int) ->
    if i >= n then ()
    else (let kk = b ++ "#" ++ str_of_int i in
          let k = map_get fb_ss kk in
          let _ = map_set tbl k (map_get fb_sv (b ++ "=" ++ k)) in
          let _ = map_delete fb_ss kk in
          let _ = map_delete fb_sv (b ++ "=" ++ k) in
          go (i + 1)) in
  let _ = go 0 in
  map_delete fb_sn b;

// ---- what a half-evaluated statement holds -----------------------------------
// A suspended stack's frames are each in the middle of a statement, and what a
// statement has built but not stored yet is held by a C variable only: the
// array a `map` is still filling, an argument already evaluated, the left side
// of an operator. No mark sees those. But every allocation takes its id from a
// counter that only grows -- objects, arrays, strings, hashes -- so "built by
// this frame's statement so far" is an interval of ids: from where the
// statement began to where the frame last called into what is running above
// it. Those intervals are roots: for every suspended stack, and -- in the pass
// that runs in the middle of a statement -- for the running one, whose
// innermost frame's interval runs to now.
// Keyed by depth * 8 + k: 0-3 the four counters where the statement began,
// 4-7 where the frame last called in. What this cannot see is a value that was
// reachable when the statement began and is held only by a C variable since
// (`[q.pop, Fiber.yield]`); seeing that takes a scan of the stack itself.
let fb_wm = map_new ();
let fb_wm_now = fn (k: int) ->
  if k == 0 then (if map_has oid_next "n" then map_get oid_next "n" else handle_base)
  else if k == 1 then (if map_has arr_ctr 0 then map_get arr_ctr 0 else handle_base)
  else if k == 2 then handle_base + vec_len str_store
  else handle_base + vec_len hash_store;
let fb_wm_put = fn (b: int) ->
  let _ = map_set fb_wm b (if map_has oid_next "n" then map_get oid_next "n" else handle_base) in
  let _ = map_set fb_wm (b + 1) (if map_has arr_ctr 0 then map_get arr_ctr 0 else handle_base) in
  let _ = map_set fb_wm (b + 2) (handle_base + vec_len str_store) in
  map_set fb_wm (b + 3) (handle_base + vec_len hash_store);
let fb_cd = fn (u: unit) -> if map_has struct_ctr "cd" then map_get struct_ctr "cd" else 0;
// a statement begins in the innermost frame
let fb_wm_stmt = fn (u: unit) -> fb_wm_put ((fb_cd () - 1) * 8);
// the frame at depth d calls into a method or a block, or switches away
let fb_wm_call = fn (d: int) -> fb_wm_put (d * 8 + 4);
// ---- starting a fiber -------------------------------------------------------
// The body is a closure the evaluator registers here, and the coroutine is
// made by a top-level function that captures nothing but an index. The body
// runs only when the resumer switches to it.
let fb_bodies = map_new ();
import "m_fiber_coro.mere";

// ---- the envs of every stack, by depth ------------------------------------
// A suspended fiber's locals live in env maps that only its own C stack points
// at, so no mark can see them. Every method frame and block env is written
// here at its call depth on entry -- one write, no delete: a stack's LIVE
// frames are exactly the depths from its band's base up to its current depth,
// and what lies above that is stale and never read. Written always, not only
// once a fiber exists, because a frame entered before the first fiber is as
// live as any (the reclaim pass may run in the middle of a method now).
let fb_env_at = map_new ();
// the reclaim pass's view of the roots: the body procs and the active blocks
// of the suspended fibers, left out of the scan until their fiber is reached
let fb_rc_pid = map_new ();
let fb_rc_eid = map_new ();
// call f on each live env of stack i: the running one reads the live depth,
// a suspended one the depth it saved when it switched away
// the live depths of stack i, bottom up: the running one reads the live depth,
// a suspended one the depth it saved when it switched away; the main stack's
// top level is depth -1
// where a suspended stack stopped: the line and file it saved (cur_pos "l",
// cur_pos_s "f"), for the top frame of its backtrace
let fb_saved_pos = fn (f: int) ->
  let kl = fb_key f "cp" ++ "=l" in
  let kf = fb_key f "cq" ++ "=f" in
  ((if map_has fb_si kl then map_get fb_si kl else 0), (if map_has fb_ss kf then map_get fb_ss kf else ""));
let fb_stack_lohi = fn (i: int) ->
  let running = i == fb_cur () in
  let lo = (if running then fb_depth_base ()
            else (let k = fb_key i "sc" ++ "=base" in if map_has fb_si k then map_get fb_si k else 0)) in
  let hi = (if running then (if map_has struct_ctr "cd" then map_get struct_ctr "cd" else 0)
            else (let k = fb_key i "sc" ++ "=cd" in if map_has fb_si k then map_get fb_si k else lo)) in
  ((if lo > 0 then lo - 1 else 0), hi);
let fb_stack_depths = fn (i: int) -> fn f ->
  let (lo2, hi) = fb_stack_lohi i in
  let _ = (if i == 0 then f (0 - 1) else ()) in
  let rec go = fn (d: int) ->
    if d >= hi then () else (let _ = f d in go (d + 1)) in
  go lo2;
// call f on each live env of stack i
let fb_stack_envs = fn (i: int) -> fn f ->
  fb_stack_depths i (fn (d: int) -> if map_has fb_env_at d then f (map_get fb_env_at d) else ());

// call f kind id on every id the live frames of stack i have built mid-statement
let fb_stack_wm = fn (i: int) -> fn f ->
  let running = i == fb_cur () in
  let (lo2, hi) = fb_stack_lohi i in
  let top = (if hi - 1 >= lo2 then hi - 1 else 0 - 1) in
  fb_stack_depths i (fn (d: int) ->
    let rec kinds = fn (k: int) ->
      if k >= 4 then ()
      else (let b = d * 8 + k in
            let lo = (if map_has fb_wm b then map_get fb_wm b else handle_base) in
            let up = (if running && d == top then fb_wm_now k
                      else if map_has fb_wm (b + 4) then map_get fb_wm (b + 4) else lo) in
            let rec each = fn (n: int) -> if n >= up then () else (let _ = f k n in each (n + 1)) in
            let _ = each lo in
            kinds (k + 1)) in
    kinds 0);

// abandoning a fiber nobody can reach: it is switched to with a kind that makes
// it unwind with nothing running on the way (fb_st "abandon" makes rescue and
// ensure step aside), and its coroutine ends. ruby never runs an unreachable
// fiber's ensure either; the collector frees it.
let fb_abandon = fn (i: int) ->
  let me = fb_cur () in
  let _ = (if map_has fb_xferd i then map_delete fb_xferd i else ()) in
  let _ = map_set fb_parent i me in
  let _ = map_set fb_state i 1 in
  let _ = map_set fb_xk "k" 4 in
  let _ = fb_switch me i in
  map_set fb_state me 1;
