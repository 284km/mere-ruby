// Explicit native roots for Ruby values. Only positive signed 32-bit tokens
// cross extern fn; C never receives a pointer into a Mere-owned arena.
//
// Storage slots are reused, but a token is never issued twice in this VM.
// Exhaustion fails before changing the table, rather than wrapping into a
// stale token. A second retain of the same value has its own release.
// This table belongs to the interpreter thread; it is not a concurrent API.
let native_handle_max = 2147483647;
let native_handle_values = map_new ();
let _ = map_compact native_handle_values;
let native_handle_ids = map_new ();
let _ = map_compact native_handle_ids;
let native_handle_slots = vec_new ();
let native_handle_free = vec_new ();
// next token, occupied prefix of free-slot stack
let native_handle_counters = vec_new ();
let _ = vec_push native_handle_counters 1;
let _ = vec_push native_handle_counters 0;

let native_handle_valid = fn (token: int) ->
  token > 0 && token <= native_handle_max && map_has native_handle_ids token;

let native_handle_retain = fn (value: Val) ->
  let token = vec_get native_handle_counters 0 in
  if token <= 0 || token > native_handle_max then 0
  else
    let free_n = vec_get native_handle_counters 1 in
    let slot = if free_n > 0 then vec_get native_handle_free (free_n - 1)
               else vec_len native_handle_slots in
    let _ = map_set native_handle_values slot value in
    let _ = map_set native_handle_ids token slot in
    let _ = if free_n > 0 then
              (let _ = vec_set native_handle_counters 1 (free_n - 1) in
               vec_set native_handle_slots slot token)
            else vec_push native_handle_slots token in
    let _ = vec_set native_handle_counters 0 (token + 1) in
    token;

let native_handle_get = fn (token: int) ->
  if native_handle_valid token then
    map_get native_handle_values (map_get native_handle_ids token)
  else fail "native handle is invalid or released";

let native_handle_update = fn (token: int) -> fn (value: Val) ->
  if native_handle_valid token then
    (let _ = map_set native_handle_values (map_get native_handle_ids token) value in true)
  else false;

let native_handle_release = fn (token: int) ->
  if native_handle_valid token then
    (let slot = map_get native_handle_ids token in
     let _ = map_delete native_handle_values slot in
     let _ = map_delete native_handle_ids token in
     let _ = vec_set native_handle_slots slot 0 in
     let free_n = vec_get native_handle_counters 1 in
     let _ = if free_n < vec_len native_handle_free then vec_set native_handle_free free_n slot
             else vec_push native_handle_free slot in
     let _ = vec_set native_handle_counters 1 (free_n + 1) in
     true)
  else false;

let native_handle_count = fn (u: unit) -> map_len native_handle_ids;
let native_handle_capacity = fn (u: unit) -> vec_len native_handle_slots;
let native_handle_bytes = fn (u: unit) ->
  map_bytes native_handle_values + map_bytes native_handle_ids;
// Called at the GC's existing safe compaction point, never from release.
// A Val returned to the evaluator can otherwise still point into this arena.
let native_handle_compact = fn (u: unit) ->
  let _ = map_compact native_handle_values in
  map_compact native_handle_ids;
