  let _ = map_set consts "Float::MIN" (VFlt 2.2250738585072014e-308) in
  let _ = map_set consts "Float::MAX" (VFlt 1.7976931348623157e308) in
  let _ = map_set consts "Float::EPSILON" (VFlt 2.220446049250313e-16) in
