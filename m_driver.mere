  let _ = map_set sup "ThreadError" "StandardError" in
  let _ = map_set sup "fatal" "Exception" in
  let _ = map_set sup "ClosedQueueError" "StopIteration" in
  let _ = map_set sup "FiberError" "StandardError" in
  let _ = map_set sup "LocalJumpError" "StandardError" in
  let _ = map_set sup "UncaughtThrowError" "ArgumentError" in
  let _ = map_set sup "NoMatchingPatternError" "StandardError" in
  let _ = map_set sup "NoMatchingPatternKeyError" "NoMatchingPatternError" in
  let _ = map_set sup "NoMemoryError" "Exception" in
  let _ = map_set sup "SecurityError" "Exception" in
  let _ = map_set sup "SystemStackError" "Exception" in
  let _ = map_set sup "SystemExit" "Exception" in
  let _ = map_set sup "SignalException" "Exception" in
  let _ = map_set sup "Interrupt" "SignalException" in
