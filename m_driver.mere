  // ruby 3.1+ has Set without a require: the constant is an autoload of the
  // library mere-ruby ships. (`to_set` triggers the same load, in invoke_val_c.)
  let _ = map_set autoloads "Set" (mkstr "set") in
  // ruby 4.0 made Pathname core as well: the constant is there before any
  // require (the file still exists, so `require "pathname"` stays true).
  let _ = map_set autoloads "Pathname" (mkstr "pathname") in
