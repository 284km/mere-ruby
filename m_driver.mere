  // `.equal?` accidentally true while `object_id` disagreed, and `$-I` was a
  // slot of its own that nothing kept in step.
  let galias = fn (a: str) -> fn (b: str) -> map_set gvar_alias a (mkstr b) in
  let _ = galias "LOAD_PATH" ":" in
  let _ = galias "-I" ":" in
  let _ = galias "LOADED_FEATURES" "\"" in
  let _ = galias "PROGRAM_NAME" "0" in
  let _ = galias "-0" "/" in
  let _ = galias "-d" "DEBUG" in
  let _ = galias "-v" "VERBOSE" in
  let _ = galias "-w" "VERBOSE" in
