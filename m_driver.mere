  // generator behind it is ruby source (stdlib_src "data") rather than a
  // second copy of Struct's machinery in the dispatcher.
  let _ = map_set autoloads "Data" (mkstr "data") in
  // ...and Enumerator::Product the same way. The constant is reached through
  // the scope operator, and autoload_fire is asked with the whole path.
  let _ = map_set autoloads "Enumerator::Product" (mkstr "enumerator_product") in
  // Base64 is NOT autoloaded in ruby (it needs a require), so no entry here --
  // only stdlib_src carries it.
  let _ = map_set includes "Array" "Enumerable" in
  let _ = map_set includes "Hash" "Enumerable" in
  let _ = map_set includes "Range" "Enumerable" in
  let _ = map_set includes "Struct" "Enumerable" in
  let _ = map_set includes "Enumerator" "Enumerable" in
  let _ = map_set includes "Object" "Kernel" in
  // Refinement is a subclass of Module (ruby 3.2+).
