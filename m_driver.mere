  let _ = map_set includes "Array" "Enumerable" in
  let _ = map_set includes "Hash" "Enumerable" in
  let _ = map_set includes "Range" "Enumerable" in
  let _ = map_set includes "Struct" "Enumerable" in
  let _ = map_set includes "Enumerator" "Enumerable" in
  let _ = map_set includes "Object" "Kernel" in
