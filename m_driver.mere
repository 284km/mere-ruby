// The driver: where an error is reported from (err_where), how a script is
// read and run (run_src), and the command line that chooses between them.
//
// A MODULE, spliced by `import` where these chains used to sit. `import`
// is an AST splice, not a separate scope: this file sees everything
// declared above the import point and nothing below it -- which is what
// these chains already had, since they are the last thing in the program.
// The main expression itself stays in main.mere, because that is what
// makes main.mere the program.
let err_where = fn (name: str) ->
  let f = (if map_has prim_missing "f" then (match map_get prim_missing "f" with VStr h -> sget h | _ -> "") else "") in
  let rf = (if map_has prim_missing "rf" then (match map_get prim_missing "rf" with VStr h -> sget h | _ -> "") else "") in
  let file = (if (if str_eq rf "" then false else true) then rf
              else if str_eq f "" || str_eq f name then name else f) in
  // ruby writes `file:line:in `meth\': message`, at the RAISE site
  let ln = (if map_has prim_missing "rl" then (match map_get prim_missing "rl" with VInt n -> n | _ -> cur_line ()) else cur_line ()) in
  let m = (if map_has prim_missing "rm" then (match map_get prim_missing "rm" with VStr h -> sget h | _ -> cur_meth ()) else cur_meth ()) in
  let where = (if ln > 0 then file ++ ":" ++ str_of_int ln else file) in
  if str_eq m "" then where else where ++ ":in '" ++ meth_label m ++ "'";

// ObjectSpace::WeakMap: a Hash that does not keep its keys alive. mere-ruby
// frees nothing, so the weakness has no observable effect here -- what matters
// is that the class EXISTS, because activesupport's DescendantsTracker builds
// one at load time and railties stops there otherwise.
let core_prelude_a =
  // ruby 4.0's toplevel `Ruby` module: the identity constants again, and
  // Ruby::Box, which is never enabled here (RUBY_BOX is a CRuby build switch).
  "module Ruby\n" ++
  "  VERSION = RUBY_VERSION\n" ++
  "  PATCHLEVEL = RUBY_PATCHLEVEL\n" ++
  "  RELEASE_DATE = RUBY_RELEASE_DATE\n" ++
  "  REVISION = RUBY_REVISION\n" ++
  "  ENGINE = RUBY_ENGINE\n" ++
  "  ENGINE_VERSION = RUBY_ENGINE_VERSION\n" ++
  "  PLATFORM = RUBY_PLATFORM\n" ++
  "  DESCRIPTION = RUBY_DESCRIPTION\n" ++
  "  COPYRIGHT = RUBY_COPYRIGHT\n" ++
  "  class Box\n" ++
  "    def self.enabled?; false; end\n" ++
  "    def self.current; nil; end\n" ++
  "  end\n" ++
  "end\n" ++
  // ruby 4.0: Pathname is core, so `Pathname(x)` -- and `Kernel.Pathname(x)`,
  // and `obj.send(:Pathname, x)` -- work before anything has required it. The
  // library is shipped behind an autoload (see autoloads "Pathname") and its
  // `module Kernel; def Pathname` REPLACES this stub when it loads, so the
  // stub only has to get it loaded and ask again.
  "module Kernel\n" ++
  "  def Pathname(path)\n" ++
  "    require \"pathname\"\n" ++
  "    Pathname(path)\n" ++
  "  end\n" ++
  "end\n" ++
  // A Numeric refuses to gain a singleton method, and it refuses BY DEFINING
  // THE HOOK -- which is why `class Sub < Numeric; def singleton_method_added(n); end; end`
  // (ruby/spec's own fixture, so that its methods can be mocked) makes it
  // allowed again, and `remove_method :singleton_method_added` makes it refuse
  // again. A rule written in the interpreter could not be removed by ruby code.
  // It is written in ruby, and not in the dispatcher, for the same reason; the
  // rest of Numeric's methods are the other way round (see invoke_val_c),
  // because those names have Integer and Float builtins that must keep winning
  // and this one has none.
  // The message quotes the method name, and the quote is built rather than
  // escaped: a `\"` here would have to survive both this string and ruby's lexer.
  "class Numeric\n" ++
  "  def singleton_method_added(name)\n" ++
  "    q = '\"'\n" ++
  "    raise TypeError, \"can't define singleton method \" + q + name.to_s + q + \" for \" + self.class.to_s\n" ++
  "  end\n" ++
  "end\n";

let core_prelude_b =
  // Enumerable, driven by the receiver's own #each rather than by a
  // materialised copy of it. Two things only this shape can do: a multi-value
  // yield reaches the block as SEVERAL arguments (so a one-parameter block
  // takes the first, as ruby's does), and a walk stops when the answer is
  // known -- `take_while` on a five-element receiver walks three.
  //
  // It is a module of its own rather than a reopening of Enumerable because
  // Array, Hash and Range include Enumerable too, and their own methods are
  // primitives that must keep answering. do_include puts this one BEHIND
  // Enumerable for a class that includes it, so a program that redefines
  // Enumerable#map still wins.
  "module Enumerable__Impl\n" ++
  "  def __gather(args)\n" ++
  "    args.size <= 1 ? args[0] : args\n" ++
  "  end\n" ++
  "\n" ++
  // ruby converts a count with #to_int and refuses in its own words -- a
  // NoMethodError from a bare `n.to_int` names the wrong thing.
  "  def __int!(n)\n" ++
  "    return n if n.is_a?(Integer)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + n.class.to_s + \" into Integer\" unless n.respond_to?(:to_int)\n" ++
  "    v = n.to_int\n" ++
  "    raise TypeError, \"can't convert \" + n.class.to_s + \" to Integer (\" + n.class.to_s + \"#to_int gives \" + v.class.to_s + \")\" unless v.is_a?(Integer)\n" ++
  "    v\n" ++
  "  end\n" ++
  "\n" ++
  // the bounds ruby's own C signatures carry: a *-parameter here would accept
  // what ruby refuses, and ten spec files ask for exactly that refusal.
  "  def __arity!(given, lo, hi)\n" ++
  "    return if given >= lo && given <= hi\n" ++
  "    range = lo == hi ? lo.to_s : lo.to_s + \"..\" + hi.to_s\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + given.to_s + \", expected \" + range + \")\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def to_a(*outer)\n" ++
  "    acc = []\n" ++
  "    each(*outer) \{ |*args| acc.push(__gather(args)) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def entries(*outer); to_a(*outer); end\n" ++
  "\n" ++
  "  def map\n" ++
  "    return to_enum(:map) unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| acc.push(yield(*args)) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def collect(&b); map(&b); end\n" ++
  "\n" ++
  "  def flat_map\n" ++
  "    return to_enum(:flat_map) unless block_given?\n" ++
  "    acc = []\n" ++
  "    each do |*args|\n" ++
  "      v = yield(*args)\n" ++
  "      if v.respond_to?(:to_ary)\n" ++
  "        a = v.to_ary\n" ++
  // ⚠ a NIL conversion means "append it as it is" (ruby's
  //   rb_check_array_type), not a refusal -- only a non-Array, non-nil answer
  //   is the TypeError. Refusing nil here is what made `enum.flat_map { obj }`
  //   raise for an object whose #to_ary answers nil, while the same element in
  //   an ARRAY receiver went through the interpreter's own walk and was
  //   appended. One rule, two implementations, and this was the second one.
  "        raise TypeError, \"can't convert \" + v.class.to_s + \" to Array (\" + v.class.to_s + \"#to_ary gives \" + a.class.to_s + \")\" unless a.is_a?(Array) || a.nil?\n" ++
  "        if a.nil? then acc.push(v) else a.each \{ |x| acc.push(x) } end\n" ++
  "      else\n" ++
  "        acc.push(v)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def collect_concat(&b); flat_map(&b); end\n" ++
  "\n" ++
  "  def select\n" ++
  "    return to_enum(:select) unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| v = __gather(args); acc.push(v) if yield(v) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def filter(&b); select(&b); end\n" ++
  "  def find_all(&b); select(&b); end\n" ++
  "\n" ++
  "  def reject\n" ++
  "    return to_enum(:reject) unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| v = __gather(args); acc.push(v) unless yield(v) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def filter_map\n" ++
  "    return to_enum(:filter_map) unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| v = yield(*args); acc.push(v) if v }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def find(ifnone = nil)\n" ++
  "    return to_enum(:find, ifnone) unless block_given?\n" ++
  "    each \{ |*args| v = __gather(args); return v if yield(v) }\n" ++
  "    ifnone ? ifnone.call : nil\n" ++
  "  end\n" ++
  "  def detect(ifnone = nil, &b); find(ifnone, &b); end\n" ++
  "\n" ++
  "  def find_index(*target)\n" ++
  "    __arity!(target.size, 0, 1)\n" ++
  "    i = 0\n" ++
  "    if target.size > 0\n" ++
  "      each \{ |*args| return i if __gather(args) == target[0]; i += 1 }\n" ++
  "    else\n" ++
  "      return to_enum(:find_index) unless block_given?\n" ++
  "      each \{ |*args| return i if yield(*args); i += 1 }\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def all?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| return false unless pattern[0] === __gather(args) }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| return false unless yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| return false unless __gather(args) }\n" ++
  "    end\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  def any?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| return true if pattern[0] === __gather(args) }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| return true if yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| return true if __gather(args) }\n" ++
  "    end\n" ++
  "    false\n" ++
  "  end\n" ++
  "\n" ++
  "  def none?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| return false if pattern[0] === __gather(args) }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| return false if yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| return false if __gather(args) }\n" ++
  "    end\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  def one?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    n = 0\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| n += 1 if pattern[0] === __gather(args); return false if n > 1 }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| n += 1 if yield(*args); return false if n > 1 }\n" ++
  "    else\n" ++
  "      each \{ |*args| n += 1 if __gather(args); return false if n > 1 }\n" ++
  "    end\n" ++
  "    n == 1\n" ++
  "  end\n" ++
  "\n" ++
  "  def count(*item)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + item.size.to_s + \", expected 1)\" if item.size > 1\n" ++
  "    n = 0\n" ++
  "    if item.size > 0\n" ++
  "      each \{ |*args| n += 1 if __gather(args) == item[0] }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| n += 1 if yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| n += 1 }\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_with_index(*outer)\n" ++
  "    return to_enum(:each_with_index, *outer) unless block_given?\n" ++
  "    i = 0\n" ++
  "    each(*outer) \{ |*args| yield(__gather(args), i); i += 1 }\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_with_object(memo)\n" ++
  "    return to_enum(:each_with_object, memo) unless block_given?\n" ++
  "    each \{ |*args| yield(__gather(args), memo) }\n" ++
  "    memo\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_entry(*outer)\n" ++
  "    return to_enum(:each_entry, *outer) unless block_given?\n" ++
  "    each(*outer) \{ |*args| yield(__gather(args)) }\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def take(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise RangeError, \"bignum too big to convert into 'long'\" if n > 4611686018427387903\n" ++
  "    raise ArgumentError, \"attempt to take negative size\" if n < 0\n" ++
  "    acc = []\n" ++
  "    return acc if n == 0\n" ++
  "    each \{ |*args| acc.push(__gather(args)); break if acc.size >= n }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def take_while\n" ++
  "    return to_enum(:take_while) unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| break unless yield(*args); acc.push(__gather(args)) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def drop(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise RangeError, \"bignum too big to convert into 'long'\" if n > 4611686018427387903\n" ++
  "    raise ArgumentError, \"attempt to drop negative size\" if n < 0\n" ++
  "    acc = []\n" ++
  "    i = 0\n" ++
  "    each \{ |*args| acc.push(__gather(args)) if i >= n; i += 1 }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def drop_while\n" ++
  "    return to_enum(:drop_while) unless block_given?\n" ++
  "    acc = []\n" ++
  "    dropping = true\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      dropping = false if dropping && !yield(v)\n" ++
  "      acc.push(v) unless dropping\n" ++
  "    end\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def first(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    if n.size == 0\n" ++
  "      each \{ |*args| return __gather(args) }\n" ++
  "      nil\n" ++
  "    else\n" ++
  "      take(n[0])\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  // min_by / max_by / sort_by / group_by / partition PACK the yielded values
  // into one before the block sees them (MRI's rb_enum_values_pack); map,
  // select and all? pass them through as arguments. The two rules look the
  // same until #each yields more than one value.
  "  def min_by(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    return to_enum(:min_by, *n) unless block_given?\n" ++
  "    return sort_by \{ |x| yield(x) }.first(__int!(n[0])) if n.size > 0 && !n[0].nil?\n" ++
  "    best = nil\n" ++
  "    best_key = nil\n" ++
  "    seen = false\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      k = yield(v)\n" ++
  "      if !seen || (k <=> best_key) < 0\n" ++
  "        best = v\n" ++
  "        best_key = k\n" ++
  "        seen = true\n" ++
  "      end\n" ++
  "    end\n" ++
  "    best\n" ++
  "  end\n" ++
  "\n" ++
  "  def max_by(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    return to_enum(:max_by, *n) unless block_given?\n" ++
  "    return sort_by \{ |x| yield(x) }.reverse.first(__int!(n[0])) if n.size > 0 && !n[0].nil?\n" ++
  "    best = nil\n" ++
  "    best_key = nil\n" ++
  "    seen = false\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      k = yield(v)\n" ++
  "      if !seen || (k <=> best_key) > 0\n" ++
  "        best = v\n" ++
  "        best_key = k\n" ++
  "        seen = true\n" ++
  "      end\n" ++
  "    end\n" ++
  "    best\n" ++
  "  end\n" ++
  "\n" ++
  "  def minmax_by(&b)\n" ++
  "    return to_enum(:minmax_by) unless block_given?\n" ++
  "    [min_by(&b), max_by(&b)]\n" ++
  "  end\n" ++
  "\n" ++
  "  def sort_by\n" ++
  "    return to_enum(:sort_by) unless block_given?\n" ++
  "    pairs = []\n" ++
  "    each \{ |*args| v = __gather(args); pairs.push([yield(v), v]) }\n" ++
  "    pairs.sort \{ |a, b| a[0] <=> b[0] }.map \{ |p| p[1] }\n" ++
  "  end\n" ++
  "\n" ++
  "  def group_by\n" ++
  "    return to_enum(:group_by) unless block_given?\n" ++
  "    h = \{}\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      (h[yield(v)] ||= []).push(v)\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def partition\n" ++
  "    return to_enum(:partition) unless block_given?\n" ++
  "    yes = []\n" ++
  "    no = []\n" ++
  "    each \{ |*args| v = __gather(args); (yield(v) ? yes : no).push(v) }\n" ++
  "    [yes, no]\n" ++
  "  end\n" ++
  "\n" ++
  "  def inject(*init, &blk)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + init.size.to_s + \", expected 1..2)\" if init.size > 2\n" ++
  "    op = nil\n" ++
  "    memo = nil\n" ++
  "    have = false\n" ++
  "    if init.size == 2\n" ++
  "      memo = init[0]\n" ++
  "      have = true\n" ++
  "      op = init[1]\n" ++
  "    elsif init.size == 1 && !block_given?\n" ++
  "      op = init[0]\n" ++
  "    elsif init.size == 1\n" ++
  "      memo = init[0]\n" ++
  "      have = true\n" ++
  "    end\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      if !have\n" ++
  "        memo = v\n" ++
  "        have = true\n" ++
  "      elsif op\n" ++
  "        memo = memo.__send__(op, v)\n" ++
  "      else\n" ++
  "        memo = blk.call(memo, v)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    memo\n" ++
  "  end\n" ++
  "  def reduce(*init, &blk); inject(*init, &blk); end\n" ++
  "\n" ++
  "  def sum(*init)\n" ++
  "    __arity!(init.size, 0, 1)\n" ++
  "    memo = init.size > 0 ? init[0] : 0\n" ++
  "    if block_given?\n" ++
  "      each \{ |*args| memo = memo + yield(__gather(args)) }\n" ++
  "    else\n" ++
  "      each \{ |*args| memo = memo + __gather(args) }\n" ++
  "    end\n" ++
  "    memo\n" ++
  "  end\n" ++
  "\n" ++
  "  def tally(*into)\n" ++
  "    __arity!(into.size, 0, 1)\n" ++
  "    h = into.size > 0 ? into[0] : \{}\n" ++
  "    h = h.to_hash if into.size > 0 && !h.is_a?(Hash) && h.respond_to?(:to_hash)\n" ++
  "    # the hash's STORED counts start it, not its default; a frozen hash\n" ++
  "    # refuses before anything is counted; a count must be an Integer\n" ++
  "    raise FrozenError, \"can't modify frozen Hash: \" + h.inspect if h.frozen?\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      c = h.key?(v) ? h.fetch(v) : 0\n" ++
  "      raise TypeError, \"wrong argument type \" + c.class.to_s + \" (expected Integer)\" unless c.is_a?(Integer)\n" ++
  "      h[v] = c + 1\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def to_h(*outer)\n" ++
  "    h = \{}\n" ++
  "    each(*outer) do |*args|\n" ++
  "      pair = block_given? ? yield(*args) : __gather(args)\n" ++
  "      pair = pair.to_ary if !pair.is_a?(Array) && pair.respond_to?(:to_ary)\n" ++
  "      raise TypeError, \"wrong element type \" + pair.class.to_s + \" (expected array)\" unless pair.is_a?(Array)\n" ++
  "      raise ArgumentError, \"element has wrong array length (expected 2, was \" + pair.size.to_s + \")\" unless pair.size == 2\n" ++
  "      h[pair[0]] = pair[1]\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def include?(target)\n" ++
  "    each \{ |*args| return true if __gather(args) == target }\n" ++
  "    false\n" ++
  "  end\n" ++
  "  def member?(target); include?(target); end\n" ++
  "\n" ++
  "  def cycle(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    return to_enum(:cycle, *n) unless block_given?\n" ++
  "    if n.size > 0 && !n[0].nil?\n" ++
  "      times = __int!(n[0])\n" ++
  "      return nil if times <= 0\n" ++
  "      buf = []\n" ++
  "      each \{ |*args| v = __gather(args); buf.push(v); yield v }\n" ++
  "      return nil if buf.empty?\n" ++
  "      (times - 1).times \{ buf.each \{ |v| yield v } }\n" ++
  "      nil\n" ++
  "    else\n" ++
  "      buf = []\n" ++
  "      each \{ |*args| v = __gather(args); buf.push(v); yield v }\n" ++
  "      return nil if buf.empty?\n" ++
  "      loop \{ buf.each \{ |v| yield v } }\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_slice(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise ArgumentError, \"invalid slice size\" if n < 1\n" ++
  "    return to_enum(:each_slice, n) unless block_given?\n" ++
  "    buf = []\n" ++
  "    each do |*args|\n" ++
  "      buf.push(__gather(args))\n" ++
  "      if buf.size == n\n" ++
  "        yield buf\n" ++
  "        buf = []\n" ++
  "      end\n" ++
  "    end\n" ++
  "    yield buf unless buf.empty?\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_cons(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise ArgumentError, \"invalid size\" if n < 1\n" ++
  "    return to_enum(:each_cons, n) unless block_given?\n" ++
  "    buf = []\n" ++
  "    each do |*args|\n" ++
  "      buf.push(__gather(args))\n" ++
  "      buf.shift if buf.size > n\n" ++
  "      yield buf.dup if buf.size == n\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def zip(*others)\n" ++
  "    lists = others.map do |o|\n" ++
  "      if o.is_a?(Array)\n" ++
  "        o\n" ++
  "      elsif o.respond_to?(:to_ary)\n" ++
  "        a = o.to_ary\n" ++
  "        raise TypeError, \"wrong argument type \" + o.class.to_s + \" (must respond to :each)\" unless a.is_a?(Array)\n" ++
  "        a\n" ++
  // ⚠ ruby converts through #to_enum(:each), not #to_a: an object that only
  //   CLAIMS #each (through respond_to_missing?) and answers to_enum was sent
  //   to_a and came back "undefined method 'to_a'". The `each` test stays --
  //   every object has Kernel#to_enum, so testing THAT would accept an object
  //   with nothing to walk (`zip(Object.new)` must stay a TypeError).
  "      elsif o.respond_to?(:each)\n" ++
  "        o.to_enum(:each).to_a\n" ++
  "      else\n" ++
  "        raise TypeError, \"wrong argument type \" + o.class.to_s + \" (must respond to :each)\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "    acc = []\n" ++
  "    i = 0\n" ++
  "    each do |*args|\n" ++
  "      row = [__gather(args)]\n" ++
  "      lists.each \{ |l| row.push(l[i]) }\n" ++
  "      i += 1\n" ++
  "      block_given? ? yield(row) : acc.push(row)\n" ++
  "    end\n" ++
  "    block_given? ? nil : acc\n" ++
  "  end\n" ++
  "end\n";

let core_prelude_c =
  // Ractor, sequentially: this interpreter has one thread of control (Thread
  // runs its block where it is created), so a Ractor keeps its block and runs
  // it when someone asks for the VALUE. A message sent before that is in the
  // mailbox by the time the body asks for it, which is the shape the tests
  // use; what this cannot model is two bodies running at once, and the pairs
  // that need that are recorded in KNOWN_GAPS.
  "class Ractor\n" ++
  "  class Error < StandardError; end\n" ++
  "  class RemoteError < Error\n" ++
  "    attr_reader :ractor\n" ++
  "    def initialize(msg = nil, ractor = nil, cause = nil)\n" ++
  "      @ractor = ractor\n" ++
  "      @__cause = cause\n" ++
  "      super(msg || \"thrown by remote Ractor.\")\n" ++
  "    end\n" ++
  "    def cause; @__cause; end\n" ++
  "  end\n" ++
  "  class ClosedError < Error; end\n" ++
  "  class IsolationError < Error; end\n" ++
  "  class MovedError < Error; end\n" ++
  "  class UnsafeError < Error; end\n" ++
  "\n" ++
  // A port is a queue with a closed flag. Reading an EMPTY one is what "wait
  // for the other side" means here, and the other side is a ractor nobody has
  // asked anything of yet -- so the read is the demand that runs it.
  "  class Port\n" ++
  "    def initialize; @q = []; @closed = false; end\n" ++
  "    def <<(v)\n" ++
  "      raise Ractor::ClosedError, \"The port was already closed\" if @closed\n" ++
  "      @q.push(v)\n" ++
  "      self\n" ++
  "    end\n" ++
  "    def send(v); self << v; end\n" ++
  "    def receive\n" ++
  "      Ractor.__run_pending if @q.empty?\n" ++
  "      if @q.empty?\n" ++
  "        raise Ractor::ClosedError, \"The port was already closed\" if @closed\n" ++
  "        raise Ractor::Error, \"No other ractor can write to this port: this interpreter runs ractors sequentially\"\n" ++
  "      end\n" ++
  "      @q.shift\n" ++
  "    end\n" ++
  "    def close; @closed = true; self; end\n" ++
  "    def closed?; @closed; end\n" ++
  "    def inspect; \"#<Ractor::Port>\"; end\n" ++
  "    def __empty?; @q.empty?; end\n" ++
  "  end\n" ++
  "\n" ++
  // `Ractor.allocate` is a refusal in ruby -- a Ractor is its block, and there
  // is nothing to allocate without one -- so the public name raises and the
  // class builds its instances through `__alloc`, a private door the
  // interpreter opens for this class alone.
  "  class << self\n" ++
  "    def allocate; raise TypeError, \"allocator undefined for Ractor\"; end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__seq\n" ++
  "    @__seq = (@__seq || 0) + 1\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.main\n" ++
  "    @__main ||= (m = __alloc; m.__init_main; m)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.current\n" ++
  "    @__cur || main\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.main?\n" ++
  "    current.equal?(main)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__with_current(r)\n" ++
  "    prev = @__cur\n" ++
  "    @__cur = r\n" ++
  "    begin\n" ++
  "      yield\n" ++
  "    ensure\n" ++
  "      @__cur = prev\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  // Every ractor made and not yet run waits here. Anything that would BLOCK in
  // a parallel ruby -- reading an empty port, selecting -- runs them instead:
  // that is the whole scheduler.
  "  def self.__pending; @__pending ||= []; end\n" ++
  "  def self.__run_pending\n" ++
  "    until __pending.empty?\n" ++
  "      r = __pending.shift\n" ++
  "      r.__run\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.count; 1; end\n" ++
  "  def self.receive; current.__take; end\n" ++
  "  def self.recv; current.__take; end\n" ++
  "  def self.receive_if(&b); current.__take; end\n" ++
  "  def self.shareable?(o); o.frozen?; end\n" ++
  "  def self.make_shareable(o); o.freeze; end\n" ++
  "  def self.shareable_proc(&b); b.freeze; end\n" ++
  "  def self.shareable_lambda(&b); b.freeze; end\n" ++
  "  def self.[](k); current[k]; end\n" ++
  "  def self.[]=(k, v); current[k] = v; end\n" ++
  "  def self.store_if_absent(k)\n" ++
  "    c = current\n" ++
  "    c.key?(k) ? c[k] : (c[k] = yield)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.new(*args, name: nil, &block)\n" ++
  "    raise ArgumentError, \"must be called with a block\" unless block\n" ++
  "    unless name.nil? || name.is_a?(String) || name.is_a?(Symbol)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + name.class.to_s + \" into String\"\n" ++
  "    end\n" ++
  "    r = __alloc\n" ++
  "    r.__init(args, name.nil? ? nil : name.to_s, block)\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  // Every ractor here runs SEQUENTIALLY, in the thread that asks for what it
  // produced: the block is kept and run on the first #value / #join / port
  // read, so a message sent before then is already in the mailbox when the
  // body asks for it. There is no parallelism and no interleaving.
  "  def __init(args, name, block)\n" ++
  "    @args = args\n" ++
  "    @name = name\n" ++
  "    @block = block\n" ++
  "    @port = Ractor::Port.new\n" ++
  "    @locals = \{}\n" ++
  "    @monitors = []\n" ++
  "    @done = false\n" ++
  "    @error = nil\n" ++
  "    @value = nil\n" ++
  "    @main = false\n" ++
  "    @id = Ractor.__seq\n" ++
  "    Ractor.__pending.push(self)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __init_main\n" ++
  "    @args = []\n" ++
  "    @name = nil\n" ++
  "    @block = nil\n" ++
  "    @port = Ractor::Port.new\n" ++
  "    @locals = \{}\n" ++
  "    @monitors = []\n" ++
  "    @done = true\n" ++
  "    @error = nil\n" ++
  "    @value = nil\n" ++
  "    @main = true\n" ++
  "    @id = 0\n" ++
  "  end\n" ++
  "\n" ++
  "  def name; @name; end\n" ++
  "  def default_port; @port; end\n" ++
  "  def inspect\n" ++
  "    \"#<Ractor:#\" + (@id + 1).to_s + (@name.nil? ? \"\" : \" \" + @name) +\n" ++
  "      ((@done && !@main) ? \" terminated\" : \" running\") + \">\"\n" ++
  "  end\n" ++
  "  def to_s; inspect; end\n" ++
  // a ractor cannot be copied: it IS its block, and both routes reach the
  // refused allocator.
  "  def dup; raise TypeError, \"allocator undefined for Ractor\"; end\n" ++
  "  def clone(freeze: nil); raise TypeError, \"allocator undefined for Ractor\"; end\n" ++
  "\n" ++
  // ractor-local storage.
  "  def [](k); @locals[k]; end\n" ++
  "  def []=(k, v); @locals[k] = v; end\n" ++
  "  def key?(k); @locals.key?(k); end\n" ++
  "\n" ++
  "  def send(v, move: false)\n" ++
  "    @port << v\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def <<(v); send(v); end\n" ++
  "\n" ++
  "  def close; @port.close; self; end\n" ++
  "\n" ++
  // a monitoring port is told `:exited` when the body finishes -- at once if it
  // already has.
  "  def monitor(port)\n" ++
  "    if @done\n" ++
  "      port << :exited\n" ++
  "    else\n" ++
  "      @monitors.push(port)\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def unmonitor(port)\n" ++
  "    @monitors.delete(port)\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __take\n" ++
  "    @port.receive\n" ++
  "  end\n" ++
  "\n" ++
  "  def __run\n" ++
  "    return if @done || @block.nil?\n" ++
  "    Ractor.__pending.delete(self)\n" ++
  "    @done = true\n" ++
  "    begin\n" ++
  "      @value = Ractor.__with_current(self) \{ @block.call(*@args) }\n" ++
  "    rescue Exception => e\n" ++
  "      @error = e\n" ++
  "    end\n" ++
  // a terminated ractor takes no more messages, which is how a program sees
  // that it finished.
  "    @port.close\n" ++
  "    @monitors.each \{ |p| p << :exited }\n" ++
  "    @monitors = []\n" ++
  "  end\n" ++
  "\n" ++
  "  def value\n" ++
  "    __run\n" ++
  "    if @error\n" ++
  "      raise Ractor::RemoteError.new(nil, self, @error)\n" ++
  "    end\n" ++
  "    @value\n" ++
  "  end\n" ++
  "\n" ++
  "  def join\n" ++
  "    value\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  // select answers the FIRST argument that has something: a port with a value
  // in it, or a ractor that has finished. Pending bodies run first, since in a
  // parallel ruby they would have been running all along.
  "  def self.select(*ractors)\n" ++
  "    raise ArgumentError, \"specify at least one ractor or `yield_value`\" if ractors.empty?\n" ++
  "    ractors.each do |r|\n" ++
  "      return [r, r.receive] if r.is_a?(Ractor::Port) && !r.__empty?\n" ++
  "    end\n" ++
  "    __run_pending\n" ++
  "    ractors.each do |r|\n" ++
  "      return [r, r.receive] if r.is_a?(Ractor::Port) && !r.__empty?\n" ++
  "    end\n" ++
  "    ractors.each do |r|\n" ++
  "      return [r, r.value] if r.is_a?(Ractor)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "end\n";

let core_prelude_d =
  // Encoding::Converter: the constant existed and nothing else did, so
  // `Encoding::Converter.new(src, dst)` built a bare object that answered no
  // method of its own. This is the part a caller reaches first -- the two
  // encodings, #inspect, and #convert through String#encode, which already
  // knows the conversions. The stream API (primitive_convert, putback,
  // last_error, primitive_errinfo, finish) and the path search are here too;
  // a broken sequence is found by the transcoders' own rules (__bad_seq) so
  // the errors carry ruby's bytes, stages and messages.
  "class Enumerator\n" ++
  "  # External iteration (#next, #peek, #feed) runs #each on a Fiber of its own\n" ++
  "  # and suspends it at every element: what a source yields is handed out one\n" ++
  "  # at a time, and what #feed gave is what that yield returns. The source is\n" ++
  "  # never run ahead -- an infinite one can be stepped, and a stateful one is\n" ++
  "  # driven exactly once. The dispatcher's next/peek arm resumes this.\n" ++
  "  def __ext_fiber\n" ++
  "    en = self\n" ++
  "    Fiber.new do\n" ++
  "      r = en.each \{ |*a| Fiber.yield(a) }\n" ++
  "      en.__ext_finish(r)\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def __ext_finish(r)\n" ++
  "    @__x_done = true\n" ++
  "    @__x_ret = r\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  # Enumerator.product lives here, not beside Enumerator::Product (which is\n" ++
  "  # autoloaded): it has to answer before anything has named the constant.\n" ++
  "  # With a block it walks the product and answers nil.\n" ++
  "  def self.product(*enums, **kw, &blk)\n" ++
  "    unless kw.empty?\n" ++
  "      ks = kw.keys.map(&:inspect).join(\", \")\n" ++
  "      raise ArgumentError, (kw.size == 1 ? \"unknown keyword: \" : \"unknown keywords: \") + ks\n" ++
  "    end\n" ++
  "    e = Enumerator::Product.new(*enums)\n" ++
  "    return e unless blk\n" ++
  "    e.each(&blk)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  # the three walks that stop early, for a generator (see the dispatcher):\n" ++
  "  # #each with a block that breaks as soon as the answer is known\n" ++
  "  def __gen_take_while(&b)\n" ++
  "    acc = []\n" ++
  "    each do |*a|\n" ++
  "      v = a.size == 1 ? a[0] : a\n" ++
  "      break unless b.call(v)\n" ++
  "      acc << v\n" ++
  "    end\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def __gen_find(&b)\n" ++
  "    r = nil\n" ++
  "    each do |*a|\n" ++
  "      v = a.size == 1 ? a[0] : a\n" ++
  "      if b.call(v)\n" ++
  "        r = v\n" ++
  "        break\n" ++
  "      end\n" ++
  "    end\n" ++
  "    r\n" ++
  "  end\n" ++
  "  def __gen_find_index(&b)\n" ++
  "    r = nil\n" ++
  "    i = 0\n" ++
  "    each do |*a|\n" ++
  "      v = a.size == 1 ? a[0] : a\n" ++
  "      if b.call(v)\n" ++
  "        r = i\n" ++
  "        break\n" ++
  "      end\n" ++
  "      i += 1\n" ++
  "    end\n" ++
  "    r\n" ++
  "  end\n" ++
  "  # Enumerator.produce(initial = none, size: Float::INFINITY) \{ |prev| next }:\n" ++
  "  # the initial value, then each block result from the one before; with no\n" ++
  "  # initial value the first element is the block's answer to nil. It ends\n" ++
  "  # only when the block raises StopIteration. An ordinary Enumerator.new, so\n" ++
  "  # #size, #take, #next and every Enumerable method are the usual ones --\n" ++
  "  # the dispatcher's special object for it had no #size that returned.\n" ++
  "  def self.produce(*args, size: Float::INFINITY, **kw, &blk)\n" ++
  "    raise ArgumentError, \"no block given\" unless blk\n" ++
  "    unless kw.empty?\n" ++
  "      ks = kw.keys.map(&:inspect).join(\", \")\n" ++
  "      raise ArgumentError, (kw.size == 1 ? \"unknown keyword: \" : \"unknown keywords: \") + ks\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0..1)\" if args.size > 1\n" ++
  "    seeded = !args.empty?\n" ++
  "    init = args[0]\n" ++
  "    Enumerator.new(size) do |y|\n" ++
  "      v = seeded ? init : blk.call(nil)\n" ++
  "      loop do\n" ++
  "        y << v\n" ++
  "        v = blk.call(v)\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "class Enumerator::Yielder\n" ++
  "  # the yielder as a block: `\"a\\nb\".each_line(&yielder)` yields each line\n" ++
  "  def to_proc\n" ++
  "    y = self\n" ++
  "    proc \{ |*args| y.yield(*args) }\n" ++
  "  end\n" ++
  "end\n" ++
  "class Encoding::Converter\n" ++
  "  INVALID_MASK = 15\n" ++
  "  INVALID_REPLACE = 2\n" ++
  "  UNDEF_MASK = 240\n" ++
  "  UNDEF_REPLACE = 32\n" ++
  "  UNDEF_HEX_CHARREF = 48\n" ++
  "  UNIVERSAL_NEWLINE_DECORATOR = 256\n" ++
  "  CRLF_NEWLINE_DECORATOR = 4096\n" ++
  "  CR_NEWLINE_DECORATOR = 8192\n" ++
  "  LF_NEWLINE_DECORATOR = 16384\n" ++
  "  XML_TEXT_DECORATOR = 32768\n" ++
  "  XML_ATTR_CONTENT_DECORATOR = 65536\n" ++
  "  PARTIAL_INPUT = 131072\n" ++
  "  AFTER_OUTPUT = 262144\n" ++
  "  XML_ATTR_QUOTE_DECORATOR = 1048576\n" ++
  "\n" ++
  "  # An encoding argument: an Encoding, or a name through #to_str. The name\n" ++
  "  # as given is kept for the \"code converter not found\" message.\n" ++
  "  def self.__enc(e)\n" ++
  "    return [e, e.name] if Encoding === e\n" ++
  "    s = String === e ? e : e.to_str\n" ++
  "    [(Encoding.find(s) rescue nil), s]\n" ++
  "  end\n" ++
  "\n" ++
  "  # The transcoding path, as ruby builds it: one step when either side is\n" ++
  "  # UTF-8, two through UTF-8 otherwise, three for ISO-2022-JP (it is\n" ++
  "  # stateful, reached through EUC-JP and its stateless form). A newline\n" ++
  "  # decorator is named at the end (universal_newline at the front).\n" ++
  "  def self.__path(src, dst, opts)\n" ++
  "    s, sn = __enc(src)\n" ++
  "    d, dn = __enc(dst)\n" ++
  "    nf = \"code converter not found (\" + (s ? s.name : sn) + \" to \" + (d ? d.name : dn) + \")\"\n" ++
  "    raise Encoding::ConverterNotFoundError, nf if s.nil? || d.nil? || s == d\n" ++
  "    raise Encoding::ConverterNotFoundError, nf if s.name == \"Emacs-Mule\" || d.name == \"Emacs-Mule\"\n" ++
  "    u = Encoding::UTF_8\n" ++
  "    pairs =\n" ++
  "      if d.name == \"ISO-2022-JP\"\n" ++
  "        e = Encoding::EUC_JP\n" ++
  "        st = Encoding.find(\"stateless-ISO-2022-JP\")\n" ++
  "        (s == u ? [] : [[s, u]]) + [[u, e], [e, st], [st, d]]\n" ++
  "      elsif s == u || d == u || (s.name == \"EUC-JP\" && d.name == \"Shift_JIS\") || (s.name == \"Shift_JIS\" && d.name == \"EUC-JP\")\n" ++
  "        [[s, d]]\n" ++
  "      else\n" ++
  "        [[s, u], [u, d]]\n" ++
  "      end\n" ++
  "    opts ||= \{}\n" ++
  "    pairs.unshift(\"universal_newline\") if opts[:universal_newline]\n" ++
  "    pairs << \"crlf_newline\" if opts[:crlf_newline]\n" ++
  "    pairs << \"cr_newline\" if opts[:cr_newline]\n" ++
  "    pairs\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.search_convpath(src, dst, **opts)\n" ++
  "    __path(src, dst, opts)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.asciicompat_encoding(enc)\n" ++
  "    e = Encoding === enc ? enc : (Encoding.find(String === enc ? enc : enc.to_str) rescue nil)\n" ++
  "    return nil if e.nil?\n" ++
  "    case e.name\n" ++
  "    when \"UTF-16BE\", \"UTF-16LE\", \"UTF-32BE\", \"UTF-32LE\", \"UTF-16\", \"UTF-32\" then Encoding::UTF_8\n" ++
  "    when \"ISO-2022-JP\" then Encoding.find(\"stateless-ISO-2022-JP\")\n" ++
  "    else nil\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def initialize(src, dst, opts = nil, **kw)\n" ++
  "    opts = kw if opts.nil? || Integer === opts\n" ++
  "    @convpath = Encoding::Converter.__path(src, dst, opts)\n" ++
  "    steps = @convpath.select \{ |x| Array === x }\n" ++
  "    @source_encoding = steps.first[0]\n" ++
  "    @destination_encoding = steps.last[1]\n" ++
  "    @invalid_replace = opts[:invalid] == :replace\n" ++
  "    @undef_replace = opts[:undef] == :replace\n" ++
  "    if opts.key?(:replace) && !opts[:replace].nil?\n" ++
  "      r = opts[:replace]\n" ++
  "      r = r.to_str unless String === r || !r.respond_to?(:to_str)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + (r.nil? ? \"nil\" : r.class.to_s) + \" into String\" unless String === r\n" ++
  "      @replacement = r\n" ++
  "    else\n" ++
  "      @replacement = __default_replacement\n" ++
  "    end\n" ++
  "    @__errinfo = [:source_buffer_empty, nil, nil, nil, nil]\n" ++
  "    @__last_error = nil\n" ++
  "    @__pending = \"\".b\n" ++
  "    @__putback = \"\".b\n" ++
  "    @__outbuf = \"\".b\n" ++
  "    @__finished = false\n" ++
  "  end\n" ++
  "  attr_reader :source_encoding, :destination_encoding, :replacement, :convpath\n" ++
  "\n" ++
  "  def __default_replacement\n" ++
  "    @destination_encoding.name.start_with?(\"UTF-\") ? \"�\" : \"?\".encode(\"US-ASCII\")\n" ++
  "  end\n" ++
  "\n" ++
  "  def replacement=(r)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + (r.nil? ? \"nil\" : r.class.to_s) + \" into String\" unless String === r\n" ++
  "    r.encode(@destination_encoding) unless r.ascii_only?\n" ++
  "    @replacement = r\n" ++
  "  end\n" ++
  "\n" ++
  "  def inspect\n" ++
  "    \"#<Encoding::Converter: \" + @source_encoding.name + \" to \" + @destination_encoding.name + \">\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def last_error = @__last_error\n" ++
  "  def primitive_errinfo = @__errinfo\n" ++
  "\n" ++
  "  def putback(n = nil)\n" ++
  "    b = @__putback\n" ++
  "    n = b.bytesize if n.nil? || n > b.bytesize\n" ++
  "    out = b.byteslice(b.bytesize - n, n)\n" ++
  "    @__putback = b.byteslice(0, b.bytesize - n)\n" ++
  "    out.force_encoding(@source_encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The first broken sequence in `bytes` read as `enc`: [offset, error\n" ++
  "  # bytes, bytes to read again, incomplete?], or nil. The rules are the\n" ++
  "  # transcoders': a lead byte and the continuations that fit are the error,\n" ++
  "  # the byte that did not fit is read again, and a sequence cut off by the\n" ++
  "  # end of the input is incomplete.\n" ++
  "  def self.__bad_seq(bytes, enc)\n" ++
  "    a = bytes.bytes\n" ++
  "    n = a.size\n" ++
  "    i = 0\n" ++
  "    name = String === enc ? enc : enc.name\n" ++
  "    if name == \"UTF-8\"\n" ++
  "      while i < n\n" ++
  "        b = a[i]\n" ++
  "        if b < 0x80 then i += 1; next end\n" ++
  "        need, lo, hi =\n" ++
  "          if b >= 0xC2 && b <= 0xDF then [1, 0x80, 0xBF]\n" ++
  "          elsif b == 0xE0 then [2, 0xA0, 0xBF]\n" ++
  "          elsif b == 0xED then [2, 0x80, 0x9F]\n" ++
  "          elsif b >= 0xE1 && b <= 0xEF then [2, 0x80, 0xBF]\n" ++
  "          elsif b == 0xF0 then [3, 0x90, 0xBF]\n" ++
  "          elsif b >= 0xF1 && b <= 0xF3 then [3, 0x80, 0xBF]\n" ++
  "          elsif b == 0xF4 then [3, 0x80, 0x8F]\n" ++
  "          else [0, 0, 0]\n" ++
  "          end\n" ++
  "        return [i, bytes.byteslice(i, 1), \"\".b, false] if need == 0\n" ++
  "        k = 1\n" ++
  "        while k <= need\n" ++
  "          return [i, bytes.byteslice(i, k), \"\".b, true] if i + k >= n\n" ++
  "          c = a[i + k]\n" ++
  "          ok = k == 1 ? (c >= lo && c <= hi) : (c >= 0x80 && c <= 0xBF)\n" ++
  "          return [i, bytes.byteslice(i, k), bytes.byteslice(i + k, 1), false] unless ok\n" ++
  "          k += 1\n" ++
  "        end\n" ++
  "        i += need + 1\n" ++
  "      end\n" ++
  "    elsif name == \"US-ASCII\"\n" ++
  "      while i < n\n" ++
  "        return [i, bytes.byteslice(i, 1), \"\".b, false] if a[i] >= 0x80\n" ++
  "        i += 1\n" ++
  "      end\n" ++
  "    elsif name == \"EUC-JP\"\n" ++
  "      while i < n\n" ++
  "        b = a[i]\n" ++
  "        if b < 0x80 then i += 1; next end\n" ++
  "        rng = b == 0x8E ? [0xA1, 0xDF] : ((b >= 0xA1 && b <= 0xFE) || b == 0x8F ? [0xA1, 0xFE] : nil)\n" ++
  "        return [i, bytes.byteslice(i, 1), \"\".b, false] if rng.nil?\n" ++
  "        need = b == 0x8F ? 2 : 1\n" ++
  "        k = 1\n" ++
  "        while k <= need\n" ++
  "          return [i, bytes.byteslice(i, k), \"\".b, true] if i + k >= n\n" ++
  "          c = a[i + k]\n" ++
  "          return [i, bytes.byteslice(i, k), bytes.byteslice(i + k, 1), false] unless c >= rng[0] && c <= rng[1]\n" ++
  "          rng = [0xA1, 0xFE]\n" ++
  "          k += 1\n" ++
  "        end\n" ++
  "        i += need + 1\n" ++
  "      end\n" ++
  "    elsif name == \"UTF-16LE\" || name == \"UTF-16BE\"\n" ++
  "      le = name == \"UTF-16LE\"\n" ++
  "      while i < n\n" ++
  "        return [i, bytes.byteslice(i, n - i), \"\".b, true] if i + 1 >= n\n" ++
  "        u = le ? a[i] | (a[i + 1] << 8) : (a[i] << 8) | a[i + 1]\n" ++
  "        if u >= 0xD800 && u <= 0xDBFF\n" ++
  "          return [i, bytes.byteslice(i, 2), \"\".b, true] if i + 3 >= n\n" ++
  "          v = le ? a[i + 2] | (a[i + 3] << 8) : (a[i + 2] << 8) | a[i + 3]\n" ++
  "          return [i, bytes.byteslice(i, 2), bytes.byteslice(i + 2, 2), false] unless v >= 0xDC00 && v <= 0xDFFF\n" ++
  "          i += 4\n" ++
  "        elsif u >= 0xDC00 && u <= 0xDFFF\n" ++
  "          return [i, bytes.byteslice(i, 2), \"\".b, false]\n" ++
  "        else\n" ++
  "          i += 2\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__dump(b)\n" ++
  "    s = +\"\"\n" ++
  "    b.each_byte \{ |c| s << (c >= 0x20 && c < 0x7F && c != 0x22 && c != 0x5C ? c.chr : format(\"\\\\x%02X\", c)) }\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  # The exception for a broken sequence, and what #primitive_errinfo says\n" ++
  "  # about it. `sn` is the source; `dn` the destination of the FIRST step,\n" ++
  "  # which is where a broken sequence is found.\n" ++
  "  def self.__invalid_exc(bad, sn, dn)\n" ++
  "    _, err, again, incomplete = bad\n" ++
  "    msg = if incomplete\n" ++
  "            \"incomplete \\\"\" + __dump(err) + \"\\\" on \" + sn\n" ++
  "          elsif again.empty?\n" ++
  "            \"\\\"\" + __dump(err) + \"\\\" on \" + sn\n" ++
  "          else\n" ++
  "            \"\\\"\" + __dump(err) + \"\\\" followed by \\\"\" + __dump(again) + \"\\\" on \" + sn\n" ++
  "          end\n" ++
  "    e = Encoding::InvalidByteSequenceError.new(msg)\n" ++
  "    \{ :@source_encoding_name => sn, :@destination_encoding_name => dn, :@error_bytes => err.b,\n" ++
  "      :@readagain_bytes => (again.empty? ? nil : again.b), :@incomplete_input => incomplete }.each \{ |k, v| e.instance_variable_set(k, v) }\n" ++
  "    [e, [incomplete ? :incomplete_input : :invalid_byte_sequence, sn, dn, err.b, again.b]]\n" ++
  "  end\n" ++
  "\n" ++
  "  # String#encode's refusal of a broken sequence, raised here so it carries\n" ++
  "  # the same bytes, stage and message as a converter's. Returns nil when the\n" ++
  "  # sequence is broken in a way these rules do not know.\n" ++
  "  def self.__raise_invalid(bytes, from, to)\n" ++
  "    s = Encoding.find(from)\n" ++
  "    d = Encoding.find(to)\n" ++
  "    bad = __bad_seq(bytes, s)\n" ++
  "    return nil unless bad\n" ++
  "    steps = (__path(s, d, nil) rescue [[s, d]]).select \{ |x| Array === x }\n" ++
  "    raise __invalid_exc(bad, s.name, steps.first[1].name)[0]\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ivs(e, h)\n" ++
  "    h.each \{ |k, v| e.instance_variable_set(k, v) }\n" ++
  "    e\n" ++
  "  end\n" ++
  "\n" ++
  "  def __invalid_error(bad)\n" ++
  "    Encoding::Converter.__invalid_exc(bad, @source_encoding.name, @convpath.find \{ |x| Array === x }[1].name)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The error for a character the destination cannot hold. From UTF-8 it\n" ++
  "  # names the code point; into UTF-8 it shows the bytes; between two other\n" ++
  "  # encodings it is raised by the SECOND step, from UTF-8, and its message\n" ++
  "  # names the whole path.\n" ++
  "  def __undef_error(ch)\n" ++
  "    steps = @convpath.select \{ |x| Array === x }\n" ++
  "    u = Encoding::UTF_8\n" ++
  "    if @source_encoding == u\n" ++
  "      msg = format(\"U+%04X\", ch.ord) + \" from UTF-8 to \" + @destination_encoding.name\n" ++
  "      sn, dn = \"UTF-8\", steps.first[1].name\n" ++
  "    elsif @destination_encoding == u || steps.size == 1\n" ++
  "      msg = \"\\\"\" + Encoding::Converter.__dump(ch.b) + \"\\\" from \" + @source_encoding.name + \" to \" + steps.first[1].name\n" ++
  "      sn, dn = @source_encoding.name, steps.first[1].name\n" ++
  "    elsif (cu = (ch.encode(u) rescue nil)).nil?\n" ++
  "      msg = \"\\\"\" + Encoding::Converter.__dump(ch.b) + \"\\\" to UTF-8 in conversion from \" +\n" ++
  "            steps.map \{ |x| x[0].name }.join(\" to \") + \" to \" + @destination_encoding.name\n" ++
  "      sn, dn = @source_encoding.name, \"UTF-8\"\n" ++
  "    else\n" ++
  "      ch = cu\n" ++
  "      msg = format(\"U+%04X\", ch.ord) + \" to \" + @destination_encoding.name + \" in conversion from \" +\n" ++
  "            steps.map \{ |x| x[0].name }.join(\" to \") + \" to \" + @destination_encoding.name\n" ++
  "      sn, dn = \"UTF-8\", steps[1][1].name\n" ++
  "    end\n" ++
  "    e = __ivs(Encoding::UndefinedConversionError.new(msg),\n" ++
  "              :@source_encoding_name => sn, :@destination_encoding_name => dn, :@error_char => ch)\n" ++
  "    [e, [:undefined_conversion, sn, dn, ch.b, \"\".b]]\n" ++
  "  end\n" ++
  "\n" ++
  "  # Converts what it can of `bytes`: [output, status, rest, error, errinfo,\n" ++
  "  # read-again bytes].\n" ++
  "  def __step(bytes, partial)\n" ++
  "    bad = Encoding::Converter.__bad_seq(bytes, @source_encoding)\n" ++
  "    bad = nil if bad && @invalid_replace && !bad[3]\n" ++
  "    upto = bad ? bad[0] : bytes.bytesize\n" ++
  "    good = bytes.byteslice(0, upto).force_encoding(@source_encoding)\n" ++
  "    out = \"\".b\n" ++
  "    off = 0\n" ++
  "    good.each_char do |c|\n" ++
  "      begin\n" ++
  "        out << if @destination_encoding.name == \"UTF8-MAC\"\n" ++
  "                 # the Mac's decomposed UTF-8\n" ++
  "                 c.encode(Encoding::UTF_8, @source_encoding).unicode_normalize(:nfd).b\n" ++
  "               else\n" ++
  "                 c.encode(@destination_encoding, @source_encoding, invalid: (@invalid_replace ? :replace : nil),\n" ++
  "                          undef: (@undef_replace ? :replace : nil), replace: @replacement).b\n" ++
  "               end\n" ++
  "      # a character this interpreter cannot decode (a Shift_JIS kanji: there\n" ++
  "      # is no table) is structurally valid -- __bad_seq passed it -- so it is\n" ++
  "      # a character the destination does not have, as ruby reports it\n" ++
  "      rescue Encoding::UndefinedConversionError, Encoding::InvalidByteSequenceError\n" ++
  "        e, info = __undef_error(c)\n" ++
  "        return [out, :undefined_conversion, bytes.byteslice(off + c.bytesize, bytes.bytesize), e, info, \"\".b]\n" ++
  "      end\n" ++
  "      off += c.bytesize\n" ++
  "    end\n" ++
  "    return [out, :finished, \"\".b, nil, [:finished, nil, nil, nil, nil], \"\".b] unless bad\n" ++
  "    if bad[3] && partial\n" ++
  "      return [out, :source_buffer_empty, bytes.byteslice(bad[0], bytes.bytesize), nil, [:source_buffer_empty, nil, nil, nil, nil], \"\".b]\n" ++
  "    end\n" ++
  "    e, info = __invalid_error(bad)\n" ++
  "    [out, info[0], bytes.byteslice(bad[0] + bad[1].bytesize + bad[2].bytesize, bytes.bytesize), e, info, bad[2].b]\n" ++
  "  end\n" ++
  "\n" ++
  "  def convert(str)\n" ++
  "    raise ArgumentError, \"converter already finished\" if @__finished\n" ++
  "    bytes = @__pending + str.b\n" ++
  "    @__pending = \"\".b\n" ++
  "    out, status, rest, err, info, _again = __step(bytes, true)\n" ++
  "    if err\n" ++
  "      @__last_error = err\n" ++
  "      @__errinfo = info\n" ++
  "      raise err\n" ++
  "    end\n" ++
  "    @__pending = rest || \"\".b\n" ++
  "    @__last_error = nil\n" ++
  "    @__errinfo = [:source_buffer_empty, nil, nil, nil, nil]\n" ++
  "    out.force_encoding(@destination_encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  def finish\n" ++
  "    @__finished = true\n" ++
  "    unless @__pending.empty?\n" ++
  "      bad = Encoding::Converter.__bad_seq(@__pending, @source_encoding)\n" ++
  "      @__pending = \"\".b\n" ++
  "      if bad\n" ++
  "        e, info = __invalid_error(bad)\n" ++
  "        @__last_error = e\n" ++
  "        @__errinfo = info\n" ++
  "        raise e\n" ++
  "      end\n" ++
  "    end\n" ++
  "    (+\"\").force_encoding(@destination_encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  # One step of the stream. What was read again after an error is read\n" ++
  "  # first (unless #putback took it), then what a partial call held back.\n" ++
  "  # Output beyond dst_size waits in the converter for the next call; the\n" ++
  "  # source is consumed either way.\n" ++
  "  def primitive_convert(src, dst, dst_start = nil, dst_size = nil, opts = nil, **kw)\n" ++
  "    opts = kw if opts.nil?\n" ++
  "    partial = Integer === opts ? (opts & PARTIAL_INPUT) != 0 : opts[:partial_input]\n" ++
  "    raise FrozenError, \"can't modify frozen String: \" + src.inspect if src && src.frozen?\n" ++
  "    raise FrozenError, \"can't modify frozen String: \" + dst.inspect if dst.frozen?\n" ++
  "    dst_start = dst_start.to_int unless dst_start.nil? || Integer === dst_start\n" ++
  "    dst_size = dst_size.to_int unless dst_size.nil? || Integer === dst_size\n" ++
  "    raise ArgumentError, \"destination byte offset is greater than the destination buffer\" if dst_start && dst_start > dst.bytesize\n" ++
  "    input = @__putback + @__pending + (src ? src.b : \"\".b)\n" ++
  "    @__putback = \"\".b\n" ++
  "    @__pending = \"\".b\n" ++
  "    out, status, rest, err, info, again = __step(input, partial)\n" ++
  "    if status == :source_buffer_empty\n" ++
  "      @__pending = rest\n" ++
  "      rest = \"\".b\n" ++
  "    end\n" ++
  "    out = @__outbuf + out\n" ++
  "    @__outbuf = \"\".b\n" ++
  "    if dst_size && out.bytesize > dst_size\n" ++
  "      @__outbuf = out.byteslice(dst_size, out.bytesize)\n" ++
  "      out = out.byteslice(0, dst_size)\n" ++
  "      status = :destination_buffer_full\n" ++
  "      err = nil\n" ++
  "      info = [:destination_buffer_full, nil, nil, nil, nil]\n" ++
  "    end\n" ++
  "    head = dst_start ? dst.b.byteslice(0, dst_start) : dst.b\n" ++
  "    dst.replace((head + out).force_encoding(@destination_encoding))\n" ++
  "    src.replace(rest.force_encoding(src.encoding)) if src\n" ++
  "    @__putback = again\n" ++
  "    @__last_error = err\n" ++
  "    @__errinfo = info\n" ++
  "    status\n" ++
  "  end\n" ++
  "end\n" ++
  // The thread queues and the condition variable define #marshal_dump only to
  // refuse -- `cv.marshal_dump` is a TypeError, not a missing method.
  "class ConditionVariable\n" ++
  "  def marshal_dump; raise TypeError, \"can't dump Thread::ConditionVariable\"; end\n" ++
  "end\n" ++
  "class Queue\n" ++
  "  def marshal_dump; raise TypeError, \"can't dump \" + (self.class == Queue ? \"Thread::Queue\" : self.class.to_s); end\n" ++
  "end\n" ++
  "class Encoding::UndefinedConversionError\n" ++
  "  def source_encoding_name; @source_encoding_name; end\n" ++
  "  def destination_encoding_name; @destination_encoding_name; end\n" ++
  "  def source_encoding; @source_encoding_name && Encoding.find(@source_encoding_name); end\n" ++
  "  def destination_encoding; @destination_encoding_name && Encoding.find(@destination_encoding_name); end\n" ++
  "  def error_char; @error_char; end\n" ++
  "end\n" ++
  "class Encoding::InvalidByteSequenceError\n" ++
  "  def source_encoding_name; @source_encoding_name; end\n" ++
  "  def destination_encoding_name; @destination_encoding_name; end\n" ++
  "  def source_encoding; @source_encoding_name && Encoding.find(@source_encoding_name); end\n" ++
  "  def destination_encoding; @destination_encoding_name && Encoding.find(@destination_encoding_name); end\n" ++
  "  def error_bytes; @error_bytes; end\n" ++
  "  def readagain_bytes; @readagain_bytes; end\n" ++
  "  def incomplete_input?; @incomplete_input; end\n" ++
  "end\n" ++
  "module ObjectSpace\n" ++
  "  # Finalizers. There is no hook from this collector into Ruby code, so\n" ++
  "  # one never runs when its object is collected; what ruby ALSO does --\n" ++
  "  # run every finalizer still registered when the process exits, with the\n" ++
  "  # object's id -- is done here, from at_exit. undefine_finalizer takes\n" ++
  "  # them back, and both refuse a frozen object as ruby does.\n" ++
  "  @__fin = Hash.new\n" ++
  "  def self.__fin_frozen(obj)\n" ++
  "    raise FrozenError, \"can't modify frozen \" + obj.class.to_s + \": \" + obj.inspect if obj.frozen?\n" ++
  "  end\n" ++
  "  def self.define_finalizer(obj, callable = nil, &blk)\n" ++
  "    callable ||= blk\n" ++
  "    unless callable.respond_to?(:call)\n" ++
  "      raise ArgumentError, \"wrong type argument \" + callable.class.to_s + \" (should be callable)\"\n" ++
  "    end\n" ++
  "    __fin_frozen(obj)\n" ++
  "    unless @__fin_hooked\n" ++
  "      @__fin_hooked = true\n" ++
  "      at_exit do\n" ++
  "        ObjectSpace.__run_finalizers\n" ++
  "      end\n" ++
  "    end\n" ++
  "    (@__fin[obj.object_id] ||= []) << callable\n" ++
  "    [0, callable]\n" ++
  "  end\n" ++
  "  def self.undefine_finalizer(obj)\n" ++
  "    __fin_frozen(obj)\n" ++
  "    @__fin.delete(obj.object_id)\n" ++
  "    obj\n" ++
  "  end\n" ++
  "  def self.__run_finalizers\n" ++
  "    @__fin.each do |id, cs|\n" ++
  "      cs.each do |c|\n" ++
  "        c.call(id)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    @__fin.clear\n" ++
  "  end\n" ++
  "  # each_object(mod = nil) \{ |obj| }: every live object that is a `mod`\n" ++
  "  # (every object, for nil) -- classes and modules included, as ruby's are\n" ++
  "  # -- and the count. Without a block, an Enumerator whose #each answers it.\n" ++
  "  def self.each_object(mod = nil, &blk)\n" ++
  "    return to_enum(:each_object, mod) unless blk\n" ++
  "    if !mod.nil? && !mod.is_a?(Module)\n" ++
  "      raise TypeError, \"class or module required\"\n" ++
  "    end\n" ++
  "    objs, classes = ObjectSpace.__objects(mod)\n" ++
  "    n = 0\n" ++
  "    objs.each do |o|\n" ++
  "      n += 1\n" ++
  "      blk.call(o)\n" ++
  "    end\n" ++
  "    classes.each do |c|\n" ++
  "      next unless mod.nil? || c.kind_of?(mod)\n" ++
  "      n += 1\n" ++
  "      blk.call(c)\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "  # a full collection here is GC.start's, and answers nil as ruby's does\n" ++
  "  def self.garbage_collect(full_mark: true, immediate_sweep: true)\n" ++
  "    GC.start\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  class WeakMap\n" ++
  "    include Enumerable\n" ++
  // (no braces in this source: a `{` in a Mere string starts an interpolation)
  // WeakMap matches keys by IDENTITY (two equal Strings are two keys);
  // WeakKeyMap below by equality, and its #getkey answers the STORED key.
  "    def initialize; @h = Hash.new.compare_by_identity; end\n" ++
  "    def [](k); @h[k]; end\n" ++
  "    def []=(k, v); @h[k] = v; v; end\n" ++
  "    def key?(k); @h.key?(k); end\n" ++
  "    def include?(k); @h.key?(k); end\n" ++
  "    def member?(k); @h.key?(k); end\n" ++
  "    def delete(k, &b); @h.key?(k) ? @h.delete(k) : (b ? b.call(k) : nil); end\n" ++
  "    def size; @h.size; end\n" ++
  "    def length; @h.size; end\n" ++
  "    def keys; @h.keys; end\n" ++
  "    def values; @h.values; end\n" ++
  "    def each(&b); @h.each(&b); self; end\n" ++
  "    def each_pair(&b); @h.each(&b); self; end\n" ++
  "    def each_key(&b); @h.each_key(&b); self; end\n" ++
  "    def each_value(&b); @h.each_value(&b); self; end\n" ++
  // (no #{} in this source: Mere interpolates its own strings the same way)
  // ruby shows the map's address and then each pair
  "    def inspect\n" ++
  "      head = '#<ObjectSpace::WeakMap:0x' + object_id.to_s(16).rjust(16, '0')\n" ++
  "      return head + '>' if @h.empty?\n" ++
  // ...and an entry WITHOUT Kernel (a BasicObject) has no #inspect to ask:
  // it prints the way ruby's any_to_s does, through Kernel#to_s bound to it
  "      ins = lambda \{ |o| ::Kernel === o ? o.inspect : ::Kernel.instance_method(:to_s).bind_call(o) }\n" ++
  "      head + ': ' + @h.map \{ |k, v| ins.call(k) + ' => ' + ins.call(v) }.join(', ') + '>'\n" ++
  "    end\n" ++
  "  end\n" ++
  "  class WeakKeyMap < WeakMap\n" ++
  // ...and the stored key is the OBJECT given, not the copy a Hash makes of an
  // unfrozen String key, so the originals are kept beside the table.
  "    def initialize; @h = Hash.new; @ks = []; end\n" ++
  "    def []=(k, v)\n" ++
  "      @ks << k unless @h.key?(k)\n" ++
  "      @h[k] = v\n" ++
  "      v\n" ++
  "    end\n" ++
  "    def delete(k, &b)\n" ++
  "      return(b ? b.call(k) : nil) unless @h.key?(k)\n" ++
  "      @ks.reject! \{ |x| x.eql?(k) }\n" ++
  "      @h.delete(k)\n" ++
  "    end\n" ++
  "    def getkey(k)\n" ++
  "      @ks.find \{ |x| x.eql?(k) }\n" ++
  "    end\n" ++
  "    def clear; @h.clear; @ks.clear; self; end\n" ++
  // the address is the object's own id, in ruby's 16-digit shape
  "    def inspect; '#<ObjectSpace::WeakKeyMap:0x' + object_id.to_s(16).rjust(16, '0') + ' size=' + @h.size.to_s + '>'; end\n" ++
  "  end\n" ++
  "end\n" ++
  "class Range\n" ++
  "  # ruby 3.4's step for a non-numeric range: b, b + s, b + s + s, ... while\n" ++
  "  # the element is on the range's side of the end. The direction is b <=> e,\n" ++
  "  # the step's is b <=> (b + s); a zero step (b + s == b) iterates nothing,\n" ++
  "  # and a step pointing away from the end iterates nothing either.\n" ++
  "  def __step_generic(step)\n" ++
  "    b = self.begin\n" ++
  "    e = self.end\n" ++
  "    raise ArgumentError, \"#step iteration for beginless ranges is meaningless\" if b.nil?\n" ++
  "    dir = e.nil? ? -1 : (b <=> e)\n" ++
  "    return self if dir.nil?\n" ++
  "    v = b + step\n" ++
  "    sdir = b <=> v\n" ++
  "    return self if sdir.nil? || sdir == 0\n" ++
  "    unless e.nil?\n" ++
  "      dir = b <=> e\n" ++
  "      return self if dir != 0 && (dir < 0) != (sdir < 0)\n" ++
  "      if dir == 0\n" ++
  "        yield b unless exclude_end?\n" ++
  "        return self\n" ++
  "      end\n" ++
  "    end\n" ++
  "    yield b\n" ++
  "    cur = v\n" ++
  "    loop do\n" ++
  "      unless e.nil?\n" ++
  "        c = cur <=> e\n" ++
  "        break if c.nil?\n" ++
  "        ok = sdir < 0 ? (c < 0 || (c == 0 && !exclude_end?)) : (c > 0 || (c == 0 && !exclude_end?))\n" ++
  "        break unless ok\n" ++
  "      end\n" ++
  "      yield cur\n" ++
  "      cur = cur + step\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "end\n" ++
  "class IO\n" ++
  "  # IO.copy_stream(src, dst, copy_length = nil, src_offset = nil): src and\n" ++
  "  # dst are IOs or paths (#to_path); answers the number of bytes copied\n" ++
  "  def self.copy_stream(src, dst, copy_length = nil, src_offset = nil)\n" ++
  "    path = ->(x) \{\n" ++
  "      next x if x.is_a?(String)\n" ++
  "      raise TypeError, \"no implicit conversion of #\{x.class} into String\" unless x.respond_to?(:to_path)\n" ++
  "      pth = x.to_path\n" ++
  "      raise TypeError, \"can't convert #\{x.class} to String (#\{x.class}#to_path gives #\{pth.class})\" unless pth.is_a?(String)\n" ++
  "      pth\n" ++
  "    }\n" ++
  "    data =\n" ++
  "      if src.respond_to?(:read) && !src.is_a?(String)\n" ++
  "        if src_offset\n" ++
  "          src.respond_to?(:pread) ? src.pread(copy_length || (src.size - src_offset), src_offset) : (src.seek(src_offset); src.read(copy_length))\n" ++
  "        else\n" ++
  "          copy_length ? src.read(copy_length) : src.read\n" ++
  "        end\n" ++
  "      else\n" ++
  "        whole = File.binread(path.(src))\n" ++
  "        off = src_offset || 0\n" ++
  "        whole.byteslice(off, copy_length || (whole.bytesize - off)) || +\"\"\n" ++
  "      end\n" ++
  "    data = (data || +\"\").b\n" ++
  "    if dst.respond_to?(:write) && !dst.is_a?(String)\n" ++
  "      dst.write(data)\n" ++
  "    else\n" ++
  "      File.binwrite(path.(dst), data)\n" ++
  "    end\n" ++
  "    data.bytesize\n" ++
  "  end\n" ++
  "end\n" ++
  "class Encoding\n" ++
  "  # every name Encoding.find accepts: the encodings, their aliases, and\n" ++
  "  # \"internal\"\n" ++
  "  def self.name_list = list.map(&:name) + aliases.keys + [\"internal\"]\n" ++
  "  # an encoding's own name first, then each alias that names it\n" ++
  "  def names = [name] + Encoding.aliases.select \{ |_a, n| n == name }.keys\n" ++
  "  # ruby's alias table; a new Hash each call, as ruby answers\n" ++
  "  def self.aliases\n" ++
  "    \{ \"Big5-HKSCS:2008\" => \"Big5-HKSCS\", \"BINARY\" => \"ASCII-8BIT\", \"CP437\" => \"IBM437\", \"CP720\" => \"IBM720\", \"CP737\" => \"IBM737\", \"CP775\" => \"IBM775\", \"IBM850\" => \"CP850\", \"CP857\" => \"IBM857\", \"CP860\" => \"IBM860\", \"CP861\" => \"IBM861\", \"CP862\" => \"IBM862\", \"CP863\" => \"IBM863\", \"CP864\" => \"IBM864\", \"CP865\" => \"IBM865\", \"CP866\" => \"IBM866\", \"CP869\" => \"IBM869\", \"CP1258\" => \"Windows-1258\", \"ebcdic-cp-us\" => \"IBM037\", \"eucJP\" => \"EUC-JP\", \"euc-jp-ms\" => \"eucJP-ms\", \"EUC-JISX0213\" => \"EUC-JIS-2004\", \"eucKR\" => \"EUC-KR\", \"eucTW\" => \"EUC-TW\", \"EUC-CN\" => \"GB2312\", \"eucCN\" => \"GB2312\", \"CP936\" => \"GBK\", \"ISO2022-JP\" => \"ISO-2022-JP\", \"ISO2022-JP2\" => \"ISO-2022-JP-2\", \"ISO8859-1\" => \"ISO-8859-1\", \"ISO8859-2\" => \"ISO-8859-2\", \"ISO8859-3\" => \"ISO-8859-3\", \"ISO8859-4\" => \"ISO-8859-4\", \"ISO8859-5\" => \"ISO-8859-5\", \"ISO8859-6\" => \"ISO-8859-6\", \"CP1256\" => \"Windows-1256\", \"ISO8859-7\" => \"ISO-8859-7\", \"ISO8859-8\" => \"ISO-8859-8\", \"CP1255\" => \"Windows-1255\", \"ISO8859-9\" => \"ISO-8859-9\", \"ISO8859-10\" => \"ISO-8859-10\", \"ISO8859-11\" => \"ISO-8859-11\", \"CP874\" => \"Windows-874\", \"ISO8859-13\" => \"ISO-8859-13\", \"ISO8859-14\" => \"ISO-8859-14\", \"ISO8859-15\" => \"ISO-8859-15\", \"ISO8859-16\" => \"ISO-8859-16\", \"CP878\" => \"KOI8-R\", \"MacJapan\" => \"MacJapanese\", \"ASCII\" => \"US-ASCII\", \"ANSI_X3.4-1968\" => \"US-ASCII\", \"646\" => \"US-ASCII\", \"CP65000\" => \"UTF-7\", \"CP65001\" => \"UTF-8\", \"UTF-8-MAC\" => \"UTF8-MAC\", \"UTF-8-HFS\" => \"UTF8-MAC\", \"UCS-2BE\" => \"UTF-16BE\", \"UCS-4BE\" => \"UTF-32BE\", \"UCS-4LE\" => \"UTF-32LE\", \"CP932\" => \"Windows-31J\", \"csWindows31J\" => \"Windows-31J\", \"SJIS\" => \"Windows-31J\", \"PCK\" => \"Windows-31J\", \"CP1250\" => \"Windows-1250\", \"CP1251\" => \"Windows-1251\", \"CP1252\" => \"Windows-1252\", \"CP1253\" => \"Windows-1253\", \"CP1254\" => \"Windows-1254\", \"CP1257\" => \"Windows-1257\", \"locale\" => \"UTF-8\", \"external\" => \"UTF-8\", \"filesystem\" => \"UTF-8\" }\n" ++
  "  end\n" ++
  "end\n" ++
  "class Random\n" ++
  "  # bytes from the generator, as a binary String (there is no OS source here)\n" ++
  "  def self.urandom(n)\n" ++
  "    n = n.to_int\n" ++
  "    raise ArgumentError, \"negative string size (or size too big)\" if n < 0\n" ++
  "    Array.new(n) \{ rand(256) }.pack(\"C*\")\n" ++
  "  end\n" ++
  "end\n" ++
  "module Warning\n" ++
  "  def self.categories = [:deprecated, :experimental, :performance, :strict_unused_block]\n" ++
  "end\n" ++
  // Dir.open answers a Dir OBJECT (the class methods above are the rest of
  // Dir). Only the instance side needs Ruby: the listing itself comes from
  // the class methods, which are primitives.
  "class Dir\n" ++
  "  def initialize(path)\n" ++
  "    @path = path\n" ++
  "    @pos = 0\n" ++
  "    @closed = false\n" ++
  "  end\n" ++
  "  # @W@ A CLOSED Dir answers nothing but #close and #path. Every read here went\n" ++
  "  #   straight on working after #close, so a use-after-close was invisible --\n" ++
  "  #   the same slip File had, and fixed the same way: one guard, called by\n" ++
  "  #   each reader, rather than a check at one entry point that ruby-level\n" ++
  "  #   methods walk past.\n" ++
  "  def __closed!\n" ++
  "    raise IOError, \"closed directory\" if @closed\n" ++
  "  end\n" ++
  "  private :__closed!\n" ++
  "\n" ++
  "  # ⚠ to_path is the DEFINITION and path the alias -- that is ruby's own\n" ++
  "  # direction, and the spec compares the two UnboundMethods. Writing it the\n" ++
  "  # other way round is still one method, but #original_name then disagrees.\n" ++
  "  def to_path\n" ++
  "    @path\n" ++
  "  end\n" ++
  "  alias path to_path\n" ++
  "  def entries\n" ++
  "    __closed!\n" ++
  "    Dir.entries(@path)\n" ++
  "  end\n" ++
  "  def children\n" ++
  "    __closed!\n" ++
  "    Dir.children(@path)\n" ++
  "  end\n" ++
  "  def each(&b)\n" ++
  "    entries.each(&b)\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def read\n" ++
  "    __closed!\n" ++
  "    e = entries\n" ++
  "    return nil if @pos >= e.size\n" ++
  "    v = e[@pos]\n" ++
  "    @pos = @pos + 1\n" ++
  "    v\n" ++
  "  end\n" ++
  "  def rewind\n" ++
  "    __closed!\n" ++
  "    @pos = 0\n" ++
  "    self\n" ++
  "  end\n" ++
  "  # the read position, which #read already keeps -- it simply had no reader.\n" ++
  "  def pos\n" ++
  "    @pos\n" ++
  "  end\n" ++
  "  alias tell pos\n" ++
  "  def pos=(n)\n" ++
  "    @pos = n\n" ++
  "  end\n" ++
  "  def seek(n)\n" ++
  "    __closed!\n" ++
  "    @pos = n\n" ++
  "    self\n" ++
  "  end\n" ++
  "  # Dir#chdir -- ruby has it, and it is Dir.chdir on this object's path.\n" ++
  "  def chdir(&b)\n" ++
  "    Dir.chdir(path, &b)\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_child(&b)\n" ++
  "    return to_enum(:each_child) \{ nil } unless block_given?\n" ++
  "    children.each(&b)\n" ++
  "    self\n" ++
  "  end\n" ++
  "  # ⚠ A Dir here is a PATH and a position (see #initialize); there is no\n" ++
  "  #   opendir(3) behind it and so no descriptor to hand out. NotImplementedError\n" ++
  "  #   is what ruby raises on a platform without dirfd, and it is the honest\n" ++
  "  #   answer: a made-up number would be accepted by every caller and be wrong\n" ++
  "  #   for all of them. core/dir/fileno_spec stays DIFF because this platform's\n" ++
  "  #   reference HAS dirfd -- see KNOWN_GAPS.\n" ++
  "  def fileno\n" ++
  "    raise NotImplementedError, \"fileno() function is unimplemented on this machine\"\n" ++
  "  end\n" ++
  "  def close\n" ++
  "    @closed = true\n" ++
  "    nil\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  // TracePoint, enough of it for zeitwerk: the :class event, which fires when
  // a class or module body is entered. `#self` cannot be written with `def`
  // (it is a keyword), so it is defined the way ruby's C code effectively
  // does -- through define_method.
  "class TracePoint\n" ++
  "  def self.__points\n" ++
  "    @points = Array.new if @points.nil?\n" ++
  "    @points\n" ++
  "  end\n" ++
  "  def self.__fire(mod)\n" ++
  "    __points.each do |tp|\n" ++
  "      tp.__call(mod)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  def self.__fire_ev(ev, mid, cls, path, rv = nil, slf = nil, line = nil)\n" ++
  "    __points.each do |tp|\n" ++
  "      tp.__call_ev(ev, mid, cls, path, rv, slf, line)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  # TracePoint.trace: a tracepoint that is enabled from the start.\n" ++
  "  def self.trace(*events, &blk)\n" ++
  "    tp = new(*events, &blk)\n" ++
  "    tp.enable\n" ++
  "    tp\n" ++
  "  end\n" ++
  "  EVENT_NAMES = [:line, :class, :end, :call, :return, :c_call, :c_return, :raise, :b_call, :b_return, :a_call, :a_return, :thread_begin, :thread_end, :fiber_switch, :script_compiled, :rescue]\n" ++
  "  def initialize(*events, &blk)\n" ++
  "    # an event is named by a Symbol, or by anything that converts to one\n" ++
  "    events = events.map do |e|\n" ++
  "      s = if e.is_a?(Symbol) then e\n" ++
  "          elsif e.is_a?(String) || e.respond_to?(:to_sym) then e.to_sym\n" ++
  "          else raise TypeError, e.inspect + ' is not a symbol nor a string'\n" ++
  "          end\n" ++
  "      raise TypeError, s.inspect + ' is not a symbol nor a string' unless s.is_a?(Symbol)\n" ++
  "      raise ArgumentError, 'unknown event: ' + s.to_s unless EVENT_NAMES.include?(s)\n" ++
  "      s\n" ++
  "    end\n" ++
  "    raise ArgumentError, 'must be called with a block' unless blk\n" ++
  "    @events = events\n" ++
  "    @blk = blk\n" ++
  "    @enabled = false\n" ++
  "    @tp_self = nil\n" ++
  "  end\n" ++
  "  def enabled?\n" ++
  "    @enabled\n" ++
  "  end\n" ++
  "  def event\n" ++
  "    @event\n" ++
  "  end\n" ++
  "  define_method(:self) do\n" ++
  "    @tp_self\n" ++
  "  end\n" ++
  // enable(target:) narrows a tracepoint to one method -- `tp.enable(target:
  // method(:foo))` fires only for foo. Without the keyword, `enable` took no
  // arguments at all and four bootstraptest pairs died on the ArgumentError
  // rather than on anything to do with tracing. The block form enables for the
  // duration of the block, which is how Ruby scopes it.
  "  def enable(target: nil, target_line: nil, target_thread: nil)\n" ++
  "    @target = target\n" ++
  "    if block_given?\n" ++
  "      was = @enabled\n" ++
  "      # the block form traces the thread that enabled it, and only that one\n" ++
  "      @thread = Thread.current\n" ++
  "      __on\n" ++
  "      begin\n" ++
  "        yield\n" ++
  "      ensure\n" ++
  "        @thread = nil\n" ++
  "        # the flag goes down FIRST: #disable is itself a method call, and\n" ++
  "        # with the tracepoint still on it was reported as a :call event --\n" ++
  "        # callee_id's spec saw [:m_alias, :disable].\n" ++
  "        unless was\n" ++
  "          @enabled = false\n" ++
  "          disable\n" ++
  "        end\n" ++
  "      end\n" ++
  "    else\n" ++
  "      # true when it was ALREADY on\n" ++
  "      was = @enabled\n" ++
  "      __on\n" ++
  "      was\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def __on\n" ++
  "    unless @enabled\n" ++
  "      @enabled = true\n" ++
  "      TracePoint.__points.push(self)\n" ++
  "      TracePoint.__active(true)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  def disable\n" ++
  "    was = @enabled\n" ++
  "    # with a block: off for the block, back on after it, and the block's\n" ++
  "    # value is the answer\n" ++
  "    if block_given?\n" ++
  "      @enabled = false\n" ++
  "      TracePoint.__points.delete(self)\n" ++
  "      TracePoint.__active(TracePoint.__points.size > 0)\n" ++
  "      begin\n" ++
  "        return yield\n" ++
  "      ensure\n" ++
  "        __on if was\n" ++
  "      end\n" ++
  "    end\n" ++
  "    @enabled = false\n" ++
  "    TracePoint.__points.delete(self)\n" ++
  "    TracePoint.__active(TracePoint.__points.size > 0)\n" ++
  "    was\n" ++
  "  end\n" ++
  "  def __call(mod)\n" ++
  "    return nil unless @enabled\n" ++
  "    return nil unless @events.empty? || @events.include?(:class)\n" ++
  "    @tp_self = mod\n" ++
  "    @event = :class\n" ++
  "    r = @blk.call(self)\n" ++
  "    @tp_self = nil\n" ++
  "    r\n" ++
  "  end\n" ++
  "  def __call_ev(ev, mid, cls, path, rv = nil, slf = nil, line = nil)\n" ++
  "    return nil unless @enabled\n" ++
  "    return nil if @thread && !Thread.current.equal?(@thread)\n" ++
  "    return nil unless @events.empty? || @events.include?(ev)\n" ++
  "    return nil if @target && @target.name != mid\n" ++
  "    @event = ev\n" ++
  "    @method_id = mid\n" ++
  "    @defined_class = cls\n" ++
  "    @path = path\n" ++
  "    @return_value = rv\n" ++
  "    @tp_self = slf\n" ++
  "    @lineno = line\n" ++
  "    @inside = true\n" ++
  "    begin\n" ++
  "      @blk.call(self)\n" ++
  "    ensure\n" ++
  "      @inside = false\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def raised_exception\n" ++
  "    raise RuntimeError, \"not supported by this event\" unless @event == :raise || @event == :rescue\n" ++
  "    @return_value\n" ++
  "  end\n" ++
  "  def return_value\n" ++
  "    raise RuntimeError, \"not supported by this event\" unless @event == :return || @event == :c_return || @event == :b_return\n" ++
  "    @return_value\n" ++
  "  end\n" ++
  "  def method_id\n" ++
  "    @method_id\n" ++
  "  end\n" ++
  "  def callee_id\n" ++
  "    @method_id\n" ++
  "  end\n" ++
  "  def defined_class\n" ++
  "    @defined_class\n" ++
  "  end\n" ++
  "  def path\n" ++
  "    @path\n" ++
  "  end\n" ++
  "  # ruby's tracepoint_inspect: outside the handler only whether it is on;\n" ++
  "  # inside, the event and where it happened (and the method, for a call or\n" ++
  "  # return, or for a line that is directly in one). It printed the ivars.\n" ++
  "  def inspect\n" ++
  "    return(@enabled ? \"#<TracePoint:enabled>\" : \"#<TracePoint:disabled>\") unless @inside\n" ++
  "    at = @path.to_s + \":\" + (@lineno || 0).to_s\n" ++
  "    case @event\n" ++
  "    when :line\n" ++
  "      @method_id.nil? ? \"#<TracePoint:line \" + at + \">\" : \"#<TracePoint:line \" + at + \" in '\" + @method_id.to_s + \"'>\"\n" ++
  "    when :call, :c_call, :return, :c_return\n" ++
  "      \"#<TracePoint:\" + @event.to_s + \" '\" + @method_id.to_s + \"' \" + at + \">\"\n" ++
  "    when :thread_begin, :thread_end\n" ++
  "      \"#<TracePoint:\" + @event.to_s + \" \" + @tp_self.inspect + \">\"\n" ++
  "    else\n" ++
  "      \"#<TracePoint:\" + @event.to_s + \" \" + at + \">\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  # the line of the event, and only while the event is being handled\n" ++
  "  def lineno\n" ++
  "    raise RuntimeError, 'access from outside' unless @inside\n" ++
  "    @lineno || 0\n" ++
  "  end\n" ++
  "end\n" ++
  // The non-blocking read/write exceptions. Each is an Errno class WITH a
  // marker module mixed in, so `rescue IO::WaitReadable` catches whichever
  // errno the platform actually raised. EAGAIN and EWOULDBLOCK are the same
  // number on darwin and on linux, and where they are the same class ruby
  // makes the two Wait classes the same OBJECT too -- so the pair is decided
  // by asking, not by assuming, and a platform that separates them gets two.
  // ARGF: the pseudo-file over ARGV's files (stdin when there are none). A
  // real class, as ruby's is (`ARGF.class.new(*files)` is what mspec's argf
  // helper builds): the global ARGF was a stdin-only object, so it read the
  // program's stdin whatever ARGV named, and had no lineno, file, skip,
  // rewind or seek at all. The global one is made at startup, before this
  // class exists, and sets itself up over ARGV the first time it is used.
  "class ARGFClass\n" ++
  "  include Enumerable\n" ++
  "  def self.to_s; \"ARGF.class\"; end\n" ++
  "  def self.inspect; \"ARGF.class\"; end\n" ++
  "  def self.name; \"ARGF.class\"; end\n" ++
  "\n" ++
  "  def initialize(*argv)\n" ++
  "    @argv = argv\n" ++
  "    @__init = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # the global ARGF was made before this class existed: its state is set up\n" ++
  "  # the first time it is used, over ARGV itself\n" ++
  "  def __setup\n" ++
  "    return if @__init\n" ++
  "    @__init = true\n" ++
  "    @argv = ARGV\n" ++
  "  end\n" ++
  "\n" ++
  "  def argv; __setup; @argv; end\n" ++
  "\n" ++
  "  def __open_next\n" ++
  "    name = @argv.shift\n" ++
  "    @filename = name\n" ++
  "    @file = (name == \"-\") ? $stdin : File.open(name, \"r\")\n" ++
  "    @flines = 0\n" ++
  "    @file.binmode if @binmode\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  def __prep\n" ++
  "    __setup\n" ++
  "    unless @started\n" ++
  "      @started = true\n" ++
  "      @lineno ||= 0\n" ++
  "      if @argv.empty?\n" ++
  "        @file = $stdin\n" ++
  "        @filename = \"-\"\n" ++
  "        @flines = 0\n" ++
  "      else\n" ++
  "        __open_next\n" ++
  "      end\n" ++
  "    end\n" ++
  "    if @next_pending\n" ++
  "      @next_pending = false\n" ++
  "      __open_next unless @argv.empty?\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __closed_now?\n" ++
  "    @file.nil? || (@file != $stdin && @file.closed?)\n" ++
  "  end\n" ++
  "\n" ++
  "  # the current file is exhausted: close it and open the next, if any\n" ++
  "  def __advance\n" ++
  "    @file.close unless @file == $stdin || @file.closed?\n" ++
  "    return false if @argv.empty?\n" ++
  "    __open_next\n" ++
  "  end\n" ++
  "\n" ++
  "  def file; __prep; @file; end\n" ++
  "  def filename; __prep; @filename; end\n" ++
  "  alias path filename\n" ++
  "  def to_io; __prep; @file; end\n" ++
  "  def to_s; \"ARGF\"; end\n" ++
  "  alias inspect to_s\n" ++
  "\n" ++
  "  def lineno; __setup; @lineno ||= 0; end\n" ++
  "  def lineno=(n)\n" ++
  "    __setup\n" ++
  "    @lineno = n\n" ++
  "    $. = n\n" ++
  "  end\n" ++
  "\n" ++
  "  def __enc(s)\n" ++
  "    return s if s.nil?\n" ++
  "    if @binmode\n" ++
  "      s.force_encoding(Encoding::BINARY)\n" ++
  "    else\n" ++
  "      ext = @ext_enc || Encoding.default_external\n" ++
  "      s.force_encoding(ext)\n" ++
  "      s = s.encode(@int_enc, ext) if @int_enc\n" ++
  "    end\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def gets(*args)\n" ++
  "    __prep\n" ++
  "    loop do\n" ++
  "      if __closed_now?\n" ++
  "        $_ = nil\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "      line = @file.gets(*args)\n" ++
  "      if line\n" ++
  "        @lineno = (@lineno || 0) + 1\n" ++
  "        @flines = (@flines || 0) + 1\n" ++
  "        # the global ARGF puts its own count in $.; another instance leaves\n" ++
  "        # the FILE's there, as reading that file directly would\n" ++
  "        $. = equal?(::ARGF) ? @lineno : @flines\n" ++
  "        line = __enc(line)\n" ++
  "        $_ = line\n" ++
  "        return line\n" ++
  "      end\n" ++
  "      unless __advance\n" ++
  "        $_ = nil\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def readline(*args)\n" ++
  "    line = gets(*args)\n" ++
  "    raise EOFError, \"end of file reached\" if line.nil?\n" ++
  "    line\n" ++
  "  end\n" ++
  "\n" ++
  "  def readlines(*args)\n" ++
  "    out = []\n" ++
  "    while (line = gets(*args))\n" ++
  "      out << line\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "  alias to_a readlines\n" ++
  "\n" ++
  "  def each_line(*args)\n" ++
  "    return enum_for(:each_line, *args) \{ nil } unless block_given?\n" ++
  "    while (line = gets(*args))\n" ++
  "      yield line\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  alias each each_line\n" ++
  "\n" ++
  "  def read(len = nil, buf = nil)\n" ++
  "    __prep\n" ++
  "    out = +\"\"\n" ++
  "    if len.nil?\n" ++
  "      # everything already read: there is no stream left to read from\n" ++
  "      return nil if __closed_now? && @argv.empty? && buf.nil?\n" ++
  "      loop do\n" ++
  "        unless __closed_now?\n" ++
  "          chunk = @file.read\n" ++
  "          out << chunk if chunk\n" ++
  "        end\n" ++
  "        break unless __advance\n" ++
  "      end\n" ++
  "      out = __enc(out)\n" ++
  "    else\n" ++
  "      while out.bytesize < len\n" ++
  "        chunk = __closed_now? ? nil : @file.read(len - out.bytesize)\n" ++
  "        if chunk.nil? || chunk.empty?\n" ++
  "          break unless __advance\n" ++
  "          next\n" ++
  "        end\n" ++
  "        out << chunk\n" ++
  "      end\n" ++
  "      out.force_encoding(Encoding::BINARY)\n" ++
  "      out = nil if out.empty? && len > 0\n" ++
  "    end\n" ++
  "    if buf\n" ++
  "      buf.replace(out || \"\")\n" ++
  "      return out.nil? ? nil : buf\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "\n" ++
  "  def readpartial(len = nil, buf = nil)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1..2)\" if len.nil?\n" ++
  "    __prep\n" ++
  "    buf.replace(\"\") if buf\n" ++
  "    if __closed_now?\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    chunk = @file.read(len)\n" ++
  "    if chunk.nil? || chunk.empty?\n" ++
  "      last = @argv.empty?\n" ++
  "      __advance\n" ++
  "      raise EOFError, \"end of file reached\" if last\n" ++
  "      chunk = +\"\"\n" ++
  "    end\n" ++
  "    chunk.force_encoding(Encoding::BINARY)\n" ++
  "    if buf\n" ++
  "      buf.replace(chunk)\n" ++
  "      return buf\n" ++
  "    end\n" ++
  "    chunk\n" ++
  "  end\n" ++
  "\n" ++
  "  def getc\n" ++
  "    __prep\n" ++
  "    loop do\n" ++
  "      return nil if __closed_now?\n" ++
  "      c = @file.getc\n" ++
  "      return __enc(c) if c\n" ++
  "      return nil unless __advance\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def readchar\n" ++
  "    c = getc\n" ++
  "    raise EOFError, \"end of file reached\" if c.nil?\n" ++
  "    c\n" ++
  "  end\n" ++
  "  def getbyte\n" ++
  "    __prep\n" ++
  "    loop do\n" ++
  "      return nil if __closed_now?\n" ++
  "      b = @file.getbyte\n" ++
  "      return b if b\n" ++
  "      return nil unless __advance\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def readbyte\n" ++
  "    b = getbyte\n" ++
  "    raise EOFError, \"end of file reached\" if b.nil?\n" ++
  "    b\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_byte\n" ++
  "    return enum_for(:each_byte) \{ nil } unless block_given?\n" ++
  "    while (b = getbyte)\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def each_char\n" ++
  "    return enum_for(:each_char) \{ nil } unless block_given?\n" ++
  "    while (c = getc)\n" ++
  "      yield c\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def each_codepoint\n" ++
  "    return enum_for(:each_codepoint) \{ nil } unless block_given?\n" ++
  "    while (c = getc)\n" ++
  "      yield c.ord\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def eof?\n" ++
  "    __prep\n" ++
  "    raise IOError, \"closed stream\" if __closed_now?\n" ++
  "    @file.eof?\n" ++
  "  end\n" ++
  "  alias eof eof?\n" ++
  "\n" ++
  "  def pos\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.pos\n" ++
  "  end\n" ++
  "  alias tell pos\n" ++
  "  def pos=(n)\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.pos = n\n" ++
  "  end\n" ++
  "  def seek(off, whence = IO::SEEK_SET)\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.seek(off, whence)\n" ++
  "  end\n" ++
  "  def rewind\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream to rewind\" if __closed_now?\n" ++
  "    @lineno = (@lineno || 0) - (@flines || 0)\n" ++
  "    @flines = 0\n" ++
  "    $. = @lineno\n" ++
  "    @file.rewind\n" ++
  "    0\n" ++
  "  end\n" ++
  "\n" ++
  "  def fileno\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.fileno\n" ++
  "  end\n" ++
  "  alias to_i fileno\n" ++
  "\n" ++
  "  # the current file is done with: the next read opens the one after it\n" ++
  "  def skip\n" ++
  "    __setup\n" ++
  "    return self unless @started\n" ++
  "    return self if @next_pending || __closed_now?\n" ++
  "    @file.close unless @file == $stdin\n" ++
  "    @next_pending = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def close\n" ++
  "    __prep\n" ++
  "    unless __closed_now?\n" ++
  "      @file.close unless @file == $stdin\n" ++
  "      @next_pending = true\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def closed?\n" ++
  "    __prep\n" ++
  "    @file != $stdin && @file.closed?\n" ++
  "  end\n" ++
  "\n" ++
  "  def binmode\n" ++
  "    @binmode = true\n" ++
  "    @file.binmode if @file && !__closed_now?\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def binmode?; @binmode ? true : false; end\n" ++
  "\n" ++
  "  def set_encoding(ext, int = nil)\n" ++
  "    if int.nil? && ext.is_a?(String) && ext.include?(\":\")\n" ++
  "      ext, int = ext.split(\":\", 2)\n" ++
  "    end\n" ++
  "    @ext_enc = ext.is_a?(Encoding) ? ext : Encoding.find(ext.to_s)\n" ++
  "    @int_enc = int.nil? ? nil : (int.is_a?(Encoding) ? int : Encoding.find(int.to_s))\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def external_encoding; @ext_enc || Encoding.default_external; end\n" ++
  "  def internal_encoding; @int_enc || Encoding.default_internal; end\n" ++
  "end\n" ++
  "module Kernel\n" ++
  "  # exec: this process becomes the command. There is no execve here, so the\n" ++
  "  # command RUNS and the process then ends with its status, without at_exit\n" ++
  "  # handlers -- which is what replacing the process looks like from outside.\n" ++
  "  def exec(*args)\n" ++
  "    env = args.first.is_a?(Hash) ? args.shift : nil\n" ++
  "    opts = args.last.is_a?(Hash) ? args.pop : \{}\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1+)\" if args.empty?\n" ++
  "    args = args.map \{ |a| a.is_a?(Array) ? a.first : a }\n" ++
  "    args = args.map \{ |a| a.is_a?(String) ? a : a.to_str }\n" ++
  "    raise ArgumentError, \"string contains null byte\" if args.any? \{ |a| a.include?(\"\\0\") }\n" ++
  "    cmd = args.first\n" ++
  "    raise Errno::ENOENT, cmd if cmd.strip.empty?\n" ++
  "    q = lambda \{ |w| \"'\" + w.to_s.gsub(\"'\", \"'\\\\''\") + \"'\" }\n" ++
  "    shell = args.size == 1 && cmd.match?(/[\\s*?\\[\\]<>()~&|\\\\$;'`\"\\n#=%]/)\n" ++
  "    unless shell\n" ++
  "      path = cmd.include?(\"/\") ? cmd : (ENV[\"PATH\"] || \"\").split(\":\").map \{ |d| File.join(d, cmd) }.find \{ |f| File.exist?(f) }\n" ++
  "      raise Errno::ENOENT, cmd if path.nil? || !File.exist?(path)\n" ++
  "      raise Errno::EACCES, cmd if File.directory?(path) || !File.executable?(path)\n" ++
  "    end\n" ++
  "    line = shell ? cmd : args.map \{ |a| q.call(a) }.join(\" \")\n" ++
  "    line = \"cd \" + q.call(opts[:chdir]) + \" && \" + line if opts[:chdir]\n" ++
  "    line = \"env \" + env.map \{ |k, v| q.call(k.to_s + \"=\" + v.to_s) }.join(\" \") + \" sh -c \" + q.call(line) if env && !env.empty?\n" ++
  "    $stdout.flush\n" ++
  "    system(line)\n" ++
  "    exit!($?.exitstatus || 1)\n" ++
  "  end\n" ++
  "  module_function :exec\n" ++
  "end\n" ++
  "module Process\n" ++
  "  def self.exec(*args) = Kernel.exec(*args)\n" ++
  "end\n" ++
  "class IO\n" ++
  "  # IO.pipe with a block: the pair is yielded and both ends are closed after.\n" ++
  "  # Only the BLOCK form reaches this definition; the primitive is called\n" ++
  "  # under its other name, since a call made from inside a block-taking\n" ++
  "  # method can still see that block and would come back here.\n" ++
  "  def self.pipe(*args)\n" ++
  "    pair = IO.__pipe(*args)\n" ++
  "    return pair unless block_given?\n" ++
  "    begin\n" ++
  "      yield pair\n" ++
  "    ensure\n" ++
  "      pair.each \{ |io| io.close unless io.closed? }\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "class File\n" ++
  "  # chown(owner, group, *paths): nil or -1 leaves that id alone. The change\n" ++
  "  # is made by the system's chown/chgrp, and a refusal is ruby's EPERM.\n" ++
  "  def self.chown(owner, group, *paths)\n" ++
  "    paths.each do |pth|\n" ++
  "      pth = pth.to_path if pth.respond_to?(:to_path)\n" ++
  "      raise Errno::ENOENT, \"No such file or directory @ apply2files - \" + pth.to_s unless File.exist?(pth)\n" ++
  "      o = (owner.nil? || owner == -1) ? nil : owner.to_int\n" ++
  "      g = (group.nil? || group == -1) ? nil : group.to_int\n" ++
  "      next if o.nil? && g.nil?\n" ++
  "      spec = (o ? o.to_s : \"\") + (g ? \":\" + g.to_s : \"\")\n" ++
  "      ok = system(\"chown \" + spec + \" '\" + pth.to_s.gsub(\"'\", \"'\\\\''\") + \"' 2>/dev/null\")\n" ++
  "      raise Errno::EPERM, \"Operation not permitted @ apply2files - \" + pth.to_s unless ok\n" ++
  "    end\n" ++
  "    paths.size\n" ++
  "  end\n" ++
  "  def self.lchown(owner, group, *paths) = chown(owner, group, *paths)\n" ++
  "  def chown(owner, group) = (File.chown(owner, group, path); 0)\n" ++
  "end\n" ++
  // Thread::Backtrace: the class the Locations belong to, and the limit
  // --backtrace-limit set (-1 when none was)
  "class Thread\n" ++
  "  class Backtrace\n" ++
  "    def self.limit = ($__backtrace_limit || -1)\n" ++
  "  end\n" ++
  "end\n" ++
  "class IO\n" ++
  "  # whence, as ruby names them. `seek` took the numbers all along; the\n" ++
  "  # CONSTANTS did not exist, so `io.seek(1, IO::SEEK_CUR)` was a NameError.\n" ++
  "  SEEK_SET = 0\n" ++
  "  SEEK_CUR = 1\n" ++
  "  SEEK_END = 2\n" ++
  "  SEEK_DATA = 3\n" ++
  "  SEEK_HOLE = 4\n" ++
  "  # ⚠ ruby's IO includes Enumerable, and File inherits that. Two spec files\n" ++
  "  #   read it directly (core/io/io_spec, core/file/file_spec) and every\n" ++
  "  #   Enumerable method on an IO was reaching its own builtin rather than the\n" ++
  "  #   module, so the ancestry said no where the behaviour said yes.\n" ++
  "  include Enumerable\n" ++
  "\n" ++
  "  # ⚠ A standard stream printed its IVARS -- \"#<IO:0x67 @__io_fd=1>\" --\n" ++
  "  #   because it had no #inspect of its own and the generic fallback took\n" ++
  "  #   over. It has to live HERE and not in the dispatcher: inspect_w only\n" ++
  "  #   consults a METHOD-TABLE #inspect, so a dispatcher arm for the name is\n" ++
  "  #   never reached by `p`. ruby names the three standard streams and\n" ++
  "  #   numbers the rest.\n" ++
  "  def inspect\n" ++
  "    # a CLOSED stream has no descriptor left to name, and ruby prints none:\n" ++
  "    # \"#<IO:(closed)>\", not the number it used to have.\n" ++
  "    return \"#<IO:(closed)>\" if closed?\n" ++
  "    n = (@__io_fd == 0 ? \"<STDIN>\" : @__io_fd == 1 ? \"<STDOUT>\" :\n" ++
  "         @__io_fd == 2 ? \"<STDERR>\" : \"fd \" + @__io_fd.to_s)\n" ++
  "    \"#<IO:\" + n + \">\"\n" ++
  "  end\n" ++
  "  alias to_s inspect\n" ++
  "\n" ++
  "  module WaitReadable; end\n" ++
  "  module WaitWritable; end\n" ++
  "  # ruby 3.2: what an IO#timeout, or a connect's deadline, raises\n" ++
  "  class TimeoutError < IOError; end\n" ++
  "  class EAGAINWaitReadable < Errno::EAGAIN\n" ++
  "    include WaitReadable\n" ++
  "  end\n" ++
  "  class EAGAINWaitWritable < Errno::EAGAIN\n" ++
  "    include WaitWritable\n" ++
  "  end\n" ++
  "  class EINPROGRESSWaitReadable < Errno::EINPROGRESS\n" ++
  "    include WaitReadable\n" ++
  "  end\n" ++
  "  class EINPROGRESSWaitWritable < Errno::EINPROGRESS\n" ++
  "    include WaitWritable\n" ++
  "  end\n" ++
  "  if Errno::EAGAIN.equal?(Errno::EWOULDBLOCK)\n" ++
  "    EWOULDBLOCKWaitReadable = EAGAINWaitReadable\n" ++
  "    EWOULDBLOCKWaitWritable = EAGAINWaitWritable\n" ++
  "  else\n" ++
  "    EWOULDBLOCKWaitReadable = Class.new(Errno::EWOULDBLOCK) do\n" ++
  "      include WaitReadable\n" ++
  "    end\n" ++
  "    EWOULDBLOCKWaitWritable = Class.new(Errno::EWOULDBLOCK) do\n" ++
  "      include WaitWritable\n" ++
  "    end\n" ++
  "  end\n" ++
  "  # --- readiness: IO.select, #wait and the non-blocking pair --------------\n" ++
  "  # All of it is written over one primitive, IO.__poll (poll(2) on the\n" ++
  "  # descriptors, a wait in milliseconds, -1 for none). A File here is a path\n" ++
  "  # and a buffer rather than a descriptor, and a regular file is always ready\n" ++
  "  # to poll(2) anyway, so a File is answered as ready without asking.\n" ++
  "  #\n" ++
  "  # WAITING: with threads scheduled (IO.__sched?), a wait asks, then lets\n" ++
  "  #   the other threads run for a millisecond (IO.__park), and asks again,\n" ++
  "  #   until the time is up -- one of them may be the writer. In a build\n" ++
  "  #   without coroutines a thread body runs to completion at Thread.new, so a\n" ++
  "  #   thread that would wait PARKS for good, the main thread really waits,\n" ++
  "  #   and a pipe both of whose ends are this process's is named a deadlock.\n" ++
  "  READABLE = 1\n" ++
  "  PRIORITY = 2\n" ++
  "  WRITABLE = 4\n" ++
  "\n" ++
  "  def self.__sel_io(o)\n" ++
  "    return o if o.is_a?(IO)\n" ++
  "    # a socket is an IO in ruby; here BasicSocket is its own class, and it\n" ++
  "    # answers the two questions a wait asks (its fd, its read-ahead)\n" ++
  "    return o if defined?(BasicSocket) && o.is_a?(BasicSocket)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + o.class.to_s + \" into IO\" unless o.respond_to?(:to_io)\n" ++
  "    io = o.to_io\n" ++
  "    unless io.is_a?(IO)\n" ++
  "      raise TypeError, \"can't convert \" + o.class.to_s + \" to IO (\" + o.class.to_s + \"#to_io gives \" + io.class.to_s + \")\"\n" ++
  "    end\n" ++
  "    io\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__sel_ms(t)\n" ++
  "    return -1 if t.nil?\n" ++
  "    raise TypeError, \"can't convert \" + t.class.to_s + \" into time interval\" unless t.is_a?(Numeric)\n" ++
  "    raise RangeError, \"NaN out of Time range\" if t.is_a?(Float) && t.nan?\n" ++
  "    raise ArgumentError, \"time interval must not be negative\" if t < 0\n" ++
  "    return -1 if t.is_a?(Float) && t.infinite?\n" ++
  "    ms = (t * 1000).ceil\n" ++
  "    ms > 2147483647 ? 2147483647 : ms\n" ++
  "  end\n" ++
  "\n" ++
  "  # true when nothing outside this process could make `ios` ready: every one\n" ++
  "  # of them is an end of a pipe this process made\n" ++
  "  def self.__sel_stuck?(ios)\n" ++
  "    !ios.empty? && ios.all? do |io|\n" ++
  "      io.instance_variable_defined?(:@__io_peer)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # [[fd, interest], ...] -> the ready bits per entry; a nil fd is a File\n" ++
  "  def self.__sel_wait(ent, ms)\n" ++
  "    fds = []\n" ++
  "    ints = []\n" ++
  "    ent.each do |fd, b|\n" ++
  "      next if fd.nil?\n" ++
  "      i = fds.index(fd)\n" ++
  "      if i then ints[i] |= b else fds << fd; ints << b end\n" ++
  "    end\n" ++
  "    now = ent.any? \{ |fd, _| fd.nil? } ? 0 : ms\n" ++
  "    got = IO.__poll(fds, ints, 0)\n" ++
  "    if got.all? \{ |b| b == 0 } && now != 0 && !ent.any? \{ |fd, _| fd.nil? }\n" ++
  "      if IO.__sched?\n" ++
  "        # threads are scheduled: wait by letting the others run a\n" ++
  "        # millisecond at a time (one of them may be the writer), asking\n" ++
  "        # again after each, until the time is up\n" ++
  "        t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond)\n" ++
  "        begin\n" ++
  "          while got.all? \{ |b| b == 0 }\n" ++
  "            break if now != -1 && Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond) - t0 >= now\n" ++
  "            IO.__park\n" ++
  "            got = IO.__poll(fds, ints, 0)\n" ++
  "          end\n" ++
  "        ensure\n" ++
  "          IO.__unpark\n" ++
  "        end\n" ++
  "      elsif Thread.current != Thread.main\n" ++
  "        IO.__park\n" ++
  "      elsif fds.empty? && now == -1\n" ++
  "        # nothing to wait for and nobody left to wake it: the main thread's\n" ++
  "        # bare sleep, which is a no-op here\n" ++
  "        nil\n" ++
  "      elsif now == -1 && __sel_stuck?(ent.map \{ |e| e[2] })\n" ++
  "        raise IOError, \"deadlock: waiting on a pipe with nothing in it, and this interpreter runs thread bodies to completion, so nothing is left that could write to it\"\n" ++
  "      else\n" ++
  "        got = IO.__poll(fds, ints, now)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    ent.map do |fd, _|\n" ++
  "      fd.nil? ? 7 : got[fds.index(fd)]\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.select(*args)\n" ++
  "    unless args.size >= 1 && args.size <= 4\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1..4)\"\n" ++
  "    end\n" ++
  "    r, w, e, timeout = args\n" ++
  "    ms = __sel_ms(timeout)\n" ++
  "    sets = [r, w, e].map do |a|\n" ++
  "      if a.nil?\n" ++
  "        []\n" ++
  "      else\n" ++
  "        raise TypeError, \"wrong argument type \" + a.class.to_s + \" (expected Array)\" unless a.is_a?(Array)\n" ++
  "        a.map do |o|\n" ++
  "          io = __sel_io(o)\n" ++
  "          raise IOError, \"closed stream\" if io.closed?\n" ++
  "          [o, io]\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    ent = []\n" ++
  "    sets[0].each \{ |o, io| ent << [io.__sel_fd, 1, io] }\n" ++
  "    sets[1].each \{ |o, io| ent << [io.__sel_fd, 2, io] }\n" ++
  "    # bytes #getc read ahead are ready now, whatever the descriptor says\n" ++
  "    ms = 0 if sets[0].any? \{ |o, io| io.__sel_pending? }\n" ++
  "    got = __sel_wait(ent, ms)\n" ++
  "    nr = sets[0].size\n" ++
  "    rd = []\n" ++
  "    sets[0].each_with_index do |pair, i|\n" ++
  "      rd << pair[0] if pair[1].__sel_pending? || (got[i] & 5) != 0\n" ++
  "    end\n" ++
  "    wr = []\n" ++
  "    sets[1].each_with_index do |pair, i|\n" ++
  "      wr << pair[0] if (got[nr + i] & 6) != 0\n" ++
  "    end\n" ++
  "    return nil if rd.empty? && wr.empty?\n" ++
  "    [rd, wr, []]\n" ++
  "  end\n" ++
  "\n" ++
  "  def __sel_fd = @__io_fd\n" ++
  "  def __sel_pending? = !@__io_rbuf.nil? && !@__io_rbuf.empty?\n" ++
  "\n" ++
  "  # the events of `events` that are ready within `timeout`, or nil\n" ++
  "  def __wait_for(events, timeout)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    ms = IO.__sel_ms(timeout)\n" ++
  "    int = ((events & READABLE) != 0 ? 1 : 0) | ((events & WRITABLE) != 0 ? 2 : 0)\n" ++
  "    b = IO.__sel_wait([[__sel_fd, int, self]], ms)[0]\n" ++
  "    m = 0\n" ++
  "    m |= READABLE if (events & READABLE) != 0 && (b & 5) != 0\n" ++
  "    m |= WRITABLE if (events & WRITABLE) != 0 && (b & 6) != 0\n" ++
  "    m == 0 ? nil : m\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__wait_mode(sym)\n" ++
  "    case sym\n" ++
  "    when :r, :read, :readable then READABLE\n" ++
  "    when :w, :write, :writable then WRITABLE\n" ++
  "    when :rw, :read_write, :readable_writable then READABLE | WRITABLE\n" ++
  "    else raise ArgumentError, \"unsupported mode: \" + sym.to_s\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # ruby's two forms: wait(events, timeout) answers the ready events, and\n" ++
  "  # wait(timeout, *modes) -- in any order -- answers self\n" ++
  "  def wait(*args)\n" ++
  "    if args.size != 2 || args[0].is_a?(Symbol) || args[1].is_a?(Symbol)\n" ++
  "      events = 0\n" ++
  "      given = false\n" ++
  "      timeout = nil\n" ++
  "      args.each do |a|\n" ++
  "        if a.is_a?(Symbol)\n" ++
  "          events |= IO.__wait_mode(a)\n" ++
  "        elsif !given\n" ++
  "          IO.__sel_ms(a)\n" ++
  "          given = true\n" ++
  "          timeout = a\n" ++
  "        else\n" ++
  "          raise ArgumentError, \"timeout given more than once\"\n" ++
  "        end\n" ++
  "      end\n" ++
  "      events = READABLE if events == 0\n" ++
  "      return true if (events & READABLE) != 0 && __sel_pending?\n" ++
  "      __wait_for(events, timeout) ? self : nil\n" ++
  "    else\n" ++
  "      events = args[0].to_int\n" ++
  "      raise ArgumentError, \"Events must be positive integer!\" if events <= 0\n" ++
  "      return READABLE if (events & READABLE) != 0 && __sel_pending?\n" ++
  "      __wait_for(events, args[1])\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def wait_readable(timeout = nil)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    return true if __sel_pending?\n" ++
  "    __wait_for(READABLE, timeout) ? self : nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def wait_writable(timeout = nil)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    __wait_for(WRITABLE, timeout) ? self : nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def read_nonblock(len, buf = nil, exception: true)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    len = len.to_int\n" ++
  "    raise ArgumentError, \"negative length \" + len.to_s + \" given\" if len < 0\n" ++
  "    if __sel_fd.nil?\n" ++
  "      return nil if !exception && len != 0 && eof?\n" ++
  "      return sysread(len, buf)\n" ++
  "    end\n" ++
  "    if len == 0\n" ++
  "      return \"\" if buf.nil?\n" ++
  "      buf.clear\n" ++
  "      return buf\n" ++
  "    end\n" ++
  "    s = self.__nbread(len)\n" ++
  "    if s.is_a?(String)\n" ++
  "      s.force_encoding(Encoding::BINARY)\n" ++
  "      return s if buf.nil?\n" ++
  "      enc = buf.encoding\n" ++
  "      buf.replace(s)\n" ++
  "      buf.force_encoding(enc)\n" ++
  "      return buf\n" ++
  "    end\n" ++
  "    buf.clear unless buf.nil?\n" ++
  "    if s.nil?\n" ++
  "      return nil unless exception\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    return :wait_readable unless exception\n" ++
  "    raise IO::EAGAINWaitReadable, \"read would block\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def write_nonblock(s, exception: true)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    s = s.to_s\n" ++
  "    return syswrite(s) if __sel_fd.nil?\n" ++
  "    return 0 if s.empty?\n" ++
  "    n = self.__nbwrite(s)\n" ++
  "    return n if n >= 0\n" ++
  "    return :wait_writable unless exception\n" ++
  "    raise IO::EAGAINWaitWritable, \"write would block\"\n" ++
  "  end\n" ++
  "end\n" ++
  // ⚠ slice_before / slice_after were in the LIST this interpreter uses to
  // decide whether a name exists, with nothing behind them -- so the name was
  // claimed and every call, block form included, was a NoMethodError. Written
  // here over #each, which is the only thing they need, so Array, Hash, Range
  // and every `include Enumerable` class get one implementation between them.
  //
  // The two refuse DIFFERENTLY when given both a pattern and a block, which is
  // ruby's wording and not a slip: slice_before reports the argument count and
  // slice_after says "both pattern and block are given".
  "module Enumerable\n" ++
  "  def slice_before(*args, &blk)\n" ++
  "    if args.size > 1\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1)\"\n" ++
  "    elsif args.size > 0 && blk\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0)\"\n" ++
  "    elsif args.size == 0 && blk.nil?\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given 0, expected 1)\"\n" ++
  "    end\n" ++
  "    pat = args[0]\n" ++
  "    out = []\n" ++
  "    cur = nil\n" ++
  // a receiver whose #each yields SEVERAL values per element hands them to the
  // block as several arguments, so `|x|` took the first and threw the rest
  // away: `yield 1, 2` is the element `[1, 2]` here, as it is in ruby.
  "    each do |*a9|\n" ++
  "      x = a9.size == 1 ? a9[0] : a9\n" ++
  "      hit = blk ? blk.call(x) : (pat === x)\n" ++
  "      if cur.nil?\n" ++
  "        cur = [x]\n" ++
  "      elsif hit\n" ++
  "        out << cur\n" ++
  "        cur = [x]\n" ++
  "      else\n" ++
  "        cur << x\n" ++
  "      end\n" ++
  "    end\n" ++
  "    out << cur unless cur.nil?\n" ++
  "    out.each\n" ++
  "  end\n" ++
  "\n" ++
  "  def slice_after(*args, &blk)\n" ++
  "    if args.size > 1\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1)\"\n" ++
  "    elsif args.size > 0 && blk\n" ++
  "      raise ArgumentError, \"both pattern and block are given\"\n" ++
  "    elsif args.size == 0 && blk.nil?\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given 0, expected 1)\"\n" ++
  "    end\n" ++
  "    pat = args[0]\n" ++
  "    out = []\n" ++
  "    cur = []\n" ++
  "    each do |*a9|\n" ++
  "      x = a9.size == 1 ? a9[0] : a9\n" ++
  "      cur << x\n" ++
  "      hit = blk ? blk.call(x) : (pat === x)\n" ++
  "      if hit\n" ++
  "        out << cur\n" ++
  "        cur = []\n" ++
  "      end\n" ++
  "    end\n" ++
  "    out << cur unless cur.empty?\n" ++
  "    out.each\n" ++
  "  end\n" ++
  "end\n";

// Time#strftime, and the name tables it reads. The interpreter's Time answers
// its fields natively; the FORMATTING is one function over those fields, so it
// lives here rather than in an arm per directive. Logger's default line is the
// first caller that needed it, and the time groups are the rest.
let core_prelude_e =
  "class Time\n" ++
  "  # ⚠ These are methods, not constants. `Time.constants` is EMPTY in the\n" ++
  "  # reference, so four tables hung off Time would have been four divergences\n" ++
  "  # that nothing in this file needed -- Date is the class that publishes them.\n" ++
  "  def __daynames = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"]\n" ++
  "  def __abbr_daynames = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"]\n" ++
  "  def __monthnames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\",\n" ++
  "                      \"August\", \"September\", \"October\", \"November\", \"December\"]\n" ++
  "  def __abbr_monthnames = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n" ++
  "                           \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n" ++
  "\n" ++
  "  # Time.new(\"2020-12-24 15:56:17 +09:00\"), ruby's strict one-String form.\n" ++
  "  # A malformed string is \"can't parse:\" -- ruby's per-field messages say\n" ++
  "  # more, and the spec accepts either. The fraction is cut to `precision`\n" ++
  "  # digits (9 unless given; nil or negative keeps them all).\n" ++
  "  def self.__new_from_s(str, kw)\n" ++
  "    raise ArgumentError, \"time string should have ASCII compatible encoding\" unless str.encoding.ascii_compatible?\n" ++
  "    prec = 9\n" ++
  "    if kw && kw.key?(:precision)\n" ++
  "      pv = kw[:precision]\n" ++
  "      prec = if pv.nil? then nil\n" ++
  "             elsif Integer === pv then pv\n" ++
  "             elsif Numeric === pv then pv.to_i\n" ++
  "             elsif pv.respond_to?(:to_int) then pv.to_int\n" ++
  "             else raise TypeError, \"no implicit conversion of #\{pv.class} into Integer\"\n" ++
  "             end\n" ++
  "    end\n" ++
  "    m = /\\A(\\d\{4,})(?:-(\\d\\d)-(\\d\\d)[ T](\\d\\d):(\\d\\d):(\\d\\d)(?:\\.(\\d+))? ?(Z|UTC|[+-]\\d\\d(?::?\\d\\d(?::?\\d\\d)?)?)?)?\\z/.match(str)\n" ++
  "    raise ArgumentError, \"no time information\" if !m && /\\A\\d\{4,}-\\d\\d(?:-\\d\\d)?\\z/.match?(str)\n" ++
  "    raise ArgumentError, \"can't parse: \" + str.inspect unless m\n" ++
  "    zone = m[8] ? (m[8] == \"Z\" ? \"UTC\" : m[8]) : (kw ? kw[:in] : nil)\n" ++
  "    return new(m[1].to_i, 1, 1, 0, 0, 0, zone) unless m[2]\n" ++
  "    mon, mday, hour, min, sec = m[2].to_i, m[3].to_i, m[4].to_i, m[5].to_i, m[6].to_i\n" ++
  "    raise ArgumentError, \"mon out of range\" unless mon.between?(1, 12)\n" ++
  "    raise ArgumentError, \"mday out of range\" unless mday.between?(1, 31)\n" ++
  "    raise ArgumentError, \"hour out of range\" unless hour <= 24\n" ++
  "    raise ArgumentError, \"min out of range\" unless min < 60\n" ++
  "    raise ArgumentError, \"sec out of range\" unless sec <= 60\n" ++
  "    frac = m[7] || \"\"\n" ++
  "    frac = frac[0, prec] if prec && prec >= 0\n" ++
  "    s = frac.empty? ? sec : Rational(sec * 10**frac.length + frac.to_i, 10**frac.length)\n" ++
  "    new(m[1].to_i, mon, mday, hour, min, s, zone)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The calendar arguments of Time.local / .utc / .new, converted and checked\n" ++
  "  # the way time.c's time_arg does, answered as [year, mon, mday, hour, min,\n" ++
  "  # sec] with sec an Integer or an exact Rational (a 7th usec folded in).\n" ++
  "  # ⚠ The native constructors read VInts and nothing else, so \"12\", :dec,\n" ++
  "  # an object with #to_int and 2000.0 were all the default -- Time.local(\"2000\")\n" ++
  "  # was 1970 -- and no field was range-checked: Time.local(2008, 16) rolled\n" ++
  "  # into 2009. Measured one message at a time against the reference, which\n" ++
  "  # checks the bit WIDTH first (\"argument out of range\") and the calendar\n" ++
  "  # second (\"mon out of range\"), so month 13 and month 16 differ.\n" ++
  "  def self.__cname(v) = v.nil? ? \"nil\" : (v == true ? \"true\" : (v == false ? \"false\" : v.class.to_s))\n" ++
  "  def self.__int(v)\n" ++
  "    return v if Integer === v\n" ++
  "    return Integer(v, 10) if String === v\n" ++
  "    raise TypeError, \"no implicit conversion of #\{__cname(v)} into Integer\" unless v.respond_to?(:to_int)\n" ++
  "    v.to_int\n" ++
  "  end\n" ++
  "  def self.__ubits(v, bits)\n" ++
  "    n = __int(v)\n" ++
  "    raise ArgumentError, \"argument out of range\" if n < 0 || n >= (1 << bits)\n" ++
  "    n\n" ++
  "  end\n" ++
  "  def self.__exact(v)\n" ++
  "    return v if Integer === v || Rational === v\n" ++
  "    if Float === v\n" ++
  "      raise FloatDomainError, v.to_s unless v.finite?\n" ++
  "      return v.to_r\n" ++
  "    end\n" ++
  "    return v.to_int if !v.nil? && v.respond_to?(:to_int)\n" ++
  "    raise TypeError, \"can't convert #\{__cname(v)} into an exact number\"\n" ++
  "  end\n" ++
  "  def self.__civil(a, form)\n" ++
  "    n = a.size\n" ++
  "    if form == :new\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given #\{n}, expected 0..7)\" if n > 7\n" ++
  "    elsif n == 0 || n == 9 || n > 10\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given #\{n}, expected 1..8)\"\n" ++
  "    end\n" ++
  "    # ten are C's struct tm order: sec, min, hour, mday, mon, year, and four\n" ++
  "    # that are ignored\n" ++
  "    a0 = a\n" ++
  "    a = [a[5], a[4], a[3], a[2], a[1], a[0]] if n == 10 && form != :new\n" ++
  "    y = __int(a[0])\n" ++
  "    mon = a[1]\n" ++
  "    if mon.nil?\n" ++
  "      mon = 1\n" ++
  "    else\n" ++
  "      s = String === mon ? mon : (mon.respond_to?(:to_str) ? mon.to_str : nil)\n" ++
  "      i = s && s.length == 3 ? %w[jan feb mar apr may jun jul aug sep oct nov dec].index(s.downcase) : nil\n" ++
  "      mon = i ? i + 1 : __ubits(s || mon, 4)\n" ++
  "    end\n" ++
  "    mday = a[2].nil? ? 1 : __ubits(a[2], 5)\n" ++
  "    hour = a[3].nil? ? 0 : __ubits(a[3], 5)\n" ++
  "    min = a[4].nil? ? 0 : __ubits(a[4], 6)\n" ++
  "    if n == 7 && form != :new && !a[6].nil?\n" ++
  "      # a seventh argument is microseconds, and the second is then whole\n" ++
  "      sec = a[5].nil? ? 0 : __ubits(a[5], 6)\n" ++
  "      u = String === a[6] ? __int(a[6]) : __exact(a[6])\n" ++
  "      raise ArgumentError, \"subsecx out of range\" if u < 0 || u >= 1_000_000\n" ++
  "      sub = u == 0 ? 0 : Rational(u, 1_000_000)\n" ++
  "    elsif a[5].nil?\n" ++
  "      sec = 0\n" ++
  "      sub = 0\n" ++
  "    elsif String === a[5]\n" ++
  "      sec = __ubits(a[5], 6)\n" ++
  "      sub = 0\n" ++
  "    else\n" ++
  "      x = __exact(a[5])\n" ++
  "      sec = x.floor\n" ++
  "      sub = x - sec\n" ++
  "      raise ArgumentError, \"argument out of range\" if sec < 0 || sec >= 64\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"mon out of range\" unless mon.between?(1, 12)\n" ++
  "    raise ArgumentError, \"mday out of range\" unless mday.between?(1, 31)\n" ++
  "    raise ArgumentError, \"hour out of range\" if hour > 24\n" ++
  "    raise ArgumentError, \"min out of range\" if min > (hour == 24 ? 0 : 59)\n" ++
  "    raise ArgumentError, \"sec out of range\" if sec > (hour == 24 ? 0 : 60)\n" ++
  "    r = [y, mon, mday, hour, min, sub == 0 ? sec : sec + sub]\n" ++
  "    # the ten-argument form's ninth is isdst, which picks between the two\n" ++
  "    # readings of a repeated hour\n" ++
  "    r << (a0[8] ? true : false) if n == 10 && form != :new\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def deconstruct_keys(keys)\n" ++
  "    unless keys.nil? || Array === keys\n" ++
  "      raise TypeError, \"wrong argument type #\{keys.class} (expected Array or nil)\"\n" ++
  "    end\n" ++
  "    all = [:year, :month, :day, :yday, :wday, :hour, :min, :sec, :subsec, :dst, :zone]\n" ++
  "    h = \{}\n" ++
  "    (keys.nil? ? all : keys).each do |k|\n" ++
  "      next unless all.include?(k)\n" ++
  "      h[k] = case k\n" ++
  "             when :year then year\n" ++
  "             when :month then month\n" ++
  "             when :day then day\n" ++
  "             when :yday then yday\n" ++
  "             when :wday then wday\n" ++
  "             when :hour then hour\n" ++
  "             when :min then min\n" ++
  "             when :sec then sec\n" ++
  "             when :subsec then subsec\n" ++
  "             when :dst then dst?\n" ++
  "             else zone\n" ++
  "             end\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def __pad(s, width, pad)\n" ++
  "    return s if pad == \"-\" || width.nil? || s.length >= width\n" ++
  "    (pad == \"_\" ? \" \" : \"0\") * (width - s.length) + s\n" ++
  "  end\n" ++
  "\n" ++
  "  def __num(v, width, flags, defpad)\n" ++
  "    pad = flags.include?(\"-\") ? \"-\" : (flags.include?(\"_\") ? \"_\" : (flags.include?(\"0\") ? \"0\" : defpad))\n" ++
  "    s = v.abs.to_s\n" ++
  "    s = __pad(s, width, pad)\n" ++
  "    v < 0 ? \"-\" + s : s\n" ++
  "  end\n" ++
  "\n" ++
  "  # A Rational offset shows rounded to the nearest second, and the '-'\n" ++
  "  # flag on a UTC time is RFC 3339's \"unknown offset\", -0000.\n" ++
  "  def __utc_off_s(colons, flags = \"\", width = nil)\n" ++
  "    off = utc_offset.round\n" ++
  "    sign = off < 0 || (utc? && flags.include?(\"-\")) ? \"-\" : \"+\"\n" ++
  "    off = off.abs\n" ++
  "    h = off / 3600\n" ++
  "    m = (off % 3600) / 60\n" ++
  "    s = off % 60\n" ++
  "    rest = case colons\n" ++
  "           when 0 then format(\"%02d\", m)\n" ++
  "           when 1 then format(\":%02d\", m)\n" ++
  "           else format(\":%02d:%02d\", m, s)\n" ++
  "           end\n" ++
  "    # a width pads the HOURS, with spaces (the sign moving to the digits)\n" ++
  "    # under \"_\" and with zeros otherwise\n" ++
  "    hw = width ? [width - 1 - rest.length, 2].max : 2\n" ++
  "    if flags.include?(\"_\")\n" ++
  "      hs = h.to_s\n" ++
  "      \" \" * [hw - hs.length, 0].max + sign + hs + rest\n" ++
  "    else\n" ++
  "      sign + h.to_s.rjust(hw, \"0\") + rest\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __one(conv, flags, width)\n" ++
  "    up = flags.include?(\"^\")\n" ++
  "    r =\n" ++
  "      case conv\n" ++
  "      when \"Y\" then __num(year, width || 4, flags, \"0\")\n" ++
  "      when \"C\" then __num(year / 100, width || 2, flags, \"0\")\n" ++
  "      when \"y\" then __num(year % 100, width || 2, flags, \"0\")\n" ++
  "      when \"m\" then __num(mon, width || 2, flags, \"0\")\n" ++
  "      when \"d\" then __num(day, width || 2, flags, \"0\")\n" ++
  "      when \"e\" then __num(day, width || 2, flags.include?(\"0\") ? flags : flags + \"_\", \"_\")\n" ++
  "      when \"j\" then __num(yday, width || 3, flags, \"0\")\n" ++
  "      when \"H\" then __num(hour, width || 2, flags, \"0\")\n" ++
  "      when \"k\" then __num(hour, width || 2, flags.include?(\"0\") ? flags : flags + \"_\", \"_\")\n" ++
  "      when \"I\" then __num((hour % 12 == 0 ? 12 : hour % 12), width || 2, flags, \"0\")\n" ++
  "      when \"l\" then __num((hour % 12 == 0 ? 12 : hour % 12), width || 2, flags.include?(\"0\") ? flags : flags + \"_\", \"_\")\n" ++
  "      when \"M\" then __num(min, width || 2, flags, \"0\")\n" ++
  "      when \"S\" then __num(sec, width || 2, flags, \"0\")\n" ++
  "      when \"L\" then __pad((usec / 1000).to_s, width || 3, \"0\")\n" ++
  "      when \"N\" then (w = width || 9; d = format(\"%09d\", usec * 1000); w <= 9 ? d[0, w] : d + \"0\" * (w - 9))\n" ++
  "      when \"s\" then __num(to_i, width, flags, \"-\")\n" ++
  "      when \"z\" then __utc_off_s(0, flags, width)\n" ++
  "      when \"Z\" then (z = zone; String === z || z.nil? ? z.to_s : (z.respond_to?(:abbr) ? z.abbr(self) : (z.respond_to?(:name) ? z.name : z.to_s)))\n" ++
  "      when \"a\" then __abbr_daynames[wday]\n" ++
  "      when \"A\" then __daynames[wday]\n" ++
  "      when \"b\", \"h\" then __abbr_monthnames[mon - 1]\n" ++
  "      when \"B\" then __monthnames[mon - 1]\n" ++
  "      when \"p\" then (hour < 12 ? \"AM\" : \"PM\")\n" ++
  "      when \"P\" then (hour < 12 ? \"am\" : \"pm\")\n" ++
  "      when \"u\" then __num((wday == 0 ? 7 : wday), width || 1, flags, \"0\")\n" ++
  "      when \"w\" then __num(wday, width || 1, flags, \"0\")\n" ++
  "      when \"n\" then \"\\n\"\n" ++
  "      when \"t\" then \"\\t\"\n" ++
  "      when \"%\" then \"%\"\n" ++
  "      when \"F\" then strftime(\"%Y-%m-%d\")\n" ++
  "      when \"D\", \"x\" then strftime(\"%m/%d/%y\")\n" ++
  "      when \"T\", \"X\" then strftime(\"%H:%M:%S\")\n" ++
  "      when \"R\" then strftime(\"%H:%M\")\n" ++
  "      when \"r\" then strftime(\"%I:%M:%S %p\")\n" ++
  "      when \"c\" then strftime(\"%a %b %e %H:%M:%S %Y\")\n" ++
  "      when \"v\" then strftime(\"%e-%^b-%4Y\")\n" ++
  "      when \"+\" then strftime(\"%a %b %e %H:%M:%S %Z %Y\")\n" ++
  "      else nil\n" ++
  "      end\n" ++
  "    return nil if r.nil?\n" ++
  "    r = r.upcase if up\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def strftime(fmt)\n" ++
  "    out = +\"\"\n" ++
  "    i = 0\n" ++
  "    n = fmt.length\n" ++
  "    while i < n\n" ++
  "      c = fmt[i]\n" ++
  "      if c != \"%\"\n" ++
  "        out << c\n" ++
  "        i += 1\n" ++
  "        next\n" ++
  "      end\n" ++
  "      j = i + 1\n" ++
  "      flags = +\"\"\n" ++
  "      while j < n && (\"-_0^#\".include?(fmt[j]))\n" ++
  "        flags << fmt[j]\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      # the width may come before the colons (%-010:z) or after them\n" ++
  "      wid = +\"\"\n" ++
  "      while j < n && fmt[j] >= \"0\" && fmt[j] <= \"9\"\n" ++
  "        wid << fmt[j]\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      colons = 0\n" ++
  "      while j < n && fmt[j] == \":\"\n" ++
  "        colons += 1\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      while j < n && fmt[j] >= \"0\" && fmt[j] <= \"9\"\n" ++
  "        wid << fmt[j]\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      if j >= n\n" ++
  "        out << fmt[i, n - i]\n" ++
  "        break\n" ++
  "      end\n" ++
  "      conv = fmt[j]\n" ++
  "      if colons > 0\n" ++
  "        if conv == \"z\"\n" ++
  "          out << __utc_off_s(colons, flags, wid.empty? ? nil : wid.to_i)\n" ++
  "          i = j + 1\n" ++
  "          next\n" ++
  "        else\n" ++
  "          out << fmt[i, j - i + 1]\n" ++
  "          i = j + 1\n" ++
  "          next\n" ++
  "        end\n" ++
  "      end\n" ++
  "      piece = __one(conv, flags, wid.empty? ? nil : wid.to_i)\n" ++
  "      if piece.nil?\n" ++
  "        out << fmt[i, j - i + 1]\n" ++
  "      else\n" ++
  "        out << piece\n" ++
  "      end\n" ++
  "      i = j + 1\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "end\n";

// File::Stat, and the Process ids its ownership questions need. This is the
// one stat(2) snapshot ruby's File::Stat is, and every File class-method that
// was refusing for want of one (atime/mtime/ctime/ftype and the KIND and
// PERMISSION-BIT predicates) now answers from it. See the class's own comment
// for why the read goes through stat(1) and how the dialect is chosen.
let core_prelude_f =
  "# The four id(1) answers Process did not have. They cannot change inside a\n" ++
  "# process, so each is asked once and kept -- the alternative is a subprocess\n" ++
  "# per `owned?`, and File::Stat calls it on every file.\n" ++
  "module Process\n" ++
  "  # ⚠ `system` set no status at all, so `system(\"false\"); $?.exitstatus` was a\n" ++
  "  #   NoMethodError on nil -- the status of the command that just ran is the\n" ++
  "  #   first thing its caller asks for. This carries the exit code and nothing\n" ++
  "  #   else: there are no signals to report here, because `run` gives back an\n" ++
  "  #   exit code and not a wait(2) status.\n" ++
  "  class Status\n" ++
  "    def exitstatus = @__st\n" ++
  "    def to_i = @__st\n" ++
  "    def success? = (@__st == 0)\n" ++
  "    def exited? = true\n" ++
  "    def signaled? = false\n" ++
  "    def termsig = nil\n" ++
  "    def stopped? = false\n" ++
  "    def stopsig = nil\n" ++
  "    def pid = (@__pid || Process.pid)\n" ++
  "    def to_s = \"pid #\{pid} exit #\{@__st}\"\n" ++
  "    # Process::Status.wait with no children answers a status whose pid is -1\n" ++
  "    # (and exitstatus 0) rather than raising, which is ruby's documented\n" ++
  "    # difference from Process.wait; with one, it is Process.wait's status.\n" ++
  "    def self.wait(pid = -1, flags = 0)\n" ++
  "      begin\n" ++
  "        return Process.wait(pid, flags) && $?\n" ++
  "      rescue Errno::ECHILD\n" ++
  "      end\n" ++
  "      s = allocate\n" ++
  "      s.instance_variable_set(:@__st, 0)\n" ++
  "      s.instance_variable_set(:@__pid, -1)\n" ++
  "      s\n" ++
  "    end\n" ++
  "    def inspect = \"#<Process::Status: #\{self}>\"\n" ++
  "    # two statuses are equal when they carry the same status (there is no\n" ++
  "    # #== above this one to defer to: `super` was a NoMethodError)\n" ++
  "    def ==(o) = (o.is_a?(Integer) ? o == @__st : (o.is_a?(Process::Status) ? o.to_i == to_i : false))\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module Kernel\n" ++
  "  # ⚠ Kernel#test -- the one-character file predicates. It did not exist, so\n" ++
  "  #   `test(?f, path)` was a NoMethodError. The letters are a contract: f is a\n" ++
  "  #   regular file, d a directory, e exists, r/w/x the permissions, s the SIZE\n" ++
  "  #   (or nil when empty, which is why it is not a predicate), z empty.\n" ++
  "  def test(cmd, file, file2 = nil)\n" ++
  "    c = cmd.is_a?(Integer) ? cmd.chr : cmd.to_s\n" ++
  "    file = file.to_path if !file.is_a?(String) && file.respond_to?(:to_path)\n" ++
  "    case c\n" ++
  "    when \"f\" then File.file?(file)\n" ++
  "    when \"d\" then File.directory?(file)\n" ++
  "    when \"e\" then File.exist?(file)\n" ++
  "    when \"r\" then File.readable?(file)\n" ++
  "    when \"w\" then File.writable?(file)\n" ++
  "    when \"x\" then File.executable?(file)\n" ++
  "    when \"s\" then (File.exist?(file) && File.size(file) > 0) ? File.size(file) : nil\n" ++
  "    when \"z\" then File.exist?(file) && File.size(file) == 0\n" ++
  "    when \"l\" then File.symlink?(file)\n" ++
  "    when \"S\" then File.socket?(file)\n" ++
  "    when \"p\" then File.pipe?(file)\n" ++
  "    # the real-uid forms answer as the effective ones: one uid here\n" ++
  "    when \"R\" then File.readable?(file)\n" ++
  "    when \"W\" then File.writable?(file)\n" ++
  "    when \"X\" then File.executable?(file)\n" ++
  "    when \"A\" then File.atime(file)\n" ++
  "    when \"C\" then File.ctime(file)\n" ++
  "    when \"M\" then File.mtime(file)\n" ++
  "    else raise ArgumentError, \"unknown command ?#\{c}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  module_function :test\n" ++
  "\n" ++
  "  # Kernel#open: File.open for an ordinary path. The `|cmd` form -- a\n" ++
  "  # subprocess -- is NOT accepted, because there is no pipe to a child here\n" ++
  "  # and opening a file named \"|ls\" instead would be the wrong answer twice.\n" ++
  "  def open(name, *rest, &blk)\n" ++
  "    n = name.respond_to?(:to_path) ? name.to_path : name\n" ++
  "    if n.is_a?(String) && n.start_with?(\"|\")\n" ++
  "      raise NotImplementedError, \"Kernel#open with a command is not available here (no subprocesses)\"\n" ++
  "    end\n" ++
  "    File.open(n, *rest, &blk)\n" ++
  "  end\n" ++
  "  module_function :open\n" ++
  "\n" ++
  "  # Kernel#spawn is Process.spawn (see there for what a child is here)\n" ++
  "  def spawn(*args) = Process.spawn(*args)\n" ++
  "  module_function :spawn\n" ++
  "\n" ++
  "  # ⚠ Kernel#select IS NOT DEFINED HERE, and the reason is worth the line.\n" ++
  "  #   Defining it (a zero timeout answers nil, anything else refuses) closed\n" ++
  "  #   one core/kernel row and BROKE corpus/199: `Array.instance_method(:\n" ++
  "  #   select).arity` went 0 -> -1, because instance_method found this\n" ++
  "  #   Kernel method before Array's own builtin. `select` is Enumerable's\n" ++
  "  #   name as much as Kernel's, and a module_function on Kernel sits in the\n" ++
  "  #   ancestry of every Array. One row is not worth changing what\n" ++
  "  #   Array#select reports about itself.\n" ++
  "end\n" ++
  "\n" ++
  "module GC\n" ++
  "\n" ++
  "  # ⚠ GC.stat and GC.config answer a HASH, so they are written here rather than\n" ++
  "  #   in the dispatcher -- the numbers themselves come from the arms, which is\n" ++
  "  #   where the collector's own bookkeeping lives.\n" ++
  "  #\n" ++
  "  #   THE KEYS ARE THIS COLLECTOR'S. It has no generations, no slots and no\n" ++
  "  #   compactor, so it does not answer heap_live_slots, major_gc_count or the\n" ++
  "  #   forty other names CRuby fills in. Inventing them would be worse than not\n" ++
  "  #   having them: a program that reads GC.stat to decide something would\n" ++
  "  #   decide it on fiction. :count and :time are real and are what the spec\n" ++
  "  #   asks for.\n" ++
  "  def self.stat(arg = nil)\n" ++
  "    s = \{ count: GC.count, time: GC.total_time / 1_000_000 }\n" ++
  "    return s[arg] if arg.is_a?(Symbol)\n" ++
  "    # `GC.stat(hash)` FILLS the hash it is given and answers it -- keys already\n" ++
  "    # in it that the collector does not know are left alone, which the spec\n" ++
  "    # reads.\n" ++
  "    if arg.is_a?(Hash)\n" ++
  "      s.each \{ |k, v| arg[k] = v }\n" ++
  "      return arg\n" ++
  "    end\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  # GC.config, and the contract is the spec's: no argument answers the settings\n" ++
  "  # (with the global :implementation key), a Hash MERGES what it knows and\n" ++
  "  # ignores what it does not, nil answers the settings, and anything else is an\n" ++
  "  # ArgumentError. A global key is read-only and refused by name.\n" ++
  "  def self.config(arg = nil)\n" ++
  "    c = \{ implementation: \"mere-ruby\" }\n" ++
  "    return c if arg.nil?\n" ++
  "    unless arg.is_a?(Hash)\n" ++
  "      raise ArgumentError, \"expecting a Hash of options, got #\{arg.class}\"\n" ++
  "    end\n" ++
  "    if arg.key?(:implementation)\n" ++
  "      raise ArgumentError, 'Attempting to set read-only key \"Implementation\"'\n" ++
  "    end\n" ++
  "    # ...and every other key is ignored. This collector has no tunables, so\n" ++
  "    # there is nothing a caller could set; saying so by changing nothing is\n" ++
  "    # what \"ignores unknown keys\" means.\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  # @W$ PUBLIC, which is what ruby makes it -- GC.instance_methods(false) names\n" ++
  "  #   it and the spec calls it through `obj.extend(GC)` with an explicit\n" ++
  "  #   receiver. Marked private here it was a NoMethodError for a method that\n" ++
  "  #   exists.\n" ++
  "  def garbage_collect(**opts)\n" ++
  "    GC.start\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  def self.garbage_collect(**opts)\n" ++
  "    GC.start\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # GC::Profiler: the switch is real, the profile is empty. This collector\n" ++
  "  # keeps no per-run record, so while it is enabled there is nothing to\n" ++
  "  # report -- which is exactly what ruby answers before its first GC: an\n" ++
  "  # empty raw_data while enabled, nil while disabled, and a zero total.\n" ++
  "  module Profiler\n" ++
  "    @enabled = false\n" ++
  "    def self.enabled?; @enabled; end\n" ++
  "    def self.enable; @enabled = true; nil; end\n" ++
  "    def self.disable; @enabled = false; nil; end\n" ++
  "    def self.clear; nil; end\n" ++
  "    def self.raw_data; @enabled ? [] : nil; end\n" ++
  "    def self.result; +\"\"; end\n" ++
  "    def self.report(io = nil); nil; end\n" ++
  "    def self.total_time; 0.0; end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "\n" ++
  "module Process\n" ++
  "  def self.uid = (@__ruid ||= `id -ru`.to_i)\n" ++
  "  def self.gid = (@__rgid ||= `id -rg`.to_i)\n" ++
  "  def self.euid = (@__euid ||= `id -u`.to_i)\n" ++
  "  def self.egid = (@__egid ||= `id -g`.to_i)\n" ++
  "\n" ++
  "  # The same four ids under the names the POSIX-flavoured modules give them.\n" ++
  "  # ⚠ Four spec files read ONLY these spellings -- `Process::UID.rid` and its\n" ++
  "  #   three siblings -- so the readers above were right and four rows were a\n" ++
  "  #   NameError on a module that did not exist. The privilege-CHANGING half of\n" ++
  "  #   these modules is deliberately absent: switching uid is not something this\n" ++
  "  #   interpreter can do, and a method that pretends to would be worse than a\n" ++
  "  #   missing one.\n" ++
  "  module UID\n" ++
  "    def self.rid = Process.uid\n" ++
  "    def self.eid = Process.euid\n" ++
  "  end\n" ++
  "  module GID\n" ++
  "    def self.rid = Process.gid\n" ++
  "    def self.eid = Process.egid\n" ++
  "  end\n" ++
  "  module Sys\n" ++
  "    def self.getuid = Process.uid\n" ++
  "    def self.geteuid = Process.euid\n" ++
  "    def self.getgid = Process.gid\n" ++
  "    def self.getegid = Process.egid\n" ++
  "  end\n" ++
  "\n" ++
  "  # Process.argv0: the path the main script was given as. Frozen and the SAME\n" ++
  "  # object every time, both of which the spec reads.\n" ++
  "  def self.argv0\n" ++
  "    @__argv0 ||= $0.dup.freeze\n" ++
  "  end\n" ++
  "\n" ++
  "  # Documented as implementation-specific and free to be a no-op.\n" ++
  "  def self.warmup\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  WNOHANG = 1\n" ++
  "  WUNTRACED = 2\n" ++
  "  SHELL_WORDS = %w[case do done elif else esac fi for if in then until while\n" ++
  "                   ! . : break continue eval exec exit export readonly return set shift times trap unset]\n" ++
  "\n" ++
  "  # --- children: spawn, wait and detach ------------------------------------\n" ++
  "  # ⚠ THE RUNTIME HAS ONE WAY TO START A PROCESS, and it waits for it:\n" ++
  "  #   posix_spawn of `sh -c` and then waitpid. A child that outlives the call\n" ++
  "  #   is therefore started BY that shell, in the background, and reported back\n" ++
  "  #   through two files -- its pid, written as soon as it starts, and its exit\n" ++
  "  #   status, written by the shell that waits for it when it ends. So:\n" ++
  "  #   - the pid is the child's own, real pid (Process.kill reaches it, and it\n" ++
  "  #     is gone -- ESRCH -- once waited for);\n" ++
  "  #   - it is not OUR child in the kernel's sense but a grandchild, which is\n" ++
  "  #     why waiting polls a file instead of calling wait(2). The table below\n" ++
  "  #     is what makes it \"ours\": wait answers only pids spawn handed out, and\n" ++
  "  #     ECHILD for everything else, as the kernel would.\n" ++
  "  #   - a child killed by a signal reports 128+signal as an exit status,\n" ++
  "  #     because that is all the waiting shell can see.\n" ++
  "  @__kids = \{}\n" ++
  "  @__kid_n = 0\n" ++
  "\n" ++
  "  def self.__kid_dir\n" ++
  "    d = ENV[\"TMPDIR\"] || \"/tmp\"\n" ++
  "    d.end_with?(\"/\") ? d[0..-2] : d\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__str_arg(a)\n" ++
  "    s = a.is_a?(String) ? a : (a.respond_to?(:to_str) ? a.to_str : nil)\n" ++
  "    unless s.is_a?(String)\n" ++
  "      n = a.nil? ? \"nil\" : a == true ? \"true\" : a == false ? \"false\" : a.class.to_s\n" ++
  "      raise TypeError, \"no implicit conversion of \" + n + \" into String\"\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"string contains null byte\" if s.include?(\"\\0\")\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__q(w) = \"'\" + w.to_s.gsub(\"'\", \"'\\\\''\") + \"'\"\n" ++
  "\n" ++
  "  def self.__which(cmd, path)\n" ++
  "    return (File.exist?(cmd) ? cmd : nil) if cmd.include?(\"/\")\n" ++
  "    (path || \"\").split(\":\").each do |d|\n" ++
  "      f = File.join(d, cmd)\n" ++
  "      return f if File.file?(f) && File.executable?(f)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # a redirect target as the shell spells it, for descriptor `fd`\n" ++
  "  def self.__redir(fd, v)\n" ++
  "    v = v.to_io if !v.is_a?(IO) && v.respond_to?(:to_io)\n" ++
  "    t = if v.is_a?(Integer) then \">&\" + v.to_s\n" ++
  "        elsif v == :out then \">&1\"\n" ++
  "        elsif v == :err then \">&2\"\n" ++
  "        elsif v == :in then \"<&0\"\n" ++
  "        elsif v == :close then \">&-\"\n" ++
  "        elsif v.is_a?(IO) then \">&\" + v.fileno.to_s\n" ++
  "        elsif v.is_a?(String) then (fd == 0 ? \"<\" : \">\") + __q(v)\n" ++
  "        elsif v.is_a?(Array) && v[0] == :child then \">&\" + (v[1] == :out ? \"1\" : v[1] == :err ? \"2\" : v[1].to_s)\n" ++
  "        elsif v.is_a?(Array)\n" ++
  "          nm = __str_arg(v[0])\n" ++
  "          m = v[1].to_s\n" ++
  "          (fd == 0 ? \"<\" : (m.include?(\"a\") ? \">>\" : \">\")) + __q(nm)\n" ++
  "        else raise ArgumentError, \"wrong exec redirect action\"\n" ++
  "        end\n" ++
  "    fd.to_s + t\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_of(k)\n" ++
  "    return k if k.is_a?(Integer)\n" ++
  "    return 0 if k == :in\n" ++
  "    return 1 if k == :out\n" ++
  "    return 2 if k == :err\n" ++
  "    return k.fileno if k.is_a?(IO)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.spawn(*args)\n" ++
  "    env = nil\n" ++
  "    if !args.empty? && (args[0].is_a?(Hash) || (!args[0].is_a?(String) && !args[0].is_a?(Array) && args[0].respond_to?(:to_hash)))\n" ++
  "      env = args.shift\n" ++
  "      env = env.to_hash unless env.is_a?(Hash)\n" ++
  "    end\n" ++
  "    opts = args.last.is_a?(Hash) ? args.pop : \{}\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1+)\" if args.empty?\n" ++
  "    pre = []\n" ++
  "    if env\n" ++
  "      env.each do |k, v|\n" ++
  "        k = __str_arg(k)\n" ++
  "        raise ArgumentError, \"environment name contains a equal : \" + k if k.include?(\"=\")\n" ++
  "        if v.nil?\n" ++
  "          pre << \"unset \" + __q(k) + \";\"\n" ++
  "        else\n" ++
  "          pre << \"export \" + __q(k) + \"=\" + __q(__str_arg(v)) + \";\"\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    redir = []\n" ++
  "    late = []\n" ++
  "    pgroup = false\n" ++
  "    path = (env && env.key?(\"PATH\")) ? env[\"PATH\"] : ENV[\"PATH\"]\n" ++
  "    opts.each do |k, v|\n" ++
  "      if k.is_a?(String)\n" ++
  "        raise ArgumentError, \"wrong exec option: \" + k.inspect\n" ++
  "      elsif k == :chdir\n" ++
  "        d = v.respond_to?(:to_path) ? v.to_path : v\n" ++
  "        pre << \"cd \" + __q(d) + \" || exit 127;\"\n" ++
  "      elsif k == :umask\n" ++
  "        pre << \"umask \" + v.to_s(8) + \";\"\n" ++
  "      elsif k == :pgroup\n" ++
  "        pgroup = v ? true : false\n" ++
  "      elsif k == :unsetenv_others\n" ++
  "        pre << \"for __v in $(env | sed 's/=.*//'); do unset $__v 2>/dev/null; done;\" if v\n" ++
  "      elsif k == :close_others || k == :new_pgroup || k == :rlimit_core\n" ++
  "      elsif k.is_a?(Array)\n" ++
  "        # one open shared by every descriptor named, as ruby does it\n" ++
  "        fs = k.map \{ |kk| __fd_of(kk) }\n" ++
  "        redir << __redir(fs[0], v)\n" ++
  "        fs[1..].each \{ |f| redir << f.to_s + \">&\" + fs[0].to_s }\n" ++
  "      elsif (f = __fd_of(k))\n" ++
  "        # [:child, fd] names the CHILD's descriptor after the others are set\n" ++
  "        (v.is_a?(Array) && v[0] == :child ? late : redir) << __redir(f, v)\n" ++
  "      else\n" ++
  "        raise ArgumentError, \"wrong exec option symbol: \" + k.to_s\n" ++
  "      end\n" ++
  "    end\n" ++
  "    first = args[0]\n" ++
  "    first = first.to_ary if !first.is_a?(String) && !first.is_a?(Array) && first.respond_to?(:to_ary)\n" ++
  "    if first.is_a?(Array)\n" ++
  "      raise ArgumentError, \"wrong first argument\" unless first.size == 2\n" ++
  "      prog = __str_arg(first[0])\n" ++
  "      argv0 = __str_arg(first[1])\n" ++
  "      rest = args[1..].map \{ |a| __str_arg(a) }\n" ++
  "    else\n" ++
  "      prog = __str_arg(first)\n" ++
  "      argv0 = nil\n" ++
  "      rest = args[1..].map \{ |a| __str_arg(a) }\n" ++
  "    end\n" ++
  "    # a single string goes to the shell when it needs one: a metacharacter, or\n" ++
  "    # a first word that is a reserved word or special builtin (ruby's list)\n" ++
  "    shell = argv0.nil? && rest.empty? &&\n" ++
  "            (prog.match?(/[*?\{}\\[\\]<>()~&|\\\\$;'`\"\\n#=%]/) || SHELL_WORDS.include?(prog.split[0]))\n" ++
  "    if shell\n" ++
  "      # its own shell, as ruby's is: a line that does not parse is that\n" ++
  "      # shell's error (and exit status), never a hole in the script below\n" ++
  "      line = \"exec sh -c \" + __q(prog)\n" ++
  "    else\n" ++
  "      words = argv0.nil? && rest.empty? ? prog.split : [prog] + rest\n" ++
  "      raise Errno::ENOENT, prog if words.empty?\n" ++
  "      exe = __which(words[0], path)\n" ++
  "      if exe.nil?\n" ++
  "        __set_status(127, nil)\n" ++
  "        raise Errno::ENOENT, words[0]\n" ++
  "      end\n" ++
  "      if File.directory?(exe)\n" ++
  "        __set_status(127, nil)\n" ++
  "        raise Errno::EACCES, words[0]\n" ++
  "      end\n" ++
  "      line = (argv0.nil? ? \"\" : \"exec -a \" + __q(argv0) + \" \") + ([exe] + words[1..]).map \{ |w| __q(w) }.join(\" \")\n" ++
  "      line = \"exec \" + line if argv0.nil?\n" ++
  "    end\n" ++
  "    @__kid_n += 1\n" ++
  "    base = __kid_dir + \"/mere_ruby_kid.\" + Process.pid.to_s + \".\" + @__kid_n.to_s\n" ++
  "    pidf = base + \".pid\"\n" ++
  "    stf = base + \".st\"\n" ++
  "    inner = pre.join(\" \") + \" \" + line + \" \" + (redir + late).join(\" \")\n" ++
  "    STDOUT.flush\n" ++
  "    STDERR.flush\n" ++
  "    # the child is started by a background shell that waits for it; stdin is\n" ++
  "    # handed down explicitly, because an asynchronous list's is /dev/null, and\n" ++
  "    # so is stderr, because the waiting shell's own (\"Killed: 9\") is not ours.\n" ++
  "    # They travel on 9 and 8, out of the way of the low descriptors a pipe or\n" ++
  "    # a redirect names.\n" ++
  "    rc = Process.__sh(\"exec 9<&0 8>&2; ( ( \" + inner + \" ) <&9 2>&8 9<&- 8>&- & echo $! > \" + __q(pidf + \".t\") + \"; mv \" + __q(pidf + \".t\") + \" \" + __q(pidf) +\n" ++
  "                 \"; wait $!; echo $? > \" + __q(stf + \".t\") + \"; mv \" + __q(stf + \".t\") + \" \" + __q(stf) + \" ) 2>/dev/null &\")\n" ++
  "    n = 0\n" ++
  "    until File.exist?(pidf)\n" ++
  "      n += 1\n" ++
  "      raise SystemCallError.new(\"spawn: the child did not start (sh exit \" + rc.to_s + \")\", 0) if rc != 0 || n > 10000\n" ++
  "      IO.__poll([], [], 1)\n" ++
  "    end\n" ++
  "    pid = File.read(pidf).to_i\n" ++
  "    File.delete(pidf)\n" ++
  "    @__kids[pid] = [stf, pgroup]\n" ++
  "    pid\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__set_status(st, pid)\n" ++
  "    s = Process::Status.allocate\n" ++
  "    s.instance_variable_set(:@__st, st)\n" ++
  "    s.instance_variable_set(:@__pid, pid)\n" ++
  "    Process.__set_last(s)\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__to_pid(pid)\n" ++
  "    return pid if pid.is_a?(Integer)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + pid.class.to_s + \" into Integer\" unless pid.respond_to?(:to_int)\n" ++
  "    i = pid.to_int\n" ++
  "    raise TypeError, \"can't convert \" + pid.class.to_s + \" into Integer (\" + pid.class.to_s + \"#to_int gives \" + i.class.to_s + \")\" unless i.is_a?(Integer)\n" ++
  "    i\n" ++
  "  end\n" ++
  "\n" ++
  "  # the finished child among `pids`, or nil\n" ++
  "  def self.__reaped(pids)\n" ++
  "    pids.each do |p|\n" ++
  "      stf = @__kids[p][0]\n" ++
  "      next unless File.exist?(stf)\n" ++
  "      st = File.read(stf).to_i\n" ++
  "      File.delete(stf)\n" ++
  "      @__kids.delete(p)\n" ++
  "      __set_status(st, p)\n" ++
  "      return p\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.wait(pid = -1, flags = 0)\n" ++
  "    pid = __to_pid(pid)\n" ++
  "    flags = 0 if flags.nil?\n" ++
  "    pids = if pid == -1 then @__kids.keys\n" ++
  "           elsif pid == 0 then @__kids.keys.reject \{ |p| @__kids[p][1] }\n" ++
  "           elsif pid > 0 then (@__kids.key?(pid) ? [pid] : [])\n" ++
  "           else []\n" ++
  "           end\n" ++
  "    raise Errno::ECHILD if pids.empty?\n" ++
  "    loop do\n" ++
  "      got = __reaped(pids)\n" ++
  "      return got if got\n" ++
  "      return nil if (flags & WNOHANG) != 0\n" ++
  "      IO.__poll([], [], 5)\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def self.waitpid(pid = -1, flags = 0) = wait(pid, flags)\n" ++
  "  def self.wait2(pid = -1, flags = 0)\n" ++
  "    got = wait(pid, flags)\n" ++
  "    got.nil? ? nil : [got, $?]\n" ++
  "  end\n" ++
  "  def self.waitpid2(pid = -1, flags = 0) = wait2(pid, flags)\n" ++
  "  def self.waitall\n" ++
  "    out = []\n" ++
  "    until @__kids.empty?\n" ++
  "      p = wait\n" ++
  "      out << [p, $?]\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.last_status(*args)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0)\" unless args.empty?\n" ++
  "    $?\n" ++
  "  end\n" ++
  "\n" ++
  "  # the thread detach answers: its value is the child's status, and it\n" ++
  "  # knows the pid it is waiting for\n" ++
  "  class Waiter < Thread\n" ++
  "    def pid = self[:pid]\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.detach(pid)\n" ++
  "    pid = __to_pid(pid)\n" ++
  "    Waiter.new(pid) do |p|\n" ++
  "      Thread.current[:pid] = p\n" ++
  "      begin\n" ++
  "        Process.wait(p)\n" ++
  "        $?\n" ++
  "      rescue Errno::ECHILD\n" ++
  "        nil\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "  Tms = Struct.new(:utime, :stime, :cutime, :cstime)\n" ++
  "\n" ++
  "  # ⚠ CPU time, and it costs a subprocess: there is no times(2) or\n" ++
  "  #   getrusage(2) extern here, and `ps -o utime=,stime=` is the reading this\n" ++
  "  #   platform will give for a pid. Wall clock was the alternative and it is\n" ++
  "  #   not the same quantity -- a process that sleeps burns no CPU and every\n" ++
  "  #   caller of #times is asking exactly that. The resolution is 10ms, which\n" ++
  "  #   is ps's, not ours.\n" ++
  "  def self.times\n" ++
  "    out = `ps -p #\{Process.pid} -o utime=,stime= 2>/dev/null`.split\n" ++
  "    u = __ps_secs(out[0])\n" ++
  "    s = __ps_secs(out[1])\n" ++
  "    Tms.new(u, s, 0.0, 0.0)\n" ++
  "  end\n" ++
  "\n" ++
  "  # \"M:SS.ss\" or \"H:MM:SS.ss\" -> seconds.\n" ++
  "  def self.__ps_secs(t)\n" ++
  "    return 0.0 if t.nil?\n" ++
  "    parts = t.split(\":\")\n" ++
  "    secs = 0.0\n" ++
  "    parts.each \{ |p| secs = secs * 60 + p.to_f }\n" ++
  "    secs\n" ++
  "  end\n" ++
  "  private_class_method :__ps_secs\n" ++
  "\n" ++
  "  # ⚠ THE UNIT was ignored entirely: every clock_gettime answered a float\n" ++
  "  #   second whatever was asked for, so `clock_gettime(c, :nanosecond)` -- which\n" ++
  "  #   ruby answers with an Integer -- came back as a Float of seconds. The unit\n" ++
  "  #   is the part of this call a caller can actually observe here, because\n" ++
  "  #   every clock below IS the same wall clock: there is no clock_gettime(2)\n" ++
  "  #   extern, only one that reads the time of day.\n" ++
  "  UNITS = [:float_second, :float_millisecond, :float_microsecond,\n" ++
  "           :second, :millisecond, :microsecond, :nanosecond].freeze\n" ++
  "\n" ++
  "  def self.__in_unit(secs, unit)\n" ++
  "    case unit\n" ++
  "    when nil, :float_second then secs\n" ++
  "    when :float_millisecond then secs * 1000.0\n" ++
  "    when :float_microsecond then secs * 1000000.0\n" ++
  "    when :second then (secs).to_i\n" ++
  "    when :millisecond then (secs * 1000).to_i\n" ++
  "    when :microsecond then (secs * 1000000).to_i\n" ++
  "    when :nanosecond then (secs * 1000000000).to_i\n" ++
  "    else raise ArgumentError, \"unexpected unit: #\{unit.inspect}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  private_class_method :__in_unit\n" ++
  "\n" ++
  "  def self.clock_gettime(clock, unit = :float_second)\n" ++
  "    __in_unit(__clock_raw, unit)\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ The three SYMBOL clocks have resolutions ruby documents, so they are\n" ++
  "  #   answered as documented. The numeric ones are \"observed\", and the spec\n" ++
  "  #   only requires <= 10ms; one microsecond is what a gettimeofday-based\n" ++
  "  #   clock gives and is the honest claim for the one behind __clock_raw.\n" ++
  "  def self.clock_getres(clock, unit = :float_second)\n" ++
  "    ns = case clock\n" ++
  "         when :TIME_BASED_CLOCK_REALTIME, :TIME_BASED_CLOCK_MONOTONIC then 1000000000\n" ++
  "         else 1000\n" ++
  "         end\n" ++
  "    __in_unit(ns / 1000000000.0, unit)\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "\n" ++
  "class File\n" ++
  "  # One stat(2) snapshot, which is what CRuby's File::Stat is: the fields are\n" ++
  "  # read ONCE, at construction, and every reader answers from that copy.\n" ++
  "  #\n" ++
  "  # ⚠ The read goes through stat(1), not stat(2). This interpreter's host\n" ++
  "  # language has no struct-reading FFI -- its externs carry ints, floats and\n" ++
  "  # strings -- so the choice was between a hardcoded `struct stat` offset table\n" ++
  "  # (which is an ABI claim this repository cannot check, and differs between\n" ++
  "  # the macOS it is developed on and the Linux CI runs) and one subprocess.\n" ++
  "  # A subprocess per SNAPSHOT is the honest cost, and it is the same cost model\n" ++
  "  # File.writable? has had all along (`test -w`). It is one process per\n" ++
  "  # File.stat, not one per field, because the snapshot is the unit.\n" ++
  "  class Stat\n" ++
  "    include Comparable\n" ++
  "\n" ++
  "    def self.__shq(s)\n" ++
  "      \"'\" + s.to_s.gsub(\"'\", \"'\\\\\\\\''\") + \"'\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # BSD and GNU stat(1) take different format flags and print the mode in a\n" ++
  "    # different base, so the dialect has to be CHOSEN, not discovered by trying\n" ++
  "    # one and seeing whether it failed.\n" ++
  "    #\n" ++
  "    # ⚠ Measured on ubuntu 24.04: `stat -f <format> -- file` under GNU coreutils\n" ++
  "    # does not fail quietly. `-f` there means \"file SYSTEM status\", so it errors\n" ++
  "    # on the format string, exits 1, AND PRINTS SIX LINES OF FILESYSTEM INFO TO\n" ++
  "    # STDOUT. A fallback that asked \"was stdout empty?\" reads those lines as a\n" ++
  "    # BSD answer -- they split into more than thirteen tokens -- and every field\n" ++
  "    # comes out 0. That is worse than no File::Stat at all, so:\n" ++
  "    #   1. `uname -s` picks the dialect (RUBY_PLATFORM cannot: this interpreter\n" ++
  "    #      reports a hardcoded \"arm64-darwin25\" whatever it is running on), and\n" ++
  "    #   2. every token is required to be a plain number in its own base, so a\n" ++
  "    #      dialect that was chosen wrongly raises instead of inventing fields.\n" ++
  "    def self.__bsd?\n" ++
  "      @__bsd = ![\"Linux\", \"GNU\"].include?(`uname -s 2>/dev/null`.strip) if @__bsd.nil?\n" ++
  "      @__bsd\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.__nums(f, base)\n" ++
  "      f.each do |x|\n" ++
  "        return nil unless x =~ (base == 16 ? /\\A[0-9a-fA-F]+\\z/ : /\\A[0-9]+\\z/)\n" ++
  "      end\n" ++
  "      f\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.__raw(path)\n" ++
  "      q = __shq(path)\n" ++
  "      if __bsd?\n" ++
  "        f = `stat -f '%d %i %p %l %u %g %r %z %a %m %c %k %b' -- #\{q} 2>/dev/null`.split\n" ++
  "        return nil if f.size != 13 || __nums(f, 10).nil?\n" ++
  "        \{ dev: f[0].to_i, ino: f[1].to_i, mode: f[2].to_i(8), nlink: f[3].to_i,\n" ++
  "          uid: f[4].to_i, gid: f[5].to_i, rdev: f[6].to_i, size: f[7].to_i,\n" ++
  "          atime: f[8].to_i, mtime: f[9].to_i, ctime: f[10].to_i,\n" ++
  "          blksize: f[11].to_i, blocks: f[12].to_i }\n" ++
  "      else\n" ++
  "        f = `stat -c '%d %i %f %h %u %g %t %T %s %X %Y %Z %o %b' -- #\{q} 2>/dev/null`.split\n" ++
  "        return nil if f.size != 14 || __nums(f, 16).nil?\n" ++
  "        \{ dev: f[0].to_i, ino: f[1].to_i, mode: f[2].to_i(16), nlink: f[3].to_i,\n" ++
  "          uid: f[4].to_i, gid: f[5].to_i,\n" ++
  "          rdev: f[6].to_i(16) * 256 + f[7].to_i(16),\n" ++
  "          size: f[8].to_i, atime: f[9].to_i, mtime: f[10].to_i,\n" ++
  "          ctime: f[11].to_i, blksize: f[12].to_i, blocks: f[13].to_i }\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def initialize(path)\n" ++
  "      path = path.to_path if !path.is_a?(String) && path.respond_to?(:to_path)\n" ++
  "      raise TypeError, \"no implicit conversion into String\" unless path.is_a?(String)\n" ++
  "      h = File::Stat.__raw(path)\n" ++
  "      raise Errno::ENOENT, \"No such file or directory @ rb_file_s_stat - #\{path}\" if h.nil?\n" ++
  "      @h = h\n" ++
  "    end\n" ++
  "\n" ++
  "    def dev = @h[:dev]\n" ++
  "    def ino = @h[:ino]\n" ++
  "    def mode = @h[:mode]\n" ++
  "    def nlink = @h[:nlink]\n" ++
  "    def uid = @h[:uid]\n" ++
  "    def gid = @h[:gid]\n" ++
  "    def rdev = @h[:rdev]\n" ++
  "    def size = @h[:size]\n" ++
  "    def blksize = @h[:blksize]\n" ++
  "    def blocks = @h[:blocks]\n" ++
  "    def atime = Time.at(@h[:atime])\n" ++
  "    def mtime = Time.at(@h[:mtime])\n" ++
  "    def ctime = Time.at(@h[:ctime])\n" ++
  "    def birthtime = Time.at(@h[:ctime])\n" ++
  "    def dev_major = @h[:dev] / 16777216\n" ++
  "    def dev_minor = @h[:dev] % 256\n" ++
  "    def rdev_major = @h[:rdev] / 256\n" ++
  "    def rdev_minor = @h[:rdev] % 256\n" ++
  "\n" ++
  "    # the file-type bits. A constant here would show up in\n" ++
  "    # File::Stat.constants, which is empty in the reference.\n" ++
  "    def __fmt = mode & 0o170000\n" ++
  "\n" ++
  "    def file? = __fmt == 0o100000\n" ++
  "    def directory? = __fmt == 0o040000\n" ++
  "    def symlink? = __fmt == 0o120000\n" ++
  "    def chardev? = __fmt == 0o020000\n" ++
  "    def blockdev? = __fmt == 0o060000\n" ++
  "    def pipe? = __fmt == 0o010000\n" ++
  "    def socket? = __fmt == 0o140000\n" ++
  "\n" ++
  "    def ftype\n" ++
  "      case __fmt\n" ++
  "      when 0o100000 then \"file\"\n" ++
  "      when 0o040000 then \"directory\"\n" ++
  "      when 0o120000 then \"link\"\n" ++
  "      when 0o020000 then \"characterSpecial\"\n" ++
  "      when 0o060000 then \"blockSpecial\"\n" ++
  "      when 0o010000 then \"fifo\"\n" ++
  "      when 0o140000 then \"socket\"\n" ++
  "      else \"unknown\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def setuid? = (mode & 0o4000) != 0\n" ++
  "    def setgid? = (mode & 0o2000) != 0\n" ++
  "    def sticky? = (mode & 0o1000) != 0\n" ++
  "    def world_readable? = ((mode & 0o004) != 0) ? (mode & 0o7777) : nil\n" ++
  "    def world_writable? = ((mode & 0o002) != 0) ? (mode & 0o7777) : nil\n" ++
  "    def owned? = uid == Process.uid\n" ++
  "    def grpowned? = gid == Process.gid\n" ++
  "    def zero? = size == 0\n" ++
  "    def size? = size == 0 ? nil : size\n" ++
  "    def readable? = __perm(0o400, 0o040, 0o004)\n" ++
  "    def writable? = __perm(0o200, 0o020, 0o002)\n" ++
  "    def executable? = __perm(0o100, 0o010, 0o001)\n" ++
  "    alias readable_real? readable?\n" ++
  "    alias writable_real? writable?\n" ++
  "    alias executable_real? executable?\n" ++
  "\n" ++
  "    def __perm(u, g, o)\n" ++
  "      return true if Process.uid == 0\n" ++
  "      return (mode & u) != 0 if uid == Process.uid\n" ++
  "      return (mode & g) != 0 if gid == Process.gid\n" ++
  "      (mode & o) != 0\n" ++
  "    end\n" ++
  "\n" ++
  "    def <=>(other) = other.is_a?(File::Stat) ? (@h[:mtime] <=> other.mtime.to_i) : nil\n" ++
  "    def ==(other) = other.is_a?(File::Stat) && (self <=> other) == 0\n" ++
  "\n" ++
  "    def inspect\n" ++
  "      \"#<File::Stat dev=0x#\{dev.to_s(16)}, ino=#\{ino}, mode=0#\{mode.to_s(8)}, \" \\\n" ++
  "      \"nlink=#\{nlink}, uid=#\{uid}, gid=#\{gid}, rdev=0x#\{rdev.to_s(16)}, \" \\\n" ++
  "      \"size=#\{size}, blksize=#\{blksize}, blocks=#\{blocks}, \" \\\n" ++
  "      \"atime=#\{atime}, mtime=#\{mtime}, ctime=#\{ctime}>\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.stat(path) = File::Stat.new(path)\n" ++
  "  def self.lstat(path) = File::Stat.new(path)\n" ++
  "\n" ++
  "  def self.atime(path) = stat(path).atime\n" ++
  "  def self.mtime(path) = stat(path).mtime\n" ++
  "  def self.ctime(path) = stat(path).ctime\n" ++
  "  def self.birthtime(path) = stat(path).birthtime\n" ++
  "  def self.ftype(path) = stat(path).ftype\n" ++
  "\n" ++
  "  def self.owned?(path) = (stat(path).owned? rescue false)\n" ++
  "  def self.grpowned?(path) = (stat(path).grpowned? rescue false)\n" ++
  "  def self.setuid?(path) = (stat(path).setuid? rescue false)\n" ++
  "  def self.setgid?(path) = (stat(path).setgid? rescue false)\n" ++
  "  def self.sticky?(path) = (stat(path).sticky? rescue false)\n" ++
  "  def self.pipe?(path) = (stat(path).pipe? rescue false)\n" ++
  "  def self.socket?(path) = (stat(path).socket? rescue false)\n" ++
  "  def self.blockdev?(path) = (stat(path).blockdev? rescue false)\n" ++
  "  def self.chardev?(path) = (stat(path).chardev? rescue false)\n" ++
  "  def self.world_readable?(path) = (stat(path).world_readable? rescue nil)\n" ++
  "  def self.world_writable?(path) = (stat(path).world_writable? rescue nil)\n" ++
  "end\n" ++
  "\n" ++
  "module FileTest\n" ++
  "  def self.owned?(path) = File.owned?(path)\n" ++
  "  def self.grpowned?(path) = File.grpowned?(path)\n" ++
  "  def self.setuid?(path) = File.setuid?(path)\n" ++
  "  def self.setgid?(path) = File.setgid?(path)\n" ++
  "  def self.sticky?(path) = File.sticky?(path)\n" ++
  "  def self.pipe?(path) = File.pipe?(path)\n" ++
  "  def self.socket?(path) = File.socket?(path)\n" ++
  "  def self.blockdev?(path) = File.blockdev?(path)\n" ++
  "  def self.chardev?(path) = File.chardev?(path)\n" ++
  "  def self.world_readable?(path) = File.world_readable?(path)\n" ++
  "  def self.world_writable?(path) = File.world_writable?(path)\n" ++
  "end\n";

// Dir's Enumerable and the three class methods that are one walk over an
// existing one (`entries` / `children`). They are here rather than in the
// dispatcher arm because they add nothing the arm has to know about.
let core_prelude_g =
  "class Dir\n" ++
  "  # ruby's Dir includes Enumerable, and a spec of its own reads that.\n" ++
  "  include Enumerable\n" ++
  "\n" ++
  "  # `empty?` is \"a directory with nothing in it\", so a path that is not a\n" ++
  "  # directory is false rather than an error -- but a path that is not THERE is\n" ++
  "  # ENOENT, which `entries` already raises.\n" ++
  "  def self.empty?(path)\n" ++
  "    # ⚠ A path that is not THERE is ENOENT; a path that is there and is not\n" ++
  "    # a directory is merely false. Answering false for both loses the\n" ++
  "    # difference, and it is the difference the spec reads.\n" ++
  "    raise Errno::ENOENT, path.to_s unless File.exist?(path)\n" ++
  "    return false unless File.directory?(path)\n" ++
  "    entries(path).size <= 2\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ These took (path) only, so `Dir.foreach(path, encoding: \"UTF-8\")` was an\n" ++
  "  #   ArgumentError -- the keyword is accepted by ruby and names the encoding\n" ++
  "  #   of the entries. It is accepted and not acted on: entries here carry the\n" ++
  "  #   filesystem encoding already, and refusing the keyword is a bigger\n" ++
  "  #   divergence than ignoring it.\n" ++
  "  # ⚠ ...and the enumerator's SIZE. to_enum with no size block answers nil in\n" ++
  "  #   ruby -- \"I do not know how many\" -- and this counted the entries instead,\n" ++
  "  #   so `Dir.foreach(path).size` was 15 where ruby says nil.\n" ++
  "  # ⚠ The encoding keyword is not decoration: the spec reads the encoding OFF\n" ++
  "  #   the yielded names. Accepting it and ignoring it answered UTF-8 where\n" ++
  "  #   ISO-8859-1 was asked for -- a keyword that looks honoured and is not.\n" ++
  "  def self.__with_enc(names, encoding)\n" ++
  "    return names if encoding.nil?\n" ++
  "    # an Encoding OBJECT is allowed here and Encoding.find refuses one --\n" ++
  "    # ruby/spec passes both spellings in the same example.\n" ++
  "    enc = encoding.is_a?(Encoding) ? encoding : Encoding.find(encoding)\n" ++
  "    names.map \{ |n| n.dup.force_encoding(enc) }\n" ++
  "  end\n" ++
  "  private_class_method :__with_enc\n" ++
  "\n" ++
  "  def self.each_child(path, encoding: nil, &block)\n" ++
  "    return to_enum(:each_child, path, encoding: encoding) \{ nil } unless block_given?\n" ++
  "    __with_enc(children(path), encoding).each(&block)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.foreach(path, encoding: nil, &block)\n" ++
  "    return to_enum(:foreach, path, encoding: encoding) \{ nil } unless block_given?\n" ++
  "    __with_enc(entries(path), encoding).each(&block)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "end\n";

// The File INSTANCE side of the snapshot: #stat, #atime, #mtime, #ctime,
// #birthtime, #size. A File here is a path, a mode and a buffer, so each
// of these is the class method of the same name asked about @__f_path.
let core_prelude_h =
  "class File\n" ++
  "  # The instance side of the snapshot. A File here is a path, a mode and a\n" ++
  "  # buffer (see #fileno), and the path is what these need -- so they are the\n" ++
  "  # class methods asked about @__f_path rather than anything new.\n" ++
  "  # ⚠ each asks whether the stream is closed first: the builtin arm's guard\n" ++
  "  # is at ITS entry and a ruby method never reaches it, so `f.stat` answered on\n" ++
  "  # a closed File while `f.read` refused.\n" ++
  "  def __closed!\n" ++
  "    raise IOError, \"closed stream\" if self.closed?\n" ++
  "  end\n" ++
  "  private :__closed!\n" ++
  "\n" ++
  "  def stat = (__closed!; File::Stat.new(@__f_path))\n" ++
  "  def lstat = (__closed!; File::Stat.new(@__f_path))\n" ++
  "  def atime = (__closed!; File.atime(@__f_path))\n" ++
  "  def mtime = (__closed!; File.mtime(@__f_path))\n" ++
  "  def ctime = (__closed!; File.ctime(@__f_path))\n" ++
  "  def birthtime = (__closed!; File.birthtime(@__f_path))\n" ++
  "  def size = (__closed!; File.size(@__f_path))\n" ++
  "\n" ++
  "  # ⚠ A File printed its IVARS -- \"#<File:0x6f @__f_path=... @__f_mode=...>\"\n" ++
  "  #   -- because it had no #inspect of its own and the generic fallback took\n" ++
  "  #   over. ruby names the path, and says so when the stream is closed. This\n" ++
  "  #   is what every error message and every `p f` shows.\n" ++
  "  def inspect\n" ++
  "    \"#<File:\" + @__f_path.to_s + (closed? ? \" (closed)\" : \"\") + \">\"\n" ++
  "  end\n" ++
  "\n" ++
  "  # A File is not attached to a process. ruby answers nil for any IO that is\n" ++
  "  # not a pipe or a subprocess, which is every one of them here.\n" ++
  "  def pid\n" ++
  "    __closed!\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "end\n";

// IO::Buffer. A fixed-size byte region, with a String behind it rather than
// real memory -- see the class's own comment for which questions that model
// can answer and which it only appears to.
let core_prelude_i =
  "class IO\n" ++
  "  # IO::Buffer: a fixed-size byte region with a string behind it.\n" ++
  "  #\n" ++
  "  # ruby's is a view over real memory -- mapped files, another buffer's slice,\n" ++
  "  # a locked region -- and this one is a String. What that model CAN answer is\n" ++
  "  # the size, the bytes, the slicing and the freeing, which is what the suite\n" ++
  "  # spends most of its examples on. What it cannot is anything about where the\n" ++
  "  # memory came from: `mapped?` is false here because nothing is mapped, not\n" ++
  "  # because the question was skipped.\n" ++
  "  class Buffer\n" ++
  "    include Comparable\n" ++
  "\n" ++
  "    PAGE_SIZE = 4096\n" ++
  "    DEFAULT_SIZE = 65536\n" ++
  "    EXTERNAL = 1\n" ++
  "    INTERNAL = 2\n" ++
  "    MAPPED = 4\n" ++
  "    SHARED = 8\n" ++
  "    LOCKED = 32\n" ++
  "    PRIVATE = 64\n" ++
  "    READONLY = 128\n" ++
  "    HOST_ENDIAN = 4\n" ++
  "    BIG_ENDIAN = 8\n" ++
  "    LITTLE_ENDIAN = 4\n" ++
  "\n" ++
  "    class AccessError < RuntimeError; end\n" ++
  "    class AllocationError < RuntimeError; end\n" ++
  "    class LockedError < RuntimeError; end\n" ++
  "    class MaskError < ArgumentError; end\n" ++
  "    class InvalidatedError < RuntimeError; end\n" ++
  "\n" ++
  // without a block: a read-only COPY. With one: the string itself, writable
  // unless it is frozen, and freed when the block ends
  "    def self.for(string)\n" ++
  "      b = allocate\n" ++
  "      unless block_given?\n" ++
  "        b.__init_for(string.dup)\n" ++
  "        return b\n" ++
  "      end\n" ++
  "      b.__init_for(string, !string.frozen?)\n" ++
  "      begin\n" ++
  "        yield b\n" ++
  "      ensure\n" ++
  "        b.free\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # the arguments are checked the way ruby 4.0 checks them, and the flags\n" ++
  "    # are MAPPED plus EXTERNAL|SHARED (or PRIVATE) plus READONLY if asked\n" ++
  "    def self.map(file, size = nil, offset = 0, flags = 0)\n" ++
  "      raise TypeError, \"not an Integer\" unless size.nil? || size.is_a?(Integer)\n" ++
  "      raise TypeError, \"no implicit conversion from nil to integer\" if offset.nil?\n" ++
  "      unless offset.is_a?(Integer)\n" ++
  "        raise TypeError, \"no implicit conversion of #\{offset.class} into Integer\" unless offset.respond_to?(:to_int)\n" ++
  "        offset = offset.to_int\n" ++
  "      end\n" ++
  "      raise ArgumentError, \"Size can't be negative!\" if size && size < 0\n" ++
  "      raise ArgumentError, \"Size can't be zero!\" if size == 0\n" ++
  "      raise ArgumentError, \"Offset can't be negative!\" if offset < 0\n" ++
  "      whole = file.respond_to?(:path) ? File.binread(file.path) : File.binread(file.to_s)\n" ++
  "      fsize = whole.bytesize\n" ++
  "      if size.nil?\n" ++
  "        raise ArgumentError, \"Invalid negative or zero file size!\" if fsize <= 0\n" ++
  "        raise ArgumentError, \"Offset too large!\" if offset > fsize\n" ++
  "        size = fsize - offset\n" ++
  "      else\n" ++
  "        raise ArgumentError, \"Size can't be larger than file size!\" if size > fsize\n" ++
  "        raise ArgumentError, \"Offset too large!\" if offset + size > fsize\n" ++
  "      end\n" ++
  "      priv = (flags & PRIVATE) != 0\n" ++
  "      ro = (flags & READONLY) != 0\n" ++
  "      # a shared, writable mapping of a file opened for reading only is refused\n" ++
  "      if !ro && !priv && file.respond_to?(:instance_variable_get)\n" ++
  "        mode = file.instance_variable_get(:@__f_mode).to_s\n" ++
  "        raise Errno::EACCES, \"Permission denied\" if !mode.empty? && !mode.match?(/[wa+]/)\n" ++
  "      end\n" ++
  "      b = allocate\n" ++
  "      b.__init_for((whole.byteslice(offset, size) || +\"\").b.dup)\n" ++
  "      b.__mark_mapped(flags)\n" ++
  "      return b unless block_given?\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "\n" ++
  // a STRING-backed buffer over a new string of that many NULs: external and
  // writable for the block, freed after it, and the string is the answer
  "    def self.string(length)\n" ++
  "      str = (\"\\x00\" * length).b\n" ++
  "      b = allocate\n" ++
  "      b.__init_for(str, true)\n" ++
  "      begin\n" ++
  "        yield b if block_given?\n" ++
  "      ensure\n" ++
  "        b.free\n" ++
  "      end\n" ++
  "      str\n" ++
  "    end\n" ++
  "\n" ++
  "    # ⚠ THE PREDICATES ARE THE FLAG BITS, not a derived state. Measured\n" ++
  "    # against ruby 4.0.6 by walking flags 0..8: `new(4, 3)` answers TRUE to\n" ++
  "    # both `internal?` and `external?`, because 3 is INTERNAL|EXTERNAL and each\n" ++
  "    # reader reports its own bit. A model that picked one \"kind\" per buffer\n" ++
  "    # reads as the tidier rule and cannot produce that row.\n" ++
  "    #\n" ++
  "    # And which flags ALLOCATE is its own question: `new` needs INTERNAL or\n" ++
  "    # MAPPED set -- 0, EXTERNAL alone and SHARED alone all raise\n" ++
  "    # AllocationError, because they describe memory that came from somewhere\n" ++
  "    # and `new` has nowhere to get it from.\n" ++
  "    def initialize(size = DEFAULT_SIZE, flags = INTERNAL)\n" ++
  "      raise ArgumentError, \"negative size\" if size < 0\n" ++
  "      unless (flags & (INTERNAL | MAPPED)) != 0\n" ++
  "        raise IO::Buffer::AllocationError, \"Could not allocate buffer!\"\n" ++
  "      end\n" ++
  "      @s = \"\\x00\".b * size\n" ++
  "      @freed = false\n" ++
  // (a zero-size buffer allocates nothing: it is NULL, not INTERNAL)
  "      @flags = size == 0 ? 0 : flags\n" ++
  "      @__null = size == 0\n" ++
  "    end\n" ++
  "\n" ++
  "    # `for` is a view over the caller's string: EXTERNAL, and ruby marks it\n" ++
  "    # READONLY whether or not that string is frozen.\n" ++
  "    def __init_for(string, writable = false)\n" ++
  "      @s = string\n" ++
  "      @freed = false\n" ++
  "      @flags = writable ? EXTERNAL : (EXTERNAL | READONLY)\n" ++
  "    end\n" ++
  // the bytes are rewritten IN the backing string, so a string-backed buffer
  // writes through to the string it was made for
  "    def __store(bytes)\n" ++
  "      enc = @s.encoding\n" ++
  "      @s.frozen? ? (@s = bytes) : @s.replace(bytes.force_encoding(enc))\n" ++
  "    end\n" ++
  "    private :__store\n" ++
  "\n" ++
  "    def __mark_mapped(flags = 0)\n" ++
  "      priv = (flags & PRIVATE) != 0\n" ++
  "      @flags = MAPPED | (priv ? PRIVATE : (EXTERNAL | SHARED)) | (flags & READONLY)\n" ++
  "    end\n" ++
  "\n" ++
  "    def size = @freed ? 0 : @s.bytesize\n" ++
  "    def empty? = size == 0\n" ++
  "    def null? = @freed || @__null == true\n" ++
  // valid unless it is a slice whose parent was freed
  "    def valid? = @__parent.nil? || !@__parent.null?\n" ++
  "    # ⚠ a freed buffer reads as INTERNAL and NULL whatever it was before:\n" ++
  "    # ruby prints `#<IO::Buffer 0x0+0 NULL INTERNAL>` for a transferred one.\n" ++
  "    def external? = !@freed && (@flags & EXTERNAL) != 0\n" ++
  "    def internal? = !@freed && (@flags & INTERNAL) != 0\n" ++
  "    def mapped? = !@freed && (@flags & MAPPED) != 0\n" ++
  "    def shared? = !@freed && (@flags & SHARED) != 0\n" ++
  "    def private? = !@freed && (@flags & PRIVATE) != 0\n" ++
  "    def readonly? = !@freed && (@flags & READONLY) != 0\n" ++
  "    def locked? = !@freed && (@flags & LOCKED) != 0\n" ++
  "\n" ++
  "    def free\n" ++
  "      raise IO::Buffer::LockedError, \"Buffer is locked!\" if locked?\n" ++
  "      @s = +\"\".b\n" ++
  "      @freed = true\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def __check!\n" ++
  "      raise IOError, \"buffer has been freed\" if @freed\n" ++
  "    end\n" ++
  "    private :__check!\n" ++
  "\n" ++
  "    # ⚠ A FREED BUFFER IS NOT AN ERROR TO READ. ruby answers \"\" -- it has a\n" ++
  "    # null pointer and zero length, which is a consistent empty region, not a\n" ++
  "    # broken one. Raising here is the tidier-looking rule and the wrong one.\n" ++
  // (BINARY unless an encoding is asked for, whatever the backing string's)
  "    def get_string(offset = 0, length = nil, encoding = nil)\n" ++
  "      return +\"\".b if @freed\n" ++
  "      length = @s.bytesize - offset if length.nil?\n" ++
  "      raise ArgumentError, \"offset out of range\" if offset < 0 || offset > @s.bytesize\n" ++
  "      raise ArgumentError, \"length out of range\" if length < 0 || offset + length > @s.bytesize\n" ++
  "      r = (@s.byteslice(offset, length) || +\"\").b\n" ++
  "      encoding ? r.force_encoding(encoding) : r\n" ++
  "    end\n" ++
  "\n" ++
  "    def set_string(string, offset = 0, length = nil, source_offset = 0)\n" ++
  "      raise ArgumentError, \"offset out of range\" if @freed\n" ++
  "      raise IO::Buffer::AccessError, \"Buffer is not writable!\" if readonly?\n" ++
  "      src = string.to_s.b\n" ++
  "      src = src.byteslice(source_offset, length || (src.bytesize - source_offset)) || +\"\".b\n" ++
  "      raise ArgumentError, \"offset out of range\" if offset < 0 || offset + src.bytesize > @s.bytesize\n" ++
  "      __store(@s.b.byteslice(0, offset).to_s + src + (@s.b.byteslice(offset + src.bytesize, @s.bytesize).to_s))\n" ++
  "      src.bytesize\n" ++
  "    end\n" ++
  "\n" ++
  "    def clear(value = 0, offset = 0, length = nil)\n" ++
  "      __check!\n" ++
  "      length = @s.bytesize - offset if length.nil?\n" ++
  "      __store(@s.b.byteslice(0, offset).to_s + (value.chr * length) + (@s.b.byteslice(offset + length, @s.bytesize).to_s))\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def resize(new_size)\n" ++
  "      raise IO::Buffer::LockedError, \"Cannot resize locked buffer!\" if locked?\n" ++
  "      raise IO::Buffer::AccessError, \"Cannot resize external buffer!\" if external?\n" ++
  "      raise ArgumentError, \"negative size\" if new_size < 0\n" ++
  // a null or freed buffer comes back as a regular internal one
  "      if null?\n" ++
  "        @s = +\"\".b\n" ++
  "        @freed = false\n" ++
  "        @__null = new_size == 0\n" ++
  "        @flags = new_size == 0 ? 0 : INTERNAL\n" ++
  "      end\n" ++
  "      cur = @s.bytesize\n" ++
  "      @s = new_size <= cur ? @s.byteslice(0, new_size) : @s + (\"\\x00\".b * (new_size - cur))\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def slice(offset = 0, length = nil)\n" ++
  "      return IO::Buffer.for(+\"\".b) if @freed\n" ++
  "      length = @s.bytesize - offset if length.nil?\n" ++
  "      raise ArgumentError, \"offset out of range\" if offset < 0 || offset > @s.bytesize\n" ++
  "      raise ArgumentError, \"length out of range\" if length < 0 || offset + length > @s.bytesize\n" ++
  "      sl = IO::Buffer.for(@s.byteslice(offset, length))\n" ++
  "      sl.instance_variable_set(:@__parent, self)\n" ++
  "      sl\n" ++
  "    end\n" ++
  "\n" ++
  "    # `transfer` hands the region over and leaves this one null -- the one\n" ++
  "    # operation whose whole point is that the SOURCE stops owning it.\n" ++
  // the lock: reading and writing go on, changing the buffer ITSELF does not
  "    def locked\n" ++
  "      raise IO::Buffer::LockedError, \"Buffer already locked!\" if locked?\n" ++
  "      @flags |= LOCKED\n" ++
  "      begin\n" ++
  "        yield self\n" ++
  "      ensure\n" ++
  "        @flags &= ~LOCKED\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def transfer\n" ++
  "      raise IO::Buffer::LockedError, \"Cannot transfer ownership of locked buffer!\" if locked?\n" ++
  // the SAME memory changes hands: its address, its flags and (for a
  // string-backed buffer) its string go to the new object, and this one is
  // left null
  "      b = self.class.allocate\n" ++
  "      b.instance_variable_set(:@s, @s)\n" ++
  "      b.instance_variable_set(:@freed, false)\n" ++
  "      b.instance_variable_set(:@flags, @flags)\n" ++
  "      b.instance_variable_set(:@__addr, __addr)\n" ++
  "      @s = +\"\".b\n" ++
  "      @freed = true\n" ++
  "      b\n" ++
  "    end\n" ++
  "\n" ++
  "    def __addr = (@__addr ||= object_id)\n" ++
  "    def to_s\n" ++
  "      return \"#<IO::Buffer 0x0000000000000000+0 NULL INTERNAL>\" if @freed\n" ++
  "      kind = []\n" ++
  "      kind << \"EXTERNAL\" if external?\n" ++
  "      kind << \"INTERNAL\" if internal?\n" ++
  "      kind << \"MAPPED\" if mapped?\n" ++
  "      kind << \"SHARED\" if shared?\n" ++
  "      kind << \"LOCKED\" if locked?\n" ++
  "      kind << \"PRIVATE\" if private?\n" ++
  "      kind << \"READONLY\" if readonly?\n" ++
  "      \"#<IO::Buffer 0x#\{format('%016x', __addr)}+#\{size} #\{kind.join(' ')}>\"\n" ++
  "    end\n" ++
  "\n" ++
  "    def inspect = to_s + (size == 0 ? \"\" : \"\\n\" + hexdump)\n" ++
  "\n" ++
  "    def hexdump\n" ++
  "      return \"\" if @freed || @s.bytesize == 0\n" ++
  "      out = []\n" ++
  "      i = 0\n" ++
  "      while i < @s.bytesize\n" ++
  "        row = @s.byteslice(i, 16)\n" ++
  "        hex = row.bytes.map \{ |b| format(\"%02x\", b) }.join(\" \")\n" ++
  "        asc = row.bytes.map \{ |b| (b >= 32 && b < 127) ? b.chr : \".\" }.join\n" ++
  "        out << format(\"0x%08x  %-48s %s\", i, hex, asc)\n" ++
  "        i += 16\n" ++
  "      end\n" ++
  "      out.join(\"\\n\")\n" ++
  "    end\n" ++
  "\n" ++
  "    def read(io, length = nil, offset = 0)\n" ++
  "      __check!\n" ++
  "      data = length.nil? ? io.read : io.read(length)\n" ++
  "      return 0 if data.nil?\n" ++
  "      set_string(data, offset)\n" ++
  "    end\n" ++
  "\n" ++
  "    def write(io, length = nil, offset = 0)\n" ++
  "      __check!\n" ++
  "      s = get_string(offset, length)\n" ++
  "      io.write(s)\n" ++
  "      s.bytesize\n" ++
  "    end\n" ++
  "\n" ++
  "    # the result of a bitwise operation is a NEW INTERNAL buffer, not a view --\n" ++
  "    # `.for` would make it external and the spec reads `#internal?`.\n" ++
  "    def __new_internal(bytes)\n" ++
  "      b = IO::Buffer.new(bytes.bytesize)\n" ++
  "      b.set_string(bytes, 0)\n" ++
  "      b\n" ++
  "    end\n" ++
  "    private :__new_internal\n" ++
  "\n" ++
  // the MASK repeats across the buffer (a longer one is cut short), and it
  // must be a Buffer -- ruby 4.0.6, measured
  "    def __bitwise_bytes(other, op)\n" ++
  "      __check!\n" ++
  "      unless other.is_a?(IO::Buffer)\n" ++
  "        raise TypeError, \"wrong argument type \" + (other.nil? ? \"nil\" : other.class.to_s) + \" (expected IO::Buffer)\"\n" ++
  "      end\n" ++
  "      a = @s.bytes\n" ++
  "      b = other.get_string.bytes\n" ++
  "      out = +\"\".b\n" ++
  "      i = 0\n" ++
  "      while i < a.size\n" ++
  "        m = b.empty? ? 0 : b[i % b.size]\n" ++
  "        v = op == :and ? (a[i] & m) : (op == :or ? (a[i] | m) : (a[i] ^ m))\n" ++
  "        out << v.chr\n" ++
  "        i += 1\n" ++
  "      end\n" ++
  "      out\n" ++
  "    end\n" ++
  "    private :__bitwise_bytes\n" ++
  "\n" ++
  "    def &(other) = __new_internal(__bitwise_bytes(other, :and))\n" ++
  "    def |(other) = __new_internal(__bitwise_bytes(other, :or))\n" ++
  "    def ^(other) = __new_internal(__bitwise_bytes(other, :xor))\n" ++
  "    def and!(other) = (set_string(__bitwise_bytes(other, :and)); self)\n" ++
  "    def or!(other) = (set_string(__bitwise_bytes(other, :or)); self)\n" ++
  "    def xor!(other) = (set_string(__bitwise_bytes(other, :xor)); self)\n" ++
  "\n" ++
  "    def ~\n" ++
  "      __check!\n" ++
  "      __new_internal(@s.bytes.map \{ |b| (~b & 255).chr }.join.b)\n" ++
  "    end\n" ++
  // ...and IN PLACE, answering the buffer itself
  "    def not!\n" ++
  "      __check!\n" ++
  "      set_string(get_string.bytes.map \{ |b| (~b & 255).chr }.join.b)\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    # ⚠ no `bit_count`: ruby 4.0.6 does not have one\n" ++
  "    # (`IO::Buffer.new(4).respond_to?(:bit_count)` is false), and\n" ++
  "    # core/io/buffer/bit_count_spec.rb is guarded for a version that does.\n" ++
  "    # Shipping a method the oracle lacks is a divergence, not a bonus.\n" ++
  "\n" ++
  "    def <=>(other) = other.is_a?(IO::Buffer) ? (get_string <=> other.get_string) : nil\n" ++
  "    def ==(other) = other.is_a?(IO::Buffer) && get_string == other.get_string\n" ++
  "  end\n" ++
  "end\n";

// The IO surface a File can answer without a descriptor: the byte and
// character readers, pread/pwrite, the line counter, pushback, and the
// flags. What needs a real fd is named in the section's own comment and is
// deliberately not here.
let core_prelude_j =
  "class File\n" ++
  "  # ⚠ EVERY CALL TO A BUILTIN METHOD BELOW IS WRITTEN `self.x`. A bare\n" ++
  "  # `self.read(1)` from a ruby method on File is a NoMethodError: the dispatcher's\n" ++
  "  # instance methods are not in a method table, so the receiverless path does\n" ++
  "  # not find them. `self.read(1)` and `__send__(:read, 1)` both work. Same\n" ++
  "  # shape as \"an alias of a builtin Kernel method cannot be called with no\n" ++
  "  # receiver\" in KNOWN_GAPS.\n" ++
  "  #\n" ++
  "  # The IO surface a File can answer WITHOUT a descriptor. This one is a path,\n" ++
  "  # a mode, a buffer and a position (see #fileno, which refuses for that\n" ++
  "  # reason), and that is enough for everything below: reading at an offset,\n" ++
  "  # the byte and character readers, the line counter, pushback, and the flags.\n" ++
  "  #\n" ++
  "  # What is NOT here needs a real fd and says so: fcntl, ioctl, fsync's\n" ++
  "  # durability, for_fd, sysopen, the *_nonblock pair, the wait_* family,\n" ++
  "  # autoclose? and close_on_exec?.\n" ++
  "\n" ++
  "  # ⚠ THE ARM'S CLOSED-STREAM GUARD DOES NOT COVER THESE. It sits at the\n" ++
  "  # entry of the builtin File arm, and a method defined here in ruby never\n" ++
  "  # reaches that entry -- `f.stat` and `f.lineno` answered happily on a closed\n" ++
  "  # stream while `f.read` refused. Every reader and writer below asks first.\n" ++
  "  def __closed!\n" ++
  "    raise IOError, \"closed stream\" if self.closed?\n" ++
  "  end\n" ++
  "  private :__closed!\n" ++
  "\n" ++
  "  # --- byte and character readers -----------------------------------------\n" ++
  "  def getbyte\n" ++
  "    __closed!\n" ++
  "    s = self.read(1)\n" ++
  "    s.nil? || s.empty? ? nil : s.getbyte(0)\n" ++
  "  end\n" ++
  "\n" ++
  "  def readbyte\n" ++
  "    b = getbyte\n" ++
  "    raise EOFError, \"end of file reached\" if b.nil?\n" ++
  "    b\n" ++
  "  end\n" ++
  "\n" ++
  "  def getc\n" ++
  "    __closed!\n" ++
  "    return nil if self.eof?\n" ++
  "    # a character is not a byte: take one byte, and keep taking while what we\n" ++
  "    # have is not yet a valid character.\n" ++
  "    s = +\"\".b\n" ++
  "    while (b = self.read(1))\n" ++
  "      s << b\n" ++
  "      t = s.dup.force_encoding(Encoding::UTF_8)\n" ++
  "      return t if t.valid_encoding?\n" ++
  "      return s if s.bytesize >= 4\n" ++
  "    end\n" ++
  "    s.empty? ? nil : s\n" ++
  "  end\n" ++
  "\n" ++
  "  def readchar\n" ++
  "    c = getc\n" ++
  "    raise EOFError, \"end of file reached\" if c.nil?\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_byte\n" ++
  "    __closed!\n" ++
  "    return to_enum(:each_byte) unless block_given?\n" ++
  "    while (b = getbyte)\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_char\n" ++
  "    __closed!\n" ++
  "    return to_enum(:each_char) unless block_given?\n" ++
  "    while (c = getc)\n" ++
  "      yield c\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_codepoint\n" ++
  "    __closed!\n" ++
  "    return to_enum(:each_codepoint) unless block_given?\n" ++
  "    each_char \{ |c| yield c.ord }\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- pushback ------------------------------------------------------------\n" ++
  "  # ⚠ ungetc does NOT write to the file: it moves the read position back,\n" ++
  "  # which is the only part of its behaviour this model can represent. Pushing\n" ++
  "  # back a character other than the one just read is therefore not visible --\n" ++
  "  # said here rather than left to be discovered.\n" ++
  "  def ungetbyte(b)\n" ++
  "    __closed!\n" ++
  "    return nil if b.nil?\n" ++
  "    n = b.is_a?(Integer) ? 1 : b.to_s.bytesize\n" ++
  "    self.pos = self.pos - n < 0 ? 0 : self.pos - n\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def ungetc(c)\n" ++
  "    ungetbyte(c)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- reading at an offset, without moving the position -------------------\n" ++
  "  # Integers through #to_int and a buffer through #to_str; a zero length\n" ++
  "  # reads nothing and leaves the buffer as it was, wherever the offset is;\n" ++
  "  # the buffer keeps its own encoding.\n" ++
  "  def pread(length, offset, buffer = nil)\n" ++
  "    length = __pread_int(length)\n" ++
  "    offset = __pread_int(offset)\n" ++
  "    unless buffer.nil? || buffer.is_a?(String)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + buffer.class.to_s + \" into String\" unless buffer.respond_to?(:to_str)\n" ++
  "      buffer = buffer.to_str\n" ++
  "    end\n" ++
  "    __closed!\n" ++
  "    self.read(0)\n" ++
  "    raise ArgumentError, \"negative string size (or size too big)\" if length < 0\n" ++
  "    raise Errno::EINVAL, \"pread(2)\" if offset < 0\n" ++
  "    return buffer || +\"\" if length == 0\n" ++
  "    data = File.binread(@__f_path, length, offset)\n" ++
  "    raise EOFError, \"end of file reached\" if data.nil? || data.empty?\n" ++
  "    return data if buffer.nil?\n" ++
  "    enc = buffer.encoding\n" ++
  "    buffer.replace(data)\n" ++
  "    buffer.force_encoding(enc)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __pread_int(n)\n" ++
  "    return n if n.is_a?(Integer)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + n.class.to_s + \" into Integer\" unless n.respond_to?(:to_int)\n" ++
  "    n.to_int\n" ++
  "  end\n" ++
  "  private :__pread_int\n" ++
  "\n" ++
  "  def pwrite(string, offset)\n" ++
  "    __closed!\n" ++
  "    # a read-only file refuses, and the offset converts by #to_int\n" ++
  "    raise IOError, \"not opened for writing\" unless instance_variable_get(:@__f_mode).to_s.match?(/[wa+]/)\n" ++
  "    unless offset.is_a?(Integer)\n" ++
  "      raise TypeError, \"no implicit conversion of #\{offset.class} into Integer\" unless offset.respond_to?(:to_int)\n" ++
  "      offset = offset.to_int\n" ++
  "    end\n" ++
  "    s = string.to_s\n" ++
  "    whole = File.exist?(@__f_path) ? File.binread(@__f_path) : +\"\".b\n" ++
  "    whole = whole + (\"\\x00\".b * (offset - whole.bytesize)) if offset > whole.bytesize\n" ++
  "    File.binwrite(@__f_path, whole.byteslice(0, offset).to_s + s +\n" ++
  "                  whole.byteslice(offset + s.bytesize, whole.bytesize).to_s)\n" ++
  "    s.bytesize\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the unbuffered pair, which here is the buffered one ----------------\n" ++
  "  # ⚠ `sysread` and `syswrite` are \"do not buffer\" in ruby. This File writes\n" ++
  "  # through a buffer flushed at close, so the DIFFERENCE they name does not\n" ++
  "  # exist here -- they are the plain read and write, and a program that used\n" ++
  "  # them to defeat buffering gets no guarantee it did.\n" ++
  "  def sysread(length, buffer = nil)\n" ++
  "    data = self.read(length)\n" ++
  "    raise EOFError, \"end of file reached\" if data.nil?\n" ++
  "    buffer.nil? ? data : buffer.replace(data)\n" ++
  "  end\n" ++
  "\n" ++
  "  def syswrite(string)\n" ++
  "    __closed!\n" ++
  "    n = self.write(string)\n" ++
  "    flush\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  def readpartial(length, buffer = nil)\n" ++
  "    raise IOError, \"closed stream\" if self.closed?\n" ++
  "    data = self.read(length)\n" ++
  "    raise EOFError, \"end of file reached\" if data.nil?\n" ++
  "    buffer.nil? ? data : buffer.replace(data)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the line counter ----------------------------------------------------\n" ++
  "  def lineno\n" ++
  "    __closed!\n" ++
  "    @__f_lineno ||= 0\n" ++
  "  end\n" ++
  "\n" ++
  "  def lineno=(n)\n" ++
  "    __closed!\n" ++
  "    @__f_lineno = n.to_int\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the flags -----------------------------------------------------------\n" ++
  "  def binmode\n" ++
  "    __closed!\n" ++
  "    @__f_binmode = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def binmode?\n" ++
  "    __closed!\n" ++
  "    @__f_binmode ? true : false\n" ++
  "  end\n" ++
  "\n" ++
  "  def close_read\n" ++
  "    raise IOError, \"closing non-duplex IO for reading\" unless __opened_readable?\n" ++
  "    @__f_closed_read = true\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def close_write\n" ++
  "    raise IOError, \"closing non-duplex IO for writing\" unless __opened_writable?\n" ++
  "    flush\n" ++
  "    @__f_closed_write = true\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __opened_readable? = !@__f_mode.to_s.start_with?(\"w\") && !@__f_mode.to_s.start_with?(\"a\")\n" ++
  "  def __opened_writable? = @__f_mode.to_s != \"r\"\n" ++
  "  private :__opened_readable?, :__opened_writable?\n" ++
  "\n" ++
  "  def to_io = self\n" ++
  "  def eof = self.eof?\n" ++
  "\n" ++
  "  def external_encoding = Encoding.default_external\n" ++
  "  def internal_encoding = nil\n" ++
  "  def set_encoding(*_a) = self\n" ++
  "  def set_encoding_by_bom = nil\n" ++
  "\n" ++
  "  def printf(fmt, *args)\n" ++
  "    __closed!\n" ++
  "    self.write(format(fmt, *args))\n" ++
  "  end\n" ++
  "  def putc(c)\n" ++
  "    __closed!\n" ++
  "    __closed!\n" ++
  "    self.write(c.is_a?(Integer) ? (c & 255).chr : c.to_s[0])\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  # `fsync` and `fdatasync` are the buffer flush: there is no descriptor to ask\n" ++
  "  # the kernel about, so what they can honestly promise is that this object has\n" ++
  "  # nothing left unwritten.\n" ++
  "  def fsync\n" ++
  "    __closed!\n" ++
  "    flush\n" ++
  "    0\n" ++
  "  end\n" ++
  "  def fdatasync = fsync\n" ++
  "end\n";

let core_prelude = core_prelude_a ++ core_prelude_b ++ core_prelude_c ++ core_prelude_d ++ core_prelude_e ++ core_prelude_f ++ core_prelude_g ++ core_prelude_h ++ core_prelude_i ++ core_prelude_j;


// define each CONST=encoding-name pair of the table above, `|`-separated.
let rec enc_define_all = fn mk -> fn (t: str) -> fn (i: int) ->
  if i >= str_len t then ()
  else
    let e = (let j = str_find_from t "|" i in if j < 0 then str_len t else j) in
    let item = substring t i e in
    let eq = str_find_from item "=" 0 in
    let _ = (if eq < 0 then () else
               (let cname = substring item 0 eq in
                let ename = substring item (eq + 1) (str_len item) in
                let _ = map_set consts ("Encoding::" ++ cname) (mk ename) in
                // the constant's spelling doubles as the alias name ruby's
                // Encoding.find accepts (underscores are the '-'s).
                map_set enc_alias_canon (enc_norm_name cname) ename)) in
    enc_define_all mk t (e + 1);

// MERE_RUBY_STORE_STATS=1 prints, at exit, how many entries each store holds.
// Nothing here is ever reclaimed -- Mere has no way to give a container's memory
// back (map_delete does not, overwriting a key does not, and a region block does
// not: measured) -- so these counts ARE the growth, and they say which store a
// collector would have to trace first rather than leaving it to be guessed.
let store_stats = fn world ->
  let (meths, sup, ocls, ivars) = world in
  let row = fn (nm: str) -> fn (n: int) ->
    print_err (nm ++ "\t" ++ str_of_int n ++ "\n") in
  let _ = print_err "store\tentries\n" in
  let _ = row "arr_store" (map_len arr_store) in
  let _ = row "hash_fast" (if map_has arr_ctr 2 then map_get arr_ctr 2 else 0) in
  let _ = row "hash_slow" (if map_has arr_ctr 3 then map_get arr_ctr 3 else 0) in
  let _ = row "arr_pending_flushes" (if map_has arr_ctr 1 then map_get arr_ctr 1 else 0) in
  let _ = row "ivars" (map_len ivars) in
  let _ = row "ocls" (map_len ocls) in
  let _ = row "meths" (map_len meths) in
  let _ = row "sup" (map_len sup) in
  let _ = row "globals" (map_len globals) in
  let _ = row "consts" (map_len consts) in
  let _ = row "sym_ids" (map_len sym_ids) in
  let _ = row "str_enc" (map_len str_enc) in
  let _ = row "str_frozen" (map_len str_frozen) in
  let _ = row "hash_dflt" (map_len hash_dflt) in
  let _ = row "proc_store" (map_len proc_store) in
  let _ = row "proc_home" (map_len proc_home) in
  let _ = row "bind_store" (map_len bind_store) in
  let _ = row "lv_up" (map_len lv_up) in
  let _ = row "live_frames" (map_len live_frames) in
  let _ = row "pool_hits" (if map_has frame_pool_n 1 then map_get frame_pool_n 1 else 0) in
  let _ = row "pool_news" (if map_has frame_pool_n 2 then map_get frame_pool_n 2 else 0) in
  let _ = row "pool_puts" (if map_has frame_pool_n 3 then map_get frame_pool_n 3 else 0) in
  // block envs through the same pool (blk_env_get/put): puts that were block
  // envs, and envs a closure captured that therefore stayed out of the pool.
  let _ = row "blk_puts" (if map_has frame_pool_n 7 then map_get frame_pool_n 7 else 0) in
  let _ = row "blk_kept" (if map_has frame_pool_n 6 then map_get frame_pool_n 6 else 0) in
  let _ = row "pool_drops" (if map_has frame_pool_n 4 then map_get frame_pool_n 4 else 0) in
  let _ = row "pool_bytes_wound_back" (if map_has frame_pool_n 5 then map_get frame_pool_n 5 else 0) in
  // arena BYTES per store (v0.1.299 map_bytes/vec_bytes): where the resident
  // memory actually lives, which entry counts cannot say (a store of a few
  // entries can hold a giant arena and vice versa). Backend-dependent values,
  // for diagnosis only -- never for output.
  let _ = row "bytes_str_store" (vec_bytes str_store) in
  let _ = row "bytes_arr_store" (map_bytes arr_store) in
  let _ = row "bytes_hash_store" (vec_bytes hash_store) in
  let _ = row "bytes_ivars" (map_bytes ivars) in
  let _ = row "bytes_ocls" (map_bytes ocls) in
  let _ = row "bytes_meths" (map_bytes meths) in
  let _ = row "bytes_consts" (map_bytes consts) in
  let _ = row "bytes_globals" (map_bytes globals) in
  let _ = row "bytes_str_enc" (map_bytes str_enc) in
  let _ = row "bytes_str_frozen" (map_bytes str_frozen) in
  let _ = row "bytes_sym_ids" (map_bytes sym_ids) in
  let _ = row "bytes_proc_store" (map_bytes proc_store) in
  let _ = row "bytes_proc_yblk" (map_bytes proc_yblk) in
  let _ = row "bytes_bind_store" (map_bytes bind_store) in
  let _ = row "bytes_lv_up" (map_bytes lv_up) in
  let _ = row "bytes_mro_anc" (map_bytes mro_anc) in
  let _ = row "bytes_dm_methods" (map_bytes dm_methods) in
  let _ = row "call_names" (map_len call_names_s) in
  let _ = row "call_lines" (map_len call_lines) in
  let _ = row "rx_progs" (map_len rx_progs) in
  let _ = row "rx_caps" (map_len rx_caps) in
  let _ = row "md_whole" (map_len md_whole) in
  let _ = row "time_inst" (map_len time_inst) in
  let _ = row "mro_anc" (map_len mro_anc) in
  let _ = row "lex_cref" (map_len lex_cref) in
  let _ = row "meth_cref" (map_len meth_cref) in
  let _ = row "dm_methods" (map_len dm_methods) in
  let _ = row "loaded_files" (map_len loaded_files) in
  // The call-bookkeeping maps' ARENAS. gc_collect compacts these, which moves
  // their write churn out of the default region and into a private arena --
  // and a private arena is invisible to MERE_REGION_STATS. Without these rows
  // the compaction would look like the memory vanished when it only left the
  // frame the other meter can see.
  let _ = row "bytes_call_names" (map_bytes call_names_s) in
  let _ = row "bytes_call_files" (map_bytes call_files_s) in
  let _ = row "bytes_call_meths" (map_bytes call_meths_s) in
  let _ = row "bytes_cur_pos" (map_bytes cur_pos_s) in
  let _ = row "bytes_call_lines" (map_bytes call_lines) in
  let _ = row "bytes_live_frames" (map_bytes live_frames) in
  let _ = row "bytes_struct_ctr" (map_bytes struct_ctr) in
  let _ = row "bytes_thread_flag" (map_bytes thread_flag) in
  let _ = row "bytes_gc_bare" (map_bytes gc_bare) in
  let _ = row "gc_blocked" (if map_has gc_state "blocked" then map_get gc_state "blocked" else 0) in
  row "insp_seen" (map_len insp_seen);

let data_ctx = map_new ();
// the libraries -r names, in the order given
let cli_reqs = map_new ();
let add_cli_req = fn (lib: str) ->
  map_set cli_reqs "v" ((if map_has cli_reqs "v" then map_get cli_reqs "v" ++ chr 10 else "") ++ lib);
// The report for an exception nobody rescued: what ruby's error_print writes,
// which is Exception#full_message with no highlighting -- the head line (the
// raise site and "message (Class)"), a "\tfrom" line per remaining frame, and
// then every cause the same way. It used to be `file:line: message (Class)`
// and nothing else: no "in '<main>'", no frames, no cause, and a custom
// backtrace (`raise E, msg, [...]`) was never printed at all. An exception
// with no frames of its own (a builtin's refusal) is headed with the place
// the raise was reported from, named the way a frame is.
let top_report = fn env -> fn world -> fn (exc: Val) -> fn (name: str) ->
  let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let w9 = err_where name in
  let head9 = (if str_contains w9 ":in '" then w9 else w9 ++ ":in '<main>'") in
  let chain0 = exc_cause_chain env world exc VNil 8 in
  let bare9 = (match invoke_val_c env world noblk9 exc "backtrace" Nil false with
               | VArr a9 -> (match deref a9 with Nil -> true | _ -> false)
               | _ -> true) in
  let chain9 = (if bare9 then
                  (match chain0 with
                   | Cons ((e9, _), t9) -> Cons ((e9, arr_new (Cons (mkstr head9, Nil))), t9)
                   | Nil -> chain0)
                else chain0) in
  let _ = map_set fm_kw "v" VNil in
  let s9 = exc_blocks env world chain9 false in
  if str_len s9 > 0 && str_eq (char_at s9 (str_len s9 - 1)) "\n" then substring s9 0 (str_len s9 - 1) else s9;

let run_src = fn (src0: str) -> fn (print_result: bool) -> fn (name: str) ->
  let (src, doff9) = src_prepare src0 in
  let _ = (if doff9 >= 0 && (if str_eq name "-e" then false else true) then map_set data_ctx "off" doff9 else ()) in
  // diagnostics that must see the rubygems PRELOAD switch on here, first:
  // collections during the preload's requires are real collections, and
  // for a day they were invisible because the GC log was armed after them.
  let _ = (if str_eq (env_get "MERE_RUBY_INTERN_LOG") "" then () else map_set intern_log "on" 1) in
  let _ = map_set gc_state "log" (if str_eq (env_get "MERE_RUBY_GC_LOG") "" then 0 else 1) in
  let _ = map_set load_ctx "dir" (mkstr (dirname_of name)) in
  let _ = map_set load_ctx "file" (mkstr name) in
  let _ = map_set loaded_files name VNil in
  let cod0 = src_coding src in
  let _ = map_set load_ctx "coding" (mkstr (if str_eq cod0 "" then "UTF-8" else cod0)) in
  let _ = map_set fsl_ctx "v" (src_fsl src) in
  let toks = number_nls src (lex_go src 0) in
  let _ = parse_line_reset (count_nls toks) in
  let (prog, rest) = parse_stmts toks Nil in
  let _ = rx_check_pending () in
  let _ =
    (match rest with
     | Cons (TEOF, _) -> ()
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unexpected token at top level" ++ parsing_file ()))) in fail ("mere-ruby: unexpected token at top level" ++ parsing_file ()))) in
  let env = map_new () in
  // The program's middle (non-BEGIN/END) statements, computed once, OUTSIDE
  // the loop: the carried cursor is an INDEX into this default-region list,
  // so no AST ever crosses arenas.
  let gc_mids = filter_mid prog in
  let gc_total = list_len gc_mids in
  // THE WORLD is four maps created here and threaded as `world` -- and since
  // mere v0.1.297 every store (these four included) reclaims by rebuilding IN
  // PLACE through its stable handle (survivors out, map_clear, survivors
  // back, map_compact). The region loop that used to carry them across
  // arenas is gone: compaction made the swap redundant, and a collection is
  // a plain function (gc_collect) callable from any depth whose in-flight
  // values are rooted.
  // ...all four are globals (see obj_cls and meths_g): a helper with no world
  // in hand can still answer about a class, and a Fiber's thread can rebuild
  // the world it was not handed.
  let meths = meths_g in
  let sup = cls_sup in
  let ocls = obj_cls in
  let ivars = ivars_g in
  // Encoding objects (VObj of class Encoding, name in @name). Shared instances
  // stored in enc_objs; the constants point at them. String#encoding returns
  // the matching one, so `x.encoding == Encoding::UTF_8` holds by identity.
  // one object per encoding NAME: ruby's aliases are the same object
  // (Encoding::BIG5.equal?(Encoding::Big5)), and String#encoding compares by
  // identity.
  let mk_enc = fn (nm: str) ->
    if map_has enc_objs nm then map_get enc_objs nm else
    let id = alloc_oid ocls in
    let _ = map_set ocls id "Encoding" in
    let _ = map_set ivars (str_of_int id ++ "@name") (mkstr nm) in
    let o = VObj id in
    let _ = map_set enc_objs nm o in
    let _ = map_set enc_alias_canon (enc_norm_name nm) nm in
    let _ = map_set enc_name (str_of_int id) nm in o in
  let _ = map_set consts "Encoding::UTF_8" (mk_enc "UTF-8") in
  // an alias no constant spells (ruby's Encoding.aliases lists it)
  let _ = map_set enc_alias_canon (enc_norm_name "Big5-HKSCS:2008") "Big5-HKSCS" in
  let _ = map_set consts "Encoding::US_ASCII" (mk_enc "US-ASCII") in
  let _ = map_set consts "Encoding::ASCII_8BIT" (mk_enc "ASCII-8BIT") in
  let _ = map_set consts "Encoding::BINARY" (if map_has enc_objs "ASCII-8BIT" then map_get enc_objs "ASCII-8BIT" else mkstr "ASCII-8BIT") in
  let _ = map_set consts "Encoding::ISO_8859_1" (mk_enc "ISO-8859-1") in
  let _ = map_set consts "Encoding::ASCII" (if map_has enc_objs "US-ASCII" then map_get enc_objs "US-ASCII" else mkstr "US-ASCII") in
  let _ = map_set consts "Encoding::UTF_16LE" (mk_enc "UTF-16LE") in
  let _ = map_set consts "Encoding::UTF_16BE" (mk_enc "UTF-16BE") in
  let _ = map_set consts "Encoding::UTF_32LE" (mk_enc "UTF-32LE") in
  let _ = map_set consts "Encoding::UTF_32BE" (mk_enc "UTF-32BE") in
  // dummy encodings (see enc_is_dummy).
  let _ = map_set consts "Encoding::UTF_16" (mk_enc "UTF-16") in
  let _ = map_set consts "Encoding::UTF_32" (mk_enc "UTF-32") in
  let _ = map_set consts "Encoding::ISO_2022_JP" (mk_enc "ISO-2022-JP") in
  let _ = map_set consts "Encoding::ISO_2022_JP_2" (mk_enc "ISO-2022-JP-2") in
  let _ = map_set consts "Encoding::ISO_2022_JP_KDDI" (mk_enc "ISO-2022-JP-KDDI") in
  let _ = map_set consts "Encoding::IBM037" (mk_enc "IBM037") in
  let _ = map_set consts "Encoding::IBM437" (mk_enc "IBM437") in
  let _ = map_set consts "Encoding::CP50220" (mk_enc "CP50220") in
  let _ = map_set consts "Encoding::CP50221" (mk_enc "CP50221") in
  let _ = map_set consts "Encoding::UTF_7" (mk_enc "UTF-7") in
  let _ = map_set consts "Encoding::SHIFT_JIS" (mk_enc "Shift_JIS") in
  let _ = map_set consts "Encoding::Shift_JIS" (if map_has enc_objs "Shift_JIS" then map_get enc_objs "Shift_JIS" else mkstr "Shift_JIS") in
  let _ = map_set consts "Encoding::EUC_JP" (mk_enc "EUC-JP") in
  // ...and every other Encoding constant ruby defines, as CONST=name pairs.
  // mere-ruby transcodes only a handful of these; a constant EXISTING is not a
  // claim that it does. activesupport indexes a table by these objects, so a
  // missing one stopped railties at Encoding::GB18030.
  let enc_table =
    "UTF_8_HFS=UTF8-MAC|UTF_8_MAC=UTF8-MAC|UCS_2BE=UTF-16BE|UCS_4BE=UTF-32BE|CP932=Windows-31" ++
    "J|CsWindows31J=Windows-31J|UCS_4LE=UTF-32LE|SJIS=Windows-31J|PCK=Windows-31J|CSWINDOWS31" ++
    "J=Windows-31J|CP1251=Windows-1251|CP1252=Windows-1252|CP1250=Windows-1250|CP1254=Windows" ++
    "-1254|CP1257=Windows-1257|CP1253=Windows-1253|UTF8_DOCOMO=UTF8-DoCoMo|SJIS_DoCoMo=SJIS-D" ++
    "oCoMo|UTF8_DoCoMo=UTF8-DoCoMo|UTF8_KDDI=UTF8-KDDI|SJIS_KDDI=SJIS-KDDI|SJIS_DOCOMO=SJIS-D" ++
    "oCoMo|Stateless_ISO_2022_JP_KDDI=stateless-ISO-2022-JP-KDDI|STATELESS_ISO_2022_JP_KDDI=s" ++
    "tateless-ISO-2022-JP-KDDI|UTF8_SOFTBANK=UTF8-SoftBank|SJIS_SoftBank=SJIS-SoftBank|UTF8_S" ++
    "oftBank=UTF8-SoftBank|SJIS_SOFTBANK=SJIS-SoftBank|Big5=Big5|BIG5=Big5|Big5_HKSCS=Big5-HK" ++
    "SCS|BIG5_HKSCS=Big5-HKSCS|Big5_UAO=Big5-UAO|BIG5_UAO=Big5-UAO|CESU_8=CESU-8|CP949=CP949|" ++
    "Emacs_Mule=Emacs-Mule|EMACS_MULE=Emacs-Mule|EUC_KR=EUC-KR|EUC_TW=EUC-TW|GB18030=GB18030|" ++
    "GBK=GBK|ISO_8859_2=ISO-8859-2|ISO_8859_3=ISO-8859-3|ISO_8859_4=ISO-8859-4|ISO_8859_5=ISO" ++
    "-8859-5|ISO_8859_6=ISO-8859-6|ISO_8859_7=ISO-8859-7|ISO_8859_8=ISO-8859-8|ISO_8859_9=ISO" ++
    "-8859-9|ISO_8859_10=ISO-8859-10|ISO_8859_11=ISO-8859-11|ISO_8859_13=ISO-8859-13|ISO_8859" ++
    "_14=ISO-8859-14|ISO_8859_15=ISO-8859-15|ISO_8859_16=ISO-8859-16|KOI8_R=KOI8-R|KOI8_U=KOI" ++
    "8-U|Windows_31J=Windows-31J|WINDOWS_31J=Windows-31J|Windows_1250=Windows-1250|WINDOWS_12" ++
    "50=Windows-1250|Windows_1251=Windows-1251|WINDOWS_1251=Windows-1251|Windows_1252=Windows" ++
    "-1252|WINDOWS_1252=Windows-1252|Windows_1253=Windows-1253|WINDOWS_1253=Windows-1253|Wind" ++
    "ows_1254=Windows-1254|WINDOWS_1254=Windows-1254|Windows_1257=Windows-1257|WINDOWS_1257=W" ++
    "indows-1257|CP437=IBM437|IBM720=IBM720|CP720=IBM720|IBM737=IBM737|CP737=IBM737|IBM775=IB" ++
    "M775|CP775=IBM775|CP850=CP850|IBM850=CP850|IBM852=IBM852|CP852=CP852|IBM855=IBM855|CP855" ++
    "=CP855|IBM857=IBM857|CP857=IBM857|IBM860=IBM860|CP860=IBM860|IBM861=IBM861|CP861=IBM861|" ++
    "IBM862=IBM862|CP862=IBM862|IBM863=IBM863|CP863=IBM863|IBM864=IBM864|CP864=IBM864|IBM865=" ++
    "IBM865|CP865=IBM865|IBM866=IBM866|CP866=IBM866|IBM869=IBM869|CP869=IBM869|Windows_1258=W" ++
    "indows-1258|WINDOWS_1258=Windows-1258|CP1258=Windows-1258|GB1988=GB1988|MacCentEuro=macC" ++
    "entEuro|MACCENTEURO=macCentEuro|MacCroatian=macCroatian|MACCROATIAN=macCroatian|MacCyril" ++
    "lic=macCyrillic|MACCYRILLIC=macCyrillic|MacGreek=macGreek|MACGREEK=macGreek|MacIceland=m" ++
    "acIceland|MACICELAND=macIceland|MacRoman=macRoman|MACROMAN=macRoman|MacRomania=macRomani" ++
    "a|MACROMANIA=macRomania|MacThai=macThai|MACTHAI=macThai|MacTurkish=macTurkish|MACTURKISH" ++
    "=macTurkish|MacUkraine=macUkraine|MACUKRAINE=macUkraine|CP950=CP950|Big5_HKSCS_2008=Big5" ++
    "-HKSCS|BIG5_HKSCS_2008=Big5-HKSCS|CP951=CP951|EBCDIC_CP_US=IBM037|Stateless_ISO_2022_JP=" ++
    "stateless-ISO-2022-JP|STATELESS_ISO_2022_JP=stateless-ISO-2022-JP|EucJP=EUC-JP|EUCJP=EUC" ++
    "-JP|EucJP_ms=eucJP-ms|EUCJP_MS=eucJP-ms|EUC_JP_MS=eucJP-ms|CP51932=CP51932|EUC_JIS_2004=" ++
    "EUC-JIS-2004|EUC_JISX0213=EUC-JIS-2004|EucKR=EUC-KR|EUCKR=EUC-KR|EucTW=EUC-TW|EUCTW=EUC-" ++
    "TW|GB2312=GB2312|EUC_CN=GB2312|EucCN=GB2312|EUCCN=GB2312|GB12345=GB12345|CP936=GBK|ISO20" ++
    "22_JP=ISO-2022-JP|ISO2022_JP2=ISO-2022-JP-2|ISO8859_1=ISO-8859-1|ISO8859_2=ISO-8859-2|IS" ++
    "O8859_3=ISO-8859-3|ISO8859_5=ISO-8859-5|ISO8859_6=ISO-8859-6|ISO8859_4=ISO-8859-4|WINDOW" ++
    "S_1256=Windows-1256|CP1256=Windows-1256|Windows_1256=Windows-1256|ISO8859_8=ISO-8859-8|W" ++
    "indows_1255=Windows-1255|ISO8859_7=ISO-8859-7|CP1255=Windows-1255|ISO8859_9=ISO-8859-9|W" ++
    "INDOWS_1255=Windows-1255|ISO8859_11=ISO-8859-11|TIS_620=TIS-620|ISO8859_10=ISO-8859-10|W" ++
    "INDOWS_874=Windows-874|CP874=Windows-874|Windows_874=Windows-874|ISO8859_14=ISO-8859-14|" ++
    "ISO8859_15=ISO-8859-15|ISO8859_13=ISO-8859-13|CP878=KOI8-R|MacJapanese=MacJapanese|ISO88" ++
    "59_16=ISO-8859-16|MacJapan=MacJapanese|MACJAPAN=MacJapanese|MACJAPANESE=MacJapanese|ANSI" ++
    "_X3_4_1968=US-ASCII|CP65001=UTF-8|UTF8_MAC=UTF8-MAC|CP65000=UTF-7" in
  let _ = enc_define_all mk_enc enc_table 0 in
  // the exception classes and the converter live in the same namespace
  let _ = map_set consts "Encoding::CompatibilityError" (VClass "Encoding::CompatibilityError") in
  let _ = map_set consts "Encoding::UndefinedConversionError" (VClass "Encoding::UndefinedConversionError") in
  let _ = map_set consts "Encoding::InvalidByteSequenceError" (VClass "Encoding::InvalidByteSequenceError") in
  let _ = map_set consts "Encoding::ConverterNotFoundError" (VClass "Encoding::ConverterNotFoundError") in
  let _ = map_set consts "Encoding::Converter" (VClass "Encoding::Converter") in
  let _ = map_set consts "Enumerator::Chain" (VClass "Enumerator::Chain") in
  let _ = map_set consts "Enumerator::Yielder" (VClass "Enumerator::Yielder") in
  let _ = map_set consts "Enumerator::ArithmeticSequence" (VClass "Enumerator::ArithmeticSequence") in
  let _ = map_set consts "Enumerator::Lazy" (VClass "Enumerator::Lazy") in
  let _ = map_set consts "Regexp::IGNORECASE" (VInt 1) in
  let _ = map_set consts "Regexp::EXTENDED" (VInt 2) in
  let _ = map_set consts "Regexp::MULTILINE" (VInt 4) in
  let _ = map_set consts "Math::PI" (VFlt 3.141592653589793) in
  let _ = map_set consts "Math::E" (VFlt 2.718281828459045) in
  // TOPLEVEL_BINDING: a binding whose lexical scope is the top level, so
  // eval("Const", TOPLEVEL_BINDING) resolves constants at the top level.
  // ⚠ ...and it IS the main script's binding: the main program's own env,
  //   so it sees the script's locals as they are assigned (a separate env
  //   answered [] and nil for everything). Its local_variables are the names
  //   the script DECLARES -- all of them, known when it was parsed, as ruby's
  //   are -- plus any set through the binding itself (tl_decl / tl_dyn).
  let _ = (let _ = map_set env "__cref" (mkstr "") in
           let _ = map_set env "self" VMain in
           let bid = (handle_base + map_len bind_store) in
           let _ = map_set bind_store (str_of_int bid) env in
           let _ = map_set tl_bid "v" bid in
           map_set consts "TOPLEVEL_BINDING" (VBind bid)) in
  // Exception#initialize(msg = nil) sets @message, so a user exception's
  // `super(msg)` records the message (read back by make_exc_w).
  // `require` and `require_relative` are ordinary Kernel methods whose bodies
  // call the loader, so a library can replace them (RubyGems does) and alias
  // the original away first. SRequire dispatches to whatever they resolve to.
  // Module#const_missing as a real method, so a library hook that handles
  // some names and calls `super` for the rest has somewhere to land.
  let _ = set_meth meths "Module#const_missing"
    (Meth (Cons ("name", Nil), Nil,
           Cons (SExpr (ECall ("__const_missing_raise", Cons (ESelf, Cons (EVar "name", Nil)))), Nil))) in
  let _ = set_meth meths "Kernel#require"
    (Meth (Cons ("path", Nil), Nil, Cons (SExpr (ECall ("__builtin_require", Cons (EVar "path", Nil))), Nil))) in
  let _ = set_meth meths "Kernel#require_relative"
    (Meth (Cons ("path", Nil), Nil, Cons (SExpr (ECall ("__builtin_require_relative", Cons (EVar "path", Nil))), Nil))) in
  let _ = set_meth meths "Exception#initialize" (Meth (Cons ("msg", Nil), Cons (("msg", ENil), Nil), Cons (SIVarAssign ("message", EVar "msg"), Nil))) in
  // An Errno class's message is the SYSTEM's text, and `.new` has to say the
  // same thing `raise` does: `Errno::EINVAL.new.message` is "Invalid argument",
  // not the class name, and with an argument it reads "<text> - <arg>". raise
  // went through errno_message and `.new` did not, so the two disagreed about
  // the same exception -- one primitive, called from the constructor, is what
  // keeps them from drifting again.
  // ...and it takes an ERRNO as its second argument, which is what decides the
  // class: `SystemCallError.new("m", 2)` is an Errno::ENOENT. The number is
  // kept so #errno answers it even for the base class.
  // ...and it REQUIRES an argument: `SystemCallError.new` is an ArgumentError
  // in ruby (there is no errno to name), and answered an empty exception here.
  // ...and a THIRD argument is the LOCATION: `SystemCallError.new("m", 2,
  // "loc")` is "No such file or directory @ loc - m". The message builder knew
  // about a location all along (an Errno class's two-argument form passes one
  // there), but the constructor took two parameters, so the three-argument
  // form was a wrong-arity call.
  let _ = set_meth meths "SystemCallError#initialize"
    (Meth (Cons ("msg", Cons ("extra", Cons ("loc", Nil))),
           Cons (("msg", ECall ("__sce_no_arg", Cons (ESelf, Nil))), Cons (("extra", ENil), Cons (("loc", ENil), Nil))),
           Cons (SIVarAssign ("__errno", EVar "extra"),
             Cons (SIVarAssign ("message", ECall ("__errno_message", Cons (ESelf, Cons (EVar "msg", Cons (EVar "extra", Cons (EVar "loc", Nil)))))), Nil)))) in
  // #errno: the number it was given, or the platform's number for its class.
  let _ = set_meth meths "SystemCallError#errno"
    (Meth (Nil, Nil, Cons (SExpr (ECall ("__errno_number", Cons (ESelf, Cons (EIVar "__errno", Nil)))), Nil))) in
  // NameError#initialize(msg = nil, name = nil): also records the offending
  // name (NoMethodError inherits this). #name reads it back.
  let _ = set_meth meths "NameError#initialize" (Meth (Cons ("msg", Cons ("name", Nil)), Cons (("msg", ENil), Cons (("name", ENil), Nil)), Cons (SIVarAssign ("message", EVar "msg"), Cons (SIVarAssign ("__name", EVar "name"), Nil)))) in
  let _ = set_meth meths "NameError#name" (Meth (Nil, Nil, Cons (SExpr (EIVar "__name"), Nil))) in
  let _ = set_meth meths "StopIteration#result" (Meth (Nil, Nil, Cons (SExpr (EIVar "result"), Nil))) in
  // The exception classes whose constructor takes MORE than a message. Ruby
  // gives each of them a reader for what it recorded, and ruby/spec asks for
  // exactly that pairing -- a constructor that accepts the argument and a
  // reader that gives it back. All of them are synthesized the same way as
  // Exception#initialize above: params, defaults, body. A keyword parameter is
  // a param name ending in ":", which is how the binder recognizes one.
  //
  // NameError also takes `receiver:`, and NoMethodError adds the arguments of
  // the failed call. `super` in a user subclass reaches these, so the ivars are
  // named __-prefixed to stay out of the way of a subclass's own.
  let _ = set_meth meths "NameError#initialize"
    (Meth (Cons ("msg", Cons ("name", Cons ("receiver:", Nil))),
           // the default is a SENTINEL, not nil: `nil.foo` really has nil as
           // its receiver, and #receiver must tell that from never being told.
           Cons (("msg", ENil), Cons (("name", ENil), Cons (("receiver:", ESym "__no_receiver__"), Nil))),
           Cons (SIVarAssign ("message", EVar "msg"),
             Cons (SIVarAssign ("__name", EVar "name"),
               Cons (SIVarAssign ("__recv", EVar "receiver"), Nil))))) in
  // #receiver RAISES when nothing set one: ruby's "no receiver is available",
  // which is what a spec asks for. nil is a real receiver (`nil.foo`), so the
  // question is whether the ivar exists, not whether it is nil.
  let _ = set_meth meths "NameError#receiver"
    (Meth (Nil, Nil, Cons (SIf (Cons ((EBin ("==", EIVar "__recv", ESym "__no_receiver__"),
                                       Cons (SExpr (ERaise (Cons (EConst "ArgumentError", Cons (EStrL "no receiver is available", Nil)))), Nil)), Nil), Nil),
                       Cons (SExpr (EIVar "__recv"), Nil)))) in
  let _ = set_meth meths "NoMethodError#initialize"
    (Meth (Cons ("msg", Cons ("name", Cons ("args", Cons ("priv", Cons ("receiver:", Nil))))),
           Cons (("msg", ENil), Cons (("name", ENil), Cons (("args", ENil), Cons (("priv", EBool false), Cons (("receiver:", ESym "__no_receiver__"), Nil))))),
           Cons (SIVarAssign ("message", EVar "msg"),
             Cons (SIVarAssign ("__name", EVar "name"),
               Cons (SIVarAssign ("__args", EVar "args"),
                 Cons (SIVarAssign ("__priv", EVar "priv"),
                   Cons (SIVarAssign ("__recv", EVar "receiver"), Nil))))))) in
  let _ = set_meth meths "NoMethodError#args" (Meth (Nil, Nil, Cons (SExpr (EIVar "__args"), Nil))) in
  let _ = set_meth meths "NoMethodError#private_call?" (Meth (Nil, Nil, Cons (SExpr (EIVar "__priv"), Nil))) in
  // SignalException(sig): #signo answers the pair the primitive resolves, and
  // the message is the signal's name (ruby's) unless the caller gave one.
  let _ = set_meth meths "SignalException#initialize"
    // (a message may follow a signal NUMBER only: `new("INT", "name")` is an
    // ArgumentError in ruby, since the name already is the message)
    (Meth (Cons ("sig", Cons ("msg", Nil)), Cons (("sig", ENil), Cons (("msg", ENil), Nil)),
           Cons (SIf (Cons ((EBin ("&&", EVar "msg", EMethod (EMethod (EVar "sig", "is_a?", Cons (EConst "Integer", Nil)), "!", Nil)),
                             Cons (SExpr (ERaise (Cons (EConst "ArgumentError",
                                     Cons (EStrL "wrong number of arguments (given 2, expected 1)", Nil)))), Nil)), Nil), Nil),
           Cons (SIVarAssign ("__sigpair", ECall ("__signal_pair", Cons (EVar "sig", Nil))),
             Cons (SIVarAssign ("message",
                     EBin ("||", EVar "msg", EMethod (EIVar "__sigpair", "[]", Cons (EInt 1, Nil)))), Nil))))) in
  // Interrupt is SIGINT with a message of its own: `Interrupt.new` is signo 2
