  let _ = map_set sup "Errno::EINPROGRESS" "SystemCallError" in
  let _ = map_set sup "Errno::EALREADY" "SystemCallError" in
  let _ = map_set sup "Errno::EISCONN" "SystemCallError" in
  let _ = map_set sup "Errno::ENOTCONN" "SystemCallError" in
  let _ = map_set sup "Errno::ETIMEDOUT" "SystemCallError" in
  let _ = map_set sup "Errno::EHOSTUNREACH" "SystemCallError" in
  let _ = map_set sup "Errno::ENETUNREACH" "SystemCallError" in
  let _ = map_set sup "Errno::ECONNABORTED" "SystemCallError" in
  let _ = map_set sup "Errno::EBADF" "SystemCallError" in
  let _ = map_set sup "Errno::EINTR" "SystemCallError" in
  let _ = map_set sup "Errno::EINVAL" "SystemCallError" in
  let _ = map_set sup "Errno::EMFILE" "SystemCallError" in
  let _ = map_set sup "Errno::ENOTDIR" "SystemCallError" in
  let _ = map_set sup "Errno::EEXIST" "SystemCallError" in
  let _ = map_set sup "Errno::EACCES" "SystemCallError" in
  let _ = map_set sup "Errno::ENOSPC" "SystemCallError" in
  let _ = map_set sup "Errno::ESPIPE" "SystemCallError" in
  let _ = map_set sup "Errno::ENOMEM" "SystemCallError" in
  let _ = map_set sup "Errno::EIO" "SystemCallError" in
  let _ = map_set sup "Errno::EPROTO" "SystemCallError" in
  let _ = map_set sup "Errno::ENOTSUP" "SystemCallError" in
