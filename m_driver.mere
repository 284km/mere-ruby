  let _ = map_set consts "Float::MIN" (VFlt 2.2250738585072014e-308) in
  let _ = map_set consts "Float::MAX" (VFlt 1.7976931348623157e308) in
  let _ = map_set consts "Float::EPSILON" (VFlt 2.220446049250313e-16) in
  let _ = map_set consts "Float::DIG" (VInt 15) in
  let _ = map_set consts "Float::MANT_DIG" (VInt 53) in
  let _ = map_set consts "Float::MIN_EXP" (VInt (0 - 1021)) in
  let _ = map_set consts "Float::MAX_EXP" (VInt 1024) in
  let _ = map_set consts "Float::MIN_10_EXP" (VInt (0 - 307)) in
  let _ = map_set consts "Float::MAX_10_EXP" (VInt 308) in
  let _ = map_set consts "Float::RADIX" (VInt 2) in
