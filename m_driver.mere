  let _ = set_meth meths "Interrupt#initialize"
    (Meth (Cons ("msg", Nil), Cons (("msg", ENil), Nil),
           Cons (SIVarAssign ("__sigpair", ECall ("__signal_pair", Cons (ESym "INT", Nil))),
             Cons (SIVarAssign ("message",
                     EBin ("||", EVar "msg", EStrL "Interrupt")), Nil)))) in
