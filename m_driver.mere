  let _ = set_sup sup "Complex" "Numeric" in
  let _ = map_set includes "String" "Comparable" in
  // ...and Symbol is Comparable too: it answers <=> and the four ordering
  // operators, so `Symbol.include?(Comparable)` is true in ruby and the module
  // belongs in the ancestry that says so.
  let _ = map_set includes "Symbol" "Comparable" in
  // ...and Time, which orders by its instant: ruby's `Time.include?(Comparable)`
  // is true, and mere-ruby's derived < > <= >= now REQUIRE the module to be in
  // the ancestry (defining #<=> alone does not give an object the operators),
  // so a missing include stopped `(t1..t2).include?(t)` -- corpus/179 caught it.
  let _ = map_set includes "Time" "Comparable" in
