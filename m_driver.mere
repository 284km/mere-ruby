  // rbconfig.rb also defines a TOP-LEVEL `CROSS_COMPILING` (nil for a native
  // build), and standing in for that file means standing in for what it
  // defines: bundler's rubygems_ext.rb reads `CROSS_COMPILING || RUBY_PLATFORM`
  // and a missing constant is a NameError there, not a nil.
  let _ = map_set consts "CROSS_COMPILING" VNil in
  // File::FNM_* — the flag bits File.fnmatch? and Dir.glob take.
  let _ = map_set consts "File::FNM_NOESCAPE" (VInt 1) in
  let _ = map_set consts "File::FNM_PATHNAME" (VInt 2) in
  let _ = map_set consts "File::FNM_DOTMATCH" (VInt 4) in
  let _ = map_set consts "File::FNM_CASEFOLD" (VInt 8) in
  let _ = map_set consts "File::FNM_EXTGLOB" (VInt 16) in
  let _ = map_set consts "File::FNM_SYSCASE" (VInt 0) in
  // File open-mode / lock bits. mere-ruby's File does not honour them (there
  // is no open(2) here), but libraries name them when building a mode.
  let _ = map_set consts "File::RDONLY" (VInt 0) in
  let _ = map_set consts "File::WRONLY" (VInt 1) in
  let _ = map_set consts "File::RDWR" (VInt 2) in
  let _ = map_set consts "File::CREAT" (VInt 512) in
  let _ = map_set consts "File::EXCL" (VInt 2048) in
  let _ = map_set consts "File::TRUNC" (VInt 1024) in
  let _ = map_set consts "File::APPEND" (VInt 8) in
  let _ = map_set consts "File::NONBLOCK" (VInt 4) in
  let _ = map_set consts "File::BINARY" (VInt 0) in
  let _ = map_set consts "File::LOCK_SH" (VInt 1) in
  let _ = map_set consts "File::LOCK_EX" (VInt 2) in
  let _ = map_set consts "File::LOCK_UN" (VInt 8) in
  let _ = map_set consts "File::LOCK_NB" (VInt 4) in
  let _ = map_set consts "File::SEPARATOR" (mkstr "/") in
  // ⚠ ...AND ITS OTHER SPELLING. ruby's File has BOTH `SEPARATOR` and
  //   `Separator`, the same string under two names, and core/file's
  //   constants_spec names the second one twice -- once in the "separator
  //   constant" example and once in its own `defined?` example. Having
  //   thirteen of the fourteen was indistinguishable from having none, since
  //   the row records only the first mismatch.
  let _ = map_set consts "File::Separator" (mkstr "/") in
  let _ = map_set consts "File::ALT_SEPARATOR" VNil in
  let _ = map_set consts "File::PATH_SEPARATOR" (mkstr ":") in
  // the bit bucket: aws-sdk-core opens it to throw output away.
  let _ = map_set consts "File::NULL" (mkstr "/dev/null") in
  // File::Constants is where ruby actually defines the flags above; File
  // includes it, so both names reach the same values.
  let _ = map_set modules "File::Constants" VNil in
  let _ = map_set consts "File::Constants" (VClass "File::Constants") in
  // ⚠ the rest of File::Constants, which ruby names twenty-six of and this
  //   had thirteen: the open(2) flags it was missing and the whole FNM_ set,
  //   which File.fnmatch takes as its third argument. Asked of the pinned
  //   reference (the numbers are platform ones, not invented).
  let _ = map_set consts "File::DSYNC" (VInt 4194304) in
  let _ = map_set consts "File::Constants::DSYNC" (VInt 4194304) in
  let _ = map_set consts "File::SYNC" (VInt 128) in
  let _ = map_set consts "File::Constants::SYNC" (VInt 128) in
  let _ = map_set consts "File::NOCTTY" (VInt 131072) in
  let _ = map_set consts "File::Constants::NOCTTY" (VInt 131072) in
  let _ = map_set consts "File::NOFOLLOW" (VInt 256) in
  let _ = map_set consts "File::Constants::NOFOLLOW" (VInt 256) in
  let _ = map_set consts "File::SHARE_DELETE" (VInt 0) in
  let _ = map_set consts "File::Constants::SHARE_DELETE" (VInt 0) in
  let _ = map_set consts "File::FNM_CASEFOLD" (VInt 8) in
  let _ = map_set consts "File::Constants::FNM_CASEFOLD" (VInt 8) in
  let _ = map_set consts "File::FNM_DOTMATCH" (VInt 4) in
  let _ = map_set consts "File::Constants::FNM_DOTMATCH" (VInt 4) in
  let _ = map_set consts "File::FNM_EXTGLOB" (VInt 16) in
  let _ = map_set consts "File::Constants::FNM_EXTGLOB" (VInt 16) in
  let _ = map_set consts "File::FNM_NOESCAPE" (VInt 1) in
  let _ = map_set consts "File::Constants::FNM_NOESCAPE" (VInt 1) in
  let _ = map_set consts "File::FNM_PATHNAME" (VInt 2) in
  let _ = map_set consts "File::Constants::FNM_PATHNAME" (VInt 2) in
  let _ = map_set consts "File::FNM_SHORTNAME" (VInt 0) in
  let _ = map_set consts "File::Constants::FNM_SHORTNAME" (VInt 0) in
  let _ = map_set consts "File::FNM_SYSCASE" (VInt 0) in
  let _ = map_set consts "File::Constants::FNM_SYSCASE" (VInt 0) in
  // ⚠ ...but NOT the separators: SEPARATOR, ALT_SEPARATOR and PATH_SEPARATOR
  //   are File's own, not File::Constants'. Putting them here made
  //   `File::Constants.constants` name three ruby does not. NULL is the one
  //   string that really does live in Constants.
  let _ = map_set consts "File::Constants::NULL" (mkstr "/dev/null") in
  // ⚠ IO AND FILE BOTH INCLUDE IT. `IO.include?(File::Constants)` is true in
  //   ruby and both core/io and core/file have a spec for it; the module
  //   existed here and nothing included it.
  // (IO's include of File::Constants is in the prelude, AFTER its include of
  //  Enumerable -- the order ruby's Init_IO makes them, so IO.ancestors is
  //  [IO, File::Constants, Enumerable, ...]. Seeded here it came out reversed.)
  let _ = map_set includes "File" "File::Constants" in

  let _ = map_set consts "File::Constants::RDONLY" (VInt 0) in
  let _ = map_set consts "File::Constants::WRONLY" (VInt 1) in
  let _ = map_set consts "File::Constants::RDWR" (VInt 2) in
  let _ = map_set consts "File::Constants::CREAT" (VInt 512) in
  let _ = map_set consts "File::Constants::EXCL" (VInt 2048) in
  let _ = map_set consts "File::Constants::TRUNC" (VInt 1024) in
  let _ = map_set consts "File::Constants::APPEND" (VInt 8) in
  let _ = map_set consts "File::Constants::NONBLOCK" (VInt 4) in
  let _ = map_set consts "File::Constants::BINARY" (VInt 0) in
  let _ = map_set consts "File::Constants::LOCK_SH" (VInt 1) in
  let _ = map_set consts "File::Constants::LOCK_EX" (VInt 2) in
  let _ = map_set consts "File::Constants::LOCK_UN" (VInt 8) in
  let _ = map_set consts "File::Constants::LOCK_NB" (VInt 4) in
  // The identity is the REFERENCE ruby's (tools/ref_ruby.sh): mere-ruby has no
  // version of its own to report, and every gate compares its output against
  // that ruby's, so RUBY_VERSION has to be the one whose rubygems, bundler and
  // bundled_gems.rb branch on it. 3.2.2 until 2026-09-05, then 4.0.6.
  let _ = map_set consts "RUBY_VERSION" (mkstr "4.0.6") in
  let _ = map_set consts "RUBY_ENGINE" (mkstr "ruby") in
  let _ = map_set consts "RUBY_ENGINE_VERSION" (mkstr "4.0.6") in
  let _ = map_set consts "RUBY_PATCHLEVEL" (VInt 0) in
  let _ = map_set consts "RUBY_RELEASE_DATE" (mkstr "2026-07-14") in
  // The reference ruby's own revision. Like the RbConfig paths this is a
  // borrowed fact rather than a description of this interpreter -- there is no
  // git revision of mere-ruby to report here -- and it is what a program that
  // prints its ruby's identity expects to find. bundler's version command reads
  // it, so its absence was a NameError in the middle of `bundle --version`.
  let _ = map_set consts "RUBY_REVISION" (mkstr "03b6d3f8898a28604fe6cb00eae3226b821168f4") in
  let _ = map_set consts "RUBY_PLATFORM" (mkstr "arm64-darwin25") in
  let _ = map_set consts "RUBY_DESCRIPTION" (mkstr ruby_desc) in
  let _ = map_set consts "RUBY_COPYRIGHT" (mkstr "ruby - Copyright (C) 1993-2026 Yukihiro Matsumoto") in
  let _ = map_set consts "STDOUT" (VObj outid) in
  let _ = map_set globals "stdout" (VObj outid) in
  let errid = alloc_oid ocls in
  let _ = map_set ocls errid "IO" in
  let _ = map_set ivars (str_of_int errid ++ "@__io_fd") (VInt 2) in
  let _ = map_set consts "STDERR" (VObj errid) in
  let _ = map_set globals "stderr" (VObj errid) in
  let inid = alloc_oid ocls in
  let _ = map_set ocls inid "IO" in
  let _ = map_set ivars (str_of_int inid ++ "@__io_fd") (VInt 0) in
  let _ = map_set consts "STDIN" (VObj inid) in
  let _ = map_set globals "stdin" (VObj inid) in
  // the main Thread object (always index 0 of the registry), the default
  // ThreadGroup, and the thread-related constants.
  let mainid = alloc_oid ocls in
  let _ = map_set ocls mainid "Thread" in
  let _ = map_set ivars (str_of_int mainid ++ "@__tst") (mkstr "run") in
  let _ = map_set cur_thr "v" (VObj mainid) in
  let _ = map_set cur_thr "t" (VObj mainid) in
  let _ = map_set all_thr "0" (VObj mainid) in
  // ...and to the scheduler (m_sched.mere): the main thread runs root fiber 0
  let _ = map_set sch_st "main" mainid in
  let _ = map_set sch_live mainid 1 in
  let _ = map_set sch_fb mainid 0 in
  let tgid = alloc_oid ocls in
  let _ = map_set ocls tgid "ThreadGroup" in
  let _ = map_set dfl_tg "v" (VObj tgid) in
  let _ = map_set consts "ThreadGroup" (VClass "ThreadGroup") in
  let _ = map_set consts "ThreadGroup::Default" (VObj tgid) in
  let _ = map_set consts "ThreadError" (VClass "ThreadError") in
  let _ = map_set consts "Thread::Mutex" (VClass "Mutex") in
  let _ = map_set consts "Queue" (VClass "Queue") in
  let _ = map_set consts "SizedQueue" (VClass "SizedQueue") in
  let _ = map_set consts "ConditionVariable" (VClass "ConditionVariable") in
  let _ = map_set consts "Thread::Queue" (VClass "Queue") in
  let _ = map_set consts "Thread::SizedQueue" (VClass "SizedQueue") in
  let _ = map_set consts "Thread::ConditionVariable" (VClass "ConditionVariable") in
  let _ = map_set consts "ClosedQueueError" (VClass "ClosedQueueError") in
  // ENV (reads go through getenv, writes overlay), ARGV, $0/$PROGRAM_NAME.
  let envid = alloc_oid ocls in
  let _ = map_set ocls envid "EnvHash" in
  let _ = map_set consts "ENV" (VObj envid) in
  let _ = map_set consts "ARGV" (if map_has cli_argv "v" then map_get cli_argv "v" else arr_new Nil) in
  // ARGF: the pseudo-file over the ARGV filenames (or stdin). Its methods
  // (read / each / each(nil)) are dispatched specially on class "ARGF".
  let argfid = alloc_oid ocls in
  let _ = map_set ocls argfid "ARGFClass" in
  let _ = map_set consts "ARGF" (VObj argfid) in
  // ARGF is extended by Enumerable (core/argf/argf_spec's first example).
  let _ = map_set includes "ARGF" "Enumerable" in
  let _ = map_set globals "0" (mkstr name) in
  // Kernel#rand's generator is SEEDED at boot, from a random seed that
  // `srand` then reports: it was left at the generator's fixed default, so
  // every run's first `rand` was 0.8147236863931789
  // (...with 128 bits, as Random.new_seed draws them: `Random.seed` and
  // `srand` report it, and `Random.new(Random.seed)` replays the stream)
  let _ = rnd_default_seeded () in
  // `$$` is the process id, like Process.pid -- set only if there IS one. On a
  // target with no host (`mere -rv`, where the program is the machine) `getpid`
  // is an extern with no C library behind it, and this line runs at startup, so
  // it stopped every program before it began.
  //
  // Left UNSET rather than set to 0. The comment on the extern above says why:
  // a made-up number is a stable lie, and nil is detectable where a lie is not.
  // `Process.pid` still asks, and still stops, for a program that actually wants
  // the pid -- which is the honest answer to "what is my process id" on a machine
  // that has no processes.
  let _ = try_or (fn (u: unit) -> map_set globals "$" (VInt (getpid ()))) () in
  let _ = map_set globals (gvar_slot "PROGRAM_NAME") (mkstr name) in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  // A small core prelude, written in ruby and run before the program: classes
  // that are core (no `require` names them) but are ordinary objects, so
  // writing them in ruby is shorter and clearer than a builtin. It runs as its
  // own program, so it does not shift the script's line numbers.
  // ...parsed with NO magic comment: the script's frozen_string_literal
  // is the script's, and the prelude's literals are ordinary strings.
  let _ = (let fsl9 = (if map_has fsl_ctx "v" then map_get fsl_ctx "v" else "") in
           let _ = map_set fsl_ctx "v" "" in
           // ...and under its own NAME, the way ruby names the core code it
           // writes in ruby (`<internal:kernel>`): the parse stamps every body
           // with the file being parsed, and the prelude's methods carried the
           // SCRIPT's path at the prelude's own line numbers -- in
           // source_location, and as :line events a tracepoint then reported.
           let ppf9 = (if map_has load_ctx "pfile" then map_get load_ctx "pfile" else VNil) in
           let _ = map_set load_ctx "pfile" (mkstr "<internal:prelude>") in
           // ...and in its OWN encoding, UTF-8: the parse tags literals with
           // the coding of the file being parsed, and the prelude was being
           // parsed under the MAIN SCRIPT's -- under `# encoding: euc-jp`,
           // File.ftype("/tmp") answered an EUC-JP "directory".
           let pcod9 = (if map_has load_ctx "coding" then map_get load_ctx "coding" else mkstr "UTF-8") in
           let _ = map_set load_ctx "coding" (mkstr "UTF-8") in
           let (pprog, _) = parse_stmts (number_nls core_prelude (lex_src core_prelude)) Nil in
           // ⚠ THE IO LAYER IS A SECOND PASS, not more of the same string: the
           //   lexer, the parser and the evaluator recurse over their lists, so
           //   native stack use grows with the prelude's length, and with the
           //   layer appended an -O0 build (the --fast one, larger frames)
           //   died of stack overflow before the first line of a program ran.
           let (kprog, _) = parse_stmts (number_nls core_prelude_k (lex_src core_prelude_k)) Nil in
           let _ = (match ppf9 with VNil -> map_delete load_ctx "pfile" | _ -> map_set load_ctx "pfile" ppf9) in
           let _ = map_set load_ctx "coding" pcod9 in
           let _ = map_set fsl_ctx "v" fsl9 in
           let _ = hoist_run env world noblk pprog in
           hoist_run env world noblk kprog) in
  // DATA: the main script's text after `__END__`, as a File open on the
  // script and positioned there (see src_prepare). Made with the prelude's
  // own machinery, before the program runs.
  let _ = (if map_has data_ctx "off" then
             (let dsrc = "DATA = File.open(" ++ inspect (mkstr name) ++ ", \"r\")\nDATA.pos = "
                         ++ str_of_int (map_get data_ctx "off") ++ "\n" in
              let ppf8 = (if map_has load_ctx "pfile" then map_get load_ctx "pfile" else VNil) in
              let _ = map_set load_ctx "pfile" (mkstr "<internal:prelude>") in
              let (dprog, _) = parse_stmts (number_nls dsrc (lex_src dsrc)) Nil in
              let _ = (match ppf8 with VNil -> map_delete load_ctx "pfile" | _ -> map_set load_ctx "pfile" ppf8) in
              let _ = try_or (fn (u: unit) -> let _ = hoist_run env world noblk dprog in VNil) VNil in ())
           else ()) in
  let _ = cli_apply_enc "external" in
  let _ = cli_apply_enc "internal" in
  // -r's libraries, required as the script itself would require them
  let _ = (if map_has cli_reqs "v" then
             (let rec reqs9 = fn (xs: str list) ->
                (match xs with
                 | Nil -> ""
                 | Cons (l9, t9) -> "require " ++ inspect (mkstr l9) ++ chr 10 ++ reqs9 t9) in
              let rsrc = reqs9 (str_split (map_get cli_reqs "v") (chr 10)) in
              let (rprog, _) = parse_stmts (number_nls rsrc (lex_src rsrc)) Nil in
              let _ = hoist_run env world noblk rprog in ())
           else ()) in
  // ...and this is where ruby would have parsed the main script (see pok9)
  let _ = (if map_has cli_opt "synerr" then (let _ = print_err (map_get cli_opt "synerr") in exit 1) else ()) in
  // the main script's locals exist from here on: a file -r loaded ran before
  // the script was compiled and saw none of them
  let _ = map_set tl_decl "v" (tl_decl_names (deep_targets prog)) in
  // An exception nobody rescued: report it the way Ruby does and exit 1,
  // instead of letting the interpreter's own `fail` message be the last word.
  // (Until this, every uncaught Ruby exception read as "(ruby exception
  // raised)", which named neither the class nor the message.)
  // ruby LOADS RUBYGEMS BEFORE the program (that is what `--disable=gems` turns
  // off), and mere-ruby did not: `bundle --version` reached line 15 and stopped
  // at `uninitialized constant Gem::Requirement`, because bundler expects the
  // gem library to be there already. So when rubygems can be FOUND on the load
  // path, it is required first, exactly as ruby does; when it cannot (no -I, no
  // RUBYLIB -- the corpus, the playground) nothing happens and nothing slows
  // down. MERE_RUBY_NO_GEMS=1 is the `--disable=gems` of this interpreter.
  let _ = (if str_eq (env_get "MERE_RUBY_NO_GEMS") "" && (if map_has cli_opt "nogems" then false else true)
              && (if str_eq (load_path_find world "rubygems.rb") "" then false else true)
           then (let _ = try_or (fn (u: unit) -> (match do_require env world noblk false "rubygems" with _ -> ())) () in ())
           else ()) in
  let _ = map_set gc_state "log" (if str_eq (env_get "MERE_RUBY_GC_LOG") "" then 0 else 1) in
  // Two diagnostics for the collector, both off unless asked for. They exist
  // because the questions they answer came up and could not be answered by
  // reading the code:
  //   MERE_RUBY_GC_NO_LVUP_ROOT=1 stops rooting lv_up. UNSOUND -- a closure
  //     can lose its outer scope -- and for measurement only: it answers "how
  //     much is the scope-chain table PINNING?". Answer, on a rubocop load:
  //     nothing (str_store moved by 24 bytes), which killed a plan to prune it.
  //   MERE_RUBY_GC_TIGHT=1 makes the byte trigger fire at baseline + 8 MB
  //     instead of 2x + 32 MB, and counts the safepoints that pressure wanted
  //     and could not have (the gc_blocked row of MERE_RUBY_STORE_STATS).
  //     Answer, on the same load: 2 collections against 18.8M blocked checks,
  //     which is how "the collector is starved of safe points, not of
  //     pressure" stopped being a guess.
  let _ = map_set gc_state "nolvup" (if str_eq (env_get "MERE_RUBY_GC_NO_LVUP_ROOT") "" then 0 else 1) in
  let _ = map_set gc_state "tight" (if str_eq (env_get "MERE_RUBY_GC_TIGHT") "" then 0 else 1) in
  //   MERE_RUBY_GC_STRESS=N collects off the stack at every Nth body safepoint
  //     (gc_point), pressure or not: a missing root shows up in a corpus run
  //   MERE_RUBY_GC_KEEP_PROCS=1 sweeps no proc (every proc is kept, as before
  //     note 270): whether a lost value was a proc the sweep took
  let _ = (if str_eq (env_get "MERE_RUBY_GC_KEEP_PROCS") "" then () else map_set gc_state "keepprocs" 1) in
  let _ = (if str_eq (env_get "MERE_RUBY_GC_DBG") "" then () else map_set gc_state "dbg" (int_of_str (env_get "MERE_RUBY_GC_DBG"))) in
  let _ = (let v9 = env_get "MERE_RUBY_GC_STRESS" in
           if str_eq v9 "" then () else map_set gc_state "stress" (int_of_str v9)) in
  // SIGPIPE is caught and does nothing, as ruby has it from its first
  // instruction: a write to a pipe or socket nobody reads is Errno::EPIPE,
  // and a child started later begins with the default (m_state's extern).
  // ⚠ ...EVEN WHEN IT WAS INHERITED IGNORED. ruby keeps an inherited ignore
  //   for itself but execs its children with the default; ours are started
  //   by a shell, which inherits whatever this process has -- so a CI runner
  //   that starts its steps with SIGPIPE ignored (GitHub's macOS one does)
  //   gave every child the ignore, and `spawn("kill -PIPE $$")` exited 0
  //   (corpus/284). The default first, then the handler: the handler is what
  //   is reset at exec.
  // (and a target with no C library -- RV64, where the program is the
  //  machine -- has no signals to set: the extern is a named failure there,
  //  and this line stopped every program before its first)
  let _ = try_or (fn (u: unit) -> let _ = proc_sig_default 13 in proc_sig_noop 13) 0 in
  let _ = (if str_eq (env_get "MERE_RUBY_INTERN_LOG") "" then () else map_set intern_log "on" 1) in
  // ⚠ BEGIN { } runs before the driver, and an exception out of it went past
  //   everything to the runtime, which printed "fail: mere-ruby: (ruby
  //   exception raised)" -- no class, no message, no line. assert_separately
  //   puts its whole harness in a BEGIN, so every child's failure read so.
  //   A BEGIN that raises ends the program the way an unrescued exception in
  //   the body does: the same report, at_exit first, and nothing else runs.
  let pre_ok = try_or_msg (fn (u: unit) -> let _ = run_pre env world noblk prog in true)
                 (fn (m: str) -> let _ = note_extern_refused m in false) in
  // The driver: plain recursion, no carry -- the collection is a function
  // now (gc_collect) and every store rebuilds in place through stable
  // handles, so nothing needs an arena swap. Each chunk runs inside its own
  // region DRV block: the per-iteration flow copies and driver temporaries
  // that used to land in the carried loop's arena die at the chunk boundary
  // instead.
  let rec gc_drive = fn (cursor: int) -> fn (lastv: Val) ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    // pin the carried value for the collection below (see gc_hold).
    let _ = map_set gc_hold "lastv" lastv in
    // the stack is trivially clean here; a raise anywhere below may have
    // skipped gc_unsafe pops, so the counter self-heals at each chunk.
    // ...except while a Fiber is suspended: its stack's pushes are real, and
    // they are what keeps every safepoint from collecting under it.
    let _ = (if fb_live () > 0 then () else map_set gc_unsafe "n" 0) in
    if cursor < gc_total then
      let r3 = try_or_msg (fn (u: unit) ->
                 region DRV {
                   run_until_gc env world noblk (gc_suffix gc_mids cursor) lastv
                 })
               (fn (m: str) -> let _ = note_extern_refused m in (0, 3, VNil)) in
      let (consumed, flag, v2) = r3 in
      (if flag == 0 then
        // v2 -- the value the chunk just produced -- is the one this
        // collection can see least: it was born inside the region above and
        // is held by nothing but this local until the next chunk pins it.
        (let _ = map_set gc_hold "lastv" v2 in
         // a chunk also stops on its while budget, which is not pressure, so
         // GC.disable is asked here as well as in gc_pressure.
         // With fibers suspended, first give back the ones nobody can reach
         // (what lets a program that drops a stepped Enumerator collect in
         // full again); the collection then roots the suspended stacks'
         // frames and what their statements have built, and does not compact
         // while any is left (see gc_collect).
         let _ = (if gc_auto_off () then ()
                  else (let _ = (if fb_live () > 0 then (let _ = fb_reclaim env world in ()) else ()) in
                        gc_collect_any env world)) in
         gc_drive (cursor + consumed) v2)
      else if flag == 1 then gc_drive gc_total v2
      else if flag == 2 then gc_drive (gc_total + 1) lastv
      else gc_drive (gc_total + 2) lastv)
    else
      // ---- finish: reporting, at_exit, optional print ----
      let (meths, sup, ocls, ivars) = world in
      // (=exit prints them after the at_exit handlers instead: all of a
      // test/unit file runs inside one, so before them it reads nothing)
      let sst9 = env_get "MERE_RUBY_STORE_STATS" in
      let _ = (if str_eq sst9 "" || str_eq sst9 "exit" then () else store_stats world) in
      let rax9 = fn (rep: Val -> unit) ->
        (let ov9 = run_at_exits_r world rep in
         let _ = (if str_eq sst9 "exit" then store_stats world else ()) in
         ov9) in
      // the handlers' own unrescued exceptions are reported as the main
      // script's is, and a status they decide replaces the script's
      let rep9 = fn (e9: Val) -> print_err (top_report env world e9 name) in
      // ...and they run with the exception that is ending the program in `$!`
      // (ruby's error_handle has it there; `$!.message` in a handler was a
      // NoMethodError on nil, reported in place of what the handler did)
      let ae9 = fn (e9: Val) -> fn (st9: int) ->
        (let _ = (match e9 with VNil -> () | _ -> map_set globals "!" e9) in
         let ov9 = rax9 rep9 in if ov9 >= 0 then ov9 else st9) in
      let _ = if cursor <= gc_total + 1 then (let ov9 = rax9 rep9 in if ov9 >= 0 then exit ov9 else ()) else
        (let exc = (if map_has ivars "$exc" then bi_fixup world (map_get ivars "$exc") else VNil) in
         match exc with
         // ruby runs the at_exit handlers FIRST and prints the report after
         | VExc (_, _) -> let st9 = ae9 exc 1 in let _ = print_err (top_report env world exc name) in exit st9
         | VObj eid ->
           (let ec = map_get ocls eid in
            // an unrescued SystemExit (Kernel#exit / #abort) ends the program
            // with the status it carries and says nothing: that is what exit
            // means. Everything else is reported.
            if str_eq ec "SystemExit" || str_list_has (ancestors_of world ec) "SystemExit" then
              (let st = (if map_has ivars (str_of_int eid ++ "@__status")
                         then (match map_get ivars (str_of_int eid ++ "@__status") with VInt n -> n | _ -> 0)
                         else 0) in
               exit (ae9 exc st))
            // ...and an unrescued SignalException (Interrupt too) ends it OF
            // the signal, as ruby's does (exiting_split): the at_exit handlers
            // first, then the default disposition and the signal itself, so the
            // parent's wait sees `signaled?` and the signal's number. Nothing
            // is printed for SignalException itself; a subclass (Interrupt)
            // is reported first, as ruby reports it. (It was an exit with
            // status 128 + signo, which a shell prints the same and
            // Process::Status does not: signaled? was false.)
            else if str_eq ec "SignalException" || str_eq ec "Interrupt"
                    || str_list_has (ancestors_of world ec) "SignalException" then
              (let sg9 = (match (if map_has ivars (str_of_int eid ++ "@__sigpair") then map_get ivars (str_of_int eid ++ "@__sigpair") else VNil) with
                          | VArr a9 -> (match deref a9 with Cons (VInt n9, _) -> n9 | _ -> 0)
                          | _ -> 0) in
               let st9 = ae9 exc (128 + sg9) in
               let _ = (if str_eq ec "SignalException" then () else print_err (top_report env world exc name)) in
               die_of_signal sg9 st9)
            // ...and an Errno a write to stdout raised with SIGPIPE attached
            // (out_refused, ruby's rb_sys_fail_on_write): unrescued, it ends
            // the process of that signal, and says nothing
            else if (match (if map_has ivars (str_of_int eid ++ "@__signo") then map_get ivars (str_of_int eid ++ "@__signo") else VNil) with
                     | VInt _ -> str_list_has (ancestors_of world ec) "SystemCallError"
                     | _ -> false) then
              (let sg9 = (match map_get ivars (str_of_int eid ++ "@__signo") with VInt n9 -> n9 | _ -> 0) in
               die_of_signal sg9 (ae9 exc (128 + sg9)))
            else
            let st9 = ae9 exc 1 in
            let _ = print_err (top_report env world exc name) in
            exit st9)
         // a builtin's refusal that built no exception is still one: the
         // class and message it recorded are what a rescue would have caught
         // (pending_exc), and the report is the same as for any other
         | _ when map_has prim_missing "c" || map_has prim_missing "n" ->
           (let exc9 = pending_exc world in
            let st9 = ae9 exc9 1 in
            let _ = print_err (top_report env world exc9 name) in
            exit st9)
         | _ ->
           (let m = (if map_has prim_missing "i"
                     then (match map_get prim_missing "i" with VStr h -> sget h | _ -> "mere-ruby: failed")
                     else "mere-ruby: failed") in
            let _ = print_err (if str_eq (err_where name) name then m else err_where name ++ ": " ++ m) in exit 1)) in
      (if print_result && cursor == gc_total then
        (match lastv with
         | VObj id ->
           let cls = map_get ocls id in
           if has_meth world cls "to_s" then
             (match invoke world noblk (VObj id) cls "to_s" Nil with VStr sh -> let s2 = sget sh in print_no_nl s2 | other -> print_no_nl (to_s other))
           else print_no_nl (to_s (VObj id))
         // a collection is printed by INSPECTING it, elements and all, which
         // needs the world (see puts_one_nonl): the world-free to_s named every
         // object in it "#<object>".
         | VArr _ -> print_no_nl (inspect_w gc_cenv0 world lastv)
         | VHsh _ -> print_no_nl (inspect_w gc_cenv0 world lastv)
         | v -> print_no_nl (to_s v))
      else ()) in
  gc_drive (if pre_ok then 0 else gc_total + 2) VNil;


let run_prog = fn (path: str) -> fn (print_result: bool) ->
  run_src (read_file path) print_result path;

// The loop switches, which ruby lets you run together: -n, -p, -l, -a, -F<pat>
// and a trailing e (`-ne CODE`, `-naF:`, `-lpe'...'`). Records each in
// cli_opt and answers "" when the argument is done, "e" when the next argument
// is -e's CODE, and "e:CODE" when the CODE was attached.
let rec loop_short = fn (a: str) -> fn (i: int) ->
  if i >= str_len a then ""
  else
    let c = char_at a i in
    if str_eq c "n" then let _ = map_set cli_opt "loop_n" "1" in loop_short a (i + 1)
    else if str_eq c "p" then let _ = map_set cli_opt "loop_p" "1" in loop_short a (i + 1)
    else if str_eq c "l" then let _ = map_set cli_opt "flag_l" "1" in loop_short a (i + 1)
    else if str_eq c "a" then let _ = map_set cli_opt "flag_a" "1" in loop_short a (i + 1)
    else if str_eq c "F" then let _ = map_set cli_opt "flag_F" (substring a (i + 1) (str_len a)) in ""
    else if str_eq c "e" then (if i + 1 < str_len a then "e:" ++ substring a (i + 1) (str_len a) else "e")
    else let _ = map_set cli_opt "bad" a in "";
let is_loop_short = fn (a: str) ->
  str_len a >= 2 && str_eq (char_at a 0) "-"
  && (let c = char_at a 1 in str_eq c "n" || str_eq c "p" || str_eq c "l" || str_eq c "a" || str_eq c "F");

// ---- the rest of ruby's switches ------------------------------------------
// A switch that cannot go on is RuntimeError in ruby, printed as
// "ruby: <message> (RuntimeError)" before anything runs. The first one wins,
// as ruby stops at it; run_cli prints it.
let cli_fatal = fn (msg: str) ->
  if map_has cli_opt "fatal" then () else map_set cli_opt "fatal" msg;
// ...and the one ruby raises as `fatal` instead (rb_fatal: a -C to nowhere)
let cli_fatal_f = fn (msg: str) ->
  if map_has cli_opt "fatal" then ()
  else (let _ = map_set cli_opt "fatal_cls" "fatal" in map_set cli_opt "fatal" msg);
// ruby's set_option_encoding_once: -E / --encoding / --external-encoding /
// --internal-encoding / -U fill ONE slot each, and a second switch naming a
// DIFFERENT encoding is refused ("default_internal already set to ascii")
// rather than quietly winning. The same name again, compared case-blind as
// ruby compares it, is not a change -- `-U -U` is fine.
let cli_enc_once = fn (slot: str) -> fn (nm: str) ->
  let k = "enc_" ++ slot in
  if map_has cli_opt k && (if str_eq (str_upcase (map_get cli_opt k)) (str_upcase nm) then false else true) then
    cli_fatal ("default_" ++ slot ++ " already set to " ++ map_get cli_opt k)
  else map_set cli_opt k nm;
// -E ext[:int] and --encoding ext[:int], ruby's set_encoding_part: an empty
// part leaves its slot alone (`-E :SJIS` names only the internal encoding,
// `-E SJIS:` only the external one) and a THIRD part is an error.
let cli_enc_arg = fn (flag: str) -> fn (s: str) ->
  let c1 = str_find_from s ":" 0 in
  if c1 < 0 then cli_enc_once "external" s
  else
    let _ = (if c1 > 0 then cli_enc_once "external" (substring s 0 c1) else ()) in
    let s2 = substring s (c1 + 1) (str_len s) in
    if str_eq s2 "" then ()
    else
      let c2 = str_find_from s2 ":" 0 in
      if c2 < 0 then cli_enc_once "internal" s2
      else
        let _ = (if c2 > 0 then cli_enc_once "internal" (substring s2 0 c2) else ()) in
        let s3 = substring s2 (c2 + 1) (str_len s2) in
        if str_eq s3 "" then () else cli_fatal ("extra argument for " ++ flag ++ ": " ++ s3);
// -K<kcode>: the main script's SOURCE encoding, and the external one unless
// something already named it (ruby writes ext only when it is unset). An
// unknown code is ignored, as ruby ignores it.
let cli_kcode = fn (c: str) ->
  let nm = (if str_eq c "e" || str_eq c "E" then "EUC-JP"
            else if str_eq c "s" || str_eq c "S" then "Windows-31J"
            else if str_eq c "u" || str_eq c "U" then "UTF-8"
            else if str_eq c "n" || str_eq c "N" || str_eq c "a" || str_eq c "A" then "ASCII-8BIT"
            else "") in
  if str_eq nm "" then ()
  else (let _ = map_set cli_opt "enc_source" nm in
        if map_has cli_opt "enc_external" then () else map_set cli_opt "enc_external" nm);
// -0[octal]: ruby's scan_oct over up to FOUR characters starting AT the 0, so
// `-072` is ':' and `-0` alone is "\0". A value past 0377 means no separator
// at all ($/ = nil, `-0777` slurps), and `-00` (a zero spelled with two
// digits) is paragraph mode, "". The separator is frozen (4.0).
let rec cli_oct = fn (s: str) -> fn (i: int) -> fn (left: int) -> fn (acc: int) ->
  if left <= 0 || i >= str_len s then (acc, i)
  else
    let c = char_at s i in
    if c >= "0" && c <= "7" then cli_oct s (i + 1) (left - 1) (acc * 8 + (ord c - 48))
    else (acc, i);
let cli_dash0 = fn (a: str) ->
  let (v, e) = cli_oct a 1 4 0 in
  let n = e - 1 in
  if v > 255 then map_set globals (gvar_slot "/") VNil
  else
    let rs = mkstr (if v == 0 && n >= 2 then "" else chr v) in
    let _ = (match rs with VStr h -> sfrozen_set h | _ -> ()) in
    map_set globals (gvar_slot "/") rs;
// -I's directory is EXPANDED from the current directory (ruby's
// expand_include_path), except one spelled "./..." which stays as written; a
// symlink in it is kept, not resolved. Added as written, `-I fixtures` put
// the bare "fixtures" on $LOAD_PATH, and a Dir.chdir later moved every
// library it named.
let cli_inc_expand = fn (d: str) ->
  if str_len d == 0 then d
  else if str_eq (char_at d 0) "/" then d
  else if str_len d >= 2 && str_eq (substring d 0 2) "./" then d
  else if str_eq d "~" then env_get "HOME"
  else if str_len d >= 2 && str_eq (substring d 0 2) "~/" then env_get "HOME" ++ substring d 1 (str_len d)
  else path_norm (env_get "PWD" ++ "/" ++ d);
// -C dir / -X dir / -x dir: the directory is changed WHILE the switches are
// read, as ruby does it, so a relative script path after it is looked up
// from there.
let cli_chdir = fn (d: str) ->
  if dir_chdir_to d == 0 then () else cli_fatal_f ("Can't chdir to " ++ d);
// --enable / --disable: a comma-separated list of features, each named by
// any leading part of its name with '-' and '_' alike (ruby's NAME_MATCH_P:
// `--disable=gem`, `--enable-did-you-mean`), or `all`. An unknown one is a
// warning and nothing else. Only three of them switch anything here: gems
// (whether rubygems is required first), frozen_string_literal (what a literal
// with no magic comment is) and rubyopt (whether RUBYOPT is read at all);
// the rest are accepted and have nothing to switch.
let cli_feature_names = Cons ("gems", Cons ("error_highlight", Cons ("did_you_mean", Cons ("syntax_suggest",
                          Cons ("rubyopt", Cons ("frozen_string_literal", Cons ("yjit", Cons ("zjit", Nil))))))));
let rec cli_us = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else cli_us s (i + 1) (acc ++ (if str_eq (char_at s i) "-" then "_" else char_at s i));
let rec cli_feat_find = fn (nm: str) -> fn (fs: str list) ->
  match fs with
  | Nil -> ""
  | Cons (f, t) ->
    if str_len nm > 0 && str_len nm <= str_len f && str_eq (substring f 0 (str_len nm)) nm then f
    else cli_feat_find nm t;
let cli_feat_set = fn (f: str) -> fn (on: bool) ->
  if str_eq f "gems" then (if on then (if map_has cli_opt "nogems" then map_delete cli_opt "nogems" else ()) else map_set cli_opt "nogems" "1")
  else if str_eq f "rubyopt" then (if on then (if map_has cli_opt "norubyopt" then map_delete cli_opt "norubyopt" else ()) else map_set cli_opt "norubyopt" "1")
  else if str_eq f "frozen_string_literal" then
    (let _ = (if map_has cli_fsl "on" then map_delete cli_fsl "on" else ()) in
     let _ = (if map_has cli_fsl "off" then map_delete cli_fsl "off" else ()) in
     map_set cli_fsl (if on then "on" else "off") "1")
  else ();
let rec cli_feat_all = fn (fs: str list) -> fn (on: bool) ->
  match fs with Nil -> () | Cons (f, t) -> let _ = cli_feat_set f on in cli_feat_all t on;
let rec cli_features = fn (flag: str) -> fn (on: bool) -> fn (items: str list) ->
  match items with
  | Nil -> ()
  | Cons (it0, t) ->
    let it = cli_us it0 0 "" in
    let _ = (if str_eq it "" then ()
             else if str_eq it "all" then cli_feat_all cli_feature_names on
             else
               (let f = cli_feat_find it cli_feature_names in
                if str_eq f "" then
                  (let _ = print_err ("mere-ruby: warning: unknown argument for " ++ flag ++ ": '" ++ it0 ++ "'\n"
                                      ++ "mere-ruby: warning: features are [gems, error_highlight, did_you_mean, syntax_suggest, rubyopt, frozen_string_literal, yjit, zjit].") in ())
                else cli_feat_set f on)) in
    cli_features flag on t;
// RUBYOPT is read like the command line but refuses the switches that would
// change WHAT runs rather than how (ruby's `envopt` arms): "invalid switch in
// RUBYOPT: -e". The long ones are named in full, the short ones by letter.
let cli_envopt_bad = fn (a: str) ->
  if str_len a >= 2 && str_eq (substring a 0 2) "--" then
    (let eq = str_find_from a "=" 0 in
     let nm = (if eq < 0 then a else substring a 0 eq) in
     str_eq nm "--help" || str_eq nm "--copyright" || str_eq nm "--version" || str_eq nm "--yydebug" || str_eq nm "--dump")
  else if str_len a >= 2 && str_eq (char_at a 0) "-" then str_contains "apnycshlSeixCXF0" (char_at a 1)
  else false;
let cli_switch_name = fn (a: str) ->
  if str_len a >= 2 && str_eq (substring a 0 2) "--" then
    (let eq = str_find_from a "=" 0 in if eq < 0 then a else substring a 0 eq)
  else substring a 0 2;
// -s: the script's leading `-name` / `-name=value` arguments become globals
// ($name = true, or the value), the first dash dropped and every other one
// turned into an underscore (`--name` is $_name), up to a `--` (removed) or
// the first argument that is not a switch -- ruby's process_sflag.
let rec cli_sflag = fn (xs: str list) ->
  match xs with
  | Nil -> Nil
  | Cons (a, rest) ->
    if str_eq a "--" then rest
    else if str_len a < 2 || (if str_eq (char_at a 0) "-" then false else true) then xs
    else
      (let eq = str_find_from a "=" 1 in
       let nm = cli_us (substring a 1 (if eq < 0 then str_len a else eq)) 0 "" in
       let v = (if eq < 0 then VBool true else mkstr (substring a (eq + 1) (str_len a))) in
       let _ = map_set globals (gvar_slot nm) v in
       cli_sflag rest);
let cli_verbose = fn (v: Val) -> map_set globals (gvar_slot "VERBOSE") v;

// consume CLI flags, returning the remaining args with those flags removed
// (the switches are recorded in cli_opt / cli_fsl / globals as a side effect).
// The same function reads RUBYOPT (cli_opt "in_rubyopt"), which is the command
// line's grammar with the envopt refusals in front.
let rec take_flags = fn (argl: str list) ->
  match argl with
  | Nil -> Nil
  | Cons (a, rest) ->
    if map_has cli_opt "in_rubyopt" && cli_envopt_bad a then
      let _ = cli_fatal ("invalid switch in RUBYOPT: " ++ cli_switch_name a) in Nil
    // -w / -W[level] / -W:category: $VERBOSE and the deprecation warnings,
    // as ruby's command line sets them (level 2 is -w; 1 is false; 0 is nil)
    else if str_eq a "-w" || str_eq a "-W" || str_eq a "-W2" then
      let _ = cli_verbose (VBool true) in
      let _ = map_set warn_cats "deprecated" (VBool true) in take_flags rest
    else if str_eq a "-W1" then let _ = cli_verbose (VBool false) in take_flags rest
    else if str_eq a "-W0" then let _ = cli_verbose VNil in take_flags rest
    else if str_len a > 3 && str_eq (substring a 0 3) "-W:" then
      (let c9 = substring a 3 (str_len a) in
       let _ = (if str_len c9 > 3 && str_eq (substring c9 0 3) "no-"
                then map_set warn_cats (substring c9 3 (str_len c9)) (VBool false)
                else map_set warn_cats c9 (VBool true)) in take_flags rest)
    // -d / --debug: $DEBUG (and $-d, its alias) true, and $VERBOSE with it.
    // run_src seeds $DEBUG false, so the switch is kept in cli_opt and
    // applied there.
    else if str_eq a "-d" || str_eq a "--debug" then
      let _ = map_set cli_opt "debug" "1" in
      // ...and with $DEBUG on, ruby records where each literal was written
      // (the frozen-string-literal debugging, see str_lit_site)
      let _ = map_set cli_opt "dbg_fsl" "1" in
      let _ = cli_verbose (VBool true) in take_flags rest
    // --debug=frozen-string-literal / --debug-frozen-string-literal: each
    // string literal remembers where it was written (str_lit_site); the other
    // --debug= features are accepted with nothing to switch
    else if str_eq a "--debug=frozen-string-literal" || str_eq a "--debug-frozen-string-literal" then
      let _ = map_set cli_opt "dbg_fsl" "1" in take_flags rest
    else if str_len a > 8 && str_eq (substring a 0 8) "--debug=" then take_flags rest
    else if str_eq a "--verbose" then let _ = cli_verbose (VBool true) in take_flags rest
    // -i[ext]: ARGF edits its files in place, keeping each as file+ext when an
    // extension is given ($-i is what ARGF reads)
    else if str_len a >= 2 && str_eq (substring a 0 2) "-i" then
      let _ = map_set globals (gvar_slot "-i") (mkstr (substring a 2 (str_len a))) in take_flags rest
    // --backtrace-limit=N: what Thread::Backtrace.limit reports, and how many
    // frames an uncaught exception's report prints
    else if str_len a > 18 && str_eq (substring a 0 18) "--backtrace-limit=" then
      let _ = map_set globals "__backtrace_limit" (VInt (int_of_str (substring a 18 (str_len a)))) in take_flags rest
    // --enable=LIST / --enable-LIST / --enable LIST, and --disable the same
    else if str_len a > 9 && str_eq (substring a 0 9) "--enable=" then
      let _ = cli_features "--enable" true (str_split (substring a 9 (str_len a)) ",") in take_flags rest
    else if str_len a > 9 && str_eq (substring a 0 9) "--enable-" then
      let _ = cli_features "--enable" true (str_split (substring a 9 (str_len a)) ",") in take_flags rest
    else if str_len a > 10 && str_eq (substring a 0 10) "--disable=" then
      let _ = cli_features "--disable" false (str_split (substring a 10 (str_len a)) ",") in take_flags rest
    else if str_len a > 10 && str_eq (substring a 0 10) "--disable-" then
      let _ = cli_features "--disable" false (str_split (substring a 10 (str_len a)) ",") in take_flags rest
    else if str_eq a "--enable" || str_eq a "--disable" then
      (match rest with
       | Cons (l9, rest2) -> let _ = cli_features a (str_eq a "--enable") (str_split l9 ",") in take_flags rest2
       | Nil -> Nil)
    // -I<dir> / -I <dir>: prepend to $LOAD_PATH, in the order given.
    else if str_len a > 2 && str_eq (substring a 0 2) "-I" then
      let _ = add_inc (cli_inc_expand (substring a 2 (str_len a))) in take_flags rest
    else if str_eq a "-I" then
      (match rest with
       | Cons (d, rest2) -> let _ = add_inc (cli_inc_expand d) in take_flags rest2
       | Nil -> Nil)
    // -r<lib> / -r <lib>: require the library before the script runs
    else if str_len a > 2 && str_eq (substring a 0 2) "-r" then
      let _ = add_cli_req (substring a 2 (str_len a)) in take_flags rest
    else if str_eq a "-r" then
      (match rest with
       | Cons (d, rest2) -> let _ = add_cli_req d in take_flags rest2
       | Nil -> Nil)
    // -E ext[:int] / -Eext[:int] / --encoding=... / --encoding ...
    else if str_eq a "-E" || str_eq a "--encoding" then
      (match rest with
       | Cons (e9, rest2) -> let _ = cli_enc_arg (if str_eq a "-E" then "-E" else "--encoding") e9 in take_flags rest2
       | Nil -> Nil)
    else if str_len a > 2 && str_eq (substring a 0 2) "-E" then
      let _ = cli_enc_arg "-E" (substring a 2 (str_len a)) in take_flags rest
    else if str_len a > 11 && str_eq (substring a 0 11) "--encoding=" then
      let _ = cli_enc_arg "--encoding" (substring a 11 (str_len a)) in take_flags rest
    else if str_eq a "--external-encoding" || str_eq a "--internal-encoding" then
      (match rest with
       | Cons (e9, rest2) -> let _ = cli_enc_once (if str_eq a "--external-encoding" then "external" else "internal") e9 in take_flags rest2
       | Nil -> Nil)
    else if str_len a > 20 && str_eq (substring a 0 20) "--external-encoding=" then
      let _ = cli_enc_once "external" (substring a 20 (str_len a)) in take_flags rest
    else if str_len a > 20 && str_eq (substring a 0 20) "--internal-encoding=" then
      let _ = cli_enc_once "internal" (substring a 20 (str_len a)) in take_flags rest
    // -U: the internal encoding is UTF-8 (the same slot -E's :int fills)
    else if str_eq a "-U" then let _ = cli_enc_once "internal" "UTF-8" in take_flags rest
    else if str_len a >= 2 && str_eq (substring a 0 2) "-K" then
      let _ = (if str_len a > 2 then cli_kcode (char_at a 2) else ()) in take_flags rest
    else if str_len a >= 2 && str_eq (substring a 0 2) "-0" then let _ = cli_dash0 a in take_flags rest
    // -C dir / -Cdir / -X dir (the old spelling of the same switch)
    else if str_eq a "-C" || str_eq a "-X" then
      (match rest with
       | Cons (d, rest2) -> let _ = cli_chdir d in (if map_has cli_opt "fatal" then Nil else take_flags rest2)
       | Nil -> Nil)
    else if str_len a > 2 && (str_eq (substring a 0 2) "-C" || str_eq (substring a 0 2) "-X") then
      let _ = cli_chdir (substring a 2 (str_len a)) in (if map_has cli_opt "fatal" then Nil else take_flags rest)
    // -x[dir]: the program starts at its first `#!...ruby` line (cli_x_start)
    else if str_len a >= 2 && str_eq (substring a 0 2) "-x" then
      let _ = map_set cli_opt "xflag" "1" in
      let _ = (if str_len a > 2 then cli_chdir (substring a 2 (str_len a)) else ()) in
      (if map_has cli_opt "fatal" then Nil else take_flags rest)
    // -c: check the syntax and run nothing
    else if str_eq a "-c" then let _ = map_set cli_opt "check" "1" in take_flags rest
    // -s: the script's own switches become globals (cli_sflag)
    else if str_eq a "-s" then let _ = map_set cli_opt "sflag" "1" in take_flags rest
    // -S: the script is looked for along RUBYPATH, then PATH (cli_path_find)
    else if str_eq a "-S" then let _ = map_set cli_opt "Sflag" "1" in take_flags rest
    // -v / --version: print the version. ruby's -v also sets $VERBOSE and
    // carries on to the script, so this does not stop parsing: `-v FILE` runs
    // FILE, and a bare `-v` exits 0 because no script follows it.
    // (--version prints and stops; $VERBOSE is -v's alone)
    else if str_eq a "-v" then
      let _ = map_set cli_opt "ver" "1" in
      let _ = cli_verbose (VBool true) in take_flags rest
    else if str_eq a "--version" then
      let _ = map_set cli_opt "ver" "1" in take_flags rest
    else if str_eq a "-h" || str_eq a "--help" then
      let _ = map_set cli_opt "help" "1" in take_flags rest
    else if is_loop_short a then
      (let r9 = loop_short a 1 in
       let add_code = fn (code: str) ->
         map_set cli_opt "eval" ((if map_has cli_opt "eval" then map_get cli_opt "eval" ++ "\n" else "") ++ code) in
       if str_eq r9 "e" then
         (match rest with
          | Cons (code, rest2) -> let _ = add_code code in take_flags rest2
          | Nil -> let _ = map_set cli_opt "bad" "-e" in Nil)
       else if str_len r9 > 2 then let _ = add_code (substring r9 2 (str_len r9)) in take_flags rest
       else if map_has cli_opt "bad" then Nil
       else take_flags rest)
    // -e CODE / -eCODE: run CODE instead of a script file. Repeated -e join
    // with "\n" -- they are LINES OF ONE PROGRAM, not separate programs, which
    // is why `-e 'a = 1' -e 'puts a'` has to see one scope.
    else if str_eq a "-e" then
      (match rest with
       | Cons (code, rest2) ->
         let pre = (if map_has cli_opt "eval" then map_get cli_opt "eval" ++ "\n" else "") in
         let _ = map_set cli_opt "eval" (pre ++ code) in take_flags rest2
       | Nil -> let _ = map_set cli_opt "bad" "-e" in Nil)
    else if str_len a > 2 && str_eq (substring a 0 2) "-e" then
      let pre = (if map_has cli_opt "eval" then map_get cli_opt "eval" ++ "\n" else "") in
      let _ = map_set cli_opt "eval" (pre ++ substring a 2 (str_len a)) in take_flags rest
    // The two long flags run_cli owns: hand them back untouched rather than
    // letting the unrecognised-option arm below claim them.
    else if str_eq a "--parse-only" || str_eq a "--eval-print" then Cons (a, rest)
    // `--` ends option parsing; everything after is the script and its ARGV.
    else if str_eq a "--" then rest
    // An unrecognised -option is an ERROR, not a filename. Before this it fell
    // through to read_file, which reported `-v` as a missing file: that names
    // the symptom and hides the cause.
    else if str_len a > 1 && str_eq (substring a 0 1) "-" then
      let _ = map_set cli_opt "bad" a in Nil
    // ★ Any other argument ENDS option parsing, as it does for ruby. Scanning
    // the whole list (what this did before) meant `mere-ruby foo.rb -Ilib` ate
    // -Ilib as an interpreter flag instead of passing it to foo.rb in ARGV.
    else Cons (a, rest);

// RUBYOPT, read AFTER the command line and through the same switches (ruby's
// moreswitches): its -I directories and -r libraries come after the command
// line's, and a first word without a dash gets one (`RUBYOPT=rubygems` was
// the old `-rubygems`). What the command line already DECIDED is not taken
// back -- $VERBOSE (`RUBYOPT=-W2 ruby -W0` is nil) and the three encoding
// slots, which ruby saves around the RUBYOPT pass and restores, so `-U` there
// cannot collide with a -E given on the command line. --disable=rubyopt
// skips all of it.
let rec cli_words = fn (s: str) -> fn (i: int) -> fn (cur: str) ->
  if i >= str_len s then (if str_eq cur "" then Nil else Cons (cur, Nil))
  else
    let c = char_at s i in
    if str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" then
      (if str_eq cur "" then cli_words s (i + 1) "" else Cons (cur, cli_words s (i + 1) ""))
    else cli_words s (i + 1) (cur ++ c);
let cli_rubyopt = fn (u: unit) ->
  if map_has cli_opt "norubyopt" || map_has cli_opt "fatal" || map_has cli_opt "bad" then ()
  else
    (match cli_words (env_get "RUBYOPT") 0 "" with
     | Nil -> ()
     | Cons (w0, t0) ->
       let w1 = (if str_eq (char_at w0 0) "-" then w0 else "-" ++ w0) in
       let vk = gvar_slot "VERBOSE" in
       let vset = map_has globals vk in
       let vval = (if vset then map_get globals vk else VNil) in
       let stash = fn (k: str) -> (if map_has cli_opt k then (let v9 = map_get cli_opt k in let _ = map_delete cli_opt k in v9) else "") in
       let e9 = stash "enc_external" in
       let i9 = stash "enc_internal" in
       let s9 = stash "enc_source" in
       let _ = map_set cli_opt "in_rubyopt" "1" in
       let _ = take_flags (Cons (w1, t0)) in
       let _ = map_delete cli_opt "in_rubyopt" in
       let _ = (if vset then map_set globals vk vval else ()) in
       let _ = (if str_eq e9 "" then () else map_set cli_opt "enc_external" e9) in
       let _ = (if str_eq i9 "" then () else map_set cli_opt "enc_internal" i9) in
       if str_eq s9 "" then () else map_set cli_opt "enc_source" s9);

// `mere-ruby --parse-only FILE`: read and parse, run nothing. A parse error is
// the one failure that takes a WHOLE file with it, so it is worth being able
// to ask about it in isolation -- over a few thousand files, without executing
// any of them. Exit 0 = parsed, 1 = did not.
let parse_only = fn (path: str) ->
  let src = read_file path in
  let _ = map_set load_ctx "parsing" (mkstr path) in
  let toks = number_nls src (lex_src src) in
  let _ = parse_line_reset (count_nls toks) in
  let (prog, rest) = parse_stmts toks Nil in
  let _ = rx_check_pending () in
  match rest with
  | Cons (TEOF, _) -> 0
  | _ ->
    let _ = print_err ("mere-ruby: unexpected token at top level" ++ parsing_file ()) in 1;

// -x, and a first line that is a shebang for some OTHER interpreter (ruby's
// load_file: "not ruby script, assume -x flag"): the program starts at the
// first line that begins "#!" and mentions ruby. What is above it is not ruby
// -- a shell preamble, a mail header -- and is blanked byte for byte but its
// newlines, so the line numbers and DATA's offset are still the file's, as
// ruby's are. (false, _) is "no Ruby script found in input".
let rec cli_x_find = fn (src: str) -> fn (i: int) ->
  if i >= str_len src then 0 - 1
  else
    let e = line_end src i in
    if e - i >= 2 && str_eq (substring src i (i + 2)) "#!" && str_contains (substring src i e) "ruby" then i
    else cli_x_find src (e + 1);
let rec cli_blank = fn (src: str) -> fn (i: int) -> fn (n: int) -> fn (acc: str) ->
  if i >= n then acc
  else cli_blank src (i + 1) n (acc ++ (if str_eq (char_at src i) "\n" then "\n" else " "));
let cli_x_src = fn (src: str) ->
  let e0 = line_end src 0 in
  let other = str_len src >= 2 && str_eq (substring src 0 2) "#!"
              && (if str_contains (substring src 0 e0) "ruby" then false else true) in
  if map_has cli_opt "xflag" || other then
    (let off = cli_x_find src (if map_has cli_opt "xflag" then 0 else e0 + 1) in
     if off < 0 then (false, src)
     else if off == 0 then (true, src)
     else (true, cli_blank src 0 off "" ++ substring src off (str_len src)))
  else (true, src);

// -c: parse, say "Syntax OK", run nothing -- the same parse run_src makes, so
// the answer is about the program that would have run.
let cli_check = fn (src0: str) -> fn (name: str) ->
  let (src, _) = src_prepare src0 in
  let cod9 = src_coding src in
  let _ = map_set load_ctx "coding" (mkstr (if str_eq cod9 "" then "UTF-8" else cod9)) in
  let _ = map_set load_ctx "file" (mkstr name) in
  let ok9 = map_new () in
  let _ = try_or (fn (u: unit) ->
            let toks = number_nls src (lex_src src) in
            let _ = parse_line_reset (count_nls toks) in
            let (_, rest) = parse_stmts toks Nil in
            let _ = rx_check_pending () in
            (match rest with Cons (TEOF, _) -> map_set ok9 "y" 1 | _ -> ())) () in
  if map_has ok9 "y" then let _ = print "Syntax OK" in 0
  else let _ = print_err (cli_syntax_report name) in 1;

// The program as the command line names it, through -x, then -c or the run.
let cli_go = fn (src0: str) -> fn (name: str) -> fn (print_result: bool) ->
  let (found, src) = (if str_eq name "-e" then (true, src0) else cli_x_src src0) in
  if (if found then false else true) then
    let _ = print_err (name ++ ": no Ruby script found in input (LoadError)") in 1
  else if map_has cli_opt "check" then cli_check src name
  else let _ = run_src src print_result name in 0;

// -S: a script named without a directory is looked for in each directory of
// RUBYPATH and then of PATH, as ruby's dln_find_file does; the first regular
// file there is the program. Not found, the name is kept, and the missing
// file is the LoadError it would have been.
let rec cli_path_first = fn (dirs: str list) -> fn (nm: str) ->
  match dirs with
  | Nil -> ""
  | Cons (d, t) ->
    let p = (if str_eq d "" then nm else if str_eq (char_at d (str_len d - 1)) "/" then d ++ nm else d ++ "/" ++ nm) in
    if str_len d > 0 && file_exists p && (if dir_there p then false else true) then p else cli_path_first t nm;
let cli_path_find = fn (nm: str) ->
  if str_contains nm "/" then nm
  else
    (let f = cli_path_first (list_append_str (split_colon (env_get "RUBYPATH") 0 "" Nil) (split_colon (env_get "PATH") 0 "" Nil)) nm in
     if str_eq f "" then nm else f);

let run_cli = fn () ->
  let argl0 = take_flags (args ()) in
  let _ = cli_rubyopt () in
  // -s: the script's own leading switches are globals, not ARGV
  let sfl = fn (xs: str list) -> (if map_has cli_opt "sflag" then cli_sflag xs else xs) in
  // An unrecognised option is reported and nothing runs: continuing would run
  // a DIFFERENT program than the one that was asked for.
  if map_has cli_opt "bad" then
    let _ = print_err ("mere-ruby: invalid option " ++ map_get cli_opt "bad" ++ "  (-h will show valid options)") in 1
  // ...and so is a switch ruby refuses with a RuntimeError (a second
  // encoding for one slot, a -e in RUBYOPT, a -C to nowhere)
  else if map_has cli_opt "fatal" then
    let _ = print_err ("mere-ruby: " ++ map_get cli_opt "fatal" ++ " ("
                       ++ (if map_has cli_opt "fatal_cls" then map_get cli_opt "fatal_cls" else "RuntimeError") ++ ")") in 1
  else if map_has cli_opt "help" then let _ = print usage_line in 0
  else
  // -v prints before the program runs, like ruby's does.
  let _ = (if map_has cli_opt "ver" then print ruby_desc else ()) in
  if map_has cli_opt "eval" then
    // -e wins over a script path, and the remaining args are ARGV. __FILE__ is
    // "-e", which is what ruby reports.
    let _ = map_set cli_file "p" "-e" in
    let _ = map_set cli_argv "v" (arr_new (strs_to_vals (sfl argl0))) in
    cli_go (map_get cli_opt "eval") "-e" false
  else
  match argl0 with
  | Nil ->
    // Browser playground entry (mere v0.1.127 Wasm target): the wasm host
    // makes `read_file` of this sentinel return the editor's Ruby source, so
    // the page can drive mere-ruby without argv (args () is always [] on the
    // Wasm backend). On native the file does not exist, read_file fails, and
    // try_or falls back to "" -- so a bare `mere-ruby` still prints usage.
    let src = try_or (fn () -> read_file "@mere-ruby-playground@") "" in
    if str_eq src "" then
      // A bare `mere-ruby` reads its program from stdin, as ruby does -- but
      // only when stdin is NOT a terminal. read_stdin blocks until EOF, so a
      // person who types `mere-ruby` would sit at a silent prompt; the usage
      // line is kinder there. Redirected or piped, the program is on stdin,
      // and ruby/spec asks for exactly that (`ruby_exe(nil, args: "< file")`,
      // all of language/magic_comment_spec). -v alone still just prints.
      (if map_has cli_opt "ver" then 0
       else if fd_isatty 0 == 1 then let _ = print usage_line in 2
       else
         (let _ = map_set cli_file "p" "-" in
          let _ = map_set cli_argv "v" (arr_new (Nil : Val list)) in
          cli_go (read_stdin ()) "-" false))
    else let _ = run_src src false "(playground)" in 0
  | Cons (a00, rest) ->
    let a0 = (if map_has cli_opt "Sflag" then cli_path_find a00 else a00) in
    if str_eq a0 "--parse-only" then
      (match rest with
       | Cons (path, _) -> parse_only path
       | Nil -> let _ = print "usage: mere-ruby --parse-only <script.rb>" in 2)
    else if str_eq a0 "--eval-print" then
      (match rest with
       | Cons (path, rest2) -> let _ = map_set cli_file "p" path in let _ = map_set cli_argv "v" (arr_new (strs_to_vals rest2)) in let _ = run_prog path true in 0
       | Nil -> let _ = print "usage: mere-ruby --eval-print <script.rb>" in 2)
    // `-` reads the program from stdin, as it does for ruby.
    else if str_eq a0 "-" then
      let _ = map_set cli_file "p" "-" in
      let _ = map_set cli_argv "v" (arr_new (strs_to_vals (sfl rest))) in
      cli_go (read_stdin ()) "-" false
    // a script that is not there is ruby's LoadError, on stderr, exit 1 --
    // not an interpreter failure that printed the path back and nothing else
    else if (if file_exists a0 then false else true) then
      let _ = print_err ("mere-ruby: No such file or directory -- " ++ a0 ++ " (LoadError)") in 1
    else let _ = map_set cli_file "p" a0 in let _ = map_set cli_argv "v" (arr_new (strs_to_vals (sfl rest))) in cli_go (read_file a0) a0 false;
