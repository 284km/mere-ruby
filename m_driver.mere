// The driver: where an error is reported from (err_where), how a script is
// read and run (run_src), and the command line that chooses between them.
//
// A MODULE, spliced by `import` where these chains used to sit. `import`
// is an AST splice, not a separate scope: this file sees everything
// declared above the import point and nothing below it -- which is what
// these chains already had, since they are the last thing in the program.
// The main expression itself stays in main.mere, because that is what
// makes main.mere the program.
let err_where = fn (name: str) ->
  let f = (if map_has prim_missing "f" then (match map_get prim_missing "f" with VStr h -> sget h | _ -> "") else "") in
  let rf = (if map_has prim_missing "rf" then (match map_get prim_missing "rf" with VStr h -> sget h | _ -> "") else "") in
  let file = (if (if str_eq rf "" then false else true) then rf
              else if str_eq f "" || str_eq f name then name else f) in
  // ruby writes `file:line:in `meth\': message`, at the RAISE site
  let ln = (if map_has prim_missing "rl" then (match map_get prim_missing "rl" with VInt n -> n | _ -> cur_line ()) else cur_line ()) in
  let m = (if map_has prim_missing "rm" then (match map_get prim_missing "rm" with VStr h -> sget h | _ -> cur_meth ()) else cur_meth ()) in
  let where = (if ln > 0 then file ++ ":" ++ str_of_int ln else file) in
  if str_eq m "" then where else where ++ ":in '" ++ meth_label m ++ "'";

// ObjectSpace::WeakMap: a Hash that does not keep its keys alive. mere-ruby
// frees nothing, so the weakness has no observable effect here -- what matters
// is that the class EXISTS, because activesupport's DescendantsTracker builds
// one at load time and railties stops there otherwise.
let core_prelude_a =
  // ruby 4.0's toplevel `Ruby` module: the identity constants again, and
  // Ruby::Box, which is never enabled here (RUBY_BOX is a CRuby build switch).
  "module Ruby\n" ++
  "  VERSION = RUBY_VERSION\n" ++
  "  PATCHLEVEL = RUBY_PATCHLEVEL\n" ++
  "  RELEASE_DATE = RUBY_RELEASE_DATE\n" ++
  "  REVISION = RUBY_REVISION\n" ++
  "  ENGINE = RUBY_ENGINE\n" ++
  "  ENGINE_VERSION = RUBY_ENGINE_VERSION\n" ++
  "  PLATFORM = RUBY_PLATFORM\n" ++
  "  DESCRIPTION = RUBY_DESCRIPTION\n" ++
  "  COPYRIGHT = RUBY_COPYRIGHT\n" ++
  "  class Box\n" ++
  "    def self.enabled?; false; end\n" ++
  "    def self.current; nil; end\n" ++
  "  end\n" ++
  "end\n" ++
  // ruby 4.0: Pathname is core, so `Pathname(x)` -- and `Kernel.Pathname(x)`,
  // and `obj.send(:Pathname, x)` -- work before anything has required it. The
  // library is shipped behind an autoload (see autoloads "Pathname") and its
  // `module Kernel; def Pathname` REPLACES this stub when it loads, so the
  // stub only has to get it loaded and ask again.
  "module Kernel\n" ++
  "  def Pathname(path)\n" ++
  "    require \"pathname\"\n" ++
  "    Pathname(path)\n" ++
  "  end\n" ++
  "end\n" ++
  // A Numeric refuses to gain a singleton method, and it refuses BY DEFINING
  // THE HOOK -- which is why `class Sub < Numeric; def singleton_method_added(n); end; end`
  // (ruby/spec's own fixture, so that its methods can be mocked) makes it
  // allowed again, and `remove_method :singleton_method_added` makes it refuse
  // again. A rule written in the interpreter could not be removed by ruby code.
  // It is written in ruby, and not in the dispatcher, for the same reason; the
  // rest of Numeric's methods are the other way round (see invoke_val_c),
  // because those names have Integer and Float builtins that must keep winning
  // and this one has none.
  // The message quotes the method name, and the quote is built rather than
  // escaped: a `\"` here would have to survive both this string and ruby's lexer.
  "class Numeric\n" ++
  "  def singleton_method_added(name)\n" ++
  "    q = '\"'\n" ++
  "    raise TypeError, \"can't define singleton method \" + q + name.to_s + q + \" for \" + self.class.to_s\n" ++
  "  end\n" ++
  "end\n";

let core_prelude_b =
  // Enumerable, driven by the receiver's own #each rather than by a
  // materialised copy of it. Two things only this shape can do: a multi-value
  // yield reaches the block as SEVERAL arguments (so a one-parameter block
  // takes the first, as ruby's does), and a walk stops when the answer is
  // known -- `take_while` on a five-element receiver walks three.
  //
  // It is a module of its own rather than a reopening of Enumerable because
  // Array, Hash and Range include Enumerable too, and their own methods are
  // primitives that must keep answering. do_include puts this one BEHIND
  // Enumerable for a class that includes it, so a program that redefines
  // Enumerable#map still wins.
  "module Enumerable__Impl\n" ++
  "  def __gather(args)\n" ++
  "    args.size <= 1 ? args[0] : args\n" ++
  "  end\n" ++
  "\n" ++
  // An enumerator's size is what the METHOD that made it says, never a count
  // of a walk: ruby's enum_size asks the receiver's own #size (nil when it has
  // none), and find / take_while / ... answer nil because how far they walk
  // depends on the block. ⚠ Counting by walking gave `find.size` 4 on a
  // four-element receiver (22 spec files ask for nil), and on a receiver whose
  // #each never ends it did not come back.
  "  def __enum_size\n" ++
  "    respond_to?(:size) ? size : nil\n" ++
  "  end\n" ++
  // ruby's enum_cycle_size: nil or 0 as the receiver's size says, else
  // Infinity with no count, 0 for a count <= 0, and size * count otherwise.
  "  def __cycle_size(n)\n" ++
  "    sz = __enum_size\n" ++
  "    return sz if sz.nil? || sz == 0\n" ++
  "    return Float::INFINITY if n.nil?\n" ++
  "    n = __int!(n)\n" ++
  "    n <= 0 ? 0 : sz * n\n" ++
  "  end\n" ++
  "\n" ++
  // ruby converts a count with #to_int and refuses in its own words -- a
  // NoMethodError from a bare `n.to_int` names the wrong thing.
  "  def __int!(n)\n" ++
  "    return n if n.is_a?(Integer)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + n.class.to_s + \" into Integer\" unless n.respond_to?(:to_int)\n" ++
  "    v = n.to_int\n" ++
  "    raise TypeError, \"can't convert \" + n.class.to_s + \" to Integer (\" + n.class.to_s + \"#to_int gives \" + v.class.to_s + \")\" unless v.is_a?(Integer)\n" ++
  "    v\n" ++
  "  end\n" ++
  "\n" ++
  // the bounds ruby's own C signatures carry: a *-parameter here would accept
  // what ruby refuses, and ten spec files ask for exactly that refusal.
  "  def __arity!(given, lo, hi)\n" ++
  "    return if given >= lo && given <= hi\n" ++
  "    range = lo == hi ? lo.to_s : lo.to_s + \"..\" + hi.to_s\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + given.to_s + \", expected \" + range + \")\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def to_a(*outer)\n" ++
  "    acc = []\n" ++
  "    each(*outer) \{ |*args| acc.push(__gather(args)) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def entries(*outer); to_a(*outer); end\n" ++
  "\n" ++
  "  def map\n" ++
  "    return to_enum(:map) \{ __enum_size } unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| acc.push(yield(*args)) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def collect(&b); map(&b); end\n" ++
  "\n" ++
  "  def flat_map\n" ++
  "    return to_enum(:flat_map) \{ __enum_size } unless block_given?\n" ++
  "    acc = []\n" ++
  "    each do |*args|\n" ++
  "      v = yield(*args)\n" ++
  "      if v.respond_to?(:to_ary)\n" ++
  "        a = v.to_ary\n" ++
  // ⚠ a NIL conversion means "append it as it is" (ruby's
  //   rb_check_array_type), not a refusal -- only a non-Array, non-nil answer
  //   is the TypeError. Refusing nil here is what made `enum.flat_map { obj }`
  //   raise for an object whose #to_ary answers nil, while the same element in
  //   an ARRAY receiver went through the interpreter's own walk and was
  //   appended. One rule, two implementations, and this was the second one.
  "        raise TypeError, \"can't convert \" + v.class.to_s + \" to Array (\" + v.class.to_s + \"#to_ary gives \" + a.class.to_s + \")\" unless a.is_a?(Array) || a.nil?\n" ++
  "        if a.nil? then acc.push(v) else a.each \{ |x| acc.push(x) } end\n" ++
  "      else\n" ++
  "        acc.push(v)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def collect_concat(&b); flat_map(&b); end\n" ++
  "\n" ++
  "  def select\n" ++
  "    return to_enum(:select) \{ __enum_size } unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| v = __gather(args); acc.push(v) if yield(v) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def filter(&b); select(&b); end\n" ++
  "  def find_all(&b); select(&b); end\n" ++
  "\n" ++
  "  def reject\n" ++
  "    return to_enum(:reject) \{ __enum_size } unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| v = __gather(args); acc.push(v) unless yield(v) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def filter_map\n" ++
  "    return to_enum(:filter_map) \{ __enum_size } unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| v = yield(*args); acc.push(v) if v }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def find(ifnone = nil)\n" ++
  "    return to_enum(:find, ifnone) \{ nil } unless block_given?\n" ++
  "    each \{ |*args| v = __gather(args); return v if yield(v) }\n" ++
  "    ifnone ? ifnone.call : nil\n" ++
  "  end\n" ++
  "  def detect(ifnone = nil, &b); find(ifnone, &b); end\n" ++
  "\n" ++
  "  def find_index(*target)\n" ++
  "    __arity!(target.size, 0, 1)\n" ++
  "    i = 0\n" ++
  "    if target.size > 0\n" ++
  "      each \{ |*args| return i if __gather(args) == target[0]; i += 1 }\n" ++
  "    else\n" ++
  "      return to_enum(:find_index) \{ nil } unless block_given?\n" ++
  "      each \{ |*args| return i if yield(*args); i += 1 }\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def all?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| return false unless pattern[0] === __gather(args) }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| return false unless yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| return false unless __gather(args) }\n" ++
  "    end\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  def any?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| return true if pattern[0] === __gather(args) }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| return true if yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| return true if __gather(args) }\n" ++
  "    end\n" ++
  "    false\n" ++
  "  end\n" ++
  "\n" ++
  "  def none?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| return false if pattern[0] === __gather(args) }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| return false if yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| return false if __gather(args) }\n" ++
  "    end\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  def one?(*pattern)\n" ++
  "    __arity!(pattern.size, 0, 1)\n" ++
  "    n = 0\n" ++
  "    if pattern.size > 0\n" ++
  "      each \{ |*args| n += 1 if pattern[0] === __gather(args); return false if n > 1 }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| n += 1 if yield(*args); return false if n > 1 }\n" ++
  "    else\n" ++
  "      each \{ |*args| n += 1 if __gather(args); return false if n > 1 }\n" ++
  "    end\n" ++
  "    n == 1\n" ++
  "  end\n" ++
  "\n" ++
  "  def count(*item)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + item.size.to_s + \", expected 1)\" if item.size > 1\n" ++
  "    n = 0\n" ++
  "    if item.size > 0\n" ++
  "      each \{ |*args| n += 1 if __gather(args) == item[0] }\n" ++
  "    elsif block_given?\n" ++
  "      each \{ |*args| n += 1 if yield(*args) }\n" ++
  "    else\n" ++
  "      each \{ |*args| n += 1 }\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_with_index(*outer)\n" ++
  "    return to_enum(:each_with_index, *outer) \{ __enum_size } unless block_given?\n" ++
  "    i = 0\n" ++
  "    each(*outer) \{ |*args| yield(__gather(args), i); i += 1 }\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_with_object(memo)\n" ++
  "    return to_enum(:each_with_object, memo) \{ __enum_size } unless block_given?\n" ++
  "    each \{ |*args| yield(__gather(args), memo) }\n" ++
  "    memo\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_entry(*outer)\n" ++
  "    return to_enum(:each_entry, *outer) \{ __enum_size } unless block_given?\n" ++
  "    each(*outer) \{ |*args| yield(__gather(args)) }\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def take(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise RangeError, \"bignum too big to convert into 'long'\" if n > 4611686018427387903\n" ++
  "    raise ArgumentError, \"attempt to take negative size\" if n < 0\n" ++
  "    acc = []\n" ++
  "    return acc if n == 0\n" ++
  "    each \{ |*args| acc.push(__gather(args)); break if acc.size >= n }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def take_while\n" ++
  "    return to_enum(:take_while) \{ nil } unless block_given?\n" ++
  "    acc = []\n" ++
  "    each \{ |*args| break unless yield(*args); acc.push(__gather(args)) }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def drop(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise RangeError, \"bignum too big to convert into 'long'\" if n > 4611686018427387903\n" ++
  "    raise ArgumentError, \"attempt to drop negative size\" if n < 0\n" ++
  "    acc = []\n" ++
  "    i = 0\n" ++
  "    each \{ |*args| acc.push(__gather(args)) if i >= n; i += 1 }\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def drop_while\n" ++
  "    return to_enum(:drop_while) \{ nil } unless block_given?\n" ++
  "    acc = []\n" ++
  "    dropping = true\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      dropping = false if dropping && !yield(v)\n" ++
  "      acc.push(v) unless dropping\n" ++
  "    end\n" ++
  "    acc\n" ++
  "  end\n" ++
  "\n" ++
  "  def first(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    if n.size == 0\n" ++
  "      each \{ |*args| return __gather(args) }\n" ++
  "      nil\n" ++
  "    else\n" ++
  "      take(n[0])\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  // min_by / max_by / sort_by / group_by / partition PACK the yielded values
  // into one before the block sees them (MRI's rb_enum_values_pack); map,
  // select and all? pass them through as arguments. The two rules look the
  // same until #each yields more than one value.
  "  def min_by(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    return to_enum(:min_by, *n) \{ __enum_size } unless block_given?\n" ++
  "    return sort_by \{ |x| yield(x) }.first(__int!(n[0])) if n.size > 0 && !n[0].nil?\n" ++
  "    best = nil\n" ++
  "    best_key = nil\n" ++
  "    seen = false\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      k = yield(v)\n" ++
  "      if !seen || (k <=> best_key) < 0\n" ++
  "        best = v\n" ++
  "        best_key = k\n" ++
  "        seen = true\n" ++
  "      end\n" ++
  "    end\n" ++
  "    best\n" ++
  "  end\n" ++
  "\n" ++
  "  def max_by(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    return to_enum(:max_by, *n) \{ __enum_size } unless block_given?\n" ++
  "    return sort_by \{ |x| yield(x) }.reverse.first(__int!(n[0])) if n.size > 0 && !n[0].nil?\n" ++
  "    best = nil\n" ++
  "    best_key = nil\n" ++
  "    seen = false\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      k = yield(v)\n" ++
  "      if !seen || (k <=> best_key) > 0\n" ++
  "        best = v\n" ++
  "        best_key = k\n" ++
  "        seen = true\n" ++
  "      end\n" ++
  "    end\n" ++
  "    best\n" ++
  "  end\n" ++
  "\n" ++
  "  def minmax_by(&b)\n" ++
  "    return to_enum(:minmax_by) \{ __enum_size } unless block_given?\n" ++
  "    [min_by(&b), max_by(&b)]\n" ++
  "  end\n" ++
  "\n" ++
  "  def sort_by\n" ++
  "    return to_enum(:sort_by) \{ __enum_size } unless block_given?\n" ++
  "    pairs = []\n" ++
  "    each \{ |*args| v = __gather(args); pairs.push([yield(v), v]) }\n" ++
  "    pairs.sort \{ |a, b| a[0] <=> b[0] }.map \{ |p| p[1] }\n" ++
  "  end\n" ++
  "\n" ++
  "  def group_by\n" ++
  "    return to_enum(:group_by) \{ __enum_size } unless block_given?\n" ++
  "    h = \{}\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      (h[yield(v)] ||= []).push(v)\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def partition\n" ++
  "    return to_enum(:partition) \{ __enum_size } unless block_given?\n" ++
  "    yes = []\n" ++
  "    no = []\n" ++
  "    each \{ |*args| v = __gather(args); (yield(v) ? yes : no).push(v) }\n" ++
  "    [yes, no]\n" ++
  "  end\n" ++
  "\n" ++
  "  def inject(*init, &blk)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + init.size.to_s + \", expected 1..2)\" if init.size > 2\n" ++
  "    op = nil\n" ++
  "    memo = nil\n" ++
  "    have = false\n" ++
  "    if init.size == 2\n" ++
  "      memo = init[0]\n" ++
  "      have = true\n" ++
  "      op = init[1]\n" ++
  "    elsif init.size == 1 && !block_given?\n" ++
  "      op = init[0]\n" ++
  "    elsif init.size == 1\n" ++
  "      memo = init[0]\n" ++
  "      have = true\n" ++
  "    end\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      if !have\n" ++
  "        memo = v\n" ++
  "        have = true\n" ++
  "      elsif op\n" ++
  "        memo = memo.__send__(op, v)\n" ++
  "      else\n" ++
  "        memo = blk.call(memo, v)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    memo\n" ++
  "  end\n" ++
  "  def reduce(*init, &blk); inject(*init, &blk); end\n" ++
  "\n" ++
  "  def sum(*init)\n" ++
  "    __arity!(init.size, 0, 1)\n" ++
  "    memo = init.size > 0 ? init[0] : 0\n" ++
  "    if block_given?\n" ++
  "      each \{ |*args| memo = memo + yield(__gather(args)) }\n" ++
  "    else\n" ++
  "      each \{ |*args| memo = memo + __gather(args) }\n" ++
  "    end\n" ++
  "    memo\n" ++
  "  end\n" ++
  "\n" ++
  "  def tally(*into)\n" ++
  "    __arity!(into.size, 0, 1)\n" ++
  "    h = into.size > 0 ? into[0] : \{}\n" ++
  "    h = h.to_hash if into.size > 0 && !h.is_a?(Hash) && h.respond_to?(:to_hash)\n" ++
  "    # the hash's STORED counts start it, not its default; a frozen hash\n" ++
  "    # refuses before anything is counted; a count must be an Integer\n" ++
  "    raise FrozenError, \"can't modify frozen Hash: \" + h.inspect if h.frozen?\n" ++
  "    each do |*args|\n" ++
  "      v = __gather(args)\n" ++
  "      c = h.key?(v) ? h.fetch(v) : 0\n" ++
  "      raise TypeError, \"wrong argument type \" + c.class.to_s + \" (expected Integer)\" unless c.is_a?(Integer)\n" ++
  "      h[v] = c + 1\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def to_h(*outer)\n" ++
  "    h = \{}\n" ++
  "    each(*outer) do |*args|\n" ++
  "      pair = block_given? ? yield(*args) : __gather(args)\n" ++
  "      pair = pair.to_ary if !pair.is_a?(Array) && pair.respond_to?(:to_ary)\n" ++
  "      raise TypeError, \"wrong element type \" + pair.class.to_s + \" (expected array)\" unless pair.is_a?(Array)\n" ++
  "      raise ArgumentError, \"element has wrong array length (expected 2, was \" + pair.size.to_s + \")\" unless pair.size == 2\n" ++
  "      h[pair[0]] = pair[1]\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  def include?(target)\n" ++
  "    each \{ |*args| return true if __gather(args) == target }\n" ++
  "    false\n" ++
  "  end\n" ++
  "  def member?(target); include?(target); end\n" ++
  "\n" ++
  "  def cycle(*n)\n" ++
  "    __arity!(n.size, 0, 1)\n" ++
  "    return to_enum(:cycle, *n) \{ __cycle_size(n[0]) } unless block_given?\n" ++
  "    if n.size > 0 && !n[0].nil?\n" ++
  "      times = __int!(n[0])\n" ++
  "      return nil if times <= 0\n" ++
  "      buf = []\n" ++
  "      each \{ |*args| v = __gather(args); buf.push(v); yield v }\n" ++
  "      return nil if buf.empty?\n" ++
  "      (times - 1).times \{ buf.each \{ |v| yield v } }\n" ++
  "      nil\n" ++
  "    else\n" ++
  "      buf = []\n" ++
  "      each \{ |*args| v = __gather(args); buf.push(v); yield v }\n" ++
  "      return nil if buf.empty?\n" ++
  "      loop \{ buf.each \{ |v| yield v } }\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_slice(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise ArgumentError, \"invalid slice size\" if n < 1\n" ++
  "    return to_enum(:each_slice, n) \{ sz = __enum_size; sz.nil? || (sz.is_a?(Float) && sz.infinite?) ? sz : (sz + n - 1) / n } unless block_given?\n" ++
  "    buf = []\n" ++
  "    each do |*args|\n" ++
  "      buf.push(__gather(args))\n" ++
  "      if buf.size == n\n" ++
  "        yield buf\n" ++
  "        buf = []\n" ++
  "      end\n" ++
  "    end\n" ++
  "    yield buf unless buf.empty?\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_cons(n)\n" ++
  "    n = __int!(n)\n" ++
  "    raise ArgumentError, \"invalid size\" if n < 1\n" ++
  "    return to_enum(:each_cons, n) \{ sz = __enum_size; sz.nil? ? nil : [sz - n + 1, 0].max } unless block_given?\n" ++
  "    buf = []\n" ++
  "    each do |*args|\n" ++
  "      buf.push(__gather(args))\n" ++
  "      buf.shift if buf.size > n\n" ++
  "      yield buf.dup if buf.size == n\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def zip(*others)\n" ++
  "    lists = others.map do |o|\n" ++
  "      if o.is_a?(Array)\n" ++
  "        o\n" ++
  "      elsif o.respond_to?(:to_ary)\n" ++
  "        a = o.to_ary\n" ++
  "        raise TypeError, \"wrong argument type \" + o.class.to_s + \" (must respond to :each)\" unless a.is_a?(Array)\n" ++
  "        a\n" ++
  // ⚠ ruby converts through #to_enum(:each), not #to_a: an object that only
  //   CLAIMS #each (through respond_to_missing?) and answers to_enum was sent
  //   to_a and came back "undefined method 'to_a'". The `each` test stays --
  //   every object has Kernel#to_enum, so testing THAT would accept an object
  //   with nothing to walk (`zip(Object.new)` must stay a TypeError).
  "      elsif o.respond_to?(:each)\n" ++
  "        o.to_enum(:each).to_a\n" ++
  "      else\n" ++
  "        raise TypeError, \"wrong argument type \" + o.class.to_s + \" (must respond to :each)\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "    acc = []\n" ++
  "    i = 0\n" ++
  "    each do |*args|\n" ++
  "      row = [__gather(args)]\n" ++
  "      lists.each \{ |l| row.push(l[i]) }\n" ++
  "      i += 1\n" ++
  "      block_given? ? yield(row) : acc.push(row)\n" ++
  "    end\n" ++
  "    block_given? ? nil : acc\n" ++
  "  end\n" ++
  "end\n";

let core_prelude_c =
  // Ractor, sequentially: this interpreter has one thread of control (Thread
  // runs its block where it is created), so a Ractor keeps its block and runs
  // it when someone asks for the VALUE. A message sent before that is in the
  // mailbox by the time the body asks for it, which is the shape the tests
  // use; what this cannot model is two bodies running at once, and the pairs
  // that need that are recorded in KNOWN_GAPS.
  "class Ractor\n" ++
  "  class Error < StandardError; end\n" ++
  "  class RemoteError < Error\n" ++
  "    attr_reader :ractor\n" ++
  "    def initialize(msg = nil, ractor = nil, cause = nil)\n" ++
  "      @ractor = ractor\n" ++
  "      @__cause = cause\n" ++
  "      super(msg || \"thrown by remote Ractor.\")\n" ++
  "    end\n" ++
  "    def cause; @__cause; end\n" ++
  "  end\n" ++
  "  class ClosedError < Error; end\n" ++
  "  class IsolationError < Error; end\n" ++
  "  class MovedError < Error; end\n" ++
  "  class UnsafeError < Error; end\n" ++
  "\n" ++
  // A port is a queue with a closed flag. Reading an EMPTY one is what "wait
  // for the other side" means here, and the other side is a ractor nobody has
  // asked anything of yet -- so the read is the demand that runs it.
  "  class Port\n" ++
  "    def initialize; @q = []; @closed = false; end\n" ++
  "    def <<(v)\n" ++
  "      raise Ractor::ClosedError, \"The port was already closed\" if @closed\n" ++
  "      @q.push(v)\n" ++
  "      self\n" ++
  "    end\n" ++
  "    def send(v); self << v; end\n" ++
  "    def receive\n" ++
  "      Ractor.__run_pending if @q.empty?\n" ++
  "      if @q.empty?\n" ++
  "        raise Ractor::ClosedError, \"The port was already closed\" if @closed\n" ++
  "        raise Ractor::Error, \"No other ractor can write to this port: this interpreter runs ractors sequentially\"\n" ++
  "      end\n" ++
  "      @q.shift\n" ++
  "    end\n" ++
  "    def close; @closed = true; self; end\n" ++
  "    def closed?; @closed; end\n" ++
  "    def inspect; \"#<Ractor::Port>\"; end\n" ++
  "    def __empty?; @q.empty?; end\n" ++
  "  end\n" ++
  "\n" ++
  // `Ractor.allocate` is a refusal in ruby -- a Ractor is its block, and there
  // is nothing to allocate without one -- so the public name raises and the
  // class builds its instances through `__alloc`, a private door the
  // interpreter opens for this class alone.
  "  class << self\n" ++
  "    def allocate; raise TypeError, \"allocator undefined for Ractor\"; end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__seq\n" ++
  "    @__seq = (@__seq || 0) + 1\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.main\n" ++
  "    @__main ||= (m = __alloc; m.__init_main; m)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.current\n" ++
  "    @__cur || main\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.main?\n" ++
  "    current.equal?(main)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__with_current(r)\n" ++
  "    prev = @__cur\n" ++
  "    @__cur = r\n" ++
  "    begin\n" ++
  "      yield\n" ++
  "    ensure\n" ++
  "      @__cur = prev\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  // Every ractor made and not yet run waits here. Anything that would BLOCK in
  // a parallel ruby -- reading an empty port, selecting -- runs them instead:
  // that is the whole scheduler.
  "  def self.__pending; @__pending ||= []; end\n" ++
  "  def self.__run_pending\n" ++
  "    until __pending.empty?\n" ++
  "      r = __pending.shift\n" ++
  "      r.__run\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.count; 1; end\n" ++
  "  def self.receive; current.__take; end\n" ++
  "  def self.recv; current.__take; end\n" ++
  "  def self.receive_if(&b); current.__take; end\n" ++
  "  def self.shareable?(o); o.frozen?; end\n" ++
  "  def self.make_shareable(o); o.freeze; end\n" ++
  "  def self.shareable_proc(&b); b.freeze; end\n" ++
  "  def self.shareable_lambda(&b); b.freeze; end\n" ++
  "  def self.[](k); current[k]; end\n" ++
  "  def self.[]=(k, v); current[k] = v; end\n" ++
  "  def self.store_if_absent(k)\n" ++
  "    c = current\n" ++
  "    c.key?(k) ? c[k] : (c[k] = yield)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.new(*args, name: nil, &block)\n" ++
  "    raise ArgumentError, \"must be called with a block\" unless block\n" ++
  "    unless name.nil? || name.is_a?(String) || name.is_a?(Symbol)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + name.class.to_s + \" into String\"\n" ++
  "    end\n" ++
  "    r = __alloc\n" ++
  "    r.__init(args, name.nil? ? nil : name.to_s, block)\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  // Every ractor here runs SEQUENTIALLY, in the thread that asks for what it
  // produced: the block is kept and run on the first #value / #join / port
  // read, so a message sent before then is already in the mailbox when the
  // body asks for it. There is no parallelism and no interleaving.
  "  def __init(args, name, block)\n" ++
  "    @args = args\n" ++
  "    @name = name\n" ++
  "    @block = block\n" ++
  "    @port = Ractor::Port.new\n" ++
  "    @locals = \{}\n" ++
  "    @monitors = []\n" ++
  "    @done = false\n" ++
  "    @error = nil\n" ++
  "    @value = nil\n" ++
  "    @main = false\n" ++
  "    @id = Ractor.__seq\n" ++
  "    Ractor.__pending.push(self)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __init_main\n" ++
  "    @args = []\n" ++
  "    @name = nil\n" ++
  "    @block = nil\n" ++
  "    @port = Ractor::Port.new\n" ++
  "    @locals = \{}\n" ++
  "    @monitors = []\n" ++
  "    @done = true\n" ++
  "    @error = nil\n" ++
  "    @value = nil\n" ++
  "    @main = true\n" ++
  "    @id = 0\n" ++
  "  end\n" ++
  "\n" ++
  "  def name; @name; end\n" ++
  "  def default_port; @port; end\n" ++
  "  def inspect\n" ++
  "    \"#<Ractor:#\" + (@id + 1).to_s + (@name.nil? ? \"\" : \" \" + @name) +\n" ++
  "      ((@done && !@main) ? \" terminated\" : \" running\") + \">\"\n" ++
  "  end\n" ++
  "  def to_s; inspect; end\n" ++
  // a ractor cannot be copied: it IS its block, and both routes reach the
  // refused allocator.
  "  def dup; raise TypeError, \"allocator undefined for Ractor\"; end\n" ++
  "  def clone(freeze: nil); raise TypeError, \"allocator undefined for Ractor\"; end\n" ++
  "\n" ++
  // ractor-local storage.
  "  def [](k); @locals[k]; end\n" ++
  "  def []=(k, v); @locals[k] = v; end\n" ++
  "  def key?(k); @locals.key?(k); end\n" ++
  "\n" ++
  "  def send(v, move: false)\n" ++
  "    @port << v\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def <<(v); send(v); end\n" ++
  "\n" ++
  "  def close; @port.close; self; end\n" ++
  "\n" ++
  // a monitoring port is told `:exited` when the body finishes -- at once if it
  // already has.
  "  def monitor(port)\n" ++
  "    if @done\n" ++
  "      port << :exited\n" ++
  "    else\n" ++
  "      @monitors.push(port)\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def unmonitor(port)\n" ++
  "    @monitors.delete(port)\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __take\n" ++
  "    @port.receive\n" ++
  "  end\n" ++
  "\n" ++
  "  def __run\n" ++
  "    return if @done || @block.nil?\n" ++
  "    Ractor.__pending.delete(self)\n" ++
  "    @done = true\n" ++
  "    begin\n" ++
  "      @value = Ractor.__with_current(self) \{ @block.call(*@args) }\n" ++
  "    rescue Exception => e\n" ++
  "      @error = e\n" ++
  "    end\n" ++
  // a terminated ractor takes no more messages, which is how a program sees
  // that it finished.
  "    @port.close\n" ++
  "    @monitors.each \{ |p| p << :exited }\n" ++
  "    @monitors = []\n" ++
  "  end\n" ++
  "\n" ++
  "  def value\n" ++
  "    __run\n" ++
  "    if @error\n" ++
  "      raise Ractor::RemoteError.new(nil, self, @error)\n" ++
  "    end\n" ++
  "    @value\n" ++
  "  end\n" ++
  "\n" ++
  "  def join\n" ++
  "    value\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  // select answers the FIRST argument that has something: a port with a value
  // in it, or a ractor that has finished. Pending bodies run first, since in a
  // parallel ruby they would have been running all along.
  "  def self.select(*ractors)\n" ++
  "    raise ArgumentError, \"specify at least one ractor or `yield_value`\" if ractors.empty?\n" ++
  "    ractors.each do |r|\n" ++
  "      return [r, r.receive] if r.is_a?(Ractor::Port) && !r.__empty?\n" ++
  "    end\n" ++
  "    __run_pending\n" ++
  "    ractors.each do |r|\n" ++
  "      return [r, r.receive] if r.is_a?(Ractor::Port) && !r.__empty?\n" ++
  "    end\n" ++
  "    ractors.each do |r|\n" ++
  "      return [r, r.value] if r.is_a?(Ractor)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "end\n";

let core_prelude_d =
  // Encoding::Converter: the constant existed and nothing else did, so
  // `Encoding::Converter.new(src, dst)` built a bare object that answered no
  // method of its own. This is the part a caller reaches first -- the two
  // encodings, #inspect, and #convert through String#encode, which already
  // knows the conversions. The stream API (primitive_convert, putback,
  // last_error, primitive_errinfo, finish) and the path search are here too;
  // a broken sequence is found by the transcoders' own rules (__bad_seq) so
  // the errors carry ruby's bytes, stages and messages.
  "class Enumerator\n" ++
  "  # External iteration (#next, #peek, #feed) runs #each on a Fiber of its own\n" ++
  "  # and suspends it at every element: what a source yields is handed out one\n" ++
  "  # at a time, and what #feed gave is what that yield returns. The source is\n" ++
  "  # never run ahead -- an infinite one can be stepped, and a stateful one is\n" ++
  "  # driven exactly once. The dispatcher's next/peek arm resumes this.\n" ++
  "  def __ext_fiber\n" ++
  "    en = self\n" ++
  "    Fiber.new do\n" ++
  "      r = en.each \{ |*a| Fiber.yield(a) }\n" ++
  "      en.__ext_finish(r)\n" ++
  "    end\n" ++
  "  end\n" ++
  // The size of an enumerator a builtin method returned is what
  // that METHOD's size function says (rb_ary_cycle_size, enum_size, ...), not
  // a count of a walk. :__walk hands the question back to the dispatcher, which
  // counts the elements. ⚠ Counting ran the method: `a.keep_if.size` walked
  // keep_if with a block that answered nil and EMPTIED the array, and
  // `a.cycle.size` never came back (ruby says Infinity).
  // ruby's enum_size: the receiver's #size when it has one, else nil
  "  def __origin_size(r)\n" ++
  "    r.respond_to?(:size) ? r.size : nil\n" ++
  "  end\n" ++
  "  def __native_size(r, m, a)\n" ++
  "    case m\n" ++
  "    when \"find\", \"detect\", \"find_index\", \"index\", \"rindex\", \"rfind\", \"take_while\", \"drop_while\"\n" ++
  "      nil\n" ++
  // (a non-numeric Range's #step walks with + and <=>, and ruby will not
  // run it to count: range_step_size is nil unless the begin is a Numeric)
  "    when \"step\", \"%\"\n" ++
  "      Range === r && !(Numeric === r.begin) ? nil : :__walk\n" ++
  "    when \"cycle\"\n" ++
  "      sz = __origin_size(r)\n" ++
  "      return sz if sz.nil? || sz == 0\n" ++
  "      n = a[0]\n" ++
  "      return Float::INFINITY if n.nil?\n" ++
  "      n = Integer === n ? n : n.to_int\n" ++
  "      n <= 0 ? 0 : sz * n\n" ++
  "    when \"each_slice\"\n" ++
  "      sz = __origin_size(r)\n" ++
  "      n = a[0]\n" ++
  "      sz.nil? || (Float === sz && sz.infinite?) ? sz : (sz + n - 1) / n\n" ++
  "    when \"each_cons\"\n" ++
  "      sz = __origin_size(r)\n" ++
  "      sz.nil? ? nil : [sz - a[0] + 1, 0].max\n" ++
  "    when \"each\", \"each_index\", \"reverse_each\", \"map\", \"collect\", \"map!\", \"collect!\",\n" ++
  "         \"flat_map\", \"collect_concat\", \"filter_map\", \"select\", \"filter\", \"find_all\", \"select!\", \"filter!\",\n" ++
  "         \"keep_if\", \"reject\", \"reject!\", \"delete_if\", \"sort_by\", \"sort_by!\", \"min_by\", \"max_by\",\n" ++
  "         \"minmax_by\", \"group_by\", \"partition\", \"each_with_index\", \"each_with_object\", \"each_entry\",\n" ++
  "         \"each_pair\", \"each_key\", \"each_value\"\n" ++
  "      __origin_size(r)\n" ++
  "    else\n" ++
  "      :__walk\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def __ext_finish(r)\n" ++
  "    @__x_done = true\n" ++
  "    @__x_ret = r\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  # Enumerator.product lives here, not beside Enumerator::Product (which is\n" ++
  "  # autoloaded): it has to answer before anything has named the constant.\n" ++
  "  # With a block it walks the product and answers nil.\n" ++
  "  def self.product(*enums, **kw, &blk)\n" ++
  "    unless kw.empty?\n" ++
  "      ks = kw.keys.map(&:inspect).join(\", \")\n" ++
  "      raise ArgumentError, (kw.size == 1 ? \"unknown keyword: \" : \"unknown keywords: \") + ks\n" ++
  "    end\n" ++
  "    e = Enumerator::Product.new(*enums)\n" ++
  "    return e unless blk\n" ++
  "    e.each(&blk)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  # the three walks that stop early, for a generator (see the dispatcher):\n" ++
  "  # #each with a block that breaks as soon as the answer is known\n" ++
  "  def __gen_take_while(&b)\n" ++
  "    acc = []\n" ++
  "    each do |*a|\n" ++
  "      v = a.size == 1 ? a[0] : a\n" ++
  "      break unless b.call(v)\n" ++
  "      acc << v\n" ++
  "    end\n" ++
  "    acc\n" ++
  "  end\n" ++
  "  def __gen_find(&b)\n" ++
  "    r = nil\n" ++
  "    each do |*a|\n" ++
  "      v = a.size == 1 ? a[0] : a\n" ++
  "      if b.call(v)\n" ++
  "        r = v\n" ++
  "        break\n" ++
  "      end\n" ++
  "    end\n" ++
  "    r\n" ++
  "  end\n" ++
  "  def __gen_find_index(&b)\n" ++
  "    r = nil\n" ++
  "    i = 0\n" ++
  "    each do |*a|\n" ++
  "      v = a.size == 1 ? a[0] : a\n" ++
  "      if b.call(v)\n" ++
  "        r = i\n" ++
  "        break\n" ++
  "      end\n" ++
  "      i += 1\n" ++
  "    end\n" ++
  "    r\n" ++
  "  end\n" ++
  "  # Enumerator.produce(initial = none, size: Float::INFINITY) \{ |prev| next }:\n" ++
  "  # the initial value, then each block result from the one before; with no\n" ++
  "  # initial value the first element is the block's answer to nil. It ends\n" ++
  "  # only when the block raises StopIteration. An ordinary Enumerator.new, so\n" ++
  "  # #size, #take, #next and every Enumerable method are the usual ones --\n" ++
  "  # the dispatcher's special object for it had no #size that returned.\n" ++
  "  def self.produce(*args, size: Float::INFINITY, **kw, &blk)\n" ++
  "    raise ArgumentError, \"no block given\" unless blk\n" ++
  "    unless kw.empty?\n" ++
  "      ks = kw.keys.map(&:inspect).join(\", \")\n" ++
  "      raise ArgumentError, (kw.size == 1 ? \"unknown keyword: \" : \"unknown keywords: \") + ks\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0..1)\" if args.size > 1\n" ++
  "    seeded = !args.empty?\n" ++
  "    init = args[0]\n" ++
  "    Enumerator.new(size) do |y|\n" ++
  "      v = seeded ? init : blk.call(nil)\n" ++
  "      loop do\n" ++
  "        y << v\n" ++
  "        v = blk.call(v)\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "class Enumerator::Yielder\n" ++
  "  # the yielder as a block: `\"a\\nb\".each_line(&yielder)` yields each line\n" ++
  "  def to_proc\n" ++
  "    y = self\n" ++
  "    proc \{ |*args| y.yield(*args) }\n" ++
  "  end\n" ++
  "end\n" ++
  "class Encoding::Converter\n" ++
  "  INVALID_MASK = 15\n" ++
  "  INVALID_REPLACE = 2\n" ++
  "  UNDEF_MASK = 240\n" ++
  "  UNDEF_REPLACE = 32\n" ++
  "  UNDEF_HEX_CHARREF = 48\n" ++
  "  UNIVERSAL_NEWLINE_DECORATOR = 256\n" ++
  "  CRLF_NEWLINE_DECORATOR = 4096\n" ++
  "  CR_NEWLINE_DECORATOR = 8192\n" ++
  "  LF_NEWLINE_DECORATOR = 16384\n" ++
  "  XML_TEXT_DECORATOR = 32768\n" ++
  "  XML_ATTR_CONTENT_DECORATOR = 65536\n" ++
  "  PARTIAL_INPUT = 131072\n" ++
  "  AFTER_OUTPUT = 262144\n" ++
  "  XML_ATTR_QUOTE_DECORATOR = 1048576\n" ++
  "\n" ++
  "  # An encoding argument: an Encoding, or a name through #to_str. The name\n" ++
  "  # as given is kept for the \"code converter not found\" message.\n" ++
  "  def self.__enc(e)\n" ++
  "    return [e, e.name] if Encoding === e\n" ++
  "    s = String === e ? e : e.to_str\n" ++
  "    [(Encoding.find(s) rescue nil), s]\n" ++
  "  end\n" ++
  "\n" ++
  "  # The transcoding path, as ruby builds it: one step when either side is\n" ++
  "  # UTF-8, two through UTF-8 otherwise, three for ISO-2022-JP (it is\n" ++
  "  # stateful, reached through EUC-JP and its stateless form). A newline\n" ++
  "  # decorator is named at the end (universal_newline at the front).\n" ++
  "  def self.__path(src, dst, opts)\n" ++
  "    s, sn = __enc(src)\n" ++
  "    d, dn = __enc(dst)\n" ++
  "    nf = \"code converter not found (\" + (s ? s.name : sn) + \" to \" + (d ? d.name : dn) + \")\"\n" ++
  "    raise Encoding::ConverterNotFoundError, nf if s.nil? || d.nil? || s == d\n" ++
  "    raise Encoding::ConverterNotFoundError, nf if s.name == \"Emacs-Mule\" || d.name == \"Emacs-Mule\"\n" ++
  "    u = Encoding::UTF_8\n" ++
  "    pairs =\n" ++
  "      if d.name == \"ISO-2022-JP\"\n" ++
  "        e = Encoding::EUC_JP\n" ++
  "        st = Encoding.find(\"stateless-ISO-2022-JP\")\n" ++
  "        (s == u ? [] : [[s, u]]) + [[u, e], [e, st], [st, d]]\n" ++
  "      elsif s == u || d == u || (s.name == \"EUC-JP\" && d.name == \"Shift_JIS\") || (s.name == \"Shift_JIS\" && d.name == \"EUC-JP\")\n" ++
  "        [[s, d]]\n" ++
  "      else\n" ++
  "        [[s, u], [u, d]]\n" ++
  "      end\n" ++
  "    opts ||= \{}\n" ++
  "    pairs.unshift(\"universal_newline\") if opts[:universal_newline]\n" ++
  "    pairs << \"crlf_newline\" if opts[:crlf_newline]\n" ++
  "    pairs << \"cr_newline\" if opts[:cr_newline]\n" ++
  "    pairs\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.search_convpath(src, dst, **opts)\n" ++
  "    __path(src, dst, opts)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.asciicompat_encoding(enc)\n" ++
  "    e = Encoding === enc ? enc : (Encoding.find(String === enc ? enc : enc.to_str) rescue nil)\n" ++
  "    return nil if e.nil?\n" ++
  "    case e.name\n" ++
  "    when \"UTF-16BE\", \"UTF-16LE\", \"UTF-32BE\", \"UTF-32LE\", \"UTF-16\", \"UTF-32\" then Encoding::UTF_8\n" ++
  "    when \"ISO-2022-JP\" then Encoding.find(\"stateless-ISO-2022-JP\")\n" ++
  "    else nil\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def initialize(src, dst, opts = nil, **kw)\n" ++
  "    opts = kw if opts.nil? || Integer === opts\n" ++
  "    @convpath = Encoding::Converter.__path(src, dst, opts)\n" ++
  "    steps = @convpath.select \{ |x| Array === x }\n" ++
  "    @source_encoding = steps.first[0]\n" ++
  "    @destination_encoding = steps.last[1]\n" ++
  "    @invalid_replace = opts[:invalid] == :replace\n" ++
  "    @undef_replace = opts[:undef] == :replace\n" ++
  "    if opts.key?(:replace) && !opts[:replace].nil?\n" ++
  "      r = opts[:replace]\n" ++
  "      r = r.to_str unless String === r || !r.respond_to?(:to_str)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + (r.nil? ? \"nil\" : r.class.to_s) + \" into String\" unless String === r\n" ++
  "      @replacement = r\n" ++
  "    else\n" ++
  "      @replacement = __default_replacement\n" ++
  "    end\n" ++
  "    @__errinfo = [:source_buffer_empty, nil, nil, nil, nil]\n" ++
  "    @__last_error = nil\n" ++
  "    @__pending = \"\".b\n" ++
  "    @__putback = \"\".b\n" ++
  "    @__outbuf = \"\".b\n" ++
  "    @__finished = false\n" ++
  "  end\n" ++
  "  attr_reader :source_encoding, :destination_encoding, :replacement, :convpath\n" ++
  "\n" ++
  "  def __default_replacement\n" ++
  "    @destination_encoding.name.start_with?(\"UTF-\") ? \"�\" : \"?\".encode(\"US-ASCII\")\n" ++
  "  end\n" ++
  "\n" ++
  "  def replacement=(r)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + (r.nil? ? \"nil\" : r.class.to_s) + \" into String\" unless String === r\n" ++
  "    r.encode(@destination_encoding) unless r.ascii_only?\n" ++
  "    @replacement = r\n" ++
  "  end\n" ++
  "\n" ++
  "  def inspect\n" ++
  "    \"#<Encoding::Converter: \" + @source_encoding.name + \" to \" + @destination_encoding.name + \">\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def last_error = @__last_error\n" ++
  "  def primitive_errinfo = @__errinfo\n" ++
  "\n" ++
  "  def putback(n = nil)\n" ++
  "    b = @__putback\n" ++
  "    n = b.bytesize if n.nil? || n > b.bytesize\n" ++
  "    out = b.byteslice(b.bytesize - n, n)\n" ++
  "    @__putback = b.byteslice(0, b.bytesize - n)\n" ++
  "    out.force_encoding(@source_encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The first broken sequence in `bytes` read as `enc`: [offset, error\n" ++
  "  # bytes, bytes to read again, incomplete?], or nil. The rules are the\n" ++
  "  # transcoders': a lead byte and the continuations that fit are the error,\n" ++
  "  # the byte that did not fit is read again, and a sequence cut off by the\n" ++
  "  # end of the input is incomplete.\n" ++
  "  def self.__bad_seq(bytes, enc)\n" ++
  "    a = bytes.bytes\n" ++
  "    n = a.size\n" ++
  "    i = 0\n" ++
  "    name = String === enc ? enc : enc.name\n" ++
  "    if name == \"UTF-8\"\n" ++
  "      while i < n\n" ++
  "        b = a[i]\n" ++
  "        if b < 0x80 then i += 1; next end\n" ++
  "        need, lo, hi =\n" ++
  "          if b >= 0xC2 && b <= 0xDF then [1, 0x80, 0xBF]\n" ++
  "          elsif b == 0xE0 then [2, 0xA0, 0xBF]\n" ++
  "          elsif b == 0xED then [2, 0x80, 0x9F]\n" ++
  "          elsif b >= 0xE1 && b <= 0xEF then [2, 0x80, 0xBF]\n" ++
  "          elsif b == 0xF0 then [3, 0x90, 0xBF]\n" ++
  "          elsif b >= 0xF1 && b <= 0xF3 then [3, 0x80, 0xBF]\n" ++
  "          elsif b == 0xF4 then [3, 0x80, 0x8F]\n" ++
  "          else [0, 0, 0]\n" ++
  "          end\n" ++
  "        return [i, bytes.byteslice(i, 1), \"\".b, false] if need == 0\n" ++
  "        k = 1\n" ++
  "        while k <= need\n" ++
  "          return [i, bytes.byteslice(i, k), \"\".b, true] if i + k >= n\n" ++
  "          c = a[i + k]\n" ++
  "          ok = k == 1 ? (c >= lo && c <= hi) : (c >= 0x80 && c <= 0xBF)\n" ++
  "          return [i, bytes.byteslice(i, k), bytes.byteslice(i + k, 1), false] unless ok\n" ++
  "          k += 1\n" ++
  "        end\n" ++
  "        i += need + 1\n" ++
  "      end\n" ++
  "    elsif name == \"US-ASCII\"\n" ++
  "      while i < n\n" ++
  "        return [i, bytes.byteslice(i, 1), \"\".b, false] if a[i] >= 0x80\n" ++
  "        i += 1\n" ++
  "      end\n" ++
  "    elsif name == \"EUC-JP\"\n" ++
  "      while i < n\n" ++
  "        b = a[i]\n" ++
  "        if b < 0x80 then i += 1; next end\n" ++
  "        rng = b == 0x8E ? [0xA1, 0xDF] : ((b >= 0xA1 && b <= 0xFE) || b == 0x8F ? [0xA1, 0xFE] : nil)\n" ++
  "        return [i, bytes.byteslice(i, 1), \"\".b, false] if rng.nil?\n" ++
  "        need = b == 0x8F ? 2 : 1\n" ++
  "        k = 1\n" ++
  "        while k <= need\n" ++
  "          return [i, bytes.byteslice(i, k), \"\".b, true] if i + k >= n\n" ++
  "          c = a[i + k]\n" ++
  "          return [i, bytes.byteslice(i, k), bytes.byteslice(i + k, 1), false] unless c >= rng[0] && c <= rng[1]\n" ++
  "          rng = [0xA1, 0xFE]\n" ++
  "          k += 1\n" ++
  "        end\n" ++
  "        i += need + 1\n" ++
  "      end\n" ++
  "    elsif name == \"UTF-16LE\" || name == \"UTF-16BE\"\n" ++
  "      le = name == \"UTF-16LE\"\n" ++
  "      while i < n\n" ++
  "        return [i, bytes.byteslice(i, n - i), \"\".b, true] if i + 1 >= n\n" ++
  "        u = le ? a[i] | (a[i + 1] << 8) : (a[i] << 8) | a[i + 1]\n" ++
  "        if u >= 0xD800 && u <= 0xDBFF\n" ++
  "          return [i, bytes.byteslice(i, 2), \"\".b, true] if i + 3 >= n\n" ++
  "          v = le ? a[i + 2] | (a[i + 3] << 8) : (a[i + 2] << 8) | a[i + 3]\n" ++
  "          return [i, bytes.byteslice(i, 2), bytes.byteslice(i + 2, 2), false] unless v >= 0xDC00 && v <= 0xDFFF\n" ++
  "          i += 4\n" ++
  "        elsif u >= 0xDC00 && u <= 0xDFFF\n" ++
  "          return [i, bytes.byteslice(i, 2), \"\".b, false]\n" ++
  "        else\n" ++
  "          i += 2\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__dump(b)\n" ++
  "    s = +\"\"\n" ++
  "    b.each_byte \{ |c| s << (c >= 0x20 && c < 0x7F && c != 0x22 && c != 0x5C ? c.chr : format(\"\\\\x%02X\", c)) }\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  # The exception for a broken sequence, and what #primitive_errinfo says\n" ++
  "  # about it. `sn` is the source; `dn` the destination of the FIRST step,\n" ++
  "  # which is where a broken sequence is found.\n" ++
  "  def self.__invalid_exc(bad, sn, dn)\n" ++
  "    _, err, again, incomplete = bad\n" ++
  "    msg = if incomplete\n" ++
  "            \"incomplete \\\"\" + __dump(err) + \"\\\" on \" + sn\n" ++
  "          elsif again.empty?\n" ++
  "            \"\\\"\" + __dump(err) + \"\\\" on \" + sn\n" ++
  "          else\n" ++
  "            \"\\\"\" + __dump(err) + \"\\\" followed by \\\"\" + __dump(again) + \"\\\" on \" + sn\n" ++
  "          end\n" ++
  "    e = Encoding::InvalidByteSequenceError.new(msg)\n" ++
  "    \{ :@source_encoding_name => sn, :@destination_encoding_name => dn, :@error_bytes => err.b,\n" ++
  "      :@readagain_bytes => (again.empty? ? nil : again.b), :@incomplete_input => incomplete }.each \{ |k, v| e.instance_variable_set(k, v) }\n" ++
  "    [e, [incomplete ? :incomplete_input : :invalid_byte_sequence, sn, dn, err.b, again.b]]\n" ++
  "  end\n" ++
  "\n" ++
  "  # String#encode's refusal of a broken sequence, raised here so it carries\n" ++
  "  # the same bytes, stage and message as a converter's. Returns nil when the\n" ++
  "  # sequence is broken in a way these rules do not know.\n" ++
  "  def self.__raise_invalid(bytes, from, to)\n" ++
  "    s = Encoding.find(from)\n" ++
  "    d = Encoding.find(to)\n" ++
  "    bad = __bad_seq(bytes, s)\n" ++
  "    return nil unless bad\n" ++
  "    steps = (__path(s, d, nil) rescue [[s, d]]).select \{ |x| Array === x }\n" ++
  "    raise __invalid_exc(bad, s.name, steps.first[1].name)[0]\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ivs(e, h)\n" ++
  "    h.each \{ |k, v| e.instance_variable_set(k, v) }\n" ++
  "    e\n" ++
  "  end\n" ++
  "\n" ++
  "  def __invalid_error(bad)\n" ++
  "    Encoding::Converter.__invalid_exc(bad, @source_encoding.name, @convpath.find \{ |x| Array === x }[1].name)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The error for a character the destination cannot hold. From UTF-8 it\n" ++
  "  # names the code point; into UTF-8 it shows the bytes; between two other\n" ++
  "  # encodings it is raised by the SECOND step, from UTF-8, and its message\n" ++
  "  # names the whole path.\n" ++
  "  def __undef_error(ch)\n" ++
  "    steps = @convpath.select \{ |x| Array === x }\n" ++
  "    u = Encoding::UTF_8\n" ++
  "    if @source_encoding == u\n" ++
  "      msg = format(\"U+%04X\", ch.ord) + \" from UTF-8 to \" + @destination_encoding.name\n" ++
  "      sn, dn = \"UTF-8\", steps.first[1].name\n" ++
  "    elsif @destination_encoding == u || steps.size == 1\n" ++
  "      msg = \"\\\"\" + Encoding::Converter.__dump(ch.b) + \"\\\" from \" + @source_encoding.name + \" to \" + steps.first[1].name\n" ++
  "      sn, dn = @source_encoding.name, steps.first[1].name\n" ++
  "    elsif (cu = (ch.encode(u) rescue nil)).nil?\n" ++
  "      msg = \"\\\"\" + Encoding::Converter.__dump(ch.b) + \"\\\" to UTF-8 in conversion from \" +\n" ++
  "            steps.map \{ |x| x[0].name }.join(\" to \") + \" to \" + @destination_encoding.name\n" ++
  "      sn, dn = @source_encoding.name, \"UTF-8\"\n" ++
  "    else\n" ++
  "      ch = cu\n" ++
  "      msg = format(\"U+%04X\", ch.ord) + \" to \" + @destination_encoding.name + \" in conversion from \" +\n" ++
  "            steps.map \{ |x| x[0].name }.join(\" to \") + \" to \" + @destination_encoding.name\n" ++
  "      sn, dn = \"UTF-8\", steps[1][1].name\n" ++
  "    end\n" ++
  "    e = __ivs(Encoding::UndefinedConversionError.new(msg),\n" ++
  "              :@source_encoding_name => sn, :@destination_encoding_name => dn, :@error_char => ch)\n" ++
  "    [e, [:undefined_conversion, sn, dn, ch.b, \"\".b]]\n" ++
  "  end\n" ++
  "\n" ++
  "  # Converts what it can of `bytes`: [output, status, rest, error, errinfo,\n" ++
  "  # read-again bytes].\n" ++
  "  def __step(bytes, partial)\n" ++
  "    bad = Encoding::Converter.__bad_seq(bytes, @source_encoding)\n" ++
  "    bad = nil if bad && @invalid_replace && !bad[3]\n" ++
  "    upto = bad ? bad[0] : bytes.bytesize\n" ++
  "    good = bytes.byteslice(0, upto).force_encoding(@source_encoding)\n" ++
  "    out = \"\".b\n" ++
  "    off = 0\n" ++
  "    good.each_char do |c|\n" ++
  "      begin\n" ++
  "        out << if @destination_encoding.name == \"UTF8-MAC\"\n" ++
  "                 # the Mac's decomposed UTF-8\n" ++
  "                 c.encode(Encoding::UTF_8, @source_encoding).unicode_normalize(:nfd).b\n" ++
  "               else\n" ++
  "                 c.encode(@destination_encoding, @source_encoding, invalid: (@invalid_replace ? :replace : nil),\n" ++
  "                          undef: (@undef_replace ? :replace : nil), replace: @replacement).b\n" ++
  "               end\n" ++
  "      # a character this interpreter cannot decode (a Shift_JIS kanji: there\n" ++
  "      # is no table) is structurally valid -- __bad_seq passed it -- so it is\n" ++
  "      # a character the destination does not have, as ruby reports it\n" ++
  "      rescue Encoding::UndefinedConversionError, Encoding::InvalidByteSequenceError\n" ++
  "        e, info = __undef_error(c)\n" ++
  "        return [out, :undefined_conversion, bytes.byteslice(off + c.bytesize, bytes.bytesize), e, info, \"\".b]\n" ++
  "      end\n" ++
  "      off += c.bytesize\n" ++
  "    end\n" ++
  "    return [out, :finished, \"\".b, nil, [:finished, nil, nil, nil, nil], \"\".b] unless bad\n" ++
  "    if bad[3] && partial\n" ++
  "      return [out, :source_buffer_empty, bytes.byteslice(bad[0], bytes.bytesize), nil, [:source_buffer_empty, nil, nil, nil, nil], \"\".b]\n" ++
  "    end\n" ++
  "    e, info = __invalid_error(bad)\n" ++
  "    [out, info[0], bytes.byteslice(bad[0] + bad[1].bytesize + bad[2].bytesize, bytes.bytesize), e, info, bad[2].b]\n" ++
  "  end\n" ++
  "\n" ++
  "  def convert(str)\n" ++
  "    raise ArgumentError, \"converter already finished\" if @__finished\n" ++
  "    bytes = @__pending + str.b\n" ++
  "    @__pending = \"\".b\n" ++
  "    out, status, rest, err, info, _again = __step(bytes, true)\n" ++
  "    if err\n" ++
  "      @__last_error = err\n" ++
  "      @__errinfo = info\n" ++
  "      raise err\n" ++
  "    end\n" ++
  "    @__pending = rest || \"\".b\n" ++
  "    @__last_error = nil\n" ++
  "    @__errinfo = [:source_buffer_empty, nil, nil, nil, nil]\n" ++
  "    out.force_encoding(@destination_encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  def finish\n" ++
  "    @__finished = true\n" ++
  "    unless @__pending.empty?\n" ++
  "      bad = Encoding::Converter.__bad_seq(@__pending, @source_encoding)\n" ++
  "      @__pending = \"\".b\n" ++
  "      if bad\n" ++
  "        e, info = __invalid_error(bad)\n" ++
  "        @__last_error = e\n" ++
  "        @__errinfo = info\n" ++
  "        raise e\n" ++
  "      end\n" ++
  "    end\n" ++
  "    (+\"\").force_encoding(@destination_encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  # One step of the stream. What was read again after an error is read\n" ++
  "  # first (unless #putback took it), then what a partial call held back.\n" ++
  "  # Output beyond dst_size waits in the converter for the next call; the\n" ++
  "  # source is consumed either way.\n" ++
  "  def primitive_convert(src, dst, dst_start = nil, dst_size = nil, opts = nil, **kw)\n" ++
  "    opts = kw if opts.nil?\n" ++
  "    partial = Integer === opts ? (opts & PARTIAL_INPUT) != 0 : opts[:partial_input]\n" ++
  "    raise FrozenError, \"can't modify frozen String: \" + src.inspect if src && src.frozen?\n" ++
  "    raise FrozenError, \"can't modify frozen String: \" + dst.inspect if dst.frozen?\n" ++
  "    dst_start = dst_start.to_int unless dst_start.nil? || Integer === dst_start\n" ++
  "    dst_size = dst_size.to_int unless dst_size.nil? || Integer === dst_size\n" ++
  "    raise ArgumentError, \"destination byte offset is greater than the destination buffer\" if dst_start && dst_start > dst.bytesize\n" ++
  "    input = @__putback + @__pending + (src ? src.b : \"\".b)\n" ++
  "    @__putback = \"\".b\n" ++
  "    @__pending = \"\".b\n" ++
  "    out, status, rest, err, info, again = __step(input, partial)\n" ++
  "    if status == :source_buffer_empty\n" ++
  "      @__pending = rest\n" ++
  "      rest = \"\".b\n" ++
  "    end\n" ++
  "    out = @__outbuf + out\n" ++
  "    @__outbuf = \"\".b\n" ++
  "    if dst_size && out.bytesize > dst_size\n" ++
  "      @__outbuf = out.byteslice(dst_size, out.bytesize)\n" ++
  "      out = out.byteslice(0, dst_size)\n" ++
  "      status = :destination_buffer_full\n" ++
  "      err = nil\n" ++
  "      info = [:destination_buffer_full, nil, nil, nil, nil]\n" ++
  "    end\n" ++
  "    head = dst_start ? dst.b.byteslice(0, dst_start) : dst.b\n" ++
  "    dst.replace((head + out).force_encoding(@destination_encoding))\n" ++
  "    src.replace(rest.force_encoding(src.encoding)) if src\n" ++
  "    @__putback = again\n" ++
  "    @__last_error = err\n" ++
  "    @__errinfo = info\n" ++
  "    status\n" ++
  "  end\n" ++
  "end\n" ++
  // The thread queues and the condition variable define #marshal_dump only to
  // refuse -- `cv.marshal_dump` is a TypeError, not a missing method.
  "class ConditionVariable\n" ++
  "  def marshal_dump; raise TypeError, \"can't dump Thread::ConditionVariable\"; end\n" ++
  "end\n" ++
  "class Queue\n" ++
  "  def marshal_dump; raise TypeError, \"can't dump \" + (self.class == Queue ? \"Thread::Queue\" : self.class.to_s); end\n" ++
  "end\n" ++
  "class Encoding::UndefinedConversionError\n" ++
  "  def source_encoding_name; @source_encoding_name; end\n" ++
  "  def destination_encoding_name; @destination_encoding_name; end\n" ++
  "  def source_encoding; @source_encoding_name && Encoding.find(@source_encoding_name); end\n" ++
  "  def destination_encoding; @destination_encoding_name && Encoding.find(@destination_encoding_name); end\n" ++
  "  def error_char; @error_char; end\n" ++
  "end\n" ++
  "class Encoding::InvalidByteSequenceError\n" ++
  "  def source_encoding_name; @source_encoding_name; end\n" ++
  "  def destination_encoding_name; @destination_encoding_name; end\n" ++
  "  def source_encoding; @source_encoding_name && Encoding.find(@source_encoding_name); end\n" ++
  "  def destination_encoding; @destination_encoding_name && Encoding.find(@destination_encoding_name); end\n" ++
  "  def error_bytes; @error_bytes; end\n" ++
  "  def readagain_bytes; @readagain_bytes; end\n" ++
  "  def incomplete_input?; @incomplete_input; end\n" ++
  "end\n" ++
  "module ObjectSpace\n" ++
  "  # Finalizers. There is no hook from this collector into Ruby code, so\n" ++
  "  # one never runs when its object is collected; what ruby ALSO does --\n" ++
  "  # run every finalizer still registered when the process exits, with the\n" ++
  "  # object's id -- is done here, from at_exit. undefine_finalizer takes\n" ++
  "  # them back, and both refuse a frozen object as ruby does.\n" ++
  "  @__fin = Hash.new\n" ++
  "  def self.__fin_frozen(obj)\n" ++
  "    raise FrozenError, \"can't modify frozen \" + obj.class.to_s + \": \" + obj.inspect if obj.frozen?\n" ++
  "  end\n" ++
  "  def self.define_finalizer(obj, callable = nil, &blk)\n" ++
  "    callable ||= blk\n" ++
  "    unless callable.respond_to?(:call)\n" ++
  "      raise ArgumentError, \"wrong type argument \" + callable.class.to_s + \" (should be callable)\"\n" ++
  "    end\n" ++
  "    # an immediate is never collected, so it cannot have one (asked before\n" ++
  "    # the frozen check, as ruby does: a Symbol is both)\n" ++
  "    if ::NilClass === obj || ::TrueClass === obj || ::FalseClass === obj || ::Integer === obj || ::Float === obj || ::Symbol === obj\n" ++
  "      raise ArgumentError, \"cannot define finalizer for \" + obj.class.to_s\n" ++
  "    end\n" ++
  "    __fin_frozen(obj)\n" ++
  "    # a finalizer whose receiver IS the object keeps it alive for ever\n" ++
  "    rcv = if ::Method === callable then callable.receiver\n" ++
  "          elsif ::Proc === callable then (callable.binding.receiver rescue nil)\n" ++
  "          end\n" ++
  "    warn(\"finalizer references object to be finalized\", uplevel: 1) if rcv.equal?(obj)\n" ++
  "    unless @__fin_hooked\n" ++
  "      @__fin_hooked = true\n" ++
  "      at_exit do\n" ++
  "        ObjectSpace.__run_finalizers\n" ++
  "      end\n" ++
  "    end\n" ++
  "    # the same finalizer (by ==, so a dup of a proc too) is kept once, and\n" ++
  "    # the one kept is what a second definition answers\n" ++
  "    list = (@__fin[obj.object_id] ||= [])\n" ++
  "    same = list.find \{ |c| c == callable }\n" ++
  "    return [0, same] if same\n" ++
  "    list << callable\n" ++
  "    [0, callable]\n" ++
  "  end\n" ++
  "  def self.undefine_finalizer(obj)\n" ++
  "    __fin_frozen(obj)\n" ++
  "    @__fin.delete(obj.object_id)\n" ++
  "    obj\n" ++
  "  end\n" ++
  "  # one at a time until none is left: a finalizer may define another (it\n" ++
  "  # runs too), may call exit (the rest still run), and may raise (reported\n" ++
  "  # unless $VERBOSE is nil, and the rest still run)\n" ++
  "  # deprecated in ruby 4.0 (and says so where deprecations are shown). The\n" ++
  "  # immediates are computed from the id; anything else is looked for among\n" ++
  "  # the live objects each_object walks.\n" ++
  "  def self._id2ref(id)\n" ++
  "    warn(\"ObjectSpace._id2ref is deprecated\", uplevel: 1, category: :deprecated)\n" ++
  "    id = Integer(id)\n" ++
  "    return nil if id == nil.object_id\n" ++
  "    return true if id == true.object_id\n" ++
  "    return false if id == false.object_id\n" ++
  "    return (id - 1) / 2 if id.odd? && id.abs < 2**48\n" ++
  "    objs, classes = ObjectSpace.__objects(nil)\n" ++
  "    (objs + classes).each \{ |o| return o if o.object_id == id }\n" ++
  "    raise RangeError, id.to_s.inspect + \" is not an id value\"\n" ++
  "  end\n" ++
  "  def self.__run_finalizers\n" ++
  "    until @__fin.empty?\n" ++
  "      id, cs = @__fin.shift\n" ++
  "      cs.each do |c|\n" ++
  "        begin\n" ++
  "          c.call(id)\n" ++
  "        rescue SystemExit\n" ++
  "        rescue Exception => e\n" ++
  "          unless $VERBOSE.nil?\n" ++
  "            $stderr.puts \"warning: Exception in finalizer \" + c.inspect\n" ++
  "            $stderr.puts e.message + \" (\" + e.class.to_s + \")\"\n" ++
  "          end\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "  # each_object(mod = nil) \{ |obj| }: every live object that is a `mod`\n" ++
  "  # (every object, for nil) -- classes and modules included, as ruby's are\n" ++
  "  # -- and the count. Without a block, an Enumerator whose #each answers it.\n" ++
  "  def self.each_object(mod = nil, &blk)\n" ++
  "    return to_enum(:each_object, mod) unless blk\n" ++
  "    if !mod.nil? && !mod.is_a?(Module)\n" ++
  "      raise TypeError, \"class or module required\"\n" ++
  "    end\n" ++
  "    objs, classes = ObjectSpace.__objects(mod)\n" ++
  "    n = 0\n" ++
  "    objs.each do |o|\n" ++
  "      n += 1\n" ++
  "      blk.call(o)\n" ++
  "    end\n" ++
  "    classes.each do |c|\n" ++
  "      next unless mod.nil? || c.kind_of?(mod)\n" ++
  "      n += 1\n" ++
  "      blk.call(c)\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "  # a full collection here is GC.start's, and answers nil as ruby's does\n" ++
  "  def self.garbage_collect(full_mark: true, immediate_sweep: true)\n" ++
  "    GC.start\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  class WeakMap\n" ++
  "    include Enumerable\n" ++
  // (no braces in this source: a `{` in a Mere string starts an interpolation)
  // WeakMap matches keys by IDENTITY (two equal Strings are two keys);
  // WeakKeyMap below by equality, and its #getkey answers the STORED key.
  "    def initialize; @h = Hash.new.compare_by_identity; end\n" ++
  "    def [](k); @h[k]; end\n" ++
  "    def []=(k, v); @h[k] = v; v; end\n" ++
  "    def key?(k); @h.key?(k); end\n" ++
  "    def include?(k); @h.key?(k); end\n" ++
  "    def member?(k); @h.key?(k); end\n" ++
  "    def delete(k, &b); @h.key?(k) ? @h.delete(k) : (b ? b.call(k) : nil); end\n" ++
  "    def size; @h.size; end\n" ++
  "    def length; @h.size; end\n" ++
  "    def keys; @h.keys; end\n" ++
  "    def values; @h.values; end\n" ++
  // the iterators want a block -- they make no Enumerator -- except over an
  // empty map, where ruby never gets as far as yielding
  "    def __blk!(b); raise LocalJumpError, 'no block given' if b.nil? && !@h.empty?; end\n" ++
  "    def each(&b); __blk!(b); @h.each(&b) unless @h.empty?; self; end\n" ++
  "    def each_pair(&b); __blk!(b); @h.each(&b) unless @h.empty?; self; end\n" ++
  "    def each_key(&b); __blk!(b); @h.each_key(&b) unless @h.empty?; self; end\n" ++
  "    def each_value(&b); __blk!(b); @h.each_value(&b) unless @h.empty?; self; end\n" ++
  // (no #{} in this source: Mere interpolates its own strings the same way)
  // ruby shows the map's address and then each pair
  "    def inspect\n" ++
  "      head = '#<ObjectSpace::WeakMap:0x' + object_id.to_s(16).rjust(16, '0')\n" ++
  "      return head + '>' if @h.empty?\n" ++
  // ...and an entry WITHOUT Kernel (a BasicObject) has no #inspect to ask:
  // it prints the way ruby's any_to_s does, through Kernel#to_s bound to it
  "      ins = lambda \{ |o| ::Kernel === o ? o.inspect : ::Kernel.instance_method(:to_s).bind_call(o) }\n" ++
  "      head + ': ' + @h.map \{ |k, v| ins.call(k) + ' => ' + ins.call(v) }.join(', ') + '>'\n" ++
  "    end\n" ++
  "  end\n" ++
  "  class WeakKeyMap < WeakMap\n" ++
  // ...and the stored key is the OBJECT given, not the copy a Hash makes of an
  // unfrozen String key, so the originals are kept beside the table.
  "    def initialize; @h = Hash.new; @ks = []; end\n" ++
  // an immediate cannot be collected, so it cannot be a weak key; and the key
  // is hashed, so one without #hash (a BasicObject) is refused by that call
  "    def []=(k, v)\n" ++
  "      if ::NilClass === k || ::TrueClass === k || ::FalseClass === k || ::Integer === k || ::Float === k || ::Symbol === k\n" ++
  "        raise ArgumentError, 'WeakKeyMap keys must be garbage collectable'\n" ++
  "      end\n" ++
  "      k.hash\n" ++
  "      @ks << k unless @h.key?(k)\n" ++
  "      @h[k] = v\n" ++
  "      v\n" ++
  "    end\n" ++
  "    def delete(k, &b)\n" ++
  "      return(b ? b.call(k) : nil) unless @h.key?(k)\n" ++
  "      @ks.reject! \{ |x| x.eql?(k) }\n" ++
  "      @h.delete(k)\n" ++
  "    end\n" ++
  "    def getkey(k)\n" ++
  "      @ks.find \{ |x| x.eql?(k) }\n" ++
  "    end\n" ++
  "    def clear; @h.clear; @ks.clear; self; end\n" ++
  // the address is the object's own id, in ruby's 16-digit shape
  "    def inspect; '#<ObjectSpace::WeakKeyMap:0x' + object_id.to_s(16).rjust(16, '0') + ' size=' + @h.size.to_s + '>'; end\n" ++
  "  end\n" ++
  "end\n" ++
  "class Range\n" ++
  // Range#cover?(range), ruby's r_cover_range_p: the other range's begin is
  // covered, its end is not past this one's (an exclusive end one short of
  // an inclusive one counts, through #max), and an empty one covers nothing.
  // cover? only took a value, so every range argument answered false.
  "  def __cover_range(v)\n" ++
  "    b = self.begin\n" ++
  "    e = self.end\n" ++
  "    vb = v.begin\n" ++
  "    ve = v.end\n" ++
  "    return false if !e.nil? && ve.nil?\n" ++
  "    return false if !b.nil? && vb.nil?\n" ++
  "    return false if !vb.nil? && !ve.nil? && __rless(vb, ve) > (v.exclude_end? ? -1 : 0)\n" ++
  "    return false if !vb.nil? && !cover?(vb)\n" ++
  "    c = __rless(e, ve)\n" ++
  "    if exclude_end? == v.exclude_end? then c >= 0\n" ++
  "    elsif exclude_end? then c > 0\n" ++
  "    elsif c >= 0 then true\n" ++
  "    else\n" ++
  "      m = begin; v.max; rescue TypeError; nil; end\n" ++
  "      m.nil? ? false : __rless(e, m) >= 0\n" ++
  "    end\n" ++
  "  end\n" ++
  // ruby's r_less: <=> as -1/0/1, and "not comparable" as the largest int
  "  def __rless(a, b)\n" ++
  "    r = a <=> b\n" ++
  "    return 4611686018427387903 if r.nil?\n" ++
  "    r > 0 ? 1 : (r < 0 ? -1 : 0)\n" ++
  "  end\n" ++
  "  # ruby 3.4's step for a non-numeric range: b, b + s, b + s + s, ... while\n" ++
  "  # the element is on the range's side of the end. The direction is b <=> e,\n" ++
  "  # the step's is b <=> (b + s); a zero step (b + s == b) iterates nothing,\n" ++
  "  # and a step pointing away from the end iterates nothing either.\n" ++
  "  def __step_generic(step)\n" ++
  "    b = self.begin\n" ++
  "    e = self.end\n" ++
  "    raise ArgumentError, \"#step iteration for beginless ranges is meaningless\" if b.nil?\n" ++
  "    dir = e.nil? ? -1 : (b <=> e)\n" ++
  "    return self if dir.nil?\n" ++
  "    v = b + step\n" ++
  "    sdir = b <=> v\n" ++
  "    return self if sdir.nil? || sdir == 0\n" ++
  "    unless e.nil?\n" ++
  "      dir = b <=> e\n" ++
  "      return self if dir != 0 && (dir < 0) != (sdir < 0)\n" ++
  "      if dir == 0\n" ++
  "        yield b unless exclude_end?\n" ++
  "        return self\n" ++
  "      end\n" ++
  "    end\n" ++
  "    yield b\n" ++
  "    cur = v\n" ++
  "    loop do\n" ++
  "      unless e.nil?\n" ++
  "        c = cur <=> e\n" ++
  "        break if c.nil?\n" ++
  "        ok = sdir < 0 ? (c < 0 || (c == 0 && !exclude_end?)) : (c > 0 || (c == 0 && !exclude_end?))\n" ++
  "        break unless ok\n" ++
  "      end\n" ++
  "      yield cur\n" ++
  "      cur = cur + step\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "end\n" ++
  "class IO\n" ++
  "  # IO.copy_stream(src, dst, copy_length = nil, src_offset = nil): src and\n" ++
  "  # dst are IOs, objects with readpartial/read and write, or paths (#to_path);\n" ++
  "  # answers the number of bytes copied.\n" ++
  "  # ⚠ IN PIECES, as ruby copies: each is one readpartial (or read) of at most\n" ++
  "  #   16 KiB, written before the next is asked for. Reading the whole source\n" ++
  "  #   first could not end while the other side of a pipe waited for the\n" ++
  "  #   first bytes -- a child copying its STDIN to its STDOUT for a parent\n" ++
  "  #   that writes, then reads, then closes.\n" ++
  "  def self.copy_stream(src, dst, copy_length = nil, src_offset = nil)\n" ++
  "    path = ->(x) \{\n" ++
  "      next x if x.is_a?(String)\n" ++
  "      raise TypeError, \"no implicit conversion of #\{x.class} into String\" unless x.respond_to?(:to_path)\n" ++
  "      pth = x.to_path\n" ++
  "      raise TypeError, \"can't convert #\{x.class} to String (#\{x.class}#to_path gives #\{pth.class})\" unless pth.is_a?(String)\n" ++
  "      pth\n" ++
  "    }\n" ++
  "    # nothing to copy is nothing read and nothing written\n" ++
  "    return 0 if copy_length == 0\n" ++
  "    # an object that converts to an IO IS one here (a Tempfile), as\n" ++
  "    # rb_io_check_io makes it: the copy goes to the IO, and is flushed\n" ++
  "    src = src.to_io if !src.is_a?(IO) && !src.is_a?(String) && src.respond_to?(:to_io)\n" ++
  "    dst = dst.to_io if !dst.is_a?(IO) && !dst.is_a?(String) && dst.respond_to?(:to_io)\n" ++
  "    if src.respond_to?(:read) && !src.is_a?(String) && src_offset\n" ++
  "      data = src.respond_to?(:pread) ? src.pread(copy_length || (src.size - src_offset), src_offset) : (src.seek(src_offset); src.read(copy_length))\n" ++
  "      data = (data || +\"\").b\n" ++
  "      if dst.respond_to?(:write) && !dst.is_a?(String)\n" ++
  "        dst.write(data)\n" ++
  "        dst.flush if dst.is_a?(IO)\n" ++
  "      else\n" ++
  "        File.binwrite(path.(dst), data)\n" ++
  "      end\n" ++
  "      return data.bytesize\n" ++
  "    end\n" ++
  "    unless (src.respond_to?(:readpartial) || src.respond_to?(:read)) && !src.is_a?(String)\n" ++
  "      whole = File.binread(path.(src))\n" ++
  "      off = src_offset || 0\n" ++
  "      src = __copy_src_string(whole, off, copy_length)\n" ++
  "    end\n" ++
  "    out = dst\n" ++
  "    opened = nil\n" ++
  "    unless dst.respond_to?(:write) && !dst.is_a?(String)\n" ++
  "      opened = out = File.open(path.(dst), \"wb\")\n" ++
  "    end\n" ++
  "    # what the destination already buffered goes first, and what is copied\n" ++
  "    # is on the file when this returns: ruby writes it with write(2)\n" ++
  "    out.flush if out.is_a?(IO)\n" ++
  "    total = 0\n" ++
  "    buf = +\"\".b\n" ++
  "    begin\n" ++
  "      loop do\n" ++
  "        want = copy_length ? copy_length - total : 16384\n" ++
  "        want = 16384 if want > 16384\n" ++
  "        break if want <= 0\n" ++
  "        chunk = if src.is_a?(IO) || src.respond_to?(:readpartial)\n" ++
  "                  begin\n" ++
  "                    src.readpartial(want, buf)\n" ++
  "                  rescue EOFError\n" ++
  "                    nil\n" ++
  "                  end\n" ++
  "                else\n" ++
  "                  src.read(want, buf)\n" ++
  "                end\n" ++
  "        break if chunk.nil? || chunk.empty?\n" ++
  "        out.write(chunk)\n" ++
  "        total += chunk.bytesize\n" ++
  "      end\n" ++
  "      out.flush if out.is_a?(IO) && !out.closed?\n" ++
  "    ensure\n" ++
  "      opened.close if opened\n" ++
  "    end\n" ++
  "    total\n" ++
  "  end\n" ++
  "\n" ++
  "  # a path's bytes, handed out as a source object reads them\n" ++
  "  def self.__copy_src_string(whole, off, len)\n" ++
  "    o = Object.new\n" ++
  "    o.instance_variable_set(:@s, (whole.byteslice(off, len || (whole.bytesize - off)) || +\"\").b)\n" ++
  "    def o.read(n, buf = nil)\n" ++
  "      return nil if @s.empty?\n" ++
  "      r = @s.byteslice(0, n)\n" ++
  "      @s = @s.byteslice(n, @s.bytesize - n) || +\"\".b\n" ++
  "      buf ? buf.replace(r) : r\n" ++
  "    end\n" ++
  "    o\n" ++
  "  end\n" ++
  "end\n" ++
  "class Encoding\n" ++
  "  # every name Encoding.find accepts: the encodings, their aliases, and\n" ++
  "  # \"internal\"\n" ++
  "  def self.name_list = list.map(&:name) + aliases.keys + [\"internal\"]\n" ++
  "  # an encoding's own name first, then each alias that names it\n" ++
  "  def names = [name] + Encoding.aliases.select \{ |_a, n| n == name }.keys\n" ++
  "  # ruby's alias table; a new Hash each call, as ruby answers\n" ++
  "  def self.aliases\n" ++
  "    \{ \"Big5-HKSCS:2008\" => \"Big5-HKSCS\", \"BINARY\" => \"ASCII-8BIT\", \"CP437\" => \"IBM437\", \"CP720\" => \"IBM720\", \"CP737\" => \"IBM737\", \"CP775\" => \"IBM775\", \"IBM850\" => \"CP850\", \"CP857\" => \"IBM857\", \"CP860\" => \"IBM860\", \"CP861\" => \"IBM861\", \"CP862\" => \"IBM862\", \"CP863\" => \"IBM863\", \"CP864\" => \"IBM864\", \"CP865\" => \"IBM865\", \"CP866\" => \"IBM866\", \"CP869\" => \"IBM869\", \"CP1258\" => \"Windows-1258\", \"ebcdic-cp-us\" => \"IBM037\", \"eucJP\" => \"EUC-JP\", \"euc-jp-ms\" => \"eucJP-ms\", \"EUC-JISX0213\" => \"EUC-JIS-2004\", \"eucKR\" => \"EUC-KR\", \"eucTW\" => \"EUC-TW\", \"EUC-CN\" => \"GB2312\", \"eucCN\" => \"GB2312\", \"CP936\" => \"GBK\", \"ISO2022-JP\" => \"ISO-2022-JP\", \"ISO2022-JP2\" => \"ISO-2022-JP-2\", \"ISO8859-1\" => \"ISO-8859-1\", \"ISO8859-2\" => \"ISO-8859-2\", \"ISO8859-3\" => \"ISO-8859-3\", \"ISO8859-4\" => \"ISO-8859-4\", \"ISO8859-5\" => \"ISO-8859-5\", \"ISO8859-6\" => \"ISO-8859-6\", \"CP1256\" => \"Windows-1256\", \"ISO8859-7\" => \"ISO-8859-7\", \"ISO8859-8\" => \"ISO-8859-8\", \"CP1255\" => \"Windows-1255\", \"ISO8859-9\" => \"ISO-8859-9\", \"ISO8859-10\" => \"ISO-8859-10\", \"ISO8859-11\" => \"ISO-8859-11\", \"CP874\" => \"Windows-874\", \"ISO8859-13\" => \"ISO-8859-13\", \"ISO8859-14\" => \"ISO-8859-14\", \"ISO8859-15\" => \"ISO-8859-15\", \"ISO8859-16\" => \"ISO-8859-16\", \"CP878\" => \"KOI8-R\", \"MacJapan\" => \"MacJapanese\", \"ASCII\" => \"US-ASCII\", \"ANSI_X3.4-1968\" => \"US-ASCII\", \"646\" => \"US-ASCII\", \"CP65000\" => \"UTF-7\", \"CP65001\" => \"UTF-8\", \"UTF-8-MAC\" => \"UTF8-MAC\", \"UTF-8-HFS\" => \"UTF8-MAC\", \"UCS-2BE\" => \"UTF-16BE\", \"UCS-4BE\" => \"UTF-32BE\", \"UCS-4LE\" => \"UTF-32LE\", \"CP932\" => \"Windows-31J\", \"csWindows31J\" => \"Windows-31J\", \"SJIS\" => \"Windows-31J\", \"PCK\" => \"Windows-31J\", \"CP1250\" => \"Windows-1250\", \"CP1251\" => \"Windows-1251\", \"CP1252\" => \"Windows-1252\", \"CP1253\" => \"Windows-1253\", \"CP1254\" => \"Windows-1254\", \"CP1257\" => \"Windows-1257\", \"locale\" => \"UTF-8\", \"external\" => \"UTF-8\", \"filesystem\" => \"UTF-8\" }\n" ++
  "  end\n" ++
  "end\n" ++
  "class Random\n" ++
  "  # Random::Formatter#random_number: a Float in [0, 1) for no limit, nil or\n" ++
  "  # a limit that is not positive (never the ArgumentError #rand raises), and\n" ++
  "  # rand(limit) otherwise\n" ++
  "  def random_number(n = 0)\n" ++
  "    return rand if n.nil? || (Numeric === n && n <= 0)\n" ++
  "    rand(n)\n" ++
  "  end\n" ++
  "  def self.random_number(n = 0)\n" ++
  "    return rand if n.nil? || (Numeric === n && n <= 0)\n" ++
  "    rand(n)\n" ++
  "  end\n" ++
  "  # bytes from the generator, as a binary String (there is no OS source here)\n" ++
  "  def self.urandom(n)\n" ++
  "    n = n.to_int\n" ++
  "    raise ArgumentError, \"negative string size (or size too big)\" if n < 0\n" ++
  "    Array.new(n) \{ rand(256) }.pack(\"C*\")\n" ++
  "  end\n" ++
  "end\n" ++
  "# Exception.exception is Exception.new (rb_class_new_instance, the same\n" ++
  "# method ruby registers under both names).\n" ++
  "class Exception\n" ++
  "  def self.exception(*args, &blk) = new(*args, &blk)\n" ++
  "end\n" ++
  "module Warning\n" ++
  "  def self.categories = [:deprecated, :experimental, :performance, :strict_unused_block]\n" ++
  "  # Warning#warn, which the module extends itself with -- so Warning.warn is\n" ++
  "  # found in Warning (its owner), a `def Warning.warn` can call super into it,\n" ++
  "  # and `module Warning; def warn` replaces it. It is ruby's\n" ++
  "  # rb_warning_s_warn: a String, a category that is switched off writes\n" ++
  "  # nothing, and the text goes to $stderr as it is, with no newline added.\n" ++
  "  # (arity -1, as the C method's is: that is what makes Kernel#warn pass the\n" ++
  "  # category keyword to it.)\n" ++
  "  def warn(*args, category: nil)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given #\{args.size}, expected 1)\" unless args.size == 1\n" ++
  "    msg = args[0]\n" ++
  "    raise TypeError, \"wrong argument type #\{msg.class} (expected String)\" unless msg.is_a?(String)\n" ++
  "    return nil if !category.nil? && !Warning[category]\n" ++
  "    $stderr.write(msg)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  extend self\n" ++
  "\n" ++
  "  # How the interpreter hands a warning to Warning.warn (rb_warn_category):\n" ++
  "  # with `category:` unless the method there takes exactly one argument.\n" ++
  "  def self.__kernel_warn(str, category)\n" ++
  "    if method(:warn).arity == 1\n" ++
  "      warn(str)\n" ++
  "    else\n" ++
  "      warn(str, category: category)\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  // Dir.open answers a Dir OBJECT (the class methods above are the rest of
  // Dir). Only the instance side needs Ruby: the listing itself comes from
  // the class methods, which are primitives.
  "class Dir\n" ++
  "  def initialize(path, encoding: nil)\n" ++
  "    @path = path\n" ++
  "    @enc = encoding\n" ++
  "    @pos = 0\n" ++
  "    @closed = false\n" ++
  "  end\n" ++
  "  # @W@ A CLOSED Dir answers nothing but #close and #path. Every read here went\n" ++
  "  #   straight on working after #close, so a use-after-close was invisible --\n" ++
  "  #   the same slip File had, and fixed the same way: one guard, called by\n" ++
  "  #   each reader, rather than a check at one entry point that ruby-level\n" ++
  "  #   methods walk past.\n" ++
  "  def __closed!\n" ++
  "    raise IOError, \"closed directory\" if @closed\n" ++
  "  end\n" ++
  "  private :__closed!\n" ++
  "\n" ++
  "  # ⚠ to_path is the DEFINITION and path the alias -- that is ruby's own\n" ++
  "  # direction, and the spec compares the two UnboundMethods. Writing it the\n" ++
  "  # other way round is still one method, but #original_name then disagrees.\n" ++
  "  def to_path\n" ++
  "    @path\n" ++
  "  end\n" ++
  "  alias path to_path\n" ++
  "  def entries\n" ++
  "    __closed!\n" ++
  "    Dir.entries(@path || \"/dev/fd/#\{@fd}\", encoding: @enc)\n" ++
  "  end\n" ++
  "  def children\n" ++
  "    __closed!\n" ++
  "    Dir.children(@path || \"/dev/fd/#\{@fd}\", encoding: @enc)\n" ++
  "  end\n" ++
  "  # ⚠ #each READS: it starts from the top (dir_each rewinds) and leaves the\n" ++
  "  #   position at the end, so a #read after it is nil. It walked a copy and\n" ++
  "  #   left the position where it was. Without a block it is an enumerator\n" ++
  "  #   whose size is unknown, as ruby's is.\n" ++
  "  def each\n" ++
  "    __closed!\n" ++
  "    return to_enum(:each) \{ nil } unless block_given?\n" ++
  "    @pos = 0\n" ++
  "    while (e = read)\n" ++
  "      yield e\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def read\n" ++
  "    __closed!\n" ++
  "    e = entries\n" ++
  "    return nil if @pos >= e.size\n" ++
  "    v = e[@pos]\n" ++
  "    @pos = @pos + 1\n" ++
  "    v\n" ++
  "  end\n" ++
  "  def rewind\n" ++
  "    __closed!\n" ++
  "    @pos = 0\n" ++
  "    self\n" ++
  "  end\n" ++
  "  # the read position, which #read already keeps -- it simply had no reader.\n" ++
  "  def pos\n" ++
  "    __closed!\n" ++
  "    @pos\n" ++
  "  end\n" ++
  "  alias tell pos\n" ++
  "  def pos=(n)\n" ++
  "    __closed!\n" ++
  "    @pos = n\n" ++
  "  end\n" ++
  "  def seek(n)\n" ++
  "    __closed!\n" ++
  "    @pos = n\n" ++
  "    self\n" ++
  "  end\n" ++
  "  # Dir#chdir is fchdir(2) on this Dir's descriptor, and the block form goes\n" ++
  "  # BACK by descriptor too. ⚠ It was Dir.chdir on the path, so the way back\n" ++
  "  # was by NAME: a block that removed the directory it was entered from\n" ++
  "  # (ruby/spec does exactly that) could not return and raised ENOENT, where\n" ++
  "  # ruby's descriptor still names the removed directory and returns.\n" ++
  "  # (both names are known here -- this Dir's and the one it came from -- so\n" ++
  "  # Dir.pwd is told them rather than asking the kernel afterwards)\n" ++
  "  def chdir\n" ++
  "    here = @path && File.expand_path(@path)\n" ++
  "    return __chdir_fd(here) unless block_given?\n" ++
  "    back = IO.__fd_open(\".\", \"r\", 0)\n" ++
  "    was = Dir.pwd\n" ++
  "    __chdir_fd(here)\n" ++
  "    begin\n" ++
  "      yield\n" ++
  "    ensure\n" ++
  "      if back >= 0\n" ++
  "        Dir.__fchdir(back, was)\n" ++
  "        IO.__fd_close(back)\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def __chdir_fd(here)\n" ++
  "    fd = fileno\n" ++
  "    rc = here ? Dir.__fchdir(fd, here) : Dir.__fchdir(fd)\n" ++
  "    return 0 if rc == 0\n" ++
  "    raise Errno::ENOTDIR.new(\"fchdir\")\n" ++
  "  end\n" ++
  "  private :__chdir_fd\n" ++
  "\n" ++
  "  def each_child(&b)\n" ++
  "    return to_enum(:each_child) \{ nil } unless block_given?\n" ++
  "    children.each(&b)\n" ++
  "    self\n" ++
  "  end\n" ++
  "  # ⚠ A Dir here is a PATH and a position (see #initialize); there is no\n" ++
  "  #   opendir(3) behind it. It used to raise NotImplementedError, because a\n" ++
  "  #   made-up number would be accepted by every caller and be wrong for all\n" ++
  "  #   of them. The number is a REAL descriptor now: the directory opened\n" ++
  "  #   read-only (open(2) takes a directory), lazily -- as a File's is, and\n" ++
  "  #   for the same reason (file_fd_of) -- and closed with the Dir. fchdir(2)\n" ++
  "  #   and fstat(2) accept it; it is not the one readdir would walk, because\n" ++
  "  #   the listing does not come from a descriptor here.\n" ++
  "  def fileno\n" ++
  "    __closed!\n" ++
  "    if @fd.nil?\n" ++
  "      fd = IO.__fd_open(@path, \"r\", 0)\n" ++
  "      raise Errno::ENOENT.new(@path, \"dir_fileno\") if fd < 0\n" ++
  "      @fd = fd\n" ++
  "    end\n" ++
  "    @fd\n" ++
  "  end\n" ++
  "  # closing twice is not an error; closing a descriptor someone else already\n" ++
  "  # closed is (ruby 3.4: EBADF from closedir)\n" ++
  "  def close\n" ++
  "    return nil if @closed\n" ++
  "    @closed = true\n" ++
  "    fd = @fd\n" ++
  "    @fd = nil\n" ++
  "    raise Errno::EBADF.new(\"closedir\") if fd && IO.__fd_close(fd) != 0\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # a Dir over a descriptor someone else opened. It has no path of its own\n" ++
  "  # (ruby's answers nil too); a listing reads the descriptor's /dev/fd name.\n" ++
  "  def self.for_fd(fd)\n" ++
  "    fd = fd.to_int unless fd.is_a?(Integer)\n" ++
  "    raise Errno::EBADF.new(\"fdopendir\") unless IO.__fd_ok(fd)\n" ++
  "    d = allocate\n" ++
  "    d.__adopt(fd)\n" ++
  "    d\n" ++
  "  end\n" ++
  "  def __adopt(fd)\n" ++
  "    @path = nil\n" ++
  "    @pos = 0\n" ++
  "    @closed = false\n" ++
  "    @fd = fd\n" ++
  "  end\n" ++
  "\n" ++
  "  # Dir.fchdir(fd) [\{ }]: fchdir(2), and with a block back again afterwards.\n" ++
  "  # No errno comes back, so the refusal is named by the one thing that can be\n" ++
  "  # asked: a number that is no descriptor at all is EBADF, and a descriptor\n" ++
  "  # that is not a directory is ENOTDIR.\n" ++
  "  def self.fchdir(fd)\n" ++
  "    fd = fd.to_int unless fd.is_a?(Integer)\n" ++
  "    return __fchdir!(fd) unless block_given?\n" ++
  "    back = Dir.pwd\n" ++
  "    __fchdir!(fd)\n" ++
  "    begin\n" ++
  "      yield\n" ++
  "    ensure\n" ++
  "      Dir.chdir(back)\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def self.__fchdir!(fd)\n" ++
  "    return 0 if __fchdir(fd) == 0\n" ++
  "    raise Errno::EBADF.new(\"fchdir\") unless IO.__fd_ok(fd)\n" ++
  "    raise Errno::ENOTDIR.new(\"fchdir\")\n" ++
  "  end\n" ++
  "\n" ++
  "  # chroot(2) itself, so a superuser really is moved. No errno comes back: a\n" ++
  "  # path that is not there is ENOENT, and one that is, refused, is refused for\n" ++
  "  # want of the privilege chroot needs (EPERM) -- a rarer third cause would\n" ++
  "  # be named wrongly, which is said here rather than left to be found.\n" ++
  "  def self.chroot(path)\n" ++
  "    path = File::Stat.__path(path)\n" ++
  "    return 0 if __chroot(path) == 0\n" ++
  "    raise Errno::ENOENT.new(path, \"dir_s_chroot\") unless File.exist?(path)\n" ++
  "    raise Errno::EPERM.new(path, \"dir_s_chroot\")\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  // TracePoint, enough of it for zeitwerk: the :class event, which fires when
  // a class or module body is entered. `#self` cannot be written with `def`
  // (it is a keyword), so it is defined the way ruby's C code effectively
  // does -- through define_method.
  "class TracePoint\n" ++
  "  def self.__points\n" ++
  "    @points = Array.new if @points.nil?\n" ++
  "    @points\n" ++
  "  end\n" ++
  "  def self.__fire(mod)\n" ++
  "    __points.each do |tp|\n" ++
  "      tp.__call(mod)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  def self.__fire_ev(ev, mid, cls, path, rv = nil, slf = nil, line = nil)\n" ++
  "    __points.each do |tp|\n" ++
  "      tp.__call_ev(ev, mid, cls, path, rv, slf, line)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  # TracePoint.trace: a tracepoint that is enabled from the start.\n" ++
  "  def self.trace(*events, &blk)\n" ++
  "    tp = new(*events, &blk)\n" ++
  "    tp.enable\n" ++
  "    tp\n" ++
  "  end\n" ++
  "  EVENT_NAMES = [:line, :class, :end, :call, :return, :c_call, :c_return, :raise, :b_call, :b_return, :a_call, :a_return, :thread_begin, :thread_end, :fiber_switch, :script_compiled, :rescue]\n" ++
  "  def initialize(*events, &blk)\n" ++
  "    # an event is named by a Symbol, or by anything that converts to one\n" ++
  "    events = events.map do |e|\n" ++
  "      s = if e.is_a?(Symbol) then e\n" ++
  "          elsif e.is_a?(String) || e.respond_to?(:to_sym) then e.to_sym\n" ++
  "          else raise TypeError, e.inspect + ' is not a symbol nor a string'\n" ++
  "          end\n" ++
  "      raise TypeError, s.inspect + ' is not a symbol nor a string' unless s.is_a?(Symbol)\n" ++
  "      raise ArgumentError, 'unknown event: ' + s.to_s unless EVENT_NAMES.include?(s)\n" ++
  "      s\n" ++
  "    end\n" ++
  "    raise ArgumentError, 'must be called with a block' unless blk\n" ++
  "    @events = events\n" ++
  "    @blk = blk\n" ++
  "    @enabled = false\n" ++
  "    @tp_self = nil\n" ++
  "  end\n" ++
  "  def enabled?\n" ++
  "    @enabled\n" ++
  "  end\n" ++
  "  def event\n" ++
  "    @event\n" ++
  "  end\n" ++
  "  define_method(:self) do\n" ++
  "    @tp_self\n" ++
  "  end\n" ++
  // enable(target:) narrows a tracepoint to one method -- `tp.enable(target:
  // method(:foo))` fires only for foo. Without the keyword, `enable` took no
  // arguments at all and four bootstraptest pairs died on the ArgumentError
  // rather than on anything to do with tracing. The block form enables for the
  // duration of the block, which is how Ruby scopes it.
  "  def enable(target: nil, target_line: nil, target_thread: nil)\n" ++
  "    @target = target\n" ++
  "    if block_given?\n" ++
  "      was = @enabled\n" ++
  "      # the block form traces the thread that enabled it, and only that one\n" ++
  "      @thread = Thread.current\n" ++
  "      __on\n" ++
  "      begin\n" ++
  "        yield\n" ++
  "      ensure\n" ++
  "        @thread = nil\n" ++
  "        # the flag goes down FIRST: #disable is itself a method call, and\n" ++
  "        # with the tracepoint still on it was reported as a :call event --\n" ++
  "        # callee_id's spec saw [:m_alias, :disable].\n" ++
  "        unless was\n" ++
  "          @enabled = false\n" ++
  "          disable\n" ++
  "        end\n" ++
  "      end\n" ++
  "    else\n" ++
  "      # true when it was ALREADY on\n" ++
  "      was = @enabled\n" ++
  "      __on\n" ++
  "      was\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def __on\n" ++
  "    unless @enabled\n" ++
  "      @enabled = true\n" ++
  "      TracePoint.__points.push(self)\n" ++
  "      TracePoint.__active(true)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  def disable\n" ++
  "    was = @enabled\n" ++
  "    # with a block: off for the block, back on after it, and the block's\n" ++
  "    # value is the answer\n" ++
  "    if block_given?\n" ++
  "      @enabled = false\n" ++
  "      TracePoint.__points.delete(self)\n" ++
  "      TracePoint.__active(TracePoint.__points.size > 0)\n" ++
  "      begin\n" ++
  "        return yield\n" ++
  "      ensure\n" ++
  "        __on if was\n" ++
  "      end\n" ++
  "    end\n" ++
  "    @enabled = false\n" ++
  "    TracePoint.__points.delete(self)\n" ++
  "    TracePoint.__active(TracePoint.__points.size > 0)\n" ++
  "    was\n" ++
  "  end\n" ++
  "  def __call(mod)\n" ++
  "    return nil unless @enabled\n" ++
  "    return nil unless @events.empty? || @events.include?(:class)\n" ++
  "    @tp_self = mod\n" ++
  "    @event = :class\n" ++
  "    r = @blk.call(self)\n" ++
  "    @tp_self = nil\n" ++
  "    r\n" ++
  "  end\n" ++
  "  def __call_ev(ev, mid, cls, path, rv = nil, slf = nil, line = nil)\n" ++
  "    return nil unless @enabled\n" ++
  "    return nil if @thread && !Thread.current.equal?(@thread)\n" ++
  "    return nil unless @events.empty? || @events.include?(ev)\n" ++
  "    return nil if @target && @target.name != mid\n" ++
  "    @event = ev\n" ++
  "    @method_id = mid\n" ++
  "    @defined_class = cls\n" ++
  "    @path = path\n" ++
  "    @return_value = rv\n" ++
  "    @tp_self = slf\n" ++
  "    @lineno = line\n" ++
  "    @inside = true\n" ++
  "    begin\n" ++
  "      @blk.call(self)\n" ++
  "    ensure\n" ++
  "      @inside = false\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def raised_exception\n" ++
  "    raise RuntimeError, \"not supported by this event\" unless @event == :raise || @event == :rescue\n" ++
  "    @return_value\n" ++
  "  end\n" ++
  "  def return_value\n" ++
  "    raise RuntimeError, \"not supported by this event\" unless @event == :return || @event == :c_return || @event == :b_return\n" ++
  "    @return_value\n" ++
  "  end\n" ++
  "  def method_id\n" ++
  "    @method_id\n" ++
  "  end\n" ++
  "  def callee_id\n" ++
  "    @method_id\n" ++
  "  end\n" ++
  "  def defined_class\n" ++
  "    @defined_class\n" ++
  "  end\n" ++
  "  def path\n" ++
  "    @path\n" ++
  "  end\n" ++
  "  # ruby's tracepoint_inspect: outside the handler only whether it is on;\n" ++
  "  # inside, the event and where it happened (and the method, for a call or\n" ++
  "  # return, or for a line that is directly in one). It printed the ivars.\n" ++
  "  def inspect\n" ++
  "    return(@enabled ? \"#<TracePoint:enabled>\" : \"#<TracePoint:disabled>\") unless @inside\n" ++
  "    at = @path.to_s + \":\" + (@lineno || 0).to_s\n" ++
  "    case @event\n" ++
  "    when :line\n" ++
  "      @method_id.nil? ? \"#<TracePoint:line \" + at + \">\" : \"#<TracePoint:line \" + at + \" in '\" + @method_id.to_s + \"'>\"\n" ++
  "    when :call, :c_call, :return, :c_return\n" ++
  "      \"#<TracePoint:\" + @event.to_s + \" '\" + @method_id.to_s + \"' \" + at + \">\"\n" ++
  "    when :thread_begin, :thread_end\n" ++
  "      \"#<TracePoint:\" + @event.to_s + \" \" + @tp_self.inspect + \">\"\n" ++
  "    else\n" ++
  "      \"#<TracePoint:\" + @event.to_s + \" \" + at + \">\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  # the line of the event, and only while the event is being handled\n" ++
  "  def lineno\n" ++
  "    raise RuntimeError, 'access from outside' unless @inside\n" ++
  "    @lineno || 0\n" ++
  "  end\n" ++
  "end\n" ++
  // The non-blocking read/write exceptions. Each is an Errno class WITH a
  // marker module mixed in, so `rescue IO::WaitReadable` catches whichever
  // errno the platform actually raised. EAGAIN and EWOULDBLOCK are the same
  // number on darwin and on linux, and where they are the same class ruby
  // makes the two Wait classes the same OBJECT too -- so the pair is decided
  // by asking, not by assuming, and a platform that separates them gets two.
  // ARGF: the pseudo-file over ARGV's files (stdin when there are none). A
  // real class, as ruby's is (`ARGF.class.new(*files)` is what mspec's argf
  // helper builds): the global ARGF was a stdin-only object, so it read the
  // program's stdin whatever ARGV named, and had no lineno, file, skip,
  // rewind or seek at all. The global one is made at startup, before this
  // class exists, and sets itself up over ARGV the first time it is used.
  "class ARGFClass\n" ++
  "  include Enumerable\n" ++
  "  def self.to_s; \"ARGF.class\"; end\n" ++
  "  def self.inspect; \"ARGF.class\"; end\n" ++
  "  def self.name; \"ARGF.class\"; end\n" ++
  "\n" ++
  "  def initialize(*argv)\n" ++
  "    @argv = argv\n" ++
  "    @__init = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # the global ARGF was made before this class existed: its state is set up\n" ++
  "  # the first time it is used, over ARGV itself\n" ++
  "  def __setup\n" ++
  "    return if @__init\n" ++
  "    @__init = true\n" ++
  "    @argv = ARGV\n" ++
  "  end\n" ++
  "\n" ++
  "  def argv; __setup; @argv; end\n" ++
  "\n" ++
  "  # In-place editing (-i[ext], or #inplace_mode=): each file is read from\n" ++
  "  # where it was moved to -- its backup, or a name of this process's that is\n" ++
  "  # deleted after -- while $stdout writes the new file under the old name,\n" ++
  "  # until the reader moves on.\n" ++
  "  def __open_next\n" ++
  "    __inplace_done\n" ++
  "    name = @argv.shift\n" ++
  "    @filename = name\n" ++
  "    if name != \"-\" && !$-i.nil?\n" ++
  "      ext = $-i.to_s\n" ++
  "      src = ext.empty? ? name + \".mere-ruby-inplace.\" + Process.pid.to_s : name + ext\n" ++
  "      @__ip_tmp = ext.empty? ? src : nil\n" ++
  "      File.rename(name, src)\n" ++
  "      @file = File.open(src, \"r\")\n" ++
  "      @__ip_saved = $stdout\n" ++
  "      @__ip_out = File.open(name, \"w\")\n" ++
  "      $stdout = @__ip_out\n" ++
  "    else\n" ++
  "      @file = (name == \"-\") ? $stdin : File.open(name, \"r\")\n" ++
  "    end\n" ++
  "    @flines = 0\n" ++
  "    @file.binmode if @binmode\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  def __prep\n" ++
  "    __setup\n" ++
  "    unless @started\n" ++
  "      @started = true\n" ++
  "      @lineno ||= 0\n" ++
  "      if @argv.empty?\n" ++
  "        @file = $stdin\n" ++
  "        @filename = \"-\"\n" ++
  "        @flines = 0\n" ++
  "      else\n" ++
  "        __open_next\n" ++
  "      end\n" ++
  "    end\n" ++
  "    if @next_pending\n" ++
  "      @next_pending = false\n" ++
  "      __open_next unless @argv.empty?\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __closed_now?\n" ++
  "    @file.nil? || (@file != $stdin && @file.closed?)\n" ++
  "  end\n" ++
  "\n" ++
  "  # the current file is exhausted: close it and open the next, if any\n" ++
  "  def __inplace_done\n" ++
  "    return unless @__ip_out\n" ++
  "    @__ip_out.close\n" ++
  "    $stdout = @__ip_saved\n" ++
  "    @__ip_out = nil\n" ++
  "    File.delete(@__ip_tmp) if @__ip_tmp && File.exist?(@__ip_tmp)\n" ++
  "    @__ip_tmp = nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def inplace_mode = $-i\n" ++
  "  def inplace_mode=(ext)\n" ++
  "    $-i = ext.nil? ? nil : ext.to_str\n" ++
  "  end\n" ++
  "\n" ++
  "  def __advance\n" ++
  "    @file.close unless @file == $stdin || @file.closed?\n" ++
  "    __inplace_done\n" ++
  "    return false if @argv.empty?\n" ++
  "    __open_next\n" ++
  "  end\n" ++
  "\n" ++
  "  def file; __prep; @file; end\n" ++
  "  def filename; __prep; @filename; end\n" ++
  "  alias path filename\n" ++
  "  def to_io; __prep; @file; end\n" ++
  "  def to_s; \"ARGF\"; end\n" ++
  "  alias inspect to_s\n" ++
  "\n" ++
  "  def lineno; __setup; @lineno ||= 0; end\n" ++
  "  def lineno=(n)\n" ++
  "    __setup\n" ++
  "    @lineno = n\n" ++
  "    $. = n\n" ++
  "  end\n" ++
  "\n" ++
  "  def __enc(s)\n" ++
  "    return s if s.nil?\n" ++
  "    if @binmode\n" ++
  "      s.force_encoding(Encoding::BINARY)\n" ++
  "    else\n" ++
  "      ext = @ext_enc || Encoding.default_external\n" ++
  "      s.force_encoding(ext)\n" ++
  "      s = s.encode(@int_enc, ext) if @int_enc\n" ++
  "    end\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def gets(*args)\n" ++
  "    __prep\n" ++
  "    loop do\n" ++
  "      if __closed_now?\n" ++
  "        $_ = nil\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "      line = @file.gets(*args)\n" ++
  "      if line\n" ++
  "        @lineno = (@lineno || 0) + 1\n" ++
  "        @flines = (@flines || 0) + 1\n" ++
  "        # the global ARGF puts its own count in $.; another instance leaves\n" ++
  "        # the FILE's there, as reading that file directly would\n" ++
  "        $. = equal?(::ARGF) ? @lineno : @flines\n" ++
  "        line = __enc(line)\n" ++
  "        $_ = line\n" ++
  "        return line\n" ++
  "      end\n" ++
  "      unless __advance\n" ++
  "        $_ = nil\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def readline(*args)\n" ++
  "    line = gets(*args)\n" ++
  "    raise EOFError, \"end of file reached\" if line.nil?\n" ++
  "    line\n" ++
  "  end\n" ++
  "\n" ++
  "  def readlines(*args)\n" ++
  "    out = []\n" ++
  "    while (line = gets(*args))\n" ++
  "      out << line\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "  alias to_a readlines\n" ++
  "\n" ++
  "  def each_line(*args)\n" ++
  "    return enum_for(:each_line, *args) \{ nil } unless block_given?\n" ++
  "    while (line = gets(*args))\n" ++
  "      yield line\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  alias each each_line\n" ++
  "\n" ++
  "  def read(len = nil, buf = nil)\n" ++
  "    __prep\n" ++
  "    out = +\"\"\n" ++
  "    if len.nil?\n" ++
  "      # everything already read: there is no stream left to read from\n" ++
  "      return nil if __closed_now? && @argv.empty? && buf.nil?\n" ++
  "      loop do\n" ++
  "        unless __closed_now?\n" ++
  "          chunk = @file.read\n" ++
  "          out << chunk if chunk\n" ++
  "        end\n" ++
  "        break unless __advance\n" ++
  "      end\n" ++
  "      out = __enc(out)\n" ++
  "    else\n" ++
  "      while out.bytesize < len\n" ++
  "        chunk = __closed_now? ? nil : @file.read(len - out.bytesize)\n" ++
  "        if chunk.nil? || chunk.empty?\n" ++
  "          break unless __advance\n" ++
  "          next\n" ++
  "        end\n" ++
  "        out << chunk\n" ++
  "      end\n" ++
  "      out.force_encoding(Encoding::BINARY)\n" ++
  "      out = nil if out.empty? && len > 0\n" ++
  "    end\n" ++
  "    if buf\n" ++
  "      buf.replace(out || \"\")\n" ++
  "      return out.nil? ? nil : buf\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "\n" ++
  "  def readpartial(len = nil, buf = nil)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1..2)\" if len.nil?\n" ++
  "    __prep\n" ++
  "    buf.replace(\"\") if buf\n" ++
  "    if __closed_now?\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    chunk = @file.read(len)\n" ++
  "    if chunk.nil? || chunk.empty?\n" ++
  "      last = @argv.empty?\n" ++
  "      __advance\n" ++
  "      raise EOFError, \"end of file reached\" if last\n" ++
  "      chunk = +\"\"\n" ++
  "    end\n" ++
  "    chunk.force_encoding(Encoding::BINARY)\n" ++
  "    if buf\n" ++
  "      buf.replace(chunk)\n" ++
  "      return buf\n" ++
  "    end\n" ++
  "    chunk\n" ++
  "  end\n" ++
  "\n" ++
  "  # the current file's read_nonblock: its end is \"\" while another file\n" ++
  "  # follows and EOFError (or nil) after the last one\n" ++
  "  def read_nonblock(len, buf = nil, exception: true)\n" ++
  "    __prep\n" ++
  "    buf.replace(\"\") if buf\n" ++
  "    if __closed_now?\n" ++
  "      return nil unless exception\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    chunk = @file.read_nonblock(len, exception: false)\n" ++
  "    if chunk == :wait_readable\n" ++
  "      return :wait_readable unless exception\n" ++
  "      raise IO::EAGAINWaitReadable, \"read would block\"\n" ++
  "    end\n" ++
  "    if chunk.nil?\n" ++
  "      last = @argv.empty?\n" ++
  "      __advance\n" ++
  "      if last\n" ++
  "        return nil unless exception\n" ++
  "        raise EOFError, \"end of file reached\"\n" ++
  "      end\n" ++
  "      chunk = +\"\"\n" ++
  "    end\n" ++
  "    chunk.force_encoding(Encoding::BINARY)\n" ++
  "    return chunk unless buf\n" ++
  "    buf.replace(chunk)\n" ++
  "  end\n" ++
  "\n" ++
  "  def getc\n" ++
  "    __prep\n" ++
  "    loop do\n" ++
  "      return nil if __closed_now?\n" ++
  "      c = @file.getc\n" ++
  "      return __enc(c) if c\n" ++
  "      return nil unless __advance\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def readchar\n" ++
  "    c = getc\n" ++
  "    raise EOFError, \"end of file reached\" if c.nil?\n" ++
  "    c\n" ++
  "  end\n" ++
  "  def getbyte\n" ++
  "    __prep\n" ++
  "    loop do\n" ++
  "      return nil if __closed_now?\n" ++
  "      b = @file.getbyte\n" ++
  "      return b if b\n" ++
  "      return nil unless __advance\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def readbyte\n" ++
  "    b = getbyte\n" ++
  "    raise EOFError, \"end of file reached\" if b.nil?\n" ++
  "    b\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_byte\n" ++
  "    return enum_for(:each_byte) \{ nil } unless block_given?\n" ++
  "    while (b = getbyte)\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def each_char\n" ++
  "    return enum_for(:each_char) \{ nil } unless block_given?\n" ++
  "    while (c = getc)\n" ++
  "      yield c\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def each_codepoint\n" ++
  "    return enum_for(:each_codepoint) \{ nil } unless block_given?\n" ++
  "    while (c = getc)\n" ++
  "      yield c.ord\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def eof?\n" ++
  "    __prep\n" ++
  "    raise IOError, \"closed stream\" if __closed_now?\n" ++
  "    @file.eof?\n" ++
  "  end\n" ++
  "  alias eof eof?\n" ++
  "\n" ++
  "  def pos\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.pos\n" ++
  "  end\n" ++
  "  alias tell pos\n" ++
  "  def pos=(n)\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.pos = n\n" ++
  "  end\n" ++
  "  def seek(off, whence = IO::SEEK_SET)\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.seek(off, whence)\n" ++
  "  end\n" ++
  "  def rewind\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream to rewind\" if __closed_now?\n" ++
  "    @lineno = (@lineno || 0) - (@flines || 0)\n" ++
  "    @flines = 0\n" ++
  "    $. = @lineno\n" ++
  "    @file.rewind\n" ++
  "    0\n" ++
  "  end\n" ++
  "\n" ++
  "  def fileno\n" ++
  "    __prep\n" ++
  "    raise ArgumentError, \"no stream\" if __closed_now?\n" ++
  "    @file.fileno\n" ++
  "  end\n" ++
  "  alias to_i fileno\n" ++
  "\n" ++
  "  # the current file is done with: the next read opens the one after it\n" ++
  "  def skip\n" ++
  "    __setup\n" ++
  "    return self unless @started\n" ++
  "    return self if @next_pending || __closed_now?\n" ++
  "    @file.close unless @file == $stdin\n" ++
  "    @next_pending = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def close\n" ++
  "    __prep\n" ++
  "    unless __closed_now?\n" ++
  "      @file.close unless @file == $stdin\n" ++
  "      @next_pending = true\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def closed?\n" ++
  "    __prep\n" ++
  "    @file != $stdin && @file.closed?\n" ++
  "  end\n" ++
  "\n" ++
  "  def binmode\n" ++
  "    @binmode = true\n" ++
  "    @file.binmode if @file && !__closed_now?\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def binmode?; @binmode ? true : false; end\n" ++
  "\n" ++
  "  def set_encoding(ext, int = nil)\n" ++
  "    if int.nil? && ext.is_a?(String) && ext.include?(\":\")\n" ++
  "      ext, int = ext.split(\":\", 2)\n" ++
  "    end\n" ++
  "    @ext_enc = ext.is_a?(Encoding) ? ext : Encoding.find(ext.to_s)\n" ++
  "    @int_enc = int.nil? ? nil : (int.is_a?(Encoding) ? int : Encoding.find(int.to_s))\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def external_encoding; @ext_enc || Encoding.default_external; end\n" ++
  "  def internal_encoding; @int_enc || Encoding.default_internal; end\n" ++
  "end\n" ++
  "module Kernel\n" ++
  "  # exec: this process becomes the command. There is no execve here, so the\n" ++
  "  # command RUNS and the process then ends with its status, without at_exit\n" ++
  "  # handlers -- which is what replacing the process looks like from outside.\n" ++
  "  # It is Process.spawn and a wait: exec takes exactly spawn's arguments (the\n" ++
  "  # env and its #to_hash, [cmd, argv0], #to_ary, the redirects and options),\n" ++
  "  # and refuses a command the same way. The old copy of that parsing had\n" ++
  "  # none of the conversions and no argv0.\n" ++
  "  def exec(*args)\n" ++
  "    pid = Process.spawn(*args)\n" ++
  "    Process.wait(pid)\n" ++
  "    exit!($?.exitstatus || 1)\n" ++
  "  end\n" ++
  "  module_function :exec\n" ++
  "end\n" ++
  "module Process\n" ++
  "  def self.exec(*args) = Kernel.exec(*args)\n" ++
  "end\n" ++
  "# Kernel#trap is Signal.trap (private here, public as Kernel.trap).\n" ++
  "module Kernel\n" ++
  "  def trap(*args, &blk) = Signal.trap(*args, &blk)\n" ++
  "  module_function :trap\n" ++
  "end\n" ++
  "class File\n" ++
  "  # File.umask: the process's file-creation mask, as the shell it starts\n" ++
  "  # reports it (inherited, so the same). umask(2) lives in <sys/stat.h>, out\n" ++
  "  # of an extern's reach, so the mask can be read here but not changed.\n" ++
  "  def self.umask(*args)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given #\{args.size}, expected 0..1)\" if args.size > 1\n" ++
  "    raise NotImplementedError, \"File.umask(mask) is not implemented here\" unless args.empty?\n" ++
  "    @__umask ||= `umask`.strip.to_i(8)\n" ++
  "  end\n" ++
  "\n" ++
  "  # chown(owner, group, *paths): nil or -1 leaves that id alone. The change\n" ++
  "  # is made by the system's chown/chgrp, and a refusal is ruby's EPERM.\n" ++
  "  def self.chown(owner, group, *paths)\n" ++
  "    paths.each do |pth|\n" ++
  "      pth = pth.to_path if pth.respond_to?(:to_path)\n" ++
  "      raise Errno::ENOENT, \"No such file or directory @ apply2files - \" + pth.to_s unless File.exist?(pth)\n" ++
  "      o = (owner.nil? || owner == -1) ? nil : owner.to_int\n" ++
  "      g = (group.nil? || group == -1) ? nil : group.to_int\n" ++
  "      next if o.nil? && g.nil?\n" ++
  "      spec = (o ? o.to_s : \"\") + (g ? \":\" + g.to_s : \"\")\n" ++
  "      ok = system(\"chown \" + spec + \" '\" + pth.to_s.gsub(\"'\", \"'\\\\\\\\''\") + \"' 2>/dev/null\")\n" ++
  "      raise Errno::EPERM, \"Operation not permitted @ apply2files - \" + pth.to_s unless ok\n" ++
  "    end\n" ++
  "    paths.size\n" ++
  "  end\n" ++
  "  def self.lchown(owner, group, *paths) = chown(owner, group, *paths)\n" ++
  "  def chown(owner, group) = (File.chown(owner, group, path); 0)\n" ++
  "end\n" ++
  // Thread::Backtrace: the class the Locations belong to, and the limit
  // --backtrace-limit set (-1 when none was)
  "class Thread\n" ++
  "  class Backtrace\n" ++
  "    def self.limit = ($__backtrace_limit || -1)\n" ++
  "  end\n" ++
  "end\n" ++
  "class IO\n" ++
  "  # whence, as ruby names them. `seek` took the numbers all along; the\n" ++
  "  # CONSTANTS did not exist, so `io.seek(1, IO::SEEK_CUR)` was a NameError.\n" ++
  "  SEEK_SET = 0\n" ++
  "  SEEK_CUR = 1\n" ++
  "  SEEK_END = 2\n" ++
  "  SEEK_DATA = 3\n" ++
  "  SEEK_HOLE = 4\n" ++
  "  # ⚠ ruby's IO includes Enumerable, and File inherits that. Two spec files\n" ++
  "  #   read it directly (core/io/io_spec, core/file/file_spec) and every\n" ++
  "  #   Enumerable method on an IO was reaching its own builtin rather than the\n" ++
  "  #   module, so the ancestry said no where the behaviour said yes.\n" ++
  "  include Enumerable\n" ++
  "\n" ++
  "  # ⚠ A standard stream printed its IVARS -- \"#<IO:0x67 @__io_fd=1>\" --\n" ++
  "  #   because it had no #inspect of its own and the generic fallback took\n" ++
  "  #   over. It has to live HERE and not in the dispatcher: inspect_w only\n" ++
  "  #   consults a METHOD-TABLE #inspect, so a dispatcher arm for the name is\n" ++
  "  #   never reached by `p`. ruby names the three standard streams and\n" ++
  "  #   numbers the rest.\n" ++
  "  def inspect\n" ++
  "    # a CLOSED stream has no descriptor left to name, and ruby prints none:\n" ++
  "    # \"#<IO:(closed)>\", not the number it used to have.\n" ++
  "    return \"#<IO:(closed)>\" if closed?\n" ++
  "    n = (@__io_fd == 0 ? \"<STDIN>\" : @__io_fd == 1 ? \"<STDOUT>\" :\n" ++
  "         @__io_fd == 2 ? \"<STDERR>\" : \"fd \" + @__io_fd.to_s)\n" ++
  "    \"#<IO:\" + n + \">\"\n" ++
  "  end\n" ++
  "  alias to_s inspect\n" ++
  "\n" ++
  "  module WaitReadable; end\n" ++
  "  module WaitWritable; end\n" ++
  "  # ruby 3.2: what an IO#timeout, or a connect's deadline, raises\n" ++
  "  class TimeoutError < IOError; end\n" ++
  "  class EAGAINWaitReadable < Errno::EAGAIN\n" ++
  "    include WaitReadable\n" ++
  "  end\n" ++
  "  class EAGAINWaitWritable < Errno::EAGAIN\n" ++
  "    include WaitWritable\n" ++
  "  end\n" ++
  "  class EINPROGRESSWaitReadable < Errno::EINPROGRESS\n" ++
  "    include WaitReadable\n" ++
  "  end\n" ++
  "  class EINPROGRESSWaitWritable < Errno::EINPROGRESS\n" ++
  "    include WaitWritable\n" ++
  "  end\n" ++
  "  if Errno::EAGAIN.equal?(Errno::EWOULDBLOCK)\n" ++
  "    EWOULDBLOCKWaitReadable = EAGAINWaitReadable\n" ++
  "    EWOULDBLOCKWaitWritable = EAGAINWaitWritable\n" ++
  "  else\n" ++
  "    EWOULDBLOCKWaitReadable = Class.new(Errno::EWOULDBLOCK) do\n" ++
  "      include WaitReadable\n" ++
  "    end\n" ++
  "    EWOULDBLOCKWaitWritable = Class.new(Errno::EWOULDBLOCK) do\n" ++
  "      include WaitWritable\n" ++
  "    end\n" ++
  "  end\n" ++
  "  # --- readiness: IO.select, #wait and the non-blocking pair --------------\n" ++
  "  # All of it is written over one primitive, IO.__poll (poll(2) on the\n" ++
  "  # descriptors, a wait in milliseconds, -1 for none). A File here is a path\n" ++
  "  # and a buffer rather than a descriptor, and a regular file is always ready\n" ++
  "  # to poll(2) anyway, so a File is answered as ready without asking.\n" ++
  "  #\n" ++
  "  # WAITING: with threads scheduled (IO.__sched?), a wait asks, then lets\n" ++
  "  #   the other threads run for a millisecond (IO.__park), and asks again,\n" ++
  "  #   until the time is up -- one of them may be the writer. In a build\n" ++
  "  #   without coroutines a thread body runs to completion at Thread.new, so a\n" ++
  "  #   thread that would wait PARKS for good, the main thread really waits,\n" ++
  "  #   and a pipe both of whose ends are this process's is named a deadlock.\n" ++
  "  READABLE = 1\n" ++
  "  PRIORITY = 2\n" ++
  "  WRITABLE = 4\n" ++
  "\n" ++
  "  def self.__sel_io(o)\n" ++
  "    return o if o.is_a?(IO)\n" ++
  "    # a socket is an IO in ruby; here BasicSocket is its own class, and it\n" ++
  "    # answers the two questions a wait asks (its fd, its read-ahead)\n" ++
  "    return o if defined?(BasicSocket) && o.is_a?(BasicSocket)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + o.class.to_s + \" into IO\" unless o.respond_to?(:to_io)\n" ++
  "    io = o.to_io\n" ++
  "    unless io.is_a?(IO)\n" ++
  "      raise TypeError, \"can't convert \" + o.class.to_s + \" to IO (\" + o.class.to_s + \"#to_io gives \" + io.class.to_s + \")\"\n" ++
  "    end\n" ++
  "    io\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__sel_ms(t)\n" ++
  "    return -1 if t.nil?\n" ++
  "    raise TypeError, \"can't convert \" + t.class.to_s + \" into time interval\" unless t.is_a?(Numeric)\n" ++
  "    raise RangeError, \"NaN out of Time range\" if t.is_a?(Float) && t.nan?\n" ++
  "    raise ArgumentError, \"time interval must not be negative\" if t < 0\n" ++
  "    return -1 if t.is_a?(Float) && t.infinite?\n" ++
  "    ms = (t * 1000).ceil\n" ++
  "    ms > 2147483647 ? 2147483647 : ms\n" ++
  "  end\n" ++
  "\n" ++
  "  # true when nothing outside this process could make `ios` ready: every one\n" ++
  "  # of them is an end of a pipe this process made\n" ++
  "  def self.__sel_stuck?(ios)\n" ++
  "    !ios.empty? && ios.all? do |io|\n" ++
  "      io.instance_variable_defined?(:@__io_peer)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # [[fd, interest], ...] -> the ready bits per entry; a nil fd is a File\n" ++
  "  def self.__sel_wait(ent, ms)\n" ++
  "    fds = []\n" ++
  "    ints = []\n" ++
  "    ent.each do |fd, b|\n" ++
  "      next if fd.nil?\n" ++
  "      i = fds.index(fd)\n" ++
  "      if i then ints[i] |= b else fds << fd; ints << b end\n" ++
  "    end\n" ++
  "    now = ent.any? \{ |fd, _| fd.nil? } ? 0 : ms\n" ++
  "    got = IO.__poll(fds, ints, 0)\n" ++
  "    if got.all? \{ |b| b == 0 } && now != 0 && !ent.any? \{ |fd, _| fd.nil? }\n" ++
  "      if IO.__sched?\n" ++
  "        # threads are scheduled: wait by letting the others run a\n" ++
  "        # millisecond at a time (one of them may be the writer), asking\n" ++
  "        # again after each, until the time is up\n" ++
  "        t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond)\n" ++
  "        begin\n" ++
  "          while got.all? \{ |b| b == 0 }\n" ++
  "            break if now != -1 && Process.clock_gettime(Process::CLOCK_MONOTONIC, :millisecond) - t0 >= now\n" ++
  "            IO.__park\n" ++
  "            got = IO.__poll(fds, ints, 0)\n" ++
  "          end\n" ++
  "        ensure\n" ++
  "          IO.__unpark\n" ++
  "        end\n" ++
  "      elsif Thread.current != Thread.main\n" ++
  "        IO.__park\n" ++
  "      elsif fds.empty? && now == -1\n" ++
  "        # nothing to wait for and nobody left to wake it: the main thread's\n" ++
  "        # bare sleep, which is a no-op here\n" ++
  "        nil\n" ++
  "      elsif now == -1 && __sel_stuck?(ent.map \{ |e| e[2] })\n" ++
  "        raise IOError, \"deadlock: waiting on a pipe with nothing in it, and this interpreter runs thread bodies to completion, so nothing is left that could write to it\"\n" ++
  "      else\n" ++
  "        got = IO.__poll(fds, ints, now)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    ent.map do |fd, _|\n" ++
  "      fd.nil? ? 7 : got[fds.index(fd)]\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.select(*args)\n" ++
  "    unless args.size >= 1 && args.size <= 4\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1..4)\"\n" ++
  "    end\n" ++
  "    r, w, e, timeout = args\n" ++
  "    ms = __sel_ms(timeout)\n" ++
  "    sets = [r, w, e].map do |a|\n" ++
  "      if a.nil?\n" ++
  "        []\n" ++
  "      else\n" ++
  "        raise TypeError, \"wrong argument type \" + a.class.to_s + \" (expected Array)\" unless a.is_a?(Array)\n" ++
  "        a.map do |o|\n" ++
  "          io = __sel_io(o)\n" ++
  "          raise IOError, \"closed stream\" if io.closed?\n" ++
  "          [o, io]\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    ent = []\n" ++
  "    sets[0].each \{ |o, io| ent << [io.__sel_fd, 1, io] }\n" ++
  "    sets[1].each \{ |o, io| ent << [io.__sel_fd, 2, io] }\n" ++
  "    # bytes #getc read ahead are ready now, whatever the descriptor says\n" ++
  "    ms = 0 if sets[0].any? \{ |o, io| io.__sel_pending? }\n" ++
  "    got = __sel_wait(ent, ms)\n" ++
  "    nr = sets[0].size\n" ++
  "    rd = []\n" ++
  "    sets[0].each_with_index do |pair, i|\n" ++
  "      rd << pair[0] if pair[1].__sel_pending? || (got[i] & 5) != 0\n" ++
  "    end\n" ++
  "    wr = []\n" ++
  "    sets[1].each_with_index do |pair, i|\n" ++
  "      wr << pair[0] if (got[nr + i] & 6) != 0\n" ++
  "    end\n" ++
  "    return nil if rd.empty? && wr.empty?\n" ++
  "    [rd, wr, []]\n" ++
  "  end\n" ++
  "\n" ++
  "  def __sel_fd = @__io_fd\n" ++
  "  def __sel_pending? = !@__io_rbuf.nil? && !@__io_rbuf.empty?\n" ++
  "\n" ++
  "  # the events of `events` that are ready within `timeout`, or nil\n" ++
  "  def __wait_for(events, timeout)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    ms = IO.__sel_ms(timeout)\n" ++
  "    int = ((events & READABLE) != 0 ? 1 : 0) | ((events & WRITABLE) != 0 ? 2 : 0)\n" ++
  "    b = IO.__sel_wait([[__sel_fd, int, self]], ms)[0]\n" ++
  "    m = 0\n" ++
  "    m |= READABLE if (events & READABLE) != 0 && (b & 5) != 0\n" ++
  "    m |= WRITABLE if (events & WRITABLE) != 0 && (b & 6) != 0\n" ++
  "    m == 0 ? nil : m\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__wait_mode(sym)\n" ++
  "    case sym\n" ++
  "    when :r, :read, :readable then READABLE\n" ++
  "    when :w, :write, :writable then WRITABLE\n" ++
  "    when :rw, :read_write, :readable_writable then READABLE | WRITABLE\n" ++
  "    else raise ArgumentError, \"unsupported mode: \" + sym.to_s\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # ruby's two forms: wait(events, timeout) answers the ready events, and\n" ++
  "  # wait(timeout, *modes) -- in any order -- answers self\n" ++
  "  def wait(*args)\n" ++
  "    if args.size != 2 || args[0].is_a?(Symbol) || args[1].is_a?(Symbol)\n" ++
  "      events = 0\n" ++
  "      given = false\n" ++
  "      timeout = nil\n" ++
  "      args.each do |a|\n" ++
  "        if a.is_a?(Symbol)\n" ++
  "          events |= IO.__wait_mode(a)\n" ++
  "        elsif !given\n" ++
  "          IO.__sel_ms(a)\n" ++
  "          given = true\n" ++
  "          timeout = a\n" ++
  "        else\n" ++
  "          raise ArgumentError, \"timeout given more than once\"\n" ++
  "        end\n" ++
  "      end\n" ++
  "      events = READABLE if events == 0\n" ++
  "      return true if (events & READABLE) != 0 && __sel_pending?\n" ++
  "      __wait_for(events, timeout) ? self : nil\n" ++
  "    else\n" ++
  "      events = args[0].to_int\n" ++
  "      raise ArgumentError, \"Events must be positive integer!\" if events <= 0\n" ++
  "      return READABLE if (events & READABLE) != 0 && __sel_pending?\n" ++
  "      __wait_for(events, args[1])\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def wait_readable(timeout = nil)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    return true if __sel_pending?\n" ++
  "    __wait_for(READABLE, timeout) ? self : nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def wait_writable(timeout = nil)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    __wait_for(WRITABLE, timeout) ? self : nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # A File and the three standard streams: a descriptor stream's pair is the\n" ++
  "  # layer's (IO#__fd_read_nonblock, core_prelude_k). A File is always ready,\n" ++
  "  # and standard input is the buffer Kernel#gets reads, all of it here.\n" ++
  "  def read_nonblock(len, buf = nil, exception: true)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    len = len.to_int\n" ++
  "    raise ArgumentError, \"negative length \" + len.to_s + \" given\" if len < 0\n" ++
  "    if __sel_fd.nil?\n" ++
  "      begin\n" ++
  "        return sysread(len, buf)\n" ++
  "      rescue EOFError\n" ++
  "        raise if exception\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "    end\n" ++
  "    raise IOError, \"not opened for reading\" unless __sel_fd == 0\n" ++
  "    s = self.read(len)\n" ++
  "    if s.nil?\n" ++
  "      buf.clear unless buf.nil?\n" ++
  "      return nil unless exception\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    return s if buf.nil?\n" ++
  "    buf.replace(s)\n" ++
  "  end\n" ++
  "\n" ++
  "  def write_nonblock(s, exception: true)\n" ++
  "    raise IOError, \"closed stream\" if closed?\n" ++
  "    syswrite(s.to_s)\n" ++
  "  end\n" ++
  "end\n" ++
  // ⚠ slice_before / slice_after were in the LIST this interpreter uses to
  // decide whether a name exists, with nothing behind them -- so the name was
  // claimed and every call, block form included, was a NoMethodError. Written
  // here over #each, which is the only thing they need, so Array, Hash, Range
  // and every `include Enumerable` class get one implementation between them.
  //
  // The two refuse DIFFERENTLY when given both a pattern and a block, which is
  // ruby's wording and not a slip: slice_before reports the argument count and
  // slice_after says "both pattern and block are given".
  "module Enumerable\n" ++
  "  def slice_before(*args, &blk)\n" ++
  "    if args.size > 1\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1)\"\n" ++
  "    elsif args.size > 0 && blk\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0)\"\n" ++
  "    elsif args.size == 0 && blk.nil?\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given 0, expected 1)\"\n" ++
  "    end\n" ++
  "    pat = args[0]\n" ++
  "    out = []\n" ++
  "    cur = nil\n" ++
  // a receiver whose #each yields SEVERAL values per element hands them to the
  // block as several arguments, so `|x|` took the first and threw the rest
  // away: `yield 1, 2` is the element `[1, 2]` here, as it is in ruby.
  "    each do |*a9|\n" ++
  "      x = a9.size == 1 ? a9[0] : a9\n" ++
  "      hit = blk ? blk.call(x) : (pat === x)\n" ++
  "      if cur.nil?\n" ++
  "        cur = [x]\n" ++
  "      elsif hit\n" ++
  "        out << cur\n" ++
  "        cur = [x]\n" ++
  "      else\n" ++
  "        cur << x\n" ++
  "      end\n" ++
  "    end\n" ++
  "    out << cur unless cur.nil?\n" ++
  // (an enumerator of unknown size, as ruby's is: how many slices there are
  // is what the walk decided)
  "    out.to_enum\n" ++
  "  end\n" ++
  "\n" ++
  "  def slice_after(*args, &blk)\n" ++
  "    if args.size > 1\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1)\"\n" ++
  "    elsif args.size > 0 && blk\n" ++
  "      raise ArgumentError, \"both pattern and block are given\"\n" ++
  "    elsif args.size == 0 && blk.nil?\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given 0, expected 1)\"\n" ++
  "    end\n" ++
  "    pat = args[0]\n" ++
  "    out = []\n" ++
  "    cur = []\n" ++
  "    each do |*a9|\n" ++
  "      x = a9.size == 1 ? a9[0] : a9\n" ++
  "      cur << x\n" ++
  "      hit = blk ? blk.call(x) : (pat === x)\n" ++
  "      if hit\n" ++
  "        out << cur\n" ++
  "        cur = []\n" ++
  "      end\n" ++
  "    end\n" ++
  "    out << cur unless cur.empty?\n" ++
  "    out.to_enum\n" ++
  "  end\n" ++
  "end\n";

// Time#strftime, and the name tables it reads. The interpreter's Time answers
// its fields natively; the FORMATTING is one function over those fields, so it
// lives here rather than in an arm per directive. Logger's default line is the
// first caller that needed it, and the time groups are the rest.
let core_prelude_e =
  "class Time\n" ++
  "  # Time.new(\"2020-12-24 15:56:17 +09:00\"), ruby's strict one-String form.\n" ++
  "  # A malformed string is \"can't parse:\" -- ruby's per-field messages say\n" ++
  "  # more, and the spec accepts either. The fraction is cut to `precision`\n" ++
  "  # digits (9 unless given; nil or negative keeps them all).\n" ++
  "  def self.__new_from_s(str, kw)\n" ++
  "    raise ArgumentError, \"time string should have ASCII compatible encoding\" unless str.encoding.ascii_compatible?\n" ++
  "    prec = 9\n" ++
  "    if kw && kw.key?(:precision)\n" ++
  "      pv = kw[:precision]\n" ++
  "      prec = if pv.nil? then nil\n" ++
  "             elsif Integer === pv then pv\n" ++
  "             elsif Numeric === pv then pv.to_i\n" ++
  "             elsif pv.respond_to?(:to_int) then pv.to_int\n" ++
  "             else raise TypeError, \"no implicit conversion of #\{pv.class} into Integer\"\n" ++
  "             end\n" ++
  "    end\n" ++
  "    m = /\\A(\\d\{4,})(?:-(\\d\\d)-(\\d\\d)[ T](\\d\\d):(\\d\\d):(\\d\\d)(?:\\.(\\d+))? ?(Z|UTC|[+-]\\d\\d(?::?\\d\\d(?::?\\d\\d)?)?)?)?\\z/.match(str)\n" ++
  "    raise ArgumentError, \"no time information\" if !m && /\\A\\d\{4,}-\\d\\d(?:-\\d\\d)?\\z/.match?(str)\n" ++
  "    raise ArgumentError, \"can't parse: \" + str.inspect unless m\n" ++
  "    zone = m[8] ? (m[8] == \"Z\" ? \"UTC\" : m[8]) : (kw ? kw[:in] : nil)\n" ++
  "    return new(m[1].to_i, 1, 1, 0, 0, 0, zone) unless m[2]\n" ++
  "    mon, mday, hour, min, sec = m[2].to_i, m[3].to_i, m[4].to_i, m[5].to_i, m[6].to_i\n" ++
  "    raise ArgumentError, \"mon out of range\" unless mon.between?(1, 12)\n" ++
  "    raise ArgumentError, \"mday out of range\" unless mday.between?(1, 31)\n" ++
  "    raise ArgumentError, \"hour out of range\" unless hour <= 24\n" ++
  "    raise ArgumentError, \"min out of range\" unless min < 60\n" ++
  "    raise ArgumentError, \"sec out of range\" unless sec <= 60\n" ++
  "    frac = m[7] || \"\"\n" ++
  "    frac = frac[0, prec] if prec && prec >= 0\n" ++
  "    s = frac.empty? ? sec : Rational(sec * 10**frac.length + frac.to_i, 10**frac.length)\n" ++
  "    new(m[1].to_i, mon, mday, hour, min, s, zone)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The calendar arguments of Time.local / .utc / .new, converted and checked\n" ++
  "  # the way time.c's time_arg does, answered as [year, mon, mday, hour, min,\n" ++
  "  # sec] with sec an Integer or an exact Rational (a 7th usec folded in).\n" ++
  "  # ⚠ The native constructors read VInts and nothing else, so \"12\", :dec,\n" ++
  "  # an object with #to_int and 2000.0 were all the default -- Time.local(\"2000\")\n" ++
  "  # was 1970 -- and no field was range-checked: Time.local(2008, 16) rolled\n" ++
  "  # into 2009. Measured one message at a time against the reference, which\n" ++
  "  # checks the bit WIDTH first (\"argument out of range\") and the calendar\n" ++
  "  # second (\"mon out of range\"), so month 13 and month 16 differ.\n" ++
  "  def self.__cname(v) = v.nil? ? \"nil\" : (v == true ? \"true\" : (v == false ? \"false\" : v.class.to_s))\n" ++
  "  def self.__int(v)\n" ++
  "    return v if Integer === v\n" ++
  "    return Integer(v, 10) if String === v\n" ++
  "    raise TypeError, \"no implicit conversion of #\{__cname(v)} into Integer\" unless v.respond_to?(:to_int)\n" ++
  "    v.to_int\n" ++
  "  end\n" ++
  "  def self.__ubits(v, bits)\n" ++
  "    n = __int(v)\n" ++
  "    raise ArgumentError, \"argument out of range\" if n < 0 || n >= (1 << bits)\n" ++
  "    n\n" ++
  "  end\n" ++
  "  def self.__exact(v)\n" ++
  "    return v if Integer === v || Rational === v\n" ++
  "    if Float === v\n" ++
  "      raise FloatDomainError, v.to_s unless v.finite?\n" ++
  "      return v.to_r\n" ++
  "    end\n" ++
  "    return v.to_int if !v.nil? && v.respond_to?(:to_int)\n" ++
  "    raise TypeError, \"can't convert #\{__cname(v)} into an exact number\"\n" ++
  "  end\n" ++
  "  def self.__civil(a, form)\n" ++
  "    n = a.size\n" ++
  "    if form == :new\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given #\{n}, expected 0..7)\" if n > 7\n" ++
  "    elsif n == 0 || n == 9 || n > 10\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given #\{n}, expected 1..8)\"\n" ++
  "    end\n" ++
  "    # ten are C's struct tm order: sec, min, hour, mday, mon, year, and four\n" ++
  "    # that are ignored\n" ++
  "    a0 = a\n" ++
  "    a = [a[5], a[4], a[3], a[2], a[1], a[0]] if n == 10 && form != :new\n" ++
  "    y = __int(a[0])\n" ++
  "    mon = a[1]\n" ++
  "    if mon.nil?\n" ++
  "      mon = 1\n" ++
  "    else\n" ++
  "      s = String === mon ? mon : (mon.respond_to?(:to_str) ? mon.to_str : nil)\n" ++
  "      i = s && s.length == 3 ? %w[jan feb mar apr may jun jul aug sep oct nov dec].index(s.downcase) : nil\n" ++
  "      mon = i ? i + 1 : __ubits(s || mon, 4)\n" ++
  "    end\n" ++
  "    mday = a[2].nil? ? 1 : __ubits(a[2], 5)\n" ++
  "    hour = a[3].nil? ? 0 : __ubits(a[3], 5)\n" ++
  "    min = a[4].nil? ? 0 : __ubits(a[4], 6)\n" ++
  "    if n == 7 && form != :new && !a[6].nil?\n" ++
  "      # a seventh argument is microseconds, and the second is then whole\n" ++
  "      sec = a[5].nil? ? 0 : __ubits(a[5], 6)\n" ++
  "      u = String === a[6] ? __int(a[6]) : __exact(a[6])\n" ++
  "      raise ArgumentError, \"subsecx out of range\" if u < 0 || u >= 1_000_000\n" ++
  "      sub = u == 0 ? 0 : Rational(u, 1_000_000)\n" ++
  "    elsif a[5].nil?\n" ++
  "      sec = 0\n" ++
  "      sub = 0\n" ++
  "    elsif String === a[5]\n" ++
  "      sec = __ubits(a[5], 6)\n" ++
  "      sub = 0\n" ++
  "    else\n" ++
  "      x = __exact(a[5])\n" ++
  "      sec = x.floor\n" ++
  "      sub = x - sec\n" ++
  "      raise ArgumentError, \"argument out of range\" if sec < 0 || sec >= 64\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"mon out of range\" unless mon.between?(1, 12)\n" ++
  "    raise ArgumentError, \"mday out of range\" unless mday.between?(1, 31)\n" ++
  "    raise ArgumentError, \"hour out of range\" if hour > 24\n" ++
  "    raise ArgumentError, \"min out of range\" if min > (hour == 24 ? 0 : 59)\n" ++
  "    raise ArgumentError, \"sec out of range\" if sec > (hour == 24 ? 0 : 60)\n" ++
  "    r = [y, mon, mday, hour, min, sub == 0 ? sec : sec + sub]\n" ++
  "    # the ten-argument form's ninth is isdst, which picks between the two\n" ++
  "    # readings of a repeated hour\n" ++
  "    r << (a0[8] ? true : false) if n == 10 && form != :new\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  # ---- Marshal's Time format (time.c time_mdump / time_mload) ----------\n" ++
  "  # Eight bytes: the UTC fields packed into two little-endian words, with a\n" ++
  "  # year outside 1900..1900+0xffff appended as its distance. The zone, the\n" ++
  "  # offset and the digits under the microsecond ride beside it as ivars of\n" ++
  "  # the dumped String; Marshal asks __mdump_ivars for those.\n" ++
  "  # (self. throughout: a Time SUBCLASS reaches these, and a bare call on it\n" ++
  "  # does not find the builtin readers)\n" ++
  "  def _dump(limit = nil)\n" ++
  "    u = self.getutc\n" ++
  "    year = u.year\n" ++
  "    ext = nil\n" ++
  "    if year > 1900 + 0xffff\n" ++
  "      ext = year - (1900 + 0xffff)\n" ++
  "      year = 1900 + 0xffff\n" ++
  "    elsif year < 1900\n" ++
  "      ext = 1900 - year\n" ++
  "      year = 1900\n" ++
  "    end\n" ++
  "    p = 1 << 31 | (self.utc? ? 1 : 0) << 30 | (year - 1900) << 14 | (u.mon - 1) << 10 | u.mday << 5 | u.hour\n" ++
  "    s = u.min << 26 | u.sec << 20 | u.usec\n" ++
  "    str = [p, s].pack(\"VV\")\n" ++
  "    if ext\n" ++
  "      bytes = []\n" ++
  "      e = ext\n" ++
  "      while e > 0\n" ++
  "        bytes << (e & 0xff)\n" ++
  "        e >>= 8\n" ++
  "      end\n" ++
  "      str << (bytes.size + 5).chr << bytes.pack(\"C*\")\n" ++
  "    end\n" ++
  "    str\n" ++
  "  end\n" ++
  "  private :_dump\n" ++
  "\n" ++
  "  def __mdump_ivars\n" ++
  "    pairs = []\n" ++
  "    ns = self.nsec % 1000\n" ++
  "    if ns != 0\n" ++
  "      pairs << [:nano_num, ns] << [:nano_den, 1]\n" ++
  "      b0 = (ns / 100) << 4 | (ns / 10 % 10)\n" ++
  "      b1 = (ns % 10) << 4\n" ++
  "      pairs << [:submicro, (b1 == 0 ? [b0] : [b0, b1]).pack(\"C*\")]\n" ++
  "    end\n" ++
  "    pairs << [:offset, self.utc_offset] unless self.utc?\n" ++
  "    # a timezone OBJECT is written as its #name (and one without a name\n" ++
  "    # cannot be dumped: the NoMethodError is ruby's too)\n" ++
  "    z = self.zone\n" ++
  "    z = z.name unless z.nil? || String === z\n" ++
  "    pairs << [:zone, z]\n" ++
  "    pairs\n" ++
  "  end\n" ++
  "  private :__mdump_ivars\n" ++
  "\n" ++
  "  def self._load(str, hidden = nil)\n" ++
  "    str = str.to_str unless String === str\n" ++
  "    h = hidden || \{}\n" ++
  "    buf = str.b\n" ++
  "    raise TypeError, \"marshaled time format differ\" if buf.bytesize < 8\n" ++
  "    p, s = buf.unpack(\"VV\")\n" ++
  "    if p & (1 << 31) == 0\n" ++
  "      # the old format: seconds and microseconds since the epoch\n" ++
  "      return at(p, s)\n" ++
  "    end\n" ++
  "    p &= ~(1 << 31)\n" ++
  "    gmt = (p >> 30) & 1\n" ++
  "    year = h[\"year\"] || ((p >> 14) & 0xffff) + 1900\n" ++
  "    if buf.bytesize > 8\n" ++
  "      n = buf.getbyte(8)\n" ++
  "      n = n > 127 ? n - 256 : n\n" ++
  "      len = n > 4 ? n - 5 : n\n" ++
  "      raise TypeError, \"marshaled time format differ\" if len < 0 || len > buf.bytesize - 9\n" ++
  "      ext = 0\n" ++
  "      buf.byteslice(9, len).bytes.reverse_each \{ |b| ext = (ext << 8) | b }\n" ++
  "      year = year == 1900 ? year - ext : year + ext\n" ++
  "    end\n" ++
  "    mon = (p >> 10) & 0xf\n" ++
  "    if mon >= 12\n" ++
  "      mon -= 12\n" ++
  "      year += 1\n" ++
  "    end\n" ++
  "    mday = (p >> 5) & 0x1f\n" ++
  "    hour = p & 0x1f\n" ++
  "    min = (s >> 26) & 0x3f\n" ++
  "    sec = (s >> 20) & 0x3f\n" ++
  "    usec = s & 0xfffff\n" ++
  "    ns = usec * 1000\n" ++
  "    if h[\"nano_num\"]\n" ++
  "      ns += Rational(h[\"nano_num\"], h[\"nano_den\"] || 1)\n" ++
  "    elsif h[\"submicro\"]\n" ++
  "      d = h[\"submicro\"].bytes\n" ++
  "      sub = 0\n" ++
  "      if d.size > 0 && (d[0] >> 4) < 10 && (d[0] & 0xf) < 10\n" ++
  "        sub = (d[0] >> 4) * 100 + (d[0] & 0xf) * 10\n" ++
  "        sub += d[1] >> 4 if d.size > 1 && (d[1] >> 4) < 10\n" ++
  "      end\n" ++
  "      ns += sub\n" ++
  "    end\n" ++
  "    t = at(Time.utc(year, mon + 1, mday, hour, min, sec).to_i, ns, :nsec)\n" ++
  "    # the dumped Time's own ivars were copied onto the data String\n" ++
  "    str.instance_variables.each \{ |n| t.instance_variable_set(n, str.instance_variable_get(n)) }\n" ++
  "    zone = h[\"zone\"]\n" ++
  "    # a class with .find_timezone turns the name back into its zone object\n" ++
  "    if zone && gmt != 1 && respond_to?(:find_timezone)\n" ++
  "      zobj = begin\n" ++
  "               find_timezone(zone)\n" ++
  "             rescue StandardError\n" ++
  "               nil\n" ++
  "             end\n" ++
  "      if zobj && !(String === zobj)\n" ++
  "        t.localtime(zobj)\n" ++
  "        return t\n" ++
  "      end\n" ++
  "    end\n" ++
  "    if gmt == 1\n" ++
  "      t.utc\n" ++
  "    elsif (off = h[\"offset\"])\n" ++
  "      # a zone name that is this machine's own at that instant makes the time\n" ++
  "      # local again; otherwise it keeps the offset -- and the NAME it was\n" ++
  "      # dumped with (a fixed offset otherwise has none)\n" ++
  "      unless zone && t.utc_offset == off && t.zone == zone\n" ++
  "        t.localtime(off)\n" ++
  "        t.instance_variable_set(:@__tzo, zone) if String === zone\n" ++
  "      end\n" ++
  "    end\n" ++
  "    t\n" ++
  "  end\n" ++
  "  private_class_method :_load\n" ++
  "\n" ++
  "  def deconstruct_keys(keys)\n" ++
  "    unless keys.nil? || Array === keys\n" ++
  "      raise TypeError, \"wrong argument type #\{keys.class} (expected Array or nil)\"\n" ++
  "    end\n" ++
  "    all = [:year, :month, :day, :yday, :wday, :hour, :min, :sec, :subsec, :dst, :zone]\n" ++
  "    h = \{}\n" ++
  "    (keys.nil? ? all : keys).each do |k|\n" ++
  "      next unless all.include?(k)\n" ++
  "      h[k] = case k\n" ++
  "             when :year then year\n" ++
  "             when :month then month\n" ++
  "             when :day then day\n" ++
  "             when :yday then yday\n" ++
  "             when :wday then wday\n" ++
  "             when :hour then hour\n" ++
  "             when :min then min\n" ++
  "             when :sec then sec\n" ++
  "             when :subsec then subsec\n" ++
  "             when :dst then dst?\n" ++
  "             else zone\n" ++
  "             end\n" ++
  "    end\n" ++
  "    h\n" ++
  "  end\n" ++
  "\n" ++
  "  # ---- strftime ---------------------------------------------------------\n" ++
  "  # ONE engine for Time, Date and DateTime. Each hands it the fields as an\n" ++
  "  # Array -- [year, mon, mday, yday, wday, hour, min, sec, subsec, utc_offset,\n" ++
  "  # utc?, zone (a String, or a Proc asked only when %Z is), epoch seconds,\n" ++
  "  # %Q allowed] -- so the directives, flags and widths are written once.\n" ++
  "  # ⚠ Date and DateTime had printers of their own, and each knew a different\n" ++
  "  # subset: Date had no %U %W %V %G %g %c %x %X %T %R and no flags or widths at\n" ++
  "  # all, so \"%-m\" and \"%10h\" came back verbatim. Time lacked the week numbers\n" ++
  "  # and padded no alphabetic field. Three printers, three answers.\n" ++
  "  def self.__strf(fmt, f)\n" ++
  "    fmt = fmt.to_str unless String === fmt\n" ++
  "    out = +\"\"\n" ++
  "    i = 0\n" ++
  "    n = fmt.length\n" ++
  "    while i < n\n" ++
  "      c = fmt[i]\n" ++
  "      if c != \"%\"\n" ++
  "        out << c\n" ++
  "        i += 1\n" ++
  "        next\n" ++
  "      end\n" ++
  "      j = i + 1\n" ++
  "      flags = +\"\"\n" ++
  "      pad = nil\n" ++
  "      while j < n && \"-_0^#\".include?(fmt[j])\n" ++
  "        flags << fmt[j]\n" ++
  "        # of \"_\" and \"0\" the LAST one given decides the padding\n" ++
  "        pad = fmt[j] if fmt[j] == \"_\" || fmt[j] == \"0\"\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      # the width may come before the colons (%-010:z) or after them\n" ++
  "      wid = +\"\"\n" ++
  "      while j < n && fmt[j] >= \"0\" && fmt[j] <= \"9\"\n" ++
  "        wid << fmt[j]\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      colons = 0\n" ++
  "      while j < n && fmt[j] == \":\"\n" ++
  "        colons += 1\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      while j < n && fmt[j] >= \"0\" && fmt[j] <= \"9\"\n" ++
  "        wid << fmt[j]\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      # E and O are the locale's alternative forms, and only before the\n" ++
  "      # conversions that have one; this locale's are the plain forms\n" ++
  "      if j + 1 < n && ((fmt[j] == \"E\" && \"cCxXyY\".include?(fmt[j + 1])) ||\n" ++
  "                       (fmt[j] == \"O\" && \"deHkIlmMSuUVwWy\".include?(fmt[j + 1])))\n" ++
  "        j += 1\n" ++
  "      end\n" ++
  "      if j >= n\n" ++
  "        out << fmt[i, n - i]\n" ++
  "        break\n" ++
  "      end\n" ++
  "      conv = fmt[j]\n" ++
  "      width = wid.empty? ? nil : wid.to_i\n" ++
  "      piece = if colons > 0\n" ++
  "                conv == \"z\" ? __strf_off(f, colons, flags, width) : nil\n" ++
  "              else\n" ++
  "                __strf1(conv, flags, pad, width, f)\n" ++
  "              end\n" ++
  "      out << (piece.nil? ? fmt[i, j - i + 1] : piece)\n" ++
  "      i = j + 1\n" ++
  "    end\n" ++
  "    out.force_encoding(fmt.encoding)\n" ++
  "  end\n" ++
  "\n" ++
  "  # a number: \"-\" drops the padding, \"_\" pads with spaces and \"0\" with zeros;\n" ++
  "  # the zeros go after the sign, the spaces before it\n" ++
  "  def self.__strf_num(v, width, flags, pad, defpad, defw)\n" ++
  "    s = v.abs.to_s\n" ++
  "    w = width || defw\n" ++
  "    return (v < 0 ? \"-\" + s : s) if flags.include?(\"-\") || w.nil?\n" ++
  "    p = pad || defpad\n" ++
  "    if p == \"_\"\n" ++
  "      s = v < 0 ? \"-\" + s : s\n" ++
  "      s.length >= w ? s : \" \" * (w - s.length) + s\n" ++
  "    else\n" ++
  "      s = \"0\" * (w - s.length) + s if s.length < w\n" ++
  "      v < 0 ? \"-\" + s : s\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # a word: \"^\" upcases, \"#\" swaps (upcases a name, downcases %p and %Z), and\n" ++
  "  # a width pads with spaces unless \"0\" says zeros\n" ++
  "  def self.__strf_str(s, width, flags, pad, chcase_up = true)\n" ++
  "    s = s.upcase if flags.include?(\"^\")\n" ++
  "    s = (chcase_up ? s.upcase : s.downcase) if flags.include?(\"#\")\n" ++
  "    return s if flags.include?(\"-\") || width.nil? || s.length >= width\n" ++
  "    (pad == \"0\" ? \"0\" : \" \") * (width - s.length) + s\n" ++
  "  end\n" ++
  "\n" ++
  "  # A Rational offset shows rounded to the nearest second, and the '-'\n" ++
  "  # flag on a UTC time is RFC 3339's \"unknown offset\", -0000.\n" ++
  "  def self.__strf_off(f, colons, flags = \"\", width = nil)\n" ++
  "    off = f[9].round\n" ++
  "    sign = off < 0 || (f[10] && flags.include?(\"-\")) ? \"-\" : \"+\"\n" ++
  "    off = off.abs\n" ++
  "    h = off / 3600\n" ++
  "    m = (off % 3600) / 60\n" ++
  "    s = off % 60\n" ++
  "    rest = case colons\n" ++
  "           when 0 then format(\"%02d\", m)\n" ++
  "           when 1 then format(\":%02d\", m)\n" ++
  "           else format(\":%02d:%02d\", m, s)\n" ++
  "           end\n" ++
  "    # a width pads the HOURS, with spaces (the sign moving to the digits)\n" ++
  "    # under \"_\" and with zeros otherwise\n" ++
  "    hw = width ? [width - 1 - rest.length, 2].max : 2\n" ++
  "    if flags.include?(\"_\")\n" ++
  "      hs = h.to_s\n" ++
  "      \" \" * [hw - hs.length, 0].max + sign + hs + rest\n" ++
  "    else\n" ++
  "      sign + h.to_s.rjust(hw, \"0\") + rest\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # ISO 8601's week-numbering year and week: the week belongs to the year\n" ++
  "  # its Thursday is in\n" ++
  "  def self.__strf_iso(f)\n" ++
  "    y = f[0]\n" ++
  "    wd = (f[4] + 6) % 7\n" ++
  "    thu = f[3] - 1 - wd + 3\n" ++
  "    ylen = ->(yy) \{ (yy % 4 == 0 && yy % 100 != 0) || yy % 400 == 0 ? 366 : 365 }\n" ++
  "    if thu < 0\n" ++
  "      y -= 1\n" ++
  "      thu += ylen.(y)\n" ++
  "    elsif thu >= ylen.(y)\n" ++
  "      thu -= ylen.(y)\n" ++
  "      y += 1\n" ++
  "    end\n" ++
  "    [y, thu / 7 + 1]\n" ++
  "  end\n" ++
  "\n" ++
  "  # the fraction of the second (exact: an Integer 0 or a Rational) to `w`\n" ++
  "  # digits, truncated and never rounded\n" ++
  "  def self.__strf_frac(sub, w)\n" ++
  "    (sub * 10**w).floor.to_s.rjust(w, \"0\")\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__strf1(conv, flags, pad, width, f)\n" ++
  "    h12 = f[5] % 12 == 0 ? 12 : f[5] % 12\n" ++
  "    case conv\n" ++
  "    when \"Y\" then __strf_num(f[0], width, flags, pad, \"0\", 4)\n" ++
  "    when \"C\" then __strf_num(f[0].div(100), width, flags, pad, \"0\", 2)\n" ++
  "    when \"y\" then __strf_num(f[0] % 100, width, flags, pad, \"0\", 2)\n" ++
  "    when \"m\" then __strf_num(f[1], width, flags, pad, \"0\", 2)\n" ++
  "    when \"d\" then __strf_num(f[2], width, flags, pad, \"0\", 2)\n" ++
  "    when \"e\" then __strf_num(f[2], width, flags, pad, \"_\", 2)\n" ++
  "    when \"j\" then __strf_num(f[3], width, flags, pad, \"0\", 3)\n" ++
  "    when \"H\" then __strf_num(f[5], width, flags, pad, \"0\", 2)\n" ++
  "    when \"k\" then __strf_num(f[5], width, flags, pad, \"_\", 2)\n" ++
  "    when \"I\" then __strf_num(h12, width, flags, pad, \"0\", 2)\n" ++
  "    when \"l\" then __strf_num(h12, width, flags, pad, \"_\", 2)\n" ++
  "    when \"M\" then __strf_num(f[6], width, flags, pad, \"0\", 2)\n" ++
  "    when \"S\" then __strf_num(f[7], width, flags, pad, \"0\", 2)\n" ++
  "    when \"L\" then __strf_frac(f[8], width || 3)\n" ++
  "    when \"N\" then __strf_frac(f[8], width || 9)\n" ++
  "    when \"s\" then __strf_num(f[12].floor, width, flags, pad, \"0\", 1)\n" ++
  "    when \"Q\" then f[13] ? __strf_num((f[12] * 1000).floor, width, flags, pad, \"0\", 1) : nil\n" ++
  "    when \"z\" then __strf_off(f, 0, flags, width)\n" ++
  "    when \"Z\"\n" ++
  "      z = f[11]\n" ++
  "      z = z.call if Proc === z\n" ++
  "      __strf_str(z.to_s, width, flags, pad, false)\n" ++
  "    when \"a\" then __strf_str(%w[Sun Mon Tue Wed Thu Fri Sat][f[4]], width, flags, pad)\n" ++
  "    when \"A\" then __strf_str(%w[Sunday Monday Tuesday Wednesday Thursday Friday Saturday][f[4]], width, flags, pad)\n" ++
  "    when \"b\", \"h\" then __strf_str(%w[Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec][f[1] - 1], width, flags, pad)\n" ++
  "    when \"B\" then __strf_str(%w[January February March April May June July August September October November December][f[1] - 1], width, flags, pad)\n" ++
  "    when \"p\" then __strf_str(f[5] < 12 ? \"AM\" : \"PM\", width, flags, pad, false)\n" ++
  "    when \"P\" then __strf_str(f[5] < 12 ? \"am\" : \"pm\", width, flags.delete(\"^\"), pad)\n" ++
  "    when \"u\" then __strf_num(f[4] == 0 ? 7 : f[4], width, flags, pad, \"0\", 1)\n" ++
  "    when \"w\" then __strf_num(f[4], width, flags, pad, \"0\", 1)\n" ++
  "    when \"U\" then __strf_num((f[3] - 1 + 7 - f[4]) / 7, width, flags, pad, \"0\", 2)\n" ++
  "    when \"W\" then __strf_num((f[3] - 1 + 7 - (f[4] + 6) % 7) / 7, width, flags, pad, \"0\", 2)\n" ++
  "    when \"G\" then __strf_num(__strf_iso(f)[0], width, flags, pad, \"0\", 4)\n" ++
  "    when \"g\" then __strf_num(__strf_iso(f)[0] % 100, width, flags, pad, \"0\", 2)\n" ++
  "    when \"V\" then __strf_num(__strf_iso(f)[1], width, flags, pad, \"0\", 2)\n" ++
  "    when \"n\" then \"\\n\"\n" ++
  "    when \"t\" then \"\\t\"\n" ++
  "    when \"%\" then \"%\"\n" ++
  "    when \"F\" then __strf_str(__strf(\"%Y-%m-%d\", f), width, flags, pad)\n" ++
  "    when \"D\", \"x\" then __strf_str(__strf(\"%m/%d/%y\", f), width, flags, pad)\n" ++
  "    when \"T\", \"X\" then __strf_str(__strf(\"%H:%M:%S\", f), width, flags, pad)\n" ++
  "    when \"R\" then __strf_str(__strf(\"%H:%M\", f), width, flags, pad)\n" ++
  "    when \"r\" then __strf_str(__strf(\"%I:%M:%S %p\", f), width, flags, pad)\n" ++
  "    when \"c\" then __strf_str(__strf(\"%a %b %e %H:%M:%S %Y\", f), width, flags, pad)\n" ++
  "    when \"v\" then __strf_str(__strf(\"%e-%^b-%4Y\", f), width, flags, pad)\n" ++
  "    when \"+\" then __strf_str(__strf(\"%a %b %e %H:%M:%S %Z %Y\", f), width, flags, pad)\n" ++
  "    else nil\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def strftime(fmt)\n" ++
  "    z = -> \{\n" ++
  "      zz = zone\n" ++
  "      String === zz || zz.nil? ? zz.to_s : (zz.respond_to?(:abbr) ? zz.abbr(self) : (zz.respond_to?(:name) ? zz.name : zz.to_s))\n" ++
  "    }\n" ++
  "    Time.__strf(fmt, [year, mon, day, yday, wday, hour, min, sec, subsec, utc_offset, utc?, z, to_i, false])\n" ++
  "  end\n" ++
  "end\n";

// File::Stat, and the Process ids its ownership questions need. This is the
// one stat(2) snapshot ruby's File::Stat is, and every File class-method that
// was refusing for want of one (atime/mtime/ctime/ftype and the KIND and
// PERMISSION-BIT predicates) now answers from it. See the class's own comment
// for why the read goes through stat(1) and how the dialect is chosen.
let core_prelude_f =
  "# The four id(1) answers Process did not have. They cannot change inside a\n" ++
  "# process, so each is asked once and kept -- the alternative is a subprocess\n" ++
  "# per `owned?`, and File::Stat calls it on every file.\n" ++
  "module Process\n" ++
  "  # ⚠ `system` set no status at all, so `system(\"false\"); $?.exitstatus` was a\n" ++
  "  #   NoMethodError on nil -- the status of the command that just ran is the\n" ++
  "  #   first thing its caller asks for. This carries the exit code and nothing\n" ++
  "  #   else: there are no signals to report here, because `run` gives back an\n" ++
  "  #   exit code and not a wait(2) status.\n" ++
  "  class Status\n" ++
  "    def exitstatus = @__st\n" ++
  "    def to_i = @__st\n" ++
  "    def success? = (@__st == 0)\n" ++
  "    def exited? = true\n" ++
  "    def signaled? = false\n" ++
  "    def termsig = nil\n" ++
  "    def stopped? = false\n" ++
  "    def stopsig = nil\n" ++
  "    def pid = (@__pid || Process.pid)\n" ++
  "    def to_s = \"pid #\{pid} exit #\{@__st}\"\n" ++
  "    # Process::Status.wait with no children answers a status whose pid is -1\n" ++
  "    # (and exitstatus 0) rather than raising, which is ruby's documented\n" ++
  "    # difference from Process.wait; with one, it is Process.wait's status.\n" ++
  "    # Process::Status.wait answers the status and leaves $? as it was (it\n" ++
  "    # is the one waiting call that does not set it).\n" ++
  "    def self.wait(pid = -1, flags = 0)\n" ++
  "      last = $?\n" ++
  "      begin\n" ++
  "        got = Process.wait(pid, flags) && $?\n" ++
  "        Process.__set_last(last)\n" ++
  "        return got\n" ++
  "      rescue Errno::ECHILD\n" ++
  "        Process.__set_last(last)\n" ++
  "      end\n" ++
  "      s = allocate\n" ++
  "      s.instance_variable_set(:@__st, 0)\n" ++
  "      s.instance_variable_set(:@__pid, -1)\n" ++
  "      s\n" ++
  "    end\n" ++
  "    def inspect = \"#<Process::Status: #\{self}>\"\n" ++
  "    # two statuses are equal when they carry the same status (there is no\n" ++
  "    # #== above this one to defer to: `super` was a NoMethodError)\n" ++
  "    def ==(o) = (o.is_a?(Integer) ? o == @__st : (o.is_a?(Process::Status) ? o.to_i == to_i : false))\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module Kernel\n" ++
  "  # ⚠ Kernel#test -- the one-character file predicates. It did not exist, so\n" ++
  "  #   `test(?f, path)` was a NoMethodError. The letters are a contract: f is a\n" ++
  "  #   regular file, d a directory, e exists, r/w/x the permissions, s the SIZE\n" ++
  "  #   (or nil when empty, which is why it is not a predicate), z empty.\n" ++
  "  def test(cmd, file, file2 = nil)\n" ++
  "    c = cmd.is_a?(Integer) ? cmd.chr : cmd.to_s\n" ++
  "    file = file.to_path if !file.is_a?(String) && file.respond_to?(:to_path)\n" ++
  "    case c\n" ++
  "    when \"f\" then File.file?(file)\n" ++
  "    when \"d\" then File.directory?(file)\n" ++
  "    when \"e\" then File.exist?(file)\n" ++
  "    when \"r\" then File.readable?(file)\n" ++
  "    when \"w\" then File.writable?(file)\n" ++
  "    when \"x\" then File.executable?(file)\n" ++
  "    when \"s\" then (File.exist?(file) && File.size(file) > 0) ? File.size(file) : nil\n" ++
  "    when \"z\" then File.exist?(file) && File.size(file) == 0\n" ++
  "    when \"l\" then File.symlink?(file)\n" ++
  "    when \"S\" then File.socket?(file)\n" ++
  "    when \"p\" then File.pipe?(file)\n" ++
  "    # the real-uid forms answer as the effective ones: one uid here\n" ++
  "    when \"R\" then File.readable?(file)\n" ++
  "    when \"W\" then File.writable?(file)\n" ++
  "    when \"X\" then File.executable?(file)\n" ++
  "    when \"A\" then File.atime(file)\n" ++
  "    when \"C\" then File.ctime(file)\n" ++
  "    when \"M\" then File.mtime(file)\n" ++
  "    else raise ArgumentError, \"unknown command ?#\{c}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  module_function :test\n" ++
  "\n" ++
  "  # Kernel#open, as ruby 4.0's rb_f_open: an object that answers #to_open is\n" ++
  "  # asked for the thing to open (with the rest of the arguments, keywords as\n" ++
  "  # keywords, and a block given what it answers); anything else is a path\n" ++
  "  # (#to_path, then #to_str) for File.open, with at most a mode and a perm\n" ++
  "  # beside it. A leading \"|\" is NOT a command in 4.0 -- it is part of the\n" ++
  "  # name, so a missing \"|echo ok\" is ENOENT like any other missing file.\n" ++
  "  def open(*args, **kw, &blk)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1..3)\" if args.empty?\n" ++
  "    name = args.shift\n" ++
  "    if !name.is_a?(String) && name.respond_to?(:to_open)\n" ++
  "      obj = kw.empty? ? name.to_open(*args) : name.to_open(*args, **kw)\n" ++
  "      return blk ? yield(obj) : obj\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given #\{args.size + 1}, expected 1..3)\" if args.size > 2\n" ++
  "    n = if name.respond_to?(:to_path) then name.to_path\n" ++
  "        elsif name.is_a?(String) then name\n" ++
  "        elsif name.respond_to?(:to_str) then name.to_str\n" ++
  "        else raise TypeError, \"no implicit conversion of #\{name.nil? ? 'nil' : name.class} into String\"\n" ++
  "        end\n" ++
  "    File.open(n, *args, **kw, &blk)\n" ++
  "  end\n" ++
  "  module_function :open\n" ++
  "\n" ++
  "  # Kernel#spawn is Process.spawn (see there for what a child is here)\n" ++
  "  def spawn(*args) = Process.spawn(*args)\n" ++
  "  module_function :spawn\n" ++
  "\n" ++
  "  # ⚠ Kernel#select IS NOT DEFINED HERE, and the reason is worth the line.\n" ++
  "  #   Defining it (a zero timeout answers nil, anything else refuses) closed\n" ++
  "  #   one core/kernel row and BROKE corpus/199: `Array.instance_method(:\n" ++
  "  #   select).arity` went 0 -> -1, because instance_method found this\n" ++
  "  #   Kernel method before Array's own builtin. `select` is Enumerable's\n" ++
  "  #   name as much as Kernel's, and a module_function on Kernel sits in the\n" ++
  "  #   ancestry of every Array. One row is not worth changing what\n" ++
  "  #   Array#select reports about itself.\n" ++
  "end\n" ++
  "\n" ++
  "module GC\n" ++
  "\n" ++
  "  # ⚠ GC.stat and GC.config answer a HASH, so they are written here rather than\n" ++
  "  #   in the dispatcher -- the numbers themselves come from the arms, which is\n" ++
  "  #   where the collector's own bookkeeping lives.\n" ++
  "  #\n" ++
  "  #   THE KEYS ARE THIS COLLECTOR'S. It has no generations, no slots and no\n" ++
  "  #   compactor, so it does not answer heap_live_slots, major_gc_count or the\n" ++
  "  #   forty other names CRuby fills in. Inventing them would be worse than not\n" ++
  "  #   having them: a program that reads GC.stat to decide something would\n" ++
  "  #   decide it on fiction. :count and :time are real and are what the spec\n" ++
  "  #   asks for.\n" ++
  "  #   ...and :major_gc_count, which is not fiction here: this collector has\n" ++
  "  #   no minor collections, so every one it runs is a full (major) one.\n" ++
  "  def self.stat(arg = nil)\n" ++
  "    s = \{ count: GC.count, time: GC.total_time / 1_000_000, major_gc_count: GC.count, minor_gc_count: 0 }\n" ++
  "    unless arg.nil? || arg.is_a?(Symbol) || arg.is_a?(Hash)\n" ++
  "      raise TypeError, \"non-hash or symbol given\"\n" ++
  "    end\n" ++
  "    if arg.is_a?(Symbol)\n" ++
  "      raise ArgumentError, \"unknown key: #\{arg}\" unless s.key?(arg)\n" ++
  "      return s[arg]\n" ++
  "    end\n" ++
  "    # `GC.stat(hash)` FILLS the hash it is given and answers it -- keys already\n" ++
  "    # in it that the collector does not know are left alone, which the spec\n" ++
  "    # reads.\n" ++
  "    if arg.is_a?(Hash)\n" ++
  "      s.each \{ |k, v| arg[k] = v }\n" ++
  "      return arg\n" ++
  "    end\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  # GC.config, and the contract is the spec's: no argument answers the settings\n" ++
  "  # (with the global :implementation key), a Hash MERGES what it knows and\n" ++
  "  # ignores what it does not, nil answers the settings, and anything else is an\n" ++
  "  # ArgumentError. A global key is read-only and refused by name.\n" ++
  "  def self.config(arg = nil)\n" ++
  "    c = \{ implementation: \"mere-ruby\" }\n" ++
  "    return c if arg.nil?\n" ++
  "    unless arg.is_a?(Hash)\n" ++
  "      raise ArgumentError, \"expecting a Hash of options, got #\{arg.class}\"\n" ++
  "    end\n" ++
  "    if arg.key?(:implementation)\n" ++
  "      raise ArgumentError, 'Attempting to set read-only key \"Implementation\"'\n" ++
  "    end\n" ++
  "    # ...and every other key is ignored. This collector has no tunables, so\n" ++
  "    # there is nothing a caller could set; saying so by changing nothing is\n" ++
  "    # what \"ignores unknown keys\" means.\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  # @W$ PUBLIC, which is what ruby makes it -- GC.instance_methods(false) names\n" ++
  "  #   it and the spec calls it through `obj.extend(GC)` with an explicit\n" ++
  "  #   receiver. Marked private here it was a NoMethodError for a method that\n" ++
  "  #   exists.\n" ++
  "  def garbage_collect(**opts)\n" ++
  "    GC.start\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  def self.garbage_collect(**opts)\n" ++
  "    GC.start\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # GC::Profiler: the switch is real, the profile is empty. This collector\n" ++
  "  # keeps no per-run record, so while it is enabled there is nothing to\n" ++
  "  # report -- which is exactly what ruby answers before its first GC: an\n" ++
  "  # empty raw_data while enabled, nil while disabled, and a zero total.\n" ++
  "  module Profiler\n" ++
  "    @enabled = false\n" ++
  "    def self.enabled?; @enabled; end\n" ++
  "    def self.enable; @enabled = true; nil; end\n" ++
  "    def self.disable; @enabled = false; nil; end\n" ++
  "    def self.clear; nil; end\n" ++
  "    def self.raw_data; @enabled ? [] : nil; end\n" ++
  "    def self.result; +\"\"; end\n" ++
  "    def self.report(io = nil); nil; end\n" ++
  "    def self.total_time; 0.0; end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "\n" ++
  "module Process\n" ++
  "  def self.uid = (@__ruid ||= `id -ru`.to_i)\n" ++
  "  def self.gid = (@__rgid ||= `id -rg`.to_i)\n" ++
  "  def self.euid = (@__euid ||= `id -u`.to_i)\n" ++
  "  def self.egid = (@__egid ||= `id -g`.to_i)\n" ++
  "  # the supplementary groups, from the same id(1) the four ids come from\n" ++
  "  def self.groups = __groups.dup\n" ++
  "  def self.__groups = (@__groups ||= `id -G`.split.map(&:to_i))\n" ++
  "\n" ++
  "  # The id SETTERS. setuid(2) and friends take a uid_t, which an extern here\n" ++
  "  # cannot declare (its prototype would say int), so the call itself is out\n" ++
  "  # of reach -- but what an UNPRIVILEGED caller may do is fixed by POSIX: it\n" ++
  "  # may set an id only to one it already has (real or effective), and any\n" ++
  "  # other value is EPERM. That much is answered; a privileged caller, who\n" ++
  "  # could really switch, is told it cannot be done here. An id may be given\n" ++
  "  # by name (the account databases, via Etc).\n" ++
  "  def self.__id_set_arg(v, group)\n" ++
  "    return v if v.is_a?(Integer)\n" ++
  "    if v.is_a?(String)\n" ++
  "      require \"etc\"\n" ++
  "      return group ? Etc.getgrnam(v).gid : Etc.getpwnam(v).uid\n" ++
  "    end\n" ++
  "    raise TypeError, \"no implicit conversion of #\{v.nil? ? 'nil' : v.class} into Integer\" unless v.respond_to?(:to_int)\n" ++
  "    v.to_int\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__id_set(group, v)\n" ++
  "    id = __id_set_arg(v, group)\n" ++
  "    have = group ? [gid, egid] : [uid, euid]\n" ++
  "    return id if have.include?(id)\n" ++
  "    raise Errno::EPERM unless euid == 0\n" ++
  "    raise NotImplementedError, \"changing the process's ids is not implemented here\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.uid=(v)\n" ++
  "    __id_set(false, v)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.euid=(v)\n" ++
  "    __id_set(false, v)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.gid=(v)\n" ++
  "    __id_set(true, v)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.egid=(v)\n" ++
  "    __id_set(true, v)\n" ++
  "  end\n" ++
  "\n" ++
  "  # The same four ids under the names the POSIX-flavoured modules give them.\n" ++
  "  # ⚠ Four spec files read ONLY these spellings -- `Process::UID.rid` and its\n" ++
  "  #   three siblings -- so the readers above were right and four rows were a\n" ++
  "  #   NameError on a module that did not exist. The privilege-CHANGING half of\n" ++
  "  #   these modules is still absent (Process.uid= and its siblings above are\n" ++
  "  #   the setters this interpreter has).\n" ++
  "  module UID\n" ++
  "    def self.rid = Process.uid\n" ++
  "    def self.eid = Process.euid\n" ++
  "  end\n" ++
  "  module GID\n" ++
  "    def self.rid = Process.gid\n" ++
  "    def self.eid = Process.egid\n" ++
  "  end\n" ++
  "  module Sys\n" ++
  "    def self.getuid = Process.uid\n" ++
  "    def self.geteuid = Process.euid\n" ++
  "    def self.getgid = Process.gid\n" ++
  "    def self.getegid = Process.egid\n" ++
  "  end\n" ++
  "\n" ++
  "  # Process.argv0: the path the main script was given as. Frozen and the SAME\n" ++
  "  # object every time, both of which the spec reads.\n" ++
  "  def self.argv0\n" ++
  "    @__argv0 ||= $0.dup.freeze\n" ++
  "  end\n" ++
  "\n" ++
  "  # Documented as implementation-specific and free to be a no-op.\n" ++
  "  def self.warmup\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  WNOHANG = 1\n" ++
  "  WUNTRACED = 2\n" ++
  "\n" ++
  "  # ⚠ darwin's numbers, like CLOCK_* above and the errno table: this build\n" ++
  "  #   reports a hardcoded arm64-darwin RUBY_PLATFORM, and no header behind it\n" ++
  "  #   can be asked. They are the platform's resource and priority selectors;\n" ++
  "  #   nothing here can QUERY a limit (getrlimit is in <sys/resource.h>, which\n" ++
  "  #   an emitted program does not include), so getrlimit / setrlimit /\n" ++
  "  #   getpriority stay undefined rather than answer from a guess.\n" ++
  "  PRIO_PROCESS = 0\n" ++
  "  PRIO_PGRP = 1\n" ++
  "  PRIO_USER = 2\n" ++
  "  RLIMIT_CPU = 0\n" ++
  "  RLIMIT_FSIZE = 1\n" ++
  "  RLIMIT_DATA = 2\n" ++
  "  RLIMIT_STACK = 3\n" ++
  "  RLIMIT_CORE = 4\n" ++
  "  RLIMIT_AS = 5\n" ++
  "  RLIMIT_RSS = 5\n" ++
  "  RLIMIT_MEMLOCK = 6\n" ++
  "  RLIMIT_NPROC = 7\n" ++
  "  RLIMIT_NOFILE = 8\n" ++
  "  RLIM_INFINITY = 9223372036854775807\n" ++
  "  RLIM_SAVED_MAX = 9223372036854775807\n" ++
  "  RLIM_SAVED_CUR = 9223372036854775807\n" ++
  "  CLOCK_MONOTONIC_RAW = 4\n" ++
  "  CLOCK_MONOTONIC_RAW_APPROX = 5\n" ++
  "  CLOCK_UPTIME_RAW = 8\n" ++
  "  CLOCK_UPTIME_RAW_APPROX = 9\n" ++
  "\n" ++
  "  def self.__pid_arg(pid)\n" ++
  "    return pid if pid.is_a?(Integer)\n" ++
  "    r = pid.to_int\n" ++
  "    raise TypeError, \"can't convert #\{pid.class} to Integer (#\{pid.class}#to_int gives #\{r.class})\" unless r.is_a?(Integer)\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  # getpgid(2) / getpgrp(2) / getsid(2): pid 0 is this process, and a pid\n" ++
  "  # that is not a process is ESRCH (the only failure open to an unprivileged\n" ++
  "  # caller asking about an existing session is EPERM, which it cannot get\n" ++
  "  # for its own).\n" ++
  "  def self.getpgid(pid)\n" ++
  "    r = __getpgid(__pid_arg(pid))\n" ++
  "    raise Errno::ESRCH if r < 0\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.getpgrp = getpgid(0)\n" ++
  "\n" ++
  "  # setsid(2): a process that already leads a group is refused with EPERM,\n" ++
  "  # the only way it fails.\n" ++
  "  def self.setsid\n" ++
  "    r = __setsid\n" ++
  "    raise Errno::EPERM if r < 0\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.getsid(pid = nil)\n" ++
  "    r = __getsid(pid.nil? ? 0 : __pid_arg(pid))\n" ++
  "    raise Errno::ESRCH if r < 0\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  # The supplementary groups, as id(1) reports them for a process that\n" ++
  "  # inherited ours -- getgroups(2) fills a gid_t array, which no extern here\n" ++
  "  # can carry (the same reason uid and gid above come from id(1)).\n" ++
  "  def self.groups\n" ++
  "    `id -G`.split.map(&:to_i)\n" ++
  "  end\n" ++
  "\n" ++
  "  # setgroups(2) and initgroups(3) need privilege (root, or CAP_SETGID), and\n" ++
  "  # without it the kernel's answer is EPERM whatever the list -- which is\n" ++
  "  # the answer here. With it, this interpreter cannot make the call at all,\n" ++
  "  # and says so rather than pretend the list changed.\n" ++
  "  def self.groups=(list)\n" ++
  "    list = list.to_ary\n" ++
  "    raise Errno::EPERM unless uid == 0\n" ++
  "    raise NotImplementedError, \"Process.groups= is not implemented here\"\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.initgroups(user, gid)\n" ++
  "    raise Errno::EPERM unless uid == 0\n" ++
  "    raise NotImplementedError, \"Process.initgroups is not implemented here\"\n" ++
  "  end\n" ++
  "\n" ++
  "  # ruby's _maxgroups: sysconf(_SC_NGROUPS_MAX) until it is set, and a set\n" ++
  "  # value is clamped to that maximum (and to RB_MAX_GROUPS). The maximum is\n" ++
  "  # getconf(1)'s, by NAME: sysconf's selector numbers differ per platform.\n" ++
  "  def self.__ngroups_max = (@__ngmax ||= (`getconf NGROUPS_MAX 2>/dev/null`.strip =~ /\\A\\d+\\z/ ? $&.to_i : -1))\n" ++
  "\n" ++
  "  def self.maxgroups\n" ++
  "    @__maxgroups ||= (n = __ngroups_max) > 0 ? n : 65536\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.maxgroups=(n)\n" ++
  "    n = Integer(n)\n" ++
  "    raise ArgumentError, \"maxgroups #\{n} should be positive\" if n <= 0\n" ++
  "    n = 65536 if n > 65536\n" ++
  "    mx = __ngroups_max\n" ++
  "    n = mx if mx > 0 && n > mx\n" ++
  "    @__maxgroups = n\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.abort(*args) = Kernel.abort(*args)\n" ++
  "  SHELL_WORDS = %w[case do done elif else esac fi for if in then until while\n" ++
  "                   ! . : break continue eval exec exit export readonly return set shift times trap unset]\n" ++
  "\n" ++
  "  # --- children: spawn, wait and detach ------------------------------------\n" ++
  "  # ⚠ THE RUNTIME HAS ONE WAY TO START A PROCESS, and it waits for it:\n" ++
  "  #   posix_spawn of `sh -c` and then waitpid. A child that outlives the call\n" ++
  "  #   is therefore started BY that shell, in the background, and reported back\n" ++
  "  #   through two files -- its pid, written as soon as it starts, and its exit\n" ++
  "  #   status, written by the shell that waits for it when it ends. So:\n" ++
  "  #   - the pid is the child's own, real pid (Process.kill reaches it, and it\n" ++
  "  #     is gone -- ESRCH -- once waited for);\n" ++
  "  #   - it is not OUR child in the kernel's sense but a grandchild, which is\n" ++
  "  #     why waiting polls a file instead of calling wait(2). The table below\n" ++
  "  #     is what makes it \"ours\": wait answers only pids spawn handed out, and\n" ++
  "  #     ECHILD for everything else, as the kernel would.\n" ++
  "  #   - a child killed by a signal reports 128+signal as an exit status,\n" ++
  "  #     because that is all the waiting shell can see.\n" ++
  "  @__kids = \{}\n" ++
  "  @__kid_n = 0\n" ++
  "\n" ++
  "  def self.__kid_dir\n" ++
  "    d = ENV[\"TMPDIR\"] || \"/tmp\"\n" ++
  "    d.end_with?(\"/\") ? d[0..-2] : d\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__str_arg(a)\n" ++
  "    s = a.is_a?(String) ? a : (a.respond_to?(:to_str) ? a.to_str : nil)\n" ++
  "    unless s.is_a?(String)\n" ++
  "      n = a.nil? ? \"nil\" : a == true ? \"true\" : a == false ? \"false\" : a.class.to_s\n" ++
  "      raise TypeError, \"no implicit conversion of \" + n + \" into String\"\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"string contains null byte\" if s.include?(\"\\0\")\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ The replacement is written with the backslash DOUBLED: in a gsub\n" ++
  "  #   replacement string \\' means \"the text after the match\", so the old\n" ++
  "  #   \"'\\\\''\" pasted the rest of the word into the quoting and broke every\n" ++
  "  #   argument with a quote in it (`-e \"IO.new(4, 'w')\"`).\n" ++
  "  def self.__q(w) = \"'\" + w.to_s.gsub(\"'\", \"'\\\\\\\\''\") + \"'\"\n" ++
  "\n" ++
  "  def self.__which(cmd, path)\n" ++
  "    return (File.exist?(cmd) ? cmd : nil) if cmd.include?(\"/\")\n" ++
  "    (path || \"\").split(\":\").each do |d|\n" ++
  "      f = File.join(d, cmd)\n" ++
  "      return f if File.file?(f) && File.executable?(f)\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # A descriptor a redirect names is handed down as it is: close-on-exec is\n" ++
  "  # kept in the process's own table (IO.__fdlist), and spawn closes every\n" ++
  "  # other descriptor for the child itself, keeping the ones a redirect reads\n" ++
  "  # from -- so a dup here (as when the flag was the kernel's) would be\n" ++
  "  # closed along with the rest, and `out: io` was \"Bad file descriptor\".\n" ++
  "  def self.__inheritable(fd) = fd\n" ++
  "\n" ++
  "  # a redirect target as the shell spells it, for descriptor `fd`\n" ++
  "  def self.__redir(fd, v)\n" ++
  "    v = v.to_io if !v.is_a?(IO) && v.respond_to?(:to_io)\n" ++
  "    t = if v.is_a?(Integer) then \">&\" + __inheritable(v).to_s\n" ++
  "        elsif v == :out then \">&1\"\n" ++
  "        elsif v == :err then \">&2\"\n" ++
  "        elsif v == :in then \"<&0\"\n" ++
  "        elsif v == :close then \">&-\"\n" ++
  "        elsif v.is_a?(IO) then \">&\" + __inheritable(v.fileno).to_s\n" ++
  "        elsif v.is_a?(String) then (fd == 0 ? \"<\" : \">\") + __q(v)\n" ++
  "        elsif v.is_a?(Array) && v[0] == :child then \">&\" + (v[1] == :out ? \"1\" : v[1] == :err ? \"2\" : v[1].to_s)\n" ++
  "        elsif v.is_a?(Array)\n" ++
  "          nm = __str_arg(v[0])\n" ++
  "          m = v[1].to_s\n" ++
  "          (fd == 0 ? \"<\" : (m.include?(\"a\") ? \">>\" : \">\")) + __q(nm)\n" ++
  "        else raise ArgumentError, \"wrong exec redirect action\"\n" ++
  "        end\n" ++
  "    fd.to_s + t\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_of(k)\n" ++
  "    return k if k.is_a?(Integer)\n" ++
  "    return 0 if k == :in\n" ++
  "    return 1 if k == :out\n" ++
  "    return 2 if k == :err\n" ++
  "    return k.fileno if k.is_a?(IO)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.spawn(*args)\n" ++
  "    env = nil\n" ++
  "    if !args.empty? && (args[0].is_a?(Hash) || (!args[0].is_a?(String) && !args[0].is_a?(Array) && args[0].respond_to?(:to_hash)))\n" ++
  "      env = args.shift\n" ++
  "      env = env.to_hash unless env.is_a?(Hash)\n" ++
  "    end\n" ++
  "    opts = args.last.is_a?(Hash) ? args.pop : \{}\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1+)\" if args.empty?\n" ++
  "    pre = []\n" ++
  "    if env\n" ++
  "      env.each do |k, v|\n" ++
  "        k = __str_arg(k)\n" ++
  "        raise ArgumentError, \"environment name contains a equal : \" + k if k.include?(\"=\")\n" ++
  "        if v.nil?\n" ++
  "          pre << \"unset \" + __q(k) + \";\"\n" ++
  "        else\n" ++
  "          pre << \"export \" + __q(k) + \"=\" + __q(__str_arg(v)) + \";\"\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    redir = []\n" ++
  "    late = []\n" ++
  "    pgroup = false\n" ++
  "    newpg = false\n" ++
  "    unset_others = false\n" ++
  "    path = (env && env.key?(\"PATH\")) ? env[\"PATH\"] : ENV[\"PATH\"]\n" ++
  "    opts.each do |k, v|\n" ++
  "      if k.is_a?(String)\n" ++
  "        raise ArgumentError, \"wrong exec option: \" + k.inspect\n" ++
  "      elsif k == :chdir\n" ++
  "        d = v.respond_to?(:to_path) ? v.to_path : v\n" ++
  "        raise Errno::ENOENT, d.to_s unless File.directory?(d)\n" ++
  "        pre << \"cd \" + __q(d) + \" || exit 127;\"\n" ++
  "      elsif k == :umask\n" ++
  "        pre << \"umask \" + v.to_s(8) + \";\"\n" ++
  "      elsif k == :pgroup\n" ++
  "        # true / 0: a group of its own (job control gives a background job\n" ++
  "        # one, named by its pid); a positive Integer: that group, which a\n" ++
  "        # shell cannot join, so it is recorded only; false / nil: ours.\n" ++
  "        if v == true || v == 0\n" ++
  "          pgroup = true\n" ++
  "          newpg = true\n" ++
  "        elsif v.nil? || v == false\n" ++
  "          pgroup = false\n" ++
  "        else\n" ++
  "          g = v.is_a?(Integer) ? v : (v.respond_to?(:to_int) ? v.to_int : nil)\n" ++
  "          raise TypeError, \"no implicit conversion of #\{v.class} into Integer\" unless g.is_a?(Integer)\n" ++
  "          raise ArgumentError, \"negative process group ID : #\{g}\" if g < 0\n" ++
  "          pgroup = true\n" ++
  "        end\n" ++
  "      elsif k == :unsetenv_others\n" ++
  "        # (first of all: the env given to spawn is set AFTER it)\n" ++
  "        unset_others = true if v\n" ++
  "      elsif k == :close_others || k == :new_pgroup || k == :rlimit_core\n" ++
  "      elsif k.is_a?(Array)\n" ++
  "        # one open shared by every descriptor named, as ruby does it\n" ++
  "        fs = k.map \{ |kk| __fd_of(kk) }\n" ++
  "        redir << __redir(fs[0], v)\n" ++
  "        fs[1..].each \{ |f| redir << f.to_s + \">&\" + fs[0].to_s }\n" ++
  "      elsif (f = __fd_of(k))\n" ++
  "        # [:child, fd] names the CHILD's descriptor after the others are set\n" ++
  "        (v.is_a?(Array) && v[0] == :child ? late : redir) << __redir(f, v)\n" ++
  "      else\n" ++
  "        raise ArgumentError, \"wrong exec option symbol: \" + k.to_s\n" ++
  "      end\n" ++
  "    end\n" ++
  "    first = args[0]\n" ++
  "    first = first.to_ary if !first.is_a?(String) && !first.is_a?(Array) && first.respond_to?(:to_ary)\n" ++
  "    if first.is_a?(Array)\n" ++
  "      raise ArgumentError, \"wrong first argument\" unless first.size == 2\n" ++
  "      prog = __str_arg(first[0])\n" ++
  "      argv0 = __str_arg(first[1])\n" ++
  "      rest = args[1..].map \{ |a| __str_arg(a) }\n" ++
  "    else\n" ++
  "      prog = __str_arg(first)\n" ++
  "      argv0 = nil\n" ++
  "      rest = args[1..].map \{ |a| __str_arg(a) }\n" ++
  "    end\n" ++
  "    # a single string goes to the shell when it needs one: a metacharacter, or\n" ++
  "    # a first word that is a reserved word or special builtin (ruby's list)\n" ++
  "    shell = argv0.nil? && rest.empty? &&\n" ++
  "            (prog.match?(/[*?\{}\\[\\]<>()~&|\\\\$;'`\"\\n#=%]/) || SHELL_WORDS.include?(prog.split[0]))\n" ++
  "    if shell\n" ++
  "      # its own shell, as ruby's is: a line that does not parse is that\n" ++
  "      # shell's error (and exit status), never a hole in the script below\n" ++
  "      # (by its path when unsetenv_others has left no PATH to find it by;\n" ++
  "      # otherwise by name, so that its $0 is \"sh\" as under ruby)\n" ++
  "      line = \"exec \" + (unset_others ? \"/bin/sh\" : \"sh\") + \" -c \" + __q(prog)\n" ++
  "    else\n" ++
  "      words = argv0.nil? && rest.empty? ? prog.split : [prog] + rest\n" ++
  "      raise Errno::ENOENT, prog if words.empty?\n" ++
  "      exe = __which(words[0], path)\n" ++
  "      if exe.nil?\n" ++
  "        __set_status(127, nil)\n" ++
  "        raise Errno::ENOENT, words[0]\n" ++
  "      end\n" ++
  "      if File.directory?(exe) || !File.executable?(exe)\n" ++
  "        __set_status(127, nil)\n" ++
  "        raise Errno::EACCES, words[0]\n" ++
  "      end\n" ++
  "      line = (argv0.nil? ? \"\" : \"exec -a \" + __q(argv0) + \" \") + ([exe] + words[1..]).map \{ |w| __q(w) }.join(\" \")\n" ++
  "      line = \"exec \" + line if argv0.nil?\n" ++
  "    end\n" ++
  "    @__kid_n += 1\n" ++
  "    base = __kid_dir + \"/mere_ruby_kid.\" + Process.pid.to_s + \".\" + @__kid_n.to_s\n" ++
  "    pidf = base + \".pid\"\n" ++
  "    stf = base + \".st\"\n" ++
  "    pre.unshift(\"for __v in $(env | sed 's/=.*//'); do unset $__v 2>/dev/null; done;\") if unset_others\n" ++
  "    inner = pre.join(\" \") + \" \" + line + \" \" + (redir + late).join(\" \")\n" ++
  "    STDOUT.flush\n" ++
  "    STDERR.flush\n" ++
  "    # the child is started by a background shell that waits for it; stdin is\n" ++
  "    # handed down explicitly, because an asynchronous list's is /dev/null, and\n" ++
  "    # so is stderr, because the waiting shell's own (\"Killed: 9\") is not ours.\n" ++
  "    # They travel on two high single digits, out of the way of the low\n" ++
  "    # descriptors a pipe or a redirect names -- and of the ones it hands down.\n" ++
  "    # ⚠ EVERY OTHER DESCRIPTOR THIS PROCESS HOLDS IS CLOSED FOR THE CHILD, as\n" ++
  "    #   ruby's are (FD_CLOEXEC), unless the program cleared #close_on_exec.\n" ++
  "    #   Inherited, a pipe's write end kept its reader from ever seeing the end\n" ++
  "    #   of file -- IO.popen's child held its own parent's end. The ones a\n" ++
  "    #   redirect reads from are kept until the child has them, then the\n" ++
  "    #   waiting shell lets go of its copies too.\n" ++
  "    keep = []\n" ++
  "    opts.each do |k, v|\n" ++
  "      next unless k.is_a?(Array) || (!k.is_a?(String) && __fd_of(k))\n" ++
  "      v = v.to_io if !v.is_a?(IO) && !v.is_a?(Integer) && v.respond_to?(:to_io)\n" ++
  "      keep << v if v.is_a?(Integer)\n" ++
  "      keep << v.fileno if v.is_a?(IO) && !v.closed?\n" ++
  "    end\n" ++
  "    shut = (IO.__fdlist - keep).map \{ |fd| fd.to_s + \">&- \" }.join\n" ++
  "    held = keep.select \{ |fd| fd > 2 }.uniq.map \{ |fd| fd.to_s + \">&-\" }\n" ++
  "    held = held.empty? ? \"\" : \"exec \" + held.join(\" \") + \"; \"\n" ++
  "    si, se = ([9, 8, 7, 6, 5, 4, 3] - keep).first(2).map(&:to_s)\n" ++
  "    rc = Process.__sh((newpg ? \"set -m; \" : \"\") + \"exec \" + shut + si + \"<&0 \" + se + \">&2; ( ( \" + inner + \" ) <&\" + si + \" 2>&\" + se + \" \" + si + \"<&- \" + se + \">&- & \" + held + \"echo $! > \" + __q(pidf + \".t\") + \"; mv \" + __q(pidf + \".t\") + \" \" + __q(pidf) +\n" ++
  "                 \"; wait $!; echo $? > \" + __q(stf + \".t\") + \"; mv \" + __q(stf + \".t\") + \" \" + __q(stf) + \" ) 2>/dev/null &\")\n" ++
  "    n = 0\n" ++
  "    until File.exist?(pidf)\n" ++
  "      n += 1\n" ++
  "      raise SystemCallError.new(\"spawn: the child did not start (sh exit \" + rc.to_s + \")\", 0) if rc != 0 || n > 10000\n" ++
  "      IO.__poll([], [], 1)\n" ++
  "    end\n" ++
  "    pid = File.read(pidf).to_i\n" ++
  "    File.delete(pidf)\n" ++
  "    (@__tmp_fds || []).each(&:close)\n" ++
  "    @__tmp_fds = nil\n" ++
  "    @__kids[pid] = [stf, pgroup]\n" ++
  "    pid\n" ++
  "  end\n" ++
  "\n" ++
  "  # Kernel#system in every form but the bare command string (which the\n" ++
  "  # interpreter runs directly): spawn and wait, so the redirects, the env\n" ++
  "  # and the argv form mean what they mean to spawn. A command that cannot be\n" ++
  "  # started is nil -- and with `exception: true` the error itself -- and a\n" ++
  "  # failed one is false, or with `exception: true` ruby's RuntimeError.\n" ++
  "  def self.__system(*args)\n" ++
  "    exc = false\n" ++
  "    if args.last.is_a?(Hash) && args.last.key?(:exception)\n" ++
  "      args[-1] = args.last.dup\n" ++
  "      exc = args.last.delete(:exception)\n" ++
  "      args.pop if args.last.empty? && args.size > 1\n" ++
  "    end\n" ++
  "    begin\n" ++
  "      pid = spawn(*args)\n" ++
  "    rescue SystemCallError\n" ++
  "      raise if exc\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    wait(pid)\n" ++
  "    st = $?\n" ++
  "    if exc && !st.success?\n" ++
  "      words = args.reject \{ |a| a.is_a?(Hash) }.map \{ |a| a.is_a?(Array) ? a[0] : a }\n" ++
  "      raise RuntimeError, \"Command failed with exit #\{st.exitstatus}: #\{words.join(' ')}\"\n" ++
  "    end\n" ++
  "    st.success?\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__set_status(st, pid)\n" ++
  "    s = Process::Status.allocate\n" ++
  "    s.instance_variable_set(:@__st, st)\n" ++
  "    s.instance_variable_set(:@__pid, pid)\n" ++
  "    Process.__set_last(s)\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__to_pid(pid)\n" ++
  "    return pid if pid.is_a?(Integer)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + pid.class.to_s + \" into Integer\" unless pid.respond_to?(:to_int)\n" ++
  "    i = pid.to_int\n" ++
  "    raise TypeError, \"can't convert \" + pid.class.to_s + \" into Integer (\" + pid.class.to_s + \"#to_int gives \" + i.class.to_s + \")\" unless i.is_a?(Integer)\n" ++
  "    i\n" ++
  "  end\n" ++
  "\n" ++
  "  # the finished child among `pids`, or nil\n" ++
  "  def self.__reaped(pids)\n" ++
  "    pids.each do |p|\n" ++
  "      stf = @__kids[p][0]\n" ++
  "      next unless File.exist?(stf)\n" ++
  "      st = File.read(stf).to_i\n" ++
  "      File.delete(stf)\n" ++
  "      @__kids.delete(p)\n" ++
  "      __set_status(st, p)\n" ++
  "      return p\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.wait(pid = -1, flags = 0)\n" ++
  "    pid = __to_pid(pid)\n" ++
  "    flags = 0 if flags.nil?\n" ++
  "    pids = if pid == -1 then @__kids.keys\n" ++
  "           elsif pid == 0 then @__kids.keys.reject \{ |p| @__kids[p][1] }\n" ++
  "           elsif pid > 0 then (@__kids.key?(pid) ? [pid] : [])\n" ++
  "           else []\n" ++
  "           end\n" ++
  "    raise Errno::ECHILD if pids.empty?\n" ++
  "    # with threads scheduled the wait lets the others run meanwhile (one of\n" ++
  "    # them may be what the child is waiting for), as the readiness loop does\n" ++
  "    begin\n" ++
  "      loop do\n" ++
  "        got = __reaped(pids)\n" ++
  "        return got if got\n" ++
  "        return nil if (flags & WNOHANG) != 0\n" ++
  "        IO.__sched? ? IO.__park : IO.__poll([], [], 5)\n" ++
  "      end\n" ++
  "    ensure\n" ++
  "      IO.__unpark if IO.__sched?\n" ++
  "    end\n" ++
  "  end\n" ++
  "  def self.waitpid(pid = -1, flags = 0) = wait(pid, flags)\n" ++
  "\n" ++
  "  # A backtick run from a thread other than the main one: spawn and wait,\n" ++
  "  # so that the other threads run while the command does, as they do in\n" ++
  "  # ruby. (The main thread keeps the one-call path.) The spec harness's\n" ++
  "  # Signalizer is the case: a thread runs a child with ruby_exe while the\n" ++
  "  # main thread reads the child's pid file and signals it -- with the\n" ++
  "  # backtick blocking every thread, neither could ever finish.\n" ++
  "  def self.__bt_async(cmd)\n" ++
  "    @__kid_n += 1\n" ++
  "    out = __kid_dir + \"/mere_ruby_bt.\" + Process.pid.to_s + \".\" + @__kid_n.to_s\n" ++
  "    pid = spawn(cmd, out: out)\n" ++
  "    wait(pid)\n" ++
  "    s = File.exist?(out) ? File.read(out) : \"\"\n" ++
  "    File.delete(out) if File.exist?(out)\n" ++
  "    s\n" ++
  "  end\n" ++
  "  def self.wait2(pid = -1, flags = 0)\n" ++
  "    got = wait(pid, flags)\n" ++
  "    got.nil? ? nil : [got, $?]\n" ++
  "  end\n" ++
  "  def self.waitpid2(pid = -1, flags = 0) = wait2(pid, flags)\n" ++
  "  def self.waitall\n" ++
  "    out = []\n" ++
  "    until @__kids.empty?\n" ++
  "      p = wait\n" ++
  "      out << [p, $?]\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.last_status(*args)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0)\" unless args.empty?\n" ++
  "    $?\n" ++
  "  end\n" ++
  "\n" ++
  "  # the thread detach answers: its value is the child's status, and it\n" ++
  "  # knows the pid it is waiting for\n" ++
  "  class Waiter < Thread\n" ++
  "    def pid = self[:pid]\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.detach(pid)\n" ++
  "    pid = __to_pid(pid)\n" ++
  "    Waiter.new(pid) do |p|\n" ++
  "      Thread.current[:pid] = p\n" ++
  "      begin\n" ++
  "        Process.wait(p)\n" ++
  "        $?\n" ++
  "      rescue Errno::ECHILD\n" ++
  "        nil\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "  Tms = Struct.new(:utime, :stime, :cutime, :cstime)\n" ++
  "\n" ++
  "  # ⚠ CPU time, and it costs a subprocess: there is no times(2) or\n" ++
  "  #   getrusage(2) extern here, and `ps -o utime=,stime=` is the reading this\n" ++
  "  #   platform will give for a pid. Wall clock was the alternative and it is\n" ++
  "  #   not the same quantity -- a process that sleeps burns no CPU and every\n" ++
  "  #   caller of #times is asking exactly that. The resolution is 10ms, which\n" ++
  "  #   is ps's, not ours.\n" ++
  "  def self.times\n" ++
  "    out = `ps -p #\{Process.pid} -o utime=,stime= 2>/dev/null`.split\n" ++
  "    u = __ps_secs(out[0])\n" ++
  "    s = __ps_secs(out[1])\n" ++
  "    Tms.new(u, s, 0.0, 0.0)\n" ++
  "  end\n" ++
  "\n" ++
  "  # \"M:SS.ss\" or \"H:MM:SS.ss\" -> seconds.\n" ++
  "  def self.__ps_secs(t)\n" ++
  "    return 0.0 if t.nil?\n" ++
  "    parts = t.split(\":\")\n" ++
  "    secs = 0.0\n" ++
  "    parts.each \{ |p| secs = secs * 60 + p.to_f }\n" ++
  "    secs\n" ++
  "  end\n" ++
  "  private_class_method :__ps_secs\n" ++
  "\n" ++
  "  # ⚠ THE UNIT was ignored entirely: every clock_gettime answered a float\n" ++
  "  #   second whatever was asked for, so `clock_gettime(c, :nanosecond)` -- which\n" ++
  "  #   ruby answers with an Integer -- came back as a Float of seconds. The unit\n" ++
  "  #   is the part of this call a caller can actually observe here, because\n" ++
  "  #   every clock below IS the same wall clock: there is no clock_gettime(2)\n" ++
  "  #   extern, only one that reads the time of day.\n" ++
  "  UNITS = [:float_second, :float_millisecond, :float_microsecond,\n" ++
  "           :second, :millisecond, :microsecond, :nanosecond].freeze\n" ++
  "\n" ++
  "  def self.__in_unit(secs, unit)\n" ++
  "    case unit\n" ++
  "    when nil, :float_second then secs\n" ++
  "    when :float_millisecond then secs * 1000.0\n" ++
  "    when :float_microsecond then secs * 1000000.0\n" ++
  "    when :second then (secs).to_i\n" ++
  "    when :millisecond then (secs * 1000).to_i\n" ++
  "    when :microsecond then (secs * 1000000).to_i\n" ++
  "    when :nanosecond then (secs * 1000000000).to_i\n" ++
  "    else raise ArgumentError, \"unexpected unit: #\{unit.inspect}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  private_class_method :__in_unit\n" ++
  "\n" ++
  "  def self.clock_gettime(clock, unit = :float_second)\n" ++
  "    __in_unit(__clock_raw, unit)\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ The three SYMBOL clocks have resolutions ruby documents, so they are\n" ++
  "  #   answered as documented. The numeric ones are \"observed\", and the spec\n" ++
  "  #   only requires <= 10ms; one microsecond is what a gettimeofday-based\n" ++
  "  #   clock gives and is the honest claim for the one behind __clock_raw.\n" ++
  "  def self.clock_getres(clock, unit = :float_second)\n" ++
  "    ns = case clock\n" ++
  "         when :TIME_BASED_CLOCK_REALTIME, :TIME_BASED_CLOCK_MONOTONIC then 1000000000\n" ++
  "         else 1000\n" ++
  "         end\n" ++
  "    __in_unit(ns / 1000000000.0, unit)\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "\n" ++
  "class File\n" ++
  "  # One stat(2) snapshot, which is what CRuby's File::Stat is: the fields are\n" ++
  "  # read ONCE, at construction, and every reader answers from that copy.\n" ++
  "  #\n" ++
  "  # ⚠ The read goes through stat(1), not stat(2). This interpreter's host\n" ++
  "  # language has no struct-reading FFI -- its externs carry ints, floats and\n" ++
  "  # strings -- so the choice was between a hardcoded `struct stat` offset table\n" ++
  "  # (which is an ABI claim this repository cannot check, and differs between\n" ++
  "  # the macOS it is developed on and the Linux CI runs) and one subprocess.\n" ++
  "  # A subprocess per SNAPSHOT is the honest cost, and it is the same cost model\n" ++
  "  # File.writable? has had all along (`test -w`). It is one process per\n" ++
  "  # File.stat, not one per field, because the snapshot is the unit.\n" ++
  "  class Stat\n" ++
  "    include Comparable\n" ++
  "\n" ++
  "    def self.__shq(s)\n" ++
  "      \"'\" + s.to_s.gsub(\"'\", \"'\\\\\\\\''\") + \"'\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # BSD and GNU stat(1) take different format flags and print the mode in a\n" ++
  "    # different base, so the dialect has to be CHOSEN, not discovered by trying\n" ++
  "    # one and seeing whether it failed.\n" ++
  "    #\n" ++
  "    # ⚠ Measured on ubuntu 24.04: `stat -f <format> -- file` under GNU coreutils\n" ++
  "    # does not fail quietly. `-f` there means \"file SYSTEM status\", so it errors\n" ++
  "    # on the format string, exits 1, AND PRINTS SIX LINES OF FILESYSTEM INFO TO\n" ++
  "    # STDOUT. A fallback that asked \"was stdout empty?\" reads those lines as a\n" ++
  "    # BSD answer -- they split into more than thirteen tokens -- and every field\n" ++
  "    # comes out 0. That is worse than no File::Stat at all, so:\n" ++
  "    #   1. `uname -s` picks the dialect (RUBY_PLATFORM cannot: this interpreter\n" ++
  "    #      reports a hardcoded \"arm64-darwin25\" whatever it is running on), and\n" ++
  "    #   2. every token is required to be a plain number in its own base, so a\n" ++
  "    #      dialect that was chosen wrongly raises instead of inventing fields.\n" ++
  "    def self.__bsd?\n" ++
  "      @__bsd = ![\"Linux\", \"GNU\"].include?(`uname -s 2>/dev/null`.strip) if @__bsd.nil?\n" ++
  "      @__bsd\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.__nums(f, base)\n" ++
  "      f.each do |x|\n" ++
  "        return nil unless x =~ (base == 16 ? /\\A[0-9a-fA-F]+\\z/ : /\\A[0-9]+\\z/)\n" ++
  "      end\n" ++
  "      f\n" ++
  "    end\n" ++
  "\n" ++
  "    # ⚠ stat(1) does NOT follow a symlink unless told to (-L, in both\n" ++
  "    #   dialects), so File.stat answered lstat's snapshot: a link to a file\n" ++
  "    #   said symlink? true and file? false. `follow` is the difference\n" ++
  "    #   between the two calls.\n" ++
  "    def self.__raw(path, follow = true)\n" ++
  "      q = __shq(path)\n" ++
  "      l = follow ? \"-L \" : \"\"\n" ++
  "      if __bsd?\n" ++
  "        f = `stat #\{l}-f '%d %i %p %l %u %g %r %z %a %m %c %k %b %B' -- #\{q} 2>/dev/null`.split\n" ++
  "        return nil if f.size != 14 || __nums(f, 10).nil?\n" ++
  "        \{ dev: f[0].to_i, ino: f[1].to_i, mode: f[2].to_i(8), nlink: f[3].to_i,\n" ++
  "          uid: f[4].to_i, gid: f[5].to_i, rdev: f[6].to_i, size: f[7].to_i,\n" ++
  "          atime: f[8].to_i, mtime: f[9].to_i, ctime: f[10].to_i,\n" ++
  "          blksize: f[11].to_i, blocks: f[12].to_i, btime: f[13].to_i }\n" ++
  "      else\n" ++
  "        f = `stat #\{l}-c '%d %i %f %h %u %g %t %T %s %X %Y %Z %o %b %W' -- #\{q} 2>/dev/null`.split\n" ++
  "        return nil if f.size != 15 || __nums(f, 16).nil?\n" ++
  "        \{ dev: f[0].to_i, ino: f[1].to_i, mode: f[2].to_i(16), nlink: f[3].to_i,\n" ++
  "          uid: f[4].to_i, gid: f[5].to_i,\n" ++
  "          rdev: f[6].to_i(16) * 256 + f[7].to_i(16),\n" ++
  "          size: f[8].to_i, atime: f[9].to_i, mtime: f[10].to_i,\n" ++
  "          ctime: f[11].to_i, blksize: f[12].to_i, blocks: f[13].to_i,\n" ++
  "          btime: f[14].to_i }\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # a path as rb_get_path takes one: a String, #to_path, then #to_str\n" ++
  "    def self.__path(path)\n" ++
  "      return path if path.is_a?(String)\n" ++
  "      return path.to_path if path.respond_to?(:to_path)\n" ++
  "      return path.to_str if path.respond_to?(:to_str)\n" ++
  "      raise TypeError, \"no implicit conversion of #\{path.nil? ? 'nil' : path.class} into String\"\n" ++
  "    end\n" ++
  "\n" ++
  "    def initialize(path)\n" ++
  "      path = File::Stat.__path(path)\n" ++
  "      h = File::Stat.__raw(path)\n" ++
  "      raise Errno::ENOENT.new(path, \"rb_file_s_stat\") if h.nil?\n" ++
  "      @h = h\n" ++
  "    end\n" ++
  "\n" ++
  "    # File.lstat: the same snapshot of the link itself\n" ++
  "    def self.__lstat(path)\n" ++
  "      path = __path(path)\n" ++
  "      h = __raw(path, false)\n" ++
  "      raise Errno::ENOENT.new(path, \"rb_file_s_lstat\") if h.nil?\n" ++
  "      s = allocate\n" ++
  "      s.instance_variable_set(:@h, h)\n" ++
  "      s\n" ++
  "    end\n" ++
  "\n" ++
  "    def dev = @h[:dev]\n" ++
  "    def ino = @h[:ino]\n" ++
  "    def mode = @h[:mode]\n" ++
  "    def nlink = @h[:nlink]\n" ++
  "    def uid = @h[:uid]\n" ++
  "    def gid = @h[:gid]\n" ++
  "    def rdev = @h[:rdev]\n" ++
  "    def size = @h[:size]\n" ++
  "    def blksize = @h[:blksize]\n" ++
  "    def blocks = @h[:blocks]\n" ++
  "    def atime = Time.at(@h[:atime])\n" ++
  "    def mtime = Time.at(@h[:mtime])\n" ++
  "    def ctime = Time.at(@h[:ctime])\n" ++
  "    # ⚠ the BIRTH time, which is its own field (%B / %W): this answered\n" ++
  "    #   ctime, a different instant for any file changed since it was made.\n" ++
  "    #   A filesystem that does not record one says 0, and ruby says so too.\n" ++
  "    def birthtime\n" ++
  "      raise NotImplementedError, \"birthtime() function is unimplemented on this machine\" if @h[:btime] == 0\n" ++
  "      Time.at(@h[:btime])\n" ++
  "    end\n" ++
  "    def dev_major = @h[:dev] / 16777216\n" ++
  "    def dev_minor = @h[:dev] % 256\n" ++
  "    def rdev_major = @h[:rdev] / 256\n" ++
  "    def rdev_minor = @h[:rdev] % 256\n" ++
  "\n" ++
  "    # the file-type bits. A constant here would show up in\n" ++
  "    # File::Stat.constants, which is empty in the reference.\n" ++
  "    def __fmt = mode & 0o170000\n" ++
  "\n" ++
  "    def file? = __fmt == 0o100000\n" ++
  "    def directory? = __fmt == 0o040000\n" ++
  "    def symlink? = __fmt == 0o120000\n" ++
  "    def chardev? = __fmt == 0o020000\n" ++
  "    def blockdev? = __fmt == 0o060000\n" ++
  "    def pipe? = __fmt == 0o010000\n" ++
  "    def socket? = __fmt == 0o140000\n" ++
  "\n" ++
  "    def ftype\n" ++
  "      case __fmt\n" ++
  "      when 0o100000 then \"file\"\n" ++
  "      when 0o040000 then \"directory\"\n" ++
  "      when 0o120000 then \"link\"\n" ++
  "      when 0o020000 then \"characterSpecial\"\n" ++
  "      when 0o060000 then \"blockSpecial\"\n" ++
  "      when 0o010000 then \"fifo\"\n" ++
  "      when 0o140000 then \"socket\"\n" ++
  "      else \"unknown\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def setuid? = (mode & 0o4000) != 0\n" ++
  "    def setgid? = (mode & 0o2000) != 0\n" ++
  "    def sticky? = (mode & 0o1000) != 0\n" ++
  "    def world_readable? = ((mode & 0o004) != 0) ? (mode & 0o7777) : nil\n" ++
  "    def world_writable? = ((mode & 0o002) != 0) ? (mode & 0o7777) : nil\n" ++
  "    def owned? = uid == Process.uid\n" ++
  "    # the EFFECTIVE group or any supplementary one (rb_group_member): a file\n" ++
  "    # chgrp'ed to a second group of ours is ours too\n" ++
  "    def grpowned? = gid == Process.egid || Process.__groups.include?(gid)\n" ++
  "    def zero? = size == 0\n" ++
  "    def size? = size == 0 ? nil : size\n" ++
  "    def readable? = __perm(0o400, 0o040, 0o004)\n" ++
  "    def writable? = __perm(0o200, 0o020, 0o002)\n" ++
  "    def executable? = __perm(0o100, 0o010, 0o001)\n" ++
  "    alias readable_real? readable?\n" ++
  "    alias writable_real? writable?\n" ++
  "    alias executable_real? executable?\n" ++
  "\n" ++
  "    def __perm(u, g, o)\n" ++
  "      return true if Process.uid == 0\n" ++
  "      return (mode & u) != 0 if uid == Process.uid\n" ++
  "      return (mode & g) != 0 if gid == Process.gid\n" ++
  "      (mode & o) != 0\n" ++
  "    end\n" ++
  "\n" ++
  "    def <=>(other) = other.is_a?(File::Stat) ? (@h[:mtime] <=> other.mtime.to_i) : nil\n" ++
  "    def ==(other) = other.is_a?(File::Stat) && (self <=> other) == 0\n" ++
  "\n" ++
  "    # ⚠ ruby's: the mode seven octal digits wide (a directory is 0040755, not\n" ++
  "    #   040755), the times as #inspect writes them, and on the BSDs the\n" ++
  "    #   birth time as well -- rb_stat_inspect prints the fields the platform\n" ++
  "    #   has.\n" ++
  "    def inspect\n" ++
  "      s = \"#<File::Stat dev=0x#\{dev.to_s(16)}, ino=#\{ino}, mode=#\{format('%07o', mode)}, \" \\\n" ++
  "          \"nlink=#\{nlink}, uid=#\{uid}, gid=#\{gid}, rdev=0x#\{rdev.to_s(16)}, \" \\\n" ++
  "          \"size=#\{size}, blksize=#\{blksize.inspect}, blocks=#\{blocks.inspect}, \" \\\n" ++
  "          \"atime=#\{atime.inspect}, mtime=#\{mtime.inspect}, ctime=#\{ctime.inspect}\"\n" ++
  "      s += \", birthtime=#\{birthtime.inspect}\" if File::Stat.__bsd?\n" ++
  "      s + \">\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.stat(path) = File::Stat.new(path)\n" ++
  "  def self.lstat(path) = File::Stat.__lstat(path)\n" ++
  "\n" ++
  "  def self.atime(path) = stat(path).atime\n" ++
  "  def self.mtime(path) = stat(path).mtime\n" ++
  "  def self.ctime(path) = stat(path).ctime\n" ++
  "  def self.birthtime(path) = stat(path).birthtime\n" ++
  "  # the type of the NAME, not what it points at: ruby asks lstat(2) here\n" ++
  "  def self.ftype(path) = lstat(path).ftype\n" ++
  "\n" ++
  "  def self.owned?(path) = (stat(path).owned? rescue false)\n" ++
  "  def self.grpowned?(path) = (stat(path).grpowned? rescue false)\n" ++
  "  def self.setuid?(path) = (stat(path).setuid? rescue false)\n" ++
  "  def self.setgid?(path) = (stat(path).setgid? rescue false)\n" ++
  "  def self.sticky?(path) = (stat(path).sticky? rescue false)\n" ++
  "  def self.pipe?(path) = (stat(path).pipe? rescue false)\n" ++
  "  def self.socket?(path) = (stat(path).socket? rescue false)\n" ++
  "  def self.blockdev?(path) = (stat(path).blockdev? rescue false)\n" ++
  "  def self.chardev?(path) = (stat(path).chardev? rescue false)\n" ++
  "  def self.world_readable?(path) = (stat(path).world_readable? rescue nil)\n" ++
  "  def self.world_writable?(path) = (stat(path).world_writable? rescue nil)\n" ++
  "  # ⚠ utime(2), umask(2), mkfifo(2) and lchmod(2) live in headers an emitted\n" ++
  "  #   program does not include (the extern block in m_state.mere measured\n" ++
  "  #   which ones), so each of these asks the command that makes the same\n" ++
  "  #   call: touch(1), sh's umask, mkfifo(1), chmod -h. One subprocess per call.\n" ++
  "  #\n" ++
  "  # utime / lutime: -a and -m are separate runs because the two times may\n" ++
  "  # differ; -c so a missing path is REFUSED (ruby's ENOENT) rather than\n" ++
  "  # created; -h for lutime, which is the link itself. TZ=UTC0 because the\n" ++
  "  # stamp is written in UTC. Whole seconds -- `-t` has no finer field.\n" ++
  "  def self.__touch(atime, mtime, paths, link)\n" ++
  "    now = Time.now\n" ++
  "    stamp = lambda do |t|\n" ++
  "      t = now if t.nil?\n" ++
  "      t = Time.at(t) unless t.is_a?(Time)\n" ++
  "      t.getutc.strftime(\"%Y%m%d%H%M.%S\")\n" ++
  "    end\n" ++
  "    a = stamp.call(atime)\n" ++
  "    m = stamp.call(mtime)\n" ++
  "    paths = paths.map \{ |p| File::Stat.__path(p) }\n" ++
  "    paths.each do |p|\n" ++
  "      next if File.exist?(p) || (link && File.symlink?(p))\n" ++
  "      raise Errno::ENOENT.new(p, \"apply2files\")\n" ++
  "    end\n" ++
  "    return 0 if paths.empty?\n" ++
  "    q = paths.map \{ |p| File::Stat.__shq(p) }.join(\" \")\n" ++
  "    h = link ? \"-h \" : \"\"\n" ++
  "    `TZ=UTC0 touch -c #\{h}-a -t #\{a} #\{q} 2>/dev/null`\n" ++
  "    `TZ=UTC0 touch -c #\{h}-m -t #\{m} #\{q} 2>/dev/null`\n" ++
  "    paths.size\n" ++
  "  end\n" ++
  "  private_class_method :__touch\n" ++
  "  def self.utime(atime, mtime, *paths) = __touch(atime, mtime, paths, false)\n" ++
  "  def self.lutime(atime, mtime, *paths) = __touch(atime, mtime, paths, true)\n" ++
  "  # realpath / realdirpath RESOLVE SYMLINKS, which is the whole of what they\n" ++
  "  # add to expand_path. ⚠ They were textual (no lstat, no readlink here), so a\n" ++
  "  # path through a link answered the link's own name, and a link to itself\n" ++
  "  # answered as if it were a file.\n" ++
  "  # The directory part is resolved by the shell's `cd -P && pwd -P`, which is\n" ++
  "  # the kernel's own walk -- every link and every `..` in it, one subprocess\n" ++
  "  # -- and only the LAST component is followed here, link by link, until it\n" ++
  "  # is not a link. A link met twice is a loop (ELOOP, as realpath_rec says).\n" ++
  "  # realdirpath lets that last component be absent; realpath does not.\n" ++
  "  def self.__realpath(path, base, strict)\n" ++
  "    path = File::Stat.__path(path)\n" ++
  "    unless path.start_with?(\"/\")\n" ++
  "      base = base.nil? ? Dir.pwd : File::Stat.__path(base)\n" ++
  "      base = File.join(Dir.pwd, base) unless base.start_with?(\"/\")\n" ++
  "      path = File.join(base, path)\n" ++
  "    end\n" ++
  "    # a `..` that follows a FILE is not the kernel's to walk (\"f/..\" is\n" ++
  "    # ENOTDIR to cd) but ruby's realpath takes it lexically once the part\n" ++
  "    # before it is resolved -- `File.realpath(\"../\", file)` is the file's\n" ++
  "    # directory. So the path is cut at each `..`, the part before it resolved,\n" ++
  "    # and its dirname kept.\n" ++
  "    cur = \"/\"\n" ++
  "    pending = []\n" ++
  "    path.split(\"/\").each do |seg|\n" ++
  "      next if seg.empty? || seg == \".\"\n" ++
  "      if seg == \"..\"\n" ++
  "        cur = File.dirname(__rp_last(__rp_join(cur, pending), true))\n" ++
  "        pending = []\n" ++
  "      else\n" ++
  "        pending << seg\n" ++
  "      end\n" ++
  "    end\n" ++
  "    __rp_last(__rp_join(cur, pending), strict)\n" ++
  "  end\n" ++
  "  def self.__rp_join(cur, parts)\n" ++
  "    return cur if parts.empty?\n" ++
  "    (cur == \"/\" ? \"\" : cur) + \"/\" + parts.join(\"/\")\n" ++
  "  end\n" ++
  "  def self.__rp_last(path, strict)\n" ++
  "    seen = \{}\n" ++
  "    loop do\n" ++
  "      if File.directory?(path)\n" ++
  "        out = `cd -P -- #\{File::Stat.__shq(path)} 2>/dev/null && pwd -P`\n" ++
  "        return out.chomp if $?.success?\n" ++
  "      end\n" ++
  "      dir = File.dirname(path)\n" ++
  "      name = File.basename(path)\n" ++
  "      out = `cd -P -- #\{File::Stat.__shq(dir)} 2>/dev/null && pwd -P`\n" ++
  "      raise Errno::ENOENT.new(dir, \"realpath_rec\") unless $?.success?\n" ++
  "      dir = out.chomp\n" ++
  "      cand = (dir == \"/\" ? \"\" : dir) + \"/\" + name\n" ++
  "      if File.symlink?(cand)\n" ++
  "        if seen[cand]\n" ++
  "          raise Errno::ELOOP.new(cand, \"rb_check_realpath_internal\")\n" ++
  "        end\n" ++
  "        seen[cand] = true\n" ++
  "        t = File.readlink(cand)\n" ++
  "        path = t.start_with?(\"/\") ? t : File.join(dir, t)\n" ++
  "        next\n" ++
  "      end\n" ++
  "      return cand if !strict || File.exist?(cand)\n" ++
  "      raise Errno::ENOENT.new(cand, \"realpath_rec\")\n" ++
  "    end\n" ++
  "  end\n" ++
  "  private_class_method :__realpath, :__rp_join, :__rp_last\n" ++
  "  def self.realpath(path, base = nil) = __realpath(path, base, true)\n" ++
  "  def self.realdirpath(path, base = nil) = __realpath(path, base, false)\n" ++
  "\n" ++
  "  # ⚠ READ, NOT WRITTEN. A child inherits the mask, so a shell's `umask`\n" ++
  "  #   reads this process's. Setting it needs umask(2) itself, and a value\n" ++
  "  #   kept here that the kernel does not apply would be a mask nothing\n" ++
  "  #   honours -- every file this process creates would still get the old\n" ++
  "  #   one. So a change is refused; asking for the mask it already has is not\n" ++
  "  #   a change.\n" ++
  "  def self.umask(*args)\n" ++
  "    if args.size > 1\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given #\{args.size}, expected 0..1)\"\n" ++
  "    end\n" ++
  "    @__umask ||= `sh -c umask 2>/dev/null`.strip.to_i(8)\n" ++
  "    return @__umask if args.empty?\n" ++
  "    v = args[0]\n" ++
  "    v = v.to_int unless v.is_a?(Integer)\n" ++
  "    raise RangeError, \"integer #\{v} too big to convert to 'unsigned int'\" if v >= 2**32 || v < -2**31\n" ++
  "    return @__umask if v == @__umask\n" ++
  "    raise NotImplementedError, \"umask() function is unimplemented on this machine\"\n" ++
  "  end\n" ++
  "\n" ++
  "  # mkfifo(1) -m sets the mode EXACTLY, so the umask is taken off here, as\n" ++
  "  # mkfifo(2) would take it off.\n" ++
  "  def self.mkfifo(path, mode = 0o666)\n" ++
  "    path = File::Stat.__path(path)\n" ++
  "    mode = mode.to_int unless mode.is_a?(Integer)\n" ++
  "    if File.exist?(path) || File.symlink?(path)\n" ++
  "      raise Errno::EEXIST.new(path, \"rb_file_s_mkfifo\")\n" ++
  "    end\n" ++
  "    m = (mode & ~File.umask) & 0o7777\n" ++
  "    `mkfifo -m #\{m.to_s(8)} #\{File::Stat.__shq(path)} 2>/dev/null`\n" ++
  "    raise Errno::ENOENT.new(path, \"rb_file_s_mkfifo\") unless $?.success?\n" ++
  "    File.__fifo_made(path)\n" ++
  "    0\n" ++
  "  end\n" ++
  "\n" ++
  "  # readlink(2) fills a buffer, which no extern here can name; readlink(1) is\n" ++
  "  # the same call. It fails for a path that is not a link: EINVAL when the path\n" ++
  "  # is there, ENOENT when it is not.\n" ++
  "  def self.readlink(path)\n" ++
  "    path = File::Stat.__path(path)\n" ++
  "    out = `readlink #\{File::Stat.__shq(path)} 2>/dev/null`\n" ++
  "    if $?.success?\n" ++
  "      out = out[0, out.size - 1] if out.end_with?(\"\\n\")\n" ++
  "      return out\n" ++
  "    end\n" ++
  "    raise Errno::EINVAL.new(path, \"rb_readlink\") if File.exist?(path)\n" ++
  "    raise Errno::ENOENT.new(path, \"rb_readlink\")\n" ++
  "  end\n" ++
  "\n" ++
  "  # lchmod(2) is BSD's: Linux has none, and ruby says NotImplementedError\n" ++
  "  # there. chmod -h is the BSD command that makes the call.\n" ++
  "  def self.lchmod(mode, *paths)\n" ++
  "    raise NotImplementedError, \"lchmod() function is unimplemented on this machine\" unless File::Stat.__bsd?\n" ++
  "    mode = mode.to_int unless mode.is_a?(Integer)\n" ++
  "    paths = paths.map \{ |p| File::Stat.__path(p) }\n" ++
  "    paths.each do |p|\n" ++
  "      `chmod -h #\{(mode & 0o7777).to_s(8)} #\{File::Stat.__shq(p)} 2>/dev/null`\n" ++
  "      raise Errno::ENOENT.new(p, \"apply2files\") unless $?.success?\n" ++
  "    end\n" ++
  "    paths.size\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module FileTest\n" ++
  "  def self.owned?(path) = File.owned?(path)\n" ++
  "  def self.grpowned?(path) = File.grpowned?(path)\n" ++
  "  def self.setuid?(path) = File.setuid?(path)\n" ++
  "  def self.setgid?(path) = File.setgid?(path)\n" ++
  "  def self.sticky?(path) = File.sticky?(path)\n" ++
  "  def self.pipe?(path) = File.pipe?(path)\n" ++
  "  def self.socket?(path) = File.socket?(path)\n" ++
  "  def self.blockdev?(path) = File.blockdev?(path)\n" ++
  "  def self.chardev?(path) = File.chardev?(path)\n" ++
  "  def self.world_readable?(path) = File.world_readable?(path)\n" ++
  "  def self.world_writable?(path) = File.world_writable?(path)\n" ++
  "end\n";

// Dir's Enumerable and the three class methods that are one walk over an
// existing one (`entries` / `children`). They are here rather than in the
// dispatcher arm because they add nothing the arm has to know about.
let core_prelude_g =
  "class Dir\n" ++
  "  # ruby's Dir includes Enumerable, and a spec of its own reads that.\n" ++
  "  include Enumerable\n" ++
  "\n" ++
  "  # `empty?` is \"a directory with nothing in it\", so a path that is not a\n" ++
  "  # directory is false rather than an error -- but a path that is not THERE is\n" ++
  "  # ENOENT, which `entries` already raises.\n" ++
  "  def self.empty?(path)\n" ++
  "    # ⚠ A path that is not THERE is ENOENT; a path that is there and is not\n" ++
  "    # a directory is merely false. Answering false for both loses the\n" ++
  "    # difference, and it is the difference the spec reads.\n" ++
  "    raise Errno::ENOENT, path.to_s unless File.exist?(path)\n" ++
  "    return false unless File.directory?(path)\n" ++
  "    entries(path).size <= 2\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ These took (path) only, so `Dir.foreach(path, encoding: \"UTF-8\")` was an\n" ++
  "  #   ArgumentError -- the keyword is accepted by ruby and names the encoding\n" ++
  "  #   of the entries. It is accepted and not acted on: entries here carry the\n" ++
  "  #   filesystem encoding already, and refusing the keyword is a bigger\n" ++
  "  #   divergence than ignoring it.\n" ++
  "  # ⚠ ...and the enumerator's SIZE. to_enum with no size block answers nil in\n" ++
  "  #   ruby -- \"I do not know how many\" -- and this counted the entries instead,\n" ++
  "  #   so `Dir.foreach(path).size` was 15 where ruby says nil.\n" ++
  "  # ⚠ The encoding keyword is not decoration: the spec reads the encoding OFF\n" ++
  "  #   the yielded names. Accepting it and ignoring it answered UTF-8 where\n" ++
  "  #   ISO-8859-1 was asked for -- a keyword that looks honoured and is not.\n" ++
  "  # ⚠ ...and with NO keyword the names are transcoded to default_internal\n" ++
  "  #   when one is set, as every string ruby reads from the system is; a name\n" ++
  "  #   that will not convert is kept as it was read (rb_str_conv_enc).\n" ++
  "  def self.__with_enc(names, encoding)\n" ++
  "    # ...and \"as it was read\" is the FILESYSTEM encoding (default_external\n" ++
  "    # here), not UTF-8: with default_external SHIFT_JIS a name that will not\n" ++
  "    # convert to default_internal comes back SHIFT_JIS, as core/dir/read reads.\n" ++
  "    if encoding.nil?\n" ++
  "      fs = Encoding.find(\"filesystem\")\n" ++
  "      names = names.map \{ |n| n.encoding == fs ? n : n.dup.force_encoding(fs) }\n" ++
  "      di = Encoding.default_internal\n" ++
  "      return names if di.nil? || di == fs\n" ++
  "      return names.map \{ |n| (n.encode(di) rescue n) }\n" ++
  "    end\n" ++
  "    # an Encoding OBJECT is allowed here and Encoding.find refuses one --\n" ++
  "    # ruby/spec passes both spellings in the same example.\n" ++
  "    enc = encoding.is_a?(Encoding) ? encoding : Encoding.find(encoding)\n" ++
  "    names.map \{ |n| n.dup.force_encoding(enc) }\n" ++
  "  end\n" ++
  "  private_class_method :__with_enc\n" ++
  "\n" ++
  "  # the listing itself is the dispatcher's (__entries / __children); these\n" ++
  "  # are what it is called as, with the encoding keyword ruby takes\n" ++
  "  def self.entries(path, encoding: nil) = __with_enc(__entries(path), encoding)\n" ++
  "  def self.children(path, encoding: nil) = __with_enc(__children(path), encoding)\n" ++
  "\n" ++
  "  def self.each_child(path, encoding: nil, &block)\n" ++
  "    return to_enum(:each_child, path, encoding: encoding) \{ nil } unless block_given?\n" ++
  "    children(path, encoding: encoding).each(&block)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.foreach(path, encoding: nil, &block)\n" ++
  "    return to_enum(:foreach, path, encoding: encoding) \{ nil } unless block_given?\n" ++
  "    entries(path, encoding: encoding).each(&block)\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "end\n";

// The File INSTANCE side of the snapshot: #stat, #atime, #mtime, #ctime,
// #birthtime, #size. A File here is a path, a mode and a buffer, so each
// of these is the class method of the same name asked about @__f_path.
let core_prelude_h =
  "class File\n" ++
  "  # The instance side of the snapshot. A File here is a path, a mode and a\n" ++
  "  # buffer (see #fileno), and the path is what these need -- so they are the\n" ++
  "  # class methods asked about @__f_path rather than anything new.\n" ++
  "  # ⚠ each asks whether the stream is closed first: the builtin arm's guard\n" ++
  "  # is at ITS entry and a ruby method never reaches it, so `f.stat` answered on\n" ++
  "  # a closed File while `f.read` refused.\n" ++
  "  def __closed!\n" ++
  "    raise IOError, \"closed stream\" if self.closed?\n" ++
  "  end\n" ++
  "  private :__closed!\n" ++
  "\n" ++
  "  def stat = (__closed!; File::Stat.new(@__f_path))\n" ++
  "  def lstat = (__closed!; File::Stat.__lstat(@__f_path))\n" ++
  "  def atime = (__closed!; File.atime(@__f_path))\n" ++
  "  def mtime = (__closed!; File.mtime(@__f_path))\n" ++
  "  def ctime = (__closed!; File.ctime(@__f_path))\n" ++
  "  def birthtime = (__closed!; File.birthtime(@__f_path))\n" ++
  "  def size = (__closed!; File.size(@__f_path))\n" ++
  "  # flock(2) on the File's descriptor (the one #fileno hands out). A lock that\n" ++
  "  # has to WAIT waits the way IO's readiness loop does -- asked with LOCK_NB,\n" ++
  "  # the other threads run between asks -- because a flock(2) that blocked\n" ++
  "  # would block every thread in this process, and the holder may be one of\n" ++
  "  # them. A lock refused with LOCK_NB is false, as ruby says.\n" ++
  "  def flock(op)\n" ++
  "    __closed!\n" ++
  "    op = op.to_int unless op.is_a?(Integer)\n" ++
  "    fd = fileno\n" ++
  "    return 0 if File.__flock(fd, op | File::LOCK_NB) == 0\n" ++
  "    return false if (op & File::LOCK_NB) != 0\n" ++
  "    if IO.__sched?\n" ++
  "      begin\n" ++
  "        IO.__park until File.__flock(fd, op | File::LOCK_NB) == 0\n" ++
  "      ensure\n" ++
  "        IO.__unpark\n" ++
  "      end\n" ++
  "      0\n" ++
  "    elsif Thread.current != Thread.main\n" ++
  "      IO.__park\n" ++
  "      0\n" ++
  "    else\n" ++
  "      raise Errno::EBADF.new(\"flock\") if File.__flock(fd, op) != 0\n" ++
  "      0\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ A File printed its IVARS -- \"#<File:0x6f @__f_path=... @__f_mode=...>\"\n" ++
  "  #   -- because it had no #inspect of its own and the generic fallback took\n" ++
  "  #   over. ruby names the path, and says so when the stream is closed. This\n" ++
  "  #   is what every error message and every `p f` shows.\n" ++
  "  def inspect\n" ++
  "    \"#<File:\" + @__f_path.to_s + (closed? ? \" (closed)\" : \"\") + \">\"\n" ++
  "  end\n" ++
  "\n" ++
  "  # A File is not attached to a process. ruby answers nil for any IO that is\n" ++
  "  # not a pipe or a subprocess, which is every one of them here.\n" ++
  "  def pid\n" ++
  "    __closed!\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "end\n";

// IO::Buffer. A fixed-size byte region, with a String behind it rather than
// real memory -- see the class's own comment for which questions that model
// can answer and which it only appears to.
let core_prelude_i =
  "class IO\n" ++
  "  # IO::Buffer: a fixed-size byte region with a string behind it.\n" ++
  "  #\n" ++
  "  # ruby's is a view over real memory -- mapped files, another buffer's slice,\n" ++
  "  # a locked region -- and this one is a String. What that model CAN answer is\n" ++
  "  # the size, the bytes, the slicing and the freeing, which is what the suite\n" ++
  "  # spends most of its examples on. What it cannot is anything about where the\n" ++
  "  # memory came from: `mapped?` is false here because nothing is mapped, not\n" ++
  "  # because the question was skipped.\n" ++
  "  class Buffer\n" ++
  "    include Comparable\n" ++
  "\n" ++
  "    PAGE_SIZE = 4096\n" ++
  "    DEFAULT_SIZE = 65536\n" ++
  "    EXTERNAL = 1\n" ++
  "    INTERNAL = 2\n" ++
  "    MAPPED = 4\n" ++
  "    SHARED = 8\n" ++
  "    LOCKED = 32\n" ++
  "    PRIVATE = 64\n" ++
  "    READONLY = 128\n" ++
  "    HOST_ENDIAN = 4\n" ++
  "    BIG_ENDIAN = 8\n" ++
  "    LITTLE_ENDIAN = 4\n" ++
  "\n" ++
  "    class AccessError < RuntimeError; end\n" ++
  "    class AllocationError < RuntimeError; end\n" ++
  "    class LockedError < RuntimeError; end\n" ++
  "    class MaskError < ArgumentError; end\n" ++
  "    class InvalidatedError < RuntimeError; end\n" ++
  "\n" ++
  // without a block: a read-only COPY. With one: the string itself, writable
  // unless it is frozen, and freed when the block ends
  "    def self.for(string)\n" ++
  "      b = allocate\n" ++
  "      unless block_given?\n" ++
  "        b.__init_for(string.dup)\n" ++
  "        return b\n" ++
  "      end\n" ++
  "      b.__init_for(string, !string.frozen?)\n" ++
  "      begin\n" ++
  "        yield b\n" ++
  "      ensure\n" ++
  "        b.free\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # the arguments are checked the way ruby 4.0 checks them, and the flags\n" ++
  "    # are MAPPED plus EXTERNAL|SHARED (or PRIVATE) plus READONLY if asked\n" ++
  "    def self.map(file, size = nil, offset = 0, flags = 0)\n" ++
  "      raise TypeError, \"not an Integer\" unless size.nil? || size.is_a?(Integer)\n" ++
  "      raise TypeError, \"no implicit conversion from nil to integer\" if offset.nil?\n" ++
  "      unless offset.is_a?(Integer)\n" ++
  "        raise TypeError, \"no implicit conversion of #\{offset.class} into Integer\" unless offset.respond_to?(:to_int)\n" ++
  "        offset = offset.to_int\n" ++
  "      end\n" ++
  "      raise ArgumentError, \"Size can't be negative!\" if size && size < 0\n" ++
  "      raise ArgumentError, \"Size can't be zero!\" if size == 0\n" ++
  "      raise ArgumentError, \"Offset can't be negative!\" if offset < 0\n" ++
  "      whole = file.respond_to?(:path) ? File.binread(file.path) : File.binread(file.to_s)\n" ++
  "      fsize = whole.bytesize\n" ++
  "      if size.nil?\n" ++
  "        raise ArgumentError, \"Invalid negative or zero file size!\" if fsize <= 0\n" ++
  "        raise ArgumentError, \"Offset too large!\" if offset > fsize\n" ++
  "        size = fsize - offset\n" ++
  "      else\n" ++
  "        raise ArgumentError, \"Size can't be larger than file size!\" if size > fsize\n" ++
  "        raise ArgumentError, \"Offset too large!\" if offset + size > fsize\n" ++
  "      end\n" ++
  "      priv = (flags & PRIVATE) != 0\n" ++
  "      ro = (flags & READONLY) != 0\n" ++
  "      # a shared, writable mapping of a file opened for reading only is refused\n" ++
  "      if !ro && !priv && file.respond_to?(:instance_variable_get)\n" ++
  "        mode = file.instance_variable_get(:@__f_mode).to_s\n" ++
  "        raise Errno::EACCES, \"Permission denied\" if !mode.empty? && !mode.match?(/[wa+]/)\n" ++
  "      end\n" ++
  "      b = allocate\n" ++
  "      b.__init_for((whole.byteslice(offset, size) || +\"\").b.dup)\n" ++
  "      b.__mark_mapped(flags)\n" ++
  "      return b unless block_given?\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "\n" ++
  // a STRING-backed buffer over a new string of that many NULs: external and
  // writable for the block, freed after it, and the string is the answer
  "    def self.string(length)\n" ++
  "      raise LocalJumpError, \"no block given\" unless block_given?\n" ++
  "      length = __int!(length)\n" ++
  "      if length > 9223372036854775807 || length < -9223372036854775808\n" ++
  "        raise RangeError, \"bignum too big to convert into 'long'\"\n" ++
  "      end\n" ++
  "      raise ArgumentError, \"negative string size (or size too big)\" if length < 0\n" ++
  "      str = (\"\\x00\" * length).b\n" ++
  "      b = allocate\n" ++
  "      b.__init_for(str, true)\n" ++
  "      begin\n" ++
  "        yield b if block_given?\n" ++
  "      ensure\n" ++
  "        b.free\n" ++
  "      end\n" ++
  "      str\n" ++
  "    end\n" ++
  "\n" ++
  "    # ⚠ THE PREDICATES ARE THE FLAG BITS, not a derived state. Measured\n" ++
  "    # against ruby 4.0.6 by walking flags 0..8: `new(4, 3)` answers TRUE to\n" ++
  "    # both `internal?` and `external?`, because 3 is INTERNAL|EXTERNAL and each\n" ++
  "    # reader reports its own bit. A model that picked one \"kind\" per buffer\n" ++
  "    # reads as the tidier rule and cannot produce that row.\n" ++
  "    #\n" ++
  "    # And which flags ALLOCATE is its own question: `new` needs INTERNAL or\n" ++
  "    # MAPPED set -- 0, EXTERNAL alone and SHARED alone all raise\n" ++
  "    # AllocationError, because they describe memory that came from somewhere\n" ++
  "    # and `new` has nowhere to get it from.\n" ++
  "    # (a size of a page or more is MAPPED unless flags say otherwise: ruby asks\n" ++
  "    # the kernel for pages from there on)\n" ++
  "    def initialize(size = DEFAULT_SIZE, flags = nil)\n" ++
  "      size = IO::Buffer.__int!(size)\n" ++
  "      raise ArgumentError, \"Size can't be negative!\" if size < 0\n" ++
  "      flags = size >= PAGE_SIZE ? MAPPED : INTERNAL if flags.nil?\n" ++
  "      flags = IO::Buffer.__int!(flags)\n" ++
  "      raise ArgumentError, \"Flags can't be negative!\" if flags < 0\n" ++
  "      unless size == 0 || (flags & (INTERNAL | MAPPED)) != 0\n" ++
  "        raise IO::Buffer::AllocationError, \"Could not allocate buffer!\"\n" ++
  "      end\n" ++
  "      @s = \"\\x00\".b * size\n" ++
  "      @freed = false\n" ++
  // (a zero-size buffer allocates nothing: it is NULL, not INTERNAL)
  "      @flags = size == 0 ? 0 : flags\n" ++
  "      @__null = size == 0\n" ++
  "    end\n" ++
  "\n" ++
  "    # a size and flags are Integers, and nothing else converts to one\n" ++
  "    def self.__int!(v)\n" ++
  "      raise TypeError, \"not an Integer\" unless v.is_a?(Integer)\n" ++
  "      v\n" ++
  "    end\n" ++
  "\n" ++
  "    # `for` is a view over the caller's string: EXTERNAL, and ruby marks it\n" ++
  "    # READONLY whether or not that string is frozen.\n" ++
  "    def __init_for(string, writable = false)\n" ++
  "      @s = string\n" ++
  "      @freed = false\n" ++
  "      @flags = writable ? EXTERNAL : (EXTERNAL | READONLY)\n" ++
  "    end\n" ++
  // the bytes are rewritten IN the backing string, so a string-backed buffer
  // writes through to the string it was made for
  "    def __store(bytes)\n" ++
  "      enc = @s.encoding\n" ++
  "      @s.frozen? ? (@s = bytes) : @s.replace(bytes.force_encoding(enc))\n" ++
  "    end\n" ++
  "    private :__store\n" ++
  "\n" ++
  "    # ⚠ A SLICE IS A VIEW, not a copy: [what it looks into, offset, length].\n" ++
  "    #   It looks into the BUFFER for memory a buffer owns (new, map), and into\n" ++
  "    #   the STRING for a string-backed one (for, string) -- which is why a\n" ++
  "    #   slice of a freed string-backed buffer stays valid while the string\n" ++
  "    #   lives, and a slice of a freed or transferred buffer does not. Writes go\n" ++
  "    #   through to what it looks into.\n" ++
  "    def __init_view(src, off, len, ro)\n" ++
  "      @__view = [src, off, len]\n" ++
  "      @s = nil\n" ++
  "      @freed = false\n" ++
  "      @flags = EXTERNAL | (ro ? READONLY : 0)\n" ++
  "    end\n" ++
  "\n" ++
  "    def __own = (@freed ? nil : @s)\n" ++
  "\n" ++
  "    # the bytes this buffer shows (a view reads them from its source)\n" ++
  "    def __raw\n" ++
  "      return @s unless @__view\n" ++
  "      raise IO::Buffer::InvalidatedError, \"Buffer has been invalidated!\" unless valid?\n" ++
  "      src, off, len = @__view\n" ++
  "      (src.is_a?(String) ? src : src.__own).b.byteslice(off, len) || +\"\".b\n" ++
  "    end\n" ++
  "\n" ++
  "    # write `bytes` at `offset` of what this buffer shows\n" ++
  "    def __put(offset, bytes)\n" ++
  "      unless @__view\n" ++
  "        whole = @s.b\n" ++
  "        __store(whole.byteslice(0, offset).to_s + bytes + whole.byteslice(offset + bytes.bytesize, whole.bytesize).to_s)\n" ++
  "        return\n" ++
  "      end\n" ++
  "      raise IO::Buffer::InvalidatedError, \"Buffer has been invalidated!\" unless valid?\n" ++
  "      src, off, = @__view\n" ++
  "      if src.is_a?(String)\n" ++
  "        enc = src.encoding\n" ++
  "        whole = src.b\n" ++
  "        src.replace((whole.byteslice(0, off + offset).to_s + bytes + whole.byteslice(off + offset + bytes.bytesize, whole.bytesize).to_s).force_encoding(enc))\n" ++
  "      else\n" ++
  "        src.__put(off + offset, bytes)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def __mark_mapped(flags = 0)\n" ++
  "      priv = (flags & PRIVATE) != 0\n" ++
  "      @flags = MAPPED | (priv ? PRIVATE : (EXTERNAL | SHARED)) | (flags & READONLY)\n" ++
  "    end\n" ++
  "\n" ++
  "    def size = @freed ? 0 : (@__view ? @__view[2] : @s.bytesize)\n" ++
  "    def empty? = size == 0\n" ++
  "    def null? = @freed || @__null == true\n" ++
  // valid unless it is a slice whose source was freed, transferred, or cut
  // short of it
  "    def valid?\n" ++
  "      return true unless @__view\n" ++
  "      return false if @freed\n" ++
  "      src, off, len = @__view\n" ++
  "      mem = src.is_a?(String) ? src : src.__own\n" ++
  "      !mem.nil? && off + len <= mem.bytesize\n" ++
  "    end\n" ++
  "    # ⚠ a freed buffer reads as INTERNAL and NULL whatever it was before:\n" ++
  "    # ruby prints `#<IO::Buffer 0x0+0 NULL INTERNAL>` for a transferred one.\n" ++
  "    def external? = !@freed && (@flags & EXTERNAL) != 0\n" ++
  "    def internal? = !@freed && (@flags & INTERNAL) != 0\n" ++
  "    def mapped? = !@freed && (@flags & MAPPED) != 0\n" ++
  "    def shared? = !@freed && (@flags & SHARED) != 0\n" ++
  "    def private? = !@freed && (@flags & PRIVATE) != 0\n" ++
  "    def readonly? = !@freed && (@flags & READONLY) != 0\n" ++
  "    def locked? = !@freed && (@flags & LOCKED) != 0\n" ++
  "\n" ++
  "    def free\n" ++
  "      raise IO::Buffer::LockedError, \"Buffer is locked!\" if locked?\n" ++
  "      @s = +\"\".b\n" ++
  "      @__view = nil\n" ++
  "      @freed = true\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def __check!\n" ++
  "      raise IOError, \"buffer has been freed\" if @freed\n" ++
  "    end\n" ++
  "    private :__check!\n" ++
  "\n" ++
  "    # ⚠ A FREED BUFFER IS NOT AN ERROR TO READ. ruby answers \"\" -- it has a\n" ++
  "    # null pointer and zero length, which is a consistent empty region, not a\n" ++
  "    # broken one. Raising here is the tidier-looking rule and the wrong one.\n" ++
  // (BINARY unless an encoding is asked for, whatever the backing string's)
  "    def get_string(offset = 0, length = nil, encoding = nil)\n" ++
  "      return +\"\".b if @freed\n" ++
  "      raw = __raw\n" ++
  "      length = raw.bytesize - offset if length.nil?\n" ++
  "      raise ArgumentError, \"offset out of range\" if offset < 0 || offset > raw.bytesize\n" ++
  "      raise ArgumentError, \"length out of range\" if length < 0 || offset + length > raw.bytesize\n" ++
  "      r = (raw.byteslice(offset, length) || +\"\").b\n" ++
  "      encoding ? r.force_encoding(encoding) : r\n" ++
  "    end\n" ++
  "\n" ++
  "    def set_string(string, offset = 0, length = nil, source_offset = 0)\n" ++
  "      raise ArgumentError, \"offset out of range\" if @freed\n" ++
  "      raise IO::Buffer::AccessError, \"Buffer is not writable!\" if readonly?\n" ++
  "      src = string.to_s.b\n" ++
  "      src = src.byteslice(source_offset, length || (src.bytesize - source_offset)) || +\"\".b\n" ++
  "      raise ArgumentError, \"offset out of range\" if offset < 0 || offset + src.bytesize > size\n" ++
  "      __put(offset, src)\n" ++
  "      src.bytesize\n" ++
  "    end\n" ++
  "\n" ++
  "    def clear(value = 0, offset = 0, length = nil)\n" ++
  "      __check!\n" ++
  "      length = size - offset if length.nil?\n" ++
  "      __put(offset, (value.chr * length).b)\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def resize(new_size)\n" ++
  "      raise IO::Buffer::LockedError, \"Cannot resize locked buffer!\" if locked?\n" ++
  "      raise IO::Buffer::AccessError, \"Cannot resize external buffer!\" if external?\n" ++
  "      new_size = IO::Buffer.__int!(new_size)\n" ++
  "      raise ArgumentError, \"Size can't be negative!\" if new_size < 0\n" ++
  // to 0 frees it; a null or freed one comes back as a new buffer of that
  // size (a page or more is MAPPED, as `new` makes it); and a shared mapping
  // is reallocated as INTERNAL, which is what a platform without mremap does
  "      if new_size == 0\n" ++
  "        @s = +\"\".b\n" ++
  "        @freed = false\n" ++
  "        @__null = true\n" ++
  "        @flags = 0\n" ++
  "        return self\n" ++
  "      end\n" ++
  "      if null?\n" ++
  "        @s = +\"\".b\n" ++
  "        @freed = false\n" ++
  "        @__null = false\n" ++
  "        @flags = new_size >= PAGE_SIZE ? MAPPED : INTERNAL\n" ++
  "      elsif (@flags & MAPPED) != 0 && (@flags & PRIVATE) == 0\n" ++
  "        @flags = (@flags & ~MAPPED) | INTERNAL\n" ++
  "      end\n" ++
  "      cur = @s.bytesize\n" ++
  "      @s = new_size <= cur ? @s.byteslice(0, new_size) : @s + (\"\\x00\".b * (new_size - cur))\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def slice(offset = 0, length = nil)\n" ++
  "      length = size - offset if length.nil?\n" ++
  "      raise ArgumentError, \"offset out of range\" if offset < 0 || offset > size\n" ++
  "      raise ArgumentError, \"length out of range\" if length < 0 || offset + length > size\n" ++
  "      sl = self.class.allocate\n" ++
  "      # a slice of nothing is nothing\n" ++
  "      if null?\n" ++
  "        sl.__init_view(self, 0, 0, readonly?)\n" ++
  "        sl.instance_variable_set(:@__null, true)\n" ++
  "        return sl\n" ++
  "      end\n" ++
  "      if @__view\n" ++
  "        src, base, = @__view\n" ++
  "      elsif (@flags & EXTERNAL) != 0 && (@flags & MAPPED) == 0\n" ++
  "        src, base = @s, 0\n" ++
  "      else\n" ++
  "        src, base = self, 0\n" ++
  "      end\n" ++
  "      sl.__init_view(src, base + offset, length, readonly?)\n" ++
  "      sl\n" ++
  "    end\n" ++
  "\n" ++
  "    # `transfer` hands the region over and leaves this one null -- the one\n" ++
  "    # operation whose whole point is that the SOURCE stops owning it.\n" ++
  // the lock: reading and writing go on, changing the buffer ITSELF does not
  "    def locked\n" ++
  "      raise IO::Buffer::LockedError, \"Buffer already locked!\" if locked?\n" ++
  "      @flags |= LOCKED\n" ++
  "      begin\n" ++
  "        yield self\n" ++
  "      ensure\n" ++
  "        @flags &= ~LOCKED\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def transfer\n" ++
  "      raise IO::Buffer::LockedError, \"Cannot transfer ownership of locked buffer!\" if locked?\n" ++
  // the SAME memory changes hands: its address, its flags and (for a
  // string-backed buffer) its string go to the new object, and this one is
  // left null
  "      b = self.class.allocate\n" ++
  "      b.instance_variable_set(:@s, @s)\n" ++
  "      b.instance_variable_set(:@__view, @__view)\n" ++
  "      b.instance_variable_set(:@freed, false)\n" ++
  "      b.instance_variable_set(:@flags, @flags)\n" ++
  "      b.instance_variable_set(:@__addr, __addr)\n" ++
  "      @s = +\"\".b\n" ++
  "      @__view = nil\n" ++
  "      @freed = true\n" ++
  "      b\n" ++
  "    end\n" ++
  "\n" ++
  "    def __addr = (@__addr ||= object_id)\n" ++
  "    def to_s\n" ++
  "      return \"#<IO::Buffer 0x0000000000000000+0 NULL INTERNAL>\" if @freed\n" ++
  "      kind = []\n" ++
  "      kind << \"EXTERNAL\" if external?\n" ++
  "      kind << \"INTERNAL\" if internal?\n" ++
  "      kind << \"MAPPED\" if mapped?\n" ++
  "      kind << \"SHARED\" if shared?\n" ++
  "      kind << \"LOCKED\" if locked?\n" ++
  "      kind << \"PRIVATE\" if private?\n" ++
  "      kind << \"READONLY\" if readonly?\n" ++
  "      \"#<IO::Buffer 0x#\{format('%016x', __addr)}+#\{size} #\{kind.join(' ')}>\"\n" ++
  "    end\n" ++
  "\n" ++
  "    def inspect = to_s + (size == 0 ? \"\" : \"\\n\" + hexdump)\n" ++
  "\n" ++
  "    def hexdump\n" ++
  "      return \"\" if @freed || size == 0\n" ++
  "      raw = __raw\n" ++
  "      out = []\n" ++
  "      i = 0\n" ++
  "      while i < raw.bytesize\n" ++
  "        row = raw.byteslice(i, 16)\n" ++
  "        hex = row.bytes.map \{ |b| format(\"%02x\", b) }.join(\" \")\n" ++
  "        asc = row.bytes.map \{ |b| (b >= 32 && b < 127) ? b.chr : \".\" }.join\n" ++
  "        out << format(\"0x%08x  %-48s %s\", i, hex, asc)\n" ++
  "        i += 16\n" ++
  "      end\n" ++
  "      out.join(\"\\n\")\n" ++
  "    end\n" ++
  "\n" ++
  "    def read(io, length = nil, offset = 0)\n" ++
  "      __check!\n" ++
  "      data = length.nil? ? io.read : io.read(length)\n" ++
  "      return 0 if data.nil?\n" ++
  "      set_string(data, offset)\n" ++
  "    end\n" ++
  "\n" ++
  "    def write(io, length = nil, offset = 0)\n" ++
  "      __check!\n" ++
  "      s = get_string(offset, length)\n" ++
  "      io.write(s)\n" ++
  "      s.bytesize\n" ++
  "    end\n" ++
  "\n" ++
  "    # the result of a bitwise operation is a NEW INTERNAL buffer, not a view --\n" ++
  "    # `.for` would make it external and the spec reads `#internal?`.\n" ++
  "    def __new_internal(bytes)\n" ++
  "      b = IO::Buffer.new(bytes.bytesize)\n" ++
  "      b.set_string(bytes, 0)\n" ++
  "      b\n" ++
  "    end\n" ++
  "    private :__new_internal\n" ++
  "\n" ++
  // the MASK repeats across the buffer (a longer one is cut short), and it
  // must be a Buffer -- ruby 4.0.6, measured
  "    def __bitwise_bytes(other, op)\n" ++
  "      __check!\n" ++
  "      unless other.is_a?(IO::Buffer)\n" ++
  "        raise TypeError, \"wrong argument type \" + (other.nil? ? \"nil\" : other.class.to_s) + \" (expected IO::Buffer)\"\n" ++
  "      end\n" ++
  "      a = __raw.bytes\n" ++
  "      b = other.get_string.bytes\n" ++
  "      out = +\"\".b\n" ++
  "      i = 0\n" ++
  "      while i < a.size\n" ++
  "        m = b.empty? ? 0 : b[i % b.size]\n" ++
  "        v = op == :and ? (a[i] & m) : (op == :or ? (a[i] | m) : (a[i] ^ m))\n" ++
  "        out << v.chr\n" ++
  "        i += 1\n" ++
  "      end\n" ++
  "      out\n" ++
  "    end\n" ++
  "    private :__bitwise_bytes\n" ++
  "\n" ++
  "    def &(other) = __new_internal(__bitwise_bytes(other, :and))\n" ++
  "    def |(other) = __new_internal(__bitwise_bytes(other, :or))\n" ++
  "    def ^(other) = __new_internal(__bitwise_bytes(other, :xor))\n" ++
  "    def and!(other) = (set_string(__bitwise_bytes(other, :and)); self)\n" ++
  "    def or!(other) = (set_string(__bitwise_bytes(other, :or)); self)\n" ++
  "    def xor!(other) = (set_string(__bitwise_bytes(other, :xor)); self)\n" ++
  "\n" ++
  "    def ~\n" ++
  "      __check!\n" ++
  "      __new_internal(__raw.bytes.map \{ |b| (~b & 255).chr }.join.b)\n" ++
  "    end\n" ++
  // ...and IN PLACE, answering the buffer itself
  "    def not!\n" ++
  "      __check!\n" ++
  "      set_string(get_string.bytes.map \{ |b| (~b & 255).chr }.join.b)\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    # ⚠ no `bit_count`: ruby 4.0.6 does not have one\n" ++
  "    # (`IO::Buffer.new(4).respond_to?(:bit_count)` is false), and\n" ++
  "    # core/io/buffer/bit_count_spec.rb is guarded for a version that does.\n" ++
  "    # Shipping a method the oracle lacks is a divergence, not a bonus.\n" ++
  "\n" ++
  "    # the typed values: lower case little-endian, upper case big-endian, as\n" ++
  "    # String#unpack1 spells them\n" ++
  "    VALUE_TYPES = \{ U8: [\"C\", 1], S8: [\"c\", 1],\n" ++
  "                    u16: [\"S<\", 2], U16: [\"S>\", 2], s16: [\"s<\", 2], S16: [\"s>\", 2],\n" ++
  "                    u32: [\"L<\", 4], U32: [\"L>\", 4], s32: [\"l<\", 4], S32: [\"l>\", 4],\n" ++
  "                    u64: [\"Q<\", 8], U64: [\"Q>\", 8], s64: [\"q<\", 8], S64: [\"q>\", 8],\n" ++
  "                    f32: [\"e\", 4], F32: [\"g\", 4], f64: [\"E\", 8], F64: [\"G\", 8] }.freeze\n" ++
  "\n" ++
  "    def self.__type(t)\n" ++
  "      VALUE_TYPES[t] || raise(ArgumentError, \"Invalid type name!\")\n" ++
  "    end\n" ++
  "\n" ++
  "    def get_value(type, offset)\n" ++
  "      fmt, n = IO::Buffer.__type(type)\n" ++
  "      raise ArgumentError, \"Specified offset+length exceeds buffer size!\" if offset < 0 || offset + n > size\n" ++
  "      __raw.byteslice(offset, n).unpack1(fmt)\n" ++
  "    end\n" ++
  "\n" ++
  "    def each(type, offset = 0, count = nil)\n" ++
  "      return to_enum(:each, type, offset, count) unless block_given?\n" ++
  "      _, n = IO::Buffer.__type(type)\n" ++
  "      count = (size - offset) / n if count.nil?\n" ++
  "      count.times do |i|\n" ++
  "        o = offset + i * n\n" ++
  "        yield o, get_value(type, o)\n" ++
  "      end\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def <=>(other) = other.is_a?(IO::Buffer) ? (get_string <=> other.get_string) : nil\n" ++
  "    def ==(other) = other.is_a?(IO::Buffer) && get_string == other.get_string\n" ++
  "  end\n" ++
  "end\n";

// The IO surface a File can answer without a descriptor: the byte and
// character readers, pread/pwrite, the line counter, pushback, and the
// flags. What needs a real fd is named in the section's own comment and is
// deliberately not here.
let core_prelude_j =
  "class File\n" ++
  "  # ⚠ EVERY CALL TO A BUILTIN METHOD BELOW IS WRITTEN `self.x`. A bare\n" ++
  "  # `self.read(1)` from a ruby method on File is a NoMethodError: the dispatcher's\n" ++
  "  # instance methods are not in a method table, so the receiverless path does\n" ++
  "  # not find them. `self.read(1)` and `__send__(:read, 1)` both work. Same\n" ++
  "  # shape as \"an alias of a builtin Kernel method cannot be called with no\n" ++
  "  # receiver\" in KNOWN_GAPS.\n" ++
  "  #\n" ++
  "  # The IO surface a File can answer WITHOUT a descriptor. This one is a path,\n" ++
  "  # a mode, a buffer and a position (see #fileno, which refuses for that\n" ++
  "  # reason), and that is enough for everything below: reading at an offset,\n" ++
  "  # the byte and character readers, the line counter, pushback, and the flags.\n" ++
  "  #\n" ++
  "  # What is NOT here needs a real fd and says so: fcntl, ioctl, fsync's\n" ++
  "  # durability, for_fd, sysopen, the *_nonblock pair, the wait_* family,\n" ++
  "  # autoclose? and close_on_exec?.\n" ++
  "\n" ++
  "  # ⚠ THE ARM'S CLOSED-STREAM GUARD DOES NOT COVER THESE. It sits at the\n" ++
  "  # entry of the builtin File arm, and a method defined here in ruby never\n" ++
  "  # reaches that entry -- `f.stat` and `f.lineno` answered happily on a closed\n" ++
  "  # stream while `f.read` refused. Every reader and writer below asks first.\n" ++
  "  def __closed!\n" ++
  "    raise IOError, \"closed stream\" if self.closed?\n" ++
  "  end\n" ++
  "  private :__closed!\n" ++
  "\n" ++
  "  # --- reading -------------------------------------------------------------\n" ++
  "  # read(length = nil, buffer = nil): with a length, BYTES (BINARY), nil at\n" ++
  "  # the end, into a buffer that keeps its own encoding; without one, the rest\n" ++
  "  # of the file in the stream's encodings, \"\" at the end.\n" ++
  "  def read(len = nil, buf = nil)\n" ++
  "    unless buf.nil?\n" ++
  "      buf = IO.__fd_str(buf)\n" ++
  "      raise FrozenError, \"can't modify frozen String: \" + buf.inspect if buf.frozen?\n" ++
  "    end\n" ++
  "    self.__f_read(0)\n" ++
  "    __f_bom_skip\n" ++
  "    if len.nil?\n" ++
  "      s = self.__f_read\n" ++
  "      ext, int = __ln_encs\n" ++
  "      s.force_encoding(ext)\n" ++
  "      s = s.encode(int, ext, **(@__f_ecopts || \{})) if int\n" ++
  "      return s if buf.nil?\n" ++
  "      return buf.replace(s)\n" ++
  "    end\n" ++
  "    len = IO.__fd_long(IO.__fd_int(len))\n" ++
  "    raise ArgumentError, \"negative length \" + len.to_s + \" given\" if len < 0\n" ++
  "    s = self.__f_read(len)\n" ++
  "    if s.nil?\n" ++
  "      buf.clear if buf\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    __into(buf, s)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- byte and character readers -----------------------------------------\n" ++
  "  def getbyte\n" ++
  "    __closed!\n" ++
  "    s = self.__f_read(1)\n" ++
  "    s.nil? || s.empty? ? nil : s.getbyte(0)\n" ++
  "  end\n" ++
  "\n" ++
  "  def readbyte\n" ++
  "    b = getbyte\n" ++
  "    raise EOFError, \"end of file reached\" if b.nil?\n" ++
  "    b\n" ++
  "  end\n" ++
  "\n" ++
  "  # ⚠ A CHARACTER IS AS LONG AS ITS LEAD BYTE SAYS, and a lead byte that\n" ++
  "  # starts no character is a character of one byte (invalid, as ruby's is):\n" ++
  "  # the reader used to keep taking bytes until what it held was valid, so a\n" ++
  "  # read from inside a character swallowed the next one with it. It reads in\n" ++
  "  # the stream's encoding (#external_encoding), transcoding to the internal.\n" ++
  "  def getc\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    __f_bom_skip\n" ++
  "    b = self.__f_read(1)\n" ++
  "    return nil if b.nil? || b.empty?\n" ++
  "    ext, int = __ln_encs\n" ++
  "    s = b.b\n" ++
  "    lead = s.getbyte(0)\n" ++
  "    if lead >= 0x80 && ext != Encoding::BINARY && ext.ascii_compatible? && !s.dup.force_encoding(ext).valid_encoding?\n" ++
  "      max = ext == Encoding::UTF_8 ? (lead >= 0xF0 ? 4 : lead >= 0xE0 ? 3 : lead >= 0xC2 ? 2 : 1) : 4\n" ++
  "      rest = max > 1 ? self.__f_read(max - 1).to_s.b : +\"\".b\n" ++
  "      n = 1\n" ++
  "      (2..(1 + rest.bytesize)).each do |k|\n" ++
  "        if (s + rest.byteslice(0, k - 1)).force_encoding(ext).valid_encoding?\n" ++
  "          n = k\n" ++
  "          break\n" ++
  "        end\n" ++
  "      end\n" ++
  "      s << rest.byteslice(0, n - 1)\n" ++
  "      back = rest.bytesize - (n - 1)\n" ++
  "      self.pos = self.pos - back if back > 0\n" ++
  "    end\n" ++
  "    s.force_encoding(ext)\n" ++
  "    s = s.encode(int, ext) if int && s.valid_encoding?\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def readchar\n" ++
  "    c = getc\n" ++
  "    raise EOFError, \"end of file reached\" if c.nil?\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  # the enumerators come first: a closed stream still hands one out (it\n" ++
  "  # refuses when it is read), and its size is not known without reading\n" ++
  "  def each_byte\n" ++
  "    return to_enum(:each_byte) \{ nil } unless block_given?\n" ++
  "    __closed!\n" ++
  "    while (b = getbyte)\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_char\n" ++
  "    return to_enum(:each_char) \{ nil } unless block_given?\n" ++
  "    __closed!\n" ++
  "    while (c = getc)\n" ++
  "      yield c\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def each_codepoint\n" ++
  "    return to_enum(:each_codepoint) \{ nil } unless block_given?\n" ++
  "    __closed!\n" ++
  "    each_char do |c|\n" ++
  "      raise ArgumentError, \"invalid byte sequence in \" + c.encoding.to_s unless c.valid_encoding?\n" ++
  "      yield c.ord\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- pushback ------------------------------------------------------------\n" ++
  "  # The bytes go back in FRONT of what is left to read (@__f_unget, which the\n" ++
  "  # builtin reader, #eof? and #pos all honour), whatever they are: pushing\n" ++
  "  # back a character that was never read is how a parser peeks. An Integer\n" ++
  "  # is a codepoint in the external encoding for #ungetc and a byte for\n" ++
  "  # #ungetbyte.\n" ++
  "  def __unget(bytes)\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    @__f_unget = bytes.b + (@__f_unget || \"\").b\n" ++
  "    nil\n" ++
  "  end\n" ++
  "  private :__unget\n" ++
  "\n" ++
  "  def ungetbyte(b)\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    return nil if b.nil?\n" ++
  "    __unget(b.is_a?(Integer) ? (b & 0xff).chr : IO.__fd_str(b))\n" ++
  "  end\n" ++
  "\n" ++
  "  def ungetc(c)\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    if c.is_a?(Integer)\n" ++
  "      ext, = __ln_encs\n" ++
  "      s = (ext == Encoding::BINARY || c < 0x80) ? (c & 0xff).chr : c.chr(ext)\n" ++
  "    else\n" ++
  "      s = IO.__fd_str(c)\n" ++
  "    end\n" ++
  "    __unget(s)\n" ++
  "  end\n" ++
  "\n" ++
  "  # the BOM at the start of the stream names its encoding, and is read past\n" ++
  "  def set_encoding_by_bom\n" ++
  "    __closed!\n" ++
  "    m = @__f_mode.to_s\n" ++
  "    return nil unless m.start_with?(\"r\") || m.include?(\"+\")\n" ++
  "    unless @__f_binmode || m.split(\":\", 2)[0].include?(\"b\")\n" ++
  "      raise ArgumentError, \"ASCII incompatible encoding needs binmode\"\n" ++
  "    end\n" ++
  "    ext, int = __ln_encs\n" ++
  "    raise ArgumentError, \"encoding conversion is set\" if int\n" ++
  "    raise ArgumentError, \"encoding is set to \" + ext.to_s + \" already\" if ext != Encoding::BINARY\n" ++
  "    head = (self.__f_read(4) || \"\").b\n" ++
  "    enc, n = if head.start_with?(\"\\xEF\\xBB\\xBF\".b) then [Encoding::UTF_8, 3]\n" ++
  "             elsif head.start_with?(\"\\xFE\\xFF\".b) then [Encoding::UTF_16BE, 2]\n" ++
  "             elsif head.start_with?(\"\\xFF\\xFE\\x00\\x00\".b) then [Encoding::UTF_32LE, 4]\n" ++
  "             elsif head.start_with?(\"\\xFF\\xFE\".b) then [Encoding::UTF_16LE, 2]\n" ++
  "             elsif head.start_with?(\"\\x00\\x00\\xFE\\xFF\".b) then [Encoding::UTF_32BE, 4]\n" ++
  "             else [nil, 0]\n" ++
  "             end\n" ++
  "    back = head.bytesize - n\n" ++
  "    self.pos = self.pos - back if back > 0\n" ++
  "    return nil if enc.nil?\n" ++
  "    __f_setencs(enc, nil, true, false, false)\n" ++
  "    enc\n" ++
  "  end\n" ++
  "\n" ++
  "\" ++  \"  # --- reading at an offset, without moving the position -------------------\n" ++
  "  # Integers through #to_int and a buffer through #to_str; a zero length\n" ++
  "  # reads nothing and leaves the buffer as it was, wherever the offset is;\n" ++
  "  # the buffer keeps its own encoding.\n" ++
  "  def pread(length, offset, buffer = nil)\n" ++
  "    length = __pread_int(length)\n" ++
  "    offset = __pread_int(offset)\n" ++
  "    unless buffer.nil? || buffer.is_a?(String)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + buffer.class.to_s + \" into String\" unless buffer.respond_to?(:to_str)\n" ++
  "      buffer = buffer.to_str\n" ++
  "    end\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    raise ArgumentError, \"negative string size (or size too big)\" if length < 0\n" ++
  "    raise Errno::EINVAL, \"pread(2)\" if offset < 0\n" ++
  "    return buffer || +\"\" if length == 0\n" ++
  "    data = File.binread(@__f_path, length, offset)\n" ++
  "    raise EOFError, \"end of file reached\" if data.nil? || data.empty?\n" ++
  "    return data if buffer.nil?\n" ++
  "    enc = buffer.encoding\n" ++
  "    buffer.replace(data)\n" ++
  "    buffer.force_encoding(enc)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __pread_int(n)\n" ++
  "    return n if n.is_a?(Integer)\n" ++
  "    raise TypeError, \"no implicit conversion of \" + n.class.to_s + \" into Integer\" unless n.respond_to?(:to_int)\n" ++
  "    n.to_int\n" ++
  "  end\n" ++
  "  private :__pread_int\n" ++
  "\n" ++
  "  def pwrite(string, offset)\n" ++
  "    __closed!\n" ++
  "    # a read-only file refuses, and the offset converts by #to_int\n" ++
  "    raise IOError, \"not opened for writing\" unless instance_variable_get(:@__f_mode).to_s.match?(/[wa+]/)\n" ++
  "    unless offset.is_a?(Integer)\n" ++
  "      raise TypeError, \"no implicit conversion of #\{offset.class} into Integer\" unless offset.respond_to?(:to_int)\n" ++
  "      offset = offset.to_int\n" ++
  "    end\n" ++
  "    s = string.to_s\n" ++
  "    whole = File.exist?(@__f_path) ? File.binread(@__f_path) : +\"\".b\n" ++
  "    whole = whole + (\"\\x00\".b * (offset - whole.bytesize)) if offset > whole.bytesize\n" ++
  "    File.binwrite(@__f_path, whole.byteslice(0, offset).to_s + s +\n" ++
  "                  whole.byteslice(offset + s.bytesize, whole.bytesize).to_s)\n" ++
  "    s.bytesize\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the unbuffered pair, which here is the buffered one ----------------\n" ++
  "  # ⚠ `sysread` and `syswrite` are \"do not buffer\" in ruby. This File writes\n" ++
  "  # through a buffer flushed at close, so the DIFFERENCE they name does not\n" ++
  "  # exist here -- they are the plain read and write, and a program that used\n" ++
  "  # them to defeat buffering gets no guarantee it did.\n" ++
  "  # ...refused while bytes read AHEAD of the program are still waiting: what\n" ++
  "  # #ungetc pushed back, or the rest of the chunk a line reader took (ruby's\n" ++
  "  # read buffer, which this model keeps as @__f_ahead until the position\n" ++
  "  # moves or a write discards it)\n" ++
  "  def sysread(length, buffer = nil)\n" ++
  "    __closed!\n" ++
  "    buffer = IO.__fd_str(buffer) unless buffer.nil?\n" ++
  "    length = IO.__fd_long(IO.__fd_int(length))\n" ++
  "    raise ArgumentError, \"negative length \" + length.to_s + \" given\" if length < 0\n" ++
  "    raise IOError, \"sysread for buffered IO\" if @__f_ahead || (@__f_unget && !@__f_unget.empty?)\n" ++
  "    return buffer || +\"\".b if length == 0\n" ++
  "    data = self.__f_read(length)\n" ++
  "    if data.nil?\n" ++
  "      buffer.clear if buffer\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    __into(buffer, data)\n" ++
  "  end\n" ++
  "\n" ++
  "  # a buffer argument is filled in place and keeps its own encoding\n" ++
  "  def __into(buffer, data)\n" ++
  "    return data if buffer.nil?\n" ++
  "    enc = buffer.encoding\n" ++
  "    buffer.replace(data)\n" ++
  "    buffer.force_encoding(enc)\n" ++
  "  end\n" ++
  "  private :__into\n" ++
  "\n" ++
  "  def readpartial(length, buffer = nil)\n" ++
  "    raise IOError, \"closed stream\" if self.closed?\n" ++
  "    data = self.__f_read(length)\n" ++
  "    raise EOFError, \"end of file reached\" if data.nil?\n" ++
  "    __into(buffer, data)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the line counter ----------------------------------------------------\n" ++
  "  # the READ side's: a stream that cannot be read has none, and the count is\n" ++
  "  # a C int\n" ++
  "  def lineno\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    @__f_lineno ||= 0\n" ++
  "  end\n" ++
  "\n" ++
  "  def lineno=(n)\n" ++
  "    __closed!\n" ++
  "    self.__f_read(0)\n" ++
  "    @__f_lineno = IO.__fd_cint(n)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the flags -----------------------------------------------------------\n" ++
  "  def binmode\n" ++
  "    __closed!\n" ++
  "    @__f_binmode = true\n" ++
  "    # ...which is BINARY both ways: external binary, no internal\n" ++
  "    @__f_ext = Encoding::BINARY\n" ++
  "    @__f_int = nil\n" ++
  "    @__f_int_given = true\n" ++
  "    @__f_encs_set = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def binmode?\n" ++
  "    __closed!\n" ++
  "    @__f_binmode ? true : false\n" ++
  "  end\n" ++
  "\n" ++
  "  # A File is not duplex: closing the side it has is closing it, and\n" ++
  "  # closing one side of a stream that has both is refused (ruby's rule).\n" ++
  "  def close_read\n" ++
  "    return nil if self.closed?\n" ++
  "    raise IOError, \"closing non-duplex IO for reading\" if __opened_writable?\n" ++
  "    self.close\n" ++
  "  end\n" ++
  "\n" ++
  "  def close_write\n" ++
  "    return nil if self.closed?\n" ++
  "    raise IOError, \"closing non-duplex IO for writing\" if __opened_readable?\n" ++
  "    self.close\n" ++
  "  end\n" ++
  "\n" ++
  "  def __opened_readable? = @__f_mode.to_s.start_with?(\"r\") || @__f_mode.to_s.split(\":\", 2)[0].to_s.include?(\"+\")\n" ++
  "  def __opened_writable? = !@__f_mode.to_s.start_with?(\"r\") || @__f_mode.to_s.split(\":\", 2)[0].to_s.include?(\"+\")\n" ++
  "  private :__opened_readable?, :__opened_writable?\n" ++
  "\n" ++
  "  def to_io = self\n" ++
  "  def eof = self.eof?\n" ++
  "\n" ++
  "  # the encodings the line reader reads with (IO#__ln_encs): the mode\n" ++
  "  # string's, until #set_encoding names others. A stream opened for writing\n" ++
  "  # that named none has no external encoding, as in ruby.\n" ++
  "  # (a closed stream still answers both)\n" ++
  "  def external_encoding\n" ++
  "    enc, int = __f_encstate\n" ++
  "    return enc if int\n" ++
  "    m = @__f_mode.to_s\n" ++
  "    m = @__f_lastmode.to_s if m.empty?\n" ++
  "    return enc if !m.start_with?(\"r\") || m.split(\":\", 2)[0].to_s.include?(\"+\")\n" ++
  "    enc || Encoding.default_external\n" ++
  "  end\n" ++
  "  def internal_encoding = __f_encstate[1]\n" ++
  "  # set_encoding(ext [, int] [, **conversion options]), against the default\n" ++
  "  # encodings in force NOW: nil is \"the defaults\", a lone external takes the\n" ++
  "  # default internal, \"-\" as the internal is none; the options (invalid:,\n" ++
  "  # undef:, replace: ...) are kept for the reads that transcode\n" ++
  "  def set_encoding(*args, **opts)\n" ++
  "    __closed!\n" ++
  "    if args.empty? || args.size > 2\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1..2)\"\n" ++
  "    end\n" ++
  "    @__f_dext = Encoding.default_external\n" ++
  "    @__f_dint = Encoding.default_internal\n" ++
  "    if args.size == 2 && !args[1].nil?\n" ++
  "      @__f_ext = IO.__fd_enc(args[0])\n" ++
  "      @__f_int = IO.__fd_enc(args[1])\n" ++
  "      @__f_int_given = true\n" ++
  "    elsif args[0].nil?\n" ++
  "      @__f_ext = nil\n" ++
  "      @__f_int = nil\n" ++
  "      @__f_int_given = false\n" ++
  "    elsif args[0].is_a?(Encoding)\n" ++
  "      @__f_ext = args[0]\n" ++
  "      @__f_int = nil\n" ++
  "      @__f_int_given = false\n" ++
  "    else\n" ++
  "      e1, e2 = IO.__fd_str(args[0]).split(\":\", 2)\n" ++
  "      @__f_ext = IO.__fd_enc(e1)\n" ++
  "      @__f_int = e2 ? IO.__fd_enc(e2) : nil\n" ++
  "      @__f_int_given = !e2.nil?\n" ++
  "    end\n" ++
  "    @__f_ecopts = opts.empty? ? nil : opts\n" ++
  "    @__f_encs_set = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  # `fsync` and `fdatasync` are the buffer flush: there is no descriptor to ask\n" ++
  "  # the kernel about, so what they can honestly promise is that this object has\n" ++
  "  # nothing left unwritten.\n" ++
  "  def fsync\n" ++
  "    __closed!\n" ++
  "    flush\n" ++
  "    0\n" ++
  "  end\n" ++
  "  def fdatasync = fsync\n" ++
  "end\n";

// The IO that is built on a descriptor, and the line reader a File shares
// with it: IO.new / for_fd / open / sysopen / pipe / popen and every stream
// method of what they make, over the one-system-call primitives IO.__fd*
// (io_fd_prim). The dispatcher sends a descriptor stream's `x` to `__fd_x`
// here (fdio_route), so none of it shadows the File model's builtin arm.
let core_prelude_k =
  "class IO\n" ++
  "  # === the IO that is built on a descriptor ================================\n" ++
  "  # IO.new / for_fd / open / sysopen / pipe / popen, and every stream method\n" ++
  "  # of the objects they make, written over the one-system-call primitives\n" ++
  "  # IO.__fd* (see io_fd_prim). The dispatcher sends a descriptor stream's\n" ++
  "  # method `x` here as `__fd_x` (fdio_route), so these never shadow the File\n" ++
  "  # model's builtin arm: a File is a path and a buffer, a descriptor stream is\n" ++
  "  # a descriptor, a read buffer and a write buffer -- the shape ruby's own\n" ++
  "  # rb_io_t has.\n" ++
  "  #\n" ++
  "  # The line reader at the end is shared: a File's gets / each_line /\n" ++
  "  # readlines / readline reach it too, over the File's own read(n).\n" ++
  "\n" ++
  "  # --- conversions --------------------------------------------------------\n" ++
  "  def self.__fd_int(v, what = \"Integer\")\n" ++
  "    return v if v.is_a?(Integer)\n" ++
  "    if v.nil? || !v.respond_to?(:to_int)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + __fd_cname(v) + \" into \" + what\n" ++
  "    end\n" ++
  "    r = v.to_int\n" ++
  "    unless r.is_a?(Integer)\n" ++
  "      raise TypeError, \"can't convert \" + v.class.to_s + \" to Integer (\" + v.class.to_s + \"#to_int gives \" + r.class.to_s + \")\"\n" ++
  "    end\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_str(v)\n" ++
  "    return v if v.is_a?(String)\n" ++
  "    unless v.respond_to?(:to_str)\n" ++
  "      raise TypeError, \"no implicit conversion of \" + __fd_cname(v) + \" into String\"\n" ++
  "    end\n" ++
  "    r = v.to_str\n" ++
  "    raise TypeError, \"can't convert \" + v.class.to_s + \" to String (\" + v.class.to_s + \"#to_str gives \" + r.class.to_s + \")\" unless r.is_a?(String)\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_cname(v)\n" ++
  "    v.nil? ? \"nil\" : v == true ? \"true\" : v == false ? \"false\" : v.class.to_s\n" ++
  "  end\n" ++
  "\n" ++
  "  # a C long: ruby refuses a length or a limit that does not fit one\n" ++
  "  def self.__fd_long(n)\n" ++
  "    if n > 9223372036854775807 || n < -9223372036854775808\n" ++
  "      raise RangeError, \"bignum too big to convert into 'long'\"\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  # a C int, which is what a line number is\n" ++
  "  def self.__fd_cint(n)\n" ++
  "    n = __fd_int(n)\n" ++
  "    raise RangeError, \"integer \" + n.to_s + \" too big to convert to 'int'\" if n > 2147483647\n" ++
  "    raise RangeError, \"integer \" + n.to_s + \" too small to convert to 'int'\" if n < -2147483648\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_path(p)\n" ++
  "    p = p.to_path if !p.is_a?(String) && p.respond_to?(:to_path)\n" ++
  "    __fd_str(p)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_enc(e)\n" ++
  "    return nil if e.nil?\n" ++
  "    return e if e.is_a?(Encoding)\n" ++
  "    s = __fd_str(e)\n" ++
  "    return nil if s == \"-\"\n" ++
  "    s = s[4..] if s.upcase.start_with?(\"BOM|\")\n" ++
  "    begin\n" ++
  "      Encoding.find(s)\n" ++
  "    rescue ArgumentError\n" ++
  "      warn(\"warning: Unsupported encoding: \" + s + \" ignored\")\n" ++
  "      nil\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- modes --------------------------------------------------------------\n" ++
  "  # A mode and its options as ruby's rb_io_extract_modeenc reads them:\n" ++
  "  # [open(2) flags, binmode, textmode, external, internal, internal given].\n" ++
  "  # The mode is a String (\"r+b:utf-8:iso-8859-1\"), an Integer of open(2)\n" ++
  "  # flags, or nil; `mode:` may say it instead, and `flags:` adds to it.\n" ++
  "  def self.__fd_modeenc(mode, opts, default = \"r\")\n" ++
  "    if opts.key?(:mode)\n" ++
  "      raise ArgumentError, \"mode specified twice\" if !mode.nil? && !opts[:mode].nil?\n" ++
  "      mode = opts[:mode] if mode.nil?\n" ++
  "    end\n" ++
  "    ext = nil\n" ++
  "    int = nil\n" ++
  "    int_given = false\n" ++
  "    enc_in_mode = false\n" ++
  "    bin = false\n" ++
  "    text = false\n" ++
  "    if mode.nil?\n" ++
  "      flags = __fd_strflags(default)\n" ++
  "    elsif mode.is_a?(Integer) || (!mode.is_a?(String) && !mode.respond_to?(:to_str) && mode.respond_to?(:to_int))\n" ++
  "      flags = __fd_int(mode)\n" ++
  "    else\n" ++
  "      m = __fd_str(mode)\n" ++
  "      m, encs = m.split(\":\", 2)\n" ++
  "      m = m.to_s\n" ++
  "      flags = __fd_strflags(m, mode)\n" ++
  "      bin = m.include?(\"b\")\n" ++
  "      text = m.include?(\"t\")\n" ++
  "      if encs\n" ++
  "        enc_in_mode = true\n" ++
  "        e1, e2 = encs.split(\":\", 2)\n" ++
  "        ext = __fd_enc(e1)\n" ++
  "        if e2\n" ++
  "          int_given = true\n" ++
  "          int = __fd_enc(e2)\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    flags |= __fd_int(opts[:flags]) if opts.key?(:flags) && !opts[:flags].nil?\n" ++
  "    unless opts[:textmode].nil?\n" ++
  "      raise ArgumentError, \"textmode specified twice\" if text\n" ++
  "      raise ArgumentError, \"both textmode and binmode specified\" if bin\n" ++
  "      text = true if opts[:textmode]\n" ++
  "    end\n" ++
  "    unless opts[:binmode].nil?\n" ++
  "      raise ArgumentError, \"binmode specified twice\" if bin\n" ++
  "      raise ArgumentError, \"both textmode and binmode specified\" if text\n" ++
  "      bin = true if opts[:binmode]\n" ++
  "    end\n" ++
  "    has_ext = opts.key?(:external_encoding)\n" ++
  "    has_int = opts.key?(:internal_encoding)\n" ++
  "    if enc_in_mode && (opts.key?(:encoding) || has_ext || has_int)\n" ++
  "      raise ArgumentError, \"encoding specified twice\"\n" ++
  "    end\n" ++
  "    if has_ext || has_int\n" ++
  "      if opts.key?(:encoding) && !opts[:encoding].nil?\n" ++
  "        e = opts[:encoding]\n" ++
  "        warn(\"warning: Ignoring encoding parameter '\" + (e.is_a?(Encoding) ? e.to_s : __fd_str(e)) + \"': \" +\n" ++
  "             (has_ext ? \"external\" : \"internal\") + \"_encoding is used\")\n" ++
  "      end\n" ++
  "      ext = __fd_enc(opts[:external_encoding]) if has_ext\n" ++
  "      if has_int\n" ++
  "        int_given = true\n" ++
  "        iv = opts[:internal_encoding]\n" ++
  "        int = (iv.is_a?(String) || iv.respond_to?(:to_str)) && __fd_str(iv) == \"-\" ? nil : __fd_enc(iv)\n" ++
  "      end\n" ++
  "    elsif opts.key?(:encoding) && !opts[:encoding].nil?\n" ++
  "      e = opts[:encoding]\n" ++
  "      if e.is_a?(Encoding)\n" ++
  "        ext = e\n" ++
  "      else\n" ++
  "        e1, e2 = __fd_str(e).split(\":\", 2)\n" ++
  "        ext = __fd_enc(e1)\n" ++
  "        if e2\n" ++
  "          int_given = true\n" ++
  "          int = __fd_enc(e2)\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    int = nil if int && ext && int == ext\n" ++
  "    # binmode without an encoding reads BINARY\n" ++
  "    ext = Encoding::BINARY if bin && ext.nil? && !int_given\n" ++
  "    [flags, bin, text, ext, int, int_given]\n" ++
  "  end\n" ++
  "\n" ++
  "  # \"r\" / \"w\" / \"a\", then \"+\", \"b\", \"t\" and (after \"w\") \"x\", in any order\n" ++
  "  def self.__fd_strflags(m, orig = m)\n" ++
  "    bad = -> \{ raise ArgumentError, \"invalid access mode \" + m.to_s }\n" ++
  "    bad.call if m.empty?\n" ++
  "    rest = m[1..]\n" ++
  "    case m[0]\n" ++
  "    when \"r\" then f = RDONLY\n" ++
  "    when \"w\" then f = WRONLY | CREAT | TRUNC\n" ++
  "    when \"a\" then f = WRONLY | CREAT | APPEND\n" ++
  "    else bad.call\n" ++
  "    end\n" ++
  "    seen = +\"\"\n" ++
  "    rest.each_char do |c|\n" ++
  "      bad.call if seen.include?(c)\n" ++
  "      case c\n" ++
  "      when \"+\" then f = (f & ~3) | RDWR\n" ++
  "      when \"b\", \"t\" then bad.call if (c == \"b\" && seen.include?(\"t\")) || (c == \"t\" && seen.include?(\"b\"))\n" ++
  "      when \"x\" then m[0] == \"w\" ? (f |= EXCL) : bad.call\n" ++
  "      else bad.call\n" ++
  "      end\n" ++
  "      seen << c\n" ++
  "    end\n" ++
  "    f\n" ++
  "  end\n" ++
  "\n" ++
  "  # open(2) flags as the fopen mode the runtime's open takes; the flags it\n" ++
  "  # cannot say -- O_CREAT without O_TRUNC, O_EXCL -- are done around it\n" ++
  "  def self.__fd_fopen(flags)\n" ++
  "    acc = flags & 3\n" ++
  "    if (flags & APPEND) != 0\n" ++
  "      acc == RDWR ? \"a+\" : \"a\"\n" ++
  "    elsif (flags & TRUNC) != 0 && acc != RDONLY\n" ++
  "      acc == RDWR ? \"w+\" : \"w\"\n" ++
  "    else\n" ++
  "      acc == RDONLY ? \"r\" : \"r+\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- opening ------------------------------------------------------------\n" ++
  "  def self.__fd_open(path, flags, perm)\n" ++
  "    perm = 0666 if perm.nil?\n" ++
  "    exists = File.exist?(path)\n" ++
  "    raise Errno::EEXIST, path if exists && (flags & EXCL) != 0 && (flags & CREAT) != 0\n" ++
  "    unless exists\n" ++
  "      if (flags & CREAT) == 0 || !File.directory?(File.dirname(path))\n" ++
  "        raise Errno::ENOENT, path\n" ++
  "      end\n" ++
  "    end\n" ++
  "    if File.directory?(path) && (flags & 3) != RDONLY\n" ++
  "      raise Errno::EISDIR, path\n" ++
  "    end\n" ++
  "    fm = __fd_fopen(flags)\n" ++
  "    if !exists && fm.start_with?(\"r\")\n" ++
  "      # O_CREAT without O_TRUNC: make the file, then open it where it is\n" ++
  "      fd = IO.__fdopen(path, \"a\", perm)\n" ++
  "      IO.__fdclose(fd) if fd >= 0\n" ++
  "    end\n" ++
  "    fd = IO.__fdopen(path, fm, perm)\n" ++
  "    raise Errno::EACCES, path if fd < 0\n" ++
  "    fd\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.sysopen(path, mode = nil, perm = nil)\n" ++
  "    path = __fd_path(path)\n" ++
  "    flags = mode.nil? ? RDONLY : (mode.is_a?(Integer) ? mode : __fd_strflags(__fd_str(mode).split(\":\", 2)[0].to_s, mode))\n" ++
  "    perm = perm.nil? ? 0666 : __fd_int(perm)\n" ++
  "    __fd_open(path, flags, perm)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- construction -------------------------------------------------------\n" ++
  "  def initialize(fd, mode = nil, **opts)\n" ++
  "    if block_given?\n" ++
  "      warn(\"warning: \" + self.class.to_s + \"::new() does not take block; use \" + self.class.to_s + \"::open() instead\")\n" ++
  "    end\n" ++
  "    fd = IO.__fd_int(fd)\n" ++
  "    raise Errno::EBADF if fd < 0\n" ++
  "    probe = IO.__fddup(fd)\n" ++
  "    raise Errno::EBADF if probe < 0\n" ++
  "    IO.__fdclose(probe)\n" ++
  "    acc = IO.__fdacc(fd)\n" ++
  "    acc &= 3 if acc >= 0\n" ++
  "    dflt = acc == 1 ? \"w\" : acc == 2 ? \"r+\" : \"r\"\n" ++
  "    flags, bin, text, ext, int, int_given = IO.__fd_modeenc(mode, opts, dflt)\n" ++
  "    want = flags & 3\n" ++
  "    if acc >= 0 && ((acc == 0 && want != RDONLY) || (acc == 1 && want != WRONLY))\n" ++
  "      raise Errno::EINVAL\n" ++
  "    end\n" ++
  "    IO.__fdclass(self.class) unless self.class.equal?(IO)\n" ++
  "    __fd_setup(fd, flags, bin, ext, int, int_given)\n" ++
  "    @__io_ac = opts.key?(:autoclose) ? (opts[:autoclose] ? true : false) : true\n" ++
  "    @__io_path = opts[:path].nil? ? nil : IO.__fd_str(opts[:path]).dup if opts.key?(:path)\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_setup(fd, flags, bin, ext, int, int_given)\n" ++
  "    @__io_fd = fd\n" ++
  "    @__io_wfd = nil\n" ++
  "    acc = flags & 3\n" ++
  "    @__io_r = acc != WRONLY\n" ++
  "    @__io_w = acc != RDONLY\n" ++
  "    @__io_app = (flags & APPEND) != 0\n" ++
  "    @__io_closed = nil\n" ++
  "    @__io_rbuf = +\"\".b\n" ++
  "    @__io_wbuf = +\"\".b\n" ++
  "    @__io_lineno = 0\n" ++
  "    @__io_sync = false\n" ++
  "    @__io_bin = bin ? true : false\n" ++
  "    @__io_pid = nil\n" ++
  "    @__io_ac = true\n" ++
  "    __fd_setencs(ext, int, int_given)\n" ++
  "  end\n" ++
  "\n" ++
  "  # ruby's rb_io_ext_int_to_encs: the external is kept only when it was\n" ++
  "  # named; the internal is the default internal unless one was given, and\n" ++
  "  # none at all when it is the external or the external is BINARY\n" ++
  "  def __fd_setencs(ext, int, int_given)\n" ++
  "    named = !ext.nil?\n" ++
  "    e = ext || Encoding.default_external\n" ++
  "    i = int_given ? int : (e == Encoding::BINARY ? nil : Encoding.default_internal)\n" ++
  "    if i.nil? || i == e\n" ++
  "      @__io_ext = named ? e : nil\n" ++
  "      @__io_int = nil\n" ++
  "    else\n" ++
  "      @__io_ext = e\n" ++
  "      @__io_int = i\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.for_fd(*args, **opts, &blk) = new(*args, **opts, &blk)\n" ++
  "\n" ++
  "  def self.open(*args, **opts)\n" ++
  "    io = new(*args, **opts)\n" ++
  "    return io unless block_given?\n" ++
  "    begin\n" ++
  "      yield io\n" ++
  "    ensure\n" ++
  "      begin\n" ++
  "        io.close unless io.closed?\n" ++
  "      rescue IOError\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # both ends non-blocking, as ruby 3's are (#nonblock? answers true), and\n" ++
  "  # the write end synchronous; SIGPIPE is ignored from the first pipe on, so a\n" ++
  "  # write nobody will read is Errno::EPIPE and not the end of the process\n" ++
  "  def self.pipe(*args, **opts)\n" ++
  "    ext = nil\n" ++
  "    int = nil\n" ++
  "    int_given = false\n" ++
  "    if args.size > 2\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0..2)\"\n" ++
  "    end\n" ++
  "    if args.size >= 1 && !args[0].nil?\n" ++
  "      if args.size == 1 && !args[0].is_a?(Encoding)\n" ++
  "        e1, e2 = __fd_str(args[0]).split(\":\", 2)\n" ++
  "        ext = __fd_enc(e1)\n" ++
  "        if e2\n" ++
  "          int_given = true\n" ++
  "          int = __fd_enc(e2)\n" ++
  "        end\n" ++
  "      else\n" ++
  "        ext = __fd_enc(args[0])\n" ++
  "      end\n" ++
  "    end\n" ++
  "    if args.size == 2\n" ++
  "      int_given = true\n" ++
  "      int = __fd_enc(args[1])\n" ++
  "    end\n" ++
  "    int = nil if int && int == ext\n" ++
  "    pr = IO.__fdpipe\n" ++
  "    raise Errno::EMFILE, \"Too many open files - pipe\" if pr.nil?\n" ++
  "    IO.__fdsigpipe\n" ++
  "    rfd, wfd = pr\n" ++
  "    IO.__fdnonblock(rfd)\n" ++
  "    IO.__fdnonblock(wfd)\n" ++
  "    r = allocate\n" ++
  "    r.send(:initialize, rfd, \"r\")\n" ++
  "    r.__fd_setencs(ext, int, int_given)\n" ++
  "    r.instance_variable_set(:@__io_peer, wfd)\n" ++
  "    w = allocate\n" ++
  "    w.send(:initialize, wfd, \"w\")\n" ++
  "    w.instance_variable_set(:@__io_peer, rfd)\n" ++
  "    w.sync = true\n" ++
  "    pair = [r, w]\n" ++
  "    return pair unless block_given?\n" ++
  "    begin\n" ++
  "      yield r, w\n" ++
  "    ensure\n" ++
  "      pair.each \{ |io| io.close unless io.closed? }\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- state --------------------------------------------------------------\n" ++
  "  def __fd_closed! = (raise IOError, \"closed stream\" if @__io_closed)\n" ++
  "  def __fd_reading!\n" ++
  "    __fd_closed!\n" ++
  "    raise IOError, \"not opened for reading\" unless @__io_r\n" ++
  "  end\n" ++
  "  def __fd_writing!\n" ++
  "    __fd_closed!\n" ++
  "    raise IOError, \"not opened for writing\" unless @__io_w\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_closed? = @__io_closed ? true : false\n" ++
  "  def __fd_fileno = (__fd_closed!; @__io_fd)\n" ++
  "  def __fd_to_i = __fd_fileno\n" ++
  "  def __fd_to_io = self\n" ++
  "  def __fd_autoclose? = (__fd_closed!; @__io_ac)\n" ++
  "  def __fd_autoclose=(v)\n" ++
  "    __fd_closed!\n" ++
  "    @__io_ac = v ? true : false\n" ++
  "  end\n" ++
  "  def __fd_close_on_exec? = (__fd_closed!; IO.__fdcloexec(@__io_fd))\n" ++
  "  def __fd_close_on_exec=(v)\n" ++
  "    __fd_closed!\n" ++
  "    IO.__fdcloexec(@__io_fd, v ? true : false)\n" ++
  "    IO.__fdcloexec(@__io_wfd, v ? true : false) if @__io_wfd\n" ++
  "    v\n" ++
  "  end\n" ++
  "  def __fd_sync = (__fd_closed!; @__io_sync)\n" ++
  "  def __fd_sync=(v)\n" ++
  "    __fd_closed!\n" ++
  "    @__io_sync = v ? true : false\n" ++
  "    __fd_flush_w if @__io_sync\n" ++
  "    v\n" ++
  "  end\n" ++
  "  def __fd_binmode?\n" ++
  "    __fd_closed!\n" ++
  "    @__io_bin\n" ++
  "  end\n" ++
  "  def __fd_binmode\n" ++
  "    __fd_closed!\n" ++
  "    @__io_bin = true\n" ++
  "    @__io_ext = Encoding::BINARY\n" ++
  "    @__io_int = nil\n" ++
  "    self\n" ++
  "  end\n" ++
  "  def __fd_tty? = (__fd_closed!; IO.__fdtty(@__io_fd))\n" ++
  "  def __fd_isatty = __fd_tty?\n" ++
  "  def __fd_pid = (__fd_closed!; @__io_pid)\n" ++
  "  def __fd_path = @__io_path\n" ++
  "  def __fd_to_path = @__io_path\n" ++
  "  def __fd_lineno = (__fd_reading!; @__io_lineno)\n" ++
  "  def __fd_lineno=(n)\n" ++
  "    __fd_reading!\n" ++
  "    @__io_lineno = IO.__fd_cint(n)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_external_encoding\n" ++
  "    return @__io_ext if @__io_int\n" ++
  "    return @__io_ext if @__io_w\n" ++
  "    @__io_ext || Encoding.default_external\n" ++
  "  end\n" ++
  "  def __fd_internal_encoding = @__io_int\n" ++
  "\n" ++
  "  # (universal_newline: makes the read buffer a CHARACTER one -- see\n" ++
  "  # #read_nonblock, which then refuses to hand out its bytes)\n" ++
  "  def __fd_set_encoding(*args, **opts)\n" ++
  "    __fd_closed!\n" ++
  "    @__io_univ = opts[:universal_newline] ? true : nil\n" ++
  "    if args.empty? || args.size > 2\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 1..2)\"\n" ++
  "    end\n" ++
  "    if args.size == 1 && !args[0].nil? && !args[0].is_a?(Encoding)\n" ++
  "      e1, e2 = IO.__fd_str(args[0]).split(\":\", 2)\n" ++
  "      __fd_setencs(IO.__fd_enc(e1), e2 ? IO.__fd_enc(e2) : nil, !e2.nil?)\n" ++
  "    elsif args[0].nil? && (args.size == 1 || args[1].nil?)\n" ++
  "      __fd_setencs(nil, nil, false)\n" ++
  "    else\n" ++
  "      int_given = args.size == 2 && !args[1].nil?\n" ++
  "      __fd_setencs(IO.__fd_enc(args[0]), int_given ? IO.__fd_enc(args[1]) : nil, int_given)\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_inspect\n" ++
  "    nm = @__io_path ? @__io_path.to_s : \"fd \" + @__io_fd.to_s\n" ++
  "    return \"#<\" + self.class.to_s + \":\" + (@__io_path ? @__io_path.to_s + \" \" : \"\") + \"(closed)>\" if @__io_closed\n" ++
  "    \"#<\" + self.class.to_s + \":\" + nm + \">\"\n" ++
  "  end\n" ++
  "  def __fd_to_s = __fd_inspect\n" ++
  "\n" ++
  "  # --- the write side -----------------------------------------------------\n" ++
  "  # a write that the kernel refuses: a pipe with no reader is EPIPE, anything\n" ++
  "  # else here is a descriptor that is no longer one\n" ++
  "  def __fd_wfail\n" ++
  "    raise Errno::EPIPE if @__io_peer || @__io_pid\n" ++
  "    raise Errno::EBADF\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_wfd = @__io_wfd || @__io_fd\n" ++
  "\n" ++
  "  # the write buffer out, as far as the kernel takes it: what it did not\n" ++
  "  # take stays, so a flush that failed fails again at close (ruby's order)\n" ++
  "  def __fd_flush_w\n" ++
  "    return if @__io_wbuf.nil? || @__io_wbuf.empty?\n" ++
  "    fd = __fd_wfd\n" ++
  "    until @__io_wbuf.empty?\n" ++
  "      n = IO.__fdwrite(fd, @__io_wbuf)\n" ++
  "      if n < 0\n" ++
  "        __fd_wfail unless IO.__fdnb(fd)\n" ++
  "        IO.__sel_wait([[fd, 2, self]], -1)\n" ++
  "        n = IO.__fdwrite(fd, @__io_wbuf)\n" ++
  "        __fd_wfail if n < 0\n" ++
  "      end\n" ++
  "      @__io_wbuf = @__io_wbuf.byteslice(n, @__io_wbuf.bytesize - n)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # what #write puts out for one object: its #to_s, converted to the\n" ++
  "  # external encoding when the stream NAMED one (a BINARY one converts\n" ++
  "  # nothing). A string already in it, or ASCII into an ASCII-compatible\n" ++
  "  # one, is written as it is; anything else is transcoded -- a BINARY string\n" ++
  "  # too, which is how a byte no encoding can map is refused.\n" ++
  "  def self.__wstr(o, ext)\n" ++
  "    s = o.is_a?(String) ? o : o.to_s\n" ++
  "    s = IO.__fdanystr(o) unless s.is_a?(String)\n" ++
  "    if ext && ext != Encoding::BINARY && s.encoding != ext && !(s.ascii_only? && ext.ascii_compatible?)\n" ++
  "      s = s.encode(ext)\n" ++
  "    end\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_wstr(o) = IO.__wstr(o, @__io_ext)\n" ++
  "\n" ++
  "  # a synchronous stream writes straight through, so a write the kernel\n" ++
  "  # refuses leaves nothing behind; otherwise the bytes wait in the buffer\n" ++
  "  def __fd_write(*objs)\n" ++
  "    __fd_writing!\n" ++
  "    n = 0\n" ++
  "    objs.each do |o|\n" ++
  "      s = __fd_wstr(o)\n" ++
  "      n += s.bytesize\n" ++
  "      __fd_seek_rbuf\n" ++
  "      @__io_wbuf << s.b\n" ++
  "    end\n" ++
  "    if @__io_sync\n" ++
  "      begin\n" ++
  "        __fd_flush_w\n" ++
  "      ensure\n" ++
  "        @__io_wbuf = +\"\".b\n" ++
  "      end\n" ++
  "    elsif @__io_wbuf.bytesize >= 8192\n" ++
  "      __fd_flush_w\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  # a read-ahead buffer is given back before a write, so the write lands at\n" ++
  "  # the position the program sees\n" ++
  "  def __fd_seek_rbuf\n" ++
  "    return if @__io_rbuf.empty?\n" ++
  "    IO.__fdseek(@__io_fd, -@__io_rbuf.bytesize, 1)\n" ++
  "    @__io_rbuf = +\"\".b\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_append(o)\n" ++
  "    __fd_write(o)\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  # print / puts / printf / putc for every stream this layer and the File\n" ++
  "  # model answer, over the stream's own #write\n" ++
  "  def __io_print(objs)\n" ++
  "    objs = [$_] if objs.empty?\n" ++
  "    objs.each_with_index do |o, i|\n" ++
  "      self.write($,) if i > 0 && !$,.nil?\n" ++
  "      self.write(o.nil? ? \"\" : o)\n" ++
  "    end\n" ++
  "    self.write($\\) unless $\\.nil?\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __io_puts(objs)\n" ++
  "    return (self.write(\"\\n\"); nil) if objs.empty?\n" ++
  "    objs.each \{ |o| __io_puts1(o, []) }\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __io_printf(fmt, args)\n" ++
  "    return nil if fmt.nil?\n" ++
  "    self.write(format(IO.__fd_str(fmt), *args))\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __io_putc(c)\n" ++
  "    s = c.is_a?(String) ? c[0].to_s : (c.is_a?(Integer) || !c.respond_to?(:to_str) ? (IO.__fd_int(c) & 0xff).chr : IO.__fd_str(c)[0].to_s)\n" ++
  "    self.write(s)\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_print(*objs) = __io_print(objs)\n" ++
  "  def __fd_puts(*objs) = __io_puts(objs)\n" ++
  "\n" ++
  "  def __io_puts1(o, seen)\n" ++
  "    if o.is_a?(String)\n" ++
  "      s = o\n" ++
  "    elsif o.nil?\n" ++
  "      s = \"\"\n" ++
  "    else\n" ++
  "      a = o.is_a?(Array) ? o : (o.respond_to?(:to_ary) ? o.to_ary : nil)\n" ++
  "      if a.is_a?(Array)\n" ++
  "        if seen.any? \{ |x| x.equal?(a) }\n" ++
  "          s = \"[...]\"\n" ++
  "        else\n" ++
  "          a.each \{ |x| __io_puts1(x, seen + [a]) }\n" ++
  "          return\n" ++
  "        end\n" ++
  "      else\n" ++
  "        s = o.to_s\n" ++
  "        s = IO.__fdanystr(o) unless s.is_a?(String)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    self.write(s.end_with?(\"\\n\") ? s : s + \"\\n\")\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_printf(fmt = nil, *args) = __io_printf(fmt, args)\n" ++
  "\n" ++
  "  def __fd_putc(c)\n" ++
  "    __fd_writing!\n" ++
  "    __io_putc(c)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_flush\n" ++
  "    __fd_closed!\n" ++
  "    __fd_flush_w\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_fsync\n" ++
  "    __fd_writing!\n" ++
  "    __fd_flush_w\n" ++
  "    IO.__fdsync(__fd_wfd) < 0 ? nil : 0\n" ++
  "  end\n" ++
  "  def __fd_fdatasync = __fd_fsync\n" ++
  "\n" ++
  "  def __fd_syswrite(s)\n" ++
  "    __fd_writing!\n" ++
  "    s = __fd_wstr(s)\n" ++
  "    warn(\"warning: syswrite for buffered IO\") unless @__io_wbuf.empty?\n" ++
  "    __fd_flush_w\n" ++
  "    n = IO.__fdwrite(__fd_wfd, s.b)\n" ++
  "    __fd_wfail if n < 0\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_write_nonblock(s, exception: true)\n" ++
  "    __fd_writing!\n" ++
  "    s = __fd_wstr(s)\n" ++
  "    __fd_flush_w\n" ++
  "    return 0 if s.empty?\n" ++
  "    fd = __fd_wfd\n" ++
  "    IO.__fdnonblock(fd) unless IO.__fdnb(fd)\n" ++
  "    n = IO.__fdwrite(fd, s.b)\n" ++
  "    return n if n >= 0\n" ++
  "    __fd_wfail unless IO.__poll([fd], [2], 0)[0] == 0\n" ++
  "    return :wait_writable unless exception\n" ++
  "    raise IO::EAGAINWaitWritable, \"write would block\"\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- the read side ------------------------------------------------------\n" ++
  "  # one read(2) onto the buffer: false at end of file. A descriptor with\n" ++
  "  # nothing in it yet is WAITED on (the readiness loop lets other threads run,\n" ++
  "  # and names a pipe nothing can ever write to as the deadlock it is).\n" ++
  "  def __fd_fill(want = 65536)\n" ++
  "    fd = @__io_fd\n" ++
  "    loop do\n" ++
  "      # a wait another thread ended by closing the stream\n" ++
  "      raise IOError, \"stream closed in another thread\" if @__io_closed\n" ++
  "      s = IO.__fdread(fd, want)\n" ++
  "      if s.is_a?(String)\n" ++
  "        @__io_rbuf << s\n" ++
  "        return true\n" ++
  "      end\n" ++
  "      return false if s.nil?\n" ++
  "      raise Errno::EISDIR if @__io_path && File.directory?(@__io_path.to_s)\n" ++
  "      raise Errno::EBADF unless IO.__fdnb(fd)\n" ++
  "      IO.__sel_wait([[fd, 1, self]], -1)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # the bytes of the buffer, up to `n`, taken off it\n" ++
  "  def __fd_take(n)\n" ++
  "    s = @__io_rbuf.byteslice(0, n)\n" ++
  "    @__io_rbuf = @__io_rbuf.byteslice(n, @__io_rbuf.bytesize - n) || +\"\".b\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_rd_enc = @__io_ext || (@__io_bin ? Encoding::BINARY : Encoding.default_external)\n" ++
  "\n" ++
  "  # a string read as characters: tagged with the read encoding and, when an\n" ++
  "  # internal one is set, transcoded into it\n" ++
  "  def __fd_chars(s)\n" ++
  "    s.force_encoding(__fd_rd_enc)\n" ++
  "    s = s.encode(@__io_int, __fd_rd_enc) if @__io_int && __fd_rd_enc != Encoding::BINARY\n" ++
  "    s\n" ++
  "  end\n" ++
  "\n" ++
  "  # a buffer argument is filled in place and keeps its own encoding\n" ++
  "  def __fd_into(buf, s)\n" ++
  "    return s if buf.nil?\n" ++
  "    e = buf.encoding\n" ++
  "    buf.replace(s)\n" ++
  "    buf.force_encoding(e)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_buf!(buf)\n" ++
  "    return nil if buf.nil?\n" ++
  "    buf = IO.__fd_str(buf)\n" ++
  "    raise FrozenError, \"can't modify frozen String: \" + buf.inspect if buf.frozen?\n" ++
  "    buf\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_len!(len)\n" ++
  "    len = IO.__fd_long(IO.__fd_int(len))\n" ++
  "    raise ArgumentError, \"negative length \" + len.to_s + \" given\" if len < 0\n" ++
  "    len\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_read(len = nil, buf = nil)\n" ++
  "    __fd_reading!\n" ++
  "    buf = __fd_buf!(buf)\n" ++
  "    __fd_flush_w\n" ++
  "    if len.nil?\n" ++
  "      nil while __fd_fill\n" ++
  "      s = __fd_chars(__fd_take(@__io_rbuf.bytesize))\n" ++
  "      return s if buf.nil?\n" ++
  "      return buf.replace(s)\n" ++
  "    end\n" ++
  "    len = __fd_len!(len)\n" ++
  "    if len == 0\n" ++
  "      return buf ? buf.replace(\"\".b).force_encoding(buf.encoding) : \"\".b\n" ++
  "    end\n" ++
  "    while @__io_rbuf.bytesize < len\n" ++
  "      break unless __fd_fill(len - @__io_rbuf.bytesize)\n" ++
  "    end\n" ++
  "    if @__io_rbuf.empty?\n" ++
  "      buf.clear if buf\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    s = __fd_take(len)\n" ++
  "    return s if buf.nil?\n" ++
  "    buf.replace(s)\n" ++
  "    buf.force_encoding(Encoding::BINARY)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_readpartial(len, buf = nil)\n" ++
  "    __fd_reading!\n" ++
  "    buf = __fd_buf!(buf)\n" ++
  "    len = __fd_len!(len)\n" ++
  "    if len == 0\n" ++
  "      return buf ? buf.replace(\"\") : \"\".b\n" ++
  "    end\n" ++
  "    __fd_flush_w\n" ++
  "    if @__io_rbuf.empty? && !__fd_fill(len)\n" ++
  "      buf.clear if buf\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    __fd_into(buf, __fd_take(len))\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_sysread(len, buf = nil)\n" ++
  "    __fd_reading!\n" ++
  "    buf = __fd_buf!(buf)\n" ++
  "    len = __fd_len!(len)\n" ++
  "    raise IOError, \"sysread for buffered IO\" unless @__io_rbuf.empty?\n" ++
  "    if len == 0\n" ++
  "      return buf ? buf.replace(\"\") : \"\".b\n" ++
  "    end\n" ++
  "    unless __fd_fill(len)\n" ++
  "      buf.clear if buf\n" ++
  "      raise EOFError, \"end of file reached\"\n" ++
  "    end\n" ++
  "    __fd_into(buf, __fd_take(len))\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_read_nonblock(len, buf = nil, exception: true)\n" ++
  "    __fd_reading!\n" ++
  "    buf = __fd_buf!(buf)\n" ++
  "    len = __fd_len!(len)\n" ++
  "    if len == 0\n" ++
  "      return buf ? buf.replace(\"\") : \"\".b\n" ++
  "    end\n" ++
  "    fd = @__io_fd\n" ++
  "    raise IOError, \"byte oriented read for character buffered IO\" if @__io_univ && !@__io_rbuf.empty?\n" ++
  "    IO.__fdnonblock(fd) unless IO.__fdnb(fd)\n" ++
  "    @__nb_off = nil\n" ++
  "    if @__io_rbuf.empty?\n" ++
  "      s = IO.__fdread(fd, len)\n" ++
  "      if s.nil?\n" ++
  "        buf.clear if buf\n" ++
  "        return nil unless exception\n" ++
  "        raise EOFError, \"end of file reached\"\n" ++
  "      elsif !s.is_a?(String)\n" ++
  "        buf.clear if buf\n" ++
  "        return :wait_readable unless exception\n" ++
  "        raise IO::EAGAINWaitReadable, \"read would block\"\n" ++
  "      end\n" ++
  "      @__io_rbuf << s\n" ++
  "    end\n" ++
  "    __fd_into(buf, __fd_take(len))\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_eof?\n" ++
  "    __fd_reading!\n" ++
  "    return false unless @__io_rbuf.empty?\n" ++
  "    !__fd_fill\n" ++
  "  end\n" ++
  "  def __fd_eof = __fd_eof?\n" ++
  "\n" ++
  "  # the byte length of the character that starts `s` at byte `i`, in the\n" ++
  "  # read encoding (1 when the encoding is a single-byte one)\n" ++
  "  def __fd_clen(s, i)\n" ++
  "    e = __fd_rd_enc\n" ++
  "    b = s.getbyte(i)\n" ++
  "    return 1 if b.nil? || b < 0x80\n" ++
  "    if e == Encoding::UTF_8\n" ++
  "      return b >= 0xF0 ? 4 : b >= 0xE0 ? 3 : b >= 0xC0 ? 2 : 1\n" ++
  "    end\n" ++
  "    return 1 if e == Encoding::BINARY || e == Encoding::US_ASCII || !e.ascii_compatible?\n" ++
  "    n = 1\n" ++
  "    while n <= 4 && i + n <= s.bytesize\n" ++
  "      return n if s.byteslice(i, n).force_encoding(e).valid_encoding?\n" ++
  "      n += 1\n" ++
  "    end\n" ++
  "    1\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_getc\n" ++
  "    __fd_reading!\n" ++
  "    __fd_flush_w\n" ++
  "    return nil if @__io_rbuf.empty? && !__fd_fill\n" ++
  "    n = __fd_clen(@__io_rbuf, 0)\n" ++
  "    while @__io_rbuf.bytesize < n\n" ++
  "      break unless __fd_fill\n" ++
  "    end\n" ++
  "    __fd_chars(__fd_take(n))\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_readchar\n" ++
  "    c = __fd_getc\n" ++
  "    raise EOFError, \"end of file reached\" if c.nil?\n" ++
  "    c\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_getbyte\n" ++
  "    __fd_reading!\n" ++
  "    __fd_flush_w\n" ++
  "    return nil if @__io_rbuf.empty? && !__fd_fill\n" ++
  "    __fd_take(1).getbyte(0)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_readbyte\n" ++
  "    b = __fd_getbyte\n" ++
  "    raise EOFError, \"end of file reached\" if b.nil?\n" ++
  "    b\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_ungetbyte(b)\n" ++
  "    __fd_reading!\n" ++
  "    return nil if b.nil?\n" ++
  "    s = b.is_a?(Integer) ? (b & 0xff).chr.b : IO.__fd_str(b).b\n" ++
  "    @__io_rbuf = s + @__io_rbuf\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_ungetc(c)\n" ++
  "    __fd_reading!\n" ++
  "    return nil if c.nil?\n" ++
  "    if c.is_a?(Integer)\n" ++
  "      e = __fd_rd_enc\n" ++
  "      s = e == Encoding::BINARY || c < 0x80 ? (c & 0xff).chr : c.chr(e)\n" ++
  "    else\n" ++
  "      s = IO.__fd_str(c)\n" ++
  "    end\n" ++
  "    @__io_rbuf = s.b + @__io_rbuf\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_each_byte\n" ++
  "    return enum_for(:each_byte) \{ nil } unless block_given?\n" ++
  "    while (b = __fd_getbyte)\n" ++
  "      yield b\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_each_char\n" ++
  "    return enum_for(:each_char) \{ nil } unless block_given?\n" ++
  "    while (c = __fd_getc)\n" ++
  "      yield c\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_each_codepoint\n" ++
  "    return enum_for(:each_codepoint) \{ nil } unless block_given?\n" ++
  "    while (c = __fd_getc)\n" ++
  "      raise ArgumentError, \"invalid byte sequence in \" + c.encoding.to_s unless c.valid_encoding?\n" ++
  "      yield c.ord\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- position -----------------------------------------------------------\n" ++
  "  def __fd_whence(w)\n" ++
  "    return w if w.is_a?(Integer)\n" ++
  "    case w\n" ++
  "    when :SET then 0\n" ++
  "    when :CUR then 1\n" ++
  "    when :END then 2\n" ++
  "    else IO.__fd_int(w)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_lseek(off, whence)\n" ++
  "    r = IO.__fdseek(@__io_fd, off, whence)\n" ++
  "    if r < 0\n" ++
  "      raise Errno::ESPIPE if @__io_peer || @__io_pid\n" ++
  "      raise Errno::EINVAL\n" ++
  "    end\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_pos\n" ++
  "    __fd_closed!\n" ++
  "    __fd_lseek(0, 1) - @__io_rbuf.bytesize + @__io_wbuf.bytesize\n" ++
  "  end\n" ++
  "  def __fd_tell = __fd_pos\n" ++
  "\n" ++
  "  def __fd_seek(off, whence = 0)\n" ++
  "    __fd_closed!\n" ++
  "    off = IO.__fd_long(IO.__fd_int(off))\n" ++
  "    whence = __fd_whence(whence)\n" ++
  "    __fd_flush_w\n" ++
  "    off -= @__io_rbuf.bytesize if whence == 1\n" ++
  "    __fd_lseek(off, whence)\n" ++
  "    @__io_rbuf = +\"\".b\n" ++
  "    0\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_pos=(off)\n" ++
  "    __fd_seek(off, 0)\n" ++
  "    off\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_rewind\n" ++
  "    __fd_seek(0, 0)\n" ++
  "    @__io_lineno = 0\n" ++
  "    0\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_sysseek(off, whence = 0)\n" ++
  "    __fd_closed!\n" ++
  "    off = IO.__fd_long(IO.__fd_int(off))\n" ++
  "    whence = __fd_whence(whence)\n" ++
  "    raise IOError, \"sysseek for buffered IO\" unless @__io_rbuf.empty?\n" ++
  "    warn(\"warning: sysseek for buffered IO\") unless @__io_wbuf.empty?\n" ++
  "    __fd_flush_w\n" ++
  "    __fd_lseek(off, whence)\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- closing ------------------------------------------------------------\n" ++
  "  def __fd_close\n" ++
  "    return nil if @__io_closed\n" ++
  "    err = nil\n" ++
  "    begin\n" ++
  "      __fd_flush_w if @__io_w\n" ++
  "    rescue SystemCallError => e\n" ++
  "      err = e\n" ++
  "    end\n" ++
  "    @__io_closed = true\n" ++
  "    @__io_r = false\n" ++
  "    @__io_w = false\n" ++
  "    if @__io_ac\n" ++
  "      IO.__fdclose(@__io_fd)\n" ++
  "      IO.__fdclose(@__io_wfd) if @__io_wfd\n" ++
  "    end\n" ++
  "    __fd_reap\n" ++
  "    raise err if err\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # the child of a popen'd stream, waited for when the stream is closed\n" ++
  "  def __fd_reap\n" ++
  "    return if @__io_pid.nil?\n" ++
  "    pid = @__io_pid\n" ++
  "    begin\n" ++
  "      Process.wait(pid)\n" ++
  "    rescue Errno::ECHILD\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_close_read\n" ++
  "    return nil if @__io_closed\n" ++
  "    if @__io_wfd\n" ++
  "      IO.__fdclose(@__io_fd) if @__io_r\n" ++
  "      @__io_r = false\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    raise IOError, \"closing non-duplex IO for reading\" if @__io_w\n" ++
  "    __fd_close\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_close_write\n" ++
  "    return nil if @__io_closed\n" ++
  "    if @__io_wfd\n" ++
  "      if @__io_w\n" ++
  "        __fd_flush_w\n" ++
  "        IO.__fdclose(@__io_wfd)\n" ++
  "        @__io_w = false\n" ++
  "      end\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    raise IOError, \"closing non-duplex IO for writing\" if @__io_r\n" ++
  "    __fd_close\n" ++
  "  end\n" ++
  "\n" ++
  "  # the descriptor's own stat, through the /dev/fd name the stat(1) child\n" ++
  "  # inherits it under (File::Stat asks stat(1); see there)\n" ++
  "  def __fd_stat\n" ++
  "    __fd_closed!\n" ++
  "    __fd_flush_w\n" ++
  "    File::Stat.new(\"/dev/fd/\" + @__io_fd.to_s)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_advise(advice, offset = 0, len = 0)\n" ++
  "    __fd_closed!\n" ++
  "    raise TypeError, \"no implicit conversion of \" + IO.__fd_cname(advice) + \" into Symbol\" unless advice.is_a?(Symbol)\n" ++
  "    IO.__fd_int(offset)\n" ++
  "    IO.__fd_int(len)\n" ++
  "    unless %i[normal sequential random willneed dontneed noreuse].include?(advice)\n" ++
  "      raise NotImplementedError, \"Unsupported advice: \" + advice.inspect\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # --- duplication --------------------------------------------------------\n" ++
  "  def __fd_initialize_copy(orig)\n" ++
  "    raise IOError, \"closed stream\" if orig.closed?\n" ++
  "    orig.flush if orig.instance_variable_get(:@__io_w)\n" ++
  "    nfd = IO.__fddup(orig.fileno)\n" ++
  "    raise Errno::EMFILE if nfd < 0\n" ++
  "    orig.instance_variables.each do |n|\n" ++
  "      v = orig.instance_variable_get(n)\n" ++
  "      instance_variable_set(n, v.is_a?(String) ? v.dup : v)\n" ++
  "    end\n" ++
  "    @__io_fd = nfd\n" ++
  "    @__io_wfd = IO.__fddup(orig.instance_variable_get(:@__io_wfd)) if @__io_wfd\n" ++
  "    @__io_pid = nil\n" ++
  "    @__io_ac = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  def __fd_dup\n" ++
  "    o = self.class.allocate\n" ++
  "    o.__fd_initialize_copy(self)\n" ++
  "    o\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_clone(freeze: nil)\n" ++
  "    o = __fd_dup\n" ++
  "    o.freeze if freeze || (freeze.nil? && frozen?)\n" ++
  "    o\n" ++
  "  end\n" ++
  "\n" ++
  "  # === the line reader =====================================================\n" ++
  "  # gets / readline / readlines / each_line / each, and IO.foreach /\n" ++
  "  # IO.readlines, for a descriptor stream AND for a File: one reader over two\n" ++
  "  # byte sources. A descriptor stream keeps its read buffer between calls; a\n" ++
  "  # File is a path and a position, so the bytes a line did not use are given\n" ++
  "  # back to the position before the call returns (the File's own #read and\n" ++
  "  # #pos then agree with what the program has seen).\n" ++
  "  def __ln_file? = @__io_fd.nil?\n" ++
  "\n" ++
  "  def __ln_begin\n" ++
  "    if __ln_file?\n" ++
  "      self.__f_read(0)\n" ++
  "      __f_bom_skip\n" ++
  "      # what #ungetc pushed back is read first; the file's own bytes are\n" ++
  "      # counted, so what is left over can go back where each part came from\n" ++
  "      @__io_rbuf = (@__f_unget || \"\").b\n" ++
  "      @__f_unget = nil\n" ++
  "      @__ln_fbytes = 0\n" ++
  "    else\n" ++
  "      __fd_reading!\n" ++
  "      __fd_flush_w\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ln_end\n" ++
  "    return unless __ln_file?\n" ++
  "    left = @__io_rbuf.bytesize\n" ++
  "    unless left == 0\n" ++
  "      back = left < @__ln_fbytes ? left : @__ln_fbytes\n" ++
  "      self.pos = self.pos - back if back > 0\n" ++
  "      @__f_unget = @__io_rbuf.byteslice(0, left - back) if left > back\n" ++
  "      # a line reader read ahead: ruby's buffer would hold these (see sysread)\n" ++
  "      @__f_ahead = true\n" ++
  "    end\n" ++
  "    @__io_rbuf = nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ln_fill\n" ++
  "    return __fd_fill unless __ln_file?\n" ++
  "    s = self.__f_read(8192)\n" ++
  "    return false if s.nil? || s.empty?\n" ++
  "    @__io_rbuf << s.b\n" ++
  "    @__ln_fbytes += s.bytesize\n" ++
  "    true\n" ++
  "  end\n" ++
  "\n" ++
  "  # [read encoding, internal encoding] -- a File's come from its mode string\n" ++
  "  # and #set_encoding; a descriptor stream's were settled when it was opened\n" ++
  "  def __ln_encs\n" ++
  "    return [__fd_rd_enc, @__io_int] unless __ln_file?\n" ++
  "    enc, int = __f_encstate\n" ++
  "    [enc || Encoding.default_external, int]\n" ++
  "  end\n" ++
  "\n" ++
  "  # A File's encodings, as rb_io_ext_int_to_encs settles them: [the external\n" ++
  "  # it holds (nil: the default external, whatever that is when asked), the\n" ++
  "  # internal (nil: none)]. What the stream NAMED -- its mode string, #binmode,\n" ++
  "  # #set_encoding, the keyword options -- comes first; the defaults are the\n" ++
  "  # ones it was opened under (@__f_dext / @__f_dint, recorded at the open).\n" ++
  "  def __f_encstate\n" ++
  "    if @__f_encs_set\n" ++
  "      named = @__f_ext\n" ++
  "      int = @__f_int\n" ++
  "      int_given = @__f_int_given\n" ++
  "    else\n" ++
  "      m = @__f_mode.to_s\n" ++
  "      m = @__f_lastmode.to_s if m.empty?\n" ++
  "      acc, encs = m.split(\":\", 2)\n" ++
  "      named = nil\n" ++
  "      int = nil\n" ++
  "      int_given = false\n" ++
  "      if encs\n" ++
  "        e1, e2 = encs.split(\":\", 2)\n" ++
  "        named = IO.__fd_enc(e1)\n" ++
  "        if e2\n" ++
  "          int = IO.__fd_enc(e2)\n" ++
  "          int_given = true\n" ++
  "        end\n" ++
  "      end\n" ++
  "      named = Encoding::BINARY if named.nil? && !int_given && (acc.to_s.include?(\"b\") || @__f_binmode)\n" ++
  "    end\n" ++
  "    dext = instance_variable_defined?(:@__f_dext) ? @__f_dext : Encoding.default_external\n" ++
  "    dint = instance_variable_defined?(:@__f_dint) ? @__f_dint : Encoding.default_internal\n" ++
  "    e = named || dext\n" ++
  "    i = e == Encoding::BINARY ? nil : (int_given ? int : dint)\n" ++
  "    return [e, i] unless i.nil? || i == e\n" ++
  "    [named || (i.nil? ? nil : e), nil]\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ln_str(b)\n" ++
  "    ext, int = __ln_encs\n" ++
  "    b.force_encoding(ext)\n" ++
  "    b = b.encode(int, ext, **(@__f_ecopts || \{})) if int\n" ++
  "    b\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ln_count\n" ++
  "    if __ln_file?\n" ++
  "      @__f_lineno = (@__f_lineno || 0) + 1\n" ++
  "      $. = @__f_lineno\n" ++
  "    else\n" ++
  "      @__io_lineno += 1\n" ++
  "      $. = @__io_lineno\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # (sep, limit) from gets' positional arguments, as ruby's\n" ++
  "  # prepare_getline_args reads them: one argument is a separator if it is (or\n" ++
  "  # converts to) a String and a limit otherwise; two are both. A negative\n" ++
  "  # limit is no limit.\n" ++
  "  def self.__ln_args(args)\n" ++
  "    case args.size\n" ++
  "    when 0\n" ++
  "      sep = $/\n" ++
  "      limit = nil\n" ++
  "    when 1\n" ++
  "      a = args[0]\n" ++
  "      if a.nil?\n" ++
  "        sep = nil\n" ++
  "        limit = nil\n" ++
  "      elsif a.is_a?(String) || (!a.is_a?(Integer) && a.respond_to?(:to_str))\n" ++
  "        sep = __fd_str(a)\n" ++
  "        limit = nil\n" ++
  "      else\n" ++
  "        sep = $/\n" ++
  "        limit = __fd_long(__fd_int(a))\n" ++
  "      end\n" ++
  "    when 2\n" ++
  "      sep = args[0].nil? ? nil : __fd_str(args[0])\n" ++
  "      limit = args[1].nil? ? nil : __fd_long(__fd_int(args[1]))\n" ++
  "    else\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + args.size.to_s + \", expected 0..2)\"\n" ++
  "    end\n" ++
  "    limit = nil if limit && limit < 0\n" ++
  "    [sep, limit]\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ln_skip_nl\n" ++
  "    loop do\n" ++
  "      break if @__io_rbuf.empty? && !__ln_fill\n" ++
  "      i = 0\n" ++
  "      n = @__io_rbuf.bytesize\n" ++
  "      i += 1 while i < n && @__io_rbuf.getbyte(i) == 10\n" ++
  "      @__io_rbuf = @__io_rbuf.byteslice(i, n - i)\n" ++
  "      break unless @__io_rbuf.empty?\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # a limit never splits a character: the bytes after it are taken until the\n" ++
  "  # last character is whole, at most 16 of them (ruby's own bound)\n" ++
  "  def __ln_char_end(e, enc)\n" ++
  "    return e unless enc == Encoding::UTF_8\n" ++
  "    extra = 0\n" ++
  "    while extra < 16\n" ++
  "      j = e - 1\n" ++
  "      k = 0\n" ++
  "      while j > 0 && k < 3 && (@__io_rbuf.getbyte(j) & 0xC0) == 0x80\n" ++
  "        j -= 1\n" ++
  "        k += 1\n" ++
  "      end\n" ++
  "      break if @__io_rbuf.byteslice(j, e - j).force_encoding(enc).valid_encoding?\n" ++
  "      break if e >= @__io_rbuf.bytesize && !__ln_fill\n" ++
  "      break if e >= @__io_rbuf.bytesize\n" ++
  "      e += 1\n" ++
  "      extra += 1\n" ++
  "    end\n" ++
  "    e\n" ++
  "  end\n" ++
  "\n" ++
  "  # one line, as bytes, or nil at the end\n" ++
  "  def __ln_get(sep, limit, chomp)\n" ++
  "    ext, = __ln_encs\n" ++
  "    para = false\n" ++
  "    if sep == \"\"\n" ++
  "      para = true\n" ++
  "      sep = \"\\n\\n\"\n" ++
  "      __ln_skip_nl\n" ++
  "    end\n" ++
  "    unless sep.nil? || sep.encoding == ext || sep.ascii_only? || ext == Encoding::BINARY || sep.encoding == Encoding::BINARY\n" ++
  "      sep = sep.encode(ext) rescue sep\n" ++
  "    end\n" ++
  "    sepb = sep.nil? ? nil : sep.b\n" ++
  "    e = nil\n" ++
  "    scan = 0\n" ++
  "    loop do\n" ++
  "      if sepb\n" ++
  "        i = @__io_rbuf.byteindex(sepb, scan)\n" ++
  "        if i\n" ++
  "          e = i + sepb.bytesize\n" ++
  "          break\n" ++
  "        end\n" ++
  "        scan = @__io_rbuf.bytesize - sepb.bytesize + 1\n" ++
  "        scan = 0 if scan < 0\n" ++
  "      end\n" ++
  "      break if limit && @__io_rbuf.bytesize >= limit\n" ++
  "      break unless __ln_fill\n" ++
  "    end\n" ++
  "    total = @__io_rbuf.bytesize\n" ++
  "    return nil if total == 0\n" ++
  "    hit = !e.nil?\n" ++
  "    e ||= total\n" ++
  "    # a line the LIMIT ended is not counted by #lineno -- one a separator or\n" ++
  "    # the end of the input ended, shorter than the limit, is (ruby's rule,\n" ++
  "    # measured: gets(nil, n) of an n-byte file counts nothing)\n" ++
  "    @__ln_counts = hit ? (limit.nil? || e <= limit) : (limit.nil? || e < limit)\n" ++
  "    if limit && e > limit\n" ++
  "      e = __ln_char_end(limit, ext)\n" ++
  "      hit = false\n" ++
  "    end\n" ++
  "    line = __fd_take(e)\n" ++
  "    __ln_skip_nl if para && hit\n" ++
  "    if chomp && sepb && line.end_with?(sepb)\n" ++
  "      line = line.byteslice(0, line.bytesize - sepb.bytesize)\n" ++
  "      line = line.byteslice(0, line.bytesize - 1) if sep == \"\\n\" && line.end_with?(\"\\r\")\n" ++
  "    end\n" ++
  "    line\n" ++
  "  end\n" ++
  "\n" ++
  "  def __ln_line(sep, limit, chomp)\n" ++
  "    __ln_begin\n" ++
  "    begin\n" ++
  "      if limit == 0\n" ++
  "        ext, = __ln_encs\n" ++
  "        return (+\"\").force_encoding(ext)\n" ++
  "      end\n" ++
  "      b = __ln_get(sep, limit, chomp)\n" ++
  "      return nil if b.nil?\n" ++
  "      __ln_count if @__ln_counts\n" ++
  "      __ln_str(b)\n" ++
  "    ensure\n" ++
  "      __ln_end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_gets(*args, chomp: false)\n" ++
  "    sep, limit = IO.__ln_args(args)\n" ++
  "    $_ = __ln_line(sep, limit, chomp)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_readline(*args, chomp: false)\n" ++
  "    sep, limit = IO.__ln_args(args)\n" ++
  "    l = __ln_line(sep, limit, chomp)\n" ++
  "    raise EOFError, \"end of file reached\" if l.nil?\n" ++
  "    $_ = l\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_readlines(*args, chomp: false, **_opts)\n" ++
  "    sep, limit = IO.__ln_args(args)\n" ++
  "    raise ArgumentError, \"invalid limit: 0 for readlines\" if limit == 0\n" ++
  "    out = []\n" ++
  "    while (l = __ln_line(sep, limit, chomp))\n" ++
  "      out << l\n" ++
  "    end\n" ++
  "    out\n" ++
  "  end\n" ++
  "  def __fd_to_a(*args, chomp: false) = __fd_readlines(*args, chomp: chomp)\n" ++
  "\n" ++
  "  def __fd_each_line(*args, chomp: false, &blk)\n" ++
  "    unless blk\n" ++
  "      return chomp ? enum_for(:each_line, *args, chomp: true) \{ nil } : enum_for(:each_line, *args) \{ nil }\n" ++
  "    end\n" ++
  "    sep, limit = IO.__ln_args(args)\n" ++
  "    raise ArgumentError, \"invalid limit: 0 for each_line\" if limit == 0\n" ++
  "    while (l = __ln_line(sep, limit, chomp))\n" ++
  "      yield l\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_each(*args, chomp: false, &blk)\n" ++
  "    unless blk\n" ++
  "      return chomp ? enum_for(:each, *args, chomp: true) \{ nil } : enum_for(:each, *args) \{ nil }\n" ++
  "    end\n" ++
  "    __fd_each_line(*args, chomp: chomp, &blk)\n" ++
  "  end\n" ++
  "\n" ++
  "  # a path and the options IO.foreach / IO.readlines open it with\n" ++
  "  def self.__ln_open(name, opts)\n" ++
  "    raise TypeError, \"no implicit conversion of nil into String\" if name.nil?\n" ++
  "    name = __fd_path(name)\n" ++
  "    mode = opts[:mode] || \"r\"\n" ++
  "    mode = __fd_str(mode) unless mode.is_a?(Integer)\n" ++
  "    perm = opts[:perm]\n" ++
  "    f = perm.nil? ? File.open(name, mode) : File.open(name, mode, __fd_int(perm))\n" ++
  "    encs = [opts[:external_encoding], opts[:internal_encoding]]\n" ++
  "    if opts[:encoding] && encs.compact.empty?\n" ++
  "      f.set_encoding(opts[:encoding])\n" ++
  "    elsif !encs.compact.empty?\n" ++
  "      f.set_encoding(*encs)\n" ++
  "    end\n" ++
  "    f.binmode if opts[:binmode] && f.external_encoding.nil?\n" ++
  "    f.instance_variable_set(:@__f_binmode, true) if opts[:binmode]\n" ++
  "    f\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.foreach(name, *args, chomp: false, **opts, &blk)\n" ++
  "    unless blk\n" ++
  "      return enum_for(:foreach, name, *args, chomp: chomp, **opts) \{ nil }\n" ++
  "    end\n" ++
  "    sep, limit = __ln_args(args)\n" ++
  "    raise ArgumentError, \"invalid limit: 0 for foreach\" if limit == 0\n" ++
  "    f = __ln_open(name, opts)\n" ++
  "    begin\n" ++
  "      while (l = f.__ln_line(sep, limit, chomp))\n" ++
  "        $_ = l\n" ++
  "        yield l\n" ++
  "      end\n" ++
  "      $_ = nil\n" ++
  "    ensure\n" ++
  "      f.close\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.readlines(name, *args, chomp: false, **opts)\n" ++
  "    sep, limit = __ln_args(args)\n" ++
  "    raise ArgumentError, \"invalid limit: 0 for readlines\" if limit == 0\n" ++
  "    f = __ln_open(name, opts)\n" ++
  "    begin\n" ++
  "      out = []\n" ++
  "      while (l = f.__ln_line(sep, limit, chomp))\n" ++
  "        out << l\n" ++
  "      end\n" ++
  "      out\n" ++
  "    ensure\n" ++
  "      f.close\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  # === IO.popen ==============================================================\n" ++
  "  # A child started by Process.spawn (the one way this interpreter starts a\n" ++
  "  # process) with its standard input and/or output on a pipe, and the stream\n" ++
  "  # over the other end of it: the pid is the child's own, #close waits for it\n" ++
  "  # and sets $?. The pipes are blocking -- the child reads and writes them\n" ++
  "  # knowing nothing of this process -- and every other descriptor this\n" ++
  "  # process holds is closed for the child (see Process.spawn).\n" ++
  "  POPEN_IO_KEYS = %i[mode flags external_encoding internal_encoding encoding textmode binmode autoclose path].freeze\n" ++
  "\n" ++
  "  def self.popen(*args, **opts, &blk)\n" ++
  "    env = nil\n" ++
  "    if !args.empty? && (args[0].is_a?(Hash) || (!args[0].is_a?(String) && !args[0].is_a?(Array) && args[0].respond_to?(:to_hash)))\n" ++
  "      env = args.shift\n" ++
  "      env = env.to_hash unless env.is_a?(Hash)\n" ++
  "    end\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1+)\" if args.empty?\n" ++
  "    if args.size > 2\n" ++
  "      raise ArgumentError, \"wrong number of arguments (given \" + (args.size + (env ? 1 : 0)).to_s + \", expected 1..3)\"\n" ++
  "    end\n" ++
  "    cmd, mode = args\n" ++
  "    copts = \{}\n" ++
  "    if cmd.is_a?(Array) || (!cmd.is_a?(String) && cmd.respond_to?(:to_ary))\n" ++
  "      words = (cmd.is_a?(Array) ? cmd : cmd.to_ary).dup\n" ++
  "      if !words.empty? && words[0].is_a?(Hash)\n" ++
  "        e2 = words.shift\n" ++
  "        env = env ? env.merge(e2) : e2\n" ++
  "      end\n" ++
  "      copts = words.pop if !words.empty? && words[-1].is_a?(Hash)\n" ++
  "      raise ArgumentError, \"wrong number of arguments\" if words.empty?\n" ++
  "    else\n" ++
  "      s = __fd_str(cmd)\n" ++
  "      if s == \"-\"\n" ++
  "        raise NotImplementedError, \"fork() function is unimplemented on this machine\"\n" ++
  "      end\n" ++
  "      words = [s]\n" ++
  "    end\n" ++
  "    io_opts = \{}\n" ++
  "    sp_opts = \{}\n" ++
  "    opts.merge(copts).each do |k, v|\n" ++
  "      (POPEN_IO_KEYS.include?(k) ? io_opts : sp_opts)[k] = v\n" ++
  "    end\n" ++
  "    flags, bin, _text, ext, int, int_given = __fd_modeenc(mode, io_opts)\n" ++
  "    acc = flags & 3\n" ++
  "    rd = acc != WRONLY\n" ++
  "    wr = acc != RDONLY\n" ++
  "    pr = rd ? IO.__fdpipe : nil\n" ++
  "    pw = wr ? IO.__fdpipe : nil\n" ++
  "    sp_opts[:out] = pr[1] if rd\n" ++
  "    sp_opts[:in] = pw[0] if wr\n" ++
  "    begin\n" ++
  "      pid = env ? Process.spawn(env, *words, **sp_opts) : Process.spawn(*words, **sp_opts)\n" ++
  "    rescue Exception\n" ++
  "      (pr.to_a + pw.to_a).each \{ |fd| IO.__fdclose(fd) }\n" ++
  "      raise\n" ++
  "    end\n" ++
  "    IO.__fdclose(pr[1]) if rd\n" ++
  "    IO.__fdclose(pw[0]) if wr\n" ++
  "    io = allocate\n" ++
  "    io.send(:initialize, rd ? pr[0] : pw[1], rd ? \"r\" : \"w\")\n" ++
  "    if rd && wr\n" ++
  "      io.instance_variable_set(:@__io_wfd, pw[1])\n" ++
  "      io.instance_variable_set(:@__io_w, true)\n" ++
  "    end\n" ++
  "    io.__fd_setencs(ext, int, int_given)\n" ++
  "    io.instance_variable_set(:@__io_bin, true) if bin\n" ++
  "    io.instance_variable_set(:@__io_pid, pid)\n" ++
  "    io.instance_variable_set(:@__io_sync, true)\n" ++
  "    return io unless blk\n" ++
  "    begin\n" ++
  "      yield io\n" ++
  "    ensure\n" ++
  "      io.close unless io.closed?\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # === fcntl, over what this process knows of its descriptors ================\n" ++
  "  # The kernel's fcntl(2) is variadic and no extern can declare it. What a\n" ++
  "  # program asks of it here is answered from the same bookkeeping IO.new and\n" ++
  "  # Process.spawn use: the access mode and O_NONBLOCK a descriptor was given\n" ++
  "  # (F_GETFL / F_SETFL), and its close-on-exec flag (F_GETFD / F_SETFD), which\n" ++
  "  # is honoured where this interpreter starts a child.\n" ++
  "  def __fd_fcntl(cmd, arg = 0)\n" ++
  "    __fd_closed!\n" ++
  "    IO.__fd_fcntl(@__io_fd, cmd, arg)\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.__fd_fcntl(fd, cmd, arg)\n" ++
  "    cmd = __fd_int(cmd)\n" ++
  "    arg = arg == true ? 1 : arg == false || arg.nil? ? 0 : __fd_int(arg)\n" ++
  "    case cmd\n" ++
  "    when 1 then IO.__fdcloexec(fd) ? 1 : 0\n" ++
  "    when 2 then IO.__fdcloexec(fd, (arg & 1) != 0); 0\n" ++
  "    when 3\n" ++
  "      a = IO.__fdacc(fd)\n" ++
  "      (a < 0 ? 2 : a & 3) | (a >= 0 && (a & 16) != 0 ? File::APPEND : 0) | (IO.__fdnb(fd) ? File::NONBLOCK : 0)\n" ++
  "    when 4\n" ++
  "      IO.__fdnonblock(fd) if (arg & File::NONBLOCK) != 0\n" ++
  "      0\n" ++
  "    else\n" ++
  "      raise NotImplementedError, \"fcntl(\" + cmd.to_s + \") is not answered here: only F_GETFD, F_SETFD, F_GETFL and F_SETFL are\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  # === the flags every stream has ============================================\n" ++
  "  # A descriptor stream answers these through the layer (__fd_*, routed); a\n" ++
  "  # File and the three standard streams reach them here, over #fileno.\n" ++
  "  def __any_closed! = (raise IOError, \"closed stream\" if self.closed?)\n" ++
  "\n" ++
  "  def autoclose?\n" ++
  "    __any_closed!\n" ++
  "    !@__f_keep_fd\n" ++
  "  end\n" ++
  "\n" ++
  "  def autoclose=(v)\n" ++
  "    __any_closed!\n" ++
  "    @__f_keep_fd = v ? nil : true\n" ++
  "    v\n" ++
  "  end\n" ++
  "\n" ++
  "  # 0, 1 and 2 are inherited by every child, which is what ruby answers too\n" ++
  "  def close_on_exec?\n" ++
  "    __any_closed!\n" ++
  "    fd = self.fileno\n" ++
  "    fd > 2 && IO.__fdcloexec(fd)\n" ++
  "  end\n" ++
  "\n" ++
  "  def close_on_exec=(v)\n" ++
  "    __any_closed!\n" ++
  "    fd = self.fileno\n" ++
  "    IO.__fdcloexec(fd, v ? true : false) if fd > 2\n" ++
  "    v\n" ++
  "  end\n" ++
  "\n" ++
  "  def fcntl(cmd, arg = 0)\n" ++
  "    __any_closed!\n" ++
  "    IO.__fd_fcntl(self.fileno, cmd, arg)\n" ++
  "  end\n" ++
  "\n" ++
  "  def pid\n" ++
  "    __any_closed!\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # a standard stream's stat is its descriptor's -- through a copy above 2,\n" ++
  "  # since the stat(1) child's own 0, 1 and 2 are not this process's\n" ++
  "  def stat\n" ++
  "    __any_closed!\n" ++
  "    fd = IO.__fddup(self.fileno)\n" ++
  "    raise Errno::EBADF if fd < 0\n" ++
  "    begin\n" ++
  "      File::Stat.new(\"/dev/fd/\" + fd.to_s)\n" ++
  "    ensure\n" ++
  "      IO.__fdclose(fd)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def advise(advice, offset = 0, len = 0)\n" ++
  "    __any_closed!\n" ++
  "    raise TypeError, \"no implicit conversion of \" + IO.__fd_cname(advice) + \" into Symbol\" unless advice.is_a?(Symbol)\n" ++
  "    IO.__fd_long(IO.__fd_int(offset))\n" ++
  "    IO.__fd_long(IO.__fd_int(len))\n" ++
  "    unless %i[normal sequential random willneed dontneed noreuse].include?(advice)\n" ++
  "      raise NotImplementedError, \"Unsupported advice: \" + advice.inspect\n" ++
  "    end\n" ++
  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # the offset after the move; a File has no read-ahead to refuse over\n" ++
  "  def sysseek(off, whence = 0)\n" ++
  "    __any_closed!\n" ++
  "    raise IOError, \"sysseek for buffered IO\" if @__f_ahead || (@__f_unget && !@__f_unget.empty?)\n" ++
  "    off = IO.__fd_long(IO.__fd_int(off))\n" ++
  "    whence = \{ SET: 0, CUR: 1, END: 2 }[whence] || whence if whence.is_a?(Symbol)\n" ++
  "    self.seek(off, whence)\n" ++
  "    self.pos\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  # IO.read(name, length = nil, offset = nil, **opts): the file opened with the\n" ++
  "  # options (or with :open_args, which replace them), read from the offset\n" ++
  "  def self.read(name, length = nil, offset = nil, **opts)\n" ++
  "    raise TypeError, \"no implicit conversion of nil into String\" if name.nil?\n" ++
  "    length = length.nil? ? nil : __fd_long(__fd_int(length))\n" ++
  "    raise ArgumentError, \"negative length \" + length.to_s + \" given\" if length && length < 0\n" ++
  "    offset = offset.nil? ? nil : __fd_long(__fd_int(offset))\n" ++
  "    raise ArgumentError, \"negative offset \" + offset.to_s + \" given\" if offset && offset < 0\n" ++
  "    if opts.key?(:open_args)\n" ++
  "      oa = Array(opts[:open_args]).dup\n" ++
  "      o2 = oa.last.is_a?(Hash) ? oa.pop : \{}\n" ++
  "      o2 = o2.merge(mode: oa[0]) unless oa.empty? || oa[0].nil?\n" ++
  "      f = __ln_open(name, o2)\n" ++
  "    else\n" ++
  "      f = __ln_open(name, opts)\n" ++
  "    end\n" ++
  "    begin\n" ++
  "      f.seek(offset) if offset\n" ++
  "      f.read(length)\n" ++
  "    ensure\n" ++
  "      f.close\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class File\n" ++
  "  # File.new / File.open with keyword options (the builtin hands them here):\n" ++
  "  # the mode and the options as IO.new reads them, then the File opened with\n" ++
  "  # the plain mode and given the encodings and flags the options named\n" ++
  "  def self.__open_kw(path, mode = nil, perm = nil, **opts, &blk)\n" ++
  "    flags, bin, text, ext, int, int_given = IO.__fd_modeenc(mode, opts)\n" ++
  "    f = File.new(path, flags, *[perm].compact)\n" ++
  "    f.__f_setencs(ext, int, int_given, bin, text)\n" ++
  "    # newline: (or the older crlf_newline: / cr_newline:) -- what \"\\n\" is\n" ++
  "    # written as\n" ++
  "    nl = opts[:newline]\n" ++
  "    nl = :crlf if opts[:crlf_newline]\n" ++
  "    nl = :cr if opts[:cr_newline]\n" ++
  "    f.instance_variable_set(:@__f_nl, nl) if nl == :crlf || nl == :cr\n" ++
  "    m = opts.key?(:mode) && !opts[:mode].nil? ? opts[:mode] : mode\n" ++
  "    if m.is_a?(String) && m.split(\":\", 2)[1].to_s.upcase.start_with?(\"BOM|\")\n" ++
  "      f.instance_variable_set(:@__f_bom_mode, true)\n" ++
  "    end\n" ++
  "    return f unless blk\n" ++
  "    begin\n" ++
  "      yield f\n" ++
  "    ensure\n" ++
  "      f.close unless f.closed?\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # \"BOM|enc\" in the mode: a BOM at the start of the file names the external\n" ++
  "  # encoding instead, and is read past -- once, before the first read\n" ++
  "  def __f_bom_skip\n" ++
  "    return unless @__f_bom.nil?\n" ++
  "    @__f_bom = false\n" ++
  "    _, encs = @__f_mode.to_s.split(\":\", 2)\n" ++
  "    return unless @__f_bom_mode || (encs && encs.upcase.start_with?(\"BOM|\"))\n" ++
  "    return unless self.pos == 0\n" ++
  "    head = (self.__f_read(4) || \"\").b\n" ++
  "    enc, n = if head.start_with?(\"\\xEF\\xBB\\xBF\".b) then [Encoding::UTF_8, 3]\n" ++
  "             elsif head.start_with?(\"\\xFE\\xFF\".b) then [Encoding::UTF_16BE, 2]\n" ++
  "             elsif head.start_with?(\"\\xFF\\xFE\\x00\\x00\".b) then [Encoding::UTF_32LE, 4]\n" ++
  "             elsif head.start_with?(\"\\xFF\\xFE\".b) then [Encoding::UTF_16LE, 2]\n" ++
  "             elsif head.start_with?(\"\\x00\\x00\\xFE\\xFF\".b) then [Encoding::UTF_32BE, 4]\n" ++
  "             else [nil, 0]\n" ++
  "             end\n" ++
  "    back = head.bytesize - n\n" ++
  "    self.pos = self.pos - back if back > 0\n" ++
  "    return if enc.nil?\n" ++
  "    _, int = __ln_encs\n" ++
  "    __f_setencs(enc, int, !int.nil?, false, false)\n" ++
  "  end\n" ++
  "\n" ++
  "  def __f_setencs(ext, int, int_given, bin, text)\n" ++
  "    @__f_dint = Encoding.default_internal\n" ++
  "    @__f_binmode = true if bin\n" ++
  "    @__f_ext = ext\n" ++
  "    @__f_int = int\n" ++
  "    @__f_int_given = int_given\n" ++
  "    @__f_encs_set = true\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  # the external encoding a write converts into: only one the stream named\n" ++
  "  def __f_wext = __f_encstate[0]\n" ++
  "\n" ++
  "  def write(*objs)\n" ++
  "    __closed!\n" ++
  "    @__f_ahead = nil\n" ++
  "    n = 0\n" ++
  "    ext = __f_wext\n" ++
  "    objs.each do |o|\n" ++
  "      s = IO.__wstr(o, ext)\n" ++
  "      next if s.empty?\n" ++
  "      s = s.gsub(\"\\n\", @__f_nl == :crlf ? \"\\r\\n\" : \"\\r\") if @__f_nl\n" ++
  "      n += self.__f_write(s)\n" ++
  "    end\n" ++
  "    n\n" ++
  "  end\n" ++
  "\n" ++
  "  def <<(o)\n" ++
  "    self.write(o)\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def print(*objs) = __io_print(objs)\n" ++
  "  def puts(*objs) = __io_puts(objs)\n" ++
  "  def printf(fmt = nil, *args) = __io_printf(fmt, args)\n" ++
  "  def putc(c)\n" ++
  "    __closed!\n" ++
  "    __io_putc(c)\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  # IO.write / IO.binwrite(name, string, offset = nil, **opts): created when\n" ++
  "  # missing, truncated unless an offset says where to write; :open_args\n" ++
  "  # replace every other option, and name no mode unless they say one\n" ++
  "  def self.write(name, string, offset = nil, **opts) = __write_file(name, string, offset, opts, false)\n" ++
  "  def self.binwrite(name, string, offset = nil, **opts) = __write_file(name, string, offset, opts, true)\n" ++
  "\n" ++
  "  def self.__write_file(name, string, offset, opts, bin)\n" ++
  "    raise TypeError, \"no implicit conversion of nil into String\" if name.nil?\n" ++
  "    offset = offset.nil? ? nil : __fd_long(__fd_int(offset))\n" ++
  "    raise ArgumentError, \"negative offset \" + offset.to_s + \" given\" if offset && offset < 0\n" ++
  "    if opts.key?(:open_args)\n" ++
  "      oa = Array(opts[:open_args]).dup\n" ++
  "      o2 = oa.last.is_a?(Hash) ? oa.pop.dup : \{}\n" ++
  "      o2[:mode] = oa[0] unless oa[0].nil?\n" ++
  "      o2[:perm] = oa[1] unless oa[1].nil?\n" ++
  "    else\n" ++
  "      o2 = opts.dup\n" ++
  "      if o2[:mode].nil?\n" ++
  "        path = __fd_path(name)\n" ++
  "        o2[:mode] = offset.nil? || !File.exist?(path) ? \"w\" : \"r+\"\n" ++
  "      end\n" ++
  "      o2[:binmode] = true if bin && !o2.key?(:binmode) && !o2[:mode].to_s.include?(\"b\")\n" ++
  "    end\n" ++
  "    m = o2[:mode]\n" ++
  "    if m.is_a?(String) || (!m.nil? && !m.is_a?(Integer) && m.respond_to?(:to_str))\n" ++
  "      m1, encs = __fd_str(m).split(\":\", 2)\n" ++
  "      if encs && (o2.key?(:encoding) || o2.key?(:external_encoding) || o2.key?(:internal_encoding))\n" ++
  "        raise ArgumentError, \"encoding specified twice\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "    f = __ln_open(name, o2)\n" ++
  "    begin\n" ++
  "      f.seek(offset) if offset\n" ++
  "      f.write(string)\n" ++
  "    ensure\n" ++
  "      f.close\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  # === reopen and dup ========================================================\n" ++
  "  # #reopen puts another stream's descriptor (or a newly opened path) UNDER\n" ++
  "  # this one's number with dup2(2): the object and its #fileno stay, what the\n" ++
  "  # number refers to changes -- which is why output written to fd 1 by the\n" ++
  "  # interpreter itself goes wherever STDOUT was reopened to.\n" ++
  "  def __reopen_src(other, mode)\n" ++
  "    if !other.is_a?(IO) && !other.is_a?(String) && other.respond_to?(:to_io)\n" ++
  "      io = other.to_io\n" ++
  "      raise TypeError, \"can't convert \" + other.class.to_s + \" to IO (\" + other.class.to_s + \"#to_io gives \" + io.class.to_s + \")\" unless io.is_a?(IO)\n" ++
  "      other = io\n" ++
  "    end\n" ++
  "    if other.is_a?(IO)\n" ++
  "      raise IOError, \"closed stream\" if other.closed?\n" ++
  "      other.flush if !other.equal?(STDIN) && (other.instance_variable_get(:@__io_w) || other.instance_variable_get(:@__f_path))\n" ++
  "      [other.fileno, false]\n" ++
  "    else\n" ++
  "      path = IO.__fd_path(other)\n" ++
  "      m = mode.nil? ? (@__io_w && !@__io_r ? \"w\" : (self.fileno == 0 ? \"r\" : \"w\")) : mode\n" ++
  "      flags = m.is_a?(Integer) ? m : IO.__fd_strflags(IO.__fd_str(m).split(\":\", 2)[0].to_s, m)\n" ++
  "      [IO.__fd_open(path, flags, 0666), true]\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def reopen(other = nil, mode = nil, **opts)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1..2)\" if other.nil? && mode.nil?\n" ++
  "    __any_closed!\n" ++
  "    fd = self.fileno\n" ++
  "    src, fresh = __reopen_src(other, mode)\n" ++
  "    r = IO.__fddup2(src, fd)\n" ++
  "    IO.__fdclose(src) if fresh\n" ++
  "    raise Errno::EBADF if r < 0\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def __fd_reopen(other = nil, mode = nil, **opts)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1..2)\" if other.nil? && mode.nil?\n" ++
  "    __fd_closed!\n" ++
  "    __fd_flush_w if @__io_w\n" ++
  "    src, fresh = __reopen_src(other, mode)\n" ++
  "    r = IO.__fddup2(src, @__io_fd)\n" ++
  "    IO.__fdclose(src) if fresh\n" ++
  "    raise Errno::EBADF if r < 0\n" ++
  "    @__io_rbuf = +\"\".b\n" ++
  "    @__io_wbuf = +\"\".b\n" ++
  "    if other.is_a?(IO)\n" ++
  "      @__io_r = other.instance_variable_get(:@__io_r) != false\n" ++
  "      @__io_w = other.instance_variable_get(:@__io_w) != false\n" ++
  "    end\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  # a standard stream's copy is a descriptor stream over dup(2) of it\n" ++
  "  def dup\n" ++
  "    __any_closed!\n" ++
  "    fd = IO.__fddup(self.fileno)\n" ++
  "    raise Errno::EMFILE if fd < 0\n" ++
  "    IO.for_fd(fd, self.fileno == 0 ? \"r\" : \"w\")\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class File\n" ++
  "  # a File's copy is the same file opened again, where this one is: its own\n" ++
  "  # descriptor (when asked for one), its own position, the same flags\n" ++
  "  def dup\n" ++
  "    __closed!\n" ++
  "    self.flush\n" ++
  "    m = @__f_mode.to_s\n" ++
  "    acc = m.split(\":\", 2)[0].to_s\n" ++
  "    f = File.new(@__f_path, acc.start_with?(\"r\") ? acc : \"r+\")\n" ++
  "    f.instance_variable_set(:@__f_mode, m)\n" ++
  "    f.seek(self.pos)\n" ++
  "    %i[@__f_binmode @__f_ext @__f_int @__f_int_given @__f_encs_set @__f_sync @__f_lineno @__f_nl].each do |iv|\n" ++
  "      f.instance_variable_set(iv, instance_variable_get(iv)) if instance_variable_defined?(iv)\n" ++
  "    end\n" ++
  "    f\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class File\n" ++
  "  # a File is a path: it reopens onto a path, or onto another File's path at\n" ++
  "  # that File's position -- not onto a descriptor stream, which has none\n" ++
  "  def reopen(other = nil, mode = nil, **opts)\n" ++
  "    raise ArgumentError, \"wrong number of arguments (given 0, expected 1..2)\" if other.nil? && mode.nil?\n" ++
  "    if !other.is_a?(IO) && !other.is_a?(String) && other.respond_to?(:to_io)\n" ++
  "      io = other.to_io\n" ++
  "      raise TypeError, \"can't convert \" + other.class.to_s + \" to IO (\" + other.class.to_s + \"#to_io gives \" + io.class.to_s + \")\" unless io.is_a?(IO)\n" ++
  "      other = io\n" ++
  "    end\n" ++
  "    if other.is_a?(File)\n" ++
  "      __closed!\n" ++
  "      raise IOError, \"closed stream\" if other.closed?\n" ++
  "      other.flush\n" ++
  "      m = other.instance_variable_get(:@__f_mode).to_s.split(\":\", 2)[0].to_s\n" ++
  "      self.__f_reopen(other.path, m.start_with?(\"w\") ? \"r+\" : m)\n" ++
  "      instance_variable_set(:@__f_mode, m)\n" ++
  "      self.pos = other.pos\n" ++
  "      return self\n" ++
  "    end\n" ++
  "    if other.is_a?(IO)\n" ++
  "      __closed!\n" ++
  "      raise IOError, \"closed stream\" if other.closed?\n" ++
  "      # a descriptor stream opened by a path (IO.sysopen) is that path, where\n" ++
  "      # it is now; one that never had a path has nothing a File can be\n" ++
  "      opath = other.instance_variable_get(:@__io_path) || IO.__fdpath(other.fileno)\n" ++
  "      raise NotImplementedError, \"a File here is a path, and \" + other.inspect + \" has none to reopen onto\" if opath.nil?\n" ++
  "      at = other.pos\n" ++
  "      acc = IO.__fdacc(other.fileno)\n" ++
  "      m = acc < 0 ? \"r\" : [\"r\", \"w\", \"r+\"][acc & 3]\n" ++
  "      m = \"a\" if acc >= 0 && (acc & 16) != 0\n" ++
  "      self.__f_reopen(opath.to_s, m.start_with?(\"w\") ? \"r+\" : m)\n" ++
  "      instance_variable_set(:@__f_mode, m)\n" ++
  "      self.pos = at\n" ++
  "      return self\n" ++
  "    end\n" ++
  "    # a path is reopened with the mode given, or with this stream's own (a\n" ++
  "    # closed stream can be reopened this way)\n" ++
  "    cur = @__f_mode.to_s.split(\":\", 2)[0].to_s\n" ++
  "    cur = @__f_lastmode.to_s if cur.empty?\n" ++
  "    m = mode.nil? ? (cur.empty? ? \"r\" : cur) : mode\n" ++
  "    ms = m.is_a?(Integer) ? m : IO.__fd_str(m)\n" ++
  "    # a writing mode opens as it would: \"w\" truncates, \"a\" creates\n" ++
  "    path = IO.__fd_path(other)\n" ++
  "    if ms.is_a?(String) && (ms.start_with?(\"w\") || (ms.start_with?(\"a\") && !File.exist?(path)))\n" ++
  "      File.open(path, \"w\") \{ }\n" ++
  "    end\n" ++
  "    self.__f_reopen(path, ms)\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class IO\n" ++
  "  # the object as an IO: itself, or what its #to_io answers (which must be\n" ++
  "  # one); nil for anything that has no #to_io -- a BasicObject, which has no\n" ++
  "  # #respond_to? to ask, included\n" ++
  "  def self.try_convert(obj)\n" ++
  "    return obj if obj.is_a?(IO)\n" ++
  "    ok = begin\n" ++
  "      obj.respond_to?(:to_io)\n" ++
  "    rescue NoMethodError\n" ++
  "      false\n" ++
  "    end\n" ++
  "    return nil unless ok\n" ++
  "    io = obj.to_io\n" ++
  "    return io if io.nil? || io.is_a?(IO)\n" ++
  "    raise TypeError, \"can't convert \" + obj.class.to_s + \" into IO (\" + obj.class.to_s + \"#to_io gives \" + io.class.to_s + \")\"\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class File\n" ++
  "  # seek(offset, whence = IO::SEEK_SET): the offset through #to_int and as a\n" ++
  "  # C off_t, the whence a number or :SET / :CUR / :END; a position before the\n" ++
  "  # start is EINVAL and moves nothing\n" ++
  "  def seek(off, whence = 0)\n" ++
  "    @__f_ahead = nil\n" ++
  "    off = IO.__fd_long(IO.__fd_int(off))\n" ++
  "    whence = \{ SET: 0, CUR: 1, END: 2 }[whence] || whence if whence.is_a?(Symbol)\n" ++
  "    whence = IO.__fd_int(whence)\n" ++
  "    raise Errno::EINVAL, \"Invalid argument @ rb_io_seek - \" + path.to_s unless whence >= 0 && whence <= 2\n" ++
  "    raise Errno::EINVAL, \"Invalid argument @ rb_io_seek - \" + path.to_s if self.__f_seek(off, whence) < 0\n" ++
  "    0\n" ++
  "  end\n" ++
  "\n" ++
  "  def pos=(off)\n" ++
  "    seek(off, 0)\n" ++
  "    off\n" ++
  "  end\n" ++
  "\n" ++
  "  # the unbuffered write: no conversion, straight to the file -- after a\n" ++
  "  # warning when buffered writes are still waiting ahead of it\n" ++
  "  def syswrite(s)\n" ++
  "    __closed!\n" ++
  "    s = IO.__wstr(s, nil)\n" ++
  "    warn(\"warning: syswrite for buffered IO\") unless @__f_buf.to_s.empty?\n" ++
  "    @__f_ahead = nil\n" ++
  "    n = self.__f_write(s)\n" ++
  "    self.flush\n" ++
  "    n\n" ++
  "  end\n" ++
  "end\n";

let core_prelude = core_prelude_a ++ core_prelude_b ++ core_prelude_c ++ core_prelude_d ++ core_prelude_e ++ core_prelude_f ++ core_prelude_g ++ core_prelude_h ++ core_prelude_i ++ core_prelude_j;


// define each CONST=encoding-name pair of the table above, `|`-separated.
let rec enc_define_all = fn mk -> fn (t: str) -> fn (i: int) ->
  if i >= str_len t then ()
  else
    let e = (let j = str_find_from t "|" i in if j < 0 then str_len t else j) in
    let item = substring t i e in
    let eq = str_find_from item "=" 0 in
    let _ = (if eq < 0 then () else
               (let cname = substring item 0 eq in
                let ename = substring item (eq + 1) (str_len item) in
                let _ = map_set consts ("Encoding::" ++ cname) (mk ename) in
                // the constant's spelling doubles as the alias name ruby's
                // Encoding.find accepts (underscores are the '-'s).
                map_set enc_alias_canon (enc_norm_name cname) ename)) in
    enc_define_all mk t (e + 1);

// MERE_RUBY_STORE_STATS=1 prints, at exit, how many entries each store holds.
// Nothing here is ever reclaimed -- Mere has no way to give a container's memory
// back (map_delete does not, overwriting a key does not, and a region block does
// not: measured) -- so these counts ARE the growth, and they say which store a
// collector would have to trace first rather than leaving it to be guessed.
let store_stats = fn world ->
  let (meths, sup, ocls, ivars) = world in
  let row = fn (nm: str) -> fn (n: int) ->
    print_err (nm ++ "\t" ++ str_of_int n ++ "\n") in
  let _ = print_err "store\tentries\n" in
  let _ = row "arr_store" (map_len arr_store) in
  let _ = row "hash_fast" (if map_has arr_ctr 2 then map_get arr_ctr 2 else 0) in
  let _ = row "hash_slow" (if map_has arr_ctr 3 then map_get arr_ctr 3 else 0) in
  let _ = row "arr_pending_flushes" (if map_has arr_ctr 1 then map_get arr_ctr 1 else 0) in
  let _ = row "ivars" (map_len ivars) in
  let _ = row "ocls" (map_len ocls) in
  let _ = row "meths" (map_len meths) in
  let _ = row "sup" (map_len sup) in
  let _ = row "globals" (map_len globals) in
  let _ = row "consts" (map_len consts) in
  let _ = row "sym_ids" (map_len sym_ids) in
  let _ = row "str_enc" (map_len str_enc) in
  let _ = row "str_frozen" (map_len str_frozen) in
  let _ = row "hash_dflt" (map_len hash_dflt) in
  let _ = row "proc_store" (map_len proc_store) in
  let _ = row "proc_home" (map_len proc_home) in
  let _ = row "bind_store" (map_len bind_store) in
  let _ = row "lv_up" (map_len lv_up) in
  let _ = row "live_frames" (map_len live_frames) in
  let _ = row "pool_hits" (if map_has frame_pool_n 1 then map_get frame_pool_n 1 else 0) in
  let _ = row "pool_news" (if map_has frame_pool_n 2 then map_get frame_pool_n 2 else 0) in
  let _ = row "pool_puts" (if map_has frame_pool_n 3 then map_get frame_pool_n 3 else 0) in
  // block envs through the same pool (blk_env_get/put): puts that were block
  // envs, and envs a closure captured that therefore stayed out of the pool.
  let _ = row "blk_puts" (if map_has frame_pool_n 7 then map_get frame_pool_n 7 else 0) in
  let _ = row "blk_kept" (if map_has frame_pool_n 6 then map_get frame_pool_n 6 else 0) in
  let _ = row "pool_drops" (if map_has frame_pool_n 4 then map_get frame_pool_n 4 else 0) in
  let _ = row "pool_bytes_wound_back" (if map_has frame_pool_n 5 then map_get frame_pool_n 5 else 0) in
  // arena BYTES per store (v0.1.299 map_bytes/vec_bytes): where the resident
  // memory actually lives, which entry counts cannot say (a store of a few
  // entries can hold a giant arena and vice versa). Backend-dependent values,
  // for diagnosis only -- never for output.
  let _ = row "bytes_str_store" (vec_bytes str_store) in
  let _ = row "bytes_arr_store" (map_bytes arr_store) in
  let _ = row "bytes_hash_store" (vec_bytes hash_store) in
  let _ = row "bytes_ivars" (map_bytes ivars) in
  let _ = row "bytes_ocls" (map_bytes ocls) in
  let _ = row "bytes_meths" (map_bytes meths) in
  let _ = row "bytes_consts" (map_bytes consts) in
  let _ = row "bytes_globals" (map_bytes globals) in
  let _ = row "bytes_str_enc" (map_bytes str_enc) in
  let _ = row "bytes_str_frozen" (map_bytes str_frozen) in
  let _ = row "bytes_sym_ids" (map_bytes sym_ids) in
  let _ = row "bytes_proc_store" (map_bytes proc_store) in
  let _ = row "bytes_proc_yblk" (map_bytes proc_yblk) in
  let _ = row "bytes_bind_store" (map_bytes bind_store) in
  let _ = row "bytes_lv_up" (map_bytes lv_up) in
  let _ = row "bytes_mro_anc" (map_bytes mro_anc) in
  let _ = row "bytes_dm_methods" (map_bytes dm_methods) in
  let _ = row "call_names" (map_len call_names_s) in
  let _ = row "call_lines" (map_len call_lines) in
  let _ = row "rx_progs" (map_len rx_progs) in
  let _ = row "rx_caps" (map_len rx_caps) in
  let _ = row "md_whole" (map_len md_whole) in
  let _ = row "time_inst" (map_len time_inst) in
  let _ = row "mro_anc" (map_len mro_anc) in
  let _ = row "lex_cref" (map_len lex_cref) in
  let _ = row "meth_cref" (map_len meth_cref) in
  let _ = row "dm_methods" (map_len dm_methods) in
  let _ = row "loaded_files" (map_len loaded_files) in
  // The call-bookkeeping maps' ARENAS. gc_collect compacts these, which moves
  // their write churn out of the default region and into a private arena --
  // and a private arena is invisible to MERE_REGION_STATS. Without these rows
  // the compaction would look like the memory vanished when it only left the
  // frame the other meter can see.
  let _ = row "bytes_call_names" (map_bytes call_names_s) in
  let _ = row "bytes_call_files" (map_bytes call_files_s) in
  let _ = row "bytes_call_meths" (map_bytes call_meths_s) in
  let _ = row "bytes_cur_pos" (map_bytes cur_pos_s) in
  let _ = row "bytes_call_lines" (map_bytes call_lines) in
  let _ = row "bytes_live_frames" (map_bytes live_frames) in
  let _ = row "bytes_struct_ctr" (map_bytes struct_ctr) in
  let _ = row "bytes_thread_flag" (map_bytes thread_flag) in
  let _ = row "bytes_gc_bare" (map_bytes gc_bare) in
  let _ = row "gc_blocked" (if map_has gc_state "blocked" then map_get gc_state "blocked" else 0) in
  row "insp_seen" (map_len insp_seen);

let data_ctx = map_new ();
// the libraries -r names, in the order given
let cli_reqs = map_new ();
let add_cli_req = fn (lib: str) ->
  map_set cli_reqs "v" ((if map_has cli_reqs "v" then map_get cli_reqs "v" ++ chr 10 else "") ++ lib);
// The report for an exception nobody rescued: what ruby's error_print writes,
// which is Exception#full_message with no highlighting -- the head line (the
// raise site and "message (Class)"), a "\tfrom" line per remaining frame, and
// then every cause the same way. It used to be `file:line: message (Class)`
// and nothing else: no "in '<main>'", no frames, no cause, and a custom
// backtrace (`raise E, msg, [...]`) was never printed at all. An exception
// with no frames of its own (a builtin's refusal) is headed with the place
// the raise was reported from, named the way a frame is.
let top_report = fn env -> fn world -> fn (exc: Val) -> fn (name: str) ->
  let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let w9 = err_where name in
  let head9 = (if str_contains w9 ":in '" then w9 else w9 ++ ":in '<main>'") in
  let chain0 = exc_cause_chain env world exc VNil 8 in
  let bare9 = (match invoke_val_c env world noblk9 exc "backtrace" Nil false with
               | VArr a9 -> (match deref a9 with Nil -> true | _ -> false)
               | _ -> true) in
  let chain9 = (if bare9 then
                  (match chain0 with
                   | Cons ((e9, _), t9) -> Cons ((e9, arr_new (Cons (mkstr head9, Nil))), t9)
                   | Nil -> chain0)
                else chain0) in
  let _ = map_set fm_kw "v" VNil in
  let s9 = exc_blocks env world chain9 false in
  if str_len s9 > 0 && str_eq (char_at s9 (str_len s9 - 1)) "\n" then substring s9 0 (str_len s9 - 1) else s9;

let run_src = fn (src0: str) -> fn (print_result: bool) -> fn (name: str) ->
  let (src, doff9) = src_prepare src0 in
  let _ = (if doff9 >= 0 && (if str_eq name "-e" then false else true) then map_set data_ctx "off" doff9 else ()) in
  // diagnostics that must see the rubygems PRELOAD switch on here, first:
  // collections during the preload's requires are real collections, and
  // for a day they were invisible because the GC log was armed after them.
  let _ = (if str_eq (env_get "MERE_RUBY_INTERN_LOG") "" then () else map_set intern_log "on" 1) in
  let _ = map_set gc_state "log" (if str_eq (env_get "MERE_RUBY_GC_LOG") "" then 0 else 1) in
  let _ = map_set load_ctx "dir" (mkstr (dirname_of name)) in
  let _ = map_set load_ctx "file" (mkstr name) in
  let _ = map_set loaded_files name VNil in
  let cod0 = src_coding src in
  let _ = map_set load_ctx "coding" (mkstr (if str_eq cod0 "" then "UTF-8" else cod0)) in
  let _ = map_set fsl_ctx "v" (src_fsl src) in
  let toks = number_nls src (lex_go src 0) in
  let _ = parse_line_reset (count_nls toks) in
  let (prog, rest) = parse_stmts toks Nil in
  let _ = rx_check_pending () in
  let _ =
    (match rest with
     | Cons (TEOF, _) -> ()
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unexpected token at top level" ++ parsing_file ()))) in fail ("mere-ruby: unexpected token at top level" ++ parsing_file ()))) in
  let env = map_new () in
  // The program's middle (non-BEGIN/END) statements, computed once, OUTSIDE
  // the loop: the carried cursor is an INDEX into this default-region list,
  // so no AST ever crosses arenas.
  let gc_mids = filter_mid prog in
  let gc_total = list_len gc_mids in
  // THE WORLD is four maps created here and threaded as `world` -- and since
  // mere v0.1.297 every store (these four included) reclaims by rebuilding IN
  // PLACE through its stable handle (survivors out, map_clear, survivors
  // back, map_compact). The region loop that used to carry them across
  // arenas is gone: compaction made the swap redundant, and a collection is
  // a plain function (gc_collect) callable from any depth whose in-flight
  // values are rooted.
  // ...all four are globals (see obj_cls and meths_g): a helper with no world
  // in hand can still answer about a class, and a Fiber's thread can rebuild
  // the world it was not handed.
  let meths = meths_g in
  let sup = cls_sup in
  let ocls = obj_cls in
  let ivars = ivars_g in
  // Encoding objects (VObj of class Encoding, name in @name). Shared instances
  // stored in enc_objs; the constants point at them. String#encoding returns
  // the matching one, so `x.encoding == Encoding::UTF_8` holds by identity.
  // one object per encoding NAME: ruby's aliases are the same object
  // (Encoding::BIG5.equal?(Encoding::Big5)), and String#encoding compares by
  // identity.
  let mk_enc = fn (nm: str) ->
    if map_has enc_objs nm then map_get enc_objs nm else
    let id = alloc_oid ocls in
    let _ = map_set ocls id "Encoding" in
    let _ = map_set ivars (str_of_int id ++ "@name") (mkstr nm) in
    let o = VObj id in
    let _ = map_set enc_objs nm o in
    let _ = map_set enc_alias_canon (enc_norm_name nm) nm in
    let _ = map_set enc_name (str_of_int id) nm in o in
  let _ = map_set consts "Encoding::UTF_8" (mk_enc "UTF-8") in
  // an alias no constant spells (ruby's Encoding.aliases lists it)
  let _ = map_set enc_alias_canon (enc_norm_name "Big5-HKSCS:2008") "Big5-HKSCS" in
  let _ = map_set consts "Encoding::US_ASCII" (mk_enc "US-ASCII") in
  let _ = map_set consts "Encoding::ASCII_8BIT" (mk_enc "ASCII-8BIT") in
  let _ = map_set consts "Encoding::BINARY" (if map_has enc_objs "ASCII-8BIT" then map_get enc_objs "ASCII-8BIT" else mkstr "ASCII-8BIT") in
  let _ = map_set consts "Encoding::ISO_8859_1" (mk_enc "ISO-8859-1") in
  let _ = map_set consts "Encoding::ASCII" (if map_has enc_objs "US-ASCII" then map_get enc_objs "US-ASCII" else mkstr "US-ASCII") in
  let _ = map_set consts "Encoding::UTF_16LE" (mk_enc "UTF-16LE") in
  let _ = map_set consts "Encoding::UTF_16BE" (mk_enc "UTF-16BE") in
  let _ = map_set consts "Encoding::UTF_32LE" (mk_enc "UTF-32LE") in
  let _ = map_set consts "Encoding::UTF_32BE" (mk_enc "UTF-32BE") in
  // dummy encodings (see enc_is_dummy).
  let _ = map_set consts "Encoding::UTF_16" (mk_enc "UTF-16") in
  let _ = map_set consts "Encoding::UTF_32" (mk_enc "UTF-32") in
  let _ = map_set consts "Encoding::ISO_2022_JP" (mk_enc "ISO-2022-JP") in
  let _ = map_set consts "Encoding::ISO_2022_JP_2" (mk_enc "ISO-2022-JP-2") in
  let _ = map_set consts "Encoding::ISO_2022_JP_KDDI" (mk_enc "ISO-2022-JP-KDDI") in
  let _ = map_set consts "Encoding::IBM037" (mk_enc "IBM037") in
  let _ = map_set consts "Encoding::IBM437" (mk_enc "IBM437") in
  let _ = map_set consts "Encoding::CP50220" (mk_enc "CP50220") in
  let _ = map_set consts "Encoding::CP50221" (mk_enc "CP50221") in
  let _ = map_set consts "Encoding::UTF_7" (mk_enc "UTF-7") in
  let _ = map_set consts "Encoding::SHIFT_JIS" (mk_enc "Shift_JIS") in
  let _ = map_set consts "Encoding::Shift_JIS" (if map_has enc_objs "Shift_JIS" then map_get enc_objs "Shift_JIS" else mkstr "Shift_JIS") in
  let _ = map_set consts "Encoding::EUC_JP" (mk_enc "EUC-JP") in
  // ...and every other Encoding constant ruby defines, as CONST=name pairs.
  // mere-ruby transcodes only a handful of these; a constant EXISTING is not a
  // claim that it does. activesupport indexes a table by these objects, so a
  // missing one stopped railties at Encoding::GB18030.
  let enc_table =
    "UTF_8_HFS=UTF8-MAC|UTF_8_MAC=UTF8-MAC|UCS_2BE=UTF-16BE|UCS_4BE=UTF-32BE|CP932=Windows-31" ++
    "J|CsWindows31J=Windows-31J|UCS_4LE=UTF-32LE|SJIS=Windows-31J|PCK=Windows-31J|CSWINDOWS31" ++
    "J=Windows-31J|CP1251=Windows-1251|CP1252=Windows-1252|CP1250=Windows-1250|CP1254=Windows" ++
    "-1254|CP1257=Windows-1257|CP1253=Windows-1253|UTF8_DOCOMO=UTF8-DoCoMo|SJIS_DoCoMo=SJIS-D" ++
    "oCoMo|UTF8_DoCoMo=UTF8-DoCoMo|UTF8_KDDI=UTF8-KDDI|SJIS_KDDI=SJIS-KDDI|SJIS_DOCOMO=SJIS-D" ++
    "oCoMo|Stateless_ISO_2022_JP_KDDI=stateless-ISO-2022-JP-KDDI|STATELESS_ISO_2022_JP_KDDI=s" ++
    "tateless-ISO-2022-JP-KDDI|UTF8_SOFTBANK=UTF8-SoftBank|SJIS_SoftBank=SJIS-SoftBank|UTF8_S" ++
    "oftBank=UTF8-SoftBank|SJIS_SOFTBANK=SJIS-SoftBank|Big5=Big5|BIG5=Big5|Big5_HKSCS=Big5-HK" ++
    "SCS|BIG5_HKSCS=Big5-HKSCS|Big5_UAO=Big5-UAO|BIG5_UAO=Big5-UAO|CESU_8=CESU-8|CP949=CP949|" ++
    "Emacs_Mule=Emacs-Mule|EMACS_MULE=Emacs-Mule|EUC_KR=EUC-KR|EUC_TW=EUC-TW|GB18030=GB18030|" ++
    "GBK=GBK|ISO_8859_2=ISO-8859-2|ISO_8859_3=ISO-8859-3|ISO_8859_4=ISO-8859-4|ISO_8859_5=ISO" ++
    "-8859-5|ISO_8859_6=ISO-8859-6|ISO_8859_7=ISO-8859-7|ISO_8859_8=ISO-8859-8|ISO_8859_9=ISO" ++
    "-8859-9|ISO_8859_10=ISO-8859-10|ISO_8859_11=ISO-8859-11|ISO_8859_13=ISO-8859-13|ISO_8859" ++
