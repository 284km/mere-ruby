  let _ = galias "LOAD_PATH" ":" in
  let _ = galias "-I" ":" in
  let _ = galias "LOADED_FEATURES" "\"" in
  let _ = galias "FILENAME" "<" in
  let _ = galias "PROGRAM_NAME" "0" in
  let _ = galias "-0" "/" in
  let _ = galias "-d" "DEBUG" in
