  // These paths are a fiction -- there is no ruby installation to describe --
  // but rubygems computes `Gem.default_dir` from rubylibprefix and
  // ruby_version, and DEFAULT gem specs live under it
  // (`specifications/default`, 71 of them in a 3.2 tree). Deriving the prefix
  // from GEM_HOME makes the fiction agree with the tree mere-ruby was pointed
  // at, so `net-protocol` and the rest are found rather than missing.
  let gh0 = env_get "GEM_HOME" in
  let gi = (if str_len gh0 > 0 then str_rfind gh0 "/gems/" 0 (0 - 1) else (0 - 1)) in
  let ghver = (if gi > 0 then substring gh0 (gi + 6) (str_len gh0) else "") in
  let ok = gi > 0 && str_len ghver > 0 && (if str_contains ghver "/" then false else true) in
  let rlp = (if ok then substring gh0 0 gi else "/usr/lib/ruby") in
  let rver = (if ok then ghver else "4.0.0") in
  // ...and the three paths a library builds out of that prefix. bundled_gems.rb
  // (which bundler 4 requires from Bundler.setup) reads `rubylibdir` and adds a
  // "/" to it, so a missing key is not a missing feature there but `nil + "/"`.
  let rarch = "arm64-darwin25" in
  let rld = rlp ++ "/" ++ rver in
  let rad = rld ++ "/" ++ rarch in
  let rbc = mkhash (Cons (mkstr "host_os", Cons (mkstr "darwin", Cons (mkstr "arch", Cons (mkstr rarch, Cons (mkstr "ruby_version", Cons (mkstr rver, Cons (mkstr "ruby_install_name", Cons (mkstr "ruby", Cons (mkstr "EXEEXT", Cons (mkstr "", Cons (mkstr "bindir", Cons (mkstr "/usr/bin", Cons (mkstr "libdir", Cons (mkstr "/usr/lib", Cons (mkstr "sitelibdir", Cons (mkstr rlp, Cons (mkstr "rubylibprefix", Cons (mkstr rlp, Cons (mkstr "rubylibdir", Cons (mkstr rld, Cons (mkstr "rubyarchdir", Cons (mkstr rad, Cons (mkstr "DLEXT", Cons (mkstr "bundle", Nil))))))))))))))))))))))))) in
  let _ = map_set consts "RbConfig::CONFIG" rbc in
  let _ = map_set consts "RbConfig::TOPDIR" (mkstr "/usr") in
  // rbconfig.rb also defines a TOP-LEVEL `CROSS_COMPILING` (nil for a native
  // build), and standing in for that file means standing in for what it
  // defines: bundler's rubygems_ext.rb reads `CROSS_COMPILING || RUBY_PLATFORM`
  // and a missing constant is a NameError there, not a nil.
  let _ = map_set consts "CROSS_COMPILING" VNil in
  // File::FNM_* — the flag bits File.fnmatch? and Dir.glob take.
  let _ = map_set consts "File::FNM_NOESCAPE" (VInt 1) in
  let _ = map_set consts "File::FNM_PATHNAME" (VInt 2) in
  let _ = map_set consts "File::FNM_DOTMATCH" (VInt 4) in
  let _ = map_set consts "File::FNM_CASEFOLD" (VInt 8) in
  let _ = map_set consts "File::FNM_EXTGLOB" (VInt 16) in
  let _ = map_set consts "File::FNM_SYSCASE" (VInt 0) in
  // File open-mode / lock bits. mere-ruby's File does not honour them (there
  // is no open(2) here), but libraries name them when building a mode.
  let _ = map_set consts "File::RDONLY" (VInt 0) in
  let _ = map_set consts "File::WRONLY" (VInt 1) in
  let _ = map_set consts "File::RDWR" (VInt 2) in
  let _ = map_set consts "File::CREAT" (VInt 512) in
  let _ = map_set consts "File::EXCL" (VInt 2048) in
  let _ = map_set consts "File::TRUNC" (VInt 1024) in
  let _ = map_set consts "File::APPEND" (VInt 8) in
  let _ = map_set consts "File::NONBLOCK" (VInt 4) in
  let _ = map_set consts "File::BINARY" (VInt 0) in
  let _ = map_set consts "File::LOCK_SH" (VInt 1) in
  let _ = map_set consts "File::LOCK_EX" (VInt 2) in
  let _ = map_set consts "File::LOCK_UN" (VInt 8) in
  let _ = map_set consts "File::LOCK_NB" (VInt 4) in
  let _ = map_set consts "File::SEPARATOR" (mkstr "/") in
  let _ = map_set consts "File::ALT_SEPARATOR" VNil in
  let _ = map_set consts "File::PATH_SEPARATOR" (mkstr ":") in
  // the bit bucket: aws-sdk-core opens it to throw output away.
  let _ = map_set consts "File::NULL" (mkstr "/dev/null") in
  // File::Constants is where ruby actually defines the flags above; File
  // includes it, so both names reach the same values.
  let _ = map_set modules "File::Constants" VNil in
  let _ = map_set consts "File::Constants" (VClass "File::Constants") in
  // ⚠ the rest of File::Constants, which ruby names twenty-six of and this
  //   had thirteen: the open(2) flags it was missing and the whole FNM_ set,
  //   which File.fnmatch takes as its third argument. Asked of the pinned
  //   reference (the numbers are platform ones, not invented).
  let _ = map_set consts "File::DSYNC" (VInt 4194304) in
  let _ = map_set consts "File::Constants::DSYNC" (VInt 4194304) in
  let _ = map_set consts "File::SYNC" (VInt 128) in
  let _ = map_set consts "File::Constants::SYNC" (VInt 128) in
  let _ = map_set consts "File::NOCTTY" (VInt 131072) in
  let _ = map_set consts "File::Constants::NOCTTY" (VInt 131072) in
  let _ = map_set consts "File::NOFOLLOW" (VInt 256) in
  let _ = map_set consts "File::Constants::NOFOLLOW" (VInt 256) in
  let _ = map_set consts "File::SHARE_DELETE" (VInt 0) in
  let _ = map_set consts "File::Constants::SHARE_DELETE" (VInt 0) in
  let _ = map_set consts "File::FNM_CASEFOLD" (VInt 8) in
  let _ = map_set consts "File::Constants::FNM_CASEFOLD" (VInt 8) in
  let _ = map_set consts "File::FNM_DOTMATCH" (VInt 4) in
  let _ = map_set consts "File::Constants::FNM_DOTMATCH" (VInt 4) in
  let _ = map_set consts "File::FNM_EXTGLOB" (VInt 16) in
  let _ = map_set consts "File::Constants::FNM_EXTGLOB" (VInt 16) in
  let _ = map_set consts "File::FNM_NOESCAPE" (VInt 1) in
  let _ = map_set consts "File::Constants::FNM_NOESCAPE" (VInt 1) in
  let _ = map_set consts "File::FNM_PATHNAME" (VInt 2) in
  let _ = map_set consts "File::Constants::FNM_PATHNAME" (VInt 2) in
  let _ = map_set consts "File::FNM_SHORTNAME" (VInt 0) in
  let _ = map_set consts "File::Constants::FNM_SHORTNAME" (VInt 0) in
  let _ = map_set consts "File::FNM_SYSCASE" (VInt 0) in
  let _ = map_set consts "File::Constants::FNM_SYSCASE" (VInt 0) in
  // ⚠ ...but NOT the separators: SEPARATOR, ALT_SEPARATOR and PATH_SEPARATOR
  //   are File's own, not File::Constants'. Putting them here made
  //   `File::Constants.constants` name three ruby does not. NULL is the one
  //   string that really does live in Constants.
  let _ = map_set consts "File::Constants::NULL" (mkstr "/dev/null") in
  // ⚠ IO AND FILE BOTH INCLUDE IT. `IO.include?(File::Constants)` is true in
  //   ruby and both core/io and core/file have a spec for it; the module
  //   existed here and nothing included it.
  let _ = map_set includes "IO" "File::Constants" in
  let _ = map_set includes "File" "File::Constants" in

  let _ = map_set consts "File::Constants::RDONLY" (VInt 0) in
  let _ = map_set consts "File::Constants::WRONLY" (VInt 1) in
  let _ = map_set consts "File::Constants::RDWR" (VInt 2) in
  let _ = map_set consts "File::Constants::CREAT" (VInt 512) in
  let _ = map_set consts "File::Constants::EXCL" (VInt 2048) in
  let _ = map_set consts "File::Constants::TRUNC" (VInt 1024) in
  let _ = map_set consts "File::Constants::APPEND" (VInt 8) in
  let _ = map_set consts "File::Constants::NONBLOCK" (VInt 4) in
  let _ = map_set consts "File::Constants::BINARY" (VInt 0) in
  let _ = map_set consts "File::Constants::LOCK_SH" (VInt 1) in
  let _ = map_set consts "File::Constants::LOCK_EX" (VInt 2) in
  let _ = map_set consts "File::Constants::LOCK_UN" (VInt 8) in
  let _ = map_set consts "File::Constants::LOCK_NB" (VInt 4) in
  // The identity is the REFERENCE ruby's (tools/ref_ruby.sh): mere-ruby has no
  // version of its own to report, and every gate compares its output against
  // that ruby's, so RUBY_VERSION has to be the one whose rubygems, bundler and
  // bundled_gems.rb branch on it. 3.2.2 until 2026-09-05, then 4.0.6.
  let _ = map_set consts "RUBY_VERSION" (mkstr "4.0.6") in
  let _ = map_set consts "RUBY_ENGINE" (mkstr "ruby") in
  let _ = map_set consts "RUBY_ENGINE_VERSION" (mkstr "4.0.6") in
  let _ = map_set consts "RUBY_PATCHLEVEL" (VInt 0) in
  let _ = map_set consts "RUBY_RELEASE_DATE" (mkstr "2026-07-14") in
  // The reference ruby's own revision. Like the RbConfig paths this is a
  // borrowed fact rather than a description of this interpreter -- there is no
  // git revision of mere-ruby to report here -- and it is what a program that
  // prints its ruby's identity expects to find. bundler's version command reads
  // it, so its absence was a NameError in the middle of `bundle --version`.
  let _ = map_set consts "RUBY_REVISION" (mkstr "03b6d3f8898a28604fe6cb00eae3226b821168f4") in
  let _ = map_set consts "RUBY_PLATFORM" (mkstr "arm64-darwin25") in
  let _ = map_set consts "RUBY_DESCRIPTION" (mkstr ruby_desc) in
  let _ = map_set consts "RUBY_COPYRIGHT" (mkstr "ruby - Copyright (C) 1993-2026 Yukihiro Matsumoto") in
  let _ = map_set consts "STDOUT" (VObj outid) in
  let _ = map_set globals "stdout" (VObj outid) in
  let errid = alloc_oid ocls in
  let _ = map_set ocls errid "IO" in
  let _ = map_set ivars (str_of_int errid ++ "@__io_fd") (VInt 2) in
  let _ = map_set consts "STDERR" (VObj errid) in
  let _ = map_set globals "stderr" (VObj errid) in
  let inid = alloc_oid ocls in
  let _ = map_set ocls inid "IO" in
  let _ = map_set ivars (str_of_int inid ++ "@__io_fd") (VInt 0) in
  let _ = map_set consts "STDIN" (VObj inid) in
  let _ = map_set globals "stdin" (VObj inid) in
  // the main Thread object (always index 0 of the registry), the default
  // ThreadGroup, and the thread-related constants.
  let mainid = alloc_oid ocls in
  let _ = map_set ocls mainid "Thread" in
  let _ = map_set ivars (str_of_int mainid ++ "@__tst") (mkstr "run") in
  let _ = map_set cur_thr "v" (VObj mainid) in
  let _ = map_set all_thr "0" (VObj mainid) in
  let tgid = alloc_oid ocls in
  let _ = map_set ocls tgid "ThreadGroup" in
  let _ = map_set dfl_tg "v" (VObj tgid) in
  let _ = map_set consts "ThreadGroup" (VClass "ThreadGroup") in
  let _ = map_set consts "ThreadGroup::Default" (VObj tgid) in
  let _ = map_set consts "ThreadError" (VClass "ThreadError") in
  let _ = map_set consts "Thread::Mutex" (VClass "Mutex") in
  let _ = map_set consts "Queue" (VClass "Queue") in
  let _ = map_set consts "SizedQueue" (VClass "SizedQueue") in
  let _ = map_set consts "ConditionVariable" (VClass "ConditionVariable") in
  let _ = map_set consts "Thread::Queue" (VClass "Queue") in
  let _ = map_set consts "Thread::SizedQueue" (VClass "SizedQueue") in
  let _ = map_set consts "Thread::ConditionVariable" (VClass "ConditionVariable") in
  let _ = map_set consts "ClosedQueueError" (VClass "ClosedQueueError") in
  // ENV (reads go through getenv, writes overlay), ARGV, $0/$PROGRAM_NAME.
  let envid = alloc_oid ocls in
  let _ = map_set ocls envid "EnvHash" in
  let _ = map_set consts "ENV" (VObj envid) in
  let _ = map_set consts "ARGV" (if map_has cli_argv "v" then map_get cli_argv "v" else arr_new Nil) in
  // ARGF: the pseudo-file over the ARGV filenames (or stdin). Its methods
  // (read / each / each(nil)) are dispatched specially on class "ARGF".
  let argfid = alloc_oid ocls in
  let _ = map_set ocls argfid "ARGF" in
  let _ = map_set consts "ARGF" (VObj argfid) in
  let _ = map_set globals "0" (mkstr name) in
  // `$$` is the process id, like Process.pid -- set only if there IS one. On a
  // target with no host (`mere -rv`, where the program is the machine) `getpid`
  // is an extern with no C library behind it, and this line runs at startup, so
  // it stopped every program before it began.
  //
  // Left UNSET rather than set to 0. The comment on the extern above says why:
  // a made-up number is a stable lie, and nil is detectable where a lie is not.
  // `Process.pid` still asks, and still stops, for a program that actually wants
  // the pid -- which is the honest answer to "what is my process id" on a machine
  // that has no processes.
  let _ = try_or (fn (u: unit) -> map_set globals "$" (VInt (getpid ()))) () in
  let _ = map_set globals (gvar_slot "PROGRAM_NAME") (mkstr name) in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  // A small core prelude, written in ruby and run before the program: classes
  // that are core (no `require` names them) but are ordinary objects, so
  // writing them in ruby is shorter and clearer than a builtin. It runs as its
  // own program, so it does not shift the script's line numbers.
  let _ = (let (pprog, _) = parse_stmts (number_nls core_prelude (lex_go core_prelude 0)) Nil in
           hoist_run env world noblk pprog) in
  // An exception nobody rescued: report it the way Ruby does and exit 1,
  // instead of letting the interpreter's own `fail` message be the last word.
  // (Until this, every uncaught Ruby exception read as "(ruby exception
  // raised)", which named neither the class nor the message.)
  // ruby LOADS RUBYGEMS BEFORE the program (that is what `--disable=gems` turns
  // off), and mere-ruby did not: `bundle --version` reached line 15 and stopped
  // at `uninitialized constant Gem::Requirement`, because bundler expects the
  // gem library to be there already. So when rubygems can be FOUND on the load
  // path, it is required first, exactly as ruby does; when it cannot (no -I, no
  // RUBYLIB -- the corpus, the playground) nothing happens and nothing slows
  // down. MERE_RUBY_NO_GEMS=1 is the `--disable=gems` of this interpreter.
  let _ = (if str_eq (env_get "MERE_RUBY_NO_GEMS") ""
              && (if str_eq (load_path_find world "rubygems.rb") "" then false else true)
           then (let _ = try_or (fn (u: unit) -> (match do_require env world noblk false "rubygems" with _ -> ())) () in ())
           else ()) in
  let _ = map_set gc_state "log" (if str_eq (env_get "MERE_RUBY_GC_LOG") "" then 0 else 1) in
  // Two diagnostics for the collector, both off unless asked for. They exist
  // because the questions they answer came up and could not be answered by
  // reading the code:
  //   MERE_RUBY_GC_NO_LVUP_ROOT=1 stops rooting lv_up. UNSOUND -- a closure
  //     can lose its outer scope -- and for measurement only: it answers "how
  //     much is the scope-chain table PINNING?". Answer, on a rubocop load:
  //     nothing (str_store moved by 24 bytes), which killed a plan to prune it.
  //   MERE_RUBY_GC_TIGHT=1 makes the byte trigger fire at baseline + 8 MB
  //     instead of 2x + 32 MB, and counts the safepoints that pressure wanted
  //     and could not have (the gc_blocked row of MERE_RUBY_STORE_STATS).
  //     Answer, on the same load: 2 collections against 18.8M blocked checks,
  //     which is how "the collector is starved of safe points, not of
  //     pressure" stopped being a guess.
  let _ = map_set gc_state "nolvup" (if str_eq (env_get "MERE_RUBY_GC_NO_LVUP_ROOT") "" then 0 else 1) in
  let _ = map_set gc_state "tight" (if str_eq (env_get "MERE_RUBY_GC_TIGHT") "" then 0 else 1) in
  let _ = (if str_eq (env_get "MERE_RUBY_INTERN_LOG") "" then () else map_set intern_log "on" 1) in
  let _ = run_pre env world noblk prog in
  // The driver: plain recursion, no carry -- the collection is a function
  // now (gc_collect) and every store rebuilds in place through stable
  // handles, so nothing needs an arena swap. Each chunk runs inside its own
  // region DRV block: the per-iteration flow copies and driver temporaries
  // that used to land in the carried loop's arena die at the chunk boundary
  // instead.
  let rec gc_drive = fn (cursor: int) -> fn (lastv: Val) ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    // pin the carried value for the collection below (see gc_hold).
    let _ = map_set gc_hold "lastv" lastv in
    // the stack is trivially clean here; a raise anywhere below may have
    // skipped gc_unsafe pops, so the counter self-heals at each chunk.
    let _ = map_set gc_unsafe "n" 0 in
    if cursor < gc_total then
      let r3 = try_or (fn (u: unit) ->
                 region DRV {
                   run_until_gc env world noblk (gc_suffix gc_mids cursor) lastv
                 })
               ((0, 3, VNil)) in
      let (consumed, flag, v2) = r3 in
      (if flag == 0 then
        // v2 -- the value the chunk just produced -- is the one this
        // collection can see least: it was born inside the region above and
        // is held by nothing but this local until the next chunk pins it.
        (let _ = map_set gc_hold "lastv" v2 in
         let _ = gc_collect env world in
         gc_drive (cursor + consumed) v2)
      else if flag == 1 then gc_drive gc_total v2
      else if flag == 2 then gc_drive (gc_total + 1) lastv
      else gc_drive (gc_total + 2) lastv)
    else
      // ---- finish: reporting, at_exit, optional print ----
      let (meths, sup, ocls, ivars) = world in
      let _ = (if str_eq (env_get "MERE_RUBY_STORE_STATS") "" then () else store_stats world) in
      let _ = if cursor <= gc_total + 1 then run_at_exits world else
        (let exc = (if map_has ivars "$exc" then map_get ivars "$exc" else VNil) in
         match exc with
         | VExc (ec, em) -> let _ = print_err (err_where name ++ ": " ++ em ++ " (" ++ ec ++ ")") in let _ = run_at_exits world in exit 1
         | VObj eid ->
           (let ec = map_get ocls eid in
            // an unrescued SystemExit (Kernel#exit / #abort) ends the program
            // with the status it carries and says nothing: that is what exit
            // means. Everything else is reported.
            if str_eq ec "SystemExit" then
              (let st = (if map_has ivars (str_of_int eid ++ "@__status")
                         then (match map_get ivars (str_of_int eid ++ "@__status") with VInt n -> n | _ -> 0)
                         else 0) in
               let _ = run_at_exits world in exit st)
            else
            let em = (if map_has ivars (str_of_int eid ++ "@message")
                      then (match map_get ivars (str_of_int eid ++ "@message") with VStr h -> sget h | other -> to_s other)
                      else ec) in
            let _ = print_err (err_where name ++ ": " ++ em ++ " (" ++ ec ++ ")") in
            let _ = run_at_exits world in exit 1)
         | _ ->
           (let m = (if map_has prim_missing "i"
                     then (match map_get prim_missing "i" with VStr h -> sget h | _ -> "mere-ruby: failed")
                     else "mere-ruby: failed") in
            let _ = print_err (if str_eq (err_where name) name then m else err_where name ++ ": " ++ m) in exit 1)) in
      (if print_result && cursor == gc_total then
        (match lastv with
         | VObj id ->
           let cls = map_get ocls id in
           if has_meth world cls "to_s" then
             (match invoke world noblk (VObj id) cls "to_s" Nil with VStr sh -> let s2 = sget sh in print_no_nl s2 | other -> print_no_nl (to_s other))
           else print_no_nl (to_s (VObj id))
         // a collection is printed by INSPECTING it, elements and all, which
         // needs the world (see puts_one_nonl): the world-free to_s named every
         // object in it "#<object>".
         | VArr _ -> print_no_nl (inspect_w gc_cenv0 world lastv)
         | VHsh _ -> print_no_nl (inspect_w gc_cenv0 world lastv)
         | v -> print_no_nl (to_s v))
      else ()) in
  gc_drive 0 VNil;


let run_prog = fn (path: str) -> fn (print_result: bool) ->
  run_src (read_file path) print_result path;

// consume CLI flags (--enable/--disable-frozen-string-literal), returning the
// remaining args with those flags removed (mutating cli_fsl as a side effect).
let rec take_flags = fn (argl: str list) ->
  match argl with
  | Nil -> Nil
  | Cons (a, rest) ->
    if str_eq a "--enable-frozen-string-literal" then let _ = map_set cli_fsl "on" "1" in take_flags rest
    else if str_eq a "--disable-frozen-string-literal" then let _ = (if map_has cli_fsl "on" then map_delete cli_fsl "on" else ()) in take_flags rest
    // -I<dir> / -I <dir>: prepend to $LOAD_PATH, in the order given.
    else if str_len a > 2 && str_eq (substring a 0 2) "-I" then
      let _ = add_inc (substring a 2 (str_len a)) in take_flags rest
    else if str_eq a "-I" then
      (match rest with
       | Cons (d, rest2) -> let _ = add_inc d in take_flags rest2
       | Nil -> Nil)
    // -v / --version: print the version. ruby's -v also sets $VERBOSE and
    // carries on to the script, so this does not stop parsing: `-v FILE` runs
    // FILE, and a bare `-v` exits 0 because no script follows it.
    else if str_eq a "-v" || str_eq a "--version" then
      let _ = map_set cli_opt "ver" "1" in take_flags rest
    else if str_eq a "-h" || str_eq a "--help" then
      let _ = map_set cli_opt "help" "1" in take_flags rest
    // -e CODE / -eCODE: run CODE instead of a script file. Repeated -e join
    // with "\n" -- they are LINES OF ONE PROGRAM, not separate programs, which
    // is why `-e 'a = 1' -e 'puts a'` has to see one scope.
    else if str_eq a "-e" then
      (match rest with
       | Cons (code, rest2) ->
         let pre = (if map_has cli_opt "eval" then map_get cli_opt "eval" ++ "\n" else "") in
         let _ = map_set cli_opt "eval" (pre ++ code) in take_flags rest2
       | Nil -> let _ = map_set cli_opt "bad" "-e" in Nil)
    else if str_len a > 2 && str_eq (substring a 0 2) "-e" then
      let pre = (if map_has cli_opt "eval" then map_get cli_opt "eval" ++ "\n" else "") in
      let _ = map_set cli_opt "eval" (pre ++ substring a 2 (str_len a)) in take_flags rest
    // The two long flags run_cli owns: hand them back untouched rather than
    // letting the unrecognised-option arm below claim them.
    else if str_eq a "--parse-only" || str_eq a "--eval-print" then Cons (a, rest)
    // `--` ends option parsing; everything after is the script and its ARGV.
    else if str_eq a "--" then rest
    // An unrecognised -option is an ERROR, not a filename. Before this it fell
    // through to read_file, which reported `-v` as a missing file: that names
    // the symptom and hides the cause.
    else if str_len a > 1 && str_eq (substring a 0 1) "-" then
      let _ = map_set cli_opt "bad" a in Nil
    // ★ Any other argument ENDS option parsing, as it does for ruby. Scanning
    // the whole list (what this did before) meant `mere-ruby foo.rb -Ilib` ate
    // -Ilib as an interpreter flag instead of passing it to foo.rb in ARGV.
    else Cons (a, rest);

// `mere-ruby --parse-only FILE`: read and parse, run nothing. A parse error is
// the one failure that takes a WHOLE file with it, so it is worth being able
// to ask about it in isolation -- over a few thousand files, without executing
// any of them. Exit 0 = parsed, 1 = did not.
let parse_only = fn (path: str) ->
  let src = read_file path in
  let _ = map_set load_ctx "parsing" (mkstr path) in
  let toks = number_nls src (lex_go src 0) in
  let _ = parse_line_reset (count_nls toks) in
  let (prog, rest) = parse_stmts toks Nil in
  let _ = rx_check_pending () in
  match rest with
  | Cons (TEOF, _) -> 0
  | _ ->
    let _ = print_err ("mere-ruby: unexpected token at top level" ++ parsing_file ()) in 1;

let run_cli = fn () ->
  let argl = take_flags (args ()) in
  // An unrecognised option is reported and nothing runs: continuing would run
  // a DIFFERENT program than the one that was asked for.
  if map_has cli_opt "bad" then
    let _ = print_err ("mere-ruby: invalid option " ++ map_get cli_opt "bad" ++ "  (-h will show valid options)") in 1
  else if map_has cli_opt "help" then let _ = print usage_line in 0
  else
  // -v prints before the program runs, like ruby's does.
  let _ = (if map_has cli_opt "ver" then print ruby_desc else ()) in
  if map_has cli_opt "eval" then
    // -e wins over a script path, and the remaining args are ARGV. __FILE__ is
    // "-e", which is what ruby reports.
    let _ = map_set cli_file "p" "-e" in
    let _ = map_set cli_argv "v" (arr_new (strs_to_vals argl)) in
    let _ = run_src (map_get cli_opt "eval") false "-e" in 0
  else
  match argl with
  | Nil ->
    // Browser playground entry (mere v0.1.127 Wasm target): the wasm host
    // makes `read_file` of this sentinel return the editor's Ruby source, so
    // the page can drive mere-ruby without argv (args () is always [] on the
    // Wasm backend). On native the file does not exist, read_file fails, and
    // try_or falls back to "" -- so a bare `mere-ruby` still prints usage.
    let src = try_or (fn () -> read_file "@mere-ruby-playground@") "" in
    if str_eq src "" then
      // A bare `mere-ruby` deliberately does NOT read stdin, though ruby does.
      // read_stdin blocks until EOF, so a gate (or a person) that runs the
      // binary with no arguments and no input would HANG rather than fail, and
      // a hanging gate is worse than a failing one. `-` asks for stdin
      // explicitly and is the form a pipeline writes anyway.
      (if map_has cli_opt "ver" then 0 else let _ = print usage_line in 2)
    else let _ = run_src src false "(playground)" in 0
  | Cons (a0, rest) ->
    if str_eq a0 "--parse-only" then
      (match rest with
       | Cons (path, _) -> parse_only path
       | Nil -> let _ = print "usage: mere-ruby --parse-only <script.rb>" in 2)
    else if str_eq a0 "--eval-print" then
      (match rest with
       | Cons (path, rest2) -> let _ = map_set cli_file "p" path in let _ = map_set cli_argv "v" (arr_new (strs_to_vals rest2)) in let _ = run_prog path true in 0
       | Nil -> let _ = print "usage: mere-ruby --eval-print <script.rb>" in 2)
    // `-` reads the program from stdin, as it does for ruby.
    else if str_eq a0 "-" then
      let _ = map_set cli_file "p" "-" in
      let _ = map_set cli_argv "v" (arr_new (strs_to_vals rest)) in
      let _ = run_src (read_stdin ()) false "-" in 0
    else let _ = map_set cli_file "p" a0 in let _ = map_set cli_argv "v" (arr_new (strs_to_vals rest)) in let _ = run_prog a0 false in 0;
