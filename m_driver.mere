           Cons (("msg", ENil), Cons (("receiver:", ENil), Cons (("key:", ENil), Nil))),
           Cons (SIVarAssign ("message", EVar "msg"),
             Cons (SIVarAssign ("__recv", EVar "receiver"),
               Cons (SIVarAssign ("__key", EVar "key"), Nil))))) in
  let _ = set_meth meths "KeyError#receiver" (Meth (Nil, Nil, Cons (SExpr (EIVar "__recv"), Nil))) in
  let _ = set_meth meths "KeyError#key" (Meth (Nil, Nil, Cons (SExpr (EIVar "__key"), Nil))) in
  let _ = set_meth meths "FrozenError#initialize"
    (Meth (Cons ("msg", Cons ("receiver:", Nil)),
           Cons (("msg", ENil), Cons (("receiver:", ENil), Nil)),
           Cons (SIVarAssign ("message", EVar "msg"),
             Cons (SIVarAssign ("__recv", EVar "receiver"), Nil)))) in
  let _ = set_meth meths "FrozenError#receiver" (Meth (Nil, Nil, Cons (SExpr (EIVar "__recv"), Nil))) in
