  let _ = map_set sup "Class" "Module" in
  let _ = map_set sup "Module" "Object" in
  let _ = map_set sup "Integer" "Numeric" in
  let _ = map_set sup "Float" "Numeric" in
  // Float constants (INFINITY/NAN built from float division; the bounds are
