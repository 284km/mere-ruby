  let _ = set_meth meths "UncaughtThrowError#value" (Meth (Nil, Nil, Cons (SExpr (EIVar "__value"), Nil))) in
  let _ = map_set sup "StandardError" "Exception" in
  let _ = map_set sup "RuntimeError" "StandardError" in
  let _ = map_set sup "ArgumentError" "StandardError" in
  let _ = map_set sup "TypeError" "StandardError" in
  let _ = map_set sup "RangeError" "StandardError" in
  let _ = map_set sup "IndexError" "StandardError" in
  let _ = map_set sup "KeyError" "IndexError" in
  let _ = map_set sup "ZeroDivisionError" "StandardError" in
  let _ = map_set sup "NotImplementedError" "ScriptError" in
  let _ = map_set sup "EncodingError" "StandardError" in
  let _ = map_set sup "RegexpError" "StandardError" in
  let _ = map_set sup "Encoding::UndefinedConversionError" "EncodingError" in
  let _ = map_set sup "Encoding::CompatibilityError" "EncodingError" in
  let _ = map_set sup "NameError" "StandardError" in
  let _ = map_set sup "NoMethodError" "NameError" in
  let _ = map_set sup "StopIteration" "IndexError" in
  let _ = map_set sup "FrozenError" "RuntimeError" in
  let _ = map_set sup "ScriptError" "Exception" in
  let _ = map_set sup "SyntaxError" "ScriptError" in
  let _ = map_set sup "LoadError" "ScriptError" in
  let _ = map_set sup "IOError" "StandardError" in
  let _ = map_set sup "SystemCallError" "StandardError" in
  // File IS an IO in ruby, and rexml reopens `class File < IO`: without the
  // relation registered that reopening is a superclass mismatch.
  let _ = map_set sup "File" "IO" in
  let _ = map_set sup "Errno::ENOENT" "SystemCallError" in
  let _ = map_set sup "Errno::ECONNREFUSED" "SystemCallError" in
  let _ = map_set sup "Errno::ECONNRESET" "SystemCallError" in
  let _ = map_set sup "Errno::EADDRINUSE" "SystemCallError" in
  let _ = map_set sup "Errno::EPIPE" "SystemCallError" in
  let _ = map_set sup "Errno::EAGAIN" "SystemCallError" in
