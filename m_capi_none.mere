// No C side: what m_capi_api.mere declares, as functions that do nothing.
// A build with no native extensions (the Wasm source tree) has this file in
// that one's place. mr_capi_probe answers 0 for every file, so `require`
// never takes a library for a feature and no call into C is attempted; the
// rest are here for the names.
type CapiReq = { op: int, a: int, b: int, c: int, d: int, e: int };
type CapiWord = { w: int };
type CapiRet = { w: int, raised: int };
let mr_capi_enter = fn (a0: (CapiReq -> int)) -> fn (a1: CapiReq) -> CapiRet { w = 4, raised = 0 };
let mr_capi_get = fn (a0: int) -> CapiWord { w = 0 };
let mr_capi_set = fn (a0: int) -> fn (a1: CapiWord) -> 0;
let mr_capi_bytes = fn (a0: unit) -> bytes_of_str "";
let mr_capi_give = fn (a0: bytes) -> 0;
let mr_capi_give_str = fn (a0: str) -> fn (a1: CapiWord) -> 0;
let mr_capi_text = fn (a0: unit) -> "";
let mr_capi_say = fn (a0: str) -> 0;
let mr_capi_dbl = fn (a0: unit) -> 0.0;
let mr_capi_set_dbl = fn (a0: float) -> 0;
let mr_capi_intern = fn (a0: str) -> 0;
let mr_capi_id_name = fn (a0: int) -> "";
let mr_capi_intern_bytes = fn (a0: bytes) -> 0;
let mr_capi_id_bytes = fn (a0: int) -> bytes_of_str "";
let mr_capi_id_len = fn (a0: int) -> 0;
let mr_capi_booted = fn (a0: unit) -> 0;
let mr_capi_clear_errinfo = fn (a0: unit) -> 0;
let mr_capi_set_global = fn (a0: int) -> fn (a1: CapiWord) -> 0;
let mr_capi_flonum = fn (a0: float) -> CapiWord { w = 0 };
let mr_capi_flonum_value = fn (a0: CapiWord) -> 0.0;
let mr_capi_enc_index = fn (a0: str) -> 0;
let mr_capi_raise = fn (a0: CapiWord) -> 0;
let mr_capi_probe = fn (a0: str) -> 0;
let mr_capi_open = fn (a0: str) -> 0 - 1;
let mr_capi_static_open = fn (a0: str) -> 0 - 1;
let mr_capi_roots = fn (a0: (int -> int)) -> 0;
let mr_capi_mark = fn (a0: (int -> int)) -> fn (a1: int) -> 0;
let mr_capi_release = fn (a0: int) -> 0;
let mr_capi_gc_reader = fn (a0: (CapiReq -> int)) -> 0;
let mr_capi_data_name = fn (a0: int) -> "\001";
let mr_capi_depth = fn (a0: unit) -> 0;
let mr_capi_stat = fn (a0: int) -> 0;
let mr_capi_switch = fn (a0: int) -> fn (a1: int) -> 0;
let mr_capi_stack_end = fn (a0: int) -> 0;
let mr_capi_reserve = fn (a0: int) -> fn (a1: CapiWord) -> fn (a2: int) -> 0;
let mr_capi_layout = fn (a0: int) -> 0;
let mr_capi_str_layout = fn (a0: int) -> fn (a1: int) -> fn (a2: CapiWord) -> fn (a3: int) -> CapiWord { w = 0 };
let mr_capi_exe = fn (a0: unit) -> "";
