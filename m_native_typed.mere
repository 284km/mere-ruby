// Borrowed VALUE tokens for TypedData. Values are roots only while a native
// invocation is active, or when a live owner's dmark explicitly visits them.
// The owner index holds object ids, never Ruby values, and is not a GC root.
let native_typed_values = map_new ();
let _ = map_compact native_typed_values;
let native_typed_active = map_new ();
let native_typed_marked = map_new ();
let native_typed_owners = map_new ();
// Allocator method ids contain no Ruby values.
let native_allocators = map_new ();
let native_typed_counter = vec_new ();
let _ = vec_push native_typed_counter 1;
let _ = vec_push native_typed_counter 0;
let native_typed_keep = fn (v: Val) ->
  let token = vec_get native_typed_counter 0 in
  if token > native_handle_max then 0 else
    let _ = vec_set native_typed_counter 0 (token + 1) in
    let _ = map_set native_typed_values token v in
    let _ = map_set native_typed_active token 1 in token;
let native_typed_get = fn (token: int) ->
  if map_has native_typed_values token then map_get native_typed_values token
  else fail "invalid or expired typed VALUE";
let native_typed_end = fn (token: int) -> map_delete native_typed_active token;
let native_typed_compact = fn (u: unit) ->
  let _ = map_compact native_typed_values in
  let _ = map_compact native_typed_active in
  let _ = map_compact native_typed_marked in
  let _ = map_compact native_allocators in map_compact native_typed_owners;

let native_typed_bytes = fn (u: unit) ->
  map_bytes native_typed_values + map_bytes native_typed_active
  + map_bytes native_typed_marked + map_bytes native_typed_owners + map_bytes native_allocators;
