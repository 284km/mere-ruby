// parse.y's tree, as m_ast.mere builds it: the nodes RubyVM::AbstractSyntaxTree
// answers, laid out flat the way m_prism_dec.mere lays out Prism's.
//
// The nodes are kept in parse.y's OWN shape -- a LIST is a chain of cells, a
// BLOCK a chain of statements, each with the fields rubyparser.h gives it --
// and not in the shape #children shows. That is what lets m_ast.mere be
// parse.y's actions replayed (list_append, block_append, arg_append ... are
// ported as they are, with the locations they move), and #children is then
// ast.c's node_children, ported below as ao_children.
//
// ao_n  the nodes. A record is type (parse.y's enum node_type, ao_names),
//       the offsets it starts and ends at in the source, where its other
//       locations are in ao_x (0: it has only its own), then its fields
//       (a_f / a_set), which are by type:
//         a node           its record's offset; 0 is NULL, -1 one of parse.y's
//                          NODE_SPECIAL_* markers (which one, the field says)
//         an ID            an index in ao_s; 0 is no ID, -2 an internal
//                          variable that has no name
//         a literal        an offset into ao_l
//         a list           an offset into ao_a (SCOPE's table, UNDEF's names)
//         a number, a flag themselves
//       The fields of each type are listed at ao_children.
// ao_a  the lists: a count, then that many children (see below).
// ao_s  the strings: Symbol names, String and Regexp sources.
// ao_l  the literals, by kind:
//         1 Integer    sign (1: negative), the offset of its words in pm_ig
//         2 Float      the bits, high word then low
//         3 Rational   the numerator's and the denominator's offsets in pm_ig
//         4 imaginary  the literal that is the imaginary part
//         5 String     its index in ao_s, its encoding (ao_enc_*)
//         6 Regexp     its source's index in ao_s, its options, its encoding
//         7 Encoding   its name's index in ao_s
// ao_x  the other locations a node answers in #locations after its own: a
//       count, then that many start/end pairs (-1 -1: nil).
// ao_k  what ao_children answers: the children of one node, each one integer
//       with a tag in its low three bits:
//         0  nil                         4  a literal: an offset into ao_l
//         1  a node: its record's offset 5  false (0) / true (1)
//         2  a Symbol: an index in ao_s  6  an Array: an offset into ao_a
//         3  an Integer that is no literal (ARGS' counts)
let ao_n = vec_new ();
let ao_a = vec_new ();
let ao_s = vec_new ();
let ao_l = vec_new ();
let ao_x = vec_new ();
let ao_k = vec_new ();
// (a constant pool index -> its name in ao_s, 0 until asked for)
let ao_cs = vec_new ();

let ao_reset = fn (u: unit) ->
  let _ = vec_recycle ao_n in
  let _ = vec_recycle ao_a in
  let _ = vec_recycle ao_s in
  let _ = vec_recycle ao_l in
  let _ = vec_recycle ao_x in
  let _ = vec_recycle ao_k in
  let _ = vec_recycle ao_cs in
  // (offset 0 is "none" everywhere)
  let _ = vec_push ao_n 0 in
  let _ = vec_push ao_a 0 in
  let _ = vec_push ao_s "" in
  let _ = vec_push ao_l 0 in
  let _ = vec_push ao_x 0 in
  let rec go = fn (i: int) -> if i <= 0 then () else (let _ = vec_push ao_cs 0 in go (i - 1)) in
  go (vec_len pm_cp);

// ---- node types: parse.y's enum node_type, in its order ---------------------
let ao_type_names = fn (u: unit) ->
  "SCOPE BLOCK IF UNLESS CASE CASE2 CASE3 WHEN IN WHILE UNTIL ITER FOR FOR_MASGN BREAK NEXT REDO RETRY BEGIN RESCUE "
  ++ "RESBODY ENSURE AND OR MASGN LASGN DASGN GASGN IASGN CDECL CVASGN OP_ASGN1 OP_ASGN2 OP_ASGN_AND OP_ASGN_OR OP_CDECL "
  ++ "CALL OPCALL FCALL VCALL QCALL SUPER ZSUPER LIST ZLIST HASH RETURN YIELD LVAR DVAR GVAR IVAR CONST CVAR NTH_REF "
  ++ "BACK_REF MATCH MATCH2 MATCH3 INTEGER FLOAT RATIONAL IMAGINARY STR DSTR XSTR DXSTR EVSTR REGX DREGX ONCE ARGS "
  ++ "ARGS_AUX OPT_ARG KW_ARG POSTARG ARGSCAT ARGSPUSH SPLAT BLOCK_PASS DEFN DEFS ALIAS VALIAS UNDEF CLASS MODULE SCLASS "
  ++ "COLON2 COLON3 DOT2 DOT3 FLIP2 FLIP3 SELF NIL TRUE FALSE ERRINFO DEFINED POSTEXE SYM DSYM ATTRASGN LAMBDA ARYPTN "
  ++ "HSHPTN FNDPTN ERROR LINE FILE ENCODING";
let nt_scope = fn (u: unit) -> 0;
let nt_block = fn (u: unit) -> 1;
let nt_if = fn (u: unit) -> 2;
let nt_unless = fn (u: unit) -> 3;
let nt_case = fn (u: unit) -> 4;
let nt_case2 = fn (u: unit) -> 5;
let nt_case3 = fn (u: unit) -> 6;
let nt_when = fn (u: unit) -> 7;
let nt_in = fn (u: unit) -> 8;
let nt_while = fn (u: unit) -> 9;
let nt_until = fn (u: unit) -> 10;
let nt_iter = fn (u: unit) -> 11;
let nt_for = fn (u: unit) -> 12;
let nt_for_masgn = fn (u: unit) -> 13;
let nt_break = fn (u: unit) -> 14;
let nt_next = fn (u: unit) -> 15;
let nt_redo = fn (u: unit) -> 16;
let nt_retry = fn (u: unit) -> 17;
let nt_begin = fn (u: unit) -> 18;
let nt_rescue = fn (u: unit) -> 19;
let nt_resbody = fn (u: unit) -> 20;
let nt_ensure = fn (u: unit) -> 21;
let nt_and = fn (u: unit) -> 22;
let nt_or = fn (u: unit) -> 23;
let nt_masgn = fn (u: unit) -> 24;
let nt_lasgn = fn (u: unit) -> 25;
let nt_dasgn = fn (u: unit) -> 26;
let nt_gasgn = fn (u: unit) -> 27;
let nt_iasgn = fn (u: unit) -> 28;
let nt_cdecl = fn (u: unit) -> 29;
let nt_cvasgn = fn (u: unit) -> 30;
let nt_op_asgn1 = fn (u: unit) -> 31;
let nt_op_asgn2 = fn (u: unit) -> 32;
let nt_op_asgn_and = fn (u: unit) -> 33;
let nt_op_asgn_or = fn (u: unit) -> 34;
let nt_op_cdecl = fn (u: unit) -> 35;
let nt_call = fn (u: unit) -> 36;
let nt_opcall = fn (u: unit) -> 37;
let nt_fcall = fn (u: unit) -> 38;
let nt_vcall = fn (u: unit) -> 39;
let nt_qcall = fn (u: unit) -> 40;
let nt_super = fn (u: unit) -> 41;
let nt_zsuper = fn (u: unit) -> 42;
let nt_list = fn (u: unit) -> 43;
let nt_zlist = fn (u: unit) -> 44;
let nt_hash = fn (u: unit) -> 45;
let nt_return = fn (u: unit) -> 46;
let nt_yield = fn (u: unit) -> 47;
let nt_lvar = fn (u: unit) -> 48;
let nt_dvar = fn (u: unit) -> 49;
let nt_gvar = fn (u: unit) -> 50;
let nt_ivar = fn (u: unit) -> 51;
let nt_const = fn (u: unit) -> 52;
let nt_cvar = fn (u: unit) -> 53;
let nt_nth_ref = fn (u: unit) -> 54;
let nt_back_ref = fn (u: unit) -> 55;
let nt_match = fn (u: unit) -> 56;
let nt_match2 = fn (u: unit) -> 57;
let nt_match3 = fn (u: unit) -> 58;
let nt_integer = fn (u: unit) -> 59;
let nt_float = fn (u: unit) -> 60;
let nt_rational = fn (u: unit) -> 61;
let nt_imaginary = fn (u: unit) -> 62;
let nt_str = fn (u: unit) -> 63;
let nt_dstr = fn (u: unit) -> 64;
let nt_xstr = fn (u: unit) -> 65;
let nt_dxstr = fn (u: unit) -> 66;
let nt_evstr = fn (u: unit) -> 67;
let nt_regx = fn (u: unit) -> 68;
let nt_dregx = fn (u: unit) -> 69;
let nt_once = fn (u: unit) -> 70;
let nt_args = fn (u: unit) -> 71;
let nt_opt_arg = fn (u: unit) -> 73;
let nt_kw_arg = fn (u: unit) -> 74;
let nt_postarg = fn (u: unit) -> 75;
let nt_argscat = fn (u: unit) -> 76;
let nt_argspush = fn (u: unit) -> 77;
let nt_splat = fn (u: unit) -> 78;
let nt_block_pass = fn (u: unit) -> 79;
let nt_defn = fn (u: unit) -> 80;
let nt_defs = fn (u: unit) -> 81;
let nt_alias = fn (u: unit) -> 82;
let nt_valias = fn (u: unit) -> 83;
let nt_undef = fn (u: unit) -> 84;
let nt_class = fn (u: unit) -> 85;
let nt_module = fn (u: unit) -> 86;
let nt_sclass = fn (u: unit) -> 87;
let nt_colon2 = fn (u: unit) -> 88;
let nt_colon3 = fn (u: unit) -> 89;
let nt_dot2 = fn (u: unit) -> 90;
let nt_dot3 = fn (u: unit) -> 91;
let nt_flip2 = fn (u: unit) -> 92;
let nt_flip3 = fn (u: unit) -> 93;
let nt_self = fn (u: unit) -> 94;
let nt_nil = fn (u: unit) -> 95;
let nt_true = fn (u: unit) -> 96;
let nt_false = fn (u: unit) -> 97;
let nt_errinfo = fn (u: unit) -> 98;
let nt_defined = fn (u: unit) -> 99;
let nt_postexe = fn (u: unit) -> 100;
let nt_sym = fn (u: unit) -> 101;
let nt_dsym = fn (u: unit) -> 102;
let nt_attrasgn = fn (u: unit) -> 103;
let nt_lambda = fn (u: unit) -> 104;
let nt_aryptn = fn (u: unit) -> 105;
let nt_hshptn = fn (u: unit) -> 106;
let nt_fndptn = fn (u: unit) -> 107;
let nt_error = fn (u: unit) -> 108;
let nt_line = fn (u: unit) -> 109;
let nt_file = fn (u: unit) -> 110;
let nt_encoding = fn (u: unit) -> 111;

// ---- places --------------------------------------------------------------------
// A place is an offset into the source -- or, for the few parse.y answers
// that are no offset, a line and a column written out (pos_lc): the line end
// after a comment is the column past the newline ON THAT LINE, and
// `super(...)`'s parentheses have a column moved without its line.
let pos_lc = fn (line: int) -> fn (col: int) -> 1099511627776 + line * 1048576 + col;
// The line an offset is on, counted from 0: the last line that starts at or
// before it.
let ao_line_of = fn (off: int) ->
  let rec go = fn (lo: int) -> fn (hi: int) ->
    if hi - lo <= 1 then lo
    else (let mid = (lo + hi) / 2 in
          if vec_get pm_lo mid <= off then go mid hi else go lo mid) in
  go 0 (vec_len pm_lo);
// (a place's line from 0, and its column)
let pos_line = fn (p: int) -> if p >= 1099511627776 then (p - 1099511627776) / 1048576 else ao_line_of p;
let pos_col = fn (p: int) ->
  if p >= 1099511627776 then (p - 1099511627776) % 1048576 else p - vec_get pm_lo (ao_line_of p);
// What a node answers for a place. Two things parse.y does are applied
// here, where every place passes: on the first line the columns do not
// count a byte order mark; and in the tree of a program that did not parse
// (error_tolerant), a construct whose `end` never came ends where the last
// token does -- Prism runs it to the end of the file (pm_hd 6).
let ao_place = fn (p: int) ->
  let lim = vec_get pm_hd 6 in
  if lim >= 0 && p < 1099511627776 && p > lim then lim else p;
let ao_lineno = fn (p: int) -> vec_get pm_hd 0 + pos_line (ao_place p);
let ao_column = fn (p: int) ->
  let q = ao_place p in
  let c = pos_col q in
  let bom = vec_get pm_hd 5 in
  if bom > 0 && pos_line q == 0 then (if c > bom then c - bom else 0) else c;

// ---- IDs and children ----------------------------------------------------------
// an ID by its name, and by the constant pool index that names it
let id_of = fn (s: str) ->
  let i = vec_len ao_s in
  let _ = vec_push ao_s s in
  i;
// ...and the name of a Symbol literal whose encoding is not the program's: a
// `\u` escape makes it UTF-8 and a `\x` byte that is no character makes it
// ASCII-8BIT, whatever the magic comment says (`enc`: ao_enc_utf8 or
// ao_enc_binary). The mark is the entry after the name, which no ID points at.
let id_mark_u8 = fn (u: unit) -> chr 0 ++ "U";
let id_mark_bin = fn (u: unit) -> chr 0 ++ "B";
let id_of_enc = fn (s: str) -> fn (enc: int) ->
  let i = id_of s in
  let _ = (if enc == 0 then vec_push ao_s (id_mark_u8 ())
           else if enc == 2 then vec_push ao_s (id_mark_bin ())
           else ()) in
  i;
// (the encoding an ID is marked with: "" when it is the program's)
let id_enc_mark = fn (i: int) ->
  if i + 1 >= vec_len ao_s then ""
  else (let m = vec_get ao_s (i + 1) in
        if str_len m == 2 && str_eq m (id_mark_u8 ()) then "UTF-8"
        else if str_len m == 2 && str_eq m (id_mark_bin ()) then "ASCII-8BIT"
        else "");
let id_c = fn (c: int) ->
  if c == 0 then 0
  else
    (let i = vec_get ao_cs c in
     if i != 0 then i
     else (let j = vec_len ao_s in
           let _ = vec_push ao_s (vec_get pm_cp c) in
           let _ = vec_set ao_cs c j in
           j));
// (an internal variable: in a table and as a variable's name it is nil)
let id_internal = fn (u: unit) -> 0 - 2;

let k_node = fn (r: int) -> if r <= 0 then 0 else r * 8 + 1;
let k_int = fn (i: int) -> i * 8 + 3;
let k_lit = fn (l: int) -> if l == 0 then 0 else l * 8 + 4;
let k_bool = fn (b: bool) -> if b then 13 else 5;
let k_arr = fn (a: int) -> a * 8 + 6;
// ID2SYM, and ast.c's var_name (no ID, or one with no name: nil)
let k_id = fn (i: int) -> if i <= 0 then 0 else i * 8 + 2;
let k_sym = fn (s: str) -> id_of s * 8 + 2;
let k_tag = fn (k: int) -> bit_and k 7;
let k_val = fn (k: int) -> bit_shr k 3;

// ---- nodes -------------------------------------------------------------------
let a_new = fn (ty: int) -> fn (b: int) -> fn (e: int) ->
  let r = vec_len ao_n in
  let _ = vec_push ao_n ty in
  let _ = vec_push ao_n b in
  let _ = vec_push ao_n e in
  let _ = vec_push ao_n 0 in
  r;
let n0 = fn (ty: int) -> fn (b: int) -> fn (e: int) -> a_new ty b e;
let n1 = fn (ty: int) -> fn (b: int) -> fn (e: int) -> fn (f0: int) ->
  let r = a_new ty b e in
  let _ = vec_push ao_n f0 in
  r;
let n2 = fn (ty: int) -> fn (b: int) -> fn (e: int) -> fn (f0: int) -> fn (f1: int) ->
  let r = a_new ty b e in
  let _ = vec_push ao_n f0 in
  let _ = vec_push ao_n f1 in
  r;
let n3 = fn (ty: int) -> fn (b: int) -> fn (e: int) -> fn (f0: int) -> fn (f1: int) -> fn (f2: int) ->
  let r = a_new ty b e in
  let _ = vec_push ao_n f0 in
  let _ = vec_push ao_n f1 in
  let _ = vec_push ao_n f2 in
  r;
let n4 = fn (ty: int) -> fn (b: int) -> fn (e: int) -> fn (f0: int) -> fn (f1: int) -> fn (f2: int) -> fn (f3: int) ->
  let r = a_new ty b e in
  let _ = vec_push ao_n f0 in
  let _ = vec_push ao_n f1 in
  let _ = vec_push ao_n f2 in
  let _ = vec_push ao_n f3 in
  r;
let n5 = fn (ty: int) -> fn (b: int) -> fn (e: int) -> fn (f0: int) -> fn (f1: int) -> fn (f2: int) -> fn (f3: int) -> fn (f4: int) ->
  let r = a_new ty b e in
  let _ = vec_push ao_n f0 in
  let _ = vec_push ao_n f1 in
  let _ = vec_push ao_n f2 in
  let _ = vec_push ao_n f3 in
  let _ = vec_push ao_n f4 in
  r;
let a_ty = fn (r: int) -> vec_get ao_n r;
let a_beg = fn (r: int) -> vec_get ao_n (r + 1);
let a_end = fn (r: int) -> vec_get ao_n (r + 2);
let a_f = fn (r: int) -> fn (i: int) -> vec_get ao_n (r + 4 + i);
let a_set = fn (r: int) -> fn (i: int) -> fn (v: int) -> vec_set ao_n (r + 4 + i) v;
let a_set_ty = fn (r: int) -> fn (ty: int) -> vec_set ao_n r ty;
let a_set_beg = fn (r: int) -> fn (b: int) -> vec_set ao_n (r + 1) b;
let a_set_end = fn (r: int) -> fn (e: int) -> vec_set ao_n (r + 2) e;
let a_is = fn (r: int) -> fn (ty: int) -> r > 0 && vec_get ao_n r == ty;
let rec ao_list_len = fn (ks: int list) -> fn (n: int) -> match ks with Nil -> n | Cons (_, t) -> ao_list_len t (n + 1);
let rec ao_push_all = fn v -> fn (ks: int list) ->
  match ks with Nil -> () | Cons (k, t) -> (let _ = vec_push v k in ao_push_all v t);
// (a list of children, given in order: its offset in ao_a)
let mk_arr = fn (ks: int list) ->
  let a = vec_len ao_a in
  let _ = vec_push ao_a (ao_list_len ks 0) in
  let _ = ao_push_all ao_a ks in
  a;
// a node's other locations, start/end pairs in the order #locations lists them
let a_xloc = fn (r: int) -> fn (ps: int list) ->
  let x = vec_len ao_x in
  let _ = vec_push ao_x (ao_list_len ps 0 / 2) in
  let _ = ao_push_all ao_x ps in
  let _ = vec_set ao_n (r + 3) x in
  r;

// ---- #children: ast.c's node_children ------------------------------------------
// The children of node `r` into ao_k (emptied first), as #children lists
// them. The fields of each type, in a_f's order, are the comment on its arm.
let ao_children = fn (r: int) ->
  let _ = vec_recycle ao_k in
  let ty = a_ty r in
  let pn = fn (i: int) -> vec_push ao_k (k_node (a_f r i)) in
  let pid = fn (i: int) -> vec_push ao_k (k_id (a_f r i)) in
  let plit = fn (i: int) -> vec_push ao_k (k_lit (a_f r i)) in
  let special = fn (name: str) -> vec_push ao_k (k_sym name) in
  // BLOCK: head, next, end -- the statements of the chain
  if ty == 1 then
    (let rec go = fn (c: int) ->
       (let _ = vec_push ao_k (k_node (a_f c 0)) in
        let nx = a_f c 1 in
        if nx > 0 && a_ty nx == 1 then go nx
        else if nx > 0 then vec_push ao_k (k_node nx) else ()) in
     go r)
  // IF, UNLESS: cond, body, else.  WHEN, IN: head, body, next
  // RESCUE: head, resq, else.  CLASS: cpath, super, body
  else if ty == 2 || ty == 3 || ty == 7 || ty == 8 || ty == 19 || ty == 85 then
    (let _ = pn 0 in let _ = pn 1 in pn 2)
  // CASE, CASE2, CASE3: head, body.  ITER, FOR: iter, body
  // ENSURE: head, ensr.  MATCH3: recv, value.  ARGSCAT, ARGSPUSH, BLOCK_PASS: head, body
  // ALIAS: 1st, 2nd.  MODULE: cpath, body.  SCLASS: recv, body
  // DOT2, DOT3, FLIP2, FLIP3: beg, end.  OPT_ARG, KW_ARG: body, next
  else if ty == 4 || ty == 5 || ty == 6 || ty == 11 || ty == 12 || ty == 21 || ty == 58 || ty == 76 || ty == 77
          || ty == 79 || ty == 82 || ty == 86 || ty == 87 || (ty >= 90 && ty <= 93) || ty == 73 || ty == 74 then
    (let _ = pn 0 in pn 1)
  // WHILE, UNTIL: cond, body, state
  else if ty == 9 || ty == 10 then
    (let _ = pn 0 in let _ = pn 1 in vec_push ao_k (k_bool (a_f r 2 != 0)))
  // FOR_MASGN: var.  BREAK, NEXT, RETURN: stts.  BEGIN: body.  SUPER: args
  // HASH: head.  YIELD: head.  ONCE, EVSTR, POSTEXE, LAMBDA: body.  SPLAT, DEFINED: head
  else if ty == 13 || ty == 14 || ty == 15 || ty == 46 || ty == 18 || ty == 41 || ty == 45 || ty == 47
          || ty == 70 || ty == 67 || ty == 100 || ty == 104 || ty == 78 || ty == 99 then pn 0
  // REDO, RETRY, ZSUPER, ZLIST, SELF, NIL, TRUE, FALSE, ERRINFO, ERROR: nothing
  else if ty == 16 || ty == 17 || ty == 42 || ty == 44 || (ty >= 94 && ty <= 98) || ty == 108 then ()
  // RESBODY: args, exc_var, body, next
  else if ty == 20 then (let _ = pn 0 in let _ = pn 1 in let _ = pn 2 in pn 3)
  // AND, OR: 1st, 2nd -- a chain of the same operator is one list
  else if ty == 22 || ty == 23 then
    (let rec go = fn (c: int) ->
       (let _ = vec_push ao_k (k_node (a_f c 0)) in
        let nx = a_f c 1 in
        if nx > 0 && a_ty nx == ty then go nx else vec_push ao_k (k_node nx)) in
     go r)
  // MASGN: value, head, args (-1: an unnamed rest)
  else if ty == 24 then
    (let _ = pn 0 in
     let _ = pn 1 in
     if a_f r 2 == 0 - 1 then special "NODE_SPECIAL_NO_NAME_REST" else pn 2)
  // LASGN, DASGN: vid, value (-1: a required keyword)
  else if ty == 25 || ty == 26 then
    (let _ = pid 0 in
     if a_f r 1 == 0 - 1 then special "NODE_SPECIAL_REQUIRED_KEYWORD" else pn 1)
  // GASGN, IASGN, CVASGN: vid, value
  else if ty == 27 || ty == 28 || ty == 30 then (let _ = pid 0 in pn 1)
  // CDECL: vid, value, else (the COLON2 / COLON3 a scoped constant is written to)
  else if ty == 29 then
    (if a_f r 0 != 0 then (let _ = pid 0 in pn 1)
     else (let _ = pn 2 in
           let c = a_f r 2 in
           // (COLON2's mid is its field 1, COLON3's its field 0)
           let _ = vec_push ao_k (k_id (if a_ty c == 88 then a_f c 1 else a_f c 0)) in
           pn 1))
  // OP_ASGN1: recv, mid, index, rvalue
  else if ty == 31 then (let _ = pn 0 in let _ = pid 1 in let _ = pn 2 in pn 3)
  // OP_ASGN2: recv, aid (a flag: &.), vid, mid, value
  else if ty == 32 then
    (let _ = pn 0 in
     let _ = vec_push ao_k (k_bool (a_f r 1 != 0)) in
     let _ = pid 2 in
     let _ = pid 3 in
     pn 4)
  // OP_ASGN_AND, OP_ASGN_OR: head, value
  else if ty == 33 then (let _ = pn 0 in let _ = special "&&" in pn 1)
  else if ty == 34 then (let _ = pn 0 in let _ = special "||" in pn 1)
  // OP_CDECL: head, aid, value
  else if ty == 35 then (let _ = pn 0 in let _ = pid 1 in pn 2)
  // CALL, OPCALL, QCALL, ATTRASGN: recv, mid, args.  DEFS: recv, mid, defn
  else if ty == 36 || ty == 37 || ty == 40 || ty == 103 || ty == 81 then (let _ = pn 0 in let _ = pid 1 in pn 2)
  // FCALL: mid, args.  DEFN: mid, defn
  else if ty == 38 || ty == 80 then (let _ = pid 0 in pn 1)
  // VCALL: mid.  LVAR, DVAR: vid (var_name).  GVAR, IVAR, CONST, CVAR: vid.  COLON3: mid
  else if ty == 39 || (ty >= 48 && ty <= 53) || ty == 89 then pid 0
  // LIST: head, next, alen, end -- the elements, then what ends the chain
  else if ty == 43 then
    (let rec go = fn (c: int) ->
       (let _ = vec_push ao_k (k_node (a_f c 0)) in
        let nx = a_f c 1 in
        if nx > 0 && a_ty nx == 43 then go nx else vec_push ao_k (k_node nx)) in
     go r)
  // NTH_REF: nth.  BACK_REF: the character
  else if ty == 54 then vec_push ao_k (k_sym ("$" ++ str_of_int (a_f r 0)))
  else if ty == 55 then vec_push ao_k (k_sym ("$" ++ chr (a_f r 0)))
  // MATCH, STR, XSTR, INTEGER, FLOAT, RATIONAL, IMAGINARY, REGX, FILE, ENCODING: the literal
  else if ty == 56 || ty == 63 || ty == 65 || (ty >= 59 && ty <= 62) || ty == 68 || ty == 110 || ty == 111 then plit 0
  // MATCH2: recv, value, args
  else if ty == 57 then
    (let _ = pn 0 in let _ = pn 1 in if a_f r 2 > 0 then pn 2 else ())
  // DSTR, DXSTR, DREGX, DSYM: the leading string, next (a LIST)
  else if ty == 64 || ty == 66 || ty == 69 || ty == 102 then
    (let _ = plit 0 in
     let nx = a_f r 1 in
     if nx > 0 then (let _ = vec_push ao_k (k_node (a_f nx 0)) in vec_push ao_k (k_node (a_f nx 1)))
     else (let _ = vec_push ao_k 0 in vec_push ao_k 0))
  // SYM: the name
  else if ty == 101 then pid 0
  // POSTARG: 1st (-1: an unnamed rest), 2nd
  else if ty == 75 then
    (let _ = (if a_f r 0 == 0 - 1 then special "NODE_SPECIAL_NO_NAME_REST" else pn 0) in pn 1)
  // ARGS: pre_num, pre_init, opt_args, first_post, post_num, post_init,
  //       rest (-1: an excessive comma), no_kwarg, kw_args, kw_rest, block
  else if ty == 71 then
    (let _ = vec_push ao_k (k_int (a_f r 0)) in
     let _ = pn 1 in
     let _ = pn 2 in
     let _ = pid 3 in
     let _ = vec_push ao_k (k_int (a_f r 4)) in
     let _ = pn 5 in
     let _ = (if a_f r 6 == 0 - 1 then special "NODE_SPECIAL_EXCESSIVE_COMMA" else pid 6) in
     let _ = (if a_f r 7 != 0 then vec_push ao_k (k_bool false) else pn 8) in
     let _ = (if a_f r 7 != 0 then vec_push ao_k (k_bool false) else pn 9) in
     pid 10)
  // SCOPE: tbl, args, body
  else if ty == 0 then
    (let _ = vec_push ao_k (k_arr (a_f r 0)) in let _ = pn 1 in pn 2)
  // VALIAS: alias, orig
  else if ty == 83 then (let _ = pid 0 in pid 1)
  // UNDEF: the names (a list of nodes)
  else if ty == 84 then vec_push ao_k (k_arr (a_f r 0))
  // COLON2: head, mid
  else if ty == 88 then (let _ = pn 0 in pid 1)
  // ARYPTN: pconst, pre_args, rest (-1: unnamed), post_args
  else if ty == 105 then
    (let _ = pn 0 in
     let _ = pn 1 in
     let _ = (if a_f r 2 == 0 - 1 then special "NODE_SPECIAL_NO_NAME_REST" else pn 2) in
     pn 3)
  // HSHPTN: pconst, pkwargs, pkwrestarg (-1: **nil)
  else if ty == 106 then
    (let _ = pn 0 in
     let _ = pn 1 in
     if a_f r 2 == 0 - 1 then special "NODE_SPECIAL_NO_REST_KEYWORD" else pn 2)
  // FNDPTN: pconst, pre_rest (-1: unnamed), args, post_rest (-1: unnamed)
  else if ty == 107 then
    (let _ = pn 0 in
     let _ = (if a_f r 1 == 0 - 1 then special "NODE_SPECIAL_NO_NAME_REST" else pn 1) in
     let _ = pn 2 in
     if a_f r 3 == 0 - 1 then special "NODE_SPECIAL_NO_NAME_REST" else pn 3)
  // LINE: the line it is on
  else if ty == 109 then vec_push ao_k (k_int (vec_get pm_hd 0 + ao_line_of (a_beg r)))
  else ();

// ---- literals ----------------------------------------------------------------
let ao_enc_utf8 = fn (u: unit) -> 0;
let ao_enc_ascii = fn (u: unit) -> 1;
let ao_enc_binary = fn (u: unit) -> 2;
// (the program's own encoding, when it is none of the three: pm_st[0])
let ao_enc_source = fn (u: unit) -> 3;
let ao_enc_eucjp = fn (u: unit) -> 4;
let ao_enc_sjis = fn (u: unit) -> 5;
let ao_enc_name = fn (e: int) ->
  if e == 0 then "UTF-8" else if e == 1 then "US-ASCII" else if e == 2 then "ASCII-8BIT"
  else if e == 4 then "EUC-JP" else if e == 5 then "Windows-31J" else vec_get pm_st 0;
let lit_int = fn (neg: int) -> fn (ig: int) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 1 in
  let _ = vec_push ao_l neg in
  let _ = vec_push ao_l ig in
  l;
let lit_float = fn (hi: int) -> fn (lo: int) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 2 in
  let _ = vec_push ao_l hi in
  let _ = vec_push ao_l lo in
  l;
let lit_rational = fn (num: int) -> fn (den: int) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 3 in
  let _ = vec_push ao_l num in
  let _ = vec_push ao_l den in
  l;
let lit_imaginary = fn (inner: int) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 4 in
  let _ = vec_push ao_l inner in
  l;
let lit_str = fn (s: str) -> fn (enc: int) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 5 in
  let _ = vec_push ao_l (vec_len ao_s) in
  let _ = vec_push ao_s s in
  let _ = vec_push ao_l enc in
  l;
let lit_regx = fn (s: str) -> fn (opts: int) -> fn (enc: int) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 6 in
  let _ = vec_push ao_l (vec_len ao_s) in
  let _ = vec_push ao_s s in
  let _ = vec_push ao_l opts in
  let _ = vec_push ao_l enc in
  l;
let lit_encoding = fn (name: str) ->
  let l = vec_len ao_l in
  let _ = vec_push ao_l 7 in
  let _ = vec_push ao_l (vec_len ao_s) in
  let _ = vec_push ao_s name in
  l;
