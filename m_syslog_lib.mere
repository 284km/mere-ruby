// GENERATED by tools/gen_syslog_lib.rb from syslog 0.3.0's lib/
// and lib/syslog_ext.rb -- do not edit. Answered by syslog_lib_src,
// which do_require asks after bigdecimal_lib_src.

let syslog_lib_src = fn (name: str) ->
  let n = (if ends_with_rb name then substring name 0 (str_len name - 3) else name) in
  if str_eq n "syslog_ext" then
    "# frozen_string_literal: true\n" ++
    "#\n" ++
    "# Syslog's C half, written in Ruby for mere-ruby.\n" ++
    "#\n" ++
    "# The reference's `require \"syslog\"` reads the gem's syslog.rb, which requires\n" ++
    "# 'syslog_ext' -- the C extension (ext/syslog/syslog.c, syslog 0.3.0).\n" ++
    "# mere-ruby cannot load a C extension, so this file is what 'syslog_ext' is\n" ++
    "# here: the Syslog module, its constants and macros, and the state the C keeps\n" ++
    "# in statics. openlog(3), syslog(3), closelog(3) and setlogmask(3) are the\n" ++
    "# runtime's (Mere v0.1.677), reached through Syslog.__openlog and friends.\n" ++
    "# syslog(3) takes a format and varargs, which no extern can pass; the runtime\n" ++
    "# calls it with \"%s\" and the message, as syslog.c itself does.\n" ++
    "\n" ++
    "module Syslog\n" ++
    "  VERSION = \"0.3.0\"\n" ++
    "\n" ++
    "  module Option\n" ++
    "    LOG_PID = 0x01\n" ++
    "    LOG_CONS = 0x02\n" ++
    "    LOG_ODELAY = 0x04\n" ++
    "    LOG_NDELAY = 0x08\n" ++
    "    LOG_NOWAIT = 0x10\n" ++
    "    LOG_PERROR = 0x20\n" ++
    "  end\n" ++
    "\n" ++
    "  # (the facilities both macOS and glibc define; syslog.c guards each one,\n" ++
    "  # and neither has LOG_CONSOLE, LOG_NTP or LOG_SECURITY)\n" ++
    "  module Facility\n" ++
    "    LOG_KERN = 0 << 3\n" ++
    "    LOG_USER = 1 << 3\n" ++
    "    LOG_MAIL = 2 << 3\n" ++
    "    LOG_DAEMON = 3 << 3\n" ++
    "    LOG_AUTH = 4 << 3\n" ++
    "    LOG_SYSLOG = 5 << 3\n" ++
    "    LOG_LPR = 6 << 3\n" ++
    "    LOG_NEWS = 7 << 3\n" ++
    "    LOG_UUCP = 8 << 3\n" ++
    "    LOG_CRON = 9 << 3\n" ++
    "    LOG_AUTHPRIV = 10 << 3\n" ++
    "    LOG_FTP = 11 << 3\n" ++
    "    LOG_LOCAL0 = 16 << 3\n" ++
    "    LOG_LOCAL1 = 17 << 3\n" ++
    "    LOG_LOCAL2 = 18 << 3\n" ++
    "    LOG_LOCAL3 = 19 << 3\n" ++
    "    LOG_LOCAL4 = 20 << 3\n" ++
    "    LOG_LOCAL5 = 21 << 3\n" ++
    "    LOG_LOCAL6 = 22 << 3\n" ++
    "    LOG_LOCAL7 = 23 << 3\n" ++
    "  end\n" ++
    "\n" ++
    "  module Level\n" ++
    "    LOG_EMERG = 0\n" ++
    "    LOG_ALERT = 1\n" ++
    "    LOG_CRIT = 2\n" ++
    "    LOG_ERR = 3\n" ++
    "    LOG_WARNING = 4\n" ++
    "    LOG_NOTICE = 5\n" ++
    "    LOG_INFO = 6\n" ++
    "    LOG_DEBUG = 7\n" ++
    "  end\n" ++
    "\n" ++
    "  # NUM2INT: an Integer, a Float truncated, or #to_int -- not a String\n" ++
    "  def self.__num2int(v)\n" ++
    "    return v if v.is_a?(Integer)\n" ++
    "    return v.to_i if v.is_a?(Float)\n" ++
    "    raise TypeError, \"no implicit conversion from nil to integer\" if v.nil?\n" ++
    "    raise TypeError, \"no implicit conversion of #\{v == true || v == false ? v : v.class\} into Integer\" unless v.respond_to?(:to_int)\n" ++
    "    v.to_int\n" ++
    "  end\n" ++
    "\n" ++
    "  module Macros\n" ++
    "    def LOG_MASK(pri) = 1 << Syslog.__num2int(pri)\n" ++
    "    def LOG_UPTO(pri) = (1 << (Syslog.__num2int(pri) + 1)) - 1\n" ++
    "\n" ++
    "    def self.included(target)\n" ++
    "      target.extend(Macros)\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  module Constants\n" ++
    "    include Option\n" ++
    "    include Facility\n" ++
    "    include Level\n" ++
    "    include Macros\n" ++
    "\n" ++
    "    def self.included(target)\n" ++
    "      target.extend(Macros)\n" ++
    "      self\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  include Constants\n" ++
    "\n" ++
    "  # syslog.c's statics\n" ++
    "  @__opened = false\n" ++
    "  @__ident = nil\n" ++
    "  @__options = -1\n" ++
    "  @__facility = -1\n" ++
    "  @__mask = -1\n" ++
    "\n" ++
    "  module_function\n" ++
    "\n" ++
    "  def __write(pri, args)\n" ++
    "    raise ArgumentError, \"no log message supplied\" if args.empty?\n" ++
    "    raise RuntimeError, \"must open syslog before write\" unless Syslog.__opened?\n" ++
    "    Syslog.__syslog(pri, Kernel.format(*args))\n" ++
    "  end\n" ++
    "\n" ++
    "  def open(ident = nil, opt = nil, fac = nil)\n" ++
    "    raise RuntimeError, \"syslog already open\" if Syslog.__opened?\n" ++
    "    ident = $0 if ident.nil?\n" ++
    "    ident = String.try_convert(ident) or raise TypeError, \"no implicit conversion of #\{ident.nil? ? 'nil' : ident.class\} into String\"\n" ++
    "    raise ArgumentError, \"string contains null byte\" if ident.include?(\"\\0\")\n" ++
    "    options = opt.nil? ? (LOG_PID | LOG_CONS) : Syslog.__num2int(opt)\n" ++
    "    facility = fac.nil? ? LOG_USER : Syslog.__num2int(fac)\n" ++
    "    Syslog.__openlog(ident, options, facility)\n" ++
    "    Syslog.__set_state(true, ident.dup.freeze, options, facility)\n" ++
    "    # setlogmask(syslog_mask = setlogmask(0))\n" ++
    "    m = Syslog.__setlogmask(0)\n" ++
    "    Syslog.__setlogmask(m)\n" ++
    "    Syslog.__set_mask(m)\n" ++
    "    if block_given?\n" ++
    "      begin\n" ++
    "        yield Syslog\n" ++
    "      ensure\n" ++
    "        Syslog.close\n" ++
    "      end\n" ++
    "    end\n" ++
    "    Syslog\n" ++
    "  end\n" ++
    "\n" ++
    "  def reopen(*args, &block)\n" ++
    "    Syslog.close\n" ++
    "    Syslog.open(*args, &block)\n" ++
    "  end\n" ++
    "\n" ++
    "  alias open! reopen\n" ++
    "  # (the singleton's alias as well: Syslog.method(:open!) == Syslog.method(:reopen))\n" ++
    "  class << self\n" ++
    "    alias open! reopen\n" ++
    "  end\n" ++
    "\n" ++
    "  def opened? = Syslog.__opened?\n" ++
    "\n" ++
    "  def ident = Syslog.__opened? ? +Syslog.__state[0] : nil\n" ++
    "  def options = Syslog.__opened? ? Syslog.__state[1] : nil\n" ++
    "  def facility = Syslog.__opened? ? Syslog.__state[2] : nil\n" ++
    "  def mask = Syslog.__opened? ? Syslog.__state[3] : nil\n" ++
    "\n" ++
    "  def mask=(m)\n" ++
    "    raise RuntimeError, \"must open syslog before setting log mask\" unless Syslog.__opened?\n" ++
    "    v = Syslog.__num2int(m)\n" ++
    "    Syslog.__setlogmask(v)\n" ++
    "    Syslog.__set_mask(v)\n" ++
    "    m\n" ++
    "  end\n" ++
    "\n" ++
    "  def close\n" ++
    "    raise RuntimeError, \"syslog not opened\" unless Syslog.__opened?\n" ++
    "    Syslog.__closelog\n" ++
    "    Syslog.__set_state(false, nil, -1, -1)\n" ++
    "    Syslog.__set_mask(-1)\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def log(pri, *args)\n" ++
    "    raise ArgumentError, \"wrong number of arguments (given 1, expected 2+)\" if args.empty?\n" ++
    "    raise TypeError, \"type mismatch: #\{pri.class\} given\" unless pri.is_a?(Integer) && pri.bit_length < 63\n" ++
    "    Syslog.__write(pri, args)\n" ++
    "    Syslog\n" ++
    "  end\n" ++
    "\n" ++
    "  def emerg(*args) = (Syslog.__write(LOG_EMERG, args); Syslog)\n" ++
    "  def alert(*args) = (Syslog.__write(LOG_ALERT, args); Syslog)\n" ++
    "  def crit(*args) = (Syslog.__write(LOG_CRIT, args); Syslog)\n" ++
    "  def err(*args) = (Syslog.__write(LOG_ERR, args); Syslog)\n" ++
    "  def warning(*args) = (Syslog.__write(LOG_WARNING, args); Syslog)\n" ++
    "  def notice(*args) = (Syslog.__write(LOG_NOTICE, args); Syslog)\n" ++
    "  def info(*args) = (Syslog.__write(LOG_INFO, args); Syslog)\n" ++
    "  def debug(*args) = (Syslog.__write(LOG_DEBUG, args); Syslog)\n" ++
    "\n" ++
    "  def instance = Syslog\n" ++
    "\n" ++
    "  class << self\n" ++
    "    def inspect\n" ++
    "      return \"<##\{self\}: opened=false>\" unless __opened?\n" ++
    "      i, o, f, m = __state\n" ++
    "      \"<##\{self\}: opened=true, ident=\\\"#\{i\}\\\", options=#\{o\}, facility=#\{f\}, mask=#\{m\}>\"\n" ++
    "    end\n" ++
    "\n" ++
    "    def __opened? = @__opened\n" ++
    "    def __state = [@__ident, @__options, @__facility, @__mask]\n" ++
    "\n" ++
    "    def __set_state(opened, ident, options, facility)\n" ++
    "      @__opened = opened\n" ++
    "      @__ident = ident\n" ++
    "      @__options = options\n" ++
    "      @__facility = facility\n" ++
    "    end\n" ++
    "\n" ++
    "    def __set_mask(m)\n" ++
    "      @__mask = m\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "syslog" then
    "begin\n" ++
    "  require 'syslog_ext'\n" ++
    "rescue LoadError\n" ++
    "  raise LoadError.new(<<-EOS)\n" ++
    "    Can't load Syslog!\n" ++
    "\n" ++
    "    Syslog is not supported on your system. For Windows\n" ++
    "    we recommend using the win32-eventlog gem.\n" ++
    "  EOS\n" ++
    "end\n"
  else if str_eq n "syslog/logger" then
    "# frozen_string_literal: false\n" ++
    "require 'syslog'\n" ++
    "require 'logger'\n" ++
    "\n" ++
    "##\n" ++
    "# Syslog::Logger is a Logger work-alike that logs via syslog instead of to a\n" ++
    "# file.  You can use Syslog::Logger to aggregate logs between multiple\n" ++
    "# machines.\n" ++
    "#\n" ++
    "# By default, Syslog::Logger uses the program name 'ruby', but this can be\n" ++
    "# changed via the first argument to Syslog::Logger.new.\n" ++
    "#\n" ++
    "# NOTE! You can only set the Syslog::Logger program name when you initialize\n" ++
    "# Syslog::Logger for the first time.  This is a limitation of the way\n" ++
    "# Syslog::Logger uses syslog (and in some ways, a limitation of the way\n" ++
    "# syslog(3) works).  Attempts to change Syslog::Logger's program name after\n" ++
    "# the first initialization will be ignored.\n" ++
    "#\n" ++
    "# === Example\n" ++
    "#\n" ++
    "# The following will log to syslogd on your local machine:\n" ++
    "#\n" ++
    "#   require 'syslog/logger'\n" ++
    "#\n" ++
    "#   log = Syslog::Logger.new 'my_program'\n" ++
    "#   log.info 'this line will be logged via syslog(3)'\n" ++
    "#\n" ++
    "# Also the facility may be set to specify the facility level which will be used:\n" ++
    "#\n" ++
    "#   log.info 'this line will be logged using Syslog default facility level'\n" ++
    "#\n" ++
    "#   log_local1 = Syslog::Logger.new 'my_program', Syslog::LOG_LOCAL1\n" ++
    "#   log_local1.info 'this line will be logged using local1 facility level'\n" ++
    "#\n" ++
    "#\n" ++
    "# You may need to perform some syslog.conf setup first.  For a BSD machine add\n" ++
    "# the following lines to /etc/syslog.conf:\n" ++
    "#\n" ++
    "#  !my_program\n" ++
    "#  *.*                                             /var/log/my_program.log\n" ++
    "#\n" ++
    "# Then touch /var/log/my_program.log and signal syslogd with a HUP\n" ++
    "# (killall -HUP syslogd, on FreeBSD).\n" ++
    "#\n" ++
    "# If you wish to have logs automatically roll over and archive, see the\n" ++
    "# newsyslog.conf(5) and newsyslog(8) man pages.\n" ++
    "\n" ++
    "class Syslog::Logger\n" ++
    "  # Default formatter for log messages.\n" ++
    "  class Formatter\n" ++
    "    def call severity, time, progname, msg\n" ++
    "      clean msg\n" ++
    "    end\n" ++
    "\n" ++
    "    private\n" ++
    "\n" ++
    "    ##\n" ++
    "    # Clean up messages so they're nice and pretty.\n" ++
    "\n" ++
    "    def clean message\n" ++
    "      message = message.to_s.strip\n" ++
    "      message.gsub!(/\\e\\[[0-9;]*m/, '') # remove useless ansi color codes\n" ++
    "      return message\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  ##\n" ++
    "  # The version of Syslog::Logger you are using.\n" ++
    "\n" ++
    "  VERSION = '2.1.0'\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Maps Logger warning types to syslog(3) warning types.\n" ++
    "  #\n" ++
    "  # Messages from Ruby applications are not considered as critical as messages\n" ++
    "  # from other system daemons using syslog(3), so most messages are reduced by\n" ++
    "  # one level.  For example, a fatal message for Ruby's Logger is considered\n" ++
    "  # an error for syslog(3).\n" ++
    "\n" ++
    "  LEVEL_MAP = \{\n" ++
    "    ::Logger::UNKNOWN => Syslog::LOG_ALERT,\n" ++
    "    ::Logger::FATAL   => Syslog::LOG_ERR,\n" ++
    "    ::Logger::ERROR   => Syslog::LOG_WARNING,\n" ++
    "    ::Logger::WARN    => Syslog::LOG_NOTICE,\n" ++
    "    ::Logger::INFO    => Syslog::LOG_INFO,\n" ++
    "    ::Logger::DEBUG   => Syslog::LOG_DEBUG,\n" ++
    "  \}\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Returns the internal Syslog object that is initialized when the\n" ++
    "  # first instance is created.\n" ++
    "\n" ++
    "  def self.syslog\n" ++
    "    @@syslog\n" ++
    "  end\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Specifies the internal Syslog object to be used.\n" ++
    "\n" ++
    "  def self.syslog= syslog\n" ++
    "    @@syslog = syslog\n" ++
    "  end\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Builds a methods for level +meth+.\n" ++
    "\n" ++
    "  def self.make_methods meth\n" ++
    "    level = ::Logger.const_get(meth.upcase)\n" ++
    "    eval <<-EOM, nil, __FILE__, __LINE__ + 1\n" ++
    "      def #\{meth\}(message = nil, &block)\n" ++
    "        add(#\{level\}, message, &block)\n" ++
    "      end\n" ++
    "\n" ++
    "      def #\{meth\}?\n" ++
    "        level <= #\{level\}\n" ++
    "      end\n" ++
    "    EOM\n" ++
    "  end\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: unknown\n" ++
    "  #\n" ++
    "  # Logs a +message+ at the unknown (syslog alert) log level, or logs the\n" ++
    "  # message returned from the block.\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: fatal\n" ++
    "  #\n" ++
    "  # Logs a +message+ at the fatal (syslog err) log level, or logs the message\n" ++
    "  # returned from the block.\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: error\n" ++
    "  #\n" ++
    "  # Logs a +message+ at the error (syslog warning) log level, or logs the\n" ++
    "  # message returned from the block.\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: warn\n" ++
    "  #\n" ++
    "  # Logs a +message+ at the warn (syslog notice) log level, or logs the\n" ++
    "  # message returned from the block.\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: info\n" ++
    "  #\n" ++
    "  # Logs a +message+ at the info (syslog info) log level, or logs the message\n" ++
    "  # returned from the block.\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: debug\n" ++
    "  #\n" ++
    "  # Logs a +message+ at the debug (syslog debug) log level, or logs the\n" ++
    "  # message returned from the block.\n" ++
    "\n" ++
    "  Logger::Severity::constants.each do |severity|\n" ++
    "    make_methods severity.downcase\n" ++
    "  end\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Log level for Logger compatibility.\n" ++
    "\n" ++
    "  attr_accessor :level\n" ++
    "\n" ++
    "  # Logging formatter, as a +Proc+ that will take four arguments and\n" ++
    "  # return the formatted message. The arguments are:\n" ++
    "  #\n" ++
    "  # +severity+:: The Severity of the log message.\n" ++
    "  # +time+:: A Time instance representing when the message was logged.\n" ++
    "  # +progname+:: The #progname configured, or passed to the logger method.\n" ++
    "  # +msg+:: The _Object_ the user passed to the log message; not necessarily a\n" ++
    "  #         String.\n" ++
    "  #\n" ++
    "  # The block should return an Object that can be written to the logging\n" ++
    "  # device via +write+.  The default formatter is used when no formatter is\n" ++
    "  # set.\n" ++
    "  attr_accessor :formatter\n" ++
    "\n" ++
    "  ##\n" ++
    "  # The facility argument is used to specify what type of program is logging the message.\n" ++
    "\n" ++
    "  attr_accessor :facility\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Fills in variables for Logger compatibility.  If this is the first\n" ++
    "  # instance of Syslog::Logger, +program_name+ may be set to change the logged\n" ++
    "  # program name. The +facility+ may be set to specify the facility level which will be used.\n" ++
    "  #\n" ++
    "  # Due to the way syslog works, only one program name may be chosen.\n" ++
    "\n" ++
    "  def initialize program_name = 'ruby', facility = nil\n" ++
    "    @level = ::Logger::DEBUG\n" ++
    "    @formatter = Formatter.new\n" ++
    "\n" ++
    "    @@syslog ||= Syslog.open(program_name)\n" ++
    "\n" ++
    "    @facility = (facility || @@syslog.facility)\n" ++
    "  end\n" ++
    "\n" ++
    "  ##\n" ++
    "  # Almost duplicates Logger#add.  +progname+ is ignored.\n" ++
    "\n" ++
    "  def add severity, message = nil, progname = nil, &block\n" ++
    "    severity ||= ::Logger::UNKNOWN\n" ++
    "    level <= severity and\n" ++
    "      @@syslog.log( (LEVEL_MAP[severity] | @facility), '%s', formatter.call(severity, Time.now, progname, (message || block.call)) )\n" ++
    "    true\n" ++
    "  end\n" ++
    "end\n"
  else "";
