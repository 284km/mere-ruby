  "    #\n" ++
  "    #   ---\n" ++
  "    #   - !str \"foo\"\n" ++
  "    #   - &anchor fun\n" ++
  "    #   - many\n" ++
  "    #     lines\n" ++
  "    #   - |\n" ++
  "    #     many\n" ++
  "    #     newlines\n" ++
  "    #\n" ++
  "    # The above YAML document contains a list with four strings.  Here are\n" ++
