  "    # +style+.\n" ++
  "    #\n" ++
  "    # === Example\n" ++
  "    #\n" ++
  "    # Here is a YAML document that exercises most of the possible ways this\n" ++
  "    # method can be called:\n" ++
  "    #\n" ++
  "    #   ---\n" ++
  "    #   - !!seq [\n" ++
  "    #     a\n" ++
  "    #   ]\n" ++
  "    #   - &pewpew\n" ++
  "    #     - b\n" ++
  "    #\n" ++
  "    # The above YAML document consists of three lists, an outer list that\n" ++
  "    # contains two inner lists.  Here is a matrix of the parameters sent\n" ++
  "    # to represent these lists:\n" ++
  "    #\n" ++
  "    #   # anchor    tag                       implicit  style\n" ++
  "    #   [nil,       nil,                      true,     1     ]\n" ++
  "    #   [nil,       \"tag:yaml.org,2002:seq\",  false,    2     ]\n" ++
  "    #   [\"pewpew\",  nil,                      true,     1     ]\n" ++
  "\n" ++
  "    def start_sequence anchor, tag, implicit, style\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called when a sequence ends.\n" ++
  "    def end_sequence\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called when a map starts.\n" ++
  "    #\n" ++
  "    # +anchor+ is the anchor associated with the map or +nil+.\n" ++
  "    # +tag+ is the tag associated with the map or +nil+.\n" ++
  "    # +implicit+ is a boolean indicating whether or not the map was implicitly\n" ++
  "    # started.\n" ++
  "    # +style+ is an integer indicating the mapping style.\n" ++
  "    #\n" ++
  "    # See the constants in Psych::Nodes::Mapping for the possible values of\n" ++
  "    # +style+.\n" ++
  "    #\n" ++
  "    # === Example\n" ++
  "    #\n" ++
  "    # Here is a YAML document that exercises most of the possible ways this\n" ++
  "    # method can be called:\n" ++
  "    #\n" ++
  "    #   ---\n" ++
  "    #   k: !!map \{ hello: world \}\n" ++
  "    #   v: &pewpew\n" ++
  "    #     hello: world\n" ++
  "    #\n" ++
  "    # The above YAML document consists of three maps, an outer map that contains\n" ++
  "    # two inner maps.  Below is a matrix of the parameters sent in order to\n" ++
  "    # represent these three maps:\n" ++
  "    #\n" ++
  "    #   # anchor    tag                       implicit  style\n" ++
  "    #   [nil,       nil,                      true,     1     ]\n" ++
  "    #   [nil,       \"tag:yaml.org,2002:map\",  false,    2     ]\n" ++
  "    #   [\"pewpew\",  nil,                      true,     1     ]\n" ++
  "\n" ++
  "    def start_mapping anchor, tag, implicit, style\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called when a map ends\n" ++
  "    def end_mapping\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called when an empty event happens. (Which, as far as I can tell, is\n" ++
  "    # never).\n" ++
  "    def empty\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called when the YAML stream ends\n" ++
  "    def end_stream\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called before each event with line/column information.\n" ++
  "    def event_location(start_line, start_column, end_line, end_column)\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Is this handler a streaming handler?\n" ++
  "    def streaming?\n" ++
  "      false\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# YAML event parsing has its own state; loading Ruby objects is a separate visitor.\n" ++
  "module Psych\n" ++
  "  class SyntaxError < Exception\n" ++
  "    attr_reader :file, :line, :column, :offset, :problem, :context\n" ++
  "    def initialize(file, line, column, offset, problem, context)\n" ++
  "      @file, @line, @column, @offset = file, line, column, offset\n" ++
  "      @problem, @context = problem, context\n" ++
  "      super(\"(#\{file || '<unknown>'\}): #\{[problem, context].compact.join(' ')\} at line #\{line\} column #\{column\}\")\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  class Parser\n" ++
  "    ANY = 0\n" ++
  "    UTF8 = 1\n" ++
  "    UTF16LE = 2\n" ++
  "    UTF16BE = 3\n" ++
  "    Mark = Struct.new(:index, :line, :column)\n" ++
  "    ESCAPES = \{'0' => \"\\0\", 'a' => \"\\a\", 'b' => \"\\b\", 't' => \"\\t\", 'n' => \"\\n\", 'v' => \"\\v\", 'f' => \"\\f\", 'r' => \"\\r\", 'e' => \"\\e\", ' ' => ' ', '\"' => '\"', '/' => '/', '\\\\' => '\\\\', 'N' => \"\\u0085\", '_' => \"\\u00a0\", 'L' => \"\\u2028\", 'P' => \"\\u2029\"\}.freeze\n" ++
  "    PLAIN_BREAKS = [':', \"\\r\", \"\\n\", '#'].freeze\n" ++
  "    FLOW_BREAKS = [':', \"\\r\", \"\\n\", '#', ',', '[', ']', '\{', '\}'].freeze\n" ++
  "    SINGLE_BREAKS = [\"'\", \"\\n\"].freeze\n" ++
  "    DOUBLE_BREAKS = ['\"', '\\\\', \"\\n\"].freeze\n" ++
  "    private_constant :ESCAPES, :PLAIN_BREAKS, :FLOW_BREAKS, :SINGLE_BREAKS, :DOUBLE_BREAKS\n" ++
  "    attr_accessor :handler\n" ++
  "    attr_writer :external_encoding\n" ++
  "\n" ++
  "    def initialize(handler = Handler.new)\n" ++
  "      @handler = handler\n" ++
  "      @external_encoding = ANY\n" ++
  "      @mark_indices = [0, 0, 0]\n" ++
  "    end\n" ++
  "\n" ++
  "    def mark\n" ++
  "      Mark.new(*@mark_indices)\n" ++
  "    end\n" ++
  "\n" ++
  "    def parse(yaml, path = yaml.respond_to?(:path) ? yaml.path : '<unknown>')\n" ++
  "      @path, @line, @column = path, 0, 0\n" ++
  "      if yaml.respond_to?(:read)\n" ++
  "        chunks = []\n" ++
  "        while (chunk = yaml.read(16384))\n" ++
  "          chunk = __string(chunk)\n" ++
  "          break if chunk.empty?\n" ++
  "          chunks << chunk.b\n" ++
  "        end\n" ++
  "        source = chunks.join.b\n" ++
  "      else\n" ++
  "        source = __string(yaml).dup\n" ++
  "      end\n" ++
  "      encoding = @external_encoding\n" ++
  "      if encoding == UTF16LE || encoding == UTF16BE\n" ++
  "        source.force_encoding(encoding == UTF16LE ? 'UTF-16LE' : 'UTF-16BE')\n" ++
  "      elsif yaml.respond_to?(:read) || source.encoding == Encoding::ASCII_8BIT\n" ++
  "        bytes = source.byteslice(0, 4).bytes\n" ++
  "        if bytes[0, 2] == [255, 254] || (bytes[1] == 0 && bytes[3] == 0)\n" ++
  "          source.force_encoding('UTF-16LE')\n" ++
  "        elsif bytes[0, 2] == [254, 255] || (bytes[0] == 0 && bytes[2] == 0)\n" ++
  "          source.force_encoding('UTF-16BE')\n" ++
  "        else\n" ++
  "          source.force_encoding('UTF-8')\n" ++
  "        end\n" ++
  "      end\n" ++
  "      __error('invalid leading UTF-8 octet') unless source.valid_encoding?\n" ++
  "      stream_encoding = case source.encoding.name\n" ++
  "        when 'UTF-16LE' then UTF16LE\n" ++
  "        when 'UTF-16BE' then UTF16BE\n" ++
  "        else UTF8\n" ++
  "      end\n" ++
  "      source = source.encode('UTF-8') unless source.encoding == Encoding::UTF_8\n" ++
  "      # The pinned parser skips a BOM as one character in its location marks.\n" ++
  "      bom_offset = source.start_with?(\"\\uFEFF\") ? 1 : 0\n" ++
  "      source = source.sub(/\\A\\uFEFF/, '')\n" ++
  "      if (invalid = /[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]/.match(source))\n" ++
  "        prefix = source[0, invalid.begin(0)].split(\"\\n\", -1)\n" ++
  "        raise SyntaxError.new(path, [prefix.length, 1].max, (prefix.last || '').length + 1, 0, 'control characters are not allowed', nil)\n" ++
  "      end\n" ++
  "      @source, @path, @pos = source.b, path, 0\n" ++
  "      @length = @source.bytesize\n" ++
  "      @window_start = 0\n" ++
  "      @window = @source.byteslice(0, 65536)\n" ++
  "      @window_end = @window.bytesize\n" ++
  "      @index = bom_offset\n" ++
  "      @line, @column, @flow = 0, bom_offset, 0\n" ++
  "      @line_content = false\n" ++
  "      @block_indent = -1\n" ++
  "      @tokens = []\n" ++
  "      @special_positions = \{\}\n" ++
  "      @mark_indices = [0, 0, 0]\n" ++
  "      @tag_handles = \{'!!' => 'tag:yaml.org,2002:', '!' => '!'\}\n" ++
  "      __event(:start_stream, [stream_encoding], [0, 0, 0], [0, 0, 0])\n" ++
  "      __space\n" ++
  "      until __peek[0] == :eof\n" ++
  "        @block_indent = -1\n" ++
  "        version, tags = [], []\n" ++
  "        start = __peek[2]\n" ++
  "        while __peek[0] == :directive\n" ++
  "          directive = __take\n" ++
  "          text = directive[1].split\n" ++
  "          if text[0] == '%YAML'\n" ++
  "            __error('found incompatible YAML document') unless text[1] =~ /\\A1\\.[12]\\z/\n" ++
  "            version = text[1].split('.').map(&:to_i)\n" ++
  "          elsif text[0] == '%TAG'\n" ++
  "            __error('did not find expected tag directive') unless text.size == 3\n" ++
  "            tags << text[1, 2]\n" ++
  "            @tag_handles[text[1]] = text[2]\n" ++
  "          end\n" ++
  "        end\n" ++
  "        explicit = __peek[0] == :document\n" ++
  "        ending = explicit ? __take[3] : __peek[2]\n" ++
  "        __error(\"did not find expected <document start>\") if (!version.empty? || !tags.empty?) && !explicit\n" ++
  "        __event(:start_document, [version, tags, !explicit], start, ending)\n" ++
  "        if [:eof, :document, :end_document].include?(__peek[0])\n" ++
  "          __empty(__peek[2])\n" ++
  "        else\n" ++
  "          __node(-1)\n" ++
  "        end\n" ++
  "        token = __peek\n" ++
  "        __error(\"did not find expected <document start>\") unless [:eof, :document, :end_document].include?(token[0])\n" ++
  "        explicit_end = token[0] == :end_document\n" ++
  "        end_start = token[2]\n" ++
  "        end_finish = explicit_end ? __take[3] : end_start\n" ++
  "        __event(:end_document, [!explicit_end], end_start, end_finish)\n" ++
  "        @tag_handles = \{'!!' => 'tag:yaml.org,2002:', '!' => '!'\}\n" ++
  "      end\n" ++
  "      finish = __peek[2]\n" ++
  "      __event(:end_stream, [], finish, finish)\n" ++
  "      self\n" ++
  "    ensure\n" ++
  "      @source = nil\n" ++
  "      @window = nil\n" ++
  "      @tokens = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    # [index, line, column] counts Unicode characters, as libyaml marks do.\n" ++
  "    def __at\n" ++
  "      [@index, @line, @column]\n" ++
  "    end\n" ++
  "\n" ++
  "    def __string(value)\n" ++
  "      return value if value.is_a?(String)\n" ++
  "      if value.respond_to?(:to_str)\n" ++
  "        converted = value.to_str\n" ++
  "        return converted if converted.is_a?(String)\n" ++
  "      end\n" ++
  "      raise TypeError, 'no implicit conversion into String'\n" ++
  "    end\n" ++
  "\n" ++
  "    def __error(problem, mark = nil, context = 'while parsing a node')\n" ++
  "      mark ||= [0, @line, @column]\n" ++
  "      raise SyntaxError.new(@path, mark[1] + 1, mark[2] + 1, 0, problem, context)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Keep hot byte reads on a small source window. Repeated VM operations on\n" ++
  "    # a multi-megabyte String otherwise promote that entire value repeatedly.\n" ++
  "    def __char(position)\n" ++
  "      return nil if position < 0 || position >= @length\n" ++
  "      if position < @window_start || position >= @window_end\n" ++
  "        @window_start = position\n" ++
  "        @window = @source.byteslice(position, 65536)\n" ++
  "        @window_end = position + @window.bytesize\n" ++
  "      end\n" ++
  "      @window[position - @window_start]\n" ++
  "    end\n" ++
  "\n" ++
  "    def __slice(position, count)\n" ++
  "      if position >= @window_start && position + count <= @window_end\n" ++
  "        @window.byteslice(position - @window_start, count)\n" ++
  "      else\n" ++
  "        @source.byteslice(position, count)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def __index(character, from = @pos)\n" ++
  "      cursor = from\n" ++
  "      while cursor < @length\n" ++
  "        if cursor >= @window_start && cursor < @window_end\n" ++
  "          at = @window.index(character, cursor - @window_start)\n" ++
  "          return @window_start + at if at\n" ++
  "          cursor = @window_end\n" ++
  "        else\n" ++
  "          text = @source.byteslice(cursor, 65536)\n" ++
  "          at = text.index(character)\n" ++
  "          return cursor + at if at\n" ++
  "          cursor += text.bytesize\n" ++
  "        end\n" ++
  "      end\n" ++
  "      nil\n" ++
  "    end\n" ++
  "\n" ++
  "    def __advance\n" ++
  "      c = __char(@pos)\n" ++
  "      byte = c.nil? ? nil : c.ord\n" ++
  "      __error('found unexpected end of stream') unless byte\n" ++
  "      @pos += 1\n" ++
  "      if c == \"\\n\"\n" ++
  "        @line += 1\n" ++
  "        @column = 0\n" ++
  "        @line_content = false\n" ++
  "      elsif byte < 128 || byte >= 192\n" ++
  "        @column += 1\n" ++
  "      end\n" ++
  "      @index += 1 if byte < 128 || byte >= 192\n" ++
  "      @line_content = true unless c == ' ' || c == \"\\t\" || c == \"\\r\" || c == \"\\n\"\n" ++
  "      c\n" ++
  "    end\n" ++
  "\n" ++
  "    # Skip a run without line breaks in one operation. A character loop makes\n" ++
  "    # large scalars spend most of their time allocating transient Ruby strings.\n" ++
  "    def __skip(finish)\n" ++
  "      text = __slice(@pos, finish - @pos).force_encoding('UTF-8')\n" ++
  "      count = text.length\n" ++
  "      @index += count\n" ++
  "      @column += count\n" ++
  "      @line_content = true if finish > @pos\n" ++
  "      @pos = finish\n" ++
  "    end\n" ++
  "\n" ++
  "    # Cache each delimiter's next occurrence. Searching with Regexp here\n" ++
  "    # interleaves large and small subjects and defeats the VM's snapshot cache.\n" ++
  "    def __separator(characters)\n" ++
  "      finish = @length\n" ++
  "      characters.each do |character|\n" ++
  "        at = @special_positions[character]\n" ++
  "        if at.nil? || at < @pos\n" ++
  "          at = __index(character, @pos) || @length\n" ++
  "          @special_positions[character] = at\n" ++
  "        end\n" ++
  "        finish = at if at < finish\n" ++
  "      end\n" ++
  "      finish\n" ++
  "    end\n" ++
  "\n" ++
  "    def __space\n" ++
  "      loop do\n" ++
  "        c = __char(@pos)\n" ++
  "        __error('found character that cannot start any token') if c == \"\\t\" && !@line_content\n" ++
  "        if c == ' ' || c == \"\\t\" || c == \"\\r\" || c == \"\\n\"\n" ++
  "          __advance\n" ++
  "        elsif c == '#'\n" ++
  "          __skip(__index(\"\\n\", @pos) || @length)\n" ++
  "        else\n" ++
  "          break\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def __peek(n = 0)\n" ++
  "      @tokens << __scan while @tokens.length <= n\n" ++
  "      @tokens[n]\n" ++
  "    end\n" ++
  "\n" ++
  "    def __take\n" ++
  "      __peek\n" ++
  "      @tokens.shift\n" ++
  "    end\n" ++
  "\n" ++
  "    def __event(name, args, start, finish, current = finish)\n" ++
  "      @mark_indices = current\n" ++
  "      @handler.event_location(start[1], start[2], finish[1], finish[2])\n" ++
  "      if Encoding.default_internal\n" ++
  "        convert = lambda \{ |v| v.is_a?(String) ? v.encode(Encoding.default_internal) : (v.is_a?(Array) ? v.map(&convert) : v) \}\n" ++
  "        args = args.map(&convert)\n" ++
  "      end\n" ++
  "      @handler.send(name, *args)\n" ++
  "    end\n" ++
  "\n" ++
  "    def __empty(at, anchor = nil, tag = nil)\n" ++
  "      __event(:scalar, ['', anchor, tag, tag.nil?, false, 1], at, at)\n" ++
  "    end\n" ++
  "\n" ++
  "    def __scan\n" ++
  "      __space\n" ++
  "      start = __at\n" ++
  "      c = __char(@pos)\n" ++
  "      unless c\n" ++
  "        start = [@index, @column == 0 ? @line : @line + 1, 0]\n" ++
  "        return [:eof, nil, start, start, nil]\n" ++
  "      end\n" ++
  "      if @column == 0 && c == '%'\n" ++
  "        value = +''\n" ++
  "        value << __advance while @pos < @length && __char(@pos) != \"\\n\"\n" ++
  "        return [:directive, value.force_encoding('UTF-8'), start, __at, nil]\n" ++
  "      end\n" ++
  "      head = __slice(@pos, 3)\n" ++
  "      if @column == 0 && (head == '---' || head == '...') && (__char(@pos + 3).nil? || __char(@pos + 3) =~ /\\s/)\n" ++
  "        3.times \{ __advance \}\n" ++
  "        return [head == '---' ? :document : :end_document, nil, start, __at, nil]\n" ++
  "      end\n" ++
  "      punctuation = \{'[' => :sequence, ']' => :sequence_end, '\{' => :mapping, '\}' => :mapping_end, ',' => :comma\}\n" ++
  "      if punctuation.key?(c)\n" ++
  "        __advance\n" ++
  "        @flow += 1 if c == '[' || c == '\{'\n" ++
  "        @flow -= 1 if c == ']' || c == '\}'\n" ++
  "        return [punctuation[c], c, start, __at, nil]\n" ++
  "      end\n" ++
  "      if (c == '-' || c == '?' || c == ':') && (__char(@pos + 1).nil? || __char(@pos + 1) =~ /\\s/ || (@flow > 0 && c == ':'))\n" ++
  "        __advance\n" ++
  "        return [\{'-' => :entry, '?' => :key, ':' => :value\}[c], c, start, __at, nil]\n" ++
  "      end\n" ++
  "      if c == '&' || c == '*'\n" ++
  "        __advance\n" ++
  "        value = +''\n" ++
  "        while @pos < @length && __char(@pos) !~ /[\\s,\\[\\]\{\}]/\n" ++
  "          value << __advance\n" ++
  "        end\n" ++
  "        __error('did not find expected alphabetic or numeric character') if value.empty?\n" ++
  "        return [c == '&' ? :anchor : :alias, value.force_encoding('UTF-8'), start, __at, nil]\n" ++
  "      end\n" ++
  "      if c == '!'\n" ++
  "        value = +''\n" ++
  "        if __char(@pos + 1) == '<'\n" ++
  "          2.times \{ __advance \}\n" ++
  "          value << __advance while @pos < @length && __char(@pos) != '>'\n" ++
  "          __error('did not find expected >') unless __char(@pos) == '>'\n" ++
  "          __advance\n" ++
  "        else\n" ++
  "          value << __advance while @pos < @length && __char(@pos) !~ /[\\s,\\[\\]\{\}]/\n" ++
  "          if (m = /\\A(![^!]*!)(.*)\\z/.match(value))\n" ++
  "            __error('found undefined tag handle') unless @tag_handles.key?(m[1])\n" ++
  "            value = @tag_handles[m[1]] + m[2]\n" ++
  "          elsif value != '!'\n" ++
  "            value = @tag_handles['!'] + value[1..]\n" ++
  "          end\n" ++
  "        end\n" ++
  "        return [:tag, value.force_encoding('UTF-8'), start, __at, nil]\n" ++
  "      end\n" ++
  "      if c == \"'\" || c == '\"'\n" ++
  "        quote = __advance\n" ++
  "        value = []\n" ++
  "        closed = false\n" ++
  "        while @pos < @length\n" ++
  "          finish = __separator(quote == \"'\" ? SINGLE_BREAKS : DOUBLE_BREAKS)\n" ++
  "          if finish > @pos\n" ++
  "            value << __slice(@pos, finish - @pos)\n" ++
  "            __skip(finish)\n" ++
  "            next\n" ++
  "          end\n" ++
  "          c = __advance\n" ++
  "          if c == quote\n" ++
  "            if quote == \"'\" && __char(@pos) == \"'\"\n" ++
  "              value << __advance\n" ++
  "              next\n" ++
  "            end\n" ++
  "            closed = true\n" ++
  "            break\n" ++
  "          elsif c == '\\\\' && quote == '\"'\n" ++
  "            escape = __advance\n" ++
  "            table = ESCAPES\n" ++
  "            if ['x', 'u', 'U'].include?(escape)\n" ++
  "              count = \{'x' => 2, 'u' => 4, 'U' => 8\}[escape]\n" ++
  "              hex = __slice(@pos, count)\n" ++
  "              __error('did not find expected hexadecimal number') unless hex && hex.length == count && hex =~ /\\A[0-9a-fA-F]+\\z/\n" ++
  "              count.times \{ __advance \}\n" ++
  "              begin\n" ++
  "                value << [hex.to_i(16)].pack('U').b\n" ++
  "              rescue RangeError\n" ++
  "                __error('found invalid Unicode character escape code')\n" ++
  "              end\n" ++
  "            elsif escape == \"\\n\"\n" ++
  "              __advance while __char(@pos) == ' ' || __char(@pos) == \"\\t\"\n" ++
  "            elsif table.key?(escape)\n" ++
  "              value << table[escape].b\n" ++
  "            else\n" ++
  "              __error('found unknown escape character')\n" ++
  "            end\n" ++
  "          elsif c == \"\\n\"\n" ++
  "            value[-1] = value.last.rstrip unless value.empty?\n" ++
  "            count = 0\n" ++
