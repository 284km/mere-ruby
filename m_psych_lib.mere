  "\n" ++
  "      # Single quoted style\n" ++
  "      SINGLE_QUOTED = 2\n" ++
  "\n" ++
  "      # Double quoted style\n" ++
  "      DOUBLE_QUOTED = 3\n" ++
  "\n" ++
  "      # Literal style\n" ++
