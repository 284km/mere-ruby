  "        def node_for(target)\n" ++
  "          key = IDENTITY.bind(target).call\n" ++
  "          (key == 0 ? @unboxed_nodes[target] : entry_for(@obj_to_node, key, target))[1]\n" ++
  "        end\n" ++
