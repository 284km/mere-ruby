  "      def terminal o\n" ++
  "        @block.call o\n" ++
  "      end\n" ++
  "      alias :visit_Psych_Nodes_Scalar :terminal\n" ++
  "      alias :visit_Psych_Nodes_Alias  :terminal\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# vendor/psych/lib/psych/streaming.rb\n" ++
  "module Psych\n" ++
  "  module Streaming\n" ++
  "    module ClassMethods\n" ++
  "      ###\n" ++
  "      # Create a new streaming emitter.  Emitter will print to +io+.  See\n" ++
  "      # Psych::Stream for an example.\n" ++
  "      def new io\n" ++
  "        emitter      = const_get(:Emitter).new(io)\n" ++
  "        class_loader = ClassLoader.new\n" ++
  "        ss           = ScalarScanner.new class_loader\n" ++
  "        super(emitter, ss, \{\})\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Start streaming using +encoding+\n" ++
  "    def start encoding = Nodes::Stream::UTF8\n" ++
  "      super.tap \{ yield self if block_given?  \}\n" ++
  "    ensure\n" ++
  "      finish if block_given?\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "    def register target, obj\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# vendor/psych/lib/psych/coder.rb\n" ++
  "module Psych\n" ++
  "  ###\n" ++
  "  # If an object defines +encode_with+, then an instance of Psych::Coder will\n" ++
  "  # be passed to the method when the object is being serialized.  The Coder\n" ++
  "  # automatically assumes a Psych::Nodes::Mapping is being emitted.  Other\n" ++
  "  # objects like Sequence and Scalar may be emitted if +seq=+ or +scalar=+ are\n" ++
  "  # called, respectively.\n" ++
  "  class Coder\n" ++
  "    attr_accessor :tag, :style, :implicit, :object\n" ++
  "    attr_reader   :type, :seq\n" ++
  "\n" ++
  "    def initialize tag\n" ++
  "      @map      = \{\}\n" ++
  "      @seq      = []\n" ++
  "      @implicit = false\n" ++
  "      @type     = :map\n" ++
  "      @tag      = tag\n" ++
  "      @style    = Psych::Nodes::Mapping::BLOCK\n" ++
  "      @scalar   = nil\n" ++
  "      @object   = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    def scalar *args\n" ++
  "      if args.length > 0\n" ++
  "        warn \"#\{caller[0]\}: Coder#scalar(a,b,c) is deprecated\" if $VERBOSE\n" ++
  "        @tag, @scalar, _ = args\n" ++
  "        @type = :scalar\n" ++
  "      end\n" ++
  "      @scalar\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a map.  The coder will be yielded to the block.\n" ++
  "    def map tag = @tag, style = @style\n" ++
  "      @tag   = tag\n" ++
  "      @style = style\n" ++
  "      yield self if block_given?\n" ++
  "      @map\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a scalar with +value+ and +tag+\n" ++
  "    def represent_scalar tag, value\n" ++
  "      self.tag    = tag\n" ++
  "      self.scalar = value\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a sequence with +list+ and +tag+\n" ++
  "    def represent_seq tag, list\n" ++
  "      @tag = tag\n" ++
  "      self.seq = list\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a sequence with +map+ and +tag+\n" ++
  "    def represent_map tag, map\n" ++
  "      @tag = tag\n" ++
  "      self.map = map\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit an arbitrary object +obj+ and +tag+\n" ++
  "    def represent_object tag, obj\n" ++
  "      @tag    = tag\n" ++
  "      @type   = :object\n" ++
  "      @object = obj\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a scalar with +value+\n" ++
  "    def scalar= value\n" ++
  "      @type   = :scalar\n" ++
  "      @scalar = value\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a map with +value+\n" ++
  "    def map= map\n" ++
  "      @type = :map\n" ++
  "      @map  = map\n" ++
  "    end\n" ++
  "\n" ++
  "    def []= k, v\n" ++
  "      @type = :map\n" ++
  "      @map[k] = v\n" ++
  "    end\n" ++
  "    alias :add :[]=\n" ++
  "\n" ++
  "    def [] k\n" ++
  "      @type = :map\n" ++
  "      @map[k]\n" ++
  "    end\n" ++
  "\n" ++
  "    # Emit a sequence of +list+\n" ++
  "    def seq= list\n" ++
  "      @type = :seq\n" ++
  "      @seq  = list\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module Psych\n" ++
  "  class Emitter < Handler\n" ++
  "    attr_reader :indentation, :line_width\n" ++
  "    attr_accessor :canonical\n" ++
  "\n" ++
  "    def initialize(io, options = Handler::OPTIONS)\n" ++
  "      @io = io\n" ++
  "      self.indentation = options.indentation\n" ++
  "      self.line_width = options.line_width\n" ++
  "      @canonical = options.canonical\n" ++
  "      @builder = TreeBuilder.new\n" ++
  "      @state = :new\n" ++
  "    end\n" ++
  "\n" ++
  "    def indentation=(value)\n" ++
  "      n = __integer(value)\n" ++
  "      @indentation = (2..9).include?(n) ? n : 2\n" ++
  "      value\n" ++
  "    end\n" ++
  "\n" ++
  "    def line_width=(value)\n" ++
  "      @line_width = __integer(value)\n" ++
  "      value\n" ++
  "    end\n" ++
  "\n" ++
  "    def start_stream(encoding)\n" ++
  "      encoding = __integer(encoding)\n" ++
  "      raise RuntimeError, 'expected STREAM-START' unless @state == :new\n" ++
  "      raise RuntimeError, 'invalid encoding' unless (0..3).include?(encoding)\n" ++
  "      @encoding = encoding\n" ++
  "      __write(\"\\uFEFF\") if encoding == 2 || encoding == 3\n" ++
  "      @builder.start_stream(encoding)\n" ++
  "      @state = :stream\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def end_stream\n" ++
  "      raise RuntimeError, 'expected DOCUMENT-END' unless @state == :stream\n" ++
  "      @builder.end_stream\n" ++
  "      @state = :done\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def start_document(version, tags, implicit)\n" ++
  "      raise TypeError, 'version must be an Array' unless version.is_a?(Array)\n" ++
  "      version = version.map \{ |v| __integer(v) \}\n" ++
  "      raise TypeError, 'tags must be an Array' unless tags.is_a?(Array)\n" ++
  "      # Conversion can mutate the original array; iterate a stable snapshot.\n" ++
  "      tags = tags.dup.map do |pair|\n" ++
  "        raise TypeError, 'tag must be an Array' unless pair.is_a?(Array)\n" ++
  "        raise RuntimeError, 'tag tuple must be of length 2' unless pair.length == 2\n" ++
  "        pair.map \{ |v| __string(v) \}\n" ++
  "      end\n" ++
  "      raise RuntimeError, 'expected STREAM-START' unless @state == :stream\n" ++
  "      @builder.start_document(version, tags, implicit)\n" ++
  "      @state = :document\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def end_document(implicit)\n" ++
  "      raise RuntimeError, 'expected DOCUMENT-START' unless @state == :document\n" ++
  "      doc = @builder.end_document(implicit)\n" ++
  "      __write(__document(doc))\n" ++
  "      @builder.root.children.clear\n" ++
  "      @state = :stream\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def scalar(value, anchor, tag, plain, quoted, style)\n" ++
  "      value = __string(value)\n" ++
  "      anchor = __anchor(anchor) unless anchor.nil?\n" ++
  "      tag = __string(tag) unless tag.nil?\n" ++
  "      style = __integer(style)\n" ++
  "      @builder.scalar(value, anchor, tag, plain, quoted, style)\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def alias(anchor)\n" ++
  "      @builder.alias(__anchor(anchor, 'alias value'))\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def start_sequence(anchor, tag, implicit, style)\n" ++
  "      anchor = __anchor(anchor) unless anchor.nil?\n" ++
  "      tag = __string(tag) unless tag.nil?\n" ++
  "      @builder.start_sequence(anchor, tag, implicit, __integer(style))\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def end_sequence\n" ++
  "      @builder.end_sequence\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def start_mapping(anchor, tag, implicit, style)\n" ++
  "      anchor = __anchor(anchor) unless anchor.nil?\n" ++
  "      tag = __string(tag) unless tag.nil?\n" ++
  "      @builder.start_mapping(anchor, tag, implicit, __integer(style))\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    def end_mapping\n" ++
  "      @builder.end_mapping\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    def __integer(value)\n" ++
  "      value = value.to_int if value.respond_to?(:to_int)\n" ++
  "      raise TypeError, 'no implicit conversion into Integer' unless value.is_a?(Integer)\n" ++
  "      raise RangeError, 'integer too big to convert to int' if value < -2147483648 || value > 2147483647\n" ++
  "      value\n" ++
  "    end\n" ++
  "\n" ++
  "    def __string(value)\n" ++
  "      value = value.to_str if !value.is_a?(String) && value.respond_to?(:to_str)\n" ++
  "      raise TypeError, 'no implicit conversion into String' unless value.is_a?(String)\n" ++
  "      value.encoding == Encoding::UTF_8 ? value : value.encode('UTF-8')\n" ++
  "    end\n" ++
  "\n" ++
  "    def __anchor(value, kind = 'anchor value')\n" ++
  "      value = __string(value)\n" ++
  "      raise RuntimeError, \"#\{kind\} must contain alphanumerical characters only\" unless value =~ /\\A[0-9A-Za-z_-]+\\z/\n" ++
  "      value\n" ++
  "    end\n" ++
  "\n" ++
  "    def __write(text)\n" ++
  "      case @encoding\n" ++
  "      when 2 then text = text.encode('UTF-16LE')\n" ++
  "      when 3 then text = text.encode('UTF-16BE')\n" ++
  "      end\n" ++
  "      # Psych's writer labels its buffers UTF-8, including UTF-16 wire bytes.\n" ++
  "      @io.write(text.force_encoding('UTF-8'))\n" ++
  "    end\n" ++
  "\n" ++
  "    def __properties(node)\n" ++
  "      text = +''\n" ++
  "      text << \"&#\{node.anchor\} \" if node.respond_to?(:anchor) && node.anchor\n" ++
  "      if node.tag && (@canonical || (node.respond_to?(:implicit) ? !node.implicit : !(node.plain || node.quoted)))\n" ++
  "        tag = node.tag\n" ++
  "        tag = if tag.start_with?('tag:yaml.org,2002:')\n" ++
  "          '!!' + tag.delete_prefix('tag:yaml.org,2002:')\n" ++
  "        elsif tag.start_with?('!')\n" ++
  "          tag\n" ++
  "        else\n" ++
  "          \"!<#\{tag\}>\"\n" ++
  "        end\n" ++
  "        text << tag << ' '\n" ++
  "      end\n" ++
  "      text\n" ++
  "    end\n" ++
  "\n" ++
  "    def __block?(node)\n" ++
  "      (node.sequence? || node.mapping?) && node.style != 2 && !node.children.empty? && !@canonical\n" ++
  "    end\n" ++
  "\n" ++
  "    def __quote(value)\n" ++
  "      escapes = \{0 => '\\\\0', 7 => '\\\\a', 8 => '\\\\b', 9 => '\\\\t', 10 => '\\\\n', 11 => '\\\\v', 12 => '\\\\f', 13 => '\\\\r', 27 => '\\\\e', 34 => '\\\\\"', 92 => '\\\\\\\\', 133 => '\\\\N', 160 => '\\\\_', 8232 => '\\\\L', 8233 => '\\\\P'\}\n" ++
  "      body = value.gsub(/[\\x00-\\x1f\"\\\\\\x7f\\u0085\\u00a0\\u2028\\u2029]/) do |character|\n" ++
  "        c = character.ord\n" ++
  "        escapes[c] || ('\\\\x%02X' % c)\n" ++
  "      end\n" ++
  "      '\"' + body + '\"'\n" ++
  "    end\n" ++
  "\n" ++
  "    def __scalar(node, indent, flow)\n" ++
  "      value = node.value\n" ++
  "      style = node.style\n" ++
  "      style = 3 if @canonical\n" ++
  "      style = 3 if value =~ /[ \\t]\\n/\n" ++
  "      style = 3 if style <= 3 && value =~ /\\n[ \\t]/\n" ++
  "      style = 3 if value =~ /[\\x00-\\x08\\x0b-\\x1f\\x7f\\u0085\\u00a0\\u2028\\u2029]/\n" ++
  "      if style == 4 || style == 5\n" ++
  "        style = 3 if flow\n" ++
  "      end\n" ++
  "      if style == 4 || style == 5\n" ++
  "        trailing = value[/\\n*\\z/].length\n" ++
  "        indicator = style == 4 ? '|' : '>'\n" ++
  "        indicator += @indentation.to_s if value.start_with?(' ', \"\\n\", \"\\t\")\n" ++
  "        keep = trailing > 1 || (trailing > 0 && value.bytesize == trailing)\n" ++
  "        indicator += trailing == 0 ? '-' : (keep ? '+' : '')\n" ++
  "        value = __folded(value, indent) if style == 5\n" ++
  "        body = value.split(\"\\n\", -1)\n" ++
  "        body.pop if value.end_with?(\"\\n\")\n" ++
  "        text = body.map \{ |line| (line.empty? ? '' : (' ' * (indent + @indentation)) + line) + \"\\n\" \}.join\n" ++
  "        return indicator + \"\\n\" + text\n" ++
  "      end\n" ++
  "      if style == 3\n" ++
  "        return __quote(value)\n" ++
  "      end\n" ++
  "      return '' if value.empty? && node.plain && style <= 1 && !flow\n" ++
  "      unsafe = value.empty? || value.include?(\"\\n\") || value =~ /\\A[\\s\\[\\]\{\},&*!|>'\"%@`]/ || value =~ /\\A[-?:](?:\\s|\\z)/ || value.include?(': ') || value.include?(' #') || value.end_with?(':', ' ') || (flow && value =~ /[:,\\[\\]\{\}]/)\n" ++
  "      if style == 2 || unsafe || (!node.plain && !node.tag)\n" ++
  "        quoted = value.gsub(\"'\", \"''\").gsub(/\\n+/) \{ |breaks| \"\\n\" + breaks + (' ' * (indent + @indentation)) \}\n" ++
  "        return \"'\" + quoted + \"'\"\n" ++
  "      end\n" ++
  "      value\n" ++
  "    end\n" ++
  "\n" ++
  "    def __folded(value, indent)\n" ++
  "      lines = value.split(\"\\n\", -1)\n" ++
  "      out = []\n" ++
  "      n = 0\n" ++
  "      while n < lines.length\n" ++
  "        line = lines[n]\n" ++
  "        if line.empty?\n" ++
  "          out << \"\\n\" if n + 1 < lines.length\n" ++
  "          n += 1\n" ++
  "          next\n" ++
  "        end\n" ++
  "        rows = [line]\n" ++
  "        if @line_width > 0 && !line.start_with?(' ')\n" ++
  "          rows = [+'' ]\n" ++
  "          line.split(' ').each do |word|\n" ++
  "            if !rows.last.empty? && rows.last.length + indent + @indentation > @line_width\n" ++
  "              rows << word.dup\n" ++
  "            else\n" ++
  "              rows.last << ' ' unless rows.last.empty?\n" ++
  "              rows.last << word\n" ++
  "            end\n" ++
  "          end\n" ++
  "        end\n" ++
  "        out << rows.join(\"\\n\")\n" ++
  "        following = n + 1\n" ++
  "        following += 1 while following < lines.length && lines[following].empty?\n" ++
  "        count = following < lines.length ? following - n : lines.length - n - 1\n" ++
  "        if following < lines.length && !line.start_with?(' ') && !lines[following].start_with?(' ')\n" ++
  "          count += 1\n" ++
  "        end\n" ++
  "        out << \"\\n\" * count\n" ++
  "        n = following\n" ++
  "      end\n" ++
  "      out.join\n" ++
  "    end\n" ++
  "\n" ++
  "    def __content(node, indent, flow = false)\n" ++
  "      return '*' + node.anchor if node.alias?\n" ++
  "      properties = __properties(node)\n" ++
  "      if node.scalar?\n" ++
  "        content = __scalar(node, indent, flow)\n" ++
  "        if properties.empty? && node.plain && !node.quoted && (content.start_with?(\"'\", '\"', '|', '>'))\n" ++
  "          properties = '! '\n" ++
  "        end\n" ++
  "        return properties + content\n" ++
  "      end\n" ++
  "      if !__block?(node) || flow\n" ++
  "        if @canonical\n" ++
  "          pad = ' ' * indent\n" ++
  "          child_pad = pad + (' ' * @indentation)\n" ++
  "          if node.sequence?\n" ++
  "            return properties + \"[\\n\" + node.children.map \{ |v| child_pad + __content(v, indent + @indentation, true) + \",\\n\" \}.join + pad + ']'\n" ++
  "          end\n" ++
  "          pairs = node.children.each_slice(2).map do |key, value|\n" ++
  "            child_pad + '? ' + __content(key, indent + @indentation, true) + \"\\n\" + child_pad + ': ' + __content(value, indent + @indentation, true) + \",\\n\"\n" ++
  "          end\n" ++
  "          return properties + \"\{\\n\" + pairs.join + pad + '\}'\n" ++
  "        end\n" ++
  "        if node.sequence?\n" ++
  "          return properties + '[' + node.children.map \{ |v| __content(v, indent, true) \}.join(', ') + ']'\n" ++
  "        end\n" ++
  "        pairs = node.children.each_slice(2).map do |key, value|\n" ++
  "          __content(key, indent, true) + ': ' + __content(value, indent, true)\n" ++
  "        end\n" ++
  "        return properties + '\{' + pairs.join(', ') + '\}'\n" ++
  "      end\n" ++
  "      if node.sequence?\n" ++
  "        text = node.children.map do |child|\n" ++
  "          if __block?(child)\n" ++
  "            inner = __content(child, indent + @indentation)\n" ++
  "            if __properties(child).empty?\n" ++
  "              (' ' * indent) + '-' + (' ' * (@indentation - 1)) + inner[(indent + @indentation)..]\n" ++
  "            else\n" ++
  "              (' ' * indent) + '- ' + __properties(child).rstrip + \"\\n\" + inner\n" ++
  "            end\n" ++
  "          else\n" ++
  "            content = __content(child, indent)\n" ++
  "            (' ' * indent) + (content.empty? ? '-' : '- ' + content) + (content.end_with?(\"\\n\") ? '' : \"\\n\")\n" ++
  "          end\n" ++
  "        end.join\n" ++
  "      else\n" ++
  "        text = node.children.each_slice(2).map do |key, value|\n" ++
  "          prefix = ' ' * indent\n" ++
  "          if __block?(key)\n" ++
  "            props = __properties(key).rstrip\n" ++
  "            if props.empty?\n" ++
  "              content = __content(key, indent + @indentation)\n" ++
  "              prefix += '? ' + content[(indent + @indentation)..] + (' ' * indent) + ':'\n" ++
  "            else\n" ++
  "              child_indent = key.sequence? ? indent : indent + @indentation\n" ++
  "              prefix += '? ' + props + \"\\n\" + __content(key, child_indent) + (' ' * indent) + ':'\n" ++
  "            end\n" ++
  "          else\n" ++
  "            key_text = __content(key, indent)\n" ++
  "            key_text = \"! ''\" if key_text.empty?\n" ++
  "            prefix += key_text + (key.alias? ? ' :' : ':')\n" ++
  "          end\n" ++
  "          if __block?(value)\n" ++
  "            props = __properties(value).rstrip\n" ++
  "            child_indent = value.sequence? ? indent : indent + @indentation\n" ++
  "            prefix + (props.empty? ? '' : ' ' + props) + \"\\n\" + __content(value, child_indent)\n" ++
  "          else\n" ++
  "            content = __content(value, indent)\n" ++
  "            prefix + (content.empty? ? '' : ' ' + content) + (content.end_with?(\"\\n\") ? '' : \"\\n\")\n" ++
  "          end\n" ++
  "        end.join\n" ++
  "      end\n" ++
  "      text\n" ++
  "    end\n" ++
  "\n" ++
  "    def __document(doc)\n" ++
  "      text = +''\n" ++
  "      text << \"%YAML #\{doc.version.join('.')\}\\n\" unless doc.version.empty?\n" ++
  "      doc.tag_directives.each \{ |handle, prefix| text << \"%TAG #\{handle\} #\{prefix\}\\n\" \}\n" ++
  "      root = doc.root\n" ++
  "      raise RuntimeError, 'expected a document root' unless root\n" ++
  "      properties = __properties(root).rstrip\n" ++
  "      marker = !doc.implicit || !text.empty? || @canonical\n" ++
  "      if __block?(root)\n" ++
  "        text << '---' + (properties.empty? ? '' : ' ' + properties) + \"\\n\" if marker\n" ++
  "        text << __content(root, 0)\n" ++
  "      else\n" ++
  "        content = __content(root, 0)\n" ++
  "        text << (content.empty? ? '---' : (@canonical ? \"---\\n\" : '--- ')) if marker\n" ++
  "        text << content\n" ++
  "        text << \"\\n\" unless content.end_with?(\"\\n\")\n" ++
  "      end\n" ++
  "      text << \"...\\n\" unless doc.implicit_end\n" ++
  "      text\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# vendor/psych/lib/psych/stream.rb\n" ++
  "module Psych\n" ++
  "  ###\n" ++
  "  # Psych::Stream is a streaming YAML emitter.  It will not buffer your YAML,\n" ++
  "  # but send it straight to an IO.\n" ++
  "  #\n" ++
  "  # Here is an example use:\n" ++
  "  #\n" ++
  "  #   stream = Psych::Stream.new($stdout)\n" ++
  "  #   stream.start\n" ++
  "  #   stream.push(\{:foo => 'bar'\})\n" ++
  "  #   stream.finish\n" ++
  "  #\n" ++
  "  # YAML will be immediately emitted to $stdout with no buffering.\n" ++
  "  #\n" ++
  "  # Psych::Stream#start will take a block and ensure that Psych::Stream#finish\n" ++
  "  # is called, so you can do this form:\n" ++
  "  #\n" ++
  "  #   stream = Psych::Stream.new($stdout)\n" ++
  "  #   stream.start do |em|\n" ++
  "  #     em.push(:foo => 'bar')\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  class Stream < Psych::Visitors::YAMLTree\n" ++
  "    class Emitter < Psych::Emitter # :nodoc:\n" ++
  "      def end_document implicit_end = !streaming?\n" ++
  "        super\n" ++
  "      end\n" ++
  "\n" ++
  "      def streaming?\n" ++
  "        true\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    include Psych::Streaming\n" ++
  "    extend Psych::Streaming::ClassMethods\n" ++
  "  end\n" ++
  "end\n" ++
