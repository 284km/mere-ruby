  "          @emitter.end_mapping\n" ++
  "        else\n" ++
  "          visit_hash_subclass o\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Psych_Set o\n" ++
  "        register(o, @emitter.start_mapping(nil, '!set', false, Psych::Nodes::Mapping::BLOCK))\n" ++
  "\n" ++
  "        o.each do |k,v|\n" ++
  "          accept(@stringify_names && Symbol === k ? k.to_s : k)\n" ++
  "          accept v\n" ++
  "        end\n" ++
  "\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Array o\n" ++
  "        if o.class == ::Array\n" ++
  "          visit_Enumerator o\n" ++
  "        else\n" ++
  "          visit_array_subclass o\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Enumerator o\n" ++
  "        register o, @emitter.start_sequence(nil, nil, true, Nodes::Sequence::BLOCK)\n" ++
  "        o.each \{ |c| accept c \}\n" ++
  "        @emitter.end_sequence\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_NilClass o\n" ++
  "        @emitter.scalar('', nil, 'tag:yaml.org,2002:null', true, false, Nodes::Scalar::ANY)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Symbol o\n" ++
  "        if o.empty?\n" ++
  "          @emitter.scalar \"\", nil, '!ruby/symbol', false, false, Nodes::Scalar::ANY\n" ++
  "        else\n" ++
  "          @emitter.scalar \":#\{o\}\", nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_BasicObject o\n" ++
  "        tag = Psych.dump_tags[o.class]\n" ++
  "        tag ||= \"!ruby/marshalable:#\{o.class.name\}\"\n" ++
  "\n" ++
  "        map = @emitter.start_mapping(nil, tag, false, Nodes::Mapping::BLOCK)\n" ++
  "        register(o, map)\n" ++
  "\n" ++
  "        o.marshal_dump.each(&method(:accept))\n" ++
  "\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      private\n" ++
  "\n" ++
  "      def binary? string\n" ++
  "        string.encoding == Encoding::ASCII_8BIT && !string.ascii_only?\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_array_subclass o\n" ++
  "        tag = \"!ruby/array:#\{o.class\}\"\n" ++
  "        ivars = o.instance_variables\n" ++
  "        if ivars.empty?\n" ++
  "          node = @emitter.start_sequence(nil, tag, false, Nodes::Sequence::BLOCK)\n" ++
  "          register o, node\n" ++
  "          o.each \{ |c| accept c \}\n" ++
  "          @emitter.end_sequence\n" ++
  "        else\n" ++
  "          node = @emitter.start_mapping(nil, tag, false, Nodes::Sequence::BLOCK)\n" ++
  "          register o, node\n" ++
  "\n" ++
  "          # Dump the internal list\n" ++
  "          accept 'internal'\n" ++
  "          @emitter.start_sequence(nil, nil, true, Nodes::Sequence::BLOCK)\n" ++
  "          o.each \{ |c| accept c \}\n" ++
  "          @emitter.end_sequence\n" ++
  "\n" ++
  "          # Dump the ivars\n" ++
  "          accept 'ivars'\n" ++
  "          @emitter.start_mapping(nil, nil, true, Nodes::Sequence::BLOCK)\n" ++
  "          ivars.each do |ivar|\n" ++
  "            accept ivar\n" ++
  "            accept o.instance_variable_get ivar\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "\n" ++
  "          @emitter.end_mapping\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_hash_subclass o\n" ++
  "        ivars = o.instance_variables\n" ++
  "        if ivars.any?\n" ++
  "          tag = \"!ruby/hash-with-ivars:#\{o.class\}\"\n" ++
  "          node = @emitter.start_mapping(nil, tag, false, Psych::Nodes::Mapping::BLOCK)\n" ++
  "          register(o, node)\n" ++
  "\n" ++
  "          # Dump the ivars\n" ++
  "          accept 'ivars'\n" ++
  "          @emitter.start_mapping nil, nil, true, Nodes::Mapping::BLOCK\n" ++
  "          o.instance_variables.each do |ivar|\n" ++
  "            accept ivar\n" ++
  "            accept o.instance_variable_get ivar\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "\n" ++
  "          # Dump the elements\n" ++
  "          accept 'elements'\n" ++
  "          @emitter.start_mapping nil, nil, true, Nodes::Mapping::BLOCK\n" ++
  "          o.each do |k,v|\n" ++
  "            accept k\n" ++
  "            accept v\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "\n" ++
  "          @emitter.end_mapping\n" ++
  "        else\n" ++
  "          tag = \"!ruby/hash:#\{o.class\}\"\n" ++
  "          node = @emitter.start_mapping(nil, tag, false, Psych::Nodes::Mapping::BLOCK)\n" ++
  "          register(o, node)\n" ++
  "          o.each do |k,v|\n" ++
  "            accept k\n" ++
  "            accept v\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def dump_list o\n" ++
  "      end\n" ++
  "\n" ++
  "      def dump_exception o, msg\n" ++
  "        tag = ['!ruby/exception', o.class.name].join ':'\n" ++
  "\n" ++
  "        @emitter.start_mapping nil, tag, false, Nodes::Mapping::BLOCK\n" ++
  "\n" ++
  "        if msg\n" ++
  "          @emitter.scalar 'message', nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "          accept msg\n" ++
  "        end\n" ++
  "\n" ++
  "        @emitter.scalar 'backtrace', nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "        accept o.backtrace\n" ++
  "\n" ++
  "        dump_ivars o\n" ++
  "\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      def format_time time, utc = time.utc?\n" ++
  "        if utc\n" ++
  "          time.strftime(\"%Y-%m-%d %H:%M:%S.%9N Z\")\n" ++
  "        else\n" ++
  "          time.strftime(\"%Y-%m-%d %H:%M:%S.%9N %:z\")\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def format_date date\n" ++
  "        date.strftime(\"%Y-%m-%d\")\n" ++
  "      end\n" ++
  "\n" ++
  "      def register target, yaml_obj\n" ++
  "        @st.register target, yaml_obj\n" ++
  "        yaml_obj\n" ++
  "      end\n" ++
  "\n" ++
  "      def dump_coder o\n" ++
  "        @coders << o\n" ++
  "        tag = Psych.dump_tags[o.class]\n" ++
  "        unless tag\n" ++
  "          klass = o.class == Object ? nil : o.class.name\n" ++
  "          tag   = ['!ruby/object', klass].compact.join(':')\n" ++
  "        end\n" ++
  "\n" ++
  "        c = Psych::Coder.new(tag)\n" ++
  "        o.encode_with(c)\n" ++
  "        emit_coder c, o\n" ++
  "      end\n" ++
  "\n" ++
  "      def emit_coder c, o\n" ++
  "        case c.type\n" ++
  "        when :scalar\n" ++
  "          @emitter.scalar c.scalar, nil, c.tag, c.tag.nil?, false, c.style\n" ++
  "        when :seq\n" ++
  "          @emitter.start_sequence nil, c.tag, c.tag.nil?, c.style\n" ++
  "          c.seq.each do |thing|\n" ++
  "            accept thing\n" ++
  "          end\n" ++
  "          @emitter.end_sequence\n" ++
  "        when :map\n" ++
  "          register o, @emitter.start_mapping(nil, c.tag, c.implicit, c.style)\n" ++
  "          c.map.each do |k,v|\n" ++
  "            accept k\n" ++
  "            accept v\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "        when :object\n" ++
  "          accept c.object\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def dump_ivars target\n" ++
  "        target.instance_variables.each do |iv|\n" ++
  "          @emitter.scalar(\"#\{iv.to_s.sub(/^@/, '')\}\", nil, nil, true, false, Nodes::Scalar::ANY)\n" ++
  "          accept target.instance_variable_get(iv)\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class RestrictedYAMLTree < YAMLTree\n" ++
  "      DEFAULT_PERMITTED_CLASSES = \{\n" ++
  "        TrueClass => true,\n" ++
  "        FalseClass => true,\n" ++
  "        NilClass => true,\n" ++
  "        Integer => true,\n" ++
  "        Float => true,\n" ++
  "        String => true,\n" ++
  "        Array => true,\n" ++
  "        Hash => true,\n" ++
  "      \}.compare_by_identity.freeze\n" ++
  "\n" ++
  "      def initialize emitter, ss, options\n" ++
  "        super\n" ++
  "        @permitted_classes = DEFAULT_PERMITTED_CLASSES.dup\n" ++
  "        Array(options[:permitted_classes]).each do |klass|\n" ++
  "          @permitted_classes[klass] = true\n" ++
  "        end\n" ++
  "        @permitted_symbols = \{\}.compare_by_identity\n" ++
  "        Array(options[:permitted_symbols]).each do |symbol|\n" ++
  "          @permitted_symbols[symbol] = true\n" ++
  "        end\n" ++
  "        @aliases = options.fetch(:aliases, false)\n" ++
  "      end\n" ++
  "\n" ++
  "      def accept target\n" ++
  "        if !@aliases && @st.key?(target)\n" ++
  "          raise BadAlias, \"Tried to dump an aliased object\"\n" ++
  "        end\n" ++
  "\n" ++
  "        unless Symbol === target || @permitted_classes[target.class]\n" ++
  "          raise DisallowedClass.new('dump', target.class.name || target.class.inspect)\n" ++
  "        end\n" ++
  "\n" ++
  "        super\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Symbol sym\n" ++
  "        unless @permitted_classes[Symbol] || @permitted_symbols[sym]\n" ++
  "          raise DisallowedClass.new('dump', \"Symbol(#\{sym.inspect\})\")\n" ++
  "        end\n" ++
  "\n" ++
  "        super\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# vendor/psych/lib/psych/json/ruby_events.rb\n" ++
  "module Psych\n" ++
  "  module JSON\n" ++
  "    module RubyEvents # :nodoc:\n" ++
  "      def visit_Time o\n" ++
  "        formatted = format_time o\n" ++
  "        @emitter.scalar formatted, nil, nil, false, true, Nodes::Scalar::DOUBLE_QUOTED\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_DateTime o\n" ++
  "        visit_Time o.to_time\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_String o\n" ++
  "        @emitter.scalar o.to_s, nil, nil, false, true, Nodes::Scalar::DOUBLE_QUOTED\n" ++
  "      end\n" ++
  "      alias :visit_Symbol :visit_String\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# vendor/psych/lib/psych/visitors/json_tree.rb\n" ++
  "\n" ++
  "module Psych\n" ++
  "  module Visitors\n" ++
  "    class JSONTree < YAMLTree\n" ++
  "      include Psych::JSON::RubyEvents\n" ++
  "\n" ++
  "      def self.create options = \{\}\n" ++
  "        emitter = Psych::JSON::TreeBuilder.new\n" ++
  "        class_loader = ClassLoader.new\n" ++
  "        ss           = ScalarScanner.new class_loader\n" ++
  "        new(emitter, ss, options)\n" ++
  "      end\n" ++
