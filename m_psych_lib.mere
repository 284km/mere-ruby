  "    class Recorder < Psych::Handler\n" ++
  "      attr_reader :events\n" ++
  "\n" ++
  "      def initialize\n" ++
  "        @events = []\n" ++
  "        super\n" ++
  "      end\n" ++
  "\n" ++
  "      EVENTS.each do |event|\n" ++
  "        define_method event do |*args|\n" ++
  "          @events << [event, args]\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
