  "    # This handler will capture an event and record the event.  Recorder events\n" ++
  "    # are available vial Psych::Handlers::Recorder#events.\n" ++
  "    #\n" ++
  "    # For example:\n" ++
  "    #\n" ++
  "    #   recorder = Psych::Handlers::Recorder.new\n" ++
  "    #   parser = Psych::Parser.new recorder\n" ++
  "    #   parser.parse '--- foo'\n" ++
  "    #\n" ++
  "    #   recorder.events # => [list of events]\n" ++
  "    #\n" ++
  "    #   # Replay the events\n" ++
  "    #\n" ++
  "    #   emitter = Psych::Emitter.new $stdout\n" ++
  "    #   recorder.events.each do |m, args|\n" ++
  "    #     emitter.send m, *args\n" ++
  "    #   end\n" ++
