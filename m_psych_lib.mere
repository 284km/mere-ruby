  "          # Dump the members\n" ++
  "          accept 'members'\n" ++
  "          @emitter.start_mapping nil, nil, true, Nodes::Mapping::BLOCK\n" ++
  "          o.members.each do |member|\n" ++
  "            @emitter.scalar member.to_s, nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "            accept o.send member\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "\n" ++
  "          # Dump the ivars\n" ++
  "          accept 'ivars'\n" ++
  "          @emitter.start_mapping nil, nil, true, Nodes::Mapping::BLOCK\n" ++
  "          ivars.each do |ivar|\n" ++
  "            accept ivar.to_s\n" ++
  "            accept o.instance_variable_get ivar\n" ++
  "          end\n" ++
  "          @emitter.end_mapping\n" ++
  "\n" ++
  "          @emitter.end_mapping\n" ++
  "        end\n" ++
  "      end unless RUBY_VERSION < \"3.2\"\n" ++
  "\n" ++
  "      def visit_Struct o\n" ++
  "        tag = ['!ruby/struct', o.class.name].compact.join(':')\n" ++
  "\n" ++
  "        register o, @emitter.start_mapping(nil, tag, false, Nodes::Mapping::BLOCK)\n" ++
  "        o.members.each do |member|\n" ++
  "          @emitter.scalar member.to_s, nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "          accept o[member]\n" ++
  "        end\n" ++
  "\n" ++
  "        dump_ivars o\n" ++
  "\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Exception o\n" ++
  "        dump_exception o, o.message.to_s\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_NameError o\n" ++
  "        dump_exception o, o.message.to_s\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Regexp o\n" ++
  "        register o, @emitter.scalar(o.inspect, nil, '!ruby/regexp', false, false, Nodes::Scalar::ANY)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Date o\n" ++
  "        formatted = format_date o\n" ++
  "        register o, @emitter.scalar(formatted, nil, nil, true, false, Nodes::Scalar::ANY)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_DateTime o\n" ++
  "        t = o.italy\n" ++
  "        formatted = format_time t, t.offset.zero?\n" ++
  "        tag = '!ruby/object:DateTime'\n" ++
  "        register o, @emitter.scalar(formatted, nil, tag, false, false, Nodes::Scalar::ANY)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Time o\n" ++
  "        formatted = format_time o\n" ++
  "        register o, @emitter.scalar(formatted, nil, nil, true, false, Nodes::Scalar::ANY)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Rational o\n" ++
  "        register o, @emitter.start_mapping(nil, '!ruby/object:Rational', false, Nodes::Mapping::BLOCK)\n" ++
  "\n" ++
  "        [\n" ++
  "          'denominator', o.denominator.to_s,\n" ++
  "          'numerator', o.numerator.to_s\n" ++
  "        ].each do |m|\n" ++
  "          @emitter.scalar m, nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "        end\n" ++
  "\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Complex o\n" ++
  "        register o, @emitter.start_mapping(nil, '!ruby/object:Complex', false, Nodes::Mapping::BLOCK)\n" ++
  "\n" ++
  "        ['real', o.real.to_s, 'image', o.imag.to_s].each do |m|\n" ++
  "          @emitter.scalar m, nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "        end\n" ++
  "\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Integer o\n" ++
  "        @emitter.scalar o.to_s, nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "      end\n" ++
  "      alias :visit_TrueClass :visit_Integer\n" ++
  "      alias :visit_FalseClass :visit_Integer\n" ++
  "\n" ++
  "      def visit_Float o\n" ++
  "        if o.nan?\n" ++
  "          @emitter.scalar '.nan', nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "        elsif o.infinite?\n" ++
  "          @emitter.scalar((o.infinite? > 0 ? '.inf' : '-.inf'),\n" ++
  "            nil, nil, true, false, Nodes::Scalar::ANY)\n" ++
  "        else\n" ++
  "          @emitter.scalar o.to_s, nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_BigDecimal o\n" ++
  "        @emitter.scalar o._dump, nil, '!ruby/object:BigDecimal', false, false, Nodes::Scalar::ANY\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_String o\n" ++
  "        plain = true\n" ++
  "        quote = true\n" ++
  "        style = Nodes::Scalar::PLAIN\n" ++
  "        tag   = nil\n" ++
  "\n" ++
  "        if binary?(o)\n" ++
  "          o     = [o].pack('m0')\n" ++
  "          tag   = '!binary' # FIXME: change to below when syck is removed\n" ++
  "          #tag   = 'tag:yaml.org,2002:binary'\n" ++
  "          style = Nodes::Scalar::LITERAL\n" ++
  "          plain = false\n" ++
  "          quote = false\n" ++
  "        elsif o.match?(/\\n(?!\\Z)/)  # match \\n except blank line at the end of string\n" ++
  "          style = Nodes::Scalar::LITERAL\n" ++
  "        elsif o == '<<'\n" ++
  "          style = Nodes::Scalar::SINGLE_QUOTED\n" ++
  "          tag   = 'tag:yaml.org,2002:str'\n" ++
  "          plain = false\n" ++
  "          quote = false\n" ++
  "        elsif o == 'y' || o == 'Y' || o == 'n' || o == 'N'\n" ++
  "          style = Nodes::Scalar::DOUBLE_QUOTED\n" ++
  "        elsif @line_width && o.length > @line_width\n" ++
  "          style = Nodes::Scalar::FOLDED\n" ++
  "        elsif o.match?(/^[^[:word:]][^\"]*$/)\n" ++
  "          style = Nodes::Scalar::DOUBLE_QUOTED\n" ++
  "        elsif not String === @ss.tokenize(o) or /\\A0[0-7]*[89]/.match?(o)\n" ++
  "          style = Nodes::Scalar::SINGLE_QUOTED\n" ++
  "        end\n" ++
  "\n" ++
  "        is_primitive = o.class == ::String\n" ++
  "        ivars = is_primitive ? [] : o.instance_variables\n" ++
  "\n" ++
  "        if ivars.empty?\n" ++
  "          unless is_primitive\n" ++
  "            tag = \"!ruby/string:#\{o.class\}\"\n" ++
  "            plain = false\n" ++
  "            quote = false\n" ++
  "          end\n" ++
  "          @emitter.scalar o, nil, tag, plain, quote, style\n" ++
  "        else\n" ++
  "          maptag = '!ruby/string'.dup\n" ++
  "          maptag << \":#\{o.class\}\" unless o.class == ::String\n" ++
  "\n" ++
  "          register o, @emitter.start_mapping(nil, maptag, false, Nodes::Mapping::BLOCK)\n" ++
  "          @emitter.scalar 'str', nil, nil, true, false, Nodes::Scalar::ANY\n" ++
  "          @emitter.scalar o, nil, tag, plain, quote, style\n" ++
  "\n" ++
  "          dump_ivars o\n" ++
  "\n" ++
  "          @emitter.end_mapping\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Module o\n" ++
  "        raise TypeError, \"can't dump anonymous module: #\{o\}\" unless o.name\n" ++
  "        register o, @emitter.scalar(o.name, nil, '!ruby/module', false, false, Nodes::Scalar::SINGLE_QUOTED)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Class o\n" ++
  "        raise TypeError, \"can't dump anonymous class: #\{o\}\" unless o.name\n" ++
  "        register o, @emitter.scalar(o.name, nil, '!ruby/class', false, false, Nodes::Scalar::SINGLE_QUOTED)\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Range o\n" ++
  "        register o, @emitter.start_mapping(nil, '!ruby/range', false, Nodes::Mapping::BLOCK)\n" ++
  "        ['begin', o.begin, 'end', o.end, 'excl', o.exclude_end?].each do |m|\n" ++
  "          accept m\n" ++
  "        end\n" ++
  "        @emitter.end_mapping\n" ++
  "      end\n" ++
  "\n" ++
  "      def visit_Hash o\n" ++
  "        if o.class == ::Hash\n" ++
  "          register(o, @emitter.start_mapping(nil, nil, true, Psych::Nodes::Mapping::BLOCK))\n" ++
  "          o.each do |k,v|\n" ++
