  "\n" ++
  "# vendor/psych/lib/psych/visitors/depth_first.rb\n" ++
  "module Psych\n" ++
  "  module Visitors\n" ++
  "    class DepthFirst < Psych::Visitors::Visitor\n" ++
  "      def initialize block\n" ++
  "        @block = block\n" ++
  "      end\n" ++
  "\n" ++
  "      private\n" ++
  "\n" ++
  "      def nary o\n" ++
  "        o.children.each \{ |x| visit x \}\n" ++
  "        @block.call o\n" ++
  "      end\n" ++
  "      alias :visit_Psych_Nodes_Stream   :nary\n" ++
  "      alias :visit_Psych_Nodes_Document :nary\n" ++
  "      alias :visit_Psych_Nodes_Sequence :nary\n" ++
  "      alias :visit_Psych_Nodes_Mapping  :nary\n" ++
