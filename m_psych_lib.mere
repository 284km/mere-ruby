  "  module JSON\n" ++
  "    module YAMLEvents # :nodoc:\n" ++
  "      def start_document version, tag_directives, implicit\n" ++
  "        super(version, tag_directives, !streaming?)\n" ++
  "      end\n" ++
  "\n" ++
  "      def end_document implicit_end = !streaming?\n" ++
  "        super(implicit_end)\n" ++
  "      end\n" ++
  "\n" ++
  "      def start_mapping anchor, tag, implicit, style\n" ++
  "        super(anchor, nil, true, Nodes::Mapping::FLOW)\n" ++
  "      end\n" ++
  "\n" ++
  "      def start_sequence anchor, tag, implicit, style\n" ++
  "        super(anchor, nil, true, Nodes::Sequence::FLOW)\n" ++
