  "module Psych\n" ++
  "  # The version of libyaml Psych is using\n" ++
  "  LIBYAML_VERSION = Psych.libyaml_version.join('.').freeze\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Load +yaml+ in to a Ruby data structure.  If multiple documents are\n" ++
  "  # provided, the object contained in the first document will be returned.\n" ++
  "  # +filename+ will be used in the exception message if any exception\n" ++
  "  # is raised while parsing.  If +yaml+ is empty, it returns\n" ++
  "  # the specified +fallback+ return value, which defaults to +false+.\n" ++
  "  #\n" ++
  "  # Raises a Psych::SyntaxError when a YAML syntax error is detected.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.unsafe_load(\"--- a\")             # => 'a'\n" ++
  "  #   Psych.unsafe_load(\"---\\n - a\\n - b\")   # => ['a', 'b']\n" ++
  "  #\n" ++
  "  #   begin\n" ++
  "  #     Psych.unsafe_load(\"--- `\", filename: \"file.txt\")\n" ++
  "  #   rescue Psych::SyntaxError => ex\n" ++
  "  #     ex.file    # => 'file.txt'\n" ++
  "  #     ex.message # => \"(file.txt): found character that cannot start any token\"\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # When the optional +symbolize_names+ keyword argument is set to a\n" ++
  "  # true value, returns symbols for keys in Hash objects (default: strings).\n" ++
  "  #\n" ++
  "  #   Psych.unsafe_load(\"---\\n foo: bar\")                         # => \{\"foo\"=>\"bar\"\}\n" ++
  "  #   Psych.unsafe_load(\"---\\n foo: bar\", symbolize_names: true)  # => \{:foo=>\"bar\"\}\n" ++
  "  #\n" ++
  "  # Raises a TypeError when `yaml` parameter is NilClass\n" ++
  "  #\n" ++
  "  # NOTE: This method *should not* be used to parse untrusted documents, such as\n" ++
  "  # YAML documents that are supplied via user input.  Instead, please use the\n" ++
  "  # load method or the safe_load method.\n" ++
  "  #\n" ++
  "  def self.unsafe_load yaml, filename: nil, fallback: false, symbolize_names: false, freeze: false, strict_integer: false, parse_symbols: true\n" ++
  "    result = parse(yaml, filename: filename)\n" ++
  "    return fallback unless result\n" ++
  "    result.to_ruby(symbolize_names: symbolize_names, freeze: freeze, strict_integer: strict_integer, parse_symbols: parse_symbols)\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Safely load the yaml string in +yaml+.  By default, only the following\n" ++
  "  # classes are allowed to be deserialized:\n" ++
  "  #\n" ++
  "  # * TrueClass\n" ++
  "  # * FalseClass\n" ++
  "  # * NilClass\n" ++
  "  # * Integer\n" ++
  "  # * Float\n" ++
  "  # * String\n" ++
  "  # * Array\n" ++
  "  # * Hash\n" ++
  "  #\n" ++
  "  # Recursive data structures are not allowed by default.  Arbitrary classes\n" ++
  "  # can be allowed by adding those classes to the +permitted_classes+ keyword argument.  They are\n" ++
  "  # additive.  For example, to allow Date deserialization:\n" ++
  "  #\n" ++
  "  #   Psych.safe_load(yaml, permitted_classes: [Date])\n" ++
  "  #\n" ++
  "  # Now the Date class can be loaded in addition to the classes listed above.\n" ++
  "  #\n" ++
  "  # Aliases can be explicitly allowed by changing the +aliases+ keyword argument.\n" ++
  "  # For example:\n" ++
  "  #\n" ++
  "  #   x = []\n" ++
  "  #   x << x\n" ++
  "  #   yaml = Psych.dump x\n" ++
  "  #   Psych.safe_load yaml               # => raises an exception\n" ++
  "  #   Psych.safe_load yaml, aliases: true # => loads the aliases\n" ++
  "  #\n" ++
  "  # A Psych::DisallowedClass exception will be raised if the yaml contains a\n" ++
  "  # class that isn't in the +permitted_classes+ list.\n" ++
  "  #\n" ++
  "  # A Psych::AliasesNotEnabled exception will be raised if the yaml contains aliases\n" ++
  "  # but the +aliases+ keyword argument is set to false.\n" ++
  "  #\n" ++
  "  # +filename+ will be used in the exception message if any exception is raised\n" ++
  "  # while parsing.\n" ++
  "  #\n" ++
  "  # When the optional +symbolize_names+ keyword argument is set to a\n" ++
  "  # true value, returns symbols for keys in Hash objects (default: strings).\n" ++
  "  #\n" ++
  "  #   Psych.safe_load(\"---\\n foo: bar\")                         # => \{\"foo\"=>\"bar\"\}\n" ++
  "  #   Psych.safe_load(\"---\\n foo: bar\", symbolize_names: true)  # => \{:foo=>\"bar\"\}\n" ++
  "  #\n" ++
  "  def self.safe_load yaml, permitted_classes: [], permitted_symbols: [], aliases: false, filename: nil, fallback: nil, symbolize_names: false, freeze: false, strict_integer: false, parse_symbols: true\n" ++
  "    result = parse(yaml, filename: filename)\n" ++
  "    return fallback unless result\n" ++
  "\n" ++
  "    class_loader = ClassLoader::Restricted.new(permitted_classes.map(&:to_s),\n" ++
  "                                               permitted_symbols.map(&:to_s))\n" ++
  "    scanner      = ScalarScanner.new class_loader, strict_integer: strict_integer, parse_symbols: parse_symbols\n" ++
  "    visitor = if aliases\n" ++
  "                Visitors::ToRuby.new scanner, class_loader, symbolize_names: symbolize_names, freeze: freeze\n" ++
  "              else\n" ++
  "                Visitors::NoAliasRuby.new scanner, class_loader, symbolize_names: symbolize_names, freeze: freeze\n" ++
  "              end\n" ++
  "    result = visitor.accept result\n" ++
  "    result\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Load +yaml+ in to a Ruby data structure.  If multiple documents are\n" ++
  "  # provided, the object contained in the first document will be returned.\n" ++
  "  # +filename+ will be used in the exception message if any exception\n" ++
  "  # is raised while parsing.  If +yaml+ is empty, it returns\n" ++
  "  # the specified +fallback+ return value, which defaults to +nil+.\n" ++
  "  #\n" ++
  "  # Raises a Psych::SyntaxError when a YAML syntax error is detected.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.load(\"--- a\")             # => 'a'\n" ++
  "  #   Psych.load(\"---\\n - a\\n - b\")   # => ['a', 'b']\n" ++
  "  #\n" ++
  "  #   begin\n" ++
  "  #     Psych.load(\"--- `\", filename: \"file.txt\")\n" ++
  "  #   rescue Psych::SyntaxError => ex\n" ++
  "  #     ex.file    # => 'file.txt'\n" ++
  "  #     ex.message # => \"(file.txt): found character that cannot start any token\"\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # When the optional +symbolize_names+ keyword argument is set to a\n" ++
  "  # true value, returns symbols for keys in Hash objects (default: strings).\n" ++
  "  #\n" ++
  "  #   Psych.load(\"---\\n foo: bar\")                         # => \{\"foo\"=>\"bar\"\}\n" ++
  "  #   Psych.load(\"---\\n foo: bar\", symbolize_names: true)  # => \{:foo=>\"bar\"\}\n" ++
  "  #\n" ++
  "  # Raises a TypeError when `yaml` parameter is NilClass.  This method is\n" ++
  "  # similar to `safe_load` except that `Symbol` objects are allowed by default.\n" ++
  "  #\n" ++
  "  def self.load yaml, permitted_classes: [Symbol], permitted_symbols: [], aliases: false, filename: nil, fallback: nil, symbolize_names: false, freeze: false, strict_integer: false, parse_symbols: true\n" ++
  "    safe_load yaml, permitted_classes: permitted_classes,\n" ++
  "                    permitted_symbols: permitted_symbols,\n" ++
  "                    aliases: aliases,\n" ++
  "                    filename: filename,\n" ++
  "                    fallback: fallback,\n" ++
  "                    symbolize_names: symbolize_names,\n" ++
  "                    freeze: freeze,\n" ++
  "                    strict_integer: strict_integer,\n" ++
  "                    parse_symbols: parse_symbols\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Parse a YAML string in +yaml+.  Returns the Psych::Nodes::Document.\n" ++
  "  # +filename+ is used in the exception message if a Psych::SyntaxError is\n" ++
  "  # raised.\n" ++
  "  #\n" ++
  "  # Raises a Psych::SyntaxError when a YAML syntax error is detected.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.parse(\"---\\n - a\\n - b\") # => #<Psych::Nodes::Document:0x00>\n" ++
  "  #\n" ++
  "  #   begin\n" ++
  "  #     Psych.parse(\"--- `\", filename: \"file.txt\")\n" ++
  "  #   rescue Psych::SyntaxError => ex\n" ++
  "  #     ex.file    # => 'file.txt'\n" ++
  "  #     ex.message # => \"(file.txt): found character that cannot start any token\"\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # See Psych::Nodes for more information about YAML AST.\n" ++
  "  def self.parse yaml, filename: nil\n" ++
  "    parse_stream(yaml, filename: filename) do |node|\n" ++
  "      return node\n" ++
  "    end\n" ++
  "\n" ++
  "    false\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Parse a file at +filename+. Returns the Psych::Nodes::Document.\n" ++
  "  #\n" ++
  "  # Raises a Psych::SyntaxError when a YAML syntax error is detected.\n" ++
  "  def self.parse_file filename, fallback: false\n" ++
  "    result = File.open filename, 'r:bom|utf-8' do |f|\n" ++
  "      parse f, filename: filename\n" ++
  "    end\n" ++
  "    result || fallback\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Returns a default parser\n" ++
  "  def self.parser\n" ++
  "    Psych::Parser.new(TreeBuilder.new)\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Parse a YAML string in +yaml+.  Returns the Psych::Nodes::Stream.\n" ++
  "  # This method can handle multiple YAML documents contained in +yaml+.\n" ++
  "  # +filename+ is used in the exception message if a Psych::SyntaxError is\n" ++
  "  # raised.\n" ++
  "  #\n" ++
  "  # If a block is given, a Psych::Nodes::Document node will be yielded to the\n" ++
  "  # block as it's being parsed.\n" ++
  "  #\n" ++
  "  # Raises a Psych::SyntaxError when a YAML syntax error is detected.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.parse_stream(\"---\\n - a\\n - b\") # => #<Psych::Nodes::Stream:0x00>\n" ++
  "  #\n" ++
  "  #   Psych.parse_stream(\"--- a\\n--- b\") do |node|\n" ++
  "  #     node # => #<Psych::Nodes::Document:0x00>\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  #   begin\n" ++
  "  #     Psych.parse_stream(\"--- `\", filename: \"file.txt\")\n" ++
  "  #   rescue Psych::SyntaxError => ex\n" ++
  "  #     ex.file    # => 'file.txt'\n" ++
  "  #     ex.message # => \"(file.txt): found character that cannot start any token\"\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Raises a TypeError when NilClass is passed.\n" ++
  "  #\n" ++
  "  # See Psych::Nodes for more information about YAML AST.\n" ++
  "  def self.parse_stream yaml, filename: nil, &block\n" ++
  "    if block_given?\n" ++
  "      parser = Psych::Parser.new(Handlers::DocumentStream.new(&block))\n" ++
  "      parser.parse yaml, filename\n" ++
  "    else\n" ++
  "      parser = self.parser\n" ++
  "      parser.parse yaml, filename\n" ++
  "      parser.handler.root\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # call-seq:\n" ++
  "  #   Psych.dump(o)               -> string of yaml\n" ++
  "  #   Psych.dump(o, options)      -> string of yaml\n" ++
  "  #   Psych.dump(o, io)           -> io object passed in\n" ++
  "  #   Psych.dump(o, io, options)  -> io object passed in\n" ++
  "  #\n" ++
  "  # Dump Ruby object +o+ to a YAML string.  Optional +options+ may be passed in\n" ++
  "  # to control the output format.  If an IO object is passed in, the YAML will\n" ++
  "  # be dumped to that IO object.\n" ++
  "  #\n" ++
  "  # Currently supported options are:\n" ++
  "  #\n" ++
  "  # [<tt>:indentation</tt>]   Number of space characters used to indent.\n" ++
  "  #                           Acceptable value should be in <tt>0..9</tt> range,\n" ++
  "  #                           otherwise option is ignored.\n" ++
  "  #\n" ++
  "  #                           Default: <tt>2</tt>.\n" ++
  "  # [<tt>:line_width</tt>]    Max character to wrap line at.\n" ++
  "  #                           For unlimited line width use <tt>-1</tt>.\n" ++
  "  #\n" ++
  "  #                           Default: <tt>0</tt> (meaning \"wrap at 81\").\n" ++
  "  # [<tt>:canonical</tt>]     Write \"canonical\" YAML form (very verbose, yet\n" ++
  "  #                           strictly formal).\n" ++
  "  #\n" ++
  "  #                           Default: <tt>false</tt>.\n" ++
  "  # [<tt>:header</tt>]        Write <tt>%YAML [version]</tt> at the beginning of document.\n" ++
  "  #\n" ++
  "  #                           Default: <tt>false</tt>.\n" ++
  "  #\n" ++
  "  # [<tt>:stringify_names</tt>] Dump symbol keys in Hash objects as string.\n" ++
  "  #\n" ++
  "  #                             Default: <tt>false</tt>.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   # Dump an array, get back a YAML string\n" ++
  "  #   Psych.dump(['a', 'b'])  # => \"---\\n- a\\n- b\\n\"\n" ++
  "  #\n" ++
  "  #   # Dump an array to an IO object\n" ++
  "  #   Psych.dump(['a', 'b'], StringIO.new)  # => #<StringIO:0x000001009d0890>\n" ++
  "  #\n" ++
  "  #   # Dump an array with indentation set\n" ++
  "  #   Psych.dump(['a', ['b']], indentation: 3) # => \"---\\n- a\\n-  - b\\n\"\n" ++
  "  #\n" ++
  "  #   # Dump an array to an IO with indentation set\n" ++
  "  #   Psych.dump(['a', ['b']], StringIO.new, indentation: 3)\n" ++
  "  #\n" ++
  "  #   # Dump hash with symbol keys as string\n" ++
  "  #   Psych.dump(\{a: \"b\"\}, stringify_names: true) # => \"---\\na: b\\n\"\n" ++
  "  def self.dump o, io = nil, options = \{\}\n" ++
  "    if Hash === io\n" ++
  "      options = io\n" ++
  "      io      = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    visitor = Psych::Visitors::YAMLTree.create options\n" ++
  "    visitor << o\n" ++
  "    visitor.tree.yaml io, options\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # call-seq:\n" ++
  "  #   Psych.safe_dump(o)               -> string of yaml\n" ++
  "  #   Psych.safe_dump(o, options)      -> string of yaml\n" ++
  "  #   Psych.safe_dump(o, io)           -> io object passed in\n" ++
  "  #   Psych.safe_dump(o, io, options)  -> io object passed in\n" ++
  "  #\n" ++
  "  # Safely dump Ruby object +o+ to a YAML string. Optional +options+ may be passed in\n" ++
  "  # to control the output format.  If an IO object is passed in, the YAML will\n" ++
  "  # be dumped to that IO object. By default, only the following\n" ++
  "  # classes are allowed to be serialized:\n" ++
  "  #\n" ++
  "  # * TrueClass\n" ++
  "  # * FalseClass\n" ++
  "  # * NilClass\n" ++
  "  # * Integer\n" ++
  "  # * Float\n" ++
  "  # * String\n" ++
  "  # * Array\n" ++
  "  # * Hash\n" ++
  "  #\n" ++
  "  # Arbitrary classes can be allowed by adding those classes to the +permitted_classes+\n" ++
  "  # keyword argument.  They are additive.  For example, to allow Date serialization:\n" ++
  "  #\n" ++
  "  #   Psych.safe_dump(yaml, permitted_classes: [Date])\n" ++
  "  #\n" ++
  "  # Now the Date class can be dumped in addition to the classes listed above.\n" ++
  "  #\n" ++
  "  # A Psych::DisallowedClass exception will be raised if the object contains a\n" ++
  "  # class that isn't in the +permitted_classes+ list.\n" ++
  "  #\n" ++
  "  # Currently supported options are:\n" ++
  "  #\n" ++
  "  # [<tt>:indentation</tt>]   Number of space characters used to indent.\n" ++
  "  #                           Acceptable value should be in <tt>0..9</tt> range,\n" ++
  "  #                           otherwise option is ignored.\n" ++
  "  #\n" ++
  "  #                           Default: <tt>2</tt>.\n" ++
  "  # [<tt>:line_width</tt>]    Max character to wrap line at.\n" ++
  "  #                           For unlimited line width use <tt>-1</tt>.\n" ++
  "  #\n" ++
  "  #                           Default: <tt>0</tt> (meaning \"wrap at 81\").\n" ++
  "  # [<tt>:canonical</tt>]     Write \"canonical\" YAML form (very verbose, yet\n" ++
  "  #                           strictly formal).\n" ++
  "  #\n" ++
  "  #                           Default: <tt>false</tt>.\n" ++
  "  # [<tt>:header</tt>]        Write <tt>%YAML [version]</tt> at the beginning of document.\n" ++
  "  #\n" ++
  "  #                           Default: <tt>false</tt>.\n" ++
  "  #\n" ++
  "  # [<tt>:stringify_names</tt>] Dump symbol keys in Hash objects as string.\n" ++
  "  #\n" ++
  "  #                             Default: <tt>false</tt>.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   # Dump an array, get back a YAML string\n" ++
  "  #   Psych.safe_dump(['a', 'b'])  # => \"---\\n- a\\n- b\\n\"\n" ++
  "  #\n" ++
  "  #   # Dump an array to an IO object\n" ++
  "  #   Psych.safe_dump(['a', 'b'], StringIO.new)  # => #<StringIO:0x000001009d0890>\n" ++
  "  #\n" ++
  "  #   # Dump an array with indentation set\n" ++
  "  #   Psych.safe_dump(['a', ['b']], indentation: 3) # => \"---\\n- a\\n-  - b\\n\"\n" ++
  "  #\n" ++
  "  #   # Dump an array to an IO with indentation set\n" ++
  "  #   Psych.safe_dump(['a', ['b']], StringIO.new, indentation: 3)\n" ++
  "  #\n" ++
  "  #   # Dump hash with symbol keys as string\n" ++
  "  #   Psych.dump(\{a: \"b\"\}, stringify_names: true) # => \"---\\na: b\\n\"\n" ++
  "  def self.safe_dump o, io = nil, options = \{\}\n" ++
  "    if Hash === io\n" ++
  "      options = io\n" ++
  "      io      = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    visitor = Psych::Visitors::RestrictedYAMLTree.create options\n" ++
  "    visitor << o\n" ++
  "    visitor.tree.yaml io, options\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Dump a list of objects as separate documents to a document stream.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.dump_stream(\"foo\\n  \", \{\}) # => \"--- ! \\\"foo\\\\n  \\\"\\n--- \{\}\\n\"\n" ++
  "  def self.dump_stream *objects\n" ++
  "    visitor = Psych::Visitors::YAMLTree.create(\{\})\n" ++
  "    objects.each do |o|\n" ++
  "      visitor << o\n" ++
  "    end\n" ++
  "    visitor.tree.yaml\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Dump Ruby +object+ to a JSON string.\n" ++
  "  def self.to_json object\n" ++
  "    visitor = Psych::Visitors::JSONTree.create\n" ++
  "    visitor << object\n" ++
  "    visitor.tree.yaml\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Load multiple documents given in +yaml+.  Returns the parsed documents\n" ++
  "  # as a list.  If a block is given, each document will be converted to Ruby\n" ++
  "  # and passed to the block during parsing\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.load_stream(\"--- foo\\n...\\n--- bar\\n...\") # => ['foo', 'bar']\n" ++
  "  #\n" ++
  "  #   list = []\n" ++
  "  #   Psych.load_stream(\"--- foo\\n...\\n--- bar\\n...\") do |ruby|\n" ++
  "  #     list << ruby\n" ++
  "  #   end\n" ++
  "  #   list # => ['foo', 'bar']\n" ++
  "  #\n" ++
  "  def self.load_stream yaml, filename: nil, fallback: [], **kwargs\n" ++
  "    result = if block_given?\n" ++
  "               parse_stream(yaml, filename: filename) do |node|\n" ++
  "                 yield node.to_ruby(**kwargs)\n" ++
  "               end\n" ++
  "             else\n" ++
  "               parse_stream(yaml, filename: filename).children.map \{ |node| node.to_ruby(**kwargs) \}\n" ++
  "             end\n" ++
  "\n" ++
  "    return fallback if result.is_a?(Array) && result.empty?\n" ++
  "    result\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Load multiple documents given in +yaml+. Returns the parsed documents\n" ++
  "  # as a list.\n" ++
  "  #\n" ++
  "  # Example:\n" ++
  "  #\n" ++
  "  #   Psych.safe_load_stream(\"--- foo\\n...\\n--- bar\\n...\") # => ['foo', 'bar']\n" ++
  "  #\n" ++
  "  #   list = []\n" ++
  "  #   Psych.safe_load_stream(\"--- foo\\n...\\n--- bar\\n...\") do |ruby|\n" ++
  "  #     list << ruby\n" ++
  "  #   end\n" ++
  "  #   list # => ['foo', 'bar']\n" ++
  "  #\n" ++
  "  def self.safe_load_stream yaml, filename: nil, permitted_classes: [], aliases: false\n" ++
  "    documents = parse_stream(yaml, filename: filename).children.map do |child|\n" ++
  "      stream = Psych::Nodes::Stream.new\n" ++
  "      stream.children << child\n" ++
  "      safe_load(stream.to_yaml, permitted_classes: permitted_classes, aliases: aliases)\n" ++
  "    end\n" ++
  "\n" ++
  "    if block_given?\n" ++
  "      documents.each \{ |doc| yield doc \}\n" ++
  "      nil\n" ++
  "    else\n" ++
  "      documents\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Load the document contained in +filename+.  Returns the yaml contained in\n" ++
  "  # +filename+ as a Ruby object, or if the file is empty, it returns\n" ++
  "  # the specified +fallback+ return value, which defaults to +false+.\n" ++
  "  #\n" ++
  "  # NOTE: This method *should not* be used to parse untrusted documents, such as\n" ++
  "  # YAML documents that are supplied via user input.  Instead, please use the\n" ++
  "  # safe_load_file method.\n" ++
  "  def self.unsafe_load_file filename, **kwargs\n" ++
  "    File.open(filename, 'r:bom|utf-8') \{ |f|\n" ++
  "      self.unsafe_load f, filename: filename, **kwargs\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Safely loads the document contained in +filename+.  Returns the yaml contained in\n" ++
  "  # +filename+ as a Ruby object, or if the file is empty, it returns\n" ++
  "  # the specified +fallback+ return value, which defaults to +nil+.\n" ++
  "  # See safe_load for options.\n" ++
  "  def self.safe_load_file filename, **kwargs\n" ++
  "    File.open(filename, 'r:bom|utf-8') \{ |f|\n" ++
  "      self.safe_load f, filename: filename, **kwargs\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # Loads the document contained in +filename+.  Returns the yaml contained in\n" ++
  "  # +filename+ as a Ruby object, or if the file is empty, it returns\n" ++
  "  # the specified +fallback+ return value, which defaults to +nil+.\n" ++
  "  # See load for options.\n" ++
  "  def self.load_file filename, **kwargs\n" ++
  "    File.open(filename, 'r:bom|utf-8') \{ |f|\n" ++
  "      self.load f, filename: filename, **kwargs\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  def self.add_domain_type domain, type_tag, &block\n" ++
  "    key = ['tag', domain, type_tag].join ':'\n" ++
  "    domain_types[key] = [key, block]\n" ++
  "    domain_types[\"tag:#\{type_tag\}\"] = [key, block]\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.add_builtin_type type_tag, &block\n" ++
  "    domain = 'yaml.org,2002'\n" ++
  "    key = ['tag', domain, type_tag].join ':'\n" ++
  "    domain_types[key] = [key, block]\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.remove_type type_tag\n" ++
  "    domain_types.delete type_tag\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.add_tag tag, klass\n" ++
  "    load_tags[tag] = klass.name\n" ++
  "    dump_tags[klass] = tag\n" ++
  "  end\n" ++
  "\n" ++
  "  class << self\n" ++
  "    if defined?(Ractor)\n" ++
  "      class Config\n" ++
  "        attr_accessor :load_tags, :dump_tags, :domain_types\n" ++
  "        def initialize\n" ++
  "          @load_tags = \{\}\n" ++
  "          @dump_tags = \{\}\n" ++
  "          @domain_types = \{\}\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def config\n" ++
  "        Ractor.current[:PsychConfig] ||= Config.new\n" ++
  "      end\n" ++
  "\n" ++
  "      def load_tags\n" ++
  "        config.load_tags\n" ++
  "      end\n" ++
  "\n" ++
  "      def dump_tags\n" ++
  "        config.dump_tags\n" ++
  "      end\n" ++
  "\n" ++
  "      def domain_types\n" ++
  "        config.domain_types\n" ++
  "      end\n" ++
  "\n" ++
  "      def load_tags=(value)\n" ++
  "        config.load_tags = value\n" ++
  "      end\n" ++
  "\n" ++
  "      def dump_tags=(value)\n" ++
  "        config.dump_tags = value\n" ++
  "      end\n" ++
  "\n" ++
  "      def domain_types=(value)\n" ++
  "        config.domain_types = value\n" ++
  "      end\n" ++
  "    else\n" ++
  "      attr_accessor :load_tags\n" ++
  "      attr_accessor :dump_tags\n" ++
  "      attr_accessor :domain_types\n" ++
  "    end\n" ++
  "  end\n" ++
  "  self.load_tags = \{\}\n" ++
  "  self.dump_tags = \{\}\n" ++
  "  self.domain_types = \{\}\n" ++
  "  # :startdoc:\n" ++
  "end\n" ++
  "\n" ++
  "\n" ++
  "# vendor/psych/lib/psych/core_ext.rb\n" ++
  "class Object\n" ++
  "  def self.yaml_tag url\n" ++
  "    Psych.add_tag(url, self)\n" ++
  "  end\n" ++
  "\n" ++
  "  ###\n" ++
  "  # call-seq: to_yaml(options = \{\})\n" ++
  "  #\n" ++
  "  # Convert an object to YAML.  See Psych.dump for more information on the\n" ++
  "  # available +options+.\n" ++
  "  def to_yaml options = \{\}\n" ++
  "    Psych.dump self, options\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "# Up to Ruby 3.4, Set was a regular object and was dumped as such\n" ++
  "# by Pysch.\n" ++
  "# Starting from Ruby 4.0 it's a core class written in C, so we have to implement\n" ++
  "# #encode_with / #init_with to preserve backward compatibility.\n" ++
  "if defined?(::Set) && Set.new.instance_variables.empty?\n" ++
  "  class Set\n" ++
  "    def encode_with(coder)\n" ++
  "      hash = \{\}\n" ++
  "      each do |m|\n" ++
  "        hash[m] = true\n" ++
  "      end\n" ++
  "      coder[\"hash\"] = hash\n" ++
  "      coder\n" ++
  "    end\n" ++
  "\n" ++
  "    def init_with(coder)\n" ++
  "      replace(coder[\"hash\"].keys)\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/class_loader.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/coder.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/core_ext.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/exception.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/handler.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/handlers/document_stream.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/handlers/recorder.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/json/ruby_events.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/json/stream.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/json/tree_builder.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/json/yaml_events.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/alias.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/document.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/mapping.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/node.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/scalar.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/sequence.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/nodes/stream.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/omap.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/parser.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/scalar_scanner.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/set.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/stream.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/streaming.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/syntax_error.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/tree_builder.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/versions.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors/depth_first.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors/emitter.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors/json_tree.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors/to_ruby.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors/visitor.rb\")\n" ++
  "\n" ++
  "$LOADED_FEATURES << File.join(File.dirname(__FILE__), \"psych/visitors/yaml_tree.rb\")\n";
let psych_y_src = fn (u: unit) ->
  "module Kernel\n" ++
  "  ###\n" ++
  "  # An alias for Psych.dump_stream meant to be used with IRB.\n" ++
  "  def y *objects\n" ++
  "    puts Psych.dump_stream(*objects)\n" ++
  "  end\n" ++
  "  private :y\n" ++
  "end\n" ++
  "\n";
