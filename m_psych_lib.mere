  "    #\n" ++
  "    # === Example\n" ++
  "    #\n" ++
  "    # Given the following YAML:\n" ++
  "    #\n" ++
  "    #   ---\n" ++
  "    #     hello world\n" ++
  "    #\n" ++
  "    # +implicit+ will be true.  Given this YAML:\n" ++
  "    #\n" ++
  "    #   ---\n" ++
  "    #     hello world\n" ++
  "    #   ...\n" ++
  "    #\n" ++
  "    # +implicit+ will be false.\n" ++
  "    def end_document implicit\n" ++
  "    end\n" ++
  "\n" ++
  "    ###\n" ++
  "    # Called when an alias is found to +anchor+.  +anchor+ will be the name\n" ++
