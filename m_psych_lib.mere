  "        def dispatch\n" ++
  "          @dispatch_cache ||= (Ractor.current[:Psych_Visitors_Visitor] ||= Visitor.dispatch_cache)\n" ++
  "        end\n" ++
  "      else\n" ++
  "        DISPATCH = dispatch_cache\n" ++
  "        def dispatch\n" ++
  "          DISPATCH\n" ++
  "        end\n" ++
