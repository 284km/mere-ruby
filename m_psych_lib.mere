  "module Psych\n" ++
  "  # The public compatibility level; parsing and emitting use the Ruby backend.\n" ++
  "  def self.libyaml_version\n" ++
  "    [0, 2, 5]\n" ++
  "  end\n" ++
  "\n" ++
  "  class ClassLoader\n" ++
  "    private\n" ++
  "\n" ++
  "    # rb_path_to_class resolves namespaces without const_missing or inheritance.\n" ++
  "    def path2class(path)\n" ++
  "      raise ArgumentError, 'invalid class path encoding (non ASCII)' unless path.encoding.ascii_compatible?\n" ++
  "      if path.empty? || path.start_with?('#')\n" ++
  "        raise ArgumentError, \"can't retrieve anonymous class #\{path.inspect\}\"\n" ++
  "      end\n" ++
  "      value = Object\n" ++
  "      names = path.split('::', -1)\n" ++
  "      names.pop if names.last == ''\n" ++
  "      names.each do |name|\n" ++
  "        unless !name.empty? && value.const_defined?(name, false)\n" ++
  "          raise ArgumentError, \"undefined class/module #\{path\}\"\n" ++
  "        end\n" ++
  "        value = value.const_get(name, false)\n" ++
  "        raise TypeError, \"#\{path\} does not refer to class/module\" unless Module === value\n" ++
  "      end\n" ++
  "      value\n" ++
  "    rescue NameError\n" ++
  "      raise ArgumentError, \"undefined class/module #\{path\}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  module Visitors\n" ++
  "    class YAMLTree\n" ++
  "      class Registrar\n" ++
  "        IDENTITY = BasicObject.instance_method(:__id__)\n" ++
  "        SAME_OBJECT = BasicObject.instance_method(:equal?)\n" ++
  "\n" ++
  "        def initialize\n" ++
  "          @obj_to_id = \{\}\n" ++
  "          @obj_to_node = \{\}\n" ++
  "          @unboxed_ids = \{\}.compare_by_identity\n" ++
  "          @unboxed_nodes = \{\}.compare_by_identity\n" ++
  "          @counter = 0\n" ++
  "        end\n" ++
  "\n" ++
  "        def register(target, node)\n" ++
  "          key = IDENTITY.bind(target).call\n" ++
  "          if key == 0\n" ++
  "            @unboxed_nodes[target] = [target, node]\n" ++
  "          elsif entry = entry_for(@obj_to_node, key, target)\n" ++
  "            entry[1] = node\n" ++
  "          else\n" ++
  "            @obj_to_node[key] = [target, node, @obj_to_node[key]]\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        def key?(target)\n" ++
  "          key = IDENTITY.bind(target).call\n" ++
  "          key == 0 ? @unboxed_nodes.key?(target) : !!entry_for(@obj_to_node, key, target)\n" ++
  "        end\n" ++
  "\n" ++
  "        def id_for(target)\n" ++
  "          key = IDENTITY.bind(target).call\n" ++
  "          table = key == 0 ? @unboxed_ids : @obj_to_id\n" ++
  "          entry = key == 0 ? table[target] : entry_for(table, key, target)\n" ++
  "          unless entry\n" ++
  "            @counter += 1\n" ++
  "            if key == 0\n" ++
  "              table[target] = entry = [target, @counter]\n" ++
  "            else\n" ++
  "              table[key] = entry = [target, @counter, table[key]]\n" ++
  "            end\n" ++
  "          end\n" ++
  "          entry[1]\n" ++
  "        end\n" ++
