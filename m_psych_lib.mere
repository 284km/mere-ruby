  "      attr_accessor :start_line\n" ++
  "\n" ++
  "      # The column number where this node start\n" ++
  "      attr_accessor :start_column\n" ++
  "\n" ++
  "      # The line number where this node ends\n" ++
  "      attr_accessor :end_line\n" ++
  "\n" ++
  "      # The column number where this node ends\n" ++
  "      attr_accessor :end_column\n" ++
