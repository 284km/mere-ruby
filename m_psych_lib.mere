  "      attr_accessor :anchor\n" ++
  "\n" ++
  "      # The tag value (if there is one)\n" ++
  "      attr_accessor :tag\n" ++
  "\n" ++
  "      # Is this a plain scalar?\n" ++
  "      attr_accessor :plain\n" ++
  "\n" ++
  "      # Is this scalar quoted?\n" ++
  "      attr_accessor :quoted\n" ++
