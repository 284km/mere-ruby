  "      ANY     = Psych::Parser::ANY\n" ++
  "\n" ++
  "      # UTF-8 encoding\n" ++
  "      UTF8    = Psych::Parser::UTF8\n" ++
  "\n" ++
  "      # UTF-16LE encoding\n" ++
  "      UTF16LE = Psych::Parser::UTF16LE\n" ++
  "\n" ++
  "      # UTF-16BE encoding\n" ++
  "      UTF16BE = Psych::Parser::UTF16BE\n" ++
