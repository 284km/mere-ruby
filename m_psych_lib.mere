  "    # Psych::Nodes::Sequence node may have 0 or more children.  Valid children\n" ++
  "    # for this node are:\n" ++
  "    #\n" ++
  "    # * Psych::Nodes::Sequence\n" ++
  "    # * Psych::Nodes::Mapping\n" ++
