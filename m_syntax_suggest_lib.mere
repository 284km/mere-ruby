    ++ "    end\n"
    ++ "\n"
    ++ "    def inspect\n"
    ++ "      \"#<#\{self.class\}: #\{args.join(' ')\}>\"\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    #\n"
    ++ "    # Default stringizing method to emit standard error message.\n"
