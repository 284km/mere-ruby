    ++ "      \"#\{reason\}: #\{args.join(' ')\}#\{additional[@arg0] if additional\}\"\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    alias to_s message\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  #\n"
    ++ "  # Raises when ambiguously completable string is encountered.\n"
