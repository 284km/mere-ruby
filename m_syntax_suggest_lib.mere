    ++ "        down: ->(line, _, _) \{ line.hidden? || line.empty? \}\n"
    ++ "      )\n"
    ++ "\n"
    ++ "      # More ends than keywords, check if we can balance expanding up\n"
    ++ "      next_up = @scanner.next_up\n"
    ++ "      next_down = @scanner.next_down\n"
    ++ "      case end_count - kw_count\n"
    ++ "      when 1\n"
