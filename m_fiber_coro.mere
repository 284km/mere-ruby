// ---- the part of the Fibers that switches stacks (see m_fiber.mere) ---------
// A fiber's body runs on a coroutine: a second stack on this same thread
// (mere's coro_new / coro_switch, v0.1.543). Nothing runs in parallel and
// nothing is handed between threads, so no `spawn`, no channel and no pool of
// threads -- the shape this replaced (m_fiber_threads.mere, until 2026-09-28)
// needed all three, and a fiber switch cost a round trip between two threads.
//
// A build that has no coroutines (the Wasm playground, the RV targets)
// compiles m_fiber_nothreads.mere in this file's place: same names, and a
// fiber that runs to completion on the first #resume.
let fb_can_suspend = true;
// the scheduler sleeps here when nothing can run until a deadline
let fb_os_sleep = fn (ms: int) -> sleep_ms ms;

// index -> its coroutine. A fiber that is started gets one from coro_new, and
// so does a Ruby Thread's root (fb_start_thread); the one stack that was
// already running -- the main thread's root fiber -- is entered here the first
// time it switches away, as coro_root. Every one is a Coro[unit]: what crosses
// a switch goes through fb_xfer (mere v0.1.560 carries a value only if it is a
// scalar, and a Ruby value is not).
let fb_coro = map_new ();

// The resume path asks for the target's and its own "inbox" before it starts
// anything; an index stands in for one, and asking for the running fiber's is
// where the running stack gets its entry.
let fb_inbox_of = fn (i: int) ->
  let _ = (if i == fb_cur () && (if map_has fb_coro i then false else true)
           then map_set fb_coro i (coro_root ()) else ()) in
  i;

// THE SWITCH. Save this stack's interpreter state, name the target as
// running, and hand the thread to its coroutine. When something switches back
// here, put the state back.
let fb_switch = fn (from: int) -> fn (to: int) ->
  let _ = fb_inbox_of from in
  // the frame that switches is in the middle of its statement (fb_wm)
  let _ = fb_wm_call (fb_cd () - 1) in
  let c = map_get fb_coro to in
  let _ = fb_ctx_save from in
  let _ = map_set fb_st "cur" to in
  let _ = coro_switch c in
  let _ = fb_ctx_restore from in
  map_set fb_st "cur" from;

// A fiber's coroutine: run the body the evaluator registered, and when it has
// ended, hand the thread to the fiber it returns to. The coroutine's record
// is dropped from the table last, just before the hand-over, so a scan of the
// running stack (fb_scan_stack) finds it up to then; its stack goes back to
// the runtime.
let fb_run_body = fn (i: int) -> fn (inbox: int) ->
  let body = map_get fb_bodies i in
  let _ = map_delete fb_bodies i in
  let t = body () in
  let next = map_get fb_coro t in
  let _ = map_set fb_st "cur" t in
  let _ = map_delete fb_coro i in
  coro_exit next ();
// Making the coroutine runs nothing yet: the resumer switches to it next. A
// stack the host will not give is a fail, which the resume path turns into
// ruby's "can't alloc machine stack".
let fb_start_thread = fn (i: int) -> fn (inbox: int) ->
  map_set fb_coro i (coro_new (fn _me -> fn (_u: unit) -> fb_run_body i inbox));

// WHAT A STACK CAN STILL REACH (Q-182). A stack that stopped in the middle of
// a statement holds values in C variables of its own frames that no root of
// the interpreter names: `[q.pop, Fiber.yield]` stops with the popped object
// held only there, and the queue no longer has it. The watermarks (fb_wm)
// cover what the statement ALLOCATED; this covers what it TOOK. The runtime
// reads the stack -- a suspended one from where it stopped, the running one
// from here up -- and every node it points at, and hands over each number in
// [lo, hi) it finds; the collector tries each as a handle (gc_mark_cand). The
// handles are numbered from handle_base, above everything else a stack holds.
let fb_scan_stack = fn (i: int) -> fn (lo: int) -> fn (hi: int) -> fn (f: int -> unit) ->
  if map_has fb_coro i then coro_scan_ints (map_get fb_coro i) lo hi f
  // the running stack with no entry of its own is the root's
  else if i == fb_cur () then coro_scan_ints (coro_root ()) lo hi f
  else ();

// RUNNING SOMETHING ON A STACK OF ITS OWN (note 270). A collection in the
// middle of a method or block body has to see what that body's stack holds in
// C variables, and it has to leave alone the arenas those variables point
// into -- which is exactly what a SUSPENDED stack already gets: the runtime
// scans it (coro_scan_ints, Q-182) and does not free an arena it points into
// (mere v0.1.547). A collection run HERE, on the stack it interrupts, gets
// neither: the runtime pins for suspended coroutines only, and the running
// one is not. So the collection gets a coroutine of its own, and the stack it
// interrupts is suspended for as long as it runs. The fiber bookkeeping does
// not move (fb_cur is still the interrupted one): nothing else runs, and the
// coroutine hands the thread straight back when f returns.
let fb_off_fn = map_new ();
let fb_off_stack = true;
let fb_run_off_stack = fn (f: unit -> unit) ->
  let me = fb_cur () in
  let _ = fb_inbox_of me in
  let _ = map_set fb_off_fn 0 f in
  let c = coro_new (fn _me -> fn (_u: unit) ->
            let g = map_get fb_off_fn 0 in
            let _ = map_delete fb_off_fn 0 in
            let _ = g () in
            coro_exit (map_get fb_coro (fb_cur ())) ()) in
  let _ = coro_switch c in
  true;
