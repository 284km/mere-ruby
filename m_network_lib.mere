  "# frozen_string_literal: true\n" ++
  "\n" ++
  "require 'socket'\n" ++
  "require 'resolv'\n" ++
  "\n" ++
  "class << IPSocket\n" ++
  "  # :stopdoc:\n" ++
  "  alias original_resolv_getaddress getaddress\n" ++
  "  # :startdoc:\n" ++
  "  def getaddress(host)\n" ++
  "    begin\n" ++
  "      return Resolv.getaddress(host).to_s\n" ++
  "    rescue Resolv::ResolvError\n" ++
  "      raise SocketError, \"Hostname not known: #\{host\}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class TCPSocket < IPSocket\n" ++
  "  # :stopdoc:\n" ++
  "  alias original_resolv_initialize initialize\n" ++
  "  # :startdoc:\n" ++
  "  def initialize(host, serv, *rest)\n" ++
  "    rest[0] = IPSocket.getaddress(rest[0]) if rest[0]\n" ++
  "    original_resolv_initialize(IPSocket.getaddress(host), serv, *rest)\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class UDPSocket < IPSocket\n" ++
  "  # :stopdoc:\n" ++
  "  alias original_resolv_bind bind\n" ++
  "  # :startdoc:\n" ++
  "  def bind(host, port)\n" ++
  "    host = IPSocket.getaddress(host) if host != \"\"\n" ++
  "    original_resolv_bind(host, port)\n" ++
  "  end\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  alias original_resolv_connect connect\n" ++
  "  # :startdoc:\n" ++
  "  def connect(host, port)\n" ++
  "    original_resolv_connect(IPSocket.getaddress(host), port)\n" ++
  "  end\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  alias original_resolv_send send\n" ++
  "  # :startdoc:\n" ++
  "  def send(mesg, flags, *rest)\n" ++
  "    if rest.length == 2\n" ++
  "      host, port = rest\n" ++
  "      begin\n" ++
  "        addrs = Resolv.getaddresses(host)\n" ++
  "      rescue Resolv::ResolvError\n" ++
  "        raise SocketError, \"Hostname not known: #\{host\}\"\n" ++
  "      end\n" ++
  "      addrs[0...-1].each \{|addr|\n" ++
  "        begin\n" ++
  "          return original_resolv_send(mesg, flags, addr, port)\n" ++
  "        rescue SystemCallError\n" ++
  "        end\n" ++
  "      \}\n" ++
  "      original_resolv_send(mesg, flags, addrs[-1], port)\n" ++
  "    else\n" ++
  "      original_resolv_send(mesg, flags, *rest)\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "class SOCKSSocket < TCPSocket\n" ++
  "  # :stopdoc:\n" ++
  "  alias original_resolv_initialize initialize\n" ++
  "  # :startdoc:\n" ++
  "  def initialize(host, serv)\n" ++
  "    original_resolv_initialize(IPSocket.getaddress(host), port)\n" ++
  "  end\n" ++
  "end if defined? SOCKSSocket\n";
let network_source_15 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "\n" ++
  "require 'socket'\n" ++
  "require 'timeout'\n" ++
  "require 'io/wait'\n" ++
  "require 'securerandom'\n" ++
  "require 'rbconfig'\n" ++
  "\n" ++
  "# Resolv is a thread-aware DNS resolver library written in Ruby.  Resolv can\n" ++
  "# handle multiple DNS requests concurrently without blocking the entire Ruby\n" ++
  "# interpreter.\n" ++
  "#\n" ++
  "# See also resolv-replace.rb to replace the libc resolver with Resolv.\n" ++
  "#\n" ++
  "# Resolv can look up various DNS resources using the DNS module directly.\n" ++
  "#\n" ++
  "# Examples:\n" ++
  "#\n" ++
  "#   p Resolv.getaddress \"www.ruby-lang.org\"\n" ++
  "#   p Resolv.getname \"210.251.121.214\"\n" ++
  "#\n" ++
  "#   Resolv::DNS.open do |dns|\n" ++
  "#     ress = dns.getresources \"www.ruby-lang.org\", Resolv::DNS::Resource::IN::A\n" ++
  "#     p ress.map(&:address)\n" ++
  "#     ress = dns.getresources \"ruby-lang.org\", Resolv::DNS::Resource::IN::MX\n" ++
  "#     p ress.map \{ |r| [r.exchange.to_s, r.preference] \}\n" ++
  "#   end\n" ++
  "#\n" ++
  "#\n" ++
  "# == Bugs\n" ++
  "#\n" ++
  "# * NIS is not supported.\n" ++
  "# * /etc/nsswitch.conf is not supported.\n" ++
  "\n" ++
  "class Resolv\n" ++
  "\n" ++
  "  # The version string\n" ++
  "  VERSION = \"0.7.2\"\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up the first IP address for +name+.\n" ++
  "\n" ++
  "  def self.getaddress(name)\n" ++
  "    DefaultResolver.getaddress(name)\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up all IP address for +name+.\n" ++
  "\n" ++
  "  def self.getaddresses(name)\n" ++
  "    DefaultResolver.getaddresses(name)\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Iterates over all IP addresses for +name+.\n" ++
  "\n" ++
  "  def self.each_address(name, &block)\n" ++
  "    DefaultResolver.each_address(name, &block)\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up the hostname of +address+.\n" ++
  "\n" ++
  "  def self.getname(address)\n" ++
  "    DefaultResolver.getname(address)\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up all hostnames for +address+.\n" ++
  "\n" ++
  "  def self.getnames(address)\n" ++
  "    DefaultResolver.getnames(address)\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Iterates over all hostnames for +address+.\n" ++
  "\n" ++
  "  def self.each_name(address, &proc)\n" ++
  "    DefaultResolver.each_name(address, &proc)\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Creates a new Resolv using +resolvers+.\n" ++
  "  #\n" ++
  "  # If +resolvers+ is not given, a hash, or +nil+, uses a Hosts resolver and\n" ++
  "  # and a DNS resolver.  If +resolvers+ is a hash, uses the hash as\n" ++
  "  # configuration for the DNS resolver.\n" ++
  "\n" ++
  "  def initialize(resolvers=(arg_not_set = true; nil), use_ipv6: (keyword_not_set = true; nil))\n" ++
  "    if !keyword_not_set && !arg_not_set\n" ++
  "      warn \"Support for separate use_ipv6 keyword is deprecated, as it is ignored if an argument is provided. Do not provide a positional argument if using the use_ipv6 keyword argument.\", uplevel: 1\n" ++
  "    end\n" ++
  "\n" ++
  "    @resolvers = case resolvers\n" ++
  "    when Hash, nil\n" ++
  "      [Hosts.new, DNS.new(DNS::Config.default_config_hash.merge(resolvers || \{\}))]\n" ++
  "    else\n" ++
  "      resolvers\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up the first IP address for +name+.\n" ++
  "\n" ++
  "  def getaddress(name)\n" ++
  "    each_address(name) \{|address| return address\}\n" ++
  "    raise ResolvError.new(\"no address for #\{name\}\")\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up all IP address for +name+.\n" ++
  "\n" ++
  "  def getaddresses(name)\n" ++
  "    ret = []\n" ++
  "    each_address(name) \{|address| ret << address\}\n" ++
  "    return ret\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Iterates over all IP addresses for +name+.\n" ++
  "\n" ++
  "  def each_address(name)\n" ++
  "    if AddressRegex =~ name\n" ++
  "      yield name\n" ++
  "      return\n" ++
  "    end\n" ++
  "    yielded = false\n" ++
  "    @resolvers.each \{|r|\n" ++
  "      r.each_address(name) \{|address|\n" ++
  "        yield address.to_s\n" ++
  "        yielded = true\n" ++
  "      \}\n" ++
  "      return if yielded\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up the hostname of +address+.\n" ++
  "\n" ++
  "  def getname(address)\n" ++
  "    each_name(address) \{|name| return name\}\n" ++
  "    raise ResolvError.new(\"no name for #\{address\}\")\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Looks up all hostnames for +address+.\n" ++
  "\n" ++
  "  def getnames(address)\n" ++
  "    ret = []\n" ++
  "    each_name(address) \{|name| ret << name\}\n" ++
  "    return ret\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Iterates over all hostnames for +address+.\n" ++
  "\n" ++
  "  def each_name(address)\n" ++
  "    yielded = false\n" ++
  "    @resolvers.each \{|r|\n" ++
  "      r.each_name(address) \{|name|\n" ++
  "        yield name.to_s\n" ++
  "        yielded = true\n" ++
  "      \}\n" ++
  "      return if yielded\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Indicates a failure to resolve a name or address.\n" ++
  "\n" ++
  "  class ResolvError < StandardError; end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Indicates a timeout resolving a name or address.\n" ++
  "\n" ++
  "  class ResolvTimeout < Timeout::Error; end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Resolv::Hosts is a hostname resolver that uses the system hosts file.\n" ++
  "\n" ++
  "  class Hosts\n" ++
  "    if /mswin|cygwin|mingw|bccwin/ =~ RUBY_PLATFORM || ::RbConfig::CONFIG['host_os'] =~ /mswin/\n" ++
  "      begin\n" ++
  "        require 'win32/resolv' unless defined?(Win32::Resolv)\n" ++
  "        hosts = Win32::Resolv.get_hosts_path || IO::NULL\n" ++
  "      rescue LoadError\n" ++
  "      end\n" ++
  "    end\n" ++
  "    # The default file name for host names\n" ++
  "    DefaultFileName = hosts || '/etc/hosts'\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new Resolv::Hosts, using +filename+ for its data source.\n" ++
  "\n" ++
  "    def initialize(filename = DefaultFileName)\n" ++
  "      @filename = filename\n" ++
  "      @mutex = Thread::Mutex.new\n" ++
  "      @initialized = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    def lazy_initialize # :nodoc:\n" ++
  "      @mutex.synchronize \{\n" ++
  "        unless @initialized\n" ++
  "          @name2addr = \{\}\n" ++
  "          @addr2name = \{\}\n" ++
  "          File.open(@filename, 'rb') \{|f|\n" ++
  "            f.each \{|line|\n" ++
  "              line.sub!(/#.*/, '')\n" ++
  "              addr, *hostnames = line.split(/\\s+/)\n" ++
  "              next unless addr\n" ++
  "              (@addr2name[addr] ||= []).concat(hostnames)\n" ++
  "              hostnames.each \{|hostname| (@name2addr[hostname] ||= []) << addr\}\n" ++
  "            \}\n" ++
  "          \}\n" ++
  "          @name2addr.each \{|name, arr| arr.reverse!\}\n" ++
  "          @initialized = true\n" ++
  "        end\n" ++
  "      \}\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets the IP address of +name+ from the hosts file.\n" ++
  "\n" ++
  "    def getaddress(name)\n" ++
  "      each_address(name) \{|address| return address\}\n" ++
  "      raise ResolvError.new(\"#\{@filename\} has no name: #\{name\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets all IP addresses for +name+ from the hosts file.\n" ++
  "\n" ++
  "    def getaddresses(name)\n" ++
  "      ret = []\n" ++
  "      each_address(name) \{|address| ret << address\}\n" ++
  "      return ret\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Iterates over all IP addresses for +name+ retrieved from the hosts file.\n" ++
  "\n" ++
  "    def each_address(name, &proc)\n" ++
  "      lazy_initialize\n" ++
  "      @name2addr[name]&.each(&proc)\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets the hostname of +address+ from the hosts file.\n" ++
  "\n" ++
  "    def getname(address)\n" ++
  "      each_name(address) \{|name| return name\}\n" ++
  "      raise ResolvError.new(\"#\{@filename\} has no address: #\{address\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets all hostnames for +address+ from the hosts file.\n" ++
  "\n" ++
  "    def getnames(address)\n" ++
  "      ret = []\n" ++
  "      each_name(address) \{|name| ret << name\}\n" ++
  "      return ret\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Iterates over all hostnames for +address+ retrieved from the hosts file.\n" ++
  "\n" ++
  "    def each_name(address, &proc)\n" ++
  "      lazy_initialize\n" ++
  "      @addr2name[address]&.each(&proc)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Resolv::DNS is a DNS stub resolver.\n" ++
  "  #\n" ++
  "  # Information taken from the following places:\n" ++
  "  #\n" ++
  "  # * STD0013\n" ++
  "  # * RFC 1035\n" ++
  "  # * ftp://ftp.isi.edu/in-notes/iana/assignments/dns-parameters\n" ++
  "  # * etc.\n" ++
  "\n" ++
  "  class DNS\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Default DNS Port\n" ++
  "\n" ++
  "    Port = 53\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Default DNS UDP packet size\n" ++
  "\n" ++
  "    UDPSize = 512\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new DNS resolver.  See Resolv::DNS.new for argument details.\n" ++
  "    #\n" ++
  "    # Yields the created DNS resolver to the block, if given, otherwise\n" ++
  "    # returns it.\n" ++
  "\n" ++
  "    def self.open(*args)\n" ++
  "      dns = new(*args)\n" ++
  "      return dns unless block_given?\n" ++
  "      begin\n" ++
  "        yield dns\n" ++
  "      ensure\n" ++
  "        dns.close\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new DNS resolver.\n" ++
  "    #\n" ++
  "    # +config_info+ can be:\n" ++
  "    #\n" ++
  "    # nil:: Uses /etc/resolv.conf.\n" ++
  "    # String:: Path to a file using /etc/resolv.conf's format.\n" ++
  "    # Hash:: Must contain :nameserver, :search and :ndots keys.\n" ++
  "    # :nameserver_port can be used to specify port number of nameserver address.\n" ++
  "    # :raise_timeout_errors can be used to raise timeout errors\n" ++
  "    # as exceptions instead of treating the same as an NXDOMAIN response.\n" ++
  "    #\n" ++
  "    # The value of :nameserver should be an address string or\n" ++
  "    # an array of address strings.\n" ++
  "    # - :nameserver => '8.8.8.8'\n" ++
  "    # - :nameserver => ['8.8.8.8', '8.8.4.4']\n" ++
  "    #\n" ++
  "    # The value of :nameserver_port should be an array of\n" ++
  "    # pair of nameserver address and port number.\n" ++
  "    # - :nameserver_port => [['8.8.8.8', 53], ['8.8.4.4', 53]]\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #   Resolv::DNS.new(:nameserver => ['210.251.121.21'],\n" ++
  "    #                   :search => ['ruby-lang.org'],\n" ++
  "    #                   :ndots => 1)\n" ++
  "\n" ++
  "    def initialize(config_info=nil)\n" ++
  "      @mutex = Thread::Mutex.new\n" ++
  "      @config = Config.new(config_info)\n" ++
  "      @initialized = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets the resolver timeouts.  This may be a single positive number\n" ++
  "    # or an array of positive numbers representing timeouts in seconds.\n" ++
  "    # If an array is specified, a DNS request will retry and wait for\n" ++
  "    # each successive interval in the array until a successful response\n" ++
  "    # is received.  Specifying +nil+ reverts to the default timeouts:\n" ++
  "    # [ 5, second = 5 * 2 / nameserver_count, 2 * second, 4 * second ]\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #   dns.timeouts = 3\n" ++
  "    #\n" ++
  "    def timeouts=(values)\n" ++
  "      @config.timeouts = values\n" ++
  "    end\n" ++
  "\n" ++
  "    def lazy_initialize # :nodoc:\n" ++
  "      @mutex.synchronize \{\n" ++
  "        unless @initialized\n" ++
  "          @config.lazy_initialize\n" ++
  "          @initialized = true\n" ++
  "        end\n" ++
  "      \}\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Closes the DNS resolver.\n" ++
  "\n" ++
  "    def close\n" ++
  "      @mutex.synchronize \{\n" ++
  "        if @initialized\n" ++
  "          @initialized = false\n" ++
  "        end\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets the IP address of +name+ from the DNS resolver.\n" ++
  "    #\n" ++
  "    # +name+ can be a Resolv::DNS::Name or a String.  Retrieved address will\n" ++
  "    # be a Resolv::IPv4 or Resolv::IPv6\n" ++
  "\n" ++
  "    def getaddress(name)\n" ++
  "      each_address(name) \{|address| return address\}\n" ++
  "      raise ResolvError.new(\"DNS result has no information for #\{name\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets all IP addresses for +name+ from the DNS resolver.\n" ++
  "    #\n" ++
  "    # +name+ can be a Resolv::DNS::Name or a String.  Retrieved addresses will\n" ++
  "    # be a Resolv::IPv4 or Resolv::IPv6\n" ++
  "\n" ++
  "    def getaddresses(name)\n" ++
  "      ret = []\n" ++
  "      each_address(name) \{|address| ret << address\}\n" ++
  "      return ret\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Iterates over all IP addresses for +name+ retrieved from the DNS\n" ++
  "    # resolver.\n" ++
  "    #\n" ++
  "    # +name+ can be a Resolv::DNS::Name or a String.  Retrieved addresses will\n" ++
  "    # be a Resolv::IPv4 or Resolv::IPv6\n" ++
  "\n" ++
  "    def each_address(name)\n" ++
  "      if use_ipv6?\n" ++
  "        each_resource(name, Resource::IN::AAAA) \{|resource| yield resource.address\}\n" ++
  "      end\n" ++
  "      each_resource(name, Resource::IN::A) \{|resource| yield resource.address\}\n" ++
  "    end\n" ++
  "\n" ++
  "    def use_ipv6? # :nodoc:\n" ++
  "      @config.lazy_initialize unless @config.instance_variable_get(:@initialized)\n" ++
  "\n" ++
  "      use_ipv6 = @config.use_ipv6?\n" ++
  "      unless use_ipv6.nil?\n" ++
  "        return use_ipv6\n" ++
  "      end\n" ++
  "\n" ++
  "      begin\n" ++
  "        list = Socket.ip_address_list\n" ++
  "      rescue NotImplementedError\n" ++
  "        return true\n" ++
  "      end\n" ++
  "      list.any? \{|a| a.ipv6? && !a.ipv6_loopback? && !a.ipv6_linklocal? \}\n" ++
  "    end\n" ++
  "    private :use_ipv6?\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets the hostname for +address+ from the DNS resolver.\n" ++
  "    #\n" ++
  "    # +address+ must be a Resolv::IPv4, Resolv::IPv6 or a String.  Retrieved\n" ++
  "    # name will be a Resolv::DNS::Name.\n" ++
  "\n" ++
  "    def getname(address)\n" ++
  "      each_name(address) \{|name| return name\}\n" ++
  "      raise ResolvError.new(\"DNS result has no information for #\{address\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Gets all hostnames for +address+ from the DNS resolver.\n" ++
  "    #\n" ++
  "    # +address+ must be a Resolv::IPv4, Resolv::IPv6 or a String.  Retrieved\n" ++
  "    # names will be Resolv::DNS::Name instances.\n" ++
  "\n" ++
  "    def getnames(address)\n" ++
  "      ret = []\n" ++
  "      each_name(address) \{|name| ret << name\}\n" ++
  "      return ret\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Iterates over all hostnames for +address+ retrieved from the DNS\n" ++
  "    # resolver.\n" ++
  "    #\n" ++
  "    # +address+ must be a Resolv::IPv4, Resolv::IPv6 or a String.  Retrieved\n" ++
  "    # names will be Resolv::DNS::Name instances.\n" ++
  "\n" ++
  "    def each_name(address)\n" ++
  "      case address\n" ++
  "      when Name\n" ++
  "        ptr = address\n" ++
  "      when IPv4, IPv6\n" ++
  "        ptr = address.to_name\n" ++
  "      when IPv4::Regex\n" ++
  "        ptr = IPv4.create(address).to_name\n" ++
  "      when IPv6::Regex\n" ++
  "        ptr = IPv6.create(address).to_name\n" ++
  "      else\n" ++
  "        raise ResolvError.new(\"cannot interpret as address: #\{address\}\")\n" ++
  "      end\n" ++
  "      each_resource(ptr, Resource::IN::PTR) \{|resource| yield resource.name\}\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Look up the +typeclass+ DNS resource of +name+.\n" ++
  "    #\n" ++
  "    # +name+ must be a Resolv::DNS::Name or a String.\n" ++
  "    #\n" ++
  "    # +typeclass+ should be one of the following:\n" ++
  "    #\n" ++
  "    # * Resolv::DNS::Resource::IN::A\n" ++
  "    # * Resolv::DNS::Resource::IN::AAAA\n" ++
  "    # * Resolv::DNS::Resource::IN::ANY\n" ++
  "    # * Resolv::DNS::Resource::IN::CAA\n" ++
  "    # * Resolv::DNS::Resource::IN::CNAME\n" ++
  "    # * Resolv::DNS::Resource::IN::HINFO\n" ++
  "    # * Resolv::DNS::Resource::IN::HTTPS\n" ++
  "    # * Resolv::DNS::Resource::IN::LOC\n" ++
  "    # * Resolv::DNS::Resource::IN::MINFO\n" ++
  "    # * Resolv::DNS::Resource::IN::MX\n" ++
  "    # * Resolv::DNS::Resource::IN::NS\n" ++
  "    # * Resolv::DNS::Resource::IN::PTR\n" ++
  "    # * Resolv::DNS::Resource::IN::SOA\n" ++
  "    # * Resolv::DNS::Resource::IN::SRV\n" ++
  "    # * Resolv::DNS::Resource::IN::SVCB\n" ++
  "    # * Resolv::DNS::Resource::IN::TXT\n" ++
  "    # * Resolv::DNS::Resource::IN::WKS\n" ++
  "    #\n" ++
  "    # Returned resource is represented as a Resolv::DNS::Resource instance,\n" ++
  "    # i.e. Resolv::DNS::Resource::IN::A.\n" ++
  "\n" ++
  "    def getresource(name, typeclass)\n" ++
  "      each_resource(name, typeclass) \{|resource| return resource\}\n" ++
  "      raise ResolvError.new(\"DNS result has no information for #\{name\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Looks up all +typeclass+ DNS resources for +name+.  See #getresource for\n" ++
  "    # argument details.\n" ++
  "\n" ++
  "    def getresources(name, typeclass)\n" ++
  "      ret = []\n" ++
  "      each_resource(name, typeclass) \{|resource| ret << resource\}\n" ++
  "      return ret\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Iterates over all +typeclass+ DNS resources for +name+.  See\n" ++
  "    # #getresource for argument details.\n" ++
  "\n" ++
  "    def each_resource(name, typeclass, &proc)\n" ++
  "      fetch_resource(name, typeclass) \{|reply, reply_name|\n" ++
  "        extract_resources(reply, reply_name, typeclass, &proc)\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "\n" ++
  "    def fetch_resource(name, typeclass)\n" ++
  "      lazy_initialize\n" ++
  "      truncated = \{\}\n" ++
  "      requesters = \{\}\n" ++
  "      udp_requester = begin\n" ++
  "        make_udp_requester\n" ++
  "      rescue Errno::EACCES\n" ++
  "        # fall back to TCP\n" ++
  "      end\n" ++
  "      senders = \{\}\n" ++
  "\n" ++
  "      begin\n" ++
  "        @config.resolv(name) do |candidate, tout, nameserver, port|\n" ++
  "          msg = Message.new\n" ++
  "          msg.rd = 1\n" ++
  "          msg.add_question(candidate, typeclass)\n" ++
  "\n" ++
  "          requester = requesters.fetch([nameserver, port]) do\n" ++
  "            if !truncated[candidate] && udp_requester\n" ++
  "              udp_requester\n" ++
  "            else\n" ++
  "              requesters[[nameserver, port]] = make_tcp_requester(nameserver, port)\n" ++
  "            end\n" ++
  "          end\n" ++
  "\n" ++
  "          unless sender = senders[[candidate, requester, nameserver, port]]\n" ++
  "            sender = requester.sender(msg, candidate, nameserver, port)\n" ++
  "            next if !sender\n" ++
  "            senders[[candidate, requester, nameserver, port]] = sender\n" ++
  "          end\n" ++
  "          reply, reply_name = requester.request(sender, tout)\n" ++
  "          case reply.rcode\n" ++
  "          when RCode::NoError\n" ++
  "            if reply.tc == 1 and not Requester::TCP === requester\n" ++
  "              # Retry via TCP:\n" ++
  "              truncated[candidate] = true\n" ++
  "              redo\n" ++
  "            else\n" ++
  "              yield(reply, reply_name)\n" ++
  "            end\n" ++
  "            return\n" ++
  "          when RCode::NXDomain\n" ++
  "            raise Config::NXDomain.new(reply_name.to_s)\n" ++
  "          else\n" ++
  "            raise Config::OtherResolvError.new(reply_name.to_s)\n" ++
  "          end\n" ++
  "        end\n" ++
  "      ensure\n" ++
  "        udp_requester&.close\n" ++
  "        requesters.each_value \{ |requester| requester&.close \}\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def make_udp_requester # :nodoc:\n" ++
  "      nameserver_port = @config.nameserver_port\n" ++
  "      if nameserver_port.length == 1\n" ++
  "        Requester::ConnectedUDP.new(*nameserver_port[0])\n" ++
  "      else\n" ++
  "        Requester::UnconnectedUDP.new(*nameserver_port)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def make_tcp_requester(host, port) # :nodoc:\n" ++
  "      return Requester::TCP.new(host, port)\n" ++
  "    rescue Errno::ECONNREFUSED\n" ++
  "      # Treat a refused TCP connection attempt to a nameserver like a timeout,\n" ++
  "      # as Resolv::DNS::Config#resolv considers ResolvTimeout exceptions as a\n" ++
  "      # hint to try the next nameserver:\n" ++
  "      raise ResolvTimeout\n" ++
  "    end\n" ++
  "\n" ++
  "    def extract_resources(msg, name, typeclass) # :nodoc:\n" ++
  "      if typeclass < Resource::ANY\n" ++
  "        n0 = Name.create(name)\n" ++
  "        msg.each_resource \{|n, ttl, data|\n" ++
  "          yield data if n0 == n\n" ++
  "        \}\n" ++
  "      end\n" ++
  "      yielded = false\n" ++
  "      n0 = Name.create(name)\n" ++
  "      msg.each_resource \{|n, ttl, data|\n" ++
  "        if n0 == n\n" ++
  "          case data\n" ++
  "          when typeclass\n" ++
  "            yield data\n" ++
  "            yielded = true\n" ++
  "          when Resource::CNAME\n" ++
  "            n0 = data.name\n" ++
  "          end\n" ++
  "        end\n" ++
  "      \}\n" ++
  "      return if yielded\n" ++
  "      msg.each_resource \{|n, ttl, data|\n" ++
  "        if n0 == n\n" ++
  "          case data\n" ++
  "          when typeclass\n" ++
  "            yield data\n" ++
  "          end\n" ++
  "        end\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.random(arg) # :nodoc:\n" ++
  "      begin\n" ++
  "        SecureRandom.random_number(arg)\n" ++
  "      rescue NotImplementedError\n" ++
  "        rand(arg)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    RequestID = \{\} # :nodoc:\n" ++
  "    RequestIDMutex = Thread::Mutex.new # :nodoc:\n" ++
  "\n" ++
  "    def self.allocate_request_id(host, port) # :nodoc:\n" ++
  "      id = nil\n" ++
  "      RequestIDMutex.synchronize \{\n" ++
  "        h = (RequestID[[host, port]] ||= \{\})\n" ++
  "        begin\n" ++
  "          id = random(0x0000..0xffff)\n" ++
  "        end while h[id]\n" ++
  "        h[id] = true\n" ++
  "      \}\n" ++
  "      id\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.free_request_id(host, port, id) # :nodoc:\n" ++
  "      RequestIDMutex.synchronize \{\n" ++
  "        key = [host, port]\n" ++
  "        if h = RequestID[key]\n" ++
  "          h.delete id\n" ++
  "          if h.empty?\n" ++
  "            RequestID.delete key\n" ++
  "          end\n" ++
  "        end\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    case RUBY_PLATFORM\n" ++
  "    when *[\n" ++
  "      # https://www.rfc-editor.org/rfc/rfc6056.txt\n" ++
  "      # Appendix A. Survey of the Algorithms in Use by Some Popular Implementations\n" ++
  "      /freebsd/, /linux/, /netbsd/, /openbsd/, /solaris/,\n" ++
  "      /darwin/, # the same as FreeBSD\n" ++
  "    ] then\n" ++
  "      def self.bind_random_port(udpsock, bind_host=\"0.0.0.0\") # :nodoc:\n" ++
  "        udpsock.bind(bind_host, 0)\n" ++
  "      end\n" ++
  "    else\n" ++
  "      # Sequential port assignment\n" ++
  "      def self.bind_random_port(udpsock, bind_host=\"0.0.0.0\") # :nodoc:\n" ++
  "        # Ephemeral port number range recommended by RFC 6056\n" ++
  "        port = random(1024..65535)\n" ++
  "        udpsock.bind(bind_host, port)\n" ++
  "      rescue Errno::EADDRINUSE, # POSIX\n" ++
  "             Errno::EACCES, # SunOS: See PRIV_SYS_NFS in privileges(5)\n" ++
  "             Errno::EPERM # FreeBSD: security.mac.portacl.port_high is configurable.  See mac_portacl(4).\n" ++
  "        retry\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class Requester # :nodoc:\n" ++
  "      def initialize\n" ++
  "        @senders = \{\}\n" ++
  "        @socks = nil\n" ++
  "      end\n" ++
  "\n" ++
  "      def request(sender, tout)\n" ++
  "        start = Process.clock_gettime(Process::CLOCK_MONOTONIC)\n" ++
  "        timelimit = start + tout\n" ++
  "        begin\n" ++
  "          sender.send\n" ++
  "        rescue Errno::EHOSTUNREACH, # multi-homed IPv6 may generate this\n" ++
  "               Errno::ENETUNREACH\n" ++
  "          raise ResolvTimeout\n" ++
  "        end\n" ++
  "        while true\n" ++
  "          before_select = Process.clock_gettime(Process::CLOCK_MONOTONIC)\n" ++
  "          timeout = timelimit - before_select\n" ++
  "          if timeout <= 0\n" ++
  "            raise ResolvTimeout\n" ++
  "          end\n" ++
  "          if @socks.size == 1\n" ++
  "            select_result = @socks[0].wait_readable(timeout) ? [ @socks ] : nil\n" ++
  "          else\n" ++
  "            select_result = IO.select(@socks, nil, nil, timeout)\n" ++
  "          end\n" ++
  "          if !select_result\n" ++
  "            after_select = Process.clock_gettime(Process::CLOCK_MONOTONIC)\n" ++
  "            next if after_select < timelimit\n" ++
  "            raise ResolvTimeout\n" ++
  "          end\n" ++
  "          begin\n" ++
  "            reply, from = recv_reply(select_result[0])\n" ++
  "          rescue Errno::ECONNREFUSED, # GNU/Linux, FreeBSD\n" ++
  "                 Errno::ECONNRESET, # Windows\n" ++
  "                 EOFError\n" ++
  "            # No name server running on the server?\n" ++
  "            # Don't wait anymore.\n" ++
  "            raise ResolvTimeout\n" ++
  "          end\n" ++
  "          begin\n" ++
  "            msg = Message.decode(reply)\n" ++
  "          rescue DecodeError\n" ++
  "            next # broken DNS message ignored\n" ++
  "          end\n" ++
  "          if sender == sender_for(from, msg)\n" ++
  "            break\n" ++
  "          else\n" ++
  "            # unexpected DNS message ignored\n" ++
  "          end\n" ++
  "        end\n" ++
  "        return msg, sender.data\n" ++
  "      end\n" ++
  "\n" ++
  "      def sender_for(addr, msg)\n" ++
  "        @senders[[addr,msg.id]]\n" ++
  "      end\n" ++
  "\n" ++
  "      def close\n" ++
  "        socks = @socks\n" ++
  "        @socks = nil\n" ++
  "        socks&.each(&:close)\n" ++
  "      end\n" ++
  "\n" ++
  "      class Sender # :nodoc:\n" ++
  "        def initialize(msg, data, sock)\n" ++
  "          @msg = msg\n" ++
  "          @data = data\n" ++
  "          @sock = sock\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      class UnconnectedUDP < Requester # :nodoc:\n" ++
  "        def initialize(*nameserver_port)\n" ++
  "          super()\n" ++
  "          @nameserver_port = nameserver_port\n" ++
  "          @initialized = false\n" ++
  "          @mutex = Thread::Mutex.new\n" ++
  "        end\n" ++
  "\n" ++
  "        def lazy_initialize\n" ++
  "          @mutex.synchronize \{\n" ++
  "            next if @initialized\n" ++
  "            @initialized = true\n" ++
  "            @socks_hash = \{\}\n" ++
  "            @socks = []\n" ++
  "            @nameserver_port.each \{|host, port|\n" ++
  "              if host.index(':')\n" ++
  "                bind_host = \"::\"\n" ++
  "                af = Socket::AF_INET6\n" ++
  "              else\n" ++
  "                bind_host = \"0.0.0.0\"\n" ++
  "                af = Socket::AF_INET\n" ++
  "              end\n" ++
  "              next if @socks_hash[bind_host]\n" ++
  "              begin\n" ++
  "                sock = UDPSocket.new(af)\n" ++
  "              rescue Errno::EAFNOSUPPORT, Errno::EPROTONOSUPPORT\n" ++
  "                next # The kernel doesn't support the address family.\n" ++
  "              end\n" ++
  "              @socks << sock\n" ++
  "              @socks_hash[bind_host] = sock\n" ++
  "              sock.do_not_reverse_lookup = true\n" ++
  "              DNS.bind_random_port(sock, bind_host)\n" ++
  "            \}\n" ++
  "          \}\n" ++
  "          self\n" ++
  "        end\n" ++
  "\n" ++
  "        def recv_reply(readable_socks)\n" ++
  "          lazy_initialize\n" ++
  "          reply, from = readable_socks[0].recvfrom(UDPSize)\n" ++
  "          return reply, [from[3],from[1]]\n" ++
  "        end\n" ++
  "\n" ++
  "        def sender(msg, data, host, port=Port)\n" ++
  "          host = Addrinfo.ip(host).ip_address\n" ++
  "          lazy_initialize\n" ++
  "          sock = @socks_hash[host.index(':') ? \"::\" : \"0.0.0.0\"]\n" ++
  "          return nil if !sock\n" ++
  "          service = [host, port]\n" ++
  "          id = DNS.allocate_request_id(host, port)\n" ++
  "          request = msg.encode\n" ++
  "          request[0,2] = [id].pack('n')\n" ++
  "          return @senders[[service, id]] =\n" ++
  "            Sender.new(request, data, sock, host, port)\n" ++
  "        end\n" ++
  "\n" ++
  "        def close\n" ++
  "          @mutex.synchronize \{\n" ++
  "            if @initialized\n" ++
  "              super\n" ++
  "              @senders.each_key \{|service, id|\n" ++
  "                DNS.free_request_id(service[0], service[1], id)\n" ++
  "              \}\n" ++
  "              @initialized = false\n" ++
  "            end\n" ++
  "          \}\n" ++
  "        end\n" ++
  "\n" ++
  "        class Sender < Requester::Sender # :nodoc:\n" ++
  "          def initialize(msg, data, sock, host, port)\n" ++
  "            super(msg, data, sock)\n" ++
  "            @host = host\n" ++
  "            @port = port\n" ++
  "          end\n" ++
  "          attr_reader :data\n" ++
  "\n" ++
  "          def send\n" ++
  "            raise \"@sock is nil.\" if @sock.nil?\n" ++
  "            @sock.send(@msg, 0, @host, @port)\n" ++
  "          end\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      class ConnectedUDP < Requester # :nodoc:\n" ++
  "        def initialize(host, port=Port)\n" ++
  "          super()\n" ++
  "          @host = host\n" ++
  "          @port = port\n" ++
  "          @mutex = Thread::Mutex.new\n" ++
  "          @initialized = false\n" ++
  "        end\n" ++
  "\n" ++
  "        def lazy_initialize\n" ++
  "          @mutex.synchronize \{\n" ++
  "            next if @initialized\n" ++
  "            @initialized = true\n" ++
  "            is_ipv6 = @host.index(':')\n" ++
  "            sock = UDPSocket.new(is_ipv6 ? Socket::AF_INET6 : Socket::AF_INET)\n" ++
  "            @socks = [sock]\n" ++
  "            sock.do_not_reverse_lookup = true\n" ++
  "            DNS.bind_random_port(sock, is_ipv6 ? \"::\" : \"0.0.0.0\")\n" ++
  "            sock.connect(@host, @port)\n" ++
  "          \}\n" ++
  "          self\n" ++
  "        end\n" ++
  "\n" ++
  "        def recv_reply(readable_socks)\n" ++
  "          lazy_initialize\n" ++
  "          reply = readable_socks[0].recv(UDPSize)\n" ++
  "          return reply, nil\n" ++
  "        end\n" ++
  "\n" ++
  "        def sender(msg, data, host=@host, port=@port)\n" ++
  "          lazy_initialize\n" ++
  "          unless host == @host && port == @port\n" ++
  "            raise RequestError.new(\"host/port don't match: #\{host\}:#\{port\}\")\n" ++
  "          end\n" ++
  "          id = DNS.allocate_request_id(@host, @port)\n" ++
  "          request = msg.encode\n" ++
  "          request[0,2] = [id].pack('n')\n" ++
  "          return @senders[[nil,id]] = Sender.new(request, data, @socks[0])\n" ++
  "        end\n" ++
  "\n" ++
  "        def close\n" ++
  "          @mutex.synchronize do\n" ++
  "            if @initialized\n" ++
  "              super\n" ++
  "              @senders.each_key \{|from, id|\n" ++
  "                DNS.free_request_id(@host, @port, id)\n" ++
  "              \}\n" ++
  "              @initialized = false\n" ++
  "            end\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        class Sender < Requester::Sender # :nodoc:\n" ++
  "          def send\n" ++
  "            raise \"@sock is nil.\" if @sock.nil?\n" ++
  "            @sock.send(@msg, 0)\n" ++
  "          end\n" ++
  "          attr_reader :data\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      class MDNSOneShot < UnconnectedUDP # :nodoc:\n" ++
  "        def sender(msg, data, host, port=Port)\n" ++
  "          lazy_initialize\n" ++
  "          id = DNS.allocate_request_id(host, port)\n" ++
  "          request = msg.encode\n" ++
  "          request[0,2] = [id].pack('n')\n" ++
  "          sock = @socks_hash[host.index(':') ? \"::\" : \"0.0.0.0\"]\n" ++
  "          return @senders[id] =\n" ++
  "            UnconnectedUDP::Sender.new(request, data, sock, host, port)\n" ++
  "        end\n" ++
  "\n" ++
  "        def sender_for(addr, msg)\n" ++
  "          lazy_initialize\n" ++
  "          @senders[msg.id]\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      class TCP < Requester # :nodoc:\n" ++
  "        def initialize(host, port=Port)\n" ++
  "          super()\n" ++
  "          @host = host\n" ++
  "          @port = port\n" ++
  "          sock = TCPSocket.new(@host, @port)\n" ++
  "          @socks = [sock]\n" ++
  "          @senders = \{\}\n" ++
  "        end\n" ++
  "\n" ++
  "        def recv_reply(readable_socks)\n" ++
  "          len_data = readable_socks[0].read(2)\n" ++
  "          raise EOFError if len_data.nil? || len_data.bytesize != 2\n" ++
  "          len = len_data.unpack('n')[0]\n" ++
  "          reply = @socks[0].read(len)\n" ++
  "          raise EOFError if reply.nil? || reply.bytesize != len\n" ++
  "          return reply, nil\n" ++
  "        end\n" ++
  "\n" ++
  "        def sender(msg, data, host=@host, port=@port)\n" ++
  "          unless host == @host && port == @port\n" ++
  "            raise RequestError.new(\"host/port don't match: #\{host\}:#\{port\}\")\n" ++
  "          end\n" ++
  "          id = DNS.allocate_request_id(@host, @port)\n" ++
  "          request = msg.encode\n" ++
  "          request[0,2] = [request.length, id].pack('nn')\n" ++
  "          return @senders[[nil,id]] = Sender.new(request, data, @socks[0])\n" ++
  "        end\n" ++
  "\n" ++
  "        class Sender < Requester::Sender # :nodoc:\n" ++
  "          def send\n" ++
  "            @sock.print(@msg)\n" ++
  "            @sock.flush\n" ++
  "          end\n" ++
  "          attr_reader :data\n" ++
  "        end\n" ++
  "\n" ++
  "        def close\n" ++
  "          super\n" ++
  "          @senders.each_key \{|from,id|\n" ++
  "            DNS.free_request_id(@host, @port, id)\n" ++
  "          \}\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Indicates a problem with the DNS request.\n" ++
  "\n" ++
  "      class RequestError < StandardError\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class Config # :nodoc:\n" ++
  "      def initialize(config_info=nil)\n" ++
  "        @mutex = Thread::Mutex.new\n" ++
  "        @config_info = config_info\n" ++
  "        @initialized = nil\n" ++
  "        @timeouts = nil\n" ++
  "      end\n" ++
  "\n" ++
  "      def timeouts=(values)\n" ++
  "        if values\n" ++
  "          values = Array(values)\n" ++
  "          values.each do |t|\n" ++
  "            Numeric === t or raise ArgumentError, \"#\{t.inspect\} is not numeric\"\n" ++
  "            t > 0.0 or raise ArgumentError, \"timeout=#\{t\} must be positive\"\n" ++
  "          end\n" ++
  "          @timeouts = values\n" ++
  "        else\n" ++
  "          @timeouts = nil\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def Config.parse_resolv_conf(filename)\n" ++
  "        nameserver = []\n" ++
  "        search = nil\n" ++
  "        ndots = 1\n" ++
  "        File.open(filename, 'rb') \{|f|\n" ++
  "          f.each \{|line|\n" ++
  "            line.sub!(/[#;].*/, '')\n" ++
  "            keyword, *args = line.split(/\\s+/)\n" ++
  "            next unless keyword\n" ++
  "            case keyword\n" ++
  "            when 'nameserver'\n" ++
  "              nameserver.concat(args.each(&:freeze))\n" ++
  "            when 'domain'\n" ++
  "              next if args.empty?\n" ++
  "              search = [args[0].freeze]\n" ++
  "            when 'search'\n" ++
  "              next if args.empty?\n" ++
  "              search = args.each(&:freeze)\n" ++
  "            when 'options'\n" ++
  "              args.each \{|arg|\n" ++
  "                case arg\n" ++
  "                when /\\Andots:(\\d+)\\z/\n" ++
  "                  ndots = $1.to_i\n" ++
  "                end\n" ++
  "              \}\n" ++
  "            end\n" ++
  "          \}\n" ++
  "        \}\n" ++
  "        return \{ :nameserver => nameserver.freeze, :search => search.freeze, :ndots => ndots.freeze \}.freeze\n" ++
  "      end\n" ++
  "\n" ++
  "      def Config.default_config_hash(filename=\"/etc/resolv.conf\")\n" ++
  "        if File.exist? filename\n" ++
  "          Config.parse_resolv_conf(filename)\n" ++
  "        elsif defined?(Win32::Resolv)\n" ++
  "          search, nameserver = Win32::Resolv.get_resolv_info\n" ++
  "          config_hash = \{\}\n" ++
  "          config_hash[:nameserver] = nameserver if nameserver\n" ++
  "          config_hash[:search] = [search].flatten if search\n" ++
  "          config_hash\n" ++
  "        else\n" ++
  "          \{\}\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def lazy_initialize\n" ++
  "        @mutex.synchronize \{\n" ++
  "          unless @initialized\n" ++
  "            @nameserver_port = []\n" ++
  "            @use_ipv6 = nil\n" ++
  "            @search = nil\n" ++
  "            @ndots = 1\n" ++
  "            case @config_info\n" ++
  "            when nil\n" ++
  "              config_hash = Config.default_config_hash\n" ++
  "            when String\n" ++
  "              config_hash = Config.parse_resolv_conf(@config_info)\n" ++
  "            when Hash\n" ++
  "              config_hash = @config_info.dup\n" ++
  "              if String === config_hash[:nameserver]\n" ++
  "                config_hash[:nameserver] = [config_hash[:nameserver]]\n" ++
  "              end\n" ++
  "              if String === config_hash[:search]\n" ++
  "                config_hash[:search] = [config_hash[:search]]\n" ++
  "              end\n" ++
  "            else\n" ++
  "              raise ArgumentError.new(\"invalid resolv configuration: #\{@config_info.inspect\}\")\n" ++
  "            end\n" ++
  "            if config_hash.include? :nameserver\n" ++
  "              @nameserver_port = config_hash[:nameserver].map \{|ns| [ns, Port] \}\n" ++
  "            end\n" ++
  "            if config_hash.include? :nameserver_port\n" ++
  "              @nameserver_port = config_hash[:nameserver_port].map \{|ns, port| [ns, (port || Port)] \}\n" ++
  "            end\n" ++
  "            if config_hash.include? :use_ipv6\n" ++
  "              @use_ipv6 = config_hash[:use_ipv6]\n" ++
  "            end\n" ++
  "            @search = config_hash[:search] if config_hash.include? :search\n" ++
  "            @ndots = config_hash[:ndots] if config_hash.include? :ndots\n" ++
  "            @raise_timeout_errors = config_hash[:raise_timeout_errors]\n" ++
  "\n" ++
  "            if @nameserver_port.empty?\n" ++
  "              @nameserver_port << ['0.0.0.0', Port]\n" ++
  "            end\n" ++
  "            if @search\n" ++
  "              @search = @search.map \{|arg| Label.split(arg) \}\n" ++
  "            else\n" ++
  "              hostname = Socket.gethostname\n" ++
  "              if /\\./ =~ hostname\n" ++
  "                @search = [Label.split($')]\n" ++
  "              else\n" ++
  "                @search = [[]]\n" ++
  "              end\n" ++
  "            end\n" ++
  "\n" ++
  "            if !@nameserver_port.kind_of?(Array) ||\n" ++
  "               @nameserver_port.any? \{|ns_port|\n" ++
  "                  !(Array === ns_port) ||\n" ++
  "                  ns_port.length != 2\n" ++
  "                  !(String === ns_port[0]) ||\n" ++
  "                  !(Integer === ns_port[1])\n" ++
  "               \}\n" ++
  "              raise ArgumentError.new(\"invalid nameserver config: #\{@nameserver_port.inspect\}\")\n" ++
  "            end\n" ++
  "\n" ++
  "            if !@search.kind_of?(Array) ||\n" ++
  "               !@search.all? \{|ls| ls.all? \{|l| Label::Str === l \} \}\n" ++
  "              raise ArgumentError.new(\"invalid search config: #\{@search.inspect\}\")\n" ++
  "            end\n" ++
  "\n" ++
  "            if !@ndots.kind_of?(Integer)\n" ++
  "              raise ArgumentError.new(\"invalid ndots config: #\{@ndots.inspect\}\")\n" ++
  "            end\n" ++
  "\n" ++
  "            @initialized = true\n" ++
  "          end\n" ++
  "        \}\n" ++
  "        self\n" ++
  "      end\n" ++
  "\n" ++
  "      def single?\n" ++
  "        lazy_initialize\n" ++
  "        if @nameserver_port.length == 1\n" ++
  "          return @nameserver_port[0]\n" ++
  "        else\n" ++
  "          return nil\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def nameserver_port\n" ++
  "        @nameserver_port\n" ++
  "      end\n" ++
  "\n" ++
  "      def use_ipv6?\n" ++
  "        @use_ipv6\n" ++
  "      end\n" ++
  "\n" ++
  "      def generate_candidates(name)\n" ++
  "        candidates = nil\n" ++
  "        name = Name.create(name)\n" ++
  "        if name.absolute?\n" ++
  "          candidates = [name]\n" ++
  "        else\n" ++
  "          if @ndots <= name.length - 1\n" ++
  "            candidates = [Name.new(name.to_a)]\n" ++
  "          else\n" ++
  "            candidates = []\n" ++
  "          end\n" ++
  "          candidates.concat(@search.map \{|domain| Name.new(name.to_a + domain)\})\n" ++
  "          fname = Name.create(\"#\{name\}.\")\n" ++
  "          if !candidates.include?(fname)\n" ++
  "            candidates << fname\n" ++
  "          end\n" ++
  "        end\n" ++
  "        return candidates\n" ++
  "      end\n" ++
  "\n" ++
  "      InitialTimeout = 5\n" ++
  "\n" ++
  "      def generate_timeouts\n" ++
  "        ts = [InitialTimeout]\n" ++
  "        ts << ts[-1] * 2 / @nameserver_port.length\n" ++
  "        ts << ts[-1] * 2\n" ++
  "        ts << ts[-1] * 2\n" ++
  "        return ts\n" ++
  "      end\n" ++
  "\n" ++
  "      def resolv(name)\n" ++
  "        candidates = generate_candidates(name)\n" ++
  "        timeouts = @timeouts || generate_timeouts\n" ++
  "        timeout_error = false\n" ++
  "        begin\n" ++
  "          candidates.each \{|candidate|\n" ++
  "            begin\n" ++
  "              timeouts.each \{|tout|\n" ++
  "                @nameserver_port.each \{|nameserver, port|\n" ++
  "                  begin\n" ++
  "                    yield candidate, tout, nameserver, port\n" ++
  "                  rescue ResolvTimeout\n" ++
  "                  end\n" ++
  "                \}\n" ++
  "              \}\n" ++
  "              timeout_error = true\n" ++
  "              raise ResolvError.new(\"DNS resolv timeout: #\{name\}\")\n" ++
  "            rescue NXDomain\n" ++
  "            end\n" ++
  "          \}\n" ++
  "        rescue ResolvError\n" ++
  "          raise if @raise_timeout_errors && timeout_error\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Indicates no such domain was found.\n" ++
  "\n" ++
  "      class NXDomain < ResolvError\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Indicates some other unhandled resolver error was encountered.\n" ++
  "\n" ++
  "      class OtherResolvError < ResolvError\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    module OpCode # :nodoc:\n" ++
  "      Query = 0\n" ++
  "      IQuery = 1\n" ++
  "      Status = 2\n" ++
  "      Notify = 4\n" ++
  "      Update = 5\n" ++
  "    end\n" ++
  "\n" ++
  "    module RCode # :nodoc:\n" ++
  "      NoError = 0\n" ++
  "      FormErr = 1\n" ++
  "      ServFail = 2\n" ++
  "      NXDomain = 3\n" ++
  "      NotImp = 4\n" ++
  "      Refused = 5\n" ++
  "      YXDomain = 6\n" ++
  "      YXRRSet = 7\n" ++
  "      NXRRSet = 8\n" ++
  "      NotAuth = 9\n" ++
  "      NotZone = 10\n" ++
  "      BADVERS = 16\n" ++
  "      BADSIG = 16\n" ++
  "      BADKEY = 17\n" ++
  "      BADTIME = 18\n" ++
  "      BADMODE = 19\n" ++
  "      BADNAME = 20\n" ++
  "      BADALG = 21\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Indicates that the DNS response was unable to be decoded.\n" ++
  "\n" ++
  "    class DecodeError < StandardError\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Indicates that the DNS request was unable to be encoded.\n" ++
  "\n" ++
  "    class EncodeError < StandardError\n" ++
  "    end\n" ++
  "\n" ++
  "    module Label # :nodoc:\n" ++
  "      def self.split(arg)\n" ++
  "        labels = []\n" ++
  "        arg.scan(/[^\\.]+/) \{labels << Str.new($&)\}\n" ++
  "        return labels\n" ++
  "      end\n" ++
  "\n" ++
  "      class Str # :nodoc:\n" ++
  "        def initialize(string)\n" ++
  "          # A label is limited to 63 octets. [RFC 1035 2.3.4] Checking it here\n" ++
  "          # makes it an invariant of the object: every label, however it was\n" ++
  "          # built, fits in its length octet and cannot wrap it. Callers turn\n" ++
  "          # this into the error their own contract promises.\n" ++
  "          if string.bytesize > 63\n" ++
  "            raise ArgumentError, \"DNS label is too long (#\{string.bytesize\} bytes, max 63): #\{string.inspect\}\"\n" ++
  "          end\n" ++
  "          @string = string\n" ++
  "          # case insensivity of DNS labels doesn't apply non-ASCII characters. [RFC 4343]\n" ++
  "          # This assumes @string is given in ASCII compatible encoding.\n" ++
  "          @downcase = string.b.downcase\n" ++
  "        end\n" ++
  "        attr_reader :string, :downcase\n" ++
  "\n" ++
  "        def to_s\n" ++
  "          return @string\n" ++
  "        end\n" ++
  "\n" ++
  "        def inspect\n" ++
  "          return \"#<#\{self.class\} #\{self\}>\"\n" ++
  "        end\n" ++
  "\n" ++
  "        def ==(other)\n" ++
  "          return self.class == other.class && @downcase == other.downcase\n" ++
  "        end\n" ++
  "\n" ++
  "        def eql?(other)\n" ++
  "          return self == other\n" ++
  "        end\n" ++
  "\n" ++
  "        def hash\n" ++
  "          return @downcase.hash\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A representation of a DNS name.\n" ++
  "\n" ++
  "    class Name\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Creates a new DNS name from +arg+.  +arg+ can be:\n" ++
  "      #\n" ++
  "      # Name:: returns +arg+.\n" ++
  "      # String:: Creates a new Name.\n" ++
  "\n" ++
  "      def self.create(arg)\n" ++
  "        case arg\n" ++
  "        when Name\n" ++
  "          return arg\n" ++
  "        when String\n" ++
  "          # A hostname is runtime data rather than a programming mistake, so\n" ++
  "          # both size limits surface as ResolvError to stay rescuable alongside\n" ++
  "          # the rest of name resolution. The type check below is a caller\n" ++
  "          # mistake and keeps raising ArgumentError.\n" ++
  "          begin\n" ++
  "            labels = Label.split(arg)\n" ++
  "          rescue ArgumentError => e\n" ++
  "            raise ResolvError.new(e.message)\n" ++
  "          end\n" ++
  "          # Label::Str enforces the per-label limit. Only the total is knowable\n" ++
  "          # here, and it counts the encoded form, so size starts at 1 for the\n" ++
  "          # root label's terminating zero octet. [RFC 1035 2.3.4, 3.1]\n" ++
  "          size = 1\n" ++
  "          labels.each do |label|\n" ++
  "            size += 1 + label.string.bytesize\n" ++
  "            if size > 255\n" ++
  "              raise ResolvError.new(\"DNS name is too long (#\{size\} octets, max 255): #\{arg.inspect\}\")\n" ++
  "            end\n" ++
  "          end\n" ++
  "          return Name.new(labels, /\\.\\z/ =~ arg ? true : false)\n" ++
  "        else\n" ++
  "          raise ArgumentError.new(\"cannot interpret as DNS name: #\{arg.inspect\}\")\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def initialize(labels, absolute=true) # :nodoc:\n" ++
  "        labels = labels.map \{|label|\n" ++
  "          case label\n" ++
  "          when String then Label::Str.new(label)\n" ++
  "          when Label::Str then label\n" ++
  "          else\n" ++
  "            raise ArgumentError, \"unexpected label: #\{label.inspect\}\"\n" ++
  "          end\n" ++
  "        \}\n" ++
  "        @labels = labels\n" ++
  "        @absolute = absolute\n" ++
  "      end\n" ++
  "\n" ++
  "      def inspect # :nodoc:\n" ++
  "        \"#<#\{self.class\}: #\{self\}#\{@absolute ? '.' : ''\}>\"\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # True if this name is absolute.\n" ++
  "\n" ++
  "      def absolute?\n" ++
  "        return @absolute\n" ++
  "      end\n" ++
  "\n" ++
  "      def ==(other) # :nodoc:\n" ++
  "        return false unless Name === other\n" ++
  "        return false unless @absolute == other.absolute?\n" ++
  "        return @labels == other.to_a\n" ++
  "      end\n" ++
  "\n" ++
  "      alias eql? == # :nodoc:\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Returns true if +other+ is a subdomain.\n" ++
  "      #\n" ++
  "      # Example:\n" ++
  "      #\n" ++
  "      #   domain = Resolv::DNS::Name.create(\"y.z\")\n" ++
  "      #   p Resolv::DNS::Name.create(\"w.x.y.z\").subdomain_of?(domain) #=> true\n" ++
  "      #   p Resolv::DNS::Name.create(\"x.y.z\").subdomain_of?(domain) #=> true\n" ++
  "      #   p Resolv::DNS::Name.create(\"y.z\").subdomain_of?(domain) #=> false\n" ++
  "      #   p Resolv::DNS::Name.create(\"z\").subdomain_of?(domain) #=> false\n" ++
  "      #   p Resolv::DNS::Name.create(\"x.y.z.\").subdomain_of?(domain) #=> false\n" ++
  "      #   p Resolv::DNS::Name.create(\"w.z\").subdomain_of?(domain) #=> false\n" ++
  "      #\n" ++
  "\n" ++
  "      def subdomain_of?(other)\n" ++
  "        raise ArgumentError, \"not a domain name: #\{other.inspect\}\" unless Name === other\n" ++
  "        return false if @absolute != other.absolute?\n" ++
  "        other_len = other.length\n" ++
  "        return false if @labels.length <= other_len\n" ++
  "        return @labels[-other_len, other_len] == other.to_a\n" ++
  "      end\n" ++
  "\n" ++
  "      def hash # :nodoc:\n" ++
  "        return @labels.hash ^ @absolute.hash\n" ++
  "      end\n" ++
  "\n" ++
  "      def to_a # :nodoc:\n" ++
  "        return @labels\n" ++
  "      end\n" ++
  "\n" ++
  "      def length # :nodoc:\n" ++
  "        return @labels.length\n" ++
  "      end\n" ++
  "\n" ++
  "      def [](i) # :nodoc:\n" ++
  "        return @labels[i]\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # returns the domain name as a string.\n" ++
  "      #\n" ++
  "      # The domain name doesn't have a trailing dot even if the name object is\n" ++
  "      # absolute.\n" ++
  "      #\n" ++
  "      # Example:\n" ++
  "      #\n" ++
  "      #   p Resolv::DNS::Name.create(\"x.y.z.\").to_s #=> \"x.y.z\"\n" ++
  "      #   p Resolv::DNS::Name.create(\"x.y.z\").to_s #=> \"x.y.z\"\n" ++
  "\n" ++
  "      def to_s\n" ++
  "        return @labels.join('.')\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class Message # :nodoc:\n" ++
  "      @@identifier = -1\n" ++
  "\n" ++
  "      def initialize(id = (@@identifier += 1) & 0xffff)\n" ++
  "        @id = id\n" ++
  "        @qr = 0\n" ++
  "        @opcode = 0\n" ++
  "        @aa = 0\n" ++
  "        @tc = 0\n" ++
  "        @rd = 0 # recursion desired\n" ++
  "        @ra = 0 # recursion available\n" ++
  "        @rcode = 0\n" ++
  "        @question = []\n" ++
  "        @answer = []\n" ++
  "        @authority = []\n" ++
  "        @additional = []\n" ++
  "      end\n" ++
  "\n" ++
  "      attr_accessor :id, :qr, :opcode, :aa, :tc, :rd, :ra, :rcode\n" ++
  "      attr_reader :question, :answer, :authority, :additional\n" ++
  "\n" ++
  "      def ==(other)\n" ++
  "        return @id == other.id &&\n" ++
  "               @qr == other.qr &&\n" ++
  "               @opcode == other.opcode &&\n" ++
  "               @aa == other.aa &&\n" ++
  "               @tc == other.tc &&\n" ++
  "               @rd == other.rd &&\n" ++
  "               @ra == other.ra &&\n" ++
  "               @rcode == other.rcode &&\n" ++
  "               question_equal?(other.question) &&\n" ++
  "               @answer == other.answer &&\n" ++
  "               @authority == other.authority &&\n" ++
  "               @additional == other.additional\n" ++
  "      end\n" ++
  "\n" ++
  "      # A question holds the resource class itself, and decoding creates a fresh\n" ++
  "      # class for each unknown type, so the classes cannot be compared by\n" ++
  "      # identity alone.\n" ++
  "      private def question_equal?(other_question) # :nodoc:\n" ++
  "        return false unless @question.length == other_question.length\n" ++
  "        @question.zip(other_question) \{|(name, typeclass), (o_name, o_typeclass)|\n" ++
  "          return false unless name == o_name &&\n" ++
  "                              Resource::Generic.type_class_equal?(typeclass, o_typeclass)\n" ++
  "        \}\n" ++
  "        return true\n" ++
  "      end\n" ++
  "\n" ++
  "      def add_question(name, typeclass)\n" ++
  "        @question << [Name.create(name), typeclass]\n" ++
  "      end\n" ++
  "\n" ++
  "      def each_question\n" ++
  "        @question.each \{|name, typeclass|\n" ++
  "          yield name, typeclass\n" ++
  "        \}\n" ++
  "      end\n" ++
  "\n" ++
  "      def add_answer(name, ttl, data)\n" ++
  "        @answer << [Name.create(name), ttl, data]\n" ++
  "      end\n" ++
  "\n" ++
  "      def each_answer\n" ++
  "        @answer.each \{|name, ttl, data|\n" ++
  "          yield name, ttl, data\n" ++
  "        \}\n" ++
  "      end\n" ++
  "\n" ++
  "      def add_authority(name, ttl, data)\n" ++
  "        @authority << [Name.create(name), ttl, data]\n" ++
  "      end\n" ++
  "\n" ++
  "      def each_authority\n" ++
  "        @authority.each \{|name, ttl, data|\n" ++
  "          yield name, ttl, data\n" ++
  "        \}\n" ++
  "      end\n" ++
  "\n" ++
  "      def add_additional(name, ttl, data)\n" ++
  "        @additional << [Name.create(name), ttl, data]\n" ++
  "      end\n" ++
  "\n" ++
  "      def each_additional\n" ++
  "        @additional.each \{|name, ttl, data|\n" ++
  "          yield name, ttl, data\n" ++
  "        \}\n" ++
  "      end\n" ++
  "\n" ++
  "      def each_resource\n" ++
  "        each_answer \{|name, ttl, data| yield name, ttl, data\}\n" ++
  "        each_authority \{|name, ttl, data| yield name, ttl, data\}\n" ++
  "        each_additional \{|name, ttl, data| yield name, ttl, data\}\n" ++
  "      end\n" ++
  "\n" ++
  "      def encode\n" ++
  "        return MessageEncoder.new \{|msg|\n" ++
  "          msg.put_pack('nnnnnn',\n" ++
  "            @id,\n" ++
  "            (@qr & 1) << 15 |\n" ++
  "            (@opcode & 15) << 11 |\n" ++
  "            (@aa & 1) << 10 |\n" ++
  "            (@tc & 1) << 9 |\n" ++
  "            (@rd & 1) << 8 |\n" ++
  "            (@ra & 1) << 7 |\n" ++
  "            (@rcode & 15),\n" ++
  "            @question.length,\n" ++
  "            @answer.length,\n" ++
  "            @authority.length,\n" ++
  "            @additional.length)\n" ++
  "          @question.each \{|q|\n" ++
  "            name, typeclass = q\n" ++
  "            msg.put_name(name)\n" ++
  "            msg.put_pack('nn', typeclass::TypeValue, typeclass::ClassValue)\n" ++
  "          \}\n" ++
  "          [@answer, @authority, @additional].each \{|rr|\n" ++
  "            rr.each \{|r|\n" ++
  "              name, ttl, data = r\n" ++
  "              msg.put_name(name)\n" ++
  "              msg.put_pack('nnN', data.class::TypeValue, data.class::ClassValue, ttl)\n" ++
  "              msg.put_length16 \{data.encode_rdata(msg)\}\n" ++
  "            \}\n" ++
  "          \}\n" ++
  "        \}.to_s\n" ++
  "      end\n" ++
  "\n" ++
  "      class MessageEncoder # :nodoc:\n" ++
  "        def initialize\n" ++
  "          @data = ''.dup\n" ++
  "          @names = \{\}\n" ++
  "          yield self\n" ++
  "        end\n" ++
  "\n" ++
  "        def to_s\n" ++
  "          return @data\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_bytes(d)\n" ++
  "          @data << d\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_pack(template, *d)\n" ++
  "          @data << d.pack(template)\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_length16\n" ++
  "          length_index = @data.length\n" ++
  "          @data << \"\\0\\0\"\n" ++
  "          data_start = @data.length\n" ++
  "          yield\n" ++
  "          data_end = @data.length\n" ++
  "          @data[length_index, 2] = [data_end - data_start].pack(\"n\")\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_string(d)\n" ++
  "          s = d.to_s\n" ++
  "          # A character-string is prefixed by a single length octet, so it can\n" ++
  "          # hold at most 255 octets. [RFC 1035 3.3] Reject anything longer to\n" ++
  "          # avoid silently truncating the length to its low 8 bits (mod 256).\n" ++
  "          if s.bytesize > 255\n" ++
  "            raise ArgumentError, \"character-string is too long (#\{s.bytesize\} bytes, max 255): #\{s.inspect\}\"\n" ++
  "          end\n" ++
  "          self.put_pack(\"C\", s.bytesize)\n" ++
  "          @data << s\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_string_list(ds)\n" ++
  "          ds.each \{|d|\n" ++
  "            self.put_string(d)\n" ++
  "          \}\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_name(d, compress: true)\n" ++
  "          put_labels(d.to_a, compress: compress)\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_labels(d, compress: true)\n" ++
  "          d.each_index \{|i|\n" ++
  "            domain = d[i..-1]\n" ++
  "            if compress && idx = @names[domain]\n" ++
  "              self.put_pack(\"n\", 0xc000 | idx)\n" ++
  "              return\n" ++
  "            else\n" ++
  "              if @data.length < 0x4000\n" ++
  "                @names[domain] = @data.length\n" ++
  "              end\n" ++
  "              self.put_label(d[i])\n" ++
  "            end\n" ++
  "          \}\n" ++
  "          @data << \"\\0\"\n" ++
  "        end\n" ++
  "\n" ++
  "        def put_label(d)\n" ++
  "          s = d.to_s\n" ++
  "          # Label::Str applies this limit when a label is built, so what is left\n" ++
  "          # for here is a raw string handed straight to put_labels. The two ways\n" ++
  "          # an over-long label goes wrong differ: 64 to 255 octets write a length\n" ++
  "          # octet in the reserved or compression pointer range, and 256 or more\n" ++
  "          # wrap it mod 256. Either way the encoded name stops being the name the\n" ++
  "          # caller asked for. [RFC 1035 2.3.4, 4.1.4]\n" ++
  "          if s.bytesize > 63\n" ++
  "            raise ArgumentError, \"DNS label is too long (#\{s.bytesize\} bytes, max 63): #\{s.inspect\}\"\n" ++
  "          end\n" ++
  "          self.put_string(s)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def Message.decode(m)\n" ++
  "        o = Message.new(0)\n" ++
  "        MessageDecoder.new(m) \{|msg|\n" ++
  "          id, flag, qdcount, ancount, nscount, arcount =\n" ++
  "            msg.get_unpack('nnnnnn')\n" ++
  "          o.id = id\n" ++
  "          o.tc = (flag >> 9) & 1\n" ++
  "          o.rcode = flag & 15\n" ++
  "          return o unless o.tc.zero?\n" ++
  "\n" ++
  "          o.qr = (flag >> 15) & 1\n" ++
  "          o.opcode = (flag >> 11) & 15\n" ++
  "          o.aa = (flag >> 10) & 1\n" ++
  "          o.rd = (flag >> 8) & 1\n" ++
  "          o.ra = (flag >> 7) & 1\n" ++
  "          (1..qdcount).each \{\n" ++
  "            name, typeclass = msg.get_question\n" ++
  "            o.add_question(name, typeclass)\n" ++
  "          \}\n" ++
  "          (1..ancount).each \{\n" ++
  "            name, ttl, data = msg.get_rr\n" ++
  "            o.add_answer(name, ttl, data)\n" ++
  "          \}\n" ++
  "          (1..nscount).each \{\n" ++
  "            name, ttl, data = msg.get_rr\n" ++
  "            o.add_authority(name, ttl, data)\n" ++
  "          \}\n" ++
  "          (1..arcount).each \{\n" ++
  "            name, ttl, data = msg.get_rr\n" ++
  "            o.add_additional(name, ttl, data)\n" ++
  "          \}\n" ++
  "        \}\n" ++
  "        return o\n" ++
  "      end\n" ++
  "\n" ++
  "      class MessageDecoder # :nodoc:\n" ++
  "        def initialize(data)\n" ++
  "          @data = data\n" ++
  "          @index = 0\n" ++
  "          @limit = data.bytesize\n" ++
  "          yield self\n" ++
  "        end\n" ++
  "\n" ++
  "        def inspect\n" ++
  "          \"\\#<#\{self.class\}: #\{@data.byteslice(0, @index).inspect\} #\{@data.byteslice(@index..-1).inspect\}>\"\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_length16\n" ++
  "          len, = self.get_unpack('n')\n" ++
  "          save_limit = @limit\n" ++
  "          @limit = @index + len\n" ++
  "          d = yield(len)\n" ++
  "          if @index < @limit\n" ++
  "            raise DecodeError.new(\"junk exists\")\n" ++
  "          elsif @limit < @index\n" ++
  "            raise DecodeError.new(\"limit exceeded\")\n" ++
  "          end\n" ++
  "          @limit = save_limit\n" ++
  "          return d\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_bytes(len = @limit - @index)\n" ++
  "          raise DecodeError.new(\"limit exceeded\") if @limit < @index + len\n" ++
  "          d = @data.byteslice(@index, len)\n" ++
  "          @index += len\n" ++
  "          return d\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_unpack(template)\n" ++
  "          len = 0\n" ++
  "          template.each_byte \{|byte|\n" ++
  "            byte = \"%c\" % byte\n" ++
  "            case byte\n" ++
  "            when ?c, ?C\n" ++
  "              len += 1\n" ++
  "            when ?n\n" ++
  "              len += 2\n" ++
  "            when ?N\n" ++
  "              len += 4\n" ++
  "            else\n" ++
  "              raise StandardError.new(\"unsupported template: '#\{byte.chr\}' in '#\{template\}'\")\n" ++
  "            end\n" ++
  "          \}\n" ++
  "          raise DecodeError.new(\"limit exceeded\") if @limit < @index + len\n" ++
  "          arr = @data.unpack(\"@#\{@index\}#\{template\}\")\n" ++
  "          @index += len\n" ++
  "          return arr\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_string\n" ++
  "          raise DecodeError.new(\"limit exceeded\") if @limit <= @index\n" ++
  "          len = @data.getbyte(@index)\n" ++
  "          raise DecodeError.new(\"limit exceeded\") if @limit < @index + 1 + len\n" ++
  "          d = @data.byteslice(@index + 1, len)\n" ++
  "          @index += 1 + len\n" ++
  "          return d\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_string_list\n" ++
  "          strings = []\n" ++
  "          while @index < @limit\n" ++
  "            strings << self.get_string\n" ++
  "          end\n" ++
  "          strings\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_list\n" ++
  "          [].tap do |values|\n" ++
  "            while @index < @limit\n" ++
  "              values << yield\n" ++
  "            end\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_name\n" ++
  "          return Name.new(self.get_labels)\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_labels\n" ++
  "          prev_index = @index\n" ++
  "          save_index = nil\n" ++
  "          d = []\n" ++
  "          # size counts the encoded form, so it starts at 1 for the root\n" ++
  "          # label's terminating zero octet. [RFC 1035 3.1]\n" ++
  "          size = 1\n" ++
  "          while true\n" ++
  "            raise DecodeError.new(\"limit exceeded\") if @limit <= @index\n" ++
  "            case @data.getbyte(@index)\n" ++
  "            when 0\n" ++
  "              @index += 1\n" ++
  "              if save_index\n" ++
  "                @index = save_index\n" ++
  "              end\n" ++
  "              return d\n" ++
  "            when 192..255\n" ++
  "              idx = self.get_unpack('n')[0] & 0x3fff\n" ++
  "              if prev_index <= idx\n" ++
  "                raise DecodeError.new(\"non-backward name pointer\")\n" ++
  "              end\n" ++
  "              prev_index = idx\n" ++
  "              if !save_index\n" ++
  "                save_index = @index\n" ++
  "              end\n" ++
  "              @index = idx\n" ++
  "            else\n" ++
  "              l = self.get_label\n" ++
  "              d << l\n" ++
  "              size += 1 + l.string.bytesize\n" ++
  "              raise DecodeError.new(\"name label data exceed 255 octets\") if size > 255\n" ++
  "            end\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_label\n" ++
  "          return Label::Str.new(self.get_string)\n" ++
  "        rescue ArgumentError => e\n" ++
  "          # A length octet of 64..191 is reserved rather than a label length,\n" ++
  "          # but this decoder used to read it as one. [RFC 1035 4.1.4] Report it\n" ++
  "          # the way the rest of a malformed message is reported.\n" ++
  "          raise DecodeError.new(e.message)\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_question\n" ++
  "          name = self.get_name\n" ++
  "          type, klass = self.get_unpack(\"nn\")\n" ++
  "          return name, Resource.get_class(type, klass)\n" ++
  "        end\n" ++
  "\n" ++
  "        def get_rr\n" ++
  "          name = self.get_name\n" ++
  "          type, klass, ttl = self.get_unpack('nnN')\n" ++
  "          typeclass = Resource.get_class(type, klass)\n" ++
  "          res = self.get_length16 do\n" ++
  "            begin\n" ++
  "              typeclass.decode_rdata self\n" ++
  "            rescue => e\n" ++
  "              raise DecodeError, e.message, e.backtrace\n" ++
  "            end\n" ++
  "          end\n" ++
  "          res.instance_variable_set :@ttl, ttl\n" ++
  "          return name, ttl, res\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # SvcParams for service binding RRs. [RFC9460]\n" ++
  "\n" ++
  "    class SvcParams\n" ++
  "      include Enumerable\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Create a list of SvcParams with the given initial content.\n" ++
  "      #\n" ++
  "      # +params+ has to be an enumerable of +SvcParam+s.\n" ++
  "      # If its content has +SvcParam+s with the duplicate key,\n" ++
  "      # the one appears last takes precedence.\n" ++
  "\n" ++
  "      def initialize(params = [])\n" ++
  "        @params = \{\}\n" ++
  "\n" ++
  "        params.each do |param|\n" ++
  "          add param\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Get SvcParam for the given +key+ in this list.\n" ++
  "\n" ++
  "      def [](key)\n" ++
  "        @params[canonical_key(key)]\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Get the number of SvcParams in this list.\n" ++
  "\n" ++
  "      def count\n" ++
  "        @params.count\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Get whether this list is empty.\n" ++
  "\n" ++
  "      def empty?\n" ++
  "        @params.empty?\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Add the SvcParam +param+ to this list, overwriting the existing one with the same key.\n" ++
  "\n" ++
  "      def add(param)\n" ++
  "        @params[param.class.key_number] = param\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Remove the +SvcParam+ with the given +key+ and return it.\n" ++
  "\n" ++
  "      def delete(key)\n" ++
  "        @params.delete(canonical_key(key))\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Enumerate the +SvcParam+s in this list.\n" ++
  "\n" ++
  "      def each(&block)\n" ++
  "        return enum_for(:each) unless block\n" ++
  "        @params.each_value(&block)\n" ++
  "      end\n" ++
  "\n" ++
  "      def encode(msg) # :nodoc:\n" ++
  "        @params.keys.sort.each do |key|\n" ++
  "          msg.put_pack('n', key)\n" ++
  "          msg.put_length16 do\n" ++
  "            @params.fetch(key).encode(msg)\n" ++
  "          end\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def self.decode(msg) # :nodoc:\n" ++
  "        params = msg.get_list do\n" ++
  "          key, = msg.get_unpack('n')\n" ++
  "          msg.get_length16 do\n" ++
  "            SvcParam::ClassHash[key].decode(msg)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        return self.new(params)\n" ++
  "      end\n" ++
  "\n" ++
  "      private\n" ++
  "\n" ++
  "      def canonical_key(key) # :nodoc:\n" ++
  "        case key\n" ++
  "        when Integer\n" ++
  "          key\n" ++
  "        when /\\Akey(\\d+)\\z/\n" ++
  "          Integer($1)\n" ++
  "        when Symbol\n" ++
  "          SvcParam::ClassHash[key].key_number\n" ++
  "        else\n" ++
  "          raise TypeError, 'key must be either String or Symbol'\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Base class for SvcParam. [RFC9460]\n" ++
  "\n" ++
  "    class SvcParam\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Get the presentation name of the SvcParamKey.\n" ++
  "\n" ++
  "      def self.key_name\n" ++
  "        const_get(:KeyName)\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Get the registered number of the SvcParamKey.\n" ++
  "\n" ++
  "      def self.key_number\n" ++
  "        const_get(:KeyNumber)\n" ++
  "      end\n" ++
  "\n" ++
  "      ClassHash = Hash.new do |h, key| # :nodoc:\n" ++
  "        case key\n" ++
  "        when Integer\n" ++
  "          Generic.create(key)\n" ++
  "        when /\\Akey(?<key>\\d+)\\z/\n" ++
  "          Generic.create(key.to_int)\n" ++
  "        when Symbol\n" ++
  "          raise KeyError, \"unknown key #\{key\}\"\n" ++
  "        else\n" ++
  "          raise TypeError, 'key must be either String or Symbol'\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Generic SvcParam abstract class.\n" ++
  "\n" ++
  "      class Generic < SvcParam\n" ++
  "\n" ++
  "        ##\n" ++
  "        # SvcParamValue in wire-format byte string.\n" ++
  "\n" ++
  "        attr_reader :value\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Create generic SvcParam\n" ++
  "\n" ++
  "        def initialize(value)\n" ++
  "          @value = value\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          msg.put_bytes(@value)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          return self.new(msg.get_bytes)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.create(key_number)\n" ++
  "          c = Class.new(Generic)\n" ++
  "          key_name = :\"key#\{key_number\}\"\n" ++
  "          c.const_set(:KeyName, key_name)\n" ++
  "          c.const_set(:KeyNumber, key_number)\n" ++
  "          # Not registered in a constant or in ClassHash. ClassHash creates a\n" ++
  "          # class for every unknown SvcParamKey, so registering them\n" ++
  "          # permanently would let a malicious response exhaust memory.\n" ++
  "          return c\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"mandatory\" SvcParam -- Mandatory keys in service binding RR\n" ++
  "\n" ++
  "      class Mandatory < SvcParam\n" ++
  "        KeyName = :mandatory\n" ++
  "        KeyNumber = 0\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Mandatory keys.\n" ++
  "\n" ++
  "        attr_reader :keys\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Initialize \"mandatory\" ScvParam.\n" ++
  "\n" ++
  "        def initialize(keys)\n" ++
  "          @keys = keys.map(&:to_int)\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          @keys.sort.each do |key|\n" ++
  "            msg.put_pack('n', key)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          keys = msg.get_list \{ msg.get_unpack('n')[0] \}\n" ++
  "          return self.new(keys)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"alpn\" SvcParam -- Additional supported protocols\n" ++
  "\n" ++
  "      class ALPN < SvcParam\n" ++
  "        KeyName = :alpn\n" ++
  "        KeyNumber = 1\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Supported protocol IDs.\n" ++
  "\n" ++
  "        attr_reader :protocol_ids\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Initialize \"alpn\" ScvParam.\n" ++
  "\n" ++
  "        def initialize(protocol_ids)\n" ++
  "          @protocol_ids = protocol_ids.map(&:to_str)\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          msg.put_string_list(@protocol_ids)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          return self.new(msg.get_string_list)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"no-default-alpn\" SvcParam -- No support for default protocol\n" ++
  "\n" ++
  "      class NoDefaultALPN < SvcParam\n" ++
  "        KeyName = :'no-default-alpn'\n" ++
  "        KeyNumber = 2\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          # no payload\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          return self.new\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"port\" SvcParam -- Port for alternative endpoint\n" ++
  "\n" ++
  "      class Port < SvcParam\n" ++
  "        KeyName = :port\n" ++
  "        KeyNumber = 3\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Port number.\n" ++
  "\n" ++
  "        attr_reader :port\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Initialize \"port\" ScvParam.\n" ++
  "\n" ++
  "        def initialize(port)\n" ++
  "          @port = port.to_int\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          msg.put_pack('n', @port)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          port, = msg.get_unpack('n')\n" ++
  "          return self.new(port)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"ipv4hint\" SvcParam -- IPv4 address hints\n" ++
  "\n" ++
  "      class IPv4Hint < SvcParam\n" ++
  "        KeyName = :ipv4hint\n" ++
  "        KeyNumber = 4\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Set of IPv4 addresses.\n" ++
  "\n" ++
  "        attr_reader :addresses\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Initialize \"ipv4hint\" ScvParam.\n" ++
  "\n" ++
  "        def initialize(addresses)\n" ++
  "          @addresses = addresses.map \{|address| IPv4.create(address) \}\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          @addresses.each do |address|\n" ++
  "            msg.put_bytes(address.address)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          addresses = msg.get_list \{ IPv4.new(msg.get_bytes(4)) \}\n" ++
  "          return self.new(addresses)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"ipv6hint\" SvcParam -- IPv6 address hints\n" ++
  "\n" ++
  "      class IPv6Hint < SvcParam\n" ++
  "        KeyName = :ipv6hint\n" ++
  "        KeyNumber = 6\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Set of IPv6 addresses.\n" ++
  "\n" ++
  "        attr_reader :addresses\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Initialize \"ipv6hint\" ScvParam.\n" ++
  "\n" ++
  "        def initialize(addresses)\n" ++
  "          @addresses = addresses.map \{|address| IPv6.create(address) \}\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          @addresses.each do |address|\n" ++
  "            msg.put_bytes(address.address)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          addresses = msg.get_list \{ IPv6.new(msg.get_bytes(16)) \}\n" ++
  "          return self.new(addresses)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # \"dohpath\" SvcParam -- DNS over HTTPS path template [RFC9461]\n" ++
  "\n" ++
  "      class DoHPath < SvcParam\n" ++
  "        KeyName = :dohpath\n" ++
  "        KeyNumber = 7\n" ++
  "        ClassHash[KeyName] = ClassHash[KeyNumber] = self # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # URI template for DoH queries.\n" ++
  "\n" ++
  "        attr_reader :template\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Initialize \"dohpath\" ScvParam.\n" ++
  "\n" ++
  "        def initialize(template)\n" ++
  "          @template = template.encode('utf-8')\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode(msg) # :nodoc:\n" ++
  "          msg.put_bytes(@template)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode(msg) # :nodoc:\n" ++
  "          template = msg.get_bytes.force_encoding('utf-8')\n" ++
  "          return self.new(template)\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A DNS query abstract class.\n" ++
  "\n" ++
  "    class Query\n" ++
  "      def encode_rdata(msg) # :nodoc:\n" ++
  "        raise EncodeError.new(\"#\{self.class\} is query.\")\n" ++
  "      end\n" ++
  "\n" ++
  "      def self.decode_rdata(msg) # :nodoc:\n" ++
  "        raise DecodeError.new(\"#\{self.class\} is query.\")\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A DNS resource abstract class.\n" ++
  "\n" ++
  "    class Resource < Query\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Remaining Time To Live for this Resource.\n" ++
  "\n" ++
  "      attr_reader :ttl\n" ++
  "\n" ++
  "      ClassHash = Module.new do\n" ++
  "        module_function\n" ++
  "\n" ++
  "        def []=(type_class_value, klass)\n" ++
  "          type_value, class_value = type_class_value\n" ++
  "          Resource.const_set(:\"Type#\{type_value\}_Class#\{class_value\}\", klass)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def encode_rdata(msg) # :nodoc:\n" ++
  "        raise NotImplementedError.new\n" ++
  "      end\n" ++
  "\n" ++
  "      def self.decode_rdata(msg) # :nodoc:\n" ++
  "        raise NotImplementedError.new\n" ++
  "      end\n" ++
  "\n" ++
  "      def ==(other) # :nodoc:\n" ++
  "        return false unless self.class == other.class\n" ++
  "        s_ivars = self.instance_variables\n" ++
  "        s_ivars.sort!\n" ++
  "        s_ivars.delete :@ttl\n" ++
  "        o_ivars = other.instance_variables\n" ++
  "        o_ivars.sort!\n" ++
  "        o_ivars.delete :@ttl\n" ++
  "        return s_ivars == o_ivars &&\n" ++
  "          s_ivars.collect \{|name| self.instance_variable_get name\} ==\n" ++
  "            o_ivars.collect \{|name| other.instance_variable_get name\}\n" ++
  "      end\n" ++
  "\n" ++
  "      def eql?(other) # :nodoc:\n" ++
  "        return self == other\n" ++
  "      end\n" ++
  "\n" ++
  "      def hash # :nodoc:\n" ++
  "        h = 0\n" ++
  "        vars = self.instance_variables\n" ++
  "        vars.delete :@ttl\n" ++
  "        vars.each \{|name|\n" ++
  "          h ^= self.instance_variable_get(name).hash\n" ++
  "        \}\n" ++
  "        return h\n" ++
  "      end\n" ++
  "\n" ++
  "      def self.get_class(type_value, class_value) # :nodoc:\n" ++
  "        cache = :\"Type#\{type_value\}_Class#\{class_value\}\"\n" ++
  "\n" ++
  "        return (const_defined?(cache) && const_get(cache)) ||\n" ++
  "               Generic.create(type_value, class_value)\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # A generic resource abstract class.\n" ++
  "\n" ++
  "      class Generic < Resource\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Creates a new generic resource.\n" ++
  "\n" ++
  "        def initialize(data)\n" ++
  "          @data = data\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Data for this generic resource.\n" ++
  "\n" ++
  "        attr_reader :data\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_bytes(data)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          return self.new(msg.get_bytes)\n" ++
  "        end\n" ++
  "\n" ++
  "        # create makes a fresh class for each decoded resource, so the type and\n" ++
  "        # class values have to be compared instead of the class itself.\n" ++
  "        def self.type_class_equal?(klass, other) # :nodoc:\n" ++
  "          return true if klass.equal?(other)\n" ++
  "          Generic > klass && Generic > other &&\n" ++
  "            klass::TypeValue == other::TypeValue &&\n" ++
  "            klass::ClassValue == other::ClassValue\n" ++
  "        end\n" ++
  "\n" ++
  "        def ==(other) # :nodoc:\n" ++
  "          return other.is_a?(Generic) &&\n" ++
  "                 Generic.type_class_equal?(self.class, other.class) &&\n" ++
  "                 @data == other.data\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.create(type_value, class_value) # :nodoc:\n" ++
  "          c = Class.new(Generic)\n" ++
  "          c.const_set(:TypeValue, type_value)\n" ++
  "          c.const_set(:ClassValue, class_value)\n" ++
  "          # Not registered in a constant or in ClassHash. get_class creates a\n" ++
  "          # class for every unknown (type, class) pair, so registering them\n" ++
  "          # permanently would let a malicious response exhaust memory.\n" ++
  "          return c\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Domain Name resource abstract class.\n" ++
  "\n" ++
  "      class DomainName < Resource\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Creates a new DomainName from +name+.\n" ++
  "\n" ++
  "        def initialize(name)\n" ++
  "          @name = name\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The name of this DomainName.\n" ++
  "\n" ++
  "        attr_reader :name\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_name(@name)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          return self.new(msg.get_name)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      # Standard (class generic) RRs\n" ++
  "\n" ++
  "      ClassValue = nil # :nodoc:\n" ++
  "\n" ++
  "      ##\n" ++
  "      # An authoritative name server.\n" ++
  "\n" ++
  "      class NS < DomainName\n" ++
  "        TypeValue = 2 # :nodoc:\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # The canonical name for an alias.\n" ++
  "\n" ++
  "      class CNAME < DomainName\n" ++
  "        TypeValue = 5 # :nodoc:\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Start Of Authority resource.\n" ++
  "\n" ++
  "      class SOA < Resource\n" ++
  "\n" ++
  "        TypeValue = 6 # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Creates a new SOA record.  See the attr documentation for the\n" ++
  "        # details of each argument.\n" ++
  "\n" ++
  "        def initialize(mname, rname, serial, refresh, retry_, expire, minimum)\n" ++
  "          @mname = mname\n" ++
  "          @rname = rname\n" ++
  "          @serial = serial\n" ++
  "          @refresh = refresh\n" ++
  "          @retry = retry_\n" ++
  "          @expire = expire\n" ++
  "          @minimum = minimum\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Name of the host where the master zone file for this zone resides.\n" ++
  "\n" ++
  "        attr_reader :mname\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The person responsible for this domain name.\n" ++
  "\n" ++
  "        attr_reader :rname\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The version number of the zone file.\n" ++
  "\n" ++
  "        attr_reader :serial\n" ++
  "\n" ++
  "        ##\n" ++
  "        # How often, in seconds, a secondary name server is to check for\n" ++
  "        # updates from the primary name server.\n" ++
  "\n" ++
  "        attr_reader :refresh\n" ++
  "\n" ++
  "        ##\n" ++
  "        # How often, in seconds, a secondary name server is to retry after a\n" ++
  "        # failure to check for a refresh.\n" ++
  "\n" ++
  "        attr_reader :retry\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Time in seconds that a secondary name server is to use the data\n" ++
  "        # before refreshing from the primary name server.\n" ++
  "\n" ++
  "        attr_reader :expire\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The minimum number of seconds to be used for TTL values in RRs.\n" ++
  "\n" ++
  "        attr_reader :minimum\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_name(@mname)\n" ++
  "          msg.put_name(@rname)\n" ++
  "          msg.put_pack('NNNNN', @serial, @refresh, @retry, @expire, @minimum)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          mname = msg.get_name\n" ++
  "          rname = msg.get_name\n" ++
  "          serial, refresh, retry_, expire, minimum = msg.get_unpack('NNNNN')\n" ++
  "          return self.new(\n" ++
  "            mname, rname, serial, refresh, retry_, expire, minimum)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # A Pointer to another DNS name.\n" ++
  "\n" ++
  "      class PTR < DomainName\n" ++
  "        TypeValue = 12 # :nodoc:\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Host Information resource.\n" ++
  "\n" ++
  "      class HINFO < Resource\n" ++
  "\n" ++
  "        TypeValue = 13 # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Creates a new HINFO running +os+ on +cpu+.\n" ++
  "\n" ++
  "        def initialize(cpu, os)\n" ++
  "          @cpu = cpu\n" ++
  "          @os = os\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # CPU architecture for this resource.\n" ++
  "\n" ++
  "        attr_reader :cpu\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Operating system for this resource.\n" ++
  "\n" ++
  "        attr_reader :os\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_string(@cpu)\n" ++
  "          msg.put_string(@os)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          cpu = msg.get_string\n" ++
  "          os = msg.get_string\n" ++
  "          return self.new(cpu, os)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Mailing list or mailbox information.\n" ++
  "\n" ++
  "      class MINFO < Resource\n" ++
  "\n" ++
  "        TypeValue = 14 # :nodoc:\n" ++
  "\n" ++
  "        def initialize(rmailbx, emailbx)\n" ++
  "          @rmailbx = rmailbx\n" ++
  "          @emailbx = emailbx\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Domain name responsible for this mail list or mailbox.\n" ++
  "\n" ++
  "        attr_reader :rmailbx\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Mailbox to use for error messages related to the mail list or mailbox.\n" ++
  "\n" ++
  "        attr_reader :emailbx\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_name(@rmailbx)\n" ++
  "          msg.put_name(@emailbx)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          rmailbx = msg.get_string\n" ++
  "          emailbx = msg.get_string\n" ++
  "          return self.new(rmailbx, emailbx)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Mail Exchanger resource.\n" ++
  "\n" ++
  "      class MX < Resource\n" ++
  "\n" ++
  "        TypeValue= 15 # :nodoc:\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Creates a new MX record with +preference+, accepting mail at\n" ++
  "        # +exchange+.\n" ++
  "\n" ++
  "        def initialize(preference, exchange)\n" ++
  "          @preference = preference\n" ++
  "          @exchange = exchange\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The preference for this MX.\n" ++
  "\n" ++
  "        attr_reader :preference\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The host of this MX.\n" ++
  "\n" ++
  "        attr_reader :exchange\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_pack('n', @preference)\n" ++
  "          msg.put_name(@exchange)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          preference, = msg.get_unpack('n')\n" ++
  "          exchange = msg.get_name\n" ++
  "          return self.new(preference, exchange)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Unstructured text resource.\n" ++
  "\n" ++
  "      class TXT < Resource\n" ++
  "\n" ++
  "        TypeValue = 16 # :nodoc:\n" ++
  "\n" ++
  "        def initialize(first_string, *rest_strings)\n" ++
  "          @strings = [first_string, *rest_strings]\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Returns an Array of Strings for this TXT record.\n" ++
  "\n" ++
  "        attr_reader :strings\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Returns the concatenated string from +strings+.\n" ++
  "\n" ++
  "        def data\n" ++
  "          @strings.join(\"\")\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_string_list(@strings)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          strings = msg.get_string_list\n" ++
  "          return self.new(*strings)\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Location resource\n" ++
  "\n" ++
  "      class LOC < Resource\n" ++
  "\n" ++
  "        TypeValue = 29 # :nodoc:\n" ++
  "\n" ++
  "        def initialize(version, ssize, hprecision, vprecision, latitude, longitude, altitude)\n" ++
  "          @version    = version\n" ++
  "          @ssize      = Resolv::LOC::Size.create(ssize)\n" ++
  "          @hprecision = Resolv::LOC::Size.create(hprecision)\n" ++
  "          @vprecision = Resolv::LOC::Size.create(vprecision)\n" ++
  "          @latitude   = Resolv::LOC::Coord.create(latitude)\n" ++
  "          @longitude  = Resolv::LOC::Coord.create(longitude)\n" ++
  "          @altitude   = Resolv::LOC::Alt.create(altitude)\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Returns the version value for this LOC record which should always be 00\n" ++
  "\n" ++
  "        attr_reader :version\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The spherical size of this LOC\n" ++
  "        # in meters using scientific notation as 2 integers of XeY\n" ++
  "\n" ++
  "        attr_reader :ssize\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The horizontal precision using ssize type values\n" ++
  "        # in meters using scientific notation as 2 integers of XeY\n" ++
  "        # for precision use value/2 e.g. 2m = +/-1m\n" ++
  "\n" ++
  "        attr_reader :hprecision\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The vertical precision using ssize type values\n" ++
  "        # in meters using scientific notation as 2 integers of XeY\n" ++
  "        # for precision use value/2 e.g. 2m = +/-1m\n" ++
  "\n" ++
  "        attr_reader :vprecision\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The latitude for this LOC where 2**31 is the equator\n" ++
  "        # in thousandths of an arc second as an unsigned 32bit integer\n" ++
  "\n" ++
  "        attr_reader :latitude\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The longitude for this LOC where 2**31 is the prime meridian\n" ++
  "        # in thousandths of an arc second as an unsigned 32bit integer\n" ++
  "\n" ++
  "        attr_reader :longitude\n" ++
  "\n" ++
  "        ##\n" ++
  "        # The altitude of the LOC above a reference sphere whose surface sits 100km below the WGS84 spheroid\n" ++
  "        # in centimeters as an unsigned 32bit integer\n" ++
  "\n" ++
  "        attr_reader :altitude\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_bytes(@version)\n" ++
  "          msg.put_bytes(@ssize.scalar)\n" ++
  "          msg.put_bytes(@hprecision.scalar)\n" ++
  "          msg.put_bytes(@vprecision.scalar)\n" ++
  "          msg.put_bytes(@latitude.coordinates)\n" ++
  "          msg.put_bytes(@longitude.coordinates)\n" ++
  "          msg.put_bytes(@altitude.altitude)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          version    = msg.get_bytes(1)\n" ++
  "          ssize      = msg.get_bytes(1)\n" ++
  "          hprecision = msg.get_bytes(1)\n" ++
  "          vprecision = msg.get_bytes(1)\n" ++
  "          latitude   = msg.get_bytes(4)\n" ++
  "          longitude  = msg.get_bytes(4)\n" ++
  "          altitude   = msg.get_bytes(4)\n" ++
  "          return self.new(\n" ++
  "            version,\n" ++
  "            Resolv::LOC::Size.new(ssize),\n" ++
  "            Resolv::LOC::Size.new(hprecision),\n" ++
  "            Resolv::LOC::Size.new(vprecision),\n" ++
  "            Resolv::LOC::Coord.new(latitude,\"lat\"),\n" ++
  "            Resolv::LOC::Coord.new(longitude,\"lon\"),\n" ++
  "            Resolv::LOC::Alt.new(altitude)\n" ++
  "          )\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # A Query type requesting any RR.\n" ++
  "\n" ++
  "      class ANY < Query\n" ++
  "        TypeValue = 255 # :nodoc:\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # CAA resource record defined in RFC 8659\n" ++
  "      #\n" ++
  "      # These records identify certificate authority allowed to issue\n" ++
  "      # certificates for the given domain.\n" ++
  "\n" ++
  "      class CAA < Resource\n" ++
  "        TypeValue = 257\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Creates a new CAA for +flags+, +tag+ and +value+.\n" ++
  "\n" ++
  "        def initialize(flags, tag, value)\n" ++
  "          unless (0..255) === flags\n" ++
  "            raise ArgumentError.new('flags must be an Integer between 0 and 255')\n" ++
  "          end\n" ++
  "          unless (1..15) === tag.bytesize\n" ++
  "            raise ArgumentError.new('length of tag must be between 1 and 15')\n" ++
  "          end\n" ++
  "\n" ++
  "          @flags = flags\n" ++
  "          @tag = tag\n" ++
  "          @value = value\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Flags for this property:\n" ++
  "        # - Bit 0 : 0 = not critical, 1 = critical\n" ++
  "\n" ++
  "        attr_reader :flags\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Property tag (\"issue\", \"issuewild\", \"iodef\"...).\n" ++
  "\n" ++
  "        attr_reader :tag\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Property value.\n" ++
  "\n" ++
  "        attr_reader :value\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Whether the critical flag is set on this property.\n" ++
  "\n" ++
  "        def critical?\n" ++
  "          flags & 0x80 != 0\n" ++
  "        end\n" ++
  "\n" ++
  "        def encode_rdata(msg) # :nodoc:\n" ++
  "          msg.put_pack('C', @flags)\n" ++
  "          msg.put_string(@tag)\n" ++
  "          msg.put_bytes(@value)\n" ++
  "        end\n" ++
  "\n" ++
  "        def self.decode_rdata(msg) # :nodoc:\n" ++
  "          flags, = msg.get_unpack('C')\n" ++
  "          tag = msg.get_string\n" ++
  "          value = msg.get_bytes\n" ++
  "          self.new flags, tag, value\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      ClassInsensitiveTypes = [ # :nodoc:\n" ++
  "        NS, CNAME, SOA, PTR, HINFO, MINFO, MX, TXT, LOC, ANY, CAA\n" ++
  "      ]\n" ++
  "\n" ++
  "      ##\n" ++
  "      # module IN contains ARPA Internet specific RRs.\n" ++
  "\n" ++
  "      module IN\n" ++
  "\n" ++
  "        ClassValue = 1 # :nodoc:\n" ++
  "\n" ++
  "        ClassInsensitiveTypes.each \{|s|\n" ++
  "          c = Class.new(s)\n" ++
  "          c.const_set(:TypeValue, s::TypeValue)\n" ++
  "          c.const_set(:ClassValue, ClassValue)\n" ++
  "          ClassHash[[s::TypeValue, ClassValue]] = c\n" ++
  "          self.const_set(s.name.sub(/.*::/, ''), c)\n" ++
  "        \}\n" ++
  "\n" ++
  "        ##\n" ++
  "        # IPv4 Address resource\n" ++
  "\n" ++
  "        class A < Resource\n" ++
  "          TypeValue = 1\n" ++
  "          ClassValue = IN::ClassValue\n" ++
  "          ClassHash[[TypeValue, ClassValue]] = self # :nodoc:\n" ++
  "\n" ++
  "          ##\n" ++
  "          # Creates a new A for +address+.\n" ++
  "\n" ++
  "          def initialize(address)\n" ++
  "            @address = IPv4.create(address)\n" ++
  "          end\n" ++
  "\n" ++
  "          ##\n" ++
  "          # The Resolv::IPv4 address for this A.\n" ++
  "\n" ++
  "          attr_reader :address\n" ++
  "\n" ++
  "          def encode_rdata(msg) # :nodoc:\n" ++
  "            msg.put_bytes(@address.address)\n" ++
  "          end\n" ++
  "\n" ++
  "          def self.decode_rdata(msg) # :nodoc:\n" ++
  "            return self.new(IPv4.new(msg.get_bytes(4)))\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Well Known Service resource.\n" ++
  "\n" ++
  "        class WKS < Resource\n" ++
  "          TypeValue = 11\n" ++
  "          ClassValue = IN::ClassValue\n" ++
  "          ClassHash[[TypeValue, ClassValue]] = self # :nodoc:\n" ++
  "\n" ++
  "          def initialize(address, protocol, bitmap)\n" ++
  "            @address = IPv4.create(address)\n" ++
  "            @protocol = protocol\n" ++
  "            @bitmap = bitmap\n" ++
  "          end\n" ++
  "\n" ++
  "          ##\n" ++
  "          # The host these services run on.\n" ++
  "\n" ++
  "          attr_reader :address\n" ++
  "\n" ++
  "          ##\n" ++
  "          # IP protocol number for these services.\n" ++
  "\n" ++
  "          attr_reader :protocol\n" ++
  "\n" ++
  "          ##\n" ++
  "          # A bit map of enabled services on this host.\n" ++
  "          #\n" ++
  "          # If protocol is 6 (TCP) then the 26th bit corresponds to the SMTP\n" ++
  "          # service (port 25).  If this bit is set, then an SMTP server should\n" ++
  "          # be listening on TCP port 25; if zero, SMTP service is not\n" ++
  "          # supported.\n" ++
  "\n" ++
  "          attr_reader :bitmap\n" ++
  "\n" ++
  "          def encode_rdata(msg) # :nodoc:\n" ++
  "            msg.put_bytes(@address.address)\n" ++
  "            msg.put_pack(\"n\", @protocol)\n" ++
  "            msg.put_bytes(@bitmap)\n" ++
  "          end\n" ++
  "\n" ++
  "          def self.decode_rdata(msg) # :nodoc:\n" ++
  "            address = IPv4.new(msg.get_bytes(4))\n" ++
  "            protocol, = msg.get_unpack(\"n\")\n" ++
  "            bitmap = msg.get_bytes\n" ++
  "            return self.new(address, protocol, bitmap)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # An IPv6 address record.\n" ++
  "\n" ++
  "        class AAAA < Resource\n" ++
  "          TypeValue = 28\n" ++
  "          ClassValue = IN::ClassValue\n" ++
  "          ClassHash[[TypeValue, ClassValue]] = self # :nodoc:\n" ++
  "\n" ++
  "          ##\n" ++
  "          # Creates a new AAAA for +address+.\n" ++
  "\n" ++
  "          def initialize(address)\n" ++
  "            @address = IPv6.create(address)\n" ++
  "          end\n" ++
  "\n" ++
  "          ##\n" ++
  "          # The Resolv::IPv6 address for this AAAA.\n" ++
  "\n" ++
  "          attr_reader :address\n" ++
  "\n" ++
  "          def encode_rdata(msg) # :nodoc:\n" ++
  "            msg.put_bytes(@address.address)\n" ++
  "          end\n" ++
  "\n" ++
  "          def self.decode_rdata(msg) # :nodoc:\n" ++
  "            return self.new(IPv6.new(msg.get_bytes(16)))\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # SRV resource record defined in RFC 2782\n" ++
  "        #\n" ++
  "        # These records identify the hostname and port that a service is\n" ++
  "        # available at.\n" ++
  "\n" ++
  "        class SRV < Resource\n" ++
  "          TypeValue = 33\n" ++
  "          ClassValue = IN::ClassValue\n" ++
  "          ClassHash[[TypeValue, ClassValue]] = self # :nodoc:\n" ++
  "\n" ++
  "          # Create a SRV resource record.\n" ++
  "          #\n" ++
  "          # See the documentation for #priority, #weight, #port and #target\n" ++
  "          # for +priority+, +weight+, +port and +target+ respectively.\n" ++
  "\n" ++
  "          def initialize(priority, weight, port, target)\n" ++
  "            @priority = priority.to_int\n" ++
  "            @weight = weight.to_int\n" ++
  "            @port = port.to_int\n" ++
  "            @target = Name.create(target)\n" ++
  "          end\n" ++
  "\n" ++
  "          # The priority of this target host.\n" ++
  "          #\n" ++
  "          # A client MUST attempt to contact the target host with the\n" ++
  "          # lowest-numbered priority it can reach; target hosts with the same\n" ++
  "          # priority SHOULD be tried in an order defined by the weight field.\n" ++
  "          # The range is 0-65535.  Note that it is not widely implemented and\n" ++
  "          # should be set to zero.\n" ++
  "\n" ++
  "          attr_reader :priority\n" ++
  "\n" ++
  "          # A server selection mechanism.\n" ++
  "          #\n" ++
  "          # The weight field specifies a relative weight for entries with the\n" ++
  "          # same priority. Larger weights SHOULD be given a proportionately\n" ++
  "          # higher probability of being selected. The range of this number is\n" ++
  "          # 0-65535.  Domain administrators SHOULD use Weight 0 when there\n" ++
  "          # isn't any server selection to do, to make the RR easier to read\n" ++
  "          # for humans (less noisy). Note that it is not widely implemented\n" ++
  "          # and should be set to zero.\n" ++
  "\n" ++
  "          attr_reader :weight\n" ++
  "\n" ++
  "          # The port on this target host of this service.\n" ++
  "          #\n" ++
  "          # The range is 0-65535.\n" ++
  "\n" ++
  "          attr_reader :port\n" ++
  "\n" ++
  "          # The domain name of the target host.\n" ++
  "          #\n" ++
  "          # A target of \".\" means that the service is decidedly not available\n" ++
  "          # at this domain.\n" ++
  "\n" ++
  "          attr_reader :target\n" ++
  "\n" ++
  "          def encode_rdata(msg) # :nodoc:\n" ++
  "            msg.put_pack(\"n\", @priority)\n" ++
  "            msg.put_pack(\"n\", @weight)\n" ++
  "            msg.put_pack(\"n\", @port)\n" ++
  "            msg.put_name(@target, compress: false)\n" ++
  "          end\n" ++
  "\n" ++
  "          def self.decode_rdata(msg) # :nodoc:\n" ++
  "            priority, = msg.get_unpack(\"n\")\n" ++
  "            weight,   = msg.get_unpack(\"n\")\n" ++
  "            port,     = msg.get_unpack(\"n\")\n" ++
  "            target    = msg.get_name\n" ++
  "            return self.new(priority, weight, port, target)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # Common implementation for SVCB-compatible resource records.\n" ++
  "\n" ++
  "        class ServiceBinding\n" ++
  "\n" ++
  "          ##\n" ++
  "          # Create a service binding resource record.\n" ++
  "\n" ++
  "          def initialize(priority, target, params = [])\n" ++
  "            @priority = priority.to_int\n" ++
  "            @target = Name.create(target)\n" ++
  "            @params = SvcParams.new(params)\n" ++
  "          end\n" ++
  "\n" ++
  "          ##\n" ++
  "          # The priority of this target host.\n" ++
  "          #\n" ++
  "          # The range is 0-65535.\n" ++
  "          # If set to 0, this RR is in AliasMode. Otherwise, it is in ServiceMode.\n" ++
  "\n" ++
  "          attr_reader :priority\n" ++
  "\n" ++
  "          ##\n" ++
  "          # The domain name of the target host.\n" ++
  "\n" ++
  "          attr_reader :target\n" ++
  "\n" ++
  "          ##\n" ++
  "          # The service parameters for the target host.\n" ++
  "\n" ++
  "          attr_reader :params\n" ++
  "\n" ++
  "          ##\n" ++
  "          # Whether this RR is in AliasMode.\n" ++
  "\n" ++
  "          def alias_mode?\n" ++
  "            self.priority == 0\n" ++
  "          end\n" ++
  "\n" ++
  "          ##\n" ++
  "          # Whether this RR is in ServiceMode.\n" ++
  "\n" ++
  "          def service_mode?\n" ++
  "            !alias_mode?\n" ++
  "          end\n" ++
  "\n" ++
  "          def encode_rdata(msg) # :nodoc:\n" ++
  "            msg.put_pack(\"n\", @priority)\n" ++
  "            msg.put_name(@target, compress: false)\n" ++
  "            @params.encode(msg)\n" ++
  "          end\n" ++
  "\n" ++
  "          def self.decode_rdata(msg) # :nodoc:\n" ++
  "            priority, = msg.get_unpack(\"n\")\n" ++
  "            target    = msg.get_name\n" ++
  "            params    = SvcParams.decode(msg)\n" ++
  "            return self.new(priority, target, params)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # SVCB resource record [RFC9460]\n" ++
  "\n" ++
  "        class SVCB < ServiceBinding\n" ++
  "          TypeValue = 64\n" ++
  "          ClassValue = IN::ClassValue\n" ++
  "          ClassHash[[TypeValue, ClassValue]] = self # :nodoc:\n" ++
  "        end\n" ++
  "\n" ++
  "        ##\n" ++
  "        # HTTPS resource record [RFC9460]\n" ++
  "\n" ++
  "        class HTTPS < ServiceBinding\n" ++
  "          TypeValue = 65\n" ++
  "          ClassValue = IN::ClassValue\n" ++
  "          ClassHash[[TypeValue, ClassValue]] = self # :nodoc:\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # A Resolv::DNS IPv4 address.\n" ++
  "\n" ++
  "  class IPv4\n" ++
  "\n" ++
  "    Regex256 = /0\n" ++
  "               |1(?:[0-9][0-9]?)?\n" ++
  "               |2(?:[0-4][0-9]?|5[0-5]?|[6-9])?\n" ++
  "               |[3-9][0-9]?/x # :nodoc:\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Regular expression IPv4 addresses must match.\n" ++
  "    Regex = /\\A(#\{Regex256\})\\.(#\{Regex256\})\\.(#\{Regex256\})\\.(#\{Regex256\})\\z/\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new IPv4 address from +arg+ which may be:\n" ++
  "    #\n" ++
  "    # IPv4:: returns +arg+.\n" ++
  "    # String:: +arg+ must match the IPv4::Regex constant\n" ++
  "\n" ++
  "    def self.create(arg)\n" ++
  "      case arg\n" ++
  "      when IPv4\n" ++
  "        return arg\n" ++
  "      when Regex\n" ++
  "        if (0..255) === (a = $1.to_i) &&\n" ++
  "           (0..255) === (b = $2.to_i) &&\n" ++
  "           (0..255) === (c = $3.to_i) &&\n" ++
  "           (0..255) === (d = $4.to_i)\n" ++
  "          return self.new([a, b, c, d].pack(\"CCCC\"))\n" ++
  "        else\n" ++
  "          raise ArgumentError.new(\"IPv4 address with invalid value: \" + arg)\n" ++
  "        end\n" ++
  "      else\n" ++
  "        raise ArgumentError.new(\"cannot interpret as IPv4 address: #\{arg.inspect\}\")\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def initialize(address) # :nodoc:\n" ++
  "      unless address.kind_of?(String)\n" ++
  "        raise ArgumentError, 'IPv4 address must be a string'\n" ++
  "      end\n" ++
  "      unless address.length == 4\n" ++
  "        raise ArgumentError, \"IPv4 address expects 4 bytes but #\{address.length\} bytes\"\n" ++
  "      end\n" ++
  "      @address = address\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A String representation of this IPv4 address.\n" ++
  "\n" ++
  "    ##\n" ++
  "    # The raw IPv4 address as a String.\n" ++
  "\n" ++
  "    attr_reader :address\n" ++
  "\n" ++
  "    def to_s # :nodoc:\n" ++
  "      return sprintf(\"%d.%d.%d.%d\", *@address.unpack(\"CCCC\"))\n" ++
  "    end\n" ++
  "\n" ++
  "    def inspect # :nodoc:\n" ++
  "      return \"#<#\{self.class\} #\{self\}>\"\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Turns this IPv4 address into a Resolv::DNS::Name.\n" ++
  "\n" ++
  "    def to_name\n" ++
  "      return DNS::Name.create(\n" ++
  "        '%d.%d.%d.%d.in-addr.arpa.' % @address.unpack('CCCC').reverse)\n" ++
  "    end\n" ++
  "\n" ++
  "    def ==(other) # :nodoc:\n" ++
  "      return @address == other.address\n" ++
  "    end\n" ++
  "\n" ++
  "    def eql?(other) # :nodoc:\n" ++
  "      return self == other\n" ++
  "    end\n" ++
  "\n" ++
  "    def hash # :nodoc:\n" ++
  "      return @address.hash\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # A Resolv::DNS IPv6 address.\n" ++
  "\n" ++
  "  class IPv6\n" ++
  "\n" ++
  "    ##\n" ++
  "    # IPv6 address format a:b:c:d:e:f:g:h\n" ++
  "    Regex_8Hex = /\\A\n" ++
  "      (?:[0-9A-Fa-f]\{1,4\}:)\{7\}\n" ++
  "         [0-9A-Fa-f]\{1,4\}\n" ++
  "      \\z/x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Compressed IPv6 address format a::b\n" ++
  "\n" ++
  "    Regex_CompressedHex = /\\A\n" ++
  "      ((?:[0-9A-Fa-f]\{1,4\}(?::[0-9A-Fa-f]\{1,4\})*)?) ::\n" ++
  "      ((?:[0-9A-Fa-f]\{1,4\}(?::[0-9A-Fa-f]\{1,4\})*)?)\n" ++
  "      \\z/x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # IPv4 mapped IPv6 address format a:b:c:d:e:f:w.x.y.z\n" ++
  "\n" ++
  "    Regex_6Hex4Dec = /\\A\n" ++
  "      ((?:[0-9A-Fa-f]\{1,4\}:)\{6,6\})\n" ++
  "      (\\d+)\\.(\\d+)\\.(\\d+)\\.(\\d+)\n" ++
  "      \\z/x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Compressed IPv4 mapped IPv6 address format a::b:w.x.y.z\n" ++
  "\n" ++
  "    Regex_CompressedHex4Dec = /\\A\n" ++
  "      ((?:[0-9A-Fa-f]\{1,4\}(?::[0-9A-Fa-f]\{1,4\})*)?) ::\n" ++
  "      ((?:[0-9A-Fa-f]\{1,4\}:)*)\n" ++
  "      (\\d+)\\.(\\d+)\\.(\\d+)\\.(\\d+)\n" ++
  "      \\z/x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # IPv6 link local address format fe80:b:c:d:e:f:g:h%em1\n" ++
  "    Regex_8HexLinkLocal = /\\A\n" ++
  "      [Ff][Ee]80\n" ++
  "      (?::[0-9A-Fa-f]\{1,4\})\{7\}\n" ++
  "      %[-0-9A-Za-z._~]+\n" ++
  "      \\z/x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Compressed IPv6 link local address format fe80::b%em1\n" ++
  "\n" ++
  "    Regex_CompressedHexLinkLocal = /\\A\n" ++
  "      [Ff][Ee]80:\n" ++
  "      (?:\n" ++
  "        ((?:[0-9A-Fa-f]\{1,4\}(?::[0-9A-Fa-f]\{1,4\})*)?) ::\n" ++
  "        ((?:[0-9A-Fa-f]\{1,4\}(?::[0-9A-Fa-f]\{1,4\})*)?)\n" ++
  "        |\n" ++
  "        :((?:[0-9A-Fa-f]\{1,4\}(?::[0-9A-Fa-f]\{1,4\})*)?)\n" ++
  "      )?\n" ++
  "      :[0-9A-Fa-f]\{1,4\}%[-0-9A-Za-z._~]+\n" ++
  "      \\z/x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A composite IPv6 address Regexp.\n" ++
  "\n" ++
  "    Regex = /\n" ++
  "      (?:#\{Regex_8Hex\}) |\n" ++
  "      (?:#\{Regex_CompressedHex\}) |\n" ++
  "      (?:#\{Regex_6Hex4Dec\}) |\n" ++
  "      (?:#\{Regex_CompressedHex4Dec\}) |\n" ++
  "      (?:#\{Regex_8HexLinkLocal\}) |\n" ++
  "      (?:#\{Regex_CompressedHexLinkLocal\})\n" ++
  "      /x\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new IPv6 address from +arg+ which may be:\n" ++
  "    #\n" ++
  "    # IPv6:: returns +arg+.\n" ++
  "    # String:: +arg+ must match one of the IPv6::Regex* constants\n" ++
  "\n" ++
  "    def self.create(arg)\n" ++
  "      case arg\n" ++
  "      when IPv6\n" ++
  "        return arg\n" ++
  "      when String\n" ++
  "        address = ''.b\n" ++
  "        if Regex_8Hex =~ arg\n" ++
  "          arg.scan(/[0-9A-Fa-f]+/) \{|hex| address << [hex.hex].pack('n')\}\n" ++
  "        elsif Regex_CompressedHex =~ arg\n" ++
  "          prefix = $1\n" ++
  "          suffix = $2\n" ++
  "          a1 = ''.b\n" ++
  "          a2 = ''.b\n" ++
  "          prefix.scan(/[0-9A-Fa-f]+/) \{|hex| a1 << [hex.hex].pack('n')\}\n" ++
  "          suffix.scan(/[0-9A-Fa-f]+/) \{|hex| a2 << [hex.hex].pack('n')\}\n" ++
  "          omitlen = 16 - a1.length - a2.length\n" ++
  "          address << a1 << \"\\0\" * omitlen << a2\n" ++
  "        elsif Regex_6Hex4Dec =~ arg\n" ++
  "          prefix, a, b, c, d = $1, $2.to_i, $3.to_i, $4.to_i, $5.to_i\n" ++
  "          if (0..255) === a && (0..255) === b && (0..255) === c && (0..255) === d\n" ++
  "            prefix.scan(/[0-9A-Fa-f]+/) \{|hex| address << [hex.hex].pack('n')\}\n" ++
  "            address << [a, b, c, d].pack('CCCC')\n" ++
  "          else\n" ++
  "            raise ArgumentError.new(\"not numeric IPv6 address: \" + arg)\n" ++
  "          end\n" ++
  "        elsif Regex_CompressedHex4Dec =~ arg\n" ++
  "          prefix, suffix, a, b, c, d = $1, $2, $3.to_i, $4.to_i, $5.to_i, $6.to_i\n" ++
  "          if (0..255) === a && (0..255) === b && (0..255) === c && (0..255) === d\n" ++
  "            a1 = ''.b\n" ++
  "            a2 = ''.b\n" ++
  "            prefix.scan(/[0-9A-Fa-f]+/) \{|hex| a1 << [hex.hex].pack('n')\}\n" ++
  "            suffix.scan(/[0-9A-Fa-f]+/) \{|hex| a2 << [hex.hex].pack('n')\}\n" ++
  "            omitlen = 12 - a1.length - a2.length\n" ++
  "            address << a1 << \"\\0\" * omitlen << a2 << [a, b, c, d].pack('CCCC')\n" ++
  "          else\n" ++
  "            raise ArgumentError.new(\"not numeric IPv6 address: \" + arg)\n" ++
  "          end\n" ++
  "        else\n" ++
  "          raise ArgumentError.new(\"not numeric IPv6 address: \" + arg)\n" ++
  "        end\n" ++
  "        return IPv6.new(address)\n" ++
  "      else\n" ++
  "        raise ArgumentError.new(\"cannot interpret as IPv6 address: #\{arg.inspect\}\")\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def initialize(address) # :nodoc:\n" ++
  "      unless address.kind_of?(String) && address.length == 16\n" ++
  "        raise ArgumentError.new('IPv6 address must be 16 bytes')\n" ++
  "      end\n" ++
  "      @address = address\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # The raw IPv6 address as a String.\n" ++
  "\n" ++
  "    attr_reader :address\n" ++
  "\n" ++
  "    def to_s # :nodoc:\n" ++
  "      sprintf(\"%x:%x:%x:%x:%x:%x:%x:%x\", *@address.unpack(\"nnnnnnnn\")).sub(/(^|:)0(:0)+(:|$)/, '::')\n" ++
  "    end\n" ++
  "\n" ++
  "    def inspect # :nodoc:\n" ++
  "      return \"#<#\{self.class\} #\{self\}>\"\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Turns this IPv6 address into a Resolv::DNS::Name.\n" ++
  "    #--\n" ++
  "    # ip6.arpa should be searched too. [RFC3152]\n" ++
  "\n" ++
  "    def to_name\n" ++
  "      return DNS::Name.new(\n" ++
  "        @address.unpack(\"H32\")[0].split(//).reverse + ['ip6', 'arpa'])\n" ++
  "    end\n" ++
  "\n" ++
  "    def ==(other) # :nodoc:\n" ++
  "      return @address == other.address\n" ++
  "    end\n" ++
  "\n" ++
  "    def eql?(other) # :nodoc:\n" ++
  "      return self == other\n" ++
  "    end\n" ++
  "\n" ++
  "    def hash # :nodoc:\n" ++
  "      return @address.hash\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Resolv::MDNS is a one-shot Multicast DNS (mDNS) resolver.  It blindly\n" ++
  "  # makes queries to the mDNS addresses without understanding anything about\n" ++
  "  # multicast ports.\n" ++
  "  #\n" ++
  "  # Information taken form the following places:\n" ++
  "  #\n" ++
  "  # * RFC 6762\n" ++
  "\n" ++
  "  class MDNS < DNS\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Default mDNS Port\n" ++
  "\n" ++
  "    Port = 5353\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Default IPv4 mDNS address\n" ++
  "\n" ++
  "    AddressV4 = '224.0.0.251'\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Default IPv6 mDNS address\n" ++
  "\n" ++
  "    AddressV6 = 'ff02::fb'\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Default mDNS addresses\n" ++
  "\n" ++
  "    Addresses = [\n" ++
  "      [AddressV4, Port],\n" ++
  "      [AddressV6, Port],\n" ++
  "    ]\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new one-shot Multicast DNS (mDNS) resolver.\n" ++
  "    #\n" ++
  "    # +config_info+ can be:\n" ++
  "    #\n" ++
  "    # nil::\n" ++
  "    #   Uses the default mDNS addresses\n" ++
  "    #\n" ++
  "    # Hash::\n" ++
  "    #   Must contain :nameserver or :nameserver_port like\n" ++
  "    #   Resolv::DNS#initialize.\n" ++
  "\n" ++
  "    def initialize(config_info=nil)\n" ++
  "      if config_info then\n" ++
  "        super(\{ nameserver_port: Addresses \}.merge(config_info))\n" ++
  "      else\n" ++
  "        super(nameserver_port: Addresses)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Iterates over all IP addresses for +name+ retrieved from the mDNS\n" ++
  "    # resolver, provided name ends with \"local\".  If the name does not end in\n" ++
  "    # \"local\" no records will be returned.\n" ++
  "    #\n" ++
  "    # +name+ can be a Resolv::DNS::Name or a String.  Retrieved addresses will\n" ++
  "    # be a Resolv::IPv4 or Resolv::IPv6\n" ++
  "\n" ++
  "    def each_address(name)\n" ++
  "      name = Resolv::DNS::Name.create(name)\n" ++
  "\n" ++
  "      return unless name[-1].to_s == 'local'\n" ++
  "\n" ++
  "      super(name)\n" ++
  "    end\n" ++
  "\n" ++
  "    def make_udp_requester # :nodoc:\n" ++
  "      nameserver_port = @config.nameserver_port\n" ++
  "      Requester::MDNSOneShot.new(*nameserver_port)\n" ++
  "    end\n" ++
  "\n" ++
  "  end\n" ++
  "\n" ++
  "  module LOC # :nodoc:\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A Resolv::LOC::Size\n" ++
  "\n" ++
  "    class Size\n" ++
  "\n" ++
  "      # Regular expression LOC size must match.\n" ++
  "\n" ++
  "      Regex = /^(\\d+\\.*\\d*)[m]$/\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Creates a new LOC::Size from +arg+ which may be:\n" ++
  "      #\n" ++
  "      # LOC::Size:: returns +arg+.\n" ++
  "      # String:: +arg+ must match the LOC::Size::Regex constant\n" ++
  "\n" ++
  "      def self.create(arg)\n" ++
  "        case arg\n" ++
  "        when Size\n" ++
  "          return arg\n" ++
  "        when String\n" ++
  "          scalar = ''\n" ++
  "          if Regex =~ arg\n" ++
  "            scalar = [(($1.to_f*(1e2)).to_i.to_s[0].to_i*(2**4)+(($1.to_f*(1e2)).to_i.to_s.length-1))].pack(\"C\")\n" ++
  "          else\n" ++
  "            raise ArgumentError.new(\"not a properly formed Size string: \" + arg)\n" ++
  "          end\n" ++
  "          return Size.new(scalar)\n" ++
  "        else\n" ++
  "          raise ArgumentError.new(\"cannot interpret as Size: #\{arg.inspect\}\")\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      # Internal use; use self.create.\n" ++
  "      def initialize(scalar)\n" ++
  "        @scalar = scalar\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # The raw size\n" ++
  "\n" ++
  "      attr_reader :scalar\n" ++
  "\n" ++
  "      def to_s # :nodoc:\n" ++
  "        s = @scalar.unpack(\"H2\").join.to_s\n" ++
  "        return ((s[0].to_i)*(10**(s[1].to_i-2))).to_s << \"m\"\n" ++
  "      end\n" ++
  "\n" ++
  "      def inspect # :nodoc:\n" ++
  "        return \"#<#\{self.class\} #\{self\}>\"\n" ++
  "      end\n" ++
  "\n" ++
  "      def ==(other) # :nodoc:\n" ++
  "        return @scalar == other.scalar\n" ++
  "      end\n" ++
  "\n" ++
  "      def eql?(other) # :nodoc:\n" ++
  "        return self == other\n" ++
  "      end\n" ++
  "\n" ++
  "      def hash # :nodoc:\n" ++
  "        return @scalar.hash\n" ++
  "      end\n" ++
  "\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A Resolv::LOC::Coord\n" ++
  "\n" ++
  "    class Coord\n" ++
  "\n" ++
  "      # Regular expression LOC Coord must match.\n" ++
  "\n" ++
  "      Regex = /^(\\d+)\\s(\\d+)\\s(\\d+\\.\\d+)\\s([NESW])$/\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Creates a new LOC::Coord from +arg+ which may be:\n" ++
  "      #\n" ++
  "      # LOC::Coord:: returns +arg+.\n" ++
  "      # String:: +arg+ must match the LOC::Coord::Regex constant\n" ++
  "\n" ++
  "      def self.create(arg)\n" ++
  "        case arg\n" ++
  "        when Coord\n" ++
  "          return arg\n" ++
  "        when String\n" ++
  "          coordinates = ''\n" ++
  "          if Regex =~ arg && $1.to_f < 180\n" ++
  "            m = $~\n" ++
  "            hemi = (m[4][/[NE]/]) || (m[4][/[SW]/]) ? 1 : -1\n" ++
  "            coordinates = [ ((m[1].to_i*(36e5)) + (m[2].to_i*(6e4)) +\n" ++
  "                             (m[3].to_f*(1e3))) * hemi+(2**31) ].pack(\"N\")\n" ++
  "            orientation = m[4][/[NS]/] ? 'lat' : 'lon'\n" ++
  "          else\n" ++
  "            raise ArgumentError.new(\"not a properly formed Coord string: \" + arg)\n" ++
  "          end\n" ++
  "          return Coord.new(coordinates,orientation)\n" ++
  "        else\n" ++
  "          raise ArgumentError.new(\"cannot interpret as Coord: #\{arg.inspect\}\")\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      # Internal use; use self.create.\n" ++
  "      def initialize(coordinates,orientation)\n" ++
  "        unless coordinates.kind_of?(String)\n" ++
  "          raise ArgumentError.new(\"Coord must be a 32bit unsigned integer in hex format: #\{coordinates.inspect\}\")\n" ++
  "        end\n" ++
  "        unless orientation.kind_of?(String) && orientation[/^lon$|^lat$/]\n" ++
  "          raise ArgumentError.new('Coord expects orientation to be a String argument of \"lat\" or \"lon\"')\n" ++
  "        end\n" ++
  "        @coordinates = coordinates\n" ++
  "        @orientation = orientation\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # The raw coordinates\n" ++
  "\n" ++
  "      attr_reader :coordinates\n" ++
  "\n" ++
  "      ## The orientation of the hemisphere as 'lat' or 'lon'\n" ++
  "\n" ++
  "      attr_reader :orientation\n" ++
  "\n" ++
  "      def to_s # :nodoc:\n" ++
  "          c = @coordinates.unpack(\"N\").join.to_i\n" ++
  "          val      = (c - (2**31)).abs\n" ++
  "          fracsecs = (val % 1e3).to_i.to_s\n" ++
  "          val      = val / 1e3\n" ++
  "          secs     = (val % 60).to_i.to_s\n" ++
  "          val      = val / 60\n" ++
  "          mins     = (val % 60).to_i.to_s\n" ++
  "          degs     = (val / 60).to_i.to_s\n" ++
  "          posi = (c >= 2**31)\n" ++
  "          case posi\n" ++
  "          when true\n" ++
  "            hemi = @orientation[/^lat$/] ? \"N\" : \"E\"\n" ++
  "          else\n" ++
  "            hemi = @orientation[/^lon$/] ? \"W\" : \"S\"\n" ++
  "          end\n" ++
  "          return degs << \" \" << mins << \" \" << secs << \".\" << fracsecs << \" \" << hemi\n" ++
  "      end\n" ++
  "\n" ++
  "      def inspect # :nodoc:\n" ++
  "        return \"#<#\{self.class\} #\{self\}>\"\n" ++
  "      end\n" ++
  "\n" ++
  "      def ==(other) # :nodoc:\n" ++
  "        return @coordinates == other.coordinates\n" ++
  "      end\n" ++
  "\n" ++
  "      def eql?(other) # :nodoc:\n" ++
  "        return self == other\n" ++
  "      end\n" ++
  "\n" ++
  "      def hash # :nodoc:\n" ++
  "        return @coordinates.hash\n" ++
  "      end\n" ++
  "\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # A Resolv::LOC::Alt\n" ++
  "\n" ++
  "    class Alt\n" ++
  "\n" ++
  "      # Regular expression LOC Alt must match.\n" ++
  "\n" ++
  "      Regex = /^([+-]*\\d+\\.*\\d*)[m]$/\n" ++
  "\n" ++
  "      ##\n" ++
  "      # Creates a new LOC::Alt from +arg+ which may be:\n" ++
  "      #\n" ++
  "      # LOC::Alt:: returns +arg+.\n" ++
  "      # String:: +arg+ must match the LOC::Alt::Regex constant\n" ++
  "\n" ++
  "      def self.create(arg)\n" ++
  "        case arg\n" ++
  "        when Alt\n" ++
  "          return arg\n" ++
  "        when String\n" ++
  "          altitude = ''\n" ++
  "          if Regex =~ arg\n" ++
  "            altitude = [($1.to_f*(1e2))+(1e7)].pack(\"N\")\n" ++
  "          else\n" ++
  "            raise ArgumentError.new(\"not a properly formed Alt string: \" + arg)\n" ++
  "          end\n" ++
  "          return Alt.new(altitude)\n" ++
  "        else\n" ++
  "          raise ArgumentError.new(\"cannot interpret as Alt: #\{arg.inspect\}\")\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      # Internal use; use self.create.\n" ++
  "      def initialize(altitude)\n" ++
  "        @altitude = altitude\n" ++
  "      end\n" ++
  "\n" ++
  "      ##\n" ++
  "      # The raw altitude\n" ++
  "\n" ++
  "      attr_reader :altitude\n" ++
  "\n" ++
  "      def to_s # :nodoc:\n" ++
  "        a = @altitude.unpack(\"N\").join.to_i\n" ++
  "        return ((a.to_f/1e2)-1e5).to_s + \"m\"\n" ++
  "      end\n" ++
