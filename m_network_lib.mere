  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def stream_check\n" ++
  "    raise IOError, 'attempt to read body out of block' if @socket.nil? || @socket.closed?\n" ++
  "  end\n" ++
  "\n" ++
  "  def procdest(dest, block)\n" ++
  "    raise ArgumentError, 'both arg and block given for HTTP method' if\n" ++
  "      dest and block\n" ++
  "    if block\n" ++
  "      Net::ReadAdapter.new(block)\n" ++
  "    else\n" ++
  "      dest || +''\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Inflater is a wrapper around Net::BufferedIO that transparently inflates\n" ++
  "  # zlib and gzip streams.\n" ++
  "\n" ++
  "  class Inflater # :nodoc:\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Creates a new Inflater wrapping +socket+\n" ++
  "\n" ++
  "    def initialize socket\n" ++
  "      @socket = socket\n" ++
  "      # zlib with automatic gzip detection\n" ++
  "      @inflate = Zlib::Inflate.new(32 + Zlib::MAX_WBITS)\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Finishes the inflate stream.\n" ++
  "\n" ++
  "    def finish\n" ++
  "      return if @inflate.total_in == 0\n" ++
  "      @inflate.finish\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # The number of bytes inflated, used to update the Content-Length of\n" ++
  "    # the response.\n" ++
  "\n" ++
  "    def bytes_inflated\n" ++
  "      @inflate.total_out\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Returns a Net::ReadAdapter that inflates each read chunk into +dest+.\n" ++
  "    #\n" ++
  "    # This allows a large response body to be inflated without storing the\n" ++
  "    # entire body in memory.\n" ++
  "\n" ++
  "    def inflate_adapter(dest)\n" ++
  "      if dest.respond_to?(:set_encoding)\n" ++
  "        dest.set_encoding(Encoding::ASCII_8BIT)\n" ++
  "      elsif dest.respond_to?(:force_encoding)\n" ++
  "        dest.force_encoding(Encoding::ASCII_8BIT)\n" ++
