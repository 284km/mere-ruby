  "    Ractor.make_shareable(GET_TIME) rescue nil\n" ++
  "  end\n" ++
  "  private_constant :GET_TIME\n" ++
  "\n" ++
  "  class State\n" ++
  "    def initialize\n" ++
  "      @condvar = ConditionVariable.new\n" ++
  "      @queue = Queue.new\n" ++
  "      @queue_mutex = Mutex.new\n" ++
  "\n" ++
  "      @timeout_thread = nil\n" ++
  "      @timeout_thread_mutex = Mutex.new\n" ++
  "    end\n" ++
  "\n" ++
  "    if defined?(Ractor.store_if_absent) && defined?(Ractor.shareable?) && Ractor.shareable?(GET_TIME)\n" ++
  "      # Ractor support if\n" ++
  "      # 1. Ractor.store_if_absent is available\n" ++
  "      # 2. Method object can be shareable (4.0~)\n" ++
  "      def self.instance\n" ++
  "        Ractor.store_if_absent :timeout_gem_state do\n" ++
  "          State.new\n" ++
  "        end\n" ++
  "      end\n" ++
  "    else\n" ++
  "      GLOBAL_STATE = State.new\n" ++
  "\n" ++
  "      def self.instance\n" ++
  "        GLOBAL_STATE\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def create_timeout_thread\n" ++
  "      # Threads unexpectedly inherit the interrupt mask: https://github.com/ruby/timeout/issues/41\n" ++
  "      # So reset the interrupt mask to the default one for the timeout thread\n" ++
  "      Thread.handle_interrupt(Object => :immediate) do\n" ++
  "        watcher = Thread.new do\n" ++
  "          requests = []\n" ++
  "          while true\n" ++
  "            until @queue.empty? and !requests.empty? # wait to have at least one request\n" ++
  "              req = @queue.pop\n" ++
  "              requests << req unless req.done?\n" ++
  "            end\n" ++
  "            closest_deadline = requests.min_by(&:deadline).deadline\n" ++
  "\n" ++
  "            now = 0.0\n" ++
  "            @queue_mutex.synchronize do\n" ++
  "              while (now = GET_TIME.call(Process::CLOCK_MONOTONIC)) < closest_deadline and @queue.empty?\n" ++
  "                @condvar.wait(@queue_mutex, closest_deadline - now)\n" ++
  "              end\n" ++
  "            end\n" ++
  "\n" ++
  "            requests.each do |req|\n" ++
  "              req.interrupt if req.expired?(now)\n" ++
  "            end\n" ++
  "            requests.reject!(&:done?)\n" ++
  "          end\n" ++
  "        end\n" ++
  "\n" ++
  "        if !watcher.group.enclosed? && (!defined?(Ractor.main?) || Ractor.main?)\n" ++
  "          ThreadGroup::Default.add(watcher)\n" ++
  "        end\n" ++
  "\n" ++
  "        watcher.name = \"Timeout stdlib thread\"\n" ++
  "        watcher.thread_variable_set(:\"\\0__detached_thread__\", true)\n" ++
  "        watcher\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def ensure_timeout_thread_created\n" ++
