  "      @debug_output << '<- ' if @debug_output\n" ++
  "      yield\n" ++
  "      @debug_output << \"\\n\" if @debug_output\n" ++
  "      bytes = @written_bytes\n" ++
  "      @written_bytes = nil\n" ++
  "      bytes\n" ++
  "    end\n" ++
  "\n" ++
  "    def write0(*strs)\n" ++
  "      @debug_output << strs.map(&:dump).join if @debug_output\n" ++
  "      orig_written_bytes = @written_bytes\n" ++
  "      strs.each_with_index do |str, i|\n" ++
  "        need_retry = true\n" ++
