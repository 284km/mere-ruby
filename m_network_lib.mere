  "\n" ++
  "      def eql?(other) # :nodoc:\n" ++
  "        return self == other\n" ++
  "      end\n" ++
  "\n" ++
  "      def hash # :nodoc:\n" ++
  "        return @altitude.hash\n" ++
  "      end\n" ++
  "\n" ++
  "    end\n" ++
  "\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Default resolver to use for Resolv class methods.\n" ++
  "\n" ++
  "  DefaultResolver = self.new\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Replaces the resolvers in the default resolver with +new_resolvers+.  This\n" ++
  "  # allows resolvers to be changed for resolv-replace.\n" ++
  "\n" ++
  "  def DefaultResolver.replace_resolvers new_resolvers\n" ++
