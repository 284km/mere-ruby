  "  # and is processing the request, but no response is available yet.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 2518\}[https://www.rfc-editor.org/rfc/rfc2518#section-10.1].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#102].\n" ++
  "  #\n" ++
  "  class HTTPProcessing < HTTPInformation\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Early Hints</tt> responses (status code 103).\n" ++
  "  #\n" ++
