  "# frozen_string_literal: true\n" ++
  "# Timeout long-running blocks\n" ++
  "#\n" ++
  "# == Synopsis\n" ++
  "#\n" ++
  "#   require 'timeout'\n" ++
  "#   status = Timeout.timeout(5) \{\n" ++
  "#     # Something that should be interrupted if it takes more than 5 seconds...\n" ++
  "#   \}\n" ++
  "#\n" ++
  "# == Description\n" ++
  "#\n" ++
  "# Timeout provides a way to auto-terminate a potentially long-running\n" ++
  "# operation if it hasn't finished in a fixed amount of time.\n" ++
  "#\n" ++
  "# == Copyright\n" ++
  "#\n" ++
  "# Copyright:: (C) 2000  Network Applied Communication Laboratory, Inc.\n" ++
  "# Copyright:: (C) 2000  Information-technology Promotion Agency, Japan\n" ++
  "\n" ++
  "module Timeout\n" ++
  "  # The version\n" ++
  "  VERSION = \"0.6.0\"\n" ++
  "\n" ++
  "  # Internal exception raised to when a timeout is triggered.\n" ++
  "  class ExitException < Exception\n" ++
  "    def exception(*) # :nodoc:\n" ++
  "      self\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Raised by Timeout.timeout when the block times out.\n" ++
  "  class Error < RuntimeError\n" ++
  "    def self.handle_timeout(message) # :nodoc:\n" ++
  "      exc = ExitException.new(message)\n" ++
  "\n" ++
  "      begin\n" ++
  "        yield exc\n" ++
  "      rescue ExitException => e\n" ++
  "        raise new(message) if exc.equal?(e)\n" ++
  "        raise\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
