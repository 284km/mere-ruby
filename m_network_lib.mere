  "  #\n" ++
  "  class HTTPPreconditionRequired < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Too Many Requests</tt> responses (status code 429).\n" ++
  "  #\n" ++
  "  # The user has sent too many requests in a given amount of time.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
