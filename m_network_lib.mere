  "        self.headers = header\n" ++
  "      else\n" ++
  "        set_to(to)\n" ++
  "        set_headers(header)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # The primary e-mail address of the URL, as a String.\n" ++
  "    attr_reader :to\n" ++
  "\n" ++
  "    # E-mail headers set by the URL, as an Array of Arrays.\n" ++
  "    attr_reader :headers\n" ++
  "\n" ++
  "    # Checks the to +v+ component.\n" ++
  "    def check_to(v)\n" ++
  "      return true unless v\n" ++
  "      return true if v.size == 0\n" ++
  "\n" ++
  "      v.split(/[,;]/).each do |addr|\n" ++
  "        # check url safety as path-rootless\n" ++
  "        if /\\A(?:%\\h\\h|[!$&-.0-;=@-Z_a-z~])*\\z/ !~ addr\n" ++
  "          raise InvalidComponentError,\n" ++
