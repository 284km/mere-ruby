  "    # pct-encoded  = \"%\" HEXDIG HEXDIG\n" ++
  "    HEADER_REGEXP  = /\\A(?<hfield>(?:%\\h\\h|[!$'-.0-;@-Z_a-z~])*=(?:%\\h\\h|[!$'-.0-;@-Z_a-z~])*)(?:&\\g<hfield>)*\\z/\n" ++
  "    # practical regexp for email address\n" ++
  "    # https://html.spec.whatwg.org/multipage/input.html#valid-e-mail-address\n" ++
  "    EMAIL_REGEXP = /\\A[a-zA-Z0-9.!\\#$%&'*+\\/=?^_`\{|\}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]\{0,61\}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]\{0,61\}[a-zA-Z0-9])?)*\\z/\n" ++
  "    # :startdoc:\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Creates a new URI::MailTo object from components, with syntax checking.\n" ++
  "    #\n" ++
  "    # Components can be provided as an Array or Hash. If an Array is used,\n" ++
  "    # the components must be supplied as <code>[to, headers]</code>.\n" ++
  "    #\n" ++
  "    # If a Hash is used, the keys are the component names preceded by colons.\n" ++
  "    #\n" ++
  "    # The headers can be supplied as a pre-encoded string, such as\n" ++
  "    # <code>\"subject=subscribe&cc=address\"</code>, or as an Array of Arrays\n" ++
  "    # like <code>[['subject', 'subscribe'], ['cc', 'address']]</code>.\n" ++
  "    #\n" ++
  "    # Examples:\n" ++
  "    #\n" ++
  "    #    require 'uri'\n" ++
  "    #\n" ++
  "    #    m1 = URI::MailTo.build(['joe@example.com', 'subject=Ruby'])\n" ++
  "    #    m1.to_s  # => \"mailto:joe@example.com?subject=Ruby\"\n" ++
  "    #\n" ++
  "    #    m2 = URI::MailTo.build(['john@example.com', [['Subject', 'Ruby'], ['Cc', 'jack@example.com']]])\n" ++
  "    #    m2.to_s  # => \"mailto:john@example.com?Subject=Ruby&Cc=jack@example.com\"\n" ++
  "    #\n" ++
  "    #    m3 = URI::MailTo.build(\{:to => 'listman@example.com', :headers => [['subject', 'subscribe']]\})\n" ++
  "    #    m3.to_s  # => \"mailto:listman@example.com?subject=subscribe\"\n" ++
  "    #\n" ++
  "    def self.build(args)\n" ++
  "      tmp = Util.make_components_hash(self, args)\n" ++
  "\n" ++
  "      case tmp[:to]\n" ++
  "      when Array\n" ++
  "        tmp[:opaque] = tmp[:to].join(',')\n" ++
  "      when String\n" ++
  "        tmp[:opaque] = tmp[:to].dup\n" ++
  "      else\n" ++
  "        tmp[:opaque] = ''\n" ++
  "      end\n" ++
  "\n" ++
  "      if tmp[:headers]\n" ++
  "        query =\n" ++
  "          case tmp[:headers]\n" ++
  "          when Array\n" ++
  "            tmp[:headers].collect \{ |x|\n" ++
  "              if x.kind_of?(Array)\n" ++
  "                x[0] + '=' + x[1..-1].join\n" ++
  "              else\n" ++
  "                x.to_s\n" ++
  "              end\n" ++
  "            \}.join('&')\n" ++
  "          when Hash\n" ++
  "            tmp[:headers].collect \{ |h,v|\n" ++
  "              h + '=' + v\n" ++
  "            \}.join('&')\n" ++
  "          else\n" ++
  "            tmp[:headers].to_s\n" ++
  "          end\n" ++
  "        unless query.empty?\n" ++
  "          tmp[:opaque] << '?' << query\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      super(tmp)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Creates a new URI::MailTo object from generic URL components with\n" ++
  "    # no syntax checking.\n" ++
  "    #\n" ++
  "    # This method is usually called from URI::parse, which checks\n" ++
