  "  #\n" ++
  "  class HTTPServiceUnavailable < HTTPServerError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Gateway Timeout</tt> responses (status code 504).\n" ++
  "  #\n" ++
  "  # The server was acting as a gateway or proxy\n" ++
