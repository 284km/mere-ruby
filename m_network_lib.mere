  "      while (str = readuntil(\"\\r\\n\")) != \".\\r\\n\"\n" ++
  "        yield str.chop\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def write_message_0(src)\n" ++
  "      prev = @written_bytes\n" ++
  "      each_crlf_line(src) do |line|\n" ++
  "        write0 dot_stuff(line)\n" ++
  "      end\n" ++
  "      @written_bytes - prev\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Write\n" ++
  "    #\n" ++
  "\n" ++
  "    def write_message(src)\n" ++
  "      LOG \"writing message from #\{src.class\}\"\n" ++
  "      LOG_off()\n" ++
  "      len = writing \{\n" ++
  "        using_each_crlf_line \{\n" ++
  "          write_message_0 src\n" ++
  "        \}\n" ++
  "      \}\n" ++
  "      LOG_on()\n" ++
  "      LOG \"wrote #\{len\} bytes\"\n" ++
  "      len\n" ++
  "    end\n" ++
  "\n" ++
  "    def write_message_by_block(&block)\n" ++
  "      LOG 'writing message from block'\n" ++
  "      LOG_off()\n" ++
  "      len = writing \{\n" ++
  "        using_each_crlf_line \{\n" ++
