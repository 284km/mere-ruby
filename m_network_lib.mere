  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#412].\n" ++
  "  #\n" ++
  "  class HTTPPreconditionFailed < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Payload Too Large</tt> responses (status code 413).\n" ++
  "  #\n" ++
  "  # The request is larger than the server is willing or able to process.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/413].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-413-content-too-large].\n" ++
