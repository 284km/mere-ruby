  "        return\n" ++
  "      end\n" ++
  "      clen = range_length()\n" ++
  "      if clen\n" ++
  "        @socket.read clen, dest\n" ++
  "        return\n" ++
  "      end\n" ++
  "      @socket.read_all dest\n" ++
