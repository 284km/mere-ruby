  "\n" ++
  "require_relative 'generic'\n" ++
  "\n" ++
  "module URI\n" ++
  "\n" ++
  "  #\n" ++
  "  # The \"file\" URI is defined by RFC8089.\n" ++
  "  #\n" ++
  "  class File < Generic\n" ++
  "    # A Default port of nil for URI::File.\n" ++
  "    DEFAULT_PORT = nil\n" ++
  "\n" ++
  "    #\n" ++
  "    # An Array of the available components for URI::File.\n" ++
  "    #\n" ++
  "    COMPONENT = [\n" ++
  "      :scheme,\n" ++
  "      :host,\n" ++
  "      :path\n" ++
  "    ].freeze\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Creates a new URI::File object from components, with syntax checking.\n" ++
  "    #\n" ++
  "    # The components accepted are +host+ and +path+.\n" ++
  "    #\n" ++
  "    # The components should be provided either as an Array, or as a Hash\n" ++
  "    # with keys formed by preceding the component names with a colon.\n" ++
  "    #\n" ++
  "    # If an Array is used, the components must be passed in the\n" ++
  "    # order <code>[host, path]</code>.\n" ++
  "    #\n" ++
  "    # A path from e.g. the File class should be escaped before\n" ++
  "    # being passed.\n" ++
  "    #\n" ++
  "    # Examples:\n" ++
  "    #\n" ++
  "    #     require 'uri'\n" ++
  "    #\n" ++
  "    #     uri1 = URI::File.build(['host.example.com', '/path/file.zip'])\n" ++
  "    #     uri1.to_s  # => \"file://host.example.com/path/file.zip\"\n" ++
  "    #\n" ++
  "    #     uri2 = URI::File.build(\{:host => 'host.example.com',\n" ++
  "    #       :path => '/ruby/src'\})\n" ++
  "    #     uri2.to_s  # => \"file://host.example.com/ruby/src\"\n" ++
  "    #\n" ++
  "    #     uri3 = URI::File.build(\{:path => URI::RFC2396_PARSER.escape('/path/my file.txt')\})\n" ++
  "    #     uri3.to_s  # => \"file:///path/my%20file.txt\"\n" ++
  "    #\n" ++
  "    def self.build(args)\n" ++
  "      tmp = Util::make_components_hash(self, args)\n" ++
  "      super(tmp)\n" ++
