  "    def self.build(args)\n" ++
  "      tmp = Util::make_components_hash(self, args)\n" ++
  "\n" ++
  "      if tmp[:dn]\n" ++
  "        tmp[:path] = tmp[:dn]\n" ++
  "      end\n" ++
  "\n" ++
  "      query = []\n" ++
  "      [:extensions, :filter, :scope, :attributes].collect do |x|\n" ++
  "        next if !tmp[x] && query.size == 0\n" ++
  "        query.unshift(tmp[x])\n" ++
  "      end\n" ++
  "\n" ++
  "      tmp[:query] = query.join('?')\n" ++
  "\n" ++
  "      return super(tmp)\n" ++
  "    end\n" ++
