  "\n" ++
  "  def extracting_encodings_from_meta_elements(value)\n" ++
  "    # http://dev.w3.org/html5/spec/fetching-resources.html#algorithm-for-extracting-an-encoding-from-a-meta-element\n" ++
  "    if /charset[\\t\\n\\f\\r ]*=(?:\"([^\"]*)\"|'([^']*)'|[\"']|\\z|([^\\t\\n\\f\\r ;]+))/i =~ value\n" ++
  "      return $1 || $2 || $3\n" ++
