  "  #\n" ++
  "  # See RFC 2616 section 3.6.1 for definitions\n" ++
  "\n" ++
  "  def read_chunked(dest, chunk_data_io) # :nodoc:\n" ++
  "    total = 0\n" ++
  "    while true\n" ++
  "      line = @socket.readline\n" ++
  "      hexlen = line.slice(/[0-9a-fA-F]+/) or\n" ++
