  "\n" ++
  "  ##\n" ++
  "  # read_chunked reads from +@socket+ for chunk-size, chunk-extension, CRLF,\n" ++
  "  # etc. and +chunk_data_io+ for chunk-data which may be deflate or gzip\n" ++
