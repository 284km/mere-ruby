  "\n" ++
  "  # Response class for <tt>Internal Server Error</tt> responses (status code 500).\n" ++
  "  #\n" ++
  "  # An unexpected condition was encountered and no more specific message is suitable.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
