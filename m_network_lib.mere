  "    #  Note that the active mode is default in Ruby 1.8 or prior.\n" ++
  "    #\n" ++
  "    # [:redirect]\n" ++
  "    #  Synopsis:\n" ++
  "    #    :redirect=>bool\n" ++
  "    #\n" ++
  "    #  +:redirect+ is true by default.  <tt>:redirect => false</tt> is used to\n" ++
  "    #  disable all HTTP redirects.\n" ++
  "    #\n" ++
  "    #  OpenURI::HTTPRedirect exception raised on redirection.\n" ++
