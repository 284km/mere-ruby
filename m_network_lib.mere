  "            else\n" ++
  "              need_retry = false\n" ++
  "              # next string\n" ++
  "            end\n" ++
  "          elsif len < 0\n" ++
  "            str = str.byteslice(len, -len)\n" ++
  "          else # len > 0\n" ++
  "            need_retry = false\n" ++
  "            # next string\n" ++
