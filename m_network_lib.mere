  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "  HTTPRequestedRangeNotSatisfiable = HTTPRangeNotSatisfiable\n" ++
  "\n" ++
  "  # Response class for <tt>Expectation Failed</tt> responses (status code 417).\n" ++
  "  #\n" ++
  "  # The server cannot meet the requirements of the Expect request-header field.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/417].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-417-expectation-failed].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#417].\n" ++
  "  #\n" ++
