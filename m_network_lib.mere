  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Failed Dependency (WebDAV)</tt> responses (status code 424).\n" ++
  "  #\n" ++
  "  # The request failed because it depended on another request and that request failed.\n" ++
  "  # See \{424 Failed Dependency (WebDAV)\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#424].\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 4918\}[https://www.rfc-editor.org/rfc/rfc4918#section-11.4].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#424].\n" ++
  "  #\n" ++
  "  class HTTPFailedDependency < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # 425 Too Early\n" ++
  "  # https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#425.\n" ++
  "\n" ++
  "  # Response class for <tt>Upgrade Required</tt> responses (status code 426).\n" ++
  "  #\n" ++
  "  # The client should switch to the protocol given in the Upgrade header field.\n" ++
  "  #\n" ++
