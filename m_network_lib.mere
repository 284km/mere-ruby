  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#410].\n" ++
  "  #\n" ++
  "  class HTTPGone < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Length Required</tt> responses (status code 411).\n" ++
  "  #\n" ++
  "  # The request did not specify the length of its content,\n" ++
  "  # which is required by the requested resource.\n" ++
