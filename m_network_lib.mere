  "\n" ++
  "  ##\n" ++
  "  # Checks for a supported Content-Encoding header and yields an Inflate\n" ++
  "  # wrapper for this response's socket when zlib is present.  If the\n" ++
  "  # Content-Encoding is not supported or zlib is missing, the plain socket is\n" ++
