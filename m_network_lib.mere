  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/103].\n" ++
  "  # - \{RFC 8297\}[https://www.rfc-editor.org/rfc/rfc8297.html#section-2].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#103].\n" ++
  "  #\n" ++
  "  class HTTPEarlyHints < HTTPInformation\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for +OK+ responses (status code 200).\n" ++
  "  #\n" ++
  "  # The +OK+ response indicates that the server has received\n" ++
  "  # a request and has responded successfully.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/200].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-200-ok].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#200].\n" ++
  "  #\n" ++
  "  class HTTPOK < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for +Created+ responses (status code 201).\n" ++
  "  #\n" ++
  "  # The +Created+ response indicates that the server has received\n" ++
  "  # and has fulfilled a request to create a new resource.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/201].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-201-created].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#201].\n" ++
  "  #\n" ++
  "  class HTTPCreated < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for +Accepted+ responses (status code 202).\n" ++
  "  #\n" ++
  "  # The +Accepted+ response indicates that the server has received\n" ++
  "  # and is processing a request, but the processing has not yet been completed.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/202].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-202-accepted].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#202].\n" ++
  "  #\n" ++
  "  class HTTPAccepted < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Non-Authoritative Information</tt> responses (status code 203).\n" ++
  "  #\n" ++
  "  # The <tt>Non-Authoritative Information</tt> response indicates that the server\n" ++
  "  # is a transforming proxy (such as a Web accelerator)\n" ++
  "  # that received a 200 OK response from its origin,\n" ++
  "  # and is returning a modified version of the origin's response.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/203].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-203-non-authoritative-infor].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#203].\n" ++
  "  #\n" ++
  "  class HTTPNonAuthoritativeInformation < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>No Content</tt> responses (status code 204).\n" ++
  "  #\n" ++
  "  # The <tt>No Content</tt> response indicates that the server\n" ++
  "  # successfully processed the request, and is not returning any content.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/204].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-204-no-content].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#204].\n" ++
  "  #\n" ++
  "  class HTTPNoContent < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Reset Content</tt> responses (status code 205).\n" ++
  "  #\n" ++
  "  # The <tt>Reset Content</tt> response indicates that the server\n" ++
  "  # successfully processed the request,\n" ++
  "  # asks that the client reset its document view, and is not returning any content.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/205].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-205-reset-content].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#205].\n" ++
  "  #\n" ++
  "  class HTTPResetContent < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Partial Content</tt> responses (status code 206).\n" ++
  "  #\n" ++
  "  # The <tt>Partial Content</tt> response indicates that the server is delivering\n" ++
  "  # only part of the resource (byte serving)\n" ++
  "  # due to a Range header in the request.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/206].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-206-partial-content].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#206].\n" ++
  "  #\n" ++
  "  class HTTPPartialContent < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Multi-Status (WebDAV)</tt> responses (status code 207).\n" ++
  "  #\n" ++
  "  # The <tt>Multi-Status (WebDAV)</tt> response indicates that the server\n" ++
  "  # has received the request,\n" ++
  "  # and that the message body can contain a number of separate response codes.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 4818\}[https://www.rfc-editor.org/rfc/rfc4918#section-11.1].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#207].\n" ++
  "  #\n" ++
  "  class HTTPMultiStatus < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Already Reported (WebDAV)</tt> responses (status code 208).\n" ++
  "  #\n" ++
  "  # The <tt>Already Reported (WebDAV)</tt> response indicates that the server\n" ++
  "  # has received the request,\n" ++
  "  # and that the members of a DAV binding have already been enumerated\n" ++
  "  # in a preceding part of the (multi-status) response,\n" ++
  "  # and are not being included again.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 5842\}[https://www.rfc-editor.org/rfc/rfc5842.html#section-7.1].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#208].\n" ++
  "  #\n" ++
  "  class HTTPAlreadyReported < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>IM Used</tt> responses (status code 226).\n" ++
  "  #\n" ++
  "  # The <tt>IM Used</tt> response indicates that the server has fulfilled a request\n" ++
  "  # for the resource, and the response is a representation of the result\n" ++
  "  # of one or more instance-manipulations applied to the current instance.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 3229\}[https://www.rfc-editor.org/rfc/rfc3229.html#section-10.4.1].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#226].\n" ++
  "  #\n" ++
  "  class HTTPIMUsed < HTTPSuccess\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Multiple Choices</tt> responses (status code 300).\n" ++
  "  #\n" ++
  "  # The <tt>Multiple Choices</tt> response indicates that the server\n" ++
  "  # offers multiple options for the resource from which the client may choose.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/300].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-300-multiple-choices].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#300].\n" ++
  "  #\n" ++
  "  class HTTPMultipleChoices < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "  HTTPMultipleChoice = HTTPMultipleChoices\n" ++
  "\n" ++
  "  # Response class for <tt>Moved Permanently</tt> responses (status code 301).\n" ++
  "  #\n" ++
  "  # The <tt>Moved Permanently</tt> response indicates that links or records\n" ++
  "  # returning this response should be updated to use the given URL.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/301].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-301-moved-permanently].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#301].\n" ++
  "  #\n" ++
  "  class HTTPMovedPermanently < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Found</tt> responses (status code 302).\n" ++
  "  #\n" ++
  "  # The <tt>Found</tt> response indicates that the client\n" ++
  "  # should look at (browse to) another URL.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/302].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-302-found].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#302].\n" ++
  "  #\n" ++
  "  class HTTPFound < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "  HTTPMovedTemporarily = HTTPFound\n" ++
  "\n" ++
  "  # Response class for <tt>See Other</tt> responses (status code 303).\n" ++
  "  #\n" ++
  "  # The response to the request can be found under another URI using the GET method.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/303].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-303-see-other].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#303].\n" ++
  "  #\n" ++
  "  class HTTPSeeOther < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Not Modified</tt> responses (status code 304).\n" ++
  "  #\n" ++
  "  # Indicates that the resource has not been modified since the version\n" ++
  "  # specified by the request headers.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/304].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-304-not-modified].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#304].\n" ++
  "  #\n" ++
  "  class HTTPNotModified < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Use Proxy</tt> responses (status code 305).\n" ++
  "  #\n" ++
  "  # The requested resource is available only through a proxy,\n" ++
  "  # whose address is provided in the response.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-305-use-proxy].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#305].\n" ++
  "  #\n" ++
  "  class HTTPUseProxy < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Temporary Redirect</tt> responses (status code 307).\n" ++
  "  #\n" ++
  "  # The request should be repeated with another URI;\n" ++
  "  # however, future requests should still use the original URI.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/307].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-307-temporary-redirect].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#307].\n" ++
  "  #\n" ++
  "  class HTTPTemporaryRedirect < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Permanent Redirect</tt> responses (status code 308).\n" ++
  "  #\n" ++
  "  # This and all future requests should be directed to the given URI.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/308].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-308-permanent-redirect].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#308].\n" ++
  "  #\n" ++
  "  class HTTPPermanentRedirect < HTTPRedirection\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Bad Request</tt> responses (status code 400).\n" ++
  "  #\n" ++
  "  # The server cannot or will not process the request due to an apparent client error.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/400].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-400-bad-request].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#400].\n" ++
  "  #\n" ++
  "  class HTTPBadRequest < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Unauthorized</tt> responses (status code 401).\n" ++
  "  #\n" ++
  "  # Authentication is required, but either was not provided or failed.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/401].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-401-unauthorized].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#401].\n" ++
  "  #\n" ++
  "  class HTTPUnauthorized < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Payment Required</tt> responses (status code 402).\n" ++
  "  #\n" ++
  "  # Reserved for future use.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/402].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-402-payment-required].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#402].\n" ++
  "  #\n" ++
  "  class HTTPPaymentRequired < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Forbidden</tt> responses (status code 403).\n" ++
  "  #\n" ++
  "  # The request contained valid data and was understood by the server,\n" ++
  "  # but the server is refusing action.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/403].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-403-forbidden].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#403].\n" ++
  "  #\n" ++
  "  class HTTPForbidden < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Not Found</tt> responses (status code 404).\n" ++
  "  #\n" ++
  "  # The requested resource could not be found but may be available in the future.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/404].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-404-not-found].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#404].\n" ++
  "  #\n" ++
  "  class HTTPNotFound < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Method Not Allowed</tt> responses (status code 405).\n" ++
  "  #\n" ++
  "  # The request method is not supported for the requested resource.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/405].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-405-method-not-allowed].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#405].\n" ++
  "  #\n" ++
  "  class HTTPMethodNotAllowed < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Not Acceptable</tt> responses (status code 406).\n" ++
  "  #\n" ++
  "  # The requested resource is capable of generating only content\n" ++
  "  # that not acceptable according to the Accept headers sent in the request.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/406].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-406-not-acceptable].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#406].\n" ++
  "  #\n" ++
  "  class HTTPNotAcceptable < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Proxy Authentication Required</tt> responses (status code 407).\n" ++
  "  #\n" ++
  "  # The client must first authenticate itself with the proxy.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/407].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-407-proxy-authentication-re].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#407].\n" ++
  "  #\n" ++
  "  class HTTPProxyAuthenticationRequired < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Request Timeout</tt> responses (status code 408).\n" ++
  "  #\n" ++
  "  # The server timed out waiting for the request.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/408].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-408-request-timeout].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#408].\n" ++
  "  #\n" ++
  "  class HTTPRequestTimeout < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "  HTTPRequestTimeOut = HTTPRequestTimeout\n" ++
  "\n" ++
  "  # Response class for <tt>Conflict</tt> responses (status code 409).\n" ++
  "  #\n" ++
  "  # The request could not be processed because of conflict in the current state of the resource.\n" ++
  "  #\n" ++
