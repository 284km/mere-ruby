  "\n" ++
  "    #\n" ++
  "    # Logging\n" ++
  "    #\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    def LOG_off\n" ++
  "      @save_debug_out = @debug_output\n" ++
  "      @debug_output = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    def LOG_on\n" ++
  "      @debug_output = @save_debug_out\n" ++
  "    end\n" ++
  "\n" ++
  "    def LOG(msg)\n" ++
  "      return unless @debug_output\n" ++
  "      @debug_output << msg + \"\\n\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  class InternetMessageIO < BufferedIO   #:nodoc: internal use only\n" ++
  "    def initialize(*, **)\n" ++
  "      super\n" ++
  "      @wbuf = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Read\n" ++
  "    #\n" ++
  "\n" ++
  "    def each_message_chunk\n" ++
  "      LOG 'reading message...'\n" ++
  "      LOG_off()\n" ++
  "      read_bytes = 0\n" ++
  "      while (line = readuntil(\"\\r\\n\")) != \".\\r\\n\"\n" ++
  "        read_bytes += line.size\n" ++
  "        yield line.delete_prefix('.')\n" ++
  "      end\n" ++
  "      LOG_on()\n" ++
  "      LOG \"read message (#\{read_bytes\} bytes)\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # *library private* (cannot handle 'break')\n" ++
