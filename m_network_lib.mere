  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#426].\n" ++
  "  #\n" ++
  "  class HTTPUpgradeRequired < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Precondition Required</tt> responses (status code 428).\n" ++
  "  #\n" ++
  "  # The origin server requires the request to be conditional.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
