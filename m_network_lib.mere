  "    # from using the +query+ component attribute.\n" ++
  "    def parse_query\n" ++
  "      @attributes = nil\n" ++
  "      @scope      = nil\n" ++
  "      @filter     = nil\n" ++
  "      @extensions = nil\n" ++
  "\n" ++
  "      if @query\n" ++
  "        attrs, scope, filter, extensions = @query.split('?')\n" ++
  "\n" ++
  "        @attributes = attrs if attrs && attrs.size > 0\n" ++
  "        @scope      = scope if scope && scope.size > 0\n" ++
  "        @filter     = filter if filter && filter.size > 0\n" ++
  "        @extensions = extensions if extensions && extensions.size > 0\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :parse_query\n" ++
  "\n" ++
  "    # Private method to assemble +query+ from +attributes+, +scope+, +filter+, and +extensions+.\n" ++
  "    def build_path_query\n" ++
  "      @path = '/' + @dn\n" ++
  "\n" ++
  "      query = []\n" ++
  "      [@extensions, @filter, @scope, @attributes].each do |x|\n" ++
  "        next if !x && query.size == 0\n" ++
  "        query.unshift(x)\n" ++
  "      end\n" ++
  "      @query = query.join('?')\n" ++
  "    end\n" ++
  "    private :build_path_query\n" ++
  "\n" ++
  "    # Returns dn.\n" ++
  "    def dn\n" ++
  "      @dn\n" ++
  "    end\n" ++
  "\n" ++
  "    # Private setter for dn +val+.\n" ++
  "    def set_dn(val)\n" ++
  "      @dn = val\n" ++
  "      build_path_query\n" ++
  "      @dn\n" ++
  "    end\n" ++
  "    protected :set_dn\n" ++
  "\n" ++
  "    # Setter for dn +val+.\n" ++
  "    def dn=(val)\n" ++
  "      set_dn(val)\n" ++
  "      val\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns attributes.\n" ++
  "    def attributes\n" ++
  "      @attributes\n" ++
  "    end\n" ++
  "\n" ++
  "    # Private setter for attributes +val+.\n" ++
  "    def set_attributes(val)\n" ++
  "      @attributes = val\n" ++
  "      build_path_query\n" ++
  "      @attributes\n" ++
  "    end\n" ++
  "    protected :set_attributes\n" ++
  "\n" ++
  "    # Setter for attributes +val+.\n" ++
  "    def attributes=(val)\n" ++
  "      set_attributes(val)\n" ++
  "      val\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns scope.\n" ++
  "    def scope\n" ++
  "      @scope\n" ++
  "    end\n" ++
  "\n" ++
  "    # Private setter for scope +val+.\n" ++
  "    def set_scope(val)\n" ++
  "      @scope = val\n" ++
  "      build_path_query\n" ++
  "      @scope\n" ++
  "    end\n" ++
  "    protected :set_scope\n" ++
  "\n" ++
  "    # Setter for scope +val+.\n" ++
  "    def scope=(val)\n" ++
  "      set_scope(val)\n" ++
  "      val\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns filter.\n" ++
  "    def filter\n" ++
  "      @filter\n" ++
  "    end\n" ++
  "\n" ++
  "    # Private setter for filter +val+.\n" ++
  "    def set_filter(val)\n" ++
  "      @filter = val\n" ++
  "      build_path_query\n" ++
  "      @filter\n" ++
  "    end\n" ++
  "    protected :set_filter\n" ++
  "\n" ++
  "    # Setter for filter +val+.\n" ++
  "    def filter=(val)\n" ++
  "      set_filter(val)\n" ++
  "      val\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns extensions.\n" ++
  "    def extensions\n" ++
  "      @extensions\n" ++
  "    end\n" ++
  "\n" ++
  "    # Private setter for extensions +val+.\n" ++
  "    def set_extensions(val)\n" ++
  "      @extensions = val\n" ++
  "      build_path_query\n" ++
  "      @extensions\n" ++
  "    end\n" ++
  "    protected :set_extensions\n" ++
