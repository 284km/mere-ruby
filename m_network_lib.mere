  "\n" ++
  "      begin\n" ++
  "        yield inflate_body_io\n" ++
  "        success = true\n" ++
  "      ensure\n" ++
  "        begin\n" ++
  "          inflate_body_io.finish\n" ++
  "          if self['content-length']\n" ++
  "            self['content-length'] = inflate_body_io.bytes_inflated.to_s\n" ++
