  "# frozen_string_literal: false\n" ++
  "# = uri/mailto.rb\n" ++
  "#\n" ++
  "# Author:: Akira Yamada <akira@ruby-lang.org>\n" ++
  "# License:: You can redistribute it and/or modify it under the same term as Ruby.\n" ++
  "#\n" ++
  "# See URI for general documentation\n" ++
  "#\n" ++
  "\n" ++
  "require_relative 'generic'\n" ++
  "\n" ++
  "module URI\n" ++
  "\n" ++
  "  #\n" ++
  "  # RFC6068, the mailto URL scheme.\n" ++
  "  #\n" ++
  "  class MailTo < Generic\n" ++
  "    include RFC2396_REGEXP\n" ++
  "\n" ++
  "    # A Default port of nil for URI::MailTo.\n" ++
  "    DEFAULT_PORT = nil\n" ++
  "\n" ++
  "    # An Array of the available components for URI::MailTo.\n" ++
  "    COMPONENT = [ :scheme, :to, :headers ].freeze\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "    #  \"hname\" and \"hvalue\" are encodings of an RFC 822 header name and\n" ++
  "    #  value, respectively. As with \"to\", all URL reserved characters must\n" ++
  "    #  be encoded.\n" ++
  "    #\n" ++
  "    #  \"#mailbox\" is as specified in RFC 822 [RFC822]. This means that it\n" ++
  "    #  consists of zero or more comma-separated mail addresses, possibly\n" ++
  "    #  including \"phrase\" and \"comment\" components. Note that all URL\n" ++
  "    #  reserved characters in \"to\" must be encoded: in particular,\n" ++
  "    #  parentheses, commas, and the percent sign (\"%\"), which commonly occur\n" ++
  "    #  in the \"mailbox\" syntax.\n" ++
  "    #\n" ++
  "    #  Within mailto URLs, the characters \"?\", \"=\", \"&\" are reserved.\n" ++
  "\n" ++
  "    # ; RFC 6068\n" ++
  "    # hfields      = \"?\" hfield *( \"&\" hfield )\n" ++
  "    # hfield       = hfname \"=\" hfvalue\n" ++
  "    # hfname       = *qchar\n" ++
  "    # hfvalue      = *qchar\n" ++
  "    # qchar        = unreserved / pct-encoded / some-delims\n" ++
  "    # some-delims  = \"!\" / \"$\" / \"'\" / \"(\" / \")\" / \"*\"\n" ++
  "    #              / \"+\" / \",\" / \";\" / \":\" / \"@\"\n" ++
  "    #\n" ++
  "    # ; RFC3986\n" ++
