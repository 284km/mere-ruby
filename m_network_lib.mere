  "  end\n" ++
  "  HTTPRequestURITooLong = HTTPURITooLong\n" ++
  "  HTTPRequestURITooLarge = HTTPRequestURITooLong\n" ++
  "\n" ++
  "  # Response class for <tt>Unsupported Media Type</tt> responses (status code 415).\n" ++
  "  #\n" ++
  "  # The request entity has a media type which the server or resource does not support.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/415].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-415-unsupported-media-type].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#415].\n" ++
  "  #\n" ++
  "  class HTTPUnsupportedMediaType < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Range Not Satisfiable</tt> responses (status code 416).\n" ++
  "  #\n" ++
  "  # The request entity has a media type which the server or resource does not support.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/416].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-416-range-not-satisfiable].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#416].\n" ++
  "  #\n" ++
