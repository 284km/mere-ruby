  "      block = proc do |compressed_chunk|\n" ++
  "        @inflate.inflate(compressed_chunk) do |chunk|\n" ++
  "          compressed_chunk.clear\n" ++
  "          dest << chunk\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      Net::ReadAdapter.new(block)\n" ++
  "    end\n" ++
  "\n" ++
  "    ##\n" ++
  "    # Reads +clen+ bytes from the socket, inflates them, then writes them to\n" ++
  "    # +dest+.  +ignore_eof+ is passed down to Net::BufferedIO#read\n" ++
  "    #\n" ++
  "    # Unlike Net::BufferedIO#read, this method returns more than +clen+ bytes.\n" ++
