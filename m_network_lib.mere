  "      s\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Write\n" ++
  "    #\n" ++
  "\n" ++
  "    public\n" ++
  "\n" ++
  "    def write(*strs)\n" ++
  "      writing \{\n" ++
  "        write0(*strs)\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    alias << write\n" ++
  "\n" ++
  "    def writeline(str)\n" ++
  "      writing \{\n" ++
  "        write0 str + \"\\r\\n\"\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
