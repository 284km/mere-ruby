  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "  HTTPRequestEntityTooLarge = HTTPPayloadTooLarge\n" ++
  "\n" ++
  "  # Response class for <tt>URI Too Long</tt> responses (status code 414).\n" ++
  "  #\n" ++
  "  # The URI provided was too long for the server to process.\n" ++
