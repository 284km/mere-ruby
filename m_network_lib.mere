  "    # For URI::LDAP this will return +false+.\n" ++
  "    def hierarchical?\n" ++
  "      false\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  register_scheme 'LDAP', LDAP\n" ++
  "end\n";
