  "        @rbuf = ''.b\n" ++
  "        @rbuf_offset = 0\n" ++
  "        @rbuf_empty = true\n" ++
  "      else\n" ++
  "        s = @rbuf.byteslice(@rbuf_offset, len)\n" ++
  "        @rbuf_offset += len\n" ++
  "        @rbuf_empty = @rbuf_offset == @rbuf.bytesize\n" ++
  "        rbuf_flush\n" ++
