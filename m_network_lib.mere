  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Unavailable For Legal Reasons</tt> responses (status code 451).\n" ++
  "  #\n" ++
  "  # A server operator has received a legal demand to deny access to a resource or to a set of resources\n" ++
  "  # that includes the requested resource.\n" ++
  "  #\n" ++
