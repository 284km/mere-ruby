  "\n" ++
  "module Kernel\n" ++
  "\n" ++
  "  #\n" ++
  "  # Returns a \\URI object derived from the given +uri+,\n" ++
  "  # which may be a \\URI string or an existing \\URI object:\n" ++
  "  #\n" ++
  "  #   require 'uri'\n" ++
  "  #   # Returns a new URI.\n" ++
  "  #   uri = URI('http://github.com/ruby/ruby')\n" ++
  "  #   # => #<URI::HTTP http://github.com/ruby/ruby>\n" ++
  "  #   # Returns the given URI.\n" ++
  "  #   URI(uri)\n" ++
  "  #   # => #<URI::HTTP http://github.com/ruby/ruby>\n" ++
  "  #\n" ++
  "  # You must require 'uri' to use this method.\n" ++
  "  #\n" ++
  "  def URI(uri)\n" ++
  "    if uri.is_a?(URI::Generic)\n" ++
  "      uri\n" ++
  "    elsif uri = String.try_convert(uri)\n" ++
  "      URI.parse(uri)\n" ++
  "    else\n" ++
  "      raise ArgumentError,\n" ++
  "        \"bad argument (expected URI object or URI string)\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  module_function :URI\n" ++
  "end\n";
