  "    #\n" ++
  "    # [:max_redirects]\n" ++
  "    #  Synopsis:\n" ++
  "    #    :max_redirects=>int\n" ++
  "    #\n" ++
  "    #  Number of HTTP redirects allowed before OpenURI::TooManyRedirects is raised.\n" ++
  "    #  The default is 64.\n" ++
  "    #\n" ++
  "    # [:request_specific_fields]\n" ++
  "    #  Synopsis:\n" ++
  "    #    :request_specific_fields => \{\}\n" ++
  "    #    :request_specific_fields => lambda \{|url| ...\}\n" ++
  "    #\n" ++
  "    #  :request_specific_fields option allows specifying custom header fields that\n" ++
  "    #  are sent with the HTTP request. It can be passed as a Hash or a Proc that\n" ++
  "    #  gets evaluated on each request and returns a Hash of header fields.\n" ++
  "    #\n" ++
  "    #  If a Hash is provided, it specifies the headers only for the initial\n" ++
  "    #  request and these headers will not be sent on redirects.\n" ++
  "    #\n" ++
  "    #  If a Proc is provided, it will be executed for each request including\n" ++
  "    #  redirects, allowing dynamic header customization based on the request URL.\n" ++
  "    #  It is important that the Proc returns a Hash. And this Hash specifies the\n" ++
  "    #  headers to be sent with the request.\n" ++
  "    #\n" ++
  "    #  For Example with Hash\n" ++
  "    #    URI.open(\"http://...\",\n" ++
  "    #             request_specific_fields: \{\"Authorization\" => \"token dummy\"\}) \{|f| ... \}\n" ++
  "    #\n" ++
  "    #  For Example with Proc:\n" ++
  "    #    URI.open(\"http://...\",\n" ++
  "    #             request_specific_fields: lambda \{ |uri|\n" ++
  "    #               if uri.host == \"example.com\"\n" ++
  "    #                 \{\"Authorization\" => \"token dummy\"\}\n" ++
  "    #               else\n" ++
