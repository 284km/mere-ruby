  "    ##\n" ++
  "    # Reads the rest of the socket, inflates it, then writes it to +dest+.\n" ++
  "\n" ++
  "    def read_all dest\n" ++
  "      temp_dest = inflate_adapter(dest)\n" ++
  "\n" ++
  "      @socket.read_all temp_dest\n" ++
  "    end\n" ++
  "\n" ++
  "  end\n" ++
  "\n" ++
  "end\n" ++
  "\n";
let network_source_9 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "#--\n" ++
  "# https://www.iana.org/assignments/http-status-codes/http-status-codes.xhtml\n" ++
  "\n" ++
  "module Net\n" ++
  "\n" ++
  "  # Unknown HTTP response\n" ++
  "  class HTTPUnknownResponse < HTTPResponse\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "    EXCEPTION_TYPE = HTTPError                  #\n" ++
  "  end\n" ++
  "\n" ++
  "  # Parent class for informational (1xx) HTTP response classes.\n" ++
  "  #\n" ++
  "  # An informational response indicates that the request was received and understood.\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#status.1xx].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#1xx_informational_response].\n" ++
  "  #\n" ++
  "  class HTTPInformation < HTTPResponse\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "    EXCEPTION_TYPE = HTTPError                  #\n" ++
  "  end\n" ++
  "\n" ++
  "  # Parent class for success (2xx) HTTP response classes.\n" ++
  "  #\n" ++
  "  # A success response indicates the action requested by the client\n" ++
  "  # was received, understood, and accepted.\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#status.2xx].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#2xx_success].\n" ++
  "  #\n" ++
  "  class HTTPSuccess < HTTPResponse\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "    EXCEPTION_TYPE = HTTPError                  #\n" ++
  "  end\n" ++
  "\n" ++
  "  # Parent class for redirection (3xx) HTTP response classes.\n" ++
  "  #\n" ++
  "  # A redirection response indicates the client must take additional action\n" ++
  "  # to complete the request.\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#status.3xx].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#3xx_redirection].\n" ++
  "  #\n" ++
  "  class HTTPRedirection < HTTPResponse\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "    EXCEPTION_TYPE = HTTPRetriableError         #\n" ++
  "  end\n" ++
  "\n" ++
  "  # Parent class for client error (4xx) HTTP response classes.\n" ++
  "  #\n" ++
  "  # A client error response indicates that the client may have caused an error.\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#status.4xx].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#4xx_client_errors].\n" ++
  "  #\n" ++
  "  class HTTPClientError < HTTPResponse\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "    EXCEPTION_TYPE = HTTPClientException        #\n" ++
  "  end\n" ++
  "\n" ++
  "  # Parent class for server error (5xx) HTTP response classes.\n" ++
  "  #\n" ++
  "  # A server error response indicates that the server failed to fulfill a request.\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#status.5xx].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#5xx_server_errors].\n" ++
  "  #\n" ++
  "  class HTTPServerError < HTTPResponse\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "    EXCEPTION_TYPE = HTTPFatalError             #\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for +Continue+ responses (status code 100).\n" ++
  "  #\n" ++
  "  # A +Continue+ response indicates that the server has received the request headers.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/100].\n" ++
