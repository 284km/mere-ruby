  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#100].\n" ++
  "  #\n" ++
  "  class HTTPContinue < HTTPInformation\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Switching Protocol</tt> responses (status code 101).\n" ++
  "  #\n" ++
  "  # The <tt>Switching Protocol<tt> response indicates that the server has received\n" ++
  "  # a request to switch protocols, and has agreed to do so.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/101].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-101-switching-protocols].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#101].\n" ++
  "  #\n" ++
  "  class HTTPSwitchProtocol < HTTPInformation\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for +Processing+ responses (status code 102).\n" ++
  "  #\n" ++
