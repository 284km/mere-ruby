  "  ##\n" ++
  "  # Address Regexp to use for matching IP addresses.\n" ++
  "\n" ++
  "  AddressRegex = /(?:#\{IPv4::Regex\})|(?:#\{IPv6::Regex\})/\n" ++
  "\n" ++
  "end\n";
