  "\n" ++
  "# HTTP/1.1 methods --- RFC2616\n" ++
  "\n" ++
  "# \\Class for representing\n" ++
  "# \{HTTP method GET\}[https://en.wikipedia.org/w/index.php?title=Hypertext_Transfer_Protocol#GET_method]:\n" ++
  "#\n" ++
  "#   require 'net/http'\n" ++
  "#   uri = URI('http://example.com')\n" ++
  "#   hostname = uri.hostname # => \"example.com\"\n" ++
  "#   req = Net::HTTP::Get.new(uri) # => #<Net::HTTP::Get GET>\n" ++
  "#   res = Net::HTTP.start(hostname) do |http|\n" ++
  "#     http.request(req)\n" ++
  "#   end\n" ++
  "#\n" ++
  "# See \{Request Headers\}[rdoc-ref:Net::HTTPRequest@Request+Headers].\n" ++
  "#\n" ++
  "# Properties:\n" ++
  "#\n" ++
  "# - Request body: optional.\n" ++
  "# - Response body: yes.\n" ++
  "# - \{Safe\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol#Safe_methods]: yes.\n" ++
  "# - \{Idempotent\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol#Idempotent_methods]: yes.\n" ++
  "# - \{Cacheable\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol#Cacheable_methods]: yes.\n" ++
  "#\n" ++
  "# Related:\n" ++
  "#\n" ++
  "# - Net::HTTP.get: sends +GET+ request, returns response body.\n" ++
