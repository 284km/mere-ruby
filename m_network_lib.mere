  "    # See also URI::Generic.host=.\n" ++
  "    #\n" ++
  "    def set_host(v)\n" ++
  "      v = \"\" if v.nil? || v == \"localhost\"\n" ++
  "      @host = v\n" ++
  "    end\n" ++
  "\n" ++
  "    # do nothing\n" ++
  "    def set_port(v)\n" ++
  "    end\n" ++
  "\n" ++
  "    # raise InvalidURIError\n" ++
  "    def check_userinfo(user)\n" ++
  "      raise URI::InvalidURIError, \"cannot set userinfo for file URI\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # raise InvalidURIError\n" ++
  "    def check_user(user)\n" ++
  "      raise URI::InvalidURIError, \"cannot set user for file URI\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # raise InvalidURIError\n" ++
  "    def check_password(user)\n" ++
  "      raise URI::InvalidURIError, \"cannot set password for file URI\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # do nothing\n" ++
  "    def set_userinfo(v)\n" ++
  "    end\n" ++
  "\n" ++
  "    # do nothing\n" ++
  "    def set_user(v)\n" ++
  "    end\n" ++
  "\n" ++
  "    # do nothing\n" ++
  "    def set_password(v)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  register_scheme 'FILE', File\n" ++
  "end\n";
