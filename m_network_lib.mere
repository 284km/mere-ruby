  "  class WS < Generic\n" ++
  "    # A Default port of 80 for URI::WS.\n" ++
  "    DEFAULT_PORT = 80\n" ++
  "\n" ++
  "    # An Array of the available components for URI::WS.\n" ++
  "    COMPONENT = %i[\n" ++
  "      scheme\n" ++
  "      userinfo host port\n" ++
  "      path\n" ++
  "      query\n" ++
  "    ].freeze\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Creates a new URI::WS object from components, with syntax checking.\n" ++
  "    #\n" ++
  "    # The components accepted are userinfo, host, port, path, and query.\n" ++
  "    #\n" ++
  "    # The components should be provided either as an Array, or as a Hash\n" ++
  "    # with keys formed by preceding the component names with a colon.\n" ++
  "    #\n" ++
  "    # If an Array is used, the components must be passed in the\n" ++
  "    # order <code>[userinfo, host, port, path, query]</code>.\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #     uri = URI::WS.build(host: 'www.example.com', path: '/foo/bar')\n" ++
  "    #\n" ++
  "    #     uri = URI::WS.build([nil, \"www.example.com\", nil, \"/path\", \"query\"])\n" ++
  "    #\n" ++
  "    # Currently, if passed userinfo components this method generates\n" ++
  "    # invalid WS URIs as per RFC 1738.\n" ++
  "    #\n" ++
  "    def self.build(args)\n" ++
  "      tmp = Util.make_components_hash(self, args)\n" ++
  "      super(tmp)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Returns the full path for a WS URI, as required by Net::HTTP::Get.\n" ++
  "    #\n" ++
  "    # If the URI contains a query, the full path is URI#path + '?' + URI#query.\n" ++
  "    # Otherwise, the path is simply URI#path.\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #     uri = URI::WS.build(path: '/foo/bar', query: 'test=true')\n" ++
  "    #     uri.request_uri #  => \"/foo/bar?test=true\"\n" ++
  "    #\n" ++
  "    def request_uri\n" ++
  "      return unless @path\n" ++
