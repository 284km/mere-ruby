  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-504-gateway-timeout].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#504].\n" ++
  "  #\n" ++
  "  class HTTPGatewayTimeout < HTTPServerError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
