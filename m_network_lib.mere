  "      break if len == 0\n" ++
  "      begin\n" ++
  "        chunk_data_io.read len, dest\n" ++
  "      ensure\n" ++
  "        total += len\n" ++
  "        @socket.read 2   # \\r\\n\n" ++
  "      end\n" ++
  "    end\n" ++
  "    until @socket.readline.empty?\n" ++
