  "  # References:\n" ++
  "  #\n" ++
  "  # - \{Mozilla\}[https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/409].\n" ++
  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-409-conflict].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#409].\n" ++
  "  #\n" ++
  "  class HTTPConflict < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Gone</tt> responses (status code 410).\n" ++
  "  #\n" ++
  "  # The resource requested was previously in use but is no longer available\n" ++
  "  # and will not be available again.\n" ++
  "  #\n" ++
