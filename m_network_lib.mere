  "    # Creates a new URI::LDAP object from components, with syntax checking.\n" ++
  "    #\n" ++
  "    # The components accepted are host, port, dn, attributes,\n" ++
  "    # scope, filter, and extensions.\n" ++
  "    #\n" ++
  "    # The components should be provided either as an Array, or as a Hash\n" ++
  "    # with keys formed by preceding the component names with a colon.\n" ++
  "    #\n" ++
  "    # If an Array is used, the components must be passed in the\n" ++
  "    # order <code>[host, port, dn, attributes, scope, filter, extensions]</code>.\n" ++
