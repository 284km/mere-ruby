  "end\n" ++
  "\n" ++
  "# \\Class for representing\n" ++
  "# \{WebDAV method MOVE\}[http://www.webdav.org/specs/rfc4918.html#METHOD_MOVE]:\n" ++
  "#\n" ++
  "#   require 'net/http'\n" ++
  "#   uri = URI('http://example.com')\n" ++
  "#   hostname = uri.hostname # => \"example.com\"\n" ++
  "#   req = Net::HTTP::Move.new(uri) # => #<Net::HTTP::Move MOVE>\n" ++
  "#   res = Net::HTTP.start(hostname) do |http|\n" ++
  "#     http.request(req)\n" ++
  "#   end\n" ++
  "#\n" ++
  "# See \{Request Headers\}[rdoc-ref:Net::HTTPRequest@Request+Headers].\n" ++
  "#\n" ++
  "# Related:\n" ++
  "#\n" ++
  "# - Net::HTTP#move: sends +MOVE+ request, returns response object.\n" ++
  "#\n" ++
  "class Net::HTTP::Move < Net::HTTPRequest\n" ++
  "  # :stopdoc:\n" ++
  "  METHOD = 'MOVE'\n" ++
  "  REQUEST_HAS_BODY = false\n" ++
  "  RESPONSE_HAS_BODY = true\n" ++
  "end\n" ++
  "\n" ++
  "# \\Class for representing\n" ++
  "# \{WebDAV method LOCK\}[http://www.webdav.org/specs/rfc4918.html#METHOD_LOCK]:\n" ++
  "#\n" ++
  "#   require 'net/http'\n" ++
  "#   uri = URI('http://example.com')\n" ++
  "#   hostname = uri.hostname # => \"example.com\"\n" ++
  "#   req = Net::HTTP::Lock.new(uri) # => #<Net::HTTP::Lock LOCK>\n" ++
  "#   res = Net::HTTP.start(hostname) do |http|\n" ++
  "#     http.request(req)\n" ++
  "#   end\n" ++
  "#\n" ++
  "# See \{Request Headers\}[rdoc-ref:Net::HTTPRequest@Request+Headers].\n" ++
  "#\n" ++
  "# Related:\n" ++
  "#\n" ++
  "# - Net::HTTP#lock: sends +LOCK+ request, returns response object.\n" ++
  "#\n" ++
  "class Net::HTTP::Lock < Net::HTTPRequest\n" ++
  "  # :stopdoc:\n" ++
  "  METHOD = 'LOCK'\n" ++
  "  REQUEST_HAS_BODY = true\n" ++
  "  RESPONSE_HAS_BODY = true\n" ++
  "end\n" ++
  "\n" ++
  "# \\Class for representing\n" ++
  "# \{WebDAV method UNLOCK\}[http://www.webdav.org/specs/rfc4918.html#METHOD_UNLOCK]:\n" ++
  "#\n" ++
  "#   require 'net/http'\n" ++
  "#   uri = URI('http://example.com')\n" ++
  "#   hostname = uri.hostname # => \"example.com\"\n" ++
  "#   req = Net::HTTP::Unlock.new(uri) # => #<Net::HTTP::Unlock UNLOCK>\n" ++
  "#   res = Net::HTTP.start(hostname) do |http|\n" ++
  "#     http.request(req)\n" ++
  "#   end\n" ++
  "#\n" ++
  "# See \{Request Headers\}[rdoc-ref:Net::HTTPRequest@Request+Headers].\n" ++
  "#\n" ++
  "# Related:\n" ++
  "#\n" ++
  "# - Net::HTTP#unlock: sends +UNLOCK+ request, returns response object.\n" ++
  "#\n" ++
  "class Net::HTTP::Unlock < Net::HTTPRequest\n" ++
  "  # :stopdoc:\n" ++
  "  METHOD = 'UNLOCK'\n" ++
  "  REQUEST_HAS_BODY = true\n" ++
  "  RESPONSE_HAS_BODY = true\n" ++
  "end\n";
let network_source_8 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "\n" ++
  "# This class is the base class for \\Net::HTTP response classes.\n" ++
  "#\n" ++
  "# == About the Examples\n" ++
  "#\n" ++
  "# :include: doc/net-http/examples.rdoc\n" ++
  "#\n" ++
  "# == Returned Responses\n" ++
  "#\n" ++
  "# \\Method Net::HTTP.get_response returns\n" ++
  "# an instance of one of the subclasses of \\Net::HTTPResponse:\n" ++
  "#\n" ++
  "#   Net::HTTP.get_response(uri)\n" ++
  "#   # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "#   Net::HTTP.get_response(hostname, '/nosuch')\n" ++
  "#   # => #<Net::HTTPNotFound 404 Not Found readbody=true>\n" ++
  "#\n" ++
  "# As does method Net::HTTP#request:\n" ++
  "#\n" ++
  "#   req = Net::HTTP::Get.new(uri)\n" ++
  "#   Net::HTTP.start(hostname) do |http|\n" ++
  "#     http.request(req)\n" ++
  "#   end # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "#\n" ++
  "# \\Class \\Net::HTTPResponse includes module Net::HTTPHeader,\n" ++
  "# which provides access to response header values via (among others):\n" ++
  "#\n" ++
  "# - \\Hash-like method <tt>[]</tt>.\n" ++
  "# - Specific reader methods, such as +content_type+.\n" ++
  "#\n" ++
  "# Examples:\n" ++
  "#\n" ++
  "#   res = Net::HTTP.get_response(uri) # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "#   res['Content-Type']               # => \"text/html; charset=UTF-8\"\n" ++
  "#   res.content_type                  # => \"text/html\"\n" ++
  "#\n" ++
  "# == Response Subclasses\n" ++
  "#\n" ++
  "# \\Class \\Net::HTTPResponse has a subclass for each\n" ++
  "# \{HTTP status code\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes].\n" ++
  "# You can look up the response class for a given code:\n" ++
  "#\n" ++
  "#   Net::HTTPResponse::CODE_TO_OBJ['200'] # => Net::HTTPOK\n" ++
  "#   Net::HTTPResponse::CODE_TO_OBJ['400'] # => Net::HTTPBadRequest\n" ++
  "#   Net::HTTPResponse::CODE_TO_OBJ['404'] # => Net::HTTPNotFound\n" ++
  "#\n" ++
  "# And you can retrieve the status code for a response object:\n" ++
  "#\n" ++
  "#   Net::HTTP.get_response(uri).code                 # => \"200\"\n" ++
  "#   Net::HTTP.get_response(hostname, '/nosuch').code # => \"404\"\n" ++
  "#\n" ++
  "# The response subclasses (indentation shows class hierarchy):\n" ++
  "#\n" ++
  "# - Net::HTTPUnknownResponse (for unhandled \\HTTP extensions).\n" ++
  "#\n" ++
  "# - Net::HTTPInformation:\n" ++
  "#\n" ++
  "#   - Net::HTTPContinue (100)\n" ++
  "#   - Net::HTTPSwitchProtocol (101)\n" ++
  "#   - Net::HTTPProcessing (102)\n" ++
  "#   - Net::HTTPEarlyHints (103)\n" ++
  "#\n" ++
  "# - Net::HTTPSuccess:\n" ++
  "#\n" ++
  "#   - Net::HTTPOK (200)\n" ++
  "#   - Net::HTTPCreated (201)\n" ++
  "#   - Net::HTTPAccepted (202)\n" ++
  "#   - Net::HTTPNonAuthoritativeInformation (203)\n" ++
  "#   - Net::HTTPNoContent (204)\n" ++
  "#   - Net::HTTPResetContent (205)\n" ++
  "#   - Net::HTTPPartialContent (206)\n" ++
  "#   - Net::HTTPMultiStatus (207)\n" ++
  "#   - Net::HTTPAlreadyReported (208)\n" ++
  "#   - Net::HTTPIMUsed (226)\n" ++
  "#\n" ++
  "# - Net::HTTPRedirection:\n" ++
  "#\n" ++
  "#   - Net::HTTPMultipleChoices (300)\n" ++
  "#   - Net::HTTPMovedPermanently (301)\n" ++
  "#   - Net::HTTPFound (302)\n" ++
  "#   - Net::HTTPSeeOther (303)\n" ++
  "#   - Net::HTTPNotModified (304)\n" ++
  "#   - Net::HTTPUseProxy (305)\n" ++
  "#   - Net::HTTPTemporaryRedirect (307)\n" ++
  "#   - Net::HTTPPermanentRedirect (308)\n" ++
  "#\n" ++
  "# - Net::HTTPClientError:\n" ++
  "#\n" ++
  "#   - Net::HTTPBadRequest (400)\n" ++
  "#   - Net::HTTPUnauthorized (401)\n" ++
  "#   - Net::HTTPPaymentRequired (402)\n" ++
  "#   - Net::HTTPForbidden (403)\n" ++
  "#   - Net::HTTPNotFound (404)\n" ++
  "#   - Net::HTTPMethodNotAllowed (405)\n" ++
  "#   - Net::HTTPNotAcceptable (406)\n" ++
  "#   - Net::HTTPProxyAuthenticationRequired (407)\n" ++
  "#   - Net::HTTPRequestTimeOut (408)\n" ++
  "#   - Net::HTTPConflict (409)\n" ++
  "#   - Net::HTTPGone (410)\n" ++
  "#   - Net::HTTPLengthRequired (411)\n" ++
  "#   - Net::HTTPPreconditionFailed (412)\n" ++
  "#   - Net::HTTPRequestEntityTooLarge (413)\n" ++
  "#   - Net::HTTPRequestURITooLong (414)\n" ++
  "#   - Net::HTTPUnsupportedMediaType (415)\n" ++
  "#   - Net::HTTPRequestedRangeNotSatisfiable (416)\n" ++
  "#   - Net::HTTPExpectationFailed (417)\n" ++
  "#   - Net::HTTPMisdirectedRequest (421)\n" ++
  "#   - Net::HTTPUnprocessableEntity (422)\n" ++
  "#   - Net::HTTPLocked (423)\n" ++
  "#   - Net::HTTPFailedDependency (424)\n" ++
  "#   - Net::HTTPUpgradeRequired (426)\n" ++
  "#   - Net::HTTPPreconditionRequired (428)\n" ++
  "#   - Net::HTTPTooManyRequests (429)\n" ++
  "#   - Net::HTTPRequestHeaderFieldsTooLarge (431)\n" ++
  "#   - Net::HTTPUnavailableForLegalReasons (451)\n" ++
  "#\n" ++
  "# - Net::HTTPServerError:\n" ++
  "#\n" ++
  "#   - Net::HTTPInternalServerError (500)\n" ++
  "#   - Net::HTTPNotImplemented (501)\n" ++
  "#   - Net::HTTPBadGateway (502)\n" ++
  "#   - Net::HTTPServiceUnavailable (503)\n" ++
  "#   - Net::HTTPGatewayTimeOut (504)\n" ++
  "#   - Net::HTTPVersionNotSupported (505)\n" ++
  "#   - Net::HTTPVariantAlsoNegotiates (506)\n" ++
  "#   - Net::HTTPInsufficientStorage (507)\n" ++
  "#   - Net::HTTPLoopDetected (508)\n" ++
  "#   - Net::HTTPNotExtended (510)\n" ++
  "#   - Net::HTTPNetworkAuthenticationRequired (511)\n" ++
  "#\n" ++
  "# There is also the Net::HTTPBadResponse exception which is raised when\n" ++
  "# there is a protocol error.\n" ++
  "#\n" ++
  "class Net::HTTPResponse\n" ++
  "  class << self\n" ++
  "    # true if the response has a body.\n" ++
  "    def body_permitted?\n" ++
  "      self::HAS_BODY\n" ++
  "    end\n" ++
  "\n" ++
  "    def exception_type   # :nodoc: internal use only\n" ++
  "      self::EXCEPTION_TYPE\n" ++
  "    end\n" ++
  "\n" ++
  "    def read_new(sock)   #:nodoc: internal use only\n" ++
  "      httpv, code, msg = read_status_line(sock)\n" ++
  "      res = response_class(code).new(httpv, code, msg)\n" ++
  "      each_response_header(sock) do |k,v|\n" ++
  "        res.add_field k, v\n" ++
  "      end\n" ++
  "      res\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "    # :stopdoc:\n" ++
  "\n" ++
  "    def read_status_line(sock)\n" ++
  "      str = sock.readline\n" ++
  "      m = /\\AHTTP(?:\\/(\\d+\\.\\d+))?\\s+(\\d\\d\\d)(?:\\s+(.*))?\\z/in.match(str) or\n" ++
  "        raise Net::HTTPBadResponse, \"wrong status line: #\{str.dump\}\"\n" ++
  "      m.captures\n" ++
  "    end\n" ++
  "\n" ++
  "    def response_class(code)\n" ++
  "      CODE_TO_OBJ[code] or\n" ++
  "      CODE_CLASS_TO_OBJ[code[0,1]] or\n" ++
  "      Net::HTTPUnknownResponse\n" ++
  "    end\n" ++
  "\n" ++
  "    def each_response_header(sock)\n" ++
  "      key = value = nil\n" ++
  "      while true\n" ++
  "        line = sock.readuntil(\"\\n\", true).sub(/\\s+\\z/, '')\n" ++
  "        break if line.empty?\n" ++
  "        if line[0] == ?\\s or line[0] == ?\\t and value\n" ++
  "          value << ' ' unless value.empty?\n" ++
  "          value << line.strip\n" ++
  "        else\n" ++
  "          yield key, value if key\n" ++
  "          key, value = line.strip.split(/\\s*:\\s*/, 2)\n" ++
  "          raise Net::HTTPBadResponse, 'wrong header line format' if value.nil?\n" ++
  "        end\n" ++
  "      end\n" ++
  "      yield key, value if key\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # next is to fix bug in RDoc, where the private inside class << self\n" ++
  "  # spills out.\n" ++
  "  public\n" ++
  "\n" ++
  "  include Net::HTTPHeader\n" ++
  "\n" ++
  "  def initialize(httpv, code, msg)   #:nodoc: internal use only\n" ++
  "    @http_version = httpv\n" ++
  "    @code         = code\n" ++
  "    @message      = msg\n" ++
  "    initialize_http_header nil\n" ++
  "    @body = nil\n" ++
  "    @read = false\n" ++
  "    @uri  = nil\n" ++
  "    @decode_content = false\n" ++
  "    @body_encoding = false\n" ++
  "    @ignore_eof = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # The HTTP version supported by the server.\n" ++
  "  attr_reader :http_version\n" ++
  "\n" ++
  "  # The HTTP result code string. For example, '302'.  You can also\n" ++
  "  # determine the response type by examining which response subclass\n" ++
  "  # the response object is an instance of.\n" ++
  "  attr_reader :code\n" ++
  "\n" ++
  "  # The HTTP result message sent by the server. For example, 'Not Found'.\n" ++
  "  attr_reader :message\n" ++
  "  alias msg message   # :nodoc: obsolete\n" ++
  "\n" ++
  "  # The URI used to fetch this response.  The response URI is only available\n" ++
  "  # if a URI was used to create the request.\n" ++
  "  attr_reader :uri\n" ++
  "\n" ++
  "  # Set to true automatically when the request did not contain an\n" ++
  "  # Accept-Encoding header from the user.\n" ++
  "  attr_accessor :decode_content\n" ++
  "\n" ++
  "  # Returns the value set by body_encoding=, or +false+ if none;\n" ++
  "  # see #body_encoding=.\n" ++
  "  attr_reader :body_encoding\n" ++
  "\n" ++
  "  # Sets the encoding that should be used when reading the body:\n" ++
  "  #\n" ++
  "  # - If the given value is an Encoding object, that encoding will be used.\n" ++
  "  # - Otherwise if the value is a string, the value of\n" ++
  "  #   \{Encoding#find(value)\}[rdoc-ref:Encoding.find]\n" ++
  "  #   will be used.\n" ++
  "  # - Otherwise an encoding will be deduced from the body itself.\n" ++
  "  #\n" ++
  "  # Examples:\n" ++
  "  #\n" ++
  "  #   http = Net::HTTP.new(hostname)\n" ++
  "  #   req = Net::HTTP::Get.new('/')\n" ++
  "  #\n" ++
  "  #   http.request(req) do |res|\n" ++
  "  #     p res.body.encoding # => #<Encoding:ASCII-8BIT>\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  #   http.request(req) do |res|\n" ++
  "  #     res.body_encoding = \"UTF-8\"\n" ++
  "  #     p res.body.encoding # => #<Encoding:UTF-8>\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  def body_encoding=(value)\n" ++
  "    value = Encoding.find(value) if value.is_a?(String)\n" ++
  "    @body_encoding = value\n" ++
  "  end\n" ++
  "\n" ++
  "  # Whether to ignore EOF when reading bodies with a specified Content-Length\n" ++
  "  # header.\n" ++
  "  attr_accessor :ignore_eof\n" ++
  "\n" ++
  "  def inspect   # :nodoc:\n" ++
  "    \"#<#\{self.class\} #\{@code\} #\{@message\} readbody=#\{@read\}>\"\n" ++
  "  end\n" ++
  "\n" ++
  "  #\n" ++
  "  # response <-> exception relationship\n" ++
  "  #\n" ++
  "\n" ++
  "  def code_type   #:nodoc:\n" ++
  "    self.class\n" ++
  "  end\n" ++
  "\n" ++
  "  def error!   #:nodoc:\n" ++
  "    message = @code\n" ++
  "    message = \"#\{message\} #\{@message.dump\}\" if @message\n" ++
  "    raise error_type().new(message, self)\n" ++
  "  end\n" ++
  "\n" ++
  "  def error_type   #:nodoc:\n" ++
  "    self.class::EXCEPTION_TYPE\n" ++
  "  end\n" ++
  "\n" ++
  "  # Raises an HTTP error if the response is not 2xx (success).\n" ++
  "  def value\n" ++
  "    error! unless self.kind_of?(Net::HTTPSuccess)\n" ++
  "  end\n" ++
  "\n" ++
  "  def uri= uri # :nodoc:\n" ++
  "    @uri = uri.dup if uri\n" ++
  "  end\n" ++
  "\n" ++
  "  #\n" ++
  "  # header (for backward compatibility only; DO NOT USE)\n" ++
  "  #\n" ++
  "\n" ++
  "  def response   #:nodoc:\n" ++
  "    warn \"Net::HTTPResponse#response is obsolete\", uplevel: 1 if $VERBOSE\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def header   #:nodoc:\n" ++
  "    warn \"Net::HTTPResponse#header is obsolete\", uplevel: 1 if $VERBOSE\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  def read_header   #:nodoc:\n" ++
  "    warn \"Net::HTTPResponse#read_header is obsolete\", uplevel: 1 if $VERBOSE\n" ++
  "    self\n" ++
  "  end\n" ++
  "\n" ++
  "  #\n" ++
  "  # body\n" ++
  "  #\n" ++
  "\n" ++
  "  def reading_body(sock, reqmethodallowbody)  #:nodoc: internal use only\n" ++
  "    @socket = sock\n" ++
  "    @body_exist = reqmethodallowbody && self.class.body_permitted?\n" ++
  "    begin\n" ++
  "      yield\n" ++
  "      self.body   # ensure to read body\n" ++
  "    ensure\n" ++
  "      @socket = nil\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Gets the entity body returned by the remote HTTP server.\n" ++
  "  #\n" ++
  "  # If a block is given, the body is passed to the block, and\n" ++
  "  # the body is provided in fragments, as it is read in from the socket.\n" ++
  "  #\n" ++
  "  # If +dest+ argument is given, response is read into that variable,\n" ++
  "  # with <code>dest#<<</code> method (it could be String or IO, or any\n" ++
  "  # other object responding to <code><<</code>).\n" ++
  "  #\n" ++
  "  # Calling this method a second or subsequent time for the same\n" ++
  "  # HTTPResponse object will return the value already read.\n" ++
  "  #\n" ++
  "  #   http.request_get('/index.html') \{|res|\n" ++
  "  #     puts res.read_body\n" ++
  "  #   \}\n" ++
  "  #\n" ++
  "  #   http.request_get('/index.html') \{|res|\n" ++
  "  #     p res.read_body.object_id   # 538149362\n" ++
  "  #     p res.read_body.object_id   # 538149362\n" ++
  "  #   \}\n" ++
  "  #\n" ++
  "  #   # using iterator\n" ++
  "  #   http.request_get('/index.html') \{|res|\n" ++
  "  #     res.read_body do |segment|\n" ++
  "  #       print segment\n" ++
  "  #     end\n" ++
  "  #   \}\n" ++
  "  #\n" ++
  "  def read_body(dest = nil, &block)\n" ++
  "    if @read\n" ++
  "      raise IOError, \"#\{self.class\}\\#read_body called twice\" if dest or block\n" ++
  "      return @body\n" ++
  "    end\n" ++
  "    to = procdest(dest, block)\n" ++
  "    stream_check\n" ++
  "    if @body_exist\n" ++
  "      read_body_0 to\n" ++
  "      @body = to\n" ++
  "    else\n" ++
  "      @body = nil\n" ++
  "    end\n" ++
  "    @read = true\n" ++
  "    return if @body.nil?\n" ++
  "\n" ++
  "    case enc = @body_encoding\n" ++
  "    when Encoding, false, nil\n" ++
  "      # Encoding: force given encoding\n" ++
  "      # false/nil: do not force encoding\n" ++
  "    else\n" ++
  "      # other value: detect encoding from body\n" ++
  "      enc = detect_encoding(@body)\n" ++
  "    end\n" ++
  "\n" ++
  "    @body.force_encoding(enc) if enc\n" ++
  "\n" ++
  "    @body\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the string response body;\n" ++
  "  # note that repeated calls for the unmodified body return a cached string:\n" ++
  "  #\n" ++
  "  #   path = '/todos/1'\n" ++
  "  #   Net::HTTP.start(hostname) do |http|\n" ++
  "  #     res = http.get(path)\n" ++
  "  #     p res.body\n" ++
  "  #     p http.head(path).body # No body.\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Output:\n" ++
  "  #\n" ++
  "  #   \"\{\\n  \\\"userId\\\": 1,\\n  \\\"id\\\": 1,\\n  \\\"title\\\": \\\"delectus aut autem\\\",\\n  \\\"completed\\\": false\\n\}\"\n" ++
  "  #   nil\n" ++
  "  #\n" ++
  "  def body\n" ++
  "    read_body()\n" ++
  "  end\n" ++
  "\n" ++
  "  # Sets the body of the response to the given value.\n" ++
  "  def body=(value)\n" ++
  "    @body = value\n" ++
  "  end\n" ++
  "\n" ++
  "  alias entity body   #:nodoc: obsolete\n" ++
  "\n" ++
  "  private\n" ++
  "\n" ++
  "  # :nodoc:\n" ++
  "  def detect_encoding(str, encoding=nil)\n" ++
  "    if encoding\n" ++
  "    elsif encoding = type_params['charset']\n" ++
  "    elsif encoding = check_bom(str)\n" ++
  "    else\n" ++
  "      encoding = case content_type&.downcase\n" ++
  "      when %r\{text/x(?:ht)?ml|application/(?:[^+]+\\+)?xml\}\n" ++
  "        /\\A<xml[ \\t\\r\\n]+\n" ++
  "          version[ \\t\\r\\n]*=[ \\t\\r\\n]*(?:\"[0-9.]+\"|'[0-9.]*')[ \\t\\r\\n]+\n" ++
  "          encoding[ \\t\\r\\n]*=[ \\t\\r\\n]*\n" ++
  "          (?:\"([A-Za-z][\\-A-Za-z0-9._]*)\"|'([A-Za-z][\\-A-Za-z0-9._]*)')/x =~ str\n" ++
  "        encoding = $1 || $2 || Encoding::UTF_8\n" ++
  "      when %r\{text/html.*\}\n" ++
  "        sniff_encoding(str)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    return encoding\n" ++
  "  end\n" ++
  "\n" ++
  "  # :nodoc:\n" ++
  "  def sniff_encoding(str, encoding=nil)\n" ++
  "    # the encoding sniffing algorithm\n" ++
  "    # http://www.w3.org/TR/html5/parsing.html#determining-the-character-encoding\n" ++
  "    if enc = scanning_meta(str)\n" ++
  "      enc\n" ++
  "    # 6. last visited page or something\n" ++
  "    # 7. frequency\n" ++
  "    elsif str.ascii_only?\n" ++
  "      Encoding::US_ASCII\n" ++
  "    elsif str.dup.force_encoding(Encoding::UTF_8).valid_encoding?\n" ++
  "      Encoding::UTF_8\n" ++
  "    end\n" ++
  "    # 8. implementation-defined or user-specified\n" ++
  "  end\n" ++
  "\n" ++
  "  # :nodoc:\n" ++
  "  def check_bom(str)\n" ++
  "    case str.byteslice(0, 2)\n" ++
  "    when \"\\xFE\\xFF\"\n" ++
  "      return Encoding::UTF_16BE\n" ++
  "    when \"\\xFF\\xFE\"\n" ++
  "      return Encoding::UTF_16LE\n" ++
  "    end\n" ++
  "    if \"\\xEF\\xBB\\xBF\" == str.byteslice(0, 3)\n" ++
