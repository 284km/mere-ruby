  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # 418 I'm a teapot - RFC 2324; a joke RFC\n" ++
  "  # See https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#418.\n" ++
  "\n" ++
  "  # 420 Enhance Your Calm - Twitter\n" ++
  "\n" ++
  "  # Response class for <tt>Misdirected Request</tt> responses (status code 421).\n" ++
  "  #\n" ++
  "  # The request was directed at a server that is not able to produce a response.\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/included_getters.rdoc\n" ++
  "  #\n" ++
  "  # References:\n" ++
  "  #\n" ++
