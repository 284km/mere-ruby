  "# frozen_string_literal: false\n" ++
  "# = uri/ldap.rb\n" ++
  "#\n" ++
  "# License:: You can redistribute it and/or modify it under the same term as Ruby.\n" ++
  "#\n" ++
  "# See URI for general documentation\n" ++
  "#\n" ++
  "\n" ++
  "require_relative 'ldap'\n" ++
  "\n" ++
  "module URI\n" ++
  "\n" ++
  "  # The default port for LDAPS URIs is 636, and the scheme is 'ldaps:' rather\n" ++
  "  # than 'ldap:'. Other than that, LDAPS URIs are identical to LDAP URIs;\n" ++
  "  # see URI::LDAP.\n" ++
  "  class LDAPS < LDAP\n" ++
  "    # A Default port of 636 for URI::LDAPS\n" ++
  "    DEFAULT_PORT = 636\n" ++
  "  end\n" ++
  "\n" ++
  "  register_scheme 'LDAPS', LDAPS\n" ++
  "end\n";
