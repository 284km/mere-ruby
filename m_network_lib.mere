  "\n" ++
  "    def initialize(thread, timeout, exception_class, message)\n" ++
  "      @thread = thread\n" ++
  "      @deadline = GET_TIME.call(Process::CLOCK_MONOTONIC) + timeout\n" ++
  "      @exception_class = exception_class\n" ++
  "      @message = message\n" ++
  "\n" ++
  "      @mutex = Mutex.new\n" ++
  "      @done = false # protected by @mutex\n" ++
  "    end\n" ++
  "\n" ++
  "    # Only called by the timeout thread, so does not need Sync.synchronize\n" ++
  "    def done?\n" ++
  "      @mutex.synchronize do\n" ++
  "        @done\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def expired?(now)\n" ++
  "      now >= @deadline\n" ++
  "    end\n" ++
  "\n" ++
  "    # Only called by the timeout thread, so does not need Sync.synchronize\n" ++
  "    def interrupt\n" ++
  "      @mutex.synchronize do\n" ++
  "        unless @done\n" ++
  "          @thread.raise @exception_class, @message\n" ++
  "          @done = true\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def finished\n" ++
  "      Sync.synchronize @mutex do\n" ++
  "        @done = true\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "  private_constant :Request\n" ++
  "\n" ++
  "  module Sync\n" ++
  "    # Calls mutex.synchronize(&block) but if that fails on CRuby due to being in a trap handler,\n" ++
  "    # run mutex.synchronize(&block) in a separate Thread instead.\n" ++
  "    def self.synchronize(mutex, &block)\n" ++
  "      begin\n" ++
  "        mutex.synchronize(&block)\n" ++
  "      rescue ThreadError => e\n" ++
  "        raise e unless e.message == \"can't be called from trap context\"\n" ++
  "        # Workaround CRuby issue https://bugs.ruby-lang.org/issues/19473\n" ++
  "        # which raises on Mutex#synchronize in trap handler.\n" ++
  "        # It's expensive to create a Thread just for this,\n" ++
  "        # but better than failing.\n" ++
  "        Thread.new \{\n" ++
  "          mutex.synchronize(&block)\n" ++
  "        \}.join\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "  private_constant :Sync\n" ++
  "\n" ++
  "  # :startdoc:\n" ++
  "\n" ++
  "  # Perform an operation in a block, raising an exception if it takes longer than\n" ++
  "  # +sec+ seconds to complete.\n" ++
  "  #\n" ++
  "  # +sec+:: Number of seconds to wait for the block to terminate. Any non-negative number\n" ++
  "  #         or nil may be used, including Floats to specify fractional seconds. A\n" ++
  "  #         value of 0 or +nil+ will execute the block without any timeout.\n" ++
  "  #         Any negative number will raise an ArgumentError.\n" ++
  "  # +klass+:: Exception Class to raise if the block fails to terminate\n" ++
  "  #           in +sec+ seconds.  Omitting will use the default, Timeout::Error\n" ++
  "  # +message+:: Error message to raise with Exception Class.\n" ++
  "  #             Omitting will use the default, \"execution expired\"\n" ++
  "  #\n" ++
  "  # Returns the result of the block *if* the block completed before\n" ++
  "  # +sec+ seconds, otherwise raises an exception, based on the value of +klass+.\n" ++
  "  #\n" ++
  "  # The exception raised to terminate the given block is the given +klass+, or\n" ++
  "  # Timeout::ExitException if +klass+ is not given. The reason for that behavior\n" ++
  "  # is that Timeout::Error inherits from RuntimeError and might be caught unexpectedly by `rescue`.\n" ++
  "  # Timeout::ExitException inherits from Exception so it will only be rescued by `rescue Exception`.\n" ++
  "  # Note that the Timeout::ExitException is translated to a Timeout::Error once it reaches the Timeout.timeout call,\n" ++
  "  # so outside that call it will be a Timeout::Error.\n" ++
  "  #\n" ++
  "  # In general, be aware that the code block may rescue the exception, and in such a case not respect the timeout.\n" ++
  "  # Also, the block can use +ensure+ to prevent the handling of the exception.\n" ++
  "  # For those reasons, this method cannot be relied on to enforce timeouts for untrusted blocks.\n" ++
  "  #\n" ++
  "  # If a scheduler is defined, it will be used to handle the timeout by invoking\n" ++
  "  # Scheduler#timeout_after.\n" ++
  "  #\n" ++
  "  # Note that this is both a method of module Timeout, so you can <tt>include\n" ++
  "  # Timeout</tt> into your classes so they have a #timeout method, as well as\n" ++
  "  # a module method, so you can call it directly as Timeout.timeout().\n" ++
  "  #\n" ++
  "  # ==== Ensuring the exception does not fire inside ensure blocks\n" ++
  "  #\n" ++
  "  # When using Timeout.timeout it can be desirable to ensure the timeout exception does not fire inside an +ensure+ block.\n" ++
  "  # The simplest and best way to do so it to put the Timeout.timeout call inside the body of the begin/ensure/end:\n" ++
  "  #\n" ++
  "  #     begin\n" ++
  "  #       Timeout.timeout(sec) \{ some_long_operation \}\n" ++
  "  #     ensure\n" ++
  "  #       cleanup # safe, cannot be interrupt by timeout\n" ++
  "  #     end\n" ++
  "  #\n" ++
  "  # If that is not feasible, e.g. if there are +ensure+ blocks inside +some_long_operation+,\n" ++
  "  # they need to not be interrupted by timeout, and it's not possible to move these ensure blocks outside,\n" ++
  "  # one can use Thread.handle_interrupt to delay the timeout exception like so:\n" ++
  "  #\n" ++
  "  #     Thread.handle_interrupt(Timeout::Error => :never) \{\n" ++
  "  #       Timeout.timeout(sec, Timeout::Error) do\n" ++
  "  #         setup # timeout cannot happen here, no matter how long it takes\n" ++
  "  #         Thread.handle_interrupt(Timeout::Error => :immediate) \{\n" ++
  "  #           some_long_operation # timeout can happen here\n" ++
  "  #         \}\n" ++
  "  #       ensure\n" ++
  "  #         cleanup # timeout cannot happen here, no matter how long it takes\n" ++
  "  #       end\n" ++
  "  #     \}\n" ++
  "  #\n" ++
  "  # An important thing to note is the need to pass an exception klass to Timeout.timeout,\n" ++
  "  # otherwise it does not work. Specifically, using +Thread.handle_interrupt(Timeout::ExitException => ...)+\n" ++
  "  # is unsupported and causes subtle errors like raising the wrong exception outside the block, do not use that.\n" ++
  "  #\n" ++
  "  # Note that Thread.handle_interrupt is somewhat dangerous because if setup or cleanup hangs\n" ++
  "  # then the current thread will hang too and the timeout will never fire.\n" ++
  "  # Also note the block might run for longer than +sec+ seconds:\n" ++
  "  # e.g. some_long_operation executes for +sec+ seconds + whatever time cleanup takes.\n" ++
  "  #\n" ++
  "  # If you want the timeout to only happen on blocking operations one can use :on_blocking\n" ++
  "  # instead of :immediate. However, that means if the block uses no blocking operations after +sec+ seconds,\n" ++
  "  # the block will not be interrupted.\n" ++
  "  def self.timeout(sec, klass = nil, message = nil, &block)   #:yield: +sec+\n" ++
  "    return yield(sec) if sec == nil or sec.zero?\n" ++
  "    raise ArgumentError, \"Timeout sec must be a non-negative number\" if 0 > sec\n" ++
  "\n" ++
  "    message ||= \"execution expired\"\n" ++
  "\n" ++
  "    if Fiber.respond_to?(:current_scheduler) && (scheduler = Fiber.current_scheduler)&.respond_to?(:timeout_after)\n" ++
  "      perform = Proc.new do |exc|\n" ++
  "        scheduler.timeout_after(sec, exc, message, &block)\n" ++
  "      end\n" ++
  "    else\n" ++
  "      state = State.instance\n" ++
  "      state.ensure_timeout_thread_created\n" ++
  "\n" ++
  "      perform = Proc.new do |exc|\n" ++
  "        request = Request.new(Thread.current, sec, exc, message)\n" ++
  "        state.add_request(request)\n" ++
  "        begin\n" ++
  "          return yield(sec)\n" ++
  "        ensure\n" ++
  "          request.finished\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    if klass\n" ++
  "      perform.call(klass)\n" ++
  "    else\n" ++
  "      Error.handle_timeout(message, &perform)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  private def timeout(*args, &block)\n" ++
  "    Timeout.timeout(*args, &block)\n" ++
  "  end\n" ++
  "end\n";
let network_source_17 = fn (u: unit) ->
  "# frozen_string_literal: false\n" ++
  "# URI is a module providing classes to handle Uniform Resource Identifiers\n" ++
  "# (RFC2396[https://www.rfc-editor.org/rfc/rfc2396]).\n" ++
  "#\n" ++
  "# == Features\n" ++
  "#\n" ++
  "# * Uniform way of handling URIs.\n" ++
  "# * Flexibility to introduce custom URI schemes.\n" ++
  "# * Flexibility to have an alternate URI::Parser (or just different patterns\n" ++
  "#   and regexp's).\n" ++
  "#\n" ++
  "# == Basic example\n" ++
  "#\n" ++
  "#   require 'uri'\n" ++
  "#\n" ++
  "#   uri = URI(\"http://foo.com/posts?id=30&limit=5#time=1305298413\")\n" ++
  "#   #=> #<URI::HTTP http://foo.com/posts?id=30&limit=5#time=1305298413>\n" ++
  "#\n" ++
  "#   uri.scheme    #=> \"http\"\n" ++
  "#   uri.host      #=> \"foo.com\"\n" ++
  "#   uri.path      #=> \"/posts\"\n" ++
  "#   uri.query     #=> \"id=30&limit=5\"\n" ++
  "#   uri.fragment  #=> \"time=1305298413\"\n" ++
  "#\n" ++
  "#   uri.to_s      #=> \"http://foo.com/posts?id=30&limit=5#time=1305298413\"\n" ++
  "#\n" ++
  "# == Adding custom URIs\n" ++
  "#\n" ++
  "#   module URI\n" ++
  "#     class RSYNC < Generic\n" ++
  "#       DEFAULT_PORT = 873\n" ++
  "#     end\n" ++
  "#     register_scheme 'RSYNC', RSYNC\n" ++
  "#   end\n" ++
  "#   #=> URI::RSYNC\n" ++
  "#\n" ++
  "#   URI.scheme_list\n" ++
  "#   #=> \{\"FILE\"=>URI::File, \"FTP\"=>URI::FTP, \"HTTP\"=>URI::HTTP,\n" ++
  "#   #    \"HTTPS\"=>URI::HTTPS, \"LDAP\"=>URI::LDAP, \"LDAPS\"=>URI::LDAPS,\n" ++
  "#   #    \"MAILTO\"=>URI::MailTo, \"RSYNC\"=>URI::RSYNC\}\n" ++
  "#\n" ++
  "#   uri = URI(\"rsync://rsync.foo.com\")\n" ++
  "#   #=> #<URI::RSYNC rsync://rsync.foo.com>\n" ++
  "#\n" ++
  "# == RFC References\n" ++
  "#\n" ++
  "# A good place to view an RFC spec is http://www.ietf.org/rfc.html.\n" ++
  "#\n" ++
  "# Here is a list of all related RFC's:\n" ++
  "# - RFC822[https://www.rfc-editor.org/rfc/rfc822]\n" ++
  "# - RFC1738[https://www.rfc-editor.org/rfc/rfc1738]\n" ++
  "# - RFC2255[https://www.rfc-editor.org/rfc/rfc2255]\n" ++
  "# - RFC2368[https://www.rfc-editor.org/rfc/rfc2368]\n" ++
  "# - RFC2373[https://www.rfc-editor.org/rfc/rfc2373]\n" ++
  "# - RFC2396[https://www.rfc-editor.org/rfc/rfc2396]\n" ++
  "# - RFC2732[https://www.rfc-editor.org/rfc/rfc2732]\n" ++
  "# - RFC3986[https://www.rfc-editor.org/rfc/rfc3986]\n" ++
  "#\n" ++
  "# == Class tree\n" ++
  "#\n" ++
  "# - URI::Generic (in uri/generic.rb)\n" ++
  "#   - URI::File - (in uri/file.rb)\n" ++
  "#   - URI::FTP - (in uri/ftp.rb)\n" ++
  "#   - URI::HTTP - (in uri/http.rb)\n" ++
  "#     - URI::HTTPS - (in uri/https.rb)\n" ++
  "#   - URI::LDAP - (in uri/ldap.rb)\n" ++
  "#     - URI::LDAPS - (in uri/ldaps.rb)\n" ++
  "#   - URI::MailTo - (in uri/mailto.rb)\n" ++
  "# - URI::Parser - (in uri/common.rb)\n" ++
  "# - URI::REGEXP - (in uri/common.rb)\n" ++
  "#   - URI::REGEXP::PATTERN - (in uri/common.rb)\n" ++
  "# - URI::Util - (in uri/common.rb)\n" ++
  "# - URI::Error - (in uri/common.rb)\n" ++
  "#   - URI::InvalidURIError - (in uri/common.rb)\n" ++
  "#   - URI::InvalidComponentError - (in uri/common.rb)\n" ++
  "#   - URI::BadURIError - (in uri/common.rb)\n" ++
  "#\n" ++
  "# == Copyright Info\n" ++
  "#\n" ++
  "# Author:: Akira Yamada <akira@ruby-lang.org>\n" ++
  "# Documentation::\n" ++
  "#   Akira Yamada <akira@ruby-lang.org>\n" ++
  "#   Dmitry V. Sabanin <sdmitry@lrn.ru>\n" ++
  "#   Vincent Batts <vbatts@hashbangbash.com>\n" ++
  "# License::\n" ++
  "#  Copyright (c) 2001 akira yamada <akira@ruby-lang.org>\n" ++
  "#  You can redistribute it and/or modify it under the same term as Ruby.\n" ++
  "#\n" ++
  "\n" ++
  "module URI\n" ++
  "end\n" ++
  "\n" ++
  "require_relative 'uri/version'\n" ++
  "require_relative 'uri/common'\n" ++
  "require_relative 'uri/generic'\n" ++
  "require_relative 'uri/file'\n" ++
  "require_relative 'uri/ftp'\n" ++
  "require_relative 'uri/http'\n" ++
  "require_relative 'uri/https'\n" ++
  "require_relative 'uri/ldap'\n" ++
  "require_relative 'uri/ldaps'\n" ++
  "require_relative 'uri/mailto'\n" ++
  "require_relative 'uri/ws'\n" ++
  "require_relative 'uri/wss'\n";
