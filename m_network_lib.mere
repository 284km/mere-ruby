  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Service Unavailable</tt> responses (status code 503).\n" ++
  "  #\n" ++
  "  # The server cannot handle the request\n" ++
