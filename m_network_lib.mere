  "  # - \{RFC 9110\}[https://www.rfc-editor.org/rfc/rfc9110.html#name-422-unprocessable-content].\n" ++
  "  # - \{Wikipedia\}[https://en.wikipedia.org/wiki/List_of_HTTP_status_codes#422].\n" ++
  "  #\n" ++
  "  class HTTPUnprocessableEntity < HTTPClientError\n" ++
  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Locked (WebDAV)</tt> responses (status code 423).\n" ++
  "  #\n" ++
  "  # The requested resource is locked.\n" ++
  "  #\n" ++
