  "    \"ks_c_5601-1989\"=>\"euc-kr\",\n" ++
  "    \"ksc5601\"=>\"euc-kr\",\n" ++
  "    \"ksc_5601\"=>\"euc-kr\",\n" ++
  "    \"windows-949\"=>\"euc-kr\",\n" ++
  "    \"utf-16be\"=>\"utf-16be\",\n" ++
