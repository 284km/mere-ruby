  "  (See the file 'LICENCE'.)\n" ++
  "\n" ++
  "=end\n" ++
  "\n" ++
  "require_relative 'http'\n" ++
  "require 'openssl'\n";
let network_source_12 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "#\n" ++
  "# = net/protocol.rb\n" ++
  "#\n" ++
  "#--\n" ++
  "# Copyright (c) 1999-2004 Yukihiro Matsumoto\n" ++
  "# Copyright (c) 1999-2004 Minero Aoki\n" ++
  "#\n" ++
  "# written and maintained by Minero Aoki <aamine@loveruby.net>\n" ++
  "#\n" ++
  "# This program is free software. You can re-distribute and/or\n" ++
  "# modify this program under the same terms as Ruby itself,\n" ++
  "# Ruby Distribute License or GNU General Public License.\n" ++
  "#\n" ++
  "# $Id$\n" ++
  "#++\n" ++
  "#\n" ++
  "# WARNING: This file is going to remove.\n" ++
  "# Do not rely on the implementation written in this file.\n" ++
  "#\n" ++
  "\n" ++
  "require 'socket'\n" ++
  "require 'timeout'\n" ++
  "require 'io/wait'\n" ++
  "\n" ++
  "module Net # :nodoc:\n" ++
  "\n" ++
  "  class Protocol   #:nodoc: internal use only\n" ++
  "    VERSION = \"0.2.2\"\n" ++
  "\n" ++
  "    private\n" ++
  "    def Protocol.protocol_param(name, val)\n" ++
  "      module_eval(<<-End, __FILE__, __LINE__ + 1)\n" ++
  "        def #\{name\}\n" ++
  "          #\{val\}\n" ++
  "        end\n" ++
  "      End\n" ++
  "    end\n" ++
  "\n" ++
  "    def ssl_socket_connect(s, timeout)\n" ++
  "      if timeout\n" ++
  "        while true\n" ++
  "          raise Net::OpenTimeout if timeout <= 0\n" ++
  "          start = Process.clock_gettime Process::CLOCK_MONOTONIC\n" ++
  "          # to_io is required because SSLSocket doesn't have wait_readable yet\n" ++
  "          case s.connect_nonblock(exception: false)\n" ++
  "          when :wait_readable; s.to_io.wait_readable(timeout)\n" ++
  "          when :wait_writable; s.to_io.wait_writable(timeout)\n" ++
  "          else; break\n" ++
  "          end\n" ++
  "          timeout -= Process.clock_gettime(Process::CLOCK_MONOTONIC) - start\n" ++
  "        end\n" ++
  "      else\n" ++
  "        s.connect\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  class ProtocolError          < StandardError; end\n" ++
  "  class ProtoSyntaxError       < ProtocolError; end\n" ++
  "  class ProtoFatalError        < ProtocolError; end\n" ++
  "  class ProtoUnknownError      < ProtocolError; end\n" ++
  "  class ProtoServerError       < ProtocolError; end\n" ++
  "  class ProtoAuthError         < ProtocolError; end\n" ++
  "  class ProtoCommandError      < ProtocolError; end\n" ++
  "  class ProtoRetriableError    < ProtocolError; end\n" ++
  "  ProtocRetryError = ProtoRetriableError\n" ++
  "  # :startdoc:\n" ++
  "\n" ++
  "  ##\n" ++
  "  # OpenTimeout, a subclass of Timeout::Error, is raised if a connection cannot\n" ++
  "  # be created within the open_timeout.\n" ++
  "\n" ++
  "  class OpenTimeout            < Timeout::Error; end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # ReadTimeout, a subclass of Timeout::Error, is raised if a chunk of the\n" ++
  "  # response cannot be read within the read_timeout.\n" ++
  "\n" ++
  "  class ReadTimeout < Timeout::Error\n" ++
  "    # :stopdoc:\n" ++
  "    def initialize(io = nil)\n" ++
  "      @io = io\n" ++
  "    end\n" ++
  "    attr_reader :io\n" ++
  "\n" ++
  "    def message\n" ++
  "      msg = super\n" ++
  "      if @io\n" ++
  "        msg = \"#\{msg\} with #\{@io.inspect\}\"\n" ++
  "      end\n" ++
  "      msg\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # WriteTimeout, a subclass of Timeout::Error, is raised if a chunk of the\n" ++
  "  # response cannot be written within the write_timeout.  Not raised on Windows.\n" ++
  "\n" ++
  "  class WriteTimeout < Timeout::Error\n" ++
  "    # :stopdoc:\n" ++
  "    def initialize(io = nil)\n" ++
  "      @io = io\n" ++
  "    end\n" ++
  "    attr_reader :io\n" ++
  "\n" ++
  "    def message\n" ++
  "      msg = super\n" ++
  "      if @io\n" ++
  "        msg = \"#\{msg\} with #\{@io.inspect\}\"\n" ++
  "      end\n" ++
  "      msg\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "\n" ++
  "  class BufferedIO   #:nodoc: internal use only\n" ++
  "    def initialize(io, read_timeout: 60, write_timeout: 60, continue_timeout: nil, debug_output: nil)\n" ++
  "      @io = io\n" ++
  "      @read_timeout = read_timeout\n" ++
  "      @write_timeout = write_timeout\n" ++
  "      @continue_timeout = continue_timeout\n" ++
  "      @debug_output = debug_output\n" ++
  "      @rbuf = ''.b\n" ++
  "      @rbuf_empty = true\n" ++
  "      @rbuf_offset = 0\n" ++
  "    end\n" ++
  "\n" ++
  "    attr_reader :io\n" ++
  "    attr_accessor :read_timeout\n" ++
  "    attr_accessor :write_timeout\n" ++
  "    attr_accessor :continue_timeout\n" ++
  "    attr_accessor :debug_output\n" ++
  "\n" ++
  "    def inspect\n" ++
  "      \"#<#\{self.class\} io=#\{@io\}>\"\n" ++
  "    end\n" ++
  "\n" ++
  "    def eof?\n" ++
  "      @io.eof?\n" ++
  "    end\n" ++
  "\n" ++
  "    def closed?\n" ++
  "      @io.closed?\n" ++
  "    end\n" ++
  "\n" ++
  "    def close\n" ++
  "      @io.close\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Read\n" ++
  "    #\n" ++
  "\n" ++
  "    public\n" ++
  "\n" ++
  "    def read(len, dest = ''.b, ignore_eof = false)\n" ++
  "      LOG \"reading #\{len\} bytes...\"\n" ++
  "      read_bytes = 0\n" ++
  "      begin\n" ++
  "        while read_bytes + rbuf_size < len\n" ++
  "          if s = rbuf_consume_all\n" ++
  "            read_bytes += s.bytesize\n" ++
  "            dest << s\n" ++
  "          end\n" ++
  "          rbuf_fill\n" ++
  "        end\n" ++
  "        s = rbuf_consume(len - read_bytes)\n" ++
  "        read_bytes += s.bytesize\n" ++
  "        dest << s\n" ++
  "      rescue EOFError\n" ++
  "        raise unless ignore_eof\n" ++
  "      end\n" ++
  "      LOG \"read #\{read_bytes\} bytes\"\n" ++
  "      dest\n" ++
  "    end\n" ++
  "\n" ++
  "    def read_all(dest = ''.b)\n" ++
  "      LOG 'reading all...'\n" ++
  "      read_bytes = 0\n" ++
  "      begin\n" ++
  "        while true\n" ++
  "          if s = rbuf_consume_all\n" ++
  "            read_bytes += s.bytesize\n" ++
  "            dest << s\n" ++
  "          end\n" ++
  "          rbuf_fill\n" ++
  "        end\n" ++
  "      rescue EOFError\n" ++
  "        ;\n" ++
  "      end\n" ++
  "      LOG \"read #\{read_bytes\} bytes\"\n" ++
  "      dest\n" ++
  "    end\n" ++
  "\n" ++
  "    def readuntil(terminator, ignore_eof = false)\n" ++
  "      offset = @rbuf_offset\n" ++
  "      begin\n" ++
  "        until idx = @rbuf.index(terminator, offset)\n" ++
  "          offset = @rbuf.bytesize\n" ++
  "          rbuf_fill\n" ++
  "        end\n" ++
  "        return rbuf_consume(idx + terminator.bytesize - @rbuf_offset)\n" ++
  "      rescue EOFError\n" ++
  "        raise unless ignore_eof\n" ++
  "        return rbuf_consume\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def readline\n" ++
  "      readuntil(\"\\n\").chop\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    BUFSIZE = 1024 * 16\n" ++
  "\n" ++
  "    def rbuf_fill\n" ++
  "      tmp = @rbuf_empty ? @rbuf : nil\n" ++
  "      case rv = @io.read_nonblock(BUFSIZE, tmp, exception: false)\n" ++
  "      when String\n" ++
  "        @rbuf_empty = false\n" ++
  "        if rv.equal?(tmp)\n" ++
  "          @rbuf_offset = 0\n" ++
  "        else\n" ++
  "          @rbuf << rv\n" ++
  "          rv.clear\n" ++
  "        end\n" ++
  "        return\n" ++
  "      when :wait_readable\n" ++
  "        (io = @io.to_io).wait_readable(@read_timeout) or raise Net::ReadTimeout.new(io)\n" ++
  "        # continue looping\n" ++
  "      when :wait_writable\n" ++
  "        # OpenSSL::Buffering#read_nonblock may fail with IO::WaitWritable.\n" ++
  "        # http://www.openssl.org/support/faq.html#PROG10\n" ++
  "        (io = @io.to_io).wait_writable(@read_timeout) or raise Net::ReadTimeout.new(io)\n" ++
  "        # continue looping\n" ++
  "      when nil\n" ++
  "        raise EOFError, 'end of file reached'\n" ++
  "      end while true\n" ++
  "    end\n" ++
  "\n" ++
  "    def rbuf_flush\n" ++
  "      if @rbuf_empty\n" ++
  "        @rbuf.clear\n" ++
  "        @rbuf_offset = 0\n" ++
  "      end\n" ++
  "      nil\n" ++
  "    end\n" ++
  "\n" ++
  "    def rbuf_size\n" ++
  "      @rbuf.bytesize - @rbuf_offset\n" ++
  "    end\n" ++
  "\n" ++
  "    def rbuf_consume_all\n" ++
  "      rbuf_consume if rbuf_size > 0\n" ++
  "    end\n" ++
  "\n" ++
  "    def rbuf_consume(len = nil)\n" ++
  "      if @rbuf_offset == 0 && (len.nil? || len == @rbuf.bytesize)\n" ++
  "        s = @rbuf\n" ++
  "        @rbuf = ''.b\n" ++
  "        @rbuf_offset = 0\n" ++
  "        @rbuf_empty = true\n" ++
