  "# frozen_string_literal: false\n" ++
  "# = uri/http.rb\n" ++
  "#\n" ++
  "# Author:: Akira Yamada <akira@ruby-lang.org>\n" ++
  "# License:: You can redistribute it and/or modify it under the same term as Ruby.\n" ++
  "#\n" ++
  "# See URI for general documentation\n" ++
  "#\n" ++
  "\n" ++
  "require_relative 'generic'\n" ++
  "\n" ++
  "module URI\n" ++
  "\n" ++
  "  #\n" ++
  "  # The syntax of HTTP URIs is defined in RFC1738 section 3.3.\n" ++
  "  #\n" ++
  "  # Note that the Ruby URI library allows HTTP URLs containing usernames and\n" ++
  "  # passwords. This is not legal as per the RFC, but used to be\n" ++
  "  # supported in Internet Explorer 5 and 6, before the MS04-004 security\n" ++
  "  # update. See <URL:http://support.microsoft.com/kb/834489>.\n" ++
  "  #\n" ++
  "  class HTTP < Generic\n" ++
  "    # A Default port of 80 for URI::HTTP.\n" ++
  "    DEFAULT_PORT = 80\n" ++
  "\n" ++
  "    # An Array of the available components for URI::HTTP.\n" ++
  "    COMPONENT = %i[\n" ++
  "      scheme\n" ++
  "      userinfo host port\n" ++
  "      path\n" ++
  "      query\n" ++
  "      fragment\n" ++
  "    ].freeze\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Creates a new URI::HTTP object from components, with syntax checking.\n" ++
  "    #\n" ++
  "    # The components accepted are userinfo, host, port, path, query, and\n" ++
  "    # fragment.\n" ++
  "    #\n" ++
  "    # The components should be provided either as an Array, or as a Hash\n" ++
  "    # with keys formed by preceding the component names with a colon.\n" ++
  "    #\n" ++
  "    # If an Array is used, the components must be passed in the\n" ++
  "    # order <code>[userinfo, host, port, path, query, fragment]</code>.\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #     uri = URI::HTTP.build(host: 'www.example.com', path: '/foo/bar')\n" ++
  "    #\n" ++
  "    #     uri = URI::HTTP.build([nil, \"www.example.com\", nil, \"/path\",\n" ++
  "    #       \"query\", 'fragment'])\n" ++
  "    #\n" ++
  "    # Currently, if passed userinfo components this method generates\n" ++
  "    # invalid HTTP URIs as per RFC 1738.\n" ++
  "    #\n" ++
  "    def self.build(args)\n" ++
  "      tmp = Util.make_components_hash(self, args)\n" ++
  "      super(tmp)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Do not allow empty host names, as they are not allowed by RFC 3986.\n" ++
  "    def check_host(v)\n" ++
  "      ret = super\n" ++
  "\n" ++
  "      if ret && v.empty?\n" ++
  "        raise InvalidComponentError,\n" ++
  "          \"bad component(expected host component): #\{v\}\"\n" ++
  "      end\n" ++
  "\n" ++
  "      ret\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Returns the full path for an HTTP request, as required by Net::HTTP::Get.\n" ++
  "    #\n" ++
  "    # If the URI contains a query, the full path is URI#path + '?' + URI#query.\n" ++
  "    # Otherwise, the path is simply URI#path.\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #     uri = URI::HTTP.build(path: '/foo/bar', query: 'test=true')\n" ++
  "    #     uri.request_uri #  => \"/foo/bar?test=true\"\n" ++
  "    #\n" ++
  "    def request_uri\n" ++
  "      return unless @path\n" ++
  "\n" ++
  "      url = @query ? \"#@path?#@query\" : @path.dup\n" ++
  "      url.start_with?(?/.freeze) ? url : ?/ + url\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Returns the authority for an HTTP uri, as defined in\n" ++
  "    # https://www.rfc-editor.org/rfc/rfc3986#section-3.2.\n" ++
  "    #\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #     URI::HTTP.build(host: 'www.example.com', path: '/foo/bar').authority #=> \"www.example.com\"\n" ++
  "    #     URI::HTTP.build(host: 'www.example.com', port: 8000, path: '/foo/bar').authority #=> \"www.example.com:8000\"\n" ++
  "    #     URI::HTTP.build(host: 'www.example.com', port: 80, path: '/foo/bar').authority #=> \"www.example.com\"\n" ++
  "    #\n" ++
  "    def authority\n" ++
  "      if port == default_port\n" ++
  "        host\n" ++
  "      else\n" ++
  "        \"#\{host\}:#\{port\}\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # == Description\n" ++
  "    #\n" ++
  "    # Returns the origin for an HTTP uri, as defined in\n" ++
  "    # https://www.rfc-editor.org/rfc/rfc6454.\n" ++
  "    #\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #     URI::HTTP.build(host: 'www.example.com', path: '/foo/bar').origin #=> \"http://www.example.com\"\n" ++
  "    #     URI::HTTP.build(host: 'www.example.com', port: 8000, path: '/foo/bar').origin #=> \"http://www.example.com:8000\"\n" ++
  "    #     URI::HTTP.build(host: 'www.example.com', port: 80, path: '/foo/bar').origin #=> \"http://www.example.com\"\n" ++
  "    #     URI::HTTPS.build(host: 'www.example.com', path: '/foo/bar').origin #=> \"https://www.example.com\"\n" ++
  "    #\n" ++
  "    def origin\n" ++
  "      \"#\{scheme\}://#\{authority\}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  register_scheme 'HTTP', HTTP\n" ++
  "end\n";
