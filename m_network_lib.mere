  "    nil\n" ++
  "  end\n" ++
  "\n" ++
  "  def get_attribute(ss)\n" ++
  "    ss.scan(/[\\t\\n\\f\\r \\/]*/)\n" ++
  "    if ss.peek(1) == '>'\n" ++
  "      ss.getch\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    name = ss.scan(/[^=\\t\\n\\f\\r \\/>]*/)\n" ++
  "    name.downcase!\n" ++
  "    raise if name.empty?\n" ++
  "    ss.skip(/[\\t\\n\\f\\r ]*/)\n" ++
  "    if ss.getch != '='\n" ++
  "      value = ''\n" ++
  "      return [name, value]\n" ++
  "    end\n" ++
  "    ss.skip(/[\\t\\n\\f\\r ]*/)\n" ++
  "    case ss.peek(1)\n" ++
  "    when '\"'\n" ++
  "      ss.getch\n" ++
  "      value = ss.scan(/[^\"]+/)\n" ++
  "      value.downcase!\n" ++
  "      ss.getch\n" ++
  "    when \"'\"\n" ++
  "      ss.getch\n" ++
  "      value = ss.scan(/[^']+/)\n" ++
  "      value.downcase!\n" ++
  "      ss.getch\n" ++
