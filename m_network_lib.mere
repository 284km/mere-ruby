let network_source_0 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "#\n" ++
  "# = net/ftp.rb - FTP Client Library\n" ++
  "#\n" ++
  "# Written by Shugo Maeda <shugo@ruby-lang.org>.\n" ++
  "#\n" ++
  "# Documentation by Gavin Sinclair, sourced from \"Programming Ruby\" (Hunt/Thomas)\n" ++
  "# and \"Ruby In a Nutshell\" (Matsumoto), used with permission.\n" ++
  "#\n" ++
  "# This library is distributed under the terms of the Ruby license.\n" ++
  "# You can freely distribute/modify this library.\n" ++
  "#\n" ++
  "# It is included in the Ruby standard library.\n" ++
  "#\n" ++
  "# See the Net::FTP class for an overview.\n" ++
  "#\n" ++
  "\n" ++
  "require \"socket\"\n" ++
  "require \"monitor\"\n" ++
  "require \"net/protocol\"\n" ++
  "require \"time\"\n" ++
  "begin\n" ++
  "  require \"openssl\"\n" ++
  "rescue LoadError\n" ++
  "end\n" ++
  "\n" ++
  "module Net\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  class FTPError < StandardError; end\n" ++
  "  class FTPReplyError < FTPError; end\n" ++
  "  class FTPTempError < FTPError; end\n" ++
  "  class FTPPermError < FTPError; end\n" ++
  "  class FTPProtoError < FTPError; end\n" ++
  "  class FTPConnectionError < FTPError; end\n" ++
  "  # :startdoc:\n" ++
  "\n" ++
  "  #\n" ++
  "  # This class implements the File Transfer Protocol.  If you have used a\n" ++
  "  # command-line FTP program, and are familiar with the commands, you will be\n" ++
  "  # able to use this class easily.  Some extra features are included to take\n" ++
  "  # advantage of Ruby's style and strengths.\n" ++
  "  #\n" ++
  "  # == Example\n" ++
  "  #\n" ++
  "  #   require 'net/ftp'\n" ++
  "  #\n" ++
  "  # === Example 1\n" ++
  "  #\n" ++
  "  #   ftp = Net::FTP.new('example.com')\n" ++
  "  #   ftp.login\n" ++
  "  #   files = ftp.chdir('pub/lang/ruby/contrib')\n" ++
  "  #   files = ftp.list('n*')\n" ++
  "  #   ftp.getbinaryfile('nif.rb-0.91.gz', 'nif.gz', 1024)\n" ++
  "  #   ftp.close\n" ++
  "  #\n" ++
  "  # === Example 2\n" ++
  "  #\n" ++
  "  #   Net::FTP.open('example.com') do |ftp|\n" ++
  "  #     ftp.login\n" ++
  "  #     files = ftp.chdir('pub/lang/ruby/contrib')\n" ++
  "  #     files = ftp.list('n*')\n" ++
  "  #     ftp.getbinaryfile('nif.rb-0.91.gz', 'nif.gz', 1024)\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # == Major Methods\n" ++
  "  #\n" ++
  "  # The following are the methods most likely to be useful to users:\n" ++
  "  # - FTP.open\n" ++
  "  # - #getbinaryfile\n" ++
  "  # - #gettextfile\n" ++
  "  # - #putbinaryfile\n" ++
  "  # - #puttextfile\n" ++
  "  # - #chdir\n" ++
  "  # - #nlst\n" ++
  "  # - #size\n" ++
  "  # - #rename\n" ++
  "  # - #delete\n" ++
  "  #\n" ++
  "  # == Mainframe User Support\n" ++
  "  # - #literal\n" ++
  "  # - #quote\n" ++
  "  #\n" ++
  "  class FTP < Protocol\n" ++
  "    include MonitorMixin\n" ++
  "    if defined?(OpenSSL::SSL)\n" ++
  "      include OpenSSL\n" ++
  "      include SSL\n" ++
  "    end\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "    VERSION = \"0.3.9\"\n" ++
  "    FTP_PORT = 21\n" ++
  "    CRLF = \"\\r\\n\"\n" ++
  "    DEFAULT_BLOCKSIZE = BufferedIO::BUFSIZE\n" ++
  "    @@default_passive = true\n" ++
  "    # :startdoc:\n" ++
  "\n" ++
  "    # When +true+, transfers are performed in binary mode.  Default: +true+.\n" ++
  "    attr_reader :binary\n" ++
  "\n" ++
  "    # When +true+, the connection is in passive mode.  Default: +true+.\n" ++
  "    attr_accessor :passive\n" ++
  "\n" ++
  "    # When +true+, use the IP address in PASV responses.  Otherwise, it uses\n" ++
  "    # the same IP address for the control connection.  Default: +false+.\n" ++
  "    attr_accessor :use_pasv_ip\n" ++
  "\n" ++
  "    # When +true+, all traffic to and from the server is written\n" ++
  "    # to +$stdout+.  Default: +false+.\n" ++
  "    attr_accessor :debug_mode\n" ++
  "\n" ++
  "    # Sets or retrieves the output stream for debugging.\n" ++
  "    # Output stream will be used only when +debug_mode+ is set to true.\n" ++
  "    # The default value is +$stdout+.\n" ++
  "    attr_accessor :debug_output\n" ++
  "\n" ++
  "    # Sets or retrieves the +resume+ status, which decides whether incomplete\n" ++
  "    # transfers are resumed or restarted.  Default: +false+.\n" ++
  "    attr_accessor :resume\n" ++
  "\n" ++
  "    # Number of seconds to wait for the connection to open. Any number\n" ++
  "    # may be used, including Floats for fractional seconds. If the FTP\n" ++
  "    # object cannot open a connection in this many seconds, it raises a\n" ++
  "    # Net::OpenTimeout exception. The default value is +nil+.\n" ++
  "    attr_accessor :open_timeout\n" ++
  "\n" ++
  "    # Number of seconds to wait for the TLS handshake. Any number\n" ++
  "    # may be used, including Floats for fractional seconds. If the FTP\n" ++
  "    # object cannot complete the TLS handshake in this many seconds, it\n" ++
  "    # raises a Net::OpenTimeout exception. The default value is +nil+.\n" ++
  "    # If +ssl_handshake_timeout+ is +nil+, +open_timeout+ is used instead.\n" ++
  "    attr_accessor :ssl_handshake_timeout\n" ++
  "\n" ++
  "    # Number of seconds to wait for one block to be read (via one read(2)\n" ++
  "    # call). Any number may be used, including Floats for fractional\n" ++
  "    # seconds. If the FTP object cannot read data in this many seconds,\n" ++
  "    # it raises a Timeout::Error exception. The default value is 60 seconds.\n" ++
  "    attr_reader :read_timeout\n" ++
  "\n" ++
  "    # Setter for the read_timeout attribute.\n" ++
  "    def read_timeout=(sec)\n" ++
  "      @sock.read_timeout = sec\n" ++
  "      @read_timeout = sec\n" ++
  "    end\n" ++
  "\n" ++
  "    # The server's welcome message.\n" ++
  "    attr_reader :welcome\n" ++
  "\n" ++
  "    # The server's last response code.\n" ++
  "    attr_reader :last_response_code\n" ++
  "    alias lastresp last_response_code\n" ++
  "\n" ++
  "    # The server's last response.\n" ++
  "    attr_reader :last_response\n" ++
  "\n" ++
  "    # When +true+, connections are in passive mode per default.\n" ++
  "    # Default: +true+.\n" ++
  "    def self.default_passive=(value)\n" ++
  "      @@default_passive = value\n" ++
  "    end\n" ++
  "\n" ++
  "    # When +true+, connections are in passive mode per default.\n" ++
  "    # Default: +true+.\n" ++
  "    def self.default_passive\n" ++
  "      @@default_passive\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # A synonym for <tt>FTP.new</tt>, but with a mandatory host parameter.\n" ++
  "    #\n" ++
  "    # If a block is given, it is passed the +FTP+ object, which will be closed\n" ++
  "    # when the block finishes, or when an exception is raised.\n" ++
  "    #\n" ++
  "    def FTP.open(host, *args)\n" ++
  "      if block_given?\n" ++
  "        ftp = new(host, *args)\n" ++
  "        begin\n" ++
  "          yield ftp\n" ++
  "        ensure\n" ++
  "          ftp.close\n" ++
  "        end\n" ++
  "      else\n" ++
  "        new(host, *args)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #    Net::FTP.new(host = nil, options = \{\})\n" ++
  "    #\n" ++
  "    # Creates and returns a new +FTP+ object. If a +host+ is given, a connection\n" ++
  "    # is made.\n" ++
  "    #\n" ++
  "    # +options+ is an option hash, each key of which is a symbol.\n" ++
  "    #\n" ++
  "    # The available options are:\n" ++
  "    #\n" ++
  "    # port::      Port number (default value is 21)\n" ++
  "    # ssl::       If +options+[:ssl] is true, then an attempt will be made\n" ++
  "    #             to use SSL (now TLS) to connect to the server.  For this\n" ++
  "    #             to work OpenSSL [OSSL] and the Ruby OpenSSL [RSSL]\n" ++
  "    #             extensions need to be installed.  If +options+[:ssl] is a\n" ++
  "    #             hash, it's passed to OpenSSL::SSL::SSLContext#set_params\n" ++
  "    #             as parameters.\n" ++
  "    # private_data_connection::  If true, TLS is used for data connections.\n" ++
  "    #                            Default: +true+ when +options+[:ssl] is true.\n" ++
  "    # implicit_ftps::  If true, TLS is established on initial connection.\n" ++
  "    #                  Default: +false+\n" ++
  "    # username::  Username for login.  If +options+[:username] is the string\n" ++
  "    #             \"anonymous\" and the +options+[:password] is +nil+,\n" ++
  "    #             \"anonymous@\" is used as a password.\n" ++
  "    # password::  Password for login.\n" ++
  "    # account::   Account information for ACCT.\n" ++
  "    # passive::   When +true+, the connection is in passive mode. Default:\n" ++
  "    #             +true+.\n" ++
  "    # open_timeout::  Number of seconds to wait for the connection to open.\n" ++
  "    #                 See Net::FTP#open_timeout for details.  Default: +nil+.\n" ++
  "    # read_timeout::  Number of seconds to wait for one block to be read.\n" ++
  "    #                 See Net::FTP#read_timeout for details.  Default: +60+.\n" ++
  "    # ssl_handshake_timeout::  Number of seconds to wait for the TLS\n" ++
  "    #                          handshake.\n" ++
  "    #                          See Net::FTP#ssl_handshake_timeout for\n" ++
  "    #                          details.  Default: +nil+.\n" ++
  "    # use_pasv_ip::  When +true+, use the IP address in PASV responses.\n" ++
  "    #                Otherwise, it uses the same IP address for the control\n" ++
  "    #                connection.  Default: +false+.\n" ++
  "    # debug_mode::  When +true+, all traffic to and from the server is\n" ++
  "    #               written to +$stdout+.  Default: +false+.\n" ++
  "    #\n" ++
  "    def initialize(host = nil, user_or_options = \{\}, passwd = nil, acct = nil)\n" ++
  "      super()\n" ++
  "      begin\n" ++
  "        options = user_or_options.to_hash\n" ++
  "      rescue NoMethodError\n" ++
  "        # for backward compatibility\n" ++
  "        options = \{\}\n" ++
  "        options[:username] = user_or_options\n" ++
  "        options[:password] = passwd\n" ++
  "        options[:account] = acct\n" ++
  "      end\n" ++
  "      @host = nil\n" ++
  "      if options[:ssl]\n" ++
  "        unless defined?(OpenSSL::SSL)\n" ++
  "          raise \"SSL extension not installed\"\n" ++
  "        end\n" ++
  "        ssl_params = options[:ssl] == true ? \{\} : options[:ssl]\n" ++
  "        @ssl_context = SSLContext.new\n" ++
  "        @ssl_context.set_params(ssl_params)\n" ++
  "        if defined?(VerifyCallbackProc)\n" ++
  "          @ssl_context.verify_callback = VerifyCallbackProc\n" ++
  "        end\n" ++
  "\n" ++
  "        # jruby-openssl does not support session caching\n" ++
  "        unless RUBY_ENGINE == \"jruby\"\n" ++
  "          @ssl_context.session_cache_mode =\n" ++
  "            OpenSSL::SSL::SSLContext::SESSION_CACHE_CLIENT |\n" ++
  "            OpenSSL::SSL::SSLContext::SESSION_CACHE_NO_INTERNAL_STORE\n" ++
  "          @ssl_context.session_new_cb = proc \{|sock, sess| @ssl_session = sess \}\n" ++
  "        end\n" ++
  "\n" ++
  "        @ssl_session = nil\n" ++
  "        if options[:private_data_connection].nil?\n" ++
  "          @private_data_connection = true\n" ++
  "        else\n" ++
  "          @private_data_connection = options[:private_data_connection]\n" ++
  "        end\n" ++
  "        if options[:implicit_ftps].nil?\n" ++
  "          @implicit_ftps = false\n" ++
  "        else\n" ++
  "          @implicit_ftps = options[:implicit_ftps]\n" ++
  "        end\n" ++
  "      else\n" ++
  "        @ssl_context = nil\n" ++
  "        if options[:private_data_connection]\n" ++
  "          raise ArgumentError,\n" ++
  "            \"private_data_connection can be set to true only when ssl is enabled\"\n" ++
  "        end\n" ++
  "        @private_data_connection = false\n" ++
  "        if options[:implicit_ftps]\n" ++
  "          raise ArgumentError,\n" ++
  "                \"implicit_ftps can be set to true only when ssl is enabled\"\n" ++
  "        end\n" ++
  "        @implicit_ftps = false\n" ++
  "      end\n" ++
  "      @binary = true\n" ++
  "      if options[:passive].nil?\n" ++
  "        @passive = @@default_passive\n" ++
  "      else\n" ++
  "        @passive = options[:passive]\n" ++
  "      end\n" ++
  "      if options[:debug_mode].nil?\n" ++
  "        @debug_mode = false\n" ++
  "      else\n" ++
  "        @debug_mode = options[:debug_mode]\n" ++
  "      end\n" ++
  "      @debug_output = $stdout\n" ++
  "      @resume = false\n" ++
  "      @bare_sock = @sock = NullSocket.new\n" ++
  "      @logged_in = false\n" ++
  "      @open_timeout = options[:open_timeout]\n" ++
  "      @ssl_handshake_timeout = options[:ssl_handshake_timeout]\n" ++
  "      @read_timeout = options[:read_timeout] || 60\n" ++
  "      @use_pasv_ip = options[:use_pasv_ip] || false\n" ++
  "      if host\n" ++
  "        connect(host, options[:port] || FTP_PORT)\n" ++
  "        if options[:username]\n" ++
  "          login(options[:username], options[:password], options[:account])\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # A setter to toggle transfers in binary mode.\n" ++
  "    # +newmode+ is either +true+ or +false+\n" ++
  "    def binary=(newmode)\n" ++
  "      if newmode != @binary\n" ++
  "        @binary = newmode\n" ++
  "        send_type_command if @logged_in\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a command to destination host, with the current binary sendmode\n" ++
  "    # type.\n" ++
  "    #\n" ++
  "    # If binary mode is +true+, then \"TYPE I\" (image) is sent, otherwise \"TYPE\n" ++
  "    # A\" (ascii) is sent.\n" ++
  "    def send_type_command # :nodoc:\n" ++
  "      if @binary\n" ++
  "        voidcmd(\"TYPE I\")\n" ++
  "      else\n" ++
  "        voidcmd(\"TYPE A\")\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :send_type_command\n" ++
  "\n" ++
  "    # Toggles transfers in binary mode and yields to a block.\n" ++
  "    # This preserves your current binary send mode, but allows a temporary\n" ++
  "    # transaction with binary sendmode of +newmode+.\n" ++
  "    #\n" ++
  "    # +newmode+ is either +true+ or +false+\n" ++
  "    def with_binary(newmode) # :nodoc:\n" ++
  "      oldmode = binary\n" ++
  "      self.binary = newmode\n" ++
  "      begin\n" ++
  "        yield\n" ++
  "      ensure\n" ++
  "        self.binary = oldmode\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :with_binary\n" ++
  "\n" ++
  "    # Obsolete\n" ++
  "    def return_code # :nodoc:\n" ++
  "      warn(\"Net::FTP#return_code is obsolete and do nothing\", uplevel: 1)\n" ++
  "      return \"\\n\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # Obsolete\n" ++
  "    def return_code=(s) # :nodoc:\n" ++
  "      warn(\"Net::FTP#return_code= is obsolete and do nothing\", uplevel: 1)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Constructs a socket with +host+ and +port+.\n" ++
  "    #\n" ++
  "    # If SOCKSSocket is defined and the environment (ENV) defines\n" ++
  "    # SOCKS_SERVER, then a SOCKSSocket is returned, else a Socket is\n" ++
  "    # returned.\n" ++
  "    def open_socket(host, port) # :nodoc:\n" ++
  "      return Timeout.timeout(@open_timeout, OpenTimeout) \{\n" ++
  "        if defined? SOCKSSocket and ENV[\"SOCKS_SERVER\"]\n" ++
  "          @passive = true\n" ++
  "          SOCKSSocket.open(host, port)\n" ++
  "        else\n" ++
  "          Socket.tcp(host, port)\n" ++
  "        end\n" ++
  "      \}\n" ++
  "    end\n" ++
  "    private :open_socket\n" ++
  "\n" ++
  "    def start_tls_session(sock)\n" ++
  "      ssl_sock = SSLSocket.new(sock, @ssl_context)\n" ++
  "      ssl_sock.sync_close = true\n" ++
  "      ssl_sock.hostname = @host if ssl_sock.respond_to? :hostname=\n" ++
  "      if @ssl_session &&\n" ++
  "          Process.clock_gettime(Process::CLOCK_REALTIME) < @ssl_session.time.to_f + @ssl_session.timeout\n" ++
  "        # ProFTPD returns 425 for data connections if session is not reused.\n" ++
  "        ssl_sock.session = @ssl_session\n" ++
  "      end\n" ++
  "      ssl_socket_connect(ssl_sock, @ssl_handshake_timeout || @open_timeout)\n" ++
  "      if @ssl_context.verify_mode != VERIFY_NONE\n" ++
  "        ssl_sock.post_connection_check(@host)\n" ++
  "      end\n" ++
  "      return ssl_sock\n" ++
  "    end\n" ++
  "    private :start_tls_session\n" ++
  "\n" ++
  "    #\n" ++
  "    # Establishes an FTP connection to host, optionally overriding the default\n" ++
  "    # port. If the environment variable +SOCKS_SERVER+ is set, sets up the\n" ++
  "    # connection through a SOCKS proxy. Raises an exception (typically\n" ++
  "    # <tt>Errno::ECONNREFUSED</tt>) if the connection cannot be established.\n" ++
  "    #\n" ++
  "    def connect(host, port = FTP_PORT)\n" ++
  "      debug_print \"connect: #\{host\}:#\{port\}\"\n" ++
  "      synchronize do\n" ++
  "        @host = host\n" ++
  "        @bare_sock = open_socket(host, port)\n" ++
  "        if @ssl_context\n" ++
  "          begin\n" ++
  "            unless @implicit_ftps\n" ++
  "              set_socket(BufferedSocket.new(@bare_sock, read_timeout: @read_timeout))\n" ++
  "              voidcmd(\"AUTH TLS\")\n" ++
  "            end\n" ++
  "            set_socket(BufferedSSLSocket.new(start_tls_session(@bare_sock), read_timeout: @read_timeout), @implicit_ftps)\n" ++
  "            if @private_data_connection\n" ++
  "              voidcmd(\"PBSZ 0\")\n" ++
  "              voidcmd(\"PROT P\")\n" ++
  "            end\n" ++
  "          rescue OpenSSL::SSL::SSLError, OpenTimeout\n" ++
  "            @sock.close\n" ++
  "            raise\n" ++
  "          end\n" ++
  "        else\n" ++
  "          set_socket(BufferedSocket.new(@bare_sock, read_timeout: @read_timeout))\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Set the socket used to connect to the FTP server.\n" ++
  "    #\n" ++
  "    # May raise FTPReplyError if +get_greeting+ is false.\n" ++
  "    def set_socket(sock, get_greeting = true)\n" ++
  "      synchronize do\n" ++
  "        @sock = sock\n" ++
  "        if get_greeting\n" ++
  "          voidresp\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # If string +s+ includes the PASS command (password), then the contents of\n" ++
  "    # the password are cleaned from the string using \"*\"\n" ++
  "    def sanitize(s) # :nodoc:\n" ++
  "      if s =~ /^PASS /i\n" ++
  "        return s[0, 5] + \"*\" * (s.length - 5)\n" ++
  "      else\n" ++
  "        return s\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :sanitize\n" ++
  "\n" ++
  "    # Ensures that +line+ has a control return / line feed (CRLF) and writes\n" ++
  "    # it to the socket.\n" ++
  "    def putline(line) # :nodoc:\n" ++
  "      debug_print \"put: #\{sanitize(line)\}\"\n" ++
  "      if /[\\r\\n]/ =~ line\n" ++
  "        raise ArgumentError, \"A line must not contain CR or LF\"\n" ++
  "      end\n" ++
  "      line = line + CRLF\n" ++
  "      @sock.write(line)\n" ++
  "    end\n" ++
  "    private :putline\n" ++
  "\n" ++
  "    # Reads a line from the sock.  If EOF, then it will raise EOFError\n" ++
  "    def getline # :nodoc:\n" ++
  "      line = @sock.readline # if get EOF, raise EOFError\n" ++
  "      line.sub!(/(\\r\\n|\\n|\\r)\\z/n, \"\")\n" ++
  "      debug_print \"get: #\{sanitize(line)\}\"\n" ++
  "      return line\n" ++
  "    end\n" ++
  "    private :getline\n" ++
  "\n" ++
  "    # Receive a section of lines until the response code's match.\n" ++
  "    def getmultiline # :nodoc:\n" ++
  "      lines = []\n" ++
  "      lines << getline\n" ++
  "      code = lines.last.slice(/\\A([0-9a-zA-Z]\{3\})-/, 1)\n" ++
  "      if code\n" ++
  "        delimiter = code + \" \"\n" ++
  "        begin\n" ++
  "          lines << getline\n" ++
  "        end until lines.last.start_with?(delimiter)\n" ++
  "      end\n" ++
  "      return lines.join(\"\\n\") + \"\\n\"\n" ++
  "    end\n" ++
  "    private :getmultiline\n" ++
  "\n" ++
  "    # Receives a response from the destination host.\n" ++
  "    #\n" ++
  "    # Returns the response code or raises FTPTempError, FTPPermError, or\n" ++
  "    # FTPProtoError\n" ++
  "    def getresp # :nodoc:\n" ++
  "      @last_response = getmultiline\n" ++
  "      @last_response_code = @last_response[0, 3]\n" ++
  "      case @last_response_code\n" ++
  "      when /\\A[123]/\n" ++
  "        return @last_response\n" ++
  "      when /\\A4/\n" ++
  "        raise FTPTempError, @last_response\n" ++
  "      when /\\A5/\n" ++
  "        raise FTPPermError, @last_response\n" ++
  "      else\n" ++
  "        raise FTPProtoError, @last_response\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :getresp\n" ++
  "\n" ++
  "    # Receives a response.\n" ++
  "    #\n" ++
  "    # Raises FTPReplyError if the first position of the response code is not\n" ++
  "    # equal 2.\n" ++
  "    def voidresp # :nodoc:\n" ++
  "      resp = getresp\n" ++
  "      if !resp.start_with?(\"2\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :voidresp\n" ++
  "\n" ++
  "    #\n" ++
  "    # Sends a command and returns the response.\n" ++
  "    #\n" ++
  "    def sendcmd(cmd)\n" ++
  "      synchronize do\n" ++
  "        putline(cmd)\n" ++
  "        return getresp\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Sends a command and expect a response beginning with '2'.\n" ++
  "    #\n" ++
  "    def voidcmd(cmd)\n" ++
  "      synchronize do\n" ++
  "        putline(cmd)\n" ++
  "        voidresp\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Constructs and send the appropriate PORT (or EPRT) command\n" ++
  "    def sendport(host, port) # :nodoc:\n" ++
  "      remote_address = @bare_sock.remote_address\n" ++
  "      if remote_address.ipv4?\n" ++
  "        cmd = \"PORT \" + (host.split(\".\") + port.divmod(256)).join(\",\")\n" ++
  "      elsif remote_address.ipv6?\n" ++
  "        cmd = sprintf(\"EPRT |2|%s|%d|\", host, port)\n" ++
  "      else\n" ++
  "        raise FTPProtoError, host\n" ++
  "      end\n" ++
  "      voidcmd(cmd)\n" ++
  "    end\n" ++
  "    private :sendport\n" ++
  "\n" ++
  "    # Constructs a TCPServer socket\n" ++
  "    def makeport # :nodoc:\n" ++
  "      Addrinfo.tcp(@bare_sock.local_address.ip_address, 0).listen\n" ++
  "    end\n" ++
  "    private :makeport\n" ++
  "\n" ++
  "    # sends the appropriate command to enable a passive connection\n" ++
  "    def makepasv # :nodoc:\n" ++
  "      if @bare_sock.remote_address.ipv4?\n" ++
  "        host, port = parse227(sendcmd(\"PASV\"))\n" ++
  "      else\n" ++
  "        host, port = parse229(sendcmd(\"EPSV\"))\n" ++
  "      end\n" ++
  "      return host, port\n" ++
  "    end\n" ++
  "    private :makepasv\n" ++
  "\n" ++
  "    # Constructs a connection for transferring data\n" ++
  "    def transfercmd(cmd, rest_offset = nil) # :nodoc:\n" ++
  "      if @passive\n" ++
  "        host, port = makepasv\n" ++
  "        succeeded = false\n" ++
  "        begin\n" ++
  "          conn = open_socket(host, port)\n" ++
  "          if @resume and rest_offset\n" ++
  "            resp = sendcmd(\"REST \" + rest_offset.to_s)\n" ++
  "            if !resp.start_with?(\"3\")\n" ++
  "              raise FTPReplyError, resp\n" ++
  "            end\n" ++
  "          end\n" ++
  "          resp = sendcmd(cmd)\n" ++
  "          # skip 2XX for some ftp servers\n" ++
  "          resp = getresp if resp.start_with?(\"2\")\n" ++
  "          if !resp.start_with?(\"1\")\n" ++
  "            raise FTPReplyError, resp\n" ++
  "          end\n" ++
  "          succeeded = true\n" ++
  "        ensure\n" ++
  "          conn&.close if !succeeded\n" ++
  "        end\n" ++
  "      else\n" ++
  "        sock = makeport\n" ++
  "        begin\n" ++
  "          addr = sock.local_address\n" ++
  "          sendport(addr.ip_address, addr.ip_port)\n" ++
  "          if @resume and rest_offset\n" ++
  "            resp = sendcmd(\"REST \" + rest_offset.to_s)\n" ++
  "            if !resp.start_with?(\"3\")\n" ++
  "              raise FTPReplyError, resp\n" ++
  "            end\n" ++
  "          end\n" ++
  "          resp = sendcmd(cmd)\n" ++
  "          # skip 2XX for some ftp servers\n" ++
  "          resp = getresp if resp.start_with?(\"2\")\n" ++
  "          if !resp.start_with?(\"1\")\n" ++
  "            raise FTPReplyError, resp\n" ++
  "          end\n" ++
  "          conn, = sock.accept\n" ++
  "          sock.shutdown(Socket::SHUT_WR) rescue nil\n" ++
  "          sock.read rescue nil\n" ++
  "        ensure\n" ++
  "          sock.close\n" ++
  "        end\n" ++
  "      end\n" ++
  "      if @private_data_connection\n" ++
  "        return BufferedSSLSocket.new(start_tls_session(conn),\n" ++
  "                                     read_timeout: @read_timeout)\n" ++
  "      else\n" ++
  "        return BufferedSocket.new(conn, read_timeout: @read_timeout)\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :transfercmd\n" ++
  "\n" ++
  "    #\n" ++
  "    # Logs in to the remote host.  The session must have been\n" ++
  "    # previously connected.  If +user+ is the string \"anonymous\" and\n" ++
  "    # the +password+ is +nil+, \"anonymous@\" is used as a password.  If\n" ++
  "    # the +acct+ parameter is not +nil+, an FTP ACCT command is sent\n" ++
  "    # following the successful login.  Raises an exception on error\n" ++
  "    # (typically <tt>Net::FTPPermError</tt>).\n" ++
  "    #\n" ++
  "    def login(user = \"anonymous\", passwd = nil, acct = nil)\n" ++
  "      if user == \"anonymous\" and passwd == nil\n" ++
  "        passwd = \"anonymous@\"\n" ++
  "      end\n" ++
  "\n" ++
  "      resp = \"\"\n" ++
  "      synchronize do\n" ++
  "        resp = sendcmd('USER ' + user)\n" ++
  "        if resp.start_with?(\"3\")\n" ++
  "          raise FTPReplyError, resp if passwd.nil?\n" ++
  "          resp = sendcmd('PASS ' + passwd)\n" ++
  "        end\n" ++
  "        if resp.start_with?(\"3\")\n" ++
  "          raise FTPReplyError, resp if acct.nil?\n" ++
  "          resp = sendcmd('ACCT ' + acct)\n" ++
  "        end\n" ++
  "      end\n" ++
  "      if !resp.start_with?(\"2\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      @welcome = resp\n" ++
  "      send_type_command\n" ++
  "      @logged_in = true\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Puts the connection into binary (image) mode, issues the given command,\n" ++
  "    # and fetches the data returned, passing it to the associated block in\n" ++
  "    # chunks of +blocksize+ characters. Note that +cmd+ is a server command\n" ++
  "    # (such as \"RETR myfile\").\n" ++
  "    #\n" ++
  "    def retrbinary(cmd, blocksize, rest_offset = nil) # :yield: data\n" ++
  "      synchronize do\n" ++
  "        with_binary(true) do\n" ++
  "          begin\n" ++
  "            conn = transfercmd(cmd, rest_offset)\n" ++
  "            while data = conn.read(blocksize)\n" ++
  "              yield(data)\n" ++
  "            end\n" ++
  "            conn.shutdown(Socket::SHUT_WR) rescue nil\n" ++
  "            conn.read_timeout = 1\n" ++
  "            conn.read rescue nil\n" ++
  "          ensure\n" ++
  "            conn.close if conn\n" ++
  "          end\n" ++
  "          voidresp\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Puts the connection into ASCII (text) mode, issues the given command, and\n" ++
  "    # passes the resulting data, one line at a time, to the associated block. If\n" ++
  "    # no block is given, prints the lines. Note that +cmd+ is a server command\n" ++
  "    # (such as \"RETR myfile\").\n" ++
  "    #\n" ++
  "    def retrlines(cmd) # :yield: line\n" ++
  "      synchronize do\n" ++
  "        with_binary(false) do\n" ++
  "          begin\n" ++
  "            conn = transfercmd(cmd)\n" ++
  "            while line = conn.gets\n" ++
  "              yield(line.sub(/\\r?\\n\\z/, \"\"), !line.match(/\\n\\z/).nil?)\n" ++
  "            end\n" ++
  "            conn.shutdown(Socket::SHUT_WR) rescue nil\n" ++
  "            conn.read_timeout = 1\n" ++
  "            conn.read rescue nil\n" ++
  "          ensure\n" ++
  "            conn.close if conn\n" ++
  "          end\n" ++
  "          voidresp\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Puts the connection into binary (image) mode, issues the given server-side\n" ++
  "    # command (such as \"STOR myfile\"), and sends the contents of the file named\n" ++
  "    # +file+ to the server. If the optional block is given, it also passes it\n" ++
  "    # the data, in chunks of +blocksize+ characters.\n" ++
  "    #\n" ++
  "    def storbinary(cmd, file, blocksize, rest_offset = nil) # :yield: data\n" ++
  "      if rest_offset\n" ++
  "        file.seek(rest_offset, IO::SEEK_SET)\n" ++
  "      end\n" ++
  "      synchronize do\n" ++
  "        with_binary(true) do\n" ++
  "          begin\n" ++
  "            conn = transfercmd(cmd)\n" ++
  "            while buf = file.read(blocksize)\n" ++
  "              conn.write(buf)\n" ++
  "              yield(buf) if block_given?\n" ++
  "            end\n" ++
  "            conn.shutdown(Socket::SHUT_WR) rescue nil\n" ++
  "            conn.read_timeout = 1\n" ++
  "            conn.read rescue nil\n" ++
  "          ensure\n" ++
  "            conn.close if conn\n" ++
  "          end\n" ++
  "          voidresp\n" ++
  "        end\n" ++
  "      end\n" ++
  "    rescue Errno::EPIPE\n" ++
  "      # EPIPE, in this case, means that the data connection was unexpectedly\n" ++
  "      # terminated.  Rather than just raising EPIPE to the caller, check the\n" ++
  "      # response on the control connection.  If getresp doesn't raise a more\n" ++
  "      # appropriate exception, re-raise the original exception.\n" ++
  "      getresp\n" ++
  "      raise\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Puts the connection into ASCII (text) mode, issues the given server-side\n" ++
  "    # command (such as \"STOR myfile\"), and sends the contents of the file\n" ++
  "    # named +file+ to the server, one line at a time. If the optional block is\n" ++
  "    # given, it also passes it the lines.\n" ++
  "    #\n" ++
  "    def storlines(cmd, file) # :yield: line\n" ++
  "      synchronize do\n" ++
  "        with_binary(false) do\n" ++
  "          begin\n" ++
  "            conn = transfercmd(cmd)\n" ++
  "            while buf = file.gets\n" ++
  "              if buf[-2, 2] != CRLF\n" ++
  "                buf = buf.chomp + CRLF\n" ++
  "              end\n" ++
  "              conn.write(buf)\n" ++
  "              yield(buf) if block_given?\n" ++
  "            end\n" ++
  "            conn.shutdown(Socket::SHUT_WR) rescue nil\n" ++
  "            conn.read_timeout = 1\n" ++
  "            conn.read rescue nil\n" ++
  "          ensure\n" ++
  "            conn.close if conn\n" ++
  "          end\n" ++
  "          getresp # The response might be important when connected to a mainframe\n" ++
  "        end\n" ++
  "      end\n" ++
  "    rescue Errno::EPIPE\n" ++
  "      # EPIPE, in this case, means that the data connection was unexpectedly\n" ++
  "      # terminated.  Rather than just raising EPIPE to the caller, check the\n" ++
  "      # response on the control connection.  If getresp doesn't raise a more\n" ++
  "      # appropriate exception, re-raise the original exception.\n" ++
  "      getresp\n" ++
  "      raise\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Retrieves +remotefile+ in binary mode, storing the result in +localfile+.\n" ++
  "    # If +localfile+ is nil, returns retrieved data.\n" ++
  "    # If a block is supplied, it is passed the retrieved data in +blocksize+\n" ++
  "    # chunks.\n" ++
  "    #\n" ++
  "    def getbinaryfile(remotefile, localfile = File.basename(remotefile),\n" ++
  "                      blocksize = DEFAULT_BLOCKSIZE, &block) # :yield: data\n" ++
  "      f = nil\n" ++
  "      result = nil\n" ++
  "      if localfile\n" ++
  "        if @resume\n" ++
  "          rest_offset = File.size?(localfile)\n" ++
  "          f = File.open(localfile, \"a\")\n" ++
  "        else\n" ++
  "          rest_offset = nil\n" ++
  "          f = File.open(localfile, \"w\")\n" ++
  "        end\n" ++
  "      elsif !block_given?\n" ++
  "        result = String.new\n" ++
  "      end\n" ++
  "      begin\n" ++
  "        f&.binmode\n" ++
  "        retrbinary(\"RETR #\{remotefile\}\", blocksize, rest_offset) do |data|\n" ++
  "          f&.write(data)\n" ++
  "          block&.(data)\n" ++
  "          result&.concat(data)\n" ++
  "        end\n" ++
  "        return result\n" ++
  "      ensure\n" ++
  "        f&.close\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Retrieves +remotefile+ in ASCII (text) mode, storing the result in\n" ++
  "    # +localfile+.\n" ++
  "    # If +localfile+ is nil, returns retrieved data.\n" ++
  "    # If a block is supplied, it is passed the retrieved data one\n" ++
  "    # line at a time.\n" ++
  "    #\n" ++
  "    def gettextfile(remotefile, localfile = File.basename(remotefile),\n" ++
  "                    &block) # :yield: line\n" ++
  "      f = nil\n" ++
  "      result = nil\n" ++
  "      if localfile\n" ++
  "        f = File.open(localfile, \"w\")\n" ++
  "      elsif !block_given?\n" ++
  "        result = String.new\n" ++
  "      end\n" ++
  "      begin\n" ++
  "        retrlines(\"RETR #\{remotefile\}\") do |line, newline|\n" ++
  "          l = newline ? line + \"\\n\" : line\n" ++
  "          f&.print(l)\n" ++
  "          block&.(line, newline)\n" ++
  "          result&.concat(l)\n" ++
  "        end\n" ++
  "        return result\n" ++
  "      ensure\n" ++
  "        f&.close\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Retrieves +remotefile+ in whatever mode the session is set (text or\n" ++
  "    # binary).  See #gettextfile and #getbinaryfile.\n" ++
  "    #\n" ++
  "    def get(remotefile, localfile = File.basename(remotefile),\n" ++
  "            blocksize = DEFAULT_BLOCKSIZE, &block) # :yield: data\n" ++
  "      if @binary\n" ++
  "        getbinaryfile(remotefile, localfile, blocksize, &block)\n" ++
  "      else\n" ++
  "        gettextfile(remotefile, localfile, &block)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Transfers +localfile+ to the server in binary mode, storing the result in\n" ++
  "    # +remotefile+. If a block is supplied, calls it, passing in the transmitted\n" ++
  "    # data in +blocksize+ chunks.\n" ++
  "    #\n" ++
  "    def putbinaryfile(localfile, remotefile = File.basename(localfile),\n" ++
  "                      blocksize = DEFAULT_BLOCKSIZE, &block) # :yield: data\n" ++
  "      if @resume\n" ++
  "        begin\n" ++
  "          rest_offset = size(remotefile)\n" ++
  "        rescue Net::FTPPermError\n" ++
  "          rest_offset = nil\n" ++
  "        end\n" ++
  "      else\n" ++
  "        rest_offset = nil\n" ++
  "      end\n" ++
  "      f = File.open(localfile)\n" ++
  "      begin\n" ++
  "        f.binmode\n" ++
  "        if rest_offset\n" ++
  "          storbinary(\"APPE #\{remotefile\}\", f, blocksize, rest_offset, &block)\n" ++
  "        else\n" ++
  "          storbinary(\"STOR #\{remotefile\}\", f, blocksize, rest_offset, &block)\n" ++
  "        end\n" ++
  "      ensure\n" ++
  "        f.close\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Transfers +localfile+ to the server in ASCII (text) mode, storing the result\n" ++
  "    # in +remotefile+. If callback or an associated block is supplied, calls it,\n" ++
  "    # passing in the transmitted data one line at a time.\n" ++
  "    #\n" ++
  "    # Returns the response which will contain a job number if the user was communicating with a mainframe in ASCII mode\n" ++
  "    # after issuing 'quote site filetype=jes'\n" ++
  "    #\n" ++
  "    def puttextfile(localfile, remotefile = File.basename(localfile), &block) # :yield: line\n" ++
  "      f = File.open(localfile)\n" ++
  "      response = ''\n" ++
  "      begin\n" ++
  "        response = storlines(\"STOR #\{remotefile\}\", f, &block)\n" ++
  "      ensure\n" ++
  "        f.close\n" ++
  "      end\n" ++
  "      response\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Transfers +localfile+ to the server in whatever mode the session is set\n" ++
  "    # (text or binary).  See #puttextfile and #putbinaryfile.\n" ++
  "    #\n" ++
  "    def put(localfile, remotefile = File.basename(localfile),\n" ++
  "            blocksize = DEFAULT_BLOCKSIZE, &block)\n" ++
  "      if @binary\n" ++
  "        putbinaryfile(localfile, remotefile, blocksize, &block)\n" ++
  "      else\n" ++
  "        puttextfile(localfile, remotefile, &block)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Sends the ACCT command.\n" ++
  "    #\n" ++
  "    # This is a less common FTP command, to send account\n" ++
  "    # information if the destination host requires it.\n" ++
  "    #\n" ++
  "    def acct(account)\n" ++
  "      cmd = \"ACCT \" + account\n" ++
  "      voidcmd(cmd)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns an array of filenames in the remote directory.\n" ++
  "    #\n" ++
  "    def nlst(dir = nil)\n" ++
  "      cmd = \"NLST\"\n" ++
  "      if dir\n" ++
  "        cmd = \"#\{cmd\} #\{dir\}\"\n" ++
  "      end\n" ++
  "      files = []\n" ++
  "      retrlines(cmd) do |line|\n" ++
  "        files.push(line)\n" ++
  "      end\n" ++
  "      return files\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns an array of file information in the directory (the output is like\n" ++
  "    # `ls -l`).  If a block is given, it iterates through the listing.\n" ++
  "    #\n" ++
  "    def list(*args, &block) # :yield: line\n" ++
  "      cmd = \"LIST\"\n" ++
  "      args.each do |arg|\n" ++
  "        cmd = \"#\{cmd\} #\{arg\}\"\n" ++
  "      end\n" ++
  "      lines = []\n" ++
  "      retrlines(cmd) do |line|\n" ++
  "        lines << line\n" ++
  "      end\n" ++
  "      if block\n" ++
  "        lines.each(&block)\n" ++
  "      end\n" ++
  "      return lines\n" ++
  "    end\n" ++
  "    alias ls list\n" ++
  "    alias dir list\n" ++
  "\n" ++
  "    #\n" ++
  "    # MLSxEntry represents an entry in responses of MLST/MLSD.\n" ++
  "    # Each entry has the facts (e.g., size, last modification time, etc.)\n" ++
  "    # and the pathname.\n" ++
  "    #\n" ++
  "    class MLSxEntry\n" ++
  "      attr_reader :facts, :pathname\n" ++
  "\n" ++
  "      def initialize(facts, pathname)\n" ++
  "        @facts = facts\n" ++
  "        @pathname = pathname\n" ++
  "      end\n" ++
  "\n" ++
  "      standard_facts = %w(size modify create type unique perm\n" ++
  "                          lang media-type charset)\n" ++
  "      standard_facts.each do |factname|\n" ++
  "        define_method factname.gsub(/-/, \"_\") do\n" ++
  "          facts[factname]\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the entry is a file (i.e., the value of the type\n" ++
  "      # fact is file).\n" ++
  "      #\n" ++
  "      def file?\n" ++
  "        return facts[\"type\"] == \"file\"\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the entry is a directory (i.e., the value of the\n" ++
  "      # type fact is dir, cdir, or pdir).\n" ++
  "      #\n" ++
  "      def directory?\n" ++
  "        if /\\A[cp]?dir\\z/.match(facts[\"type\"])\n" ++
  "          return true\n" ++
  "        else\n" ++
  "          return false\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the APPE command may be applied to the file.\n" ++
  "      #\n" ++
  "      def appendable?\n" ++
  "        return facts[\"perm\"].include?(?a)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if files may be created in the directory by STOU,\n" ++
  "      # STOR, APPE, and RNTO.\n" ++
  "      #\n" ++
  "      def creatable?\n" ++
  "        return facts[\"perm\"].include?(?c)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the file or directory may be deleted by DELE/RMD.\n" ++
  "      #\n" ++
  "      def deletable?\n" ++
  "        return facts[\"perm\"].include?(?d)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the directory may be entered by CWD/CDUP.\n" ++
  "      #\n" ++
  "      def enterable?\n" ++
  "        return facts[\"perm\"].include?(?e)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the file or directory may be renamed by RNFR.\n" ++
  "      #\n" ++
  "      def renamable?\n" ++
  "        return facts[\"perm\"].include?(?f)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the listing commands, LIST, NLST, and MLSD are\n" ++
  "      # applied to the directory.\n" ++
  "      #\n" ++
  "      def listable?\n" ++
  "        return facts[\"perm\"].include?(?l)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the MKD command may be used to create a new\n" ++
  "      # directory within the directory.\n" ++
  "      #\n" ++
  "      def directory_makable?\n" ++
  "        return facts[\"perm\"].include?(?m)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the objects in the directory may be deleted, or\n" ++
  "      # the directory may be purged.\n" ++
  "      #\n" ++
  "      def purgeable?\n" ++
  "        return facts[\"perm\"].include?(?p)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the RETR command may be applied to the file.\n" ++
  "      #\n" ++
  "      def readable?\n" ++
  "        return facts[\"perm\"].include?(?r)\n" ++
  "      end\n" ++
  "\n" ++
  "      #\n" ++
  "      # Returns +true+ if the STOR command may be applied to the file.\n" ++
  "      #\n" ++
  "      def writable?\n" ++
  "        return facts[\"perm\"].include?(?w)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    CASE_DEPENDENT_PARSER = ->(value) \{ value \}\n" ++
  "    CASE_INDEPENDENT_PARSER = ->(value) \{ value.downcase \}\n" ++
  "    DECIMAL_PARSER = ->(value) \{ value.to_i \}\n" ++
  "    OCTAL_PARSER = ->(value) \{ value.to_i(8) \}\n" ++
  "    TIME_PARSER = ->(value, local = false) \{\n" ++
  "      unless /\\A(?<year>\\d\{4\})(?<month>\\d\{2\})(?<day>\\d\{2\})\n" ++
  "            (?<hour>\\d\{2\})(?<min>\\d\{2\})(?<sec>\\d\{2\})\n" ++
  "            (?:\\.(?<fractions>\\d\{1,17\}))?/x =~ value\n" ++
  "        value = value[0, 97] + \"...\" if value.size > 100\n" ++
  "        raise FTPProtoError, \"invalid time-val: #\{value\}\"\n" ++
  "      end\n" ++
  "      usec = \".#\{fractions\}\".to_r * 1_000_000 if fractions\n" ++
  "      Time.public_send(local ? :local : :utc, year, month, day, hour, min, sec, usec)\n" ++
  "    \}\n" ++
  "    FACT_PARSERS = Hash.new(CASE_DEPENDENT_PARSER)\n" ++
  "    FACT_PARSERS[\"size\"] = DECIMAL_PARSER\n" ++
  "    FACT_PARSERS[\"modify\"] = TIME_PARSER\n" ++
  "    FACT_PARSERS[\"create\"] = TIME_PARSER\n" ++
  "    FACT_PARSERS[\"type\"] = CASE_INDEPENDENT_PARSER\n" ++
  "    FACT_PARSERS[\"unique\"] = CASE_DEPENDENT_PARSER\n" ++
  "    FACT_PARSERS[\"perm\"] = CASE_INDEPENDENT_PARSER\n" ++
  "    FACT_PARSERS[\"lang\"] = CASE_INDEPENDENT_PARSER\n" ++
  "    FACT_PARSERS[\"media-type\"] = CASE_INDEPENDENT_PARSER\n" ++
  "    FACT_PARSERS[\"charset\"] = CASE_INDEPENDENT_PARSER\n" ++
  "    FACT_PARSERS[\"unix.mode\"] = OCTAL_PARSER\n" ++
  "    FACT_PARSERS[\"unix.owner\"] = DECIMAL_PARSER\n" ++
  "    FACT_PARSERS[\"unix.group\"] = DECIMAL_PARSER\n" ++
  "    FACT_PARSERS[\"unix.ctime\"] = TIME_PARSER\n" ++
  "    FACT_PARSERS[\"unix.atime\"] = TIME_PARSER\n" ++
  "\n" ++
  "    def parse_mlsx_entry(entry)\n" ++
  "      facts, pathname = entry.chomp.split(/ /, 2)\n" ++
  "      unless pathname\n" ++
  "        raise FTPProtoError, entry\n" ++
  "      end\n" ++
  "      return MLSxEntry.new(\n" ++
  "        facts.scan(/(.*?)=(.*?);/).each_with_object(\{\}) \{\n" ++
  "          |(factname, value), h|\n" ++
  "          name = factname.downcase\n" ++
  "          h[name] = FACT_PARSERS[name].(value)\n" ++
  "        \},\n" ++
  "        pathname)\n" ++
  "    end\n" ++
  "    private :parse_mlsx_entry\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns data (e.g., size, last modification time, entry type, etc.)\n" ++
  "    # about the file or directory specified by +pathname+.\n" ++
  "    # If +pathname+ is omitted, the current directory is assumed.\n" ++
  "    #\n" ++
  "    def mlst(pathname = nil)\n" ++
  "      cmd = pathname ? \"MLST #\{pathname\}\" : \"MLST\"\n" ++
  "      resp = sendcmd(cmd)\n" ++
  "      if !resp.start_with?(\"250\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      line = resp.lines[1]\n" ++
  "      unless line\n" ++
  "        raise FTPProtoError, resp\n" ++
  "      end\n" ++
  "      entry = line.sub(/\\A(250-| *)/, \"\")\n" ++
  "      return parse_mlsx_entry(entry)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns an array of the entries of the directory specified by\n" ++
  "    # +pathname+.\n" ++
  "    # Each entry has the facts (e.g., size, last modification time, etc.)\n" ++
  "    # and the pathname.\n" ++
  "    # If a block is given, it iterates through the listing.\n" ++
  "    # If +pathname+ is omitted, the current directory is assumed.\n" ++
  "    #\n" ++
  "    def mlsd(pathname = nil, &block) # :yield: entry\n" ++
  "      cmd = pathname ? \"MLSD #\{pathname\}\" : \"MLSD\"\n" ++
  "      entries = []\n" ++
  "      retrlines(cmd) do |line|\n" ++
  "        entries << parse_mlsx_entry(line)\n" ++
  "      end\n" ++
  "      if block\n" ++
  "        entries.each(&block)\n" ++
  "      end\n" ++
  "      return entries\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Renames a file on the server.\n" ++
  "    #\n" ++
  "    def rename(fromname, toname)\n" ++
  "      resp = sendcmd(\"RNFR #\{fromname\}\")\n" ++
  "      if !resp.start_with?(\"3\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      voidcmd(\"RNTO #\{toname\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Deletes a file on the server.\n" ++
  "    #\n" ++
  "    def delete(filename)\n" ++
  "      resp = sendcmd(\"DELE #\{filename\}\")\n" ++
  "      if resp.start_with?(\"250\")\n" ++
  "        return\n" ++
  "      elsif resp.start_with?(\"5\")\n" ++
  "        raise FTPPermError, resp\n" ++
  "      else\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Changes the (remote) directory.\n" ++
  "    #\n" ++
  "    def chdir(dirname)\n" ++
  "      if dirname == \"..\"\n" ++
  "        begin\n" ++
  "          voidcmd(\"CDUP\")\n" ++
  "          return\n" ++
  "        rescue FTPPermError => e\n" ++
  "          if e.message[0, 3] != \"500\"\n" ++
  "            raise e\n" ++
  "          end\n" ++
  "        end\n" ++
  "      end\n" ++
  "      cmd = \"CWD #\{dirname\}\"\n" ++
  "      voidcmd(cmd)\n" ++
  "    end\n" ++
  "\n" ++
  "    def get_body(resp) # :nodoc:\n" ++
  "      resp.slice(/\\A[0-9a-zA-Z]\{3\} (.*)$/, 1)\n" ++
  "    end\n" ++
  "    private :get_body\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns the size of the given (remote) filename.\n" ++
  "    #\n" ++
  "    def size(filename)\n" ++
  "      with_binary(true) do\n" ++
  "        resp = sendcmd(\"SIZE #\{filename\}\")\n" ++
  "        if !resp.start_with?(\"213\")\n" ++
  "          raise FTPReplyError, resp\n" ++
  "        end\n" ++
  "        return get_body(resp).to_i\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns the last modification time of the (remote) file.  If +local+ is\n" ++
  "    # +true+, it is returned as a local time, otherwise it's a UTC time.\n" ++
  "    #\n" ++
  "    def mtime(filename, local = false)\n" ++
  "      return TIME_PARSER.(mdtm(filename), local)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Creates a remote directory.\n" ++
  "    #\n" ++
  "    def mkdir(dirname)\n" ++
  "      resp = sendcmd(\"MKD #\{dirname\}\")\n" ++
  "      return parse257(resp)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # The \"quote\" subcommand sends arguments verbatim to the remote ftp server.\n" ++
  "    # The \"literal\" subcommand is an alias for \"quote\".\n" ++
  "    # @param arguments Array[String] to be sent verbatim to the remote ftp server\n" ++
  "    #\n" ++
  "    def quote(arguments)\n" ++
  "      sendcmd(arguments)\n" ++
  "    end\n" ++
  "    alias literal quote\n" ++
  "\n" ++
  "    #\n" ++
  "    # Removes a remote directory.\n" ++
  "    #\n" ++
  "    def rmdir(dirname)\n" ++
  "      voidcmd(\"RMD #\{dirname\}\")\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns the current remote directory.\n" ++
  "    #\n" ++
  "    def pwd\n" ++
  "      resp = sendcmd(\"PWD\")\n" ++
  "      return parse257(resp)\n" ++
  "    end\n" ++
  "    alias getdir pwd\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns system information.\n" ++
  "    #\n" ++
  "    def system\n" ++
  "      resp = sendcmd(\"SYST\")\n" ++
  "      if !resp.start_with?(\"215\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      return get_body(resp)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Aborts the previous command (ABOR command).\n" ++
  "    #\n" ++
  "    def abort\n" ++
  "      line = \"ABOR\" + CRLF\n" ++
  "      debug_print \"put: ABOR\"\n" ++
  "      @sock.send(line, Socket::MSG_OOB)\n" ++
  "      resp = getmultiline\n" ++
  "      unless [\"426\", \"226\", \"225\"].include?(resp[0, 3])\n" ++
  "        raise FTPProtoError, resp\n" ++
  "      end\n" ++
  "      return resp\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns the status (STAT command).\n" ++
  "    #\n" ++
  "    # pathname:: when stat is invoked with pathname as a parameter it acts like\n" ++
  "    #            list but a lot faster and over the same tcp session.\n" ++
  "    #\n" ++
  "    def status(pathname = nil)\n" ++
  "      line = pathname ? \"STAT #\{pathname\}\" : \"STAT\"\n" ++
  "      if /[\\r\\n]/ =~ line\n" ++
  "        raise ArgumentError, \"A line must not contain CR or LF\"\n" ++
  "      end\n" ++
  "      debug_print \"put: #\{line\}\"\n" ++
  "      @sock.send(line + CRLF, Socket::MSG_OOB)\n" ++
  "      return getresp\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns the raw last modification time of the (remote) file in the format\n" ++
  "    # \"YYYYMMDDhhmmss\" (MDTM command).\n" ++
  "    #\n" ++
  "    # Use +mtime+ if you want a parsed Time instance.\n" ++
  "    #\n" ++
  "    def mdtm(filename)\n" ++
  "      resp = sendcmd(\"MDTM #\{filename\}\")\n" ++
  "      if resp.start_with?(\"213\")\n" ++
  "        return get_body(resp)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Issues the HELP command.\n" ++
  "    #\n" ++
  "    def help(arg = nil)\n" ++
  "      cmd = \"HELP\"\n" ++
  "      if arg\n" ++
  "        cmd = cmd + \" \" + arg\n" ++
  "      end\n" ++
  "      sendcmd(cmd)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Exits the FTP session.\n" ++
  "    #\n" ++
  "    def quit\n" ++
  "      voidcmd(\"QUIT\")\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Issues a NOOP command.\n" ++
  "    #\n" ++
  "    # Does nothing except return a response.\n" ++
  "    #\n" ++
  "    def noop\n" ++
  "      voidcmd(\"NOOP\")\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Issues a SITE command.\n" ++
  "    #\n" ++
  "    def site(arg)\n" ++
  "      cmd = \"SITE \" + arg\n" ++
  "      voidcmd(cmd)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Issues a FEAT command\n" ++
  "    #\n" ++
  "    # Returns an array of supported optional features\n" ++
  "    #\n" ++
  "    def features\n" ++
  "      resp = sendcmd(\"FEAT\")\n" ++
  "      if !resp.start_with?(\"211\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "\n" ++
  "      feats = []\n" ++
  "      resp.each_line do |line|\n" ++
  "        next if !line.start_with?(' ') # skip status lines\n" ++
  "\n" ++
  "        feats << line.strip\n" ++
  "      end\n" ++
  "\n" ++
  "      return feats\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Issues an OPTS command\n" ++
  "    # - name Should be the name of the option to set\n" ++
  "    # - params is any optional parameters to supply with the option\n" ++
  "    #\n" ++
  "    # example: option('UTF8', 'ON') => 'OPTS UTF8 ON'\n" ++
  "    #\n" ++
  "    def option(name, params = nil)\n" ++
  "      cmd = \"OPTS #\{name\}\"\n" ++
  "      cmd += \" #\{params\}\" if params\n" ++
  "\n" ++
  "      voidcmd(cmd)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Closes the connection.  Further operations are impossible until you open\n" ++
  "    # a new connection with #connect.\n" ++
  "    #\n" ++
  "    def close\n" ++
  "      if @sock and not @sock.closed?\n" ++
  "        begin\n" ++
  "          @sock.shutdown(Socket::SHUT_WR) rescue nil\n" ++
  "          orig, self.read_timeout = self.read_timeout, 3\n" ++
  "          @sock.read rescue nil\n" ++
  "        ensure\n" ++
  "          @sock.close\n" ++
  "          self.read_timeout = orig\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # Returns +true+ if and only if the connection is closed.\n" ++
  "    #\n" ++
  "    def closed?\n" ++
  "      @sock == nil or @sock.closed?\n" ++
  "    end\n" ++
  "\n" ++
  "    # handler for response code 227\n" ++
  "    # (Entering Passive Mode (h1,h2,h3,h4,p1,p2))\n" ++
  "    #\n" ++
  "    # Returns host and port.\n" ++
  "    def parse227(resp) # :nodoc:\n" ++
  "      if !resp.start_with?(\"227\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      if m = /(?<host>\\d+(?:,\\d+)\{3\}),(?<port>\\d+,\\d+)/.match(resp)\n" ++
  "        if @use_pasv_ip\n" ++
  "          host = parse_pasv_ipv4_host(m[\"host\"])\n" ++
  "        else\n" ++
  "          host = @bare_sock.remote_address.ip_address\n" ++
  "        end\n" ++
  "        return host, parse_pasv_port(m[\"port\"])\n" ++
  "      else\n" ++
  "        raise FTPProtoError, resp\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :parse227\n" ++
  "\n" ++
  "    def parse_pasv_ipv4_host(s)\n" ++
  "      return s.tr(\",\", \".\")\n" ++
  "    end\n" ++
  "    private :parse_pasv_ipv4_host\n" ++
  "\n" ++
  "    def parse_pasv_ipv6_host(s)\n" ++
  "      return s.split(/,/).map \{ |i|\n" ++
  "        \"%02x\" % i.to_i\n" ++
  "      \}.each_slice(2).map(&:join).join(\":\")\n" ++
  "    end\n" ++
  "    private :parse_pasv_ipv6_host\n" ++
  "\n" ++
  "    def parse_pasv_port(s)\n" ++
  "      return s.split(/,/).map(&:to_i).inject \{ |x, y|\n" ++
  "        (x << 8) + y\n" ++
  "      \}\n" ++
  "    end\n" ++
  "    private :parse_pasv_port\n" ++
  "\n" ++
  "    # handler for response code 229\n" ++
  "    # (Extended Passive Mode Entered)\n" ++
  "    #\n" ++
  "    # Returns host and port.\n" ++
  "    def parse229(resp) # :nodoc:\n" ++
  "      if !resp.start_with?(\"229\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      if m = /\\((?<d>[!-~])\\k<d>\\k<d>(?<port>\\d+)\\k<d>\\)/.match(resp)\n" ++
  "        return @bare_sock.remote_address.ip_address, m[\"port\"].to_i\n" ++
  "      else\n" ++
  "        raise FTPProtoError, resp\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :parse229\n" ++
  "\n" ++
  "    # handler for response code 257\n" ++
  "    # (\"PATHNAME\" created)\n" ++
  "    #\n" ++
  "    # Returns host and port.\n" ++
  "    def parse257(resp) # :nodoc:\n" ++
  "      if !resp.start_with?(\"257\")\n" ++
  "        raise FTPReplyError, resp\n" ++
  "      end\n" ++
  "      return resp.slice(/\"(([^\"]|\"\")*)\"/, 1).to_s.gsub(/\"\"/, '\"')\n" ++
  "    end\n" ++
  "    private :parse257\n" ++
  "\n" ++
  "    #\n" ++
  "    # Writes debug message to the debug output stream\n" ++
  "    #\n" ++
  "    def debug_print(msg)\n" ++
  "      @debug_output << msg + \"\\n\" if @debug_mode && @debug_output\n" ++
  "    end\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "    class NullSocket\n" ++
  "      def read_timeout=(sec)\n" ++
  "      end\n" ++
  "\n" ++
  "      def closed?\n" ++
  "        true\n" ++
  "      end\n" ++
  "\n" ++
  "      def close\n" ++
  "      end\n" ++
  "\n" ++
  "      def method_missing(mid, *args)\n" ++
  "        raise FTPConnectionError, \"not connected\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class BufferedSocket < BufferedIO\n" ++
  "      [:local_address, :remote_address, :addr, :peeraddr, :send, :shutdown].each do |method|\n" ++
  "        define_method(method) \{ |*args|\n" ++
  "          @io.__send__(method, *args)\n" ++
  "        \}\n" ++
  "      end\n" ++
  "\n" ++
  "      def read(len = nil)\n" ++
  "        if len\n" ++
  "          s = super(len, String.new, true)\n" ++
  "          return s.empty? ? nil : s\n" ++
  "        else\n" ++
  "          result = String.new\n" ++
  "          while s = super(DEFAULT_BLOCKSIZE, String.new, true)\n" ++
  "            break if s.empty?\n" ++
  "            result << s\n" ++
  "          end\n" ++
  "          return result\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      def gets\n" ++
  "        line = readuntil(\"\\n\", true)\n" ++
  "        return line.empty? ? nil : line\n" ++
  "      end\n" ++
  "\n" ++
  "      def readline\n" ++
  "        line = gets\n" ++
  "        if line.nil?\n" ++
  "          raise EOFError, \"end of file reached\"\n" ++
  "        end\n" ++
  "        return line\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    if defined?(OpenSSL::SSL::SSLSocket)\n" ++
  "      class BufferedSSLSocket < BufferedSocket\n" ++
  "\n" ++
  "        def shutdown(*args)\n" ++
  "          # Invokes SSL_shutdown, which sends a close_notify message to the peer.\n" ++
  "          @io.__send__(:stop)\n" ++
  "        end\n" ++
  "\n" ++
  "        def send(mesg, flags, dest = nil)\n" ++
  "          # Ignore flags and dest.\n" ++
  "          @io.write(mesg)\n" ++
  "        end\n" ++
  "\n" ++
  "      end\n" ++
  "    end\n" ++
  "    # :startdoc:\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "\n" ++
  "# Documentation comments:\n" ++
  "#  - sourced from pickaxe and nutshell, with improvements (hopefully)\n";
let network_source_1 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "#\n" ++
  "# = net/http.rb\n" ++
  "#\n" ++
  "# Copyright (c) 1999-2007 Yukihiro Matsumoto\n" ++
  "# Copyright (c) 1999-2007 Minero Aoki\n" ++
  "# Copyright (c) 2001 GOTOU Yuuzou\n" ++
  "#\n" ++
  "# Written and maintained by Minero Aoki <aamine@loveruby.net>.\n" ++
  "# HTTPS support added by GOTOU Yuuzou <gotoyuzo@notwork.org>.\n" ++
  "#\n" ++
  "# This file is derived from \"http-access.rb\".\n" ++
  "#\n" ++
  "# Documented by Minero Aoki; converted to RDoc by William Webber.\n" ++
  "#\n" ++
  "# This program is free software. You can re-distribute and/or\n" ++
  "# modify this program under the same terms of ruby itself ---\n" ++
  "# Ruby Distribution License or GNU General Public License.\n" ++
  "#\n" ++
  "# See Net::HTTP for an overview and examples.\n" ++
  "#\n" ++
  "\n" ++
  "require 'net/protocol'\n" ++
  "require 'uri'\n" ++
  "require 'resolv'\n" ++
  "autoload :OpenSSL, 'openssl'\n" ++
  "\n" ++
  "module Net   #:nodoc:\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  class HTTPBadResponse < StandardError; end\n" ++
  "  class HTTPHeaderSyntaxError < StandardError; end\n" ++
  "  # :startdoc:\n" ++
  "\n" ++
  "  # \\Class \\Net::HTTP provides a rich library that implements the client\n" ++
  "  # in a client-server model that uses the \\HTTP request-response protocol.\n" ++
  "  # For information about \\HTTP, see:\n" ++
  "  #\n" ++
  "  # - \{Hypertext Transfer Protocol\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol].\n" ++
  "  # - \{Technical overview\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol#Technical_overview].\n" ++
  "  #\n" ++
  "  # == About the Examples\n" ++
  "  #\n" ++
  "  # :include: doc/net-http/examples.rdoc\n" ++
  "  #\n" ++
  "  # == Strategies\n" ++
  "  #\n" ++
  "  # - If you will make only a few GET requests,\n" ++
  "  #   consider using \{OpenURI\}[rdoc-ref:OpenURI].\n" ++
  "  # - If you will make only a few requests of all kinds,\n" ++
  "  #   consider using the various singleton convenience methods in this class.\n" ++
  "  #   Each of the following methods automatically starts and finishes\n" ++
  "  #   a \{session\}[rdoc-ref:Net::HTTP@Sessions] that sends a single request:\n" ++
  "  #\n" ++
  "  #     # Return string response body.\n" ++
  "  #     Net::HTTP.get(hostname, path)\n" ++
  "  #     Net::HTTP.get(uri)\n" ++
  "  #\n" ++
  "  #     # Write string response body to $stdout.\n" ++
  "  #     Net::HTTP.get_print(hostname, path)\n" ++
  "  #     Net::HTTP.get_print(uri)\n" ++
  "  #\n" ++
  "  #     # Return response as Net::HTTPResponse object.\n" ++
  "  #     Net::HTTP.get_response(hostname, path)\n" ++
  "  #     Net::HTTP.get_response(uri)\n" ++
  "  #     data = '\{\"title\": \"foo\", \"body\": \"bar\", \"userId\": 1\}'\n" ++
  "  #     Net::HTTP.post(uri, data)\n" ++
  "  #     params = \{title: 'foo', body: 'bar', userId: 1\}\n" ++
  "  #     Net::HTTP.post_form(uri, params)\n" ++
  "  #     data = '\{\"title\": \"foo\", \"body\": \"bar\", \"userId\": 1\}'\n" ++
  "  #     Net::HTTP.put(uri, data)\n" ++
  "  #\n" ++
  "  # - If performance is important, consider using sessions, which lower request overhead.\n" ++
  "  #   This \{session\}[rdoc-ref:Net::HTTP@Sessions] has multiple requests for\n" ++
  "  #   \{HTTP methods\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol#Request_methods]\n" ++
  "  #   and \{WebDAV methods\}[https://en.wikipedia.org/wiki/WebDAV#Implementation]:\n" ++
  "  #\n" ++
  "  #     Net::HTTP.start(hostname) do |http|\n" ++
  "  #       # Session started automatically before block execution.\n" ++
  "  #       http.get(path)\n" ++
  "  #       http.head(path)\n" ++
  "  #       body = 'Some text'\n" ++
  "  #       http.post(path, body)  # Can also have a block.\n" ++
  "  #       http.put(path, body)\n" ++
  "  #       http.delete(path)\n" ++
  "  #       http.options(path)\n" ++
  "  #       http.trace(path)\n" ++
  "  #       http.patch(path, body) # Can also have a block.\n" ++
  "  #       http.copy(path)\n" ++
  "  #       http.lock(path, body)\n" ++
  "  #       http.mkcol(path, body)\n" ++
  "  #       http.move(path)\n" ++
  "  #       http.propfind(path, body)\n" ++
  "  #       http.proppatch(path, body)\n" ++
  "  #       http.unlock(path, body)\n" ++
  "  #       # Session finished automatically at block exit.\n" ++
  "  #     end\n" ++
  "  #\n" ++
  "  # The methods cited above are convenience methods that, via their few arguments,\n" ++
  "  # allow minimal control over the requests.\n" ++
  "  # For greater control, consider using \{request objects\}[rdoc-ref:Net::HTTPRequest].\n" ++
  "  #\n" ++
  "  # == URIs\n" ++
  "  #\n" ++
  "  # On the internet, a URI\n" ++
  "  # (\{Universal Resource Identifier\}[https://en.wikipedia.org/wiki/Uniform_Resource_Identifier])\n" ++
  "  # is a string that identifies a particular resource.\n" ++
  "  # It consists of some or all of: scheme, hostname, path, query, and fragment;\n" ++
  "  # see \{URI syntax\}[https://en.wikipedia.org/wiki/Uniform_Resource_Identifier#Syntax].\n" ++
  "  #\n" ++
  "  # A Ruby \{URI::Generic\}[rdoc-ref:URI::Generic] object\n" ++
  "  # represents an internet URI.\n" ++
  "  # It provides, among others, methods\n" ++
  "  # +scheme+, +hostname+, +path+, +query+, and +fragment+.\n" ++
  "  #\n" ++
  "  # === Schemes\n" ++
  "  #\n" ++
  "  # An internet \\URI has\n" ++
  "  # a \{scheme\}[https://en.wikipedia.org/wiki/List_of_URI_schemes].\n" ++
  "  #\n" ++
  "  # The two schemes supported in \\Net::HTTP are <tt>'https'</tt> and <tt>'http'</tt>:\n" ++
  "  #\n" ++
  "  #   uri.scheme                       # => \"https\"\n" ++
  "  #   URI('http://example.com').scheme # => \"http\"\n" ++
  "  #\n" ++
  "  # === Hostnames\n" ++
  "  #\n" ++
  "  # A hostname identifies a server (host) to which requests may be sent:\n" ++
  "  #\n" ++
  "  #   hostname = uri.hostname # => \"jsonplaceholder.typicode.com\"\n" ++
  "  #   Net::HTTP.start(hostname) do |http|\n" ++
  "  #     # Some HTTP stuff.\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # === Paths\n" ++
  "  #\n" ++
  "  # A host-specific path identifies a resource on the host:\n" ++
  "  #\n" ++
  "  #   _uri = uri.dup\n" ++
  "  #   _uri.path = '/todos/1'\n" ++
  "  #   hostname = _uri.hostname\n" ++
  "  #   path = _uri.path\n" ++
  "  #   Net::HTTP.get(hostname, path)\n" ++
  "  #\n" ++
  "  # === Queries\n" ++
  "  #\n" ++
  "  # A host-specific query adds name/value pairs to the URI:\n" ++
  "  #\n" ++
  "  #   _uri = uri.dup\n" ++
  "  #   params = \{userId: 1, completed: false\}\n" ++
  "  #   _uri.query = URI.encode_www_form(params)\n" ++
  "  #   _uri # => #<URI::HTTPS https://jsonplaceholder.typicode.com?userId=1&completed=false>\n" ++
  "  #   Net::HTTP.get(_uri)\n" ++
  "  #\n" ++
  "  # === Fragments\n" ++
  "  #\n" ++
  "  # A \{URI fragment\}[https://en.wikipedia.org/wiki/URI_fragment] has no effect\n" ++
  "  # in \\Net::HTTP;\n" ++
  "  # the same data is returned, regardless of whether a fragment is included.\n" ++
  "  #\n" ++
  "  # == Request Headers\n" ++
  "  #\n" ++
  "  # Request headers may be used to pass additional information to the host,\n" ++
  "  # similar to arguments passed in a method call;\n" ++
  "  # each header is a name/value pair.\n" ++
  "  #\n" ++
  "  # Each of the \\Net::HTTP methods that sends a request to the host\n" ++
  "  # has optional argument +headers+,\n" ++
  "  # where the headers are expressed as a hash of field-name/value pairs:\n" ++
  "  #\n" ++
  "  #   headers = \{Accept: 'application/json', Connection: 'Keep-Alive'\}\n" ++
  "  #   Net::HTTP.get(uri, headers)\n" ++
  "  #\n" ++
  "  # See lists of both standard request fields and common request fields at\n" ++
  "  # \{Request Fields\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#Request_fields].\n" ++
  "  # A host may also accept other custom fields.\n" ++
  "  #\n" ++
  "  # == \\HTTP Sessions\n" ++
  "  #\n" ++
  "  # A _session_ is a connection between a server (host) and a client that:\n" ++
  "  #\n" ++
  "  # - Is begun by instance method Net::HTTP#start.\n" ++
  "  # - May contain any number of requests.\n" ++
  "  # - Is ended by instance method Net::HTTP#finish.\n" ++
  "  #\n" ++
  "  # See example sessions at \{Strategies\}[rdoc-ref:Net::HTTP@Strategies].\n" ++
  "  #\n" ++
  "  # === Session Using \\Net::HTTP.start\n" ++
  "  #\n" ++
  "  # If you have many requests to make to a single host (and port),\n" ++
  "  # consider using singleton method Net::HTTP.start with a block;\n" ++
  "  # the method handles the session automatically by:\n" ++
  "  #\n" ++
  "  # - Calling #start before block execution.\n" ++
  "  # - Executing the block.\n" ++
  "  # - Calling #finish after block execution.\n" ++
  "  #\n" ++
  "  # In the block, you can use these instance methods,\n" ++
  "  # each of which that sends a single request:\n" ++
  "  #\n" ++
  "  # - \{HTTP methods\}[https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol#Request_methods]:\n" ++
  "  #\n" ++
  "  #   - #get, #request_get: GET.\n" ++
  "  #   - #head, #request_head: HEAD.\n" ++
  "  #   - #post, #request_post: POST.\n" ++
  "  #   - #delete: DELETE.\n" ++
  "  #   - #options: OPTIONS.\n" ++
  "  #   - #trace: TRACE.\n" ++
  "  #   - #patch: PATCH.\n" ++
  "  #\n" ++
  "  # - \{WebDAV methods\}[https://en.wikipedia.org/wiki/WebDAV#Implementation]:\n" ++
  "  #\n" ++
  "  #   - #copy: COPY.\n" ++
  "  #   - #lock: LOCK.\n" ++
  "  #   - #mkcol: MKCOL.\n" ++
  "  #   - #move: MOVE.\n" ++
  "  #   - #propfind: PROPFIND.\n" ++
  "  #   - #proppatch: PROPPATCH.\n" ++
  "  #   - #unlock: UNLOCK.\n" ++
  "  #\n" ++
  "  # === Session Using \\Net::HTTP.start and \\Net::HTTP.finish\n" ++
  "  #\n" ++
  "  # You can manage a session manually using methods #start and #finish:\n" ++
  "  #\n" ++
  "  #   http = Net::HTTP.new(hostname)\n" ++
  "  #   http.start\n" ++
  "  #   http.get('/todos/1')\n" ++
  "  #   http.get('/todos/2')\n" ++
  "  #   http.delete('/posts/1')\n" ++
  "  #   http.finish # Needed to free resources.\n" ++
  "  #\n" ++
  "  # === Single-Request Session\n" ++
  "  #\n" ++
  "  # Certain convenience methods automatically handle a session by:\n" ++
  "  #\n" ++
  "  # - Creating an \\HTTP object\n" ++
  "  # - Starting a session.\n" ++
  "  # - Sending a single request.\n" ++
  "  # - Finishing the session.\n" ++
  "  # - Destroying the object.\n" ++
  "  #\n" ++
  "  # Such methods that send GET requests:\n" ++
  "  #\n" ++
  "  # - ::get: Returns the string response body.\n" ++
  "  # - ::get_print: Writes the string response body to $stdout.\n" ++
  "  # - ::get_response: Returns a Net::HTTPResponse object.\n" ++
  "  #\n" ++
  "  # Such methods that send POST requests:\n" ++
  "  #\n" ++
  "  # - ::post: Posts data to the host.\n" ++
  "  # - ::post_form: Posts form data to the host.\n" ++
  "  #\n" ++
  "  # == \\HTTP Requests and Responses\n" ++
  "  #\n" ++
  "  # Many of the methods above are convenience methods,\n" ++
  "  # each of which sends a request and returns a string\n" ++
  "  # without directly using \\Net::HTTPRequest and \\Net::HTTPResponse objects.\n" ++
  "  #\n" ++
  "  # You can, however, directly create a request object, send the request,\n" ++
  "  # and retrieve the response object; see:\n" ++
  "  #\n" ++
  "  # - Net::HTTPRequest.\n" ++
  "  # - Net::HTTPResponse.\n" ++
  "  #\n" ++
  "  # == Following Redirection\n" ++
  "  #\n" ++
  "  # Each returned response is an instance of a subclass of Net::HTTPResponse.\n" ++
  "  # See the \{response class hierarchy\}[rdoc-ref:Net::HTTPResponse@Response+Subclasses].\n" ++
  "  #\n" ++
  "  # In particular, class Net::HTTPRedirection is the parent\n" ++
  "  # of all redirection classes.\n" ++
  "  # This allows you to craft a case statement to handle redirections properly:\n" ++
  "  #\n" ++
  "  #   def fetch(uri, limit = 10)\n" ++
  "  #     # You should choose a better exception.\n" ++
  "  #     raise ArgumentError, 'Too many HTTP redirects' if limit == 0\n" ++
  "  #\n" ++
  "  #     res = Net::HTTP.get_response(URI(uri))\n" ++
  "  #     case res\n" ++
  "  #     when Net::HTTPSuccess     # Any success class.\n" ++
  "  #       res\n" ++
  "  #     when Net::HTTPRedirection # Any redirection class.\n" ++
  "  #       location = res['Location']\n" ++
  "  #       warn \"Redirected to #\{location\}\"\n" ++
  "  #       fetch(location, limit - 1)\n" ++
  "  #     else                      # Any other class.\n" ++
  "  #       res.value\n" ++
  "  #     end\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  #   fetch(uri)\n" ++
  "  #\n" ++
  "  # == Basic Authentication\n" ++
  "  #\n" ++
  "  # Basic authentication is performed according to\n" ++
  "  # \{RFC2617\}[http://www.ietf.org/rfc/rfc2617.txt]:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.basic_auth('user', 'pass')\n" ++
  "  #   res = Net::HTTP.start(hostname) do |http|\n" ++
  "  #     http.request(req)\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # == Streaming Response Bodies\n" ++
  "  #\n" ++
  "  # By default \\Net::HTTP reads an entire response into memory.  If you are\n" ++
  "  # handling large files or wish to implement a progress bar you can instead\n" ++
  "  # stream the body directly to an IO.\n" ++
  "  #\n" ++
  "  #   Net::HTTP.start(hostname) do |http|\n" ++
  "  #     req = Net::HTTP::Get.new(uri)\n" ++
  "  #     http.request(req) do |res|\n" ++
  "  #       open('t.tmp', 'w') do |f|\n" ++
  "  #         res.read_body do |chunk|\n" ++
  "  #           f.write chunk\n" ++
  "  #         end\n" ++
  "  #       end\n" ++
  "  #     end\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # == HTTPS\n" ++
  "  #\n" ++
  "  # HTTPS is enabled for an \\HTTP connection by Net::HTTP#use_ssl=:\n" ++
  "  #\n" ++
  "  #   Net::HTTP.start(hostname, :use_ssl => true) do |http|\n" ++
  "  #     req = Net::HTTP::Get.new(uri)\n" ++
  "  #     res = http.request(req)\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Or if you simply want to make a GET request, you may pass in a URI\n" ++
  "  # object that has an \\HTTPS URL. \\Net::HTTP automatically turns on TLS\n" ++
  "  # verification if the URI object has a 'https' URI scheme:\n" ++
  "  #\n" ++
  "  #   uri # => #<URI::HTTPS https://jsonplaceholder.typicode.com/>\n" ++
  "  #   Net::HTTP.get(uri)\n" ++
  "  #\n" ++
  "  # == Proxy Server\n" ++
  "  #\n" ++
  "  # An \\HTTP object can have\n" ++
  "  # a \{proxy server\}[https://en.wikipedia.org/wiki/Proxy_server].\n" ++
  "  #\n" ++
  "  # You can create an \\HTTP object with a proxy server\n" ++
  "  # using method Net::HTTP.new or method Net::HTTP.start.\n" ++
  "  #\n" ++
  "  # The proxy may be defined either by argument +p_addr+\n" ++
  "  # or by environment variable <tt>'http_proxy'</tt>.\n" ++
  "  #\n" ++
  "  # === Proxy Using Argument +p_addr+ as a \\String\n" ++
  "  #\n" ++
  "  # When argument +p_addr+ is a string hostname,\n" ++
  "  # the returned +http+ has the given host as its proxy:\n" ++
  "  #\n" ++
  "  #   http = Net::HTTP.new(hostname, nil, 'proxy.example')\n" ++
  "  #   http.proxy?          # => true\n" ++
  "  #   http.proxy_from_env? # => false\n" ++
  "  #   http.proxy_address   # => \"proxy.example\"\n" ++
  "  #   # These use default values.\n" ++
  "  #   http.proxy_port      # => 80\n" ++
  "  #   http.proxy_user      # => nil\n" ++
  "  #   http.proxy_pass      # => nil\n" ++
  "  #\n" ++
  "  # The port, username, and password for the proxy may also be given:\n" ++
  "  #\n" ++
  "  #   http = Net::HTTP.new(hostname, nil, 'proxy.example', 8000, 'pname', 'ppass')\n" ++
  "  #   # => #<Net::HTTP jsonplaceholder.typicode.com:80 open=false>\n" ++
  "  #   http.proxy?          # => true\n" ++
  "  #   http.proxy_from_env? # => false\n" ++
  "  #   http.proxy_address   # => \"proxy.example\"\n" ++
  "  #   http.proxy_port      # => 8000\n" ++
  "  #   http.proxy_user      # => \"pname\"\n" ++
  "  #   http.proxy_pass      # => \"ppass\"\n" ++
  "  #\n" ++
  "  # === Proxy Using '<tt>ENV['http_proxy']</tt>'\n" ++
  "  #\n" ++
  "  # When environment variable <tt>'http_proxy'</tt>\n" ++
  "  # is set to a \\URI string,\n" ++
  "  # the returned +http+ will have the server at that URI as its proxy;\n" ++
  "  # note that the \\URI string must have a protocol\n" ++
  "  # such as <tt>'http'</tt> or <tt>'https'</tt>:\n" ++
  "  #\n" ++
  "  #   ENV['http_proxy'] = 'http://example.com'\n" ++
  "  #   http = Net::HTTP.new(hostname)\n" ++
  "  #   http.proxy?          # => true\n" ++
  "  #   http.proxy_from_env? # => true\n" ++
  "  #   http.proxy_address   # => \"example.com\"\n" ++
  "  #   # These use default values.\n" ++
  "  #   http.proxy_port      # => 80\n" ++
  "  #   http.proxy_user      # => nil\n" ++
  "  #   http.proxy_pass      # => nil\n" ++
  "  #\n" ++
  "  # The \\URI string may include proxy username, password, and port number:\n" ++
  "  #\n" ++
  "  #   ENV['http_proxy'] = 'http://pname:ppass@example.com:8000'\n" ++
  "  #   http = Net::HTTP.new(hostname)\n" ++
  "  #   http.proxy?          # => true\n" ++
  "  #   http.proxy_from_env? # => true\n" ++
  "  #   http.proxy_address   # => \"example.com\"\n" ++
  "  #   http.proxy_port      # => 8000\n" ++
  "  #   http.proxy_user      # => \"pname\"\n" ++
  "  #   http.proxy_pass      # => \"ppass\"\n" ++
  "  #\n" ++
  "  # === Filtering Proxies\n" ++
  "  #\n" ++
  "  # With method Net::HTTP.new (but not Net::HTTP.start),\n" ++
  "  # you can use argument +p_no_proxy+ to filter proxies:\n" ++
  "  #\n" ++
  "  # - Reject a certain address:\n" ++
  "  #\n" ++
  "  #     http = Net::HTTP.new('example.com', nil, 'proxy.example', 8000, 'pname', 'ppass', 'proxy.example')\n" ++
  "  #     http.proxy_address # => nil\n" ++
  "  #\n" ++
  "  # - Reject certain domains or subdomains:\n" ++
  "  #\n" ++
  "  #     http = Net::HTTP.new('example.com', nil, 'my.proxy.example', 8000, 'pname', 'ppass', 'proxy.example')\n" ++
  "  #     http.proxy_address # => nil\n" ++
  "  #\n" ++
  "  # - Reject certain addresses and port combinations:\n" ++
  "  #\n" ++
  "  #     http = Net::HTTP.new('example.com', nil, 'proxy.example', 8000, 'pname', 'ppass', 'proxy.example:1234')\n" ++
  "  #     http.proxy_address # => \"proxy.example\"\n" ++
  "  #\n" ++
  "  #     http = Net::HTTP.new('example.com', nil, 'proxy.example', 8000, 'pname', 'ppass', 'proxy.example:8000')\n" ++
  "  #     http.proxy_address # => nil\n" ++
  "  #\n" ++
  "  # - Reject a list of the types above delimited using a comma:\n" ++
  "  #\n" ++
  "  #     http = Net::HTTP.new('example.com', nil, 'proxy.example', 8000, 'pname', 'ppass', 'my.proxy,proxy.example:8000')\n" ++
  "  #     http.proxy_address # => nil\n" ++
  "  #\n" ++
  "  #     http = Net::HTTP.new('example.com', nil, 'my.proxy', 8000, 'pname', 'ppass', 'my.proxy,proxy.example:8000')\n" ++
  "  #     http.proxy_address # => nil\n" ++
  "  #\n" ++
  "  # == Compression and Decompression\n" ++
  "  #\n" ++
  "  # \\Net::HTTP does not compress the body of a request before sending.\n" ++
  "  #\n" ++
  "  # By default, \\Net::HTTP adds header <tt>'Accept-Encoding'</tt>\n" ++
  "  # to a new \{request object\}[rdoc-ref:Net::HTTPRequest]:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Get.new(uri)['Accept-Encoding']\n" ++
  "  #   # => \"gzip;q=1.0,deflate;q=0.6,identity;q=0.3\"\n" ++
  "  #\n" ++
  "  # This requests the server to zip-encode the response body if there is one;\n" ++
  "  # the server is not required to do so.\n" ++
  "  #\n" ++
  "  # \\Net::HTTP does not automatically decompress a response body\n" ++
  "  # if the response has header <tt>'Content-Range'</tt>.\n" ++
  "  #\n" ++
  "  # Otherwise decompression (or not) depends on the value of header\n" ++
  "  # \{Content-Encoding\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-encoding-response-header]:\n" ++
  "  #\n" ++
  "  # - <tt>'deflate'</tt>, <tt>'gzip'</tt>, or <tt>'x-gzip'</tt>:\n" ++
  "  #   decompresses the body and deletes the header.\n" ++
  "  # - <tt>'none'</tt> or <tt>'identity'</tt>:\n" ++
  "  #   does not decompress the body, but deletes the header.\n" ++
  "  # - Any other value:\n" ++
  "  #   leaves the body and header unchanged.\n" ++
  "  #\n" ++
  "  # == What's Here\n" ++
  "  #\n" ++
  "  # First, what's elsewhere. Class Net::HTTP:\n" ++
  "  #\n" ++
  "  # - Inherits from \{class Object\}[rdoc-ref:Object@What-27s+Here].\n" ++
  "  #\n" ++
  "  # This is a categorized summary of methods and attributes.\n" ++
  "  #\n" ++
  "  # === \\Net::HTTP Objects\n" ++
  "  #\n" ++
  "  # - \{::new\}[rdoc-ref:Net::HTTP.new]:\n" ++
  "  #   Creates a new instance.\n" ++
  "  # - \{#inspect\}[rdoc-ref:Net::HTTP#inspect]:\n" ++
  "  #   Returns a string representation of +self+.\n" ++
  "  #\n" ++
  "  # === Sessions\n" ++
  "  #\n" ++
  "  # - \{::start\}[rdoc-ref:Net::HTTP.start]:\n" ++
  "  #   Begins a new session in a new \\Net::HTTP object.\n" ++
  "  # - \{#started?\}[rdoc-ref:Net::HTTP#started?]:\n" ++
  "  #   Returns whether in a session.\n" ++
  "  # - \{#finish\}[rdoc-ref:Net::HTTP#finish]:\n" ++
  "  #   Ends an active session.\n" ++
  "  # - \{#start\}[rdoc-ref:Net::HTTP#start]:\n" ++
  "  #   Begins a new session in an existing \\Net::HTTP object (+self+).\n" ++
  "  #\n" ++
  "  # === Connections\n" ++
  "  #\n" ++
  "  # - \{:continue_timeout\}[rdoc-ref:Net::HTTP#continue_timeout]:\n" ++
  "  #   Returns the continue timeout.\n" ++
  "  # - \{#continue_timeout=\}[rdoc-ref:Net::HTTP#continue_timeout=]:\n" ++
  "  #   Sets the continue timeout seconds.\n" ++
  "  # - \{:keep_alive_timeout\}[rdoc-ref:Net::HTTP#keep_alive_timeout]:\n" ++
  "  #   Returns the keep-alive timeout.\n" ++
  "  # - \{:keep_alive_timeout=\}[rdoc-ref:Net::HTTP#keep_alive_timeout=]:\n" ++
  "  #   Sets the keep-alive timeout.\n" ++
  "  # - \{:max_retries\}[rdoc-ref:Net::HTTP#max_retries]:\n" ++
  "  #   Returns the maximum retries.\n" ++
  "  # - \{#max_retries=\}[rdoc-ref:Net::HTTP#max_retries=]:\n" ++
  "  #   Sets the maximum retries.\n" ++
  "  # - \{:open_timeout\}[rdoc-ref:Net::HTTP#open_timeout]:\n" ++
  "  #   Returns the open timeout.\n" ++
  "  # - \{:open_timeout=\}[rdoc-ref:Net::HTTP#open_timeout=]:\n" ++
  "  #   Sets the open timeout.\n" ++
  "  # - \{:read_timeout\}[rdoc-ref:Net::HTTP#read_timeout]:\n" ++
  "  #   Returns the open timeout.\n" ++
  "  # - \{:read_timeout=\}[rdoc-ref:Net::HTTP#read_timeout=]:\n" ++
  "  #   Sets the read timeout.\n" ++
  "  # - \{:ssl_timeout\}[rdoc-ref:Net::HTTP#ssl_timeout]:\n" ++
  "  #   Returns the ssl timeout.\n" ++
  "  # - \{:ssl_timeout=\}[rdoc-ref:Net::HTTP#ssl_timeout=]:\n" ++
  "  #   Sets the ssl timeout.\n" ++
  "  # - \{:write_timeout\}[rdoc-ref:Net::HTTP#write_timeout]:\n" ++
  "  #   Returns the write timeout.\n" ++
  "  # - \{write_timeout=\}[rdoc-ref:Net::HTTP#write_timeout=]:\n" ++
  "  #   Sets the write timeout.\n" ++
  "  #\n" ++
  "  # === Requests\n" ++
  "  #\n" ++
  "  # - \{::get\}[rdoc-ref:Net::HTTP.get]:\n" ++
  "  #   Sends a GET request and returns the string response body.\n" ++
  "  # - \{::get_print\}[rdoc-ref:Net::HTTP.get_print]:\n" ++
  "  #   Sends a GET request and write the string response body to $stdout.\n" ++
  "  # - \{::get_response\}[rdoc-ref:Net::HTTP.get_response]:\n" ++
  "  #   Sends a GET request and returns a response object.\n" ++
  "  # - \{::post_form\}[rdoc-ref:Net::HTTP.post_form]:\n" ++
  "  #   Sends a POST request with form data and returns a response object.\n" ++
  "  # - \{::post\}[rdoc-ref:Net::HTTP.post]:\n" ++
  "  #   Sends a POST request with data and returns a response object.\n" ++
  "  # - \{::put\}[rdoc-ref:Net::HTTP.put]:\n" ++
  "  #   Sends a PUT request with data and returns a response object.\n" ++
  "  # - \{#copy\}[rdoc-ref:Net::HTTP#copy]:\n" ++
  "  #   Sends a COPY request and returns a response object.\n" ++
  "  # - \{#delete\}[rdoc-ref:Net::HTTP#delete]:\n" ++
  "  #   Sends a DELETE request and returns a response object.\n" ++
  "  # - \{#get\}[rdoc-ref:Net::HTTP#get]:\n" ++
  "  #   Sends a GET request and returns a response object.\n" ++
  "  # - \{#head\}[rdoc-ref:Net::HTTP#head]:\n" ++
  "  #   Sends a HEAD request and returns a response object.\n" ++
  "  # - \{#lock\}[rdoc-ref:Net::HTTP#lock]:\n" ++
  "  #   Sends a LOCK request and returns a response object.\n" ++
  "  # - \{#mkcol\}[rdoc-ref:Net::HTTP#mkcol]:\n" ++
  "  #   Sends a MKCOL request and returns a response object.\n" ++
  "  # - \{#move\}[rdoc-ref:Net::HTTP#move]:\n" ++
  "  #   Sends a MOVE request and returns a response object.\n" ++
  "  # - \{#options\}[rdoc-ref:Net::HTTP#options]:\n" ++
  "  #   Sends a OPTIONS request and returns a response object.\n" ++
  "  # - \{#patch\}[rdoc-ref:Net::HTTP#patch]:\n" ++
  "  #   Sends a PATCH request and returns a response object.\n" ++
  "  # - \{#post\}[rdoc-ref:Net::HTTP#post]:\n" ++
  "  #   Sends a POST request and returns a response object.\n" ++
  "  # - \{#propfind\}[rdoc-ref:Net::HTTP#propfind]:\n" ++
  "  #   Sends a PROPFIND request and returns a response object.\n" ++
  "  # - \{#proppatch\}[rdoc-ref:Net::HTTP#proppatch]:\n" ++
  "  #   Sends a PROPPATCH request and returns a response object.\n" ++
  "  # - \{#put\}[rdoc-ref:Net::HTTP#put]:\n" ++
  "  #   Sends a PUT request and returns a response object.\n" ++
  "  # - \{#request\}[rdoc-ref:Net::HTTP#request]:\n" ++
  "  #   Sends a request and returns a response object.\n" ++
  "  # - \{#request_get\}[rdoc-ref:Net::HTTP#request_get]:\n" ++
  "  #   Sends a GET request and forms a response object;\n" ++
  "  #   if a block given, calls the block with the object,\n" ++
  "  #   otherwise returns the object.\n" ++
  "  # - \{#request_head\}[rdoc-ref:Net::HTTP#request_head]:\n" ++
  "  #   Sends a HEAD request and forms a response object;\n" ++
  "  #   if a block given, calls the block with the object,\n" ++
  "  #   otherwise returns the object.\n" ++
  "  # - \{#request_post\}[rdoc-ref:Net::HTTP#request_post]:\n" ++
  "  #   Sends a POST request and forms a response object;\n" ++
  "  #   if a block given, calls the block with the object,\n" ++
  "  #   otherwise returns the object.\n" ++
  "  # - \{#send_request\}[rdoc-ref:Net::HTTP#send_request]:\n" ++
  "  #   Sends a request and returns a response object.\n" ++
  "  # - \{#trace\}[rdoc-ref:Net::HTTP#trace]:\n" ++
  "  #   Sends a TRACE request and returns a response object.\n" ++
  "  # - \{#unlock\}[rdoc-ref:Net::HTTP#unlock]:\n" ++
  "  #   Sends an UNLOCK request and returns a response object.\n" ++
  "  #\n" ++
  "  # === Responses\n" ++
  "  #\n" ++
  "  # - \{:close_on_empty_response\}[rdoc-ref:Net::HTTP#close_on_empty_response]:\n" ++
  "  #   Returns whether to close connection on empty response.\n" ++
  "  # - \{:close_on_empty_response=\}[rdoc-ref:Net::HTTP#close_on_empty_response=]:\n" ++
  "  #   Sets whether to close connection on empty response.\n" ++
  "  # - \{:ignore_eof\}[rdoc-ref:Net::HTTP#ignore_eof]:\n" ++
  "  #   Returns whether to ignore end-of-file when reading a response body\n" ++
  "  #   with <tt>Content-Length</tt> headers.\n" ++
  "  # - \{:ignore_eof=\}[rdoc-ref:Net::HTTP#ignore_eof=]:\n" ++
  "  #   Sets whether to ignore end-of-file when reading a response body\n" ++
  "  #   with <tt>Content-Length</tt> headers.\n" ++
  "  # - \{:response_body_encoding\}[rdoc-ref:Net::HTTP#response_body_encoding]:\n" ++
  "  #   Returns the encoding to use for the response body.\n" ++
  "  # - \{#response_body_encoding=\}[rdoc-ref:Net::HTTP#response_body_encoding=]:\n" ++
  "  #   Sets the response body encoding.\n" ++
  "  #\n" ++
  "  # === Proxies\n" ++
  "  #\n" ++
  "  # - \{:proxy_address\}[rdoc-ref:Net::HTTP#proxy_address]:\n" ++
  "  #   Returns the proxy address.\n" ++
  "  # - \{:proxy_address=\}[rdoc-ref:Net::HTTP#proxy_address=]:\n" ++
  "  #   Sets the proxy address.\n" ++
  "  # - \{::proxy_class?\}[rdoc-ref:Net::HTTP.proxy_class?]:\n" ++
  "  #   Returns whether +self+ is a proxy class.\n" ++
  "  # - \{#proxy?\}[rdoc-ref:Net::HTTP#proxy?]:\n" ++
  "  #   Returns whether +self+ has a proxy.\n" ++
  "  # - \{#proxy_address\}[rdoc-ref:Net::HTTP#proxy_address]:\n" ++
  "  #   Returns the proxy address.\n" ++
  "  # - \{#proxy_from_env?\}[rdoc-ref:Net::HTTP#proxy_from_env?]:\n" ++
  "  #   Returns whether the proxy is taken from an environment variable.\n" ++
  "  # - \{:proxy_from_env=\}[rdoc-ref:Net::HTTP#proxy_from_env=]:\n" ++
  "  #   Sets whether the proxy is to be taken from an environment variable.\n" ++
  "  # - \{:proxy_pass\}[rdoc-ref:Net::HTTP#proxy_pass]:\n" ++
  "  #   Returns the proxy password.\n" ++
  "  # - \{:proxy_pass=\}[rdoc-ref:Net::HTTP#proxy_pass=]:\n" ++
  "  #   Sets the proxy password.\n" ++
  "  # - \{:proxy_port\}[rdoc-ref:Net::HTTP#proxy_port]:\n" ++
  "  #   Returns the proxy port.\n" ++
  "  # - \{:proxy_port=\}[rdoc-ref:Net::HTTP#proxy_port=]:\n" ++
  "  #   Sets the proxy port.\n" ++
  "  # - \{#proxy_user\}[rdoc-ref:Net::HTTP#proxy_user]:\n" ++
  "  #   Returns the proxy user name.\n" ++
  "  # - \{:proxy_user=\}[rdoc-ref:Net::HTTP#proxy_user=]:\n" ++
  "  #   Sets the proxy user.\n" ++
  "  #\n" ++
  "  # === Security\n" ++
  "  #\n" ++
  "  # - \{:ca_file\}[rdoc-ref:Net::HTTP#ca_file]:\n" ++
  "  #   Returns the path to a CA certification file.\n" ++
  "  # - \{:ca_file=\}[rdoc-ref:Net::HTTP#ca_file=]:\n" ++
  "  #   Sets the path to a CA certification file.\n" ++
  "  # - \{:ca_path\}[rdoc-ref:Net::HTTP#ca_path]:\n" ++
  "  #   Returns the path of to CA directory containing certification files.\n" ++
  "  # - \{:ca_path=\}[rdoc-ref:Net::HTTP#ca_path=]:\n" ++
  "  #   Sets the path of to CA directory containing certification files.\n" ++
  "  # - \{:cert\}[rdoc-ref:Net::HTTP#cert]:\n" ++
  "  #   Returns the OpenSSL::X509::Certificate object to be used for client certification.\n" ++
  "  # - \{:cert=\}[rdoc-ref:Net::HTTP#cert=]:\n" ++
  "  #   Sets the OpenSSL::X509::Certificate object to be used for client certification.\n" ++
  "  # - \{:cert_store\}[rdoc-ref:Net::HTTP#cert_store]:\n" ++
  "  #   Returns the X509::Store to be used for verifying peer certificate.\n" ++
  "  # - \{:cert_store=\}[rdoc-ref:Net::HTTP#cert_store=]:\n" ++
  "  #   Sets the X509::Store to be used for verifying peer certificate.\n" ++
  "  # - \{:ciphers\}[rdoc-ref:Net::HTTP#ciphers]:\n" ++
  "  #   Returns the available SSL ciphers.\n" ++
  "  # - \{:ciphers=\}[rdoc-ref:Net::HTTP#ciphers=]:\n" ++
  "  #   Sets the available SSL ciphers.\n" ++
  "  # - \{:extra_chain_cert\}[rdoc-ref:Net::HTTP#extra_chain_cert]:\n" ++
  "  #   Returns the extra X509 certificates to be added to the certificate chain.\n" ++
  "  # - \{:extra_chain_cert=\}[rdoc-ref:Net::HTTP#extra_chain_cert=]:\n" ++
  "  #   Sets the extra X509 certificates to be added to the certificate chain.\n" ++
  "  # - \{:key\}[rdoc-ref:Net::HTTP#key]:\n" ++
  "  #   Returns the OpenSSL::PKey::RSA or OpenSSL::PKey::DSA object.\n" ++
  "  # - \{:key=\}[rdoc-ref:Net::HTTP#key=]:\n" ++
  "  #   Sets the OpenSSL::PKey::RSA or OpenSSL::PKey::DSA object.\n" ++
  "  # - \{:max_version\}[rdoc-ref:Net::HTTP#max_version]:\n" ++
  "  #   Returns the maximum SSL version.\n" ++
  "  # - \{:max_version=\}[rdoc-ref:Net::HTTP#max_version=]:\n" ++
  "  #   Sets the maximum SSL version.\n" ++
  "  # - \{:min_version\}[rdoc-ref:Net::HTTP#min_version]:\n" ++
  "  #   Returns the minimum SSL version.\n" ++
  "  # - \{:min_version=\}[rdoc-ref:Net::HTTP#min_version=]:\n" ++
  "  #   Sets the minimum SSL version.\n" ++
  "  # - \{#peer_cert\}[rdoc-ref:Net::HTTP#peer_cert]:\n" ++
  "  #   Returns the X509 certificate chain for the session's socket peer.\n" ++
  "  # - \{:ssl_version\}[rdoc-ref:Net::HTTP#ssl_version]:\n" ++
  "  #   Returns the SSL version.\n" ++
  "  # - \{:ssl_version=\}[rdoc-ref:Net::HTTP#ssl_version=]:\n" ++
  "  #   Sets the SSL version.\n" ++
  "  # - \{#use_ssl=\}[rdoc-ref:Net::HTTP#use_ssl=]:\n" ++
  "  #   Sets whether a new session is to use Transport Layer Security.\n" ++
  "  # - \{#use_ssl?\}[rdoc-ref:Net::HTTP#use_ssl?]:\n" ++
  "  #   Returns whether +self+ uses SSL.\n" ++
  "  # - \{:verify_callback\}[rdoc-ref:Net::HTTP#verify_callback]:\n" ++
  "  #   Returns the callback for the server certification verification.\n" ++
  "  # - \{:verify_callback=\}[rdoc-ref:Net::HTTP#verify_callback=]:\n" ++
  "  #   Sets the callback for the server certification verification.\n" ++
  "  # - \{:verify_depth\}[rdoc-ref:Net::HTTP#verify_depth]:\n" ++
  "  #   Returns the maximum depth for the certificate chain verification.\n" ++
  "  # - \{:verify_depth=\}[rdoc-ref:Net::HTTP#verify_depth=]:\n" ++
  "  #   Sets the maximum depth for the certificate chain verification.\n" ++
  "  # - \{:verify_hostname\}[rdoc-ref:Net::HTTP#verify_hostname]:\n" ++
  "  #   Returns the flags for server the certification verification at the beginning of the SSL/TLS session.\n" ++
  "  # - \{:verify_hostname=\}[rdoc-ref:Net::HTTP#verify_hostname=]:\n" ++
  "  #   Sets he flags for server the certification verification at the beginning of the SSL/TLS session.\n" ++
  "  # - \{:verify_mode\}[rdoc-ref:Net::HTTP#verify_mode]:\n" ++
  "  #   Returns the flags for server the certification verification at the beginning of the SSL/TLS session.\n" ++
  "  # - \{:verify_mode=\}[rdoc-ref:Net::HTTP#verify_mode=]:\n" ++
  "  #   Sets the flags for server the certification verification at the beginning of the SSL/TLS session.\n" ++
  "  #\n" ++
  "  # === Addresses and Ports\n" ++
  "  #\n" ++
  "  # - \{:address\}[rdoc-ref:Net::HTTP#address]:\n" ++
  "  #   Returns the string host name or host IP.\n" ++
  "  # - \{::default_port\}[rdoc-ref:Net::HTTP.default_port]:\n" ++
  "  #   Returns integer 80, the default port to use for HTTP requests.\n" ++
  "  # - \{::http_default_port\}[rdoc-ref:Net::HTTP.http_default_port]:\n" ++
  "  #   Returns integer 80, the default port to use for HTTP requests.\n" ++
  "  # - \{::https_default_port\}[rdoc-ref:Net::HTTP.https_default_port]:\n" ++
  "  #   Returns integer 443, the default port to use for HTTPS requests.\n" ++
  "  # - \{#ipaddr\}[rdoc-ref:Net::HTTP#ipaddr]:\n" ++
  "  #   Returns the IP address for the connection.\n" ++
  "  # - \{#ipaddr=\}[rdoc-ref:Net::HTTP#ipaddr=]:\n" ++
  "  #   Sets the IP address for the connection.\n" ++
  "  # - \{:local_host\}[rdoc-ref:Net::HTTP#local_host]:\n" ++
  "  #   Returns the string local host used to establish the connection.\n" ++
  "  # - \{:local_host=\}[rdoc-ref:Net::HTTP#local_host=]:\n" ++
  "  #   Sets the string local host used to establish the connection.\n" ++
  "  # - \{:local_port\}[rdoc-ref:Net::HTTP#local_port]:\n" ++
  "  #   Returns the integer local port used to establish the connection.\n" ++
  "  # - \{:local_port=\}[rdoc-ref:Net::HTTP#local_port=]:\n" ++
  "  #   Sets the integer local port used to establish the connection.\n" ++
  "  # - \{:port\}[rdoc-ref:Net::HTTP#port]:\n" ++
  "  #   Returns the integer port number.\n" ++
  "  #\n" ++
  "  # === \\HTTP Version\n" ++
  "  #\n" ++
  "  # - \{::version_1_2?\}[rdoc-ref:Net::HTTP.version_1_2?]\n" ++
  "  #   (aliased as \{::version_1_2\}[rdoc-ref:Net::HTTP.version_1_2]):\n" ++
  "  #   Returns true; retained for compatibility.\n" ++
  "  #\n" ++
  "  # === Debugging\n" ++
  "  #\n" ++
  "  # - \{#set_debug_output\}[rdoc-ref:Net::HTTP#set_debug_output]:\n" ++
  "  #   Sets the output stream for debugging.\n" ++
  "  #\n" ++
  "  class HTTP < Protocol\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "    VERSION = \"0.9.1\"\n" ++
  "    HTTPVersion = '1.1'\n" ++
  "    begin\n" ++
  "      require 'zlib'\n" ++
  "      HAVE_ZLIB=true\n" ++
  "    rescue LoadError\n" ++
  "      HAVE_ZLIB=false\n" ++
  "    end\n" ++
  "    # :startdoc:\n" ++
  "\n" ++
  "    # Returns +true+; retained for compatibility.\n" ++
  "    def HTTP.version_1_2\n" ++
  "      true\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns +true+; retained for compatibility.\n" ++
  "    def HTTP.version_1_2?\n" ++
  "      true\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns +false+; retained for compatibility.\n" ++
  "    def HTTP.version_1_1?  #:nodoc:\n" ++
  "      false\n" ++
  "    end\n" ++
  "\n" ++
  "    class << HTTP\n" ++
  "      alias is_version_1_1? version_1_1?   #:nodoc:\n" ++
  "      alias is_version_1_2? version_1_2?   #:nodoc:\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #   Net::HTTP.get_print(hostname, path, port = 80) -> nil\n" ++
  "    #   Net::HTTP:get_print(uri, headers = \{\}, port = uri.port) -> nil\n" ++
  "    #\n" ++
  "    # Like Net::HTTP.get, but writes the returned body to $stdout;\n" ++
  "    # returns +nil+.\n" ++
  "    def HTTP.get_print(uri_or_host, path_or_headers = nil, port = nil)\n" ++
  "      get_response(uri_or_host, path_or_headers, port) \{|res|\n" ++
  "        res.read_body do |chunk|\n" ++
  "          $stdout.print chunk\n" ++
  "        end\n" ++
  "      \}\n" ++
  "      nil\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #   Net::HTTP.get(hostname, path, port = 80) -> body\n" ++
  "    #   Net::HTTP:get(uri, headers = \{\}, port = uri.port) -> body\n" ++
  "    #\n" ++
  "    # Sends a GET request and returns the \\HTTP response body as a string.\n" ++
  "    #\n" ++
  "    # With string arguments +hostname+ and +path+:\n" ++
  "    #\n" ++
  "    #   hostname = 'jsonplaceholder.typicode.com'\n" ++
  "    #   path = '/todos/1'\n" ++
  "    #   puts Net::HTTP.get(hostname, path)\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \{\n" ++
  "    #     \"userId\": 1,\n" ++
  "    #     \"id\": 1,\n" ++
  "    #     \"title\": \"delectus aut autem\",\n" ++
  "    #     \"completed\": false\n" ++
  "    #   \}\n" ++
  "    #\n" ++
  "    # With URI object +uri+ and optional hash argument +headers+:\n" ++
  "    #\n" ++
  "    #   uri = URI('https://jsonplaceholder.typicode.com/todos/1')\n" ++
  "    #   headers = \{'Content-type' => 'application/json; charset=UTF-8'\}\n" ++
  "    #   Net::HTTP.get(uri, headers)\n" ++
  "    #\n" ++
  "    # Related:\n" ++
  "    #\n" ++
  "    # - Net::HTTP::Get: request class for \\HTTP method +GET+.\n" ++
  "    # - Net::HTTP#get: convenience method for \\HTTP method +GET+.\n" ++
  "    #\n" ++
  "    def HTTP.get(uri_or_host, path_or_headers = nil, port = nil)\n" ++
  "      get_response(uri_or_host, path_or_headers, port).body\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #   Net::HTTP.get_response(hostname, path, port = 80) -> http_response\n" ++
  "    #   Net::HTTP:get_response(uri, headers = \{\}, port = uri.port) -> http_response\n" ++
  "    #\n" ++
  "    # Like Net::HTTP.get, but returns a Net::HTTPResponse object\n" ++
  "    # instead of the body string.\n" ++
  "    def HTTP.get_response(uri_or_host, path_or_headers = nil, port = nil, &block)\n" ++
  "      if path_or_headers && !path_or_headers.is_a?(Hash)\n" ++
  "        host = uri_or_host\n" ++
  "        path = path_or_headers\n" ++
  "        new(host, port || HTTP.default_port).start \{|http|\n" ++
  "          return http.request_get(path, &block)\n" ++
  "        \}\n" ++
  "      else\n" ++
  "        uri = uri_or_host\n" ++
  "        headers = path_or_headers\n" ++
  "        start(uri.hostname, uri.port,\n" ++
  "              :use_ssl => uri.scheme == 'https') \{|http|\n" ++
  "          return http.request_get(uri, headers, &block)\n" ++
  "        \}\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Posts data to a host; returns a Net::HTTPResponse object.\n" ++
  "    #\n" ++
  "    # Argument +url+ must be a URL;\n" ++
  "    # argument +data+ must be a string:\n" ++
  "    #\n" ++
  "    #   _uri = uri.dup\n" ++
  "    #   _uri.path = '/posts'\n" ++
  "    #   data = '\{\"title\": \"foo\", \"body\": \"bar\", \"userId\": 1\}'\n" ++
  "    #   headers = \{'content-type': 'application/json'\}\n" ++
  "    #   res = Net::HTTP.post(_uri, data, headers) # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #   puts res.body\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \{\n" ++
  "    #     \"title\": \"foo\",\n" ++
  "    #     \"body\": \"bar\",\n" ++
  "    #     \"userId\": 1,\n" ++
  "    #     \"id\": 101\n" ++
  "    #   \}\n" ++
  "    #\n" ++
  "    # Related:\n" ++
  "    #\n" ++
  "    # - Net::HTTP::Post: request class for \\HTTP method +POST+.\n" ++
  "    # - Net::HTTP#post: convenience method for \\HTTP method +POST+.\n" ++
  "    #\n" ++
  "    def HTTP.post(url, data, header = nil)\n" ++
  "      start(url.hostname, url.port,\n" ++
  "            :use_ssl => url.scheme == 'https' ) \{|http|\n" ++
  "        http.post(url, data, header)\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    # Posts data to a host; returns a Net::HTTPResponse object.\n" ++
  "    #\n" ++
  "    # Argument +url+ must be a URI;\n" ++
  "    # argument +data+ must be a hash:\n" ++
  "    #\n" ++
  "    #   _uri = uri.dup\n" ++
  "    #   _uri.path = '/posts'\n" ++
  "    #   data = \{title: 'foo', body: 'bar', userId: 1\}\n" ++
  "    #   res = Net::HTTP.post_form(_uri, data) # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #   puts res.body\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \{\n" ++
  "    #     \"title\": \"foo\",\n" ++
  "    #     \"body\": \"bar\",\n" ++
  "    #     \"userId\": \"1\",\n" ++
  "    #     \"id\": 101\n" ++
  "    #   \}\n" ++
  "    #\n" ++
  "    def HTTP.post_form(url, params)\n" ++
  "      req = Post.new(url)\n" ++
  "      req.form_data = params\n" ++
  "      req.basic_auth url.user, url.password if url.user\n" ++
  "      start(url.hostname, url.port,\n" ++
  "            :use_ssl => url.scheme == 'https' ) \{|http|\n" ++
  "        http.request(req)\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a PUT request to the server; returns a Net::HTTPResponse object.\n" ++
  "    #\n" ++
  "    # Argument +url+ must be a URL;\n" ++
  "    # argument +data+ must be a string:\n" ++
  "    #\n" ++
  "    #   _uri = uri.dup\n" ++
  "    #   _uri.path = '/posts'\n" ++
  "    #   data = '\{\"title\": \"foo\", \"body\": \"bar\", \"userId\": 1\}'\n" ++
  "    #   headers = \{'content-type': 'application/json'\}\n" ++
  "    #   res = Net::HTTP.put(_uri, data, headers) # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #   puts res.body\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \{\n" ++
  "    #     \"title\": \"foo\",\n" ++
  "    #     \"body\": \"bar\",\n" ++
  "    #     \"userId\": 1,\n" ++
  "    #     \"id\": 101\n" ++
  "    #   \}\n" ++
  "    #\n" ++
  "    # Related:\n" ++
  "    #\n" ++
  "    # - Net::HTTP::Put: request class for \\HTTP method +PUT+.\n" ++
  "    # - Net::HTTP#put: convenience method for \\HTTP method +PUT+.\n" ++
  "    #\n" ++
  "    def HTTP.put(url, data, header = nil)\n" ++
  "      start(url.hostname, url.port,\n" ++
  "            :use_ssl => url.scheme == 'https' ) \{|http|\n" ++
  "        http.put(url, data, header)\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # \\HTTP session management\n" ++
  "    #\n" ++
  "\n" ++
  "    # Returns integer +80+, the default port to use for \\HTTP requests:\n" ++
  "    #\n" ++
  "    #   Net::HTTP.default_port # => 80\n" ++
  "    #\n" ++
  "    def HTTP.default_port\n" ++
  "      http_default_port()\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns integer +80+, the default port to use for \\HTTP requests:\n" ++
  "    #\n" ++
  "    #   Net::HTTP.http_default_port # => 80\n" ++
  "    #\n" ++
  "    def HTTP.http_default_port\n" ++
  "      80\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns integer +443+, the default port to use for HTTPS requests:\n" ++
  "    #\n" ++
  "    #   Net::HTTP.https_default_port # => 443\n" ++
  "    #\n" ++
  "    def HTTP.https_default_port\n" ++
  "      443\n" ++
  "    end\n" ++
  "\n" ++
  "    def HTTP.socket_type   #:nodoc: obsolete\n" ++
  "      BufferedIO\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #   HTTP.start(address, port = nil, p_addr = :ENV, p_port = nil, p_user = nil, p_pass = nil, opts) -> http\n" ++
  "    #   HTTP.start(address, port = nil, p_addr = :ENV, p_port = nil, p_user = nil, p_pass = nil, opts) \{|http| ... \} -> object\n" ++
  "    #\n" ++
  "    # Creates a new \\Net::HTTP object, +http+, via \\Net::HTTP.new:\n" ++
  "    #\n" ++
  "    # - For arguments +address+ and +port+, see Net::HTTP.new.\n" ++
  "    # - For proxy-defining arguments +p_addr+ through +p_pass+,\n" ++
  "    #   see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    # - For argument +opts+, see below.\n" ++
  "    #\n" ++
  "    # With no block given:\n" ++
  "    #\n" ++
  "    # - Calls <tt>http.start</tt> with no block (see #start),\n" ++
  "    #   which opens a TCP connection and \\HTTP session.\n" ++
  "    # - Returns +http+.\n" ++
  "    # - The caller should call #finish to close the session:\n" ++
  "    #\n" ++
  "    #     http = Net::HTTP.start(hostname)\n" ++
  "    #     http.started? # => true\n" ++
  "    #     http.finish\n" ++
  "    #     http.started? # => false\n" ++
  "    #\n" ++
  "    # With a block given:\n" ++
  "    #\n" ++
  "    # - Calls <tt>http.start</tt> with the block (see #start), which:\n" ++
  "    #\n" ++
  "    #   - Opens a TCP connection and \\HTTP session.\n" ++
  "    #   - Calls the block,\n" ++
  "    #     which may make any number of requests to the host.\n" ++
  "    #   - Closes the \\HTTP session and TCP connection on block exit.\n" ++
  "    #   - Returns the block's value +object+.\n" ++
  "    #\n" ++
  "    # - Returns +object+.\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #   hostname = 'jsonplaceholder.typicode.com'\n" ++
  "    #   Net::HTTP.start(hostname) do |http|\n" ++
  "    #     puts http.get('/todos/1').body\n" ++
  "    #     puts http.get('/todos/2').body\n" ++
  "    #   end\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \{\n" ++
  "    #     \"userId\": 1,\n" ++
  "    #     \"id\": 1,\n" ++
  "    #     \"title\": \"delectus aut autem\",\n" ++
  "    #     \"completed\": false\n" ++
  "    #   \}\n" ++
  "    #   \{\n" ++
  "    #     \"userId\": 1,\n" ++
  "    #     \"id\": 2,\n" ++
  "    #     \"title\": \"quis ut nam facilis et officia qui\",\n" ++
  "    #     \"completed\": false\n" ++
  "    #   \}\n" ++
  "    #\n" ++
  "    # If the last argument given is a hash, it is the +opts+ hash,\n" ++
  "    # where each key is a method or accessor to be called,\n" ++
  "    # and its value is the value to be set.\n" ++
  "    #\n" ++
  "    # The keys may include:\n" ++
  "    #\n" ++
  "    # - #ca_file\n" ++
  "    # - #ca_path\n" ++
  "    # - #cert\n" ++
  "    # - #cert_store\n" ++
  "    # - #ciphers\n" ++
  "    # - #close_on_empty_response\n" ++
  "    # - +ipaddr+ (calls #ipaddr=)\n" ++
  "    # - #keep_alive_timeout\n" ++
  "    # - #key\n" ++
  "    # - #open_timeout\n" ++
  "    # - #read_timeout\n" ++
  "    # - #ssl_timeout\n" ++
  "    # - #ssl_version\n" ++
  "    # - +use_ssl+ (calls #use_ssl=)\n" ++
  "    # - #verify_callback\n" ++
  "    # - #verify_depth\n" ++
  "    # - #verify_mode\n" ++
  "    # - #write_timeout\n" ++
  "    #\n" ++
  "    # Note: If +port+ is +nil+ and <tt>opts[:use_ssl]</tt> is a truthy value,\n" ++
  "    # the value passed to +new+ is Net::HTTP.https_default_port, not +port+.\n" ++
  "    #\n" ++
  "    def HTTP.start(address, *arg, &block) # :yield: +http+\n" ++
  "      arg.pop if opt = Hash.try_convert(arg[-1])\n" ++
  "      port, p_addr, p_port, p_user, p_pass = *arg\n" ++
  "      p_addr = :ENV if arg.size < 2\n" ++
  "      port = https_default_port if !port && opt && opt[:use_ssl]\n" ++
  "      http = new(address, port, p_addr, p_port, p_user, p_pass)\n" ++
  "      http.ipaddr = opt[:ipaddr] if opt && opt[:ipaddr]\n" ++
  "\n" ++
  "      if opt\n" ++
  "        if opt[:use_ssl]\n" ++
  "          opt = \{verify_mode: OpenSSL::SSL::VERIFY_PEER\}.update(opt)\n" ++
  "        end\n" ++
  "        http.methods.grep(/\\A(\\w+)=\\z/) do |meth|\n" ++
  "          key = $1.to_sym\n" ++
  "          opt.key?(key) or next\n" ++
  "          http.__send__(meth, opt[key])\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      http.start(&block)\n" ++
  "    end\n" ++
  "\n" ++
  "    class << HTTP\n" ++
  "      alias newobj new # :nodoc:\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns a new \\Net::HTTP object +http+\n" ++
  "    # (but does not open a TCP connection or \\HTTP session).\n" ++
  "    #\n" ++
  "    # With only string argument +address+ given\n" ++
  "    # (and <tt>ENV['http_proxy']</tt> undefined or +nil+),\n" ++
  "    # the returned +http+:\n" ++
  "    #\n" ++
  "    # - Has the given address.\n" ++
  "    # - Has the default port number, Net::HTTP.default_port (80).\n" ++
  "    # - Has no proxy.\n" ++
  "    #\n" ++
  "    # Example:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   # => #<Net::HTTP jsonplaceholder.typicode.com:80 open=false>\n" ++
  "    #   http.address # => \"jsonplaceholder.typicode.com\"\n" ++
  "    #   http.port    # => 80\n" ++
  "    #   http.proxy?  # => false\n" ++
  "    #\n" ++
  "    # With integer argument +port+ also given,\n" ++
  "    # the returned +http+ has the given port:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname, 8000)\n" ++
  "    #   # => #<Net::HTTP jsonplaceholder.typicode.com:8000 open=false>\n" ++
  "    #   http.port # => 8000\n" ++
  "    #\n" ++
  "    # For proxy-defining arguments +p_addr+ through +p_no_proxy+,\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    #\n" ++
  "    def HTTP.new(address, port = nil, p_addr = :ENV, p_port = nil, p_user = nil, p_pass = nil, p_no_proxy = nil, p_use_ssl = nil)\n" ++
  "      http = super address, port\n" ++
  "\n" ++
  "      if proxy_class? then # from Net::HTTP::Proxy()\n" ++
  "        http.proxy_from_env = @proxy_from_env\n" ++
  "        http.proxy_address  = @proxy_address\n" ++
  "        http.proxy_port     = @proxy_port\n" ++
  "        http.proxy_user     = @proxy_user\n" ++
  "        http.proxy_pass     = @proxy_pass\n" ++
  "        http.proxy_use_ssl  = @proxy_use_ssl\n" ++
  "      elsif p_addr == :ENV then\n" ++
  "        http.proxy_from_env = true\n" ++
  "      else\n" ++
  "        if p_addr && p_no_proxy && !URI::Generic.use_proxy?(address, address, port, p_no_proxy)\n" ++
  "          p_addr = nil\n" ++
  "          p_port = nil\n" ++
  "        end\n" ++
  "        http.proxy_address = p_addr\n" ++
  "        http.proxy_port    = p_port || default_port\n" ++
  "        http.proxy_user    = p_user\n" ++
  "        http.proxy_pass    = p_pass\n" ++
  "        http.proxy_use_ssl = p_use_ssl\n" ++
  "      end\n" ++
  "\n" ++
  "      http\n" ++
  "    end\n" ++
  "\n" ++
  "    class << HTTP\n" ++
  "      # Allows to set the default configuration that will be used\n" ++
  "      # when creating a new connection.\n" ++
  "      #\n" ++
  "      # Example:\n" ++
  "      #\n" ++
  "      #   Net::HTTP.default_configuration = \{\n" ++
  "      #     read_timeout: 1,\n" ++
  "      #     write_timeout: 1\n" ++
  "      #   \}\n" ++
  "      #   http = Net::HTTP.new(hostname)\n" ++
  "      #   http.open_timeout   # => 60\n" ++
  "      #   http.read_timeout   # => 1\n" ++
  "      #   http.write_timeout  # => 1\n" ++
  "      #\n" ++
  "      attr_accessor :default_configuration\n" ++
  "    end\n" ++
  "\n" ++
  "    # Creates a new \\Net::HTTP object for the specified server address,\n" ++
  "    # without opening the TCP connection or initializing the \\HTTP session.\n" ++
  "    # The +address+ should be a DNS hostname or IP address.\n" ++
  "    def initialize(address, port = nil) # :nodoc:\n" ++
  "      defaults = \{\n" ++
  "        keep_alive_timeout: 2,\n" ++
  "        close_on_empty_response: false,\n" ++
  "        open_timeout: 60,\n" ++
  "        read_timeout: 60,\n" ++
  "        write_timeout: 60,\n" ++
  "        continue_timeout: nil,\n" ++
  "        max_retries: 1,\n" ++
  "        debug_output: nil,\n" ++
  "        response_body_encoding: false,\n" ++
  "        ignore_eof: true\n" ++
  "      \}\n" ++
  "      options = defaults.merge(self.class.default_configuration || \{\})\n" ++
  "\n" ++
  "      @address = address\n" ++
  "      @port    = (port || HTTP.default_port)\n" ++
  "      @ipaddr = nil\n" ++
  "      @local_host = nil\n" ++
  "      @local_port = nil\n" ++
  "      @curr_http_version = HTTPVersion\n" ++
  "      @keep_alive_timeout = options[:keep_alive_timeout]\n" ++
  "      @last_communicated = nil\n" ++
  "      @close_on_empty_response = options[:close_on_empty_response]\n" ++
  "      @socket  = nil\n" ++
  "      @started = false\n" ++
  "      @open_timeout = options[:open_timeout]\n" ++
  "      @read_timeout = options[:read_timeout]\n" ++
  "      @write_timeout = options[:write_timeout]\n" ++
  "      @continue_timeout = options[:continue_timeout]\n" ++
  "      @max_retries = options[:max_retries]\n" ++
  "      @debug_output = options[:debug_output]\n" ++
  "      @response_body_encoding = options[:response_body_encoding]\n" ++
  "      @ignore_eof = options[:ignore_eof]\n" ++
  "      @tcpsocket_supports_open_timeout = nil\n" ++
  "\n" ++
  "      @proxy_from_env = false\n" ++
  "      @proxy_uri      = nil\n" ++
  "      @proxy_address  = nil\n" ++
  "      @proxy_port     = nil\n" ++
  "      @proxy_user     = nil\n" ++
  "      @proxy_pass     = nil\n" ++
  "      @proxy_use_ssl  = nil\n" ++
  "\n" ++
  "      @use_ssl = false\n" ++
  "      @ssl_context = nil\n" ++
  "      @ssl_session = nil\n" ++
  "      @sspi_enabled = false\n" ++
  "      SSL_IVNAMES.each do |ivname|\n" ++
  "        instance_variable_set ivname, nil\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns a string representation of +self+:\n" ++
  "    #\n" ++
  "    #   Net::HTTP.new(hostname).inspect\n" ++
  "    #   # => \"#<Net::HTTP jsonplaceholder.typicode.com:80 open=false>\"\n" ++
  "    #\n" ++
  "    def inspect\n" ++
  "      \"#<#\{self.class\} #\{@address\}:#\{@port\} open=#\{started?\}>\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # *WARNING* This method opens a serious security hole.\n" ++
  "    # Never use this method in production code.\n" ++
  "    #\n" ++
  "    # Sets the output stream for debugging:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   File.open('t.tmp', 'w') do |file|\n" ++
  "    #     http.set_debug_output(file)\n" ++
  "    #     http.start\n" ++
  "    #     http.get('/nosuch/1')\n" ++
  "    #     http.finish\n" ++
  "    #   end\n" ++
  "    #   puts File.read('t.tmp')\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   opening connection to jsonplaceholder.typicode.com:80...\n" ++
  "    #   opened\n" ++
  "    #   <- \"GET /nosuch/1 HTTP/1.1\\r\\nAccept-Encoding: gzip;q=1.0,deflate;q=0.6,identity;q=0.3\\r\\nAccept: */*\\r\\nUser-Agent: Ruby\\r\\nHost: jsonplaceholder.typicode.com\\r\\n\\r\\n\"\n" ++
  "    #   -> \"HTTP/1.1 404 Not Found\\r\\n\"\n" ++
  "    #   -> \"Date: Mon, 12 Dec 2022 21:14:11 GMT\\r\\n\"\n" ++
  "    #   -> \"Content-Type: application/json; charset=utf-8\\r\\n\"\n" ++
  "    #   -> \"Content-Length: 2\\r\\n\"\n" ++
  "    #   -> \"Connection: keep-alive\\r\\n\"\n" ++
  "    #   -> \"X-Powered-By: Express\\r\\n\"\n" ++
  "    #   -> \"X-Ratelimit-Limit: 1000\\r\\n\"\n" ++
  "    #   -> \"X-Ratelimit-Remaining: 999\\r\\n\"\n" ++
  "    #   -> \"X-Ratelimit-Reset: 1670879660\\r\\n\"\n" ++
  "    #   -> \"Vary: Origin, Accept-Encoding\\r\\n\"\n" ++
  "    #   -> \"Access-Control-Allow-Credentials: true\\r\\n\"\n" ++
  "    #   -> \"Cache-Control: max-age=43200\\r\\n\"\n" ++
  "    #   -> \"Pragma: no-cache\\r\\n\"\n" ++
  "    #   -> \"Expires: -1\\r\\n\"\n" ++
  "    #   -> \"X-Content-Type-Options: nosniff\\r\\n\"\n" ++
  "    #   -> \"Etag: W/\\\"2-vyGp6PvFo4RvsFtPoIWeCReyIC8\\\"\\r\\n\"\n" ++
  "    #   -> \"Via: 1.1 vegur\\r\\n\"\n" ++
  "    #   -> \"CF-Cache-Status: MISS\\r\\n\"\n" ++
  "    #   -> \"Server-Timing: cf-q-config;dur=1.3000000762986e-05\\r\\n\"\n" ++
  "    #   -> \"Report-To: \{\\\"endpoints\\\":[\{\\\"url\\\":\\\"https:\\\\/\\\\/a.nel.cloudflare.com\\\\/report\\\\/v3?s=yOr40jo%2BwS1KHzhTlVpl54beJ5Wx2FcG4gGV0XVrh3X9OlR5q4drUn2dkt5DGO4GDcE%2BVXT7CNgJvGs%2BZleIyMu8CLieFiDIvOviOY3EhHg94m0ZNZgrEdpKD0S85S507l1vsEwEHkoTm%2Ff19SiO\\\"\}],\\\"group\\\":\\\"cf-nel\\\",\\\"max_age\\\":604800\}\\r\\n\"\n" ++
  "    #   -> \"NEL: \{\\\"success_fraction\\\":0,\\\"report_to\\\":\\\"cf-nel\\\",\\\"max_age\\\":604800\}\\r\\n\"\n" ++
  "    #   -> \"Server: cloudflare\\r\\n\"\n" ++
  "    #   -> \"CF-RAY: 778977dc484ce591-DFW\\r\\n\"\n" ++
  "    #   -> \"alt-svc: h3=\\\":443\\\"; ma=86400, h3-29=\\\":443\\\"; ma=86400\\r\\n\"\n" ++
  "    #   -> \"\\r\\n\"\n" ++
  "    #   reading 2 bytes...\n" ++
  "    #   -> \"\{\}\"\n" ++
  "    #   read 2 bytes\n" ++
  "    #   Conn keep-alive\n" ++
  "    #\n" ++
  "    def set_debug_output(output)\n" ++
  "      warn 'Net::HTTP#set_debug_output called after HTTP started', uplevel: 1 if started?\n" ++
  "      @debug_output = output\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the string host name or host IP given as argument +address+ in ::new.\n" ++
  "    attr_reader :address\n" ++
  "\n" ++
  "    # Returns the integer port number given as argument +port+ in ::new.\n" ++
  "    attr_reader :port\n" ++
  "\n" ++
  "    # Sets or returns the string local host used to establish the connection;\n" ++
  "    # initially +nil+.\n" ++
  "    attr_accessor :local_host\n" ++
  "\n" ++
  "    # Sets or returns the integer local port used to establish the connection;\n" ++
  "    # initially +nil+.\n" ++
  "    attr_accessor :local_port\n" ++
  "\n" ++
  "    # Returns the encoding to use for the response body;\n" ++
  "    # see #response_body_encoding=.\n" ++
  "    attr_reader :response_body_encoding\n" ++
  "\n" ++
  "    # Sets the encoding to be used for the response body;\n" ++
  "    # returns the encoding.\n" ++
  "    #\n" ++
  "    # The given +value+ may be:\n" ++
  "    #\n" ++
  "    # - An Encoding object.\n" ++
  "    # - The name of an encoding.\n" ++
  "    # - An alias for an encoding name.\n" ++
  "    #\n" ++
  "    # See \{Encoding\}[rdoc-ref:Encoding].\n" ++
  "    #\n" ++
  "    # Examples:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.response_body_encoding = Encoding::US_ASCII # => #<Encoding:US-ASCII>\n" ++
  "    #   http.response_body_encoding = 'US-ASCII'         # => \"US-ASCII\"\n" ++
  "    #   http.response_body_encoding = 'ASCII'            # => \"ASCII\"\n" ++
  "    #\n" ++
  "    def response_body_encoding=(value)\n" ++
  "      value = Encoding.find(value) if value.is_a?(String)\n" ++
  "      @response_body_encoding = value\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets whether to determine the proxy from environment variable\n" ++
  "    # '<tt>ENV['http_proxy']</tt>';\n" ++
  "    # see \{Proxy Using ENV['http_proxy']\}[rdoc-ref:Net::HTTP@Proxy+Using+-27ENV-5B-27http_proxy-27-5D-27].\n" ++
  "    attr_writer :proxy_from_env\n" ++
  "\n" ++
  "    # Sets the proxy address;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    attr_writer :proxy_address\n" ++
  "\n" ++
  "    # Sets the proxy port;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    attr_writer :proxy_port\n" ++
  "\n" ++
  "    # Sets the proxy user;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    attr_writer :proxy_user\n" ++
  "\n" ++
  "    # Sets the proxy password;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    attr_writer :proxy_pass\n" ++
  "\n" ++
  "    # Sets whether the proxy uses SSL;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    attr_writer :proxy_use_ssl\n" ++
  "\n" ++
  "    # Returns the IP address for the connection.\n" ++
  "    #\n" ++
  "    # If the session has not been started,\n" ++
  "    # returns the value set by #ipaddr=,\n" ++
  "    # or +nil+ if it has not been set:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.ipaddr # => nil\n" ++
  "    #   http.ipaddr = '172.67.155.76'\n" ++
  "    #   http.ipaddr # => \"172.67.155.76\"\n" ++
  "    #\n" ++
  "    # If the session has been started,\n" ++
  "    # returns the IP address from the socket:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.start\n" ++
  "    #   http.ipaddr # => \"172.67.155.76\"\n" ++
  "    #   http.finish\n" ++
  "    #\n" ++
  "    def ipaddr\n" ++
  "      started? ?  @socket.io.peeraddr[3] : @ipaddr\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets the IP address for the connection:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.ipaddr # => nil\n" ++
  "    #   http.ipaddr = '172.67.155.76'\n" ++
  "    #   http.ipaddr # => \"172.67.155.76\"\n" ++
  "    #\n" ++
  "    # The IP address may not be set if the session has been started.\n" ++
  "    def ipaddr=(addr)\n" ++
  "      raise IOError, \"ipaddr value changed, but session already started\" if started?\n" ++
  "      @ipaddr = addr\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets or returns the numeric (\\Integer or \\Float) number of seconds\n" ++
  "    # to wait for a connection to open;\n" ++
  "    # initially 60.\n" ++
  "    # If the connection is not made in the given interval,\n" ++
  "    # an exception is raised.\n" ++
  "    attr_accessor :open_timeout\n" ++
  "\n" ++
  "    # Returns the numeric (\\Integer or \\Float) number of seconds\n" ++
  "    # to wait for one block to be read (via one read(2) call);\n" ++
  "    # see #read_timeout=.\n" ++
  "    attr_reader :read_timeout\n" ++
  "\n" ++
  "    # Returns the numeric (\\Integer or \\Float) number of seconds\n" ++
  "    # to wait for one block to be written (via one write(2) call);\n" ++
  "    # see #write_timeout=.\n" ++
  "    attr_reader :write_timeout\n" ++
  "\n" ++
  "    # Sets the maximum number of times to retry an idempotent request in case of\n" ++
  "    # \\Net::ReadTimeout, IOError, EOFError, Errno::ECONNRESET,\n" ++
  "    # Errno::ECONNABORTED, Errno::EPIPE, OpenSSL::SSL::SSLError,\n" ++
  "    # Timeout::Error.\n" ++
  "    # The initial value is 1.\n" ++
  "    #\n" ++
  "    # Argument +retries+ must be a non-negative numeric value:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.max_retries = 2   # => 2\n" ++
  "    #   http.max_retries       # => 2\n" ++
  "    #\n" ++
  "    def max_retries=(retries)\n" ++
  "      retries = retries.to_int\n" ++
  "      if retries < 0\n" ++
  "        raise ArgumentError, 'max_retries should be non-negative integer number'\n" ++
  "      end\n" ++
  "      @max_retries = retries\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the maximum number of times to retry an idempotent request;\n" ++
  "    # see #max_retries=.\n" ++
  "    attr_reader :max_retries\n" ++
  "\n" ++
  "    # Sets the read timeout, in seconds, for +self+ to integer +sec+;\n" ++
  "    # the initial value is 60.\n" ++
  "    #\n" ++
  "    # Argument +sec+ must be a non-negative numeric value:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.read_timeout # => 60\n" ++
  "    #   http.get('/todos/1') # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #   http.read_timeout = 0\n" ++
  "    #   http.get('/todos/1') # Raises Net::ReadTimeout.\n" ++
  "    #\n" ++
  "    def read_timeout=(sec)\n" ++
  "      @socket.read_timeout = sec if @socket\n" ++
  "      @read_timeout = sec\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets the write timeout, in seconds, for +self+ to integer +sec+;\n" ++
  "    # the initial value is 60.\n" ++
  "    #\n" ++
  "    # Argument +sec+ must be a non-negative numeric value:\n" ++
  "    #\n" ++
  "    #   _uri = uri.dup\n" ++
  "    #   _uri.path = '/posts'\n" ++
  "    #   body = 'bar' * 200000\n" ++
  "    #   data = <<EOF\n" ++
  "    #   \{\"title\": \"foo\", \"body\": \"#\{body\}\", \"userId\": \"1\"\}\n" ++
  "    #   EOF\n" ++
  "    #   headers = \{'content-type': 'application/json'\}\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.write_timeout # => 60\n" ++
  "    #   http.post(_uri.path, data, headers)\n" ++
  "    #   # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #   http.write_timeout = 0\n" ++
  "    #   http.post(_uri.path, data, headers) # Raises Net::WriteTimeout.\n" ++
  "    #\n" ++
  "    def write_timeout=(sec)\n" ++
  "      @socket.write_timeout = sec if @socket\n" ++
  "      @write_timeout = sec\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the continue timeout value;\n" ++
  "    # see continue_timeout=.\n" ++
  "    attr_reader :continue_timeout\n" ++
  "\n" ++
  "    # Sets the continue timeout value,\n" ++
  "    # which is the number of seconds to wait for an expected 100 Continue response.\n" ++
  "    # If the \\HTTP object does not receive a response in this many seconds\n" ++
  "    # it sends the request body.\n" ++
  "    def continue_timeout=(sec)\n" ++
  "      @socket.continue_timeout = sec if @socket\n" ++
  "      @continue_timeout = sec\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets or returns the numeric (\\Integer or \\Float) number of seconds\n" ++
  "    # to keep the connection open after a request is sent;\n" ++
  "    # initially 2.\n" ++
  "    # If a new request is made during the given interval,\n" ++
  "    # the still-open connection is used;\n" ++
  "    # otherwise the connection will have been closed\n" ++
  "    # and a new connection is opened.\n" ++
  "    attr_accessor :keep_alive_timeout\n" ++
  "\n" ++
  "    # Sets or returns whether to ignore end-of-file when reading a response body\n" ++
  "    # with <tt>Content-Length</tt> headers;\n" ++
  "    # initially +true+.\n" ++
  "    attr_accessor :ignore_eof\n" ++
  "\n" ++
  "    # Returns +true+ if the \\HTTP session has been started:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.started? # => false\n" ++
  "    #   http.start\n" ++
  "    #   http.started? # => true\n" ++
  "    #   http.finish # => nil\n" ++
  "    #   http.started? # => false\n" ++
  "    #\n" ++
  "    #   Net::HTTP.start(hostname) do |http|\n" ++
  "    #     http.started?\n" ++
  "    #   end # => true\n" ++
  "    #   http.started? # => false\n" ++
  "    #\n" ++
  "    def started?\n" ++
  "      @started\n" ++
  "    end\n" ++
  "\n" ++
  "    alias active? started?   #:nodoc: obsolete\n" ++
  "\n" ++
  "    # Sets or returns whether to close the connection when the response is empty;\n" ++
  "    # initially +false+.\n" ++
  "    attr_accessor :close_on_empty_response\n" ++
  "\n" ++
  "    # Returns +true+ if +self+ uses SSL, +false+ otherwise.\n" ++
  "    # See Net::HTTP#use_ssl=.\n" ++
  "    def use_ssl?\n" ++
  "      @use_ssl\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sets whether a new session is to use\n" ++
  "    # \{Transport Layer Security\}[https://en.wikipedia.org/wiki/Transport_Layer_Security]:\n" ++
  "    #\n" ++
  "    # Raises IOError if attempting to change during a session.\n" ++
  "    #\n" ++
  "    # Raises OpenSSL::SSL::SSLError if the port is not an HTTPS port.\n" ++
  "    def use_ssl=(flag)\n" ++
  "      flag = flag ? true : false\n" ++
  "      if started? and @use_ssl != flag\n" ++
  "        raise IOError, \"use_ssl value changed, but session already started\"\n" ++
  "      end\n" ++
  "      @use_ssl = flag\n" ++
  "    end\n" ++
  "\n" ++
  "    SSL_ATTRIBUTES = [\n" ++
  "      :ca_file,\n" ++
  "      :ca_path,\n" ++
  "      :cert,\n" ++
  "      :cert_store,\n" ++
  "      :ciphers,\n" ++
  "      :extra_chain_cert,\n" ++
  "      :key,\n" ++
  "      :ssl_timeout,\n" ++
  "      :ssl_version,\n" ++
  "      :min_version,\n" ++
  "      :max_version,\n" ++
  "      :verify_callback,\n" ++
  "      :verify_depth,\n" ++
  "      :verify_mode,\n" ++
  "      :verify_hostname,\n" ++
  "    ].freeze # :nodoc:\n" ++
  "\n" ++
  "    SSL_IVNAMES = SSL_ATTRIBUTES.map \{ |a| \"@#\{a\}\".to_sym \}.freeze # :nodoc:\n" ++
  "\n" ++
  "    # Sets or returns the path to a CA certification file in PEM format.\n" ++
  "    attr_accessor :ca_file\n" ++
  "\n" ++
  "    # Sets or returns the path of to CA directory\n" ++
  "    # containing certification files in PEM format.\n" ++
  "    attr_accessor :ca_path\n" ++
  "\n" ++
  "    # Sets or returns the OpenSSL::X509::Certificate object\n" ++
  "    # to be used for client certification.\n" ++
  "    attr_accessor :cert\n" ++
  "\n" ++
  "    # Sets or returns the X509::Store to be used for verifying peer certificate.\n" ++
  "    attr_accessor :cert_store\n" ++
  "\n" ++
  "    # Sets or returns the available SSL ciphers.\n" ++
  "    # See \{OpenSSL::SSL::SSLContext#ciphers=\}[OpenSSL::SSL::SSL::Context#ciphers=].\n" ++
  "    attr_accessor :ciphers\n" ++
  "\n" ++
  "    # Sets or returns the extra X509 certificates to be added to the certificate chain.\n" ++
  "    # See \{OpenSSL::SSL::SSLContext#add_certificate\}[OpenSSL::SSL::SSL::Context#add_certificate].\n" ++
  "    attr_accessor :extra_chain_cert\n" ++
  "\n" ++
  "    # Sets or returns the OpenSSL::PKey::RSA or OpenSSL::PKey::DSA object.\n" ++
  "    attr_accessor :key\n" ++
  "\n" ++
  "    # Sets or returns the SSL timeout seconds.\n" ++
  "    attr_accessor :ssl_timeout\n" ++
  "\n" ++
  "    # Sets or returns the SSL version.\n" ++
  "    # See \{OpenSSL::SSL::SSLContext#ssl_version=\}[OpenSSL::SSL::SSL::Context#ssl_version=].\n" ++
  "    attr_accessor :ssl_version\n" ++
  "\n" ++
  "    # Sets or returns the minimum SSL version.\n" ++
  "    # See \{OpenSSL::SSL::SSLContext#min_version=\}[OpenSSL::SSL::SSL::Context#min_version=].\n" ++
  "    attr_accessor :min_version\n" ++
  "\n" ++
  "    # Sets or returns the maximum SSL version.\n" ++
  "    # See \{OpenSSL::SSL::SSLContext#max_version=\}[OpenSSL::SSL::SSL::Context#max_version=].\n" ++
  "    attr_accessor :max_version\n" ++
  "\n" ++
  "    # Sets or returns the callback for the server certification verification.\n" ++
  "    attr_accessor :verify_callback\n" ++
  "\n" ++
  "    # Sets or returns the maximum depth for the certificate chain verification.\n" ++
  "    attr_accessor :verify_depth\n" ++
  "\n" ++
  "    # Sets or returns the flags for server the certification verification\n" ++
  "    # at the beginning of the SSL/TLS session.\n" ++
  "    # OpenSSL::SSL::VERIFY_NONE or OpenSSL::SSL::VERIFY_PEER are acceptable.\n" ++
  "    attr_accessor :verify_mode\n" ++
  "\n" ++
  "    # Sets or returns whether to verify that the server certificate is valid\n" ++
  "    # for the hostname.\n" ++
  "    # See \{OpenSSL::SSL::SSLContext#verify_hostname=\}[OpenSSL::SSL::SSL::Context#verify_hostname=].\n" ++
  "    attr_accessor :verify_hostname\n" ++
  "\n" ++
  "    # Returns the X509 certificate chain (an array of strings)\n" ++
  "    # for the session's socket peer,\n" ++
  "    # or +nil+ if none.\n" ++
  "    def peer_cert\n" ++
  "      if not use_ssl? or not @socket\n" ++
  "        return nil\n" ++
  "      end\n" ++
  "      @socket.io.peer_cert\n" ++
  "    end\n" ++
  "\n" ++
  "    # Starts an \\HTTP session.\n" ++
  "    #\n" ++
  "    # Without a block, returns +self+:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   # => #<Net::HTTP jsonplaceholder.typicode.com:80 open=false>\n" ++
  "    #   http.start\n" ++
  "    #   # => #<Net::HTTP jsonplaceholder.typicode.com:80 open=true>\n" ++
  "    #   http.started? # => true\n" ++
  "    #   http.finish\n" ++
  "    #\n" ++
  "    # With a block, calls the block with +self+,\n" ++
  "    # finishes the session when the block exits,\n" ++
  "    # and returns the block's value:\n" ++
  "    #\n" ++
  "    #   http.start do |http|\n" ++
  "    #     http\n" ++
  "    #   end\n" ++
  "    #   # => #<Net::HTTP jsonplaceholder.typicode.com:80 open=false>\n" ++
  "    #   http.started? # => false\n" ++
  "    #\n" ++
  "    def start  # :yield: http\n" ++
  "      raise IOError, 'HTTP session already opened' if @started\n" ++
  "      if block_given?\n" ++
  "        begin\n" ++
  "          do_start\n" ++
  "          return yield(self)\n" ++
  "        ensure\n" ++
  "          do_finish\n" ++
  "        end\n" ++
  "      end\n" ++
  "      do_start\n" ++
  "      self\n" ++
  "    end\n" ++
  "\n" ++
  "    # Finishes the \\HTTP session:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.start\n" ++
  "    #   http.started? # => true\n" ++
  "    #   http.finish   # => nil\n" ++
  "    #   http.started? # => false\n" ++
  "    #\n" ++
  "    # Raises IOError if not in a session.\n" ++
  "    def finish\n" ++
  "      raise IOError, 'HTTP session not yet started' unless started?\n" ++
  "      do_finish\n" ++
  "    end\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "    def do_start\n" ++
  "      connect\n" ++
  "      @started = true\n" ++
  "    end\n" ++
  "    private :do_start\n" ++
  "\n" ++
  "    def connect\n" ++
  "      if use_ssl?\n" ++
  "        # reference early to load OpenSSL before connecting,\n" ++
  "        # as OpenSSL may take time to load.\n" ++
  "        @ssl_context = OpenSSL::SSL::SSLContext.new\n" ++
  "      end\n" ++
  "\n" ++
  "      if proxy? then\n" ++
  "        conn_addr = proxy_address\n" ++
  "        conn_port = proxy_port\n" ++
  "      else\n" ++
  "        conn_addr = conn_address\n" ++
  "        conn_port = port\n" ++
  "      end\n" ++
  "\n" ++
  "      debug \"opening connection to #\{conn_addr\}:#\{conn_port\}...\"\n" ++
  "      begin\n" ++
  "        s = timeouted_connect(conn_addr, conn_port)\n" ++
  "      rescue => e\n" ++
  "        if (defined?(IO::TimeoutError) && e.is_a?(IO::TimeoutError)) || e.is_a?(Errno::ETIMEDOUT)  # for compatibility with previous versions\n" ++
  "          e = Net::OpenTimeout.new(e)\n" ++
  "        end\n" ++
  "        raise e, \"Failed to open TCP connection to \" +\n" ++
  "          \"#\{conn_addr\}:#\{conn_port\} (#\{e.message\})\"\n" ++
  "      end\n" ++
  "      s.setsockopt(Socket::IPPROTO_TCP, Socket::TCP_NODELAY, 1)\n" ++
  "      debug \"opened\"\n" ++
  "      if use_ssl?\n" ++
  "        if proxy?\n" ++
  "          if @proxy_use_ssl\n" ++
  "            proxy_sock = OpenSSL::SSL::SSLSocket.new(s)\n" ++
  "            ssl_socket_connect(proxy_sock, @open_timeout)\n" ++
  "          else\n" ++
  "            proxy_sock = s\n" ++
  "          end\n" ++
  "          proxy_sock = BufferedIO.new(proxy_sock, read_timeout: @read_timeout,\n" ++
  "                                      write_timeout: @write_timeout,\n" ++
  "                                      continue_timeout: @continue_timeout,\n" ++
  "                                      debug_output: @debug_output)\n" ++
  "          buf = +\"CONNECT #\{conn_address\}:#\{@port\} HTTP/#\{HTTPVersion\}\\r\\n\" \\\n" ++
  "            \"Host: #\{@address\}:#\{@port\}\\r\\n\"\n" ++
  "          if proxy_user\n" ++
  "            credential = [\"#\{proxy_user\}:#\{proxy_pass\}\"].pack('m0')\n" ++
  "            buf << \"Proxy-Authorization: Basic #\{credential\}\\r\\n\"\n" ++
  "          end\n" ++
  "          buf << \"\\r\\n\"\n" ++
  "          proxy_sock.write(buf)\n" ++
  "          HTTPResponse.read_new(proxy_sock).value\n" ++
  "          # assuming nothing left in buffers after successful CONNECT response\n" ++
  "        end\n" ++
  "\n" ++
  "        ssl_parameters = Hash.new\n" ++
  "        iv_list = instance_variables\n" ++
  "        SSL_IVNAMES.each_with_index do |ivname, i|\n" ++
  "          if iv_list.include?(ivname)\n" ++
  "            value = instance_variable_get(ivname)\n" ++
  "            unless value.nil?\n" ++
  "              ssl_parameters[SSL_ATTRIBUTES[i]] = value\n" ++
  "            end\n" ++
  "          end\n" ++
  "        end\n" ++
  "        @ssl_context.set_params(ssl_parameters)\n" ++
  "        unless @ssl_context.session_cache_mode.nil? # a dummy method on JRuby\n" ++
  "          @ssl_context.session_cache_mode =\n" ++
  "              OpenSSL::SSL::SSLContext::SESSION_CACHE_CLIENT |\n" ++
  "                  OpenSSL::SSL::SSLContext::SESSION_CACHE_NO_INTERNAL_STORE\n" ++
  "        end\n" ++
  "        if @ssl_context.respond_to?(:session_new_cb) # not implemented under JRuby\n" ++
  "          @ssl_context.session_new_cb = proc \{|sock, sess| @ssl_session = sess \}\n" ++
  "        end\n" ++
  "\n" ++
  "        # Still do the post_connection_check below even if connecting\n" ++
  "        # to IP address\n" ++
  "        verify_hostname = @ssl_context.verify_hostname\n" ++
  "\n" ++
  "        # Server Name Indication (SNI) RFC 3546/6066\n" ++
  "        case @address\n" ++
  "        when Resolv::IPv4::Regex, Resolv::IPv6::Regex\n" ++
  "          # don't set SNI, as IP addresses in SNI is not valid\n" ++
  "          # per RFC 6066, section 3.\n" ++
  "\n" ++
  "          # Avoid openssl warning\n" ++
  "          @ssl_context.verify_hostname = false\n" ++
  "        else\n" ++
  "          ssl_host_address = @address\n" ++
  "        end\n" ++
  "\n" ++
  "        debug \"starting SSL for #\{conn_addr\}:#\{conn_port\}...\"\n" ++
  "        s = OpenSSL::SSL::SSLSocket.new(s, @ssl_context)\n" ++
  "        s.sync_close = true\n" ++
  "        s.hostname = ssl_host_address if s.respond_to?(:hostname=) && ssl_host_address\n" ++
  "\n" ++
  "        if @ssl_session and\n" ++
  "           Process.clock_gettime(Process::CLOCK_REALTIME) < @ssl_session.time.to_f + @ssl_session.timeout\n" ++
  "          s.session = @ssl_session\n" ++
  "        end\n" ++
  "        ssl_socket_connect(s, @open_timeout)\n" ++
  "        if (@ssl_context.verify_mode != OpenSSL::SSL::VERIFY_NONE) && verify_hostname\n" ++
  "          s.post_connection_check(@address)\n" ++
  "        end\n" ++
  "        debug \"SSL established, protocol: #\{s.ssl_version\}, cipher: #\{s.cipher[0]\}\"\n" ++
  "      end\n" ++
  "      @socket = BufferedIO.new(s, read_timeout: @read_timeout,\n" ++
  "                               write_timeout: @write_timeout,\n" ++
  "                               continue_timeout: @continue_timeout,\n" ++
  "                               debug_output: @debug_output)\n" ++
  "      @last_communicated = nil\n" ++
  "      on_connect\n" ++
  "    rescue => exception\n" ++
  "      if s\n" ++
  "        debug \"Conn close because of connect error #\{exception\}\"\n" ++
  "        s.close\n" ++
  "      end\n" ++
  "      raise\n" ++
  "    end\n" ++
  "    private :connect\n" ++
  "\n" ++
  "    tcp_socket_parameters = TCPSocket.instance_method(:initialize).parameters\n" ++
  "    TCP_SOCKET_NEW_HAS_OPEN_TIMEOUT = if tcp_socket_parameters != [[:rest]]\n" ++
  "      tcp_socket_parameters.include?([:key, :open_timeout])\n" ++
  "    else\n" ++
  "      # Use Socket.tcp to find out since there is no parameters information for TCPSocket#initialize\n" ++
  "      # See discussion in https://github.com/ruby/net-http/pull/224\n" ++
  "      Socket.method(:tcp).parameters.include?([:key, :open_timeout])\n" ++
  "    end\n" ++
  "    private_constant :TCP_SOCKET_NEW_HAS_OPEN_TIMEOUT\n" ++
  "\n" ++
  "    def timeouted_connect(conn_addr, conn_port)\n" ++
  "      if TCP_SOCKET_NEW_HAS_OPEN_TIMEOUT\n" ++
  "        TCPSocket.open(conn_addr, conn_port, @local_host, @local_port, open_timeout: @open_timeout)\n" ++
  "      else\n" ++
  "        Timeout.timeout(@open_timeout, Net::OpenTimeout) \{\n" ++
  "          TCPSocket.open(conn_addr, conn_port, @local_host, @local_port)\n" ++
  "        \}\n" ++
  "      end\n" ++
  "    end\n" ++
  "    private :timeouted_connect\n" ++
  "\n" ++
  "    def on_connect\n" ++
  "    end\n" ++
  "    private :on_connect\n" ++
  "\n" ++
  "    def do_finish\n" ++
  "      @started = false\n" ++
  "      @socket.close if @socket\n" ++
  "      @socket = nil\n" ++
  "    end\n" ++
  "    private :do_finish\n" ++
  "\n" ++
  "    #\n" ++
  "    # proxy\n" ++
  "    #\n" ++
  "\n" ++
  "    public\n" ++
  "\n" ++
  "    # no proxy\n" ++
  "    @is_proxy_class = false\n" ++
  "    @proxy_from_env = false\n" ++
  "    @proxy_addr = nil\n" ++
  "    @proxy_port = nil\n" ++
  "    @proxy_user = nil\n" ++
  "    @proxy_pass = nil\n" ++
  "    @proxy_use_ssl = nil\n" ++
  "\n" ++
  "    # Creates an \\HTTP proxy class which behaves like \\Net::HTTP, but\n" ++
  "    # performs all access via the specified proxy.\n" ++
  "    #\n" ++
  "    # This class is obsolete.  You may pass these same parameters directly to\n" ++
  "    # \\Net::HTTP.new.  See Net::HTTP.new for details of the arguments.\n" ++
  "    def HTTP.Proxy(p_addr = :ENV, p_port = nil, p_user = nil, p_pass = nil, p_use_ssl = nil) #:nodoc:\n" ++
  "      return self unless p_addr\n" ++
  "\n" ++
  "      Class.new(self) \{\n" ++
  "        @is_proxy_class = true\n" ++
  "\n" ++
  "        if p_addr == :ENV then\n" ++
  "          @proxy_from_env = true\n" ++
  "          @proxy_address = nil\n" ++
  "          @proxy_port    = nil\n" ++
  "        else\n" ++
  "          @proxy_from_env = false\n" ++
  "          @proxy_address = p_addr\n" ++
  "          @proxy_port    = p_port || default_port\n" ++
  "        end\n" ++
  "\n" ++
  "        @proxy_user = p_user\n" ++
  "        @proxy_pass = p_pass\n" ++
  "        @proxy_use_ssl = p_use_ssl\n" ++
  "      \}\n" ++
  "    end\n" ++
  "\n" ++
  "    # :startdoc:\n" ++
  "\n" ++
  "    class << HTTP\n" ++
  "      # Returns true if self is a class which was created by HTTP::Proxy.\n" ++
  "      def proxy_class?\n" ++
  "        defined?(@is_proxy_class) ? @is_proxy_class : false\n" ++
  "      end\n" ++
  "\n" ++
  "      # Returns the address of the proxy host, or +nil+ if none;\n" ++
  "      # see Net::HTTP@Proxy+Server.\n" ++
  "      attr_reader :proxy_address\n" ++
  "\n" ++
  "      # Returns the port number of the proxy host, or +nil+ if none;\n" ++
  "      # see Net::HTTP@Proxy+Server.\n" ++
  "      attr_reader :proxy_port\n" ++
  "\n" ++
  "      # Returns the user name for accessing the proxy, or +nil+ if none;\n" ++
  "      # see Net::HTTP@Proxy+Server.\n" ++
  "      attr_reader :proxy_user\n" ++
  "\n" ++
  "      # Returns the password for accessing the proxy, or +nil+ if none;\n" ++
  "      # see Net::HTTP@Proxy+Server.\n" ++
  "      attr_reader :proxy_pass\n" ++
  "\n" ++
  "      # Use SSL when talking to the proxy. If Net::HTTP does not use a proxy, nil.\n" ++
  "      attr_reader :proxy_use_ssl\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns +true+ if a proxy server is defined, +false+ otherwise;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    def proxy?\n" ++
  "      !!(@proxy_from_env ? proxy_uri : @proxy_address)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns +true+ if the proxy server is defined in the environment,\n" ++
  "    # +false+ otherwise;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    def proxy_from_env?\n" ++
  "      @proxy_from_env\n" ++
  "    end\n" ++
  "\n" ++
  "    # The proxy URI determined from the environment for this connection.\n" ++
  "    def proxy_uri # :nodoc:\n" ++
  "      return if @proxy_uri == false\n" ++
  "      @proxy_uri ||= URI::HTTP.new(\n" ++
  "        \"http\", nil, address, port, nil, nil, nil, nil, nil\n" ++
  "      ).find_proxy || false\n" ++
  "      @proxy_uri || nil\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the address of the proxy server, if defined, +nil+ otherwise;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    def proxy_address\n" ++
  "      if @proxy_from_env then\n" ++
  "        proxy_uri&.hostname\n" ++
  "      else\n" ++
  "        @proxy_address\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the port number of the proxy server, if defined, +nil+ otherwise;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    def proxy_port\n" ++
  "      if @proxy_from_env then\n" ++
  "        proxy_uri&.port\n" ++
  "      else\n" ++
  "        @proxy_port\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the user name of the proxy server, if defined, +nil+ otherwise;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    def proxy_user\n" ++
  "      if @proxy_from_env\n" ++
  "        user = proxy_uri&.user\n" ++
  "        unescape(user) if user\n" ++
  "      else\n" ++
  "        @proxy_user\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    # Returns the password of the proxy server, if defined, +nil+ otherwise;\n" ++
  "    # see \{Proxy Server\}[rdoc-ref:Net::HTTP@Proxy+Server].\n" ++
  "    def proxy_pass\n" ++
  "      if @proxy_from_env\n" ++
  "        pass = proxy_uri&.password\n" ++
  "        unescape(pass) if pass\n" ++
  "      else\n" ++
  "        @proxy_pass\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    alias proxyaddr proxy_address   #:nodoc: obsolete\n" ++
  "    alias proxyport proxy_port      #:nodoc: obsolete\n" ++
  "\n" ++
  "    private\n" ++
  "    # :stopdoc:\n" ++
  "\n" ++
  "    def unescape(value)\n" ++
  "      require 'cgi/escape'\n" ++
  "      require 'cgi/util' unless defined?(CGI::EscapeExt)\n" ++
  "      CGI.unescape(value)\n" ++
  "    end\n" ++
  "\n" ++
  "    # without proxy, obsolete\n" ++
  "\n" ++
  "    def conn_address # :nodoc:\n" ++
  "      @ipaddr || address()\n" ++
  "    end\n" ++
  "\n" ++
  "    def conn_port # :nodoc:\n" ++
  "      port()\n" ++
  "    end\n" ++
  "\n" ++
  "    def edit_path(path)\n" ++
  "      if proxy?\n" ++
  "        if path.start_with?(\"ftp://\") || use_ssl?\n" ++
  "          path\n" ++
  "        else\n" ++
  "          \"http://#\{addr_port\}#\{path\}\"\n" ++
  "        end\n" ++
  "      else\n" ++
  "        path\n" ++
  "      end\n" ++
  "    end\n" ++
  "    # :startdoc:\n" ++
  "\n" ++
  "    #\n" ++
  "    # HTTP operations\n" ++
  "    #\n" ++
  "\n" ++
  "    public\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #    get(path, initheader = nil) \{|res| ... \}\n" ++
  "    #\n" ++
  "    # Sends a GET request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Get object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    # With a block given, calls the block with the response body:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.get('/todos/1') do |res|\n" ++
  "    #     p res\n" ++
  "    #   end # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \"\{\\n  \\\"userId\\\": 1,\\n  \\\"id\\\": 1,\\n  \\\"title\\\": \\\"delectus aut autem\\\",\\n  \\\"completed\\\": false\\n\}\"\n" ++
  "    #\n" ++
  "    # With no block given, simply returns the response object:\n" ++
  "    #\n" ++
  "    #   http.get('/') # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # Related:\n" ++
  "    #\n" ++
  "    # - Net::HTTP::Get: request class for \\HTTP method GET.\n" ++
  "    # - Net::HTTP.get: sends GET request, returns response body.\n" ++
  "    #\n" ++
  "    def get(path, initheader = nil, dest = nil, &block) # :yield: +body_segment+\n" ++
  "      res = nil\n" ++
  "\n" ++
  "      request(Get.new(path, initheader)) \{|r|\n" ++
  "        r.read_body dest, &block\n" ++
  "        res = r\n" ++
  "      \}\n" ++
  "      res\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a HEAD request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Head object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+:\n" ++
  "    #\n" ++
  "    #   res = http.head('/todos/1') # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #   res.body                    # => nil\n" ++
  "    #   res.to_hash.take(3)\n" ++
  "    #   # =>\n" ++
  "    #   [[\"date\", [\"Wed, 15 Feb 2023 15:25:42 GMT\"]],\n" ++
  "    #    [\"content-type\", [\"application/json; charset=utf-8\"]],\n" ++
  "    #    [\"connection\", [\"close\"]]]\n" ++
  "    #\n" ++
  "    def head(path, initheader = nil)\n" ++
  "      request(Head.new(path, initheader))\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #    post(path, data, initheader = nil) \{|res| ... \}\n" ++
  "    #\n" ++
  "    # Sends a POST request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Post object\n" ++
  "    # created from string +path+, string +data+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    # With a block given, calls the block with the response body:\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.post('/todos', data) do |res|\n" ++
  "    #     p res\n" ++
  "    #   end # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \"\{\\n  \\\"\{\\\\\\\"userId\\\\\\\": 1, \\\\\\\"id\\\\\\\": 1, \\\\\\\"title\\\\\\\": \\\\\\\"delectus aut autem\\\\\\\", \\\\\\\"completed\\\\\\\": false\}\\\": \\\"\\\",\\n  \\\"id\\\": 201\\n\}\"\n" ++
  "    #\n" ++
  "    # With no block given, simply returns the response object:\n" ++
  "    #\n" ++
  "    #   http.post('/todos', data) # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    # Related:\n" ++
  "    #\n" ++
  "    # - Net::HTTP::Post: request class for \\HTTP method POST.\n" ++
  "    # - Net::HTTP.post: sends POST request, returns response body.\n" ++
  "    #\n" ++
  "    def post(path, data, initheader = nil, dest = nil, &block) # :yield: +body_segment+\n" ++
  "      send_entity(path, data, initheader, dest, Post, &block)\n" ++
  "    end\n" ++
  "\n" ++
  "    # :call-seq:\n" ++
  "    #    patch(path, data, initheader = nil) \{|res| ... \}\n" ++
  "    #\n" ++
  "    # Sends a PATCH request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Patch object\n" ++
  "    # created from string +path+, string +data+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    # With a block given, calls the block with the response body:\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.patch('/todos/1', data) do |res|\n" ++
  "    #     p res\n" ++
  "    #   end # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \"\{\\n  \\\"userId\\\": 1,\\n  \\\"id\\\": 1,\\n  \\\"title\\\": \\\"delectus aut autem\\\",\\n  \\\"completed\\\": false,\\n  \\\"\{\\\\\\\"userId\\\\\\\": 1, \\\\\\\"id\\\\\\\": 1, \\\\\\\"title\\\\\\\": \\\\\\\"delectus aut autem\\\\\\\", \\\\\\\"completed\\\\\\\": false\}\\\": \\\"\\\"\\n\}\"\n" ++
  "    #\n" ++
  "    # With no block given, simply returns the response object:\n" ++
  "    #\n" ++
  "    #   http.patch('/todos/1', data) # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    def patch(path, data, initheader = nil, dest = nil, &block) # :yield: +body_segment+\n" ++
  "      send_entity(path, data, initheader, dest, Patch, &block)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a PUT request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Put object\n" ++
  "    # created from string +path+, string +data+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.put('/todos/1', data) # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # Related:\n" ++
  "    #\n" ++
  "    # - Net::HTTP::Put: request class for \\HTTP method PUT.\n" ++
  "    # - Net::HTTP.put: sends PUT request, returns response body.\n" ++
  "    #\n" ++
  "    def put(path, data, initheader = nil)\n" ++
  "      request(Put.new(path, initheader), data)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a PROPPATCH request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Proppatch object\n" ++
  "    # created from string +path+, string +body+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.proppatch('/todos/1', data)\n" ++
  "    #\n" ++
  "    def proppatch(path, body, initheader = nil)\n" ++
  "      request(Proppatch.new(path, initheader), body)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a LOCK request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Lock object\n" ++
  "    # created from string +path+, string +body+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.lock('/todos/1', data)\n" ++
  "    #\n" ++
  "    def lock(path, body, initheader = nil)\n" ++
  "      request(Lock.new(path, initheader), body)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends an UNLOCK request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Unlock object\n" ++
  "    # created from string +path+, string +body+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.unlock('/todos/1', data)\n" ++
  "    #\n" ++
  "    def unlock(path, body, initheader = nil)\n" ++
  "      request(Unlock.new(path, initheader), body)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends an Options request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Options object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.options('/')\n" ++
  "    #\n" ++
  "    def options(path, initheader = nil)\n" ++
  "      request(Options.new(path, initheader))\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a PROPFIND request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Propfind object\n" ++
  "    # created from string +path+, string +body+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.propfind('/todos/1', data)\n" ++
  "    #\n" ++
  "    def propfind(path, body = nil, initheader = \{'Depth' => '0'\})\n" ++
  "      request(Propfind.new(path, initheader), body)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a DELETE request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Delete object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.delete('/todos/1')\n" ++
  "    #\n" ++
  "    def delete(path, initheader = \{'Depth' => 'Infinity'\})\n" ++
  "      request(Delete.new(path, initheader))\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a MOVE request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Move object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.move('/todos/1')\n" ++
  "    #\n" ++
  "    def move(path, initheader = nil)\n" ++
  "      request(Move.new(path, initheader))\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a COPY request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Copy object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.copy('/todos/1')\n" ++
  "    #\n" ++
  "    def copy(path, initheader = nil)\n" ++
  "      request(Copy.new(path, initheader))\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a MKCOL request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Mkcol object\n" ++
  "    # created from string +path+, string +body+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   data = '\{\"userId\": 1, \"id\": 1, \"title\": \"delectus aut autem\", \"completed\": false\}'\n" ++
  "    #   http.mkcol('/todos/1', data)\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #\n" ++
  "    def mkcol(path, body = nil, initheader = nil)\n" ++
  "      request(Mkcol.new(path, initheader), body)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a TRACE request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Trace object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.trace('/todos/1')\n" ++
  "    #\n" ++
  "    def trace(path, initheader = nil)\n" ++
  "      request(Trace.new(path, initheader))\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a GET request to the server;\n" ++
  "    # forms the response into a Net::HTTPResponse object.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Get object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    # With no block given, returns the response object:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.request_get('/todos') # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # With a block given, calls the block with the response object\n" ++
  "    # and returns the response object:\n" ++
  "    #\n" ++
  "    #   http.request_get('/todos') do |res|\n" ++
  "    #     p res\n" ++
  "    #   end # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   #<Net::HTTPOK 200 OK readbody=false>\n" ++
  "    #\n" ++
  "    def request_get(path, initheader = nil, &block) # :yield: +response+\n" ++
  "      request(Get.new(path, initheader), &block)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a HEAD request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Head object\n" ++
  "    # created from string +path+ and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.head('/todos/1') # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    def request_head(path, initheader = nil, &block)\n" ++
  "      request(Head.new(path, initheader), &block)\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a POST request to the server;\n" ++
  "    # forms the response into a Net::HTTPResponse object.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Post object\n" ++
  "    # created from string +path+, string +data+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    # With no block given, returns the response object:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.post('/todos', 'xyzzy')\n" ++
  "    #   # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    # With a block given, calls the block with the response body\n" ++
  "    # and returns the response object:\n" ++
  "    #\n" ++
  "    #   http.post('/todos', 'xyzzy') do |res|\n" ++
  "    #     p res\n" ++
  "    #   end # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   \"\{\\n  \\\"xyzzy\\\": \\\"\\\",\\n  \\\"id\\\": 201\\n\}\"\n" ++
  "    #\n" ++
  "    def request_post(path, data, initheader = nil, &block) # :yield: +response+\n" ++
  "      request Post.new(path, initheader), data, &block\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends a PUT request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTP::Put object\n" ++
  "    # created from string +path+, string +data+, and initial headers hash +initheader+.\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.put('/todos/1', 'xyzzy')\n" ++
  "    #   # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    def request_put(path, data, initheader = nil, &block)   #:nodoc:\n" ++
  "      request Put.new(path, initheader), data, &block\n" ++
  "    end\n" ++
  "\n" ++
  "    alias get2   request_get    #:nodoc: obsolete\n" ++
  "    alias head2  request_head   #:nodoc: obsolete\n" ++
  "    alias post2  request_post   #:nodoc: obsolete\n" ++
  "    alias put2   request_put    #:nodoc: obsolete\n" ++
  "\n" ++
  "    # Sends an \\HTTP request to the server;\n" ++
  "    # returns an instance of a subclass of Net::HTTPResponse.\n" ++
  "    #\n" ++
  "    # The request is based on the Net::HTTPRequest object\n" ++
  "    # created from string +path+, string +data+, and initial headers hash +header+.\n" ++
  "    # That object is an instance of the\n" ++
  "    # \{subclass of Net::HTTPRequest\}[rdoc-ref:Net::HTTPRequest@Request+Subclasses],\n" ++
  "    # that corresponds to the given uppercase string +name+,\n" ++
  "    # which must be\n" ++
  "    # an \{HTTP request method\}[https://en.wikipedia.org/wiki/HTTP#Request_methods]\n" ++
  "    # or a \{WebDAV request method\}[https://en.wikipedia.org/wiki/WebDAV#Implementation].\n" ++
  "    #\n" ++
  "    # Examples:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #   http.send_request('GET', '/todos/1')\n" ++
  "    #   # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #   http.send_request('POST', '/todos', 'xyzzy')\n" ++
  "    #   # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    def send_request(name, path, data = nil, header = nil)\n" ++
  "      has_response_body = name != 'HEAD'\n" ++
  "      r = HTTPGenericRequest.new(name,(data ? true : false),has_response_body,path,header)\n" ++
  "      request r, data\n" ++
  "    end\n" ++
  "\n" ++
  "    # Sends the given request +req+ to the server;\n" ++
  "    # forms the response into a Net::HTTPResponse object.\n" ++
  "    #\n" ++
  "    # The given +req+ must be an instance of a\n" ++
  "    # \{subclass of Net::HTTPRequest\}[rdoc-ref:Net::HTTPRequest@Request+Subclasses].\n" ++
  "    # Argument +body+ should be given only if needed for the request.\n" ++
  "    #\n" ++
  "    # With no block given, returns the response object:\n" ++
  "    #\n" ++
  "    #   http = Net::HTTP.new(hostname)\n" ++
  "    #\n" ++
  "    #   req = Net::HTTP::Get.new('/todos/1')\n" ++
  "    #   http.request(req)\n" ++
  "    #   # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    #   req = Net::HTTP::Post.new('/todos')\n" ++
  "    #   http.request(req, 'xyzzy')\n" ++
  "    #   # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "    #\n" ++
  "    # With a block given, calls the block with the response and returns the response:\n" ++
  "    #\n" ++
  "    #   req = Net::HTTP::Get.new('/todos/1')\n" ++
  "    #   http.request(req) do |res|\n" ++
  "    #     p res\n" ++
  "    #   end # => #<Net::HTTPOK 200 OK readbody=true>\n" ++
  "    #\n" ++
  "    # Output:\n" ++
  "    #\n" ++
  "    #   #<Net::HTTPOK 200 OK readbody=false>\n" ++
  "    #\n" ++
  "    def request(req, body = nil, &block)  # :yield: +response+\n" ++
  "      unless started?\n" ++
  "        start \{\n" ++
  "          req['connection'] ||= 'close'\n" ++
  "          return request(req, body, &block)\n" ++
  "        \}\n" ++
  "      end\n" ++
  "      if proxy_user()\n" ++
  "        req.proxy_basic_auth proxy_user(), proxy_pass() unless use_ssl?\n" ++
  "      end\n" ++
  "      req.set_body_internal body\n" ++
  "      res = transport_request(req, &block)\n" ++
  "      if sspi_auth?(res)\n" ++
  "        sspi_auth(req)\n" ++
  "        res = transport_request(req, &block)\n" ++
  "      end\n" ++
  "      res\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    # Executes a request which uses a representation\n" ++
  "    # and returns its body.\n" ++
  "    def send_entity(path, data, initheader, dest, type, &block)\n" ++
  "      res = nil\n" ++
  "      request(type.new(path, initheader), data) \{|r|\n" ++
  "        r.read_body dest, &block\n" ++
  "        res = r\n" ++
  "      \}\n" ++
  "      res\n" ++
  "    end\n" ++
  "\n" ++
  "    # :stopdoc:\n" ++
  "\n" ++
  "    IDEMPOTENT_METHODS_ = %w/GET HEAD PUT DELETE OPTIONS TRACE/.freeze # :nodoc:\n" ++
  "\n" ++
  "    def transport_request(req)\n" ++
  "      count = 0\n" ++
  "      begin\n" ++
  "        begin_transport req\n" ++
  "        res = catch(:response) \{\n" ++
  "          begin\n" ++
  "            req.exec @socket, @curr_http_version, edit_path(req.path)\n" ++
  "          rescue Errno::EPIPE\n" ++
  "            # Failure when writing full request, but we can probably\n" ++
  "            # still read the received response.\n" ++
  "          end\n" ++
  "\n" ++
  "          begin\n" ++
  "            res = HTTPResponse.read_new(@socket)\n" ++
  "            res.decode_content = req.decode_content\n" ++
  "            res.body_encoding = @response_body_encoding\n" ++
  "            res.ignore_eof = @ignore_eof\n" ++
  "          end while res.kind_of?(HTTPInformation)\n" ++
  "\n" ++
  "          res.uri = req.uri\n" ++
  "\n" ++
  "          res\n" ++
  "        \}\n" ++
  "        res.reading_body(@socket, req.response_body_permitted?) \{\n" ++
  "          if block_given?\n" ++
  "            count = max_retries # Don't restart in the middle of a download\n" ++
  "            yield res\n" ++
  "          end\n" ++
  "        \}\n" ++
  "      rescue Net::OpenTimeout\n" ++
  "        raise\n" ++
  "      rescue Net::ReadTimeout, IOError, EOFError,\n" ++
  "             Errno::ECONNRESET, Errno::ECONNABORTED, Errno::EPIPE, Errno::ETIMEDOUT,\n" ++
  "             # avoid a dependency on OpenSSL\n" ++
  "             defined?(OpenSSL::SSL) ? OpenSSL::SSL::SSLError : IOError,\n" ++
  "             Timeout::Error => exception\n" ++
  "        if count < max_retries && IDEMPOTENT_METHODS_.include?(req.method)\n" ++
  "          count += 1\n" ++
  "          @socket.close if @socket\n" ++
  "          debug \"Conn close because of error #\{exception\}, and retry\"\n" ++
  "          retry\n" ++
  "        end\n" ++
  "        debug \"Conn close because of error #\{exception\}\"\n" ++
  "        @socket.close if @socket\n" ++
  "        raise\n" ++
  "      end\n" ++
  "\n" ++
  "      end_transport req, res\n" ++
  "      res\n" ++
  "    rescue => exception\n" ++
  "      debug \"Conn close because of error #\{exception\}\"\n" ++
  "      @socket.close if @socket\n" ++
  "      raise exception\n" ++
  "    end\n" ++
  "\n" ++
  "    def begin_transport(req)\n" ++
  "      if @socket.closed?\n" ++
  "        connect\n" ++
  "      elsif @last_communicated\n" ++
  "        if @last_communicated + @keep_alive_timeout < Process.clock_gettime(Process::CLOCK_MONOTONIC)\n" ++
  "          debug 'Conn close because of keep_alive_timeout'\n" ++
  "          @socket.close\n" ++
  "          connect\n" ++
  "        elsif @socket.io.to_io.wait_readable(0) && @socket.eof?\n" ++
  "          debug \"Conn close because of EOF\"\n" ++
  "          @socket.close\n" ++
  "          connect\n" ++
  "        end\n" ++
  "      end\n" ++
  "\n" ++
  "      if not req.response_body_permitted? and @close_on_empty_response\n" ++
  "        req['connection'] ||= 'close'\n" ++
  "      end\n" ++
  "\n" ++
  "      req.update_uri address, port, use_ssl?\n" ++
  "      req['host'] ||= addr_port()\n" ++
  "    end\n" ++
  "\n" ++
  "    def end_transport(req, res)\n" ++
  "      @curr_http_version = res.http_version\n" ++
  "      @last_communicated = nil\n" ++
  "      if @socket.closed?\n" ++
  "        debug 'Conn socket closed'\n" ++
  "      elsif not res.body and @close_on_empty_response\n" ++
  "        debug 'Conn close'\n" ++
  "        @socket.close\n" ++
  "      elsif keep_alive?(req, res)\n" ++
  "        debug 'Conn keep-alive'\n" ++
  "        @last_communicated = Process.clock_gettime(Process::CLOCK_MONOTONIC)\n" ++
  "      else\n" ++
  "        debug 'Conn close'\n" ++
  "        @socket.close\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def keep_alive?(req, res)\n" ++
  "      return false if req.connection_close?\n" ++
  "      if @curr_http_version <= '1.0'\n" ++
  "        res.connection_keep_alive?\n" ++
  "      else   # HTTP/1.1 or later\n" ++
  "        not res.connection_close?\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def sspi_auth?(res)\n" ++
  "      return false unless @sspi_enabled\n" ++
  "      if res.kind_of?(HTTPProxyAuthenticationRequired) and\n" ++
  "          proxy? and res[\"Proxy-Authenticate\"].include?(\"Negotiate\")\n" ++
  "        begin\n" ++
  "          require 'win32/sspi'\n" ++
  "          true\n" ++
  "        rescue LoadError\n" ++
  "          false\n" ++
  "        end\n" ++
  "      else\n" ++
  "        false\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def sspi_auth(req)\n" ++
  "      n = Win32::SSPI::NegotiateAuth.new\n" ++
  "      req[\"Proxy-Authorization\"] = \"Negotiate #\{n.get_initial_token\}\"\n" ++
  "      # Some versions of ISA will close the connection if this isn't present.\n" ++
  "      req[\"Connection\"] = \"Keep-Alive\"\n" ++
  "      req[\"Proxy-Connection\"] = \"Keep-Alive\"\n" ++
  "      res = transport_request(req)\n" ++
  "      authphrase = res[\"Proxy-Authenticate\"]  or return res\n" ++
  "      req[\"Proxy-Authorization\"] = \"Negotiate #\{n.complete_authentication(authphrase)\}\"\n" ++
  "    rescue => err\n" ++
  "      raise HTTPAuthenticationError.new('HTTP authentication failed', err)\n" ++
  "    end\n" ++
  "\n" ++
  "    #\n" ++
  "    # utils\n" ++
  "    #\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    def addr_port\n" ++
  "      addr = address\n" ++
  "      addr = \"[#\{addr\}]\" if addr.include?(\":\")\n" ++
  "      default_port = use_ssl? ? HTTP.https_default_port : HTTP.http_default_port\n" ++
  "      default_port == port ? addr : \"#\{addr\}:#\{port\}\"\n" ++
  "    end\n" ++
  "\n" ++
  "    # Adds a message to debugging output\n" ++
  "    def debug(msg)\n" ++
  "      return unless @debug_output\n" ++
  "      @debug_output << msg\n" ++
  "      @debug_output << \"\\n\"\n" ++
  "    end\n" ++
  "\n" ++
  "    alias_method :D, :debug\n" ++
  "  end\n" ++
  "\n" ++
  "  # for backward compatibility until Ruby 4.0\n" ++
  "  # https://bugs.ruby-lang.org/issues/20900\n" ++
  "  # https://github.com/bblimke/webmock/pull/1081\n" ++
  "  HTTPSession = HTTP\n" ++
  "  deprecate_constant :HTTPSession\n" ++
  "end\n" ++
  "\n" ++
  "require_relative 'http/exceptions'\n" ++
  "\n" ++
  "require_relative 'http/header'\n" ++
  "\n" ++
  "require_relative 'http/generic_request'\n" ++
  "require_relative 'http/request'\n" ++
  "require_relative 'http/requests'\n" ++
  "\n" ++
  "require_relative 'http/response'\n" ++
  "require_relative 'http/responses'\n" ++
  "\n" ++
  "require_relative 'http/proxy_delta'\n";
let network_source_2 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "module Net\n" ++
  "  # Net::HTTP exception class.\n" ++
  "  # You cannot use Net::HTTPExceptions directly; instead, you must use\n" ++
  "  # its subclasses.\n" ++
  "  module HTTPExceptions # :nodoc:\n" ++
  "    def initialize(msg, res)   #:nodoc:\n" ++
  "      super msg\n" ++
  "      @response = res\n" ++
  "    end\n" ++
  "    attr_reader :response\n" ++
  "    alias data response    #:nodoc: obsolete\n" ++
  "  end\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  class HTTPError < ProtocolError\n" ++
  "    include HTTPExceptions\n" ++
  "  end\n" ++
  "\n" ++
  "  class HTTPRetriableError < ProtoRetriableError\n" ++
  "    include HTTPExceptions\n" ++
  "  end\n" ++
  "\n" ++
  "  class HTTPClientException < ProtoServerError\n" ++
  "    include HTTPExceptions\n" ++
  "  end\n" ++
  "\n" ++
  "  class HTTPFatalError < ProtoFatalError\n" ++
  "    include HTTPExceptions\n" ++
  "  end\n" ++
  "\n" ++
  "  # We cannot use the name \"HTTPServerError\", it is the name of the response.\n" ++
  "  HTTPServerException = HTTPClientException # :nodoc:\n" ++
  "  deprecate_constant(:HTTPServerException)\n" ++
  "end\n";
let network_source_3 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "#\n" ++
  "# \\HTTPGenericRequest is the parent of the Net::HTTPRequest class.\n" ++
  "#\n" ++
  "# Do not use this directly; instead, use a subclass of Net::HTTPRequest.\n" ++
  "#\n" ++
  "# == About the Examples\n" ++
  "#\n" ++
  "# :include: doc/net-http/examples.rdoc\n" ++
  "#\n" ++
  "class Net::HTTPGenericRequest\n" ++
  "\n" ++
  "  include Net::HTTPHeader\n" ++
  "\n" ++
  "  def initialize(m, reqbody, resbody, uri_or_path, initheader = nil) # :nodoc:\n" ++
  "    @method = m\n" ++
  "    @request_has_body = reqbody\n" ++
  "    @response_has_body = resbody\n" ++
  "\n" ++
  "    if URI === uri_or_path then\n" ++
  "      raise ArgumentError, \"not an HTTP URI\" unless URI::HTTP === uri_or_path\n" ++
  "      hostname = uri_or_path.host\n" ++
  "      raise ArgumentError, \"no host component for URI\" unless (hostname && hostname.length > 0)\n" ++
  "      @uri = uri_or_path.dup\n" ++
  "      @path = uri_or_path.request_uri\n" ++
  "      raise ArgumentError, \"no HTTP request path given\" unless @path\n" ++
  "    else\n" ++
  "      @uri = nil\n" ++
  "      raise ArgumentError, \"no HTTP request path given\" unless uri_or_path\n" ++
  "      raise ArgumentError, \"HTTP request path is empty\" if uri_or_path.empty?\n" ++
  "      @path = uri_or_path.dup\n" ++
  "    end\n" ++
  "\n" ++
  "    @decode_content = false\n" ++
  "\n" ++
  "    if Net::HTTP::HAVE_ZLIB then\n" ++
  "      if !initheader ||\n" ++
  "         !initheader.keys.any? \{ |k|\n" ++
  "           %w[accept-encoding range].include? k.downcase\n" ++
  "         \} then\n" ++
  "        @decode_content = true if @response_has_body\n" ++
  "        initheader = initheader ? initheader.dup : \{\}\n" ++
  "        initheader[\"accept-encoding\"] =\n" ++
  "          \"gzip;q=1.0,deflate;q=0.6,identity;q=0.3\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    initialize_http_header initheader\n" ++
  "    self['Accept'] ||= '*/*'\n" ++
  "    self['User-Agent'] ||= 'Ruby'\n" ++
  "    self['Host'] ||= @uri.authority if @uri\n" ++
  "    @body = nil\n" ++
  "    @body_stream = nil\n" ++
  "    @body_data = nil\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the string method name for the request:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Get.new(uri).method  # => \"GET\"\n" ++
  "  #   Net::HTTP::Post.new(uri).method # => \"POST\"\n" ++
  "  #\n" ++
  "  attr_reader :method\n" ++
  "\n" ++
  "  # Returns the string path for the request:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Get.new(uri).path # => \"/\"\n" ++
  "  #   Net::HTTP::Post.new('example.com').path # => \"example.com\"\n" ++
  "  #\n" ++
  "  attr_reader :path\n" ++
  "\n" ++
  "  # Returns the URI object for the request, or +nil+ if none:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Get.new(uri).uri\n" ++
  "  #   # => #<URI::HTTPS https://jsonplaceholder.typicode.com/>\n" ++
  "  #   Net::HTTP::Get.new('example.com').uri # => nil\n" ++
  "  #\n" ++
  "  attr_reader :uri\n" ++
  "\n" ++
  "  # Returns +false+ if the request's header <tt>'Accept-Encoding'</tt>\n" ++
  "  # has been set manually or deleted\n" ++
  "  # (indicating that the user intends to handle encoding in the response),\n" ++
  "  # +true+ otherwise:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri) # => #<Net::HTTP::Get GET>\n" ++
  "  #   req['Accept-Encoding']        # => \"gzip;q=1.0,deflate;q=0.6,identity;q=0.3\"\n" ++
  "  #   req.decode_content            # => true\n" ++
  "  #   req['Accept-Encoding'] = 'foo'\n" ++
  "  #   req.decode_content            # => false\n" ++
  "  #   req.delete('Accept-Encoding')\n" ++
  "  #   req.decode_content            # => false\n" ++
  "  #\n" ++
  "  attr_reader :decode_content\n" ++
  "\n" ++
  "  # Returns a string representation of the request:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Post.new(uri).inspect # => \"#<Net::HTTP::Post POST>\"\n" ++
  "  #\n" ++
  "  def inspect\n" ++
  "    \"\\#<#\{self.class\} #\{@method\}>\"\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns a string representation of the request with the details for pp:\n" ++
  "  #\n" ++
  "  #   require 'pp'\n" ++
  "  #   post = Net::HTTP::Post.new(uri)\n" ++
  "  #   post.inspect # => \"#<Net::HTTP::Post POST>\"\n" ++
  "  #   post.pretty_inspect\n" ++
  "  #   # => #<Net::HTTP::Post\n" ++
  "  #         POST\n" ++
  "  #         path=\"/\"\n" ++
  "  #         headers=\{\"accept-encoding\" => [\"gzip;q=1.0,deflate;q=0.6,identity;q=0.3\"],\n" ++
  "  #          \"accept\" => [\"*/*\"],\n" ++
  "  #          \"user-agent\" => [\"Ruby\"],\n" ++
  "  #          \"host\" => [\"www.ruby-lang.org\"]\}>\n" ++
  "  #\n" ++
  "  def pretty_print(q)\n" ++
  "    q.object_group(self) \{\n" ++
  "      q.breakable\n" ++
  "      q.text @method\n" ++
  "      q.breakable\n" ++
  "      q.text \"path=\"; q.pp @path\n" ++
  "      q.breakable\n" ++
  "      q.text \"headers=\"; q.pp to_hash\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Don't automatically decode response content-encoding if the user indicates\n" ++
  "  # they want to handle it.\n" ++
  "\n" ++
  "  def []=(key, val) # :nodoc:\n" ++
  "    @decode_content = false if key.downcase == 'accept-encoding'\n" ++
  "\n" ++
  "    super key, val\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns whether the request may have a body:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Post.new(uri).request_body_permitted? # => true\n" ++
  "  #   Net::HTTP::Get.new(uri).request_body_permitted?  # => false\n" ++
  "  #\n" ++
  "  def request_body_permitted?\n" ++
  "    @request_has_body\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns whether the response may have a body:\n" ++
  "  #\n" ++
  "  #   Net::HTTP::Post.new(uri).response_body_permitted? # => true\n" ++
  "  #   Net::HTTP::Head.new(uri).response_body_permitted? # => false\n" ++
  "  #\n" ++
  "  def response_body_permitted?\n" ++
  "    @response_has_body\n" ++
  "  end\n" ++
  "\n" ++
  "  def body_exist? # :nodoc:\n" ++
  "    warn \"Net::HTTPRequest#body_exist? is obsolete; use response_body_permitted?\", uplevel: 1 if $VERBOSE\n" ++
  "    response_body_permitted?\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the string body for the request, or +nil+ if there is none:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Post.new(uri)\n" ++
  "  #   req.body # => nil\n" ++
  "  #   req.body = '\{\"title\": \"foo\",\"body\": \"bar\",\"userId\": 1\}'\n" ++
  "  #   req.body # => \"\{\\\"title\\\": \\\"foo\\\",\\\"body\\\": \\\"bar\\\",\\\"userId\\\": 1\}\"\n" ++
  "  #\n" ++
  "  attr_reader :body\n" ++
  "\n" ++
  "  # Sets the body for the request:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Post.new(uri)\n" ++
  "  #   req.body # => nil\n" ++
  "  #   req.body = '\{\"title\": \"foo\",\"body\": \"bar\",\"userId\": 1\}'\n" ++
  "  #   req.body # => \"\{\\\"title\\\": \\\"foo\\\",\\\"body\\\": \\\"bar\\\",\\\"userId\\\": 1\}\"\n" ++
  "  #\n" ++
  "  def body=(str)\n" ++
  "    @body = str\n" ++
  "    @body_stream = nil\n" ++
  "    @body_data = nil\n" ++
  "    str\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the body stream object for the request, or +nil+ if there is none:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Post.new(uri)          # => #<Net::HTTP::Post POST>\n" ++
  "  #   req.body_stream                         # => nil\n" ++
  "  #   require 'stringio'\n" ++
  "  #   req.body_stream = StringIO.new('xyzzy') # => #<StringIO:0x0000027d1e5affa8>\n" ++
  "  #   req.body_stream                         # => #<StringIO:0x0000027d1e5affa8>\n" ++
  "  #\n" ++
  "  attr_reader :body_stream\n" ++
  "\n" ++
  "  # Sets the body stream for the request:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Post.new(uri)          # => #<Net::HTTP::Post POST>\n" ++
  "  #   req.body_stream                         # => nil\n" ++
  "  #   require 'stringio'\n" ++
  "  #   req.body_stream = StringIO.new('xyzzy') # => #<StringIO:0x0000027d1e5affa8>\n" ++
  "  #   req.body_stream                         # => #<StringIO:0x0000027d1e5affa8>\n" ++
  "  #\n" ++
  "  def body_stream=(input)\n" ++
  "    @body = nil\n" ++
  "    @body_stream = input\n" ++
  "    @body_data = nil\n" ++
  "    input\n" ++
  "  end\n" ++
  "\n" ++
  "  def set_body_internal(str)   #:nodoc: internal use only\n" ++
  "    raise ArgumentError, \"both of body argument and HTTPRequest#body set\" if str and (@body or @body_stream)\n" ++
  "    self.body = str if str\n" ++
  "    if @body.nil? && @body_stream.nil? && @body_data.nil? && request_body_permitted?\n" ++
  "      self.body = ''\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  #\n" ++
  "  # write\n" ++
  "  #\n" ++
  "\n" ++
  "  def exec(sock, ver, path)   #:nodoc: internal use only\n" ++
  "    if @body\n" ++
  "      send_request_with_body sock, ver, path, @body\n" ++
  "    elsif @body_stream\n" ++
  "      send_request_with_body_stream sock, ver, path, @body_stream\n" ++
  "    elsif @body_data\n" ++
  "      send_request_with_body_data sock, ver, path, @body_data\n" ++
  "    else\n" ++
  "      write_header sock, ver, path\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def update_uri(addr, port, ssl) # :nodoc: internal use only\n" ++
  "    # reflect the connection and @path to @uri\n" ++
  "    return unless @uri\n" ++
  "\n" ++
  "    if ssl\n" ++
  "      scheme = 'https'\n" ++
  "      klass = URI::HTTPS\n" ++
  "    else\n" ++
  "      scheme = 'http'\n" ++
  "      klass = URI::HTTP\n" ++
  "    end\n" ++
  "\n" ++
  "    if host = self['host']\n" ++
  "      host = URI.parse(\"//#\{host\}\").host # Remove a port component from the existing Host header\n" ++
  "    elsif host = @uri.host\n" ++
  "    else\n" ++
  "     host = addr\n" ++
  "    end\n" ++
  "    # convert the class of the URI\n" ++
  "    if @uri.is_a?(klass)\n" ++
  "      @uri.host = host\n" ++
  "      @uri.port = port\n" ++
  "    else\n" ++
  "      @uri = klass.new(\n" ++
  "        scheme, @uri.userinfo,\n" ++
  "        host, port, nil,\n" ++
  "        @uri.path, nil, @uri.query, nil)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  private\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "\n" ++
  "  class Chunker #:nodoc:\n" ++
  "    def initialize(sock)\n" ++
  "      @sock = sock\n" ++
  "      @prev = nil\n" ++
  "    end\n" ++
  "\n" ++
  "    def write(buf)\n" ++
  "      # avoid memcpy() of buf, buf can huge and eat memory bandwidth\n" ++
  "      rv = buf.bytesize\n" ++
  "      @sock.write(\"#\{rv.to_s(16)\}\\r\\n\", buf, \"\\r\\n\")\n" ++
  "      rv\n" ++
  "    end\n" ++
  "\n" ++
  "    def finish\n" ++
  "      @sock.write(\"0\\r\\n\\r\\n\")\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def send_request_with_body(sock, ver, path, body)\n" ++
  "    self.content_length = body.bytesize\n" ++
  "    delete 'Transfer-Encoding'\n" ++
  "    write_header sock, ver, path\n" ++
  "    wait_for_continue sock, ver if sock.continue_timeout\n" ++
  "    sock.write body\n" ++
  "  end\n" ++
  "\n" ++
  "  def send_request_with_body_stream(sock, ver, path, f)\n" ++
  "    unless content_length() or chunked?\n" ++
  "      raise ArgumentError,\n" ++
  "          \"Content-Length not given and Transfer-Encoding is not `chunked'\"\n" ++
  "    end\n" ++
  "    write_header sock, ver, path\n" ++
  "    wait_for_continue sock, ver if sock.continue_timeout\n" ++
  "    if chunked?\n" ++
  "      chunker = Chunker.new(sock)\n" ++
  "      IO.copy_stream(f, chunker)\n" ++
  "      chunker.finish\n" ++
  "    else\n" ++
  "      IO.copy_stream(f, sock)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def send_request_with_body_data(sock, ver, path, params)\n" ++
  "    if /\\Amultipart\\/form-data\\z/i !~ self.content_type\n" ++
  "      self.content_type = 'application/x-www-form-urlencoded'\n" ++
  "      return send_request_with_body(sock, ver, path, URI.encode_www_form(params))\n" ++
  "    end\n" ++
  "\n" ++
  "    opt = @form_option.dup\n" ++
  "    require 'securerandom' unless defined?(SecureRandom)\n" ++
  "    opt[:boundary] ||= SecureRandom.urlsafe_base64(40)\n" ++
  "    self.set_content_type(self.content_type, boundary: opt[:boundary])\n" ++
  "    if chunked?\n" ++
  "      write_header sock, ver, path\n" ++
  "      encode_multipart_form_data(sock, params, opt)\n" ++
  "    else\n" ++
  "      require 'tempfile'\n" ++
  "      file = Tempfile.new('multipart')\n" ++
  "      file.binmode\n" ++
  "      encode_multipart_form_data(file, params, opt)\n" ++
  "      file.rewind\n" ++
  "      self.content_length = file.size\n" ++
  "      write_header sock, ver, path\n" ++
  "      IO.copy_stream(file, sock)\n" ++
  "      file.close(true)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def encode_multipart_form_data(out, params, opt)\n" ++
  "    charset = opt[:charset]\n" ++
  "    boundary = opt[:boundary]\n" ++
  "    require 'securerandom' unless defined?(SecureRandom)\n" ++
  "    boundary ||= SecureRandom.urlsafe_base64(40)\n" ++
  "    chunked_p = chunked?\n" ++
  "\n" ++
  "    buf = +''\n" ++
  "    params.each do |key, value, h=\{\}|\n" ++
  "      key = quote_string(key, charset)\n" ++
  "      filename =\n" ++
  "        h.key?(:filename) ? h[:filename] :\n" ++
  "        value.respond_to?(:to_path) ? File.basename(value.to_path) :\n" ++
  "        nil\n" ++
  "\n" ++
  "      buf << \"--#\{boundary\}\\r\\n\"\n" ++
  "      if filename\n" ++
  "        filename = quote_string(filename, charset)\n" ++
  "        type = h[:content_type] || 'application/octet-stream'\n" ++
  "        buf << \"Content-Disposition: form-data; \" \\\n" ++
  "          \"name=\\\"#\{key\}\\\"; filename=\\\"#\{filename\}\\\"\\r\\n\" \\\n" ++
  "          \"Content-Type: #\{type\}\\r\\n\\r\\n\"\n" ++
  "        if !out.respond_to?(:write) || !value.respond_to?(:read)\n" ++
  "          # if +out+ is not an IO or +value+ is not an IO\n" ++
  "          buf << (value.respond_to?(:read) ? value.read : value)\n" ++
  "        elsif value.respond_to?(:size) && chunked_p\n" ++
  "          # if +out+ is an IO and +value+ is a File, use IO.copy_stream\n" ++
  "          flush_buffer(out, buf, chunked_p)\n" ++
  "          out << \"%x\\r\\n\" % value.size if chunked_p\n" ++
  "          IO.copy_stream(value, out)\n" ++
  "          out << \"\\r\\n\" if chunked_p\n" ++
  "        else\n" ++
  "          # +out+ is an IO, and +value+ is not a File but an IO\n" ++
  "          flush_buffer(out, buf, chunked_p)\n" ++
  "          1 while flush_buffer(out, value.read(4096), chunked_p)\n" ++
  "        end\n" ++
  "      else\n" ++
  "        # non-file field:\n" ++
  "        #   HTML5 says, \"The parts of the generated multipart/form-data\n" ++
  "        #   resource that correspond to non-file fields must not have a\n" ++
  "        #   Content-Type header specified.\"\n" ++
  "        buf << \"Content-Disposition: form-data; name=\\\"#\{key\}\\\"\\r\\n\\r\\n\"\n" ++
  "        buf << (value.respond_to?(:read) ? value.read : value)\n" ++
  "      end\n" ++
  "      buf << \"\\r\\n\"\n" ++
  "    end\n" ++
  "    buf << \"--#\{boundary\}--\\r\\n\"\n" ++
  "    flush_buffer(out, buf, chunked_p)\n" ++
  "    out << \"0\\r\\n\\r\\n\" if chunked_p\n" ++
  "  end\n" ++
  "\n" ++
  "  def quote_string(str, charset)\n" ++
  "    str = str.encode(charset, fallback:->(c)\{'&#%d;'%c.encode(\"UTF-8\").ord\}) if charset\n" ++
  "    str.gsub(/[\\\\\"]/, '\\\\\\\\\\&')\n" ++
  "  end\n" ++
  "\n" ++
  "  def flush_buffer(out, buf, chunked_p)\n" ++
  "    return unless buf\n" ++
  "    out << \"%x\\r\\n\"%buf.bytesize if chunked_p\n" ++
  "    out << buf\n" ++
  "    out << \"\\r\\n\" if chunked_p\n" ++
  "    buf.clear\n" ++
  "  end\n" ++
  "\n" ++
  "  ##\n" ++
  "  # Waits up to the continue timeout for a response from the server provided\n" ++
  "  # we're speaking HTTP 1.1 and are expecting a 100-continue response.\n" ++
  "\n" ++
  "  def wait_for_continue(sock, ver)\n" ++
  "    if ver >= '1.1' and @header['expect'] and\n" ++
  "        @header['expect'].include?('100-continue')\n" ++
  "      if sock.io.to_io.wait_readable(sock.continue_timeout)\n" ++
  "        res = Net::HTTPResponse.read_new(sock)\n" ++
  "        unless res.kind_of?(Net::HTTPContinue)\n" ++
  "          res.decode_content = @decode_content\n" ++
  "          throw :response, res\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def write_header(sock, ver, path)\n" ++
  "    reqline = \"#\{@method\} #\{path\} HTTP/#\{ver\}\"\n" ++
  "    if /[\\r\\n]/ =~ reqline\n" ++
  "      raise ArgumentError, \"A Request-Line must not contain CR or LF\"\n" ++
  "    end\n" ++
  "    buf = +''\n" ++
  "    buf << reqline << \"\\r\\n\"\n" ++
  "    each_capitalized do |k,v|\n" ++
  "      buf << \"#\{k\}: #\{v\}\\r\\n\"\n" ++
  "    end\n" ++
  "    buf << \"\\r\\n\"\n" ++
  "    sock.write buf\n" ++
  "  end\n" ++
  "\n" ++
  "end\n";
let network_source_4 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "#\n" ++
  "# The \\HTTPHeader module provides access to \\HTTP headers.\n" ++
  "#\n" ++
  "# The module is included in:\n" ++
  "#\n" ++
  "# - Net::HTTPGenericRequest (and therefore Net::HTTPRequest).\n" ++
  "# - Net::HTTPResponse.\n" ++
  "#\n" ++
  "# The headers are a hash-like collection of key/value pairs called _fields_.\n" ++
  "#\n" ++
  "# == Request and Response Fields\n" ++
  "#\n" ++
  "# Headers may be included in:\n" ++
  "#\n" ++
  "# - A Net::HTTPRequest object:\n" ++
  "#   the object's headers will be sent with the request.\n" ++
  "#   Any fields may be defined in the request;\n" ++
  "#   see \{Setters\}[rdoc-ref:Net::HTTPHeader@Setters].\n" ++
  "# - A Net::HTTPResponse object:\n" ++
  "#   the objects headers are usually those returned from the host.\n" ++
  "#   Fields may be retrieved from the object;\n" ++
  "#   see \{Getters\}[rdoc-ref:Net::HTTPHeader@Getters]\n" ++
  "#   and \{Iterators\}[rdoc-ref:Net::HTTPHeader@Iterators].\n" ++
  "#\n" ++
  "# Exactly which fields should be sent or expected depends on the host;\n" ++
  "# see:\n" ++
  "#\n" ++
  "# - \{Request fields\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#Request_fields].\n" ++
  "# - \{Response fields\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#Response_fields].\n" ++
  "#\n" ++
  "# == About the Examples\n" ++
  "#\n" ++
  "# :include: doc/net-http/examples.rdoc\n" ++
  "#\n" ++
  "# == Fields\n" ++
  "#\n" ++
  "# A header field is a key/value pair.\n" ++
  "#\n" ++
  "# === Field Keys\n" ++
  "#\n" ++
  "# A field key may be:\n" ++
  "#\n" ++
  "# - A string: Key <tt>'Accept'</tt> is treated as if it were\n" ++
  "#   <tt>'Accept'.downcase</tt>;  i.e., <tt>'accept'</tt>.\n" ++
  "# - A symbol: Key <tt>:Accept</tt> is treated as if it were\n" ++
  "#   <tt>:Accept.to_s.downcase</tt>;  i.e., <tt>'accept'</tt>.\n" ++
  "#\n" ++
  "# Examples:\n" ++
  "#\n" ++
  "#   req = Net::HTTP::Get.new(uri)\n" ++
  "#   req[:accept]  # => \"*/*\"\n" ++
  "#   req['Accept'] # => \"*/*\"\n" ++
  "#   req['ACCEPT'] # => \"*/*\"\n" ++
  "#\n" ++
  "#   req['accept'] = 'text/html'\n" ++
  "#   req[:accept] = 'text/html'\n" ++
  "#   req['ACCEPT'] = 'text/html'\n" ++
  "#\n" ++
  "# === Field Values\n" ++
  "#\n" ++
  "# A field value may be returned as an array of strings or as a string:\n" ++
  "#\n" ++
  "# - These methods return field values as arrays:\n" ++
  "#\n" ++
  "#   - #get_fields: Returns the array value for the given key,\n" ++
  "#     or +nil+ if it does not exist.\n" ++
  "#   - #to_hash: Returns a hash of all header fields:\n" ++
  "#     each key is a field name; its value is the array value for the field.\n" ++
  "#\n" ++
  "# - These methods return field values as string;\n" ++
  "#   the string value for a field is equivalent to\n" ++
  "#   <tt>self[key.downcase.to_s].join(', '))</tt>:\n" ++
  "#\n" ++
  "#   - #[]: Returns the string value for the given key,\n" ++
  "#     or +nil+ if it does not exist.\n" ++
  "#   - #fetch: Like #[], but accepts a default value\n" ++
  "#     to be returned if the key does not exist.\n" ++
  "#\n" ++
  "# The field value may be set:\n" ++
  "#\n" ++
  "# - #[]=: Sets the value for the given key;\n" ++
  "#   the given value may be a string, a symbol, an array, or a hash.\n" ++
  "# - #add_field: Adds a given value to a value for the given key\n" ++
  "#   (not overwriting the existing value).\n" ++
  "# - #delete: Deletes the field for the given key.\n" ++
  "#\n" ++
  "# Example field values:\n" ++
  "#\n" ++
  "# - \\String:\n" ++
  "#\n" ++
  "#     req['Accept'] = 'text/html' # => \"text/html\"\n" ++
  "#     req['Accept']               # => \"text/html\"\n" ++
  "#     req.get_fields('Accept')    # => [\"text/html\"]\n" ++
  "#\n" ++
  "# - \\Symbol:\n" ++
  "#\n" ++
  "#     req['Accept'] = :text    # => :text\n" ++
  "#     req['Accept']            # => \"text\"\n" ++
  "#     req.get_fields('Accept') # => [\"text\"]\n" ++
  "#\n" ++
  "# - Simple array:\n" ++
  "#\n" ++
  "#     req[:foo] = %w[bar baz bat]\n" ++
  "#     req[:foo]            # => \"bar, baz, bat\"\n" ++
  "#     req.get_fields(:foo) # => [\"bar\", \"baz\", \"bat\"]\n" ++
  "#\n" ++
  "# - Simple hash:\n" ++
  "#\n" ++
  "#     req[:foo] = \{bar: 0, baz: 1, bat: 2\}\n" ++
  "#     req[:foo]            # => \"bar, 0, baz, 1, bat, 2\"\n" ++
  "#     req.get_fields(:foo) # => [\"bar\", \"0\", \"baz\", \"1\", \"bat\", \"2\"]\n" ++
  "#\n" ++
  "# - Nested:\n" ++
  "#\n" ++
  "#     req[:foo] = [%w[bar baz], \{bat: 0, bam: 1\}]\n" ++
  "#     req[:foo]            # => \"bar, baz, bat, 0, bam, 1\"\n" ++
  "#     req.get_fields(:foo) # => [\"bar\", \"baz\", \"bat\", \"0\", \"bam\", \"1\"]\n" ++
  "#\n" ++
  "#     req[:foo] = \{bar: %w[baz bat], bam: \{bah: 0, bad: 1\}\}\n" ++
  "#     req[:foo]            # => \"bar, baz, bat, bam, bah, 0, bad, 1\"\n" ++
  "#     req.get_fields(:foo) # => [\"bar\", \"baz\", \"bat\", \"bam\", \"bah\", \"0\", \"bad\", \"1\"]\n" ++
  "#\n" ++
  "# == Convenience Methods\n" ++
  "#\n" ++
  "# Various convenience methods retrieve values, set values, query values,\n" ++
  "# set form values, or iterate over fields.\n" ++
  "#\n" ++
  "# === Setters\n" ++
  "#\n" ++
  "# \\Method #[]= can set any field, but does little to validate the new value;\n" ++
  "# some of the other setter methods provide some validation:\n" ++
  "#\n" ++
  "# - #[]=: Sets the string or array value for the given key.\n" ++
  "# - #add_field: Creates or adds to the array value for the given key.\n" ++
  "# - #basic_auth: Sets the string authorization header for <tt>'Authorization'</tt>.\n" ++
  "# - #content_length=: Sets the integer length for field <tt>'Content-Length</tt>.\n" ++
  "# - #content_type=: Sets the string value for field <tt>'Content-Type'</tt>.\n" ++
  "# - #proxy_basic_auth: Sets the string authorization header for <tt>'Proxy-Authorization'</tt>.\n" ++
  "# - #set_range: Sets the value for field <tt>'Range'</tt>.\n" ++
  "#\n" ++
  "# === Form Setters\n" ++
  "#\n" ++
  "# - #set_form: Sets an HTML form data set.\n" ++
  "# - #set_form_data: Sets header fields and a body from HTML form data.\n" ++
  "#\n" ++
  "# === Getters\n" ++
  "#\n" ++
  "# \\Method #[] can retrieve the value of any field that exists,\n" ++
  "# but always as a string;\n" ++
  "# some of the other getter methods return something different\n" ++
  "# from the simple string value:\n" ++
  "#\n" ++
  "# - #[]: Returns the string field value for the given key.\n" ++
  "# - #content_length: Returns the integer value of field <tt>'Content-Length'</tt>.\n" ++
  "# - #content_range: Returns the Range value of field <tt>'Content-Range'</tt>.\n" ++
  "# - #content_type: Returns the string value of field <tt>'Content-Type'</tt>.\n" ++
  "# - #fetch: Returns the string field value for the given key.\n" ++
  "# - #get_fields: Returns the array field value for the given +key+.\n" ++
  "# - #main_type: Returns first part of the string value of field <tt>'Content-Type'</tt>.\n" ++
  "# - #sub_type: Returns second part of the string value of field <tt>'Content-Type'</tt>.\n" ++
  "# - #range: Returns an array of Range objects of field <tt>'Range'</tt>, or +nil+.\n" ++
  "# - #range_length: Returns the integer length of the range given in field <tt>'Content-Range'</tt>.\n" ++
  "# - #type_params: Returns the string parameters for <tt>'Content-Type'</tt>.\n" ++
  "#\n" ++
  "# === Queries\n" ++
  "#\n" ++
  "# - #chunked?: Returns whether field <tt>'Transfer-Encoding'</tt> is set to <tt>'chunked'</tt>.\n" ++
  "# - #connection_close?: Returns whether field <tt>'Connection'</tt> is set to <tt>'close'</tt>.\n" ++
  "# - #connection_keep_alive?: Returns whether field <tt>'Connection'</tt> is set to <tt>'keep-alive'</tt>.\n" ++
  "# - #key?: Returns whether a given key exists.\n" ++
  "#\n" ++
  "# === Iterators\n" ++
  "#\n" ++
  "# - #each_capitalized: Passes each field capitalized-name/value pair to the block.\n" ++
  "# - #each_capitalized_name: Passes each capitalized field name to the block.\n" ++
  "# - #each_header: Passes each field name/value pair to the block.\n" ++
  "# - #each_name: Passes each field name to the block.\n" ++
  "# - #each_value: Passes each string field value to the block.\n" ++
  "#\n" ++
  "module Net::HTTPHeader\n" ++
  "  # The maximum length of HTTP header keys.\n" ++
  "  MAX_KEY_LENGTH = 1024\n" ++
  "  # The maximum length of HTTP header values.\n" ++
  "  MAX_FIELD_LENGTH = 65536\n" ++
  "\n" ++
  "  def initialize_http_header(initheader) #:nodoc:\n" ++
  "    @header = \{\}\n" ++
  "    return unless initheader\n" ++
  "    initheader.each do |key, value|\n" ++
  "      warn \"net/http: duplicated HTTP header: #\{key\}\", uplevel: 3 if key?(key) and $VERBOSE\n" ++
  "      if value.nil?\n" ++
  "        warn \"net/http: nil HTTP header: #\{key\}\", uplevel: 3 if $VERBOSE\n" ++
  "      else\n" ++
  "        value = value.strip # raise error for invalid byte sequences\n" ++
  "        if key.to_s.bytesize > MAX_KEY_LENGTH\n" ++
  "          raise ArgumentError, \"too long (#\{key.bytesize\} bytes) header: #\{key[0, 30].inspect\}...\"\n" ++
  "        end\n" ++
  "        if value.to_s.bytesize > MAX_FIELD_LENGTH\n" ++
  "          raise ArgumentError, \"header #\{key\} has too long field value: #\{value.bytesize\}\"\n" ++
  "        end\n" ++
  "        if value.count(\"\\r\\n\") > 0\n" ++
  "          raise ArgumentError, \"header #\{key\} has field value #\{value.inspect\}, this cannot include CR/LF\"\n" ++
  "        end\n" ++
  "        @header[key.downcase.to_s] = [value]\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def size   #:nodoc: obsolete\n" ++
  "    @header.size\n" ++
  "  end\n" ++
  "\n" ++
  "  alias length size   #:nodoc: obsolete\n" ++
  "\n" ++
  "  # Returns the string field value for the case-insensitive field +key+,\n" ++
  "  # or +nil+ if there is no such key;\n" ++
  "  # see \{Fields\}[rdoc-ref:Net::HTTPHeader@Fields]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['Connection'] # => \"keep-alive\"\n" ++
  "  #   res['Nosuch']     # => nil\n" ++
  "  #\n" ++
  "  # Note that some field values may be retrieved via convenience methods;\n" ++
  "  # see \{Getters\}[rdoc-ref:Net::HTTPHeader@Getters].\n" ++
  "  def [](key)\n" ++
  "    a = @header[key.downcase.to_s] or return nil\n" ++
  "    a.join(', ')\n" ++
  "  end\n" ++
  "\n" ++
  "  # Sets the value for the case-insensitive +key+ to +val+,\n" ++
  "  # overwriting the previous value if the field exists;\n" ++
  "  # see \{Fields\}[rdoc-ref:Net::HTTPHeader@Fields]:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req['Accept'] # => \"*/*\"\n" ++
  "  #   req['Accept'] = 'text/html'\n" ++
  "  #   req['Accept'] # => \"text/html\"\n" ++
  "  #\n" ++
  "  # Note that some field values may be set via convenience methods;\n" ++
  "  # see \{Setters\}[rdoc-ref:Net::HTTPHeader@Setters].\n" ++
  "  def []=(key, val)\n" ++
  "    unless val\n" ++
  "      @header.delete key.downcase.to_s\n" ++
  "      return val\n" ++
  "    end\n" ++
  "    set_field(key, val)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Adds value +val+ to the value array for field +key+ if the field exists;\n" ++
  "  # creates the field with the given +key+ and +val+ if it does not exist.\n" ++
  "  # see \{Fields\}[rdoc-ref:Net::HTTPHeader@Fields]:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.add_field('Foo', 'bar')\n" ++
  "  #   req['Foo']            # => \"bar\"\n" ++
  "  #   req.add_field('Foo', 'baz')\n" ++
  "  #   req['Foo']            # => \"bar, baz\"\n" ++
  "  #   req.add_field('Foo', %w[baz bam])\n" ++
  "  #   req['Foo']            # => \"bar, baz, baz, bam\"\n" ++
  "  #   req.get_fields('Foo') # => [\"bar\", \"baz\", \"baz\", \"bam\"]\n" ++
  "  #\n" ++
  "  def add_field(key, val)\n" ++
  "    stringified_downcased_key = key.downcase.to_s\n" ++
  "    if @header.key?(stringified_downcased_key)\n" ++
  "      append_field_value(@header[stringified_downcased_key], val)\n" ++
  "    else\n" ++
  "      set_field(key, val)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  private def set_field(key, val)\n" ++
  "    case val\n" ++
  "    when Enumerable\n" ++
  "      ary = []\n" ++
  "      append_field_value(ary, val)\n" ++
  "      @header[key.downcase.to_s] = ary\n" ++
  "    else\n" ++
  "      val = val.to_s # for compatibility use to_s instead of to_str\n" ++
  "      if val.b.count(\"\\r\\n\") > 0\n" ++
  "        raise ArgumentError, 'header field value cannot include CR/LF'\n" ++
  "      end\n" ++
  "      @header[key.downcase.to_s] = [val]\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  private def append_field_value(ary, val)\n" ++
  "    case val\n" ++
  "    when Enumerable\n" ++
  "      val.each\{|x| append_field_value(ary, x)\}\n" ++
  "    else\n" ++
  "      val = val.to_s\n" ++
  "      if /[\\r\\n]/n.match?(val.b)\n" ++
  "        raise ArgumentError, 'header field value cannot include CR/LF'\n" ++
  "      end\n" ++
  "      ary.push val\n" ++
  "    end\n" ++
  "  end\n" ++
  "  # :startdoc:\n" ++
  "\n" ++
  "  # Returns the array field value for the given +key+,\n" ++
  "  # or +nil+ if there is no such field;\n" ++
  "  # see \{Fields\}[rdoc-ref:Net::HTTPHeader@Fields]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res.get_fields('Connection') # => [\"keep-alive\"]\n" ++
  "  #   res.get_fields('Nosuch')     # => nil\n" ++
  "  #\n" ++
  "  def get_fields(key)\n" ++
  "    stringified_downcased_key = key.downcase.to_s\n" ++
  "    return nil unless @header[stringified_downcased_key]\n" ++
  "    @header[stringified_downcased_key].dup\n" ++
  "  end\n" ++
  "\n" ++
  "  # call-seq:\n" ++
  "  #   fetch(key, default_val = nil) \{|key| ... \} -> object\n" ++
  "  #   fetch(key, default_val = nil) -> value or default_val\n" ++
  "  #\n" ++
  "  # With a block, returns the string value for +key+ if it exists;\n" ++
  "  # otherwise returns the value of the block;\n" ++
  "  # ignores the +default_val+;\n" ++
  "  # see \{Fields\}[rdoc-ref:Net::HTTPHeader@Fields]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #\n" ++
  "  #   # Field exists; block not called.\n" ++
  "  #   res.fetch('Connection') do |value|\n" ++
  "  #     fail 'Cannot happen'\n" ++
  "  #   end # => \"keep-alive\"\n" ++
  "  #\n" ++
  "  #   # Field does not exist; block called.\n" ++
  "  #   res.fetch('Nosuch') do |value|\n" ++
  "  #     value.downcase\n" ++
  "  #   end # => \"nosuch\"\n" ++
  "  #\n" ++
  "  # With no block, returns the string value for +key+ if it exists;\n" ++
  "  # otherwise, returns +default_val+ if it was given;\n" ++
  "  # otherwise raises an exception:\n" ++
  "  #\n" ++
  "  #   res.fetch('Connection', 'Foo') # => \"keep-alive\"\n" ++
  "  #   res.fetch('Nosuch', 'Foo')     # => \"Foo\"\n" ++
  "  #   res.fetch('Nosuch')            # Raises KeyError.\n" ++
  "  #\n" ++
  "  def fetch(key, *args, &block)   #:yield: +key+\n" ++
  "    a = @header.fetch(key.downcase.to_s, *args, &block)\n" ++
  "    a.kind_of?(Array) ? a.join(', ') : a\n" ++
  "  end\n" ++
  "\n" ++
  "  # Calls the block with each key/value pair:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res.each_header do |key, value|\n" ++
  "  #     p [key, value] if key.start_with?('c')\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Output:\n" ++
  "  #\n" ++
  "  #   [\"content-type\", \"application/json; charset=utf-8\"]\n" ++
  "  #   [\"connection\", \"keep-alive\"]\n" ++
  "  #   [\"cache-control\", \"max-age=43200\"]\n" ++
  "  #   [\"cf-cache-status\", \"HIT\"]\n" ++
  "  #   [\"cf-ray\", \"771d17e9bc542cf5-ORD\"]\n" ++
  "  #\n" ++
  "  # Returns an enumerator if no block is given.\n" ++
  "  #\n" ++
  "  # Net::HTTPHeader#each is an alias for Net::HTTPHeader#each_header.\n" ++
  "  def each_header   #:yield: +key+, +value+\n" ++
  "    block_given? or return enum_for(__method__) \{ @header.size \}\n" ++
  "    @header.each do |k,va|\n" ++
  "      yield k, va.join(', ')\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  alias each each_header\n" ++
  "\n" ++
  "  # Calls the block with each field key:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res.each_key do |key|\n" ++
  "  #     p key if key.start_with?('c')\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Output:\n" ++
  "  #\n" ++
  "  #   \"content-type\"\n" ++
  "  #   \"connection\"\n" ++
  "  #   \"cache-control\"\n" ++
  "  #   \"cf-cache-status\"\n" ++
  "  #   \"cf-ray\"\n" ++
  "  #\n" ++
  "  # Returns an enumerator if no block is given.\n" ++
  "  #\n" ++
  "  # Net::HTTPHeader#each_name is an alias for Net::HTTPHeader#each_key.\n" ++
  "  def each_name(&block)   #:yield: +key+\n" ++
  "    block_given? or return enum_for(__method__) \{ @header.size \}\n" ++
  "    @header.each_key(&block)\n" ++
  "  end\n" ++
  "\n" ++
  "  alias each_key each_name\n" ++
  "\n" ++
  "  # Calls the block with each capitalized field name:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res.each_capitalized_name do |key|\n" ++
  "  #     p key if key.start_with?('C')\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Output:\n" ++
  "  #\n" ++
  "  #   \"Content-Type\"\n" ++
  "  #   \"Connection\"\n" ++
  "  #   \"Cache-Control\"\n" ++
  "  #   \"Cf-Cache-Status\"\n" ++
  "  #   \"Cf-Ray\"\n" ++
  "  #\n" ++
  "  # The capitalization is system-dependent;\n" ++
  "  # see \{Case Mapping\}[rdoc-ref:case_mapping.rdoc].\n" ++
  "  #\n" ++
  "  # Returns an enumerator if no block is given.\n" ++
  "  def each_capitalized_name  #:yield: +key+\n" ++
  "    block_given? or return enum_for(__method__) \{ @header.size \}\n" ++
  "    @header.each_key do |k|\n" ++
  "      yield capitalize(k)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Calls the block with each string field value:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res.each_value do |value|\n" ++
  "  #     p value if value.start_with?('c')\n" ++
  "  #   end\n" ++
  "  #\n" ++
  "  # Output:\n" ++
  "  #\n" ++
  "  #   \"chunked\"\n" ++
  "  #   \"cf-q-config;dur=6.0000002122251e-06\"\n" ++
  "  #   \"cloudflare\"\n" ++
  "  #\n" ++
  "  # Returns an enumerator if no block is given.\n" ++
  "  def each_value   #:yield: +value+\n" ++
  "    block_given? or return enum_for(__method__) \{ @header.size \}\n" ++
  "    @header.each_value do |va|\n" ++
  "      yield va.join(', ')\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Removes the header for the given case-insensitive +key+\n" ++
  "  # (see \{Fields\}[rdoc-ref:Net::HTTPHeader@Fields]);\n" ++
  "  # returns the deleted value, or +nil+ if no such field exists:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.delete('Accept') # => [\"*/*\"]\n" ++
  "  #   req.delete('Nosuch') # => nil\n" ++
  "  #\n" ++
  "  def delete(key)\n" ++
  "    @header.delete(key.downcase.to_s)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns +true+ if the field for the case-insensitive +key+ exists, +false+ otherwise:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.key?('Accept') # => true\n" ++
  "  #   req.key?('Nosuch') # => false\n" ++
  "  #\n" ++
  "  def key?(key)\n" ++
  "    @header.key?(key.downcase.to_s)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns a hash of the key/value pairs:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.to_hash\n" ++
  "  #   # =>\n" ++
  "  #   \{\"accept-encoding\"=>[\"gzip;q=1.0,deflate;q=0.6,identity;q=0.3\"],\n" ++
  "  #    \"accept\"=>[\"*/*\"],\n" ++
  "  #    \"user-agent\"=>[\"Ruby\"],\n" ++
  "  #    \"host\"=>[\"jsonplaceholder.typicode.com\"]\}\n" ++
  "  #\n" ++
  "  def to_hash\n" ++
  "    @header.dup\n" ++
  "  end\n" ++
  "\n" ++
  "  # Like #each_header, but the keys are returned in capitalized form.\n" ++
  "  #\n" ++
  "  # Net::HTTPHeader#canonical_each is an alias for Net::HTTPHeader#each_capitalized.\n" ++
  "  def each_capitalized\n" ++
  "    block_given? or return enum_for(__method__) \{ @header.size \}\n" ++
  "    @header.each do |k,v|\n" ++
  "      yield capitalize(k), v.join(', ')\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  alias canonical_each each_capitalized\n" ++
  "\n" ++
  "  def capitalize(name)  # :nodoc:\n" ++
  "    name.to_s.split('-'.freeze).map \{|s| s.capitalize \}.join('-'.freeze)\n" ++
  "  end\n" ++
  "  private :capitalize\n" ++
  "\n" ++
  "  # Returns an array of Range objects that represent\n" ++
  "  # the value of field <tt>'Range'</tt>,\n" ++
  "  # or +nil+ if there is no such field;\n" ++
  "  # see \{Range request header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#range-request-header]:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req['Range'] = 'bytes=0-99,200-299,400-499'\n" ++
  "  #   req.range # => [0..99, 200..299, 400..499]\n" ++
  "  #   req.delete('Range')\n" ++
  "  #   req.range # # => nil\n" ++
  "  #\n" ++
  "  def range\n" ++
  "    return nil unless @header['range']\n" ++
  "\n" ++
  "    value = self['Range']\n" ++
  "    # byte-range-set = *( \",\" OWS ) ( byte-range-spec / suffix-byte-range-spec )\n" ++
  "    #   *( OWS \",\" [ OWS ( byte-range-spec / suffix-byte-range-spec ) ] )\n" ++
  "    # corrected collected ABNF\n" ++
  "    # http://tools.ietf.org/html/draft-ietf-httpbis-p5-range-19#section-5.4.1\n" ++
  "    # http://tools.ietf.org/html/draft-ietf-httpbis-p5-range-19#appendix-C\n" ++
  "    # http://tools.ietf.org/html/draft-ietf-httpbis-p1-messaging-19#section-3.2.5\n" ++
  "    unless /\\Abytes=((?:,[ \\t]*)*(?:\\d+-\\d*|-\\d+)(?:[ \\t]*,(?:[ \\t]*\\d+-\\d*|-\\d+)?)*)\\z/ =~ value\n" ++
  "      raise Net::HTTPHeaderSyntaxError, \"invalid syntax for byte-ranges-specifier: '#\{value\}'\"\n" ++
  "    end\n" ++
  "\n" ++
  "    byte_range_set = $1\n" ++
  "    result = byte_range_set.split(/,/).map \{|spec|\n" ++
  "      m = /(\\d+)?\\s*-\\s*(\\d+)?/i.match(spec) or\n" ++
  "              raise Net::HTTPHeaderSyntaxError, \"invalid byte-range-spec: '#\{spec\}'\"\n" ++
  "      d1 = m[1].to_i\n" ++
  "      d2 = m[2].to_i\n" ++
  "      if m[1] and m[2]\n" ++
  "        if d1 > d2\n" ++
  "          raise Net::HTTPHeaderSyntaxError, \"last-byte-pos MUST greater than or equal to first-byte-pos but '#\{spec\}'\"\n" ++
  "        end\n" ++
  "        d1..d2\n" ++
  "      elsif m[1]\n" ++
  "        d1..-1\n" ++
  "      elsif m[2]\n" ++
  "        -d2..-1\n" ++
  "      else\n" ++
  "        raise Net::HTTPHeaderSyntaxError, 'range is not specified'\n" ++
  "      end\n" ++
  "    \}\n" ++
  "    # if result.empty?\n" ++
  "    # byte-range-set must include at least one byte-range-spec or suffix-byte-range-spec\n" ++
  "    # but above regexp already denies it.\n" ++
  "    if result.size == 1 && result[0].begin == 0 && result[0].end == -1\n" ++
  "      raise Net::HTTPHeaderSyntaxError, 'only one suffix-byte-range-spec with zero suffix-length'\n" ++
  "    end\n" ++
  "    result\n" ++
  "  end\n" ++
  "\n" ++
  "  # call-seq:\n" ++
  "  #   set_range(length) -> length\n" ++
  "  #   set_range(offset, length) -> range\n" ++
  "  #   set_range(begin..length) -> range\n" ++
  "  #\n" ++
  "  # Sets the value for field <tt>'Range'</tt>;\n" ++
  "  # see \{Range request header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#range-request-header]:\n" ++
  "  #\n" ++
  "  # With argument +length+:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.set_range(100)      # => 100\n" ++
  "  #   req['Range']            # => \"bytes=0-99\"\n" ++
  "  #\n" ++
  "  # With arguments +offset+ and +length+:\n" ++
  "  #\n" ++
  "  #   req.set_range(100, 100) # => 100...200\n" ++
  "  #   req['Range']            # => \"bytes=100-199\"\n" ++
  "  #\n" ++
  "  # With argument +range+:\n" ++
  "  #\n" ++
  "  #   req.set_range(100..199) # => 100..199\n" ++
  "  #   req['Range']            # => \"bytes=100-199\"\n" ++
  "  #\n" ++
  "  # Net::HTTPHeader#range= is an alias for Net::HTTPHeader#set_range.\n" ++
  "  def set_range(r, e = nil)\n" ++
  "    unless r\n" ++
  "      @header.delete 'range'\n" ++
  "      return r\n" ++
  "    end\n" ++
  "    r = (r...r+e) if e\n" ++
  "    case r\n" ++
  "    when Numeric\n" ++
  "      n = r.to_i\n" ++
  "      rangestr = (n > 0 ? \"0-#\{n-1\}\" : \"-#\{-n\}\")\n" ++
  "    when Range\n" ++
  "      first = r.first\n" ++
  "      last = r.end\n" ++
  "      last -= 1 if r.exclude_end?\n" ++
  "      if last == -1\n" ++
  "        rangestr = (first > 0 ? \"#\{first\}-\" : \"-#\{-first\}\")\n" ++
  "      else\n" ++
  "        raise Net::HTTPHeaderSyntaxError, 'range.first is negative' if first < 0\n" ++
  "        raise Net::HTTPHeaderSyntaxError, 'range.last is negative' if last < 0\n" ++
  "        raise Net::HTTPHeaderSyntaxError, 'must be .first < .last' if first > last\n" ++
  "        rangestr = \"#\{first\}-#\{last\}\"\n" ++
  "      end\n" ++
  "    else\n" ++
  "      raise TypeError, 'Range/Integer is required'\n" ++
  "    end\n" ++
  "    @header['range'] = [\"bytes=#\{rangestr\}\"]\n" ++
  "    r\n" ++
  "  end\n" ++
  "\n" ++
  "  alias range= set_range\n" ++
  "\n" ++
  "  # Returns the value of field <tt>'Content-Length'</tt> as an integer,\n" ++
  "  # or +nil+ if there is no such field;\n" ++
  "  # see \{Content-Length request header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-length-request-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/nosuch/1')\n" ++
  "  #   res.content_length # => 2\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res.content_length # => nil\n" ++
  "  #\n" ++
  "  def content_length\n" ++
  "    return nil unless key?('Content-Length')\n" ++
  "    len = self['Content-Length'].slice(/\\d+/) or\n" ++
  "        raise Net::HTTPHeaderSyntaxError, 'wrong Content-Length format'\n" ++
  "    len.to_i\n" ++
  "  end\n" ++
  "\n" ++
  "  # Sets the value of field <tt>'Content-Length'</tt> to the given numeric;\n" ++
  "  # see \{Content-Length response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-length-response-header]:\n" ++
  "  #\n" ++
  "  #   _uri = uri.dup\n" ++
  "  #   hostname = _uri.hostname           # => \"jsonplaceholder.typicode.com\"\n" ++
  "  #   _uri.path = '/posts'               # => \"/posts\"\n" ++
  "  #   req = Net::HTTP::Post.new(_uri)    # => #<Net::HTTP::Post POST>\n" ++
  "  #   req.body = '\{\"title\": \"foo\",\"body\": \"bar\",\"userId\": 1\}'\n" ++
  "  #   req.content_length = req.body.size # => 42\n" ++
  "  #   req.content_type = 'application/json'\n" ++
  "  #   res = Net::HTTP.start(hostname) do |http|\n" ++
  "  #     http.request(req)\n" ++
  "  #   end # => #<Net::HTTPCreated 201 Created readbody=true>\n" ++
  "  #\n" ++
  "  def content_length=(len)\n" ++
  "    unless len\n" ++
  "      @header.delete 'content-length'\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    @header['content-length'] = [len.to_i.to_s]\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns +true+ if field <tt>'Transfer-Encoding'</tt>\n" ++
  "  # exists and has value <tt>'chunked'</tt>,\n" ++
  "  # +false+ otherwise;\n" ++
  "  # see \{Transfer-Encoding response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#transfer-encoding-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['Transfer-Encoding'] # => \"chunked\"\n" ++
  "  #   res.chunked?             # => true\n" ++
  "  #\n" ++
  "  def chunked?\n" ++
  "    return false unless @header['transfer-encoding']\n" ++
  "    field = self['Transfer-Encoding']\n" ++
  "    (/(?:\\A|[^\\-\\w])chunked(?![\\-\\w])/i =~ field) ? true : false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns a Range object representing the value of field\n" ++
  "  # <tt>'Content-Range'</tt>, or +nil+ if no such field exists;\n" ++
  "  # see \{Content-Range response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-range-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['Content-Range'] # => nil\n" ++
  "  #   res['Content-Range'] = 'bytes 0-499/1000'\n" ++
  "  #   res['Content-Range'] # => \"bytes 0-499/1000\"\n" ++
  "  #   res.content_range    # => 0..499\n" ++
  "  #\n" ++
  "  def content_range\n" ++
  "    return nil unless @header['content-range']\n" ++
  "    m = %r<\\A\\s*(\\w+)\\s+(\\d+)-(\\d+)/(\\d+|\\*)>.match(self['Content-Range']) or\n" ++
  "        raise Net::HTTPHeaderSyntaxError, 'wrong Content-Range format'\n" ++
  "    return unless m[1] == 'bytes'\n" ++
  "    m[2].to_i .. m[3].to_i\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the integer representing length of the value of field\n" ++
  "  # <tt>'Content-Range'</tt>, or +nil+ if no such field exists;\n" ++
  "  # see \{Content-Range response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-range-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['Content-Range'] # => nil\n" ++
  "  #   res['Content-Range'] = 'bytes 0-499/1000'\n" ++
  "  #   res.range_length     # => 500\n" ++
  "  #\n" ++
  "  def range_length\n" ++
  "    r = content_range() or return nil\n" ++
  "    r.end - r.begin + 1\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the \{media type\}[https://en.wikipedia.org/wiki/Media_type]\n" ++
  "  # from the value of field <tt>'Content-Type'</tt>,\n" ++
  "  # or +nil+ if no such field exists;\n" ++
  "  # see \{Content-Type response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-type-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['content-type'] # => \"application/json; charset=utf-8\"\n" ++
  "  #   res.content_type    # => \"application/json\"\n" ++
  "  #\n" ++
  "  def content_type\n" ++
  "    main = main_type()\n" ++
  "    return nil unless main\n" ++
  "\n" ++
  "    sub = sub_type()\n" ++
  "    if sub\n" ++
  "      \"#\{main\}/#\{sub\}\"\n" ++
  "    else\n" ++
  "      main\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the leading ('type') part of the\n" ++
  "  # \{media type\}[https://en.wikipedia.org/wiki/Media_type]\n" ++
  "  # from the value of field <tt>'Content-Type'</tt>,\n" ++
  "  # or +nil+ if no such field exists;\n" ++
  "  # see \{Content-Type response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-type-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['content-type'] # => \"application/json; charset=utf-8\"\n" ++
  "  #   res.main_type       # => \"application\"\n" ++
  "  #\n" ++
  "  def main_type\n" ++
  "    return nil unless @header['content-type']\n" ++
  "    self['Content-Type'].split(';').first.to_s.split('/')[0].to_s.strip\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the trailing ('subtype') part of the\n" ++
  "  # \{media type\}[https://en.wikipedia.org/wiki/Media_type]\n" ++
  "  # from the value of field <tt>'Content-Type'</tt>,\n" ++
  "  # or +nil+ if no such field exists;\n" ++
  "  # see \{Content-Type response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-type-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['content-type'] # => \"application/json; charset=utf-8\"\n" ++
  "  #   res.sub_type        # => \"json\"\n" ++
  "  #\n" ++
  "  def sub_type\n" ++
  "    return nil unless @header['content-type']\n" ++
  "    _, sub = *self['Content-Type'].split(';').first.to_s.split('/')\n" ++
  "    return nil unless sub\n" ++
  "    sub.strip\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the trailing ('parameters') part of the value of field <tt>'Content-Type'</tt>,\n" ++
  "  # or +nil+ if no such field exists;\n" ++
  "  # see \{Content-Type response header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-type-response-header]:\n" ++
  "  #\n" ++
  "  #   res = Net::HTTP.get_response(hostname, '/todos/1')\n" ++
  "  #   res['content-type'] # => \"application/json; charset=utf-8\"\n" ++
  "  #   res.type_params     # => \{\"charset\"=>\"utf-8\"\}\n" ++
  "  #\n" ++
  "  def type_params\n" ++
  "    result = \{\}\n" ++
  "    list = self['Content-Type'].to_s.split(';')\n" ++
  "    list.shift\n" ++
  "    list.each do |param|\n" ++
  "      k, v = *param.split('=', 2)\n" ++
  "      result[k.strip] = v.strip\n" ++
  "    end\n" ++
  "    result\n" ++
  "  end\n" ++
  "\n" ++
  "  # Sets the value of field <tt>'Content-Type'</tt>;\n" ++
  "  # returns the new value;\n" ++
  "  # see \{Content-Type request header\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#content-type-request-header]:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Get.new(uri)\n" ++
  "  #   req.set_content_type('application/json') # => [\"application/json\"]\n" ++
  "  #\n" ++
  "  # Net::HTTPHeader#content_type= is an alias for Net::HTTPHeader#set_content_type.\n" ++
  "  def set_content_type(type, params = \{\})\n" ++
  "    @header['content-type'] = [type + params.map\{|k,v|\"; #\{k\}=#\{v\}\"\}.join('')]\n" ++
  "  end\n" ++
  "\n" ++
  "  alias content_type= set_content_type\n" ++
  "\n" ++
  "  # Sets the request body to a URL-encoded string derived from argument +params+,\n" ++
  "  # and sets request header field <tt>'Content-Type'</tt>\n" ++
  "  # to <tt>'application/x-www-form-urlencoded'</tt>.\n" ++
  "  #\n" ++
  "  # The resulting request is suitable for HTTP request +POST+ or +PUT+.\n" ++
  "  #\n" ++
  "  # Argument +params+ must be suitable for use as argument +enum+ to\n" ++
  "  # \{URI.encode_www_form\}[rdoc-ref:URI.encode_www_form].\n" ++
  "  #\n" ++
  "  # With only argument +params+ given,\n" ++
  "  # sets the body to a URL-encoded string with the default separator <tt>'&'</tt>:\n" ++
  "  #\n" ++
  "  #   req = Net::HTTP::Post.new('example.com')\n" ++
  "  #\n" ++
  "  #   req.set_form_data(q: 'ruby', lang: 'en')\n" ++
  "  #   req.body            # => \"q=ruby&lang=en\"\n" ++
  "  #   req['Content-Type'] # => \"application/x-www-form-urlencoded\"\n" ++
  "  #\n" ++
  "  #   req.set_form_data([['q', 'ruby'], ['lang', 'en']])\n" ++
  "  #   req.body            # => \"q=ruby&lang=en\"\n" ++
  "  #\n" ++
  "  #   req.set_form_data(q: ['ruby', 'perl'], lang: 'en')\n" ++
  "  #   req.body            # => \"q=ruby&q=perl&lang=en\"\n" ++
  "  #\n" ++
  "  #   req.set_form_data([['q', 'ruby'], ['q', 'perl'], ['lang', 'en']])\n" ++
  "  #   req.body            # => \"q=ruby&q=perl&lang=en\"\n" ++
  "  #\n" ++
  "  # With string argument +sep+ also given,\n" ++
  "  # uses that string as the separator:\n" ++
  "  #\n" ++
  "  #   req.set_form_data(\{q: 'ruby', lang: 'en'\}, '|')\n" ++
  "  #   req.body # => \"q=ruby|lang=en\"\n" ++
  "  #\n" ++
  "  # Net::HTTPHeader#form_data= is an alias for Net::HTTPHeader#set_form_data.\n" ++
  "  def set_form_data(params, sep = '&')\n" ++
  "    query = URI.encode_www_form(params)\n" ++
  "    query.gsub!(/&/, sep) if sep != '&'\n" ++
  "    self.body = query\n" ++
  "    self.content_type = 'application/x-www-form-urlencoded'\n" ++
  "  end\n" ++
  "\n" ++
  "  alias form_data= set_form_data\n" ++
  "\n" ++
  "  # Stores form data to be used in a +POST+ or +PUT+ request.\n" ++
  "  #\n" ++
  "  # The form data given in +params+ consists of zero or more fields;\n" ++
  "  # each field is:\n" ++
  "  #\n" ++
  "  # - A scalar value.\n" ++
  "  # - A name/value pair.\n" ++
  "  # - An IO stream opened for reading.\n" ++
  "  #\n" ++
  "  # Argument +params+ should be an\n" ++
  "  # \{Enumerable\}[rdoc-ref:Enumerable@Enumerable+in+Ruby+Classes]\n" ++
  "  # (method <tt>params.map</tt> will be called),\n" ++
  "  # and is often an array or hash.\n" ++
  "  #\n" ++
  "  # First, we set up a request:\n" ++
  "  #\n" ++
  "  #   _uri = uri.dup\n" ++
  "  #   _uri.path ='/posts'\n" ++
  "  #   req = Net::HTTP::Post.new(_uri)\n" ++
  "  #\n" ++
  "  # <b>Argument +params+ As an Array</b>\n" ++
  "  #\n" ++
  "  # When +params+ is an array,\n" ++
  "  # each of its elements is a subarray that defines a field;\n" ++
  "  # the subarray may contain:\n" ++
  "  #\n" ++
  "  # - One string:\n" ++
  "  #\n" ++
  "  #     req.set_form([['foo'], ['bar'], ['baz']])\n" ++
  "  #\n" ++
  "  # - Two strings:\n" ++
  "  #\n" ++
  "  #     req.set_form([%w[foo 0], %w[bar 1], %w[baz 2]])\n" ++
  "  #\n" ++
  "  # - When argument +enctype+ (see below) is given as\n" ++
  "  #   <tt>'multipart/form-data'</tt>:\n" ++
  "  #\n" ++
  "  #   - A string name and an IO stream opened for reading:\n" ++
  "  #\n" ++
  "  #       require 'stringio'\n" ++
  "  #       req.set_form([['file', StringIO.new('Ruby is cool.')]])\n" ++
  "  #\n" ++
  "  #   - A string name, an IO stream opened for reading,\n" ++
  "  #     and an options hash, which may contain these entries:\n" ++
  "  #\n" ++
  "  #     - +:filename+: The name of the file to use.\n" ++
  "  #     - +:content_type+: The content type of the uploaded file.\n" ++
  "  #\n" ++
  "  #     Example:\n" ++
  "  #\n" ++
  "  #       req.set_form([['file', file, \{filename: \"other-filename.foo\"\}]]\n" ++
  "  #\n" ++
  "  # The various forms may be mixed:\n" ++
  "  #\n" ++
  "  #   req.set_form(['foo', %w[bar 1], ['file', file]])\n" ++
  "  #\n" ++
  "  # <b>Argument +params+ As a Hash</b>\n" ++
  "  #\n" ++
  "  # When +params+ is a hash,\n" ++
  "  # each of its entries is a name/value pair that defines a field:\n" ++
  "  #\n" ++
  "  # - The name is a string.\n" ++
  "  # - The value may be:\n" ++
  "  #\n" ++
  "  #   - +nil+.\n" ++
  "  #   - Another string.\n" ++
  "  #   - An IO stream opened for reading\n" ++
  "  #     (only when argument +enctype+ -- see below -- is given as\n" ++
  "  #     <tt>'multipart/form-data'</tt>).\n" ++
  "  #\n" ++
  "  # Examples:\n" ++
  "  #\n" ++
  "  #   # Nil-valued fields.\n" ++
  "  #   req.set_form(\{'foo' => nil, 'bar' => nil, 'baz' => nil\})\n" ++
  "  #\n" ++
  "  #   # String-valued fields.\n" ++
  "  #   req.set_form(\{'foo' => 0, 'bar' => 1, 'baz' => 2\})\n" ++
  "  #\n" ++
  "  #   # IO-valued field.\n" ++
  "  #   require 'stringio'\n" ++
  "  #   req.set_form(\{'file' => StringIO.new('Ruby is cool.')\})\n" ++
  "  #\n" ++
  "  #   # Mixture of fields.\n" ++
  "  #   req.set_form(\{'foo' => nil, 'bar' => 1, 'file' => file\})\n" ++
  "  #\n" ++
  "  # Optional argument +enctype+ specifies the value to be given\n" ++
  "  # to field <tt>'Content-Type'</tt>, and must be one of:\n" ++
  "  #\n" ++
  "  # - <tt>'application/x-www-form-urlencoded'</tt> (the default).\n" ++
  "  # - <tt>'multipart/form-data'</tt>;\n" ++
  "  #   see \{RFC 7578\}[https://www.rfc-editor.org/rfc/rfc7578].\n" ++
  "  #\n" ++
  "  # Optional argument +formopt+ is a hash of options\n" ++
  "  # (applicable only when argument +enctype+\n" ++
  "  # is <tt>'multipart/form-data'</tt>)\n" ++
  "  # that may include the following entries:\n" ++
  "  #\n" ++
  "  # - +:boundary+: The value is the boundary string for the multipart message.\n" ++
  "  #   If not given, the boundary is a random string.\n" ++
  "  #   See \{Boundary\}[https://www.rfc-editor.org/rfc/rfc7578#section-4.1].\n" ++
  "  # - +:charset+: Value is the character set for the form submission.\n" ++
  "  #   Field names and values of non-file fields should be encoded with this charset.\n" ++
  "  #\n" ++
  "  def set_form(params, enctype='application/x-www-form-urlencoded', formopt=\{\})\n" ++
  "    @body_data = params\n" ++
  "    @body = nil\n" ++
  "    @body_stream = nil\n" ++
  "    @form_option = formopt\n" ++
  "    case enctype\n" ++
  "    when /\\Aapplication\\/x-www-form-urlencoded\\z/i,\n" ++
  "      /\\Amultipart\\/form-data\\z/i\n" ++
  "      self.content_type = enctype\n" ++
  "    else\n" ++
  "      raise ArgumentError, \"invalid enctype: #\{enctype\}\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Sets header <tt>'Authorization'</tt> using the given\n" ++
  "  # +account+ and +password+ strings:\n" ++
  "  #\n" ++
  "  #   req.basic_auth('my_account', 'my_password')\n" ++
  "  #   req['Authorization']\n" ++
  "  #   # => \"Basic bXlfYWNjb3VudDpteV9wYXNzd29yZA==\"\n" ++
  "  #\n" ++
  "  def basic_auth(account, password)\n" ++
  "    @header['authorization'] = [basic_encode(account, password)]\n" ++
  "  end\n" ++
  "\n" ++
  "  # Sets header <tt>'Proxy-Authorization'</tt> using the given\n" ++
  "  # +account+ and +password+ strings:\n" ++
  "  #\n" ++
  "  #   req.proxy_basic_auth('my_account', 'my_password')\n" ++
  "  #   req['Proxy-Authorization']\n" ++
  "  #   # => \"Basic bXlfYWNjb3VudDpteV9wYXNzd29yZA==\"\n" ++
  "  #\n" ++
  "  def proxy_basic_auth(account, password)\n" ++
  "    @header['proxy-authorization'] = [basic_encode(account, password)]\n" ++
  "  end\n" ++
  "\n" ++
  "  def basic_encode(account, password)   # :nodoc:\n" ++
  "    'Basic ' + [\"#\{account\}:#\{password\}\"].pack('m0')\n" ++
  "  end\n" ++
  "  private :basic_encode\n" ++
  "\n" ++
  "  # Returns whether the HTTP session is to be closed.\n" ++
  "  def connection_close?\n" ++
  "    token = /(?:\\A|,)\\s*close\\s*(?:\\z|,)/i\n" ++
  "    @header['connection']&.grep(token) \{return true\}\n" ++
  "    @header['proxy-connection']&.grep(token) \{return true\}\n" ++
  "    false\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns whether the HTTP session is to be kept alive.\n" ++
  "  def connection_keep_alive?\n" ++
  "    token = /(?:\\A|,)\\s*keep-alive\\s*(?:\\z|,)/i\n" ++
  "    @header['connection']&.grep(token) \{return true\}\n" ++
  "    @header['proxy-connection']&.grep(token) \{return true\}\n" ++
  "    false\n" ++
  "  end\n" ++
  "\n" ++
  "end\n";
let network_source_5 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "module Net::HTTP::ProxyDelta   #:nodoc: internal use only\n" ++
  "  private\n" ++
  "\n" ++
  "  def conn_address\n" ++
  "    proxy_address()\n" ++
  "  end\n" ++
  "\n" ++
  "  def conn_port\n" ++
  "    proxy_port()\n" ++
  "  end\n" ++
  "\n" ++
  "  def edit_path(path)\n" ++
  "    use_ssl? ? path : \"http://#\{addr_port()\}#\{path\}\"\n" ++
  "  end\n" ++
  "end\n" ++
  "\n";
let network_source_6 = fn (u: unit) ->
  "# frozen_string_literal: true\n" ++
  "\n" ++
  "# This class is the base class for \\Net::HTTP request classes.\n" ++
  "# The class should not be used directly;\n" ++
  "# instead you should use its subclasses, listed below.\n" ++
  "#\n" ++
  "# == Creating a Request\n" ++
  "#\n" ++
  "# An request object may be created with either a URI or a string hostname:\n" ++
  "#\n" ++
  "#   require 'net/http'\n" ++
  "#   uri = URI('https://jsonplaceholder.typicode.com/')\n" ++
  "#   req = Net::HTTP::Get.new(uri)          # => #<Net::HTTP::Get GET>\n" ++
  "#   req = Net::HTTP::Get.new(uri.hostname) # => #<Net::HTTP::Get GET>\n" ++
  "#\n" ++
  "# And with any of the subclasses:\n" ++
  "#\n" ++
  "#   req = Net::HTTP::Head.new(uri) # => #<Net::HTTP::Head HEAD>\n" ++
  "#   req = Net::HTTP::Post.new(uri) # => #<Net::HTTP::Post POST>\n" ++
  "#   req = Net::HTTP::Put.new(uri)  # => #<Net::HTTP::Put PUT>\n" ++
  "#   # ...\n" ++
  "#\n" ++
  "# The new instance is suitable for use as the argument to Net::HTTP#request.\n" ++
  "#\n" ++
  "# == Request Headers\n" ++
  "#\n" ++
  "# A new request object has these header fields by default:\n" ++
  "#\n" ++
  "#   req.to_hash\n" ++
  "#   # =>\n" ++
  "#   \{\"accept-encoding\"=>[\"gzip;q=1.0,deflate;q=0.6,identity;q=0.3\"],\n" ++
  "#   \"accept\"=>[\"*/*\"],\n" ++
  "#   \"user-agent\"=>[\"Ruby\"],\n" ++
  "#   \"host\"=>[\"jsonplaceholder.typicode.com\"]\}\n" ++
  "#\n" ++
  "# See:\n" ++
  "#\n" ++
  "# - \{Request header Accept-Encoding\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#Accept-Encoding]\n" ++
  "#   and \{Compression and Decompression\}[rdoc-ref:Net::HTTP@Compression+and+Decompression].\n" ++
  "# - \{Request header Accept\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#accept-request-header].\n" ++
  "# - \{Request header User-Agent\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#user-agent-request-header].\n" ++
  "# - \{Request header Host\}[https://en.wikipedia.org/wiki/List_of_HTTP_header_fields#host-request-header].\n" ++
  "#\n" ++
  "# You can add headers or override default headers:\n" ++
  "#\n" ++
  "#   #   res = Net::HTTP::Get.new(uri, \{'foo' => '0', 'bar' => '1'\})\n" ++
  "#\n" ++
  "# This class (and therefore its subclasses) also includes (indirectly)\n" ++
  "# module Net::HTTPHeader, which gives access to its\n" ++
  "# \{methods for setting headers\}[rdoc-ref:Net::HTTPHeader@Setters].\n" ++
  "#\n" ++
  "# == Request Subclasses\n" ++
  "#\n" ++
  "# Subclasses for HTTP requests:\n" ++
  "#\n" ++
  "# - Net::HTTP::Get\n" ++
  "# - Net::HTTP::Head\n" ++
  "# - Net::HTTP::Post\n" ++
  "# - Net::HTTP::Put\n" ++
  "# - Net::HTTP::Delete\n" ++
  "# - Net::HTTP::Options\n" ++
  "# - Net::HTTP::Trace\n" ++
  "# - Net::HTTP::Patch\n" ++
  "#\n" ++
  "# Subclasses for WebDAV requests:\n" ++
  "#\n" ++
  "# - Net::HTTP::Propfind\n" ++
  "# - Net::HTTP::Proppatch\n" ++
  "# - Net::HTTP::Mkcol\n" ++
  "# - Net::HTTP::Copy\n" ++
  "# - Net::HTTP::Move\n" ++
  "# - Net::HTTP::Lock\n" ++
  "# - Net::HTTP::Unlock\n" ++
  "#\n" ++
  "class Net::HTTPRequest < Net::HTTPGenericRequest\n" ++
  "  # Creates an HTTP request object for +path+.\n" ++
  "  #\n" ++
  "  # +initheader+ are the default headers to use.  Net::HTTP adds\n" ++
  "  # Accept-Encoding to enable compression of the response body unless\n" ++
  "  # Accept-Encoding or Range are supplied in +initheader+.\n" ++
  "\n" ++
  "  def initialize(path, initheader = nil)\n" ++
  "    super self.class::METHOD,\n" ++
  "          self.class::REQUEST_HAS_BODY,\n" ++
  "          self.class::RESPONSE_HAS_BODY,\n" ++
  "          path, initheader\n" ++
  "  end\n" ++
  "end\n";
