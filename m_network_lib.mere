  "    # :stopdoc:\n" ++
  "    HAS_BODY = true\n" ++
  "  end\n" ++
  "\n" ++
  "  # Response class for <tt>Unprocessable Entity</tt> responses (status code 422).\n" ++
  "  #\n" ++
  "  # The request was well-formed but had semantic errors.\n" ++
  "  #\n" ++
