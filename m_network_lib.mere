  "    end\n" ++
  "    private :check_to\n" ++
  "\n" ++
  "    # Private setter for to +v+.\n" ++
  "    def set_to(v)\n" ++
  "      @to = v\n" ++
  "    end\n" ++
  "    protected :set_to\n" ++
  "\n" ++
  "    # Setter for to +v+.\n" ++
  "    def to=(v)\n" ++
  "      check_to(v)\n" ++
  "      set_to(v)\n" ++
  "      v\n" ++
  "    end\n" ++
  "\n" ++
  "    # Checks the headers +v+ component against either\n" ++
  "    # * HEADER_REGEXP\n" ++
  "    def check_headers(v)\n" ++
  "      return true unless v\n" ++
  "      return true if v.size == 0\n" ++
  "      if HEADER_REGEXP !~ v\n" ++
  "        raise InvalidComponentError,\n" ++
  "          \"bad component(expected opaque component): #\{v\}\"\n" ++
  "      end\n" ++
  "\n" ++
  "      true\n" ++
  "    end\n" ++
  "    private :check_headers\n" ++
  "\n" ++
  "    # Private setter for headers +v+.\n" ++
  "    def set_headers(v)\n" ++
  "      @headers = []\n" ++
  "      if v\n" ++
  "        v.split('&').each do |x|\n" ++
  "          @headers << x.split(/=/, 2)\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    protected :set_headers\n" ++
  "\n" ++
  "    # Setter for headers +v+.\n" ++
  "    def headers=(v)\n" ++
