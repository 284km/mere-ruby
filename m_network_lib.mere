  "        \}\n" ++
  "      \}\n" ++
  "      LOG_on()\n" ++
  "      LOG \"wrote #\{len\} bytes\"\n" ++
  "      len\n" ++
  "    end\n" ++
  "\n" ++
  "    private\n" ++
  "\n" ++
  "    def dot_stuff(s)\n" ++
