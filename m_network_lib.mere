  "# frozen_string_literal: true\n" ++
  "=begin\n" ++
  "\n" ++
  "= net/https -- SSL/TLS enhancement for Net::HTTP.\n" ++
  "\n" ++
  "  This file has been merged with net/http.  There is no longer any need to\n" ++
  "  require 'net/https' to use HTTPS.\n" ++
  "\n" ++
  "  See Net::HTTP for details on how to make HTTPS connections.\n" ++
  "\n" ++
  "== Info\n" ++
  "  'OpenSSL for Ruby 2' project\n" ++
  "  Copyright (C) 2001 GOTOU Yuuzou <gotoyuzo@notwork.org>\n" ++
  "  All rights reserved.\n" ++
  "\n" ++
