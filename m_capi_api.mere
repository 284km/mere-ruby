// The C side of Ruby's C API, as the interpreter sees it. `mere --ffi-header`
// writes capi/mere_capi.h from this file; capi/*.c include that header and
// nothing else says what these types look like in C.
//
// A target with no C beside it (the Wasm build's source tree,
// tools/nothreads_tree.sh) puts m_capi_none.mere in this file's place.
//
// A direct extern `int` is C's 32-bit int, so a VALUE (64 bits) crosses in a
// record, or as the argument of a callback (a callback's int is 64 bits).

// One request from C to the interpreter: an operation and up to five words.
type CapiReq = { op: int, a: int, b: int, c: int, d: int, e: int };
// One 64-bit word.
type CapiWord = { w: int };
// What a call into C came back with: its VALUE, or (raised = 1) the outcome
// that is on its way out -- an exception, a throw, a break.
type CapiRet = { w: int, raised: int };

// Run C: a registered method, a library's Init_, a C function given as a
// block. `up` is how that C asks the interpreter for anything, for as long
// as this call lasts.
extern fn mr_capi_enter: (CapiReq -> int) -> CapiReq -> CapiRet;
// The words in transit (arguments on the way in, results on the way out).
extern fn mr_capi_get: int -> CapiWord;
extern fn mr_capi_set: int -> CapiWord -> int;
// The bytes in transit: a String's contents, either way.
extern fn mr_capi_bytes: unit -> bytes;
extern fn mr_capi_give: bytes -> int;
// The name in transit: a method, a class, a path, a message.
extern fn mr_capi_text: unit -> str;
extern fn mr_capi_say: str -> int;
// The number in transit.
extern fn mr_capi_dbl: unit -> float;
extern fn mr_capi_set_dbl: float -> int;
// An ID and its name.
extern fn mr_capi_intern: str -> int;
extern fn mr_capi_id_name: int -> str;
// A Float as CRuby's immediate (0 when it does not fit one), and back.
extern fn mr_capi_flonum: float -> CapiWord;
extern fn mr_capi_flonum_value: CapiWord -> float;
// The index C knows an encoding by.
extern fn mr_capi_enc_index: str -> int;
// The request in progress ends by raising: `outcome` is what is on its way.
extern fn mr_capi_raise: CapiWord -> int;
// Was this file compiled against mere-ruby's ruby.h? (`require` asks before
// it takes a .bundle / .so for a feature.)
extern fn mr_capi_probe: str -> int;
// Open an extension; its library number, or -1 (the reason is the text).
extern fn mr_capi_open: str -> int;
// The collector: the VALUEs C registered (rb_gc_register_address and the
// like), what a data object's dmark marks, and the end of a handle.
extern fn mr_capi_roots: (int -> int) -> int;
extern fn mr_capi_mark: (int -> int) -> int -> int;
extern fn mr_capi_release: int -> int;
// How many calls into C are in progress (a collection then reads the stack
// for VALUEs), and counters for the checks.
extern fn mr_capi_depth: unit -> int;
extern fn mr_capi_stat: int -> int;
// The file this process is running ("" when the OS does not say): the build
// RbConfig describes is the one beside it.
extern fn mr_capi_exe: unit -> str;
// The C library it was compiled against, as a triplet names it ("gnu"; "").
extern fn mr_capi_libc: unit -> str;
// A coroutine switch: the C calls in progress belong to the stack they are on.
extern fn mr_capi_switch: int -> int -> int;
// A String (its handle's number) is to have room for this many bytes when C
// next looks at it: String.new(capacity:), a read into a buffer.
extern fn mr_capi_reserve: int -> CapiWord -> int;
