// ASCII (JIS-Roman reads as ASCII, as ruby's does), ESC $ B and ESC $ @ JIS
// X 0208 (two 7-bit bytes, looked up as the EUC-JP pair), ESC ( I the
// half-width katakana of CP5022x. A byte with the high bit set, a broken
// escape, or a control byte inside a JIS X 0208 run is broken (-1).
let rec iso2022_dec = fn (cpx: bool) -> fn (s: str) -> fn (i: int) -> fn (mode: int) ->
  let n = str_len s in
  let o = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  if i >= n then Nil
  else if o i == 27 then
    (if o (i + 1) == 40 && (o (i + 2) == 66 || o (i + 2) == 74) then iso2022_dec cpx s (i + 3) 0
     else if o (i + 1) == 36 && (o (i + 2) == 66 || o (i + 2) == 64) then iso2022_dec cpx s (i + 3) 1
     // (the half-width katakana set is CP5022x's: ISO-2022-JP has no such
     //  escape, and ruby refuses `ESC ( I` there, note 440)
