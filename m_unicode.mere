// a regexp. The same walk as rb_grapheme_starts, but begun fresh at i (the
// regexp asks "one cluster from here", not "where do the clusters of the
// whole string fall") and stopped at the first boundary.
let gcb_cluster_end = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  let rec go = fn (j: int) -> fn (pk: str) -> fn (ep: bool) -> fn (epl: bool) -> fn (ri: int) ->
    if j >= n then n
    else
      let cpl = utf8_cp s j in
      let cp = (match cpl with (c, _) -> c) in
      let l = (match cpl with (_, ln) -> ln) in
      let ck = gcb_cls (if cp >= 128 && l == 1 then 0 - 1 else cp) in
      if gcb_break pk ck epl ((ri - (ri / 2) * 2) == 0) then j
      else
        go (j + l) ck (if str_eq ck "X" then true else if str_eq ck "E" && ep then true else false)
           (if str_eq ck "Z" && ep then true else false)
           (if str_eq ck "I" then ri + 1 else 0) in
  if i >= n then n
  else
    (let cpl = utf8_cp s i in
     let cp = (match cpl with (c, _) -> c) in
     let l = (match cpl with (_, ln) -> ln) in
     let ck = gcb_cls (if cp >= 128 && l == 1 then 0 - 1 else cp) in
     go (i + l) ck (str_eq ck "X") false (if str_eq ck "I" then 1 else 0));
