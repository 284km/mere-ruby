// at_char_right_boundary for UTF-8: k is a boundary when the character that
// holds the byte before it ENDS at k. The head is found by stepping back over
// continuation bytes, and a head that does not start a well-formed character
// is ONE byte long -- so "hello\xBE" starts with "hello" (the \xBE is a
// broken character of its own) and "\xE3\x81\x82" does not start with "\xE3".
let utf8_right_boundary = fn (s: str) -> fn (k: int) ->
  let n = str_len s in
  let cont = fn (i: int) -> (let b = ord (char_at s i) in b >= 128 && b < 192) in
  if k <= 0 || k >= n then true
  else if (if cont k then false else true) then true
  else
    (let rec head = fn (i: int) -> (if i > 0 && cont i then head (i - 1) else i) in
     let h = head (k - 1) in
     if cont h then false
     else
       (let b = ord (char_at s h) in
        let need = (if b >= 194 && b < 224 then 2 else if b >= 224 && b < 240 then 3 else if b >= 240 && b <= 244 then 4 else 1) in
        let rec ok = fn (j: int) -> (if j >= need then true else if h + j < n && cont (h + j) then ok (j + 1) else false) in
        let l = (if need > 1 && ok 1 then need else 1) in
        h + l == k));
let rb_graphemes = fn (s0: str) -> fn (e: str) ->
  let s = (if enc_utf8_family e then (let n9 = utf8_trunc_len s0 in if n9 < str_len s0 then substring s0 0 n9 else s0) else s0) in
  if (if enc_utf8_family e || str_eq e "CESU-8" || str_eq e "UTF-16LE" || str_eq e "UTF-16BE"
         || str_eq e "UTF-32LE" || str_eq e "UTF-32BE" then false else true)
  then utf8_chars_enc s e 0
  else if enc_ascii_compat e then
    (let starts = rb_grapheme_starts s in
     let n = str_len s in
     let rec cut = fn (xs: int list) ->
       (match xs with
        | Nil -> (Nil : Val list)
        | Cons (st, t) ->
          let en = (match t with Cons (nx, _) -> nx | Nil -> n) in
          let v = mkstr (substring s st en) in
          let _ = (match v with VStr id -> senc_set id e | _ -> ()) in
          Cons (v, cut t)) in
     cut starts)
  else
    (let u8 = (match encode_cps (decode_cps s e 0) "UTF-8" "" with (bytes, _) -> bytes) in
     let starts = rb_grapheme_starts u8 in
     let n = str_len u8 in
     let rec cut = fn (xs: int list) ->
       (match xs with
        | Nil -> (Nil : Val list)
        | Cons (st, t) ->
          let en = (match t with Cons (nx, _) -> nx | Nil -> n) in
          let piece = substring u8 st en in
          let v = mkstr (match encode_cps (decode_cps piece "UTF-8" 0) e "" with (bytes, _) -> bytes) in
          let _ = (match v with VStr id -> senc_set id e | _ -> ()) in
          Cons (v, cut t)) in
