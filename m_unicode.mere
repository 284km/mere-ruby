// ways, and ruby converts between them byte for byte (a JIS X 0208 code with
// no Unicode character, "~~", passes): a JIS X 0208 pair is 0x92 and the two
// bytes with their high bit set in the stateless form.
let rec iso2022_to_stateless = fn (s: str) -> fn (i: int) -> fn (jis: bool) -> fn b ->
  let n = str_len s in
  let o = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  if i >= n then ()
  else if o i == 27 && o (i + 1) == 36 && (o (i + 2) == 66 || o (i + 2) == 64) then iso2022_to_stateless s (i + 3) true b
  else if o i == 27 && o (i + 1) == 40 && (o (i + 2) == 66 || o (i + 2) == 74) then iso2022_to_stateless s (i + 3) false b
