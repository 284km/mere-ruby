// ENC_NORM_TABLES END
let gcb_lo = vec_new ();
let gcb_hi = vec_new ();
let gcb_kv = map_new ();
let gcb_build = fn (u: unit) ->
  if vec_len gcb_lo > 0 then ()
  else
    let n = str_len gcb_raw in
    let rec fin = fn (j: int) -> if j < n && (if str_eq (char_at gcb_raw j) "," then false else true) then fin (j + 1) else j in
    let rec dashp = fn (j: int) -> if str_eq (char_at gcb_raw j) "-" then j else dashp (j + 1) in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = fin i in
        let d = dashp i in
        let lo = jis_hex gcb_raw i d 0 in
        let hi = jis_hex gcb_raw (d + 1) (e - 2) 0 in
        let k = substring gcb_raw (e - 1) e in
        let _ = vec_push gcb_lo lo in
        let _ = vec_push gcb_hi hi in
        let _ = map_set gcb_kv (str_of_int (vec_len gcb_lo - 1)) k in
        go (e + 1) in
    go 0;
// the Grapheme_Cluster_Break class of a codepoint ("" = Other).
let gcb_cls = fn (cp: int) ->
  if cp < 0 then ""
  else
    let _ = gcb_build () in
    let rec bs = fn (lo: int) -> fn (hi: int) ->
      if lo > hi then ""
      else
        let mid = (lo + hi) / 2 in
        (if cp < vec_get gcb_lo mid then bs lo (mid - 1)
         else if cp > vec_get gcb_hi mid then bs (mid + 1) hi
         else map_get gcb_kv (str_of_int mid)) in
    bs 0 (vec_len gcb_lo - 1);
// is there a boundary between prev and cur? (GB3-GB13; epl = "the previous
// run was ExtPict Extend* ZWJ", rieven = "an even number of RIs so far").
let gcb_break = fn (pk: str) -> fn (ck: str) -> fn (epl: bool) -> fn (rieven: bool) ->
  if str_eq pk "R" && str_eq ck "L" then false
  else if str_eq pk "C" || str_eq pk "R" || str_eq pk "L" then true
  else if str_eq ck "C" || str_eq ck "R" || str_eq ck "L" then true
  else if str_eq pk "1" && (str_eq ck "1" || str_eq ck "2" || str_eq ck "4" || str_eq ck "5") then false
  else if (str_eq pk "2" || str_eq pk "4") && (str_eq ck "2" || str_eq ck "3") then false
  else if (str_eq pk "3" || str_eq pk "5") && str_eq ck "3" then false
  else if str_eq ck "E" || str_eq ck "Z" then false
  else if str_eq ck "S" then false
  else if str_eq pk "P" then false
  else if str_eq pk "Z" && str_eq ck "X" && epl then false
  else if str_eq pk "I" && str_eq ck "I" && (if rieven then false else true) then false
  else true;
// the byte offsets where grapheme clusters START (ascending; first is 0).
let rb_grapheme_starts = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) -> fn (pk: str) -> fn (ep: bool) -> fn (epl: bool) -> fn (ri: int) -> fn (acc: int list) ->
    if i >= n then acc
    else
      let cpl = utf8_cp s i in
      let cp = (match cpl with (c, _) -> c) in
      let l = (match cpl with (_, ln) -> ln) in
      let cp2 = (if cp >= 128 && l == 1 then 0 - 1 else cp) in
      let ck = gcb_cls cp2 in
      let brk = (if i == 0 then true else gcb_break pk ck epl ((ri - (ri / 2) * 2) == 0)) in
      // ExtPict Extend* ZWJ linkage, and Regional Indicator parity.
      let ep2 = (if str_eq ck "X" then true else if str_eq ck "E" && ep then true else false) in
      let epl2 = (if str_eq ck "Z" && ep then true else false) in
      let ri2 = (if str_eq ck "I" then (if brk then 1 else ri + 1) else 0) in
      go (i + l) ck ep2 epl2 ri2 (if brk then Cons (i, acc) else acc) in
  (let rec rv = fn (xs: int list) -> fn (a2: int list) -> (match xs with Nil -> a2 | Cons (h, t) -> rv t (Cons (h, a2))) in
   rv (go 0 "" false false 0 Nil) Nil);
// the clusters as string VALUES carrying encoding e (UTF-8-compatible path
// slices bytes; UTF-16/32 goes through the codec).
let rb_graphemes = fn (s: str) -> fn (e: str) ->
  if enc_ascii_compat e then
    (let starts = rb_grapheme_starts s in
     let n = str_len s in
     let rec cut = fn (xs: int list) ->
       (match xs with
        | Nil -> (Nil : Val list)
        | Cons (st, t) ->
          let en = (match t with Cons (nx, _) -> nx | Nil -> n) in
          let v = mkstr (substring s st en) in
          let _ = (match v with VStr id -> senc_set id e | _ -> ()) in
          Cons (v, cut t)) in
     cut starts)
  else
    (let u8 = (match encode_cps (decode_cps s e 0) "UTF-8" "" with (bytes, _) -> bytes) in
     let starts = rb_grapheme_starts u8 in
     let n = str_len u8 in
     let rec cut = fn (xs: int list) ->
       (match xs with
        | Nil -> (Nil : Val list)
        | Cons (st, t) ->
          let en = (match t with Cons (nx, _) -> nx | Nil -> n) in
          let piece = substring u8 st en in
          let v = mkstr (match encode_cps (decode_cps piece "UTF-8" 0) e "" with (bytes, _) -> bytes) in
          let _ = (match v with VStr id -> senc_set id e | _ -> ()) in
          Cons (v, cut t)) in
     cut starts);
// ---- normalization ---------------------------------------------------------
let norm_nfd_tbl = map_new ();
let norm_nfkd_tbl = map_new ();
let norm_ccc_tbl = map_new ();
let norm_comp_tbl = map_new ();
let norm_ld_seq = fn tbl -> fn (raw: str) ->
  let n = str_len raw in
  let rec fin = fn (j: int) -> if j < n && (if str_eq (char_at raw j) "," then false else true) then fin (j + 1) else j in
  let rec colon = fn (j: int) -> if str_eq (char_at raw j) ":" then j else colon (j + 1) in
  let rec go = fn (i: int) ->
    if i >= n then ()
    else
      let e = fin i in
      let c = colon i in
      let _ = map_set tbl (substring raw i c) (substring raw (c + 1) e) in
      go (e + 1) in
  go 0;
let norm_build = fn (u: unit) ->
  if map_len norm_nfd_tbl > 0 then ()
  else
    let _ = norm_ld_seq norm_nfd_tbl norm_nfd_raw in
    let _ = norm_ld_seq norm_nfkd_tbl norm_nfkd_raw in
    let _ = norm_ld_seq norm_ccc_tbl norm_ccc_raw in
    norm_ld_seq norm_comp_tbl norm_comp_raw;
let norm_ccc = fn (cp: int) ->
  let _ = norm_build () in
  let k = cp_hex cp in
  if map_has norm_ccc_tbl k then jis_hex ("" ++ map_get norm_ccc_tbl k) 0 (str_len (map_get norm_ccc_tbl k)) 0
  else 0;
let norm_decv = fn (sv: str) ->
  let n = str_len sv in
  let rec go = fn (i: int) -> fn (acc: int) ->
    if i >= n then acc else go (i + 1) (acc * 10 + (ord (char_at sv i) - 48)) in
  go 0 0;
let norm_ccc = fn (cp: int) ->
  let _ = norm_build () in
  let k = cp_hex cp in
  if map_has norm_ccc_tbl k then norm_decv (map_get norm_ccc_tbl k) else 0;
// full decomposition of one codepoint; Hangul is arithmetic, the table rows
// are ruby's own fully-expanded answers.
let norm_dec_of = fn (compat: bool) -> fn (cp: int) ->
  if cp >= 44032 && cp <= 55203 then
    (let si = cp - 44032 in
     let l = 4352 + si / 588 in
     let v = 4449 + (si - (si / 588) * 588) / 28 in
     let t = si - (si / 28) * 28 in
     if t == 0 then Cons (l, Cons (v, (Nil : int list))) else Cons (l, Cons (v, Cons (4519 + t, Nil))))
  else
    (let _ = norm_build () in
     let k = cp_hex cp in
     if compat && map_has norm_nfkd_tbl k then case_seq_parse (map_get norm_nfkd_tbl k)
     else if map_has norm_nfd_tbl k then case_seq_parse (map_get norm_nfd_tbl k)
     else Cons (cp, (Nil : int list)));
// canonical ordering: bubble adjacent nonzero-class pairs until stable.
let rec norm_pass = fn (xs: int list) ->
  match xs with
  | Cons (a, Cons (b, t)) ->
    (let ca = norm_ccc a in
     let cb = norm_ccc b in
     if ca > cb && cb > 0 then (match norm_pass (Cons (a, t)) with (r, _) -> (Cons (b, r), true))
     else (match norm_pass (Cons (b, t)) with (r, ch) -> (Cons (a, r), ch)))
  | other -> (other, false);
let rec norm_order = fn (xs: int list) ->
  match norm_pass xs with (r, ch) -> if ch then norm_order r else r;
let rec norm_decomp = fn (compat: bool) -> fn (xs: int list) ->
  match xs with
  | Nil -> (Nil : int list)
  | Cons (h, t) -> rb_iseq_app (norm_dec_of compat h) (norm_decomp compat t);
// composition: the standard NFC walk (a starter composes with a following
// character unless a mark of equal-or-higher class sits between), plus the
// arithmetic Hangul LV / LVT steps.
let norm_compose = fn (xs0: int list) ->
  let rec flushm = fn (ms: int list) -> fn (acc: int list) ->
    (match ms with Nil -> acc | Cons (h, t) -> flushm t (Cons (h, acc))) in
  let rec go = fn (xs: int list) -> fn (starter: int) -> fn (marks: int list) -> fn (lastcc: int) -> fn (outr: int list) ->
    match xs with
    | Nil ->
      (let outr2 = (if starter < 0 then outr else flushm marks (Cons (starter, outr))) in
       let rec rv = fn (a: int list) -> fn (b: int list) -> (match a with Nil -> b | Cons (h, t) -> rv t (Cons (h, b))) in
       rv outr2 Nil)
    | Cons (c, t) ->
      let cc = norm_ccc c in
      if starter < 0 then
        (if cc == 0 then go t c (Nil : int list) 0 outr else go t (0 - 1) Nil 0 (Cons (c, outr)))
      else if cc == 0 && starter >= 4352 && starter <= 4370 && c >= 4449 && c <= 4469 && (match marks with Nil -> true | _ -> false) then
        go t (44032 + (starter - 4352) * 588 + (c - 4449) * 28) Nil 0 outr
      else if cc == 0 && starter >= 44032 && starter <= 55203
              && ((starter - 44032) - ((starter - 44032) / 28) * 28) == 0
              && c >= 4520 && c <= 4546 && (match marks with Nil -> true | _ -> false) then
        go t (starter + (c - 4519)) Nil 0 outr
      else
        let key = cp_hex starter ++ " " ++ cp_hex c in
        let free = (if cc > 0 then lastcc < cc else (match marks with Nil -> true | _ -> false)) in
        (if free && (let _ = norm_build () in map_has norm_comp_tbl key) then
           go t (jis_hex (map_get norm_comp_tbl key) 0 (str_len (map_get norm_comp_tbl key)) 0) marks lastcc outr
         else if cc == 0 then
           go t c Nil 0 (flushm marks (Cons (starter, outr)))
         else
           go t starter (rb_iseq_app marks (Cons (c, Nil))) cc outr) in
  go xs0 (0 - 1) Nil 0 Nil;
let norm_apply = fn (form: str) -> fn (cps: int list) ->
  if str_eq form "nfd" then norm_order (norm_decomp false cps)
  else if str_eq form "nfkd" then norm_order (norm_decomp true cps)
  else if str_eq form "nfc" then norm_compose (norm_order (norm_decomp false cps))
  else norm_compose (norm_order (norm_decomp true cps));
let rec norm_ieq = fn (a: int list) -> fn (b: int list) ->
  match a with
  | Nil -> (match b with Nil -> true | _ -> false)
  | Cons (ha, ta) -> (match b with Cons (hb, tb) -> (if ha == hb then norm_ieq ta tb else false) | Nil -> false);

let rec str_downcase_ascii_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let c = char_at s i in
    let o = ord c in
    str_downcase_ascii_go s (i + 1) (acc ++ (if o >= 65 && o <= 90 then chr (o + 32) else c));
let str_downcase_ascii = fn (s: str) -> str_downcase_ascii_go s 0 "";

// ---- integer helpers (gcd / base conversion / digits / pow) --------------
let rec int_gcd = fn (a: int) -> fn (b: int) ->
  if b == 0 then (if a < 0 then 0 - a else a) else int_gcd b (a - (a / b) * b);
let digit_char = fn (d: int) -> if d < 10 then chr (48 + d) else chr (97 + d - 10);
let rec int_to_base_go = fn (n: int) -> fn (base: int) -> fn (acc: str) ->
  if n == 0 then acc else int_to_base_go (n / base) base (digit_char (n - (n / base) * base) ++ acc);
// Ruby's radix range: 2..36, and anything else is `invalid radix N` -- not a
// silently different answer. `5.to_s(99)` used to be "5".
let check_radix = fn (b: int) ->
  if b < 2 || b > 36 then
    (let _ = prim_raise "ArgumentError" ("invalid radix " ++ str_of_int b) in 0)
  else b;
let int_to_base = fn (n: int) -> fn (base: int) ->
  if n == 0 then "0"
  else if n < 0 then "-" ++ int_to_base_go (0 - n) base ""
  else int_to_base_go n base "";
// a bignum's decimal digit string (optionally "-" prefixed) rendered in
// base N, by repeated division; the divisor is one digit wide so each step
// is a single big_divmod_s. Integer#to_s(base) fed a VBig used to answer in
// decimal no matter what base it was asked for.
let rec big_to_base_go = fn (v: str) -> fn (bs: str) -> fn (base: int) -> fn (acc: str) ->
  if str_eq v "0" then (if str_eq acc "" then "0" else acc)
  else (match big_divmod_s v bs with (q, r) -> big_to_base_go q bs base (int_to_base (int_of_str r) base ++ acc));
let big_to_base_s = fn (s0: str) -> fn (base: int) ->
  let neg = str_len s0 > 0 && str_eq (substring s0 0 1) "-" in
  let s = (if neg then substring s0 1 (str_len s0) else s0) in
  (if neg then "-" else "") ++ big_to_base_go s (int_to_base base 10) base "";
let rec int_digits_go = fn (n: int) -> fn (base: int) ->
  if n == 0 then Nil else Cons (VInt (n - (n / base) * base), int_digits_go (n / base) base);
let int_digits = fn (n: int) -> fn (base: int) ->
  if n == 0 then Cons (VInt 0, Nil) else int_digits_go n base;
let rec int_pow = fn (b: int) -> fn (e: int) -> if e <= 0 then 1 else b * int_pow b (e - 1);
// `b.pow(e, m)` is Ruby's %, which FLOORS: the result takes the modulus's sign,
// so `(-2).pow(3, 5)` is 2 and not -3. C's remainder truncates toward zero, and
// the old body handed that back untouched -- a negative answer where ruby's is
// always between 0 and m-1 (for m > 0).
//
// It also squares instead of stepping: the old version recursed ONCE PER UNIT
// of the exponent, so `2.pow(1000000, 7)` was a million stack frames.
// Integer#[] reads the TWO'S-COMPLEMENT bit, so the shift is ARITHMETIC.
// C division truncates toward zero, which is not a shift for a negative
// receiver -- `-5 / 2` is -2 where `-5 >> 1` is -3 -- so bit 1 of -5 came out 0
// where ruby says 1. Above the sign bit every bit of a negative number is 1,
// which is also what makes an index past the word width answer 1 and not 0.
let int_shr_arith = fn (n: int) -> fn (i: int) ->
  if i >= 63 then (if n < 0 then 0 - 1 else 0)
  else (let p = int_pow 2 i in
        let q = n / p in
        if n < 0 && q * p > n then q - 1 else q);
let int_mod_floor = fn (r: int) -> fn (m: int) ->
  let t = r - (r / m) * m in
  if t == 0 then 0 else if (t < 0) == (m < 0) then t else t + m;
let rec int_pow_mod = fn (b: int) -> fn (e: int) -> fn (m: int) ->
  if e <= 0 then int_mod_floor 1 m
  else
    let h = int_pow_mod b (e / 2) m in
    let sq = int_mod_floor (h * h) m in
    if e - (e / 2) * 2 == 0 then sq else int_mod_floor (sq * int_mod_floor b m) m;
let rec int_bit_length = fn (n: int) ->
  if n == 0 then 0 else 1 + int_bit_length (n / 2);

// ---- the same three questions, asked of a bignum -------------------------
// `123.bit_length` answered and `(2**63).bit_length` said "undefined method",
// which is the shape this file keeps producing: the small-value branch exists,
// the wide one was never written, and no program that stays under 2**63 can
// tell. `divmod` had already been given its VBig arm -- these three had not.
//
// Counting by repeated division is O(bits) bignum divisions. That is fine at
// spec sizes and it is exact; a decimal-length estimate would be neither.
// ruby's bit_length for a negative n is the length of ~n, i.e. of -n-1.
//
// By DIGIT COUNT, not by halving. 10^(d-1) <= m < 10^d bounds log2(m) inside
// one decimal digit, so an estimate taken from the digit count sits within
// about four bits of the answer -- and every candidate below it is then
// checked against a real power of two, so the estimate decides nothing.
// The previous form divided by 2 until it reached zero: 33220 divisions, each
// producing a fresh 3011-digit string, for (2**10000).bit_length. It
// allocated past 6 GB and core/integer/bit_length_spec was killed at the
// memory cap -- while BUILDING 2**10000 costs a quarter of a gigabyte.
let big_bit_length = fn (b: str) ->
  let m = big_mag (if big_sign b < 0 then big_sub_s (big_neg_s b) "1" else b) in
  if str_eq m "0" || str_eq m "" then 0
  else
    // floor(d * log2 10) + 2 is strictly above the answer for every d, and
    // 3.3219281 is log2 10 rounded UP so the bound never falls short.
    let k_hi = (str_len m * 33219281) / 10000000 + 2 in
    let rec down = fn (k: int) -> fn (pw: str) ->
      if k <= 1 then 1
      else if mag_cmp pw m <= 0 then k
      else down (k - 1) (big_div_s pw "2") in
    down k_hi (two_pow_s (k_hi - 1));

// digits: least significant first, like Integer#digits. Negative receivers
// raise Math::DomainError in ruby, which the caller checks for.
let rec big_digits_go = fn (m: str) -> fn (base: str) ->
  if str_eq m "0" then Nil
  else Cons (norm_big (big_mod_s m base), big_digits_go (big_div_s m base) base);
// digit value of a base-N char (0-9a-z), or -1.
let hexval = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 122 then o - 97 + 10
  else if o >= 65 && o <= 90 then o - 65 + 10
  else 0 - 1;
let rec str_to_int_base_go = fn (s: str) -> fn (base: int) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc
  // a single underscore between two digits is a separator; anything else
  // (leading, trailing, doubled) ends the number, as ruby's to_i reads it.
  else if str_eq (char_at s i) "_" && i + 1 < str_len s
          && (let d2 = hexval (char_at s (i + 1)) in d2 >= 0 && d2 < base)
          && i > 0 && (let d0 = hexval (char_at s (i - 1)) in d0 >= 0 && d0 < base)
  then str_to_int_base_go s base (i + 1) acc
  else let d = hexval (char_at s i) in
       if d < 0 || d >= base then acc else str_to_int_base_go s base (i + 1) (acc * base + d);
// length of a 0x/0b/0o/0d radix prefix at `off` that matches `base` (else 0).
let base_prefix_len = fn (s: str) -> fn (off: int) -> fn (base: int) ->
  if off + 1 < str_len s && str_eq (char_at s off) "0" then
    (let c = char_at s (off + 1) in
     if (base == 16 && (str_eq c "x" || str_eq c "X")) ||
        (base == 2 && (str_eq c "b" || str_eq c "B")) ||
        (base == 8 && (str_eq c "o" || str_eq c "O")) ||
        (base == 10 && (str_eq c "d" || str_eq c "D"))
     then 2 else 0)
  else 0;
let str_to_int_base = fn (s: str) -> fn (base: int) ->
  if str_len s > 0 && str_eq (char_at s 0) "-" then 0 - str_to_int_base_go s base (1 + base_prefix_len s 1 base) 0
  else str_to_int_base_go s base (base_prefix_len s 0 base) 0;
// String#to_i(base), the whole of ruby's reading: leading whitespace, a
// sign, base auto-detection when base is 0 (0x/0b/0o/0d/leading-0-octal),
// single underscores between digits, and promotion to a bignum on overflow.
let rb_str_to_i_base = fn (s: str) -> fn (base0: int) ->
  let n = str_len s in
  let wsc = fn (c: str) -> (let o = ord c in o == 32 || (o >= 9 && o <= 13)) in
  let rec ws = fn (i: int) -> if i < n && wsc (char_at s i) then ws (i + 1) else i in
  let i0 = ws 0 in
  let (neg, i1) = (if i0 < n && str_eq (char_at s i0) "-" then (true, i0 + 1)
                   else if i0 < n && str_eq (char_at s i0) "+" then (false, i0 + 1)
                   else (false, i0)) in
  let (base, i2) =
    (if base0 == 0 then
       (if i1 + 1 < n && str_eq (char_at s i1) "0" then
          (let c1 = char_at s (i1 + 1) in
           if str_eq c1 "x" || str_eq c1 "X" then (16, i1 + 2)
           else if str_eq c1 "b" || str_eq c1 "B" then (2, i1 + 2)
           else if str_eq c1 "o" || str_eq c1 "O" then (8, i1 + 2)
           else if str_eq c1 "d" || str_eq c1 "D" then (10, i1 + 2)
           else (8, i1 + 1))
        else (10, i1))
     else
       (let pl = base_prefix_len s i1 base0 in (base0, i1 + pl))) in
  let digv = fn (c: str) -> hexval c in
  let rec go = fn (i: int) -> fn (acc: int) -> fn (big: str) ->
    if i >= n then (acc, big)
    else if str_eq (char_at s i) "_" && i + 1 < n
            && (let d2 = digv (char_at s (i + 1)) in d2 >= 0 && d2 < base)
            && i > i2 && (let d0 = digv (char_at s (i - 1)) in d0 >= 0 && d0 < base)
    then go (i + 1) acc big
    else
      let d = digv (char_at s i) in
      if d < 0 || d >= base then (acc, big)
      else if (if str_eq big "" then false else true) then go (i + 1) acc (dec_mul_add big base d)
      else if acc > (int_max - d) / base then go (i + 1) 0 (dec_mul_add (str_of_int acc) base d)
      else go (i + 1) (acc * base + d) big in
  match go i2 0 "" with
  | (acc, big) ->
    if str_eq big "" then VInt (if neg then 0 - acc else acc)
    else norm_big ((if neg then "-" else "") ++ big);

// Walk the "NAME:NUM NAME:NUM" table above. Two readers: Signal.list wants the
// pairs as a Hash, Signal.signame wants the name for a number.
let rec signal_scan = fn (i: int) -> fn (start: int) -> fn (acc: Val list) ->
  if i > str_len signal_names then rev_app acc Nil
  else if i == str_len signal_names || str_eq (char_at signal_names i) " " then
    (let tok = substring signal_names start i in
     let colon = str_index_of tok ":" in
     if colon < 0 then signal_scan (i + 1) (i + 1) acc
     else (let nm = substring tok 0 colon in
           let num = str_to_int_base (substring tok (colon + 1) (str_len tok)) 10 in
           signal_scan (i + 1) (i + 1) (Cons (VInt num, Cons (mkstr nm, acc)))))
  else signal_scan (i + 1) start acc;
let signal_list_pairs = fn (u: unit) -> signal_scan 0 0 Nil;
let rec signal_name_go = fn (xs: Val list) -> fn (n: int) ->
  match xs with
  | Cons (VStr h, Cons (VInt v, rest)) -> if v == n then sget h else signal_name_go rest n
  | _ -> "";
let signal_name_of = fn (n: int) -> signal_name_go (signal_list_pairs ()) n;
let rec signal_num_go = fn (xs: Val list) -> fn (nm: str) ->
  match xs with
  | Cons (VStr h, Cons (VInt v, rest)) -> if str_eq (sget h) nm then v else signal_num_go rest nm
  | _ -> 0;
let signal_num_of = fn (nm: str) -> signal_num_go (signal_list_pairs ()) nm;


// float floor/ceil/round built on int_of_float (which truncates toward 0).
let flt_floor = fn (x: float) -> let t = int_of_float x in if float_of_int t > x then t - 1 else t;
let flt_ceil = fn (x: float) -> let t = int_of_float x in if float_of_int t < x then t + 1 else t;
// ⚠ ruby rounds half AWAY FROM ZERO, and `floor (x + 0.5)` is not that: for
//   0.49999999999999994 the addition itself rounds up to exactly 1.0, so the
//   answer was 1 where ruby says 0. Compare the FRACTION with a half instead,
//   which never adds two values of different magnitude.
let flt_round = fn (x: float) ->
  if x < 0.0 then (let t = flt_ceil x in if float_of_int t - x >= 0.5 then t - 1 else t)
  else (let t = flt_floor x in if x - float_of_int t >= 0.5 then t + 1 else t);
// integer round/floor/ceil to a power-of-ten place (n negative in Ruby).
let int_round_place = fn (x: int) -> fn (m: int) ->
  if x >= 0 then ((x + m / 2) / m) * m else 0 - (((0 - x) + m / 2) / m) * m;

let rec str_ascii_only = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then true else if ord (char_at s i) >= 128 then false else str_ascii_only s (i + 1);

let is_ws_ch = fn (c: str) ->
  str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r"
  || (str_len c == 1 && (let o = ord c in o == 11 || o == 12));
// the strip family also removes NUL, which split's whitespace does not.
let is_strip_ch = fn (c: str) ->
  is_ws_ch c || (str_len c == 1 && ord c == 0);

let str_lstrip = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) -> if i < n && is_strip_ch (char_at s i) then go (i + 1) else i in
  substring s (go 0) n;
let str_rstrip = fn (s: str) ->
  let rec go = fn (i: int) -> if i >= 0 && is_strip_ch (char_at s i) then go (i - 1) else i in
  substring s 0 (go (str_len s - 1) + 1);

// awk-mode split: on runs of whitespace, leading whitespace stripped, no
// empty fields. This is what String#split with no argument (or with a single
// space " ") does in Ruby, distinct from splitting on a literal space.
let awk_split = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) ->
    let rec skip = fn (j: int) -> if j < n && is_ws_ch (char_at s j) then skip (j + 1) else j in
    let start = skip i in
    if start >= n then (Nil : str list)
    else
      let rec fld = fn (j: int) -> if j < n && (is_ws_ch (char_at s j) == false) then fld (j + 1) else j in
      let stop = fld start in
      Cons (substring s start stop, go stop) in
  go 0;
// awk-mode with a POSITIVE limit (limit 1 never reaches here -- split answers
// [self] verbatim for it): leading whitespace is skipped, fields split on
// whitespace runs until the limit leaves one slot, the remainder (from the
// first byte of the next field) is the last field VERBATIM -- and a string
// ending in whitespace contributes one final empty field when the limit still
// has room (" 1 2 ".split(" ", 3) is ["1", "2", ""]).
let awk_split_lim = fn (s: str) -> fn (lim: int) ->
  let n = str_len s in
  let rec skip = fn (j: int) -> if j < n && is_ws_ch (char_at s j) then skip (j + 1) else j in
  let rec fld = fn (j: int) -> if j < n && (is_ws_ch (char_at s j) == false) then fld (j + 1) else j in
  let rec go = fn (i: int) -> fn (k: int) ->
    let start = skip i in
    if start >= n then (if i < n then Cons ("", Nil) else (Nil : str list))
    else if k + 1 >= lim then Cons (substring s start n, Nil)
    else
      let stop = fld start in
      Cons (substring s start stop, go stop (k + 1)) in
  go 0 0;

// remove one trailing record separator: \r\n, then \n or \r.
let str_chomp = fn (s: str) ->
  let n = str_len s in
  if n >= 2 && str_eq (substring s (n - 2) n) "\r\n" then substring s 0 (n - 2)
  else if n >= 1 && (str_eq (char_at s (n - 1)) "\n" || str_eq (char_at s (n - 1)) "\r") then substring s 0 (n - 1)
  else s;
// chomp with an explicit separator: "" strips every trailing line ending
// (\r\n pairs and \n, never a bare \r), "\n" behaves like the default, and
// any other separator is removed once from the end.
let str_chomp_sep = fn (s: str) -> fn (sep: str) ->
  if str_eq sep "\n" then str_chomp s
  else if str_eq sep "" then
    (let rec back = fn (j: int) ->
       if j >= 2 && str_eq (substring s (j - 2) j) "\r\n" then back (j - 2)
       else if j >= 1 && str_eq (char_at s (j - 1)) "\n" then back (j - 1)
       else j in
     substring s 0 (back (str_len s)))
  else
    (let ns = str_len s in let ms = str_len sep in
     if ms > 0 && ns >= ms && str_eq (substring s (ns - ms) ns) sep then substring s 0 (ns - ms) else s);
// remove the last CHARACTER (a trailing \r\n counts as one).
let str_chop = fn (s: str) ->
  let n = str_len s in
  if n >= 2 && str_eq (substring s (n - 2) n) "\r\n" then substring s 0 (n - 2)
  else if n >= 1 then
    (let rec lastst = fn (i: int) -> fn (best: int) ->
       if i >= n then best else lastst (i + utf8_clen s i) i in
     substring s 0 (lastst 0 0))
  else s;

// index of the first occurrence of pat in s at or after i, or -1.
let rec str_find_from = fn (s: str) -> fn (pat: str) -> fn (i: int) ->
  let n = str_len s in let m = str_len pat in
  if i + m > n then 0 - 1
  else if str_eq (substring s i (i + m)) pat then i
  else str_find_from s pat (i + 1);
// split into pieces each KEEPING the separator; "" is paragraph mode (pieces
// end at a run of two or more newlines, the whole run staying attached).
let str_lines_sep = fn (s: str) -> fn (sep: str) ->
  let n = str_len s in
  if str_eq sep "" then
    (let rec eat_nl = fn (j: int) -> if j < n && str_eq (char_at s j) "\n" then eat_nl (j + 1) else j in
     let rec go = fn (start: int) -> fn (i: int) ->
       if i >= n then (if start < n then Cons (substring s start n, (Nil : str list)) else Nil)
       else if str_eq (char_at s i) "\n" && i + 1 < n && str_eq (char_at s (i + 1)) "\n" then
         (let stop = eat_nl (i + 1) in
          Cons (substring s start stop, go stop stop))
       else go start (i + 1) in
     go 0 0)
  else
    (let m = str_len sep in
     let rec go = fn (start: int) ->
       if start >= n then (Nil : str list)
       else
         let i = str_find_from s sep start in
         (if i < 0 then Cons (substring s start n, Nil)
          else Cons (substring s start (i + m), go (i + m))) in
     go 0);

// the LAST occurrence of pat, or -1.
let rec str_rfind = fn (s: str) -> fn (pat: str) -> fn (i: int) -> fn (best: int) ->
  let j = str_find_from s pat i in
  if j < 0 then best else str_rfind s pat (j + 1) j;
// expand \&/\0 (whole match m), \\ and \x in a replacement for a string
// pattern; \1..\9 become empty (a string pattern has no capture groups).
let rec lit_expand_rep = fn (rep: str) -> fn (m: str) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len rep in
  if i >= n then acc
  else
    let c = char_at rep i in
    if str_eq c "\\" && i + 1 < n then
      let d = char_at rep (i + 1) in
      if str_eq d "&" || str_eq d "0" then lit_expand_rep rep m (i + 2) (acc ++ m)
      else if is_digit d then lit_expand_rep rep m (i + 2) acc
      else if str_eq d "\\" then lit_expand_rep rep m (i + 2) (acc ++ "\\")
      else lit_expand_rep rep m (i + 2) (acc ++ "\\" ++ d)
    else lit_expand_rep rep m (i + 1) (acc ++ c);
// interleave rep between/around every character (empty-pattern sub/gsub).
let rec str_interleave = fn (s: str) -> fn (rep: str) -> fn (i: int) ->
  if i >= str_len s then rep
  else rep ++ char_at s i ++ str_interleave s rep (i + 1);
let str_sub_lit = fn (s: str) -> fn (pat: str) -> fn (rep0: str) ->
  if str_len pat == 0 then lit_expand_rep rep0 "" 0 "" ++ s
  else
    let i = str_find_from s pat 0 in
    if i < 0 then s
    else substring s 0 i ++ lit_expand_rep rep0 pat 0 "" ++ substring s (i + str_len pat) (str_len s);
let rec str_gsub_lit = fn (s: str) -> fn (pat: str) -> fn (rep0: str) ->
  let m = str_len pat in
  if m == 0 then str_interleave s (lit_expand_rep rep0 "" 0 "") 0
  else
    let i = str_find_from s pat 0 in
    if i < 0 then s
    else substring s 0 i ++ lit_expand_rep rep0 pat 0 "" ++ str_gsub_lit (substring s (i + m) (str_len s)) pat rep0;

// explode a string into a list of one-character VStr values.
let rec str_chars_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else Cons (mkstr (char_at s i), str_chars_val s (i + 1));

