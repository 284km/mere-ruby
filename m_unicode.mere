// the numbers are the platform's (ENOTSUP is 45 on darwin and 95 on linux),
// so the table is the one for the OS this binary runs under -- on RISC-V that
// is linux, which is what memu's guest errno speaks (v0.1.641)
let errno_raw = (if str_eq (sys_os ()) "linux" then errno_raw_linux else errno_raw_darwin);
