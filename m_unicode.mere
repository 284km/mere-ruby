// ENC_NORM_TABLES END
let gcb_lo = vec_new ();
let gcb_hi = vec_new ();
let gcb_kv = map_new ();
let gcb_build = fn (u: unit) ->
  if vec_len gcb_lo > 0 then ()
  else
    let n = str_len gcb_raw in
    let rec fin = fn (j: int) -> if j < n && (if str_eq (char_at gcb_raw j) "," then false else true) then fin (j + 1) else j in
    let rec dashp = fn (j: int) -> if str_eq (char_at gcb_raw j) "-" then j else dashp (j + 1) in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = fin i in
        let d = dashp i in
        let lo = jis_hex gcb_raw i d 0 in
        let hi = jis_hex gcb_raw (d + 1) (e - 2) 0 in
        let k = substring gcb_raw (e - 1) e in
        let _ = vec_push gcb_lo lo in
        let _ = vec_push gcb_hi hi in
        let _ = map_set gcb_kv (str_of_int (vec_len gcb_lo - 1)) k in
        go (e + 1) in
    go 0;
// the Grapheme_Cluster_Break class of a codepoint ("" = Other).
let gcb_cls = fn (cp: int) ->
  if cp < 0 then ""
  else
    let _ = gcb_build () in
    let rec bs = fn (lo: int) -> fn (hi: int) ->
      if lo > hi then ""
      else
        let mid = (lo + hi) / 2 in
        (if cp < vec_get gcb_lo mid then bs lo (mid - 1)
         else if cp > vec_get gcb_hi mid then bs (mid + 1) hi
         else map_get gcb_kv (str_of_int mid)) in
    bs 0 (vec_len gcb_lo - 1);
// is there a boundary between prev and cur? (GB3-GB13; epl = "the previous
// run was ExtPict Extend* ZWJ", rieven = "an even number of RIs so far").
let gcb_break = fn (pk: str) -> fn (ck: str) -> fn (epl: bool) -> fn (rieven: bool) ->
  if str_eq pk "R" && str_eq ck "L" then false
  else if str_eq pk "C" || str_eq pk "R" || str_eq pk "L" then true
  else if str_eq ck "C" || str_eq ck "R" || str_eq ck "L" then true
  else if str_eq pk "1" && (str_eq ck "1" || str_eq ck "2" || str_eq ck "4" || str_eq ck "5") then false
  else if (str_eq pk "2" || str_eq pk "4") && (str_eq ck "2" || str_eq ck "3") then false
  else if (str_eq pk "3" || str_eq pk "5") && str_eq ck "3" then false
  else if str_eq ck "E" || str_eq ck "Z" then false
  else if str_eq ck "S" then false
  else if str_eq pk "P" then false
  else if str_eq pk "Z" && str_eq ck "X" && epl then false
  else if str_eq pk "I" && str_eq ck "I" && (if rieven then false else true) then false
