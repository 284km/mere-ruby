  else if cpx && o i >= 161 && o i <= 223 then Cons (65377 + o i - 161, iso2022_dec cpx s (i + 1) mode)
  else if o i >= 128 then Cons (0 - 1, iso2022_dec cpx s (i + 1) mode)
  else if mode == 1 then
    (if o i < 33 || o i > 126 then Cons (0 - 1, iso2022_dec cpx s (i + 1) mode)
     else if o (i + 1) < 33 || o (i + 1) > 126 then Cons (0 - 1, iso2022_dec cpx s (i + 1) mode)
     else
       // (CP50220/50221 read the pair as Windows-31J does: the NEC and IBM
       //  rows, and 0x224C is U+FFE2, not JIS X 0208's U+00AC)
       (let sj9 = sjis_of_jis (o i) (o (i + 1)) in
        let w9 = (if cpx then jisv_dec "WINDOWS-31J" (ord (char_at sj9 0)) (ord (char_at sj9 1)) else 0 - 1) in
        let ch = (if w9 >= 0 then utf8_enc w9 else jis_e2u_ch (jis_hx2 (o i + 128) ++ jis_hx2 (o (i + 1) + 128))) in
        if str_eq ch "" then Cons (0 - (10 + i), iso2022_dec cpx s (i + 2) mode)
        else Cons ((match utf8_cp ch 0 with (c, _) -> c), iso2022_dec cpx s (i + 2) mode)))
