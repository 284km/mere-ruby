let sock_consts = (if str_eq (sys_os ()) "linux" then sock_consts_linux else sock_consts_darwin);
// ERRNO_TABLE END
let errno_num_tbl = map_new ();
let errno_txt_tbl = map_new ();
let errno_by_num = map_new ();
let errno_build = fn (u: unit) ->
  if map_len errno_num_tbl > 0 then ()
  else
    let n = str_len errno_raw in
    let rec digs = fn (s: str) -> fn (j: int) -> fn (acc: int) ->
      if j >= str_len s then acc else digs s (j + 1) (acc * 10 + (ord (char_at s j) - 48)) in
    let rec upto = fn (j: int) -> fn (c: str) ->
      if j < n && (if str_eq (char_at errno_raw j) c then false else true) then upto (j + 1) c else j in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = upto i "," in
        let c1 = upto i ":" in
        let c2 = upto (c1 + 1) ":" in
        let nm = substring errno_raw i c1 in
        let num = digs (substring errno_raw (c1 + 1) c2) 0 0 in
        let txt = substring errno_raw (c2 + 1) e in
        let _ = map_set errno_num_tbl nm num in
        let _ = map_set errno_txt_tbl nm txt in
        // (a number answers its first name; 0 answers NOERROR, not the
        //  names darwin's ruby defines with no number of their own)
        let _ = (if map_has errno_by_num (str_of_int num) && (if str_eq nm "NOERROR" then false else true) then ()
                 else map_set errno_by_num (str_of_int num) nm) in
        go (e + 1) in
    go 0;

let rec str_case_seq = fn (s: str) -> fn (i: int) -> fn mapper -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let cpl = utf8_cp s i in
    let cp = (match cpl with (c, _) -> c) in
    let l = (match cpl with (_, ln) -> ln) in
    str_case_seq s (i + l) mapper (acc ++ cps_utf8 (mapper cp));
let rec rb_iseq_app = fn (a: int list) -> fn (b: int list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, rb_iseq_app t b);
let str_fold_case = fn (s: str) -> rb_case_str "d" "f" s;
// (:ascii | :fold | :turkic [:lithuanian]) as ruby validates them.
let rb_case_opt = fn (args: Val list) -> fn (allow_fold: bool) ->
  match args with
  | Nil -> ""
  | Cons (VSym o1, Nil) ->
    (if str_eq o1 "ascii" then "a"
     else if str_eq o1 "turkic" then "t"
     else if str_eq o1 "lithuanian" then ""
     else if str_eq o1 "fold" && allow_fold then "f"
     else (let _ = prim_raise "ArgumentError" ("invalid option: :" ++ o1) in ""))
  | Cons (VSym o1, Cons (VSym o2, Nil)) ->
    (if (str_eq o1 "turkic" && str_eq o2 "lithuanian") || (str_eq o1 "lithuanian" && str_eq o2 "turkic") then "t"
     else (let _ = prim_raise "ArgumentError" ("invalid option: :" ++ o2) in ""))
  | _ -> (let _ = prim_raise "ArgumentError" "invalid option" in "");
// the whole method: ASCII-compatible encodings walk the bytes; UTF-16/32
// decode to codepoints, map, and encode back. The result keeps the encoding.
// a multibyte encoding other than UTF-8 (EUC-JP, Shift_JIS, ...) maps only
// its one-byte ASCII letters, whole characters: the "A" inside Windows-31J
// "\x81A" is the second byte of one character and stays (onigmo's
// ascii-only case map for these encodings)
let es_case_ascii = fn (s: str) -> fn (e: str) -> fn (kind: str) ->
  let b9 = strbuf_new () in
  let rec go = fn (i: int) -> fn (first: bool) ->
    if i >= str_len s then ()
    else
      (let l = enc_clen s e i in
       let c = substring s i (i + l) in
       let o = ord (char_at s i) in
       let up = l == 1 && o >= 97 && o <= 122 in
       let lo = l == 1 && o >= 65 && o <= 90 in
       let k2 = (if str_eq kind "c" then (if first then "u" else "d") else kind) in
       let out = (if up && (str_eq k2 "u" || str_eq k2 "s") then chr (o - 32)
                  else if lo && (str_eq k2 "d" || str_eq k2 "s") then chr (o + 32)
                  else c) in
       let _ = strbuf_push b9 out in
       go (i + l) false) in
  let _ = go 0 true in
  strbuf_to_str b9;
// the one-byte encodings whose upper half ruby case-maps -- exactly the
// Unicode mapping of each character, kept when the result cannot be written
// in the encoding (measured over every byte of every encoding, note 301)
let sbcs_cased = fn (e: str) ->
  str_eq e "ISO-8859-1" || str_eq e "ISO-8859-2" || str_eq e "ISO-8859-3" || str_eq e "ISO-8859-4"
  || str_eq e "ISO-8859-5" || str_eq e "ISO-8859-7" || str_eq e "ISO-8859-9" || str_eq e "ISO-8859-10"
  || str_eq e "ISO-8859-13" || str_eq e "ISO-8859-14" || str_eq e "ISO-8859-15" || str_eq e "ISO-8859-16"
  || str_eq e "Windows-1250" || str_eq e "Windows-1251" || str_eq e "Windows-1252" || str_eq e "Windows-1253"
  || str_eq e "Windows-1254" || str_eq e "Windows-1257";
let sbcs_case = fn (s: str) -> fn (e: str) -> fn (kind: str) -> fn (mode: str) ->
  let b9 = strbuf_new () in
  let rec go = fn (i: int) -> fn (first: bool) ->
    if i >= str_len s then ()
    else
      (let c = char_at s i in
       let k2 = (if str_eq kind "c" then (if first then "u" else "d") else kind) in
       let out =
         (match decode_cps c e 0 with
          | Cons (cp, Nil) ->
            (let m9 = rb_case_map1 k2 mode cp in
             // (Turkish İ lowers to a plain i in these encodings)
             let m2 = (match m9 with Cons (105, Cons (775, Nil)) -> Cons (105, (Nil : int list)) | _ -> m9) in
             match encode_cps m2 e "" with
             | (w9, true) -> w9
             | _ -> c)
          | _ -> c) in
       let _ = strbuf_push b9 out in
       go (i + 1) false) in
  let _ = go 0 true in
  strbuf_to_str b9;
let rb_case_apply = fn (sh: int) -> fn (kind: str) -> fn (mode: str) ->
  let e = enc_canon_name (senc_get sh) in
  // (a broken receiver is refused, as rb_str_casemap does: "input string
  //  invalid" -- the conversion went ahead byte by byte, note 301)
  let _ = (if str_is_ascii sh || enc_valid (sget sh) e then ()
           else (let _ = prim_raise "ArgumentError" "input string invalid" in ())) in
  let body =
    (if enc_ascii_compat e && enc_multibyte e && (if enc_utf8_family e then false else true) then es_case_ascii (sget sh) e kind
     else if sbcs_cased e && (if str_is_ascii sh then false else true) then sbcs_case (sget sh) e kind mode
     else if enc_ascii_compat e then rb_case_str kind mode (sget sh)
     else
       (let cps = decode_cps (sget sh) e 0 in
        let rec tr = fn (xs: int list) -> fn (first: bool) ->
          (match xs with
           | Nil -> (Nil : int list)
           | Cons (cp, t) ->
             let k2 = (if str_eq kind "c" then (if first then "u" else "d") else kind) in
             rb_iseq_app (rb_case_map1 k2 mode cp) (tr t false)) in
        (match encode_cps (tr cps true) e "" with (bytes, _) -> bytes))) in
  let c = mkstr body in
  (match c with VStr rid -> (let _ = senc_set rid e in c) | _ -> c);

