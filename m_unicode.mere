// DBCS_TABLES END
// The double-byte families (note 360): GBK and its GB2312 subset, Big5 and
// its HKSCS / UAO variants. Both maps are built on first use for one
// encoding: "ENC|LLTT" -> codepoint, and "ENC|cp" -> the two bytes, the
// first slot in byte order unless ruby's encoder names another (the *_rev
// lists). They read as Latin-1 bytes before: "\xA1@" in Big5 was "¡@".
let dbcs_d = map_new ();
let dbcs_e = map_new ();
let dbcs_ok = map_new ();
// (and the Korean pair, CP949 and its EUC-KR square: "\xBE\xD6" is U+C560)
let dbcs_is = fn (eu: str) ->
  str_eq eu "GBK" || str_eq eu "GB2312" || str_eq eu "BIG5" || str_eq eu "BIG5-HKSCS" || str_eq eu "BIG5-UAO"
  || str_eq eu "EUC-KR" || str_eq eu "CP949" || str_eq eu "GB18030";
let dbcs_lead_ok = fn (eu: str) -> fn (l: int) ->
  if str_eq eu "GB2312" || str_eq eu "EUC-KR" then l >= 161 && l <= 254 else l >= 129 && l <= 254;
let dbcs_trail_ok = fn (eu: str) -> fn (t: int) ->
  if str_eq eu "GB2312" || str_eq eu "EUC-KR" then t >= 161 && t <= 254
  else if str_eq eu "CP949" then (t >= 65 && t <= 90) || (t >= 97 && t <= 122) || (t >= 129 && t <= 254)
  else if str_eq eu "GBK" || str_eq eu "GB18030" then (t >= 64 && t <= 126) || (t >= 128 && t <= 254)
  else (t >= 64 && t <= 126) || (t >= 161 && t <= 254);
let dbcs_key = fn (l: int) -> fn (t: int) -> jis_hx2 l ++ jis_hx2 t;
// "a:b,c:d" pairs, each handed to f
let rec dbcs_pairs = fn (raw: str) -> fn (i: int) -> fn f ->
  if i >= str_len raw then ()
  else
    (let c = str_find_from raw "," i in
     let e = (if c < 0 then str_len raw else c) in
     let m = str_find_from raw ":" i in
     let _ = f (substring raw i m) (substring raw (m + 1) e) in
     dbcs_pairs raw (e + 1) f);
let dbcs_build = fn (eu: str) ->
  if map_has dbcs_ok eu then ()
  else
    (let _ = map_set dbcs_ok eu 1 in
     let kr = str_eq eu "EUC-KR" || str_eq eu "CP949" in
     let big = (if str_eq eu "GBK" || str_eq eu "GB2312" || str_eq eu "GB18030" || kr then false else true) in
     let grid = (if kr then dbcs_cp949_grid else if big then dbcs_big5_grid else dbcs_gbk_grid) in
     let nslots = str_len grid / 4 in
     let rec fill = fn (i: int) ->
       (if i >= nslots then ()
        else
          (let l = 129 + i / 191 in
           let t = 64 + i - (i / 191) * 191 in
           let cp = jis_hex grid (i * 4) (i * 4 + 4) 0 in
           let _ = (if cp > 0 && (if str_eq eu "GB2312" || str_eq eu "EUC-KR" then l >= 161 && t >= 161 else true)
                    then map_set dbcs_d (eu ++ "|" ++ dbcs_key l t) cp else ()) in
           fill (i + 1))) in
     let _ = fill 0 in
     let over = (if str_eq eu "BIG5-HKSCS" then dbcs_hkscs_over else if str_eq eu "BIG5-UAO" then dbcs_uao_over
                 else if str_eq eu "GB18030" then dbcs_gb18030_over else "") in
     let _ = dbcs_pairs over 0 (fn (k: str) -> fn (v: str) ->
               (let cp = jis_hex v 0 (str_len v) 0 in
                if cp == 0 then (if map_has dbcs_d (eu ++ "|" ++ k) then map_delete dbcs_d (eu ++ "|" ++ k) else ())
                else map_set dbcs_d (eu ++ "|" ++ k) cp)) in
     // the reverse map, first slot in byte order
     let rec rev = fn (i: int) ->
       (if i >= 126 * 191 then ()
        else
          (let k = dbcs_key (129 + i / 191) (64 + i - (i / 191) * 191) in
           let _ = (if map_has dbcs_d (eu ++ "|" ++ k) then
                      (let ck = eu ++ "|" ++ str_of_int (map_get dbcs_d (eu ++ "|" ++ k)) in
                       if map_has dbcs_e ck then () else map_set dbcs_e ck k)
                    else ()) in
           rev (i + 1))) in
     let _ = rev 0 in
     let fixes = (if str_eq eu "GBK" then dbcs_gbk_rev else if str_eq eu "GB2312" then dbcs_gb2312_rev
                  else if str_eq eu "CP949" then dbcs_cp949_rev else if str_eq eu "EUC-KR" then dbcs_euckr_rev
                  else if str_eq eu "GB18030" then dbcs_gb18030_rev
                  else if str_eq eu "BIG5" then dbcs_big5_rev else if str_eq eu "BIG5-HKSCS" then dbcs_hkscs_rev
                  else dbcs_uao_rev) in
     dbcs_pairs fixes 0 (fn (c: str) -> fn (k: str) ->
       (let ck = eu ++ "|" ++ str_of_int (jis_hex c 0 (str_len c) 0) in
        if str_eq k "0" then (if map_has dbcs_e ck then map_delete dbcs_e ck else ())
        else map_set dbcs_e ck k)));
let dbcs_to_cp = fn (eu: str) -> fn (l: int) -> fn (t: int) ->
  let _ = dbcs_build eu in
  let k = eu ++ "|" ++ dbcs_key l t in
  if map_has dbcs_d k then map_get dbcs_d k else 0 - 1;
let dbcs_from_cp = fn (eu: str) -> fn (cp: int) ->
  let _ = dbcs_build eu in
  let k = eu ++ "|" ++ str_of_int cp in
  if map_has dbcs_e k then (let p = map_get dbcs_e k in chr (jis_hex p 0 2 0) ++ chr (jis_hex p 2 4 0)) else "";
// GB18030's four-byte area: the BMP runs the generator wrote (gb18030_runs,
// "CP:IDX:LEN"), and above the BMP the linear count from 0x90308130.
let gb18_lin = fn (b0: int) -> fn (b1: int) -> fn (b2: int) -> fn (b3: int) ->
  (((b0 - 129) * 10 + (b1 - 48)) * 126 + (b2 - 129)) * 10 + (b3 - 48);
let gb18_supp0 = (((144 - 129) * 10 + 0) * 126 + 0) * 10 + 0;
// walk the runs: f answers -1 to go on, anything else to stop with it
let rec gb18_walk = fn (i: int) -> fn f ->
  if i >= str_len gb18030_runs then 0 - 1
  else
    (let c1 = str_find_from gb18030_runs ":" i in
     let c2 = str_find_from gb18030_runs ":" (c1 + 1) in
     let e0 = str_find_from gb18030_runs "," (c2 + 1) in
     let e = (if e0 < 0 then str_len gb18030_runs else e0) in
     let r = f (jis_hex gb18030_runs i c1 0) (jis_hex gb18030_runs (c1 + 1) c2 0) (jis_hex gb18030_runs (c2 + 1) e 0) in
     if r >= 0 then r else gb18_walk (e + 1) f);
let gb18_lin_to_cp = fn (lin: int) ->
  if lin >= gb18_supp0 then (let cp = 65536 + lin - gb18_supp0 in if cp <= 1114111 then cp else 0 - 1)
  else gb18_walk 0 (fn (c: int) -> fn (x: int) -> fn (n: int) -> if lin >= x && lin < x + n then c + (lin - x) else 0 - 1);
let gb18_cp_to_lin = fn (cp: int) ->
  if cp >= 65536 then gb18_supp0 + cp - 65536
  else gb18_walk 0 (fn (c: int) -> fn (x: int) -> fn (n: int) -> if cp >= c && cp < c + n then x + (cp - c) else 0 - 1);
let gb18_bytes = fn (lin0: int) ->
  let b3 = lin0 - (lin0 / 10) * 10 in
  let l1 = lin0 / 10 in
  let b2 = l1 - (l1 / 126) * 126 in
  let l2 = l1 / 126 in
  let b1 = l2 - (l2 / 10) * 10 in
  let b0 = l2 / 10 in
  chr (b0 + 129) ++ chr (b1 + 48) ++ chr (b2 + 129) ++ chr (b3 + 48);
// The JIS family's variants over their base (Windows-31J over Shift_JIS,
// eucJP-ms and CP51932 over EUC-JP), and EBCDIC (IBM037), all from the
// generated block above. "ENC|LLTT" -> codepoint (0: none there), and
// "ENC|cp" -> "LLTT" ("0": cannot be encoded).
let jisv_d = map_new ();
let jisv_e = map_new ();
let jisv_ok = map_new ();
let jisv_is = fn (eu: str) -> str_eq eu "WINDOWS-31J" || str_eq eu "EUCJP-MS" || str_eq eu "CP51932";
let jisv_build = fn (eu: str) ->
  if map_has jisv_ok eu then ()
  else
    (let _ = map_set jisv_ok eu 1 in
     let dec = (if str_eq eu "WINDOWS-31J" then jisv_w31j_dec else if str_eq eu "EUCJP-MS" then jisv_eucms_dec else jisv_cp51932_dec) in
     let enc = (if str_eq eu "WINDOWS-31J" then jisv_w31j_enc else if str_eq eu "EUCJP-MS" then jisv_eucms_enc else jisv_cp51932_enc) in
     let _ = dbcs_pairs dec 0 (fn (k: str) -> fn (v: str) -> map_set jisv_d (eu ++ "|" ++ k) (jis_hex v 0 (str_len v) 0)) in
     dbcs_pairs enc 0 (fn (c: str) -> fn (k: str) -> map_set jisv_e (eu ++ "|" ++ str_of_int (jis_hex c 0 (str_len c) 0)) k));
// the variant's own answer for two bytes: -1 when it decodes as its base,
// 0 when it has no character there, else the codepoint
let jisv_dec = fn (eu: str) -> fn (l: int) -> fn (t: int) ->
  if (if jisv_is eu then false else true) then 0 - 1
  else
    (let _ = jisv_build eu in
     let k = eu ++ "|" ++ jis_hx2 l ++ jis_hx2 t in
     if map_has jisv_d k then map_get jisv_d k else 0 - 1);
// ...and for a codepoint: "" as its base, "0" none, else the two bytes
let jisv_enc = fn (eu: str) -> fn (cp: int) ->
  if (if jisv_is eu then false else true) then ""
  else
    (let _ = jisv_build eu in
     let k = eu ++ "|" ++ str_of_int cp in
     if map_has jisv_e k then (let p = map_get jisv_e k in if str_eq p "0" then "0" else chr (jis_hex p 0 2 0) ++ chr (jis_hex p 2 4 0))
     else "");
let ebcdic_d = map_new ();
let ebcdic_e = map_new ();
let ebcdic_build = fn (u: unit) ->
  if map_len ebcdic_d > 0 then ()
  else
    (let rec go = fn (i: int) -> fn (b: int) ->
       (if i >= str_len ebcdic037 then ()
        else
          (let c = str_find_from ebcdic037 "," i in
           let e = (if c < 0 then str_len ebcdic037 else c) in
           let cp = int_of_str (substring ebcdic037 i e) in
           let _ = map_set ebcdic_d (str_of_int b) cp in
           let _ = (if cp >= 0 && (if map_has ebcdic_e (str_of_int cp) then false else true) then map_set ebcdic_e (str_of_int cp) b else ()) in
           go (e + 1) (b + 1))) in
     go 0 0);
// a UTF-32 code unit at byte i (always 4 bytes).
let utf32_cp = fn (s: str) -> fn (i: int) -> fn (be: bool) ->
  if be then ((ord (char_at s i) * 256 + ord (char_at s (i + 1))) * 256 + ord (char_at s (i + 2))) * 256 + ord (char_at s (i + 3))
  else ((ord (char_at s (i + 3)) * 256 + ord (char_at s (i + 2))) * 256 + ord (char_at s (i + 1))) * 256 + ord (char_at s i);
let utf32_enc = fn (cp: int) -> fn (be: bool) ->
  if be then chr (cp / 16777216) ++ chr ((cp / 65536) - (cp / 16777216) * 256) ++ chr ((cp / 256) - (cp / 65536) * 256) ++ chr (cp - (cp / 256) * 256)
  else chr (cp - (cp / 256) * 256) ++ chr ((cp / 256) - (cp / 65536) * 256) ++ chr ((cp / 65536) - (cp / 16777216) * 256) ++ chr (cp / 16777216);
let enc_is_utf32 = fn (nm: str) -> let t = enc_up nm in str_eq t "UTF-32BE" || str_eq t "UTF-32LE";
// How many bytes a broken UTF-8 sequence at i is: the lead and the
// continuations that fit it (Unicode's "maximal subpart", which ruby's
// transcoder replaces as ONE character). "\xE0\x80" is two, "\xE3\x81" at
// the end one; each was one replacement for the whole run before.
let utf8_bad_len = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  let b0 = ord (char_at s i) in
  let (need, lo, hi) = (if b0 >= 194 && b0 <= 223 then (1, 128, 191)
                        else if b0 == 224 then (2, 160, 191)
                        else if b0 == 237 then (2, 128, 159)
                        else if b0 >= 225 && b0 <= 239 then (2, 128, 191)
                        else if b0 == 240 then (3, 144, 191)
                        else if b0 >= 241 && b0 <= 243 then (3, 128, 191)
                        else if b0 == 244 then (3, 128, 143)
                        else (0, 0, 0)) in
  let rec go = fn (k: int) ->
    (if k > need || i + k >= n then k
     else
