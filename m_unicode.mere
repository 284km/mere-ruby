// ARITY_TABLE END
let arity_tbl = map_new ();      // "Cls#name" -> min * 1024 + (max + 1)
let arity_blk_tbl = map_new ();  // ...as called WITH a block
let arity_num_tbl = map_new ();  // "Cls#name" -> what #arity REPORTS (see arity_num_raw)
let arity_names = map_new ();    // "name" -> 1, the cheap prefilter on the hot path
let arity_state = map_new ();
let arity_load = fn (tbl) -> fn (raw: str) ->
    let n = str_len raw in
    // a digits-only reader: str_to_int_base is defined further down the file.
    let rec digs = fn (s: str) -> fn (j: int) -> fn (acc: int) ->
      if j >= str_len s then acc else digs s (j + 1) (acc * 10 + (ord (char_at s j) - 48)) in
    let pint = fn (s: str) ->
      if str_len s > 0 && str_eq (char_at s 0) "-" then 0 - digs s 1 0 else digs s 0 0 in
    let rec upto = fn (j: int) -> fn (c: str) ->
      if j < n && (if str_eq (char_at raw j) c then false else true) then upto (j + 1) c else j in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = upto i "," in
        let c1 = upto i ":" in
        let c2 = upto (c1 + 1) ":" in
        let key = substring raw i c1 in
        let lo = pint (substring raw (c1 + 1) c2) in
        let hi = pint (substring raw (c2 + 1) e) in
        let nm = substring raw (upto i "#" + 1) c1 in
        let _ = map_set tbl key (lo * 1024 + (hi + 1)) in
        let _ = map_set arity_names nm 1 in
        go (e + 1) in
    go 0;
let arity_num_load = fn (raw: str) ->
    let n = str_len raw in
    let rec digs = fn (s: str) -> fn (j: int) -> fn (acc: int) ->
      if j >= str_len s then acc else digs s (j + 1) (acc * 10 + (ord (char_at s j) - 48)) in
    let pint = fn (s: str) ->
      if str_len s > 0 && str_eq (char_at s 0) "-" then 0 - digs s 1 0 else digs s 0 0 in
    let rec upto = fn (j: int) -> fn (c: str) ->
      if j < n && (if str_eq (char_at raw j) c then false else true) then upto (j + 1) c else j in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = upto i "," in
        let c1 = upto i ":" in
        let _ = map_set arity_num_tbl (substring raw i c1) (pint (substring raw (c1 + 1) e)) in
        go (e + 1) in
    go 0;
let arity_build = fn (u: unit) ->
  if map_len arity_names > 0 then ()
  else
    let _ = arity_load arity_tbl arity_raw in
    let _ = arity_num_load arity_num_raw in
    arity_load arity_blk_tbl arity_blk_raw;

// ---- errno: the platform's numbers and its own words ----------------------
// Generated by tools/gen_errno_table.rb from the reference ruby. The numbers
// are the PLATFORM's (ENOTSUP is 45 on darwin and 95 on linux), so they can no
// more be written down by hand than the case tables can, and the text is what
// `Errno::ENOENT.new.message` prints. Rows are "NAME:number:text".
// ERRNO_TABLE BEGIN
let errno_raw = "E2BIG:7:Argument list too long,EACCES:13:Permission denied,EADDRINUSE:48:Address already in use,EADDRNOTAVAIL:49:Can't assign requested address,EAFNOSUPPORT:47:Address family not supported by protocol family,EAGAIN:35:Resource temporarily unavailable,EALREADY:37:Operation already in progress,EAUTH:80:Authentication error,EBADARCH:86:Bad CPU type in executable,EBADEXEC:85:Bad executable (or shared library),EBADF:9:Bad file descriptor,EBADMACHO:88:Malformed Mach-o file,EBADMSG:94:Bad message,EBADRPC:72:RPC struct is bad,EBUSY:16:Resource busy,ECANCELED:89:Operation canceled,ECHILD:10:No child processes,ECONNABORTED:53:Software caused connection abort,ECONNREFUSED:61:Connection refused,ECONNRESET:54:Connection reset by peer,EDEADLK:11:Resource deadlock avoided,EDESTADDRREQ:39:Destination address required,EDEVERR:83:Device error,EDOM:33:Numerical argument out of domain,EDQUOT:69:Disc quota exceeded,EEXIST:17:File exists,EFAULT:14:Bad address,EFBIG:27:File too large,EFTYPE:79:Inappropriate file type or format,EHOSTDOWN:64:Host is down,EHOSTUNREACH:65:No route to host,EIDRM:90:Identifier removed,EILSEQ:92:Illegal byte sequence,EINPROGRESS:36:Operation now in progress,EINTR:4:Interrupted system call,EINVAL:22:Invalid argument,EIO:5:Input/output error,EISCONN:56:Socket is already connected,EISDIR:21:Is a directory,ELAST:107:Capabilities insufficient,ELOOP:62:Too many levels of symbolic links,EMFILE:24:Too many open files,EMLINK:31:Too many links,EMSGSIZE:40:Message too long,EMULTIHOP:95:EMULTIHOP (Reserved),ENAMETOOLONG:63:File name too long,ENEEDAUTH:81:Need authenticator,ENETDOWN:50:Network is down,ENETRESET:52:Network dropped connection on reset,ENETUNREACH:51:Network is unreachable,ENFILE:23:Too many open files in system,ENOATTR:93:Attribute not found,ENOBUFS:55:No buffer space available,ENODATA:96:No message available on STREAM,ENODEV:19:Operation not supported by device,ENOENT:2:No such file or directory,ENOEXEC:8:Exec format error,ENOLCK:77:No locks available,ENOLINK:97:ENOLINK (Reserved),ENOMEM:12:Cannot allocate memory,ENOMSG:91:No message of desired type,ENOPOLICY:103:Policy not found,ENOPROTOOPT:42:Protocol not available,ENOSPC:28:No space left on device,ENOSR:98:No STREAM resources,ENOSTR:99:Not a STREAM,ENOSYS:78:Function not implemented,ENOTBLK:15:Block device required,ENOTCAPABLE:107:Capabilities insufficient,ENOTCONN:57:Socket is not connected,ENOTDIR:20:Not a directory,ENOTEMPTY:66:Directory not empty,ENOTRECOVERABLE:104:State not recoverable,ENOTSOCK:38:Socket operation on non-socket,ENOTSUP:45:Operation not supported,ENOTTY:25:Inappropriate ioctl for device,ENXIO:6:Device not configured,EOPNOTSUPP:102:Operation not supported on socket,EOVERFLOW:84:Value too large to be stored in data type,EOWNERDEAD:105:Previous owner died,EPERM:1:Operation not permitted,EPFNOSUPPORT:46:Protocol family not supported,EPIPE:32:Broken pipe,EPROCLIM:67:Too many processes,EPROCUNAVAIL:76:Bad procedure for program,EPROGMISMATCH:75:Program version wrong,EPROGUNAVAIL:74:RPC prog. not avail,EPROTO:100:Protocol error,EPROTONOSUPPORT:43:Protocol not supported,EPROTOTYPE:41:Protocol wrong type for socket,EPWROFF:82:Device power is off,EQFULL:106:Interface output queue is full,ERANGE:34:Result too large,EREMOTE:71:Too many levels of remote in path,EROFS:30:Read-only file system,ERPCMISMATCH:73:RPC version wrong,ESHLIBVERS:87:Shared library version mismatch,ESHUTDOWN:58:Can't send after socket shutdown,ESOCKTNOSUPPORT:44:Socket type not supported,ESPIPE:29:Illegal seek,ESRCH:3:No such process,ESTALE:70:Stale NFS file handle,ETIME:101:STREAM ioctl timeout,ETIMEDOUT:60:Operation timed out,ETXTBSY:26:Text file busy,EUSERS:68:Too many users,EWOULDBLOCK:35:Resource temporarily unavailable,EXDEV:18:Cross-device link";
// ERRNO_TABLE END
let errno_num_tbl = map_new ();
let errno_txt_tbl = map_new ();
let errno_by_num = map_new ();
let errno_build = fn (u: unit) ->
  if map_len errno_num_tbl > 0 then ()
  else
    let n = str_len errno_raw in
    let rec digs = fn (s: str) -> fn (j: int) -> fn (acc: int) ->
      if j >= str_len s then acc else digs s (j + 1) (acc * 10 + (ord (char_at s j) - 48)) in
    let rec upto = fn (j: int) -> fn (c: str) ->
      if j < n && (if str_eq (char_at errno_raw j) c then false else true) then upto (j + 1) c else j in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = upto i "," in
        let c1 = upto i ":" in
        let c2 = upto (c1 + 1) ":" in
        let nm = substring errno_raw i c1 in
        let num = digs (substring errno_raw (c1 + 1) c2) 0 0 in
        let txt = substring errno_raw (c2 + 1) e in
        let _ = map_set errno_num_tbl nm num in
        let _ = map_set errno_txt_tbl nm txt in
        let _ = (if map_has errno_by_num (str_of_int num) then () else map_set errno_by_num (str_of_int num) nm) in
        go (e + 1) in
    go 0;

let case_up_tbl = map_new ();
let case_down_tbl = map_new ();
let case_fold_tbl = map_new ();
let case_tbl_load = fn tbl -> fn (raw: str) ->
  let n = str_len raw in
  let rec fin = fn (j: int) -> if j < n && (if str_eq (char_at raw j) "," then false else true) then fin (j + 1) else j in
  let rec colon = fn (j: int) -> if str_eq (char_at raw j) ":" then j else colon (j + 1) in
  let rec go = fn (i: int) ->
    if i >= n then ()
    else
      let e = fin i in
      let c = colon i in
      let _ = map_set tbl (substring raw i c) (substring raw (c + 1) e) in
      go (e + 1) in
  go 0;
let case_tbls_build = fn (u: unit) ->
  if map_len case_up_tbl > 0 then ()
  else
    let _ = case_tbl_load case_up_tbl case_up_raw in
    let _ = case_tbl_load case_down_tbl case_down_raw in
    case_tbl_load case_fold_tbl case_fold_raw;
let cp_hex = fn (cp: int) ->
  let rec hx = fn (v: int) -> fn (acc: str) ->
    if v == 0 then acc
    else hx (v / 16) ((let d = v - (v / 16) * 16 in chr (if d < 10 then 48 + d else 55 + d)) ++ acc) in
  if cp == 0 then "0" else hx cp "";
// "53 53" -> the codepoints it names.
let case_seq_parse = fn (sv: str) ->
  let n = str_len sv in
  let rec go = fn (i: int) -> fn (cur: int) ->
    if i >= n then Cons (cur, (Nil : int list))
    else if str_eq (char_at sv i) " " then Cons (cur, go (i + 1) 0)
    else go (i + 1) (cur * 16 + (let o = ord (char_at sv i) in if o >= 65 then o - 55 else o - 48)) in
  go 0 0;
let cp_up_seq = fn (cp: int) ->
  let u = cp_upcase cp in
  if u != cp then Cons (u, (Nil : int list))
  else
    (let _ = case_tbls_build () in
     let k = cp_hex cp in
     if map_has case_up_tbl k then case_seq_parse (map_get case_up_tbl k) else Cons (cp, Nil));
let cp_down_seq = fn (cp: int) ->
  let d = cp_downcase cp in
  if d != cp then Cons (d, (Nil : int list))
  else
    (let _ = case_tbls_build () in
     let k = cp_hex cp in
     if map_has case_down_tbl k then case_seq_parse (map_get case_down_tbl k) else Cons (cp, Nil));
// casecmp? folds; a codepoint with no special folding folds to its downcase.
let cp_fold_seq = fn (cp: int) ->
  let _ = case_tbls_build () in
  let k = cp_hex cp in
  if map_has case_fold_tbl k then case_seq_parse (map_get case_fold_tbl k) else cp_down_seq cp;
let cp_swap_seq = fn (cp: int) ->
  let d = cp_downcase cp in
  if d != cp then Cons (d, (Nil : int list))
  else
    let u = cp_upcase cp in
    if u != cp then Cons (u, (Nil : int list))
    else
      (let _ = case_tbls_build () in
       let k = cp_hex cp in
       if map_has case_down_tbl k then case_seq_parse (map_get case_down_tbl k)
       else if map_has case_up_tbl k then case_seq_parse (map_get case_up_tbl k)
       else Cons (cp, Nil));
let rec cps_utf8 = fn (xs: int list) ->
  match xs with Nil -> "" | Cons (h, t) -> utf8_enc h ++ cps_utf8 t;
let rec str_case_seq = fn (s: str) -> fn (i: int) -> fn mapper -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let cpl = utf8_cp s i in
    let cp = (match cpl with (c, _) -> c) in
    let l = (match cpl with (_, ln) -> ln) in
    str_case_seq s (i + l) mapper (acc ++ cps_utf8 (mapper cp));
// one string-domain walker for the four case methods: maps codepoints,
// passes bytes that are not valid UTF-8 through unchanged, downcases a
// word-final capital sigma to its final form, and titlecases the head for
// capitalize (a multi-character upcase keeps only its first capital).
// kind: "u" up, "d" down, "s" swap, "c" capitalize.
// mode: "" plain, "a" ascii-only, "t" turkic, "f" fold (downcase only).
let rb_case_map1 = fn (kind: str) -> fn (mode: str) -> fn (cp: int) ->
  if str_eq mode "a" then
    Cons ((if str_eq kind "u" then (if cp >= 97 && cp <= 122 then cp - 32 else cp)
           else if str_eq kind "d" then (if cp >= 65 && cp <= 90 then cp + 32 else cp)
           else (if cp >= 97 && cp <= 122 then cp - 32 else if cp >= 65 && cp <= 90 then cp + 32 else cp)), (Nil : int list))
  else if str_eq mode "f" then cp_fold_seq cp
  else if str_eq kind "u" then (if str_eq mode "t" && cp == 105 then Cons (304, (Nil : int list)) else cp_up_seq cp)
  else if str_eq kind "d" then
    (if str_eq mode "t" && cp == 73 then Cons (305, (Nil : int list))
     else if str_eq mode "t" && cp == 304 then Cons (105, (Nil : int list))
     else cp_down_seq cp)
  else
    (if str_eq mode "t" && cp == 73 then Cons (305, (Nil : int list))
     else if str_eq mode "t" && cp == 105 then Cons (304, (Nil : int list))
     else cp_swap_seq cp);
let rec rb_iseq_app = fn (a: int list) -> fn (b: int list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, rb_iseq_app t b);
let rb_case_str = fn (kind: str) -> fn (mode: str) -> fn (s: str) ->
  let n = str_len s in
  let isl = fn (cp: int) -> (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp >= 128 in
  let rec go = fn (i: int) -> fn (first: bool) -> fn (prevl: bool) -> fn (acc: str) ->
    if i >= n then acc
    else
      let cpl = utf8_cp s i in
      let cp = (match cpl with (c, _) -> c) in
      let l = (match cpl with (_, ln) -> ln) in
      if cp >= 128 && l == 1 then go (i + l) false true (acc ++ substring s i (i + 1))
      else
        let k2 = (if str_eq kind "c" then (if first then "u" else "d") else kind) in
        let piece =
          (if str_eq k2 "d" && cp == 931 && (str_eq mode "" || str_eq mode "t") then
             (let nxt = (if i + l >= n then 0 - 1 else (match utf8_cp s (i + l) with (c2, _) -> c2)) in
              let final = prevl && (if nxt < 0 then true else (if isl nxt then false else true)) in
              utf8_enc (if final then 962 else 963))
           else if str_eq kind "c" && first then
             (let useq = rb_case_map1 "u" mode cp in
              let head = (match useq with Cons (hh, _) -> hh | Nil -> cp) in
              let tl = (match useq with Cons (_, tt) -> tt | Nil -> (Nil : int list)) in
              let rec dnl = fn (xs: int list) -> fn (a2: str) ->
                (match xs with Nil -> a2 | Cons (hh, tt) -> dnl tt (a2 ++ cps_utf8 (rb_case_map1 "d" mode hh))) in
              utf8_enc head ++ dnl tl "")
           else cps_utf8 (rb_case_map1 k2 mode cp)) in
        go (i + l) false (isl cp) (acc ++ piece) in
  go 0 true false "";
let str_upcase = fn (s: str) -> rb_case_str "u" "" s;
let str_fold_case = fn (s: str) -> rb_case_str "d" "f" s;
// (:ascii | :fold | :turkic [:lithuanian]) as ruby validates them.
let rb_case_opt = fn (args: Val list) -> fn (allow_fold: bool) ->
  match args with
  | Nil -> ""
  | Cons (VSym o1, Nil) ->
    (if str_eq o1 "ascii" then "a"
     else if str_eq o1 "turkic" then "t"
     else if str_eq o1 "lithuanian" then ""
     else if str_eq o1 "fold" && allow_fold then "f"
     else (let _ = prim_raise "ArgumentError" ("invalid option: :" ++ o1) in ""))
  | Cons (VSym o1, Cons (VSym o2, Nil)) ->
    (if (str_eq o1 "turkic" && str_eq o2 "lithuanian") || (str_eq o1 "lithuanian" && str_eq o2 "turkic") then "t"
     else (let _ = prim_raise "ArgumentError" ("invalid option: :" ++ o2) in ""))
  | _ -> (let _ = prim_raise "ArgumentError" "invalid option" in "");
// the whole method: ASCII-compatible encodings walk the bytes; UTF-16/32
// decode to codepoints, map, and encode back. The result keeps the encoding.
let rb_case_apply = fn (sh: int) -> fn (kind: str) -> fn (mode: str) ->
  let e = enc_canon_name (senc_get sh) in
  let body =
    (if enc_ascii_compat e then rb_case_str kind mode (sget sh)
     else
       (let cps = decode_cps (sget sh) e 0 in
        let rec tr = fn (xs: int list) -> fn (first: bool) ->
          (match xs with
           | Nil -> (Nil : int list)
           | Cons (cp, t) ->
             let k2 = (if str_eq kind "c" then (if first then "u" else "d") else kind) in
             rb_iseq_app (rb_case_map1 k2 mode cp) (tr t false)) in
        (match encode_cps (tr cps true) e "" with (bytes, _) -> bytes))) in
  let c = mkstr body in
  (match c with VStr rid -> (let _ = senc_set rid e in c) | _ -> c);

