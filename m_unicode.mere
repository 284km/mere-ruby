// ENC_JIS0208_TABLE END
let jis_e2u = map_new ();
let jis_u2e = map_new ();
let rec jis_hex = fn (s: str) -> fn (i: int) -> fn (e: int) -> fn (acc: int) ->
  if i >= e then acc
  else jis_hex s (i + 1) e (acc * 16 + (let o = ord (char_at s i) in if o >= 65 then o - 55 else o - 48));
let jis_hx2 = fn (b: int) ->
  let d = fn (v: int) -> chr (if v < 10 then 48 + v else 55 + v) in
  d (b / 16) ++ d (b - (b / 16) * 16);
// the two maps are built on first use; the raw literal costs nothing until a
// program actually transcodes CJK text.
let jis_tables_build = fn (u: unit) ->
  if map_len jis_e2u > 0 then ()
  else
    let n = str_len jis0208_raw in
    let rec fin = fn (j: int) -> if j < n && (if str_eq (char_at jis0208_raw j) "," then false else true) then fin (j + 1) else j in
    let rec go = fn (i: int) ->
      if i >= n then ()
      else
        let e = fin i in
        let pair = substring jis0208_raw i (i + 4) in
        let cp = jis_hex jis0208_raw (i + 5) e 0 in
        let ch = utf8_enc cp in
        let _ = map_set jis_e2u pair ch in
        let _ = map_set jis_u2e ch pair in
        go (e + 1) in
    go 0;
let jis_e2u_ch = fn (pair: str) ->
  let _ = jis_tables_build () in
  if map_has jis_e2u pair then map_get jis_e2u pair else "";
let jis_u2e_pair = fn (ch: str) ->
  let _ = jis_tables_build () in
  if map_has jis_u2e ch then map_get jis_u2e ch else "";
// Shift_JIS lead/trail from a JIS (EUC minus 0x80) row/cell pair, and back.
let sjis_of_jis = fn (j1: int) -> fn (j2: int) ->
  let s1 = (j1 + 1) / 2 + (if j1 <= 94 then 112 else 176) in
  let s2 = (if j1 - (j1 / 2) * 2 == 1 then j2 + 31 + (if j2 >= 96 then 1 else 0) else j2 + 126) in
  chr s1 ++ chr s2;
let jis_of_sjis = fn (l: int) -> fn (t: int) ->
  let l2 = (if l < 224 then l - 129 else l - 193) in
  let j1 = l2 * 2 + 33 + (if t >= 159 then 1 else 0) in
  let j2 = (if t >= 159 then t - 126 else t - 64 + 33 - (if t >= 128 then 1 else 0)) in
  (j1, j2);
// ISO-8859-15 differs from Latin-1 in exactly eight positions.
let iso15_to_cp = fn (b: int) ->
  if b == 164 then 8364 else if b == 166 then 352 else if b == 168 then 353
  else if b == 180 then 381 else if b == 184 then 382 else if b == 188 then 338
  else if b == 189 then 339 else if b == 190 then 376 else b;
let cp_to_iso15 = fn (cp: int) ->
  if cp == 8364 then 164 else if cp == 352 then 166 else if cp == 353 then 168
  else if cp == 381 then 180 else if cp == 382 then 184 else if cp == 338 then 188
  else if cp == 339 then 189 else if cp == 376 then 190
  else if cp <= 255 && (if cp == 164 || cp == 166 || cp == 168 || cp == 180 || cp == 184 || cp == 188 || cp == 189 || cp == 190 then false else true) then cp
  else 0 - 1;

// ISO-8859-9 (Turkish) is Latin-1 with six slots swapped for G-breve,
// dotted/dotless I and S-cedilla.
let iso9_to_cp = fn (b: int) ->
  if b == 208 then 286 else if b == 221 then 304 else if b == 222 then 350
  else if b == 240 then 287 else if b == 253 then 305 else if b == 254 then 351
  else b;
let cp_to_iso9 = fn (cp: int) ->
  if cp == 286 then 208 else if cp == 304 then 221 else if cp == 350 then 222
  else if cp == 287 then 240 else if cp == 305 then 253 else if cp == 351 then 254
