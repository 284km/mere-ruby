// Everything that needs a Unicode table: case mapping (ASCII and Latin-1 by
// formula, the full tables beyond), transcoding between the ASCII-compatible
// eight-bit encodings, JIS X 0208 both ways, grapheme clusters (UAX #29),
// normalization, the builtin arity table, errno names, and the integer /
// bignum helpers that sit beside them.
//
// A MODULE, spliced by `import` where these chains used to sit.
// ---- UTF-8-aware case mapping (ASCII + Latin-1 Supplement) ---------------
// decode the codepoint at byte i; returns (codepoint, byte_length).
// The continuation bytes are read only if they are there. A lead byte at the
// very end of a string claims a 2-4 byte sequence that the string does not
// contain -- which happens constantly on binary data, since any byte >= 0xC0
// looks like a lead byte -- and this used to read past the end and get whatever
// followed. On the compiled backends that was the NUL terminator, and the
// value was discarded anyway (only the LENGTH is used by utf8_clen), so nothing
// ever showed: SHA-1 of a 20-byte string walked off its buffer on every call
// and still produced the right digest. Mere started refusing the read in
// v0.1.275; `b` keeps the answer the same by supplying the 0 that the old
// out-of-bounds read returned.
// codepoint and byte length at byte i. A byte that does not START a valid
// sequence (a lone continuation byte, a truncated sequence, 0xF8+) is ONE
// one-byte character whose "codepoint" is the byte value — the same walk
// ruby's broken-string operations do. Believing such a byte's advertised
// length made "\xFF" claim four bytes (a garbage codepoint near 3.4M, which
// a set range like "\x00-\xFF" then expanded into millions of characters).
let utf8_cp = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  let b = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let cont = fn (k: int) -> (let v = b k in v >= 128 && v < 192) in
  let b0 = b i in
  if b0 < 128 then (b0, 1)
  else if b0 < 192 then (b0, 1)
  else if b0 < 224 then
    (if cont (i + 1) then ((b0 - 192) * 64 + (b (i + 1) - 128), 2) else (b0, 1))
  else if b0 < 240 then
    (if cont (i + 1) && cont (i + 2)
     then ((b0 - 224) * 4096 + (b (i + 1) - 128) * 64 + (b (i + 2) - 128), 3)
     else (b0, 1))
  else if b0 < 248 then
    (if cont (i + 1) && cont (i + 2) && cont (i + 3)
     then ((b0 - 240) * 262144 + (b (i + 1) - 128) * 4096 + (b (i + 2) - 128) * 64 + (b (i + 3) - 128), 4)
     else (b0, 1))
  else (b0, 1);
// encode a codepoint back to UTF-8 bytes.
let utf8_enc = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + cp - (cp / 64) * 64)
  else if cp < 65536 then chr (224 + cp / 4096) ++ chr (128 + (cp / 64) - (cp / 4096) * 64) ++ chr (128 + cp - (cp / 64) * 64)
  else chr (240 + cp / 262144) ++ chr (128 + (cp / 4096) - (cp / 262144) * 64) ++ chr (128 + (cp / 64) - (cp / 4096) * 64) ++ chr (128 + cp - (cp / 64) * 64);
// byte length of the codepoint at byte i.
let utf8_clen = fn (s: str) -> fn (i: int) -> (match utf8_cp s i with (c, l) -> l);
// STRICT decode at byte i: (codepoint, byte length, valid). Valid means the
// shortest form of a codepoint <= U+10FFFF outside the surrogates -- the test
// ruby's length / codepoint walks apply. An invalid unit is ONE byte, so a
// walk resynchronizes at the next byte the way CRuby's does.
let utf8_cp_strict = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  let b = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let cont = fn (k: int) -> (let v = b k in v >= 128 && v < 192) in
  let b0 = b i in
  if b0 < 128 then (b0, 1, true)
  else if b0 < 194 then (b0, 1, false)
  else if b0 < 224 then
    (if cont (i + 1) then ((b0 - 192) * 64 + (b (i + 1) - 128), 2, true) else (b0, 1, false))
  else if b0 < 240 then
    (if cont (i + 1) && cont (i + 2) then
       (let cp = (b0 - 224) * 4096 + (b (i + 1) - 128) * 64 + (b (i + 2) - 128) in
        if cp < 2048 || (cp >= 55296 && cp <= 57343) then (b0, 1, false) else (cp, 3, true))
     else (b0, 1, false))
  else if b0 < 245 then
    (if cont (i + 1) && cont (i + 2) && cont (i + 3) then
       (let cp = (b0 - 240) * 262144 + (b (i + 1) - 128) * 4096 + (b (i + 2) - 128) * 64 + (b (i + 3) - 128) in
        if cp < 65536 || cp > 1114111 then (b0, 1, false) else (cp, 4, true))
     else (b0, 1, false))
  else (b0, 1, false);
// character count the way ruby's String#length counts a UTF-8 string: every
// byte that does not start a valid sequence is one character by itself
// ("\xF4\x90\x80\x80" is U+110000, out of range, so FOUR characters -- the
// permissive utf8_len said one).
let rec utf8_len_strict_go = fn (s: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len s then n
  else utf8_len_strict_go s (i + (match utf8_cp_strict s i with (c, l, v) -> l)) (n + 1);
let utf8_len_strict = fn (s: str) -> utf8_len_strict_go s 0 0;
// number of codepoints in s.
let rec utf8_len_go = fn (s: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len s then n else utf8_len_go s (i + utf8_clen s i) (n + 1);
let utf8_len = fn (s: str) -> utf8_len_go s 0 0;
// byte offset of the k-th codepoint (clamped to str_len).
let rec utf8_boff = fn (s: str) -> fn (k: int) -> fn (i: int) ->
  if k <= 0 || i >= str_len s then i else utf8_boff s (k - 1) (i + utf8_clen s i);
// the character starting at BYTE offset i ("" if out of range). utf8_char takes
// a codepoint index and has to walk from the start to find it; the regex engine
// already holds byte offsets, so it needs this one.
// How many characters precede BYTE offset b. Ruby reports every position -- =~,
// index, rindex, MatchData#begin/#end -- in characters, and this engine works in
// bytes: on "日本語abc" they came back as 6 / 9 / 10 where Ruby says 2 / 3 / 4.
// On an ASCII string the two are equal, which is why it never showed.
let utf8_cidx = fn (s: str) -> fn (b: int) ->
  utf8_len (substring s 0 (if b < 0 then 0 else if b > str_len s then str_len s else b));
let utf8_char_at = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then "" else substring s i (i + utf8_clen s i);
// the k-th codepoint as a string ("" if out of range).
let utf8_char = fn (s: str) -> fn (k: int) ->
  let off = utf8_boff s k 0 in
  if off >= str_len s then "" else substring s off (off + utf8_clen s off);
// codepoint substring [st, st+len) — st/len in codepoints.
let utf8_substr = fn (s: str) -> fn (st: int) -> fn (len: int) ->
  let a = utf8_boff s st 0 in let b = utf8_boff s (st + len) 0 in substring s a b;
// list of one-codepoint VStr values.
let rec utf8_chars_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else let l = utf8_clen s i in Cons (mkstr (substring s i (i + l)), utf8_chars_val s (i + l));
// the characters CARRY the receiver's encoding ("chars of a US-ASCII string
// are US-ASCII strings"); the untagged walker above predates senc.
let rec utf8_chars_enc = fn (s: str) -> fn (e: str) -> fn (i: int) ->
  if i >= str_len s then (Nil : Val list)
  else
    let l = utf8_clen s i in
    let v = mkstr (substring s i (i + l)) in
    let _ = (match v with VStr id -> senc_set id e | _ -> ()) in
    Cons (v, utf8_chars_enc s e (i + l));
// reverse by codepoints.
let rec utf8_rev_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc else let l = utf8_clen s i in utf8_rev_go s (i + l) (substring s i (i + l) ++ acc);
let utf8_reverse = fn (s: str) -> utf8_rev_go s 0 "";
let rec str_byte_sum = fn (s: str) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc else str_byte_sum s (i + 1) (acc + ord (char_at s i));
let rec utf8_codepoints = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then (Nil : Val list)
  else (match utf8_cp s i with (c, l) -> Cons (VInt c, utf8_codepoints s (i + l)));
// split into lines keeping the trailing newline on each (String#lines).

// ---- transcoding between UTF-8 / ISO-8859-1 / US-ASCII (formula-based) ----
// decode source bytes to a codepoint list (UTF-8 multibyte; else byte=cp).
// UTF-16, both ways. `encode` used to answer the SAME BYTES for every target it
// did not know: `"ab".encode("UTF-16BE").bytesize` was 2 where ruby says 4,
// because a non-UTF-8 target fell into the one-byte-per-codepoint branch. UTF-16
// is written out properly here, and a target that would need a mapping this does
// not have now refuses instead (see encode_cps).
let utf16_enc = fn (cp: int) -> fn (be: bool) ->
  if cp < 65536 then
    (let hi = cp / 256 in
     let lo = cp - hi * 256 in
     if be then chr hi ++ chr lo else chr lo ++ chr hi)
  else
    (let v = cp - 65536 in
     let w1 = 55296 + v / 1024 in
     let w2 = 56320 + (v - (v / 1024) * 1024) in
     let b = fn (w: int) -> (let h = w / 256 in let l = w - h * 256 in if be then chr h ++ chr l else chr l ++ chr h) in
     b w1 ++ b w2);
let utf16_cp = fn (s: str) -> fn (i: int) -> fn (be: bool) ->
  let byte = fn (k: int) -> if k < str_len s then ord (char_at s k) else 0 in
  let unit = fn (k: int) -> (if be then byte k * 256 + byte (k + 1) else byte (k + 1) * 256 + byte k) in
  let u = unit i in
  if u >= 55296 && u < 56320 && i + 3 < str_len s then
    (let u2 = unit (i + 2) in ((u - 55296) * 1024 + (u2 - 56320) + 65536, 4))
  else (u, 2);
// An encoding NAME is ASCII, so comparing it case-insensitively needs no more
// than this (str_upcase is defined further down the file).
let rec enc_up_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else (let c = ord (char_at s i) in
        enc_up_go s (i + 1) (acc ++ (if c >= 97 && c <= 122 then chr (c - 32) else char_at s i)));
let enc_up = fn (s: str) -> enc_up_go s 0 "";
let enc_is_utf16 = fn (nm: str) -> let t = enc_up nm in str_eq t "UTF-16BE" || str_eq t "UTF-16LE";
let enc_utf16_be = fn (nm: str) -> str_eq (enc_up nm) "UTF-16BE";
// ---- JIS X 0208 (EUC-JP / Shift_JIS / Windows-31J) <-> Unicode ------------
// Generated by tools/gen_jis0208.rb (ruby's own transcoder is the oracle);
// entries are "LLTT:CP" -- the EUC byte pair in hex, then the codepoint in
// hex -- comma-separated. Regenerate by replacing the literal between the
// ENC_JIS0208_TABLE markers. Halfwidth katakana (SS2) is arithmetic and JIS
// X 0212 (SS3) is out of scope, exactly as in the validators above.
// ENC_JIS0208_TABLE BEGIN
