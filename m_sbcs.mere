  "MACTURKISH\t196,197,199,201,209,214,220,225,224,226,228,227,229,231,233,232,234,235,237,236,238,239,241,243,242,244,246,245,250,249,251,252,8224,176,162,163,167,8226,182,223,174,169,8482,180,168,8800,198,216,8734,177,8804,8805,165,181,8706,8721,8719,960,8747,170,186,8486,230,248,191,161,172,8730,402,8776,8710,171,187,8230,160,192,195,213,338,339,8211,8212,8220,8221,8216,8217,247,9674,255,376,286,287,304,305,350,351,8225,183,8218,8222,8240,194,202,193,203,200,205,206,207,204,211,212,-1,210,218,219,217,-1,710,732,175,728,729,730,184,733,731,711\n" ++
  "MACUKRAINE\t1040,1041,1042,1043,1044,1045,1046,1047,1048,1049,1050,1051,1052,1053,1054,1055,1056,1057,1058,1059,1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071,8224,176,1168,163,167,8226,182,1030,174,169,8482,1026,1106,8800,1027,1107,8734,177,8804,8805,1110,181,1169,1032,1028,1108,1031,1111,1033,1113,1034,1114,1112,1029,172,8730,402,8776,8710,171,187,8230,160,1035,1115,1036,1116,1109,8211,8212,8220,8221,8216,8217,247,8222,1038,1118,1039,1119,8470,1025,1105,1103,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082,1083,1084,1085,1086,1087,1088,1089,1090,1091,1092,1093,1094,1095,1096,1097,1098,1099,1100,1101,1102,164\n";
// each alias ruby knows, `ALIAS<TAB>NAME`
let sbcs_aliases = "IBM850\tCP850\nCP437\tIBM437\nCP720\tIBM720\nCP737\tIBM737\nCP775\tIBM775\nCP857\tIBM857\nCP860\tIBM860\nCP861\tIBM861\nCP862\tIBM862\nCP863\tIBM863\nCP864\tIBM864\nCP865\tIBM865\nCP866\tIBM866\nCP869\tIBM869\nISO8859-1\tISO-8859-1\nISO8859-10\tISO-8859-10\nISO8859-11\tISO-8859-11\nISO8859-13\tISO-8859-13\nISO8859-14\tISO-8859-14\nISO8859-15\tISO-8859-15\nISO8859-16\tISO-8859-16\nISO8859-2\tISO-8859-2\nISO8859-3\tISO-8859-3\nISO8859-4\tISO-8859-4\nISO8859-5\tISO-8859-5\nISO8859-6\tISO-8859-6\nISO8859-7\tISO-8859-7\nISO8859-8\tISO-8859-8\nISO8859-9\tISO-8859-9\nCP878\tKOI8-R\nCP1250\tWINDOWS-1250\nCP1251\tWINDOWS-1251\nCP1252\tWINDOWS-1252\nCP1253\tWINDOWS-1253\nCP1254\tWINDOWS-1254\nCP1255\tWINDOWS-1255\nCP1256\tWINDOWS-1256\nCP1257\tWINDOWS-1257\nCP874\tWINDOWS-874\n";
// the table, read on first use: "NAME" -> 1 for an encoding it has,
// "NAME:b" -> codepoint for an upper-half byte, "NAME#cp" -> byte back
let sbcs_m = map_new ();
let rec sbcs_cps = fn (nm: str) -> fn (s: str) -> fn (i: int) -> fn (e: int) -> fn (b: int) ->
  if i >= e then ()
  else
    (let rec stop = fn (j: int) -> (if j >= e || str_eq (char_at s j) "," then j else stop (j + 1)) in
     let j = stop i in
     let cp = int_of_str (substring s i j) in
     let _ = map_set sbcs_m (nm ++ ":" ++ str_of_int b) cp in
     let _ = (if cp >= 0 && (if map_has sbcs_m (nm ++ "#" ++ str_of_int cp) then false else true)
              then map_set sbcs_m (nm ++ "#" ++ str_of_int cp) b else ()) in
     sbcs_cps nm s (j + 1) e (b + 1));
let rec sbcs_rows_go = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ()
  else
    (let rec find = fn (j: int) -> fn (c: str) -> (if j >= str_len s || str_eq (char_at s j) c then j else find (j + 1) c) in
     let t = find i "\t" in
     let e = find (t + 1) "\n" in
     let nm = substring s i t in
     let _ = map_set sbcs_m nm 1 in
     let _ = sbcs_cps nm s (t + 1) e 128 in
     sbcs_rows_go s (e + 1));
let sbcs_al = map_new ();
let rec sbcs_al_go = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ()
  else
    (let rec find = fn (j: int) -> fn (c: str) -> (if j >= str_len s || str_eq (char_at s j) c then j else find (j + 1) c) in
     let t = find i "\t" in
     let e = find (t + 1) "\n" in
     let _ = map_set sbcs_al (substring s i t) (substring s (t + 1) e) in
     sbcs_al_go s (e + 1));
let sbcs_ensure = fn (u: unit) ->
  if map_has sbcs_m "" then ()
  else (let _ = map_set sbcs_m "" 1 in let _ = sbcs_al_go sbcs_aliases 0 in sbcs_rows_go sbcs_rows 0);
// the table's name for an UPPER-CASE encoding name or alias
let sbcs_name = fn (nm: str) -> (let _ = sbcs_ensure () in if map_has sbcs_al nm then map_get sbcs_al nm else nm);
// does the table have this encoding (an UPPER-CASE name or alias)?
let sbcs_has = fn (nm: str) -> (let _ = sbcs_ensure () in if str_eq nm "" then false else map_has sbcs_m (sbcs_name nm));
// the codepoint of byte b, -1 when the encoding leaves it undefined
let sbcs_to_cp = fn (nm: str) -> fn (b: int) ->
  if b < 128 then b else map_get sbcs_m (sbcs_name nm ++ ":" ++ str_of_int b);
// the byte of codepoint cp, -1 when the encoding has none for it
let sbcs_from_cp = fn (nm: str) -> fn (cp: int) ->
  if cp < 128 then cp
  else (let k = sbcs_name nm ++ "#" ++ str_of_int cp in
        if map_has sbcs_m k then map_get sbcs_m k else 0 - 1);
