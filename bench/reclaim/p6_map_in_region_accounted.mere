// Does a Map created inside a region block die with the block? Peak RSS cannot
// answer this on its own: a region block in a recursive function's body stops
// clang from turning the self-call into a loop, so the STACK grows ~250 bytes an
// iteration and swamps the heap. This program is meant to be run with the region
// runtime instrumented (see reclaim.sh), which counts how many region blocks
// were acquired and how many bytes the region allocator ever asked malloc for.
// A million blocks that reclaim look like: acquire=1000000, init=2.
let rec go = fn (i: int) ->
  if i >= 1000000 then ()
  else
    let _ = region R {
      let m = map_new () in
      let _ = map_set m ("key " ++ str_of_int i) ("value number " ++ str_of_int i) in
      map_len m
    } in
    go (i + 1);
let _ = go 0 in
print "done\n"
