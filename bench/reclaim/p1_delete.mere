// Does map_delete give the memory back? Set a fresh string under a fresh key,
// then delete it, a million times: the map holds at most one entry at a time.
let m = map_new ();
let rec go = fn (i: int) ->
  if i >= 1000000 then ()
  else
    let _ = map_set m i ("value number " ++ str_of_int i) in
    let _ = map_delete m i in
    go (i + 1);
let _ = go 0 in
print ("entries left: " ++ str_of_int (map_len m) ++ "\n")
