// The same loop building the same strings with NO region block: they land in the
// default (program-lifetime) region and stay there. The difference against
// p6_map_in_region_accounted is the whole point of a region block.
let rec go = fn (i: int) ->
  if i >= 1000000 then ()
  else
    let _ = ("key " ++ str_of_int i) in
    go (i + 1);
let _ = go 0 in
print "done\n"
