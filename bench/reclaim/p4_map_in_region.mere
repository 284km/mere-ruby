// Is a Map created INSIDE a region block reclaimed when the block exits? This is
// the question a per-call region turns on: a call's frame is a map_new, and the
// memory model says containers keep their own binding region.
let rec go = fn (i: int) -> fn (acc: int) ->
  if i >= 1000000 then acc
  else
    let n = region R {
      let m = map_new () in
      let _ = map_set m ("key " ++ str_of_int i) ("value number " ++ str_of_int i) in
      map_len m
    } in
    go (i + 1) (acc + n);
print ("sum: " ++ str_of_int (go 0 0) ++ "\n")
