// The floor for the two probes above: a recursion that allocates nothing. It
// runs in 1.4 MiB, which is what says the tail call IS optimized when nothing
// interferes -- and therefore that the growth in the other probes is not
// "recursion costs memory".
let rec go = fn (i: int) ->
  if i >= 1000000 then () else go (i + 1);
let _ = go 0 in
print "done\n"
