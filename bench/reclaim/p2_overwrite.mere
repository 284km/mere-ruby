// Same key every time: map_set on an existing key copies only the value, so the
// old value's bytes are what this asks about.
let m = map_new ();
let rec go = fn (i: int) ->
  if i >= 1000000 then ()
  else
    let _ = map_set m 0 ("value number " ++ str_of_int i) in
    go (i + 1);
let _ = go 0 in
print ("entries left: " ++ str_of_int (map_len m) ++ "\n")
