// The same eight iterations as p9_grown_region_x8 with the region block removed:
// everything lands in the default region, which is never freed. This is the
// positive control -- the harness must be able to see BOTH answers, or a flat
// number from the x8 probe could mean "reuse works" or "the probe never
// allocated" and nothing would distinguish them.
let burn = fn seed ->
    let rec go = fn n -> fn acc ->
      if n == 0 then list_len acc
      else go (n - 1) ((str_of_int (n + seed) ++ " ---------------- forty bytes of padding ----------------") :: acc) in
    go 300000 [];
let rec times = fn k -> fn acc ->
  if k == 0 then acc
  else times (k - 1) (acc + burn (k * 1000000));
print ("sum: " ++ str_of_int (times 8 0) ++ "\n")
