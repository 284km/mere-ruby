// Does a region whose chain GREW past its first block give memory back in a way
// the NEXT region can reuse? p4/p6 answered reuse only for regions that fit in
// one block (the cached-struct path: top = base, no free at all). A
// world-compaction loop would grow its region every cycle, so the path that
// matters there is the other one: __lang_region_block_release sees blocks->prev,
// frees the whole chain, re-seeds 1 MB.
//
// Eight sibling iterations, each building ~300k strings (~tens of MB) inside its
// own region block. Two answers, one deterministic and one from the OS:
//   - block-malloc counters (region_reuse.sh patches them in): if live high-water
//     is ~one iteration while cumulative is ~eight, the allocator level reuses.
//   - peak RSS here vs the x1 file: flat means reuse reaches the process level.
// p9_grown_region_x1.mere must stay IDENTICAL except `times 1`.
let burn = fn seed ->
  region R {
    let rec go = fn n -> fn acc ->
      if n == 0 then list_len acc
      else go (n - 1) ((str_of_int (n + seed) ++ " ---------------- forty bytes of padding ----------------") :: acc) in
    go 300000 []
  };
let rec times = fn k -> fn acc ->
  if k == 0 then acc
  else times (k - 1) (acc + burn (k * 1000000));
print ("sum: " ++ str_of_int (times 8 0) ++ "\n")
