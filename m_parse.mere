    // string (Kernel#` is a stub; specs override it via define_method(:`)).
    // `Kernel.`(cmd)` and `def `(cmd)`: after a dot or `def` the backtick is
    // the METHOD NAME, not the opening of a command literal. The spec that
    // uses the first form also carries a backtick in a trailing comment to
    // rebalance an editor's highlighting -- which this lexer read as a second
    // command string running to the end of the file.
    else if str_eq c "`" && (prev_nonspace_is s i "." || prev_word_is s i "def") then
      Cons (TId "`", lex_go s (i + 1))
    else if str_eq c "`" then
      let (segs, j) = lex_dstr_t "`" s (i + 1) "" in
      // the command string reaches #` FROZEN when it has no interpolation,
      // as ruby passes it (a redefined #` sees `str.frozen?` true)
      let rec all_lit9 = fn (ts: Tok list) ->
        (match ts with
         | Nil -> true
         | Cons (TStrL _, t9) -> all_lit9 t9
         | Cons (TP "+", t9) -> all_lit9 t9   // the joiner between pieces
         | _ -> false) in
      let tail9 = (if all_lit9 segs then Cons (TP ".", Cons (TId "freeze", Cons (TP ")", lex_go s j)))
                   else Cons (TP ")", lex_go s j)) in
      Cons (TId "`", Cons (TP "(",
