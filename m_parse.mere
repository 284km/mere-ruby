      // %r{...}flags is a regex (with optional interpolation). The body is
      // re-scanned keeping backslashes (%r?\?? is the regex /\?/, so the
      // escape must survive into the pattern, unlike %q string unescaping).
      else if str_eq (char_at s (i + 1)) "r" then
        (let (rlit0, rj) = scan_pct_regex s b 1 "" opener (pct_close_of opener) in
         let rlit = rx_cm_rewrite rlit0 (str_contains (substring s rj (skip_regex_flags s rj)) "x") in
         let fj = skip_regex_flags s rj in
         let fl = rx_one_enc_flag (substring s rj fj) in
         let _ = rx_escapes_check rlit fl in
         let _ = rx_raw_check rlit fl in
         let _ = rx_static_frags rlit 0 in
         if rx_has_interp rlit 0 || rx_has_dvar rlit 0 then
           tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src rlit) 0)))
                (Cons (TP ")", Cons (TP ".", Cons (TId "__regex", Cons (TP "(", Cons (TStrL fl,
                  Cons (TP ",", Cons (TInt i, Cons (TP ")", lex_go s fj)))))))))
         else Cons (TRegex (rlit, fl), lex_go s fj))
      // %x{...} is a command literal (same as backticks): a call to the `
      // method with the interpolated body.
      // (the body is a double-quoted string's, escapes and all, as %Q's
      //  below: `%x{echo "\u0041"}` ran `echo "\u0041"`)
      else if str_eq (char_at s (i + 1)) "x" then
        // (...and with nothing interpolated it is a frozen literal, as the
        //  backtick form's is: a redefined ` receives a frozen String)
        (let (dlit, _) = scan_balanced_dq s b 1 "" opener (pct_close_of opener) in
         Cons (TId "`", Cons (TP "(", tapp (Cons (TP "(s", drop_eof (lex_go (sq_interp_src dlit) 0)))
                                          (Cons (TP ")",
                                                 (if rx_has_interp lit 0 then Cons (TP ")", lex_go s j)
                                                  else Cons (TP ".", Cons (TId "freeze", Cons (TP ")", lex_go s j)))))))))
      // %s{...} is a symbol; %i{...} a symbol array.
      else if str_eq (char_at s (i + 1)) "s" then Cons (TSym lit, lex_go s j)
      else if str_eq (char_at s (i + 1)) "i" || str_eq (char_at s (i + 1)) "I" then
        Cons (TP " [", pi_words (str_eq (char_at s (i + 1)) "I") lit 0 (lex_go s j))
      // %Q/%(...) are double-quoted strings wearing another delimiter: they
      // interpolate AND process backslash escapes, and %q is the raw one.
      // ⚠ the body is handed to the STRING LEXER rather than unescaped here,
      //   because an escape rule written in a second place answers a smaller
      //   set of escapes than the first: `%Q{a\nb}` used to keep the literal
      //   backslash, and the first repair reached for dq_unescape -- which is
      //   the two-escape rule quoted SYMBOLS use, so `%Q{\u3042}` came out as
      //   the four characters `u3042`. One rule, in the place that has it all.
      // ⚠ ...and so the body it is handed keeps `\\` as TWO characters.
      //   scan_balanced2 folds an escaped backslash to one, which is the raw
      //   (%q / %w) reading; the string lexer then saw a lone backslash and
      //   took the next character as an escape: `%{\\u}` came out "u" and
      //   `%{a\\}` an unterminated string. json's own test file has
      //   `%{["\\u"]}`, and it was the whole file's parse error.
      else if (if str_eq (char_at s (i + 1)) "q" then false else true) then
        (let (dlit, _) = scan_balanced_dq s b 1 "" opener (pct_close_of opener) in
         tapp (Cons (TP "(s", drop_eof (lex_go (sq_interp_src dlit) 0))) (Cons (TP ")", lex_go s j)))
      else Cons (TStrL lit, lex_go s j)
    else
      let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
      // (`...` at the end of a line outside brackets reads the next line as
      //  its bound, and ruby says so: "... at EOL, should be parenthesized?")
      // ` *x` / ` **h` as the first argument of a paren-less call (`q *[1, 2]`,
      // `p *a`, `foo.bar **h`): marked " *" / " **" as ` &x` is " &", for the
      // command parser; anywhere else the operator parser reads it as `*`
      if str_eq c "*" && cmd_star s i then
        (let two9 = i + 1 < str_len s && str_eq (char_at s (i + 1)) "*" in
         let _ = amb_prefix_warn s i (if two9 then "**" else "*") in
         if two9 then Cons (TP " **", lex_go s (i + 2))
         else Cons (TP " *", lex_go s (i + 1)))
      else
      let _ = (if str_eq three "..." && (let k9 = lvt_skip_sp s (i + 3) in k9 < str_len s && str_eq (char_at s k9) "\n")
                  && br_depth s i 0 0 <= 0
                  // (a `def`'s paren-less `...` parameter is no range: `def foo ...`)
                  && (if line_is_def s i then false else true)
               then warn_note (parse_time_file () ++ ":" ++ str_of_int (nls_before s i 0 1 + lshift_lex ()) ++ ": warning: ... at EOL, should be parenthesized?")
               else ()) in
      if str_eq three "..." || str_eq three "||=" || str_eq three "&&=" ||
         str_eq three "<<=" || str_eq three ">>=" || str_eq three "**=" ||
         str_eq three "<=>" || str_eq three "===" then Cons (TP three, lex_go s (i + 3))
      else
        let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
        // `def foo = expr` (space before the `=`) is an endless method;
        // `def foo= v` (no space) defines a setter. Ruby tells them apart by
        // exactly that spacing, so the lexer marks the endless one -- and only
        // there, where the token before is a name and the one before that is
        // `def`, so no ordinary assignment is affected.
        if str_eq two "==" || str_eq two "=>" || str_eq two "=~" then Cons (TP two, lex_go s (i + 2))
        else if str_eq c "=" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!")
                    && (let nm_start = word_start_at s pj in
                        let pj2 = prev_nonspace s (nm_start - 1) in
                        pj2 >= 0 &&
                        (str_eq (word_ending_at s pj2) "def"
                         // ...or a singleton method: `def self.name = expr`,
                         // where the token before the name is the dot.
                         || (str_eq (char_at s pj2) "."
                             && (let pj3 = prev_nonspace s (pj2 - 1) in
                                 pj3 >= 0 &&
                                 (let rs = word_start_at s pj3 in
                                  let pj4 = prev_nonspace s (rs - 1) in
                                  pj4 >= 0 && str_eq (word_ending_at s pj4) "def")))))) then
          Cons (TP " =", lex_go s (i + 1))
        else if str_eq two "::" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
           && i + 2 < str_len s && is_upper_first (char_at s (i + 2))
           // only after something that could BE a command: an identifier, and
           // not `class ::C` / `module ::M`, where the constant is the name
           // being defined rather than an argument.
           && (if lvt_prev_local s i then false else true)
           && (let pj = prev_nonspace s (i - 1) in
               pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!")
               && (let w = word_ending_at s pj in
                   // `rescue ::Foo => e` names a class in a clause, not an argument
                   if str_eq w "class" || str_eq w "module" || str_eq w "def" ||
                      str_eq w "rescue" then false else true)) then
          // ` ::Const` — whitespace before and a constant after: an argument
          // prefix, not scope resolution on what precedes. `a::B` (no space)
          // stays scope resolution, which is how Ruby splits them too.
          Cons (TP " ::", lex_go s (i + 2))
        else if is_punct2 two then
          (let _ = (if str_eq two "->" then lvt_lambda s (i + 2) else ()) in Cons (TP two, lex_go s (i + 2)))
        // ...but after a LOCAL, `x [1]` is x indexed, as ruby reads it (see
        // lvt_names); only a name that may be a method call keeps " [".
        else if str_eq c "[" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
                && (if lvt_prev_local s i then false else true) then
          // whitespace before [ distinguishes an argument array literal
          // (x.foo [0]) from indexing (x.foo[0]).
          Cons (TP " [", lex_go s (i + 1))
        else if str_eq c "(" && i > 0 && str_eq (char_at s (i - 1)) " "
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!"
                                // (an operator method called through a dot,
                                //  `1.+ (x)`, is a method name as much)
                                || (let rec ob = fn (k: int) -> (if k >= 0 && str_contains "+-*/%<>=~^&|" (char_at s k) then ob (k - 1) else k) in
                                    let k9 = ob pj in
                                    k9 < pj && k9 >= 0 && str_eq (char_at s k9) "." && (if k9 >= 1 && str_eq (char_at s (k9 - 1)) "." then false else true)))) then
          Cons (TP " (", lex_go s (i + 1))
        // ` &x` (space before, none after) directly after an expression-ending
        // token is a command-style block-pass argument (`recv.meth &blk`),
        // distinct from binary `a & b`/`a&b` and from a `, &blk` param/arg
        // (where the preceding token is a comma/paren, not an expression).
        // Emitted as " &" so the operator layer ignores it and the call parser
        // consumes it.
        else if str_eq c "&" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
                && i + 1 < str_len s
                && (let nc = char_at s (i + 1) in
                    if str_eq nc " " then false else if str_eq nc "\t" then false
                    // ... and a NEWLINE after it means the operand is on the
                    // next line, which a block-pass argument cannot be: this is
                    // the trailing-operator style, `a.all_requirements &` then
                    // the rest (molinillo writes an Array intersection that way).
                    else if str_eq nc "\n" then false
                    else if str_eq nc "&" then false else if str_eq nc "=" then false
                    else if str_eq nc "." then false else true)
                // `x &y` with x a LOCAL is the binary `&`, as it is for ruby,
                // and so is `1 &y` / `:a &y` after a literal
                && (if lvt_prev_local s i then false else true)
                && (if prev_is_lit s (prev_nonspace s (i - 1)) then false else true)
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in
                      is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!"
                      || str_eq pc ")" || str_eq pc "]" || str_eq pc "\"")) then
          (let _ = amb_prefix_warn s i "&" in Cons (TP " &", lex_go s (i + 1)))
        else if is_punct1 c then
          (let _ = (if str_eq c "\{" then lvt_brace_open s (i + 1) else if str_eq c "}" then lvt_brace_close () else ()) in
           Cons (TP c, lex_go s (i + 1)))
        // backslash-newline continues the statement on the next line.
        else if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\n" then
          (let j = hd_jump s (i + 1) in lex_go s (if j >= 0 then j else i + 2))
        // (ruby's words for what cannot start a token: a stray backslash, an
        //  escaped blank, a control character)
        else
          (let _ = syn_why_note (if str_eq c "\\" then
                                   (let nc = (if i + 1 < str_len s then char_at s (i + 1) else "") in
                                    if str_eq nc " " then "unexpected escaped space, ignoring it"
                                    else if str_eq nc "\t" then "unexpected escaped horizontal tab, ignoring it"
                                    else if str_eq nc (chr 12) then "unexpected escaped form feed, ignoring it"
                                    else if str_eq nc "\r" then "unexpected escaped carriage return, ignoring it"
                                    else if str_eq nc (chr 11) then "unexpected escaped vertical tab, ignoring it"
                                    else "unexpected backslash, ignoring it")
                                 else if ord c < 32 || ord c == 127 then "Invalid char '\\x" ++ char_at "0123456789ABCDEF" (ord c / 16) ++ char_at "0123456789ABCDEF" (ord c - (ord c / 16) * 16) ++ "' in expression"
                                 else "") in
           let __fm = ("mere-ruby: unexpected character: " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)

// ---- the local-variable table: scopes (see lvt_names above) -----------------
and lvt_vget = fn v -> fn (i: int) -> if i < vec_len v then vec_get v i else 0
and lvt_vset = fn v -> fn (i: int) -> fn (x: int) ->
  if i < vec_len v then vec_set v i x else (let _ = vec_push v x in lvt_vset v i x)
and lvt_reset = fn (u: unit) ->
  let _ = map_clear lvt_names in
  let _ = lvt_vset lvt_sv 0 0 in
  let _ = lvt_vset lvt_sv 1 1 in
  let _ = lvt_vset lvt_sv 2 0 in
  let _ = lvt_vset lvt_sv 3 0 in
  let _ = lvt_vset lvt_fid 0 0 in
  lvt_vset lvt_fop 0 1
and lvt_push_frame = fn (opaque: int) ->
  let d = lvt_vget lvt_sv 0 + 1 in
  let id = lvt_vget lvt_sv 1 in
  let _ = lvt_vset lvt_sv 1 (id + 1) in
  let _ = lvt_vset lvt_fid d id in
  let _ = lvt_vset lvt_fop d opaque in
  lvt_vset lvt_sv 0 d
and lvt_pop_frame = fn (u: unit) ->
  let d = lvt_vget lvt_sv 0 in if d > 0 then lvt_vset lvt_sv 0 (d - 1) else ()
// a keyword can never be a local, so it is never recorded as one: a `**nil`
// parameter or `-> do` would otherwise put `nil`/`do` in the table.
and lvt_add = fn (name: str) ->
  if str_len name == 0 || is_upper (char_at name 0) || (str_len name <= 8 && lvt_is_kw name) then ()
  else map_set lvt_names (str_of_int (lvt_vget lvt_fid (lvt_vget lvt_sv 0)) ++ ":" ++ name) 1
// by LENGTH first: this runs for every local recorded, and a string compare
// here is a memcmp whatever the lengths (it was the lexer's largest cost).
and lvt_is_kw = fn (w: str) ->
  let n = str_len w in
  if n < 2 || n > 8 then false
  else if n == 2 then str_eq w "if" || str_eq w "do" || str_eq w "or" || str_eq w "in"
  else if n == 3 then str_eq w "end" || str_eq w "def" || str_eq w "nil" || str_eq w "and" || str_eq w "not" || str_eq w "for"
  else if n == 4 then str_eq w "else" || str_eq w "case" || str_eq w "when" || str_eq w "then" || str_eq w "self" || str_eq w "next" || str_eq w "redo" || str_eq w "true"
  else if n == 5 then str_eq w "elsif" || str_eq w "while" || str_eq w "until" || str_eq w "class" || str_eq w "yield" || str_eq w "begin" || str_eq w "break" || str_eq w "retry" || str_eq w "false" || str_eq w "super" || str_eq w "alias" || str_eq w "undef"
  else if n == 6 then str_eq w "unless" || str_eq w "return" || str_eq w "module" || str_eq w "rescue" || str_eq w "ensure"
  else if n == 7 then str_eq w "defined"
  else str_eq w "__FILE__" || str_eq w "__LINE__"
and lvt_is = fn (name: str) ->
  let rec go = fn (d: int) ->
    if d < 0 then false
    else if map_has lvt_names (str_of_int (lvt_vget lvt_fid d) ++ ":" ++ name) then true
    else if lvt_vget lvt_fop d == 1 then false
    else go (d - 1) in
  go (lvt_vget lvt_sv 0)
// the opener stack. Kinds: 0 a keyword with no scope of its own (if, while,
// case, begin, for), 1 a keyword that opened a scope (def, class, module, a
// `do` block), 2 a brace (a block or a hash: both get a transparent scope,
// which for a hash is simply never filled), 3 an endless `def`, closed by the
// newline, 4 a lambda whose parameters are read and whose body has not begun.
and lvt_kpush = fn (kind: int) -> fn (loopat: int) ->
  let _ = (if kind == 3 then lvt_vset lvt_sv 3 (lvt_vget lvt_sv 3 + 1) else ()) in
  let n = lvt_vget lvt_sv 2 + 1 in
  let _ = lvt_vset lvt_sv 2 n in
  let _ = lvt_vset lvt_kk n kind in
  lvt_vset lvt_kl n loopat
and lvt_ktop = fn (u: unit) ->
  let n = lvt_vget lvt_sv 2 in if n > 0 then lvt_vget lvt_kk n else 0 - 1
and lvt_kpop = fn (u: unit) ->
  let n = lvt_vget lvt_sv 2 in
  if n <= 0 then ()
  else
    let k = lvt_vget lvt_kk n in
    let _ = lvt_vset lvt_sv 2 (n - 1) in
    let _ = (if k == 3 then lvt_vset lvt_sv 3 (lvt_vget lvt_sv 3 - 1) else ()) in
    if k == 0 then () else lvt_pop_frame ()
// `end`: an endless def or a bodiless lambda still on the stack is stale (its
// newline or body never came), then the keyword on top is the one it closes.
// An `end` meeting a brace is a mismatch this table cannot resolve; it leaves
// the stack alone rather than pop a scope that is still open.
and lvt_end = fn (u: unit) ->
  let t = lvt_ktop () in
  if t == 3 || t == 4 then (let _ = lvt_kpop () in lvt_end ())
  else if t == 0 || t == 1 then lvt_kpop ()
  else ()
// `}` closes the nearest brace, and anything a misread left above it.
and lvt_brace_close = fn (u: unit) ->
  let rec has = fn (n: int) -> if n <= 0 then false else if lvt_vget lvt_kk n == 2 then true else has (n - 1) in
  let rec pop = fn (u2: unit) -> (let t = lvt_ktop () in let _ = lvt_kpop () in if t == 2 then () else pop ()) in
  if has (lvt_vget lvt_sv 2) then pop () else ()
// "ne" counts the endless defs on the stack, so that the common newline --
// with none open -- costs one lookup.
and lvt_newline = fn (u: unit) ->
  if lvt_vget lvt_sv 3 > 0 && lvt_ktop () == 3 then lvt_kpop () else ()
// (the scanners below test characters by code, not by string compare: see
// lvt_is_kw)
and lvt_skip_sp = fn (s: str) -> fn (k: int) ->
  if k < str_len s && (let o = ord (char_at s k) in o == 32 || o == 9) then lvt_skip_sp s (k + 1) else k
and lvt_skip_ws = fn (s: str) -> fn (k: int) ->
  if k < str_len s && (let o = ord (char_at s k) in o == 32 || o == 9 || o == 10 || o == 13) then lvt_skip_ws s (k + 1) else k
and lvt_prev = fn (s: str) -> fn (k: int) ->
  if k < 0 then 0 - 1
  else if (let o = ord (char_at s k) in o == 32 || o == 9) then lvt_prev s (k - 1)
  else k
and lvt_no_nl = fn (s: str) -> fn (a: int) -> fn (b: int) ->
  if a >= b then true else if str_eq (char_at s a) "\n" then false else lvt_no_nl s (a + 1) b
// index past a quoted string starting at k (the quote itself), for the
// parameter scans below: they only need to step OVER a default value.
and lvt_skip_quote = fn (s: str) -> fn (k: int) ->
  let q = char_at s k in
  let rec go = fn (j: int) ->
    if j >= str_len s then j
    else if str_eq (char_at s j) "\\" then go (j + 2)
    else if str_eq (char_at s j) q then j + 1
    else go (j + 1) in
  go (k + 1)
// the index of the bracket closing the one just before k (depth 1 at k).
and lvt_close = fn (s: str) -> fn (k: int) ->
  let rec go = fn (j: int) -> fn (d: int) ->
    if j >= str_len s then j
    else
      let o = ord (char_at s j) in
      if o == 34 || o == 39 then go (lvt_skip_quote s j) d
      else if o == 40 || o == 91 || o == 123 then go (j + 1) (d + 1)
      else if o == 41 || o == 93 || o == 125 then (if d == 1 then j else go (j + 1) (d - 1))
      else go (j + 1) d in
  go k 1
// the next top-level `,` or `;` in [k, b), or b.
and lvt_piece_end = fn (s: str) -> fn (k: int) -> fn (b: int) ->
  if k >= b then b
  else
    let o = ord (char_at s k) in
    if o == 44 || o == 59 then k
    else if o == 34 || o == 39 then lvt_piece_end s (lvt_skip_quote s k) b
    else if o == 40 || o == 91 || o == 123 then lvt_piece_end s (lvt_close s (k + 1) + 1) b
    else lvt_piece_end s (k + 1) b
// every name a parameter list (or a multiple-assignment target list) in
// s[a, b) binds: `a`, `b = 1`, `*r`, `**kw`, `&blk`, `k:`, `k: 1`, `(x, y)`,
// block-locals after `;`. A name followed by `.`/`[`/`(` is an attribute or
// index target (`a.b, c = ...`), not a local.
and lvt_param_names = fn (s: str) -> fn (a: int) -> fn (b: int) ->
  let k = lvt_skip_ws s a in
  if k >= b then ()
  else
    let c = char_at s k in
    if str_eq c "*" || str_eq c "&" then lvt_param_names s (k + 1) b
    else if str_eq c "(" then
      (let e = lvt_close s (k + 1) in
       let _ = lvt_param_names s (k + 1) e in
       let pe = lvt_piece_end s (e + 1) b in
       if pe >= b then () else lvt_param_names s (pe + 1) b)
    else
      let _ = (if is_alpha c then
                 (let e = scan_ident s k in
                  let nx = (if e < str_len s then char_at s e else "") in
                  if str_eq nx "." || str_eq nx "[" || str_eq nx "(" || str_eq nx "?" || str_eq nx "!" then ()
                  else lvt_add (substring s k e))
               else ()) in
      let pe = lvt_piece_end s k b in
      if pe >= b then () else lvt_param_names s (pe + 1) b
// `|a, b|` right after a `{`/`do` at k: the block's parameters.
and lvt_block_params = fn (s: str) -> fn (k0: int) ->
  let k = lvt_skip_sp s k0 in
  if k + 1 < str_len s && str_eq (char_at s k) "|" && (if str_eq (char_at s (k + 1)) "|" then false else true) then
    (let rec bar = fn (j: int) ->
       if j >= str_len s then j
       else
         let c = char_at s j in
         if str_eq c "|" || str_eq c "\n" then j
         else if str_eq c "\"" || str_eq c "'" then bar (lvt_skip_quote s j)
         else if str_eq c "(" || str_eq c "[" || str_eq c "\{" then bar (lvt_close s (j + 1) + 1)
         else bar (j + 1) in
     lvt_param_names s (k + 1) (bar (k + 1)))
  else ()
// is the keyword whose previous non-blank character is at p at the START of
// an expression (a statement `if`, which takes an `end`), rather than after an
// operand (the modifier `x if c`, which does not)?
and lvt_stmt_start = fn (s: str) -> fn (p: int) ->
  if p < 0 then true
  else
    let c = char_at s p in
    if is_alnum c then
      (let w = word_ending_at s p in
       str_eq w "then" || str_eq w "else" || str_eq w "do" || str_eq w "begin" ||
       str_eq w "ensure" || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
       str_eq w "when" || str_eq w "in")
    else if str_eq c ")" || str_eq c "]" || str_eq c "}" || str_eq c "\"" || str_eq c "'" ||
            str_eq c "`" || str_eq c "?" || str_eq c "!" || str_eq c "/" then false
    else true
// `def` at j (just past the keyword): push its opaque scope and read its
// parameters, with or without parentheses; an endless def (`def f(a) = a`)
// has no `end`, and its scope closes at the newline.
and lvt_def = fn (s: str) -> fn (j: int) ->
  let n = str_len s in
  let k = lvt_skip_sp s j in
  let rec name_end = fn (e: int) ->
    if e >= n then e
    else (let o = ord (char_at s e) in
          if o == 40 || o == 32 || o == 9 || o == 10 || o == 59 || o == 13 then e
          else name_end (e + 1)) in
  let e = name_end (k + 1) in
  let single_eq = fn (q: int) ->
    q < n && str_eq (char_at s q) "=" &&
    (q + 1 >= n || (let c2 = char_at s (q + 1) in if str_eq c2 "=" || str_eq c2 "~" || str_eq c2 ">" then false else true)) in
  if e < n && str_eq (char_at s e) "(" then
    (let c = lvt_close s (e + 1) in
     let endless = single_eq (lvt_skip_sp s (c + 1)) in
     let _ = lvt_kpush (if endless then 3 else 1) (0 - 1) in
     let _ = lvt_push_frame 1 in
     lvt_param_names s (e + 1) c)
  else
    (let a = lvt_skip_sp s e in
     let endless = single_eq a in
     let _ = lvt_kpush (if endless then 3 else 1) (0 - 1) in
     let _ = lvt_push_frame 1 in
     if endless || a >= n then ()
     else
       (let c = char_at s a in
        if str_eq c "\n" || str_eq c ";" || str_eq c "#" || str_eq c "\r" then ()
        else
          (let rec eol = fn (q: int) ->
             if q >= n then q
             else (let cq = char_at s q in
                   if str_eq cq "\n" || str_eq cq ";" || str_eq cq "#" then q
                   else if str_eq cq "\"" || str_eq cq "'" then eol (lvt_skip_quote s q)
                   else if str_eq cq "(" || str_eq cq "[" || str_eq cq "\{" then eol (lvt_close s (q + 1) + 1)
                   else eol (q + 1)) in
           lvt_param_names s a (eol a))))
// `for a, b in xs`: the loop variables are locals of the ENCLOSING scope.
and lvt_for_vars = fn (s: str) -> fn (j: int) ->
  let n = str_len s in
  let rec find_in = fn (q: int) ->
    if q + 2 > n then n
    else (let c = char_at s q in
          if str_eq c "\n" || str_eq c ";" then q
          else if str_eq (substring s q (q + 2)) "in" && (q == 0 || (if is_alnum (char_at s (q - 1)) then false else true))
                  && (q + 2 >= n || (if is_alnum (char_at s (q + 2)) then false else true)) then q
          else find_in (q + 1)) in
  lvt_param_names s j (find_in j)
// `rescue Foo, Bar => e`: e is a local of the enclosing scope.
and lvt_rescue_var = fn (s: str) -> fn (j: int) ->
  let n = str_len s in
  let rec find_arrow = fn (q: int) ->
    if q + 1 >= n then ()
    else (let c = char_at s q in
          if str_eq c "\n" || str_eq c ";" then ()
          else if str_eq c "=" && str_eq (char_at s (q + 1)) ">" then
            (let k = lvt_skip_sp s (q + 2) in
             if k < n && is_alpha (char_at s k) then
               (let e = scan_ident s k in
                let nx = (if e < n then char_at s e else "") in
                if str_eq nx "." || str_eq nx "[" then () else lvt_add (substring s k e))
             else ())
          else find_arrow (q + 1)) in
  find_arrow j
// the end of ONE assignment target at k (`a`, `@a`, `a.b`, `a[i]`, `A::B`,
// `(a, b)`), or -1 when what is there is not one.
and lvt_target_end = fn (s: str) -> fn (k: int) ->
  let n = str_len s in
  if k >= n then 0 - 1
  else
    let c = char_at s k in
    if str_eq c "(" then lvt_close s (k + 1) + 1
    else if is_alpha c || str_eq c "@" || str_eq c "$" then
      (let k1 = (if str_eq c "@" && k + 1 < n && str_eq (char_at s (k + 1)) "@" then k + 2
                 else if str_eq c "@" || str_eq c "$" then k + 1 else k) in
       let rec more = fn (e: int) ->
         if e + 1 < n && str_eq (char_at s e) "." && is_alpha (char_at s (e + 1)) then more (scan_ident s (e + 1))
         else if e + 2 < n && str_eq (char_at s e) ":" && str_eq (char_at s (e + 1)) ":" then more (scan_ident s (e + 2))
         else if e < n && str_eq (char_at s e) "[" then more (lvt_close s (e + 1) + 1)
         else e in
       more (scan_ident s k1))
    else 0 - 1
// `a, b = ...` / `a, *b = ...` / `a, (b, c) = ...` / `a, = ...`: the index
// of the `=` that closes a target list starting at k, or -1.
and lvt_mlhs_end = fn (s: str) -> fn (k: int) ->
  let n = str_len s in
  let k1 = lvt_skip_sp s k in
  let k2 = (if k1 < n && str_eq (char_at s k1) "*" then k1 + 1 else k1) in
  let t = lvt_target_end s k2 in
  if t < 0 then 0 - 1
  else
    let k3 = lvt_skip_sp s t in
    if k3 >= n then 0 - 1
    else if str_eq (char_at s k3) "," then
      (let k4 = lvt_skip_sp s (k3 + 1) in
       if lvt_single_eq s k4 then k4 else lvt_mlhs_end s k4)
    else if lvt_single_eq s k3 then k3
    else 0 - 1
and lvt_single_eq = fn (s: str) -> fn (q: int) ->
  q < str_len s && ord (char_at s q) == 61 &&
  (q + 1 >= str_len s || (let o2 = ord (char_at s (q + 1)) in if o2 == 61 || o2 == 126 || o2 == 62 then false else true))
and lvt_opassign_at = fn (s: str) -> fn (k: int) ->
  let n = str_len s in
  // ⚠ every identifier the lexer meets asks this, so the first character is
  //   tested before any substring is built (see lvt_ident on the cost).
  let o0 = (if k < n then ord (char_at s k) else 0) in
  // + - * / % | & ^ < >
  if (if o0 == 43 || o0 == 45 || o0 == 42 || o0 == 47 || o0 == 37 ||
         o0 == 124 || o0 == 38 || o0 == 94 || o0 == 60 || o0 == 62 then false else true) then false
  else
  let two = (if k + 2 <= n then substring s k (k + 2) else "") in
  let three = (if k + 3 <= n then substring s k (k + 3) else "") in
  str_eq three "||=" || str_eq three "&&=" || str_eq three "**=" || str_eq three "<<=" || str_eq three ">>=" ||
  str_eq two "+=" || str_eq two "-=" || str_eq two "*=" || str_eq two "/=" || str_eq two "%=" ||
  str_eq two "|=" || str_eq two "&=" || str_eq two "^="
// every identifier the lexer emits passes here: a keyword moves the scope
// stack, and a name about to be assigned becomes a local.
and lvt_ident = fn (s: str) -> fn (i: int) -> fn (j: int) -> fn (w: str) ->
  let n = str_len s in
  let p = lvt_prev s (i - 1) in
  let po = (if p >= 0 then ord (char_at s p) else 0) in
  // ⚠ this runs for EVERY identifier, so it tests characters by code and
  //   reaches the keyword compares only for a name whose first letter one of
  //   them has (see lvt_is_kw on what a string compare costs here).
  let o0 = ord (char_at w 0) in
  // a name after `.`/`&.`/`::` is a method, whatever it spells; after `def`
  // it is the method being defined (`def end`, `def x=(v)`); `:x`, `@x` and
  // `$x` are lexed elsewhere.
  if po == 46 || (po == 58 && p > 0 && ord (char_at s (p - 1)) == 58) then ()
  else if po == 102 && p >= 2 && ord (char_at s (p - 1)) == 101 && ord (char_at s (p - 2)) == 100
          && (p == 2 || (if is_alnum (char_at s (p - 3)) then false else true)) then ()
  // a label (`end:`, `if: 1`) is a key, not a keyword
  else if j < n && ord (char_at s j) == 58 && (j + 1 >= n || ord (char_at s (j + 1)) != 58) then ()
  // e d c m b f w u i r: the first letters of the keywords handled below
  else if str_len w > 6 ||
          (if o0 == 101 || o0 == 100 || o0 == 99 || o0 == 109 || o0 == 98 || o0 == 102 ||
              o0 == 119 || o0 == 117 || o0 == 105 || o0 == 114 then false else true) then lvt_assign_or_mlhs s i j w p
  else if str_eq w "end" then lvt_end ()
  else if str_eq w "do" then
    (let kn = lvt_vget lvt_sv 2 in
     let lp = (if kn > 0 then lvt_vget lvt_kl kn else 0 - 1) in
     let kt = lvt_ktop () in
     // `while c do` / `for x in xs do`: the loop's own optional `do`
     if kt == 0 && kn > 0 && lp >= 0 && lp < i && lvt_no_nl s lp i then
       lvt_vset lvt_kl kn (0 - 1)
     else if kt == 4 then
       (let _ = lvt_vset lvt_kk kn 1 in lvt_block_params s j)
     else
       (let _ = lvt_kpush 1 (0 - 1) in
        let _ = lvt_push_frame 0 in
        lvt_block_params s j))
  else if str_eq w "def" then lvt_def s j
  else if str_eq w "class" || str_eq w "module" then
    (let _ = lvt_kpush 1 (0 - 1) in lvt_push_frame 1)
  else if str_eq w "begin" || str_eq w "case" then lvt_kpush 0 (0 - 1)
  else if str_eq w "for" then (let _ = lvt_for_vars s j in lvt_kpush 0 i)
  else if str_eq w "while" || str_eq w "until" then
    (if lvt_stmt_start s p then lvt_kpush 0 i else ())
  else if str_eq w "if" || str_eq w "unless" then
    (if lvt_stmt_start s p then lvt_kpush 0 (0 - 1) else ())
  else if str_eq w "rescue" then lvt_rescue_var s j
  else lvt_assign_or_mlhs s i j w p
// the name at [i, j) is about to be assigned (`x =`, `x op=`, `a, b =`)?
and lvt_assign_or_mlhs = fn (s: str) -> fn (i: int) -> fn (j: int) -> fn (w: str) -> fn (p: int) ->
  let n = str_len s in
  if is_upper (char_at w 0) then ()
  else
    let k = lvt_skip_sp s j in
    if k >= n then ()
    else if lvt_single_eq s k || lvt_opassign_at s k then lvt_add w
    else if ord (char_at s k) == 44 && lvt_stmt_start s p then
      (let e = lvt_mlhs_end s i in if e >= 0 then lvt_param_names s i e else ())
    else ()
// `{` at i: a block (or a hash) scope; a lambda's `{` is its pending body.
and lvt_brace_open = fn (s: str) -> fn (j: int) ->
  if lvt_ktop () == 4 then lvt_vset lvt_kk (lvt_vget lvt_sv 2) 2
  else
    (let _ = lvt_kpush 2 (0 - 1) in
     let _ = lvt_push_frame 0 in
     lvt_block_params s j)
// `->` at j (just past it): the lambda's scope opens here, before its
// parameters, so that `->(x) { x /2 }` knows x.
and lvt_lambda = fn (s: str) -> fn (j: int) ->
  let n = str_len s in
  let k = lvt_skip_sp s j in
  let _ = lvt_kpush 4 (0 - 1) in
  let _ = lvt_push_frame 0 in
  if k < n && str_eq (char_at s k) "(" then lvt_param_names s (k + 1) (lvt_close s (k + 1))
  else
    (let rec body = fn (q: int) ->
       if q >= n then q
       else (let c = char_at s q in
             if str_eq c "\{" || str_eq c "\n" || str_eq c ";" then q
             else if q + 2 <= n && str_eq (substring s q (q + 2)) "do" && (q == 0 || str_eq (char_at s (q - 1)) " ") then q
             else body (q + 1)) in
     lvt_param_names s k (body k))
// is the token at i the first ARGUMENT of a paren-less call, by ruby's rule:
// a space before it, none after (the caller checks that), and a name before
// the space that is a method -- one after `.`/`::`, or a bare name that is
// not a local. `Logging::message <<"EOM"` (mkmf's log_src) is a call with a
// heredoc, where `buf <<"x"` with buf a local is a shift.
and lvt_cmd_arg = fn (s: str) -> fn (i: int) ->
  if i <= 0 || (if str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t" then false else true) then false
  else
    let p0 = lvt_prev s (i - 1) in
    if p0 < 0 then false
    else
      let c0 = char_at s p0 in
      let p = (if (str_eq c0 "?" || str_eq c0 "!") && p0 > 0 then p0 - 1 else p0) in
      if (if is_alnum (char_at s p) then false else true) then false
      else
        let b = word_start s p in
        let w = substring s b (p + 1) in
        if is_digit (char_at s b) || lvt_is_kw w || str_eq w "puts" || str_eq w "p" then false
        else if b > 0 && str_eq (char_at s (b - 1)) "." then true
        else if b > 1 && str_eq (char_at s (b - 1)) ":" && str_eq (char_at s (b - 2)) ":" then true
        else if b > 0 && (let c = char_at s (b - 1) in str_eq c "@" || str_eq c "$" || str_eq c ":") then false
        else (if lvt_is w then false else true)

// is the identifier ending just before i (blanks between) a known local?
// Not when it is itself a method name (`x.p /re/`), a symbol, an ivar or a
// global: those end in the same characters.
and lvt_prev_local = fn (s: str) -> fn (i: int) ->
  let p = lvt_prev s (i - 1) in
  if p < 0 then false
  else if is_alnum (char_at s p) then
    (let b = word_start s p in
     if is_digit (char_at s b) then false
     else if b > 0 && (let c = char_at s (b - 1) in str_eq c "." || str_eq c ":" || str_eq c "@" || str_eq c "$") then false
     else lvt_is (substring s b (p + 1)))
  else false

// Does the raw double-quoted body s[i, e) spell a non-ASCII character with a
// \u escape, in a file whose source encoding is not UTF-8? (A UTF-8 file's
// literals are UTF-8 anyway, so there it never matters.)
// a byte past 0x7f written as itself in s[i, e) (not in an escape or #{})
and lex_raw_nonascii = fn (s: str) -> fn (i: int) -> fn (e: int) ->
  if i >= e then false
  else if str_eq (char_at s i) "\\" then lex_raw_nonascii s (i + 2) e
  else if str_eq (char_at s i) "#" && i + 1 < e && str_eq (char_at s (i + 1)) "\{" then lex_raw_nonascii s (interp_close s (i + 2) 1) e
  else if ord (char_at s i) >= 128 then true
  else lex_raw_nonascii s (i + 1) e
and lex_u8_escaped = fn (s: str) -> fn (i: int) -> fn (e: int) ->
  let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
  if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" then false
  else lex_u8_go s i e
and lex_u8_go = fn (s: str) -> fn (i: int) -> fn (e: int) ->
  if i + 1 >= e then false
  else if (if str_eq (char_at s i) "\\" then false else true) then lex_u8_go s (i + 1) e
  else if (if str_eq (char_at s (i + 1)) "u" then false else true) then lex_u8_go s (i + 2) e
  else if i + 2 < e && str_eq (char_at s (i + 2)) "\{" then
    // \u{...}: any codepoint of the list at or past U+0080
    (let rec lst = fn (k: int) -> fn (v: int) -> fn (any: bool) ->
       (if k >= e || str_eq (char_at s k) "}" then (any || v >= 128, k)
        else if str_eq (char_at s k) " " then lst (k + 1) 0 (any || v >= 128)
        else if is_hex_digit (char_at s k) then lst (k + 1) (v * 16 + hex_val (char_at s k)) any
        else (any || v >= 128, k)) in
     match lst (i + 3) 0 false with
     | (true, _) -> true
     | (false, k) -> lex_u8_go s (k + 1) e)
  else if i + 5 < e + 1 && hex4 s (i + 2) >= 128 then true
  else lex_u8_go s (i + 2) e

// A literal names at most ONE encoding: of n / e / s / u written together the
// last one wins (`/foo/ensuensuens` is /foo/s), and the rest are dropped.
and rx_one_enc_flag = fn (fl: str) ->
  let rec last = fn (i: int) -> fn (k: str) ->
    (if i >= str_len fl then k
     else (let c = char_at fl i in last (i + 1) (if str_contains "nesu" c then c else k))) in
  let enc = last 0 "" in
  let rec keep = fn (i: int) -> fn (acc: str) ->
    (if i >= str_len fl then acc
     else (let c = char_at fl i in
           keep (i + 1) (if str_contains "nesu" c || str_contains acc c then acc else acc ++ c))) in
  keep 0 "" ++ enc

// scan a double-quoted string body from i, returning the token segments
// (each prefixed with `+`) and the index after the closing quote. A
// literal run becomes `+ "run"`; a #{expr} becomes `+ ( <expr> ) . to_s`.
and lex_dstr = fn (s: str) -> fn (i: int) -> fn (lit: str) -> lex_dstr_t "\"" s i lit

// like lex_dstr but with a caller-chosen terminator char (`"` for strings,
// backtick for command literals) — same interpolation/escape handling.
and lex_dstr_t = fn (term: str) -> fn (s: str) -> fn (i: int) -> fn (lit: str) ->
  if i >= str_len s then (let _ = syn_why_note "unterminated string meets end of file" in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ())))
  else
    let c = char_at s i in
    if str_eq c term then (Cons (TP "+", Cons (TStrL lit, Nil)), i + 1)
    else if str_eq c "\\" && i + 1 < str_len s then
      let e = char_at s (i + 1) in
      if str_eq e "u" && i + 2 < str_len s && str_eq (char_at s (i + 2)) "\{" then
        // \u{XXXX ...} — braced codepoint(s), space-separated.
        let (bytes, j) = scan_u_braced s (i + 3) "" (0 - 1) in
        lex_dstr_t term s j (lit ++ bytes)
      // \uXXXX — exactly four hex digits ("\uab" and "\ughij" are
      // SyntaxErrors, not "uab" and NUL), then UTF-8 bytes for the codepoint
      else if str_eq e "u" then
        (if i + 5 < str_len s && is_hex_digit (char_at s (i + 2)) && is_hex_digit (char_at s (i + 3))
            && is_hex_digit (char_at s (i + 4)) && is_hex_digit (char_at s (i + 5))
         then lex_dstr_t term s (i + 6) (lit ++ u_cp_checked (hex4 s (i + 2)))
         else (let _ = syn_refuse "invalid Unicode escape" in lex_dstr_t term s (i + 2) lit))
      // ⚠ \cX / \C-X (control) and \M-X (meta), and the two nested: a
      //   double-quoted string read none of them, so "\cA" was "cA" and
      //   "\M-\C-a" was "M-C-a" (`?\cA` alone had them: see lex_go)
      else if str_eq e "c" || ((str_eq e "C" || str_eq e "M") && i + 2 < str_len s && str_eq (char_at s (i + 2)) "-") then
        (let (v9, j9) = dq_cm s i in lex_dstr_t term s j9 (lit ++ chr v9))
      // \xHH — one byte from up to two hex digits.
      else if str_eq e "x" && i + 2 < str_len s && is_hex_digit (char_at s (i + 2)) then
        let d1 = hex_val (char_at s (i + 2)) in
        if i + 3 < str_len s && is_hex_digit (char_at s (i + 3)) then
          lex_dstr_t term s (i + 4) (lit ++ chr (d1 * 16 + hex_val (char_at s (i + 3))))
        else lex_dstr_t term s (i + 3) (lit ++ chr d1)
      // ...and `\x` with no hex digit after it is refused
      else if str_eq e "x" then
        (let _ = syn_refuse "invalid hex escape sequence" in lex_dstr_t term s (i + 2) lit)
      // \NNN — one byte from up to three octal digits.
      else if e >= "0" && e <= "7" then
        let (val, j) = scan_octal s (i + 1) 0 0 in
        lex_dstr_t term s j (lit ++ chr val)
      else
      let piece = if str_eq e "n" then "\n" else if str_eq e "t" then "\t"
                  else if str_eq e "r" then chr 13 else if str_eq e "e" then chr 27
                  else if str_eq e "a" then chr 7 else if str_eq e "b" then chr 8
                  else if str_eq e "f" then chr 12 else if str_eq e "v" then chr 11
                  else if str_eq e "0" then chr 0 else if str_eq e "s" then " "
                  else e in
      lex_dstr_t term s (i + 2) (lit ++ piece)
    // `"#@ivar"` / `"#@@cvar"` / `"#$gvar"`: interpolation without the braces.
    // Only when a variable name follows -- `"#@"` and `"# $"` stay literal.
    // `"#$1"` / `"#$&"`: a numbered or punctuation global interpolates too
    // (tool/lib's runner prints each test's time as `" = #$1"`)
    else if str_eq c "#" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "$"
            && (is_digit (char_at s (i + 2))
                || (is_gvar_punct (char_at s (i + 2)) && (if str_eq (char_at s (i + 2)) term || str_eq (char_at s (i + 2)) "_" then false else true))) then
      let close = (if is_digit (char_at s (i + 2)) then dq_digits_end s (i + 2) else i + 3) in
      let exprtoks = drop_eof (lex_go (substring s (i + 1) close) 0) in
      let interp =
        Cons (TP "+", Cons (TP "(",
          tapp exprtoks (Cons (TP ")", Cons (TP ".", Cons (TId "__interp_str", Nil)))))) in
      let (rest, j) = lex_dstr_t term s close "" in
      (Cons (TP "+", Cons (TStrL lit, tapp interp rest)), j)
    else if str_eq c "#" && i + 2 < str_len s
            && (str_eq (char_at s (i + 1)) "@" || str_eq (char_at s (i + 1)) "$")
            && (let k = (if str_eq (char_at s (i + 1)) "@" && str_eq (char_at s (i + 2)) "@" then i + 3 else i + 2) in
                k < str_len s && (is_alpha (char_at s k) || str_eq (char_at s k) "_")) then
      let k = (if str_eq (char_at s (i + 1)) "@" && str_eq (char_at s (i + 2)) "@" then i + 3 else i + 2) in
      let close = scan_ident s k in
      let exprtoks = drop_eof (lex_go (substring s (i + 1) close) 0) in
      let interp =
        Cons (TP "+", Cons (TP "(",
          tapp exprtoks (Cons (TP ")", Cons (TP ".", Cons (TId "__interp_str", Nil)))))) in
      let (rest, j) = lex_dstr_t term s close "" in
      (Cons (TP "+", Cons (TStrL lit, tapp interp rest)), j)
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      let close = find_close_brace s (i + 2) 0 in
      let exprtoks = hd_in_interp s (i + 2) close in
      // `.__interp_str`, not `.to_s`: Ruby's interpolation uses a value that is
      // already a String AS IT IS, and only calls to_s on everything else. With
      // `.to_s` here, a program that redefines String#to_s changed what every
      // interpolation of every string produced -- `"#{s}"` and `s.to_s` are two
      // different questions and this asked the second one for both.
      let interp =
        Cons (TP "+", Cons (TP "(",
          tapp exprtoks (Cons (TP ")", Cons (TP ".", Cons (TId "__interp_str", Nil)))))) in
      let (rest, j) = lex_dstr_t term s (close + 1) "" in
      (Cons (TP "+", Cons (TStrL lit, tapp interp rest)), j)
    // a literal that runs across the line of a heredoc it holds goes on after
    // the body: `"#{<<~A}\n  body\nA\nrest"` is "body\n\nrest"
    else if str_eq c "\n" && lvt_vget hd_cnt 0 > 0 then
      (let j = hd_jump s i in lex_dstr_t term s (if j >= 0 then j else i + 1) (lit ++ c))
    else lex_dstr_t term s (i + 1) (lit ++ c)

and dq_digits_end = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_digit (char_at s i) then dq_digits_end s (i + 1) else i

// \u{XXXX YYYY ...}: hex codepoints (space-separated) up to the closing
// brace; returns the UTF-8 bytes and the index after the "}".
// a codepoint from \u: a surrogate (U+D800..U+DFFF) or one past U+10FFFF
// is "invalid Unicode escape" (ruby 4.0 refuses both)
and u_cp_checked = fn (cp: int) ->
  if cp > 1114111 || (cp >= 55296 && cp <= 57343) then (let _ = syn_refuse "invalid Unicode escape" in "")
  else utf8_of cp
and scan_u_braced = fn (s: str) -> fn (i: int) -> fn (acc: str) -> fn (cp: int) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated backslash-u" ++ parsing_file ()))) in fail ("mere-ruby: unterminated backslash-u" ++ parsing_file ()))
  else
    let c = char_at s i in
    // (cp is -1 before a digit: `\u{0}` is NUL, and `\u{}` nothing)
    if str_eq c "}" then (acc ++ (if cp >= 0 then u_cp_checked cp else ""), i + 1)
    else if str_eq c " " then scan_u_braced s (i + 1) (acc ++ (if cp >= 0 then u_cp_checked cp else "")) (0 - 1)
    // (more than six digits, past U+10FFFF, is refused at the end anyway;
    //  the cap keeps the number from growing without bound)
    else if is_hex_digit c then scan_u_braced s (i + 1) acc (if cp > 1114111 then cp else (if cp < 0 then 0 else cp) * 16 + hex_val c)
    // a character that is no hex digit is ruby's SyntaxError, "invalid
    // Unicode escape" (`"\u{123.}"`, `"\u{ghij}"`); the rest of the braces
    // is skipped so the string still ends where it ends
    else (let _ = syn_refuse "invalid Unicode escape" in
          let k9 = str_find_from s "}" i in
          (acc, if k9 >= 0 then k9 + 1 else str_len s))

// %(…) / %q(…) / %Q(…) / %w(…): index of the body start, or -1 when the
// % is just the modulo operator.
and percent_body = fn (s: str) -> fn (i: int) ->
  if i + 1 >= str_len s then 0 - 1
  // `x.%(3)` — a `%` right after a dot is the METHOD, never a literal. The
  // same holds for a backtick: `Kernel.`(cmd)` calls the method.
  // (but the dots of a range are an operator: `0..%q.` opens a literal)
  else if i > 0 && str_eq (char_at s (i - 1)) "." && (if i > 1 && str_eq (char_at s (i - 2)) "." then false else true) then 0 - 1
  // ...and `def %(other)` defines the METHOD: after `def` a % is a name, not a
  // literal opener. `class C; def %(o); end; end` did not parse at all, which
  // is every spec that defines modulo on its own class.
  // (guarded: with nothing before the %, prev_nonspace answers -1 and
  // word_ending_at would take a substring at a negative index -- which is how
  // a file whose FIRST token is `%w[...]` died with an interpreter error)
  else if (let pv = prev_nonspace s (i - 1) in
           pv >= 0 && str_eq (word_ending_at s pv) "def") then 0 - 1
  // `w %(2)` with w a LOCAL is w modulo (2), not w called with a string.
  else if lvt_prev_local s i then 0 - 1
  // Right after an operand, with no space between, a % is the operator:
  // prime.rb's `self%(p+4) == 0` is modulo, and so is `x%(2)`. ruby reads a
  // literal there only after a space (`puts %(a)`) or in value position --
  // which is also after a keyword (`return%w[a]`), so those stay literals.
  // ...and so is one right after a string's closing quote: `"%#x"%i` formats
  // i (test_numeric), it does not open a %i symbol array
  else if i > 0 && (let pc = char_at s (i - 1) in
                    str_eq pc ")" || str_eq pc "]" || str_eq pc "}"
                    || str_eq pc "\"" || str_eq pc "'"
                    || ((is_alnum pc || str_eq pc "_")
                        && (if pct_value_kw (word_ending_at s (i - 1)) then false else true))) then 0 - 1
  else
    let c1 = char_at s (i + 1) in
    // Bracket delimiters ( { [ < are unambiguous openers. Other clean
    // delimiters (', |, / ...) start a bare percent string only in value
    // position, to avoid stealing the modulo operator.
    if is_pct_open c1 then i + 2
    else if is_pct_delim c1 && regex_position s i then i + 2
    else if (str_eq c1 "q" || str_eq c1 "Q" || str_eq c1 "w" || str_eq c1 "i" || str_eq c1 "s" ||
             str_eq c1 "W" || str_eq c1 "I" || str_eq c1 "r" || str_eq c1 "x")
            && i + 2 < str_len s && is_pct_delim (char_at s (i + 2)) then i + 3
    else 0 - 1

// the keywords after which ruby's lexer expects a VALUE, so that a % right
// behind one opens a literal (`return%w[a]`, `when%i[x]`). `self`, `true`,
// `nil` and the rest end an operand like any identifier.
// a `%` where only a VALUE can stand -- the start of the source or of a
// statement, after `(`, `,` or `=` -- so it cannot be the operator
and pct_strict_value = fn (s: str) -> fn (i: int) ->
  let p = prev_nonspace s (i - 1) in
  p < 0 || (let c = char_at s p in str_eq c "\n" || str_eq c ";" || str_eq c "(" || str_eq c "," || str_eq c "=")
// ...and what ruby calls the % literal that is not one there
and pct_bad_msg = fn (s: str) -> fn (i: int) ->
  if i + 1 >= str_len s then "unterminated quoted string meets end of file"
  else
    (let nc = char_at s (i + 1) in
     let known = str_eq nc "q" || str_eq nc "Q" || str_eq nc "w" || str_eq nc "W" || str_eq nc "i" || str_eq nc "I"
                 || str_eq nc "s" || str_eq nc "r" || str_eq nc "x" in
     if known && i + 2 >= str_len s then
       (if str_eq nc "w" || str_eq nc "W" || str_eq nc "i" || str_eq nc "I" then "unterminated list meets end of file"
        else "unterminated quoted string meets end of file")
     else if is_alnum nc || ord nc >= 128 then "unknown type of %string"
     else "unterminated quoted string meets end of file")
and pct_value_kw = fn (w: str) ->
  str_eq w "return" || str_eq w "when" || str_eq w "in" || str_eq w "and" ||
  str_eq w "or" || str_eq w "not" || str_eq w "if" || str_eq w "unless" ||
  str_eq w "elsif" || str_eq w "while" || str_eq w "until" || str_eq w "then" ||
  str_eq w "do" || str_eq w "else" || str_eq w "case" || str_eq w "yield" ||
  str_eq w "break" || str_eq w "next"

// the control-character code for `\C-x`: the low five bits, except that
// `\C-?` is DEL.
// a control or meta escape at i (s[i] is the backslash): its byte and where
// it ends. The argument is one ASCII character or another escape -- a
// control or meta one, \xHH, octal, or a simple one; `\u` and a multibyte
// character are "Invalid escape character syntax", as in ruby.
and dq_cm = fn (s: str) -> fn (i: int) ->
  let e = char_at s (i + 1) in
  if str_eq e "c" then (let (v, j) = dq_cm_arg s (i + 2) in (dq_ctl v, j))
  else if str_eq e "C" then (let (v, j) = dq_cm_arg s (i + 3) in (dq_ctl v, j))
  else (let (v, j) = dq_cm_arg s (i + 3) in ((v - (v / 128) * 128) + 128, j))
and dq_ctl = fn (v: int) ->
  if v == 63 then 127 else (v / 128) * 128 + (v - (v / 32) * 32)
and dq_cm_bad = fn (u: unit) -> (let _ = syn_refuse "Invalid escape character syntax" in (0, 0))
and dq_cm_arg = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then dq_cm_bad ()
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (let e2 = char_at s (i + 1) in
       if str_eq e2 "c" || ((str_eq e2 "C" || str_eq e2 "M") && i + 2 < str_len s && str_eq (char_at s (i + 2)) "-") then dq_cm s i
       else if str_eq e2 "x" && i + 2 < str_len s && is_hex_digit (char_at s (i + 2)) then
         (let d1 = hex_val (char_at s (i + 2)) in
          if i + 3 < str_len s && is_hex_digit (char_at s (i + 3)) then (d1 * 16 + hex_val (char_at s (i + 3)), i + 4)
          else (d1, i + 3))
       else if e2 >= "0" && e2 <= "7" then scan_octal s (i + 1) 0 0
       else if str_eq e2 "u" || ord e2 >= 128 then dq_cm_bad ()
       else
         (let v = (if str_eq e2 "n" then 10 else if str_eq e2 "t" then 9 else if str_eq e2 "r" then 13
                   else if str_eq e2 "e" then 27 else if str_eq e2 "a" then 7 else if str_eq e2 "b" then 8
                   else if str_eq e2 "f" then 12 else if str_eq e2 "v" then 11 else if str_eq e2 "s" then 32
                   else ord e2) in
          (v, i + 2)))
    else if ord c >= 128 then dq_cm_bad ()
    else (ord c, i + 1)
and ctrl_code = fn (x: str) ->
  if str_eq x "?" then 127 else (let o = ord x in o - (o / 32) * 32)

// the last non-blank character before position i is `ch`
and prev_nonspace_is = fn (s: str) -> fn (i: int) -> fn (ch: str) ->
  let rec back = fn (j: int) ->
    if j < 0 then false
    else let c = char_at s j in
         if str_eq c " " || str_eq c "\t" then back (j - 1)
         else str_eq c ch in
  back (i - 1)
// the word ending just before position i (blanks allowed between) is `w`,
// and is not the tail of a longer identifier
and prev_word_is = fn (s: str) -> fn (i: int) -> fn (w: str) ->
  let rec back = fn (j: int) ->
    if j < 0 then false
    else let c = char_at s j in
         if str_eq c " " || str_eq c "\t" then back (j - 1)
         else
           let n = str_len w in
           j + 1 >= n && str_eq (substring s (j + 1 - n) (j + 1)) w
           && (j + 1 - n == 0 || (if is_alnum (char_at s (j - n)) || str_eq (char_at s (j - n)) "_" then false else true)) in
  back (i - 1)

// a percent-literal delimiter: any non-alphanumeric, non-space char.
and is_pct_delim = fn (c: str) ->
  // any non-alnum, non-whitespace char; _ and = are valid Ruby delimiters
  // (the bare-% form is still guarded by regex_position at the caller).
  str_eq c "_" || str_eq c "=" ||
  ((if is_alnum c then false else true) &&
   (if str_eq c " " || str_eq c "\t" || str_eq c "\n" then false else true))

and is_pct_open = fn (c: str) -> str_eq c "(" || str_eq c "\{" || str_eq c "[" || str_eq c "<"

and pct_close_of = fn (c: str) ->
  if str_eq c "(" then ")" else if str_eq c "\{" then "}"
  else if str_eq c "[" then "]" else if str_eq c "<" then ">" else c

and is_percent_w = fn (s: str) -> fn (i: int) ->
  i + 1 < str_len s && (str_eq (char_at s (i + 1)) "w" || str_eq (char_at s (i + 1)) "W")

// raw scan to the balanced closing delimiter; returns (body, index-after).
// like scan_balanced2 but for %r regex bodies: an escaped delimiter keeps
// its backslash only when the delimiter is a regex metacharacter (%r(\() is
// /\(/ but %r-\-- is /-/, matching Ruby's source normalization); any other
// backslash pair is copied verbatim for the regex parser.
and rx_is_meta = fn (c: str) ->
  str_eq c "|" ||
  str_eq c "\{" ||
  str_eq c "\\" ||
  map_has (name_set "rx_is_meta") c
and scan_pct_regex = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then (let _ = syn_refuse "unterminated regexp meets end of file" in ("", i))
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (let nx = char_at s (i + 1) in
       if (str_eq nx op || str_eq nx clo) && (if rx_is_meta nx then false else true) then
         scan_pct_regex s (i + 2) depth (acc ++ nx) op clo
       else scan_pct_regex s (i + 2) depth (acc ++ c ++ nx) op clo)
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_pct_regex s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_pct_regex s (i + 1) (depth - 1) (acc ++ c) op clo)
    else scan_pct_regex s (i + 1) depth (acc ++ c) op clo

and scan_balanced2 = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s && map_has syn_why "pk" then
    (let k9 = map_get syn_why "pk" in let _ = map_delete syn_why "pk" in
     let _ = syn_refuse (if str_eq k9 "list" then "unterminated list meets end of file" else "unterminated string meets end of file") in ("", i))
  else if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated % literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated % literal" ++ parsing_file ()))
  else
    let c = char_at s i in
    // a backslash escapes the delimiter (and itself) inside the body.
    if str_eq c "\\" && i + 1 < str_len s &&
       (str_eq (char_at s (i + 1)) op || str_eq (char_at s (i + 1)) clo || str_eq (char_at s (i + 1)) "\\") then
      scan_balanced2 s (i + 2) depth (acc ++ char_at s (i + 1)) op clo
    // when open and close differ (brackets) nesting counts; otherwise the
    // first delimiter closes.
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_balanced2 s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_balanced2 s (i + 1) (depth - 1) (acc ++ c) op clo)
    // an interpolation is copied through whole: its text may contain the
    // delimiter (`%@hey #{@ip}@` -- the `@` of the ivar is not the closer).
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      let j = skip_interp_body s (i + 2) 1 in
      scan_balanced2 s j depth (acc ++ substring s i j) op clo
    else scan_balanced2 s (i + 1) depth (acc ++ c) op clo

// scan_balanced2 for a body that the string lexer reads next (%Q, %()): the
// same scan, but an escaped backslash stays escaped, since that lexer is
// the one that unescapes it.
and scan_balanced_dq = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i + 1 < str_len s && str_eq (char_at s i) "\\" && str_eq (char_at s (i + 1)) "\\" then
    scan_balanced_dq s (i + 2) depth (acc ++ "\\\\") op clo
  else if i >= str_len s then scan_balanced2 s i depth acc op clo
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s &&
       (str_eq (char_at s (i + 1)) op || str_eq (char_at s (i + 1)) clo) then
      scan_balanced_dq s (i + 2) depth (acc ++ char_at s (i + 1)) op clo
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_balanced_dq s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_balanced_dq s (i + 1) (depth - 1) (acc ++ c) op clo)
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      let j = skip_interp_body s (i + 2) 1 in
      scan_balanced_dq s j depth (acc ++ substring s i j) op clo
    else scan_balanced_dq s (i + 1) depth (acc ++ c) op clo

// index just past the `}` that closes an interpolation whose `#{` has been
// consumed; braces inside nest.
and skip_interp_body = fn (s: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len s then i
  else let c = char_at s i in
       if str_eq c "\{" then skip_interp_body s (i + 1) (depth + 1)
       else if str_eq c "}" then (if depth == 1 then i + 1 else skip_interp_body s (i + 1) (depth - 1))
       else skip_interp_body s (i + 1) depth

// %w body -> `"w1", "w2", ... ]` token run (the caller emits the `[`).
// A backslash escapes the next character into the word (b\ c, b\<nl>c).
and pw_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pw_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pw_tok interp w (Cons (TP "]", rest))
    else pw_tok interp w (Cons (TP ",", pw_words interp t k rest))

// %i body -> `:w1, :w2, ... ]` token run (symbol words).
and pi_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pi_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pi_tok interp w (Cons (TP "]", rest))
    else pi_tok interp w (Cons (TP ",", pi_words interp t k rest))

// one %I/%W word: an interpolated word desugars through the string lexer.
and pi_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && (rx_has_interp w 0 || str_contains w "\\" || str_contains w "#$" || str_contains w "#@") then
    Cons (TP "(s", tapp (drop_eof (lex_go ("\"" ++ hd_escape_dq w 0 ++ "\"") 0))
      (Cons (TP ")", Cons (TP ".", Cons (TId "to_sym", rest)))))
  else Cons (TSym w, rest)

// a %W word with an interpolation or an escape is a double-quoted string
// (`\225` is one byte, `\u3042` a character); pw_word kept its escapes raw
and pw_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && (rx_has_interp w 0 || str_contains w "\\" || str_contains w "#$" || str_contains w "#@") then
    Cons (TP "(s", tapp (drop_eof (lex_go ("\"" ++ hd_escape_dq w 0 ++ "\"") 0)) (Cons (TP ")", rest)))
  else Cons (TStrL w, rest)

and pw_word = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len t then (acc, i)
  else
    let c = char_at t i in
    // In %W/%I (interp) a backslash-escape stays as written, for pw_tok's
    // string lexer (an escaped space still does not end the word); in %w/%i
    // it keeps the next character literally (\ joins words).
    // `\u{7559 5b88}` is ONE escape (two characters): its space does not end
    // the word either
    if interp && str_eq c "\\" && i + 2 < str_len t && str_eq (char_at t (i + 1)) "u"
       && str_eq (char_at t (i + 2)) "\{" then
      (let j = pw_brace_end t (i + 3) in pw_word interp t j (acc ++ substring t i j))
    else if str_eq c "\\" && i + 1 < str_len t then
      let nx = char_at t (i + 1) in
      let piece = (if interp then "\\" ++ nx
                   // %w keeps a literal backslash except before space / \ / nl.
                   else if str_eq nx " " || str_eq nx "\\" || str_eq nx "\n" then nx
                   else "\\" ++ nx) in
      pw_word interp t (i + 2) (acc ++ piece)
    // an interpolation is CODE, and a space inside it does not end the word:
    // fiddle's extconf writes `%W[CXXFLAGS=#{RbConfig.expand("$(CXXFLAGS)".dup, nowarn)}]`.
    else if interp && str_eq c "#" && i + 1 < str_len t && str_eq (char_at t (i + 1)) "\{" then
      (let j = interp_close t (i + 2) 1 in pw_word interp t j (acc ++ substring t i j))
    else if str_eq c " " || str_eq c "\n" then (acc, i)
    else pw_word interp t (i + 1) (acc ++ c)

and pw_brace_end = fn (t: str) -> fn (j: int) ->
  if j >= str_len t then j else if str_eq (char_at t j) "}" then j + 1 else pw_brace_end t (j + 1)

and pw_skip = fn (t: str) -> fn (j: int) ->
  if j < str_len t && (str_eq (char_at t j) " " || str_eq (char_at t j) "\n") then pw_skip t (j + 1) else j

// index after an e/E exponent suffix at i, or i when there is none.
and scan_exponent = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) "e" || str_eq (char_at s i) "E") then
    let j = (if i + 1 < str_len s && (str_eq (char_at s (i + 1)) "-" || str_eq (char_at s (i + 1)) "+") then i + 2 else i + 1) in
    (if j < str_len s && is_digit (char_at s j) then scan_base s j 10 else i)
  else i

// emit an integer literal with an optional `r` (Rational) / `i` (Complex)
// suffix; used for the hex/octal/binary paths (the decimal path inlines it).
and ri_suffix = fn (s: str) -> fn (j: int) -> fn (v: int) ->
  if j < str_len s && str_eq (char_at s j) "r"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TRat (str_of_int v, "1"), lex_go s (j + 1))
  else if j < str_len s && str_eq (char_at s j) "i"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TImag v, lex_go s (j + 1))
  else Cons (TInt v, lex_go s j)

and is_upper = fn (c: str) -> let o = ord c in o >= 65 && o <= 90

and quote_end = fn (s: str) -> fn (i: int) -> fn (q: str) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) q then i
  else quote_end s (i + 1) q

and hexv = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87
  else if o >= 65 && o <= 70 then o - 55
  else 0

// up to 3 octal digits from i; returns (value, index-after).
// Three octal digits reach 0o777 = 511, and ruby keeps the low byte: "\666"
// is "\xB6" and "\400" is "\0", without a warning. The value went to `chr`
// whole, which refused 438 and took minitest's assertion tests with it.
and scan_octal = fn (s: str) -> fn (i: int) -> fn (acc: int) -> fn (n: int) ->
  if n >= 3 || i >= str_len s then (acc - (acc / 256) * 256, i)
  else
    let c = char_at s i in
    if c >= "0" && c <= "7" then scan_octal s (i + 1) (acc * 8 + (ord c - 48)) (n + 1)
    else (acc - (acc / 256) * 256, i)

// index of the closing double-quote of a string body starting at i.
and dq_str_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\\" && i + 1 < str_len s then dq_str_end s (i + 2)
  else if str_eq (char_at s i) "\"" then i
  else dq_str_end s (i + 1)

// unescape the common backslash escapes in a plain quoted symbol body.
and dq_unescape = fn (body: str) -> fn (i: int) ->
  if i >= str_len body then ""
  else
    let c = char_at body i in
    if str_eq c "\\" && i + 1 < str_len body then
      let e = char_at body (i + 1) in
      let piece = (if str_eq e "n" then "\n" else if str_eq e "t" then "\t" else e) in
      piece ++ dq_unescape body (i + 2)
    else c ++ dq_unescape body (i + 1)

and is_hex_digit = fn (c: str) ->
  (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
and hex_val = fn (c: str) ->
  if c >= "0" && c <= "9" then ord c - 48
  else if c >= "a" && c <= "f" then ord c - 87
  else if c >= "A" && c <= "F" then ord c - 55
  else 0

// ---- what encoding is a REGEXP pattern in? --------------------------------
// A pattern carries an encoding when its source names a non-ASCII character --
// and it can name one in three ways. A raw byte above 127 is one; so is an
// escape that spells the same character in pure ASCII: `/\u{3042}/` and
// `/\xe3/` are UTF-8 patterns whose SOURCE is entirely 7-bit, while
// `/\u{41}/` and `/\x41/` are US-ASCII. Looking only at the raw bytes made
// every escaped pattern US-ASCII, and the encoding is not a label here: it
// decides #fixed_encoding? and what #source answers.
and rx_hex_run_ge80 = fn (p: str) -> fn (i: int) -> fn (acc: int) -> fn (any: bool) ->
  if i < str_len p && is_hex_digit (char_at p i) then
    rx_hex_run_ge80 p (i + 1) (acc * 16 + hex_val (char_at p i)) true
  else (if any && acc >= 128 then true else false)
and rx_u_esc_ge80 = fn (p: str) -> fn (i: int) ->
  // `\uXXXX` or `\u{X X ...}`: any codepoint in it decides
  // (the brace is escaped: a bare "{" in a Mere string starts interpolation)
  if i < str_len p && str_eq (char_at p i) "\{" then rx_u_braced_ge80 p (i + 1)
  else rx_hex_run_ge80 p i 0 false
and rx_u_braced_ge80 = fn (p: str) -> fn (i: int) ->
  if i >= str_len p || str_eq (char_at p i) "}" then false
  else if is_hex_digit (char_at p i) then
    (if rx_hex_run_ge80 p i 0 false then true else rx_u_braced_ge80 p (i + 1))
  else rx_u_braced_ge80 p (i + 1)
// what a pattern names that is not ASCII: (a \u escape, a raw byte or a
// \x escape past 0x7f). The first makes it UTF-8, the second takes the
// source's encoding, and the two together outside UTF-8 are ruby's
// "UTF-8 character in non UTF-8 regexp".
and rx_kinds = fn (p: str) -> fn (i: int) -> fn (hu: bool) -> fn (ho: bool) ->
  if i >= str_len p then (hu, ho)
  else if ord (char_at p i) >= 128 then rx_kinds p (i + 1) hu true
  else if str_eq (char_at p i) "\\" && i + 1 < str_len p then
    (let c9 = char_at p (i + 1) in
     if str_eq c9 "u" then rx_kinds p (i + 2) true ho
     else if str_eq c9 "x" then rx_kinds p (i + 2) hu (ho || rx_hex_run_ge80 p (i + 2) 0 false)
     else rx_kinds p (i + 2) hu ho)
  else rx_kinds p (i + 1) hu ho
// A regexp LITERAL in a source that is not UTF-8 is in the source's
// encoding when it names a non-ASCII character (EUC-JP, Windows-31J; a
// US-ASCII or BINARY source makes it BINARY) and is fixed to it, as a
// string literal there is (`__lit_enc~`). An explicit e/s/u/n says it
// itself; an ASCII-only pattern stays US-ASCII and unfixed.
and rx_src_enc_wrap = fn (e: Expr) -> fn (lit: str) -> fn (fl: str) ->
  let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
  if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" || str_contains fl "e" || str_contains fl "s" || str_contains fl "u" || str_contains fl "n" then e
  else
    (match rx_kinds lit 0 false false with
     | (true, true) ->
       (let __fm = ("mere-ruby: UTF-8 character in non UTF-8 regexp: /" ++ lit ++ "/") in
        let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
     | (false, true) ->
       (let en = (if str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII" || str_eq cd "ASCII-8BIT" || str_eq cd "BINARY" then "ASCII-8BIT" else cd) in
        EMethod (e, "__rx_enc~" ++ en, Nil))
     | _ -> e)
// rb_reg_preprocess's refusal of a pattern that is not UTF-8 and holds both
// a \u escape and a raw non-ASCII byte: named by whichever came first --
// "UTF-8 character in non UTF-8 regexp" after a raw byte, "non ASCII
// character in UTF-8 regexp" after a \u. "" when there is no such mix.
and rx_u_mix_why = fn (p: str) -> fn (enc: str) ->
  if enc_utf8_family enc then ""
  else
    (let n = str_len p in
     let rec go = fn (i: int) -> fn (seen: int) ->
       // seen: 0 nothing yet, 1 a raw byte first, 2 a \u first
       if i >= n then ""
       else if ord (char_at p i) >= 128 then
         (if seen == 2 then "non ASCII character in UTF-8 regexp" else go (i + 1) (if seen == 0 then 1 else seen))
       // (only a \u past ASCII is UTF-8, and an escaped byte past 0x7f
       //  counts as the raw one does: `\u0041\xa4\xa2` in EUC-JP is fine)
       else if str_eq (char_at p i) "\\" && i + 1 < n then
         (if str_eq (char_at p (i + 1)) "u" && rx_u_esc_ge80 p (i + 2) then
            (if seen == 1 then "UTF-8 character in non UTF-8 regexp" else go (i + 2) (if seen == 0 then 2 else seen))
          else if str_eq (char_at p (i + 1)) "x" && i + 2 < n && is_hex_digit (char_at p (i + 2)) && hex_val (char_at p (i + 2)) >= 8
                  && i + 3 < n && is_hex_digit (char_at p (i + 3)) then
            (if seen == 2 then "non ASCII character in UTF-8 regexp" else go (i + 2) (if seen == 0 then 1 else seen))
          else go (i + 2) seen)
       else go (i + 1) seen in
     go 0 0)
and rx_src_nonascii = fn (p: str) -> fn (i: int) ->
  if i >= str_len p then false
  else if ord (char_at p i) >= 128 then true
  else if str_eq (char_at p i) "\\" && i + 1 < str_len p then
    (let c9 = char_at p (i + 1) in
     if str_eq c9 "u" then
       (if rx_u_esc_ge80 p (i + 2) then true else rx_src_nonascii p (i + 2))
     else if str_eq c9 "x" then
       (if rx_hex_run_ge80 p (i + 2) 0 false then true else rx_src_nonascii p (i + 2))
     // any other escape covers exactly one character; step over both
     else rx_src_nonascii p (i + 2))
  else rx_src_nonascii p (i + 1)
// The one rule, so #encoding, #fixed_encoding? and #source cannot disagree:
// an explicit modifier names the encoding outright, `/n` means BYTES, and
// otherwise a pattern that names a non-ASCII character is in the script's
// encoding. `fixed_encoding?` is exactly "the answer is not US-ASCII".
// What Regexp.union's arguments say about the union's encoding, and whether
// they contradict each other. THREE accumulators, not one, and they are
// re-checked after EVERY argument rather than at the end:
//
//   asciionly  some argument yields -- ASCII-only text in an ascii-compatible
//              encoding, or a Regexp that does not fix one
//   inc        an argument in an ASCII-INCOMPATIBLE encoding (UTF-16/32)
//   fix        an argument that FIXES an ascii-compatible encoding: a
//              fixed_encoding? Regexp, or a String carrying a non-ASCII byte
//
// Two arguments landing in the same accumulator with different encodings is
// "incompatible encodings: A and B", naming the one already accumulated first.
// An ASCII-incompatible argument beside anything else is a refusal too, and
// WHICH refusal depends on what the other side was: "ASCII incompatible
// encoding: X" against a yielding argument, "incompatible encodings: X and Y"
// against one that fixes. Answers ("", "", "") when nothing is contradicted;
// the third element is the message, "" for none.
and rx_union_scan = fn (xs: Val list) -> fn (asciionly: bool) -> fn (inc: str) -> fn (fix: str) ->
  match xs with
  | Nil -> (inc, fix, "")
  | Cons (h9, t9) ->
    (let (e9, fixes9) =
       (match h9 with
        // a Regexp fixes its encoding exactly when that encoding is not
        // US-ASCII -- which is what #fixed_encoding? answers (see rx_enc_name).
        | VRegex (p9, f9, ev9) ->
          (let n9 = rx_enc_name p9 f9 ev9 in
           (n9, str_contains f9 "u" || (if str_eq n9 "US-ASCII" then false else true)))
        | VStr s9 -> (let n9 = enc_canon_name (senc_get s9) in (n9, (if enc_all7 (sget s9) then false else true)))
        | VSym s9 -> (let n9 = enc_canon_name (sym_enc_name s9) in (n9, (if enc_all7 s9 then false else true)))
        | _ -> ("US-ASCII", false)) in
     let incompat9 = (if enc_ascii_compat e9 then false else true) in
     let (ao2, inc2, fix2, err2) =
       (if incompat9 then
          (if str_eq inc "" then (asciionly, e9, fix, "")
           else if str_eq inc e9 then (asciionly, inc, fix, "")
           else (asciionly, inc, fix, "incompatible encodings: " ++ inc ++ " and " ++ e9))
        else if fixes9 then
          (if str_eq fix "" then (asciionly, inc, e9, "")
           else if str_eq fix e9 then (asciionly, inc, fix, "")
           else (asciionly, inc, fix, "incompatible encodings: " ++ fix ++ " and " ++ e9))
        else (true, inc, fix, "")) in
     if (if str_eq err2 "" then false else true) then (inc2, fix2, err2)
     else if (if str_eq inc2 "" then false else true) && ao2 then
       (inc2, fix2, "ASCII incompatible encoding: " ++ inc2)
     else if (if str_eq inc2 "" then false else true) && (if str_eq fix2 "" then false else true) then
       (inc2, fix2, "incompatible encodings: " ++ inc2 ++ " and " ++ fix2)
     else rx_union_scan t9 ao2 inc2 fix2)
// What ONE value contributes, read off the same scan: the ASCII-incompatible
// encoding if it is in one, else the ascii-compatible encoding it fixes, else
// "" for an argument that yields. Regexp.new and the `/#{...}/` desugaring ask
// this about their single source string, so they cannot drift from union.
and rx_one_enc = fn (v: Val) ->
  (match rx_union_scan (Cons (v, Nil)) false "" "" with
   | (inc9, fix9, _) -> (if str_eq inc9 "" then fix9 else inc9))
and rx_alts_binary = fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (VStr h9, t9) ->
    (if str_eq (enc_canon_name (senc_get h9)) "ASCII-8BIT" then true else rx_alts_binary t9)
  // ⚠ ...and a REGEXP argument carries an encoding too. `Regexp.union` over
  // patterns rather than strings only looked at the strings, so a union with
  // `/[\x80-\xBF]/n` in it -- a BINARY pattern -- came out UTF-8 whatever
  // order the arguments were written in.
  | Cons (VRegex (p9, f9, ev9), t9) ->
    (if str_eq (rx_enc_name p9 f9 ev9) "ASCII-8BIT" then true else rx_alts_binary t9)
  | Cons (_, t9) -> rx_alts_binary t9
and rx_enc_name = fn (p: str) -> fn (fl: str) -> fn (e: str) ->
  // ⚠ The encoding the VALUE carries wins over anything derivable. `u` alone
  // carries two different claims -- as a literal modifier (`/x/u`) it names
  // UTF-8, as Regexp::FIXEDENCODING it says "keep the SOURCE STRING's
  // encoding", which is whatever that string had. Only the builder that read
  // that string knows which, so it says so in the value rather than in a table
  // keyed by (source, flags), which cannot tell two such patterns apart.
  if (if str_eq e "" then false else true) then e
  else if str_contains fl "u" then "UTF-8"
  else if str_contains fl "e" then "EUC-JP"
  else if str_contains fl "s" then "Windows-31J"
  else if str_contains fl "n" then (if rx_src_nonascii p 0 then "ASCII-8BIT" else "US-ASCII")
  else if rx_src_nonascii p 0 then "UTF-8"
  else "US-ASCII"

// an 8 or a 9 in s[i, j) (the digits after a leading-zero octal's 0)
and oct_run_bad = fn (s: str) -> fn (i: int) -> fn (j: int) ->
  if i >= j then false
  else if str_eq (char_at s i) "8" || str_eq (char_at s i) "9" then true
  else oct_run_bad s (i + 1) j

and hex4 = fn (s: str) -> fn (i: int) ->
  hexv (char_at s i) * 4096 + hexv (char_at s (i + 1)) * 256 +
  hexv (char_at s (i + 2)) * 16 + hexv (char_at s (i + 3))

// UTF-8 for one codepoint. This is the lexer's copy (utf8_enc, further down, is
// the runtime's) and it had no FOUR-byte branch: every codepoint above U+FFFF
// went through the three-byte arithmetic and overflowed, so `"\u{1F600}"` lexed
// to [255, 152, 128] rather than [240, 159, 152, 128] -- wrong bytes, quietly.
// The same emoji written literally in the source was always fine, which is what
// hid it: the two paths do not share an encoder.
and utf8_of = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + (cp - cp / 64 * 64))
  else if cp < 65536 then chr (224 + cp / 4096) ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))
  else chr (240 + cp / 262144) ++ chr (128 + (cp / 4096 - cp / 262144 * 64))
       ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))

// heredoc body as token(s): interpolated bodies route through the
// double-quoted string lexer.
and heredoc_tok = fn (body0: str) ->
  // An interpolating heredoc is a double-quoted string: `\\` is one
  // backslash, `\t` is a tab. Both forms therefore go through the string
  // lexer -- emitting the body raw when it happened to contain no `#{}` left
  // its escapes unprocessed, and rubocop's compiler writes `end \\` into
  // generated code, which came out as two backslashes and would not lex.
  let body = hd_line_cont body0 0 in
  tapp (Cons (TP "(s", drop_eof (lex_go ("\"" ++ hd_escape_dq body 0 ++ "\"") 0))) (Cons (TP ")", Nil))

// quote a heredoc body so the string lexer sees exactly it: an interpolation
// is code and is copied whole, an escape pair is copied whole (the lexer
// processes it), and a bare `"` is escaped so it does not end the literal.
and hd_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      (let j = interp_close lit (i + 2) 1 in substring lit i j ++ hd_escape_dq lit j)
    else if str_eq c "\\" && i + 1 < str_len lit then
      (c ++ char_at lit (i + 1)) ++ hd_escape_dq lit (i + 2)
    else if str_eq c "\"" then "\\\"" ++ hd_escape_dq lit (i + 1)
    else c ++ hd_escape_dq lit (i + 1)

// backslash-newline in an interpolating heredoc is a line continuation
// (dropped); an escaped backslash stays.
and hd_line_cont = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (if str_eq (char_at s (i + 1)) "\n" then hd_line_cont s (i + 2)
       else c ++ char_at s (i + 1) ++ hd_line_cont s (i + 2))
    else c ++ hd_line_cont s (i + 1)

// <<`ID` / <<-`ID` / <<~`ID`: a COMMAND heredoc. The body is an interpolating
// heredoc's (dedented for ~), handed to #` as a backtick literal's is. The
// backquote was not an identifier quote here, so `<<~`eos`` was a syntax
// error -- test_syntax tries every heredoc four ways and the fourth is this.
and hd_lex_cmd = fn (s: str) -> fn (idend: int) -> fn (hid: str) -> fn (squiggly: bool) ->
  let nl = find_nl s idend in
  let inner = nl >= str_len s && hd_in_ctx s in
  let os = (if inner then vec_get hd_cs 0 else s) in
  let onl = (if inner then find_nl os (lvt_vget hd_cv 0 + idend) else nl) in
  let (body, after) = heredoc_body os (hd_start os onl) hid squiggly in
  let _ = hd_note os onl after in
  Cons (TId "`", Cons (TP "(", tapp (heredoc_tok body) (Cons (TP ")", lex_go s idend))))
// A heredoc whose id ends at `idend` of `s`: its body, then the rest of its
// line lexed IN PLACE (see hd_src). In an interpolation's code (no newline of
// its own) the line and the body are the enclosing source's.
and hd_lex = fn (s: str) -> fn (idend: int) -> fn (hid: str) -> fn (squiggly: bool) -> fn (raw: bool) ->
  let nl = find_nl s idend in
  let inner = nl >= str_len s && hd_in_ctx s in
  let os = (if inner then vec_get hd_cs 0 else s) in
  let onl = (if inner then find_nl os (lvt_vget hd_cv 0 + idend) else nl) in
  let (body, after) = heredoc_body os (hd_start os onl) hid squiggly in
  let _ = hd_note os onl after in
  let bodytok = (if raw then Cons (TStrL body, Nil) else heredoc_tok body) in
  tapp bodytok (lex_go s idend)

// where a heredoc on the line ending at `nl` takes its body: after the body
// of the line's previous heredoc, or on the next line
and hd_start = fn (s: str) -> fn (nl: int) ->
  let k = hd_find s nl 0 in if k >= 0 then vec_get hd_aft k else nl + 1
and hd_find = fn (s: str) -> fn (nl: int) -> fn (k: int) ->
  if k >= lvt_vget hd_cnt 0 then 0 - 1
  else if vec_get hd_nl k == nl && str_eq (vec_get hd_src k) s then k
  else hd_find s nl (k + 1)
and hd_note = fn (s: str) -> fn (nl: int) -> fn (after: int) ->
  if nl >= str_len s then ()
  else
    let k = hd_find s nl 0 in
    if k >= 0 then vec_set hd_aft k after
    else
      let n = lvt_vget hd_cnt 0 in
      let _ = (if n < vec_len hd_src then
                 (let _ = vec_set hd_src n s in let _ = vec_set hd_nl n nl in vec_set hd_aft n after)
               else (let _ = vec_push hd_src s in let _ = vec_push hd_nl nl in let _ = vec_push hd_aft after in ())) in
      lvt_vset hd_cnt 0 (n + 1)
// the newline at `i` of `s` ends a line that held heredocs: the index after
// the last body (and the note is spent), or -1
and hd_jump = fn (s: str) -> fn (i: int) ->
  if lvt_vget hd_cnt 0 == 0 then 0 - 1
  else
    let k = hd_find s i 0 in
    if k < 0 then 0 - 1
    else
      let a = vec_get hd_aft k in
      let n = lvt_vget hd_cnt 0 - 1 in
      let _ = vec_set hd_src k (vec_get hd_src n) in
      let _ = vec_set hd_nl k (vec_get hd_nl n) in
      let _ = vec_set hd_aft k (vec_get hd_aft n) in
      let _ = vec_set hd_src n "" in
      let _ = lvt_vset hd_cnt 0 n in
      a
// is `s` the code of the interpolation hd_cs / hd_cv name?
and hd_in_ctx = fn (s: str) ->
  let n = lvt_vget hd_cv 1 - 1 in
  n >= 0 && n == str_len s
  && (let o = lvt_vget hd_cv 0 in str_eq (substring (vec_get hd_cs 0) o (o + n)) s)
// lex the code of `#{...}` (s[a..b)) knowing where it sits; an interpolation
// inside an interpolation names the outermost source
and hd_in_interp = fn (s: str) -> fn (a: int) -> fn (b: int) ->
  let ps = (if vec_len hd_cs > 0 then vec_get hd_cs 0 else "") in
  let po = lvt_vget hd_cv 0 in
  let pn = lvt_vget hd_cv 1 in
  let nested = hd_in_ctx s in
  let _ = hd_cset (if nested then ps else s) (if nested then po + a else a) (b - a + 1) in
  let toks = drop_eof (lex_go (substring s a b) 0) in
  let _ = hd_cset ps po pn in
  toks
// (the source is written only when it changes: every interpolation set it
//  and put it back, and each write copies the whole source into hd_cs's
//  region, the shared default one -- 21 MB of the prelude's lexing at every
//  start, note 310)
and hd_cset = fn (s: str) -> fn (o: int) -> fn (n1: int) ->
  // (and not at all when n1 is 0, "no source": hd_in_ctx asks the length
  //  first, so the text left there is never read -- and the restore after
  //  each top-level interpolation was exactly that, "" over the source)
  let _ = (if n1 == 0 && vec_len hd_cs > 0 then ()
           else if vec_len hd_cs > 0 then
             (if str_len (vec_get hd_cs 0) == str_len s && str_eq (vec_get hd_cs 0) s then ()
              else vec_set hd_cs 0 s)
           else (let _ = vec_push hd_cs s in ())) in
  let _ = lvt_vset hd_cv 0 o in
  lvt_vset hd_cv 1 n1
// a whole source starts with no notes (a parse that failed can leave some)
and hd_reset = fn (u: unit) ->
  let _ = lvt_vset hd_cnt 0 0 in
  // (and the hash-pattern flag a parse that failed inside braces left set)
  let _ = (if map_has parser_flags "hpbrace" then map_delete parser_flags "hpbrace" else ()) in
  lvt_vset hd_cv 1 0

and find_nl = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else find_nl s (i + 1)

// collect heredoc lines from `i` until the terminator line; returns
// (body, index-after-terminator-line). squiggly strips the common indent.
and heredoc_body = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (squiggly: bool) ->
  let (lines, after) = heredoc_lines s i hid Nil in
  let body = if squiggly then hd_join (hd_strip lines (hd_min_indent lines 9999)) else hd_join lines in
  (body, after)

// where `<<ID` (or <<-ID / <<~ID, quoted or not) is first written in s, or -1
and hd_open_line = fn (s: str) -> fn (hid: str) ->
  let k1 = str_index_of s ("<<" ++ hid) in
  if k1 >= 0 then k1
  else (let k2 = str_index_of s ("<<~" ++ hid) in
        if k2 >= 0 then k2 + 1
        else (let k3 = str_index_of s ("<<-" ++ hid) in if k3 >= 0 then k3 + 1 else 0 - 1))
// the "unterminated heredoc" lines for the heredocs opened in s[k, e)
and hd_more_ids = fn (s: str) -> fn (k: int) -> fn (e: int) ->
  if k + 2 >= e then ""
  else if str_eq (substring s k (k + 2)) "<<" then
    (let k1 = (if k + 2 < e && (str_eq (char_at s (k + 2)) "~" || str_eq (char_at s (k + 2)) "-") then k + 3 else k + 2) in
     let k2 = (if k1 < e && (str_eq (char_at s k1) "'" || str_eq (char_at s k1) "\"") then k1 + 1 else k1) in
     let k3 = hd_id_end s k2 e in
     if k3 > k2 && (is_alpha (char_at s k2) || str_eq (char_at s k2) "_")
     then "\nunterminated heredoc; can't find string \"" ++ substring s k2 k3 ++ "\" anywhere before EOF" ++ hd_more_ids s k3 e
     else hd_more_ids s (k + 2) e)
  else hd_more_ids s (k + 1) e
and hd_id_end = fn (s: str) -> fn (k: int) -> fn (e: int) ->
  if k < e && (is_alnum (char_at s k) || str_eq (char_at s k) "_") then hd_id_end s (k + 1) e else k
and heredoc_lines = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (acc: str list) ->
  if i >= str_len s then
    // (and every heredoc opened after it on the same line, which this one's
    //  body swallowed: `puts <<A + <<B` names both)
    (let ln0 = hd_open_line s hid in
     let more9 = (if ln0 < 0 then "" else hd_more_ids s (ln0 + 2 + str_len hid) (find_nl s ln0)) in
     let _ = syn_refuse ("unterminated heredoc; can't find string \"" ++ hid ++ "\" anywhere before EOF" ++ more9) in (rev_app_str acc Nil, i))
  else
    let nl = find_nl s i in
    let line = substring s i nl in
    // (an identifier that itself starts with a blank -- `<<' FOO'` -- ends at
    //  a line that is exactly it, [Bug #19539])
    if str_eq (hd_lstrip line) hid || str_eq line hid then (rev_app_str acc Nil, if nl < str_len s then nl + 1 else nl)
    else heredoc_lines s (if nl < str_len s then nl + 1 else nl) hid (Cons (line, acc))

and rev_app_str = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_app_str t (Cons (h, acc))

and hd_lstrip = fn (line: str) ->
  if str_len line > 0 && (str_eq (char_at line 0) " " || str_eq (char_at line 0) "\t")
  then hd_lstrip (substring line 1 (str_len line)) else line

and hd_indent_of = fn (line: str) -> fn (n: int) ->
  if n < str_len line && str_eq (char_at line n) " " then hd_indent_of line (n + 1) else n

and hd_min_indent = fn (lines: str list) -> fn (best: int) ->
  match lines with
  | Nil -> best
  | Cons (l, r) ->
    if str_eq (hd_lstrip l) "" then hd_min_indent r best
    else let ind = hd_indent_of l 0 in hd_min_indent r (if ind < best then ind else best)

and hd_strip = fn (lines: str list) -> fn (n: int) ->
  match lines with
  | Nil -> Nil
  | Cons (l, r) ->
    let l2 = if str_len l >= n then substring l n (str_len l) else "" in
    Cons (l2, hd_strip r n)

and hd_join = fn (lines: str list) ->
  match lines with Nil -> "" | Cons (l, r) -> l ++ "\n" ++ hd_join r

// the one-character globals: $& $` $' $+ $~ $! $@ $/ $\\ $, $; $. $< $> $_ $* $$ $? $: $0-9
and is_gvar_punct = fn (c: str) ->
  str_eq c "&" || str_eq c "`" || str_eq c "'" || str_eq c "+" || str_eq c "~" ||
  str_eq c "!" || str_eq c "@" || str_eq c "/" || str_eq c "," || str_eq c ";" ||
  str_eq c "." || str_eq c "<" || str_eq c ">" || str_eq c "_" || str_eq c "*" ||
  str_eq c "$" || str_eq c "?" || str_eq c ":" || str_eq c "\"" ||
  str_eq c "\\" || str_eq c "=" || is_digit c

// scan the longest operator name after a `:` (3, then 2, then 1 chars; []=
// and [] as special cases).
and is_op_sym_start = fn (c: str) ->
  str_eq c "|" ||
  map_has (name_set "is_op_sym_start") c
and scan_op_sym = fn (s: str) -> fn (i: int) ->
  let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
  let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
  if str_eq three "===" || str_eq three "<=>" || str_eq three "[]=" || str_eq three "**=" then (three, i + 3)
  else if str_eq two "==" || str_eq two "!=" || str_eq two "<=" || str_eq two ">=" ||
          str_eq two "<<" || str_eq two ">>" || str_eq two "**" || str_eq two "[]" ||
          // `:=~` and `:!~` are both method names (rubocop lists them in a
          // node pattern); only :~@ / :!@ fold to :~ and :!.
          str_eq two "=~" || str_eq two "!~" ||
          // the unary method names :-@ and :+@ (`-@` is what `''.respond_to?`
          // is asked about to see whether a String can be frozen-deduped).
          // `:~@` / `:!@` are NOT here: Ruby folds those to :~ and :!.
          str_eq two "-@" || str_eq two "+@" then (two, i + 2)
  else (substring s i (i + 1), i + 1)

// split a scoped constant name at the LAST `::`: recv part and const name.
and scoped_split = fn (name: str) -> fn (i: int) -> fn (last: int) ->
  if i + 1 >= str_len name then last
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then scoped_split name (i + 2) i
  else scoped_split name (i + 1) last
and recv_of_scoped = fn (name: str) -> substring name 0 (scoped_split name 0 0)
and const_of_scoped = fn (name: str) -> substring name (scoped_split name 0 0 + 2) (str_len name)

// index of the FIRST `::` in a scoped name, or -1.
and first_colon2 = fn (name: str) -> fn (i: int) ->
  if i + 1 >= str_len name then (0 - 1)
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then i
  else first_colon2 name (i + 1)

// `module m::N` where the leftmost segment names a local variable holding a
// class/module: rewrite the name to that class's real name (m -> AnonModule_k)
// so the definition registers under it, not under the literal variable name.
and resolve_scoped_base = fn env -> fn (name: str) ->
  let i = first_colon2 name 0 in
  if i < 0 then name
  else
    let head = substring name 0 i in
    if lv_has env head then
      (match lv_get env head with VClass c -> c ++ "::" ++ substring name (i + 2) (str_len name) | _ -> name)
    else name

and rx_has_interp = fn (lit: str) -> fn (i: int) ->
  if i + 1 >= str_len lit then false
  // escapes take precedence over interpolation: \#{ is a literal #, and the
  // control escapes \c? / \C-? consume the char after them (so /\c#{s}/ has
  // NO interpolation — the # is the control character's argument).
  else if str_eq (char_at lit i) "\\" then
    (let e = (if i + 1 < str_len lit then char_at lit (i + 1) else "") in
     if str_eq e "c" then rx_has_interp lit (i + 3)
     else if str_eq e "C" then rx_has_interp lit (i + 4)
     else rx_has_interp lit (i + 2))
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "\{" then true
  else rx_has_interp lit (i + 1)

// ...and a regex literal also interpolates a variable without braces
// (`/a #@s b/`, `/#@@c/`, `/#$g/`): parse.y's parser_peek_variable_name, an
// identifier after `#@`, `#@@` or `#$`, or a digit or a global's punctuation
// after `#$`. The regex's own terminator is not one (`/a#$/` ends there).
and rx_has_dvar = fn (lit: str) -> fn (i: int) ->
  if i + 2 >= str_len lit then false
  else if str_eq (char_at lit i) "\\" then rx_has_dvar lit (i + 2)
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "@" then
    (let k = (if str_eq (char_at lit (i + 2)) "@" then i + 3 else i + 2) in
     if k < str_len lit && (is_alpha (char_at lit k) || str_eq (char_at lit k) "_") then true
     else rx_has_dvar lit (i + 1))
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "$" then
    (let c = char_at lit (i + 2) in
     if is_alpha c || str_eq c "_" || is_digit c then true
     else rx_has_dvar lit (i + 1))
  else rx_has_dvar lit (i + 1)

// rebuild the regex body as double-quoted-string SOURCE so the normal
// interpolation lexer produces the concat tokens.
and rx_interp_src = fn (lit: str) ->
  "\"" ++ rx_escape_dq lit 0 ++ "\""

and rx_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    // an interpolation is code: copy it verbatim (its own quotes/escapes
    // must reach the code lexer untouched).
    // Each piece goes through __rx_frag on its way in, which refuses the
    // escapes ruby refuses in a piece on its own (rx_frag_why). (A piece
    // that is not a String is not read -- its to_s comes after. ⚠ Nothing
    // may be added between the parentheses: a "\n" there moved the line an
    // eval inside the piece reports, test_literal's duplicated key.)
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      let j = interp_close lit (i + 2) 1 in
      let code = substring lit (i + 2) (j - 1) in
      (if rx_code_blank code 0 then substring lit i j
       else "#\{(" ++ code ++ ").__rx_frag}") ++ rx_escape_dq lit j
    else if str_eq c "\"" then "\\\"" ++ rx_escape_dq lit (i + 1)
    else if str_eq c "\\" && i + 1 < str_len lit then
      // keep regex escapes as-is through the string lexer: the backslash is
      // doubled, and so is what follows it when THAT is a backslash (or a
      // quote) -- `\\` in a pattern is a literal backslash and has to survive
      // as two characters, not one.
      // An escaped `#` (`\#{x}`, `\#@a`) is one more: the string lexer reads
      // `\\` as the backslash and `\#` as a `#` that starts nothing, so the
      // interpolation it would have started stays text, as ruby keeps it.
      (let nx = char_at lit (i + 1) in
       "\\\\" ++ (if str_eq nx "\\" then "\\\\" else if str_eq nx "\"" then "\\\"" else if str_eq nx "#" then "\\#" else nx)
       ++ rx_escape_dq lit (i + 2))
    else c ++ rx_escape_dq lit (i + 1)

// nothing but spaces and newlines: `#{}` stays as it is (`(\n)` does not parse)
and rx_code_blank = fn (code: str) -> fn (i: int) ->
  if i >= str_len code then true
  else (let c = char_at code i in
        (str_eq c " " || str_eq c "\n" || str_eq c "\t") && rx_code_blank code (i + 1))

// ...and the same rebuild for a %Q STRING, where a backslash escape must be
// PROCESSED rather than preserved: rx_escape_dq doubles it so the pattern
// keeps it (`%r?\??` is the regex /\?/), which is right for a regex and wrong
// for a string -- `%Q{a#{x}b\nc}` came out with a literal backslash-n while
// the same body without interpolation (and a plain "..." string) gave a
// newline. One builder, two languages.
and sq_interp_src = fn (lit: str) ->
  "\"" ++ sq_escape_dq lit 0 ++ "\""

and sq_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      (let j = interp_close lit (i + 2) 1 in
       substring lit i j ++ sq_escape_dq lit j)
    else if str_eq c "\"" then "\\\"" ++ sq_escape_dq lit (i + 1)
    // a backslash escape is handed to the string lexer AS IT IS, so the lexer
    // resolves it exactly as it would inside "..." .
    else if str_eq c "\\" && i + 1 < str_len lit then
      substring lit i (i + 2) ++ sq_escape_dq lit (i + 2)
    else c ++ sq_escape_dq lit (i + 1)

// index just past the `}` closing an interpolation (brace depth counting).
and interp_close = fn (lit: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len lit then i
  else if str_eq (char_at lit i) "\{" then interp_close lit (i + 1) (depth + 1)
  else if str_eq (char_at lit i) "}" then
    (if depth == 1 then i + 1 else interp_close lit (i + 1) (depth - 1))
  else interp_close lit (i + 1) depth

// `?x` at s[i]: a character literal, or the "?" of a ternary? Whitespace after
// the "?" is always a ternary. A word character starts a literal only when
// nothing identifier-ish follows, so `cond ?abc : def` stays a ternary while
// `p ?a` is the one-character string. Any OTHER character (`?/`, `?,`, `?"`)
// starts a literal only where a value could start — the same test the lexer
// uses to tell a regex from a division — so `x > 3 ?"big":"small"` is still a
// ternary. `p ?/` needs the parens Ruby would want anyway: without a local
// variable table there is nothing here to tell a method call from a value.
and is_char_lit = fn (s: str) -> fn (i: int) ->
  let n = char_at s (i + 1) in
  // after a LOCAL the `?` is always the ternary's (`x ?1:2`)
  if lvt_prev_local s i then false
  // (vertical tab and form feed are blanks too: `?\v` is "unexpected '?'")
  else if str_eq n " " || str_eq n "\n" || str_eq n "\t" || str_eq n "\r" || ord n == 11 || ord n == 12 then false
  else if str_eq n "\\" then true
  // a non-ASCII character is an identifier character to ruby, so it follows
  // the word rule below, looking past the whole character
  else if ord n >= 192 || (ord n >= 128 && (if lex_src_is_utf8 () then false else true)) then
    (let j = i + 1 + lex_src_cw s (i + 1) in
     if j >= str_len s then true
     else let n2 = char_at s j in
          if is_alnum n2 || str_eq n2 "_" || ord n2 >= 128 then false else true)
  else if is_alnum n || str_eq n "_" then
    (if i + 2 >= str_len s then true
     else let n2 = char_at s (i + 2) in
          if is_alnum n2 || str_eq n2 "_" then false else true)
  else regex_position s i

// does the line holding i start with `undef ` (its comma list is names)?
and undef_line_at = fn (s: str) -> fn (i: int) ->
  let rec bol = fn (k: int) -> (if k <= 0 then 0 else if str_eq (char_at s (k - 1)) "\n" then k else bol (k - 1)) in
  let b9 = lvt_skip_ws s (bol i) in
  b9 + 6 <= i && str_eq (substring s b9 (b9 + 6)) "undef "
// is the / at i in a value position (a regex) rather than a division?
and regex_position = fn (s: str) -> fn (i: int) ->
  let p = prev_nonspace s (i - 1) in
  if p < 0 then true
  // (in `undef a, /` the names are method names, operators among them: the
  //  `/` after the comma names Integer#/ -- it opened a regexp)
  else if str_eq (char_at s p) "," && undef_line_at s i then false
  else
    let c = char_at s p in
    if str_eq c "(" || str_eq c "," || str_eq c "=" || str_eq c "~" ||
       // after a binary operator a VALUE follows: `src + <<"SRC"` (mkmf's
       // macro_defined?) is a heredoc and `a * /x/` could only be a regexp.
       str_eq c "+" || str_eq c "-" || str_eq c "*" ||
       str_eq c "!" || str_eq c "|" || str_eq c "&" || str_eq c "\n" || str_eq c ";" ||
       // `=> /re/` in a hash literal, `x > /re/`: ruby reads a regex after `>` too
       str_eq c "<" || str_eq c ">" || str_eq c "[" || str_eq c "\{" ||
       // ternary branches: `c ? /re/ : /re/` — a `/` after `?` or `:` starts a regex.
       str_eq c "?" || str_eq c ":" ||
       // a range bound: `(//..//)` is a Range of two empty regexes, which is
       // how ruby's own specs name the type. It is the RANGE dot that says so
       // -- a single dot is a method call, and `7./(2)` is division.
       (str_eq c "." && p > 0 && str_eq (char_at s (p - 1)) ".") then true
    // the `)` of a def's parameters ends the head; the body starts after it,
    // with a value: `def o.to_regexp() /foo/ end` (test_regexp)
    else if str_eq c ")" then def_params_close s p
    // after a LOCAL, a `/` divides: `c = p / r` with p assigned earlier is a
    // division, where `p /r/` with p the method is a call with a regexp.
    else if is_alpha c && lvt_prev_local s i then false
    else if is_alpha c then
      // after a keyword (when /re/, match =~ style) it's a regex too.
      let w = word_ending_at s p in
      str_eq w "when" || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
      str_eq w "then" || str_eq w "return" || str_eq w "if" || str_eq w "unless" ||
      // every keyword a CONDITION can follow, not just `if` -- rubocop writes
      // `elsif /\A[ \t]+\z/.match?(x)`, and a `/` there is a regex, not a
      // division.
      str_eq w "elsif" || str_eq w "while" || str_eq w "until" || str_eq w "case" ||
      str_eq w "yield" || str_eq w "break" || str_eq w "next" || str_eq w "raise" ||
      str_eq w "puts" || str_eq w "p" ||
      // `in /re/` — a pattern-matching clause takes a regex value pattern.
      str_eq w "in"
    else false

// does the `)` at p close a def's parameter list -- the statement up to its
// `(` is `def NAME` / `def RECV.NAME`, with no other parens on the way?
and def_params_close = fn (s: str) -> fn (p: int) ->
  let lp = dpc_open s (p - 1) in
  lp >= 0 && (let st = dpc_stmt_start s (lp - 1) in
              let k = lvt_skip_sp s st in
              k + 4 <= lp && str_eq (substring s k (k + 4)) "def "
              && (if str_contains (substring s k lp) "(" then false else true))
and dpc_open = fn (s: str) -> fn (j: int) ->
  if j < 0 then 0 - 1
  else (let c = char_at s j in
        if str_eq c "(" then j
        else if str_eq c ")" || str_eq c "\n" then 0 - 1
        else dpc_open s (j - 1))
and dpc_stmt_start = fn (s: str) -> fn (j: int) ->
  if j < 0 then 0
  else (let c = char_at s j in if str_eq c "\n" || str_eq c ";" then j + 1 else dpc_stmt_start s (j - 1))

and word_ending_at = fn (s: str) -> fn (p: int) ->
  let b = word_start s p in
  substring s b (p + 1)

and word_start = fn (s: str) -> fn (p: int) ->
  if p > 0 && (is_alnum (char_at s (p - 1)) || str_eq (char_at s (p - 1)) "_")
  then word_start s (p - 1) else p

// the first index of the identifier that ends at p.
and word_start_at = fn (s: str) -> fn (p: int) ->
  if p <= 0 then 0
  else (let c = char_at s (p - 1) in
        if is_alnum c || str_eq c "_" then word_start_at s (p - 1) else p)

// skip from `=begin` to just past the line holding its `=end` (both at
// column 0, as Ruby requires).
and skip_block_comment = fn (s: str) -> fn (i: int) ->
  let e = block_comment_end s i in
  if e < 0 then (let _ = syn_refuse "embedded document meets end of file" in str_len s) else e
and block_comment_end = fn (s: str) -> fn (i: int) ->
  let ln = bc_line_end s i in
  if ln >= str_len s then 0 - 1
  else if ln + 4 <= str_len s && str_eq (substring s ln (ln + 4)) "=end" then bc_line_end s ln
  else block_comment_end s ln
// the index just past the newline that ends the line starting at i.
and bc_line_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then str_len s
  else if str_eq (char_at s i) "\n" then i + 1
  else bc_line_end s (i + 1)

and prev_nonspace = fn (s: str) -> fn (i: int) ->
  if i < 0 then 0 - 1
  else if str_eq (char_at s i) " " then prev_nonspace s (i - 1)
  else i
// -w: the operator was read as an argument's prefix, not as binary
and amb_prefix_warn = fn (s: str) -> fn (i: int) -> fn (op: str) ->
  if parse_verbose () && (if after_def_name s i || prev_word_kw s i then false else true) then
    warn_note (parse_time_file () ++ ":" ++ str_of_int (nls_before s i 0 1 + lshift_lex ())
               ++ ": warning: ambiguous `" ++ op ++ "` has been interpreted as an argument prefix")
  else ()
// is the word before the space at i a keyword (`def &(n)`, `yield *a`)?
and prev_word_kw = fn (s: str) -> fn (i: int) ->
  let pj = prev_nonspace s (i - 1) in
  pj >= 0 && is_alnum (char_at s pj) && lvt_is_kw (substring s (word_start s pj) (pj + 1))
// is the name before the space at i the one a `def` (or `def recv.`) names?
// (`def puts *a`: a parameter list, no call to be ambiguous about)
and after_def_name = fn (s: str) -> fn (i: int) ->
  let pj = prev_nonspace s (i - 1) in
  if pj < 0 then false
  else
    (let b9 = word_start s (if (str_eq (char_at s pj) "?" || str_eq (char_at s pj) "!" || str_eq (char_at s pj) "=") && pj > 0 then pj - 1 else pj) in
     let b9 = (if b9 >= 2 && str_eq (char_at s (b9 - 1)) "." then word_start s (b9 - 2) else b9) in
     let k9 = prev_nonspace s (b9 - 1) in
     k9 >= 2 && str_eq (substring s (k9 - 2) (k9 + 1)) "def"
     && (if k9 >= 3 then (if is_alnum (char_at s (k9 - 3)) || str_eq (char_at s (k9 - 3)) "_" then false else true) else true))
// ruby's rule for a splat argument of a paren-less call: a space before the
// `*` (or `**`), none after, and a method name before the space (lvt_cmd_arg;
// p / pp / puts / print, which it leaves to their own paths, and the
// keywords yield and super, as well)
and cmd_star = fn (s: str) -> fn (i: int) ->
  let n9 = str_len s in
  let k9 = (if i + 1 < n9 && str_eq (char_at s (i + 1)) "*" then i + 2 else i + 1) in
  k9 < n9
  && (let nc9 = char_at s k9 in
      if str_eq nc9 " " || str_eq nc9 "\t" || str_eq nc9 "\n" || str_eq nc9 "=" || str_eq nc9 "*" || str_eq nc9 ")" || str_eq nc9 "," then false else true)
  && (lvt_cmd_arg s i
      || (i > 1 && str_eq (char_at s (i - 1)) " "
          && (let pj = prev_nonspace s (i - 1) in
              pj >= 0 && is_alpha (char_at s pj)
              && (let b9 = word_start s pj in
                  let w9 = substring s b9 (pj + 1) in
                  (str_eq w9 "p" || str_eq w9 "pp" || str_eq w9 "puts" || str_eq w9 "print" || str_eq w9 "yield" || str_eq w9 "super")
                  && (if b9 > 0 then (let c9 = char_at s (b9 - 1) in if str_eq c9 "." || str_eq c9 ":" || str_eq c9 "@" || str_eq c9 "$" then false else true) else true)
                  && (if lvt_is w9 then false else true)))))
// the token ending at pj is a number or a symbol literal (`1`, `:a`)
and prev_is_lit = fn (s: str) -> fn (pj: int) ->
  pj >= 0 && (is_alnum (char_at s pj) || str_eq (char_at s pj) "_")
  && (let b9 = word_start s pj in
      is_digit (char_at s b9)
      || (b9 >= 1 && str_eq (char_at s (b9 - 1)) ":" && (if b9 >= 2 then (if str_eq (char_at s (b9 - 2)) ":" then false else true) else true)))
// ruby's -w warning for an operator that could be an argument's prefix
// (`puts 1 **0`): space before it, none after, and a local variable or a
// literal before -- where it is read as the binary operator
and bal_warn = fn (s: str) -> fn (i: int) ->
  let c9 = char_at s i in
  let n9 = str_len s in
  if (str_eq c9 "*" || str_eq c9 "&" || str_eq c9 "+" || str_eq c9 "-" || str_eq c9 "/" || str_eq c9 "%" || str_eq c9 "<")
     && i > 0 && str_eq (char_at s (i - 1)) " " && parse_verbose () then
    (let op9 = (if str_eq c9 "*" && i + 1 < n9 && str_eq (char_at s (i + 1)) "*" then "**"
                else if str_eq c9 "<" then (if i + 1 < n9 && str_eq (char_at s (i + 1)) "<" then "<<" else "")
                else c9) in
     let j9 = i + str_len op9 in
     let nx9 = (if j9 < n9 then char_at s j9 else " ") in
     let ok9 = str_len op9 > 0
               && (if str_eq nx9 " " || str_eq nx9 "\t" || str_eq nx9 "\n" || str_eq nx9 "=" then false else true)
               && (if str_eq op9 nx9 || str_eq c9 nx9 then false else true)
               && (if str_eq c9 "-" && str_eq nx9 ">" then false else true)
               && (if str_eq c9 "&" && (str_eq nx9 "." || str_eq nx9 "&") then false else true)
               && (lvt_prev_local s i || prev_is_lit s (prev_nonspace s (i - 1))) in
     if ok9 then
       (let syn9 = (if str_eq op9 "<<" then "here document"
                    else if str_eq op9 "+" || str_eq op9 "-" then "unary operator"
                    else if str_eq op9 "/" then "regexp literal"
                    else if str_eq op9 "%" then "string literal"
                    else "argument prefix") in
        warn_note (parse_time_file () ++ ":" ++ str_of_int (nls_before s i 0 1 + lshift_lex ()) ++ ": warning: '" ++ op9
                   ++ "' after local variable or literal is interpreted as binary operator even though it seems like " ++ syn9))
     else ())
  else ()

and is_lparen = fn (p: str) -> str_eq p "(" || str_eq p " ("
// the tokens AFTER a leading parenthesised group, for a statement-leading name
// that has to know whether its call is being CHAINED. `require_relative(p)` is
// the statement form; `require_relative(p).should == true` is an ordinary
// expression whose value is chained, and reading the second as the first made
// the whole chain the require's argument -- so the file it tried to load was
// named after the method called on the result. Depth-counted, so a nested call
// in the arguments does not end the scan early.
and after_parens = fn toks ->
  match toks with
  | Cons (TP lp, r) -> (if is_lparen lp then after_parens_go r 1 else toks)
  | _ -> toks
and after_parens_go = fn toks -> fn (d: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TEOF, _) -> toks
  | Cons (TP p9, r) ->
    // ⚠ "(s" opens too -- it is the token an interpolating string becomes, and
    //   it is closed by the same ")". Counting only "(" made
    //   `require_relative("#{dir}/f.rb").should` end its scan at the string's
    //   own closer, so the chain after it was never seen.
    (if is_lparen p9 || str_eq p9 "(s" then after_parens_go r (d + 1)
     else if str_eq p9 ")" then (if d <= 1 then r else after_parens_go r (d - 1))
     else after_parens_go r d)
  | Cons (_, r) -> after_parens_go r d
and tok_chains = fn toks ->
  match toks with
  | Cons (TP p9, _) -> str_eq p9 "." || str_eq p9 "&." || str_eq p9 "::" || str_eq p9 "["
  | _ -> false

// scan the regex body to the closing unescaped /, returning the trailing
// flags ("im"...) alongside the body and the resume position.
and scan_regex = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = syn_why_note "unterminated regexp meets end of file" in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated regex" ++ parsing_file ()))) in fail ("mere-ruby: unterminated regex" ++ parsing_file ())))
  else
    let c = char_at s i in
    // `\/` escapes the DELIMITER, and ruby keeps only the slash in the
    // source -- `/a\/b/.source` is "a/b". Every other escape survives whole
    // (the pattern needs it). Getting this wrong shifts every backslash that
    // follows, which is how rubocop-ast's REGEXP pattern came out malformed.
    if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "/" then
      scan_regex s (i + 2) (acc ++ "/")
    else if str_eq c "\\" && i + 1 < str_len s then scan_regex s (i + 2) (acc ++ c ++ char_at s (i + 1))
    // a #{...} interpolation is copied whole — its content may contain `/`
    // (even a nested regex literal, /#{/./}/), which must not close ours.
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      (let close = find_close_brace s (i + 2) 0 in
       scan_regex s (close + 1) (acc ++ substring s i (close + 1)))
    else if str_eq c "/" then
      (let fj = skip_regex_flags s (i + 1) in
       (acc, substring s (i + 1) fj, fj))
    // (a run with none of `\`, `#` and `/` is copied in one piece: one append
    //  per character made a 1.8 MB literal cost 5 GB, test_too_many_range_repeat)
    else (let j = scan_rx_plain_end s (i + 1) in scan_regex s j (acc ++ substring s i j))
and scan_rx_plain_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else (let c = char_at s i in
        if str_eq c "\\" || str_eq c "#" || str_eq c "/" then i else scan_rx_plain_end s (i + 1))

// ⚠ A REGEXP LITERAL'S control and meta escapes are bytes by the time the
//   engine sees them: ruby's lexer writes `\cA`, `\C-a`, `\M-a`, `\c\xFF`,
//   `\M-\C-a` as `\x01`, `\x01`, `\xE1`, `\x9F`, `\x81` (that is what
//   #source shows), and only then is the pattern compiled. Handed on as
//   written, `/\c\xFF/` never matched "\c\xFF" (test_regexp's
//   test_match_control_meta_escape). One escape: (value, next index), or
//   (-1, i) when it is not a control/meta form.
and rx_cm_one = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  if i + 1 >= n || (if str_eq (char_at s i) "\\" then false else true) then (0 - 1, i)
  else
    let c = char_at s (i + 1) in
    if str_eq c "c" then rx_cm_ctrl s (i + 2) i
    else if str_eq c "C" && i + 2 < n && str_eq (char_at s (i + 2)) "-" then rx_cm_ctrl s (i + 3) i
    else if str_eq c "M" && i + 2 < n && str_eq (char_at s (i + 2)) "-" then
      (match rx_cm_atom s (i + 3) with
       | (v, k) -> (if v < 0 then (0 - 1, i) else (rx_cm_or80 v, k)))
    else (0 - 1, i)
and rx_cm_or80 = fn (v: int) -> if v >= 128 then v else v + 128
// ctrl: `?` is DEL, anything else keeps bits 0x9F (ruby's `c & 0x9f`)
and rx_cm_ctrl = fn (s: str) -> fn (j: int) -> fn (i: int) ->
  (match rx_cm_atom s j with
   | (v, k) ->
     if v < 0 then (0 - 1, i)
     else if v == 63 then (127, k)
     else (rx_cm_and9f v, k))
and rx_cm_and9f = fn (v: int) ->
  // v & 0x9f, written with the arithmetic there is: drop bits 0x20 and 0x40
  let b5 = (v / 32) - (v / 64) * 2 in
  let b6 = (v / 64) - (v / 128) * 2 in
  v - b5 * 32 - b6 * 64
// what follows a control/meta prefix: a nested prefix, a \xHH, an escaped
// character, or one plain byte
and rx_cm_atom = fn (s: str) -> fn (j: int) ->
  let n = str_len s in
  if j >= n then (0 - 1, j)
  else if str_eq (char_at s j) "\\" && j + 1 < n then
    (let c = char_at s (j + 1) in
     if str_eq c "c" || ((str_eq c "C" || str_eq c "M") && j + 2 < n && str_eq (char_at s (j + 2)) "-") then rx_cm_one s j
     else if str_eq c "x" && j + 2 < n && rx_cm_hexd (char_at s (j + 2)) >= 0 then
       (if j + 3 < n && rx_cm_hexd (char_at s (j + 3)) >= 0
        then (rx_cm_hexd (char_at s (j + 2)) * 16 + rx_cm_hexd (char_at s (j + 3)), j + 4)
        else (rx_cm_hexd (char_at s (j + 2)), j + 3))
     else if str_eq c "\\" then (92, j + 2)
     // (...and the one-letter escapes read_escaped_byte knows: `\M-\n` is
     //  0x8A, test_regexp's test_unescape)
     else if str_eq c "n" then (10, j + 2) else if str_eq c "t" then (9, j + 2)
     else if str_eq c "r" then (13, j + 2) else if str_eq c "f" then (12, j + 2)
     else if str_eq c "v" then (11, j + 2) else if str_eq c "a" then (7, j + 2)
     else if str_eq c "e" then (27, j + 2)
     else (0 - 1, j))
  else (ord (char_at s j), j + 1)
and rx_cm_hexd = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48 else if o >= 65 && o <= 70 then o - 55 else if o >= 97 && o <= 102 then o - 87 else 0 - 1
// the literal with every control/meta escape written as \xHH (outside an
// interpolation, which is code, and outside a comment: `(?# ...)`, and under
// /x a `#` outside a class to the end of the line -- ruby leaves those alone,
// `# e.g. \M-ca` included, Bug #18294)
and rx_cm_rewrite = fn (s: str) -> fn (xm: bool) ->
  if (if str_contains s "\\c" || str_contains s "\\C-" || str_contains s "\\M-" then false else true) then s
  else
    (let n = str_len s in
     let hx = "0123456789ABCDEF" in
     let upto = fn (i: int) -> fn (c: str) -> (let j = str_find_from s c i in if j < 0 then n else j + 1) in
     let rec go = fn (i: int) -> fn (acc: str) -> fn (incls: bool) ->
       if i >= n then acc
       else if str_eq (char_at s i) "#" && i + 1 < n && str_eq (char_at s (i + 1)) "\{" then
         (let close = find_close_brace s (i + 2) 0 in go (close + 1) (acc ++ substring s i (close + 1)) incls)
       else if str_eq (char_at s i) "\\" && i + 1 < n then
         (match rx_cm_one s i with
          | (v, k) ->
            if v < 0 then go (i + 2) (acc ++ substring s i (i + 2)) incls
            else go k (acc ++ "\\x" ++ char_at hx (v / 16) ++ char_at hx (v - (v / 16) * 16)) incls)
       else if incls then go (i + 1) (acc ++ char_at s i) (if str_eq (char_at s i) "]" then false else true)
       else if str_eq (char_at s i) "[" then go (i + 1) (acc ++ "[") true
       else if str_eq (char_at s i) "(" && i + 2 < n && str_eq (char_at s (i + 1)) "?" && str_eq (char_at s (i + 2)) "#" then
         (let e = upto (i + 3) ")" in go e (acc ++ substring s i e) false)
       else if xm && str_eq (char_at s i) "#" then
         (let e = upto (i + 1) "\n" in go e (acc ++ substring s i e) false)
       else go (i + 1) (acc ++ char_at s i) false in
     go 0 "" false)
// ⚠ A RUN OF \xNN ESCAPES MUST BE WHOLE CHARACTERS of the literal's encoding
//   (/e EUC-JP, /s Windows-31J, /u and no flag UTF-8; /n takes any byte):
//   ruby refuses `/\xc2/e` and `/\xc2#{ }/e` at parse time with "too short
//   escaped multibyte character" -- the half character could only ever match
//   half of one (note 299). Interpolation ends a run, as in ruby.
// what rb_reg_preprocess refuses in ONE piece of an interpolated pattern:
// ruby reads every piece's escapes on its own (rb_reg_preprocess_dregexp),
// so `/#{"\\"}y/` is "too short escape sequence" although the joined text
// `\y` is a fine pattern. "" when the piece is good.
and rx_frag_why = fn (v: str) ->
  let n = str_len v in
  let hx = fn (k: int) -> k < n && is_hex_digit (char_at v k) in
  // (a \u{} list: -1 malformed, -2 a codepoint of 8 or more digits)
  let rec ulist = fn (k: int) -> fn (any: bool) -> fn (cnt: int) ->
    (if k >= n then 0 - 1
     else (let c = char_at v k in
           if str_eq c "}" then (if any then k + 1 else 0 - 1)
           else if str_eq c " " then ulist (k + 1) any 0
           else if is_hex_digit c then (if cnt >= 7 then 0 - 2 else ulist (k + 1) true (cnt + 1))
           else 0 - 1)) in
  let rec go = fn (i: int) ->
    if i >= n then ""
    else if str_eq (char_at v i) "\\" then
      (if i + 1 >= n then "too short escape sequence"
       else (let c = char_at v (i + 1) in
             if str_eq c "x" then (if hx (i + 2) then go (i + 3) else "invalid hex escape")
             else if str_eq c "u" then
               (if i + 2 >= n then "too short escape sequence"
                else if str_eq (char_at v (i + 2)) "\{" then
                  (let k = ulist (i + 3) false 0 in
                   if k == 0 - 2 then "invalid Unicode range" else if k < 0 then "invalid Unicode list" else go k)
                else if hx (i + 2) && hx (i + 3) && hx (i + 4) && hx (i + 5) then go (i + 6)
                else "invalid Unicode escape")
             else if str_eq c "c" || str_eq c "C" || str_eq c "M" then
               (match rx_esc_byte v (i + 1) false false with
                | (w, _, k) -> if str_eq w "" then go k else w)
             else go (i + 2)))
    else go (i + 1) in
  go 0
// ruby's read_escaped_byte from p (just past a backslash) under the \M-
// and \C- prefixes already read: (refusal or "", the byte, next index)
and rx_esc_byte = fn (v: str) -> fn (p: int) -> fn (meta: bool) -> fn (ctl: bool) ->
  let n = str_len v in
  let fin = fn (b: int) ->
    (let b2 = (if ctl then (if b == 63 then 127 else rx_cm_and9f b) else b) in
     if meta then rx_cm_or80 b2 else b2) in
  let isoct = fn (k: int) -> k < n && (let o = ord (char_at v k) in o >= 48 && o <= 55) in
  if p >= n then ("too short escape sequence", 0, p)
  else
    (let c = char_at v p in
     let dash = p + 1 < n && str_eq (char_at v (p + 1)) "-" in
     if str_eq c "M" then
       (if meta then ("duplicate meta escape", 0, p)
        else if dash then rx_esc_after v (p + 2) true ctl
        else ("too short meta escape", 0, p))
     else if str_eq c "C" then
       (if ctl then ("duplicate control escape", 0, p)
        else if dash then rx_esc_after v (p + 2) meta true
        else ("too short control escape", 0, p))
     else if str_eq c "c" then
       (if ctl then ("duplicate control escape", 0, p) else rx_esc_after v (p + 1) meta true)
     else if str_eq c "n" then ("", fin 10, p + 1) else if str_eq c "t" then ("", fin 9, p + 1)
     else if str_eq c "r" then ("", fin 13, p + 1) else if str_eq c "f" then ("", fin 12, p + 1)
     else if str_eq c "v" then ("", fin 11, p + 1) else if str_eq c "a" then ("", fin 7, p + 1)
     else if str_eq c "e" then ("", fin 27, p + 1) else if str_eq c "\\" then ("", fin 92, p + 1)
     else if isoct p then
       (let k2 = (if isoct (p + 1) then (if isoct (p + 2) then p + 3 else p + 2) else p + 1) in
        let rec ov = fn (k: int) -> fn (acc: int) -> (if k >= k2 then acc else ov (k + 1) (acc * 8 + ord (char_at v k) - 48)) in
        let o = ov p 0 in
        if o > 255 then ("invalid escape code", 0, k2) else ("", fin o, k2))
     else if str_eq c "x" then
       (if p + 1 < n && is_hex_digit (char_at v (p + 1)) then
          (if p + 2 < n && is_hex_digit (char_at v (p + 2))
           then ("", fin (hex_val (char_at v (p + 1)) * 16 + hex_val (char_at v (p + 2))), p + 3)
           else ("", fin (hex_val (char_at v (p + 1))), p + 2))
        else ("invalid hex escape", 0, p))
     else ("unexpected escape sequence", 0, p))
// the character a \c, \C- or \M- takes: another escape, or itself
and rx_esc_after = fn (v: str) -> fn (p: int) -> fn (meta: bool) -> fn (ctl: bool) ->
  let n = str_len v in
  if p >= n then ((if ctl then "too short control escape" else "too short meta escape"), 0, p)
  else if str_eq (char_at v p) "\\" then rx_esc_byte v (p + 1) meta ctl
  else
    (let b = ord (char_at v p) in
     let b2 = (if ctl then (if b == 63 then 127 else rx_cm_and9f b) else b) in
     ("", (if meta then rx_cm_or80 b2 else b2), p + 1))
// ...and the escaped bytes in the piece (\xHH, \M-, \C-, \c) must be whole
// characters of the piece's own encoding (`e('\xc2')` then `e('\xa1')` is
// two halves); and outside UTF-8 a \u escape cannot sit beside them or a
// raw non-ASCII byte -- in ruby's words for whichever came first
and rx_frag_mb_why = fn (v: str) -> fn (enc: str) ->
  let n = str_len v in
  let hx = fn (k: int) -> k < n && is_hex_digit (char_at v k) in
  let u8 = str_eq enc "UTF-8" in
  let mix = fn (first: str) -> fn (now: str) ->
    (if u8 then (first, "")
     else if str_eq first "" then (now, "")
     else if str_eq first now then (first, "")
     else if str_eq now "b" then (first, "non ASCII character in UTF-8 regexp")
     else (first, "UTF-8 character in non UTF-8 regexp")) in
  let rec go = fn (i: int) -> fn (run: str) -> fn (first: str) ->
    (let esc9 = (if i + 1 < n && str_eq (char_at v i) "\\" then char_at v (i + 1) else "") in
     if str_eq esc9 "x" && hx (i + 2) && hx (i + 3) then
       (let b = hex_val (char_at v (i + 2)) * 16 + hex_val (char_at v (i + 3)) in
        match (if b >= 128 then mix first "b" else (first, "")) with
        | (f2, w2) -> if str_eq w2 "" then go (i + 4) (run ++ chr b) f2 else w2)
     else if str_eq esc9 "c" || str_eq esc9 "C" || str_eq esc9 "M" then
       (match rx_esc_byte v (i + 1) false false with
        | (w, b, k) ->
          if (if str_eq w "" then false else true) then w
          else (match (if b >= 128 then mix first "b" else (first, "")) with
                | (f2, w2) -> if str_eq w2 "" then go k (run ++ chr b) f2 else w2))
     else
       (let why = (if str_eq run "" then "" else rx_mb_why run enc) in
        if (if str_eq why "" then false else true) then why
        else if i >= n then ""
        else if str_eq esc9 "u" then
          (let big = rx_u_big v (i + 2) in
           match (if big then mix first "u" else (first, "")) with
           | (f2, w2) -> if str_eq w2 "" then go (i + 2) "" f2 else w2)
        else if str_eq (char_at v i) "\\" then go (i + 2) "" first
        else if ord (char_at v i) >= 128 then
          (match mix first "b" with (f2, w2) -> if str_eq w2 "" then go (i + 1) "" f2 else w2)
        else go (i + 1) "" first)) in
  go 0 "" ""
// does the \u escape whose digits start at k name a codepoint past ASCII
// (any of a {} list)?
and rx_u_big = fn (v: str) -> fn (k: int) ->
  let n = str_len v in
  let rec hexrun = fn (j: int) -> fn (acc: int) -> fn (cnt: int) ->
    (if j < n && cnt < 8 && is_hex_digit (char_at v j) then hexrun (j + 1) (acc * 16 + hex_val (char_at v j)) (cnt + 1) else (acc, j, cnt)) in
  let rec lst = fn (j: int) ->
    (if j >= n || str_eq (char_at v j) "}" then false
     else if str_eq (char_at v j) " " then lst (j + 1)
     else (match hexrun j 0 0 with
           | (val, j2, cnt) -> if cnt == 0 then false else if val >= 128 then true else lst j2)) in
  if k < n && str_eq (char_at v k) "\{" then lst (k + 1)
  else (match hexrun k 0 0 with (val, _, cnt) -> cnt >= 4 && (let rec four = fn (j: int) -> fn (acc: int) -> (if j >= k + 4 then acc else four (j + 1) (acc * 16 + hex_val (char_at v j))) in four k 0 >= 128))
// the encoding one piece of a dynamic pattern FIXES, read in its source
// encoding src (rb_reg_preprocess): a raw non-ASCII byte or an escaped one
// fixes src (BINARY for an escaped one in a US-ASCII piece), a \u escape
// past ASCII fixes UTF-8, a \p{} property fixes src; "" when the piece
// fixes nothing
and rx_frag_fixed = fn (v: str) -> fn (src: str) ->
  let n = str_len v in
  let hx = fn (k: int) -> k < n && is_hex_digit (char_at v k) in
  let rec go = fn (i: int) -> fn (fx: str) -> fn (prop: bool) ->
    if i >= n then (if str_eq fx "" && prop then src else fx)
    else if ord (char_at v i) >= 128 then go (i + 1) (if str_eq fx "" then src else fx) prop
    else if str_eq (char_at v i) "\\" && i + 1 < n then
      (let c = char_at v (i + 1) in
       if str_eq c "x" && hx (i + 2) then
         (let b = hex_val (char_at v (i + 2)) * 16 + (if hx (i + 3) then hex_val (char_at v (i + 3)) else 0) in
          let k = (if hx (i + 3) then i + 4 else i + 3) in
          // (in a US-ASCII piece an escaped byte past 0x7f fixes BINARY)
          go k (if b >= 128 && str_eq fx "" then (if str_eq src "US-ASCII" then "ASCII-8BIT" else src) else fx) prop)
       else if str_eq c "u" then
         (let rec cp = fn (k: int) -> fn (acc: int) -> fn (cnt: int) ->
            (if cnt < 6 && hx k then cp (k + 1) (acc * 16 + hex_val (char_at v k)) (cnt + 1) else (acc, k)) in
          let (val, k) = (if i + 2 < n && str_eq (char_at v (i + 2)) "\{" then cp (i + 3) 0 0 else cp (i + 2) 0 2) in
          go k (if val >= 128 && str_eq fx "" then "UTF-8" else fx) prop)
       else if str_eq c "p" || str_eq c "P" then go (i + 2) fx true
       else go (i + 2) fx prop)
    else go (i + 1) fx prop in
  go 0 "" false
// ...and a piece that is a plain string literal is read when the pattern
// is: `/#{"\\"}y/` is a SyntaxError, as ruby compiles that piece in
and rx_static_frags = fn (lit: str) -> fn (i: int) ->
  if i + 1 >= str_len lit then ()
  else if str_eq (char_at lit i) "\\" then rx_static_frags lit (i + 2)
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "\{" then
    (let j = interp_close lit (i + 2) 1 in
     let code = substring lit (i + 2) (j - 1) in
     let _ = (if str_len code >= 2 && str_eq (char_at code 0) "\"" && str_eq (char_at code (str_len code - 1)) "\""
                 && (if str_contains code "#" then false else true) then
                (match lex_go code 0 with
                 | Cons (TStrL v, rest) ->
                   (match drop_eof rest with
                    | Nil -> (let why = rx_frag_why v in if str_eq why "" then () else syn_refuse (why ++ ": /" ++ v ++ "/"))
                    | _ -> ())
                 | _ -> ())
              else ()) in
     rx_static_frags lit j)
  else rx_static_frags lit (i + 1)
// what onigmo's unescape_escaped_nonascii says of a run of \xHH bytes in
// a multibyte encoding, character by character: a lead byte the encoding
// has no use for is "invalid multibyte escape", a character the run ends
// inside of "too short escaped multibyte character". "" when it is whole.
and rx_mb_why = fn (run: str) -> fn (enc: str) ->
  let rec go = fn (p: int) ->
    if p >= str_len run then ""
    else
      (let k = rx_mb_one run p enc in
       if k > 0 then go (p + k)
       else if k == 0 then "invalid multibyte escape"
       else "too short escaped multibyte character") in
  go 0
// one character at p of s in enc: its length, 0 when no character starts
// with that byte or a trail byte is wrong, -1 when s ends inside it
and rx_mb_one = fn (s: str) -> fn (p: int) -> fn (enc: str) ->
  let n = str_len s in
  let b = fn (k: int) -> ord (char_at s k) in
  let sj = str_eq enc "Shift_JIS" || str_eq enc "Windows-31J" in
  let eu = str_eq enc "EUC-JP" in
  let u8 = str_eq enc "UTF-8" in
  let b0 = b p in
  let k = (if b0 < 128 then 1
           else if u8 then (if b0 < 194 || b0 > 244 then 0 else if b0 < 224 then 2 else if b0 < 240 then 3 else 4)
           else if eu then (if b0 == 142 then 2 else if b0 == 143 then 3 else if b0 >= 161 && b0 <= 254 then 2 else 0)
           else if sj then (if (b0 >= 129 && b0 <= 159) || (b0 >= 224 && b0 <= 252) then 2 else if b0 >= 161 && b0 <= 223 then 1 else 0)
           else 1) in
  let trail = fn (x: int) ->
    (if u8 then x >= 128 && x <= 191
     else if eu then x >= 161 && x <= 254
     else if sj then (x >= 64 && x <= 126) || (x >= 128 && x <= 252)
     else true) in
  let rec tr = fn (j: int) ->
    (if j >= k then k
     else if p + j >= n then 0 - 1
     else if trail (b (p + j)) then tr (j + 1)
     else 0) in
  if k == 0 then 0 else tr 1
// a regexp literal's own (unescaped) non-ASCII bytes: an encoding option
// other than the source's is refused when there are any, and they must be
// whole characters of the source's encoding (reg_fragment_setenc and the
// lexer's "invalid multibyte character")
and rx_raw_check = fn (lit: str) -> fn (fl: str) ->
  let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
  let src = (if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" then "UTF-8"
             else if str_eq cd "EUC-JP" || str_eq cd "EUCJP-MS" || str_eq cd "CP51932" then "EUC-JP"
             else if str_eq cd "SHIFT_JIS" then "Shift_JIS"
             else if str_eq cd "WINDOWS-31J" || str_eq cd "CP932" || str_eq cd "SJIS" then "Windows-31J"
             else if str_eq cd "ASCII-8BIT" || str_eq cd "BINARY" then "ASCII-8BIT"
             else "") in
  let n = str_len lit in
  // (the first raw non-ASCII byte, -1 for none; escapes and #{} skipped)
  let rec first_raw = fn (i: int) ->
    if i >= n then 0 - 1
    else if str_eq (char_at lit i) "\\" then first_raw (i + 2)
    else if str_eq (char_at lit i) "#" && i + 1 < n && str_eq (char_at lit (i + 1)) "\{" then first_raw (interp_close lit (i + 2) 1)
    else if ord (char_at lit i) >= 128 then i
    else first_raw (i + 1) in
  let r0 = first_raw 0 in
  if r0 < 0 || str_eq src "" then ()
  else
    (let opt = (if str_contains fl "u" then "u" else if str_contains fl "e" then "e" else if str_contains fl "s" then "s" else if str_contains fl "n" then "n" else "") in
     let oenc = (if str_eq opt "u" then "UTF-8" else if str_eq opt "e" then "EUC-JP" else if str_eq opt "s" then "Windows-31J" else if str_eq opt "n" then "ASCII-8BIT" else src) in
     if (if str_eq oenc src then false else true) then
       syn_refuse ("regexp encoding option '" ++ opt ++ "' differs from source encoding '" ++ src ++ "'")
     else
       (let rec walk = fn (i: int) ->
          (if i >= n then ()
           else if str_eq (char_at lit i) "\\" && i + 1 < n && ord (char_at lit (i + 1)) < 128 then walk (i + 2)
           else if str_eq (char_at lit i) "\\" then walk (i + 1)
           else if str_eq (char_at lit i) "#" && i + 1 < n && str_eq (char_at lit (i + 1)) "\{" then walk (interp_close lit (i + 2) 1)
           else if ord (char_at lit i) < 128 then walk (i + 1)
           else (let k = rx_mb_one lit i src in
                 if k > 0 then walk (i + k)
                 else syn_refuse ("invalid multibyte character: /" ++ rx_raw_show lit 0 ++ "/"))) in
        walk 0))
// the pattern as ruby shows it in that refusal: non-ASCII bytes as \xHH
and rx_u_nonascii = fn (lit: str) -> fn (i: int) ->
  let n = str_len lit in
  if i + 1 >= n then false
  else if str_eq (char_at lit i) "\\" && str_eq (char_at lit (i + 1)) "u" then
    (if i + 2 < n && str_eq (char_at lit (i + 2)) "\{" then
       (let rec cps = fn (k: int) -> fn (cp: int) ->
          (if k >= n || str_eq (char_at lit k) "}" then (cp >= 128, k)
           else if str_eq (char_at lit k) " " then (if cp >= 128 then (true, k) else cps (k + 1) 0)
           else if is_hex_digit (char_at lit k) && cp < 1114112 then cps (k + 1) (cp * 16 + hex_val (char_at lit k))
           else cps (k + 1) cp) in
        let (hit, k9) = cps (i + 3) 0 in
        hit || rx_u_nonascii lit (k9 + 1))
     else if i + 5 < n && is_hex_digit (char_at lit (i + 2)) && is_hex_digit (char_at lit (i + 3))
             && is_hex_digit (char_at lit (i + 4)) && is_hex_digit (char_at lit (i + 5)) then
       hex4 lit (i + 2) >= 128 || rx_u_nonascii lit (i + 6)
     else rx_u_nonascii lit (i + 2))
  else if str_eq (char_at lit i) "\\" then rx_u_nonascii lit (i + 2)
  else rx_u_nonascii lit (i + 1)
and rx_raw_show = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else (let o = ord (char_at lit i) in
        let hd = "0123456789ABCDEF" in
        (if o >= 128 then "\\x" ++ char_at hd (o / 16) ++ char_at hd (o - (o / 16) * 16) else char_at lit i) ++ rx_raw_show lit (i + 1))
and rx_escapes_check = fn (lit: str) -> fn (fl: str) ->
  // (a literal with no flag takes the SOURCE's encoding -- the magic
  //  comment's; a one-byte one, `# encoding: binary` included, takes any byte)
  let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
  let enc = (if str_contains fl "n" then ""
             else if str_contains fl "e" then "EUC-JP"
             else if str_contains fl "s" then "Windows-31J"
             else if str_contains fl "u" then "UTF-8"
             else if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" then "UTF-8"
             else if str_eq cd "EUC-JP" || str_eq cd "EUCJP-MS" || str_eq cd "CP51932" then "EUC-JP"
             else if str_eq cd "SHIFT_JIS" then "Shift_JIS"
             else if str_eq cd "WINDOWS-31J" || str_eq cd "CP932" || str_eq cd "SJIS" then "Windows-31J"
             else "") in
  let n = str_len lit in
  let hx = fn (k: int) -> k < n && (let o = ord (char_at lit k) in (o >= 48 && o <= 57) || (o >= 65 && o <= 70) || (o >= 97 && o <= 102)) in
  let flush = fn (run: str) ->
    (if str_len run == 0 || str_eq enc "" then ()
     else if enc_valid run enc then ()
     else (let why = rx_mb_why run enc in
           syn_refuse ((if str_eq why "" then "too short escaped multibyte character" else why) ++ ": /" ++ rx_esc_show run ++ "/"))) in
  let rec go = fn (i: int) -> fn (run: str) ->
    if i >= n then flush run
    else if str_eq (char_at lit i) "\\" && i + 3 < n + 0 && i + 1 < n && str_eq (char_at lit (i + 1)) "x" && hx (i + 2) && hx (i + 3) then
      go (i + 4) (run ++ chr (hexv (char_at lit (i + 2)) * 16 + hexv (char_at lit (i + 3))))
    else if str_eq (char_at lit i) "\\" && i + 1 < n then (let _ = flush run in go (i + 2) "")
    else (let _ = flush run in go (i + 1) "") in
  // `\u` takes four hex digits or a `{` list, inside a class too, in a
  // source of any encoding (`/[\users]/x` is ruby's SyntaxError, which the
  // class parser let by)
  // (a comment is not looked into: `(?# ...)`, and under /x a `#` outside a
  //  class to the end of the line -- `# e.g. C:\users`)
  let xm = str_contains fl "x" in
  let rec skip_to = fn (i: int) -> fn (c: str) -> (if i >= n || str_eq (char_at lit i) c then i + 1 else skip_to (i + 1) c) in
  let rec uchk = fn (i: int) -> fn (incls: bool) ->
    if i + 1 >= n then ()
    else if str_eq (char_at lit i) "\\" && str_eq (char_at lit (i + 1)) "u"
            && (if i + 2 < n && str_eq (char_at lit (i + 2)) "\{" then false
                else if hx (i + 2) && hx (i + 3) && hx (i + 4) && hx (i + 5) then false else true) then
      syn_refuse "invalid Unicode escape"
    else if str_eq (char_at lit i) "\\" then uchk (i + 2) incls
    else if incls then uchk (i + 1) (if str_eq (char_at lit i) "]" then false else true)
    else if str_eq (char_at lit i) "[" then uchk (i + 1) true
    else if str_eq (char_at lit i) "(" && str_eq (char_at lit (i + 1)) "?" && i + 2 < n && str_eq (char_at lit (i + 2)) "#" then uchk (skip_to (i + 3) ")") false
    else if xm && str_eq (char_at lit i) "#" then uchk (skip_to (i + 1) "\n") false
    else uchk (i + 1) false in
  let _ = uchk 0 false in
  // ...and a non-ASCII codepoint written as \u in a regexp of another
  // encoding (/n, /e, /s) is ruby's "incompatible character encoding"
  // (only a literal with nothing interpolated: `/\u3042#{s}/n` is built at
  //  run time and refused there, a RegexpError)
  let _ = (if (str_contains fl "n" || str_contains fl "e" || str_contains fl "s") && (if str_contains fl "u" then false else true)
              && (if rx_has_interp lit 0 then false else true)
              && rx_u_nonascii lit 0
           then syn_refuse ("incompatible character encoding: /" ++ lit ++ "/") else ()) in
  if str_eq enc "" then () else go 0 ""
and rx_esc_show = fn (run: str) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len run then acc
    else (let o = ord (char_at run i) in
          let hd = "0123456789abcdef" in
          go (i + 1) (acc ++ "\\x" ++ char_at hd (o / 16) ++ char_at hd (o - (o / 16) * 16))) in
  go 0 ""
and skip_regex_flags = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alpha (char_at s i) then
    (let c = char_at s i in
     if str_eq c "i" || str_eq c "m" || str_eq c "x" || str_eq c "o" ||
        str_eq c "u" || str_eq c "n" || str_eq c "s" || str_eq c "e"
     then skip_regex_flags s (i + 1)
     else (let __fm = ("mere-ruby: unknown regexp option - " ++ c) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm))
  else i;

// A WHOLE SOURCE (a file, an eval string, the prelude) is lexed through
// here: it starts from an empty local-variable table, which a sublex (a
// heredoc's line, an interpolation) must not do -- those call lex_go and see
// the locals of the code around them.
// (...and with no method around it: a refusal inside a def -- `def m; class
//  X; end; end` -- leaves by `fail`, past the line that would have put the
//  depth back, and every later source read as a method body)
// lex_src's TConts out of the stream (see tc_st)
let rec tc_rep = fn (k: int) -> fn (t: int) -> fn (pend: int list) ->
  if k <= 0 then pend else tc_rep (k - 1) t (Cons (t, pend));
let rec tc_keep_go = fn (key: str) -> fn (pend: int list) -> fn (i: int) ->
  match pend with
  | Nil -> map_set tc_off (key ++ "#n") i
  | Cons (c, r) -> (let _ = map_set tc_off (key ++ "#" ++ str_of_int i) c in tc_keep_go key r (i + 1));
let tc_keep = fn (key: str) -> fn (t: int) -> fn (pend: int list) ->
  match pend with
  | Nil -> ()
  | _ -> (let _ = map_set tc_off key t in tc_keep_go key pend 0);
let rec tc_strip = fn toks -> fn (t: int) -> fn (pend: int list) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TCont k, r) -> tc_strip r t (tc_rep k t pend)
  | Cons (TNL o, r) -> (let _ = tc_keep (str_of_int o) t pend in Cons (TNL o, tc_strip r 0 Nil))
  | Cons (TEOF, r) -> (let _ = tc_keep "eof" t pend in Cons (TEOF, tc_strip r 0 Nil))
  | Cons (x, r) -> Cons (x, tc_strip r (t + 1) pend);
// CRLF line ends read as LF, as ruby's lexer reads them: a string or heredoc
// that spans one holds "\n" (a lone CR stays). Applied where the source enters
// the lexer and where its newlines are counted (number_nls), so the offsets
// agree; a source with no CRLF is passed through untouched.
let crlf_norm = fn (s: str) ->
  if str_contains s "\r\n" then
    (let b9 = strbuf_new () in
     let n9 = str_len s in
     let rec go = fn (i: int) -> fn (from: int) ->
       (if i + 1 >= n9 then strbuf_push b9 (substring s from n9)
        else if str_eq (char_at s i) "\r" && str_eq (char_at s (i + 1)) "\n"
        then (let _ = strbuf_push b9 (substring s from i) in go (i + 1) (i + 1))
        else go (i + 1) from) in
     let _ = go 0 0 in
     strbuf_to_str b9)
  else s;
let lex_src = fn (s0: str) -> let s = crlf_norm s0 in let _ = map_delete scv_mode "m" in let _ = map_set def_depth "n" 0 in let _ = map_delete syn_why "pk" in let _ = map_set stmt_nest "d" 0 in let _ = map_delete cond_quiet "q" in let _ = map_set afr_n "n" 0 in let _ = lvt_reset () in let _ = hd_reset () in let _ = map_set lex_end 0 (0 - 1) in
  let _ = map_set tc_st "on" 1 in let _ = map_set tc_st "len" (str_len s) in let _ = map_set tc_st "prev" 0 in
  let _ = map_clear tc_off in
  let toks = lex_go s 0 in
  let _ = map_set tc_st "on" 0 in
  tc_strip toks 0 Nil;

// ---- parser (precedence climbing) ---------------------------------------
let is_keyword = fn (id: str) ->
  str_eq id "puts" || str_eq id "if" || str_eq id "unless" ||
  str_eq id "elsif" || str_eq id "else" || str_eq id "end" ||
  str_eq id "while" || str_eq id "until" || str_eq id "case" ||
  str_eq id "when" || str_eq id "then" || str_eq id "do" ||
  str_eq id "def" || str_eq id "return" || str_eq id "class" ||
  str_eq id "module" ||
  str_eq id "self" || str_eq id "yield" ||
  str_eq id "begin" || str_eq id "rescue" || str_eq id "ensure" ||
  str_eq id "raise" || str_eq id "break" || str_eq id "next" ||
  str_eq id "true" || str_eq id "false" || str_eq id "nil";

// a capitalized bare identifier is a constant (a class reference here).
let is_cap = fn (id: str) -> is_upper_first id;

// an @-prefixed identifier is an instance variable.
let is_ivar = fn (id: str) -> str_len id > 0 && str_eq (char_at id 0) "@";

// keywords that close (or continue) an enclosing block: statement lists
// stop before them without consuming.
let is_block_stop = fn (id: str) ->
  str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
  str_eq id "rescue" || str_eq id "ensure" ||
  // `in` starts the next clause of a case/in; it never begins a statement.
  str_eq id "in";

// keywords that end an optional value (for break/next/return): block
// closers plus trailing statement modifiers (`next if c`, `break unless c`).
let stops_value = fn (id: str) ->
  is_block_stop id || str_eq id "if" || str_eq id "unless" ||
  str_eq id "while" || str_eq id "until";

// op-assign token -> the base operator (`+=` -> `+`), or "" if not one.
// an attribute-writer method name: ends in '=' but is not ==, !=, <=, >=.
let is_setter_name = fn (name: str) ->
  str_len name > 1 && str_eq (char_at name (str_len name - 1)) "=" &&
  // ...the comparison operators are not writers, `===` included: it was
  // missing here, so `x.===(y)` was an attribute assignment to `x.==` and
  // answered the ARGUMENT (assignment's value) instead of the comparison.
  // Every `===` in ruby/spec's method form went that way.
  (if (str_len name == 2 && str_eq name "==") || (str_len name == 3 && str_eq name "===") || (str_len name == 2 && str_eq name "!=") || (str_len name == 2 && str_eq name "<=") || (str_len name == 2 && str_eq name ">=") then false else true);

let opassign_base = fn (p: str) ->
  if str_eq p "+=" then "+" else if str_eq p "-=" then "-"
  else if str_eq p "*=" then "*" else if str_eq p "/=" then "/"
  else if str_eq p "%=" then "%" else if str_eq p "**=" then "**"
  else if str_eq p "<<=" then "<<" else if str_eq p ">>=" then ">>"
  else if str_eq p "||=" then "||"
  else if str_eq p "&&=" then "&&"
  else if str_eq p "|=" then "|" else if str_eq p "&=" then "&"
  else if str_eq p "^=" then "^" else "";

// Binary precedence, Ruby's order (subset). 0 = not a binary operator.
// ** is handled separately (tighter than unary minus on its left, so
// -2**2 == -(2**2) == -4, and right-associative: 2**3**2 == 512).
// binary operator precedence (higher binds tighter), matching Ruby:
// || < && < equality < comparison < | ^ < & < shift < +- < */% < **
let prec_of = fn (op: str) ->
  if str_eq op "||" then 1
  else if str_eq op "&&" then 2
  else if str_eq op "==" || str_eq op "!=" || str_eq op "<=>" || str_eq op "===" then 3
  else if str_eq op "=~" || str_eq op "!~" then 3
  else if str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=" then 4
  else if str_eq op "|" || str_eq op "^" then 5
  else if str_eq op "&" then 6
  else if str_eq op "<<" || str_eq op ">>" then 7
  else if str_eq op "+" || str_eq op "-" then 8
  else if str_eq op "*" || str_eq op "/" || str_eq op "%" then 9
  else if str_eq op "**" then 10
  else 0;

let expect = fn toks -> fn (want: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p want then r else (let __fm = ("mere-ruby: expected " ++ want ++ ", got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: expected " ++ want ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);

// pure token helpers, defined before the parser group so both the
// expression and statement parsers (one merged group) can use them.
let expect_end = fn toks ->
  match toks with
  | Cons (TNL _, r) -> (let _ = parse_line_add 1 in r)
  | Cons (TEOF, _) -> toks
  // a statement may also be terminated by a block-closing keyword on the
  // same line (e.g. `def m() 1 end`), left unconsumed for the caller.
  | Cons (TId id, _) ->
    if str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
       str_eq id "rescue" || str_eq id "ensure"
    then toks else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected end of statement" ++ parsing_file ()))) in fail ("mere-ruby: expected end of statement" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected end of statement" ++ parsing_file ()))) in fail ("mere-ruby: expected end of statement" ++ parsing_file ()));

let expect_kw = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id kw then r
    else (let __fm = ("mere-ruby: expected " ++ kw ++ ", got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: expected " ++ kw ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);

// optional `then` (after if/elsif/when conditions) or `do` (after
// while/until conditions) before the newline.
let skip_then = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "then" || str_eq id "do" then r else toks
  // `if cond;\n then body` — a `then` after a newline is still redundant.
  | Cons (TNL _, r) ->
    (match r with
     | Cons (TId id, r2) -> if str_eq id "then" then r2 else toks
     | _ -> toks)
  | _ -> toks;

let rec skip_nls = fn toks ->
  match toks with Cons (TNL _, r) -> skip_nls r | _ -> toks;

// the same, reporting how many newlines it passed: the statement loop keeps
// the line counter with this, and no other caller cares.
let rec skip_nls_n = fn toks -> fn (k: int) ->
  match toks with Cons (TNL _, r) -> skip_nls_n r (k + 1) | _ -> (toks, k);

// how many newline tokens this stream holds (once per file, to clamp the
// running count -- never per statement)
// Turn each TNL's byte offset into the 1-based line it ends. One pass: the
// offsets increase along the stream, so the source is scanned once and never
// re-scanned. Everything downstream (`__LINE__`, and the line an error names)
// reads the number rather than counting newlines again, which is what made the
// old count an upper bound -- the parser backtracks, and a re-scanned block body
// was counted twice.
let rec nl_count_to = fn (s: str) -> fn (i: int) -> fn (stop: int) -> fn (acc: int) ->
  if i >= stop || i >= str_len s then acc
  else nl_count_to s (i + 1) stop (if str_eq (char_at s i) "\n" then acc + 1 else acc);
// ...the record of the logical line a mark at offset key ends, now on line
// ln. Two marks on one line (`x = "a\nb"; y`) leave that line without one:
// which logical line a token is on is not known from the number alone.
let tc_number = fn (key: str) -> fn (ln: int) ->
  let lk = str_of_int ln in
  let _ = map_set tc_ln (lk ++ "@") ((if map_has tc_ln (lk ++ "@") then map_get tc_ln (lk ++ "@") else 0) + 1) in
  if map_has tc_off key then
    (let n = map_get tc_off (key ++ "#n") in
     let rec cp = fn (i: int) -> (if i >= n then () else (let _ = map_set tc_ln (lk ++ "#" ++ str_of_int i) (map_get tc_off (key ++ "#" ++ str_of_int i)) in cp (i + 1))) in
     let _ = cp 0 in
     let _ = map_set tc_ln (lk ++ "#n") n in
     map_set tc_ln lk (map_get tc_off key))
  else ();
// the line of a token d tokens before the mark that ends its logical line,
// the mark being on line n
let tc_phys = fn (n: int) -> fn (d: int) ->
  let lk = str_of_int n in
  if map_has tc_ln lk && map_get tc_ln (lk ++ "@") == 1 then
    (let idx = map_get tc_ln lk - d in
     let m = map_get tc_ln (lk ++ "#n") in
     let rec after = fn (i: int) -> fn (acc: int) ->
       (if i >= m then acc else after (i + 1) (if map_get tc_ln (lk ++ "#" ++ str_of_int i) > idx then acc + 1 else acc)) in
     n - after 0 0)
  else n;
let rec number_nls_go = fn (s: str) -> fn toks -> fn (off: int) -> fn (line: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TNL o, r) ->
    // a `;` sits on the line it ends, so counting the newlines between the last
    // mark and this offset is right for both
    let ln = line + nl_count_to s off o 0 in
    let _ = tc_number (str_of_int o) ln in
    Cons (TNL ln, number_nls_go s r (if o > off then o else off) ln)
  | Cons (t, r) -> Cons (t, number_nls_go s r off line);
// `eval(code, binding, file, line)` says the code's FIRST line is `line`, so
// every line in it is `line + k - 1` -- an OFFSET, not a constant. Numbering the
// tokens from that base is the one place the offset belongs: SLine markers are
// emitted by the generic statement-list parser at EVERY nesting depth, so
// shifting them afterwards would mean walking the whole Stmt tree, and shifting
// `cur_pos` at execution time would also shift the lines of code that the eval
// merely CALLS. Numbering at the source makes `__LINE__`, a nested `def`'s
// #source_location, and an error's reported line all absolute for free.
// ⚠ ...and a source that does not END with a newline has no final mark, so
//   every token on its last line reads as line 0 -- `tok_line` walks FORWARD
//   to the next TNL and answers 0 when it reaches the end instead. A FILE
//   almost always ends with a newline and so never showed it; an eval string
//   usually does not, which is why `eval("__LINE__", nil, "f.rb", 7)` was 0
//   and not 7. The mark the source is missing is added here, once, where the
//   base is known -- rather than teaching tok_line's two callers a fallback
//   they have no way to compute.
let rec tnl_before_eof = fn toks -> fn (ln: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TEOF, r) -> Cons (TNL ln, Cons (TEOF, r))
  | Cons (t, r) -> Cons (t, tnl_before_eof r ln);
let number_nls_at = fn (s0: str) -> fn toks -> fn (base: int) ->
  let s = crlf_norm s0 in
  let _ = map_clear tc_ln in
  let numbered = number_nls_go s toks 0 base in
  if str_len s == 0 || str_eq (char_at s (str_len s - 1)) "\n" then numbered
  else (let ln9 = base + nl_count_to s 0 (str_len s) 0 in
        let _ = tc_number "eof" ln9 in
        tnl_before_eof numbered ln9);
let number_nls = fn (s: str) -> fn toks -> number_nls_at s toks 1;
// the line a token sits on: the next newline mark in the stream ends its line
// (less the newlines its logical line passes after it: tc_phys)
let rec tok_line_d = fn toks -> fn (d: int) ->
  match toks with
  | Cons (TNL n, _) -> tc_phys n d
  | Cons (TEOF, _) -> 0
  | Cons (_, r) -> tok_line_d r (d + 1)
  | Nil -> 0;
let tok_line = fn toks -> tok_line_d toks 0;
let rec count_nls = fn toks ->
  match toks with
  | Nil -> 0
  | Cons (TNL _, r) -> 1 + count_nls r
  | Cons (_, r) -> count_nls r;




// A symbol token whose name is not identifier-shaped can only have been
// written in quoted form (`:'"'`), and inside a ternary that is the colon plus
// a string rather than a symbol.
let sym_looks_quoted = fn (sy: str) ->
  if str_len sy == 0 then true
  else (let c = char_at sy 0 in
        if is_alpha c || str_eq c "_" || str_eq c "@" || str_eq c "$" then false else true);

// a range `lo..hi` / `lo...hi` sits above the binary operators (very low
// precedence in Ruby).
// The names a `def` may carry after a dot that the lexer hands back as
// punctuation rather than as an identifier. (is_binary_op_name lives in the
// evaluator's group, which the parser cannot see.)
let def_op_name = fn (s: str) ->
  str_eq s "==" || str_eq s "!=" || str_eq s "===" || str_eq s "=~" || str_eq s "!~" ||
  str_eq s "<=>" || str_eq s "<" || str_eq s "<=" || str_eq s ">" || str_eq s ">=" ||
  str_eq s "+" || str_eq s "-" || str_eq s "*" || str_eq s "/" || str_eq s "%" ||
  str_eq s "**" || str_eq s "<<" || str_eq s ">>" || str_eq s "&" || str_eq s "|" ||
  str_eq s "^" || str_eq s "~" || str_eq s "!" || str_eq s "[]" || str_eq s "[]=" ||
  str_eq s "+@" || str_eq s "-@";

let rec parse_expr = fn toks ->
  let (cond, r) = parse_range toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op "?" then
      let (then_e, r2) = parse_expr (skip_nls rest) in
      // The colon may open the next line: matrix.rb writes
      //   (val.end ? val.end + ...
      //            : count - 1)
      // and a line break before it is not the end of the statement.
      let r2 = (let r2n = skip_nls r2 in
                match r2n with
                | Cons (TP c, _) -> if str_eq c ":" then r2n else r2
                | _ -> r2) in
      // Inside a ternary, a `:` that the lexer read as the start of a QUOTED
      // symbol is the ternary's colon and a string: rexml writes
      // `x.include?('"')?"'":'"'` with no spaces, where `:'"'` is a colon and
      // the one-character string. Ruby resolves it the same way, from context.
      let r2 = (match r2 with
                | Cons (TSym sy, r2b) ->
                  if sym_looks_quoted sy then Cons (TP ":", Cons (TStrL sy, r2b)) else r2
                | _ -> r2) in
      (match r2 with
       | Cons (TP colon, r3) ->
         if str_eq colon ":" then let (else_e, r4) = parse_expr (skip_nls r3) in (ETern (cond_ff cond, then_e, else_e), r4)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected : in ternary" ++ parsing_file ()))) in fail ("mere-ruby: expected : in ternary" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected : in ternary" ++ parsing_file ()))) in fail ("mere-ruby: expected : in ternary" ++ parsing_file ())))
    else (cond, r)
  | _ -> (cond, r)

and list_append_str = fn (xs: str list) -> fn (ys: str list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_str t ys)

and eapp = fn (xs: Expr list) -> fn (ys: Expr list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, eapp t ys)

// bare lambda params: `-> x, y { ... }` (up to the block opener).
// if the LAST default expr is a call that captured a block, strip the
// block off and hand it back (it was really the lambda's body).
and last_default_block = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> (false, (Nil : (str * Expr) list), (Nil : str list), (Nil : Stmt list))
  | Cons ((n, d), Nil) ->
    (match d with
     | ECallB (cn, cargs, cbp, cbb) ->
       (true, Cons ((n, ECall (cn, cargs)), Nil), cbp, cbb)
     | EMethodB (crecv, cn, cargs, cbp, cbb) ->
       (true, Cons ((n, EMethod (crecv, cn, cargs)), Nil), cbp, cbb)
     | _ -> (false, Cons ((n, d), Nil), Nil, Nil))
  | Cons (h, t) ->
    (match last_default_block t with
     | (ok, t2, sbp, sbb) -> (ok, Cons (h, t2), sbp, sbb))

and psplat_any = fn (ps: str list) ->
  match ps with
  | Nil -> false
  | Cons (p, r) -> (str_len p > 0 && str_eq (char_at p 0) "*") || psplat_any r

// the defaults for plain (non-keyword) names; kw defaults are keyed "k:".
// the KEYWORD defaults of a parameter list, keyed by the local name the body
// binds (`x:` binds `x`). A lambda literal built its nil-check prologue from
// plain_defaults only, so `->(x: 3){ x }.call` raised "missing keyword: :x" --
// the default was parsed and then thrown away, and #parameters reported the
// keyword as :keyreq.
and kw_defaults_bare = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> Nil
  | Cons ((n, d), r) ->
    if str_len n > 0 && str_eq (char_at n (str_len n - 1)) ":"
    then Cons ((substring n 0 (str_len n - 1), d), kw_defaults_bare r)
    else kw_defaults_bare r

and plain_defaults = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> Nil
  | Cons ((n, d), r) ->
    if str_len n > 0 && str_eq (char_at n (str_len n - 1)) ":" then plain_defaults r
    else Cons ((n, d), plain_defaults r)

and lambda_bare_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    // `-> a=default { ... }` — an optional bare parameter. The default
    // parses with brace-blocks off: the { belongs to the lambda body.
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let _ = map_set parser_flags "nobrace" VNil in
         let (d, r3) = parse_bin r2 6 in
         let _ = map_delete parser_flags "nobrace" in
         // (`->a=1...{}`: an endless range before the body's brace)
         let (d, r3) = (match r3 with
                        | Cons (TP dd, r3b) when (str_eq dd ".." || str_eq dd "...") && starts_block r3b ->
                          (ERange (d, ENil, str_eq dd "..."), r3b)
                        | _ -> (d, r3)) in
         lambda_bare_after n r3 acc (Cons ((n, d), ds))
       // `-> x: 3 { }` -- a bare KEYWORD parameter, with or without a default.
       // The parenthesised form has read these all along; this one refused the
       // whole file with "expected block".
       else if str_eq eq ":" then
         (let kn = n ++ ":" in
          match r2 with
          | Cons (TP q, _) -> (if str_eq q "," then lambda_bare_after kn r2 acc ds
                               else if starts_block r2 then lambda_bare_after kn r2 acc ds
                               else (let _ = map_set parser_flags "nobrace" VNil in
                                     let (d, r3) = parse_bin r2 6 in
                                     let _ = map_delete parser_flags "nobrace" in
                                     lambda_bare_after kn r3 acc (Cons ((kn, d), ds))))
          | _ -> (let _ = map_set parser_flags "nobrace" VNil in
                  let (d, r3) = parse_bin r2 6 in
                  let _ = map_delete parser_flags "nobrace" in
                  lambda_bare_after kn r3 acc (Cons ((kn, d), ds))))
       else lambda_bare_after n r acc ds
     | _ -> lambda_bare_after n r acc ds)
  // `-> *args, **kwargs { ... }` — splat / kw-splat / block-pass params.
  | Cons (TP st, r) ->
    if str_eq st "*" || str_eq st "**" || str_eq st "&" then
      (match r with
       | Cons (TId n, r2) -> lambda_bare_after (st ++ n) r2 acc ds
       | _ -> lambda_bare_after st r acc ds)
    else (rev_app acc Nil, rev_app ds Nil, toks)
  | _ -> (rev_app acc Nil, rev_app ds Nil, toks)

and lambda_bare_after = fn (n: str) -> fn r -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match r with
  | Cons (TP c, r2) ->
    // (`->a,... {}`: a lambda takes no `...`, without parentheses either)
    if str_eq c "," && (match r2 with Cons (TP d9, _) -> str_eq d9 "..." | _ -> false) then
      (let _ = syn_refuse "unexpected ..." in (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r))
    else if str_eq c "," then lambda_bare_params r2 (Cons (n, acc)) ds
    else (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)

// the inside of ( ... ): an and/or expression, optionally with a trailing
// statement modifier — `(i += 1 until i > 9)` is a while-statement value.
// A leading break/next/return statement (with its modifier) also works:
// `(break 123 until false)`.
// A parenthesised group is a new context for the "nodo" flag, as a def body
// is (see parse_def): the flag stops a COMMAND's argument from taking the
// command's do-block, and inside parens there is no such command. debug's DAP
// server writes `send_response req, breakpoints: (bps.map do |bp| ... end)`,
// and the `do` was refused to `map` and left dangling.
and paren_body = fn toks ->
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let res = paren_body_go toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  // (a regexp in parentheses is no longer the literal `=~` assigns named
  //  captures from: `(/(?<a>.*)/) =~ s` defines no `a`)
  match res with
  | (ERegex (p9, f9), r9) -> (EStmt (SExpr (ERegex (p9, f9))), r9)
  | _ -> res
and paren_body_go = fn toks ->
  match skip_nls toks with
  | Cons (TId w, _) ->
    if str_eq w "break" || str_eq w "next" || str_eq w "return" then
      paren_seq (skip_nls toks) Nil
    // a statement keyword opens a statement sequence: (def f; end; 'f').
    else if str_eq w "def" || str_eq w "class" || str_eq w "module" ||
            str_eq w "begin" || str_eq w "while" || str_eq w "until" ||
            str_eq w "case" then
      paren_seq (skip_nls toks) Nil
    else paren_expr_body (skip_nls toks)
  | _ -> paren_expr_body (skip_nls toks)

and paren_expr_body = fn toks ->
  if looks_like_multix toks then
    let (s2, r2) = parse_multix toks in paren_after_stmt s2 r2
  else if looks_like_multi toks then
    let (s2, r2) = parse_multi toks in paren_after_stmt s2 r2
  else
  let (e, r2) = parse_andor toks in
  match r2 with
  // `(args = 1, 2, 3)` — an assignment's extra comma values build an array.
  | Cons (TP c0, r2b) ->
    if str_eq c0 "=>" then
      let (pat, r3) = parse_pattern_top r2b in (EMatchBind (e, pat), expect (skip_nls r3) ")")
    else if str_eq c0 "," then
      (match e with
       | EAssign (anm, v0) ->
         let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
         (EAssign (anm, EArr (Cons (v0, more))), expect (skip_nls r3) ")")
       // `(a[1, 2] = 4, 5)` / `(o.foo = 1, 2)` — the last setter argument
       // grows into an array of the comma values.
       | EMethod (recv, mn, margs) ->
         if str_eq mn "[]=" || (str_len mn > 0 && str_eq (char_at mn (str_len mn - 1)) "=") then
           let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
           (EMethod (recv, mn, grow_last_arg margs more), expect (skip_nls r3) ")")
         else (e, expect r2 ")")
       | _ -> (e, expect r2 ")"))
    else (e, expect r2 ")")
  | Cons (TId w, rrest) ->
    if str_eq w "in" then
      let (pat, r3) = parse_pattern_top rrest in (EMatchTest (e, pat), expect (skip_nls r3) ")")
    else if str_eq w "while" || str_eq w "until" || str_eq w "if" || str_eq w "unless" || str_eq w "rescue" then
      let (s2, r3) = apply_modifier (SExpr e) r2 in
      (match r3 with
       | Cons (TNL _, _) ->
         // `; more` after the modifier — continue the paren sequence.
         (match skip_nls r3 with
          | Cons (TP rp2, r4) ->
            if str_eq rp2 ")" then (EStmt s2, r4)
            else paren_seq (skip_nls r3) (Cons (s2, Nil))
          | _ -> paren_seq (skip_nls r3) (Cons (s2, Nil)))
       | _ -> (EStmt s2, expect r3 ")"))
    else (e, expect r2 ")")
  // `; more` — the paren holds a statement sequence; its value is the last.
  | Cons (TNL _, _) ->
    (match skip_nls r2 with
     | Cons (TP rp, r3) ->
       if str_eq rp ")" then (e, r3) else paren_seq (skip_nls r2) (Cons (SExpr e, Nil))
     | _ -> paren_seq (skip_nls r2) (Cons (SExpr e, Nil)))
  | _ -> (e, expect r2 ")")

// a multiple assignment inside a paren group: `)` ends it, but a `;` means it
// was only the first statement of a sequence --
// `until (parent, base = File.split(p); parent == p)` in fileutils.
and paren_after_stmt = fn (s1: Stmt) -> fn r1 ->
  // a multiple assignment inside parens takes the modifiers a statement does:
  // racc's grammar file parser loops on `while (sym, idx = enum.next rescue
  // nil)`, and the `rescue` met the closing-paren check instead.
  let (s2, r2) = apply_modifier s1 r1 in
  (match skip_nls r2 with
   | Cons (TP rp, r3) -> if str_eq rp ")" then (EStmt s2, r3) else paren_seq (skip_nls r2) (Cons (s2, Nil))
   | _ -> paren_seq (skip_nls r2) (Cons (s2, Nil)))

and paren_seq = fn toks -> fn (acc: Stmt list) ->
  let (s0, r0) = parse_stmt toks in
  let (s1, r1) = apply_modifier s0 r0 in
  match r1 with
  | Cons (TP rp, r2) ->
    if str_eq rp ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r2)
    else (let __fm = ("mere-ruby: expected ) in paren sequence, got " ++ rp ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TNL _, _) ->
    (match skip_nls r1 with
     | Cons (TP rp2, r3) ->
       if str_eq rp2 ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r3)
       else paren_seq (skip_nls r1) (Cons (s1, acc))
     | _ -> paren_seq (skip_nls r1) (Cons (s1, acc)))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated paren sequence" ++ parsing_file ()))) in fail ("mere-ruby: unterminated paren sequence" ++ parsing_file ()))

// expr [and|or expr]* — the low-precedence word operators (paren context);
// `not expr` negates at the same low precedence.
and parse_andor = fn toks ->
  match toks with
  | Cons (TId w, r) ->
    if str_eq w "not" then let (e, r2) = parse_expr r in parse_andor_more (EUn ("!", e)) r2
    else let (e, r2) = parse_expr toks in parse_andor_more e r2
  | _ -> let (e, r) = parse_expr toks in parse_andor_more e r

and parse_andor_more = fn (lhs: Expr) -> fn toks ->
  match toks with
  // ruby 4.0: `and` / `or` at the start of the next line continues this one
  | Cons (TNL _, _) ->
    (let t2 = skip_nls toks in
     match t2 with
     | Cons (TId w, _) -> if str_eq w "and" || str_eq w "or" then parse_andor_more lhs t2 else (lhs, toks)
     | _ -> (lhs, toks))
  | Cons (TId w, r) ->
    // the right-hand side may continue on the next line (trailing `and` / `or`)
    if str_eq w "and" then let (rhs, r2) = parse_expr (skip_nls r) in parse_andor_more (EBin ("&&", lhs, rhs)) r2
    else if str_eq w "or" then let (rhs, r2) = parse_expr (skip_nls r) in parse_andor_more (EBin ("||", lhs, rhs)) r2
    else (lhs, toks)
  | _ -> (lhs, toks)

and parse_range = fn toks ->
  let (lo, r) = parse_bin toks 1 in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      // endless range: (1..) — no upper bound expression follows. Stops at a
      // closing punctuator, a newline/EOF, or a keyword that begins the next
      // clause (`then`/`do`/`if`/`unless`/`end`/`while`/`until`) — e.g. a
      // `when 90.. then` in a case expression.
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then
           (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       // ...but NOT at the end of a line: ruby reads the bound from the next
       // one (matrix.rb breaks `(lo)..` / `(hi)` across two lines), and only
       // a closing bracket there leaves the range endless -- `[1..` + `]`.
       | Cons (TNL _, _) ->
         let rest2 = skip_nls rest in
         (match rest2 with
          | Cons (TP p3, _) ->
            if str_eq p3 ")" || str_eq p3 "]" || str_eq p3 "}" then (ERange (lo, ENil, excl), rest2)
            else let (hi, r2) = parse_bin rest2 1 in (ERange (lo, hi, excl), r2)
          | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
          // ...nor a keyword that closes the clause: net-imap's sequence set
          // writes `if min == STAR_INT then yield :*..` and `elsif` on the next
          // line, where the range is endless and the `elsif` is the if's.
          | Cons (TId k3, _) ->
            if str_eq k3 "elsif" || str_eq k3 "else" || str_eq k3 "end" || str_eq k3 "when" ||
               str_eq k3 "in" || str_eq k3 "rescue" || str_eq k3 "ensure" || str_eq k3 "then" then
              (ERange (lo, ENil, excl), rest)
            else let (hi, r2) = parse_bin rest2 1 in (ERange (lo, hi, excl), r2)
          | _ -> let (hi, r2) = parse_bin rest2 1 in (ERange (lo, hi, excl), r2))
       | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TId g, _) ->
         if str_eq g "then" || str_eq g "do" || str_eq g "if" || str_eq g "unless" || str_eq g "end" || str_eq g "while" || str_eq g "until"
         then (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

and parse_bin = fn toks -> fn (minp: int) ->
  let (lhs, r) = parse_unary toks in
  parse_more lhs r minp

// the comparison/match operators are non-associative: `a == b == c` is a
// SyntaxError in Ruby (each can appear at most once per sub-expression).
and is_nonassoc_op = fn (op: str) ->
  str_eq op "==" || str_eq op "!=" || str_eq op "===" || str_eq op "<=>" ||
  str_eq op "=~" || str_eq op "!~"

and is_cmp_op = fn (op: str) -> str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">="
and parse_more = fn (lhs: Expr) -> fn toks -> fn (minp: int) ->
  match toks with
  // (a splat mark no command took is the operator it is spelled as)
  | Cons (TP sp9, rest) when str_eq sp9 " *" || str_eq sp9 " **" ->
    parse_more lhs (Cons (TP (substring sp9 1 (str_len sp9)), rest)) minp
  | Cons (TP op, rest) ->
    let p = prec_of op in
    if p > 0 && p >= minp then
      // `0 < x < 2` compares a boolean with 2: ruby says so under -w (said
      // before the right side is read, which may run past a `;` and its line)
      let _ = (if is_cmp_op op && parse_verbose () then
                 (match lhs with
                  | EBin (lop, _, _) ->
                    (if is_cmp_op lop then
                       (let ln9 = tok_line rest in
                        warn_note (parse_time_file () ++ ":" ++ str_of_int (if ln9 > 0 then ln9 else parse_line_now ()) ++ ": warning: comparison '" ++ op ++ "' after comparison"))
                     else ())
                  | _ -> ())
               else ()) in
      // the RHS may continue on the next line (trailing-operator style).
      let (rhs, r2) = parse_bin (skip_nls rest) (p + 1) in
      // reject chaining of a non-associative operator (`a == b == c`).
      let _ = (match r2 with
               | Cons (TP op2, _) -> if is_nonassoc_op op && is_nonassoc_op op2 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: syntax error, non-associative operator")) in fail "mere-ruby: syntax error, non-associative operator") else ()
               | _ -> ()) in
      parse_more (EBin (op, lhs, rhs)) r2 minp
    else (lhs, toks)
  // ruby 4.0: `&&` / `||` at the start of the next line continues this
  // expression. The precedence is checked BEFORE the newlines are consumed, so
  // a tighter level hands the newline back and the level that owns the
  // operator reads it -- `a + b` newline `|| c` is `(a + b) || c`.
  | Cons (TNL _, _) ->
    (let t2 = skip_nls toks in
     match t2 with
     | Cons (TP op, _) ->
       if (str_eq op "&&" || str_eq op "||") && prec_of op >= minp then parse_more lhs t2 minp else (lhs, toks)
     | _ -> (lhs, toks))
  | _ -> (lhs, toks)

and parse_unary = fn toks ->
  match toks with
  | Cons (TP op, rest) ->
    if str_eq op "-" then
      // a minus directly on a numeric literal folds into the literal, so a
      // postfix call sees the negative value: -2.abs == 2 (but ** still
      // binds tighter: -2**2 == -4, which the fold skips).
      (match rest with
       | Cons (TInt n, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EInt (0 - n)) r1)
       | Cons (TFlt f, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          // `0.0 - f` loses the sign of a zero (it is +0.0); multiplying keeps it.
          else neg_lit_tail (EFlt (f * (0.0 - 1.0))) r1)
       | Cons (TBig b, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EBig ("-" ++ b)) r1)
       | Cons (TRat (n, d), r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (ERat ("-" ++ n, d)) r1)
       | Cons (TImag n, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImag (0 - n)) r1)
       | Cons (TImagF f, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImagF (f * (0.0 - 1.0))) r1)
       | Cons (TImagRat (n, d), r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImagRat ("-" ++ n, d)) r1)
       | _ -> let (e, r) = parse_unary rest in (EUn ("-", e), r))
    else if str_eq op "+" then
      // unary + is identity for a numeric literal, but `+str` on a FROZEN
      // string is an unfrozen copy -- which is the whole point of writing it
      // -- so it has to reach String#+@ rather than fold away here.
      // a unary operator at the END of a line takes its operand from the NEXT
      // line, the way a binary one does: `i++` followed by `index` is ruby's
      // `i + (+index)` (ruby has no ++), and it appears in ruby/spec.
      (let rest = skip_nls rest in
       match rest with
       | Cons (TInt _, _) -> parse_unary rest
       | Cons (TFlt _, _) -> parse_unary rest
       | Cons (TBig _, _) -> parse_unary rest
       | Cons (TRat (_, _), _) -> parse_unary rest
       | _ -> let (e, r) = parse_unary rest in (EUn ("+", e), r))
    else if str_eq op "!" then
      let (e, r) = parse_unary rest in (EUn ("!", e), r)
    else if str_eq op "~" then
      let (e, r) = parse_unary rest in (EUn ("~", e), r)
    else parse_pow toks
  | _ -> parse_pow toks

and neg_next_pow = fn toks ->
  match toks with Cons (TP p2, _) -> str_eq p2 "**" | _ -> false
// postfix chain on a folded negative literal, keeping parse_pow's ** tail
// ((-2).abs ** 2 parses like 2 ** 2).
and neg_lit_tail = fn (lit: Expr) -> fn toks ->
  let (b, r) = parse_postfix_more lit toks in
  (match r with
   | Cons (TP p2, rest2) ->
     if str_eq p2 "**" then (let (e, r2) = parse_unary (skip_nls rest2) in (EBin ("**", b, e), r2))
     else (b, r)
   | _ -> (b, r))

and parse_pow = fn toks ->
  let (b, r) = parse_postfix toks in
  match r with
  | Cons (TP op, rest) ->
    // `**` is parsed here rather than in parse_more, so the trailing-operator
    // line continuation parse_more does has to be repeated.
    if str_eq op "**" then
      let (e, r2) = parse_unary (skip_nls rest) in (EBin ("**", b, e), r2)
    else (b, r)
  | _ -> (b, r)

// the line of the statement being parsed (parse_stmts, parse_brace_stmts);
// setting it answers the one it replaces
and pstmt_set = fn (ln: int) ->
  let old = (if map_has parser_flags "pstmt" then (match map_get parser_flags "pstmt" with VInt n -> n | _ -> 0) else 0) in
  let _ = map_set parser_flags "pstmt" (VInt ln) in old
// a receiver whose evaluation may leave the current line elsewhere (a block
// body's, a multi-line literal's) gets `__ln~N`, which sets the line to N
// once the receiver has its value: the call on line N then reports N
and ln_mark = fn (recv: Expr) -> fn (ln: int) ->
  let cur = (if map_has parser_flags "pstmt" then (match map_get parser_flags "pstmt" with VInt n -> n | _ -> 0) else 0) in
  if ln <= 0 || cur <= 0 || ln == cur then recv
  else (match recv with
        | EMethod (_, m9, _) when str_len m9 > 5 && str_eq (substring m9 0 5) "__ln~" -> recv
        | EMethod (_, _, _) -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | EMethodB (_, _, _, _, _) -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | ECall (_, _) -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | ECallB (_, _, _, _) -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | ESafe (_, _, _) -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | ESafeB (_, _, _, _, _) -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | EArr _ -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | EHsh _ -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | EStmt _ -> EMethod (recv, "__ln~" ++ str_of_int ln, Nil)
        | _ -> recv)
// ...and what defined? asks about is the call itself, not the line marks
// (`defined?(a⏎.b)` asked whether `a` had a method `__ln~2`)
and ln_strip = fn (e: Expr) ->
  match e with
  | EMethod (x, m9, Nil) when str_len m9 > 5 && str_eq (substring m9 0 5) "__ln~" -> ln_strip x
  | EMethod (x, m9, a9) -> EMethod (ln_strip x, m9, a9)
  | EMethodB (x, m9, a9, p9, b9) -> EMethodB (ln_strip x, m9, a9, p9, b9)
  | ESafe (x, m9, a9) -> ESafe (ln_strip x, m9, a9)
  | ESafeB (x, m9, a9, p9, b9) -> ESafeB (ln_strip x, m9, a9, p9, b9)
  | _ -> e
// postfix method-call chains: `recv.name`, `recv.name(args)`, and the
// setter form `recv.name = expr` (parsed as a call to `name=`).
and parse_postfix = fn toks ->
  let (e, r) = parse_primary toks in
  parse_postfix_more e r

and parse_postfix_more = fn (recv: Expr) -> fn toks ->
  match toks with
  // a newline followed by .method continues the chain (leading-dot style).
  | Cons (TNL _, _) ->
    let t2 = skip_nls toks in
    (match t2 with
     // ...and so does a newline followed by `&.method`: net-imap's
     // response parser writes `quoted` then `&.gsub!(...)` then
     // `&.force_encoding(...)`, one call per line.
     | Cons (TP dot, _) -> if str_eq dot "." || str_eq dot "&." then parse_postfix_more recv t2 else (recv, toks)
     | _ -> (recv, toks))
  | Cons (TP dot0, r0) ->
    // A space-marked `[` after a COMPLETE expression is an index, not an array
    // literal: `config.for_cop('X') ['Y']` (rubocop) reads the result. The
    // ambiguous case -- a bare name followed by ` [` -- never reaches here; it
    // is settled where the identifier itself is parsed.
    let dot = (if str_eq dot0 " [" then "[" else dot0) in
    let r = (if str_eq dot "." then skip_nls r0 else r0) in   // `x.` + newline continues
    // a call names the line of its method name, as ruby's backtrace does --
    // not its statement's: `end.print do` after a block, `.m` on a line of
    // its own (ln_mark)
    let recv = (if str_eq dot "." || str_eq dot "&." then ln_mark recv (tok_line r) else recv) in
    if str_eq dot "." then
      (match r with
       // `:"#{x}"` lexes as `(s ...).to_sym`, and the literal takes no block:
       // `m :"#{m}" {}` is ruby's "unexpected '{'" (brace_after_lit), where
       // the brace went to to_sym
       | Cons (TId name, r2) when str_eq name "to_sym" && dsym_recv recv
                                  && (match r2 with Cons (TP b9, _) -> str_eq b9 "\{" | _ -> false) ->
         (EMethod (recv, "to_sym", Nil), r2)
       | Cons (TId name, r2) ->
         (match r2 with
          | Cons (TP p, r3) ->
            // `recv.name (expr), more` (space before the paren): the group is
            // the FIRST argument of a paren-less list, so a following comma
            // continues that list and a trailing `.m` binds to the group --
            // `a.insert (i || -1), v` is a two-argument call, not `insert(i)`.
            if str_eq p " (" then
              let (es, r4) = parse_puts_args r2 Nil in
              attach_block_method recv name es r4
            else if is_lparen p then
              let (argv, r4) = parse_call_args r3 in
              attach_block_method recv name argv r4
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // attribute op-assign: recv evaluated exactly once.
            else if not (str_eq (opassign_base p) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ -> attach_block_method recv name Nil r2)
       // `recv.(args)` is shorthand for `recv.call(args)`.
       | Cons (TP lp, r2) ->
         if str_eq lp "(" then let (argv, r3) = parse_call_args r2 in attach_block_method recv "call" argv r3
         // `recv.[](args)` / `recv.[]=(v)` — the bracket method called via dot.
         else if str_eq lp "[" && (match r2 with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
           (match r2 with
            | Cons (_, r3) ->
              (match r3 with
               | Cons (TP op, r4) ->
                 if str_eq op "(" then let (argv, r5) = parse_call_args r4 in attach_block_method recv "[]" argv r5
                 // `recv.[]=(k, v)` passes the setter ALL its arguments, index
                 // and value both; `recv.[]= v` is the one-argument form.
                 else if str_eq op "=" then
                   (match r4 with
                    | Cons (TP lp2, r5) ->
                      // `defined?(Warning.[]=)` (ruby's own test/lib envutil):
                      // the setter NAMED, with nothing after it.
                      if str_eq lp2 ")" then parse_postfix_more (EMethod (recv, "[]=", Nil)) r4
                      // ...and a block may follow it like any call's
                      // (test_optimization: `obj.[]=('', 1){}`)
                      else if str_eq lp2 "(" then
                        (let (argv, r6) = parse_call_args r5 in attach_block_method recv "[]=" argv r6)
                      else (let (rhs, r5b) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5b))
                    | _ -> (let (rhs, r5b) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5b)))
                 // (`foo.[] bar` takes a paren-less argument, as any call)
                 else if starts_bare_arg r3 then attach_block_method recv "[]" Nil r3
                 else parse_postfix_more (EMethod (recv, "[]", Nil)) r3
               | _ -> if starts_bare_arg r3 then attach_block_method recv "[]" Nil r3
                      else parse_postfix_more (EMethod (recv, "[]", Nil)) r3)
            | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r2)
         // `recv.=~(x)` / `recv.+(y)` — explicit operator-method calls.
         // ⚠ THE PAREN-LESS FORM IS THE SAME CALL. `attach_block_method` is the
         // single place that reads a paren-less argument list, a block and a
         // block-pass, and the identifier arm above hands every one of its
         // results to it -- but this twin went straight to parse_postfix_more,
         // so `recv.<< x` parsed as a ZERO-argument `recv.<<()` and the argument
         // was left over as a syntax error with no mention of the operator.
         // ruby/spec writes it as `(s. << 'world')` in StringScanner#<<.
         else if is_op_method_name lp then
           (match r2 with
            | Cons (TP lp2, r3) ->
              if str_eq lp2 "(" then
                let (argv, r4) = parse_call_args r3 in
                attach_block_method recv lp argv r4
              // (`1.+ (x rescue 1)`: a space before the paren makes the
              //  group the first argument, as for a named method above)
              else if str_eq lp2 " (" then
                let (es, r4) = parse_puts_args r2 Nil in
                attach_block_method recv lp es r4
              else attach_block_method recv lp Nil r2
            | _ -> attach_block_method recv lp Nil r2)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after ." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after ." ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after ." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after ." ++ parsing_file ())))
    // index: recv[i] -> recv.[](i); recv[i] = v -> recv.[]=(i, v)
    else if str_eq dot "[" && (match r with Cons (TP rb0, _) -> str_eq rb0 "]" | _ -> false) then
      // empty index `recv[]` (getter) or `recv[] = v` (setter).
      (match r with
       | Cons (_, Cons (TP eq, r0e)) ->
         if str_eq eq "=" then
           let (rhs, r5) = parse_expr (skip_nls r0e) in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5)
         // `recv[] op= v` -> `recv[]= (recv[] op v)`.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r0e) in
           (EIdxOp (recv, Nil, opassign_base eq, rhs), r5)
         else (match r with Cons (_, r0f) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0f | _ -> (recv, toks))
       | Cons (_, r0e) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0e
       | _ -> (recv, toks))
    else if str_eq dot "[" then
      // one or more comma-separated indices (a[i], a[start, len], a[*idx]).
      let (idxs, r3) = parse_x_idx r Nil in
      (match r3 with
       | Cons (TP eq, r4) ->
         let _ = (if str_eq eq "=" || (if str_eq (opassign_base eq) "" then false else true)
                  then idx_asgn_refuse idxs else ()) in
         if str_eq eq "=" then
           let (rhs, r5) =
             (match skip_nls r4 with
              | Cons (TP st2, r4b) ->
                if str_eq st2 "*" then
                  let (inner, r5b) = parse_expr r4b in (EArr (Cons (ESplat inner, Nil)), r5b)
                else parse_expr (skip_nls r4)
              | _ -> parse_expr (skip_nls r4)) in
           (EMethod (recv, "[]=", eapp idxs (Cons (rhs, Nil))), r5)
         // recv[i] op= v desugars through a read-modify-write ([]= of
         // [] op v); ||= and &&= use their short-circuit operators.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r4) in
           (EIdxOp (recv, idxs, opassign_base eq, rhs), r5)
         else parse_postfix_more (EMethod (recv, "[]", idxs)) r3
       | _ -> parse_postfix_more (EMethod (recv, "[]", idxs)) r3)
    // safe navigation: a&.b / a&.b(args) — nil receiver short-circuits.
    else if str_eq dot "&." then
      let (name, r2) = safe_nav_name r in
      (match r2 with
       | Cons (TP p2, r3) ->
            // space-paren: the group is the first of a paren-less argument
            // list, exactly as for `.` above.
            if str_eq p2 " (" then
              let (es, r4) = parse_puts_args r2 Nil in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, es, bp, bb)) r5
              else parse_postfix_more (ESafe (recv, name, es)) r4
            else if str_eq p2 "(" then
              let (argv, r4) = parse_call_args r3 in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, argv, bp, bb)) r5
              else
                // `a&.map(&:to_s)`: a trailing block-PASS is a block too, and
                // safe navigation used to keep it as an argument -- which the
                // dispatcher then read as `map(:to_s)`, i.e. an Enumerator with
                // a stray argument rather than a mapped array. `.map(&:to_s)`
                // went through this same rewrite; only `&.` did not.
                (let (argv2, hasbp, bp2, bb2) = extract_block_pass argv in
                 if hasbp then parse_postfix_more (ESafeB (recv, name, argv2, bp2, bb2)) r4
                 else parse_postfix_more (ESafe (recv, name, argv)) r4)
            else if str_eq p2 "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // safe-navigation op-assign: recv&.attr op= rhs.
            else if not (str_eq (opassign_base p2) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (EBin (opassign_base p2, ESafe (recv, name, Nil), rhs), Nil)), r4)
            else if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in
              parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
            else safe_nav_bare recv name r2
       // `do` is a name token, so a do-block lands here rather than above.
       | _ ->
         if starts_block r2 then
           let (bp, bb, r4) = parse_block r2 in
           parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
         else safe_nav_bare recv name r2)
    // scope resolution: Foo::Bar (nested constant, looked up by bare name)
    // or Foo::meth(...) (module/class method call).
    else if str_eq dot "::" then
      (match r with
       | Cons (TId name, r2) ->
         // A::B is the constant B qualified by A; keep the full name so a
         // namespaced class resolves and reports consistently.
         let mkread = (match recv with
                       | EConst rc -> EConst (rc ++ "::" ++ name)
                       | _ -> EScopedRead (recv, name)) in
         (match r2 with
          | Cons (TP p, r3) ->
            if is_lparen p then let (argv, r4) = parse_call_args r3 in attach_block_method recv name argv r4
            // recv::Const = value : a runtime-receiver constant assignment.
            else if is_cap name && str_eq p "=" then let (v, r4) = parse_expr r3 in (EScopedAssign (recv, name, v), r4)
            // recv::Const op= value -> t = recv; t::Const = t::Const op value,
            // evaluating the receiver expression exactly once (side effects).
            else if is_cap name && (if str_eq (opassign_base p) "" then false else true) then
              let (v, r4) = parse_expr (skip_nls r3) in
              let tmp = fresh_tmp () in
              let base = opassign_base p in
              // `||=` treats an undefined constant as nil (then assigns); other
              // op-assigns read first, so an undefined constant raises NameError.
              let readx = if str_eq base "||" then EScopedReadOrNil (EVar tmp, name) else EScopedRead (EVar tmp, name) in
              // (`||=` and `&&=` assign only when they must, as const_opasgn)
              let asg9 = SExpr (EScopedAssign (EVar tmp, name, v)) in
              let op9 = (if str_eq base "||" then SIf (Cons ((readx, Cons (SExpr readx, Nil)), Nil), Cons (asg9, Nil))
                         else if str_eq base "&&" then SIf (Cons ((readx, Cons (asg9, Nil)), Nil), Cons (SExpr readx, Nil))
                         else SExpr (EScopedAssign (EVar tmp, name, EBin (base, readx, v)))) in
              (EStmt (SBegin (Cons (SAssign (tmp, recv), Cons (op9, Nil)), Nil, Nil, Nil)), r4)
            // `Gem::URI source_uri` -- a method named like a constant, called
            // with a paren-less argument, as `URI source_uri` is at the top
            // (see the is_cap case in parse_primary). A constant takes no
            // argument, so an argument settles it as a call.
            else if is_cap name && starts_bare_arg r2 then attach_block_method recv name Nil r2
            // ...and so does a brace block: `Foo::Bar {}` calls Bar
            else if is_cap name && starts_block r2 && (match r2 with Cons (TP _, _) -> true | _ -> false) then
              attach_block_method recv name Nil r2
            else if is_cap name then parse_postfix_more mkread r2
            // `Recv::name = v` is the setter call `Recv.name = v` -- `::` and
            // `.` are interchangeable for method calls, and concurrent-ruby's
            // tvar.rb writes `Transaction::current = nil`.
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            else if (if str_eq (opassign_base p) "" then false else true) then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ ->
            if is_cap name && starts_bare_arg r2 then attach_block_method recv name Nil r2
            else if is_cap name then parse_postfix_more mkread r2
            else attach_block_method recv name Nil r2)
       // `recv::(args)` is `recv.call(args)`, as `recv.(args)` is
       | Cons (TP lp, r2) when is_lparen lp ->
         (let (argv, r3) = parse_call_args r2 in attach_block_method recv "call" argv r3)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected name after ::" ++ parsing_file ()))) in fail ("mere-ruby: expected name after ::" ++ parsing_file ())))
    else (recv, toks)
  | _ -> (recv, toks)

// `recv&.meth a, b` -- a paren-less argument list after safe navigation, the
// same command form `recv.meth a, b` has. rubygems' package.rb writes
// `@security_policy&.verify_signatures @spec, @digests, @signatures`, and the
// call used to end at the name, leaving `@spec, ...` to fail as a statement.
and safe_nav_bare = fn (recv: Expr) -> fn (name: str) -> fn toks ->
  if starts_bare_arg toks || starts_sp_bracket toks then
    (let had = map_has parser_flags "nodo" in
     let _ = map_set parser_flags "nodo" VNil in
     let (es, r2) = parse_puts_args toks Nil in
     let _ = if had then () else map_delete parser_flags "nodo" in
     let (es2, hasbp, bp0, bb0) = extract_block_pass es in
     if hasbp then parse_postfix_more (ESafeB (recv, name, es2, bp0, bb0)) r2
     else if starts_do_block r2 then
       (let (bp, bb, r3) = parse_block r2 in parse_postfix_more (ESafeB (recv, name, es, bp, bb)) r3)
     else parse_postfix_more (ESafe (recv, name, es)) r2)
  else parse_postfix_more (ESafe (recv, name, Nil)) toks

// a trailing `{ }` / `do end` block turns a method call into EMethodB.
// the method name after `&.`. Usually an ordinary name, but an operator
// method may be written out the same way it can after `.`:
// `mapping&.[](key)`, `x&.+(y)`.
and safe_nav_name = fn toks ->
  match toks with
  | Cons (TId name, r) -> (name, r)
  | Cons (TP lb, r) ->
    if str_eq lb "[" && (match r with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
      (match r with Cons (_, r2) -> ("[]", r2) | _ -> ("[]", r))
    // `blk&.(x)` is `blk&.call(x)`, as `blk.(x)` is `blk.call(x)` (net/ftp's
    // `block&.(data)`); the `(` stays for the argument list.
    else if str_eq lb "(" then ("call", toks)
    else if is_op_method_name lb then (lb, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after &." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after &." ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after &." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after &." ++ parsing_file ()))

and attach_block_method = fn (recv: Expr) -> fn (name: str) -> fn (argv: Expr list) -> fn toks ->
  // paren-less block-pass: `recv.meth &blk` (the " &" token = space-before,
  // no-space-after). Turn the following expr into a block-pass argument.
  let (argv, toks) = (match argv with
    | Nil -> (match toks with
              | Cons (TP amp, r) -> if str_eq amp " &" then (let (be, r1) = parse_expr r in (Cons (EBlockPass be, Nil), r1)) else (argv, toks)
              | _ -> (argv, toks))
    | _ -> (argv, toks)) in
  let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
  if hasbp && starts_block toks then (let _ = syn_refuse "both block arg and actual block given" in (EMethod (recv, name, argv), toks))
  else if hasbp then parse_postfix_more (EMethodB (recv, name, argv2, bp0, bb0)) toks
  else if starts_block toks then
    let (bp, bb, r) = parse_block toks in
    // continue the chain: `arr.map { } .sum` etc.
    parse_postfix_more (EMethodB (recv, name, argv, bp, bb)) r
  // paren-less argument on a dotted call: `x.should be_nil` / `a.push v` /
  // `ScratchPad.record []` (a space before [ means an array argument).
  else if (match argv with Nil -> true | _ -> false) && (starts_bare_arg toks || starts_sp_bracket toks) then
    // suppress do-block attachment while parsing the bare args so a trailing
    // `do...end` binds to this call, not to a bare-identifier argument
    // (`Class.new sc do ... end` = Class.new(sc) { ... }).
    let had = map_has parser_flags "nodo" in
    let _ = map_set parser_flags "nodo" VNil in
    let (es, r2) = parse_puts_args toks Nil in
    let _ = if had then () else map_delete parser_flags "nodo" in
    // `obj.meth :arg do |x| ... end` — a do-block after bare args.
    if starts_do_block r2 then
      let (bp, bb, r3) = parse_block r2 in
      parse_postfix_more (EMethodB (recv, name, es, bp, bb)) r3
    else parse_postfix_more (EMethod (recv, name, es)) r2
  else parse_postfix_more (EMethod (recv, name, argv)) toks

// `name [items]` is an index or a call with an array argument, and eval
// decides -- unless a `do` block follows, which only a CALL can take. Ruby's
// own specs are written that way (`argf [@file1, @file2] do ... end`), and 42
// of the 75 files the parse sweep could not read were this one shape.
and is_binop_tok = fn (p: str) ->
  str_eq p "*" || str_eq p "+" || str_eq p "-" || str_eq p "/" || str_eq p "%" ||
  str_eq p "**" || str_eq p "<<" || str_eq p ">>" || str_eq p "&" || str_eq p "|" ||
  str_eq p "^" || str_eq p "==" || str_eq p "!=" || str_eq p "<" || str_eq p ">" ||
  str_eq p "<=" || str_eq p ">=" || str_eq p "<=>" || str_eq p "===" || str_eq p "=~" ||
  str_eq p "!~" || str_eq p "&&" || str_eq p "||"

and ambig_or_call = fn (id: str) -> fn (ae: Expr) -> fn toks ->
  if starts_do_block toks then
    (let (bp, bb, r) = parse_block toks in (ECallB (id, Cons (ae, Nil), bp, bb), r))
  else
    (match ae with
     | EArr items ->
       // ⚠ A POSTFIX CHAIN after the bracket was left for the caller's own
       //   loop, which then applied it to the WHOLE node: `f [1].size` parsed
       //   as `f([1]).size` where ruby means `f([1].size)`. ruby/spec's Dir
       //   fixture is `mock_dir ['rmdir_dirs'].concat(dirs)`, so every rmdir
       //   path came out as `.../rmdir_dirs["empty"]` -- a directory name with
       //   an inspect form in it -- and five of core/dir/delete_spec's
       //   examples died in `before :each` on a path nobody wrote.
       //
       //   The ambiguity does NOT go away: `x [1].size` is `x[1].size` when x
       //   is a local. The two readings have different SHAPES, so both are
       //   built here (the chain is parsed twice over the same tokens) and the
       //   one to use is chosen at eval, exactly as the chainless case already
       //   chooses. Nothing is re-lexed and neither reading is evaluated.
       if starts_postfix_chain toks then
         // ⚠ The chain is an ARGUMENT, so a `do` after it belongs to the
         //   command, as it does after every other paren-less argument:
         //   `m [1].map do |v| v end` is m([1].map) { }. The chain took the
         //   block for itself (a `do` on its last call), and `m` got none.
         //   Only the call reading parses with "nodo"; the index reading
         //   (`x [1].map do` for a local x is x[1].map { }) keeps the block.
         (let had0 = map_has parser_flags "nodo" in
          let _ = map_set parser_flags "nodo" VNil in
          let (call_arg, r1) = parse_postfix_more (EArr items) toks in
          let _ = if had0 then () else map_delete parser_flags "nodo" in
          if (if had0 then false else starts_do_block r1) then
            (let (bp8, bb8, r8) = parse_block r1 in
             let (idx_form8, _) = parse_postfix_more (EMethod (EVar id, "[]", items)) toks in
             (EAmbigIdxC (id, idx_form8, ECallB (id, Cons (call_arg, Nil), bp8, bb8)), r8))
          else
          // A COMMA after the chain settles it, for the same reason a comma
          // straight after the bracket does (above): an index takes none at
          // this level. `g [1].size, 2` is a two-argument call.
          match r1 with
          | Cons (TP cm9, r1b) ->
            if str_eq cm9 "," then
              (let (es9, r1c) = parse_puts_args (skip_nls r1b) (Cons (call_arg, Nil)) in
               if starts_do_block r1c
               then (let (bp9, bb9, r1d) = parse_block r1c in (ECallB (id, es9, bp9, bb9), r1d))
               else (ECall (id, es9), r1c))
            else
              (let (idx_form, _) = parse_postfix_more (EMethod (EVar id, "[]", items)) toks in
               (EAmbigIdxC (id, idx_form, ECall (id, Cons (call_arg, Nil))), r1))
          | _ ->
            (let (idx_form, _) = parse_postfix_more (EMethod (EVar id, "[]", items)) toks in
             (EAmbigIdxC (id, idx_form, ECall (id, Cons (call_arg, Nil))), r1)))
       else (EAmbigIdx (id, items), toks)
     | other -> (ECall (id, Cons (other, Nil)), toks))

// What parse_postfix_more would consume: a `.`/`&.`/`::` call or an index.
// A ` [` is NOT one -- see parse_postfix_more, which treats it as an index
// after a complete expression, and that is what `f [1] [2]` should mean.
and starts_postfix_chain = fn toks ->
  match toks with
  | Cons (TP d, _) -> str_eq d "." || str_eq d "&." || str_eq d "::" || str_eq d "["
  | _ -> false

and starts_do_block = fn toks ->
  match toks with Cons (TId d, _) -> str_eq d "do" | _ -> false

and starts_sp_bracket = fn toks ->
  match toks with Cons (TP lb, _) -> str_eq lb " [" | _ -> false


and starts_bare_arg = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    // value keywords are arguments (`x.go false`); a def is an expression
    // (`ruby2_keywords def m...`); structural keywords are not arguments.
    if str_eq w "true" || str_eq w "false" || str_eq w "nil" || str_eq w "self" ||
       str_eq w "def" || str_eq w "yield"
       // (and `puts`, a method like any other: `p puts(1)`)
       || str_eq w "puts" then true
    // `say case options[:format] when ... end` (rubygems' specification
    // command) and `x = foo begin ... end`: `case` and `begin` can only OPEN
    // an expression -- neither has a modifier form -- so after a name they
    // are its argument.
    else if str_eq w "case" || str_eq w "begin" then true
    else if is_keyword w || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
       str_eq w "in" || str_eq w "for" then false
    else true
  | Cons (TInt _, _) -> true
  | Cons (TBig _, _) -> true
  | Cons (TRat _, _) -> true
  | Cons (TImag _, _) -> true
  | Cons (TImagF _, _) -> true
  | Cons (TImagRat _, _) -> true
  | Cons (TFlt _, _) -> true
  | Cons (TStrL _, _) -> true
  | Cons (TSym _, _) -> true
  | Cons (TRegex _, _) -> true
  // dq string, unary ~ / !, lambda, or a top-level constant path (` ::Const`).
  // `f !x` can only be a negated argument: a method named f! lexes as one
  // token, and `a ! b` is not Ruby.
  | Cons (TP p, _) -> str_eq p "(s" || str_eq p "~" || str_eq p "!" || str_eq p "->" || str_eq p " ::" || str_eq p " *" || str_eq p " **"
  | _ -> false

// A trailing `&:sym` block-pass arg becomes a real one-param block
// `{ |__bp| __bp.sym }`. Returns (args-without-bp, found?, bparams, bbody).
and extract_block_pass = fn (argv: Expr list) ->
  match rev_app argv Nil with
  | Cons (EBlockPass be, rrest) ->
    (match be with
     | ESym s ->
       // Symbol#to_proc takes the receiver plus ANY further arguments
       // (arity -2), so a two-argument caller works too: `reduce(&:concat)`
       // is `{ |a, *rest| a.concat(*rest) }`, not `{ |a| a.concat }`. It is a
       // LAMBDA, which matters here: a plain 2-param block would auto-splat,
       // so `group_by(&:name)` over array-ish elements would tear them apart
       // instead of passing each one whole as the receiver.
       // (...and a block given to it goes on to the method, as
       //  Symbol#to_proc's does: `b.call(a, &x)` with b from `&:tap`
       //  reaches tap's yield, Bug #13325)
       (rev_app rrest Nil, true,
        Cons (lambda_blk_marker, Cons ("__bp", Cons ("*__ba", Cons ("&__bb", Nil)))),
        Cons (SExpr (EMethod (EVar "__bp", s, Cons (ESplat (EVar "__ba"), Cons (EBlockPass (EVar "__bb"), Nil)))), Nil))
     // general &expr: mark for runtime coercion (Proc/nil/to_proc) at the
     // call site — the "&coerce" param sentinel carries the expr in its body.
     | _ -> (rev_app rrest Nil, true, Cons ("&coerce", Nil), Cons (SExpr be, Nil)))
  | _ -> (argv, false, (Nil : str list), (Nil : Stmt list))

and starts_block = fn toks ->
  match toks with
  | Cons (TP p, _) -> str_eq p "\{" && (if map_has parser_flags "nobrace" then false else true)
  | Cons (TId d, _) -> str_eq d "do" && (if map_has parser_flags "nodo" then false else true)
  | _ -> false

// parse `{ |p,..| stmt }` (single statement) or `do |p,..| stmts end`.
// a `|a=5|` default becomes a prologue statement: the bind sets missing
// args to nil, so a nil param takes its default (explicit nil is rare).
// recover the (name, default) pairs a block encodes as leading nil-check
// prologue statements, so the argument fill can order optionals correctly.
and block_defaults = fn (body: Stmt list) ->
  match body with
  | Cons (SIf (Cons ((cond, Cons (SAssign (n, d), Nil)), Nil), Nil), rest) ->
    (match cond with
     | EMethod (EVar cn, m, Nil) ->
       if str_eq m "nil?" && str_eq cn n then Cons ((n, d), block_defaults rest)
       else Nil
     | _ -> Nil)
  | _ -> Nil

// the body WITHOUT the default-assignment prologue block_defaults reads.
// `define_method` turns a block into a method, and a method binds its own
// defaults: leaving the prologue in as well would rewrite an EXPLICIT nil
// argument to the default, which a method must not do (`m(nil)` is nil).
and drop_defaults_prologue = fn (body: Stmt list) ->
  match body with
  | Cons (SIf (Cons ((cond, Cons (SAssign (n, d), Nil)), Nil), Nil), rest) ->
    (match cond with
     | EMethod (EVar cn, m, Nil) ->
       if str_eq m "nil?" && str_eq cn n then drop_defaults_prologue rest else body
     | _ -> body)
  | _ -> body

and app_ds = fn (a: (str * Expr) list) -> fn (b: (str * Expr) list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, app_ds t b)

and defaults_prologue = fn (ds: (str * Expr) list) -> fn (body: Stmt list) ->
  match ds with
  | Nil -> body
  | Cons ((n, d), rest) ->
    Cons (SIf (Cons ((EMethod (EVar n, "nil?", Nil), Cons (SAssign (n, d), Nil)), Nil), Nil),
          defaults_prologue rest body)

and parse_block = fn toks ->
  // The body of a block is a NEW context for do-blocks. `using Module.new {
  // refine Array do ... end }` parses `using <arg>` as a command call, which
  // sets "nodo" so that a following `do` belongs to `using` and not to
  // `Module.new`. That flag was still set while the brace block's BODY was
  // parsed, so the `do` inside it was refused and three core/module spec
  // files did not parse at all. parse_def already does this for the same
  // reason; a block body needs it for the same reason.
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let r = parse_block_inner toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  r

// ...with the line its `{` or `do` is on in front of the body, as a NEGATIVE
// SLine: a block's (and a lambda's) source_location is that line, not the
// line of the call it hangs off nor its first statement's. The mark runs as
// nothing (no line event, no line change); the readers below skip it.
and parse_block_inner = fn toks ->
  let ol9 = tok_line toks in
  let (bp9, body9, r9) = parse_block_inner0 toks in
  // (after the defaults' nil-check prologue, which the arity and parameter
  //  readers expect at the very front)
  (bp9, (if ol9 > 0 then dflt_prologue_then body9 (SLine (0 - ol9)) else body9), r9)
and parse_block_inner0 = fn toks ->
  match toks with
  | Cons (TP brace, r) ->
    if str_eq brace "\{" then
      let (bp, ds, r2) = parse_block_params_d r in
      let _ = afr_push ("B" ++ anon_flags bp) in
      let (body, r3) = parse_brace_stmts r2 Nil in
      let _ = afr_pop () in
      (bp, defaults_prologue ds body, r3)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))
  | Cons (TId d, r) ->
    if str_eq d "do" then
      let (bp, ds0, r2) = parse_block_params_d r in
      let _ = afr_push ("B" ++ anon_flags bp) in
      let (body0, r3) = parse_stmts r2 Nil in
      let _ = afr_pop () in
      // do-blocks accept trailing rescue/ensure (an implicit begin).
      let (body, r5) =
        (match r3 with
         | Cons (TId k, _) ->
           if str_eq k "rescue" || str_eq k "ensure" then
             let (rescues, ra) = parse_rescues r3 Nil in
             let (els, rb) = parse_opt_kw_block ra "else" in
             let (ens, rc) = parse_opt_kw_block rb "ensure" in
             (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
           else (body0, r3)
         | _ -> (body0, r3)) in
      (bp, defaults_prologue ds0 body, expect_kw r5 "end")
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))

// statements inside a `{ ... }` block, terminated by `}` (consumed).
// ⚠ `{ ... }` and `do ... end` are the same construct and were parsed by two
//   functions, only one of which emitted the SLine markers that tell the
//   interpreter which line is executing. So a warning raised inside a brace
//   block named the line of whatever CALLED the block:
//
//     w { [1,2].any?(Integer) { } }      the warning said line 2 (the `yield`
//                                        inside w), ruby says 4
//     w do ... end                       already right, because do-blocks go
//                                        through parse_stmts
//
//   Same marker, same shape as parse_stmts: it precedes its statement, so the
//   block's VALUE is still the last statement's.
// ...and the FILE marker parse_stmts puts at the head of a body. Without it a
// brace block ran in whatever file its CALLER was executing: yielded from the
// prelude, `tp.enable { line_event = true }` ran "inside" <internal:prelude>
// and its line was not reported.
and brace_file_head = fn (acc: Stmt list) ->
  match acc with
  | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
  | _ -> acc
and parse_brace_stmts = fn toks -> fn (acc: Stmt list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r9) when scv_marker id -> (let _ = scv_set id in parse_brace_stmts r9 acc)
  | Cons (TP p, r) ->
    if str_eq p "}" then (unreach_list (rev_app acc Nil), r)
    else let ln = tok_line t in
         let acc = brace_file_head acc in
         let sv9 = pstmt_set ln in
         let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
         let _ = pstmt_set sv9 in
         let s = scv_stmt s in
         parse_brace_stmts r1 (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))
  | Cons (TEOF, _) -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated block" ++ parsing_file ()))) in fail ("mere-ruby: unterminated block" ++ parsing_file ()))
  | _ ->
    let ln = tok_line t in
    let acc = brace_file_head acc in
    let sv9 = pstmt_set ln in
    let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
    let _ = pstmt_set sv9 in
    let s = scv_stmt s in
    parse_brace_stmts r1 (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))


// like parse_block_params but also returns (name, default-expr) pairs for
// optional params (`|a=5, b=4|`); parse_block turns them into a prologue.
and parse_block_params_d = fn toks ->
  let t = skip_nls toks in
  match t with
  | Cons (TP bar, r) ->
    if str_eq bar "|" then parse_pipe_params r Nil Nil
    else if str_eq bar "||" then (Cons (empty_bp_marker, Nil), (Nil : (str * Expr) list), r)
    else (Nil, Nil, t)
  | _ -> (Nil, Nil, t)

and parse_pipe_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  // `|one; bl|` — names after a semicolon (lexed as TNL) are block-locals:
  // encoded with a ; prefix, they always bind nil. A NEWLINE is no
  // separator at all: `1.times{|\na\n|}` (tnl_semi tells them apart)
  | Cons (TNL _, r) ->
    if tnl_semi toks then parse_block_locals r acc ds
    else (match (acc, skip_nls r) with
          // (`|\n|` is `||`)
          | (Nil, Cons (TP bar9, r9)) when str_eq bar9 "|" -> (Cons (empty_bp_marker, Nil), (Nil : (str * Expr) list), r9)
          | _ -> parse_pipe_params r acc ds)
  | Cons (TP bar, r) ->
    if str_eq bar "|" then (let _ = bp_dup_check acc in (bp_under_dedup (rev_app acc Nil) (map_new ()) 0, rev_app ds Nil, r))
    else if str_eq bar "*" then
      let _ = splat_check acc in
      (match r with Cons (TId n, r2) -> pipe_after ("*" ++ n) r2 acc ds | _ -> pipe_after "*" r acc ds)
    else if str_eq bar "**" then
      // `**kw` — keyword-splat: collects a trailing hash argument (or {}).
      // A bare `**` gets the same hidden name a method parameter does: the
      // binder reads the NAME to decide whether keywords are wanted at all.
      (match r with
       | Cons (TId n, r2) -> (let _ = kwsplat_check ("**" ++ n) acc in pipe_after ("**" ++ n) r2 acc ds)
       | _ -> (let _ = kwsplat_check "**__anonkw" acc in pipe_after "**__anonkw" r acc ds))
    else if str_eq bar "&" then
      (match r with
       // (`|&b?|`: a method name is no parameter)
       | Cons (TId n, r2) when str_len n > 0 && (str_eq (char_at n (str_len n - 1)) "?" || str_eq (char_at n (str_len n - 1)) "!") ->
         (let _ = syn_refuse "expected the block parameters to end with `|`" in (Nil, Nil, r2))
       | Cons (TId n, r2) -> pipe_after ("&" ++ n) r2 acc ds | _ -> pipe_after "&" r acc ds)
    else if str_eq bar "(" then
      // nested destructuring |(a, (b, c))| — encoded as a spec string.
      let (spec, r2) = pipe_group r "" in
      pipe_after ("(" ++ spec ++ ")") r2 acc ds
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
  | Cons (TId name, r) ->
    // (a method name is no keyword parameter: `|arg1?:|`)
    let _ = (match r with
             | Cons (TP c9, _) when str_eq c9 ":" && str_len name > 0
                                  && (str_eq (char_at name (str_len name - 1)) "?" || str_eq (char_at name (str_len name - 1)) "!") ->
               syn_refuse ("identifier " ++ name ++ " is not valid to set")
             | _ -> ()) in
    // `a=default` — an optional parameter; `k:` / `k: default` — keyword.
    (match r with
     // `|b:|` — the lexer reads `:|` as the operator symbol :| — that is a
     // required keyword param immediately before the closing bar.
     | Cons (TSym sy, r2) ->
       if str_eq sy "|" then (rev_app (Cons (name ++ ":", acc)) Nil, rev_app ds Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // parse above `|`'s precedence so the closing bar stays the closer
         let (d, r3) = parse_bin r2 6 in
         pipe_after name r3 acc (Cons ((name, d), ds))
       else if str_eq eq ":" then
         (match r2 with
          | Cons (TP nx, _) ->
            if str_eq nx "," || str_eq nx "|" then pipe_after (name ++ ":") r2 acc ds
            else
              let (d, r3) = parse_bin r2 6 in
              pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds))
          | _ ->
            let (d, r3) = parse_bin r2 6 in
            pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds)))
       else pipe_after name r acc ds
     | _ -> pipe_after name r acc ds)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block parameter" ++ parsing_file ()))) in fail ("mere-ruby: expected block parameter" ++ parsing_file ()))

// tokens of a nested destructure group (after the opening paren) encoded
// back into a compact string: names, commas, splats, nested groups.
and pipe_group = fn toks -> fn (acc: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (acc, r)
    else if is_lparen p || str_eq p " [" then
      let (inner, r2) = pipe_group r "" in pipe_group r2 (acc ++ "(" ++ inner ++ ")")
    else if str_eq p "," then pipe_group r (acc ++ ",")
    else if str_eq p "*" then pipe_group r (acc ++ "*")
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
  | Cons (TId n, r) -> pipe_group r (acc ++ n)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")

// is the TNL at the head of toks a `;` rather than a newline? Both lex as
// TNL and carry a line number: a `;` shares its number with the newline that
// ends its line, while a newline's number is below the next mark's.
and nls_has_semi = fn toks ->
  match toks with
  | Cons (TNL _, r) -> tnl_semi toks || nls_has_semi r
  | _ -> false
and defined_semi = fn (semi: bool) -> fn (e: Expr) ->
  if semi then EDefined (EVar "__defined__expression") else EDefined (ln_strip e)
and tnl_semi = fn toks ->
  match toks with
  | Cons (TNL n, r) -> tok_line r == n
  | _ -> false
and parse_block_locals = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match skip_nls toks with
  // (a block-local is a plain local name: `|; @a|` is ruby's refusal)
  | Cons (TId n, r) when str_len n > 0 && (str_eq (char_at n 0) "@" || str_eq (char_at n 0) "$" || is_cap n) ->
    (let _ = syn_refuse ("invalid formal argument; formal argument cannot be "
                         ++ (if str_len n > 1 && str_eq (substring n 0 2) "@@" then "a class variable"
                             else if str_eq (char_at n 0) "@" then "an instance variable"
                             else if str_eq (char_at n 0) "$" then "a global variable"
                             else "a constant")) in (Nil, Nil, r))
  | Cons (TId n, r) ->
    (match skip_nls r with
     | Cons (TP c, r2) ->
       if str_eq c "," then parse_block_locals r2 (Cons (";" ++ n, acc)) ds
       else if str_eq c "|" then (let _ = bp_dup_check (Cons (";" ++ n, acc)) in (rev_app (Cons (";" ++ n, acc)) Nil, rev_app ds Nil, r2))
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list")
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list"))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list")

and pipe_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `|a,|` — a trailing comma forces destructuring: add an anonymous
      // splat so a single Array/to_ary arg splits (a = first element). The
      // marker "*," (distinct from a real "*") records the trailing comma so a
      // lambda still enforces an exact arity (`->(a,){}` is arity 1, not -2).
      // A newline after the comma continues the list -- `;` and a newline lex
      // alike, and `|a,; b|` is not ruby, so it cannot be the block-locals'
      // semicolon (test_syntax writes `tap do |_,\n  bug = '..',\n  *|`).
      let r = skip_nls r in
      (match r with
       | Cons (TP bar2, _) -> if str_eq bar2 "|" then parse_pipe_params r (Cons ("*,", Cons (name, acc))) ds
                              else parse_pipe_params r (Cons (name, acc)) ds
       | _ -> parse_pipe_params r (Cons (name, acc)) ds)
    else if str_eq p "|" then (let _ = bp_dup_check (Cons (name, acc)) in (bp_under_dedup (rev_app (Cons (name, acc)) Nil) (map_new ()) 0, rev_app ds Nil, r))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or | in block params" ++ parsing_file ()))) in fail ("mere-ruby: expected , or | in block params" ++ parsing_file ()))
  // `|one; bl|` — the ; (lexed as a newline) starts the block-local names
  // (and a real newline is skipped)
  | Cons (TNL _, r) -> if tnl_semi toks then parse_block_locals r (Cons (name, acc)) ds else pipe_after name r acc ds
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated block params" ++ parsing_file ()))) in fail ("mere-ruby: unterminated block params" ++ parsing_file ()))

// fold any string literals immediately following `e` into it (Ruby's
// adjacent-string-literal concatenation).
and lit_u8_tag = fn (e: Expr) ->
  match e with
  | EMethod (_, nm, Nil) when str_eq nm "__lit_enc~UTF-8" -> e
  | _ -> EMethod (e, "__lit_enc~UTF-8", Nil)
and lit_is_u8 = fn (e: Expr) ->
  match e with EMethod (_, nm, Nil) -> str_eq nm "__lit_enc~UTF-8" | _ -> false
and concat_adjacent_strings = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      let (e2, r2) = parse_expr r in
      // ...and one closed by `)u8` (it spelled a non-ASCII \u escape) makes
      // the whole literal UTF-8, as ruby joins them: in a US-ASCII file
      // `('a' "\u3042" 'b')` is one UTF-8 string, and the parser stopped at
      // the `)u8` it did not expect (test_literal)
      (match r2 with
       | Cons (TP ")u8", r3) ->
         (match concat_adjacent_strings (EBin ("+", e, e2)) r3 with
          | (e9, r9) -> (lit_u8_tag e9, r9))
       | _ -> concat_adjacent_strings (EBin ("+", e, e2)) (expect r2 ")"))
    else (e, toks)
  // ⚠ two plain literals are ONE literal, as ruby reads them: `"a" "b"` is
  //   the literal "ab" (chilled, or frozen under the magic comment), not the
  //   computed value "a" + "b" -- which is a new, ordinary String.
  | Cons (TStrL s2, r) ->
    (match e with
     | EStrL s1 -> concat_adjacent_strings (EStrL (s1 ++ s2)) r
     | _ -> concat_adjacent_strings (EBin ("+", e, EStrL s2)) r)
  | _ -> (e, toks)

and parse_primary = fn toks ->
  match toks with
  | Cons (TInt n, r) -> (EInt n, r)
  | Cons (TBig b, r) -> (EBig b, r)
  | Cons (TRat n, r) -> (ERat n, r)
  | Cons (TImag n, r) -> (EImag n, r)
  | Cons (TImagF f, r) -> (EImagF f, r)
  | Cons (TImagRat n, r) -> (EImagRat n, r)
  | Cons (TRegex p, r) ->
    // record the literal for post-parse validation (rx_check_pending): an
    // invalid regex is a parse-time SyntaxError, unsupported ones pass.
    let (rbody, rfl) = p in
    let n = (if map_has rx_pending "n" then (match map_get rx_pending "n" with VInt k -> k | _ -> 0) else 0) in
    let _ = map_set rx_pending ("e" ++ str_of_int n) (mkstr (rfl ++ "\n" ++ rbody)) in
    let _ = map_set rx_pending ("l" ++ str_of_int n) (mkstr (parse_time_file () ++ ":" ++ str_of_int (parse_line_now ()))) in
    let _ = map_set rx_pending "n" (VInt (n + 1)) in
    (rx_src_enc_wrap (ERegex p) rbody rfl, r)
  | Cons (TFlt f, r) -> (EFlt f, r)
  // adjacent string literals concatenate, whichever quoting each one uses:
  // `'a' "b"` and `'a' \<newline> "b"` read the same as `"a" "b"`.
  // A file with a non-UTF-8 magic comment tags its literals AT PARSE TIME
  // (like __ENCODING__): the marker method carries the name, eval sets senc.
  // ...and so does its frozen_string_literal comment (lit_fsl_wrap): frozen
  // or not is a property of the FILE the literal is written in, not of
  // whichever file is loading when a method holding it runs.
  | Cons (TStrL s, r) -> lit_fsl_wrap
    (let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
     if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8"
     then concat_adjacent_strings (EStrL s) r
     else
       (match concat_adjacent_strings (EStrL s) r with
        | (e9, r9) ->
          // in a US-ASCII source, non-ASCII bytes can only have come from
          // \x escapes: raw ones are a ruby SyntaxError there, and a \u
          // escape already went the `)u8` way in the lexer. A \x escape
          // past 0x7f makes the literal BINARY (`# coding: US-ASCII` and
          // `"\x86".encoding`, test_array's pack("b8") checks).
          let rec hasnon7 = fn (e2: Expr) ->
            (match e2 with
             | EStrL t9 -> (if enc_all7 t9 then false else true)
             | EBin (_, a9, b9) -> hasnon7 a9 || hasnon7 b9
             | _ -> false) in
          if lit_is_u8 e9 then (e9, r9)
          else if (str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII") && hasnon7 e9
          then (EMethod (e9, "__lit_enc~ASCII-8BIT", Nil), r9)
          else (EMethod (e9, "__lit_enc~" ++ cd, Nil), r9)))
  // ...and a non-ASCII SYMBOL literal takes the same encoding: under
  // `# encoding: binary`, `:"il_\xC3\xA9tait"` is a BINARY symbol
  | Cons (TSym s, r) -> (sym_src_enc s, r)
  | Cons (TId id, r) ->
    // `and` / `or` cannot START an expression. (Since ruby 4.0 a line that
    // begins with one CONTINUES the statement before it -- apply_modifier and
    // parse_andor_more read that case first -- so what reaches here is an
    // `and` with nothing in front of it: after a `;`, or at the top of a body.)
    // Saying so (instead of reading it as a call to a method named `and`)
    // turns a confusing NoMethodError at run time into a parse error that
    // names the file.
    if str_eq id "and" || str_eq id "or" then
      (let __fm = ("mere-ruby: unexpected keyword: " ++ id) in
       let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
    else if str_eq id "true" then (EBool true, r)
    else if str_eq id "false" then (EBool false, r)
    else if str_eq id "nil" then (ENil, r)
    else if str_eq id "self" then (ESelf, r)
    else if is_ivar id then
      (match r with
       | Cons (TP eq, r2) ->
         if str_eq eq "=" then let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3)
         else if not (str_eq (opassign_base eq) "") then
           let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, EBin (opassign_base eq, EIVar (substring id 1 (str_len id)), e)), r3)
         else (EIVar (substring id 1 (str_len id)), r)
       | _ -> (EIVar (substring id 1 (str_len id)), r))
    // `SP?` / `SP!` (net-imap's response parser): a capitalized name ending
    // in `?` or `!` can only be a METHOD -- no constant is spelled that way --
    // so it is a call with or without arguments, never a constant lookup.
    else if is_cap id && (let lc = char_at id (str_len id - 1) in str_eq lc "?" || str_eq lc "!") then
      (match r with
       | Cons (TP lp, r2) ->
         if str_eq lp "(" then let (argv, r3) = parse_call_args r2 in (ECall (id, argv), r3)
         else if starts_bare_arg r then let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (ECall (id, Nil), r)
       | _ ->
         if starts_bare_arg r then let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (ECall (id, Nil), r))
    else if is_cap id then
      (match r with
       | Cons (TP eq, r2) ->
         // A capitalized name immediately followed by `(` is a METHOD CALL,
         // not a constant — constants can't be "called" with parens in Ruby.
         // This covers the Kernel conversion functions (Integer(x) / Float(x)
         // / Rational(n,d) / Complex(r,i) / Array / String) AND user-defined
         // capitalized methods (`def Rainbow(s)` … `Rainbow("x")`).
         if str_eq eq "(" then
           (let (argv, r3) = parse_call_args r2 in
            match r3 with
            | Cons (TP b9, _) ->
              if str_eq b9 "\{" || str_eq b9 " \{" then (let (bp, bb, r4) = parse_block r3 in (ECallB (id, argv, bp, bb), r4))
              else (ECall (id, argv), r3)
            // ...and a `do` block: `DelegateClass(Array) do ... end`
            | _ -> if starts_block r3 then (let (bp, bb, r4) = parse_block r3 in (ECallB (id, argv, bp, bb), r4))
                   else (ECall (id, argv), r3))
         // ...and so is one followed by a brace BLOCK: `Bar {}` calls Bar
         // with a block (a constant cannot take one), it is not a hash
         else if str_eq eq "\{" || str_eq eq " \{" then
           (let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4))
         else if str_eq eq "=" then let (e, r3) = parse_expr r2 in (EAssign (id, e), r3)
         // A double-quoted string, lambda or unary argument settles it as a
         // call the same way a bare one does below -- `LOG "reading #{len}
         // bytes..."` in net/protocol is a method named LOG. (Only the token
         // KINDS starts_bare_arg accepts; `Foo::Bar`, `Foo[i]` and `Foo.m`
         // are not among them and stay constants.)
         else if str_eq eq " (" || starts_bare_arg r then
           let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (EConst id, r)
       // `Array licenses` / `Integer str` — the paren-less form of the same
       // call. A constant takes no argument, so a bare argument here settles
       // it as a method call. (`Foo::Bar`, `Foo.m` and a plain `Foo` reach
       // this with a token that starts no argument, and stay constants.)
       | _ ->
         if starts_bare_arg r then let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (EConst id, r))
    else if str_eq id "yield" then
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then
           (let (argv, r3) = parse_call_args r2 in
            // (a block is no argument of yield: `yield(...)` is ruby's
            //  "unexpected ...", and `yield(&b)` "block argument should not be given")
            let _ = (if args_have_fwd argv then syn_refuse "unexpected ..."
                     else if args_have_bpass argv then syn_refuse "block argument should not be given" else ()) in
            (EYield argv, r3))
         // `yield [0]` passes an array literal (not an index on the result).
         else if str_eq p "[" || str_eq p " [" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         // A double-quoted string is lexed as `TP "(s"` -- the open of the
         // interpolation desugaring -- and `is_lparen` only knows "(" and " (",
         // so `yield "k", 2` fell into the no-argument case and the statement
         // parser then said "expected end of statement". rubygems' config_file.rb
         // writes `yield "config_file_name", @config_file_name if @config_file_name`.
         //
         // ONLY that token is added. Widening the test to "anything that is not a
         // closer starts an argument" -- the rule `raise` uses -- broke three
         // inputs that had always worked: `cond ? yield : x` (a parse error, then
         // an infinite loop once the colon was half-handled), and `yield + 10`,
         // which ruby reads as `(yield) + 10` and that read as `yield(+10)`.
         // `yield + 10` against `yield +10` is decided by the space AFTER the
         // operator, which the token does not carry, so the operators stay on the
         // no-argument side where they have always been.
         else if str_eq p "(s" || str_eq p " (s" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         // `yield *a, **h` / `yield **h`: a splat first argument (see cmd_star)
         else if str_eq p " *" || str_eq p " **" || str_eq p " &" then
           (let (es, r3) = parse_puts_args r Nil in
            let _ = (if args_have_bpass es then syn_refuse "block argument should not be given" else ()) in
            (EYield es, r3))
         else (EYield Nil, r)
       | Cons (TNL _, _) -> (EYield Nil, r)
       | Cons (TEOF, _) -> (EYield Nil, r)
       // `yield end` / `yield if c` — a stop keyword ends a bare yield.
       | Cons (TId w, _) -> if stops_value w then (EYield Nil, r) else let (es, r2) = parse_puts_args r Nil in (EYield es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (EYield es, r2))
    else if str_eq id "raise" then
      (match r with
       // `raise do end` / `raise {}`: a block, which raise ignores (not a Hash)
       | _ when starts_block r -> (let (_, _, r4) = parse_block r in (ERaise Nil, r4))
       | Cons (TNL _, _) -> (ERaise Nil, r)
       | Cons (TEOF, _) -> (ERaise Nil, r)
       // bare raise before a modifier/terminator keyword takes no args.
       | Cons (TId w, _) ->
         if stops_value w then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | Cons (TP p, _) ->
         // a paren-less argument has to START an expression: a closer or a
         // binary-only operator means this `raise` takes none. i18n writes
         // `raise && :raise` (where `raise` is a keyword PARAMETER, so ruby
         // reads the local), and `[k, raise]` is the same shape.
         if str_eq p ")" || str_eq p "}" || str_eq p ";" || str_eq p "]" ||
            str_eq p "," || str_eq p "&&" || str_eq p "||" || str_eq p "==" ||
            str_eq p "!=" || str_eq p "=>" || str_eq p "?" || str_eq p "." ||
            str_eq p "<" || str_eq p ">" || str_eq p "<=" || str_eq p ">=" ||
            str_eq p "<=>" || str_eq p "=~" ||
            // the `:` of a ternary: typeprof's `s[1..-2] || raise : s`
            str_eq p ":" then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (ERaise es, r2))
    else if str_eq id "super" then
      // `super` forwards the current args; `super(...)` / `super()` are explicit.
      let (zs, argv, r1) =
        (match r with
         | Cons (TP p, r2) ->
           if is_lparen p then let (a, r3) = parse_call_args r2 in (false, a, r3)
           // `super x` / `super "msg", y` — paren-less arguments, like any
           // other command call. Without this the bare form parsed as zsuper
           // and the argument was left dangling. A SPACE-marked `[` is an
           // array argument too (`super [*message, ...].join("\n")`), which is
           // exactly what the lexer marks it for.
           // (`super &b` passes only a block: an explicit empty argument list)
           else if starts_bare_arg r || starts_sp_bracket r || str_eq p " &" then let (a, r3) = parse_puts_args r Nil in (false, a, r3)
           else (true, Nil, r)
         | _ -> if starts_bare_arg r then let (a, r3) = parse_puts_args r Nil in (false, a, r3)
                else (true, Nil, r)) in
      // `super { ... }` / `super do ... end` passes an explicit block.
      if starts_block r1 then
        (let _ = (if args_have_bpass argv then syn_refuse "both block arg and actual block given; only one block is allowed" else ()) in
         let (bp, bb, r4) = parse_block r1 in (ESuperB (zs, argv, bp, bb), r4))
      else (ESuper (zs, argv), r1)
    else if str_eq id "not" then
      // `not(x)` / `not x` — negation; with parens the chain continues
      // on the negated value (not(true).should == ...).
      (match r with
       | Cons (TP lp, _) ->
         if str_eq lp "(" then let (e, r2) = parse_primary r in (EUn ("!", e), r2)
         else let (e, r2) = parse_expr r in (EUn ("!", e), r2)
       | _ -> let (e, r2) = parse_expr r in (EUn ("!", e), r2))
    else if str_eq id "defined?" then
      // defined?(e) or defined? e — never evaluates e for its value.
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then
           // the parens hold statements: `defined? (\n  x\n)` asks about x and
           // `defined? (\n)` about (); a `;` before or after the one
           // statement makes it statements, "expression" (ruby 4.0; 3.4 asked
           // about x)
           let semi9 = nls_has_semi r2 in
           let r2 = skip_nls r2 in
           let empty = (match r2 with Cons (TP rp0, _) -> str_eq rp0 ")" | _ -> false) in
           if empty then (EDefined (EVar "nil"), expect r2 ")") else
           // defined?(x = 2) and friends answer "assignment" unevaluated.
           // `defined?((a, b = 1, 2))` wraps the assignment in ITS OWN parens,
           // so the scan for a top-level `=` found it one level down and the
           // whole thing read as an expression.
           if defined_assignish r2
              || (match r2 with Cons (TP lp2, r6) -> is_lparen lp2 && defined_assignish r6 | _ -> false) then
             let (st, r3) = parse_stmt r2 in (defined_assign_node r2 st, expect r3 ")")
           // defined?(if.../while.../case... end) answers "expression".
           else if defined_compound r2 then
             let (_, r3) = parse_stmt r2 in (EDefined (EVar "__defined__expression"), expect r3 ")")
           else
           // defined?(puts) — a keyword-named method probes as a plain call.
           // parse the inner expression at the lowest precedence so the word
           // operators `and`/`or`/`not` are allowed (`defined?(a and b)`).
           (match r2 with
            | Cons (TId w, Cons (TP rp, r4)) ->
              if str_eq rp ")" then (EDefined (EVar (if semi9 then "__defined__expression" else w)), r4)
              else let (e, r3) = parse_andor r2 in (defined_semi (semi9 || nls_has_semi r3) e, expect (skip_nls r3) ")")
            | _ -> let (e, r3) = parse_andor r2 in (defined_semi (semi9 || nls_has_semi r3) e, expect (skip_nls r3) ")"))
         // `defined? a = 10` (no parens) — an assignment is unevaluated.
         else if defined_assignish r then
           let (st, r3) = parse_stmt r in (defined_assign_node r st, r3)
         else let (e, r3) = parse_unary r in (EDefined (ln_strip e), r3)
       // `defined? a = 10` at statement start (no leading paren token).
       | _ ->
         if defined_assignish r then
           let (st, r3) = parse_stmt r in (defined_assign_node r st, r3)
         else let (e, r3) = parse_unary r in (EDefined (ln_strip e), r3))
    else if str_eq id "break" || str_eq id "next" || str_eq id "return" || str_eq id "redo" || str_eq id "retry" then
      // flow keywords in expression position (ternary branches, call args).
      (match r with
       | Cons (TNL _, _) -> (EFlow (id, ENil), r)
       | Cons (TEOF, _) -> (EFlow (id, ENil), r)
       | Cons (TP p, _) ->
         if str_eq p ")" || str_eq p "}" || str_eq p "]" || str_eq p "," ||
            str_eq p ":" || str_eq p ";" then (EFlow (id, ENil), r)
         else if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | Cons (TId w, _) ->
         if stops_value w || str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | _ ->
         if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2))
    else if str_eq id "if" then
      // statement constructs usable as expressions (call args etc.).
      let (s, r2) = parse_if r false in (EStmt s, r2)
    else if str_eq id "unless" then let (s, r2) = parse_if r true in (EStmt s, r2)
    else if str_eq id "while" then let (s, r2) = parse_while r false in (EStmt s, r2)
    else if str_eq id "until" then let (s, r2) = parse_while r true in (EStmt s, r2)
    else if str_eq id "for" then let (s, r2) = parse_for r in (EStmt s, r2)
    else if str_eq id "case" then let (s, r2) = parse_case r in (EStmt s, r2)
    else if str_eq id "begin" then let (s, r2) = parse_begin r in (EStmt s, r2)
    // def/class in expression position (def evaluates to the method name
    // as a symbol; class to its body's last value).
    else if str_eq id "def" then let (s, r2) = parse_def_counted r in (EStmt s, r2)
    else if str_eq id "class" then let (s, r2) = parse_class r in (EStmt s, r2)
    // `puts` is a statement form here, but in ruby it is a method call like any
    // other and may stand wherever a value can: `def run = puts("hi")`,
    // `x = (puts "q")`, `ok && puts(3)`. Read the statement and let it be the
    // value (nil, as puts answers).
    else if str_eq id "puts" then
      (let (s9, r9) = parse_stmt (Cons (TId id, r)) in (EStmt s9, r9))
    else if is_keyword id then (let __fm = ("mere-ruby: unexpected keyword: " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
    else
      // `name(args)` / `name(args) { block }` / `name { block }` / bare name.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           // assignment as an expression: `true && x = 1` binds rightmost.
           (match r2 with
            | Cons (TP st, r2b) ->
              if str_eq st "*" then
                let (e, r3) = parse_expr (skip_nls r2b) in (EAssign (id, EArr (Cons (ESplat e, Nil))), r3)
              else let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3)
            // the value may be on the next line here too, as it may for a
            // statement: rbs writes `if as =` and the `if` expression below.
            | _ -> let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3))
         else if not (str_eq (opassign_base p) "") then
           // op-assign as an expression: `(i += 1) >= 5`.
           let (e, r3) = parse_expr (skip_nls r2) in
           (EAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         // `name (expr)...` (space before paren): the parenthesised group is
         // the first command argument, so a trailing `.m`/operator binds to it
         // (`p (1..3).map { }` = p((1..3).map { }), not (p(1..3)).map).
         else if str_eq p " (" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else if is_lparen p then
           let (argv, r3) = parse_call_args r2 in
           let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
           // (a block after `&blk` is a second block: `foo(&b) { }`)
           if hasbp && starts_block r3 then (let _ = syn_refuse "both block arg and actual block given" in (ECall (id, argv), r3))
           else if hasbp then (ECallB (id, argv2, bp0, bb0), r3)
           else if starts_block r3 then
             let (bp, bb, r4) = parse_block r3 in (ECallB (id, argv, bp, bb), r4)
           else (ECall (id, argv), r3)
         else if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // `p [1, 2]` — p/pp take a space-bracket array argument.
         // ...and a `do` after the argument is p's, as after every paren-less
         // argument: `p [1, 2].map do |x| x end` prints the Enumerator (the
         // chain took the block and p printed the mapped array).
         else if str_eq p " [" && (str_eq id "p" || str_eq id "pp") then
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if (if had then false else starts_do_block r2b) then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `name [items]` — indexing or call-with-array, decided at eval.
         else if str_eq p " [" then
           (let (ae, r2b) = parse_array r2 in
            // (`m [] {}`: the brace after the array is no block)
            let _ = brace_after_lit (Cons (ae, Nil)) r2b in
            // A comma after the bracket settles the ambiguity here instead:
            // `assert_equal [1], x` is a paren-less call whose first argument
            // is an array literal, never an index (an index takes no comma at
            // this level). The rest of the arguments parse as usual.
            match r2b with
            | Cons (TP cm, r2c) ->
              if str_eq cm "," then
                (let (es, r2d) = parse_puts_args (skip_nls r2c) (Cons (ae, Nil)) in
                 if starts_do_block r2d
                 then (let (bp, bb, r2e) = parse_block r2d in (ECallB (id, es, bp, bb), r2e))
                 else (ECall (id, es), r2d))
              // ...and so does a comma after a BINARY operator's right side:
              // `assert_equal [1, 2, 3] * size, before_list` (minitest) is
              // the call `assert_equal([1, 2, 3] * size, before_list)`. The
              // lexer only leaves " [" after a name its local table does not
              // know (see lvt_prev_local), and an index of a local followed by
              // a comma is no statement ruby accepts either.
              else if is_binop_tok cm then
                (let (es, r2d) = parse_puts_args r Nil in
                 match es with
                 | Cons (_, Cons (_, _)) ->
                   if starts_do_block r2d
                   then (let (bp, bb, r2e) = parse_block r2d in (ECallB (id, es, bp, bb), r2e))
                   else (ECall (id, es), r2d)
                 | _ -> ambig_or_call id ae r2b)
              else ambig_or_call id ae r2b
            | _ -> ambig_or_call id ae r2b)
         // a double-quoted string argument: `d "desc" do ... end`.
         else if str_eq p "(s" then
           // An interpolated string lexes as a GROUP, and a chained call on it
           // (`:"m#{t}"` becomes `(...).to_sym`) would otherwise swallow the
           // `do`: `define_method :"on_#{type}" do |node|` must give the block
           // to define_method, not to to_sym.
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            // (a brace after the literal is no block: `m "#{x}" {}`)
            let _ = brace_after_lit es r2b in
            if starts_block r2b then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `foo ~x` / `foo !x` — a unary-operator argument in a paren-less
         // call. Ruby has no binary `!`, and a method named `foo!` lexes as
         // one token, so a bare `!` here can only start an argument.
         else if str_eq p "~" || str_eq p "!" then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `foo ::Const` — the lexer only marks " ::" where a value can start.
         // A `do...end` after it belongs to this command, as it does for every
         // other paren-less argument shape (`refine ::Range do ... end`).
         else if str_eq p " ::" then
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if starts_block r2b then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `foo -> { ... }` — a paren-less lambda argument (the lambda owns its
         // own block; `.call`/chains after it stay part of the argument).
         else if str_eq p "->" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         // `q *a` / `q **h`: a splat first argument (see cmd_star), and the
         // `do` after the arguments is the command's, as for any argument
         else if str_eq p " *" || str_eq p " **" || str_eq p " &" then
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if (if had then false else starts_do_block r2b) then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         else (enc_pseudo_var_at id (tok_line r), r)
       | _ ->
         if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // paren-less call arguments: `it 'desc' do ... end`, `foo :sym, 1`.
         else if starts_bare_arg r then
           // `do...end` binds to this command, not to a bare identifier
           // argument (`define_method name do..end` = define_method(name){..}),
           // so suppress do-block attachment while parsing the arguments.
           let had = map_has parser_flags "nodo" in
           let _ = map_set parser_flags "nodo" VNil in
           let (es, r2) = parse_puts_args r Nil in
           let _ = if had then () else map_delete parser_flags "nodo" in
           let _ = brace_after_lit es r2 in
           (if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2))
         else (enc_pseudo_var_at id (tok_line r), r))
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      // a desugared string literal: ("" + seg + ...) with a marked opener
      // so `foo "a".."b"` stays an argument, not a call's parens.
      let (e, r2) = parse_expr r in
      // `)u8`: the lexer saw a \u escape that makes this literal UTF-8
      let u8 = (match r2 with Cons (TP ")u8", _) -> true | _ -> false) in
      let r3 = (if u8 then (match r2 with Cons (_, t9) -> t9 | Nil -> r2) else expect r2 ")") in
      if u8 then (match concat_adjacent_strings e r3 with (e9, r9) -> (lit_u8_tag e9, r9))
      else
      // adjacent string literals concatenate: "a" "b" is "ab".
      (match concat_adjacent_strings e r3 with
       | (e9, r9) ->
         // a non-UTF-8 magic comment tags the literal at parse time (see the
         // TStrL arm); interpolated pieces keep their own encodings, so only
         // a fully-static chain is tagged. In a US-ASCII source, non-ASCII
         // bytes come from \u escapes, which make the literal UTF-8 instead.
         let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
         if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" then (e9, r9)
         else
           let rec statall = fn (e2: Expr) ->
             (match e2 with
              | EStrL _ -> true
              | EBin (op2, a9, b9) -> str_eq op2 "+" && statall a9 && statall b9
              | _ -> false) in
           let rec hasnon7 = fn (e2: Expr) ->
             (match e2 with
              | EStrL t9 -> (if enc_all7 t9 then false else true)
              | EBin (_, a9, b9) -> hasnon7 a9 || hasnon7 b9
              | _ -> false) in
           // (an INTERPOLATED literal of a US-ASCII source is US-ASCII unless
           //  an interpolated piece brings another encoding, which it then
           //  takes -- rb_str_concat_literals; the tag reads dstr_ienc)
           if (if statall e9 then false else true) then
             (if (str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII") && (if hasnon7 e9 then false else true)
              then (EMethod (e9, "__lit_denc~US-ASCII", Nil), r9)
              else if str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII" then (e9, r9)
              else (EMethod (e9, "__lit_denc~" ++ cd, Nil), r9))
           else if (str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII") && hasnon7 e9
           then (e9, r9)
           else (EMethod (e9, "__lit_enc~" ++ cd, Nil), r9))
    else if is_lparen p then
      // () is nil; inside parens the word operators and/or (lowest
      // precedence) are usable: (a and b).
      // ...and `(self)` is not the keyword: a private method may be called on
      // `self.` as written, and `(self).m` is an ordinary receiver (ruby's
      // NoMethodError), so the group is kept as a statement around it
      // (and so are `(;)` and `(\n)`: `p (;),(),()`)
      (match skip_nls r with
       | Cons (TP rp, r1) when str_eq rp ")" -> (ENil, r1)
       | _ -> (match paren_body r with (ESelf, r9) -> (EStmt (SExpr ESelf), r9) | pr9 -> pr9))
    else if str_eq p "[" || str_eq p " [" then parse_array r
    else if str_eq p "\{" then parse_hash r
    else if str_eq p "::" || str_eq p " ::" then
      // leading ::Const — a TOP-LEVEL constant. Keep the prefix: read by bare
      // name it would find a nested constant of the same name instead, which
      // is exactly what `::Process` inside Sidekiq (which has its own
      // Process) is written to avoid.
      (match r with
       // `p ::Bar ||= 42`: a top-level constant op-assigned inside an expression
       | Cons (TId n, Cons (TP eq9, r3)) when is_cap n && (if str_eq (opassign_base eq9) "" then false else true) ->
         (let (v, r4) = parse_expr (skip_nls r3) in (EStmt (const_opasgn ("::" ++ n) ("::" ++ n) (opassign_base eq9) v), r4))
       | Cons (TId n, r2) -> (EConst ("::" ++ n), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected constant after ::" ++ parsing_file ()))) in fail ("mere-ruby: expected constant after ::" ++ parsing_file ())))
    else if str_eq p ".." || str_eq p "..." then
      // beginless range (..5)
      let (hi, r2) = parse_bin r 1 in
      (ERange (ENil, hi, str_eq p "..."), r2)
    else if str_eq p "->" then
      // -> (params) { body } / -> x { body } / -> { body } lambda literal.
      let (params, lds, r1) =
        (match r with
         | Cons (TP lp, r2) ->
           if str_eq lp "(" then let (ps, ds, r3) = parse_params r2 Nil Nil in (ps, ds, r3)
           else if str_eq lp "*" || str_eq lp "**" || str_eq lp "&" then lambda_bare_params r Nil Nil
           else if str_eq lp "..." then (let _ = syn_refuse "unexpected ..." in (Nil, Nil, r))
           else (Nil, Nil, r)
         | Cons (TId n, r2) ->
           if str_eq n "do" then ((Nil : str list), (Nil : (str * Expr) list), r)
           else lambda_bare_params r Nil Nil
         | _ -> (Nil, Nil, r)) in
      // `-> () { _1 }` has an explicit (empty) parameter list, which forbids a
      // numbered parameter in the body (checked once the body is parsed).
      let empty_parens = (match params with Nil -> (match r with Cons (TP lp, _) -> str_eq lp "(" | _ -> false) | _ -> false) in
      // `-> a=a() { a }` — the default's call grabs the brace block; when no
      // block opener follows, take that block back as the lambda body.
      let (lds, r1, swallowed) =
        (match starts_block r1 with
         | true -> (lds, r1, (false, (Nil : str list), (Nil : Stmt list)))
         | false ->
           (match last_default_block lds with
            | (true, lds2, sbp, sbb) -> (lds2, r1, (true, sbp, sbb))
            | (false, _, _, _) -> (lds, r1, (false, Nil, Nil)))) in
      // (a lambda takes no `...`, and its anonymous parameters are its own)
      let _ = (if ps_has params "*__fwd" then syn_refuse "unexpected ..." else ()) in
      let _ = afr_push ("B" ++ anon_flags params) in
      let (bp, bb, r4) =
        (match swallowed with
         | (true, sbp, sbb) -> (sbp, sbb, r1)
         | (false, _, _) -> parse_block r1) in
      let _ = afr_pop () in
      // carry the empty-params sentinel so a numbered param in the body is
      // rejected (numbered_misuse_expr checks a non-empty ELambda param list).
      let params = if empty_parens then Cons (empty_bp_marker, Nil) else params in
      let allp = list_append_str params bp in
      // optional params (defaults) relax the strict lambda arity check via
      // a hidden anonymous splat; kw defaults keep their own binding.
      let pds = plain_defaults lds in
      let allp2 = (match pds with
                   | Nil -> allp
                   // named, so it can be told apart from a splat the source
                   // actually wrote: `->(a, b=1){}.parameters` must not report it.
                   | _ -> if psplat_any allp then allp else list_append_str allp (Cons ("*__opt", Nil))) in
      (ELambda (allp2, defaults_prologue (app_ds pds (kw_defaults_bare lds)) bb), r4)
    // (a colon that opens nothing: `: foo`, in ruby's words)
    else if str_eq p ":" then (let _ = syn_refuse "unexpected ':', ignoring it" in (ENil, r))
    else (let __fm = ("mere-ruby: unexpected token: " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: unexpected end-of-input" ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)

and parse_array = fn toks0 ->
  // (a new context for the "nodo" flag, as paren_body is: `p begin 1.times do
  //  1 end end` and `p :foo, {a: proc do end}` give the do to the inner call)
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let res = parse_array_go toks0 in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  res
and parse_array_go = fn toks0 ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (EArr Nil, r) else parse_arr_items toks Nil
  | _ -> parse_arr_items toks Nil

and parse_arr_items = fn toks -> fn (acc: Expr list) ->
  // splat element [*x] and symbol-key trailing hash [.., k: v] forms.
  let bare = (match toks with
              | Cons (TP _, Cons (TP nx, _)) -> str_eq nx "," || str_eq nx "]"
              | _ -> false) in
  match toks with
  | Cons (TP st, r0b) ->
    // a bare `*` / `**` forwards the method's anonymous rest / keyword rest,
    // as in a call: `def a(b: 1, **) [b, **] end` (test_keyword)
    if bare && str_eq st "*" then (let _ = anon_use "r" in arr_items_sep (skip_nls r0b) (Cons (ESplat (EVar "__anonrest"), acc)))
    else if bare && str_eq st "**" then
      let _ = anon_use "k" in
      arr_hash_items (skip_nls r0b) acc (Cons (EKwSplat (EVar "__anonkw"), Cons (EKwSplat (EVar "__anonkw"), Nil))) true
    else if str_eq st "*" then
      let (inner, r1) = parse_expr r0b in
      arr_items_sep (skip_nls r1) (Cons (ESplat inner, acc))
    // `[**h]` starts the trailing hash, exactly as `[k: v]` does: everything
    // after it is a hash item, they all merge into ONE element, and Ruby drops
    // that element entirely when the merge comes out empty.
    else if str_eq st "**" then
      let (inner, r1) = parse_expr r0b in
      arr_hash_items (skip_nls r1) acc (Cons (EKwSplat inner, Cons (EKwSplat inner, Nil))) true
    else parse_arr_expr toks acc
  | Cons (TId n, Cons (TP col, r0c)) ->
    if str_eq col ":" then
      let (v, r1) = parse_expr (skip_nls r0c) in
      arr_hash_items (skip_nls r1) acc (Cons (v, Cons (ESym n, Nil))) false
    else parse_arr_expr toks acc
  | _ -> parse_arr_expr toks acc

and arr_items_sep = fn r -> fn (acc: Expr list) ->
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `[1, 2,]` — a hanging comma before the closing bracket.
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app acc Nil), r3)
         else parse_arr_items (skip_nls r2) acc
       | _ -> parse_arr_items (skip_nls r2) acc)
    else if str_eq p "]" then (EArr (rev_app acc Nil), r2)
    else (let __fm = ("mere-ruby: expected , or ] in array, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

and parse_arr_expr = fn toks -> fn (acc: Expr list) ->
  let (e, r0) = parse_expr toks in
  let r = skip_nls r0 in   // allow a newline before the , or ]
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app (Cons (e, acc)) Nil), r3)
         else parse_arr_items (skip_nls r2) (Cons (e, acc))
       | _ -> parse_arr_items (skip_nls r2) (Cons (e, acc)))
    else if str_eq p "]" then (EArr (rev_app (Cons (e, acc)) Nil), r2)
    // trailing hash without braces: ["a", "b" => 1, "c" => 2]
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      arr_hash_items r3 acc (Cons (v, Cons (e, Nil))) false
    else (let __fm = ("mere-ruby: expected , or ] in array, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

// remaining k => v pairs of an array's trailing hash (hp is reversed v,k).
and arr_hash_items = fn toks -> fn (acc: Expr list) -> fn (hp: Expr list) -> fn (kw: bool) ->
  match toks with
  | Cons (TP p, r) ->
    // a hash built from `**` is dropped when it is empty, which is what the
    // EKwSplat wrapper says; a plain `[k: v]` hash is always an element.
    if str_eq p "]" then
      (let h = EHsh (rev_app hp Nil) in
       (EArr (rev_app acc (Cons ((if kw then EKwSplat h else h), Nil))), r))
    else if str_eq p "," then
      (match skip_nls r with
       | Cons (TId n2, Cons (TP c2, r2b)) ->
         if str_eq c2 ":" then
           let (v, r4) = parse_expr (skip_nls r2b) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (ESym n2, hp))) kw
         else
           let (k, r2) = parse_expr (skip_nls r) in
           let r3 = expect r2 "=>" in
           let (v, r4) = parse_expr (skip_nls r3) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw
       | Cons (TP dsp, r2c) ->
         if str_eq dsp "**" then
           (let (inner, r1b) = parse_expr r2c in
            arr_hash_items (skip_nls r1b) acc (Cons (EKwSplat inner, Cons (EKwSplat inner, hp))) true)
         // ⚠ a hanging comma before the `]` closes the hash, as it closes
         //   the array (`[1, 2,]` already did): `["a" => 2, "b" => 3,]` was
         //   "unexpected token: ]", and json's parser test writes exactly
         //   that inside a Hash literal.
         else if str_eq dsp "]" then arr_hash_items (Cons (TP dsp, r2c)) acc hp kw
         else
           (let (k, r2) = parse_expr (skip_nls r) in
            let r3 = expect r2 "=>" in
            let (v, r4) = parse_expr (skip_nls r3) in
            arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw)
       | other ->
         let (k, r2) = parse_expr other in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw)
    else (let __fm = ("mere-ruby: expected , or ] in array hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

and parse_hash = fn toks ->
  // (a new context for the "nodo" flag, as paren_body is: `p begin 1.times do
  //  1 end end` and `p :foo, {a: proc do end}` give the do to the inner call)
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let res = parse_hash_go toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  res
and parse_hash_go = fn toks ->
  // a multiline hash literal may break after `{` (and before `}`).
  let toks = skip_nls toks in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "}" then (EHsh Nil, r) else parse_hash_items toks Nil
  | _ -> parse_hash_items toks Nil

// the __lit_fsl marker: the magic comment of the file being PARSED
and lit_fsl_wrap = fn (pr: (Expr * Tok list)) ->
  match pr with
  | (e9, r9) ->
    let fs9 = (if map_has fsl_ctx "v" then map_get fsl_ctx "v" else "") in
    if str_eq fs9 "on" || str_eq fs9 "off" then (EMethod (e9, "__lit_fsl~" ++ fs9, Nil), r9)
    else (e9, r9)

// a general hash key: `expr => v`, or `"string": v` (a symbol key).
and hash_key_expr = fn toks ->
  let (ke, r) = parse_expr toks in
  match r with
  | Cons (TP c, r2) ->
    // ⚠ `{"a": 1}` becomes `"a".to_sym`, so the invalid-symbol check further
    // down (which looks for ESym) cannot see it. A LITERAL string here is
    // known at parse time, so it is turned into the symbol now -- and an
    // invalid one is the same parse error `:"\xC3"` is.
    if str_eq c ":" then (str_label_key ke, r2)
    else (ke, expect r "=>")
  | _ -> (ke, expect r "=>")
// the key a `"string":` label names
// a string literal, bare or wearing a literal tag (`__lit_enc~` in a source
// that is not UTF-8 -- `"foo":` in a US-ASCII file is a label too)
and str_lit_like = fn (e: Expr) ->
  match e with
  | EStrL _ -> true
  | EBin ("+", _, _) -> true
  | EMethod (x9, m9, Nil) -> str_len m9 > 6 && str_eq (substring m9 0 6) "__lit_" && str_lit_like x9
  | _ -> false
and str_label_key = fn (ke: Expr) ->
  match ke with
  | EStrL lit9 -> ESym lit9
  | EMethod (EStrL lit9, m9, Nil) when str_len m9 > 10 && str_eq (substring m9 0 10) "__lit_fsl~" -> ESym lit9
  | EMethod (EStrL lit9, m9, Nil) when str_len m9 > 10 && str_eq (substring m9 0 10) "__lit_enc~" && enc_all7 lit9 -> ESym lit9
  | _ -> EMethod (ke, "to_sym", Nil)

and parse_hash_items = fn toks -> fn (acc: Expr list) ->
  // `**h` splices another hash's pairs into this literal.
  match toks with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      let (inner, r1) = parse_expr r0 in
      hash_items_sep r1 (Cons (EKwSplat inner, Cons (EKwSplat inner, acc)))
    else parse_hash_items_kv toks acc
  | _ -> parse_hash_items_kv toks acc

// ⚠ FOUR places closed a hash literal, and the duplicate-key check has to run
// at every one of them or it runs at none that matter: adding it to two left
// `x = {a: 1, a: 2}` silent, because the `name:` shorthand closes elsewhere.
// They all go through here now.
and hsh_done = fn (acc: Expr list) -> fn (ln: int) -> fn rest9 ->
  (let its = rev_app acc Nil in
   let _ = hsh_note_dups its (Nil : (str * int) list) ln in
   (EHsh its, rest9))
and hash_items_sep = fn r3 -> fn (acc: Expr list) ->
  let done9 = hsh_done acc (tok_line r3) in
  match skip_nls r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then done9 r5
         else parse_hash_items (skip_nls r4) acc
       | _ -> parse_hash_items (skip_nls r4) acc)
    else if str_eq p "}" then done9 r4
    else (let __fm = ("mere-ruby: expected , or } in hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated hash literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated hash literal" ++ parsing_file ()))

// a symbol literal in the source's encoding: a non-ASCII one in a file
// that is not UTF-8 is tagged with it (`__lit_enc~`)
and sym_src_enc = fn (s: str) ->
  let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
  if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" || enc_all7 s
     || str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII"
  then ESym s
  else EMethod (ESym s, "__lit_enc~" ++ cd, Nil)
and parse_hash_items_kv = fn toks -> fn (acc: Expr list) ->
  // `name: value` symbol-key shorthand is equivalent to `:name => value`.
  let (k, r2) =
    (match toks with
     | Cons (TId name, Cons (TP colon, r0)) ->
       if str_eq colon ":" then (ESym name, r0)
       else hash_key_expr toks
     | _ -> hash_key_expr toks) in
  // `{a:}` / `{a:, b:}` — an omitted value reads the same-named variable.
  // The delimiter that says so, like the value itself, may be on the next
  // line, so both are decided after the newlines.
  let omitted =
    (match k with
     | ESym _ ->
       (match skip_nls r2 with
        | Cons (TP nx, _) -> str_eq nx "}" || str_eq nx ","
        | _ -> false)
     | _ -> false) in
  // (a key that is not a plain name has no variable to read: `{"#{x}":}`
  //  is ruby's "unexpected '}'", where this went on to parse a value)
  let _ = (match k with
           | ESym _ -> ()
           | _ -> (match skip_nls r2 with
                   | Cons (TP nx, _) -> (if str_eq nx "}" || str_eq nx "," then syn_refuse ("unexpected '" ++ nx ++ "'; expected a value in the hash literal") else ())
                   | _ -> ())) in
  if omitted then
    (match k with
     // ⚠ the omitted-value form reads a VARIABLE of the same name, and `a!` or
     // `a?` is not one -- ruby refuses `{a!:}` at parse time rather than
     // looking for it. Building the EVar made it a NameError at RUN time, so
     // anything before it in the same eval had already happened.
     | ESym nm when (let n9 = str_len nm in
                     n9 > 0 && (let lc = char_at nm (n9 - 1) in str_eq lc "!" || str_eq lc "?")) ->
       (let _ = syn_refuse ("identifier " ++ nm ++ " is not valid to get") in
        hash_items_sep (skip_nls r2) acc)
     // (a CONSTANT's name reads the constant: `{FOO:}` is `{FOO: FOO}`)
     | ESym nm when str_len nm > 0 && char_at nm 0 >= "A" && char_at nm 0 <= "Z" ->
       hash_items_sep (skip_nls r2) (Cons (EConst nm, Cons (k, acc)))
     | ESym nm -> hash_items_sep (skip_nls r2) (Cons (EVar nm, Cons (k, acc)))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad hash key")) in fail "mere-ruby: bad hash key"))
  else
  // (a non-ASCII label takes the file's encoding, as a :symbol does)
  let k = (match k with ESym nm -> sym_src_enc nm | _ -> k) in
  let (v, r3a) = parse_expr (skip_nls r2) in
  let r3 = skip_nls r3a in
  match r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      // `{a: 1, b: 2,}` — a hanging comma before the closing brace.
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then hsh_done (Cons (v, Cons (k, acc))) (tok_line r3) r5
         else parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc)))
       | _ -> parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc))))
    else if str_eq p "}" then hsh_done (Cons (v, Cons (k, acc))) (tok_line r3) r4
    else (let __fm = ("mere-ruby: expected , or } in hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated hash literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated hash literal" ++ parsing_file ()))

// call arguments after the opening `(` (already consumed); handles the
// empty `()` case.
and parse_call_args = fn toks0 ->
  // a newline right after `(` is allowed (multi-line argument lists).
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (Nil, r) else parse_call_items toks Nil
  | _ -> parse_call_items toks Nil

// Arguments may end with bare hash pairs — old-style `k => v` or keyword
// `name: value` — which Ruby collects into a single trailing Hash argument.
// `pos` accumulates positional args (reversed); `hp` accumulates hash pairs
// as v,k,v,k (reversed), emitted as one trailing EHsh.
and parse_call_items = fn toks -> fn (acc: Expr list) ->
  parse_call_go toks acc Nil

and parse_call_go = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TId name, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      // `m(a:, b:)` — an omitted value reads the same-named variable. The
      // delimiter that says the value was omitted may be on the NEXT line
      // (sass-embedded writes a multi-line call that way), and a value may
      // equally start there, so the decision is made after the newlines.
      (match skip_nls r0 with
       | Cons (TP nx, _) ->
         if str_eq nx "," || str_eq nx ")" then
           parse_call_sep (skip_nls r0) pos (Cons (EVar name, Cons (ESym name, hp)))
         else
           let (v, r1) = parse_expr (skip_nls r0) in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp)))
       | _ ->
         let (v, r1) = parse_expr (skip_nls r0) in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp))))
    else parse_call_pos_arg toks pos hp
  | Cons (TP star, r0) ->
    // a bare `*` / `**` (right before `,` or `)`) forwards the method's
    // anonymous rest / keyword rest
    if str_eq star "*" && (match r0 with Cons (TP nx, _) -> str_eq nx ")" || str_eq nx "," | _ -> false) then
      (let _ = anon_use "r" in parse_call_sep r0 (Cons (ESplat (EVar "__anonrest"), pos)) hp)
    else if str_eq star "**" && (match r0 with Cons (TP nx, _) -> str_eq nx ")" || str_eq nx "," | _ -> false) then
      let _ = anon_use "k" in
      parse_call_sep r0 pos (Cons (EKwSplat (EVar "__anonkw"), Cons (EKwSplat (EVar "__anonkw"), hp)))
    else if str_eq star "*" then
      let (inner, r1) = parse_expr r0 in parse_call_sep r1 (Cons (ESplat inner, pos)) hp
    else if str_eq star "**" then
      // **hash spreads as the call's keyword hash -- so it goes on the KEYWORD
      // list, beside the explicit `k: v` pairs, and not on the positional one.
      // ⚠ it used to go on the positional list and be lifted across afterwards,
      //   which broke twice:
      //     f(**h1, **h2)   the lift only ran when there was at least one
      //                     explicit pair, so with none the splats stayed
      //                     POSITIONAL and the callee got "wrong number of
      //                     arguments (given 1, expected 0)" where ruby merges
      //                     them into {a: 4, b: 2, c: 7}
      //     f(**h, d: 9)    the lift appended the splats AFTER the pairs, so
      //                     the keys came out {d: 9, a: 1, b: 2} where ruby
      //                     keeps source order, {a: 1, b: 2, d: 9} -- and the
      //                     same reordering decides which duplicate key wins
      //   Both are the same fact: the two lists lost the order they were
      //   written in. Doubled, which is the marker hsh_eval_items reads.
      let (inner, r1) = parse_expr r0 in
      parse_call_sep r1 pos (Cons (EKwSplat inner, Cons (EKwSplat inner, hp)))
    else if str_eq star "..." then
      // `foo(...)` (immediately closed) forwards the collected positional
      // args; `foo(...expr)` is a beginless exclusive range argument.
      (match r0 with
       | Cons (TP q, _) ->
         if str_eq q ")" then
           (let _ = anon_use "f" in
            parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), Cons (ESplat (EVar "__fwd"), pos))) hp)
         else let (hi, r1) = parse_expr r0 in
              parse_call_sep r1 (Cons (ERange (ENil, hi, true), pos)) hp
       | _ ->
         let (hi, r1) = parse_expr r0 in
         parse_call_sep r1 (Cons (ERange (ENil, hi, true), pos)) hp)
    else if str_eq star "&" then
      // block-pass `&:sym` / `&expr`; bare `&` forwards the anonymous block.
      (match r0 with
       | Cons (TP nx, _) ->
         if str_eq nx ")" || str_eq nx "," then
           (let _ = anon_use "b" in parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), pos)) hp)
         else let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp
       | _ -> let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp)
    else parse_call_pos_arg toks pos hp
  | _ -> parse_call_pos_arg toks pos hp

and parse_call_pos_arg = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in parse_call_sep r3 pos (Cons (v, Cons (e, hp)))
    // `[].sample(random: nil, "invalid-argument": nil)` -- a string label. A
    // `:` cannot follow a whole argument otherwise (a ternary's is inside it).
    else if str_eq p ":" then
      let (v, r3) = parse_expr (skip_nls r2) in parse_call_sep r3 pos (Cons (v, Cons (str_label_key e, hp)))
    else parse_call_sep r (Cons (e, pos)) hp
  | _ -> parse_call_sep r (Cons (e, pos)) hp

and parse_call_sep = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match skip_nls toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `f(1,)` — a vestigial trailing comma before the close paren.
      (match skip_nls r with
       | Cons (TP rp, r2) ->
         if str_eq rp ")" then (finish_call_args pos hp, r2) else parse_call_go (skip_nls r) pos hp
       | _ -> parse_call_go (skip_nls r) pos hp)
    else if str_eq p ")" then (finish_call_args pos hp, r)
    else (let __fm = ("mere-ruby: expected , or ) in argument list, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  // (an argument takes no modifier: `foo(bar rescue nil)`)
  | Cons (TId w, _) when str_eq w "rescue" ->
    (let _ = syn_refuse "unexpected 'rescue' modifier; expected a `)` to close the arguments" in (finish_call_args pos hp, toks))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated argument list" ++ parsing_file ()))) in fail ("mere-ruby: unterminated argument list" ++ parsing_file ()))

and finish_call_args = fn (pos: Expr list) -> fn (hp: Expr list) ->
  match hp with
  | Nil -> rev_app pos Nil
  | _ ->
    // `f(a: 1, **h)` -- a keyword splat belongs to the SAME keyword hash as
    // the explicit pairs, not to the positional list, or the callee sees two
    // arguments. Lift it out and splice it (doubled: the marker
    // hsh_eval_items uses), after the pairs so a later splat wins.
    // A block-pass has to stay LAST: the callee finds it by looking at the end
    // of the argument list, and the keyword hash is appended after the
    // positionals. `g(*a, k: k, &blk)` otherwise left `&blk` in the middle,
    // where it was evaluated as an ordinary argument (a stray nil).
    let ps0 = rev_app pos Nil in
    let ps = drop_blockpass ps0 in
    // the keyword pairs are a hash literal too: `m(k: 1, k: 2)` warns
    let _ = hsh_note_dups (rev_app hp Nil) (Nil : (str * int) list) (parse_line_now ()) in
    eapp (drop_kwsplats ps)
         (let _ = (if val_list_len_e hp > 131070 then syn_refuse "too many keyword arguments" else ()) in
          Cons (EKwHash (eapp (rev_app hp Nil) (kwsplats_doubled ps)), only_blockpass ps0))

// the block-pass argument (at most one), and the list without it.
and only_blockpass = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (EBlockPass b, t) -> Cons (EBlockPass b, only_blockpass t)
  | Cons (_, t) -> only_blockpass t
and args_have_bpass = fn (xs: Expr list) ->
  match xs with Nil -> false | Cons (EBlockPass _, _) -> true | Cons (_, t) -> args_have_bpass t
and args_have_fwd = fn (xs: Expr list) ->
  match xs with Nil -> false | Cons (ESplat (EVar v), t) -> str_eq v "__fwd" || args_have_fwd t | Cons (_, t) -> args_have_fwd t
and drop_blockpass = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (EBlockPass _, t) -> drop_blockpass t
  | Cons (h, t) -> Cons (h, drop_blockpass t)

and drop_kwsplats = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with EKwSplat _ -> drop_kwsplats t | _ -> Cons (h, drop_kwsplats t))
and kwsplats_doubled = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with EKwSplat e -> Cons (EKwSplat e, Cons (EKwSplat e, kwsplats_doubled t)) | _ -> kwsplats_doubled t)

// ---- statements — SAME mutual-recursion group as the expression parser,
// because a block body (`{ ... }` / `do ... end`) parses statements while
// parse_postfix parses the block. ----------------------------------------
// `m "x" \{}`: a brace block cannot follow a LITERAL last argument (ruby's
// "unexpected '\{'"); after a name it is that name's block, `m x \{}`
and brace_after_lit = fn (es: Expr list) -> fn toks ->
  match toks with
  | Cons (TP br9, _) when str_eq br9 "\{" ->
    // (through the literal's encoding tags: `m %[] {}`, `m :"#{m}" {}`)
    (match lit_untag (last_expr es) with
     | EStrL _ -> syn_refuse "unexpected '\{' after a method call without parenthesis"
     | EInt _ -> syn_refuse "unexpected '\{' after a method call without parenthesis"
     | EFlt _ -> syn_refuse "unexpected '\{' after a method call without parenthesis"
     | ESym _ -> syn_refuse "unexpected '\{' after a method call without parenthesis"
     | EArr _ -> syn_refuse "unexpected '\{' after a method call without parenthesis"
     | ERange (_, _, _) -> syn_refuse "unexpected '\{' after a method call without parenthesis"
     | EMethod (x9, m9, _) ->
       (if str_eq m9 "__interp_str" || (str_eq m9 "to_sym" && cond_is_dstr (lit_untag x9)) then syn_refuse "unexpected '\{' after a method call without parenthesis" else ())
     | e9 -> if cond_is_dstr e9 then syn_refuse "unexpected '\{' after a method call without parenthesis" else ())
  | _ -> ()
and lit_untag = fn (e: Expr) ->
  match e with
  | EMethod (y, n9, Nil) when str_len n9 > 6 && str_eq (substring n9 0 6) "__lit_" -> lit_untag y
  | _ -> e
and last_expr = fn (es: Expr list) ->
  match es with Nil -> ENil | Cons (e9, Nil) -> e9 | Cons (_, t9) -> last_expr t9
and parse_puts_args = fn toks -> fn (acc: Expr list) ->
  // trailing keyword-hash arguments in a paren-less call (`d :s, shared: true`)
  // collect into one Hash argument, like the parenthesized form.
  // (a command's marked first splat, see cmd_star, is the plain one here)
  let toks = (match toks with
              | Cons (TP sp9, r9) when str_eq sp9 " *" || str_eq sp9 " **" || str_eq sp9 " &" -> Cons (TP (substring sp9 1 (str_len sp9)), r9)
              | _ -> toks) in
  match toks with
  | Cons (TId kname, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      let (hp, r) = parse_bare_hash toks Nil in bare_hash_done acc hp r
    else parse_puts_args_pos toks acc
  | Cons (TP st, r0) ->
    // A no-space `(` right after the command word is a real argument list:
    // `raise(E, "m")` / `puts(x, y)`. Parse it like any method call so a comma
    // separates arguments (parse_expr would instead read `(a, b)` as a grouped
    // expression and choke on the comma). A space-paren (" (") is left to the
    // positional path, so `p (1..3).to_a` still groups-then-chains.
    // ...only at the FIRST argument, though: after a comma we are already
    // inside the list, so `p 1, (2).abs` is a grouped expression to chain
    // from, not a second argument list.
    if str_eq st "(" && (match acc with Nil -> true | _ -> false) then
      let (a, r1) = parse_call_args r0 in (rev_app acc a, r1)
    // a keyword splat in a paren-less call: `mkdir_p subdir, **options`.
    else if str_eq st "**" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (EKwSplat inner, acc))
         else (rev_app (Cons (EKwSplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (EKwSplat inner, acc)) Nil, r1))
    // splat / block-pass arguments in a paren-less call: `send :m=, *x, 1`.
    else if str_eq st "*" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (ESplat inner, acc))
         else (rev_app (Cons (ESplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (ESplat inner, acc)) Nil, r1))
    else if str_eq st "&" then
      let (inner, r1) = parse_expr r0 in
      (rev_app (Cons (EBlockPass inner, acc)) Nil, r1)
    else parse_puts_args_pos toks acc
  | _ -> parse_puts_args_pos toks acc

// The bare hash at the end of a paren-less call. Once it has begun, ruby
// collects EVERY remaining item into it, in any mix of `k: v`, `"k": v`,
// `k => v` and `**h` -- `raise exc, "foo" => "bar", foo: "bar"` and
// `m k1: "foo", sym => "baz"`. Two loops used to read it, one for labels and
// one for rockets, and the first item chose which: a rocket after a label (or
// a label after a rocket) was a parse error. Stops in front of a `&blk`.
// Returns the pairs k,v,k,v (a splat doubled, the marker hsh_eval_items reads).
and parse_bare_hash = fn toks -> fn (hp: Expr list) ->
  let (hp2, r) = parse_bare_pair toks hp in
  match r with
  | Cons (TP c, r2) ->
    if str_eq c "," then
      (match skip_nls r2 with
       | Cons (TP amp, _) when str_eq amp "&" || str_eq amp " &" -> (rev_app hp2 Nil, skip_nls r2)
       | rr -> parse_bare_hash rr hp2)
    else (rev_app hp2 Nil, r)
  | _ -> (rev_app hp2 Nil, r)

and parse_bare_pair = fn toks -> fn (hp: Expr list) ->
  match toks with
  | Cons (TId kname, Cons (TP colon, r0)) when str_eq colon ":" ->
    // ⚠ the value may be OMITTED (`call bar:, val:`), and unlike the
    //   parenthesised form a NEWLINE ends the call, so a line break after
    //   `a:` is an omission and not the start of a value on the next line.
    // (...but ruby 4 reads ON past the line break when what follows can
    //  start a value: `obj.set foo:\n  1` is {foo: 1}, while `call bar:,
    //  val:` before an `end` omits)
    let nl9 = (match r0 with Cons (TNL _, _) -> true | _ -> false) in
    let omitted9 = (match r0 with
                    | Cons (TP p9, _) -> str_eq p9 "," || str_eq p9 ")" || str_eq p9 "]" || str_eq p9 "}"
                    | Cons (TNL _, _) -> (match skip_nls r0 with
                                          | Cons (TId w9, _) -> stops_value w9 || str_eq w9 "end"
                                          | Cons (TP p9, _) -> str_eq p9 ")" || str_eq p9 "]" || str_eq p9 "}" || str_eq p9 ","
                                          | Cons (TEOF, _) -> true
                                          | Nil -> true
                                          | _ -> false)
                    | Cons (TEOF, _) -> true
                    | Nil -> true
                    | _ -> false) in
    let (v, r) = (if omitted9 then (EVar kname, r0) else parse_expr (if nl9 then skip_nls r0 else r0)) in
    (Cons (v, Cons (ESym kname, hp)), r)
  | Cons (TP dsp, r0) when str_eq dsp "**" ->
    let (inner, r) = parse_expr r0 in (Cons (EKwSplat inner, Cons (EKwSplat inner, hp)), r)
  | _ ->
    let (k, r1) = hash_key_expr toks in
    let (v, r) = parse_expr (skip_nls r1) in
    (Cons (v, Cons (k, hp)), r)

// a paren-less call's arguments end with its bare hash, and maybe a block-pass
// after it (rbs writes `any_node? child, nodes: nodes, &block`)
and bare_hash_done = fn (acc: Expr list) -> fn (hp: Expr list) -> fn r ->
  let _ = hsh_note_dups hp (Nil : (str * int) list) (parse_line_now ()) in
  match r with
  | Cons (TP amp9, r9) when str_eq amp9 "&" || str_eq amp9 " &" ->
    let (bpe, r10) = parse_expr r9 in (rev_app (Cons (EBlockPass bpe, Cons (EKwHash hp, acc))) Nil, r10)
  | _ -> (rev_app (Cons (EKwHash hp, acc)) Nil, r)

and parse_puts_args_pos = fn toks -> fn (acc: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_puts_args (skip_nls r2) (Cons (e, acc))
    // trailing `k => v` pairs collect into one Hash argument, and so do
    // `"k": v` string labels, whose value may be on the next line
    // (`obj.set "foo":\n 1`); a `:` cannot follow a whole argument otherwise
    else if str_eq p "=>" || (str_eq p ":" && str_lit_like e) then
      let (v, r3) = parse_expr (skip_nls r2) in
      let hp0 = Cons (v, Cons ((if str_eq p ":" then str_label_key e else e), Nil)) in
      (match r3 with
       | Cons (TP c3, r4) when str_eq c3 "," ->
         (match skip_nls r4 with
          | Cons (TP amp, _) when str_eq amp "&" || str_eq amp " &" -> bare_hash_done acc (rev_app hp0 Nil) (skip_nls r4)
          | rr -> let (hp, r5) = parse_bare_hash rr hp0 in bare_hash_done acc hp r5)
       | _ -> bare_hash_done acc (rev_app hp0 Nil) r3)
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// parse statements until a block-closing keyword (end / else / elsif /
// when) or EOF; the closer is left unconsumed for the caller.
// -w: a statement after an unconditional break / next / return / redo /
// retry in the same list is never run, and ruby says so at its line
and unreach_list = fn (xs: Stmt list) ->
  let _ = (if parse_verbose () then unreach_go xs false 0 else ()) in xs
and unreach_go = fn (xs: Stmt list) -> fn (jumped: bool) -> fn (ln: int) ->
  match xs with
  | Nil -> ()
  | Cons (SLine n9, t) -> unreach_go t jumped (if n9 < 0 then ln else n9)
  | Cons (SFile _, t) -> unreach_go t jumped ln
  | Cons (s9, t) ->
    if jumped then warn_note (parse_time_file () ++ ":" ++ str_of_int (ln + lshift_tok ()) ++ ": warning: statement not reached")
    else
      (let j9 = (match s9 with
                 | SReturn _ -> true | SBreak _ -> true | SNext _ -> true
                 | SExpr (EFlow (k9, _)) -> str_eq k9 "redo" || str_eq k9 "retry"
                 | _ -> false) in
       unreach_go t j9 ln)
and scv_marker = fn (id: str) -> str_len id > 6 && str_eq (substring id 0 6) "__scv~"
and scv_set = fn (id: str) ->
  let m = substring id 6 (str_len id) in
  if str_eq m "none" then map_delete scv_mode "m" else map_set scv_mode "m" m
// a constant assignment under shareable_constant_value: its value made
// shareable (experimental_everything), a shareable copy (experimental_copy),
// or for `literal` the literal frozen all the way down with every
// non-literal part of it required to be shareable already
and scv_stmt = fn (s: Stmt) ->
  if map_has scv_mode "m" then scv_stmt_go (map_get scv_mode "m") s else s
and scv_stmt_go = fn (m: str) -> fn (s: Stmt) -> scv_stmt_t m "" "" s
// (tv/tp: `recv::C op= v` evaluates recv once into the temporary tv, and the
//  name the error gives is recv's constant path tp)
and scv_stmt_t = fn (m: str) -> fn (tv: str) -> fn (tp: str) -> fn (s: Stmt) ->
  match s with
  | SAssign (n, e) when scv_const_name n -> SAssign (n, scv_wrap m n e)
  | SExpr (EScopedAssign (rc, cn, e)) ->
    (let p9 = (match rc with EVar v9 when str_len tv > 0 && str_eq v9 tv -> tp | _ -> scv_path rc) in
     SExpr (EScopedAssign (rc, cn, scv_wrap m (p9 ++ "::" ++ cn) e)))
  | SExpr (EStmt (SBegin (Cons (SAssign (t9, rv9), rest), Nil, Nil, Nil))) when (if scv_const_name t9 then false else true) ->
    SExpr (EStmt (SBegin (Cons (SAssign (t9, rv9), scv_stmts_t m t9 (scv_path rv9) rest), Nil, Nil, Nil)))
  // (`C ||= v` and `expr::C ||= v` are an if around the assignment)
  | SIf (cls, els) ->
    (let rec cl9 = fn (xs: (Expr * Stmt list) list) ->
       (match xs with Nil -> Nil | Cons ((c, b), t) -> Cons ((c, scv_stmts_t m tv tp b), cl9 t)) in
     SIf (cl9 cls, scv_stmts_t m tv tp els))
  | SBegin (b, Nil, Nil, Nil) -> SBegin (scv_stmts_t m tv tp b, Nil, Nil, Nil)
  | SExpr (EStmt st) -> SExpr (EStmt (scv_stmt_t m tv tp st))
  | _ -> s
and scv_stmts_t = fn (m: str) -> fn (tv: str) -> fn (tp: str) -> fn (b: Stmt list) ->
  match b with Nil -> Nil | Cons (x, t) -> Cons (scv_stmt_t m tv tp x, scv_stmts_t m tv tp t)
// a receiver's constant path, "..." for one that is not a constant
and scv_path = fn (e: Expr) ->
  match e with
  | EConst c9 -> c9
  | EScopedRead (r9, n9) -> (let p9 = scv_path r9 in if str_eq p9 "..." then "..." else p9 ++ "::" ++ n9)
  | _ -> "..."
and scv_const_name = fn (n: str) ->
  str_len n > 0 && (let c = char_at n 0 in (ord c >= 65 && ord c <= 90) || str_eq c ":")
  && (let rec last9 = fn (i: int) ->
        (if i < 1 then n else if str_eq (char_at n i) ":" && str_eq (char_at n (i - 1)) ":" then substring n (i + 1) (str_len n) else last9 (i - 1)) in
      let l9 = last9 (str_len n - 1) in
      str_len l9 > 0 && ord (char_at l9 0) >= 65 && ord (char_at l9 0) <= 90)
and scv_call = fn (m: str) -> fn (args: Expr list) -> EMethod (EConst "Ractor", m, args)
and scv_wrap = fn (m: str) -> fn (n: str) -> fn (e: Expr) ->
  if str_eq m "experimental_everything" then scv_call "make_shareable" (Cons (e, Nil))
  else if str_eq m "experimental_copy" then scv_call "__scv_copy" (Cons (e, Nil))
  else if str_eq m "literal" then
    (if scv_is_lit e then scv_call "make_shareable" (Cons (scv_lit n e, Nil))
     else scv_call "__scv_check" (Cons (e, Cons (EStrL n, Nil))))
  else e
and scv_is_lit = fn (e: Expr) ->
  match e with
  | EInt _ -> true | EBig _ -> true | ERat (_, _) -> true | EImag _ -> true | EImagF _ -> true
  | EImagRat (_, _) -> true | EFlt _ -> true | EStrL _ -> true | EBool _ -> true | ENil -> true
  | ESym _ -> true | ERegex (_, _) -> true
  | EArr _ -> true | EHsh _ -> true
  | ERange (_, _, _) -> true
  | EMethod (x, n9, Nil) when str_len n9 > 6 && str_eq (substring n9 0 6) "__lit_" -> scv_is_lit x || scv_dstr x
  | _ -> scv_dstr e
// an interpolated string: `+`-joined pieces, each a (tagged) literal piece or
// an `__interp_str`, at least one of them the latter (`"a" + "b"` is a call)
and scv_dstr = fn (e: Expr) -> scv_dparts e && scv_has_interp e
and scv_dparts = fn (e: Expr) ->
  match lit_untag e with
  | EStrL _ -> true
  | EMethod (_, m9, _) -> str_eq m9 "__interp_str"
  | EBin (op, l, r) -> str_eq op "+" && scv_dparts l && scv_dparts r
  | _ -> false
and scv_has_interp = fn (e: Expr) ->
  match lit_untag e with
  | EMethod (_, m9, _) -> str_eq m9 "__interp_str"
  | EBin (_, l, r) -> scv_has_interp l || scv_has_interp r
  | _ -> false
and scv_lit = fn (n: str) -> fn (e: Expr) ->
  match e with
  | EArr es -> EArr (scv_lits n es)
  | EHsh es -> EHsh (scv_lits n es)
  | ERange (a, b, x) -> ERange (scv_lit n a, scv_lit n b, x)
  | ESplat x -> ESplat (scv_lit n x)
  | EKwSplat x -> EKwSplat (scv_lit n x)
  | _ -> if scv_is_lit e then e else scv_call "__scv_check" (Cons (e, Cons (EStrL n, Nil)))
and scv_lits = fn (n: str) -> fn (es: Expr list) ->
  match es with Nil -> Nil | Cons (x, t) -> Cons (scv_lit n x, scv_lits n t)
and parse_stmts = fn toks -> fn (acc: Stmt list) ->
  let (t, skipped) = skip_nls_n toks 0 in
  let _ = parse_line_add skipped in
  match t with
  | Cons (TEOF, _) -> (unreach_list (rev_app acc Nil), t)
  // (a shareable_constant_value comment: the mode for what follows)
  | Cons (TId id, r9) when scv_marker id -> (let _ = scv_set id in parse_stmts r9 acc)
  | Cons (TId id, _) ->
    if is_block_stop id then (unreach_list (rev_app acc Nil), t)
    else
      let ln = tok_line t in
      let acc = (match acc with
                 | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
                 | _ -> acc) in
      let sv9 = pstmt_set ln in
      let (s0, r0) = parse_stmt t in
      let (s0, r0) = grow_setter_stmt s0 r0 in
      let (s, r) = apply_modifier s0 r0 in
      let _ = pstmt_set sv9 in
      let s = scv_stmt s in
      parse_stmts (expect_end r) (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))
  | _ ->
    let ln = tok_line t in
    let acc = (match acc with
               | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
               | _ -> acc) in
    let sv9 = pstmt_set ln in
    let (s0, r0) = parse_stmt t in
    let (s0, r0) = grow_setter_stmt s0 r0 in
    let (s, r) = apply_modifier s0 r0 in
    let _ = pstmt_set sv9 in
    let s = scv_stmt s in
    parse_stmts (expect_end r) (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))

// trailing statement modifiers: `STMT if C`, `unless C`, `while C`,
// `until C`. Each desugars to the corresponding block form wrapping the
// single statement.
// `unless data.encoding in Encoding::ASCII | Encoding::UTF_8`, `next unless k
// in Rational`, `return input if input in Literal | Literal8` (net-imap): a
// one-line pattern test is a condition like any other boolean, in the
// statement form and the modifier form alike.
and cond_in_pattern = fn (cr: (Expr * Tok list)) ->
  let (c, r) = cr in
  match r with
  | Cons (TId inw, rin) ->
    if str_eq inw "in" then (let (pat, r2) = parse_pattern_top rin in (EMatchTest (c, pat), r2))
    else (c, r)
  | _ -> (c, r)

// `e rescue h` as an expression: a one-line begin/rescue around e
// the value of an operator assignment takes a rescue modifier for itself:
// `a += b rescue c` is `a += (b rescue c)` -- a plain `a = b rescue c` is the
// whole statement's (apply_modifier)
and opasgn_resc = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TId w, r) when str_eq w "rescue" ->
    (let (h, r2) = parse_expr r in (resc_wrap e (SExpr h), r2))
  | _ -> (e, toks)
and resc_cmd_check = fn toks ->
  match toks with
  | Cons (TId n9, rest9) when (if is_keyword n9 then (str_eq n9 "raise" || str_eq n9 "not") else true)
                              && (if str_eq n9 "defined?" then false else true)
                              && (str_eq n9 "not" || starts_bare_arg rest9) ->
    syn_refuse "unexpected argument after a rescue modifier, expecting end-of-input"
  | _ -> ()
and resc_wrap = fn (e: Expr) -> fn (h: Stmt) ->
  EStmt (SBegin (Cons (SExpr e, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil))
// ...around the LAST argument only (the value an attribute or index write stores)
and resc_last = fn (xs: Expr list) -> fn (h: Stmt) ->
  match xs with
  | Cons (x, Nil) -> Cons (resc_wrap x h, Nil)
  | Cons (x, r) -> Cons (x, resc_last r h)
  | Nil -> Nil
and apply_modifier = fn (s: Stmt) -> fn toks ->
  match toks with
  // ruby 4.0: a line that BEGINS with `and` / `or` continues the statement
  // before it, the way a leading `.method` continues a chain. Only those two
  // words -- a modifier keyword at line start opens a new statement.
  | Cons (TNL _, _) ->
    (let t2 = skip_nls toks in
     match t2 with
     | Cons (TId w, _) -> if str_eq w "and" || str_eq w "or" then apply_modifier s t2 else (s, toks)
     | _ -> (s, toks))
  // one-line pattern matching at statement level: `expr => pat` (bind-or-raise)
  // and `expr in pat` (boolean). Only a plain expression statement qualifies.
  | Cons (TP arrow, r) ->
    if str_eq arrow "=>" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchBind (e, pat))) r2
       | _ -> (s, toks))
    else (s, toks)
  | Cons (TId id, r) ->
    if str_eq id "in" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchTest (e, pat))) r2
       // (`r = 1 in pat` is `(r = 1) in pat`: the assignment binds first, and
       //  the statement's value is the test)
       | SAssign (_, _) -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchTest (EStmt s, pat))) r2
       | _ -> (s, toks))
    else if str_eq id "if" then
      let (c0, r2) = cond_in_pattern (parse_andor (skip_nls r)) in
      let c = cond_ff c0 in
      apply_modifier (SIf (Cons ((c, Cons (s, Nil)), Nil), decl_of s)) r2
    else if str_eq id "unless" then
      let (c0, r2) = cond_in_pattern (parse_andor (skip_nls r)) in
      let c = cond_ff c0 in
      apply_modifier (SIf (Cons ((EUn ("!", c), Cons (s, Nil)), Nil), decl_of s)) r2
    // ...and a loop modifier may be followed by another modifier, as the
    // conditional ones may: `return until x unless x` (test_syntax)
    // (their condition is read as one, as `if`'s is: a range there is a
    //  flip-flop -- `x = 1 while @a == nil..true`, Bug #22002)
    else if str_eq id "while" then
      let (c, r2) = (let (c00, r20) = parse_andor (skip_nls r) in (cond_ff c00, r20)) in
      // `begin ... end while cond` is do-while: run the body once, then loop.
      (match s with
       | SBegin (_, _, _, _) -> apply_modifier (SDoWhile (s, c)) r2
       | _ -> apply_modifier (SWhile (c, Cons (s, Nil))) r2)
    else if str_eq id "until" then
      let (c, r2) = (let (c00, r20) = parse_andor (skip_nls r) in (cond_ff c00, r20)) in
      (match s with
       | SBegin (_, _, _, _) -> apply_modifier (SDoWhile (s, EUn ("!", c))) r2
       | _ -> apply_modifier (SWhile (EUn ("!", c), Cons (s, Nil))) r2)
    else if str_eq id "rescue" then
      // `expr rescue fallback` — a one-line begin/rescue.
      // (after an assignment the fallback is an `arg`: a command call --
      //  `a = x rescue raise "e"`, `a = x rescue Foo 2` -- is refused)
      let _ = (match s with
               | SAssign (_, _) -> resc_cmd_check (skip_nls r)
               | SIVarAssign (_, _) -> resc_cmd_check (skip_nls r)
               | SExpr (EAssign (_, _)) -> resc_cmd_check (skip_nls r)
               | _ -> ()) in
      let (h, r2) = parse_stmt (skip_nls r) in
      // rescue binds tighter than `=`: `a = b rescue c` is `a = (b rescue c)`,
      // so the assignment still happens with the fallback value. (Op-assigns
      // like `+=` keep the whole-statement sense.)
      // a modifier may follow: `a rescue nil if c` is `(a rescue nil) if c`.
      // ...and so it does for every assignment ruby 4.0 parses as `lhs =
      // arg_rhs`: an attribute or an index (`o.foo = x rescue y`, `h[k] = x
      // rescue y`, their op-assigns), an ivar, a multiple assignment. Those
      // rescued the WHOLE statement, so the write silently never happened.
      (match s with
       | SAssign (n, rhs) -> apply_modifier (SAssign (n, resc_wrap rhs h)) r2
       | SIVarAssign (n, rhs) -> apply_modifier (SIVarAssign (n, resc_wrap rhs h)) r2
       | SExpr (EAssign (n, rhs)) -> apply_modifier (SExpr (EAssign (n, resc_wrap rhs h))) r2
       | SExpr (EMethod (recv, m, args)) when is_setter_name m && (match args with Nil -> false | _ -> true) ->
         apply_modifier (SExpr (EMethod (recv, m, resc_last args h))) r2
       | SExpr (ESafe (recv, m, args)) when is_setter_name m && (match args with Nil -> false | _ -> true) ->
         apply_modifier (SExpr (ESafe (recv, m, resc_last args h))) r2
       | SExpr (EAttrOp (recv, m, op, rhs)) -> apply_modifier (SExpr (EAttrOp (recv, m, op, resc_wrap rhs h))) r2
       | SExpr (EIdxOp (recv, idxs, op, rhs)) -> apply_modifier (SExpr (EIdxOp (recv, idxs, op, resc_wrap rhs h))) r2
       | SMultiAssign (ts, Cons (rhs, Nil)) -> apply_modifier (SMultiAssign (ts, Cons (resc_wrap rhs h, Nil))) r2
       | SMultiAssignX (ts, Cons (rhs, Nil)) -> apply_modifier (SMultiAssignX (ts, Cons (resc_wrap rhs h, Nil))) r2
       | _ -> apply_modifier (SBegin (Cons (s, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)) r2)
    else if str_eq id "and" || str_eq id "or" then
      // lowest-precedence: `x = 1 and y = 2` runs the second statement
      // only when the first one's value is truthy. After break/next/
      // return the left side has no value — a SyntaxError in Ruby.
      let _ = (match s with
               | SBreak _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | SNext _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | SReturn _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | _ -> ()) in
      let (s2, r2) = parse_stmt (skip_nls r) in
      apply_modifier (if str_eq id "and" then SAndThen (s, s2) else SOrElse (s, s2)) r2
    else (s, toks)
  | _ -> (s, toks)

// `if ... end.method` — a control construct used as an expression with a
// trailing method chain (common in specs: `unless x ... end.should == y`).
and stmt_postfix = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP dot, _) ->
    if str_eq dot "." then
      let (e0, r1) = parse_postfix_more (EStmt s) toks in
      let (e, r2) = parse_more e0 r1 1 in
      (SExpr e, r2)
    // `case ... end + ...` — a binary operator continues the expression.
    else if prec_of dot > 0 then
      let (e, r2) = parse_more (EStmt s) toks 1 in (SExpr e, r2)
    else (s, toks)
  | _ -> (s, toks)

// Ruby defines the local targets of an assignment at parse time, so a
// modifier-guarded assignment that never runs still leaves nil locals.
// The skipped branch declares them (only if not already bound).
// the plain-local names among complex assignment targets (for nil-declare).
and x_target_names = fn (ts: Expr list) ->
  match ts with
  | Nil -> Nil
  | Cons (t, r) ->
    (match t with
     | EVar n ->
       if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then x_target_names r
       else Cons (n, x_target_names r)
     | ESplat inner ->
       (match inner with
        | EVar n -> Cons (n, x_target_names r)
        | _ -> x_target_names r)
     | EArr inner -> list_append_str (x_target_names inner) (x_target_names r)
     | _ -> x_target_names r)

and decl_of = fn (s: Stmt) ->
  match s with
  | SAssign (n, _) ->
    if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then Nil
    else Cons (SDeclare (Cons (n, Nil)), Nil)
  | SMultiAssign (ts, _) -> Cons (SDeclare ts, Nil)
  | SMultiAssignX (ts, _) -> Cons (SDeclare (x_target_names ts), Nil)
  | _ -> Nil

// a statement that begins `id ,` (a bare non-keyword identifier then a
// comma) or `* id` is a multiple assignment target list.
and looks_like_multi = fn toks ->
  match toks with
  | Cons (TId nm, Cons (TP c, _)) -> (if is_keyword nm then false else str_eq c ",")
  | Cons (TP star, Cons (TId _, _)) -> str_eq star "*"
  | _ -> false

// `undef a, b, :c` — a comma-separated list of bare/:symbol method names.
and vis_all_syms = fn (es: Expr list) ->
  (match es with
   | Nil -> true
   | Cons (ESym _, t) -> vis_all_syms t
   | _ -> false)
and vis_sym_names = fn (es: Expr list) ->
  (match es with
   | Cons (ESym n, t) -> Cons (n, vis_sym_names t)
   | _ -> (Nil : str list))
and parse_undef_names = fn toks -> fn (acc: str list) ->
  // a name may be a string too: `private_class_method :cm1, "cm3"` (test_module)
  let (n, r) = (match toks with
                | Cons (TStrL sn, r0) -> (sn, r0)
                | _ -> parse_alias_name toks) in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_undef_names (skip_nls r2) (Cons (n, acc)) else (rev_app (Cons (n, acc)) Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, r)

// an alias name is a bare identifier or a :symbol.
// fold a constant string/symbol interpolation expression to its text, for
// dynamic alias/undef names like alias :"#{'m3'}" m1.
and const_fold_str = fn (e: Expr) ->
  match e with
  | EStrL s -> s
  | ESym s -> s
  | EInt n -> str_of_int n
  | EBig s -> s
  | EBool b -> if b then "true" else "false"
  | ENil -> ""
  | EBin (o, a, b) -> if str_eq o "+" then const_fold_str a ++ const_fold_str b else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")
  // `__interp_str` is what an interpolation desugars to (v0.1-era it was
  // `to_s`); an alias name built from one has to fold the same way.
  | EMethod (rc, m, _) -> if str_eq m "to_s" || str_eq m "to_sym" || str_eq m "to_str" || str_eq m "__interp_str" then const_fold_str rc else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")

// an interpolated symbol whose parts are not all literals
and alias_dyn_at = fn toks ->
  match toks with
  | Cons (TP op, _) -> str_eq op "(s" && (let (e, _) = parse_primary toks in if const_foldable e then false else true)
  | _ -> false
and alias_skip_name = fn toks ->
  if alias_dyn_at toks then (let (_, r) = alias_name_expr toks in r)
  else (let (_, r) = parse_alias_name toks in r)
and alias_name_expr = fn toks ->
  if alias_dyn_at toks then
    (let (e, r2) = parse_primary toks in
     let r3 = (match r2 with Cons (TP dot, Cons (TId ts, r4)) -> if str_eq dot "." && (str_eq ts "to_sym" || str_eq ts "to_s") then r4 else r2 | _ -> r2) in
     (e, r3))
  else (let (n, r) = parse_alias_name toks in (ESym n, r))
and const_foldable = fn (e: Expr) ->
  match e with
  | EStrL _ -> true | ESym _ -> true | EInt _ -> true | EBig _ -> true | EBool _ -> true | ENil -> true
  | EBin (o, a, b) -> str_eq o "+" && const_foldable a && const_foldable b
  | EMethod (rc, m, _) -> (str_eq m "to_s" || str_eq m "to_sym" || str_eq m "to_str" || str_eq m "__interp_str") && const_foldable rc
  | _ -> false
and parse_alias_name = fn toks ->
  match toks with
  // `alias expires_at= expires=` — a setter's name carries its `=`.
  | Cons (TId n, Cons (TP eq, r)) -> if str_eq eq "=" then (n ++ "=", r) else (n, Cons (TP eq, r))
  | Cons (TId n, r) -> (n, r)
  | Cons (TSym n, r) -> (n, r)
  | Cons (TP op, r) ->
    // the lexer marks a space-before punctuator (" &", " (", " [") so a
    // paren-less call can be told from an operator; in `alias intersection &`
    // the marker is noise and the name is the bare operator.
    let op = (if str_len op > 1 && str_eq (char_at op 0) " " then substring op 1 (str_len op) else op) in
    // `undef -@` / `alias neg -@`: the `@` lexes as a name of its own; the
    // unary names are -@ and +@, and ~@ / !@ fold to ~ and ! (note 302)
    if (str_eq op "-" || str_eq op "+" || str_eq op "~" || str_eq op "!")
       && (match r with Cons (TId at, _) -> str_eq at "@" | _ -> false) then
      (match r with
       | Cons (_, r2) -> ((if str_eq op "-" || str_eq op "+" then op ++ "@" else op), r2)
       | Nil -> (op, r))
    // an interpolated symbol :"#{...}" lexes as ("" + ...).to_sym; fold it.
    else if str_eq op "(s" then
      (let (e, r2) = parse_primary toks in
       let folded = const_fold_str e in
       let r3 = (match r2 with Cons (TP dot, Cons (TId ts, r4)) -> if str_eq dot "." && (str_eq ts "to_sym" || str_eq ts "to_s") then r4 else r2 | _ -> r2) in
       (folded, r3))
    else if is_op_method_name op then (op, r)
    else if str_eq op "[" then
      (match r with
       | Cons (TP rb2, r2) ->
         if str_eq rb2 "]" then
           (match r2 with
            | Cons (TP eq2, r3) -> if str_eq eq2 "=" then ("[]=", r3) else ("[]", r2)
            | _ -> ("[]", r2))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))

// consume optional `, Name, Name` after `include M` (ignored).
and maybe_more_names = fn toks ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then (match r with Cons (TId _, r2) -> maybe_more_names r2 | _ -> (0, toks))
    else (0, toks)
  | _ -> (0, toks)

// extend a constant name with any trailing `::Name` scope segments.
// split a qualified constant name at its FIRST "::" ("A::B::C" -> "A", "B::C").
and dcolon_at = fn (n: str) -> fn (i: int) ->
  if i + 1 >= str_len n then str_len n
  else if str_eq (char_at n i) ":" && str_eq (char_at n (i + 1)) ":" then i
  else dcolon_at n (i + 1)
and const_head = fn (n: str) -> substring n 0 (dcolon_at n 0)
and const_tail = fn (n: str) ->
  let i = dcolon_at n 0 in
  if i + 2 >= str_len n then "" else substring n (i + 2) (str_len n)

and scoped_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, Cons (TId n, r)) -> if str_eq p "::" then scoped_name (acc ++ "::" ++ n) r else (acc, toks)
  | _ -> (acc, toks)

// extend `A::B` through further ::Name segments; returns (full, rest).
and scoped_const_path = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TId n, r) ->
    if is_cap n then
      (match r with
       | Cons (TP sc, r2) ->
         if str_eq sc "::" then scoped_const_path (acc ++ "::" ++ n) r2
         else (acc ++ "::" ++ n, r)
       | _ -> (acc ++ "::" ++ n, r))
    else (acc, toks)
  | _ -> (acc, toks)

and parse_multi = fn toks ->
  let (targets, r) = parse_target_list toks Nil in   // consumes through `=`
  let (rhs, r2) = parse_rhs_list (skip_nls r) Nil in
  (SMultiAssign (targets, rhs), r2)

// multiple assignment whose targets include indexing / attribute writes
// (`foo[0], bar.baz = a, b`). Targets parse as postfix chains; the writer
// invokes m= / []= at assignment time.
// replace the last argument v with [v, more...] (multi-value []= RHS).
// `a[i] = 1, 2` and `o.x = 1, 2` assign the ARRAY: the values after the comma
// grow the setter's last argument. The parenthesised form `(a[i] = 1, 2)`
// already did this; a bare statement did not, and stopped at the comma.
and grow_setter_stmt = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP c, r1) when str_eq c "," ->
    (match s with
     | SExpr (EMethod (recv, mn, margs)) ->
       (if str_eq mn "[]=" || (str_len mn > 1 && str_eq (char_at mn (str_len mn - 1)) "="
                               && (if str_eq mn "==" then false else true)) then
          (let (more, r2) = parse_rhs_list (skip_nls r1) Nil in
           (SExpr (EMethod (recv, mn, grow_last_arg margs more)), r2))
        else (s, toks))
     | _ -> (s, toks))
  | _ -> (s, toks)

and grow_last_arg = fn (args: Expr list) -> fn (more: Expr list) ->
  match args with
  | Nil -> Cons (EArr more, Nil)
  | Cons (v, Nil) -> Cons (EArr (Cons (v, more)), Nil)
  | Cons (h, t) -> Cons (h, grow_last_arg t more)

and parse_multix = fn toks ->
  let (targets, r) = parse_x_targets toks Nil in
  let (rhs, r2) = parse_rhs_list (skip_nls r) Nil in
  (SMultiAssignX (targets, rhs), r2)

and parse_x_targets = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         // `* = 1` — an anonymous splat consumes (and discards) values.
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx "=" || str_eq nx "," then (ESplat ENil, r0)
            else let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1)
          | _ -> let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  // (a safe-navigation writer is no destination: `a&.x, = 0`)
  let _ = (match t with
           | ESafe (_, _, _) -> syn_refuse "&. inside multiple assignment destination"
           | ESplat (ESafe (_, _, _)) -> syn_refuse "&. inside multiple assignment destination"
           | _ -> ()) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `a, = 1` — a trailing comma ends the target list. The list may also
      // wrap after the comma (`a, b,\n  c = rhs`).
      (match skip_nls r2 with
       // (the trailing comma is a discarding splat: `(a, b), = [[1, 2]]`
       //  takes the first element apart, where a lone `(a, b) = ...` would
       //  take the whole value)
       | Cons (TP eq2, r3) ->
         if str_eq eq2 "=" then (rev_app (Cons (ESplat ENil, Cons (t, acc))) Nil, r3)
         else parse_x_targets (skip_nls r2) (Cons (t, acc))
       | _ -> parse_x_targets (skip_nls r2) (Cons (t, acc)))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or = in multiple assignment, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))) in fail ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))

// one assignment target: a name (local/@ivar/$global) followed by .attr /
// [index] chains. Unlike parse_postfix this never consumes `= rhs`.
and parse_x_target1 = fn toks ->
  match toks with
  | Cons (TId nm, r) ->
    if is_ivar nm then parse_x_chain (EIVar (substring nm 1 (str_len nm))) r
    // a capitalized receiver is a CONSTANT (`x, Encoding.default_external =
    // ...` writes through the class), not a local variable read.
    else if is_cap nm then parse_x_chain (EConst nm) r
    else parse_x_chain (EVar nm) r
  // `::FOO` is the top-level constant (written as the const "::FOO")
  | Cons (TP cc, Cons (TId nm, r)) when (str_eq cc "::" || str_eq cc " ::") && is_cap nm -> parse_x_chain (EConst ("::" ++ nm)) r
  // a parenthesized group destructures one value: ((a, b), c) = ...
  // `is_lparen`, not `str_eq lp "("`: a paren after a comma carries the space
  // in its token (`y, (a, b) = ...`), and only the statement-initial one is
  // spelled bare.
  | Cons (TP lp, r) ->
    if is_lparen lp then
      // ...but the SAME token opens a parenthesized RECEIVER:
      //   (list << :a; obj).attr, (list << :b; obj).attr = c, d
      // is how ruby/spec pins the evaluation order of a multiple assignment.
      // Which one it is shows up AFTER the matching close paren -- a group is
      // followed by `,` or `=`, a receiver by a call -- and reading every `(`
      // as a group made the whole file a parse error, so language/
      // assignments_spec never ran a single example.
      (match after_x_lparen r 1 with
       | Cons (TP nxt, _) ->
         if str_eq nxt "." || str_eq nxt "&." || str_eq nxt "::"
            || str_eq nxt "[" || str_eq nxt " [" then
           (let (e0, r1) = parse_primary toks in parse_x_chain e0 r1)
         else (let (ts, r2) = parse_x_group r Nil in (EArr ts, r2))
       | _ -> (let (ts, r2) = parse_x_group r Nil in (EArr ts, r2)))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")
  // Every other token kind, and the empty list. The two arms above are
  // `Cons (TId ..)` and `Cons (TP ..)`, so a `TStr` or a `TInt` in a target
  // position fell through as well -- the exhaustiveness checker compares
  // top-level constructors only, so it could name `Nil` but not that. `Nil`
  // itself looks unreachable (lex_go always appends TEOF, and the only thing
  // that strips it builds interpolation sublists that get spliced into a
  // longer stream) -- but not needing to prove that is the point. Both get the
  // refusal the line above already writes for a `TP` that is not `(`, because
  // neither is a target and neither has an answer to invent.
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

// the tokens AFTER the paren group whose open has already been consumed --
// a balanced scan, so a nested call or literal inside does not end it early.
and after_x_lparen = fn toks -> fn (depth: int) ->
  match toks with
  | Nil -> Nil
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" || str_eq p " (s" then
      after_x_lparen r (depth + 1)
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth <= 1 then r else after_x_lparen r (depth - 1))
    else after_x_lparen r depth
  | Cons (_, r) -> after_x_lparen r depth
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

and parse_x_group = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx ")" || str_eq nx "," then (ESplat ENil, r0)
            else let (i, r1) = parse_x_target1 r0 in (ESplat i, r1)
          | _ -> let (i, r1) = parse_x_target1 r0 in (ESplat i, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // a grouped target list may WRAP after its comma, the same way the outer
      // list may: ruby/spec writes one nested group across five lines. Leaving
      // the newline in place made the next target a TNL, which is not an
      // assignment target -- "bad assignment target" for a perfectly ordinary
      // continuation line.
      (match skip_nls r2 with
       // `(e,)` — a trailing comma inside the group
       | Cons (TP rp, r3) ->
         if str_eq rp ")" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_group (skip_nls r2) (Cons (t, acc))
       | _ -> parse_x_group (skip_nls r2) (Cons (t, acc)))
    else if str_eq p ")" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or ) in grouped target, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated grouped target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated grouped target" ++ parsing_file ()))

and parse_x_chain = fn (recv: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (EMethod (recv, m, Nil)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else if str_eq p "[" then
      let (idxs, r2) = parse_x_idx r Nil in
      parse_x_chain (EMethod (recv, "[]", idxs)) r2
    else if str_eq p "&." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (ESafe (recv, m, Nil)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else if str_eq p "::" then
      (match r with
       // (`c::foo, c::bar = 1, 2`: a lowercase name after `::` is the
       //  attribute writer, as after `.`)
       | Cons (TId cn, r2) when (if is_upper_first cn then false else true) -> parse_x_chain (EMethod (recv, cn, Nil)) r2
       | Cons (TId cn, r2) ->
         let recv2 = (match recv with EVar n -> (if is_upper_first n then EConst n else recv) | _ -> recv) in
         parse_x_chain (EScopedRead (recv2, cn)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else (recv, toks)
  | _ -> (recv, toks)

// ruby 4 takes no keywords and no block in an index ASSIGNMENT
// (`h[k: 1] = 2`, `h[**kw] += 1`, `h[&b] = 2`): parse.y refuses them as it
// reads the target, keywords first.
and idx_asgn_refuse = fn (idxs: Expr list) ->
  let rec has9 = fn (xs: Expr list) -> fn (kw: bool) ->
    (match xs with
     | Nil -> false
     | Cons (EKwHash _, _) when kw -> true
     | Cons (EBlockPass _, _) when (if kw then false else true) -> true
     | Cons (_, t9) -> has9 t9 kw) in
  if has9 idxs true then syn_refuse "keyword arg given in index assignment"
  else if has9 idxs false then syn_refuse "block arg given in index assignment"
  else ()
and parse_x_idx = fn toks -> fn (acc: Expr list) ->
  // an index may be written across lines -- `new_site[\n  /re/, 1\n]`
  // (addressable) -- so newlines are skipped where a paren-less argument list
  // would skip them: before an index, and after each comma.
  let toks = skip_nls toks in
  // `recv[k: v, ...]` — labels are one trailing Hash argument, the same as
  // `recv[k => v]`, and `Hash[a: 1]` is how ruby's own specs write it.
  // ⚠ ...and it is KEYWORDS, as in a call: `C[amount: 42]` reaches a
  //   `def self.[](*a, **k)` as k. A plain Hash here made it the one
  //   positional argument (Data's `Measure[amount: 42, unit: "km"]`).
  // A pair may be any of `k: v`, `"k": v`, `k => v`, `**h`, in any mix, and
  // the list may end with a comma and a newline before the `]` -- test_hash
  // builds every fixture as `@cls[\n  1 => 'one', ...,\n]`.
  match toks with
  | Cons (TId lbl, Cons (TP lc, _)) when str_eq lc ":" -> idx_hash_go toks acc Nil
  | Cons (TStrL _, Cons (TP lc, _)) when str_eq lc ":" -> idx_hash_go toks acc Nil
  | Cons (TP dsp, _) when str_eq dsp "**" -> idx_hash_go toks acc Nil
  | _ ->
  let (e, r) =
    (match toks with
     | Cons (TP st, r0) ->
       if str_eq st "*" then let (i, r1) = parse_expr r0 in (ESplat i, r1)
       // `recv[&blk]` — a block-pass index argument (recv.[](&blk)).
       else if str_eq st "&" || str_eq st " &" then let (i, r1) = parse_expr r0 in (EBlockPass i, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match skip_nls r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TP rb, r3) when str_eq rb "]" -> (rev_app (Cons (e, acc)) Nil, r3)
       | _ -> parse_x_idx r2 (Cons (e, acc)))
    else if str_eq p "]" then (rev_app (Cons (e, acc)) Nil, r2)
    // `recv[k => v, ...]` — the pairs form a single trailing Hash argument
    // (this is how Hash[1 => 2] and obj[k => v] are written).
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in idx_hash_more r3 acc (Cons (v, Cons (e, Nil)))
    else if str_eq p ":" then
      let (v, r3) = parse_expr (skip_nls r2) in idx_hash_more r3 acc (Cons (v, Cons (str_label_key e, Nil)))
    else (let __fm = ("mere-ruby: expected , or ] in index target, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated index target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated index target" ++ parsing_file ()))

// the index's trailing hash (KEYWORDS, as in a call), from a pair's start
and idx_hash_go = fn toks -> fn (acc: Expr list) -> fn (hp: Expr list) ->
  let (hp2, r) = parse_bare_pair toks hp in idx_hash_more r acc hp2
and idx_hash_more = fn r -> fn (acc: Expr list) -> fn (hp: Expr list) ->
  match skip_nls r with
  | Cons (TP p, r2) ->
    if str_eq p "]" then (rev_app (Cons (EKwHash (rev_app hp Nil), acc)) Nil, r2)
    else if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TP rb, r3) when str_eq rb "]" -> (rev_app (Cons (EKwHash (rev_app hp Nil), acc)) Nil, r3)
       // ...and a block-pass may follow the pairs: `o[**o, &b]`
       | Cons (TP am, r3) when str_eq am "&" || str_eq am " &" ->
         (let (bp, r4) = parse_expr r3 in
          match skip_nls r4 with
          | Cons (TP rb, r5) when str_eq rb "]" ->
            (rev_app (Cons (EBlockPass bp, Cons (EKwHash (rev_app hp Nil), acc))) Nil, r5)
          | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected ] after a block argument" ++ parsing_file ()))) in fail ("mere-ruby: expected ] after a block argument" ++ parsing_file ())))
       | rr -> idx_hash_go rr acc hp)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or ] in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected , or ] in index hash" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated index hash" ++ parsing_file ()))) in fail ("mere-ruby: unterminated index hash" ++ parsing_file ()))

// does this statement look like a complex multiple assignment? Scan to a
// top-level `=` requiring a top-level `,` first; two adjacent value tokens
// (a paren-less command call) or a structural keyword call it off.
and looks_like_multix = fn toks ->
  match toks with
  // `self.a, self.b = ...` — self is a keyword, but here it is the receiver of
  // an attribute writer, which is a perfectly ordinary assignment target.
  | Cons (TId nm, r0) ->
    // ...and `self[k1], self[k2] = ...` / `self::A, self::B = ...`, which are
    // the same thing through []= and a constant write. Only `.` was allowed,
    // so a `def assign` that writes two subscripts of self -- which is how
    // ruby/spec checks that form at all -- was not read as an assignment.
    if str_eq nm "self" then
      (match r0 with
       | Cons (TP d, _) ->
         (str_eq d "." || str_eq d "[" || str_eq d " [" || str_eq d "::")
         && scan_mx toks 0 false false
       | _ -> false)
    else if is_keyword nm then false else scan_mx toks 0 false false
  // a leading group: a comma or splat at depth 1 marks targets too ((*a) = ...)
  | Cons (TP lp, r) ->
    if str_eq lp "(" then scan_mx toks 0 false true
    // (a top-level constant is a target too: `::FOO, ::BAR = 1, 2`)
    else if str_eq lp "::" || str_eq lp " ::" then scan_mx toks 0 false false
    // a leading splat is itself a target (* = 1, *a = ...), if an = follows.
    else if str_eq lp "*" then scan_mx r 0 true false
    else false
  | _ -> false

and scan_mx = fn toks -> fn (depth: int) -> fn (seen: bool) -> fn (grp: bool) ->
  match toks with
  | Nil -> false
  // A newline (or a `;`, which lexes as one) INSIDE parens does not end the
  // statement -- `(list << :a; obj).attr, ... = ...` is one assignment, and
  // stopping here said it was not a multiple assignment at all. The whole of
  // language/assignments_spec then failed to parse on that one line.
  | Cons (TNL _, r) -> if depth > 0 then scan_mx r depth seen grp else false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) ->
    if str_eq w "do" || str_eq w "then" || str_eq w "if" || str_eq w "unless" ||
       str_eq w "while" || str_eq w "until" || str_eq w "and" || str_eq w "or" ||
       str_eq w "rescue" then false
    else
      (match r with
       | Cons (TId _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TInt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TFlt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TStrL _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TSym _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       // ...and an interpolated string is a value too: `m.module_eval "#{n} = 42",
       // __FILE__, line = __LINE__` is a command call whose last argument
       // assigns, not three targets
       | Cons (TP "(s", _) -> if depth == 0 then false else scan_mx r depth seen grp
       | _ -> scan_mx r depth seen grp)
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      scan_mx r (depth + 1) seen grp
    // a close at depth 0 belongs to a group around the statement: the
    // statement ends there. Inside `(V).each {|b, i = 1| ... }` the scan went
    // on past the `)` and read the block's `|b, i = 1|` as `targets = rhs`.
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth == 0 then false else scan_mx r (depth - 1) seen grp)
    // a target list may wrap right after a comma (`a, b,\n  c = rhs`)
    else if depth == 0 && str_eq p "," then scan_mx (skip_nls r) depth true grp
    else if grp && depth == 1 && (str_eq p "," || str_eq p "*") then scan_mx r depth true grp
    else if depth == 0 && str_eq p "=" then seen
    else if depth == 0 && str_eq p "?" then false
    else if depth == 0 && (if str_eq (opassign_base p) "" then false else true) then false
    else scan_mx r depth seen grp
  | Cons (_, r) -> scan_mx r depth seen grp

and parse_target_list = fn toks -> fn (acc: str list) ->
  let (t, r) = parse_one_target toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_target_list r2 (Cons (t, acc))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or = in multiple assignment, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))) in fail ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))

and parse_one_target = fn toks ->
  match toks with
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with Cons (TId nm, r2) -> ("*" ++ nm, r2) | _ -> ("*", r))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")
  | Cons (TId nm, r) -> (nm, r)   // plain local, or @ivar (@ kept in the name)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

// the RHS of `a = ...`: one value, or a comma list / splat that builds an
// array (`a = 1, 2` and `a = *nil`).
// `x = case/if/begin ... end` — but a trailing binary operator turns the
// construct into an operand of a larger expression (case..end + case..end).
and construct_assign = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  match r4 with
  | Cons (TP op, _) ->
    // `x = if ... end.method` — the construct is the receiver of a chain, the
    // same way `if ... end.method` reads as a statement.
    if str_eq op "." || str_eq op "&." || str_eq op "[" then
      (let (e0, r5) = parse_postfix_more (EStmt sb) r4 in
       let (e, r6) = parse_more e0 r5 1 in (SAssign (id, e), r6))
    else if prec_of op > 0 then
      let (e, r5) = parse_more (EStmt sb) r4 1 in (SAssign (id, e), r5)
    else construct_target id sb r4
  | _ -> construct_target id sb r4

// `NAME = case/if/begin ... end`: a CONSTANT target has to reach the consts
// table (concurrent-ruby picks its map backend with `X = case ... end`), so
// the construct becomes the right-hand side of an ordinary assignment. A
// lowercase target keeps the local-binding path.
and construct_target = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  if is_cap id then (SAssign (id, EStmt sb), r4) else (SLocalFrom (id, sb), r4)

and sassign_rhs = fn (id: str) -> fn toks ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (single, Nil) ->
     (match single with
      | ESplat _ -> (SAssign (id, EArr es), r)
      | _ -> (SAssign (id, single), r))
   | _ -> (SAssign (id, EArr es), r))

// `break 1, 2` / `next a, b` — several values build an array.
and flow_values = fn toks -> fn (mk: Expr -> Stmt) ->
  let (es, r) = flow_rhs toks in
  (match es with
   | Cons (e, Nil) -> (match e with ESplat _ -> (mk (EArr es), r) | _ -> (mk e, r))
   | _ -> (mk (EArr es), r))

// the value list of break / next / return. `break true or false` is
// `(break true) or false`: the jump has no value to be the left side of
// `or` / `and` -- ruby's "unexpected void value expression"
and flow_rhs = fn toks ->
  let (es, r) = parse_rhs_list toks Nil in
  let _ = (match r with
           | Cons (TId w, _) when str_eq w "or" || str_eq w "and" -> syn_refuse "unexpected void value expression"
           | _ -> ()) in
  (es, r)
and parse_rhs_list = fn toks -> fn (acc: Expr list) ->
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    // a newline after the comma continues the list, as ruby's does
    // (`private_constant :A,\n                  :B`).
    if str_eq p "," then parse_rhs_list (skip_nls r2) (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// the read side of a constant op-assign: `||=` treats an undefined constant as
// nil (then assigns); every other op reads it first (NameError if undefined).
and opasgn_const_read = fn (base: str) -> fn (full: str) ->
  if str_eq base "||" then EConstOrNil full else EConst full

and parse_stmt = fn toks ->
  let d9 = (if map_has stmt_nest "d" then map_get stmt_nest "d" else 0) in
  let _ = map_set stmt_nest "d" (d9 + 1) in
  let r9 = parse_stmt_at toks in
  let _ = map_set stmt_nest "d" d9 in
  r9
and parse_stmt_at = fn toks ->
  // a keyword that names a value is no variable: `nil = true` is ruby's
  // "Can't assign to nil" (and `self = 1` "Can't change the value of self")
  let _ = (match toks with
           | Cons (TId w, Cons (TP eq, _)) when (str_eq eq "=" || (if str_eq (opassign_base eq) "" then false else true))
                                                && (str_eq w "nil" || str_eq w "true" || str_eq w "false" || str_eq w "self"
                                                    || str_eq w "__FILE__" || str_eq w "__LINE__" || str_eq w "__ENCODING__") ->
             syn_refuse (if str_eq w "self" then "Can't change the value of self" else "Can't assign to " ++ w)
           | _ -> ()) in
  if looks_like_multix toks then parse_multix toks
  else if looks_like_multi toks then parse_multi toks else
  match toks with
  // scoped constant assignment: `A::C = e` / `A::B::C = e` / `::C = e`.
  | Cons (TId a, Cons (TP sc, Cons (TId cn, Cons (TP eq, r)))) ->
    if str_eq sc "::" && (if is_cap a then false else true) && is_cap cn && str_eq eq "=" then
      // `recv::Const = value` with a lowercase (runtime) receiver.
      // ⚠ ...which may be an INSTANCE VARIABLE: `@module::PUBLIC1 = v` read
      //   `@module` as a local of that name and raised "undefined local
      //   variable or method '@module'" -- the whole of
      //   core/module/deprecate_constant_spec's before block. The expression
      //   form (`p(@m::X = 1)`) already went through parse_primary's ivar.
      let recv9 = (if is_ivar a then EIVar (substring a 1 (str_len a)) else EVar a) in
      let (e, r2) = parse_expr r in (SExpr (EScopedAssign (recv9, cn, e)), r2)
    else if str_eq sc "::" && is_cap a && is_cap cn then
      (if str_eq eq "=" then
         let (e, r2) = parse_expr (skip_nls r) in (SAssign (a ++ "::" ++ cn, e), r2)
       else if not (str_eq (opassign_base eq) "") then
         // `A::C op= e` -> `A::C = A::C op e`. `||=` reads undefined as nil;
         // other ops read first, so an undefined constant raises NameError.
         let full = a ++ "::" ++ cn in
         let (e, r2) = parse_expr (skip_nls r) in
         (const_opasgn full full (opassign_base eq) e, r2)
       else if str_eq eq "::" then
         (match scoped_const_path (a ++ "::" ++ cn) r with
          | (full, r2b) ->
            (match r2b with
             | Cons (TP eq2, r3) ->
               if str_eq eq2 "=" then let (e, r4) = parse_expr (skip_nls r3) in (SAssign (full, e), r4)
               // `A::B::C op= e` -> `A::B::C = A::B::C op e` (nil read when undefined).
               else if not (str_eq (opassign_base eq2) "") then
                 let (e, r4) = parse_expr (skip_nls r3) in
                 (const_opasgn full full (opassign_base eq2) e, r4)
               else parse_stmt_id toks
             | _ -> parse_stmt_id toks))
       else parse_stmt_id toks)
    else parse_stmt_id toks
  | Cons (TP sc, Cons (TId cn, Cons (TP eq, r))) ->
    if str_eq sc "::" && str_eq eq "=" && is_cap cn then
      // `::Const = v` assigns a TOP-LEVEL constant; keep the :: so a class
      // body doesn't treat it as a class-local constant.
      let (e, r2) = parse_expr (skip_nls r) in (SAssign ("::" ++ cn, e), r2)
    else if str_eq sc "::" && is_cap cn && (if str_eq (opassign_base eq) "" then false else true) then
      // `::Const op= e` -> `::Const = ::Const op e`. The write target keeps the
      // `::` (stored top-level as the bare name), so the read uses the bare name.
      let (e, r2) = parse_expr (skip_nls r) in
      (const_opasgn ("::" ++ cn) ("::" ++ cn) (opassign_base eq) e, r2)
    else let (e, r2) = parse_expr toks in (SExpr e, r2)
  | Cons (TId id, r) -> parse_stmt_id toks
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

// `C op= e` for a scoped or top-level constant: `||=` assigns only when the
// constant is undefined or falsy, `&&=` only when it is truthy, and either
// otherwise answers the value it read -- an assignment of the same value
// again is ruby's "already initialized constant" warning
and const_opasgn = fn (target: str) -> fn (rd: str) -> fn (op: str) -> fn (e: Expr) ->
  let read9 = opasgn_const_read op rd in
  if str_eq op "||" then SIf (Cons ((read9, Cons (SExpr read9, Nil)), Nil), Cons (SAssign (target, e), Nil))
  else if str_eq op "&&" then SIf (Cons ((read9, Cons (SAssign (target, e), Nil)), Nil), Cons (SExpr read9, Nil))
  else SAssign (target, EBin (op, read9, e))
and parse_stmt_id = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    // A command word is a command only when it is not being ASSIGNED. `require`,
    // `puts`, `include`, `private` are ordinary method names, so they are
    // ordinary local names too, and real code uses them as such (rubocop writes
    // `require = injectable_require_directive.chomp`). Ruby's own keywords are
    // excluded: those cannot be assigned at all, so `if = 1` stays an error.
    // (an @ivar / @@cvar is an assignment too, but it has its own branch below,
    // and routing it here would silently make it a local -- which is a local
    // that nothing else ever reads.)
    if (not (is_keyword id)) && (not (is_ivar id))
       && (match r with
           | Cons (TP eq, _) -> str_eq eq "=" || not (str_eq (opassign_base eq) "")
           | _ -> false) then parse_stmt_ident toks id r
    // BEGIN { ... } / END { ... } — run the block body (BEGIN at load time).
    else if (str_eq id "BEGIN" || str_eq id "END") &&
       (match r with Cons (TP br, _) -> str_eq br "\{" | _ -> false) then
      (match r with
       | Cons (TP br, r2) ->
         let d9 = (if map_has stmt_nest "d" then map_get stmt_nest "d" else 0) in
         let p9 = (if map_has stmt_nest "p" then map_get stmt_nest "p" else 0) in
         let _ = (if str_eq id "BEGIN" && d9 != 1 && d9 != p9
                  then syn_refuse "BEGIN is permitted only at toplevel" else ()) in
         let _ = (if str_eq id "BEGIN" then map_set stmt_nest "p" (d9 + 1) else ()) in
         let (body, r3) = parse_brace_stmts r2 Nil in
         let _ = (if str_eq id "BEGIN" then map_set stmt_nest "p" p9 else ()) in
         // (END inside a method is legal and ruby warns about it)
         let _ = (if str_eq id "END" && map_has def_depth "n" && map_get def_depth "n" > 0
                  then print_err ((let f9 = parse_time_file () in if str_eq f9 "" then "-" else f9)
                                  ++ ":" ++ str_of_int (tok_line r + (if map_has parse_lshift "n" then map_get parse_lshift "n" else 0))
                                  ++ ": warning: END in method; use at_exit")
                  else ()) in
         (if str_eq id "BEGIN" then SPreexe body
          else (let n = end_site_next () in SAtExit (n, body)), r3)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block after BEGIN" ++ parsing_file ()))) in fail ("mere-ruby: expected block after BEGIN" ++ parsing_file ())))
    else if str_eq id "puts" &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      (match r with
       | Cons (TNL _, _) -> (SPuts Nil, r)
       | Cons (TEOF, _) -> (SPuts Nil, r)
       // `puts if c` / `puts unless c`: a statement modifier, not an argument.
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" ||
            str_eq w "until" || str_eq w "rescue" then (SPuts Nil, r)
         else (let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
       | _ -> let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
    else if str_eq id "if" then let (s, r2) = parse_if r false in stmt_postfix s r2
    else if str_eq id "unless" then let (s, r2) = parse_if r true in stmt_postfix s r2
    else if str_eq id "while" then let (s, r2) = parse_while r false in stmt_postfix s r2
    else if str_eq id "until" then let (s, r2) = parse_while r true in stmt_postfix s r2
    else if str_eq id "case" then let (s, r2) = parse_case r in stmt_postfix s r2
    else if str_eq id "for" then let (s, r2) = parse_for r in stmt_postfix s r2
    else if str_eq id "def" then let (s, r2) = parse_def_counted r in stmt_postfix s r2
    else if str_eq id "class" then let (s, r2) = parse_class r in stmt_postfix s r2
    else if str_eq id "module" then let (s, r2) = parse_class r in stmt_postfix (mark_module s) r2
    else if str_eq id "begin" then let (s, r2) = parse_begin r in stmt_postfix s r2
    // `attr_accessor :a, :b` names the attributes statically, but these are
    // methods: `attr_writer name` passes a variable. A non-symbol argument
    // makes it an ordinary call.
    // ...and a bare mention with no argument at all is not a declaration either:
    // `attr_accessor` is an ordinary name, and rubocop keeps a local called
    // exactly that (`attr_accessor = "attr_accessor #{names}"`). So this reads
    // as an attribute declaration only when something that can BE an attribute
    // name follows; anything else falls through to the ordinary identifier path.
    else if (str_eq id "attr_accessor" || str_eq id "attr_reader" || str_eq id "attr_writer")
            && (match r with
                | Cons (TSym _, _) -> true
                | Cons (TStrL _, _) -> true
                | Cons (TId _, _) -> true
                | Cons (TP st, _) -> str_eq st "*" || str_eq st " *" || str_eq st "("
                | _ -> false) then
      (let mode = (if str_eq id "attr_accessor" then "rw" else if str_eq id "attr_reader" then "r" else "w") in
       match r with
       | Cons (TSym _, _) ->
         if attr_plain_list r then parse_attr mode r
         else let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall (id, es))) r2
       | _ -> let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall (id, es))) r2)
    // `attr :sym` (and `attr :a, :b`) is the classic reader-only form.
    else if str_eq id "attr" && (match r with Cons (TSym _, _) -> true | _ -> false) then parse_attr "r" r
    // `alias :"foo_#{i}" :"foo_#{i}"`: a name that is an interpolation the
    // parser cannot fold is the alias of the scope at run time, alias_method
    // with the two symbols the expressions make
    else if str_eq id "alias" && (alias_dyn_at r || alias_dyn_at (alias_skip_name r)) then
      (let (e1, r1) = alias_name_expr r in
       let (e2, r2) = alias_name_expr r1 in
       (SExpr (ECall ("alias_method", Cons (e1, Cons (e2, Nil)))), r2))
    else if str_eq id "alias" then
      // `alias new old` — names may be bare or :symbols.
      let (n1, r1) = parse_alias_name r in
      let (n2, r2) = parse_alias_name r1 in
      // (a numbered match variable has no alias: `alias $foo $1`)
      let _ = (if str_len n1 > 0 && str_eq (char_at n1 0) "$" && str_len n2 >= 2 && str_eq (char_at n2 0) "$" && is_digit (char_at n2 1)
               then syn_refuse "can't make alias for the number variables" else ()) in
      (SAlias (n1, n2), r2)
    else if str_eq id "undef" then
      let (names, r2) = parse_undef_names r Nil in apply_modifier (SUndef names) r2
    // `undef_method :a, :b` names methods statically, but it is a method, not
    // a keyword: `undef_method(name) if defined?` passes a variable and takes
    // a modifier, so anything that does not start with a symbol is a call.
    else if str_eq id "undef_method" then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in apply_modifier (SUndef names) r2
       | _ -> let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall ("undef_method", es))) r2)
    else if (str_eq id "include" || str_eq id "prepend") &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      // `include M[, N]` — mix module instance methods in (first module only
      // for now; extra modules are consumed and ignored).
      (match r with
       // `include Rails.application.routes.url_helpers` — the module is the
       // value of an expression, so this is a real call, resolved at run time.
       | Cons (TId m, Cons (TP dot, _)) when str_eq dot "." ->
         (let (es, r2) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r2))
       | Cons (TId m, r2) ->
         (let (full, r2b) = scoped_name m r2 in
          // `include ModuleSpecs::MVars.dup` — a scoped name with a CALL on
          // it is a value like any other, so it resolves at run time. Only a
          // bare path is the static form.
          match r2b with
          | Cons (TP dt3, _) when str_eq dt3 "." ->
            (let (es, r4) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r4))
          // ⚠ `include A, B` includes BOTH: the extra names used to be consumed
          //   and dropped ("first module only for now"), so a class that wrote
          //   its mixins on one line had one of them. The list is the call
          //   form, which takes as many as it is given.
          | Cons (TP cm3, _) when str_eq cm3 "," ->
            (let (es, r4) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r4))
          | _ -> let (_, r3) = maybe_more_names r2b in (SInclude (full, str_eq id "prepend"), r3))
       // `include ::A::B` — a path anchored at the top level reads the same
       // here, because constants are stored under their qualified name.
       | Cons (TP sc, Cons (TId m, r2)) when str_eq sc "::" || str_eq sc " ::" ->
         (let (full, r2b) = scoped_name m r2 in
          let (_, r3) = maybe_more_names r2b in (SInclude (full, str_eq id "prepend"), r3))
       // `include(M, N)` — the parenthesised form, which takes as many modules
       // as it is given. It used to fall through to an empty expression that
       // consumed nothing: with one module the leftover `(M)` parsed as a
       // statement of its own and the include silently did NOTHING.
       | Cons (TP lp, r2) when is_lparen lp ->
         (let (es, r3) = parse_call_args r2 in (SExpr (ECall (id, es)), r3))
       // ...and NO argument is the call too -- ruby's ArgumentError, where it
       // was a statement that did nothing
       | Cons (TNL _, _) -> (SExpr (ECall (id, Nil)), r)
       | Cons (TEOF, _) -> (SExpr (ECall (id, Nil)), r)
       | Cons (TP p3, _) when str_eq p3 "}" || str_eq p3 ";" -> (SExpr (ECall (id, Nil)), r)
       | Cons (TId e3, _) when str_eq e3 "end" -> (SExpr (ECall (id, Nil)), r)
       | _ -> (SExpr ENil, r))
    // The parenthesised form (`private(*names)`) is left to the ordinary call
    // path below: its arguments can be computed at runtime, which a static
    // SVis name list cannot express.
    else if (str_eq id "private" || str_eq id "public" || str_eq id "protected") &&
            // `private.should ...` — a bare visibility call used as a RECEIVER
            // (it answers nil). A `.` after the word means it is an expression,
            // not the statement form that switches the mode.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." then false else true) | _ -> true) &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      // visibility: bare form switches the mode for subsequent defs; the
      // named form (`private :m, :n`) marks those methods.
      let mode = if str_eq id "public" then "public" else if str_eq id "protected" then "protected" else "private" in
      // ⚠ Anything after the word that is not a symbol list, `def` or a body
      //   terminator is an ARGUMENT EXPRESSION, and it used to be parsed and
      //   THROWN AWAY: `protected m` (a variable holding the name),
      //   `private *names`, `private attr_reader(:x)` all became a no-op
      //   statement, so the method stayed public and nothing said so. They are
      //   calls now, which the dispatcher's visibility arm already answers --
      //   the same arm the parenthesised form has always reached.
      (match r with
       | Cons (TNL _, _) -> (SVis (mode, Nil), r)
       | Cons (TEOF, _) -> (SVis (mode, Nil), r)
       // ...and the two tokens that close a body without a newline first.
       // `module_eval { module_function }` and `Module.new { private }` are
       // written that way in ruby/spec, and the bare form was recognised only
       // before a newline, so `}` was read as the start of an argument.
       | Cons (TP cb, _) -> (if str_eq cb "\}" then (SVis (mode, Nil), r)
                             else let (es9, r2) = parse_rhs_list r Nil in
                               // `private [:a, :b]` -- one array of symbols -- is the
                               // same statement as `private :a, :b`
                               (match es9 with
                                | Cons (EArr items9, Nil) when vis_all_syms items9 -> (SVis (mode, vis_sym_names items9), r2)
                                | _ -> (SExpr (ECall (id, es9)), r2)))
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis (mode, names), r2)
       // `private def m ... end` — the arg is a method definition; parse it,
       // then mark it (def evaluates to its name symbol in Ruby).
       | Cons (TId dw, _) ->
         // `end` closes the body; it is not an argument (`module_eval { private
         // }`'s do-form, `class C; private; end`).
         if str_eq dw "end" then (SVis (mode, Nil), r)
         else if str_eq dw "def" then
           (let (ds, r2) = parse_stmt r in
            match ds with
            | SDef (dn, _, _, _) ->
              let base = if str_len dn > 5 && str_eq (substring dn 0 5) "self." then dn else dn in
              (SBegin (Cons (ds, Cons (SVis (mode, Cons (base, Nil)), Nil)), Nil, Nil, Nil), r2)
            | _ -> (ds, r2))
         else let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2)
       | _ -> let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
    else if (str_eq id "require" || str_eq id "require_relative") &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) &&
            // ⚠ ...and the same question has to be asked AFTER a parenthesised
            //   argument list, not only right after the word: `.should` there
            //   chains onto the call's RESULT, and ruby/spec writes exactly
            //   that (`require_relative(@path).should == true`). Falling
            //   through to the ordinary expression statement is the fix, and
            //   the expression form (__builtin_require_relative) already
            //   exists -- it joins against the loader's current directory at
            //   RUN time rather than the written-in file at parse time, which
            //   is the same answer except for a call inside a block that runs
            //   after its own file finished loading.
            (if tok_chains (after_parens r) then false else true) then
      // load a file into the same world (each file gets a fresh top-level).
      let (e, r2) = parse_expr r in
      // A `require_relative` means "next to the file I am written in", which is
      // not always the file the loader is in when it runs (see
      // parse_time_file). Join it here instead: the result is an absolute path,
      // so `require` uses it directly rather than searching $LOAD_PATH -- and
      // ruby's own LoadError for a missing sibling names the expanded path too.
      // ...and it is still require_relative that is CALLED: it is a frame of
      // its own ('Kernel#require_relative' in the backtrace of the file it
      // loads), and a library that replaces #require does not see it. The
      // loader takes an absolute path as it is, relative or not.
      (let src = parse_time_file () in
       if str_eq id "require_relative" && (if str_eq src "" then false else true)
       then (SRequire (true, ECall ("__builtin_relpath", Cons (EStrL src, Cons (e, Nil)))), r2)
       else (SRequire (str_eq id "require_relative", e), r2))
    // bare `module_function` switches the enclosing module body into a mode
    // where subsequent defs are also module methods (see register_class_v).
    else if str_eq id "module_function" &&
            // as above: `module_function.should ...` is a receiver, not the
            // statement that switches the mode
            (match r with Cons (TP dt2, _) -> (if str_eq dt2 "." then false else true) | _ -> true) &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TNL _, _) -> (SVis ("module_function", Nil), r)
       | Cons (TEOF, _) -> (SVis ("module_function", Nil), r)
       // as for `private`: `}` closes the body, it does not start an argument.
       | Cons (TP cb2, _) -> (if str_eq cb2 "\}" then (SVis ("module_function", Nil), r)
                              else let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
       | Cons (TId ew2, _) ->
         (if str_eq ew2 "end" then (SVis ("module_function", Nil), r)
          else let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
       // `module_function :a, :b` promotes those named methods (handled in
       // register_class_v's named-SVis branch).
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("module_function", names), r2)
       | _ -> let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
    // `private_class_method :m` marks a class method private (in register_class_v).
    else if str_eq id "private_class_method" &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_class_method", names), r2)
       | _ -> let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
    else if str_eq id "private_constant" &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_constant", names), r2)
       // (bare, it names nothing -- and -w says so; any other argument form
       // is a real call: `private_constant "X"` and `private_constant *names`
       // were parsed and thrown away)
       | Cons (TNL _, _) -> (SVis ("private_constant", Nil), r)
       | Cons (TEOF, _) -> (SVis ("private_constant", Nil), r)
       | _ -> let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
    // `public_class_method :m` undoes private_class_method (it was parsed as a
    // no-op, so a hidden class method stayed hidden and a missing name passed);
    // any other argument form is a real call
    else if str_eq id "public_class_method" &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("public_class_method", names), r2)
       | Cons (TNL _, _) -> (SExpr ENil, r)
       | Cons (TEOF, _) -> (SExpr ENil, r)
       | _ -> let (es9, r2) = parse_rhs_list r Nil in (SExpr (ECall (id, es9)), r2))
    else if str_eq id "extend" &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true)
            // ...and an OPENING PAREN makes it an ordinary call whose result
            // can be chained: `extend(Comparable).equal?(self)` is
            // `(extend(Comparable)).equal?(self)`, but the paren-less argument
            // form below read the whole tail as the ARGUMENT and passed
            // `Comparable.equal?(self)` -- false -- to extend.
            && (match r with Cons (TP op, _) -> (if str_eq op "(" then false else true) | _ -> true) then
      // `extend M` mixes a module's instance methods into the receiver's
      // singleton class (self, in a class/module body). Parse as a real call
      // so the eval-time handler records the singleton include.
      (match r with
       | Cons (TNL _, _) -> (SExpr (ECall ("extend", Nil)), r)
       | Cons (TEOF, _) -> (SExpr (ECall ("extend", Nil)), r)
       // `Module.new { extend }` -- nothing to extend with, ruby's
       // ArgumentError at run time (test_module)
       | Cons (TP cl, _) when str_eq cl "}" || str_eq cl ")" || str_eq cl "]" -> (SExpr (ECall ("extend", Nil)), r)
       // `extend ::A::B` — a leading "::" only anchors at the top level here,
       // where a value has to start; `a::B` elsewhere is still scope
       // resolution on `a`, so this is not a general paren-less argument form.
       | Cons (TP sc, Cons (TId m, r2)) ->
         if str_eq sc "::" || str_eq sc " ::"
         // (anchored: inside a BasicObject subclass nothing lexical reaches
         //  Object's constants, and `extend ::Forwardable` was looked up as
         //  Foo2::Forwardable -- test_forwardable)
         then (let (full, r2b) = scoped_name m r2 in (SExpr (ECall ("extend", Cons (EConst ("::" ++ full), Nil))), r2b))
         else (let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
       | _ -> let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
    else if str_eq id "return" then
      (match r with
       | Cons (TNL _, _) -> (SReturn ENil, r)
       | Cons (TEOF, _) -> (SReturn ENil, r)
       // `return if c` / `return unless c` — a value-less return under a
       // statement modifier (the caller attaches the modifier).
       // (...and a value-less return before the clause keyword of the block
       //  it is in: `begin return ensure end`, `begin return rescue end`)
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" || str_eq w "until"
            || str_eq w "ensure" || str_eq w "rescue" || str_eq w "else" || str_eq w "end" || str_eq w "elsif" || str_eq w "when" || str_eq w "in" then (SReturn ENil, r)
         else
           let (es, r2) = flow_rhs r in
           (match es with
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | Cons (TP rp, _) ->
         if str_eq rp "}" || str_eq rp ")" || str_eq rp ";" then (SReturn ENil, r)
         else
           let (es, r2) = flow_rhs r in
           (match es with
            // `return *x` returns an array (splat-coerced), like `return a, b`.
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | _ ->
         // `return a, b` returns an array of the values.
         let (es, r2) = flow_rhs r in
         (match es with
          | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
          | _ -> (SReturn (EArr es), r2)))
    else if str_eq id "break" then
      (match r with
       | Cons (TNL _, _) -> (SBreak ENil, r)
       | Cons (TEOF, _) -> (SBreak ENil, r)
       // `break k, visit(v)` hands back BOTH values, as an Array, whatever the
       // first one starts with -- a name went through parse_expr alone and
       // the `, visit(v)` was left over (rubygems' safe_marshal to_ruby.rb).
       | Cons (TId k, _) -> if stops_value k then (SBreak ENil, r) else flow_values r (fn e -> SBreak e)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SBreak ENil, r)
         else flow_values r (fn e -> SBreak e)
       | _ -> flow_values r (fn e -> SBreak e))
    else if str_eq id "next" then
      (match r with
       | Cons (TNL _, _) -> (SNext ENil, r)
       | Cons (TEOF, _) -> (SNext ENil, r)
       // `next k, visit(v)` hands back BOTH values, as an Array, whatever the
       // first one starts with -- a name went through parse_expr alone and
       // the `, visit(v)` was left over (rubygems' safe_marshal to_ruby.rb).
       | Cons (TId k, _) -> if stops_value k then (SNext ENil, r) else flow_values r (fn e -> SNext e)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SNext ENil, r)
         else flow_values r (fn e -> SNext e)
       | _ -> flow_values r (fn e -> SNext e))
    else if is_ivar id then
      // @name = expr / @name += expr, else an expression (@name read).
      let nm = substring id 1 (str_len id) in
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           let (e, r3) = parse_expr (skip_nls r2) in (SIVarAssign (nm, e), r3)
         else if not (str_eq (opassign_base p) "") then
           let (e, r3) = parse_expr (skip_nls r2) in
           // `@@x ||= v` defines the class variable when it is not defined
           // yet (Ruby special-cases that read); every other op-assign, and
           // every op-assign on an @ivar, reads normally.
           (let base = opassign_base p in
            let readx = (if str_eq base "||" && str_len nm > 0 && str_eq (char_at nm 0) "@"
                         then ECall ("__cvar_or_nil", Cons (EStrL (substring nm 1 (str_len nm)), Nil))
                         else EIVar nm) in
            (SIVarAssign (nm, EBin (base, readx, e)), r3))
         else let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))
    else parse_stmt_ident toks id r
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

// An identifier statement that is none of the command words above: a plain
// `name = ...` local assignment, or any other expression.
and parse_stmt_ident = fn toks -> fn (id: str) -> fn r ->
      // identifier or expression keyword (self/true/false/nil/Const):
      // a plain `name =` is a local assignment; everything else (including
      // method chains and expression keywords) parses as an expression.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" && not (is_keyword id) then
           // assigning to the __ENCODING__ pseudo-variable is a SyntaxError.
           if str_eq id "__ENCODING__" then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: Can't assign to __ENCODING__")) in fail "mere-ruby: Can't assign to __ENCODING__") else
           // `var = begin/case/if/unless ... end` binds the construct's value;
           // otherwise it is an ordinary assignment (`Const = expr` routes to
           // the consts table at eval). A newline may follow the `=`.
           let r2 = skip_nls r2 in
           (match r2 with
            | Cons (TId bg, r3) ->
              if str_eq bg "begin" then let (sb, r4) = parse_begin r3 in construct_assign id sb r4
              else if str_eq bg "case" then let (sb, r4) = parse_case r3 in construct_assign id sb r4
              else if str_eq bg "if" then let (sb, r4) = parse_if r3 false in construct_assign id sb r4
              else if str_eq bg "unless" then let (sb, r4) = parse_if r3 true in construct_assign id sb r4
              // chained assignment `a = b = ... = e` binds right-to-left.
              else if (match r3 with Cons (TP eq2, _) -> str_eq eq2 "=" | _ -> false) && not (is_keyword bg) then
                let (s2, r4) = parse_stmt r2 in (SLocalFrom (id, s2), r4)
              else sassign_rhs id r2
            | _ -> sassign_rhs id r2)
         else if not (str_eq (opassign_base p) "") && not (is_keyword id) && not (is_cap id) then
           // `var += expr` -> `var = var <op> expr`
           let (e0, r30) = parse_expr (skip_nls r2) in
           let (e, r3) = opasgn_resc e0 r30 in
           // (`$g ||= v` reads an unset global without -w's warning, as the
           //  `defined?` ruby's ||= asks first)
           let rd9 = (if str_eq (opassign_base p) "||" && str_len id > 1 && str_eq (char_at id 0) "$"
                      then ECall ("__gvar_or_nil", Cons (EStrL id, Nil)) else EVar id) in
           (SAssign (id, EBin (opassign_base p, rd9, e)), r3)
         else if not (str_eq (opassign_base p) "") && is_cap id then
           // `Const op= expr` — a bare constant op-assign (nil read when undefined).
           let (e, r3) = parse_expr (skip_nls r2) in
           (SAssign (id, EBin (opassign_base p, EConstOrNil id, e)), r3)
         else
           let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))


// `A::B::C` in a class/module header — the flat model keys on the full
// joined name ("A::B") so `.class` etc. report it the way Ruby does.
and parse_qualified_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "::" then (match r with Cons (TId n, r2) -> parse_qualified_name (acc ++ "::" ++ n) r2 | _ -> (acc, toks))
    else (acc, toks)
  | _ -> (acc, toks)

// mark a parsed class statement as a module (sentinel superclass).
and mark_module = fn (s: Stmt) ->
  match s with
  | SClass (n, sup, body) -> if str_eq sup "" then SClass (n, "(module)", body) else s
  | _ -> s

// (a new context for the "nodo" flag, as parse_begin is: `while class Foo;
//  tap do end; end; break; end` gives the do to tap)
and parse_class = fn toks ->
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  // (a class or module body is a scope for shareable_constant_value too: the
  //  mode its comments set ends with it)
  let scv9 = (if map_has scv_mode "m" then map_get scv_mode "m" else "") in
  let res = parse_class_go toks in
  let _ = (if str_eq scv9 "" then map_delete scv_mode "m" else map_set scv_mode "m" scv9) in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  res
and parse_class_go = fn toks ->
  match toks with
  // `class << self ... end` — the singleton class: its defs register as
  // class-level methods of the ENCLOSING class (flat-table model).
  | Cons (TP sc0, r0) ->
    if str_eq sc0 "<<" then
      (match r0 with
       // `class << self` (enclosing class) / `class << obj` (a named receiver):
       // the target name rides in the superclass field (flat-table model).
       | Cons (TId slf, r1) ->
         // an ivar/cvar/global receiver (`class << @obj`) is not an env local,
         // so it must be evaluated as an expression rather than resolved by
         // name; true/false/nil likewise route through SSingletonE.
         // any receiver other than `self` — a local variable, a method call
         // (`class << mock('x')`), or a constant (`class << O`) — is evaluated
         // as an expression so its runtime value's singleton class is opened.
         // Only `self` keeps the enclosing-class (named) path.
         if (if str_eq slf "self" then false else true) then
           let (recv, r2) = parse_expr r0 in
           let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end")
         else
           let (body, r5) = parse_class_body_tail r1 in (SClass ("<<singleton", slf, body), expect_kw r5 "end")
       // `class << <expr>` — a paren-expr / literal / ivar receiver.
       | _ ->
         let (recv, r2) = parse_expr r0 in
         let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end"))
    else if str_eq sc0 "::" then
      // `class ::C` — a top-level constant regardless of nesting. Keep the `::`
      // prefix so exec treats it as top-level (not qualified under the encloser).
      (match r0 with
       | Cons (TId slf, r1) -> let (name, r) = parse_qualified_name slf r1 in parse_class_rest ("::" ++ name) r
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ()))
  | Cons (TId name0, r0) ->
    let (name, r) = parse_qualified_name name0 r0 in
    parse_class_rest name r
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ()))

and parse_class_body_tail = fn r2 ->
    let (body0, r5a) = parse_stmts r2 Nil in
    // class-body-level rescue/ensure wraps the body in an implicit begin.
    (match r5a with
     | Cons (TId k, _) ->
       if str_eq k "rescue" || str_eq k "ensure" then
         let (rescues, ra) = parse_rescues r5a Nil in
         let (els, rb) = parse_opt_kw_block ra "else" in
         let (ens, rc) = parse_opt_kw_block rb "ensure" in
         (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
       else (body0, r5a)
     | _ -> (body0, r5a))

and parse_class_rest = fn (name: str) -> fn r ->
    (match r with
     | Cons (TP lt, r3) ->
       if str_eq lt "<" then
         // `< ::B` is a top-level constant; otherwise parse the superclass as an
         // expression. A plain constant keeps the fast name path (SClass); any
         // other expression (method call, self, paren, literal) becomes SClassE.
         (if (match r3 with Cons (TP cc, Cons (TId _, _)) -> str_eq cc "::" | _ -> false) then
            (match r3 with
             | Cons (TP _, Cons (TId sup0, r4)) ->
               let (nm, r4b) = parse_qualified_name sup0 r4 in
               let (body, r5) = parse_class_body_tail r4b in
               (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected superclass name" ++ parsing_file ()))) in fail ("mere-ruby: expected superclass name" ++ parsing_file ())))
          else
            let (se, r4) = parse_expr r3 in
            let (body, r5) = parse_class_body_tail r4 in
            (match se with
             | EConst nm -> (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (SClassE (name, se, body), expect_kw r5 "end")))
       else
         let (body, r5) = parse_class_body_tail r in
         (SClass (name, "", body), expect_kw r5 "end")
     | _ ->
       let (body, r5) = parse_class_body_tail r in
       (SClass (name, "", body), expect_kw r5 "end"))

// begin body rescue* [else] [ensure] end
and parse_begin = fn toks ->
  // (a new context for the "nodo" flag, as paren_body is: `p begin 1.times do
  //  1 end end` and `p :foo, {a: proc do end}` give the do to the inner call)
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let res = parse_begin_go toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  res
and parse_begin_go = fn toks ->
  let (body, r) = parse_stmts toks Nil in
  let (rescues, r2) = parse_rescues r Nil in
  // an `else` with no `rescue` before it can never run: ruby refuses it
  let _ = (match (rescues, r2) with
           | (Nil, Cons (TId "else", _)) -> syn_refuse_at (tok_line r2) "unexpected `else` in `begin` block; else without rescue is useless"
           | _ -> ()) in
  let (els, r3) = parse_opt_kw_block r2 "else" in
  let (ens, r4) = parse_opt_kw_block r3 "ensure" in
  (SBegin (body, rescues, els, ens), expect_kw r4 "end")

and parse_rescues = fn toks -> fn acc ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "rescue" then
      let (classes, var, prefix, r2) = parse_rescue_head r in
      let (handler, r3) = parse_stmts r2 Nil in
      // a complex capture target injects an assignment at the handler's top.
      let handler = (match prefix with Nil -> handler | Cons (s, _) -> Cons (s, handler)) in
      parse_rescues r3 (Cons ((classes, var, handler), acc))
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// `rescue [C1, C2] [=> target]` up to the newline. A bare local target keeps
// the string-var fast path; a complex lvalue (@ivar, obj.setter, obj&.setter,
// arr[i], C::X) binds the exception to a temp and returns an assignment to
// splice at the top of the handler body.
and parse_rescue_head = fn toks ->
  let (classes, r) = parse_rescue_classes toks Nil in
  let (var, prefix, r2) =
    (match r with
     | Cons (TP p, r3) ->
       if str_eq p "=>" then
         (let (tgt, r4) = parse_x_target1 r3 in
          (match tgt with
           | EVar nm -> (nm, Nil, r4)
           | _ -> let tmp = fresh_resc () in (tmp, Cons (SMultiAssignX (Cons (tgt, Nil), Cons (EVar tmp, Nil)), Nil), r4)))
       else ("", Nil, r)
     | _ -> ("", Nil, r)) in
  (classes, var, prefix, expect_end r2)

and parse_rescue_classes = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId c, r) ->
    // a bare constant matches by name (cheap path); a lowercase identifier is
    // a runtime expression (`rescue rescuer`).
    if is_cap c then
      let (full, r0) = scoped_name c r in
      (match r0 with
       | Cons (TP p, r2) ->
         if str_eq p "," then parse_rescue_classes (skip_nls r2) (Cons (full, acc))
         // `rescue C.new` — a constant followed by a `.` is the start of an
         // EXPRESSION, not the constant itself. Stopping at the constant left
         // `.new` for the caller, which was expecting `=>` or the end of the
         // line and said so. Ruby evaluates whatever is there and matches with
         // `===`, which is what makes `rescue C.new` (a matcher object) work.
         else if str_eq p "." then parse_rescue_expr_item toks acc false
         // ...and so is one followed by the `?` of a ternary: rubygems'
         // request.rb rescues `Gem::HAVE_OPENSSL ? OpenSSL::SSL::SSLError :
         // Errno::EHOSTDOWN, Errno::EHOSTDOWN => e`.
         else if str_eq p "?" then parse_rescue_expr_item toks acc false
         // a constant that continues (`::` handled by scoped_name) is just the
         // constant here; `=>` / newline end the class list.
         else (rev_app (Cons (full, acc)) Nil, r0)
       | _ -> (rev_app (Cons (full, acc)) Nil, r0))
    else parse_rescue_expr_item toks acc false
  // `rescue *x` / `rescue *(expr)` — splat a runtime array of exception classes.
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId v, r2) ->
         if is_cap v || (if str_len v > 0 then (if str_eq (char_at v 0) "@" then true else str_eq (char_at v 0) "$") else false)
         then parse_rescue_expr_item r acc true  // `*Const` / `*@x` as an expr
         else (match r2 with
          | Cons (TP p, r3) -> if str_eq p "," then parse_rescue_classes (skip_nls r3) (Cons ("*" ++ v, acc)) else (rev_app (Cons ("*" ++ v, acc)) Nil, r2)
          | _ -> (rev_app (Cons ("*" ++ v, acc)) Nil, r2))
       | _ -> parse_rescue_expr_item r acc true)
    // a parenthesized / lambda expression class (`rescue (expr)` / `rescue -> {..}`);
    // any other punctuation (`=>`, newline, `then`, `;`) ends the class list.
    else if is_lparen star || str_eq star "->" then parse_rescue_expr_item toks acc false
    // `rescue ::Foo::Bar => e` — a class named from the top level.
    else if str_eq star "::" || str_eq star " ::" then
      (match r with
       | Cons (TId c, r2) ->
         (let (full, r0) = scoped_name c r2 in
          match r0 with
          | Cons (TP p2, r3) ->
            if str_eq p2 "," then parse_rescue_classes (skip_nls r3) (Cons (full, acc))
            else (rev_app (Cons (full, acc)) Nil, r0)
          | _ -> (rev_app (Cons (full, acc)) Nil, r0))
       | _ -> (rev_app acc Nil, toks))
    else (rev_app acc Nil, toks)
  // a literal is an expression like any other: `rescue 1` is ruby's TypeError
  // ("class or module required for rescue clause") when something is raised,
  // not a SyntaxError (test_exception's test_rescue_single_argument)
  | Cons (TInt _, _) -> parse_rescue_expr_item toks acc false
  | Cons (TFlt _, _) -> parse_rescue_expr_item toks acc false
  | Cons (TStrL _, _) -> parse_rescue_expr_item toks acc false
  | Cons (TSym _, _) -> parse_rescue_expr_item toks acc false
  | _ -> (rev_app acc Nil, toks)

// parse one non-constant rescue class as a runtime expression, register it,
// and continue with the "@rexpr~N" sentinel (splat prefixes it with "*").
and parse_rescue_expr_item = fn toks -> fn (acc: str list) -> fn (splat: bool) ->
  let (e0, r0) = parse_bin toks 1 in
  // an item may be a ternary: net/http picks its class with
  // `defined?(OpenSSL::SSL) ? OpenSSL::SSL::SSLError : IOError`. parse_bin
  // stops at the `?`, which left the rest of the list dangling.
  let (e, r) =
    (match r0 with
     | Cons (TP q, rq) ->
       if str_eq q "?" then
         (let (t, r1) = parse_expr (skip_nls rq) in
          match r1 with
          | Cons (TP colon, r2) ->
            if str_eq colon ":" then (let (f, r3) = parse_expr (skip_nls r2) in (ETern (cond_ff e0, t, f), r3))
            else (e0, r0)
          | _ -> (e0, r0))
       else (e0, r0)
     | _ -> (e0, r0)) in
  let sentinel = (if splat then "*" else "") ++ resc_reg e in
  (match r with
   | Cons (TP p, r2) -> if str_eq p "," then parse_rescue_classes (skip_nls r2) (Cons (sentinel, acc)) else (rev_app (Cons (sentinel, acc)) Nil, r)
   | _ -> (rev_app (Cons (sentinel, acc)) Nil, r))

and parse_opt_kw_block = fn toks -> fn (kw: str) ->
  match toks with
  // (an `else` written with nothing in it is a nil value, not no else:
  //  `begin return; rescue; return; else end` answers nil)
  | Cons (TId id, r) -> if str_eq id kw then (let (b9, r9) = parse_stmts r Nil in
                                               ((match b9 with Nil -> (if str_eq kw "else" then Cons (SExpr ENil, Nil) else b9) | _ -> b9), r9))
                        else (Nil, toks)
  | _ -> (Nil, toks)

// Is the argument list nothing but names (`:a, :b`, `"c"`)? A keyword
// argument makes it a call to whatever attr_accessor is in scope: net-imap's
// Config defines its own, and writes `attr_accessor :debug, type: :boolean,
// default: false`, which the declaration reader refused ("expected :symbol").
and attr_plain_list = fn toks ->
  match toks with
  | Cons (TSym _, r) -> (match r with Cons (TP p, r2) -> (if str_eq p "," then attr_plain_list (skip_nls r2) else true) | _ -> true)
  | Cons (TStrL _, r) -> (match r with Cons (TP p, r2) -> (if str_eq p "," then attr_plain_list (skip_nls r2) else true) | _ -> true)
  | Cons (TP g, _) -> str_eq g "(s"
  | _ -> false

and parse_attr = fn (mode: str) -> fn toks ->
  let (syms, r) = parse_sym_list toks Nil in
  // `attr :a, true` is ruby's old spelling of attr_accessor (and `, false` of
  // attr_reader). The flag is not a name, so parse_sym_list leaves it here.
  match r with
  // (marked "!": ruby warns that the flag is obsoleted, register_class_v)
  | Cons (TId flag, r2) when str_eq flag "true" -> (SAttr ("rw!", syms), r2)
  | Cons (TId flag, r2) when str_eq flag "false" -> (SAttr ("r!", syms), r2)
  | _ -> (SAttr (mode, syms), r)

and parse_sym_list = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TSym s, r) ->
    (match r with
     | Cons (TP p, r2) ->
       // an attr list can wrap after a comma, like any argument list.
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (s, acc))
       else (rev_app (Cons (s, acc)) Nil, r)
     | _ -> (rev_app (Cons (s, acc)) Nil, r))
  // ...and a name may be written as a STRING: `attr_accessor :a, "b"`. A
  // double-quoted string lexes as an interpolation GROUP, so it is parsed as
  // an expression and folded, the way alias names are.
  // A bare string literal, now that a double-quoted string with no
  // interpolation lexes as one token rather than a concat: `attr_reader "c"`.
  | Cons (TStrL lit, r0) ->
    (match r0 with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (lit, acc))
       else (rev_app (Cons (lit, acc)) Nil, r0)
     | _ -> (rev_app (Cons (lit, acc)) Nil, r0))
  | Cons (TP grp, _) when str_eq grp "(s" ->
    (let (e, r) = parse_primary toks in
     let nm = const_fold_str e in
     match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (nm, acc))
       else (rev_app (Cons (nm, acc)) Nil, r)
     | _ -> (rev_app (Cons (nm, acc)) Nil, r))
  // the trailing `true` / `false` of `attr :a, true` ends the list
  | Cons (TId flag, _) when str_eq flag "true" || str_eq flag "false" ->
    (rev_app acc Nil, toks)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected :symbol" ++ parsing_file ()))) in fail ("mere-ruby: expected :symbol" ++ parsing_file ()))

// a range in an if/unless condition is the flip-flop operator; allocate its
// state site here (parse time), reaching through !/&&/|| combinations.
// scan (depth-aware) for a top-level assignment operator before the
// closing paren — defined?(x = 2) / defined?(@x ||= 1) forms.
// `defined?(<compound statement>)` — if/unless/case/while/until/for/begin —
// always answers "expression" in Ruby; parse it as a statement (correctly
// consuming to the matching `end`) rather than as an expression.
and defined_compound = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    str_eq w "if" || str_eq w "unless" || str_eq w "case" || str_eq w "while" ||
    str_eq w "until" || str_eq w "for" || str_eq w "begin"
  | _ -> false

and defined_assignish = fn toks -> defined_assign_go toks 0

// `defined?(a[0] = 1)` is "method" -- the []= CALL -- while `defined?(x = 1)`
// is "assignment". CRuby splits them on the TARGET, and only for a plain `=`:
// an op-assign writes through the same setter and is still "assignment".
// The two tokens before the `=` say which: `] =` is an index write, and
// `. name =` an attribute write.
and defined_assign_kind = fn toks -> defined_assign_kind_go toks 0 TEOF TEOF
and defined_assign_kind_go = fn toks -> fn (depth: int) -> fn (p1: Tok) -> fn (p2: Tok) ->
  // (the walk ENDS where defined_assign_go's does -- the closing paren, the
  // end of the line, or an op-assign, which is "assignment" whatever its
  // target. It walked on past all three, so `p defined?(s.x += 2)` followed
  // by a line `p defined?(s.x = 2)` read the second line's `.x =` and
  // answered "method".)
  match toks with
  | Nil -> "assignment"
  | Cons (TNL _, r) -> (if depth == 0 then "assignment" else defined_assign_kind_go r depth p1 p2)
  | Cons (TEOF, _) -> "assignment"
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      defined_assign_kind_go r (depth + 1) (TP p) p1
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth == 0 then "assignment" else defined_assign_kind_go r (depth - 1) (TP p) p1)
    else if depth == 0 && (if str_eq p "=" then false else (if str_eq (opassign_base p) "" then false else true)) then "assignment"
    else if depth == 0 && str_eq p "=" then
      (match p1 with
       | TP c -> (if str_eq c "]" then "method" else "assignment")
       | TId _ -> (match p2 with TP d -> (if str_eq d "." || str_eq d "&." then "method" else "assignment") | _ -> "assignment")
       | _ -> "assignment")
    else defined_assign_kind_go r depth (TP p) p1
  | Cons (t, r) -> defined_assign_kind_go r depth t p1

// ...and a setter call is not answered from its spelling. ruby asks it as it
// asks any call: every argument (the index and the value too) has to be
// defined, the receiver is evaluated, and it has to answer the setter
// publicly. `defined?(DidYouMean.formatter = nil)` is nil when there is no
// DidYouMean -- test_pattern_matching's setup asks exactly that, and the
// "method" this answered from the tokens sent all 30 of its tests into a
// NameError. The statement is the call the parser built (`recv.x=(v)`,
// `recv.[]=(i, v)`); `&.` is asked the same way (nil answers no setter).
and defined_assign_node = fn toks -> fn (st: Stmt) ->
  let kind = defined_assign_kind toks in
  if str_eq kind "method" then
    (match st with
     | SExpr (EMethod (rv, m, a)) -> EDefined (EMethod (rv, m, a))
     | SExpr (ESafe (rv, m, a)) -> EDefined (EMethod (rv, m, a))
     | _ -> EDefined (EVar "__defined__method"))
  else EDefined (EVar ("__defined__" ++ kind))

and defined_assign_go = fn toks -> fn (depth: int) ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      defined_assign_go r (depth + 1)
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth == 0 then false else defined_assign_go r (depth - 1))
    else if depth == 0 && (str_eq p "=" || (if str_eq (opassign_base p) "" then false else true)) then true
    else defined_assign_go r depth
  | Cons (_, r) -> defined_assign_go r depth

and cond_ff = fn (e: Expr) ->
  match e with
  | ERange (a, b, excl) ->
    let n = map_len ff_state in
    let _ = map_set ff_state (str_of_int n) (VBool false) in
    EFlipFlop (n, ff_operand a, ff_operand b, excl)
  | EBin (op, l, r) ->
    if str_eq op "&&" || str_eq op "||" then EBin (op, cond_ff l, cond_ff r)
    else if str_eq op "+" && cond_is_dstr e then (let _ = cond_warn "string literal in condition" in e)
    else e
  // (a literal under `!` is not warned about: `1 if !""` says nothing)
  | EUn (op, x) ->
    if str_eq op "!" then
      (let q9 = map_has cond_quiet "q" in
       let _ = map_set cond_quiet "q" 1 in
       let x9 = cond_ff x in
       let _ = (if q9 then () else map_delete cond_quiet "q") in
       EUn (op, x9))
    else e
  // a bare regexp literal as a condition matches $_ (`if /foo/` is
  // `if $_ =~ /foo/`), with ruby's warning. It was a Regexp, always true.
  | ERegex (_, _) ->
    let _ = cond_lit_warn "regex literal in condition" in
    EBin ("=~", e, EVar "$_")
  // a string literal is always true, and `if x = 1` is almost always a
  // mistyped `==`: ruby says so (for -e too); a symbol literal only under -w
  | EStrL _ -> let _ = cond_warn "string literal in condition" in e
  | ESym _ -> let _ = (if parse_verbose () then cond_warn "symbol literal in condition" else ()) in e
  // __FILE__ is a string literal; an integer (and __LINE__) is a literal
  | EVar n when str_len n >= 8 && str_eq (substring n 0 8) "__FILE__" -> let _ = cond_warn "string literal in condition" in e
  | EInt _ -> let _ = (if parse_verbose () then cond_warn "literal in condition" else ()) in e
  // the interpolated forms: "a#{x}" (pieces joined by __interp_str), its
  // `.to_sym`, and a regexp built with `.__regex` -- which matches $_
  | EMethod (x, m, _) ->
    if str_eq m "__regex" then (let _ = cond_lit_warn "regex literal in condition" in EBin ("=~", e, EVar "$_"))
    else if str_eq m "to_sym" && cond_is_dstr x then
      (let _ = (if parse_verbose () then cond_warn "symbol literal in condition" else ()) in e)
    else if str_eq m "__interp_str" then (let _ = cond_warn "string literal in condition" in e)
    else e
  | EAssign (_, v) ->
    (let _ = (if cond_static v then cond_warn "found '= literal' in conditional, should be ==" else ()) in e)
  // (and a multiple assignment of literals: `(x, y = 1, 2) ? 1 : 2`)
  | EStmt (SMultiAssign (_, vs)) ->
    (let _ = (if cond_static_all vs then cond_warn "found '= literal' in conditional, should be ==" else ()) in e)
  | EStmt (SMultiAssignX (_, vs)) ->
    (let _ = (if cond_static_all vs then cond_warn "found '= literal' in conditional, should be ==" else ()) in e)
  | _ -> e

// a value ruby counts as a literal for "found '= literal' in conditional":
// the scalars, __FILE__ / __LINE__, and an array or hash made only of them
// (`[1]` and `{1=>2}` are, `[a]` and `{3=>a}` are not)
and cond_static = fn (v: Expr) ->
  match v with
  | EInt _ -> true
  | EFlt _ -> true
  | EStrL _ -> true
  | ESym _ -> true
  | ENil -> true
  | EBool _ -> true
  | EVar n -> str_len n >= 8 && (str_eq (substring n 0 8) "__FILE__" || str_eq (substring n 0 8) "__LINE__")
  | EArr xs -> cond_static_all xs
  | EHsh xs -> cond_static_all xs
  | _ -> false
and cond_static_all = fn (xs: Expr list) ->
  match xs with Nil -> true | Cons (x, t) -> cond_static x && cond_static_all t
// the condition a parser arm read ends on the line of the next newline mark
// (tok_line): that is the line the warnings name. parse_line_now only knows
// the statement loop's count, which a block body (`0.times do ... if b = 2`)
// leaves behind.
and cond_ff_at = fn toks -> fn (e: Expr) ->
  let _ = map_set parse_line "cl" (tok_line toks) in
  let r = cond_ff e in
  let _ = map_delete parse_line "cl" in r
and cond_line = fn (u: unit) ->
  if map_has parse_line "cl" && map_get parse_line "cl" > 0 then map_get parse_line "cl" else parse_line_now ()

// an interpolated string: literal pieces and `.__interp_str` ones joined by +
// the interpolated string a `:"#{x}"` literal makes, under its encoding tag
and dsym_recv = fn (e: Expr) -> cond_is_dstr (lit_untag e)
and cond_is_dstr = fn (e: Expr) ->
  match e with
  | EMethod (_, m, _) -> str_eq m "__interp_str"
  | EBin (op, l, r) -> str_eq op "+" && (cond_is_dstr l || cond_is_dstr r) && cond_str_parts e
  | _ -> false
and cond_str_parts = fn (e: Expr) ->
  match e with
  | EStrL _ -> true
  | EMethod (_, m, _) -> str_eq m "__interp_str"
  | EBin (op, l, r) -> str_eq op "+" && cond_str_parts l && cond_str_parts r
  | _ -> false
// a parse-time warning at the line being read, -e included
and cond_warn = fn (what: str) ->
  if map_has cond_quiet "q" then () else
  warn_note (parse_time_file () ++ ":" ++ str_of_int (cond_line () + lshift_tok ()) ++ ": warning: " ++ what)

// ruby's warning for a literal where a condition is read. It is not given for
// a -e program (prism's warn_unless_e_option: the one-liner idioms are what
// these literals are FOR there).
and cond_lit_warn = fn (what: str) ->
  let f9 = parse_time_file () in
  if str_eq f9 "-e" || map_has cond_quiet "q" then ()
  else warn_note (f9 ++ ":" ++ str_of_int (cond_line () + lshift_tok ()) ++ ": warning: " ++ what)

// ...and each END of a flip-flop is itself read as a condition (ruby's
// range_op): an integer literal is compared with `$.`, the line last read,
// and a regexp literal is matched against `$_`. That is what makes
// `ruby -ne 'print if 2..3'` the awk idiom it is -- taken as plain values,
// 2 is truthy and every line printed.
and ff_operand = fn (e: Expr) ->
  match e with
  | EInt _ -> let _ = cond_lit_warn "integer literal in flip-flop" in EBin ("==", e, EVar "$.")
  | ERegex (_, _) -> let _ = cond_lit_warn "regex literal in flip-flop" in EBin ("=~", e, EVar "$_")
  // (a string or symbol end is always true: ruby says so, the symbol under -w)
  | EStrL _ -> let _ = cond_warn "string literal in flip-flop" in e
  | ESym _ -> let _ = (if parse_verbose () then cond_warn "symbol literal in flip-flop" else ()) in e
  // (under the literal's frozen_string_literal / encoding tag too)
  | EMethod (x, m, Nil) when str_len m > 6 && str_eq (substring m 0 6) "__lit_" && (match lit_untag x with EStrL _ -> true | _ -> false) ->
    let _ = cond_warn "string literal in flip-flop" in e
  | EMethod (x, m, _) ->
    (if str_eq m "__interp_str" then (let _ = cond_warn "string literal in flip-flop" in e)
     else if str_eq m "to_sym" && cond_is_dstr x then
       (let _ = (if parse_verbose () then cond_warn "symbol literal in flip-flop" else ()) in e)
     else e)
  | _ -> if cond_is_dstr e then (let _ = cond_warn "string literal in flip-flop" in e) else e

and parse_if = fn toks -> fn (negate: bool) ->
  let (cond1, r0) = cond_in_pattern (parse_andor toks) in
  // `if x = compute rescue next` -- the rescue modifier binds tighter than the
  // `if`, so the CONDITION is `(x = compute) rescue next` (activesupport's
  // Messages::Rotator writes exactly that inside a block).
  let (cond1, r) =
    (match r0 with
     | Cons (TId rw, r1) ->
       if str_eq rw "rescue" then
         (let (h, r2) = parse_stmt (skip_nls r1) in
          (EStmt (SBegin (Cons (SExpr cond1, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)), r2))
       else (cond1, r0)
     | _ -> (cond1, r0)) in
  let cond0 = cond_ff_at r0 cond1 in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  let (clauses, els, r3) = parse_if_tail r2 in
  (SIf (Cons ((cond, body), clauses), els), r3)

and parse_if_tail = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "end" then (Nil, Nil, r)
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (Nil, b, expect_kw r2 "end")
    else if str_eq id "elsif" then
      // the same parser as `if`: an elsif condition may use the low-precedence
      // `and` / `or` (racc's generated parsers are written that way).
      let (c0, r2) = parse_andor r in
      let c = cond_ff_at r2 c0 in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      let (clauses, els, r4) = parse_if_tail r3 in
      (Cons ((c, b), clauses), els, r4)
    else (let __fm = ("mere-ruby: expected elsif/else/end, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated if" ++ parsing_file ()))) in fail ("mere-ruby: unterminated if" ++ parsing_file ()))

// `for x in e [do] body end` — each over e with x as the block param.
// The block shares the enclosing env, so (like Ruby's for) x leaks out.
and parse_for = fn toks ->
  // a complex loop target (`for obj.attr in`, `for arr[i] in`, `for C::X in`,
  // `for obj&.attr in`) is parsed as an assignment-target expression and driven
  // through the same setter machinery as multiple assignment.
  if for_targets_complex toks then
    let (targets, r2) = parse_for_xtargets toks Nil in
    let (e0, r3) = parse_for_expr r2 in
    let (e, body, r4) = parse_for_iter (for_bare_do r2) e0 r3 in
    (match targets with
     | Cons (t, Nil) ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("__forv", Nil), Cons (for_xassign t (EVar "__forv"), body))), r4)
     | _ ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("*__forv", Nil), Cons (SMultiAssignX (targets, Cons (ESplat (EVar "__forv"), Nil)), body))), r4))
  else
  let (vars, r2) = parse_for_vars toks Nil in
  let (e0, r3) = parse_for_expr r2 in
  let (e, body, r4) = parse_for_iter (for_bare_do r2) e0 r3 in
  (match vars with
   | Cons (v, Nil) ->
     // A single SPLAT target collects rather than binds: `for *r in [[1,2]]`
     // is the assignment `*r = [1,2]`, so r is [1,2]. for_assign would have
     // made a local literally NAMED "*r" and left r undefined -- and a real
     // `|*r|` block param would have wrapped the element one layer too deep.
     (if str_len v > 1 && str_eq (char_at v 0) "*" then
        (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil),
                          Cons (SMultiAssign (Cons (v, Nil), Cons (EVar "__for", Nil)), body))), r4)
      else if str_eq v "*" then
        // `for * in xs` binds nothing at all; the loop still runs.
        (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil), body)), r4)
      else
     // the hidden __for param keeps v assigned in the SHARED scope, so
     // v survives the loop (block params themselves are block-local).
     (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil), Cons (for_assign v (EVar "__for"), body))), r4))
   | _ ->
     // multiple targets: real (auto-splatting) block params __f0.., then a
     // prologue assigns them into the SHARED scope names.
     let (params, prologue) = for_multi_binding vars 0 in
     (SExpr (EMethodB (e, "each", Nil, params, list_append_stmt prologue body)), r4))

// The iterable must not swallow the loop's `do`, the same way a while
// condition must not: in `for y in 0...h do`, the bare `h` at the end of the
// range would otherwise take the block (chunky_png writes exactly that).
and parse_for_expr = fn toks ->
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (e, r) = parse_expr toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  (e, r)

// `for i in x do ... end` — a bare-variable iterable grabs the do-block as its
// own; unwrap it back into the loop body. Shared by both for-target paths.
// ...but only a `do` does that: `for k, v in sort{|a1, a2| ...}` (irb's
// CONF#inspect) is a call with a brace block, which is the iterable itself,
// and unwrapping it made the block the loop body and left `end` over.
and for_bare_do = fn toks ->
  match toks with Cons (TId _, Cons (TId d, _)) -> str_eq d "do" | _ -> false
and parse_for_iter = fn (bare_do: bool) -> fn (e0: Expr) -> fn r3 ->
  match e0 with
  | ECallB (nm, Nil, bps, bb) when bare_do -> (match bps with Nil -> (EVar nm, bb, r3) | _ -> (e0, Nil, r3))
  | _ ->
    let r3b = (match r3 with Cons (TId d, rr) -> (if str_eq d "do" then rr else r3) | _ -> r3) in
    let (b, r4b) = parse_stmts r3b Nil in
    (e0, b, expect_kw r4b "end")

// does the for-target list (up to `in`) contain a complex chain?
and for_targets_complex = fn toks ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) -> if str_eq w "in" then false else for_targets_complex r
  | Cons (TP p, r) ->
    if str_eq p "." || str_eq p "[" || str_eq p "::" || str_eq p "&." then true
    else for_targets_complex r
  | Cons (_, r) -> for_targets_complex r

// parse comma-separated complex for-targets, terminated by `in`.
and parse_for_xtargets = fn toks -> fn (acc: Expr list) ->
  let (t, r) = parse_x_target1 toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_for_xtargets r2 (Cons (t, acc)) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | Cons (TId kw, r2) -> if str_eq kw "in" then (rev_app (Cons (t, acc)) Nil, r2) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))

// build the statement that assigns one for-iteration value to a complex target.
and for_xassign = fn (t: Expr) -> fn (rhs: Expr) ->
  match t with
  | EMethod (recv, m, args) -> if str_eq m "[]" then SExpr (EMethod (recv, "[]=", eapp args (Cons (rhs, Nil)))) else SExpr (EMethod (recv, m ++ "=", Cons (rhs, Nil)))
  | ESafe (recv, m, args) -> SExpr (ESafe (recv, m ++ "=", eapp args (Cons (rhs, Nil))))
  | EScopedRead (recv, cn) -> SExpr (EScopedAssign (recv, cn, rhs))
  | EIVar n -> SAssign ("@" ++ n, rhs)
  | EVar n -> SAssign (n, rhs)
  | _ -> SExpr rhs

and list_append_stmt = fn (xs: Stmt list) -> fn (ys: Stmt list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_stmt t ys)

// vars -> (block params, prologue stmts): v -> __fN + v = __fN;
// *x -> *__fN + x = __fN; bare * -> anonymous *.
// a for-loop target assignment: an @ivar / @@cvar name routes to SIVarAssign
// (SAssign only handles plain locals / $globals / constants).
and for_assign = fn (v: str) -> fn (rhs: Expr) ->
  if str_len v > 0 && str_eq (char_at v 0) "@" then SIVarAssign (substring v 1 (str_len v), rhs)
  else SAssign (v, rhs)

and for_multi_binding = fn (vars: str list) -> fn (n: int) ->
  match vars with
  | Nil -> (Nil, Nil)
  | Cons (v, rest) ->
    let (ps, ss) = for_multi_binding rest (n + 1) in
    if str_eq v "*" then (Cons ("*", ps), ss)
    else if str_len v > 0 && str_eq (char_at v 0) "*" then
      let nm = substring v 1 (str_len v) in
      (Cons ("*__f" ++ str_of_int n, ps), Cons (for_assign nm (EVar ("__f" ++ str_of_int n)), ss))
    else (Cons ("__f" ++ str_of_int n, ps), Cons (for_assign v (EVar ("__f" ++ str_of_int n)), ss))

// target list before `in`: a name, `name,`, `a, b`, `a, *`, `a, *rest`.
// the names inside `for (a, b) in ...`, up to the closing paren.
and parse_for_group = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId v, r) ->
    (match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_for_group r2 (Cons (v, acc))
       else if str_eq p ")" then (rev_app (Cons (v, acc)) Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or ) in a for target" ++ parsing_file ()))) in fail ("mere-ruby: expected , or ) in a for target" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated for target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated for target" ++ parsing_file ())))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable in a for target" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable in a for target" ++ parsing_file ()))

and parse_for_vars = fn toks -> fn (acc: str list) ->
  match toks with
  // `for (a, b) in pairs` — the parens only group the destructuring, exactly
  // as `for a, b in pairs` does.
  | Cons (TP lp, r0) ->
    if is_lparen lp then
      (let (vs, r1) = parse_for_group r0 Nil in
       match r1 with
       | Cons (TId kw, r2) ->
         if str_eq kw "in" then (rev_app (rev_app vs acc) Nil, r2)
         else parse_for_vars r1 (rev_app vs acc)
       | _ -> parse_for_vars r1 (rev_app vs acc))
    // `*` / `*rest` as a for target. This arm and the `Cons (TP star, r)` one
    // further down BOTH match TP, and the first match wins -- so that one was
    // dead code and every `for *r in` / `for a, *r in` failed here with
    // "expected a variable after for".
    else if str_eq lp "*" then
      (match r0 with
       | Cons (TId n, r2) ->
         if str_eq n "in" then (rev_app (Cons ("*", acc)) Nil, r2)
         else parse_for_vars2 ("*" ++ n) r2 acc
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))
  | Cons (TId v, r) ->
    if str_eq v "in" then (rev_app acc Nil, r)
    else
      (match r with
       | Cons (TP c, r2) ->
         if str_eq c "," then
           // `for i, in` — a trailing comma destructures (i = first elem).
           (match r2 with
            | Cons (TId nx, r3) ->
              if str_eq nx "in" then (rev_app (Cons ("*", Cons (v, acc))) Nil, r3)
              else parse_for_vars r2 (Cons (v, acc))
            | _ -> parse_for_vars r2 (Cons (v, acc)))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
       | Cons (TId kwin, r2) ->
         if str_eq kwin "in" then (rev_app (Cons (v, acc)) Nil, r2)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId n, r2) ->
         if str_eq n "in" then (rev_app (Cons ("*", acc)) Nil, r2)
         else parse_for_vars2 ("*" ++ n) r2 acc
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))

and parse_for_vars2 = fn (t: str) -> fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_for_vars r (Cons (t, acc))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | Cons (TId kwin, r) ->
    if str_eq kwin "in" then (rev_app (Cons (t, acc)) Nil, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))

and parse_while = fn toks -> fn (negate: bool) ->
  // the condition must not swallow the loop's `do` as a block argument
  // (`while x do y end` = while x; then y; not x { y }).
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (cond00, r) = parse_andor toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  // read as a condition, as `if`'s is: a flip-flop, a bare regexp, and the
  // literal warnings
  let cond0 = cond_ff_at r cond00 in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  (SWhile (cond, body), expect_kw r2 "end")

and parse_case = fn toks ->
  // `case` immediately followed by a newline is subjectless: the when
  // conditions are truthiness tests rather than === against a subject.
  match toks with
  | Cons (TNL _, _) -> parse_whens ECaseNone toks Nil Nil
  // ... and so is `case when c then v end` on one line: `when` cannot start a
  // subject expression, so its presence here means there is no subject.
  | Cons (TId kw0, _) -> if str_eq kw0 "when" then parse_whens ECaseNone toks Nil Nil else parse_case_subj toks
  | _ -> parse_case_subj toks
and parse_case_subj = fn toks ->
  (match toks with
  | _ ->
    let (subj, r) = parse_expr toks in
    // `in` after the subject selects pattern matching; `when` the classic form.
    (match skip_nls r with
     | Cons (TId kw, _) -> if str_eq kw "in" then parse_case_in subj r Nil else parse_whens subj r Nil Nil
     | _ -> parse_whens subj r Nil Nil))

// pattern-matching case: parse `in <pattern> [if|unless <cond>] [then] body`
// clauses, an optional `else`, and the closing `end`.
and parse_case_in = fn (subj: Expr) -> fn toks -> fn acc ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "in" then
      let (pat, r2) = parse_pattern_top r in
      let (guard, r3) = parse_in_guard r2 in
      // after a pattern (+ optional guard) a delimiter must follow — then, a
      // newline, or end. Anything else (e.g. a leftover `+ 1` from `in 1 + 1`,
      // which a value pattern does not consume) is a SyntaxError in Ruby.
      let _ = (match r3 with
               | Cons (TId g, _) -> if str_eq g "then" || is_block_stop g then () else syn_refuse "expected a delimiter after the patterns of an `in` clause"
               | Cons (TNL _, _) -> ()
               | Cons (TEOF, _) -> ()
               // (a label left over -- `in a, b:` -- is prism's second error)
               // (`in "#{a}":` -- an interpolated key -- is a value pattern
               //  left before its colon)
               | Cons (TP c9, _) when str_eq c9 ":" && (match pat with PVal e9 -> scv_dstr e9 | _ -> false) ->
                 syn_refuse "symbol literal with interpolation is not allowed\nexpected a delimiter after the patterns of an `in` clause"
               | Cons (TP c9, _) when str_eq c9 ":" ->
                 syn_refuse "expected a delimiter after the patterns of an `in` clause\nunexpected label, ignoring it"
               | _ -> syn_refuse "expected a delimiter after the patterns of an `in` clause") in
      let (b, r4) = parse_stmts (skip_then r3) Nil in
      parse_case_in subj r4 (Cons ((pat, guard, b), acc))
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (SCaseIn (subj, rev_app acc Nil, true, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCaseIn (subj, rev_app acc Nil, false, Nil), r)
    // (a `when` among the `in` clauses is ruby's "unexpected 'when'")
    else if str_eq id "when" then (let _ = syn_refuse "unexpected 'when'" in (SCaseIn (subj, rev_app acc Nil, false, Nil), r))
    else (let __fm = ("mere-ruby: expected in/else/end in case, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated case/in" ++ parsing_file ()))) in fail ("mere-ruby: unterminated case/in" ++ parsing_file ()))

// an optional guard after a pattern: `if COND` / `unless COND`.
and parse_in_guard = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "if" then let (c, r2) = parse_andor r in (c, r2)
    else if str_eq id "unless" then let (c, r2) = parse_andor r in (EUn ("!", c), r2)
    else (EBool true, toks)
  | _ -> (EBool true, toks)

// a top-level pattern (the direct operand of `in` or one-line `=>`/`in`).
// Bare forms without brackets/braces are allowed here: `in 0, 1, 2` is an
// array pattern and `in a:, b:` is a hash pattern.
// ---- parser-side pattern static checks ----------------------------------
// (These run at parse time so an offending pattern inside eval("...") surfaces
//  as a catchable SyntaxError, matching Ruby.)
and pp_us = fn (n: str) -> str_len n > 0 && str_eq (char_at n 0) "_"
and pp_names = fn (p: Pat) -> fn (acc: str list) ->
  match p with
  | PVar n -> Cons (n, acc)
  | PSplatP n -> if str_eq n "" then acc else Cons (n, acc)
  | PArrP es -> pp_names_list es acc
  | PHashP (items, rest) ->
    let a2 = if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then acc else Cons (rest, acc) in
    pp_hitems items a2
  | PAltP alts -> pp_names_list alts acc
  | PAsP (sub, n) -> Cons (n, pp_names sub acc)
  | PConstP (_, inner) -> pp_names inner acc
  | _ -> acc
and pp_names_list = fn (es: Pat list) -> fn (acc: str list) ->
  match es with Nil -> acc | Cons (p, r) -> pp_names_list r (pp_names p acc)
and pp_hitems = fn (items: (str * Pat) list) -> fn (acc: str list) ->
  match items with Nil -> acc | Cons (kp, r) -> let (k, sub) = kp in pp_hitems r (pp_names sub acc)
and pp_mem = fn (xs: str list) -> fn (n: str) ->
  match xs with Nil -> false | Cons (h, t) -> str_eq h n || pp_mem t n
// a non-underscore variable bound more than once (`in [a, a]` — SyntaxError;
// `_`/`_x` may repeat).
and pp_has_dup = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else pp_mem rest n) || pp_has_dup rest
// any non-underscore binding at all (used to forbid bindings in alternatives).
and pp_has_real = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else true) || pp_has_real rest
and check_dup_vars = fn (p: Pat) ->
  if pp_has_dup (pp_names p Nil) then syn_refuse "duplicated variable name" else ()

// `^name` may only pin a variable already bound to its LEFT in the pattern (or
// a pre-existing local). Pinning a name that the SAME pattern binds later
// (`in [^n, n]`) is a SyntaxError ("no such local variable"); `[n, ^n]` is ok.
and check_pin_order = fn (p: Pat) ->
  let all = pp_names p Nil in
  let (bad, _) = pp_pin_walk p all Nil in
  if bad then syn_refuse ((match (if map_has parser_flags "pinbad" then map_get parser_flags "pinbad" else VNil) with VStr h9 -> sget h9 | _ -> "") ++ ": no such local variable") else ()
and pp_pin_walk = fn (p: Pat) -> fn (all: str list) -> fn (seen: str list) ->
  match p with
  | PVar n -> (false, Cons (n, seen))
  | PPin e -> (match e with
               | EVar n -> (let b9 = (pp_mem all n) && (if pp_mem seen n then false else true) in
                            // (the name, for ruby's "n: no such local variable")
                            let _ = (if b9 then map_set parser_flags "pinbad" (mkstr n) else ()) in
                            (b9, seen))
               | _ -> (false, seen))
  | PSplatP n -> (false, if str_eq n "" then seen else Cons (n, seen))
  | PArrP es -> pp_pin_walk_list es all seen
  | PHashP (items, _) -> pp_pin_walk_hitems items all seen
  | PAltP alts -> pp_pin_walk_list alts all seen
  | PAsP (sub, n) -> let (b, s) = pp_pin_walk sub all seen in (b, Cons (n, s))
  | PConstP (_, inner) -> pp_pin_walk inner all seen
  | _ -> (false, seen)
and pp_pin_walk_list = fn (es: Pat list) -> fn (all: str list) -> fn (seen: str list) ->
  match es with
  | Nil -> (false, seen)
  | Cons (p, r) -> let (b, s) = pp_pin_walk p all seen in if b then (true, s) else pp_pin_walk_list r all s
and pp_pin_walk_hitems = fn (items: (str * Pat) list) -> fn (all: str list) -> fn (seen: str list) ->
  match items with
  | Nil -> (false, seen)
  | Cons (kp, r) -> let (k, sub) = kp in let (b, s) = pp_pin_walk sub all seen in if b then (true, s) else pp_pin_walk_hitems r all s

and parse_pattern_top = fn toks ->
  let (p, r) = parse_pattern_top0 toks in
  let _ = check_dup_vars p in
  let _ = check_pin_order p in
  (p, r)

and parse_pattern_top0 = fn toks ->
  // bare hash pattern: starts with a `label:` or `**`.
  if starts_hash_pattern toks then
    let (items, rest, r) = parse_hash_pat_items toks Nil "" in
    (PHashP (items, rest), r)
  else
    let (p, r) = parse_pattern toks in
    // bare array pattern: a top-level comma joins elements without brackets.
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then
         let (rest, r3) = parse_bare_arr r2 Nil in
         (PArrP (Cons (p, rest)), r3)
       else (p, r)
     | _ -> (p, r))

// elements of a bracket-less array pattern (`in 0, 1, *rest`), terminated by
// end-of-clause rather than `]`. Called right after a separating comma.
and parse_bare_arr = fn toks -> fn (acc: Pat list) ->
  // called right after a separating comma; a terminator here means a trailing
  // comma (`0, 1,`) which makes the pattern match partially — append a splat.
  match toks with
  | Cons (TNL _, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TEOF, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | Cons (TP p, _) -> if str_eq p ")" || str_eq p ";" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | _ -> parse_bare_arr_one toks acc

and parse_bare_arr_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match r with
   | Cons (TP c, r2) -> if str_eq c "," then parse_bare_arr r2 acc2 else (rev_app acc2 Nil, r)
   | _ -> (rev_app acc2 Nil, r))

// does the token stream begin a bare (brace-less) hash pattern?
and starts_hash_pattern = fn toks ->
  match toks with
  | Cons (TId _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TStrL _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TP op, Cons (TStrL _, Cons (TP plus, Cons (TStrL _, Cons (TP cp, Cons (TP colon, _)))))) -> str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":"
  | Cons (TP dsp, _) -> str_eq dsp "**"
  | _ -> false

// a full pattern including alternation `p1 | p2 | ...` and the trailing
// as-binding `pat => name`.
and parse_pattern = fn toks ->
  let (p, r) = parse_pattern_alt toks in
  // `pat => name` binds the whole matched value to a local.
  (match r with
   | Cons (TP arrow, r2) ->
     if str_eq arrow "=>" then
       (match r2 with
        | Cons (TId nm, r3) -> (PAsP (p, nm), r3)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected name after => in pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected name after => in pattern" ++ parsing_file ())))
     else (p, r)
   | _ -> (p, r))

and parse_pattern_alt = fn toks ->
  let (p, r) = parse_pattern_prim toks in
  (match r with
   | Cons (TP bar, r2) ->
     if str_eq bar "|" then
       let (alts, r3) = parse_alt_rest r2 (Cons (p, Nil)) in
       // Ruby forbids binding a (non-underscore) variable in an alternative.
       let _ = if pp_has_real (pp_names (PAltP alts) Nil) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: illegal variable in alternative pattern")) in fail "mere-ruby: illegal variable in alternative pattern") else () in
       (PAltP alts, r3)
     else (p, r)
   | _ -> (p, r))

and parse_alt_rest = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern_prim toks in
  let acc2 = rev_app (Cons (p, rev_app acc Nil)) Nil in
  (match r with
   | Cons (TP bar, r2) -> if str_eq bar "|" then parse_alt_rest r2 acc2 else (acc2, r)
   | _ -> (acc2, r))

// a primary pattern (no alternation / as-binding at this level).
and parse_pattern_prim = fn toks ->
  match toks with
  // array pattern [ ... ]
  | Cons (TP lb, r) ->
    if str_eq lb "[" || str_eq lb " [" then
      let (elems, r2) = parse_arr_pat_elems r Nil in
      (PArrP elems, r2)
    // hash pattern { ... }
    else if str_eq lb "\{" then
      let (items, rest, r2) = parse_hash_pat_brace r in
      (PHashP (items, rest), r2)
    // ^pin
    else if str_eq lb "^" then parse_pin r
    // *splat (only valid inside an array; encode as a splat element)
    else if str_eq lb "*" then
      (match r with
       | Cons (TId nm, r2) -> (PSplatP nm, r2)
       | _ -> (PSplatP "", r))
    // an interpolated string or regexp (`"#{x}"`, `/#{a}/o`, `%Q(a)`) lexes as
    // a `(s` group: a value, not a parenthesised pattern
    else if str_eq lb "(s" || str_eq lb " (s" then
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
    // **rest at top level of a bare hash pattern handled elsewhere; a bare
    // parenthesised pattern `(pat)` just groups.
    else if is_lparen lb then
      let (p, r2) = parse_pattern (skip_nls r) in (p, expect (skip_nls r2) ")")
    else
      // any other leading token: a value pattern (literal / range / etc.).
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
  // a bare identifier: a variable binding when lowercase, else a value/const.
  | Cons (TId nm, r) ->
    if is_upper_first nm then parse_const_pattern toks
    // `%x(echo a)` is a command literal -- a value, as in ruby's patterns
    else if str_eq nm "nil" || str_eq nm "true" || str_eq nm "false" || str_eq nm "`" then
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
    else
      // a lowercase name binds, unless a following `..`/`...` makes it a
      // range value pattern.
      (match r with
       // (...but only a pseudo-variable's: `in a..b` with a local or a
       //  call at the end is ruby's "unexpected ..")
       | Cons (TP dots, _) ->
         if str_eq dots ".." || str_eq dots "..." then
           (let _ = (if (str_len nm > 2 && str_eq (substring nm 0 2) "__") || str_eq nm "self" then ()
                     else syn_refuse ("unexpected " ++ dots ++ ", ignoring it")) in
            let (e, r2) = parse_pat_value toks in (PVal e, r2))
         else (PVar nm, r)
       | _ -> (PVar nm, r))
  | _ -> let (e, r) = parse_pat_value toks in (PVal e, r)

// a value pattern's expression: like parse_range but with the binary layer
// capped so alternation `|` (prec 5) is NOT consumed here — it belongs to the
// pattern grammar. Handles literals, unary minus, ranges, symbols, regexps.
and parse_pat_value = fn toks ->
  // a value pattern is a single primary (literal / const / symbol / regex /
  // unary-minus number) with an optional range — NOT an arithmetic expression.
  // Using parse_unary (not parse_bin) means `in 1 + 1` leaves `+ 1` behind, so
  // the clause's delimiter check reports a SyntaxError, as Ruby does.
  let (lo, r) = parse_unary toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | Cons (TNL _, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (ERange (lo, ENil, excl), rest) else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

// read a bare constant reference (`Foo`, `Foo::Bar`) WITHOUT consuming a
// trailing `[` / `(` — those introduce the deconstruct sub-pattern.
and parse_pat_const = fn toks ->
  match toks with
  | Cons (TP colons, Cons (TId nm, r)) -> if str_eq colons "::" then parse_pat_const_more (EConst nm) r else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad constant pattern")) in fail "mere-ruby: bad constant pattern")
  | Cons (TId nm, r) -> parse_pat_const_more (EConst nm) r
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a constant in pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a constant in pattern" ++ parsing_file ()))

and parse_pat_const_more = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP cc, Cons (TId nm2, r2)) -> if str_eq cc "::" then parse_pat_const_more (EScopedRead (e, nm2)) r2 else (e, toks)
  | _ -> (e, toks)

// `^name` / `^@x` / `^@@x` / `^$x` / `^(expr)`.
and parse_pin = fn toks ->
  match toks with
  | Cons (TP lp, r) ->
    // (the group may break its line: `1 in ^(1\n)`)
    if is_lparen lp then let (e, r2) = parse_expr (skip_nls r) in (PPin e, expect (skip_nls r2) ")")
    else if str_eq lp "@" then (match r with Cons (TId nm, r2) -> (PPin (EIVar nm), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad ^@ pattern")) in fail "mere-ruby: bad ^@ pattern"))
    else if str_eq lp "$" then (match r with Cons (TId nm, r2) -> (PPin (EVar ("$" ++ nm)), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad ^$ pattern")) in fail "mere-ruby: bad ^$ pattern"))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: bad ^ pattern")) in fail "mere-ruby: bad ^ pattern")
  | Cons (TId nm, r) ->
    // `^@x` / `^@@x` lex as an @-prefixed identifier; `^$g` as a $-name.
    if str_len nm >= 1 && str_eq (char_at nm 0) "@" then (PPin (EIVar (substring nm 1 (str_len nm))), r)
    else if str_len nm >= 1 && str_eq (char_at nm 0) "$" then (PPin (EVar nm), r)
    else (PPin (EVar nm), r)
  | _ -> let (e, r) = parse_primary toks in (PPin e, r)

// `Const`, `Const[...]`, `Const(...)`, `Const(id: p, ...)`; a bare Const is a
// value pattern (=== the class).
and parse_const_pattern = fn toks ->
  let (ce, r) = parse_pat_const toks in
  (match r with
   | Cons (TP lb, r2) ->
     if str_eq lb " [" || str_eq lb "[" then
       // the item/element parsers already consume the closing ] themselves.
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else if str_eq lb " (" || is_lparen lb then
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems_paren r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else (PVal ce, r)
   | _ -> (PVal ce, r))

// elements of an array pattern up to the closing `]`.
and parse_arr_pat_elems = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) ->
    if str_eq rb "]" then (rev_app acc Nil, r)
    else parse_arr_pat_one t acc
  | _ -> parse_arr_pat_one t acc

and parse_arr_pat_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       // a trailing comma before `]` makes the pattern match partially from the
       // start (`[0, 1, ]` == `[0, 1, *]`): append an anonymous splat.
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb "]" then (rev_app (Cons (PSplatP "", acc2)) Nil, r3) else parse_arr_pat_elems (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems (skip_nls r2) acc2)
     else if str_eq c "]" then (rev_app acc2 Nil, r2)
     // (`in [a:]`: a label in an array pattern, in prism's words)
     else if str_eq c ":" then (let _ = syn_refuse "unexpected implicit hash in pattern; use '\{' to delineate" in (rev_app acc2 Nil, r2))
     else (let __fm = ("mere-ruby: expected , or ] in array pattern, got " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
   | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array pattern" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array pattern" ++ parsing_file ())))

// like parse_arr_pat_elems but closes on `)` (Const(pat, ...) form).
and parse_arr_pat_elems_paren = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) -> if str_eq rb ")" then (rev_app acc Nil, r) else parse_arr_pat_one_p t acc
  | _ -> parse_arr_pat_one_p t acc

and parse_arr_pat_one_p = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb ")" then (rev_app acc2 Nil, r3) else parse_arr_pat_elems_paren (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems_paren (skip_nls r2) acc2)
     else if str_eq c ")" then (rev_app acc2 Nil, r2)
     else (let __fm = ("mere-ruby: expected , or ) in pattern, got " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
   | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated pattern" ++ parsing_file ()))) in fail ("mere-ruby: unterminated pattern" ++ parsing_file ())))

// a brace hash pattern `{ ... }` — consume up to `}`.
and parse_hash_pat_brace = fn toks ->
  match skip_nls toks with
  | Cons (TP rb, r) -> if str_eq rb "}" then (Nil, "", r) else hash_pat_braced toks
  | _ -> hash_pat_braced toks
// inside the braces a newline does not end the pattern: `in {a:\n  2}` is
// a: 2 (test_pattern_matching). The flag tells parse_hash_pat_kv.
and hash_pat_braced = fn toks ->
  let had = map_has parser_flags "hpbrace" in
  let _ = map_set parser_flags "hpbrace" VNil in
  let res = parse_hash_pat_items toks Nil "" in
  let _ = (if had then () else map_delete parser_flags "hpbrace") in
  res

// hash-pattern items: (label, sub-pattern) pairs plus a rest tag. Stops at
// `}` / `]` / `)` / end-of-clause. `rest` accumulates the **-form.
and parse_hash_pat_items = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      // **nil / **name / ** (anonymous)
      (match r0 with
       | Cons (TId nm, r1) -> if str_eq nm "nil" then hash_pat_sep r1 acc "nil" else hash_pat_sep r1 acc nm
       | _ -> hash_pat_sep r0 acc "*")
    else if str_eq dsp "}" || str_eq dsp "]" || str_eq dsp ")" then (rev_app acc Nil, rest, r0)
    else parse_hash_pat_kv t acc rest
  | _ -> parse_hash_pat_kv t acc rest

and parse_hash_pat_kv = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  // key: `label:` (identifier) or `"string":` (symbol key).
  let (key, r2) =
    (match toks with
     | Cons (TId nm, Cons (TP colon, r0)) -> if str_eq colon ":" then (nm, r0) else (let _ = syn_refuse "expected a label as the key in the hash pattern\nunexpected local variable or method; expected a key in the hash pattern" in ("", Nil))
     // (prism's second error names what stood where the key goes: `{a}`, `{0 => a}`)
     | Cons (TId _, _) -> (let _ = syn_refuse "expected a label as the key in the hash pattern\nunexpected local variable or method; expected a key in the hash pattern" in ("", Nil))
     | Cons (TInt _, _) -> (let _ = syn_refuse "expected a label as the key in the hash pattern\nunexpected integer; expected a key in the hash pattern" in ("", Nil))
     | Cons (TStrL s, Cons (TP colon, r0)) -> if str_eq colon ":" then (s, r0) else (let _ = syn_refuse "expected a label as the key in the hash pattern" in ("", Nil))
     // a "string": key (double-quoted, no interpolation) lexes as `(s "" + s )`.
     | Cons (TP op, Cons (TStrL empty, Cons (TP plus, Cons (TStrL s, Cons (TP cp, Cons (TP colon, r0)))))) ->
       if str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":" then (s, r0) else (let _ = syn_refuse "expected a label as the key in the hash pattern" in ("", Nil))
     | _ -> (let _ = syn_refuse "expected a label as the key in the hash pattern" in ("", Nil))) in
  // an omitted value (`a:`) binds the key name; otherwise parse a sub-pattern.
  // Do NOT skip newlines here: a newline / `;` ends a brace-less hash pattern
  // -- only inside braces may the value be on the next line.
  let r2 = (if map_has parser_flags "hpbrace" then skip_nls r2 else r2) in
  let (sub, r3) =
    (match r2 with
     | Cons (TP p, _) -> if str_eq p "," || str_eq p "}" || str_eq p "]" || str_eq p ")" then (PVar key, r2) else parse_pattern r2
     | Cons (TId gg, _) -> if str_eq gg "then" || str_eq gg "if" || str_eq gg "unless" then (PVar key, r2) else parse_pattern r2
     | Cons (TNL _, _) -> (PVar key, r2)
     | Cons (TEOF, _) -> (PVar key, r2)
     | _ -> parse_pattern r2) in
  // an omitted value binds a local of the key's name, so the key must be one
  // (`in a?:` is refused, as prism does)
  let _ = (match sub with
           | PVar k9 when str_len k9 > 0 && (str_eq (char_at k9 (str_len k9 - 1)) "?" || str_eq (char_at k9 (str_len k9 - 1)) "!") ->
             syn_refuse ("identifier " ++ k9 ++ " is not valid to set\nkey must be valid as local variables")
           | PVar k9 when (if hp_local_name k9 0 then false else true) -> syn_refuse "key must be valid as local variables"
           | _ -> ()) in
  // Ruby rejects a duplicated key name in a hash pattern.
  let _ = if pp_hitem_haskey acc key then syn_refuse "duplicated key name" else () in
  hash_pat_sep r3 (Cons ((key, sub), acc)) rest

// a name a local variable can have: a lowercase letter or `_` first (or a
// non-ASCII character), then letters, digits and `_`
and hp_local_name = fn (k: str) -> fn (i: int) ->
  if i >= str_len k then i > 0
  else (let o = ord (char_at k i) in
        let ok = (if i == 0 then (o >= 97 && o <= 122) || o == 95 || o >= 128
                  else (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || (o >= 48 && o <= 57) || o == 95 || o >= 128) in
        if ok then hp_local_name k (i + 1) else false)
and pp_hitem_haskey = fn (items: (str * Pat) list) -> fn (key: str) ->
  match items with Nil -> false | Cons (kp, r) -> let (k, _) = kp in str_eq k key || pp_hitem_haskey r key

and hash_pat_sep = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  match skip_nls toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_hash_pat_items r acc rest
    else if str_eq c "}" || str_eq c "]" || str_eq c ")" then (rev_app acc Nil, rest, r)
    else (rev_app acc Nil, rest, toks)
  | _ -> (rev_app acc Nil, rest, toks)

// A `when` value the parser can compare with another: a literal, and only a
// literal. Anything computed is "" and never counts as a duplicate -- two
// clauses saying `when foo` are not the same clause as far as the parser can
// tell, and ruby does not claim they are either.
and when_lit_key = fn (e: Expr) ->
  (match e with
   | EInt n9 -> "i" ++ str_of_int n9
   | EStrL s9 -> "s" ++ s9
   | ESym y9 -> "y" ++ y9
   | EBool b9 -> (if b9 then "b1" else "b0")
   | EFlt f9 -> "f" ++ str_of_float f9
   | ENil -> "n"
   // (...and the literals that are not one token's value: an integer past
   //  int64, a string under a frozen_string_literal comment, a Rational, an
   //  imaginary, a regexp -- `{"a" => 1, "a" => 2}` in such a file, and
   //  `{1.0r => 1, 1.0r => 2}`, said nothing)
   | EBig b9 -> "i" ++ b9
   | EMethod (e9, m9, Nil) when str_len m9 > 10 && (str_eq (substring m9 0 10) "__lit_fsl~" || str_eq (substring m9 0 10) "__lit_enc~") ->
     (match lit_static_str e with (true, s9) -> "s" ++ s9 | _ -> "")
   | EBin (_, _, _) -> (match lit_static_str e with (true, s9) -> "s" ++ s9 | _ -> "")
   | ERat (n9, d9) -> "r" ++ lit_rat_disp n9 d9
   | EImag n9 -> "c" ++ str_of_int n9
   | EImagF f9 -> "c" ++ str_of_float f9
   | ERegex (p9, f9) -> "x" ++ f9 ++ "/" ++ p9
   | EVar n9 when str_len n9 >= 8 && str_eq (substring n9 0 8) "__FILE__" -> "F"
   | EVar n9 when str_len n9 >= 12 && str_eq (substring n9 0 12) "__ENCODING__" -> "E" ++ n9
   | _ -> "")
// a double-quoted string with nothing interpolated is a `+` chain of pieces
// (the lexer's desugaring): its text, when every piece is a literal
and lit_static_str = fn (e: Expr) ->
  (match e with
   | EStrL s9 -> (true, s9)
   // (and through the markers a literal wears: its file's
   //  frozen_string_literal answer, its source encoding)
   | EMethod (e9, m9, Nil) when str_len m9 > 10 && (str_eq (substring m9 0 10) "__lit_fsl~" || str_eq (substring m9 0 10) "__lit_enc~") ->
     lit_static_str e9
   | EBin (o9, a9, b9) when str_eq o9 "+" ->
     (match (lit_static_str a9, lit_static_str b9) with
      | ((true, x9), (true, y9)) -> (true, x9 ++ y9)
      | _ -> (false, ""))
   | _ -> (false, ""))
// a Rational literal's value as ruby inspects it, reduced: `1.0r` is (1/1)
and lit_rat_disp = fn (n: str) -> fn (d: str) ->
  if str_len n > 17 || str_len d > 17 then "(" ++ n ++ "/" ++ d ++ ")"
  else (let a = int_of_str n in let b = int_of_str d in
        let rec g = fn (x: int) -> fn (y: int) -> if y == 0 then x else g y (x - (x / y) * y) in
        let k = g (if a < 0 then 0 - a else a) b in
        let k = (if k == 0 then 1 else k) in
        "(" ++ str_of_int (a / k) ++ "/" ++ str_of_int (b / k) ++ ")")
// A hash LITERAL warns about a duplicated key, the way a case/when warns about
// a duplicated clause -- same literal-key rule, same warn_note. The key that
// wins is the LAST one, so the warning is about the earlier one being dropped.
// ⚠ Only literal keys: `{x => 1, y => 1}` may or may not collide at run time,
// and ruby says nothing about those either.
and hsh_note_dups = fn (items: Expr list) -> fn (seen: (str * int) list) -> fn (ln: int) ->
  (match items with
   // ⚠ `**{a: 1}` contributes KEYS too, and they collide with the literal ones
   // around them: `{**{a: 1}, a: 2}` warns. Only a literal hash can be read
   // this way -- `**h` names a variable, and what is in it is a run-time
   // question this walk cannot answer, so it contributes nothing.
   | Cons (EKwSplat inner9, Cons (_, t9)) ->
     (match inner9 with
      | EHsh its9 -> hsh_note_dups t9 (hsh_note_dups its9 seen ln) ln
      | _ -> hsh_note_dups t9 seen ln)
   // interleaved [k1, v1, k2, v2, ...]: step two at a time.
   | Cons (k9, Cons (_, t9)) ->
     (let key = when_lit_key k9 in
      if str_eq key "" then hsh_note_dups t9 seen ln
      else if when_seen_line seen key > 0 then
        (let _ = warn_note (parse_time_file () ++ ":" ++ str_of_int ln
                            ++ ": warning: key " ++ hsh_key_disp k9
                            ++ " is duplicated and overwritten on line " ++ str_of_int ln) in
         hsh_note_dups t9 seen ln)
      else hsh_note_dups t9 (Cons ((key, ln), seen)) ln)
   | _ -> seen)
// the key as the warning prints it: ruby inspects it.
and hsh_key_disp = fn (e: Expr) ->
  (match e with
   | EInt n9 -> str_of_int n9
   | EStrL s9 -> "\"" ++ s9 ++ "\""
   | ESym y9 -> ":" ++ y9
   | EBool b9 -> (if b9 then "true" else "false")
   | EFlt f9 -> str_of_float f9
   | ENil -> "nil"
   | EBig b9 -> b9
   | EMethod (e9, m9, Nil) when str_len m9 > 10 && (str_eq (substring m9 0 10) "__lit_fsl~" || str_eq (substring m9 0 10) "__lit_enc~") ->
     (match lit_static_str e with (true, s9) -> "\"" ++ s9 ++ "\"" | _ -> "?")
   | EBin (_, _, _) -> (match lit_static_str e with (true, s9) -> "\"" ++ s9 ++ "\"" | _ -> "?")
   | ERat (n9, d9) -> lit_rat_disp n9 d9
   | EImag n9 -> "(0+" ++ str_of_int n9 ++ "i)"
   | EImagF f9 -> "(0+" ++ str_of_float f9 ++ "i)"
   | ERegex (p9, f9) -> "/" ++ p9 ++ "/" ++ f9
   | EVar n9 when str_len n9 >= 8 && str_eq (substring n9 0 8) "__FILE__" -> "\"" ++ parse_time_file () ++ "\""
   // (captured at parse time as "__ENCODING__~<NAME>")
   | EVar n9 when str_len n9 >= 12 && str_eq (substring n9 0 12) "__ENCODING__" ->
     "#<Encoding:" ++ (if str_len n9 > 13 then substring n9 13 (str_len n9) else "UTF-8") ++ ">"
   | _ -> "?")
and when_seen_line = fn (seen: (str * int) list) -> fn (k: str) ->
  (match seen with
   | Nil -> 0
   | Cons ((k9, l9), t9) -> if str_eq k9 k then l9 else when_seen_line t9 k)
// note every literal of THIS clause, warning for the first one already seen
and when_note_dups = fn (vs: Expr list) -> fn (seen: (str * int) list) -> fn (ln: int) ->
  (match vs with
   | Nil -> seen
   | Cons (v9, t9) ->
     (let k9 = when_lit_key v9 in
      if str_eq k9 "" then when_note_dups t9 seen ln
      else
        (let prev = when_seen_line seen k9 in
         if prev > 0 then
           (let _ = warn_note (parse_time_file () ++ ":" ++ str_of_int ln
                               ++ ": warning: 'when' clause on line " ++ str_of_int ln
                               ++ " duplicates 'when' clause on line " ++ str_of_int prev
                               ++ " and is ignored") in
            when_note_dups t9 seen ln)
         else when_note_dups t9 (Cons ((k9, ln), seen)) ln)))

and parse_whens = fn (subj: Expr) -> fn toks -> fn acc -> fn (seen: (str * int) list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "when" then
      let ln9 = tok_line t in
      // the values may start on the NEXT line: ruby reads `when` then a
      // newline then the value as one clause (rubygems' request.rb ends its
      // certificate-error case that way), where this parsed an empty value.
      let (vs, r2) = parse_when_vals (skip_nls r) Nil in
      let seen2 = when_note_dups vs seen ln9 in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      parse_whens subj r3 (Cons ((vs, b), acc)) seen2
    else if str_eq id "else" then
      let _ = (match acc with
               | Nil -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (cstr_h "mere-ruby: case with else but no when")) in fail "mere-ruby: case with else but no when")
               | _ -> ()) in
      let (b, r2) = parse_stmts r Nil in
      (SCase (subj, rev_app acc Nil, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCase (subj, rev_app acc Nil, Nil), r)
    // (and an `in` among the `when` clauses, "unexpected 'in'")
    else if str_eq id "in" then (let _ = syn_refuse "unexpected 'in'" in (SCase (subj, rev_app acc Nil, Nil), r))
    else (let __fm = ("mere-ruby: expected when/else/end in case, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated case" ++ parsing_file ()))) in fail ("mere-ruby: unterminated case" ++ parsing_file ()))

and parse_when_vals = fn toks -> fn (acc: Expr list) ->
  // `when *ary` splices the array's elements as candidates.
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) -> if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1) else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    // a `when` value list may wrap after the comma (`when A,\n     B then`).
    if str_eq p "," then parse_when_vals (skip_nls r2) (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// `def name(p1, p2) ... end` or `def name ... end`. Parameters are
// optional parens; the body runs until `end`.
and parse_def_counted = fn (r: Tok list) ->
  let d9 = (if map_has def_depth "n" then map_get def_depth "n" else 0) in
  let _ = map_set def_depth "n" (d9 + 1) in
  let res9 = parse_def r in
  let _ = map_set def_depth "n" d9 in
  res9
and parse_def = fn toks ->
  // A def parsed as a command argument (`internal def m ... end`, zeitwerk)
  // inherits the caller's "nodo" flag, which is there to stop the COMMAND
  // taking a do-block. The def's own body is a new context: a do-block
  // inside it belongs to whatever it follows there.
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let sl9 = tok_line toks in
  let _ = (if map_has parser_flags "defend" then map_delete parser_flags "defend" else ()) in
  let r = parse_def_inner toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  // (where its `end` is -- the def's own line for an endless one)
  // (keyed by the bare name and the line: the file the parser names and the
  //  one running are not spelled alike for the main program)
  let _ = (match r with
           | (SDef (dn9, _, _, _), _) when sl9 > 0 ->
             (let k9 = def_bare_name dn9 ++ ":" ++ str_of_int sl9 in
              let _ = map_set def_end_lines k9
                        (if map_has parser_flags "defend" then map_get parser_flags "defend" else VInt sl9) in
              // (an endless def has no `end`, and its body makes no :line)
              if map_has parser_flags "defend" then () else map_set def_end_lines ("~" ++ k9) (VInt 1))
           | _ -> ()) in
  let _ = (if map_has parser_flags "defend" then map_delete parser_flags "defend" else ()) in
  r

and parse_def_inner = fn toks ->
  match toks with
  // `def (expr).name; end` -- a singleton method on whatever the parenthesised
  // expression evaluates to. `def (nil).foo; end` is how the specs check that
  // defining one on nil does not make singleton_method find it. Only a bare
  // name or `self.` was accepted here, so five spec files did not parse at all.
  // The receiver is parsed and thrown away except for its shape: this supports
  // the constant / nil / true / false / self forms the corpus uses, which is
  // what a singleton class can be opened on anyway.
  | Cons (TP lp0, r0) when is_lparen lp0 ->
    (let (recv_e, r1) = parse_expr r0 in
     match r1 with
     // ...and the name after the dot may be an OPERATOR: ruby/spec builds its
     // matchers as `def (@m = BasicObject.new).===(obj)`, which is a def, an
     // assignment and an operator name in one line. Only TId was accepted, so
     // both grep specs aborted at parse time -- the record's only two CRASHes.
     | Cons (TP rp0, Cons (TP dot0, Cons (TP opnm, r2b))) when
         str_eq rp0 ")" && str_eq dot0 "." && def_op_name opnm ->
       (let (params, defs, r3) =
          (match r2b with
           | Cons (TP p, r4) -> if is_lparen p then parse_params r4 Nil Nil else (Nil, Nil, r2b)
           | _ -> (Nil, Nil, r2b)) in
        let (d, r5) = parse_def_tail opnm params defs r3 in
        (SSingletonE (recv_e, Cons (d, Nil)), r5))
     | Cons (TP rp0, Cons (TP dot0, Cons (TId nm0, r2))) ->
       if str_eq rp0 ")" && str_eq dot0 "." then
         (let (params, defs, r3) =
            (match r2 with
             | Cons (TP p, r4) ->
               if is_lparen p then parse_params r4 Nil Nil
               // (paren-less, as a named receiver's: `def (o).foo ...; bar(...); end`)
               else if str_eq p "*" || str_eq p "**" || str_eq p " *" || str_eq p " **" || str_eq p "&" || str_eq p "..." then parse_bare_params r2 Nil Nil
               else (Nil, Nil, r2)
             | Cons (TId _, _) -> parse_bare_params r2 Nil Nil
             | _ -> (Nil, Nil, r2)) in
          // nil / true / false are singletons: there is one of each, so a
          // singleton method on one is an instance method of its class. Say
          // that directly by wrapping the def in the class body rather than
          // registering a key that resolves somewhere else -- defining a method
          // nobody can call is worse than refusing to parse.
          match recv_e with
          | ENil -> (let (d, r5) = parse_def_tail nm0 params defs r3 in (SClass ("NilClass", "", Cons (d, Nil)), r5))
          | EBool b -> (let (d, r5) = parse_def_tail nm0 params defs r3 in
                        (SClass ((if b then "TrueClass" else "FalseClass"), "", Cons (d, Nil)), r5))
          // a constant, a local or self: the receiver has a real singleton
          | EConst cn -> parse_def_tail (cn ++ "#" ++ nm0) params defs r3
          | ESelf -> parse_def_tail ("self." ++ nm0) params defs r3
          | EVar v -> parse_def_tail (v ++ "#" ++ nm0) params defs r3
          // any other expression -- an assignment, a call, an ivar -- is the
          // receiver whatever it evaluates to, which is what `class << expr`
          // already means. The def goes in that body.
          | _ -> (let (d, r5) = parse_def_tail nm0 params defs r3 in
                  (SSingletonE (recv_e, Cons (d, Nil)), r5)))
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())))
  // operator method names: def ==, def <=>, def []=, def +, def <<, ...
  | Cons (TP op0, r0) ->
    // the lexer space-marks a bracket after "def " — same as a plain [.
    // the lexer space-marks a bracket / ampersand after "def " (` [`, ` &`);
    // normalise to the bare operator name.
    let op1 = if str_eq op0 " [" then "[" else if str_eq op0 " &" then "&" else op0 in
    let (name, r) =
      if str_eq op1 "[" then
        (match r0 with
         | Cons (TP rb2, r1) ->
           if str_eq rb2 "]" then
             (match r1 with
              | Cons (TP eq2, r2) -> if str_eq eq2 "=" then ("[]=", r2) else ("[]", r1)
              | _ -> ("[]", r1))
           else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))
         | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())))
      // ⚠ `def !@` / `def !` -- unary bang. RUBY NAMES BOTH `:!`, with no `@`
      //   form at all (unlike +@ and -@), and this normalised them to "!@" --
      //   a name nothing else looks up. `!obj` found it because the operator
      //   arm asked for "!@" too, and `obj.send(:!)` did not, so the same
      //   method was there through one spelling and missing through the other.
      //   mspec's mocks stub `!` and call it by name.
      else if str_eq op1 "!" then
        (match r0 with
         | Cons (TId at, r1) -> if str_eq at "@" then ("!", r1) else ("!", r0)
         | _ -> ("!", r0))
      // `def -@` / `def +@` — unary operator methods (op followed by @).
      else if (str_eq op1 "-" || str_eq op1 "+") &&
              (match r0 with Cons (TId at, _) -> str_len at >= 1 && str_eq (char_at at 0) "@" | _ -> false) then
        (match r0 with
         | Cons (TId at, r1) ->
           if str_eq at "@" then (op1 ++ "@", r1)
           // `-@x` lexes as the ivar @x after the op — split it back.
           else (op1 ++ "@", Cons (TId (substring at 1 (str_len at)), r1))
         | _ -> (op1 ++ "@", r0))
      else if is_op_method_name op1 then (op1, r0)
      else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) -> if is_lparen p then parse_params r3 Nil Nil else (Nil, Nil, r)
       // an operator method takes paren-less parameters too: `def []= k, v`
       // is how psych's Coder writes its setter.
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    parse_def_tail name params defs r2
  | Cons (TId name0, r0) ->
    // `def recv.name` — a singleton method. `def self.m` drops self. and
    // registers on the enclosing class/module; `def C.m` registers under
    // "C#m" so `C.m` (VClass dispatch) finds it.
    let (name, r) =
      (match r0 with
       | Cons (TP dot, r1) ->
         // `def Klass::name` is the same definition as `def Klass.name` (rexml
         // writes `def Document::entity_expansion_text_limit=(val)`).
         if str_eq dot "." || str_eq dot "::" then
           (match r1 with
            | Cons (TId n2, r2) -> if str_eq name0 "self" then ("self." ++ n2, r2) else (name0 ++ "#" ++ n2, r2)
            // def self.<< / def obj.== / def obj.[] — an operator singleton
            // method. Carry the receiver prefix like the TId case, so it
            // registers on the receiver's singleton rather than as a bare
            // top-level operator method (self. prefix for self, name# else).
            | Cons (TP op2, r2) ->
              let pfx = if str_eq name0 "self" then "self." else name0 ++ "#" in
              if str_eq op2 "[" then
                (match r2 with
                 | Cons (TP rb2, r3) ->
                   if str_eq rb2 "]" then
                     (match r3 with
                      | Cons (TP eq2, r4) -> if str_eq eq2 "=" then (pfx ++ "[]=", r4) else (pfx ++ "[]", r3)
                      | _ -> (pfx ++ "[]", r3))
                   else (name0, r0)
                 | _ -> (name0, r0))
              else if is_op_method_name op2 then (pfx ++ op2, r2)
              else (name0, r0)
            | _ -> (name0, r0))
         else (name0, r0)
       | _ -> (name0, r0)) in
    // setter definition `def x=(v)` — the `=` is part of the name. Guard
    // against endless defs `def x = (expr)` by requiring a real parameter
    // `( ident )` / `( ident ,` inside (a string desugars to `("" + ...)`).
    let (name, r) =
      (match r with
       | Cons (TP eq, r1) ->
         if str_eq eq "=" then
           (match r1 with
            | Cons (TP lp, Cons (TId _, Cons (TP rp, _))) ->
              // `=` third: the parameter has a DEFAULT (`def variables=( vars={} )`,
              // rexml). An endless def cannot reach here -- the lexer marks its
              // spaced `=` as a different token.
              if str_eq lp "(" && (str_eq rp ")" || str_eq rp "," || str_eq rp "=")
              then (name ++ "=", r1) else (name, r)
            // `def foobar=(*)` — a setter taking an anonymous splat, and
            // `def location=((a, b))` — one whose parameter destructures.
            | Cons (TP lp, Cons (TP st, _)) ->
              // (and `def foo=()` -- empty parentheses, an endless method's
              //  spaced `=` lexes otherwise -- which ruby then refuses as a
              //  setter when an endless body follows)
              if str_eq lp "(" && (str_eq st "*" || str_eq st "**" || is_lparen st || str_eq st ")") then (name ++ "=", r1) else (name, r)
            // `def value= value` — a setter whose parameter has no parens. An
            // endless method cannot look like this: its body would have to be
            // a bare name followed by a newline, which is a name, not a body.
            | Cons (TId pn, r2) ->
              (if is_keyword pn then (name, r)
               else match r2 with
                    | Cons (TNL _, _) -> (name ++ "=", r1)
                    | Cons (TEOF, _) -> (name ++ "=", r1)
                    | Cons (TP semi, _) -> if str_eq semi ";" then (name ++ "=", r1) else (name, r)
                    | _ -> (name, r))
            // `def default=` and the line ends -- a setter that takes nothing
            // (test_hash's test_default=, which only `send` can call). An
            // endless def is spaced (`def x = v`) and lexes otherwise.
            | Cons (TNL _, _) -> (name ++ "=", r1)
            | Cons (TEOF, _) -> (name ++ "=", r1)
            | _ -> (name, r))
         else (name, r)
       | _ -> (name, r)) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) ->
         if is_lparen p then parse_params r3 Nil Nil
         // `def send **kw` (debug's DAP/CDP servers): a paren-less list may
         // open with the double splat as well as the single one.
         else if str_eq p "*" || str_eq p "**" || str_eq p " *" || str_eq p " **" || str_eq p "&" || str_eq p " &" || str_eq p "..." then parse_bare_params r Nil Nil
         else (Nil, Nil, r)
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    // `def nil.x` / `def true.x` / `def false.x`: there is one of each, so a
    // method on it is an instance method of its class, as the `def (nil).x`
    // spelling already had it (it was a key nothing found: "undefined method")
    let sng9 = (if str_eq name0 "nil" then "NilClass" else if str_eq name0 "true" then "TrueClass" else if str_eq name0 "false" then "FalseClass" else "") in
    if str_len sng9 > 0 && str_len name > str_len name0 + 1 && str_eq (substring name 0 (str_len name0 + 1)) (name0 ++ "#") then
      // (as `NilClass.class_eval do def x ... end end`, which a method body
      //  may hold: a class statement there is no class body, and `def
      //  nil.x` inside a method defined nothing -- test_eval)
      (let (d9, r9) = parse_def_tail (substring name (str_len name0 + 1) (str_len name)) params defs r2 in
       (SExpr (EMethodB (EConst sng9, "class_eval", Nil, Nil, Cons (d9, Nil))), r9))
    else
    parse_def_tail name params defs r2
  // (a literal where the name goes, as prism names it)
  | Cons (TSym _, _) -> (let _ = syn_refuse "unexpected symbol literal; expected a method name" in (SExpr ENil, toks))
  | Cons (TStrL _, _) -> (let _ = syn_refuse "unexpected string literal; expected a method name" in (SExpr ENil, toks))
  | Cons (TP sq, _) when str_eq sq "(s" -> (let _ = syn_refuse "unexpected string literal; expected a method name" in (SExpr ENil, toks))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))

// endless method `def name(params) = expr` — body is a single expression;
// otherwise the body runs to `end`. Operator-named defs take this path too
// (`def >>(k) = Bits.new(@n >> k)`).
and parse_def_tail = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
  // (`...` after a rest parameter is ruby's "... after rest argument")
  let _ = (if ps_has params "*__fwd" && anon_has_rest params
           then syn_refuse "... after rest argument" else ()) in
  let _ = afr_push ("D" ++ anon_flags params) in
  let res9 = parse_def_tail_in name params defs r2 in
  let _ = afr_pop () in
  res9
// the letters of a frame (see afr) for a parameter list: `(*)` is
// "*__anonrest" and a paren-less `*` is "*"; `...` is "*__fwd" with an
// "&__anonblk" beside it, which is no `&` of its own
and anon_flags = fn (ps: str list) ->
  let f9 = ps_has ps "*__fwd" in
  (if ps_has ps "*__anonrest" || ps_has ps "*" then "r" else "")
  ++ (if ps_has ps "**__anonkw" then "k" else "")
  ++ (if (ps_has ps "&__anonblk" && (if f9 then false else true)) || ps_has ps "&" then "b" else "")
  ++ (if f9 then "f" else "")
and ps_has = fn (ps: str list) -> fn (x: str) ->
  match ps with Nil -> false | Cons (p9, t9) -> str_eq p9 x || ps_has t9 x
and anon_has_rest = fn (ps: str list) ->
  match ps with
  | Nil -> false
  | Cons (p9, t9) ->
    (str_len p9 >= 1 && str_eq (substring p9 0 1) "*"
     && (if str_len p9 >= 2 && str_eq (substring p9 0 2) "**" then false else true)
     && (if str_eq p9 "*__fwd" || str_eq p9 "*__opt" then false else true))
    || anon_has_rest t9
and afr_push = fn (fl: str) ->
  let n9 = (if map_has afr_n "n" then map_get afr_n "n" else 0) + 1 in
  let _ = map_set afr_n "n" n9 in
  map_set afr (str_of_int n9) fl
and afr_pop = fn (u: unit) ->
  let n9 = (if map_has afr_n "n" then map_get afr_n "n" else 0) in
  map_set afr_n "n" (if n9 > 0 then n9 - 1 else 0)
// a call passes the anonymous `k` on: the innermost def must have taken it,
// and no block or lambda between may have taken one of its own. A string
// eval's parse has no frames: it is the calling method's, which the parser
// cannot see, and is let through.
and anon_use = fn (k: str) ->
  anon_use_at k (if map_has afr_n "n" then map_get afr_n "n" else 0)
and anon_use_at = fn (k: str) -> fn (i: int) ->
  let what9 = (if str_eq k "r" then "rest parameter" else if str_eq k "k" then "keyword rest parameter" else "block parameter") in
  if i <= 0 then
    (let p9 = (if map_has load_ctx "parsing" then (match map_get load_ctx "parsing" with VStr h -> sget h | _ -> "") else "") in
     if str_len p9 >= 6 && str_eq (substring p9 0 6) "(eval)" then ()
     else if str_eq k "f" then syn_refuse "unexpected ..."
     else syn_refuse ("no anonymous " ++ what9))
  else
    (let fl9 = (if map_has afr (str_of_int i) then map_get afr (str_of_int i) else "D") in
     if str_eq (substring fl9 0 1) "B" then
       (if (if str_eq k "f" then false else str_contains fl9 k)
        then syn_refuse ("anonymous " ++ what9 ++ " is also used within block")
        else anon_use_at k (i - 1))
     else if str_contains fl9 k then ()
     else if str_eq k "f" then syn_refuse "unexpected ..."
     else syn_refuse ("no anonymous " ++ what9))
and parse_def_tail_in = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
  (match r2 with
   | Cons (TP eq, r3) ->
     if str_eq eq "=" || str_eq eq " =" then
       // ⚠ the body may start on the NEXT line -- `def m(n) =` with the
       //   expression below it is how ruby/spec writes a multi-line endless
       //   method, and stopping at the newline made it "unexpected end of
       //   input" and aborted the whole file. The `=` has already committed
       //   this to being a body, so there is nothing else the next expression
       //   could be.
       // ...and it is a statement like any other, with a line of its own: a
       //   body with no SLine ran at the CALLER's line, so `def m = caller(0)`
       //   reported the call site as the method's own position.
       // (a SETTER cannot be endless -- `def x=(v) = v`, `def []=(k, v) = v`
       //  are ruby's SyntaxError; ==, !=, <=, >= and === are no setters)
       // (read off the END of the name: a singleton def's name carries its
       //  receiver in front, `o.==`)
       let _ = (let n9 = str_len name in
                let ends9 = fn (sfx: str) -> n9 >= str_len sfx && str_eq (substring name (n9 - str_len sfx) n9) sfx in
                if n9 >= 2 && ends9 "="
                   && (if ends9 "==" || ends9 "!=" || ends9 "<=" || ends9 ">=" then false else true)
                then syn_refuse "invalid method name; a setter method cannot be defined in an endless method definition"
                else ()) in
       let t4 = skip_nls r3 in
       let ln4 = tok_line t4 in
       // (a rescue modifier after the body is the body's: `def f = raise
       //  rescue 1` answers 1 -- it rescued nothing, the def itself)
       let (e, r4) = (let (e0, r40) = parse_expr t4 in opasgn_resc e0 r40) in
       let f4 = parse_time_file () in
       let b4 = (if ln4 > 0 then Cons (SLine ln4, Cons (SExpr e, Nil)) else Cons (SExpr e, Nil)) in
       (SDef (name, params, defs, (if str_eq f4 "" then b4 else Cons (SFile f4, b4))), r4)
     else parse_def_body name params defs r2
   | _ -> parse_def_body name params defs r2)

and is_op_method_name = fn (op: str) ->
  // "|" is itself one of the names, and it is the separator, so it is asked
  // for directly rather than smuggled into the list.
  str_eq op "|" ||
  map_has (name_set "opmeth") op

and parse_def_body = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
    let (body0, r4) = parse_stmts r2 Nil in
    // method-level rescue/ensure: `def f ... rescue ... end` wraps the
    // whole body in an implicit begin.
    let (body, r5) =
      (match r4 with
       | Cons (TId k, _) ->
         if str_eq k "rescue" || str_eq k "ensure" then
           let (rescues, ra) = parse_rescues r4 Nil in
           let (els, rb) = parse_opt_kw_block ra "else" in
           let (ens, rc) = parse_opt_kw_block rb "ensure" in
           (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
         else (body0, r4)
       | _ -> (body0, r4)) in
    let _ = map_set parser_flags "defend" (VInt (tok_line r5)) in
    (SDef (name, params, defs, body), expect_kw r5 "end")

// the base name of a param string, stripping *, **, & prefixes, a : suffix,
// and any `~N` uniquification suffix (so a renamed `_~1` still counts as `_`).
and pbase = fn (p: str) ->
  let p = if str_len p >= 2 && str_eq (substring p 0 2) "**" then substring p 2 (str_len p)
          else if str_len p >= 1 && (str_eq (char_at p 0) "*" || str_eq (char_at p 0) "&") then substring p 1 (str_len p)
          else if str_len p >= 1 && str_eq (char_at p (str_len p - 1)) ":" then substring p 0 (str_len p - 1)
          else p in
  str_before_char p "~" 0
and str_before_char = fn (s: str) -> fn (ch: str) -> fn (i: int) ->
  if i >= str_len s then s
  else if str_eq (char_at s i) ch then substring s 0 i
  else str_before_char s ch (i + 1)
and lex_alnum = fn (c: str) ->
  str_len c == 1 && ((c >= "0" && c <= "9") || (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || str_eq c "_")
// `@` / `@@` with no name after it, or a name starting with a digit
and lex_var_name_check = fn (s: str) -> fn (i: int) -> fn (st: int) -> fn (j: int) -> fn (kind: str) ->
  let sig = substring s i st in
  if j == st then
    (if st < str_len s && is_digit (char_at s st) then
       (let rec dg = fn (k: int) -> (if k < str_len s && lex_alnum (char_at s k) then dg (k + 1) else k) in
        syn_refuse ("'" ++ substring s i (dg st) ++ "' is not allowed as " ++ (if str_eq kind "instance" then "an" else "a") ++ " " ++ kind ++ " variable name"))
     else syn_refuse ("'" ++ sig ++ "' without identifiers is not allowed as " ++ (if str_eq kind "instance" then "an" else "a") ++ " " ++ kind ++ " variable name"))
  else if is_digit (char_at s st) then
    syn_refuse ("'" ++ substring s i j ++ "' is not allowed as " ++ (if str_eq kind "instance" then "an" else "a") ++ " " ++ kind ++ " variable name")
  else ()
// a parameter name used twice is ruby's SyntaxError ("duplicated argument
// name"); `_` and names starting with it may repeat, and the hidden names a
// bare `*` / `**` / `&` gets start with it too
and param_dup_check = fn (ps: str list) ->
  let _ = param_kind_check ps in
  // (ruby's call cache keeps a keyword count in 16 bits: 65535 at most)
  let _ = (if param_kw_count ps 0 > 65535 then syn_refuse "too many keyword parameters" else ()) in
  if param_has_dup ps then syn_refuse "duplicated argument name" else ()
// a formal argument is a local name: not a constant, not an instance, class
// or global variable, and not a name ending in ? or !
and param_kw_count = fn (ps: str list) -> fn (n: int) ->
  match ps with
  | Nil -> n
  | Cons (h, t) -> param_kw_count t (if str_len h >= 1 && str_eq (char_at h (str_len h - 1)) ":" then n + 1 else n)
and val_list_len_e = fn (xs: Expr list) -> expr_count_go xs 0
and expr_count_go = fn (xs: Expr list) -> fn (n: int) ->
  match xs with Nil -> n | Cons (_, t) -> expr_count_go t (n + 1)
and param_kind_check = fn (ps: str list) ->
  match ps with
  | Nil -> ()
  | Cons (h, t) ->
    (let b = pbase h in
     let _ = (if str_len b == 0 then ()
              else (let c0 = char_at b 0 in
                    if c0 >= "A" && c0 <= "Z" then syn_refuse "invalid formal argument; formal argument cannot be a constant"
                    else if str_len b >= 2 && str_eq (substring b 0 2) "@@" then syn_refuse "invalid formal argument; formal argument cannot be a class variable"
                    else if str_eq c0 "@" then syn_refuse "invalid formal argument; formal argument cannot be an instance variable"
                    else if str_eq c0 "$" then syn_refuse "invalid formal argument; formal argument cannot be a global variable"
                    else if str_eq (char_at b (str_len b - 1)) "?" || str_eq (char_at b (str_len b - 1)) "!" then syn_refuse ("identifier " ++ b ++ " is not valid to set")
                    else ())) in
     param_kind_check t)
// one pass over the names, a set of the bases seen: comparing every pair
// (with a substring for each) was quadratic, and a def of 65535 keywords --
// test_keyword asks for exactly that -- grew to tens of GB
// `|_, _|`: a name starting with `_` may repeat, and the FIRST one is the
// local -- the later ones bind nothing (they get a hidden name each, the
// `name~N` a method's repeated parameter gets, which #parameters reports as
// the name)
and bp_under_dedup = fn (ps: str list) -> fn seen9 -> fn (i: int) ->
  match ps with
  | Nil -> (Nil : str list)
  | Cons (h, t) ->
    (if str_len h > 0 && str_eq (char_at h 0) "_" && (if str_contains h "~" || str_eq (char_at h (str_len h - 1)) ":" then false else true) then
       (if map_has seen9 h then Cons (h ++ "~" ++ str_of_int i, bp_under_dedup t seen9 (i + 1))
        else (let _ = map_set seen9 h 1 in Cons (h, bp_under_dedup t seen9 (i + 1))))
     else Cons (h, bp_under_dedup t seen9 (i + 1)))
// a block's parameters and its block-locals (`;name`) share one namespace
and bp_dup_check = fn (ps: str list) ->
  let rec strip = fn (xs: str list) ->
    (match xs with
     | Nil -> (Nil : str list)
     | Cons (h, t) -> Cons ((if str_len h > 1 && str_eq (char_at h 0) ";" then substring h 1 (str_len h) else h), strip t)) in
  if param_has_dup (strip ps) then syn_refuse "duplicated argument name" else ()
and param_has_dup = fn (ps: str list) ->
  let seen9 = map_new () in
  param_has_dup_go ps seen9
and param_has_dup_go = fn (ps: str list) -> fn seen9 ->
  match ps with
  | Nil -> false
  | Cons (h, t) ->
    (let b = pbase h in
     // (a destructuring `(a, *)` is skipped: the anonymous parts of two of
     //  them share one hidden name, which ruby allows)
     if str_len b == 0 || str_eq (char_at b 0) "_" || str_eq (char_at b 0) "(" then param_has_dup_go t seen9
     else if map_has seen9 b then true
     else (let _ = map_set seen9 b 1 in param_has_dup_go t seen9))
and pcount_kw_base = fn (acc: str list) -> fn (base: str) ->
  match acc with
  | Nil -> 0
  | Cons (h, t) -> (if str_len h >= 1 && str_eq (char_at h (str_len h - 1)) ":" && str_eq (pbase h) base then 1 else 0) + pcount_kw_base t base
and pcount_base = fn (acc: str list) -> fn (base: str) ->
  match acc with Nil -> 0 | Cons (h, t) -> (if str_eq (pbase h) base then 1 else 0) + pcount_base t base
// Ruby allows the ignore-name `_` to repeat in a parameter list; give each
// repeat a unique internal storage key (first keeps the bare `_`) so they bind
// to distinct slots and a bare `super` forwards them positionally. Other
// duplicate names are a SyntaxError in Ruby, so they are left untouched.
// (not a KEYWORD `_:` -- its name is the key a caller passes, `_: 42`, and a
//  renamed one answered "unknown keyword: :_")
// a second `**`, or `**nil` (no keywords at all) after a keyword: ruby's
// refusals for `def m(**a, **nil)` and `def m(a:, **nil)`
// a second `*` (not the `*,` a trailing comma leaves)
and splat_check = fn (acc: str list) ->
  let rec any9 = fn (xs: str list) ->
    (match xs with
     | Nil -> false
     | Cons (x, t) -> (str_len x >= 1 && str_eq (char_at x 0) "*" && (if str_len x >= 2 && (str_eq (char_at x 1) "*" || str_eq (char_at x 1) ",") then false else true)) || any9 t) in
  if any9 acc then syn_refuse "unexpected multiple `*` splat parameters" else ()
and kwsplat_check = fn (nm: str) -> fn (acc: str list) ->
  let rec any9 = fn (xs: str list) -> fn (kw: bool) ->
    (match xs with
     | Nil -> false
     | Cons (x, t) ->
       (if kw then (str_len x > 1 && str_eq (char_at x (str_len x - 1)) ":" && (if str_eq (char_at x 0) ";" then false else true))
        else (str_len x >= 2 && str_eq (substring x 0 2) "**")) || any9 t kw) in
  if any9 acc false then syn_refuse "unexpected multiple `**` splat parameters"
  else if str_eq nm "**nil" && any9 acc true then syn_refuse "unexpected **nil; no keywords marker disallowed after keywords"
  else ()
and uniq_param = fn (name: str) -> fn (acc: str list) ->
  if str_len name >= 1 && str_eq (char_at name (str_len name - 1)) ":" then
    // ...but a second keyword `_:` is still told apart from the first
    // (`def m(_:, _: 2)` has a required one and an optional one)
    (if str_eq (pbase name) "_" && pcount_kw_base acc "_" > 0 then "_~" ++ str_of_int (pcount_base acc "_") ++ ":" else name)
  else if (if str_eq (pbase name) "_" then true else false) && pcount_base acc "_" > 0 then
    (let u = "_~" ++ str_of_int (pcount_base acc "_") in
     if str_len name >= 2 && str_eq (substring name 0 2) "**" then "**" ++ u
     else if str_len name >= 1 && (str_eq (char_at name 0) "*" || str_eq (char_at name 0) "&") then substring name 0 1 ++ u
     else if str_len name >= 1 && str_eq (char_at name (str_len name - 1)) ":" then u ++ ":"
     else u)
  else name

and parse_params = fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  // a parenthesised parameter list may wrap across lines, so newlines inside
  // it are not statement separators (`def m(a,\n  b: 1)`). The paren-less form
  // below is the opposite: there a newline ends the list.
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (let ps9 = rev_app acc Nil in let _ = param_dup_check ps9 in (ps9, rev_app defs Nil, r))
    else if str_eq p "*" then
      let _ = splat_check acc in
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("*" ++ name) acc) r2 acc defs
       // a bare * gets a hidden name too, so `t(*)` can forward it
       | _ -> parse_params_after "*__anonrest" r acc defs)
    else if str_eq p "&" then
      // &block capture: stored as "&name"; a bare & (anonymous forwarding)
      // gets a hidden name so `c(&)` can re-pass it.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("&" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "&__anonblk" r acc defs)
    else if str_eq p "**" then
      // **kwargs collects the trailing keyword hash. A BARE ** gets a hidden
      // name, the way a bare & does: dsplat_name reads the name to decide
      // whether the method takes keywords AT ALL, and "" is how "no **
      // parameter" is spelled -- so `def m(**)` was told it takes none and the
      // caller's `m(x: 1)` was counted as a positional argument.
      (match r with
       | Cons (TId name, r2) -> (let _ = kwsplat_check ("**" ++ name) acc in parse_params_after (uniq_param ("**" ++ name) acc) r2 acc defs)
       | _ -> (let _ = kwsplat_check "**__anonkw" acc in parse_params_after "**__anonkw" r acc defs))
    else if str_eq p "..." then
      // argument forwarding: `def m(...)` collects positional args in *__fwd
      // and the block in the same anonymous slot `def m(&)` uses, so `m(...)`
      // forwards a block when there is one and stays block-less when there
      // is not (which is what an earlier &__fwdblk attempt got wrong).
      parse_params_after "&__anonblk" r (Cons ("*__fwd", acc)) defs
    else if is_lparen p then
      // nested destructuring `def m((a, b))` — encoded as a spec string,
      // bound the same way as a block's |(a, b)|.
      let (spec, r2) = pipe_group r "" in
      parse_params_after ("(" ++ spec ++ ")") r2 acc defs
    else (let __fm = ("mere-ruby: expected parameter name, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TId name, r) ->
    // optional default `name = expr`; keyword param `name:` / `name: default`
    // (stored as "name:" in the param list, bound from the trailing hash).
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // optional `name = expr`: uniquify a duplicate `_` and key the default
         // under the SAME unique name so it stays associated with this position.
         let un = uniq_param name acc in
         // the default may start on the NEXT line -- addressable writes
         // `def self.normalize_component(component, character_class=\n  CONST,`
         let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs))
       else if str_eq eq ":" then
         let un = uniq_param (name ++ ":") acc in
         (match skip_nls r2 with
          | Cons (TP q, _) -> if str_eq q "," || str_eq q ")" then parse_params_after un r2 acc defs
                              else let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs))
          | _ -> let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs)))
       else parse_params_after (uniq_param name acc) r acc defs
     | _ -> parse_params_after (uniq_param name acc) r acc defs)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected parameter name" ++ parsing_file ()))) in fail ("mere-ruby: expected parameter name" ++ parsing_file ()))

and parse_params_after = fn (name: str) -> fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_params r (Cons (name, acc)) defs
    else if str_eq p ")" then (let ps9 = rev_app (Cons (name, acc)) Nil in let _ = param_dup_check ps9 in (ps9, rev_app defs Nil, r))
    else (let __fm = ("mere-ruby: expected , or ) in parameters, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated parameter list" ++ parsing_file ()))) in fail ("mere-ruby: unterminated parameter list" ++ parsing_file ()))

// paren-less method params: `def m a, o=1, *r, &b` — terminated by newline
// (any non-comma token) rather than `)`.
and parse_bare_params = fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  // (`def foo *args`: the splat is marked as a command's, see cmd_star)
  let toks = (match toks0 with
              | Cons (TP sp9, r9) when str_eq sp9 " *" || str_eq sp9 " **" -> Cons (TP (substring sp9 1 (str_len sp9)), r9)
              | _ -> toks0) in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "*" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("*" ++ n) r2 acc defs
                  | _ -> parse_bare_after "*" r acc defs)
    else if str_eq p "&" || str_eq p " &" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("&" ++ n) r2 acc defs
                  | _ -> parse_bare_after "&" r acc defs)
    else if str_eq p "**" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("**" ++ n) r2 acc defs
                  | _ -> parse_bare_after "**__anonkw" r acc defs)
    else if str_eq p "..." then parse_bare_after "&__anonblk" r (Cons ("*__fwd", acc)) defs
    else (let __fm = ("mere-ruby: expected parameter name, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TId name, r) ->
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let (e, r3) = parse_expr r2 in parse_bare_after name r3 acc (Cons ((name, e), defs))
       // keyword parameter `name:` / `name: default`, encoded exactly as the
       // parenthesised form does ("name:" in the list, default keyed under
       // it). `def initialize class_loader, strict_integer: false` -- psych.
       else if str_eq eq ":" then
         let kn = name ++ ":" in
         (match r2 with
          | Cons (TP q, _) -> if str_eq q "," then parse_bare_after kn r2 acc defs
                              else let (e, r3) = parse_expr r2 in parse_bare_after kn r3 acc (Cons ((kn, e), defs))
          // `def m a, k:` with no default: the list ends at the newline.
          | Cons (TNL _, _) -> parse_bare_after kn r2 acc defs
          | _ -> let (e, r3) = parse_expr r2 in parse_bare_after kn r3 acc (Cons ((kn, e), defs)))
       else parse_bare_after name r acc defs
     | _ -> parse_bare_after name r acc defs)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected parameter name" ++ parsing_file ()))) in fail ("mere-ruby: expected parameter name" ++ parsing_file ()))

and parse_bare_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    // the list may wrap after a comma, as a call's does: debug's session.rb
    // writes `def register_command *names,` and the keywords on the lines below.
    if str_eq p "," then parse_bare_params (skip_nls r) (Cons (name, acc)) defs
    else (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks)
  | _ -> (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks);


// ---- "assigned but unused variable" (-w) ----------------------------------
// ruby's warning for a local that is assigned and never read, given when the
// scope that owns it closes: a def, a class body, a block, a lambda, the file.
// Read is a bare `name` (EVar) -- `name()` is a call -- or the name of an
// ambiguous `name [x]`; an argument or a block parameter never warns, nor does
// a name that starts with `_`. The top level of -e and of an eval'd string,
// and the blocks in it, say nothing (only their defs and class bodies do).
// The walk is over the parsed program, after the parse, under -w only.
let uv_line = map_new ();
let uv_used = map_new ();
let uv_cnt = map_new ();
let uv_name = map_new ();
let uv_ctr = map_new ();
let uv_cur = map_new ();
// an eval's caller's local variables (Kernel#eval fills it while the string
// is checked): a bare name the string reads may be one of them, which ruby's
// void warning calls "a variable" (a method call, it does not warn about)
let vw_outer = map_new ();
let uv_warnable = fn (n: str) ->
  str_len n > 0 && (let o = ord (char_at n 0) in (o >= 97 && o <= 122) || o >= 128);
let rec uv_find = fn (chain: (int * bool * bool) list) -> fn (n: str) ->
  match chain with
  | Nil -> 0 - 1
  | Cons ((sid, hard, _), t) ->
    if map_has uv_line (str_of_int sid ++ ":" ++ n) then sid
    else if hard then 0 - 1
    else uv_find t n;
let uv_def = fn (chain: (int * bool * bool) list) -> fn (n: str) -> fn (used: bool) ->
  if str_len n == 0 || (let o = ord (char_at n 0) in (if (o >= 97 && o <= 122) || o == 95 || o >= 128 then false else true))
     || (str_len n <= 8 && lvt_is_kw n) then ()
  else if uv_find chain n >= 0 then (if used then map_set uv_used (str_of_int (uv_find chain n) ++ ":" ++ n) 1 else ())
  else (match chain with
        | Cons ((sid, _, _), _) ->
          (let k = str_of_int sid ++ ":" ++ n in
           let _ = map_set uv_line k (if map_has uv_cur "l" then map_get uv_cur "l" else 0) in
           let _ = (if used then map_set uv_used k 1 else ()) in
           let c = (if map_has uv_cnt (str_of_int sid) then map_get uv_cnt (str_of_int sid) else 0) in
           let _ = map_set uv_name (str_of_int sid ++ "#" ++ str_of_int c) n in
           map_set uv_cnt (str_of_int sid) (c + 1))
        | Nil -> ());
let uv_use = fn (chain: (int * bool * bool) list) -> fn (n: str) ->
  let sid = uv_find chain n in
  if sid >= 0 then map_set uv_used (str_of_int sid ++ ":" ++ n) 1 else ();
// a parameter spec as the parser writes it (`*a`, `**k`, `&b`, `k:`, `;x`,
// `(a, (b, c))`): every name in it, declared as used
let rec uv_decl_spec = fn (chain: (int * bool * bool) list) -> fn (s: str) -> fn (i: int) -> fn (st: int) ->
  if i >= str_len s then (if i > st then uv_def chain (substring s st i) true else ())
  else (let c = char_at s i in
        if is_alnum c || str_eq c "_" then uv_decl_spec chain s (i + 1) st
        else (let _ = (if i > st then uv_def chain (substring s st i) true else ()) in uv_decl_spec chain s (i + 1) (i + 1)));
let rec uv_decl_params = fn (chain: (int * bool * bool) list) -> fn (ps: str list) ->
  match ps with Nil -> () | Cons (p, t) -> (let _ = uv_decl_spec chain p 0 0 in uv_decl_params chain t);
let uv_open = fn (chain: (int * bool * bool) list) -> fn (hard: bool) -> fn (quiet: bool) ->
  let sid = (if map_has uv_ctr "n" then map_get uv_ctr "n" else 0) + 1 in
  let _ = map_set uv_ctr "n" sid in
  Cons ((sid, hard, quiet), chain);
let uv_close = fn (chain: (int * bool * bool) list) -> fn (file: str) ->
  match chain with
  | Cons ((sid, _, quiet), _) ->
    (let c = (if map_has uv_cnt (str_of_int sid) then map_get uv_cnt (str_of_int sid) else 0) in
     let rec go = fn (i: int) ->
       if i >= c then ()
       else (let n = map_get uv_name (str_of_int sid ++ "#" ++ str_of_int i) in
             let k = str_of_int sid ++ ":" ++ n in
             let _ = (if quiet || map_has uv_used k || (if uv_warnable n then false else true) then ()
                      else warn_note (file ++ ":" ++ str_of_int (map_get uv_line k + lshift_tok ()) ++ ": warning: assigned but unused variable - " ++ n)) in
             go (i + 1)) in
     go 0)
  | Nil -> ();
let rec str_index_of_ch_go = fn (s: str) -> fn (c: str) -> fn (i: int) ->
  if i >= str_len s then 0 - 1 else if str_eq (char_at s i) c then i else str_index_of_ch_go s c (i + 1);
let str_index_of_ch = fn (s: str) -> fn (c: str) -> str_index_of_ch_go s c 0;
// a statement list: walked, and then -- once everything inside it is done,
// as prism checks a list when it closes -- its statements in void context
// warned about (vw_check): all but the last one, which is the list's value
let rec uv_stmts = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ss: Stmt list) ->
  let _ = uv_stmts_go chain file ss in vw_check chain file ss true
// ...and one whose last statement is no value either: the program's own top
// level, an ensure clause
and uv_stmts_void = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ss: Stmt list) ->
  let _ = uv_stmts_go chain file ss in vw_check chain file ss false
and uv_stmts_go = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ss: Stmt list) ->
  match ss with
  | Nil -> ()
  | Cons (s, t) -> (let _ = uv_stmt chain file s in uv_stmts_go chain file t)
// ruby's "possibly useless use of X in void context" (-w): a statement that
// only computes a value, where the value goes nowhere
and vw_check = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ss: Stmt list) -> fn (lastv: bool) ->
  let rec real9 = fn (xs: Stmt list) -> (match xs with Nil -> 0 | Cons (SLine _, t) -> real9 t | Cons (SFile _, t) -> real9 t | Cons (_, t) -> 1 + real9 t) in
  let n9 = real9 ss in
  let rec go = fn (xs: Stmt list) -> fn (ln: int) -> fn (i: int) ->
    (match xs with
     | Nil -> ()
     | Cons (SLine n, t) -> go t (if n < 0 then ln else n) i
     | Cons (SFile _, t) -> go t ln i
     | Cons (st, t) ->
       (let _ = (if lastv && i == n9 - 1 then ()
                 else (match st with
                       | SExpr e ->
                         (let w = vw_msg chain e in
                          if str_eq w "" then ()
                          else warn_note (file ++ ":" ++ str_of_int (ln + lshift_tok ()) ++ ": warning: possibly useless use of " ++ w ++ " in void context"))
                       | _ -> ())) in
        go t ln (i + 1))) in
  go ss (if map_has uv_cur "l" then map_get uv_cur "l" else 0) 0
and vw_msg = fn (chain: (int * bool * bool) list) -> fn (e: Expr) ->
  match e with
  | EInt _ -> "a literal" | EBig _ -> "a literal" | EFlt _ -> "a literal" | ERat (_, _) -> "a literal"
  | EImag _ -> "a literal" | EImagF _ -> "a literal" | EImagRat (_, _) -> "a literal"
  | EStrL _ -> "a literal" | ESym _ -> "a literal" | ERegex (_, _) -> "a literal"
  | ENil -> "nil" | ESelf -> "self"
  | EBool b -> (if b then "true" else "false")
  | EIVar _ -> "a variable"
  | EVar n ->
    (if str_len n >= 8 && (str_eq (substring n 0 8) "__FILE__" || str_eq (substring n 0 8) "__LINE__") then "a literal"
     else if str_len n > 0 && str_eq (char_at n 0) "$" then "a variable"
     else if str_len n > 1 && str_eq (substring n 0 2) "@@" then "a variable"
     else if uv_find chain n >= 0 || map_has vw_outer n then "a variable"
     // (a numbered parameter is one; `it` is not, for ruby)
     else if str_len n == 2 && str_eq (char_at n 0) "_" && is_digit (char_at n 1) && (if str_eq (char_at n 1) "0" then false else true) then "a variable"
     else "")
  | EConst c -> (if str_index_of_ch c ":" >= 0 then "::" else "a constant")
  | EScopedRead (_, _) -> "::"
  | ERange (_, _, x) -> (if x then "..." else "..")
  | EDefined _ -> "defined?"
  | EUn (op, _) -> (if str_eq op "-" then "-@" else if str_eq op "+" then "+@" else "")
  | EBin (op, _, _) ->
    (if scv_dstr e then "a literal"
     else if str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/" || str_eq op "%" || str_eq op "|"
             || str_eq op "^" || str_eq op "&" || str_eq op ">" || str_eq op "<" || str_eq op "<=" || str_eq op ">="
             || str_eq op "!=" || str_eq op "==" || str_eq op "**" || str_eq op "<=>" then op
     else "")
  | EMethod (x, m, _) ->
    (if str_eq m "__interp_str" || str_eq m "__regex" then "a literal"
     else if str_len m > 6 && str_eq (substring m 0 6) "__lit_" then vw_msg chain x
     else "")
  | _ -> ""
and uv_body = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (hard: bool) -> fn (ps: str list) -> fn (ss: Stmt list) ->
  // (a `for` is a block over `__fN` whose variables are the enclosing
  //  scope's: `for a, b in xs; end; a` reads them)
  if (match ps with Nil -> false | _ -> uv_for_params ps) then uv_stmts chain file ss
  else
  let l0 = (if map_has uv_cur "l" then map_get uv_cur "l" else 0) in
  let quiet = (if hard then false else (match chain with Cons ((_, _, q), _) -> q | Nil -> false)) in
  let ch = uv_open chain hard quiet in
  let _ = uv_decl_params ch ps in
  let _ = uv_stmts ch file ss in
  let _ = uv_close ch file in
  map_set uv_cur "l" l0
and uv_stmt = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (s: Stmt) ->
  match s with
  | SLine n -> (if n < 0 then () else map_set uv_cur "l" n)
  | SExpr e -> uv_expr chain file e
  | SPuts es -> uv_exprs chain file es
  // (the name is the variable's before its value is read: `a ||= 1` is
  //  `a = a || 1`, and reads a)
  | SAssign (n, e) -> (let _ = uv_def chain n false in uv_expr chain file e)
  // (`a = a = 1` reads nothing, and ruby says nothing)
  | SLocalFrom (n, s2) ->
    (let used = (match s2 with SAssign (n2, _) -> str_eq n2 n | SLocalFrom (n2, _) -> str_eq n2 n | _ -> false) in
     let _ = uv_def chain n used in uv_stmt_val chain file s2)
  | SIVarAssign (_, e) -> uv_expr chain file e
  | SIf (cls, els) ->
    (let rec cl9 = fn (xs: (Expr * Stmt list) list) ->
       (match xs with Nil -> uv_stmts chain file els | Cons ((c, b), t) -> (let _ = uv_cond chain file c in let _ = uv_stmts chain file b in cl9 t)) in
     cl9 cls)
  // (the condition is read again after the body: `x = f until x == y`)
  | SWhile (c, b) -> (let _ = uv_cond chain file c in let _ = uv_stmts chain file b in uv_cond chain file c)
  | SDoWhile (b, c) -> (let _ = uv_stmt chain file b in uv_expr chain file c)
  | SCase (e, ws, els) ->
    (let _ = uv_expr chain file e in
     let rec w9 = fn (xs: (Expr list * Stmt list) list) ->
       (match xs with Nil -> uv_stmts chain file els | Cons ((cs, b), t) -> (let _ = uv_exprs chain file cs in let _ = uv_stmts chain file b in w9 t)) in
     w9 ws)
  | SCaseIn (e, cls, _, els) ->
    (let _ = uv_expr chain file e in
     let rec c9 = fn (xs: (Pat * Expr * Stmt list) list) ->
       (match xs with Nil -> uv_stmts chain file els | Cons ((p, g, b), t) -> (let _ = uv_pat chain file p in let _ = uv_expr chain file g in let _ = uv_stmts chain file b in c9 t)) in
     c9 cls)
  | SDef (dn, ps, ds, b) ->
    (let l0 = (if map_has uv_cur "l" then map_get uv_cur "l" else 0) in
     // (`def a.foo`: the receiver is read)
     let _ = (let h9 = str_index_of_ch dn "#" in if h9 > 0 then uv_use chain (substring dn 0 h9) else ()) in
     let ch = uv_open chain true false in
     let _ = uv_decl_params ch ps in
     let rec d9 = fn (xs: (str * Expr) list) -> (match xs with Nil -> () | Cons ((_, e), t) -> (let _ = uv_expr ch file e in d9 t)) in
     let _ = d9 ds in
     let _ = uv_stmts ch file b in
     let _ = uv_close ch file in
     map_set uv_cur "l" l0)
  | SReturn e -> uv_expr chain file e
  | SBreak e -> uv_expr chain file e
  | SNext e -> uv_expr chain file e
  // (`class mod::C < parent`: a local in the path or as the superclass)
  | SClass (cn, sup, b) ->
    (let h9 = str_index_of_ch cn ":" in
     let _ = (if h9 > 0 then uv_use chain (substring cn 0 h9) else ()) in
     let _ = uv_use chain sup in
     uv_body chain file true Nil b)
  | SClassE (cn, e, b) ->
    (let h9 = str_index_of_ch cn ":" in
     let _ = (if h9 > 0 then uv_use chain (substring cn 0 h9) else ()) in
     let _ = uv_expr chain file e in uv_body chain file true Nil b)
  | SSingletonE (e, b) -> (let _ = uv_expr chain file e in uv_body chain file true Nil b)
  | SBegin (b, rs, els, ens) ->
    (let _ = uv_stmts chain file b in
     let rec r9 = fn (xs: (str list * str * Stmt list) list) ->
       (match xs with
        | Nil -> ()
        | Cons ((cs, v, rb), t) ->
          (let _ = uv_rescue_classes chain file cs in
           // (named at the `rescue` line: the one before its body's first)
           let _ = (match uv_first_line rb with n9 when n9 > 1 -> map_set uv_cur "l" (n9 - 1) | _ -> ()) in
           let _ = uv_def chain v false in let _ = uv_stmts chain file rb in r9 t)) in
     let _ = r9 rs in
     let _ = uv_stmts chain file els in
     uv_stmts_void chain file ens)
  | SPreexe b -> uv_stmts chain file b
  | SAtExit (_, b) -> uv_body chain file false Nil b
  // (the targets are the variables before the values are read, as ruby
  //  reads left to right: `e, pid = IO.pipe do pid = fork ... end`)
  | SMultiAssign (ns, es) ->
    (let rec n9 = fn (xs: str list) -> (match xs with Nil -> () | Cons (x, t) -> (let _ = uv_def chain (if str_len x > 0 && str_eq (char_at x 0) "*" then substring x 1 (str_len x) else x) false in n9 t)) in
     let _ = n9 ns in
     uv_exprs chain file es)
  | SMultiAssignX (ts, es) -> (let _ = uv_targets chain file ts in uv_exprs chain file es)
  | SRequire (_, e) -> uv_expr chain file e
  | SAndThen (a, b) -> (let _ = uv_stmt_val chain file a in uv_stmt chain file b)
  | SOrElse (a, b) -> (let _ = uv_stmt_val chain file a in uv_stmt chain file b)
  // (`include m` names a local module as a string)
  | SInclude (n, _) -> uv_use chain n
  | _ -> ()
// a statement whose value is taken (`a = b = 1`, `x = 1 or flunk`, `(y = v)`):
// the variable it assigns is used
and uv_stmt_val = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (s: Stmt) ->
  match s with
  | SAssign (n, e) -> (let _ = uv_def chain n true in uv_expr chain file e)
  | SLocalFrom (n, s2) -> (let _ = uv_def chain n true in uv_stmt_val chain file s2)
  // (`begin ... rescue v = 3 end.should`: each clause's last statement is
  //  the value)
  | SBegin (b, rs, els, ens) ->
    (let _ = uv_stmts_val chain file b in
     let rec r9 = fn (xs: (str list * str * Stmt list) list) ->
       (match xs with
        | Nil -> ()
        | Cons ((cs, v, rb), t) -> (let _ = uv_rescue_classes chain file cs in let _ = uv_def chain v false in let _ = uv_stmts_val chain file rb in r9 t)) in
     let _ = r9 rs in
     let _ = uv_stmts_val chain file els in
     uv_stmts_void chain file ens)
  | _ -> uv_stmt chain file s
and uv_stmts_val = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ss: Stmt list) ->
  let _ = uv_stmts_val_go chain file ss in vw_check chain file ss true
and uv_stmts_val_go = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ss: Stmt list) ->
  match ss with
  | Nil -> ()
  | Cons (s, Nil) -> uv_stmt_val chain file s
  | Cons (s, t) -> (let _ = uv_stmt chain file s in uv_stmts_val_go chain file t)
and uv_first_line = fn (ss: Stmt list) ->
  match ss with Nil -> 0 | Cons (SLine n, t) -> (if n < 0 then uv_first_line t else n) | Cons (SFile _, t) -> uv_first_line t | Cons (_, t) -> 0
// the parameters the parser gives a `for` loop's block (`__for`, `__forv`,
// `__f0`, `*__f1` ...), and nothing else
and uv_for_params = fn (ps: str list) ->
  match ps with
  | Nil -> true
  | Cons (p9, t) ->
    (let q9 = (if str_len p9 > 0 && str_eq (char_at p9 0) "*" then substring p9 1 (str_len p9) else p9) in
     str_len q9 >= 3 && str_eq (substring q9 0 3) "__f" && uv_for_params t)
// a rescue clause's classes: a runtime expression is registered (resc_reg)
// and named by its sentinel, `*` in front for a splat
and uv_rescue_classes = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (cs: str list) ->
  match cs with
  | Nil -> ()
  | Cons (c0, t) ->
    (let c = (if str_len c0 > 0 && str_eq (char_at c0 0) "*" then substring c0 1 (str_len c0) else c0) in
     let _ = (if str_len c > 7 && str_eq (substring c 0 7) "@rexpr~" then
                (let k = substring c 7 (str_len c) in if map_has resc_exprs k then uv_expr chain file (map_get resc_exprs k) else ())
              else uv_use chain c) in
     uv_rescue_classes chain file t)
and uv_targets = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ts: Expr list) ->
  match ts with
  | Nil -> ()
  | Cons (t, r) ->
    (let _ = (match t with
              | EVar n -> uv_def chain n false
              | ESplat (EVar n) -> uv_def chain n false
              | EArr xs -> uv_targets chain file xs
              | ESplat (EArr xs) -> uv_targets chain file xs
              | e -> uv_expr chain file e) in
     uv_targets chain file r)
// a condition's value is read: `if x = true` uses x (ruby says only that the
// `=` is likely a `==`)
and uv_cond = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (c: Expr) ->
  match c with
  | EAssign (n, v) -> (let _ = uv_def chain n true in uv_expr chain file v)
  | EUn (op, a) when str_eq op "!" -> uv_cond chain file a
  | _ -> uv_expr chain file c
and uv_exprs = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (es: Expr list) ->
  match es with Nil -> () | Cons (e, t) -> (let _ = uv_expr chain file e in uv_exprs chain file t)
and uv_expr = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (e: Expr) ->
  match e with
  | EVar n -> uv_use chain n
  // (an assignment written where its value is taken -- an argument, a
  //  condition, `(x = v).m` -- counts as using it, as ruby counts it)
  | EAssign (n, v) -> (let _ = uv_def chain n true in uv_expr chain file v)
  | EArr es -> uv_exprs chain file es
  | EHsh es -> uv_exprs chain file es
  | EKwHash es -> uv_exprs chain file es
  | EBin (_, a, b) -> (let _ = uv_expr chain file a in uv_expr chain file b)
  | EUn (_, a) -> uv_expr chain file a
  | ECall (_, args) -> uv_exprs chain file args
  | EMethod (r, _, args) -> (let _ = uv_expr chain file r in uv_exprs chain file args)
  | ESafe (r, _, args) -> (let _ = uv_expr chain file r in uv_exprs chain file args)
  | EScopedAssign (r, _, v) -> (let _ = uv_expr chain file r in uv_expr chain file v)
  | EScopedRead (r, _) -> uv_expr chain file r
  | EScopedReadOrNil (r, _) -> uv_expr chain file r
  | EAttrOp (r, _, _, v) -> (let _ = uv_expr chain file r in uv_expr chain file v)
  | EIdxOp (r, args, _, v) -> (let _ = uv_expr chain file r in let _ = uv_exprs chain file args in uv_expr chain file v)
  | ERange (a, b, _) -> (let _ = uv_expr chain file a in uv_expr chain file b)
  | EAmbigIdx (n, args) -> (let _ = uv_use chain n in uv_exprs chain file args)
  | EAmbigIdxC (n, a, b) -> (let _ = uv_use chain n in let _ = uv_expr chain file a in uv_expr chain file b)
  | EFlipFlop (_, a, b, _) -> (let _ = uv_expr chain file a in uv_expr chain file b)
  | EYield es -> uv_exprs chain file es
  | ECallB (_, args, bp, bb) -> (let _ = uv_exprs chain file args in uv_body chain file false bp bb)
  | EMethodB (r, _, args, bp, bb) -> (let _ = uv_expr chain file r in let _ = uv_exprs chain file args in uv_body chain file false bp bb)
  | ESafeB (r, _, args, bp, bb) -> (let _ = uv_expr chain file r in let _ = uv_exprs chain file args in uv_body chain file false bp bb)
  | ESuperB (_, args, bp, bb) -> (let _ = uv_exprs chain file args in uv_body chain file false bp bb)
  | ELambda (ps, bb) -> uv_body chain file false ps bb
  | ERaise es -> uv_exprs chain file es
  | ESplat a -> uv_expr chain file a
  | EKwSplat a -> uv_expr chain file a
  | EBlockPass a -> uv_expr chain file a
  | ETern (a, b, c) -> (let _ = uv_cond chain file a in let _ = uv_expr chain file b in uv_expr chain file c)
  | EDefined a -> uv_expr chain file a
  | ESuper (_, es) -> uv_exprs chain file es
  | EStmt st -> uv_stmt_val chain file st
  | EFlow (_, a) -> uv_expr chain file a
  | EMatchTest (a, p) -> (let _ = uv_expr chain file a in uv_pat chain file p)
  | EMatchBind (a, p) -> (let _ = uv_expr chain file a in uv_pat chain file p)
  | _ -> ()
and uv_pat = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (p: Pat) ->
  match p with
  // (ruby says nothing of a pattern's variables)
  | PVar n -> uv_def chain n true
  | PVal e -> uv_expr chain file e
  | PPin e -> uv_expr chain file e
  | PSplatP n -> uv_def chain n true
  | PArrP ps -> uv_pats chain file ps
  | PHashP (kvs, rest) ->
    (let rec k9 = fn (xs: (str * Pat) list) -> (match xs with Nil -> () | Cons ((_, q), t) -> (let _ = uv_pat chain file q in k9 t)) in
     let _ = k9 kvs in
     if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then () else uv_def chain rest true)
  | PAltP ps -> uv_pats chain file ps
  | PAsP (q, n) -> (let _ = uv_pat chain file q in uv_def chain n true)
  | PConstP (e, q) -> (let _ = uv_expr chain file e in uv_pat chain file q)
and uv_pats = fn (chain: (int * bool * bool) list) -> fn (file: str) -> fn (ps: Pat list) ->
  match ps with Nil -> () | Cons (p, t) -> (let _ = uv_pat chain file p in uv_pats chain file t);
// the whole program's walk, after its parse: quiet_top for -e and an eval
let uv_program = fn (prog: Stmt list) -> fn (file: str) -> fn (quiet_top: bool) ->
  if parse_verbose () then
    (let _ = map_clear uv_line in let _ = map_clear uv_used in let _ = map_clear uv_cnt in let _ = map_clear uv_name in
     let _ = map_set uv_cur "l" 0 in
     let ch = uv_open Nil true quiet_top in
     let _ = uv_stmts_void ch file prog in
     uv_close ch file)
  else ();
// ...an eval's string, whose last statement is the eval's value
let uv_program_eval = fn (prog: Stmt list) -> fn (file: str) ->
  if parse_verbose () then
    (let _ = map_clear uv_line in let _ = map_clear uv_used in let _ = map_clear uv_cnt in let _ = map_clear uv_name in
     let _ = map_set uv_cur "l" 0 in
     let ch = uv_open Nil true true in
     let _ = uv_stmts ch file prog in
     uv_close ch file)
  else ();
