       let _ = (if j - i - 1 > 10 || (j - i - 1 == 10 && int_of_str (substring s (i + 1) j) > 1073741823) then
                  (let rec nls = fn (k: int) -> fn (n: int) -> (if k >= i then n else nls (k + 1) (if str_eq (char_at s k) "\n" then n + 1 else n)) in
                   warn_note (parse_time_file () ++ ":" ++ str_of_int (nls 0 1) ++ ": warning: '" ++ substring s i j
