      // :'quoted symbol' -- unless the colon closes a label, in which case
      // `{x:'true'}` is the key x and the STRING 'true'.
      let (lit, j) = lex_sq s (i + 2) "" in
      Cons (TSym (sym_note lit), lex_go s j)
    else if str_eq c ":" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "@" && str_eq (char_at s (i + 2)) "@" then
      let j = scan_ident s (i + 3) in
