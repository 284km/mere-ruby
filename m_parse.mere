// The front end: the lexer (including string interpolation and the numeric
// literal grammars), the question of what encoding a regexp pattern is in,
// the precedence-climbing expression parser, the statement parser that
// shares its mutual recursion, and the static checks the parser makes on
// patterns.
//
// A MODULE, spliced by `import` where these chains used to sit. `import` is
// an AST splice, not a separate scope: this file sees everything declared
// above the import point and nothing below it, which is exactly what these
// chains had. Nothing here is in the evaluator's mutual-recursion group,
// which is why it can be a file at all -- see STRUCTURE.md.
// ---- lexer ---------------------------------------------------------------
let rec scan_digits = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_digit (char_at s i) then scan_digits s (i + 1) else i;


let rec skip_comment = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else skip_comment s (i + 1);

// ---- the shareable_constant_value magic comment ---------------------------
// It is read where it stands, not only at the top: each comment-only line that
// names it switches what a constant assignment after it does, until the next
// such line or the end of the class body (see scv_wrap). The lexer hands the
// switch to the parser as a `__scv~MODE` token, which parse_stmts consumes.
let scv_mode = map_new ();
let rec scv_norm = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else (let c = char_at s i in
        let o = ord c in
        scv_norm s (i + 1) (acc ++ (if str_eq c "-" then "_" else if o >= 65 && o <= 90 then chr (o + 32) else c)));
let rec scv_find = fn (s: str) -> fn (sub: str) -> fn (i: int) ->
  if i + str_len sub > str_len s then 0 - 1
  else if str_eq (substring s i (i + str_len sub)) sub then i
  else scv_find s sub (i + 1);
let rec scv_sp = fn (s: str) -> fn (i: int) -> fn (e: int) ->
  if i < e && (str_eq (char_at s i) " " || str_eq (char_at s i) "\t") then scv_sp s (i + 1) e else i;
let rec scv_word_end = fn (s: str) -> fn (i: int) -> fn (e: int) ->
  if i < e && (let c = char_at s i in (if str_eq c " " || str_eq c "\t" || str_eq c ";" || str_eq c "\r" then false else true)) then scv_word_end s (i + 1) e else i;
// the value a comment s[i, e) gives shareable_constant_value ("" for none)
let scv_value = fn (s: str) -> fn (i: int) -> fn (e: int) ->
  let ln = scv_norm (substring s i e) 0 "" in
  let k = scv_find ln "shareable_constant_value" 0 in
  if k < 0 then ""
  else (let j = scv_sp ln (k + 24) (str_len ln) in
        if j >= str_len ln || (if str_eq (char_at ln j) ":" then false else true) then ""
        else (let a = scv_sp ln (j + 1) (str_len ln) in
              let b = scv_word_end ln a (str_len ln) in
              // (the original spelling, for the warning)
              substring s (i + a) (i + b)));
// is the `#` at i the first thing on its line?
// `# frozen_string_literal: true` (any case, `-` or `_`), as a comment says it
let fsl_comment_text = fn (t: str) ->
  let n = str_len t in
  let rec sp = fn (k: int) -> (if k < n && (str_eq (char_at t k) " " || str_eq (char_at t k) "\t") then sp (k + 1) else k) in
  let k = sp 1 in
  let w = "frozen_string_literal" in
  if k + str_len w > n then false
  else
    (let rec same = fn (j: int) ->
       (if j >= str_len w then true
        else (let a = char_at t (k + j) in
              let b = char_at w j in
              (str_eq a b || (str_eq b "_" && str_eq a "-") || (ord a >= 65 && ord a <= 90 && ord a + 32 == ord b)) && same (j + 1))) in
     same 0 && (let k2 = sp (k + str_len w) in k2 < n && str_eq (char_at t k2) ":"));
// is there code (not blank lines, comments or a shebang) before byte i?
let code_before = fn (s: str) -> fn (i: int) ->
  let rec line = fn (k: int) ->
    (if k >= i then false
     else (let rec eol = fn (j: int) -> (if j < i && (if str_eq (char_at s j) "\n" then false else true) then eol (j + 1) else j) in
           let e = eol k in
           let rec fst = fn (j: int) -> (if j < e && (str_eq (char_at s j) " " || str_eq (char_at s j) "\t" || str_eq (char_at s j) "\r") then fst (j + 1) else j) in
           let f = fst k in
           if f >= e || str_eq (char_at s f) "#" then line (e + 1) else true)) in
  line 0;
let rec scv_comment_only = fn (s: str) -> fn (i: int) ->
  if i <= 0 then true
  else (let c = char_at s (i - 1) in
        if str_eq c "\n" then true
        else if str_eq c " " || str_eq c "\t" then scv_comment_only s (i - 1)
        else false);
let scv_known = fn (v: str) ->
  str_eq v "none" || str_eq v "literal" || str_eq v "experimental_everything" || str_eq v "experimental_copy";

// ---- numeric literals (M7): 0x/0o/0b bases + `_` separators ---------------
let digit_val = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87        // a-f
  else if o >= 65 && o <= 70 then o - 55         // A-F
  else 0 - 1;
let is_base_digit = fn (c: str) -> fn (base: int) ->
  let v = digit_val c in v >= 0 && v < base;
// String#hex / #oct lenient parse: skip leading whitespace, optional sign,
// optional radix prefix, then base digits (`_` allowed between) until an
// invalid char. `defbase` is the base when no prefix; hex only recognizes
// 0x, oct recognizes 0x/0b/0o/0d/0. Returns 0 on no digits.
let rec radix_ws = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) " " || str_eq (char_at s i) "\t" || str_eq (char_at s i) "\n") then radix_ws s (i + 1) else i;
let rec radix_digits = fn (s: str) -> fn (i: int) -> fn (base: int) -> fn (acc: int) -> fn (started: bool) ->
  if i >= str_len s then acc
  // a single `_` is allowed only BETWEEN two digits: a digit must precede
  // (started) and a base digit must follow (so leading/trailing/doubled stop).
  else if str_eq (char_at s i) "_" then
    (if started && i + 1 < str_len s && is_base_digit (char_at s (i + 1)) base then radix_digits s (i + 1) base acc started else acc)
  else if is_base_digit (char_at s i) base then radix_digits s (i + 1) base (acc * base + digit_val (char_at s i)) true
  else acc;
let radix_parse = fn (s0: str) -> fn (defbase: int) -> fn (allow_all: bool) ->
  let i0 = radix_ws s0 0 in
  let (neg, i1) = (if i0 < str_len s0 && str_eq (char_at s0 i0) "-" then (true, i0 + 1)
                   else if i0 < str_len s0 && str_eq (char_at s0 i0) "+" then (false, i0 + 1)
                   else (false, i0)) in
  // radix prefix (0x/0b/0o/0d); hex takes only 0x.
  let (base, i2) =
    (if i1 + 1 < str_len s0 && str_eq (char_at s0 i1) "0" then
       let c1 = char_at s0 (i1 + 1) in
       if (str_eq c1 "x" || str_eq c1 "X") && (defbase == 16 || allow_all) then (16, i1 + 2)
       else if (str_eq c1 "b" || str_eq c1 "B") && allow_all then (2, i1 + 2)
       else if (str_eq c1 "o" || str_eq c1 "O") && allow_all then (8, i1 + 2)
       else if (str_eq c1 "d" || str_eq c1 "D") && allow_all then (10, i1 + 2)
       else (defbase, i1)
     else (defbase, i1)) in
  let v = radix_digits s0 i2 base 0 false in
  if neg then 0 - v else v;
// scan digits of a base, allowing `_` between them.
let rec scan_base = fn (s: str) -> fn (i: int) -> fn (base: int) ->
  if i < str_len s && (is_base_digit (char_at s i) base || str_eq (char_at s i) "_")
  then scan_base s (i + 1) base else i;
// parse [i, end) as a base-N integer, skipping `_`.
let rec parse_base = fn (s: str) -> fn (i: int) -> fn (endp: int) -> fn (base: int) -> fn (acc: int) ->
  if i >= endp then acc
  else
    let c = char_at s i in
    if str_eq c "_" then parse_base s (i + 1) endp base acc
    else parse_base s (i + 1) endp base (acc * base + digit_val c);
let rec strip_us = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else let c = char_at s i in strip_us s (i + 1) (if str_eq c "_" then acc else acc ++ c);
// A radix literal can exceed int64 -- `0xff00_fabcafe0_00ff` is just under
// 2^64 -- and the token for a value that big is a DECIMAL string. Multiplying
// a decimal string by the base and adding one digit is the whole of it, and
// doing it here keeps the lexer independent of the bignum layer, which is
// defined thousands of lines further down.
let rec dec_mul_add_go = fn (ds: str) -> fn (i: int) -> fn (m: int) -> fn (carry: int) -> fn (acc: str) ->
  if i < 0 then (if carry == 0 then acc else str_of_int carry ++ acc)
  else
    let p = (ord (char_at ds i) - 48) * m + carry in
    dec_mul_add_go ds (i - 1) m (p / 10) (chr (48 + p - (p / 10) * 10) ++ acc);
let dec_mul_add = fn (ds: str) -> fn (m: int) -> fn (add: int) ->
  dec_mul_add_go ds (str_len ds - 1) m add "";
let rec dec_of_base = fn (s: str) -> fn (i: int) -> fn (endp: int) -> fn (base: int) -> fn (acc: str) ->
  if i >= endp then acc
  else
    let c = char_at s i in
    if str_eq c "_" then dec_of_base s (i + 1) endp base acc
    else dec_of_base s (i + 1) endp base (dec_mul_add acc base (digit_val c));
// int64 or not: the decimal form settles it, and only that decides which
// token the literal becomes.
let dec_fits_int = fn (ds: str) ->
  str_len ds < 19 || (str_len ds == 19 && str_compare ds "9223372036854775807" <= 0);

// ---- string interpolation helpers (M11) ---------------------------------
let rec tapp = fn (a: Tok list) -> fn (b: Tok list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, tapp t b);
let rec drop_eof = fn (ts: Tok list) ->
  match ts with Nil -> Nil | Cons (TEOF, _) -> Nil | Cons (h, t) -> Cons (h, drop_eof t);
// find the `}` matching a `#{` (i points just after `#{`), counting nesting.
let rec find_close_brace = fn (s: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len s then i
  else
    let c = char_at s i in
    if str_eq c "\{" then find_close_brace s (i + 1) (depth + 1)
    else if str_eq c "}" then (if depth == 0 then i else find_close_brace s (i + 1) (depth - 1))
    // a quoted string in the code is passed over whole: CRuby's tests open
    // with `"#{<<~"{#"}\n#{<<~'};'}"`, braces inside the heredocs' ids. Not
    // after `$` or `?` (`$'`, `?"` are a global and a character).
    else if (str_eq c "\"" || str_eq c "'")
            && (i == 0 || (let pc = char_at s (i - 1) in
                           if str_eq pc "$" || str_eq pc "?" || str_eq pc "\\" then false else true)) then
      find_close_brace s (fcb_quote_end s (i + 1) c) depth
    else find_close_brace s (i + 1) depth
// the index after the quote that closes a string opened by `q`; a
// double-quoted one's own interpolations are passed over the same way
and fcb_quote_end = fn (s: str) -> fn (j: int) -> fn (q: str) ->
  if j >= str_len s then j
  else
    let c = char_at s j in
    if str_eq c "\\" then fcb_quote_end s (j + 2) q
    else if str_eq c q then j + 1
    else if str_eq q "\"" && str_eq c "#" && j + 1 < str_len s && str_eq (char_at s (j + 1)) "\{" then
      fcb_quote_end s (find_close_brace s (j + 2) 0 + 1) q
    else fcb_quote_end s (j + 1) q;

// double-quoted string body: \n \t \\ \" \' decode; an unknown escape
// drops the backslash (Ruby: "\q" == "q"). Returns (decoded, index after
// the closing quote).
let rec lex_dq = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = syn_why_note "unterminated string meets end of file" in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ())))
  else
    let c = char_at s i in
    if str_eq c "\"" then (acc, i + 1)
    else if str_eq c "\\" then
      (if i + 1 >= str_len s then (let _ = syn_why_note "unterminated string meets end of file" in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ())))
       else
         let e = char_at s (i + 1) in
         let piece =
           if str_eq e "n" then "\n"
           else if str_eq e "t" then "\t"
           else e in
         lex_dq s (i + 2) (acc ++ piece))
    else lex_dq s (i + 1) (acc ++ c);

// single-quoted string body: only \' and \\ are escapes; anything else
// after a backslash keeps the backslash (Ruby semantics).
let rec lex_sq = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = syn_why_note "unterminated string meets end of file" in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ())))
  else
    let c = char_at s i in
    if str_eq c "'" then (acc, i + 1)
    else if str_eq c "\\" && i + 1 < str_len s then
      let e = char_at s (i + 1) in
      if str_eq e "'" || str_eq e "\\" then lex_sq s (i + 2) (acc ++ e)
      else lex_sq s (i + 1) (acc ++ c)
    else lex_sq s (i + 1) (acc ++ c);

let is_punct2 = fn (p: str) ->
  str_eq p "**" || str_eq p "==" || str_eq p "!=" || str_eq p "<=" ||
  str_eq p ">=" || str_eq p "&&" || str_eq p "||" || str_eq p "=>" ||
  str_eq p ".." || str_eq p "<<" || str_eq p ">>" || str_eq p "::" || str_eq p "->" ||
  str_eq p "=~" || str_eq p "!~" || str_eq p "&." ||
  str_eq p "+=" || str_eq p "-=" || str_eq p "*=" || str_eq p "/=" || str_eq p "%=" ||
  str_eq p "|=" || str_eq p "&=" || str_eq p "^=";

let is_punct1 = fn (c: str) ->
  str_eq c "+" || str_eq c "-" || str_eq c "*" || str_eq c "/" ||
  str_eq c "%" || str_eq c "<" || str_eq c ">" || str_eq c "!" ||
  str_eq c "(" || str_eq c ")" || str_eq c "[" || str_eq c "]" ||
  str_eq c "\{" || str_eq c "}" || str_eq c "," || str_eq c "=" ||
  str_eq c "." || str_eq c "|" || str_eq c "&" ||
  str_eq c "?" || str_eq c ":" || str_eq c "~" || str_eq c "^";

// a `.` and a digit at j: a fraction part
let num_frac_after = fn (s: str) -> fn (j: int) ->
  j + 1 < str_len s && str_eq (char_at s j) "." && is_digit (char_at s (j + 1));
// "1" followed by n zeros — denominator for a decimal-fraction Rational literal.
let rec pow10_str = fn (n: int) -> if n <= 0 then "1" else pow10_str (n - 1) ++ "0";

// Can the `:` at `i` open a SYMBOL? Not when it is glued to the end of a
// name -- `{a:1}` and `f(red:nil)` are labels -- and that is true whatever
// follows the colon, a bare name or a quote (`{x:'true'}`).
let colon_opens_sym = fn (s: str) -> fn (i: int) ->
  if i > 0 then
    (let pc = char_at s (i - 1) in
     // `?` and `!` end a method NAME (`empty?:`), but standing alone they are
     // operators -- `!:sym` is a negated symbol.
     if str_eq pc "?" || str_eq pc "!" then
       (if i > 1 then (let pc2 = char_at s (i - 2) in
                       if is_alnum pc2 || str_eq pc2 "_" then false else true)
        else true)
     else if is_alnum pc || str_eq pc "_" then false else true)
  else true;

// ...but a name at the HEAD OF A COMMAND reads `name:sym` as `name :sym`:
// prism has a label only where a hash key can stand (an argument, an
// element, a hash), so `begin not_label:foo end` calls not_label with :foo.
// The head of a command is the start of a statement -- the start, `;`, a
// newline that does not continue the line, `#{`, a block's `{` -- or what
// follows an assignment's `=`, a keyword that takes a statement or a value,
// `class <<` and `class X <`. Anywhere else the colon stays a label's.
let rec lx_back_ws = fn (s: str) -> fn (k: int) ->
  if k >= 0 && (str_eq (char_at s k) " " || str_eq (char_at s k) "\t") then lx_back_ws s (k - 1) else k;
let rec lx_back_wsnl = fn (s: str) -> fn (k: int) ->
  if k >= 0 && (let c = char_at s k in str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r") then lx_back_wsnl s (k - 1) else k;
let rec lx_back_word = fn (s: str) -> fn (k: int) ->
  if k >= 0 && is_alnum (char_at s k) then lx_back_word s (k - 1) else k;
// the word that ends at k (k on its last character)
let lx_word_at = fn (s: str) -> fn (k: int) ->
  if k >= 0 && is_alnum (char_at s k) then substring s (lx_back_word s k + 1) (k + 1) else "";
let lx_cmd_kw = fn (w: str) ->
  str_eq w "then" || str_eq w "else" || str_eq w "begin" || str_eq w "ensure" || str_eq w "do"
  || str_eq w "if" || str_eq w "unless" || str_eq w "while" || str_eq w "until"
  || str_eq w "and" || str_eq w "or" || str_eq w "elsif" || str_eq w "return";
// does the `{` at k open a block (glued to the end of a call) rather than a hash?
let lx_block_brace = fn (s: str) -> fn (k: int) ->
  let k2 = lx_back_ws s (k - 1) in
  if k2 < 0 then false
  else (let c = char_at s k2 in
        (is_alnum c && (let w = lx_word_at s k2 in
                        if lx_cmd_kw w || str_eq w "in" || str_eq w "when" || str_eq w "case" || str_eq w "not" then false else true))
        || str_eq c ")" || str_eq c "]" || str_eq c "?" || str_eq c "!"
        || (str_eq c ">" && k2 > 0 && str_eq (char_at s (k2 - 1)) "-"));
// `class X <`: the `<` at k follows a constant path that follows `class`
let lx_class_lt = fn (s: str) -> fn (k: int) ->
  let k2 = lx_back_ws s (k - 1) in
  if k2 >= 0 && str_eq (char_at s k2) "<" then str_eq (lx_word_at s (lx_back_ws s (k2 - 1))) "class"
  else
    (let rec path = fn (j: int) ->
       let j2 = lx_back_word s j in
       if j2 >= 1 && str_eq (char_at s j2) ":" && str_eq (char_at s (j2 - 1)) ":" then path (j2 - 2) else j2 in
     if k2 >= 0 && is_alnum (char_at s k2) then str_eq (lx_word_at s (lx_back_ws s (path k2))) "class" else false);
let colon_cmd_head = fn (s: str) -> fn (i: int) ->
  let k0 = (if i > 0 && (str_eq (char_at s (i - 1)) "?" || str_eq (char_at s (i - 1)) "!") then i - 2 else i - 1) in
  let st = lx_back_word s k0 in
  if st >= k0 || is_digit (char_at s (st + 1)) then false
  else
    (let k = lx_back_ws s st in
     if k < 0 then true
     else
       (let c = char_at s k in
        if k == st && (str_eq c "@" || str_eq c "$" || str_eq c ":" || str_eq c ".") then false
        else if str_eq c ";" then true
        else if str_eq c "\n" then
          (let k2 = lx_back_wsnl s k in
           if k2 < 0 then true
           else (let c2 = char_at s k2 in
                 if str_eq c2 "," || str_eq c2 "(" || str_eq c2 "[" || str_eq c2 "\{" || str_eq c2 "|" || str_eq c2 "\\"
                    || str_eq c2 "+" || str_eq c2 "-" || str_eq c2 "*" || str_eq c2 "/" || str_eq c2 "%" || str_eq c2 "&"
                    || str_eq c2 "^" || str_eq c2 "<" || str_eq c2 ">" || str_eq c2 "=" || str_eq c2 "!" || str_eq c2 "?"
                    || str_eq c2 ":" || str_eq c2 "." then false
                 else true))
        else if str_eq c "=" then
          (k == 0 || (let p = char_at s (k - 1) in
                      if str_eq p "=" || str_eq p "!" || str_eq p "<" || str_eq p ">" then false else true))
        else if str_eq c "\{" then (k > 0 && str_eq (char_at s (k - 1)) "#") || lx_block_brace s k
        else if str_eq c "<" then lx_class_lt s k
        else if is_alnum c then
          (let w0 = lx_back_word s k in
           lx_cmd_kw (lx_word_at s k) && (if w0 >= 0 && str_eq (char_at s w0) "." then false else true))
        else false));

// is the byte at i the start of a well-formed UTF-8 character?
let lex_utf8_ok = fn (s: str) -> fn (i: int) ->
  let b = ord (char_at s i) in
  let cont = fn (k: int) -> (i + k < str_len s) && (let c9 = ord (char_at s (i + k)) in c9 >= 128 && c9 <= 191) in
  if b >= 194 && b <= 223 then cont 1
  else if b >= 224 && b <= 239 then cont 1 && cont 2
  else if b >= 240 && b <= 244 then cont 1 && cont 2 && cont 3
  else false;
let lex_src_is_utf8 = fn (u: unit) ->
  let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
  str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8";
// how many `def` bodies the parser is inside (an END there warns)
let def_depth = map_new ();
// how many statements the parser is inside ("d"; a top-level statement is 1)
// and the depth a BEGIN's body is parsed at ("p"): BEGIN is legal only at
// the top level and directly in another BEGIN (ruby's "BEGIN is permitted
// only at toplevel"). lex_src starts every parse at 0.
let stmt_nest = map_new ();
// set ("q") while a condition under `!` is read: its literals are not warned about
let cond_quiet = map_new ();
// what the enclosing def, block and lambda bodies took anonymously, innermost
// at "n": a frame is "D" (a def) or "B" (a block or lambda), then the letters
// r (`*`), k (`**`), b (`&`), f (`...`). A call that passes one of them on
// asks it (anon_use): ruby's "no anonymous rest parameter" and "anonymous
// rest parameter is also used within block". lex_src starts every parse empty.
let afr_n = map_new ();
let afr = map_new ();
// an eval's line argument below 1 ("n" = the argument minus the 1 the tokens
// are numbered from): `eval(src, nil, "test.rb", 0)` warns at test.rb:1 for
// the source's 2nd line
let parse_lshift = map_new ();
// the shift to add to a line the PARSER read off a token ("n"), and the one
// for a line the LEXER counts from the start of the text ("b" + "n": an
// eval's tokens are numbered from its line argument, its text from 1)
let lshift_tok = fn (u: unit) -> if map_has parse_lshift "n" then map_get parse_lshift "n" else 0;
let lshift_lex = fn (u: unit) -> lshift_tok () + (if map_has parse_lshift "b" then map_get parse_lshift "b" else 0);
// ---- the local-variable table ----------------------------------------------
// ruby decides several shapes by whether a NAME is a local variable assigned
// earlier in the current scope, and nothing else can decide them: `p / r` is
// a division when p is a local and `p(/ r.../)` when it is not; likewise
// `x %(2)`, `x [1]`, `x ?a : b`, `x &y`, `x ::C`. This lexer used to guess
// from the characters alone, so matrix's eigenvalue decomposition --
// `p = c * @d[i] - s * g` and then `c = p / r` -- read the `/` as the opening
// of a regexp and the file did not parse.
//
// The lexer keeps the table because the lexer is where those decisions are
// made (the parser only sees the tokens). It is kept the way ruby keeps it:
// a stack of scopes, pushed by `def`/`class`/`module` (opaque: the enclosing
// locals are not visible) and by a block or lambda (transparent), and filled
// by every place a local is born -- `x =`, `x op=`, multiple assignment,
// method/block/lambda parameters, `for` variables, `rescue => e`.
//
// ⚠ IT IS CONSULTED ONLY IN ONE DIRECTION. A name the table knows is a local
//   gets ruby's reading of a local; a name it does not know keeps the
//   character-level guess it always had. So a table that misses a local
//   (pattern variables, `binding.local_variable_set`, an eval's enclosing
//   scope) costs nothing that was working, and only a name WRONGLY believed
//   local could change a reading -- which is why the scopes are popped at
//   the `end`/`}` that closes them rather than left to accumulate.
//
// lvt_names: "<scope id>:<name>" -> 1. lvt_sv holds four counters: 0 the
// scope depth, 1 the next scope id, 2 the depth of the opener stack, 3 how
// many endless defs are on it. Per scope depth d: lvt_fid (its id) and
// lvt_fop (1 when opaque); per opener n: lvt_kk (what opened it) and lvt_kl
// (where a `while`/`until`/`for` whose `do` is still optional began).
// ⚠ VECTORS, NOT A MAP WITH BUILT KEYS. The first version kept all of this
//   in one map under keys like "k" ++ str_of_int n, and every block and def
//   paid about ten key builds and lookups: lexing a file of 1000 defs took 80%
//   longer than before the table, and `-e 1` (which lexes the prelude) 13%.
let lvt_names = map_new ();
let lvt_sv = vec_new ();
let lvt_fid = vec_new ();
let lvt_fop = vec_new ();
let lvt_kk = vec_new ();
let lvt_kl = vec_new ();
// ---- heredoc bodies a newline jumps over -----------------------------------
// A heredoc's body starts on the line after the one its `<<ID` is on, and the
// rest of that line is ordinary code -- which may hold a SECOND heredoc, whose
// body comes after the first one's terminator (`f(<<~A, <<~B)`). So the line
// is lexed in place, and each heredoc notes here "the newline at hd_nl of
// hd_src goes on at hd_aft"; lex_go's newline (and a string's, when the
// literal runs across that line) takes the jump. hd_cnt holds the count.
// An interpolation's code is lexed as a substring with no next line of its
// own: hd_cs / hd_cv name the source it sits in and where (offset, length+1;
// 0 = none), so `"#{<<~"begin;"}\n#{<<~'end;'}"` -- the opening line of
// hundreds of CRuby tests -- takes its bodies from the lines below the string.
let hd_src = vec_new ();
let hd_nl = vec_new ();
let hd_aft = vec_new ();
let hd_cnt = vec_new ();
let hd_cs = vec_new ();
let hd_cv = vec_new ();
// where the lexer met `__END__` -- a line that is exactly that, where a token
// would start -- in the source it was last asked to lex (-1: it did not).
// The program ends there and DATA starts after it. A heredoc's body is never
// where a token starts (the newline jumps over it), so an `__END__` line
// inside one is text: test_io's `assert_separately([], <<-SRC) ... __END__`
// had cut the main script there, and the file was a SyntaxError.
let lex_end = map_new ();
// the byte length of the UTF-8 character whose first byte is `c`
let lex_u8_width = fn (c: str) ->
  let o = ord c in
  if o >= 240 then 4 else if o >= 224 then 3 else if o >= 192 then 2 else 1;
// ...and of the character at s[i] in the SOURCE's encoding: a non-UTF-8 magic
// comment, or the encoding of an eval'd string (`?\“` in EUC-JP is two bytes)
let lex_src_cw = fn (s: str) -> fn (i: int) ->
  if lex_src_is_utf8 () then lex_u8_width (char_at s i)
  else
    // (the coding is the magic comment's spelling, upper-cased: enc_clen1
    //  knows the canonical names, "WINDOWS-31J" was none of them)
    (let cd = (match map_get load_ctx "coding" with VStr h -> enc_canon_name (sget h) | _ -> "") in
     let k = enc_clen1 cd (substring s i (if i + 4 < str_len s then i + 4 else str_len s)) in
     if k > 0 then k else 1);
// an identifier's characters. A non-ASCII one is taken whole in the
// source's encoding: in a Shift_JIS source the second byte of "\x87]" is
// a `]`, which is part of the character, not the closing bracket.
let rec scan_ident = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alnum (char_at s i) then
    scan_ident s (i + (if ord (char_at s i) >= 128 && (if lex_src_is_utf8 () then false else true) then lex_src_cw s i else 1))
  else i;

// ⚠ a digit run's underscores as ruby allows them: one between two digits.
//   `1_` ("trailing '_' in number") and `1__0` ("invalid underscore placement
//   in number") were numbers, 1 and 10; so were `1.0_` and `1e1_`.
let num_us_refuse = fn (s: str) -> fn (i: int) -> fn (j: int) ->
  if j > i && str_eq (char_at s (j - 1)) "_" then syn_refuse "trailing '_' in number"
  else if j > i && str_index_of (substring s i j) "__" >= 0 then syn_refuse "invalid underscore placement in number"
  else ();
// how many ( [ { are open before offset i of s (counted on the raw text: a
// bracket inside a string only ever makes it larger or smaller by its own)
let rec br_depth = fn (s: str) -> fn (i: int) -> fn (k: int) -> fn (d: int) ->
  if k >= i then d
  else (let c9 = char_at s k in
        br_depth s i (k + 1) (if str_eq c9 "(" || str_eq c9 "[" || str_eq c9 "\{" then d + 1
                              else if str_eq c9 ")" || str_eq c9 "]" || str_eq c9 "}" then d - 1 else d));
// does the line holding offset i begin (after blanks and `(`) with `def `?
let rec line_start = fn (s: str) -> fn (k: int) ->
  if k <= 0 then 0 else if str_eq (char_at s (k - 1)) "\n" then k else line_start s (k - 1);
let rec skip_lead = fn (s: str) -> fn (k: int) ->
  if k < str_len s && (str_eq (char_at s k) " " || str_eq (char_at s k) "\t" || str_eq (char_at s k) "(") then skip_lead s (k + 1) else k;
let line_is_def = fn (s: str) -> fn (i: int) ->
  let k9 = skip_lead s (line_start s i) in
  k9 + 4 <= str_len s && str_eq (substring s k9 (k9 + 4)) "def ";
// the line (from 1) that offset i of s is on
let rec nls_before = fn (s: str) -> fn (i: int) -> fn (k: int) -> fn (n: int) ->
  if k >= i then n else nls_before s i (k + 1) (if str_eq (char_at s k) "\n" then n + 1 else n);
// A token's line is the line of the newline mark that ends its logical line
// (tok_line), less the newlines inside that logical line that come after the
// token -- the ones no mark stands for: a `\` at the end of a line, a string
// or a %w across lines. The lexer of the source lex_src was given (and not a
// piece of it lexed on its own, an interpolation) counts them where the next
// token starts and leaves a TCont there; lex_src takes the TConts out again
// and keeps, for the mark that ends each logical line, how many tokens the
// line has and after how many tokens each one stood.
let tc_st = map_new ();
// (lex_src's record, by the offset of the mark that ends a logical line --
//  "eof" for the last line of a source with no newline at its end: "O" the
//  tokens on the line, "O#n" how many newlines it passed, "O#k" after how
//  many tokens the k-th one stood; number_nls moves it to the mark's line
//  number, tc_ln)
let tc_off = map_new ();
let tc_ln = map_new ();
let rec tc_nls = fn (s: str) -> fn (i: int) -> fn (stop: int) -> fn (acc: int) ->
  if i >= stop || i >= str_len s then acc
  else tc_nls s (i + 1) stop (if str_eq (char_at s i) "\n" then acc + 1 else acc);
let tc_skipped = fn (s: str) -> fn (i: int) ->
  if (if map_has tc_st "on" then map_get tc_st "on" == 1 else false) && str_len s == map_get tc_st "len" then
    (let p = map_get tc_st "prev" in
     if i > p then (let _ = map_set tc_st "prev" i in tc_nls s p i 0) else 0)
  else 0;
let tc_mark = fn (s: str) -> fn (j: int) ->
  if (if map_has tc_st "on" then map_get tc_st "on" == 1 else false) && str_len s == map_get tc_st "len" then map_set tc_st "prev" j else ();
let rec lex_go = fn (s: str) -> fn (i: int) ->
  let k = tc_skipped s i in
  if k > 0 then Cons (TCont k, lex_go_b s i) else lex_go_b s i
and lex_go_b = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Cons (TEOF, Nil)
  else
    let c = char_at s i in
    // (a CR that does not end the line is a space, and ruby says so)
    let _ = bal_warn s i in
    let _ = (if str_eq c "\r" && (if i + 1 < str_len s then (if str_eq (char_at s (i + 1)) "\n" then false else true) else true)
             then warn_note (parse_time_file () ++ ":" ++ str_of_int (nls_before s i 0 1 + lshift_lex ()) ++ ": warning: encountered \\r in middle of line, treated as a mere space")
             else ()) in
    if str_eq c " " || str_eq c "\t" || str_eq c "\r" then lex_go s (i + 1)
    // NUL, ^D and ^Z where a token would start end the script, as they do for
    // ruby; inside a comment or a string literal they are bytes like any
    // other (see src_prepare, which used to cut at the first NUL anywhere).
    else if str_eq c (chr 0) || str_eq c (chr 4) || str_eq c (chr 26) then Cons (TEOF, Nil)
    else if str_eq c "_" && (i == 0 || str_eq (char_at s (i - 1)) "\n")
            && i + 7 <= str_len s && str_eq (substring s i (i + 7)) "__END__"
            && (i + 7 == str_len s || str_eq (char_at s (i + 7)) "\n"
                || (i + 8 < str_len s + 1 && str_eq (substring s (i + 7) (if i + 9 <= str_len s then i + 9 else str_len s)) "\r\n")) then
      (let _ = map_set lex_end 0 i in Cons (TEOF, Nil))
    else if str_eq c "\n" || str_eq c ";" then
      (let _ = (if str_eq c "\n" then lvt_newline () else ()) in
       let j = (if str_eq c "\n" then hd_jump s i else 0 - 1) in
       // (the newline the mark stands for, and a heredoc's body after it, are
       //  not newlines the line passed)
       let _ = tc_mark s (if j >= 0 then j else i + 1) in
       Cons (TNL i, lex_go s (if j >= 0 then j else i + 1)))
    else if str_eq c "#" then
      (let e = skip_comment s i in
       let v = scv_value s i e in
       // (a frozen_string_literal comment after the first token is no magic
       //  comment: -w says so, once the line is a comment alone)
       let _ = (if parse_verbose () && fsl_comment_text (substring s i e) && scv_comment_only s i && code_before s i
                then lex_warn_at s i "'frozen_string_literal' is ignored after any tokens" else ()) in
       if str_eq v "" then lex_go s e
       else if (if scv_comment_only s i then false else true) then
         (let _ = (if parse_verbose () then lex_warn_at s i "'shareable_constant_value' is ignored unless in comment-only line" else ()) in lex_go s e)
       else if scv_known (scv_norm v 0 "") then Cons (TId ("__scv~" ++ scv_norm v 0 ""), lex_go s e)
       else (let _ = (if parse_verbose () then lex_warn_at s i ("invalid value for shareable_constant_value: " ++ v) else ()) in lex_go s e))
    // `=begin` ... `=end` block comment: both markers sit at column 0.
    else if str_eq c "=" && (i == 0 || str_eq (char_at s (i - 1)) "\n")
            && i + 6 <= str_len s && str_eq (substring s i (i + 6)) "=begin" then
      lex_go s (skip_block_comment s i)
    else if is_digit c then
      // 0x / 0o / 0b / 0d prefixed integers.
      if str_eq c "0" && i + 1 < str_len s &&
         (let n = char_at s (i + 1) in
          str_eq n "x" || str_eq n "X" || str_eq n "o" || str_eq n "O" ||
          str_eq n "b" || str_eq n "B" || str_eq n "d" || str_eq n "D") then
        let n = char_at s (i + 1) in
        let base = if str_eq n "x" || str_eq n "X" then 16
                   else if str_eq n "o" || str_eq n "O" then 8
                   else if str_eq n "d" || str_eq n "D" then 10 else 2 in
        let j = scan_base s (i + 2) base in
        // `0b` with no digit after it is no number at all (nor is `0x_1`)
        let _ = (if j == i + 2 || str_eq (char_at s (i + 2)) "_" then syn_refuse ("invalid " ++ (if base == 16 then "hexadecimal" else if base == 8 then "octal" else if base == 10 then "decimal" else "binary") ++ " number; numeric literal without digits") else ()) in
        let _ = num_us_refuse s (i + 2) j in
        // (`0x0.0`: a prefixed integer has no fraction)
        let _ = (if num_frac_after s j then syn_refuse "unexpected fraction part after numeric literal" else ()) in
        let dv = dec_of_base s (i + 2) j base "0" in
        if dec_fits_int dv then ri_suffix s j (parse_base s (i + 2) j base 0)
        else Cons (TBig dv, lex_go s j)
      // leading-zero octal: 017 == 15 (0 then octal digits, not . or e).
      // (`0_10` is octal too, 8; an 8 or a 9 in the run is ruby's syntax
      //  error: `09` is the integer 0 and then an unexpected integer)
      else if str_eq c "0" && i + 1 < str_len s && (let n = char_at s (i + 1) in is_digit n || str_eq n "_") then
        let _ = (let j9 = scan_base s (i + 1) 10 in
                 if oct_run_bad s (i + 1) j9 then
                   syn_refuse (if j9 + 1 < str_len s && str_eq (char_at s j9) "." && is_digit (char_at s (j9 + 1))
                               then "unexpected float, expecting end-of-input" else "unexpected integer, expecting end-of-input")
                 else ()) in
        let j = scan_base s (i + 1) 8 in
        let _ = num_us_refuse s (i + 1) j in
        let dv = dec_of_base s (i + 1) j 8 "0" in
        if dec_fits_int dv then ri_suffix s j (parse_base s (i + 1) j 8 0)
        else Cons (TBig dv, lex_go s j)
      else
        // decimal (with `_` separators), optionally a float.
        let j = scan_base s i 10 in
        let _ = num_us_refuse s i j in
        if j + 1 < str_len s && str_eq (char_at s j) "."
           && is_digit (char_at s (j + 1)) then
          let k0 = scan_base s (j + 1) 10 in
          let _ = num_us_refuse s (j + 1) k0 in
          // exponent: 1.2e-3 / 4.5E+2 / 6.7e8
          let k = scan_exponent s k0 in
          let _ = num_us_refuse s k0 k in
          // (`0.0.0`: nor does a float have a second one)
          let _ = (if num_frac_after s k then syn_refuse "unexpected fraction part after numeric literal" else ()) in
          // rational-imaginary literal: 1.2ri == Complex(0, Rational(12, 10)).
          if k == k0 && k0 + 1 < str_len s && str_eq (char_at s k0) "r" && str_eq (char_at s (k0 + 1)) "i"
             && (k0 + 2 >= str_len s || (let nc = char_at s (k0 + 2) in if is_alnum nc || str_eq nc "_" then false else true)) then
            let ip = strip_us (substring s i j) 0 "" in
            let fd = strip_us (substring s (j + 1) k0) 0 "" in
            Cons (TImagRat (ip ++ fd, pow10_str (str_len fd)), lex_go s (k0 + 2))
          // decimal-fraction Rational literal: 0.3r == Rational(3, 10).
          else if k == k0 && k0 < str_len s && str_eq (char_at s k0) "r"
             && (k0 + 1 >= str_len s || (let nc = char_at s (k0 + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            let ip = strip_us (substring s i j) 0 "" in
            let fd = strip_us (substring s (j + 1) k0) 0 "" in
            Cons (TRat (ip ++ fd, pow10_str (str_len fd)), lex_go s (k0 + 1))
          // decimal-fraction Complex literal: 0.6i == Complex(0, 0.6).
          else if k < str_len s && str_eq (char_at s k) "i"
             && (k + 1 >= str_len s || (let nc = char_at s (k + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImagF (float_of_str (strip_us (substring s i k) 0 "")), lex_go s (k + 1))
          else
            Cons (TFlt (float_of_str (strip_us (substring s i k) 0 "")), lex_go s k)
        else
          let je = scan_exponent s j in
          let _ = num_us_refuse s j je in
          if je > j then
            // exponent + imaginary: 1e1i == Complex(0, 10.0). (1e1r is a
            // syntax error in Ruby, so no rational counterpart here.)
            (if je < str_len s && str_eq (char_at s je) "i"
                && (je + 1 >= str_len s || (let nc = char_at s (je + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
               Cons (TImagF (float_of_str (strip_us (substring s i je) 0 "")), lex_go s (je + 1))
             else
               (let f9 = float_of_str (strip_us (substring s i je) 0 "") in
                // past the largest double it reads as Infinity, which ruby
                // says under -w
                let _ = (if f9 > 1.7976931348623157e308 && parse_verbose () then
                           lex_warn_at s i ("Float " ++ substring s i je ++ " out of range") else ()) in
                Cons (TFlt f9, lex_go s je)))
          // rational-imaginary: 1ri == Complex(0, Rational(1, 1)).
          else if j + 1 < str_len s && str_eq (char_at s j) "r" && str_eq (char_at s (j + 1)) "i"
                  && (j + 2 >= str_len s || (let nc = char_at s (j + 2) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImagRat (strip_us (substring s i j) 0 "", "1"), lex_go s (j + 2))
          else if j < str_len s && str_eq (char_at s j) "r"
                  && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TRat (strip_us (substring s i j) 0 "", "1"), lex_go s (j + 1))
          else if j < str_len s && str_eq (char_at s j) "i"
                  && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImag (parse_base s i j 10 0), lex_go s (j + 1))
          else
            // decimal integer: emit a big-literal token when it exceeds int64.
            let ds = strip_us (substring s i j) 0 "" in
            if str_len ds < 19 || (str_len ds == 19 && str_compare ds "9223372036854775807" <= 0)
            then Cons (TInt (parse_base s i j 10 0), lex_go s j)
            else Cons (TBig ds, lex_go s j)
    // (a `?` where only a value can stand that starts no character literal:
    //  at the end of the source, or before a blank or a word)
    else if str_eq c "?" && pct_strict_value s i && (if i + 1 < str_len s && is_char_lit s i then false else true) then
      (let _ = syn_refuse (if i + 1 >= str_len s then "incomplete character syntax" else "unexpected '?', ignoring it") in Nil)
    else if str_eq c "?" && i + 1 < str_len s && is_char_lit s i then
      // character literal: `?x` is the one-character string "x", for ANY
      // character that is not whitespace — `?/` and `?,` count, which is how
      // `dir.chomp(?/)` reads. (See is_char_lit for the ternary boundary.)
      let n = char_at s (i + 1) in
      if str_eq n "\\" && i + 2 < str_len s then
        let e = char_at s (i + 2) in
        // `?\001`, `?\x41`, `?é`: escapes with a LENGTH of their own, so
        // they are scanned exactly as they are inside a string rather than
        // mapped one character to one.
        if e >= "0" && e <= "7" then
          (let (oval, oj) = scan_octal s (i + 2) 0 0 in Cons (TStrL (chr oval), lex_go s oj))
        else if str_eq e "x" && i + 3 < str_len s && is_hex_digit (char_at s (i + 3)) then
          (let d1 = hex_val (char_at s (i + 3)) in
           if i + 4 < str_len s && is_hex_digit (char_at s (i + 4))
           then Cons (TStrL (chr (d1 * 16 + hex_val (char_at s (i + 4)))), lex_go s (i + 5))
           else Cons (TStrL (chr d1), lex_go s (i + 4)))
        // (`?\u{201c}`: the braced form, as in a string)
        // (...ONE codepoint: `?\u{41 42}` is "Multiple codepoints at single
        //  character literal")
        else if str_eq e "u" && i + 3 < str_len s && str_eq (char_at s (i + 3)) "\{" then
          (let (bytes, j) = scan_u_braced s (i + 4) "" (0 - 1) in
           let close9 = str_find_from s "}" (i + 4) in
           let inner9 = (if close9 > i + 4 then mc_trim (substring s (i + 4) close9) else "") in
           if str_contains inner9 " " || str_contains inner9 "\t" then
             (let _ = syn_refuse "Multiple codepoints at single character literal" in Nil)
           else Cons (TStrL bytes, lex_go s j))
        // (`\uXXXX` needs all four digits: `?\u123` is "invalid Unicode escape")
        else if str_eq e "u" && (if i + 6 < str_len s then false else true
                                 || (if is_hex_digit (char_at s (i + 3)) && is_hex_digit (char_at s (i + 4))
                                        && is_hex_digit (char_at s (i + 5)) && is_hex_digit (char_at s (i + 6)) then false else true)) then
          (let _ = syn_refuse "invalid Unicode escape" in Nil)
        else if str_eq e "u" && i + 6 < str_len s then
          (let cp = hex4 s (i + 3) in Cons (TStrL (utf8_of cp), lex_go s (i + 7)))
        // `?\C-z` / `?\cz` (control: low five bits, `?` -> DEL), `?\M-z` (meta:
        // high bit set), and `?\M-\C-z` (both).
        else if str_eq e "M" && i + 4 < str_len s && str_eq (char_at s (i + 3)) "-" then
          (if str_eq (char_at s (i + 4)) "\\" && i + 7 < str_len s
              && str_eq (char_at s (i + 5)) "C" && str_eq (char_at s (i + 6)) "-" then
             Cons (TStrL (chr (ctrl_code (char_at s (i + 7)) + 128)), lex_go s (i + 8))
           else Cons (TStrL (chr ((ord (char_at s (i + 4)) - (ord (char_at s (i + 4)) / 128) * 128) + 128)), lex_go s (i + 5)))
        else if str_eq e "C" && i + 4 < str_len s && str_eq (char_at s (i + 3)) "-" then
          Cons (TStrL (chr (ctrl_code (char_at s (i + 4)))), lex_go s (i + 5))
        else if str_eq e "c" && i + 3 < str_len s then
          Cons (TStrL (chr (ctrl_code (char_at s (i + 3)))), lex_go s (i + 4))
        // (`?\“`: a backslash before a multibyte character is that character,
        //  all of its bytes -- the first byte alone was a broken token)
        else if ord e >= 128 then
          (let w = lex_src_cw s (i + 2) in
           let w = (if i + 2 + w > str_len s then 1 else w) in
           Cons (TStrL (substring s (i + 2) (i + 2 + w)), lex_go s (i + 2 + w)))
        else
        let ch = if str_eq e "n" then "\n" else if str_eq e "t" then "\t"
                 else if str_eq e "r" then chr 13 else if str_eq e "s" then " "
                 else if str_eq e "0" then chr 0 else if str_eq e "e" then chr 27
                 else if str_eq e "a" then chr 7 else if str_eq e "b" then chr 8
                 else if str_eq e "f" then chr 12 else if str_eq e "v" then chr 11
