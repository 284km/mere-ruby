      // `.__interp_str`, not `.to_s`: Ruby's interpolation uses a value that is
      // already a String AS IT IS, and only calls to_s on everything else. With
      // `.to_s` here, a program that redefines String#to_s changed what every
      // interpolation of every string produced -- `"#{s}"` and `s.to_s` are two
      // different questions and this asked the second one for both.
      let interp =
        Cons (TP "+", Cons (TP "(",
          tapp exprtoks (Cons (TP ")", Cons (TP ".", Cons (TId "__interp_str", Nil)))))) in
      let (rest, j) = lex_dstr_t term s (close + 1) "" in
      (Cons (TP "+", Cons (TStrL lit, tapp interp rest)), j)
    else lex_dstr_t term s (i + 1) (lit ++ c)

// \u{XXXX YYYY ...}: hex codepoints (space-separated) up to the closing
// brace; returns the UTF-8 bytes and the index after the "}".
and scan_u_braced = fn (s: str) -> fn (i: int) -> fn (acc: str) -> fn (cp: int) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated backslash-u" ++ parsing_file ()))) in fail ("mere-ruby: unterminated backslash-u" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c "}" then (acc ++ (if cp > 0 then utf8_of cp else ""), i + 1)
    else if str_eq c " " then scan_u_braced s (i + 1) (acc ++ (if cp > 0 then utf8_of cp else "")) 0
    else if is_hex_digit c then scan_u_braced s (i + 1) acc (cp * 16 + hex_val c)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad backslash-u")) in fail "mere-ruby: bad backslash-u")

// %(…) / %q(…) / %Q(…) / %w(…): index of the body start, or -1 when the
// % is just the modulo operator.
and percent_body = fn (s: str) -> fn (i: int) ->
  if i + 1 >= str_len s then 0 - 1
  // `x.%(3)` — a `%` right after a dot is the METHOD, never a literal. The
  // same holds for a backtick: `Kernel.`(cmd)` calls the method.
  else if i > 0 && str_eq (char_at s (i - 1)) "." then 0 - 1
  // ...and `def %(other)` defines the METHOD: after `def` a % is a name, not a
  // literal opener. `class C; def %(o); end; end` did not parse at all, which
  // is every spec that defines modulo on its own class.
  // (guarded: with nothing before the %, prev_nonspace answers -1 and
  // word_ending_at would take a substring at a negative index -- which is how
  // a file whose FIRST token is `%w[...]` died with an interpreter error)
  else if (let pv = prev_nonspace s (i - 1) in
           pv >= 0 && str_eq (word_ending_at s pv) "def") then 0 - 1
  else
    let c1 = char_at s (i + 1) in
    // Bracket delimiters ( { [ < are unambiguous openers. Other clean
    // delimiters (', |, / ...) start a bare percent string only in value
    // position, to avoid stealing the modulo operator.
    if is_pct_open c1 then i + 2
    else if is_pct_delim c1 && regex_position s i then i + 2
    else if (str_eq c1 "q" || str_eq c1 "Q" || str_eq c1 "w" || str_eq c1 "i" || str_eq c1 "s" ||
             str_eq c1 "W" || str_eq c1 "I" || str_eq c1 "r" || str_eq c1 "x")
            && i + 2 < str_len s && is_pct_delim (char_at s (i + 2)) then i + 3
    else 0 - 1

// the control-character code for `\C-x`: the low five bits, except that
// `\C-?` is DEL.
and ctrl_code = fn (x: str) ->
  if str_eq x "?" then 127 else (let o = ord x in o - (o / 32) * 32)

// the last non-blank character before position i is `ch`
and prev_nonspace_is = fn (s: str) -> fn (i: int) -> fn (ch: str) ->
  let rec back = fn (j: int) ->
    if j < 0 then false
    else let c = char_at s j in
         if str_eq c " " || str_eq c "\t" then back (j - 1)
         else str_eq c ch in
  back (i - 1)
// the word ending just before position i (blanks allowed between) is `w`,
// and is not the tail of a longer identifier
and prev_word_is = fn (s: str) -> fn (i: int) -> fn (w: str) ->
  let rec back = fn (j: int) ->
    if j < 0 then false
    else let c = char_at s j in
         if str_eq c " " || str_eq c "\t" then back (j - 1)
         else
           let n = str_len w in
           j + 1 >= n && str_eq (substring s (j + 1 - n) (j + 1)) w
           && (j + 1 - n == 0 || (if is_alnum (char_at s (j - n)) || str_eq (char_at s (j - n)) "_" then false else true)) in
  back (i - 1)

// a percent-literal delimiter: any non-alphanumeric, non-space char.
and is_pct_delim = fn (c: str) ->
  // any non-alnum, non-whitespace char; _ and = are valid Ruby delimiters
  // (the bare-% form is still guarded by regex_position at the caller).
  str_eq c "_" || str_eq c "=" ||
  ((if is_alnum c then false else true) &&
   (if str_eq c " " || str_eq c "\t" || str_eq c "\n" then false else true))

and is_pct_open = fn (c: str) -> str_eq c "(" || str_eq c "\{" || str_eq c "[" || str_eq c "<"

and pct_close_of = fn (c: str) ->
  if str_eq c "(" then ")" else if str_eq c "\{" then "}"
  else if str_eq c "[" then "]" else if str_eq c "<" then ">" else c

and is_percent_w = fn (s: str) -> fn (i: int) ->
  i + 1 < str_len s && (str_eq (char_at s (i + 1)) "w" || str_eq (char_at s (i + 1)) "W")

// raw scan to the balanced closing delimiter; returns (body, index-after).
// like scan_balanced2 but for %r regex bodies: an escaped delimiter keeps
// its backslash only when the delimiter is a regex metacharacter (%r(\() is
// /\(/ but %r-\-- is /-/, matching Ruby's source normalization); any other
// backslash pair is copied verbatim for the regex parser.
and rx_is_meta = fn (c: str) ->
  str_eq c "|" ||
  str_eq c "\{" ||
  str_eq c "\\" ||
  map_has (name_set "rx_is_meta") c
and scan_pct_regex = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated %r literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated %r literal" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (let nx = char_at s (i + 1) in
       if (str_eq nx op || str_eq nx clo) && (if rx_is_meta nx then false else true) then
         scan_pct_regex s (i + 2) depth (acc ++ nx) op clo
       else scan_pct_regex s (i + 2) depth (acc ++ c ++ nx) op clo)
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_pct_regex s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_pct_regex s (i + 1) (depth - 1) (acc ++ c) op clo)
    else scan_pct_regex s (i + 1) depth (acc ++ c) op clo

and scan_balanced2 = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated % literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated % literal" ++ parsing_file ()))
  else
    let c = char_at s i in
    // a backslash escapes the delimiter (and itself) inside the body.
    if str_eq c "\\" && i + 1 < str_len s &&
       (str_eq (char_at s (i + 1)) op || str_eq (char_at s (i + 1)) clo || str_eq (char_at s (i + 1)) "\\") then
      scan_balanced2 s (i + 2) depth (acc ++ char_at s (i + 1)) op clo
    // when open and close differ (brackets) nesting counts; otherwise the
    // first delimiter closes.
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_balanced2 s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_balanced2 s (i + 1) (depth - 1) (acc ++ c) op clo)
    // an interpolation is copied through whole: its text may contain the
    // delimiter (`%@hey #{@ip}@` -- the `@` of the ivar is not the closer).
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      let j = skip_interp_body s (i + 2) 1 in
      scan_balanced2 s j depth (acc ++ substring s i j) op clo
    else scan_balanced2 s (i + 1) depth (acc ++ c) op clo

// index just past the `}` that closes an interpolation whose `#{` has been
// consumed; braces inside nest.
and skip_interp_body = fn (s: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len s then i
  else let c = char_at s i in
       if str_eq c "\{" then skip_interp_body s (i + 1) (depth + 1)
       else if str_eq c "}" then (if depth == 1 then i + 1 else skip_interp_body s (i + 1) (depth - 1))
       else skip_interp_body s (i + 1) depth

// %w body -> `"w1", "w2", ... ]` token run (the caller emits the `[`).
// A backslash escapes the next character into the word (b\ c, b\<nl>c).
and pw_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pw_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pw_tok interp w (Cons (TP "]", rest))
    else pw_tok interp w (Cons (TP ",", pw_words interp t k rest))

// %i body -> `:w1, :w2, ... ]` token run (symbol words).
and pi_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pi_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pi_tok interp w (Cons (TP "]", rest))
    else pi_tok interp w (Cons (TP ",", pi_words interp t k rest))

// one %I/%W word: an interpolated word desugars through the string lexer.
and pi_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && rx_has_interp w 0 then
    Cons (TP "(s", tapp (drop_eof (lex_go (rx_interp_src w) 0))
      (Cons (TP ")", Cons (TP ".", Cons (TId "to_sym", rest)))))
  else Cons (TSym w, rest)

and pw_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && rx_has_interp w 0 then
    Cons (TP "(s", tapp (drop_eof (lex_go (rx_interp_src w) 0)) (Cons (TP ")", rest)))
  else Cons (TStrL w, rest)

and pw_word = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len t then (acc, i)
  else
    let c = char_at t i in
    // In %W/%I (interp) a backslash-escape expands C-style (\t \n \s);
    // in %w/%i it keeps the next character literally (\ joins words).
    if str_eq c "\\" && i + 1 < str_len t then
      let nx = char_at t (i + 1) in
      let piece = (if interp then
                     (if str_eq nx "t" then "\t" else if str_eq nx "n" then "\n"
                      else if str_eq nx "s" then " " else if str_eq nx "r" then "\r"
                      else if str_eq nx "e" then chr 27 else nx)
                   // %w keeps a literal backslash except before space / \ / nl.
                   else if str_eq nx " " || str_eq nx "\\" || str_eq nx "\n" then nx
                   else "\\" ++ nx) in
      pw_word interp t (i + 2) (acc ++ piece)
    else if str_eq c " " || str_eq c "\n" then (acc, i)
    else pw_word interp t (i + 1) (acc ++ c)

and pw_skip = fn (t: str) -> fn (j: int) ->
  if j < str_len t && (str_eq (char_at t j) " " || str_eq (char_at t j) "\n") then pw_skip t (j + 1) else j

// index after an e/E exponent suffix at i, or i when there is none.
and scan_exponent = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) "e" || str_eq (char_at s i) "E") then
    let j = (if i + 1 < str_len s && (str_eq (char_at s (i + 1)) "-" || str_eq (char_at s (i + 1)) "+") then i + 2 else i + 1) in
    (if j < str_len s && is_digit (char_at s j) then scan_base s j 10 else i)
  else i

// emit an integer literal with an optional `r` (Rational) / `i` (Complex)
// suffix; used for the hex/octal/binary paths (the decimal path inlines it).
and ri_suffix = fn (s: str) -> fn (j: int) -> fn (v: int) ->
  if j < str_len s && str_eq (char_at s j) "r"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TRat (str_of_int v, "1"), lex_go s (j + 1))
  else if j < str_len s && str_eq (char_at s j) "i"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TImag v, lex_go s (j + 1))
  else Cons (TInt v, lex_go s j)

and is_upper = fn (c: str) -> let o = ord c in o >= 65 && o <= 90

and quote_end = fn (s: str) -> fn (i: int) -> fn (q: str) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) q then i
  else quote_end s (i + 1) q

and hexv = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87
  else if o >= 65 && o <= 70 then o - 55
  else 0

// up to 3 octal digits from i; returns (value, index-after).
and scan_octal = fn (s: str) -> fn (i: int) -> fn (acc: int) -> fn (n: int) ->
  if n >= 3 || i >= str_len s then (acc, i)
  else
    let c = char_at s i in
    if c >= "0" && c <= "7" then scan_octal s (i + 1) (acc * 8 + (ord c - 48)) (n + 1)
    else (acc, i)

// index of the closing double-quote of a string body starting at i.
and dq_str_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\\" && i + 1 < str_len s then dq_str_end s (i + 2)
  else if str_eq (char_at s i) "\"" then i
  else dq_str_end s (i + 1)

// unescape the common backslash escapes in a plain quoted symbol body.
and dq_unescape = fn (body: str) -> fn (i: int) ->
  if i >= str_len body then ""
  else
    let c = char_at body i in
    if str_eq c "\\" && i + 1 < str_len body then
      let e = char_at body (i + 1) in
      let piece = (if str_eq e "n" then "\n" else if str_eq e "t" then "\t" else e) in
      piece ++ dq_unescape body (i + 2)
    else c ++ dq_unescape body (i + 1)

and is_hex_digit = fn (c: str) ->
  (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
and hex_val = fn (c: str) ->
  if c >= "0" && c <= "9" then ord c - 48
  else if c >= "a" && c <= "f" then ord c - 87
  else if c >= "A" && c <= "F" then ord c - 55
  else 0

// ---- what encoding is a REGEXP pattern in? --------------------------------
// A pattern carries an encoding when its source names a non-ASCII character --
// and it can name one in three ways. A raw byte above 127 is one; so is an
// escape that spells the same character in pure ASCII: `/\u{3042}/` and
// `/\xe3/` are UTF-8 patterns whose SOURCE is entirely 7-bit, while
// `/\u{41}/` and `/\x41/` are US-ASCII. Looking only at the raw bytes made
// every escaped pattern US-ASCII, and the encoding is not a label here: it
// decides #fixed_encoding? and what #source answers.
and rx_hex_run_ge80 = fn (p: str) -> fn (i: int) -> fn (acc: int) -> fn (any: bool) ->
  if i < str_len p && is_hex_digit (char_at p i) then
    rx_hex_run_ge80 p (i + 1) (acc * 16 + hex_val (char_at p i)) true
  else (if any && acc >= 128 then true else false)
and rx_u_esc_ge80 = fn (p: str) -> fn (i: int) ->
  // `\uXXXX` or `\u{X X ...}`: any codepoint in it decides
  // (the brace is escaped: a bare "{" in a Mere string starts interpolation)
  if i < str_len p && str_eq (char_at p i) "\{" then rx_u_braced_ge80 p (i + 1)
  else rx_hex_run_ge80 p i 0 false
and rx_u_braced_ge80 = fn (p: str) -> fn (i: int) ->
  if i >= str_len p || str_eq (char_at p i) "}" then false
  else if is_hex_digit (char_at p i) then
    (if rx_hex_run_ge80 p i 0 false then true else rx_u_braced_ge80 p (i + 1))
  else rx_u_braced_ge80 p (i + 1)
and rx_src_nonascii = fn (p: str) -> fn (i: int) ->
  if i >= str_len p then false
  else if ord (char_at p i) >= 128 then true
  else if str_eq (char_at p i) "\\" && i + 1 < str_len p then
    (let c9 = char_at p (i + 1) in
     if str_eq c9 "u" then
       (if rx_u_esc_ge80 p (i + 2) then true else rx_src_nonascii p (i + 2))
     else if str_eq c9 "x" then
       (if rx_hex_run_ge80 p (i + 2) 0 false then true else rx_src_nonascii p (i + 2))
     // any other escape covers exactly one character; step over both
     else rx_src_nonascii p (i + 2))
  else rx_src_nonascii p (i + 1)
// The one rule, so #encoding, #fixed_encoding? and #source cannot disagree:
// an explicit modifier names the encoding outright, `/n` means BYTES, and
// otherwise a pattern that names a non-ASCII character is in the script's
// encoding. `fixed_encoding?` is exactly "the answer is not US-ASCII".
// What Regexp.union's arguments say about the union's encoding, and whether
// they contradict each other. THREE accumulators, not one, and they are
// re-checked after EVERY argument rather than at the end:
//
//   asciionly  some argument yields -- ASCII-only text in an ascii-compatible
//              encoding, or a Regexp that does not fix one
//   inc        an argument in an ASCII-INCOMPATIBLE encoding (UTF-16/32)
//   fix        an argument that FIXES an ascii-compatible encoding: a
//              fixed_encoding? Regexp, or a String carrying a non-ASCII byte
//
// Two arguments landing in the same accumulator with different encodings is
// "incompatible encodings: A and B", naming the one already accumulated first.
// An ASCII-incompatible argument beside anything else is a refusal too, and
// WHICH refusal depends on what the other side was: "ASCII incompatible
// encoding: X" against a yielding argument, "incompatible encodings: X and Y"
// against one that fixes. Answers ("", "", "") when nothing is contradicted;
// the third element is the message, "" for none.
and rx_union_scan = fn (xs: Val list) -> fn (asciionly: bool) -> fn (inc: str) -> fn (fix: str) ->
  match xs with
  | Nil -> (inc, fix, "")
  | Cons (h9, t9) ->
    (let (e9, fixes9) =
       (match h9 with
        // a Regexp fixes its encoding exactly when that encoding is not
        // US-ASCII -- which is what #fixed_encoding? answers (see rx_enc_name).
        | VRegex (p9, f9, ev9) ->
          (let n9 = rx_enc_name p9 f9 ev9 in
           (n9, str_contains f9 "u" || (if str_eq n9 "US-ASCII" then false else true)))
        | VStr s9 -> (let n9 = enc_canon_name (senc_get s9) in (n9, (if enc_all7 (sget s9) then false else true)))
        | VSym s9 -> (let n9 = enc_canon_name (sym_enc_name s9) in (n9, (if enc_all7 s9 then false else true)))
        | _ -> ("US-ASCII", false)) in
     let incompat9 = (if enc_ascii_compat e9 then false else true) in
     let (ao2, inc2, fix2, err2) =
       (if incompat9 then
          (if str_eq inc "" then (asciionly, e9, fix, "")
           else if str_eq inc e9 then (asciionly, inc, fix, "")
           else (asciionly, inc, fix, "incompatible encodings: " ++ inc ++ " and " ++ e9))
        else if fixes9 then
          (if str_eq fix "" then (asciionly, inc, e9, "")
           else if str_eq fix e9 then (asciionly, inc, fix, "")
           else (asciionly, inc, fix, "incompatible encodings: " ++ fix ++ " and " ++ e9))
        else (true, inc, fix, "")) in
     if (if str_eq err2 "" then false else true) then (inc2, fix2, err2)
     else if (if str_eq inc2 "" then false else true) && ao2 then
       (inc2, fix2, "ASCII incompatible encoding: " ++ inc2)
     else if (if str_eq inc2 "" then false else true) && (if str_eq fix2 "" then false else true) then
       (inc2, fix2, "incompatible encodings: " ++ inc2 ++ " and " ++ fix2)
     else rx_union_scan t9 ao2 inc2 fix2)
// What ONE value contributes, read off the same scan: the ASCII-incompatible
// encoding if it is in one, else the ascii-compatible encoding it fixes, else
// "" for an argument that yields. Regexp.new and the `/#{...}/` desugaring ask
// this about their single source string, so they cannot drift from union.
and rx_one_enc = fn (v: Val) ->
  (match rx_union_scan (Cons (v, Nil)) false "" "" with
   | (inc9, fix9, _) -> (if str_eq inc9 "" then fix9 else inc9))
and rx_alts_binary = fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (VStr h9, t9) ->
    (if str_eq (enc_canon_name (senc_get h9)) "ASCII-8BIT" then true else rx_alts_binary t9)
  // ⚠ ...and a REGEXP argument carries an encoding too. `Regexp.union` over
  // patterns rather than strings only looked at the strings, so a union with
  // `/[\x80-\xBF]/n` in it -- a BINARY pattern -- came out UTF-8 whatever
  // order the arguments were written in.
  | Cons (VRegex (p9, f9, ev9), t9) ->
    (if str_eq (rx_enc_name p9 f9 ev9) "ASCII-8BIT" then true else rx_alts_binary t9)
  | Cons (_, t9) -> rx_alts_binary t9
and rx_enc_name = fn (p: str) -> fn (fl: str) -> fn (e: str) ->
  // ⚠ The encoding the VALUE carries wins over anything derivable. `u` alone
  // carries two different claims -- as a literal modifier (`/x/u`) it names
  // UTF-8, as Regexp::FIXEDENCODING it says "keep the SOURCE STRING's
  // encoding", which is whatever that string had. Only the builder that read
  // that string knows which, so it says so in the value rather than in a table
  // keyed by (source, flags), which cannot tell two such patterns apart.
  if (if str_eq e "" then false else true) then e
  else if str_contains fl "u" then "UTF-8"
  else if str_contains fl "e" then "EUC-JP"
  else if str_contains fl "s" then "Windows-31J"
  else if str_contains fl "n" then (if rx_src_nonascii p 0 then "ASCII-8BIT" else "US-ASCII")
  else if rx_src_nonascii p 0 then "UTF-8"
  else "US-ASCII"

and hex4 = fn (s: str) -> fn (i: int) ->
  hexv (char_at s i) * 4096 + hexv (char_at s (i + 1)) * 256 +
  hexv (char_at s (i + 2)) * 16 + hexv (char_at s (i + 3))

// UTF-8 for one codepoint. This is the lexer's copy (utf8_enc, further down, is
// the runtime's) and it had no FOUR-byte branch: every codepoint above U+FFFF
// went through the three-byte arithmetic and overflowed, so `"\u{1F600}"` lexed
// to [255, 152, 128] rather than [240, 159, 152, 128] -- wrong bytes, quietly.
// The same emoji written literally in the source was always fine, which is what
// hid it: the two paths do not share an encoder.
and utf8_of = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + (cp - cp / 64 * 64))
  else if cp < 65536 then chr (224 + cp / 4096) ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))
  else chr (240 + cp / 262144) ++ chr (128 + (cp / 4096 - cp / 262144 * 64))
       ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))

// heredoc body as token(s): interpolated bodies route through the
// double-quoted string lexer.
and heredoc_tok = fn (body0: str) ->
  // An interpolating heredoc is a double-quoted string: `\\` is one
  // backslash, `\t` is a tab. Both forms therefore go through the string
  // lexer -- emitting the body raw when it happened to contain no `#{}` left
  // its escapes unprocessed, and rubocop's compiler writes `end \\` into
  // generated code, which came out as two backslashes and would not lex.
  let body = hd_line_cont body0 0 in
  tapp (Cons (TP "(s", drop_eof (lex_go ("\"" ++ hd_escape_dq body 0 ++ "\"") 0))) (Cons (TP ")", Nil))

// quote a heredoc body so the string lexer sees exactly it: an interpolation
// is code and is copied whole, an escape pair is copied whole (the lexer
// processes it), and a bare `"` is escaped so it does not end the literal.
and hd_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      (let j = interp_close lit (i + 2) 1 in substring lit i j ++ hd_escape_dq lit j)
    else if str_eq c "\\" && i + 1 < str_len lit then
      (c ++ char_at lit (i + 1)) ++ hd_escape_dq lit (i + 2)
    else if str_eq c "\"" then "\\\"" ++ hd_escape_dq lit (i + 1)
    else c ++ hd_escape_dq lit (i + 1)

// backslash-newline in an interpolating heredoc is a line continuation
// (dropped); an escaped backslash stays.
and hd_line_cont = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (if str_eq (char_at s (i + 1)) "\n" then hd_line_cont s (i + 2)
       else c ++ char_at s (i + 1) ++ hd_line_cont s (i + 2))
    else c ++ hd_line_cont s (i + 1)

and find_nl = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else find_nl s (i + 1)

// collect heredoc lines from `i` until the terminator line; returns
// (body, index-after-terminator-line). squiggly strips the common indent.
and heredoc_body = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (squiggly: bool) ->
  let (lines, after) = heredoc_lines s i hid Nil in
  let body = if squiggly then hd_join (hd_strip lines (hd_min_indent lines 9999)) else hd_join lines in
  (body, after)

and heredoc_lines = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (acc: str list) ->
  if i >= str_len s then (rev_app_str acc Nil, i)
  else
    let nl = find_nl s i in
    let line = substring s i nl in
    if str_eq (hd_lstrip line) hid then (rev_app_str acc Nil, if nl < str_len s then nl + 1 else nl)
    else heredoc_lines s (if nl < str_len s then nl + 1 else nl) hid (Cons (line, acc))

and rev_app_str = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_app_str t (Cons (h, acc))

and hd_lstrip = fn (line: str) ->
  if str_len line > 0 && (str_eq (char_at line 0) " " || str_eq (char_at line 0) "\t")
  then hd_lstrip (substring line 1 (str_len line)) else line

and hd_indent_of = fn (line: str) -> fn (n: int) ->
  if n < str_len line && str_eq (char_at line n) " " then hd_indent_of line (n + 1) else n

and hd_min_indent = fn (lines: str list) -> fn (best: int) ->
  match lines with
  | Nil -> best
  | Cons (l, r) ->
    if str_eq (hd_lstrip l) "" then hd_min_indent r best
    else let ind = hd_indent_of l 0 in hd_min_indent r (if ind < best then ind else best)

and hd_strip = fn (lines: str list) -> fn (n: int) ->
  match lines with
  | Nil -> Nil
  | Cons (l, r) ->
    let l2 = if str_len l >= n then substring l n (str_len l) else "" in
    Cons (l2, hd_strip r n)

and hd_join = fn (lines: str list) ->
  match lines with Nil -> "" | Cons (l, r) -> l ++ "\n" ++ hd_join r

// the one-character globals: $& $` $' $+ $~ $! $@ $/ $\\ $, $; $. $< $> $_ $* $$ $? $: $0-9
and is_gvar_punct = fn (c: str) ->
  str_eq c "&" || str_eq c "`" || str_eq c "'" || str_eq c "+" || str_eq c "~" ||
  str_eq c "!" || str_eq c "@" || str_eq c "/" || str_eq c "," || str_eq c ";" ||
  str_eq c "." || str_eq c "<" || str_eq c ">" || str_eq c "_" || str_eq c "*" ||
  str_eq c "$" || str_eq c "?" || str_eq c ":" || str_eq c "\"" ||
  str_eq c "\\" || str_eq c "=" || is_digit c

// scan the longest operator name after a `:` (3, then 2, then 1 chars; []=
// and [] as special cases).
and is_op_sym_start = fn (c: str) ->
  str_eq c "|" ||
  map_has (name_set "is_op_sym_start") c
and scan_op_sym = fn (s: str) -> fn (i: int) ->
  let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
  let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
  if str_eq three "===" || str_eq three "<=>" || str_eq three "[]=" || str_eq three "**=" then (three, i + 3)
  else if str_eq two "==" || str_eq two "!=" || str_eq two "<=" || str_eq two ">=" ||
          str_eq two "<<" || str_eq two ">>" || str_eq two "**" || str_eq two "[]" ||
          // `:=~` and `:!~` are both method names (rubocop lists them in a
          // node pattern); only :~@ / :!@ fold to :~ and :!.
          str_eq two "=~" || str_eq two "!~" ||
          // the unary method names :-@ and :+@ (`-@` is what `''.respond_to?`
          // is asked about to see whether a String can be frozen-deduped).
          // `:~@` / `:!@` are NOT here: Ruby folds those to :~ and :!.
          str_eq two "-@" || str_eq two "+@" then (two, i + 2)
  else (substring s i (i + 1), i + 1)

// split a scoped constant name at the LAST `::`: recv part and const name.
and scoped_split = fn (name: str) -> fn (i: int) -> fn (last: int) ->
  if i + 1 >= str_len name then last
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then scoped_split name (i + 2) i
  else scoped_split name (i + 1) last
and recv_of_scoped = fn (name: str) -> substring name 0 (scoped_split name 0 0)
and const_of_scoped = fn (name: str) -> substring name (scoped_split name 0 0 + 2) (str_len name)

// index of the FIRST `::` in a scoped name, or -1.
and first_colon2 = fn (name: str) -> fn (i: int) ->
  if i + 1 >= str_len name then (0 - 1)
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then i
  else first_colon2 name (i + 1)

// `module m::N` where the leftmost segment names a local variable holding a
// class/module: rewrite the name to that class's real name (m -> AnonModule_k)
// so the definition registers under it, not under the literal variable name.
and resolve_scoped_base = fn env -> fn (name: str) ->
  let i = first_colon2 name 0 in
  if i < 0 then name
  else
    let head = substring name 0 i in
    if lv_has env head then
      (match lv_get env head with VClass c -> c ++ "::" ++ substring name (i + 2) (str_len name) | _ -> name)
    else name

and rx_has_interp = fn (lit: str) -> fn (i: int) ->
  if i + 1 >= str_len lit then false
  // escapes take precedence over interpolation: \#{ is a literal #, and the
  // control escapes \c? / \C-? consume the char after them (so /\c#{s}/ has
  // NO interpolation — the # is the control character's argument).
  else if str_eq (char_at lit i) "\\" then
    (let e = (if i + 1 < str_len lit then char_at lit (i + 1) else "") in
     if str_eq e "c" then rx_has_interp lit (i + 3)
     else if str_eq e "C" then rx_has_interp lit (i + 4)
     else rx_has_interp lit (i + 2))
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "\{" then true
  else rx_has_interp lit (i + 1)

// rebuild the regex body as double-quoted-string SOURCE so the normal
// interpolation lexer produces the concat tokens.
and rx_interp_src = fn (lit: str) ->
  "\"" ++ rx_escape_dq lit 0 ++ "\""

and rx_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    // an interpolation is code: copy it verbatim (its own quotes/escapes
    // must reach the code lexer untouched).
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      let j = interp_close lit (i + 2) 1 in
      substring lit i j ++ rx_escape_dq lit j
    else if str_eq c "\"" then "\\\"" ++ rx_escape_dq lit (i + 1)
    else if str_eq c "\\" && i + 1 < str_len lit then
      // keep regex escapes as-is through the string lexer: the backslash is
      // doubled, and so is what follows it when THAT is a backslash (or a
      // quote) -- `\\` in a pattern is a literal backslash and has to survive
      // as two characters, not one.
      (let nx = char_at lit (i + 1) in
       "\\\\" ++ (if str_eq nx "\\" then "\\\\" else if str_eq nx "\"" then "\\\"" else nx)
       ++ rx_escape_dq lit (i + 2))
    else c ++ rx_escape_dq lit (i + 1)

// ...and the same rebuild for a %Q STRING, where a backslash escape must be
// PROCESSED rather than preserved: rx_escape_dq doubles it so the pattern
// keeps it (`%r?\??` is the regex /\?/), which is right for a regex and wrong
// for a string -- `%Q{a#{x}b\nc}` came out with a literal backslash-n while
// the same body without interpolation (and a plain "..." string) gave a
// newline. One builder, two languages.
and sq_interp_src = fn (lit: str) ->
  "\"" ++ sq_escape_dq lit 0 ++ "\""

and sq_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      (let j = interp_close lit (i + 2) 1 in
       substring lit i j ++ sq_escape_dq lit j)
    else if str_eq c "\"" then "\\\"" ++ sq_escape_dq lit (i + 1)
    // a backslash escape is handed to the string lexer AS IT IS, so the lexer
    // resolves it exactly as it would inside "..." .
    else if str_eq c "\\" && i + 1 < str_len lit then
      substring lit i (i + 2) ++ sq_escape_dq lit (i + 2)
    else c ++ sq_escape_dq lit (i + 1)

// index just past the `}` closing an interpolation (brace depth counting).
and interp_close = fn (lit: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len lit then i
  else if str_eq (char_at lit i) "\{" then interp_close lit (i + 1) (depth + 1)
  else if str_eq (char_at lit i) "}" then
    (if depth == 1 then i + 1 else interp_close lit (i + 1) (depth - 1))
  else interp_close lit (i + 1) depth

// `?x` at s[i]: a character literal, or the "?" of a ternary? Whitespace after
// the "?" is always a ternary. A word character starts a literal only when
// nothing identifier-ish follows, so `cond ?abc : def` stays a ternary while
// `p ?a` is the one-character string. Any OTHER character (`?/`, `?,`, `?"`)
// starts a literal only where a value could start — the same test the lexer
// uses to tell a regex from a division — so `x > 3 ?"big":"small"` is still a
// ternary. `p ?/` needs the parens Ruby would want anyway: without a local
// variable table there is nothing here to tell a method call from a value.
and is_char_lit = fn (s: str) -> fn (i: int) ->
  let n = char_at s (i + 1) in
  if str_eq n " " || str_eq n "\n" || str_eq n "\t" || str_eq n "\r" then false
  else if str_eq n "\\" then true
  else if is_alnum n || str_eq n "_" then
    (if i + 2 >= str_len s then true
     else let n2 = char_at s (i + 2) in
          if is_alnum n2 || str_eq n2 "_" then false else true)
  else regex_position s i

// is the / at i in a value position (a regex) rather than a division?
and regex_position = fn (s: str) -> fn (i: int) ->
  let p = prev_nonspace s (i - 1) in
  if p < 0 then true
  else
    let c = char_at s p in
    if str_eq c "(" || str_eq c "," || str_eq c "=" || str_eq c "~" ||
       str_eq c "!" || str_eq c "|" || str_eq c "&" || str_eq c "\n" || str_eq c ";" ||
       // `=> /re/` in a hash literal, `x > /re/`: ruby reads a regex after `>` too
       str_eq c "<" || str_eq c ">" || str_eq c "[" || str_eq c "\{" ||
       // ternary branches: `c ? /re/ : /re/` — a `/` after `?` or `:` starts a regex.
       str_eq c "?" || str_eq c ":" ||
       // a range bound: `(//..//)` is a Range of two empty regexes, which is
       // how ruby's own specs name the type. It is the RANGE dot that says so
       // -- a single dot is a method call, and `7./(2)` is division.
       (str_eq c "." && p > 0 && str_eq (char_at s (p - 1)) ".") then true
    else if is_alpha c then
      // after a keyword (when /re/, match =~ style) it's a regex too.
      let w = word_ending_at s p in
      str_eq w "when" || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
      str_eq w "then" || str_eq w "return" || str_eq w "if" || str_eq w "unless" ||
      // every keyword a CONDITION can follow, not just `if` -- rubocop writes
      // `elsif /\A[ \t]+\z/.match?(x)`, and a `/` there is a regex, not a
      // division.
      str_eq w "elsif" || str_eq w "while" || str_eq w "until" || str_eq w "case" ||
      str_eq w "yield" || str_eq w "break" || str_eq w "next" || str_eq w "raise" ||
      str_eq w "puts" || str_eq w "p" ||
      // `in /re/` — a pattern-matching clause takes a regex value pattern.
      str_eq w "in"
    else false

and word_ending_at = fn (s: str) -> fn (p: int) ->
  let b = word_start s p in
  substring s b (p + 1)

and word_start = fn (s: str) -> fn (p: int) ->
  if p > 0 && (is_alnum (char_at s (p - 1)) || str_eq (char_at s (p - 1)) "_")
  then word_start s (p - 1) else p

// the first index of the identifier that ends at p.
and word_start_at = fn (s: str) -> fn (p: int) ->
  if p <= 0 then 0
  else (let c = char_at s (p - 1) in
        if is_alnum c || str_eq c "_" then word_start_at s (p - 1) else p)

// skip from `=begin` to just past the line holding its `=end` (both at
// column 0, as Ruby requires).
and skip_block_comment = fn (s: str) -> fn (i: int) ->
  let e = block_comment_end s i in
  if e < 0 then str_len s else e
and block_comment_end = fn (s: str) -> fn (i: int) ->
  let ln = bc_line_end s i in
  if ln >= str_len s then 0 - 1
  else if ln + 4 <= str_len s && str_eq (substring s ln (ln + 4)) "=end" then bc_line_end s ln
  else block_comment_end s ln
// the index just past the newline that ends the line starting at i.
and bc_line_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then str_len s
  else if str_eq (char_at s i) "\n" then i + 1
  else bc_line_end s (i + 1)

and prev_nonspace = fn (s: str) -> fn (i: int) ->
  if i < 0 then 0 - 1
  else if str_eq (char_at s i) " " then prev_nonspace s (i - 1)
  else i

and is_lparen = fn (p: str) -> str_eq p "(" || str_eq p " ("
// the tokens AFTER a leading parenthesised group, for a statement-leading name
// that has to know whether its call is being CHAINED. `require_relative(p)` is
// the statement form; `require_relative(p).should == true` is an ordinary
// expression whose value is chained, and reading the second as the first made
// the whole chain the require's argument -- so the file it tried to load was
// named after the method called on the result. Depth-counted, so a nested call
// in the arguments does not end the scan early.
and after_parens = fn toks ->
  match toks with
  | Cons (TP lp, r) -> (if is_lparen lp then after_parens_go r 1 else toks)
  | _ -> toks
and after_parens_go = fn toks -> fn (d: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TEOF, _) -> toks
  | Cons (TP p9, r) ->
    // ⚠ "(s" opens too -- it is the token an interpolating string becomes, and
    //   it is closed by the same ")". Counting only "(" made
    //   `require_relative("#{dir}/f.rb").should` end its scan at the string's
    //   own closer, so the chain after it was never seen.
    (if is_lparen p9 || str_eq p9 "(s" then after_parens_go r (d + 1)
     else if str_eq p9 ")" then (if d <= 1 then r else after_parens_go r (d - 1))
     else after_parens_go r d)
  | Cons (_, r) -> after_parens_go r d
and tok_chains = fn toks ->
  match toks with
  | Cons (TP p9, _) -> str_eq p9 "." || str_eq p9 "&." || str_eq p9 "::" || str_eq p9 "["
  | _ -> false

// scan the regex body to the closing unescaped /, returning the trailing
// flags ("im"...) alongside the body and the resume position.
and scan_regex = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated regex" ++ parsing_file ()))) in fail ("mere-ruby: unterminated regex" ++ parsing_file ()))
  else
    let c = char_at s i in
    // `\/` escapes the DELIMITER, and ruby keeps only the slash in the
    // source -- `/a\/b/.source` is "a/b". Every other escape survives whole
    // (the pattern needs it). Getting this wrong shifts every backslash that
    // follows, which is how rubocop-ast's REGEXP pattern came out malformed.
    if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "/" then
      scan_regex s (i + 2) (acc ++ "/")
    else if str_eq c "\\" && i + 1 < str_len s then scan_regex s (i + 2) (acc ++ c ++ char_at s (i + 1))
    // a #{...} interpolation is copied whole — its content may contain `/`
    // (even a nested regex literal, /#{/./}/), which must not close ours.
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      (let close = find_close_brace s (i + 2) 0 in
       scan_regex s (close + 1) (acc ++ substring s i (close + 1)))
    else if str_eq c "/" then
      (let fj = skip_regex_flags s (i + 1) in
       (acc, substring s (i + 1) fj, fj))
    else scan_regex s (i + 1) (acc ++ c)

and skip_regex_flags = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alpha (char_at s i) then
    (let c = char_at s i in
     if str_eq c "i" || str_eq c "m" || str_eq c "x" || str_eq c "o" ||
        str_eq c "u" || str_eq c "n" || str_eq c "s" || str_eq c "e"
     then skip_regex_flags s (i + 1)
     else (let __fm = ("mere-ruby: unknown regexp option - " ++ c) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm))
  else i;

// ---- parser (precedence climbing) ---------------------------------------
let is_keyword = fn (id: str) ->
  str_eq id "puts" || str_eq id "if" || str_eq id "unless" ||
  str_eq id "elsif" || str_eq id "else" || str_eq id "end" ||
  str_eq id "while" || str_eq id "until" || str_eq id "case" ||
  str_eq id "when" || str_eq id "then" || str_eq id "do" ||
  str_eq id "def" || str_eq id "return" || str_eq id "class" ||
  str_eq id "module" ||
  str_eq id "self" || str_eq id "yield" ||
  str_eq id "begin" || str_eq id "rescue" || str_eq id "ensure" ||
  str_eq id "raise" || str_eq id "break" || str_eq id "next" ||
  str_eq id "true" || str_eq id "false" || str_eq id "nil";

// a capitalized bare identifier is a constant (a class reference here).
let is_cap = fn (id: str) ->
  let o = ord (char_at id 0) in o >= 65 && o <= 90;

// an @-prefixed identifier is an instance variable.
let is_ivar = fn (id: str) -> str_len id > 0 && str_eq (char_at id 0) "@";

// keywords that close (or continue) an enclosing block: statement lists
// stop before them without consuming.
let is_block_stop = fn (id: str) ->
  str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
  str_eq id "rescue" || str_eq id "ensure" ||
  // `in` starts the next clause of a case/in; it never begins a statement.
  str_eq id "in";

// keywords that end an optional value (for break/next/return): block
// closers plus trailing statement modifiers (`next if c`, `break unless c`).
let stops_value = fn (id: str) ->
  is_block_stop id || str_eq id "if" || str_eq id "unless" ||
  str_eq id "while" || str_eq id "until";

// op-assign token -> the base operator (`+=` -> `+`), or "" if not one.
// an attribute-writer method name: ends in '=' but is not ==, !=, <=, >=.
let is_setter_name = fn (name: str) ->
  str_len name > 1 && str_eq (char_at name (str_len name - 1)) "=" &&
  // ...the comparison operators are not writers, `===` included: it was
  // missing here, so `x.===(y)` was an attribute assignment to `x.==` and
  // answered the ARGUMENT (assignment's value) instead of the comparison.
  // Every `===` in ruby/spec's method form went that way.
  (if (str_len name == 2 && str_eq name "==") || (str_len name == 3 && str_eq name "===") || (str_len name == 2 && str_eq name "!=") || (str_len name == 2 && str_eq name "<=") || (str_len name == 2 && str_eq name ">=") then false else true);

let opassign_base = fn (p: str) ->
  if str_eq p "+=" then "+" else if str_eq p "-=" then "-"
  else if str_eq p "*=" then "*" else if str_eq p "/=" then "/"
  else if str_eq p "%=" then "%" else if str_eq p "**=" then "**"
  else if str_eq p "<<=" then "<<" else if str_eq p ">>=" then ">>"
  else if str_eq p "||=" then "||"
  else if str_eq p "&&=" then "&&"
  else if str_eq p "|=" then "|" else if str_eq p "&=" then "&"
  else if str_eq p "^=" then "^" else "";

// Binary precedence, Ruby's order (subset). 0 = not a binary operator.
// ** is handled separately (tighter than unary minus on its left, so
// -2**2 == -(2**2) == -4, and right-associative: 2**3**2 == 512).
// binary operator precedence (higher binds tighter), matching Ruby:
// || < && < equality < comparison < | ^ < & < shift < +- < */% < **
let prec_of = fn (op: str) ->
  if str_eq op "||" then 1
  else if str_eq op "&&" then 2
  else if str_eq op "==" || str_eq op "!=" || str_eq op "<=>" || str_eq op "===" then 3
  else if str_eq op "=~" || str_eq op "!~" then 3
  else if str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=" then 4
  else if str_eq op "|" || str_eq op "^" then 5
  else if str_eq op "&" then 6
  else if str_eq op "<<" || str_eq op ">>" then 7
  else if str_eq op "+" || str_eq op "-" then 8
  else if str_eq op "*" || str_eq op "/" || str_eq op "%" then 9
  else if str_eq op "**" then 10
  else 0;

let expect = fn toks -> fn (want: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p want then r else (let __fm = ("mere-ruby: expected " ++ want ++ ", got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: expected " ++ want ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);

// pure token helpers, defined before the parser group so both the
// expression and statement parsers (one merged group) can use them.
let expect_end = fn toks ->
  match toks with
  | Cons (TNL _, r) -> (let _ = parse_line_add 1 in r)
  | Cons (TEOF, _) -> toks
  // a statement may also be terminated by a block-closing keyword on the
  // same line (e.g. `def m() 1 end`), left unconsumed for the caller.
  | Cons (TId id, _) ->
    if str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
       str_eq id "rescue" || str_eq id "ensure"
    then toks else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected end of statement" ++ parsing_file ()))) in fail ("mere-ruby: expected end of statement" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected end of statement" ++ parsing_file ()))) in fail ("mere-ruby: expected end of statement" ++ parsing_file ()));

let expect_kw = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id kw then r
    else (let __fm = ("mere-ruby: expected " ++ kw ++ ", got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: expected " ++ kw ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);

// optional `then` (after if/elsif/when conditions) or `do` (after
// while/until conditions) before the newline.
let skip_then = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "then" || str_eq id "do" then r else toks
  // `if cond;\n then body` — a `then` after a newline is still redundant.
  | Cons (TNL _, r) ->
    (match r with
     | Cons (TId id, r2) -> if str_eq id "then" then r2 else toks
     | _ -> toks)
  | _ -> toks;

let rec skip_nls = fn toks ->
  match toks with Cons (TNL _, r) -> skip_nls r | _ -> toks;

// the same, reporting how many newlines it passed: the statement loop keeps
// the line counter with this, and no other caller cares.
let rec skip_nls_n = fn toks -> fn (k: int) ->
  match toks with Cons (TNL _, r) -> skip_nls_n r (k + 1) | _ -> (toks, k);

// how many newline tokens this stream holds (once per file, to clamp the
// running count -- never per statement)
// Turn each TNL's byte offset into the 1-based line it ends. One pass: the
// offsets increase along the stream, so the source is scanned once and never
// re-scanned. Everything downstream (`__LINE__`, and the line an error names)
// reads the number rather than counting newlines again, which is what made the
// old count an upper bound -- the parser backtracks, and a re-scanned block body
// was counted twice.
let rec nl_count_to = fn (s: str) -> fn (i: int) -> fn (stop: int) -> fn (acc: int) ->
  if i >= stop || i >= str_len s then acc
  else nl_count_to s (i + 1) stop (if str_eq (char_at s i) "\n" then acc + 1 else acc);
let rec number_nls_go = fn (s: str) -> fn toks -> fn (off: int) -> fn (line: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TNL o, r) ->
    // a `;` sits on the line it ends, so counting the newlines between the last
    // mark and this offset is right for both
    let ln = line + nl_count_to s off o 0 in
    Cons (TNL ln, number_nls_go s r (if o > off then o else off) ln)
  | Cons (t, r) -> Cons (t, number_nls_go s r off line);
// `eval(code, binding, file, line)` says the code's FIRST line is `line`, so
// every line in it is `line + k - 1` -- an OFFSET, not a constant. Numbering the
// tokens from that base is the one place the offset belongs: SLine markers are
// emitted by the generic statement-list parser at EVERY nesting depth, so
// shifting them afterwards would mean walking the whole Stmt tree, and shifting
// `cur_pos` at execution time would also shift the lines of code that the eval
// merely CALLS. Numbering at the source makes `__LINE__`, a nested `def`'s
// #source_location, and an error's reported line all absolute for free.
// ⚠ ...and a source that does not END with a newline has no final mark, so
//   every token on its last line reads as line 0 -- `tok_line` walks FORWARD
//   to the next TNL and answers 0 when it reaches the end instead. A FILE
//   almost always ends with a newline and so never showed it; an eval string
//   usually does not, which is why `eval("__LINE__", nil, "f.rb", 7)` was 0
//   and not 7. The mark the source is missing is added here, once, where the
//   base is known -- rather than teaching tok_line's two callers a fallback
//   they have no way to compute.
let rec tnl_before_eof = fn toks -> fn (ln: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TEOF, r) -> Cons (TNL ln, Cons (TEOF, r))
  | Cons (t, r) -> Cons (t, tnl_before_eof r ln);
let number_nls_at = fn (s: str) -> fn toks -> fn (base: int) ->
  let numbered = number_nls_go s toks 0 base in
  if str_len s == 0 || str_eq (char_at s (str_len s - 1)) "\n" then numbered
  else tnl_before_eof numbered (base + nl_count_to s 0 (str_len s) 0);
let number_nls = fn (s: str) -> fn toks -> number_nls_at s toks 1;
// the line a token sits on: the next newline mark in the stream ends its line
let rec tok_line = fn toks ->
  match toks with
  | Cons (TNL n, _) -> n
  | Cons (TEOF, _) -> 0
  | Cons (_, r) -> tok_line r
  | Nil -> 0;
let rec count_nls = fn toks ->
  match toks with
  | Nil -> 0
  | Cons (TNL _, r) -> 1 + count_nls r
  | Cons (_, r) -> count_nls r;




// A symbol token whose name is not identifier-shaped can only have been
// written in quoted form (`:'"'`), and inside a ternary that is the colon plus
// a string rather than a symbol.
let sym_looks_quoted = fn (sy: str) ->
  if str_len sy == 0 then true
  else (let c = char_at sy 0 in
        if is_alpha c || str_eq c "_" || str_eq c "@" || str_eq c "$" then false else true);

// a range `lo..hi` / `lo...hi` sits above the binary operators (very low
// precedence in Ruby).
// The names a `def` may carry after a dot that the lexer hands back as
// punctuation rather than as an identifier. (is_binary_op_name lives in the
// evaluator's group, which the parser cannot see.)
let def_op_name = fn (s: str) ->
  str_eq s "==" || str_eq s "!=" || str_eq s "===" || str_eq s "=~" || str_eq s "!~" ||
  str_eq s "<=>" || str_eq s "<" || str_eq s "<=" || str_eq s ">" || str_eq s ">=" ||
  str_eq s "+" || str_eq s "-" || str_eq s "*" || str_eq s "/" || str_eq s "%" ||
  str_eq s "**" || str_eq s "<<" || str_eq s ">>" || str_eq s "&" || str_eq s "|" ||
  str_eq s "^" || str_eq s "~" || str_eq s "!" || str_eq s "[]" || str_eq s "[]=" ||
  str_eq s "+@" || str_eq s "-@";

let rec parse_expr = fn toks ->
  let (cond, r) = parse_range toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op "?" then
      let (then_e, r2) = parse_expr (skip_nls rest) in
      // Inside a ternary, a `:` that the lexer read as the start of a QUOTED
      // symbol is the ternary's colon and a string: rexml writes
      // `x.include?('"')?"'":'"'` with no spaces, where `:'"'` is a colon and
      // the one-character string. Ruby resolves it the same way, from context.
      let r2 = (match r2 with
                | Cons (TSym sy, r2b) ->
                  if sym_looks_quoted sy then Cons (TP ":", Cons (TStrL sy, r2b)) else r2
                | _ -> r2) in
      (match r2 with
       | Cons (TP colon, r3) ->
         if str_eq colon ":" then let (else_e, r4) = parse_expr (skip_nls r3) in (ETern (cond, then_e, else_e), r4)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected : in ternary" ++ parsing_file ()))) in fail ("mere-ruby: expected : in ternary" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected : in ternary" ++ parsing_file ()))) in fail ("mere-ruby: expected : in ternary" ++ parsing_file ())))
    else (cond, r)
  | _ -> (cond, r)

and list_append_str = fn (xs: str list) -> fn (ys: str list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_str t ys)

and eapp = fn (xs: Expr list) -> fn (ys: Expr list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, eapp t ys)

// bare lambda params: `-> x, y { ... }` (up to the block opener).
// if the LAST default expr is a call that captured a block, strip the
// block off and hand it back (it was really the lambda's body).
and last_default_block = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> (false, (Nil : (str * Expr) list), (Nil : str list), (Nil : Stmt list))
  | Cons ((n, d), Nil) ->
    (match d with
     | ECallB (cn, cargs, cbp, cbb) ->
       (true, Cons ((n, ECall (cn, cargs)), Nil), cbp, cbb)
     | EMethodB (crecv, cn, cargs, cbp, cbb) ->
       (true, Cons ((n, EMethod (crecv, cn, cargs)), Nil), cbp, cbb)
     | _ -> (false, Cons ((n, d), Nil), Nil, Nil))
  | Cons (h, t) ->
    (match last_default_block t with
     | (ok, t2, sbp, sbb) -> (ok, Cons (h, t2), sbp, sbb))

and psplat_any = fn (ps: str list) ->
  match ps with
  | Nil -> false
  | Cons (p, r) -> (str_len p > 0 && str_eq (char_at p 0) "*") || psplat_any r

// the defaults for plain (non-keyword) names; kw defaults are keyed "k:".
// the KEYWORD defaults of a parameter list, keyed by the local name the body
// binds (`x:` binds `x`). A lambda literal built its nil-check prologue from
// plain_defaults only, so `->(x: 3){ x }.call` raised "missing keyword: :x" --
// the default was parsed and then thrown away, and #parameters reported the
// keyword as :keyreq.
and kw_defaults_bare = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> Nil
  | Cons ((n, d), r) ->
    if str_len n > 0 && str_eq (char_at n (str_len n - 1)) ":"
    then Cons ((substring n 0 (str_len n - 1), d), kw_defaults_bare r)
    else kw_defaults_bare r

and plain_defaults = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> Nil
  | Cons ((n, d), r) ->
    if str_len n > 0 && str_eq (char_at n (str_len n - 1)) ":" then plain_defaults r
    else Cons ((n, d), plain_defaults r)

and lambda_bare_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    // `-> a=default { ... }` — an optional bare parameter. The default
    // parses with brace-blocks off: the { belongs to the lambda body.
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let _ = map_set parser_flags "nobrace" VNil in
         let (d, r3) = parse_bin r2 6 in
         let _ = map_delete parser_flags "nobrace" in
         lambda_bare_after n r3 acc (Cons ((n, d), ds))
       // `-> x: 3 { }` -- a bare KEYWORD parameter, with or without a default.
       // The parenthesised form has read these all along; this one refused the
       // whole file with "expected block".
       else if str_eq eq ":" then
         (let kn = n ++ ":" in
          match r2 with
          | Cons (TP q, _) -> (if str_eq q "," then lambda_bare_after kn r2 acc ds
                               else if starts_block r2 then lambda_bare_after kn r2 acc ds
                               else (let _ = map_set parser_flags "nobrace" VNil in
                                     let (d, r3) = parse_bin r2 6 in
                                     let _ = map_delete parser_flags "nobrace" in
                                     lambda_bare_after kn r3 acc (Cons ((kn, d), ds))))
          | _ -> (let _ = map_set parser_flags "nobrace" VNil in
                  let (d, r3) = parse_bin r2 6 in
                  let _ = map_delete parser_flags "nobrace" in
                  lambda_bare_after kn r3 acc (Cons ((kn, d), ds))))
       else lambda_bare_after n r acc ds
     | _ -> lambda_bare_after n r acc ds)
  // `-> *args, **kwargs { ... }` — splat / kw-splat / block-pass params.
  | Cons (TP st, r) ->
    if str_eq st "*" || str_eq st "**" || str_eq st "&" then
      (match r with
       | Cons (TId n, r2) -> lambda_bare_after (st ++ n) r2 acc ds
       | _ -> lambda_bare_after st r acc ds)
    else (rev_app acc Nil, rev_app ds Nil, toks)
  | _ -> (rev_app acc Nil, rev_app ds Nil, toks)

and lambda_bare_after = fn (n: str) -> fn r -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match r with
  | Cons (TP c, r2) ->
    if str_eq c "," then lambda_bare_params r2 (Cons (n, acc)) ds
    else (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)

// the inside of ( ... ): an and/or expression, optionally with a trailing
// statement modifier — `(i += 1 until i > 9)` is a while-statement value.
// A leading break/next/return statement (with its modifier) also works:
// `(break 123 until false)`.
and paren_body = fn toks ->
  match skip_nls toks with
  | Cons (TId w, _) ->
    if str_eq w "break" || str_eq w "next" || str_eq w "return" then
      paren_seq (skip_nls toks) Nil
    // a statement keyword opens a statement sequence: (def f; end; 'f').
    else if str_eq w "def" || str_eq w "class" || str_eq w "module" ||
            str_eq w "begin" || str_eq w "while" || str_eq w "until" ||
            str_eq w "case" then
      paren_seq (skip_nls toks) Nil
    else paren_expr_body (skip_nls toks)
  | _ -> paren_expr_body (skip_nls toks)

and paren_expr_body = fn toks ->
  if looks_like_multix toks then
    let (s2, r2) = parse_multix toks in paren_after_stmt s2 r2
  else if looks_like_multi toks then
    let (s2, r2) = parse_multi toks in paren_after_stmt s2 r2
  else
  let (e, r2) = parse_andor toks in
  match r2 with
  // `(args = 1, 2, 3)` — an assignment's extra comma values build an array.
  | Cons (TP c0, r2b) ->
    if str_eq c0 "=>" then
      let (pat, r3) = parse_pattern_top r2b in (EMatchBind (e, pat), expect (skip_nls r3) ")")
    else if str_eq c0 "," then
      (match e with
       | EAssign (anm, v0) ->
         let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
         (EAssign (anm, EArr (Cons (v0, more))), expect (skip_nls r3) ")")
       // `(a[1, 2] = 4, 5)` / `(o.foo = 1, 2)` — the last setter argument
       // grows into an array of the comma values.
       | EMethod (recv, mn, margs) ->
         if str_eq mn "[]=" || (str_len mn > 0 && str_eq (char_at mn (str_len mn - 1)) "=") then
           let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
           (EMethod (recv, mn, grow_last_arg margs more), expect (skip_nls r3) ")")
         else (e, expect r2 ")")
       | _ -> (e, expect r2 ")"))
    else (e, expect r2 ")")
  | Cons (TId w, rrest) ->
    if str_eq w "in" then
      let (pat, r3) = parse_pattern_top rrest in (EMatchTest (e, pat), expect (skip_nls r3) ")")
    else if str_eq w "while" || str_eq w "until" || str_eq w "if" || str_eq w "unless" || str_eq w "rescue" then
      let (s2, r3) = apply_modifier (SExpr e) r2 in
      (match r3 with
       | Cons (TNL _, _) ->
         // `; more` after the modifier — continue the paren sequence.
         (match skip_nls r3 with
          | Cons (TP rp2, r4) ->
            if str_eq rp2 ")" then (EStmt s2, r4)
            else paren_seq (skip_nls r3) (Cons (s2, Nil))
          | _ -> paren_seq (skip_nls r3) (Cons (s2, Nil)))
       | _ -> (EStmt s2, expect r3 ")"))
    else (e, expect r2 ")")
  // `; more` — the paren holds a statement sequence; its value is the last.
  | Cons (TNL _, _) ->
    (match skip_nls r2 with
     | Cons (TP rp, r3) ->
       if str_eq rp ")" then (e, r3) else paren_seq (skip_nls r2) (Cons (SExpr e, Nil))
     | _ -> paren_seq (skip_nls r2) (Cons (SExpr e, Nil)))
  | _ -> (e, expect r2 ")")

// a multiple assignment inside a paren group: `)` ends it, but a `;` means it
// was only the first statement of a sequence --
// `until (parent, base = File.split(p); parent == p)` in fileutils.
and paren_after_stmt = fn (s2: Stmt) -> fn r2 ->
  (match skip_nls r2 with
   | Cons (TP rp, r3) -> if str_eq rp ")" then (EStmt s2, r3) else paren_seq (skip_nls r2) (Cons (s2, Nil))
   | _ -> paren_seq (skip_nls r2) (Cons (s2, Nil)))

and paren_seq = fn toks -> fn (acc: Stmt list) ->
  let (s0, r0) = parse_stmt toks in
  let (s1, r1) = apply_modifier s0 r0 in
  match r1 with
  | Cons (TP rp, r2) ->
    if str_eq rp ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r2)
    else (let __fm = ("mere-ruby: expected ) in paren sequence, got " ++ rp ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TNL _, _) ->
    (match skip_nls r1 with
     | Cons (TP rp2, r3) ->
       if str_eq rp2 ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r3)
       else paren_seq (skip_nls r1) (Cons (s1, acc))
     | _ -> paren_seq (skip_nls r1) (Cons (s1, acc)))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated paren sequence" ++ parsing_file ()))) in fail ("mere-ruby: unterminated paren sequence" ++ parsing_file ()))

// expr [and|or expr]* — the low-precedence word operators (paren context);
// `not expr` negates at the same low precedence.
and parse_andor = fn toks ->
  match toks with
  | Cons (TId w, r) ->
    if str_eq w "not" then let (e, r2) = parse_expr r in parse_andor_more (EUn ("!", e)) r2
    else let (e, r2) = parse_expr toks in parse_andor_more e r2
  | _ -> let (e, r) = parse_expr toks in parse_andor_more e r

and parse_andor_more = fn (lhs: Expr) -> fn toks ->
  match toks with
  // ruby 4.0: `and` / `or` at the start of the next line continues this one
  | Cons (TNL _, _) ->
    (let t2 = skip_nls toks in
     match t2 with
     | Cons (TId w, _) -> if str_eq w "and" || str_eq w "or" then parse_andor_more lhs t2 else (lhs, toks)
     | _ -> (lhs, toks))
  | Cons (TId w, r) ->
    // the right-hand side may continue on the next line (trailing `and` / `or`)
    if str_eq w "and" then let (rhs, r2) = parse_expr (skip_nls r) in parse_andor_more (EBin ("&&", lhs, rhs)) r2
    else if str_eq w "or" then let (rhs, r2) = parse_expr (skip_nls r) in parse_andor_more (EBin ("||", lhs, rhs)) r2
    else (lhs, toks)
  | _ -> (lhs, toks)

and parse_range = fn toks ->
  let (lo, r) = parse_bin toks 1 in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      // endless range: (1..) — no upper bound expression follows. Stops at a
      // closing punctuator, a newline/EOF, or a keyword that begins the next
      // clause (`then`/`do`/`if`/`unless`/`end`/`while`/`until`) — e.g. a
      // `when 90.. then` in a case expression.
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then
           (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       | Cons (TNL _, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TId g, _) ->
         if str_eq g "then" || str_eq g "do" || str_eq g "if" || str_eq g "unless" || str_eq g "end" || str_eq g "while" || str_eq g "until"
         then (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

and parse_bin = fn toks -> fn (minp: int) ->
  let (lhs, r) = parse_unary toks in
  parse_more lhs r minp

// the comparison/match operators are non-associative: `a == b == c` is a
// SyntaxError in Ruby (each can appear at most once per sub-expression).
and is_nonassoc_op = fn (op: str) ->
  str_eq op "==" || str_eq op "!=" || str_eq op "===" || str_eq op "<=>" ||
  str_eq op "=~" || str_eq op "!~"

and parse_more = fn (lhs: Expr) -> fn toks -> fn (minp: int) ->
  match toks with
  | Cons (TP op, rest) ->
    let p = prec_of op in
    if p > 0 && p >= minp then
      // the RHS may continue on the next line (trailing-operator style).
      let (rhs, r2) = parse_bin (skip_nls rest) (p + 1) in
      // reject chaining of a non-associative operator (`a == b == c`).
      let _ = (match r2 with
               | Cons (TP op2, _) -> if is_nonassoc_op op && is_nonassoc_op op2 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: syntax error, non-associative operator")) in fail "mere-ruby: syntax error, non-associative operator") else ()
               | _ -> ()) in
      parse_more (EBin (op, lhs, rhs)) r2 minp
    else (lhs, toks)
  // ruby 4.0: `&&` / `||` at the start of the next line continues this
  // expression. The precedence is checked BEFORE the newlines are consumed, so
  // a tighter level hands the newline back and the level that owns the
  // operator reads it -- `a + b` newline `|| c` is `(a + b) || c`.
  | Cons (TNL _, _) ->
    (let t2 = skip_nls toks in
     match t2 with
     | Cons (TP op, _) ->
       if (str_eq op "&&" || str_eq op "||") && prec_of op >= minp then parse_more lhs t2 minp else (lhs, toks)
     | _ -> (lhs, toks))
  | _ -> (lhs, toks)

and parse_unary = fn toks ->
  match toks with
  | Cons (TP op, rest) ->
    if str_eq op "-" then
      // a minus directly on a numeric literal folds into the literal, so a
      // postfix call sees the negative value: -2.abs == 2 (but ** still
      // binds tighter: -2**2 == -4, which the fold skips).
      (match rest with
       | Cons (TInt n, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EInt (0 - n)) r1)
       | Cons (TFlt f, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          // `0.0 - f` loses the sign of a zero (it is +0.0); multiplying keeps it.
          else neg_lit_tail (EFlt (f * (0.0 - 1.0))) r1)
       | Cons (TBig b, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EBig ("-" ++ b)) r1)
       | Cons (TRat (n, d), r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (ERat ("-" ++ n, d)) r1)
       | Cons (TImag n, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImag (0 - n)) r1)
       | Cons (TImagF f, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImagF (f * (0.0 - 1.0))) r1)
       | Cons (TImagRat (n, d), r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImagRat ("-" ++ n, d)) r1)
       | _ -> let (e, r) = parse_unary rest in (EUn ("-", e), r))
    else if str_eq op "+" then
      // unary + is identity for a numeric literal, but `+str` on a FROZEN
      // string is an unfrozen copy -- which is the whole point of writing it
      // -- so it has to reach String#+@ rather than fold away here.
      // a unary operator at the END of a line takes its operand from the NEXT
      // line, the way a binary one does: `i++` followed by `index` is ruby's
      // `i + (+index)` (ruby has no ++), and it appears in ruby/spec.
      (let rest = skip_nls rest in
       match rest with
       | Cons (TInt _, _) -> parse_unary rest
       | Cons (TFlt _, _) -> parse_unary rest
       | Cons (TBig _, _) -> parse_unary rest
       | Cons (TRat (_, _), _) -> parse_unary rest
       | _ -> let (e, r) = parse_unary rest in (EUn ("+", e), r))
    else if str_eq op "!" then
      let (e, r) = parse_unary rest in (EUn ("!", e), r)
    else if str_eq op "~" then
      let (e, r) = parse_unary rest in (EUn ("~", e), r)
    else parse_pow toks
  | _ -> parse_pow toks

and neg_next_pow = fn toks ->
  match toks with Cons (TP p2, _) -> str_eq p2 "**" | _ -> false
// postfix chain on a folded negative literal, keeping parse_pow's ** tail
// ((-2).abs ** 2 parses like 2 ** 2).
and neg_lit_tail = fn (lit: Expr) -> fn toks ->
  let (b, r) = parse_postfix_more lit toks in
  (match r with
   | Cons (TP p2, rest2) ->
     if str_eq p2 "**" then (let (e, r2) = parse_unary (skip_nls rest2) in (EBin ("**", b, e), r2))
     else (b, r)
   | _ -> (b, r))

and parse_pow = fn toks ->
  let (b, r) = parse_postfix toks in
  match r with
  | Cons (TP op, rest) ->
    // `**` is parsed here rather than in parse_more, so the trailing-operator
    // line continuation parse_more does has to be repeated.
    if str_eq op "**" then
      let (e, r2) = parse_unary (skip_nls rest) in (EBin ("**", b, e), r2)
    else (b, r)
  | _ -> (b, r)

// postfix method-call chains: `recv.name`, `recv.name(args)`, and the
// setter form `recv.name = expr` (parsed as a call to `name=`).
and parse_postfix = fn toks ->
  let (e, r) = parse_primary toks in
  parse_postfix_more e r

and parse_postfix_more = fn (recv: Expr) -> fn toks ->
  match toks with
  // a newline followed by .method continues the chain (leading-dot style).
  | Cons (TNL _, _) ->
    let t2 = skip_nls toks in
    (match t2 with
     | Cons (TP dot, _) -> if str_eq dot "." then parse_postfix_more recv t2 else (recv, toks)
     | _ -> (recv, toks))
  | Cons (TP dot0, r0) ->
    // A space-marked `[` after a COMPLETE expression is an index, not an array
    // literal: `config.for_cop('X') ['Y']` (rubocop) reads the result. The
    // ambiguous case -- a bare name followed by ` [` -- never reaches here; it
    // is settled where the identifier itself is parsed.
    let dot = (if str_eq dot0 " [" then "[" else dot0) in
    let r = (if str_eq dot "." then skip_nls r0 else r0) in   // `x.` + newline continues
    if str_eq dot "." then
      (match r with
       | Cons (TId name, r2) ->
         (match r2 with
          | Cons (TP p, r3) ->
            // `recv.name (expr), more` (space before the paren): the group is
            // the FIRST argument of a paren-less list, so a following comma
            // continues that list and a trailing `.m` binds to the group --
            // `a.insert (i || -1), v` is a two-argument call, not `insert(i)`.
            if str_eq p " (" then
              let (es, r4) = parse_puts_args r2 Nil in
              attach_block_method recv name es r4
            else if is_lparen p then
              let (argv, r4) = parse_call_args r3 in
              attach_block_method recv name argv r4
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // attribute op-assign: recv evaluated exactly once.
            else if not (str_eq (opassign_base p) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ -> attach_block_method recv name Nil r2)
       // `recv.(args)` is shorthand for `recv.call(args)`.
       | Cons (TP lp, r2) ->
         if str_eq lp "(" then let (argv, r3) = parse_call_args r2 in attach_block_method recv "call" argv r3
         // `recv.[](args)` / `recv.[]=(v)` — the bracket method called via dot.
         else if str_eq lp "[" && (match r2 with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
           (match r2 with
            | Cons (_, r3) ->
              (match r3 with
               | Cons (TP op, r4) ->
                 if str_eq op "(" then let (argv, r5) = parse_call_args r4 in attach_block_method recv "[]" argv r5
                 // `recv.[]=(k, v)` passes the setter ALL its arguments, index
                 // and value both; `recv.[]= v` is the one-argument form.
                 else if str_eq op "=" then
                   (match r4 with
                    | Cons (TP lp2, r5) ->
                      if str_eq lp2 "(" then
                        (let (argv, r6) = parse_call_args r5 in
                         parse_postfix_more (EMethod (recv, "[]=", argv)) r6)
                      else (let (rhs, r5b) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5b))
                    | _ -> (let (rhs, r5b) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5b)))
                 else parse_postfix_more (EMethod (recv, "[]", Nil)) r3
               | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r3)
            | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r2)
         // `recv.=~(x)` / `recv.+(y)` — explicit operator-method calls.
         // ⚠ THE PAREN-LESS FORM IS THE SAME CALL. `attach_block_method` is the
         // single place that reads a paren-less argument list, a block and a
         // block-pass, and the identifier arm above hands every one of its
         // results to it -- but this twin went straight to parse_postfix_more,
         // so `recv.<< x` parsed as a ZERO-argument `recv.<<()` and the argument
         // was left over as a syntax error with no mention of the operator.
         // ruby/spec writes it as `(s. << 'world')` in StringScanner#<<.
         else if is_op_method_name lp then
           (match r2 with
            | Cons (TP lp2, r3) ->
              if str_eq lp2 "(" then
                let (argv, r4) = parse_call_args r3 in
                attach_block_method recv lp argv r4
              else attach_block_method recv lp Nil r2
            | _ -> attach_block_method recv lp Nil r2)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after ." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after ." ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after ." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after ." ++ parsing_file ())))
    // index: recv[i] -> recv.[](i); recv[i] = v -> recv.[]=(i, v)
    else if str_eq dot "[" && (match r with Cons (TP rb0, _) -> str_eq rb0 "]" | _ -> false) then
      // empty index `recv[]` (getter) or `recv[] = v` (setter).
      (match r with
       | Cons (_, Cons (TP eq, r0e)) ->
         if str_eq eq "=" then
           let (rhs, r5) = parse_expr (skip_nls r0e) in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5)
         // `recv[] op= v` -> `recv[]= (recv[] op v)`.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r0e) in
           (EIdxOp (recv, Nil, opassign_base eq, rhs), r5)
         else (match r with Cons (_, r0f) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0f | _ -> (recv, toks))
       | Cons (_, r0e) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0e
       | _ -> (recv, toks))
    else if str_eq dot "[" then
      // one or more comma-separated indices (a[i], a[start, len], a[*idx]).
      let (idxs, r3) = parse_x_idx r Nil in
      (match r3 with
       | Cons (TP eq, r4) ->
         if str_eq eq "=" then
           let (rhs, r5) =
             (match skip_nls r4 with
              | Cons (TP st2, r4b) ->
                if str_eq st2 "*" then
                  let (inner, r5b) = parse_expr r4b in (EArr (Cons (ESplat inner, Nil)), r5b)
                else parse_expr (skip_nls r4)
              | _ -> parse_expr (skip_nls r4)) in
           (EMethod (recv, "[]=", eapp idxs (Cons (rhs, Nil))), r5)
         // recv[i] op= v desugars through a read-modify-write ([]= of
         // [] op v); ||= and &&= use their short-circuit operators.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r4) in
           (EIdxOp (recv, idxs, opassign_base eq, rhs), r5)
         else parse_postfix_more (EMethod (recv, "[]", idxs)) r3
       | _ -> parse_postfix_more (EMethod (recv, "[]", idxs)) r3)
    // safe navigation: a&.b / a&.b(args) — nil receiver short-circuits.
    else if str_eq dot "&." then
      let (name, r2) = safe_nav_name r in
      (match r2 with
       | Cons (TP p2, r3) ->
            // space-paren: the group is the first of a paren-less argument
            // list, exactly as for `.` above.
            if str_eq p2 " (" then
              let (es, r4) = parse_puts_args r2 Nil in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, es, bp, bb)) r5
              else parse_postfix_more (ESafe (recv, name, es)) r4
            else if str_eq p2 "(" then
              let (argv, r4) = parse_call_args r3 in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, argv, bp, bb)) r5
              else
                // `a&.map(&:to_s)`: a trailing block-PASS is a block too, and
                // safe navigation used to keep it as an argument -- which the
                // dispatcher then read as `map(:to_s)`, i.e. an Enumerator with
                // a stray argument rather than a mapped array. `.map(&:to_s)`
                // went through this same rewrite; only `&.` did not.
                (let (argv2, hasbp, bp2, bb2) = extract_block_pass argv in
                 if hasbp then parse_postfix_more (ESafeB (recv, name, argv2, bp2, bb2)) r4
                 else parse_postfix_more (ESafe (recv, name, argv)) r4)
            else if str_eq p2 "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // safe-navigation op-assign: recv&.attr op= rhs.
            else if not (str_eq (opassign_base p2) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (EBin (opassign_base p2, ESafe (recv, name, Nil), rhs), Nil)), r4)
            else if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in
              parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
            else parse_postfix_more (ESafe (recv, name, Nil)) r2
       // `do` is a name token, so a do-block lands here rather than above.
       | _ ->
         if starts_block r2 then
           let (bp, bb, r4) = parse_block r2 in
           parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
         else parse_postfix_more (ESafe (recv, name, Nil)) r2)
    // scope resolution: Foo::Bar (nested constant, looked up by bare name)
    // or Foo::meth(...) (module/class method call).
    else if str_eq dot "::" then
      (match r with
       | Cons (TId name, r2) ->
         // A::B is the constant B qualified by A; keep the full name so a
         // namespaced class resolves and reports consistently.
         let mkread = (match recv with
                       | EConst rc -> EConst (rc ++ "::" ++ name)
                       | _ -> EScopedRead (recv, name)) in
         (match r2 with
          | Cons (TP p, r3) ->
            if is_lparen p then let (argv, r4) = parse_call_args r3 in attach_block_method recv name argv r4
            // recv::Const = value : a runtime-receiver constant assignment.
            else if is_cap name && str_eq p "=" then let (v, r4) = parse_expr r3 in (EScopedAssign (recv, name, v), r4)
            // recv::Const op= value -> t = recv; t::Const = t::Const op value,
            // evaluating the receiver expression exactly once (side effects).
            else if is_cap name && (if str_eq (opassign_base p) "" then false else true) then
              let (v, r4) = parse_expr (skip_nls r3) in
              let tmp = fresh_tmp () in
              let base = opassign_base p in
              // `||=` treats an undefined constant as nil (then assigns); other
              // op-assigns read first, so an undefined constant raises NameError.
              let readx = if str_eq base "||" then EScopedReadOrNil (EVar tmp, name) else EScopedRead (EVar tmp, name) in
              (EStmt (SBegin (Cons (SAssign (tmp, recv), Cons (SExpr (EScopedAssign (EVar tmp, name, EBin (base, readx, v))), Nil)), Nil, Nil, Nil)), r4)
            else if is_cap name then parse_postfix_more mkread r2
            // `Recv::name = v` is the setter call `Recv.name = v` -- `::` and
            // `.` are interchangeable for method calls, and concurrent-ruby's
            // tvar.rb writes `Transaction::current = nil`.
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            else if (if str_eq (opassign_base p) "" then false else true) then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ ->
            if is_cap name then parse_postfix_more mkread r2
            else attach_block_method recv name Nil r2)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected name after ::" ++ parsing_file ()))) in fail ("mere-ruby: expected name after ::" ++ parsing_file ())))
    else (recv, toks)
  | _ -> (recv, toks)

// a trailing `{ }` / `do end` block turns a method call into EMethodB.
// the method name after `&.`. Usually an ordinary name, but an operator
// method may be written out the same way it can after `.`:
// `mapping&.[](key)`, `x&.+(y)`.
and safe_nav_name = fn toks ->
  match toks with
  | Cons (TId name, r) -> (name, r)
  | Cons (TP lb, r) ->
    if str_eq lb "[" && (match r with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
      (match r with Cons (_, r2) -> ("[]", r2) | _ -> ("[]", r))
    else if is_op_method_name lb then (lb, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after &." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after &." ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after &." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after &." ++ parsing_file ()))

and attach_block_method = fn (recv: Expr) -> fn (name: str) -> fn (argv: Expr list) -> fn toks ->
  // paren-less block-pass: `recv.meth &blk` (the " &" token = space-before,
  // no-space-after). Turn the following expr into a block-pass argument.
  let (argv, toks) = (match argv with
    | Nil -> (match toks with
              | Cons (TP amp, r) -> if str_eq amp " &" then (let (be, r1) = parse_expr r in (Cons (EBlockPass be, Nil), r1)) else (argv, toks)
              | _ -> (argv, toks))
    | _ -> (argv, toks)) in
  let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
  if hasbp then parse_postfix_more (EMethodB (recv, name, argv2, bp0, bb0)) toks
  else if starts_block toks then
    let (bp, bb, r) = parse_block toks in
    // continue the chain: `arr.map { } .sum` etc.
    parse_postfix_more (EMethodB (recv, name, argv, bp, bb)) r
  // paren-less argument on a dotted call: `x.should be_nil` / `a.push v` /
  // `ScratchPad.record []` (a space before [ means an array argument).
  else if (match argv with Nil -> true | _ -> false) && (starts_bare_arg toks || starts_sp_bracket toks) then
    // suppress do-block attachment while parsing the bare args so a trailing
    // `do...end` binds to this call, not to a bare-identifier argument
    // (`Class.new sc do ... end` = Class.new(sc) { ... }).
    let had = map_has parser_flags "nodo" in
    let _ = map_set parser_flags "nodo" VNil in
    let (es, r2) = parse_puts_args toks Nil in
    let _ = if had then () else map_delete parser_flags "nodo" in
    // `obj.meth :arg do |x| ... end` — a do-block after bare args.
    if starts_do_block r2 then
      let (bp, bb, r3) = parse_block r2 in
      parse_postfix_more (EMethodB (recv, name, es, bp, bb)) r3
    else parse_postfix_more (EMethod (recv, name, es)) r2
  else parse_postfix_more (EMethod (recv, name, argv)) toks

// `name [items]` is an index or a call with an array argument, and eval
// decides -- unless a `do` block follows, which only a CALL can take. Ruby's
// own specs are written that way (`argf [@file1, @file2] do ... end`), and 42
// of the 75 files the parse sweep could not read were this one shape.
and ambig_or_call = fn (id: str) -> fn (ae: Expr) -> fn toks ->
  if starts_do_block toks then
    (let (bp, bb, r) = parse_block toks in (ECallB (id, Cons (ae, Nil), bp, bb), r))
  else
    (match ae with
     | EArr items -> (EAmbigIdx (id, items), toks)
     | other -> (ECall (id, Cons (other, Nil)), toks))

and starts_do_block = fn toks ->
  match toks with Cons (TId d, _) -> str_eq d "do" | _ -> false

and starts_sp_bracket = fn toks ->
  match toks with Cons (TP lb, _) -> str_eq lb " [" | _ -> false


and starts_bare_arg = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    // value keywords are arguments (`x.go false`); a def is an expression
    // (`ruby2_keywords def m...`); structural keywords are not arguments.
    if str_eq w "true" || str_eq w "false" || str_eq w "nil" || str_eq w "self" ||
       str_eq w "def" || str_eq w "yield" then true
    else if is_keyword w || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
       str_eq w "in" || str_eq w "for" then false
    else true
  | Cons (TInt _, _) -> true
  | Cons (TBig _, _) -> true
  | Cons (TRat _, _) -> true
  | Cons (TImag _, _) -> true
  | Cons (TImagF _, _) -> true
  | Cons (TImagRat _, _) -> true
  | Cons (TFlt _, _) -> true
  | Cons (TStrL _, _) -> true
  | Cons (TSym _, _) -> true
  | Cons (TRegex _, _) -> true
  // dq string, unary ~ / !, lambda, or a top-level constant path (` ::Const`).
  // `f !x` can only be a negated argument: a method named f! lexes as one
  // token, and `a ! b` is not Ruby.
  | Cons (TP p, _) -> str_eq p "(s" || str_eq p "~" || str_eq p "!" || str_eq p "->" || str_eq p " ::"
  | _ -> false

// A trailing `&:sym` block-pass arg becomes a real one-param block
// `{ |__bp| __bp.sym }`. Returns (args-without-bp, found?, bparams, bbody).
and extract_block_pass = fn (argv: Expr list) ->
  match rev_app argv Nil with
  | Cons (EBlockPass be, rrest) ->
    (match be with
     | ESym s ->
       // Symbol#to_proc takes the receiver plus ANY further arguments
       // (arity -2), so a two-argument caller works too: `reduce(&:concat)`
       // is `{ |a, *rest| a.concat(*rest) }`, not `{ |a| a.concat }`. It is a
       // LAMBDA, which matters here: a plain 2-param block would auto-splat,
       // so `group_by(&:name)` over array-ish elements would tear them apart
       // instead of passing each one whole as the receiver.
       (rev_app rrest Nil, true,
        Cons (lambda_blk_marker, Cons ("__bp", Cons ("*__ba", Nil))),
        Cons (SExpr (EMethod (EVar "__bp", s, Cons (ESplat (EVar "__ba"), Nil))), Nil))
     // general &expr: mark for runtime coercion (Proc/nil/to_proc) at the
     // call site — the "&coerce" param sentinel carries the expr in its body.
     | _ -> (rev_app rrest Nil, true, Cons ("&coerce", Nil), Cons (SExpr be, Nil)))
  | _ -> (argv, false, (Nil : str list), (Nil : Stmt list))

and starts_block = fn toks ->
  match toks with
  | Cons (TP p, _) -> str_eq p "\{" && (if map_has parser_flags "nobrace" then false else true)
  | Cons (TId d, _) -> str_eq d "do" && (if map_has parser_flags "nodo" then false else true)
  | _ -> false

// parse `{ |p,..| stmt }` (single statement) or `do |p,..| stmts end`.
// a `|a=5|` default becomes a prologue statement: the bind sets missing
// args to nil, so a nil param takes its default (explicit nil is rare).
// recover the (name, default) pairs a block encodes as leading nil-check
// prologue statements, so the argument fill can order optionals correctly.
and block_defaults = fn (body: Stmt list) ->
  match body with
  | Cons (SIf (Cons ((cond, Cons (SAssign (n, d), Nil)), Nil), Nil), rest) ->
    (match cond with
     | EMethod (EVar cn, m, Nil) ->
       if str_eq m "nil?" && str_eq cn n then Cons ((n, d), block_defaults rest)
       else Nil
     | _ -> Nil)
  | _ -> Nil

// the body WITHOUT the default-assignment prologue block_defaults reads.
// `define_method` turns a block into a method, and a method binds its own
// defaults: leaving the prologue in as well would rewrite an EXPLICIT nil
// argument to the default, which a method must not do (`m(nil)` is nil).
and drop_defaults_prologue = fn (body: Stmt list) ->
  match body with
  | Cons (SIf (Cons ((cond, Cons (SAssign (n, d), Nil)), Nil), Nil), rest) ->
    (match cond with
     | EMethod (EVar cn, m, Nil) ->
       if str_eq m "nil?" && str_eq cn n then drop_defaults_prologue rest else body
     | _ -> body)
  | _ -> body

and app_ds = fn (a: (str * Expr) list) -> fn (b: (str * Expr) list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, app_ds t b)

and defaults_prologue = fn (ds: (str * Expr) list) -> fn (body: Stmt list) ->
  match ds with
  | Nil -> body
  | Cons ((n, d), rest) ->
    Cons (SIf (Cons ((EMethod (EVar n, "nil?", Nil), Cons (SAssign (n, d), Nil)), Nil), Nil),
          defaults_prologue rest body)

and parse_block = fn toks ->
  // The body of a block is a NEW context for do-blocks. `using Module.new {
  // refine Array do ... end }` parses `using <arg>` as a command call, which
  // sets "nodo" so that a following `do` belongs to `using` and not to
  // `Module.new`. That flag was still set while the brace block's BODY was
  // parsed, so the `do` inside it was refused and three core/module spec
  // files did not parse at all. parse_def already does this for the same
  // reason; a block body needs it for the same reason.
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let r = parse_block_inner toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  r

and parse_block_inner = fn toks ->
  match toks with
  | Cons (TP brace, r) ->
    if str_eq brace "\{" then
      let (bp, ds, r2) = parse_block_params_d r in
      let (body, r3) = parse_brace_stmts r2 Nil in
      (bp, defaults_prologue ds body, r3)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))
  | Cons (TId d, r) ->
    if str_eq d "do" then
      let (bp, ds0, r2) = parse_block_params_d r in
      let (body0, r3) = parse_stmts r2 Nil in
      // do-blocks accept trailing rescue/ensure (an implicit begin).
      let (body, r5) =
        (match r3 with
         | Cons (TId k, _) ->
           if str_eq k "rescue" || str_eq k "ensure" then
             let (rescues, ra) = parse_rescues r3 Nil in
             let (els, rb) = parse_opt_kw_block ra "else" in
             let (ens, rc) = parse_opt_kw_block rb "ensure" in
             (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
           else (body0, r3)
         | _ -> (body0, r3)) in
      (bp, defaults_prologue ds0 body, expect_kw r5 "end")
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))

// statements inside a `{ ... }` block, terminated by `}` (consumed).
// ⚠ `{ ... }` and `do ... end` are the same construct and were parsed by two
//   functions, only one of which emitted the SLine markers that tell the
//   interpreter which line is executing. So a warning raised inside a brace
//   block named the line of whatever CALLED the block:
//
//     w { [1,2].any?(Integer) { } }      the warning said line 2 (the `yield`
//                                        inside w), ruby says 4
//     w do ... end                       already right, because do-blocks go
//                                        through parse_stmts
//
//   Same marker, same shape as parse_stmts: it precedes its statement, so the
//   block's VALUE is still the last statement's.
and parse_brace_stmts = fn toks -> fn (acc: Stmt list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP p, r) ->
    if str_eq p "}" then (rev_app acc Nil, r)
    else let ln = tok_line t in
         let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
         parse_brace_stmts r1 (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))
  | Cons (TEOF, _) -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated block" ++ parsing_file ()))) in fail ("mere-ruby: unterminated block" ++ parsing_file ()))
  | _ ->
    let ln = tok_line t in
    let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
    parse_brace_stmts r1 (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))


// like parse_block_params but also returns (name, default-expr) pairs for
// optional params (`|a=5, b=4|`); parse_block turns them into a prologue.
and parse_block_params_d = fn toks ->
  let t = skip_nls toks in
  match t with
  | Cons (TP bar, r) ->
    if str_eq bar "|" then parse_pipe_params r Nil Nil
    else if str_eq bar "||" then (Cons (empty_bp_marker, Nil), (Nil : (str * Expr) list), r)
    else (Nil, Nil, t)
  | _ -> (Nil, Nil, t)

and parse_pipe_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  // `|one; bl|` — names after a semicolon (lexed as TNL) are block-locals:
  // encoded with a ; prefix, they always bind nil.
  | Cons (TNL _, r) -> parse_block_locals r acc ds
  | Cons (TP bar, r) ->
    if str_eq bar "|" then (rev_app acc Nil, rev_app ds Nil, r)
    else if str_eq bar "*" then
      (match r with Cons (TId n, r2) -> pipe_after ("*" ++ n) r2 acc ds | _ -> pipe_after "*" r acc ds)
    else if str_eq bar "**" then
      // `**kw` — keyword-splat: collects a trailing hash argument (or {}).
      // A bare `**` gets the same hidden name a method parameter does: the
      // binder reads the NAME to decide whether keywords are wanted at all.
      (match r with Cons (TId n, r2) -> pipe_after ("**" ++ n) r2 acc ds | _ -> pipe_after "**__anonkw" r acc ds)
    else if str_eq bar "&" then
      (match r with Cons (TId n, r2) -> pipe_after ("&" ++ n) r2 acc ds | _ -> pipe_after "&" r acc ds)
    else if str_eq bar "(" then
      // nested destructuring |(a, (b, c))| — encoded as a spec string.
      let (spec, r2) = pipe_group r "" in
      pipe_after ("(" ++ spec ++ ")") r2 acc ds
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
  | Cons (TId name, r) ->
    // `a=default` — an optional parameter; `k:` / `k: default` — keyword.
    (match r with
     // `|b:|` — the lexer reads `:|` as the operator symbol :| — that is a
     // required keyword param immediately before the closing bar.
     | Cons (TSym sy, r2) ->
       if str_eq sy "|" then (rev_app (Cons (name ++ ":", acc)) Nil, rev_app ds Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // parse above `|`'s precedence so the closing bar stays the closer
         let (d, r3) = parse_bin r2 6 in
         pipe_after name r3 acc (Cons ((name, d), ds))
       else if str_eq eq ":" then
         (match r2 with
          | Cons (TP nx, _) ->
            if str_eq nx "," || str_eq nx "|" then pipe_after (name ++ ":") r2 acc ds
            else
              let (d, r3) = parse_bin r2 6 in
              pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds))
          | _ ->
            let (d, r3) = parse_bin r2 6 in
            pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds)))
       else pipe_after name r acc ds
     | _ -> pipe_after name r acc ds)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block parameter" ++ parsing_file ()))) in fail ("mere-ruby: expected block parameter" ++ parsing_file ()))

// tokens of a nested destructure group (after the opening paren) encoded
// back into a compact string: names, commas, splats, nested groups.
and pipe_group = fn toks -> fn (acc: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (acc, r)
    else if is_lparen p || str_eq p " [" then
      let (inner, r2) = pipe_group r "" in pipe_group r2 (acc ++ "(" ++ inner ++ ")")
    else if str_eq p "," then pipe_group r (acc ++ ",")
    else if str_eq p "*" then pipe_group r (acc ++ "*")
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
  | Cons (TId n, r) -> pipe_group r (acc ++ n)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")

and parse_block_locals = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then parse_block_locals r2 (Cons (";" ++ n, acc)) ds
       else if str_eq c "|" then (rev_app (Cons (";" ++ n, acc)) Nil, rev_app ds Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list")
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list"))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list")

and pipe_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `|a,|` — a trailing comma forces destructuring: add an anonymous
      // splat so a single Array/to_ary arg splits (a = first element). The
      // marker "*," (distinct from a real "*") records the trailing comma so a
      // lambda still enforces an exact arity (`->(a,){}` is arity 1, not -2).
      (match r with
       | Cons (TP bar2, _) -> if str_eq bar2 "|" then parse_pipe_params r (Cons ("*,", Cons (name, acc))) ds
                              else parse_pipe_params r (Cons (name, acc)) ds
       | _ -> parse_pipe_params r (Cons (name, acc)) ds)
    else if str_eq p "|" then (rev_app (Cons (name, acc)) Nil, rev_app ds Nil, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or | in block params" ++ parsing_file ()))) in fail ("mere-ruby: expected , or | in block params" ++ parsing_file ()))
  // `|one; bl|` — the ; (lexed as a newline) starts the block-local names.
  | Cons (TNL _, r) -> parse_block_locals r (Cons (name, acc)) ds
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated block params" ++ parsing_file ()))) in fail ("mere-ruby: unterminated block params" ++ parsing_file ()))

// fold any string literals immediately following `e` into it (Ruby's
// adjacent-string-literal concatenation).
and concat_adjacent_strings = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      let (e2, r2) = parse_expr r in
      concat_adjacent_strings (EBin ("+", e, e2)) (expect r2 ")")
    else (e, toks)
  | Cons (TStrL s2, r) -> concat_adjacent_strings (EBin ("+", e, EStrL s2)) r
  | _ -> (e, toks)

and parse_primary = fn toks ->
  match toks with
  | Cons (TInt n, r) -> (EInt n, r)
  | Cons (TBig b, r) -> (EBig b, r)
  | Cons (TRat n, r) -> (ERat n, r)
  | Cons (TImag n, r) -> (EImag n, r)
  | Cons (TImagF f, r) -> (EImagF f, r)
  | Cons (TImagRat n, r) -> (EImagRat n, r)
  | Cons (TRegex p, r) ->
    // record the literal for post-parse validation (rx_check_pending): an
    // invalid regex is a parse-time SyntaxError, unsupported ones pass.
    let (rbody, rfl) = p in
    let n = (if map_has rx_pending "n" then (match map_get rx_pending "n" with VInt k -> k | _ -> 0) else 0) in
    let _ = map_set rx_pending ("e" ++ str_of_int n) (mkstr (rfl ++ "\n" ++ rbody)) in
    let _ = map_set rx_pending "n" (VInt (n + 1)) in
    (ERegex p, r)
  | Cons (TFlt f, r) -> (EFlt f, r)
  // adjacent string literals concatenate, whichever quoting each one uses:
  // `'a' "b"` and `'a' \<newline> "b"` read the same as `"a" "b"`.
  // A file with a non-UTF-8 magic comment tags its literals AT PARSE TIME
  // (like __ENCODING__): the marker method carries the name, eval sets senc.
  | Cons (TStrL s, r) ->
    (let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
     if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8"
     then concat_adjacent_strings (EStrL s) r
     else
       (match concat_adjacent_strings (EStrL s) r with
        | (e9, r9) ->
          // in a US-ASCII source, non-ASCII bytes can only have come from
          // \u escapes (raw ones are a ruby SyntaxError there), and a \u
          // escape makes the literal UTF-8 -- so such literals stay untagged.
          let rec hasnon7 = fn (e2: Expr) ->
            (match e2 with
             | EStrL t9 -> (if enc_all7 t9 then false else true)
             | EBin (_, a9, b9) -> hasnon7 a9 || hasnon7 b9
             | _ -> false) in
          if (str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII") && hasnon7 e9
          then (e9, r9)
          else (EMethod (e9, "__lit_enc~" ++ cd, Nil), r9)))
  | Cons (TSym s, r) -> (ESym s, r)
  | Cons (TId id, r) ->
    // `and` / `or` cannot START an expression. (Since ruby 4.0 a line that
    // begins with one CONTINUES the statement before it -- apply_modifier and
    // parse_andor_more read that case first -- so what reaches here is an
    // `and` with nothing in front of it: after a `;`, or at the top of a body.)
    // Saying so (instead of reading it as a call to a method named `and`)
    // turns a confusing NoMethodError at run time into a parse error that
    // names the file.
    if str_eq id "and" || str_eq id "or" then
      (let __fm = ("mere-ruby: unexpected keyword: " ++ id) in
       let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
    else if str_eq id "true" then (EBool true, r)
    else if str_eq id "false" then (EBool false, r)
    else if str_eq id "nil" then (ENil, r)
    else if str_eq id "self" then (ESelf, r)
    else if is_ivar id then
      (match r with
       | Cons (TP eq, r2) ->
         if str_eq eq "=" then let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3)
         else if not (str_eq (opassign_base eq) "") then
           let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, EBin (opassign_base eq, EIVar (substring id 1 (str_len id)), e)), r3)
         else (EIVar (substring id 1 (str_len id)), r)
       | _ -> (EIVar (substring id 1 (str_len id)), r))
    else if is_cap id then
      (match r with
       | Cons (TP eq, r2) ->
         // A capitalized name immediately followed by `(` is a METHOD CALL,
         // not a constant — constants can't be "called" with parens in Ruby.
         // This covers the Kernel conversion functions (Integer(x) / Float(x)
         // / Rational(n,d) / Complex(r,i) / Array / String) AND user-defined
         // capitalized methods (`def Rainbow(s)` … `Rainbow("x")`).
         if str_eq eq "(" then
           let (argv, r3) = parse_call_args r2 in (ECall (id, argv), r3)
         else if str_eq eq "=" then let (e, r3) = parse_expr r2 in (EAssign (id, e), r3)
         // A double-quoted string, lambda or unary argument settles it as a
         // call the same way a bare one does below -- `LOG "reading #{len}
         // bytes..."` in net/protocol is a method named LOG. (Only the token
         // KINDS starts_bare_arg accepts; `Foo::Bar`, `Foo[i]` and `Foo.m`
         // are not among them and stay constants.)
         else if str_eq eq " (" || starts_bare_arg r then
           let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (EConst id, r)
       // `Array licenses` / `Integer str` — the paren-less form of the same
       // call. A constant takes no argument, so a bare argument here settles
       // it as a method call. (`Foo::Bar`, `Foo.m` and a plain `Foo` reach
       // this with a token that starts no argument, and stay constants.)
       | _ ->
         if starts_bare_arg r then let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (EConst id, r))
    else if str_eq id "yield" then
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then let (argv, r3) = parse_call_args r2 in (EYield argv, r3)
         // `yield [0]` passes an array literal (not an index on the result).
         else if str_eq p "[" || str_eq p " [" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         // A double-quoted string is lexed as `TP "(s"` -- the open of the
         // interpolation desugaring -- and `is_lparen` only knows "(" and " (",
         // so `yield "k", 2` fell into the no-argument case and the statement
         // parser then said "expected end of statement". rubygems' config_file.rb
         // writes `yield "config_file_name", @config_file_name if @config_file_name`.
         //
         // ONLY that token is added. Widening the test to "anything that is not a
         // closer starts an argument" -- the rule `raise` uses -- broke three
         // inputs that had always worked: `cond ? yield : x` (a parse error, then
         // an infinite loop once the colon was half-handled), and `yield + 10`,
         // which ruby reads as `(yield) + 10` and that read as `yield(+10)`.
         // `yield + 10` against `yield +10` is decided by the space AFTER the
         // operator, which the token does not carry, so the operators stay on the
         // no-argument side where they have always been.
         else if str_eq p "(s" || str_eq p " (s" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         else (EYield Nil, r)
       | Cons (TNL _, _) -> (EYield Nil, r)
       | Cons (TEOF, _) -> (EYield Nil, r)
       // `yield end` / `yield if c` — a stop keyword ends a bare yield.
       | Cons (TId w, _) -> if stops_value w then (EYield Nil, r) else let (es, r2) = parse_puts_args r Nil in (EYield es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (EYield es, r2))
    else if str_eq id "raise" then
      (match r with
       | Cons (TNL _, _) -> (ERaise Nil, r)
       | Cons (TEOF, _) -> (ERaise Nil, r)
       // bare raise before a modifier/terminator keyword takes no args.
       | Cons (TId w, _) ->
         if stops_value w then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | Cons (TP p, _) ->
         // a paren-less argument has to START an expression: a closer or a
         // binary-only operator means this `raise` takes none. i18n writes
         // `raise && :raise` (where `raise` is a keyword PARAMETER, so ruby
         // reads the local), and `[k, raise]` is the same shape.
         if str_eq p ")" || str_eq p "}" || str_eq p ";" || str_eq p "]" ||
            str_eq p "," || str_eq p "&&" || str_eq p "||" || str_eq p "==" ||
            str_eq p "!=" || str_eq p "=>" || str_eq p "?" || str_eq p "." ||
            str_eq p "<" || str_eq p ">" || str_eq p "<=" || str_eq p ">=" ||
            str_eq p "<=>" || str_eq p "=~" then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (ERaise es, r2))
    else if str_eq id "super" then
      // `super` forwards the current args; `super(...)` / `super()` are explicit.
      let (zs, argv, r1) =
        (match r with
         | Cons (TP p, r2) ->
           if is_lparen p then let (a, r3) = parse_call_args r2 in (false, a, r3)
           // `super x` / `super "msg", y` — paren-less arguments, like any
           // other command call. Without this the bare form parsed as zsuper
           // and the argument was left dangling. A SPACE-marked `[` is an
           // array argument too (`super [*message, ...].join("\n")`), which is
           // exactly what the lexer marks it for.
           else if starts_bare_arg r || starts_sp_bracket r then let (a, r3) = parse_puts_args r Nil in (false, a, r3)
           else (true, Nil, r)
         | _ -> if starts_bare_arg r then let (a, r3) = parse_puts_args r Nil in (false, a, r3)
                else (true, Nil, r)) in
      // `super { ... }` / `super do ... end` passes an explicit block.
      if starts_block r1 then
        let (bp, bb, r4) = parse_block r1 in (ESuperB (zs, argv, bp, bb), r4)
      else (ESuper (zs, argv), r1)
    else if str_eq id "not" then
      // `not(x)` / `not x` — negation; with parens the chain continues
      // on the negated value (not(true).should == ...).
      (match r with
       | Cons (TP lp, _) ->
         if str_eq lp "(" then let (e, r2) = parse_primary r in (EUn ("!", e), r2)
         else let (e, r2) = parse_expr r in (EUn ("!", e), r2)
       | _ -> let (e, r2) = parse_expr r in (EUn ("!", e), r2))
    else if str_eq id "defined?" then
      // defined?(e) or defined? e — never evaluates e for its value.
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then
           // defined?(x = 2) and friends answer "assignment" unevaluated.
           // `defined?((a, b = 1, 2))` wraps the assignment in ITS OWN parens,
           // so the scan for a top-level `=` found it one level down and the
           // whole thing read as an expression.
           if defined_assignish r2
              || (match r2 with Cons (TP lp2, r6) -> is_lparen lp2 && defined_assignish r6 | _ -> false) then
             let (_, r3) = parse_stmt r2 in (EDefined (EVar ("__defined__" ++ defined_assign_kind r2)), expect r3 ")")
           // defined?(if.../while.../case... end) answers "expression".
           else if defined_compound r2 then
             let (_, r3) = parse_stmt r2 in (EDefined (EVar "__defined__expression"), expect r3 ")")
           else
           // defined?(puts) — a keyword-named method probes as a plain call.
           // parse the inner expression at the lowest precedence so the word
           // operators `and`/`or`/`not` are allowed (`defined?(a and b)`).
           (match r2 with
            | Cons (TId w, Cons (TP rp, r4)) ->
              if str_eq rp ")" then (EDefined (EVar w), r4)
              else let (e, r3) = parse_andor r2 in (EDefined e, expect r3 ")")
            | _ -> let (e, r3) = parse_andor r2 in (EDefined e, expect r3 ")"))
         // `defined? a = 10` (no parens) — an assignment is unevaluated.
         else if defined_assignish r then
           let (_, r3) = parse_stmt r in (EDefined (EVar ("__defined__" ++ defined_assign_kind r)), r3)
         else let (e, r3) = parse_unary r in (EDefined e, r3)
       // `defined? a = 10` at statement start (no leading paren token).
       | _ ->
         if defined_assignish r then
           let (_, r3) = parse_stmt r in (EDefined (EVar ("__defined__" ++ defined_assign_kind r)), r3)
         else let (e, r3) = parse_unary r in (EDefined e, r3))
    else if str_eq id "break" || str_eq id "next" || str_eq id "return" || str_eq id "redo" || str_eq id "retry" then
      // flow keywords in expression position (ternary branches, call args).
      (match r with
       | Cons (TNL _, _) -> (EFlow (id, ENil), r)
       | Cons (TEOF, _) -> (EFlow (id, ENil), r)
       | Cons (TP p, _) ->
         if str_eq p ")" || str_eq p "}" || str_eq p "]" || str_eq p "," ||
            str_eq p ":" || str_eq p ";" then (EFlow (id, ENil), r)
         else if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | Cons (TId w, _) ->
         if stops_value w || str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | _ ->
         if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2))
    else if str_eq id "if" then
      // statement constructs usable as expressions (call args etc.).
      let (s, r2) = parse_if r false in (EStmt s, r2)
    else if str_eq id "unless" then let (s, r2) = parse_if r true in (EStmt s, r2)
    else if str_eq id "while" then let (s, r2) = parse_while r false in (EStmt s, r2)
    else if str_eq id "until" then let (s, r2) = parse_while r true in (EStmt s, r2)
    else if str_eq id "for" then let (s, r2) = parse_for r in (EStmt s, r2)
    else if str_eq id "case" then let (s, r2) = parse_case r in (EStmt s, r2)
    else if str_eq id "begin" then let (s, r2) = parse_begin r in (EStmt s, r2)
    // def/class in expression position (def evaluates to the method name
    // as a symbol; class to its body's last value).
    else if str_eq id "def" then let (s, r2) = parse_def r in (EStmt s, r2)
    else if str_eq id "class" then let (s, r2) = parse_class r in (EStmt s, r2)
    else if is_keyword id then (let __fm = ("mere-ruby: unexpected keyword: " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
    else
      // `name(args)` / `name(args) { block }` / `name { block }` / bare name.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           // assignment as an expression: `true && x = 1` binds rightmost.
           (match r2 with
            | Cons (TP st, r2b) ->
              if str_eq st "*" then
                let (e, r3) = parse_expr (skip_nls r2b) in (EAssign (id, EArr (Cons (ESplat e, Nil))), r3)
              else let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3)
            | _ -> let (e, r3) = parse_expr r2 in (EAssign (id, e), r3))
         else if not (str_eq (opassign_base p) "") then
           // op-assign as an expression: `(i += 1) >= 5`.
           let (e, r3) = parse_expr (skip_nls r2) in
           (EAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         // `name (expr)...` (space before paren): the parenthesised group is
         // the first command argument, so a trailing `.m`/operator binds to it
         // (`p (1..3).map { }` = p((1..3).map { }), not (p(1..3)).map).
         else if str_eq p " (" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else if is_lparen p then
           let (argv, r3) = parse_call_args r2 in
           let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
           if hasbp then (ECallB (id, argv2, bp0, bb0), r3)
           else if starts_block r3 then
             let (bp, bb, r4) = parse_block r3 in (ECallB (id, argv, bp, bb), r4)
           else (ECall (id, argv), r3)
         else if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // `p [1, 2]` — p/pp take a space-bracket array argument.
         else if str_eq p " [" && (str_eq id "p" || str_eq id "pp") then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `name [items]` — indexing or call-with-array, decided at eval.
         else if str_eq p " [" then
           (let (ae, r2b) = parse_array r2 in
            // A comma after the bracket settles the ambiguity here instead:
            // `assert_equal [1], x` is a paren-less call whose first argument
            // is an array literal, never an index (an index takes no comma at
            // this level). The rest of the arguments parse as usual.
            match r2b with
            | Cons (TP cm, r2c) ->
              if str_eq cm "," then
                (let (es, r2d) = parse_puts_args (skip_nls r2c) (Cons (ae, Nil)) in
                 if starts_do_block r2d
                 then (let (bp, bb, r2e) = parse_block r2d in (ECallB (id, es, bp, bb), r2e))
                 else (ECall (id, es), r2d))
              else ambig_or_call id ae r2b
            | _ -> ambig_or_call id ae r2b)
         // a double-quoted string argument: `d "desc" do ... end`.
         else if str_eq p "(s" then
           // An interpolated string lexes as a GROUP, and a chained call on it
           // (`:"m#{t}"` becomes `(...).to_sym`) would otherwise swallow the
           // `do`: `define_method :"on_#{type}" do |node|` must give the block
           // to define_method, not to to_sym.
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if starts_block r2b then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `foo ~x` / `foo !x` — a unary-operator argument in a paren-less
         // call. Ruby has no binary `!`, and a method named `foo!` lexes as
         // one token, so a bare `!` here can only start an argument.
         else if str_eq p "~" || str_eq p "!" then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `foo ::Const` — the lexer only marks " ::" where a value can start.
         // A `do...end` after it belongs to this command, as it does for every
         // other paren-less argument shape (`refine ::Range do ... end`).
         else if str_eq p " ::" then
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if starts_block r2b then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `foo -> { ... }` — a paren-less lambda argument (the lambda owns its
         // own block; `.call`/chains after it stay part of the argument).
         else if str_eq p "->" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else (enc_pseudo_var_at id (tok_line r), r)
       | _ ->
         if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // paren-less call arguments: `it 'desc' do ... end`, `foo :sym, 1`.
         else if starts_bare_arg r then
           // `do...end` binds to this command, not to a bare identifier
           // argument (`define_method name do..end` = define_method(name){..}),
           // so suppress do-block attachment while parsing the arguments.
           let had = map_has parser_flags "nodo" in
           let _ = map_set parser_flags "nodo" VNil in
           let (es, r2) = parse_puts_args r Nil in
           let _ = if had then () else map_delete parser_flags "nodo" in
           (if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2))
         else (enc_pseudo_var_at id (tok_line r), r))
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      // a desugared string literal: ("" + seg + ...) with a marked opener
      // so `foo "a".."b"` stays an argument, not a call's parens.
      let (e, r2) = parse_expr r in
      let r3 = expect r2 ")" in
      // adjacent string literals concatenate: "a" "b" is "ab".
      (match concat_adjacent_strings e r3 with
       | (e9, r9) ->
         // a non-UTF-8 magic comment tags the literal at parse time (see the
         // TStrL arm); interpolated pieces keep their own encodings, so only
         // a fully-static chain is tagged. In a US-ASCII source, non-ASCII
         // bytes come from \u escapes, which make the literal UTF-8 instead.
         let cd = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr h -> sget h | _ -> "") else "") in
         if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" then (e9, r9)
         else
           let rec statall = fn (e2: Expr) ->
             (match e2 with
              | EStrL _ -> true
              | EBin (op2, a9, b9) -> str_eq op2 "+" && statall a9 && statall b9
              | _ -> false) in
           let rec hasnon7 = fn (e2: Expr) ->
             (match e2 with
              | EStrL t9 -> (if enc_all7 t9 then false else true)
              | EBin (_, a9, b9) -> hasnon7 a9 || hasnon7 b9
              | _ -> false) in
           if (if statall e9 then false else true) then (e9, r9)
           else if (str_eq cd "US-ASCII" || str_eq cd "ASCII" || str_eq cd "USASCII") && hasnon7 e9
           then (e9, r9)
           else (EMethod (e9, "__lit_enc~" ++ cd, Nil), r9))
    else if is_lparen p then
      // () is nil; inside parens the word operators and/or (lowest
      // precedence) are usable: (a and b).
      (match r with
       | Cons (TP rp, r1) ->
         if str_eq rp ")" then (ENil, r1)
         else paren_body r
       | _ -> paren_body r)
    else if str_eq p "[" || str_eq p " [" then parse_array r
    else if str_eq p "\{" then parse_hash r
    else if str_eq p "::" || str_eq p " ::" then
      // leading ::Const — a TOP-LEVEL constant. Keep the prefix: read by bare
      // name it would find a nested constant of the same name instead, which
      // is exactly what `::Process` inside Sidekiq (which has its own
      // Process) is written to avoid.
      (match r with Cons (TId n, r2) -> (EConst ("::" ++ n), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected constant after ::" ++ parsing_file ()))) in fail ("mere-ruby: expected constant after ::" ++ parsing_file ())))
    else if str_eq p ".." || str_eq p "..." then
      // beginless range (..5)
      let (hi, r2) = parse_bin r 1 in
      (ERange (ENil, hi, str_eq p "..."), r2)
    else if str_eq p "->" then
      // -> (params) { body } / -> x { body } / -> { body } lambda literal.
      let (params, lds, r1) =
        (match r with
         | Cons (TP lp, r2) ->
           if str_eq lp "(" then let (ps, ds, r3) = parse_params r2 Nil Nil in (ps, ds, r3)
           else if str_eq lp "*" || str_eq lp "**" || str_eq lp "&" then lambda_bare_params r Nil Nil
           else (Nil, Nil, r)
         | Cons (TId n, r2) ->
           if str_eq n "do" then ((Nil : str list), (Nil : (str * Expr) list), r)
           else lambda_bare_params r Nil Nil
         | _ -> (Nil, Nil, r)) in
      // `-> () { _1 }` has an explicit (empty) parameter list, which forbids a
      // numbered parameter in the body (checked once the body is parsed).
      let empty_parens = (match params with Nil -> (match r with Cons (TP lp, _) -> str_eq lp "(" | _ -> false) | _ -> false) in
      // `-> a=a() { a }` — the default's call grabs the brace block; when no
      // block opener follows, take that block back as the lambda body.
      let (lds, r1, swallowed) =
        (match starts_block r1 with
         | true -> (lds, r1, (false, (Nil : str list), (Nil : Stmt list)))
         | false ->
           (match last_default_block lds with
            | (true, lds2, sbp, sbb) -> (lds2, r1, (true, sbp, sbb))
            | (false, _, _, _) -> (lds, r1, (false, Nil, Nil)))) in
      let (bp, bb, r4) =
        (match swallowed with
         | (true, sbp, sbb) -> (sbp, sbb, r1)
         | (false, _, _) -> parse_block r1) in
      // carry the empty-params sentinel so a numbered param in the body is
      // rejected (numbered_misuse_expr checks a non-empty ELambda param list).
      let params = if empty_parens then Cons (empty_bp_marker, Nil) else params in
      let allp = list_append_str params bp in
      // optional params (defaults) relax the strict lambda arity check via
      // a hidden anonymous splat; kw defaults keep their own binding.
      let pds = plain_defaults lds in
      let allp2 = (match pds with
                   | Nil -> allp
                   // named, so it can be told apart from a splat the source
                   // actually wrote: `->(a, b=1){}.parameters` must not report it.
                   | _ -> if psplat_any allp then allp else list_append_str allp (Cons ("*__opt", Nil))) in
      (ELambda (allp2, defaults_prologue (app_ds pds (kw_defaults_bare lds)) bb), r4)
    else (let __fm = ("mere-ruby: unexpected token: " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: unexpected end of input" ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)

and parse_array = fn toks0 ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (EArr Nil, r) else parse_arr_items toks Nil
  | _ -> parse_arr_items toks Nil

and parse_arr_items = fn toks -> fn (acc: Expr list) ->
  // splat element [*x] and symbol-key trailing hash [.., k: v] forms.
  match toks with
  | Cons (TP st, r0b) ->
    if str_eq st "*" then
      let (inner, r1) = parse_expr r0b in
      arr_items_sep (skip_nls r1) (Cons (ESplat inner, acc))
    // `[**h]` starts the trailing hash, exactly as `[k: v]` does: everything
    // after it is a hash item, they all merge into ONE element, and Ruby drops
    // that element entirely when the merge comes out empty.
    else if str_eq st "**" then
      let (inner, r1) = parse_expr r0b in
      arr_hash_items (skip_nls r1) acc (Cons (EKwSplat inner, Cons (EKwSplat inner, Nil))) true
    else parse_arr_expr toks acc
  | Cons (TId n, Cons (TP col, r0c)) ->
    if str_eq col ":" then
      let (v, r1) = parse_expr (skip_nls r0c) in
      arr_hash_items (skip_nls r1) acc (Cons (v, Cons (ESym n, Nil))) false
    else parse_arr_expr toks acc
  | _ -> parse_arr_expr toks acc

and arr_items_sep = fn r -> fn (acc: Expr list) ->
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `[1, 2,]` — a hanging comma before the closing bracket.
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app acc Nil), r3)
         else parse_arr_items (skip_nls r2) acc
       | _ -> parse_arr_items (skip_nls r2) acc)
    else if str_eq p "]" then (EArr (rev_app acc Nil), r2)
    else (let __fm = ("mere-ruby: expected , or ] in array, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

and parse_arr_expr = fn toks -> fn (acc: Expr list) ->
  let (e, r0) = parse_expr toks in
  let r = skip_nls r0 in   // allow a newline before the , or ]
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app (Cons (e, acc)) Nil), r3)
         else parse_arr_items (skip_nls r2) (Cons (e, acc))
       | _ -> parse_arr_items (skip_nls r2) (Cons (e, acc)))
    else if str_eq p "]" then (EArr (rev_app (Cons (e, acc)) Nil), r2)
    // trailing hash without braces: ["a", "b" => 1, "c" => 2]
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      arr_hash_items r3 acc (Cons (v, Cons (e, Nil))) false
    else (let __fm = ("mere-ruby: expected , or ] in array, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

// remaining k => v pairs of an array's trailing hash (hp is reversed v,k).
and arr_hash_items = fn toks -> fn (acc: Expr list) -> fn (hp: Expr list) -> fn (kw: bool) ->
  match toks with
  | Cons (TP p, r) ->
    // a hash built from `**` is dropped when it is empty, which is what the
    // EKwSplat wrapper says; a plain `[k: v]` hash is always an element.
    if str_eq p "]" then
      (let h = EHsh (rev_app hp Nil) in
       (EArr (rev_app acc (Cons ((if kw then EKwSplat h else h), Nil))), r))
    else if str_eq p "," then
      (match skip_nls r with
       | Cons (TId n2, Cons (TP c2, r2b)) ->
         if str_eq c2 ":" then
           let (v, r4) = parse_expr (skip_nls r2b) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (ESym n2, hp))) kw
         else
           let (k, r2) = parse_expr (skip_nls r) in
           let r3 = expect r2 "=>" in
           let (v, r4) = parse_expr (skip_nls r3) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw
       | Cons (TP dsp, r2c) ->
         if str_eq dsp "**" then
           (let (inner, r1b) = parse_expr r2c in
            arr_hash_items (skip_nls r1b) acc (Cons (EKwSplat inner, Cons (EKwSplat inner, hp))) true)
         else
           (let (k, r2) = parse_expr (skip_nls r) in
            let r3 = expect r2 "=>" in
            let (v, r4) = parse_expr (skip_nls r3) in
            arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw)
       | other ->
         let (k, r2) = parse_expr other in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw)
    else (let __fm = ("mere-ruby: expected , or ] in array hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

and parse_hash = fn toks ->
  // a multiline hash literal may break after `{` (and before `}`).
  let toks = skip_nls toks in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "}" then (EHsh Nil, r) else parse_hash_items toks Nil
  | _ -> parse_hash_items toks Nil

// a general hash key: `expr => v`, or `"string": v` (a symbol key).
and hash_key_expr = fn toks ->
  let (ke, r) = parse_expr toks in
  match r with
  | Cons (TP c, r2) ->
    // ⚠ `{"a": 1}` becomes `"a".to_sym`, so the invalid-symbol check further
    // down (which looks for ESym) cannot see it. A LITERAL string here is
    // known at parse time, so it is turned into the symbol now -- and an
    // invalid one is the same parse error `:"\xC3"` is.
    if str_eq c ":" then
      (match ke with
       | EStrL lit9 -> (ESym lit9, r2)
       | _ -> (EMethod (ke, "to_sym", Nil), r2))
    else (ke, expect r "=>")
  | _ -> (ke, expect r "=>")

and parse_hash_items = fn toks -> fn (acc: Expr list) ->
  // `**h` splices another hash's pairs into this literal.
  match toks with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      let (inner, r1) = parse_expr r0 in
      hash_items_sep r1 (Cons (EKwSplat inner, Cons (EKwSplat inner, acc)))
    else parse_hash_items_kv toks acc
  | _ -> parse_hash_items_kv toks acc

// ⚠ FOUR places closed a hash literal, and the duplicate-key check has to run
// at every one of them or it runs at none that matter: adding it to two left
// `x = {a: 1, a: 2}` silent, because the `name:` shorthand closes elsewhere.
// They all go through here now.
and hsh_done = fn (acc: Expr list) -> fn (ln: int) -> fn rest9 ->
  (let its = rev_app acc Nil in
   let _ = hsh_note_dups its (Nil : (str * int) list) ln in
   (EHsh its, rest9))
and hash_items_sep = fn r3 -> fn (acc: Expr list) ->
  let done9 = hsh_done acc (tok_line r3) in
  match skip_nls r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then done9 r5
         else parse_hash_items (skip_nls r4) acc
       | _ -> parse_hash_items (skip_nls r4) acc)
    else if str_eq p "}" then done9 r4
    else (let __fm = ("mere-ruby: expected , or } in hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated hash literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated hash literal" ++ parsing_file ()))

and parse_hash_items_kv = fn toks -> fn (acc: Expr list) ->
  // `name: value` symbol-key shorthand is equivalent to `:name => value`.
  let (k, r2) =
    (match toks with
     | Cons (TId name, Cons (TP colon, r0)) ->
       if str_eq colon ":" then (ESym name, r0)
       else hash_key_expr toks
     | _ -> hash_key_expr toks) in
  // `{a:}` / `{a:, b:}` — an omitted value reads the same-named variable.
  // The delimiter that says so, like the value itself, may be on the next
  // line, so both are decided after the newlines.
  let omitted =
    (match k with
     | ESym _ ->
       (match skip_nls r2 with
        | Cons (TP nx, _) -> str_eq nx "}" || str_eq nx ","
        | _ -> false)
     | _ -> false) in
  if omitted then
    (match k with
     // ⚠ the omitted-value form reads a VARIABLE of the same name, and `a!` or
     // `a?` is not one -- ruby refuses `{a!:}` at parse time rather than
     // looking for it. Building the EVar made it a NameError at RUN time, so
     // anything before it in the same eval had already happened.
     | ESym nm when (let n9 = str_len nm in
                     n9 > 0 && (let lc = char_at nm (n9 - 1) in str_eq lc "!" || str_eq lc "?")) ->
       (let _ = (if map_has prim_missing "i" then ()
                 else map_set prim_missing "i"
                        (mkstr ("mere-ruby: identifier " ++ nm ++ " is not valid to get"))) in
        fail ("mere-ruby: identifier " ++ nm ++ " is not valid to get" ++ parsing_file ()))
     | ESym nm -> hash_items_sep (skip_nls r2) (Cons (EVar nm, Cons (k, acc)))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad hash key")) in fail "mere-ruby: bad hash key"))
  else
  let (v, r3a) = parse_expr (skip_nls r2) in
  let r3 = skip_nls r3a in
  match r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      // `{a: 1, b: 2,}` — a hanging comma before the closing brace.
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then hsh_done (Cons (v, Cons (k, acc))) (tok_line r3) r5
         else parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc)))
       | _ -> parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc))))
    else if str_eq p "}" then hsh_done (Cons (v, Cons (k, acc))) (tok_line r3) r4
    else (let __fm = ("mere-ruby: expected , or } in hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated hash literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated hash literal" ++ parsing_file ()))

// call arguments after the opening `(` (already consumed); handles the
// empty `()` case.
and parse_call_args = fn toks0 ->
  // a newline right after `(` is allowed (multi-line argument lists).
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (Nil, r) else parse_call_items toks Nil
  | _ -> parse_call_items toks Nil

// Arguments may end with bare hash pairs — old-style `k => v` or keyword
// `name: value` — which Ruby collects into a single trailing Hash argument.
// `pos` accumulates positional args (reversed); `hp` accumulates hash pairs
// as v,k,v,k (reversed), emitted as one trailing EHsh.
and parse_call_items = fn toks -> fn (acc: Expr list) ->
  parse_call_go toks acc Nil

and parse_call_go = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TId name, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      // `m(a:, b:)` — an omitted value reads the same-named variable. The
      // delimiter that says the value was omitted may be on the NEXT line
      // (sass-embedded writes a multi-line call that way), and a value may
      // equally start there, so the decision is made after the newlines.
      (match skip_nls r0 with
       | Cons (TP nx, _) ->
         if str_eq nx "," || str_eq nx ")" then
           parse_call_sep (skip_nls r0) pos (Cons (EVar name, Cons (ESym name, hp)))
         else
           let (v, r1) = parse_expr (skip_nls r0) in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp)))
       | _ ->
         let (v, r1) = parse_expr (skip_nls r0) in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp))))
    else parse_call_pos_arg toks pos hp
  | Cons (TP star, r0) ->
    if str_eq star "*" then
      let (inner, r1) = parse_expr r0 in parse_call_sep r1 (Cons (ESplat inner, pos)) hp
    else if str_eq star "**" then
      // **hash spreads as the call's keyword hash -- so it goes on the KEYWORD
      // list, beside the explicit `k: v` pairs, and not on the positional one.
      // ⚠ it used to go on the positional list and be lifted across afterwards,
      //   which broke twice:
      //     f(**h1, **h2)   the lift only ran when there was at least one
      //                     explicit pair, so with none the splats stayed
      //                     POSITIONAL and the callee got "wrong number of
      //                     arguments (given 1, expected 0)" where ruby merges
      //                     them into {a: 4, b: 2, c: 7}
      //     f(**h, d: 9)    the lift appended the splats AFTER the pairs, so
      //                     the keys came out {d: 9, a: 1, b: 2} where ruby
      //                     keeps source order, {a: 1, b: 2, d: 9} -- and the
      //                     same reordering decides which duplicate key wins
      //   Both are the same fact: the two lists lost the order they were
      //   written in. Doubled, which is the marker hsh_eval_items reads.
      let (inner, r1) = parse_expr r0 in
      parse_call_sep r1 pos (Cons (EKwSplat inner, Cons (EKwSplat inner, hp)))
    else if str_eq star "..." then
      // `foo(...)` (immediately closed) forwards the collected positional
      // args; `foo(...expr)` is a beginless exclusive range argument.
      (match r0 with
       | Cons (TP q, _) ->
         if str_eq q ")" then
           parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), Cons (ESplat (EVar "__fwd"), pos))) hp
         else let (hi, r1) = parse_expr r0 in
              parse_call_sep r1 (Cons (ERange (ENil, hi, true), pos)) hp
       | _ ->
         let (hi, r1) = parse_expr r0 in
         parse_call_sep r1 (Cons (ERange (ENil, hi, true), pos)) hp)
    else if str_eq star "&" then
      // block-pass `&:sym` / `&expr`; bare `&` forwards the anonymous block.
      (match r0 with
       | Cons (TP nx, _) ->
         if str_eq nx ")" || str_eq nx "," then
           parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), pos)) hp
         else let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp
       | _ -> let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp)
    else parse_call_pos_arg toks pos hp
  | _ -> parse_call_pos_arg toks pos hp

and parse_call_pos_arg = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in parse_call_sep r3 pos (Cons (v, Cons (e, hp)))
    else parse_call_sep r (Cons (e, pos)) hp
  | _ -> parse_call_sep r (Cons (e, pos)) hp

and parse_call_sep = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match skip_nls toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `f(1,)` — a vestigial trailing comma before the close paren.
      (match skip_nls r with
       | Cons (TP rp, r2) ->
         if str_eq rp ")" then (finish_call_args pos hp, r2) else parse_call_go (skip_nls r) pos hp
       | _ -> parse_call_go (skip_nls r) pos hp)
    else if str_eq p ")" then (finish_call_args pos hp, r)
    else (let __fm = ("mere-ruby: expected , or ) in argument list, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated argument list" ++ parsing_file ()))) in fail ("mere-ruby: unterminated argument list" ++ parsing_file ()))

and finish_call_args = fn (pos: Expr list) -> fn (hp: Expr list) ->
  match hp with
  | Nil -> rev_app pos Nil
  | _ ->
    // `f(a: 1, **h)` -- a keyword splat belongs to the SAME keyword hash as
    // the explicit pairs, not to the positional list, or the callee sees two
    // arguments. Lift it out and splice it (doubled: the marker
    // hsh_eval_items uses), after the pairs so a later splat wins.
    // A block-pass has to stay LAST: the callee finds it by looking at the end
    // of the argument list, and the keyword hash is appended after the
    // positionals. `g(*a, k: k, &blk)` otherwise left `&blk` in the middle,
    // where it was evaluated as an ordinary argument (a stray nil).
    let ps0 = rev_app pos Nil in
    let ps = drop_blockpass ps0 in
    eapp (drop_kwsplats ps)
         (Cons (EKwHash (eapp (rev_app hp Nil) (kwsplats_doubled ps)), only_blockpass ps0))

// the block-pass argument (at most one), and the list without it.
and only_blockpass = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (EBlockPass b, t) -> Cons (EBlockPass b, only_blockpass t)
  | Cons (_, t) -> only_blockpass t
and drop_blockpass = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (EBlockPass _, t) -> drop_blockpass t
  | Cons (h, t) -> Cons (h, drop_blockpass t)

and drop_kwsplats = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with EKwSplat _ -> drop_kwsplats t | _ -> Cons (h, drop_kwsplats t))
and kwsplats_doubled = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with EKwSplat e -> Cons (EKwSplat e, Cons (EKwSplat e, kwsplats_doubled t)) | _ -> kwsplats_doubled t)

// ---- statements — SAME mutual-recursion group as the expression parser,
// because a block body (`{ ... }` / `do ... end`) parses statements while
// parse_postfix parses the block. ----------------------------------------
and parse_puts_args = fn toks -> fn (acc: Expr list) ->
  // trailing keyword-hash arguments in a paren-less call (`d :s, shared: true`)
  // collect into one Hash argument, like the parenthesized form.
  match toks with
  | Cons (TId kname, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      let (hp, r) = parse_bare_kw_pairs r0 kname Nil in
      (rev_app (Cons (EKwHash hp, acc)) Nil, r)
    else parse_puts_args_pos toks acc
  | Cons (TP st, r0) ->
    // A no-space `(` right after the command word is a real argument list:
    // `raise(E, "m")` / `puts(x, y)`. Parse it like any method call so a comma
    // separates arguments (parse_expr would instead read `(a, b)` as a grouped
    // expression and choke on the comma). A space-paren (" (") is left to the
    // positional path, so `p (1..3).to_a` still groups-then-chains.
    // ...only at the FIRST argument, though: after a comma we are already
    // inside the list, so `p 1, (2).abs` is a grouped expression to chain
    // from, not a second argument list.
    if str_eq st "(" && (match acc with Nil -> true | _ -> false) then
      let (a, r1) = parse_call_args r0 in (rev_app acc a, r1)
    // a keyword splat in a paren-less call: `mkdir_p subdir, **options`.
    else if str_eq st "**" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (EKwSplat inner, acc))
         else (rev_app (Cons (EKwSplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (EKwSplat inner, acc)) Nil, r1))
    // splat / block-pass arguments in a paren-less call: `send :m=, *x, 1`.
    else if str_eq st "*" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (ESplat inner, acc))
         else (rev_app (Cons (ESplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (ESplat inner, acc)) Nil, r1))
    else if str_eq st "&" then
      let (inner, r1) = parse_expr r0 in
      (rev_app (Cons (EBlockPass inner, acc)) Nil, r1)
    else parse_puts_args_pos toks acc
  | _ -> parse_puts_args_pos toks acc

and parse_bare_rockets = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then
      (match skip_nls r with
       | Cons (TNL _, _) -> (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)
       | rr ->
         let (k, r2) = parse_expr rr in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         parse_bare_rockets r4 pos (Cons (v, Cons (k, hp))))
    else (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)
  | _ -> (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)

and parse_bare_kw_pairs = fn toks -> fn (kname: str) -> fn (acc: Expr list) ->
  // ⚠ the value may be OMITTED here too. `m(a:, b:)` was handled in the
  //   parenthesised parser and `m a:, b:` was not -- this one always parsed a
  //   value, so it met the comma and died with "unexpected token: ,". ruby/spec
  //   writes `call bar:, val:` and the abort took the whole file with it.
  //   ⚠ and unlike the parenthesised form, a NEWLINE ends the call rather than
  //     continuing it, so a line break after `a:` is an omission and not the
  //     start of a value on the next line.
  let omitted9 = (match toks with
                  | Cons (TP p9, _) -> str_eq p9 "," || str_eq p9 ")" || str_eq p9 "]" || str_eq p9 "}"
                  | Cons (TNL _, _) -> true
                  | Cons (TEOF, _) -> true
                  | Nil -> true
                  | _ -> false) in
  let (v, r) = (if omitted9 then (EVar kname, toks) else parse_expr toks) in
  let acc2 = Cons (v, Cons (ESym kname, acc)) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TId k2, Cons (TP colon2, r3)) ->
         if str_eq colon2 ":" then parse_bare_kw_pairs r3 k2 acc2
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected keyword argument" ++ parsing_file ()))) in fail ("mere-ruby: expected keyword argument" ++ parsing_file ()))
       // `m f, filename: filename, **kwargs` -- the splat joins these pairs
       // (doubled, the marker hsh_eval_items uses), it is not a new argument.
       | Cons (TP dsp, r3) ->
         if str_eq dsp "**" then
           (let (inner, r4) = parse_expr r3 in
            let acc3 = Cons (EKwSplat inner, Cons (EKwSplat inner, acc2)) in
            match r4 with
            | Cons (TP c3, r5) ->
              if str_eq c3 "," then
                (match skip_nls r5 with
                 | Cons (TId k3, Cons (TP colon3, r6)) ->
                   if str_eq colon3 ":" then parse_bare_kw_pairs r6 k3 acc3
                   else (rev_app acc3 Nil, r4)
                 | _ -> (rev_app acc3 Nil, r4))
              else (rev_app acc3 Nil, r4)
            | _ -> (rev_app acc3 Nil, r4))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected keyword argument" ++ parsing_file ()))) in fail ("mere-ruby: expected keyword argument" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected keyword argument" ++ parsing_file ()))) in fail ("mere-ruby: expected keyword argument" ++ parsing_file ())))
    else (rev_app acc2 Nil, r)
  | _ -> (rev_app acc2 Nil, r)

and parse_puts_args_pos = fn toks -> fn (acc: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_puts_args (skip_nls r2) (Cons (e, acc))
    // trailing `k => v` pairs collect into one Hash argument.
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      parse_bare_rockets r3 acc (Cons (v, Cons (e, Nil)))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// parse statements until a block-closing keyword (end / else / elsif /
// when) or EOF; the closer is left unconsumed for the caller.
and parse_stmts = fn toks -> fn (acc: Stmt list) ->
  let (t, skipped) = skip_nls_n toks 0 in
  let _ = parse_line_add skipped in
  match t with
  | Cons (TEOF, _) -> (rev_app acc Nil, t)
  | Cons (TId id, _) ->
    if is_block_stop id then (rev_app acc Nil, t)
    else
      let ln = tok_line t in
      let acc = (match acc with
                 | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
                 | _ -> acc) in
      let (s0, r0) = parse_stmt t in
      let (s0, r0) = grow_setter_stmt s0 r0 in
      let (s, r) = apply_modifier s0 r0 in
      parse_stmts (expect_end r) (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))
  | _ ->
    let ln = tok_line t in
    let acc = (match acc with
               | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
               | _ -> acc) in
    let (s0, r0) = parse_stmt t in
    let (s0, r0) = grow_setter_stmt s0 r0 in
    let (s, r) = apply_modifier s0 r0 in
    parse_stmts (expect_end r) (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))

// trailing statement modifiers: `STMT if C`, `unless C`, `while C`,
// `until C`. Each desugars to the corresponding block form wrapping the
// single statement.
and apply_modifier = fn (s: Stmt) -> fn toks ->
  match toks with
  // ruby 4.0: a line that BEGINS with `and` / `or` continues the statement
  // before it, the way a leading `.method` continues a chain. Only those two
  // words -- a modifier keyword at line start opens a new statement.
  | Cons (TNL _, _) ->
    (let t2 = skip_nls toks in
     match t2 with
     | Cons (TId w, _) -> if str_eq w "and" || str_eq w "or" then apply_modifier s t2 else (s, toks)
     | _ -> (s, toks))
  // one-line pattern matching at statement level: `expr => pat` (bind-or-raise)
  // and `expr in pat` (boolean). Only a plain expression statement qualifies.
  | Cons (TP arrow, r) ->
    if str_eq arrow "=>" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchBind (e, pat))) r2
       | _ -> (s, toks))
    else (s, toks)
  | Cons (TId id, r) ->
    if str_eq id "in" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchTest (e, pat))) r2
       | _ -> (s, toks))
    else if str_eq id "if" then
      let (c0, r2) = parse_andor (skip_nls r) in
      let c = cond_ff c0 in
      apply_modifier (SIf (Cons ((c, Cons (s, Nil)), Nil), decl_of s)) r2
    else if str_eq id "unless" then
      let (c0, r2) = parse_andor (skip_nls r) in
      let c = cond_ff c0 in
      apply_modifier (SIf (Cons ((EUn ("!", c), Cons (s, Nil)), Nil), decl_of s)) r2
    else if str_eq id "while" then
      let (c, r2) = parse_andor (skip_nls r) in
      // `begin ... end while cond` is do-while: run the body once, then loop.
      (match s with
       | SBegin (_, _, _, _) -> (SDoWhile (s, c), r2)
       | _ -> (SWhile (c, Cons (s, Nil)), r2))
    else if str_eq id "until" then
      let (c, r2) = parse_andor (skip_nls r) in
      (match s with
       | SBegin (_, _, _, _) -> (SDoWhile (s, EUn ("!", c)), r2)
       | _ -> (SWhile (EUn ("!", c), Cons (s, Nil)), r2))
    else if str_eq id "rescue" then
      // `expr rescue fallback` — a one-line begin/rescue.
      let (h, r2) = parse_stmt (skip_nls r) in
      // rescue binds tighter than `=`: `a = b rescue c` is `a = (b rescue c)`,
      // so the assignment still happens with the fallback value. (Op-assigns
      // like `+=` keep the whole-statement sense.)
      // a modifier may follow: `a rescue nil if c` is `(a rescue nil) if c`.
      (match s with
       | SAssign (n, rhs) ->
         apply_modifier (SAssign (n, EStmt (SBegin (Cons (SExpr rhs, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)))) r2
       | _ -> apply_modifier (SBegin (Cons (s, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)) r2)
    else if str_eq id "and" || str_eq id "or" then
      // lowest-precedence: `x = 1 and y = 2` runs the second statement
      // only when the first one's value is truthy. After break/next/
      // return the left side has no value — a SyntaxError in Ruby.
      let _ = (match s with
               | SBreak _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | SNext _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | SReturn _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | _ -> ()) in
      let (s2, r2) = parse_stmt (skip_nls r) in
      apply_modifier (if str_eq id "and" then SAndThen (s, s2) else SOrElse (s, s2)) r2
    else (s, toks)
  | _ -> (s, toks)

// `if ... end.method` — a control construct used as an expression with a
// trailing method chain (common in specs: `unless x ... end.should == y`).
and stmt_postfix = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP dot, _) ->
    if str_eq dot "." then
      let (e0, r1) = parse_postfix_more (EStmt s) toks in
      let (e, r2) = parse_more e0 r1 1 in
      (SExpr e, r2)
    // `case ... end + ...` — a binary operator continues the expression.
    else if prec_of dot > 0 then
      let (e, r2) = parse_more (EStmt s) toks 1 in (SExpr e, r2)
    else (s, toks)
  | _ -> (s, toks)

// Ruby defines the local targets of an assignment at parse time, so a
// modifier-guarded assignment that never runs still leaves nil locals.
// The skipped branch declares them (only if not already bound).
// the plain-local names among complex assignment targets (for nil-declare).
and x_target_names = fn (ts: Expr list) ->
  match ts with
  | Nil -> Nil
  | Cons (t, r) ->
    (match t with
     | EVar n ->
       if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then x_target_names r
       else Cons (n, x_target_names r)
     | ESplat inner ->
       (match inner with
        | EVar n -> Cons (n, x_target_names r)
        | _ -> x_target_names r)
     | EArr inner -> list_append_str (x_target_names inner) (x_target_names r)
     | _ -> x_target_names r)

and decl_of = fn (s: Stmt) ->
  match s with
  | SAssign (n, _) ->
    if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then Nil
    else Cons (SDeclare (Cons (n, Nil)), Nil)
  | SMultiAssign (ts, _) -> Cons (SDeclare ts, Nil)
  | SMultiAssignX (ts, _) -> Cons (SDeclare (x_target_names ts), Nil)
  | _ -> Nil

// a statement that begins `id ,` (a bare non-keyword identifier then a
// comma) or `* id` is a multiple assignment target list.
and looks_like_multi = fn toks ->
  match toks with
  | Cons (TId nm, Cons (TP c, _)) -> (if is_keyword nm then false else str_eq c ",")
  | Cons (TP star, Cons (TId _, _)) -> str_eq star "*"
  | _ -> false

// `undef a, b, :c` — a comma-separated list of bare/:symbol method names.
and parse_undef_names = fn toks -> fn (acc: str list) ->
  let (n, r) = parse_alias_name toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_undef_names (skip_nls r2) (Cons (n, acc)) else (rev_app (Cons (n, acc)) Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, r)

// an alias name is a bare identifier or a :symbol.
// fold a constant string/symbol interpolation expression to its text, for
// dynamic alias/undef names like alias :"#{'m3'}" m1.
and const_fold_str = fn (e: Expr) ->
  match e with
  | EStrL s -> s
  | ESym s -> s
  | EInt n -> str_of_int n
  | EBig s -> s
  | EBool b -> if b then "true" else "false"
  | ENil -> ""
  | EBin (o, a, b) -> if str_eq o "+" then const_fold_str a ++ const_fold_str b else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")
  // `__interp_str` is what an interpolation desugars to (v0.1-era it was
  // `to_s`); an alias name built from one has to fold the same way.
  | EMethod (rc, m, _) -> if str_eq m "to_s" || str_eq m "to_sym" || str_eq m "to_str" || str_eq m "__interp_str" then const_fold_str rc else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")

and parse_alias_name = fn toks ->
  match toks with
  // `alias expires_at= expires=` — a setter's name carries its `=`.
  | Cons (TId n, Cons (TP eq, r)) -> if str_eq eq "=" then (n ++ "=", r) else (n, Cons (TP eq, r))
  | Cons (TId n, r) -> (n, r)
  | Cons (TSym n, r) -> (n, r)
  | Cons (TP op, r) ->
    // the lexer marks a space-before punctuator (" &", " (", " [") so a
    // paren-less call can be told from an operator; in `alias intersection &`
    // the marker is noise and the name is the bare operator.
    let op = (if str_len op > 1 && str_eq (char_at op 0) " " then substring op 1 (str_len op) else op) in
    // an interpolated symbol :"#{...}" lexes as ("" + ...).to_sym; fold it.
    if str_eq op "(s" then
      (let (e, r2) = parse_primary toks in
       let folded = const_fold_str e in
       let r3 = (match r2 with Cons (TP dot, Cons (TId ts, r4)) -> if str_eq dot "." && (str_eq ts "to_sym" || str_eq ts "to_s") then r4 else r2 | _ -> r2) in
       (folded, r3))
    else if is_op_method_name op then (op, r)
    else if str_eq op "[" then
      (match r with
       | Cons (TP rb2, r2) ->
         if str_eq rb2 "]" then
           (match r2 with
            | Cons (TP eq2, r3) -> if str_eq eq2 "=" then ("[]=", r3) else ("[]", r2)
            | _ -> ("[]", r2))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))

// consume optional `, Name, Name` after `include M` (ignored).
and maybe_more_names = fn toks ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then (match r with Cons (TId _, r2) -> maybe_more_names r2 | _ -> (0, toks))
    else (0, toks)
  | _ -> (0, toks)

// extend a constant name with any trailing `::Name` scope segments.
// split a qualified constant name at its FIRST "::" ("A::B::C" -> "A", "B::C").
and dcolon_at = fn (n: str) -> fn (i: int) ->
  if i + 1 >= str_len n then str_len n
  else if str_eq (char_at n i) ":" && str_eq (char_at n (i + 1)) ":" then i
  else dcolon_at n (i + 1)
and const_head = fn (n: str) -> substring n 0 (dcolon_at n 0)
and const_tail = fn (n: str) ->
  let i = dcolon_at n 0 in
  if i + 2 >= str_len n then "" else substring n (i + 2) (str_len n)

and scoped_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, Cons (TId n, r)) -> if str_eq p "::" then scoped_name (acc ++ "::" ++ n) r else (acc, toks)
  | _ -> (acc, toks)

// extend `A::B` through further ::Name segments; returns (full, rest).
and scoped_const_path = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TId n, r) ->
    if is_cap n then
      (match r with
       | Cons (TP sc, r2) ->
         if str_eq sc "::" then scoped_const_path (acc ++ "::" ++ n) r2
         else (acc ++ "::" ++ n, r)
       | _ -> (acc ++ "::" ++ n, r))
    else (acc, toks)
  | _ -> (acc, toks)

and parse_multi = fn toks ->
  let (targets, r) = parse_target_list toks Nil in   // consumes through `=`
  let (rhs, r2) = parse_rhs_list (skip_nls r) Nil in
  (SMultiAssign (targets, rhs), r2)

// multiple assignment whose targets include indexing / attribute writes
// (`foo[0], bar.baz = a, b`). Targets parse as postfix chains; the writer
// invokes m= / []= at assignment time.
// replace the last argument v with [v, more...] (multi-value []= RHS).
// `a[i] = 1, 2` and `o.x = 1, 2` assign the ARRAY: the values after the comma
// grow the setter's last argument. The parenthesised form `(a[i] = 1, 2)`
// already did this; a bare statement did not, and stopped at the comma.
and grow_setter_stmt = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP c, r1) when str_eq c "," ->
    (match s with
     | SExpr (EMethod (recv, mn, margs)) ->
       (if str_eq mn "[]=" || (str_len mn > 1 && str_eq (char_at mn (str_len mn - 1)) "="
                               && (if str_eq mn "==" then false else true)) then
          (let (more, r2) = parse_rhs_list (skip_nls r1) Nil in
           (SExpr (EMethod (recv, mn, grow_last_arg margs more)), r2))
        else (s, toks))
     | _ -> (s, toks))
  | _ -> (s, toks)

and grow_last_arg = fn (args: Expr list) -> fn (more: Expr list) ->
  match args with
  | Nil -> Cons (EArr more, Nil)
  | Cons (v, Nil) -> Cons (EArr (Cons (v, more)), Nil)
  | Cons (h, t) -> Cons (h, grow_last_arg t more)

and parse_multix = fn toks ->
  let (targets, r) = parse_x_targets toks Nil in
  let (rhs, r2) = parse_rhs_list (skip_nls r) Nil in
  (SMultiAssignX (targets, rhs), r2)

and parse_x_targets = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         // `* = 1` — an anonymous splat consumes (and discards) values.
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx "=" || str_eq nx "," then (ESplat ENil, r0)
            else let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1)
          | _ -> let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `a, = 1` — a trailing comma ends the target list. The list may also
      // wrap after the comma (`a, b,\n  c = rhs`).
      (match skip_nls r2 with
       | Cons (TP eq2, r3) ->
         if str_eq eq2 "=" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_targets (skip_nls r2) (Cons (t, acc))
       | _ -> parse_x_targets (skip_nls r2) (Cons (t, acc)))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or = in multiple assignment, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))) in fail ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))

// one assignment target: a name (local/@ivar/$global) followed by .attr /
// [index] chains. Unlike parse_postfix this never consumes `= rhs`.
and parse_x_target1 = fn toks ->
  match toks with
  | Cons (TId nm, r) ->
    if is_ivar nm then parse_x_chain (EIVar (substring nm 1 (str_len nm))) r
    // a capitalized receiver is a CONSTANT (`x, Encoding.default_external =
    // ...` writes through the class), not a local variable read.
    else if is_cap nm then parse_x_chain (EConst nm) r
    else parse_x_chain (EVar nm) r
  // a parenthesized group destructures one value: ((a, b), c) = ...
  // `is_lparen`, not `str_eq lp "("`: a paren after a comma carries the space
  // in its token (`y, (a, b) = ...`), and only the statement-initial one is
  // spelled bare.
  | Cons (TP lp, r) ->
    if is_lparen lp then
      // ...but the SAME token opens a parenthesized RECEIVER:
      //   (list << :a; obj).attr, (list << :b; obj).attr = c, d
      // is how ruby/spec pins the evaluation order of a multiple assignment.
      // Which one it is shows up AFTER the matching close paren -- a group is
      // followed by `,` or `=`, a receiver by a call -- and reading every `(`
      // as a group made the whole file a parse error, so language/
      // assignments_spec never ran a single example.
      (match after_x_lparen r 1 with
       | Cons (TP nxt, _) ->
         if str_eq nxt "." || str_eq nxt "&." || str_eq nxt "::"
            || str_eq nxt "[" || str_eq nxt " [" then
           (let (e0, r1) = parse_primary toks in parse_x_chain e0 r1)
         else (let (ts, r2) = parse_x_group r Nil in (EArr ts, r2))
       | _ -> (let (ts, r2) = parse_x_group r Nil in (EArr ts, r2)))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")
  // Every other token kind, and the empty list. The two arms above are
  // `Cons (TId ..)` and `Cons (TP ..)`, so a `TStr` or a `TInt` in a target
  // position fell through as well -- the exhaustiveness checker compares
  // top-level constructors only, so it could name `Nil` but not that. `Nil`
  // itself looks unreachable (lex_go always appends TEOF, and the only thing
  // that strips it builds interpolation sublists that get spliced into a
  // longer stream) -- but not needing to prove that is the point. Both get the
  // refusal the line above already writes for a `TP` that is not `(`, because
  // neither is a target and neither has an answer to invent.
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

// the tokens AFTER the paren group whose open has already been consumed --
// a balanced scan, so a nested call or literal inside does not end it early.
and after_x_lparen = fn toks -> fn (depth: int) ->
  match toks with
  | Nil -> Nil
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" || str_eq p " (s" then
      after_x_lparen r (depth + 1)
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth <= 1 then r else after_x_lparen r (depth - 1))
    else after_x_lparen r depth
  | Cons (_, r) -> after_x_lparen r depth
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

and parse_x_group = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx ")" || str_eq nx "," then (ESplat ENil, r0)
            else let (i, r1) = parse_x_target1 r0 in (ESplat i, r1)
          | _ -> let (i, r1) = parse_x_target1 r0 in (ESplat i, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // a grouped target list may WRAP after its comma, the same way the outer
      // list may: ruby/spec writes one nested group across five lines. Leaving
      // the newline in place made the next target a TNL, which is not an
      // assignment target -- "bad assignment target" for a perfectly ordinary
      // continuation line.
      (match skip_nls r2 with
       // `(e,)` — a trailing comma inside the group
       | Cons (TP rp, r3) ->
         if str_eq rp ")" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_group (skip_nls r2) (Cons (t, acc))
       | _ -> parse_x_group (skip_nls r2) (Cons (t, acc)))
    else if str_eq p ")" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or ) in grouped target, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated grouped target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated grouped target" ++ parsing_file ()))

and parse_x_chain = fn (recv: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (EMethod (recv, m, Nil)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else if str_eq p "[" then
      let (idxs, r2) = parse_x_idx r Nil in
      parse_x_chain (EMethod (recv, "[]", idxs)) r2
    else if str_eq p "&." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (ESafe (recv, m, Nil)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else if str_eq p "::" then
      (match r with
       | Cons (TId cn, r2) ->
         let recv2 = (match recv with EVar n -> (if is_upper_first n then EConst n else recv) | _ -> recv) in
         parse_x_chain (EScopedRead (recv2, cn)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else (recv, toks)
  | _ -> (recv, toks)

and parse_x_idx = fn toks -> fn (acc: Expr list) ->
  // an index may be written across lines -- `new_site[\n  /re/, 1\n]`
  // (addressable) -- so newlines are skipped where a paren-less argument list
  // would skip them: before an index, and after each comma.
  let toks = skip_nls toks in
  // `recv[k: v, ...]` — labels are one trailing Hash argument, the same as
  // `recv[k => v]`, and `Hash[a: 1]` is how ruby's own specs write it.
  match toks with
  | Cons (TId lbl, Cons (TP lc, lr)) when str_eq lc ":" ->
    (let (v, r1) = parse_expr (skip_nls lr) in
     let (pairs, r2) = parse_x_idx_pairs r1 (Cons (v, Cons (ESym lbl, Nil))) in
     (rev_app (Cons (EHsh (rev_app pairs Nil), acc)) Nil, r2))
  | _ ->
  let (e, r) =
    (match toks with
     | Cons (TP st, r0) ->
       if str_eq st "*" then let (i, r1) = parse_expr r0 in (ESplat i, r1)
       // `recv[&blk]` — a block-pass index argument (recv.[](&blk)).
       else if str_eq st "&" || str_eq st " &" then let (i, r1) = parse_expr r0 in (EBlockPass i, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match skip_nls r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_x_idx r2 (Cons (e, acc))
    else if str_eq p "]" then (rev_app (Cons (e, acc)) Nil, r2)
    // `recv[k => v, ...]` — the pairs form a single trailing Hash argument
    // (this is how Hash[1 => 2] and obj[k => v] are written).
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      let (pairs, r4) = parse_x_idx_pairs r3 (Cons (v, Cons (e, Nil))) in
      (rev_app (Cons (EHsh (rev_app pairs Nil), acc)) Nil, r4)
    else (let __fm = ("mere-ruby: expected , or ] in index target, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated index target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated index target" ++ parsing_file ()))

and parse_x_idx_pairs = fn toks -> fn (acc: Expr list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (acc, r)
    else if str_eq p "," then
      (match skip_nls r with
       | Cons (TId lbl2, Cons (TP lc2, lr2)) when str_eq lc2 ":" ->
         (let (v, r4) = parse_expr (skip_nls lr2) in
          parse_x_idx_pairs r4 (Cons (v, Cons (ESym lbl2, acc))))
       | _ ->
      let (k, r2) = parse_expr r in
      (match r2 with
       | Cons (TP a, r3) -> if str_eq a "=>" then (let (v, r4) = parse_expr r3 in parse_x_idx_pairs r4 (Cons (v, Cons (k, acc)))) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected => in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected => in index hash" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected => in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected => in index hash" ++ parsing_file ()))))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or ] in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected , or ] in index hash" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated index hash" ++ parsing_file ()))) in fail ("mere-ruby: unterminated index hash" ++ parsing_file ()))

// does this statement look like a complex multiple assignment? Scan to a
// top-level `=` requiring a top-level `,` first; two adjacent value tokens
// (a paren-less command call) or a structural keyword call it off.
and looks_like_multix = fn toks ->
  match toks with
  // `self.a, self.b = ...` — self is a keyword, but here it is the receiver of
  // an attribute writer, which is a perfectly ordinary assignment target.
  | Cons (TId nm, r0) ->
    // ...and `self[k1], self[k2] = ...` / `self::A, self::B = ...`, which are
    // the same thing through []= and a constant write. Only `.` was allowed,
    // so a `def assign` that writes two subscripts of self -- which is how
    // ruby/spec checks that form at all -- was not read as an assignment.
    if str_eq nm "self" then
      (match r0 with
       | Cons (TP d, _) ->
         (str_eq d "." || str_eq d "[" || str_eq d " [" || str_eq d "::")
         && scan_mx toks 0 false false
       | _ -> false)
    else if is_keyword nm then false else scan_mx toks 0 false false
  // a leading group: a comma or splat at depth 1 marks targets too ((*a) = ...)
  | Cons (TP lp, r) ->
    if str_eq lp "(" then scan_mx toks 0 false true
    // a leading splat is itself a target (* = 1, *a = ...), if an = follows.
    else if str_eq lp "*" then scan_mx r 0 true false
    else false
  | _ -> false

and scan_mx = fn toks -> fn (depth: int) -> fn (seen: bool) -> fn (grp: bool) ->
  match toks with
  | Nil -> false
  // A newline (or a `;`, which lexes as one) INSIDE parens does not end the
  // statement -- `(list << :a; obj).attr, ... = ...` is one assignment, and
  // stopping here said it was not a multiple assignment at all. The whole of
  // language/assignments_spec then failed to parse on that one line.
  | Cons (TNL _, r) -> if depth > 0 then scan_mx r depth seen grp else false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) ->
    if str_eq w "do" || str_eq w "then" || str_eq w "if" || str_eq w "unless" ||
       str_eq w "while" || str_eq w "until" || str_eq w "and" || str_eq w "or" ||
       str_eq w "rescue" then false
    else
      (match r with
       | Cons (TId _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TInt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TFlt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TStrL _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TSym _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | _ -> scan_mx r depth seen grp)
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      scan_mx r (depth + 1) seen grp
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then scan_mx r (depth - 1) seen grp
    // a target list may wrap right after a comma (`a, b,\n  c = rhs`)
    else if depth == 0 && str_eq p "," then scan_mx (skip_nls r) depth true grp
    else if grp && depth == 1 && (str_eq p "," || str_eq p "*") then scan_mx r depth true grp
    else if depth == 0 && str_eq p "=" then seen
    else if depth == 0 && str_eq p "?" then false
    else if depth == 0 && (if str_eq (opassign_base p) "" then false else true) then false
    else scan_mx r depth seen grp
  | Cons (_, r) -> scan_mx r depth seen grp

and parse_target_list = fn toks -> fn (acc: str list) ->
  let (t, r) = parse_one_target toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_target_list r2 (Cons (t, acc))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or = in multiple assignment, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))) in fail ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))

and parse_one_target = fn toks ->
  match toks with
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with Cons (TId nm, r2) -> ("*" ++ nm, r2) | _ -> ("*", r))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")
  | Cons (TId nm, r) -> (nm, r)   // plain local, or @ivar (@ kept in the name)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

// the RHS of `a = ...`: one value, or a comma list / splat that builds an
// array (`a = 1, 2` and `a = *nil`).
// `x = case/if/begin ... end` — but a trailing binary operator turns the
// construct into an operand of a larger expression (case..end + case..end).
and construct_assign = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  match r4 with
  | Cons (TP op, _) ->
    // `x = if ... end.method` — the construct is the receiver of a chain, the
    // same way `if ... end.method` reads as a statement.
    if str_eq op "." || str_eq op "&." || str_eq op "[" then
      (let (e0, r5) = parse_postfix_more (EStmt sb) r4 in
       let (e, r6) = parse_more e0 r5 1 in (SAssign (id, e), r6))
    else if prec_of op > 0 then
      let (e, r5) = parse_more (EStmt sb) r4 1 in (SAssign (id, e), r5)
    else construct_target id sb r4
  | _ -> construct_target id sb r4

// `NAME = case/if/begin ... end`: a CONSTANT target has to reach the consts
// table (concurrent-ruby picks its map backend with `X = case ... end`), so
// the construct becomes the right-hand side of an ordinary assignment. A
// lowercase target keeps the local-binding path.
and construct_target = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  if is_cap id then (SAssign (id, EStmt sb), r4) else (SLocalFrom (id, sb), r4)

and sassign_rhs = fn (id: str) -> fn toks ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (single, Nil) ->
     (match single with
      | ESplat _ -> (SAssign (id, EArr es), r)
      | _ -> (SAssign (id, single), r))
   | _ -> (SAssign (id, EArr es), r))

// `break 1, 2` / `next a, b` — several values build an array.
and flow_values = fn toks -> fn (mk: Expr -> Stmt) ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (e, Nil) -> (match e with ESplat _ -> (mk (EArr es), r) | _ -> (mk e, r))
   | _ -> (mk (EArr es), r))

and parse_rhs_list = fn toks -> fn (acc: Expr list) ->
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    // a newline after the comma continues the list, as ruby's does
    // (`private_constant :A,\n                  :B`).
    if str_eq p "," then parse_rhs_list (skip_nls r2) (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// the read side of a constant op-assign: `||=` treats an undefined constant as
// nil (then assigns); every other op reads it first (NameError if undefined).
and opasgn_const_read = fn (base: str) -> fn (full: str) ->
  if str_eq base "||" then EConstOrNil full else EConst full

and parse_stmt = fn toks ->
  if looks_like_multix toks then parse_multix toks
  else if looks_like_multi toks then parse_multi toks else
  match toks with
  // scoped constant assignment: `A::C = e` / `A::B::C = e` / `::C = e`.
  | Cons (TId a, Cons (TP sc, Cons (TId cn, Cons (TP eq, r)))) ->
    if str_eq sc "::" && (if is_cap a then false else true) && is_cap cn && str_eq eq "=" then
      // `recv::Const = value` with a lowercase (runtime) receiver.
      let (e, r2) = parse_expr r in (SExpr (EScopedAssign (EVar a, cn, e)), r2)
    else if str_eq sc "::" && is_cap a && is_cap cn then
      (if str_eq eq "=" then
         let (e, r2) = parse_expr (skip_nls r) in (SAssign (a ++ "::" ++ cn, e), r2)
       else if not (str_eq (opassign_base eq) "") then
         // `A::C op= e` -> `A::C = A::C op e`. `||=` reads undefined as nil;
         // other ops read first, so an undefined constant raises NameError.
         let full = a ++ "::" ++ cn in
         let (e, r2) = parse_expr (skip_nls r) in
         (SAssign (full, EBin (opassign_base eq, opasgn_const_read (opassign_base eq) full, e)), r2)
       else if str_eq eq "::" then
         (match scoped_const_path (a ++ "::" ++ cn) r with
          | (full, r2b) ->
            (match r2b with
             | Cons (TP eq2, r3) ->
               if str_eq eq2 "=" then let (e, r4) = parse_expr (skip_nls r3) in (SAssign (full, e), r4)
               // `A::B::C op= e` -> `A::B::C = A::B::C op e` (nil read when undefined).
               else if not (str_eq (opassign_base eq2) "") then
                 let (e, r4) = parse_expr (skip_nls r3) in
                 (SAssign (full, EBin (opassign_base eq2, opasgn_const_read (opassign_base eq2) full, e)), r4)
               else parse_stmt_id toks
             | _ -> parse_stmt_id toks))
       else parse_stmt_id toks)
    else parse_stmt_id toks
  | Cons (TP sc, Cons (TId cn, Cons (TP eq, r))) ->
    if str_eq sc "::" && str_eq eq "=" && is_cap cn then
      // `::Const = v` assigns a TOP-LEVEL constant; keep the :: so a class
      // body doesn't treat it as a class-local constant.
      let (e, r2) = parse_expr (skip_nls r) in (SAssign ("::" ++ cn, e), r2)
    else if str_eq sc "::" && is_cap cn && (if str_eq (opassign_base eq) "" then false else true) then
      // `::Const op= e` -> `::Const = ::Const op e`. The write target keeps the
      // `::` (stored top-level as the bare name), so the read uses the bare name.
      let (e, r2) = parse_expr (skip_nls r) in
      (SAssign ("::" ++ cn, EBin (opassign_base eq, opasgn_const_read (opassign_base eq) cn, e)), r2)
    else let (e, r2) = parse_expr toks in (SExpr e, r2)
  | Cons (TId id, r) -> parse_stmt_id toks
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

and parse_stmt_id = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    // A command word is a command only when it is not being ASSIGNED. `require`,
    // `puts`, `include`, `private` are ordinary method names, so they are
    // ordinary local names too, and real code uses them as such (rubocop writes
    // `require = injectable_require_directive.chomp`). Ruby's own keywords are
    // excluded: those cannot be assigned at all, so `if = 1` stays an error.
    // (an @ivar / @@cvar is an assignment too, but it has its own branch below,
    // and routing it here would silently make it a local -- which is a local
    // that nothing else ever reads.)
    if (not (is_keyword id)) && (not (is_ivar id))
       && (match r with
           | Cons (TP eq, _) -> str_eq eq "=" || not (str_eq (opassign_base eq) "")
           | _ -> false) then parse_stmt_ident toks id r
    // BEGIN { ... } / END { ... } — run the block body (BEGIN at load time).
    else if (str_eq id "BEGIN" || str_eq id "END") &&
       (match r with Cons (TP br, _) -> str_eq br "\{" | _ -> false) then
      (match r with
       | Cons (TP br, r2) ->
         let (body, r3) = parse_brace_stmts r2 Nil in
         (if str_eq id "BEGIN" then SPreexe body
          else (let n = end_site_next () in SAtExit (n, body)), r3)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block after BEGIN" ++ parsing_file ()))) in fail ("mere-ruby: expected block after BEGIN" ++ parsing_file ())))
    else if str_eq id "puts" &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      (match r with
       | Cons (TNL _, _) -> (SPuts Nil, r)
       | Cons (TEOF, _) -> (SPuts Nil, r)
       // `puts if c` / `puts unless c`: a statement modifier, not an argument.
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" ||
            str_eq w "until" || str_eq w "rescue" then (SPuts Nil, r)
         else (let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
       | _ -> let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
    else if str_eq id "if" then let (s, r2) = parse_if r false in stmt_postfix s r2
    else if str_eq id "unless" then let (s, r2) = parse_if r true in stmt_postfix s r2
    else if str_eq id "while" then let (s, r2) = parse_while r false in stmt_postfix s r2
    else if str_eq id "until" then let (s, r2) = parse_while r true in stmt_postfix s r2
    else if str_eq id "case" then let (s, r2) = parse_case r in stmt_postfix s r2
    else if str_eq id "for" then let (s, r2) = parse_for r in stmt_postfix s r2
    else if str_eq id "def" then let (s, r2) = parse_def r in stmt_postfix s r2
    else if str_eq id "class" then let (s, r2) = parse_class r in stmt_postfix s r2
    else if str_eq id "module" then let (s, r2) = parse_class r in stmt_postfix (mark_module s) r2
    else if str_eq id "begin" then let (s, r2) = parse_begin r in stmt_postfix s r2
    // `attr_accessor :a, :b` names the attributes statically, but these are
    // methods: `attr_writer name` passes a variable. A non-symbol argument
    // makes it an ordinary call.
    // ...and a bare mention with no argument at all is not a declaration either:
    // `attr_accessor` is an ordinary name, and rubocop keeps a local called
    // exactly that (`attr_accessor = "attr_accessor #{names}"`). So this reads
    // as an attribute declaration only when something that can BE an attribute
    // name follows; anything else falls through to the ordinary identifier path.
    else if (str_eq id "attr_accessor" || str_eq id "attr_reader" || str_eq id "attr_writer")
            && (match r with
                | Cons (TSym _, _) -> true
                | Cons (TStrL _, _) -> true
                | Cons (TId _, _) -> true
                | Cons (TP st, _) -> str_eq st "*" || str_eq st "("
                | _ -> false) then
      (let mode = (if str_eq id "attr_accessor" then "rw" else if str_eq id "attr_reader" then "r" else "w") in
       match r with
       | Cons (TSym _, _) -> parse_attr mode r
       | _ -> let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall (id, es))) r2)
    // `attr :sym` (and `attr :a, :b`) is the classic reader-only form.
    else if str_eq id "attr" && (match r with Cons (TSym _, _) -> true | _ -> false) then parse_attr "r" r
    else if str_eq id "alias" then
      // `alias new old` — names may be bare or :symbols.
      let (n1, r1) = parse_alias_name r in
      let (n2, r2) = parse_alias_name r1 in (SAlias (n1, n2), r2)
    else if str_eq id "undef" then
      let (names, r2) = parse_undef_names r Nil in apply_modifier (SUndef names) r2
    // `undef_method :a, :b` names methods statically, but it is a method, not
    // a keyword: `undef_method(name) if defined?` passes a variable and takes
    // a modifier, so anything that does not start with a symbol is a call.
    else if str_eq id "undef_method" then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in apply_modifier (SUndef names) r2
       | _ -> let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall ("undef_method", es))) r2)
    else if (str_eq id "include" || str_eq id "prepend") &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      // `include M[, N]` — mix module instance methods in (first module only
      // for now; extra modules are consumed and ignored).
      (match r with
       // `include Rails.application.routes.url_helpers` — the module is the
       // value of an expression, so this is a real call, resolved at run time.
       | Cons (TId m, Cons (TP dot, _)) when str_eq dot "." ->
         (let (es, r2) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r2))
       | Cons (TId m, r2) ->
         (let (full, r2b) = scoped_name m r2 in
          // `include ModuleSpecs::MVars.dup` — a scoped name with a CALL on
          // it is a value like any other, so it resolves at run time. Only a
          // bare path is the static form.
          match r2b with
          | Cons (TP dt3, _) when str_eq dt3 "." ->
            (let (es, r4) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r4))
          | _ -> let (_, r3) = maybe_more_names r2b in (SInclude (full, str_eq id "prepend"), r3))
       // `include ::A::B` — a path anchored at the top level reads the same
       // here, because constants are stored under their qualified name.
       | Cons (TP sc, Cons (TId m, r2)) when str_eq sc "::" || str_eq sc " ::" ->
         (let (full, r2b) = scoped_name m r2 in
          let (_, r3) = maybe_more_names r2b in (SInclude (full, str_eq id "prepend"), r3))
       // `include(M, N)` — the parenthesised form, which takes as many modules
       // as it is given. It used to fall through to an empty expression that
       // consumed nothing: with one module the leftover `(M)` parsed as a
       // statement of its own and the include silently did NOTHING.
       | Cons (TP lp, r2) when is_lparen lp ->
         (let (es, r3) = parse_call_args r2 in (SExpr (ECall (id, es)), r3))
       | _ -> (SExpr ENil, r))
    // The parenthesised form (`private(*names)`) is left to the ordinary call
    // path below: its arguments can be computed at runtime, which a static
    // SVis name list cannot express.
    else if (str_eq id "private" || str_eq id "public" || str_eq id "protected") &&
            // `private.should ...` — a bare visibility call used as a RECEIVER
            // (it answers nil). A `.` after the word means it is an expression,
            // not the statement form that switches the mode.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." then false else true) | _ -> true) &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      // visibility: bare form switches the mode for subsequent defs; the
      // named form (`private :m, :n`) marks those methods.
      let mode = if str_eq id "public" then "public" else if str_eq id "protected" then "protected" else "private" in
      (match r with
       | Cons (TNL _, _) -> (SVis (mode, Nil), r)
       | Cons (TEOF, _) -> (SVis (mode, Nil), r)
       // ...and the two tokens that close a body without a newline first.
       // `module_eval { module_function }` and `Module.new { private }` are
       // written that way in ruby/spec, and the bare form was recognised only
       // before a newline, so `}` was read as the start of an argument.
       | Cons (TP cb, _) -> (if str_eq cb "\}" then (SVis (mode, Nil), r)
                             else let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis (mode, names), r2)
       // `private def m ... end` — the arg is a method definition; parse it,
       // then mark it (def evaluates to its name symbol in Ruby).
       | Cons (TId dw, _) ->
         // `end` closes the body; it is not an argument (`module_eval { private
         // }`'s do-form, `class C; private; end`).
         if str_eq dw "end" then (SVis (mode, Nil), r)
         else if str_eq dw "def" then
           (let (ds, r2) = parse_stmt r in
            match ds with
            | SDef (dn, _, _, _) ->
              let base = if str_len dn > 5 && str_eq (substring dn 0 5) "self." then dn else dn in
              (SBegin (Cons (ds, Cons (SVis (mode, Cons (base, Nil)), Nil)), Nil, Nil, Nil), r2)
            | _ -> (ds, r2))
         else let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if (str_eq id "require" || str_eq id "require_relative") &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) &&
            // ⚠ ...and the same question has to be asked AFTER a parenthesised
            //   argument list, not only right after the word: `.should` there
            //   chains onto the call's RESULT, and ruby/spec writes exactly
            //   that (`require_relative(@path).should == true`). Falling
            //   through to the ordinary expression statement is the fix, and
            //   the expression form (__builtin_require_relative) already
            //   exists -- it joins against the loader's current directory at
            //   RUN time rather than the written-in file at parse time, which
            //   is the same answer except for a call inside a block that runs
            //   after its own file finished loading.
            (if tok_chains (after_parens r) then false else true) then
      // load a file into the same world (each file gets a fresh top-level).
      let (e, r2) = parse_expr r in
      // A `require_relative` means "next to the file I am written in", which is
      // not always the file the loader is in when it runs (see
      // parse_time_file). Join it here instead: the result is an absolute path,
      // so `require` uses it directly rather than searching $LOAD_PATH -- and
      // ruby's own LoadError for a missing sibling names the expanded path too.
      (let src = parse_time_file () in
       if str_eq id "require_relative" && (if str_eq src "" then false else true)
       then (SRequire (false, ECall ("__builtin_relpath", Cons (EStrL src, Cons (e, Nil)))), r2)
       else (SRequire (str_eq id "require_relative", e), r2))
    // bare `module_function` switches the enclosing module body into a mode
    // where subsequent defs are also module methods (see register_class_v).
    else if str_eq id "module_function" &&
            // as above: `module_function.should ...` is a receiver, not the
            // statement that switches the mode
            (match r with Cons (TP dt2, _) -> (if str_eq dt2 "." then false else true) | _ -> true) &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TNL _, _) -> (SVis ("module_function", Nil), r)
       | Cons (TEOF, _) -> (SVis ("module_function", Nil), r)
       // as for `private`: `}` closes the body, it does not start an argument.
       | Cons (TP cb2, _) -> (if str_eq cb2 "\}" then (SVis ("module_function", Nil), r)
                              else let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
       | Cons (TId ew2, _) ->
         (if str_eq ew2 "end" then (SVis ("module_function", Nil), r)
          else let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
       // `module_function :a, :b` promotes those named methods (handled in
       // register_class_v's named-SVis branch).
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("module_function", names), r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    // `private_class_method :m` marks a class method private (in register_class_v).
    else if str_eq id "private_class_method" &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_class_method", names), r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "private_constant" then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_constant", names), r2)
       | Cons (TNL _, _) -> (SExpr ENil, r)
       | Cons (TEOF, _) -> (SExpr ENil, r)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "public_class_method" then
      // visibility / require: accepted as no-ops.
      // (`using` is NOT here — it parses as a real call so refinements activate.)
      (match r with
       | Cons (TNL _, _) -> (SExpr ENil, r)
       | Cons (TEOF, _) -> (SExpr ENil, r)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "extend" &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true)
            // ...and an OPENING PAREN makes it an ordinary call whose result
            // can be chained: `extend(Comparable).equal?(self)` is
            // `(extend(Comparable)).equal?(self)`, but the paren-less argument
            // form below read the whole tail as the ARGUMENT and passed
            // `Comparable.equal?(self)` -- false -- to extend.
            && (match r with Cons (TP op, _) -> (if str_eq op "(" then false else true) | _ -> true) then
      // `extend M` mixes a module's instance methods into the receiver's
      // singleton class (self, in a class/module body). Parse as a real call
      // so the eval-time handler records the singleton include.
      (match r with
       | Cons (TNL _, _) -> (SExpr (ECall ("extend", Nil)), r)
       | Cons (TEOF, _) -> (SExpr (ECall ("extend", Nil)), r)
       // `extend ::A::B` — a leading "::" only anchors at the top level here,
       // where a value has to start; `a::B` elsewhere is still scope
       // resolution on `a`, so this is not a general paren-less argument form.
       | Cons (TP sc, Cons (TId m, r2)) ->
         if str_eq sc "::" || str_eq sc " ::"
         then (let (full, r2b) = scoped_name m r2 in (SExpr (ECall ("extend", Cons (EConst full, Nil))), r2b))
         else (let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
       | _ -> let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
    else if str_eq id "return" then
      (match r with
       | Cons (TNL _, _) -> (SReturn ENil, r)
       | Cons (TEOF, _) -> (SReturn ENil, r)
       // `return if c` / `return unless c` — a value-less return under a
       // statement modifier (the caller attaches the modifier).
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" || str_eq w "until" then (SReturn ENil, r)
         else
           let (es, r2) = parse_rhs_list r Nil in
           (match es with
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | Cons (TP rp, _) ->
         if str_eq rp "}" || str_eq rp ")" || str_eq rp ";" then (SReturn ENil, r)
         else
           let (es, r2) = parse_rhs_list r Nil in
           (match es with
            // `return *x` returns an array (splat-coerced), like `return a, b`.
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | _ ->
         // `return a, b` returns an array of the values.
         let (es, r2) = parse_rhs_list r Nil in
         (match es with
          | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
          | _ -> (SReturn (EArr es), r2)))
    else if str_eq id "break" then
      (match r with
       | Cons (TNL _, _) -> (SBreak ENil, r)
       | Cons (TEOF, _) -> (SBreak ENil, r)
       | Cons (TId k, _) -> if stops_value k then (SBreak ENil, r) else let (e, r2) = parse_expr r in (SBreak e, r2)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SBreak ENil, r)
         else flow_values r (fn e -> SBreak e)
       | _ -> flow_values r (fn e -> SBreak e))
    else if str_eq id "next" then
      (match r with
       | Cons (TNL _, _) -> (SNext ENil, r)
       | Cons (TEOF, _) -> (SNext ENil, r)
       | Cons (TId k, _) -> if stops_value k then (SNext ENil, r) else let (e, r2) = parse_expr r in (SNext e, r2)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SNext ENil, r)
         else flow_values r (fn e -> SNext e)
       | _ -> flow_values r (fn e -> SNext e))
    else if is_ivar id then
      // @name = expr / @name += expr, else an expression (@name read).
      let nm = substring id 1 (str_len id) in
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           let (e, r3) = parse_expr (skip_nls r2) in (SIVarAssign (nm, e), r3)
         else if not (str_eq (opassign_base p) "") then
           let (e, r3) = parse_expr (skip_nls r2) in
           // `@@x ||= v` defines the class variable when it is not defined
           // yet (Ruby special-cases that read); every other op-assign, and
           // every op-assign on an @ivar, reads normally.
           (let base = opassign_base p in
            let readx = (if str_eq base "||" && str_len nm > 0 && str_eq (char_at nm 0) "@"
                         then ECall ("__cvar_or_nil", Cons (EStrL (substring nm 1 (str_len nm)), Nil))
                         else EIVar nm) in
            (SIVarAssign (nm, EBin (base, readx, e)), r3))
         else let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))
    else parse_stmt_ident toks id r
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

// An identifier statement that is none of the command words above: a plain
// `name = ...` local assignment, or any other expression.
and parse_stmt_ident = fn toks -> fn (id: str) -> fn r ->
      // identifier or expression keyword (self/true/false/nil/Const):
      // a plain `name =` is a local assignment; everything else (including
      // method chains and expression keywords) parses as an expression.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" && not (is_keyword id) then
           // assigning to the __ENCODING__ pseudo-variable is a SyntaxError.
           if str_eq id "__ENCODING__" then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: Can't assign to __ENCODING__")) in fail "mere-ruby: Can't assign to __ENCODING__") else
           // `var = begin/case/if/unless ... end` binds the construct's value;
           // otherwise it is an ordinary assignment (`Const = expr` routes to
           // the consts table at eval). A newline may follow the `=`.
           let r2 = skip_nls r2 in
           (match r2 with
            | Cons (TId bg, r3) ->
              if str_eq bg "begin" then let (sb, r4) = parse_begin r3 in construct_assign id sb r4
              else if str_eq bg "case" then let (sb, r4) = parse_case r3 in construct_assign id sb r4
              else if str_eq bg "if" then let (sb, r4) = parse_if r3 false in construct_assign id sb r4
              else if str_eq bg "unless" then let (sb, r4) = parse_if r3 true in construct_assign id sb r4
              // chained assignment `a = b = ... = e` binds right-to-left.
              else if (match r3 with Cons (TP eq2, _) -> str_eq eq2 "=" | _ -> false) && not (is_keyword bg) then
                let (s2, r4) = parse_stmt r2 in (SLocalFrom (id, s2), r4)
              else sassign_rhs id r2
            | _ -> sassign_rhs id r2)
         else if not (str_eq (opassign_base p) "") && not (is_keyword id) && not (is_cap id) then
           // `var += expr` -> `var = var <op> expr`
           let (e, r3) = parse_expr (skip_nls r2) in
           (SAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         else if not (str_eq (opassign_base p) "") && is_cap id then
           // `Const op= expr` — a bare constant op-assign (nil read when undefined).
           let (e, r3) = parse_expr (skip_nls r2) in
           (SAssign (id, EBin (opassign_base p, EConstOrNil id, e)), r3)
         else
           let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))


// `A::B::C` in a class/module header — the flat model keys on the full
// joined name ("A::B") so `.class` etc. report it the way Ruby does.
and parse_qualified_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "::" then (match r with Cons (TId n, r2) -> parse_qualified_name (acc ++ "::" ++ n) r2 | _ -> (acc, toks))
    else (acc, toks)
  | _ -> (acc, toks)

// mark a parsed class statement as a module (sentinel superclass).
and mark_module = fn (s: Stmt) ->
  match s with
  | SClass (n, sup, body) -> if str_eq sup "" then SClass (n, "(module)", body) else s
  | _ -> s

and parse_class = fn toks ->
  match toks with
  // `class << self ... end` — the singleton class: its defs register as
  // class-level methods of the ENCLOSING class (flat-table model).
  | Cons (TP sc0, r0) ->
    if str_eq sc0 "<<" then
      (match r0 with
       // `class << self` (enclosing class) / `class << obj` (a named receiver):
       // the target name rides in the superclass field (flat-table model).
       | Cons (TId slf, r1) ->
         // an ivar/cvar/global receiver (`class << @obj`) is not an env local,
         // so it must be evaluated as an expression rather than resolved by
         // name; true/false/nil likewise route through SSingletonE.
         // any receiver other than `self` — a local variable, a method call
         // (`class << mock('x')`), or a constant (`class << O`) — is evaluated
         // as an expression so its runtime value's singleton class is opened.
         // Only `self` keeps the enclosing-class (named) path.
         if (if str_eq slf "self" then false else true) then
           let (recv, r2) = parse_expr r0 in
           let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end")
         else
           let (body, r5) = parse_class_body_tail r1 in (SClass ("<<singleton", slf, body), expect_kw r5 "end")
       // `class << <expr>` — a paren-expr / literal / ivar receiver.
       | _ ->
         let (recv, r2) = parse_expr r0 in
         let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end"))
    else if str_eq sc0 "::" then
      // `class ::C` — a top-level constant regardless of nesting. Keep the `::`
      // prefix so exec treats it as top-level (not qualified under the encloser).
      (match r0 with
       | Cons (TId slf, r1) -> let (name, r) = parse_qualified_name slf r1 in parse_class_rest ("::" ++ name) r
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ()))
  | Cons (TId name0, r0) ->
    let (name, r) = parse_qualified_name name0 r0 in
    parse_class_rest name r
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ()))

and parse_class_body_tail = fn r2 ->
    let (body0, r5a) = parse_stmts r2 Nil in
    // class-body-level rescue/ensure wraps the body in an implicit begin.
    (match r5a with
     | Cons (TId k, _) ->
       if str_eq k "rescue" || str_eq k "ensure" then
         let (rescues, ra) = parse_rescues r5a Nil in
         let (els, rb) = parse_opt_kw_block ra "else" in
         let (ens, rc) = parse_opt_kw_block rb "ensure" in
         (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
       else (body0, r5a)
     | _ -> (body0, r5a))

and parse_class_rest = fn (name: str) -> fn r ->
    (match r with
     | Cons (TP lt, r3) ->
       if str_eq lt "<" then
         // `< ::B` is a top-level constant; otherwise parse the superclass as an
         // expression. A plain constant keeps the fast name path (SClass); any
         // other expression (method call, self, paren, literal) becomes SClassE.
         (if (match r3 with Cons (TP cc, Cons (TId _, _)) -> str_eq cc "::" | _ -> false) then
            (match r3 with
             | Cons (TP _, Cons (TId sup0, r4)) ->
               let (nm, r4b) = parse_qualified_name sup0 r4 in
               let (body, r5) = parse_class_body_tail r4b in
               (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected superclass name" ++ parsing_file ()))) in fail ("mere-ruby: expected superclass name" ++ parsing_file ())))
          else
            let (se, r4) = parse_expr r3 in
            let (body, r5) = parse_class_body_tail r4 in
            (match se with
             | EConst nm -> (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (SClassE (name, se, body), expect_kw r5 "end")))
       else
         let (body, r5) = parse_class_body_tail r in
         (SClass (name, "", body), expect_kw r5 "end")
     | _ ->
       let (body, r5) = parse_class_body_tail r in
       (SClass (name, "", body), expect_kw r5 "end"))

// begin body rescue* [else] [ensure] end
and parse_begin = fn toks ->
  let (body, r) = parse_stmts toks Nil in
  let (rescues, r2) = parse_rescues r Nil in
  let (els, r3) = parse_opt_kw_block r2 "else" in
  let (ens, r4) = parse_opt_kw_block r3 "ensure" in
  (SBegin (body, rescues, els, ens), expect_kw r4 "end")

and parse_rescues = fn toks -> fn acc ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "rescue" then
      let (classes, var, prefix, r2) = parse_rescue_head r in
      let (handler, r3) = parse_stmts r2 Nil in
      // a complex capture target injects an assignment at the handler's top.
      let handler = (match prefix with Nil -> handler | Cons (s, _) -> Cons (s, handler)) in
      parse_rescues r3 (Cons ((classes, var, handler), acc))
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// `rescue [C1, C2] [=> target]` up to the newline. A bare local target keeps
// the string-var fast path; a complex lvalue (@ivar, obj.setter, obj&.setter,
// arr[i], C::X) binds the exception to a temp and returns an assignment to
// splice at the top of the handler body.
and parse_rescue_head = fn toks ->
  let (classes, r) = parse_rescue_classes toks Nil in
  let (var, prefix, r2) =
    (match r with
     | Cons (TP p, r3) ->
       if str_eq p "=>" then
         (let (tgt, r4) = parse_x_target1 r3 in
          (match tgt with
           | EVar nm -> (nm, Nil, r4)
           | _ -> let tmp = fresh_resc () in (tmp, Cons (SMultiAssignX (Cons (tgt, Nil), Cons (EVar tmp, Nil)), Nil), r4)))
       else ("", Nil, r)
     | _ -> ("", Nil, r)) in
  (classes, var, prefix, expect_end r2)

and parse_rescue_classes = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId c, r) ->
    // a bare constant matches by name (cheap path); a lowercase identifier is
    // a runtime expression (`rescue rescuer`).
    if is_cap c then
      let (full, r0) = scoped_name c r in
      (match r0 with
       | Cons (TP p, r2) ->
         if str_eq p "," then parse_rescue_classes (skip_nls r2) (Cons (full, acc))
         // `rescue C.new` — a constant followed by a `.` is the start of an
         // EXPRESSION, not the constant itself. Stopping at the constant left
         // `.new` for the caller, which was expecting `=>` or the end of the
         // line and said so. Ruby evaluates whatever is there and matches with
         // `===`, which is what makes `rescue C.new` (a matcher object) work.
         else if str_eq p "." then parse_rescue_expr_item toks acc false
         // a constant that continues (`::` handled by scoped_name) is just the
         // constant here; `=>` / newline end the class list.
         else (rev_app (Cons (full, acc)) Nil, r0)
       | _ -> (rev_app (Cons (full, acc)) Nil, r0))
    else parse_rescue_expr_item toks acc false
  // `rescue *x` / `rescue *(expr)` — splat a runtime array of exception classes.
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId v, r2) ->
         if is_cap v || (if str_len v > 0 then (if str_eq (char_at v 0) "@" then true else str_eq (char_at v 0) "$") else false)
         then parse_rescue_expr_item r acc true  // `*Const` / `*@x` as an expr
         else (match r2 with
          | Cons (TP p, r3) -> if str_eq p "," then parse_rescue_classes (skip_nls r3) (Cons ("*" ++ v, acc)) else (rev_app (Cons ("*" ++ v, acc)) Nil, r2)
          | _ -> (rev_app (Cons ("*" ++ v, acc)) Nil, r2))
       | _ -> parse_rescue_expr_item r acc true)
    // a parenthesized / lambda expression class (`rescue (expr)` / `rescue -> {..}`);
    // any other punctuation (`=>`, newline, `then`, `;`) ends the class list.
    else if is_lparen star || str_eq star "->" then parse_rescue_expr_item toks acc false
    // `rescue ::Foo::Bar => e` — a class named from the top level.
    else if str_eq star "::" || str_eq star " ::" then
      (match r with
       | Cons (TId c, r2) ->
         (let (full, r0) = scoped_name c r2 in
          match r0 with
          | Cons (TP p2, r3) ->
            if str_eq p2 "," then parse_rescue_classes (skip_nls r3) (Cons (full, acc))
            else (rev_app (Cons (full, acc)) Nil, r0)
          | _ -> (rev_app (Cons (full, acc)) Nil, r0))
       | _ -> (rev_app acc Nil, toks))
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// parse one non-constant rescue class as a runtime expression, register it,
// and continue with the "@rexpr~N" sentinel (splat prefixes it with "*").
and parse_rescue_expr_item = fn toks -> fn (acc: str list) -> fn (splat: bool) ->
  let (e0, r0) = parse_bin toks 1 in
  // an item may be a ternary: net/http picks its class with
  // `defined?(OpenSSL::SSL) ? OpenSSL::SSL::SSLError : IOError`. parse_bin
  // stops at the `?`, which left the rest of the list dangling.
  let (e, r) =
    (match r0 with
     | Cons (TP q, rq) ->
       if str_eq q "?" then
         (let (t, r1) = parse_expr (skip_nls rq) in
          match r1 with
          | Cons (TP colon, r2) ->
            if str_eq colon ":" then (let (f, r3) = parse_expr (skip_nls r2) in (ETern (e0, t, f), r3))
            else (e0, r0)
          | _ -> (e0, r0))
       else (e0, r0)
     | _ -> (e0, r0)) in
  let sentinel = (if splat then "*" else "") ++ resc_reg e in
  (match r with
   | Cons (TP p, r2) -> if str_eq p "," then parse_rescue_classes (skip_nls r2) (Cons (sentinel, acc)) else (rev_app (Cons (sentinel, acc)) Nil, r)
   | _ -> (rev_app (Cons (sentinel, acc)) Nil, r))

and parse_opt_kw_block = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) -> if str_eq id kw then parse_stmts r Nil else (Nil, toks)
  | _ -> (Nil, toks)

and parse_attr = fn (mode: str) -> fn toks ->
  let (syms, r) = parse_sym_list toks Nil in
  // `attr :a, true` is ruby's old spelling of attr_accessor (and `, false` of
  // attr_reader). The flag is not a name, so parse_sym_list leaves it here.
  match r with
  | Cons (TId flag, r2) when str_eq flag "true" -> (SAttr ("rw", syms), r2)
  | Cons (TId flag, r2) when str_eq flag "false" -> (SAttr ("r", syms), r2)
  | _ -> (SAttr (mode, syms), r)

and parse_sym_list = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TSym s, r) ->
    (match r with
     | Cons (TP p, r2) ->
       // an attr list can wrap after a comma, like any argument list.
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (s, acc))
       else (rev_app (Cons (s, acc)) Nil, r)
     | _ -> (rev_app (Cons (s, acc)) Nil, r))
  // ...and a name may be written as a STRING: `attr_accessor :a, "b"`. A
  // double-quoted string lexes as an interpolation GROUP, so it is parsed as
  // an expression and folded, the way alias names are.
  // A bare string literal, now that a double-quoted string with no
  // interpolation lexes as one token rather than a concat: `attr_reader "c"`.
  | Cons (TStrL lit, r0) ->
    (match r0 with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (lit, acc))
       else (rev_app (Cons (lit, acc)) Nil, r0)
     | _ -> (rev_app (Cons (lit, acc)) Nil, r0))
  | Cons (TP grp, _) when str_eq grp "(s" ->
    (let (e, r) = parse_primary toks in
     let nm = const_fold_str e in
     match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (nm, acc))
       else (rev_app (Cons (nm, acc)) Nil, r)
     | _ -> (rev_app (Cons (nm, acc)) Nil, r))
  // the trailing `true` / `false` of `attr :a, true` ends the list
  | Cons (TId flag, _) when str_eq flag "true" || str_eq flag "false" ->
    (rev_app acc Nil, toks)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected :symbol" ++ parsing_file ()))) in fail ("mere-ruby: expected :symbol" ++ parsing_file ()))

// a range in an if/unless condition is the flip-flop operator; allocate its
// state site here (parse time), reaching through !/&&/|| combinations.
// scan (depth-aware) for a top-level assignment operator before the
// closing paren — defined?(x = 2) / defined?(@x ||= 1) forms.
// `defined?(<compound statement>)` — if/unless/case/while/until/for/begin —
// always answers "expression" in Ruby; parse it as a statement (correctly
// consuming to the matching `end`) rather than as an expression.
and defined_compound = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    str_eq w "if" || str_eq w "unless" || str_eq w "case" || str_eq w "while" ||
    str_eq w "until" || str_eq w "for" || str_eq w "begin"
  | _ -> false

and defined_assignish = fn toks -> defined_assign_go toks 0

// `defined?(a[0] = 1)` is "method" -- the []= CALL -- while `defined?(x = 1)`
// is "assignment". CRuby splits them on the TARGET, and only for a plain `=`:
// an op-assign writes through the same setter and is still "assignment".
// The two tokens before the `=` say which: `] =` is an index write, and
// `. name =` an attribute write.
and defined_assign_kind = fn toks -> defined_assign_kind_go toks 0 TEOF TEOF
and defined_assign_kind_go = fn toks -> fn (depth: int) -> fn (p1: Tok) -> fn (p2: Tok) ->
  match toks with
  | Nil -> "assignment"
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      defined_assign_kind_go r (depth + 1) (TP p) p1
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      defined_assign_kind_go r (depth - 1) (TP p) p1
    else if depth == 0 && str_eq p "=" then
      (match p1 with
       | TP c -> (if str_eq c "]" then "method" else "assignment")
       | TId _ -> (match p2 with TP d -> (if str_eq d "." then "method" else "assignment") | _ -> "assignment")
       | _ -> "assignment")
    else defined_assign_kind_go r depth (TP p) p1
  | Cons (t, r) -> defined_assign_kind_go r depth t p1

and defined_assign_go = fn toks -> fn (depth: int) ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      defined_assign_go r (depth + 1)
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth == 0 then false else defined_assign_go r (depth - 1))
    else if depth == 0 && (str_eq p "=" || (if str_eq (opassign_base p) "" then false else true)) then true
    else defined_assign_go r depth
  | Cons (_, r) -> defined_assign_go r depth

and cond_ff = fn (e: Expr) ->
  match e with
  | ERange (a, b, excl) ->
    let n = map_len ff_state in
    let _ = map_set ff_state (str_of_int n) (VBool false) in
    EFlipFlop (n, a, b, excl)
  | EBin (op, l, r) ->
    if str_eq op "&&" || str_eq op "||" then EBin (op, cond_ff l, cond_ff r) else e
  | EUn (op, x) -> if str_eq op "!" then EUn (op, cond_ff x) else e
  | _ -> e

and parse_if = fn toks -> fn (negate: bool) ->
  let (cond1, r0) = parse_andor toks in
  // `if x = compute rescue next` -- the rescue modifier binds tighter than the
  // `if`, so the CONDITION is `(x = compute) rescue next` (activesupport's
  // Messages::Rotator writes exactly that inside a block).
  let (cond1, r) =
    (match r0 with
     | Cons (TId rw, r1) ->
       if str_eq rw "rescue" then
         (let (h, r2) = parse_stmt (skip_nls r1) in
          (EStmt (SBegin (Cons (SExpr cond1, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)), r2))
       else (cond1, r0)
     | _ -> (cond1, r0)) in
  let cond0 = cond_ff cond1 in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  let (clauses, els, r3) = parse_if_tail r2 in
  (SIf (Cons ((cond, body), clauses), els), r3)

and parse_if_tail = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "end" then (Nil, Nil, r)
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (Nil, b, expect_kw r2 "end")
    else if str_eq id "elsif" then
      // the same parser as `if`: an elsif condition may use the low-precedence
      // `and` / `or` (racc's generated parsers are written that way).
      let (c0, r2) = parse_andor r in
      let c = cond_ff c0 in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      let (clauses, els, r4) = parse_if_tail r3 in
      (Cons ((c, b), clauses), els, r4)
    else (let __fm = ("mere-ruby: expected elsif/else/end, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated if" ++ parsing_file ()))) in fail ("mere-ruby: unterminated if" ++ parsing_file ()))

// `for x in e [do] body end` — each over e with x as the block param.
// The block shares the enclosing env, so (like Ruby's for) x leaks out.
and parse_for = fn toks ->
  // a complex loop target (`for obj.attr in`, `for arr[i] in`, `for C::X in`,
  // `for obj&.attr in`) is parsed as an assignment-target expression and driven
  // through the same setter machinery as multiple assignment.
  if for_targets_complex toks then
    let (targets, r2) = parse_for_xtargets toks Nil in
    let (e0, r3) = parse_for_expr r2 in
    let (e, body, r4) = parse_for_iter e0 r3 in
    (match targets with
     | Cons (t, Nil) ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("__forv", Nil), Cons (for_xassign t (EVar "__forv"), body))), r4)
     | _ ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("*__forv", Nil), Cons (SMultiAssignX (targets, Cons (ESplat (EVar "__forv"), Nil)), body))), r4))
  else
  let (vars, r2) = parse_for_vars toks Nil in
  let (e0, r3) = parse_for_expr r2 in
  let (e, body, r4) = parse_for_iter e0 r3 in
  (match vars with
   | Cons (v, Nil) ->
     // A single SPLAT target collects rather than binds: `for *r in [[1,2]]`
     // is the assignment `*r = [1,2]`, so r is [1,2]. for_assign would have
     // made a local literally NAMED "*r" and left r undefined -- and a real
     // `|*r|` block param would have wrapped the element one layer too deep.
     (if str_len v > 1 && str_eq (char_at v 0) "*" then
        (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil),
                          Cons (SMultiAssign (Cons (v, Nil), Cons (EVar "__for", Nil)), body))), r4)
      else if str_eq v "*" then
        // `for * in xs` binds nothing at all; the loop still runs.
        (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil), body)), r4)
      else
     // the hidden __for param keeps v assigned in the SHARED scope, so
     // v survives the loop (block params themselves are block-local).
     (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil), Cons (for_assign v (EVar "__for"), body))), r4))
   | _ ->
     // multiple targets: real (auto-splatting) block params __f0.., then a
     // prologue assigns them into the SHARED scope names.
     let (params, prologue) = for_multi_binding vars 0 in
     (SExpr (EMethodB (e, "each", Nil, params, list_append_stmt prologue body)), r4))

// The iterable must not swallow the loop's `do`, the same way a while
// condition must not: in `for y in 0...h do`, the bare `h` at the end of the
// range would otherwise take the block (chunky_png writes exactly that).
and parse_for_expr = fn toks ->
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (e, r) = parse_expr toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  (e, r)

// `for i in x do ... end` — a bare-variable iterable grabs the do-block as its
// own; unwrap it back into the loop body. Shared by both for-target paths.
and parse_for_iter = fn (e0: Expr) -> fn r3 ->
  match e0 with
  | ECallB (nm, Nil, bps, bb) -> (match bps with Nil -> (EVar nm, bb, r3) | _ -> (e0, Nil, r3))
  | _ ->
    let r3b = (match r3 with Cons (TId d, rr) -> (if str_eq d "do" then rr else r3) | _ -> r3) in
    let (b, r4b) = parse_stmts r3b Nil in
    (e0, b, expect_kw r4b "end")

// does the for-target list (up to `in`) contain a complex chain?
and for_targets_complex = fn toks ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) -> if str_eq w "in" then false else for_targets_complex r
  | Cons (TP p, r) ->
    if str_eq p "." || str_eq p "[" || str_eq p "::" || str_eq p "&." then true
    else for_targets_complex r
  | Cons (_, r) -> for_targets_complex r

// parse comma-separated complex for-targets, terminated by `in`.
and parse_for_xtargets = fn toks -> fn (acc: Expr list) ->
  let (t, r) = parse_x_target1 toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_for_xtargets r2 (Cons (t, acc)) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | Cons (TId kw, r2) -> if str_eq kw "in" then (rev_app (Cons (t, acc)) Nil, r2) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))

// build the statement that assigns one for-iteration value to a complex target.
and for_xassign = fn (t: Expr) -> fn (rhs: Expr) ->
  match t with
  | EMethod (recv, m, args) -> if str_eq m "[]" then SExpr (EMethod (recv, "[]=", eapp args (Cons (rhs, Nil)))) else SExpr (EMethod (recv, m ++ "=", Cons (rhs, Nil)))
  | ESafe (recv, m, args) -> SExpr (ESafe (recv, m ++ "=", eapp args (Cons (rhs, Nil))))
  | EScopedRead (recv, cn) -> SExpr (EScopedAssign (recv, cn, rhs))
  | EIVar n -> SAssign ("@" ++ n, rhs)
  | EVar n -> SAssign (n, rhs)
  | _ -> SExpr rhs

and list_append_stmt = fn (xs: Stmt list) -> fn (ys: Stmt list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_stmt t ys)

// vars -> (block params, prologue stmts): v -> __fN + v = __fN;
// *x -> *__fN + x = __fN; bare * -> anonymous *.
// a for-loop target assignment: an @ivar / @@cvar name routes to SIVarAssign
// (SAssign only handles plain locals / $globals / constants).
and for_assign = fn (v: str) -> fn (rhs: Expr) ->
  if str_len v > 0 && str_eq (char_at v 0) "@" then SIVarAssign (substring v 1 (str_len v), rhs)
  else SAssign (v, rhs)

and for_multi_binding = fn (vars: str list) -> fn (n: int) ->
  match vars with
  | Nil -> (Nil, Nil)
  | Cons (v, rest) ->
    let (ps, ss) = for_multi_binding rest (n + 1) in
    if str_eq v "*" then (Cons ("*", ps), ss)
    else if str_len v > 0 && str_eq (char_at v 0) "*" then
      let nm = substring v 1 (str_len v) in
      (Cons ("*__f" ++ str_of_int n, ps), Cons (for_assign nm (EVar ("__f" ++ str_of_int n)), ss))
    else (Cons ("__f" ++ str_of_int n, ps), Cons (for_assign v (EVar ("__f" ++ str_of_int n)), ss))

// target list before `in`: a name, `name,`, `a, b`, `a, *`, `a, *rest`.
// the names inside `for (a, b) in ...`, up to the closing paren.
and parse_for_group = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId v, r) ->
    (match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_for_group r2 (Cons (v, acc))
       else if str_eq p ")" then (rev_app (Cons (v, acc)) Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or ) in a for target" ++ parsing_file ()))) in fail ("mere-ruby: expected , or ) in a for target" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated for target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated for target" ++ parsing_file ())))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable in a for target" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable in a for target" ++ parsing_file ()))

and parse_for_vars = fn toks -> fn (acc: str list) ->
  match toks with
  // `for (a, b) in pairs` — the parens only group the destructuring, exactly
  // as `for a, b in pairs` does.
  | Cons (TP lp, r0) ->
    if is_lparen lp then
      (let (vs, r1) = parse_for_group r0 Nil in
       match r1 with
       | Cons (TId kw, r2) ->
         if str_eq kw "in" then (rev_app (rev_app vs acc) Nil, r2)
         else parse_for_vars r1 (rev_app vs acc)
       | _ -> parse_for_vars r1 (rev_app vs acc))
    // `*` / `*rest` as a for target. This arm and the `Cons (TP star, r)` one
    // further down BOTH match TP, and the first match wins -- so that one was
    // dead code and every `for *r in` / `for a, *r in` failed here with
    // "expected a variable after for".
    else if str_eq lp "*" then
      (match r0 with
       | Cons (TId n, r2) ->
         if str_eq n "in" then (rev_app (Cons ("*", acc)) Nil, r2)
         else parse_for_vars2 ("*" ++ n) r2 acc
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))
  | Cons (TId v, r) ->
    if str_eq v "in" then (rev_app acc Nil, r)
    else
      (match r with
       | Cons (TP c, r2) ->
         if str_eq c "," then
           // `for i, in` — a trailing comma destructures (i = first elem).
           (match r2 with
            | Cons (TId nx, r3) ->
              if str_eq nx "in" then (rev_app (Cons ("*", Cons (v, acc))) Nil, r3)
              else parse_for_vars r2 (Cons (v, acc))
            | _ -> parse_for_vars r2 (Cons (v, acc)))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
       | Cons (TId kwin, r2) ->
         if str_eq kwin "in" then (rev_app (Cons (v, acc)) Nil, r2)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId n, r2) ->
         if str_eq n "in" then (rev_app (Cons ("*", acc)) Nil, r2)
         else parse_for_vars2 ("*" ++ n) r2 acc
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))

and parse_for_vars2 = fn (t: str) -> fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_for_vars r (Cons (t, acc))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | Cons (TId kwin, r) ->
    if str_eq kwin "in" then (rev_app (Cons (t, acc)) Nil, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))

and parse_while = fn toks -> fn (negate: bool) ->
  // the condition must not swallow the loop's `do` as a block argument
  // (`while x do y end` = while x; then y; not x { y }).
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (cond0, r) = parse_andor toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  (SWhile (cond, body), expect_kw r2 "end")

and parse_case = fn toks ->
  // `case` immediately followed by a newline is subjectless: the when
  // conditions are truthiness tests rather than === against a subject.
  match toks with
  | Cons (TNL _, _) -> parse_whens ECaseNone toks Nil Nil
  // ... and so is `case when c then v end` on one line: `when` cannot start a
  // subject expression, so its presence here means there is no subject.
  | Cons (TId kw0, _) -> if str_eq kw0 "when" then parse_whens ECaseNone toks Nil Nil else parse_case_subj toks
  | _ -> parse_case_subj toks
and parse_case_subj = fn toks ->
  (match toks with
  | _ ->
    let (subj, r) = parse_expr toks in
    // `in` after the subject selects pattern matching; `when` the classic form.
    (match skip_nls r with
     | Cons (TId kw, _) -> if str_eq kw "in" then parse_case_in subj r Nil else parse_whens subj r Nil Nil
     | _ -> parse_whens subj r Nil Nil))

// pattern-matching case: parse `in <pattern> [if|unless <cond>] [then] body`
// clauses, an optional `else`, and the closing `end`.
and parse_case_in = fn (subj: Expr) -> fn toks -> fn acc ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "in" then
      let (pat, r2) = parse_pattern_top r in
      let (guard, r3) = parse_in_guard r2 in
      // after a pattern (+ optional guard) a delimiter must follow — then, a
      // newline, or end. Anything else (e.g. a leftover `+ 1` from `in 1 + 1`,
      // which a value pattern does not consume) is a SyntaxError in Ruby.
      let _ = (match r3 with
               | Cons (TId g, _) -> if str_eq g "then" || is_block_stop g then () else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))) in fail ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))
               | Cons (TNL _, _) -> ()
               | Cons (TEOF, _) -> ()
               | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))) in fail ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))) in
      let (b, r4) = parse_stmts (skip_then r3) Nil in
      parse_case_in subj r4 (Cons ((pat, guard, b), acc))
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (SCaseIn (subj, rev_app acc Nil, true, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCaseIn (subj, rev_app acc Nil, false, Nil), r)
    else (let __fm = ("mere-ruby: expected in/else/end in case, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated case/in" ++ parsing_file ()))) in fail ("mere-ruby: unterminated case/in" ++ parsing_file ()))

// an optional guard after a pattern: `if COND` / `unless COND`.
and parse_in_guard = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "if" then let (c, r2) = parse_andor r in (c, r2)
    else if str_eq id "unless" then let (c, r2) = parse_andor r in (EUn ("!", c), r2)
    else (EBool true, toks)
  | _ -> (EBool true, toks)

// a top-level pattern (the direct operand of `in` or one-line `=>`/`in`).
// Bare forms without brackets/braces are allowed here: `in 0, 1, 2` is an
// array pattern and `in a:, b:` is a hash pattern.
// ---- parser-side pattern static checks ----------------------------------
// (These run at parse time so an offending pattern inside eval("...") surfaces
//  as a catchable SyntaxError, matching Ruby.)
and pp_us = fn (n: str) -> str_len n > 0 && str_eq (char_at n 0) "_"
and pp_names = fn (p: Pat) -> fn (acc: str list) ->
  match p with
  | PVar n -> Cons (n, acc)
  | PSplatP n -> if str_eq n "" then acc else Cons (n, acc)
  | PArrP es -> pp_names_list es acc
  | PHashP (items, rest) ->
    let a2 = if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then acc else Cons (rest, acc) in
    pp_hitems items a2
  | PAltP alts -> pp_names_list alts acc
  | PAsP (sub, n) -> Cons (n, pp_names sub acc)
  | PConstP (_, inner) -> pp_names inner acc
  | _ -> acc
and pp_names_list = fn (es: Pat list) -> fn (acc: str list) ->
  match es with Nil -> acc | Cons (p, r) -> pp_names_list r (pp_names p acc)
and pp_hitems = fn (items: (str * Pat) list) -> fn (acc: str list) ->
  match items with Nil -> acc | Cons (kp, r) -> let (k, sub) = kp in pp_hitems r (pp_names sub acc)
and pp_mem = fn (xs: str list) -> fn (n: str) ->
  match xs with Nil -> false | Cons (h, t) -> str_eq h n || pp_mem t n
// a non-underscore variable bound more than once (`in [a, a]` — SyntaxError;
// `_`/`_x` may repeat).
and pp_has_dup = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else pp_mem rest n) || pp_has_dup rest
// any non-underscore binding at all (used to forbid bindings in alternatives).
and pp_has_real = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else true) || pp_has_real rest
and check_dup_vars = fn (p: Pat) ->
  if pp_has_dup (pp_names p Nil) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: duplicated variable name in pattern")) in fail "mere-ruby: duplicated variable name in pattern") else ()

// `^name` may only pin a variable already bound to its LEFT in the pattern (or
// a pre-existing local). Pinning a name that the SAME pattern binds later
// (`in [^n, n]`) is a SyntaxError ("no such local variable"); `[n, ^n]` is ok.
and check_pin_order = fn (p: Pat) ->
  let all = pp_names p Nil in
  let (bad, _) = pp_pin_walk p all Nil in
  if bad then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: no such local variable in pattern (pinned before bound)")) in fail "mere-ruby: no such local variable in pattern (pinned before bound)") else ()
and pp_pin_walk = fn (p: Pat) -> fn (all: str list) -> fn (seen: str list) ->
  match p with
  | PVar n -> (false, Cons (n, seen))
  | PPin e -> (match e with EVar n -> ((pp_mem all n) && (if pp_mem seen n then false else true), seen) | _ -> (false, seen))
  | PSplatP n -> (false, if str_eq n "" then seen else Cons (n, seen))
  | PArrP es -> pp_pin_walk_list es all seen
  | PHashP (items, _) -> pp_pin_walk_hitems items all seen
  | PAltP alts -> pp_pin_walk_list alts all seen
  | PAsP (sub, n) -> let (b, s) = pp_pin_walk sub all seen in (b, Cons (n, s))
  | PConstP (_, inner) -> pp_pin_walk inner all seen
  | _ -> (false, seen)
and pp_pin_walk_list = fn (es: Pat list) -> fn (all: str list) -> fn (seen: str list) ->
  match es with
  | Nil -> (false, seen)
  | Cons (p, r) -> let (b, s) = pp_pin_walk p all seen in if b then (true, s) else pp_pin_walk_list r all s
and pp_pin_walk_hitems = fn (items: (str * Pat) list) -> fn (all: str list) -> fn (seen: str list) ->
  match items with
  | Nil -> (false, seen)
  | Cons (kp, r) -> let (k, sub) = kp in let (b, s) = pp_pin_walk sub all seen in if b then (true, s) else pp_pin_walk_hitems r all s

and parse_pattern_top = fn toks ->
  let (p, r) = parse_pattern_top0 toks in
  let _ = check_dup_vars p in
  let _ = check_pin_order p in
  (p, r)

and parse_pattern_top0 = fn toks ->
  // bare hash pattern: starts with a `label:` or `**`.
  if starts_hash_pattern toks then
    let (items, rest, r) = parse_hash_pat_items toks Nil "" in
    (PHashP (items, rest), r)
  else
    let (p, r) = parse_pattern toks in
    // bare array pattern: a top-level comma joins elements without brackets.
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then
         let (rest, r3) = parse_bare_arr r2 Nil in
         (PArrP (Cons (p, rest)), r3)
       else (p, r)
     | _ -> (p, r))

// elements of a bracket-less array pattern (`in 0, 1, *rest`), terminated by
// end-of-clause rather than `]`. Called right after a separating comma.
and parse_bare_arr = fn toks -> fn (acc: Pat list) ->
  // called right after a separating comma; a terminator here means a trailing
  // comma (`0, 1,`) which makes the pattern match partially — append a splat.
  match toks with
  | Cons (TNL _, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TEOF, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | Cons (TP p, _) -> if str_eq p ")" || str_eq p ";" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | _ -> parse_bare_arr_one toks acc

and parse_bare_arr_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match r with
   | Cons (TP c, r2) -> if str_eq c "," then parse_bare_arr r2 acc2 else (rev_app acc2 Nil, r)
   | _ -> (rev_app acc2 Nil, r))

// does the token stream begin a bare (brace-less) hash pattern?
and starts_hash_pattern = fn toks ->
  match toks with
  | Cons (TId _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TStrL _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TP op, Cons (TStrL _, Cons (TP plus, Cons (TStrL _, Cons (TP cp, Cons (TP colon, _)))))) -> str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":"
  | Cons (TP dsp, _) -> str_eq dsp "**"
  | _ -> false

// a full pattern including alternation `p1 | p2 | ...` and the trailing
// as-binding `pat => name`.
and parse_pattern = fn toks ->
  let (p, r) = parse_pattern_alt toks in
  // `pat => name` binds the whole matched value to a local.
  (match r with
   | Cons (TP arrow, r2) ->
     if str_eq arrow "=>" then
       (match r2 with
        | Cons (TId nm, r3) -> (PAsP (p, nm), r3)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected name after => in pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected name after => in pattern" ++ parsing_file ())))
     else (p, r)
   | _ -> (p, r))

and parse_pattern_alt = fn toks ->
  let (p, r) = parse_pattern_prim toks in
  (match r with
   | Cons (TP bar, r2) ->
     if str_eq bar "|" then
       let (alts, r3) = parse_alt_rest r2 (Cons (p, Nil)) in
       // Ruby forbids binding a (non-underscore) variable in an alternative.
       let _ = if pp_has_real (pp_names (PAltP alts) Nil) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: illegal variable in alternative pattern")) in fail "mere-ruby: illegal variable in alternative pattern") else () in
       (PAltP alts, r3)
     else (p, r)
   | _ -> (p, r))

and parse_alt_rest = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern_prim toks in
  let acc2 = rev_app (Cons (p, rev_app acc Nil)) Nil in
  (match r with
   | Cons (TP bar, r2) -> if str_eq bar "|" then parse_alt_rest r2 acc2 else (acc2, r)
   | _ -> (acc2, r))

// a primary pattern (no alternation / as-binding at this level).
and parse_pattern_prim = fn toks ->
  match toks with
  // array pattern [ ... ]
  | Cons (TP lb, r) ->
    if str_eq lb "[" || str_eq lb " [" then
      let (elems, r2) = parse_arr_pat_elems r Nil in
      (PArrP elems, r2)
    // hash pattern { ... }
    else if str_eq lb "\{" then
      let (items, rest, r2) = parse_hash_pat_brace r in
      (PHashP (items, rest), r2)
    // ^pin
    else if str_eq lb "^" then parse_pin r
    // *splat (only valid inside an array; encode as a splat element)
    else if str_eq lb "*" then
      (match r with
       | Cons (TId nm, r2) -> (PSplatP nm, r2)
       | _ -> (PSplatP "", r))
    // **rest at top level of a bare hash pattern handled elsewhere; a bare
    // parenthesised pattern `(pat)` just groups.
    else if is_lparen lb then
      let (p, r2) = parse_pattern (skip_nls r) in (p, expect (skip_nls r2) ")")
    else
      // any other leading token: a value pattern (literal / range / etc.).
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
  // a bare identifier: a variable binding when lowercase, else a value/const.
  | Cons (TId nm, r) ->
    if is_upper_first nm then parse_const_pattern toks
    else if str_eq nm "nil" || str_eq nm "true" || str_eq nm "false" then
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
    else
      // a lowercase name binds, unless a following `..`/`...` makes it a
      // range value pattern.
      (match r with
       | Cons (TP dots, _) -> if str_eq dots ".." || str_eq dots "..." then let (e, r2) = parse_pat_value toks in (PVal e, r2) else (PVar nm, r)
       | _ -> (PVar nm, r))
  | _ -> let (e, r) = parse_pat_value toks in (PVal e, r)

// a value pattern's expression: like parse_range but with the binary layer
// capped so alternation `|` (prec 5) is NOT consumed here — it belongs to the
// pattern grammar. Handles literals, unary minus, ranges, symbols, regexps.
and parse_pat_value = fn toks ->
  // a value pattern is a single primary (literal / const / symbol / regex /
  // unary-minus number) with an optional range — NOT an arithmetic expression.
  // Using parse_unary (not parse_bin) means `in 1 + 1` leaves `+ 1` behind, so
  // the clause's delimiter check reports a SyntaxError, as Ruby does.
  let (lo, r) = parse_unary toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | Cons (TNL _, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (ERange (lo, ENil, excl), rest) else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

// read a bare constant reference (`Foo`, `Foo::Bar`) WITHOUT consuming a
// trailing `[` / `(` — those introduce the deconstruct sub-pattern.
and parse_pat_const = fn toks ->
  match toks with
  | Cons (TP colons, Cons (TId nm, r)) -> if str_eq colons "::" then parse_pat_const_more (EConst nm) r else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad constant pattern")) in fail "mere-ruby: bad constant pattern")
  | Cons (TId nm, r) -> parse_pat_const_more (EConst nm) r
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a constant in pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a constant in pattern" ++ parsing_file ()))

and parse_pat_const_more = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP cc, Cons (TId nm2, r2)) -> if str_eq cc "::" then parse_pat_const_more (EScopedRead (e, nm2)) r2 else (e, toks)
  | _ -> (e, toks)

// `^name` / `^@x` / `^@@x` / `^$x` / `^(expr)`.
and parse_pin = fn toks ->
  match toks with
  | Cons (TP lp, r) ->
    if is_lparen lp then let (e, r2) = parse_expr r in (PPin e, expect r2 ")")
    else if str_eq lp "@" then (match r with Cons (TId nm, r2) -> (PPin (EIVar nm), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad ^@ pattern")) in fail "mere-ruby: bad ^@ pattern"))
    else if str_eq lp "$" then (match r with Cons (TId nm, r2) -> (PPin (EVar ("$" ++ nm)), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad ^$ pattern")) in fail "mere-ruby: bad ^$ pattern"))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad ^ pattern")) in fail "mere-ruby: bad ^ pattern")
  | Cons (TId nm, r) ->
    // `^@x` / `^@@x` lex as an @-prefixed identifier; `^$g` as a $-name.
    if str_len nm >= 1 && str_eq (char_at nm 0) "@" then (PPin (EIVar (substring nm 1 (str_len nm))), r)
    else if str_len nm >= 1 && str_eq (char_at nm 0) "$" then (PPin (EVar nm), r)
    else (PPin (EVar nm), r)
  | _ -> let (e, r) = parse_primary toks in (PPin e, r)

// `Const`, `Const[...]`, `Const(...)`, `Const(id: p, ...)`; a bare Const is a
// value pattern (=== the class).
and parse_const_pattern = fn toks ->
  let (ce, r) = parse_pat_const toks in
  (match r with
   | Cons (TP lb, r2) ->
     if str_eq lb " [" || str_eq lb "[" then
       // the item/element parsers already consume the closing ] themselves.
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else if str_eq lb " (" || is_lparen lb then
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems_paren r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else (PVal ce, r)
   | _ -> (PVal ce, r))

// elements of an array pattern up to the closing `]`.
and parse_arr_pat_elems = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) ->
    if str_eq rb "]" then (rev_app acc Nil, r)
    else parse_arr_pat_one t acc
  | _ -> parse_arr_pat_one t acc

and parse_arr_pat_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       // a trailing comma before `]` makes the pattern match partially from the
       // start (`[0, 1, ]` == `[0, 1, *]`): append an anonymous splat.
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb "]" then (rev_app (Cons (PSplatP "", acc2)) Nil, r3) else parse_arr_pat_elems (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems (skip_nls r2) acc2)
     else if str_eq c "]" then (rev_app acc2 Nil, r2)
     else (let __fm = ("mere-ruby: expected , or ] in array pattern, got " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
   | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array pattern" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array pattern" ++ parsing_file ())))

// like parse_arr_pat_elems but closes on `)` (Const(pat, ...) form).
and parse_arr_pat_elems_paren = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) -> if str_eq rb ")" then (rev_app acc Nil, r) else parse_arr_pat_one_p t acc
  | _ -> parse_arr_pat_one_p t acc

and parse_arr_pat_one_p = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb ")" then (rev_app acc2 Nil, r3) else parse_arr_pat_elems_paren (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems_paren (skip_nls r2) acc2)
     else if str_eq c ")" then (rev_app acc2 Nil, r2)
     else (let __fm = ("mere-ruby: expected , or ) in pattern, got " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
   | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated pattern" ++ parsing_file ()))) in fail ("mere-ruby: unterminated pattern" ++ parsing_file ())))

// a brace hash pattern `{ ... }` — consume up to `}`.
and parse_hash_pat_brace = fn toks ->
  match skip_nls toks with
  | Cons (TP rb, r) -> if str_eq rb "}" then (Nil, "", r) else parse_hash_pat_items toks Nil ""
  | _ -> parse_hash_pat_items toks Nil ""

// hash-pattern items: (label, sub-pattern) pairs plus a rest tag. Stops at
// `}` / `]` / `)` / end-of-clause. `rest` accumulates the **-form.
and parse_hash_pat_items = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      // **nil / **name / ** (anonymous)
      (match r0 with
       | Cons (TId nm, r1) -> if str_eq nm "nil" then hash_pat_sep r1 acc "nil" else hash_pat_sep r1 acc nm
       | _ -> hash_pat_sep r0 acc "*")
    else if str_eq dsp "}" || str_eq dsp "]" || str_eq dsp ")" then (rev_app acc Nil, rest, r0)
    else parse_hash_pat_kv t acc rest
  | _ -> parse_hash_pat_kv t acc rest

and parse_hash_pat_kv = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  // key: `label:` (identifier) or `"string":` (symbol key).
  let (key, r2) =
    (match toks with
     | Cons (TId nm, Cons (TP colon, r0)) -> if str_eq colon ":" then (nm, r0) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))
     | Cons (TStrL s, Cons (TP colon, r0)) -> if str_eq colon ":" then (s, r0) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))
     // a "string": key (double-quoted, no interpolation) lexes as `(s "" + s )`.
     | Cons (TP op, Cons (TStrL empty, Cons (TP plus, Cons (TStrL s, Cons (TP cp, Cons (TP colon, r0)))))) ->
       if str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":" then (s, r0) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))) in
  // an omitted value (`a:`) binds the key name; otherwise parse a sub-pattern.
  // Do NOT skip newlines here: a newline / `;` ends a brace-less hash pattern.
  let (sub, r3) =
    (match r2 with
     | Cons (TP p, _) -> if str_eq p "," || str_eq p "}" || str_eq p "]" || str_eq p ")" then (PVar key, r2) else parse_pattern r2
     | Cons (TId gg, _) -> if str_eq gg "then" || str_eq gg "if" || str_eq gg "unless" then (PVar key, r2) else parse_pattern r2
     | Cons (TNL _, _) -> (PVar key, r2)
     | Cons (TEOF, _) -> (PVar key, r2)
     | _ -> parse_pattern r2) in
  // Ruby rejects a duplicated key name in a hash pattern.
  let _ = if pp_hitem_haskey acc key then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: duplicated key name in hash pattern")) in fail "mere-ruby: duplicated key name in hash pattern") else () in
  hash_pat_sep r3 (Cons ((key, sub), acc)) rest

and pp_hitem_haskey = fn (items: (str * Pat) list) -> fn (key: str) ->
  match items with Nil -> false | Cons (kp, r) -> let (k, _) = kp in str_eq k key || pp_hitem_haskey r key

and hash_pat_sep = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  match skip_nls toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_hash_pat_items r acc rest
    else if str_eq c "}" || str_eq c "]" || str_eq c ")" then (rev_app acc Nil, rest, r)
    else (rev_app acc Nil, rest, toks)
  | _ -> (rev_app acc Nil, rest, toks)

// A `when` value the parser can compare with another: a literal, and only a
// literal. Anything computed is "" and never counts as a duplicate -- two
// clauses saying `when foo` are not the same clause as far as the parser can
// tell, and ruby does not claim they are either.
and when_lit_key = fn (e: Expr) ->
  (match e with
   | EInt n9 -> "i" ++ str_of_int n9
   | EStrL s9 -> "s" ++ s9
   | ESym y9 -> "y" ++ y9
   | EBool b9 -> (if b9 then "b1" else "b0")
   | EFlt f9 -> "f" ++ str_of_float f9
   | ENil -> "n"
   | _ -> "")
// A hash LITERAL warns about a duplicated key, the way a case/when warns about
// a duplicated clause -- same literal-key rule, same warn_note. The key that
// wins is the LAST one, so the warning is about the earlier one being dropped.
// ⚠ Only literal keys: `{x => 1, y => 1}` may or may not collide at run time,
// and ruby says nothing about those either.
and hsh_note_dups = fn (items: Expr list) -> fn (seen: (str * int) list) -> fn (ln: int) ->
  (match items with
   // ⚠ `**{a: 1}` contributes KEYS too, and they collide with the literal ones
   // around them: `{**{a: 1}, a: 2}` warns. Only a literal hash can be read
   // this way -- `**h` names a variable, and what is in it is a run-time
   // question this walk cannot answer, so it contributes nothing.
   | Cons (EKwSplat inner9, Cons (_, t9)) ->
     (match inner9 with
      | EHsh its9 -> hsh_note_dups t9 (hsh_note_dups its9 seen ln) ln
      | _ -> hsh_note_dups t9 seen ln)
   // interleaved [k1, v1, k2, v2, ...]: step two at a time.
   | Cons (k9, Cons (_, t9)) ->
     (let key = when_lit_key k9 in
      if str_eq key "" then hsh_note_dups t9 seen ln
      else if when_seen_line seen key > 0 then
        (let _ = warn_note (parse_time_file () ++ ":" ++ str_of_int ln
                            ++ ": warning: key " ++ hsh_key_disp k9
                            ++ " is duplicated and overwritten on line " ++ str_of_int ln) in
         hsh_note_dups t9 seen ln)
      else hsh_note_dups t9 (Cons ((key, ln), seen)) ln)
   | _ -> seen)
// the key as the warning prints it: ruby inspects it.
and hsh_key_disp = fn (e: Expr) ->
  (match e with
   | EInt n9 -> str_of_int n9
   | EStrL s9 -> "\"" ++ s9 ++ "\""
   | ESym y9 -> ":" ++ y9
   | EBool b9 -> (if b9 then "true" else "false")
   | EFlt f9 -> str_of_float f9
   | ENil -> "nil"
   | _ -> "?")
and when_seen_line = fn (seen: (str * int) list) -> fn (k: str) ->
  (match seen with
   | Nil -> 0
   | Cons ((k9, l9), t9) -> if str_eq k9 k then l9 else when_seen_line t9 k)
// note every literal of THIS clause, warning for the first one already seen
and when_note_dups = fn (vs: Expr list) -> fn (seen: (str * int) list) -> fn (ln: int) ->
  (match vs with
   | Nil -> seen
   | Cons (v9, t9) ->
     (let k9 = when_lit_key v9 in
      if str_eq k9 "" then when_note_dups t9 seen ln
      else
        (let prev = when_seen_line seen k9 in
         if prev > 0 then
           (let _ = warn_note (parse_time_file () ++ ":" ++ str_of_int ln
                               ++ ": warning: 'when' clause on line " ++ str_of_int ln
                               ++ " duplicates 'when' clause on line " ++ str_of_int prev
                               ++ " and is ignored") in
            when_note_dups t9 seen ln)
         else when_note_dups t9 (Cons ((k9, ln), seen)) ln)))

and parse_whens = fn (subj: Expr) -> fn toks -> fn acc -> fn (seen: (str * int) list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "when" then
      let ln9 = tok_line t in
      let (vs, r2) = parse_when_vals r Nil in
      let seen2 = when_note_dups vs seen ln9 in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      parse_whens subj r3 (Cons ((vs, b), acc)) seen2
    else if str_eq id "else" then
      let _ = (match acc with
               | Nil -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: case with else but no when")) in fail "mere-ruby: case with else but no when")
               | _ -> ()) in
      let (b, r2) = parse_stmts r Nil in
      (SCase (subj, rev_app acc Nil, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCase (subj, rev_app acc Nil, Nil), r)
    else (let __fm = ("mere-ruby: expected when/else/end in case, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated case" ++ parsing_file ()))) in fail ("mere-ruby: unterminated case" ++ parsing_file ()))

and parse_when_vals = fn toks -> fn (acc: Expr list) ->
  // `when *ary` splices the array's elements as candidates.
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) -> if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1) else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    // a `when` value list may wrap after the comma (`when A,\n     B then`).
    if str_eq p "," then parse_when_vals (skip_nls r2) (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// `def name(p1, p2) ... end` or `def name ... end`. Parameters are
// optional parens; the body runs until `end`.
and parse_def = fn toks ->
  // A def parsed as a command argument (`internal def m ... end`, zeitwerk)
  // inherits the caller's "nodo" flag, which is there to stop the COMMAND
  // taking a do-block. The def's own body is a new context: a do-block
  // inside it belongs to whatever it follows there.
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let r = parse_def_inner toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  r

and parse_def_inner = fn toks ->
  match toks with
  // `def (expr).name; end` -- a singleton method on whatever the parenthesised
  // expression evaluates to. `def (nil).foo; end` is how the specs check that
  // defining one on nil does not make singleton_method find it. Only a bare
  // name or `self.` was accepted here, so five spec files did not parse at all.
  // The receiver is parsed and thrown away except for its shape: this supports
  // the constant / nil / true / false / self forms the corpus uses, which is
  // what a singleton class can be opened on anyway.
  | Cons (TP lp0, r0) when is_lparen lp0 ->
    (let (recv_e, r1) = parse_expr r0 in
     match r1 with
     // ...and the name after the dot may be an OPERATOR: ruby/spec builds its
     // matchers as `def (@m = BasicObject.new).===(obj)`, which is a def, an
     // assignment and an operator name in one line. Only TId was accepted, so
     // both grep specs aborted at parse time -- the record's only two CRASHes.
     | Cons (TP rp0, Cons (TP dot0, Cons (TP opnm, r2b))) when
         str_eq rp0 ")" && str_eq dot0 "." && def_op_name opnm ->
       (let (params, defs, r3) =
          (match r2b with
           | Cons (TP p, r4) -> if is_lparen p then parse_params r4 Nil Nil else (Nil, Nil, r2b)
           | _ -> (Nil, Nil, r2b)) in
        let (d, r5) = parse_def_tail opnm params defs r3 in
        (SSingletonE (recv_e, Cons (d, Nil)), r5))
     | Cons (TP rp0, Cons (TP dot0, Cons (TId nm0, r2))) ->
       if str_eq rp0 ")" && str_eq dot0 "." then
         (let (params, defs, r3) =
            (match r2 with
             | Cons (TP p, r4) -> if is_lparen p then parse_params r4 Nil Nil else (Nil, Nil, r2)
             | _ -> (Nil, Nil, r2)) in
          // nil / true / false are singletons: there is one of each, so a
          // singleton method on one is an instance method of its class. Say
          // that directly by wrapping the def in the class body rather than
          // registering a key that resolves somewhere else -- defining a method
          // nobody can call is worse than refusing to parse.
          match recv_e with
          | ENil -> (let (d, r5) = parse_def_tail nm0 params defs r3 in (SClass ("NilClass", "", Cons (d, Nil)), r5))
          | EBool b -> (let (d, r5) = parse_def_tail nm0 params defs r3 in
                        (SClass ((if b then "TrueClass" else "FalseClass"), "", Cons (d, Nil)), r5))
          // a constant, a local or self: the receiver has a real singleton
          | EConst cn -> parse_def_tail (cn ++ "#" ++ nm0) params defs r3
          | ESelf -> parse_def_tail ("self." ++ nm0) params defs r3
          | EVar v -> parse_def_tail (v ++ "#" ++ nm0) params defs r3
          // any other expression -- an assignment, a call, an ivar -- is the
          // receiver whatever it evaluates to, which is what `class << expr`
          // already means. The def goes in that body.
          | _ -> (let (d, r5) = parse_def_tail nm0 params defs r3 in
                  (SSingletonE (recv_e, Cons (d, Nil)), r5)))
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())))
  // operator method names: def ==, def <=>, def []=, def +, def <<, ...
  | Cons (TP op0, r0) ->
    // the lexer space-marks a bracket after "def " — same as a plain [.
    // the lexer space-marks a bracket / ampersand after "def " (` [`, ` &`);
    // normalise to the bare operator name.
    let op1 = if str_eq op0 " [" then "[" else if str_eq op0 " &" then "&" else op0 in
    let (name, r) =
      if str_eq op1 "[" then
        (match r0 with
         | Cons (TP rb2, r1) ->
           if str_eq rb2 "]" then
             (match r1 with
              | Cons (TP eq2, r2) -> if str_eq eq2 "=" then ("[]=", r2) else ("[]", r1)
              | _ -> ("[]", r1))
           else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))
         | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())))
      // `def !@` / `def !` — unary bang; normalize both to "!@".
      else if str_eq op1 "!" then
        (match r0 with
         | Cons (TId at, r1) -> if str_eq at "@" then ("!@", r1) else ("!@", r0)
         | _ -> ("!@", r0))
      // `def -@` / `def +@` — unary operator methods (op followed by @).
      else if (str_eq op1 "-" || str_eq op1 "+") &&
              (match r0 with Cons (TId at, _) -> str_len at >= 1 && str_eq (char_at at 0) "@" | _ -> false) then
        (match r0 with
         | Cons (TId at, r1) ->
           if str_eq at "@" then (op1 ++ "@", r1)
           // `-@x` lexes as the ivar @x after the op — split it back.
           else (op1 ++ "@", Cons (TId (substring at 1 (str_len at)), r1))
         | _ -> (op1 ++ "@", r0))
      else if is_op_method_name op1 then (op1, r0)
      else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) -> if is_lparen p then parse_params r3 Nil Nil else (Nil, Nil, r)
       // an operator method takes paren-less parameters too: `def []= k, v`
       // is how psych's Coder writes its setter.
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    parse_def_tail name params defs r2
  | Cons (TId name0, r0) ->
    // `def recv.name` — a singleton method. `def self.m` drops self. and
    // registers on the enclosing class/module; `def C.m` registers under
    // "C#m" so `C.m` (VClass dispatch) finds it.
    let (name, r) =
      (match r0 with
       | Cons (TP dot, r1) ->
         // `def Klass::name` is the same definition as `def Klass.name` (rexml
         // writes `def Document::entity_expansion_text_limit=(val)`).
         if str_eq dot "." || str_eq dot "::" then
           (match r1 with
            | Cons (TId n2, r2) -> if str_eq name0 "self" then ("self." ++ n2, r2) else (name0 ++ "#" ++ n2, r2)
            // def self.<< / def obj.== / def obj.[] — an operator singleton
            // method. Carry the receiver prefix like the TId case, so it
            // registers on the receiver's singleton rather than as a bare
            // top-level operator method (self. prefix for self, name# else).
            | Cons (TP op2, r2) ->
              let pfx = if str_eq name0 "self" then "self." else name0 ++ "#" in
              if str_eq op2 "[" then
                (match r2 with
                 | Cons (TP rb2, r3) ->
                   if str_eq rb2 "]" then
                     (match r3 with
                      | Cons (TP eq2, r4) -> if str_eq eq2 "=" then (pfx ++ "[]=", r4) else (pfx ++ "[]", r3)
                      | _ -> (pfx ++ "[]", r3))
                   else (name0, r0)
                 | _ -> (name0, r0))
              else if is_op_method_name op2 then (pfx ++ op2, r2)
              else (name0, r0)
            | _ -> (name0, r0))
         else (name0, r0)
       | _ -> (name0, r0)) in
    // setter definition `def x=(v)` — the `=` is part of the name. Guard
    // against endless defs `def x = (expr)` by requiring a real parameter
    // `( ident )` / `( ident ,` inside (a string desugars to `("" + ...)`).
    let (name, r) =
      (match r with
       | Cons (TP eq, r1) ->
         if str_eq eq "=" then
           (match r1 with
            | Cons (TP lp, Cons (TId _, Cons (TP rp, _))) ->
              // `=` third: the parameter has a DEFAULT (`def variables=( vars={} )`,
              // rexml). An endless def cannot reach here -- the lexer marks its
              // spaced `=` as a different token.
              if str_eq lp "(" && (str_eq rp ")" || str_eq rp "," || str_eq rp "=")
              then (name ++ "=", r1) else (name, r)
            // `def foobar=(*)` — a setter taking an anonymous splat, and
            // `def location=((a, b))` — one whose parameter destructures.
            | Cons (TP lp, Cons (TP st, _)) ->
              if str_eq lp "(" && (str_eq st "*" || str_eq st "**" || is_lparen st) then (name ++ "=", r1) else (name, r)
            // `def value= value` — a setter whose parameter has no parens. An
            // endless method cannot look like this: its body would have to be
            // a bare name followed by a newline, which is a name, not a body.
            | Cons (TId pn, r2) ->
              (if is_keyword pn then (name, r)
               else match r2 with
                    | Cons (TNL _, _) -> (name ++ "=", r1)
                    | Cons (TEOF, _) -> (name ++ "=", r1)
                    | Cons (TP semi, _) -> if str_eq semi ";" then (name ++ "=", r1) else (name, r)
                    | _ -> (name, r))
            | _ -> (name, r))
         else (name, r)
       | _ -> (name, r)) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) ->
         if is_lparen p then parse_params r3 Nil Nil
         else if str_eq p "*" || str_eq p "&" || str_eq p " &" then parse_bare_params r Nil Nil
         else (Nil, Nil, r)
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    parse_def_tail name params defs r2
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))

// endless method `def name(params) = expr` — body is a single expression;
// otherwise the body runs to `end`. Operator-named defs take this path too
// (`def >>(k) = Bits.new(@n >> k)`).
and parse_def_tail = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
  (match r2 with
   | Cons (TP eq, r3) ->
     if str_eq eq "=" || str_eq eq " =" then
       // ⚠ the body may start on the NEXT line -- `def m(n) =` with the
       //   expression below it is how ruby/spec writes a multi-line endless
       //   method, and stopping at the newline made it "unexpected end of
       //   input" and aborted the whole file. The `=` has already committed
       //   this to being a body, so there is nothing else the next expression
       //   could be.
       let (e, r4) = parse_expr (skip_nls r3) in (SDef (name, params, defs, Cons (SExpr e, Nil)), r4)
     else parse_def_body name params defs r2
   | _ -> parse_def_body name params defs r2)

and is_op_method_name = fn (op: str) ->
  // "|" is itself one of the names, and it is the separator, so it is asked
  // for directly rather than smuggled into the list.
  str_eq op "|" ||
  map_has (name_set "opmeth") op

and parse_def_body = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
    let (body0, r4) = parse_stmts r2 Nil in
    // method-level rescue/ensure: `def f ... rescue ... end` wraps the
    // whole body in an implicit begin.
    let (body, r5) =
      (match r4 with
       | Cons (TId k, _) ->
         if str_eq k "rescue" || str_eq k "ensure" then
           let (rescues, ra) = parse_rescues r4 Nil in
           let (els, rb) = parse_opt_kw_block ra "else" in
           let (ens, rc) = parse_opt_kw_block rb "ensure" in
           (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
         else (body0, r4)
       | _ -> (body0, r4)) in
    (SDef (name, params, defs, body), expect_kw r5 "end")

// the base name of a param string, stripping *, **, & prefixes, a : suffix,
// and any `~N` uniquification suffix (so a renamed `_~1` still counts as `_`).
and pbase = fn (p: str) ->
  let p = if str_len p >= 2 && str_eq (substring p 0 2) "**" then substring p 2 (str_len p)
          else if str_len p >= 1 && (str_eq (char_at p 0) "*" || str_eq (char_at p 0) "&") then substring p 1 (str_len p)
          else if str_len p >= 1 && str_eq (char_at p (str_len p - 1)) ":" then substring p 0 (str_len p - 1)
          else p in
  str_before_char p "~" 0
and str_before_char = fn (s: str) -> fn (ch: str) -> fn (i: int) ->
  if i >= str_len s then s
  else if str_eq (char_at s i) ch then substring s 0 i
  else str_before_char s ch (i + 1)
and pcount_base = fn (acc: str list) -> fn (base: str) ->
  match acc with Nil -> 0 | Cons (h, t) -> (if str_eq (pbase h) base then 1 else 0) + pcount_base t base
// Ruby allows the ignore-name `_` to repeat in a parameter list; give each
// repeat a unique internal storage key (first keeps the bare `_`) so they bind
// to distinct slots and a bare `super` forwards them positionally. Other
// duplicate names are a SyntaxError in Ruby, so they are left untouched.
and uniq_param = fn (name: str) -> fn (acc: str list) ->
  if (if str_eq (pbase name) "_" then true else false) && pcount_base acc "_" > 0 then
    (let u = "_~" ++ str_of_int (pcount_base acc "_") in
     if str_len name >= 2 && str_eq (substring name 0 2) "**" then "**" ++ u
     else if str_len name >= 1 && (str_eq (char_at name 0) "*" || str_eq (char_at name 0) "&") then substring name 0 1 ++ u
     else if str_len name >= 1 && str_eq (char_at name (str_len name - 1)) ":" then u ++ ":"
     else u)
  else name

and parse_params = fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  // a parenthesised parameter list may wrap across lines, so newlines inside
  // it are not statement separators (`def m(a,\n  b: 1)`). The paren-less form
  // below is the opposite: there a newline ends the list.
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (rev_app acc Nil, rev_app defs Nil, r)
    else if str_eq p "*" then
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("*" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "*" r acc defs)
    else if str_eq p "&" then
      // &block capture: stored as "&name"; a bare & (anonymous forwarding)
      // gets a hidden name so `c(&)` can re-pass it.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("&" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "&__anonblk" r acc defs)
    else if str_eq p "**" then
      // **kwargs collects the trailing keyword hash. A BARE ** gets a hidden
      // name, the way a bare & does: dsplat_name reads the name to decide
      // whether the method takes keywords AT ALL, and "" is how "no **
      // parameter" is spelled -- so `def m(**)` was told it takes none and the
      // caller's `m(x: 1)` was counted as a positional argument.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("**" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "**__anonkw" r acc defs)
    else if str_eq p "..." then
      // argument forwarding: `def m(...)` collects positional args in *__fwd
      // and the block in the same anonymous slot `def m(&)` uses, so `m(...)`
      // forwards a block when there is one and stays block-less when there
      // is not (which is what an earlier &__fwdblk attempt got wrong).
      parse_params_after "&__anonblk" r (Cons ("*__fwd", acc)) defs
    else if is_lparen p then
      // nested destructuring `def m((a, b))` — encoded as a spec string,
      // bound the same way as a block's |(a, b)|.
      let (spec, r2) = pipe_group r "" in
      parse_params_after ("(" ++ spec ++ ")") r2 acc defs
    else (let __fm = ("mere-ruby: expected parameter name, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TId name, r) ->
    // optional default `name = expr`; keyword param `name:` / `name: default`
    // (stored as "name:" in the param list, bound from the trailing hash).
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // optional `name = expr`: uniquify a duplicate `_` and key the default
         // under the SAME unique name so it stays associated with this position.
         let un = uniq_param name acc in
         // the default may start on the NEXT line -- addressable writes
         // `def self.normalize_component(component, character_class=\n  CONST,`
         let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs))
       else if str_eq eq ":" then
         let un = uniq_param (name ++ ":") acc in
         (match skip_nls r2 with
          | Cons (TP q, _) -> if str_eq q "," || str_eq q ")" then parse_params_after un r2 acc defs
                              else let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs))
          | _ -> let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs)))
       else parse_params_after (uniq_param name acc) r acc defs
     | _ -> parse_params_after (uniq_param name acc) r acc defs)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected parameter name" ++ parsing_file ()))) in fail ("mere-ruby: expected parameter name" ++ parsing_file ()))

and parse_params_after = fn (name: str) -> fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_params r (Cons (name, acc)) defs
    else if str_eq p ")" then (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, r)
    else (let __fm = ("mere-ruby: expected , or ) in parameters, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated parameter list" ++ parsing_file ()))) in fail ("mere-ruby: unterminated parameter list" ++ parsing_file ()))

// paren-less method params: `def m a, o=1, *r, &b` — terminated by newline
// (any non-comma token) rather than `)`.
and parse_bare_params = fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "*" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("*" ++ n) r2 acc defs
                  | _ -> parse_bare_after "*" r acc defs)
    else if str_eq p "&" || str_eq p " &" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("&" ++ n) r2 acc defs
                  | _ -> parse_bare_after "&" r acc defs)
    else if str_eq p "**" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("**" ++ n) r2 acc defs
                  | _ -> parse_bare_after "**__anonkw" r acc defs)
    else if str_eq p "..." then parse_bare_after "&__anonblk" r (Cons ("*__fwd", acc)) defs
    else (let __fm = ("mere-ruby: expected parameter name, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TId name, r) ->
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let (e, r3) = parse_expr r2 in parse_bare_after name r3 acc (Cons ((name, e), defs))
       // keyword parameter `name:` / `name: default`, encoded exactly as the
       // parenthesised form does ("name:" in the list, default keyed under
       // it). `def initialize class_loader, strict_integer: false` -- psych.
       else if str_eq eq ":" then
         let kn = name ++ ":" in
         (match r2 with
          | Cons (TP q, _) -> if str_eq q "," then parse_bare_after kn r2 acc defs
                              else let (e, r3) = parse_expr r2 in parse_bare_after kn r3 acc (Cons ((kn, e), defs))
          // `def m a, k:` with no default: the list ends at the newline.
          | Cons (TNL _, _) -> parse_bare_after kn r2 acc defs
          | _ -> let (e, r3) = parse_expr r2 in parse_bare_after kn r3 acc (Cons ((kn, e), defs)))
       else parse_bare_after name r acc defs
     | _ -> parse_bare_after name r acc defs)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected parameter name" ++ parsing_file ()))) in fail ("mere-ruby: expected parameter name" ++ parsing_file ()))

and parse_bare_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_bare_params r (Cons (name, acc)) defs
    else (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks)
  | _ -> (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks);

