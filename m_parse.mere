        let _ = (if str_eq cd "" || str_eq cd "UTF-8" || str_eq cd "UTF8" then ()
                 else if lex_raw_nonascii s (i + 1) (j - 1) then syn_refuse ("UTF-8 mixed within " ++ enc_canon_name cd ++ " source")
                 else ()) in
        tapp (Cons (TP "(s", Cons (TStrL "", segs))) (Cons (TP ")u8", lex_go s j))
      else
      (match segs with
       | Cons (TP plus, Cons (TStrL lit, Nil)) ->
         if str_eq plus "+" then Cons (TStrL lit, lex_go s j)
         else tapp (Cons (TP "(s", Cons (TStrL "", segs))) (Cons (TP ")", lex_go s j))
       | _ -> tapp (Cons (TP "(s", Cons (TStrL "", segs))) (Cons (TP ")", lex_go s j)))
    else if str_eq c "'" then
      let (lit, j) = lex_sq s (i + 1) "" in
      Cons (TStrL lit, lex_go s j)
