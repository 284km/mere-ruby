    else if str_eq c ":" && i + 2 < str_len s
            && (str_eq (char_at s (i + 1)) "@" || str_eq (char_at s (i + 1)) "$")
            && is_alpha (char_at s (i + 2)) then
      let j = scan_ident s (i + 2) in
      Cons (TSym (sym_note (substring s (i + 1) j)), lex_go s j)
    // `:$-w` and the rest of the dash globals name themselves as symbols too
    // (ruby's Symbol#inspect spec lists them), and they are three characters.
    else if str_eq c ":" && i + 3 < str_len s && str_eq (char_at s (i + 1)) "$"
            && str_eq (char_at s (i + 2)) "-" then
      Cons (TSym (sym_note (substring s (i + 1) (i + 4))), lex_go s (i + 4))
    // ⚠ `:$12` is ONE global, not `:$1` followed by 2. The numbered backref
    // globals run to as many digits as are written, and this branch took a
    // fixed three characters -- so `:$1234` lexed as `:$1` and left `234` as a
    // separate expression, which then parsed as something else entirely
    // (`p :$1234` was a syntax error and `:$1234.inspect` answered "234").
