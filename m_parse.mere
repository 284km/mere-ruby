      // its first byte only, and the two left over were "unexpected token"
      // (CRuby's test_string writes `assert_index(0, S("にんにちは"), ?に, 0)`).
      else (let w = lex_src_cw s (i + 1) in
            let w = (if i + 1 + w > str_len s then 1 else w) in
            Cons (TStrL (substring s (i + 1) (i + 1 + w)), lex_go s (i + 1 + w)))
    else if str_eq c "\"" then
      // double-quoted strings support #{expr} interpolation, desugared to a
      // parenthesized concat: `("" + "a" + (expr).to_s + "c")`.
