  "\n" ++
  "# DER/BER values are Ruby objects. Cryptographic operations live in the provider.\n" ++
  "module OpenSSL\n" ++
  "  module ASN1\n" ++
  "    class ASN1Error < OpenSSLError; end\n" ++
  "    TAG_CLASSES = [:UNIVERSAL, :APPLICATION, :CONTEXT_SPECIFIC, :PRIVATE].freeze\n" ++
  "    # Object identifier is tag 6; descriptor is tag 7.\n" ++
  "    UNIVERSAL_TAG_NAME = ['EOC', 'BOOLEAN', 'INTEGER', 'BIT_STRING', 'OCTET_STRING', 'NULL', 'OBJECT', 'OBJECT_DESCRIPTOR', 'EXTERNAL', 'REAL', 'ENUMERATED', 'EMBEDDED_PDV', 'UTF8STRING', 'RELATIVE_OID', nil, nil, 'SEQUENCE', 'SET', 'NUMERICSTRING', 'PRINTABLESTRING', 'T61STRING', 'VIDEOTEXSTRING', 'IA5STRING', 'UTCTIME', 'GENERALIZEDTIME', 'GRAPHICSTRING', 'ISO64STRING', 'GENERALSTRING', 'UNIVERSALSTRING', 'CHARACTER_STRING', 'BMPSTRING'].freeze\n" ++
  "    UNIVERSAL_TAG_NAME.each_with_index \{ |name, number| const_set(name, number) if name \}\n" ++
  "    OID_LOOKUP = \{\}\n" ++
  "    OID_NAMES.each \{ |oid, names| OID_LOOKUP[oid] = oid; names.each \{ |name| OID_LOOKUP[name] = oid \} \}\n" ++
  "\n" ++
  "    def self.string(value)\n" ++
  "      value = value.to_str if !value.is_a?(String) && value.respond_to?(:to_str)\n" ++
  "      raise TypeError, 'no implicit conversion into String' unless value.is_a?(String)\n" ++
  "      value.b\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.base128(value)\n" ++
  "      raise ASN1Error, 'negative tag or object identifier component' if value < 0\n" ++
  "      bytes = [value & 127]\n" ++
  "      while (value >>= 7) > 0\n" ++
  "        bytes.unshift((value & 127) | 128)\n" ++
  "      end\n" ++
  "      bytes.pack('C*')\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.tlv(tag, tag_class, constructed, payload, indefinite = false)\n" ++
  "      tag = ::Kernel.Integer(tag)\n" ++
  "      cls = TAG_CLASSES.index(tag_class)\n" ++
  "      raise ASN1Error, 'invalid tag class or number' if cls.nil? || tag < 0 || tag > 2147483647\n" ++
  "      raise ASN1Error, 'indefinite length for primitive value' if indefinite && !constructed\n" ++
  "      head = [cls * 64 + (constructed ? 32 : 0) + [tag, 31].min].pack('C')\n" ++
  "      head << base128(tag) if tag >= 31\n" ++
  "      if indefinite\n" ++
  "        return head + \"\\x80\".b + payload + \"\\x00\\x00\".b\n" ++
  "      end\n" ++
  "      length = payload.bytesize\n" ++
  "      if length < 128\n" ++
  "        head << [length].pack('C')\n" ++
  "      else\n" ++
  "        octets = []\n" ++
  "        while length > 0\n" ++
  "          octets.unshift(length & 255)\n" ++
  "          length >>= 8\n" ++
  "        end\n" ++
  "        head << ([128 + octets.length] + octets).pack('C*')\n" ++
  "      end\n" ++
  "      head + payload\n" ++
  "    end\n" ++
  "\n" ++
  "    class ASN1Data\n" ++
  "      attr_accessor :value, :tag, :tag_class, :indefinite_length\n" ++
  "      def initialize(value, tag, tag_class)\n" ++
  "        @value, @tag, @tag_class = value, ::Kernel.Integer(tag), tag_class\n" ++
  "        @indefinite_length = false\n" ++
  "        raise ASN1Error, 'invalid tag class' unless TAG_CLASSES.include?(tag_class)\n" ++
  "      end\n" ++
  "\n" ++
  "      def to_der\n" ++
  "        constructed = @value.is_a?(Array)\n" ++
  "        payload = constructed ? ASN1.contents(@value, @indefinite_length) : ASN1.string(@value)\n" ++
  "        ASN1.tlv(@tag, @tag_class, constructed, payload, @indefinite_length)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    module Tagged\n" ++
  "      attr_accessor :tagging\n" ++
  "      def initialize(value, tag = nil, tagging = nil, tag_class = nil)\n" ++
  "        default = self.class.const_defined?(:TAG) ? self.class.const_get(:TAG) : nil\n" ++
  "        tag = default if tag.nil?\n" ++
  "        raise ASN1Error, 'must specify tag number' if tag.nil?\n" ++
  "        raise ASN1Error, 'invalid tagging method' unless [nil, :IMPLICIT, :EXPLICIT].include?(tagging)\n" ++
  "        tag_class ||= tagging ? :CONTEXT_SPECIFIC : :UNIVERSAL\n" ++
  "        super(value, tag, tag_class)\n" ++
  "        @tagging = tagging\n" ++
  "      end\n" ++
  "\n" ++
  "      def tagged_der(payload, constructed)\n" ++
  "        if @tagging == :EXPLICIT\n" ++
  "          default = self.class.const_defined?(:TAG) ? self.class.const_get(:TAG) : @tag\n" ++
  "          inner = ASN1.tlv(default, :UNIVERSAL, constructed, payload, @indefinite_length)\n" ++
  "          ASN1.tlv(@tag, @tag_class, true, inner, @indefinite_length)\n" ++
  "        else\n" ++
  "          ASN1.tlv(@tag, @tag_class, constructed, payload, @indefinite_length)\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class Primitive < ASN1Data\n" ++
  "      include Tagged\n" ++
  "      undef_method :indefinite_length=\n" ++
  "      def to_der\n" ++
  "        tagged_der(ASN1.payload(self), false)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class Constructive < ASN1Data\n" ++
  "      include Tagged\n" ++
  "      include Enumerable\n" ++
  "      def to_der\n" ++
  "        tagged_der(ASN1.contents(@value.to_a, @indefinite_length), true)\n" ++
  "      end\n" ++
  "      def each(&block)\n" ++
  "        return enum_for(:each) unless block\n" ++
  "        @value.each(&block)\n" ++
  "        self\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class EndOfContent < ASN1Data\n" ++
  "      def initialize\n" ++
  "        super(''.b, 0, :UNIVERSAL)\n" ++
  "      end\n" ++
  "      def to_der\n" ++
  "        \"\\x00\\x00\".b\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class BitString < Primitive\n" ++
  "      TAG = 3\n" ++
  "      attr_accessor :unused_bits\n" ++
  "      def initialize(*args)\n" ++
  "        super\n" ++
  "        @unused_bits = 0\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.contents(values, indefinite)\n" ++
  "      chunks = []\n" ++
  "      values.each_with_index do |value, index|\n" ++
  "        if indefinite && value.is_a?(EndOfContent)\n" ++
  "          raise ASN1Error, 'illegal EOC octets in value' if index + 1 != values.length\n" ++
  "          break\n" ++
  "        end\n" ++
  "        value = value.to_der if value.respond_to?(:to_der)\n" ++
  "        chunks << string(value)\n" ++
  "      end\n" ++
  "      chunks.join.b\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.integer_bytes(number)\n" ++
  "      number = ::Kernel.Integer(number)\n" ++
  "      width = 1\n" ++
  "      width += 1 while number < -(1 << (8 * width - 1)) || number >= (1 << (8 * width - 1))\n" ++
  "      number += 1 << (width * 8) if number < 0\n" ++
  "      result = Array.new(width, 0)\n" ++
  "      (width - 1).downto(0) \{ |i| result[i] = number & 255; number >>= 8 \}\n" ++
  "      result.pack('C*')\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.payload(node)\n" ++
  "      value = node.value\n" ++
  "      case node\n" ++
  "      when Boolean then value ? \"\\xff\".b : \"\\x00\".b\n" ++
  "      when Integer, Enumerated then integer_bytes(value)\n" ++
  "      when Null then ''.b\n" ++
  "      when BitString\n" ++
  "        bits = node.unused_bits\n" ++
  "        raise ASN1Error, 'invalid unused bits' unless bits.is_a?(::Integer) && (0..7).include?(bits)\n" ++
  "        data = string(value).dup\n" ++
  "        data.setbyte(data.bytesize - 1, data.getbyte(data.bytesize - 1) & (255 << bits)) if bits > 0 && !data.empty?\n" ++
  "        [bits].pack('C') + data\n" ++
  "      when ObjectId\n" ++
  "        numbers = node.oid.split('.').map \{ |s| ::Kernel.Integer(s, 10) \}\n" ++
  "        raise ASN1Error, 'invalid object identifier' unless numbers.length >= 2 && (0..2).include?(numbers[0]) && numbers[1] >= 0 && (numbers[0] == 2 || numbers[1] < 40)\n" ++
  "        ([numbers[0] * 40 + numbers[1]] + numbers[2..]).map \{ |n| base128(n) \}.join.b\n" ++
  "      when UTCTime, GeneralizedTime\n" ++
  "        time = value.is_a?(Time) ? value.getutc : Time.at(::Kernel.Integer(value)).utc\n" ++
  "        range = node.is_a?(UTCTime) ? (1950..2049) : (0..9999)\n" ++
  "        raise ASN1Error, 'time is out of range' unless range.include?(time.year)\n" ++
  "        time.strftime(node.is_a?(UTCTime) ? '%y%m%d%H%M%SZ' : '%Y%m%d%H%M%SZ').b\n" ++
  "      else string(value)\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class ObjectId < Primitive\n" ++
  "      TAG = 6\n" ++
  "      def oid\n" ++
  "        text = ASN1.string(@value)\n" ++
  "        result = OID_LOOKUP[text] || text\n" ++
  "        raise ASN1Error, 'invalid object identifier' unless result.match?(/\\A[0-9]+(?:\\.[0-9]+)+\\z/)\n" ++
  "        result\n" ++
  "      end\n" ++
  "      def sn; OID_NAMES[oid]&.first; end\n" ++
  "      def ln; OID_NAMES[oid]&.last; end\n" ++
  "      alias short_name sn\n" ++
  "      alias long_name ln\n" ++
  "      def ==(other)\n" ++
  "        other.is_a?(ObjectId) && oid == other.oid\n" ++
  "      end\n" ++
  "      def self.register(oid, short, long)\n" ++
  "        oid, short, long = [oid, short, long].map \{ |v| ASN1.string(v) \}\n" ++
  "        raise ASN1Error, 'invalid or duplicate object identifier' if OID_NAMES.key?(oid) || OID_LOOKUP.key?(short) || OID_LOOKUP.key?(long)\n" ++
  "        ObjectId.new(oid).to_der\n" ++
  "        Backend.call('oid.register', oid, short, long) if defined?(Backend) && OpenSSL.__native_available\n" ++
  "        OID_NAMES[oid] = [short, long]\n" ++
  "        [oid, short, long].each \{ |name| OID_LOOKUP[name] = oid \}\n" ++
  "        true\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.read_node(source, position, limit, depth, visitor)\n" ++
  "      raise ASN1Error, 'ASN1 nesting is too deep' if depth > 512\n" ++
  "      start = position\n" ++
  "      raise ASN1Error, 'header too long' if position + 2 > limit\n" ++
  "      first = source.getbyte(position)\n" ++
  "      position += 1\n" ++
  "      tag = first & 31\n" ++
  "      if tag == 31\n" ++
  "        tag = 0\n" ++
  "        loop do\n" ++
  "          raise ASN1Error, 'invalid high tag' if position >= limit\n" ++
  "          octet = source.getbyte(position)\n" ++
  "          position += 1\n" ++
  "          tag = tag * 128 + (octet & 127)\n" ++
  "          raise ASN1Error, 'tag number too large' if tag > 2147483647\n" ++
  "          break if octet < 128\n" ++
  "        end\n" ++
  "      end\n" ++
  "      raise ASN1Error, 'missing length' if position >= limit\n" ++
  "      length = source.getbyte(position)\n" ++
  "      position += 1\n" ++
  "      indefinite = length == 128\n" ++
  "      if length > 128\n" ++
  "        count = length & 127\n" ++
  "        raise ASN1Error, 'invalid length' if count > 8 || position + count > limit\n" ++
  "        length = 0\n" ++
  "        count.times \{ length = length * 256 + source.getbyte(position); position += 1 \}\n" ++
  "      end\n" ++
  "      constructed = (first & 32) != 0\n" ++
  "      tag_class = TAG_CLASSES[first >> 6]\n" ++
  "      raise ASN1Error, 'indefinite primitive' if indefinite && !constructed\n" ++
  "      finish = indefinite ? limit : position + length\n" ++
  "      raise ASN1Error, 'too long' if finish > limit\n" ++
  "      visitor.call([depth, start, position - start, indefinite ? 0 : length, constructed, tag_class, tag]) if visitor\n" ++
  "      if constructed\n" ++
  "        values = []\n" ++
  "        loop do\n" ++
  "          if indefinite\n" ++
  "            # The pinned decoder accepts an empty indefinite envelope ending\n" ++
  "            # immediately after its header; its encoder supplies the EOC.\n" ++
  "            break if position == limit && values.empty?\n" ++
  "            raise ASN1Error, 'missing end of content' if position + 2 > limit\n" ++
  "            if source.getbyte(position) == 0 && source.getbyte(position + 1) == 0\n" ++
  "              visitor.call([depth + 1, position, 2, 0, false, :UNIVERSAL, 0]) if visitor\n" ++
  "              position += 2\n" ++
  "              break\n" ++
  "            end\n" ++
  "          else\n" ++
  "            break if position == finish\n" ++
  "          end\n" ++
  "          child, position = read_node(source, position, finish, depth + 1, visitor)\n" ++
  "          values << child\n" ++
  "        end\n" ++
  "        klass = tag_class == :UNIVERSAL ? \{16 => Sequence, 17 => Set\}[tag] : nil\n" ++
  "        node = klass ? klass.new(values) : (tag_class == :UNIVERSAL ? Constructive.new(values, tag) : ASN1Data.new(values, tag, tag_class))\n" ++
  "        node.indefinite_length = indefinite\n" ++
  "      else\n" ++
  "        raw = source.byteslice(position, length)\n" ++
  "        position = finish\n" ++
  "        klass = tag_class == :UNIVERSAL ? CLASSES[tag] : nil\n" ++
  "        case klass&.name\n" ++
  "        when 'OpenSSL::ASN1::EndOfContent'\n" ++
  "          raise ASN1Error, 'invalid end of content' unless length == 0\n" ++
  "          node = EndOfContent.new\n" ++
  "        when 'OpenSSL::ASN1::Boolean'\n" ++
  "          raise ASN1Error, 'invalid boolean' unless length == 1\n" ++
  "          node = Boolean.new(raw.getbyte(0) != 0)\n" ++
  "        when 'OpenSSL::ASN1::Integer', 'OpenSSL::ASN1::Enumerated'\n" ++
  "          raise ASN1Error, 'invalid integer' if length == 0\n" ++
  "          if length > 1 && ((raw.getbyte(0) == 0 && raw.getbyte(1) < 128) || (raw.getbyte(0) == 255 && raw.getbyte(1) >= 128))\n" ++
  "            raise ASN1Error, 'nonminimal integer encoding'\n" ++
  "          end\n" ++
  "          number = 0\n" ++
  "          raw.each_byte \{ |b| number = number * 256 + b \}\n" ++
  "          number -= 1 << (length * 8) if raw.getbyte(0) >= 128\n" ++
  "          node = klass.new(OpenSSL::BN.new(number))\n" ++
  "        when 'OpenSSL::ASN1::Null'\n" ++
  "          raise ASN1Error, 'invalid null' unless length == 0\n" ++
  "          node = Null.new(nil)\n" ++
  "        when 'OpenSSL::ASN1::BitString'\n" ++
  "          raise ASN1Error, 'invalid bit string' if length == 0 || raw.getbyte(0) > 7\n" ++
  "          node = BitString.new(raw.byteslice(1, length - 1))\n" ++
  "          node.unused_bits = raw.getbyte(0)\n" ++
  "        when 'OpenSSL::ASN1::ObjectId'\n" ++
  "          components = []\n" ++
  "          number = 0\n" ++
  "          raw.each_byte do |b|\n" ++
  "            number = number * 128 + (b & 127)\n" ++
  "            if b < 128\n" ++
  "              components << number\n" ++
  "              number = 0\n" ++
  "            end\n" ++
  "          end\n" ++
  "          raise ASN1Error, 'invalid object identifier' if components.empty? || raw.getbyte(length - 1) >= 128\n" ++
  "          first_oid = components.shift\n" ++
  "          components.unshift(first_oid < 80 ? first_oid % 40 : first_oid - 80)\n" ++
  "          components.unshift(first_oid < 80 ? first_oid / 40 : 2)\n" ++
  "          oid = components.join('.')\n" ++
  "          node = ObjectId.new(OID_NAMES[oid]&.first || oid)\n" ++
  "        when 'OpenSSL::ASN1::UTCTime', 'OpenSSL::ASN1::GeneralizedTime'\n" ++
  "          digits = klass == UTCTime ? 12 : 14\n" ++
  "          pattern = klass == UTCTime ? /\\A[0-9]\{12\}Z\\z/ : /\\A[0-9]\{14\}(?:\\.[0-9]+)?Z\\z/\n" ++
  "          raise ASN1Error, 'invalid time' unless raw.match?(pattern)\n" ++
  "          width = klass == UTCTime ? 2 : 4\n" ++
  "          year = raw[0, width].to_i\n" ++
  "          year += year < 50 ? 2000 : 1900 if width == 2\n" ++
  "          values = [year] + raw[width, 10].scan(/../).map(&:to_i)\n" ++
  "          begin\n" ++
  "            time = Time.utc(*values)\n" ++
  "            raise ASN1Error, 'invalid time' unless [time.year, time.mon, time.day, time.hour, time.min, time.sec] == values\n" ++
  "            node = klass.new(time)\n" ++
  "          rescue ArgumentError\n" ++
  "            raise ASN1Error, 'invalid time'\n" ++
  "          end\n" ++
  "        else\n" ++
  "          node = klass && klass != Sequence && klass != Set ? klass.new(raw) : ASN1Data.new(raw, tag, tag_class)\n" ++
  "        end\n" ++
  "      end\n" ++
  "      [node, position]\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.input(value)\n" ++
  "      value = value.to_der if value.respond_to?(:to_der)\n" ++
  "      string(value)\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.decode(value)\n" ++
  "      source = input(value)\n" ++
  "      node, position = read_node(source, 0, source.bytesize, 0, nil)\n" ++
  "      raise ASN1Error, 'Type mismatch. Total bytes read does not match supplied data' unless position == source.bytesize\n" ++
  "      node\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.decode_all(value)\n" ++
  "      source = input(value)\n" ++
  "      nodes, position = [], 0\n" ++
  "      while position < source.bytesize\n" ++
  "        node, position = read_node(source, position, source.bytesize, 0, nil)\n" ++
  "        nodes << node\n" ++
  "      end\n" ++
  "      nodes\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.traverse(value, &block)\n" ++
  "      raise LocalJumpError, 'no block given' unless block\n" ++
  "      source = input(value)\n" ++
  "      _, position = read_node(source, 0, source.bytesize, 0, block)\n" ++
  "      raise ASN1Error, 'trailing data' unless position == source.bytesize\n" ++
  "      nil\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module OpenSSL\n" ++
  "  module ASN1\n" ++
  "    def self.EndOfContent(*args); EndOfContent.new(*args); end\n" ++
  "    class Boolean < Primitive; TAG = 1; end\n" ++
  "    def self.Boolean(*args); Boolean.new(*args); end\n" ++
  "    class Integer < Primitive; TAG = 2; end\n" ++
  "    def self.Integer(*args); Integer.new(*args); end\n" ++
  "    def self.BitString(*args); BitString.new(*args); end\n" ++
  "    class OctetString < Primitive; TAG = 4; end\n" ++
  "    def self.OctetString(*args); OctetString.new(*args); end\n" ++
  "    class Null < Primitive; TAG = 5; end\n" ++
  "    def self.Null(*args); Null.new(*args); end\n" ++
  "    def self.ObjectId(*args); ObjectId.new(*args); end\n" ++
  "    class Enumerated < Primitive; TAG = 10; end\n" ++
  "    def self.Enumerated(*args); Enumerated.new(*args); end\n" ++
  "    class UTF8String < Primitive; TAG = 12; end\n" ++
  "    def self.UTF8String(*args); UTF8String.new(*args); end\n" ++
  "    class Sequence < Constructive; TAG = 16; end\n" ++
  "    def self.Sequence(*args); Sequence.new(*args); end\n" ++
  "    class Set < Constructive; TAG = 17; end\n" ++
  "    def self.Set(*args); Set.new(*args); end\n" ++
  "    class NumericString < Primitive; TAG = 18; end\n" ++
  "    def self.NumericString(*args); NumericString.new(*args); end\n" ++
  "    class PrintableString < Primitive; TAG = 19; end\n" ++
  "    def self.PrintableString(*args); PrintableString.new(*args); end\n" ++
  "    class T61String < Primitive; TAG = 20; end\n" ++
  "    def self.T61String(*args); T61String.new(*args); end\n" ++
  "    class VideotexString < Primitive; TAG = 21; end\n" ++
  "    def self.VideotexString(*args); VideotexString.new(*args); end\n" ++
  "    class IA5String < Primitive; TAG = 22; end\n" ++
  "    def self.IA5String(*args); IA5String.new(*args); end\n" ++
  "    class UTCTime < Primitive; TAG = 23; end\n" ++
  "    def self.UTCTime(*args); UTCTime.new(*args); end\n" ++
  "    class GeneralizedTime < Primitive; TAG = 24; end\n" ++
  "    def self.GeneralizedTime(*args); GeneralizedTime.new(*args); end\n" ++
  "    class GraphicString < Primitive; TAG = 25; end\n" ++
  "    def self.GraphicString(*args); GraphicString.new(*args); end\n" ++
  "    class ISO64String < Primitive; TAG = 26; end\n" ++
  "    def self.ISO64String(*args); ISO64String.new(*args); end\n" ++
  "    class GeneralString < Primitive; TAG = 27; end\n" ++
  "    def self.GeneralString(*args); GeneralString.new(*args); end\n" ++
  "    class UniversalString < Primitive; TAG = 28; end\n" ++
  "    def self.UniversalString(*args); UniversalString.new(*args); end\n" ++
  "    class BMPString < Primitive; TAG = 30; end\n" ++
  "    def self.BMPString(*args); BMPString.new(*args); end\n" ++
  "    CLASSES = \{0 => EndOfContent, 1 => Boolean, 2 => Integer, 3 => BitString, 4 => OctetString, 5 => Null, 6 => ObjectId, 10 => Enumerated, 12 => UTF8String, 16 => Sequence, 17 => Set, 18 => NumericString, 19 => PrintableString, 20 => T61String, 21 => VideotexString, 22 => IA5String, 23 => UTCTime, 24 => GeneralizedTime, 25 => GraphicString, 26 => ISO64String, 27 => GeneralString, 28 => UniversalString, 30 => BMPString\}.freeze\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module OpenSSL\n" ++
  "  class NativeObject\n" ++
  "    def __native_id\n" ++
  "      OpenSSL.__native_handle(self)\n" ++
  "    end\n" ++
  "    def __adopt(id)\n" ++
  "      OpenSSL.__native_bind(self, id)\n" ++
  "      self\n" ++
  "    end\n" ++
  "    def __take(other)\n" ++
  "      OpenSSL.__native_move(other, self)\n" ++
  "      self\n" ++
  "    end\n" ++
  "    def __close_native\n" ++
  "      OpenSSL.__native_release(self)\n" ++
  "    end\n" ++
  "    def initialize_copy(other)\n" ++
  "      __take(Backend.call('object.copy', other))\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  module Backend\n" ++
  "    class KeygenJob < NativeObject; end\n" ++
  "    def self.generate(algorithm, options, parameters, &block)\n" ++
  "      job = call('keygen.start', algorithm, options, parameters)\n" ++
  "      begin\n" ++
  "        loop do\n" ++
  "          step = call('keygen.poll', job)\n" ++
  "          case step[0]\n" ++
  "          when 'done' then return step[1]\n" ++
  "          when 'progress'\n" ++
  "            block.call(*step[1]) if block\n" ++
  "            call('keygen.respond', job)\n" ++
  "          when 'pending' then sleep(0.001)\n" ++
  "          else raise OpenSSLError, 'invalid generation job state'\n" ++
  "          end\n" ++
  "        end\n" ++
  "      ensure\n" ++
  "        job.__close_native\n" ++
  "      end\n" ++
  "    end\n" ++
  "    def self.wrap(name, handle)\n" ++
  "      begin\n" ++
  "        Object.const_get(name).allocate.__adopt(handle)\n" ++
  "      rescue Exception\n" ++
  "        call('object.release', handle)\n" ++
  "        raise\n" ++
  "      end\n" ++
  "    end\n" ++
  "    def self.pack(value)\n" ++
  "      case value\n" ++
  "      when nil then 'n'\n" ++
  "      when true then 't'\n" ++
  "      when false then 'f'\n" ++
  "      when Integer\n" ++
  "        text = value.to_s\n" ++
  "        'i' + [text.bytesize].pack('N') + text\n" ++
  "      when String then 's' + [value.bytesize].pack('N') + value.b\n" ++
  "      when Array then 'a' + [value.length].pack('N') + value.map \{ |v| pack(v) \}.join\n" ++
  "      when Hash then 'm' + [value.length].pack('N') + value.map \{ |k, v| pack(k) + pack(v) \}.join\n" ++
  "      when NativeObject then pack(value.__native_id)\n" ++
  "      else raise TypeError, 'unsupported provider argument'\n" ++
  "      end.b\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.item(source, position, owners = [])\n" ++
  "      kind = source.getbyte(position)\n" ++
  "      position += 1\n" ++
  "      case kind\n" ++
  "      when 110 then return [nil, position]\n" ++
  "      when 116 then return [true, position]\n" ++
  "      when 102 then return [false, position]\n" ++
  "      when 101, 69\n" ++
  "        name, position = item(source, position, owners)\n" ++
  "        message, position = item(source, position, owners)\n" ++
  "        exception = Object.const_get(name).new(message)\n" ++
  "        if kind == 69\n" ++
  "          errors, position = item(source, position, owners)\n" ++
  "          exception.instance_variable_set(:@errors, errors)\n" ++
  "        end\n" ++
  "        raise exception\n" ++
  "      end\n" ++
  "      raise OpenSSLError, 'invalid provider response' unless position + 4 <= source.bytesize\n" ++
  "      size = source.byteslice(position, 4).unpack1('N')\n" ++
  "      position += 4\n" ++
  "      case kind\n" ++
  "      when 104\n" ++
  "        name, position = item(source, position, owners)\n" ++
  "        value = wrap(name, size)\n" ++
  "        owners << value\n" ++
  "        [value, position]\n" ++
  "      when 105, 115\n" ++
  "        raise OpenSSLError, 'invalid provider string' unless position + size <= source.bytesize\n" ++
  "        text = source.byteslice(position, size)\n" ++
  "        [kind == 105 ? text.to_i : text, position + size]\n" ++
  "      when 97, 109\n" ++
  "        values = []\n" ++
  "        (kind == 109 ? size * 2 : size).times do\n" ++
  "          value, position = item(source, position, owners)\n" ++
  "          values << value\n" ++
  "        end\n" ++
  "        [kind == 109 ? values.each_slice(2).to_h : values, position]\n" ++
  "      else raise OpenSSLError, 'invalid provider response type'\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    def self.call(operation, *args)\n" ++
  "      raise NotImplementedError, 'native OpenSSL provider is unavailable on this target' unless OpenSSL.__native_available\n" ++
  "      # Do not deliver an asynchronous exception between native allocation and\n" ++
  "      # installing its Ruby owner. Native jobs yield outside this small region.\n" ++
  "      owners = []\n" ++
  "      delivered = false\n" ++
  "      result = Thread.handle_interrupt(Object => :never) do\n" ++
  "        source = OpenSSL.__native_call(operation, pack(args))\n" ++
  "        value, position = item(source, 0, owners)\n" ++
  "        raise OpenSSLError, 'trailing provider response' unless position == source.bytesize\n" ++
  "        value\n" ++
  "      end\n" ++
  "      delivered = true\n" ++
  "      result\n" ++
  "    ensure\n" ++
  "      # A deferred interrupt may be raised as the mask ends. Such a response\n" ++
  "      # never reached its caller, so dispose all of its native objects now,\n" ++
  "      # including handles already decoded from an incomplete response.\n" ++
  "      if owners && !delivered\n" ++
  "        Thread.handle_interrupt(Object => :never) do\n" ++
  "          owners.each \{ |owner| owner.__close_native \}\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def self.errors\n" ++
  "    __native_available ? Backend.call('errors') : []\n" ++
  "  end\n" ++
  "  def self.fips_mode\n" ++
  "    __native_available && Backend.call('fips_mode')\n" ++
  "  end\n" ++
  "\n" ++
  "  if __native_available\n" ++
  "    OPENSSL_VERSION = Backend.call('version')\n" ++
  "    OPENSSL_LIBRARY_VERSION = OPENSSL_VERSION\n" ++
  "    OPENSSL_VERSION_NUMBER = Backend.call('version_number')\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "if OpenSSL.__native_available\n" ++
  "  module OpenSSL\n" ++
  "    module Backend\n" ++
  "      class DigestContext < NativeObject; end\n" ++
  "      class HMACContext < NativeObject; end\n" ++
  "    end\n" ++
  "    class HMACError < OpenSSLError; end\n" ++
  "    class Digest\n" ++
  "      def initialize(name, data = nil)\n" ++
  "        name = name.name if name.is_a?(Digest)\n" ++
  "        @native = Backend.call('digest.new', OpenSSL.__str(name))\n" ++
  "        @name, @digest_length, @block_length = Backend.call('digest.info', @native)\n" ++
  "        update(data) unless data.nil?\n" ++
  "      end\n" ++
  "      def initialize_copy(other)\n" ++
  "        @native = Backend.call('object.copy', other.instance_variable_get(:@native))\n" ++
  "      end\n" ++
  "      private :initialize_copy\n" ++
  "      def name; @name.dup; end\n" ++
  "      def digest_length; @digest_length; end\n" ++
  "      alias size digest_length\n" ++
  "      alias length digest_length\n" ++
  "      def block_length; @block_length; end\n" ++
  "      def update(data); Backend.call('digest.update', @native, OpenSSL.__str(data)); self; end\n" ++
  "      alias << update\n" ++
  "      def reset; Backend.call('digest.reset', @native); self; end\n" ++
  "      def digest(*args)\n" ++
  "        raise ArgumentError, 'wrong number of arguments' if args.size>1\n" ++
  "        unless args.empty?\n" ++
  "          reset\n" ++
  "          update(args[0])\n" ++
  "        end\n" ++
  "        result = Backend.call('digest.final', @native)\n" ++
  "        reset unless args.empty?\n" ++
  "        result\n" ++
  "      end\n" ++
  "      def digest!; result=digest; reset; result; end\n" ++
  "      def hexdigest(*args); digest(*args).unpack1('H*'); end\n" ++
  "      def hexdigest!; digest!.unpack1('H*'); end\n" ++
  "      def base64digest(*args); [digest(*args)].pack('m0'); end\n" ++
  "      def base64digest!; [digest!].pack('m0'); end\n" ++
  "      alias to_s hexdigest\n" ++
  "      def ==(other); other.is_a?(Digest) && digest==other.digest; end\n" ++
  "      def self.digest(name, data = nil)\n" ++
  "        __algo ? new(name).digest : new(name, OpenSSL.__str(data)).digest\n" ++
  "      end\n" ++
  "      def self.hexdigest(name, data = nil); digest(name, data).unpack1('H*'); end\n" ++
  "      def self.base64digest(name, data = nil); [digest(name, data)].pack('m0'); end\n" ++
  "      def self.digests; Backend.call('digest.list').uniq.sort; end\n" ++
  "      class SHA224 < Digest\n" ++
  "        def self.__algo; 'SHA224'; end\n" ++
  "        def initialize(data = nil); super('SHA224', data); end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    def self.Digest(name); Digest.const_get(OpenSSL.__str(name)); end\n" ++
  "\n" ++
  "    class HMAC\n" ++
  "      def initialize(key, digest)\n" ++
  "        digest = digest.name if digest.is_a?(Digest)\n" ++
  "        @native = Backend.call('hmac.new', OpenSSL.__str(key), OpenSSL.__str(digest))\n" ++
  "      end\n" ++
  "      def initialize_copy(other); @native=Backend.call('object.copy', other.instance_variable_get(:@native)); end\n" ++
  "      private :initialize_copy\n" ++
  "      def update(value); Backend.call('hmac.update', @native, OpenSSL.__str(value)); self; end\n" ++
  "      alias << update\n" ++
  "      def reset; Backend.call('hmac.reset', @native); self; end\n" ++
  "      def digest; Backend.call('hmac.final', @native); end\n" ++
  "      def hexdigest; digest.unpack1('H*'); end\n" ++
  "      def base64digest; [digest].pack('m0'); end\n" ++
  "      alias to_s hexdigest\n" ++
  "      def ==(other); other.is_a?(HMAC) && OpenSSL.fixed_length_secure_compare(digest, other.digest); end\n" ++
  "      def self.digest(digest, key, data); new(key,digest).update(data).digest; end\n" ++
  "      def self.hexdigest(digest,key,data); self.digest(digest,key,data).unpack1('H*'); end\n" ++
  "      def self.base64digest(digest,key,data); [self.digest(digest,key,data)].pack('m0'); end\n" ++
  "    end\n" ++
  "    module KDF\n" ++
  "      class KDFError < OpenSSLError; end\n" ++
  "      def self.hash_name(hash); hash.is_a?(Digest) ? hash.name : OpenSSL.__str(hash); end\n" ++
  "      def self.pbkdf2_hmac(password, salt:, iterations:, length:, hash:)\n" ++
  "        Backend.call('kdf.pbkdf2', OpenSSL.__str(password), OpenSSL.__str(salt), Integer(length), Integer(iterations), hash_name(hash))\n" ++
  "      end\n" ++
  "      def self.scrypt(password, salt:, r:, p:, length:, **options)\n" ++
  "        cost = options.fetch(:N) \{ raise ArgumentError, 'missing keyword: N' \}\n" ++
  "        raise ArgumentError, 'unknown scrypt keyword' unless options.size == 1\n" ++
  "        Backend.call('kdf.scrypt', OpenSSL.__str(password), OpenSSL.__str(salt), Integer(length), Integer(cost), Integer(r), Integer(p))\n" ++
  "      end\n" ++
  "      def self.hkdf(key, salt:, info:, length:, hash:)\n" ++
  "        Backend.call('kdf.hkdf', OpenSSL.__str(key), OpenSSL.__str(salt), Integer(length), OpenSSL.__str(info), hash_name(hash))\n" ++
  "      end\n" ++
  "    end\n" ++
  "    module PKCS5\n" ++
  "      def self.pbkdf2_hmac(password,salt,iterations,length,hash)\n" ++
  "        KDF.pbkdf2_hmac(password,salt: salt,iterations: iterations,length: length,hash: hash)\n" ++
  "      end\n" ++
  "      def self.pbkdf2_hmac_sha1(password,salt,iterations,length)\n" ++
  "        pbkdf2_hmac(password,salt,iterations,length,'SHA1')\n" ++
  "      end\n" ++
  "    end\n" ++
  "    class Provider < NativeObject\n" ++
  "      class ProviderError < OpenSSLError; end\n" ++
  "      private_class_method :new\n" ++
  "      def self.load(name); Backend.call('provider.load', OpenSSL.__str(name)); end\n" ++
  "      def self.provider_names; Backend.call('provider.list'); end\n" ++
  "      def name; Backend.call('provider.name', self); rescue TypeError; raise ProviderError, 'provider was unloaded'; end\n" ++
  "      def unload\n" ++
  "        name\n" ++
  "        __close_native\n" ++
  "      end\n" ++
  "      def inspect; \"#<#\{self.class\} name=#\{name\}>\"; end\n" ++
  "    end\n" ++
  "    def self.fips_mode=(enabled)\n" ++
  "      Backend.call('set_fips_mode', !!enabled)\n" ++
  "      enabled\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "if OpenSSL.__native_available\n" ++
  "  module OpenSSL\n" ++
  "    module Backend\n" ++
  "      class CipherContext < NativeObject; end\n" ++
  "    end\n" ++
  "    class Cipher\n" ++
  "      def initialize(name)\n" ++
  "        raise RuntimeError, 'Cipher already initialized' if @native\n" ++
  "        @native = Backend.call('cipher.new', OpenSSL.__str(name))\n" ++
  "      end\n" ++
  "      def initialize_copy(other); @native=Backend.call('object.copy', other.instance_variable_get(:@native)); end\n" ++
  "      private :initialize_copy\n" ++
  "      def __provider(operation, *args)\n" ++
  "        raise RuntimeError, 'Cipher not initialized!' unless @native\n" ++
  "        Backend.call('cipher.' + operation, @native, *args)\n" ++
  "      end\n" ++
  "      def self.ciphers; Backend.call('cipher.list').map(&:downcase).uniq.sort; end\n" ++
  "      def name; __provider('info')[0]; end\n" ++
  "      def key_len; __provider('info')[1]; end\n" ++
  "      def iv_len; __provider('info')[2]; end\n" ++
  "      def block_size; __provider('info')[3]; end\n" ++
  "      def authenticated?; __provider('info')[4]; end\n" ++
  "      def encrypt; __provider('encrypt'); self; end\n" ++
  "      def decrypt; __provider('decrypt'); self; end\n" ++
  "      def reset; __provider('reset'); self; end\n" ++
  "      def key_len=(value); __provider('set_key_length', Integer(value)); value; end\n" ++
  "      def iv_len=(value); __provider('set_iv_length', Integer(value)); value; end\n" ++
  "      def key=(value); __provider('set_key', OpenSSL.__str(value)); value; end\n" ++
  "      def iv=(value); __provider('set_iv', OpenSSL.__str(value)); value; end\n" ++
  "      def padding=(value); __provider('set_padding', Integer(value)!=0); value; end\n" ++
  "      def update(value, buffer = nil)\n" ++
  "        raise FrozenError, \"can't modify frozen String\" if buffer && buffer.frozen?\n" ++
  "        result=__provider('update', OpenSSL.__str(value))\n" ++
  "        if buffer\n" ++
  "          encoding = buffer.encoding\n" ++
  "          buffer.replace(result).force_encoding(encoding)\n" ++
  "        else\n" ++
  "          result\n" ++
  "        end\n" ++
  "      end\n" ++
  "      def final; __provider('final'); end\n" ++
  "      def random_key; self.key=Random.random_bytes(key_len); end\n" ++
  "      def random_iv; self.iv=Random.random_bytes(iv_len); end\n" ++
  "      def pkcs5_keyivgen(password, salt = nil, iterations = 2048, digest = 'MD5')\n" ++
  "        __provider('pkcs5_keyivgen', OpenSSL.__str(password), salt.nil? ? nil : OpenSSL.__str(salt), iterations.nil? ? 2048 : Integer(iterations), digest.nil? ? 'MD5' : digest.is_a?(Digest) ? digest.name : OpenSSL.__str(digest))\n" ++
  "        nil\n" ++
  "      end\n" ++
  "      def auth_data=(value); __provider('auth_data', OpenSSL.__str(value)); value; end\n" ++
  "      def auth_tag=(value); __provider('set_auth_tag', OpenSSL.__str(value)); value; end\n" ++
  "      def auth_tag(length = nil); __provider('auth_tag', length.nil? ? nil : Integer(length)); end\n" ++
  "      def auth_tag_len=(value); __provider('auth_tag_length', Integer(value)); value; end\n" ++
  "      def ccm_data_len=(value); __provider('ccm_data_length', Integer(value)); value; end\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n" ++
  "\n" ++
  "module OpenSSL\n" ++
  "  module PKey\n" ++
  "    class PKeyError < OpenSSLError; end\n" ++
  "    class PasswordRequired < PKeyError; end\n" ++
  "\n" ++
  "    def self.string(value)\n" ++
  "      text = OpenSSL.__str(value)\n" ++
  "      raise TypeError, 'no implicit conversion into String' unless text.is_a?(String)\n" ++
  "      text\n" ++
  "    end\n" ++
  "    def self.data(value)\n" ++
  "      value = value.read if value.is_a?(IO)\n" ++
  "      value = value.to_der if value.respond_to?(:to_der)\n" ++
  "      string(value)\n" ++
  "    end\n" ++
  "    def self.options(value)\n" ++
  "      raise TypeError, \"wrong argument type #\{value.class\} (expected Hash)\" unless value.is_a?(Hash)\n" ++
  "      result = \{\}\n" ++
  "      value.each \{ |k, v| result[string(k)] = v.to_s \}\n" ++
  "      result\n" ++
  "    end\n" ++
  "    def self.digest_name(value)\n" ++
  "      return nil if value.nil?\n" ++
  "      value.is_a?(OpenSSL::Digest) ? value.name : string(value)\n" ++
  "    end\n" ++
  "    def self.read(value, password = nil, &block)\n" ++
  "      read_kind(nil, value, password, &block)\n" ++
  "    end\n" ++
  "    def self.read_kind(kind, value, password = nil, &block)\n" ++
  "      bytes = data(value)\n" ++
  "      password = string(password) unless password.nil?\n" ++
  "      begin\n" ++
  "        Backend.call('pkey.read', bytes, password, kind)\n" ++
  "      rescue PasswordRequired => error\n" ++
  "        raise PKeyError, error.message unless block && password.nil?\n" ++
  "        password = block.call(false)\n" ++
  "        raise PKeyError, 'password callback did not return a String' if password.nil?\n" ++
  "        begin\n" ++
  "          Backend.call('pkey.read', bytes, string(password), kind)\n" ++
  "        rescue PasswordRequired => failure\n" ++
  "          raise PKeyError, failure.message\n" ++
  "        end\n" ++
  "      end\n" ++
  "    end\n" ++
  "    def self.generate_key(algorithm, options = \{\}, &block)\n" ++
  "      Backend.generate(algorithm, self.options(options), false, &block)\n" ++
  "    end\n" ++
  "    def self.generate_parameters(algorithm, options = \{\}, &block)\n" ++
  "      Backend.generate(algorithm, self.options(options), true, &block)\n" ++
  "    end\n" ++
  "    def self.new_raw_private_key(algorithm, data)\n" ++
  "      Backend.call('pkey.new_raw_private_key', string(algorithm), string(data))\n" ++
  "    end\n" ++
  "    def self.new_raw_public_key(algorithm, data)\n" ++
  "      Backend.call('pkey.new_raw_public_key', string(algorithm), string(data))\n" ++
  "    end\n" ++
  "\n" ++
  "    class PKey < NativeObject\n" ++
  "      def initialize\n" ++
  "        raise TypeError, 'PKey is an abstract class'\n" ++
  "      end\n" ++
  "      def oid; Backend.call('pkey.oid', self); end\n" ++
  "      def inspect\n" ++
  "        \"#<#\{self.class\}:#\{object_id\} oid=#\{oid\} type_name=#\{Backend.call('pkey.type_name', self)\}>\"\n" ++
  "      end\n" ++
  "      def private?; Backend.call('pkey.private', self); end\n" ++
  "      def public?; Backend.call('pkey.public', self); end\n" ++
  "      def to_text; Backend.call('pkey.to_text', self); end\n" ++
  "      def export_format(format, cipher = nil, password = nil, &block)\n" ++
  "        cipher = cipher.is_a?(OpenSSL::Cipher) ? cipher.name : ::OpenSSL::PKey.string(cipher) unless cipher.nil?\n" ++
  "        password = block.call(true) if cipher && password.nil? && block\n" ++
  "        password = ::OpenSSL::PKey.string(password) unless password.nil?\n" ++
  "        raise PKeyError, 'password required' if cipher && password.nil?\n" ++
  "        Backend.call('pkey.export', self, format, cipher, password)\n" ++
  "      end\n" ++
  "      private :export_format\n" ++
  "      def private_to_der(*args, &block); export_format('private_der', *args, &block); end\n" ++
  "      def private_to_pem(*args, &block); export_format('private_pem', *args, &block); end\n" ++
  "      def public_to_der; export_format('public_der'); end\n" ++
  "      def public_to_pem; export_format('public_pem'); end\n" ++
  "      def raw_private_key; Backend.call('pkey.raw_private_key', self); end\n" ++
  "      def raw_public_key; Backend.call('pkey.raw_public_key', self); end\n" ++
  "      def compare?(other); Backend.call('pkey.compare', self, other); end\n" ++
  "      def sign(digest, data, options = \{\})\n" ++
  "        Backend.call('pkey.sign', self, ::OpenSSL::PKey.digest_name(digest), ::OpenSSL::PKey.string(data), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def verify(digest, signature, data, options = \{\})\n" ++
  "        Backend.call('pkey.verify', self, ::OpenSSL::PKey.digest_name(digest), ::OpenSSL::PKey.string(signature), ::OpenSSL::PKey.string(data), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def sign_raw(digest, data, options = \{\})\n" ++
  "        Backend.call('pkey.sign_raw', self, ::OpenSSL::PKey.digest_name(digest), ::OpenSSL::PKey.string(data), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def verify_raw(digest, signature, data, options = \{\})\n" ++
  "        Backend.call('pkey.verify_raw', self, ::OpenSSL::PKey.digest_name(digest), ::OpenSSL::PKey.string(signature), ::OpenSSL::PKey.string(data), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def verify_recover(digest, signature, options = \{\})\n" ++
  "        Backend.call('pkey.verify_recover', self, ::OpenSSL::PKey.digest_name(digest), ::OpenSSL::PKey.string(signature), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def encrypt(data, options = \{\})\n" ++
  "        Backend.call('pkey.encrypt', self, ::OpenSSL::PKey.string(data), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def decrypt(data, options = \{\})\n" ++
  "        Backend.call('pkey.decrypt', self, ::OpenSSL::PKey.string(data), ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "      def derive(other, options = \{\})\n" ++
  "        raise TypeError, 'expected an OpenSSL::PKey' unless other.is_a?(PKey)\n" ++
  "        Backend.call('pkey.derive', self, other, ::OpenSSL::PKey.options(options))\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    class RSA < PKey\n" ++
  "      PKCS1_PSS_PADDING = 6\n" ++
  "      def initialize(value, password = nil, &block)\n" ++
  "        key = value.is_a?(RSA) ? Backend.call('object.copy', value) : OpenSSL::PKey.read_kind('RSA', value, password, &block)\n" ++
  "        raise PKeyError, 'incorrect pkey type' unless key.is_a?(RSA)\n" ++
  "        __take(key)\n" ++
  "      end\n" ++
  "      def to_der; export_format('traditional_der'); end\n" ++
  "      def export(*args, &block); export_format('traditional_pem', *args, &block); end\n" ++
  "      alias to_pem export\n" ++
  "      def sign_pss(digest, data, salt_length:, mgf1_hash:)\n" ++
  "        salt = \{digest: -1, max: -2\}.fetch(salt_length, salt_length)\n" ++
  "        sign(digest, data, \{'rsa_padding_mode'=>'pss','rsa_pss_saltlen'=>salt,'rsa_mgf1_md'=>::OpenSSL::PKey.digest_name(mgf1_hash)\})\n" ++
  "      end\n" ++
  "      def verify_pss(digest, signature, data, salt_length:, mgf1_hash:)\n" ++
  "        salt = \{digest: -1, auto: -2\}.fetch(salt_length, salt_length)\n" ++
  "        verify(digest, signature, data, \{'rsa_padding_mode'=>'pss','rsa_pss_saltlen'=>salt,'rsa_mgf1_md'=>::OpenSSL::PKey.digest_name(mgf1_hash)\})\n" ++
  "      end\n" ++
  "    end\n" ++
  "    class DSA < PKey\n" ++
  "      def initialize(value, password = nil, &block)\n" ++
  "        key = value.is_a?(DSA) ? Backend.call('object.copy', value) : OpenSSL::PKey.read_kind('DSA', value, password, &block)\n" ++
  "        raise PKeyError, 'incorrect pkey type' unless key.is_a?(DSA)\n" ++
  "        __take(key)\n" ++
  "      end\n" ++
  "      def to_der; export_format('traditional_der'); end\n" ++
  "      def export(*args, &block); export_format('traditional_pem', *args, &block); end\n" ++
  "      alias to_pem export\n" ++
  "    end\n" ++
  "    class DH < PKey\n" ++
