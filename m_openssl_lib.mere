  "    class EC < PKey\n" ++
  "      NAMED_CURVE = 1\n" ++
  "      EXPLICIT_CURVE = 0\n" ++
  "      class Group < NativeObject; end\n" ++
  "      class Point < NativeObject; end\n" ++
  "      def initialize(value, password = nil, &block)\n" ++
  "        key = value.is_a?(EC) ? Backend.call('object.copy', value) : OpenSSL::PKey.read(value, password, &block)\n" ++
