// ---- the part of the Fibers that needs threads (see m_fiber.mere) -----------
// A build that has no threads (the Wasm playground, the RV targets) compiles
// m_fiber_nothreads.mere in this file's place: same names, and a fiber that
// runs to completion on the first #resume, as fibers did here before.
let fb_can_suspend = true;

// index -> its inbox
let fb_inbox = map_new ();

let fb_inbox_of = fn (i: int) ->
  if map_has fb_inbox i then map_get fb_inbox i
  else (let c = channel_new () in let _ = map_set fb_inbox i c in c);


// THE SWITCH. Save this stack, name the target as running, wake it, and wait
// to be woken. ⚠ Both channels are looked up BEFORE the send: once the token
// is sent the other thread is running and may add to fb_inbox, and this one
// must not touch a shared map again until it is woken.
let fb_switch = fn (from: int) -> fn (to: int) ->
  let rx = fb_inbox_of from in
  let tx = fb_inbox_of to in
  let _ = fb_ctx_save from in
  let _ = map_set fb_st "cur" to in
  let _ = channel_send tx to in
  let _ = channel_recv rx in
  let _ = fb_ctx_restore from in
  map_set fb_st "cur" from;
// the last hand-off a fiber's thread makes: nothing to save, nothing to wait for
let fb_hand_over = fn (to: int) ->
  let tx = fb_inbox_of to in
  let _ = map_set fb_st "cur" to in
  channel_send tx to;


// ---- a pool of fiber threads -------------------------------------------------
// Starting an OS thread with the interpreter's 512MB stack costs about 0.4 ms,
// and a program that makes a fiber per item pays it per item (CSV.parse_line
// makes a CSV, and a CSV's #shift steps an Enumerator: +22% on 2000 lines).
// So a thread whose fiber has ended does not end: it puts its inbox on the
// idle list and waits there, and the next fiber to start takes it. The first
// token a pooled thread receives names the fiber it is to run.
// ⚠ It registers itself BEFORE handing control over: after the hand-over the
// other side is running and this thread may not touch a shared map.
let fb_idle = map_new ();
let fb_idle_n = fn (u: unit) -> if map_has fb_st "idle" then map_get fb_st "idle" else 0;
let fb_run_body = fn (i0: int) -> fn inbox ->
  let rec serve = fn (u: unit) ->
    let i = channel_recv inbox in
    let body = map_get fb_bodies i in
    let _ = map_delete fb_bodies i in
    let t = body () in
    let _ = map_delete fb_inbox i in
    let n = fb_idle_n () in
    let _ = map_set fb_idle n inbox in
    let _ = map_set fb_st "idle" (n + 1) in
    let _ = fb_hand_over t in
    serve () in
  serve ();
let fb_start_thread = fn (i: int) -> fn inbox ->
  let n = fb_idle_n () in
  if n > 0
  then (let c = map_get fb_idle (n - 1) in
        let _ = map_delete fb_idle (n - 1) in
        let _ = map_set fb_st "idle" (n - 1) in
        map_set fb_inbox i c)
  else detach (spawn (fn () -> fb_run_body i inbox));
