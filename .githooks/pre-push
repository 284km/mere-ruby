#!/bin/sh
# Refuse a push whose records are not clean.
#
# WHY THIS EXISTS. On 2026-09-04 a session token was pushed to this public
# repository inside mspec/DIFF_LINES.txt and mspec/tags/core_env.txt. The
# push-time check that was run by hand looked for the PREVIOUS incident's
# shapes -- home paths, the tmpdir -- and not for an environment dump; and
# mspec/record_hygiene.sh reported "records clean" while testing a LIST of
# variable names that did not include the one that leaked.
#
# So the lesson is not "check more names". It is that a check nobody is
# required to run is a check that gets skipped on the day it matters. This
# makes it required.
#
# Install (it is not automatic -- git does not share hooks):
#     git config core.hooksPath .githooks
set -e
root="$(git rev-parse --show-toplevel)"
if [ -x "$root/mspec/record_hygiene.sh" ]; then
  if ! "$root/mspec/record_hygiene.sh" >/dev/null 2>&1; then
    echo "pre-push REFUSED: the checked-in records are not clean." >&2
    "$root/mspec/record_hygiene.sh" >&2 || true
    echo >&2
    echo "These files go to a PUBLIC repository. Fix them, or re-run the" >&2
    echo "generator that produces them, before pushing." >&2
    exit 1
  fi
fi
