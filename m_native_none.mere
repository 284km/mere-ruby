let mr_typed_class_index = fn (a0: str) -> 0;
let mr_typed_method_name = fn (a0: int) -> "";
let mr_typed_method_info = fn (a0: int) -> fn (a1: int) -> 0;
let mr_typed_loader_stat = fn (a0: int) -> 0;
let mr_typed_number = fn (a0: unit) -> 0.0;
let mr_typed_set_number = fn (a0: float) -> 0;
let mr_probe_load = fn (a0: str) -> 0 - 1;
