// No C side: what m_native_api.mere declares, as functions that do nothing.
// A build with no native extensions (the Wasm source tree) has this file in
// that one's place. Every "is there a library" question answers no -- a
// load is -1, a probe 0 -- so no call into C is ever attempted; the rest are
// here for the names.
type native_request = { op: int, recv: int, mid: int, argc: int, a0: int, a1: int };
