let mr_native_load = fn (a0: str) -> 0 - 1;
let mr_native_error = fn (a0: unit) -> "";
let mr_native_find = fn (a0: str) -> 0 - 1;
let mr_native_arity = fn (a0: int) -> 0;
let mr_native_method_name = fn (a0: int) -> "";
let mr_native_resources = fn (a0: unit) -> 0;
let mr_native_depth = fn (a0: unit) -> 0;
let mr_native_ensures = fn (a0: unit) -> 0;
