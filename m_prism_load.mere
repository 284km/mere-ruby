// Prism's node tree, built here from the parser's serialized answer.
//
// `Prism.parse` under mere-ruby is libprism's serialized bytes read back into
// Prism::Node objects (lib/prism_ext.rb). The reading was Prism's own
// generated Ruby -- Serialize::Loader#load_node, a `case` of 151 arms with a
// method call per field -- and run by this interpreter it took 230 µs a
// node: 234 s for ruby's 850 test files, which RubyVM::AbstractSyntaxTree's
// tests read twice. This file is the same reading in Mere: one pass over the
// bytes, each node made as `new` would have made it -- an object of the
// node's class with the instance variables its `initialize` assigns, in that
// order -- without running a line of Ruby.
//
// What a node is made of comes from Prism's config.yml (m_prism_schema.mere,
// generated by tools/gen_prism_schema.rb), not from this file: a new Prism
// regenerates the table. The serialized format is the one
// vendor/prism/src/serialize.c writes and lib/prism/serialize.rb reads:
//
//   node     = type:u8  node_id:varuint  location  [length:u32le]  flags:varuint  fields
//   location = start:varuint  length:varuint       -> the Integer (start << 32 | length)
//                                                     Node#location turns into a Location
//   string   = 1 start:varuint length:varuint      (a slice of the source)
//            | 2 length:varuint bytes              (owned by the serialization)
//   constant = index:varuint, 1-based into the constant pool (0: none);
//              a pool entry is start:u32le length:u32le at cpool_base, the
//              start's top bit saying the bytes are the serialization's own
//   integer  = negative:u8 words:varuint word:varuint...   (32 bits a word, least first)
//   double   = 8 bytes, little-endian
//
// Only the unfrozen tree is built here; `freeze: true` (every Location made
// at once, everything frozen) stays with the Ruby loader.
// (the table -- prism_sch, prism_sch_f, prism_sch_k -- is m_prism_dec.mere's)

// The node at `start` of the serialized bytes `b`, and where it ends.
//   srcv   the Prism::Source every node holds
//   input  the program's bytes (a string of kind 1 and a pool entry are
//          slices of it)
//   cbase  where the constant pool is in `b`
//   enc    the program's encoding, which every String of the tree carries
//   symof  the Symbol a constant's bytes name, in that encoding
// Returns the node and the position after it. Answers (VNil, -1) for a type
// number the table does not have, which a serialization of another Prism
// would produce.
let prism_load_node = fn (b: bytes) -> fn (start: int) -> fn (srcv: Val) -> fn (input: str) -> fn (cbase: int) -> fn (enc: str) -> fn symof ->
  let _ = prism_sch_init () in
  let ntypes = vec_len prism_sch / 3 in
  region PLD {
    // (0: the read position; 1: nodes made; 2: 1 once a type was unknown)
    let st = vec_new () in
    let _ = vec_push st start in
    let _ = vec_push st 0 in
    let _ = vec_push st 0 in
    let pool = map_new () in
    let byte = fn (u: unit) -> (let p = vec_get st 0 in let _ = vec_set st 0 (p + 1) in bytes_get b p) in
    let rec varu_more = fn (n: int) -> fn (shift: int) ->
      (let c = byte () in
       if c >= 128 then varu_more (n + bit_shl (c - 128) shift) (shift + 7)
       else n + bit_shl c shift) in
    let varu = fn (u: unit) -> (let n = byte () in if n < 128 then n else varu_more (n - 128) 7) in
    let u32 = fn (p: int) ->
      bytes_get b p + bytes_get b (p + 1) * 256 + bytes_get b (p + 2) * 65536 + bytes_get b (p + 3) * 16777216 in
    let loc = fn (u: unit) -> (let s = varu () in let l = varu () in VInt (bit_shl s 32 + l)) in
    let cst = fn (ix: int) ->
      if map_has pool ix then map_get pool ix
      else
        (let off = cbase + ix * 8 in
         let s0 = u32 off in
         let ln = u32 (off + 4) in
         let s = (if s0 >= 2147483648 then str_of_bytes (bytes_slice b (s0 - 2147483648) ln)
                  else substring input s0 (s0 + ln)) in
         let v = symof s in
         let _ = map_set pool ix v in
         v) in
    let lstr = fn (u: unit) ->
      (let t = byte () in
       let s = (if t == 1 then (let s0 = varu () in let ln = varu () in substring input s0 (s0 + ln))
                else (let ln = varu () in
                      let p = vec_get st 0 in
                      let _ = vec_set st 0 (p + ln) in
                      str_of_bytes (bytes_slice b p ln))) in
       let v = mkstr_e s enc in
       let _ = (match v with VStr h -> sfrozen_set h | _ -> ()) in
       v) in
    let lint = fn (u: unit) ->
      (let neg = byte () != 0 in
       let n = varu () in
       // (the words, most significant first)
       let rec words = fn (i: int) -> fn (acc: int list) ->
         if i >= n then acc else (let w = varu () in words (i + 1) (Cons (w, acc))) in
       match words 0 Nil with
       | Nil -> VInt 0
       | Cons (w, Nil) -> VInt (if neg then 0 - w else w)
       | Cons (hi, Cons (lo, Nil)) when hi < 2147483648 ->
         (let v = hi * 4294967296 + lo in VInt (if neg then 0 - v else v))
       | ws ->
         (let rec dec = fn (xs: int list) -> fn (acc: str) ->
            (match xs with
             | Nil -> acc
             | Cons (w, t) -> dec t (big_add_s (big_mul_s acc "4294967296") (str_of_int w))) in
          let d = dec ws "0" in
          norm_big (if neg then "-" ++ d else d))) in
    let ldbl = fn (u: unit) ->
      (let p = vec_get st 0 in
       let _ = vec_set st 0 (p + 8) in
       VFlt (float_of_bits (u32 (p + 4)) (u32 p))) in
    let rec node = fn (u: unit) ->
      (let ty = byte () in
       if ty <= 0 || ty >= ntypes then (let _ = vec_set st 2 1 in VNil)
       else
         (let nid = varu () in
          let l0 = loc () in
          let _ = (if str_eq (vec_get prism_sch (ty * 3 + 2)) "!" then vec_set st 0 (vec_get st 0 + 4) else ()) in
          let flags = varu () in
          let id = alloc_oid obj_cls in
          let _ = map_set obj_cls id (vec_get prism_sch (ty * 3)) in
          let _ = vec_set st 1 (vec_get st 1 + 1) in
          let sid = str_of_int id ++ "@" in
          // (the object is new: its shape is its type's, and its values are
          //  written into its slots in the order of the names -- source,
          //  node_id, location, flags, then the fields. In the table, its
          //  index entry is filed once, whole: iv_new_obj answers -1)
          let ab = iv_new_obj id (vec_get prism_sch (ty * 3 + 1)) in
          let put = fn (j: int) -> fn (nm: str) -> fn (v: Val) ->
            (if ab >= 0 then vec_set iv_slab (ab + j) v else iv_put_new ivars_g (sid ++ nm) v) in
          let _ = (if ab >= 0 then () else iv_file_new sid (vec_get prism_sch (ty * 3 + 1))) in
          let _ = put 0 "source" srcv in
          let _ = put 1 "node_id" (VInt nid) in
          let _ = put 2 "location" l0 in
          let _ = put 3 "flags" (VInt flags) in
          let base = ty * 16 in
          let rec fields = fn (j: int) ->
            (let k = vec_get prism_sch_k (base + j) in
             if k == 0 then ()
             else
               (let v =
                  // n node, N node?, L node[]
                  (if k == 110 then node ()
                   else if k == 78 then opt_node ()
                   else if k == 76 then (let n = varu () in arr_new (nodes n))
                   // l location, o location?
                   else if k == 108 then loc ()
                   else if k == 111 then (if byte () == 0 then VNil else loc ())
                   // c constant, C constant?, K constant[]
                   else if k == 99 then cst (varu () - 1)
                   else if k == 67 then (let ix = varu () in if ix == 0 then VNil else cst (ix - 1))
                   else if k == 75 then (let n = varu () in arr_new (consts n))
                   // s string, u uint32, b uint8, i integer, d double
                   else if k == 115 then lstr ()
                   else if k == 117 then VInt (varu ())
                   else if k == 98 then VInt (byte ())
                   else if k == 105 then lint ()
                   else ldbl ()) in
                let _ = put (4 + j) (vec_get prism_sch_f (base + j)) v in
                fields (j + 1))) in
          let _ = fields 0 in
          VObj id))
    and opt_node = fn (u: unit) ->
      if bytes_get b (vec_get st 0) == 0 then (let _ = vec_set st 0 (vec_get st 0 + 1) in VNil) else node ()
    and nodes = fn (n: int) ->
      if n <= 0 then (Nil : Val list) else (let x = node () in Cons (x, nodes (n - 1)))
    and consts = fn (n: int) ->
      if n <= 0 then (Nil : Val list) else (let x = cst (varu () - 1) in Cons (x, consts (n - 1))) in
    let root = node () in
    // (counted toward the next collection: the objects and their instance
    //  variables are made outside the evaluator's own counting, and a file's
    //  tree is dead as soon as its test is over)
    let _ = vec_set qv_ctr 3 (vec_get qv_ctr 3 + vec_get st 1 * 512) in
    if vec_get st 2 == 1 then (VNil, 0 - 1) else (root, vec_get st 0)
  };

// A count and that many varuints, as the Integers they are: the line
// offsets (Loader#load_line_offsets -- a block call a line in Ruby, 270,000
// lines in ruby's test files). Returns the list and the position after it.
let prism_load_varuints = fn (b: bytes) -> fn (start: int) ->
  region PLV {
    let st = vec_new () in
    let _ = vec_push st start in
    let byte = fn (u: unit) -> (let p = vec_get st 0 in let _ = vec_set st 0 (p + 1) in bytes_get b p) in
    let rec varu_more = fn (n: int) -> fn (shift: int) ->
      (let c = byte () in
       if c >= 128 then varu_more (n + bit_shl (c - 128) shift) (shift + 7)
       else n + bit_shl c shift) in
    let varu = fn (u: unit) -> (let n = byte () in if n < 128 then n else varu_more (n - 128) 7) in
    let n = varu () in
    let rec go = fn (i: int) ->
      if i >= n then (Nil : Val list) else (let x = varu () in Cons (VInt x, go (i + 1))) in
    let xs = go 0 in
    (xs, vec_get st 0)
  };

// Where the constant pool ends: `size` entries of 8 bytes at `start`, then
// the bytes of the entries the serialization owns (the start's top bit) --
// what Loader#load_constant_pool walks to reach the end of the bytes.
let prism_cpool_end = fn (b: bytes) -> fn (start: int) -> fn (size: int) ->
  let rec go = fn (i: int) -> fn (trailer: int) ->
    if i >= size then start + size * 8 + trailer
    else
      (let p = start + i * 8 in
       go (i + 1) (if bytes_get b (p + 3) >= 128
                   then trailer + bytes_get b (p + 4) + bytes_get b (p + 5) * 256 + bytes_get b (p + 6) * 65536 + bytes_get b (p + 7) * 16777216
                   else trailer)) in
  go 0 0;
