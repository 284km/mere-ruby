*.c
*.o
*.err
mere-ruby

# session scratch (test fixtures written by bt/spec runs)
zzz*.rb
zzz_*.rb
require-lock-test.rb
/a/
/b/
mr.c
docs/.smoke.*.out
docs/mere-ruby.wat

# ... but NOT mspec/tags/, which SPEC_STATUS.md points at as the per-file record.
# A global ctags rule (`tags`) matches any directory of that name, so the lists
# the doc promised were never in a clone -- the sweep wrote them, git ignored
# them, and nobody reading the repo could see which spec files DIFF or CRASH.
!mspec/tags/
mere-ruby.e
mere-ruby.next
mere-ruby.*

# a sweep in progress writes SPEC_STATUS.md.<pid> and moves it into place
SPEC_STATUS.md.*

# packaging/rbenv/package.sh output (tarball + generated definition)
/dist/

# the guard's kill log is a per-run artifact, not a record
mspec/rss_kills.log

# the sweep's own working tree. run_spec.sh clones core/language/library/shared
# /fixtures next to the repo to install the shim as spec_helper.rb, and a killed
# run leaves it behind -- thousands of files, some of them BINARY fixtures and
# some with non-ASCII names. It is not ignored anywhere else, so one `git add -A`
# would have put ruby/spec's fixtures into this public repo; mine tried to.
/rubyspec_temp/
/Users/

# tools/build.sh records which -O level made the binary; the sweep reads it
.build_mode

# a fired-bound trace is a per-run artifact, not a record
mspec/bound_events.log
