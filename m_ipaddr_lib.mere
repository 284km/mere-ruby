  "    end\n" ++
  "    clone = self.clone.set(@addr | 0xffff00000000, Socket::AF_INET6)\n" ++
  "    clone.instance_variable_set(:@mask_addr, @mask_addr | 0xffffffffffffffffffffffff00000000)\n" ++
  "    clone\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns a new ipaddr built by converting the native IPv4 address\n" ++
