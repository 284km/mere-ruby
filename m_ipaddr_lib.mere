  "\n" ++
  "  # Creates a Range object for the network address.\n" ++
  "  def to_range\n" ++
  "    self.class.new(begin_addr, @family)..self.class.new(end_addr, @family)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the prefix length in bits for the ipaddr.\n" ++
  "  def prefix\n" ++
  "    case @family\n" ++
