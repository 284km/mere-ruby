  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns a string containing a human-readable representation of the\n" ++
  "  # ipaddr. (\"#<IPAddr: family:address/mask>\")\n" ++
  "  def inspect\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      af = \"IPv4\"\n" ++
  "    when Socket::AF_INET6\n" ++
  "      af = \"IPv6\"\n" ++
  "      zone_id = @zone_id.to_s\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "    return sprintf(\"#<%s: %s:%s%s/%s>\", self.class.name,\n" ++
  "                   af, _to_string(@addr), zone_id, _to_string(@mask_addr))\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the netmask in string format e.g. 255.255.0.0\n" ++
  "  def netmask\n" ++
  "    _to_string(@mask_addr)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the wildcard mask in string format e.g. 0.0.255.255\n" ++
  "  def wildcard_mask\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      mask = IN4MASK ^ @mask_addr\n" ++
  "    when Socket::AF_INET6\n" ++
  "      mask = IN6MASK ^ @mask_addr\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "\n" ++
  "    _to_string(mask)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the IPv6 zone identifier, if present.\n" ++
  "  # Raises InvalidAddressError if not an IPv6 address.\n" ++
  "  def zone_id\n" ++
  "    if @family == Socket::AF_INET6\n" ++
  "      @zone_id\n" ++
  "    else\n" ++
  "      raise InvalidAddressError, \"not an IPv6 address\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns the IPv6 zone identifier, if present.\n" ++
  "  # Raises InvalidAddressError if not an IPv6 address.\n" ++
  "  def zone_id=(zid)\n" ++
  "    if @family == Socket::AF_INET6\n" ++
  "      case zid\n" ++
  "      when nil, /\\A%(\\w+)\\z/\n" ++
  "        @zone_id = zid\n" ++
  "      else\n" ++
  "        raise InvalidAddressError, \"invalid zone identifier for address\"\n" ++
  "      end\n" ++
  "    else\n" ++
  "      raise InvalidAddressError, \"not an IPv6 address\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  protected\n" ++
  "  # :stopdoc:\n" ++
  "\n" ++
  "  def begin_addr\n" ++
  "    @addr & @mask_addr\n" ++
  "  end\n" ++
  "\n" ++
  "  def end_addr\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      @addr | (IN4MASK ^ @mask_addr)\n" ++
  "    when Socket::AF_INET6\n" ++
  "      @addr | (IN6MASK ^ @mask_addr)\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "  #:startdoc:\n" ++
  "\n" ++
  "  # Set +@addr+, the internal stored ip address, to given +addr+. The\n" ++
  "  # parameter +addr+ is validated using the first +family+ member,\n" ++
  "  # which is +Socket::AF_INET+ or +Socket::AF_INET6+.\n" ++
  "  def set(addr, *family)\n" ++
  "    case family[0] ? family[0] : @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      if addr < 0 || addr > IN4MASK\n" ++
  "        raise InvalidAddressError, \"invalid address: #\{addr\}\"\n" ++
  "      end\n" ++
  "    when Socket::AF_INET6\n" ++
  "      if addr < 0 || addr > IN6MASK\n" ++
  "        raise InvalidAddressError, \"invalid address: #\{addr\}\"\n" ++
  "      end\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "    @addr = addr\n" ++
  "    if family[0]\n" ++
  "      @family = family[0]\n" ++
  "      if @family == Socket::AF_INET\n" ++
  "        @mask_addr &= IN4MASK\n" ++
  "      end\n" ++
  "    end\n" ++
  "    return self\n" ++
  "  end\n" ++
  "\n" ++
  "  # Set current netmask to given mask.\n" ++
  "  def mask!(mask)\n" ++
  "    case mask\n" ++
  "    when String\n" ++
  "      case mask\n" ++
  "      when /\\A(0|[1-9]+\\d*)\\z/\n" ++
  "        prefixlen = mask.to_i\n" ++
  "      when /\\A\\d+\\z/\n" ++
  "        raise InvalidPrefixError, \"leading zeros in prefix\"\n" ++
  "      else\n" ++
  "        m = IPAddr.new(mask)\n" ++
  "        if m.family != @family\n" ++
  "          raise InvalidPrefixError, \"address family is not same\"\n" ++
  "        end\n" ++
  "        @mask_addr = m.to_i\n" ++
  "        n = @mask_addr ^ m.instance_variable_get(:@mask_addr)\n" ++
  "        unless ((n + 1) & n).zero?\n" ++
  "          raise InvalidPrefixError, \"invalid mask #\{mask\}\"\n" ++
  "        end\n" ++
  "        @addr &= @mask_addr\n" ++
  "        return self\n" ++
  "      end\n" ++
  "    else\n" ++
  "      prefixlen = mask\n" ++
  "    end\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      if prefixlen < 0 || prefixlen > 32\n" ++
  "        raise InvalidPrefixError, \"invalid length\"\n" ++
  "      end\n" ++
  "      masklen = 32 - prefixlen\n" ++
  "      @mask_addr = ((IN4MASK >> masklen) << masklen)\n" ++
  "    when Socket::AF_INET6\n" ++
  "      if prefixlen < 0 || prefixlen > 128\n" ++
  "        raise InvalidPrefixError, \"invalid length\"\n" ++
  "      end\n" ++
  "      masklen = 128 - prefixlen\n" ++
  "      @mask_addr = ((IN6MASK >> masklen) << masklen)\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "    @addr = ((@addr >> masklen) << masklen)\n" ++
  "    return self\n" ++
  "  end\n" ++
  "\n" ++
  "  private\n" ++
  "\n" ++
  "  # Creates a new ipaddr object either from a human readable IP\n" ++
  "  # address representation in string, or from a packed in_addr value\n" ++
  "  # followed by an address family.\n" ++
  "  #\n" ++
  "  # In the former case, the following are the valid formats that will\n" ++
  "  # be recognized: \"address\", \"address/prefixlen\" and \"address/mask\",\n" ++
  "  # where IPv6 address may be enclosed in square brackets (`[' and\n" ++
  "  # `]').  If a prefixlen or a mask is specified, it returns a masked\n" ++
  "  # IP address.  Although the address family is determined\n" ++
  "  # automatically from a specified string, you can specify one\n" ++
  "  # explicitly by the optional second argument.\n" ++
  "  #\n" ++
  "  # Otherwise an IP address is generated from a packed in_addr value\n" ++
  "  # and an address family.\n" ++
  "  #\n" ++
  "  # The IPAddr class defines many methods and operators, and some of\n" ++
  "  # those, such as &, |, include? and ==, accept a string, or a packed\n" ++
  "  # in_addr value instead of an IPAddr object.\n" ++
  "  def initialize(addr = '::', family = Socket::AF_UNSPEC)\n" ++
  "    @mask_addr = nil\n" ++
  "    if !addr.kind_of?(String)\n" ++
  "      case family\n" ++
  "      when Socket::AF_INET, Socket::AF_INET6\n" ++
  "        set(addr.to_i, family)\n" ++
  "        @mask_addr = (family == Socket::AF_INET) ? IN4MASK : IN6MASK\n" ++
  "        return\n" ++
  "      when Socket::AF_UNSPEC\n" ++
  "        raise AddressFamilyError, \"address family must be specified\"\n" ++
  "      else\n" ++
  "        raise AddressFamilyError, \"unsupported address family: #\{family\}\"\n" ++
  "      end\n" ++
  "    end\n" ++
  "    prefix, prefixlen = addr.split('/', 2)\n" ++
  "    if prefix =~ /\\A\\[(.*)\\]\\z/i\n" ++
  "      prefix = $1\n" ++
  "      family = Socket::AF_INET6\n" ++
  "    end\n" ++
  "    if prefix =~ /\\A(.*)(%\\w+)\\z/\n" ++
  "      prefix = $1\n" ++
  "      zone_id = $2\n" ++
  "      family = Socket::AF_INET6\n" ++
  "    end\n" ++
  "    # It seems AI_NUMERICHOST doesn't do the job.\n" ++
  "    #Socket.getaddrinfo(left, nil, Socket::AF_INET6, Socket::SOCK_STREAM, nil,\n" ++
  "    #                  Socket::AI_NUMERICHOST)\n" ++
  "    @addr = @family = nil\n" ++
  "    if family == Socket::AF_UNSPEC || family == Socket::AF_INET\n" ++
  "      @addr = in_addr(prefix)\n" ++
  "      if @addr\n" ++
  "        @family = Socket::AF_INET\n" ++
  "      end\n" ++
  "    end\n" ++
  "    if !@addr && (family == Socket::AF_UNSPEC || family == Socket::AF_INET6)\n" ++
  "      @addr = in6_addr(prefix)\n" ++
  "      @family = Socket::AF_INET6\n" ++
  "    end\n" ++
  "    @zone_id = zone_id\n" ++
  "    if family != Socket::AF_UNSPEC && @family != family\n" ++
  "      raise AddressFamilyError, \"address family mismatch\"\n" ++
  "    end\n" ++
  "    if prefixlen\n" ++
  "      mask!(prefixlen)\n" ++
  "    else\n" ++
  "      @mask_addr = (@family == Socket::AF_INET) ? IN4MASK : IN6MASK\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  # :stopdoc:\n" ++
  "  def coerce_other(other)\n" ++
  "    case other\n" ++
  "    when IPAddr\n" ++
  "      other\n" ++
  "    when String\n" ++
  "      self.class.new(other)\n" ++
  "    else\n" ++
  "      self.class.new(other, @family)\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def in_addr(addr)\n" ++
  "    case addr\n" ++
  "    when Array\n" ++
  "      octets = addr\n" ++
  "    else\n" ++
  "      RE_IPV4ADDRLIKE.match?(addr) or return nil\n" ++
  "      octets = addr.split('.')\n" ++
  "    end\n" ++
  "    octets.inject(0) \{ |i, s|\n" ++
  "      (n = s.to_i) < 256 or raise InvalidAddressError, \"invalid address: #\{addr\}\"\n" ++
  "      (s != '0') && s.start_with?('0') and raise InvalidAddressError, \"zero-filled number in IPv4 address is ambiguous: #\{addr\}\"\n" ++
  "      i << 8 | n\n" ++
  "    \}\n" ++
  "  end\n" ++
  "\n" ++
  "  def in6_addr(left)\n" ++
  "    case left\n" ++
  "    when RE_IPV6ADDRLIKE_FULL\n" ++
  "      if $2\n" ++
  "        addr = in_addr($~[2,4])\n" ++
  "        left = $1 + ':'\n" ++
  "      else\n" ++
  "        addr = 0\n" ++
  "      end\n" ++
  "      right = ''\n" ++
  "    when RE_IPV6ADDRLIKE_COMPRESSED\n" ++
  "      if $4\n" ++
  "        left.count(':') <= 6 or raise InvalidAddressError, \"invalid address: #\{@addr\}\"\n" ++
  "        addr = in_addr($~[4,4])\n" ++
  "        left = $1\n" ++
  "        right = $3 + '0:0'\n" ++
  "      else\n" ++
  "        left.count(':') <= ($1.empty? || $2.empty? ? 8 : 7) or\n" ++
  "          raise InvalidAddressError, \"invalid address: #\{@addr\}\"\n" ++
  "        left = $1\n" ++
  "        right = $2\n" ++
  "        addr = 0\n" ++
  "      end\n" ++
  "    else\n" ++
  "      raise InvalidAddressError, \"invalid address: #\{@addr\}\"\n" ++
  "    end\n" ++
  "    l = left.split(':')\n" ++
  "    r = right.split(':')\n" ++
  "    rest = 8 - l.size - r.size\n" ++
  "    if rest < 0\n" ++
  "      return nil\n" ++
  "    end\n" ++
  "    (l + Array.new(rest, '0') + r).inject(0) \{ |i, s|\n" ++
  "      i << 16 | s.hex\n" ++
  "    \} | addr\n" ++
  "  end\n" ++
  "\n" ++
  "  def addr_mask(addr)\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      return addr & IN4MASK\n" ++
  "    when Socket::AF_INET6\n" ++
  "      return addr & IN6MASK\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def _reverse\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      return (0..3).map \{ |i|\n" ++
  "        (@addr >> (8 * i)) & 0xff\n" ++
  "      \}.join('.')\n" ++
  "    when Socket::AF_INET6\n" ++
  "      return (\"%.32x\" % @addr).reverse!.gsub!(/.(?!$)/, '\\&.')\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "  def _to_string(addr)\n" ++
  "    case @family\n" ++
  "    when Socket::AF_INET\n" ++
  "      return (0..3).map \{ |i|\n" ++
  "        (addr >> (24 - 8 * i)) & 0xff\n" ++
  "      \}.join('.')\n" ++
  "    when Socket::AF_INET6\n" ++
  "      return ((\"%.32x\" % addr).gsub!(/.\{4\}(?!$)/, '\\&:'))\n" ++
  "    else\n" ++
  "      raise AddressFamilyError, \"unsupported address family\"\n" ++
  "    end\n" ++
  "  end\n" ++
  "\n" ++
  "end\n" ++
  "\n" ++
  "unless Socket.const_defined? :AF_INET6\n" ++
  "  class Socket < BasicSocket\n" ++
  "    # IPv6 protocol family\n" ++
  "    AF_INET6 = Object.new.freeze\n" ++
  "  end\n" ++
  "\n" ++
  "  class << IPSocket\n" ++
  "    private\n" ++
  "\n" ++
  "    def valid_v6?(addr) # :nodoc:\n" ++
  "      case addr\n" ++
  "      when IPAddr::RE_IPV6ADDRLIKE_FULL\n" ++
  "        if $2\n" ++
  "          $~[2,4].all? \{|i| i.to_i < 256 \}\n" ++
  "        else\n" ++
  "          true\n" ++
  "        end\n" ++
  "      when IPAddr::RE_IPV6ADDRLIKE_COMPRESSED\n" ++
  "        if $4\n" ++
  "          addr.count(':') <= 6 && $~[4,4].all? \{|i| i.to_i < 256\}\n" ++
  "        else\n" ++
  "          addr.count(':') <= 7\n" ++
  "        end\n" ++
  "      else\n" ++
  "        false\n" ++
  "      end\n" ++
  "    end\n" ++
  "\n" ++
  "    alias getaddress_orig getaddress\n" ++
  "\n" ++
  "    public\n" ++
  "\n" ++
  "    # Returns a +String+ based representation of a valid DNS hostname,\n" ++
  "    # IPv4 or IPv6 address.\n" ++
  "    #\n" ++
  "    #   IPSocket.getaddress 'localhost'         #=> \"::1\"\n" ++
  "    #   IPSocket.getaddress 'broadcasthost'     #=> \"255.255.255.255\"\n" ++
  "    #   IPSocket.getaddress 'www.ruby-lang.org' #=> \"221.186.184.68\"\n" ++
  "    #   IPSocket.getaddress 'www.ccc.de'        #=> \"2a00:1328:e102:ccc0::122\"\n" ++
  "    def getaddress(s)\n" ++
  "      if valid_v6?(s)\n" ++
  "        s\n" ++
  "      else\n" ++
  "        getaddress_orig(s)\n" ++
  "      end\n" ++
  "    end\n" ++
  "  end\n" ++
  "end\n";
