  "  def |(other)\n" ++
  "    return self.clone.set(@addr | coerce_other(other).to_i)\n" ++
  "  end\n" ++
  "\n" ++
  "  # Returns a new ipaddr built by bitwise right-shift.\n" ++
  "  def >>(num)\n" ++
