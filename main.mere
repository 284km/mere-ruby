// asks `obj == x`, which a structural comparison never does. The value-level
// rb_eq cannot reach a user method, so this walk is world-aware.
// the VALUES of a pair list (every second entry)

and hash_key_of_w = fn env -> fn world -> fn (xs: Val list) -> fn (v: Val) ->
