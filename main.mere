                      | Nil -> acc
                      | Cons (VHsh hid, t) ->
                        last_hash t (match hash_lookup (hderef hid) (VSym "chomp") with
                                     | (true, cv) -> truthy cv
                                     | _ -> acc)
                      | Cons (_, t) -> last_hash t acc) in
                   last_hash args false) in
       let sepv = (match args with
                   | Cons (VStr sp, _) -> VStr sp
                   | Cons (VNil, _) -> VNil
                   | _ -> (if map_has globals "/" then map_get globals "/" else mkstr "\n")) in
       let ls = (match sepv with
                 | VNil -> (if str_len s == 0 then (Nil : Val list) else Cons (mkstr s, Nil))
                 | VStr sph ->
                   let sep = sget sph in
                   (if str_eq sep "\n" then val_list_of_strs (str_lines_go s 0 0 (str_len s))
                    else val_list_of_strs (str_lines_sep s sep))
                 | _ -> val_list_of_strs (str_lines_go s 0 0 (str_len s))) in
       if copt then arr_new (val_strs_tag (val_map_chomp ls) se9) else arr_new (val_strs_tag ls se9)) | _ -> (let _ = map_set prim_missing "n" (mkstr "lines") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'lines'")) in fail "mere-ruby: undefined method 'lines'")))
  else if str_eq name "split" then
    (match recv with
     | VStr sh0 ->
       (let s = sget sh0 in
        // a receiver whose bytes are invalid in its encoding cannot be
        // searched: ruby refuses before looking at the pattern.
        let e0 = enc_canon_name (senc_get sh0) in
        let _ = (if str_eq e0 "UTF-8" && (if enc_valid_utf8 s then false else true)
                 then (let _ = prim_raise "ArgumentError" "invalid byte sequence in UTF-8" in ()) else ()) in
        // no pattern (or an explicit nil) means $; -- and $; unset means
        // awk-mode whitespace splitting.
        let pat0 = (match args with
                    | Cons (VNil, _) -> (if map_has globals ";" then map_get globals ";" else VNil)
                    | Cons (p, _) -> p
                    | Nil -> (if map_has globals ";" then map_get globals ";" else VNil)) in
        // the limit is an int in C too: ruby refuses a bignum with its own
        // RangeError, and a non-Integer (after #to_int upstream) by type.
        let lim = (match args with
                   | Cons (_, Cons (VInt l, _)) ->
                     (if l > 2147483647 then
                        prim_raise "RangeError" ("integer " ++ str_of_int l ++ " too big to convert to 'int'")
                      else VInt l)
                   | Cons (_, Cons (VBig b, _)) ->
                     prim_raise "RangeError" ("integer " ++ b ++ " too big to convert to 'int'")
                   | Cons (_, Cons (VNil, _)) ->
                     prim_raise "TypeError" "no implicit conversion from nil into Integer"
                   | Cons (_, Cons (other, _)) ->
                     prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
                   | _ -> VInt 0) in
        let lim = (match lim with VInt l -> l | _ -> 0) in
        // every piece carries the receiver's encoding.
        let tag1 = fn (v: Val) -> (match v with VStr id -> (let _ = senc_set id (senc_get sh0) in v) | _ -> v) in
        let rec tag_all = fn (xs: Val list) ->
          (match xs with Nil -> (Nil : Val list) | Cons (hh, tt) -> Cons (tag1 hh, tag_all tt)) in
        // the pattern's TYPE and its byte validity are checked before the
        // empty-receiver shortcut: "".split(broken_utf8) still raises.
        let _ = (match pat0 with
                 | VStr seph ->
                   (let pe = enc_canon_name (senc_get seph) in
                    if enc_valid (sget seph) pe then ()
                    else (let _ = prim_raise "ArgumentError" ("invalid byte sequence in " ++ pe) in ()))
                 | VRegex (_, _, _) -> ()
                 | VNil -> ()
                 | other -> (let _ = prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String") in ())) in
        // an awk-mode split with a NEGATIVE limit keeps one final empty field
        // for a trailing whitespace run (" a ".split(" ", -1) is ["a", ""]).
        let awk_neg = fn (u: int) ->
          (let base = awk_split s in
           if str_len s > 0 && is_ws_ch (char_at s (str_len s - 1))
           then rev_app (rev_app base Nil) (Cons ("", Nil)) else base) in
        // splitting the empty string is [] whatever the pattern; a limit of
        // one is [self] VERBATIM whatever the pattern (no awk stripping).
        if str_eq s "" then arr_new Nil
        else if lim == 1 then arr_new (Cons (tag1 (mkstr s), Nil))
        else
        match pat0 with
        | VRegex (pat, pf, _) -> arr_new (tag_all (rx_split_lim pat pf s lim))
        | VStr seph ->
          (let sep = sget seph in
           if str_eq sep " " then
             arr_new (tag_all (val_list_of_strs (if lim < 0 then awk_neg 0 else if lim == 0 then awk_split s else awk_split_lim s lim)))
           else if str_eq sep "" then
             // character mode. With a positive limit: limit-1 characters and
             // the rest verbatim -- ONE final "" when the limit overruns
             // (which a negative limit keeps too).
             (if lim == 0 then arr_new (tag_all (utf8_chars_val s 0))
              else if lim < 0 then arr_new (tag_all (rev_app (rev_app (utf8_chars_val s 0) Nil) (Cons (mkstr "", Nil))))
              else
                (let cn = utf8_len s in
                 if lim > cn then arr_new (tag_all (rev_app (rev_app (utf8_chars_val s 0) Nil) (Cons (mkstr "", Nil))))
                 else (let b = utf8_boff s (lim - 1) 0 in
                       arr_new (tag_all (rev_app (rev_app (utf8_chars_val (substring s 0 b) 0) Nil)
                                           (Cons (mkstr (substring s b (str_len s)), Nil)))))))
           else if lim == 0 then arr_new (tag_all (val_list_of_strs (strlist_trim_empty (str_split s sep))))
           else if lim < 0 then arr_new (tag_all (val_list_of_strs (str_split s sep)))
           else arr_new (tag_all (val_list_of_strs (split_with_limit s sep lim))))
        | VNil -> arr_new (tag_all (val_list_of_strs (if lim < 0 then awk_neg 0 else if lim == 0 then awk_split s else awk_split_lim s lim)))
        | _ -> arr_new Nil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "split") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'split'")) in fail "mere-ruby: undefined method 'split'")))
  else if str_eq name "include?" then
    (match recv with
     | VStr sh ->
       (match args with
        | Cons (VStr sub, _) -> (let _ = enc_pair_guard sh sub in VBool (str_contains (sget sh) (sget sub)))
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
     | VArr id -> (match args with Cons (v, _) -> VBool (val_contains (deref id) v) | _ -> VBool false)
     | VHsh hid -> let xs = hderef hid in (match args with Cons (k, _) -> VBool (hash_haskey_x (hcbi_on hid) xs k) | _ -> VBool false)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "include?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'include?'")) in fail "mere-ruby: undefined method 'include?'")))
  else if str_eq name "start_with?" then
    (match recv with VStr s -> let s = sget s in (match args with Cons (VStr p, _) -> let p = sget p in VBool (str_starts_with s p) | _ -> VBool false) | _ -> (let _ = map_set prim_missing "n" (mkstr "start_with?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'start_with?'")) in fail "mere-ruby: undefined method 'start_with?'")))
  else if str_eq name "end_with?" then
    (match recv with VStr s -> let s = sget s in (match args with Cons (VStr p, _) -> let p = sget p in VBool (str_ends_with s p) | _ -> VBool false) | _ -> (let _ = map_set prim_missing "n" (mkstr "end_with?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'end_with?'")) in fail "mere-ruby: undefined method 'end_with?'")))
