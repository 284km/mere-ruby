    // truncates, anything else refuses by type), the pad is a non-empty
    // String, and the result carries the RECEIVER-vs-PAD negotiated encoding
    // (incompatible pads are ruby's Encoding::CompatibilityError).
    (match recv with
     | VStr sh ->
       (let s = sget sh in
        let w = (match args with
                 | Cons (VInt w0, _) -> w0
                 | Cons (VFlt f, _) -> int_of_float f
                 | Cons (VNil, _) -> (match prim_raise "TypeError" "no implicit conversion from nil into Integer" with _ -> 0)
                 | Cons (other, _) -> (match prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer") with _ -> 0)
                 | Nil -> (match prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1..2)" with _ -> 0)) in
        let apply = fn (pad: str) ->
          (if str_eq name "ljust" then str_ljust s w pad
           else if str_eq name "rjust" then str_rjust s w pad
           else str_center s w pad) in
        match args with
        | Cons (_, Cons (VStr ph, _)) ->
          (let _ = enc_pair_guard sh ph in
           let renc = enc_pair_or sh ph in
           let pad = sget ph in
           if str_len pad == 0 then prim_raise "ArgumentError" "zero width padding"
           else
             let v = mkstr (apply pad) in
             (match v with VStr id -> (let _ = senc_set id renc in v) | _ -> v))
        | Cons (_, Cons (other, _)) ->
          prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | _ ->
          (let v = mkstr (apply " ") in
           (match v with VStr id -> (let _ = senc_set id (senc_get sh) in v) | _ -> v)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr name) in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: undefined method '" ++ name ++ "'"))) in fail "mere-ruby: undefined method")))
  else if str_eq name "partition" || str_eq name "rpartition" then
