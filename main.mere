  // ruby still calls it modifying K ("can't modify frozen Class: K"). An
  // object's singleton -- "(sng:<id>)" -- is not a class name and is answered
  // by the object check instead.
  let c = if is_sng_cls c0 then sng_inner c0 else c0 in
  if clsfrozen_get c
  then (let _ = raise_exc world "FrozenError"
          ("can't modify frozen " ++ (if map_has modules c then "Module" else "Class")
           ++ ": " ++ display_cls_msg world c) in ())
  else ()

