// `[e].intersect?([e2])` is true for keys that are eql? while `e == e2` is
// false. The value-level helpers cannot ask an object anything, so the rule
// lives here once and every door uses it.
// does any element carry its own #hash or #eql?? (the set operations only
// need the protocol then, and asking is much cheaper than running it)
and elem_has_user_eql = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (h9, t9) ->
    (match h9 with
     | VObj _ -> has_meth world (dispatch_cls_of world h9) "eql?"
                 || has_meth world (dispatch_cls_of world h9) "hash"
     | _ -> false)
    || elem_has_user_eql world t9

// ⚠ NOT `val_member_w` -- that name is already taken, by the `==` version.
// Defining a second one under it silently resolved every call to the OTHER
// function, and the set operations went on comparing with `==` while the
// build stayed green.
and val_member_eqlw = fn env -> fn world -> fn (ys: Val list) -> fn (x: Val) ->
  match ys with
  | Nil -> false
  | Cons (h9, t9) -> if rb_eql_w env world h9 x then true else val_member_eqlw env world t9 x

and val_intersect_w = fn env -> fn world -> fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (Nil : Val list)
  | Cons (h9, t9) ->
