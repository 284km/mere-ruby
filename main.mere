                        | VObj oid8 ->
                          // an Enumerator already IS the walk, so it is asked
                          // for its first n directly; anything else with #each
                          // becomes an Enumerator first. `first` stops pulling
                          // when it has enough, which is what makes an
                          // INFINITE enumerator answerable.
                          (let (mw8, sw8, ow8, iw8) = world in
                           let cls8 = map_get ow8 oid8 in
                           if exc_is_a world cls8 "Enumerator" then
                             invoke_val_c env world noblk a "first" (Cons (VInt n0, Nil)) false
                           else if responds world a "each" then
                             (let en = invoke_val_c env world noblk a "to_enum" (Cons (VSym "each", Nil)) false in
                              invoke_val_c env world noblk en "first" (Cons (VInt n0, Nil)) false)
                           else raise_exc world "TypeError"
                                  ("wrong argument type " ++ class_name a ++ " (must respond to :each)"))
                        | other -> raise_exc world "TypeError"
                                     ("wrong argument type " ++ class_name other ++ " (must respond to :each)")) in
              Cons (a2, conv t))) in
        prim_method recv "zip" (conv args))
     | _ -> VNil)
  else
  // Array#transpose asks each ROW for #to_ary, which prim_method cannot do.
  if str_eq name "transpose" && (match recv with VArr _ -> true | _ -> false)
     && (if prim_user_has world recv "transpose" then false else true) then
    (match recv with
     | VArr id0 ->
       (let rec conv = fn (xs: Val list) ->
          (match xs with
           | Nil -> (Nil : Val list)
           | Cons (h, t) ->
             (let h2 = (match h with
                        | VObj _ ->
                          (if responds world h "to_ary"
                           then invoke_val_c env world noblk h "to_ary" Nil false else h)
                        | _ -> h) in
              Cons (h2, conv t))) in
        prim_method (arr_new (conv (deref id0))) "transpose" (Nil : Val list))
     | _ -> VNil)
  else
  if str_eq name "*" && (match recv with VArr _ -> true | _ -> false)
     && (if prim_user_has world recv "*" then false else true)
     && (match args with Cons (_, Nil) -> false | _ -> true) then
    raise_exc world "ArgumentError"
      ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 1)")
  else
  // Hash#dig is the same walk Array#dig does: it reads through `[]` (so the
  // hash's DEFAULT answers a missing key), recurses by CALLING #dig on what it
  // found, and names an intermediate that has none in a TypeError. The
  // primitive recursed into itself, which bypassed both.
  if str_eq name "dig" && (match recv with VHsh _ -> true | _ -> false)
     && (if prim_user_has world recv "dig" then false else true) then
    (match args with
     | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1+)"
     | Cons (k0, rest) ->
       (let v = invoke_val_c env world noblk recv "[]" (Cons (k0, Nil)) false in
        match rest with
        | Nil -> v
        | _ ->
          (match v with
           | VNil -> VNil
           | VArr _ -> invoke_val_c env world noblk v "dig" rest false
           | VHsh _ -> invoke_val_c env world noblk v "dig" rest false
           | _ ->
             (if responds world v "dig" then invoke_val_c env world noblk v "dig" rest false
              else raise_exc world "TypeError" (class_name v ++ " does not have #dig method")))))
  else
  if str_eq name "dig" && (match recv with VArr _ -> true | _ -> false)
     && (if prim_user_has world recv "dig" then false else true) then
    (match coerce_arr_index_args env world "at" args with
     | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1+)"
     | Cons (i0, rest) ->
       (let v = prim_method recv "at" (Cons (i0, Nil)) in
        match rest with
        | Nil -> v
        | _ ->
          (match v with
           | VNil -> VNil
           | VArr _ -> invoke_val_c env world noblk v "dig" rest false
           | VHsh _ -> invoke_val_c env world noblk v "dig" rest false
           | _ ->
             (if responds world v "dig" then invoke_val_c env world noblk v "dig" rest false
              else raise_exc world "TypeError" (class_name v ++ " does not have #dig method")))))
  else
  // Array#join asks each element #to_str, then #to_ary, then #to_s -- in that
  // order -- and folds the ENCODING along with the text. prim_method (the
  // value-level fallback) has no `world` to dispatch any of them with.
  if str_eq name "join" && (match recv with VArr _ -> true | _ -> false)
     && (if prim_user_has world recv "join" then false else true) then
    (match recv with
     | VArr id0 ->
       (let xs0 = deref id0 in
        // an EMPTY array joins to a US-ASCII "" and must not touch the
        // separator at all (the spec pins that it receives no #to_str), so
        // this answer comes before the separator is even looked at.
        if (match xs0 with Nil -> true | _ -> false) then
          (let h8 = mkstr "" in
           let _ = (match h8 with VStr sh8 -> senc_set sh8 "US-ASCII" | _ -> ()) in h8)
        else
        // the separator is a String, or `$,` when it is absent OR nil (both
        // forms take the global -- `join(nil)` was joining with nothing).
        (let gsep = (if map_has globals "," then map_get globals "," else VNil) in
        let _ = (match args with
                 | Nil -> () | Cons (VNil, _) -> () | Cons (VStr _, _) -> ()
                 // a separator that is not a String and offers no #to_str
                 // (tried upstream) is ruby's conversion error.
                 | Cons (other, _) ->
                   (let _ = raise_exc world "TypeError"
                              ("no implicit conversion of " ++ class_name other ++ " into String") in ())) in
        let sepv = (match args with Cons (VStr sh, _) -> VStr sh | _ -> gsep) in
        let sep = (match sepv with VStr sh -> sget sh | _ -> "") in
        let sepe = (match sepv with VStr sh -> enc_canon_name (senc_get sh) | _ -> "US-ASCII") in
        // the text and its ENCODING are accumulated together: each piece
        // negotiates with what is already there, exactly as `<<` does, and an
        // incompatible pair is ruby's EncodingError rather than a silent UTF-8.
        let app = fn (acc: str) -> fn (ae: str) -> fn (piece: str) -> fn (pe: str) ->
          (let ae2 = enc_compat2 ae acc pe piece in
           if str_eq ae2 "" then
             (let _ = raise_exc world "Encoding::CompatibilityError"
                        ("incompatible character encodings: " ++ ae ++ " and " ++ pe) in (acc, ae))
           else (acc ++ piece, ae2)) in
        let seen = map_new () in
        let _ = map_set seen ("a" ++ str_of_int id0) VNil in
        // an element is a String, an Array (joined with the SAME separator at
        // every depth), or an object asked #to_str, then #to_ary, then #to_s.
        let rec ljoin = fn (ys: Val list) -> fn (acc: str) -> fn (ae: str) -> fn (first: bool) ->
          (match ys with
           | Nil -> (acc, ae)
           | Cons (h, t) ->
             (let (a0, e0) = (if first then (acc, ae) else app acc ae sep sepe) in
              let sub = fn (aid: int) -> fn (a9: str) -> fn (e9: str) ->
                (if map_has seen ("a" ++ str_of_int aid)
                 then (let _ = raise_exc world "ArgumentError" "recursive array join" in (a9, e9))
                 else (let _ = map_set seen ("a" ++ str_of_int aid) VNil in
                       let (r9, re9) = ljoin (deref aid) a9 e9 true in
                       let _ = map_delete seen ("a" ++ str_of_int aid) in (r9, re9))) in
              let str_of = fn (v: Val) -> fn (a9: str) -> fn (e9: str) ->
                (match v with
                 | VStr sh -> app a9 e9 (sget sh) (enc_canon_name (senc_get sh))
                 | other -> app a9 e9 (to_s other) "US-ASCII") in
              let (a1, e1) =
                (match h with
                 | VStr sh -> app a0 e0 (sget sh) (enc_canon_name (senc_get sh))
                 | VArr aid -> sub aid a0 e0
                 | VObj oid ->
                   (let r1 = (if responds world h "to_str"
                              then invoke_val_c env world noblk h "to_str" Nil false else VNil) in
                    match r1 with
                    | VStr sh -> app a0 e0 (sget sh) (enc_canon_name (senc_get sh))
                    | _ ->
                      (let r2 = (if responds world h "to_ary"
                                 then invoke_val_c env world noblk h "to_ary" Nil false else VNil) in
                       match r2 with
                       | VArr aid -> sub aid a0 e0
                       | _ ->
                         (let (m2, s2, ocls2, iv2) = world in
                          let cls = map_get ocls2 oid in
                          if has_meth world cls "to_s"
                          then str_of (invoke world noblk h cls "to_s" Nil) a0 e0
                          else app a0 e0 (to_s h) "US-ASCII")))
                 | _ -> app a0 e0 (to_s h) "US-ASCII") in
              ljoin t a1 e1 false)) in
        let (txt, tenc) = ljoin xs0 "" "US-ASCII" true in
        let h9 = mkstr txt in
        let _ = (match h9 with VStr sh9 -> senc_set sh9 tenc | _ -> ()) in
        h9))
     | _ -> VNil)
  // A Hash built with a block calls it on a miss. prim_method's [] can only
  // see the plain default, so the block form is answered here, where a proc
  // can actually be run.
  // Hash#to_proc: a one-argument proc that looks the key up in this hash, so
  // `[:a, :b].map(&h)` works. Built the same way as Method#to_proc.
  else if str_eq name "to_proc" && (match recv with VHsh _ -> true | _ -> false) then
    (let benv = map_new () in
     let _ = map_set benv "__h_self" recv in
     let body = Cons (SExpr (EMethod (EVar "__h_self", "[]", Cons (EVar "__k", Nil))), Nil) in
     let pid = map_len proc_store in
     let _ = store_proc (str_of_int pid) (true, Cons ("__k", Nil), body, benv) in
     let _ = map_set lambda_ids (str_of_int pid) VNil in
     VProc pid)
  else if str_eq name "default_proc" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with VHsh hid -> hdproc_get hid | _ -> VNil)
  // `h.default_proc = proc { |hash, key| ... }`: the same default a block
  // given to Hash.new installs, set after the fact. nil removes it.
  // transform_keys / transform_values without a block are ENUMERATORS, and
  // transform_keys also takes a HASH that maps old keys to new ones (with the
  // block, when both are given, deciding the keys the hash does not name).
  else if (str_eq name "transform_keys" || str_eq name "transform_values"
           || str_eq name "transform_keys!" || str_eq name "transform_values!")
          && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv name then false else true)
          && (match args with Nil -> true | _ -> false) then
    make_enum_a world recv name args
  else if (str_eq name "transform_keys" || str_eq name "transform_keys!")
          && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv name then false else true)
          && (match args with Cons (VHsh _, _) -> true | _ -> false) then
    (match (recv, args) with
     | (VHsh hid, Cons (VHsh mid, _)) ->
       (let mp = hderef mid in
        let rec go = fn (ys: Val list) ->
          (match ys with
           | Cons (k, Cons (v, t)) ->
             Cons ((if hash_haskey mp k then hash_get mp k else k), Cons (v, go t))
           | _ -> (Nil : Val list)) in
        let out = hash_merge Nil (go (hderef hid)) in
        if str_eq name "transform_keys!" then (let _ = hset hid out in recv) else mkhash out)
     | _ -> recv)
  // `h[key] = v` through DISPATCH (send / a subclass) resolves the stored key
  // the same way the fast path does.
  // ⚠ ...and the READ doors, through the same rule (see hkey_eql_w).
  else if (str_eq name "[]" || str_eq name "key?" || str_eq name "has_key?"
           || str_eq name "member?" || str_eq name "include?"
           || str_eq name "fetch" || str_eq name "delete")
          // ...and the READ doors skip the protocol for a compare_by_identity
          // hash for the same reason the store door does.
          && (match recv with VHsh h8 -> (if hcbi_on h8 then false else true) | _ -> false)
          && (match args with Cons (k7, _) -> key_has_user_hash world k7 | _ -> false) then
    (match recv with
     | VHsh h ->
       (let xs = hderef h in
        match args with
        | Cons (k7, rest7) ->
          (let _ = hash_touch env world k7 in
           if str_eq name "[]" then hash_get_w env world h xs k7
           else if str_eq name "delete" then
             (let had = hash_haskey_w env world h xs k7 in
              let v7 = hash_get_w env world h xs k7 in
              let _ = (if had then hset h (hash_del_w env world h xs k7) else ()) in
              if had then v7 else VNil)
           else if str_eq name "fetch" then
             (if hash_haskey_w env world h xs k7 then hash_get_w env world h xs k7
              else (match rest7 with
                    | Cons (d7, _) -> d7
                    | Nil -> raise_exc world "KeyError" ("key not found: " ++ inspect_w env world k7)))
           else VBool (hash_haskey_w env world h xs k7))
        | _ -> VNil)
     | _ -> VNil)
  else if (str_eq name "[]=" || str_eq name "store")
          && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv name then false else true)
          && (match args with Cons (_, Cons (_, Nil)) -> true | _ -> false) then
    (match recv with
     | VHsh hid9 ->
       (match args with
        | Cons (k9, Cons (v9, Nil)) ->
          (let key9 = hash_store_key env world hid9 k9 in
           let _ = hset hid9 (hash_put_wx env world hid9 (hcbi_on hid9) (hderef hid9) key9 v9) in v9)
        | _ -> VNil)
     | _ -> VNil)
  // Hash#rehash: rebuild the table now that the keys may hash differently.
  // Measured against ruby: entries that have BECOME equal collapse, and the
  // survivor keeps the FIRST one's position and the LAST one's value -- which
  // is what re-inserting every pair in order does.
  // ⚠ through hash_put_wx, not the value-level hash_put. The two compare keys
  //   differently: hash_put asks `==` and the hash protocol asks #hash and then
  //   #eql?. The spec's four keys share a hash and answer eql? true while `==`
  //   says no, so a rebuild through the value-level put collapsed nothing --
  //   the rule is only right if the rebuild asks the same question a store
  //   does.
  else if str_eq name "rehash" && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv name then false else true) then
    (match recv with
     | VHsh hid9 ->
       // ⚠ ci9 AND hd9 travel as PARAMETERS, not captures: the lambda lifter
       //   drops a capture chosen by name (PAIN.md M10) and the emitted C came
       //   out with "use of undeclared identifier mu_ci9". Mere accepted the
       //   source; the C compiler is what caught it -- once per name.
       (let rec re9 = fn (hd9: int) -> fn (ci9: bool) -> fn (xs: Val list) -> fn (acc: Val list) ->
          (match xs with
           | Cons (k9, Cons (v9, t9)) -> re9 hd9 ci9 t9 (hash_put_wx env world hd9 ci9 acc k9 v9)
           | _ -> acc) in
        let _ = hset hid9 (re9 hid9 (hcbi_on hid9) (hderef hid9) Nil) in recv)
     | _ -> recv)
  // Hash#initialize on a FROZEN hash refuses (it replaces the default either
  // way), and the primitive has no way to know it was frozen.
  else if str_eq name "initialize" && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv "initialize" then false else true) then
    (match recv with
     | VHsh hid9 ->
       (if cfrozen_get 1 hid9 then
          raise_exc_iv world "FrozenError" ("can't modify frozen Hash: " ++ inspect recv) (Cons (("__recv", recv), Nil))
        else prim_method recv "initialize" args)
     | _ -> VNil)
  // Hash#fetch takes a key and at most one default; Hash#deconstruct_keys takes
  // exactly one argument. Both accepted any number.
  else if str_eq name "fetch" && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv "fetch" then false else true)
          && (match args with
              | Nil -> true
              | Cons (_, Cons (_, Cons (_, _))) -> true
              | _ -> false) then
    raise_exc world "ArgumentError"
      ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 1..2)")
  else if str_eq name "deconstruct_keys" && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv "deconstruct_keys" then false else true)
          && (match args with Cons (_, Nil) -> false | _ -> true) then
    raise_exc world "ArgumentError"
      ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 1)")
  // `h[missing]` asks the RECEIVER for its default, so a subclass that
  // overrides #default answers it (the primitive read the stored default and
  // never asked). The plain default is what Hash#default itself answers, so
  // this only needs to fire when the class has its own.
  // Two hashes the structural comparison called unequal, at least one of them
  // holding objects: ask the values (and the keys) themselves. Guarded to the
  // case where the plain answer was already false, so an ordinary comparison
  // never reaches it.
  else if (str_eq name "==" || str_eq name "eql?")
          && (match recv with VHsh _ -> true | _ -> false)
          && (match args with Cons (VHsh _, _) -> true | _ -> false)
          && (match recv with
              | VHsh h1 -> (match args with
                            | Cons (VHsh h2, _) -> (if rb_eq recv (VHsh h2) then false else hash_has_obj world (hderef h1))
                            | _ -> false)
              | _ -> false) then
    (match recv with
     | VHsh h1 -> (match args with
                   | Cons (VHsh h2, _) -> VBool (hash_eq_w env world h1 h2)
                   | _ -> VBool false)
     | _ -> VBool false)
  // ...and two Arrays the same way: element by element, asking an object its own
  else if (str_eq name "==" || str_eq name "eql?")
          && (match recv with VArr _ -> true | _ -> false)
          && (match args with Cons (VArr _, _) -> true | _ -> false)
          && (match recv with
              | VArr a1 -> (match args with
                            | Cons (VArr a2, _) -> (if rb_eq recv (VArr a2) then false else arr_has_obj world (deref a1))
                            | _ -> false)
              | _ -> false) then
    (match recv with
     | VArr a1 -> (match args with
                   | Cons (VArr a2, _) -> VBool (arr_eq_w env world (deref a1) (deref a2))
                   | _ -> VBool false)
     | _ -> VBool false)
  // The METHOD forms of the arithmetic take the coerce protocol too: `1.div(o)`
  // and `1.modulo(o)` are the operators under other names, and they were
  // answering NoMethodError for an object that coerces.
  else if (match recv with VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat _ -> true | _ -> false)
          && (str_eq name "div" || str_eq name "modulo" || str_eq name "quo" || str_eq name "fdiv"
              || str_eq name "remainder" || str_eq name "divmod" || str_eq name "<=>")
          && (match args with Cons (VObj _, _) -> true | _ -> false)
          && (match args with Cons (a9, _) -> (responds world a9 "coerce" || has_coerce world a9) | _ -> false) then
    (match args with
     | Cons (a9, _) ->
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
        match invoke_val_c env world nb9 a9 "coerce" (Cons (recv, Nil)) false with
        | VArr aid9 ->
          (match deref aid9 with
           | Cons (x9, Cons (y9, Nil)) -> coerced_apply env world name x9 y9
           | _ -> raise_exc world "TypeError" "coerce must return [x, y]")
        | _ -> raise_exc world "TypeError" "coerce must return [x, y]")
     | _ -> VNil)
  // A Hash READ whose key is an object with its own #hash and #eql?: the fast
  // lookup compares identity and misses, so ask the key which stored key it is
  // equal to and re-ask with THAT one. Guarded so that an ordinary hash never
  // reaches it: the receiver is a Hash, the key is such an object, and the
  // plain lookup has already missed.
  else if (match recv with VHsh _ -> true | _ -> false)
          && (str_eq name "[]" || str_eq name "key?" || str_eq name "has_key?" || str_eq name "include?"
              || str_eq name "member?" || str_eq name "fetch" || str_eq name "delete" || str_eq name "assoc")
          && (match args with Cons (k9, _) -> key_has_own_eql world k9 | _ -> false)
          && (match recv with
              | VHsh hid9 -> (match args with
                              | Cons (k9, _) -> (if hash_haskey_x (hcbi_on hid9) (hderef hid9) k9 then false else true)
                              | _ -> false)
              | _ -> false)
          && (match recv with
              | VHsh hid9 -> (match args with
                              | Cons (k9, _) -> (let (f9, _) = hash_find_key_w env world hid9 k9 in f9)
                              | _ -> false)
              | _ -> false) then
    (match recv with
     | VHsh hid9 ->
       (match args with
        | Cons (k9, rest9) ->
          (let (_, kk9) = hash_find_key_w env world hid9 k9 in
           if str_eq name "key?" || str_eq name "has_key?" || str_eq name "include?" || str_eq name "member?"
           then VBool true
           else invoke_val_c env world blk recv name (Cons (kk9, rest9)) false)
        | _ -> VNil)
     | _ -> VNil)
  else if str_eq name "[]" && (match recv with VHsh _ -> true | _ -> false)
          && (match args with Cons (_, Nil) -> true | _ -> false)
          && has_meth world (dispatch_cls_of world recv) "default"
          && (match recv with
              | VHsh hid9 -> (match args with
                              | Cons (k9, _) -> (if hash_haskey_x (hcbi_on hid9) (hderef hid9) k9 then false else true)
                              | _ -> false)
              | _ -> false) then
    (match args with
     | Cons (k9, _) -> invoke_val_c env world noblk recv "default" (Cons (k9, Nil)) false
     | _ -> VNil)
  // Hash#default(key) with a default PROC calls it with (hash, key); with no
  // argument the proc is not called at all. The primitive has no world to call
  // it with, so it answered the (absent) plain default.
  else if str_eq name "default" && (match recv with VHsh _ -> true | _ -> false)
          // ...unless the receiver's class has its own #default (a subclass
          // hook): a builtin arm must never win over a definition.
          && (if prim_user_has world recv "default" then false else true)
          && (match args with Cons (_, _) -> true | _ -> false) then
    (match recv with
     | VHsh hid ->
       (match hdproc_get hid with
        | VProc pid9 ->
          (match args with
           | Cons (k9, _) -> flow_value (run_block world noblk (proc_as_block pid9) (Cons (recv, Cons (k9, Nil))))
           | Nil -> hdflt_get hid)
        | _ -> hdflt_get hid)
     | _ -> VNil)
  else if str_eq name "default_proc=" && (match recv with VHsh _ -> true | _ -> false)
          && (if prim_user_has world recv "default_proc=" then false else true) then
    (match recv with
     | VHsh hid ->
       // a frozen hash refuses it; a non-Proc is asked #to_proc; and a LAMBDA
       // must take exactly two arguments (hash, key) -- ruby checks the arity
       // and answers TypeError, not a call-time ArgumentError.
       (if cfrozen_get 1 hid then
          raise_exc_iv world "FrozenError" ("can't modify frozen Hash: " ++ inspect recv) (Cons (("__recv", recv), Nil))
        else
        (let a0 = (match args with
                   | Cons (VProc p9, _) -> VProc p9
                   | Cons (VNil, _) -> VNil
                   | Cons (o9, _) ->
                     (match conv_try env world o9 "to_proc" with
                      | VProc p9 -> VProc p9
                      | _ -> raise_exc world "TypeError"
                               ("wrong default_proc type " ++ class_name o9 ++ " (expected Proc)"))
                   | Nil -> VNil) in
         match a0 with
         | VProc pid ->
           (let ar9 = (match map_get proc_store (str_of_int pid) with
                       | (_, ps9, _, _) -> mandatory_pos_count ps9 (Nil : (str * Expr) list)) in
            if map_has lambda_ids (str_of_int pid) && (if ar9 == 2 then false else true) then
              raise_exc world "TypeError" "default_proc takes two arguments (2 for 1)"
            else
              (let _ = (if map_has hash_dflt (str_of_int hid) then map_delete hash_dflt (str_of_int hid) else ()) in
               let _ = hdproc_set hid (VProc pid) in
               (match args with Cons (orig9, _) -> orig9 | Nil -> VProc pid)))
         | _ ->
           (let _ = (if map_has hash_dproc (str_of_int hid) then map_delete hash_dproc (str_of_int hid) else ()) in VNil)))
     | _ -> VNil)
  else if str_eq name "[]" && (match recv with VHsh hid -> (match hdproc_get hid with VProc _ -> true | _ -> false) | _ -> false)
          && (match args with
              | Cons (k, _) -> (match recv with VHsh hid -> (if hash_haskey (hderef hid) k then false else true) | _ -> false)
              | _ -> false) then
