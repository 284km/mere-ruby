  // arms, whose unknown-name fallbacks would say NoMethodError first. The
  // keyword form never lands here, and a class with its own raise keeps it.
  if (str_eq name "raise" || str_eq name "fail")
     && (if vischeck then false else true)
     && (if has_meth world (dispatch_cls_of world recv) name then false else true)
     && (if has_meth world (dispatch_cls_of world recv) "method_missing" then false else true) then
