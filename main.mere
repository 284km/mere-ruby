//   the call itself.
and hash_touch = fn env -> fn world -> fn (k: Val) ->
  if key_has_user_hash world k
  then (let _ = invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) k "hash" Nil false in ())
  else ()

