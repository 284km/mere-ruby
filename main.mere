       // until one of them is called.
       else if str_eq name "utc" || str_eq name "getutc" then (let _ = map_set iv9 k (VBool true) in recv)
       // Time + n / Time - n shift by seconds; Time - Time is the difference
       // in seconds (a Float in Ruby).
       else if str_eq name "+" || str_eq name "-" then
         (let ep = (match prim_time_epoch world recv with VInt n -> n | _ -> 0) in
          match args with
          | Cons (VObj oid2, _) ->
            (if str_eq name "-" then VFlt (float_of_int (ep - (match prim_time_epoch world (VObj oid2) with VInt n -> n | _ -> 0)))
             else raise_exc world "TypeError" "time + time?")
          | Cons (v, _) ->
            (let d = (match v with VInt n -> n | VFlt f -> int_of_float f | _ -> 0) in
             make_time_at world (if str_eq name "-" then ep - d else ep + d))
          | _ -> recv)
