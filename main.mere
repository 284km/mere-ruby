              if enc_clen1 given bs9 == str_len bs9
              then (let r = mkstr bs9 in
                    (match r with VStr rid -> (let _ = senc_set rid given in r) | _ -> r))
              else prim_raise "RangeError"
                     ("invalid codepoint 0x" ++ str_upcase (int_to_base n 16) ++ " in " ++ given)))
        // An encoding this interpreter has no structural model for. One thing
        // can still be said without one, because it holds in EVERY encoding: a
        // negative number is out of char range, and so is one past the largest
        // codepoint Unicode defines.
        else if n < 0 || n > 1114111 then prim_raise "RangeError" (str_of_int n ++ " out of char range")
        else prim_raise "NotImplementedError" ("Integer#chr in " ++ given ++ " is not implemented here"))
     | VStr sv -> let sv = sget sv in mkstr (utf8_char sv 0) | _ -> (let _ = map_set prim_missing "n" (mkstr "chr") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'chr'")) in fail "mere-ruby: undefined method 'chr'")))
  // Symbol#id2name is #to_s, and Symbol#name is the same string FROZEN. Both
  // were absent, which also made `:s.respond_to?(:id2name)` false for a name
  // ruby has.
  else if (str_eq name "id2name" || str_eq name "name")
          && (match recv with VSym _ -> true | _ -> false) then
    (match recv with
     | VSym sy ->
       // #name answers the SAME frozen string every call (`:a.name.equal?(:a.name)`
       // is true in ruby) -- a fresh mkstr per call cannot, however frozen it
       // is. str_fstring is the intern table the `-str` operator already uses,
       // so the identity comes from the one place that owns it. #id2name is the
       // older spelling and answers an ordinary mutable copy.
       (if str_eq name "name" then
          (let c9 = mkstr sy in
           let _ = (match c9 with VStr i9 -> senc_set i9 (sym_enc_name sy) | _ -> ()) in
           let f9 = str_fstring c9 in
           let _ = (match f9 with VStr i9 -> sfrozen_set i9 | _ -> ()) in
           f9)
        else
          (let h9 = mkstr sy in
           let _ = (match h9 with VStr i9 -> senc_set i9 (sym_enc_name sy) | _ -> ()) in
           h9))
     | _ -> VNil)
  // Symbol.all_symbols: every symbol this program has named, which is what
  // sym_all has been collecting since the lexer saw the first one.
  // Exception.to_tty?: whether the report would be going to a terminal, which
  // is the default for #full_message's `highlight:`. Mere has no isatty, so
  // every tty? here answers false -- and full_message's default must agree
  // with it, because that is what core/exception/full_message compares.
  else if str_eq name "to_tty?" && (match recv with VClass c8 -> str_eq c8 "Exception" | _ -> false) then VBool false
  else if str_eq name "all_symbols" && (match recv with VClass c9 -> str_eq c9 "Symbol" | _ -> false) then
    (let acc9 = map_new () in
     let _ = map_set acc9 "v" (arr_new (Nil : Val list)) in
     let _ = map_iter sym_all (fn (k9: str) -> fn (_v9: Val) ->
       (match map_get acc9 "v" with
        | VArr id9 -> (let _ = arr_set id9 (list_append (deref id9) (Cons (VSym k9, Nil))) in ())
        | _ -> ())) in
     map_get acc9 "v")
  else if str_eq name "to_sym" || str_eq name "intern" then
    // the symbol KEEPS the string's encoding (recorded aside -- VSym is just
    // the name): ascii-only content is US-ASCII, invalid content refuses.
    (match recv with
     | VStr sh ->
       (let s = sget sh in
        let e = enc_canon_name (senc_get sh) in
        if (if enc_valid s e then false else true)
        then prim_raise "EncodingError" ("invalid symbol in encoding " ++ e ++ " :" ++ inspect (VStr sh))
        else
          let _ = (if enc_all7 s && enc_ascii_compat e then (if map_has sym_enc s then map_delete sym_enc s else ())
                   else if str_eq e "UTF-8" then (if map_has sym_enc s then map_delete sym_enc s else ())
                   else map_set sym_enc s e) in
          let _ = sym_note s in
          VSym s)
     | VSym s -> VSym s
     | _ -> (let _ = map_set prim_missing "n" (mkstr "to_sym") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_sym'")) in fail "mere-ruby: undefined method 'to_sym'")))
  // the implicit-conversion protocol: unlike to_s / to_a / to_i these exist
  // only on the type itself, which is exactly what makes them useful for
  // duck-typing (`if x.respond_to? :to_str`).
  // String#initialize replaces the contents; with no argument it leaves the
  // string as it is (which is what `send(:initialize)` on a live string does).
  else if str_eq name "initialize" && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr h -> (match args with Cons (VStr o, _) -> let _ = sset h (sget o) in recv | _ -> recv)
     | _ -> recv)
  else if str_eq name "to_str" then
    (match recv with VStr _ -> recv | _ -> (let _ = map_set prim_missing "n" (mkstr "to_str") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_str'")) in fail "mere-ruby: undefined method 'to_str'")))
  else if str_eq name "to_ary" then
    (match recv with VArr _ -> recv | _ -> (let _ = map_set prim_missing "n" (mkstr "to_ary") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_ary'")) in fail "mere-ruby: undefined method 'to_ary'")))
  else if str_eq name "to_int" then
    // Numeric#to_int is Integer#to_i for every Numeric, not Integer's alone --
    // Float, Rational and Complex all answer it (a Complex with an imaginary
    // part by refusing, which is still an answer and not a missing method).
    (match recv with VInt _ -> recv | VBig _ -> recv
     // ...and a NaN or an infinity has none: this arm comes BEFORE the shared
     // FloatDomainError guard below, so it needs the same refusal.
     | VFlt f9 when flt_is_nan f9 || flt_is_inf f9 ->
       prim_raise "FloatDomainError" (to_s recv)
     | VFlt f -> VInt (int_of_float f)
     | VRat (rn, rd) -> norm_big (rat_int_mode "truncate" rn rd)
     | VCpx (cre, cim) ->
       (if exact_zero_val cim then prim_method cre "to_i" (Nil : Val list)
        else prim_raise "RangeError" ("can't convert " ++ to_s recv ++ " into Integer"))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "to_int") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_int'")) in fail "mere-ruby: undefined method 'to_int'")))
  else if str_eq name "to_hash" then
    (match recv with VHsh _ -> recv | _ -> (let _ = map_set prim_missing "n" (mkstr "to_hash") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_hash'")) in fail "mere-ruby: undefined method 'to_hash'")))
  // eql? is == without any numeric conversion, so it also demands one class.
  else if str_eq name "eql?" then
    (match args with Cons (b, _) -> VBool (rb_eql recv b) | _ -> VBool false)
  else if str_eq name "equal?" then
    (match args with Cons (b, _) -> VBool (rb_identical recv b) | _ -> VBool false)
  else if str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?" then
    (match args with
     | Cons (VClass c, _) ->
       let cn = class_name recv in
       // instance_of? is exact class; is_a?/kind_of? also count the value's
       // superclasses and included modules. prim_method is world-free, so the
       // primitive ancestry (Kernel/Object for all, Numeric/Comparable for the
       // number-and-string types, Enumerable for the collections) is inlined.
       let numeric = (match recv with VInt _ -> true | VBig _ -> true | VFlt _ -> true | VRat _ -> true | VCpx _ -> true | _ -> false) in
       let comparable = (match recv with VInt _ -> true | VBig _ -> true | VFlt _ -> true | VRat _ -> true | VStr _ -> true | _ -> false) in
       let enumerable = (match recv with VArr _ -> true | VHsh _ -> true | VRange _ -> true | _ -> false) in
       if str_eq name "instance_of?" then VBool (str_eq cn c)
       else VBool (str_eq cn c || str_eq c "Object" || str_eq c "BasicObject" || str_eq c "Kernel"
                   || (str_eq c "Numeric" && numeric)
                   || (str_eq c "Comparable" && comparable)
                   || (str_eq c "Enumerable" && enumerable))
     | Cons (_, _) -> (let _ = prim_raise "TypeError" "class or module required" in VBool false)
     | _ -> VBool false)
  else if str_eq name "message" then (match recv with VExc (_, m) -> mkstr m | _ -> mkstr (to_s recv))
  // Exception#cause on the built-in representation: nil. There is nowhere on a
  // class-and-message pair to record what was in flight, and nil is also ruby's
  // answer whenever nothing was -- the common case. An exception OBJECT records
  // its cause for real (see @__cause). Answering at all is the point: bundler's
  // friendly_errors reads `e.cause` on every error it reports, so a NoMethodError
  // here replaces the error being reported.
  else if str_eq name "cause" then VNil
  // Exception#backtrace / #backtrace_locations on a BUILT-IN exception (the
  // representation that carries only a class and a message): mere-ruby captures
  // no call stack, so the answer is nil -- the same answer an exception OBJECT
  // gives until set_backtrace is called. Answering at all is what matters: a
  // library reads a backtrace while REPORTING an error, so a NoMethodError here
  // replaces the error being reported and hides it (bundler's eval_gemfile
  // builds its DSLError out of `e.backtrace`). set_backtrace is not here: there
  // is nowhere to store it on this representation, and answering nil afterwards
  // would be a lie rather than a gap.
  else if str_eq name "backtrace" || str_eq name "backtrace_locations"
          || (str_eq name "set_backtrace" && (match recv with VExc (_, _) -> true | _ -> false)) then
    (match recv with
     | VExc (_, _) ->
       (if str_eq name "set_backtrace" then
          // the pair has no ivars, so its backtrace lives in the slot beside
          // the last raise -- which is the exception being handled, and the
          // only one #set_backtrace is ever called on. Answering NoMethodError
          // meant `raise` (bare) produced an exception that could not be given
          // one, while `raise SomeError.new` could.
          (match args with
           | Cons (v9, _) ->
             (let _ = map_set raise_bt "e" recv in
              let _ = map_set raise_bt "eb" v9 in v9)
           | Nil -> VNil)
        else if str_eq name "backtrace"
           && map_has raise_bt "eb" && map_has raise_bt "e"
           && rb_eq (map_get raise_bt "e") recv
        then map_get raise_bt "eb"
        else if str_eq name "backtrace" && map_has raise_bt "v"
                && map_has globals "!" && rb_eq (map_get globals "!") recv
        then map_get raise_bt "v" else VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr name) in
             (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: undefined method '" ++ name ++ "'"))) in
              fail ("mere-ruby: undefined method '" ++ name ++ "'"))))
  // Exception#exception on the PAIR representation: self with no argument, a
  // copy carrying the new message with one. The object form has had this all
  // along; the pair form answered NoMethodError, and `raise "x"` makes a pair.
  else if str_eq name "exception" && (match recv with VExc (_, _) -> true | _ -> false) then
    (match recv with
     | VExc (ec9, em9) ->
       (match args with
        | Nil -> recv
        | Cons (VNil, _) -> recv
        | Cons (VStr mh9, _) -> VExc (ec9, sget mh9)
        | Cons (other9, _) -> VExc (ec9, to_s other9))
     | _ -> recv)
  // LoadError#path: the file that could not be loaded (nil for a LoadError
  // raised with any other message).
  else if str_eq name "path" then
    (match recv with
     | VExc (_, m) -> (if map_has le_path m then map_get le_path m else VNil)
     | _ -> VNil)
  // ⚠ A NaN or an infinity has NO integer, and ruby refuses BY NAME: the
  //   message is the value ("NaN" / "Infinity" / "-Infinity"). Every one of
  //   these answered a fabricated machine limit instead -- and `(-inf).floor`
  //   answered the POSITIVE one, because the saturation is a property of the
  //   cast rather than of the question. A DIGIT count above zero is the one
  //   case with an answer: `inf.round(2)` is Infinity, the receiver itself.
  else if (str_eq name "to_i" || str_eq name "to_int" || str_eq name "truncate"
           || str_eq name "round" || str_eq name "floor" || str_eq name "ceil"
           || str_eq name "divmod" || str_eq name "to_r" || str_eq name "rationalize")
          && (match recv with VFlt f9 -> flt_is_nan f9 || flt_is_inf f9 | _ -> false) then
    (if (match args with Cons (VInt d9, _) -> d9 > 0 | _ -> false)
        && (str_eq name "round" || str_eq name "floor" || str_eq name "ceil" || str_eq name "truncate")
     then recv
     // the message is the VALUE as printed -- "NaN", "Infinity", "-Infinity"
     // (float_special answers "Inf", which is the printf spelling, not ruby's).
     else prim_raise "FloatDomainError" (to_s recv))
  // ⚠ the PRECISION argument is converted with to_int, so a Float one is
  //   truncated: `12.345678.round(3.999)` is round(3) and answers 12.346.
  //   Only an Integer argument was matched, so a Float one fell through to the
  //   no-argument arm and answered 12.
  // ...but NOT for a Rational receiver: `Rational(1,2).round(1.5)` is a
  // TypeError in ruby, where `12.3.round(1.5)` and `12345.round(1.5)` are not.
  else if (str_eq name "round" || str_eq name "floor" || str_eq name "ceil" || str_eq name "truncate")
          && (match recv with VInt _ -> true | VBig _ -> true | VFlt _ -> true | _ -> false)
          && (match args with Cons (VFlt _, _) -> true | Cons (VRat (_, _), _) -> true | _ -> false) then
    (match args with
     | Cons (VRat (pn, pd), rest) ->
       // ...a Rational one too: `12.3.round(Rational(3,2))` is round(1). It is
       // truncated toward zero, exactly as #to_int does.
       prim_method recv name (Cons (norm_big (rat_int_mode "truncate" pn pd), rest))
     | Cons (VFlt pf, rest) ->
       // ⚠ this is the ARGUMENT being converted to an Integer, not the
       //   receiver: an infinite or NaN precision is a RangeError about the
       //   conversion ("float Inf out of range of integer"), never the
       //   FloatDomainError a receiver gets. corpus/196 caught the mix-up.
       (if flt_is_nan pf then prim_raise "RangeError" "float NaN out of range of integer"
        else if flt_is_inf pf
        then prim_raise "RangeError"
               ("float " ++ (if pf > 0.0 then "Inf" else "-Inf") ++ " out of range of integer")
        else prim_method recv name (Cons (flt_trunc_v pf, rest)))
     | _ -> VNil)
  // ...and a precision beyond what a Float can hold changes nothing: ruby
  // answers the receiver for a large positive one and zero for a large
  // negative one. `int_pow 10 d` below would overflow long before either --
  // `0.42.round(2.0**23)` asked for 10**8388608.
  else if (str_eq name "round" || str_eq name "floor" || str_eq name "ceil" || str_eq name "truncate")
          && (match recv with VFlt f9 -> (if flt_is_big_whole f9 then false else true) | _ -> false)
          && (match args with Cons (VInt d9, _) -> d9 > 17 || d9 < (0 - 17) | _ -> false) then
    (match args with Cons (VInt d9, _) -> (if d9 > 17 then recv else VInt 0) | _ -> recv)
  // ⚠ ...and anything that is NOT a precision is refused BEFORE the rounding
  //   arms answer, in ruby's two wordings: "no implicit conversion of String
  //   into Integer", and for nil "no implicit conversion FROM nil TO integer"
  //   (rb_num2long's own phrasing, lower case and reversed). Only #truncate
  //   had a check, it sat after the other three arms, and it used Rational's
  //   message -- so `12345.floor("x")` cheerfully answered 12345.
  else if (str_eq name "truncate" || str_eq name "round" || str_eq name "floor" || str_eq name "ceil")
          && (match recv with VInt _ -> true | VBig _ -> true | VFlt _ -> true | _ -> false)
          && (match args with
              | Cons (p9, _) -> (match p9 with VInt _ -> false | VBig _ -> false | _ -> true)
              | _ -> false) then
    (match args with
     | Cons (VNil, _) -> prim_raise "TypeError" "no implicit conversion from nil to integer"
     | Cons (p9, _) -> conv_err p9 "Integer"
     | _ -> VNil)
  // ⚠ a RATIONAL takes an Integer precision and nothing else, and says so in
  //   its own words: "not an integer" for a Float, a String, nil, a Symbol or
  //   another Rational -- where an Integer or Float receiver reports the
  //   CONVERSION ("no implicit conversion of String into Integer"). Asked of
  //   ruby for all three receivers against five argument kinds, because the
  //   message is not one rule. The check existed for #truncate alone and sat
  //   AFTER the round / floor / ceil arms, which answered first.
  else if (str_eq name "truncate" || str_eq name "round" || str_eq name "floor" || str_eq name "ceil")
          && (match recv with VRat (_, _) -> true | _ -> false)
          && (match args with
              | Cons (p9, _) -> (match p9 with VInt _ -> false | VBig _ -> false | _ -> true)
              | _ -> false) then
    prim_raise "TypeError" "not an integer"
  else if str_eq name "to_i" then
    (match recv with
     | VInt n -> VInt n | VFlt f -> flt_trunc_v f
     | VBig s -> recv
     | VRat (n, d) -> norm_big (big_div_s n d)
     | VStr s -> let s = sget s in (match args with
                                    | Cons (VInt base, _) ->
                                      (if (base < 2 || base > 36) && base != 0
                                       then prim_raise "ArgumentError" ("invalid radix " ++ str_of_int base)
                                       else rb_str_to_i_base s base)
                                    | _ -> rb_str_to_i_base s 10)
     // NilClass#to_i is 0 (and #to_f 0.0, #to_a []): nil answers all three.
     | VNil -> VInt 0
     // a Complex converts only when it has no imaginary part -- the refusal is
     // a RangeError, which is an ANSWER; it had no arm and said the method did
     // not exist.
     | VCpx (cre, cim) ->
       (if exact_zero_val cim then prim_method cre "to_i" (Nil : Val list)
        else prim_raise "RangeError" ("can't convert " ++ to_s recv ++ " into Integer"))
     | _ -> prim_raise "NoMethodError" ("undefined method 'to_i' for " ++ for_recv_name recv))
  else if str_eq name "to_f" then
    (match recv with VInt n -> VFlt (float_of_int n) | VFlt f -> VFlt f | VBig s -> VFlt (float_of_str s) | VRat (n, d) -> VFlt (float_of_str n / float_of_str d) | VStr s -> (let e9 = enc_canon_name (senc_get s) in
                 if enc_ascii_compat e9 then VFlt (str_to_f_lenient (sget s))
                 else prim_raise "Encoding::CompatibilityError" ("ASCII incompatible encoding: " ++ e9)) | VNil -> VFlt 0.0
     | VCpx (cre, cim) ->
       (if exact_zero_val cim then VFlt (to_f cre)
        else prim_raise "RangeError" ("can't convert " ++ to_s recv ++ " into Float"))
     | _ -> prim_raise "NoMethodError" ("undefined method 'to_f' for " ++ for_recv_name recv))
  // to_a returns self for a plain Array, but a plain Array (not the subclass)
  // for a subclass instance.
  // Enumerable#entries is to_a under another name.
  else if str_eq name "entries" then
    (match recv with
     | VArr id -> arr_new (deref id)
     | VHsh h -> arr_new (hash_to_a (hderef h))
     | VRange (lo, hi, excl) ->
       if rng_hi_open hi then prim_raise "RangeError" "cannot convert endless range to an array"
       else if (match lo with VNil -> true | _ -> false) then prim_raise "TypeError" "can't iterate from NilClass"
       else (let rf9 = rng_iter_refusal lo hi in
             if str_eq rf9 "" then arr_new (range_vals_raw lo hi excl)
             else prim_raise "TypeError" ("can't iterate from " ++ rf9))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "entries") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'entries'")) in fail "mere-ruby: undefined method 'entries'")))
  else if str_eq name "to_a" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr id -> if str_eq (hng_key recv) "" || (if map_has hng_store (hng_key recv) then false else true)
                  then recv else arr_new (deref id)
     | _ -> recv)
  else if str_eq name "to_a" then
    (match recv with
     | VArr id -> VArr id
     | VHsh xs -> let xs = hderef xs in arr_new (hash_to_a xs)
     | VRange (lo, hi, excl) ->
       if rng_hi_open hi then prim_raise "RangeError" "cannot convert endless range to an array"
       else if (match lo with VNil -> true | _ -> false) then prim_raise "TypeError" "can't iterate from NilClass"
       else (let rf9 = rng_iter_refusal lo hi in
             if str_eq rf9 "" then arr_new (range_vals_raw lo hi excl)
             else prim_raise "TypeError" ("can't iterate from " ++ rf9))
     | VNil -> arr_new Nil
     | _ -> prim_raise "NoMethodError" ("undefined method 'to_a' for " ++ for_recv_name recv))
  // Integer#size is the machine word width in bytes -- and only `size`:
  // ruby has no Integer#length. concurrent-ruby derives FIXNUM_BIT_SIZE
  // from `0.size * 8`.
  else if str_eq name "size" && (match recv with VInt _ -> true | _ -> false) then VInt 8
  // a bignum's size is the bytes its magnitude needs, not the machine word.
  else if str_eq name "size" && (match recv with VBig _ -> true | _ -> false) then
    (match recv with
     | VBig b -> (let bits = big_bit_length (big_mag b) in VInt (floor_div (bits + 7) 8))
     | _ -> VInt 8)
  // Range#min / #max with no argument: the endpoints, not the elements. An
  // empty range answers nil, as ruby's do.
  else if (str_eq name "min" || str_eq name "max")
          && (match recv with VRange _ -> true | _ -> false)
          && (match args with Nil -> true | _ -> false) then
    (match recv with
     // min is the low bound; max needs the last ELEMENT, so an exclusive
     // integer range steps back one. A range with no low bound has no min,
     // and one with no high bound has no max.
     | VRange (lo, hi, excl) ->
       (if str_eq name "min" then
          (match lo with
           | VNil -> prim_raise "RangeError" "cannot get the minimum of beginless range"
           | _ ->
             (match hi with
              | VNil -> lo
              | _ -> if rng_empty lo hi excl then VNil else lo))
        else
          (match hi with
           | VNil -> prim_raise "RangeError" "cannot get the maximum of endless range"
           // An exclusive range needs an Integer at BOTH ends to name its last
           // element, and ruby reports the END first: `(1.0...10).max` is
           // refused for its begin, `(1...10.0)` for its end. Only the end was
           // checked here, so a Float BEGIN quietly answered 9.
           | VInt b ->
             (if excl && (match lo with VInt _ -> false | VBig _ -> false | VNil -> false | _ -> true)
              then prim_raise "TypeError" "cannot exclude end value with non Integer begin value"
              else
                (let top = (if excl then b - 1 else b) in
                 if rng_empty lo hi excl then VNil else VInt top))
           // a BIGNUM end steps back the same way -- `(1...2**64).max` was
           // answering the end itself, which is not an element of the range.
           | VBig b -> (if rng_empty lo hi excl then VNil
                        else if excl then norm_big (big_sub_s b "1") else hi)
           // An exclusive FLOAT end has no predecessor, and ruby says so
           // rather than answering the end: there is no last element.
           | VFlt _ ->
             (if excl then prim_raise "TypeError" "cannot exclude non Integer end value"
              else if rng_empty lo hi excl then VNil else hi)
           // An end that is not a NUMBER is not covered by the rules above:
           // ruby hands the whole thing to the WALK, and an exclusive range
           // needs the walk to name the element before the end. So
           // `(["a"]..["f"]).max` is ["f"] while `(["a"]...["f"]).max` is
           // "can't iterate from Array" -- it was answering ["f"] for both.
           | _ ->
             (if excl && (match lo with VNil -> false | _ -> not (str_eq (rng_walk_from lo) ""))
              then prim_raise "TypeError" ("can't iterate from " ++ rng_walk_from lo)
              else if rng_empty lo hi excl then VNil else hi)))
     | _ -> VNil)
  // Range#cover? / #include? / #member?: the endpoints answer directly.
  else if (str_eq name "cover?" || str_eq name "include?" || str_eq name "member?")
          && (match recv with VRange _ -> true | _ -> false) then
    (match recv with
     // membership is a comparison, so it works for every kind of bound --
     // including a missing one, which simply does not constrain that side.
     | VRange (lo, hi, excl) ->
       (match args with
        | Cons (v, _) -> VBool (rng_covers lo hi excl v)
        | _ -> VBool false)
     | _ -> VBool false)
  // Range#overlap? had no implementation at all.
  else if str_eq name "overlap?" && (match recv with VRange _ -> true | _ -> false) then
    (match recv with
     | VRange (lo, hi, excl) ->
       (match args with
        | Cons (o, _) -> rng_overlap lo hi excl o
        | _ -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
     | _ -> VBool false)
  // Range#size and Range#count are DIFFERENT questions, and ruby answers them
  // differently: `size` is arithmetic on numeric bounds (and nil for bounds
  // that are not numbers -- ("a".."e").size is nil), while `count` actually
  // enumerates (("a".."e").count is 5, and (1.0..2.0).count raises).
  else if (str_eq name "size" || str_eq name "count")
          && (match recv with VRange _ -> true | _ -> false)
          && (match args with Nil -> true | _ -> false) then
    (match recv with
     | VRange (lo, hi, excl) ->
       (if str_eq name "size" then
          // size: ARITHMETIC on an integer begin -- and the begin is what
          // decides. A Float begin cannot be walked at all in ruby 3.4, so
          // (1.5..3.5).size raises where mere answered 3; a String or Symbol
          // begin walks but is not counted, so ("a".."f").size is nil; and a
          // begin that cannot walk names itself, so (["a"]..["f"]).size is a
          // TypeError where mere answered nil. Only the integer arm is
          // arithmetic, and it is arithmetic on DECIMALS, so a bignum end
          // answers instead of falling off int.
          (match lo with
           | VInt _ ->
             (if rng_hi_open hi || (match hi with VNil -> true | _ -> false) then VFlt (1.0 / 0.0)
              else rng_int_span (rng_int_side lo) (rng_int_top hi excl))
           | VBig _ ->
             (if rng_hi_open hi || (match hi with VNil -> true | _ -> false) then VFlt (1.0 / 0.0)
              else rng_int_span (rng_int_side lo) (rng_int_top hi excl))
           | VFlt _ -> prim_raise "TypeError" "can't iterate from Float"
           | VStr _ -> VNil
           | VSym _ -> VNil
           // beginless: ruby 3.4 refuses, where 3.2 answered Infinity for a
           // numeric end. #size counts from the beginning and there is none,
           // so the TypeError names the class of the bound it cannot start at.
           | VNil -> prim_raise "TypeError" "can't iterate from NilClass"
           // an object range is walked by the object arm above, which has the
           // world to ask #succ; anything still arriving here cannot walk.
           | VObj _ -> VNil
           | _ -> prim_raise "TypeError" ("can't iterate from " ++ class_name lo))
        else
          // count: what an enumeration would yield, so an open range is
          // Infinity and a bound that cannot be walked raises. For integer
          // bounds ruby does NOT enumerate -- (1..2**64).count answers at
          // once -- and neither does this.
          (if rng_hi_open hi || (match lo with VNil -> true | _ -> false) then VFlt (1.0 / 0.0)
           else match lo with
           | VInt _ -> rng_int_span (rng_int_side lo) (rng_int_top hi excl)
           | VBig _ -> rng_int_span (rng_int_side lo) (rng_int_top hi excl)
           | VStr _ -> (match hi with
                        | VStr _ -> VInt (val_list_len (range_vals_raw lo hi excl))
                        | _ -> prim_raise "TypeError" "can't iterate from String")
           | _ -> prim_raise "TypeError" ("can't iterate from " ++ class_name lo)))
     | _ -> VNil)
  else if str_eq name "size" || str_eq name "length" then
    (match recv with
     | VArr id -> VInt (val_list_len (deref id))
     | VStr sh0 -> VInt (str_rblen sh0)
     | VSym s -> VInt (utf8_len s)
     | VHsh xs -> let xs = hderef xs in VInt (hash_len xs) | _ -> prim_raise "NoMethodError" ("undefined method '" ++ name ++ "' for " ++ for_recv_name recv))
  else if str_eq name "empty?" then
    (match recv with
     | VArr id -> VBool (val_list_len (deref id) == 0) | VStr s -> let s = sget s in VBool (str_len s == 0)
     | VHsh xs -> let xs = hderef xs in VBool (hash_len xs == 0) | _ -> prim_raise "NoMethodError" ("undefined method 'empty?' for " ++ for_recv_name recv))
  else if str_eq name "[]" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       (match args with
        | Cons (VInt i, Cons (VInt len, _)) -> arr_slice xs i len
        // an argument that is not an index and cannot become one is a
        // TypeError, not nil: `[1,2,3][Object.new]` answered nil, which reads
        // as "no element there" rather than "that is not a subscript"
        // ruby words the nil case differently from every other type
        // ("from nil to integer", lower case), so it cannot share the sentence.
        | Cons (VNil, _) -> prim_raise "TypeError" "no implicit conversion from nil to integer"
        | Cons (VObj _, _) | Cons (VSym _, _) ->
          prim_raise "TypeError"
            ("no implicit conversion of "
             ++ (match args with Cons (a0, _) -> class_name a0 | _ -> "Object")
             ++ " into Integer")
        | Cons (VRange (lov, hiv, excl), _) ->
          // a[m..n]: nil if start is past the end; [] if start == size or the
          // range is empty; otherwise the slice with the end index clamped.
          // A missing bound means the array's own end, so `a[1..]` works.
          (let n = val_list_len xs in
           let (st, enx) = rng_slice_bounds lov hiv excl n in
           if st < 0 || st > n then VNil
           else
             let en = if enx > n then n else enx in
             let len = if en - st < 0 then 0 else en - st in
             arr_new (vtake (vdrop xs st) len))
        | Cons (VInt i, _) -> val_nth xs (if i < 0 then val_list_len xs + i else i)
        | _ -> VNil)
     | VStr sid ->
       // ASCII-8BIT (binary) strings index by BYTE; text strings by codepoint.
       let ascii8 = str_eq (senc_get sid) "ASCII-8BIT" in
       let s = sget sid in let n = utf8_len s in
       (match args with
        // s[i, len]: substring of length len from i (negative i counts back).
        // Byte-indexed for binary, codepoint-indexed otherwise.
        | Cons (VInt i, Cons (VInt len, _)) ->
          if ascii8 then
            (let bn = str_len s in
             let st = if i < 0 then bn + i else i in
             if st < 0 || st > bn || len < 0 then VNil
             else let en = if st + len > bn then bn else st + len in
                  (match mkstr (substring s st en) with VStr rid -> let _ = senc_set rid "ASCII-8BIT" in VStr rid | r -> r))
          else
            (let st = if i < 0 then n + i else i in
             if st < 0 || st > n || len < 0 then VNil
             else let en = if st + len > n then n else st + len in mkstr (utf8_substr s st (en - st)))
        // s[/re/] -> whole match; s[/re/, g] -> capture group g (nil if none).
        | Cons (VRegex (pat, pf, _), rest) ->
          (match rxv_search pat pf s 0 with
           | RBadPat ->
             (let _ = rx_clear_caps 1 in
              let st = rx_find_start pat s 0 in
              if st < 0 then VNil
              else
                let en = (let e = rxe_alts pat (rxe_start pat) s st in if e < 0 then st else e) in
                (match rest with
                 | Cons (VInt g, _) ->
                   if g == 0 then mkstr (substring s st en)
                   else (let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
                         if map_has rx_caps ks && map_has rx_caps ke then mkstr (substring s (map_get rx_caps ks) (map_get rx_caps ke)) else VNil)
                 | _ -> mkstr (substring s st en)))
           | RNoHit -> VNil
           | RHit (st, en, saves) ->
             let _ = rxv_export_caps saves (rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ pat))) in
             (match rest with
              | Cons (VInt g, _) ->
                if g == 0 then mkstr (substring s st en)
                else (let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
                      if map_has rx_caps ks && map_has rx_caps ke then mkstr (substring s (map_get rx_caps ks) (map_get rx_caps ke)) else VNil)
              | _ -> mkstr (substring s st en)))
        // s[lo..hi] / s[lo...hi]: codepoint substring over the (clamped) range.
        | Cons (VRange (lov, hiv, excl), _) ->
          (let (st, enx) = rng_slice_bounds lov hiv excl n in
           let en = if enx > n then n else enx in
           if st < 0 || st > n then VNil
           else mkstr (utf8_substr s st ((if en < st then st else en) - st)))
        // s[i]: the one-character (codepoint) string at i, or nil out of range.
        | Cons (VInt i, _) ->
          let j = if i < 0 then n + i else i in
          if j >= 0 && j < n then mkstr (utf8_char s j) else VNil
        // s["sub"]: the substring itself if present, else nil.
        | Cons (VStr sub, _) -> let sub = sget sub in if str_contains s sub then mkstr sub else VNil
        // A Float index is truncated toward zero, the way Ruby does it -- but
        // Inf and NaN are not indices at all and are a RangeError there. This
        // arm and the one below used to be a single `VNil`: every argument that
        // was not an Integer, a Range, a Regexp or a String came back as nil, so
        // `"abc"[Object.new]` was a value rather than the TypeError it is in
        // Ruby. Found by the bootstraptest pair that walked into it.
        | Cons (VFlt f, rest) ->
          (if flt_is_nan f then prim_raise "RangeError" "float NaN out of range of integer"
           else if flt_is_inf f then
             prim_raise "RangeError" ("float " ++ (if f > 0.0 then "Inf" else "-Inf")
                                      ++ " out of range of integer")
           else prim_method recv name (Cons (VInt (int_of_float f), rest)))
        // A number too big for an index is an Integer, so it is not a
        // conversion problem: Ruby calls it a RangeError.
        | Cons (VBig _, _) ->
          prim_raise "RangeError" "bignum too big to convert into 'long'"
        | Cons (other, _) ->
          prim_raise "TypeError"
            (match other with
             | VNil -> "no implicit conversion from nil to integer"
             | _ -> "no implicit conversion of " ++ class_name other ++ " into Integer")
        | _ -> VNil)
     | VHsh hid -> let xs = hderef hid in let ci = hcbi_on hid in (match args with Cons (k, _) -> if hash_haskey_x ci xs k then hash_get_x ci xs k else hdflt_get hid | _ -> VNil)
     // Integer#[i]: bit i of the number (0 for out-of-range high bits).
     // `n[i, len]` and `n[i..j]` take a RUN of bits, low bit first: the bits
     // are shifted down to zero and masked, so 255[0, 4] is 15.
     | VInt n ->
       (match args with
        | Cons (VInt i, Cons (VInt len, _)) ->
          (if i < 0 || len <= 0 then VInt 0
           else VInt (int_bitop "&" (int_shr_arith n i) (int_pow 2 len - 1)))
        | Cons (VRange (lov, hiv, excl), _) ->
          (let i = (match lov with VInt a -> a | _ -> 0) in
           if i < 0 then VInt 0
           else (match hiv with
                 | VInt hi -> (let len = (if excl then hi - i else hi - i + 1) in
                               if len <= 0 then VInt 0
                               else VInt (int_bitop "&" (int_shr_arith n i) (int_pow 2 len - 1)))
                 | _ -> VInt (int_shr_arith n i)))
        | Cons (VInt i, _) -> (if i < 0 then VInt 0 else VInt (int_bitop "&" (int_shr_arith n i) 1))
        | _ -> VNil)
     // ...and a BIGNUM has bits too. This arm did not exist, so `(2**70)[0]`
     // was a NoMethodError for a method every Integer answers.
     | VBig b ->
       (match args with
        | Cons (VInt i, _) -> (if i < 0 then VInt 0 else VInt (big_bit_at b i))
        | _ -> VNil)
     | _ -> prim_raise "NoMethodError" ("undefined method '[]' for " ++ for_recv_name recv))
  // Integer
  // ⚠ the gcd is a MAGNITUDE, and the magnitude of the machine minimum does
  //   not fit a machine int: `(-9223372036854775808).gcd(-9223372036854775808)`
  //   negated in place and answered the minimum again, with the wrong sign.
  else if (str_eq name "gcd" || str_eq name "lcm" || str_eq name "gcdlcm")
          && ((match recv with VInt a7 -> int_neg_overflows a7 | _ -> false)
              || (match args with Cons (VInt b7, _) -> int_neg_overflows b7 | _ -> false)) then
    (let a9 = big_mag (num_dec recv) in
     let b9 = big_mag (num_dec (match args with Cons (b, _) -> b | Nil -> VInt 0)) in
     let g9 = big_gcd_s a9 b9 in
     if str_eq name "gcd" then norm_big g9
     else if str_eq name "lcm" then norm_big (big_mul_s (big_div_s a9 g9) b9)
     else arr_new (Cons (norm_big g9, Cons (norm_big (big_mul_s (big_div_s a9 g9) b9), Nil))))
  else if str_eq name "gcd" then (match recv with VInt a -> (match args with Cons (VInt b, _) -> VInt (int_gcd a b) | Cons (VBig b, _) -> norm_big (big_gcd_s (big_mag (str_of_int a)) (big_mag b)) | _ -> VInt a)
     | VBig a -> (match args with Cons (b, _) -> norm_big (big_gcd_s (big_mag a) (big_mag (num_dec b))) | _ -> norm_big (big_mag a)) | _ -> (let _ = map_set prim_missing "n" (mkstr "gcd") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'gcd'")) in fail "mere-ruby: undefined method 'gcd'")))
  else if str_eq name "lcm" then
    (match recv with VInt a -> (match args with Cons (VInt b, _) -> (let g = int_gcd a b in let l = (a / g) * b in VInt (if l < 0 then 0 - l else l)) | Cons (VBig b, _) -> (let g = big_gcd_s (big_mag (str_of_int a)) (big_mag b) in norm_big (big_mul_s (big_div_s (big_mag (str_of_int a)) g) (big_mag b))) | _ -> VInt a)
     | VBig a -> (match args with Cons (b, _) -> (let bm = big_mag (num_dec b) in let g = big_gcd_s (big_mag a) bm in norm_big (big_mul_s (big_div_s (big_mag a) g) bm)) | _ -> norm_big (big_mag a)) | _ -> (let _ = map_set prim_missing "n" (mkstr "lcm") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'lcm'")) in fail "mere-ruby: undefined method 'lcm'")))
  else if str_eq name "gcdlcm" then
    // ...for a BIGNUM on either side too: this arm took two machine ints and
    // reported the method undefined for anything else, so `(10**20).gcdlcm(35)`
    // was a NoMethodError for a method #gcd and #lcm both answer.
    (if (match recv with VBig _ -> true | _ -> false)
        || (match args with Cons (VBig _, _) -> true | _ -> false) then
       (let a9 = big_mag (num_dec recv) in
        let b9 = big_mag (num_dec (match args with Cons (b, _) -> b | Nil -> VInt 0)) in
        let g9 = big_gcd_s a9 b9 in
        arr_new (Cons (norm_big g9, Cons (norm_big (big_mul_s (big_div_s a9 g9) b9), Nil))))
     else
     match recv with VInt a -> (match args with Cons (VInt b, _) -> (let g = int_gcd a b in let l = (a / g) * b in arr_new (Cons (VInt g, Cons (VInt (if l < 0 then 0 - l else l), Nil)))) | _ -> VNil) | _ -> (let _ = map_set prim_missing "n" (mkstr "gcdlcm") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'gcdlcm'")) in fail "mere-ruby: undefined method 'gcdlcm'")))
  else if str_eq name "digits" then
    // The RADIX and the sign are checked first. Dividing by 1 never reaches
    // zero, so `12345.digits(1)` recursed until the stack went -- and a
    // negative radix or a negative receiver quietly produced a list of
    // negative digits instead of refusing.
    (let radix_guard = fn (b: Val) ->
       (match b with
        | VInt bi -> (if bi < 0 then (let _ = prim_raise "ArgumentError" "negative radix" in ())
                      else if bi < 2 then (let _ = prim_raise "ArgumentError" ("invalid radix " ++ str_of_int bi) in ())
                      else ())
        | VBig _ -> ()
        | VNil -> (let _ = prim_raise "TypeError" "no implicit conversion of nil into Integer" in ())
        | _ -> ()) in
     let neg_guard = fn (isneg: bool) ->
       (if isneg then (let _ = prim_raise "Math::DomainError" "out of domain" in ()) else ()) in
     match recv with
     | VInt n ->
       (let _ = neg_guard (n < 0) in
        match args with Cons (b, _) -> (let _ = radix_guard b in (match b with VInt base -> arr_new (int_digits n base) | VBig bs -> arr_new (big_digits_go (str_of_int n) bs) | _ -> arr_new (int_digits n 10))) | _ -> arr_new (int_digits n 10))
     | VBig b ->
       (let _ = neg_guard (big_sign b < 0) in
        match args with Cons (bs, _) -> (let _ = radix_guard bs in arr_new (big_digits_go (big_mag b) (num_dec bs))) | _ -> arr_new (big_digits_go (big_mag b) "10"))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "digits") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'digits'")) in fail "mere-ruby: undefined method 'digits'")))
  else if str_eq name "bit_length" then (match recv with VInt n -> VInt (int_bit_length (if n < 0 then 0 - n - 1 else n)) | VBig b -> VInt (big_bit_length b) | _ -> (let _ = map_set prim_missing "n" (mkstr "bit_length") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'bit_length'")) in fail "mere-ruby: undefined method 'bit_length'")))
  else if str_eq name "divmod" then
    (match recv with
     | VInt a -> (match args with Cons (VInt b, _) -> arr_new (Cons (VInt (floor_div a b), Cons (VInt (floor_mod a b), Nil))) | Cons (VBig b, _) -> arr_new (Cons (norm_big (big_div_s (str_of_int a) b), Cons (norm_big (big_mod_s (str_of_int a) b), Nil))) | Cons (VFlt b, _) -> (match flt_divmod_pair (float_of_int a) b with (d9, m9) -> arr_new (Cons (VInt (flt_floor d9), Cons (VFlt m9, Nil)))) | Cons (VRat (_, _), _) -> rat_divmod_pair recv (match args with Cons (b9, _) -> b9 | Nil -> VInt 1) | _ -> VNil)
     // ⚠ only an INTEGER divisor was read here: num_dec answers "0" for every
     //   other kind, so `(2**64).divmod(3.5)` divided by zero. A Float divisor
     //   makes it float arithmetic; a Rational one stays exact.
     | VBig a ->
       (match args with
        | Cons (VFlt y9, _) ->
          (match flt_divmod_pair (big_fdiv_s a "1") y9 with
           (d9, m9) -> arr_new (Cons (flt_floor_v d9, Cons (VFlt m9, Nil))))
        | Cons (VRat (_, _), _) -> (match args with Cons (b9, _) -> rat_divmod_pair recv b9 | _ -> VNil)
        | Cons (b, _) -> let bd = num_dec b in arr_new (Cons (norm_big (big_div_s a bd), Cons (norm_big (big_mod_s a bd), Nil)))
        | _ -> VNil)
     // Float#divmod: quotient floored to an Integer, remainder a Float.
     | VFlt a -> (match args with Cons (b, _) -> (match flt_divmod_pair a (to_f b) with (d9, m9) -> arr_new (Cons (flt_floor_v d9, Cons (VFlt m9, Nil)))) | _ -> VNil)
     // Rational#divmod: the quotient is the FLOOR of the exact division and
     // the remainder is what the quotient leaves. An INTEGER receiver with a
     // Rational divisor is the same arithmetic -- it had no arm at all and
     // answered nil -- so both ask one helper.
     | VRat (rn, rd) ->
       (match args with
        | Cons (b, _) -> rat_divmod_pair recv b
        | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "divmod") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'divmod'")) in fail "mere-ruby: undefined method 'divmod'")))
  else if str_eq name "fdiv" then
    // ...and an argument that is not a number is refused in the receiver's
    // own words: `to_f` on it was an internal failure ("not a number").
    (if (match args with
         | Cons (a9, _) -> (match a9 with VObj _ -> true | _ -> (if is_num a9 || is_cpx a9 then false else true))
         | Nil -> false)
     then prim_raise "TypeError" (conv_name (match args with Cons (a9, _) -> a9 | Nil -> VNil)
                                  ++ " can't be coerced into " ++ cmp_type_name recv)
     // a COMPLEX divisor divides a real too: `1.0.fdiv(Complex(1, 2))` is a
     // Complex in ruby, and refusing it read the value's kind as its fitness.
     else if (match args with Cons (a9, _) -> is_cpx a9 | Nil -> false)
     then (match args with
           | Cons (b9, _) -> cpx_arith "/" (VCpx (recv, VInt 0)) b9
           | Nil -> VNil)
     else
     match recv with
     | VCpx (r, i) -> (match args with Cons (b, _) -> VCpx (VFlt (to_f r / to_f b), VFlt (to_f i / to_f b)) | _ -> VNil)
     | VInt a -> (match args with Cons (b, _) -> VFlt (to_f (VInt a) / to_f b) | _ -> VNil)
     | VFlt a -> (match args with Cons (b, _) -> VFlt (a / to_f b) | _ -> VNil)
     // Rational and Bignum divide as floats like every other Numeric does
     | VRat (_, _) -> (match args with Cons (b, _) -> VFlt (to_f recv / to_f b) | _ -> VNil)
     | VBig _ -> (match args with Cons (b, _) -> VFlt (to_f recv / to_f b) | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "fdiv") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'fdiv'")) in fail "mere-ruby: undefined method 'fdiv'")))
  // ⚠ pow's second argument is a MODULUS and has to be an integer. A
  // non-integer did not refuse: it fell past the `Cons (VInt e, Cons (VInt m, _))`
  // pattern into the one-argument arm, so `2.pow(3, "x")` answered 8 -- the
  // power with the modulus silently dropped. Refusing is the whole difference
  // between "cannot do that" and "did something else".
  else if str_eq name "pow" && is_num recv
          && (match args with
              | Cons (_, Cons (m9, _)) -> (match m9 with VInt _ -> false | VBig _ -> false | _ -> true)
              | _ -> false) then
    prim_raise "TypeError" "Integer#pow() 2nd argument not allowed unless all arguments are integers"
  // ...and the modular form has no answer for a negative exponent: there is no
  // integer reciprocal to reduce. `2.pow(-5)` is the exact Rational 1/32, so
  // the refusal is about the PAIR of arguments, not about the exponent alone.
  else if str_eq name "pow" && is_num recv
          && (match args with
              | Cons (e9, Cons (_, _)) -> num_isneg e9
              | _ -> false) then
    prim_raise "RangeError" "Integer#pow() 1st argument cannot be negative when 2nd argument specified"
  else if str_eq name "pow" then
    // ⚠ a one-argument pow IS `**`, whatever kind of number the exponent is:
    //   `1.pow(1.5)` is 1.0 and `1.pow(2r)` is (1/1). Matching only VInt made
    //   every other exponent fall to the catch-all, which answered the
    //   RECEIVER -- so pow(1.5) was 1, an Integer, and looked like a result.
    (match recv with VInt b -> (match args with Cons (VInt e, Cons (VInt m, _)) -> VInt (int_pow_mod b e m) | Cons (e, Nil) -> arith_bin "**" recv e | _ -> VInt b)
     // a bignum base: the exact power, and the modular form through the same
     // big arithmetic rather than a machine int that would overflow.
     | VBig b -> (match args with
                  | Cons (VInt e, Cons (m, _)) -> norm_big (big_mod_s (big_pow b e "1") (num_dec m))
                  | Cons (VInt e, _) -> norm_big (big_pow b e "1")
                  | _ -> VBig b) | _ -> (let _ = map_set prim_missing "n" (mkstr "pow") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'pow'")) in fail "mere-ruby: undefined method 'pow'")))
  else if str_eq name "even?" then (match recv with VInt n -> VBool (floor_mod n 2 == 0) | VBig b -> VBool (big_even b) | _ -> (let _ = map_set prim_missing "n" (mkstr "even?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'even?'")) in fail "mere-ruby: undefined method 'even?'")))
  else if str_eq name "odd?" then (match recv with VInt n -> VBool (floor_mod n 2 != 0) | VBig b -> VBool (if big_even b then false else true) | _ -> (let _ = map_set prim_missing "n" (mkstr "odd?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'odd?'")) in fail "mere-ruby: undefined method 'odd?'")))
  // Integer#allbits?/anybits?/nobits?(mask): bit-mask predicates.
  else if str_eq name "allbits?" || str_eq name "anybits?" || str_eq name "nobits?" then
    (match args with
     | Cons (m, _) ->
       (let masked = arith_bin "&" recv m in
        if str_eq name "allbits?" then VBool (rb_eq masked m)
        else if str_eq name "anybits?" then VBool (if rb_eq masked (VInt 0) then false else true)
        else VBool (rb_eq masked (VInt 0)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "bit predicate") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'bit predicate'")) in fail "mere-ruby: undefined method 'bit predicate'")))
  // Integer#coerce(other): [other, self]. Both become Float if either is a
  // Float, else both stay Integer. (A non-numeric arg is a TypeError; raised
  // by the world-aware dispatch layer, so here it just fails.)
  else if str_eq name "coerce" then
    (match args with
     | Cons (o, _) ->
       (match recv with
        | VInt _ -> (if (match o with VFlt _ -> true | _ -> false)
                     then arr_new (Cons (o, Cons (VFlt (to_f recv), Nil)))
                     else if is_num o then arr_new (Cons (o, Cons (recv, Nil)))
                     else if (match o with VStr _ -> true | _ -> false)
                     then (match o with VStr h9 -> coerce_str recv h9 | _ -> VNil)
                     // ruby coerces through Float(), so a String that is not a
                     // number is an ArgumentError and anything else a TypeError
                     else coerce_refuse o)
        // Float#coerce answers two Floats: `2.5.coerce(1)` is [1.0, 2.5], not
        // [1, 2.5] -- the point of coercing is that both sides end up alike.
        | VFlt _ -> (if is_num o then arr_new (Cons (VFlt (to_f o), Cons (recv, Nil)))
                     else if (match o with VStr _ -> true | _ -> false)
                     then (match o with VStr h9 -> coerce_str recv h9 | _ -> VNil)
                     // ruby coerces through Float(), so a String that is not a
                     // number is an ArgumentError and anything else a TypeError
                     else coerce_refuse o)
        // Complex#coerce answers two COMPLEXES: the point of coercing is that
        // both sides end up alike, and handing back a bare Integer breaks the
        // contract every caller of the protocol relies on (`[3, (1+2i)]` where
        // ruby says `[(3+0i), (1+2i)]`). The other side keeps its own class
        // inside the complex: 3 becomes (3+0i) and 3.5 becomes (3.5+0i).
        | VCpx (_, _) ->
          (if is_num o || is_cpx o
           then arr_new (Cons ((match o with VCpx (_, _) -> o | _ -> VCpx (o, VInt 0)), Cons (recv, Nil)))
           // ...and it refuses in the RECEIVER's terms: a Complex does not
           // coerce through Float(), so the message names Complex and not the
           // unparsable string Float() was handed.
           else prim_raise "TypeError" (conv_name o ++ " can't be coerced into Complex"))
        | _ -> arr_new (Cons (o, Cons (recv, Nil))))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "coerce") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'coerce'")) in fail "mere-ruby: undefined method 'coerce'")))
  else if str_eq name "zero?" then (match recv with VInt n -> VBool (n == 0) | VFlt f -> VBool (f == 0.0) | VBig s -> VBool (str_eq s "0")
     | VRat (rn, rd) -> VBool (str_eq rn "0")
     // a Complex is zero when BOTH parts are
     | VCpx (cre, cim) -> VBool (rb_eq cre (VInt 0) && rb_eq cim (VInt 0))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "zero?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'zero?'")) in fail "mere-ruby: undefined method 'zero?'")))
  // Numeric#integer?. `is_num_method` has claimed this name all along with no
  // branch behind it, so `respond_to?(:integer?)` said true and the call
  // raised. A name list is a claim, not an implementation -- three of the
  // names it asserted (integer?, to_c, rationalize) had nothing behind them.
  // Numeric#to_c: the same value with a zero imaginary part. Complex() itself
  // has worked all along -- this name was in the list with nothing behind it.
  else if str_eq name "to_c" then
    (match recv with
     | VCpx (r, i) -> recv
     | VInt _ -> VCpx (recv, VInt 0) | VBig _ -> VCpx (recv, VInt 0)
     | VFlt _ -> VCpx (recv, VInt 0) | VRat _ -> VCpx (recv, VInt 0)
     // nil answers the same three conversions Integer does: (0+0i), (0/1), 0.
     | VNil -> VCpx (VInt 0, VInt 0)
     | VStr h ->
       (let e = enc_canon_name (senc_get h) in
        if enc_ascii_compat e then rb_str_to_c (sget h)
        else prim_raise "Encoding::CompatibilityError" ("ASCII incompatible encoding: " ++ e))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "to_c") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_c'")) in fail "mere-ruby: undefined method 'to_c'")))
  else if str_eq name "integer?" then
    (match recv with
     | VInt _ -> VBool true | VBig _ -> VBool true
     // a Complex is never an integer, not even Complex(2, 0) -- the question is
     // about the CLASS, not the value (ruby: Complex(2,0).integer? is false)
     | VCpx _ -> VBool false
     | VFlt _ -> VBool false | VRat _ -> VBool false
     | _ -> (let _ = map_set prim_missing "n" (mkstr "integer?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'integer?'")) in fail "mere-ruby: undefined method 'integer?'")))
  // Numeric#nonzero?: self, or nil when it IS zero — the idiom behind
  // `(a <=> b).nonzero? || ...` in a multi-key comparator.
  else if str_eq name "nonzero?" then
    (match recv with
     | VInt n -> (if n == 0 then VNil else recv)
     | VFlt f -> (if f == 0.0 then VNil else recv)
     | VBig s2 -> (if str_eq s2 "0" then VNil else recv)
     | VRat (n, d) -> (if big_sign n == 0 then VNil else recv)
     | VCpx (cre, cim) -> (if rb_eq cre (VInt 0) && rb_eq cim (VInt 0) then VNil else recv)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "nonzero?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'nonzero?'")) in fail "mere-ruby: undefined method 'nonzero?'")))
  else if str_eq name "positive?" then (match recv with VInt n -> VBool (n > 0) | VFlt f -> VBool (f > 0.0) | VBig s -> VBool (cmp_vals recv (VInt 0) > 0) | VRat (n, d) -> VBool (big_sign n > 0) | _ -> (let _ = map_set prim_missing "n" (mkstr "positive?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'positive?'")) in fail "mere-ruby: undefined method 'positive?'")))
  else if str_eq name "negative?" then (match recv with VInt n -> VBool (n < 0) | VFlt f -> VBool (f < 0.0) | VBig s -> VBool (cmp_vals recv (VInt 0) < 0) | VRat (n, d) -> VBool (big_sign n < 0) | _ -> (let _ = map_set prim_missing "n" (mkstr "negative?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'negative?'")) in fail "mere-ruby: undefined method 'negative?'")))
  else if str_eq name "succ" || str_eq name "next" then (match recv with VInt n -> VInt (n + 1) | VBig b -> norm_big (big_add_s b "1") | VStr s -> mkstr (str_succ (sget s)) | _ -> (let _ = map_set prim_missing "n" (mkstr "succ") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'succ'")) in fail "mere-ruby: undefined method 'succ'")))
  // Integer#ceildiv(other): the division rounded UP, which is the floor of the
  // negated numerator negated back (7.ceildiv(2) is 4, -7.ceildiv(2) is -3).
  else if str_eq name "ceildiv" then
    (match args with
     | Cons (b9, _) ->
       (match recv with
        | VInt a9 -> (match b9 with
                      | VInt c9 -> VInt (0 - floor_div (0 - a9) c9)
                      | _ -> arith_bin "-" (VInt 0) (arith_bin "/" (arith_bin "-" (VInt 0) recv) b9))
        | _ -> arith_bin "-" (VInt 0) (arith_bin "/" (arith_bin "-" (VInt 0) recv) b9))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "ceildiv") in VNil))
  else if str_eq name "pred" then (match recv with VInt n -> VInt (n - 1) | VBig b -> norm_big (big_sub_s b "1") | _ -> (let _ = map_set prim_missing "n" (mkstr "pred") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'pred'")) in fail "mere-ruby: undefined method 'pred'")))
  else if str_eq name "abs" || str_eq name "magnitude" then
    (match recv with
     // ...and the magnitude of the machine minimum does not fit a machine int.
     | VInt n -> (if n < 0 then num_neg (VInt n) else VInt n)
     // -0.0 is negative BY ITS SIGN BIT, and `f < 0.0` is false for it, so
     // `(-0.0).abs` answered -0.0 -- a magnitude that prints with a minus.
     | VFlt f -> VFlt (if f < 0.0 || (if f == 0.0 then 1.0 / f < 0.0 else false) then 0.0 - f else f)
     | VBig b -> num_abs recv
     | VRat (n, d) -> num_abs recv
     | VCpx (r, i) ->
       // an axis-aligned complex keeps the component's exactness (CRuby
       // special-cases both axes); otherwise the float hypotenuse.
       (if rb_eq i (VInt 0) then num_abs r
        else if rb_eq r (VInt 0) then num_abs i
        else VFlt (sqrt (to_f (cpx_comp "+" (cpx_comp "*" r r) (cpx_comp "*" i i)))))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "abs") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'abs'")) in fail "mere-ruby: undefined method 'abs'")))
  else if str_eq name "next_float" then
    (match recv with VFlt f -> VFlt (flt_next f)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "next_float") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'next_float'")) in fail "mere-ruby: undefined method 'next_float'")))
  else if str_eq name "prev_float" then
    (match recv with VFlt f -> VFlt (flt_prev f)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "prev_float") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'prev_float'")) in fail "mere-ruby: undefined method 'prev_float'")))
  else if str_eq name "object_id" || str_eq name "__id__" then
    (match recv with
     | VInt n -> VInt (2 * n + 1)
     | VNil -> VInt 8
     | VBool b -> VInt (if b then 20 else 0)
     | VSym sy -> VInt (sym_id_of sy)
     | VObj id -> VInt (1000000 + id * 8)
     | VStr id -> VInt (2000000 + id * 8)
     | VArr id -> VInt (3000000 + id * 8)
     | VHsh id -> VInt (4000000 + id * 8)
     | VProc id -> VInt (5000000 + id * 8)
     | VFlt f -> VInt (7000000 + int_of_float (f * 1000.0))
     | _ -> VInt 0)
  // #nan? / #next_float / #prev_float belong to Float alone: an Integer
  // answering false (or a Float) for them is a name Integer does not have.
  else if str_eq name "nan?" then
    (match recv with VFlt f -> VBool (if f == f then false else true)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "nan?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'nan?'")) in fail "mere-ruby: undefined method 'nan?'")))
  // ⚠ Every numeric shape answers these, and the catch-all said `false` --
  // which for #finite? is not "unknown", it is "this number is infinite".
  // `(2**70).finite?`, `Rational(1,2).finite?` and `Complex(1,2).finite?` were
  // all false: a plain wrong answer about the most ordinary input each has.
  // A COMPLEX is finite when both parts are, and infinite when either is (with
  // no sign: ruby answers 1 for `Complex(-Float::INFINITY, 0).infinite?`).
  else if str_eq name "infinite?" then
    (match recv with
     | VFlt f -> (if flt_is_nan f then VNil else if flt_is_inf f then VInt (if f > 0.0 then 1 else 0 - 1) else VNil)
     | VCpx (cr, ci) -> (if num_part_inf cr || num_part_inf ci then VInt 1 else VNil)
     | _ -> VNil)
  else if str_eq name "finite?" then
    (match recv with
     | VFlt f -> VBool (if flt_is_nan f then false else if flt_is_inf f then false else true)
     | VInt _ -> VBool true
     | VBig _ -> VBool true
     | VRat (_, _) -> VBool true
     | VCpx (cr, ci) -> VBool (num_part_finite cr && num_part_finite ci)
     | _ -> VBool false)
  else if str_eq name "floor" then
    (match recv with
     | VInt n -> (match args with Cons (VInt d, _) -> if d >= 0 then VInt n else (let m = int_pow 10 (0 - d) in VInt (floor_div n m * m)) | _ -> VInt n)
     // ⚠ a NEGATIVE precision rounds to that power of ten, and `d <= 0`
     //   dropped it: 12345.678.floor(-2) answered 12345, not 12300. floor of
     //   the integer part, then floor to the place, is the same as flooring
     //   the quotient -- so the Integer arm above can finish the job.
     | VFlt f -> (match args with
                  | Cons (VInt d, _) ->
                    (if d < 0 then prim_method (flt_floor_v f) "floor" args
                     else if d == 0 then flt_floor_v f
                     else (let m = float_of_int (int_pow 10 d) in VFlt (float_of_int (flt_floor (f * m)) / m)))
                  | _ -> flt_floor_v f)
     // Rational: the rounding family over the exact fraction. Precision 0
     // (or absent) answers an Integer, a positive precision a Rational.
     | VRat (rn, rd) -> (match args with Cons (VInt p, _) -> rat_round_prec "floor" rn rd p | _ -> norm_big (rat_int_mode "floor" rn rd))
     // an Integer rounds to ITSELF at precision >= 0; a negative precision
     // rounds to that power of ten, exactly (the machine-int arm above cannot
     // hold a bignum's).
     | VBig b -> (match args with
                  | Cons (VInt d, _) ->
                    (if d >= 0 then VBig b
                     else (let m9 = big_pow "10" (0 - d) "1" in
                           norm_big (big_mul_s (rat_int_mode "floor" b m9) m9)))
                  | _ -> VBig b)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "floor") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'floor'")) in fail "mere-ruby: undefined method 'floor'")))
  else if str_eq name "ceil" then
    (match recv with
     | VInt n -> (match args with Cons (VInt d, _) -> if d >= 0 then VInt n else (let m = int_pow 10 (0 - d) in VInt (0 - (floor_div (0 - n) m) * m)) | _ -> VInt n)
     | VFlt f -> (match args with
                  | Cons (VInt d, _) ->
                    (if d < 0 then prim_method (flt_ceil_v f) "ceil" args
                     else if d == 0 then flt_ceil_v f
                     else (let m = float_of_int (int_pow 10 d) in VFlt (float_of_int (flt_ceil (f * m)) / m)))
                  | _ -> flt_ceil_v f)
     // Rational: the rounding family over the exact fraction. Precision 0
     // (or absent) answers an Integer, a positive precision a Rational.
     | VRat (rn, rd) -> (match args with Cons (VInt p, _) -> rat_round_prec "ceil" rn rd p | _ -> norm_big (rat_int_mode "ceil" rn rd))
     // an Integer rounds to ITSELF at precision >= 0; a negative precision
     // rounds to that power of ten, exactly (the machine-int arm above cannot
     // hold a bignum's).
     | VBig b -> (match args with
                  | Cons (VInt d, _) ->
                    (if d >= 0 then VBig b
                     else (let m9 = big_pow "10" (0 - d) "1" in
                           norm_big (big_mul_s (rat_int_mode "ceil" b m9) m9)))
                  | _ -> VBig b)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "ceil") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'ceil'")) in fail "mere-ruby: undefined method 'ceil'")))
  // ⚠ ndigits has to FIT: ruby refuses a precision beyond a signed int rather
  // than rounding to it, and refuses a float that is not a number at all. These
  // fell through to "an Integer rounds to itself", so `42.round(1<<31)` and
  // `42.round(Float::INFINITY)` answered 42 -- an answer to a question ruby
  // says cannot be asked. Three refusals, because ruby words them differently.
  else if str_eq name "round" && is_num recv
          && (match args with
              | Cons (VBig _, _) -> true
              | Cons (VFlt f9, _) -> flt_is_nan f9 || flt_is_inf f9
              | Cons (VInt d9, _) -> d9 > 2147483647 || d9 < 0 - 2147483648
              // ...and a precision that is not a NUMBER at all is refused the
              // way every other converted argument is. It used to fall past the
              // `Cons (VInt d, _)` pattern into the no-argument arm, so
              // `2.round("x")` answered 2 -- the receiver, rounded to a
              // precision ruby will not read.
              | Cons (a9, _) -> (if is_num a9 then false else true)
              | _ -> false) then
    (match args with
     | Cons (VBig _, _) -> prim_raise "RangeError" "bignum too big to convert into 'long'"
     | Cons (VFlt f9, _) ->
       (if flt_is_nan f9 then prim_raise "RangeError" "float NaN out of range of integer"
        else prim_raise "RangeError"
               ("float " ++ (if f9 > 0.0 then "Inf" else "-Inf") ++ " out of range of integer"))
     | Cons (VInt d9, _) ->
       prim_raise "RangeError" ("integer " ++ str_of_int d9 ++ " too big to convert to 'int'")
     | Cons (a9, _) ->
       prim_raise "TypeError" ("no implicit conversion of " ++ class_name a9 ++ " into Integer")
     | _ -> VNil)
  else if str_eq name "round" then
    (match recv with
     | VInt n -> (match args with Cons (VInt d, _) -> if d >= 0 then VInt n else VInt (int_round_place n (int_pow 10 (0 - d))) | _ -> VInt n)
     // ⚠ round does NOT decompose the way floor and ceil do: rounding to an
     //   integer first and then to the place DOUBLE-ROUNDS (12349.6 would go
     //   12350 -> 12400 where ruby answers 12300), so a negative precision
     //   scales the float itself. A float that is already whole has no
     //   fraction to round twice, and takes the exact integer path.
     | VFlt f -> (match args with
                  | Cons (VInt d, _) ->
                    (if d < 0 then
                       (if flt_is_big_whole f then prim_method (flt_round_v f) "round" args
                        else (let mi = int_pow 10 (0 - d) in
                              VInt (flt_round (f / float_of_int mi) * mi)))
                     else if d == 0 then flt_round_v f
                     else (let m = float_of_int (int_pow 10 d) in VFlt (float_of_int (flt_round (f * m)) / m)))
                  | _ -> flt_round_v f)
     // Rational: the rounding family over the exact fraction. Precision 0
     // (or absent) answers an Integer, a positive precision a Rational.
     | VRat (rn, rd) -> (match args with Cons (VInt p, _) -> rat_round_prec "round" rn rd p | _ -> norm_big (rat_int_mode "round" rn rd))
     // an Integer rounds to ITSELF at precision >= 0; a negative precision
     // rounds to that power of ten, exactly (the machine-int arm above cannot
     // hold a bignum's).
     | VBig b -> (match args with
                  | Cons (VInt d, _) ->
                    (if d >= 0 then VBig b
                     else (let m9 = big_pow "10" (0 - d) "1" in
                           norm_big (big_mul_s (rat_int_mode "round" b m9) m9)))
                  | _ -> VBig b)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "round") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'round'")) in fail "mere-ruby: undefined method 'round'")))
  // ...and truncate's precision is an Integer too. `Rational(1,2).truncate("x")`
  // fell through to the no-argument form and answered 0 -- the truncation of a
  // precision ruby refuses to read.
  else if str_eq name "truncate" then
    // ⚠ a NEGATIVE precision truncates to that power of ten, TOWARD ZERO --
    //   and this arm answered the receiver unchanged, so `12345.truncate(-2)`
    //   was 12345. The Bignum arm below always did it; the machine-int one did
    //   not, which is the same rule written twice and only one of them right.
    (match recv with
     | VInt n -> (match args with
                  | Cons (VInt d, _) ->
                    (if d >= 0 then VInt n else (let m = int_pow 10 (0 - d) in VInt (n / m * m)))
                  | _ -> VInt n)
     | VFlt f -> (match args with
                  | Cons (VInt d, _) ->
                    (if d < 0 then prim_method (flt_trunc_v f) "truncate" args
                     else if d == 0 then flt_trunc_v f
                     else (let m = float_of_int (int_pow 10 d) in
                           VFlt (float_of_int (int_of_float (f * m)) / m)))
                  | _ -> flt_trunc_v f)
     | VBig b -> (match args with
                  | Cons (VInt d, _) ->
                    (if d >= 0 then VBig b
                     else (let m9 = big_pow "10" (0 - d) "1" in
                           norm_big (big_mul_s (rat_int_mode "truncate" b m9) m9)))
                  | _ -> VBig b)
     | VRat (rn, rd) -> (match args with Cons (VInt p, _) -> rat_round_prec "truncate" rn rd p | _ -> norm_big (rat_int_mode "truncate" rn rd))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "truncate") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'truncate'")) in fail "mere-ruby: undefined method 'truncate'")))
  // ⚠ numerator/denominator are the whole numeric tower's, not Rational's alone.
  //   Integer and Rational answered; Float and Complex said "undefined method".
  //   A Float's pair is its EXACT value (0.1 -> 3602879701896397/36028797018963968),
  //   which flt_rat_parts already computes for to_r.
  //   A Complex's is its parts over their common denominator.
  // ⚠ a NON-FINITE float has no exact pair, and ruby answers the float itself
  //   for #numerator (Infinity, -Infinity, NaN) and 1 for #denominator. Asking
  //   flt_rat_parts answered Int64 max over 2**62 instead -- the saturation
  //   again, wearing a different name.
  else if (str_eq name "numerator" || str_eq name "denominator")
          && (match recv with VFlt f7 -> (if (f7 - f7) == 0.0 then false else true) | _ -> false) then
    (if str_eq name "numerator" then recv else VInt 1)
  // ...and NaN has no phase either: #arg / #angle / #phase answer NaN.
  else if (str_eq name "arg" || str_eq name "angle" || str_eq name "phase")
          && (match recv with VFlt f7 -> (if f7 == f7 then false else true) | _ -> false) then
    recv
  else if str_eq name "numerator" then (match recv with VRat (n, d) -> norm_big n | VInt n -> VInt n | VBig b -> norm_big b | VFlt f -> (match mk_rat_s (match flt_rat_parts f 0 with (n, d) -> n) (match flt_rat_parts f 0 with (n, d) -> d) with VRat (n2, d2) -> norm_big n2 | v -> v) | VCpx (r, i) -> (let dn = cpx_common_den r i in VCpx (num_scale_to r dn, num_scale_to i dn)) | _ -> (let _ = map_set prim_missing "n" (mkstr "numerator") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'numerator'")) in fail "mere-ruby: undefined method 'numerator'")))
  // marshal_dump: the pair a Marshal round-trip needs. Ruby has these as
  // private methods on both classes, so a direct call is a NoMethodError in
  // ruby too and the specs reach them through `send`.
  else if str_eq name "marshal_dump" then
    (match recv with
     | VRat (n, d) -> arr_new (Cons (norm_big n, Cons (norm_big d, Nil)))
     | VCpx (r, i) -> arr_new (Cons (r, Cons (i, Nil)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "marshal_dump") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'marshal_dump'")) in fail "mere-ruby: undefined method 'marshal_dump'")))
  else if str_eq name "denominator" then (match recv with VRat (n, d) -> norm_big d | VInt n -> VInt 1 | VBig _ -> VInt 1 | VFlt f -> (match mk_rat_s (match flt_rat_parts f 0 with (n, d) -> n) (match flt_rat_parts f 0 with (n, d) -> d) with VRat (n2, d2) -> norm_big d2 | v -> VInt 1) | VCpx (r, i) -> norm_big (cpx_common_den r i) | _ -> (let _ = map_set prim_missing "n" (mkstr "denominator") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'denominator'")) in fail "mere-ruby: undefined method 'denominator'")))
  // Float#to_r is the float's EXACT value, not a rounded one: 0.1 becomes
  // 3602879701896397/36028797018963968. flt_rat_parts already computes that
  // pair for Rational(), so the branch was missing rather than the arithmetic.
  else if str_eq name "to_r" then (match recv with VRat (n, d) -> recv | VInt n -> mk_rat n 1 | VBig b -> mk_rat_s b "1" | VFlt f -> (match flt_rat_parts f 0 with (n, d) -> mk_rat_s n d) | VStr h -> rb_str_to_r (sget h) | VNil -> mk_rat_s "0" "1"
    // Complex#to_r: only a complex with an exact zero imaginary part has one.
    // It had none at all, so Rational(Complex(1,2)) could not refuse.
    | VCpx (cre, cim) ->
      // ...and a Float zero counts: `Complex(1, 0.0).to_r` is (1/1) in ruby.
      // exact_zero_val says no to 0.0, and Complex#to_f right beside this one
      // says yes -- one question, two answers, so the pair disagreed about the
      // same number.
      (if cpx_zero_im cim
       then (match cre with
             | VRat (n9, d9) -> VRat (n9, d9) | VInt n9 -> mk_rat n9 1 | VBig b9 -> mk_rat_s b9 "1"
             | VFlt f9 -> (match flt_rat_parts f9 0 with (n9, d9) -> mk_rat_s n9 d9)
             | _ -> mk_rat_s "0" "1")
       else (let _ = prim_raise "RangeError" ("can't convert " ++ to_s recv ++ " into Rational") in VRat ("0", "1"))) | _ -> (let _ = map_set prim_missing "n" (mkstr "to_r") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_r'")) in fail "mere-ruby: undefined method 'to_r'")))
  else if str_eq name "real" then (match recv with VCpx (r, i) -> r | VRat (n, d) -> recv | _ -> recv)
  else if str_eq name "imaginary" || str_eq name "imag" then (match recv with VCpx (r, i) -> i | _ -> VInt 0)
  else if str_eq name "real?" then (match recv with VCpx (r, i) -> VBool false | _ -> VBool true)
  else if str_eq name "conjugate" || str_eq name "conj" then (match recv with VCpx (r, i) -> VCpx (r, num_neg i) | _ -> recv)
  else if str_eq name "abs2" then
    (match recv with
     | VCpx (r, i) -> cpx_comp "+" (cpx_comp "*" r r) (cpx_comp "*" i i)
     | v -> cpx_comp "*" v v)
  else if str_eq name "arg" || str_eq name "angle" || str_eq name "phase" then
    (match recv with
     | VCpx (r, i) -> VFlt (atan2 (to_f i) (to_f r))
     // a real numeric: 0 (exact) when non-negative, pi when negative -- and
     // -0.0 is NEGATIVE here, by its sign bit. `f < 0.0` is false for it, so
     // `(-0.0).arg` answered 0 while `(-0.0).to_c.arg` answered pi: the same
     // question about the same value, answered two ways.
     | v -> (if num_isneg_signed v then VFlt (atan2 0.0 (0.0 - 1.0)) else VInt 0))
  else if str_eq name "quo" then
    (match args with
     | Cons (b, _) ->
       (match recv with
        | VCpx (r, i) -> cpx_arith "/" recv b
        | v ->
          // bare quo is NOT canonicalized: 2.quo(2) == (1/1).
          (if (match v with VFlt _ -> true | _ -> false) || (match b with VFlt _ -> true | _ -> false)
           then VFlt (to_f v / to_f b)
           else rat_arith "/" (match v with VRat _ -> v | VInt n -> mk_rat n 1 | VBig bb -> mk_rat_s bb "1" | x -> x) b))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "quo") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'quo'")) in fail "mere-ruby: undefined method 'quo'")))
  else if str_eq name "polar" then
    (match recv with
     | VCpx (r, i) ->
       (let m = (if rb_eq i (VInt 0) then num_mag_signed r
                 else if rb_eq r (VInt 0) then num_mag_signed i
                 else VFlt (sqrt (to_f (cpx_comp "+" (cpx_comp "*" r r) (cpx_comp "*" i i))))) in
        arr_new (Cons (m, Cons (VFlt (atan2 (to_f i) (to_f r)), Nil))))
     // ⚠ a non-negative real's angle is the INTEGER 0, not 0.0 -- ruby answers
     //   [1, 0] for 1.polar and [1, 3.141592653589793] for -1.polar. Running it
     //   through atan2 gave 0.0 and printed a Float where ruby prints an
     //   Integer, which is a diff on every spec that inspects the pair.
     // ...and -0.0's polar is [0.0, pi] -- both halves read the sign bit.
     // ...and NaN has no magnitude and no angle: ruby answers [NaN, NaN]. The
     // sign-bit reading below took the "not negative" branch and paired NaN
     // with the Integer 0.
     | VFlt f7 when (if f7 == f7 then false else true) -> arr_new (Cons (recv, Cons (recv, Nil)))
     | v -> arr_new (Cons (num_mag_signed v,
                           Cons ((if num_isneg_signed v then VFlt (atan2 0.0 (to_f v)) else VInt 0), Nil))))
  // Numeric#rationalize: the SIMPLEST fraction within the receiver's precision,
  // which is a different question from to_r's exact value. Integer, Rational and
  // nil answer without searching; a Float searches the half-ulp interval around
  // itself, and an explicit eps searches [x-|eps|, x+|eps|].
  // NilClass#rationalize is (0/1) whatever the (single) argument -- computing
  // the tolerance interval first asked nil for arithmetic and failed. Two
  // arguments is ruby's arity error.
  else if str_eq name "rationalize" && (match recv with VNil -> true | _ -> false) then
    (match args with
     | Cons (_, Cons (_, _)) ->
       prim_raise "ArgumentError" ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..1)")
     | _ -> mk_rat_s "0" "1")
  // Complex#rationalize is Complex#to_r's question: only a real Complex has one.
  else if str_eq name "rationalize" && is_cpx recv then
    (match recv with
     | VCpx (cre, cim) ->
       (if exact_zero_val cim then prim_method cre "rationalize" args
        else prim_raise "RangeError" ("can't convert " ++ to_s recv ++ " into Rational"))
     | _ -> VNil)
  // A Float that is already WHOLE rationalizes to ITSELF over 1: ruby short
  // circuits there (float_rationalize returns the exact integer once the
  // exponent says there is no fraction) and never runs the simplest-rational
  // search. Running it anyway answered 999999999999999949515880660992 for
  // 1.0e30, whose exact value is 1000000000000000019884624838656 -- a simpler
  // rational inside an interval ruby does not consider.
  else if str_eq name "rationalize" && (match args with Nil -> true | _ -> false)
          && (match recv with VFlt f9 -> flt_is_big_whole f9 | _ -> false) then
    (match recv with VFlt f9 -> mk_rat_s (flt_to_big_s f9) "1" | _ -> VNil)
  else if str_eq name "rationalize" then
    (let bounds =
       (match args with
        | Cons (e, _) ->
          // an explicit tolerance: the interval is the value plus and minus it
          let ev = num_abs e in
          (rat_pair_of (cpx_comp "-" recv ev), rat_pair_of (cpx_comp "+" recv ev))
        | Nil ->
          (match recv with
           | VFlt f ->
             // half an ulp on each side, taken from the neighbouring floats so
             // the width is the float's own precision rather than a guess
             (rat_mid (flt_pair (flt_prev f)) (flt_pair f),
              rat_mid (flt_pair f) (flt_pair (flt_next f)))
           | v -> (rat_pair_of v, rat_pair_of v))) in
     match recv with
     | VInt n -> mk_rat_s (str_of_int n) "1"
     | VBig b -> mk_rat_s b "1"
     | VNil -> mk_rat_s "0" "1"
     | VRat (n, d) -> (match args with Nil -> recv | _ -> rq_answer bounds)
     | VFlt f -> if f == 0.0 then mk_rat_s "0" "1" else rq_answer bounds
     | _ -> (let _ = map_set prim_missing "n" (mkstr "rationalize") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'rationalize'")) in fail "mere-ruby: undefined method 'rationalize'"))) 
  else if str_eq name "i" then
    // Numeric#i: this value as the imaginary part. Complex has no #i in ruby.
    (match recv with
     | VCpx (_, _) -> (let _ = map_set prim_missing "n" (mkstr "i") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'i'")) in fail "mere-ruby: undefined method 'i'"))
     | v -> VCpx (VInt 0, v))
  else if str_eq name "rect" || str_eq name "rectangular" then
    (match recv with
     | VCpx (r, i) -> arr_new (Cons (r, Cons (i, Nil)))
     | v -> arr_new (Cons (v, Cons (VInt 0, Nil))))
  // String
  else if str_eq name "encoding" then
    (match recv with
     | VStr h -> let nm = senc_get h in (if map_has enc_objs nm then map_get enc_objs nm else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else mkstr nm)
     // a Symbol's encoding is US-ASCII when its name is, UTF-8 otherwise --
     // unless to_sym recorded the source string's own encoding.
     | VSym sy ->
       (let nm = sym_enc_name sy in
        if map_has enc_objs nm then map_get enc_objs nm else mkstr nm)
     // the `n` flag pins the pattern to BYTES, whatever its source looks like:
     // `/x/n.encoding` is ASCII-8BIT in ruby and was US-ASCII here.
     | VRegex (p, fl, ev9) ->
       (let nm = rx_enc_name p fl ev9 in
        if map_has enc_objs nm then map_get enc_objs nm else mkstr nm)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "encoding") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'encoding'")) in fail "mere-ruby: undefined method 'encoding'")))
  else if str_eq name "force_encoding" then
    (match recv with
     | VStr h ->
       (let nm0 = (match args with
                   | Cons (VStr nmh, _) -> sget nmh
                   | Cons (VObj oid, _) ->
                     (if map_has enc_name (str_of_int oid) then map_get enc_name (str_of_int oid)
                      // not an Encoding, and #to_str (tried upstream) did not
                      // produce a String: ruby refuses by TYPE, not by name.
                      else (let _ = prim_raise "TypeError"
                                      ("no implicit conversion of " ++ class_name (VObj oid) ++ " into String") in ""))
                   | Cons (other, _) ->
                     (let _ = prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String") in "")
                   | Nil ->
                     (let _ = prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)" in "")) in
        // the special names resolve through the defaults ("internal" is
        // BINARY when default_internal is nil); everything else must be a
        // name some encoding answers to, exactly as ruby refuses the rest.
        let canon =
          (if str_eq nm0 "internal" then
             (if map_has def_int_enc "v" then
                (match map_get def_int_enc "v" with
                 | VObj oid -> (if map_has enc_name (str_of_int oid) then map_get enc_name (str_of_int oid) else "ASCII-8BIT")
                 | VStr eh -> enc_find_canon (sget eh)
                 | _ -> "ASCII-8BIT")
              else "ASCII-8BIT")
           else if str_eq nm0 "external" || str_eq nm0 "locale" || str_eq nm0 "filesystem" then
             (if map_has def_ext_enc "v" then
                (match map_get def_ext_enc "v" with
                 | VObj oid -> (if map_has enc_name (str_of_int oid) then map_get enc_name (str_of_int oid) else "UTF-8")
                 | VStr eh -> enc_find_canon (sget eh)
                 | _ -> "UTF-8")
              else "UTF-8")
           else enc_find_canon nm0) in
        if str_eq canon "" then prim_raise "ArgumentError" ("unknown encoding name - " ++ nm0)
        else let _ = senc_set h canon in recv)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "force_encoding") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'force_encoding'")) in fail "mere-ruby: undefined method 'force_encoding'")))
  else if str_eq name "b" then
    (match recv with VStr h -> let c = mkstr (sget h) in (match c with VStr id -> let _ = senc_set id "ASCII-8BIT" in c | _ -> c) | _ -> (let _ = map_set prim_missing "n" (mkstr "b") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'b'")) in fail "mere-ruby: undefined method 'b'")))
  else if str_eq name "bytesize" then (match recv with VStr h -> VInt (str_len (sget h)) | _ -> (let _ = map_set prim_missing "n" (mkstr "bytesize") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'bytesize'")) in fail "mere-ruby: undefined method 'bytesize'")))
  else if str_eq name "ascii_only?" then
    (match recv with
     | VStr h -> VBool (enc_ascii_compat (enc_canon_name (senc_get h)) && str_ascii_only (sget h) 0)
     | _ -> VBool false)
  else if str_eq name "valid_encoding?" then
    (match recv with
     | VStr h -> VBool (enc_valid (sget h) (enc_canon_name (senc_get h)))
     | _ -> VBool false)
  else if str_eq name "encode" || str_eq name "encode!" then
    (match recv with VStr h -> (match args with Cons (nm, _) -> let c = mkstr (sget h) in (match c with VStr id -> let _ = senc_set id (to_s nm) in c | _ -> c) | _ -> recv) | _ -> (let _ = map_set prim_missing "n" (mkstr "encode") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'encode'")) in fail "mere-ruby: undefined method 'encode'")))
  // upcase / downcase / capitalize / swapcase take symbol OPTIONS (:ascii,
  // :turkic, :lithuanian, :fold). Anything else is `invalid option` in Ruby,
  // where this used to ignore the argument entirely.
  else if (str_eq name "upcase" || str_eq name "downcase" || str_eq name "capitalize"
           || str_eq name "swapcase")
          && (match args with Nil -> false | Cons (VSym _, _) -> false | _ -> true) then
    prim_raise "ArgumentError" "invalid option"
  else if str_eq name "upcase" || str_eq name "downcase" then
    (match recv with
     | VStr h -> rb_case_apply h (if str_eq name "upcase" then "u" else "d") (rb_case_opt args (str_eq name "downcase"))
     | _ -> (let _ = map_set prim_missing "n" (mkstr name) in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: undefined method '" ++ name ++ "'"))) in fail "mere-ruby: undefined method")))
  else if str_eq name "capitalize" then (match recv with VStr h -> rb_case_apply h "c" (rb_case_opt args false) | _ -> (let _ = map_set prim_missing "n" (mkstr "capitalize") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'capitalize'")) in fail "mere-ruby: undefined method 'capitalize'")))
  else if str_eq name "reverse" then
    (match recv with
     | VStr sh0 ->
       (let e = enc_canon_name (senc_get sh0) in
        if enc_ascii_compat e then mkstr (utf8_reverse (sget sh0))
        else
          (let rec rv = fn (a: int list) -> fn (b: int list) -> (match a with Nil -> b | Cons (h, t) -> rv t (Cons (h, b))) in
           match encode_cps (rv (decode_cps (sget sh0) e 0) Nil) e "" with
           | (bytes, _) -> (let v = mkstr bytes in (match v with VStr id -> (let _ = senc_set id e in v) | _ -> v))))
     | VArr id -> arr_new (val_rev (deref id) Nil) | _ -> (let _ = map_set prim_missing "n" (mkstr "reverse") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'reverse'")) in fail "mere-ruby: undefined method 'reverse'")))
  else if str_eq name "strip" then (match recv with VStr s -> (match args with Nil -> (let s = sget s in mkstr (str_lstrip (str_rstrip s))) | _ -> mkstr (str_strip_sel (sget s) (strip_selectors args) true true)) | _ -> (let _ = map_set prim_missing "n" (mkstr "strip") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'strip'")) in fail "mere-ruby: undefined method 'strip'")))
  else if str_eq name "swapcase" then (match recv with VStr h -> rb_case_apply h "s" (rb_case_opt args false) | _ -> (let _ = map_set prim_missing "n" (mkstr "swapcase") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'swapcase'")) in fail "mere-ruby: undefined method 'swapcase'")))
  else if str_eq name "lstrip" then
    (match recv with
     | VStr sh ->
       // ruby refuses when the FIRST NON-SPACE character is broken (bytes
       // after it may be anything); the bang form inherits this by
       // delegating here.
       (match args with
        | Cons (_, _) -> mkstr (str_strip_sel (sget sh) (strip_selectors args) true false)
        | Nil ->
       (let sv = sget sh in
        let n = str_len sv in
        let rec sk = fn (i: int) -> if i < n && is_strip_ch (char_at sv i) then sk (i + 1) else i in
        let st = sk 0 in
        let _ = (if st < n && str_eq (enc_canon_name (senc_get sh)) "UTF-8" then
                   (match utf8_cp_strict sv st with
                    | (c, l, ok) -> if ok then () else (let _ = prim_raise "ArgumentError" "invalid byte sequence in UTF-8" in ()))
                 else ()) in
        mkstr (substring sv st n)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "lstrip") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'lstrip'")) in fail "mere-ruby: undefined method 'lstrip'")))
  else if str_eq name "rstrip" then
    (match recv with
     | VStr sh ->
       // ruby refuses when the LAST NON-SPACE character is broken -- with a
       // CompatibilityError, its own quirk (lstrip's is ArgumentError).
       (match args with
        | Cons (_, _) -> mkstr (str_strip_sel (sget sh) (strip_selectors args) false true)
        | Nil ->
       (let sv = sget sh in
        let rec bk = fn (i: int) -> if i >= 0 && is_strip_ch (char_at sv i) then bk (i - 1) else i in
        let en = bk (str_len sv - 1) in
        let _ = (if en >= 0 && str_eq (enc_canon_name (senc_get sh)) "UTF-8" then
                   (let rec back = fn (k: int) -> fn (steps: int) ->
                      (if steps >= 3 || k <= 0 then k
                       else if (let o = ord (char_at sv k) in o >= 128 && o < 192) then back (k - 1) (steps + 1)
                       else k) in
                    let st = back en 0 in
                    match utf8_cp_strict sv st with
                    | (c, l, ok) ->
                      if ok && st + l == en + 1 then ()
                      else (let _ = prim_raise "Encoding::CompatibilityError"
                                      ("incompatible character encodings: UTF-8 and ASCII-8BIT") in ()))
                 else ()) in
        mkstr (substring sv 0 (en + 1))))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "rstrip") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'rstrip'")) in fail "mere-ruby: undefined method 'rstrip'")))
  else if str_eq name "chomp" then
    // the default separator is $/ (nil there means "remove nothing"). A
    // receiver in a non-ASCII-compatible encoding (UTF-16/32) chomps in
    // CODEPOINTS: decode, drop the separator, encode back.
    (match recv with
     | VStr sh0 ->
       let e = enc_canon_name (senc_get sh0) in
       let s = sget sh0 in
       if enc_ascii_compat e then
         (match args with
          | Cons (VStr suf, _) -> mkstr (str_chomp_sep s (sget suf))
          | Cons (VNil, _) -> mkstr s
          | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
          | Nil ->
            (if map_has globals "/" then
               (match map_get globals "/" with
                | VStr g -> mkstr (str_chomp_sep s (sget g))
                | VNil -> mkstr s
                | _ -> mkstr (str_chomp s))
             else mkstr (str_chomp s)))
       else
         (let sepv = (match args with
                      | Cons (VStr suf, _) -> Cons (VStr suf, Nil)
                      | Cons (VNil, _) -> (Nil : Val list)
                      | Nil -> (if map_has globals "/" then (match map_get globals "/" with VStr g -> Cons (VStr g, Nil) | _ -> Nil) else Cons (mkstr "\n", Nil))
                      | _ -> Nil) in
          match sepv with
          | Nil -> mkstr s
          | Cons (VStr seph, _) ->
            let sep = sget seph in
            let cps = decode_cps s e 0 in
            let rcps = (let rec rv = fn (xs: int list) -> fn (acc: int list) -> (match xs with Nil -> acc | Cons (hh, tt) -> rv tt (Cons (hh, acc))) in rv cps Nil) in
            let rkept =
              (if str_eq sep "\n" then
                 (match rcps with
                  | Cons (10, Cons (13, t)) -> t
                  | Cons (10, t) -> t
                  | Cons (13, t) -> t
                  | other -> other)
               else if str_eq sep "" then
                 (let rec strip_nl = fn (xs: int list) ->
                    (match xs with
                     | Cons (10, Cons (13, t)) -> strip_nl t
                     | Cons (10, t) -> strip_nl t
                     | other -> other) in
                  strip_nl rcps)
               else
                 (let scps = decode_cps sep (enc_canon_name (senc_get seph)) 0 in
                  let rs = (let rec rv2 = fn (xs: int list) -> fn (acc: int list) -> (match xs with Nil -> acc | Cons (hh, tt) -> rv2 tt (Cons (hh, acc))) in rv2 scps Nil) in
                  let rec pref = fn (a: int list) -> fn (b: int list) ->
                    (match a with
                     | Nil -> (true, b)
                     | Cons (ha, ta) -> (match b with Cons (hb, tb) -> (if ha == hb then pref ta tb else (false, b)) | Nil -> (false, b))) in
                  (match pref rs rcps with (okp, restp) -> if okp then restp else rcps))) in
            let kept = (let rec rv3 = fn (xs: int list) -> fn (acc: int list) -> (match xs with Nil -> acc | Cons (hh, tt) -> rv3 tt (Cons (hh, acc))) in rv3 rkept Nil) in
            (match encode_cps kept e "" with
             | (bytes, _) -> (let c = mkstr bytes in (match c with VStr rid -> (let _ = senc_set rid e in c) | _ -> c)))
          | _ -> mkstr s)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "chomp") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'chomp'")) in fail "mere-ruby: undefined method 'chomp'")))
  else if str_eq name "chop" then
    (match recv with
     | VStr sh0 ->
       (let e = enc_canon_name (senc_get sh0) in
        // a binary string's characters ARE its bytes: chop removes ONE byte
        // (a UTF-8 walk here removed a whole multibyte sequence, which kept
        // "проверка".b.chop! accidentally valid).
        if str_eq e "ASCII-8BIT" then
          (let s0 = sget sh0 in
           let n = str_len s0 in
           let cut = (if n >= 2 && str_eq (substring s0 (n - 2) n) "\r\n" then n - 2
                      else if n >= 1 then n - 1 else 0) in
           let v = mkstr (substring s0 0 cut) in
           (match v with VStr id -> (let _ = senc_set id e in v) | _ -> v))
        else if enc_ascii_compat e then mkstr (str_chop (sget sh0))
        else
          (let cps = decode_cps (sget sh0) e 0 in
           let rec rv = fn (a: int list) -> fn (b: int list) -> (match a with Nil -> b | Cons (h, t) -> rv t (Cons (h, b))) in
           let r = rv cps Nil in
           let r2 = (match r with
                     | Cons (10, Cons (13, t)) -> t
                     | Cons (_, t) -> t
                     | Nil -> Nil) in
           match encode_cps (rv r2 Nil) e "" with
           | (bytes, _) -> (let v = mkstr bytes in (match v with VStr id -> (let _ = senc_set id e in v) | _ -> v))))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "chop") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'chop'")) in fail "mere-ruby: undefined method 'chop'")))
  // Hash#slice returns a sub-hash; for String and Array slice IS []
  else if str_eq name "slice" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     | VHsh xs -> (let r9 = mkhash (hash_slice (hderef xs) args) in
                   let _ = hcbi_copy xs r9 in r9)
     | _ -> recv)
  else if str_eq name "slice" then prim_method recv "[]" args
  else if str_eq name "tr" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VStr f, Cons (VStr t, _)) -> mkstr (str_tr s (sget f) (sget t)) | _ -> mkstr s)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "tr") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'tr'")) in fail "mere-ruby: undefined method 'tr'")))
  // tr_s: translate, squeezing runs the TRANSLATION created (never runs that
  // were already in the input untranslated).
  else if str_eq name "tr_s" then
    (match recv with
     | VStr s -> let s = sget s in
       (match args with
        | Cons (VStr f, Cons (VStr t, _)) -> mkstr (str_tr_s s (sget f) (sget t))
        | Cons (_, Nil) -> prim_raise "ArgumentError" "wrong number of arguments (given 1, expected 2)"
        | _ -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 2)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "tr_s") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'tr_s'")) in fail "mere-ruby: undefined method 'tr_s'")))
  else if str_eq name "squeeze" then
    (match recv with
     | VStr s -> let s = sget s in
