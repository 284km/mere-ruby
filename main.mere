     | VHsh h -> (match args with Cons (v, _) -> hash_rassoc (hderef h) v | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "rassoc") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'rassoc'")) in fail "mere-ruby: undefined method 'rassoc'")))
