// `enc`) as \uXXXX, so the result is plain ASCII and can be appended to any
// buffer. Used when an #inspect answers a string in an encoding that is not
// the default external.

and inspect_w = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VObj oid ->
    let (m2, s2, ocls2, iv2) = world in
    let cls = map_get ocls2 oid in
    // ⚠ `p ENV` and `ENV.inspect` are the same question. They reached different
    //   code and gave different answers -- the printer said #<EnvHash:0x..>
    //   while the method said the environment. Ask once, here.
    if str_eq cls "EnvHash" then inspect_w env world (mkhash (env_hash_list ()))
    // an #inspect that answers a NON-String is asked #to_s, and only if THAT
    // is not a String either does the default rendering stand in. #to_str is
    // never asked (the spec pins that too). `to_s other` skipped the dispatch
    // and printed the internal rendering instead of calling the object.
    else if has_meth world cls "inspect"
    then (let nb8 = (false, (Nil : str list), (Nil : Stmt list), env) in
          match invoke world nb8 v cls "inspect" Nil with
          // an inspect result in ANOTHER encoding than the default external is
          // ESCAPED rather than appended raw (ruby's rb_inspect -> rb_str_escape):
          // that is how a UTF-16BE answer becomes `"utf_16be \u3042"` instead of
          // raw bytes that no ASCII buffer could hold.
          | VStr s ->
            (let se8 = enc_canon_name (senc_get s) in
             let txt8 = sget s in
             let dx8 = (match (if map_has def_ext_enc "v" then map_get def_ext_enc "v" else VNil) with
                        | VObj eo8 -> (if map_has enc_name (str_of_int eo8)
                                       then enc_canon_name (map_get enc_name (str_of_int eo8)) else "UTF-8")
                        | _ -> "UTF-8") in
             // "ascii only" is about CHARACTERS, not bytes: every byte of a
             // UTF-16BE string can be < 128 while none of its characters are
             // ASCII, so a non-ascii-compatible encoding is never ascii-only.
             let ao8 = enc_ascii_compat se8 && enc_all7 txt8 in
             if (if str_eq se8 dx8 then false else true) && (if ao8 then false else true)
             then enc_escape_txt se8 txt8
             else txt8)
          | other ->
            (match other with
             | VObj oid8 ->
               (let cls8 = map_get ocls2 oid8 in
                if has_meth world cls8 "to_s" then
                  (match invoke world nb8 other cls8 "to_s" Nil with
                   | VStr s2 -> sget s2
                   | _ -> "#<" ++ cls_display world (obj_print_cls world cls8) ++ ":0x" ++ hex_pad16 oid8 ++ ">")
                else "#<" ++ cls_display world (obj_print_cls world cls8) ++ ":0x" ++ hex_pad16 oid8 ++ ">")
             | _ -> to_s other))
    // An EXCEPTION inspects as `#<Class: message>`: Exception#inspect is a real
    // override of Kernel#inspect and `p e` has to use it. The value-level
    // printer went straight to the ivar dump below, so `p RuntimeError.new("x")`
    // printed `#<RuntimeError:0x.. @message="x">` -- the internals in place of
    // the message, and once a raise started recording a cause, @__cause and the
    // whole exception it points at came out too.
    else if exc_is_a world cls "Exception" && (if has_meth world cls "inspect" then false else true) then
      (match invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) v "inspect" Nil false with
       | VStr h8 -> sget h8
       | o8 -> to_s o8)
    // `#<struct S a=1, b=2>` -- named when the class was assigned to a
    // constant, and with no address anywhere, so it compares byte for byte.
    // ⚠ an ANCESTOR's members count: `class Named < Struct.new(:a); end` has
    // none of its own and its instances are structs, and they printed as
    // ordinary objects (`#<Named:0x..>`) because only the class itself was
    // asked.
    else if is_struct_obj_cls world cls then
      (let mc9 = struct_members_cls world (ancestors_of world cls) in
       // The class NAME is printed only when the struct class HAS one, and it
       // is read from the constant that names it -- ⚠ NOT through cls_display,
       // which asks the class's own #name, and "does not call #name" is a spec
       // of its own here. ruby prints the members alone for an anonymous struct
       // and for one nested in an anonymous namespace, and the bookkeeping name
       // of both carries the anon marker.
       let raw9 = (if map_has anon_name cls
                   then (match map_get anon_name cls with VStr h9 -> sget h9 | _ -> "")
                   else cls) in
       let nm9 = (if str_eq raw9 "" then ""
                  else if str_contains raw9 "AnonClass_" then ""
                  else if str_contains raw9 "AnonModule_" then ""
                  else if str_len raw9 >= 7 && str_eq (substring raw9 0 7) "Struct_" then ""
                  else raw9 ++ " ") in
       let ms = (match map_get struct_mem mc9 with VArr aid -> deref aid | _ -> Nil) in
       "#<struct " ++ nm9 ++ struct_fields env world oid ms "" ++ ">")
    // Ruby's default: `#<ClassName:0xADDR>`, and with instance variables
    // `#<C:0xADDR @a=1, @b="x">`. This printed `#<object>` for every object of
    // every class, which is the one thing an inspect is for -- telling them
    // apart. The address is this interpreter's object id in Ruby's 16-digit
    // shape; it is not a memory address there either, only a number nobody
    // should compare.
    // Encoding and MatchData have inspects of their own in the value-level
    // printer, which knows them by their side tables; only an object with no
    // other answer gets the default one.
    else if map_has enc_name (str_of_int oid) then inspect v
    // ...and the MATCH is built here, not delegated: the leaf `inspect` has no
    // ivars, so it can only answer `#<object>` for a MatchData, which is what
    // `p $~` and `p [$~]` printed while `$~.inspect` was already right. Two
    // printers, and only one of them could see the groups.
    // a Method / UnboundMethod prints as ruby writes it, not as the object it
    // is made of: `p method(:foo)` showed @__m_name and the rest.
    else if str_eq cls "Method" || str_eq cls "UnboundMethod" then
      (let gv9 = fn (k: str) -> (if map_has iv2 (str_of_int oid ++ k) then (match map_get iv2 (str_of_int oid ++ k) with VStr h -> sget h | _ -> "") else "") in
       let own9 = (if str_eq cls "Method" then gv9 "@__m_owner" else gv9 "@__um_cls") in
       let nm9 = (if str_eq cls "Method" then gv9 "@__m_name" else gv9 "@__um_name") in
       let rcv9 = (if map_has iv2 (str_of_int oid ++ "@__m_recv") then map_get iv2 (str_of_int oid ++ "@__m_recv") else VMain) in
       let own9 = (if str_eq own9 "" then class_name rcv9 else own9) in
       meth_inspect_str world cls own9 nm9 (bm_params world own9 nm9)
         (meth_source_location world own9 nm9 rcv9))
    else if map_has md_whole (str_of_int oid) then
      "#<MatchData " ++ inspect (mkstr (map_get md_whole (str_of_int oid)))
      ++ md_insp_groups iv2 oid 1 ++ ">"
    // A backtrace Location reads as the frame it names, and it has to be
    // answered HERE as well as in the dispatcher: an element inside an array is
    // formatted by this printer, not by a to_s call, so `p caller_locations`
    // showed the raw object while `p loc.to_s` was already right. Two printers,
    // one answer needed in both.
    else if str_eq cls "Thread::Backtrace::Location" then
      (let gv = fn (k: str) -> (if map_has iv2 (str_of_int oid ++ "@" ++ k) then map_get iv2 (str_of_int oid ++ "@" ++ k) else VNil) in
       let pth = (match gv "path" with VStr h -> sget h | _ -> "") in
       let lno = (match gv "lineno" with VInt n -> n | _ -> 0) in
       let lbl = (match gv "label" with VStr h -> sget h | _ -> "") in
       inspect (mkstr (pth ++ ":" ++ str_of_int lno ++ ":in '" ++ lbl ++ "'")))
    // an ArithmeticSequence prints as the call that made it, `(1.step(10))`:
    // its own #inspect arm knows the receiver and arguments
    else if str_eq cls "Enumerator::ArithmeticSequence" then
      aseq_inspect_str env world oid
    else if str_eq cls "Enumerator" || str_eq cls "Enumerator::Lazy" then
      enum_inspect_str env world oid cls
    else
      // ruby 4.0: Kernel#inspect asks #instance_variables_to_inspect first. An
      // array names the ivars to show (in the object's own order, unset names
      // skipped); nil -- the Kernel default -- means all of them.
      (let ivs = (if has_meth world cls "instance_variables_to_inspect" then
                    (let nb0 = (false, (Nil : str list), (Nil : Stmt list), env) in
                     match invoke world nb0 v cls "instance_variables_to_inspect" Nil with
                     | VArr aid -> obj_ivar_dump_sel env world oid cls (deref aid)
                     | _ -> obj_ivar_dump env world oid cls)
                  else obj_ivar_dump env world oid cls) in
       // the class names ITSELF here too: an instance of an anonymous class is
       // `#<#<Class:0x..>:0x..>` in ruby, not `#<AnonClass_0:0x..>`.
       // ⚠ ...but an object's own SINGLETON class is not what it prints. `def
       // o.x` records `#<Class:#<C:0x..>>` as o's class -- that is how dispatch
       // finds the method -- and ruby still prints `#<C:0x..>`. Every object
       // that had ever been given a singleton method printed its singleton,
       // through `p`, #inspect, #to_s and the "undefined method for ..."
       // message alike.
       "#<" ++ cls_display world (obj_print_cls world cls) ++ ":0x" ++ hex_pad16 oid ++ (if str_eq ivs "" then "" else " " ++ ivs) ++ ">")
  | VArr id ->
    if map_has insp_seen ("a" ++ str_of_int id) then "[...]"
    else
      let _ = map_set insp_seen ("a" ++ str_of_int id) 1 in
      let r = "[" ++ join_inspect_w env world (deref id) "" ++ "]" in
      let _ = map_delete insp_seen ("a" ++ str_of_int id) in
      r
  | VHsh hid ->
    if map_has insp_seen ("h" ++ str_of_int hid) then "\{...}"
    else
      let _ = map_set insp_seen ("h" ++ str_of_int hid) 1 in
      let r = "\{" ++ join_pairs_w env world (hderef hid) "" ++ "}" in
      let _ = map_delete insp_seen ("h" ++ str_of_int hid) in
      r
  // the singleton class OF AN OBJECT: `#<Class:#<Object:0x..>>`, which needs the
  // world to name the object's class -- the world-free printer leaves it as the
  // bookkeeping name, and this is the only place that can do better.
  | VClass c -> (if is_sng_cls c then cls_display world c else to_s v)
  // a Range's bounds are inspected the way any other container's elements
  // are -- through the WORLD, so an object bound shows its own #inspect.
  // Falling through to the world-free printer rendered a range of Comparables
  // as `#<object>..#<object>`, while an ARRAY holding the same two objects
  // printed them correctly: the tell that one question had two answers.
  | VRange (lo, hi, excl) ->
    (match lo with
     | VNil -> (match hi with VNil -> "nil" | _ -> "")
     | _ -> inspect_w env world lo)
    ++ (if excl then "..." else "..")
    ++ (match hi with
        | VNil -> (match lo with VNil -> "nil" | _ -> "")
        | _ -> inspect_w env world hi)
  | _ -> inspect v

// the object id as Ruby shows it: 0x + 16 hex digits

// `@a=1, @b="x"` for the object's own instance variables, in the order they
// were first set (which is the order Ruby shows them in).
and obj_ivar_dump = fn env -> fn world -> fn (oid: int) -> fn (cls: str) ->
  let (_, _, _, iv) = world in
  let names = ivar_names_of iv oid in
  ivar_dump_go env world iv oid names ""

// the same dump, keeping only the ivars an #instance_variables_to_inspect
// answer names (as :@a symbols or "@a" strings, with or without the @)
and obj_ivar_dump_sel = fn env -> fn world -> fn (oid: int) -> fn (cls: str) -> fn (want: Val list) ->
  let (_, _, _, iv) = world in
  let names = ivar_names_of iv oid in
  let keep = fn (n: str) ->
    (let rec go = fn (xs: Val list) ->
       (match xs with
        | Nil -> false
        | Cons (VSym s, t) -> if str_eq s ("@" ++ n) || str_eq s n then true else go t
        | Cons (VStr h, t) -> if str_eq (sget h) ("@" ++ n) || str_eq (sget h) n then true else go t
        | Cons (_, t) -> go t) in
     go want) in
  let rec filt = fn (xs: str list) ->
    (match xs with Nil -> Nil | Cons (h, t) -> if keep h then Cons (h, filt t) else filt t) in
  ivar_dump_go env world iv oid (filt names) ""

// the object's own @ivar names, in the order the map holds them (which is the
// order they were first set -- the order Ruby shows them in)


and ivar_dump_go = fn env -> fn world -> fn iv -> fn (oid: int) -> fn (names: str list) -> fn (acc: str) ->
  match names with
  | Nil -> acc
  | Cons (n, t) ->
    let v = map_get iv (str_of_int oid ++ "@" ++ n) in
    ivar_dump_go env world iv oid t
      (acc ++ (if str_eq acc "" then "" else ", ") ++ "@" ++ n ++ "=" ++ inspect_w env world v)

and struct_fields = fn env -> fn world -> fn (oid: int) -> fn (ms: Val list) -> fn (acc: str) ->
  match ms with
  | Nil -> acc
  | Cons (VSym m, t) ->
    (let (_, _, _, iv) = world in
     // the member lives in its SLOT, not in `@<member>` (struct_slot)
     let k = str_of_int oid ++ "@" ++ struct_slot m in
     let v = (if map_has iv k then map_get iv k else VNil) in
     let piece = m ++ "=" ++ inspect_w env world v in
     struct_fields env world oid t (if str_eq acc "" then piece else acc ++ ", " ++ piece))
  | Cons (_, t) -> struct_fields env world oid t acc

and join_inspect_w = fn env -> fn world -> fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    let piece = if str_eq acc "" then inspect_w env world h else acc ++ ", " ++ inspect_w env world h in
    join_inspect_w env world t piece

and join_pairs_w = fn env -> fn world -> fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       let pair = hash_key_prefix k (inspect_w env world k) ++ inspect_w env world v in
       let acc2 = if str_eq acc "" then pair else acc ++ ", " ++ pair in
       join_pairs_w env world t acc2
     | Nil -> acc)

// "wrong number of arguments (given N, expected R)" if the builtin under this
// name takes a different count -- "" when it is fine, when no row covers it,
// or when a user method has taken the name over (a monkey patch owns its own
// arity). A keyword hash written `k: v` is not a positional argument, so it is
// not counted: ruby's own bounds are the positional ones.
and builtin_arity_msg = fn world -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  builtin_arity_msg_b world recv name args false

// with_blk: the bounds a block changes ("ab".sub("a") { } takes one argument
// where the blockless form takes two), measured as its own table.
and builtin_arity_msg_b = fn world -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) -> fn (with_blk: bool) ->
  // the env flag is read ONCE (env_get lives in this group, arity_build does
  // not): unloaded, the prefilter below is empty and the check is one map_has.
  let _ = (if map_has arity_state "l" then ()
           else (let _ = map_set arity_state "l" 1 in
                 if str_eq (env_get "MERE_RUBY_NO_ARITY") "" then arity_build () else ())) in
  if (if map_has arity_names name then false else true) then ""
  // a CLASS as the receiver is a different question: the table's `Class#new`
  // is what an anonymous class does with `.new`, and `dispatch_cls_of` calls
  // every class by its own name, so `Class.new(StandardError)` read that row
  // and refused itself. Class methods have no rows here.
  else if (match recv with VClass _ -> true | _ -> false) then ""
  else
    let cls = dispatch_cls_of world recv in
    let key0 = cls ++ "#" ++ name in
    // a class that INCLUDES Enumerable (or Comparable) gets that module's
    // bounds: `Enumerable#all?` takes 0..1 whatever the includer is called,
    // and ten spec files ask exactly that, through a class of their own.
    let tbl = (if with_blk then arity_blk_tbl else arity_tbl) in
    let key = (if map_has tbl key0 then key0
               else if obj_is_a world cls "Enumerable" && map_has tbl ("Enumerable#" ++ name)
               then "Enumerable#" ++ name
               else if obj_is_a world cls "Comparable" && map_has tbl ("Comparable#" ++ name)
               then "Comparable#" ++ name
               else key0) in
    if (if map_has tbl key then false else true) then ""
    // a method the PROGRAM defined owns its own arity -- including one defined
    // on this object's singleton, which dispatch_cls_of does not name
    // (`class << (ary = []); def []; 0; end; end` then read Array#[]'s bounds).
    else if has_meth world cls name || prim_user_has world recv name then ""
    else
      let packed = map_get tbl key in
      let lo = packed / 1024 in
      let hi = (packed - lo * 1024) - 1 in
      let n0 = vlen args in
      // A trailing `k: v` hash is a keyword argument to a method that takes
      // keywords and a positional Hash to one that does not -- and this table
      // records only positional bounds. Counting it wrongly refuses one of the
      // two (`1.23.round(2, half: :up)` or `"l".sub("l", "l" => "L")`), so a
      // call with one is accepted if EITHER count fits: the check exists to
      // catch a wrong number, not to decide what a hash means.
      let kw = (if n0 > 0 then is_kw_hash (vlast args) else false) in
      let fits = fn (k: int) -> k >= lo && (if hi < 0 then true else k <= hi) in
      let n = n0 in
      if fits n0 || (if kw then fits (n0 - 1) else false) then ""
      else "wrong number of arguments (given " ++ str_of_int n ++ ", expected "
           ++ (if hi < 0 then str_of_int lo ++ "+"
               else if lo == hi then str_of_int lo
               else str_of_int lo ++ ".." ++ str_of_int hi) ++ ")"
and invoke_val_c = fn env -> fn world -> fn blk -> fn (recv0: Val) -> fn (name0: str) -> fn (args0: Val list) -> fn (vischeck: bool) ->
  // the count comes first: ruby refuses a wrong number of arguments before it
  // looks at what they are.
  let __am = builtin_arity_msg world recv0 name0 args0 in
  if (if str_eq __am "" then false else true) then raise_exc world "ArgumentError" __am
  // ⚠ `respond_to?` lived ONLY in the syntactic method-call arm, so
  //   `x.respond_to?(:y)` answered and `send(:respond_to?, :y)` -- and every
  //   bare `respond_to?(:y)` inside a method, which is the same dispatcher --
  //   raised NoMethodError for a method the object has. One fact, two
  //   spellings, one of them implemented. A class that defines its own still
  //   wins, exactly as it does on the other path.
  else if str_eq name0 "respond_to?"
          && (if has_meth world (dispatch_cls_of world recv0) "respond_to?" then false else true) then
    respond_to_answer env world recv0 args0
  // ⚠ Object#<=> answers 0 when the two are ==, and the question is the
  //   OBJECT's own #== -- the leaf dispatcher has no world and used the
  //   value-level comparison, so `obj.<=>(other)` was nil for a class whose
  //   #== says they are equal (and never asked it).
  // ⚠ ...and NOT when the class has a BUILTIN <=> (Time's lives in the
  //   dispatcher, not the method table): this arm shadowed it and every Time
  //   range stopped constructing -- corpus/179 caught it.
  else if str_eq name0 "<=>" && (match recv0 with VObj _ -> true | _ -> false)
          && (if has_meth world (dispatch_cls_of world recv0) "<=>" then false else true)
          && (if builtin_obj_has (display_cls world (dispatch_cls_of world recv0)) "<=>" then false else true) then
    (match args0 with
     | Cons (b9, _) -> (if rb_eq_w env world recv0 b9 then VInt 0 else VNil)
     | _ -> VNil)
  else
  // Integer#step / Range#step called WITHOUT a block (a call with one goes
  // through invoke_with_block): an Enumerator::ArithmeticSequence, not an
  // Array. The leaf dispatcher (prim_method_raw) has no world to build it in.
  if str_eq name0 "step"
     && (match recv0 with
         | VInt _ -> true
         // a Float receiver too: 1.0.step(to: 10.0, by: 2.0) with no block is
         // an ArithmeticSequence like the Integer form, and its size is
         // COUNTED (aseq_size_flt) rather than walked.
         | VFlt _ -> true
         // ...and a Range with a FLOAT bound on either side: `(1.0..2.0).step(0.5)`
         // is an ArithmeticSequence too, and it went to the leaf, which
         // answered an empty Array.
         | VRange (lo, hi, _) ->
           (rng_is_int lo || (match lo with VFlt _ -> true | _ -> false)
            // a BEGINLESS numeric range makes the sequence too (its class is
            // the answer ruby/spec asks for); walking it is the TypeError.
            || ((match lo with VNil -> true | _ -> false) && (rng_is_int hi || (match hi with VFlt _ -> true | _ -> false))))
           && (rng_is_int hi || rng_hi_open hi || (match hi with VFlt _ -> true | _ -> false))
         | _ -> false)
     // ...and the step itself has to be a NUMBER (or the keyword hash): with
     // anything else ruby hands back a plain Enumerator and complains only when
     // it is walked, so `(1..2).step(Object.new).class` is Enumerator.
     && (match args0 with
         | Nil -> true
         | Cons (VInt _, _) -> true | Cons (VFlt _, _) -> true | Cons (VBig _, _) -> true
         | Cons (VHsh _, _) -> true
         | _ -> false)
     && (let (mm9, _, _, _) = world in (if map_has mm9 "Integer#step" || map_has mm9 "Range#step" then false else true))
  then aseq_of world recv0 args0
  else if str_eq name0 "step"
          && (match recv0 with VRange (_, _, _) -> true | VInt _ -> true | VFlt _ -> true | _ -> false)
          && (match args0 with Cons (VObj _, _) -> true | _ -> false)
          && (let (mm9, _, _, _) = world in (if map_has mm9 "Integer#step" || map_has mm9 "Range#step" then false else true)) then
    make_enum_a world recv0 "step" args0
  // ...and a beginless range with a NON-numeric end has no sequence to make.
  else if str_eq name0 "step"
          && (match recv0 with
              | VRange (VNil, hi9, _) -> (match hi9 with VNil -> false | VInt _ -> false | VBig _ -> false | VFlt _ -> false | _ -> true)
              | _ -> false) then
    (match args0 with
     | Nil -> raise_exc world "ArgumentError" "step is required for non-numeric ranges"
     | _ -> raise_exc world "ArgumentError" "#step for non-numeric beginless ranges is meaningless")
  // Range#step over STRINGS with no block is a plain Enumerator (not an
  // arithmetic sequence -- nothing is added), driven by the block form below.
  // It reached the leaf, which answered an Array of one Integer.
  else if str_eq name0 "step"
          && (match recv0 with VRange (VStr _, _, _) -> true | _ -> false)
          && (let (mm9, _, _, _) = world in (if map_has mm9 "Range#step" then false else true)) then
    (match args0 with
     | Cons (VFlt _, _) -> raise_exc world "TypeError" "no implicit conversion of Float into String"
     | _ -> make_enum_a world recv0 "step" args0)
  // Range#initialize asked BY NAME (`Range.allocate.send(:initialize, 0, 1)`,
  // which ruby/spec does). A built range is frozen, so re-initialising it is a
  // FrozenError; an allocated-but-empty one takes 2 or 3 arguments whose
  // endpoints compare, exactly as the literal does. There was no method to
  // reach, so every form was a NoMethodError.
  else if str_eq name0 "initialize"
          && (match recv0 with
              | VRange (_, _, _) -> true
              | VObj _ -> str_eq (dispatch_cls_of world recv0) "Range"
              | _ -> false) then
    (match recv0 with
     | VRange (_, _, _) ->
       raise_exc_iv world "FrozenError" ("can't modify frozen Range: " ++ inspect_w env world recv0) (Cons (("__recv", recv0), Nil))
     | _ ->
       (let n9 = val_list_len args0 in
        if n9 < 2 || n9 > 3 then
          raise_exc world "ArgumentError"
            ("wrong number of arguments (given " ++ str_of_int n9 ++ ", expected 2..3)")
        else
          (match args0 with
           | Cons (lo9, Cons (hi9, _)) ->
             (if rng_bad_bounds world lo9 hi9 then raise_exc world "ArgumentError" "bad value for range"
              else VNil)
           | _ -> VNil)))
  // Range#min(n) / #max(n): arithmetic on integer endpoints, and a refusal on
  // anything else. Enumerating was both wrong (a bignum end answered []) and
  // unbounded (an endless range never returned).
  else if (str_eq name0 "min" || str_eq name0 "max")
          && (match args0 with Cons (_, Nil) -> true | _ -> false)
          // NOT gated on "was a block given": a real comparator block reaches
          // the iterating path before this arm ever runs, and asking here
          // instead read a LEAKED block as a real one. A proc invoked through
          // an `&b` parameter (`def w(&b); b.call; end`) hands its frame's
          // block to the calls inside its body, so inside `w { (0...2**64)
          // .min(2) }` this arm saw "a block was given", stood aside, and the
          // iterating path answered [] -- and every ruby/spec example runs in
          // exactly that shape, which is why the spec disagreed with the same
          // expression typed at the top level. See KNOWN_GAPS.md.
          && (match recv0 with
              | VRange (lo9, hi9, _) ->
                (match lo9 with VInt _ -> true | VBig _ -> true | VNil -> true | _ -> false)
                && (match hi9 with
                    | VInt _ -> true | VBig _ -> true | VNil -> true
                    | VFlt _ -> true
