  else if str_eq name "min" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (vtake (val_sort (deref id)) n) | _ -> (match deref id with Nil -> VNil | Cons (h, t) -> val_min t h)) | _ -> (let _ = map_set prim_missing "n" (mkstr "min") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'min'")) in fail "mere-ruby: undefined method 'min'")))
  else if str_eq name "max" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (vtake (val_rev (val_sort (deref id)) Nil) n) | _ -> (match deref id with Nil -> VNil | Cons (h, t) -> val_max t h)) | _ -> (let _ = map_set prim_missing "n" (mkstr "max") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'max'")) in fail "mere-ruby: undefined method 'max'")))
  else if str_eq name "sum" then (match recv with VArr id -> val_sum (deref id) (match args with Cons (init, _) -> init | _ -> VInt 0) | VRange (lo, hi, excl) -> rng_sum lo hi excl (match args with Cons (init, _) -> init | _ -> VInt 0) | _ -> (let _ = map_set prim_missing "n" (mkstr "sum") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'sum'")) in fail "mere-ruby: undefined method 'sum'")))
