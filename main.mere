           (match c with VStr id -> (let _ = senc_set id (senc_get h) in c) | _ -> c)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "scrub") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'scrub'")) in fail "mere-ruby: undefined method 'scrub'")))
  else if str_eq name "undump" then
    (match recv with
     | VStr h ->
