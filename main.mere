              | VObj _ ->
                (if responds world h "to_ary"
                 then (let nb7 = (false, (Nil : str list), (Nil : Stmt list), env) in
                       match invoke_val_c env world nb7 h "to_ary" Nil false with
                       | VArr aid7 -> VArr aid7
                       | _ -> h)
                 else h)
              | _ -> h) in
