// same key twice).
and arr_to_h_pairs = fn env -> fn world -> fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> (Nil : Val list)
  | Cons (h, t) ->
    (let hv = (match h with
               | VArr _ -> h
               | VObj _ -> (match conv_try env world h "to_ary" with VArr a9 -> VArr a9 | _ -> h)
               | _ -> h) in
     match hv with
     | VArr aid ->
       (let ps = deref aid in
        if val_list_len ps == 2 then
          list_append ps (arr_to_h_pairs env world t (i + 1))
        else
          (let _ = raise_exc world "ArgumentError"
                     ("wrong array length at " ++ str_of_int i ++ " (expected 2, was "
                      ++ str_of_int (val_list_len ps) ++ ")") in (Nil : Val list)))
