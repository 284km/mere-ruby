     then Cons (h9, val_intersect_w env world t9 ys)
     else val_intersect_w env world t9 ys)

and val_subtract_w = fn env -> fn world -> fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (Nil : Val list)
  | Cons (h9, t9) ->
    (if val_member_eqlw env world ys h9
     then val_subtract_w env world t9 ys
     else Cons (h9, val_subtract_w env world t9 ys))

and val_any_in_w = fn env -> fn world -> fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> false
  | Cons (h9, t9) -> if val_member_eqlw env world ys h9 then true else val_any_in_w env world t9 ys

and arr_intersect_args_w = fn env -> fn world -> fn (args: Val list) -> fn (acc: Val list) ->
  match args with
  | Nil -> acc
  | Cons (VArr o9, rest9) -> arr_intersect_args_w env world rest9 (val_intersect_w env world acc (deref o9))
  | Cons (_, rest9) -> arr_intersect_args_w env world rest9 acc

and arr_difference_args_w = fn env -> fn world -> fn (args: Val list) -> fn (acc: Val list) ->
  match args with
  | Nil -> acc
  | Cons (VArr o9, rest9) -> arr_difference_args_w env world rest9 (val_subtract_w env world acc (deref o9))
  | Cons (_, rest9) -> arr_difference_args_w env world rest9 acc

and uniq_seen = fn env -> fn world -> fn (seen: Val list) -> fn (k: Val) ->
