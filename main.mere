// If `key` has a pending autoload, consume it and load the file. Returns
// whether anything was loaded, so the caller can retry the lookup.
// Resolve `A::B::C` one segment at a time, firing an autoload whenever the
// next segment is not there yet. VNil means "not found" (a constant whose
// value really is nil falls through to the caller's NameError).
and const_walk = fn env -> fn world -> fn blk -> fn (cref: str) -> fn (name: str) ->
  let hk = const_walk_head env world blk cref (const_head name) in
  if str_eq hk "" then VNil else const_walk_go env world blk hk (const_tail name)
// the first segment: lexically scoped, top level, or still only an autoload.
// "" means it could not be resolved at all.
and const_walk_head = fn env -> fn world -> fn blk -> fn (cref: str) -> fn (head: str) ->
  let k0 = lex_const_key cref head in
  let k = (if str_eq k0 "" then anc_const_key world cref head else k0) in
  if (if str_eq k "" then false else true) then k
  else if map_has consts head then head
  else if (let k = lex_autoload_key cref head in
           if str_eq k "" then false else autoload_fire env world blk k) then
    (let k2 = lex_const_key cref head in
     if (if str_eq k2 "" then false else true) then k2
     else if map_has consts head then head else "")
  else ""
and const_walk_go = fn env -> fn world -> fn blk -> fn (sofar: str) -> fn (rest: str) ->
  if str_eq rest "" then (if map_has consts sofar then map_get consts sofar else VNil)
  else
    // A constant bound to a module IS that module's namespace, so follow the
    // binding before appending: after `REGEXP = RFC2396_REGEXP`,
    // `REGEXP::PATTERN` has to find `RFC2396_REGEXP::PATTERN`.
    // ...and a constant bound to anything else is not a namespace at all.
    let sofar = (if map_has consts sofar then
                   (match map_get consts sofar with
                    | VClass c -> c
                    | other -> (let _ = raise_exc world "TypeError" (inspect other ++ " is not a class/module") in sofar))
                 else sofar) in
    let seg = const_head rest in
    let key = sofar ++ "::" ++ seg in
    if map_has consts key then const_walk_go env world blk key (const_tail rest)
    else if autoload_fire env world blk key && map_has consts key
    then const_walk_go env world blk key (const_tail rest)
    else VNil

and autoload_fire = fn env -> fn world -> fn blk -> fn (key: str) ->
  if map_has autoloads key then
    (let path = (match map_get autoloads key with VStr h -> sget h | _ -> "") in
     // removed FIRST: a file that does not define the constant must fail as a
     // NameError, not spin here.
     let _ = map_delete autoloads key in
     if str_eq path "" then false
     else (let _ = exec_stmt env world blk (SRequire (false, EStrL path)) in true))
  else false

