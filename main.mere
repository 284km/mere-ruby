    "\n" ++
    "  def size\n" ++
    "    @string.length\n" ++
    "  end\n" ++
    "\n" ++
    "  def length\n" ++
    "    @string.length\n" ++
    "  end\n" ++
    "\n" ++
    "  def rewind\n" ++
    "    @pos = 0\n" ++
