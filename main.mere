    // US-ASCII haystack split by an ASCII-only UTF-8 needle answers
    // US-ASCII pieces, exactly as ruby's coderange logic does).
    (match recv with
     | VStr sh ->
       (let s = sget sh in
        match args with
        | Cons (VStr seph, _) ->
          (let _ = enc_pair_guard sh seph in
           let sep = sget seph in
           // the outer pieces keep SELF's encoding, the separator copy keeps
           // the PATTERN's; a miss keeps everything in self's.
           let t1 = fn (x: str) -> fn (e9: str) ->
             (let v = mkstr x in (match v with VStr id -> (let _ = senc_set id e9 in v) | _ -> v)) in
           let se = senc_get sh in
           let pe = senc_get seph in
           let i = (if str_eq name "partition" then str_find_from s sep 0
                    else str_rindex_go s sep (str_len s - str_len sep)) in
           if i < 0 then
             (if str_eq name "partition"
              then arr_new (Cons (t1 s se, Cons (t1 "" se, Cons (t1 "" se, Nil))))
              else arr_new (Cons (t1 "" se, Cons (t1 "" se, Cons (t1 s se, Nil)))))
           else arr_new (Cons (t1 (substring s 0 i) se,
                               Cons (t1 sep pe,
                                     Cons (t1 (substring s (i + str_len sep) (str_len s)) se, Nil)))))
        | Cons (other, _) -> prim_raise "TypeError" ("type mismatch: " ++ class_name other ++ " given")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr name) in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: undefined method '" ++ name ++ "'"))) in fail "mere-ruby: undefined method")))
  else if str_eq name "delete_prefix" then
    // only WHOLE characters come off: a byte-prefix that would cut into a
    // multibyte character (the next byte is a continuation) removes nothing.
    (match recv with
     | VStr sh ->
       (let s = sget sh in
        match args with
        | Cons (VStr p, _) ->
          let p = sget p in
          let k = str_len p in
          if str_starts_with s p
             && (if str_eq (enc_canon_name (senc_get sh)) "UTF-8" && k < str_len s
                    && (let o = ord (char_at s k) in o >= 128 && o < 192) then false else true)
          then mkstr (substring s k (str_len s)) else mkstr s
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | _ -> mkstr s)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "delete_prefix") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'delete_prefix'")) in fail "mere-ruby: undefined method 'delete_prefix'")))
  else if str_eq name "delete_suffix" then
    (match recv with
     | VStr sh ->
       (let s = sget sh in
        match args with
        | Cons (VStr p, _) ->
          let p = sget p in
          let cut = str_len s - str_len p in
          if str_ends_with s p
             && (if str_eq (enc_canon_name (senc_get sh)) "UTF-8" && cut > 0 && cut < str_len s
                    && (let o = ord (char_at s cut) in o >= 128 && o < 192) then false else true)
          then mkstr (substring s 0 cut) else mkstr s
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | _ -> mkstr s)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "delete_suffix") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'delete_suffix'")) in fail "mere-ruby: undefined method 'delete_suffix'")))
  else if str_eq name "scrub" then
    (match recv with
     | VStr h ->
       (let s = sget h in
        let e = enc_canon_name (senc_get h) in
        let rep = (match args with
                   | Cons (VStr rh, _) ->
                     (let re2 = enc_canon_name (senc_get rh) in
                      let _ = (if enc_valid (sget rh) re2 then ()
                               else (let _ = prim_raise "ArgumentError" ("replacement must be valid byte sequence '" ++ sget rh ++ "'") in ())) in
