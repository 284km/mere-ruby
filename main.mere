     | VStr h ->
       let e = enc_canon_name (senc_get h) in
       let form = (match args with Cons (VSym f, _) -> f | _ -> "nfc") in
       (if (if str_eq form "nfc" || str_eq form "nfd" || str_eq form "nfkc" || str_eq form "nfkd" then false else true)
        then prim_raise "ArgumentError" ("invalid normalization form :" ++ form)
        else if (if str_eq e "UTF-8" then false
