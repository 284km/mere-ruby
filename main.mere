     | Cons (v2, t) -> (if rb_eq_w env world v2 v then k else hash_key_of_w env world t v)
     | Nil -> VNil)

// THE HASH KEY PROTOCOL, written once. Ruby buckets a key by #hash and
// compares within a bucket by #eql?; mere-ruby compares STRUCTURE, which
// happens to agree for ordinary keys and asks the object nothing -- so a key
// with its own #hash never heard from Hash at all, and two keys whose hashes
// differ were merged when their structure matched.
// ⚠ every door has to use it or two spellings of one operation disagree:
//   `h[k]=`, `store`, `send(:[]=)`, `[]`, `fetch`, `delete`, `key?`. The three
//   store doors go through hash_put_wx below; the read doors through the arm
//   in the dispatcher.
and key_has_user_hash = fn world -> fn (k: Val) ->
