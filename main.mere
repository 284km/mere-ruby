  // them. A user override wins, which is what the has_meth guard is for.
  // ...and they are PRIVATE, so a plain `obj.initialize_copy(x)` is refused
  // rather than run (the refusal is the is_kernel_priv_only arm further in).
  // `send` and an override's `super` both arrive with vischeck off.
  if (str_eq name "initialize_copy" || str_eq name "initialize_dup"
      || str_eq name "initialize_clone")
     && (if vischeck then false else true)
     && (if has_meth world (dispatch_cls_of world recv) name then false else true) then
