// mere-ruby — a Ruby subset interpreter written in pure Mere. M0 + M1.
// NOTE: no `extern fn getenv` — an extern returning `str` yields a raw C
// pointer, not a Mere string, and using it for anything but printing
// segfaults. The environment is read through env(1); see env_load.
//
// M0: literals (integer, float, string, true/false/nil, array, hash),
// operators with Ruby precedence (** right-assoc, unary - !, * / %, + -,
// comparisons, == !=, && ||), parentheses, comments, and `puts`.
// Ruby semantics where they differ from C: floor division and
// sign-of-divisor modulo, value-returning && / ||, truthiness (only nil
// and false are falsy — 0 is truthy), puts flattening arrays recursively.
//
// M1: local variables (assignment / reassignment; the environment is a
// Mere Map, whose insertion-ordered semantics match Ruby's), and block
// control flow: if / elsif / else, unless, while, until, case / when
// (with multi-value `when a, b`), all with the multi-line ... end form.
//
// Verification: every corpus program must print byte-identical output to
// the reference `ruby` (see run_corpus.sh).
//
//   mere -c main.mere > mr.c && clang -O2 mr.c -o mere-ruby
//   ./mere-ruby script.rb

// ---- values and syntax trees --------------------------------------------
type Tok = TInt of int | TFlt of float | TStrL of str | TId of str
         | TBig of str  // an integer literal too large for a machine int
         // Rational literal as (num, den) canonical decimal strings (bignum /
         // exact-decimal safe); Complex (imaginary) literal `4i`.
         | TRat of str * str | TImag of int | TImagF of float | TImagRat of str * str
         | TSym of str | TP of str | TRegex of str * str | TNL of int | TEOF;

// EHsh / VHsh hold interleaved [k1, v1, k2, v2, ...] lists (M0
// simplification: literal order is preserved, which matches Ruby's
// insertion-ordered Hash for programs that only build literals).
type Expr = EInt of int | EBig of str | ERat of str * str | EImag of int | EImagF of float | EImagRat of str * str | EFlt of float | EStrL of str | EBool of bool
          | ENil | EArr of Expr list | EHsh of Expr list
          | EBin of str * Expr * Expr | EUn of str * Expr
          | EVar of str | ECall of str * Expr list
          // M3 object model:
          | ESym of str          // :name
          | ESelf                // self
          | EConst of str        // a capitalized name (a class reference)
          | EConstOrNil of str   // a const read that yields nil when undefined
          | EScopedAssign of Expr * str * Expr  // recv::Const = value (runtime recv)
          | EScopedRead of Expr * str  // recv::Const read (runtime recv)
          | EScopedReadOrNil of Expr * str  // recv::Const read, nil if undefined (for ||=)
          | EIVar of str         // @name
          | EMethod of Expr * str * Expr list  // recv.name(args)
          // op-assign on an attribute / index, evaluating recv (and indices)
          // exactly once: recv.name op= rhs / recv[idx..] op= rhs.
          | EAttrOp of Expr * str * str * Expr
          | EIdxOp of Expr * Expr list * str * Expr
          // M4 blocks / iterators:
          | ERange of Expr * Expr * bool         // lo..hi (bool = exclusive)
          // `name [items]` (space before bracket): indexing when name is a
          // live local, else a call with one array argument. Decided at eval.
          | EAmbigIdx of str * Expr list
          // a range in condition position: the flip-flop operator. The int
          // is the site id keying its hidden on/off state.
          | EFlipFlop of int * Expr * Expr * bool
          | EYield of Expr list                  // yield(args)
          // a call/method with a trailing block { |bp| body }: block params
          // and block body come last.
          | ECallB of str * Expr list * str list * Stmt list
          | EMethodB of Expr * str * Expr list * str list * Stmt list
          // M6 exceptions:
          | ERaise of Expr list                  // raise [Class][, msg]
          // M9: a splat argument `*expr` at a call site (expands an array).
          | ESplat of Expr
          // 2f: ternary `cond ? a : b`.
          | ETern of Expr * Expr * Expr
          // 2i: subjectless `case` marker (when-conditions are truthiness
          // tests); `defined?(e)` returns a description string or nil.
          | ECaseNone
          | EDefined of Expr
          // 2k: super. bool = zsuper (bare `super`, forward current args);
          // when false the args are explicit (super() or super(a, b)).
          | ESuper of bool * Expr list
          | ESuperB of bool * Expr list * str list * Stmt list  // super with a block
          // 2m: `&expr` block-pass marker in an argument list (only &:sym is
          // turned into a real block; other forms are best-effort).
          | EBlockPass of Expr
          // G2: assignment as an expression (`true && x = 1`, `f(x = 2)`).
          | EAssign of str * Expr
          // G2: -> (params) { body } lambda literal.
          | ELambda of str list * Stmt list
          // G2: a statement (if/unless/case/begin) used as an expression,
          // e.g. `if c ... end.should == x`.
          | EStmt of Stmt
          // G2: /pattern/ regex literal (body, flags e.g. "im").
          | ERegex of str * str
          // G2: break/next/redo/return in EXPRESSION position (fail-unwind).
          | EFlow of str * Expr
          // G3: safe navigation a&.b(args) — nil receiver yields nil.
          | ESafe of Expr * str * Expr list
          | ESafeB of Expr * str * Expr list * str list * Stmt list  // a&.m { blk }
          // G3: **hash argument at a call site.
          | EKwSplat of Expr
          // a trailing keyword-argument hash from `key: value` call syntax
          // (distinct from a `{...}` hash literal so kwargs and a positional
          // hash argument can be kept separate, per Ruby 3.0).
          | EKwHash of Expr list
          // one-line pattern matching: `expr in pat` yields true/false;
          // `expr => pat` matches-or-raises NoMatchingPatternError (value nil).
          | EMatchTest of Expr * Pat
          | EMatchBind of Expr * Pat;

// SIf: clause list ((condition, body) pairs — the if plus each elsif)
// and the else body (Nil when absent). unless / until desugar to a
// negated condition at parse time. SCase: subject, when-clauses (each:
// candidate values, body), else body. SDef: name, params, body.
// M3: SClass name, superclass ("" = none), body (defs / attrs);
// SIVarAssign @name = e; SAttr mode ("r"/"w"/"rw"), symbol names.
type Stmt = SPuts of Expr list | SExpr of Expr
          // where the statement that follows was written. The parser emits one
          // before each statement it reads (see parse_stmts); the evaluator sets
          // the current line from it, which is what lets an error name a line.
          | SLine of int
          // ... and one at the head of each parsed statement list, naming the
          // file. `load_ctx` knows the file being LOADED, which stops being the
          // right answer the moment a method is called after its file finished.
          | SFile of str
          | SAssign of str * Expr
          | SIf of (Expr * Stmt list) list * Stmt list
          | SWhile of Expr * Stmt list
          | SCase of Expr * (Expr list * Stmt list) list * Stmt list
          // SDef: name, param names, (name, default-expr) for defaulted
          // params, body.
          | SDef of str * str list * (str * Expr) list * Stmt list
          | SReturn of Expr
          | SBreak of Expr | SNext of Expr
          | SClass of str * str * Stmt list
          // like SClass but the superclass is a runtime expression (evaluated
          // to a Class; a non-Class / module / singleton raises TypeError).
          | SClassE of str * Expr * Stmt list
          | SIVarAssign of str * Expr
          | SAttr of str * str list
          // M6: begin body / rescue clauses (class names, var, handler) /
          // else body / ensure body.
          | SBegin of Stmt list * (str list * str * Stmt list) list * Stmt list * Stmt list
          // BEGIN { } runs first in its code unit (hoisted); END { } runs at
          // exit. Distinct from a plain begin/end so run_prog/eval can order them.
          | SPreexe of Stmt list
          | SAtExit of int * Stmt list   // END { }: site id, body
          // `class << <expr>` — open the singleton class of an arbitrary
          // expression receiver (a literal / paren-expr / ivar), the general
          // form of `class << self` / `class << obj`.
          | SSingletonE of Expr * Stmt list
          // `var = <stmt>` where stmt is a begin/end used as a value: run
          // the statement, bind its value (else propagate return/raise).
          | SLocalFrom of str * Stmt
          // M8: multiple assignment. Targets are encoded names — a plain
          // local, "@name" for an ivar, "*name" for a splat. The RHS is one
          // or more expressions (one array is destructured; several values
          // form the array).
          | SMultiAssign of str list * Expr list
          // multiple assignment with complex targets (foo[0], bar.baz = ...):
          // each target is EVar / EIVar / ESplat / EMethod (indexing or attr).
          | SMultiAssignX of Expr list * Expr list
          // 2h: `alias new old` (copy a method); `include M` (mix a module's
          // instance methods into the class).
          | SAlias of str * str
          | SInclude of str * bool   // module name, prepend?
          // 2n: `undef name[, name]` removes method definitions.
          | SUndef of str list
          // 2t: visibility — `private` / `private :m, :n` (mode, names;
          // empty names = switch the mode for subsequent defs).
          | SVis of str * str list
          // 2u: declare locals as nil if not yet bound — Ruby defines the
          // targets of an assignment even when a guard skips executing it.
          | SDeclare of str list
          // G2: require / require_relative (bool = relative), path expr.
          | SRequire of bool * Expr
          // G2: low-precedence `stmt and stmt` / `stmt or stmt`.
          | SAndThen of Stmt * Stmt
          | SOrElse of Stmt * Stmt
          // G2: `begin ... end while/until c` — run body, then loop while
          // the (already-negated-for-until) condition holds.
          | SDoWhile of Stmt * Expr
          // pattern matching `case subj / in pat [guard] / ... [else] / end`.
          // Each clause is (pattern, guard-expr, body); the guard is EBool true
          // when absent (an `unless` guard is negated at parse time). The bool
          // is has-else; els is the else body (run when no pattern matches, or
          // NoMatchingPatternError is raised when has-else is false).
          | SCaseIn of Expr * (Pat * Expr * Stmt list) list * bool * Stmt list;

// A case/in pattern.
type Pat = PVar of str                       // binds a local (`_`/`_x` allowed, repeatable)
         | PVal of Expr                      // value pattern — matched with === (case_eqq)
         | PPin of Expr                      // ^expr — matched with == (rb_eq)
         | PSplatP of str                    // *name array element ("" = anonymous)
         | PArrP of Pat list                 // [p, ...] (a PSplatP element = splat)
         // {k: p, ...}; rest: "" open (extra keys allowed unless empty),
         // "nil" = **nil (no extra keys), "*" = ** anonymous rest, else **name.
         | PHashP of (str * Pat) list * str
         | PAltP of Pat list                 // p | p | ...
         | PAsP of Pat * str                 // pat => name
         | PConstP of Expr * Pat;            // Const[..] / Const(..): === then match inner

// VObj holds an object id (a handle into the world's object tables);
// VClass holds a class name. VSym is a Ruby symbol. VRange is lo..hi with
// a bool for the exclusive form (1...5).
// M10: arrays are mutable reference types, so VArr is a HANDLE (an id into
// the top-level arr_store); its contents live in the store and are shared
// by all aliases. VHsh stays an immutable value list (hash mutation is a
// later milestone).
type Val = VInt of int | VFlt of float | VStr of int | VBool of bool
         // arbitrary-precision integer, held as a canonical decimal string
         // (no leading zeros; "-" prefix if negative; never a value that
         // fits in a machine int — those stay VInt).
         | VBig of str
         // Rational num/den (den > 0, gcd-reduced) and Complex real/imag.
         | VRat of str * str
         | VCpx of Val * Val
         | VNil | VArr of int | VHsh of int
         | VObj of int | VClass of str | VSym of str
         // A Range holds its bounds AS VALUES: an integer range is the common
         // one, but ruby also has ("a".."z"), (1.0..2.0), a Time range, and an
         // endless / beginless one (VNil for the missing side). Storing two
         // ints meant a string range materialised into an Array -- a value
         // whose `class` was a lie -- and an endless one clamped to the
         // largest integer.
         | VRange of Val * Val * bool
         | VExc of str * str    // exception: class name, message
         | VProc of int         // a proc/lambda: a handle into proc_store
         | VBind of int         // a Binding: a handle into bind_store (captured env)
         | VRegex of str * str  // /pattern/flags (minimal matcher)
         | VMain;               // the top-level `self` (main), class Object

// A user method: parameter names, defaults ((name, default-expr) for
// params with `= default`), and body. Stored in the methods table (a
// Map[str, Meth]) keyed by bare name (top-level) or "Class#name".
type Meth = Meth of str list * (str * Expr) list * Stmt list;

// Statement execution result: FNext carries the statement's value (so a
// method's implicit return is its last statement's value); FReturn is a
// non-local exit carrying an explicit `return` value up through enclosing
// blocks and loops to the method boundary.
// FRaise signals that a Ruby exception unwound to a begin/rescue (the
// exception value itself is stashed in the world's ivars under "$exc",
// since raise unwinds via Mere's `fail` and try_or yields only a default).
// FBreak / FLoopNext are loop control (break / next), caught by the
// enclosing while loop; FReturn / FRaise propagate to the method / rescue.
type Flow = FNext of Val | FReturn of Val | FRaise of Val
          | FBreak of Val | FLoopNext of Val;

// ---- regex AST (compiled engine) -----------------------------------------
// Character-class atoms. Ranges compare byte strings directly (Mere string
// comparison is lexicographic on bytes).
type RCls = CChr of str | CRange of str * str
          | CDigit | CWord | CSpace | CHex
          | CNDigit | CNWord | CNSpace | CNHex
          | CPosix of str * bool;
// Pattern AST. The i/m/x flags are fully resolved at PARSE time: i turns
// letters into NCharCI and sets the class ci bit, m turns `.` into NAnyNL,
// x is consumed by the parser (whitespace/#-comments). Ruby's ^/$ are always
// line anchors (m affects only `.`); \A/\z/\Z are the string anchors.
// NFlagsRest is parser-internal: `(?im)` applies to the rest of the sequence.
type RNode = NChar of str | NCharCI of str | NAny | NAnyNL
           | NClass of RCls list * bool * bool     // items, negated, ci
           | NSeq of RNode list | NAlt of RNode list
           | NRep of RNode * int * int * bool      // body, min, max (-1 = inf), greedy
           | NGroup of RNode * int * str           // body, gnum (0 = shy), name
           | NBackref of int * bool                // group, ci
           | NBOL | NEOL | NBOS | NEOS | NEOSNL | NGANCHOR
           | NWordB of bool
           | NLook of RNode * bool | NLookB of RNode * bool   // body, negated
           | NAtomic of RNode                       // (?>...) atomic group
           | NFlagsRest of str
           | NEmpty;
// Compiled instructions (a program is an int-key Map "0".."N-1" -> RInst,
// plus "meta" -> IMeta (count, ngroups) and "name:<x>" -> IMeta (gnum, 0)).
type RInst = IChar of str | ICharCI of str | IAny | IAnyNL
           | IClass of RCls list * bool * bool
           | ISplit of int * int | IJmp of int | ISave of int
           | IBOL | IEOL | IBOS | IEOS | IEOSNL | IGANCHOR
           | IWordB of bool | IBackref of int * bool
           | ILook of int * bool | ILookB of int * int * int * bool
           | IAtomic of int
           | IMark of int | ICheck of int * int
           | IOk | IOkAt | IMatch
           | IMeta of int * int;
// VM results: a match's end index + capture saves (immutable assoc list,
// newest first), and the search wrapper's hit / no-hit / uncompilable-pattern.
type RxRes = RFound of int * (int * int) list | RFail;
type RxHit = RHit of int * int * (int * int) list | RNoHit | RBadPat;

// DEFLATE comes from the mgz package, vendored under .mere_modules/. Zlib's
// streams are the same RFC 1951 body under a different wrapper, so mere-ruby
// only adds the zlib header/Adler-32 around what mgz already computes.
import "mgz/inflate.mere";
import "mgz/deflate.mere";

// ---- mutable-array store (M10) ------------------------------------------
// A single top-level Map captured by every function below (no threading):
// id (as str) -> the array's contents (a Val list). Arrays are handles
// (VArr id) into it, so aliases share one mutable list. A fresh id is
// map_len arr_store (arrays are never removed — memory grows, acceptable).

// ---- TCP (the `socket` capability) ---------------------------------------
// Mere's own byte-level socket FFI: the same externs mkv uses. Reads and
// writes cross through the shared byte arena (`mem_*`), so a payload with a
// zero byte survives. The Wasm host has no sockets and stubs these to -1.
extern fn tcp_connect: str -> int -> int;
extern fn tcp_listen: int -> int;
extern fn tcp_accept: int -> int;
extern fn tcp_read: int -> int -> int -> int;
extern fn tcp_write: int -> int -> int -> int;
extern fn tcp_close: int -> unit;
extern fn tcp_set_timeout: int -> int -> int;
extern fn mem_alloc: int -> int;
extern fn mem_to_str: int -> int -> str;
extern fn mem_copy_str: int -> int -> str -> int;
extern fn mem_set_u8: int -> int -> int -> int;
// libc's getpid: Process.pid has to be the real one -- a made-up number would
// be a stable lie, and sidekiq builds its identity string from it.
extern fn getpid: unit -> int;
// one arena block, reused: 64 KiB is the read size and the write chunk.

// Object ids come from a counter carried IN the ocls map itself (special key
// "$next", preserved by the collector's rebuild) -- not from map_len. With a
// collector dropping dead entries, map_len shrinks and a fresh object would
// collide with a survivor's id. The first call seeds from map_len, so a world
// built before any allocation behaves exactly as the old scheme did.
let alloc_oid = fn om ->
  let id = (if map_has om "$next" then int_of_str (map_get om "$next") else map_len om) in
  let _ = map_set om "$next" (str_of_int (id + 1)) in
  id;
let arr_store = map_new () in
// Array ids come from a counter: the collector deletes dead entries now, so
// map_len shrinks and a length-derived id would collide with a survivor's.
let arr_ctr = map_new () in
let arr_new = fn (xs: Val list) ->
  let id = (if map_has arr_ctr "n" then map_get arr_ctr "n" else 0) in
  let _ = map_set arr_ctr "n" (id + 1) in
  let _ = map_set arr_store (str_of_int id) xs in
  VArr id;
let deref = fn (id: int) -> map_get arr_store (str_of_int id);
let arr_set = fn (id: int) -> fn (xs: Val list) ->
  let _ = map_set arr_store (str_of_int id) xs in ();

// strings are mutable reference types too (Ruby semantics): VStr is a HANDLE
// into str_store, so aliases share one mutable string. Fresh id per literal
// evaluation — entries are never removed. A vec gives O(1) alloc/get/set
// (string allocation is far hotter than array allocation).
let str_store = vec_new () in
let mkstr = fn (s: str) ->
  let id = vec_len str_store in
  let _ = vec_push str_store s in
  VStr id;
let sget = fn (id: int) -> vec_get str_store id;
let sset = fn (id: int) -> fn (s: str) ->
  let _ = vec_set str_store id s in ();
// Kernel#gets state: stdin is slurped once (read_stdin) into stdin_src "s",
// then handed out one line at a time via a cursor stdin_src_pos "p". Lets
// `while line = gets` terminate at EOF (nil) the way Ruby does.
let stdin_src = map_new ();
let stdin_src_pos = map_new ();
// hashes are mutable reference types too: VHsh is a HANDLE into hash_store,
// which holds the interleaved [k1,v1,k2,v2,...] pair list. Aliases share one
// mutable hash (h[k]=v is seen through every reference).
let hash_store = vec_new () in
// The signal names a program may trap. mere-ruby never delivers one -- nothing
// here is a source of signals -- so this is a NAME table, used by Signal.list and
// Signal.signame, and the handlers a program registers live in signal_traps
// unread. A CLI traps INT before doing anything else, so answering matters more
// than refusing; the limit is in KNOWN_GAPS.
let signal_traps = map_new ();
let signal_names = "EXIT:0 IOT:6 EMT:7 CLD:20 HUP:1 INT:2 QUIT:3 ILL:4 TRAP:5 ABRT:6 FPE:8 KILL:9 BUS:10 SEGV:11 SYS:12 PIPE:13 ALRM:14 TERM:15 URG:16 STOP:17 TSTP:18 CONT:19 CHLD:20 TTIN:21 TTOU:22 IO:23 XCPU:24 XFSZ:25 VTALRM:26 PROF:27 WINCH:28 INFO:29 USR1:30 USR2:31";
let mkhash = fn (xs: Val list) ->
  let id = vec_len hash_store in
  let _ = vec_push hash_store xs in
  VHsh id;
let hderef = fn (id: int) -> vec_get hash_store id;
let hset = fn (id: int) -> fn (xs: Val list) ->
  let _ = vec_set hash_store id xs in ();
// per-hash default value for missing keys (Hash.new(d)); keyed by handle id.
let hash_dflt = map_new () in
let hdflt_set = fn (id: int) -> fn (v: Val) -> let _ = map_set hash_dflt (str_of_int id) v in ();
let hdflt_get = fn (id: int) -> if map_has hash_dflt (str_of_int id) then map_get hash_dflt (str_of_int id) else VNil;
// Hash.new { |h, k| ... }: the block form of the default, kept as a proc
// handle per hash so a miss can call it with (hash, key).
let hash_dproc = map_new () in
let hdproc_set = fn (id: int) -> fn (v: Val) -> let _ = map_set hash_dproc (str_of_int id) v in ();
let hdproc_get = fn (id: int) -> if map_has hash_dproc (str_of_int id) then map_get hash_dproc (str_of_int id) else VNil;
// per-string encoding label (str handle id -> encoding name); default UTF-8.
let str_enc = map_new () in
// The ABSENCE of an entry means UTF-8 (senc_get, below), so writing "UTF-8" says
// nothing the absence did not -- and it says it permanently: a container here
// never gives its memory back, so every redundant entry is a permanent one. A
// census of 200k interpolated strings found 1.2M entries in this map, six per
// string, nearly all of them "UTF-8". A string that is already tagged is a
// different matter: setting UTF-8 there is a real change, and has to remove the
// tag rather than skip the write.
let senc_set = fn (id: int) -> fn (nm: str) ->
  if str_eq nm "UTF-8"
  then (if map_has str_enc (str_of_int id)
        then (let _ = map_delete str_enc (str_of_int id) in ())
        else ())
  else (let _ = map_set str_enc (str_of_int id) nm in ());
let senc_get = fn (id: int) -> if map_has str_enc (str_of_int id) then map_get str_enc (str_of_int id) else "UTF-8";
// frozen-string tracking + CLI frozen-string-literal mode + __FILE__ path.
let str_frozen = map_new () in
let sfrozen_set = fn (id: int) -> let _ = map_set str_frozen (str_of_int id) "1" in ();
let sfrozen_get = fn (id: int) -> map_has str_frozen (str_of_int id);
// frozen state of ordinary objects (keyed by object id string), consulted by
// #frozen? on the object and on its singleton class.
// frozen state of arrays / hashes. Arrays and hashes live in separate stores,
// so their handle ids overlap: the key needs the kind ("a" / "h") or freezing
// array #7 would make hash #7 report frozen too.
let coll_frozen = map_new () in
let cfrozen_set = fn (k: str) -> fn (id: int) -> let _ = map_set coll_frozen (k ++ str_of_int id) "1" in ();
let cfrozen_get = fn (k: str) -> fn (id: int) -> map_has coll_frozen (k ++ str_of_int id);
let obj_frozen = map_new () in
let ofrozen_set = fn (id: int) -> let _ = map_set obj_frozen (str_of_int id) "1" in ();
let ofrozen_get = fn (id: int) -> map_has obj_frozen (str_of_int id);
let ofrozen_key = fn (k: str) -> map_has obj_frozen k;
let cli_fsl = map_new () in   // key "on" present => --enable-frozen-string-literal
let cli_file = map_new () in  // key "p" -> the running script's path (__FILE__)
let fsl_on = fn () -> map_has cli_fsl "on";
let script_file = fn () -> if map_has cli_file "p" then map_get cli_file "p" else "-";
// lexical constant scope (cref): the class whose body is currently being run
// ("" = top level). Captured per method at `def` time (meth_cref) and consulted
// when resolving a bare Constant, so `Const` means the lexically-nearest one.
let lex_cref = map_new () in
let cur_lex = fn () -> if map_has lex_cref "c" then map_get lex_cref "c" else "";
let set_lex = fn (c: str) -> let _ = map_set lex_cref "c" c in ();
let meth_cref = map_new () in
// the shared Encoding objects, keyed by canonical name; enc_name maps an
// Encoding object's handle id -> name so the (world-free) printer can format it.
let enc_objs = map_new () in
let enc_name = map_new () in
// The whole match, by MatchData object id. `to_s` has no world to reach the
// ivars through, and bootstraptest PRINTS its results -- a MatchData that
// printed as "#<object>" is how this was found.
let md_whole = map_new () in
// A Time's instant, by object id. Comparison (cmp_vals) has no world to reach
// the ivars through, and a Range of Times has to be able to compare its
// bounds -- `(t1..t2).cover?(t)` is the case that found this.
let time_inst = map_new () in
// dummy encodings (stateful/wide converters, CRuby's list); a dummy is never
// ASCII-compatible, and neither is any UTF-16/UTF-32 variant.
let enc_is_dummy = fn (nm: str) ->
  str_eq nm "UTF-16" || str_eq nm "UTF-32" || str_eq nm "IBM037" ||
  str_eq nm "ISO-2022-JP" || str_eq nm "ISO-2022-JP-2" || str_eq nm "ISO-2022-JP-KDDI" ||
  str_eq nm "CP50220" || str_eq nm "CP50221" || str_eq nm "UTF-7" in
let enc_ascii_compat = fn (nm: str) ->
  if enc_is_dummy nm then false
  else if str_len nm >= 6 && (str_eq (substring nm 0 6) "UTF-16" || str_eq (substring nm 0 6) "UTF-32") then false
  else true in
// procs/lambdas are handles into this store, which holds their block
// (has, params, body, captured env) — the env is a Map, so like arrays a
// proc lives behind an int handle rather than inside the Val variant.
let proc_store = map_new ();
// proc id -> the block in scope where the proc/lambda was created, so that
// `yield` inside a proc body resolves to the DEFINING method's block (Ruby
// semantics), not the block of whatever method later runs the proc.
let proc_yblk = map_new ();
let yblk_marker = "__yblk__~";
// proc ids created via `lambda` — lambdas check arity strictly on call.
let lambda_ids = map_new ();
// A proc built from something that already knows its arity (Method#to_proc,
// where ruby's answer is the METHOD's arity, not the `*args` forwarder's).
let proc_arity = map_new ();
// a sentinel prepended to a block's params when a lambda is installed as a
// block (via &lambda): run_block detects it, strips it, and enforces strict
// arity (a lambda yielded to raises ArgumentError on a count mismatch, unlike
// a plain block). This threads lambda-ness through the existing 4-tuple.
let lambda_blk_marker = "__lambda_blk__";
// display name for an anonymous class/module once it is assigned to a
// constant (internal "AnonClass_N"/"AnonModule_N" -> the constant's name).
let anon_name = map_new ();
// a define_method block captures the block active where it was defined, so a
// `yield` inside the defined method reaches that block. Keyed "Cls#name" ->
// VProc of the captured block (installed by invoke when the call site passes
// no block of its own).
// The name of the method running at each call depth. One map_set per call,
// on the same path that already counts depth, so it costs a store and no
// bookkeeping -- and it is the only thing resembling a backtrace mere-ruby
// has. MERE_RUBY_STACKTRACE=1 dumps the innermost frames when the recursion
// guard trips, which is how an unbounded recursion names itself.
// set the first time any class defines `method_added`, so the per-def hook
// check is a single map lookup in the overwhelmingly common case (nobody
// defines one) rather than an ancestor walk.
let hook_flags = map_new ();

// Kernel#set_trace_func: the proc ruby hands every event to. Kept behind a
// flag in hook_flags, so a program that never installs one pays a single map
// lookup per method call -- the same shape TracePoint(:class) uses.
let trace_fn = map_new ();
// Marshal's symbol table: symbols are written once and back-referenced by
// index afterwards, so a load has to remember them in order.
let mrsh_syms = map_new ();
// Marshal.dump's own symbol table: the format writes a symbol once and refers
// to it by index afterwards, and every UTF-8 String carries the :E ivar, so
// without the table the output is valid but never byte-identical to ruby's.
let mrsh_dsyms = map_new ();
// the position a lookbehind body must end at, so that its own backtracking
// picks a branch of the right length. Saved and restored around each attempt
// (a lookbehind may contain another one).
let rxv_lb_end = map_new ();
let dm_captured = map_new ();
// whether the frame a define_method block was written in had a block of its
// own -- the answer `block_given?` gives inside the defined method
let dm_had_blk = map_new ();
// methods defined via define_method, keyed "Cls#name". A bare (implicit-args)
// `super` inside such a method raises RuntimeError in Ruby, since a block has
// no fixed argument list to forward.
let dm_methods = map_new ();
// a define_method block/lambda is a closure over the scope where it was
// defined, so the defined method's body can read those locals. Keyed
// "Cls#name" -> VProc whose stored block carries the captured env; run_meth
// seeds the call frame from it (see dm_store_closure).
let dm_closenv = map_new ();
// an aliased method remembers the class/module its source was defined in,
// keyed "Cls#newname" -> origin class. A `super` inside the aliased method
// resumes above the ORIGIN, not above the class the alias lives in.
let alias_origin = map_new ();
// the original name an alias was made from, keyed "Cls#newname" -> old name,
// so a `super` inside the aliased method searches for the SOURCE method name.
let alias_srcname = map_new ();
// alias_method whose SOURCE is a builtin (e.g. `alias_method :plus, :+` on a
// String subclass): keyed "Cls#newname" -> builtin op name. Dispatched by
// delegating to prim_method on the receiver, since the source has no AST body.
let builtin_alias = map_new ();
// `Warning[:deprecated] = true` — the warning-category switches, remembered so
// a program reads back what it set.
let warn_cats = map_new ();
// `trace_var(:$g) { }`: the proc to run when that global is assigned. Behind
// the "gvt" hook flag, so an untraced program pays one map lookup per global
// write and nothing else.
let gvar_traces = map_new ();
// `/.../o` results, keyed by the literal's source site (file:offset).
let rx_once = map_new ();
// hash handles that originate from keyword-argument syntax (`key: v` / `**h`)
// at a call site, as opposed to a positional `{...}` literal or hash variable.
// Ruby 3.0 keeps these separate: only a kwarg-origin trailing hash binds to a
// method's keyword / **kwrest parameters; a positional hash stays positional.
let kwarg_marks = map_new ();
let mark_kw = fn (id: int) -> let _ = map_set kwarg_marks (str_of_int id) VNil in ();
let is_kw_hash = fn (v: Val) -> match v with VHsh id -> map_has kwarg_marks (str_of_int id) | _ -> false;
// methods marked `ruby2_keywords` (by bare name): a trailing `key:` hash they
// receive into *args keeps its kwarg mark instead of being demoted, so a later
// re-splat forwards it as keywords. Cleared when the method is redefined.
let r2k_methods = map_new ();
// refinements. `refine Target do ... end` (inside a Module.new body) records,
// per refinery module, the target class and a fresh impl_cls class holding the
// refined methods. `using refinery` activates them into ref_active (target
// class name -> impl_cls class name); register_class save/restores ref_active so a
// `using` inside a module body is scoped to that body (Ruby's lexical scope).
let refine_cnt = map_new ();   // "<refinery>"      -> VInt count
let refine_tgt = map_new ();   // "<refinery>#<i>"  -> VStr target class
let refine_cls = map_new ();   // "<refinery>#<i>"  -> VStr impl_cls class
let ref_active = map_new ();   // "<target>"        -> VStr impl_cls class
// per-case memo of #deconstruct / #deconstruct_keys results, so a case with
// several `in` clauses calls the method once (Ruby caches). Keyed by value
// handle; cleared at the start of each case.
let deco_memo = map_new ();
// Binding objects: id -> the captured local-variable env (which already
// holds "self"). `binding` captures the current env; eval(str, b) and
// b.eval(str) re-enter the interpreter against it.
// The shared placeholder cenv for blk tuples built without a real captured
// env. It must be A map of the env type -- NOT ivars (that unified the world
// with the env region and pinned both to __heap; see the collector notes) --
// and it must be ONE map: a fresh map_new at each of the five sites sat on
// the object-creation path and cost ~200 bytes per `new`. Never read.
let gc_cenv0 = map_new ();
let bind_store = map_new ();
// snapshot a locals env by value: `binding` must capture the scope AS IT IS
// at capture time, isolated from same-named variables assigned in an
// enclosing scope afterward. The copy is still a persistent mutable Map, so
// eval(str, b) can define and read locals in the binding's own scope across
// calls. (A chained env is flattened first — see lv_flat.)
let map_copy = fn m ->
  let d = map_new () in
  let _ = map_iter m (fn (k: str) -> fn (v: Val) -> map_set d k v) in
  d;

// ---- lexical scope chain ------------------------------------------------
// A locals env is a Map, but Ruby blocks nest scopes: a block's params and
// the locals it first assigns are block-local, while a name bound further
// out stays the SAME cell (assigning it inside the block is visible after).
// So a block body runs in a fresh child frame linked to its defining scope:
// lookup walks the chain, and assignment writes to the frame that already
// binds the name, otherwise declaring it in the innermost one. Because a
// proc/lambda captures the frame itself, the block-locals it closes over
// outlive the invocation — Ruby's closure semantics, which a single flat map
// with save/restore teardown could not express (the teardown deleted the
// very bindings the closure had captured).
// The ancestor chain of a class is asked for on EVERY dispatch -- `i + 1`
// asks whether Integer (then Numeric, then Object) redefines `+` -- and
// rebuilding it means splitting the include lists and appending fresh string
// lists each time. It changes only when someone includes, prepends, or names
// a superclass, so it is memoized against a counter those bump.
//
// MERE_RUBY_NO_MRO_CACHE=1 turns the memo off and recomputes every time: the
// old definition kept as an oracle, so the two can be compared over the whole
// corpus rather than trusted.
let mro_gen = map_new ();
let mro_anc = map_new ();      // cls -> its linearized ancestors
let mro_anc_gen = map_new ();  // cls -> the generation that list was built at
let mro_mods = map_new ();     // cls -> the modules included into it, expanded
let mro_mods_gen = map_new ();
let mro_bump = fn () ->
  let n = (if map_has mro_gen "n" then map_get mro_gen "n" else 0) in
  map_set mro_gen "n" (n + 1);
let mro_now = fn () -> if map_has mro_gen "n" then map_get mro_gen "n" else 0;

let lv_up = map_new ();    // "<frame id>" -> that frame's parent env
let lv_ctr = map_new ();   // "n" -> next frame id
let lv_child = fn parent ->
  let e = map_new () in
  let n = (if map_has lv_ctr "n" then map_get lv_ctr "n" else 0) in
  let _ = map_set lv_ctr "n" (n + 1) in
  let _ = map_set e "__eid" (VInt n) in
  let _ = map_set lv_up (str_of_int n) parent in
  e;
// (has_parent, parent). There is no null env, so a root echoes itself back.
let lv_parent_of = fn env ->
  if map_has env "__eid" then
    (match map_get env "__eid" with
     | VInt n ->
       let k = str_of_int n in
       if map_has lv_up k then (true, map_get lv_up k) else (false, env)
     | _ -> (false, env))
  else (false, env);
// the frame that binds `n`, or `env` itself when no frame in the chain does
// (so a fresh assignment declares the local in the innermost frame).
// (found, frame) — the frame in the chain that binds `n`. When nothing binds
// it the flag is false and the frame is meaningless: callers that declare
// (lv_set) must fall back to the INNERMOST env they were handed, or a fresh
// block-local would be created out in the method scope and leak.
let rec lv_owner = fn env -> fn (n: str) ->
  if map_has env n then (true, env)
  else let (has, p) = lv_parent_of env in
       if has then lv_owner p n else (false, env);
// A frame that ESCAPES its call -- a proc/lambda body, a captured yield
// block, a Thread body -- must never be recycled into the frame pool, and
// neither may any parent on its scope chain (the proc reads and writes
// through the chain). Marked at the choke points where an env leaves the
// call's extent; run_meth recycles only unmarked frames.
let rec mark_captured = fn env ->
  if map_has env "__captured" then ()
  else
    let _ = map_set env "__captured" (VBool true) in
    (match lv_parent_of env with
     | (true, p) -> mark_captured p
     | _ -> ());

// The choke points: every proc-shaped store goes through these, so the
// capture marking cannot be forgotten at one of the twenty-two write sites.
// THE FRAME POOL. A method call's frame dies at return unless captured
// (mark_captured above); a dead frame is recycled -- entries wiped, its
// private arena wound back to one warm 4 KB seed (mere v0.1.300) -- and
// parked here for the next call. Frames were the single largest unreclaimed
// share (12 GB of a rubocop load): every call allocated ~1.8 KB of map
// machinery into the default region, permanently. Pooled, a call's frame
// costs its ENTRIES only, in an arena that is handed back at return.
let frame_pool = vec_new ();
let frame_pool_n = map_new ();
let pool_ctr = fn (k: str) ->
  map_set frame_pool_n k ((if map_has frame_pool_n k then map_get frame_pool_n k else 0) + 1);
let frame_pool_get = fn (u: unit) ->
  let n = (if map_has frame_pool_n "n" then map_get frame_pool_n "n" else 0) in
  if n > 0 then
    (let _ = pool_ctr "hits" in
     let _ = map_set frame_pool_n "n" (n - 1) in
     vec_get frame_pool (n - 1))
  else
    (let _ = pool_ctr "news" in
     let f = map_new () in
     let _ = map_recycle f in   // promote: give it its own arena from birth
     f);
let frame_pool_put = fn f ->
  // count the bytes this frame's arena held BEFORE the wind-back: that sum is
  // the deterministic answer to "was anything reclaimed" that peak RSS is not
  // (peak RSS above a few GB varies 2x between identical runs, recorded below).
  let _ = map_set frame_pool_n "bytes"
    ((if map_has frame_pool_n "bytes" then map_get frame_pool_n "bytes" else 0) + map_bytes f) in
  let _ = map_recycle f in
  let n = (if map_has frame_pool_n "n" then map_get frame_pool_n "n" else 0) in
  // cap the pool at the deepest call stack seen; past that, drop the frame
  // (its arena was already wound back, so the residue is the struct alone).
  if n >= 4096 then (pool_ctr "drops")
  else
    (let _ = pool_ctr "puts" in
     let _ = (if n < vec_len frame_pool then vec_set frame_pool n f
              else vec_push frame_pool f) in
     map_set frame_pool_n "n" (n + 1));

let store_proc = fn (k: str) -> fn entry ->
  let (_, _, _, penv) = entry in
  let _ = mark_captured penv in
  map_set proc_store k entry;
let store_yblk = fn (k: str) -> fn b ->
  let (_, _, _, cenv) = b in
  let _ = mark_captured cenv in
  map_set proc_yblk k b;

let lv_has = fn env -> fn (n: str) -> let (found, _) = lv_owner env n in found;
let lv_get = fn env -> fn (n: str) ->
  let (found, f) = lv_owner env n in
  if found then map_get f n else VNil;
let lv_set = fn env -> fn (n: str) -> fn (v: Val) ->
  let (found, f) = lv_owner env n in
  map_set (if found then f else env) n v;
let lv_del = fn env -> fn (n: str) ->
  let (found, f) = lv_owner env n in
  if found then map_delete f n else ();
// flatten a chain into one detached map (inner shadows outer). `binding` and
// the env copies that install a different self must not write back through
// the chain, so the flattened copy carries no parent link.
let rec lv_flat_into = fn env -> fn d ->
  let (has, p) = lv_parent_of env in
  let _ = if has then lv_flat_into p d else () in
  let _ = map_iter env (fn (k: str) -> fn (v: Val) -> map_set d k v) in
  ();
let lv_flat = fn env ->
  let d = map_new () in
  let _ = lv_flat_into env d in
  let _ = if map_has d "__eid" then map_delete d "__eid" else () in
  d;
// read a map whose keys are "0".."n-1" (insertion order) back into a list;
// used to collect map_iter results (which can only side-effect) into an array.
let rec idx_to_list = fn tmp -> fn (i: int) -> fn (n: int) ->
  if i >= n then (Nil : Val list)
  else Cons (map_get tmp (str_of_int i), idx_to_list tmp (i + 1) n);
// monotonic counter for anonymous class/module/Struct names (map_len of a
// store collides before any instance exists — e.g. Class.new(Class.new)
// would name the subclass after its superclass, giving a sup self-loop — so
// draw fresh names from a dedicated counter instead).
let struct_ctr = map_new ();
// struct class name -> its members, as a VArr of symbols. A struct's inspect
// is the one object shape ruby prints WITHOUT an address (`#<struct S a=1>`),
// so it can be reproduced byte for byte -- but only if the member ORDER is
// kept, which the generated #members method cannot be asked for cheaply.
let struct_mem = map_new ();
let fresh_anon = fn (prefix: str) ->
  let n = (if map_has struct_ctr "n" then (match map_get struct_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set struct_ctr "n" (VInt (n + 1)) in
  prefix ++ str_of_int n;
// break-through-yield home tracking: each method invocation gets a unique
// frame id; a block captured by a `&blk` param remembers the frame it was
// passed to (its "home"), so a `break` inside it — even after the block has
// been delegated down through other methods — unwinds to that home method.
let next_fid = fn () ->
  let n = (if map_has struct_ctr "f" then (match map_get struct_ctr "f" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set struct_ctr "f" (VInt (n + 1)) in
  n + 1;
let proc_home = map_new ();     // str(proc id) -> VInt home-frame-id
let pending_home = map_new ();  // single slot: home fid of a &proc being passed as a block
let live_frames = map_new ();   // str(fid) -> VBool true while that method frame is on the stack
// the counter in an internal anonymous name ("AnonClass_7" -> 7), used as the
// address Ruby shows. Stable for the life of the program, like an object id.
let is_anon_cls = fn (c: str) ->
  (str_len c >= 10 && str_eq (substring c 0 10) "AnonClass_") || (str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_")
  // a struct class is anonymous too until something names it: ruby answers
  // nil for `Struct.new(:a).name`, and "Struct::Foo" once it is given one.
  || (str_len c >= 7 && str_eq (substring c 0 7) "Struct_");
// name_anon (records a constant name for an anonymous class/module the first
// time it is assigned to a constant) is defined in the mutual-recursion block
// below, since it recurses through the receiver's constants.
// singleton methods on handle-based values (String/Array/Hash): keyed by
// "str:<h>" / "arr:<h>" / "hsh:<h>" -> the value's singleton class name.
// one arena block, reused: 64 KiB is the read size and the write chunk.
let tcp_buf = map_new ();
let tcp_arena = fn () ->
  if map_has tcp_buf "p" then (match map_get tcp_buf "p" with VInt p -> p | _ -> 0)
  else (let p = mem_alloc 65536 in let _ = map_set tcp_buf "p" (VInt p) in p);

let hng_store = map_new ();
// class variables (@@x): "Cls@x" -> value, resolved up the superclass chain.
let cvars = map_new ();
// regex capture-group spans recorded during the latest match attempt
// ("sN"/"eN" -> string index).
let rx_caps = map_new ();
// compiled-regex program cache: "flags<SOH>pattern" -> prog map; rx_bad marks
// patterns the new engine cannot compile (the legacy matcher handles them).
let rx_progs = map_new ();
let rx_bad = map_new ();
// \G anchor position: the start offset of the current search (scan/gsub pass
// it the cursor). \G (IGANCHOR) matches only when the cursor sits exactly
// here, so scan/gsub produce contiguous, gap-free matches like Ruby.
let rx_ganchor = map_new ();
// lenient regex-parse mode: set while VALIDATING a regex literal at ruby-parse
// time — constructs the engine does not support yet are accepted (they fall
// back to the legacy matcher at runtime), while truly invalid syntax still
// fails (a Ruby SyntaxError / RegexpError).
let rx_lenient = map_new ();
// Named groups seen so far in the pattern being parsed: the number (for
// `\k<name>`) and the body (for `\g<name>`, which re-matches the group's
// pattern at the call site). Cleared at the start of every parse.
let rx_gnums = map_new ();
let rx_gbodies = map_new ();
// Per compiled pattern (same key as rx_progs): its named groups, as
// "name=number|name=number|...". A MatchData answers `m[:name]` from this.
let rx_prog_names = map_new ();
// the cache key of the pattern currently being matched, so the MatchData it
// publishes can name its groups.
let rx_cur = map_new ();
// regex literals recorded by the ruby parser ("e<i>" -> "flags\nbody", "n" =
// count, "done" = validated prefix); validated right after each parse (eval /
// require / main), so an invalid literal is a parse-time SyntaxError while
// engine-unsupported ones pass (legacy fallback).
let rx_pending = map_new ();
// container handles currently being inspected — breaks self-referential
// structures (Ruby prints such a cycle as "[...]" / "{...}") instead of
// recursing forever.
//
// ⚠ The key carries the KIND ("a3" / "h3"). Array ids come from arr_ctr and
// hash ids from vec_len hash_store: two independent counters, so bare integers
// would make array 3 and hash 3 the same entry and print "[...]" for an array
// that merely sat inside hash 3.
let insp_seen = map_new ();
// container handles on the current traversal for the NON-printing walks
// (Array#hash, Array#<=>). Deliberately not insp_seen: a mark left by a printer
// would make a hash computed inside it return the cycle constant instead of the
// real value, and the two walks can in principle nest.
let cyc_seen = map_new ();
// nesting depth of active catch(:tag) blocks (throw without any catch
// raises UncaughtThrowError immediately).
let catch_depth = map_new ();
// true while running directly inside a Thread.new block (reset on entering a
// method, which is a return boundary): a bare `return` there is a LocalJumpError.
let thread_flag = map_new ();
// synchronous-thread model state: the current Thread object, and a registry
// of every spawned thread (for Thread.list / ThreadGroup#list).
let cur_thr = map_new ();
let all_thr = map_new ();
let dfl_tg = map_new ();
// expression-position flow (break/next/redo/return inside an expression)
// unwinds via fail with the kind and value parked here; loop/method/block
// runners catch and convert back into a Flow.
let flow_sig = map_new ();

// Blocks registered with Kernel#at_exit, keyed by the order they were given:
// they run in the REVERSE of it, after the program (and after an uncaught
// exception has been reported), and before an explicit `exit`.
let at_exits = map_new ();

// One END { } in the source registers once, however many times control
// reaches it: the parser numbers the sites and this remembers which have
// registered. (`END` inside a loop is the case ruby names explicitly.)
let end_sites = map_new ();
let end_ctr = map_new ();
let end_site_next = fn () ->
  let n = (if map_has end_ctr "n" then map_get end_ctr "n" else 0) in
  let _ = map_set end_ctr "n" (n + 1) in n;
// flip-flop operator state: one on/off flag per lexical site. Sites are
// numbered at parse time (map_len allocates), so each eval gets fresh ones.
let ff_state = map_new ();
// parser modes: "nobrace" suppresses brace-block attachment (lambda
// parameter defaults — the { after them is the lambda body).
let parser_flags = map_new ();
// parse-time gensym counter for `rescue E => <complex lvalue>`: the exception
// binds to a fresh temp, then a synthesized assignment writes it to the target.
// a block written with an explicit-but-empty parameter list (`{ || ... }`)
// carries this sentinel so the parser can reject a numbered parameter in the
// body (`proc { || _1 }` is a SyntaxError); it is stripped before the block runs.
let empty_bp_marker = "~emptyparams~";
// parse-time gensym for op-assign temporaries (so `(expr)::C op= v` evaluates
// the receiver expression exactly once).
let tmp_ctr = map_new ();
let fresh_tmp = fn () ->
  let n = (if map_has tmp_ctr "n" then (match map_get tmp_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set tmp_ctr "n" (VInt (n + 1)) in
  "~opasgn~" ++ str_of_int n;
let resc_ctr = map_new ();
let fresh_resc = fn () ->
  let n = (if map_has resc_ctr "n" then (match map_get resc_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set resc_ctr "n" (VInt (n + 1)) in
  "__resc~" ++ str_of_int n;
// a non-constant rescue class expression (`rescue rescuer`, `rescue -> {..}.call`)
// is stashed here and referenced from the class list by a "@rexpr~N" sentinel;
// it is evaluated at match time (so `rescue <expr>` runs only when needed).
let resc_exprs = map_new ();
let resc_reg = fn (e: Expr) ->
  let n = (if map_has resc_ctr "e" then (match map_get resc_ctr "e" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set resc_ctr "e" (VInt (n + 1)) in
  let _ = map_set resc_exprs (str_of_int n) e in
  "@rexpr~" ++ str_of_int n;
// require bookkeeping: "dir" = the current file's directory (require_relative
// resolves against it); loaded_files dedups double-loads.
let load_ctx = map_new ();
// where execution is: the line of the statement being run (0 = not known, e.g.
// inside a body that was synthesised rather than parsed).
let cur_pos = map_new ();
let cur_pos_s = map_new ();
let call_names_s = map_new ();
let call_files_s = map_new ();
let call_meths_s = map_new ();
let cur_line = fn () ->
  if map_has cur_pos "l" then (match map_get cur_pos "l" with VInt n -> n | _ -> 0) else 0;
let cur_file = fn () ->
  if map_has cur_pos_s "f" then map_get cur_pos_s "f" else "";
// the method the innermost frame is running ("" at the top level)
let cur_meth = fn () ->
  if map_has cur_pos_s "m" then map_get cur_pos_s "m" else "";
// "Cls#meth" -> "meth": the reference ruby names the method alone in a frame
let meth_label = fn (n: str) ->
  let i = str_index_of n "#" in
  if i < 0 then n else substring n (i + 1) (str_len n);
// the line each call was made on, and the file it was made in, per call depth.
// call_names (further down) already holds the method name per depth, so these
// two complete the stack.
let call_lines = map_new ();
let loaded_files = map_new ();
// __ENCODING__ is a parse-time constant: the source encoding of the file (or
// eval string) being parsed. The parser captures the current script encoding
// (load_ctx "coding", set before lex/parse by run_prog/require/eval) into the
// EVar name as "__ENCODING__~<NAME>"; eval resolves it to the Encoding object.
// The file whose source is being parsed right now. do_require sets "parsing"
// before it lexes; the entry script's "file" is set before parsing it. Reading
// it at PARSE time is the point: `__FILE__`, `__dir__` and `require_relative`
// name the file their expression is WRITTEN in, and the loader's idea of the
// current file is whatever it is loading at the moment the code RUNS. A method
// or a block that runs after its own file finished loading saw the wrong one --
// bundler's settings.rb hands a block containing `require_relative` to
// SharedHelpers.filesystem_access, which yields it from another file entirely.
let parse_time_file = fn (u: unit) ->
  let p = (if map_has load_ctx "parsing" then (match map_get load_ctx "parsing" with VStr h -> sget h | _ -> "") else "") in
  if str_eq p "" then
    (if map_has load_ctx "file" then (match map_get load_ctx "file" with VStr h -> sget h | _ -> "") else "")
  else p;
let enc_pseudo_var = fn (id: str) ->
  if str_eq id "__ENCODING__" then
    (let c = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr s -> sget s | _ -> "UTF-8") else "UTF-8") in
     EVar ("__ENCODING__~" ++ (if str_eq c "" then "UTF-8" else c)))
  // `__FILE__` / `__dir__` carry the parsed file in the EVar name, exactly as
  // __ENCODING__ carries the encoding. Without a file to name (an eval string
  // before anything has been loaded) the dynamic reading in eval_e is kept.
  else if str_eq id "__FILE__" || str_eq id "__dir__" then
    (let f = parse_time_file () in
     if str_eq f "" then EVar id else EVar (id ++ "~" ++ f))
  else EVar id;
// `__LINE__` is the line it is WRITTEN on, so it is a literal from here -- the
// same reasoning as __FILE__ above. Line 0 means the lexer had nothing to say
// (an eval string with no newline in it at all), and eval_e's fallback answers.
let enc_pseudo_var_at = fn (id: str) -> fn (line: int) ->
  if str_eq id "__LINE__" && line > 0 then EInt line else enc_pseudo_var id;
// Kernel#ruby_exe support: a redirectable output sink. While io_cap["on"] is
// set, puts/print/p append to io_cap["buf"] instead of the real stdout, so
// __ruby_exe can capture a snippet's output (an in-process approximation of
// mspec's subprocess ruby_exe).
let io_cap = map_new ();
// A ruby String may hold a zero byte, and `print` / `print_no_nl` write with
// the C string functions, which stop there: `print Zlib.gzip(x)` came out as
// the two bytes before the first NUL. `print_bytes` writes a length, so the
// I/O boundary is crossed as bytes. It is only used when the string actually
// holds a NUL, so the ordinary path is untouched.
let rec str_has_nul_go = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then false
  else if ord (char_at s i) == 0 then true
  else str_has_nul_go s (i + 1);
let str_has_nul = fn (s: str) -> str_has_nul_go s 0;
// Copy a string into the byte arena and write it. `mem_copy_str` walks a C
// string and stops at a zero byte, so a payload that has one is copied byte by
// byte instead -- the same split the output path makes.
let rec tcp_put_bytes = fn (p: int) -> fn (s: str) -> fn (i: int) -> fn (n: int) ->
  if i >= n then () else (let _ = mem_set_u8 p i (ord (char_at s i)) in tcp_put_bytes p s (i + 1) n);
let tcp_put = fn (fd: int) -> fn (s: str) ->
  let p = tcp_arena () in
  let n = str_len s in
  let _ = (if str_has_nul s then tcp_put_bytes p s 0 n else (let _ = mem_copy_str p 0 s in ())) in
  tcp_write fd p n;
let out_write_raw = fn (s: str) ->
  if str_has_nul s then print_bytes (bytes_of_str s) else print_no_nl s;
let out_print = fn (s: str) ->
  if map_has io_cap "on" then
    (let cur = (match map_get io_cap "buf" with VStr h -> sget h | _ -> "") in
     map_set io_cap "buf" (mkstr (cur ++ s ++ "\n")))
  else out_write_raw (s ++ "\n");
let out_print_no_nl = fn (s: str) ->
  if map_has io_cap "on" then
    (let cur = (match map_get io_cap "buf" with VStr h -> sget h | _ -> "") in
     map_set io_cap "buf" (mkstr (cur ++ s)))
  else out_write_raw s;
// ENV writes overlay the real environment (there is no setenv extern);
// VNil marks a deleted key. cli_argv holds the script's ARGV.
let env_ovr = map_new ();
// `alias $NEW $OLD`: the new name reads and writes the old one's slot.
let gvar_alias = map_new ();
// LoadError#path: the message determines the path, so the raise records it
// here rather than widening VExc (which carries only a class and a message).
let le_path = map_new ();
// the real environment, dumped once on first read (see env_load).
let env_cache = map_new ();
let cli_argv = map_new ();
// key "v" -> the -I directories, ":"-joined in the order they were given.
let cli_inc = map_new ();
// key "ver" -> -v/--version was given; "help" -> -h/--help; "eval" -> the -e
// code, "\n"-joined in the order given; "bad" -> the first unrecognised
// -option. Set by take_flags, read by run_cli.
let cli_opt = map_new ();
// ONE place for the version string: `-v` prints it and RUBY_DESCRIPTION is set
// from it. Two copies would be free to drift, and a library that parses
// `ruby -v` and one that reads RUBY_DESCRIPTION have to agree -- they are the
// same claim asked twice.
let ruby_desc = "ruby 3.2.2 (2023-03-30 revision e51014f9c0) [arm64-darwin22]";
// ONE place for the usage line: -h prints it and so does a bare invocation.
// The invalid-option message points at -h, so -h has to exist -- a diagnostic
// that names a flag the binary does not have is worse than no diagnostic.
let usage_line = "usage: mere-ruby [-v] [-h] [-e CODE] [-I DIR] [--] <script.rb | -> [args]";
// Encoding.default_internal (nil unless assigned; ENV reads honor it) and
// default_external (UTF-8 unless assigned).
let def_int_enc = map_new ();
let def_ext_enc = map_new ();
let rec strs_to_vals = fn (xs: str list) ->
  match xs with Nil -> (Nil : Val list) | Cons (h, t) -> Cons (mkstr h, strs_to_vals t);
let rec last_slash = fn (s: str) -> fn (i: int) -> fn (best: int) ->
  if i >= str_len s then best
  else last_slash s (i + 1) (if str_eq (char_at s i) "/" then i else best);
// Ruby strips trailing slashes first ("a/" -> "."), and a path whose only
// slash is the leading one has "/" as its directory ("/x" -> "/").
let rec strip_trail_slash = fn (p: str) -> fn (i: int) ->
  if i > 0 && str_eq (char_at p i) "/" then strip_trail_slash p (i - 1) else substring p 0 (i + 1);
let dirname_of = fn (p: str) ->
  let q = strip_trail_slash p (str_len p - 1) in
  let ls = last_slash q 0 (0 - 1) in
  if ls < 0 then "." else if ls == 0 then "/" else substring q 0 ls;
let ends_with_rb = fn (p: str) ->
  str_len p >= 3 && str_eq (substring p (str_len p - 3) (str_len p)) ".rb";
// global variables ($name) live in another top-level captured Map.
let globals = map_new ();
// $/ (the record separator) DEFAULTS to "\n"; reading it before any
// assignment answered nil, so a spec's save-and-restore dance turned the
// default off for every example after the first.
let _ = map_set globals "/" (mkstr "\n");
// constants (Capitalized names) live in another; a class name that is not
// an assigned constant reads as VClass.
let consts = map_new ();
// `private_constant :NAME` — the fully qualified names that may not be read
// through the scope operator. The constant itself stays in `consts`: it is
// still readable by the lexical name from inside its own module, and
// const_get still answers, exactly as in ruby.
let private_consts = map_new ();
// modules mixed into a class via `include`: class name -> "M1|M2|..." of the
// included module names (searched after the class's own methods + ancestors).
let includes = map_new ();

// `prepend`ed modules, by class: unlike an included one, a prepended module
// comes BEFORE the class in its ancestors, so its methods win and their
// `super` reaches the class's own definition.
let prepends = map_new ();

// Writing any of these three invalidates the memoized ancestor chains, so the
// writes go through here rather than being spread across seventeen call sites
// that each have to remember. (`sup` lives in the world tuple, so it is passed
// in; includes and prepends are globals.)
let set_sup = fn m -> fn (k: str) -> fn (v: str) -> let _ = mro_bump () in map_set m k v;
let set_inc = fn (k: str) -> fn (v: str) -> let _ = mro_bump () in map_set includes k v;
let set_pre = fn (k: str) -> fn (v: str) -> let _ = mro_bump () in map_set prepends k v;
// names declared with `module` (vs `class`) so Module#class differs.
let modules = map_new ();
// private methods: "Cls#name" -> present. Checked only on explicit-receiver
// dispatch (implicit-self calls and send bypass, as in Ruby).
let privates = map_new ();
let protecteds = map_new ();  // protected methods (callable only same-class)
let undefs = map_new ();  // undef'd methods (tombstones that block inheritance)
// prim_method has no `world` to build an exception, so its terminal
// "undefined method" failure parks the method name here; the begin/rescue
// catch site turns it into a proper NoMethodError (Ruby's class for it).
// Module#autoload: a constant that names a file to load the first time the
// constant is read. Keyed by the qualified constant ("Gem::Requirement") or
// the bare name at top level; the entry is removed before the file runs, so a
// file that fails to define the constant cannot loop.
let autoloads = map_new ();
let prim_missing = map_new ();

// A parse error is raised deep in the parser, which has no idea which file it
// is reading: a gem's syntax error arrived as a bare "unexpected token: =",
// and finding the file cost a scan of the whole gem. `require`/`load` park the
// Which line the parser had reached. Tokens carry no position (a Tok is a
// bare variant), so this is derived: the statement loop remembers how many
// newlines were still AHEAD of it, and the line is the file's total minus
// that. Counting the newlines consumed instead would be wrong -- the parser
// backtracks, and a global counter counts the re-scans twice. A parse error
// that names only the file sends the reader to grep; "near line 87" sends
// them to the line.
let parse_line = map_new ();
// Counted, not derived: the statement loop adds the newlines it skips and the
// one that ends each statement. Two other shapes were tried and both were
// worse -- counting the newlines LEFT costs O(n) per statement, and stashing
// the token list costs a deep COPY per statement (map_set copies its value),
// which took a 241k-line test from 10 seconds to over 75. Newlines consumed
// inside a single expression are not counted, so this is a lower bound, which
// is why the message says "near".
let parse_line_add = fn (k: int) ->
  let n = (if map_has parse_line "n" then map_get parse_line "n" else 0) in
  map_set parse_line "n" (n + k);
// The count is an UPPER bound: the parser backtracks, and a re-scanned block
// body is counted twice. The file's own line count (one pass, at the start of
// the parse -- not per statement) clamps it, so the number always names a line
// that exists.
let parse_line_reset = fn (lines: int) ->
  let _ = map_set parse_line "n" 0 in
  map_set parse_line "max" lines;
let parse_line_now = fn () ->
  if map_has parse_line "n" then
    (let n = map_get parse_line "n" + 1 in
     let mx = (if map_has parse_line "max" then map_get parse_line "max" else 0) in
     if mx > 0 && n > mx then mx else n)
  else 0;

// path here for the duration of the parse so the message can say it.
// A string passed to eval / class_eval has no file at all, so a parse error in
// one has to quote the string instead: the alternative is a bare "expected
// parameter name" with nowhere to look.
let set_parsing_eval = fn (code: str) ->
  map_set load_ctx "parsing"
    (mkstr ("(eval) " ++ substring code 0 (if str_len code > 60 then 60 else str_len code)));

let parsing_file = fn () ->
  let ln = parse_line_now () in
  let where = (if ln > 0 then " near line " ++ str_of_int (ln + 1) else "") in
  (if map_has load_ctx "parsing" then
     (match map_get load_ctx "parsing" with
      | VStr d -> (let f = sget d in if str_eq f "" then where else " in " ++ f ++ where)
      | _ -> where)
   else where);
// prim_method has no `world` to build an exception with, so a TYPED failure
// parks its class and message here and fails; the begin/rescue catch site
// turns that into the real Ruby exception. Same channel as the "n" slot above,
// generalised from the one NoMethodError case it was built for.
// Where a raise happened. Recorded at the raise, not read at the report: each
// frame puts the caller's line back as it unwinds, so reading the current line
// at the top level names the call site instead. First writer wins, which is the
// innermost raise -- the same rule the recorded FILE already used.
// The frames of the raise that is in flight. A built-in exception is a class and
// a message with no identity, so there is nowhere on it to keep them; this slot
// answers for the exception in `$!` and nothing else (see Exception#backtrace).
let raise_bt = map_new ();
let note_raise_site = fn (u: unit) ->
  let _ = (if map_has prim_missing "rl" then () else map_set prim_missing "rl" (VInt (cur_line ()))) in
  let _ = (if map_has prim_missing "rm" then () else map_set prim_missing "rm" (mkstr (cur_meth ()))) in
  (if map_has prim_missing "rf" then () else map_set prim_missing "rf" (mkstr (cur_file ())));
let prim_raise = fn (cls: str) -> fn (msg: str) ->
  let _ = map_set prim_missing "c" (mkstr cls) in
  let _ = map_set prim_missing "m" (mkstr msg) in
  let _ = note_raise_site () in
  (let __fm = ("mere-ruby: " ++ cls ++ ": " ++ msg) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);
let is_upper_first = fn (id: str) ->
  str_len id > 0 && (let o = ord (char_at id 0) in o >= 65 && o <= 90);
// Kernel#local_variables: the local names bound in `env`, as symbols in
// insertion order. Internal slots (self, __cref, __for, &block, globals,
// ivars, constants) are hidden so the result matches Ruby's.
let local_vars_of = fn env ->
  let tmp = map_new () in
  // the whole chain is in scope here, outermost first (a block sees the
  // method's locals as well as its own).
  let _ = map_iter (lv_flat env) (fn (k: str) -> fn (v: Val) ->
    let skip = str_len k == 0
               || (str_len k >= 2 && str_eq (substring k 0 2) "__")
               || str_eq k "self"
               || str_eq (char_at k 0) "&"
               || str_eq (char_at k 0) "$"
               || str_eq (char_at k 0) "@"
               // the numbered-parameter slots _1.._9 are always pre-declared in
               // a block, so hide them (Ruby reports them only when used).
               || (str_len k == 2 && str_eq (char_at k 0) "_" && (let o = ord (char_at k 1) in o >= 49 && o <= 57))
               || is_upper_first k in
    if skip then () else (let m = map_len tmp in map_set tmp (str_of_int m) (VSym k))) in
  arr_new (idx_to_list tmp 0 (map_len tmp));
// Kernel#global_variables: every global the program can read, as symbols. The
// `globals` map keys are stored WITHOUT the sigil ("~" is $~), so the sigil is
// put back here; the ones ruby always has are added whether or not this program
// has touched them, because `global_variables.include?(:$stdout)` is true in a
// program that never mentions $stdout.
let global_vars_of = fn (u: unit) ->
  let tmp = map_new () in
  let add1 = fn (nm: str) ->
    (if map_has tmp nm then () else (let m = map_len tmp in map_set tmp nm (VSym nm))) in
  let _ = map_iter globals (fn (k: str) -> fn (v: Val) -> add1 ("$" ++ k)) in
  let _ = map_iter gvar_alias (fn (k: str) -> fn (v: Val) -> add1 ("$" ++ k)) in
  let rec addall = fn (xs: str list) ->
    (match xs with Nil -> () | Cons (h, t) -> (let _ = add1 h in addall t)) in
  let _ = addall (str_split "$stdout|$stderr|$stdin|$PROGRAM_NAME|$0|$!|$~|$LOAD_PATH|$LOADED_FEATURES|$,|$;|$/|$*|$$|$?|$DEBUG|$VERBOSE" "|") in
  let ordered = map_new () in
  let _ = map_iter tmp (fn (k: str) -> fn (v: Val) ->
    (let m = map_len ordered in map_set ordered (str_of_int m) v)) in
  arr_new (idx_to_list ordered 0 (map_len ordered));
// iteration budget: a top-level counter ticked once per loop iteration so
// an infinite loop fails fast (a catchable error) instead of hanging.
let step_budget = map_new ();
let tick = fn () ->
  let n = if map_has step_budget "n" then map_get step_budget "n" else 0 in
  if n <= 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: iteration limit exceeded (possible infinite loop)")) in fail "mere-ruby: iteration limit exceeded (possible infinite loop)")
  else let _ = map_set step_budget "n" (n - 1) in ();

// ---- small helpers ------------------------------------------------------
let rec rev_app = fn xs -> fn acc ->
  match xs with Nil -> acc | Cons (h, t) -> rev_app t (Cons (h, acc));

let is_digit = fn (c: str) -> let o = ord c in o >= 48 && o <= 57;
// Ruby identifiers may contain any non-ASCII character, and the lexer walks
// bytes, so every byte of a UTF-8 sequence (>= 0x80) counts as a name byte.
// sidekiq writes `alias_method :\u{1F4A3}, :clear`.
let is_alpha = fn (c: str) ->
  let o = ord c in (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95 || o >= 128;
let is_alnum = fn (c: str) -> is_digit c || is_alpha c;

// ---- encodings: names, ASCII compatibility, validity, negotiation ---------
let enc_upc = fn (s: str) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else let c = char_at s i in
         go (i + 1) (acc ++ (if c >= "a" && c <= "z" then chr (ord c - 32) else c)) in
  go 0 "";
// the canonical spelling for the names programs actually write; ruby's
// encoding names are case-insensitive, its canonical spellings are not.
let enc_canon_name = fn (nm: str) ->
  let u = enc_upc nm in
  if str_eq u "BINARY" || str_eq u "ASCII-8BIT" then "ASCII-8BIT"
  else if str_eq u "US-ASCII" || str_eq u "ASCII" || str_eq u "ANSI_X3.4-1968" || str_eq u "646" then "US-ASCII"
  else if str_eq u "SHIFT_JIS" then "Shift_JIS"
  else if str_eq u "WINDOWS-31J" || str_eq u "CP932" || str_eq u "SJIS" then "Windows-31J"
  else if str_eq u "EMACS-MULE" then "Emacs-Mule"
  else if str_eq u "BIG5" then "Big5"
  else if str_len u >= 8 && str_eq (substring u 0 8) "WINDOWS-" then "Windows-" ++ substring u 8 (str_len u)
  else if str_len u >= 4 && str_eq (substring u 0 4) "UTF-" then u
  else if str_len u >= 9 && str_eq (substring u 0 9) "ISO-8859-" then u
  else if str_len u >= 5 && str_eq (substring u 0 5) "KOI8-" then u
  else if str_len u >= 4 && str_eq (substring u 0 4) "EUC-" then u
  else if str_eq u "GB18030" || str_eq u "GBK" || str_eq u "GB2312" then u
  else nm;
let enc_ascii_compat = fn (e: str) ->
  if str_len e >= 6 && str_eq (substring e 0 6) "UTF-16" then false
  else if str_len e >= 6 && str_eq (substring e 0 6) "UTF-32" then false
  else if str_eq e "UTF-7" then false
  else true;
let enc_all7 = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) -> if i >= n then true else if ord (char_at s i) >= 128 then false else go (i + 1) in
  go 0;
// strict UTF-8: continuation shapes, no overlongs, no surrogates, <= U+10FFFF.
let enc_valid_utf8 = fn (s: str) ->
  let n = str_len s in
  let bv = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let cont = fn (k: int) -> (let v = bv k in v >= 128 && v < 192) in
  let rec go = fn (i: int) ->
    if i >= n then true
    else
      let b0 = bv i in
      if b0 < 128 then go (i + 1)
      else if b0 < 194 then false
      else if b0 < 224 then (if cont (i + 1) then go (i + 2) else false)
      else if b0 < 240 then
        (if cont (i + 1) && cont (i + 2) then
           (let cp = (b0 - 224) * 4096 + (bv (i + 1) - 128) * 64 + (bv (i + 2) - 128) in
            if cp < 2048 then false else if cp >= 55296 && cp <= 57343 then false else go (i + 3))
         else false)
      else if b0 < 245 then
        (if cont (i + 1) && cont (i + 2) && cont (i + 3) then
           (let cp = (b0 - 240) * 262144 + (bv (i + 1) - 128) * 4096 + (bv (i + 2) - 128) * 64 + (bv (i + 3) - 128) in
            if cp < 65536 || cp > 1114111 then false else go (i + 4))
         else false)
      else false in
  go 0;
let enc_valid_utf16 = fn (s: str) -> fn (be: bool) ->
  let n = str_len s in
  if n - (n / 2) * 2 != 0 then false
  else
    let unit = fn (k: int) ->
      (if be then ord (char_at s k) * 256 + ord (char_at s (k + 1))
       else ord (char_at s (k + 1)) * 256 + ord (char_at s k)) in
    let rec go = fn (i: int) ->
      if i >= n then true
      else
        let u = unit i in
        if u >= 55296 && u <= 56319 then
          (if i + 3 < n && (let v = unit (i + 2) in v >= 56320 && v <= 57343) then go (i + 4) else false)
        else if u >= 56320 && u <= 57343 then false
        else go (i + 2) in
    go 0;
let enc_valid_utf32 = fn (s: str) -> fn (be: bool) ->
  let n = str_len s in
  if n - (n / 4) * 4 != 0 then false
  else
    let rec go = fn (i: int) ->
      if i >= n then true
      else
        let v = (if be then ((ord (char_at s i) * 256 + ord (char_at s (i + 1))) * 256 + ord (char_at s (i + 2))) * 256 + ord (char_at s (i + 3))
                 else ((ord (char_at s (i + 3)) * 256 + ord (char_at s (i + 2))) * 256 + ord (char_at s (i + 1))) * 256 + ord (char_at s i)) in
        if v > 1114111 then false
        else if v >= 55296 && v <= 57343 then false
        else go (i + 4) in
    go 0;
let enc_valid_eucjp = fn (s: str) ->
  let n = str_len s in
  let bv = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let rec go = fn (i: int) ->
    if i >= n then true
    else
      let b0 = bv i in
      if b0 < 128 then go (i + 1)
      else if b0 == 142 then (if (let v = bv (i + 1) in v >= 161 && v <= 223) then go (i + 2) else false)
      else if b0 == 143 then
        (if (let v = bv (i + 1) in v >= 161 && v <= 254) && (let v = bv (i + 2) in v >= 161 && v <= 254)
         then go (i + 3) else false)
      else if b0 >= 161 && b0 <= 254 then (if (let v = bv (i + 1) in v >= 161 && v <= 254) then go (i + 2) else false)
      else false in
  go 0;
let enc_valid_sjis = fn (s: str) -> fn (w31j: bool) ->
  let n = str_len s in
  let bv = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let rec go = fn (i: int) ->
    if i >= n then true
    else
      let b0 = bv i in
      if b0 < 128 then go (i + 1)
      else if b0 >= 161 && b0 <= 223 then go (i + 1)
      else if (b0 >= 129 && b0 <= 159) || (b0 >= 224 && b0 <= (if w31j then 252 else 239)) then
        (if (let v = bv (i + 1) in (v >= 64 && v <= 126) || (v >= 128 && v <= 252)) then go (i + 2) else false)
      else false in
  go 0;
// generic double-byte family: ASCII, then lead in [l_lo,l_hi] with a trail in
// [t1_lo,t1_hi] or [t2_lo,t2_hi] (-1 disables the second range).
let enc_valid_db = fn (s: str) -> fn (l_lo: int) -> fn (l_hi: int) -> fn (t1_lo: int) -> fn (t1_hi: int) -> fn (t2_lo: int) -> fn (t2_hi: int) ->
  let n = str_len s in
  let rec go = fn (i: int) ->
    if i >= n then true
    else
      let b0 = ord (char_at s i) in
      if b0 < 128 then go (i + 1)
      else if b0 >= l_lo && b0 <= l_hi then
        (if i + 1 < n then
           (let b1 = ord (char_at s (i + 1)) in
            if (b1 >= t1_lo && b1 <= t1_hi) || (t2_lo >= 0 && b1 >= t2_lo && b1 <= t2_hi) then go (i + 2) else false)
         else false)
      else false in
  go 0;
// Emacs-Mule: ASCII, or a leading code 0x81-0x99 followed by one (0x81-0x8F)
// or two (0x90-0x99) bytes in 0xA0-0xFF; a bare 0xA0+ byte never stands alone.
let enc_valid_emacs = fn (s: str) ->
  let n = str_len s in
  let bv = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let hi = fn (k: int) -> (let v = bv k in v >= 160 && v <= 255) in
  let rec go = fn (i: int) ->
    if i >= n then true
    else
      let b0 = bv i in
      if b0 < 128 then go (i + 1)
      else if b0 >= 129 && b0 <= 143 then (if hi (i + 1) then go (i + 2) else false)
      else if b0 >= 144 && b0 <= 153 then (if hi (i + 1) && hi (i + 2) then go (i + 3) else false)
      else false in
  go 0;
let enc_valid = fn (s: str) -> fn (e: str) ->
  if str_eq e "UTF-8" then enc_valid_utf8 s
  else if str_eq e "US-ASCII" || str_eq e "UTF-7" then enc_all7 s
  else if str_eq e "UTF-16BE" || str_eq e "UTF-16LE" then enc_valid_utf16 s (str_eq e "UTF-16BE")
  else if str_eq e "UTF-32BE" || str_eq e "UTF-32LE" then enc_valid_utf32 s (str_eq e "UTF-32BE")
  else if str_eq e "EUC-JP" then enc_valid_eucjp s
  else if str_eq e "EUC-KR" || str_eq e "GB2312" || str_eq e "EUC-TW" then enc_valid_db s 161 254 161 254 (0 - 1) (0 - 1)
  else if str_eq e "Shift_JIS" || str_eq e "Windows-31J" then enc_valid_sjis s (str_eq e "Windows-31J")
  else if str_eq e "Big5" then enc_valid_db s 161 249 64 126 161 254
  else if str_eq e "CP949" then enc_valid_db s 129 254 65 90 97 254
  else if str_eq e "GBK" || str_eq e "GB18030" then enc_valid_db s 129 254 64 126 128 254
  else if str_eq e "Emacs-Mule" then enc_valid_emacs s
  else true;
// the encoding a value combining a and b carries, or "" when they are
// incompatible: equal encodings, an empty side, or (between two ASCII-
// compatible encodings) an ASCII-only side yielding to the other.
// dummy encodings (stateful ISO-2022-*, UTF-7) are compatible with nothing
// but themselves and the empty string, even for ASCII-only content.
let enc_dummy = fn (e: str) ->
  str_eq e "UTF-7" || (str_len e >= 9 && str_eq (substring e 0 9) "ISO-2022-");
let enc_compat2 = fn (ae0: str) -> fn (as_: str) -> fn (be0: str) -> fn (bs: str) ->
  let ae = enc_canon_name ae0 in
  let be = enc_canon_name be0 in
  if str_eq ae be then ae
  else if str_len bs == 0 then ae
  else if str_len as_ == 0 then be
  else if enc_dummy ae || enc_dummy be then ""
  else if enc_ascii_compat ae && enc_ascii_compat be then
    (let a7 = enc_all7 as_ in
     let b7 = enc_all7 bs in
     if a7 && b7 then ae else if a7 then be else if b7 then ae else "")
  else "";
// the negotiated encoding for two string HANDLES, or "" when incompatible;
// the guard form raises the CompatibilityError ruby's searches raise.
let enc_pair_or = fn (ah: int) -> fn (bh: int) ->
  enc_compat2 (senc_get ah) (sget ah) (senc_get bh) (sget bh);
let enc_pair_guard = fn (ah: int) -> fn (bh: int) ->
  if str_eq (enc_pair_or ah bh) "" then
    (let _ = prim_raise "Encoding::CompatibilityError"
               ("incompatible character encodings: " ++ enc_canon_name (senc_get ah) ++ " and " ++ enc_canon_name (senc_get bh)) in false)
  else true;
// ruby's encoding registration order, for <=> between identical bytes whose
// encodings are incompatible (only the relative order can matter).
let enc_index = fn (e: str) ->
  if str_eq e "ASCII-8BIT" then 0 else if str_eq e "UTF-8" then 1 else if str_eq e "US-ASCII" then 2
  else if str_eq e "UTF-16BE" then 3 else if str_eq e "UTF-16LE" then 4
  else if str_eq e "UTF-32BE" then 5 else if str_eq e "UTF-32LE" then 6
  else if str_eq e "UTF-16" then 7 else if str_eq e "UTF-32" then 8
  else 100;

// ---- lexer ---------------------------------------------------------------
let rec scan_digits = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_digit (char_at s i) then scan_digits s (i + 1) else i;

let rec scan_ident = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alnum (char_at s i) then scan_ident s (i + 1) else i;

let rec skip_comment = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else skip_comment s (i + 1);

// ---- numeric literals (M7): 0x/0o/0b bases + `_` separators ---------------
let digit_val = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87        // a-f
  else if o >= 65 && o <= 70 then o - 55         // A-F
  else 0 - 1;
let is_base_digit = fn (c: str) -> fn (base: int) ->
  let v = digit_val c in v >= 0 && v < base;
// String#hex / #oct lenient parse: skip leading whitespace, optional sign,
// optional radix prefix, then base digits (`_` allowed between) until an
// invalid char. `defbase` is the base when no prefix; hex only recognizes
// 0x, oct recognizes 0x/0b/0o/0d/0. Returns 0 on no digits.
let rec radix_ws = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) " " || str_eq (char_at s i) "\t" || str_eq (char_at s i) "\n") then radix_ws s (i + 1) else i;
let rec radix_digits = fn (s: str) -> fn (i: int) -> fn (base: int) -> fn (acc: int) -> fn (started: bool) ->
  if i >= str_len s then acc
  // a single `_` is allowed only BETWEEN two digits: a digit must precede
  // (started) and a base digit must follow (so leading/trailing/doubled stop).
  else if str_eq (char_at s i) "_" then
    (if started && i + 1 < str_len s && is_base_digit (char_at s (i + 1)) base then radix_digits s (i + 1) base acc started else acc)
  else if is_base_digit (char_at s i) base then radix_digits s (i + 1) base (acc * base + digit_val (char_at s i)) true
  else acc;
let radix_parse = fn (s0: str) -> fn (defbase: int) -> fn (allow_all: bool) ->
  let i0 = radix_ws s0 0 in
  let (neg, i1) = (if i0 < str_len s0 && str_eq (char_at s0 i0) "-" then (true, i0 + 1)
                   else if i0 < str_len s0 && str_eq (char_at s0 i0) "+" then (false, i0 + 1)
                   else (false, i0)) in
  // radix prefix (0x/0b/0o/0d); hex takes only 0x.
  let (base, i2) =
    (if i1 + 1 < str_len s0 && str_eq (char_at s0 i1) "0" then
       let c1 = char_at s0 (i1 + 1) in
       if (str_eq c1 "x" || str_eq c1 "X") && (defbase == 16 || allow_all) then (16, i1 + 2)
       else if (str_eq c1 "b" || str_eq c1 "B") && allow_all then (2, i1 + 2)
       else if (str_eq c1 "o" || str_eq c1 "O") && allow_all then (8, i1 + 2)
       else if (str_eq c1 "d" || str_eq c1 "D") && allow_all then (10, i1 + 2)
       else (defbase, i1)
     else (defbase, i1)) in
  let v = radix_digits s0 i2 base 0 false in
  if neg then 0 - v else v;
// scan digits of a base, allowing `_` between them.
let rec scan_base = fn (s: str) -> fn (i: int) -> fn (base: int) ->
  if i < str_len s && (is_base_digit (char_at s i) base || str_eq (char_at s i) "_")
  then scan_base s (i + 1) base else i;
// parse [i, end) as a base-N integer, skipping `_`.
let rec parse_base = fn (s: str) -> fn (i: int) -> fn (endp: int) -> fn (base: int) -> fn (acc: int) ->
  if i >= endp then acc
  else
    let c = char_at s i in
    if str_eq c "_" then parse_base s (i + 1) endp base acc
    else parse_base s (i + 1) endp base (acc * base + digit_val c);
let rec strip_us = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else let c = char_at s i in strip_us s (i + 1) (if str_eq c "_" then acc else acc ++ c);
// A radix literal can exceed int64 -- `0xff00_fabcafe0_00ff` is just under
// 2^64 -- and the token for a value that big is a DECIMAL string. Multiplying
// a decimal string by the base and adding one digit is the whole of it, and
// doing it here keeps the lexer independent of the bignum layer, which is
// defined thousands of lines further down.
let rec dec_mul_add_go = fn (ds: str) -> fn (i: int) -> fn (m: int) -> fn (carry: int) -> fn (acc: str) ->
  if i < 0 then (if carry == 0 then acc else str_of_int carry ++ acc)
  else
    let p = (ord (char_at ds i) - 48) * m + carry in
    dec_mul_add_go ds (i - 1) m (p / 10) (chr (48 + p - (p / 10) * 10) ++ acc);
let dec_mul_add = fn (ds: str) -> fn (m: int) -> fn (add: int) ->
  dec_mul_add_go ds (str_len ds - 1) m add "";
let rec dec_of_base = fn (s: str) -> fn (i: int) -> fn (endp: int) -> fn (base: int) -> fn (acc: str) ->
  if i >= endp then acc
  else
    let c = char_at s i in
    if str_eq c "_" then dec_of_base s (i + 1) endp base acc
    else dec_of_base s (i + 1) endp base (dec_mul_add acc base (digit_val c));
// int64 or not: the decimal form settles it, and only that decides which
// token the literal becomes.
let dec_fits_int = fn (ds: str) ->
  str_len ds < 19 || (str_len ds == 19 && str_compare ds "9223372036854775807" <= 0);

// ---- string interpolation helpers (M11) ---------------------------------
let rec tapp = fn (a: Tok list) -> fn (b: Tok list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, tapp t b);
let rec drop_eof = fn (ts: Tok list) ->
  match ts with Nil -> Nil | Cons (TEOF, _) -> Nil | Cons (h, t) -> Cons (h, drop_eof t);
// find the `}` matching a `#{` (i points just after `#{`), counting nesting.
let rec find_close_brace = fn (s: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len s then i
  else
    let c = char_at s i in
    if str_eq c "\{" then find_close_brace s (i + 1) (depth + 1)
    else if str_eq c "}" then (if depth == 0 then i else find_close_brace s (i + 1) (depth - 1))
    else find_close_brace s (i + 1) depth;

// double-quoted string body: \n \t \\ \" \' decode; an unknown escape
// drops the backslash (Ruby: "\q" == "q"). Returns (decoded, index after
// the closing quote).
let rec lex_dq = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c "\"" then (acc, i + 1)
    else if str_eq c "\\" then
      (if i + 1 >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ()))
       else
         let e = char_at s (i + 1) in
         let piece =
           if str_eq e "n" then "\n"
           else if str_eq e "t" then "\t"
           else e in
         lex_dq s (i + 2) (acc ++ piece))
    else lex_dq s (i + 1) (acc ++ c);

// single-quoted string body: only \' and \\ are escapes; anything else
// after a backslash keeps the backslash (Ruby semantics).
let rec lex_sq = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c "'" then (acc, i + 1)
    else if str_eq c "\\" && i + 1 < str_len s then
      let e = char_at s (i + 1) in
      if str_eq e "'" || str_eq e "\\" then lex_sq s (i + 2) (acc ++ e)
      else lex_sq s (i + 1) (acc ++ c)
    else lex_sq s (i + 1) (acc ++ c);

let is_punct2 = fn (p: str) ->
  str_eq p "**" || str_eq p "==" || str_eq p "!=" || str_eq p "<=" ||
  str_eq p ">=" || str_eq p "&&" || str_eq p "||" || str_eq p "=>" ||
  str_eq p ".." || str_eq p "<<" || str_eq p ">>" || str_eq p "::" || str_eq p "->" ||
  str_eq p "=~" || str_eq p "!~" || str_eq p "&." ||
  str_eq p "+=" || str_eq p "-=" || str_eq p "*=" || str_eq p "/=" || str_eq p "%=" ||
  str_eq p "|=" || str_eq p "&=" || str_eq p "^=";

let is_punct1 = fn (c: str) ->
  str_eq c "+" || str_eq c "-" || str_eq c "*" || str_eq c "/" ||
  str_eq c "%" || str_eq c "<" || str_eq c ">" || str_eq c "!" ||
  str_eq c "(" || str_eq c ")" || str_eq c "[" || str_eq c "]" ||
  str_eq c "\{" || str_eq c "}" || str_eq c "," || str_eq c "=" ||
  str_eq c "." || str_eq c "|" || str_eq c "&" ||
  str_eq c "?" || str_eq c ":" || str_eq c "~" || str_eq c "^";

// "1" followed by n zeros — denominator for a decimal-fraction Rational literal.
let rec pow10_str = fn (n: int) -> if n <= 0 then "1" else pow10_str (n - 1) ++ "0";

// Can the `:` at `i` open a SYMBOL? Not when it is glued to the end of a
// name -- `{a:1}` and `f(red:nil)` are labels -- and that is true whatever
// follows the colon, a bare name or a quote (`{x:'true'}`).
let colon_opens_sym = fn (s: str) -> fn (i: int) ->
  if i > 0 then
    (let pc = char_at s (i - 1) in
     // `?` and `!` end a method NAME (`empty?:`), but standing alone they are
     // operators -- `!:sym` is a negated symbol.
     if str_eq pc "?" || str_eq pc "!" then
       (if i > 1 then (let pc2 = char_at s (i - 2) in
                       if is_alnum pc2 || str_eq pc2 "_" then false else true)
        else true)
     else if is_alnum pc || str_eq pc "_" then false else true)
  else true;

let rec lex_go = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Cons (TEOF, Nil)
  else
    let c = char_at s i in
    if str_eq c " " || str_eq c "\t" || str_eq c "\r" then lex_go s (i + 1)
    else if str_eq c "\n" || str_eq c ";" then Cons (TNL i, lex_go s (i + 1))
    else if str_eq c "#" then lex_go s (skip_comment s i)
    // `=begin` ... `=end` block comment: both markers sit at column 0.
    else if str_eq c "=" && (i == 0 || str_eq (char_at s (i - 1)) "\n")
            && i + 6 <= str_len s && str_eq (substring s i (i + 6)) "=begin" then
      lex_go s (skip_block_comment s i)
    else if is_digit c then
      // 0x / 0o / 0b / 0d prefixed integers.
      if str_eq c "0" && i + 1 < str_len s &&
         (let n = char_at s (i + 1) in
          str_eq n "x" || str_eq n "X" || str_eq n "o" || str_eq n "O" ||
          str_eq n "b" || str_eq n "B" || str_eq n "d" || str_eq n "D") then
        let n = char_at s (i + 1) in
        let base = if str_eq n "x" || str_eq n "X" then 16
                   else if str_eq n "o" || str_eq n "O" then 8
                   else if str_eq n "d" || str_eq n "D" then 10 else 2 in
        let j = scan_base s (i + 2) base in
        let dv = dec_of_base s (i + 2) j base "0" in
        if dec_fits_int dv then ri_suffix s j (parse_base s (i + 2) j base 0)
        else Cons (TBig dv, lex_go s j)
      // leading-zero octal: 017 == 15 (0 then octal digits, not . or e).
      else if str_eq c "0" && i + 1 < str_len s && (let n = char_at s (i + 1) in is_digit n && (if str_eq n "8" || str_eq n "9" then false else true)) then
        let j = scan_base s (i + 1) 8 in
        let dv = dec_of_base s (i + 1) j 8 "0" in
        if dec_fits_int dv then ri_suffix s j (parse_base s (i + 1) j 8 0)
        else Cons (TBig dv, lex_go s j)
      else
        // decimal (with `_` separators), optionally a float.
        let j = scan_base s i 10 in
        if j + 1 < str_len s && str_eq (char_at s j) "."
           && is_digit (char_at s (j + 1)) then
          let k0 = scan_base s (j + 1) 10 in
          // exponent: 1.2e-3 / 4.5E+2 / 6.7e8
          let k = scan_exponent s k0 in
          // rational-imaginary literal: 1.2ri == Complex(0, Rational(12, 10)).
          if k == k0 && k0 + 1 < str_len s && str_eq (char_at s k0) "r" && str_eq (char_at s (k0 + 1)) "i"
             && (k0 + 2 >= str_len s || (let nc = char_at s (k0 + 2) in if is_alnum nc || str_eq nc "_" then false else true)) then
            let ip = strip_us (substring s i j) 0 "" in
            let fd = strip_us (substring s (j + 1) k0) 0 "" in
            Cons (TImagRat (ip ++ fd, pow10_str (str_len fd)), lex_go s (k0 + 2))
          // decimal-fraction Rational literal: 0.3r == Rational(3, 10).
          else if k == k0 && k0 < str_len s && str_eq (char_at s k0) "r"
             && (k0 + 1 >= str_len s || (let nc = char_at s (k0 + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            let ip = strip_us (substring s i j) 0 "" in
            let fd = strip_us (substring s (j + 1) k0) 0 "" in
            Cons (TRat (ip ++ fd, pow10_str (str_len fd)), lex_go s (k0 + 1))
          // decimal-fraction Complex literal: 0.6i == Complex(0, 0.6).
          else if k < str_len s && str_eq (char_at s k) "i"
             && (k + 1 >= str_len s || (let nc = char_at s (k + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImagF (float_of_str (strip_us (substring s i k) 0 "")), lex_go s (k + 1))
          else
            Cons (TFlt (float_of_str (strip_us (substring s i k) 0 "")), lex_go s k)
        else
          let je = scan_exponent s j in
          if je > j then
            // exponent + imaginary: 1e1i == Complex(0, 10.0). (1e1r is a
            // syntax error in Ruby, so no rational counterpart here.)
            (if je < str_len s && str_eq (char_at s je) "i"
                && (je + 1 >= str_len s || (let nc = char_at s (je + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
               Cons (TImagF (float_of_str (strip_us (substring s i je) 0 "")), lex_go s (je + 1))
             else Cons (TFlt (float_of_str (strip_us (substring s i je) 0 "")), lex_go s je))
          // rational-imaginary: 1ri == Complex(0, Rational(1, 1)).
          else if j + 1 < str_len s && str_eq (char_at s j) "r" && str_eq (char_at s (j + 1)) "i"
                  && (j + 2 >= str_len s || (let nc = char_at s (j + 2) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImagRat (strip_us (substring s i j) 0 "", "1"), lex_go s (j + 2))
          else if j < str_len s && str_eq (char_at s j) "r"
                  && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TRat (strip_us (substring s i j) 0 "", "1"), lex_go s (j + 1))
          else if j < str_len s && str_eq (char_at s j) "i"
                  && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImag (parse_base s i j 10 0), lex_go s (j + 1))
          else
            // decimal integer: emit a big-literal token when it exceeds int64.
            let ds = strip_us (substring s i j) 0 "" in
            if str_len ds < 19 || (str_len ds == 19 && str_compare ds "9223372036854775807" <= 0)
            then Cons (TInt (parse_base s i j 10 0), lex_go s j)
            else Cons (TBig ds, lex_go s j)
    else if str_eq c "?" && i + 1 < str_len s && is_char_lit s i then
      // character literal: `?x` is the one-character string "x", for ANY
      // character that is not whitespace — `?/` and `?,` count, which is how
      // `dir.chomp(?/)` reads. (See is_char_lit for the ternary boundary.)
      let n = char_at s (i + 1) in
      if str_eq n "\\" && i + 2 < str_len s then
        let e = char_at s (i + 2) in
        // `?\001`, `?\x41`, `?é`: escapes with a LENGTH of their own, so
        // they are scanned exactly as they are inside a string rather than
        // mapped one character to one.
        if e >= "0" && e <= "7" then
          (let (oval, oj) = scan_octal s (i + 2) 0 0 in Cons (TStrL (chr oval), lex_go s oj))
        else if str_eq e "x" && i + 3 < str_len s && is_hex_digit (char_at s (i + 3)) then
          (let d1 = hex_val (char_at s (i + 3)) in
           if i + 4 < str_len s && is_hex_digit (char_at s (i + 4))
           then Cons (TStrL (chr (d1 * 16 + hex_val (char_at s (i + 4)))), lex_go s (i + 5))
           else Cons (TStrL (chr d1), lex_go s (i + 4)))
        else if str_eq e "u" && i + 6 < str_len s then
          (let cp = hex4 s (i + 3) in Cons (TStrL (utf8_of cp), lex_go s (i + 7)))
        else
        let ch = if str_eq e "n" then "\n" else if str_eq e "t" then "\t"
                 else if str_eq e "r" then chr 13 else if str_eq e "s" then " "
                 else if str_eq e "0" then chr 0 else if str_eq e "e" then chr 27
                 else if str_eq e "a" then chr 7 else if str_eq e "b" then chr 8
                 else if str_eq e "f" then chr 12 else if str_eq e "v" then chr 11
                 else e in
        Cons (TStrL ch, lex_go s (i + 3))
      else Cons (TStrL n, lex_go s (i + 2))
    else if str_eq c "\"" then
      // double-quoted strings support #{expr} interpolation, desugared to a
      // parenthesized concat: `("" + "a" + (expr).to_s + "c")`.
      let (segs, j) = lex_dstr s (i + 1) "" in
      tapp (Cons (TP "(s", Cons (TStrL "", segs))) (Cons (TP ")", lex_go s j))
    else if str_eq c "'" then
      let (lit, j) = lex_sq s (i + 1) "" in
      Cons (TStrL lit, lex_go s j)
    // `cmd` — a command literal: a call to the ` method with the interpolated
    // string (Kernel#` is a stub; specs override it via define_method(:`)).
    else if str_eq c "`" then
      let (segs, j) = lex_dstr_t "`" s (i + 1) "" in
      Cons (TId "`", Cons (TP "(",
        tapp (Cons (TP "(s", Cons (TStrL "", segs)))
             (Cons (TP ")", Cons (TP ")", lex_go s j)))))
    else if is_alpha c then
      let j = scan_ident s i in
      // Ruby method names may end in `?` or `!` (e.g. even?, sort!). Guard
      // `!=`: extend on `!` only when it is not the start of `!=`.
      let j2 =
        if j < str_len s then
          let cj = char_at s j in
          if str_eq cj "?" then j + 1
          else if str_eq cj "!" && (j + 1 >= str_len s || (if str_eq (char_at s (j + 1)) "=" then false else true)) then j + 1
          else j
        else j in
      Cons (TId (substring s i j2), lex_go s j2)
    else if str_eq c "@" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "@" then
      // @@classvar: both @ kept in the identifier text
      let j = scan_ident s (i + 2) in
      Cons (TId (substring s i j), lex_go s j)
    else if str_eq c "@" then
      // @ivar: keep the leading @ in the identifier text
      let j = scan_ident s (i + 1) in
      Cons (TId (substring s i j), lex_go s j)
    else if str_eq c "$" && i + 1 < str_len s && is_alpha (char_at s (i + 1)) then
      // $global: keep the leading $ in the identifier text
      let j = scan_ident s (i + 1) in
      Cons (TId (substring s i j), lex_go s j)
    // `$-0` / `$-w` and the rest of the dash globals are THREE characters:
    // taking two would leave a bare `0` behind and the statement fell apart.
    else if str_eq c "$" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "-" then
      Cons (TId (substring s i (i + 3)), lex_go s (i + 3))
    // a capture global takes ALL its digits: `$128` is one name, and taking
    // two characters left a bare `28` behind for the statement to trip over.
    else if str_eq c "$" && i + 1 < str_len s && is_digit (char_at s (i + 1)) then
      (let j = scan_base s (i + 1) 10 in
       Cons (TId (substring s i j), lex_go s j))
    else if str_eq c "$" && i + 1 < str_len s then
      // special globals ($~ $! $& ...) lex as identifiers (default nil).
      Cons (TId (substring s i (i + 2)), lex_go s (i + 2))
    // A `:` GLUED to the end of an identifier is a label, not the start of a
    // symbol: `def f(red:nil)` and `{a:1}` are `red:` / `a:` followed by a
    // value, which is how ruby reads them. Only a colon that does not follow
    // a name character can open a symbol.
    else if str_eq c ":" && i + 1 < str_len s && is_alpha (char_at s (i + 1))
            && colon_opens_sym s i then
      // :symbol — include a trailing ? ! or = (:even?, :sort!, :m=),
      // guarding != == and the hash rocket =>.
      let j0 = scan_ident s (i + 1) in
      let j =
        if j0 < str_len s then
          let cj = char_at s j0 in
          let nj = if j0 + 1 < str_len s then char_at s (j0 + 1) else "" in
          if str_eq cj "?" then j0 + 1
          else if str_eq cj "!" && (if str_eq nj "=" then false else true) then j0 + 1
          else if str_eq cj "=" && (if str_eq nj "=" || str_eq nj ">" || str_eq nj "~" then false else true) then j0 + 1
          // `:a==>1` — the = joins the symbol when what follows is `=>`.
          else if str_eq cj "=" && str_eq nj "=" && j0 + 2 < str_len s && str_eq (char_at s (j0 + 2)) ">" then j0 + 1
          else j0
        else j0 in
      Cons (TSym (substring s (i + 1) j), lex_go s j)
    else if str_eq c ":" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "'"
            && colon_opens_sym s i then
      // :'quoted symbol' -- unless the colon closes a label, in which case
      // `{x:'true'}` is the key x and the STRING 'true'.
      let (lit, j) = lex_sq s (i + 2) "" in
      Cons (TSym lit, lex_go s j)
    else if str_eq c ":" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "@" && str_eq (char_at s (i + 2)) "@" then
      let j = scan_ident s (i + 3) in
      Cons (TSym (substring s (i + 1) j), lex_go s j)
    else if str_eq c ":" && i + 2 < str_len s
            && (str_eq (char_at s (i + 1)) "@" || str_eq (char_at s (i + 1)) "$")
            && is_alpha (char_at s (i + 2)) then
      let j = scan_ident s (i + 2) in
      Cons (TSym (substring s (i + 1) j), lex_go s j)
    // `:$-w` and the rest of the dash globals name themselves as symbols too
    // (ruby's Symbol#inspect spec lists them), and they are three characters.
    else if str_eq c ":" && i + 3 < str_len s && str_eq (char_at s (i + 1)) "$"
            && str_eq (char_at s (i + 2)) "-" then
      Cons (TSym (substring s (i + 1) (i + 4)), lex_go s (i + 4))
    // `:$&` / `:$'` / `:$1` -- a symbol naming one of the punctuation globals.
    // rubocop's Style/PerlBackrefs matches on exactly these.
    else if str_eq c ":" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "$"
            && is_gvar_punct (char_at s (i + 2)) then
      Cons (TSym (substring s (i + 1) (i + 3)), lex_go s (i + 3))
    else if str_eq c ":" && i + 1 < str_len s && is_op_sym_start (char_at s (i + 1)) then
      // operator symbols: :=== :== :<=> :+ :[] :[]= etc.
      let (opname, j) = scan_op_sym s (i + 1) in
      Cons (TSym opname, lex_go s j)
    else if str_eq c ":" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\"" &&
            (if i > 0 then (let pc = char_at s (i - 1) in if is_alnum pc || str_eq pc "_" then false else true) else true) then
      // `:"..."` — a plain symbol when the body has no interpolation,
      // otherwise the interpolated string then .to_sym. (A `:` right after an
      // identifier — b:"x" — is a keyword colon, not a symbol.)
      let close = dq_str_end s (i + 2) in
      let body = substring s (i + 2) close in
      if rx_has_interp body 0 then
        let (segs, j) = lex_dstr s (i + 2) "" in
        tapp (Cons (TP "(s", Cons (TStrL "", segs)))
             (Cons (TP ")", Cons (TP ".", Cons (TId "to_sym", lex_go s j))))
      else Cons (TSym (dq_unescape body 0), lex_go s (close + 1))
    else if str_eq c "<" && i + 3 < str_len s && str_eq (char_at s (i + 1)) "<"
            && (str_eq (char_at s (i + 2)) "~" || str_eq (char_at s (i + 2)) "-")
            && (is_alpha (char_at s (i + 3)) || str_eq (char_at s (i + 3)) "\"" || str_eq (char_at s (i + 3)) "'") then
      // heredoc <<~ID / <<-ID: the body starts on the NEXT line and runs to
      // the terminator line. The rest of the current line lexes first, then
      // the body is spliced in as a string token.
      let squiggly = str_eq (char_at s (i + 2)) "~" in
      // the id may be quoted: <<-"HERE" (interp) / <<-'HERE' (raw).
      let q0 = char_at s (i + 3) in
      let quoted = str_eq q0 "\"" || str_eq q0 "'" in
      let idstart = if quoted then i + 4 else i + 3 in
      let idend0 = if quoted then quote_end s idstart q0 else scan_ident s idstart in
      let hid = substring s idstart idend0 in
      let idend = if quoted then idend0 + 1 else idend0 in
      let nl = find_nl s idend in
      let (body, after) = heredoc_body s (nl + 1) hid squiggly in
      let linetoks = drop_eof (lex_go (substring s idend nl) 0) in
      let bodytok = (if quoted && str_eq q0 "'" then Cons (TStrL body, Nil) else heredoc_tok body) in
      tapp bodytok (tapp linetoks (Cons (TNL nl, lex_go s after)))
    else if str_eq c "<" && i + 3 < str_len s && str_eq (char_at s (i + 1)) "<"
            && (str_eq (char_at s (i + 2)) "\"" || str_eq (char_at s (i + 2)) "'") && regex_position s i then
      // <<"ID" (interpolating) / <<'ID' (raw) quoted heredocs.
      let q = char_at s (i + 2) in
      let idend0 = quote_end s (i + 3) q in
      let hid = substring s (i + 3) idend0 in
      let idend = idend0 + 1 in
      let nl = find_nl s idend in
      let (body, after) = heredoc_body s (nl + 1) hid false in
      let linetoks = drop_eof (lex_go (substring s idend nl) 0) in
      let bodytok = (if str_eq q "'" then Cons (TStrL body, Nil) else heredoc_tok body) in
      tapp bodytok (tapp linetoks (Cons (TNL nl, lex_go s after)))
    else if str_eq c "<" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "<"
            && is_upper (char_at s (i + 2)) && regex_position s i then
      // bare <<HERE heredoc (an UPPERCASE id in value position; `a << B`
      // shift stays an operator because of the position check).
      let idend = scan_ident s (i + 2) in
      let hid = substring s (i + 2) idend in
      let nl = find_nl s idend in
      let (body, after) = heredoc_body s (nl + 1) hid false in
      let linetoks = drop_eof (lex_go (substring s idend nl) 0) in
      tapp (heredoc_tok body) (tapp linetoks (Cons (TNL nl, lex_go s after)))
    else if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\n" then
      // a backslash at end of line continues the logical line.
      lex_go s (i + 2)
    else if str_eq c "/" && regex_position s i then
      // a minimal regex literal. With #{...} interpolation it desugars to
      // (string-concat).__regex("flags"); otherwise a plain TRegex token.
      let (lit, fl, j) = scan_regex s (i + 1) "" in
      if rx_has_interp lit 0 then
        let toks = lex_go (rx_interp_src lit) 0 in
        // the literal's own offset goes with it: `/#{x}/o` builds ONCE, and
        // "once" means once per SITE, which is what the offset names.
        tapp (Cons (TP "(s", drop_eof toks))
             (Cons (TP ")", Cons (TP ".", Cons (TId "__regex", Cons (TP "(", Cons (TStrL fl,
               Cons (TP ",", Cons (TInt i, Cons (TP ")", lex_go s j)))))))))
      else Cons (TRegex (lit, fl), lex_go s j)
    else if str_eq c "%" && percent_body s i >= 0 then
      // %(...) / %q(...) / %Q(...) raw strings; %w(...) a word array.
      let b = percent_body s i in
      let opener = char_at s (b - 1) in
      let (lit, j) = scan_balanced2 s b 1 "" opener (pct_close_of opener) in
      // lowercase %w/%i words are raw; %W/%I words interpolate.
      if is_percent_w s i then
        Cons (TP " [", pw_words (str_eq (char_at s (i + 1)) "W") lit 0 (lex_go s j))
      // %r{...}flags is a regex (with optional interpolation). The body is
      // re-scanned keeping backslashes (%r?\?? is the regex /\?/, so the
      // escape must survive into the pattern, unlike %q string unescaping).
      else if str_eq (char_at s (i + 1)) "r" then
        (let (rlit, rj) = scan_pct_regex s b 1 "" opener (pct_close_of opener) in
         let fj = skip_regex_flags s rj in
         let fl = substring s rj fj in
         if rx_has_interp rlit 0 then
           tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src rlit) 0)))
                (Cons (TP ")", Cons (TP ".", Cons (TId "__regex", Cons (TP "(", Cons (TStrL fl,
                  Cons (TP ",", Cons (TInt i, Cons (TP ")", lex_go s fj)))))))))
         else Cons (TRegex (rlit, fl), lex_go s fj))
      // %x{...} is a command literal (same as backticks): a call to the `
      // method with the interpolated body.
      else if str_eq (char_at s (i + 1)) "x" then
        let strexpr =
          if rx_has_interp lit 0 then
            tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src lit) 0))) (Cons (TP ")", Nil))
          else Cons (TStrL lit, Nil) in
        Cons (TId "`", Cons (TP "(", tapp strexpr (Cons (TP ")", lex_go s j))))
      // %s{...} is a symbol; %i{...} a symbol array.
      else if str_eq (char_at s (i + 1)) "s" then Cons (TSym lit, lex_go s j)
      else if str_eq (char_at s (i + 1)) "i" || str_eq (char_at s (i + 1)) "I" then
        Cons (TP " [", pi_words (str_eq (char_at s (i + 1)) "I") lit 0 (lex_go s j))
      // %Q/%(...) interpolate like double-quoted strings; %q stays raw.
      else if (if str_eq (char_at s (i + 1)) "q" then false else true) && rx_has_interp lit 0 then
        tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src lit) 0))) (Cons (TP ")", lex_go s j))
      else Cons (TStrL lit, lex_go s j)
    else
      let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
      if str_eq three "..." || str_eq three "||=" || str_eq three "&&=" ||
         str_eq three "<<=" || str_eq three ">>=" || str_eq three "**=" ||
         str_eq three "<=>" || str_eq three "===" then Cons (TP three, lex_go s (i + 3))
      else
        let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
        // `def foo = expr` (space before the `=`) is an endless method;
        // `def foo= v` (no space) defines a setter. Ruby tells them apart by
        // exactly that spacing, so the lexer marks the endless one -- and only
        // there, where the token before is a name and the one before that is
        // `def`, so no ordinary assignment is affected.
        if str_eq two "==" || str_eq two "=>" || str_eq two "=~" then Cons (TP two, lex_go s (i + 2))
        else if str_eq c "=" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!")
                    && (let nm_start = word_start_at s pj in
                        let pj2 = prev_nonspace s (nm_start - 1) in
                        pj2 >= 0 &&
                        (str_eq (word_ending_at s pj2) "def"
                         // ...or a singleton method: `def self.name = expr`,
                         // where the token before the name is the dot.
                         || (str_eq (char_at s pj2) "."
                             && (let pj3 = prev_nonspace s (pj2 - 1) in
                                 pj3 >= 0 &&
                                 (let rs = word_start_at s pj3 in
                                  let pj4 = prev_nonspace s (rs - 1) in
                                  pj4 >= 0 && str_eq (word_ending_at s pj4) "def")))))) then
          Cons (TP " =", lex_go s (i + 1))
        else if str_eq two "::" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
           && i + 2 < str_len s && is_upper_first (char_at s (i + 2))
           // only after something that could BE a command: an identifier, and
           // not `class ::C` / `module ::M`, where the constant is the name
           // being defined rather than an argument.
           && (let pj = prev_nonspace s (i - 1) in
               pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!")
               && (let w = word_ending_at s pj in
                   // `rescue ::Foo => e` names a class in a clause, not an argument
                   if str_eq w "class" || str_eq w "module" || str_eq w "def" ||
                      str_eq w "rescue" then false else true)) then
          // ` ::Const` — whitespace before and a constant after: an argument
          // prefix, not scope resolution on what precedes. `a::B` (no space)
          // stays scope resolution, which is how Ruby splits them too.
          Cons (TP " ::", lex_go s (i + 2))
        else if is_punct2 two then Cons (TP two, lex_go s (i + 2))
        else if str_eq c "[" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t") then
          // whitespace before [ distinguishes an argument array literal
          // (x.foo [0]) from indexing (x.foo[0]).
          Cons (TP " [", lex_go s (i + 1))
        else if str_eq c "(" && i > 0 && str_eq (char_at s (i - 1)) " "
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!")) then
          Cons (TP " (", lex_go s (i + 1))
        // ` &x` (space before, none after) directly after an expression-ending
        // token is a command-style block-pass argument (`recv.meth &blk`),
        // distinct from binary `a & b`/`a&b` and from a `, &blk` param/arg
        // (where the preceding token is a comma/paren, not an expression).
        // Emitted as " &" so the operator layer ignores it and the call parser
        // consumes it.
        else if str_eq c "&" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
                && i + 1 < str_len s
                && (let nc = char_at s (i + 1) in
                    if str_eq nc " " then false else if str_eq nc "\t" then false
                    // ... and a NEWLINE after it means the operand is on the
                    // next line, which a block-pass argument cannot be: this is
                    // the trailing-operator style, `a.all_requirements &` then
                    // the rest (molinillo writes an Array intersection that way).
                    else if str_eq nc "\n" then false
                    else if str_eq nc "&" then false else if str_eq nc "=" then false
                    else if str_eq nc "." then false else true)
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in
                      is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!"
                      || str_eq pc ")" || str_eq pc "]" || str_eq pc "\"")) then
          Cons (TP " &", lex_go s (i + 1))
        else if is_punct1 c then Cons (TP c, lex_go s (i + 1))
        // backslash-newline continues the statement on the next line.
        else if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\n" then
          lex_go s (i + 2)
        else (let __fm = ("mere-ruby: unexpected character: " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)

// scan a double-quoted string body from i, returning the token segments
// (each prefixed with `+`) and the index after the closing quote. A
// literal run becomes `+ "run"`; a #{expr} becomes `+ ( <expr> ) . to_s`.
and lex_dstr = fn (s: str) -> fn (i: int) -> fn (lit: str) -> lex_dstr_t "\"" s i lit

// like lex_dstr but with a caller-chosen terminator char (`"` for strings,
// backtick for command literals) — same interpolation/escape handling.
and lex_dstr_t = fn (term: str) -> fn (s: str) -> fn (i: int) -> fn (lit: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated string" ++ parsing_file ()))) in fail ("mere-ruby: unterminated string" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c term then (Cons (TP "+", Cons (TStrL lit, Nil)), i + 1)
    else if str_eq c "\\" && i + 1 < str_len s then
      let e = char_at s (i + 1) in
      if str_eq e "u" && i + 2 < str_len s && str_eq (char_at s (i + 2)) "\{" then
        // \u{XXXX ...} — braced codepoint(s), space-separated.
        let (bytes, j) = scan_u_braced s (i + 3) "" 0 in
        lex_dstr_t term s j (lit ++ bytes)
      else if str_eq e "u" && i + 5 < str_len s then
        // \uXXXX — emit UTF-8 bytes for the codepoint.
        let cp = hex4 s (i + 2) in
        lex_dstr_t term s (i + 6) (lit ++ utf8_of cp)
      // \xHH — one byte from up to two hex digits.
      else if str_eq e "x" && i + 2 < str_len s && is_hex_digit (char_at s (i + 2)) then
        let d1 = hex_val (char_at s (i + 2)) in
        if i + 3 < str_len s && is_hex_digit (char_at s (i + 3)) then
          lex_dstr_t term s (i + 4) (lit ++ chr (d1 * 16 + hex_val (char_at s (i + 3))))
        else lex_dstr_t term s (i + 3) (lit ++ chr d1)
      // \NNN — one byte from up to three octal digits.
      else if e >= "0" && e <= "7" then
        let (val, j) = scan_octal s (i + 1) 0 0 in
        lex_dstr_t term s j (lit ++ chr val)
      else
      let piece = if str_eq e "n" then "\n" else if str_eq e "t" then "\t"
                  else if str_eq e "r" then chr 13 else if str_eq e "e" then chr 27
                  else if str_eq e "a" then chr 7 else if str_eq e "b" then chr 8
                  else if str_eq e "f" then chr 12 else if str_eq e "v" then chr 11
                  else if str_eq e "0" then chr 0 else if str_eq e "s" then " "
                  else e in
      lex_dstr_t term s (i + 2) (lit ++ piece)
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      let close = find_close_brace s (i + 2) 0 in
      let exprtoks = drop_eof (lex_go (substring s (i + 2) close) 0) in
      // `.__interp_str`, not `.to_s`: Ruby's interpolation uses a value that is
      // already a String AS IT IS, and only calls to_s on everything else. With
      // `.to_s` here, a program that redefines String#to_s changed what every
      // interpolation of every string produced -- `"#{s}"` and `s.to_s` are two
      // different questions and this asked the second one for both.
      let interp =
        Cons (TP "+", Cons (TP "(",
          tapp exprtoks (Cons (TP ")", Cons (TP ".", Cons (TId "__interp_str", Nil)))))) in
      let (rest, j) = lex_dstr_t term s (close + 1) "" in
      (Cons (TP "+", Cons (TStrL lit, tapp interp rest)), j)
    else lex_dstr_t term s (i + 1) (lit ++ c)

// \u{XXXX YYYY ...}: hex codepoints (space-separated) up to the closing
// brace; returns the UTF-8 bytes and the index after the "}".
and scan_u_braced = fn (s: str) -> fn (i: int) -> fn (acc: str) -> fn (cp: int) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated backslash-u" ++ parsing_file ()))) in fail ("mere-ruby: unterminated backslash-u" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c "}" then (acc ++ (if cp > 0 then utf8_of cp else ""), i + 1)
    else if str_eq c " " then scan_u_braced s (i + 1) (acc ++ (if cp > 0 then utf8_of cp else "")) 0
    else if is_hex_digit c then scan_u_braced s (i + 1) acc (cp * 16 + hex_val c)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad backslash-u")) in fail "mere-ruby: bad backslash-u")

// %(…) / %q(…) / %Q(…) / %w(…): index of the body start, or -1 when the
// % is just the modulo operator.
and percent_body = fn (s: str) -> fn (i: int) ->
  if i + 1 >= str_len s then 0 - 1
  // `x.%(3)` — a `%` right after a dot is the METHOD, never a literal. The
  // same holds for a backtick: `Kernel.`(cmd)` calls the method.
  else if i > 0 && str_eq (char_at s (i - 1)) "." then 0 - 1
  else
    let c1 = char_at s (i + 1) in
    // Bracket delimiters ( { [ < are unambiguous openers. Other clean
    // delimiters (', |, / ...) start a bare percent string only in value
    // position, to avoid stealing the modulo operator.
    if is_pct_open c1 then i + 2
    else if is_pct_delim c1 && regex_position s i then i + 2
    else if (str_eq c1 "q" || str_eq c1 "Q" || str_eq c1 "w" || str_eq c1 "i" || str_eq c1 "s" ||
             str_eq c1 "W" || str_eq c1 "I" || str_eq c1 "r" || str_eq c1 "x")
            && i + 2 < str_len s && is_pct_delim (char_at s (i + 2)) then i + 3
    else 0 - 1

// a percent-literal delimiter: any non-alphanumeric, non-space char.
and is_pct_delim = fn (c: str) ->
  // any non-alnum, non-whitespace char; _ and = are valid Ruby delimiters
  // (the bare-% form is still guarded by regex_position at the caller).
  str_eq c "_" || str_eq c "=" ||
  ((if is_alnum c then false else true) &&
   (if str_eq c " " || str_eq c "\t" || str_eq c "\n" then false else true))

and is_pct_open = fn (c: str) -> str_eq c "(" || str_eq c "\{" || str_eq c "[" || str_eq c "<"

and pct_close_of = fn (c: str) ->
  if str_eq c "(" then ")" else if str_eq c "\{" then "}"
  else if str_eq c "[" then "]" else if str_eq c "<" then ">" else c

and is_percent_w = fn (s: str) -> fn (i: int) ->
  i + 1 < str_len s && (str_eq (char_at s (i + 1)) "w" || str_eq (char_at s (i + 1)) "W")

// raw scan to the balanced closing delimiter; returns (body, index-after).
and rx_is_meta = fn (c: str) ->
  str_eq c "$" || str_eq c "^" || str_eq c "*" || str_eq c "+" || str_eq c "." ||
  str_eq c "?" || str_eq c "|" || str_eq c "}" || str_eq c ")" || str_eq c ">" ||
  str_eq c "]" || str_eq c "(" || str_eq c "\{" || str_eq c "[" || str_eq c "<" || str_eq c "\\"

// like scan_balanced2 but for %r regex bodies: an escaped delimiter keeps
// its backslash only when the delimiter is a regex metacharacter (%r(\() is
// /\(/ but %r-\-- is /-/, matching Ruby's source normalization); any other
// backslash pair is copied verbatim for the regex parser.
and scan_pct_regex = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated %r literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated %r literal" ++ parsing_file ()))
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (let nx = char_at s (i + 1) in
       if (str_eq nx op || str_eq nx clo) && (if rx_is_meta nx then false else true) then
         scan_pct_regex s (i + 2) depth (acc ++ nx) op clo
       else scan_pct_regex s (i + 2) depth (acc ++ c ++ nx) op clo)
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_pct_regex s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_pct_regex s (i + 1) (depth - 1) (acc ++ c) op clo)
    else scan_pct_regex s (i + 1) depth (acc ++ c) op clo

and scan_balanced2 = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated % literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated % literal" ++ parsing_file ()))
  else
    let c = char_at s i in
    // a backslash escapes the delimiter (and itself) inside the body.
    if str_eq c "\\" && i + 1 < str_len s &&
       (str_eq (char_at s (i + 1)) op || str_eq (char_at s (i + 1)) clo || str_eq (char_at s (i + 1)) "\\") then
      scan_balanced2 s (i + 2) depth (acc ++ char_at s (i + 1)) op clo
    // when open and close differ (brackets) nesting counts; otherwise the
    // first delimiter closes.
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_balanced2 s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_balanced2 s (i + 1) (depth - 1) (acc ++ c) op clo)
    else scan_balanced2 s (i + 1) depth (acc ++ c) op clo

// %w body -> `"w1", "w2", ... ]` token run (the caller emits the `[`).
// A backslash escapes the next character into the word (b\ c, b\<nl>c).
and pw_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pw_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pw_tok interp w (Cons (TP "]", rest))
    else pw_tok interp w (Cons (TP ",", pw_words interp t k rest))

// %i body -> `:w1, :w2, ... ]` token run (symbol words).
and pi_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pi_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pi_tok interp w (Cons (TP "]", rest))
    else pi_tok interp w (Cons (TP ",", pi_words interp t k rest))

// one %I/%W word: an interpolated word desugars through the string lexer.
and pi_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && rx_has_interp w 0 then
    Cons (TP "(s", tapp (drop_eof (lex_go (rx_interp_src w) 0))
      (Cons (TP ")", Cons (TP ".", Cons (TId "to_sym", rest)))))
  else Cons (TSym w, rest)

and pw_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && rx_has_interp w 0 then
    Cons (TP "(s", tapp (drop_eof (lex_go (rx_interp_src w) 0)) (Cons (TP ")", rest)))
  else Cons (TStrL w, rest)

and pw_word = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len t then (acc, i)
  else
    let c = char_at t i in
    // In %W/%I (interp) a backslash-escape expands C-style (\t \n \s);
    // in %w/%i it keeps the next character literally (\ joins words).
    if str_eq c "\\" && i + 1 < str_len t then
      let nx = char_at t (i + 1) in
      let piece = (if interp then
                     (if str_eq nx "t" then "\t" else if str_eq nx "n" then "\n"
                      else if str_eq nx "s" then " " else if str_eq nx "r" then "\r"
                      else if str_eq nx "e" then chr 27 else nx)
                   // %w keeps a literal backslash except before space / \ / nl.
                   else if str_eq nx " " || str_eq nx "\\" || str_eq nx "\n" then nx
                   else "\\" ++ nx) in
      pw_word interp t (i + 2) (acc ++ piece)
    else if str_eq c " " || str_eq c "\n" then (acc, i)
    else pw_word interp t (i + 1) (acc ++ c)

and pw_skip = fn (t: str) -> fn (j: int) ->
  if j < str_len t && (str_eq (char_at t j) " " || str_eq (char_at t j) "\n") then pw_skip t (j + 1) else j

// index after an e/E exponent suffix at i, or i when there is none.
and scan_exponent = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) "e" || str_eq (char_at s i) "E") then
    let j = (if i + 1 < str_len s && (str_eq (char_at s (i + 1)) "-" || str_eq (char_at s (i + 1)) "+") then i + 2 else i + 1) in
    (if j < str_len s && is_digit (char_at s j) then scan_base s j 10 else i)
  else i

// emit an integer literal with an optional `r` (Rational) / `i` (Complex)
// suffix; used for the hex/octal/binary paths (the decimal path inlines it).
and ri_suffix = fn (s: str) -> fn (j: int) -> fn (v: int) ->
  if j < str_len s && str_eq (char_at s j) "r"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TRat (str_of_int v, "1"), lex_go s (j + 1))
  else if j < str_len s && str_eq (char_at s j) "i"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TImag v, lex_go s (j + 1))
  else Cons (TInt v, lex_go s j)

and is_upper = fn (c: str) -> let o = ord c in o >= 65 && o <= 90

and quote_end = fn (s: str) -> fn (i: int) -> fn (q: str) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) q then i
  else quote_end s (i + 1) q

and hexv = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87
  else if o >= 65 && o <= 70 then o - 55
  else 0

// up to 3 octal digits from i; returns (value, index-after).
and scan_octal = fn (s: str) -> fn (i: int) -> fn (acc: int) -> fn (n: int) ->
  if n >= 3 || i >= str_len s then (acc, i)
  else
    let c = char_at s i in
    if c >= "0" && c <= "7" then scan_octal s (i + 1) (acc * 8 + (ord c - 48)) (n + 1)
    else (acc, i)

// index of the closing double-quote of a string body starting at i.
and dq_str_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\\" && i + 1 < str_len s then dq_str_end s (i + 2)
  else if str_eq (char_at s i) "\"" then i
  else dq_str_end s (i + 1)

// unescape the common backslash escapes in a plain quoted symbol body.
and dq_unescape = fn (body: str) -> fn (i: int) ->
  if i >= str_len body then ""
  else
    let c = char_at body i in
    if str_eq c "\\" && i + 1 < str_len body then
      let e = char_at body (i + 1) in
      let piece = (if str_eq e "n" then "\n" else if str_eq e "t" then "\t" else e) in
      piece ++ dq_unescape body (i + 2)
    else c ++ dq_unescape body (i + 1)

and is_hex_digit = fn (c: str) ->
  (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
and hex_val = fn (c: str) ->
  if c >= "0" && c <= "9" then ord c - 48
  else if c >= "a" && c <= "f" then ord c - 87
  else if c >= "A" && c <= "F" then ord c - 55
  else 0

and hex4 = fn (s: str) -> fn (i: int) ->
  hexv (char_at s i) * 4096 + hexv (char_at s (i + 1)) * 256 +
  hexv (char_at s (i + 2)) * 16 + hexv (char_at s (i + 3))

// UTF-8 for one codepoint. This is the lexer's copy (utf8_enc, further down, is
// the runtime's) and it had no FOUR-byte branch: every codepoint above U+FFFF
// went through the three-byte arithmetic and overflowed, so `"\u{1F600}"` lexed
// to [255, 152, 128] rather than [240, 159, 152, 128] -- wrong bytes, quietly.
// The same emoji written literally in the source was always fine, which is what
// hid it: the two paths do not share an encoder.
and utf8_of = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + (cp - cp / 64 * 64))
  else if cp < 65536 then chr (224 + cp / 4096) ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))
  else chr (240 + cp / 262144) ++ chr (128 + (cp / 4096 - cp / 262144 * 64))
       ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))

// heredoc body as token(s): interpolated bodies route through the
// double-quoted string lexer.
and heredoc_tok = fn (body0: str) ->
  // An interpolating heredoc is a double-quoted string: `\\` is one
  // backslash, `\t` is a tab. Both forms therefore go through the string
  // lexer -- emitting the body raw when it happened to contain no `#{}` left
  // its escapes unprocessed, and rubocop's compiler writes `end \\` into
  // generated code, which came out as two backslashes and would not lex.
  let body = hd_line_cont body0 0 in
  tapp (Cons (TP "(s", drop_eof (lex_go ("\"" ++ hd_escape_dq body 0 ++ "\"") 0))) (Cons (TP ")", Nil))

// quote a heredoc body so the string lexer sees exactly it: an interpolation
// is code and is copied whole, an escape pair is copied whole (the lexer
// processes it), and a bare `"` is escaped so it does not end the literal.
and hd_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      (let j = interp_close lit (i + 2) 1 in substring lit i j ++ hd_escape_dq lit j)
    else if str_eq c "\\" && i + 1 < str_len lit then
      (c ++ char_at lit (i + 1)) ++ hd_escape_dq lit (i + 2)
    else if str_eq c "\"" then "\\\"" ++ hd_escape_dq lit (i + 1)
    else c ++ hd_escape_dq lit (i + 1)

// backslash-newline in an interpolating heredoc is a line continuation
// (dropped); an escaped backslash stays.
and hd_line_cont = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (if str_eq (char_at s (i + 1)) "\n" then hd_line_cont s (i + 2)
       else c ++ char_at s (i + 1) ++ hd_line_cont s (i + 2))
    else c ++ hd_line_cont s (i + 1)

and find_nl = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else find_nl s (i + 1)

// collect heredoc lines from `i` until the terminator line; returns
// (body, index-after-terminator-line). squiggly strips the common indent.
and heredoc_body = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (squiggly: bool) ->
  let (lines, after) = heredoc_lines s i hid Nil in
  let body = if squiggly then hd_join (hd_strip lines (hd_min_indent lines 9999)) else hd_join lines in
  (body, after)

and heredoc_lines = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (acc: str list) ->
  if i >= str_len s then (rev_app_str acc Nil, i)
  else
    let nl = find_nl s i in
    let line = substring s i nl in
    if str_eq (hd_lstrip line) hid then (rev_app_str acc Nil, if nl < str_len s then nl + 1 else nl)
    else heredoc_lines s (if nl < str_len s then nl + 1 else nl) hid (Cons (line, acc))

and rev_app_str = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_app_str t (Cons (h, acc))

and hd_lstrip = fn (line: str) ->
  if str_len line > 0 && (str_eq (char_at line 0) " " || str_eq (char_at line 0) "\t")
  then hd_lstrip (substring line 1 (str_len line)) else line

and hd_indent_of = fn (line: str) -> fn (n: int) ->
  if n < str_len line && str_eq (char_at line n) " " then hd_indent_of line (n + 1) else n

and hd_min_indent = fn (lines: str list) -> fn (best: int) ->
  match lines with
  | Nil -> best
  | Cons (l, r) ->
    if str_eq (hd_lstrip l) "" then hd_min_indent r best
    else let ind = hd_indent_of l 0 in hd_min_indent r (if ind < best then ind else best)

and hd_strip = fn (lines: str list) -> fn (n: int) ->
  match lines with
  | Nil -> Nil
  | Cons (l, r) ->
    let l2 = if str_len l >= n then substring l n (str_len l) else "" in
    Cons (l2, hd_strip r n)

and hd_join = fn (lines: str list) ->
  match lines with Nil -> "" | Cons (l, r) -> l ++ "\n" ++ hd_join r

// the one-character globals: $& $` $' $+ $~ $! $@ $/ $\\ $, $; $. $< $> $_ $* $$ $? $: $0-9
and is_gvar_punct = fn (c: str) ->
  str_eq c "&" || str_eq c "`" || str_eq c "'" || str_eq c "+" || str_eq c "~" ||
  str_eq c "!" || str_eq c "@" || str_eq c "/" || str_eq c "," || str_eq c ";" ||
  str_eq c "." || str_eq c "<" || str_eq c ">" || str_eq c "_" || str_eq c "*" ||
  str_eq c "$" || str_eq c "?" || str_eq c ":" || str_eq c "\"" ||
  str_eq c "\\" || str_eq c "=" || is_digit c

and is_op_sym_start = fn (c: str) ->
  str_eq c "=" || str_eq c "<" || str_eq c ">" || str_eq c "+" || str_eq c "-" ||
  str_eq c "*" || str_eq c "/" || str_eq c "%" || str_eq c "[" || str_eq c "!" ||
  str_eq c "^" || str_eq c "&" || str_eq c "|" || str_eq c "~" || str_eq c "`"

// scan the longest operator name after a `:` (3, then 2, then 1 chars; []=
// and [] as special cases).
and scan_op_sym = fn (s: str) -> fn (i: int) ->
  let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
  let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
  if str_eq three "===" || str_eq three "<=>" || str_eq three "[]=" || str_eq three "**=" then (three, i + 3)
  else if str_eq two "==" || str_eq two "!=" || str_eq two "<=" || str_eq two ">=" ||
          str_eq two "<<" || str_eq two ">>" || str_eq two "**" || str_eq two "[]" ||
          // `:=~` and `:!~` are both method names (rubocop lists them in a
          // node pattern); only :~@ / :!@ fold to :~ and :!.
          str_eq two "=~" || str_eq two "!~" ||
          // the unary method names :-@ and :+@ (`-@` is what `''.respond_to?`
          // is asked about to see whether a String can be frozen-deduped).
          // `:~@` / `:!@` are NOT here: Ruby folds those to :~ and :!.
          str_eq two "-@" || str_eq two "+@" then (two, i + 2)
  else (substring s i (i + 1), i + 1)

// split a scoped constant name at the LAST `::`: recv part and const name.
and scoped_split = fn (name: str) -> fn (i: int) -> fn (last: int) ->
  if i + 1 >= str_len name then last
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then scoped_split name (i + 2) i
  else scoped_split name (i + 1) last
and recv_of_scoped = fn (name: str) -> substring name 0 (scoped_split name 0 0)
and const_of_scoped = fn (name: str) -> substring name (scoped_split name 0 0 + 2) (str_len name)

// index of the FIRST `::` in a scoped name, or -1.
and first_colon2 = fn (name: str) -> fn (i: int) ->
  if i + 1 >= str_len name then (0 - 1)
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then i
  else first_colon2 name (i + 1)

// `module m::N` where the leftmost segment names a local variable holding a
// class/module: rewrite the name to that class's real name (m -> AnonModule_k)
// so the definition registers under it, not under the literal variable name.
and resolve_scoped_base = fn env -> fn (name: str) ->
  let i = first_colon2 name 0 in
  if i < 0 then name
  else
    let head = substring name 0 i in
    if lv_has env head then
      (match lv_get env head with VClass c -> c ++ "::" ++ substring name (i + 2) (str_len name) | _ -> name)
    else name

and rx_has_interp = fn (lit: str) -> fn (i: int) ->
  if i + 1 >= str_len lit then false
  // escapes take precedence over interpolation: \#{ is a literal #, and the
  // control escapes \c? / \C-? consume the char after them (so /\c#{s}/ has
  // NO interpolation — the # is the control character's argument).
  else if str_eq (char_at lit i) "\\" then
    (let e = (if i + 1 < str_len lit then char_at lit (i + 1) else "") in
     if str_eq e "c" then rx_has_interp lit (i + 3)
     else if str_eq e "C" then rx_has_interp lit (i + 4)
     else rx_has_interp lit (i + 2))
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "\{" then true
  else rx_has_interp lit (i + 1)

// rebuild the regex body as double-quoted-string SOURCE so the normal
// interpolation lexer produces the concat tokens.
and rx_interp_src = fn (lit: str) ->
  "\"" ++ rx_escape_dq lit 0 ++ "\""

and rx_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    // an interpolation is code: copy it verbatim (its own quotes/escapes
    // must reach the code lexer untouched).
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      let j = interp_close lit (i + 2) 1 in
      substring lit i j ++ rx_escape_dq lit j
    else if str_eq c "\"" then "\\\"" ++ rx_escape_dq lit (i + 1)
    else if str_eq c "\\" && i + 1 < str_len lit then
      // keep regex escapes as-is through the string lexer: the backslash is
      // doubled, and so is what follows it when THAT is a backslash (or a
      // quote) -- `\\` in a pattern is a literal backslash and has to survive
      // as two characters, not one.
      (let nx = char_at lit (i + 1) in
       "\\\\" ++ (if str_eq nx "\\" then "\\\\" else if str_eq nx "\"" then "\\\"" else nx)
       ++ rx_escape_dq lit (i + 2))
    else c ++ rx_escape_dq lit (i + 1)

// index just past the `}` closing an interpolation (brace depth counting).
and interp_close = fn (lit: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len lit then i
  else if str_eq (char_at lit i) "\{" then interp_close lit (i + 1) (depth + 1)
  else if str_eq (char_at lit i) "}" then
    (if depth == 1 then i + 1 else interp_close lit (i + 1) (depth - 1))
  else interp_close lit (i + 1) depth

// `?x` at s[i]: a character literal, or the "?" of a ternary? Whitespace after
// the "?" is always a ternary. A word character starts a literal only when
// nothing identifier-ish follows, so `cond ?abc : def` stays a ternary while
// `p ?a` is the one-character string. Any OTHER character (`?/`, `?,`, `?"`)
// starts a literal only where a value could start — the same test the lexer
// uses to tell a regex from a division — so `x > 3 ?"big":"small"` is still a
// ternary. `p ?/` needs the parens Ruby would want anyway: without a local
// variable table there is nothing here to tell a method call from a value.
and is_char_lit = fn (s: str) -> fn (i: int) ->
  let n = char_at s (i + 1) in
  if str_eq n " " || str_eq n "\n" || str_eq n "\t" || str_eq n "\r" then false
  else if str_eq n "\\" then true
  else if is_alnum n || str_eq n "_" then
    (if i + 2 >= str_len s then true
     else let n2 = char_at s (i + 2) in
          if is_alnum n2 || str_eq n2 "_" then false else true)
  else regex_position s i

// is the / at i in a value position (a regex) rather than a division?
and regex_position = fn (s: str) -> fn (i: int) ->
  let p = prev_nonspace s (i - 1) in
  if p < 0 then true
  else
    let c = char_at s p in
    if str_eq c "(" || str_eq c "," || str_eq c "=" || str_eq c "~" ||
       str_eq c "!" || str_eq c "|" || str_eq c "&" || str_eq c "\n" || str_eq c ";" ||
       str_eq c "<" || str_eq c "[" || str_eq c "\{" ||
       // ternary branches: `c ? /re/ : /re/` — a `/` after `?` or `:` starts a regex.
       str_eq c "?" || str_eq c ":" ||
       // a range bound: `(//..//)` is a Range of two empty regexes, which is
       // how ruby's own specs name the type. It is the RANGE dot that says so
       // -- a single dot is a method call, and `7./(2)` is division.
       (str_eq c "." && p > 0 && str_eq (char_at s (p - 1)) ".") then true
    else if is_alpha c then
      // after a keyword (when /re/, match =~ style) it's a regex too.
      let w = word_ending_at s p in
      str_eq w "when" || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
      str_eq w "then" || str_eq w "return" || str_eq w "if" || str_eq w "unless" ||
      // every keyword a CONDITION can follow, not just `if` -- rubocop writes
      // `elsif /\A[ \t]+\z/.match?(x)`, and a `/` there is a regex, not a
      // division.
      str_eq w "elsif" || str_eq w "while" || str_eq w "until" || str_eq w "case" ||
      str_eq w "yield" || str_eq w "break" || str_eq w "next" || str_eq w "raise" ||
      str_eq w "puts" || str_eq w "p" ||
      // `in /re/` — a pattern-matching clause takes a regex value pattern.
      str_eq w "in"
    else false

and word_ending_at = fn (s: str) -> fn (p: int) ->
  let b = word_start s p in
  substring s b (p + 1)

and word_start = fn (s: str) -> fn (p: int) ->
  if p > 0 && (is_alnum (char_at s (p - 1)) || str_eq (char_at s (p - 1)) "_")
  then word_start s (p - 1) else p

// the first index of the identifier that ends at p.
and word_start_at = fn (s: str) -> fn (p: int) ->
  if p <= 0 then 0
  else (let c = char_at s (p - 1) in
        if is_alnum c || str_eq c "_" then word_start_at s (p - 1) else p)

// skip from `=begin` to just past the line holding its `=end` (both at
// column 0, as Ruby requires).
and skip_block_comment = fn (s: str) -> fn (i: int) ->
  let e = block_comment_end s i in
  if e < 0 then str_len s else e
and block_comment_end = fn (s: str) -> fn (i: int) ->
  let ln = bc_line_end s i in
  if ln >= str_len s then 0 - 1
  else if ln + 4 <= str_len s && str_eq (substring s ln (ln + 4)) "=end" then bc_line_end s ln
  else block_comment_end s ln
// the index just past the newline that ends the line starting at i.
and bc_line_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then str_len s
  else if str_eq (char_at s i) "\n" then i + 1
  else bc_line_end s (i + 1)

and prev_nonspace = fn (s: str) -> fn (i: int) ->
  if i < 0 then 0 - 1
  else if str_eq (char_at s i) " " then prev_nonspace s (i - 1)
  else i

and is_lparen = fn (p: str) -> str_eq p "(" || str_eq p " ("

// scan the regex body to the closing unescaped /, returning the trailing
// flags ("im"...) alongside the body and the resume position.
and scan_regex = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated regex" ++ parsing_file ()))) in fail ("mere-ruby: unterminated regex" ++ parsing_file ()))
  else
    let c = char_at s i in
    // `\/` escapes the DELIMITER, and ruby keeps only the slash in the
    // source -- `/a\/b/.source` is "a/b". Every other escape survives whole
    // (the pattern needs it). Getting this wrong shifts every backslash that
    // follows, which is how rubocop-ast's REGEXP pattern came out malformed.
    if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "/" then
      scan_regex s (i + 2) (acc ++ "/")
    else if str_eq c "\\" && i + 1 < str_len s then scan_regex s (i + 2) (acc ++ c ++ char_at s (i + 1))
    // a #{...} interpolation is copied whole — its content may contain `/`
    // (even a nested regex literal, /#{/./}/), which must not close ours.
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      (let close = find_close_brace s (i + 2) 0 in
       scan_regex s (close + 1) (acc ++ substring s i (close + 1)))
    else if str_eq c "/" then
      (let fj = skip_regex_flags s (i + 1) in
       (acc, substring s (i + 1) fj, fj))
    else scan_regex s (i + 1) (acc ++ c)

and skip_regex_flags = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alpha (char_at s i) then
    (let c = char_at s i in
     if str_eq c "i" || str_eq c "m" || str_eq c "x" || str_eq c "o" ||
        str_eq c "u" || str_eq c "n" || str_eq c "s" || str_eq c "e"
     then skip_regex_flags s (i + 1)
     else (let __fm = ("mere-ruby: unknown regexp option - " ++ c) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm))
  else i;

// ---- parser (precedence climbing) ---------------------------------------
let is_keyword = fn (id: str) ->
  str_eq id "puts" || str_eq id "if" || str_eq id "unless" ||
  str_eq id "elsif" || str_eq id "else" || str_eq id "end" ||
  str_eq id "while" || str_eq id "until" || str_eq id "case" ||
  str_eq id "when" || str_eq id "then" || str_eq id "do" ||
  str_eq id "def" || str_eq id "return" || str_eq id "class" ||
  str_eq id "module" ||
  str_eq id "self" || str_eq id "yield" ||
  str_eq id "begin" || str_eq id "rescue" || str_eq id "ensure" ||
  str_eq id "raise" || str_eq id "break" || str_eq id "next" ||
  str_eq id "true" || str_eq id "false" || str_eq id "nil";

// a capitalized bare identifier is a constant (a class reference here).
let is_cap = fn (id: str) ->
  let o = ord (char_at id 0) in o >= 65 && o <= 90;

// an @-prefixed identifier is an instance variable.
let is_ivar = fn (id: str) -> str_len id > 0 && str_eq (char_at id 0) "@";

// keywords that close (or continue) an enclosing block: statement lists
// stop before them without consuming.
let is_block_stop = fn (id: str) ->
  str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
  str_eq id "rescue" || str_eq id "ensure" ||
  // `in` starts the next clause of a case/in; it never begins a statement.
  str_eq id "in";

// keywords that end an optional value (for break/next/return): block
// closers plus trailing statement modifiers (`next if c`, `break unless c`).
let stops_value = fn (id: str) ->
  is_block_stop id || str_eq id "if" || str_eq id "unless" ||
  str_eq id "while" || str_eq id "until";

// op-assign token -> the base operator (`+=` -> `+`), or "" if not one.
// an attribute-writer method name: ends in '=' but is not ==, !=, <=, >=.
let is_setter_name = fn (name: str) ->
  str_len name > 1 && str_eq (char_at name (str_len name - 1)) "=" &&
  (if str_eq name "==" || str_eq name "!=" || str_eq name "<=" || str_eq name ">=" then false else true);

let opassign_base = fn (p: str) ->
  if str_eq p "+=" then "+" else if str_eq p "-=" then "-"
  else if str_eq p "*=" then "*" else if str_eq p "/=" then "/"
  else if str_eq p "%=" then "%" else if str_eq p "**=" then "**"
  else if str_eq p "<<=" then "<<" else if str_eq p ">>=" then ">>"
  else if str_eq p "||=" then "||"
  else if str_eq p "&&=" then "&&"
  else if str_eq p "|=" then "|" else if str_eq p "&=" then "&"
  else if str_eq p "^=" then "^" else "";

// Binary precedence, Ruby's order (subset). 0 = not a binary operator.
// ** is handled separately (tighter than unary minus on its left, so
// -2**2 == -(2**2) == -4, and right-associative: 2**3**2 == 512).
// binary operator precedence (higher binds tighter), matching Ruby:
// || < && < equality < comparison < | ^ < & < shift < +- < */% < **
let prec_of = fn (op: str) ->
  if str_eq op "||" then 1
  else if str_eq op "&&" then 2
  else if str_eq op "==" || str_eq op "!=" || str_eq op "<=>" || str_eq op "===" then 3
  else if str_eq op "=~" || str_eq op "!~" then 3
  else if str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=" then 4
  else if str_eq op "|" || str_eq op "^" then 5
  else if str_eq op "&" then 6
  else if str_eq op "<<" || str_eq op ">>" then 7
  else if str_eq op "+" || str_eq op "-" then 8
  else if str_eq op "*" || str_eq op "/" || str_eq op "%" then 9
  else if str_eq op "**" then 10
  else 0;

let expect = fn toks -> fn (want: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p want then r else (let __fm = ("mere-ruby: expected " ++ want ++ ", got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: expected " ++ want ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);

// pure token helpers, defined before the parser group so both the
// expression and statement parsers (one merged group) can use them.
let expect_end = fn toks ->
  match toks with
  | Cons (TNL _, r) -> (let _ = parse_line_add 1 in r)
  | Cons (TEOF, _) -> toks
  // a statement may also be terminated by a block-closing keyword on the
  // same line (e.g. `def m() 1 end`), left unconsumed for the caller.
  | Cons (TId id, _) ->
    if str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
       str_eq id "rescue" || str_eq id "ensure"
    then toks else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected end of statement" ++ parsing_file ()))) in fail ("mere-ruby: expected end of statement" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected end of statement" ++ parsing_file ()))) in fail ("mere-ruby: expected end of statement" ++ parsing_file ()));

let expect_kw = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id kw then r
    else (let __fm = ("mere-ruby: expected " ++ kw ++ ", got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: expected " ++ kw ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);

// optional `then` (after if/elsif/when conditions) or `do` (after
// while/until conditions) before the newline.
let skip_then = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "then" || str_eq id "do" then r else toks
  // `if cond;\n then body` — a `then` after a newline is still redundant.
  | Cons (TNL _, r) ->
    (match r with
     | Cons (TId id, r2) -> if str_eq id "then" then r2 else toks
     | _ -> toks)
  | _ -> toks;

let rec skip_nls = fn toks ->
  match toks with Cons (TNL _, r) -> skip_nls r | _ -> toks;

// the same, reporting how many newlines it passed: the statement loop keeps
// the line counter with this, and no other caller cares.
let rec skip_nls_n = fn toks -> fn (k: int) ->
  match toks with Cons (TNL _, r) -> skip_nls_n r (k + 1) | _ -> (toks, k);

// how many newline tokens this stream holds (once per file, to clamp the
// running count -- never per statement)
// Turn each TNL's byte offset into the 1-based line it ends. One pass: the
// offsets increase along the stream, so the source is scanned once and never
// re-scanned. Everything downstream (`__LINE__`, and the line an error names)
// reads the number rather than counting newlines again, which is what made the
// old count an upper bound -- the parser backtracks, and a re-scanned block body
// was counted twice.
let rec nl_count_to = fn (s: str) -> fn (i: int) -> fn (stop: int) -> fn (acc: int) ->
  if i >= stop || i >= str_len s then acc
  else nl_count_to s (i + 1) stop (if str_eq (char_at s i) "\n" then acc + 1 else acc);
let rec number_nls_go = fn (s: str) -> fn toks -> fn (off: int) -> fn (line: int) ->
  match toks with
  | Nil -> (Nil : Tok list)
  | Cons (TNL o, r) ->
    // a `;` sits on the line it ends, so counting the newlines between the last
    // mark and this offset is right for both
    let ln = line + nl_count_to s off o 0 in
    Cons (TNL ln, number_nls_go s r (if o > off then o else off) ln)
  | Cons (t, r) -> Cons (t, number_nls_go s r off line);
let number_nls = fn (s: str) -> fn toks -> number_nls_go s toks 0 1;
// the line a token sits on: the next newline mark in the stream ends its line
let rec tok_line = fn toks ->
  match toks with
  | Cons (TNL n, _) -> n
  | Cons (TEOF, _) -> 0
  | Cons (_, r) -> tok_line r
  | Nil -> 0;
let rec count_nls = fn toks ->
  match toks with
  | Nil -> 0
  | Cons (TNL _, r) -> 1 + count_nls r
  | Cons (_, r) -> count_nls r;




// A symbol token whose name is not identifier-shaped can only have been
// written in quoted form (`:'"'`), and inside a ternary that is the colon plus
// a string rather than a symbol.
let sym_looks_quoted = fn (sy: str) ->
  if str_len sy == 0 then true
  else (let c = char_at sy 0 in
        if is_alpha c || str_eq c "_" || str_eq c "@" || str_eq c "$" then false else true);

// a range `lo..hi` / `lo...hi` sits above the binary operators (very low
// precedence in Ruby).
let rec parse_expr = fn toks ->
  let (cond, r) = parse_range toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op "?" then
      let (then_e, r2) = parse_expr (skip_nls rest) in
      // Inside a ternary, a `:` that the lexer read as the start of a QUOTED
      // symbol is the ternary's colon and a string: rexml writes
      // `x.include?('"')?"'":'"'` with no spaces, where `:'"'` is a colon and
      // the one-character string. Ruby resolves it the same way, from context.
      let r2 = (match r2 with
                | Cons (TSym sy, r2b) ->
                  if sym_looks_quoted sy then Cons (TP ":", Cons (TStrL sy, r2b)) else r2
                | _ -> r2) in
      (match r2 with
       | Cons (TP colon, r3) ->
         if str_eq colon ":" then let (else_e, r4) = parse_expr (skip_nls r3) in (ETern (cond, then_e, else_e), r4)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected : in ternary" ++ parsing_file ()))) in fail ("mere-ruby: expected : in ternary" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected : in ternary" ++ parsing_file ()))) in fail ("mere-ruby: expected : in ternary" ++ parsing_file ())))
    else (cond, r)
  | _ -> (cond, r)

and list_append_str = fn (xs: str list) -> fn (ys: str list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_str t ys)

and eapp = fn (xs: Expr list) -> fn (ys: Expr list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, eapp t ys)

// bare lambda params: `-> x, y { ... }` (up to the block opener).
// if the LAST default expr is a call that captured a block, strip the
// block off and hand it back (it was really the lambda's body).
and last_default_block = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> (false, (Nil : (str * Expr) list), (Nil : str list), (Nil : Stmt list))
  | Cons ((n, d), Nil) ->
    (match d with
     | ECallB (cn, cargs, cbp, cbb) ->
       (true, Cons ((n, ECall (cn, cargs)), Nil), cbp, cbb)
     | EMethodB (crecv, cn, cargs, cbp, cbb) ->
       (true, Cons ((n, EMethod (crecv, cn, cargs)), Nil), cbp, cbb)
     | _ -> (false, Cons ((n, d), Nil), Nil, Nil))
  | Cons (h, t) ->
    (match last_default_block t with
     | (ok, t2, sbp, sbb) -> (ok, Cons (h, t2), sbp, sbb))

and psplat_any = fn (ps: str list) ->
  match ps with
  | Nil -> false
  | Cons (p, r) -> (str_len p > 0 && str_eq (char_at p 0) "*") || psplat_any r

// the defaults for plain (non-keyword) names; kw defaults are keyed "k:".
and plain_defaults = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> Nil
  | Cons ((n, d), r) ->
    if str_len n > 0 && str_eq (char_at n (str_len n - 1)) ":" then plain_defaults r
    else Cons ((n, d), plain_defaults r)

and lambda_bare_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    // `-> a=default { ... }` — an optional bare parameter. The default
    // parses with brace-blocks off: the { belongs to the lambda body.
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let _ = map_set parser_flags "nobrace" VNil in
         let (d, r3) = parse_bin r2 6 in
         let _ = map_delete parser_flags "nobrace" in
         lambda_bare_after n r3 acc (Cons ((n, d), ds))
       else lambda_bare_after n r acc ds
     | _ -> lambda_bare_after n r acc ds)
  // `-> *args, **kwargs { ... }` — splat / kw-splat / block-pass params.
  | Cons (TP st, r) ->
    if str_eq st "*" || str_eq st "**" || str_eq st "&" then
      (match r with
       | Cons (TId n, r2) -> lambda_bare_after (st ++ n) r2 acc ds
       | _ -> lambda_bare_after st r acc ds)
    else (rev_app acc Nil, rev_app ds Nil, toks)
  | _ -> (rev_app acc Nil, rev_app ds Nil, toks)

and lambda_bare_after = fn (n: str) -> fn r -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match r with
  | Cons (TP c, r2) ->
    if str_eq c "," then lambda_bare_params r2 (Cons (n, acc)) ds
    else (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)

// the inside of ( ... ): an and/or expression, optionally with a trailing
// statement modifier — `(i += 1 until i > 9)` is a while-statement value.
// A leading break/next/return statement (with its modifier) also works:
// `(break 123 until false)`.
and paren_body = fn toks ->
  match skip_nls toks with
  | Cons (TId w, _) ->
    if str_eq w "break" || str_eq w "next" || str_eq w "return" then
      paren_seq (skip_nls toks) Nil
    // a statement keyword opens a statement sequence: (def f; end; 'f').
    else if str_eq w "def" || str_eq w "class" || str_eq w "module" ||
            str_eq w "begin" || str_eq w "while" || str_eq w "until" ||
            str_eq w "case" then
      paren_seq (skip_nls toks) Nil
    else paren_expr_body (skip_nls toks)
  | _ -> paren_expr_body (skip_nls toks)

and paren_expr_body = fn toks ->
  if looks_like_multix toks then
    let (s2, r2) = parse_multix toks in paren_after_stmt s2 r2
  else if looks_like_multi toks then
    let (s2, r2) = parse_multi toks in paren_after_stmt s2 r2
  else
  let (e, r2) = parse_andor toks in
  match r2 with
  // `(args = 1, 2, 3)` — an assignment's extra comma values build an array.
  | Cons (TP c0, r2b) ->
    if str_eq c0 "=>" then
      let (pat, r3) = parse_pattern_top r2b in (EMatchBind (e, pat), expect (skip_nls r3) ")")
    else if str_eq c0 "," then
      (match e with
       | EAssign (anm, v0) ->
         let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
         (EAssign (anm, EArr (Cons (v0, more))), expect (skip_nls r3) ")")
       // `(a[1, 2] = 4, 5)` / `(o.foo = 1, 2)` — the last setter argument
       // grows into an array of the comma values.
       | EMethod (recv, mn, margs) ->
         if str_eq mn "[]=" || (str_len mn > 0 && str_eq (char_at mn (str_len mn - 1)) "=") then
           let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
           (EMethod (recv, mn, grow_last_arg margs more), expect (skip_nls r3) ")")
         else (e, expect r2 ")")
       | _ -> (e, expect r2 ")"))
    else (e, expect r2 ")")
  | Cons (TId w, rrest) ->
    if str_eq w "in" then
      let (pat, r3) = parse_pattern_top rrest in (EMatchTest (e, pat), expect (skip_nls r3) ")")
    else if str_eq w "while" || str_eq w "until" || str_eq w "if" || str_eq w "unless" || str_eq w "rescue" then
      let (s2, r3) = apply_modifier (SExpr e) r2 in
      (match r3 with
       | Cons (TNL _, _) ->
         // `; more` after the modifier — continue the paren sequence.
         (match skip_nls r3 with
          | Cons (TP rp2, r4) ->
            if str_eq rp2 ")" then (EStmt s2, r4)
            else paren_seq (skip_nls r3) (Cons (s2, Nil))
          | _ -> paren_seq (skip_nls r3) (Cons (s2, Nil)))
       | _ -> (EStmt s2, expect r3 ")"))
    else (e, expect r2 ")")
  // `; more` — the paren holds a statement sequence; its value is the last.
  | Cons (TNL _, _) ->
    (match skip_nls r2 with
     | Cons (TP rp, r3) ->
       if str_eq rp ")" then (e, r3) else paren_seq (skip_nls r2) (Cons (SExpr e, Nil))
     | _ -> paren_seq (skip_nls r2) (Cons (SExpr e, Nil)))
  | _ -> (e, expect r2 ")")

// a multiple assignment inside a paren group: `)` ends it, but a `;` means it
// was only the first statement of a sequence --
// `until (parent, base = File.split(p); parent == p)` in fileutils.
and paren_after_stmt = fn (s2: Stmt) -> fn r2 ->
  (match skip_nls r2 with
   | Cons (TP rp, r3) -> if str_eq rp ")" then (EStmt s2, r3) else paren_seq (skip_nls r2) (Cons (s2, Nil))
   | _ -> paren_seq (skip_nls r2) (Cons (s2, Nil)))

and paren_seq = fn toks -> fn (acc: Stmt list) ->
  let (s0, r0) = parse_stmt toks in
  let (s1, r1) = apply_modifier s0 r0 in
  match r1 with
  | Cons (TP rp, r2) ->
    if str_eq rp ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r2)
    else (let __fm = ("mere-ruby: expected ) in paren sequence, got " ++ rp ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TNL _, _) ->
    (match skip_nls r1 with
     | Cons (TP rp2, r3) ->
       if str_eq rp2 ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r3)
       else paren_seq (skip_nls r1) (Cons (s1, acc))
     | _ -> paren_seq (skip_nls r1) (Cons (s1, acc)))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated paren sequence" ++ parsing_file ()))) in fail ("mere-ruby: unterminated paren sequence" ++ parsing_file ()))

// expr [and|or expr]* — the low-precedence word operators (paren context);
// `not expr` negates at the same low precedence.
and parse_andor = fn toks ->
  match toks with
  | Cons (TId w, r) ->
    if str_eq w "not" then let (e, r2) = parse_expr r in parse_andor_more (EUn ("!", e)) r2
    else let (e, r2) = parse_expr toks in parse_andor_more e r2
  | _ -> let (e, r) = parse_expr toks in parse_andor_more e r

and parse_andor_more = fn (lhs: Expr) -> fn toks ->
  match toks with
  | Cons (TId w, r) ->
    // the right-hand side may continue on the next line (trailing `and` / `or`)
    if str_eq w "and" then let (rhs, r2) = parse_expr (skip_nls r) in parse_andor_more (EBin ("&&", lhs, rhs)) r2
    else if str_eq w "or" then let (rhs, r2) = parse_expr (skip_nls r) in parse_andor_more (EBin ("||", lhs, rhs)) r2
    else (lhs, toks)
  | _ -> (lhs, toks)

and parse_range = fn toks ->
  let (lo, r) = parse_bin toks 1 in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      // endless range: (1..) — no upper bound expression follows. Stops at a
      // closing punctuator, a newline/EOF, or a keyword that begins the next
      // clause (`then`/`do`/`if`/`unless`/`end`/`while`/`until`) — e.g. a
      // `when 90.. then` in a case expression.
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then
           (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       | Cons (TNL _, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TId g, _) ->
         if str_eq g "then" || str_eq g "do" || str_eq g "if" || str_eq g "unless" || str_eq g "end" || str_eq g "while" || str_eq g "until"
         then (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

and parse_bin = fn toks -> fn (minp: int) ->
  let (lhs, r) = parse_unary toks in
  parse_more lhs r minp

// the comparison/match operators are non-associative: `a == b == c` is a
// SyntaxError in Ruby (each can appear at most once per sub-expression).
and is_nonassoc_op = fn (op: str) ->
  str_eq op "==" || str_eq op "!=" || str_eq op "===" || str_eq op "<=>" ||
  str_eq op "=~" || str_eq op "!~"

and parse_more = fn (lhs: Expr) -> fn toks -> fn (minp: int) ->
  match toks with
  | Cons (TP op, rest) ->
    let p = prec_of op in
    if p > 0 && p >= minp then
      // the RHS may continue on the next line (trailing-operator style).
      let (rhs, r2) = parse_bin (skip_nls rest) (p + 1) in
      // reject chaining of a non-associative operator (`a == b == c`).
      let _ = (match r2 with
               | Cons (TP op2, _) -> if is_nonassoc_op op && is_nonassoc_op op2 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: syntax error, non-associative operator")) in fail "mere-ruby: syntax error, non-associative operator") else ()
               | _ -> ()) in
      parse_more (EBin (op, lhs, rhs)) r2 minp
    else (lhs, toks)
  | _ -> (lhs, toks)

and parse_unary = fn toks ->
  match toks with
  | Cons (TP op, rest) ->
    if str_eq op "-" then
      // a minus directly on a numeric literal folds into the literal, so a
      // postfix call sees the negative value: -2.abs == 2 (but ** still
      // binds tighter: -2**2 == -4, which the fold skips).
      (match rest with
       | Cons (TInt n, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EInt (0 - n)) r1)
       | Cons (TFlt f, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          // `0.0 - f` loses the sign of a zero (it is +0.0); multiplying keeps it.
          else neg_lit_tail (EFlt (f * (0.0 - 1.0))) r1)
       | Cons (TBig b, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EBig ("-" ++ b)) r1)
       | Cons (TRat (n, d), r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (ERat ("-" ++ n, d)) r1)
       | Cons (TImag n, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImag (0 - n)) r1)
       | Cons (TImagF f, r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImagF (f * (0.0 - 1.0))) r1)
       | Cons (TImagRat (n, d), r1) ->
         (if neg_next_pow r1 then (let (e, r) = parse_unary rest in (EUn ("-", e), r))
          else neg_lit_tail (EImagRat ("-" ++ n, d)) r1)
       | _ -> let (e, r) = parse_unary rest in (EUn ("-", e), r))
    else if str_eq op "+" then
      // unary + is identity for a numeric literal, but `+str` on a FROZEN
      // string is an unfrozen copy -- which is the whole point of writing it
      // -- so it has to reach String#+@ rather than fold away here.
      (match rest with
       | Cons (TInt _, _) -> parse_unary rest
       | Cons (TFlt _, _) -> parse_unary rest
       | Cons (TBig _, _) -> parse_unary rest
       | Cons (TRat (_, _), _) -> parse_unary rest
       | _ -> let (e, r) = parse_unary rest in (EUn ("+", e), r))
    else if str_eq op "!" then
      let (e, r) = parse_unary rest in (EUn ("!", e), r)
    else if str_eq op "~" then
      let (e, r) = parse_unary rest in (EUn ("~", e), r)
    else parse_pow toks
  | _ -> parse_pow toks

and neg_next_pow = fn toks ->
  match toks with Cons (TP p2, _) -> str_eq p2 "**" | _ -> false
// postfix chain on a folded negative literal, keeping parse_pow's ** tail
// ((-2).abs ** 2 parses like 2 ** 2).
and neg_lit_tail = fn (lit: Expr) -> fn toks ->
  let (b, r) = parse_postfix_more lit toks in
  (match r with
   | Cons (TP p2, rest2) ->
     if str_eq p2 "**" then (let (e, r2) = parse_unary (skip_nls rest2) in (EBin ("**", b, e), r2))
     else (b, r)
   | _ -> (b, r))

and parse_pow = fn toks ->
  let (b, r) = parse_postfix toks in
  match r with
  | Cons (TP op, rest) ->
    // `**` is parsed here rather than in parse_more, so the trailing-operator
    // line continuation parse_more does has to be repeated.
    if str_eq op "**" then
      let (e, r2) = parse_unary (skip_nls rest) in (EBin ("**", b, e), r2)
    else (b, r)
  | _ -> (b, r)

// postfix method-call chains: `recv.name`, `recv.name(args)`, and the
// setter form `recv.name = expr` (parsed as a call to `name=`).
and parse_postfix = fn toks ->
  let (e, r) = parse_primary toks in
  parse_postfix_more e r

and parse_postfix_more = fn (recv: Expr) -> fn toks ->
  match toks with
  // a newline followed by .method continues the chain (leading-dot style).
  | Cons (TNL _, _) ->
    let t2 = skip_nls toks in
    (match t2 with
     | Cons (TP dot, _) -> if str_eq dot "." then parse_postfix_more recv t2 else (recv, toks)
     | _ -> (recv, toks))
  | Cons (TP dot0, r0) ->
    // A space-marked `[` after a COMPLETE expression is an index, not an array
    // literal: `config.for_cop('X') ['Y']` (rubocop) reads the result. The
    // ambiguous case -- a bare name followed by ` [` -- never reaches here; it
    // is settled where the identifier itself is parsed.
    let dot = (if str_eq dot0 " [" then "[" else dot0) in
    let r = (if str_eq dot "." then skip_nls r0 else r0) in   // `x.` + newline continues
    if str_eq dot "." then
      (match r with
       | Cons (TId name, r2) ->
         (match r2 with
          | Cons (TP p, r3) ->
            // `recv.name (expr), more` (space before the paren): the group is
            // the FIRST argument of a paren-less list, so a following comma
            // continues that list and a trailing `.m` binds to the group --
            // `a.insert (i || -1), v` is a two-argument call, not `insert(i)`.
            if str_eq p " (" then
              let (es, r4) = parse_puts_args r2 Nil in
              attach_block_method recv name es r4
            else if is_lparen p then
              let (argv, r4) = parse_call_args r3 in
              attach_block_method recv name argv r4
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // attribute op-assign: recv evaluated exactly once.
            else if not (str_eq (opassign_base p) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ -> attach_block_method recv name Nil r2)
       // `recv.(args)` is shorthand for `recv.call(args)`.
       | Cons (TP lp, r2) ->
         if str_eq lp "(" then let (argv, r3) = parse_call_args r2 in attach_block_method recv "call" argv r3
         // `recv.[](args)` / `recv.[]=(v)` — the bracket method called via dot.
         else if str_eq lp "[" && (match r2 with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
           (match r2 with
            | Cons (_, r3) ->
              (match r3 with
               | Cons (TP op, r4) ->
                 if str_eq op "(" then let (argv, r5) = parse_call_args r4 in attach_block_method recv "[]" argv r5
                 // `recv.[]=(k, v)` passes the setter ALL its arguments, index
                 // and value both; `recv.[]= v` is the one-argument form.
                 else if str_eq op "=" then
                   (match r4 with
                    | Cons (TP lp2, r5) ->
                      if str_eq lp2 "(" then
                        (let (argv, r6) = parse_call_args r5 in
                         parse_postfix_more (EMethod (recv, "[]=", argv)) r6)
                      else (let (rhs, r5b) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5b))
                    | _ -> (let (rhs, r5b) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5b)))
                 else parse_postfix_more (EMethod (recv, "[]", Nil)) r3
               | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r3)
            | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r2)
         // `recv.=~(x)` / `recv.+(y)` — explicit operator-method calls.
         else if is_op_method_name lp then
           (match r2 with
            | Cons (TP lp2, r3) ->
              if str_eq lp2 "(" then
                let (argv, r4) = parse_call_args r3 in
                parse_postfix_more (EMethod (recv, lp, argv)) r4
              else parse_postfix_more (EMethod (recv, lp, Nil)) r2
            | _ -> parse_postfix_more (EMethod (recv, lp, Nil)) r2)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after ." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after ." ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after ." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after ." ++ parsing_file ())))
    // index: recv[i] -> recv.[](i); recv[i] = v -> recv.[]=(i, v)
    else if str_eq dot "[" && (match r with Cons (TP rb0, _) -> str_eq rb0 "]" | _ -> false) then
      // empty index `recv[]` (getter) or `recv[] = v` (setter).
      (match r with
       | Cons (_, Cons (TP eq, r0e)) ->
         if str_eq eq "=" then
           let (rhs, r5) = parse_expr (skip_nls r0e) in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5)
         // `recv[] op= v` -> `recv[]= (recv[] op v)`.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r0e) in
           (EIdxOp (recv, Nil, opassign_base eq, rhs), r5)
         else (match r with Cons (_, r0f) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0f | _ -> (recv, toks))
       | Cons (_, r0e) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0e
       | _ -> (recv, toks))
    else if str_eq dot "[" then
      // one or more comma-separated indices (a[i], a[start, len], a[*idx]).
      let (idxs, r3) = parse_x_idx r Nil in
      (match r3 with
       | Cons (TP eq, r4) ->
         if str_eq eq "=" then
           let (rhs, r5) =
             (match skip_nls r4 with
              | Cons (TP st2, r4b) ->
                if str_eq st2 "*" then
                  let (inner, r5b) = parse_expr r4b in (EArr (Cons (ESplat inner, Nil)), r5b)
                else parse_expr (skip_nls r4)
              | _ -> parse_expr (skip_nls r4)) in
           (EMethod (recv, "[]=", eapp idxs (Cons (rhs, Nil))), r5)
         // recv[i] op= v desugars through a read-modify-write ([]= of
         // [] op v); ||= and &&= use their short-circuit operators.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r4) in
           (EIdxOp (recv, idxs, opassign_base eq, rhs), r5)
         else parse_postfix_more (EMethod (recv, "[]", idxs)) r3
       | _ -> parse_postfix_more (EMethod (recv, "[]", idxs)) r3)
    // safe navigation: a&.b / a&.b(args) — nil receiver short-circuits.
    else if str_eq dot "&." then
      let (name, r2) = safe_nav_name r in
      (match r2 with
       | Cons (TP p2, r3) ->
            // space-paren: the group is the first of a paren-less argument
            // list, exactly as for `.` above.
            if str_eq p2 " (" then
              let (es, r4) = parse_puts_args r2 Nil in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, es, bp, bb)) r5
              else parse_postfix_more (ESafe (recv, name, es)) r4
            else if str_eq p2 "(" then
              let (argv, r4) = parse_call_args r3 in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, argv, bp, bb)) r5
              else
                // `a&.map(&:to_s)`: a trailing block-PASS is a block too, and
                // safe navigation used to keep it as an argument -- which the
                // dispatcher then read as `map(:to_s)`, i.e. an Enumerator with
                // a stray argument rather than a mapped array. `.map(&:to_s)`
                // went through this same rewrite; only `&.` did not.
                (let (argv2, hasbp, bp2, bb2) = extract_block_pass argv in
                 if hasbp then parse_postfix_more (ESafeB (recv, name, argv2, bp2, bb2)) r4
                 else parse_postfix_more (ESafe (recv, name, argv)) r4)
            else if str_eq p2 "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // safe-navigation op-assign: recv&.attr op= rhs.
            else if not (str_eq (opassign_base p2) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (EBin (opassign_base p2, ESafe (recv, name, Nil), rhs), Nil)), r4)
            else if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in
              parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
            else parse_postfix_more (ESafe (recv, name, Nil)) r2
       // `do` is a name token, so a do-block lands here rather than above.
       | _ ->
         if starts_block r2 then
           let (bp, bb, r4) = parse_block r2 in
           parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
         else parse_postfix_more (ESafe (recv, name, Nil)) r2)
    // scope resolution: Foo::Bar (nested constant, looked up by bare name)
    // or Foo::meth(...) (module/class method call).
    else if str_eq dot "::" then
      (match r with
       | Cons (TId name, r2) ->
         // A::B is the constant B qualified by A; keep the full name so a
         // namespaced class resolves and reports consistently.
         let mkread = (match recv with
                       | EConst rc -> EConst (rc ++ "::" ++ name)
                       | _ -> EScopedRead (recv, name)) in
         (match r2 with
          | Cons (TP p, r3) ->
            if is_lparen p then let (argv, r4) = parse_call_args r3 in attach_block_method recv name argv r4
            // recv::Const = value : a runtime-receiver constant assignment.
            else if is_cap name && str_eq p "=" then let (v, r4) = parse_expr r3 in (EScopedAssign (recv, name, v), r4)
            // recv::Const op= value -> t = recv; t::Const = t::Const op value,
            // evaluating the receiver expression exactly once (side effects).
            else if is_cap name && (if str_eq (opassign_base p) "" then false else true) then
              let (v, r4) = parse_expr (skip_nls r3) in
              let tmp = fresh_tmp () in
              let base = opassign_base p in
              // `||=` treats an undefined constant as nil (then assigns); other
              // op-assigns read first, so an undefined constant raises NameError.
              let readx = if str_eq base "||" then EScopedReadOrNil (EVar tmp, name) else EScopedRead (EVar tmp, name) in
              (EStmt (SBegin (Cons (SAssign (tmp, recv), Cons (SExpr (EScopedAssign (EVar tmp, name, EBin (base, readx, v))), Nil)), Nil, Nil, Nil)), r4)
            else if is_cap name then parse_postfix_more mkread r2
            // `Recv::name = v` is the setter call `Recv.name = v` -- `::` and
            // `.` are interchangeable for method calls, and concurrent-ruby's
            // tvar.rb writes `Transaction::current = nil`.
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            else if (if str_eq (opassign_base p) "" then false else true) then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ ->
            if is_cap name then parse_postfix_more mkread r2
            else attach_block_method recv name Nil r2)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected name after ::" ++ parsing_file ()))) in fail ("mere-ruby: expected name after ::" ++ parsing_file ())))
    else (recv, toks)
  | _ -> (recv, toks)

// a trailing `{ }` / `do end` block turns a method call into EMethodB.
// the method name after `&.`. Usually an ordinary name, but an operator
// method may be written out the same way it can after `.`:
// `mapping&.[](key)`, `x&.+(y)`.
and safe_nav_name = fn toks ->
  match toks with
  | Cons (TId name, r) -> (name, r)
  | Cons (TP lb, r) ->
    if str_eq lb "[" && (match r with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
      (match r with Cons (_, r2) -> ("[]", r2) | _ -> ("[]", r))
    else if is_op_method_name lb then (lb, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after &." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after &." ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after &." ++ parsing_file ()))) in fail ("mere-ruby: expected method name after &." ++ parsing_file ()))

and attach_block_method = fn (recv: Expr) -> fn (name: str) -> fn (argv: Expr list) -> fn toks ->
  // paren-less block-pass: `recv.meth &blk` (the " &" token = space-before,
  // no-space-after). Turn the following expr into a block-pass argument.
  let (argv, toks) = (match argv with
    | Nil -> (match toks with
              | Cons (TP amp, r) -> if str_eq amp " &" then (let (be, r1) = parse_expr r in (Cons (EBlockPass be, Nil), r1)) else (argv, toks)
              | _ -> (argv, toks))
    | _ -> (argv, toks)) in
  let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
  if hasbp then parse_postfix_more (EMethodB (recv, name, argv2, bp0, bb0)) toks
  else if starts_block toks then
    let (bp, bb, r) = parse_block toks in
    // continue the chain: `arr.map { } .sum` etc.
    parse_postfix_more (EMethodB (recv, name, argv, bp, bb)) r
  // paren-less argument on a dotted call: `x.should be_nil` / `a.push v` /
  // `ScratchPad.record []` (a space before [ means an array argument).
  else if (match argv with Nil -> true | _ -> false) && (starts_bare_arg toks || starts_sp_bracket toks) then
    // suppress do-block attachment while parsing the bare args so a trailing
    // `do...end` binds to this call, not to a bare-identifier argument
    // (`Class.new sc do ... end` = Class.new(sc) { ... }).
    let had = map_has parser_flags "nodo" in
    let _ = map_set parser_flags "nodo" VNil in
    let (es, r2) = parse_puts_args toks Nil in
    let _ = if had then () else map_delete parser_flags "nodo" in
    // `obj.meth :arg do |x| ... end` — a do-block after bare args.
    if starts_do_block r2 then
      let (bp, bb, r3) = parse_block r2 in
      parse_postfix_more (EMethodB (recv, name, es, bp, bb)) r3
    else parse_postfix_more (EMethod (recv, name, es)) r2
  else parse_postfix_more (EMethod (recv, name, argv)) toks

// `name [items]` is an index or a call with an array argument, and eval
// decides -- unless a `do` block follows, which only a CALL can take. Ruby's
// own specs are written that way (`argf [@file1, @file2] do ... end`), and 42
// of the 75 files the parse sweep could not read were this one shape.
and ambig_or_call = fn (id: str) -> fn (ae: Expr) -> fn toks ->
  if starts_do_block toks then
    (let (bp, bb, r) = parse_block toks in (ECallB (id, Cons (ae, Nil), bp, bb), r))
  else
    (match ae with
     | EArr items -> (EAmbigIdx (id, items), toks)
     | other -> (ECall (id, Cons (other, Nil)), toks))

and starts_do_block = fn toks ->
  match toks with Cons (TId d, _) -> str_eq d "do" | _ -> false

and starts_sp_bracket = fn toks ->
  match toks with Cons (TP lb, _) -> str_eq lb " [" | _ -> false

// does a paren-less argument start here? (an identifier that isn't a
// keyword/modifier, or a literal)
// Kernel conversion functions written like `Integer(x)`.
and is_conv_fn = fn (id: str) ->
  str_eq id "Integer" || str_eq id "Float" || str_eq id "String" ||
  str_eq id "Array" || str_eq id "Rational" || str_eq id "Complex" || str_eq id "Hash"

and starts_bare_arg = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    // value keywords are arguments (`x.go false`); a def is an expression
    // (`ruby2_keywords def m...`); structural keywords are not arguments.
    if str_eq w "true" || str_eq w "false" || str_eq w "nil" || str_eq w "self" ||
       str_eq w "def" || str_eq w "yield" then true
    else if is_keyword w || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
       str_eq w "in" || str_eq w "for" then false
    else true
  | Cons (TInt _, _) -> true
  | Cons (TBig _, _) -> true
  | Cons (TRat _, _) -> true
  | Cons (TImag _, _) -> true
  | Cons (TImagF _, _) -> true
  | Cons (TImagRat _, _) -> true
  | Cons (TFlt _, _) -> true
  | Cons (TStrL _, _) -> true
  | Cons (TSym _, _) -> true
  | Cons (TRegex _, _) -> true
  // dq string, unary ~ / !, lambda, or a top-level constant path (` ::Const`).
  // `f !x` can only be a negated argument: a method named f! lexes as one
  // token, and `a ! b` is not Ruby.
  | Cons (TP p, _) -> str_eq p "(s" || str_eq p "~" || str_eq p "!" || str_eq p "->" || str_eq p " ::"
  | _ -> false

// A trailing `&:sym` block-pass arg becomes a real one-param block
// `{ |__bp| __bp.sym }`. Returns (args-without-bp, found?, bparams, bbody).
and extract_block_pass = fn (argv: Expr list) ->
  match rev_app argv Nil with
  | Cons (EBlockPass be, rrest) ->
    (match be with
     | ESym s ->
       // Symbol#to_proc takes the receiver plus ANY further arguments
       // (arity -2), so a two-argument caller works too: `reduce(&:concat)`
       // is `{ |a, *rest| a.concat(*rest) }`, not `{ |a| a.concat }`. It is a
       // LAMBDA, which matters here: a plain 2-param block would auto-splat,
       // so `group_by(&:name)` over array-ish elements would tear them apart
       // instead of passing each one whole as the receiver.
       (rev_app rrest Nil, true,
        Cons (lambda_blk_marker, Cons ("__bp", Cons ("*__ba", Nil))),
        Cons (SExpr (EMethod (EVar "__bp", s, Cons (ESplat (EVar "__ba"), Nil))), Nil))
     // general &expr: mark for runtime coercion (Proc/nil/to_proc) at the
     // call site — the "&coerce" param sentinel carries the expr in its body.
     | _ -> (rev_app rrest Nil, true, Cons ("&coerce", Nil), Cons (SExpr be, Nil)))
  | _ -> (argv, false, (Nil : str list), (Nil : Stmt list))

and starts_block = fn toks ->
  match toks with
  | Cons (TP p, _) -> str_eq p "\{" && (if map_has parser_flags "nobrace" then false else true)
  | Cons (TId d, _) -> str_eq d "do" && (if map_has parser_flags "nodo" then false else true)
  | _ -> false

// parse `{ |p,..| stmt }` (single statement) or `do |p,..| stmts end`.
// a `|a=5|` default becomes a prologue statement: the bind sets missing
// args to nil, so a nil param takes its default (explicit nil is rare).
// recover the (name, default) pairs a block encodes as leading nil-check
// prologue statements, so the argument fill can order optionals correctly.
and block_defaults = fn (body: Stmt list) ->
  match body with
  | Cons (SIf (Cons ((cond, Cons (SAssign (n, d), Nil)), Nil), Nil), rest) ->
    (match cond with
     | EMethod (EVar cn, m, Nil) ->
       if str_eq m "nil?" && str_eq cn n then Cons ((n, d), block_defaults rest)
       else Nil
     | _ -> Nil)
  | _ -> Nil

and defaults_prologue = fn (ds: (str * Expr) list) -> fn (body: Stmt list) ->
  match ds with
  | Nil -> body
  | Cons ((n, d), rest) ->
    Cons (SIf (Cons ((EMethod (EVar n, "nil?", Nil), Cons (SAssign (n, d), Nil)), Nil), Nil),
          defaults_prologue rest body)

and parse_block = fn toks ->
  match toks with
  | Cons (TP brace, r) ->
    if str_eq brace "\{" then
      let (bp, ds, r2) = parse_block_params_d r in
      let (body, r3) = parse_brace_stmts r2 Nil in
      (bp, defaults_prologue ds body, r3)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))
  | Cons (TId d, r) ->
    if str_eq d "do" then
      let (bp, ds0, r2) = parse_block_params_d r in
      let (body0, r3) = parse_stmts r2 Nil in
      // do-blocks accept trailing rescue/ensure (an implicit begin).
      let (body, r5) =
        (match r3 with
         | Cons (TId k, _) ->
           if str_eq k "rescue" || str_eq k "ensure" then
             let (rescues, ra) = parse_rescues r3 Nil in
             let (els, rb) = parse_opt_kw_block ra "else" in
             let (ens, rc) = parse_opt_kw_block rb "ensure" in
             (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
           else (body0, r3)
         | _ -> (body0, r3)) in
      (bp, defaults_prologue ds0 body, expect_kw r5 "end")
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block" ++ parsing_file ()))) in fail ("mere-ruby: expected block" ++ parsing_file ()))

// statements inside a `{ ... }` block, terminated by `}` (consumed).
and parse_brace_stmts = fn toks -> fn (acc: Stmt list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP p, r) ->
    if str_eq p "}" then (rev_app acc Nil, r)
    else let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
         parse_brace_stmts r1 (Cons (s, acc))
  | Cons (TEOF, _) -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated block" ++ parsing_file ()))) in fail ("mere-ruby: unterminated block" ++ parsing_file ()))
  | _ ->
    let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
    parse_brace_stmts r1 (Cons (s, acc))

and parse_block_params = fn toks ->
  let (bp, ds, r) = parse_block_params_d toks in
  (bp, r)

// like parse_block_params but also returns (name, default-expr) pairs for
// optional params (`|a=5, b=4|`); parse_block turns them into a prologue.
and parse_block_params_d = fn toks ->
  let t = skip_nls toks in
  match t with
  | Cons (TP bar, r) ->
    if str_eq bar "|" then parse_pipe_params r Nil Nil
    else if str_eq bar "||" then (Cons (empty_bp_marker, Nil), (Nil : (str * Expr) list), r)
    else (Nil, Nil, t)
  | _ -> (Nil, Nil, t)

and parse_pipe_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  // `|one; bl|` — names after a semicolon (lexed as TNL) are block-locals:
  // encoded with a ; prefix, they always bind nil.
  | Cons (TNL _, r) -> parse_block_locals r acc ds
  | Cons (TP bar, r) ->
    if str_eq bar "|" then (rev_app acc Nil, rev_app ds Nil, r)
    else if str_eq bar "*" then
      (match r with Cons (TId n, r2) -> pipe_after ("*" ++ n) r2 acc ds | _ -> pipe_after "*" r acc ds)
    else if str_eq bar "**" then
      // `**kw` — keyword-splat: collects a trailing hash argument (or {}).
      (match r with Cons (TId n, r2) -> pipe_after ("**" ++ n) r2 acc ds | _ -> pipe_after "**" r acc ds)
    else if str_eq bar "&" then
      (match r with Cons (TId n, r2) -> pipe_after ("&" ++ n) r2 acc ds | _ -> pipe_after "&" r acc ds)
    else if str_eq bar "(" then
      // nested destructuring |(a, (b, c))| — encoded as a spec string.
      let (spec, r2) = pipe_group r "" in
      pipe_after ("(" ++ spec ++ ")") r2 acc ds
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
  | Cons (TId name, r) ->
    // `a=default` — an optional parameter; `k:` / `k: default` — keyword.
    (match r with
     // `|b:|` — the lexer reads `:|` as the operator symbol :| — that is a
     // required keyword param immediately before the closing bar.
     | Cons (TSym sy, r2) ->
       if str_eq sy "|" then (rev_app (Cons (name ++ ":", acc)) Nil, rev_app ds Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // parse above `|`'s precedence so the closing bar stays the closer
         let (d, r3) = parse_bin r2 6 in
         pipe_after name r3 acc (Cons ((name, d), ds))
       else if str_eq eq ":" then
         (match r2 with
          | Cons (TP nx, _) ->
            if str_eq nx "," || str_eq nx "|" then pipe_after (name ++ ":") r2 acc ds
            else
              let (d, r3) = parse_bin r2 6 in
              pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds))
          | _ ->
            let (d, r3) = parse_bin r2 6 in
            pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds)))
       else pipe_after name r acc ds
     | _ -> pipe_after name r acc ds)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block parameter" ++ parsing_file ()))) in fail ("mere-ruby: expected block parameter" ++ parsing_file ()))

// tokens of a nested destructure group (after the opening paren) encoded
// back into a compact string: names, commas, splats, nested groups.
and pipe_group = fn toks -> fn (acc: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (acc, r)
    else if is_lparen p || str_eq p " [" then
      let (inner, r2) = pipe_group r "" in pipe_group r2 (acc ++ "(" ++ inner ++ ")")
    else if str_eq p "," then pipe_group r (acc ++ ",")
    else if str_eq p "*" then pipe_group r (acc ++ "*")
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")
  | Cons (TId n, r) -> pipe_group r (acc ++ n)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block params")) in fail "mere-ruby: bad block params")

and parse_block_locals = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then parse_block_locals r2 (Cons (";" ++ n, acc)) ds
       else if str_eq c "|" then (rev_app (Cons (";" ++ n, acc)) Nil, rev_app ds Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list")
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list"))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad block-local list")) in fail "mere-ruby: bad block-local list")

and pipe_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `|a,|` — a trailing comma forces destructuring: add an anonymous
      // splat so a single Array/to_ary arg splits (a = first element). The
      // marker "*," (distinct from a real "*") records the trailing comma so a
      // lambda still enforces an exact arity (`->(a,){}` is arity 1, not -2).
      (match r with
       | Cons (TP bar2, _) -> if str_eq bar2 "|" then parse_pipe_params r (Cons ("*,", Cons (name, acc))) ds
                              else parse_pipe_params r (Cons (name, acc)) ds
       | _ -> parse_pipe_params r (Cons (name, acc)) ds)
    else if str_eq p "|" then (rev_app (Cons (name, acc)) Nil, rev_app ds Nil, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or | in block params" ++ parsing_file ()))) in fail ("mere-ruby: expected , or | in block params" ++ parsing_file ()))
  // `|one; bl|` — the ; (lexed as a newline) starts the block-local names.
  | Cons (TNL _, r) -> parse_block_locals r (Cons (name, acc)) ds
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated block params" ++ parsing_file ()))) in fail ("mere-ruby: unterminated block params" ++ parsing_file ()))

// fold any string literals immediately following `e` into it (Ruby's
// adjacent-string-literal concatenation).
and concat_adjacent_strings = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      let (e2, r2) = parse_expr r in
      concat_adjacent_strings (EBin ("+", e, e2)) (expect r2 ")")
    else (e, toks)
  | Cons (TStrL s2, r) -> concat_adjacent_strings (EBin ("+", e, EStrL s2)) r
  | _ -> (e, toks)

and parse_primary = fn toks ->
  match toks with
  | Cons (TInt n, r) -> (EInt n, r)
  | Cons (TBig b, r) -> (EBig b, r)
  | Cons (TRat n, r) -> (ERat n, r)
  | Cons (TImag n, r) -> (EImag n, r)
  | Cons (TImagF f, r) -> (EImagF f, r)
  | Cons (TImagRat n, r) -> (EImagRat n, r)
  | Cons (TRegex p, r) ->
    // record the literal for post-parse validation (rx_check_pending): an
    // invalid regex is a parse-time SyntaxError, unsupported ones pass.
    let (rbody, rfl) = p in
    let n = (if map_has rx_pending "n" then (match map_get rx_pending "n" with VInt k -> k | _ -> 0) else 0) in
    let _ = map_set rx_pending ("e" ++ str_of_int n) (mkstr (rfl ++ "\n" ++ rbody)) in
    let _ = map_set rx_pending "n" (VInt (n + 1)) in
    (ERegex p, r)
  | Cons (TFlt f, r) -> (EFlt f, r)
  // adjacent string literals concatenate, whichever quoting each one uses:
  // `'a' "b"` and `'a' \<newline> "b"` read the same as `"a" "b"`.
  | Cons (TStrL s, r) -> concat_adjacent_strings (EStrL s) r
  | Cons (TSym s, r) -> (ESym s, r)
  | Cons (TId id, r) ->
    // `and` / `or` cannot START an expression; ruby rejects a line beginning
    // with one. Saying so here (instead of reading it as a call to a method
    // named `and`) turns a confusing NoMethodError at run time into a parse
    // error that names the file.
    if str_eq id "and" || str_eq id "or" then
      (let __fm = ("mere-ruby: unexpected keyword: " ++ id) in
       let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
    else if str_eq id "true" then (EBool true, r)
    else if str_eq id "false" then (EBool false, r)
    else if str_eq id "nil" then (ENil, r)
    else if str_eq id "self" then (ESelf, r)
    else if is_ivar id then
      (match r with
       | Cons (TP eq, r2) ->
         if str_eq eq "=" then let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3)
         else if not (str_eq (opassign_base eq) "") then
           let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, EBin (opassign_base eq, EIVar (substring id 1 (str_len id)), e)), r3)
         else (EIVar (substring id 1 (str_len id)), r)
       | _ -> (EIVar (substring id 1 (str_len id)), r))
    else if is_cap id then
      (match r with
       | Cons (TP eq, r2) ->
         // A capitalized name immediately followed by `(` is a METHOD CALL,
         // not a constant — constants can't be "called" with parens in Ruby.
         // This covers the Kernel conversion functions (Integer(x) / Float(x)
         // / Rational(n,d) / Complex(r,i) / Array / String) AND user-defined
         // capitalized methods (`def Rainbow(s)` … `Rainbow("x")`).
         if str_eq eq "(" then
           let (argv, r3) = parse_call_args r2 in (ECall (id, argv), r3)
         else if str_eq eq "=" then let (e, r3) = parse_expr r2 in (EAssign (id, e), r3)
         // A double-quoted string, lambda or unary argument settles it as a
         // call the same way a bare one does below -- `LOG "reading #{len}
         // bytes..."` in net/protocol is a method named LOG. (Only the token
         // KINDS starts_bare_arg accepts; `Foo::Bar`, `Foo[i]` and `Foo.m`
         // are not among them and stay constants.)
         else if str_eq eq " (" || starts_bare_arg r then
           let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (EConst id, r)
       // `Array licenses` / `Integer str` — the paren-less form of the same
       // call. A constant takes no argument, so a bare argument here settles
       // it as a method call. (`Foo::Bar`, `Foo.m` and a plain `Foo` reach
       // this with a token that starts no argument, and stay constants.)
       | _ ->
         if starts_bare_arg r then let (argv, r3) = parse_puts_args r Nil in (ECall (id, argv), r3)
         else (EConst id, r))
    else if str_eq id "yield" then
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then let (argv, r3) = parse_call_args r2 in (EYield argv, r3)
         // `yield [0]` passes an array literal (not an index on the result).
         else if str_eq p "[" || str_eq p " [" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         // A double-quoted string is lexed as `TP "(s"` -- the open of the
         // interpolation desugaring -- and `is_lparen` only knows "(" and " (",
         // so `yield "k", 2` fell into the no-argument case and the statement
         // parser then said "expected end of statement". rubygems' config_file.rb
         // writes `yield "config_file_name", @config_file_name if @config_file_name`.
         //
         // ONLY that token is added. Widening the test to "anything that is not a
         // closer starts an argument" -- the rule `raise` uses -- broke three
         // inputs that had always worked: `cond ? yield : x` (a parse error, then
         // an infinite loop once the colon was half-handled), and `yield + 10`,
         // which ruby reads as `(yield) + 10` and that read as `yield(+10)`.
         // `yield + 10` against `yield +10` is decided by the space AFTER the
         // operator, which the token does not carry, so the operators stay on the
         // no-argument side where they have always been.
         else if str_eq p "(s" || str_eq p " (s" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         else (EYield Nil, r)
       | Cons (TNL _, _) -> (EYield Nil, r)
       | Cons (TEOF, _) -> (EYield Nil, r)
       // `yield end` / `yield if c` — a stop keyword ends a bare yield.
       | Cons (TId w, _) -> if stops_value w then (EYield Nil, r) else let (es, r2) = parse_puts_args r Nil in (EYield es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (EYield es, r2))
    else if str_eq id "raise" then
      (match r with
       | Cons (TNL _, _) -> (ERaise Nil, r)
       | Cons (TEOF, _) -> (ERaise Nil, r)
       // bare raise before a modifier/terminator keyword takes no args.
       | Cons (TId w, _) ->
         if stops_value w then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | Cons (TP p, _) ->
         // a paren-less argument has to START an expression: a closer or a
         // binary-only operator means this `raise` takes none. i18n writes
         // `raise && :raise` (where `raise` is a keyword PARAMETER, so ruby
         // reads the local), and `[k, raise]` is the same shape.
         if str_eq p ")" || str_eq p "}" || str_eq p ";" || str_eq p "]" ||
            str_eq p "," || str_eq p "&&" || str_eq p "||" || str_eq p "==" ||
            str_eq p "!=" || str_eq p "=>" || str_eq p "?" || str_eq p "." ||
            str_eq p "<" || str_eq p ">" || str_eq p "<=" || str_eq p ">=" ||
            str_eq p "<=>" || str_eq p "=~" then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (ERaise es, r2))
    else if str_eq id "super" then
      // `super` forwards the current args; `super(...)` / `super()` are explicit.
      let (zs, argv, r1) =
        (match r with
         | Cons (TP p, r2) ->
           if is_lparen p then let (a, r3) = parse_call_args r2 in (false, a, r3)
           // `super x` / `super "msg", y` — paren-less arguments, like any
           // other command call. Without this the bare form parsed as zsuper
           // and the argument was left dangling. A SPACE-marked `[` is an
           // array argument too (`super [*message, ...].join("\n")`), which is
           // exactly what the lexer marks it for.
           else if starts_bare_arg r || starts_sp_bracket r then let (a, r3) = parse_puts_args r Nil in (false, a, r3)
           else (true, Nil, r)
         | _ -> if starts_bare_arg r then let (a, r3) = parse_puts_args r Nil in (false, a, r3)
                else (true, Nil, r)) in
      // `super { ... }` / `super do ... end` passes an explicit block.
      if starts_block r1 then
        let (bp, bb, r4) = parse_block r1 in (ESuperB (zs, argv, bp, bb), r4)
      else (ESuper (zs, argv), r1)
    else if str_eq id "not" then
      // `not(x)` / `not x` — negation; with parens the chain continues
      // on the negated value (not(true).should == ...).
      (match r with
       | Cons (TP lp, _) ->
         if str_eq lp "(" then let (e, r2) = parse_primary r in (EUn ("!", e), r2)
         else let (e, r2) = parse_expr r in (EUn ("!", e), r2)
       | _ -> let (e, r2) = parse_expr r in (EUn ("!", e), r2))
    else if str_eq id "defined?" then
      // defined?(e) or defined? e — never evaluates e for its value.
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then
           // defined?(x = 2) and friends answer "assignment" unevaluated.
           if defined_assignish r2 then
             let (_, r3) = parse_stmt r2 in (EStrL "assignment", expect r3 ")")
           // defined?(if.../while.../case... end) answers "expression".
           else if defined_compound r2 then
             let (_, r3) = parse_stmt r2 in (EStrL "expression", expect r3 ")")
           else
           // defined?(puts) — a keyword-named method probes as a plain call.
           // parse the inner expression at the lowest precedence so the word
           // operators `and`/`or`/`not` are allowed (`defined?(a and b)`).
           (match r2 with
            | Cons (TId w, Cons (TP rp, r4)) ->
              if str_eq rp ")" then (EDefined (EVar w), r4)
              else let (e, r3) = parse_andor r2 in (EDefined e, expect r3 ")")
            | _ -> let (e, r3) = parse_andor r2 in (EDefined e, expect r3 ")"))
         // `defined? a = 10` (no parens) — an assignment is unevaluated.
         else if defined_assignish r then
           let (_, r3) = parse_stmt r in (EStrL "assignment", r3)
         else let (e, r3) = parse_unary r in (EDefined e, r3)
       // `defined? a = 10` at statement start (no leading paren token).
       | _ ->
         if defined_assignish r then
           let (_, r3) = parse_stmt r in (EStrL "assignment", r3)
         else let (e, r3) = parse_unary r in (EDefined e, r3))
    else if str_eq id "break" || str_eq id "next" || str_eq id "return" || str_eq id "redo" || str_eq id "retry" then
      // flow keywords in expression position (ternary branches, call args).
      (match r with
       | Cons (TNL _, _) -> (EFlow (id, ENil), r)
       | Cons (TEOF, _) -> (EFlow (id, ENil), r)
       | Cons (TP p, _) ->
         if str_eq p ")" || str_eq p "}" || str_eq p "]" || str_eq p "," ||
            str_eq p ":" || str_eq p ";" then (EFlow (id, ENil), r)
         else if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | Cons (TId w, _) ->
         if stops_value w || str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | _ ->
         if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2))
    else if str_eq id "if" then
      // statement constructs usable as expressions (call args etc.).
      let (s, r2) = parse_if r false in (EStmt s, r2)
    else if str_eq id "unless" then let (s, r2) = parse_if r true in (EStmt s, r2)
    else if str_eq id "while" then let (s, r2) = parse_while r false in (EStmt s, r2)
    else if str_eq id "until" then let (s, r2) = parse_while r true in (EStmt s, r2)
    else if str_eq id "for" then let (s, r2) = parse_for r in (EStmt s, r2)
    else if str_eq id "case" then let (s, r2) = parse_case r in (EStmt s, r2)
    else if str_eq id "begin" then let (s, r2) = parse_begin r in (EStmt s, r2)
    // def/class in expression position (def evaluates to the method name
    // as a symbol; class to its body's last value).
    else if str_eq id "def" then let (s, r2) = parse_def r in (EStmt s, r2)
    else if str_eq id "class" then let (s, r2) = parse_class r in (EStmt s, r2)
    else if is_keyword id then (let __fm = ("mere-ruby: unexpected keyword: " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
    else
      // `name(args)` / `name(args) { block }` / `name { block }` / bare name.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           // assignment as an expression: `true && x = 1` binds rightmost.
           (match r2 with
            | Cons (TP st, r2b) ->
              if str_eq st "*" then
                let (e, r3) = parse_expr (skip_nls r2b) in (EAssign (id, EArr (Cons (ESplat e, Nil))), r3)
              else let (e, r3) = parse_expr (skip_nls r2) in (EAssign (id, e), r3)
            | _ -> let (e, r3) = parse_expr r2 in (EAssign (id, e), r3))
         else if not (str_eq (opassign_base p) "") then
           // op-assign as an expression: `(i += 1) >= 5`.
           let (e, r3) = parse_expr (skip_nls r2) in
           (EAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         // `name (expr)...` (space before paren): the parenthesised group is
         // the first command argument, so a trailing `.m`/operator binds to it
         // (`p (1..3).map { }` = p((1..3).map { }), not (p(1..3)).map).
         else if str_eq p " (" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else if is_lparen p then
           let (argv, r3) = parse_call_args r2 in
           let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
           if hasbp then (ECallB (id, argv2, bp0, bb0), r3)
           else if starts_block r3 then
             let (bp, bb, r4) = parse_block r3 in (ECallB (id, argv, bp, bb), r4)
           else (ECall (id, argv), r3)
         else if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // `p [1, 2]` — p/pp take a space-bracket array argument.
         else if str_eq p " [" && (str_eq id "p" || str_eq id "pp") then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `name [items]` — indexing or call-with-array, decided at eval.
         else if str_eq p " [" then
           (let (ae, r2b) = parse_array r2 in
            // A comma after the bracket settles the ambiguity here instead:
            // `assert_equal [1], x` is a paren-less call whose first argument
            // is an array literal, never an index (an index takes no comma at
            // this level). The rest of the arguments parse as usual.
            match r2b with
            | Cons (TP cm, r2c) ->
              if str_eq cm "," then
                (let (es, r2d) = parse_puts_args (skip_nls r2c) (Cons (ae, Nil)) in
                 if starts_do_block r2d
                 then (let (bp, bb, r2e) = parse_block r2d in (ECallB (id, es, bp, bb), r2e))
                 else (ECall (id, es), r2d))
              else ambig_or_call id ae r2b
            | _ -> ambig_or_call id ae r2b)
         // a double-quoted string argument: `d "desc" do ... end`.
         else if str_eq p "(s" then
           // An interpolated string lexes as a GROUP, and a chained call on it
           // (`:"m#{t}"` becomes `(...).to_sym`) would otherwise swallow the
           // `do`: `define_method :"on_#{type}" do |node|` must give the block
           // to define_method, not to to_sym.
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if starts_block r2b then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `foo ~x` / `foo !x` — a unary-operator argument in a paren-less
         // call. Ruby has no binary `!`, and a method named `foo!` lexes as
         // one token, so a bare `!` here can only start an argument.
         else if str_eq p "~" || str_eq p "!" then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `foo ::Const` — the lexer only marks " ::" where a value can start.
         // A `do...end` after it belongs to this command, as it does for every
         // other paren-less argument shape (`refine ::Range do ... end`).
         else if str_eq p " ::" then
           (let had = map_has parser_flags "nodo" in
            let _ = map_set parser_flags "nodo" VNil in
            let (es, r2b) = parse_puts_args r Nil in
            let _ = if had then () else map_delete parser_flags "nodo" in
            if starts_block r2b then
              (let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4))
            else (ECall (id, es), r2b))
         // `foo -> { ... }` — a paren-less lambda argument (the lambda owns its
         // own block; `.call`/chains after it stay part of the argument).
         else if str_eq p "->" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else (enc_pseudo_var_at id (tok_line r), r)
       | _ ->
         if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // paren-less call arguments: `it 'desc' do ... end`, `foo :sym, 1`.
         else if starts_bare_arg r then
           // `do...end` binds to this command, not to a bare identifier
           // argument (`define_method name do..end` = define_method(name){..}),
           // so suppress do-block attachment while parsing the arguments.
           let had = map_has parser_flags "nodo" in
           let _ = map_set parser_flags "nodo" VNil in
           let (es, r2) = parse_puts_args r Nil in
           let _ = if had then () else map_delete parser_flags "nodo" in
           (if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2))
         else (enc_pseudo_var_at id (tok_line r), r))
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      // a desugared string literal: ("" + seg + ...) with a marked opener
      // so `foo "a".."b"` stays an argument, not a call's parens.
      let (e, r2) = parse_expr r in
      let r3 = expect r2 ")" in
      // adjacent string literals concatenate: "a" "b" is "ab".
      concat_adjacent_strings e r3
    else if is_lparen p then
      // () is nil; inside parens the word operators and/or (lowest
      // precedence) are usable: (a and b).
      (match r with
       | Cons (TP rp, r1) ->
         if str_eq rp ")" then (ENil, r1)
         else paren_body r
       | _ -> paren_body r)
    else if str_eq p "[" || str_eq p " [" then parse_array r
    else if str_eq p "\{" then parse_hash r
    else if str_eq p "::" || str_eq p " ::" then
      // leading ::Const — a TOP-LEVEL constant. Keep the prefix: read by bare
      // name it would find a nested constant of the same name instead, which
      // is exactly what `::Process` inside Sidekiq (which has its own
      // Process) is written to avoid.
      (match r with Cons (TId n, r2) -> (EConst ("::" ++ n), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected constant after ::" ++ parsing_file ()))) in fail ("mere-ruby: expected constant after ::" ++ parsing_file ())))
    else if str_eq p ".." || str_eq p "..." then
      // beginless range (..5)
      let (hi, r2) = parse_bin r 1 in
      (ERange (ENil, hi, str_eq p "..."), r2)
    else if str_eq p "->" then
      // -> (params) { body } / -> x { body } / -> { body } lambda literal.
      let (params, lds, r1) =
        (match r with
         | Cons (TP lp, r2) ->
           if str_eq lp "(" then let (ps, ds, r3) = parse_params r2 Nil Nil in (ps, ds, r3)
           else if str_eq lp "*" || str_eq lp "**" || str_eq lp "&" then lambda_bare_params r Nil Nil
           else (Nil, Nil, r)
         | Cons (TId n, r2) ->
           if str_eq n "do" then ((Nil : str list), (Nil : (str * Expr) list), r)
           else lambda_bare_params r Nil Nil
         | _ -> (Nil, Nil, r)) in
      // `-> () { _1 }` has an explicit (empty) parameter list, which forbids a
      // numbered parameter in the body (checked once the body is parsed).
      let empty_parens = (match params with Nil -> (match r with Cons (TP lp, _) -> str_eq lp "(" | _ -> false) | _ -> false) in
      // `-> a=a() { a }` — the default's call grabs the brace block; when no
      // block opener follows, take that block back as the lambda body.
      let (lds, r1, swallowed) =
        (match starts_block r1 with
         | true -> (lds, r1, (false, (Nil : str list), (Nil : Stmt list)))
         | false ->
           (match last_default_block lds with
            | (true, lds2, sbp, sbb) -> (lds2, r1, (true, sbp, sbb))
            | (false, _, _, _) -> (lds, r1, (false, Nil, Nil)))) in
      let (bp, bb, r4) =
        (match swallowed with
         | (true, sbp, sbb) -> (sbp, sbb, r1)
         | (false, _, _) -> parse_block r1) in
      // carry the empty-params sentinel so a numbered param in the body is
      // rejected (numbered_misuse_expr checks a non-empty ELambda param list).
      let params = if empty_parens then Cons (empty_bp_marker, Nil) else params in
      let allp = list_append_str params bp in
      // optional params (defaults) relax the strict lambda arity check via
      // a hidden anonymous splat; kw defaults keep their own binding.
      let pds = plain_defaults lds in
      let allp2 = (match pds with
                   | Nil -> allp
                   // named, so it can be told apart from a splat the source
                   // actually wrote: `->(a, b=1){}.parameters` must not report it.
                   | _ -> if psplat_any allp then allp else list_append_str allp (Cons ("*__opt", Nil))) in
      (ELambda (allp2, defaults_prologue pds bb), r4)
    else (let __fm = ("mere-ruby: unexpected token: " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let __fm = ("mere-ruby: unexpected end of input" ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)

and parse_array = fn toks0 ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (EArr Nil, r) else parse_arr_items toks Nil
  | _ -> parse_arr_items toks Nil

and parse_arr_items = fn toks -> fn (acc: Expr list) ->
  // splat element [*x] and symbol-key trailing hash [.., k: v] forms.
  match toks with
  | Cons (TP st, r0b) ->
    if str_eq st "*" then
      let (inner, r1) = parse_expr r0b in
      arr_items_sep (skip_nls r1) (Cons (ESplat inner, acc))
    // `[**h]` starts the trailing hash, exactly as `[k: v]` does: everything
    // after it is a hash item, they all merge into ONE element, and Ruby drops
    // that element entirely when the merge comes out empty.
    else if str_eq st "**" then
      let (inner, r1) = parse_expr r0b in
      arr_hash_items (skip_nls r1) acc (Cons (EKwSplat inner, Cons (EKwSplat inner, Nil))) true
    else parse_arr_expr toks acc
  | Cons (TId n, Cons (TP col, r0c)) ->
    if str_eq col ":" then
      let (v, r1) = parse_expr (skip_nls r0c) in
      arr_hash_items (skip_nls r1) acc (Cons (v, Cons (ESym n, Nil))) false
    else parse_arr_expr toks acc
  | _ -> parse_arr_expr toks acc

and arr_items_sep = fn r -> fn (acc: Expr list) ->
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `[1, 2,]` — a hanging comma before the closing bracket.
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app acc Nil), r3)
         else parse_arr_items (skip_nls r2) acc
       | _ -> parse_arr_items (skip_nls r2) acc)
    else if str_eq p "]" then (EArr (rev_app acc Nil), r2)
    else (let __fm = ("mere-ruby: expected , or ] in array, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

and parse_arr_expr = fn toks -> fn (acc: Expr list) ->
  let (e, r0) = parse_expr toks in
  let r = skip_nls r0 in   // allow a newline before the , or ]
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app (Cons (e, acc)) Nil), r3)
         else parse_arr_items (skip_nls r2) (Cons (e, acc))
       | _ -> parse_arr_items (skip_nls r2) (Cons (e, acc)))
    else if str_eq p "]" then (EArr (rev_app (Cons (e, acc)) Nil), r2)
    // trailing hash without braces: ["a", "b" => 1, "c" => 2]
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      arr_hash_items r3 acc (Cons (v, Cons (e, Nil))) false
    else (let __fm = ("mere-ruby: expected , or ] in array, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

// remaining k => v pairs of an array's trailing hash (hp is reversed v,k).
and arr_hash_items = fn toks -> fn (acc: Expr list) -> fn (hp: Expr list) -> fn (kw: bool) ->
  match toks with
  | Cons (TP p, r) ->
    // a hash built from `**` is dropped when it is empty, which is what the
    // EKwSplat wrapper says; a plain `[k: v]` hash is always an element.
    if str_eq p "]" then
      (let h = EHsh (rev_app hp Nil) in
       (EArr (rev_app acc (Cons ((if kw then EKwSplat h else h), Nil))), r))
    else if str_eq p "," then
      (match skip_nls r with
       | Cons (TId n2, Cons (TP c2, r2b)) ->
         if str_eq c2 ":" then
           let (v, r4) = parse_expr (skip_nls r2b) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (ESym n2, hp))) kw
         else
           let (k, r2) = parse_expr (skip_nls r) in
           let r3 = expect r2 "=>" in
           let (v, r4) = parse_expr (skip_nls r3) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw
       | Cons (TP dsp, r2c) ->
         if str_eq dsp "**" then
           (let (inner, r1b) = parse_expr r2c in
            arr_hash_items (skip_nls r1b) acc (Cons (EKwSplat inner, Cons (EKwSplat inner, hp))) true)
         else
           (let (k, r2) = parse_expr (skip_nls r) in
            let r3 = expect r2 "=>" in
            let (v, r4) = parse_expr (skip_nls r3) in
            arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw)
       | other ->
         let (k, r2) = parse_expr other in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))) kw)
    else (let __fm = ("mere-ruby: expected , or ] in array hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array literal" ++ parsing_file ()))

and parse_hash = fn toks ->
  // a multiline hash literal may break after `{` (and before `}`).
  let toks = skip_nls toks in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "}" then (EHsh Nil, r) else parse_hash_items toks Nil
  | _ -> parse_hash_items toks Nil

// a general hash key: `expr => v`, or `"string": v` (a symbol key).
and hash_key_expr = fn toks ->
  let (ke, r) = parse_expr toks in
  match r with
  | Cons (TP c, r2) ->
    if str_eq c ":" then (EMethod (ke, "to_sym", Nil), r2)
    else (ke, expect r "=>")
  | _ -> (ke, expect r "=>")

and parse_hash_items = fn toks -> fn (acc: Expr list) ->
  // `**h` splices another hash's pairs into this literal.
  match toks with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      let (inner, r1) = parse_expr r0 in
      hash_items_sep r1 (Cons (EKwSplat inner, Cons (EKwSplat inner, acc)))
    else parse_hash_items_kv toks acc
  | _ -> parse_hash_items_kv toks acc

and hash_items_sep = fn r3 -> fn (acc: Expr list) ->
  match skip_nls r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then (EHsh (rev_app acc Nil), r5)
         else parse_hash_items (skip_nls r4) acc
       | _ -> parse_hash_items (skip_nls r4) acc)
    else if str_eq p "}" then (EHsh (rev_app acc Nil), r4)
    else (let __fm = ("mere-ruby: expected , or } in hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated hash literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated hash literal" ++ parsing_file ()))

and parse_hash_items_kv = fn toks -> fn (acc: Expr list) ->
  // `name: value` symbol-key shorthand is equivalent to `:name => value`.
  let (k, r2) =
    (match toks with
     | Cons (TId name, Cons (TP colon, r0)) ->
       if str_eq colon ":" then (ESym name, r0)
       else hash_key_expr toks
     | _ -> hash_key_expr toks) in
  // `{a:}` / `{a:, b:}` — an omitted value reads the same-named variable.
  // The delimiter that says so, like the value itself, may be on the next
  // line, so both are decided after the newlines.
  let omitted =
    (match k with
     | ESym _ ->
       (match skip_nls r2 with
        | Cons (TP nx, _) -> str_eq nx "}" || str_eq nx ","
        | _ -> false)
     | _ -> false) in
  if omitted then
    (match k with
     | ESym nm -> hash_items_sep (skip_nls r2) (Cons (EVar nm, Cons (k, acc)))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad hash key")) in fail "mere-ruby: bad hash key"))
  else
  let (v, r3a) = parse_expr (skip_nls r2) in
  let r3 = skip_nls r3a in
  match r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      // `{a: 1, b: 2,}` — a hanging comma before the closing brace.
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then (EHsh (rev_app (Cons (v, Cons (k, acc))) Nil), r5)
         else parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc)))
       | _ -> parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc))))
    else if str_eq p "}" then (EHsh (rev_app (Cons (v, Cons (k, acc))) Nil), r4)
    else (let __fm = ("mere-ruby: expected , or } in hash, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated hash literal" ++ parsing_file ()))) in fail ("mere-ruby: unterminated hash literal" ++ parsing_file ()))

// call arguments after the opening `(` (already consumed); handles the
// empty `()` case.
and parse_call_args = fn toks0 ->
  // a newline right after `(` is allowed (multi-line argument lists).
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (Nil, r) else parse_call_items toks Nil
  | _ -> parse_call_items toks Nil

// Arguments may end with bare hash pairs — old-style `k => v` or keyword
// `name: value` — which Ruby collects into a single trailing Hash argument.
// `pos` accumulates positional args (reversed); `hp` accumulates hash pairs
// as v,k,v,k (reversed), emitted as one trailing EHsh.
and parse_call_items = fn toks -> fn (acc: Expr list) ->
  parse_call_go toks acc Nil

and parse_call_go = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TId name, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      // `m(a:, b:)` — an omitted value reads the same-named variable. The
      // delimiter that says the value was omitted may be on the NEXT line
      // (sass-embedded writes a multi-line call that way), and a value may
      // equally start there, so the decision is made after the newlines.
      (match skip_nls r0 with
       | Cons (TP nx, _) ->
         if str_eq nx "," || str_eq nx ")" then
           parse_call_sep (skip_nls r0) pos (Cons (EVar name, Cons (ESym name, hp)))
         else
           let (v, r1) = parse_expr (skip_nls r0) in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp)))
       | _ ->
         let (v, r1) = parse_expr (skip_nls r0) in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp))))
    else parse_call_pos_arg toks pos hp
  | Cons (TP star, r0) ->
    if str_eq star "*" then
      let (inner, r1) = parse_expr r0 in parse_call_sep r1 (Cons (ESplat inner, pos)) hp
    else if str_eq star "**" then
      // **hash spreads as the call's keyword hash.
      let (inner, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EKwSplat inner, pos)) hp
    else if str_eq star "..." then
      // `foo(...)` (immediately closed) forwards the collected positional
      // args; `foo(...expr)` is a beginless exclusive range argument.
      (match r0 with
       | Cons (TP q, _) ->
         if str_eq q ")" then
           parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), Cons (ESplat (EVar "__fwd"), pos))) hp
         else let (hi, r1) = parse_expr r0 in
              parse_call_sep r1 (Cons (ERange (ENil, hi, true), pos)) hp
       | _ ->
         let (hi, r1) = parse_expr r0 in
         parse_call_sep r1 (Cons (ERange (ENil, hi, true), pos)) hp)
    else if str_eq star "&" then
      // block-pass `&:sym` / `&expr`; bare `&` forwards the anonymous block.
      (match r0 with
       | Cons (TP nx, _) ->
         if str_eq nx ")" || str_eq nx "," then
           parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), pos)) hp
         else let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp
       | _ -> let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp)
    else parse_call_pos_arg toks pos hp
  | _ -> parse_call_pos_arg toks pos hp

and parse_call_pos_arg = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in parse_call_sep r3 pos (Cons (v, Cons (e, hp)))
    else parse_call_sep r (Cons (e, pos)) hp
  | _ -> parse_call_sep r (Cons (e, pos)) hp

and parse_call_sep = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match skip_nls toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `f(1,)` — a vestigial trailing comma before the close paren.
      (match skip_nls r with
       | Cons (TP rp, r2) ->
         if str_eq rp ")" then (finish_call_args pos hp, r2) else parse_call_go (skip_nls r) pos hp
       | _ -> parse_call_go (skip_nls r) pos hp)
    else if str_eq p ")" then (finish_call_args pos hp, r)
    else (let __fm = ("mere-ruby: expected , or ) in argument list, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated argument list" ++ parsing_file ()))) in fail ("mere-ruby: unterminated argument list" ++ parsing_file ()))

and finish_call_args = fn (pos: Expr list) -> fn (hp: Expr list) ->
  match hp with
  | Nil -> rev_app pos Nil
  | _ ->
    // `f(a: 1, **h)` -- a keyword splat belongs to the SAME keyword hash as
    // the explicit pairs, not to the positional list, or the callee sees two
    // arguments. Lift it out and splice it (doubled: the marker
    // hsh_eval_items uses), after the pairs so a later splat wins.
    // A block-pass has to stay LAST: the callee finds it by looking at the end
    // of the argument list, and the keyword hash is appended after the
    // positionals. `g(*a, k: k, &blk)` otherwise left `&blk` in the middle,
    // where it was evaluated as an ordinary argument (a stray nil).
    let ps0 = rev_app pos Nil in
    let ps = drop_blockpass ps0 in
    eapp (drop_kwsplats ps)
         (Cons (EKwHash (eapp (rev_app hp Nil) (kwsplats_doubled ps)), only_blockpass ps0))

// the block-pass argument (at most one), and the list without it.
and only_blockpass = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (EBlockPass b, t) -> Cons (EBlockPass b, only_blockpass t)
  | Cons (_, t) -> only_blockpass t
and drop_blockpass = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (EBlockPass _, t) -> drop_blockpass t
  | Cons (h, t) -> Cons (h, drop_blockpass t)

and drop_kwsplats = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with EKwSplat _ -> drop_kwsplats t | _ -> Cons (h, drop_kwsplats t))
and kwsplats_doubled = fn (xs: Expr list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with EKwSplat e -> Cons (EKwSplat e, Cons (EKwSplat e, kwsplats_doubled t)) | _ -> kwsplats_doubled t)

// ---- statements — SAME mutual-recursion group as the expression parser,
// because a block body (`{ ... }` / `do ... end`) parses statements while
// parse_postfix parses the block. ----------------------------------------
and parse_puts_args = fn toks -> fn (acc: Expr list) ->
  // trailing keyword-hash arguments in a paren-less call (`d :s, shared: true`)
  // collect into one Hash argument, like the parenthesized form.
  match toks with
  | Cons (TId kname, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      let (hp, r) = parse_bare_kw_pairs r0 kname Nil in
      (rev_app (Cons (EKwHash hp, acc)) Nil, r)
    else parse_puts_args_pos toks acc
  | Cons (TP st, r0) ->
    // A no-space `(` right after the command word is a real argument list:
    // `raise(E, "m")` / `puts(x, y)`. Parse it like any method call so a comma
    // separates arguments (parse_expr would instead read `(a, b)` as a grouped
    // expression and choke on the comma). A space-paren (" (") is left to the
    // positional path, so `p (1..3).to_a` still groups-then-chains.
    // ...only at the FIRST argument, though: after a comma we are already
    // inside the list, so `p 1, (2).abs` is a grouped expression to chain
    // from, not a second argument list.
    if str_eq st "(" && (match acc with Nil -> true | _ -> false) then
      let (a, r1) = parse_call_args r0 in (rev_app acc a, r1)
    // a keyword splat in a paren-less call: `mkdir_p subdir, **options`.
    else if str_eq st "**" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (EKwSplat inner, acc))
         else (rev_app (Cons (EKwSplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (EKwSplat inner, acc)) Nil, r1))
    // splat / block-pass arguments in a paren-less call: `send :m=, *x, 1`.
    else if str_eq st "*" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (ESplat inner, acc))
         else (rev_app (Cons (ESplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (ESplat inner, acc)) Nil, r1))
    else if str_eq st "&" then
      let (inner, r1) = parse_expr r0 in
      (rev_app (Cons (EBlockPass inner, acc)) Nil, r1)
    else parse_puts_args_pos toks acc
  | _ -> parse_puts_args_pos toks acc

and parse_bare_rockets = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then
      (match skip_nls r with
       | Cons (TNL _, _) -> (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)
       | rr ->
         let (k, r2) = parse_expr rr in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         parse_bare_rockets r4 pos (Cons (v, Cons (k, hp))))
    else (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)
  | _ -> (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)

and parse_bare_kw_pairs = fn toks -> fn (kname: str) -> fn (acc: Expr list) ->
  let (v, r) = parse_expr toks in
  let acc2 = Cons (v, Cons (ESym kname, acc)) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TId k2, Cons (TP colon2, r3)) ->
         if str_eq colon2 ":" then parse_bare_kw_pairs r3 k2 acc2
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected keyword argument" ++ parsing_file ()))) in fail ("mere-ruby: expected keyword argument" ++ parsing_file ()))
       // `m f, filename: filename, **kwargs` -- the splat joins these pairs
       // (doubled, the marker hsh_eval_items uses), it is not a new argument.
       | Cons (TP dsp, r3) ->
         if str_eq dsp "**" then
           (let (inner, r4) = parse_expr r3 in
            let acc3 = Cons (EKwSplat inner, Cons (EKwSplat inner, acc2)) in
            match r4 with
            | Cons (TP c3, r5) ->
              if str_eq c3 "," then
                (match skip_nls r5 with
                 | Cons (TId k3, Cons (TP colon3, r6)) ->
                   if str_eq colon3 ":" then parse_bare_kw_pairs r6 k3 acc3
                   else (rev_app acc3 Nil, r4)
                 | _ -> (rev_app acc3 Nil, r4))
              else (rev_app acc3 Nil, r4)
            | _ -> (rev_app acc3 Nil, r4))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected keyword argument" ++ parsing_file ()))) in fail ("mere-ruby: expected keyword argument" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected keyword argument" ++ parsing_file ()))) in fail ("mere-ruby: expected keyword argument" ++ parsing_file ())))
    else (rev_app acc2 Nil, r)
  | _ -> (rev_app acc2 Nil, r)

and parse_puts_args_pos = fn toks -> fn (acc: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_puts_args (skip_nls r2) (Cons (e, acc))
    // trailing `k => v` pairs collect into one Hash argument.
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      parse_bare_rockets r3 acc (Cons (v, Cons (e, Nil)))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// parse statements until a block-closing keyword (end / else / elsif /
// when) or EOF; the closer is left unconsumed for the caller.
and parse_stmts = fn toks -> fn (acc: Stmt list) ->
  let (t, skipped) = skip_nls_n toks 0 in
  let _ = parse_line_add skipped in
  match t with
  | Cons (TEOF, _) -> (rev_app acc Nil, t)
  | Cons (TId id, _) ->
    if is_block_stop id then (rev_app acc Nil, t)
    else
      let ln = tok_line t in
      let acc = (match acc with
                 | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
                 | _ -> acc) in
      let (s0, r0) = parse_stmt t in
      let (s0, r0) = grow_setter_stmt s0 r0 in
      let (s, r) = apply_modifier s0 r0 in
      parse_stmts (expect_end r) (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))
  | _ ->
    let ln = tok_line t in
    let acc = (match acc with
               | Nil -> (let f = parse_time_file () in if str_eq f "" then acc else Cons (SFile f, acc))
               | _ -> acc) in
    let (s0, r0) = parse_stmt t in
    let (s0, r0) = grow_setter_stmt s0 r0 in
    let (s, r) = apply_modifier s0 r0 in
    parse_stmts (expect_end r) (Cons (s, (if ln > 0 then Cons (SLine ln, acc) else acc)))

// trailing statement modifiers: `STMT if C`, `unless C`, `while C`,
// `until C`. Each desugars to the corresponding block form wrapping the
// single statement.
and apply_modifier = fn (s: Stmt) -> fn toks ->
  match toks with
  // one-line pattern matching at statement level: `expr => pat` (bind-or-raise)
  // and `expr in pat` (boolean). Only a plain expression statement qualifies.
  | Cons (TP arrow, r) ->
    if str_eq arrow "=>" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchBind (e, pat))) r2
       | _ -> (s, toks))
    else (s, toks)
  | Cons (TId id, r) ->
    if str_eq id "in" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchTest (e, pat))) r2
       | _ -> (s, toks))
    else if str_eq id "if" then
      let (c0, r2) = parse_andor (skip_nls r) in
      let c = cond_ff c0 in
      apply_modifier (SIf (Cons ((c, Cons (s, Nil)), Nil), decl_of s)) r2
    else if str_eq id "unless" then
      let (c0, r2) = parse_andor (skip_nls r) in
      let c = cond_ff c0 in
      apply_modifier (SIf (Cons ((EUn ("!", c), Cons (s, Nil)), Nil), decl_of s)) r2
    else if str_eq id "while" then
      let (c, r2) = parse_andor (skip_nls r) in
      // `begin ... end while cond` is do-while: run the body once, then loop.
      (match s with
       | SBegin (_, _, _, _) -> (SDoWhile (s, c), r2)
       | _ -> (SWhile (c, Cons (s, Nil)), r2))
    else if str_eq id "until" then
      let (c, r2) = parse_andor (skip_nls r) in
      (match s with
       | SBegin (_, _, _, _) -> (SDoWhile (s, EUn ("!", c)), r2)
       | _ -> (SWhile (EUn ("!", c), Cons (s, Nil)), r2))
    else if str_eq id "rescue" then
      // `expr rescue fallback` — a one-line begin/rescue.
      let (h, r2) = parse_stmt (skip_nls r) in
      // rescue binds tighter than `=`: `a = b rescue c` is `a = (b rescue c)`,
      // so the assignment still happens with the fallback value. (Op-assigns
      // like `+=` keep the whole-statement sense.)
      // a modifier may follow: `a rescue nil if c` is `(a rescue nil) if c`.
      (match s with
       | SAssign (n, rhs) ->
         apply_modifier (SAssign (n, EStmt (SBegin (Cons (SExpr rhs, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)))) r2
       | _ -> apply_modifier (SBegin (Cons (s, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)) r2)
    else if str_eq id "and" || str_eq id "or" then
      // lowest-precedence: `x = 1 and y = 2` runs the second statement
      // only when the first one's value is truthy. After break/next/
      // return the left side has no value — a SyntaxError in Ruby.
      let _ = (match s with
               | SBreak _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | SNext _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | SReturn _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: void value expression")) in fail "mere-ruby: void value expression")
               | _ -> ()) in
      let (s2, r2) = parse_stmt (skip_nls r) in
      apply_modifier (if str_eq id "and" then SAndThen (s, s2) else SOrElse (s, s2)) r2
    else (s, toks)
  | _ -> (s, toks)

// `if ... end.method` — a control construct used as an expression with a
// trailing method chain (common in specs: `unless x ... end.should == y`).
and stmt_postfix = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP dot, _) ->
    if str_eq dot "." then
      let (e0, r1) = parse_postfix_more (EStmt s) toks in
      let (e, r2) = parse_more e0 r1 1 in
      (SExpr e, r2)
    // `case ... end + ...` — a binary operator continues the expression.
    else if prec_of dot > 0 then
      let (e, r2) = parse_more (EStmt s) toks 1 in (SExpr e, r2)
    else (s, toks)
  | _ -> (s, toks)

// Ruby defines the local targets of an assignment at parse time, so a
// modifier-guarded assignment that never runs still leaves nil locals.
// The skipped branch declares them (only if not already bound).
// the plain-local names among complex assignment targets (for nil-declare).
and x_target_names = fn (ts: Expr list) ->
  match ts with
  | Nil -> Nil
  | Cons (t, r) ->
    (match t with
     | EVar n ->
       if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then x_target_names r
       else Cons (n, x_target_names r)
     | ESplat inner ->
       (match inner with
        | EVar n -> Cons (n, x_target_names r)
        | _ -> x_target_names r)
     | EArr inner -> list_append_str (x_target_names inner) (x_target_names r)
     | _ -> x_target_names r)

and decl_of = fn (s: Stmt) ->
  match s with
  | SAssign (n, _) ->
    if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then Nil
    else Cons (SDeclare (Cons (n, Nil)), Nil)
  | SMultiAssign (ts, _) -> Cons (SDeclare ts, Nil)
  | SMultiAssignX (ts, _) -> Cons (SDeclare (x_target_names ts), Nil)
  | _ -> Nil

// a statement that begins `id ,` (a bare non-keyword identifier then a
// comma) or `* id` is a multiple assignment target list.
and looks_like_multi = fn toks ->
  match toks with
  | Cons (TId nm, Cons (TP c, _)) -> (if is_keyword nm then false else str_eq c ",")
  | Cons (TP star, Cons (TId _, _)) -> str_eq star "*"
  | _ -> false

// `undef a, b, :c` — a comma-separated list of bare/:symbol method names.
and parse_undef_names = fn toks -> fn (acc: str list) ->
  let (n, r) = parse_alias_name toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_undef_names (skip_nls r2) (Cons (n, acc)) else (rev_app (Cons (n, acc)) Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, r)

// an alias name is a bare identifier or a :symbol.
// fold a constant string/symbol interpolation expression to its text, for
// dynamic alias/undef names like alias :"#{'m3'}" m1.
and const_fold_str = fn (e: Expr) ->
  match e with
  | EStrL s -> s
  | ESym s -> s
  | EInt n -> str_of_int n
  | EBig s -> s
  | EBool b -> if b then "true" else "false"
  | ENil -> ""
  | EBin (o, a, b) -> if str_eq o "+" then const_fold_str a ++ const_fold_str b else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")
  // `__interp_str` is what an interpolation desugars to (v0.1-era it was
  // `to_s`); an alias name built from one has to fold the same way.
  | EMethod (rc, m, _) -> if str_eq m "to_s" || str_eq m "to_sym" || str_eq m "to_str" || str_eq m "__interp_str" then const_fold_str rc else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: cannot constant-fold alias name")) in fail "mere-ruby: cannot constant-fold alias name")

and parse_alias_name = fn toks ->
  match toks with
  // `alias expires_at= expires=` — a setter's name carries its `=`.
  | Cons (TId n, Cons (TP eq, r)) -> if str_eq eq "=" then (n ++ "=", r) else (n, Cons (TP eq, r))
  | Cons (TId n, r) -> (n, r)
  | Cons (TSym n, r) -> (n, r)
  | Cons (TP op, r) ->
    // the lexer marks a space-before punctuator (" &", " (", " [") so a
    // paren-less call can be told from an operator; in `alias intersection &`
    // the marker is noise and the name is the bare operator.
    let op = (if str_len op > 1 && str_eq (char_at op 0) " " then substring op 1 (str_len op) else op) in
    // an interpolated symbol :"#{...}" lexes as ("" + ...).to_sym; fold it.
    if str_eq op "(s" then
      (let (e, r2) = parse_primary toks in
       let folded = const_fold_str e in
       let r3 = (match r2 with Cons (TP dot, Cons (TId ts, r4)) -> if str_eq dot "." && (str_eq ts "to_sym" || str_eq ts "to_s") then r4 else r2 | _ -> r2) in
       (folded, r3))
    else if is_op_method_name op then (op, r)
    else if str_eq op "[" then
      (match r with
       | Cons (TP rb2, r2) ->
         if str_eq rb2 "]" then
           (match r2 with
            | Cons (TP eq2, r3) -> if str_eq eq2 "=" then ("[]=", r3) else ("[]", r2)
            | _ -> ("[]", r2))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a name in alias" ++ parsing_file ()))) in fail ("mere-ruby: expected a name in alias" ++ parsing_file ()))

// consume optional `, Name, Name` after `include M` (ignored).
and maybe_more_names = fn toks ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then (match r with Cons (TId _, r2) -> maybe_more_names r2 | _ -> (0, toks))
    else (0, toks)
  | _ -> (0, toks)

// extend a constant name with any trailing `::Name` scope segments.
// split a qualified constant name at its FIRST "::" ("A::B::C" -> "A", "B::C").
and dcolon_at = fn (n: str) -> fn (i: int) ->
  if i + 1 >= str_len n then str_len n
  else if str_eq (char_at n i) ":" && str_eq (char_at n (i + 1)) ":" then i
  else dcolon_at n (i + 1)
and const_head = fn (n: str) -> substring n 0 (dcolon_at n 0)
and const_tail = fn (n: str) ->
  let i = dcolon_at n 0 in
  if i + 2 >= str_len n then "" else substring n (i + 2) (str_len n)

and scoped_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, Cons (TId n, r)) -> if str_eq p "::" then scoped_name (acc ++ "::" ++ n) r else (acc, toks)
  | _ -> (acc, toks)

// extend `A::B` through further ::Name segments; returns (full, rest).
and scoped_const_path = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TId n, r) ->
    if is_cap n then
      (match r with
       | Cons (TP sc, r2) ->
         if str_eq sc "::" then scoped_const_path (acc ++ "::" ++ n) r2
         else (acc ++ "::" ++ n, r)
       | _ -> (acc ++ "::" ++ n, r))
    else (acc, toks)
  | _ -> (acc, toks)

and parse_multi = fn toks ->
  let (targets, r) = parse_target_list toks Nil in   // consumes through `=`
  let (rhs, r2) = parse_rhs_list (skip_nls r) Nil in
  (SMultiAssign (targets, rhs), r2)

// multiple assignment whose targets include indexing / attribute writes
// (`foo[0], bar.baz = a, b`). Targets parse as postfix chains; the writer
// invokes m= / []= at assignment time.
// replace the last argument v with [v, more...] (multi-value []= RHS).
// `a[i] = 1, 2` and `o.x = 1, 2` assign the ARRAY: the values after the comma
// grow the setter's last argument. The parenthesised form `(a[i] = 1, 2)`
// already did this; a bare statement did not, and stopped at the comma.
and grow_setter_stmt = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP c, r1) when str_eq c "," ->
    (match s with
     | SExpr (EMethod (recv, mn, margs)) ->
       (if str_eq mn "[]=" || (str_len mn > 1 && str_eq (char_at mn (str_len mn - 1)) "="
                               && (if str_eq mn "==" then false else true)) then
          (let (more, r2) = parse_rhs_list (skip_nls r1) Nil in
           (SExpr (EMethod (recv, mn, grow_last_arg margs more)), r2))
        else (s, toks))
     | _ -> (s, toks))
  | _ -> (s, toks)

and grow_last_arg = fn (args: Expr list) -> fn (more: Expr list) ->
  match args with
  | Nil -> Cons (EArr more, Nil)
  | Cons (v, Nil) -> Cons (EArr (Cons (v, more)), Nil)
  | Cons (h, t) -> Cons (h, grow_last_arg t more)

and parse_multix = fn toks ->
  let (targets, r) = parse_x_targets toks Nil in
  let (rhs, r2) = parse_rhs_list (skip_nls r) Nil in
  (SMultiAssignX (targets, rhs), r2)

and parse_x_targets = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         // `* = 1` — an anonymous splat consumes (and discards) values.
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx "=" || str_eq nx "," then (ESplat ENil, r0)
            else let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1)
          | _ -> let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `a, = 1` — a trailing comma ends the target list. The list may also
      // wrap after the comma (`a, b,\n  c = rhs`).
      (match skip_nls r2 with
       | Cons (TP eq2, r3) ->
         if str_eq eq2 "=" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_targets (skip_nls r2) (Cons (t, acc))
       | _ -> parse_x_targets (skip_nls r2) (Cons (t, acc)))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or = in multiple assignment, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))) in fail ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))

// one assignment target: a name (local/@ivar/$global) followed by .attr /
// [index] chains. Unlike parse_postfix this never consumes `= rhs`.
and parse_x_target1 = fn toks ->
  match toks with
  | Cons (TId nm, r) ->
    if is_ivar nm then parse_x_chain (EIVar (substring nm 1 (str_len nm))) r
    else parse_x_chain (EVar nm) r
  // a parenthesized group destructures one value: ((a, b), c) = ...
  | Cons (TP lp, r) ->
    if str_eq lp "(" then let (ts, r2) = parse_x_group r Nil in (EArr ts, r2)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

and parse_x_group = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx ")" || str_eq nx "," then (ESplat ENil, r0)
            else let (i, r1) = parse_x_target1 r0 in (ESplat i, r1)
          | _ -> let (i, r1) = parse_x_target1 r0 in (ESplat i, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match r2 with
       // `(e,)` — a trailing comma inside the group
       | Cons (TP rp, r3) ->
         if str_eq rp ")" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_group r2 (Cons (t, acc))
       | _ -> parse_x_group r2 (Cons (t, acc)))
    else if str_eq p ")" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or ) in grouped target, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated grouped target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated grouped target" ++ parsing_file ()))

and parse_x_chain = fn (recv: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (EMethod (recv, m, Nil)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else if str_eq p "[" then
      let (idxs, r2) = parse_x_idx r Nil in
      parse_x_chain (EMethod (recv, "[]", idxs)) r2
    else if str_eq p "&." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (ESafe (recv, m, Nil)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else if str_eq p "::" then
      (match r with
       | Cons (TId cn, r2) ->
         let recv2 = (match recv with EVar n -> (if is_upper_first n then EConst n else recv) | _ -> recv) in
         parse_x_chain (EScopedRead (recv2, cn)) r2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target"))
    else (recv, toks)
  | _ -> (recv, toks)

and parse_x_idx = fn toks -> fn (acc: Expr list) ->
  // an index may be written across lines -- `new_site[\n  /re/, 1\n]`
  // (addressable) -- so newlines are skipped where a paren-less argument list
  // would skip them: before an index, and after each comma.
  let toks = skip_nls toks in
  // `recv[k: v, ...]` — labels are one trailing Hash argument, the same as
  // `recv[k => v]`, and `Hash[a: 1]` is how ruby's own specs write it.
  match toks with
  | Cons (TId lbl, Cons (TP lc, lr)) when str_eq lc ":" ->
    (let (v, r1) = parse_expr (skip_nls lr) in
     let (pairs, r2) = parse_x_idx_pairs r1 (Cons (v, Cons (ESym lbl, Nil))) in
     (rev_app (Cons (EHsh (rev_app pairs Nil), acc)) Nil, r2))
  | _ ->
  let (e, r) =
    (match toks with
     | Cons (TP st, r0) ->
       if str_eq st "*" then let (i, r1) = parse_expr r0 in (ESplat i, r1)
       // `recv[&blk]` — a block-pass index argument (recv.[](&blk)).
       else if str_eq st "&" || str_eq st " &" then let (i, r1) = parse_expr r0 in (EBlockPass i, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match skip_nls r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_x_idx r2 (Cons (e, acc))
    else if str_eq p "]" then (rev_app (Cons (e, acc)) Nil, r2)
    // `recv[k => v, ...]` — the pairs form a single trailing Hash argument
    // (this is how Hash[1 => 2] and obj[k => v] are written).
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      let (pairs, r4) = parse_x_idx_pairs r3 (Cons (v, Cons (e, Nil))) in
      (rev_app (Cons (EHsh (rev_app pairs Nil), acc)) Nil, r4)
    else (let __fm = ("mere-ruby: expected , or ] in index target, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated index target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated index target" ++ parsing_file ()))

and parse_x_idx_pairs = fn toks -> fn (acc: Expr list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (acc, r)
    else if str_eq p "," then
      (match skip_nls r with
       | Cons (TId lbl2, Cons (TP lc2, lr2)) when str_eq lc2 ":" ->
         (let (v, r4) = parse_expr (skip_nls lr2) in
          parse_x_idx_pairs r4 (Cons (v, Cons (ESym lbl2, acc))))
       | _ ->
      let (k, r2) = parse_expr r in
      (match r2 with
       | Cons (TP a, r3) -> if str_eq a "=>" then (let (v, r4) = parse_expr r3 in parse_x_idx_pairs r4 (Cons (v, Cons (k, acc)))) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected => in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected => in index hash" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected => in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected => in index hash" ++ parsing_file ()))))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or ] in index hash" ++ parsing_file ()))) in fail ("mere-ruby: expected , or ] in index hash" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated index hash" ++ parsing_file ()))) in fail ("mere-ruby: unterminated index hash" ++ parsing_file ()))

// does this statement look like a complex multiple assignment? Scan to a
// top-level `=` requiring a top-level `,` first; two adjacent value tokens
// (a paren-less command call) or a structural keyword call it off.
and looks_like_multix = fn toks ->
  match toks with
  // `self.a, self.b = ...` — self is a keyword, but here it is the receiver of
  // an attribute writer, which is a perfectly ordinary assignment target.
  | Cons (TId nm, r0) ->
    if str_eq nm "self" then (match r0 with Cons (TP d, _) -> str_eq d "." && scan_mx toks 0 false false | _ -> false)
    else if is_keyword nm then false else scan_mx toks 0 false false
  // a leading group: a comma or splat at depth 1 marks targets too ((*a) = ...)
  | Cons (TP lp, r) ->
    if str_eq lp "(" then scan_mx toks 0 false true
    // a leading splat is itself a target (* = 1, *a = ...), if an = follows.
    else if str_eq lp "*" then scan_mx r 0 true false
    else false
  | _ -> false

and scan_mx = fn toks -> fn (depth: int) -> fn (seen: bool) -> fn (grp: bool) ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) ->
    if str_eq w "do" || str_eq w "then" || str_eq w "if" || str_eq w "unless" ||
       str_eq w "while" || str_eq w "until" || str_eq w "and" || str_eq w "or" ||
       str_eq w "rescue" then false
    else
      (match r with
       | Cons (TId _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TInt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TFlt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TStrL _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TSym _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | _ -> scan_mx r depth seen grp)
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      scan_mx r (depth + 1) seen grp
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then scan_mx r (depth - 1) seen grp
    // a target list may wrap right after a comma (`a, b,\n  c = rhs`)
    else if depth == 0 && str_eq p "," then scan_mx (skip_nls r) depth true grp
    else if grp && depth == 1 && (str_eq p "," || str_eq p "*") then scan_mx r depth true grp
    else if depth == 0 && str_eq p "=" then seen
    else if depth == 0 && str_eq p "?" then false
    else if depth == 0 && (if str_eq (opassign_base p) "" then false else true) then false
    else scan_mx r depth seen grp
  | Cons (_, r) -> scan_mx r depth seen grp

and parse_target_list = fn toks -> fn (acc: str list) ->
  let (t, r) = parse_one_target toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_target_list r2 (Cons (t, acc))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else (let __fm = ("mere-ruby: expected , or = in multiple assignment, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))) in fail ("mere-ruby: unterminated multiple-assignment targets" ++ parsing_file ()))

and parse_one_target = fn toks ->
  match toks with
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with Cons (TId nm, r2) -> ("*" ++ nm, r2) | _ -> ("*", r))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")
  | Cons (TId nm, r) -> (nm, r)   // plain local, or @ivar (@ kept in the name)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad assignment target")) in fail "mere-ruby: bad assignment target")

// the RHS of `a = ...`: one value, or a comma list / splat that builds an
// array (`a = 1, 2` and `a = *nil`).
// `x = case/if/begin ... end` — but a trailing binary operator turns the
// construct into an operand of a larger expression (case..end + case..end).
and construct_assign = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  match r4 with
  | Cons (TP op, _) ->
    // `x = if ... end.method` — the construct is the receiver of a chain, the
    // same way `if ... end.method` reads as a statement.
    if str_eq op "." || str_eq op "&." || str_eq op "[" then
      (let (e0, r5) = parse_postfix_more (EStmt sb) r4 in
       let (e, r6) = parse_more e0 r5 1 in (SAssign (id, e), r6))
    else if prec_of op > 0 then
      let (e, r5) = parse_more (EStmt sb) r4 1 in (SAssign (id, e), r5)
    else construct_target id sb r4
  | _ -> construct_target id sb r4

// `NAME = case/if/begin ... end`: a CONSTANT target has to reach the consts
// table (concurrent-ruby picks its map backend with `X = case ... end`), so
// the construct becomes the right-hand side of an ordinary assignment. A
// lowercase target keeps the local-binding path.
and construct_target = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  if is_cap id then (SAssign (id, EStmt sb), r4) else (SLocalFrom (id, sb), r4)

and sassign_rhs = fn (id: str) -> fn toks ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (single, Nil) ->
     (match single with
      | ESplat _ -> (SAssign (id, EArr es), r)
      | _ -> (SAssign (id, single), r))
   | _ -> (SAssign (id, EArr es), r))

// `break 1, 2` / `next a, b` — several values build an array.
and flow_values = fn toks -> fn (mk: Expr -> Stmt) ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (e, Nil) -> (match e with ESplat _ -> (mk (EArr es), r) | _ -> (mk e, r))
   | _ -> (mk (EArr es), r))

and parse_rhs_list = fn toks -> fn (acc: Expr list) ->
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    // a newline after the comma continues the list, as ruby's does
    // (`private_constant :A,\n                  :B`).
    if str_eq p "," then parse_rhs_list (skip_nls r2) (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// the read side of a constant op-assign: `||=` treats an undefined constant as
// nil (then assigns); every other op reads it first (NameError if undefined).
and opasgn_const_read = fn (base: str) -> fn (full: str) ->
  if str_eq base "||" then EConstOrNil full else EConst full

and parse_stmt = fn toks ->
  if looks_like_multix toks then parse_multix toks
  else if looks_like_multi toks then parse_multi toks else
  match toks with
  // scoped constant assignment: `A::C = e` / `A::B::C = e` / `::C = e`.
  | Cons (TId a, Cons (TP sc, Cons (TId cn, Cons (TP eq, r)))) ->
    if str_eq sc "::" && (if is_cap a then false else true) && is_cap cn && str_eq eq "=" then
      // `recv::Const = value` with a lowercase (runtime) receiver.
      let (e, r2) = parse_expr r in (SExpr (EScopedAssign (EVar a, cn, e)), r2)
    else if str_eq sc "::" && is_cap a && is_cap cn then
      (if str_eq eq "=" then
         let (e, r2) = parse_expr (skip_nls r) in (SAssign (a ++ "::" ++ cn, e), r2)
       else if not (str_eq (opassign_base eq) "") then
         // `A::C op= e` -> `A::C = A::C op e`. `||=` reads undefined as nil;
         // other ops read first, so an undefined constant raises NameError.
         let full = a ++ "::" ++ cn in
         let (e, r2) = parse_expr (skip_nls r) in
         (SAssign (full, EBin (opassign_base eq, opasgn_const_read (opassign_base eq) full, e)), r2)
       else if str_eq eq "::" then
         (match scoped_const_path (a ++ "::" ++ cn) r with
          | (full, r2b) ->
            (match r2b with
             | Cons (TP eq2, r3) ->
               if str_eq eq2 "=" then let (e, r4) = parse_expr (skip_nls r3) in (SAssign (full, e), r4)
               // `A::B::C op= e` -> `A::B::C = A::B::C op e` (nil read when undefined).
               else if not (str_eq (opassign_base eq2) "") then
                 let (e, r4) = parse_expr (skip_nls r3) in
                 (SAssign (full, EBin (opassign_base eq2, opasgn_const_read (opassign_base eq2) full, e)), r4)
               else parse_stmt_id toks
             | _ -> parse_stmt_id toks))
       else parse_stmt_id toks)
    else parse_stmt_id toks
  | Cons (TP sc, Cons (TId cn, Cons (TP eq, r))) ->
    if str_eq sc "::" && str_eq eq "=" && is_cap cn then
      // `::Const = v` assigns a TOP-LEVEL constant; keep the :: so a class
      // body doesn't treat it as a class-local constant.
      let (e, r2) = parse_expr (skip_nls r) in (SAssign ("::" ++ cn, e), r2)
    else if str_eq sc "::" && is_cap cn && (if str_eq (opassign_base eq) "" then false else true) then
      // `::Const op= e` -> `::Const = ::Const op e`. The write target keeps the
      // `::` (stored top-level as the bare name), so the read uses the bare name.
      let (e, r2) = parse_expr (skip_nls r) in
      (SAssign ("::" ++ cn, EBin (opassign_base eq, opasgn_const_read (opassign_base eq) cn, e)), r2)
    else let (e, r2) = parse_expr toks in (SExpr e, r2)
  | Cons (TId id, r) -> parse_stmt_id toks
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

and parse_stmt_id = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    // A command word is a command only when it is not being ASSIGNED. `require`,
    // `puts`, `include`, `private` are ordinary method names, so they are
    // ordinary local names too, and real code uses them as such (rubocop writes
    // `require = injectable_require_directive.chomp`). Ruby's own keywords are
    // excluded: those cannot be assigned at all, so `if = 1` stays an error.
    // (an @ivar / @@cvar is an assignment too, but it has its own branch below,
    // and routing it here would silently make it a local -- which is a local
    // that nothing else ever reads.)
    if (not (is_keyword id)) && (not (is_ivar id))
       && (match r with
           | Cons (TP eq, _) -> str_eq eq "=" || not (str_eq (opassign_base eq) "")
           | _ -> false) then parse_stmt_ident toks id r
    // BEGIN { ... } / END { ... } — run the block body (BEGIN at load time).
    else if (str_eq id "BEGIN" || str_eq id "END") &&
       (match r with Cons (TP br, _) -> str_eq br "\{" | _ -> false) then
      (match r with
       | Cons (TP br, r2) ->
         let (body, r3) = parse_brace_stmts r2 Nil in
         (if str_eq id "BEGIN" then SPreexe body
          else (let n = end_site_next () in SAtExit (n, body)), r3)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected block after BEGIN" ++ parsing_file ()))) in fail ("mere-ruby: expected block after BEGIN" ++ parsing_file ())))
    else if str_eq id "puts" &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      (match r with
       | Cons (TNL _, _) -> (SPuts Nil, r)
       | Cons (TEOF, _) -> (SPuts Nil, r)
       // `puts if c` / `puts unless c`: a statement modifier, not an argument.
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" ||
            str_eq w "until" || str_eq w "rescue" then (SPuts Nil, r)
         else (let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
       | _ -> let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
    else if str_eq id "if" then let (s, r2) = parse_if r false in stmt_postfix s r2
    else if str_eq id "unless" then let (s, r2) = parse_if r true in stmt_postfix s r2
    else if str_eq id "while" then let (s, r2) = parse_while r false in stmt_postfix s r2
    else if str_eq id "until" then let (s, r2) = parse_while r true in stmt_postfix s r2
    else if str_eq id "case" then let (s, r2) = parse_case r in stmt_postfix s r2
    else if str_eq id "for" then let (s, r2) = parse_for r in stmt_postfix s r2
    else if str_eq id "def" then let (s, r2) = parse_def r in stmt_postfix s r2
    else if str_eq id "class" then let (s, r2) = parse_class r in stmt_postfix s r2
    else if str_eq id "module" then let (s, r2) = parse_class r in stmt_postfix (mark_module s) r2
    else if str_eq id "begin" then let (s, r2) = parse_begin r in stmt_postfix s r2
    // `attr_accessor :a, :b` names the attributes statically, but these are
    // methods: `attr_writer name` passes a variable. A non-symbol argument
    // makes it an ordinary call.
    // ...and a bare mention with no argument at all is not a declaration either:
    // `attr_accessor` is an ordinary name, and rubocop keeps a local called
    // exactly that (`attr_accessor = "attr_accessor #{names}"`). So this reads
    // as an attribute declaration only when something that can BE an attribute
    // name follows; anything else falls through to the ordinary identifier path.
    else if (str_eq id "attr_accessor" || str_eq id "attr_reader" || str_eq id "attr_writer")
            && (match r with
                | Cons (TSym _, _) -> true
                | Cons (TStrL _, _) -> true
                | Cons (TId _, _) -> true
                | Cons (TP st, _) -> str_eq st "*" || str_eq st "("
                | _ -> false) then
      (let mode = (if str_eq id "attr_accessor" then "rw" else if str_eq id "attr_reader" then "r" else "w") in
       match r with
       | Cons (TSym _, _) -> parse_attr mode r
       | _ -> let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall (id, es))) r2)
    // `attr :sym` (and `attr :a, :b`) is the classic reader-only form.
    else if str_eq id "attr" && (match r with Cons (TSym _, _) -> true | _ -> false) then parse_attr "r" r
    else if str_eq id "alias" then
      // `alias new old` — names may be bare or :symbols.
      let (n1, r1) = parse_alias_name r in
      let (n2, r2) = parse_alias_name r1 in (SAlias (n1, n2), r2)
    else if str_eq id "undef" then
      let (names, r2) = parse_undef_names r Nil in apply_modifier (SUndef names) r2
    // `undef_method :a, :b` names methods statically, but it is a method, not
    // a keyword: `undef_method(name) if defined?` passes a variable and takes
    // a modifier, so anything that does not start with a symbol is a call.
    else if str_eq id "undef_method" then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in apply_modifier (SUndef names) r2
       | _ -> let (es, r2) = parse_puts_args r Nil in apply_modifier (SExpr (ECall ("undef_method", es))) r2)
    else if (str_eq id "include" || str_eq id "prepend") &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      // `include M[, N]` — mix module instance methods in (first module only
      // for now; extra modules are consumed and ignored).
      (match r with
       // `include Rails.application.routes.url_helpers` — the module is the
       // value of an expression, so this is a real call, resolved at run time.
       | Cons (TId m, Cons (TP dot, _)) when str_eq dot "." ->
         (let (es, r2) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r2))
       | Cons (TId m, r2) ->
         (let (full, r2b) = scoped_name m r2 in
          // `include ModuleSpecs::MVars.dup` — a scoped name with a CALL on
          // it is a value like any other, so it resolves at run time. Only a
          // bare path is the static form.
          match r2b with
          | Cons (TP dt3, _) when str_eq dt3 "." ->
            (let (es, r4) = parse_puts_args r Nil in (SExpr (ECall (id, es)), r4))
          | _ -> let (_, r3) = maybe_more_names r2b in (SInclude (full, str_eq id "prepend"), r3))
       // `include ::A::B` — a path anchored at the top level reads the same
       // here, because constants are stored under their qualified name.
       | Cons (TP sc, Cons (TId m, r2)) when str_eq sc "::" || str_eq sc " ::" ->
         (let (full, r2b) = scoped_name m r2 in
          let (_, r3) = maybe_more_names r2b in (SInclude (full, str_eq id "prepend"), r3))
       // `include(M, N)` — the parenthesised form, which takes as many modules
       // as it is given. It used to fall through to an empty expression that
       // consumed nothing: with one module the leftover `(M)` parsed as a
       // statement of its own and the include silently did NOTHING.
       | Cons (TP lp, r2) when is_lparen lp ->
         (let (es, r3) = parse_call_args r2 in (SExpr (ECall (id, es)), r3))
       | _ -> (SExpr ENil, r))
    // The parenthesised form (`private(*names)`) is left to the ordinary call
    // path below: its arguments can be computed at runtime, which a static
    // SVis name list cannot express.
    else if (str_eq id "private" || str_eq id "public" || str_eq id "protected") &&
            // `private.should ...` — a bare visibility call used as a RECEIVER
            // (it answers nil). A `.` after the word means it is an expression,
            // not the statement form that switches the mode.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." then false else true) | _ -> true) &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      // visibility: bare form switches the mode for subsequent defs; the
      // named form (`private :m, :n`) marks those methods.
      let mode = if str_eq id "public" then "public" else if str_eq id "protected" then "protected" else "private" in
      (match r with
       | Cons (TNL _, _) -> (SVis (mode, Nil), r)
       | Cons (TEOF, _) -> (SVis (mode, Nil), r)
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis (mode, names), r2)
       // `private def m ... end` — the arg is a method definition; parse it,
       // then mark it (def evaluates to its name symbol in Ruby).
       | Cons (TId dw, _) ->
         if str_eq dw "def" then
           (let (ds, r2) = parse_stmt r in
            match ds with
            | SDef (dn, _, _, _) ->
              let base = if str_len dn > 5 && str_eq (substring dn 0 5) "self." then dn else dn in
              (SBegin (Cons (ds, Cons (SVis (mode, Cons (base, Nil)), Nil)), Nil, Nil, Nil), r2)
            | _ -> (ds, r2))
         else let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if (str_eq id "require" || str_eq id "require_relative") &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      // load a file into the same world (each file gets a fresh top-level).
      let (e, r2) = parse_expr r in
      // A `require_relative` means "next to the file I am written in", which is
      // not always the file the loader is in when it runs (see
      // parse_time_file). Join it here instead: the result is an absolute path,
      // so `require` uses it directly rather than searching $LOAD_PATH -- and
      // ruby's own LoadError for a missing sibling names the expanded path too.
      (let src = parse_time_file () in
       if str_eq id "require_relative" && (if str_eq src "" then false else true)
       then (SRequire (false, ECall ("__builtin_relpath", Cons (EStrL src, Cons (e, Nil)))), r2)
       else (SRequire (str_eq id "require_relative", e), r2))
    // bare `module_function` switches the enclosing module body into a mode
    // where subsequent defs are also module methods (see register_class_v).
    else if str_eq id "module_function" &&
            // as above: `module_function.should ...` is a receiver, not the
            // statement that switches the mode
            (match r with Cons (TP dt2, _) -> (if str_eq dt2 "." then false else true) | _ -> true) &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TNL _, _) -> (SVis ("module_function", Nil), r)
       | Cons (TEOF, _) -> (SVis ("module_function", Nil), r)
       // `module_function :a, :b` promotes those named methods (handled in
       // register_class_v's named-SVis branch).
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("module_function", names), r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    // `private_class_method :m` marks a class method private (in register_class_v).
    else if str_eq id "private_class_method" &&
            (match r with Cons (TP lp, _) -> (if is_lparen lp then false else true) | _ -> true) then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_class_method", names), r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "private_constant" then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_constant", names), r2)
       | Cons (TNL _, _) -> (SExpr ENil, r)
       | Cons (TEOF, _) -> (SExpr ENil, r)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "public_class_method" then
      // visibility / require: accepted as no-ops.
      // (`using` is NOT here — it parses as a real call so refinements activate.)
      (match r with
       | Cons (TNL _, _) -> (SExpr ENil, r)
       | Cons (TEOF, _) -> (SExpr ENil, r)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "extend" &&
            // A `.` right after the word makes it a RECEIVER, not this
            // statement form -- `extend.get` is a call on a local named
            // `extend`, and reading it as the statement form left the parser
            // looking at a `.` it had no rule for. `private` already had this
            // guard; the other statement-leading names did not.
            (match r with Cons (TP dt, _) -> (if str_eq dt "." || str_eq dt "&." then false else true) | _ -> true) then
      // `extend M` mixes a module's instance methods into the receiver's
      // singleton class (self, in a class/module body). Parse as a real call
      // so the eval-time handler records the singleton include.
      (match r with
       | Cons (TNL _, _) -> (SExpr (ECall ("extend", Nil)), r)
       | Cons (TEOF, _) -> (SExpr (ECall ("extend", Nil)), r)
       // `extend ::A::B` — a leading "::" only anchors at the top level here,
       // where a value has to start; `a::B` elsewhere is still scope
       // resolution on `a`, so this is not a general paren-less argument form.
       | Cons (TP sc, Cons (TId m, r2)) ->
         if str_eq sc "::" || str_eq sc " ::"
         then (let (full, r2b) = scoped_name m r2 in (SExpr (ECall ("extend", Cons (EConst full, Nil))), r2b))
         else (let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
       | _ -> let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
    else if str_eq id "return" then
      (match r with
       | Cons (TNL _, _) -> (SReturn ENil, r)
       | Cons (TEOF, _) -> (SReturn ENil, r)
       // `return if c` / `return unless c` — a value-less return under a
       // statement modifier (the caller attaches the modifier).
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" || str_eq w "until" then (SReturn ENil, r)
         else
           let (es, r2) = parse_rhs_list r Nil in
           (match es with
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | Cons (TP rp, _) ->
         if str_eq rp "}" || str_eq rp ")" || str_eq rp ";" then (SReturn ENil, r)
         else
           let (es, r2) = parse_rhs_list r Nil in
           (match es with
            // `return *x` returns an array (splat-coerced), like `return a, b`.
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | _ ->
         // `return a, b` returns an array of the values.
         let (es, r2) = parse_rhs_list r Nil in
         (match es with
          | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
          | _ -> (SReturn (EArr es), r2)))
    else if str_eq id "break" then
      (match r with
       | Cons (TNL _, _) -> (SBreak ENil, r)
       | Cons (TEOF, _) -> (SBreak ENil, r)
       | Cons (TId k, _) -> if stops_value k then (SBreak ENil, r) else let (e, r2) = parse_expr r in (SBreak e, r2)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SBreak ENil, r)
         else flow_values r (fn e -> SBreak e)
       | _ -> flow_values r (fn e -> SBreak e))
    else if str_eq id "next" then
      (match r with
       | Cons (TNL _, _) -> (SNext ENil, r)
       | Cons (TEOF, _) -> (SNext ENil, r)
       | Cons (TId k, _) -> if stops_value k then (SNext ENil, r) else let (e, r2) = parse_expr r in (SNext e, r2)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SNext ENil, r)
         else flow_values r (fn e -> SNext e)
       | _ -> flow_values r (fn e -> SNext e))
    else if is_ivar id then
      // @name = expr / @name += expr, else an expression (@name read).
      let nm = substring id 1 (str_len id) in
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           let (e, r3) = parse_expr (skip_nls r2) in (SIVarAssign (nm, e), r3)
         else if not (str_eq (opassign_base p) "") then
           let (e, r3) = parse_expr (skip_nls r2) in
           // `@@x ||= v` defines the class variable when it is not defined
           // yet (Ruby special-cases that read); every other op-assign, and
           // every op-assign on an @ivar, reads normally.
           (let base = opassign_base p in
            let readx = (if str_eq base "||" && str_len nm > 0 && str_eq (char_at nm 0) "@"
                         then ECall ("__cvar_or_nil", Cons (EStrL (substring nm 1 (str_len nm)), Nil))
                         else EIVar nm) in
            (SIVarAssign (nm, EBin (base, readx, e)), r3))
         else let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))
    else parse_stmt_ident toks id r
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

// An identifier statement that is none of the command words above: a plain
// `name = ...` local assignment, or any other expression.
and parse_stmt_ident = fn toks -> fn (id: str) -> fn r ->
      // identifier or expression keyword (self/true/false/nil/Const):
      // a plain `name =` is a local assignment; everything else (including
      // method chains and expression keywords) parses as an expression.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" && not (is_keyword id) then
           // assigning to the __ENCODING__ pseudo-variable is a SyntaxError.
           if str_eq id "__ENCODING__" then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: Can't assign to __ENCODING__")) in fail "mere-ruby: Can't assign to __ENCODING__") else
           // `var = begin/case/if/unless ... end` binds the construct's value;
           // otherwise it is an ordinary assignment (`Const = expr` routes to
           // the consts table at eval). A newline may follow the `=`.
           let r2 = skip_nls r2 in
           (match r2 with
            | Cons (TId bg, r3) ->
              if str_eq bg "begin" then let (sb, r4) = parse_begin r3 in construct_assign id sb r4
              else if str_eq bg "case" then let (sb, r4) = parse_case r3 in construct_assign id sb r4
              else if str_eq bg "if" then let (sb, r4) = parse_if r3 false in construct_assign id sb r4
              else if str_eq bg "unless" then let (sb, r4) = parse_if r3 true in construct_assign id sb r4
              // chained assignment `a = b = ... = e` binds right-to-left.
              else if (match r3 with Cons (TP eq2, _) -> str_eq eq2 "=" | _ -> false) && not (is_keyword bg) then
                let (s2, r4) = parse_stmt r2 in (SLocalFrom (id, s2), r4)
              else sassign_rhs id r2
            | _ -> sassign_rhs id r2)
         else if not (str_eq (opassign_base p) "") && not (is_keyword id) && not (is_cap id) then
           // `var += expr` -> `var = var <op> expr`
           let (e, r3) = parse_expr (skip_nls r2) in
           (SAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         else if not (str_eq (opassign_base p) "") && is_cap id then
           // `Const op= expr` — a bare constant op-assign (nil read when undefined).
           let (e, r3) = parse_expr (skip_nls r2) in
           (SAssign (id, EBin (opassign_base p, EConstOrNil id, e)), r3)
         else
           let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))


// `A::B::C` in a class/module header — the flat model keys on the full
// joined name ("A::B") so `.class` etc. report it the way Ruby does.
and parse_qualified_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "::" then (match r with Cons (TId n, r2) -> parse_qualified_name (acc ++ "::" ++ n) r2 | _ -> (acc, toks))
    else (acc, toks)
  | _ -> (acc, toks)

// mark a parsed class statement as a module (sentinel superclass).
and mark_module = fn (s: Stmt) ->
  match s with
  | SClass (n, sup, body) -> if str_eq sup "" then SClass (n, "(module)", body) else s
  | _ -> s

and parse_class = fn toks ->
  match toks with
  // `class << self ... end` — the singleton class: its defs register as
  // class-level methods of the ENCLOSING class (flat-table model).
  | Cons (TP sc0, r0) ->
    if str_eq sc0 "<<" then
      (match r0 with
       // `class << self` (enclosing class) / `class << obj` (a named receiver):
       // the target name rides in the superclass field (flat-table model).
       | Cons (TId slf, r1) ->
         // an ivar/cvar/global receiver (`class << @obj`) is not an env local,
         // so it must be evaluated as an expression rather than resolved by
         // name; true/false/nil likewise route through SSingletonE.
         // any receiver other than `self` — a local variable, a method call
         // (`class << mock('x')`), or a constant (`class << O`) — is evaluated
         // as an expression so its runtime value's singleton class is opened.
         // Only `self` keeps the enclosing-class (named) path.
         if (if str_eq slf "self" then false else true) then
           let (recv, r2) = parse_expr r0 in
           let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end")
         else
           let (body, r5) = parse_class_body_tail r1 in (SClass ("<<singleton", slf, body), expect_kw r5 "end")
       // `class << <expr>` — a paren-expr / literal / ivar receiver.
       | _ ->
         let (recv, r2) = parse_expr r0 in
         let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end"))
    else if str_eq sc0 "::" then
      // `class ::C` — a top-level constant regardless of nesting. Keep the `::`
      // prefix so exec treats it as top-level (not qualified under the encloser).
      (match r0 with
       | Cons (TId slf, r1) -> let (name, r) = parse_qualified_name slf r1 in parse_class_rest ("::" ++ name) r
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ()))
  | Cons (TId name0, r0) ->
    let (name, r) = parse_qualified_name name0 r0 in
    parse_class_rest name r
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected class name after class" ++ parsing_file ()))) in fail ("mere-ruby: expected class name after class" ++ parsing_file ()))

and parse_class_body_tail = fn r2 ->
    let (body0, r5a) = parse_stmts r2 Nil in
    // class-body-level rescue/ensure wraps the body in an implicit begin.
    (match r5a with
     | Cons (TId k, _) ->
       if str_eq k "rescue" || str_eq k "ensure" then
         let (rescues, ra) = parse_rescues r5a Nil in
         let (els, rb) = parse_opt_kw_block ra "else" in
         let (ens, rc) = parse_opt_kw_block rb "ensure" in
         (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
       else (body0, r5a)
     | _ -> (body0, r5a))

and parse_class_rest = fn (name: str) -> fn r ->
    (match r with
     | Cons (TP lt, r3) ->
       if str_eq lt "<" then
         // `< ::B` is a top-level constant; otherwise parse the superclass as an
         // expression. A plain constant keeps the fast name path (SClass); any
         // other expression (method call, self, paren, literal) becomes SClassE.
         (if (match r3 with Cons (TP cc, Cons (TId _, _)) -> str_eq cc "::" | _ -> false) then
            (match r3 with
             | Cons (TP _, Cons (TId sup0, r4)) ->
               let (nm, r4b) = parse_qualified_name sup0 r4 in
               let (body, r5) = parse_class_body_tail r4b in
               (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected superclass name" ++ parsing_file ()))) in fail ("mere-ruby: expected superclass name" ++ parsing_file ())))
          else
            let (se, r4) = parse_expr r3 in
            let (body, r5) = parse_class_body_tail r4 in
            (match se with
             | EConst nm -> (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (SClassE (name, se, body), expect_kw r5 "end")))
       else
         let (body, r5) = parse_class_body_tail r in
         (SClass (name, "", body), expect_kw r5 "end")
     | _ ->
       let (body, r5) = parse_class_body_tail r in
       (SClass (name, "", body), expect_kw r5 "end"))

// begin body rescue* [else] [ensure] end
and parse_begin = fn toks ->
  let (body, r) = parse_stmts toks Nil in
  let (rescues, r2) = parse_rescues r Nil in
  let (els, r3) = parse_opt_kw_block r2 "else" in
  let (ens, r4) = parse_opt_kw_block r3 "ensure" in
  (SBegin (body, rescues, els, ens), expect_kw r4 "end")

and parse_rescues = fn toks -> fn acc ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "rescue" then
      let (classes, var, prefix, r2) = parse_rescue_head r in
      let (handler, r3) = parse_stmts r2 Nil in
      // a complex capture target injects an assignment at the handler's top.
      let handler = (match prefix with Nil -> handler | Cons (s, _) -> Cons (s, handler)) in
      parse_rescues r3 (Cons ((classes, var, handler), acc))
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// `rescue [C1, C2] [=> target]` up to the newline. A bare local target keeps
// the string-var fast path; a complex lvalue (@ivar, obj.setter, obj&.setter,
// arr[i], C::X) binds the exception to a temp and returns an assignment to
// splice at the top of the handler body.
and parse_rescue_head = fn toks ->
  let (classes, r) = parse_rescue_classes toks Nil in
  let (var, prefix, r2) =
    (match r with
     | Cons (TP p, r3) ->
       if str_eq p "=>" then
         (let (tgt, r4) = parse_x_target1 r3 in
          (match tgt with
           | EVar nm -> (nm, Nil, r4)
           | _ -> let tmp = fresh_resc () in (tmp, Cons (SMultiAssignX (Cons (tgt, Nil), Cons (EVar tmp, Nil)), Nil), r4)))
       else ("", Nil, r)
     | _ -> ("", Nil, r)) in
  (classes, var, prefix, expect_end r2)

and parse_rescue_classes = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId c, r) ->
    // a bare constant matches by name (cheap path); a lowercase identifier is
    // a runtime expression (`rescue rescuer`).
    if is_cap c then
      let (full, r0) = scoped_name c r in
      (match r0 with
       | Cons (TP p, r2) ->
         if str_eq p "," then parse_rescue_classes (skip_nls r2) (Cons (full, acc))
         // `rescue C.new` — a constant followed by a `.` is the start of an
         // EXPRESSION, not the constant itself. Stopping at the constant left
         // `.new` for the caller, which was expecting `=>` or the end of the
         // line and said so. Ruby evaluates whatever is there and matches with
         // `===`, which is what makes `rescue C.new` (a matcher object) work.
         else if str_eq p "." then parse_rescue_expr_item toks acc false
         // a constant that continues (`::` handled by scoped_name) is just the
         // constant here; `=>` / newline end the class list.
         else (rev_app (Cons (full, acc)) Nil, r0)
       | _ -> (rev_app (Cons (full, acc)) Nil, r0))
    else parse_rescue_expr_item toks acc false
  // `rescue *x` / `rescue *(expr)` — splat a runtime array of exception classes.
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId v, r2) ->
         if is_cap v || (if str_len v > 0 then (if str_eq (char_at v 0) "@" then true else str_eq (char_at v 0) "$") else false)
         then parse_rescue_expr_item r acc true  // `*Const` / `*@x` as an expr
         else (match r2 with
          | Cons (TP p, r3) -> if str_eq p "," then parse_rescue_classes (skip_nls r3) (Cons ("*" ++ v, acc)) else (rev_app (Cons ("*" ++ v, acc)) Nil, r2)
          | _ -> (rev_app (Cons ("*" ++ v, acc)) Nil, r2))
       | _ -> parse_rescue_expr_item r acc true)
    // a parenthesized / lambda expression class (`rescue (expr)` / `rescue -> {..}`);
    // any other punctuation (`=>`, newline, `then`, `;`) ends the class list.
    else if is_lparen star || str_eq star "->" then parse_rescue_expr_item toks acc false
    // `rescue ::Foo::Bar => e` — a class named from the top level.
    else if str_eq star "::" || str_eq star " ::" then
      (match r with
       | Cons (TId c, r2) ->
         (let (full, r0) = scoped_name c r2 in
          match r0 with
          | Cons (TP p2, r3) ->
            if str_eq p2 "," then parse_rescue_classes (skip_nls r3) (Cons (full, acc))
            else (rev_app (Cons (full, acc)) Nil, r0)
          | _ -> (rev_app (Cons (full, acc)) Nil, r0))
       | _ -> (rev_app acc Nil, toks))
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// parse one non-constant rescue class as a runtime expression, register it,
// and continue with the "@rexpr~N" sentinel (splat prefixes it with "*").
and parse_rescue_expr_item = fn toks -> fn (acc: str list) -> fn (splat: bool) ->
  let (e0, r0) = parse_bin toks 1 in
  // an item may be a ternary: net/http picks its class with
  // `defined?(OpenSSL::SSL) ? OpenSSL::SSL::SSLError : IOError`. parse_bin
  // stops at the `?`, which left the rest of the list dangling.
  let (e, r) =
    (match r0 with
     | Cons (TP q, rq) ->
       if str_eq q "?" then
         (let (t, r1) = parse_expr (skip_nls rq) in
          match r1 with
          | Cons (TP colon, r2) ->
            if str_eq colon ":" then (let (f, r3) = parse_expr (skip_nls r2) in (ETern (e0, t, f), r3))
            else (e0, r0)
          | _ -> (e0, r0))
       else (e0, r0)
     | _ -> (e0, r0)) in
  let sentinel = (if splat then "*" else "") ++ resc_reg e in
  (match r with
   | Cons (TP p, r2) -> if str_eq p "," then parse_rescue_classes (skip_nls r2) (Cons (sentinel, acc)) else (rev_app (Cons (sentinel, acc)) Nil, r)
   | _ -> (rev_app (Cons (sentinel, acc)) Nil, r))

and parse_opt_kw_block = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) -> if str_eq id kw then parse_stmts r Nil else (Nil, toks)
  | _ -> (Nil, toks)

and parse_attr = fn (mode: str) -> fn toks ->
  let (syms, r) = parse_sym_list toks Nil in
  // `attr :a, true` is ruby's old spelling of attr_accessor (and `, false` of
  // attr_reader). The flag is not a name, so parse_sym_list leaves it here.
  match r with
  | Cons (TId flag, r2) when str_eq flag "true" -> (SAttr ("rw", syms), r2)
  | Cons (TId flag, r2) when str_eq flag "false" -> (SAttr ("r", syms), r2)
  | _ -> (SAttr (mode, syms), r)

and parse_sym_list = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TSym s, r) ->
    (match r with
     | Cons (TP p, r2) ->
       // an attr list can wrap after a comma, like any argument list.
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (s, acc))
       else (rev_app (Cons (s, acc)) Nil, r)
     | _ -> (rev_app (Cons (s, acc)) Nil, r))
  // ...and a name may be written as a STRING: `attr_accessor :a, "b"`. A
  // double-quoted string lexes as an interpolation GROUP, so it is parsed as
  // an expression and folded, the way alias names are.
  | Cons (TP grp, _) when str_eq grp "(s" ->
    (let (e, r) = parse_primary toks in
     let nm = const_fold_str e in
     match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_sym_list (skip_nls r2) (Cons (nm, acc))
       else (rev_app (Cons (nm, acc)) Nil, r)
     | _ -> (rev_app (Cons (nm, acc)) Nil, r))
  // the trailing `true` / `false` of `attr :a, true` ends the list
  | Cons (TId flag, _) when str_eq flag "true" || str_eq flag "false" ->
    (rev_app acc Nil, toks)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected :symbol" ++ parsing_file ()))) in fail ("mere-ruby: expected :symbol" ++ parsing_file ()))

// a range in an if/unless condition is the flip-flop operator; allocate its
// state site here (parse time), reaching through !/&&/|| combinations.
// scan (depth-aware) for a top-level assignment operator before the
// closing paren — defined?(x = 2) / defined?(@x ||= 1) forms.
// `defined?(<compound statement>)` — if/unless/case/while/until/for/begin —
// always answers "expression" in Ruby; parse it as a statement (correctly
// consuming to the matching `end`) rather than as an expression.
and defined_compound = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    str_eq w "if" || str_eq w "unless" || str_eq w "case" || str_eq w "while" ||
    str_eq w "until" || str_eq w "for" || str_eq w "begin"
  | _ -> false

and defined_assignish = fn toks -> defined_assign_go toks 0

and defined_assign_go = fn toks -> fn (depth: int) ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      defined_assign_go r (depth + 1)
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth == 0 then false else defined_assign_go r (depth - 1))
    else if depth == 0 && (str_eq p "=" || (if str_eq (opassign_base p) "" then false else true)) then true
    else defined_assign_go r depth
  | Cons (_, r) -> defined_assign_go r depth

and cond_ff = fn (e: Expr) ->
  match e with
  | ERange (a, b, excl) ->
    let n = map_len ff_state in
    let _ = map_set ff_state (str_of_int n) (VBool false) in
    EFlipFlop (n, a, b, excl)
  | EBin (op, l, r) ->
    if str_eq op "&&" || str_eq op "||" then EBin (op, cond_ff l, cond_ff r) else e
  | EUn (op, x) -> if str_eq op "!" then EUn (op, cond_ff x) else e
  | _ -> e

and parse_if = fn toks -> fn (negate: bool) ->
  let (cond1, r0) = parse_andor toks in
  // `if x = compute rescue next` -- the rescue modifier binds tighter than the
  // `if`, so the CONDITION is `(x = compute) rescue next` (activesupport's
  // Messages::Rotator writes exactly that inside a block).
  let (cond1, r) =
    (match r0 with
     | Cons (TId rw, r1) ->
       if str_eq rw "rescue" then
         (let (h, r2) = parse_stmt (skip_nls r1) in
          (EStmt (SBegin (Cons (SExpr cond1, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil)), r2))
       else (cond1, r0)
     | _ -> (cond1, r0)) in
  let cond0 = cond_ff cond1 in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  let (clauses, els, r3) = parse_if_tail r2 in
  (SIf (Cons ((cond, body), clauses), els), r3)

and parse_if_tail = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "end" then (Nil, Nil, r)
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (Nil, b, expect_kw r2 "end")
    else if str_eq id "elsif" then
      // the same parser as `if`: an elsif condition may use the low-precedence
      // `and` / `or` (racc's generated parsers are written that way).
      let (c0, r2) = parse_andor r in
      let c = cond_ff c0 in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      let (clauses, els, r4) = parse_if_tail r3 in
      (Cons ((c, b), clauses), els, r4)
    else (let __fm = ("mere-ruby: expected elsif/else/end, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated if" ++ parsing_file ()))) in fail ("mere-ruby: unterminated if" ++ parsing_file ()))

// `for x in e [do] body end` — each over e with x as the block param.
// The block shares the enclosing env, so (like Ruby's for) x leaks out.
and parse_for = fn toks ->
  // a complex loop target (`for obj.attr in`, `for arr[i] in`, `for C::X in`,
  // `for obj&.attr in`) is parsed as an assignment-target expression and driven
  // through the same setter machinery as multiple assignment.
  if for_targets_complex toks then
    let (targets, r2) = parse_for_xtargets toks Nil in
    let (e0, r3) = parse_for_expr r2 in
    let (e, body, r4) = parse_for_iter e0 r3 in
    (match targets with
     | Cons (t, Nil) ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("__forv", Nil), Cons (for_xassign t (EVar "__forv"), body))), r4)
     | _ ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("*__forv", Nil), Cons (SMultiAssignX (targets, Cons (ESplat (EVar "__forv"), Nil)), body))), r4))
  else
  let (vars, r2) = parse_for_vars toks Nil in
  let (e0, r3) = parse_for_expr r2 in
  let (e, body, r4) = parse_for_iter e0 r3 in
  (match vars with
   | Cons (v, Nil) ->
     // the hidden __for param keeps v assigned in the SHARED scope, so
     // v survives the loop (block params themselves are block-local).
     (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil), Cons (for_assign v (EVar "__for"), body))), r4)
   | _ ->
     // multiple targets: real (auto-splatting) block params __f0.., then a
     // prologue assigns them into the SHARED scope names.
     let (params, prologue) = for_multi_binding vars 0 in
     (SExpr (EMethodB (e, "each", Nil, params, list_append_stmt prologue body)), r4))

// The iterable must not swallow the loop's `do`, the same way a while
// condition must not: in `for y in 0...h do`, the bare `h` at the end of the
// range would otherwise take the block (chunky_png writes exactly that).
and parse_for_expr = fn toks ->
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (e, r) = parse_expr toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  (e, r)

// `for i in x do ... end` — a bare-variable iterable grabs the do-block as its
// own; unwrap it back into the loop body. Shared by both for-target paths.
and parse_for_iter = fn (e0: Expr) -> fn r3 ->
  match e0 with
  | ECallB (nm, Nil, bps, bb) -> (match bps with Nil -> (EVar nm, bb, r3) | _ -> (e0, Nil, r3))
  | _ ->
    let r3b = (match r3 with Cons (TId d, rr) -> (if str_eq d "do" then rr else r3) | _ -> r3) in
    let (b, r4b) = parse_stmts r3b Nil in
    (e0, b, expect_kw r4b "end")

// does the for-target list (up to `in`) contain a complex chain?
and for_targets_complex = fn toks ->
  match toks with
  | Nil -> false
  | Cons (TNL _, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) -> if str_eq w "in" then false else for_targets_complex r
  | Cons (TP p, r) ->
    if str_eq p "." || str_eq p "[" || str_eq p "::" || str_eq p "&." then true
    else for_targets_complex r
  | Cons (_, r) -> for_targets_complex r

// parse comma-separated complex for-targets, terminated by `in`.
and parse_for_xtargets = fn toks -> fn (acc: Expr list) ->
  let (t, r) = parse_x_target1 toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_for_xtargets r2 (Cons (t, acc)) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | Cons (TId kw, r2) -> if str_eq kw "in" then (rev_app (Cons (t, acc)) Nil, r2) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))

// build the statement that assigns one for-iteration value to a complex target.
and for_xassign = fn (t: Expr) -> fn (rhs: Expr) ->
  match t with
  | EMethod (recv, m, args) -> if str_eq m "[]" then SExpr (EMethod (recv, "[]=", eapp args (Cons (rhs, Nil)))) else SExpr (EMethod (recv, m ++ "=", Cons (rhs, Nil)))
  | ESafe (recv, m, args) -> SExpr (ESafe (recv, m ++ "=", eapp args (Cons (rhs, Nil))))
  | EScopedRead (recv, cn) -> SExpr (EScopedAssign (recv, cn, rhs))
  | EIVar n -> SAssign ("@" ++ n, rhs)
  | EVar n -> SAssign (n, rhs)
  | _ -> SExpr rhs

and list_append_stmt = fn (xs: Stmt list) -> fn (ys: Stmt list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_stmt t ys)

// vars -> (block params, prologue stmts): v -> __fN + v = __fN;
// *x -> *__fN + x = __fN; bare * -> anonymous *.
// a for-loop target assignment: an @ivar / @@cvar name routes to SIVarAssign
// (SAssign only handles plain locals / $globals / constants).
and for_assign = fn (v: str) -> fn (rhs: Expr) ->
  if str_len v > 0 && str_eq (char_at v 0) "@" then SIVarAssign (substring v 1 (str_len v), rhs)
  else SAssign (v, rhs)

and for_multi_binding = fn (vars: str list) -> fn (n: int) ->
  match vars with
  | Nil -> (Nil, Nil)
  | Cons (v, rest) ->
    let (ps, ss) = for_multi_binding rest (n + 1) in
    if str_eq v "*" then (Cons ("*", ps), ss)
    else if str_len v > 0 && str_eq (char_at v 0) "*" then
      let nm = substring v 1 (str_len v) in
      (Cons ("*__f" ++ str_of_int n, ps), Cons (for_assign nm (EVar ("__f" ++ str_of_int n)), ss))
    else (Cons ("__f" ++ str_of_int n, ps), Cons (for_assign v (EVar ("__f" ++ str_of_int n)), ss))

// target list before `in`: a name, `name,`, `a, b`, `a, *`, `a, *rest`.
// the names inside `for (a, b) in ...`, up to the closing paren.
and parse_for_group = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId v, r) ->
    (match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_for_group r2 (Cons (v, acc))
       else if str_eq p ")" then (rev_app (Cons (v, acc)) Nil, r2)
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected , or ) in a for target" ++ parsing_file ()))) in fail ("mere-ruby: expected , or ) in a for target" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated for target" ++ parsing_file ()))) in fail ("mere-ruby: unterminated for target" ++ parsing_file ())))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable in a for target" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable in a for target" ++ parsing_file ()))

and parse_for_vars = fn toks -> fn (acc: str list) ->
  match toks with
  // `for (a, b) in pairs` — the parens only group the destructuring, exactly
  // as `for a, b in pairs` does.
  | Cons (TP lp, r0) ->
    if is_lparen lp then
      (let (vs, r1) = parse_for_group r0 Nil in
       match r1 with
       | Cons (TId kw, r2) ->
         if str_eq kw "in" then (rev_app (rev_app vs acc) Nil, r2)
         else parse_for_vars r1 (rev_app vs acc)
       | _ -> parse_for_vars r1 (rev_app vs acc))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))
  | Cons (TId v, r) ->
    if str_eq v "in" then (rev_app acc Nil, r)
    else
      (match r with
       | Cons (TP c, r2) ->
         if str_eq c "," then
           // `for i, in` — a trailing comma destructures (i = first elem).
           (match r2 with
            | Cons (TId nx, r3) ->
              if str_eq nx "in" then (rev_app (Cons ("*", Cons (v, acc))) Nil, r3)
              else parse_for_vars r2 (Cons (v, acc))
            | _ -> parse_for_vars r2 (Cons (v, acc)))
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
       | Cons (TId kwin, r2) ->
         if str_eq kwin "in" then (rev_app (Cons (v, acc)) Nil, r2)
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId n, r2) ->
         if str_eq n "in" then (rev_app (Cons ("*", acc)) Nil, r2)
         else parse_for_vars2 ("*" ++ n) r2 acc
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ())))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a variable after for" ++ parsing_file ()))) in fail ("mere-ruby: expected a variable after for" ++ parsing_file ()))

and parse_for_vars2 = fn (t: str) -> fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_for_vars r (Cons (t, acc))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | Cons (TId kwin, r) ->
    if str_eq kwin "in" then (rev_app (Cons (t, acc)) Nil, r)
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected in after for" ++ parsing_file ()))) in fail ("mere-ruby: expected in after for" ++ parsing_file ()))

and parse_while = fn toks -> fn (negate: bool) ->
  // the condition must not swallow the loop's `do` as a block argument
  // (`while x do y end` = while x; then y; not x { y }).
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (cond0, r) = parse_andor toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  (SWhile (cond, body), expect_kw r2 "end")

and parse_case = fn toks ->
  // `case` immediately followed by a newline is subjectless: the when
  // conditions are truthiness tests rather than === against a subject.
  match toks with
  | Cons (TNL _, _) -> parse_whens ECaseNone toks Nil
  // ... and so is `case when c then v end` on one line: `when` cannot start a
  // subject expression, so its presence here means there is no subject.
  | Cons (TId kw0, _) -> if str_eq kw0 "when" then parse_whens ECaseNone toks Nil else parse_case_subj toks
  | _ -> parse_case_subj toks
and parse_case_subj = fn toks ->
  (match toks with
  | _ ->
    let (subj, r) = parse_expr toks in
    // `in` after the subject selects pattern matching; `when` the classic form.
    (match skip_nls r with
     | Cons (TId kw, _) -> if str_eq kw "in" then parse_case_in subj r Nil else parse_whens subj r Nil
     | _ -> parse_whens subj r Nil))

// pattern-matching case: parse `in <pattern> [if|unless <cond>] [then] body`
// clauses, an optional `else`, and the closing `end`.
and parse_case_in = fn (subj: Expr) -> fn toks -> fn acc ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "in" then
      let (pat, r2) = parse_pattern_top r in
      let (guard, r3) = parse_in_guard r2 in
      // after a pattern (+ optional guard) a delimiter must follow — then, a
      // newline, or end. Anything else (e.g. a leftover `+ 1` from `in 1 + 1`,
      // which a value pattern does not consume) is a SyntaxError in Ruby.
      let _ = (match r3 with
               | Cons (TId g, _) -> if str_eq g "then" || is_block_stop g then () else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))) in fail ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))
               | Cons (TNL _, _) -> ()
               | Cons (TEOF, _) -> ()
               | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))) in fail ("mere-ruby: expected a delimiter after the patterns of an `in` clause" ++ parsing_file ()))) in
      let (b, r4) = parse_stmts (skip_then r3) Nil in
      parse_case_in subj r4 (Cons ((pat, guard, b), acc))
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (SCaseIn (subj, rev_app acc Nil, true, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCaseIn (subj, rev_app acc Nil, false, Nil), r)
    else (let __fm = ("mere-ruby: expected in/else/end in case, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated case/in" ++ parsing_file ()))) in fail ("mere-ruby: unterminated case/in" ++ parsing_file ()))

// an optional guard after a pattern: `if COND` / `unless COND`.
and parse_in_guard = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "if" then let (c, r2) = parse_andor r in (c, r2)
    else if str_eq id "unless" then let (c, r2) = parse_andor r in (EUn ("!", c), r2)
    else (EBool true, toks)
  | _ -> (EBool true, toks)

// a top-level pattern (the direct operand of `in` or one-line `=>`/`in`).
// Bare forms without brackets/braces are allowed here: `in 0, 1, 2` is an
// array pattern and `in a:, b:` is a hash pattern.
// ---- parser-side pattern static checks ----------------------------------
// (These run at parse time so an offending pattern inside eval("...") surfaces
//  as a catchable SyntaxError, matching Ruby.)
and pp_us = fn (n: str) -> str_len n > 0 && str_eq (char_at n 0) "_"
and pp_names = fn (p: Pat) -> fn (acc: str list) ->
  match p with
  | PVar n -> Cons (n, acc)
  | PSplatP n -> if str_eq n "" then acc else Cons (n, acc)
  | PArrP es -> pp_names_list es acc
  | PHashP (items, rest) ->
    let a2 = if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then acc else Cons (rest, acc) in
    pp_hitems items a2
  | PAltP alts -> pp_names_list alts acc
  | PAsP (sub, n) -> Cons (n, pp_names sub acc)
  | PConstP (_, inner) -> pp_names inner acc
  | _ -> acc
and pp_names_list = fn (es: Pat list) -> fn (acc: str list) ->
  match es with Nil -> acc | Cons (p, r) -> pp_names_list r (pp_names p acc)
and pp_hitems = fn (items: (str * Pat) list) -> fn (acc: str list) ->
  match items with Nil -> acc | Cons (kp, r) -> let (k, sub) = kp in pp_hitems r (pp_names sub acc)
and pp_mem = fn (xs: str list) -> fn (n: str) ->
  match xs with Nil -> false | Cons (h, t) -> str_eq h n || pp_mem t n
// a non-underscore variable bound more than once (`in [a, a]` — SyntaxError;
// `_`/`_x` may repeat).
and pp_has_dup = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else pp_mem rest n) || pp_has_dup rest
// any non-underscore binding at all (used to forbid bindings in alternatives).
and pp_has_real = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else true) || pp_has_real rest
and check_dup_vars = fn (p: Pat) ->
  if pp_has_dup (pp_names p Nil) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: duplicated variable name in pattern")) in fail "mere-ruby: duplicated variable name in pattern") else ()

// `^name` may only pin a variable already bound to its LEFT in the pattern (or
// a pre-existing local). Pinning a name that the SAME pattern binds later
// (`in [^n, n]`) is a SyntaxError ("no such local variable"); `[n, ^n]` is ok.
and check_pin_order = fn (p: Pat) ->
  let all = pp_names p Nil in
  let (bad, _) = pp_pin_walk p all Nil in
  if bad then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: no such local variable in pattern (pinned before bound)")) in fail "mere-ruby: no such local variable in pattern (pinned before bound)") else ()
and pp_pin_walk = fn (p: Pat) -> fn (all: str list) -> fn (seen: str list) ->
  match p with
  | PVar n -> (false, Cons (n, seen))
  | PPin e -> (match e with EVar n -> ((pp_mem all n) && (if pp_mem seen n then false else true), seen) | _ -> (false, seen))
  | PSplatP n -> (false, if str_eq n "" then seen else Cons (n, seen))
  | PArrP es -> pp_pin_walk_list es all seen
  | PHashP (items, _) -> pp_pin_walk_hitems items all seen
  | PAltP alts -> pp_pin_walk_list alts all seen
  | PAsP (sub, n) -> let (b, s) = pp_pin_walk sub all seen in (b, Cons (n, s))
  | PConstP (_, inner) -> pp_pin_walk inner all seen
  | _ -> (false, seen)
and pp_pin_walk_list = fn (es: Pat list) -> fn (all: str list) -> fn (seen: str list) ->
  match es with
  | Nil -> (false, seen)
  | Cons (p, r) -> let (b, s) = pp_pin_walk p all seen in if b then (true, s) else pp_pin_walk_list r all s
and pp_pin_walk_hitems = fn (items: (str * Pat) list) -> fn (all: str list) -> fn (seen: str list) ->
  match items with
  | Nil -> (false, seen)
  | Cons (kp, r) -> let (k, sub) = kp in let (b, s) = pp_pin_walk sub all seen in if b then (true, s) else pp_pin_walk_hitems r all s

and parse_pattern_top = fn toks ->
  let (p, r) = parse_pattern_top0 toks in
  let _ = check_dup_vars p in
  let _ = check_pin_order p in
  (p, r)

and parse_pattern_top0 = fn toks ->
  // bare hash pattern: starts with a `label:` or `**`.
  if starts_hash_pattern toks then
    let (items, rest, r) = parse_hash_pat_items toks Nil "" in
    (PHashP (items, rest), r)
  else
    let (p, r) = parse_pattern toks in
    // bare array pattern: a top-level comma joins elements without brackets.
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then
         let (rest, r3) = parse_bare_arr r2 Nil in
         (PArrP (Cons (p, rest)), r3)
       else (p, r)
     | _ -> (p, r))

// elements of a bracket-less array pattern (`in 0, 1, *rest`), terminated by
// end-of-clause rather than `]`. Called right after a separating comma.
and parse_bare_arr = fn toks -> fn (acc: Pat list) ->
  // called right after a separating comma; a terminator here means a trailing
  // comma (`0, 1,`) which makes the pattern match partially — append a splat.
  match toks with
  | Cons (TNL _, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TEOF, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | Cons (TP p, _) -> if str_eq p ")" || str_eq p ";" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | _ -> parse_bare_arr_one toks acc

and parse_bare_arr_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match r with
   | Cons (TP c, r2) -> if str_eq c "," then parse_bare_arr r2 acc2 else (rev_app acc2 Nil, r)
   | _ -> (rev_app acc2 Nil, r))

// does the token stream begin a bare (brace-less) hash pattern?
and starts_hash_pattern = fn toks ->
  match toks with
  | Cons (TId _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TStrL _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TP op, Cons (TStrL _, Cons (TP plus, Cons (TStrL _, Cons (TP cp, Cons (TP colon, _)))))) -> str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":"
  | Cons (TP dsp, _) -> str_eq dsp "**"
  | _ -> false

// a full pattern including alternation `p1 | p2 | ...` and the trailing
// as-binding `pat => name`.
and parse_pattern = fn toks ->
  let (p, r) = parse_pattern_alt toks in
  // `pat => name` binds the whole matched value to a local.
  (match r with
   | Cons (TP arrow, r2) ->
     if str_eq arrow "=>" then
       (match r2 with
        | Cons (TId nm, r3) -> (PAsP (p, nm), r3)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected name after => in pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected name after => in pattern" ++ parsing_file ())))
     else (p, r)
   | _ -> (p, r))

and parse_pattern_alt = fn toks ->
  let (p, r) = parse_pattern_prim toks in
  (match r with
   | Cons (TP bar, r2) ->
     if str_eq bar "|" then
       let (alts, r3) = parse_alt_rest r2 (Cons (p, Nil)) in
       // Ruby forbids binding a (non-underscore) variable in an alternative.
       let _ = if pp_has_real (pp_names (PAltP alts) Nil) then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: illegal variable in alternative pattern")) in fail "mere-ruby: illegal variable in alternative pattern") else () in
       (PAltP alts, r3)
     else (p, r)
   | _ -> (p, r))

and parse_alt_rest = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern_prim toks in
  let acc2 = rev_app (Cons (p, rev_app acc Nil)) Nil in
  (match r with
   | Cons (TP bar, r2) -> if str_eq bar "|" then parse_alt_rest r2 acc2 else (acc2, r)
   | _ -> (acc2, r))

// a primary pattern (no alternation / as-binding at this level).
and parse_pattern_prim = fn toks ->
  match toks with
  // array pattern [ ... ]
  | Cons (TP lb, r) ->
    if str_eq lb "[" || str_eq lb " [" then
      let (elems, r2) = parse_arr_pat_elems r Nil in
      (PArrP elems, r2)
    // hash pattern { ... }
    else if str_eq lb "\{" then
      let (items, rest, r2) = parse_hash_pat_brace r in
      (PHashP (items, rest), r2)
    // ^pin
    else if str_eq lb "^" then parse_pin r
    // *splat (only valid inside an array; encode as a splat element)
    else if str_eq lb "*" then
      (match r with
       | Cons (TId nm, r2) -> (PSplatP nm, r2)
       | _ -> (PSplatP "", r))
    // **rest at top level of a bare hash pattern handled elsewhere; a bare
    // parenthesised pattern `(pat)` just groups.
    else if is_lparen lb then
      let (p, r2) = parse_pattern (skip_nls r) in (p, expect (skip_nls r2) ")")
    else
      // any other leading token: a value pattern (literal / range / etc.).
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
  // a bare identifier: a variable binding when lowercase, else a value/const.
  | Cons (TId nm, r) ->
    if is_upper_first nm then parse_const_pattern toks
    else if str_eq nm "nil" || str_eq nm "true" || str_eq nm "false" then
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
    else
      // a lowercase name binds, unless a following `..`/`...` makes it a
      // range value pattern.
      (match r with
       | Cons (TP dots, _) -> if str_eq dots ".." || str_eq dots "..." then let (e, r2) = parse_pat_value toks in (PVal e, r2) else (PVar nm, r)
       | _ -> (PVar nm, r))
  | _ -> let (e, r) = parse_pat_value toks in (PVal e, r)

// a value pattern's expression: like parse_range but with the binary layer
// capped so alternation `|` (prec 5) is NOT consumed here — it belongs to the
// pattern grammar. Handles literals, unary minus, ranges, symbols, regexps.
and parse_pat_value = fn toks ->
  // a value pattern is a single primary (literal / const / symbol / regex /
  // unary-minus number) with an optional range — NOT an arithmetic expression.
  // Using parse_unary (not parse_bin) means `in 1 + 1` leaves `+ 1` behind, so
  // the clause's delimiter check reports a SyntaxError, as Ruby does.
  let (lo, r) = parse_unary toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then (ERange (lo, ENil, excl), rest)
         else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | Cons (TNL _, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, ENil, excl), rest)
       | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (ERange (lo, ENil, excl), rest) else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

// read a bare constant reference (`Foo`, `Foo::Bar`) WITHOUT consuming a
// trailing `[` / `(` — those introduce the deconstruct sub-pattern.
and parse_pat_const = fn toks ->
  match toks with
  | Cons (TP colons, Cons (TId nm, r)) -> if str_eq colons "::" then parse_pat_const_more (EConst nm) r else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad constant pattern")) in fail "mere-ruby: bad constant pattern")
  | Cons (TId nm, r) -> parse_pat_const_more (EConst nm) r
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a constant in pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a constant in pattern" ++ parsing_file ()))

and parse_pat_const_more = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP cc, Cons (TId nm2, r2)) -> if str_eq cc "::" then parse_pat_const_more (EScopedRead (e, nm2)) r2 else (e, toks)
  | _ -> (e, toks)

// `^name` / `^@x` / `^@@x` / `^$x` / `^(expr)`.
and parse_pin = fn toks ->
  match toks with
  | Cons (TP lp, r) ->
    if is_lparen lp then let (e, r2) = parse_expr r in (PPin e, expect r2 ")")
    else if str_eq lp "@" then (match r with Cons (TId nm, r2) -> (PPin (EIVar nm), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad ^@ pattern")) in fail "mere-ruby: bad ^@ pattern"))
    else if str_eq lp "$" then (match r with Cons (TId nm, r2) -> (PPin (EVar ("$" ++ nm)), r2) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad ^$ pattern")) in fail "mere-ruby: bad ^$ pattern"))
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bad ^ pattern")) in fail "mere-ruby: bad ^ pattern")
  | Cons (TId nm, r) ->
    // `^@x` / `^@@x` lex as an @-prefixed identifier; `^$g` as a $-name.
    if str_len nm >= 1 && str_eq (char_at nm 0) "@" then (PPin (EIVar (substring nm 1 (str_len nm))), r)
    else if str_len nm >= 1 && str_eq (char_at nm 0) "$" then (PPin (EVar nm), r)
    else (PPin (EVar nm), r)
  | _ -> let (e, r) = parse_primary toks in (PPin e, r)

// `Const`, `Const[...]`, `Const(...)`, `Const(id: p, ...)`; a bare Const is a
// value pattern (=== the class).
and parse_const_pattern = fn toks ->
  let (ce, r) = parse_pat_const toks in
  (match r with
   | Cons (TP lb, r2) ->
     if str_eq lb " [" || str_eq lb "[" then
       // the item/element parsers already consume the closing ] themselves.
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else if str_eq lb " (" || is_lparen lb then
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems_paren r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else (PVal ce, r)
   | _ -> (PVal ce, r))

// elements of an array pattern up to the closing `]`.
and parse_arr_pat_elems = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) ->
    if str_eq rb "]" then (rev_app acc Nil, r)
    else parse_arr_pat_one t acc
  | _ -> parse_arr_pat_one t acc

and parse_arr_pat_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       // a trailing comma before `]` makes the pattern match partially from the
       // start (`[0, 1, ]` == `[0, 1, *]`): append an anonymous splat.
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb "]" then (rev_app (Cons (PSplatP "", acc2)) Nil, r3) else parse_arr_pat_elems (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems (skip_nls r2) acc2)
     else if str_eq c "]" then (rev_app acc2 Nil, r2)
     else (let __fm = ("mere-ruby: expected , or ] in array pattern, got " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
   | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated array pattern" ++ parsing_file ()))) in fail ("mere-ruby: unterminated array pattern" ++ parsing_file ())))

// like parse_arr_pat_elems but closes on `)` (Const(pat, ...) form).
and parse_arr_pat_elems_paren = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) -> if str_eq rb ")" then (rev_app acc Nil, r) else parse_arr_pat_one_p t acc
  | _ -> parse_arr_pat_one_p t acc

and parse_arr_pat_one_p = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb ")" then (rev_app acc2 Nil, r3) else parse_arr_pat_elems_paren (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems_paren (skip_nls r2) acc2)
     else if str_eq c ")" then (rev_app acc2 Nil, r2)
     else (let __fm = ("mere-ruby: expected , or ) in pattern, got " ++ c ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
   | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated pattern" ++ parsing_file ()))) in fail ("mere-ruby: unterminated pattern" ++ parsing_file ())))

// a brace hash pattern `{ ... }` — consume up to `}`.
and parse_hash_pat_brace = fn toks ->
  match skip_nls toks with
  | Cons (TP rb, r) -> if str_eq rb "}" then (Nil, "", r) else parse_hash_pat_items toks Nil ""
  | _ -> parse_hash_pat_items toks Nil ""

// hash-pattern items: (label, sub-pattern) pairs plus a rest tag. Stops at
// `}` / `]` / `)` / end-of-clause. `rest` accumulates the **-form.
and parse_hash_pat_items = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      // **nil / **name / ** (anonymous)
      (match r0 with
       | Cons (TId nm, r1) -> if str_eq nm "nil" then hash_pat_sep r1 acc "nil" else hash_pat_sep r1 acc nm
       | _ -> hash_pat_sep r0 acc "*")
    else if str_eq dsp "}" || str_eq dsp "]" || str_eq dsp ")" then (rev_app acc Nil, rest, r0)
    else parse_hash_pat_kv t acc rest
  | _ -> parse_hash_pat_kv t acc rest

and parse_hash_pat_kv = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  // key: `label:` (identifier) or `"string":` (symbol key).
  let (key, r2) =
    (match toks with
     | Cons (TId nm, Cons (TP colon, r0)) -> if str_eq colon ":" then (nm, r0) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))
     | Cons (TStrL s, Cons (TP colon, r0)) -> if str_eq colon ":" then (s, r0) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected label in hash pattern" ++ parsing_file ()))
     // a "string": key (double-quoted, no interpolation) lexes as `(s "" + s )`.
     | Cons (TP op, Cons (TStrL empty, Cons (TP plus, Cons (TStrL s, Cons (TP cp, Cons (TP colon, r0)))))) ->
       if str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":" then (s, r0) else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))) in fail ("mere-ruby: expected a label as the key in the hash pattern" ++ parsing_file ()))) in
  // an omitted value (`a:`) binds the key name; otherwise parse a sub-pattern.
  // Do NOT skip newlines here: a newline / `;` ends a brace-less hash pattern.
  let (sub, r3) =
    (match r2 with
     | Cons (TP p, _) -> if str_eq p "," || str_eq p "}" || str_eq p "]" || str_eq p ")" then (PVar key, r2) else parse_pattern r2
     | Cons (TId gg, _) -> if str_eq gg "then" || str_eq gg "if" || str_eq gg "unless" then (PVar key, r2) else parse_pattern r2
     | Cons (TNL _, _) -> (PVar key, r2)
     | Cons (TEOF, _) -> (PVar key, r2)
     | _ -> parse_pattern r2) in
  // Ruby rejects a duplicated key name in a hash pattern.
  let _ = if pp_hitem_haskey acc key then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: duplicated key name in hash pattern")) in fail "mere-ruby: duplicated key name in hash pattern") else () in
  hash_pat_sep r3 (Cons ((key, sub), acc)) rest

and pp_hitem_haskey = fn (items: (str * Pat) list) -> fn (key: str) ->
  match items with Nil -> false | Cons (kp, r) -> let (k, _) = kp in str_eq k key || pp_hitem_haskey r key

and hash_pat_sep = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  match skip_nls toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_hash_pat_items r acc rest
    else if str_eq c "}" || str_eq c "]" || str_eq c ")" then (rev_app acc Nil, rest, r)
    else (rev_app acc Nil, rest, toks)
  | _ -> (rev_app acc Nil, rest, toks)

and parse_whens = fn (subj: Expr) -> fn toks -> fn acc ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "when" then
      let (vs, r2) = parse_when_vals r Nil in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      parse_whens subj r3 (Cons ((vs, b), acc))
    else if str_eq id "else" then
      let _ = (match acc with
               | Nil -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: case with else but no when")) in fail "mere-ruby: case with else but no when")
               | _ -> ()) in
      let (b, r2) = parse_stmts r Nil in
      (SCase (subj, rev_app acc Nil, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCase (subj, rev_app acc Nil, Nil), r)
    else (let __fm = ("mere-ruby: expected when/else/end in case, got " ++ id ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated case" ++ parsing_file ()))) in fail ("mere-ruby: unterminated case" ++ parsing_file ()))

and parse_when_vals = fn toks -> fn (acc: Expr list) ->
  // `when *ary` splices the array's elements as candidates.
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) -> if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1) else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    // a `when` value list may wrap after the comma (`when A,\n     B then`).
    if str_eq p "," then parse_when_vals (skip_nls r2) (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// `def name(p1, p2) ... end` or `def name ... end`. Parameters are
// optional parens; the body runs until `end`.
and parse_def = fn toks ->
  // A def parsed as a command argument (`internal def m ... end`, zeitwerk)
  // inherits the caller's "nodo" flag, which is there to stop the COMMAND
  // taking a do-block. The def's own body is a new context: a do-block
  // inside it belongs to whatever it follows there.
  let had = map_has parser_flags "nodo" in
  let _ = if had then map_delete parser_flags "nodo" else () in
  let r = parse_def_inner toks in
  let _ = if had then map_set parser_flags "nodo" VNil else () in
  r

and parse_def_inner = fn toks ->
  match toks with
  // `def (expr).name; end` -- a singleton method on whatever the parenthesised
  // expression evaluates to. `def (nil).foo; end` is how the specs check that
  // defining one on nil does not make singleton_method find it. Only a bare
  // name or `self.` was accepted here, so five spec files did not parse at all.
  // The receiver is parsed and thrown away except for its shape: this supports
  // the constant / nil / true / false / self forms the corpus uses, which is
  // what a singleton class can be opened on anyway.
  | Cons (TP lp0, r0) when is_lparen lp0 ->
    (let (recv_e, r1) = parse_expr r0 in
     match r1 with
     | Cons (TP rp0, Cons (TP dot0, Cons (TId nm0, r2))) ->
       if str_eq rp0 ")" && str_eq dot0 "." then
         (let (params, defs, r3) =
            (match r2 with
             | Cons (TP p, r4) -> if is_lparen p then parse_params r4 Nil Nil else (Nil, Nil, r2)
             | _ -> (Nil, Nil, r2)) in
          // nil / true / false are singletons: there is one of each, so a
          // singleton method on one is an instance method of its class. Say
          // that directly by wrapping the def in the class body rather than
          // registering a key that resolves somewhere else -- defining a method
          // nobody can call is worse than refusing to parse.
          match recv_e with
          | ENil -> (let (d, r5) = parse_def_tail nm0 params defs r3 in (SClass ("NilClass", "", Cons (d, Nil)), r5))
          | EBool b -> (let (d, r5) = parse_def_tail nm0 params defs r3 in
                        (SClass ((if b then "TrueClass" else "FalseClass"), "", Cons (d, Nil)), r5))
          // a constant, a local or self: the receiver has a real singleton
          | EConst cn -> parse_def_tail (cn ++ "#" ++ nm0) params defs r3
          | ESelf -> parse_def_tail ("self." ++ nm0) params defs r3
          | EVar v -> parse_def_tail (v ++ "#" ++ nm0) params defs r3
          | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: def (expr).name takes a constant, a local, self, nil, true or false" ++ parsing_file ()))) in fail ("mere-ruby: def (expr).name takes a constant, a local, self, nil, true or false" ++ parsing_file ())))
       else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())))
  // operator method names: def ==, def <=>, def []=, def +, def <<, ...
  | Cons (TP op0, r0) ->
    // the lexer space-marks a bracket after "def " — same as a plain [.
    // the lexer space-marks a bracket / ampersand after "def " (` [`, ` &`);
    // normalise to the bare operator name.
    let op1 = if str_eq op0 " [" then "[" else if str_eq op0 " &" then "&" else op0 in
    let (name, r) =
      if str_eq op1 "[" then
        (match r0 with
         | Cons (TP rb2, r1) ->
           if str_eq rb2 "]" then
             (match r1 with
              | Cons (TP eq2, r2) -> if str_eq eq2 "=" then ("[]=", r2) else ("[]", r1)
              | _ -> ("[]", r1))
           else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))
         | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())))
      // `def !@` / `def !` — unary bang; normalize both to "!@".
      else if str_eq op1 "!" then
        (match r0 with
         | Cons (TId at, r1) -> if str_eq at "@" then ("!@", r1) else ("!@", r0)
         | _ -> ("!@", r0))
      // `def -@` / `def +@` — unary operator methods (op followed by @).
      else if (str_eq op1 "-" || str_eq op1 "+") &&
              (match r0 with Cons (TId at, _) -> str_len at >= 1 && str_eq (char_at at 0) "@" | _ -> false) then
        (match r0 with
         | Cons (TId at, r1) ->
           if str_eq at "@" then (op1 ++ "@", r1)
           // `-@x` lexes as the ivar @x after the op — split it back.
           else (op1 ++ "@", Cons (TId (substring at 1 (str_len at)), r1))
         | _ -> (op1 ++ "@", r0))
      else if is_op_method_name op1 then (op1, r0)
      else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ())) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) -> if is_lparen p then parse_params r3 Nil Nil else (Nil, Nil, r)
       // an operator method takes paren-less parameters too: `def []= k, v`
       // is how psych's Coder writes its setter.
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    parse_def_tail name params defs r2
  | Cons (TId name0, r0) ->
    // `def recv.name` — a singleton method. `def self.m` drops self. and
    // registers on the enclosing class/module; `def C.m` registers under
    // "C#m" so `C.m` (VClass dispatch) finds it.
    let (name, r) =
      (match r0 with
       | Cons (TP dot, r1) ->
         // `def Klass::name` is the same definition as `def Klass.name` (rexml
         // writes `def Document::entity_expansion_text_limit=(val)`).
         if str_eq dot "." || str_eq dot "::" then
           (match r1 with
            | Cons (TId n2, r2) -> if str_eq name0 "self" then ("self." ++ n2, r2) else (name0 ++ "#" ++ n2, r2)
            // def self.<< / def obj.== / def obj.[] — an operator singleton
            // method. Carry the receiver prefix like the TId case, so it
            // registers on the receiver's singleton rather than as a bare
            // top-level operator method (self. prefix for self, name# else).
            | Cons (TP op2, r2) ->
              let pfx = if str_eq name0 "self" then "self." else name0 ++ "#" in
              if str_eq op2 "[" then
                (match r2 with
                 | Cons (TP rb2, r3) ->
                   if str_eq rb2 "]" then
                     (match r3 with
                      | Cons (TP eq2, r4) -> if str_eq eq2 "=" then (pfx ++ "[]=", r4) else (pfx ++ "[]", r3)
                      | _ -> (pfx ++ "[]", r3))
                   else (name0, r0)
                 | _ -> (name0, r0))
              else if is_op_method_name op2 then (pfx ++ op2, r2)
              else (name0, r0)
            | _ -> (name0, r0))
         else (name0, r0)
       | _ -> (name0, r0)) in
    // setter definition `def x=(v)` — the `=` is part of the name. Guard
    // against endless defs `def x = (expr)` by requiring a real parameter
    // `( ident )` / `( ident ,` inside (a string desugars to `("" + ...)`).
    let (name, r) =
      (match r with
       | Cons (TP eq, r1) ->
         if str_eq eq "=" then
           (match r1 with
            | Cons (TP lp, Cons (TId _, Cons (TP rp, _))) ->
              // `=` third: the parameter has a DEFAULT (`def variables=( vars={} )`,
              // rexml). An endless def cannot reach here -- the lexer marks its
              // spaced `=` as a different token.
              if str_eq lp "(" && (str_eq rp ")" || str_eq rp "," || str_eq rp "=")
              then (name ++ "=", r1) else (name, r)
            // `def foobar=(*)` — a setter taking an anonymous splat, and
            // `def location=((a, b))` — one whose parameter destructures.
            | Cons (TP lp, Cons (TP st, _)) ->
              if str_eq lp "(" && (str_eq st "*" || str_eq st "**" || is_lparen st) then (name ++ "=", r1) else (name, r)
            // `def value= value` — a setter whose parameter has no parens. An
            // endless method cannot look like this: its body would have to be
            // a bare name followed by a newline, which is a name, not a body.
            | Cons (TId pn, r2) ->
              (if is_keyword pn then (name, r)
               else match r2 with
                    | Cons (TNL _, _) -> (name ++ "=", r1)
                    | Cons (TEOF, _) -> (name ++ "=", r1)
                    | Cons (TP semi, _) -> if str_eq semi ";" then (name ++ "=", r1) else (name, r)
                    | _ -> (name, r))
            | _ -> (name, r))
         else (name, r)
       | _ -> (name, r)) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) ->
         if is_lparen p then parse_params r3 Nil Nil
         else if str_eq p "*" || str_eq p "&" || str_eq p " &" then parse_bare_params r Nil Nil
         else (Nil, Nil, r)
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    parse_def_tail name params defs r2
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected method name after def" ++ parsing_file ()))) in fail ("mere-ruby: expected method name after def" ++ parsing_file ()))

// endless method `def name(params) = expr` — body is a single expression;
// otherwise the body runs to `end`. Operator-named defs take this path too
// (`def >>(k) = Bits.new(@n >> k)`).
and parse_def_tail = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
  (match r2 with
   | Cons (TP eq, r3) ->
     if str_eq eq "=" || str_eq eq " =" then
       let (e, r4) = parse_expr r3 in (SDef (name, params, defs, Cons (SExpr e, Nil)), r4)
     else parse_def_body name params defs r2
   | _ -> parse_def_body name params defs r2)

and is_op_method_name = fn (op: str) ->
  str_eq op "==" || str_eq op "!=" || str_eq op "<=>" || str_eq op "===" ||
  str_eq op "<" || str_eq op ">" || str_eq op "<=" || str_eq op ">=" ||
  str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/" ||
  str_eq op "%" || str_eq op "**" || str_eq op "<<" || str_eq op ">>" || str_eq op "!" ||
  str_eq op "=~" || str_eq op "!~" || str_eq op "|" || str_eq op "&" || str_eq op "^" ||
  str_eq op "~"

and parse_def_body = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
    let (body0, r4) = parse_stmts r2 Nil in
    // method-level rescue/ensure: `def f ... rescue ... end` wraps the
    // whole body in an implicit begin.
    let (body, r5) =
      (match r4 with
       | Cons (TId k, _) ->
         if str_eq k "rescue" || str_eq k "ensure" then
           let (rescues, ra) = parse_rescues r4 Nil in
           let (els, rb) = parse_opt_kw_block ra "else" in
           let (ens, rc) = parse_opt_kw_block rb "ensure" in
           (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
         else (body0, r4)
       | _ -> (body0, r4)) in
    (SDef (name, params, defs, body), expect_kw r5 "end")

// the base name of a param string, stripping *, **, & prefixes, a : suffix,
// and any `~N` uniquification suffix (so a renamed `_~1` still counts as `_`).
and pbase = fn (p: str) ->
  let p = if str_len p >= 2 && str_eq (substring p 0 2) "**" then substring p 2 (str_len p)
          else if str_len p >= 1 && (str_eq (char_at p 0) "*" || str_eq (char_at p 0) "&") then substring p 1 (str_len p)
          else if str_len p >= 1 && str_eq (char_at p (str_len p - 1)) ":" then substring p 0 (str_len p - 1)
          else p in
  str_before_char p "~" 0
and str_before_char = fn (s: str) -> fn (ch: str) -> fn (i: int) ->
  if i >= str_len s then s
  else if str_eq (char_at s i) ch then substring s 0 i
  else str_before_char s ch (i + 1)
and pcount_base = fn (acc: str list) -> fn (base: str) ->
  match acc with Nil -> 0 | Cons (h, t) -> (if str_eq (pbase h) base then 1 else 0) + pcount_base t base
// Ruby allows the ignore-name `_` to repeat in a parameter list; give each
// repeat a unique internal storage key (first keeps the bare `_`) so they bind
// to distinct slots and a bare `super` forwards them positionally. Other
// duplicate names are a SyntaxError in Ruby, so they are left untouched.
and uniq_param = fn (name: str) -> fn (acc: str list) ->
  if (if str_eq (pbase name) "_" then true else false) && pcount_base acc "_" > 0 then
    (let u = "_~" ++ str_of_int (pcount_base acc "_") in
     if str_len name >= 2 && str_eq (substring name 0 2) "**" then "**" ++ u
     else if str_len name >= 1 && (str_eq (char_at name 0) "*" || str_eq (char_at name 0) "&") then substring name 0 1 ++ u
     else if str_len name >= 1 && str_eq (char_at name (str_len name - 1)) ":" then u ++ ":"
     else u)
  else name

and parse_params = fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  // a parenthesised parameter list may wrap across lines, so newlines inside
  // it are not statement separators (`def m(a,\n  b: 1)`). The paren-less form
  // below is the opposite: there a newline ends the list.
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (rev_app acc Nil, rev_app defs Nil, r)
    else if str_eq p "*" then
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("*" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "*" r acc defs)
    else if str_eq p "&" then
      // &block capture: stored as "&name"; a bare & (anonymous forwarding)
      // gets a hidden name so `c(&)` can re-pass it.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("&" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "&__anonblk" r acc defs)
    else if str_eq p "**" then
      // **kwargs collects the trailing keyword hash.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("**" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "**" r acc defs)
    else if str_eq p "..." then
      // argument forwarding: `def m(...)` collects positional args in *__fwd
      // and the block in the same anonymous slot `def m(&)` uses, so `m(...)`
      // forwards a block when there is one and stays block-less when there
      // is not (which is what an earlier &__fwdblk attempt got wrong).
      parse_params_after "&__anonblk" r (Cons ("*__fwd", acc)) defs
    else if is_lparen p then
      // nested destructuring `def m((a, b))` — encoded as a spec string,
      // bound the same way as a block's |(a, b)|.
      let (spec, r2) = pipe_group r "" in
      parse_params_after ("(" ++ spec ++ ")") r2 acc defs
    else (let __fm = ("mere-ruby: expected parameter name, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TId name, r) ->
    // optional default `name = expr`; keyword param `name:` / `name: default`
    // (stored as "name:" in the param list, bound from the trailing hash).
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // optional `name = expr`: uniquify a duplicate `_` and key the default
         // under the SAME unique name so it stays associated with this position.
         let un = uniq_param name acc in
         // the default may start on the NEXT line -- addressable writes
         // `def self.normalize_component(component, character_class=\n  CONST,`
         let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs))
       else if str_eq eq ":" then
         let un = uniq_param (name ++ ":") acc in
         (match skip_nls r2 with
          | Cons (TP q, _) -> if str_eq q "," || str_eq q ")" then parse_params_after un r2 acc defs
                              else let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs))
          | _ -> let (e, r3) = parse_expr (skip_nls r2) in parse_params_after un r3 acc (Cons ((un, e), defs)))
       else parse_params_after (uniq_param name acc) r acc defs
     | _ -> parse_params_after (uniq_param name acc) r acc defs)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected parameter name" ++ parsing_file ()))) in fail ("mere-ruby: expected parameter name" ++ parsing_file ()))

and parse_params_after = fn (name: str) -> fn toks0 -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_params r (Cons (name, acc)) defs
    else if str_eq p ")" then (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, r)
    else (let __fm = ("mere-ruby: expected , or ) in parameters, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: unterminated parameter list" ++ parsing_file ()))) in fail ("mere-ruby: unterminated parameter list" ++ parsing_file ()))

// paren-less method params: `def m a, o=1, *r, &b` — terminated by newline
// (any non-comma token) rather than `)`.
and parse_bare_params = fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "*" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("*" ++ n) r2 acc defs
                  | _ -> parse_bare_after "*" r acc defs)
    else if str_eq p "&" || str_eq p " &" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("&" ++ n) r2 acc defs
                  | _ -> parse_bare_after "&" r acc defs)
    else if str_eq p "**" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("**" ++ n) r2 acc defs
                  | _ -> parse_bare_after "**" r acc defs)
    else if str_eq p "..." then parse_bare_after "&__anonblk" r (Cons ("*__fwd", acc)) defs
    else (let __fm = ("mere-ruby: expected parameter name, got " ++ p ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  | Cons (TId name, r) ->
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let (e, r3) = parse_expr r2 in parse_bare_after name r3 acc (Cons ((name, e), defs))
       // keyword parameter `name:` / `name: default`, encoded exactly as the
       // parenthesised form does ("name:" in the list, default keyed under
       // it). `def initialize class_loader, strict_integer: false` -- psych.
       else if str_eq eq ":" then
         let kn = name ++ ":" in
         (match r2 with
          | Cons (TP q, _) -> if str_eq q "," then parse_bare_after kn r2 acc defs
                              else let (e, r3) = parse_expr r2 in parse_bare_after kn r3 acc (Cons ((kn, e), defs))
          // `def m a, k:` with no default: the list ends at the newline.
          | Cons (TNL _, _) -> parse_bare_after kn r2 acc defs
          | _ -> let (e, r3) = parse_expr r2 in parse_bare_after kn r3 acc (Cons ((kn, e), defs)))
       else parse_bare_after name r acc defs
     | _ -> parse_bare_after name r acc defs)
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: expected parameter name" ++ parsing_file ()))) in fail ("mere-ruby: expected parameter name" ++ parsing_file ()))

and parse_bare_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_bare_params r (Cons (name, acc)) defs
    else (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks)
  | _ -> (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks);

// ---- evaluator -----------------------------------------------------------
// Ruby truthiness: only nil and false are falsy. 0 and "" are truthy.
let truthy = fn (v: Val) ->
  match v with
  | VNil -> false
  | VBool b -> b
  | _ -> true;

let to_f = fn (v: Val) ->
  match v with
  | VInt n -> float_of_int n
  | VFlt f -> f
  | VBig s -> float_of_str s
  | VRat (n, d) -> float_of_str n / float_of_str d
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: not a number")) in fail "mere-ruby: not a number");

let is_num = fn (v: Val) ->
  match v with VInt _ -> true | VFlt _ -> true | _ -> false;

let feq = fn (x: float) -> fn (y: float) -> x <= y && y <= x;

// Ruby integer division floors toward negative infinity (-7 / 2 == -4)
// and modulo takes the sign of the divisor (-7 % 3 == 2). Mere's native
// / and % truncate toward zero (C semantics), so correct after the fact.
let floor_div = fn (a: int) -> fn (b: int) ->
  if b == 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: divided by 0")) in fail "mere-ruby: divided by 0")
  else
    let q = a / b in
    let r = a - q * b in
    if r != 0 && (if r < 0 then b > 0 else b < 0) then q - 1 else q;

let floor_mod = fn (a: int) -> fn (b: int) -> a - (floor_div a b) * b;

// integer shifts by repeated doubling / halving (floor semantics). A
// negative shift count reverses direction (x << -n == x >> n).
let rec shl_int = fn (x: int) -> fn (n: int) ->
  if n == 0 then x
  else if n < 0 then shr_int_pos x (0 - n)
  else shl_int (x * 2) (n - 1)
and shr_int = fn (x: int) -> fn (n: int) ->
  if n == 0 then x
  else if n < 0 then shl_int_pos x (0 - n)
  else shr_int_pos x n
and shl_int_pos = fn (x: int) -> fn (n: int) ->
  if n <= 0 then x else shl_int_pos (x * 2) (n - 1)
and shr_int_pos = fn (x: int) -> fn (n: int) ->
  if n <= 0 then x else shr_int_pos (floor_div x 2) (n - 1);

let rec pow_int = fn (b: int) -> fn (e: int) ->
  if e < 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: negative integer exponent unsupported in M0")) in fail "mere-ruby: negative integer exponent unsupported in M0")
  else if e == 0 then 1
  else b * pow_int b (e - 1);

let rec pow_flt = fn (b: float) -> fn (e: int) ->
  if e < 0 then 1.0 / pow_flt b (0 - e)
  else if e == 0 then 1.0
  else b * pow_flt b (e - 1);

let rec rb_eq = fn (va: Val) -> fn (vb: Val) ->
  match va with
  | VInt x ->
    (match vb with
     | VInt y -> x == y
     | VFlt y -> feq (float_of_int x) y
     | VRat (n, d) -> str_eq d "1" && str_eq n (str_of_int x)
     | _ -> false)
  | VFlt x ->
    (match vb with
     | VInt y -> feq x (float_of_int y)
     | VFlt y -> feq x y
     | _ -> false)
  // canonical form: a VBig never equals a VInt; two VBig equal iff same string.
  | VBig x -> (match vb with VBig y -> str_eq x y | _ -> false)
  | VRat (n, d) -> (match vb with VRat (n2, d2) -> str_eq n n2 && str_eq d d2 | VInt m -> str_eq d "1" && str_eq n (str_of_int m) | VFlt f -> feq (float_of_str n / float_of_str d) f | _ -> false)
  | VCpx (r, i) -> (match vb with VCpx (r2, i2) -> rb_eq r r2 && rb_eq i i2 | VInt m -> rb_eq i (VInt 0) && rb_eq r (VInt m) | _ -> false)
  | VStr x -> let x = sget x in (match vb with VStr y -> let y = sget y in str_eq x y | _ -> false)
  | VBool x ->
    (match vb with
     | VBool y -> if x then y else (if y then false else true)
     | _ -> false)
  | VNil -> (match vb with VNil -> true | _ -> false)
  | VArr x -> (match vb with VArr y -> if x == y then true else eq_list (deref x) (deref y) | _ -> false)
  | VHsh xs -> let xs = hderef xs in (match vb with VHsh ys -> let ys = hderef ys in hash_eq_unordered xs ys | _ -> false)
  // object identity (same handle); classes and symbols by value.
  | VObj x -> (match vb with VObj y -> x == y | _ -> false)
  | VClass x -> (match vb with VClass y -> str_eq x y | _ -> false)
  | VSym x -> (match vb with VSym y -> str_eq x y | _ -> false)
  | VRange (a, b, c) ->
    (match vb with
     | VRange (d, e, f) -> rb_eq a d && rb_eq b e && (if c then f else (if f then false else true))
     | _ -> false)
  | VExc (c, m) -> (match vb with VExc (d, n) -> str_eq c d && str_eq m n | _ -> false)
  | VMain -> (match vb with VMain -> true | _ -> false)
  // regexes / procs / bindings compare by pattern text / handle identity (and
  // never equal a different kind) — without these arms rb_eq is non-exhaustive
  // and aborts when a regex/proc reaches it (e.g. a `^regex` pin).
  | VRegex (p, pf) -> (match vb with VRegex (q, qf) -> str_eq p q && str_eq pf qf | _ -> false)
  | VProc x -> (match vb with VProc y -> x == y | _ -> false)
  | VBind x -> (match vb with VBind y -> x == y | _ -> false)

and eq_list = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (match ys with Nil -> true | _ -> false)
  | Cons (h, t) ->
    (match ys with
     | Nil -> false
     | Cons (h2, t2) -> rb_eq h h2 && eq_list t t2)
// Hash#== is order-insensitive: same size and every key maps to an equal
// value (both are flat [k,v,k,v,...] lists; keys are unique in a hash).
and hlookup_eq = fn (ys: Val list) -> fn (k: Val) ->
  match ys with
  | Cons (yk, Cons (yv, rest)) -> if rb_eq k yk then Cons (yv, Nil) else hlookup_eq rest k
  | _ -> Nil
and hash_eq_go = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Cons (k, Cons (v, rest)) ->
    (match hlookup_eq ys k with Cons (yv, _) -> if rb_eq v yv then hash_eq_go rest ys else false | _ -> false)
  | _ -> true
and vllen = fn (xs: Val list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + vllen t
and hash_eq_unordered = fn (xs: Val list) -> fn (ys: Val list) ->
  if vllen xs == vllen ys then hash_eq_go xs ys else false;

// numeric / string ordering: negative | zero | positive like a compare fn.
// ---- bignum: schoolbook arithmetic on canonical decimal strings ----------
// magnitude = bare digit string, no leading zeros ("0" for zero).
let rec mag_strip = fn (s: str) -> fn (i: int) ->
  if i >= str_len s - 1 then substring s i (str_len s)
  else if str_eq (char_at s i) "0" then mag_strip s (i + 1)
  else substring s i (str_len s);
let mag_cmp = fn (a: str) -> fn (b: str) ->
  let la = str_len a in let lb = str_len b in
  if la < lb then 0 - 1 else if la > lb then 1 else str_compare a b;
let rec zeros = fn (n: int) -> if n <= 0 then "" else "0" ++ zeros (n - 1);

let rec mag_add_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (carry: int) -> fn (acc: str) ->
  let la = str_len a in let lb = str_len b in
  if i >= la && i >= lb && carry == 0 then (if str_eq acc "" then "0" else acc)
  else
    let da = if i < la then ord (char_at a (la - 1 - i)) - 48 else 0 in
    let db = if i < lb then ord (char_at b (lb - 1 - i)) - 48 else 0 in
    let s = da + db + carry in
    mag_add_go a b (i + 1) (s / 10) (chr (s - (s / 10) * 10 + 48) ++ acc);
let mag_add = fn (a: str) -> fn (b: str) -> mag_add_go a b 0 0 "";

// a - b, assuming a >= b (magnitudes).
let rec mag_sub_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (borrow: int) -> fn (acc: str) ->
  let la = str_len a in let lb = str_len b in
  if i >= la then acc
  else
    let da = ord (char_at a (la - 1 - i)) - 48 in
    let db = (if i < lb then ord (char_at b (lb - 1 - i)) - 48 else 0) + borrow in
    let d = da - db in
    let d2 = if d < 0 then d + 10 else d in
    let nb = if d < 0 then 1 else 0 in
    mag_sub_go a b (i + 1) nb (chr (d2 + 48) ++ acc);
let mag_sub = fn (a: str) -> fn (b: str) -> mag_strip (mag_sub_go a b 0 0 "") 0;

// magnitude a times a single digit d (0..9).
let rec mag_mul1_go = fn (a: str) -> fn (d: int) -> fn (i: int) -> fn (carry: int) -> fn (acc: str) ->
  let la = str_len a in
  if i >= la then (if carry == 0 then acc else str_of_int carry ++ acc)
  else let da = ord (char_at a (la - 1 - i)) - 48 in
       let p = da * d + carry in
       mag_mul1_go a d (i + 1) (p / 10) (chr (p - (p / 10) * 10 + 48) ++ acc);
let mag_mul1 = fn (a: str) -> fn (d: int) -> if d == 0 then "0" else mag_mul1_go a d 0 0 "";
let rec mag_mul_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len b then acc
  else
    let d = ord (char_at b (str_len b - 1 - i)) - 48 in
    let partial = mag_strip (mag_mul1 a d) 0 ++ zeros i in
    mag_mul_go a b (i + 1) (mag_add acc (mag_strip partial 0));
let mag_mul = fn (a: str) -> fn (b: str) -> mag_strip (mag_mul_go a b 0 "0") 0;

// signed decimal strings ("-" prefix). sign/magnitude accessors.
let big_sign = fn (s: str) -> if str_len s > 0 && str_eq (char_at s 0) "-" then 0 - 1 else 1;
let big_mag = fn (s: str) -> if str_len s > 0 && str_eq (char_at s 0) "-" then substring s 1 (str_len s) else s;
let with_sign = fn (sgn: int) -> fn (mag: str) ->
  if str_eq mag "0" then "0" else if sgn < 0 then "-" ++ mag else mag;

let big_add_s = fn (a: str) -> fn (b: str) ->
  let sa = big_sign a in let sb = big_sign b in
  let ma = big_mag a in let mb = big_mag b in
  if sa == sb then with_sign sa (mag_add ma mb)
  else
    let c = mag_cmp ma mb in
    if c == 0 then "0"
    else if c > 0 then with_sign sa (mag_sub ma mb)
    else with_sign sb (mag_sub mb ma);
let big_neg_s = fn (a: str) -> if str_eq a "0" then "0" else if big_sign a < 0 then big_mag a else "-" ++ a;
let big_sub_s = fn (a: str) -> fn (b: str) -> big_add_s a (big_neg_s b);
let big_mul_s = fn (a: str) -> fn (b: str) -> with_sign (big_sign a * big_sign b) (mag_mul (big_mag a) (big_mag b));
let rec big_pow = fn (base: str) -> fn (e: int) -> fn (acc: str) ->
  if e <= 0 then acc else big_pow base (e - 1) (big_mul_s acc base);

// schoolbook long division of magnitudes: returns (quotient, remainder).
let rec mag_find_k = fn (b: str) -> fn (cur: str) -> fn (k: int) ->
  if k <= 0 then 0
  else if mag_cmp (mag_mul1 b k) cur <= 0 then k
  else mag_find_k b cur (k - 1);
let rec mag_dm_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (cur: str) -> fn (q: str) ->
  if i >= str_len a then (mag_strip q 0, mag_strip cur 0)
  else
    let cur2 = mag_strip (cur ++ char_at a i) 0 in
    let k = mag_find_k b cur2 9 in
    let cur3 = mag_sub cur2 (mag_strip (mag_mul1 b k) 0) in
    mag_dm_go a b (i + 1) cur3 (q ++ chr (k + 48));
let mag_divmod = fn (a: str) -> fn (b: str) -> mag_dm_go a b 0 "" "";

// signed divmod with Ruby semantics (quotient floors toward -inf; remainder
// takes the divisor's sign). Returns (quotient, remainder) as decimal strings.
let big_divmod_s = fn (a: str) -> fn (b: str) ->
  let dm = mag_divmod (big_mag a) (big_mag b) in
  let mq = (match dm with (q, r) -> q) in
  let mr = (match dm with (q, r) -> r) in
  let sa = big_sign a in let sb = big_sign b in
  let qt = with_sign (sa * sb) mq in
  let rt = with_sign sa mr in
  if str_eq mr "0" then (qt, "0")
  else if sa == sb then (qt, rt)
  else (big_sub_s qt "1", big_add_s rt b);
let big_div_s = fn (a: str) -> fn (b: str) -> (match big_divmod_s a b with (q, r) -> q);
let big_mod_s = fn (a: str) -> fn (b: str) -> (match big_divmod_s a b with (q, r) -> r);
let big_cmp_s = fn (a: str) -> fn (b: str) ->
  let sa = big_sign a in let sb = big_sign b in
  if sa < sb then 0 - 1 else if sa > sb then 1
  else (let c = mag_cmp (big_mag a) (big_mag b) in if sa < 0 then 0 - c else c);

// ---- Rational (num/den as canonical decimal strings, den > 0, reduced) ----
// bignum gcd of the magnitudes of a, b (Euclid), as a positive canonical string.
let rec big_gcd_s = fn (a: str) -> fn (b: str) ->
  let a = big_mag a in let b = big_mag b in
  if str_eq b "0" then (if str_eq a "" then "0" else a)
  else big_gcd_s b (big_mod_s a b);
// build a reduced Rational from num/den strings (den != 0).
let mk_rat_s = fn (n: str) -> fn (d: str) ->
  let nm = mag_strip (big_mag n) 0 in let dm = mag_strip (big_mag d) 0 in
  if str_eq dm "0" then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: divided by 0")) in fail "mere-ruby: divided by 0")
  else
    let sgn = big_sign n * big_sign d in
    let g = big_gcd_s nm dm in
    let g = if str_eq g "0" then "1" else g in
    let nr = big_div_s nm g in let dr = big_div_s dm g in
    VRat (with_sign sgn nr, dr);
let mk_rat = fn (n: int) -> fn (d: int) -> mk_rat_s (str_of_int n) (str_of_int d);
let rat_to_f = fn (n: str) -> fn (d: str) -> float_of_str n / float_of_str d;
let rat_add_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_add_s (big_mul_s an bd) (big_mul_s bn ad)) (big_mul_s ad bd);
let rat_sub_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_sub_s (big_mul_s an bd) (big_mul_s bn ad)) (big_mul_s ad bd);
let rat_mul_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_mul_s an bn) (big_mul_s ad bd);
let rat_div_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_mul_s an bd) (big_mul_s ad bn);
// compare an/ad vs bn/bd (dens > 0): sign of an*bd - bn*ad.
let rat_cmp_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> big_cmp_s (big_mul_s an bd) (big_mul_s bn ad);
// +,-,*,/ when at least one operand is Rational (others Int/Rat/Float).
let rat_arith = fn (op: str) -> fn (va: Val) -> fn (vb: Val) ->
  let vaf = (match va with VFlt _ -> true | _ -> false) in
  let vbf = (match vb with VFlt _ -> true | _ -> false) in
  if vaf || vbf then
    (let x = to_f va in let y = to_f vb in
     if str_eq op "+" then VFlt (x + y) else if str_eq op "-" then VFlt (x - y)
     else if str_eq op "*" then VFlt (x * y) else VFlt (x / y))
  else
    let an = (match va with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
    let ad = (match va with VRat (n, d) -> d | _ -> "1") in
    let bn = (match vb with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
    let bd = (match vb with VRat (n, d) -> d | _ -> "1") in
    if str_eq op "+" then rat_add_s an ad bn bd
    else if str_eq op "-" then rat_sub_s an ad bn bd
    else if str_eq op "*" then rat_mul_s an ad bn bd
    else rat_div_s an ad bn bd;

// does a magnitude fit in a signed 64-bit int?
let big_fits = fn (mag: str) ->
  str_len mag < 19 || (str_len mag == 19 && str_compare mag "9223372036854775807" <= 0);
// canonicalise a signed decimal string to VInt (if it fits) or VBig.
let norm_big = fn (sval: str) ->
  let m = mag_strip (big_mag sval) 0 in
  let sgn = if str_eq m "0" then 1 else big_sign sval in
  let canon = with_sign sgn m in
  if big_fits m then VInt (int_of_str canon) else VBig canon;
// signed decimal of a numeric value.
let num_dec = fn (v: Val) -> match v with VInt n -> str_of_int n | VBig s -> s | _ -> "0";

// The denominator a Complex's two parts share, and either part scaled onto it.
// `Complex(1/2r, 1/3r).numerator` is `(3+2i)` over a denominator of 6: the parts
// are put over their lcm, which is what makes the pair reconstruct the value.
let rat_den_of = fn (v: Val) -> match v with VRat (n, d) -> d | _ -> "1";
let rat_num_of = fn (v: Val) -> match v with VRat (n, d) -> n | VInt n -> str_of_int n | VBig b -> b | _ -> "0";
let cpx_common_den = fn (a: Val) -> fn (b: Val) ->
  let da = rat_den_of a in let db = rat_den_of b in
  // lcm(da, db) = da * db / gcd
  big_div_s (big_mul_s da db) (big_gcd_s da db);
let num_scale_to = fn (v: Val) -> fn (den: str) ->
  norm_big (big_mul_s (rat_num_of v) (big_div_s den (rat_den_of v)));

// Rational's rounding family, as ONE function over the four modes. The
// denominator is positive and the sign lives in the numerator (mk_rat_s
// normalizes both), and big_divmod_s already floors toward -infinity with the
// remainder taking the divisor's sign -- which is Ruby's integer division --
// so `floor` is the division itself and the other three are one step from it.
// `round` is half AWAY FROM ZERO (ruby: (1/2r).round == 1, (-1/2r).round == -1),
// which is why it is computed on the magnitude and given the sign back rather
// than by adding a half and flooring.
let rat_int_mode = fn (mode: str) -> fn (n: str) -> fn (d: str) ->
  if str_eq mode "round" then
    (let sg = big_sign n in
     let m = big_mag n in
     let q = big_div_s (big_add_s (big_mul_s m "2") d) (big_mul_s d "2") in
     with_sign sg q)
  else
    (let dm = big_divmod_s n d in
     let q = (match dm with (q, r) -> q) in
     let r = (match dm with (q, r) -> r) in
     if str_eq mode "floor" then q
     else if str_eq mode "ceil" then (if str_eq r "0" then q else big_add_s q "1")
     // truncate: toward zero, so a negative with a remainder is one above floor
     else (if str_eq r "0" then q
           else if big_sign n < 0 then big_add_s q "1" else q));
// The precision form. ruby answers an INTEGER for precision <= 0 and a
// RATIONAL for precision > 0 -- `Rational(1,3).ceil(2)` is `(17/50)`, not 0.34 --
// so the two cases return different classes on purpose.
// How many decimal places make n/d EXACT, or -1 when it never terminates:
// strip the 2s and 5s from the denominator and see whether anything is left.
// (1/2 needs 1 place, 1/8 needs 3, 1/3 never terminates.) Rounding a rational
// to more places than it needs cannot change it, which is the only reason
// `Rational(3,2).round(2_097_171)` can answer at all -- ruby/spec asks for
// exactly that (issue #6605), and computing 10**2097171 to find out is not an
// answer, it is a hang.
let rec rat_strip_25 = fn (d: str) -> fn (c2: int) -> fn (c5: int) ->
  (match big_divmod_s d "2" with
   | (q, r) -> if str_eq r "0" then rat_strip_25 q (c2 + 1) c5
               else (match big_divmod_s d "5" with
                     | (q5, r5) -> if str_eq r5 "0" then rat_strip_25 q5 c2 (c5 + 1)
                                   else (d, c2, c5)));
let rat_exact_digits = fn (d: str) ->
  match rat_strip_25 d 0 0 with
  | (rest, c2, c5) -> if str_eq rest "1" then (if c2 > c5 then c2 else c5) else 0 - 1;
let rat_round_prec = fn (mode: str) -> fn (n: str) -> fn (d: str) -> fn (p: int) ->
  if p == 0 then norm_big (rat_int_mode mode n d)
  else if p > 0 then
    (let need = rat_exact_digits d in
     if need >= 0 && p >= need then VRat (n, d)
     else
       let m = big_pow "10" p "1" in
       mk_rat_s (rat_int_mode mode (big_mul_s n m) d) m)
  else
    (let m = big_pow "10" (0 - p) "1" in
     norm_big (big_mul_s (rat_int_mode mode n (big_mul_s d m)) m));

// ---- the simplest rational in an interval --------------------------------
// `rationalize` is NOT to_r: ruby answers the SIMPLEST fraction within the
// value's precision, so 0.3.rationalize is (3/10) where 0.3.to_r is
// (5404319552844595/18014398509481984). That is a defined algorithm -- the
// continued-fraction descent through the Stern-Brocot tree -- not an
// approximation, which is why it can be implemented exactly instead of guessed.
//
// Rationals here are (numerator, denominator) pairs of decimal strings with a
// positive denominator, so each step is big-integer arithmetic.
let rq_norm = fn (n: str) -> fn (d: str) ->
  let g = big_gcd_s (big_mag n) (big_mag d) in
  let g = (if str_eq g "0" then "1" else g) in
  let sgn = big_sign n * big_sign d in
  (with_sign sgn (big_mag (big_div_s n g)), big_mag (big_div_s d g));
// a/b - c/d, and 1/(a/b)
let rq_sub = fn (a: (str * str)) -> fn (b: (str * str)) ->
  (match a with (an, ad) -> (match b with (bn, bd) ->
    rq_norm (big_sub_s (big_mul_s an bd) (big_mul_s bn ad)) (big_mul_s ad bd)));
let rq_recip = fn (a: (str * str)) ->
  (match a with (an, ad) -> rq_norm ad an);
// ceil(a/b) for a positive denominator: floor plus one unless it divides evenly
let rq_ceil = fn (a: (str * str)) ->
  (match a with (an, ad) ->
    let q = big_div_s an ad in
    if str_eq (big_mod_s an ad) "0" then q else big_add_s q "1");
let rq_lt_int = fn (c: str) -> fn (b: (str * str)) ->
  (match b with (bn, bd) -> big_cmp_s (big_mul_s c bd) bn < 0);

// The interval [a, b] with 0 < a <= b; answers the simplest p/q inside it.
// This is ruby's nurat_rationalize_internal, term for term.
let rec rq_simplest = fn (a: (str * str)) -> fn (b: (str * str)) ->
             fn (p0: str) -> fn (q0: str) -> fn (p1: str) -> fn (q1: str) -> fn (fuel: int) ->
  let c = rq_ceil a in
  if fuel <= 0 || rq_lt_int c b then
    (big_add_s (big_mul_s c p1) p0, big_add_s (big_mul_s c q1) q0)
  else
    let k = big_sub_s c "1" in
    let p2 = big_add_s (big_mul_s k p1) p0 in
    let q2 = big_add_s (big_mul_s k q1) q0 in
    let a2 = rq_recip (rq_sub b (k, "1")) in
    let b2 = rq_recip (rq_sub a (k, "1")) in
    rq_simplest a2 b2 p1 q1 p2 q2 (fuel - 1);

// Drive rq_simplest over a signed interval: the descent needs 0 < a <= b, so
// a wholly negative interval is searched mirrored and the sign put back.
let rq_answer = fn (bounds: ((str * str) * (str * str))) ->
  (match bounds with (lo, hi) ->
    let neg = (match lo with (n, d) -> big_sign n < 0) in
    let hineg = (match hi with (n, d) -> big_sign n < 0) in
    // an interval that spans zero contains 0, and 0 is the simplest thing in it
    if neg && (if hineg then false else true) then mk_rat_s "0" "1"
    else if neg then
      (let lo2 = (match hi with (n, d) -> (big_neg_s n, d)) in
       let hi2 = (match lo with (n, d) -> (big_neg_s n, d)) in
       match rq_simplest lo2 hi2 "0" "1" "1" "0" 4096 with
       | (pn, qd) -> mk_rat_s (big_neg_s pn) qd)
    else (match rq_simplest lo hi "0" "1" "1" "0" 4096 with
          | (pn, qd) -> mk_rat_s pn qd));

// ---- integer shifts, total over the int64 boundary ----------------------
// A shift is arithmetic: `x << n` is x * 2**n, `x >> n` is x floor-divided by
// 2**n. big_divmod_s already floors, which is what makes the negative cases
// (`-1 >> 1 == -1`) agree with ruby for free.
//
// Going through the bignum path is what makes them TOTAL. Before this,
// `(2**64) >> 3` raised "type error" -- and `1 << 64` returned **0**, and
// `1 << 63` returned a negative number, because shl_int wraps at 64 bits.
// The silent wrong answer is the worse of the two: nothing in a program that
// stays under 2**63 can ever show it.
let two_pow_s = fn (n: int) -> big_pow "2" n "1";
let shl_big = fn (va: Val) -> fn (n: int) -> norm_big (big_mul_s (num_dec va) (two_pow_s n));
let shr_big = fn (va: Val) -> fn (n: int) -> norm_big (big_div_s (num_dec va) (two_pow_s n));

// The native fast path, guarded by a ROUND TRIP rather than by a bit count:
// shifting back has to give the operand again. `int_bit_length` is defined
// further down the file, and a hand-written bound would be a claim about
// shl_int's overflow rather than a check of it.
let shl_int_fits = fn (x: int) -> fn (n: int) ->
  n >= 0 && n < 62 && shr_int (shl_int x n) n == x;
// the exact numerator/denominator of a value, as decimal strings. A float is
// doubled until it is integral, which is exact: 2.54 becomes
// 2.54*2^k over 2^k. Beyond 62 doublings the numerator would leave int64,
// so those (subnormals) fall back to truncation.
let rec flt_rat_parts = fn (f: float) -> fn (k: int) ->
  if k >= 62 || f == float_of_int (int_of_float f) then (str_of_int (int_of_float f), big_pow "2" k "1")
  else flt_rat_parts (f * 2.0) (k + 1);
// a value as an exact (numerator, denominator) pair
let rat_pair_of = fn (v: Val) -> match v with
  | VRat (n, d) -> (n, d)
  | VInt n -> (str_of_int n, "1")
  | VBig b -> (b, "1")
  | VFlt f -> flt_rat_parts f 0
  | _ -> ("0", "1");
let flt_pair = fn (f: float) -> flt_rat_parts f 0;
// the midpoint of two exact rationals, exactly
let rat_mid = fn (a: (str * str)) -> fn (b: (str * str)) ->
  (match a with (an, ad) -> (match b with (bn, bd) ->
    rq_norm (big_add_s (big_mul_s an bd) (big_mul_s bn ad)) (big_mul_s (big_mul_s ad bd) "2")));

// "3/4" / "2.5" / "7" — the forms Rational() accepts as a string.
let str_rat_parts = fn (s: str) ->
  let i = str_index_of s "/" in
  if i >= 0 then (str_trim (substring s 0 i), str_trim (substring s (i + 1) (str_len s)))
  else (let j = str_index_of s "." in
        if j < 0 then (str_trim s, "1")
        else let ip = substring s 0 j in
             let fp = substring s (j + 1) (str_len s) in
             (ip ++ fp, big_pow "10" (str_len fp) "1"));
let rat_parts = fn (v: Val) ->
  match v with
  | VInt n -> (str_of_int n, "1")
  | VBig s -> (s, "1")
  | VRat (n, d) -> (n, d)
  | VFlt f -> flt_rat_parts f 0
  | VStr h -> str_rat_parts (sget h)
  | _ -> ("0", "1");
// parity of a bignum from its last decimal digit.
let big_even = fn (s: str) ->
  let c = char_at s (str_len s - 1) in
  str_eq c "0" || str_eq c "2" || str_eq c "4" || str_eq c "6" || str_eq c "8";
// negate / sign / abs on a boxed numeric value (used by Complex components).
let num_neg = fn (v: Val) -> match v with
  | VInt n -> VInt (0 - n) | VFlt f -> VFlt (f * (0.0 - 1.0))
  | VBig s -> norm_big (big_neg_s s) | VRat (n, d) -> VRat (big_neg_s n, d) | _ -> v;
let num_isneg = fn (v: Val) -> match v with
  | VInt n -> n < 0 | VFlt f -> f < 0.0 | VBig s -> big_sign s < 0 | VRat (n, d) -> big_sign n < 0 | _ -> false;
let num_abs = fn (v: Val) -> if num_isneg v then num_neg v else v;
// +,-,* on two boxed numerics: exact int when both are VInt, else via float.
let num_bin = fn (o: str) -> fn (x: Val) -> fn (y: Val) ->
  match x with
  | VInt a -> (match y with
     | VInt b -> if str_eq o "+" then VInt (a + b) else if str_eq o "-" then VInt (a - b) else VInt (a * b)
     | _ -> let fa = float_of_int a in let fb = to_f y in
            if str_eq o "+" then VFlt (fa + fb) else if str_eq o "-" then VFlt (fa - fb) else VFlt (fa * fb))
  | _ -> let fa = to_f x in let fb = to_f y in
         if str_eq o "+" then VFlt (fa + fb) else if str_eq o "-" then VFlt (fa - fb) else VFlt (fa * fb);
// component arithmetic inside a Complex: Rational components stay exact
// (num_bin would fall back to float).
let cpx_comp = fn (op: str) -> fn (x: Val) -> fn (y: Val) ->
  if (match x with VRat _ -> true | _ -> false) || (match y with VRat _ -> true | _ -> false)
  then rat_arith op x y
  else num_bin op x y;
// component quo for Complex division: exact (Rational) for non-floats, and
// a den-1 Rational canonicalizes back to an integer (CRuby's f_divide does
// this — bare 2.quo(2) stays (1/1), but Complex(4,2)/2 is (2+1i)).
let cpx_quo = fn (x: Val) -> fn (y: Val) ->
  if (match x with VFlt _ -> true | _ -> false) || (match y with VFlt _ -> true | _ -> false)
  then VFlt (to_f x / to_f y)
  else
    let xr = (match x with VRat _ -> x | VInt n -> mk_rat n 1 | VBig b -> mk_rat_s b "1" | v -> v) in
    (match rat_arith "/" xr y with
     | VRat (n, d) -> if str_eq d "1" then norm_big n else VRat (n, d)
     | v -> v);
// +,-,*,/ when at least one operand is Complex (components are boxed numerics).
let cpx_arith = fn (op: str) -> fn (va: Val) -> fn (vb: Val) ->
  let ar = (match va with VCpx (r, i) -> r | v -> v) in
  let ai = (match va with VCpx (r, i) -> i | _ -> VInt 0) in
  let br = (match vb with VCpx (r, i) -> r | v -> v) in
  let bi = (match vb with VCpx (r, i) -> i | _ -> VInt 0) in
  if str_eq op "+" then VCpx (cpx_comp "+" ar br, cpx_comp "+" ai bi)
  else if str_eq op "-" then VCpx (cpx_comp "-" ar br, cpx_comp "-" ai bi)
  else if str_eq op "*" then VCpx (cpx_comp "-" (cpx_comp "*" ar br) (cpx_comp "*" ai bi), cpx_comp "+" (cpx_comp "*" ar bi) (cpx_comp "*" ai br))
  else if str_eq op "/" then
    (match bi with
     // a real divisor divides each component independently (CRuby does the
     // same, so an integer component stays exact next to a float one).
     | VInt 0 -> VCpx (cpx_quo ar br, cpx_quo ai br)
     | _ ->
       // (a+bi)/(c+di) = ((ac+bd) + (bc-ad)i) / (c^2+d^2), per-component quo.
       let den = cpx_comp "+" (cpx_comp "*" br br) (cpx_comp "*" bi bi) in
       VCpx (cpx_quo (cpx_comp "+" (cpx_comp "*" ar br) (cpx_comp "*" ai bi)) den,
             cpx_quo (cpx_comp "-" (cpx_comp "*" ai br) (cpx_comp "*" ar bi)) den))
  else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: complex operator unsupported")) in fail "mere-ruby: complex operator unsupported");
// integer powers of a Complex (negative exponents via the reciprocal).
let rec cpx_pow = fn (base: Val) -> fn (n: int) ->
  if n == 0 then VCpx (VInt 1, VInt 0)
  else if n < 0 then cpx_arith "/" (VCpx (VInt 1, VInt 0)) (cpx_pow base (0 - n))
  else cpx_arith "*" base (cpx_pow base (n - 1));
// int add/sub/mul that promote to bignum exactly on overflow. The checks
// are done BEFORE the operation (signed overflow is UB in C and clang -O2
// would optimise away any after-the-fact `r < 0` test).
// runtime ints are 64-bit, but the Mere compiler (OCaml) is 63-bit, so the
// literal 2^63-1 cannot appear in source — build it: (2^62-1)*2+1.
let int_max = 4611686018427387903 * 2 + 1;
let int_min = 0 - int_max - 1;
let add_int_ov = fn (a: int) -> fn (b: int) ->
  if (b > 0 && a > int_max - b) || (b < 0 && a < int_min - b)
  then norm_big (big_add_s (str_of_int a) (str_of_int b)) else VInt (a + b);
let sub_int_ov = fn (a: int) -> fn (b: int) ->
  if (b < 0 && a > int_max + b) || (b > 0 && a < int_min + b)
  then norm_big (big_sub_s (str_of_int a) (str_of_int b)) else VInt (a - b);
let mul_int_ov = fn (a: int) -> fn (b: int) ->
  if a == 0 || b == 0 then VInt 0
  else
    let ovf = if a > 0 then (if b > 0 then a > int_max / b else b < int_min / a)
              else (if b > 0 then a < int_min / b else b < int_max / a) in
    if ovf then norm_big (big_mul_s (str_of_int a) (str_of_int b)) else VInt (a * b);

// The class name for a comparison failure's message. `class_name` is defined
// much later in the file and this is needed here; an object cannot be named
// precisely without `world`, which a value-level comparison does not have, so it
// is "Object" -- one side named exactly is enough to see what was compared.
let cmp_type_name = fn (v: Val) ->
  (match v with
   | VInt _ -> "Integer" | VBig _ -> "Integer" | VFlt _ -> "Float"
   | VRat (_, _) -> "Rational"
   | VStr _ -> "String" | VSym _ -> "Symbol" | VArr _ -> "Array" | VHsh _ -> "Hash"
   | VNil -> "NilClass" | VBool b -> (if b then "TrueClass" else "FalseClass")
   | VProc _ -> "Proc" | VClass _ -> "Class" | VExc (c, _) -> c | VMain -> "Object"
   | _ -> "Object");
// ruby raises ArgumentError here, naming both sides. This used to leak an
// interpreter-internal `fail` ("comparison of incompatible types"), which became
// a bare StandardError with no idea what was compared -- the `<` family already
// raised the right thing, so only the paths that call this one (sort, min, max)
// were affected, and they are exactly the ones where knowing the types matters.
let cmp_fail = fn (va: Val) -> fn (vb: Val) ->
  prim_raise "ArgumentError" ("comparison of " ++ cmp_type_name va ++ " with " ++ cmp_type_name vb ++ " failed");
let rec cmp_vals = fn (va: Val) -> fn (vb: Val) ->
  // bignum (or bignum vs int): compare exact decimal values, not floats.
  if (match va with VBig _ -> true | _ -> false) && (match vb with VInt _ -> true | VBig _ -> true | _ -> false)
     || (match vb with VBig _ -> true | _ -> false) && (match va with VInt _ -> true | _ -> false)
  then big_cmp_s (num_dec va) (num_dec vb)
  // Rational vs Rational/Int: exact cross-multiply compare.
  else if ((match va with VRat _ -> true | _ -> false) || (match vb with VRat _ -> true | _ -> false))
          && (match va with VRat _ -> true | VInt _ -> true | _ -> false)
          && (match vb with VRat _ -> true | VInt _ -> true | _ -> false) then
    (let an = (match va with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
     let ad = (match va with VRat (n, d) -> d | _ -> "1") in
     let bn = (match vb with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
     let bd = (match vb with VRat (n, d) -> d | _ -> "1") in
     rat_cmp_s an ad bn bd)
  else if is_num va && is_num vb then
    (match va with
     | VInt x ->
       (match vb with
        | VInt y -> if x < y then 0 - 1 else if x > y then 1 else 0
        | _ ->
          let fx = to_f va in let fy = to_f vb in
          if fx < fy then 0 - 1 else if fy < fx then 1 else 0)
     | _ ->
       let fx = to_f va in let fy = to_f vb in
       if fx < fy then 0 - 1 else if fy < fx then 1 else 0)
  else
    match va with
    | VStr x -> let x = sget x in
      (match vb with
       | VStr y -> let y = sget y in str_compare x y
       | _ -> cmp_fail va vb)
    // two Times order by their instant (recorded in time_ord when built)
    | VObj x ->
      (match vb with
       | VObj y when map_has time_inst (str_of_int x) && map_has time_inst (str_of_int y) ->
         (let a1 = map_get time_inst (str_of_int x) in
          let b1 = map_get time_inst (str_of_int y) in
          if a1 < b1 then 0 - 1 else if b1 < a1 then 1 else 0)
       | _ -> cmp_fail va vb)
    | VSym x -> (match vb with VSym y -> str_compare x y | _ -> cmp_fail va vb)
    // Array <=> Array: element-wise, then by length (Ruby semantics).
    // Two self-referential arrays compared element-wise recursed forever. When
    // the SAME pair comes round again the walk has proved them equal so far, so
    // the cycle compares equal -- which is the answer ruby gives.
    | VArr x ->
      (match vb with
       | VArr y ->
         let k = "c" ++ str_of_int x ++ ":" ++ str_of_int y in
         if map_has cyc_seen k then 0
         else
           let _ = map_set cyc_seen k 1 in
           let r = arr_cmp (deref x) (deref y) in
           let _ = map_delete cyc_seen k in
           r
       | _ -> cmp_fail va vb)
    | _ -> cmp_fail va vb
// would cmp_vals fail on this pair? (the < family raises ArgumentError)
and cmp_incompatible = fn (va: Val) -> fn (vb: Val) ->
  if is_num va && is_num vb then false
  else
    (match va with
     | VStr _ -> (match vb with VStr _ -> false | _ -> true)
     | VSym _ -> (match vb with VSym _ -> false | _ -> true)
     | VArr _ -> (match vb with VArr _ -> false | _ -> true)
     | VRat (_, _) -> (if is_num vb then false else true)
     | _ -> true)

and arr_cmp = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (match ys with Nil -> 0 | _ -> 0 - 1)
  | Cons (h, t) ->
    (match ys with
     | Nil -> 1
     | Cons (h2, t2) -> let c = cmp_vals h h2 in if c == 0 then arr_cmp t t2 else c);

let rec list_append = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append t ys);

// a deterministic per-value hash (equal values -> equal hash). Ruby's own
// hash is process-randomised, so only intra-run consistency is required.
let rec val_hash = fn (v: Val) ->
  match v with
  | VInt n -> n
  | VBig s -> str_hash_go s 0 7
  | VStr h -> str_hash_go (sget h) 0 7
  | VSym s -> str_hash_go s 0 5381
  | VBool b -> if b then 1 else 0
  | VNil -> 0
  | VFlt f -> int_of_float f
  // A self-referential array used to recurse until the stack died. The cycle
  // contributes a constant: ruby only requires that equal values hash equal,
  // and two arrays that cycle at the same position agree on it.
  | VArr id ->
    if map_has cyc_seen ("a" ++ str_of_int id) then 4919
    else
      let _ = map_set cyc_seen ("a" ++ str_of_int id) 1 in
      let r = arr_hash_go (deref id) 17 in
      let _ = map_delete cyc_seen ("a" ++ str_of_int id) in
      r
  | _ -> 0
and str_hash_go = fn (s: str) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc
  else str_hash_go s (i + 1) (floor_mod (acc * 31 + ord (char_at s i)) 1000000007)
and arr_hash_go = fn (xs: Val list) -> fn (acc: int) ->
  match xs with Nil -> acc | Cons (h, t) -> arr_hash_go t (floor_mod (acc * 31 + val_hash h) 1000000007);

// Does this list have an array element? flatten! answers nil when there was
// nothing nested to flatten -- and LENGTH cannot tell: [[1],[2]] flattens to
// [1,2], same length, different value.
let rec has_arr_elem = fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (VArr _, _) -> true
  | Cons (_, t) -> has_arr_elem t;

// flatten one level: array elements are spliced, others kept (for flat_map).
let rec flatten1 = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with VArr id -> list_append (deref id) (flatten1 t) | _ -> Cons (h, flatten1 t));

let rec val_member = fn (xs: Val list) -> fn (v: Val) ->
  match xs with Nil -> false | Cons (h, t) -> rb_eq h v || val_member t v;
let rec val_remove = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if rb_eq h v then val_remove t v else Cons (h, val_remove t v);
// append ys to acc keeping first occurrences only (Array#| semantics).
let rec val_dedup_into = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> if val_member acc h then val_dedup_into t acc else val_dedup_into t (list_append acc (Cons (h, Nil)));
// Array#- : keep the elements the other side does not have.
let rec val_difference = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if val_member ys h then val_difference t ys else Cons (h, val_difference t ys);
let rec val_intersect = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if val_member ys h then Cons (h, val_intersect t ys) else val_intersect t ys;

// native 64-bit bitwise (two's-complement, so negatives are correct) — the
// mere builtins map straight to C & | ^.
let int_bitop = fn (op: str) -> fn (x: int) -> fn (y: int) ->
  if str_eq op "&" then bit_and x y
  else if str_eq op "|" then bit_or x y
  else bit_xor x y;
// bignum bitwise (non-negative operands only): a decimal-string magnitude to
// an LSB-first bit list and back, so & | ^ work past 64 bits. Negative
// bignums (arbitrary-precision two's complement) are out of scope.
let rec big_to_bits = fn (s: str) ->
  if str_eq s "0" then (Nil : int list)
  else (match big_divmod_s s "2" with (q, r) -> Cons ((if str_eq r "0" then 0 else 1), big_to_bits q));
let rec big_from_bits = fn (bs: int list) -> fn (place: str) ->
  match bs with
  | Nil -> "0"
  | Cons (b, t) ->
    let rest = big_from_bits t (big_mul_s place "2") in
    if b == 1 then big_add_s place rest else rest;
let rec big_bits_zip = fn (op: str) -> fn (xs: int list) -> fn (ys: int list) ->
  match xs with
  | Nil -> (match op with _ -> ys_tail_for op ys)
  | Cons (x, xt) ->
    (match ys with
     | Nil -> ys_tail_for op (Cons (x, xt))
     | Cons (y, yt) ->
       let b = if str_eq op "&" then (if x == 1 && y == 1 then 1 else 0)
               else if str_eq op "|" then (if x == 1 || y == 1 then 1 else 0)
               else (if x != y then 1 else 0) in
       Cons (b, big_bits_zip op xt yt))
// the tail beyond the shorter operand: & drops it (0), | / ^ keep it.
and ys_tail_for = fn (op: str) -> fn (rest: int list) ->
  if str_eq op "&" then (Nil : int list) else rest;
// big bitwise on two non-negative decimal magnitudes.
let big_bitop = fn (op: str) -> fn (a: str) -> fn (b: str) ->
  big_from_bits (big_bits_zip op (big_to_bits a) (big_to_bits b)) "1";
// as a Val, guarding against negative operands (out of scope): fall back to
// a plain fail so the coerce layer / caller surfaces it.
let big_bitop_v = fn (op: str) -> fn (a: str) -> fn (b: str) ->
  if big_sign a < 0 || big_sign b < 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: bignum bitwise on negative operand unsupported")) in fail "mere-ruby: bignum bitwise on negative operand unsupported")
  else norm_big (big_bitop op a b);

// a list concatenated with itself n times (Array * Integer).
let rec list_rep = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then (Nil : Val list) else list_append xs (list_rep xs (n - 1));
// The name Ruby puts in a conversion error: nil / true / false print as the
// value, everything else as its class. (class_name proper needs the object
// table, which is defined much further down.)
let conv_name = fn (v: Val) ->
  match v with
  | VNil -> "nil"
  | VBool b -> (if b then "true" else "false")
  | VInt _ -> "Integer" | VBig _ -> "Integer" | VFlt _ -> "Float"
  | VStr _ -> "String" | VSym _ -> "Symbol"
  | VArr _ -> "Array" | VHsh _ -> "Hash"
  | VRat (_, _) -> "Rational" | VCpx (_, _) -> "Complex"
  | VRegex (_, _) -> "Regexp" | VProc _ -> "Proc"
  | VRange (_, _, _) -> "Range" | VClass _ -> "Class"
  | _ -> "Object";
// The two shapes CRuby uses: a container/string wants a conversion of its
// argument, a number wants its argument coerced.
let conv_err = fn (v: Val) -> fn (target: str) ->
  prim_raise "TypeError" ("no implicit conversion of " ++ conv_name v ++ " into " ++ target);
let coerce_err = fn (v: Val) -> fn (target: str) ->
  prim_raise "TypeError" (conv_name v ++ " can't be coerced into " ++ target);
// A negative base raised to a non-integer power has no real root, and ruby
// answers the principal COMPLEX one rather than NaN: r * (cos pi*y + i sin
// pi*y). A half-integer exponent is a quarter turn, where the real part is
// exactly zero and the sign of the imaginary part alternates -- computing
// those through cos/sin would leave 1e-16 where ruby prints 0.0.
let pow_val = fn (x: float) -> fn (y: float) ->
  if x >= 0.0 then VFlt (f_pow x y)
  else if y == float_of_int (int_of_float y) then VFlt (f_pow x y)
  else
    let r = f_pow (0.0 - x) y in
    let half = y - 0.5 in
    if half == float_of_int (int_of_float half) then
      (let k = int_of_float half in
       VCpx (VFlt 0.0, VFlt (if k - (k / 2) * 2 == 0 then r else 0.0 - r)))
    else
      (let pi = 3.141592653589793 in
       VCpx (VFlt (r * cos (pi * y)), VFlt (r * sin (pi * y))));

// The next representable double above x, found by search rather than by bit
// twiddling (this language has no way to look at a float's bits): start near
// one ulp, double until the sum is actually greater, then halve while it
// still is. The result is exactly nextafter(x, +inf).
let rec flt_grow = fn (x: float) -> fn (d: float) -> fn (n: int) ->
  if n > 4000 then d
  else if x + d > x then d else flt_grow x (d * 2.0) (n + 1);
let rec flt_shrink = fn (x: float) -> fn (d: float) -> fn (n: int) ->
  if n > 4000 then d
  else if x + d * 0.5 > x then flt_shrink x (d * 0.5) (n + 1) else d;
// the smallest positive subnormal, halved down until the next halving is 0
let rec flt_tiny_go = fn (d: float) ->
  if d * 0.5 == 0.0 then d else flt_tiny_go (d * 0.5);
let flt_tiny = fn () -> flt_tiny_go 1.0;
// ~2^-52, the relative step of a double
let rec flt_eps_go = fn (e: float) -> fn (n: int) ->
  if n == 0 then e else flt_eps_go (e * 0.5) (n - 1);
let flt_eps = fn () -> flt_eps_go 1.0 52;

let flt_next = fn (x: float) ->
  if (if x == x then false else true) then x           // NaN
  else if (if x == 0.0 then false else true) && x * 0.5 == x then x   // +/- infinity
  else if x == 0.0 then flt_tiny ()
  else
    (let mag = (if x > 0.0 then x else 0.0 - x) in
     let d0 = mag * flt_eps () in
     let d = flt_grow x d0 0 in
     x + flt_shrink x d 0);
let rec flt_grow_dn = fn (x: float) -> fn (d: float) -> fn (n: int) ->
  if n > 4000 then d
  else if x - d < x then d else flt_grow_dn x (d * 2.0) (n + 1);
let rec flt_shrink_dn = fn (x: float) -> fn (d: float) -> fn (n: int) ->
  if n > 4000 then d
  else if x - d * 0.5 < x then flt_shrink_dn x (d * 0.5) (n + 1) else d;
let flt_prev = fn (x: float) ->
  if (if x == x then false else true) then x
  else if (if x == 0.0 then false else true) && x * 0.5 == x then x
  else if x == 0.0 then 0.0 - flt_tiny ()
  else
    (let mag = (if x > 0.0 then x else 0.0 - x) in
     let d0 = mag * flt_eps () in
     let d = flt_grow_dn x d0 0 in
     x - flt_shrink_dn x d 0);

// IEEE-754, by arithmetic. `pack("E")` has to hand out the BYTES of a double,
// and Mere has no bit view of a float, so the three fields are recovered by
// scaling: divide or multiply by two until the value sits in [1,2) -- that
// count IS the exponent -- and the remaining fraction is then an exact
// integer, because 52 bits fits in an int. Every step is a power of two, so
// nothing rounds on the way.
let rec f_p2 = fn (k: int) -> if k <= 0 then 1.0 else 2.0 * f_p2 (k - 1);
let rec f_p2n = fn (k: int) -> if k <= 0 then 1.0 else 0.5 * f_p2n (k - 1);
let rec f_norm = fn (x: float) -> fn (e: int) ->
  if x >= 2.0 then f_norm (x * 0.5) (e + 1)
  else if x < 1.0 then f_norm (x * 2.0) (e - 1)
  else (x, e);
let rec f_le_bytes = fn (n: int) -> fn (w: int) ->
  if w <= 0 then "" else chr (floor_mod n 256) ++ f_le_bytes (floor_div n 256) (w - 1);
let rec f_be_bytes = fn (n: int) -> fn (w: int) ->
  if w <= 0 then "" else f_be_bytes (floor_div n 256) (w - 1) ++ chr (floor_mod n 256);
let flt_is_nan = fn (x: float) -> if x == x then false else true;
// infinity is the only non-zero value that is its own half
let flt_is_inf = fn (x: float) -> (if x == 0.0 then false else true) && x * 0.5 == x;
let rec flt_inf_go = fn (x: float) -> if x * 2.0 == x then x else flt_inf_go (x * 2.0);
let flt_inf = fn () -> flt_inf_go 1.0;
let flt_nan = fn () -> let i = flt_inf () in i - i;
// round-to-nearest-even, the mode the hardware uses when it narrows a double
// to a single -- so that pack("e") answers what the C library would
let f_round_even = fn (r: float) ->
  let fl = int_of_float r in
  let d = r - float_of_int fl in
  if d > 0.5 then fl + 1
  else if d < 0.5 then fl
  else if floor_mod fl 2 == 0 then fl else fl + 1;
// the sign, the biased exponent and the fraction of `x` as a binary64
let flt_bits64 = fn (x: float) ->
  if flt_is_nan x then (0, 2047, 2251799813685248)
  else
    (let sg = (if x < 0.0 then 1 else if x == 0.0 && flt_is_inf (1.0 / x) && 1.0 / x < 0.0 then 1 else 0) in
     let a = (if x < 0.0 then 0.0 - x else x) in
     if a == 0.0 then (sg, 0, 0)
     else if flt_is_inf a then (sg, 2047, 0)
     else
       (let (m, e) = f_norm a 0 in
        if e < 0 - 1022 then
          // subnormal: the exponent field bottoms out at its smallest, and
          // what is left of the value goes into the fraction
          (let sh = (0 - 1022) - e in
           if sh > 52 then (sg, 0, 0) else (sg, 0, int_of_float (m * f_p2 (52 - sh))))
        else (sg, e + 1023, int_of_float ((m - 1.0) * f_p2 52))));
let flt_bits32 = fn (x: float) ->
  if flt_is_nan x then (0, 255, 4194304)
  else
    (let sg = (if x < 0.0 then 1 else if x == 0.0 && flt_is_inf (1.0 / x) && 1.0 / x < 0.0 then 1 else 0) in
     let a = (if x < 0.0 then 0.0 - x else x) in
     if a == 0.0 then (sg, 0, 0)
     else if flt_is_inf a then (sg, 255, 0)
     else
       (let (m, e) = f_norm a 0 in
        if e > 127 then (sg, 255, 0)
        else if e < 0 - 126 then
          (let sh = (0 - 126) - e in
           if sh > 24 then (sg, 0, 0)
           else (let q = f_round_even (m * f_p2 (23 - sh)) in
                 if q >= 8388608 then (sg, 1, q - 8388608) else (sg, 0, q)))
        else
          // rounding the fraction up can carry into the exponent
          (let q = f_round_even ((m - 1.0) * f_p2 23) in
           if q >= 8388608 then (if e + 1 > 127 then (sg, 255, 0) else (sg, e + 1 + 127, 0))
           else (sg, e + 127, q))));
let flt_pack64 = fn (x: float) -> fn (bigend: bool) ->
  let (sg, ex, fr) = flt_bits64 x in
  let hi = sg * 128 + floor_div ex 16 in
  let nx = floor_mod ex 16 * 16 + floor_div fr 281474976710656 in
  if bigend then chr hi ++ chr nx ++ f_be_bytes fr 6
  else f_le_bytes fr 6 ++ chr nx ++ chr hi;
let flt_pack32 = fn (x: float) -> fn (bigend: bool) ->
  let (sg, ex, fr) = flt_bits32 x in
  let hi = sg * 128 + floor_div ex 2 in
  let nx = floor_mod ex 2 * 128 + floor_div fr 65536 in
  if bigend then chr hi ++ chr nx ++ f_be_bytes fr 2
  else f_le_bytes fr 2 ++ chr nx ++ chr hi;
let flt_from64 = fn (sg: int) -> fn (ex: int) -> fn (fr: int) ->
  let mag = (if ex == 2047 then (if fr == 0 then flt_inf () else flt_nan ())
             else if ex == 0 then float_of_int fr * f_p2n 1074
             else (1.0 + float_of_int fr * f_p2n 52)
                  * (if ex >= 1023 then f_p2 (ex - 1023) else f_p2n (1023 - ex))) in
  if sg == 1 then 0.0 - mag else mag;
let flt_from32 = fn (sg: int) -> fn (ex: int) -> fn (fr: int) ->
  let mag = (if ex == 255 then (if fr == 0 then flt_inf () else flt_nan ())
             else if ex == 0 then float_of_int fr * f_p2n 149
             else (1.0 + float_of_int fr * f_p2n 23)
                  * (if ex >= 127 then f_p2 (ex - 127) else f_p2n (127 - ex))) in
  if sg == 1 then 0.0 - mag else mag;
// which pack/unpack directives name a float, and how wide each one is
let flt_dir_width = fn (d: str) ->
  if str_eq d "E" || str_eq d "G" || str_eq d "D" || str_eq d "d" then 8
  else if str_eq d "e" || str_eq d "g" || str_eq d "F" || str_eq d "f" then 4
  else 0;
let flt_dir_big = fn (d: str) -> str_eq d "G" || str_eq d "g";

// Object#object_id: a stable integer per object. Ruby's exact values are not
// specified beyond nil/true/false and the small-integer encoding, but the
// IDENTITY has to hold -- the same object answers the same number, and two
// equal Integers or Symbols answer the same one.
let sym_ids = map_new ();
let sym_id_of = fn (nm: str) ->
  if map_has sym_ids nm then map_get sym_ids nm
  else (let n = 6000000 + map_len sym_ids * 8 in let _ = map_set sym_ids nm n in n);

// floored modulo on floats: the sign follows the DIVISOR, as ruby's does.
let flt_floor_mod = fn (x: float) -> fn (y: float) ->
  let q = x / y in
  let fq = (let t = int_of_float q in if float_of_int t > q then float_of_int (t - 1) else float_of_int t) in
  x - y * fq;

let arith_bin = fn (op: str) -> fn (va: Val) -> fn (vb: Val) ->
  // Rational operand: +,-,*,/ produce a Rational (or Float if a Float is
  // involved). Checked first so int/rat mixing works uniformly.
  if ((match va with VRat _ -> true | _ -> false) || (match vb with VRat _ -> true | _ -> false))
     && (str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/")
  then rat_arith op va vb
  else if ((match va with VCpx _ -> true | _ -> false) || (match vb with VCpx _ -> true | _ -> false))
     && (str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/")
  then cpx_arith op va vb
  else if (match va with VCpx _ -> true | _ -> false) && str_eq op "**" then
    (match vb with
     | VInt n -> cpx_pow va n
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ** complex exponent unsupported")) in fail "mere-ruby: ** complex exponent unsupported"))
  else if str_eq op "|" then
    (match va with
     | VArr x -> (match vb with VArr y -> arr_new (val_dedup_into (deref y) (val_dedup_into (deref x) Nil)) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: | type error")) in fail "mere-ruby: | type error"))
     | VInt x -> (match vb with VInt y -> VInt (int_bitop "|" x y) | VBig y -> big_bitop_v "|" (str_of_int x) y | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: | type error")) in fail "mere-ruby: | type error"))
     | VBig x -> big_bitop_v "|" x (num_dec vb)
     | VBool x -> (match vb with VBool y -> VBool (x || y) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: | type error")) in fail "mere-ruby: | type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: | type error")) in fail "mere-ruby: | type error"))
  else if str_eq op "&" then
    (match va with
     | VArr x -> (match vb with VArr y -> arr_new (val_intersect (val_dedup_into (deref x) Nil) (deref y)) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: & type error")) in fail "mere-ruby: & type error"))
     | VInt x -> (match vb with VInt y -> VInt (int_bitop "&" x y) | VBig y -> big_bitop_v "&" (str_of_int x) y | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: & type error")) in fail "mere-ruby: & type error"))
     | VBig x -> big_bitop_v "&" x (num_dec vb)
     | VBool x -> (match vb with VBool y -> VBool (x && y) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: & type error")) in fail "mere-ruby: & type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: & type error")) in fail "mere-ruby: & type error"))
  else if str_eq op "^" then
    (match va with
     | VInt x -> (match vb with VInt y -> VInt (int_bitop "^" x y) | VBig y -> big_bitop_v "^" (str_of_int x) y | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ^ type error")) in fail "mere-ruby: ^ type error"))
     | VBig x -> big_bitop_v "^" x (num_dec vb)
     | VBool x -> (match vb with VBool y -> VBool (if x then (if y then false else true) else y) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ^ type error")) in fail "mere-ruby: ^ type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ^ type error")) in fail "mere-ruby: ^ type error"))
  else
  if str_eq op "+" then
    (match va with
     | VStr x -> (match vb with
                  | VStr y ->
                    (let renc = enc_compat2 (senc_get x) (sget x) (senc_get y) (sget y) in
                     if str_eq renc "" then
                       (let _ = prim_raise "Encoding::CompatibilityError"
                                  ("incompatible character encodings: " ++ enc_canon_name (senc_get x) ++ " and " ++ enc_canon_name (senc_get y)) in VNil)
                     else
                       let r = mkstr (sget x ++ sget y) in
                       (match r with VStr rid -> (let _ = senc_set rid renc in r) | _ -> r))
                  | _ -> conv_err vb "String")
     | VArr x -> (match vb with VArr y -> arr_new (list_append (deref x) (deref y)) | _ -> conv_err vb "Array")
     | VInt x -> (match vb with VInt y -> add_int_ov x y | VBig y -> norm_big (big_add_s (str_of_int x) y) | VFlt y -> VFlt (float_of_int x + y) | _ -> coerce_err vb (conv_name va))
     | VBig x -> (match vb with VInt y -> norm_big (big_add_s x (str_of_int y)) | VBig y -> norm_big (big_add_s x y) | VFlt y -> VFlt (float_of_str x + y) | _ -> coerce_err vb (conv_name va))
     | VFlt x -> (match vb with VInt y -> VFlt (x + float_of_int y) | VBig y -> VFlt (x + float_of_str y) | VFlt y -> VFlt (x + y) | _ -> coerce_err vb (conv_name va))
     | _ -> coerce_err vb (conv_name va))
  else if str_eq op "-" then
    (match va with
     // Array#- : the elements of the left side that the right side lacks.
     | VArr x -> (match vb with VArr y -> arr_new (val_difference (deref x) (deref y)) | _ -> conv_err vb "Array")
     | VInt x -> (match vb with VInt y -> sub_int_ov x y | VBig y -> norm_big (big_sub_s (str_of_int x) y) | VFlt y -> VFlt (float_of_int x - y) | _ -> coerce_err vb (conv_name va))
     | VBig x -> (match vb with VInt y -> norm_big (big_sub_s x (str_of_int y)) | VBig y -> norm_big (big_sub_s x y) | VFlt y -> VFlt (float_of_str x - y) | _ -> coerce_err vb (conv_name va))
     | VFlt x -> (match vb with VInt y -> VFlt (x - float_of_int y) | VBig y -> VFlt (x - float_of_str y) | VFlt y -> VFlt (x - y) | _ -> coerce_err vb (conv_name va))
     | _ -> coerce_err vb (conv_name va))
  else if str_eq op "*" then
    (match va with
     | VStr x -> (match vb with VInt y -> (let r = mkstr (str_repeat (sget x) y) in (match r with VStr rid -> let _ = senc_set rid (senc_get x) in r | _ -> r)) | _ -> conv_err vb "Integer")
     | VArr x -> (match vb with VInt y -> arr_new (list_rep (deref x) y) | _ -> conv_err vb "Integer")
     | VInt x -> (match vb with VInt y -> mul_int_ov x y | VBig y -> norm_big (big_mul_s (str_of_int x) y) | VFlt y -> VFlt (float_of_int x * y) | _ -> coerce_err vb (conv_name va))
     | VBig x -> (match vb with VInt y -> norm_big (big_mul_s x (str_of_int y)) | VBig y -> norm_big (big_mul_s x y) | VFlt y -> VFlt (float_of_str x * y) | _ -> coerce_err vb (conv_name va))
     | VFlt x -> (match vb with VInt y -> VFlt (x * float_of_int y) | VBig y -> VFlt (x * float_of_str y) | VFlt y -> VFlt (x * y) | _ -> coerce_err vb (conv_name va))
     | _ -> coerce_err vb (conv_name va))
  else if str_eq op "/" then
    (match va with
     | VInt x ->
       (match vb with
        | VInt y -> VInt (floor_div x y)
        | VBig y -> norm_big (big_div_s (str_of_int x) y)
        | VFlt y -> VFlt (float_of_int x / y)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: / type error")) in fail "mere-ruby: / type error"))
     | VBig x ->
       (match vb with
        | VInt y -> norm_big (big_div_s x (str_of_int y))
        | VBig y -> norm_big (big_div_s x y)
        | VFlt y -> VFlt (float_of_str x / y)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: / type error")) in fail "mere-ruby: / type error"))
     | VFlt x ->
       (match vb with
        | VInt y -> VFlt (x / float_of_int y)
        | VBig y -> VFlt (x / float_of_str y)
        | VFlt y -> VFlt (x / y)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: / type error")) in fail "mere-ruby: / type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: / type error")) in fail "mere-ruby: / type error"))
  else if str_eq op "%" then
    (match va with
     | VInt x ->
       (match vb with
        | VInt y -> VInt (floor_mod x y)
        | VBig y -> norm_big (big_mod_s (str_of_int x) y)
        // Float#% is floored, like Integer#%: x - y * (x / y).floor. It used
        // to be "supports integers only", which a spec noticed by asking for
        // `6543.21.%(137)`.
        | VFlt y -> VFlt (flt_floor_mod (float_of_int x) y)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: % type error")) in fail "mere-ruby: % type error"))
     | VFlt x ->
       (match vb with
        | VFlt y -> VFlt (flt_floor_mod x y)
        | VInt y -> VFlt (flt_floor_mod x (float_of_int y))
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: % type error")) in fail "mere-ruby: % type error"))
     | VBig x ->
       (match vb with
        | VInt y -> norm_big (big_mod_s x (str_of_int y))
        | VBig y -> norm_big (big_mod_s x y)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: % type error")) in fail "mere-ruby: % type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: % type error")) in fail "mere-ruby: % type error"))
  else if str_eq op "**" then
    (match va with
     // a Float exponent makes the whole thing a Float, whatever the base is
     | VInt x -> (match vb with VInt y -> if y < 0 then mk_rat_s "1" (big_pow (str_of_int x) (0 - y) "1") else norm_big (big_pow (str_of_int x) y "1") | VFlt y -> pow_val (float_of_int x) y | VBig y -> pow_val (float_of_int x) (float_of_str y) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ** type error")) in fail "mere-ruby: ** type error"))
     | VBig x -> (match vb with VInt y -> if y < 0 then VFlt (pow_flt (float_of_str x) y) else norm_big (big_pow x y "1") | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ** type error")) in fail "mere-ruby: ** type error"))
     | VFlt x -> (match vb with VInt y -> VFlt (pow_flt x y) | VFlt y -> pow_val x y | VBig y -> pow_val x (float_of_str y) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ** type error")) in fail "mere-ruby: ** type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: ** type error")) in fail "mere-ruby: ** type error"))
  else if str_eq op "<<" then
    // array append (mutating, returns the same array); string concat;
    // integer shift-left.
    (match va with
     | VArr id -> let _ = arr_set id (list_append (deref id) (Cons (vb, Nil))) in va
     | VStr x -> let x = sget x in (match vb with VStr y -> let y = sget y in mkstr (x ++ y) | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: << string needs a string")) in fail "mere-ruby: << string needs a string"))
     | VInt x ->
       (match vb with
        | VInt y ->
          if y < 0 then shr_big va (0 - y)
          else if shl_int_fits x y then VInt (shl_int x y)
          else shl_big va y
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: << type error")) in fail "mere-ruby: << type error"))
     | VBig _ ->
       (match vb with
        | VInt y -> if y < 0 then shr_big va (0 - y) else shl_big va y
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: << type error")) in fail "mere-ruby: << type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: << type error")) in fail "mere-ruby: << type error"))
  else if str_eq op ">>" then
    (match va with
     | VInt x ->
       (match vb with
        | VInt y -> if y < 0 then shl_big va (0 - y) else VInt (shr_int x y)
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: >> type error")) in fail "mere-ruby: >> type error"))
     | VBig _ ->
       (match vb with
        | VInt y -> if y < 0 then shl_big va (0 - y) else shr_big va y
        | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: >> type error")) in fail "mere-ruby: >> type error"))
     | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: >> type error")) in fail "mere-ruby: >> type error"))
  else (let __fm = ("mere-ruby: unknown operator: " ++ op) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm);


// ---- M5 core-method helpers (leaf: no world / block) ---------------------
// character-level case mapping (Mere has str_rev/trim/split/... but no
// upcase/downcase).
let shift_case = fn (s: str) -> fn (lo: int) -> fn (hi: int) -> fn (delta: int) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let o = ord (char_at s i) in
      let c = if o >= lo && o <= hi then chr (o + delta) else char_at s i in
      go (i + 1) (acc ++ c) in
  go 0 "";
// ---- UTF-8-aware case mapping (ASCII + Latin-1 Supplement) ---------------
// decode the codepoint at byte i; returns (codepoint, byte_length).
// The continuation bytes are read only if they are there. A lead byte at the
// very end of a string claims a 2-4 byte sequence that the string does not
// contain -- which happens constantly on binary data, since any byte >= 0xC0
// looks like a lead byte -- and this used to read past the end and get whatever
// followed. On the compiled backends that was the NUL terminator, and the
// value was discarded anyway (only the LENGTH is used by utf8_clen), so nothing
// ever showed: SHA-1 of a 20-byte string walked off its buffer on every call
// and still produced the right digest. Mere started refusing the read in
// v0.1.275; `b` keeps the answer the same by supplying the 0 that the old
// out-of-bounds read returned.
// codepoint and byte length at byte i. A byte that does not START a valid
// sequence (a lone continuation byte, a truncated sequence, 0xF8+) is ONE
// one-byte character whose "codepoint" is the byte value — the same walk
// ruby's broken-string operations do. Believing such a byte's advertised
// length made "\xFF" claim four bytes (a garbage codepoint near 3.4M, which
// a set range like "\x00-\xFF" then expanded into millions of characters).
let utf8_cp = fn (s: str) -> fn (i: int) ->
  let n = str_len s in
  let b = fn (k: int) -> if k < n then ord (char_at s k) else 0 - 1 in
  let cont = fn (k: int) -> (let v = b k in v >= 128 && v < 192) in
  let b0 = b i in
  if b0 < 128 then (b0, 1)
  else if b0 < 192 then (b0, 1)
  else if b0 < 224 then
    (if cont (i + 1) then ((b0 - 192) * 64 + (b (i + 1) - 128), 2) else (b0, 1))
  else if b0 < 240 then
    (if cont (i + 1) && cont (i + 2)
     then ((b0 - 224) * 4096 + (b (i + 1) - 128) * 64 + (b (i + 2) - 128), 3)
     else (b0, 1))
  else if b0 < 248 then
    (if cont (i + 1) && cont (i + 2) && cont (i + 3)
     then ((b0 - 240) * 262144 + (b (i + 1) - 128) * 4096 + (b (i + 2) - 128) * 64 + (b (i + 3) - 128), 4)
     else (b0, 1))
  else (b0, 1);
// encode a codepoint back to UTF-8 bytes.
let utf8_enc = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + cp - (cp / 64) * 64)
  else if cp < 65536 then chr (224 + cp / 4096) ++ chr (128 + (cp / 64) - (cp / 4096) * 64) ++ chr (128 + cp - (cp / 64) * 64)
  else chr (240 + cp / 262144) ++ chr (128 + (cp / 4096) - (cp / 262144) * 64) ++ chr (128 + (cp / 64) - (cp / 4096) * 64) ++ chr (128 + cp - (cp / 64) * 64);
// byte length of the codepoint at byte i.
let utf8_clen = fn (s: str) -> fn (i: int) -> (match utf8_cp s i with (c, l) -> l);
// number of codepoints in s.
let rec utf8_len_go = fn (s: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len s then n else utf8_len_go s (i + utf8_clen s i) (n + 1);
let utf8_len = fn (s: str) -> utf8_len_go s 0 0;
// byte offset of the k-th codepoint (clamped to str_len).
let rec utf8_boff = fn (s: str) -> fn (k: int) -> fn (i: int) ->
  if k <= 0 || i >= str_len s then i else utf8_boff s (k - 1) (i + utf8_clen s i);
// the character starting at BYTE offset i ("" if out of range). utf8_char takes
// a codepoint index and has to walk from the start to find it; the regex engine
// already holds byte offsets, so it needs this one.
// How many characters precede BYTE offset b. Ruby reports every position -- =~,
// index, rindex, MatchData#begin/#end -- in characters, and this engine works in
// bytes: on "日本語abc" they came back as 6 / 9 / 10 where Ruby says 2 / 3 / 4.
// On an ASCII string the two are equal, which is why it never showed.
let utf8_cidx = fn (s: str) -> fn (b: int) ->
  utf8_len (substring s 0 (if b < 0 then 0 else if b > str_len s then str_len s else b));
let utf8_char_at = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then "" else substring s i (i + utf8_clen s i);
// the k-th codepoint as a string ("" if out of range).
let utf8_char = fn (s: str) -> fn (k: int) ->
  let off = utf8_boff s k 0 in
  if off >= str_len s then "" else substring s off (off + utf8_clen s off);
// codepoint substring [st, st+len) — st/len in codepoints.
let utf8_substr = fn (s: str) -> fn (st: int) -> fn (len: int) ->
  let a = utf8_boff s st 0 in let b = utf8_boff s (st + len) 0 in substring s a b;
// list of one-codepoint VStr values.
let rec utf8_chars_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else let l = utf8_clen s i in Cons (mkstr (substring s i (i + l)), utf8_chars_val s (i + l));
// the characters CARRY the receiver's encoding ("chars of a US-ASCII string
// are US-ASCII strings"); the untagged walker above predates senc.
let rec utf8_chars_enc = fn (s: str) -> fn (e: str) -> fn (i: int) ->
  if i >= str_len s then (Nil : Val list)
  else
    let l = utf8_clen s i in
    let v = mkstr (substring s i (i + l)) in
    let _ = (match v with VStr id -> senc_set id e | _ -> ()) in
    Cons (v, utf8_chars_enc s e (i + l));
// reverse by codepoints.
let rec utf8_rev_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc else let l = utf8_clen s i in utf8_rev_go s (i + l) (substring s i (i + l) ++ acc);
let utf8_reverse = fn (s: str) -> utf8_rev_go s 0 "";
let rec str_byte_sum = fn (s: str) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc else str_byte_sum s (i + 1) (acc + ord (char_at s i));
let rec utf8_codepoints = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then (Nil : Val list)
  else (match utf8_cp s i with (c, l) -> Cons (VInt c, utf8_codepoints s (i + l)));
// split into lines keeping the trailing newline on each (String#lines).

// ---- transcoding between UTF-8 / ISO-8859-1 / US-ASCII (formula-based) ----
// decode source bytes to a codepoint list (UTF-8 multibyte; else byte=cp).
// UTF-16, both ways. `encode` used to answer the SAME BYTES for every target it
// did not know: `"ab".encode("UTF-16BE").bytesize` was 2 where ruby says 4,
// because a non-UTF-8 target fell into the one-byte-per-codepoint branch. UTF-16
// is written out properly here, and a target that would need a mapping this does
// not have now refuses instead (see encode_cps).
let utf16_enc = fn (cp: int) -> fn (be: bool) ->
  if cp < 65536 then
    (let hi = cp / 256 in
     let lo = cp - hi * 256 in
     if be then chr hi ++ chr lo else chr lo ++ chr hi)
  else
    (let v = cp - 65536 in
     let w1 = 55296 + v / 1024 in
     let w2 = 56320 + (v - (v / 1024) * 1024) in
     let b = fn (w: int) -> (let h = w / 256 in let l = w - h * 256 in if be then chr h ++ chr l else chr l ++ chr h) in
     b w1 ++ b w2);
let utf16_cp = fn (s: str) -> fn (i: int) -> fn (be: bool) ->
  let byte = fn (k: int) -> if k < str_len s then ord (char_at s k) else 0 in
  let unit = fn (k: int) -> (if be then byte k * 256 + byte (k + 1) else byte (k + 1) * 256 + byte k) in
  let u = unit i in
  if u >= 55296 && u < 56320 && i + 3 < str_len s then
    (let u2 = unit (i + 2) in ((u - 55296) * 1024 + (u2 - 56320) + 65536, 4))
  else (u, 2);
// An encoding NAME is ASCII, so comparing it case-insensitively needs no more
// than this (str_upcase is defined further down the file).
let rec enc_up_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else (let c = ord (char_at s i) in
        enc_up_go s (i + 1) (acc ++ (if c >= 97 && c <= 122 then chr (c - 32) else char_at s i)));
let enc_up = fn (s: str) -> enc_up_go s 0 "";
let enc_is_utf16 = fn (nm: str) -> let t = enc_up nm in str_eq t "UTF-16BE" || str_eq t "UTF-16LE";
let enc_utf16_be = fn (nm: str) -> str_eq (enc_up nm) "UTF-16BE";
// ---- JIS X 0208 (EUC-JP / Shift_JIS / Windows-31J) <-> Unicode ------------
// Generated by tools/gen_jis0208.rb (ruby's own transcoder is the oracle);
// entries are "LLTT:CP" -- the EUC byte pair in hex, then the codepoint in
// hex -- comma-separated. Regenerate by replacing the literal between the
// ENC_JIS0208_TABLE markers. Halfwidth katakana (SS2) is arithmetic and JIS
