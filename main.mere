    // byte under 128, ASCII-8BIT for one at or above it (ruby refuses beyond
    // 255 without an encoding argument), and the named encoding when one is
    // given. 774 of core/integer's failing examples were this one method
    // answering UTF-8 for everything -- the largest single cause in the whole
    // scoreboard, and one method.
    (match recv with
     | VInt n ->
       // ⚠ The name is resolved the way Encoding.find resolves it, not by
       // upcasing: 'euc-jp' and 'Utf-8' name encodings, and the canonical
       // spelling ("EUC-JP", "Shift_JIS", "eucJP-ms") is what every rule below
       // is written against. Upcasing answered "EUC-JP" for one spelling and
       // "SHIFT_JIS" for another, so only the all-caps names were reachable.
       (let given0 = (match args with
                      | Cons (VStr e, _) -> sget e
                      | Cons (VObj _, _) -> (match args with Cons (ev, _) -> to_s ev | _ -> "")
                      | _ -> "") in
        let given = (if str_eq given0 "" then "" else enc_find_canon given0) in
        if (if str_eq given0 "" then false else str_eq given "") then
