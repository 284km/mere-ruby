  // `Class.new { }` written in an instance_exec block (which is every spec
  // example) both became singleton methods of the example object.
  let _ = map_set cenv "__definee_recv" VNil in
  let _ = map_set cenv "__definee_cls" VNil in
  let _ = map_set cenv "__cscope" (mkstr cscope) in
  let _ = map_set cenv "__cref" (mkstr cscope) in
  // methods defined in the block get the block's lexical scope as their cref
  // (constant resolution in their bodies), not the call site's.
  let saved_lex = cur_lex () in
  let _ = set_lex cscope in
  let r = register_class_v world cls body "public" cenv in
  let _ = set_lex saved_lex in
  let _ = restore_ref_active saved in
  r

// walk the class body tracking the current visibility mode (a bare
// `private` marks every subsequent def private until `public`).
and register_class_v = fn world -> fn (cls: str) -> fn (body: Stmt list) -> fn (vis: str) -> fn cenv ->
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), cenv) in
  // the scope for constants / nested classes defined in this body: the class
  // itself for a literal body, the block's lexical scope for a class_eval-
  // style block ("" = top level).
  // ⚠ OBJECT IS NOT A NAMESPACE TO QUALIFY BY. Top-level constants already
  // live in Object's, so a `module M` written inside an explicitly reopened
  // `class ::Object` is ::M -- reopening whatever M is already there. Naming
  // it "Object::M" built a SECOND module beside the first: its methods and
  // constants were unreachable through the name, and `M.constants` listed
  // only the new ones. The statement path already reads Object as the empty
  // scope; the class-body walker did not.
  let cscope = (if map_has cenv "__cscope" then (match map_get cenv "__cscope" with VStr s -> let s = sget s in (if str_eq s "Object" then "" else s) | _ -> cls) else cls) in
  match body with
  | Nil -> FNext VNil
