              else if (match recv with VStr _ -> true | VArr _ -> true | VRange (_, _, _) -> true | _ -> false)
                      && (str_eq name "at" || str_eq name "delete_at" || str_eq name "[]"
                          || str_eq name "rotate" || str_eq name "fetch"
                          || str_eq name "sum"
                          // v0.1: these take a count or an index too, and were
                          // the three the sweep found still refusing (or quietly
                          // ignoring) an object with #to_int
                          || str_eq name "setbyte" || str_eq name "*"
                          // to_i's BASE converts with #to_int too.
                          || str_eq name "to_i")
              then coerce_int_args env world args0
              else if (match recv with VArr _ -> true | _ -> false)
                      && (str_eq name "intersect?" || str_eq name "intersection"
                          || str_eq name "union" || str_eq name "difference"
                          || str_eq name "&" || str_eq name "|" || str_eq name "-"
                          // product's arguments are ARRAYS, and #to_ary (or a
                          // method_missing that answers for it) is how an
                          // object says it is one.
                          || str_eq name "product"
                          || str_eq name "zip")
