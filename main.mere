     // `1.step(10, 3).to_a`/`.each`/`.map` work like the Range form.
     | VInt lo -> (match args with Cons (VInt limit, Cons (VInt n, _)) -> arr_new (range_step_arr lo limit n) | Cons (VInt limit, _) -> arr_new (range_step_arr lo limit 1) | _ -> (let _ = map_set prim_missing "n" (mkstr "step") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'step'")) in fail "mere-ruby: undefined method 'step'")))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "step") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'step'")) in fail "mere-ruby: undefined method 'step'")))
  else if str_eq name "index" || (str_eq name "find_index" && (match recv with VArr _ -> true | _ -> false)) then
