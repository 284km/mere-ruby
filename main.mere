// mere-ruby — a Ruby subset interpreter written in pure Mere. M0 + M1.
extern fn getenv: str -> str;
//
// M0: literals (integer, float, string, true/false/nil, array, hash),
// operators with Ruby precedence (** right-assoc, unary - !, * / %, + -,
// comparisons, == !=, && ||), parentheses, comments, and `puts`.
// Ruby semantics where they differ from C: floor division and
// sign-of-divisor modulo, value-returning && / ||, truthiness (only nil
// and false are falsy — 0 is truthy), puts flattening arrays recursively.
//
// M1: local variables (assignment / reassignment; the environment is a
// Mere Map, whose insertion-ordered semantics match Ruby's), and block
// control flow: if / elsif / else, unless, while, until, case / when
// (with multi-value `when a, b`), all with the multi-line ... end form.
//
// Verification: every corpus program must print byte-identical output to
// the reference `ruby` (see run_corpus.sh).
//
//   mere -c main.mere > mr.c && clang -O2 mr.c -o mere-ruby
//   ./mere-ruby script.rb

// ---- values and syntax trees --------------------------------------------
type Tok = TInt of int | TFlt of float | TStrL of str | TId of str
         | TBig of str  // an integer literal too large for a machine int
         // Rational literal as (num, den) canonical decimal strings (bignum /
         // exact-decimal safe); Complex (imaginary) literal `4i`.
         | TRat of str * str | TImag of int | TImagF of float | TImagRat of str * str
         | TSym of str | TP of str | TRegex of str * str | TNL | TEOF;

// EHsh / VHsh hold interleaved [k1, v1, k2, v2, ...] lists (M0
// simplification: literal order is preserved, which matches Ruby's
// insertion-ordered Hash for programs that only build literals).
type Expr = EInt of int | EBig of str | ERat of str * str | EImag of int | EImagF of float | EImagRat of str * str | EFlt of float | EStrL of str | EBool of bool
          | ENil | EArr of Expr list | EHsh of Expr list
          | EBin of str * Expr * Expr | EUn of str * Expr
          | EVar of str | ECall of str * Expr list
          // M3 object model:
          | ESym of str          // :name
          | ESelf                // self
          | EConst of str        // a capitalized name (a class reference)
          | EConstOrNil of str   // a const read that yields nil when undefined
          | EScopedAssign of Expr * str * Expr  // recv::Const = value (runtime recv)
          | EScopedRead of Expr * str  // recv::Const read (runtime recv)
          | EScopedReadOrNil of Expr * str  // recv::Const read, nil if undefined (for ||=)
          | EIVar of str         // @name
          | EMethod of Expr * str * Expr list  // recv.name(args)
          // op-assign on an attribute / index, evaluating recv (and indices)
          // exactly once: recv.name op= rhs / recv[idx..] op= rhs.
          | EAttrOp of Expr * str * str * Expr
          | EIdxOp of Expr * Expr list * str * Expr
          // M4 blocks / iterators:
          | ERange of Expr * Expr * bool         // lo..hi (bool = exclusive)
          // `name [items]` (space before bracket): indexing when name is a
          // live local, else a call with one array argument. Decided at eval.
          | EAmbigIdx of str * Expr list
          // a range in condition position: the flip-flop operator. The int
          // is the site id keying its hidden on/off state.
          | EFlipFlop of int * Expr * Expr * bool
          | EYield of Expr list                  // yield(args)
          // a call/method with a trailing block { |bp| body }: block params
          // and block body come last.
          | ECallB of str * Expr list * str list * Stmt list
          | EMethodB of Expr * str * Expr list * str list * Stmt list
          // M6 exceptions:
          | ERaise of Expr list                  // raise [Class][, msg]
          // M9: a splat argument `*expr` at a call site (expands an array).
          | ESplat of Expr
          // 2f: ternary `cond ? a : b`.
          | ETern of Expr * Expr * Expr
          // 2i: subjectless `case` marker (when-conditions are truthiness
          // tests); `defined?(e)` returns a description string or nil.
          | ECaseNone
          | EDefined of Expr
          // 2k: super. bool = zsuper (bare `super`, forward current args);
          // when false the args are explicit (super() or super(a, b)).
          | ESuper of bool * Expr list
          | ESuperB of bool * Expr list * str list * Stmt list  // super with a block
          // 2m: `&expr` block-pass marker in an argument list (only &:sym is
          // turned into a real block; other forms are best-effort).
          | EBlockPass of Expr
          // G2: assignment as an expression (`true && x = 1`, `f(x = 2)`).
          | EAssign of str * Expr
          // G2: -> (params) { body } lambda literal.
          | ELambda of str list * Stmt list
          // G2: a statement (if/unless/case/begin) used as an expression,
          // e.g. `if c ... end.should == x`.
          | EStmt of Stmt
          // G2: /pattern/ regex literal (body, flags e.g. "im").
          | ERegex of str * str
          // G2: break/next/redo/return in EXPRESSION position (fail-unwind).
          | EFlow of str * Expr
          // G3: safe navigation a&.b(args) — nil receiver yields nil.
          | ESafe of Expr * str * Expr list
          | ESafeB of Expr * str * Expr list * str list * Stmt list  // a&.m { blk }
          // G3: **hash argument at a call site.
          | EKwSplat of Expr
          // a trailing keyword-argument hash from `key: value` call syntax
          // (distinct from a `{...}` hash literal so kwargs and a positional
          // hash argument can be kept separate, per Ruby 3.0).
          | EKwHash of Expr list
          // one-line pattern matching: `expr in pat` yields true/false;
          // `expr => pat` matches-or-raises NoMatchingPatternError (value nil).
          | EMatchTest of Expr * Pat
          | EMatchBind of Expr * Pat;

// SIf: clause list ((condition, body) pairs — the if plus each elsif)
// and the else body (Nil when absent). unless / until desugar to a
// negated condition at parse time. SCase: subject, when-clauses (each:
// candidate values, body), else body. SDef: name, params, body.
// M3: SClass name, superclass ("" = none), body (defs / attrs);
// SIVarAssign @name = e; SAttr mode ("r"/"w"/"rw"), symbol names.
type Stmt = SPuts of Expr list | SExpr of Expr
          | SAssign of str * Expr
          | SIf of (Expr * Stmt list) list * Stmt list
          | SWhile of Expr * Stmt list
          | SCase of Expr * (Expr list * Stmt list) list * Stmt list
          // SDef: name, param names, (name, default-expr) for defaulted
          // params, body.
          | SDef of str * str list * (str * Expr) list * Stmt list
          | SReturn of Expr
          | SBreak of Expr | SNext of Expr
          | SClass of str * str * Stmt list
          // like SClass but the superclass is a runtime expression (evaluated
          // to a Class; a non-Class / module / singleton raises TypeError).
          | SClassE of str * Expr * Stmt list
          | SIVarAssign of str * Expr
          | SAttr of str * str list
          // M6: begin body / rescue clauses (class names, var, handler) /
          // else body / ensure body.
          | SBegin of Stmt list * (str list * str * Stmt list) list * Stmt list * Stmt list
          // BEGIN { } runs first in its code unit (hoisted); END { } runs at
          // exit. Distinct from a plain begin/end so run_prog/eval can order them.
          | SPreexe of Stmt list
          | SAtExit of Stmt list
          // `class << <expr>` — open the singleton class of an arbitrary
          // expression receiver (a literal / paren-expr / ivar), the general
          // form of `class << self` / `class << obj`.
          | SSingletonE of Expr * Stmt list
          // `var = <stmt>` where stmt is a begin/end used as a value: run
          // the statement, bind its value (else propagate return/raise).
          | SLocalFrom of str * Stmt
          // M8: multiple assignment. Targets are encoded names — a plain
          // local, "@name" for an ivar, "*name" for a splat. The RHS is one
          // or more expressions (one array is destructured; several values
          // form the array).
          | SMultiAssign of str list * Expr list
          // multiple assignment with complex targets (foo[0], bar.baz = ...):
          // each target is EVar / EIVar / ESplat / EMethod (indexing or attr).
          | SMultiAssignX of Expr list * Expr list
          // 2h: `alias new old` (copy a method); `include M` (mix a module's
          // instance methods into the class).
          | SAlias of str * str
          | SInclude of str
          // 2n: `undef name[, name]` removes method definitions.
          | SUndef of str list
          // 2t: visibility — `private` / `private :m, :n` (mode, names;
          // empty names = switch the mode for subsequent defs).
          | SVis of str * str list
          // 2u: declare locals as nil if not yet bound — Ruby defines the
          // targets of an assignment even when a guard skips executing it.
          | SDeclare of str list
          // G2: require / require_relative (bool = relative), path expr.
          | SRequire of bool * Expr
          // G2: low-precedence `stmt and stmt` / `stmt or stmt`.
          | SAndThen of Stmt * Stmt
          | SOrElse of Stmt * Stmt
          // G2: `begin ... end while/until c` — run body, then loop while
          // the (already-negated-for-until) condition holds.
          | SDoWhile of Stmt * Expr
          // pattern matching `case subj / in pat [guard] / ... [else] / end`.
          // Each clause is (pattern, guard-expr, body); the guard is EBool true
          // when absent (an `unless` guard is negated at parse time). The bool
          // is has-else; els is the else body (run when no pattern matches, or
          // NoMatchingPatternError is raised when has-else is false).
          | SCaseIn of Expr * (Pat * Expr * Stmt list) list * bool * Stmt list;

// A case/in pattern.
type Pat = PVar of str                       // binds a local (`_`/`_x` allowed, repeatable)
         | PVal of Expr                      // value pattern — matched with === (case_eqq)
         | PPin of Expr                      // ^expr — matched with == (rb_eq)
         | PSplatP of str                    // *name array element ("" = anonymous)
         | PArrP of Pat list                 // [p, ...] (a PSplatP element = splat)
         // {k: p, ...}; rest: "" open (extra keys allowed unless empty),
         // "nil" = **nil (no extra keys), "*" = ** anonymous rest, else **name.
         | PHashP of (str * Pat) list * str
         | PAltP of Pat list                 // p | p | ...
         | PAsP of Pat * str                 // pat => name
         | PConstP of Expr * Pat;            // Const[..] / Const(..): === then match inner

// VObj holds an object id (a handle into the world's object tables);
// VClass holds a class name. VSym is a Ruby symbol. VRange is lo..hi with
// a bool for the exclusive form (1...5).
// M10: arrays are mutable reference types, so VArr is a HANDLE (an id into
// the top-level arr_store); its contents live in the store and are shared
// by all aliases. VHsh stays an immutable value list (hash mutation is a
// later milestone).
type Val = VInt of int | VFlt of float | VStr of int | VBool of bool
         // arbitrary-precision integer, held as a canonical decimal string
         // (no leading zeros; "-" prefix if negative; never a value that
         // fits in a machine int — those stay VInt).
         | VBig of str
         // Rational num/den (den > 0, gcd-reduced) and Complex real/imag.
         | VRat of str * str
         | VCpx of Val * Val
         | VNil | VArr of int | VHsh of int
         | VObj of int | VClass of str | VSym of str
         | VRange of int * int * bool
         | VExc of str * str    // exception: class name, message
         | VProc of int         // a proc/lambda: a handle into proc_store
         | VBind of int         // a Binding: a handle into bind_store (captured env)
         | VRegex of str * str  // /pattern/flags (minimal matcher)
         | VMain;               // the top-level `self` (main), class Object

// A user method: parameter names, defaults ((name, default-expr) for
// params with `= default`), and body. Stored in the methods table (a
// Map[str, Meth]) keyed by bare name (top-level) or "Class#name".
type Meth = Meth of str list * (str * Expr) list * Stmt list;

// Statement execution result: FNext carries the statement's value (so a
// method's implicit return is its last statement's value); FReturn is a
// non-local exit carrying an explicit `return` value up through enclosing
// blocks and loops to the method boundary.
// FRaise signals that a Ruby exception unwound to a begin/rescue (the
// exception value itself is stashed in the world's ivars under "$exc",
// since raise unwinds via Mere's `fail` and try_or yields only a default).
// FBreak / FLoopNext are loop control (break / next), caught by the
// enclosing while loop; FReturn / FRaise propagate to the method / rescue.
type Flow = FNext of Val | FReturn of Val | FRaise of Val
          | FBreak of Val | FLoopNext of Val;

// ---- regex AST (compiled engine) -----------------------------------------
// Character-class atoms. Ranges compare byte strings directly (Mere string
// comparison is lexicographic on bytes).
type RCls = CChr of str | CRange of str * str
          | CDigit | CWord | CSpace | CHex
          | CNDigit | CNWord | CNSpace | CNHex
          | CPosix of str * bool;
// Pattern AST. The i/m/x flags are fully resolved at PARSE time: i turns
// letters into NCharCI and sets the class ci bit, m turns `.` into NAnyNL,
// x is consumed by the parser (whitespace/#-comments). Ruby's ^/$ are always
// line anchors (m affects only `.`); \A/\z/\Z are the string anchors.
// NFlagsRest is parser-internal: `(?im)` applies to the rest of the sequence.
type RNode = NChar of str | NCharCI of str | NAny | NAnyNL
           | NClass of RCls list * bool * bool     // items, negated, ci
           | NSeq of RNode list | NAlt of RNode list
           | NRep of RNode * int * int * bool      // body, min, max (-1 = inf), greedy
           | NGroup of RNode * int * str           // body, gnum (0 = shy), name
           | NBackref of int * bool                // group, ci
           | NBOL | NEOL | NBOS | NEOS | NEOSNL
           | NWordB of bool
           | NLook of RNode * bool | NLookB of RNode * bool   // body, negated
           | NFlagsRest of str
           | NEmpty;
// Compiled instructions (a program is an int-key Map "0".."N-1" -> RInst,
// plus "meta" -> IMeta (count, ngroups) and "name:<x>" -> IMeta (gnum, 0)).
type RInst = IChar of str | ICharCI of str | IAny | IAnyNL
           | IClass of RCls list * bool * bool
           | ISplit of int * int | IJmp of int | ISave of int
           | IBOL | IEOL | IBOS | IEOS | IEOSNL
           | IWordB of bool | IBackref of int * bool
           | ILook of int * bool | ILookB of int * int * bool
           | IMark of int | ICheck of int * int
           | IOk | IMatch
           | IMeta of int * int;
// VM results: a match's end index + capture saves (immutable assoc list,
// newest first), and the search wrapper's hit / no-hit / uncompilable-pattern.
type RxRes = RFound of int * (int * int) list | RFail;
type RxHit = RHit of int * int * (int * int) list | RNoHit | RBadPat;

// ---- mutable-array store (M10) ------------------------------------------
// A single top-level Map captured by every function below (no threading):
// id (as str) -> the array's contents (a Val list). Arrays are handles
// (VArr id) into it, so aliases share one mutable list. A fresh id is
// map_len arr_store (arrays are never removed — memory grows, acceptable).
let arr_store = map_new () in
let arr_new = fn (xs: Val list) ->
  let id = map_len arr_store in
  let _ = map_set arr_store (str_of_int id) xs in
  VArr id;
let deref = fn (id: int) -> map_get arr_store (str_of_int id);
let arr_set = fn (id: int) -> fn (xs: Val list) ->
  let _ = map_set arr_store (str_of_int id) xs in ();

// strings are mutable reference types too (Ruby semantics): VStr is a HANDLE
// into str_store, so aliases share one mutable string. Fresh id per literal
// evaluation — entries are never removed. A vec gives O(1) alloc/get/set
// (string allocation is far hotter than array allocation).
let str_store = vec_new () in
let mkstr = fn (s: str) ->
  let id = vec_len str_store in
  let _ = vec_push str_store s in
  VStr id;
let sget = fn (id: int) -> vec_get str_store id;
let sset = fn (id: int) -> fn (s: str) ->
  let _ = vec_set str_store id s in ();
// hashes are mutable reference types too: VHsh is a HANDLE into hash_store,
// which holds the interleaved [k1,v1,k2,v2,...] pair list. Aliases share one
// mutable hash (h[k]=v is seen through every reference).
let hash_store = vec_new () in
let mkhash = fn (xs: Val list) ->
  let id = vec_len hash_store in
  let _ = vec_push hash_store xs in
  VHsh id;
let hderef = fn (id: int) -> vec_get hash_store id;
let hset = fn (id: int) -> fn (xs: Val list) ->
  let _ = vec_set hash_store id xs in ();
// per-hash default value for missing keys (Hash.new(d)); keyed by handle id.
let hash_dflt = map_new () in
let hdflt_set = fn (id: int) -> fn (v: Val) -> let _ = map_set hash_dflt (str_of_int id) v in ();
let hdflt_get = fn (id: int) -> if map_has hash_dflt (str_of_int id) then map_get hash_dflt (str_of_int id) else VNil;
// per-string encoding label (str handle id -> encoding name); default UTF-8.
let str_enc = map_new () in
let senc_set = fn (id: int) -> fn (nm: str) -> let _ = map_set str_enc (str_of_int id) nm in ();
let senc_get = fn (id: int) -> if map_has str_enc (str_of_int id) then map_get str_enc (str_of_int id) else "UTF-8";
// frozen-string tracking + CLI frozen-string-literal mode + __FILE__ path.
let str_frozen = map_new () in
let sfrozen_set = fn (id: int) -> let _ = map_set str_frozen (str_of_int id) "1" in ();
let sfrozen_get = fn (id: int) -> map_has str_frozen (str_of_int id);
// frozen state of ordinary objects (keyed by object id string), consulted by
// #frozen? on the object and on its singleton class.
let obj_frozen = map_new () in
let ofrozen_set = fn (id: int) -> let _ = map_set obj_frozen (str_of_int id) "1" in ();
let ofrozen_get = fn (id: int) -> map_has obj_frozen (str_of_int id);
let ofrozen_key = fn (k: str) -> map_has obj_frozen k;
let cli_fsl = map_new () in   // key "on" present => --enable-frozen-string-literal
let cli_file = map_new () in  // key "p" -> the running script's path (__FILE__)
let fsl_on = fn () -> map_has cli_fsl "on";
let script_file = fn () -> if map_has cli_file "p" then map_get cli_file "p" else "-";
// lexical constant scope (cref): the class whose body is currently being run
// ("" = top level). Captured per method at `def` time (meth_cref) and consulted
// when resolving a bare Constant, so `Const` means the lexically-nearest one.
let lex_cref = map_new () in
let cur_lex = fn () -> if map_has lex_cref "c" then map_get lex_cref "c" else "";
let set_lex = fn (c: str) -> let _ = map_set lex_cref "c" c in ();
let meth_cref = map_new () in
// the shared Encoding objects, keyed by canonical name; enc_name maps an
// Encoding object's handle id -> name so the (world-free) printer can format it.
let enc_objs = map_new () in
let enc_name = map_new () in
// dummy encodings (stateful/wide converters, CRuby's list); a dummy is never
// ASCII-compatible, and neither is any UTF-16/UTF-32 variant.
let enc_is_dummy = fn (nm: str) ->
  str_eq nm "UTF-16" || str_eq nm "UTF-32" || str_eq nm "IBM037" ||
  str_eq nm "ISO-2022-JP" || str_eq nm "ISO-2022-JP-2" || str_eq nm "ISO-2022-JP-KDDI" ||
  str_eq nm "CP50220" || str_eq nm "CP50221" || str_eq nm "UTF-7" in
let enc_ascii_compat = fn (nm: str) ->
  if enc_is_dummy nm then false
  else if str_len nm >= 6 && (str_eq (substring nm 0 6) "UTF-16" || str_eq (substring nm 0 6) "UTF-32") then false
  else true in
// procs/lambdas are handles into this store, which holds their block
// (has, params, body, captured env) — the env is a Map, so like arrays a
// proc lives behind an int handle rather than inside the Val variant.
let proc_store = map_new ();
// proc id -> the block in scope where the proc/lambda was created, so that
// `yield` inside a proc body resolves to the DEFINING method's block (Ruby
// semantics), not the block of whatever method later runs the proc.
let proc_yblk = map_new ();
let yblk_marker = "__yblk__~";
// proc ids created via `lambda` — lambdas check arity strictly on call.
let lambda_ids = map_new ();
// a sentinel prepended to a block's params when a lambda is installed as a
// block (via &lambda): run_block detects it, strips it, and enforces strict
// arity (a lambda yielded to raises ArgumentError on a count mismatch, unlike
// a plain block). This threads lambda-ness through the existing 4-tuple.
let lambda_blk_marker = "__lambda_blk__";
// display name for an anonymous class/module once it is assigned to a
// constant (internal "AnonClass_N"/"AnonModule_N" -> the constant's name).
let anon_name = map_new ();
// a define_method block captures the block active where it was defined, so a
// `yield` inside the defined method reaches that block. Keyed "Cls#name" ->
// VProc of the captured block (installed by invoke when the call site passes
// no block of its own).
let dm_captured = map_new ();
// methods defined via define_method, keyed "Cls#name". A bare (implicit-args)
// `super` inside such a method raises RuntimeError in Ruby, since a block has
// no fixed argument list to forward.
let dm_methods = map_new ();
// an aliased method remembers the class/module its source was defined in,
// keyed "Cls#newname" -> origin class. A `super` inside the aliased method
// resumes above the ORIGIN, not above the class the alias lives in.
let alias_origin = map_new ();
// the original name an alias was made from, keyed "Cls#newname" -> old name,
// so a `super` inside the aliased method searches for the SOURCE method name.
let alias_srcname = map_new ();
// alias_method whose SOURCE is a builtin (e.g. `alias_method :plus, :+` on a
// String subclass): keyed "Cls#newname" -> builtin op name. Dispatched by
// delegating to prim_method on the receiver, since the source has no AST body.
let builtin_alias = map_new ();
// hash handles that originate from keyword-argument syntax (`key: v` / `**h`)
// at a call site, as opposed to a positional `{...}` literal or hash variable.
// Ruby 3.0 keeps these separate: only a kwarg-origin trailing hash binds to a
// method's keyword / **kwrest parameters; a positional hash stays positional.
let kwarg_marks = map_new ();
let mark_kw = fn (id: int) -> let _ = map_set kwarg_marks (str_of_int id) VNil in ();
let is_kw_hash = fn (v: Val) -> match v with VHsh id -> map_has kwarg_marks (str_of_int id) | _ -> false;
// methods marked `ruby2_keywords` (by bare name): a trailing `key:` hash they
// receive into *args keeps its kwarg mark instead of being demoted, so a later
// re-splat forwards it as keywords. Cleared when the method is redefined.
let r2k_methods = map_new ();
// refinements. `refine Target do ... end` (inside a Module.new body) records,
// per refinery module, the target class and a fresh impl class holding the
// refined methods. `using refinery` activates them into ref_active (target
// class name -> impl class name); register_class save/restores ref_active so a
// `using` inside a module body is scoped to that body (Ruby's lexical scope).
let refine_cnt = map_new ();   // "<refinery>"      -> VInt count
let refine_tgt = map_new ();   // "<refinery>#<i>"  -> VStr target class
let refine_cls = map_new ();   // "<refinery>#<i>"  -> VStr impl class
let ref_active = map_new ();   // "<target>"        -> VStr impl class
// per-case memo of #deconstruct / #deconstruct_keys results, so a case with
// several `in` clauses calls the method once (Ruby caches). Keyed by value
// handle; cleared at the start of each case.
let deco_memo = map_new ();
// Binding objects: id -> the captured local-variable env (which already
// holds "self"). `binding` captures the current env; eval(str, b) and
// b.eval(str) re-enter the interpreter against it.
let bind_store = map_new ();
// snapshot a locals env by value: `binding` must capture the scope AS IT IS
// at capture time, isolated from later block-local teardown (drop_created)
// and from same-named variables assigned in an enclosing scope afterward.
// The copy is still a persistent mutable Map, so eval(str, b) can define and
// read locals in the binding's own scope across calls.
let map_copy = fn m ->
  let d = map_new () in
  let _ = map_iter m (fn (k: str) -> fn (v: Val) -> map_set d k v) in
  d;
// read a map whose keys are "0".."n-1" (insertion order) back into a list;
// used to collect map_iter results (which can only side-effect) into an array.
let rec idx_to_list = fn tmp -> fn (i: int) -> fn (n: int) ->
  if i >= n then (Nil : Val list)
  else Cons (map_get tmp (str_of_int i), idx_to_list tmp (i + 1) n);
// monotonic counter for anonymous class/module/Struct names (map_len of a
// store collides before any instance exists — e.g. Class.new(Class.new)
// would name the subclass after its superclass, giving a sup self-loop — so
// draw fresh names from a dedicated counter instead).
let struct_ctr = map_new ();
let fresh_anon = fn (prefix: str) ->
  let n = (if map_has struct_ctr "n" then (match map_get struct_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set struct_ctr "n" (VInt (n + 1)) in
  prefix ++ str_of_int n;
// break-through-yield home tracking: each method invocation gets a unique
// frame id; a block captured by a `&blk` param remembers the frame it was
// passed to (its "home"), so a `break` inside it — even after the block has
// been delegated down through other methods — unwinds to that home method.
let next_fid = fn () ->
  let n = (if map_has struct_ctr "f" then (match map_get struct_ctr "f" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set struct_ctr "f" (VInt (n + 1)) in
  n + 1;
let proc_home = map_new ();     // str(proc id) -> VInt home-frame-id
let pending_home = map_new ();  // single slot: home fid of a &proc being passed as a block
let live_frames = map_new ();   // str(fid) -> VBool true while that method frame is on the stack
let is_anon_cls = fn (c: str) ->
  (str_len c >= 10 && str_eq (substring c 0 10) "AnonClass_") || (str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_");
// name_anon (records a constant name for an anonymous class/module the first
// time it is assigned to a constant) is defined in the mutual-recursion block
// below, since it recurses through the receiver's constants.
// singleton methods on handle-based values (String/Array/Hash): keyed by
// "str:<h>" / "arr:<h>" / "hsh:<h>" -> the value's singleton class name.
let hng_store = map_new ();
// class variables (@@x): "Cls@x" -> value, resolved up the superclass chain.
let cvars = map_new ();
// regex capture-group spans recorded during the latest match attempt
// ("sN"/"eN" -> string index).
let rx_caps = map_new ();
// compiled-regex program cache: "flags<SOH>pattern" -> prog map; rx_bad marks
// patterns the new engine cannot compile (the legacy matcher handles them).
let rx_progs = map_new ();
let rx_bad = map_new ();
// lenient regex-parse mode: set while VALIDATING a regex literal at ruby-parse
// time — constructs the engine does not support yet are accepted (they fall
// back to the legacy matcher at runtime), while truly invalid syntax still
// fails (a Ruby SyntaxError / RegexpError).
let rx_lenient = map_new ();
// regex literals recorded by the ruby parser ("e<i>" -> "flags\nbody", "n" =
// count, "done" = validated prefix); validated right after each parse (eval /
// require / main), so an invalid literal is a parse-time SyntaxError while
// engine-unsupported ones pass (legacy fallback).
let rx_pending = map_new ();
// array handles currently being inspected — breaks self-referential arrays
// (Ruby prints such a cycle as "[...]") instead of recursing forever.
let insp_seen = map_new ();
// nesting depth of active catch(:tag) blocks (throw without any catch
// raises UncaughtThrowError immediately).
let catch_depth = map_new ();
// true while running directly inside a Thread.new block (reset on entering a
// method, which is a return boundary): a bare `return` there is a LocalJumpError.
let thread_flag = map_new ();
// expression-position flow (break/next/redo/return inside an expression)
// unwinds via fail with the kind and value parked here; loop/method/block
// runners catch and convert back into a Flow.
let flow_sig = map_new ();
// flip-flop operator state: one on/off flag per lexical site. Sites are
// numbered at parse time (map_len allocates), so each eval gets fresh ones.
let ff_state = map_new ();
// parser modes: "nobrace" suppresses brace-block attachment (lambda
// parameter defaults — the { after them is the lambda body).
let parser_flags = map_new ();
// parse-time gensym counter for `rescue E => <complex lvalue>`: the exception
// binds to a fresh temp, then a synthesized assignment writes it to the target.
// a block written with an explicit-but-empty parameter list (`{ || ... }`)
// carries this sentinel so the parser can reject a numbered parameter in the
// body (`proc { || _1 }` is a SyntaxError); it is stripped before the block runs.
let empty_bp_marker = "~emptyparams~";
// parse-time gensym for op-assign temporaries (so `(expr)::C op= v` evaluates
// the receiver expression exactly once).
let tmp_ctr = map_new ();
let fresh_tmp = fn () ->
  let n = (if map_has tmp_ctr "n" then (match map_get tmp_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set tmp_ctr "n" (VInt (n + 1)) in
  "~opasgn~" ++ str_of_int n;
let resc_ctr = map_new ();
let fresh_resc = fn () ->
  let n = (if map_has resc_ctr "n" then (match map_get resc_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set resc_ctr "n" (VInt (n + 1)) in
  "__resc~" ++ str_of_int n;
// a non-constant rescue class expression (`rescue rescuer`, `rescue -> {..}.call`)
// is stashed here and referenced from the class list by a "@rexpr~N" sentinel;
// it is evaluated at match time (so `rescue <expr>` runs only when needed).
let resc_exprs = map_new ();
let resc_reg = fn (e: Expr) ->
  let n = (if map_has resc_ctr "e" then (match map_get resc_ctr "e" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set resc_ctr "e" (VInt (n + 1)) in
  let _ = map_set resc_exprs (str_of_int n) e in
  "@rexpr~" ++ str_of_int n;
// require bookkeeping: "dir" = the current file's directory (require_relative
// resolves against it); loaded_files dedups double-loads.
let load_ctx = map_new ();
let loaded_files = map_new ();
// __ENCODING__ is a parse-time constant: the source encoding of the file (or
// eval string) being parsed. The parser captures the current script encoding
// (load_ctx "coding", set before lex/parse by run_prog/require/eval) into the
// EVar name as "__ENCODING__~<NAME>"; eval resolves it to the Encoding object.
let enc_pseudo_var = fn (id: str) ->
  if str_eq id "__ENCODING__" then
    (let c = (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr s -> sget s | _ -> "UTF-8") else "UTF-8") in
     EVar ("__ENCODING__~" ++ (if str_eq c "" then "UTF-8" else c)))
  else EVar id;
// Kernel#ruby_exe support: a redirectable output sink. While io_cap["on"] is
// set, puts/print/p append to io_cap["buf"] instead of the real stdout, so
// __ruby_exe can capture a snippet's output (an in-process approximation of
// mspec's subprocess ruby_exe).
let io_cap = map_new ();
let out_print = fn (s: str) ->
  if map_has io_cap "on" then
    (let cur = (match map_get io_cap "buf" with VStr h -> sget h | _ -> "") in
     map_set io_cap "buf" (mkstr (cur ++ s ++ "\n")))
  else print s;
let out_print_no_nl = fn (s: str) ->
  if map_has io_cap "on" then
    (let cur = (match map_get io_cap "buf" with VStr h -> sget h | _ -> "") in
     map_set io_cap "buf" (mkstr (cur ++ s)))
  else print_no_nl s;
// ENV writes overlay the real environment (there is no setenv extern);
// VNil marks a deleted key. cli_argv holds the script's ARGV.
let env_ovr = map_new ();
let cli_argv = map_new ();
// Encoding.default_internal (nil unless assigned; ENV reads honor it) and
// default_external (UTF-8 unless assigned).
let def_int_enc = map_new ();
let def_ext_enc = map_new ();
let rec strs_to_vals = fn (xs: str list) ->
  match xs with Nil -> (Nil : Val list) | Cons (h, t) -> Cons (mkstr h, strs_to_vals t);
let rec last_slash = fn (s: str) -> fn (i: int) -> fn (best: int) ->
  if i >= str_len s then best
  else last_slash s (i + 1) (if str_eq (char_at s i) "/" then i else best);
let dirname_of = fn (p: str) ->
  let ls = last_slash p 0 (0 - 1) in
  if ls < 0 then "." else substring p 0 ls;
let ends_with_rb = fn (p: str) ->
  str_len p >= 3 && str_eq (substring p (str_len p - 3) (str_len p)) ".rb";
// global variables ($name) live in another top-level captured Map.
let globals = map_new ();
// constants (Capitalized names) live in another; a class name that is not
// an assigned constant reads as VClass.
let consts = map_new ();
// modules mixed into a class via `include`: class name -> "M1|M2|..." of the
// included module names (searched after the class's own methods + ancestors).
let includes = map_new ();
// names declared with `module` (vs `class`) so Module#class differs.
let modules = map_new ();
// private methods: "Cls#name" -> present. Checked only on explicit-receiver
// dispatch (implicit-self calls and send bypass, as in Ruby).
let privates = map_new ();
let protecteds = map_new ();  // protected methods (callable only same-class)
let undefs = map_new ();  // undef'd methods (tombstones that block inheritance)
// prim_method has no `world` to build an exception, so its terminal
// "undefined method" failure parks the method name here; the begin/rescue
// catch site turns it into a proper NoMethodError (Ruby's class for it).
let prim_missing = map_new ();
let is_upper_first = fn (id: str) ->
  str_len id > 0 && (let o = ord (char_at id 0) in o >= 65 && o <= 90);
// Kernel#local_variables: the local names bound in `env`, as symbols in
// insertion order. Internal slots (self, __cref, __for, &block, globals,
// ivars, constants) are hidden so the result matches Ruby's.
let local_vars_of = fn env ->
  let tmp = map_new () in
  let _ = map_iter env (fn (k: str) -> fn (v: Val) ->
    let skip = str_len k == 0
               || (str_len k >= 2 && str_eq (substring k 0 2) "__")
               || str_eq k "self"
               || str_eq (char_at k 0) "&"
               || str_eq (char_at k 0) "$"
               || str_eq (char_at k 0) "@"
               // the numbered-parameter slots _1.._9 are always pre-declared in
               // a block, so hide them (Ruby reports them only when used).
               || (str_len k == 2 && str_eq (char_at k 0) "_" && (let o = ord (char_at k 1) in o >= 49 && o <= 57))
               || is_upper_first k in
    if skip then () else (let m = map_len tmp in map_set tmp (str_of_int m) (VSym k))) in
  arr_new (idx_to_list tmp 0 (map_len tmp));
// iteration budget: a top-level counter ticked once per loop iteration so
// an infinite loop fails fast (a catchable error) instead of hanging.
let step_budget = map_new ();
let tick = fn () ->
  let n = if map_has step_budget "n" then map_get step_budget "n" else 0 in
  if n <= 0 then fail "mere-ruby: iteration limit exceeded (possible infinite loop)"
  else let _ = map_set step_budget "n" (n - 1) in ();

// ---- small helpers ------------------------------------------------------
let rec rev_app = fn xs -> fn acc ->
  match xs with Nil -> acc | Cons (h, t) -> rev_app t (Cons (h, acc));

let is_digit = fn (c: str) -> let o = ord c in o >= 48 && o <= 57;
let is_alpha = fn (c: str) ->
  let o = ord c in (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || o == 95;
let is_alnum = fn (c: str) -> is_digit c || is_alpha c;

// ---- lexer ---------------------------------------------------------------
let rec scan_digits = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_digit (char_at s i) then scan_digits s (i + 1) else i;

let rec scan_ident = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alnum (char_at s i) then scan_ident s (i + 1) else i;

let rec skip_comment = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else skip_comment s (i + 1);

// ---- numeric literals (M7): 0x/0o/0b bases + `_` separators ---------------
let digit_val = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87        // a-f
  else if o >= 65 && o <= 70 then o - 55         // A-F
  else 0 - 1;
let is_base_digit = fn (c: str) -> fn (base: int) ->
  let v = digit_val c in v >= 0 && v < base;
// scan digits of a base, allowing `_` between them.
let rec scan_base = fn (s: str) -> fn (i: int) -> fn (base: int) ->
  if i < str_len s && (is_base_digit (char_at s i) base || str_eq (char_at s i) "_")
  then scan_base s (i + 1) base else i;
// parse [i, end) as a base-N integer, skipping `_`.
let rec parse_base = fn (s: str) -> fn (i: int) -> fn (endp: int) -> fn (base: int) -> fn (acc: int) ->
  if i >= endp then acc
  else
    let c = char_at s i in
    if str_eq c "_" then parse_base s (i + 1) endp base acc
    else parse_base s (i + 1) endp base (acc * base + digit_val c);
let rec strip_us = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else let c = char_at s i in strip_us s (i + 1) (if str_eq c "_" then acc else acc ++ c);

// ---- string interpolation helpers (M11) ---------------------------------
let rec tapp = fn (a: Tok list) -> fn (b: Tok list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, tapp t b);
let rec drop_eof = fn (ts: Tok list) ->
  match ts with Nil -> Nil | Cons (TEOF, _) -> Nil | Cons (h, t) -> Cons (h, drop_eof t);
// find the `}` matching a `#{` (i points just after `#{`), counting nesting.
let rec find_close_brace = fn (s: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len s then i
  else
    let c = char_at s i in
    if str_eq c "\{" then find_close_brace s (i + 1) (depth + 1)
    else if str_eq c "}" then (if depth == 0 then i else find_close_brace s (i + 1) (depth - 1))
    else find_close_brace s (i + 1) depth;

// double-quoted string body: \n \t \\ \" \' decode; an unknown escape
// drops the backslash (Ruby: "\q" == "q"). Returns (decoded, index after
// the closing quote).
let rec lex_dq = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then fail "mere-ruby: unterminated string"
  else
    let c = char_at s i in
    if str_eq c "\"" then (acc, i + 1)
    else if str_eq c "\\" then
      (if i + 1 >= str_len s then fail "mere-ruby: unterminated string"
       else
         let e = char_at s (i + 1) in
         let piece =
           if str_eq e "n" then "\n"
           else if str_eq e "t" then "\t"
           else e in
         lex_dq s (i + 2) (acc ++ piece))
    else lex_dq s (i + 1) (acc ++ c);

// single-quoted string body: only \' and \\ are escapes; anything else
// after a backslash keeps the backslash (Ruby semantics).
let rec lex_sq = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then fail "mere-ruby: unterminated string"
  else
    let c = char_at s i in
    if str_eq c "'" then (acc, i + 1)
    else if str_eq c "\\" && i + 1 < str_len s then
      let e = char_at s (i + 1) in
      if str_eq e "'" || str_eq e "\\" then lex_sq s (i + 2) (acc ++ e)
      else lex_sq s (i + 1) (acc ++ c)
    else lex_sq s (i + 1) (acc ++ c);

let is_punct2 = fn (p: str) ->
  str_eq p "**" || str_eq p "==" || str_eq p "!=" || str_eq p "<=" ||
  str_eq p ">=" || str_eq p "&&" || str_eq p "||" || str_eq p "=>" ||
  str_eq p ".." || str_eq p "<<" || str_eq p ">>" || str_eq p "::" || str_eq p "->" ||
  str_eq p "=~" || str_eq p "!~" || str_eq p "&." ||
  str_eq p "+=" || str_eq p "-=" || str_eq p "*=" || str_eq p "/=" || str_eq p "%=" ||
  str_eq p "|=" || str_eq p "&=" || str_eq p "^=";

let is_punct1 = fn (c: str) ->
  str_eq c "+" || str_eq c "-" || str_eq c "*" || str_eq c "/" ||
  str_eq c "%" || str_eq c "<" || str_eq c ">" || str_eq c "!" ||
  str_eq c "(" || str_eq c ")" || str_eq c "[" || str_eq c "]" ||
  str_eq c "\{" || str_eq c "}" || str_eq c "," || str_eq c "=" ||
  str_eq c "." || str_eq c "|" || str_eq c "&" ||
  str_eq c "?" || str_eq c ":" || str_eq c "~" || str_eq c "^";

// "1" followed by n zeros — denominator for a decimal-fraction Rational literal.
let rec pow10_str = fn (n: int) -> if n <= 0 then "1" else pow10_str (n - 1) ++ "0";

let rec lex_go = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Cons (TEOF, Nil)
  else
    let c = char_at s i in
    if str_eq c " " || str_eq c "\t" || str_eq c "\r" then lex_go s (i + 1)
    else if str_eq c "\n" || str_eq c ";" then Cons (TNL, lex_go s (i + 1))
    else if str_eq c "#" then lex_go s (skip_comment s i)
    else if is_digit c then
      // 0x / 0o / 0b / 0d prefixed integers.
      if str_eq c "0" && i + 1 < str_len s &&
         (let n = char_at s (i + 1) in
          str_eq n "x" || str_eq n "X" || str_eq n "o" || str_eq n "O" ||
          str_eq n "b" || str_eq n "B" || str_eq n "d" || str_eq n "D") then
        let n = char_at s (i + 1) in
        let base = if str_eq n "x" || str_eq n "X" then 16
                   else if str_eq n "o" || str_eq n "O" then 8
                   else if str_eq n "d" || str_eq n "D" then 10 else 2 in
        let j = scan_base s (i + 2) base in
        ri_suffix s j (parse_base s (i + 2) j base 0)
      // leading-zero octal: 017 == 15 (0 then octal digits, not . or e).
      else if str_eq c "0" && i + 1 < str_len s && (let n = char_at s (i + 1) in is_digit n && (if str_eq n "8" || str_eq n "9" then false else true)) then
        let j = scan_base s (i + 1) 8 in
        ri_suffix s j (parse_base s (i + 1) j 8 0)
      else
        // decimal (with `_` separators), optionally a float.
        let j = scan_base s i 10 in
        if j + 1 < str_len s && str_eq (char_at s j) "."
           && is_digit (char_at s (j + 1)) then
          let k0 = scan_base s (j + 1) 10 in
          // exponent: 1.2e-3 / 4.5E+2 / 6.7e8
          let k = scan_exponent s k0 in
          // rational-imaginary literal: 1.2ri == Complex(0, Rational(12, 10)).
          if k == k0 && k0 + 1 < str_len s && str_eq (char_at s k0) "r" && str_eq (char_at s (k0 + 1)) "i"
             && (k0 + 2 >= str_len s || (let nc = char_at s (k0 + 2) in if is_alnum nc || str_eq nc "_" then false else true)) then
            let ip = strip_us (substring s i j) 0 "" in
            let fd = strip_us (substring s (j + 1) k0) 0 "" in
            Cons (TImagRat (ip ++ fd, pow10_str (str_len fd)), lex_go s (k0 + 2))
          // decimal-fraction Rational literal: 0.3r == Rational(3, 10).
          else if k == k0 && k0 < str_len s && str_eq (char_at s k0) "r"
             && (k0 + 1 >= str_len s || (let nc = char_at s (k0 + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            let ip = strip_us (substring s i j) 0 "" in
            let fd = strip_us (substring s (j + 1) k0) 0 "" in
            Cons (TRat (ip ++ fd, pow10_str (str_len fd)), lex_go s (k0 + 1))
          // decimal-fraction Complex literal: 0.6i == Complex(0, 0.6).
          else if k < str_len s && str_eq (char_at s k) "i"
             && (k + 1 >= str_len s || (let nc = char_at s (k + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImagF (float_of_str (strip_us (substring s i k) 0 "")), lex_go s (k + 1))
          else
            Cons (TFlt (float_of_str (strip_us (substring s i k) 0 "")), lex_go s k)
        else
          let je = scan_exponent s j in
          if je > j then
            // exponent + imaginary: 1e1i == Complex(0, 10.0). (1e1r is a
            // syntax error in Ruby, so no rational counterpart here.)
            (if je < str_len s && str_eq (char_at s je) "i"
                && (je + 1 >= str_len s || (let nc = char_at s (je + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
               Cons (TImagF (float_of_str (strip_us (substring s i je) 0 "")), lex_go s (je + 1))
             else Cons (TFlt (float_of_str (strip_us (substring s i je) 0 "")), lex_go s je))
          // rational-imaginary: 1ri == Complex(0, Rational(1, 1)).
          else if j + 1 < str_len s && str_eq (char_at s j) "r" && str_eq (char_at s (j + 1)) "i"
                  && (j + 2 >= str_len s || (let nc = char_at s (j + 2) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImagRat (strip_us (substring s i j) 0 "", "1"), lex_go s (j + 2))
          else if j < str_len s && str_eq (char_at s j) "r"
                  && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TRat (strip_us (substring s i j) 0 "", "1"), lex_go s (j + 1))
          else if j < str_len s && str_eq (char_at s j) "i"
                  && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
            Cons (TImag (parse_base s i j 10 0), lex_go s (j + 1))
          else
            // decimal integer: emit a big-literal token when it exceeds int64.
            let ds = strip_us (substring s i j) 0 "" in
            if str_len ds < 19 || (str_len ds == 19 && str_compare ds "9223372036854775807" <= 0)
            then Cons (TInt (parse_base s i j 10 0), lex_go s j)
            else Cons (TBig ds, lex_go s j)
    else if str_eq c "?" && i + 1 < str_len s &&
            (is_alnum (char_at s (i + 1)) || str_eq (char_at s (i + 1)) "\\") then
      // character literal ?a (or ?\n / ?\t).
      let n = char_at s (i + 1) in
      if str_eq n "\\" && i + 2 < str_len s then
        let e = char_at s (i + 2) in
        let ch = if str_eq e "n" then "\n" else if str_eq e "t" then "\t" else e in
        Cons (TStrL ch, lex_go s (i + 3))
      else Cons (TStrL n, lex_go s (i + 2))
    else if str_eq c "\"" then
      // double-quoted strings support #{expr} interpolation, desugared to a
      // parenthesized concat: `("" + "a" + (expr).to_s + "c")`.
      let (segs, j) = lex_dstr s (i + 1) "" in
      tapp (Cons (TP "(s", Cons (TStrL "", segs))) (Cons (TP ")", lex_go s j))
    else if str_eq c "'" then
      let (lit, j) = lex_sq s (i + 1) "" in
      Cons (TStrL lit, lex_go s j)
    // `cmd` — a command literal: a call to the ` method with the interpolated
    // string (Kernel#` is a stub; specs override it via define_method(:`)).
    else if str_eq c "`" then
      let (segs, j) = lex_dstr_t "`" s (i + 1) "" in
      Cons (TId "`", Cons (TP "(",
        tapp (Cons (TP "(s", Cons (TStrL "", segs)))
             (Cons (TP ")", Cons (TP ")", lex_go s j)))))
    else if is_alpha c then
      let j = scan_ident s i in
      // Ruby method names may end in `?` or `!` (e.g. even?, sort!). Guard
      // `!=`: extend on `!` only when it is not the start of `!=`.
      let j2 =
        if j < str_len s then
          let cj = char_at s j in
          if str_eq cj "?" then j + 1
          else if str_eq cj "!" && (j + 1 >= str_len s || (if str_eq (char_at s (j + 1)) "=" then false else true)) then j + 1
          else j
        else j in
      Cons (TId (substring s i j2), lex_go s j2)
    else if str_eq c "@" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "@" then
      // @@classvar: both @ kept in the identifier text
      let j = scan_ident s (i + 2) in
      Cons (TId (substring s i j), lex_go s j)
    else if str_eq c "@" then
      // @ivar: keep the leading @ in the identifier text
      let j = scan_ident s (i + 1) in
      Cons (TId (substring s i j), lex_go s j)
    else if str_eq c "$" && i + 1 < str_len s && is_alpha (char_at s (i + 1)) then
      // $global: keep the leading $ in the identifier text
      let j = scan_ident s (i + 1) in
      Cons (TId (substring s i j), lex_go s j)
    else if str_eq c "$" && i + 1 < str_len s then
      // special globals ($~ $1 $! $& ...) lex as identifiers (default nil).
      Cons (TId (substring s i (i + 2)), lex_go s (i + 2))
    else if str_eq c ":" && i + 1 < str_len s && is_alpha (char_at s (i + 1)) then
      // :symbol — include a trailing ? ! or = (:even?, :sort!, :m=),
      // guarding != == and the hash rocket =>.
      let j0 = scan_ident s (i + 1) in
      let j =
        if j0 < str_len s then
          let cj = char_at s j0 in
          let nj = if j0 + 1 < str_len s then char_at s (j0 + 1) else "" in
          if str_eq cj "?" then j0 + 1
          else if str_eq cj "!" && (if str_eq nj "=" then false else true) then j0 + 1
          else if str_eq cj "=" && (if str_eq nj "=" || str_eq nj ">" || str_eq nj "~" then false else true) then j0 + 1
          // `:a==>1` — the = joins the symbol when what follows is `=>`.
          else if str_eq cj "=" && str_eq nj "=" && j0 + 2 < str_len s && str_eq (char_at s (j0 + 2)) ">" then j0 + 1
          else j0
        else j0 in
      Cons (TSym (substring s (i + 1) j), lex_go s j)
    else if str_eq c ":" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "'" then
      // :'quoted symbol'
      let (lit, j) = lex_sq s (i + 2) "" in
      Cons (TSym lit, lex_go s j)
    else if str_eq c ":" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "@" && str_eq (char_at s (i + 2)) "@" then
      let j = scan_ident s (i + 3) in
      Cons (TSym (substring s (i + 1) j), lex_go s j)
    else if str_eq c ":" && i + 2 < str_len s
            && (str_eq (char_at s (i + 1)) "@" || str_eq (char_at s (i + 1)) "$")
            && is_alpha (char_at s (i + 2)) then
      let j = scan_ident s (i + 2) in
      Cons (TSym (substring s (i + 1) j), lex_go s j)
    else if str_eq c ":" && i + 1 < str_len s && is_op_sym_start (char_at s (i + 1)) then
      // operator symbols: :=== :== :<=> :+ :[] :[]= etc.
      let (opname, j) = scan_op_sym s (i + 1) in
      Cons (TSym opname, lex_go s j)
    else if str_eq c ":" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\"" &&
            (if i > 0 then (let pc = char_at s (i - 1) in if is_alnum pc || str_eq pc "_" then false else true) else true) then
      // `:"..."` — a plain symbol when the body has no interpolation,
      // otherwise the interpolated string then .to_sym. (A `:` right after an
      // identifier — b:"x" — is a keyword colon, not a symbol.)
      let close = dq_str_end s (i + 2) in
      let body = substring s (i + 2) close in
      if rx_has_interp body 0 then
        let (segs, j) = lex_dstr s (i + 2) "" in
        tapp (Cons (TP "(s", Cons (TStrL "", segs)))
             (Cons (TP ")", Cons (TP ".", Cons (TId "to_sym", lex_go s j))))
      else Cons (TSym (dq_unescape body 0), lex_go s (close + 1))
    else if str_eq c "<" && i + 3 < str_len s && str_eq (char_at s (i + 1)) "<"
            && (str_eq (char_at s (i + 2)) "~" || str_eq (char_at s (i + 2)) "-")
            && (is_alpha (char_at s (i + 3)) || str_eq (char_at s (i + 3)) "\"" || str_eq (char_at s (i + 3)) "'") then
      // heredoc <<~ID / <<-ID: the body starts on the NEXT line and runs to
      // the terminator line. The rest of the current line lexes first, then
      // the body is spliced in as a string token.
      let squiggly = str_eq (char_at s (i + 2)) "~" in
      // the id may be quoted: <<-"HERE" (interp) / <<-'HERE' (raw).
      let q0 = char_at s (i + 3) in
      let quoted = str_eq q0 "\"" || str_eq q0 "'" in
      let idstart = if quoted then i + 4 else i + 3 in
      let idend0 = if quoted then quote_end s idstart q0 else scan_ident s idstart in
      let hid = substring s idstart idend0 in
      let idend = if quoted then idend0 + 1 else idend0 in
      let nl = find_nl s idend in
      let (body, after) = heredoc_body s (nl + 1) hid squiggly in
      let linetoks = drop_eof (lex_go (substring s idend nl) 0) in
      let bodytok = (if quoted && str_eq q0 "'" then Cons (TStrL body, Nil) else heredoc_tok body) in
      tapp bodytok (tapp linetoks (Cons (TNL, lex_go s after)))
    else if str_eq c "<" && i + 3 < str_len s && str_eq (char_at s (i + 1)) "<"
            && (str_eq (char_at s (i + 2)) "\"" || str_eq (char_at s (i + 2)) "'") && regex_position s i then
      // <<"ID" (interpolating) / <<'ID' (raw) quoted heredocs.
      let q = char_at s (i + 2) in
      let idend0 = quote_end s (i + 3) q in
      let hid = substring s (i + 3) idend0 in
      let idend = idend0 + 1 in
      let nl = find_nl s idend in
      let (body, after) = heredoc_body s (nl + 1) hid false in
      let linetoks = drop_eof (lex_go (substring s idend nl) 0) in
      let bodytok = (if str_eq q "'" then Cons (TStrL body, Nil) else heredoc_tok body) in
      tapp bodytok (tapp linetoks (Cons (TNL, lex_go s after)))
    else if str_eq c "<" && i + 2 < str_len s && str_eq (char_at s (i + 1)) "<"
            && is_upper (char_at s (i + 2)) && regex_position s i then
      // bare <<HERE heredoc (an UPPERCASE id in value position; `a << B`
      // shift stays an operator because of the position check).
      let idend = scan_ident s (i + 2) in
      let hid = substring s (i + 2) idend in
      let nl = find_nl s idend in
      let (body, after) = heredoc_body s (nl + 1) hid false in
      let linetoks = drop_eof (lex_go (substring s idend nl) 0) in
      tapp (heredoc_tok body) (tapp linetoks (Cons (TNL, lex_go s after)))
    else if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\n" then
      // a backslash at end of line continues the logical line.
      lex_go s (i + 2)
    else if str_eq c "/" && regex_position s i then
      // a minimal regex literal. With #{...} interpolation it desugars to
      // (string-concat).__regex("flags"); otherwise a plain TRegex token.
      let (lit, fl, j) = scan_regex s (i + 1) "" in
      if rx_has_interp lit 0 then
        let toks = lex_go (rx_interp_src lit) 0 in
        tapp (Cons (TP "(s", drop_eof toks))
             (Cons (TP ")", Cons (TP ".", Cons (TId "__regex", Cons (TP "(", Cons (TStrL fl, Cons (TP ")", lex_go s j)))))))
      else Cons (TRegex (lit, fl), lex_go s j)
    else if str_eq c "%" && percent_body s i >= 0 then
      // %(...) / %q(...) / %Q(...) raw strings; %w(...) a word array.
      let b = percent_body s i in
      let opener = char_at s (b - 1) in
      let (lit, j) = scan_balanced2 s b 1 "" opener (pct_close_of opener) in
      // lowercase %w/%i words are raw; %W/%I words interpolate.
      if is_percent_w s i then
        Cons (TP " [", pw_words (str_eq (char_at s (i + 1)) "W") lit 0 (lex_go s j))
      // %r{...}flags is a regex (with optional interpolation). The body is
      // re-scanned keeping backslashes (%r?\?? is the regex /\?/, so the
      // escape must survive into the pattern, unlike %q string unescaping).
      else if str_eq (char_at s (i + 1)) "r" then
        (let (rlit, rj) = scan_pct_regex s b 1 "" opener (pct_close_of opener) in
         let fj = skip_regex_flags s rj in
         let fl = substring s rj fj in
         if rx_has_interp rlit 0 then
           tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src rlit) 0)))
                (Cons (TP ")", Cons (TP ".", Cons (TId "__regex", Cons (TP "(", Cons (TStrL fl, Cons (TP ")", lex_go s fj)))))))
         else Cons (TRegex (rlit, fl), lex_go s fj))
      // %x{...} is a command literal (same as backticks): a call to the `
      // method with the interpolated body.
      else if str_eq (char_at s (i + 1)) "x" then
        let strexpr =
          if rx_has_interp lit 0 then
            tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src lit) 0))) (Cons (TP ")", Nil))
          else Cons (TStrL lit, Nil) in
        Cons (TId "`", Cons (TP "(", tapp strexpr (Cons (TP ")", lex_go s j))))
      // %s{...} is a symbol; %i{...} a symbol array.
      else if str_eq (char_at s (i + 1)) "s" then Cons (TSym lit, lex_go s j)
      else if str_eq (char_at s (i + 1)) "i" || str_eq (char_at s (i + 1)) "I" then
        Cons (TP " [", pi_words (str_eq (char_at s (i + 1)) "I") lit 0 (lex_go s j))
      // %Q/%(...) interpolate like double-quoted strings; %q stays raw.
      else if (if str_eq (char_at s (i + 1)) "q" then false else true) && rx_has_interp lit 0 then
        tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src lit) 0))) (Cons (TP ")", lex_go s j))
      else Cons (TStrL lit, lex_go s j)
    else
      let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
      if str_eq three "..." || str_eq three "||=" || str_eq three "&&=" ||
         str_eq three "<<=" || str_eq three ">>=" || str_eq three "**=" ||
         str_eq three "<=>" || str_eq three "===" then Cons (TP three, lex_go s (i + 3))
      else
        let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
        if is_punct2 two then Cons (TP two, lex_go s (i + 2))
        else if str_eq c "[" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t") then
          // whitespace before [ distinguishes an argument array literal
          // (x.foo [0]) from indexing (x.foo[0]).
          Cons (TP " [", lex_go s (i + 1))
        else if str_eq c "(" && i > 0 && str_eq (char_at s (i - 1)) " "
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!")) then
          Cons (TP " (", lex_go s (i + 1))
        // ` &x` (space before, none after) directly after an expression-ending
        // token is a command-style block-pass argument (`recv.meth &blk`),
        // distinct from binary `a & b`/`a&b` and from a `, &blk` param/arg
        // (where the preceding token is a comma/paren, not an expression).
        // Emitted as " &" so the operator layer ignores it and the call parser
        // consumes it.
        else if str_eq c "&" && i > 0 && (str_eq (char_at s (i - 1)) " " || str_eq (char_at s (i - 1)) "\t")
                && i + 1 < str_len s
                && (let nc = char_at s (i + 1) in
                    if str_eq nc " " then false else if str_eq nc "\t" then false
                    else if str_eq nc "&" then false else if str_eq nc "=" then false
                    else if str_eq nc "." then false else true)
                && (let pj = prev_nonspace s (i - 1) in
                    pj >= 0 && (let pc = char_at s pj in
                      is_alnum pc || str_eq pc "_" || str_eq pc "?" || str_eq pc "!"
                      || str_eq pc ")" || str_eq pc "]" || str_eq pc "\"")) then
          Cons (TP " &", lex_go s (i + 1))
        else if is_punct1 c then Cons (TP c, lex_go s (i + 1))
        // backslash-newline continues the statement on the next line.
        else if str_eq c "\\" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\n" then
          lex_go s (i + 2)
        else fail ("mere-ruby: unexpected character: " ++ c)

// scan a double-quoted string body from i, returning the token segments
// (each prefixed with `+`) and the index after the closing quote. A
// literal run becomes `+ "run"`; a #{expr} becomes `+ ( <expr> ) . to_s`.
and lex_dstr = fn (s: str) -> fn (i: int) -> fn (lit: str) -> lex_dstr_t "\"" s i lit

// like lex_dstr but with a caller-chosen terminator char (`"` for strings,
// backtick for command literals) — same interpolation/escape handling.
and lex_dstr_t = fn (term: str) -> fn (s: str) -> fn (i: int) -> fn (lit: str) ->
  if i >= str_len s then fail "mere-ruby: unterminated string"
  else
    let c = char_at s i in
    if str_eq c term then (Cons (TP "+", Cons (TStrL lit, Nil)), i + 1)
    else if str_eq c "\\" && i + 1 < str_len s then
      let e = char_at s (i + 1) in
      if str_eq e "u" && i + 2 < str_len s && str_eq (char_at s (i + 2)) "\{" then
        // \u{XXXX ...} — braced codepoint(s), space-separated.
        let (bytes, j) = scan_u_braced s (i + 3) "" 0 in
        lex_dstr_t term s j (lit ++ bytes)
      else if str_eq e "u" && i + 5 < str_len s then
        // \uXXXX — emit UTF-8 bytes for the codepoint.
        let cp = hex4 s (i + 2) in
        lex_dstr_t term s (i + 6) (lit ++ utf8_of cp)
      // \xHH — one byte from up to two hex digits.
      else if str_eq e "x" && i + 2 < str_len s && is_hex_digit (char_at s (i + 2)) then
        let d1 = hex_val (char_at s (i + 2)) in
        if i + 3 < str_len s && is_hex_digit (char_at s (i + 3)) then
          lex_dstr_t term s (i + 4) (lit ++ chr (d1 * 16 + hex_val (char_at s (i + 3))))
        else lex_dstr_t term s (i + 3) (lit ++ chr d1)
      // \NNN — one byte from up to three octal digits.
      else if e >= "0" && e <= "7" then
        let (val, j) = scan_octal s (i + 1) 0 0 in
        lex_dstr_t term s j (lit ++ chr val)
      else
      let piece = if str_eq e "n" then "\n" else if str_eq e "t" then "\t"
                  else if str_eq e "r" then chr 13 else if str_eq e "e" then chr 27
                  else if str_eq e "a" then chr 7 else if str_eq e "b" then chr 8
                  else if str_eq e "f" then chr 12 else if str_eq e "v" then chr 11
                  else if str_eq e "0" then chr 0 else if str_eq e "s" then " "
                  else e in
      lex_dstr_t term s (i + 2) (lit ++ piece)
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      let close = find_close_brace s (i + 2) 0 in
      let exprtoks = drop_eof (lex_go (substring s (i + 2) close) 0) in
      let interp =
        Cons (TP "+", Cons (TP "(",
          tapp exprtoks (Cons (TP ")", Cons (TP ".", Cons (TId "to_s", Nil)))))) in
      let (rest, j) = lex_dstr_t term s (close + 1) "" in
      (Cons (TP "+", Cons (TStrL lit, tapp interp rest)), j)
    else lex_dstr_t term s (i + 1) (lit ++ c)

// \u{XXXX YYYY ...}: hex codepoints (space-separated) up to the closing
// brace; returns the UTF-8 bytes and the index after the "}".
and scan_u_braced = fn (s: str) -> fn (i: int) -> fn (acc: str) -> fn (cp: int) ->
  if i >= str_len s then fail "mere-ruby: unterminated backslash-u"
  else
    let c = char_at s i in
    if str_eq c "}" then (acc ++ (if cp > 0 then utf8_of cp else ""), i + 1)
    else if str_eq c " " then scan_u_braced s (i + 1) (acc ++ (if cp > 0 then utf8_of cp else "")) 0
    else if is_hex_digit c then scan_u_braced s (i + 1) acc (cp * 16 + hex_val c)
    else fail "mere-ruby: bad backslash-u"

// %(…) / %q(…) / %Q(…) / %w(…): index of the body start, or -1 when the
// % is just the modulo operator.
and percent_body = fn (s: str) -> fn (i: int) ->
  if i + 1 >= str_len s then 0 - 1
  else
    let c1 = char_at s (i + 1) in
    // Bracket delimiters ( { [ < are unambiguous openers. Other clean
    // delimiters (', |, / ...) start a bare percent string only in value
    // position, to avoid stealing the modulo operator.
    if is_pct_open c1 then i + 2
    else if is_pct_delim c1 && regex_position s i then i + 2
    else if (str_eq c1 "q" || str_eq c1 "Q" || str_eq c1 "w" || str_eq c1 "i" || str_eq c1 "s" ||
             str_eq c1 "W" || str_eq c1 "I" || str_eq c1 "r" || str_eq c1 "x")
            && i + 2 < str_len s && is_pct_delim (char_at s (i + 2)) then i + 3
    else 0 - 1

// a percent-literal delimiter: any non-alphanumeric, non-space char.
and is_pct_delim = fn (c: str) ->
  // any non-alnum, non-whitespace char; _ and = are valid Ruby delimiters
  // (the bare-% form is still guarded by regex_position at the caller).
  str_eq c "_" || str_eq c "=" ||
  ((if is_alnum c then false else true) &&
   (if str_eq c " " || str_eq c "\t" || str_eq c "\n" then false else true))

and is_pct_open = fn (c: str) -> str_eq c "(" || str_eq c "\{" || str_eq c "[" || str_eq c "<"

and pct_close_of = fn (c: str) ->
  if str_eq c "(" then ")" else if str_eq c "\{" then "}"
  else if str_eq c "[" then "]" else if str_eq c "<" then ">" else c

and is_percent_w = fn (s: str) -> fn (i: int) ->
  i + 1 < str_len s && (str_eq (char_at s (i + 1)) "w" || str_eq (char_at s (i + 1)) "W")

// raw scan to the balanced closing delimiter; returns (body, index-after).
and rx_is_meta = fn (c: str) ->
  str_eq c "$" || str_eq c "^" || str_eq c "*" || str_eq c "+" || str_eq c "." ||
  str_eq c "?" || str_eq c "|" || str_eq c "}" || str_eq c ")" || str_eq c ">" ||
  str_eq c "]" || str_eq c "(" || str_eq c "\{" || str_eq c "[" || str_eq c "<" || str_eq c "\\"

// like scan_balanced2 but for %r regex bodies: an escaped delimiter keeps
// its backslash only when the delimiter is a regex metacharacter (%r(\() is
// /\(/ but %r-\-- is /-/, matching Ruby's source normalization); any other
// backslash pair is copied verbatim for the regex parser.
and scan_pct_regex = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then fail "mere-ruby: unterminated %r literal"
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (let nx = char_at s (i + 1) in
       if (str_eq nx op || str_eq nx clo) && (if rx_is_meta nx then false else true) then
         scan_pct_regex s (i + 2) depth (acc ++ nx) op clo
       else scan_pct_regex s (i + 2) depth (acc ++ c ++ nx) op clo)
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_pct_regex s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_pct_regex s (i + 1) (depth - 1) (acc ++ c) op clo)
    else scan_pct_regex s (i + 1) depth (acc ++ c) op clo

and scan_balanced2 = fn (s: str) -> fn (i: int) -> fn (depth: int) -> fn (acc: str) -> fn (op: str) -> fn (clo: str) ->
  if i >= str_len s then fail "mere-ruby: unterminated % literal"
  else
    let c = char_at s i in
    // a backslash escapes the delimiter (and itself) inside the body.
    if str_eq c "\\" && i + 1 < str_len s &&
       (str_eq (char_at s (i + 1)) op || str_eq (char_at s (i + 1)) clo || str_eq (char_at s (i + 1)) "\\") then
      scan_balanced2 s (i + 2) depth (acc ++ char_at s (i + 1)) op clo
    // when open and close differ (brackets) nesting counts; otherwise the
    // first delimiter closes.
    else if str_eq c op && (if str_eq op clo then false else true) then
      scan_balanced2 s (i + 1) (depth + 1) (acc ++ c) op clo
    else if str_eq c clo then
      (if depth == 1 then (acc, i + 1) else scan_balanced2 s (i + 1) (depth - 1) (acc ++ c) op clo)
    else scan_balanced2 s (i + 1) depth (acc ++ c) op clo

// %w body -> `"w1", "w2", ... ]` token run (the caller emits the `[`).
// A backslash escapes the next character into the word (b\ c, b\<nl>c).
and pw_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pw_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pw_tok interp w (Cons (TP "]", rest))
    else pw_tok interp w (Cons (TP ",", pw_words interp t k rest))

// %i body -> `:w1, :w2, ... ]` token run (symbol words).
and pi_words = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn rest ->
  if i >= str_len t then Cons (TP "]", rest)
  else if str_eq (char_at t i) " " || str_eq (char_at t i) "\n" then pi_words interp t (i + 1) rest
  else
    let (w, j) = pw_word interp t i "" in
    let k = pw_skip t j in
    if k >= str_len t then pi_tok interp w (Cons (TP "]", rest))
    else pi_tok interp w (Cons (TP ",", pi_words interp t k rest))

// one %I/%W word: an interpolated word desugars through the string lexer.
and pi_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && rx_has_interp w 0 then
    Cons (TP "(s", tapp (drop_eof (lex_go (rx_interp_src w) 0))
      (Cons (TP ")", Cons (TP ".", Cons (TId "to_sym", rest)))))
  else Cons (TSym w, rest)

and pw_tok = fn (interp: bool) -> fn (w: str) -> fn rest ->
  if interp && rx_has_interp w 0 then
    Cons (TP "(s", tapp (drop_eof (lex_go (rx_interp_src w) 0)) (Cons (TP ")", rest)))
  else Cons (TStrL w, rest)

and pw_word = fn (interp: bool) -> fn (t: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len t then (acc, i)
  else
    let c = char_at t i in
    // In %W/%I (interp) a backslash-escape expands C-style (\t \n \s);
    // in %w/%i it keeps the next character literally (\ joins words).
    if str_eq c "\\" && i + 1 < str_len t then
      let nx = char_at t (i + 1) in
      let piece = (if interp then
                     (if str_eq nx "t" then "\t" else if str_eq nx "n" then "\n"
                      else if str_eq nx "s" then " " else if str_eq nx "r" then "\r"
                      else if str_eq nx "e" then chr 27 else nx)
                   // %w keeps a literal backslash except before space / \ / nl.
                   else if str_eq nx " " || str_eq nx "\\" || str_eq nx "\n" then nx
                   else "\\" ++ nx) in
      pw_word interp t (i + 2) (acc ++ piece)
    else if str_eq c " " || str_eq c "\n" then (acc, i)
    else pw_word interp t (i + 1) (acc ++ c)

and pw_skip = fn (t: str) -> fn (j: int) ->
  if j < str_len t && (str_eq (char_at t j) " " || str_eq (char_at t j) "\n") then pw_skip t (j + 1) else j

// index after an e/E exponent suffix at i, or i when there is none.
and scan_exponent = fn (s: str) -> fn (i: int) ->
  if i < str_len s && (str_eq (char_at s i) "e" || str_eq (char_at s i) "E") then
    let j = (if i + 1 < str_len s && (str_eq (char_at s (i + 1)) "-" || str_eq (char_at s (i + 1)) "+") then i + 2 else i + 1) in
    (if j < str_len s && is_digit (char_at s j) then scan_base s j 10 else i)
  else i

// emit an integer literal with an optional `r` (Rational) / `i` (Complex)
// suffix; used for the hex/octal/binary paths (the decimal path inlines it).
and ri_suffix = fn (s: str) -> fn (j: int) -> fn (v: int) ->
  if j < str_len s && str_eq (char_at s j) "r"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TRat (str_of_int v, "1"), lex_go s (j + 1))
  else if j < str_len s && str_eq (char_at s j) "i"
     && (j + 1 >= str_len s || (let nc = char_at s (j + 1) in if is_alnum nc || str_eq nc "_" then false else true)) then
    Cons (TImag v, lex_go s (j + 1))
  else Cons (TInt v, lex_go s j)

and is_upper = fn (c: str) -> let o = ord c in o >= 65 && o <= 90

and quote_end = fn (s: str) -> fn (i: int) -> fn (q: str) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) q then i
  else quote_end s (i + 1) q

and hexv = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 102 then o - 87
  else if o >= 65 && o <= 70 then o - 55
  else 0

// up to 3 octal digits from i; returns (value, index-after).
and scan_octal = fn (s: str) -> fn (i: int) -> fn (acc: int) -> fn (n: int) ->
  if n >= 3 || i >= str_len s then (acc, i)
  else
    let c = char_at s i in
    if c >= "0" && c <= "7" then scan_octal s (i + 1) (acc * 8 + (ord c - 48)) (n + 1)
    else (acc, i)

// index of the closing double-quote of a string body starting at i.
and dq_str_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\\" && i + 1 < str_len s then dq_str_end s (i + 2)
  else if str_eq (char_at s i) "\"" then i
  else dq_str_end s (i + 1)

// unescape the common backslash escapes in a plain quoted symbol body.
and dq_unescape = fn (body: str) -> fn (i: int) ->
  if i >= str_len body then ""
  else
    let c = char_at body i in
    if str_eq c "\\" && i + 1 < str_len body then
      let e = char_at body (i + 1) in
      let piece = (if str_eq e "n" then "\n" else if str_eq e "t" then "\t" else e) in
      piece ++ dq_unescape body (i + 2)
    else c ++ dq_unescape body (i + 1)

and is_hex_digit = fn (c: str) ->
  (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
and hex_val = fn (c: str) ->
  if c >= "0" && c <= "9" then ord c - 48
  else if c >= "a" && c <= "f" then ord c - 87
  else if c >= "A" && c <= "F" then ord c - 55
  else 0

and hex4 = fn (s: str) -> fn (i: int) ->
  hexv (char_at s i) * 4096 + hexv (char_at s (i + 1)) * 256 +
  hexv (char_at s (i + 2)) * 16 + hexv (char_at s (i + 3))

and utf8_of = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + (cp - cp / 64 * 64))
  else chr (224 + cp / 4096) ++ chr (128 + (cp / 64 - cp / 4096 * 64)) ++ chr (128 + (cp - cp / 64 * 64))

// heredoc body as token(s): interpolated bodies route through the
// double-quoted string lexer.
and heredoc_tok = fn (body0: str) ->
  let body = hd_line_cont body0 0 in
  if rx_has_interp body 0 then
    tapp (Cons (TP "(s", drop_eof (lex_go (rx_interp_src body) 0))) (Cons (TP ")", Nil))
  else Cons (TStrL body, Nil)

// backslash-newline in an interpolating heredoc is a line continuation
// (dropped); an escaped backslash stays.
and hd_line_cont = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then
      (if str_eq (char_at s (i + 1)) "\n" then hd_line_cont s (i + 2)
       else c ++ char_at s (i + 1) ++ hd_line_cont s (i + 2))
    else c ++ hd_line_cont s (i + 1)

and find_nl = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i
  else find_nl s (i + 1)

// collect heredoc lines from `i` until the terminator line; returns
// (body, index-after-terminator-line). squiggly strips the common indent.
and heredoc_body = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (squiggly: bool) ->
  let (lines, after) = heredoc_lines s i hid Nil in
  let body = if squiggly then hd_join (hd_strip lines (hd_min_indent lines 9999)) else hd_join lines in
  (body, after)

and heredoc_lines = fn (s: str) -> fn (i: int) -> fn (hid: str) -> fn (acc: str list) ->
  if i >= str_len s then (rev_app_str acc Nil, i)
  else
    let nl = find_nl s i in
    let line = substring s i nl in
    if str_eq (hd_lstrip line) hid then (rev_app_str acc Nil, if nl < str_len s then nl + 1 else nl)
    else heredoc_lines s (if nl < str_len s then nl + 1 else nl) hid (Cons (line, acc))

and rev_app_str = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_app_str t (Cons (h, acc))

and hd_lstrip = fn (line: str) ->
  if str_len line > 0 && (str_eq (char_at line 0) " " || str_eq (char_at line 0) "\t")
  then hd_lstrip (substring line 1 (str_len line)) else line

and hd_indent_of = fn (line: str) -> fn (n: int) ->
  if n < str_len line && str_eq (char_at line n) " " then hd_indent_of line (n + 1) else n

and hd_min_indent = fn (lines: str list) -> fn (best: int) ->
  match lines with
  | Nil -> best
  | Cons (l, r) ->
    if str_eq (hd_lstrip l) "" then hd_min_indent r best
    else let ind = hd_indent_of l 0 in hd_min_indent r (if ind < best then ind else best)

and hd_strip = fn (lines: str list) -> fn (n: int) ->
  match lines with
  | Nil -> Nil
  | Cons (l, r) ->
    let l2 = if str_len l >= n then substring l n (str_len l) else "" in
    Cons (l2, hd_strip r n)

and hd_join = fn (lines: str list) ->
  match lines with Nil -> "" | Cons (l, r) -> l ++ "\n" ++ hd_join r

and is_op_sym_start = fn (c: str) ->
  str_eq c "=" || str_eq c "<" || str_eq c ">" || str_eq c "+" || str_eq c "-" ||
  str_eq c "*" || str_eq c "/" || str_eq c "%" || str_eq c "[" || str_eq c "!" ||
  str_eq c "^" || str_eq c "&" || str_eq c "|" || str_eq c "~" || str_eq c "`"

// scan the longest operator name after a `:` (3, then 2, then 1 chars; []=
// and [] as special cases).
and scan_op_sym = fn (s: str) -> fn (i: int) ->
  let three = if i + 3 <= str_len s then substring s i (i + 3) else "" in
  let two = if i + 2 <= str_len s then substring s i (i + 2) else "" in
  if str_eq three "===" || str_eq three "<=>" || str_eq three "[]=" || str_eq three "**=" then (three, i + 3)
  else if str_eq two "==" || str_eq two "!=" || str_eq two "<=" || str_eq two ">=" ||
          str_eq two "<<" || str_eq two ">>" || str_eq two "**" || str_eq two "[]" ||
          str_eq two "=~" then (two, i + 2)
  else (substring s i (i + 1), i + 1)

// split a scoped constant name at the LAST `::`: recv part and const name.
and scoped_split = fn (name: str) -> fn (i: int) -> fn (last: int) ->
  if i + 1 >= str_len name then last
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then scoped_split name (i + 2) i
  else scoped_split name (i + 1) last
and recv_of_scoped = fn (name: str) -> substring name 0 (scoped_split name 0 0)
and const_of_scoped = fn (name: str) -> substring name (scoped_split name 0 0 + 2) (str_len name)

// index of the FIRST `::` in a scoped name, or -1.
and first_colon2 = fn (name: str) -> fn (i: int) ->
  if i + 1 >= str_len name then (0 - 1)
  else if str_eq (char_at name i) ":" && str_eq (char_at name (i + 1)) ":" then i
  else first_colon2 name (i + 1)

// `module m::N` where the leftmost segment names a local variable holding a
// class/module: rewrite the name to that class's real name (m -> AnonModule_k)
// so the definition registers under it, not under the literal variable name.
and resolve_scoped_base = fn env -> fn (name: str) ->
  let i = first_colon2 name 0 in
  if i < 0 then name
  else
    let head = substring name 0 i in
    if map_has env head then
      (match map_get env head with VClass c -> c ++ "::" ++ substring name (i + 2) (str_len name) | _ -> name)
    else name

and rx_has_interp = fn (lit: str) -> fn (i: int) ->
  if i + 1 >= str_len lit then false
  // escapes take precedence over interpolation: \#{ is a literal #, and the
  // control escapes \c? / \C-? consume the char after them (so /\c#{s}/ has
  // NO interpolation — the # is the control character's argument).
  else if str_eq (char_at lit i) "\\" then
    (let e = (if i + 1 < str_len lit then char_at lit (i + 1) else "") in
     if str_eq e "c" then rx_has_interp lit (i + 3)
     else if str_eq e "C" then rx_has_interp lit (i + 4)
     else rx_has_interp lit (i + 2))
  else if str_eq (char_at lit i) "#" && str_eq (char_at lit (i + 1)) "\{" then true
  else rx_has_interp lit (i + 1)

// rebuild the regex body as double-quoted-string SOURCE so the normal
// interpolation lexer produces the concat tokens.
and rx_interp_src = fn (lit: str) ->
  "\"" ++ rx_escape_dq lit 0 ++ "\""

and rx_escape_dq = fn (lit: str) -> fn (i: int) ->
  if i >= str_len lit then ""
  else
    let c = char_at lit i in
    // an interpolation is code: copy it verbatim (its own quotes/escapes
    // must reach the code lexer untouched).
    if str_eq c "#" && i + 1 < str_len lit && str_eq (char_at lit (i + 1)) "\{" then
      let j = interp_close lit (i + 2) 1 in
      substring lit i j ++ rx_escape_dq lit j
    else if str_eq c "\"" then "\\\"" ++ rx_escape_dq lit (i + 1)
    else if str_eq c "\\" && i + 1 < str_len lit then
      // keep regex escapes as-is through the string lexer
      "\\\\" ++ char_at lit (i + 1) ++ rx_escape_dq lit (i + 2)
    else c ++ rx_escape_dq lit (i + 1)

// index just past the `}` closing an interpolation (brace depth counting).
and interp_close = fn (lit: str) -> fn (i: int) -> fn (depth: int) ->
  if i >= str_len lit then i
  else if str_eq (char_at lit i) "\{" then interp_close lit (i + 1) (depth + 1)
  else if str_eq (char_at lit i) "}" then
    (if depth == 1 then i + 1 else interp_close lit (i + 1) (depth - 1))
  else interp_close lit (i + 1) depth

// is the / at i in a value position (a regex) rather than a division?
and regex_position = fn (s: str) -> fn (i: int) ->
  let p = prev_nonspace s (i - 1) in
  if p < 0 then true
  else
    let c = char_at s p in
    if str_eq c "(" || str_eq c "," || str_eq c "=" || str_eq c "~" ||
       str_eq c "!" || str_eq c "|" || str_eq c "&" || str_eq c "\n" || str_eq c ";" ||
       str_eq c "<" || str_eq c "[" || str_eq c "\{" ||
       // ternary branches: `c ? /re/ : /re/` — a `/` after `?` or `:` starts a regex.
       str_eq c "?" || str_eq c ":" then true
    else if is_alpha c then
      // after a keyword (when /re/, match =~ style) it's a regex too.
      let w = word_ending_at s p in
      str_eq w "when" || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
      str_eq w "then" || str_eq w "return" || str_eq w "if" || str_eq w "unless" ||
      // `in /re/` — a pattern-matching clause takes a regex value pattern.
      str_eq w "in"
    else false

and word_ending_at = fn (s: str) -> fn (p: int) ->
  let b = word_start s p in
  substring s b (p + 1)

and word_start = fn (s: str) -> fn (p: int) ->
  if p > 0 && (is_alnum (char_at s (p - 1)) || str_eq (char_at s (p - 1)) "_")
  then word_start s (p - 1) else p

and prev_nonspace = fn (s: str) -> fn (i: int) ->
  if i < 0 then 0 - 1
  else if str_eq (char_at s i) " " then prev_nonspace s (i - 1)
  else i

and is_lparen = fn (p: str) -> str_eq p "(" || str_eq p " ("

// scan the regex body to the closing unescaped /, returning the trailing
// flags ("im"...) alongside the body and the resume position.
and scan_regex = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then fail "mere-ruby: unterminated regex"
  else
    let c = char_at s i in
    if str_eq c "\\" && i + 1 < str_len s then scan_regex s (i + 2) (acc ++ c ++ char_at s (i + 1))
    // a #{...} interpolation is copied whole — its content may contain `/`
    // (even a nested regex literal, /#{/./}/), which must not close ours.
    else if str_eq c "#" && i + 1 < str_len s && str_eq (char_at s (i + 1)) "\{" then
      (let close = find_close_brace s (i + 2) 0 in
       scan_regex s (close + 1) (acc ++ substring s i (close + 1)))
    else if str_eq c "/" then
      (let fj = skip_regex_flags s (i + 1) in
       (acc, substring s (i + 1) fj, fj))
    else scan_regex s (i + 1) (acc ++ c)

and skip_regex_flags = fn (s: str) -> fn (i: int) ->
  if i < str_len s && is_alpha (char_at s i) then
    (let c = char_at s i in
     if str_eq c "i" || str_eq c "m" || str_eq c "x" || str_eq c "o" ||
        str_eq c "u" || str_eq c "n" || str_eq c "s" || str_eq c "e"
     then skip_regex_flags s (i + 1)
     else fail ("mere-ruby: unknown regexp option - " ++ c))
  else i;

// ---- parser (precedence climbing) ---------------------------------------
let is_keyword = fn (id: str) ->
  str_eq id "puts" || str_eq id "if" || str_eq id "unless" ||
  str_eq id "elsif" || str_eq id "else" || str_eq id "end" ||
  str_eq id "while" || str_eq id "until" || str_eq id "case" ||
  str_eq id "when" || str_eq id "then" || str_eq id "do" ||
  str_eq id "def" || str_eq id "return" || str_eq id "class" ||
  str_eq id "module" ||
  str_eq id "self" || str_eq id "yield" ||
  str_eq id "begin" || str_eq id "rescue" || str_eq id "ensure" ||
  str_eq id "raise" || str_eq id "break" || str_eq id "next" ||
  str_eq id "true" || str_eq id "false" || str_eq id "nil";

// a capitalized bare identifier is a constant (a class reference here).
let is_cap = fn (id: str) ->
  let o = ord (char_at id 0) in o >= 65 && o <= 90;

// an @-prefixed identifier is an instance variable.
let is_ivar = fn (id: str) -> str_len id > 0 && str_eq (char_at id 0) "@";

// keywords that close (or continue) an enclosing block: statement lists
// stop before them without consuming.
let is_block_stop = fn (id: str) ->
  str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
  str_eq id "rescue" || str_eq id "ensure" ||
  // `in` starts the next clause of a case/in; it never begins a statement.
  str_eq id "in";

// keywords that end an optional value (for break/next/return): block
// closers plus trailing statement modifiers (`next if c`, `break unless c`).
let stops_value = fn (id: str) ->
  is_block_stop id || str_eq id "if" || str_eq id "unless" ||
  str_eq id "while" || str_eq id "until";

// op-assign token -> the base operator (`+=` -> `+`), or "" if not one.
// an attribute-writer method name: ends in '=' but is not ==, !=, <=, >=.
let is_setter_name = fn (name: str) ->
  str_len name > 1 && str_eq (char_at name (str_len name - 1)) "=" &&
  (if str_eq name "==" || str_eq name "!=" || str_eq name "<=" || str_eq name ">=" then false else true);

let opassign_base = fn (p: str) ->
  if str_eq p "+=" then "+" else if str_eq p "-=" then "-"
  else if str_eq p "*=" then "*" else if str_eq p "/=" then "/"
  else if str_eq p "%=" then "%" else if str_eq p "**=" then "**"
  else if str_eq p "<<=" then "<<" else if str_eq p ">>=" then ">>"
  else if str_eq p "||=" then "||"
  else if str_eq p "&&=" then "&&"
  else if str_eq p "|=" then "|" else if str_eq p "&=" then "&"
  else if str_eq p "^=" then "^" else "";

// Binary precedence, Ruby's order (subset). 0 = not a binary operator.
// ** is handled separately (tighter than unary minus on its left, so
// -2**2 == -(2**2) == -4, and right-associative: 2**3**2 == 512).
// binary operator precedence (higher binds tighter), matching Ruby:
// || < && < equality < comparison < | ^ < & < shift < +- < */% < **
let prec_of = fn (op: str) ->
  if str_eq op "||" then 1
  else if str_eq op "&&" then 2
  else if str_eq op "==" || str_eq op "!=" || str_eq op "<=>" || str_eq op "===" then 3
  else if str_eq op "=~" || str_eq op "!~" then 3
  else if str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=" then 4
  else if str_eq op "|" || str_eq op "^" then 5
  else if str_eq op "&" then 6
  else if str_eq op "<<" || str_eq op ">>" then 7
  else if str_eq op "+" || str_eq op "-" then 8
  else if str_eq op "*" || str_eq op "/" || str_eq op "%" then 9
  else if str_eq op "**" then 10
  else 0;

let expect = fn toks -> fn (want: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p want then r else fail ("mere-ruby: expected " ++ want ++ ", got " ++ p)
  | _ -> fail ("mere-ruby: expected " ++ want);

// pure token helpers, defined before the parser group so both the
// expression and statement parsers (one merged group) can use them.
let expect_end = fn toks ->
  match toks with
  | Cons (TNL, r) -> r
  | Cons (TEOF, _) -> toks
  // a statement may also be terminated by a block-closing keyword on the
  // same line (e.g. `def m() 1 end`), left unconsumed for the caller.
  | Cons (TId id, _) ->
    if str_eq id "end" || str_eq id "else" || str_eq id "elsif" || str_eq id "when" ||
       str_eq id "rescue" || str_eq id "ensure"
    then toks else fail "mere-ruby: expected end of statement"
  | _ -> fail "mere-ruby: expected end of statement";

let expect_kw = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id kw then r
    else fail ("mere-ruby: expected " ++ kw ++ ", got " ++ id)
  | _ -> fail ("mere-ruby: expected " ++ kw);

// optional `then` (after if/elsif/when conditions) or `do` (after
// while/until conditions) before the newline.
let skip_then = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "then" || str_eq id "do" then r else toks
  // `if cond;\n then body` — a `then` after a newline is still redundant.
  | Cons (TNL, r) ->
    (match r with
     | Cons (TId id, r2) -> if str_eq id "then" then r2 else toks
     | _ -> toks)
  | _ -> toks;

let rec skip_nls = fn toks ->
  match toks with Cons (TNL, r) -> skip_nls r | _ -> toks;

// a range `lo..hi` / `lo...hi` sits above the binary operators (very low
// precedence in Ruby).
let rec parse_expr = fn toks ->
  let (cond, r) = parse_range toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op "?" then
      let (then_e, r2) = parse_expr rest in
      (match r2 with
       | Cons (TP colon, r3) ->
         if str_eq colon ":" then let (else_e, r4) = parse_expr r3 in (ETern (cond, then_e, else_e), r4)
         else fail "mere-ruby: expected : in ternary"
       | _ -> fail "mere-ruby: expected : in ternary")
    else (cond, r)
  | _ -> (cond, r)

and list_append_str = fn (xs: str list) -> fn (ys: str list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_str t ys)

and eapp = fn (xs: Expr list) -> fn (ys: Expr list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, eapp t ys)

// bare lambda params: `-> x, y { ... }` (up to the block opener).
// if the LAST default expr is a call that captured a block, strip the
// block off and hand it back (it was really the lambda's body).
and last_default_block = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> (false, (Nil : (str * Expr) list), (Nil : str list), (Nil : Stmt list))
  | Cons ((n, d), Nil) ->
    (match d with
     | ECallB (cn, cargs, cbp, cbb) ->
       (true, Cons ((n, ECall (cn, cargs)), Nil), cbp, cbb)
     | EMethodB (crecv, cn, cargs, cbp, cbb) ->
       (true, Cons ((n, EMethod (crecv, cn, cargs)), Nil), cbp, cbb)
     | _ -> (false, Cons ((n, d), Nil), Nil, Nil))
  | Cons (h, t) ->
    (match last_default_block t with
     | (ok, t2, sbp, sbb) -> (ok, Cons (h, t2), sbp, sbb))

and psplat_any = fn (ps: str list) ->
  match ps with
  | Nil -> false
  | Cons (p, r) -> (str_len p > 0 && str_eq (char_at p 0) "*") || psplat_any r

// the defaults for plain (non-keyword) names; kw defaults are keyed "k:".
and plain_defaults = fn (ds: (str * Expr) list) ->
  match ds with
  | Nil -> Nil
  | Cons ((n, d), r) ->
    if str_len n > 0 && str_eq (char_at n (str_len n - 1)) ":" then plain_defaults r
    else Cons ((n, d), plain_defaults r)

and lambda_bare_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    // `-> a=default { ... }` — an optional bare parameter. The default
    // parses with brace-blocks off: the { belongs to the lambda body.
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let _ = map_set parser_flags "nobrace" VNil in
         let (d, r3) = parse_bin r2 6 in
         let _ = map_delete parser_flags "nobrace" in
         lambda_bare_after n r3 acc (Cons ((n, d), ds))
       else lambda_bare_after n r acc ds
     | _ -> lambda_bare_after n r acc ds)
  // `-> *args, **kwargs { ... }` — splat / kw-splat / block-pass params.
  | Cons (TP st, r) ->
    if str_eq st "*" || str_eq st "**" || str_eq st "&" then
      (match r with
       | Cons (TId n, r2) -> lambda_bare_after (st ++ n) r2 acc ds
       | _ -> lambda_bare_after st r acc ds)
    else (rev_app acc Nil, rev_app ds Nil, toks)
  | _ -> (rev_app acc Nil, rev_app ds Nil, toks)

and lambda_bare_after = fn (n: str) -> fn r -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match r with
  | Cons (TP c, r2) ->
    if str_eq c "," then lambda_bare_params r2 (Cons (n, acc)) ds
    else (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, rev_app ds Nil, r)

// the inside of ( ... ): an and/or expression, optionally with a trailing
// statement modifier — `(i += 1 until i > 9)` is a while-statement value.
// A leading break/next/return statement (with its modifier) also works:
// `(break 123 until false)`.
and paren_body = fn toks ->
  match skip_nls toks with
  | Cons (TId w, _) ->
    if str_eq w "break" || str_eq w "next" || str_eq w "return" then
      paren_seq (skip_nls toks) Nil
    // a statement keyword opens a statement sequence: (def f; end; 'f').
    else if str_eq w "def" || str_eq w "class" || str_eq w "module" ||
            str_eq w "begin" || str_eq w "while" || str_eq w "until" ||
            str_eq w "case" then
      paren_seq (skip_nls toks) Nil
    else paren_expr_body (skip_nls toks)
  | _ -> paren_expr_body (skip_nls toks)

and paren_expr_body = fn toks ->
  if looks_like_multix toks then
    let (s2, r2) = parse_multix toks in
    (EStmt s2, expect (skip_nls r2) ")")
  else if looks_like_multi toks then
    let (s2, r2) = parse_multi toks in
    (EStmt s2, expect (skip_nls r2) ")")
  else
  let (e, r2) = parse_andor toks in
  match r2 with
  // `(args = 1, 2, 3)` — an assignment's extra comma values build an array.
  | Cons (TP c0, r2b) ->
    if str_eq c0 "=>" then
      let (pat, r3) = parse_pattern_top r2b in (EMatchBind (e, pat), expect (skip_nls r3) ")")
    else if str_eq c0 "," then
      (match e with
       | EAssign (anm, v0) ->
         let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
         (EAssign (anm, EArr (Cons (v0, more))), expect (skip_nls r3) ")")
       // `(a[1, 2] = 4, 5)` / `(o.foo = 1, 2)` — the last setter argument
       // grows into an array of the comma values.
       | EMethod (recv, mn, margs) ->
         if str_eq mn "[]=" || (str_len mn > 0 && str_eq (char_at mn (str_len mn - 1)) "=") then
           let (more, r3) = parse_rhs_list (skip_nls r2b) Nil in
           (EMethod (recv, mn, grow_last_arg margs more), expect (skip_nls r3) ")")
         else (e, expect r2 ")")
       | _ -> (e, expect r2 ")"))
    else (e, expect r2 ")")
  | Cons (TId w, rrest) ->
    if str_eq w "in" then
      let (pat, r3) = parse_pattern_top rrest in (EMatchTest (e, pat), expect (skip_nls r3) ")")
    else if str_eq w "while" || str_eq w "until" || str_eq w "if" || str_eq w "unless" || str_eq w "rescue" then
      let (s2, r3) = apply_modifier (SExpr e) r2 in
      (match r3 with
       | Cons (TNL, _) ->
         // `; more` after the modifier — continue the paren sequence.
         (match skip_nls r3 with
          | Cons (TP rp2, r4) ->
            if str_eq rp2 ")" then (EStmt s2, r4)
            else paren_seq (skip_nls r3) (Cons (s2, Nil))
          | _ -> paren_seq (skip_nls r3) (Cons (s2, Nil)))
       | _ -> (EStmt s2, expect r3 ")"))
    else (e, expect r2 ")")
  // `; more` — the paren holds a statement sequence; its value is the last.
  | Cons (TNL, _) ->
    (match skip_nls r2 with
     | Cons (TP rp, r3) ->
       if str_eq rp ")" then (e, r3) else paren_seq (skip_nls r2) (Cons (SExpr e, Nil))
     | _ -> paren_seq (skip_nls r2) (Cons (SExpr e, Nil)))
  | _ -> (e, expect r2 ")")

and paren_seq = fn toks -> fn (acc: Stmt list) ->
  let (s0, r0) = parse_stmt toks in
  let (s1, r1) = apply_modifier s0 r0 in
  match r1 with
  | Cons (TP rp, r2) ->
    if str_eq rp ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r2)
    else fail ("mere-ruby: expected ) in paren sequence, got " ++ rp)
  | Cons (TNL, _) ->
    (match skip_nls r1 with
     | Cons (TP rp2, r3) ->
       if str_eq rp2 ")" then (EStmt (SBegin (rev_app (Cons (s1, acc)) Nil, Nil, Nil, Nil)), r3)
       else paren_seq (skip_nls r1) (Cons (s1, acc))
     | _ -> paren_seq (skip_nls r1) (Cons (s1, acc)))
  | _ -> fail "mere-ruby: unterminated paren sequence"

// expr [and|or expr]* — the low-precedence word operators (paren context);
// `not expr` negates at the same low precedence.
and parse_andor = fn toks ->
  match toks with
  | Cons (TId w, r) ->
    if str_eq w "not" then let (e, r2) = parse_expr r in parse_andor_more (EUn ("!", e)) r2
    else let (e, r2) = parse_expr toks in parse_andor_more e r2
  | _ -> let (e, r) = parse_expr toks in parse_andor_more e r

and parse_andor_more = fn (lhs: Expr) -> fn toks ->
  match toks with
  | Cons (TId w, r) ->
    if str_eq w "and" then let (rhs, r2) = parse_expr r in parse_andor_more (EBin ("&&", lhs, rhs)) r2
    else if str_eq w "or" then let (rhs, r2) = parse_expr r in parse_andor_more (EBin ("||", lhs, rhs)) r2
    else (lhs, toks)
  | _ -> (lhs, toks)

and parse_range = fn toks ->
  let (lo, r) = parse_bin toks 1 in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      // endless range: (1..) — no upper bound expression follows.
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" then
           (ERange (lo, EInt 4611686018427387903, excl), rest)
         else let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2)
       | Cons (TNL, _) -> (ERange (lo, EInt 4611686018427387903, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, EInt 4611686018427387903, excl), rest)
       | _ -> let (hi, r2) = parse_bin rest 1 in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

and parse_bin = fn toks -> fn (minp: int) ->
  let (lhs, r) = parse_unary toks in
  parse_more lhs r minp

// the comparison/match operators are non-associative: `a == b == c` is a
// SyntaxError in Ruby (each can appear at most once per sub-expression).
and is_nonassoc_op = fn (op: str) ->
  str_eq op "==" || str_eq op "!=" || str_eq op "===" || str_eq op "<=>" ||
  str_eq op "=~" || str_eq op "!~"

and parse_more = fn (lhs: Expr) -> fn toks -> fn (minp: int) ->
  match toks with
  | Cons (TP op, rest) ->
    let p = prec_of op in
    if p > 0 && p >= minp then
      // the RHS may continue on the next line (trailing-operator style).
      let (rhs, r2) = parse_bin (skip_nls rest) (p + 1) in
      // reject chaining of a non-associative operator (`a == b == c`).
      let _ = (match r2 with
               | Cons (TP op2, _) -> if is_nonassoc_op op && is_nonassoc_op op2 then fail "mere-ruby: syntax error, non-associative operator" else ()
               | _ -> ()) in
      parse_more (EBin (op, lhs, rhs)) r2 minp
    else (lhs, toks)
  | _ -> (lhs, toks)

and parse_unary = fn toks ->
  match toks with
  | Cons (TP op, rest) ->
    if str_eq op "-" then
      let (e, r) = parse_unary rest in (EUn ("-", e), r)
    else if str_eq op "+" then
      // unary + is identity (+"str" is an unfrozen dup — same value here).
      parse_unary rest
    else if str_eq op "!" then
      let (e, r) = parse_unary rest in (EUn ("!", e), r)
    else if str_eq op "~" then
      let (e, r) = parse_unary rest in (EUn ("~", e), r)
    else parse_pow toks
  | _ -> parse_pow toks

and parse_pow = fn toks ->
  let (b, r) = parse_postfix toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op "**" then
      let (e, r2) = parse_unary rest in (EBin ("**", b, e), r2)
    else (b, r)
  | _ -> (b, r)

// postfix method-call chains: `recv.name`, `recv.name(args)`, and the
// setter form `recv.name = expr` (parsed as a call to `name=`).
and parse_postfix = fn toks ->
  let (e, r) = parse_primary toks in
  parse_postfix_more e r

and parse_postfix_more = fn (recv: Expr) -> fn toks ->
  match toks with
  // a newline followed by .method continues the chain (leading-dot style).
  | Cons (TNL, _) ->
    let t2 = skip_nls toks in
    (match t2 with
     | Cons (TP dot, _) -> if str_eq dot "." then parse_postfix_more recv t2 else (recv, toks)
     | _ -> (recv, toks))
  | Cons (TP dot, r0) ->
    let r = (if str_eq dot "." then skip_nls r0 else r0) in   // `x.` + newline continues
    if str_eq dot "." then
      (match r with
       | Cons (TId name, r2) ->
         (match r2 with
          | Cons (TP p, r3) ->
            if is_lparen p then
              let (argv, r4) = parse_call_args r3 in
              attach_block_method recv name argv r4
            else if str_eq p "=" then
              let (rhs, r4) = parse_expr r3 in
              (EMethod (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // attribute op-assign: recv evaluated exactly once.
            else if not (str_eq (opassign_base p) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (EAttrOp (recv, name, opassign_base p, rhs), r4)
            else attach_block_method recv name Nil r2
          | _ -> attach_block_method recv name Nil r2)
       // `recv.(args)` is shorthand for `recv.call(args)`.
       | Cons (TP lp, r2) ->
         if str_eq lp "(" then let (argv, r3) = parse_call_args r2 in attach_block_method recv "call" argv r3
         // `recv.[](args)` / `recv.[]=(v)` — the bracket method called via dot.
         else if str_eq lp "[" && (match r2 with Cons (TP rb, _) -> str_eq rb "]" | _ -> false) then
           (match r2 with
            | Cons (_, r3) ->
              (match r3 with
               | Cons (TP op, r4) ->
                 if str_eq op "(" then let (argv, r5) = parse_call_args r4 in attach_block_method recv "[]" argv r5
                 else if str_eq op "=" then let (rhs, r5) = parse_expr r4 in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5)
                 else parse_postfix_more (EMethod (recv, "[]", Nil)) r3
               | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r3)
            | _ -> parse_postfix_more (EMethod (recv, "[]", Nil)) r2)
         // `recv.=~(x)` / `recv.+(y)` — explicit operator-method calls.
         else if is_op_method_name lp then
           (match r2 with
            | Cons (TP lp2, r3) ->
              if str_eq lp2 "(" then
                let (argv, r4) = parse_call_args r3 in
                parse_postfix_more (EMethod (recv, lp, argv)) r4
              else parse_postfix_more (EMethod (recv, lp, Nil)) r2
            | _ -> parse_postfix_more (EMethod (recv, lp, Nil)) r2)
         else fail "mere-ruby: expected method name after ."
       | _ -> fail "mere-ruby: expected method name after .")
    // index: recv[i] -> recv.[](i); recv[i] = v -> recv.[]=(i, v)
    else if str_eq dot "[" && (match r with Cons (TP rb0, _) -> str_eq rb0 "]" | _ -> false) then
      // empty index `recv[]` (getter) or `recv[] = v` (setter).
      (match r with
       | Cons (_, Cons (TP eq, r0e)) ->
         if str_eq eq "=" then
           let (rhs, r5) = parse_expr r0e in (EMethod (recv, "[]=", Cons (rhs, Nil)), r5)
         // `recv[] op= v` -> `recv[]= (recv[] op v)`.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r0e) in
           (EIdxOp (recv, Nil, opassign_base eq, rhs), r5)
         else (match r with Cons (_, r0f) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0f | _ -> (recv, toks))
       | Cons (_, r0e) -> parse_postfix_more (EMethod (recv, "[]", Nil)) r0e
       | _ -> (recv, toks))
    else if str_eq dot "[" then
      // one or more comma-separated indices (a[i], a[start, len], a[*idx]).
      let (idxs, r3) = parse_x_idx r Nil in
      (match r3 with
       | Cons (TP eq, r4) ->
         if str_eq eq "=" then
           let (rhs, r5) =
             (match r4 with
              | Cons (TP st2, r4b) ->
                if str_eq st2 "*" then
                  let (inner, r5b) = parse_expr r4b in (EArr (Cons (ESplat inner, Nil)), r5b)
                else parse_expr r4
              | _ -> parse_expr r4) in
           (EMethod (recv, "[]=", eapp idxs (Cons (rhs, Nil))), r5)
         // recv[i] op= v desugars through a read-modify-write ([]= of
         // [] op v); ||= and &&= use their short-circuit operators.
         else if not (str_eq (opassign_base eq) "") then
           let (rhs, r5) = parse_expr (skip_nls r4) in
           (EIdxOp (recv, idxs, opassign_base eq, rhs), r5)
         else parse_postfix_more (EMethod (recv, "[]", idxs)) r3
       | _ -> parse_postfix_more (EMethod (recv, "[]", idxs)) r3)
    // safe navigation: a&.b / a&.b(args) — nil receiver short-circuits.
    else if str_eq dot "&." then
      (match r with
       | Cons (TId name, r2) ->
         (match r2 with
          | Cons (TP p2, r3) ->
            if str_eq p2 "(" then
              let (argv, r4) = parse_call_args r3 in
              if starts_block r4 then
                let (bp, bb, r5) = parse_block r4 in
                parse_postfix_more (ESafeB (recv, name, argv, bp, bb)) r5
              else parse_postfix_more (ESafe (recv, name, argv)) r4
            else if str_eq p2 "=" then
              let (rhs, r4) = parse_expr r3 in
              (ESafe (recv, name ++ "=", Cons (rhs, Nil)), r4)
            // safe-navigation op-assign: recv&.attr op= rhs.
            else if not (str_eq (opassign_base p2) "") then
              let (rhs, r4) = parse_expr (skip_nls r3) in
              (ESafe (recv, name ++ "=", Cons (EBin (opassign_base p2, ESafe (recv, name, Nil), rhs), Nil)), r4)
            else if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in
              parse_postfix_more (ESafeB (recv, name, Nil, bp, bb)) r4
            else parse_postfix_more (ESafe (recv, name, Nil)) r2
          | _ -> parse_postfix_more (ESafe (recv, name, Nil)) r2)
       | _ -> fail "mere-ruby: expected method name after &.")
    // scope resolution: Foo::Bar (nested constant, looked up by bare name)
    // or Foo::meth(...) (module/class method call).
    else if str_eq dot "::" then
      (match r with
       | Cons (TId name, r2) ->
         // A::B is the constant B qualified by A; keep the full name so a
         // namespaced class resolves and reports consistently.
         let mkread = (match recv with
                       | EConst rc -> EConst (rc ++ "::" ++ name)
                       | _ -> EScopedRead (recv, name)) in
         (match r2 with
          | Cons (TP p, r3) ->
            if is_lparen p then let (argv, r4) = parse_call_args r3 in attach_block_method recv name argv r4
            // recv::Const = value : a runtime-receiver constant assignment.
            else if is_cap name && str_eq p "=" then let (v, r4) = parse_expr r3 in (EScopedAssign (recv, name, v), r4)
            // recv::Const op= value -> t = recv; t::Const = t::Const op value,
            // evaluating the receiver expression exactly once (side effects).
            else if is_cap name && (if str_eq (opassign_base p) "" then false else true) then
              let (v, r4) = parse_expr r3 in
              let tmp = fresh_tmp () in
              let base = opassign_base p in
              // `||=` treats an undefined constant as nil (then assigns); other
              // op-assigns read first, so an undefined constant raises NameError.
              let readx = if str_eq base "||" then EScopedReadOrNil (EVar tmp, name) else EScopedRead (EVar tmp, name) in
              (EStmt (SBegin (Cons (SAssign (tmp, recv), Cons (SExpr (EScopedAssign (EVar tmp, name, EBin (base, readx, v))), Nil)), Nil, Nil, Nil)), r4)
            else if is_cap name then parse_postfix_more mkread r2
            else attach_block_method recv name Nil r2
          | _ ->
            if is_cap name then parse_postfix_more mkread r2
            else attach_block_method recv name Nil r2)
       | _ -> fail "mere-ruby: expected name after ::")
    else (recv, toks)
  | _ -> (recv, toks)

// a trailing `{ }` / `do end` block turns a method call into EMethodB.
and attach_block_method = fn (recv: Expr) -> fn (name: str) -> fn (argv: Expr list) -> fn toks ->
  // paren-less block-pass: `recv.meth &blk` (the " &" token = space-before,
  // no-space-after). Turn the following expr into a block-pass argument.
  let (argv, toks) = (match argv with
    | Nil -> (match toks with
              | Cons (TP amp, r) -> if str_eq amp " &" then (let (be, r1) = parse_expr r in (Cons (EBlockPass be, Nil), r1)) else (argv, toks)
              | _ -> (argv, toks))
    | _ -> (argv, toks)) in
  let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
  if hasbp then parse_postfix_more (EMethodB (recv, name, argv2, bp0, bb0)) toks
  else if starts_block toks then
    let (bp, bb, r) = parse_block toks in
    // continue the chain: `arr.map { } .sum` etc.
    parse_postfix_more (EMethodB (recv, name, argv, bp, bb)) r
  // paren-less argument on a dotted call: `x.should be_nil` / `a.push v` /
  // `ScratchPad.record []` (a space before [ means an array argument).
  else if (match argv with Nil -> true | _ -> false) && (starts_bare_arg toks || starts_sp_bracket toks) then
    // suppress do-block attachment while parsing the bare args so a trailing
    // `do...end` binds to this call, not to a bare-identifier argument
    // (`Class.new sc do ... end` = Class.new(sc) { ... }).
    let had = map_has parser_flags "nodo" in
    let _ = map_set parser_flags "nodo" VNil in
    let (es, r2) = parse_puts_args toks Nil in
    let _ = if had then () else map_delete parser_flags "nodo" in
    // `obj.meth :arg do |x| ... end` — a do-block after bare args.
    if starts_do_block r2 then
      let (bp, bb, r3) = parse_block r2 in
      parse_postfix_more (EMethodB (recv, name, es, bp, bb)) r3
    else parse_postfix_more (EMethod (recv, name, es)) r2
  else parse_postfix_more (EMethod (recv, name, argv)) toks

and starts_do_block = fn toks ->
  match toks with Cons (TId d, _) -> str_eq d "do" | _ -> false

and starts_sp_bracket = fn toks ->
  match toks with Cons (TP lb, _) -> str_eq lb " [" | _ -> false

// does a paren-less argument start here? (an identifier that isn't a
// keyword/modifier, or a literal)
// Kernel conversion functions written like `Integer(x)`.
and is_conv_fn = fn (id: str) ->
  str_eq id "Integer" || str_eq id "Float" || str_eq id "String" ||
  str_eq id "Array" || str_eq id "Rational" || str_eq id "Complex" || str_eq id "Hash"

and starts_bare_arg = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    // value keywords are arguments (`x.go false`); a def is an expression
    // (`ruby2_keywords def m...`); structural keywords are not arguments.
    if str_eq w "true" || str_eq w "false" || str_eq w "nil" || str_eq w "self" ||
       str_eq w "def" || str_eq w "yield" then true
    else if is_keyword w || str_eq w "and" || str_eq w "or" || str_eq w "not" ||
       str_eq w "in" || str_eq w "for" then false
    else true
  | Cons (TInt _, _) -> true
  | Cons (TBig _, _) -> true
  | Cons (TRat _, _) -> true
  | Cons (TImag _, _) -> true
  | Cons (TImagF _, _) -> true
  | Cons (TImagRat _, _) -> true
  | Cons (TFlt _, _) -> true
  | Cons (TStrL _, _) -> true
  | Cons (TSym _, _) -> true
  | Cons (TRegex _, _) -> true
  | Cons (TP p, _) -> str_eq p "(s" || str_eq p "~" || str_eq p "->"  // dq string, unary ~, or lambda
  | _ -> false

// A trailing `&:sym` block-pass arg becomes a real one-param block
// `{ |__bp| __bp.sym }`. Returns (args-without-bp, found?, bparams, bbody).
and extract_block_pass = fn (argv: Expr list) ->
  match rev_app argv Nil with
  | Cons (EBlockPass be, rrest) ->
    (match be with
     | ESym s ->
       (rev_app rrest Nil, true, Cons ("__bp", Nil), Cons (SExpr (EMethod (EVar "__bp", s, Nil)), Nil))
     // general &expr: mark for runtime coercion (Proc/nil/to_proc) at the
     // call site — the "&coerce" param sentinel carries the expr in its body.
     | _ -> (rev_app rrest Nil, true, Cons ("&coerce", Nil), Cons (SExpr be, Nil)))
  | _ -> (argv, false, (Nil : str list), (Nil : Stmt list))

and starts_block = fn toks ->
  match toks with
  | Cons (TP p, _) -> str_eq p "\{" && (if map_has parser_flags "nobrace" then false else true)
  | Cons (TId d, _) -> str_eq d "do" && (if map_has parser_flags "nodo" then false else true)
  | _ -> false

// parse `{ |p,..| stmt }` (single statement) or `do |p,..| stmts end`.
// a `|a=5|` default becomes a prologue statement: the bind sets missing
// args to nil, so a nil param takes its default (explicit nil is rare).
// recover the (name, default) pairs a block encodes as leading nil-check
// prologue statements, so the argument fill can order optionals correctly.
and block_defaults = fn (body: Stmt list) ->
  match body with
  | Cons (SIf (Cons ((cond, Cons (SAssign (n, d), Nil)), Nil), Nil), rest) ->
    (match cond with
     | EMethod (EVar cn, m, Nil) ->
       if str_eq m "nil?" && str_eq cn n then Cons ((n, d), block_defaults rest)
       else Nil
     | _ -> Nil)
  | _ -> Nil

and defaults_prologue = fn (ds: (str * Expr) list) -> fn (body: Stmt list) ->
  match ds with
  | Nil -> body
  | Cons ((n, d), rest) ->
    Cons (SIf (Cons ((EMethod (EVar n, "nil?", Nil), Cons (SAssign (n, d), Nil)), Nil), Nil),
          defaults_prologue rest body)

and parse_block = fn toks ->
  match toks with
  | Cons (TP brace, r) ->
    if str_eq brace "\{" then
      let (bp, ds, r2) = parse_block_params_d r in
      let (body, r3) = parse_brace_stmts r2 Nil in
      (bp, defaults_prologue ds body, r3)
    else fail "mere-ruby: expected block"
  | Cons (TId d, r) ->
    if str_eq d "do" then
      let (bp, ds0, r2) = parse_block_params_d r in
      let (body0, r3) = parse_stmts r2 Nil in
      // do-blocks accept trailing rescue/ensure (an implicit begin).
      let (body, r5) =
        (match r3 with
         | Cons (TId k, _) ->
           if str_eq k "rescue" || str_eq k "ensure" then
             let (rescues, ra) = parse_rescues r3 Nil in
             let (els, rb) = parse_opt_kw_block ra "else" in
             let (ens, rc) = parse_opt_kw_block rb "ensure" in
             (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
           else (body0, r3)
         | _ -> (body0, r3)) in
      (bp, defaults_prologue ds0 body, expect_kw r5 "end")
    else fail "mere-ruby: expected block"
  | _ -> fail "mere-ruby: expected block"

// statements inside a `{ ... }` block, terminated by `}` (consumed).
and parse_brace_stmts = fn toks -> fn (acc: Stmt list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP p, r) ->
    if str_eq p "}" then (rev_app acc Nil, r)
    else let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
         parse_brace_stmts r1 (Cons (s, acc))
  | Cons (TEOF, _) -> fail "mere-ruby: unterminated block"
  | _ ->
    let (s0, r0) = parse_stmt t in let (s, r1) = apply_modifier s0 r0 in
    parse_brace_stmts r1 (Cons (s, acc))

and parse_block_params = fn toks ->
  let (bp, ds, r) = parse_block_params_d toks in
  (bp, r)

// like parse_block_params but also returns (name, default-expr) pairs for
// optional params (`|a=5, b=4|`); parse_block turns them into a prologue.
and parse_block_params_d = fn toks ->
  let t = skip_nls toks in
  match t with
  | Cons (TP bar, r) ->
    if str_eq bar "|" then parse_pipe_params r Nil Nil
    else if str_eq bar "||" then (Cons (empty_bp_marker, Nil), (Nil : (str * Expr) list), r)
    else (Nil, Nil, t)
  | _ -> (Nil, Nil, t)

and parse_pipe_params = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  // `|one; bl|` — names after a semicolon (lexed as TNL) are block-locals:
  // encoded with a ; prefix, they always bind nil.
  | Cons (TNL, r) -> parse_block_locals r acc ds
  | Cons (TP bar, r) ->
    if str_eq bar "|" then (rev_app acc Nil, rev_app ds Nil, r)
    else if str_eq bar "*" then
      (match r with Cons (TId n, r2) -> pipe_after ("*" ++ n) r2 acc ds | _ -> pipe_after "*" r acc ds)
    else if str_eq bar "**" then
      // `**kw` — keyword-splat: collects a trailing hash argument (or {}).
      (match r with Cons (TId n, r2) -> pipe_after ("**" ++ n) r2 acc ds | _ -> pipe_after "**" r acc ds)
    else if str_eq bar "&" then
      (match r with Cons (TId n, r2) -> pipe_after ("&" ++ n) r2 acc ds | _ -> pipe_after "&" r acc ds)
    else if str_eq bar "(" then
      // nested destructuring |(a, (b, c))| — encoded as a spec string.
      let (spec, r2) = pipe_group r "" in
      pipe_after ("(" ++ spec ++ ")") r2 acc ds
    else fail "mere-ruby: bad block params"
  | Cons (TId name, r) ->
    // `a=default` — an optional parameter; `k:` / `k: default` — keyword.
    (match r with
     // `|b:|` — the lexer reads `:|` as the operator symbol :| — that is a
     // required keyword param immediately before the closing bar.
     | Cons (TSym sy, r2) ->
       if str_eq sy "|" then (rev_app (Cons (name ++ ":", acc)) Nil, rev_app ds Nil, r2)
       else fail "mere-ruby: bad block params"
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // parse above `|`'s precedence so the closing bar stays the closer
         let (d, r3) = parse_bin r2 6 in
         pipe_after name r3 acc (Cons ((name, d), ds))
       else if str_eq eq ":" then
         (match r2 with
          | Cons (TP nx, _) ->
            if str_eq nx "," || str_eq nx "|" then pipe_after (name ++ ":") r2 acc ds
            else
              let (d, r3) = parse_bin r2 6 in
              pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds))
          | _ ->
            let (d, r3) = parse_bin r2 6 in
            pipe_after (name ++ ":") r3 acc (Cons ((name, d), ds)))
       else pipe_after name r acc ds
     | _ -> pipe_after name r acc ds)
  | _ -> fail "mere-ruby: expected block parameter"

// tokens of a nested destructure group (after the opening paren) encoded
// back into a compact string: names, commas, splats, nested groups.
and pipe_group = fn toks -> fn (acc: str) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (acc, r)
    else if is_lparen p || str_eq p " [" then
      let (inner, r2) = pipe_group r "" in pipe_group r2 (acc ++ "(" ++ inner ++ ")")
    else if str_eq p "," then pipe_group r (acc ++ ",")
    else if str_eq p "*" then pipe_group r (acc ++ "*")
    else fail "mere-ruby: bad block params"
  | Cons (TId n, r) -> pipe_group r (acc ++ n)
  | _ -> fail "mere-ruby: bad block params"

and parse_block_locals = fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TId n, r) ->
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then parse_block_locals r2 (Cons (";" ++ n, acc)) ds
       else if str_eq c "|" then (rev_app (Cons (";" ++ n, acc)) Nil, rev_app ds Nil, r2)
       else fail "mere-ruby: bad block-local list"
     | _ -> fail "mere-ruby: bad block-local list")
  | _ -> fail "mere-ruby: bad block-local list"

and pipe_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (ds: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `|a,|` — a trailing comma forces destructuring: add an anonymous
      // splat so a single Array/to_ary arg splits (a = first element). The
      // marker "*," (distinct from a real "*") records the trailing comma so a
      // lambda still enforces an exact arity (`->(a,){}` is arity 1, not -2).
      (match r with
       | Cons (TP bar2, _) -> if str_eq bar2 "|" then parse_pipe_params r (Cons ("*,", Cons (name, acc))) ds
                              else parse_pipe_params r (Cons (name, acc)) ds
       | _ -> parse_pipe_params r (Cons (name, acc)) ds)
    else if str_eq p "|" then (rev_app (Cons (name, acc)) Nil, rev_app ds Nil, r)
    else fail "mere-ruby: expected , or | in block params"
  // `|one; bl|` — the ; (lexed as a newline) starts the block-local names.
  | Cons (TNL, r) -> parse_block_locals r (Cons (name, acc)) ds
  | _ -> fail "mere-ruby: unterminated block params"

// fold any string literals immediately following `e` into it (Ruby's
// adjacent-string-literal concatenation).
and concat_adjacent_strings = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      let (e2, r2) = parse_expr r in
      concat_adjacent_strings (EBin ("+", e, e2)) (expect r2 ")")
    else (e, toks)
  | _ -> (e, toks)

and parse_primary = fn toks ->
  match toks with
  | Cons (TInt n, r) -> (EInt n, r)
  | Cons (TBig b, r) -> (EBig b, r)
  | Cons (TRat n, r) -> (ERat n, r)
  | Cons (TImag n, r) -> (EImag n, r)
  | Cons (TImagF f, r) -> (EImagF f, r)
  | Cons (TImagRat n, r) -> (EImagRat n, r)
  | Cons (TRegex p, r) ->
    // record the literal for post-parse validation (rx_check_pending): an
    // invalid regex is a parse-time SyntaxError, unsupported ones pass.
    let (rbody, rfl) = p in
    let n = (if map_has rx_pending "n" then (match map_get rx_pending "n" with VInt k -> k | _ -> 0) else 0) in
    let _ = map_set rx_pending ("e" ++ str_of_int n) (mkstr (rfl ++ "\n" ++ rbody)) in
    let _ = map_set rx_pending "n" (VInt (n + 1)) in
    (ERegex p, r)
  | Cons (TFlt f, r) -> (EFlt f, r)
  | Cons (TStrL s, r) -> (EStrL s, r)
  | Cons (TSym s, r) -> (ESym s, r)
  | Cons (TId id, r) ->
    if str_eq id "true" then (EBool true, r)
    else if str_eq id "false" then (EBool false, r)
    else if str_eq id "nil" then (ENil, r)
    else if str_eq id "self" then (ESelf, r)
    else if is_ivar id then
      (match r with
       | Cons (TP eq, r2) ->
         if str_eq eq "=" then let (e, r3) = parse_expr r2 in (EAssign (id, e), r3)
         else if not (str_eq (opassign_base eq) "") then
           let (e, r3) = parse_expr r2 in (EAssign (id, EBin (opassign_base eq, EIVar (substring id 1 (str_len id)), e)), r3)
         else (EIVar (substring id 1 (str_len id)), r)
       | _ -> (EIVar (substring id 1 (str_len id)), r))
    else if is_cap id then
      (match r with
       | Cons (TP eq, r2) ->
         // Kernel conversion functions look like constants but take args:
         // Integer(x) / Float(x) / Rational(n,d) / Complex(r,i) / Array / String.
         if str_eq eq "(" && is_conv_fn id then
           let (argv, r3) = parse_call_args r2 in (ECall (id, argv), r3)
         else if str_eq eq "=" then let (e, r3) = parse_expr r2 in (EAssign (id, e), r3)
         else (EConst id, r)
       | _ -> (EConst id, r))
    else if str_eq id "yield" then
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then let (argv, r3) = parse_call_args r2 in (EYield argv, r3)
         // `yield [0]` passes an array literal (not an index on the result).
         else if str_eq p "[" || str_eq p " [" then let (es, r3) = parse_puts_args r Nil in (EYield es, r3)
         else (EYield Nil, r)
       | Cons (TNL, _) -> (EYield Nil, r)
       | Cons (TEOF, _) -> (EYield Nil, r)
       // `yield end` / `yield if c` — a stop keyword ends a bare yield.
       | Cons (TId w, _) -> if stops_value w then (EYield Nil, r) else let (es, r2) = parse_puts_args r Nil in (EYield es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (EYield es, r2))
    else if str_eq id "raise" then
      (match r with
       | Cons (TNL, _) -> (ERaise Nil, r)
       | Cons (TEOF, _) -> (ERaise Nil, r)
       // bare raise before a modifier/terminator keyword takes no args.
       | Cons (TId w, _) ->
         if stops_value w then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | Cons (TP p, _) ->
         if str_eq p ")" || str_eq p "}" || str_eq p ";" then (ERaise Nil, r)
         else let (es, r2) = parse_puts_args r Nil in (ERaise es, r2)
       | _ -> let (es, r2) = parse_puts_args r Nil in (ERaise es, r2))
    else if str_eq id "super" then
      // `super` forwards the current args; `super(...)` / `super()` are explicit.
      let (zs, argv, r1) =
        (match r with
         | Cons (TP p, r2) ->
           if is_lparen p then let (a, r3) = parse_call_args r2 in (false, a, r3)
           else (true, Nil, r)
         | _ -> (true, Nil, r)) in
      // `super { ... }` / `super do ... end` passes an explicit block.
      if starts_block r1 then
        let (bp, bb, r4) = parse_block r1 in (ESuperB (zs, argv, bp, bb), r4)
      else (ESuper (zs, argv), r1)
    else if str_eq id "not" then
      // `not(x)` / `not x` — negation; with parens the chain continues
      // on the negated value (not(true).should == ...).
      (match r with
       | Cons (TP lp, _) ->
         if str_eq lp "(" then let (e, r2) = parse_primary r in (EUn ("!", e), r2)
         else let (e, r2) = parse_expr r in (EUn ("!", e), r2)
       | _ -> let (e, r2) = parse_expr r in (EUn ("!", e), r2))
    else if str_eq id "defined?" then
      // defined?(e) or defined? e — never evaluates e for its value.
      (match r with
       | Cons (TP p, r2) ->
         if is_lparen p then
           // defined?(x = 2) and friends answer "assignment" unevaluated.
           if defined_assignish r2 then
             let (_, r3) = parse_stmt r2 in (EStrL "assignment", expect r3 ")")
           // defined?(if.../while.../case... end) answers "expression".
           else if defined_compound r2 then
             let (_, r3) = parse_stmt r2 in (EStrL "expression", expect r3 ")")
           else
           // defined?(puts) — a keyword-named method probes as a plain call.
           // parse the inner expression at the lowest precedence so the word
           // operators `and`/`or`/`not` are allowed (`defined?(a and b)`).
           (match r2 with
            | Cons (TId w, Cons (TP rp, r4)) ->
              if str_eq rp ")" then (EDefined (EVar w), r4)
              else let (e, r3) = parse_andor r2 in (EDefined e, expect r3 ")")
            | _ -> let (e, r3) = parse_andor r2 in (EDefined e, expect r3 ")"))
         // `defined? a = 10` (no parens) — an assignment is unevaluated.
         else if defined_assignish r then
           let (_, r3) = parse_stmt r in (EStrL "assignment", r3)
         else let (e, r3) = parse_unary r in (EDefined e, r3)
       // `defined? a = 10` at statement start (no leading paren token).
       | _ ->
         if defined_assignish r then
           let (_, r3) = parse_stmt r in (EStrL "assignment", r3)
         else let (e, r3) = parse_unary r in (EDefined e, r3))
    else if str_eq id "break" || str_eq id "next" || str_eq id "return" || str_eq id "redo" || str_eq id "retry" then
      // flow keywords in expression position (ternary branches, call args).
      (match r with
       | Cons (TNL, _) -> (EFlow (id, ENil), r)
       | Cons (TEOF, _) -> (EFlow (id, ENil), r)
       | Cons (TP p, _) ->
         if str_eq p ")" || str_eq p "}" || str_eq p "]" || str_eq p "," ||
            str_eq p ":" || str_eq p ";" then (EFlow (id, ENil), r)
         else if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | Cons (TId w, _) ->
         if stops_value w || str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2)
       | _ ->
         if str_eq id "redo" || str_eq id "retry" then (EFlow (id, ENil), r)
         else let (e, r2) = parse_expr r in (EFlow (id, e), r2))
    else if str_eq id "if" then
      // statement constructs usable as expressions (call args etc.).
      let (s, r2) = parse_if r false in (EStmt s, r2)
    else if str_eq id "unless" then let (s, r2) = parse_if r true in (EStmt s, r2)
    else if str_eq id "while" then let (s, r2) = parse_while r false in (EStmt s, r2)
    else if str_eq id "until" then let (s, r2) = parse_while r true in (EStmt s, r2)
    else if str_eq id "for" then let (s, r2) = parse_for r in (EStmt s, r2)
    else if str_eq id "case" then let (s, r2) = parse_case r in (EStmt s, r2)
    else if str_eq id "begin" then let (s, r2) = parse_begin r in (EStmt s, r2)
    // def/class in expression position (def evaluates to the method name
    // as a symbol; class to its body's last value).
    else if str_eq id "def" then let (s, r2) = parse_def r in (EStmt s, r2)
    else if str_eq id "class" then let (s, r2) = parse_class r in (EStmt s, r2)
    else if is_keyword id then fail ("mere-ruby: unexpected keyword: " ++ id)
    else
      // `name(args)` / `name(args) { block }` / `name { block }` / bare name.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           // assignment as an expression: `true && x = 1` binds rightmost.
           (match r2 with
            | Cons (TP st, r2b) ->
              if str_eq st "*" then
                let (e, r3) = parse_expr r2b in (EAssign (id, EArr (Cons (ESplat e, Nil))), r3)
              else let (e, r3) = parse_expr r2 in (EAssign (id, e), r3)
            | _ -> let (e, r3) = parse_expr r2 in (EAssign (id, e), r3))
         else if not (str_eq (opassign_base p) "") then
           // op-assign as an expression: `(i += 1) >= 5`.
           let (e, r3) = parse_expr r2 in
           (EAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         // `name (expr)...` (space before paren): the parenthesised group is
         // the first command argument, so a trailing `.m`/operator binds to it
         // (`p (1..3).map { }` = p((1..3).map { }), not (p(1..3)).map).
         else if str_eq p " (" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else if is_lparen p then
           let (argv, r3) = parse_call_args r2 in
           let (argv2, hasbp, bp0, bb0) = extract_block_pass argv in
           if hasbp then (ECallB (id, argv2, bp0, bb0), r3)
           else if starts_block r3 then
             let (bp, bb, r4) = parse_block r3 in (ECallB (id, argv, bp, bb), r4)
           else (ECall (id, argv), r3)
         else if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // `p [1, 2]` — p/pp take a space-bracket array argument.
         else if str_eq p " [" && (str_eq id "p" || str_eq id "pp") then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `name [items]` — indexing or call-with-array, decided at eval.
         else if str_eq p " [" then
           (match parse_array r2 with
            | (ae, r2b) ->
              (match ae with
               | EArr items -> (EAmbigIdx (id, items), r2b)
               | other -> (ECall (id, Cons (other, Nil)), r2b)))
         // a double-quoted string argument: `d "desc" do ... end`.
         else if str_eq p "(s" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         // `foo ~x` — a unary-complement argument in a paren-less call.
         else if str_eq p "~" then
           let (es, r2b) = parse_puts_args r Nil in (ECall (id, es), r2b)
         // `foo -> { ... }` — a paren-less lambda argument (the lambda owns its
         // own block; `.call`/chains after it stay part of the argument).
         else if str_eq p "->" then
           let (es, r2b) = parse_puts_args r Nil in
           (if starts_block r2b then
              let (bp, bb, r4) = parse_block r2b in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2b))
         else (enc_pseudo_var id, r)
       | _ ->
         if starts_block r then
           let (bp, bb, r4) = parse_block r in (ECallB (id, Nil, bp, bb), r4)
         // paren-less call arguments: `it 'desc' do ... end`, `foo :sym, 1`.
         else if starts_bare_arg r then
           // `do...end` binds to this command, not to a bare identifier
           // argument (`define_method name do..end` = define_method(name){..}),
           // so suppress do-block attachment while parsing the arguments.
           let had = map_has parser_flags "nodo" in
           let _ = map_set parser_flags "nodo" VNil in
           let (es, r2) = parse_puts_args r Nil in
           let _ = if had then () else map_delete parser_flags "nodo" in
           (if starts_block r2 then
              let (bp, bb, r4) = parse_block r2 in (ECallB (id, es, bp, bb), r4)
            else (ECall (id, es), r2))
         else (enc_pseudo_var id, r))
  | Cons (TP p, r) ->
    if str_eq p "(s" then
      // a desugared string literal: ("" + seg + ...) with a marked opener
      // so `foo "a".."b"` stays an argument, not a call's parens.
      let (e, r2) = parse_expr r in
      let r3 = expect r2 ")" in
      // adjacent string literals concatenate: "a" "b" is "ab".
      concat_adjacent_strings e r3
    else if is_lparen p then
      // () is nil; inside parens the word operators and/or (lowest
      // precedence) are usable: (a and b).
      (match r with
       | Cons (TP rp, r1) ->
         if str_eq rp ")" then (ENil, r1)
         else paren_body r
       | _ -> paren_body r)
    else if str_eq p "[" || str_eq p " [" then parse_array r
    else if str_eq p "\{" then parse_hash r
    else if str_eq p "::" then
      // leading ::Const — a top-level constant, read by bare name.
      (match r with Cons (TId n, r2) -> (EConst n, r2) | _ -> fail "mere-ruby: expected constant after ::")
    else if str_eq p ".." || str_eq p "..." then
      // beginless range (..5)
      let (hi, r2) = parse_bin r 1 in
      (ERange (EInt (0 - 4611686018427387903), hi, str_eq p "..."), r2)
    else if str_eq p "->" then
      // -> (params) { body } / -> x { body } / -> { body } lambda literal.
      let (params, lds, r1) =
        (match r with
         | Cons (TP lp, r2) ->
           if str_eq lp "(" then let (ps, ds, r3) = parse_params r2 Nil Nil in (ps, ds, r3)
           else if str_eq lp "*" || str_eq lp "**" || str_eq lp "&" then lambda_bare_params r Nil Nil
           else (Nil, Nil, r)
         | Cons (TId n, r2) ->
           if str_eq n "do" then ((Nil : str list), (Nil : (str * Expr) list), r)
           else lambda_bare_params r Nil Nil
         | _ -> (Nil, Nil, r)) in
      // `-> () { _1 }` has an explicit (empty) parameter list, which forbids a
      // numbered parameter in the body (checked once the body is parsed).
      let empty_parens = (match params with Nil -> (match r with Cons (TP lp, _) -> str_eq lp "(" | _ -> false) | _ -> false) in
      // `-> a=a() { a }` — the default's call grabs the brace block; when no
      // block opener follows, take that block back as the lambda body.
      let (lds, r1, swallowed) =
        (match starts_block r1 with
         | true -> (lds, r1, (false, (Nil : str list), (Nil : Stmt list)))
         | false ->
           (match last_default_block lds with
            | (true, lds2, sbp, sbb) -> (lds2, r1, (true, sbp, sbb))
            | (false, _, _, _) -> (lds, r1, (false, Nil, Nil)))) in
      let (bp, bb, r4) =
        (match swallowed with
         | (true, sbp, sbb) -> (sbp, sbb, r1)
         | (false, _, _) -> parse_block r1) in
      // carry the empty-params sentinel so a numbered param in the body is
      // rejected (numbered_misuse_expr checks a non-empty ELambda param list).
      let params = if empty_parens then Cons (empty_bp_marker, Nil) else params in
      let allp = list_append_str params bp in
      // optional params (defaults) relax the strict lambda arity check via
      // a hidden anonymous splat; kw defaults keep their own binding.
      let pds = plain_defaults lds in
      let allp2 = (match pds with
                   | Nil -> allp
                   | _ -> if psplat_any allp then allp else list_append_str allp (Cons ("*", Nil))) in
      (ELambda (allp2, defaults_prologue pds bb), r4)
    else fail ("mere-ruby: unexpected token: " ++ p)
  | _ -> fail "mere-ruby: unexpected end of input"

and parse_array = fn toks0 ->
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (EArr Nil, r) else parse_arr_items toks Nil
  | _ -> parse_arr_items toks Nil

and parse_arr_items = fn toks -> fn (acc: Expr list) ->
  // splat element [*x] and symbol-key trailing hash [.., k: v] forms.
  match toks with
  | Cons (TP st, r0b) ->
    if str_eq st "*" then
      let (inner, r1) = parse_expr r0b in
      arr_items_sep (skip_nls r1) (Cons (ESplat inner, acc))
    else parse_arr_expr toks acc
  | Cons (TId n, Cons (TP col, r0c)) ->
    if str_eq col ":" then
      let (v, r1) = parse_expr (skip_nls r0c) in
      arr_hash_items (skip_nls r1) acc (Cons (v, Cons (ESym n, Nil)))
    else parse_arr_expr toks acc
  | _ -> parse_arr_expr toks acc

and arr_items_sep = fn r -> fn (acc: Expr list) ->
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `[1, 2,]` — a hanging comma before the closing bracket.
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app acc Nil), r3)
         else parse_arr_items (skip_nls r2) acc
       | _ -> parse_arr_items (skip_nls r2) acc)
    else if str_eq p "]" then (EArr (rev_app acc Nil), r2)
    else fail ("mere-ruby: expected , or ] in array, got " ++ p)
  | _ -> fail "mere-ruby: unterminated array literal"

and parse_arr_expr = fn toks -> fn (acc: Expr list) ->
  let (e, r0) = parse_expr toks in
  let r = skip_nls r0 in   // allow a newline before the , or ]
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TP rb, r3) ->
         if str_eq rb "]" then (EArr (rev_app (Cons (e, acc)) Nil), r3)
         else parse_arr_items (skip_nls r2) (Cons (e, acc))
       | _ -> parse_arr_items (skip_nls r2) (Cons (e, acc)))
    else if str_eq p "]" then (EArr (rev_app (Cons (e, acc)) Nil), r2)
    // trailing hash without braces: ["a", "b" => 1, "c" => 2]
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      arr_hash_items r3 acc (Cons (v, Cons (e, Nil)))
    else fail ("mere-ruby: expected , or ] in array, got " ++ p)
  | _ -> fail "mere-ruby: unterminated array literal"

// remaining k => v pairs of an array's trailing hash (hp is reversed v,k).
and arr_hash_items = fn toks -> fn (acc: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (EArr (rev_app acc (Cons (EHsh (rev_app hp Nil), Nil))), r)
    else if str_eq p "," then
      (match skip_nls r with
       | Cons (TId n2, Cons (TP c2, r2b)) ->
         if str_eq c2 ":" then
           let (v, r4) = parse_expr (skip_nls r2b) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (ESym n2, hp)))
         else
           let (k, r2) = parse_expr (skip_nls r) in
           let r3 = expect r2 "=>" in
           let (v, r4) = parse_expr (skip_nls r3) in
           arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp)))
       | other ->
         let (k, r2) = parse_expr other in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         arr_hash_items (skip_nls r4) acc (Cons (v, Cons (k, hp))))
    else fail ("mere-ruby: expected , or ] in array hash, got " ++ p)
  | _ -> fail "mere-ruby: unterminated array literal"

and parse_hash = fn toks ->
  // a multiline hash literal may break after `{` (and before `}`).
  let toks = skip_nls toks in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "}" then (EHsh Nil, r) else parse_hash_items toks Nil
  | _ -> parse_hash_items toks Nil

// a general hash key: `expr => v`, or `"string": v` (a symbol key).
and hash_key_expr = fn toks ->
  let (ke, r) = parse_expr toks in
  match r with
  | Cons (TP c, r2) ->
    if str_eq c ":" then (EMethod (ke, "to_sym", Nil), r2)
    else (ke, expect r "=>")
  | _ -> (ke, expect r "=>")

and parse_hash_items = fn toks -> fn (acc: Expr list) ->
  // `**h` splices another hash's pairs into this literal.
  match toks with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      let (inner, r1) = parse_expr r0 in
      hash_items_sep r1 (Cons (EKwSplat inner, Cons (EKwSplat inner, acc)))
    else parse_hash_items_kv toks acc
  | _ -> parse_hash_items_kv toks acc

and hash_items_sep = fn r3 -> fn (acc: Expr list) ->
  match skip_nls r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then (EHsh (rev_app acc Nil), r5)
         else parse_hash_items (skip_nls r4) acc
       | _ -> parse_hash_items (skip_nls r4) acc)
    else if str_eq p "}" then (EHsh (rev_app acc Nil), r4)
    else fail ("mere-ruby: expected , or } in hash, got " ++ p)
  | _ -> fail "mere-ruby: unterminated hash literal"

and parse_hash_items_kv = fn toks -> fn (acc: Expr list) ->
  // `name: value` symbol-key shorthand is equivalent to `:name => value`.
  let (k, r2) =
    (match toks with
     | Cons (TId name, Cons (TP colon, r0)) ->
       if str_eq colon ":" then (ESym name, r0)
       else hash_key_expr toks
     | _ -> hash_key_expr toks) in
  // `{a:}` / `{a:, b:}` — an omitted value reads the same-named variable.
  let omitted =
    (match k with
     | ESym _ ->
       (match r2 with
        | Cons (TP nx, _) -> str_eq nx "}" || str_eq nx ","
        | _ -> false)
     | _ -> false) in
  if omitted then
    (match k with
     | ESym nm -> hash_items_sep r2 (Cons (EVar nm, Cons (k, acc)))
     | _ -> fail "mere-ruby: bad hash key")
  else
  let (v, r3a) = parse_expr r2 in
  let r3 = skip_nls r3a in
  match r3 with
  | Cons (TP p, r4) ->
    if str_eq p "," then
      // `{a: 1, b: 2,}` — a hanging comma before the closing brace.
      (match skip_nls r4 with
       | Cons (TP rb, r5) ->
         if str_eq rb "}" then (EHsh (rev_app (Cons (v, Cons (k, acc))) Nil), r5)
         else parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc)))
       | _ -> parse_hash_items (skip_nls r4) (Cons (v, Cons (k, acc))))
    else if str_eq p "}" then (EHsh (rev_app (Cons (v, Cons (k, acc))) Nil), r4)
    else fail ("mere-ruby: expected , or } in hash, got " ++ p)
  | _ -> fail "mere-ruby: unterminated hash literal"

// call arguments after the opening `(` (already consumed); handles the
// empty `()` case.
and parse_call_args = fn toks0 ->
  // a newline right after `(` is allowed (multi-line argument lists).
  let toks = skip_nls toks0 in
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (Nil, r) else parse_call_items toks Nil
  | _ -> parse_call_items toks Nil

// Arguments may end with bare hash pairs — old-style `k => v` or keyword
// `name: value` — which Ruby collects into a single trailing Hash argument.
// `pos` accumulates positional args (reversed); `hp` accumulates hash pairs
// as v,k,v,k (reversed), emitted as one trailing EHsh.
and parse_call_items = fn toks -> fn (acc: Expr list) ->
  parse_call_go toks acc Nil

and parse_call_go = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TId name, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      // `m(a:, b:)` — an omitted value reads the same-named variable.
      (match r0 with
       | Cons (TP nx, _) ->
         if str_eq nx "," || str_eq nx ")" then
           parse_call_sep r0 pos (Cons (EVar name, Cons (ESym name, hp)))
         else
           let (v, r1) = parse_expr r0 in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp)))
       | _ ->
         let (v, r1) = parse_expr r0 in parse_call_sep r1 pos (Cons (v, Cons (ESym name, hp))))
    else parse_call_pos_arg toks pos hp
  | Cons (TP star, r0) ->
    if str_eq star "*" then
      let (inner, r1) = parse_expr r0 in parse_call_sep r1 (Cons (ESplat inner, pos)) hp
    else if str_eq star "**" then
      // **hash spreads as the call's keyword hash.
      let (inner, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EKwSplat inner, pos)) hp
    else if str_eq star "..." then
      // `foo(...)` forwards the collected positional args.
      parse_call_sep r0 (Cons (ESplat (EVar "__fwd"), pos)) hp
    else if str_eq star "&" then
      // block-pass `&:sym` / `&expr`; bare `&` forwards the anonymous block.
      (match r0 with
       | Cons (TP nx, _) ->
         if str_eq nx ")" || str_eq nx "," then
           parse_call_sep r0 (Cons (EBlockPass (EVar "__anonblk"), pos)) hp
         else let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp
       | _ -> let (be, r1) = parse_expr r0 in parse_call_sep r1 (Cons (EBlockPass be, pos)) hp)
    else parse_call_pos_arg toks pos hp
  | _ -> parse_call_pos_arg toks pos hp

and parse_call_pos_arg = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "=>" then
      let (v, r3) = parse_expr r2 in parse_call_sep r3 pos (Cons (v, Cons (e, hp)))
    else parse_call_sep r (Cons (e, pos)) hp
  | _ -> parse_call_sep r (Cons (e, pos)) hp

and parse_call_sep = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match skip_nls toks with
  | Cons (TP p, r) ->
    if str_eq p "," then
      // `f(1,)` — a vestigial trailing comma before the close paren.
      (match skip_nls r with
       | Cons (TP rp, r2) ->
         if str_eq rp ")" then (finish_call_args pos hp, r2) else parse_call_go (skip_nls r) pos hp
       | _ -> parse_call_go (skip_nls r) pos hp)
    else if str_eq p ")" then (finish_call_args pos hp, r)
    else fail ("mere-ruby: expected , or ) in argument list, got " ++ p)
  | _ -> fail "mere-ruby: unterminated argument list"

and finish_call_args = fn (pos: Expr list) -> fn (hp: Expr list) ->
  match hp with
  | Nil -> rev_app pos Nil
  | _ -> rev_app pos (Cons (EKwHash (rev_app hp Nil), Nil))

// ---- statements — SAME mutual-recursion group as the expression parser,
// because a block body (`{ ... }` / `do ... end`) parses statements while
// parse_postfix parses the block. ----------------------------------------
and parse_puts_args = fn toks -> fn (acc: Expr list) ->
  // trailing keyword-hash arguments in a paren-less call (`d :s, shared: true`)
  // collect into one Hash argument, like the parenthesized form.
  match toks with
  | Cons (TId kname, Cons (TP colon, r0)) ->
    if str_eq colon ":" then
      let (hp, r) = parse_bare_kw_pairs r0 kname Nil in
      (rev_app (Cons (EKwHash hp, acc)) Nil, r)
    else parse_puts_args_pos toks acc
  // splat / block-pass arguments in a paren-less call: `send :m=, *x, 1`.
  | Cons (TP st, r0) ->
    if str_eq st "*" then
      let (inner, r1) = parse_expr r0 in
      (match r1 with
       | Cons (TP c2, r2) ->
         if str_eq c2 "," then parse_puts_args (skip_nls r2) (Cons (ESplat inner, acc))
         else (rev_app (Cons (ESplat inner, acc)) Nil, r1)
       | _ -> (rev_app (Cons (ESplat inner, acc)) Nil, r1))
    else if str_eq st "&" then
      let (inner, r1) = parse_expr r0 in
      (rev_app (Cons (EBlockPass inner, acc)) Nil, r1)
    else parse_puts_args_pos toks acc
  | _ -> parse_puts_args_pos toks acc

and parse_bare_rockets = fn toks -> fn (pos: Expr list) -> fn (hp: Expr list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then
      (match skip_nls r with
       | Cons (TNL, _) -> (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)
       | rr ->
         let (k, r2) = parse_expr rr in
         let r3 = expect r2 "=>" in
         let (v, r4) = parse_expr (skip_nls r3) in
         parse_bare_rockets r4 pos (Cons (v, Cons (k, hp))))
    else (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)
  | _ -> (rev_app (Cons (EKwHash (rev_app hp Nil), pos)) Nil, toks)

and parse_bare_kw_pairs = fn toks -> fn (kname: str) -> fn (acc: Expr list) ->
  let (v, r) = parse_expr toks in
  let acc2 = Cons (v, Cons (ESym kname, acc)) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match skip_nls r2 with
       | Cons (TId k2, Cons (TP colon2, r3)) ->
         if str_eq colon2 ":" then parse_bare_kw_pairs r3 k2 acc2
         else fail "mere-ruby: expected keyword argument"
       | _ -> fail "mere-ruby: expected keyword argument")
    else (rev_app acc2 Nil, r)
  | _ -> (rev_app acc2 Nil, r)

and parse_puts_args_pos = fn toks -> fn (acc: Expr list) ->
  let (e, r) = parse_expr toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_puts_args (skip_nls r2) (Cons (e, acc))
    // trailing `k => v` pairs collect into one Hash argument.
    else if str_eq p "=>" then
      let (v, r3) = parse_expr (skip_nls r2) in
      parse_bare_rockets r3 acc (Cons (v, Cons (e, Nil)))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// parse statements until a block-closing keyword (end / else / elsif /
// when) or EOF; the closer is left unconsumed for the caller.
and parse_stmts = fn toks -> fn (acc: Stmt list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TEOF, _) -> (rev_app acc Nil, t)
  | Cons (TId id, _) ->
    if is_block_stop id then (rev_app acc Nil, t)
    else
      let (s0, r0) = parse_stmt t in
      let (s, r) = apply_modifier s0 r0 in
      parse_stmts (expect_end r) (Cons (s, acc))
  | _ ->
    let (s0, r0) = parse_stmt t in
    let (s, r) = apply_modifier s0 r0 in
    parse_stmts (expect_end r) (Cons (s, acc))

// trailing statement modifiers: `STMT if C`, `unless C`, `while C`,
// `until C`. Each desugars to the corresponding block form wrapping the
// single statement.
and apply_modifier = fn (s: Stmt) -> fn toks ->
  match toks with
  // one-line pattern matching at statement level: `expr => pat` (bind-or-raise)
  // and `expr in pat` (boolean). Only a plain expression statement qualifies.
  | Cons (TP arrow, r) ->
    if str_eq arrow "=>" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchBind (e, pat))) r2
       | _ -> (s, toks))
    else (s, toks)
  | Cons (TId id, r) ->
    if str_eq id "in" then
      (match s with
       | SExpr e -> let (pat, r2) = parse_pattern_top r in apply_modifier (SExpr (EMatchTest (e, pat))) r2
       | _ -> (s, toks))
    else if str_eq id "if" then
      let (c0, r2) = parse_andor r in
      let c = cond_ff c0 in
      (SIf (Cons ((c, Cons (s, Nil)), Nil), decl_of s), r2)
    else if str_eq id "unless" then
      let (c0, r2) = parse_andor r in
      let c = cond_ff c0 in
      (SIf (Cons ((EUn ("!", c), Cons (s, Nil)), Nil), decl_of s), r2)
    else if str_eq id "while" then
      let (c, r2) = parse_andor r in
      // `begin ... end while cond` is do-while: run the body once, then loop.
      (match s with
       | SBegin (_, _, _, _) -> (SDoWhile (s, c), r2)
       | _ -> (SWhile (c, Cons (s, Nil)), r2))
    else if str_eq id "until" then
      let (c, r2) = parse_andor r in
      (match s with
       | SBegin (_, _, _, _) -> (SDoWhile (s, EUn ("!", c)), r2)
       | _ -> (SWhile (EUn ("!", c), Cons (s, Nil)), r2))
    else if str_eq id "rescue" then
      // `expr rescue fallback` — a one-line begin/rescue.
      let (h, r2) = parse_stmt r in
      // rescue binds tighter than `=`: `a = b rescue c` is `a = (b rescue c)`,
      // so the assignment still happens with the fallback value. (Op-assigns
      // like `+=` keep the whole-statement sense.)
      (match s with
       | SAssign (n, rhs) ->
         (SAssign (n, EStmt (SBegin (Cons (SExpr rhs, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil))), r2)
       | _ -> (SBegin (Cons (s, Nil), Cons ((Nil, "", Cons (h, Nil)), Nil), Nil, Nil), r2))
    else if str_eq id "and" || str_eq id "or" then
      // lowest-precedence: `x = 1 and y = 2` runs the second statement
      // only when the first one's value is truthy. After break/next/
      // return the left side has no value — a SyntaxError in Ruby.
      let _ = (match s with
               | SBreak _ -> fail "mere-ruby: void value expression"
               | SNext _ -> fail "mere-ruby: void value expression"
               | SReturn _ -> fail "mere-ruby: void value expression"
               | _ -> ()) in
      let (s2, r2) = parse_stmt r in
      apply_modifier (if str_eq id "and" then SAndThen (s, s2) else SOrElse (s, s2)) r2
    else (s, toks)
  | _ -> (s, toks)

// `if ... end.method` — a control construct used as an expression with a
// trailing method chain (common in specs: `unless x ... end.should == y`).
and stmt_postfix = fn (s: Stmt) -> fn toks ->
  match toks with
  | Cons (TP dot, _) ->
    if str_eq dot "." then
      let (e0, r1) = parse_postfix_more (EStmt s) toks in
      let (e, r2) = parse_more e0 r1 1 in
      (SExpr e, r2)
    // `case ... end + ...` — a binary operator continues the expression.
    else if prec_of dot > 0 then
      let (e, r2) = parse_more (EStmt s) toks 1 in (SExpr e, r2)
    else (s, toks)
  | _ -> (s, toks)

// Ruby defines the local targets of an assignment at parse time, so a
// modifier-guarded assignment that never runs still leaves nil locals.
// The skipped branch declares them (only if not already bound).
// the plain-local names among complex assignment targets (for nil-declare).
and x_target_names = fn (ts: Expr list) ->
  match ts with
  | Nil -> Nil
  | Cons (t, r) ->
    (match t with
     | EVar n ->
       if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then x_target_names r
       else Cons (n, x_target_names r)
     | ESplat inner ->
       (match inner with
        | EVar n -> Cons (n, x_target_names r)
        | _ -> x_target_names r)
     | EArr inner -> list_append_str (x_target_names inner) (x_target_names r)
     | _ -> x_target_names r)

and decl_of = fn (s: Stmt) ->
  match s with
  | SAssign (n, _) ->
    if str_len n > 0 && (str_eq (char_at n 0) "$" || is_upper_first n) then Nil
    else Cons (SDeclare (Cons (n, Nil)), Nil)
  | SMultiAssign (ts, _) -> Cons (SDeclare ts, Nil)
  | SMultiAssignX (ts, _) -> Cons (SDeclare (x_target_names ts), Nil)
  | _ -> Nil

// a statement that begins `id ,` (a bare non-keyword identifier then a
// comma) or `* id` is a multiple assignment target list.
and looks_like_multi = fn toks ->
  match toks with
  | Cons (TId nm, Cons (TP c, _)) -> (if is_keyword nm then false else str_eq c ",")
  | Cons (TP star, Cons (TId _, _)) -> str_eq star "*"
  | _ -> false

// `undef a, b, :c` — a comma-separated list of bare/:symbol method names.
and parse_undef_names = fn toks -> fn (acc: str list) ->
  let (n, r) = parse_alias_name toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_undef_names r2 (Cons (n, acc)) else (rev_app (Cons (n, acc)) Nil, r)
  | _ -> (rev_app (Cons (n, acc)) Nil, r)

// an alias name is a bare identifier or a :symbol.
// fold a constant string/symbol interpolation expression to its text, for
// dynamic alias/undef names like alias :"#{'m3'}" m1.
and const_fold_str = fn (e: Expr) ->
  match e with
  | EStrL s -> s
  | ESym s -> s
  | EInt n -> str_of_int n
  | EBig s -> s
  | EBool b -> if b then "true" else "false"
  | ENil -> ""
  | EBin (o, a, b) -> if str_eq o "+" then const_fold_str a ++ const_fold_str b else fail "mere-ruby: cannot constant-fold alias name"
  | EMethod (rc, m, _) -> if str_eq m "to_s" || str_eq m "to_sym" || str_eq m "to_str" then const_fold_str rc else fail "mere-ruby: cannot constant-fold alias name"
  | _ -> fail "mere-ruby: cannot constant-fold alias name"

and parse_alias_name = fn toks ->
  match toks with
  | Cons (TId n, r) -> (n, r)
  | Cons (TSym n, r) -> (n, r)
  | Cons (TP op, r) ->
    // an interpolated symbol :"#{...}" lexes as ("" + ...).to_sym; fold it.
    if str_eq op "(s" then
      (let (e, r2) = parse_primary toks in
       let folded = const_fold_str e in
       let r3 = (match r2 with Cons (TP dot, Cons (TId ts, r4)) -> if str_eq dot "." && (str_eq ts "to_sym" || str_eq ts "to_s") then r4 else r2 | _ -> r2) in
       (folded, r3))
    else if is_op_method_name op then (op, r)
    else if str_eq op "[" then
      (match r with
       | Cons (TP rb2, r2) ->
         if str_eq rb2 "]" then
           (match r2 with
            | Cons (TP eq2, r3) -> if str_eq eq2 "=" then ("[]=", r3) else ("[]", r2)
            | _ -> ("[]", r2))
         else fail "mere-ruby: expected a name in alias"
       | _ -> fail "mere-ruby: expected a name in alias")
    else fail "mere-ruby: expected a name in alias"
  | _ -> fail "mere-ruby: expected a name in alias"

// consume optional `, Name, Name` after `include M` (ignored).
and maybe_more_names = fn toks ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then (match r with Cons (TId _, r2) -> maybe_more_names r2 | _ -> (0, toks))
    else (0, toks)
  | _ -> (0, toks)

// extend a constant name with any trailing `::Name` scope segments.
and scoped_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, Cons (TId n, r)) -> if str_eq p "::" then scoped_name (acc ++ "::" ++ n) r else (acc, toks)
  | _ -> (acc, toks)

// extend `A::B` through further ::Name segments; returns (full, rest).
and scoped_const_path = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TId n, r) ->
    if is_cap n then
      (match r with
       | Cons (TP sc, r2) ->
         if str_eq sc "::" then scoped_const_path (acc ++ "::" ++ n) r2
         else (acc ++ "::" ++ n, r)
       | _ -> (acc ++ "::" ++ n, r))
    else (acc, toks)
  | _ -> (acc, toks)

and parse_multi = fn toks ->
  let (targets, r) = parse_target_list toks Nil in   // consumes through `=`
  let (rhs, r2) = parse_rhs_list r Nil in
  (SMultiAssign (targets, rhs), r2)

// multiple assignment whose targets include indexing / attribute writes
// (`foo[0], bar.baz = a, b`). Targets parse as postfix chains; the writer
// invokes m= / []= at assignment time.
// replace the last argument v with [v, more...] (multi-value []= RHS).
and grow_last_arg = fn (args: Expr list) -> fn (more: Expr list) ->
  match args with
  | Nil -> Cons (EArr more, Nil)
  | Cons (v, Nil) -> Cons (EArr (Cons (v, more)), Nil)
  | Cons (h, t) -> Cons (h, grow_last_arg t more)

and parse_multix = fn toks ->
  let (targets, r) = parse_x_targets toks Nil in
  let (rhs, r2) = parse_rhs_list r Nil in
  (SMultiAssignX (targets, rhs), r2)

and parse_x_targets = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         // `* = 1` — an anonymous splat consumes (and discards) values.
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx "=" || str_eq nx "," then (ESplat ENil, r0)
            else let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1)
          | _ -> let (inner, r1) = parse_x_target1 r0 in (ESplat inner, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      // `a, = 1` — a trailing comma ends the target list.
      (match r2 with
       | Cons (TP eq2, r3) ->
         if str_eq eq2 "=" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_targets r2 (Cons (t, acc))
       | _ -> parse_x_targets r2 (Cons (t, acc)))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else fail ("mere-ruby: expected , or = in multiple assignment, got " ++ p)
  | _ -> fail "mere-ruby: unterminated multiple-assignment targets"

// one assignment target: a name (local/@ivar/$global) followed by .attr /
// [index] chains. Unlike parse_postfix this never consumes `= rhs`.
and parse_x_target1 = fn toks ->
  match toks with
  | Cons (TId nm, r) ->
    if is_ivar nm then parse_x_chain (EIVar (substring nm 1 (str_len nm))) r
    else parse_x_chain (EVar nm) r
  // a parenthesized group destructures one value: ((a, b), c) = ...
  | Cons (TP lp, r) ->
    if str_eq lp "(" then let (ts, r2) = parse_x_group r Nil in (EArr ts, r2)
    else fail "mere-ruby: bad assignment target"
  | _ -> fail "mere-ruby: bad assignment target"

and parse_x_group = fn toks -> fn (acc: Expr list) ->
  let (t, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then
         (match r0 with
          | Cons (TP nx, _) ->
            if str_eq nx ")" || str_eq nx "," then (ESplat ENil, r0)
            else let (i, r1) = parse_x_target1 r0 in (ESplat i, r1)
          | _ -> let (i, r1) = parse_x_target1 r0 in (ESplat i, r1))
       else parse_x_target1 toks
     | _ -> parse_x_target1 toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then
      (match r2 with
       // `(e,)` — a trailing comma inside the group
       | Cons (TP rp, r3) ->
         if str_eq rp ")" then (rev_app (Cons (t, acc)) Nil, r3)
         else parse_x_group r2 (Cons (t, acc))
       | _ -> parse_x_group r2 (Cons (t, acc)))
    else if str_eq p ")" then (rev_app (Cons (t, acc)) Nil, r2)
    else fail ("mere-ruby: expected , or ) in grouped target, got " ++ p)
  | _ -> fail "mere-ruby: unterminated grouped target"

and parse_x_chain = fn (recv: Expr) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (EMethod (recv, m, Nil)) r2
       | _ -> fail "mere-ruby: bad assignment target")
    else if str_eq p "[" then
      let (idxs, r2) = parse_x_idx r Nil in
      parse_x_chain (EMethod (recv, "[]", idxs)) r2
    else if str_eq p "&." then
      (match r with
       | Cons (TId m, r2) -> parse_x_chain (ESafe (recv, m, Nil)) r2
       | _ -> fail "mere-ruby: bad assignment target")
    else if str_eq p "::" then
      (match r with
       | Cons (TId cn, r2) ->
         let recv2 = (match recv with EVar n -> (if is_upper_first n then EConst n else recv) | _ -> recv) in
         parse_x_chain (EScopedRead (recv2, cn)) r2
       | _ -> fail "mere-ruby: bad assignment target")
    else (recv, toks)
  | _ -> (recv, toks)

and parse_x_idx = fn toks -> fn (acc: Expr list) ->
  let (e, r) =
    (match toks with
     | Cons (TP st, r0) ->
       if str_eq st "*" then let (i, r1) = parse_expr r0 in (ESplat i, r1)
       // `recv[&blk]` — a block-pass index argument (recv.[](&blk)).
       else if str_eq st "&" || str_eq st " &" then let (i, r1) = parse_expr r0 in (EBlockPass i, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_x_idx r2 (Cons (e, acc))
    else if str_eq p "]" then (rev_app (Cons (e, acc)) Nil, r2)
    // `recv[k => v, ...]` — the pairs form a single trailing Hash argument
    // (this is how Hash[1 => 2] and obj[k => v] are written).
    else if str_eq p "=>" then
      let (v, r3) = parse_expr r2 in
      let (pairs, r4) = parse_x_idx_pairs r3 (Cons (v, Cons (e, Nil))) in
      (rev_app (Cons (EHsh (rev_app pairs Nil), acc)) Nil, r4)
    else fail ("mere-ruby: expected , or ] in index target, got " ++ p)
  | _ -> fail "mere-ruby: unterminated index target"

and parse_x_idx_pairs = fn toks -> fn (acc: Expr list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "]" then (acc, r)
    else if str_eq p "," then
      let (k, r2) = parse_expr r in
      (match r2 with
       | Cons (TP a, r3) -> if str_eq a "=>" then (let (v, r4) = parse_expr r3 in parse_x_idx_pairs r4 (Cons (v, Cons (k, acc)))) else fail "mere-ruby: expected => in index hash"
       | _ -> fail "mere-ruby: expected => in index hash")
    else fail "mere-ruby: expected , or ] in index hash"
  | _ -> fail "mere-ruby: unterminated index hash"

// does this statement look like a complex multiple assignment? Scan to a
// top-level `=` requiring a top-level `,` first; two adjacent value tokens
// (a paren-less command call) or a structural keyword call it off.
and looks_like_multix = fn toks ->
  match toks with
  | Cons (TId nm, _) -> if is_keyword nm then false else scan_mx toks 0 false false
  // a leading group: a comma or splat at depth 1 marks targets too ((*a) = ...)
  | Cons (TP lp, r) ->
    if str_eq lp "(" then scan_mx toks 0 false true
    // a leading splat is itself a target (* = 1, *a = ...), if an = follows.
    else if str_eq lp "*" then scan_mx r 0 true false
    else false
  | _ -> false

and scan_mx = fn toks -> fn (depth: int) -> fn (seen: bool) -> fn (grp: bool) ->
  match toks with
  | Nil -> false
  | Cons (TNL, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) ->
    if str_eq w "do" || str_eq w "then" || str_eq w "if" || str_eq w "unless" ||
       str_eq w "while" || str_eq w "until" || str_eq w "and" || str_eq w "or" ||
       str_eq w "rescue" then false
    else
      (match r with
       | Cons (TId _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TInt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TFlt _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TStrL _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | Cons (TSym _, _) -> if depth == 0 then false else scan_mx r depth seen grp
       | _ -> scan_mx r depth seen grp)
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      scan_mx r (depth + 1) seen grp
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then scan_mx r (depth - 1) seen grp
    else if depth == 0 && str_eq p "," then scan_mx r depth true grp
    else if grp && depth == 1 && (str_eq p "," || str_eq p "*") then scan_mx r depth true grp
    else if depth == 0 && str_eq p "=" then seen
    else if depth == 0 && str_eq p "?" then false
    else if depth == 0 && (if str_eq (opassign_base p) "" then false else true) then false
    else scan_mx r depth seen grp
  | Cons (_, r) -> scan_mx r depth seen grp

and parse_target_list = fn toks -> fn (acc: str list) ->
  let (t, r) = parse_one_target toks in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_target_list r2 (Cons (t, acc))
    else if str_eq p "=" then (rev_app (Cons (t, acc)) Nil, r2)
    else fail ("mere-ruby: expected , or = in multiple assignment, got " ++ p)
  | _ -> fail "mere-ruby: unterminated multiple-assignment targets"

and parse_one_target = fn toks ->
  match toks with
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with Cons (TId nm, r2) -> ("*" ++ nm, r2) | _ -> ("*", r))
    else fail "mere-ruby: bad assignment target"
  | Cons (TId nm, r) -> (nm, r)   // plain local, or @ivar (@ kept in the name)
  | _ -> fail "mere-ruby: bad assignment target"

// the RHS of `a = ...`: one value, or a comma list / splat that builds an
// array (`a = 1, 2` and `a = *nil`).
// `x = case/if/begin ... end` — but a trailing binary operator turns the
// construct into an operand of a larger expression (case..end + case..end).
and construct_assign = fn (id: str) -> fn (sb: Stmt) -> fn r4 ->
  match r4 with
  | Cons (TP op, _) ->
    if prec_of op > 0 then
      let (e, r5) = parse_more (EStmt sb) r4 1 in (SAssign (id, e), r5)
    else (SLocalFrom (id, sb), r4)
  | _ -> (SLocalFrom (id, sb), r4)

and sassign_rhs = fn (id: str) -> fn toks ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (single, Nil) ->
     (match single with
      | ESplat _ -> (SAssign (id, EArr es), r)
      | _ -> (SAssign (id, single), r))
   | _ -> (SAssign (id, EArr es), r))

// `break 1, 2` / `next a, b` — several values build an array.
and flow_values = fn toks -> fn (mk: Expr -> Stmt) ->
  let (es, r) = parse_rhs_list toks Nil in
  (match es with
   | Cons (e, Nil) -> (match e with ESplat _ -> (mk (EArr es), r) | _ -> (mk e, r))
   | _ -> (mk (EArr es), r))

and parse_rhs_list = fn toks -> fn (acc: Expr list) ->
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) ->
       if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1)
       else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_rhs_list r2 (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// the read side of a constant op-assign: `||=` treats an undefined constant as
// nil (then assigns); every other op reads it first (NameError if undefined).
and opasgn_const_read = fn (base: str) -> fn (full: str) ->
  if str_eq base "||" then EConstOrNil full else EConst full

and parse_stmt = fn toks ->
  if looks_like_multix toks then parse_multix toks
  else if looks_like_multi toks then parse_multi toks else
  match toks with
  // scoped constant assignment: `A::C = e` / `A::B::C = e` / `::C = e`.
  | Cons (TId a, Cons (TP sc, Cons (TId cn, Cons (TP eq, r)))) ->
    if str_eq sc "::" && (if is_cap a then false else true) && is_cap cn && str_eq eq "=" then
      // `recv::Const = value` with a lowercase (runtime) receiver.
      let (e, r2) = parse_expr r in (SExpr (EScopedAssign (EVar a, cn, e)), r2)
    else if str_eq sc "::" && is_cap a && is_cap cn then
      (if str_eq eq "=" then
         let (e, r2) = parse_expr r in (SAssign (a ++ "::" ++ cn, e), r2)
       else if not (str_eq (opassign_base eq) "") then
         // `A::C op= e` -> `A::C = A::C op e`. `||=` reads undefined as nil;
         // other ops read first, so an undefined constant raises NameError.
         let full = a ++ "::" ++ cn in
         let (e, r2) = parse_expr r in
         (SAssign (full, EBin (opassign_base eq, opasgn_const_read (opassign_base eq) full, e)), r2)
       else if str_eq eq "::" then
         (match scoped_const_path (a ++ "::" ++ cn) r with
          | (full, r2b) ->
            (match r2b with
             | Cons (TP eq2, r3) ->
               if str_eq eq2 "=" then let (e, r4) = parse_expr r3 in (SAssign (full, e), r4)
               // `A::B::C op= e` -> `A::B::C = A::B::C op e` (nil read when undefined).
               else if not (str_eq (opassign_base eq2) "") then
                 let (e, r4) = parse_expr r3 in
                 (SAssign (full, EBin (opassign_base eq2, opasgn_const_read (opassign_base eq2) full, e)), r4)
               else parse_stmt_id toks
             | _ -> parse_stmt_id toks))
       else parse_stmt_id toks)
    else parse_stmt_id toks
  | Cons (TP sc, Cons (TId cn, Cons (TP eq, r))) ->
    if str_eq sc "::" && str_eq eq "=" && is_cap cn then
      // `::Const = v` assigns a TOP-LEVEL constant; keep the :: so a class
      // body doesn't treat it as a class-local constant.
      let (e, r2) = parse_expr r in (SAssign ("::" ++ cn, e), r2)
    else if str_eq sc "::" && is_cap cn && (if str_eq (opassign_base eq) "" then false else true) then
      // `::Const op= e` -> `::Const = ::Const op e`. The write target keeps the
      // `::` (stored top-level as the bare name), so the read uses the bare name.
      let (e, r2) = parse_expr r in
      (SAssign ("::" ++ cn, EBin (opassign_base eq, opasgn_const_read (opassign_base eq) cn, e)), r2)
    else let (e, r2) = parse_expr toks in (SExpr e, r2)
  | Cons (TId id, r) -> parse_stmt_id toks
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

and parse_stmt_id = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    // BEGIN { ... } / END { ... } — run the block body (BEGIN at load time).
    if (str_eq id "BEGIN" || str_eq id "END") &&
       (match r with Cons (TP br, _) -> str_eq br "\{" | _ -> false) then
      (match r with
       | Cons (TP br, r2) ->
         let (body, r3) = parse_brace_stmts r2 Nil in
         (if str_eq id "BEGIN" then SPreexe body else SAtExit body, r3)
       | _ -> fail "mere-ruby: expected block after BEGIN")
    else if str_eq id "puts" then
      (match r with
       | Cons (TNL, _) -> (SPuts Nil, r)
       | Cons (TEOF, _) -> (SPuts Nil, r)
       | _ -> let (es, r2) = parse_puts_args r Nil in (SPuts es, r2))
    else if str_eq id "if" then let (s, r2) = parse_if r false in stmt_postfix s r2
    else if str_eq id "unless" then let (s, r2) = parse_if r true in stmt_postfix s r2
    else if str_eq id "while" then let (s, r2) = parse_while r false in stmt_postfix s r2
    else if str_eq id "until" then let (s, r2) = parse_while r true in stmt_postfix s r2
    else if str_eq id "case" then let (s, r2) = parse_case r in stmt_postfix s r2
    else if str_eq id "for" then let (s, r2) = parse_for r in stmt_postfix s r2
    else if str_eq id "def" then let (s, r2) = parse_def r in stmt_postfix s r2
    else if str_eq id "class" then let (s, r2) = parse_class r in stmt_postfix s r2
    else if str_eq id "module" then let (s, r2) = parse_class r in stmt_postfix (mark_module s) r2
    else if str_eq id "begin" then let (s, r2) = parse_begin r in stmt_postfix s r2
    else if str_eq id "attr_accessor" then parse_attr "rw" r
    else if str_eq id "attr_reader" then parse_attr "r" r
    else if str_eq id "attr_writer" then parse_attr "w" r
    // `attr :sym` (and `attr :a, :b`) is the classic reader-only form.
    else if str_eq id "attr" && (match r with Cons (TSym _, _) -> true | _ -> false) then parse_attr "r" r
    else if str_eq id "alias" then
      // `alias new old` — names may be bare or :symbols.
      let (n1, r1) = parse_alias_name r in
      let (n2, r2) = parse_alias_name r1 in (SAlias (n1, n2), r2)
    else if str_eq id "undef" || str_eq id "undef_method" then
      let (names, r2) = parse_undef_names r Nil in (SUndef names, r2)
    else if str_eq id "include" || str_eq id "prepend" then
      // `include M[, N]` — mix module instance methods in (first module only
      // for now; extra modules are consumed and ignored).
      (match r with
       | Cons (TId m, r2) -> let (full, r2b) = scoped_name m r2 in let (_, r3) = maybe_more_names r2b in (SInclude full, r3)
       | _ -> (SExpr ENil, r))
    else if str_eq id "private" || str_eq id "public" || str_eq id "protected" then
      // visibility: bare form switches the mode for subsequent defs; the
      // named form (`private :m, :n`) marks those methods.
      let mode = if str_eq id "public" then "public" else if str_eq id "protected" then "protected" else "private" in
      (match r with
       | Cons (TNL, _) -> (SVis (mode, Nil), r)
       | Cons (TEOF, _) -> (SVis (mode, Nil), r)
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis (mode, names), r2)
       // `private def m ... end` — the arg is a method definition; parse it,
       // then mark it (def evaluates to its name symbol in Ruby).
       | Cons (TId dw, _) ->
         if str_eq dw "def" then
           (let (ds, r2) = parse_stmt r in
            match ds with
            | SDef (dn, _, _, _) ->
              let base = if str_len dn > 5 && str_eq (substring dn 0 5) "self." then dn else dn in
              (SBegin (Cons (ds, Cons (SVis (mode, Cons (base, Nil)), Nil)), Nil, Nil, Nil), r2)
            | _ -> (ds, r2))
         else let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "require" || str_eq id "require_relative" then
      // load a file into the same world (each file gets a fresh top-level).
      let (e, r2) = parse_expr r in
      (SRequire (str_eq id "require_relative", e), r2)
    // bare `module_function` switches the enclosing module body into a mode
    // where subsequent defs are also module methods (see register_class_v).
    else if str_eq id "module_function" then
      (match r with
       | Cons (TNL, _) -> (SVis ("module_function", Nil), r)
       | Cons (TEOF, _) -> (SVis ("module_function", Nil), r)
       // `module_function :a, :b` promotes those named methods (handled in
       // register_class_v's named-SVis branch).
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("module_function", names), r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    // `private_class_method :m` marks a class method private (in register_class_v).
    else if str_eq id "private_class_method" then
      (match r with
       | Cons (TSym _, _) -> let (names, r2) = parse_undef_names r Nil in (SVis ("private_class_method", names), r2)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "public_class_method" ||
            str_eq id "private_constant" then
      // visibility / require: accepted as no-ops.
      // (`using` is NOT here — it parses as a real call so refinements activate.)
      (match r with
       | Cons (TNL, _) -> (SExpr ENil, r)
       | Cons (TEOF, _) -> (SExpr ENil, r)
       | _ -> let (_, r2) = parse_rhs_list r Nil in (SExpr ENil, r2))
    else if str_eq id "extend" then
      // `extend M` mixes a module's instance methods into the receiver's
      // singleton class (self, in a class/module body). Parse as a real call
      // so the eval-time handler records the singleton include.
      (match r with
       | Cons (TNL, _) -> (SExpr (ECall ("extend", Nil)), r)
       | Cons (TEOF, _) -> (SExpr (ECall ("extend", Nil)), r)
       | _ -> let (es, r2) = parse_rhs_list r Nil in (SExpr (ECall ("extend", es)), r2))
    else if str_eq id "return" then
      (match r with
       | Cons (TNL, _) -> (SReturn ENil, r)
       | Cons (TEOF, _) -> (SReturn ENil, r)
       // `return if c` / `return unless c` — a value-less return under a
       // statement modifier (the caller attaches the modifier).
       | Cons (TId w, _) ->
         if str_eq w "if" || str_eq w "unless" || str_eq w "while" || str_eq w "until" then (SReturn ENil, r)
         else
           let (es, r2) = parse_rhs_list r Nil in
           (match es with
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | Cons (TP rp, _) ->
         if str_eq rp "}" || str_eq rp ")" || str_eq rp ";" then (SReturn ENil, r)
         else
           let (es, r2) = parse_rhs_list r Nil in
           (match es with
            // `return *x` returns an array (splat-coerced), like `return a, b`.
            | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
            | _ -> (SReturn (EArr es), r2))
       | _ ->
         // `return a, b` returns an array of the values.
         let (es, r2) = parse_rhs_list r Nil in
         (match es with
          | Cons (e, Nil) -> (match e with ESplat _ -> (SReturn (EArr es), r2) | _ -> (SReturn e, r2))
          | _ -> (SReturn (EArr es), r2)))
    else if str_eq id "break" then
      (match r with
       | Cons (TNL, _) -> (SBreak ENil, r)
       | Cons (TEOF, _) -> (SBreak ENil, r)
       | Cons (TId k, _) -> if stops_value k then (SBreak ENil, r) else let (e, r2) = parse_expr r in (SBreak e, r2)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SBreak ENil, r)
         else flow_values r (fn e -> SBreak e)
       | _ -> flow_values r (fn e -> SBreak e))
    else if str_eq id "next" then
      (match r with
       | Cons (TNL, _) -> (SNext ENil, r)
       | Cons (TEOF, _) -> (SNext ENil, r)
       | Cons (TId k, _) -> if stops_value k then (SNext ENil, r) else let (e, r2) = parse_expr r in (SNext e, r2)
       | Cons (TP p, _) ->
         if str_eq p "}" || str_eq p ")" || str_eq p ";" then (SNext ENil, r)
         else flow_values r (fn e -> SNext e)
       | _ -> flow_values r (fn e -> SNext e))
    else if is_ivar id then
      // @name = expr / @name += expr, else an expression (@name read).
      let nm = substring id 1 (str_len id) in
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" then
           let (e, r3) = parse_expr r2 in (SIVarAssign (nm, e), r3)
         else if not (str_eq (opassign_base p) "") then
           let (e, r3) = parse_expr r2 in
           (SIVarAssign (nm, EBin (opassign_base p, EIVar nm, e)), r3)
         else let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))
    else
      // identifier or expression keyword (self/true/false/nil/Const):
      // a plain `name =` is a local assignment; everything else (including
      // method chains and expression keywords) parses as an expression.
      (match r with
       | Cons (TP p, r2) ->
         if str_eq p "=" && not (is_keyword id) then
           // assigning to the __ENCODING__ pseudo-variable is a SyntaxError.
           if str_eq id "__ENCODING__" then fail "mere-ruby: Can't assign to __ENCODING__" else
           // `var = begin/case/if/unless ... end` binds the construct's value;
           // otherwise it is an ordinary assignment (`Const = expr` routes to
           // the consts table at eval). A newline may follow the `=`.
           let r2 = skip_nls r2 in
           (match r2 with
            | Cons (TId bg, r3) ->
              if str_eq bg "begin" then let (sb, r4) = parse_begin r3 in construct_assign id sb r4
              else if str_eq bg "case" then let (sb, r4) = parse_case r3 in construct_assign id sb r4
              else if str_eq bg "if" then let (sb, r4) = parse_if r3 false in construct_assign id sb r4
              else if str_eq bg "unless" then let (sb, r4) = parse_if r3 true in construct_assign id sb r4
              // chained assignment `a = b = ... = e` binds right-to-left.
              else if (match r3 with Cons (TP eq2, _) -> str_eq eq2 "=" | _ -> false) && not (is_keyword bg) then
                let (s2, r4) = parse_stmt r2 in (SLocalFrom (id, s2), r4)
              else sassign_rhs id r2
            | _ -> sassign_rhs id r2)
         else if not (str_eq (opassign_base p) "") && not (is_keyword id) && not (is_cap id) then
           // `var += expr` -> `var = var <op> expr`
           let (e, r3) = parse_expr r2 in
           (SAssign (id, EBin (opassign_base p, EVar id, e)), r3)
         else if not (str_eq (opassign_base p) "") && is_cap id then
           // `Const op= expr` — a bare constant op-assign (nil read when undefined).
           let (e, r3) = parse_expr r2 in
           (SAssign (id, EBin (opassign_base p, EConstOrNil id, e)), r3)
         else
           let (e, r4) = parse_expr toks in (SExpr e, r4)
       | _ -> let (e, r5) = parse_expr toks in (SExpr e, r5))
  | _ ->
    let (e, r) = parse_expr toks in (SExpr e, r)

// `A::B::C` in a class/module header — the flat model keys on the full
// joined name ("A::B") so `.class` etc. report it the way Ruby does.
and parse_qualified_name = fn (acc: str) -> fn toks ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "::" then (match r with Cons (TId n, r2) -> parse_qualified_name (acc ++ "::" ++ n) r2 | _ -> (acc, toks))
    else (acc, toks)
  | _ -> (acc, toks)

// mark a parsed class statement as a module (sentinel superclass).
and mark_module = fn (s: Stmt) ->
  match s with
  | SClass (n, sup, body) -> if str_eq sup "" then SClass (n, "(module)", body) else s
  | _ -> s

and parse_class = fn toks ->
  match toks with
  // `class << self ... end` — the singleton class: its defs register as
  // class-level methods of the ENCLOSING class (flat-table model).
  | Cons (TP sc0, r0) ->
    if str_eq sc0 "<<" then
      (match r0 with
       // `class << self` (enclosing class) / `class << obj` (a named receiver):
       // the target name rides in the superclass field (flat-table model).
       | Cons (TId slf, r1) ->
         // an ivar/cvar/global receiver (`class << @obj`) is not an env local,
         // so it must be evaluated as an expression rather than resolved by
         // name; true/false/nil likewise route through SSingletonE.
         // any receiver other than `self` — a local variable, a method call
         // (`class << mock('x')`), or a constant (`class << O`) — is evaluated
         // as an expression so its runtime value's singleton class is opened.
         // Only `self` keeps the enclosing-class (named) path.
         if (if str_eq slf "self" then false else true) then
           let (recv, r2) = parse_expr r0 in
           let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end")
         else
           let (body, r5) = parse_class_body_tail r1 in (SClass ("<<singleton", slf, body), expect_kw r5 "end")
       // `class << <expr>` — a paren-expr / literal / ivar receiver.
       | _ ->
         let (recv, r2) = parse_expr r0 in
         let (body, r5) = parse_class_body_tail r2 in (SSingletonE (recv, body), expect_kw r5 "end"))
    else if str_eq sc0 "::" then
      // `class ::C` — a top-level constant regardless of nesting. Keep the `::`
      // prefix so exec treats it as top-level (not qualified under the encloser).
      (match r0 with
       | Cons (TId slf, r1) -> let (name, r) = parse_qualified_name slf r1 in parse_class_rest ("::" ++ name) r
       | _ -> fail "mere-ruby: expected class name after class")
    else fail "mere-ruby: expected class name after class"
  | Cons (TId name0, r0) ->
    let (name, r) = parse_qualified_name name0 r0 in
    parse_class_rest name r
  | _ -> fail "mere-ruby: expected class name after class"

and parse_class_body_tail = fn r2 ->
    let (body0, r5a) = parse_stmts r2 Nil in
    // class-body-level rescue/ensure wraps the body in an implicit begin.
    (match r5a with
     | Cons (TId k, _) ->
       if str_eq k "rescue" || str_eq k "ensure" then
         let (rescues, ra) = parse_rescues r5a Nil in
         let (els, rb) = parse_opt_kw_block ra "else" in
         let (ens, rc) = parse_opt_kw_block rb "ensure" in
         (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
       else (body0, r5a)
     | _ -> (body0, r5a))

and parse_class_rest = fn (name: str) -> fn r ->
    (match r with
     | Cons (TP lt, r3) ->
       if str_eq lt "<" then
         // `< ::B` is a top-level constant; otherwise parse the superclass as an
         // expression. A plain constant keeps the fast name path (SClass); any
         // other expression (method call, self, paren, literal) becomes SClassE.
         (if (match r3 with Cons (TP cc, Cons (TId _, _)) -> str_eq cc "::" | _ -> false) then
            (match r3 with
             | Cons (TP _, Cons (TId sup0, r4)) ->
               let (nm, r4b) = parse_qualified_name sup0 r4 in
               let (body, r5) = parse_class_body_tail r4b in
               (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> fail "mere-ruby: expected superclass name")
          else
            let (se, r4) = parse_expr r3 in
            let (body, r5) = parse_class_body_tail r4 in
            (match se with
             | EConst nm -> (SClass (name, nm, body), expect_kw r5 "end")
             | _ -> (SClassE (name, se, body), expect_kw r5 "end")))
       else
         let (body, r5) = parse_class_body_tail r in
         (SClass (name, "", body), expect_kw r5 "end")
     | _ ->
       let (body, r5) = parse_class_body_tail r in
       (SClass (name, "", body), expect_kw r5 "end"))

// begin body rescue* [else] [ensure] end
and parse_begin = fn toks ->
  let (body, r) = parse_stmts toks Nil in
  let (rescues, r2) = parse_rescues r Nil in
  let (els, r3) = parse_opt_kw_block r2 "else" in
  let (ens, r4) = parse_opt_kw_block r3 "ensure" in
  (SBegin (body, rescues, els, ens), expect_kw r4 "end")

and parse_rescues = fn toks -> fn acc ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "rescue" then
      let (classes, var, prefix, r2) = parse_rescue_head r in
      let (handler, r3) = parse_stmts r2 Nil in
      // a complex capture target injects an assignment at the handler's top.
      let handler = (match prefix with Nil -> handler | Cons (s, _) -> Cons (s, handler)) in
      parse_rescues r3 (Cons ((classes, var, handler), acc))
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// `rescue [C1, C2] [=> target]` up to the newline. A bare local target keeps
// the string-var fast path; a complex lvalue (@ivar, obj.setter, obj&.setter,
// arr[i], C::X) binds the exception to a temp and returns an assignment to
// splice at the top of the handler body.
and parse_rescue_head = fn toks ->
  let (classes, r) = parse_rescue_classes toks Nil in
  let (var, prefix, r2) =
    (match r with
     | Cons (TP p, r3) ->
       if str_eq p "=>" then
         (let (tgt, r4) = parse_x_target1 r3 in
          (match tgt with
           | EVar nm -> (nm, Nil, r4)
           | _ -> let tmp = fresh_resc () in (tmp, Cons (SMultiAssignX (Cons (tgt, Nil), Cons (EVar tmp, Nil)), Nil), r4)))
       else ("", Nil, r)
     | _ -> ("", Nil, r)) in
  (classes, var, prefix, expect_end r2)

and parse_rescue_classes = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId c, r) ->
    // a bare constant matches by name (cheap path); a lowercase identifier is
    // a runtime expression (`rescue rescuer`).
    if is_cap c then
      let (full, r0) = scoped_name c r in
      (match r0 with
       | Cons (TP p, r2) ->
         if str_eq p "," then parse_rescue_classes r2 (Cons (full, acc))
         // a constant that continues (`.foo` / `::` handled by scoped_name) is
         // just the constant here; `=>` / newline end the class list.
         else (rev_app (Cons (full, acc)) Nil, r0)
       | _ -> (rev_app (Cons (full, acc)) Nil, r0))
    else parse_rescue_expr_item toks acc false
  // `rescue *x` / `rescue *(expr)` — splat a runtime array of exception classes.
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId v, r2) ->
         if is_cap v || (if str_len v > 0 then (if str_eq (char_at v 0) "@" then true else str_eq (char_at v 0) "$") else false)
         then parse_rescue_expr_item r acc true  // `*Const` / `*@x` as an expr
         else (match r2 with
          | Cons (TP p, r3) -> if str_eq p "," then parse_rescue_classes r3 (Cons ("*" ++ v, acc)) else (rev_app (Cons ("*" ++ v, acc)) Nil, r2)
          | _ -> (rev_app (Cons ("*" ++ v, acc)) Nil, r2))
       | _ -> parse_rescue_expr_item r acc true)
    // a parenthesized / lambda expression class (`rescue (expr)` / `rescue -> {..}`);
    // any other punctuation (`=>`, newline, `then`, `;`) ends the class list.
    else if is_lparen star || str_eq star "->" then parse_rescue_expr_item toks acc false
    else (rev_app acc Nil, toks)
  | _ -> (rev_app acc Nil, toks)

// parse one non-constant rescue class as a runtime expression, register it,
// and continue with the "@rexpr~N" sentinel (splat prefixes it with "*").
and parse_rescue_expr_item = fn toks -> fn (acc: str list) -> fn (splat: bool) ->
  let (e, r) = parse_bin toks 1 in
  let sentinel = (if splat then "*" else "") ++ resc_reg e in
  (match r with
   | Cons (TP p, r2) -> if str_eq p "," then parse_rescue_classes r2 (Cons (sentinel, acc)) else (rev_app (Cons (sentinel, acc)) Nil, r)
   | _ -> (rev_app (Cons (sentinel, acc)) Nil, r))

and parse_opt_kw_block = fn toks -> fn (kw: str) ->
  match toks with
  | Cons (TId id, r) -> if str_eq id kw then parse_stmts r Nil else (Nil, toks)
  | _ -> (Nil, toks)

and parse_attr = fn (mode: str) -> fn toks ->
  let (syms, r) = parse_sym_list toks Nil in (SAttr (mode, syms), r)

and parse_sym_list = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TSym s, r) ->
    (match r with
     | Cons (TP p, r2) ->
       if str_eq p "," then parse_sym_list r2 (Cons (s, acc))
       else (rev_app (Cons (s, acc)) Nil, r)
     | _ -> (rev_app (Cons (s, acc)) Nil, r))
  | _ -> fail "mere-ruby: expected :symbol"

// a range in an if/unless condition is the flip-flop operator; allocate its
// state site here (parse time), reaching through !/&&/|| combinations.
// scan (depth-aware) for a top-level assignment operator before the
// closing paren — defined?(x = 2) / defined?(@x ||= 1) forms.
// `defined?(<compound statement>)` — if/unless/case/while/until/for/begin —
// always answers "expression" in Ruby; parse it as a statement (correctly
// consuming to the matching `end`) rather than as an expression.
and defined_compound = fn toks ->
  match toks with
  | Cons (TId w, _) ->
    str_eq w "if" || str_eq w "unless" || str_eq w "case" || str_eq w "while" ||
    str_eq w "until" || str_eq w "for" || str_eq w "begin"
  | _ -> false

and defined_assignish = fn toks -> defined_assign_go toks 0

and defined_assign_go = fn toks -> fn (depth: int) ->
  match toks with
  | Nil -> false
  | Cons (TNL, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TP p, r) ->
    if is_lparen p || str_eq p "[" || str_eq p " [" || str_eq p "\{" || str_eq p "(s" then
      defined_assign_go r (depth + 1)
    else if str_eq p ")" || str_eq p "]" || str_eq p "}" then
      (if depth == 0 then false else defined_assign_go r (depth - 1))
    else if depth == 0 && (str_eq p "=" || (if str_eq (opassign_base p) "" then false else true)) then true
    else defined_assign_go r depth
  | Cons (_, r) -> defined_assign_go r depth

and cond_ff = fn (e: Expr) ->
  match e with
  | ERange (a, b, excl) ->
    let n = map_len ff_state in
    let _ = map_set ff_state (str_of_int n) (VBool false) in
    EFlipFlop (n, a, b, excl)
  | EBin (op, l, r) ->
    if str_eq op "&&" || str_eq op "||" then EBin (op, cond_ff l, cond_ff r) else e
  | EUn (op, x) -> if str_eq op "!" then EUn (op, cond_ff x) else e
  | _ -> e

and parse_if = fn toks -> fn (negate: bool) ->
  let (cond1, r) = parse_andor toks in
  let cond0 = cond_ff cond1 in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  let (clauses, els, r3) = parse_if_tail r2 in
  (SIf (Cons ((cond, body), clauses), els), r3)

and parse_if_tail = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "end" then (Nil, Nil, r)
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (Nil, b, expect_kw r2 "end")
    else if str_eq id "elsif" then
      let (c0, r2) = parse_expr r in
      let c = cond_ff c0 in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      let (clauses, els, r4) = parse_if_tail r3 in
      (Cons ((c, b), clauses), els, r4)
    else fail ("mere-ruby: expected elsif/else/end, got " ++ id)
  | _ -> fail "mere-ruby: unterminated if"

// `for x in e [do] body end` — each over e with x as the block param.
// The block shares the enclosing env, so (like Ruby's for) x leaks out.
and parse_for = fn toks ->
  // a complex loop target (`for obj.attr in`, `for arr[i] in`, `for C::X in`,
  // `for obj&.attr in`) is parsed as an assignment-target expression and driven
  // through the same setter machinery as multiple assignment.
  if for_targets_complex toks then
    let (targets, r2) = parse_for_xtargets toks Nil in
    let (e0, r3) = parse_expr r2 in
    let (e, body, r4) = parse_for_iter e0 r3 in
    (match targets with
     | Cons (t, Nil) ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("__forv", Nil), Cons (for_xassign t (EVar "__forv"), body))), r4)
     | _ ->
       (SExpr (EMethodB (e, "each", Nil, Cons ("*__forv", Nil), Cons (SMultiAssignX (targets, Cons (ESplat (EVar "__forv"), Nil)), body))), r4))
  else
  let (vars, r2) = parse_for_vars toks Nil in
  let (e0, r3) = parse_expr r2 in
  let (e, body, r4) = parse_for_iter e0 r3 in
  (match vars with
   | Cons (v, Nil) ->
     // the hidden __for param keeps v assigned in the SHARED scope, so
     // v survives the loop (block params themselves are block-local).
     (SExpr (EMethodB (e, "each", Nil, Cons ("__for", Nil), Cons (for_assign v (EVar "__for"), body))), r4)
   | _ ->
     // multiple targets: real (auto-splatting) block params __f0.., then a
     // prologue assigns them into the SHARED scope names.
     let (params, prologue) = for_multi_binding vars 0 in
     (SExpr (EMethodB (e, "each", Nil, params, list_append_stmt prologue body)), r4))

// `for i in x do ... end` — a bare-variable iterable grabs the do-block as its
// own; unwrap it back into the loop body. Shared by both for-target paths.
and parse_for_iter = fn (e0: Expr) -> fn r3 ->
  match e0 with
  | ECallB (nm, Nil, bps, bb) -> (match bps with Nil -> (EVar nm, bb, r3) | _ -> (e0, Nil, r3))
  | _ ->
    let r3b = (match r3 with Cons (TId d, rr) -> (if str_eq d "do" then rr else r3) | _ -> r3) in
    let (b, r4b) = parse_stmts r3b Nil in
    (e0, b, expect_kw r4b "end")

// does the for-target list (up to `in`) contain a complex chain?
and for_targets_complex = fn toks ->
  match toks with
  | Nil -> false
  | Cons (TNL, _) -> false
  | Cons (TEOF, _) -> false
  | Cons (TId w, r) -> if str_eq w "in" then false else for_targets_complex r
  | Cons (TP p, r) ->
    if str_eq p "." || str_eq p "[" || str_eq p "::" || str_eq p "&." then true
    else for_targets_complex r
  | Cons (_, r) -> for_targets_complex r

// parse comma-separated complex for-targets, terminated by `in`.
and parse_for_xtargets = fn toks -> fn (acc: Expr list) ->
  let (t, r) = parse_x_target1 toks in
  match r with
  | Cons (TP c, r2) -> if str_eq c "," then parse_for_xtargets r2 (Cons (t, acc)) else fail "mere-ruby: expected in after for"
  | Cons (TId kw, r2) -> if str_eq kw "in" then (rev_app (Cons (t, acc)) Nil, r2) else fail "mere-ruby: expected in after for"
  | _ -> fail "mere-ruby: expected in after for"

// build the statement that assigns one for-iteration value to a complex target.
and for_xassign = fn (t: Expr) -> fn (rhs: Expr) ->
  match t with
  | EMethod (recv, m, args) -> if str_eq m "[]" then SExpr (EMethod (recv, "[]=", eapp args (Cons (rhs, Nil)))) else SExpr (EMethod (recv, m ++ "=", Cons (rhs, Nil)))
  | ESafe (recv, m, args) -> SExpr (ESafe (recv, m ++ "=", eapp args (Cons (rhs, Nil))))
  | EScopedRead (recv, cn) -> SExpr (EScopedAssign (recv, cn, rhs))
  | EIVar n -> SAssign ("@" ++ n, rhs)
  | EVar n -> SAssign (n, rhs)
  | _ -> SExpr rhs

and list_append_stmt = fn (xs: Stmt list) -> fn (ys: Stmt list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append_stmt t ys)

// vars -> (block params, prologue stmts): v -> __fN + v = __fN;
// *x -> *__fN + x = __fN; bare * -> anonymous *.
// a for-loop target assignment: an @ivar / @@cvar name routes to SIVarAssign
// (SAssign only handles plain locals / $globals / constants).
and for_assign = fn (v: str) -> fn (rhs: Expr) ->
  if str_len v > 0 && str_eq (char_at v 0) "@" then SIVarAssign (substring v 1 (str_len v), rhs)
  else SAssign (v, rhs)

and for_multi_binding = fn (vars: str list) -> fn (n: int) ->
  match vars with
  | Nil -> (Nil, Nil)
  | Cons (v, rest) ->
    let (ps, ss) = for_multi_binding rest (n + 1) in
    if str_eq v "*" then (Cons ("*", ps), ss)
    else if str_len v > 0 && str_eq (char_at v 0) "*" then
      let nm = substring v 1 (str_len v) in
      (Cons ("*__f" ++ str_of_int n, ps), Cons (for_assign nm (EVar ("__f" ++ str_of_int n)), ss))
    else (Cons ("__f" ++ str_of_int n, ps), Cons (for_assign v (EVar ("__f" ++ str_of_int n)), ss))

// target list before `in`: a name, `name,`, `a, b`, `a, *`, `a, *rest`.
and parse_for_vars = fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TId v, r) ->
    if str_eq v "in" then (rev_app acc Nil, r)
    else
      (match r with
       | Cons (TP c, r2) ->
         if str_eq c "," then
           // `for i, in` — a trailing comma destructures (i = first elem).
           (match r2 with
            | Cons (TId nx, r3) ->
              if str_eq nx "in" then (rev_app (Cons ("*", Cons (v, acc))) Nil, r3)
              else parse_for_vars r2 (Cons (v, acc))
            | _ -> parse_for_vars r2 (Cons (v, acc)))
         else fail "mere-ruby: expected in after for"
       | Cons (TId kwin, r2) ->
         if str_eq kwin "in" then (rev_app (Cons (v, acc)) Nil, r2)
         else fail "mere-ruby: expected in after for"
       | _ -> fail "mere-ruby: expected in after for")
  | Cons (TP star, r) ->
    if str_eq star "*" then
      (match r with
       | Cons (TId n, r2) ->
         if str_eq n "in" then (rev_app (Cons ("*", acc)) Nil, r2)
         else parse_for_vars2 ("*" ++ n) r2 acc
       | _ -> fail "mere-ruby: expected in after for")
    else fail "mere-ruby: expected a variable after for"
  | _ -> fail "mere-ruby: expected a variable after for"

and parse_for_vars2 = fn (t: str) -> fn toks -> fn (acc: str list) ->
  match toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_for_vars r (Cons (t, acc))
    else fail "mere-ruby: expected in after for"
  | Cons (TId kwin, r) ->
    if str_eq kwin "in" then (rev_app (Cons (t, acc)) Nil, r)
    else fail "mere-ruby: expected in after for"
  | _ -> fail "mere-ruby: expected in after for"

and parse_while = fn toks -> fn (negate: bool) ->
  // the condition must not swallow the loop's `do` as a block argument
  // (`while x do y end` = while x; then y; not x { y }).
  let had = map_has parser_flags "nodo" in
  let _ = map_set parser_flags "nodo" VNil in
  let (cond0, r) = parse_andor toks in
  let _ = if had then () else map_delete parser_flags "nodo" in
  let cond = if negate then EUn ("!", cond0) else cond0 in
  let (body, r2) = parse_stmts (skip_then r) Nil in
  (SWhile (cond, body), expect_kw r2 "end")

and parse_case = fn toks ->
  // `case` immediately followed by a newline is subjectless: the when
  // conditions are truthiness tests rather than === against a subject.
  match toks with
  | Cons (TNL, _) -> parse_whens ECaseNone toks Nil
  | _ ->
    let (subj, r) = parse_expr toks in
    // `in` after the subject selects pattern matching; `when` the classic form.
    (match skip_nls r with
     | Cons (TId kw, _) -> if str_eq kw "in" then parse_case_in subj r Nil else parse_whens subj r Nil
     | _ -> parse_whens subj r Nil)

// pattern-matching case: parse `in <pattern> [if|unless <cond>] [then] body`
// clauses, an optional `else`, and the closing `end`.
and parse_case_in = fn (subj: Expr) -> fn toks -> fn acc ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "in" then
      let (pat, r2) = parse_pattern_top r in
      let (guard, r3) = parse_in_guard r2 in
      // after a pattern (+ optional guard) a delimiter must follow — then, a
      // newline, or end. Anything else (e.g. a leftover `+ 1` from `in 1 + 1`,
      // which a value pattern does not consume) is a SyntaxError in Ruby.
      let _ = (match r3 with
               | Cons (TId g, _) -> if str_eq g "then" || is_block_stop g then () else fail "mere-ruby: expected a delimiter after the patterns of an `in` clause"
               | Cons (TNL, _) -> ()
               | Cons (TEOF, _) -> ()
               | _ -> fail "mere-ruby: expected a delimiter after the patterns of an `in` clause") in
      let (b, r4) = parse_stmts (skip_then r3) Nil in
      parse_case_in subj r4 (Cons ((pat, guard, b), acc))
    else if str_eq id "else" then
      let (b, r2) = parse_stmts r Nil in
      (SCaseIn (subj, rev_app acc Nil, true, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCaseIn (subj, rev_app acc Nil, false, Nil), r)
    else fail ("mere-ruby: expected in/else/end in case, got " ++ id)
  | _ -> fail "mere-ruby: unterminated case/in"

// an optional guard after a pattern: `if COND` / `unless COND`.
and parse_in_guard = fn toks ->
  match toks with
  | Cons (TId id, r) ->
    if str_eq id "if" then let (c, r2) = parse_andor r in (c, r2)
    else if str_eq id "unless" then let (c, r2) = parse_andor r in (EUn ("!", c), r2)
    else (EBool true, toks)
  | _ -> (EBool true, toks)

// a top-level pattern (the direct operand of `in` or one-line `=>`/`in`).
// Bare forms without brackets/braces are allowed here: `in 0, 1, 2` is an
// array pattern and `in a:, b:` is a hash pattern.
// ---- parser-side pattern static checks ----------------------------------
// (These run at parse time so an offending pattern inside eval("...") surfaces
//  as a catchable SyntaxError, matching Ruby.)
and pp_us = fn (n: str) -> str_len n > 0 && str_eq (char_at n 0) "_"
and pp_names = fn (p: Pat) -> fn (acc: str list) ->
  match p with
  | PVar n -> Cons (n, acc)
  | PSplatP n -> if str_eq n "" then acc else Cons (n, acc)
  | PArrP es -> pp_names_list es acc
  | PHashP (items, rest) ->
    let a2 = if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then acc else Cons (rest, acc) in
    pp_hitems items a2
  | PAltP alts -> pp_names_list alts acc
  | PAsP (sub, n) -> Cons (n, pp_names sub acc)
  | PConstP (_, inner) -> pp_names inner acc
  | _ -> acc
and pp_names_list = fn (es: Pat list) -> fn (acc: str list) ->
  match es with Nil -> acc | Cons (p, r) -> pp_names_list r (pp_names p acc)
and pp_hitems = fn (items: (str * Pat) list) -> fn (acc: str list) ->
  match items with Nil -> acc | Cons (kp, r) -> let (k, sub) = kp in pp_hitems r (pp_names sub acc)
and pp_mem = fn (xs: str list) -> fn (n: str) ->
  match xs with Nil -> false | Cons (h, t) -> str_eq h n || pp_mem t n
// a non-underscore variable bound more than once (`in [a, a]` — SyntaxError;
// `_`/`_x` may repeat).
and pp_has_dup = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else pp_mem rest n) || pp_has_dup rest
// any non-underscore binding at all (used to forbid bindings in alternatives).
and pp_has_real = fn (names: str list) ->
  match names with Nil -> false | Cons (n, rest) -> (if pp_us n then false else true) || pp_has_real rest
and check_dup_vars = fn (p: Pat) ->
  if pp_has_dup (pp_names p Nil) then fail "mere-ruby: duplicated variable name in pattern" else ()

// `^name` may only pin a variable already bound to its LEFT in the pattern (or
// a pre-existing local). Pinning a name that the SAME pattern binds later
// (`in [^n, n]`) is a SyntaxError ("no such local variable"); `[n, ^n]` is ok.
and check_pin_order = fn (p: Pat) ->
  let all = pp_names p Nil in
  let (bad, _) = pp_pin_walk p all Nil in
  if bad then fail "mere-ruby: no such local variable in pattern (pinned before bound)" else ()
and pp_pin_walk = fn (p: Pat) -> fn (all: str list) -> fn (seen: str list) ->
  match p with
  | PVar n -> (false, Cons (n, seen))
  | PPin e -> (match e with EVar n -> ((pp_mem all n) && (if pp_mem seen n then false else true), seen) | _ -> (false, seen))
  | PSplatP n -> (false, if str_eq n "" then seen else Cons (n, seen))
  | PArrP es -> pp_pin_walk_list es all seen
  | PHashP (items, _) -> pp_pin_walk_hitems items all seen
  | PAltP alts -> pp_pin_walk_list alts all seen
  | PAsP (sub, n) -> let (b, s) = pp_pin_walk sub all seen in (b, Cons (n, s))
  | PConstP (_, inner) -> pp_pin_walk inner all seen
  | _ -> (false, seen)
and pp_pin_walk_list = fn (es: Pat list) -> fn (all: str list) -> fn (seen: str list) ->
  match es with
  | Nil -> (false, seen)
  | Cons (p, r) -> let (b, s) = pp_pin_walk p all seen in if b then (true, s) else pp_pin_walk_list r all s
and pp_pin_walk_hitems = fn (items: (str * Pat) list) -> fn (all: str list) -> fn (seen: str list) ->
  match items with
  | Nil -> (false, seen)
  | Cons (kp, r) -> let (k, sub) = kp in let (b, s) = pp_pin_walk sub all seen in if b then (true, s) else pp_pin_walk_hitems r all s

and parse_pattern_top = fn toks ->
  let (p, r) = parse_pattern_top0 toks in
  let _ = check_dup_vars p in
  let _ = check_pin_order p in
  (p, r)

and parse_pattern_top0 = fn toks ->
  // bare hash pattern: starts with a `label:` or `**`.
  if starts_hash_pattern toks then
    let (items, rest, r) = parse_hash_pat_items toks Nil "" in
    (PHashP (items, rest), r)
  else
    let (p, r) = parse_pattern toks in
    // bare array pattern: a top-level comma joins elements without brackets.
    (match r with
     | Cons (TP c, r2) ->
       if str_eq c "," then
         let (rest, r3) = parse_bare_arr r2 Nil in
         (PArrP (Cons (p, rest)), r3)
       else (p, r)
     | _ -> (p, r))

// elements of a bracket-less array pattern (`in 0, 1, *rest`), terminated by
// end-of-clause rather than `]`. Called right after a separating comma.
and parse_bare_arr = fn toks -> fn (acc: Pat list) ->
  // called right after a separating comma; a terminator here means a trailing
  // comma (`0, 1,`) which makes the pattern match partially — append a splat.
  match toks with
  | Cons (TNL, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TEOF, _) -> (rev_app (Cons (PSplatP "", acc)) Nil, toks)
  | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | Cons (TP p, _) -> if str_eq p ")" || str_eq p ";" then (rev_app (Cons (PSplatP "", acc)) Nil, toks) else parse_bare_arr_one toks acc
  | _ -> parse_bare_arr_one toks acc

and parse_bare_arr_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match r with
   | Cons (TP c, r2) -> if str_eq c "," then parse_bare_arr r2 acc2 else (rev_app acc2 Nil, r)
   | _ -> (rev_app acc2 Nil, r))

// does the token stream begin a bare (brace-less) hash pattern?
and starts_hash_pattern = fn toks ->
  match toks with
  | Cons (TId _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TStrL _, Cons (TP colon, _)) -> str_eq colon ":"
  | Cons (TP op, Cons (TStrL _, Cons (TP plus, Cons (TStrL _, Cons (TP cp, Cons (TP colon, _)))))) -> str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":"
  | Cons (TP dsp, _) -> str_eq dsp "**"
  | _ -> false

// a full pattern including alternation `p1 | p2 | ...` and the trailing
// as-binding `pat => name`.
and parse_pattern = fn toks ->
  let (p, r) = parse_pattern_alt toks in
  // `pat => name` binds the whole matched value to a local.
  (match r with
   | Cons (TP arrow, r2) ->
     if str_eq arrow "=>" then
       (match r2 with
        | Cons (TId nm, r3) -> (PAsP (p, nm), r3)
        | _ -> fail "mere-ruby: expected name after => in pattern")
     else (p, r)
   | _ -> (p, r))

and parse_pattern_alt = fn toks ->
  let (p, r) = parse_pattern_prim toks in
  (match r with
   | Cons (TP bar, r2) ->
     if str_eq bar "|" then
       let (alts, r3) = parse_alt_rest r2 (Cons (p, Nil)) in
       // Ruby forbids binding a (non-underscore) variable in an alternative.
       let _ = if pp_has_real (pp_names (PAltP alts) Nil) then fail "mere-ruby: illegal variable in alternative pattern" else () in
       (PAltP alts, r3)
     else (p, r)
   | _ -> (p, r))

and parse_alt_rest = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern_prim toks in
  let acc2 = rev_app (Cons (p, rev_app acc Nil)) Nil in
  (match r with
   | Cons (TP bar, r2) -> if str_eq bar "|" then parse_alt_rest r2 acc2 else (acc2, r)
   | _ -> (acc2, r))

// a primary pattern (no alternation / as-binding at this level).
and parse_pattern_prim = fn toks ->
  match toks with
  // array pattern [ ... ]
  | Cons (TP lb, r) ->
    if str_eq lb "[" || str_eq lb " [" then
      let (elems, r2) = parse_arr_pat_elems r Nil in
      (PArrP elems, r2)
    // hash pattern { ... }
    else if str_eq lb "\{" then
      let (items, rest, r2) = parse_hash_pat_brace r in
      (PHashP (items, rest), r2)
    // ^pin
    else if str_eq lb "^" then parse_pin r
    // *splat (only valid inside an array; encode as a splat element)
    else if str_eq lb "*" then
      (match r with
       | Cons (TId nm, r2) -> (PSplatP nm, r2)
       | _ -> (PSplatP "", r))
    // **rest at top level of a bare hash pattern handled elsewhere; a bare
    // parenthesised pattern `(pat)` just groups.
    else if is_lparen lb then
      let (p, r2) = parse_pattern (skip_nls r) in (p, expect (skip_nls r2) ")")
    else
      // any other leading token: a value pattern (literal / range / etc.).
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
  // a bare identifier: a variable binding when lowercase, else a value/const.
  | Cons (TId nm, r) ->
    if is_upper_first nm then parse_const_pattern toks
    else if str_eq nm "nil" || str_eq nm "true" || str_eq nm "false" then
      let (e, r2) = parse_pat_value toks in (PVal e, r2)
    else
      // a lowercase name binds, unless a following `..`/`...` makes it a
      // range value pattern.
      (match r with
       | Cons (TP dots, _) -> if str_eq dots ".." || str_eq dots "..." then let (e, r2) = parse_pat_value toks in (PVal e, r2) else (PVar nm, r)
       | _ -> (PVar nm, r))
  | _ -> let (e, r) = parse_pat_value toks in (PVal e, r)

// a value pattern's expression: like parse_range but with the binary layer
// capped so alternation `|` (prec 5) is NOT consumed here — it belongs to the
// pattern grammar. Handles literals, unary minus, ranges, symbols, regexps.
and parse_pat_value = fn toks ->
  // a value pattern is a single primary (literal / const / symbol / regex /
  // unary-minus number) with an optional range — NOT an arithmetic expression.
  // Using parse_unary (not parse_bin) means `in 1 + 1` leaves `+ 1` behind, so
  // the clause's delimiter check reports a SyntaxError, as Ruby does.
  let (lo, r) = parse_unary toks in
  match r with
  | Cons (TP op, rest) ->
    if str_eq op ".." || str_eq op "..." then
      let excl = str_eq op "..." in
      (match rest with
       | Cons (TP p2, _) ->
         if str_eq p2 ")" || str_eq p2 "]" || str_eq p2 "," || str_eq p2 ";" || str_eq p2 "}" || str_eq p2 "|" then (ERange (lo, EInt 4611686018427387903, excl), rest)
         else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | Cons (TNL, _) -> (ERange (lo, EInt 4611686018427387903, excl), rest)
       | Cons (TEOF, _) -> (ERange (lo, EInt 4611686018427387903, excl), rest)
       | Cons (TId g, _) -> if str_eq g "then" || str_eq g "if" || str_eq g "unless" then (ERange (lo, EInt 4611686018427387903, excl), rest) else let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2)
       | _ -> let (hi, r2) = parse_unary rest in (ERange (lo, hi, excl), r2))
    else (lo, r)
  | _ -> (lo, r)

// read a bare constant reference (`Foo`, `Foo::Bar`) WITHOUT consuming a
// trailing `[` / `(` — those introduce the deconstruct sub-pattern.
and parse_pat_const = fn toks ->
  match toks with
  | Cons (TP colons, Cons (TId nm, r)) -> if str_eq colons "::" then parse_pat_const_more (EConst nm) r else fail "mere-ruby: bad constant pattern"
  | Cons (TId nm, r) -> parse_pat_const_more (EConst nm) r
  | _ -> fail "mere-ruby: expected a constant in pattern"

and parse_pat_const_more = fn (e: Expr) -> fn toks ->
  match toks with
  | Cons (TP cc, Cons (TId nm2, r2)) -> if str_eq cc "::" then parse_pat_const_more (EScopedRead (e, nm2)) r2 else (e, toks)
  | _ -> (e, toks)

// `^name` / `^@x` / `^@@x` / `^$x` / `^(expr)`.
and parse_pin = fn toks ->
  match toks with
  | Cons (TP lp, r) ->
    if is_lparen lp then let (e, r2) = parse_expr r in (PPin e, expect r2 ")")
    else if str_eq lp "@" then (match r with Cons (TId nm, r2) -> (PPin (EIVar nm), r2) | _ -> fail "mere-ruby: bad ^@ pattern")
    else if str_eq lp "$" then (match r with Cons (TId nm, r2) -> (PPin (EVar ("$" ++ nm)), r2) | _ -> fail "mere-ruby: bad ^$ pattern")
    else fail "mere-ruby: bad ^ pattern"
  | Cons (TId nm, r) ->
    // `^@x` / `^@@x` lex as an @-prefixed identifier; `^$g` as a $-name.
    if str_len nm >= 1 && str_eq (char_at nm 0) "@" then (PPin (EIVar (substring nm 1 (str_len nm))), r)
    else if str_len nm >= 1 && str_eq (char_at nm 0) "$" then (PPin (EVar nm), r)
    else (PPin (EVar nm), r)
  | _ -> let (e, r) = parse_primary toks in (PPin e, r)

// `Const`, `Const[...]`, `Const(...)`, `Const(id: p, ...)`; a bare Const is a
// value pattern (=== the class).
and parse_const_pattern = fn toks ->
  let (ce, r) = parse_pat_const toks in
  (match r with
   | Cons (TP lb, r2) ->
     if str_eq lb " [" || str_eq lb "[" then
       // the item/element parsers already consume the closing ] themselves.
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else if str_eq lb " (" || is_lparen lb then
       (if starts_hash_pattern r2 then
          let (items, rest, r3) = parse_hash_pat_items r2 Nil "" in
          (PConstP (ce, PHashP (items, rest)), r3)
        else
          let (elems, r3) = parse_arr_pat_elems_paren r2 Nil in
          (PConstP (ce, PArrP elems), r3))
     else (PVal ce, r)
   | _ -> (PVal ce, r))

// elements of an array pattern up to the closing `]`.
and parse_arr_pat_elems = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) ->
    if str_eq rb "]" then (rev_app acc Nil, r)
    else parse_arr_pat_one t acc
  | _ -> parse_arr_pat_one t acc

and parse_arr_pat_one = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       // a trailing comma before `]` makes the pattern match partially from the
       // start (`[0, 1, ]` == `[0, 1, *]`): append an anonymous splat.
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb "]" then (rev_app (Cons (PSplatP "", acc2)) Nil, r3) else parse_arr_pat_elems (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems (skip_nls r2) acc2)
     else if str_eq c "]" then (rev_app acc2 Nil, r2)
     else fail ("mere-ruby: expected , or ] in array pattern, got " ++ c)
   | _ -> fail "mere-ruby: unterminated array pattern")

// like parse_arr_pat_elems but closes on `)` (Const(pat, ...) form).
and parse_arr_pat_elems_paren = fn toks -> fn (acc: Pat list) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP rb, r) -> if str_eq rb ")" then (rev_app acc Nil, r) else parse_arr_pat_one_p t acc
  | _ -> parse_arr_pat_one_p t acc

and parse_arr_pat_one_p = fn toks -> fn (acc: Pat list) ->
  let (p, r) = parse_pattern toks in
  let acc2 = Cons (p, acc) in
  (match skip_nls r with
   | Cons (TP c, r2) ->
     if str_eq c "," then
       (match skip_nls r2 with
        | Cons (TP rb, r3) -> if str_eq rb ")" then (rev_app acc2 Nil, r3) else parse_arr_pat_elems_paren (skip_nls r2) acc2
        | _ -> parse_arr_pat_elems_paren (skip_nls r2) acc2)
     else if str_eq c ")" then (rev_app acc2 Nil, r2)
     else fail ("mere-ruby: expected , or ) in pattern, got " ++ c)
   | _ -> fail "mere-ruby: unterminated pattern")

// a brace hash pattern `{ ... }` — consume up to `}`.
and parse_hash_pat_brace = fn toks ->
  match skip_nls toks with
  | Cons (TP rb, r) -> if str_eq rb "}" then (Nil, "", r) else parse_hash_pat_items toks Nil ""
  | _ -> parse_hash_pat_items toks Nil ""

// hash-pattern items: (label, sub-pattern) pairs plus a rest tag. Stops at
// `}` / `]` / `)` / end-of-clause. `rest` accumulates the **-form.
and parse_hash_pat_items = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  let t = skip_nls toks in
  match t with
  | Cons (TP dsp, r0) ->
    if str_eq dsp "**" then
      // **nil / **name / ** (anonymous)
      (match r0 with
       | Cons (TId nm, r1) -> if str_eq nm "nil" then hash_pat_sep r1 acc "nil" else hash_pat_sep r1 acc nm
       | _ -> hash_pat_sep r0 acc "*")
    else if str_eq dsp "}" || str_eq dsp "]" || str_eq dsp ")" then (rev_app acc Nil, rest, r0)
    else parse_hash_pat_kv t acc rest
  | _ -> parse_hash_pat_kv t acc rest

and parse_hash_pat_kv = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  // key: `label:` (identifier) or `"string":` (symbol key).
  let (key, r2) =
    (match toks with
     | Cons (TId nm, Cons (TP colon, r0)) -> if str_eq colon ":" then (nm, r0) else fail "mere-ruby: expected label in hash pattern"
     | Cons (TStrL s, Cons (TP colon, r0)) -> if str_eq colon ":" then (s, r0) else fail "mere-ruby: expected label in hash pattern"
     // a "string": key (double-quoted, no interpolation) lexes as `(s "" + s )`.
     | Cons (TP op, Cons (TStrL empty, Cons (TP plus, Cons (TStrL s, Cons (TP cp, Cons (TP colon, r0)))))) ->
       if str_eq op "(s" && str_eq plus "+" && str_eq cp ")" && str_eq colon ":" then (s, r0) else fail "mere-ruby: expected a label as the key in the hash pattern"
     | _ -> fail "mere-ruby: expected a label as the key in the hash pattern") in
  // an omitted value (`a:`) binds the key name; otherwise parse a sub-pattern.
  // Do NOT skip newlines here: a newline / `;` ends a brace-less hash pattern.
  let (sub, r3) =
    (match r2 with
     | Cons (TP p, _) -> if str_eq p "," || str_eq p "}" || str_eq p "]" || str_eq p ")" then (PVar key, r2) else parse_pattern r2
     | Cons (TId gg, _) -> if str_eq gg "then" || str_eq gg "if" || str_eq gg "unless" then (PVar key, r2) else parse_pattern r2
     | Cons (TNL, _) -> (PVar key, r2)
     | Cons (TEOF, _) -> (PVar key, r2)
     | _ -> parse_pattern r2) in
  // Ruby rejects a duplicated key name in a hash pattern.
  let _ = if pp_hitem_haskey acc key then fail "mere-ruby: duplicated key name in hash pattern" else () in
  hash_pat_sep r3 (Cons ((key, sub), acc)) rest

and pp_hitem_haskey = fn (items: (str * Pat) list) -> fn (key: str) ->
  match items with Nil -> false | Cons (kp, r) -> let (k, _) = kp in str_eq k key || pp_hitem_haskey r key

and hash_pat_sep = fn toks -> fn (acc: (str * Pat) list) -> fn (rest: str) ->
  match skip_nls toks with
  | Cons (TP c, r) ->
    if str_eq c "," then parse_hash_pat_items r acc rest
    else if str_eq c "}" || str_eq c "]" || str_eq c ")" then (rev_app acc Nil, rest, r)
    else (rev_app acc Nil, rest, toks)
  | _ -> (rev_app acc Nil, rest, toks)

and parse_whens = fn (subj: Expr) -> fn toks -> fn acc ->
  let t = skip_nls toks in
  match t with
  | Cons (TId id, r) ->
    if str_eq id "when" then
      let (vs, r2) = parse_when_vals r Nil in
      let (b, r3) = parse_stmts (skip_then r2) Nil in
      parse_whens subj r3 (Cons ((vs, b), acc))
    else if str_eq id "else" then
      let _ = (match acc with
               | Nil -> fail "mere-ruby: case with else but no when"
               | _ -> ()) in
      let (b, r2) = parse_stmts r Nil in
      (SCase (subj, rev_app acc Nil, b), expect_kw r2 "end")
    else if str_eq id "end" then
      (SCase (subj, rev_app acc Nil, Nil), r)
    else fail ("mere-ruby: expected when/else/end in case, got " ++ id)
  | _ -> fail "mere-ruby: unterminated case"

and parse_when_vals = fn toks -> fn (acc: Expr list) ->
  // `when *ary` splices the array's elements as candidates.
  let (e, r) =
    (match toks with
     | Cons (TP star, r0) -> if str_eq star "*" then let (inner, r1) = parse_expr r0 in (ESplat inner, r1) else parse_expr toks
     | _ -> parse_expr toks) in
  match r with
  | Cons (TP p, r2) ->
    if str_eq p "," then parse_when_vals r2 (Cons (e, acc))
    else (rev_app (Cons (e, acc)) Nil, r)
  | _ -> (rev_app (Cons (e, acc)) Nil, r)

// `def name(p1, p2) ... end` or `def name ... end`. Parameters are
// optional parens; the body runs until `end`.
and parse_def = fn toks ->
  match toks with
  // operator method names: def ==, def <=>, def []=, def +, def <<, ...
  | Cons (TP op0, r0) ->
    // the lexer space-marks a bracket after "def " — same as a plain [.
    // the lexer space-marks a bracket / ampersand after "def " (` [`, ` &`);
    // normalise to the bare operator name.
    let op1 = if str_eq op0 " [" then "[" else if str_eq op0 " &" then "&" else op0 in
    let (name, r) =
      if str_eq op1 "[" then
        (match r0 with
         | Cons (TP rb2, r1) ->
           if str_eq rb2 "]" then
             (match r1 with
              | Cons (TP eq2, r2) -> if str_eq eq2 "=" then ("[]=", r2) else ("[]", r1)
              | _ -> ("[]", r1))
           else fail "mere-ruby: expected method name after def"
         | _ -> fail "mere-ruby: expected method name after def")
      // `def !@` / `def !` — unary bang; normalize both to "!@".
      else if str_eq op1 "!" then
        (match r0 with
         | Cons (TId at, r1) -> if str_eq at "@" then ("!@", r1) else ("!@", r0)
         | _ -> ("!@", r0))
      // `def -@` / `def +@` — unary operator methods (op followed by @).
      else if (str_eq op1 "-" || str_eq op1 "+") &&
              (match r0 with Cons (TId at, _) -> str_len at >= 1 && str_eq (char_at at 0) "@" | _ -> false) then
        (match r0 with
         | Cons (TId at, r1) ->
           if str_eq at "@" then (op1 ++ "@", r1)
           // `-@x` lexes as the ivar @x after the op — split it back.
           else (op1 ++ "@", Cons (TId (substring at 1 (str_len at)), r1))
         | _ -> (op1 ++ "@", r0))
      else if is_op_method_name op1 then (op1, r0)
      else fail "mere-ruby: expected method name after def" in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) -> if is_lparen p then parse_params r3 Nil Nil else (Nil, Nil, r)
       | _ -> (Nil, Nil, r)) in
    parse_def_body name params defs r2
  | Cons (TId name0, r0) ->
    // `def recv.name` — a singleton method. `def self.m` drops self. and
    // registers on the enclosing class/module; `def C.m` registers under
    // "C#m" so `C.m` (VClass dispatch) finds it.
    let (name, r) =
      (match r0 with
       | Cons (TP dot, r1) ->
         if str_eq dot "." then
           (match r1 with
            | Cons (TId n2, r2) -> if str_eq name0 "self" then ("self." ++ n2, r2) else (name0 ++ "#" ++ n2, r2)
            // def self.<< / def obj.== / def obj.[] — an operator singleton
            // method. Carry the receiver prefix like the TId case, so it
            // registers on the receiver's singleton rather than as a bare
            // top-level operator method (self. prefix for self, name# else).
            | Cons (TP op2, r2) ->
              let pfx = if str_eq name0 "self" then "self." else name0 ++ "#" in
              if str_eq op2 "[" then
                (match r2 with
                 | Cons (TP rb2, r3) ->
                   if str_eq rb2 "]" then
                     (match r3 with
                      | Cons (TP eq2, r4) -> if str_eq eq2 "=" then (pfx ++ "[]=", r4) else (pfx ++ "[]", r3)
                      | _ -> (pfx ++ "[]", r3))
                   else (name0, r0)
                 | _ -> (name0, r0))
              else if is_op_method_name op2 then (pfx ++ op2, r2)
              else (name0, r0)
            | _ -> (name0, r0))
         else (name0, r0)
       | _ -> (name0, r0)) in
    // setter definition `def x=(v)` — the `=` is part of the name. Guard
    // against endless defs `def x = (expr)` by requiring a real parameter
    // `( ident )` / `( ident ,` inside (a string desugars to `("" + ...)`).
    let (name, r) =
      (match r with
       | Cons (TP eq, r1) ->
         if str_eq eq "=" then
           (match r1 with
            | Cons (TP lp, Cons (TId _, Cons (TP rp, _))) ->
              if str_eq lp "(" && (str_eq rp ")" || str_eq rp ",") then (name ++ "=", r1) else (name, r)
            // `def foobar=(*)` — a setter taking an anonymous splat.
            | Cons (TP lp, Cons (TP st, _)) ->
              if str_eq lp "(" && (str_eq st "*" || str_eq st "**") then (name ++ "=", r1) else (name, r)
            | _ -> (name, r))
         else (name, r)
       | _ -> (name, r)) in
    let (params, defs, r2) =
      (match r with
       | Cons (TP p, r3) ->
         if is_lparen p then parse_params r3 Nil Nil
         else if str_eq p "*" || str_eq p "&" || str_eq p " &" then parse_bare_params r Nil Nil
         else (Nil, Nil, r)
       | Cons (TId _, _) -> parse_bare_params r Nil Nil
       | _ -> (Nil, Nil, r)) in
    // endless method `def name(params) = expr` — body is a single expression.
    (match r2 with
     | Cons (TP eq, r3) ->
       if str_eq eq "=" then
         let (e, r4) = parse_expr r3 in (SDef (name, params, defs, Cons (SExpr e, Nil)), r4)
       else parse_def_body name params defs r2
     | _ -> parse_def_body name params defs r2)
  | _ -> fail "mere-ruby: expected method name after def"

and is_op_method_name = fn (op: str) ->
  str_eq op "==" || str_eq op "!=" || str_eq op "<=>" || str_eq op "===" ||
  str_eq op "<" || str_eq op ">" || str_eq op "<=" || str_eq op ">=" ||
  str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/" ||
  str_eq op "%" || str_eq op "**" || str_eq op "<<" || str_eq op "!" ||
  str_eq op "=~" || str_eq op "!~" || str_eq op "|" || str_eq op "&" || str_eq op "^"

and parse_def_body = fn (name: str) -> fn (params: str list) -> fn (defs: (str * Expr) list) -> fn r2 ->
    let (body0, r4) = parse_stmts r2 Nil in
    // method-level rescue/ensure: `def f ... rescue ... end` wraps the
    // whole body in an implicit begin.
    let (body, r5) =
      (match r4 with
       | Cons (TId k, _) ->
         if str_eq k "rescue" || str_eq k "ensure" then
           let (rescues, ra) = parse_rescues r4 Nil in
           let (els, rb) = parse_opt_kw_block ra "else" in
           let (ens, rc) = parse_opt_kw_block rb "ensure" in
           (Cons (SBegin (body0, rescues, els, ens), Nil), rc)
         else (body0, r4)
       | _ -> (body0, r4)) in
    (SDef (name, params, defs, body), expect_kw r5 "end")

// the base name of a param string, stripping *, **, & prefixes, a : suffix,
// and any `~N` uniquification suffix (so a renamed `_~1` still counts as `_`).
and pbase = fn (p: str) ->
  let p = if str_len p >= 2 && str_eq (substring p 0 2) "**" then substring p 2 (str_len p)
          else if str_len p >= 1 && (str_eq (char_at p 0) "*" || str_eq (char_at p 0) "&") then substring p 1 (str_len p)
          else if str_len p >= 1 && str_eq (char_at p (str_len p - 1)) ":" then substring p 0 (str_len p - 1)
          else p in
  str_before_char p "~" 0
and str_before_char = fn (s: str) -> fn (ch: str) -> fn (i: int) ->
  if i >= str_len s then s
  else if str_eq (char_at s i) ch then substring s 0 i
  else str_before_char s ch (i + 1)
and pcount_base = fn (acc: str list) -> fn (base: str) ->
  match acc with Nil -> 0 | Cons (h, t) -> (if str_eq (pbase h) base then 1 else 0) + pcount_base t base
// Ruby allows the ignore-name `_` to repeat in a parameter list; give each
// repeat a unique internal storage key (first keeps the bare `_`) so they bind
// to distinct slots and a bare `super` forwards them positionally. Other
// duplicate names are a SyntaxError in Ruby, so they are left untouched.
and uniq_param = fn (name: str) -> fn (acc: str list) ->
  if (if str_eq (pbase name) "_" then true else false) && pcount_base acc "_" > 0 then
    (let u = "_~" ++ str_of_int (pcount_base acc "_") in
     if str_len name >= 2 && str_eq (substring name 0 2) "**" then "**" ++ u
     else if str_len name >= 1 && (str_eq (char_at name 0) "*" || str_eq (char_at name 0) "&") then substring name 0 1 ++ u
     else if str_len name >= 1 && str_eq (char_at name (str_len name - 1)) ":" then u ++ ":"
     else u)
  else name

and parse_params = fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p ")" then (rev_app acc Nil, rev_app defs Nil, r)
    else if str_eq p "*" then
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("*" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "*" r acc defs)
    else if str_eq p "&" then
      // &block capture: stored as "&name"; a bare & (anonymous forwarding)
      // gets a hidden name so `c(&)` can re-pass it.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("&" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "&__anonblk" r acc defs)
    else if str_eq p "**" then
      // **kwargs collects the trailing keyword hash.
      (match r with
       | Cons (TId name, r2) -> parse_params_after (uniq_param ("**" ++ name) acc) r2 acc defs
       | _ -> parse_params_after "**" r acc defs)
    else if str_eq p "..." then
      // argument forwarding: `def m(...)` collects positional args in *__fwd.
      // (Block forwarding via &__fwdblk regressed no-block forwarding — the
      // block goes unforwarded; only positional/keyword `...` is supported.)
      parse_params_after "*__fwd" r acc defs
    else if is_lparen p then
      // nested destructuring `def m((a, b))` — encoded as a spec string,
      // bound the same way as a block's |(a, b)|.
      let (spec, r2) = pipe_group r "" in
      parse_params_after ("(" ++ spec ++ ")") r2 acc defs
    else fail ("mere-ruby: expected parameter name, got " ++ p)
  | Cons (TId name, r) ->
    // optional default `name = expr`; keyword param `name:` / `name: default`
    // (stored as "name:" in the param list, bound from the trailing hash).
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         // optional `name = expr`: uniquify a duplicate `_` and key the default
         // under the SAME unique name so it stays associated with this position.
         let un = uniq_param name acc in
         let (e, r3) = parse_expr r2 in parse_params_after un r3 acc (Cons ((un, e), defs))
       else if str_eq eq ":" then
         let un = uniq_param (name ++ ":") acc in
         (match r2 with
          | Cons (TP q, _) -> if str_eq q "," || str_eq q ")" then parse_params_after un r2 acc defs
                              else let (e, r3) = parse_expr r2 in parse_params_after un r3 acc (Cons ((un, e), defs))
          | _ -> let (e, r3) = parse_expr r2 in parse_params_after un r3 acc (Cons ((un, e), defs)))
       else parse_params_after (uniq_param name acc) r acc defs
     | _ -> parse_params_after (uniq_param name acc) r acc defs)
  | _ -> fail "mere-ruby: expected parameter name"

and parse_params_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_params r (Cons (name, acc)) defs
    else if str_eq p ")" then (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, r)
    else fail ("mere-ruby: expected , or ) in parameters, got " ++ p)
  | _ -> fail "mere-ruby: unterminated parameter list"

// paren-less method params: `def m a, o=1, *r, &b` — terminated by newline
// (any non-comma token) rather than `)`.
and parse_bare_params = fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "*" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("*" ++ n) r2 acc defs
                  | _ -> parse_bare_after "*" r acc defs)
    else if str_eq p "&" || str_eq p " &" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("&" ++ n) r2 acc defs
                  | _ -> parse_bare_after "&" r acc defs)
    else if str_eq p "**" then
      (match r with Cons (TId n, r2) -> parse_bare_after ("**" ++ n) r2 acc defs
                  | _ -> parse_bare_after "**" r acc defs)
    else if str_eq p "..." then parse_bare_after "*__fwd" r acc defs
    else fail ("mere-ruby: expected parameter name, got " ++ p)
  | Cons (TId name, r) ->
    (match r with
     | Cons (TP eq, r2) ->
       if str_eq eq "=" then
         let (e, r3) = parse_expr r2 in parse_bare_after name r3 acc (Cons ((name, e), defs))
       else parse_bare_after name r acc defs
     | _ -> parse_bare_after name r acc defs)
  | _ -> fail "mere-ruby: expected parameter name"

and parse_bare_after = fn (name: str) -> fn toks -> fn (acc: str list) -> fn (defs: (str * Expr) list) ->
  match toks with
  | Cons (TP p, r) ->
    if str_eq p "," then parse_bare_params r (Cons (name, acc)) defs
    else (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks)
  | _ -> (rev_app (Cons (name, acc)) Nil, rev_app defs Nil, toks);

// ---- evaluator -----------------------------------------------------------
// Ruby truthiness: only nil and false are falsy. 0 and "" are truthy.
let truthy = fn (v: Val) ->
  match v with
  | VNil -> false
  | VBool b -> b
  | _ -> true;

let to_f = fn (v: Val) ->
  match v with
  | VInt n -> float_of_int n
  | VFlt f -> f
  | VBig s -> float_of_str s
  | VRat (n, d) -> float_of_str n / float_of_str d
  | _ -> fail "mere-ruby: not a number";

let is_num = fn (v: Val) ->
  match v with VInt _ -> true | VFlt _ -> true | _ -> false;

let feq = fn (x: float) -> fn (y: float) -> x <= y && y <= x;

// Ruby integer division floors toward negative infinity (-7 / 2 == -4)
// and modulo takes the sign of the divisor (-7 % 3 == 2). Mere's native
// / and % truncate toward zero (C semantics), so correct after the fact.
let floor_div = fn (a: int) -> fn (b: int) ->
  if b == 0 then fail "mere-ruby: divided by 0"
  else
    let q = a / b in
    let r = a - q * b in
    if r != 0 && (if r < 0 then b > 0 else b < 0) then q - 1 else q;

let floor_mod = fn (a: int) -> fn (b: int) -> a - (floor_div a b) * b;

// integer shifts by repeated doubling / halving (floor semantics). A
// negative shift count reverses direction (x << -n == x >> n).
let rec shl_int = fn (x: int) -> fn (n: int) ->
  if n == 0 then x
  else if n < 0 then shr_int_pos x (0 - n)
  else shl_int (x * 2) (n - 1)
and shr_int = fn (x: int) -> fn (n: int) ->
  if n == 0 then x
  else if n < 0 then shl_int_pos x (0 - n)
  else shr_int_pos x n
and shl_int_pos = fn (x: int) -> fn (n: int) ->
  if n <= 0 then x else shl_int_pos (x * 2) (n - 1)
and shr_int_pos = fn (x: int) -> fn (n: int) ->
  if n <= 0 then x else shr_int_pos (floor_div x 2) (n - 1);

let rec pow_int = fn (b: int) -> fn (e: int) ->
  if e < 0 then fail "mere-ruby: negative integer exponent unsupported in M0"
  else if e == 0 then 1
  else b * pow_int b (e - 1);

let rec pow_flt = fn (b: float) -> fn (e: int) ->
  if e < 0 then 1.0 / pow_flt b (0 - e)
  else if e == 0 then 1.0
  else b * pow_flt b (e - 1);

let rec rb_eq = fn (va: Val) -> fn (vb: Val) ->
  match va with
  | VInt x ->
    (match vb with
     | VInt y -> x == y
     | VFlt y -> feq (float_of_int x) y
     | VRat (n, d) -> str_eq d "1" && str_eq n (str_of_int x)
     | _ -> false)
  | VFlt x ->
    (match vb with
     | VInt y -> feq x (float_of_int y)
     | VFlt y -> feq x y
     | _ -> false)
  // canonical form: a VBig never equals a VInt; two VBig equal iff same string.
  | VBig x -> (match vb with VBig y -> str_eq x y | _ -> false)
  | VRat (n, d) -> (match vb with VRat (n2, d2) -> str_eq n n2 && str_eq d d2 | VInt m -> str_eq d "1" && str_eq n (str_of_int m) | VFlt f -> feq (float_of_str n / float_of_str d) f | _ -> false)
  | VCpx (r, i) -> (match vb with VCpx (r2, i2) -> rb_eq r r2 && rb_eq i i2 | VInt m -> rb_eq i (VInt 0) && rb_eq r (VInt m) | _ -> false)
  | VStr x -> let x = sget x in (match vb with VStr y -> let y = sget y in str_eq x y | _ -> false)
  | VBool x ->
    (match vb with
     | VBool y -> if x then y else (if y then false else true)
     | _ -> false)
  | VNil -> (match vb with VNil -> true | _ -> false)
  | VArr x -> (match vb with VArr y -> if x == y then true else eq_list (deref x) (deref y) | _ -> false)
  | VHsh xs -> let xs = hderef xs in (match vb with VHsh ys -> let ys = hderef ys in hash_eq_unordered xs ys | _ -> false)
  // object identity (same handle); classes and symbols by value.
  | VObj x -> (match vb with VObj y -> x == y | _ -> false)
  | VClass x -> (match vb with VClass y -> str_eq x y | _ -> false)
  | VSym x -> (match vb with VSym y -> str_eq x y | _ -> false)
  | VRange (a, b, c) ->
    (match vb with VRange (d, e, f) -> a == d && b == e && (if c then f else (if f then false else true)) | _ -> false)
  | VExc (c, m) -> (match vb with VExc (d, n) -> str_eq c d && str_eq m n | _ -> false)
  | VMain -> (match vb with VMain -> true | _ -> false)
  // regexes / procs / bindings compare by pattern text / handle identity (and
  // never equal a different kind) — without these arms rb_eq is non-exhaustive
  // and aborts when a regex/proc reaches it (e.g. a `^regex` pin).
  | VRegex (p, pf) -> (match vb with VRegex (q, qf) -> str_eq p q && str_eq pf qf | _ -> false)
  | VProc x -> (match vb with VProc y -> x == y | _ -> false)
  | VBind x -> (match vb with VBind y -> x == y | _ -> false)

and eq_list = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (match ys with Nil -> true | _ -> false)
  | Cons (h, t) ->
    (match ys with
     | Nil -> false
     | Cons (h2, t2) -> rb_eq h h2 && eq_list t t2)
// Hash#== is order-insensitive: same size and every key maps to an equal
// value (both are flat [k,v,k,v,...] lists; keys are unique in a hash).
and hlookup_eq = fn (ys: Val list) -> fn (k: Val) ->
  match ys with
  | Cons (yk, Cons (yv, rest)) -> if rb_eq k yk then Cons (yv, Nil) else hlookup_eq rest k
  | _ -> Nil
and hash_eq_go = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Cons (k, Cons (v, rest)) ->
    (match hlookup_eq ys k with Cons (yv, _) -> if rb_eq v yv then hash_eq_go rest ys else false | _ -> false)
  | _ -> true
and vllen = fn (xs: Val list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + vllen t
and hash_eq_unordered = fn (xs: Val list) -> fn (ys: Val list) ->
  if vllen xs == vllen ys then hash_eq_go xs ys else false;

// numeric / string ordering: negative | zero | positive like a compare fn.
// ---- bignum: schoolbook arithmetic on canonical decimal strings ----------
// magnitude = bare digit string, no leading zeros ("0" for zero).
let rec mag_strip = fn (s: str) -> fn (i: int) ->
  if i >= str_len s - 1 then substring s i (str_len s)
  else if str_eq (char_at s i) "0" then mag_strip s (i + 1)
  else substring s i (str_len s);
let mag_cmp = fn (a: str) -> fn (b: str) ->
  let la = str_len a in let lb = str_len b in
  if la < lb then 0 - 1 else if la > lb then 1 else str_compare a b;
let rec zeros = fn (n: int) -> if n <= 0 then "" else "0" ++ zeros (n - 1);

let rec mag_add_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (carry: int) -> fn (acc: str) ->
  let la = str_len a in let lb = str_len b in
  if i >= la && i >= lb && carry == 0 then (if str_eq acc "" then "0" else acc)
  else
    let da = if i < la then ord (char_at a (la - 1 - i)) - 48 else 0 in
    let db = if i < lb then ord (char_at b (lb - 1 - i)) - 48 else 0 in
    let s = da + db + carry in
    mag_add_go a b (i + 1) (s / 10) (chr (s - (s / 10) * 10 + 48) ++ acc);
let mag_add = fn (a: str) -> fn (b: str) -> mag_add_go a b 0 0 "";

// a - b, assuming a >= b (magnitudes).
let rec mag_sub_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (borrow: int) -> fn (acc: str) ->
  let la = str_len a in let lb = str_len b in
  if i >= la then acc
  else
    let da = ord (char_at a (la - 1 - i)) - 48 in
    let db = (if i < lb then ord (char_at b (lb - 1 - i)) - 48 else 0) + borrow in
    let d = da - db in
    let d2 = if d < 0 then d + 10 else d in
    let nb = if d < 0 then 1 else 0 in
    mag_sub_go a b (i + 1) nb (chr (d2 + 48) ++ acc);
let mag_sub = fn (a: str) -> fn (b: str) -> mag_strip (mag_sub_go a b 0 0 "") 0;

// magnitude a times a single digit d (0..9).
let rec mag_mul1_go = fn (a: str) -> fn (d: int) -> fn (i: int) -> fn (carry: int) -> fn (acc: str) ->
  let la = str_len a in
  if i >= la then (if carry == 0 then acc else str_of_int carry ++ acc)
  else let da = ord (char_at a (la - 1 - i)) - 48 in
       let p = da * d + carry in
       mag_mul1_go a d (i + 1) (p / 10) (chr (p - (p / 10) * 10 + 48) ++ acc);
let mag_mul1 = fn (a: str) -> fn (d: int) -> if d == 0 then "0" else mag_mul1_go a d 0 0 "";
let rec mag_mul_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len b then acc
  else
    let d = ord (char_at b (str_len b - 1 - i)) - 48 in
    let partial = mag_strip (mag_mul1 a d) 0 ++ zeros i in
    mag_mul_go a b (i + 1) (mag_add acc (mag_strip partial 0));
let mag_mul = fn (a: str) -> fn (b: str) -> mag_strip (mag_mul_go a b 0 "0") 0;

// signed decimal strings ("-" prefix). sign/magnitude accessors.
let big_sign = fn (s: str) -> if str_len s > 0 && str_eq (char_at s 0) "-" then 0 - 1 else 1;
let big_mag = fn (s: str) -> if str_len s > 0 && str_eq (char_at s 0) "-" then substring s 1 (str_len s) else s;
let with_sign = fn (sgn: int) -> fn (mag: str) ->
  if str_eq mag "0" then "0" else if sgn < 0 then "-" ++ mag else mag;

let big_add_s = fn (a: str) -> fn (b: str) ->
  let sa = big_sign a in let sb = big_sign b in
  let ma = big_mag a in let mb = big_mag b in
  if sa == sb then with_sign sa (mag_add ma mb)
  else
    let c = mag_cmp ma mb in
    if c == 0 then "0"
    else if c > 0 then with_sign sa (mag_sub ma mb)
    else with_sign sb (mag_sub mb ma);
let big_neg_s = fn (a: str) -> if str_eq a "0" then "0" else if big_sign a < 0 then big_mag a else "-" ++ a;
let big_sub_s = fn (a: str) -> fn (b: str) -> big_add_s a (big_neg_s b);
let big_mul_s = fn (a: str) -> fn (b: str) -> with_sign (big_sign a * big_sign b) (mag_mul (big_mag a) (big_mag b));
let rec big_pow = fn (base: str) -> fn (e: int) -> fn (acc: str) ->
  if e <= 0 then acc else big_pow base (e - 1) (big_mul_s acc base);

// schoolbook long division of magnitudes: returns (quotient, remainder).
let rec mag_find_k = fn (b: str) -> fn (cur: str) -> fn (k: int) ->
  if k <= 0 then 0
  else if mag_cmp (mag_mul1 b k) cur <= 0 then k
  else mag_find_k b cur (k - 1);
let rec mag_dm_go = fn (a: str) -> fn (b: str) -> fn (i: int) -> fn (cur: str) -> fn (q: str) ->
  if i >= str_len a then (mag_strip q 0, mag_strip cur 0)
  else
    let cur2 = mag_strip (cur ++ char_at a i) 0 in
    let k = mag_find_k b cur2 9 in
    let cur3 = mag_sub cur2 (mag_strip (mag_mul1 b k) 0) in
    mag_dm_go a b (i + 1) cur3 (q ++ chr (k + 48));
let mag_divmod = fn (a: str) -> fn (b: str) -> mag_dm_go a b 0 "" "";

// signed divmod with Ruby semantics (quotient floors toward -inf; remainder
// takes the divisor's sign). Returns (quotient, remainder) as decimal strings.
let big_divmod_s = fn (a: str) -> fn (b: str) ->
  let dm = mag_divmod (big_mag a) (big_mag b) in
  let mq = (match dm with (q, r) -> q) in
  let mr = (match dm with (q, r) -> r) in
  let sa = big_sign a in let sb = big_sign b in
  let qt = with_sign (sa * sb) mq in
  let rt = with_sign sa mr in
  if str_eq mr "0" then (qt, "0")
  else if sa == sb then (qt, rt)
  else (big_sub_s qt "1", big_add_s rt b);
let big_div_s = fn (a: str) -> fn (b: str) -> (match big_divmod_s a b with (q, r) -> q);
let big_mod_s = fn (a: str) -> fn (b: str) -> (match big_divmod_s a b with (q, r) -> r);
let big_cmp_s = fn (a: str) -> fn (b: str) ->
  let sa = big_sign a in let sb = big_sign b in
  if sa < sb then 0 - 1 else if sa > sb then 1
  else (let c = mag_cmp (big_mag a) (big_mag b) in if sa < 0 then 0 - c else c);

// ---- Rational (num/den as canonical decimal strings, den > 0, reduced) ----
// bignum gcd of the magnitudes of a, b (Euclid), as a positive canonical string.
let rec big_gcd_s = fn (a: str) -> fn (b: str) ->
  let a = big_mag a in let b = big_mag b in
  if str_eq b "0" then (if str_eq a "" then "0" else a)
  else big_gcd_s b (big_mod_s a b);
// build a reduced Rational from num/den strings (den != 0).
let mk_rat_s = fn (n: str) -> fn (d: str) ->
  let nm = mag_strip (big_mag n) 0 in let dm = mag_strip (big_mag d) 0 in
  if str_eq dm "0" then fail "mere-ruby: divided by 0"
  else
    let sgn = big_sign n * big_sign d in
    let g = big_gcd_s nm dm in
    let g = if str_eq g "0" then "1" else g in
    let nr = big_div_s nm g in let dr = big_div_s dm g in
    VRat (with_sign sgn nr, dr);
let mk_rat = fn (n: int) -> fn (d: int) -> mk_rat_s (str_of_int n) (str_of_int d);
let rat_to_f = fn (n: str) -> fn (d: str) -> float_of_str n / float_of_str d;
let rat_add_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_add_s (big_mul_s an bd) (big_mul_s bn ad)) (big_mul_s ad bd);
let rat_sub_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_sub_s (big_mul_s an bd) (big_mul_s bn ad)) (big_mul_s ad bd);
let rat_mul_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_mul_s an bn) (big_mul_s ad bd);
let rat_div_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> mk_rat_s (big_mul_s an bd) (big_mul_s ad bn);
// compare an/ad vs bn/bd (dens > 0): sign of an*bd - bn*ad.
let rat_cmp_s = fn (an: str) -> fn (ad: str) -> fn (bn: str) -> fn (bd: str) -> big_cmp_s (big_mul_s an bd) (big_mul_s bn ad);
// +,-,*,/ when at least one operand is Rational (others Int/Rat/Float).
let rat_arith = fn (op: str) -> fn (va: Val) -> fn (vb: Val) ->
  let vaf = (match va with VFlt _ -> true | _ -> false) in
  let vbf = (match vb with VFlt _ -> true | _ -> false) in
  if vaf || vbf then
    (let x = to_f va in let y = to_f vb in
     if str_eq op "+" then VFlt (x + y) else if str_eq op "-" then VFlt (x - y)
     else if str_eq op "*" then VFlt (x * y) else VFlt (x / y))
  else
    let an = (match va with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
    let ad = (match va with VRat (n, d) -> d | _ -> "1") in
    let bn = (match vb with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
    let bd = (match vb with VRat (n, d) -> d | _ -> "1") in
    if str_eq op "+" then rat_add_s an ad bn bd
    else if str_eq op "-" then rat_sub_s an ad bn bd
    else if str_eq op "*" then rat_mul_s an ad bn bd
    else rat_div_s an ad bn bd;

// does a magnitude fit in a signed 64-bit int?
let big_fits = fn (mag: str) ->
  str_len mag < 19 || (str_len mag == 19 && str_compare mag "9223372036854775807" <= 0);
// canonicalise a signed decimal string to VInt (if it fits) or VBig.
let norm_big = fn (sval: str) ->
  let m = mag_strip (big_mag sval) 0 in
  let sgn = if str_eq m "0" then 1 else big_sign sval in
  let canon = with_sign sgn m in
  if big_fits m then VInt (int_of_str canon) else VBig canon;
// signed decimal of a numeric value.
let num_dec = fn (v: Val) -> match v with VInt n -> str_of_int n | VBig s -> s | _ -> "0";
// negate / sign / abs on a boxed numeric value (used by Complex components).
let num_neg = fn (v: Val) -> match v with
  | VInt n -> VInt (0 - n) | VFlt f -> VFlt (0.0 - f)
  | VBig s -> norm_big (big_neg_s s) | VRat (n, d) -> VRat (big_neg_s n, d) | _ -> v;
let num_isneg = fn (v: Val) -> match v with
  | VInt n -> n < 0 | VFlt f -> f < 0.0 | VBig s -> big_sign s < 0 | VRat (n, d) -> big_sign n < 0 | _ -> false;
let num_abs = fn (v: Val) -> if num_isneg v then num_neg v else v;
// +,-,* on two boxed numerics: exact int when both are VInt, else via float.
let num_bin = fn (o: str) -> fn (x: Val) -> fn (y: Val) ->
  match x with
  | VInt a -> (match y with
     | VInt b -> if str_eq o "+" then VInt (a + b) else if str_eq o "-" then VInt (a - b) else VInt (a * b)
     | _ -> let fa = float_of_int a in let fb = to_f y in
            if str_eq o "+" then VFlt (fa + fb) else if str_eq o "-" then VFlt (fa - fb) else VFlt (fa * fb))
  | _ -> let fa = to_f x in let fb = to_f y in
         if str_eq o "+" then VFlt (fa + fb) else if str_eq o "-" then VFlt (fa - fb) else VFlt (fa * fb);
// +,-,* when at least one operand is Complex (components are boxed numerics).
let cpx_arith = fn (op: str) -> fn (va: Val) -> fn (vb: Val) ->
  let ar = (match va with VCpx (r, i) -> r | v -> v) in
  let ai = (match va with VCpx (r, i) -> i | _ -> VInt 0) in
  let br = (match vb with VCpx (r, i) -> r | v -> v) in
  let bi = (match vb with VCpx (r, i) -> i | _ -> VInt 0) in
  if str_eq op "+" then VCpx (num_bin "+" ar br, num_bin "+" ai bi)
  else if str_eq op "-" then VCpx (num_bin "-" ar br, num_bin "-" ai bi)
  else if str_eq op "*" then VCpx (num_bin "-" (num_bin "*" ar br) (num_bin "*" ai bi), num_bin "+" (num_bin "*" ar bi) (num_bin "*" ai br))
  else fail "mere-ruby: complex division unsupported";
// int add/sub/mul that promote to bignum exactly on overflow. The checks
// are done BEFORE the operation (signed overflow is UB in C and clang -O2
// would optimise away any after-the-fact `r < 0` test).
// runtime ints are 64-bit, but the Mere compiler (OCaml) is 63-bit, so the
// literal 2^63-1 cannot appear in source — build it: (2^62-1)*2+1.
let int_max = 4611686018427387903 * 2 + 1;
let int_min = 0 - int_max - 1;
let add_int_ov = fn (a: int) -> fn (b: int) ->
  if (b > 0 && a > int_max - b) || (b < 0 && a < int_min - b)
  then norm_big (big_add_s (str_of_int a) (str_of_int b)) else VInt (a + b);
let sub_int_ov = fn (a: int) -> fn (b: int) ->
  if (b < 0 && a > int_max + b) || (b > 0 && a < int_min + b)
  then norm_big (big_sub_s (str_of_int a) (str_of_int b)) else VInt (a - b);
let mul_int_ov = fn (a: int) -> fn (b: int) ->
  if a == 0 || b == 0 then VInt 0
  else
    let ovf = if a > 0 then (if b > 0 then a > int_max / b else b < int_min / a)
              else (if b > 0 then a < int_min / b else b < int_max / a) in
    if ovf then norm_big (big_mul_s (str_of_int a) (str_of_int b)) else VInt (a * b);

let rec cmp_vals = fn (va: Val) -> fn (vb: Val) ->
  // bignum (or bignum vs int): compare exact decimal values, not floats.
  if (match va with VBig _ -> true | _ -> false) && (match vb with VInt _ -> true | VBig _ -> true | _ -> false)
     || (match vb with VBig _ -> true | _ -> false) && (match va with VInt _ -> true | _ -> false)
  then big_cmp_s (num_dec va) (num_dec vb)
  // Rational vs Rational/Int: exact cross-multiply compare.
  else if ((match va with VRat _ -> true | _ -> false) || (match vb with VRat _ -> true | _ -> false))
          && (match va with VRat _ -> true | VInt _ -> true | _ -> false)
          && (match vb with VRat _ -> true | VInt _ -> true | _ -> false) then
    (let an = (match va with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
     let ad = (match va with VRat (n, d) -> d | _ -> "1") in
     let bn = (match vb with VRat (n, d) -> n | VInt n -> str_of_int n | _ -> "0") in
     let bd = (match vb with VRat (n, d) -> d | _ -> "1") in
     rat_cmp_s an ad bn bd)
  else if is_num va && is_num vb then
    (match va with
     | VInt x ->
       (match vb with
        | VInt y -> if x < y then 0 - 1 else if x > y then 1 else 0
        | _ ->
          let fx = to_f va in let fy = to_f vb in
          if fx < fy then 0 - 1 else if fy < fx then 1 else 0)
     | _ ->
       let fx = to_f va in let fy = to_f vb in
       if fx < fy then 0 - 1 else if fy < fx then 1 else 0)
  else
    match va with
    | VStr x -> let x = sget x in
      (match vb with
       | VStr y -> let y = sget y in str_compare x y
       | _ -> fail "mere-ruby: comparison of incompatible types")
    | VSym x -> (match vb with VSym y -> str_compare x y | _ -> fail "mere-ruby: comparison of incompatible types")
    // Array <=> Array: element-wise, then by length (Ruby semantics).
    | VArr x -> (match vb with VArr y -> arr_cmp (deref x) (deref y) | _ -> fail "mere-ruby: comparison of incompatible types")
    | _ -> fail "mere-ruby: comparison of incompatible types"
// would cmp_vals fail on this pair? (the < family raises ArgumentError)
and cmp_incompatible = fn (va: Val) -> fn (vb: Val) ->
  if is_num va && is_num vb then false
  else
    (match va with
     | VStr _ -> (match vb with VStr _ -> false | _ -> true)
     | VSym _ -> (match vb with VSym _ -> false | _ -> true)
     | VArr _ -> (match vb with VArr _ -> false | _ -> true)
     | VRat (_, _) -> (if is_num vb then false else true)
     | _ -> true)

and arr_cmp = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (match ys with Nil -> 0 | _ -> 0 - 1)
  | Cons (h, t) ->
    (match ys with
     | Nil -> 1
     | Cons (h2, t2) -> let c = cmp_vals h h2 in if c == 0 then arr_cmp t t2 else c);

let rec list_append = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, list_append t ys);

// a deterministic per-value hash (equal values -> equal hash). Ruby's own
// hash is process-randomised, so only intra-run consistency is required.
let rec val_hash = fn (v: Val) ->
  match v with
  | VInt n -> n
  | VBig s -> str_hash_go s 0 7
  | VStr h -> str_hash_go (sget h) 0 7
  | VSym s -> str_hash_go s 0 5381
  | VBool b -> if b then 1 else 0
  | VNil -> 0
  | VFlt f -> int_of_float f
  | VArr id -> arr_hash_go (deref id) 17
  | _ -> 0
and str_hash_go = fn (s: str) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc
  else str_hash_go s (i + 1) (floor_mod (acc * 31 + ord (char_at s i)) 1000000007)
and arr_hash_go = fn (xs: Val list) -> fn (acc: int) ->
  match xs with Nil -> acc | Cons (h, t) -> arr_hash_go t (floor_mod (acc * 31 + val_hash h) 1000000007);

// flatten one level: array elements are spliced, others kept (for flat_map).
let rec flatten1 = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> (match h with VArr id -> list_append (deref id) (flatten1 t) | _ -> Cons (h, flatten1 t));

let rec val_member = fn (xs: Val list) -> fn (v: Val) ->
  match xs with Nil -> false | Cons (h, t) -> rb_eq h v || val_member t v;
let rec val_remove = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if rb_eq h v then val_remove t v else Cons (h, val_remove t v);
// append ys to acc keeping first occurrences only (Array#| semantics).
let rec val_dedup_into = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> if val_member acc h then val_dedup_into t acc else val_dedup_into t (list_append acc (Cons (h, Nil)));
let rec val_intersect = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if val_member ys h then Cons (h, val_intersect t ys) else val_intersect t ys;

let rec bits_of = fn (n: int) -> fn (k: int) ->
  // 63 low bits of n as a list (two's-complement not handled; specs use
  // small non-negative ints for bitwise tests).
  if k == 0 then Nil else Cons (floor_mod n 2, bits_of (n / 2) (k - 1));
let rec bits_val = fn (bs: int list) -> fn (place: int) ->
  match bs with Nil -> 0 | Cons (b, t) -> b * place + bits_val t (place * 2);
let rec bits_zip = fn (op: str) -> fn (xs: int list) -> fn (ys: int list) ->
  match xs with
  | Nil -> Nil
  | Cons (x, xt) ->
    (match ys with
     | Nil -> Nil
     | Cons (y, yt) ->
       let b = if str_eq op "&" then (if x == 1 && y == 1 then 1 else 0)
               else if str_eq op "|" then (if x == 1 || y == 1 then 1 else 0)
               else (if x != y then 1 else 0) in
       Cons (b, bits_zip op xt yt));
let int_bitop = fn (op: str) -> fn (x: int) -> fn (y: int) ->
  bits_val (bits_zip op (bits_of x 62) (bits_of y 62)) 1;

// a list concatenated with itself n times (Array * Integer).
let rec list_rep = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then (Nil : Val list) else list_append xs (list_rep xs (n - 1));
let arith_bin = fn (op: str) -> fn (va: Val) -> fn (vb: Val) ->
  // Rational operand: +,-,*,/ produce a Rational (or Float if a Float is
  // involved). Checked first so int/rat mixing works uniformly.
  if ((match va with VRat _ -> true | _ -> false) || (match vb with VRat _ -> true | _ -> false))
     && (str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/")
  then rat_arith op va vb
  else if ((match va with VCpx _ -> true | _ -> false) || (match vb with VCpx _ -> true | _ -> false))
     && (str_eq op "+" || str_eq op "-" || str_eq op "*")
  then cpx_arith op va vb
  else if str_eq op "|" then
    (match va with
     | VArr x -> (match vb with VArr y -> arr_new (val_dedup_into (deref y) (val_dedup_into (deref x) Nil)) | _ -> fail "mere-ruby: | type error")
     | VInt x -> (match vb with VInt y -> VInt (int_bitop "|" x y) | _ -> fail "mere-ruby: | type error")
     | VBool x -> (match vb with VBool y -> VBool (x || y) | _ -> fail "mere-ruby: | type error")
     | _ -> fail "mere-ruby: | type error")
  else if str_eq op "&" then
    (match va with
     | VArr x -> (match vb with VArr y -> arr_new (val_intersect (val_dedup_into (deref x) Nil) (deref y)) | _ -> fail "mere-ruby: & type error")
     | VInt x -> (match vb with VInt y -> VInt (int_bitop "&" x y) | _ -> fail "mere-ruby: & type error")
     | VBool x -> (match vb with VBool y -> VBool (x && y) | _ -> fail "mere-ruby: & type error")
     | _ -> fail "mere-ruby: & type error")
  else if str_eq op "^" then
    (match va with
     | VInt x -> (match vb with VInt y -> VInt (int_bitop "^" x y) | _ -> fail "mere-ruby: ^ type error")
     | VBool x -> (match vb with VBool y -> VBool (if x then (if y then false else true) else y) | _ -> fail "mere-ruby: ^ type error")
     | _ -> fail "mere-ruby: ^ type error")
  else
  if str_eq op "+" then
    (match va with
     | VStr x -> (match vb with VStr y -> (let r = mkstr (sget x ++ sget y) in (match r with VStr rid -> let _ = senc_set rid (senc_get x) in r | _ -> r)) | _ -> fail "mere-ruby: no implicit conversion in +")
     | VArr x -> (match vb with VArr y -> arr_new (list_append (deref x) (deref y)) | _ -> fail "mere-ruby: no implicit conversion in +")
     | VInt x -> (match vb with VInt y -> add_int_ov x y | VBig y -> norm_big (big_add_s (str_of_int x) y) | VFlt y -> VFlt (float_of_int x + y) | _ -> fail "mere-ruby: + type error")
     | VBig x -> (match vb with VInt y -> norm_big (big_add_s x (str_of_int y)) | VBig y -> norm_big (big_add_s x y) | VFlt y -> VFlt (float_of_str x + y) | _ -> fail "mere-ruby: + type error")
     | VFlt x -> (match vb with VInt y -> VFlt (x + float_of_int y) | VBig y -> VFlt (x + float_of_str y) | VFlt y -> VFlt (x + y) | _ -> fail "mere-ruby: + type error")
     | _ -> fail "mere-ruby: + type error")
  else if str_eq op "-" then
    (match va with
     | VInt x -> (match vb with VInt y -> sub_int_ov x y | VBig y -> norm_big (big_sub_s (str_of_int x) y) | VFlt y -> VFlt (float_of_int x - y) | _ -> fail "mere-ruby: - type error")
     | VBig x -> (match vb with VInt y -> norm_big (big_sub_s x (str_of_int y)) | VBig y -> norm_big (big_sub_s x y) | VFlt y -> VFlt (float_of_str x - y) | _ -> fail "mere-ruby: - type error")
     | VFlt x -> (match vb with VInt y -> VFlt (x - float_of_int y) | VBig y -> VFlt (x - float_of_str y) | VFlt y -> VFlt (x - y) | _ -> fail "mere-ruby: - type error")
     | _ -> fail "mere-ruby: - type error")
  else if str_eq op "*" then
    (match va with
     | VStr x -> let x = sget x in (match vb with VInt y -> mkstr (str_repeat x y) | _ -> fail "mere-ruby: * type error")
     | VArr x -> (match vb with VInt y -> arr_new (list_rep (deref x) y) | _ -> fail "mere-ruby: * type error")
     | VInt x -> (match vb with VInt y -> mul_int_ov x y | VBig y -> norm_big (big_mul_s (str_of_int x) y) | VFlt y -> VFlt (float_of_int x * y) | _ -> fail "mere-ruby: * type error")
     | VBig x -> (match vb with VInt y -> norm_big (big_mul_s x (str_of_int y)) | VBig y -> norm_big (big_mul_s x y) | VFlt y -> VFlt (float_of_str x * y) | _ -> fail "mere-ruby: * type error")
     | VFlt x -> (match vb with VInt y -> VFlt (x * float_of_int y) | VBig y -> VFlt (x * float_of_str y) | VFlt y -> VFlt (x * y) | _ -> fail "mere-ruby: * type error")
     | _ -> fail "mere-ruby: * type error")
  else if str_eq op "/" then
    (match va with
     | VInt x ->
       (match vb with
        | VInt y -> VInt (floor_div x y)
        | VBig y -> norm_big (big_div_s (str_of_int x) y)
        | VFlt y -> VFlt (float_of_int x / y)
        | _ -> fail "mere-ruby: / type error")
     | VBig x ->
       (match vb with
        | VInt y -> norm_big (big_div_s x (str_of_int y))
        | VBig y -> norm_big (big_div_s x y)
        | VFlt y -> VFlt (float_of_str x / y)
        | _ -> fail "mere-ruby: / type error")
     | VFlt x ->
       (match vb with
        | VInt y -> VFlt (x / float_of_int y)
        | VBig y -> VFlt (x / float_of_str y)
        | VFlt y -> VFlt (x / y)
        | _ -> fail "mere-ruby: / type error")
     | _ -> fail "mere-ruby: / type error")
  else if str_eq op "%" then
    (match va with
     | VInt x -> (match vb with VInt y -> VInt (floor_mod x y) | VBig y -> norm_big (big_mod_s (str_of_int x) y) | _ -> fail "mere-ruby: % supports integers only in M0")
     | VBig x -> (match vb with VInt y -> norm_big (big_mod_s x (str_of_int y)) | VBig y -> norm_big (big_mod_s x y) | _ -> fail "mere-ruby: % supports integers only in M0")
     | _ -> fail "mere-ruby: % supports integers only in M0")
  else if str_eq op "**" then
    (match va with
     | VInt x -> (match vb with VInt y -> if y < 0 then VFlt (pow_flt (float_of_int x) y) else norm_big (big_pow (str_of_int x) y "1") | _ -> fail "mere-ruby: ** float exponent unsupported in M0")
     | VBig x -> (match vb with VInt y -> if y < 0 then VFlt (pow_flt (float_of_str x) y) else norm_big (big_pow x y "1") | _ -> fail "mere-ruby: ** type error")
     | VFlt x -> (match vb with VInt y -> VFlt (pow_flt x y) | _ -> fail "mere-ruby: ** float exponent unsupported in M0")
     | _ -> fail "mere-ruby: ** type error")
  else if str_eq op "<<" then
    // array append (mutating, returns the same array); string concat;
    // integer shift-left.
    (match va with
     | VArr id -> let _ = arr_set id (list_append (deref id) (Cons (vb, Nil))) in va
     | VStr x -> let x = sget x in (match vb with VStr y -> let y = sget y in mkstr (x ++ y) | _ -> fail "mere-ruby: << string needs a string")
     | VInt x -> (match vb with VInt y -> VInt (shl_int x y) | _ -> fail "mere-ruby: << type error")
     | _ -> fail "mere-ruby: << type error")
  else if str_eq op ">>" then
    (match va with
     | VInt x -> (match vb with VInt y -> VInt (shr_int x y) | _ -> fail "mere-ruby: >> type error")
     | _ -> fail "mere-ruby: >> type error")
  else fail ("mere-ruby: unknown operator: " ++ op);


// ---- M5 core-method helpers (leaf: no world / block) ---------------------
// character-level case mapping (Mere has str_rev/trim/split/... but no
// upcase/downcase).
let shift_case = fn (s: str) -> fn (lo: int) -> fn (hi: int) -> fn (delta: int) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let o = ord (char_at s i) in
      let c = if o >= lo && o <= hi then chr (o + delta) else char_at s i in
      go (i + 1) (acc ++ c) in
  go 0 "";
// ---- UTF-8-aware case mapping (ASCII + Latin-1 Supplement) ---------------
// decode the codepoint at byte i; returns (codepoint, byte_length).
let utf8_cp = fn (s: str) -> fn (i: int) ->
  let b0 = ord (char_at s i) in
  if b0 < 128 then (b0, 1)
  else if b0 < 224 then ((b0 - 192) * 64 + (ord (char_at s (i + 1)) - 128), 2)
  else if b0 < 240 then ((b0 - 224) * 4096 + (ord (char_at s (i + 1)) - 128) * 64 + (ord (char_at s (i + 2)) - 128), 3)
  else ((b0 - 240) * 262144 + (ord (char_at s (i + 1)) - 128) * 4096 + (ord (char_at s (i + 2)) - 128) * 64 + (ord (char_at s (i + 3)) - 128), 4);
// encode a codepoint back to UTF-8 bytes.
let utf8_enc = fn (cp: int) ->
  if cp < 128 then chr cp
  else if cp < 2048 then chr (192 + cp / 64) ++ chr (128 + cp - (cp / 64) * 64)
  else if cp < 65536 then chr (224 + cp / 4096) ++ chr (128 + (cp / 64) - (cp / 4096) * 64) ++ chr (128 + cp - (cp / 64) * 64)
  else chr (240 + cp / 262144) ++ chr (128 + (cp / 4096) - (cp / 262144) * 64) ++ chr (128 + (cp / 64) - (cp / 4096) * 64) ++ chr (128 + cp - (cp / 64) * 64);
// byte length of the codepoint at byte i.
let utf8_clen = fn (s: str) -> fn (i: int) -> (match utf8_cp s i with (c, l) -> l);
// number of codepoints in s.
let rec utf8_len_go = fn (s: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len s then n else utf8_len_go s (i + utf8_clen s i) (n + 1);
let utf8_len = fn (s: str) -> utf8_len_go s 0 0;
// byte offset of the k-th codepoint (clamped to str_len).
let rec utf8_boff = fn (s: str) -> fn (k: int) -> fn (i: int) ->
  if k <= 0 || i >= str_len s then i else utf8_boff s (k - 1) (i + utf8_clen s i);
// the k-th codepoint as a string ("" if out of range).
let utf8_char = fn (s: str) -> fn (k: int) ->
  let off = utf8_boff s k 0 in
  if off >= str_len s then "" else substring s off (off + utf8_clen s off);
// codepoint substring [st, st+len) — st/len in codepoints.
let utf8_substr = fn (s: str) -> fn (st: int) -> fn (len: int) ->
  let a = utf8_boff s st 0 in let b = utf8_boff s (st + len) 0 in substring s a b;
// list of one-codepoint VStr values.
let rec utf8_chars_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else let l = utf8_clen s i in Cons (mkstr (substring s i (i + l)), utf8_chars_val s (i + l));
// reverse by codepoints.
let rec utf8_rev_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc else let l = utf8_clen s i in utf8_rev_go s (i + l) (substring s i (i + l) ++ acc);
let utf8_reverse = fn (s: str) -> utf8_rev_go s 0 "";

// ---- transcoding between UTF-8 / ISO-8859-1 / US-ASCII (formula-based) ----
// decode source bytes to a codepoint list (UTF-8 multibyte; else byte=cp).
let rec decode_cps = fn (s: str) -> fn (from: str) -> fn (i: int) ->
  if i >= str_len s then Nil
  else if str_eq from "UTF-8" then (match utf8_cp s i with (c, l) -> Cons (c, decode_cps s from (i + l)))
  else Cons (ord (char_at s i), decode_cps s from (i + 1));
// encode codepoints to the target; second tuple element is false on an
// undefined conversion (a codepoint the target can't represent).
let rec encode_cps = fn (cps: int list) -> fn (to: str) -> fn (acc: str) ->
  match cps with
  | Nil -> (acc, true)
  | Cons (cp, t) ->
    if str_eq to "UTF-8" then encode_cps t to (acc ++ utf8_enc cp)
    else if cp <= (if str_eq to "US-ASCII" then 127 else 255) then encode_cps t to (acc ++ chr cp)
    else (acc, false);
let enc_canon = fn (nm: str) -> if str_eq nm "BINARY" || str_eq nm "binary" then "ASCII-8BIT" else nm;
// transcode s from one encoding to another; returns (bytes, ok). ASCII-8BIT
// on either side is a relabel (bytes unchanged); same encoding is a no-op.
let str_transcode = fn (s: str) -> fn (from: str) -> fn (to: str) ->
  if str_eq from to then (s, true)
  else if str_eq to "ASCII-8BIT" || str_eq from "ASCII-8BIT" then (s, true)
  else encode_cps (decode_cps s from 0) to "";
// codepoint case maps: ASCII plus Latin-1 (à-þ except ÷; À-Þ except ×).
// case maps for the scripts with a regular offset: ASCII, Latin-1, Greek
// (U+0391-03A9 <-> U+03B1-03C9, +/-32; final sigma U+03C2 -> Sigma), and
// Cyrillic (U+0410-042F <-> U+0430-044F +/-32; U+0400-040F <-> U+0450-045F
// +/-80). Full Unicode (Latin Extended, folding, Turkic) is out of scope.
let cp_upcase = fn (cp: int) ->
  if cp >= 97 && cp <= 122 then cp - 32
  else if cp >= 224 && cp <= 254 && (if cp == 247 then false else true) then cp - 32
  else if cp == 962 then 931
  else if cp >= 945 && cp <= 969 then cp - 32
  // monotonic Greek accented vowels (irregular): ά έ ή ί ό ύ ώ ϊ ϋ
  else if cp == 940 then 902 else if cp == 941 then 904 else if cp == 942 then 905
  else if cp == 943 then 906 else if cp == 972 then 908 else if cp == 973 then 910
  else if cp == 974 then 911 else if cp == 970 then 938 else if cp == 971 then 939
  else if cp >= 1072 && cp <= 1103 then cp - 32
  else if cp >= 1104 && cp <= 1119 then cp - 80
  else cp;
let cp_downcase = fn (cp: int) ->
  if cp >= 65 && cp <= 90 then cp + 32
  else if cp >= 192 && cp <= 222 && (if cp == 215 then false else true) then cp + 32
  else if cp >= 913 && cp <= 937 && (if cp == 930 then false else true) then cp + 32
  // monotonic Greek accented capitals: Ά Έ Ή Ί Ό Ύ Ώ Ϊ Ϋ
  else if cp == 902 then 940 else if cp == 904 then 941 else if cp == 905 then 942
  else if cp == 906 then 943 else if cp == 908 then 972 else if cp == 910 then 973
  else if cp == 911 then 974 else if cp == 938 then 970 else if cp == 939 then 971
  else if cp >= 1040 && cp <= 1071 then cp + 32
  else if cp >= 1024 && cp <= 1039 then cp + 80
  else cp;
let cp_swapcase = fn (cp: int) ->
  let u = cp_upcase cp in if u == cp then cp_downcase cp else u;
// walk a UTF-8 string applying a codepoint mapper. ß (0xDF) upcases to "SS".
let rec str_case_u = fn (s: str) -> fn (i: int) -> fn (up: bool) -> fn (mapper: int -> int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let cpl = utf8_cp s i in
    let cp = (match cpl with (c, l) -> c) in
    let l = (match cpl with (c, l) -> l) in
    let piece = if up && cp == 223 then "SS" else utf8_enc (mapper cp) in
    str_case_u s (i + l) up mapper (acc ++ piece);
let str_upcase = fn (s: str) -> str_case_u s 0 true cp_upcase "";
let str_downcase = fn (s: str) -> str_case_u s 0 false cp_downcase "";
let str_swapcase_u = fn (s: str) -> str_case_u s 0 false cp_swapcase "";
// capitalize: first codepoint up, the rest down.
let str_capitalize = fn (s: str) ->
  if str_len s == 0 then s
  else
    let cpl = utf8_cp s 0 in
    let l = (match cpl with (c, ln) -> ln) in
    str_case_u (substring s 0 l) 0 true cp_upcase "" ++ str_case_u (substring s l (str_len s)) 0 false cp_downcase "";

// ---- integer helpers (gcd / base conversion / digits / pow) --------------
let rec int_gcd = fn (a: int) -> fn (b: int) ->
  if b == 0 then (if a < 0 then 0 - a else a) else int_gcd b (a - (a / b) * b);
let digit_char = fn (d: int) -> if d < 10 then chr (48 + d) else chr (97 + d - 10);
let rec int_to_base_go = fn (n: int) -> fn (base: int) -> fn (acc: str) ->
  if n == 0 then acc else int_to_base_go (n / base) base (digit_char (n - (n / base) * base) ++ acc);
let int_to_base = fn (n: int) -> fn (base: int) ->
  if n == 0 then "0"
  else if n < 0 then "-" ++ int_to_base_go (0 - n) base ""
  else int_to_base_go n base "";
let rec int_digits_go = fn (n: int) -> fn (base: int) ->
  if n == 0 then Nil else Cons (VInt (n - (n / base) * base), int_digits_go (n / base) base);
let int_digits = fn (n: int) -> fn (base: int) ->
  if n == 0 then Cons (VInt 0, Nil) else int_digits_go n base;
let rec int_pow = fn (b: int) -> fn (e: int) -> if e <= 0 then 1 else b * int_pow b (e - 1);
let rec int_pow_mod = fn (b: int) -> fn (e: int) -> fn (m: int) ->
  if e <= 0 then 1
  else let r = b * int_pow_mod b (e - 1) m in r - (r / m) * m;
let rec int_bit_length = fn (n: int) ->
  if n == 0 then 0 else 1 + int_bit_length (n / 2);
// digit value of a base-N char (0-9a-z), or -1.
let hexval = fn (c: str) ->
  let o = ord c in
  if o >= 48 && o <= 57 then o - 48
  else if o >= 97 && o <= 122 then o - 97 + 10
  else if o >= 65 && o <= 90 then o - 65 + 10
  else 0 - 1;
let rec str_to_int_base_go = fn (s: str) -> fn (base: int) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len s then acc
  else let d = hexval (char_at s i) in
       if d < 0 || d >= base then acc else str_to_int_base_go s base (i + 1) (acc * base + d);
// length of a 0x/0b/0o/0d radix prefix at `off` that matches `base` (else 0).
let base_prefix_len = fn (s: str) -> fn (off: int) -> fn (base: int) ->
  if off + 1 < str_len s && str_eq (char_at s off) "0" then
    (let c = char_at s (off + 1) in
     if (base == 16 && (str_eq c "x" || str_eq c "X")) ||
        (base == 2 && (str_eq c "b" || str_eq c "B")) ||
        (base == 8 && (str_eq c "o" || str_eq c "O")) ||
        (base == 10 && (str_eq c "d" || str_eq c "D"))
     then 2 else 0)
  else 0;
let str_to_int_base = fn (s: str) -> fn (base: int) ->
  if str_len s > 0 && str_eq (char_at s 0) "-" then 0 - str_to_int_base_go s base (1 + base_prefix_len s 1 base) 0
  else str_to_int_base_go s base (base_prefix_len s 0 base) 0;


// float floor/ceil/round built on int_of_float (which truncates toward 0).
let flt_floor = fn (x: float) -> let t = int_of_float x in if float_of_int t > x then t - 1 else t;
let flt_ceil = fn (x: float) -> let t = int_of_float x in if float_of_int t < x then t + 1 else t;
let flt_round = fn (x: float) -> if x < 0.0 then flt_ceil (x - 0.5) else flt_floor (x + 0.5);
// integer round/floor/ceil to a power-of-ten place (n negative in Ruby).
let int_round_place = fn (x: int) -> fn (m: int) ->
  if x >= 0 then ((x + m / 2) / m) * m else 0 - (((0 - x) + m / 2) / m) * m;

let rec str_ascii_only = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then true else if ord (char_at s i) >= 128 then false else str_ascii_only s (i + 1);
let str_swapcase = fn (s: str) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let o = ord (char_at s i) in
      let c = if o >= 97 && o <= 122 then chr (o - 32)
              else if o >= 65 && o <= 90 then chr (o + 32)
              else char_at s i in
      go (i + 1) (acc ++ c) in
  go 0 "";

let is_ws_ch = fn (c: str) ->
  str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r";

let str_lstrip = fn (s: str) ->
  let n = str_len s in
  let rec go = fn (i: int) -> if i < n && is_ws_ch (char_at s i) then go (i + 1) else i in
  substring s (go 0) n;
let str_rstrip = fn (s: str) ->
  let rec go = fn (i: int) -> if i >= 0 && is_ws_ch (char_at s i) then go (i - 1) else i in
  substring s 0 (go (str_len s - 1) + 1);

// remove one trailing record separator: \r\n, then \n or \r.
let str_chomp = fn (s: str) ->
  let n = str_len s in
  if n >= 2 && str_eq (substring s (n - 2) n) "\r\n" then substring s 0 (n - 2)
  else if n >= 1 && (str_eq (char_at s (n - 1)) "\n" || str_eq (char_at s (n - 1)) "\r") then substring s 0 (n - 1)
  else s;
// remove the last character (a trailing \r\n counts as one).
let str_chop = fn (s: str) ->
  let n = str_len s in
  if n >= 2 && str_eq (substring s (n - 2) n) "\r\n" then substring s 0 (n - 2)
  else if n >= 1 then substring s 0 (n - 1) else s;

// index of the first occurrence of pat in s at or after i, or -1.
let rec str_find_from = fn (s: str) -> fn (pat: str) -> fn (i: int) ->
  let n = str_len s in let m = str_len pat in
  if i + m > n then 0 - 1
  else if str_eq (substring s i (i + m)) pat then i
  else str_find_from s pat (i + 1);
// expand \&/\0 (whole match m), \\ and \x in a replacement for a string
// pattern; \1..\9 become empty (a string pattern has no capture groups).
let rec lit_expand_rep = fn (rep: str) -> fn (m: str) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len rep in
  if i >= n then acc
  else
    let c = char_at rep i in
    if str_eq c "\\" && i + 1 < n then
      let d = char_at rep (i + 1) in
      if str_eq d "&" || str_eq d "0" then lit_expand_rep rep m (i + 2) (acc ++ m)
      else if is_digit d then lit_expand_rep rep m (i + 2) acc
      else if str_eq d "\\" then lit_expand_rep rep m (i + 2) (acc ++ "\\")
      else lit_expand_rep rep m (i + 2) (acc ++ "\\" ++ d)
    else lit_expand_rep rep m (i + 1) (acc ++ c);
// interleave rep between/around every character (empty-pattern sub/gsub).
let rec str_interleave = fn (s: str) -> fn (rep: str) -> fn (i: int) ->
  if i >= str_len s then rep
  else rep ++ char_at s i ++ str_interleave s rep (i + 1);
let str_sub_lit = fn (s: str) -> fn (pat: str) -> fn (rep0: str) ->
  if str_len pat == 0 then lit_expand_rep rep0 "" 0 "" ++ s
  else
    let i = str_find_from s pat 0 in
    if i < 0 then s
    else substring s 0 i ++ lit_expand_rep rep0 pat 0 "" ++ substring s (i + str_len pat) (str_len s);
let rec str_gsub_lit = fn (s: str) -> fn (pat: str) -> fn (rep0: str) ->
  let m = str_len pat in
  if m == 0 then str_interleave s (lit_expand_rep rep0 "" 0 "") 0
  else
    let i = str_find_from s pat 0 in
    if i < 0 then s
    else substring s 0 i ++ lit_expand_rep rep0 pat 0 "" ++ str_gsub_lit (substring s (i + m) (str_len s)) pat rep0;

// explode a string into a list of one-character VStr values.
let rec str_chars_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else Cons (mkstr (char_at s i), str_chars_val s (i + 1));

// ---- char-set string methods (tr / count / delete / squeeze) -------------
let rec range_chars = fn (lo: int) -> fn (hi: int) ->
  if lo > hi then "" else chr lo ++ range_chars (lo + 1) hi;
// expand a tr/count set spec ("a-z0-9") into the explicit character list.
let rec str_expand_set = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len s in
  if i >= n then acc
  else if i + 2 < n && str_eq (char_at s (i + 1)) "-" then
    str_expand_set s (i + 3) (acc ++ range_chars (ord (char_at s i)) (ord (char_at s (i + 2))))
  else str_expand_set s (i + 1) (acc ++ char_at s i);
let rec char_pos = fn (set: str) -> fn (c: str) -> fn (i: int) ->
  if i >= str_len set then 0 - 1 else if str_eq (char_at set i) c then i else char_pos set c (i + 1);

// membership in a single set spec: leading ^ (len>=2) negates; a-z expands.
let str_set_has = fn (set0: str) -> fn (c: str) ->
  if str_len set0 >= 2 && str_eq (char_at set0 0) "^" then
    (if str_contains (str_expand_set (substring set0 1 (str_len set0)) 0 "") c then false else true)
  else str_contains (str_expand_set set0 0 "") c;
// a char passes when it is in EVERY set (Ruby intersects multiple set args).
let rec all_sets_has = fn (sets: str list) -> fn (c: str) ->
  match sets with Nil -> true | Cons (h, t) -> if str_set_has h c then all_sets_has t c else false;

let str_tr = fn (s: str) -> fn (from0: str) -> fn (to0: str) ->
  let neg = str_len from0 >= 2 && str_eq (char_at from0 0) "^" in
  let from = str_expand_set (if neg then substring from0 1 (str_len from0) else from0) 0 "" in
  let to = str_expand_set to0 0 "" in
  let tn = str_len to in
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let c = char_at s i in
      let k = char_pos from c 0 in
      let hit = if neg then (if k < 0 then true else false) else (if k >= 0 then true else false) in
      let nc = if hit then (if tn == 0 then ""
                            else if neg then char_at to (tn - 1)
                            else if k >= tn then char_at to (tn - 1)
                            else char_at to k)
               else c in
      go (i + 1) (acc ++ nc) in
  go 0 "";
let str_count_sets = fn (s: str) -> fn (sets: str list) ->
  let rec go = fn (i: int) -> fn (n: int) ->
    if i >= str_len s then n
    else go (i + 1) (if all_sets_has sets (char_at s i) then n + 1 else n) in
  go 0 0;
let str_delete_sets = fn (s: str) -> fn (sets: str list) ->
  let rec go = fn (i: int) -> fn (acc: str) ->
    if i >= str_len s then acc
    else let c = char_at s i in go (i + 1) (if all_sets_has sets c then acc else acc ++ c) in
  go 0 "";
// collapse runs of the same character (optionally only those in `set`).
let str_squeeze = fn (s: str) -> fn (set0: str) -> fn (use_set: bool) ->
  let rec go = fn (i: int) -> fn (prev: str) -> fn (acc: str) ->
    if i >= str_len s then acc
    else
      let c = char_at s i in
      if str_eq c prev && (if use_set then str_set_has set0 c else true) then go (i + 1) c acc
      else go (i + 1) c (acc ++ c) in
  go 0 "" "";

// ---- padding (ljust / rjust / center) ------------------------------------
let rec str_pad_to = fn (pad: str) -> fn (k: int) ->
  if k <= 0 then ""
  else if k >= str_len pad then pad ++ str_pad_to pad (k - str_len pad)
  else substring pad 0 k;
let str_ljust = fn (s: str) -> fn (w: int) -> fn (pad: str) ->
  let n = str_len s in if n >= w || str_len pad == 0 then s else s ++ str_pad_to pad (w - n);
let str_rjust = fn (s: str) -> fn (w: int) -> fn (pad: str) ->
  let n = str_len s in if n >= w || str_len pad == 0 then s else str_pad_to pad (w - n) ++ s;
let str_center = fn (s: str) -> fn (w: int) -> fn (pad: str) ->
  let n = str_len s in
  if n >= w || str_len pad == 0 then s
  else let total = w - n in let left = total / 2 in
    str_pad_to pad left ++ s ++ str_pad_to pad (total - left);

// collect the string values from an argument list (for multi-set count/delete).
let rec collect_str_args = fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (VStr h, t) -> Cons (sget h, collect_str_args t)
  | Cons (_, t) -> collect_str_args t;

// last index of sub in s, or -1.
let rec str_rindex_go = fn (s: str) -> fn (sub: str) -> fn (i: int) ->
  if i < 0 then 0 - 1
  else if str_eq (substring s i (i + str_len sub)) sub then i
  else str_rindex_go s sub (i - 1);

// the source file's magic comment ("# -*- encoding: us-ascii -*-",
// "# coding: utf-8"): the upcased encoding name, or "" if none. Scans the
// first line (the second when the first is a shebang) for "coding".
let rec coding_name_at = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else
    let c = char_at s i in
    if (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || str_eq c "-" || str_eq c "_"
    then char_at s i ++ coding_name_at s (i + 1)
    else "";
let rec scan_coding_line = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then ""
  else if str_eq (char_at s i) "\n" then ""
  else if i + 6 <= str_len s && str_eq (substring s i (i + 6)) "coding" then
    // skip "coding", optional spaces, ":" or "=", spaces, then the name.
    let rec skip = fn (j: int) ->
      if j >= str_len s then j
      else if str_eq (char_at s j) " " || str_eq (char_at s j) ":" || str_eq (char_at s j) "=" then skip (j + 1)
      else j in
    coding_name_at s (skip (i + 6))
  else scan_coding_line s (i + 1);
let rec line_end = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i else if str_eq (char_at s i) "\n" then i else line_end s (i + 1);
let src_coding = fn (src: str) ->
  let start = (if str_len src >= 2 && str_eq (substring src 0 2) "#!" then line_end src 0 + 1 else 0) in
  if start < str_len src && str_eq (char_at src start) "#" then str_upcase (scan_coding_line src start)
  else "";

// index into a Val list (nil beyond the end); supports Ruby negative
// indices (-1 = last).
let rec val_nth = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> if i == 0 then h else val_nth t (i - 1);

let rec val_len_i = fn (xs: Val list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + val_len_i t;

// String#succ: increment the rightmost alnum with carry (z->a, 9->0, ...),
// prepending a digit/letter when the carry runs off the left end.
let set_char = fn (s: str) -> fn (i: int) -> fn (c: str) ->
  substring s 0 i ++ c ++ substring s (i + 1) (str_len s);
let rec succ_at = fn (s: str) -> fn (i: int) ->
  if i < 0 then
    (let f = char_at s 0 in
     (if is_digit f then "1" else if f >= "a" && f <= "z" then "a" else if f >= "A" && f <= "Z" then "A" else "") ++ s)
  else
    let c = char_at s i in
    if str_eq c "z" then succ_at (set_char s i "a") (i - 1)
    else if str_eq c "Z" then succ_at (set_char s i "A") (i - 1)
    else if str_eq c "9" then succ_at (set_char s i "0") (i - 1)
    else if is_alnum c then set_char s i (chr (ord c + 1))
    else succ_at s (i - 1);
let str_succ = fn (s: str) -> if str_len s == 0 then "" else succ_at s (str_len s - 1);

// gather elements at each given index (Array#values_at); negative = from end.
let rec arr_values_at = fn (xs: Val list) -> fn (idxs: Val list) ->
  match idxs with
  | Nil -> Nil
  | Cons (VInt i, t) -> Cons (val_nth xs (if i < 0 then val_len_i xs + i else i), arr_values_at xs t)
  | Cons (_, t) -> arr_values_at xs t;

let rec val_list_of_strs = fn (ss: str list) ->
  match ss with Nil -> Nil | Cons (h, t) -> Cons (mkstr h, val_list_of_strs t);

// split a string into lines, KEEPING the trailing "\n" on each (Ruby's
// String#lines). "a\nb\n" -> ["a\n"; "b\n"], "a" -> ["a"], "" -> [].
let rec str_lines_go = fn (s: str) -> fn (start: int) -> fn (i: int) -> fn (n: int) ->
  if i >= n then (if start < n then Cons (substring s start n, Nil) else Nil)
  else if str_eq (char_at s i) "\n" then
    Cons (substring s start (i + 1), str_lines_go s (i + 1) (i + 1) n)
  else str_lines_go s start (i + 1) n;

// String#split(sep, limit): split fully then, when limited, rejoin the tail
// so at most `limit` parts result and the last keeps the remainder.
let rec strlist_len = fn (xs: str list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + strlist_len t;
let rec strlist_take = fn (xs: str list) -> fn (n: int) ->
  if n <= 0 then Nil else (match xs with Nil -> Nil | Cons (h, t) -> Cons (h, strlist_take t (n - 1)));
let rec strlist_drop = fn (xs: str list) -> fn (n: int) ->
  if n <= 0 then xs else (match xs with Nil -> Nil | Cons (_, t) -> strlist_drop t (n - 1));
let rec strlist_append = fn (xs: str list) -> fn (ys: str list) ->
  match xs with Nil -> ys | Cons (h, t) -> Cons (h, strlist_append t ys);
let split_with_limit = fn (s: str) -> fn (sep: str) -> fn (lim: int) ->
  let parts = str_split s sep in
  if lim <= 0 then parts
  else if strlist_len parts <= lim then parts
  else strlist_append (strlist_take parts (lim - 1))
         (Cons (str_join sep (strlist_drop parts (lim - 1)), Nil));

// last element / all-but-last / set element i (M10 array mutation).
let rec val_last = fn (xs: Val list) ->
  match xs with Nil -> VNil | Cons (h, t) -> (match t with Nil -> h | _ -> val_last t);
let rec val_init = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> (match t with Nil -> Nil | _ -> Cons (h, val_init t));
// past-the-end writes extend with nils (Ruby's a[5] = x on a short array).
let rec val_set_at = fn (xs: Val list) -> fn (i: int) -> fn (v: Val) ->
  match xs with
  | Nil -> if i <= 0 then Cons (v, Nil) else Cons (VNil, val_set_at Nil (i - 1) v)
  | Cons (h, t) -> if i == 0 then Cons (v, t) else Cons (h, val_set_at t (i - 1) v);

let rec val_contains = fn (xs: Val list) -> fn (v: Val) ->
  match xs with Nil -> false | Cons (h, t) -> if rb_eq h v then true else val_contains t v;

let rec val_index_of = fn (xs: Val list) -> fn (v: Val) -> fn (i: int) ->
  match xs with Nil -> VNil | Cons (h, t) -> if rb_eq h v then VInt i else val_index_of t v (i + 1);

let rec val_count_eq = fn (xs: Val list) -> fn (v: Val) ->
  match xs with Nil -> 0 | Cons (h, t) -> (if rb_eq h v then 1 else 0) + val_count_eq t v;

let rec val_uniq = fn (xs: Val list) -> fn (seen: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> if val_contains seen h then val_uniq t seen else Cons (h, val_uniq t (Cons (h, seen)));

let rec val_rev = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with Nil -> acc | Cons (h, t) -> val_rev t (Cons (h, acc));

// insertion sort by cmp_vals (stable enough for the corpus; Ruby's <=>).
let rec val_insert = fn (v: Val) -> fn (xs: Val list) ->
  match xs with
  | Nil -> Cons (v, Nil)
  | Cons (h, t) -> if cmp_vals v h <= 0 then Cons (v, xs) else Cons (h, val_insert v t);
let rec val_sort = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> val_insert h (val_sort t);

let rec val_min = fn (xs: Val list) -> fn (best: Val) ->
  match xs with Nil -> best | Cons (h, t) -> val_min t (if cmp_vals h best < 0 then h else best);
let rec val_max = fn (xs: Val list) -> fn (best: Val) ->
  match xs with Nil -> best | Cons (h, t) -> val_max t (if cmp_vals h best > 0 then h else best);

let rec val_sum = fn (xs: Val list) -> fn (acc: Val) ->
  match xs with Nil -> acc | Cons (h, t) -> val_sum t (arith_bin "+" acc h);

// hash (VHsh flat [k1,v1,k2,v2,...]) accessors.
let rec hash_keys = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (k, rest) -> (match rest with Cons (_, t) -> Cons (k, hash_keys t) | Nil -> Nil);
let rec hash_values = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (_, rest) -> (match rest with Cons (v, t) -> Cons (v, hash_values t) | Nil -> Nil);
// Hash#to_a: a list of [k, v] two-element arrays.
let rec hash_to_a = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (arr_new (Cons (k, Cons (v, Nil))), hash_to_a t) | Nil -> Nil);
let rec hash_get = fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Nil -> VNil
  | Cons (k2, rest) -> (match rest with Cons (v, t) -> if rb_eq k2 k then v else hash_get t k | Nil -> VNil);
let rec hash_haskey = fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Nil -> false
  | Cons (k2, rest) -> (match rest with Cons (_, t) -> if rb_eq k2 k then true else hash_haskey t k | Nil -> false);
let rec hash_pairs = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (arr_new (Cons (k, Cons (v, Nil))), hash_pairs t) | Nil -> Nil);
let rec hash_len = fn (xs: Val list) ->
  match xs with Nil -> 0 | Cons (_, rest) -> (match rest with Cons (_, t) -> 1 + hash_len t | Nil -> 0);
// update key k to v (in place order), or append if absent.
let rec hash_put = fn (xs: Val list) -> fn (k: Val) -> fn (v: Val) ->
  match xs with
  | Nil -> Cons (k, Cons (v, Nil))
  | Cons (k2, rest) ->
    (match rest with
     | Cons (v2, t) -> if rb_eq k2 k then Cons (k2, Cons (v, t)) else Cons (k2, Cons (v2, hash_put t k v))
     | Nil -> Cons (k, Cons (v, Nil)));
// merge other's pairs into base (other wins on conflict).
let rec hash_merge = fn (base: Val list) -> fn (other: Val list) ->
  match other with
  | Nil -> base
  | Cons (k, rest) -> (match rest with Cons (v, t) -> hash_merge (hash_put base k v) t | Nil -> base);
// merge every VHsh argument into base, left to right.
let rec hash_merge_all = fn (base: Val list) -> fn (args: Val list) ->
  match args with
  | Nil -> base
  | Cons (VHsh o, t) -> hash_merge_all (hash_merge base (hderef o)) t
  | Cons (_, t) -> hash_merge_all base t;
// swap keys and values.
let rec hash_invert = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (v, Cons (k, hash_invert t)) | Nil -> Nil);
let rec hash_has_value = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> false
  | Cons (_, rest) -> (match rest with Cons (v2, t) -> if rb_eq v2 v then true else hash_has_value t v | Nil -> false);
let rec hash_key_of = fn (xs: Val list) -> fn (v: Val) ->
  match xs with
  | Nil -> VNil
  | Cons (k, rest) -> (match rest with Cons (v2, t) -> if rb_eq v2 v then k else hash_key_of t v | Nil -> VNil);
let rec hash_values_at = fn (xs: Val list) -> fn (keys: Val list) ->
  match keys with Nil -> Nil | Cons (k, t) -> Cons (hash_get xs k, hash_values_at xs t);
// remove key k, returning the new pair list.
let rec hash_del = fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Nil -> Nil
  | Cons (k2, rest) ->
    (match rest with
     | Cons (v2, t) -> if rb_eq k2 k then t else Cons (k2, Cons (v2, hash_del t k))
     | Nil -> Nil);

// ---- printing (Ruby's to_s / inspect / puts) -----------------------------
let hex_uc_digit = fn (d: int) -> if d < 10 then chr (48 + d) else chr (65 + d - 10);
let rec hex_uc_go = fn (n: int) -> fn (acc: str) -> if n == 0 then acc else hex_uc_go (n / 16) (hex_uc_digit (n - (n / 16) * 16) ++ acc);
let hex_uc = fn (n: int) -> if n == 0 then "0" else hex_uc_go n "";
let hex4 = fn (n: int) ->
  let h = hex_uc n in
  if str_len h >= 4 then h else if str_len h == 3 then "0" ++ h else if str_len h == 2 then "00" ++ h else "000" ++ h;

// escape a string for inspect. Non-ASCII codepoints render as \uXXXX (or
// \u{...} above U+FFFF), matching ruby under an ASCII default_external.
let rec esc_str = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let c = char_at s i in
    if ord c >= 128 then
      let cp = (match utf8_cp s i with (cc, ll) -> cc) in
      let l = (match utf8_cp s i with (cc, ll) -> ll) in
      let esc = if cp > 65535 then "\\u\{" ++ hex_uc cp ++ "}" else "\\u" ++ hex4 cp in
      esc_str s (i + l) (acc ++ esc)
    else
    let piece =
      if str_eq c "\\" then "\\\\"
      else if str_eq c "\"" then "\\\""
      else if str_eq c "\n" then "\\n"
      else if str_eq c "\t" then "\\t"
      else if str_eq c "\r" then "\\r"
      else if ord c == 12 then "\\f"
      else if ord c == 11 then "\\v"
      else if ord c == 8 then "\\b"
      else if ord c == 7 then "\\a"
      else if ord c == 27 then "\\e"
      // remaining control bytes inspect as \uXXXX, as in Ruby.
      else if ord c < 32 || ord c == 127 then "\\u" ++ hex4 (ord c)
      // a literal #{ / #$ / #@ would read as interpolation: escape the #.
      else if str_eq c "#" && i + 1 < str_len s &&
              (str_eq (char_at s (i + 1)) "\{" || str_eq (char_at s (i + 1)) "$" || str_eq (char_at s (i + 1)) "@")
      then "\\#"
      else c in
    esc_str s (i + 1) (acc ++ piece);

// render a float as Ruby does, including Infinity / -Infinity / NaN.
// (NaN fails self-equality; +/-inf is unchanged by halving.)
let rb_float_str = fn (f: float) ->
  if (if f == f then false else true) then "NaN"
  else if (if f == 0.0 then false else true) && f * 0.5 == f then (if f > 0.0 then "Infinity" else "-Infinity")
  else str_of_float f;

let rec to_s = fn (v: Val) ->
  match v with
  | VInt n -> str_of_int n
  | VBig s -> s
  | VRat (n, d) -> n ++ "/" ++ d
  | VCpx (r, i) -> to_s r ++ (if num_isneg i then "-" else "+") ++ to_s (num_abs i) ++ "i"
  | VFlt f -> rb_float_str f
  | VStr s -> let s = sget s in s
  | VBool b -> if b then "true" else "false"
  | VNil -> ""
  | VArr _ -> inspect v
  | VHsh _ -> inspect v
  | VSym s -> s
  | VClass c -> c
  | VRegex (p, fl) ->
    // Regexp#to_s: "(?<on>-<off>:body)" with the m,i,x flags split by state.
    let on = (if str_contains fl "m" then "m" else "") ++ (if str_contains fl "i" then "i" else "") ++ (if str_contains fl "x" then "x" else "") in
    let off = (if str_contains fl "m" then "" else "m") ++ (if str_contains fl "i" then "" else "i") ++ (if str_contains fl "x" then "" else "x") in
    "(?" ++ on ++ (if str_eq off "" then "" else "-" ++ off) ++ ":" ++ p ++ ")"
  | VObj id -> if map_has enc_name (str_of_int id) then map_get enc_name (str_of_int id) else "#<object>"   // Encoding#to_s is its name; disp (world-aware) overrides other objects
  | VRange (lo, hi, excl) ->
    str_of_int lo ++ (if excl then "..." else "..") ++ str_of_int hi
  | VExc (_, m) -> m   // Ruby: an exception's to_s is its message
  | VMain -> "main"
  | VProc _ -> "#<Proc>"
  | VBind _ -> "#<Binding>"

and inspect = fn (v: Val) ->
  match v with
  | VStr s -> let s = sget s in "\"" ++ esc_str s 0 "" ++ "\""
  | VNil -> "nil"
  | VArr id ->
    if map_has insp_seen (str_of_int id) then "[...]"
    else
      let _ = map_set insp_seen (str_of_int id) 1 in
      let r = "[" ++ join_inspect (deref id) "" ++ "]" in
      let _ = map_delete insp_seen (str_of_int id) in
      r
  | VHsh xs -> let xs = hderef xs in "\{" ++ join_pairs xs "" ++ "}"
  | VRat (n, d) -> "(" ++ to_s v ++ ")"
  | VCpx (r, i) -> "(" ++ to_s v ++ ")"
  | VRegex (p, fl) ->
    // Regexp#inspect shows the m,i,x flags in canonical order.
    "/" ++ p ++ "/" ++ (if str_contains fl "m" then "m" else "") ++ (if str_contains fl "i" then "i" else "") ++ (if str_contains fl "x" then "x" else "")
  | VSym sy ->
    // a symbol that isn't a plain identifier / valid operator name inspects
    // quoted and escaped (:"foo bar", :"9", :"a\nb").
    if sym_plain sy then ":" ++ sy else ":\"" ++ esc_str sy 0 "" ++ "\""
  | VObj id -> if map_has enc_name (str_of_int id) then "#<Encoding:" ++ map_get enc_name (str_of_int id) ++ ">" else "#<object>"
  | VProc _ -> "#<Proc>"
  | VBind _ -> "#<Binding>"
  // an exception inspects as #<ClassName: message>.
  | VExc (c, m) -> "#<" ++ c ++ ": " ++ m ++ ">"
  | _ -> to_s v

and sym_plain = fn (sy: str) ->
  if str_len sy == 0 then false
  else if is_valid_op_sym sy then true
  else
    // optional @ / @@ / $ sigil, then an identifier (?, !, = may end it).
    let st = (if str_len sy >= 2 && str_eq (substring sy 0 2) "@@" then 2
              else if str_eq (char_at sy 0) "@" || str_eq (char_at sy 0) "$" then 1
              else 0) in
    if st >= str_len sy then false
    else if is_alpha (char_at sy st) || str_eq (char_at sy st) "_" then sym_ident_rest sy (st + 1)
    else false

and sym_ident_rest = fn (sy: str) -> fn (i: int) ->
  if i >= str_len sy then true
  else
    let c = char_at sy i in
    if is_alnum c || str_eq c "_" then sym_ident_rest sy (i + 1)
    else (str_eq c "?" || str_eq c "!" || str_eq c "=") && i + 1 == str_len sy

and is_valid_op_sym = fn (sy: str) ->
  str_eq sy "+" || str_eq sy "-" || str_eq sy "*" || str_eq sy "/" || str_eq sy "%" ||
  str_eq sy "**" || str_eq sy "==" || str_eq sy "!=" || str_eq sy "<" || str_eq sy "<=" ||
  str_eq sy ">" || str_eq sy ">=" || str_eq sy "<=>" || str_eq sy "===" || str_eq sy "=~" ||
  str_eq sy "!~" || str_eq sy "<<" || str_eq sy ">>" || str_eq sy "[]" || str_eq sy "[]=" ||
  str_eq sy "!" || str_eq sy "~" || str_eq sy "^" || str_eq sy "&" || str_eq sy "|" ||
  str_eq sy "+@" || str_eq sy "-@"

and join_inspect = fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    let piece = if str_eq acc "" then inspect h else acc ++ ", " ++ inspect h in
    join_inspect t piece

and join_pairs = fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       let pair = inspect k ++ "=>" ++ inspect v in
       let acc2 = if str_eq acc "" then pair else acc ++ ", " ++ pair in
       join_pairs t acc2
     | Nil -> acc);

// Array#join — placed after to_s (which it uses on each element).
let rec val_join = fn (xs: Val list) -> fn (sep: str) -> fn (acc: str) -> fn (first: bool) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) ->
    // Ruby joins nested arrays recursively with the same separator.
    let piece = (match h with
                 | VArr id ->
                   if map_has insp_seen (str_of_int id) then ""
                   else let _ = map_set insp_seen (str_of_int id) 1 in
                        let r = val_join (deref id) sep "" true in
                        let _ = map_delete insp_seen (str_of_int id) in r
                 | _ -> to_s h) in
    let acc2 = if first then piece else acc ++ sep ++ piece in
    val_join t sep acc2 false;

// ---- evaluator + driver (one mutual recursion) ---------------------------
// `env` is a Map[str, Val] of local variables (including "self" inside a
// method). `world` is the global object model, a 4-tuple of Maps bundled
// so a single parameter threads all of it:
//   (meths, sup, ocls, ivars)
//   meths : Map[str, Meth]  — bare name (top-level) or "Class#name"
//   sup   : Map[str, str]   — class name -> superclass name
//   ocls  : Map[str, str]   — object id (as str) -> its class name
//   ivars : Map[str, Val]   — "id@name" -> instance variable value
// (Maps cannot be put in a record/variant field without wrestling the
// region annotations, but a tuple of Maps threads cleanly — so a tuple
// is the bundle. A fresh object's id is `map_len ocls`.)
//
// Ruby method scope is FLAT: a method body sees only its parameters and
// self, never the caller's locals. Each call runs in a fresh env.
//
// `blk` is the CURRENT block (for yield), a tuple that a call installs for
// the method body it runs: (has: bool, params: str list, body: Stmt list,
// cenv: env). Blocks ARE closures — cenv is the defining scope's env map
// (shared), so a block reads and mutates the enclosing locals. "No block"
// is (false, (Nil : str list), (Nil : Stmt list), env) with any env as an unused placeholder. This is
// the counterpoint to method scope: methods are flat, blocks capture.
let rec eval_e = fn env -> fn world -> fn blk -> fn (e: Expr) ->
  match e with
  | ESplat inner -> eval_e env world blk inner   // bare splat: evaluate inner
  | EInt n -> VInt n
  | EBig b -> VBig b
  | ERat (n, d) -> mk_rat_s n d
  | EImag n -> VCpx (VInt 0, VInt n)
  | EImagF f -> VCpx (VInt 0, VFlt f)
  | EImagRat (n, d) -> VCpx (VInt 0, mk_rat_s n d)
  | EFlt f -> VFlt f
  | EStrL s -> (let v = mkstr s in
                // a string literal's encoding is the source file's encoding
                // (from its magic comment); default UTF-8.
                let _ = (match v with
                         | VStr id -> senc_set id (if map_has load_ctx "coding" then (match map_get load_ctx "coding" with VStr c -> let c = sget c in c | _ -> "UTF-8") else "UTF-8")
                         | _ -> ()) in
                (if fsl_on () then (match v with VStr id -> let _ = sfrozen_set id in v | _ -> v) else v))
  | EBool b -> VBool b
  | ENil -> VNil
  | ESym s -> VSym s
  | ESelf -> if map_has env "self" then map_get env "self" else VNil
  | EConst name ->
    // scoped `A::B` keeps its existing handling; a bare `Const` resolves
    // through the lexical scope (cref) first, then top level.
    if str_contains name "::" then
      (if map_has consts name then map_get consts name
       else
         let rc = recv_of_scoped name in
         let cn = const_of_scoped name in
         // top-level constants live in Object's namespace, so Object::X reads
         // the bare top-level X.
         if str_eq rc "Object" && map_has consts cn then map_get consts cn
         else if has_meth world rc "const_missing" then
           invoke_val_c env world blk (VClass rc) "const_missing" (Cons (VSym cn, Nil)) false
         else raise_exc world "NameError" ("uninitialized constant " ++ name))
    else
      let cref = (if map_has env "__cref" then (match map_get env "__cref" with VStr s -> sget s | _ -> "") else cur_lex ()) in
      // walk the full lexical nesting (M::Base -> M -> top), not just one level.
      let key = lex_const_key cref name in
      if (if str_eq key "" then false else true) then map_get consts key
      else if map_has consts name then map_get consts name
      else raise_exc world "NameError" ("uninitialized constant " ++ name)
  | EConstOrNil name -> if map_has consts name then map_get consts name else VNil
  | EScopedRead (recv_e, cn) ->
    (match eval_e env world blk recv_e with
     | VClass c ->
       let key = c ++ "::" ++ cn in
       if map_has consts key then map_get consts key
       else if map_has consts cn then map_get consts cn
       else raise_exc world "NameError" ("uninitialized constant " ++ cn)
     // `obj::CONST` where obj is not a class/module is a TypeError (Ruby).
     | other -> raise_exc world "TypeError" (inspect other ++ " is not a class/module"))
  | EScopedReadOrNil (recv_e, cn) ->
    (match eval_e env world blk recv_e with
     | VClass c -> let key = c ++ "::" ++ cn in
       (if map_has consts key then map_get consts key
        else if map_has consts cn then map_get consts cn else VNil)
     | _ -> VNil)
  | EScopedAssign (recv_e, cn, val_e) ->
    let rv = eval_e env world blk recv_e in
    let v = eval_e env world blk val_e in
    (match rv with
     | VClass c -> let _ = map_set consts (c ++ "::" ++ cn) v in v
     | _ -> raise_exc world "TypeError" (inspect rv ++ " is not a class/module"))
  | EIVar name ->
    let (meths, sup, ocls, ivars) = world in
    // a name still starting with @ is a class variable (@@x).
    if str_len name > 0 && str_eq (char_at name 0) "@" then
      cvar_get env world (substring name 1 (str_len name))
    else
    if map_has env "self" then
      (match map_get env "self" with
       | VObj id ->
         let k = str_of_int id ++ "@" ++ name in
         if map_has ivars k then map_get ivars k else VNil
       | VMain ->
         let k = "main@" ++ name in
         if map_has ivars k then map_get ivars k else VNil
       | VClass c ->
         let k = "cls:" ++ c ++ "@" ++ name in
         if map_has ivars k then map_get ivars k else VNil
       | _ -> VNil)
    else VNil
  // the flip-flop operator: off -> the left condition may switch it on;
  // on -> the right condition may switch it off. `...` (exclusive) skips
  // the right condition on the switching-on iteration; `..` checks it at
  // once (a single-element range fires exactly one iteration).
  | EFlipFlop (site, c1, c2, excl) ->
    let key = str_of_int site in
    let on = (match map_get ff_state key with VBool b -> b | _ -> false) in
    if on then
      let v2 = eval_e env world blk c2 in
      let _ = if truthy v2 then map_set ff_state key (VBool false) else () in
      VBool true
    else
      let v1 = eval_e env world blk c1 in
      if truthy v1 then
        let _ = map_set ff_state key (VBool true) in
        let _ = (if excl then ()
                 else
                   let v2 = eval_e env world blk c2 in
                   if truthy v2 then map_set ff_state key (VBool false) else ()) in
        VBool true
      else VBool false
  | EAmbigIdx (name, items) ->
    if map_has env name then eval_e env world blk (EMethod (EVar name, "[]", items))
    else eval_e env world blk (ECall (name, Cons (EArr items, Nil)))
  | ERange (loe, hie, excl) ->
    (match eval_e env world blk loe with
     | VInt lo ->
       (match eval_e env world blk hie with
        | VInt hi -> VRange (lo, hi, excl)
        | _ -> fail "mere-ruby: range bounds must be integers")
     // a string range materializes as the array of successive chars
     // (single-char bounds; enough for ('a'..'z') iteration).
     | VStr slo -> let slo = sget slo in
       (match eval_e env world blk hie with
        | VStr shi -> let shi = sget shi in
          let last = ord (char_at shi 0) - (if excl then 1 else 0) in
          arr_new (char_range (ord (char_at slo 0)) last)
        | _ -> fail "mere-ruby: range bounds must be integers")
     // a Time range collapses to its endpoints' ordinals (used for membership,
     // e.g. `(Time.new(2010)..Time.new(2020)) === some_time`).
     | VObj lid ->
       (match eval_e env world blk hie with
        | VObj hid -> VRange (time_ord_of world (VObj lid), time_ord_of world (VObj hid), excl)
        | _ -> fail "mere-ruby: range bounds must be integers")
     | _ -> fail "mere-ruby: range bounds must be integers")
  | ETern (cond, then_e, else_e) ->
    if truthy (eval_e env world blk cond) then eval_e env world blk then_e
    else eval_e env world blk else_e
  | ECaseNone -> VNil   // only meaningful as an SCase subject marker
  | EDefined e ->
    (match e with
     | ENil -> mkstr "nil"
     | EBool b -> if b then mkstr "true" else mkstr "false"
     | EBin (_, _, _) -> mkstr "method"   // operators are method calls
     | EUn (_, _) -> mkstr "method"
     | ESelf -> mkstr "self"
     | EVar name ->
       // keyword literals reach here as bare names inside defined?(...).
       if str_eq name "nil" then mkstr "nil"
       else if str_eq name "true" then mkstr "true"
       else if str_eq name "false" then mkstr "false"
       else if str_eq name "self" then mkstr "self"
       // `defined?(yield)` / `defined?(super)` reach here as bare words (the
       // word precedes the closing paren). yield is defined iff a block was
       // given; super iff the current method has an ancestor definition.
       else if str_eq name "yield" then (let (has, _, _, _) = blk in if has then mkstr "yield" else VNil)
       else if str_eq name "super" then
         (let (m2, s2, o2, i2) = world in
          let defcls = (match (if map_has env "__defcls" then map_get env "__defcls" else VNil) with VClass c -> c | _ -> "") in
          let meth = (match (if map_has env "__meth" then map_get env "__meth" else VNil) with VStr s -> sget s | _ -> "") in
          if str_eq defcls "" || str_eq meth "" then VNil
          else if (let sc = (if map_has s2 defcls then map_get s2 defcls else "Object") in has_meth world sc meth) then mkstr "super"
          else VNil)
       // $globals and @/@@-prefixed names have their own categories.
       else if str_len name > 0 && str_eq (char_at name 0) "$" then
         (let k = substring name 1 (str_len name) in
          if str_len k == 1 && k >= "1" && k <= "9" then
            (if map_has globals k && truthy (map_get globals k) then mkstr "global-variable" else VNil)
          else if map_has globals k then mkstr "global-variable" else VNil)
       else if str_len name >= 2 && str_eq (substring name 0 2) "@@" then
         let (m2, s2, o2, iv2) = world in
         (if map_has cvars (cvar_cls env world ++ "@" ++ substring name 2 (str_len name)) then mkstr "class variable" else VNil)
       else if str_len name > 0 && str_eq (char_at name 0) "@" then
         let (m2, s2, o2, ivars2) = world in
         let iv = substring name 1 (str_len name) in
         (match map_get env "self" with
          | VObj id -> if map_has ivars2 (str_of_int id ++ "@" ++ iv) then mkstr "instance-variable" else VNil
          | VMain -> if map_has ivars2 ("main@" ++ iv) then mkstr "instance-variable" else VNil
          | VClass c -> if map_has ivars2 ("cls:" ++ c ++ "@" ++ iv) then mkstr "instance-variable" else VNil
          | _ -> VNil)
       else if is_upper_first name then
         (if map_has consts name then mkstr "constant" else VNil)
       else if map_has env name then mkstr "local-variable"
       else if is_method_defined env world name || is_kernel_builtin name then mkstr "method"
       else VNil
     | ECall (name, _) -> if is_method_defined env world name || is_kernel_builtin name then mkstr "method" else VNil
     | ECallB (name, _, _, _) -> if is_method_defined env world name || is_kernel_builtin name then mkstr "method" else VNil
     | EIVar name ->
       let (meths, sup, ocls, ivars) = world in
       (match map_get env "self" with
        | VObj id -> if map_has ivars (str_of_int id ++ "@" ++ name) then mkstr "instance-variable" else VNil
        | VMain -> if map_has ivars ("main@" ++ name) then mkstr "instance-variable" else VNil
        | VClass c -> if map_has ivars ("cls:" ++ c ++ "@" ++ name) then mkstr "instance-variable" else VNil
        | _ -> VNil)
     | EConst name -> if map_has consts name then mkstr "constant" else VNil
     | EMethod (recv, name, _) ->
       let (meths, sup, ocls, ivars) = world in
       // evaluating the receiver may raise (undefined var); defined? is nil.
       // A throw/break/next in the receiver, however, escapes normally.
       let rv = defined_eval_recv env world blk recv in
       if (match rv with VSym m -> str_eq m "__mere_defined_fail__" | _ -> false) then VNil else
       (match rv with
        | VObj id ->
          let cls = map_get ocls (str_of_int id) in
          if has_meth world cls name &&
             (if meth_private world cls name then false
              else if meth_protected world cls name then protected_ok env world cls
              else true)
          then mkstr "method" else VNil
        | VClass c -> if str_eq name "new" || has_meth world c name || has_meth world ("(sng:" ++ c ++ ")") name then mkstr "method" else VNil
        | _ -> mkstr "method")
     | EScopedRead (recv, cn) ->
       // defined?(recv::Const): the receiver may raise or be a non-class
       // (e.g. `a::B` where a() returns nil) — then the const is undefined.
       let rv = defined_eval_recv env world blk recv in
       if (match rv with VSym m -> str_eq m "__mere_defined_fail__" | _ -> false) then VNil
       else (match rv with
             | VClass c -> if map_has consts (c ++ "::" ++ cn) then mkstr "constant" else VNil
             | _ -> VNil)
     | EYield _ -> let (has, _, _, _) = blk in if has then mkstr "yield" else VNil
     | _ -> mkstr "expression")   // literals, operators, ranges, ternary, etc.
  | ESuper (zsuper, arges) ->
    let (meths, sup, ocls, ivars) = world in
    let defcls = (match map_get env "__defcls" with VClass c -> c | _ -> "") in
    let meth = (match map_get env "__meth" with VStr s -> let s = sget s in s | _ -> "") in
    let recv = if map_has env "self" then map_get env "self" else VMain in
    // a bare (implicit-args) `super` from a define_method-defined method has no
    // fixed argument list to forward, so Ruby raises RuntimeError.
    if zsuper && map_has dm_methods (defcls ++ "#" ++ meth) then
      raise_exc world "RuntimeError" "implicit argument passing of super from method defined by define_method() is not supported. Specify all arguments explicitly."
    else
    // `super(args, &block)` / `super(args, &nil)` forwards an explicit block
    // (nil = no block); otherwise super passes along the current block.
    let (arges, superblk) =
      (match rev_app arges Nil with
       | Cons (EBlockPass be, rrest) -> (rev_app rrest Nil, coerce_to_block env world blk (eval_e env world blk be))
       | _ -> (arges, blk)) in
    // zsuper forwards the CURRENT parameter values (defaults applied,
    // splat expanded), not the original call arguments.
    let args = if zsuper then
                 (if map_has env "__params" then
                    (match map_get env "__params" with
                     | VArr pid -> zsuper_all env (deref pid)
                     | _ -> (match map_get env "__args" with VArr id -> deref id | _ -> Nil))
                  else (match map_get env "__args" with VArr id -> deref id | _ -> Nil))
               else eval_args env world blk arges in
    // resume the method search in the receiver's ancestor chain, strictly
    // after the class/module the current method is defined in — so super walks
    // included modules too. A singleton-class defcls uses the singleton chain.
    if is_sng_cls defcls then
      (let supercls = sng_supername world defcls in
       if has_meth world supercls meth then invoke world superblk recv supercls meth args
       else raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'"))
    else
      (let a2 = lookup_anc world (anc_after (ancestors_of world (super_base world recv)) defcls) meth in
       if str_eq a2 "" then super_missing world superblk recv meth args
       else run_meth world superblk recv a2 meth (map_get meths (a2 ++ "#" ++ meth)) args)
  | ESuperB (zsuper, arges, bp, bb) ->
    let (meths, sup, ocls, ivars) = world in
    let defcls = (match map_get env "__defcls" with VClass c -> c | _ -> "") in
    let meth = (match map_get env "__meth" with VStr s -> let s = sget s in s | _ -> "") in
    let recv = if map_has env "self" then map_get env "self" else VMain in
    let args = if zsuper then
                 (if map_has env "__params" then
                    (match map_get env "__params" with
                     | VArr pid -> zsuper_all env (deref pid)
                     | _ -> (match map_get env "__args" with VArr id -> deref id | _ -> Nil))
                  else (match map_get env "__args" with VArr id -> deref id | _ -> Nil))
               else eval_args env world blk arges in
    if is_sng_cls defcls then
      (let supercls = sng_supername world defcls in
       if has_meth world supercls meth then invoke world (true, bp, bb, env) recv supercls meth args
       else raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'"))
    else
      (let a2 = lookup_anc world (anc_after (ancestors_of world (super_base world recv)) defcls) meth in
       if str_eq a2 "" then super_missing world (true, bp, bb, env) recv meth args
       else run_meth world (true, bp, bb, env) recv a2 meth (map_get meths (a2 ++ "#" ++ meth)) args)
  | EBlockPass e -> eval_e env world blk e   // non-&:sym block-pass: best effort
  | EAssign (name, e) ->
    let v = eval_e env world blk e in
    let _ = if str_len name > 0 && str_eq (char_at name 0) "$"
            then map_set globals (substring name 1 (str_len name)) v
            else if str_len name > 0 && str_eq (char_at name 0) "@"
            then assign_one env world name v
            else if is_upper_first name then (let _ = map_set consts name v in name_anon name v)
            else map_set env name v in
    v
  | ELambda (ps, body) ->
    let id = map_len proc_store in
    let _ = map_set proc_store (str_of_int id) (true, ps, body, env) in
    let _ = if (let (h, _, _, _) = blk in h) then map_set proc_yblk (str_of_int id) blk else () in
    let _ = map_set lambda_ids (str_of_int id) VNil in
    VProc id
  | EStmt s ->
    // a statement in expression position: FNext yields the value; escaping
    // flows unwind as signals so the enclosing loop/method converts them.
    (match exec_stmt env world blk s with
     | FNext v -> v
     | FBreak v -> flow_throw "break" v
     | FLoopNext v -> flow_throw "next" v
     | FReturn v -> flow_throw "return" v
     | FRaise v -> v)
  | EMatchTest (e, pat) ->
    let v = eval_e env world blk e in
    if pat_match env world blk pat v then VBool true else VBool false
  | EMatchBind (e, pat) ->
    let v = eval_e env world blk e in
    let _ = if pat_match env world blk pat v then () else (let _ = raise_exc world "NoMatchingPatternError" (inspect v) in ()) in
    VNil
  | EFlow (kind, e) ->
    let v = eval_e env world blk e in
    flow_throw kind v
  | ESafeB (recv_e, name, arges, bp, bb) ->
    let recv = eval_e env world blk recv_e in
    (match recv with
     | VNil -> VNil
     | _ ->
       let args = eval_args env world blk arges in
       invoke_with_block env world blk recv name args (true, bp, bb, env))
  | ESafe (recv_e, name, arges) ->
    (match eval_e env world blk recv_e with
     | VNil -> VNil
     | recv ->
       let args = eval_args env world blk arges in
       let r = invoke_val_c env world blk recv name args true in
       // an attribute-writer (`recv&.foo = v`) yields the assigned value.
       if is_setter_name name then (match rev_app args Nil with Cons (v, _) -> v | _ -> r) else r)
  | ERegex p -> VRegex p
  | EYield arges ->
    let args = eval_args env world blk arges in
    let (has, bparams, bbody, cenv) = blk in
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    // `break` inside the yielded block terminates the method the block was
    // passed to. For a literal block that is this method; for a block forwarded
    // here via `&proc` it is the block's home frame (recorded in __blk_home).
    // Re-signal as a targeted break-return so it unwinds to that frame's method
    // boundary (running any intervening ensure blocks). If the home method has
    // already returned, that is a LocalJumpError.
    if has then (match run_block world noblk blk args with
                 | FBreak v ->
                     let target = (if map_has env "__blk_home" then map_get env "__blk_home"
                                   else if map_has env "__fid" then map_get env "__fid" else VInt 0) in
                     let tk = (match target with VInt t -> str_of_int t | _ -> "") in
                     if str_eq tk "" || (if map_has live_frames tk then false else true)
                     then raise_exc world "LocalJumpError" "break from proc-closure"
                     else flow_throw_breakret (match target with VInt t -> t | _ -> 0) v
                 | other -> flow_value other)
    else raise_exc world "LocalJumpError" "no block given (yield)"
  | ERaise arges ->
    let (meths, sup, ocls, ivars) = world in
    let argvals = eval_args env world blk arges in
    // bare `raise` inside a rescue re-raises the current exception ($!).
    let exc = (match argvals with
               | Nil -> (if map_has globals "!" && (match map_get globals "!" with VNil -> false | _ -> true) then map_get globals "!" else make_exc_w world Nil)
               | _ -> make_exc_w world argvals) in
    // stash the exception, then unwind via Mere's fail to the nearest
    // begin/rescue (which reads it back from "$exc").
    let _ = map_set ivars "$exc" exc in
    fail "mere-ruby: (ruby exception raised)"
  | EVar name ->
    if str_eq name "__FILE__" then (let v = mkstr (script_file ()) in (if fsl_on () then (match v with VStr id -> let _ = sfrozen_set id in v | _ -> v) else v))
    // __LINE__: the lexer does not track source lines, so this is a placeholder
    // (0). It keeps fixtures/specs that merely mention __LINE__ from crashing;
    // any spec that asserts on the actual line will still DIFF under byte-match.
    else if str_eq name "__LINE__" then VInt 0
    // __ENCODING__ was captured at parse time as "__ENCODING__~<NAME>";
    // resolve to the identity Encoding object (BINARY aliases ASCII-8BIT).
    else if str_len name >= 12 && str_eq (substring name 0 12) "__ENCODING__" then
      (let nm = (if str_len name > 13 then str_upcase (substring name 13 (str_len name)) else "UTF-8") in
       let nm2 = (if str_eq nm "BINARY" then "ASCII-8BIT" else nm) in
       if map_has enc_objs nm2 then map_get enc_objs nm2
       else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else mkstr nm2)
    else if str_eq name "block_given?" then (let (has, _, _, _) = blk in VBool has)
    else if str_len name > 0 && str_eq (char_at name 0) "$" then
      (let k = substring name 1 (str_len name) in if map_has globals k then map_get globals k else VNil)
    else
    let (meths, sup, ocls, ivars) = world in
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    if map_has env name then map_get env name
    else if map_has meths name then call_method env world noblk name Nil
    // Kernel#local_variables: the locals visible in the current scope.
    else if str_eq name "local_variables" then local_vars_of env
    // Kernel#binding: capture the current locals env (which holds "self").
    else if str_eq name "binding" then
      let id = map_len bind_store in
      let _ = map_set bind_store (str_of_int id) (map_copy env) in
      VBind id
    else try_self_call env world name Nil
  | ECall (name, arges) ->
    let (meths, sup, ocls, ivars) = world in
    // a paren-less call with a trailing `&expr` block-pass (`send :m, :a, &pr`)
    // routes through the block-call path, exactly like the parenthesized form
    // (otherwise the proc would be passed as a positional argument).
    if (match rev_app arges Nil with Cons (EBlockPass _, _) -> true | _ -> false) then
      (match rev_app arges Nil with
       | Cons (EBlockPass be, rrest) ->
         eval_e env world blk (ECallB (name, rev_app rrest Nil, Cons ("&coerce", Nil), Cons (SExpr be, Nil)))
       | _ -> VNil)
    else
    // `refine X.singleton_class do...end` mis-parses: the do-block binds to the
    // inner `.singleton_class` (an EMethodB), leaving refine block-less. Recover
    // it — the refined target is the method call without the block, and the
    // block body is the refine body. (Scoped to refine to avoid a general
    // do-block precedence change.)
    if str_eq name "refine" && (match map_get env "self" with VClass _ -> true | _ -> false) && (match arges with Cons (EMethodB (_, _, _, _, _), Nil) -> true | _ -> false) then
      (match arges with
       | Cons (EMethodB (mrecv, mm, margs, mbp, mbb), Nil) ->
         (match eval_e env world blk (EMethod (mrecv, mm, margs)) with
          | VClass tcls -> do_refine world (match map_get env "self" with VClass rc -> rc | _ -> "") tcls mbb
          | _ -> VNil)
       | _ -> VNil)
    else
    let args = eval_args env world blk arges in
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    // Kernel conversion functions: Integer()/Float()/String()/Array()/
    // Rational()/Complex()/Hash().
    if str_eq name "Integer" then
      (match args with
       | Cons (VInt n, _) -> VInt n
       | Cons (VBig s, _) -> VBig s
       | Cons (VFlt f, _) -> VInt (int_of_float f)
       | Cons (VRat (n, d), _) -> norm_big (big_div_s n d)
       | Cons (VStr s, Cons (VInt base, _)) -> VInt (str_to_int_base (sget s) base)
       | Cons (VStr s, _) -> let s = sget s in
         (match try_or (fn (u: unit) -> VInt (int_of_str s)) (VSym "__int_fail__") with
          | VSym m -> if str_eq m "__int_fail__" then raise_exc world "ArgumentError" ("invalid value for Integer(): \"" ++ s ++ "\"") else VInt (int_of_str s)
          | r -> r)
       | _ -> raise_exc world "TypeError" "can't convert to Integer")
    else if str_eq name "Float" then (match args with Cons (VStr s, _) -> VFlt (float_of_str (sget s)) | Cons (v, _) -> VFlt (to_f v) | _ -> VFlt 0.0)
    else if str_eq name "String" then (match args with Cons (v, _) -> mkstr (to_s v) | _ -> mkstr "")
    else if str_eq name "Rational" then
      (match args with Cons (a, Cons (b, _)) -> mk_rat_s (num_dec a) (num_dec b) | Cons (a, _) -> mk_rat_s (num_dec a) "1" | _ -> mk_rat_s "0" "1")
    else if str_eq name "Complex" then
      (match args with Cons (r, Cons (i, _)) -> VCpx (r, i) | Cons (r, _) -> VCpx (r, VInt 0) | _ -> VCpx (VInt 0, VInt 0))
    else if str_eq name "Array" then
      (match args with Cons (VArr id, _) -> VArr id | Cons (VNil, _) -> arr_new Nil | Nil -> arr_new Nil | Cons (v, _) -> arr_new (Cons (v, Nil)))
    else if str_eq name "Hash" then
      (match args with Cons (VHsh h, _) -> VHsh h | _ -> mkhash Nil)
    // using refinery — activate the refinery's refinements into ref_active.
    // The scope is bounded by the enclosing module/class body (register_class
    // save/restores ref_active), matching Ruby's lexical activation.
    else if str_eq name "using" && (match args with Cons (VClass _, _) -> true | _ -> false) then
      (let refinery = (match args with Cons (VClass r, _) -> r | _ -> "") in
       let n = (if map_has refine_cnt refinery then (match map_get refine_cnt refinery with VInt k -> k | _ -> 0) else 0) in
       let _ = activate_refinements refinery 0 n in
       VNil)
    // Kernel#binding: capture the current locals env (which holds "self")
    // as a first-class Binding, unless the user redefined `binding`.
    else if str_eq name "binding" && (if map_has meths "binding" then false else true) then
      let id = map_len bind_store in
      let _ = map_set bind_store (str_of_int id) (map_copy env) in
      VBind id
    // eval "code" re-enters the interpreter. With a Binding 2nd arg it runs
    // against that captured env; otherwise it uses the CURRENT env. A parse
    // failure surfaces as a catchable SyntaxError.
    else if str_eq name "eval" then do_eval env world blk args
    // __ruby_exe("code"): run the snippet at a fresh top level (fresh locals,
    // self=main; classes/consts/globals shared) with stdout captured, and
    // return the captured output. The mspec shim's ruby_exe delegates here —
    // an in-process approximation of mspec's real subprocess ruby_exe.
    else if str_eq name "__ruby_exe" then
      (match args with
       | Cons (VStr h, _) -> let code = sget h in
         let had_on = map_has io_cap "on" in
         let saved_buf = (if map_has io_cap "buf" then map_get io_cap "buf" else mkstr "") in
         let _ = map_set io_cap "on" (VBool true) in
         let _ = map_set io_cap "buf" (mkstr "") in
         let fenv = map_new () in
         let _ = map_set fenv "self" VMain in
         // the snippet runs at its own top level: reset the lexical scope (a
         // prior snippet that crashed mid-body could leave a stale cref) and
         // restore it afterwards so class names resolve as top-level.
         let saved_lex = cur_lex () in
         let _ = set_lex "" in
         let _ = try_or (fn (u: unit) -> let _ = do_eval fenv world noblk (Cons (mkstr code, Nil)) in VNil) VNil in
         let _ = set_lex saved_lex in
         let out = (match map_get io_cap "buf" with VStr b -> sget b | _ -> "") in
         let _ = if had_on then map_set io_cap "buf" saved_buf else map_delete io_cap "on" in
         mkstr out
       | _ -> mkstr "")
    // `ruby2_keywords :m` (or `ruby2_keywords def m ... end`, whose def
    // returns :m): mark method m so it keeps a `key:` hash's kwarg-ness.
    else if str_eq name "ruby2_keywords" && (if map_has meths name then false else true) then
      (let _ = (match args with Cons (VSym s, _) -> map_set r2k_methods s VNil | _ -> ()) in
       (match args with Cons (a, _) -> a | _ -> VNil))
    else if str_eq name "local_variables" && (if map_has meths name then false else true) then local_vars_of env
    else if map_has meths name then call_method env world noblk name args
    else if str_eq name "throw" && (if map_has meths "throw" then false else true) then
      (match args with
       | Cons (t, rest) ->
         let v = (match rest with Cons (v2, _) -> v2 | Nil -> VNil) in
         let d = (if map_has catch_depth "n" then (match map_get catch_depth "n" with VInt dn -> dn | _ -> 0) else 0) in
         if catch_tag_active t d then flow_rethrow_tagged "throw" t v
         else raise_exc world "UncaughtThrowError" ("uncaught throw " ++ inspect t)
       | _ -> fail "mere-ruby: throw expects a tag")
    // Kernel#p: inspect-print each arg; returns the value (or array).
    // `cmd` command literal → the ` method. mere cannot spawn a subprocess, so
    // the default returns "" unless self (or the top level) defines its own `.
    else if str_eq name "`" && (if map_has meths "`" then false else true)
            && (if map_has env "self" then
                  (match map_get env "self" with
                   | VObj id -> let (mm, sp, ocls, iv) = world in (if has_meth world (map_get ocls (str_of_int id)) "`" then false else true)
                   | _ -> true)
                else true) then
      mkstr ""
    else if str_eq name "p" || str_eq name "pp" then
      let _ = p_print args in
      (match args with Nil -> VNil | Cons (v, Nil) -> v | _ -> arr_new args)
    // Kernel#print: write each arg's to_s (no separators, no newline).
    else if str_eq name "print" && (if map_has meths "print" then false else true) then
      let _ = print_each world args in VNil
    // Kernel#warn: writes to stderr, which stdout byte-comparison never sees,
    // so a no-op is output-equivalent (and avoids a NoMethodError crash).
    else if str_eq name "warn" && (if map_has meths "warn" then false else true) then VNil
    // Kernel#format / #sprintf: sprintf-style formatting.
    else if (str_eq name "format" || str_eq name "sprintf") && (if map_has meths name then false else true) then
      (match args with Cons (VStr h, rest) -> mkstr (rb_format (sget h) rest) | _ -> mkstr "")
    // implicit-self send/__send__/public_send: dispatch the named method on self.
    else if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send") && (if map_has meths name then false else true) then
      (let recv = if map_has env "self" then map_get env "self" else VMain in
       let vis = str_eq name "public_send" in
       match args with
       | Cons (VSym m, rest) -> if str_eq m "eval" then do_eval env world blk rest else invoke_val_c env world blk recv m rest vis
       | Cons (VStr m, rest) -> let m = sget m in (if str_eq m "eval" then do_eval env world blk rest else invoke_val_c env world blk recv m rest vis)
       | _ -> fail "mere-ruby: send expects a method name")
    // enum_for(:m) / to_enum(:m): an Enumerator that drives self.m on #each.
    else if (str_eq name "enum_for" || str_eq name "to_enum") && (if map_has meths name then false else true) then
      (let recv = if map_has env "self" then map_get env "self" else VMain in
       match args with
       | Cons (VSym m, _) -> make_enum world recv m
       | Cons (VStr m, _) -> make_enum world recv (sget m)
       | _ -> make_enum world recv "each")
    else try_self_call_x env world name args true
  | ECallB (name, arges, bp, bb) ->
    let (meths, sup, ocls, ivars) = world in
    let args = eval_args env world blk arges in
    let newblk = (match bp with
                  | Cons (c, Nil) -> if str_eq c "&coerce" then coerce_to_block env world blk (match bb with Cons (SExpr be, _) -> eval_e env world blk be | _ -> VNil) else (true, bp, bb, env)
                  | _ -> (true, bp, bb, env)) in
    // Kernel#loop: run the block until break (or a StopIteration raise).
    if str_eq name "loop" && (if map_has meths "loop" then false else true) then
      run_loop_builtin env world blk (true, bp, bb, env)
    // catch(:tag) { ... throw :tag, v ... } via the flow-signal unwind.
    else if str_eq name "catch" && (if map_has meths "catch" then false else true) then
      (let tag = (match args with Cons (t, _) -> t | _ -> VNil) in
       let d0 = (if map_has catch_depth "n" then (match map_get catch_depth "n" with VInt dn -> dn | _ -> 0) else 0) in
       let _ = map_set catch_depth "n" (VInt (d0 + 1)) in
       let _ = map_set catch_depth ("t" ++ str_of_int (d0 + 1)) tag in
       let f = try_or (fn (u: unit) -> run_block world blk (true, bp, bb, env) Nil) (FRaise VNil) in
       let _ = map_set catch_depth "n" (VInt d0) in
       (match f with
        | FRaise _ ->
          if map_has flow_sig "k" then
            let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
            let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
            let tg = (if map_has flow_sig "tag" then map_get flow_sig "tag" else VNil) in
            let _ = map_delete flow_sig "k" in
            if str_eq k "throw" && rb_eq tg tag then v
            else flow_rethrow_tagged k tg v
          else fail "mere-ruby: (ruby exception raised)"
        | other -> flow_value other))
    // proc { } / lambda { } capture the block as a first-class VProc.
    else if str_eq name "proc" || str_eq name "lambda" then
      (let id = map_len proc_store in
       let _ = map_set proc_store (str_of_int id) (true, bp, bb, env) in
       let _ = if (let (h, _, _, _) = blk in h) then map_set proc_yblk (str_of_int id) blk else () in
       let _ = if str_eq name "lambda" then map_set lambda_ids (str_of_int id) VNil else () in
       VProc id)
    // define_method(:name) { ... } as a genuine method call (self is a class):
    // register the passed block as an instance method. Works when reached
    // from inside another method (e.g. a Module helper forwarding &block),
    // not just as a literal class-body statement.
    else if str_eq name "define_method" && map_has env "self" && (match map_get env "self" with VClass _ -> true | _ -> false) then
      (match map_get env "self" with
       | VClass c ->
         let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr s, _) -> sget s | _ -> "") in
         let (_, ps2, bb2, _) = newblk in
         let _ = map_set meths (c ++ "#" ++ nm) (Meth (ps2, Nil, bb2)) in
         let _ = map_set dm_methods (c ++ "#" ++ nm) VNil in
         // capture the block active here so a `yield` in the defined method
         // reaches it (Ruby's define_method closure semantics).
         let _ = (match blk with
                  | (true, _, _, _) -> let pid = map_len proc_store in
                    let _ = map_set proc_store (str_of_int pid) blk in
                    map_set dm_captured (c ++ "#" ++ nm) (VProc pid)
                  | _ -> if map_has dm_captured (c ++ "#" ++ nm) then map_delete dm_captured (c ++ "#" ++ nm) else ()) in
         VSym nm
       | _ -> VNil)
    // refine Target do <defs> end — inside a Module.new body (self is the
    // refinery module). Run the block's defs into a fresh impl class and record
    // the (refinery, target, impl) triple for a later `using`.
    else if str_eq name "refine" && (match args with Cons (VClass _, _) -> true | _ -> false) && (match map_get env "self" with VClass _ -> true | _ -> false) then
      (let refinery = (match map_get env "self" with VClass rc -> rc | _ -> "") in
       let target = (match args with Cons (VClass t, _) -> t | _ -> "") in
       do_refine world refinery target bb)
    else if map_has meths name then call_method env world newblk name args
    // bare method(:name) — Kernel#method on the implicit self.
    else if str_eq name "method" && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
      invoke_val_c env world newblk (if map_has env "self" then map_get env "self" else VMain) "method" args false
    // implicit self: a bare `each { }` inside a method is `self.each { }`.
    else if map_has env "self" then
      (match map_get env "self" with
       | VObj id ->
         let cls = map_get ocls (str_of_int id) in
         if has_meth world cls name then invoke world newblk (VObj id) cls name args
         else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "'")
       // inside a class method, a bare call with a block is self.name { }.
       | VClass c ->
         // a bare block call inside a class method is `self.name { }`; route
         // through the receiver dispatcher so builtins (module_eval/class_eval/
         // new/...) and Module/Class fallbacks all apply, not just own methods.
         invoke_with_block env world blk (VClass c) name args newblk
       // implicit self-send on a primitive: honour a subclass tag (own method
       // or alias-to-builtin) before falling back to the base primitive class.
       | other ->
         let hk = hng_key other in
         let tagged = if str_eq hk "" then false else map_has hng_store hk in
         let tagcls = if tagged then map_get hng_store hk else "" in
         if tagged && has_meth world tagcls name then invoke world newblk other tagcls name args
         else if tagged && (if str_eq (blt_alias_lookup world (ancestors_of world tagcls) name) "" then false else true) then
           (let src = blt_alias_lookup world (ancestors_of world tagcls) name in
            match args with
            | Cons (arg, _) -> if is_binary_op_name src then arith_bin src other arg else prim_method other src args
            | Nil -> prim_method other src args)
         else
           let pcls = class_name other in
           if has_meth world pcls name then invoke world newblk other pcls name args
           else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "'"))
    else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "'")
  // recv.name op= rhs — evaluate recv once (bound to a temp), then read/op/
  // write the attribute through the normal method dispatch.
  | EAttrOp (recv_e, name, op, rhs_e) ->
    let r = eval_e env world blk recv_e in
    let e2 = map_copy env in
    let _ = map_set e2 "__opr" r in
    // self-receiver keeps ESelf so private accessors stay reachable (self is
    // side-effect-free, so evaluating it twice is harmless).
    let rx = (match recv_e with ESelf -> ESelf | _ -> EVar "__opr") in
    let cur = eval_e e2 world blk (EMethod (rx, name, Nil)) in
    if str_eq op "||" then
      (if truthy cur then cur
       else let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, name ++ "=", Cons (EVar "__opv", Nil))))
    else if str_eq op "&&" then
      (if truthy cur then (let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, name ++ "=", Cons (EVar "__opv", Nil)))) else cur)
    else
      let v = eval_e env world blk rhs_e in
      let _ = map_set e2 "__opv" (apply_bin_vals world blk op cur v) in
      eval_e e2 world blk (EMethod (rx, name ++ "=", Cons (EVar "__opv", Nil)))
  // recv[idx..] op= rhs — evaluate recv and the indices once (bound to temps).
  | EIdxOp (recv_e, idx_es, op, rhs_e) ->
    let r = eval_e env world blk recv_e in
    let idxs = eval_args env world blk idx_es in
    let e2 = map_copy env in
    let _ = map_set e2 "__opr" r in
    let rx = (match recv_e with ESelf -> ESelf | _ -> EVar "__opr") in
    let ies = idx_temp_exprs e2 idxs 0 in
    let cur = eval_e e2 world blk (EMethod (rx, "[]", ies)) in
    if str_eq op "||" then
      (if truthy cur then cur
       else let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, "[]=", eapp ies (Cons (EVar "__opv", Nil)))))
    else if str_eq op "&&" then
      (if truthy cur then (let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, "[]=", eapp ies (Cons (EVar "__opv", Nil))))) else cur)
    else
      let v = eval_e env world blk rhs_e in
      let _ = map_set e2 "__opv" (apply_bin_vals world blk op cur v) in
      eval_e e2 world blk (EMethod (rx, "[]=", eapp ies (Cons (EVar "__opv", Nil))))
  | EMethod (recv_e, name, arges) ->
    // a trailing &proc / &var argument becomes the call's block.
    (match rev_app arges Nil with
     | Cons (EBlockPass be, rrest) ->
       let recv = eval_e env world blk recv_e in
       let args = eval_args env world blk (rev_app rrest Nil) in
       (match eval_e env world blk be with
        | VProc pid -> invoke_with_block env world blk recv name args (proc_as_block pid)
        | VSym snm ->
          let cenv2 = map_new () in
          invoke_with_block env world blk recv name args
            (true, Cons ("__bp", Nil), Cons (SExpr (EMethod (EVar "__bp", snm, Nil)), Nil), cenv2)
        | _ -> invoke_val_c env world blk recv name args true)
     | _ ->
       let recv = eval_e env world blk recv_e in
       let args = eval_args env world blk arges in
       // a `self.`-receiver call may reach private methods (always for a
       // setter, and generally in modern Ruby).
       let vis = (match recv_e with ESelf -> false | _ -> true) in
       // send / __send__ dispatch a runtime method name; respond_to? probes.
       if str_eq name "send" || str_eq name "__send__" || str_eq name "public_send" then
         // public_send respects visibility; send/__send__ bypass it.
         let vis = str_eq name "public_send" in
         (match args with
          | Cons (VSym m, rest) -> if str_eq m "eval" then do_eval env world blk rest else invoke_val_c env world blk recv m rest vis
          | Cons (VStr m, rest) -> let m = sget m in (if str_eq m "eval" then do_eval env world blk rest else invoke_val_c env world blk recv m rest vis)
          | _ -> fail "mere-ruby: send expects a method name")
       else if str_eq name "respond_to?" then
         (match args with
          | Cons (VSym m, _) -> VBool (responds world recv m)
          | Cons (VStr m, _) -> let m = sget m in VBool (responds world recv m)
          | _ -> VBool false)
       // in-place string mutation: rewrite the receiver's store entry, so
       // every alias sees it (unless the class redefines the method).
       else if (match recv with VStr _ -> true | _ -> false)
               && (is_str_mut name || str_eq name "[]=")
               && (if has_meth world "String" name then false else true) then
         (match recv with VStr h -> str_mut_do h name args | _ -> VNil)
       // in-place hash mutation: rewrite the receiver's store entry.
       else if (match recv with VHsh _ -> true | _ -> false)
               && (str_eq name "[]=" || str_eq name "store")
               && (if has_meth world "Hash" name then false else true) then
         (match recv with
          | VHsh h -> (match args with Cons (k, Cons (v, _)) -> let _ = hset h (hash_put (hderef h) k v) in v | _ -> VNil)
          | _ -> VNil)
       // an attribute-writer call (`recv.foo = v`, `recv[i] = v`) has the
       // assigned value as its expression result, not the writer's return.
       else if is_setter_name name then
         let _ = invoke_val_c env world blk recv name args vis in
         (match rev_app args Nil with Cons (v, _) -> v | Nil -> VNil)
       else invoke_val_c env world blk recv name args vis)
  | EMethodB (recv_e, name, arges, bp, bb) ->
    let recv = eval_e env world blk recv_e in
    let args = eval_args env world blk arges in
    let newblk = (match bp with
                  | Cons (c, Nil) -> if str_eq c "&coerce" then coerce_to_block env world blk (match bb with Cons (SExpr be, _) -> eval_e env world blk be | _ -> VNil) else (true, bp, bb, env)
                  | _ -> (true, bp, bb, env)) in
    invoke_with_block env world blk recv name args newblk
  | EArr items -> arr_new (eval_args env world blk items)
  // fold the evaluated pairs through hash_put so duplicate keys (from an
  // explicit repeat or a **splat then override) collapse last-value-wins,
  // keeping the key's first position — Ruby hash-literal semantics.
  | EHsh items -> mkhash (hash_merge Nil (hsh_eval_items env world blk items))
  // a keyword-argument hash: same value as EHsh, but its handle is marked so
  // method binding knows it came from `key: value` syntax (not a positional {}).
  | EKwHash items ->
    (match mkhash (hash_merge Nil (hsh_eval_items env world blk items)) with
     | VHsh id -> let _ = mark_kw id in VHsh id
     | v -> v)
  | EUn (op, a) ->
    if str_eq op "!" then
      (let v = eval_e env world blk a in
       match v with
       | VObj id ->
         let (m2, s2, ocls2, iv2) = world in
         let cls = map_get ocls2 (str_of_int id) in
         if has_meth world cls "!@" then invoke_val_c env world blk v "!@" Nil false
         else if truthy v then VBool false else VBool true
       | _ -> if truthy v then VBool false else VBool true)
    else if str_eq op "~" then
      (match eval_e env world blk a with
       | VInt n -> VInt (0 - n - 1)   // bitwise not
       | _ -> fail "mere-ruby: unary ~ on non-integer")
    else
      (match eval_e env world blk a with
       | VInt n -> VInt (0 - n)
       | VBig s -> if str_eq op "-" then norm_big (big_neg_s s) else VBig s
       | VFlt f -> VFlt (0.0 - f)
       | VRat (n, d) -> if str_eq op "-" then VRat (big_neg_s n, d) else VRat (n, d)
       | VCpx (r, i) -> if str_eq op "-" then VCpx (num_neg r, num_neg i) else VCpx (r, i)
       // unary -/+ on an object dispatch to its -@ / +@ method.
       | other -> invoke_val_c env world blk other (op ++ "@") Nil false)
  | EBin (op, a, b) ->
    if str_eq op "&&" then
      let va = eval_e env world blk a in
      if truthy va then eval_e env world blk b else va
    else if str_eq op "||" then
      let va = eval_e env world blk a in
      if truthy va then va else eval_e env world blk b
    // `/literal regex/ =~ str` with named captures binds a local variable per
    // named group (only for a literal regex on the LHS, per Ruby).
    else if str_eq op "=~" && (match a with ERegex _ -> true | _ -> false) then
      (match a with
       | ERegex (pat, pfl) ->
         let vb = eval_e env world blk b in
         (match vb with
          | VStr sv -> let sv = sget sv in
            let r = rx_do_match world pat pfl sv in
            let _ = set_named_caps env pat 0 0 in r
          | _ -> VNil)
       | _ -> VNil)
    else
    // an object whose class defines the operator dispatches to it.
    let va0 = eval_e env world blk a in
    // `s << x` on a string appends in place (store rewrite: aliases see it).
    // An integer appends the codepoint's character, as in Ruby.
    if str_eq op "<<" && (match va0 with VStr _ -> true | _ -> false) then
      (match va0 with
       | VStr h ->
         (match eval_e env world blk b with
          | VStr y -> let _ = sset h (sget h ++ sget y) in va0
          | VInt n -> let _ = sset h (sget h ++ chr n) in va0
          | _ -> fail "mere-ruby: << string needs a string")
       | _ -> VNil)
    else
    (match va0 with
     | VObj oid ->
       let (meths, sup, ocls, ivars) = world in
       let ocl = map_get ocls (str_of_int oid) in
       let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
       if has_meth world ocl op then
         invoke world noblk va0 ocl op (Cons (eval_e env world blk b, Nil))
       // a yielder in a generator block: y << value.
       else if str_eq ocl "Enumerator::Yielder" && str_eq op "<<" then
         invoke_val_c env world blk va0 "<<" (Cons (eval_e env world blk b, Nil)) false
       // File / IO handles: f << data appends (write).
       else if (str_eq ocl "File" || str_eq ocl "IO") && str_eq op "<<" then
         invoke_val_c env world blk va0 "<<" (Cons (eval_e env world blk b, Nil)) false
       // enumerator chaining: e1 + e2.
       else if (str_eq ocl "Enumerator" || str_eq ocl "Enumerator::Chain") && str_eq op "+" then
         invoke_val_c env world blk va0 "+" (Cons (eval_e env world blk b, Nil)) false
       // Comparable: derive < > <= >= from a user-defined <=> when the
       // operator itself is not defined.
       else if (str_eq op "<" || str_eq op ">" || str_eq op "<=" || str_eq op ">=") && has_meth world ocl "<=>" then
         (let c = invoke world noblk va0 ocl "<=>" (Cons (eval_e env world blk b, Nil)) in
          match c with
          | VInt n -> VBool (if str_eq op "<" then n < 0 else if str_eq op ">" then n > 0 else if str_eq op "<=" then n <= 0 else n >= 0)
          | _ -> raise_exc world "ArgumentError" "comparison failed")
       // Comparable#==: derive from a user <=> (0 = equal, nil/other = not).
       else if str_eq op "==" && has_meth world ocl "<=>" && (if has_meth world ocl "==" then false else true) then
         (match invoke world noblk va0 ocl "<=>" (Cons (eval_e env world blk b, Nil)) with
          | VInt n -> VBool (n == 0)
          | _ -> VBool false)
       else eval_bin_prim env world blk op va0 b
     // a class-level operator (def self.<<) dispatches too.
     | VClass c ->
       if has_meth world ("(sng:" ++ c ++ ")") op then
         let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
         invoke world noblk va0 ("(sng:" ++ c ++ ")") op (Cons (eval_e env world blk b, Nil))
       else eval_bin_prim env world blk op va0 b
     // a primitive tagged as a subclass instance (String/Array/Hash subclass)
     // whose subclass defines the operator dispatches to that override.
     | _ ->
       let hk = hng_key va0 in
       if (if str_eq hk "" then false else true) && map_has hng_store hk && has_meth world (map_get hng_store hk) op then
         let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
         invoke world noblk va0 (map_get hng_store hk) op (Cons (eval_e env world blk b, Nil))
       else eval_bin_prim env world blk op va0 b)

and eval_bin_prim = fn env -> fn world -> fn blk -> fn (op: str) -> fn (va0: Val) -> fn (b: Expr) ->
    if str_eq op "==" then VBool (rb_eq va0 (eval_e env world blk b))
    else if str_eq op "!=" then
      (if rb_eq va0 (eval_e env world blk b) then VBool false else VBool true)
    else if str_eq op "===" then VBool (case_eqq world va0 (eval_e env world blk b))
    else if str_eq op "=~" then
      (let vb = eval_e env world blk b in
       match va0 with
       | VStr sv -> let sv = sget sv in (match vb with VRegex (p, pf) -> rx_do_match world p pf sv | _ -> VNil)
       | VRegex (p, pf) -> (match vb with VStr sv -> let sv = sget sv in rx_do_match world p pf sv | _ -> VNil)
       | _ -> VNil)
    else if str_eq op "!~" then
      (let vb = eval_e env world blk b in
       match va0 with
       | VStr sv -> let sv = sget sv in (match vb with VRegex (p, pf) -> VBool (if rx_match p pf sv then false else true) | _ -> VBool true)
       | VRegex (p, pf) -> (match vb with VStr sv -> let sv = sget sv in VBool (if rx_match p pf sv then false else true) | _ -> VBool true)
       | _ -> VBool true)
    else if str_eq op "<=>" then
      (let vb = eval_e env world blk b in
       let c = cmp_vals va0 vb in
       VInt (if c < 0 then 0 - 1 else if c > 0 then 1 else 0))
    else if str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=" then
      // incomparable operands raise ArgumentError with Ruby's message
      // ("comparison of String with 7 failed": numbers by value, others by class).
      (let vb = eval_e env world blk b in
       if cmp_incompatible va0 vb then
         raise_exc world "ArgumentError" ("comparison of " ++ class_name va0 ++ " with " ++ (if is_num vb then to_s vb else class_name vb) ++ " failed")
       else
         let c = cmp_vals va0 vb in
         VBool (if str_eq op "<" then c < 0 else if str_eq op "<=" then c <= 0 else if str_eq op ">" then c > 0 else c >= 0))
    else
      let vb = eval_e env world blk b in
      // `"fmt" % arg` / `"fmt" % [args]` is sprintf-style formatting.
      if str_eq op "%" && (match va0 with VStr _ -> true | _ -> false) then
        (match va0 with
         | VStr h -> mkstr (rb_format (sget h) (match vb with VArr id -> deref id | _ -> Cons (vb, Nil)))
         | _ -> va0)
      // INTEGER division / modulo by zero raises a real ZeroDivisionError.
      // Float operands instead yield Infinity / -Infinity / NaN (as in Ruby).
      else if (str_eq op "/" || str_eq op "%")
              && (match vb with VInt z -> z == 0 | _ -> false)
              && (match va0 with VInt _ -> true | VBig _ -> true | _ -> false)
      then raise_exc world "ZeroDivisionError" "divided by 0"
      // nil has no arithmetic/shift operators: Ruby raises NoMethodError
      // (e.g. `nil + 3`), not a generic type error.
      else if (match va0 with VNil -> true | _ -> false)
              && (str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/"
                  || str_eq op "%" || str_eq op "**" || str_eq op "<<" || str_eq op ">>")
      then raise_exc world "NoMethodError" ("undefined method '" ++ op ++ "' for nil")
      else arith_bin op va0 vb

// hash-literal pairs; a doubled EKwSplat marker splices another hash.
and hsh_eval_items = fn env -> fn world -> fn blk -> fn (items: Expr list) ->
  match items with
  | Nil -> Nil
  | Cons (k, rest0) ->
    (match k with
     | EKwSplat e ->
       (match rest0 with
        | Cons (_, rest) ->
          let pairs = (match eval_e env world blk e with VHsh xs -> let xs = hderef xs in xs | _ -> Nil) in
          list_append pairs (hsh_eval_items env world blk rest)
        | Nil -> Nil)
     | _ ->
       (match rest0 with
        | Cons (v, rest) ->
          Cons (eval_e env world blk k,
                Cons (eval_e env world blk v, hsh_eval_items env world blk rest))
        | Nil -> Cons (eval_e env world blk k, Nil)))

// object identity (equal?): reference types are identical only when they
// are the same handle; immediates compare by value.
and rb_identical = fn (a: Val) -> fn (b: Val) ->
  match a with
  | VArr ia -> (match b with VArr ib -> ia == ib | _ -> false)
  | VObj ia -> (match b with VObj ib -> ia == ib | _ -> false)
  // strings are handles: equal? is object identity, not content equality.
  | VStr ia -> (match b with VStr ib -> ia == ib | _ -> false)
  | VHsh ia -> (match b with VHsh ib -> ia == ib | _ -> false)
  | _ -> rb_eq a b

// bind index values to hidden temp vars (__opi0..) in e2 for op-assign, and
// return EVar references to them (so the index is not re-evaluated).
and idx_temp_exprs = fn e2 -> fn (idxs: Val list) -> fn (n: int) ->
  match idxs with
  | Nil -> (Nil : Expr list)
  | Cons (v, rest) -> let nm = "__opi" ++ str_of_int n in let _ = map_set e2 nm v in Cons (EVar nm, idx_temp_exprs e2 rest (n + 1))

and eval_args = fn env -> fn world -> fn blk -> fn (items: Expr list) ->
  match items with
  | Nil -> Nil
  // splat argument: expand an array's elements into the argument list.
  | Cons (ESplat e, t) ->
    let spread = (match eval_e env world blk e with
                  | VArr id -> deref id
                  | VHsh xs -> let xs = hderef xs in hash_to_a xs   // *hash spreads as [k, v] pairs
                  | VNil -> Nil   // [*nil] is empty
                  // a non-array splat calls to_a if the object responds to
                  // it: a real/singleton method, or a user respond_to? that
                  // answers true (covering method_missing mocks).
                  | VObj oid ->
                    let (m2, sp2, ocls2, iv2) = world in
                    let ocl2 = map_get ocls2 (str_of_int oid) in
                    let coerce =
                      (if has_meth world ocl2 "to_a" then true
                       else if has_meth world ocl2 "respond_to?" then
                         truthy (invoke_val_c env world blk (VObj oid) "respond_to?" (Cons (VSym "to_a", Nil)) false)
                       else false) in
                    if coerce then
                      // to_a returning nil means "not really convertible", so
                      // the splat wraps the original object as [obj]; a
                      // non-Array, non-nil result is a TypeError.
                      (match invoke_val_c env world blk (VObj oid) "to_a" Nil false with
                       | VArr aid -> deref aid
                       | VNil -> Cons (VObj oid, Nil)
                       | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name (VObj oid) ++ " to Array (" ++ class_name (VObj oid) ++ "#to_a gives " ++ class_name other ++ ")") in Cons (VObj oid, Nil)))
                    else Cons (VObj oid, Nil)
                  | v -> Cons (v, Nil)) in
    list_append spread (eval_args env world blk t)
  // **h passes the hash's pairs as keyword args: a fresh, kwarg-marked copy
  // (so the original hash variable is unaffected and it binds as kwargs).
  | Cons (EKwSplat e, t) ->
    (match eval_e env world blk e with
     // `**{}` (an empty double-splat) passes no keyword arguments at all
     // (Ruby 3.0): omit it rather than leaking an empty positional hash.
     | VHsh id ->
       (match hderef id with
        | Nil -> eval_args env world blk t
        | pairs -> (match mkhash pairs with
                    | VHsh nid -> let _ = mark_kw nid in Cons (VHsh nid, eval_args env world blk t)
                    | v -> Cons (v, eval_args env world blk t)))
     | other -> Cons (other, eval_args env world blk t))
  | Cons (h, t) -> Cons (eval_e env world blk h, eval_args env world blk t)

// ---- multiple assignment ------------------------------------------------
and assign_one = fn env -> fn world -> fn (tgt: str) -> fn (v: Val) ->
  let (meths, sup, ocls, ivars) = world in
  if str_len tgt > 0 && str_eq (char_at tgt 0) "$" then
    let _ = map_set globals (substring tgt 1 (str_len tgt)) v in ()
  else if str_len tgt > 0 && str_eq (char_at tgt 0) "@" then
    let n = substring tgt 1 (str_len tgt) in
    (match map_get env "self" with
     | VObj id -> let _ = map_set ivars (str_of_int id ++ "@" ++ n) v in ()
     | VMain -> let _ = map_set ivars ("main@" ++ n) v in ()
     | VClass c -> let _ = map_set ivars ("cls:" ++ c ++ "@" ++ n) v in ()
     | _ -> ())
  // a constant target (Capitalized, unqualified) is stored in the constant
  // table, so a later bare-Const read finds the assigned value.
  else if is_upper_first tgt && (if str_contains tgt "::" then false else true) then
    let _ = map_set consts tgt v in ()
  else let _ = map_set env tgt v in ()

and tgt_is_splat = fn (t: str) -> str_len t > 0 && str_eq (char_at t 0) "*"

// `**kw` params: the name after the double splat (or "").
and is_dsplat = fn (p: str) -> str_len p >= 2 && str_eq (substring p 0 2) "**"
and dsplat_name = fn (ps: str list) ->
  match ps with
  | Nil -> ""
  | Cons (p, r) -> if is_dsplat p then substring p 2 (str_len p) else dsplat_name r
and drop_dsplat = fn (ps: str list) ->
  match ps with
  | Nil -> Nil
  | Cons (p, r) -> if is_dsplat p then drop_dsplat r else Cons (p, drop_dsplat r)

and has_splat = fn (ts: str list) ->
  match ts with Nil -> false | Cons (t, r) -> if tgt_is_splat t then true else has_splat r

// Array#[](start, len): negative start counts from the end; start just past
// the end yields []; out of range or negative length yields nil.
and arr_slice = fn (xs: Val list) -> fn (st0: int) -> fn (len: int) ->
  let n = val_list_len xs in
  let st = if st0 < 0 then n + st0 else st0 in
  if st < 0 || st > n || len < 0 then VNil
  else arr_new (vtake (vdrop xs st) len)

// Array#[]=(start, len, v): replace len elements at start with v (an array
// splices its elements in); writes past the end pad with nils.
and arr_splice = fn (xs: Val list) -> fn (st0: int) -> fn (len0: int) -> fn (v: Val) ->
  let n = val_list_len xs in
  let st1 = if st0 < 0 then n + st0 else st0 in
  let st = if st1 < 0 then 0 else st1 in
  let len = if len0 < 0 then 0 else len0 in
  let pre = (if st <= n then vtake xs st else list_append xs (nil_pad (st - n))) in
  let post = vdrop xs (st + len) in
  let ins = (match v with VArr id2 -> deref id2 | other -> Cons (other, Nil)) in
  list_append pre (list_append ins post)

and nil_pad = fn (k: int) ->
  if k <= 0 then (Nil : Val list) else Cons (VNil, nil_pad (k - 1))

and vlen = fn (xs: Val list) -> match xs with Nil -> 0 | Cons (_, t) -> 1 + vlen t
and val_repeat = fn (n: int) -> fn (v: Val) ->
  if n <= 0 then Nil else Cons (v, val_repeat (n - 1) v)
// Array.new(n) { |i| ... }: element i is the block's value for index i.
and array_new_blk = fn world -> fn encl -> fn theblk -> fn (n: int) -> fn (i: int) ->
  if i >= n then Nil
  else Cons (flow_value (run_block world encl theblk (Cons (VInt i, Nil))), array_new_blk world encl theblk n (i + 1))
and vtake = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then Nil else (match xs with Nil -> Nil | Cons (h, t) -> Cons (h, vtake t (n - 1)))
and vdrop = fn (xs: Val list) -> fn (n: int) ->
  if n <= 0 then xs else (match xs with Nil -> Nil | Cons (_, t) -> vdrop t (n - 1))

// flatten nested arrays up to `depth` levels; depth < 0 means unlimited.
// A handle already on the flatten stack (self-referential array) is skipped
// rather than recursed into — avoids the infinite recursion / segfault.
and val_flatten = fn (xs: Val list) -> fn (depth: int) ->
  match xs with
  | Nil -> Nil
  | Cons (VArr id, t) ->
    if depth == 0 then Cons (VArr id, val_flatten t depth)
    else if map_has insp_seen (str_of_int id) then val_flatten t depth
    else
      let _ = map_set insp_seen (str_of_int id) 1 in
      let inner = val_flatten (deref id) (if depth < 0 then depth else depth - 1) in
      let _ = map_delete insp_seen (str_of_int id) in
      list_append inner (val_flatten t depth)
  | Cons (h, t) -> Cons (h, val_flatten t depth)
and val_compact = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VNil, t) -> val_compact t
  | Cons (h, t) -> Cons (h, val_compact t)
// tally: hash of element -> occurrence count (insertion order).
and val_tally = fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> mkhash acc
  | Cons (h, t) -> let c = (match hash_get acc h with VInt n -> n | _ -> 0) in val_tally t (hash_put acc h (VInt (c + 1)))
and val_minmax = fn (xs: Val list) ->
  match xs with
  | Nil -> arr_new (Cons (VNil, Cons (VNil, Nil)))
  | Cons (h, t) -> arr_new (Cons (val_min t h, Cons (val_max t h, Nil)))
// each_slice: consecutive groups of n; each_cons: sliding windows of n.
and val_slices = fn (xs: Val list) -> fn (n: int) ->
  match xs with Nil -> Nil | _ -> Cons (arr_new (vtake xs n), val_slices (vdrop xs n) n)
and val_cons_windows = fn (xs: Val list) -> fn (n: int) ->
  if val_list_len xs < n then Nil
  else Cons (arr_new (vtake xs n), val_cons_windows (match xs with Cons (_, t) -> t | Nil -> Nil) n)
// array of [k, v] pairs -> interleaved hash list [k1,v1,k2,v2,...].
and val_to_h = fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VArr pid, t) -> (match deref pid with Cons (k, Cons (v, _)) -> Cons (k, Cons (v, val_to_h t)) | _ -> val_to_h t)
  | Cons (_, t) -> val_to_h t
// nth element of a list or VNil (for zip padding).
and val_at_or_nil = fn (xs: Val list) -> fn (i: int) ->
  match xs with Nil -> VNil | Cons (h, t) -> if i <= 0 then h else val_at_or_nil t (i - 1)
// zip: build [self[i], others[0][i], others[1][i], ...] for each i.
and val_zip = fn (xs: Val list) -> fn (others: Val list) -> fn (i: int) -> fn (total: int) ->
  if i >= total then Nil
  else Cons (arr_new (Cons (val_at_or_nil xs i, val_zip_row others i)), val_zip xs others (i + 1) total)
and val_zip_row = fn (others: Val list) -> fn (i: int) ->
  match others with
  | Nil -> Nil
  | Cons (VArr id, t) -> Cons (val_at_or_nil (deref id) i, val_zip_row t i)
  | Cons (_, t) -> Cons (VNil, val_zip_row t i)
// transpose: rows -> columns (assumes rectangular).
and val_transpose = fn (rows: Val list) -> fn (col: int) -> fn (ncols: int) ->
  if col >= ncols then Nil
  else Cons (arr_new (val_transpose_col rows col), val_transpose rows (col + 1) ncols)
and val_transpose_col = fn (rows: Val list) -> fn (col: int) ->
  match rows with
  | Nil -> Nil
  | Cons (VArr id, t) -> Cons (val_at_or_nil (deref id) col, val_transpose_col t col)
  | Cons (_, t) -> Cons (VNil, val_transpose_col t col)

// assign values to targets in parallel (no splat); missing values are nil.
and assign_parallel = fn env -> fn world -> fn (targets: str list) -> fn (values: Val list) ->
  match targets with
  | Nil -> ()
  | Cons (t, ts) ->
    (match values with
     | Nil -> let _ = assign_one env world t VNil in assign_parallel env world ts Nil
     | Cons (v, vs) -> let _ = assign_one env world t v in assign_parallel env world ts vs)

// complex multiple-assignment targets: write one value to one target.
and assign_x_one = fn env -> fn world -> fn blk -> fn (t: Expr) -> fn (v: Val) ->
  match t with
  | EVar n -> assign_one env world n v
  | EIVar n -> assign_one env world ("@" ++ n) v
  | ESplat inner -> assign_x_one env world blk inner v
  // a grouped target destructures its value like a nested masgn, coercing a
  // non-Array via #to_ary just as a top-level MLHS does.
  | EArr ts ->
    let vals = coerce_massign env world v (xhas_splat ts && xlen ts == 1) in
    assign_x_targets env world blk ts vals
  | EMethod (recv, m, args) ->
    let rv = eval_e env world blk recv in
    let argvals = eval_args env world blk args in
    let _ = invoke_val_c env world blk rv (m ++ "=") (vappend argvals (Cons (v, Nil))) false in
    ()
  // `recv::CONST = v` — assign a constant in the receiver module's namespace.
  | EScopedRead (recv, cn) ->
    (match eval_e env world blk recv with
     | VClass c -> let _ = map_set consts (c ++ "::" ++ cn) v in ()
     | other -> let _ = raise_exc world "TypeError" (inspect other ++ " is not a class/module") in ())
  // `recv&.attr = v` — assign only when the receiver is non-nil.
  | ESafe (recv, m, args) ->
    (match eval_e env world blk recv with
     | VNil -> ()
     | rv -> let argvals = eval_args env world blk args in
             let _ = invoke_val_c env world blk rv (m ++ "=") (vappend argvals (Cons (v, Nil))) false in ())
  | _ -> ()

// Pre-evaluate a complex masgn target's receiver (and index/method args) into
// fresh temps, left to right, returning a rewritten target that reads those
// temps. This realises Ruby's evaluation order for `a.b, c[d] = ...`: every
// LHS receiver is evaluated (left to right) before the RHS, and every setter
// runs only after the RHS — so `foo[0], bar.baz = a, b` records foo, bar, a,
// b, foo[]=, bar.baz=. A plain variable/ivar/constant target has no receiver
// and is left untouched.
and prep_x_target = fn env -> fn world -> fn blk -> fn (t: Expr) ->
  match t with
  | EMethod (recv, m, args) ->
    let rv = eval_e env world blk recv in
    let rnm = fresh_anon "__mlr" in
    let _ = map_set env rnm rv in
    EMethod (EVar rnm, m, prep_x_args env world blk args)
  | ESplat inner -> ESplat (prep_x_target env world blk inner)
  | EArr ts -> EArr (prep_x_targets env world blk ts)
  | _ -> t
and prep_x_args = fn env -> fn world -> fn blk -> fn (args: Expr list) ->
  match args with
  | Nil -> Nil
  | Cons (ESplat inner, rest) ->
    let av = eval_e env world blk inner in
    let anm = fresh_anon "__mla" in
    let _ = map_set env anm av in
    Cons (ESplat (EVar anm), prep_x_args env world blk rest)
  | Cons (a, rest) ->
    let av = eval_e env world blk a in
    let anm = fresh_anon "__mla" in
    let _ = map_set env anm av in
    Cons (EVar anm, prep_x_args env world blk rest)
and prep_x_targets = fn env -> fn world -> fn blk -> fn (ts: Expr list) ->
  match ts with
  | Nil -> Nil
  | Cons (t, rest) -> Cons (prep_x_target env world blk t, prep_x_targets env world blk rest)

and vappend = fn (a: Val list) -> fn (b: Val list) ->
  match a with Nil -> b | Cons (h, t) -> Cons (h, vappend t b)

and x_is_splat = fn (t: Expr) -> match t with ESplat _ -> true | _ -> false
and xhas_splat = fn (ts: Expr list) ->
  match ts with Nil -> false | Cons (t, r) -> if x_is_splat t then true else xhas_splat r
and xlen = fn (ts: Expr list) -> match ts with Nil -> 0 | Cons (_, t) -> 1 + xlen t
and xbefore_splat = fn (ts: Expr list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if x_is_splat t then Nil else Cons (t, xbefore_splat r)
and xafter_splat = fn (ts: Expr list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if x_is_splat t then r else xafter_splat r
and xsplat_tgt = fn (ts: Expr list) ->
  match ts with
  | Nil -> ENil
  | Cons (t, r) -> (match t with ESplat inner -> inner | _ -> xsplat_tgt r)

and assign_x_parallel = fn env -> fn world -> fn blk -> fn (targets: Expr list) -> fn (values: Val list) ->
  match targets with
  | Nil -> ()
  | Cons (t, ts) ->
    (match values with
     | Nil -> let _ = assign_x_one env world blk t VNil in assign_x_parallel env world blk ts Nil
     | Cons (v, vs) -> let _ = assign_x_one env world blk t v in assign_x_parallel env world blk ts vs)

and assign_x_targets = fn env -> fn world -> fn blk -> fn (targets: Expr list) -> fn (values: Val list) ->
  // a lone grouped target is the whole target list: (b, c) = [1, 2]
  match targets with
  | Cons (EArr inner, Nil) -> assign_x_targets env world blk inner values
  | _ ->
  if xhas_splat targets then
    let before = xbefore_splat targets in
    let after = xafter_splat targets in
    let nb = xlen before in
    let na = xlen after in
    let nv = vlen values in
    let sc = nv - nb - na in
    let sc = if sc < 0 then 0 else sc in
    let _ = assign_x_parallel env world blk before (vtake values nb) in
    let _ = assign_x_one env world blk (xsplat_tgt targets) (arr_new (vtake (vdrop values nb) sc)) in
    assign_x_parallel env world blk after (vdrop values (nb + sc))
  else assign_x_parallel env world blk targets values

// coerce a single RHS value of a multiple assignment into the value list.
// An Array splats directly. A lone-splat LHS (`*a = obj`) wraps the object
// as [obj] without conversion. Any other MLHS (`a, b =` / `a, *b =`) converts
// a non-Array via #to_ary, wrapping as [rv] when it does not respond (or
// returns nil) and raising TypeError when #to_ary returns a non-Array.
// (The #to_a path is for a splatted RHS, e.g. `*a = *x`, handled at the RHS.)
and coerce_massign = fn env -> fn world -> fn (rv: Val) -> fn (lone_splat: bool) ->
  // lone_splat is retained for call-site clarity but no longer suppresses
  // coercion: Ruby coerces `*a = obj` via #to_ary exactly like any MLHS
  // (the coercion path wraps a non-responding object as [obj] on its own).
  let _ = lone_splat in
  match rv with
  | VArr id -> deref id
  | _ ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    // Ruby's protocol: respond_to?(:to_ary) then to_ary. A real/singleton
    // to_ary counts; otherwise a user respond_to? that answers true (covering
    // method_missing mocks). Only invoke respond_to? when it is user-defined,
    // matching the RHS-splat to_a path.
    let can = (match rv with
               | VObj oid ->
                 let (m2, sp2, ocls2, iv2) = world in
                 let ocl2 = map_get ocls2 (str_of_int oid) in
                 if has_meth world ocl2 "to_ary" then true
                 else if has_meth world ocl2 "respond_to?" then
                   truthy (invoke_val_c env world noblk rv "respond_to?" (Cons (VSym "to_ary", Nil)) false)
                 else false
               | _ -> responds world rv "to_ary") in
    if can then
      (match invoke_val_c env world noblk rv "to_ary" Nil false with
       | VArr id -> deref id
       | VNil -> Cons (rv, Nil)
       | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name rv ++ " to Array (" ++ class_name rv ++ "#to_ary gives " ++ class_name other ++ ")") in Nil))
    else Cons (rv, Nil)

// coerce a splatted RHS value (`= *x`) into its value list: an Array splats,
// nil becomes empty, any other object converts via #to_a (respond_to?-guarded,
// mock-aware), wrapping as [rv] when it does not respond and raising TypeError
// when #to_a returns a non-Array.
and coerce_splat_rhs = fn env -> fn world -> fn (rv: Val) ->
  match rv with
  | VArr id -> deref id
  | VNil -> Nil
  | VObj oid ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    let (m2, sp2, ocls2, iv2) = world in
    let ocl2 = map_get ocls2 (str_of_int oid) in
    let can = (if has_meth world ocl2 "to_a" then true
               else if has_meth world ocl2 "respond_to?" then
                 truthy (invoke_val_c env world noblk rv "respond_to?" (Cons (VSym "to_a", Nil)) false)
               else false) in
    if can then
      (match invoke_val_c env world noblk rv "to_a" Nil false with
       | VArr aid -> deref aid
       | VNil -> Cons (rv, Nil)
       | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name rv ++ " to Array (" ++ class_name rv ++ "#to_a gives " ++ class_name other ++ ")") in Nil))
    else Cons (rv, Nil)
  | _ -> Cons (rv, Nil)

and assign_targets = fn env -> fn world -> fn (targets: str list) -> fn (values: Val list) ->
  if has_splat targets then
    let before = take_until_splat targets in
    let after = after_splat targets in
    let sname = splat_name targets in
    let nb = list_str_len before in
    let na = list_str_len after in
    let nv = vlen values in
    let sc = nv - nb - na in
    let sc = if sc < 0 then 0 else sc in
    let _ = assign_parallel env world before (vtake values nb) in
    let _ = assign_one env world sname (arr_new (vtake (vdrop values nb) sc)) in
    let _ = assign_parallel env world after (vdrop values (nb + sc)) in
    ()
  else assign_parallel env world targets values

and take_until_splat = fn (ts: str list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if tgt_is_splat t then Nil else Cons (t, take_until_splat r)
and after_splat = fn (ts: str list) ->
  match ts with Nil -> Nil | Cons (t, r) -> if tgt_is_splat t then r else after_splat r
and splat_name = fn (ts: str list) ->
  match ts with Nil -> "" | Cons (t, r) -> if tgt_is_splat t then (if str_eq t "*," then "" else substring t 1 (str_len t)) else splat_name r
and list_str_len = fn (ts: str list) -> match ts with Nil -> 0 | Cons (_, t) -> 1 + list_str_len t

// build an exception value from raise's arguments. `raise "m"` is a
// RuntimeError; `raise Cls` / `raise Cls, "m"` uses the class; `raise e`
// re-raises an existing exception.
// world-aware: when raising a class that defines its OWN initialize, build
// an instance, run initialize (so super/@message logic fires), and read the
// resulting @message. Otherwise fall back to the pure make_exc.
and make_exc_w = fn world -> fn (args: Val list) ->
  match args with
  | Cons (VClass c, rest) ->
    let (meths, sup, ocls, ivars) = world in
    if map_has meths (c ++ "#initialize") then
      // keep it as a live object so custom ivars/methods (e.g. #code) survive;
      // ensure @message is set (defaults to the class name) for #message.
      let id = map_len ocls in
      let _ = map_set ocls (str_of_int id) c in
      let noblk = (false, (Nil : str list), (Nil : Stmt list), ivars) in
      let _ = invoke world noblk (VObj id) c "initialize" rest in
      let _ = if map_has ivars (str_of_int id ++ "@message") then () else map_set ivars (str_of_int id ++ "@message") (mkstr c) in
      VObj id
    else make_exc args
  // raising an already-built exception instance (e.g. `raise Err.new(...)`).
  | Cons (VObj id, _) -> VObj id
  | _ -> make_exc args

and make_exc = fn (args: Val list) ->
  match args with
  // bare `raise` yields a RuntimeError whose message is empty (not the
  // class name — that is what `RuntimeError.new` without an arg gives).
  | Nil -> VExc ("RuntimeError", "")
  | Cons (VStr msg, _) -> let msg = sget msg in VExc ("RuntimeError", msg)
  | Cons (VClass c, rest) ->
    (match rest with Cons (VStr m, _) -> let m = sget m in VExc (c, m) | _ -> VExc (c, c))
  | Cons (VExc (c, m), _) -> VExc (c, m)
  | Cons (v, _) -> VExc ("RuntimeError", to_s v)

// does exception class `ecls` match one of the rescued classes (walking
// the superclass chain)? A bare rescue (no classes) catches StandardError.
and rescue_matches = fn world -> fn (exc: Val) -> fn (classes: str list) ->
  match exc with
  | VExc (ecls, _) ->
    (match classes with
     | Nil -> exc_is_a world ecls "StandardError"
     | _ -> any_class_matches world ecls classes)
  // a user exception is a live object; match on its class.
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let ecls = map_get ocls (str_of_int id) in
    (match classes with
     | Nil -> exc_is_a world ecls "StandardError"
     | _ -> any_class_matches world ecls classes)
  | _ -> false

and any_class_matches = fn world -> fn (ecls: str) -> fn (classes: str list) ->
  match classes with
  | Nil -> false
  | Cons (c, rest) -> if exc_is_a world ecls c then true else any_class_matches world ecls rest

and exc_is_a = fn world -> fn (ecls: str) -> fn (target: str) ->
  if str_eq ecls target then true
  else
    let (meths, sup, ocls, ivars) = world in
    if map_has sup ecls then exc_is_a world (map_get sup ecls) target else false

// class names of the VClass values in a list (for rescue *arr).
and class_names_of = fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (VClass c, t) -> Cons (c, class_names_of t) | Cons (_, t) -> class_names_of t

// expand "*var" (rescue *var) into the array's class names, and "@rexpr~N"
// (a non-constant class expression) by evaluating the stashed expression at
// match time. A "*"-prefixed sentinel splats the evaluated array.
and expand_rescue_classes = fn env -> fn world -> fn blk -> fn (classes: str list) ->
  match classes with
  | Nil -> Nil
  | Cons (c, rest) ->
    if str_len c > 0 && str_eq (char_at c 0) "*" then
      let inner = substring c 1 (str_len c) in
      // "*@rexpr~N": splat the evaluated expression; "*var": splat the local.
      let arr = if str_len inner > 0 && str_eq (char_at inner 0) "@" && str_contains inner "rexpr~"
                then eval_e env world blk (map_get resc_exprs (substring inner 7 (str_len inner)))
                else (if map_has env inner then map_get env inner else VNil) in
      (match arr with VArr id -> list_append_str (class_names_of (deref id)) (expand_rescue_classes env world blk rest) | _ -> expand_rescue_classes env world blk rest)
    else if str_len c > 6 && str_eq (substring c 0 7) "@rexpr~" then
      // a non-constant class expression: evaluate; a Class/Module contributes
      // its name, anything else is a TypeError (class or module required).
      (match eval_e env world blk (map_get resc_exprs (substring c 7 (str_len c))) with
       | VClass cn -> Cons (cn, expand_rescue_classes env world blk rest)
       | _ -> (let _ = raise_exc world "TypeError" "class or module required for rescue clause" in Nil))
    else Cons (c, expand_rescue_classes env world blk rest)

and run_rescues = fn env -> fn world -> fn blk -> fn (exc: Val) -> fn rescues ->
  match rescues with
  | Nil -> re_raise world exc
  | Cons (rc, rest) ->
    let (classes0, var, handler) = rc in
    let classes = expand_rescue_classes env world blk classes0 in
    if rescue_matches world exc classes then
      let _ = if str_eq var "" then () else map_set env var exc in
      // $! holds the exception being handled (so a bare `raise` re-raises it);
      // run_begin restores $! to its pre-begin value when the construct ends.
      let _ = map_set globals "!" exc in
      run_stmts env world blk handler
    else run_rescues env world blk exc rest

and re_raise = fn world -> fn (exc: Val) ->
  let (meths, sup, ocls, ivars) = world in
  let _ = map_set ivars "$exc" exc in
  fail "mere-ruby: (exception re-raised past all rescues)"

// raise a specific built-in exception from inside the interpreter (e.g.
// ZeroDivisionError), setting "$exc" then unwinding via fail.
and raise_exc = fn world -> fn (cls: str) -> fn (msg: str) ->
  let (meths, sup, ocls, ivars) = world in
  let _ = map_set ivars "$exc" (VExc (cls, msg)) in
  let _ = if map_has prim_missing "n" then map_delete prim_missing "n" else () in
  fail "mere-ruby: (built-in exception raised)"

// run `theblk` and return the resulting Flow, so break/next inside the
// block reach the iterating method. Its params bind into its own captured
// env (so it sees and mutates the enclosing locals); the body runs with
// `encl` as the active block so a yield inside it reaches the enclosing
// method's block.
and run_block = fn world -> fn encl -> fn theblk -> fn (argvals: Val list) ->
  // consume any pending forwarded-block home: a `&proc` passed to a BUILTIN
  // (e.g. arr.each(&p)) sets pending_home but never reaches bind_params, so
  // clear it here to keep it from leaking into a later method's frame.
  let _ = if map_has pending_home "v" then map_delete pending_home "v" else () in
  let (has, params00, body, cenv) = theblk in
  // a proc/lambda that captured its defining method's block carries a yblk
  // marker: strip it and use that captured block as `encl` so `yield` inside
  // the proc body resolves to the defining method's block, not the caller's.
  let (encl, params0) = (match params00 with
    | Cons (m, rest) ->
      if str_len m > 9 && str_eq (substring m 0 9) yblk_marker
      then (map_get proc_yblk (substring m 9 (str_len m)), rest)
      else (encl, params00)
    | _ -> (encl, params00)) in
  // a lambda installed as a block carries a marker: strip it and enforce
  // strict arity (a plain block stays lenient).
  let is_lam = (match params0 with Cons (m, _) -> str_eq m lambda_blk_marker | _ -> false) in
  let params = if is_lam then (match params0 with Cons (_, rest) -> rest | _ -> params0) else params0 in
  // an explicit-empty param list (`{ || .. }` / `-> () { .. }`) runs with zero
  // params; the sentinel only served to reject numbered params at parse time.
  let params = (match params with Cons (m, Nil) -> if str_eq m empty_bp_marker then (Nil : str list) else params | _ -> params) in
  let _ = if is_lam then lambda_arity_check world params body (vlen argvals) else () in
  // Ruby block params are block-local: save any outer bindings of the
  // param names and restore them after the block (for-loops keep their
  // variable via an explicit assignment to a hidden __for param).
  let saved = save_params cenv (match params with
    | Nil -> Cons ("_1", Cons ("_2", Cons ("_3", Cons ("_4", Cons ("_5", Cons ("_6", Cons ("_7", Cons ("_8", Cons ("_9", Nil)))))))))
    | _ -> params) Nil in
  // names first assigned INSIDE the block are also block-local: collect
  // the assignment targets not yet bound outside, delete them afterwards.
  let created = fresh_targets cenv (deep_targets body) in
  let _ = bind_block_params cenv world encl (block_defaults body) params argvals is_lam in
  // A raising body must still restore block-local params and drop the locals
  // it created, or those bindings leak into the captured env and are visible
  // to later invocations of sibling blocks (e.g. mspec examples sharing a
  // scope). Catch the raise, run the cleanup, then re-raise the same exception
  // (its details are already stored in ivars "$exc").
  let _ = map_set flow_sig "__blk_ok" (VBool false) in
  let f = try_or (fn (u: unit) ->
                    let r = block_body_flow cenv world encl body in
                    let _ = map_set flow_sig "__blk_ok" (VBool true) in
                    r)
                 (FRaise VNil) in
  let ok = (if map_has flow_sig "__blk_ok" then (match map_get flow_sig "__blk_ok" with VBool b -> b | _ -> false) else false) in
  let _ = if map_has flow_sig "__blk_ok" then map_delete flow_sig "__blk_ok" else () in
  let _ = restore_params cenv saved in
  let _ = drop_created cenv created in
  if ok then f else fail "mere-ruby: (ruby exception raised)"

// run a block body once, converting flow signals: break/next become Flows
// for the iterator; return keeps unwinding to the enclosing method; redo
// reruns the block body.
and block_body_flow = fn cenv -> fn world -> fn encl -> fn (body: Stmt list) ->
  let f = try_or (fn (u: unit) -> run_stmts cenv world encl body) (FRaise VNil) in
  match f with
  | FReturn v ->
    // a return from a block/proc returns from the frame that DEFINED it (a
    // method or an enclosing lambda call), targeted so it passes through any
    // method that merely yielded the block. Falls back to a plain return if
    // that frame is unknown or already gone (a proc whose home has returned).
    let home = (if map_has cenv "__fid" then (match map_get cenv "__fid" with VInt t -> t | _ -> 0) else 0) in
    if home == 0 || (if map_has live_frames (str_of_int home) then false else true)
    then flow_rethrow "return" v
    else flow_throw_returnret home v
  | FRaise _ ->
    if map_has flow_sig "k" then
      let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
      let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
      let _ = map_delete flow_sig "k" in
      if str_eq k "break" then FBreak v
      else if str_eq k "next" then FLoopNext v
      else if str_eq k "redo" then let _ = tick () in block_body_flow cenv world encl body
      else if str_eq k "retry" then FRaise (raise_exc world "SyntaxError" "Invalid retry")
      else flow_rethrow k v
    else fail "mere-ruby: (ruby exception raised)"
  | other -> other

// deep scan for local-assignment targets (stops at def/class boundaries;
// the hidden for-loop assignment is excluded so `for` keeps leaking).
and deep_targets = fn (body: Stmt list) ->
  match body with
  | Nil -> Nil
  | Cons (s, rest) -> list_append_str (stmt_targets s) (deep_targets rest)

and stmt_targets = fn (s: Stmt) ->
  match s with
  | SAssign (n, e) ->
    (match e with
     | EVar h ->
       // assignments from the hidden for-loop params leak by design.
       if str_len h > 2 && str_eq (substring h 0 3) "__f" then Nil else Cons (n, Nil)
     | _ -> Cons (n, Nil))
  | SLocalFrom (n, s2) -> Cons (n, stmt_targets s2)
  | SMultiAssign (ts, _) -> ts
  | SMultiAssignX (ts, _) -> x_target_names ts
  | SIf (clauses, els) -> list_append_str (clauses_targets clauses) (deep_targets els)
  | SWhile (_, b) -> deep_targets b
  | SCase (_, whens, els) -> list_append_str (whens_targets whens) (deep_targets els)
  | SCaseIn (_, clauses, _, els) -> list_append_str (clauses_pat_vars clauses) (list_append_str (clausesin_targets clauses) (deep_targets els))
  | SBegin (b, rescues, els, ens) ->
    list_append_str (deep_targets b)
      (list_append_str (rescues_targets rescues) (list_append_str (deep_targets els) (deep_targets ens)))
  | SAndThen (a, b) -> list_append_str (stmt_targets a) (stmt_targets b)
  | SOrElse (a, b) -> list_append_str (stmt_targets a) (stmt_targets b)
  // an expression statement can declare locals: `/re/ =~ s` (named captures)
  // and one-line pattern matching `x => pat` / `x in pat` — the latter even
  // when nested in a larger expression (`(x in pat).should == y`).
  | SExpr e -> expr_pat_vars e
  | _ -> Nil

// collect variables that an expression declares as locals: named captures from
// `=~`, and pattern variables from any nested one-line `=>` / `in`.
and expr_pat_vars = fn (e: Expr) ->
  match e with
  | EMatchBind (_, pat) -> pat_vars pat
  | EMatchTest (_, pat) -> pat_vars pat
  | EBin (o, a, b) ->
    let capt = if str_eq o "=~" then (match a with ERegex (pat, _) -> rx_capture_names pat 0 | _ -> Nil) else Nil in
    list_append_str capt (list_append_str (expr_pat_vars a) (expr_pat_vars b))
  | EUn (_, a) -> expr_pat_vars a
  | EMethod (recv, _, args) -> list_append_str (expr_pat_vars recv) (exprs_pat_vars args)
  | EMethodB (recv, _, args, _, _) -> list_append_str (expr_pat_vars recv) (exprs_pat_vars args)
  | ECall (_, args) -> exprs_pat_vars args
  | ECallB (_, args, _, _) -> exprs_pat_vars args
  | ETern (a, b, c) -> list_append_str (expr_pat_vars a) (list_append_str (expr_pat_vars b) (expr_pat_vars c))
  | EArr es -> exprs_pat_vars es
  | EHsh es -> exprs_pat_vars es
  | ESafe (recv, _, args) -> list_append_str (expr_pat_vars recv) (exprs_pat_vars args)
  | EAssign (_, v) -> expr_pat_vars v
  // a statement used as an expression (`case ... end.should ==`) declares the
  // targets that statement would — including a nested case/in's pattern vars.
  | EStmt s -> stmt_targets s
  | _ -> Nil
and exprs_pat_vars = fn (es: Expr list) ->
  match es with Nil -> Nil | Cons (h, t) -> list_append_str (expr_pat_vars h) (exprs_pat_vars t)

and clauses_targets = fn clauses ->
  match clauses with
  | Nil -> Nil
  | Cons (cl, rest) -> let (c, b) = cl in list_append_str (deep_targets b) (clauses_targets rest)

and whens_targets = fn whens ->
  match whens with
  | Nil -> Nil
  | Cons (w, rest) -> let (vs, b) = w in list_append_str (deep_targets b) (whens_targets rest)

and rescues_targets = fn rescues ->
  match rescues with
  | Nil -> Nil
  | Cons (rc, rest) ->
    let (cs, v, b) = rc in list_append_str (deep_targets b) (rescues_targets rest)

and fresh_targets = fn cenv -> fn (names: str list) ->
  match names with
  | Nil -> Nil
  | Cons (n, rest) ->
    let skip = str_len n == 0 || str_eq (char_at n 0) "@" || str_eq (char_at n 0) "$" ||
               str_eq (char_at n 0) "*" || is_upper_first n || map_has cenv n in
    if skip then fresh_targets cenv rest else Cons (n, fresh_targets cenv rest)

and drop_created = fn cenv -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let _ = if map_has cenv n then map_delete cenv n else () in
    drop_created cenv rest

and save_params = fn cenv -> fn (params: str list) -> fn acc ->
  match params with
  | Nil -> acc
  | Cons (p0, r) ->
    // a destructure param `(a,b)` is block-local for each of its leaf names.
    if str_len p0 > 0 && str_eq (char_at p0 0) "(" then
      save_params cenv r (save_name_list cenv (spec_names (substring p0 1 (str_len p0 - 1))) acc)
    else
    let p = if str_len p0 > 0 && (str_eq (char_at p0 0) "*" || str_eq (char_at p0 0) "&" || str_eq (char_at p0 0) ";")
            then substring p0 1 (str_len p0) else p0 in
    if str_eq p "" then save_params cenv r acc
    else save_params cenv r (Cons ((p, map_has cenv p, (if map_has cenv p then map_get cenv p else VNil)), acc))

and save_name_list = fn cenv -> fn (names: str list) -> fn acc ->
  match names with
  | Nil -> acc
  | Cons (p, r) -> save_name_list cenv r (Cons ((p, map_has cenv p, (if map_has cenv p then map_get cenv p else VNil)), acc))

and restore_params = fn cenv -> fn saved ->
  match saved with
  | Nil -> ()
  | Cons (t, r) ->
    let (p, had, v) = t in
    let _ = if had then map_set cenv p v
            else (if map_has cenv p then map_delete cenv p else ()) in
    restore_params cenv r

and flow_value = fn (f: Flow) ->
  match f with FNext v -> v | FReturn v -> v | FRaise v -> v | FBreak v -> v | FLoopNext v -> v

// block arity is lenient: missing args bind nil, extra args are dropped.
and bind_block_params = fn cenv -> fn world -> fn blk -> fn (bdefaults: (str * Expr) list) -> fn (params0: str list) -> fn (argvals0: Val list) -> fn (is_lam: bool) ->
  // numbered parameters: a block without explicit params binds _1.._9.
  let _ = (match params0 with
           | Nil -> bind_numbered cenv argvals0 1
           | _ -> ()) in
  // &blk params bind nil (blocks aren't re-passed through block params).
  let params = strip_block_params params0 in
  let _ = (let b = block_param_name params0 in if str_eq b "" then () else map_set cenv b VNil) in
  // explicit block-locals (`|x; a, b|`, encoded ";name") start as fresh nil
  // locals and are excluded from positional binding (save_params restores the
  // outer binding afterwards, so they do not leak).
  let _ = bind_block_locals cenv params in
  let params = drop_block_locals params in
  // `**kw` (keyword-splat) + explicit `key:` params share ONE trailing
  // kwarg-origin hash (`key:` / `**h`); a positional {...} stays positional
  // (Ruby 3 separation). Peel it once, bind the explicit keywords (a missing
  // required keyword raises ArgumentError), then give **kw the leftover keys.
  // The presence of any keyword param disables auto-splat.
  let dsname = dsplat_name params in
  let params = drop_dsplat params in
  let kws = kw_params params in
  let params = pos_params params in
  let want_kw = (match kws with Nil -> (if str_eq dsname "" then false else true) | _ -> true) in
  let (argvals0, kwhash) = if want_kw then peel_kw_hash argvals0 else (argvals0, (Nil : Val list)) in
  let _ = bind_block_kws cenv world bdefaults kws kwhash in
  let _ = if str_eq dsname "" then () else map_set cenv dsname (mkhash (kwhash_drop kwhash (kw_names_of kws))) in
  // auto-splat: a block with 2+ params given a single value destructures
  // an Array directly, or an object via to_ary. Lambdas do NOT auto-splat —
  // a single argument stays a single argument (with strict arity).
  let argvals =
    (if is_lam then argvals0 else
    (match kws with
     | Cons (_, _) -> argvals0
     | Nil ->
       (match params with
        | Cons (_, Cons (_, _)) ->
          (match argvals0 with
           | Cons (VArr id, Nil) -> deref id
           | Cons (VObj oid, Nil) ->
             // Ruby's protocol: always call respond_to?(:to_ary) first, then
             // to_ary. A user respond_to? (or respond_to_missing?) is honoured
             // so a method_missing/respond_to? mock works; we do NOT shortcut on
             // a real to_ary, because the respond_to? call itself is observable.
             (let (m2, sp2, ocls2, iv2) = world in
              let ocl2 = map_get ocls2 (str_of_int oid) in
              let can = (if has_meth world ocl2 "respond_to?" then
                           truthy (invoke_val_c cenv world blk (VObj oid) "respond_to?" (Cons (VSym "to_ary", Nil)) false)
                         else if responds world (VObj oid) "to_ary" then true
                         else if has_meth world ocl2 "respond_to_missing?" then
                           truthy (invoke_val_c cenv world blk (VObj oid) "respond_to_missing?" (Cons (VSym "to_ary", Cons (VBool false, Nil))) false)
                         else false) in
              if can then
                (match invoke_val_c cenv world blk (VObj oid) "to_ary" Nil false with
                 | VArr aid -> deref aid
                 | VNil -> argvals0
                 | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name (VObj oid) ++ " to Array (" ++ class_name (VObj oid) ++ "#to_ary gives " ++ class_name other ++ ")") in argvals0))
              else argvals0)
           | _ -> argvals0)
        | _ -> argvals0))) in
  // defaults (from the block body's nil-check prologue) drive the Ruby
  // fill order: leading requireds, then trailing requireds, then optionals.
  if has_splat params then
    let before = take_until_splat params in
    let after = after_splat params in
    let sname = splat_name params in
    let pre = req_pre before bdefaults in
    let opts = drop_req_pre before bdefaults in
    let npre = list_str_len pre in
    let nopt = list_str_len opts in
    let na = list_str_len after in
    let nv = vlen argvals in
    let middle = nv - npre - na in
    let middle = if middle < 0 then 0 else middle in
    let kopt = if middle > nopt then nopt else middle in
    let sc = middle - kopt in
    let _ = bind_seq cenv world pre (vtake argvals npre) in
    let _ = bind_defaulted cenv world blk opts bdefaults (vtake (vdrop argvals npre) kopt) in
    let _ = if str_eq sname "" then () else map_set cenv sname (arr_new (vtake (vdrop argvals (npre + kopt)) sc)) in
    let _ = bind_seq cenv world after (vdrop argvals (npre + kopt + sc)) in
    ()
  else
    let pre = req_pre params bdefaults in
    let rest1 = drop_req_pre params bdefaults in
    let opts = opt_run rest1 bdefaults in
    let post = drop_opt_run rest1 bdefaults in
    let npre = list_str_len pre in
    let nopt = list_str_len opts in
    let npost = list_str_len post in
    let nv = vlen argvals in
    let kopt0 = nv - npre - npost in
    let kopt0 = if kopt0 < 0 then 0 else kopt0 in
    let kopt = if kopt0 > nopt then nopt else kopt0 in
    let _ = bind_seq cenv world pre (vtake argvals npre) in
    let _ = bind_defaulted cenv world blk opts bdefaults (vtake (vdrop argvals npre) kopt) in
    let _ = bind_seq cenv world post (vdrop argvals (npre + kopt)) in
    ()

and bind_block_kws = fn cenv -> fn world -> fn (bdefaults: (str * Expr) list) -> fn (kws: str list) -> fn (kwhash: Val list) ->
  match kws with
  | Nil -> ()
  | Cons (p, rest) ->
    let nm = substring p 0 (str_len p - 1) in
    // a keyword arg that is present binds; a missing OPTIONAL keyword binds nil
    // (the body's nil-check prologue then applies its default); a missing
    // REQUIRED keyword (no default) raises ArgumentError.
    let _ =
      if hash_haskey kwhash (VSym nm) then map_set cenv nm (hash_get kwhash (VSym nm))
      else if has_default bdefaults nm then map_set cenv nm VNil
      else (let _ = raise_exc world "ArgumentError" ("missing keyword: :" ++ nm) in ()) in
    bind_block_kws cenv world bdefaults rest kwhash

and bind_numbered = fn cenv -> fn (argvals: Val list) -> fn (n: int) ->
  if n > 9 then ()
  else
    (match argvals with
     | Nil -> let _ = map_set cenv ("_" ++ str_of_int n) VNil in bind_numbered cenv Nil (n + 1)
     | Cons (a, rest) -> let _ = map_set cenv ("_" ++ str_of_int n) a in bind_numbered cenv rest (n + 1))

and bind_block_seq = fn cenv -> fn world -> fn (params: str list) -> fn (argvals: Val list) ->
  match params with
  | Nil -> ()
  | Cons (p, ps) ->
    (match argvals with
     | Nil -> let _ = bind_one_bparam cenv world p VNil in bind_block_seq cenv world ps Nil
     | Cons (a, rest) -> let _ = bind_one_bparam cenv world p a in bind_block_seq cenv world ps rest)

and bind_one_bparam = fn cenv -> fn world -> fn (p: str) -> fn (v: Val) ->
  // a ;block-local always starts nil (it never takes an argument).
  if str_len p > 0 && str_eq (char_at p 0) ";" then
    let _ = map_set cenv (substring p 1 (str_len p)) VNil in ()
  else if str_len p > 0 && str_eq (char_at p 0) "(" then
    bind_destructure cenv world (substring p 1 (str_len p - 1)) v
  else let _ = map_set cenv p v in ()

// bind a destructure spec ("a,(b,c),*r") against a value. An Array spreads; a
// non-Array is coerced via #to_ary (Ruby's destructure protocol), wrapping a
// non-responding object as [obj] and raising TypeError on a bad #to_ary.
and bind_destructure = fn cenv -> fn world -> fn (spec: str) -> fn (v: Val) ->
  let parts = spec_split spec 0 0 "" Nil in
  let vals = (match v with VArr id -> deref id | other -> coerce_massign cenv world other false) in
  bind_spec_parts cenv world parts vals

and bind_spec_parts = fn cenv -> fn world -> fn (parts: str list) -> fn (vals: Val list) ->
  match parts with
  | Nil -> ()
  | Cons (p, ps) ->
    if str_len p > 0 && str_eq (char_at p 0) "*" then
      // splat takes what the trailing fixed parts don't need.
      let nafter = list_str_len ps in
      let take = vlen vals - nafter in
      let take = if take < 0 then 0 else take in
      let nm = substring p 1 (str_len p) in
      let _ = if str_eq nm "" then () else map_set cenv nm (arr_new (vtake vals take)) in
      bind_spec_parts cenv world ps (vdrop vals take)
    else
      (match vals with
       | Nil -> let _ = bind_spec_one cenv world p VNil in bind_spec_parts cenv world ps Nil
       | Cons (a, rest) -> let _ = bind_spec_one cenv world p a in bind_spec_parts cenv world ps rest)

and bind_spec_one = fn cenv -> fn world -> fn (p: str) -> fn (v: Val) ->
  if str_len p > 0 && str_eq (char_at p 0) "(" then
    bind_destructure cenv world (substring p 1 (str_len p - 1)) v
  else if str_eq p "" then ()
  else let _ = map_set cenv p v in ()

// the leaf variable names bound by a destructure spec ("a,(b,c),*r" -> a,b,c,r).
and spec_names = fn (spec: str) -> spec_names_parts (spec_split spec 0 0 "" Nil)
and spec_names_parts = fn (parts: str list) ->
  match parts with
  | Nil -> Nil
  | Cons (p, ps) ->
    let names = (if str_len p > 0 && str_eq (char_at p 0) "(" then spec_names (substring p 1 (str_len p - 1))
                 else if str_len p > 0 && str_eq (char_at p 0) "*" then (let nm = substring p 1 (str_len p) in if str_eq nm "" then (Nil : str list) else Cons (nm, Nil))
                 else if str_eq p "" then (Nil : str list)
                 else Cons (p, Nil)) in
    list_append_str names (spec_names_parts ps)

// split a spec on top-level commas ("a,(b,c),*r" -> [a; (b,c); *r]).
and spec_split = fn (spec: str) -> fn (i: int) -> fn (depth: int) -> fn (cur: str) -> fn (acc: str list) ->
  if i >= str_len spec then rev_app (Cons (cur, acc)) Nil
  else
    let c = char_at spec i in
    if str_eq c "(" then spec_split spec (i + 1) (depth + 1) (cur ++ c) acc
    else if str_eq c ")" then spec_split spec (i + 1) (depth - 1) (cur ++ c) acc
    else if str_eq c "," && depth == 0 then spec_split spec (i + 1) depth "" (Cons (cur, acc))
    else spec_split spec (i + 1) depth (cur ++ c) acc

// block predicates on a list (run the block per element, short-circuiting).
and arr_detect = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then h else arr_detect world encl theblk t

and arr_any = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VBool false
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then VBool true else arr_any world encl theblk t

and arr_all = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VBool true
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then arr_all world encl theblk t else VBool false

and arr_none = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VBool true
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then VBool false else arr_none world encl theblk t

and arr_find_index = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then VInt i else arr_find_index world encl theblk t (i + 1)

// run an object's user `each` with a collector block, returning the yielded
// values as a fresh array (the basis of the synthesized Enumerable methods).
and enum_collect = fn world -> fn (recv: Val) -> fn (cls: str) ->
  let accv = arr_new Nil in
  (match accv with
   | VArr _ ->
     let cenv = map_new () in
     let _ = map_set cenv "__acc" accv in
     // splat param: a multi-value yield gathers as an array element,
     // a single-value yield stays the bare value (Enumerable#to_a rules).
     let collector = (true, Cons ("*__e", Nil),
                      Cons (SExpr (EMethod (EVar "__acc", "push",
                        Cons (ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                                     EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                                     EVar "__e"), Nil))), Nil),
                      cenv) in
     let _ = invoke world collector recv cls "each" Nil in accv
   | _ -> accv)

// cycle: iterate the list n times (n < 0 = forever, until a break unwinds).
and arr_cycle = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (n: int) ->
  if n == 0 then FNext VNil
  // cycling an empty collection yields nothing and returns nil immediately.
  else if (match xs with Nil -> true | _ -> false) then FNext VNil
  else
    let _ = tick () in
    (match arr_each world encl theblk xs with
     | FNext _ -> arr_cycle world encl theblk xs (if n < 0 then n else n - 1)
     | other -> other)

// enumerable methods that, called WITHOUT a block, return an Enumerator.
and enum_needs_block = fn (name: str) ->
  str_eq name "map" || str_eq name "collect" || str_eq name "select" || str_eq name "filter" ||
  str_eq name "reject" || str_eq name "detect" || str_eq name "find" || str_eq name "find_all" ||
  str_eq name "flat_map" || str_eq name "collect_concat" || str_eq name "partition" ||
  str_eq name "group_by" || str_eq name "sort_by" || str_eq name "min_by" || str_eq name "max_by" ||
  str_eq name "minmax_by" || str_eq name "each_with_index" || str_eq name "each_with_object" ||
  str_eq name "filter_map" || str_eq name "take_while" || str_eq name "drop_while" ||
  str_eq name "each_entry" || str_eq name "chunk" || str_eq name "chunk_while" ||
  str_eq name "slice_when" || str_eq name "reverse_each" || str_eq name "each_char" ||
  str_eq name "each_byte" || str_eq name "each_line"

and is_enum_method = fn (name: str) ->
  str_eq name "map" || str_eq name "collect" || str_eq name "select" || str_eq name "filter" ||
  str_eq name "reject" || str_eq name "detect" || str_eq name "find" || str_eq name "find_index" ||
  str_eq name "index" || str_eq name "any?" || str_eq name "all?" || str_eq name "none?" ||
  str_eq name "count" || str_eq name "reduce" || str_eq name "inject" || str_eq name "each_with_index" ||
  str_eq name "to_a" || str_eq name "entries" || str_eq name "first" || str_eq name "include?" ||
  str_eq name "member?" || str_eq name "min" || str_eq name "max" || str_eq name "sort" ||
  str_eq name "sum" || str_eq name "flat_map" ||
  str_eq name "partition" || str_eq name "group_by" || str_eq name "each_with_object" ||
  str_eq name "filter_map" || str_eq name "take_while" || str_eq name "drop_while" ||
  str_eq name "take" || str_eq name "drop" || str_eq name "tally" || str_eq name "zip" ||
  str_eq name "uniq" || str_eq name "compact" || str_eq name "chunk_while" ||
  str_eq name "slice_when" || str_eq name "sort_by" || str_eq name "min_by" ||
  str_eq name "max_by" || str_eq name "minmax" || str_eq name "minmax_by" ||
  str_eq name "find_all" || str_eq name "one?" || str_eq name "grep" || str_eq name "grep_v" ||
  str_eq name "reverse_each" || str_eq name "each_entry" || str_eq name "to_h" ||
  str_eq name "cycle"

// built-in block-taking iterators on primitive receivers. `encl` is the
// enclosing method's block (threaded so a yield inside the iterated block
// reaches it); `theblk` is the block being iterated.
and builtin_iter = fn world -> fn encl -> fn theblk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  // each iterator returns a Flow: FBreak v (a `break v` fired — that value
  // becomes the whole call's result) or FNext <natural result>.
  match recv with
  // String iterators with a block (each_char/each_byte/each_line); other
  // enum methods iterate the chars.
  | VStr h ->
    (let sv = sget h in
     if str_eq name "each_char" then iter_each_result (arr_each world encl theblk (utf8_chars_val sv 0)) recv
     else if str_eq name "each_byte" then iter_each_result (arr_each world encl theblk (str_bytes_val sv 0)) recv
     else if str_eq name "each_line" then iter_each_result (arr_each world encl theblk (val_list_of_strs (str_lines_go sv 0 0 (str_len sv)))) recv
     else if str_eq name "each_with_index" then iter_each_result (arr_each world encl theblk (with_index_pairs (utf8_chars_val sv 0) 0)) recv
     else prim_method recv name args)
  | VArr id -> let xs = deref id in
    if str_eq name "each" then iter_each_result (arr_each world encl theblk xs) recv
    else if str_eq name "map" || str_eq name "collect" then iter_result (arr_map world encl theblk xs Nil) recv
    else if str_eq name "select" then iter_result (arr_filter world encl theblk xs Nil true) recv
    else if str_eq name "reject" then iter_result (arr_filter world encl theblk xs Nil false) recv
    else if str_eq name "each_with_index" then iter_each_result (arr_each_idx world encl theblk xs 0) recv
    else if str_eq name "reduce" || str_eq name "inject" then
      (match args with
       | Cons (init, _) -> iter_result (arr_reduce world encl theblk xs init) recv
       | Nil -> (match xs with Nil -> VNil | Cons (h, t) -> iter_result (arr_reduce world encl theblk t h) recv))
    else if str_eq name "count" then iter_result (arr_count_blk world encl theblk xs 0) recv
    else if str_eq name "detect" || str_eq name "find" then arr_detect world encl theblk xs
    else if str_eq name "any?" then arr_any world encl theblk xs
    else if str_eq name "all?" then arr_all world encl theblk xs
    else if str_eq name "none?" then arr_none world encl theblk xs
    else if str_eq name "find_index" || str_eq name "index" then arr_find_index world encl theblk xs 0
    else if str_eq name "flat_map" || str_eq name "collect_concat" then
      (match arr_map world encl theblk xs Nil with
       | FNext (VArr id) -> iter_result (FNext (arr_new (flatten1 (deref id)))) recv
       | other -> iter_result other recv)
    else if str_eq name "min_by" then arr_min_by world encl theblk xs false
    else if str_eq name "max_by" then arr_min_by world encl theblk xs true
    else if str_eq name "minmax_by" then arr_new (Cons (arr_min_by world encl theblk xs false, Cons (arr_min_by world encl theblk xs true, Nil)))
    else if str_eq name "chunk" then arr_new (arr_chunk world encl theblk xs)
    else if str_eq name "slice_when" then arr_new (arr_slice_when world encl theblk xs)
    else if str_eq name "chunk_while" then arr_new (arr_chunk_while world encl theblk xs)
    else if str_eq name "sort_by" then iter_result (FNext (arr_new (extract_vals (sort_by_key (arr_keyed world encl theblk xs))))) recv
    else if str_eq name "sum" then (match args with Cons (init, _) -> arr_sum_blk world encl theblk xs init | Nil -> arr_sum_blk world encl theblk xs (VInt 0))
    else if str_eq name "partition" then arr_partition world encl theblk xs Nil Nil
    else if str_eq name "group_by" then arr_group_by world encl theblk xs Nil
    else if str_eq name "each_with_object" then (match args with Cons (o, _) -> arr_each_with_object world encl theblk xs o | Nil -> VNil)
    else if str_eq name "take_while" then iter_result (arr_take_while world encl theblk xs Nil) recv
    else if str_eq name "drop_while" then iter_result (arr_drop_while world encl theblk xs) recv
    else if str_eq name "filter_map" then iter_result (arr_filter_map world encl theblk xs Nil) recv
    else if str_eq name "find_all" then iter_result (arr_filter world encl theblk xs Nil true) recv
    else if str_eq name "reverse_each" then iter_each_result (arr_reverse_each world encl theblk xs) recv
    else if str_eq name "one?" then
      (match arr_count_blk world encl theblk xs 0 with
       | FNext (VInt n) -> VBool (n == 1)
       | FBreak v -> v
       | _ -> VBool false)
    else if str_eq name "grep" || str_eq name "grep_v" then
      (match args with
       | Cons (pat, _) ->
         let hits = arr_grep world xs pat (str_eq name "grep_v") in
         iter_result (arr_map world encl theblk hits Nil) recv
       | _ -> arr_new Nil)
    else if str_eq name "each_entry" then iter_each_result (arr_each world encl theblk xs) recv
    else if str_eq name "cycle" then
      // cycle(n = nil): nil/absent = forever; a Float truncates; anything
      // else must #to_int (TypeError otherwise); extra args ArgumentError.
      (match args with
       | Nil -> iter_each_result (arr_cycle world encl theblk xs (0 - 1)) recv
       | Cons (_, Cons (_, _)) -> raise_exc world "ArgumentError" "wrong number of arguments (given 2, expected 0..1)"
       | Cons (VNil, _) -> iter_each_result (arr_cycle world encl theblk xs (0 - 1)) recv
       | Cons (VInt n, _) -> iter_each_result (arr_cycle world encl theblk xs n) recv
       | Cons (VFlt f, _) -> iter_each_result (arr_cycle world encl theblk xs (int_of_float f)) recv
       | Cons (VObj oid2, _) ->
         (let (m9, s9, o9, i9) = world in
          if has_meth world (map_get o9 (str_of_int oid2)) "to_int" then
            (match invoke world (false, (Nil : str list), (Nil : Stmt list), map_new ()) (VObj oid2) (map_get o9 (str_of_int oid2)) "to_int" Nil with
             | VInt n -> iter_each_result (arr_cycle world encl theblk xs n) recv
             | _ -> raise_exc world "TypeError" "can't convert to Integer (to_int gave non-Integer)")
          else raise_exc world "TypeError" ("no implicit conversion into Integer"))
       | _ -> raise_exc world "TypeError" "no implicit conversion into Integer")
    else if str_eq name "each_slice" then (match args with Cons (VInt n, _) -> iter_each_result (arr_each world encl theblk (val_slices xs n)) recv | _ -> recv)
    else if str_eq name "each_cons" then (match args with Cons (VInt n, _) -> iter_each_result (arr_each world encl theblk (val_cons_windows xs n)) recv | _ -> recv)
    else prim_method recv name args
  | VHsh xs -> let xs = hderef xs in
    if str_eq name "each" || str_eq name "each_pair" then iter_each_result (hash_each world encl theblk xs) recv
    else if str_eq name "select" || str_eq name "filter" then iter_result (hash_filter world encl theblk xs Nil true) recv
    else if str_eq name "reject" then iter_result (hash_filter world encl theblk xs Nil false) recv
    else if str_eq name "transform_values" then iter_result (FNext (mkhash (hash_tv world encl theblk xs))) recv
    else if str_eq name "transform_keys" then iter_result (FNext (mkhash (hash_tk world encl theblk xs))) recv
    // other Enumerable methods iterate the [k,v] pairs as an array; the
    // block's |k, v| params auto-splat each pair.
    else builtin_iter world encl theblk (arr_new (hash_to_a xs)) name args
  | VRange (lo, hi, excl) ->
    let last = if excl then hi - 1 else hi in
    if str_eq name "each" then iter_each_result (range_each world encl theblk lo last) recv
    else if str_eq name "map" || str_eq name "collect" then iter_result (range_map world encl theblk lo last Nil) recv
    // other Enumerable methods operate on the materialised elements.
    else builtin_iter world encl theblk (arr_new (range_to_a lo last)) name args
  | VInt n ->
    if str_eq name "times" then iter_each_result (range_each world encl theblk 0 (n - 1)) recv
    else if str_eq name "upto" then
      (match args with
       | Cons (VInt m, _) -> iter_each_result (range_each world encl theblk n m) recv
       | _ -> fail "mere-ruby: upto needs an integer")
    else if str_eq name "downto" then
      (match args with
       | Cons (VInt m, _) -> iter_each_result (range_down world encl theblk n m) recv
       | _ -> fail "mere-ruby: downto needs an integer")
    else if str_eq name "step" then
      (match args with
       | Cons (VInt limit, Cons (VInt by, _)) -> iter_each_result (range_step world encl theblk n limit by) recv
       | Cons (VInt limit, _) -> iter_each_result (range_step world encl theblk n limit 1) recv
       | _ -> fail "mere-ruby: step needs an integer")
    else prim_method recv name args
  | _ -> prim_method recv name args

// unwrap an iterator's Flow: break -> its value; else the iterator's
// natural result (`dflt`, e.g. the receiver, or the value FNext carries).
and iter_result = fn (f: Flow) -> fn (dflt: Val) ->
  match f with FBreak v -> v | FNext v -> v | other -> dflt

// each/times/upto return the RECEIVER on natural completion (their body
// flows return FNext VNil); break still yields the break value.
and iter_each_result = fn (f: Flow) -> fn (recv: Val) ->
  match f with FBreak v -> v | _ -> recv

and arr_each = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> arr_each world encl theblk t)

and arr_map = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> arr_map world encl theblk t (Cons (flow_value f, acc)))

and arr_take_while = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> if truthy (flow_value f) then arr_take_while world encl theblk t (Cons (h, acc)) else FNext (arr_new (val_rev acc Nil)))
and arr_drop_while = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> FNext (arr_new Nil)
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> if truthy (flow_value f) then arr_drop_while world encl theblk t else FNext (arr_new (Cons (h, t))))
and arr_filter_map = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> let r = flow_value f in arr_filter_map world encl theblk t (if truthy r then Cons (r, acc) else acc))
and arr_reverse_each = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  arr_each world encl theblk (val_rev xs Nil)

// keep (want=true) or drop (want=false) elements by block truthiness.
// insertion sort using a block comparator (a.sort { |x,y| ... }).
and sort_blk = fn world -> fn theblk -> fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> insert_blk world theblk h (sort_blk world theblk t)

and insert_blk = fn world -> fn theblk -> fn (x: Val) -> fn (sorted: Val list) ->
  match sorted with
  | Nil -> Cons (x, Nil)
  | Cons (h, t) ->
    let amb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    let c = (match flow_value (run_block world amb theblk (Cons (x, Cons (h, Nil)))) with VInt n -> n | _ -> 0) in
    if c <= 0 then Cons (x, sorted) else Cons (h, insert_blk world theblk x t)

and arr_filter = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) -> fn (want: bool) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f ->
       let keep = if want then truthy (flow_value f) else (if truthy (flow_value f) then false else true) in
       arr_filter world encl theblk t (if keep then Cons (h, acc) else acc) want)

and arr_each_idx = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Cons (VInt i, Nil))) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> arr_each_idx world encl theblk t (i + 1))

and range_each = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (last: int) ->
  if i > last then FNext VNil
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | _ -> range_each world encl theblk (i + 1) last)

// n.downto(m) { |i| }: descending.
and range_down = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (last: int) ->
  if i < last then FNext VNil
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | _ -> range_down world encl theblk (i - 1) last)

// n.step(limit, by) { |i| }: by may be negative (descending).
and range_step = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (limit: int) -> fn (by: int) ->
  if (by > 0 && i > limit) || (by < 0 && i < limit) || by == 0 then FNext VNil
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | _ -> range_step world encl theblk (i + by) limit by)

and range_map = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (last: int) -> fn (acc: Val list) ->
  if i > last then FNext (arr_new (val_rev acc Nil))
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | f -> range_map world encl theblk (i + 1) last (Cons (flow_value f, acc)))

and arr_reduce = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val) ->
  match xs with
  | Nil -> FNext acc
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (acc, Cons (h, Nil))) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> arr_reduce world encl theblk t (flow_value f))

// min_by / max_by: the element whose block value is smallest / largest.
and arr_min_by = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (want_max: bool) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> arr_min_by_go world encl theblk t h (flow_value (run_block world encl theblk (Cons (h, Nil)))) want_max
and arr_min_by_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (best: Val) -> fn (bestk: Val) -> fn (want_max: bool) ->
  match xs with
  | Nil -> best
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    let c = cmp_vals k bestk in
    let better = if want_max then c > 0 else c < 0 in
    if better then arr_min_by_go world encl theblk t h k want_max
    else arr_min_by_go world encl theblk t best bestk want_max

// chunk: group CONSECUTIVE elements sharing a block value -> [key, [elems]].
and arr_chunk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> chunk_go world encl theblk t (flow_value (run_block world encl theblk (Cons (h, Nil)))) (Cons (h, Nil))
and chunk_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (curk: Val) -> fn (curacc: Val list) ->
  match xs with
  | Nil -> Cons (arr_new (Cons (curk, Cons (arr_new (val_rev curacc Nil), Nil))), Nil)
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    if rb_eq k curk then chunk_go world encl theblk t curk (Cons (h, curacc))
    else Cons (arr_new (Cons (curk, Cons (arr_new (val_rev curacc Nil), Nil))),
               chunk_go world encl theblk t k (Cons (h, Nil)))

// chunk_while: keep adjacent elements together WHILE block(prev, cur) is
// truthy (split when it is falsy) — the complement of slice_when.
and arr_chunk_while = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> chunk_while_go world encl theblk t h (Cons (h, Nil))
and chunk_while_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (prev: Val) -> fn (curacc: Val list) ->
  match xs with
  | Nil -> Cons (arr_new (val_rev curacc Nil), Nil)
  | Cons (h, t) ->
    if truthy (flow_value (run_block world encl theblk (Cons (prev, Cons (h, Nil)))))
    then chunk_while_go world encl theblk t h (Cons (h, curacc))
    else Cons (arr_new (val_rev curacc Nil), chunk_while_go world encl theblk t h (Cons (h, Nil)))

// slice_when: start a new run whenever block(prev, cur) is truthy.
and arr_slice_when = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> slice_when_go world encl theblk t h (Cons (h, Nil))
and slice_when_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (prev: Val) -> fn (curacc: Val list) ->
  match xs with
  | Nil -> Cons (arr_new (val_rev curacc Nil), Nil)
  | Cons (h, t) ->
    if truthy (flow_value (run_block world encl theblk (Cons (prev, Cons (h, Nil)))))
    then Cons (arr_new (val_rev curacc Nil), slice_when_go world encl theblk t h (Cons (h, Nil)))
    else slice_when_go world encl theblk t h (Cons (h, curacc))

// sort_by: sort elements by their block value (decorate-sort-undecorate).
and arr_keyed = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    Cons (arr_new (Cons (k, Cons (h, Nil))), arr_keyed world encl theblk t)
and pair_key = fn (p: Val) -> match p with VArr id -> (match deref id with Cons (k, _) -> k | _ -> VNil) | _ -> VNil
and pair_val = fn (p: Val) -> match p with VArr id -> (match deref id with Cons (_, Cons (v, _)) -> v | _ -> VNil) | _ -> VNil
and insert_by_key = fn (p: Val) -> fn (ps: Val list) ->
  match ps with Nil -> Cons (p, Nil) | Cons (h, t) -> if cmp_vals (pair_key p) (pair_key h) <= 0 then Cons (p, ps) else Cons (h, insert_by_key p t)
and sort_by_key = fn (ps: Val list) -> match ps with Nil -> Nil | Cons (h, t) -> insert_by_key h (sort_by_key t)
and extract_vals = fn (ps: Val list) -> match ps with Nil -> Nil | Cons (h, t) -> Cons (pair_val h, extract_vals t)

// Array.new(size[, fill]) / Array.new(other_array) (copy) / Array.new -> [].
and array_new_args = fn (args: Val list) ->
  match args with
  | Cons (VInt n, Cons (d, _)) -> arr_new (val_repeat n d)
  | Cons (VInt n, _) -> arr_new (val_repeat n VNil)
  | Cons (VArr aid, _) -> arr_new (deref aid)
  | _ -> arr_new Nil

// sum with a block: total of the block values (starting from init).
and arr_sum_blk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> arr_sum_blk world encl theblk t (arith_bin "+" acc (flow_value (run_block world encl theblk (Cons (h, Nil)))))

// partition: [elements where block is truthy, the rest].
and arr_partition = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (yes: Val list) -> fn (no: Val list) ->
  match xs with
  | Nil -> arr_new (Cons (arr_new (val_rev yes Nil), Cons (arr_new (val_rev no Nil), Nil)))
  | Cons (h, t) ->
    if truthy (flow_value (run_block world encl theblk (Cons (h, Nil))))
    then arr_partition world encl theblk t (Cons (h, yes)) no
    else arr_partition world encl theblk t yes (Cons (h, no))

// group_by: hash of block-value -> array of elements (first-seen order).
and arr_group_by = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> mkhash acc
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    let lst = (match hash_get acc k with VArr id -> list_append (deref id) (Cons (h, Nil)) | _ -> Cons (h, Nil)) in
    arr_group_by world encl theblk t (hash_put acc k (arr_new lst))

// each_with_object(o): run block with (elem, o) for each; return o.
and arr_each_with_object = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (o: Val) ->
  match xs with
  | Nil -> o
  | Cons (h, t) -> let _ = flow_value (run_block world encl theblk (Cons (h, Cons (o, Nil)))) in arr_each_with_object world encl theblk t o

and arr_count_blk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (n: int) ->
  match xs with
  | Nil -> FNext (VInt n)
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> arr_count_blk world encl theblk t (if truthy (flow_value f) then n + 1 else n))

// hash.each { |k, v| ... } iterates key/value pairs of the flat list.
and hash_each = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       (match run_block world encl theblk (Cons (k, Cons (v, Nil))) with
        | FBreak bv -> FBreak bv | FReturn bv -> FReturn bv
        | _ -> hash_each world encl theblk t)
     | Nil -> FNext VNil)

// hash.select { |k, v| ... } keeps matching pairs, rebuilding a Hash.
// transform_values / transform_keys: block-map the values / keys, keep shape.
and hash_tv = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (k, Cons (flow_value (run_block world encl theblk (Cons (v, Nil))), hash_tv world encl theblk t)) | Nil -> Nil)
and hash_tk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (flow_value (run_block world encl theblk (Cons (k, Nil))), Cons (v, hash_tk world encl theblk t)) | Nil -> Nil)

and hash_filter = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) -> fn (keep: bool) ->
  match xs with
  | Nil -> FNext (mkhash (val_rev acc Nil))
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       (match run_block world encl theblk (Cons (k, Cons (v, Nil))) with
        | FBreak bv -> FBreak bv | FReturn bv -> FReturn bv
        | f -> let cond = truthy (flow_value f) in
               let take = if keep then cond else (if cond then false else true) in
               hash_filter world encl theblk t (if take then Cons (v, Cons (k, acc)) else acc) keep)
     | Nil -> FNext (mkhash (val_rev acc Nil)))

// core methods on primitive receivers (String / Array / Hash / Integer),
// all non-mutating. Indexing (`[]`) and the read-heavy Enumerable methods
// live here; block-taking iterators live in builtin_iter.
// dispatch method `name` on any receiver value (the core of `recv.name`,
// also reused by send/__send__). `vischeck` enforces private on explicit-
// receiver calls; send/__send__ pass false (they bypass visibility).
and hng_key = fn (recv: Val) ->
  match recv with
  | VStr h -> "str:" ++ str_of_int h
  | VArr h -> "arr:" ++ str_of_int h
  | VHsh h -> "hsh:" ++ str_of_int h
  | _ -> ""

// immediates that cannot have a singleton class (Integer/Float/Symbol/...).
and imm_no_singleton = fn (recv: Val) ->
  match recv with VInt _ -> true | VBig _ -> true | VFlt _ -> true | VSym _ -> true | VRat _ -> true | VCpx _ -> true | _ -> false

// does the body define a method/class/constant (needing a definee)?
and body_defines = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (s, rest) ->
    (match s with SDef (_, _, _, _) -> true | SClass (_, _, _) -> true | SClassE (_, _, _) -> true | SAssign (n, _) -> is_upper_first n | _ -> false)
    || body_defines rest

// a builtin binary operator that arith_bin evaluates (used to route an
// alias-to-builtin like `alias_method :plus, :+` to arith_bin).
and is_binary_op_name = fn (s: str) ->
  str_eq s "+" || str_eq s "-" || str_eq s "*" || str_eq s "/" || str_eq s "%" ||
  str_eq s "**" || str_eq s "<<" || str_eq s ">>" || str_eq s "&" || str_eq s "|" ||
  str_eq s "^" || str_eq s "<" || str_eq s ">" || str_eq s "<=" || str_eq s ">=" ||
  str_eq s "<=>"

// resolve an alias-to-builtin along cls's ancestor chain: returns the builtin
// source name (e.g. "+") for `name`, or "" if none.
and blt_alias_lookup = fn world -> fn (anc: str list) -> fn (name: str) ->
  match anc with
  | Nil -> ""
  | Cons (a, rest) ->
    if map_has builtin_alias (a ++ "#" ++ name) then map_get builtin_alias (a ++ "#" ++ name)
    else blt_alias_lookup world rest name

and invoke_val_c = fn env -> fn world -> fn blk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) -> fn (vischeck: bool) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  // a singleton method defined on this exact String/Array/Hash wins.
  let hk = hng_key recv in
  if (if str_eq hk "" then false else true) && map_has hng_store hk && has_meth world (map_get hng_store hk) name then
    invoke world noblk recv (map_get hng_store hk) name args
  // an alias-to-builtin (`alias_method :plus, :+`) delegates under the source
  // builtin name: a binary operator goes through arith_bin (prim_method has no
  // "+"), everything else through prim_method.
  else if (if str_eq hk "" then false else true) && map_has hng_store hk && (if str_eq (blt_alias_lookup world (ancestors_of world (map_get hng_store hk)) name) "" then false else true) then
    (let src = blt_alias_lookup world (ancestors_of world (map_get hng_store hk)) name in
     match args with
     | Cons (arg, _) -> if is_binary_op_name src then arith_bin src recv arg else prim_method recv src args
     | Nil -> prim_method recv src args)
  // an interpolated regex literal materializes here: validate at runtime —
  // a malformed interpolation is a RegexpError (unlike the SyntaxError a
  // malformed LITERAL raises at parse time).
  else if str_eq name "__regex" && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr sp ->
       (let body = sget sp in
        let fl = (match args with Cons (VStr f, _) -> sget f | _ -> "") in
        if rx_validate body fl then VRegex (body, fl)
        else raise_exc world "RegexpError" "invalid regular expression")
     | _ -> VNil)
  // Kernel#method(:name): a bound Method object (NameError when undefined).
  // A user-defined `method` method on the receiver's class wins.
  else if str_eq name "method"
          && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false)
          && (match recv with
              | VObj oid2 -> (let (m9, s9, o9, i9) = world in
                              if has_meth world (map_get o9 (str_of_int oid2)) "method" then false else true)
              | _ -> true) then
    (let nm = (match args with Cons (VSym s2, _) -> s2 | Cons (VStr h2, _) -> sget h2 | _ -> "") in
     let owner = bm_owner_of world recv nm in
     let exists = (if str_eq owner "" then
                     (match recv with
                      | VMain -> (let (m9, _, _, _) = world in map_has m9 nm)
                      | _ -> responds world recv nm)
                   else true) in
     if exists then mk_bound_method world recv owner nm
     else raise_exc world "NameError" ("undefined method '" ++ nm ++ "' for an instance of " ++ display_cls world (dispatch_cls_of world recv)))
  // Enumerable#lazy: a Lazy over any enumerable receiver.
  else if str_eq name "lazy"
          && (match recv with
              | VArr _ -> true | VRange (_, _, _) -> true | VHsh _ -> true
              | VObj oid5 -> (let (m9, s9, o9, i9) = world in
                              let ocl5 = map_get o9 (str_of_int oid5) in
                              (if has_meth world ocl5 "lazy" then false else true)
                              && (has_meth world ocl5 "each" || str_eq ocl5 "Enumerator" || str_eq ocl5 "Enumerator::Chain"))
              | _ -> false) then
    mk_lazy world recv Nil
  // Enumerable#chain(*others): an Enumerator::Chain of self and the others.
  else if str_eq name "chain"
          && (match recv with
              | VArr _ -> true | VRange (_, _, _) -> true | VHsh _ -> true
              | VObj oid4 -> (let (m9, s9, o9, i9) = world in
                              let ocl4 = map_get o9 (str_of_int oid4) in
                              (if has_meth world ocl4 "chain" then false else true)
                              && (has_meth world ocl4 "each" || str_eq ocl4 "Enumerator" || str_eq ocl4 "Enumerator::Chain"))
              | _ -> false) then
    mk_chain world (Cons (recv, args))
  // recv.enum_for(:m) / recv.to_enum(:m) — an Enumerator over recv.m (the
  // bare-call form has its own handler; this is the explicit-receiver one).
  else if (str_eq name "enum_for" || str_eq name "to_enum")
          && (match recv with
              | VObj oid3 -> (let (m9, s9, o9, i9) = world in
                              if has_meth world (map_get o9 (str_of_int oid3)) name then false else true)
              | _ -> true) then
    (match args with
     | Cons (VSym m, _) -> make_enum world recv m
     | Cons (VStr m, _) -> make_enum world recv (sget m)
     | _ -> make_enum world recv "each")
  // `recv.extend(M...)` / bare `extend M` (self is a class/object): mix each
  // module's instance methods into the receiver's singleton class.
  else if str_eq name "extend" && (match recv with VClass _ -> true | VObj _ -> true | _ -> false) then
    (let sc = (match recv with VClass c -> "(sng:" ++ c ++ ")" | VObj id -> "(sng:" ++ str_of_int id ++ ")" | _ -> "") in
     let _ = extend_all sc args in
     recv)
  else
  match recv with
  | VClass c ->
    // a singleton class cannot be instantiated: new / allocate raise TypeError.
    if is_sng_cls c && (str_eq name "new" || str_eq name "allocate") then
      raise_exc world "TypeError" "can't create instance of singleton class"
    else if str_eq c "Class" && str_eq name "new" then
      (let (meths2, sup2, ocls2, iv2) = world in
       let anon = fresh_anon "AnonClass_" in
       let _ = (match args with Cons (VClass sc, _) -> map_set sup2 anon sc | _ -> ()) in
       VClass anon)
    // Module.new — an anonymous module (registered in `modules` so #class is
    // Module); its constants/methods live under the fresh name's namespace.
    else if str_eq c "Module" && str_eq name "new" then
      (let (meths2, sup2, ocls2, iv2) = world in
       let anon = fresh_anon "AnonModule_" in
       let _ = map_set modules anon VNil in
       VClass anon)
    else if str_eq c "Range" && str_eq name "new" then
      // Range.new(lo, hi[, excl]); a nil bound uses the saturating sentinel.
      let lo = (match args with Cons (VInt a, _) -> a | _ -> 0 - 4611686018427387903) in
      let hi = (match args with Cons (_, Cons (VInt b, _)) -> b | _ -> 4611686018427387903) in
      let excl = (match args with Cons (_, Cons (_, Cons (e, _))) -> truthy e | _ -> false) in
      VRange (lo, hi, excl)
    else if str_eq c "Hash" && str_eq name "new" then
      (let hv = mkhash Nil in (match args with Cons (d, _) -> (match hv with VHsh id -> let _ = hdflt_set id d in hv | _ -> hv) | _ -> hv))
    else if str_eq c "Array" && str_eq name "new" then array_new_args args
    // a subclass of Array with no own #initialize behaves as a plain array
    // (Class.new(Array).new([0,1]) is [0,1]); back it with real array storage
    // so #deconstruct and the other array methods work.
    else if str_eq name "new" && (if str_eq c "Array" then false else obj_is_a world c "Array") && (if has_meth world c "initialize" then false else true) then
      // back a subclass instance with real array storage, and tag the handle
      // with the subclass so its own methods dispatch (super reaches Array).
      (let v = array_new_args args in
       let _ = (match v with VArr _ -> map_set hng_store (hng_key v) c | _ -> ()) in v)
    // a subclass of String with no own #initialize is backed by real string
    // storage and tagged so its own methods dispatch (super reaches String).
    else if str_eq name "new" && (if str_eq c "String" then false else obj_is_a world c "String") && (if has_meth world c "initialize" then false else true) then
      (let v = (match args with Cons (VStr h, _) -> mkstr (sget h) | _ -> mkstr "") in
       let _ = (match v with VStr _ -> map_set hng_store (hng_key v) c | _ -> ()) in v)
    // Hash[k => v, ...] / Hash[{...}] and Array[...] constructor syntax.
    else if str_eq c "Hash" && str_eq name "[]" then
      (match args with Cons (VHsh h, _) -> mkhash (hderef h) | _ -> mkhash Nil)
    else if str_eq c "Array" && str_eq name "[]" then arr_new args
    // Module#ruby2_keywords via a receiver path (e.g. `send :ruby2_keywords,
    // :m` routes here): mark the named method, same as the bare-call handler.
    else if str_eq name "ruby2_keywords" && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      (let _ = (match args with
                | Cons (VSym s, _) -> map_set r2k_methods s VNil
                | Cons (VStr s, _) -> map_set r2k_methods (sget s) VNil
                | _ -> ()) in
       VNil)
    // Klass.class_eval("code") / module_eval / *_exec with a string: run the
    // code as class-body statements (def defines methods of the class).
    else if (str_eq name "class_eval" || str_eq name "module_eval" || str_eq name "class_exec" || str_eq name "module_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
      (match args with
       | Cons (VStr code, _) -> let (p2, _) = parse_stmts (lex_go (sget code) 0) Nil in
         // string-form *_eval sets the lexical scope (cref) to the receiver.
         let saved = cur_lex () in let _ = set_lex c in
         let r = flow_value (register_class world c p2) in
         let _ = set_lex saved in r
       | _ -> VClass c)
    // string-form instance_eval on a class/module runs in the receiver's
    // SINGLETON scope: a constant assigned there lands in the singleton
    // class's namespace, not on the class itself (Module::Const stays absent).
    else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
      (match args with
       | Cons (VStr code, _) -> let (p2, _) = parse_stmts (lex_go (sget code) 0) Nil in
         let sng = "(sng:" ++ c ++ ")" in
         let saved = cur_lex () in let _ = set_lex sng in
         let r = flow_value (register_class world sng p2) in
         let _ = set_lex saved in r
       | _ -> VClass c)
    else if str_eq c "Struct" && str_eq name "new" then struct_build world args
    // Encoding class methods: the known encodings, and the locale charmap
    // (always UTF-8 in this interpreter — no locale probing).
    else if str_eq c "Encoding" && str_eq name "list" then
      (let out = map_new () in
       let _ = map_iter enc_objs (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
       arr_new (idx_to_list out 0 (map_len out)))
    else if str_eq c "Encoding" && str_eq name "locale_charmap" then mkstr "UTF-8"
    // Encoding.find: special names resolve to the locale (UTF-8 here);
    // "internal" is nil (no default_internal).
    else if str_eq c "Encoding" && str_eq name "find" then
      (match args with
       | Cons (VStr nh, _) ->
         (let nm2 = sget nh in
          if str_eq nm2 "internal" then VNil
          else
            let canon = (if str_eq nm2 "locale" || str_eq nm2 "external" || str_eq nm2 "filesystem" then "UTF-8" else nm2) in
            if map_has enc_objs canon then map_get enc_objs canon
            else raise_exc world "ArgumentError" ("unknown encoding name - " ++ nm2))
       | _ -> raise_exc world "TypeError" "no implicit conversion into String")
    else if str_eq c "Encoding" && str_eq name "default_external" then
      (if map_has def_ext_enc "v" then map_get def_ext_enc "v"
       else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else VNil)
    else if str_eq c "Encoding" && str_eq name "default_external=" then
      (match args with
       | Cons (v, _) -> let _ = map_set def_ext_enc "v" v in v
       | _ -> VNil)
    else if str_eq c "Encoding" && str_eq name "default_internal" then
      (if map_has def_int_enc "v" then map_get def_int_enc "v" else VNil)
    else if str_eq c "Encoding" && str_eq name "default_internal=" then
      (match args with
       | Cons (VNil, _) -> let _ = (if map_has def_int_enc "v" then map_delete def_int_enc "v" else ()) in VNil
       | Cons (v, _) -> let _ = map_set def_int_enc "v" v in v
       | _ -> VNil)
    // Enumerator.new requires a block (the legacy obj/method form is gone).
    else if str_eq c "Enumerator" && str_eq name "new" then
      raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1..)"
    // File class methods over the native externs (read/write/exist?/...).
    else if str_eq c "File" then
      (if str_eq name "read" then
         (match args with
          | Cons (VStr ph, _) ->
            (let path = sget ph in
             if file_exists path then mkstr (read_file path)
             else raise_exc world "Errno::ENOENT" ("No such file or directory @ rb_sysopen - " ++ path))
          | _ -> raise_exc world "TypeError" "no implicit conversion into String")
       else if str_eq name "write" then
         (match args with
          | Cons (VStr ph, Cons (v, _)) ->
            (let content = (match v with VStr ch -> sget ch | _ -> to_s v) in
             let _ = write_file (sget ph) content in
             VInt (str_len content))
          | _ -> raise_exc world "ArgumentError" "wrong number of arguments")
       else if str_eq name "exist?" || str_eq name "exists?" || str_eq name "file?" then
         (match args with Cons (VStr ph, _) -> VBool (file_exists (sget ph)) | _ -> VBool false)
       else if str_eq name "basename" then
         (match args with Cons (VStr ph, _) -> mkstr (basename_of (sget ph)) | _ -> mkstr "")
       else if str_eq name "dirname" then
         (match args with Cons (VStr ph, _) -> mkstr (dirname_of (sget ph)) | _ -> mkstr "")
       else if str_eq name "join" then mkstr (file_join_go args "")
       else if str_eq name "expand_path" then
         (match args with
          | Cons (VStr ph, _) ->
            (let path = sget ph in
             if str_len path > 0 && str_eq (char_at path 0) "/" then mkstr path
             else mkstr (env_get "PWD" ++ "/" ++ path))
          | _ -> mkstr "")
       else if str_eq name "delete" || str_eq name "unlink" then
         (match args with
          | Cons (VStr ph, _) -> (let _ = run ("rm -f " ++ shq (sget ph)) in VInt 1)
          | _ -> VInt 0)
       else if str_eq name "new" || str_eq name "open" then file_open_obj world args
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for File"))
    // Dir class methods (pwd via env, mkdir via the shell).
    else if str_eq c "Dir" then
      (if str_eq name "pwd" || str_eq name "getwd" then mkstr (env_get "PWD")
       else if str_eq name "mkdir" then
         (match args with
          | Cons (VStr ph, _) -> (let _ = run ("mkdir -p " ++ shq (sget ph)) in VInt 0)
          | _ -> VInt 0)
       else if str_eq name "exist?" || str_eq name "exists?" then
         (match args with Cons (VStr ph, _) -> VBool (file_exists (sget ph)) | _ -> VBool false)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for Dir"))
    // Regexp.new / Regexp.compile: build from a source string (options: an
    // int of IGNORECASE|EXTENDED|MULTILINE bits, true = i, or a flags string).
    else if str_eq c "Regexp" && (str_eq name "new" || str_eq name "compile") then
      (match args with
       | Cons (VStr src, rest) ->
         (let body = sget src in
          let fl = (match rest with
                    | Cons (VBool true, _) -> "i"
                    | Cons (VInt opt, _) ->
                      (if opt - (opt / 2) * 2 == 1 then "i" else "") ++
                      (if (opt / 2) - (opt / 4) * 2 == 1 then "x" else "") ++
                      (if (opt / 4) - (opt / 8) * 2 == 1 then "m" else "")
                    | Cons (VStr fs, _) -> sget fs
                    | _ -> "") in
          if rx_validate body fl then VRegex (body, fl)
          else raise_exc world "RegexpError" "invalid regular expression")
       | Cons (VRegex (b2, f2), _) -> VRegex (b2, f2)
       | _ -> fail "mere-ruby: Regexp.new expects a string")
    // Math module functions (only sqrt-derived ones; no trig/log builtin).
    else if str_eq c "Math" then
      (if str_eq name "sqrt" then (match args with Cons (v, _) -> VFlt (sqrt (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "hypot" then (match args with Cons (a, Cons (b, _)) -> VFlt (sqrt (to_f a * to_f a + to_f b * to_f b)) | _ -> VFlt 0.0)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for Math"))
    else if str_eq name "new" then new_obj world c args
    // an anonymous class/module has no name (nil) until assigned to a constant,
    // at which point anon_name records the constant name.
    else if str_eq name "name" then
      (if map_has anon_name c then map_get anon_name c
       else if is_anon_cls c then VNil
       else mkstr c)
    // Class#superclass: the recorded superclass, else Object (BasicObject has
    // none; Object's is BasicObject).
    else if str_eq name "superclass" then
      (let (_, sup0, _, _) = world in
       if str_eq c "BasicObject" then VNil
       // a singleton class's superclass mirrors the class hierarchy one level
       // up (K.singleton_class.superclass == H.singleton_class when K < H).
       else if is_sng_cls c then VClass (sng_supername world c)
       else if map_has sup0 c then VClass (map_get sup0 c)
       else if str_eq c "Object" then VClass "BasicObject"
       else VClass "Object")
    // Hash.ruby2_keywords_hash?(h): whether h carries the ruby2_keywords flag.
    // mere does not expose that flag on a hash value, so it is never true here
    // (the spec only ever asserts false).
    else if str_eq name "ruby2_keywords_hash?" then VBool false
    else if str_eq name "const_defined?" then
      // look in the receiver's own namespace (C::name); top-level constants
      // live in Object, so Object also consults the bare name.
      (match args with
       | Cons (nv, _) ->
         let n = (match nv with VSym s -> s | VStr s -> sget s | _ -> "") in
         VBool (map_has consts (c ++ "::" ++ n) || (str_eq c "Object" && map_has consts n))
       | _ -> VBool false)
    // instance_method(:name): an UnboundMethod, represented as an
    // UnboundMethod-classed object carrying the origin class (where the method
    // resolves from `c`) and the method name.
    else if str_eq name "instance_method" then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let mname = (match args with Cons (VSym s, _) -> s | Cons (VStr h, _) -> sget h | _ -> "") in
       let origin = if map_has meths0 (c ++ "#" ++ mname) then c else lookup_anc world (ancestors_of world c) mname in
       if str_eq origin "" then raise_exc world "NameError" ("undefined method '" ++ mname ++ "' for class '" ++ c ++ "'")
       else
         (let id = map_len ocls0 in
          let _ = map_set ocls0 (str_of_int id) "UnboundMethod" in
          let _ = map_set ivars0 (str_of_int id ++ "@__um_cls") (mkstr origin) in
          let _ = map_set ivars0 (str_of_int id ++ "@__um_name") (mkstr mname) in
          VObj id))
    // define_method(:name, unbound_or_proc): the non-block form. An
    // UnboundMethod transplants its body into `c` (super then resolves in c's
    // own ancestor chain); a Proc/lambda installs its body as the method.
    else if str_eq name "define_method" && (match args with Cons (_, Cons (_, _)) -> true | _ -> false) then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr h, _) -> sget h | _ -> "") in
       let src = (match args with Cons (_, Cons (s, _)) -> s | _ -> VNil) in
       (match src with
        | VObj uid ->
          if str_eq (map_get ocls0 (str_of_int uid)) "UnboundMethod" then
            (let ucls = (match map_get ivars0 (str_of_int uid ++ "@__um_cls") with VStr h -> sget h | _ -> "") in
             let unm = (match map_get ivars0 (str_of_int uid ++ "@__um_name") with VStr h -> sget h | _ -> "") in
             let _ = if map_has meths0 (ucls ++ "#" ++ unm) then map_set meths0 (c ++ "#" ++ nm) (map_get meths0 (ucls ++ "#" ++ unm)) else () in
             VSym nm)
          else VSym nm
        | VProc pid ->
          (match proc_as_block pid with (h2, ps2, bb2, e2) ->
             let ps2 = (match ps2 with Cons (m, rest) -> if str_eq m lambda_blk_marker then rest else ps2 | _ -> ps2) in
             let _ = map_set meths0 (c ++ "#" ++ nm) (Meth (ps2, Nil, bb2)) in
             let _ = map_set dm_methods (c ++ "#" ++ nm) VNil in
             VSym nm)
        | _ -> VSym nm))
    // instance_methods(false): the method names defined directly on this
    // class, as symbols (enumerated from the method table via map_iter). The
    // inherited form (no arg / true) is not distinguished — own methods only.
    else if str_eq name "instance_methods" then
      // no arg / true: inherited methods included (the ancestor walk of
      // collect_methods, privates excluded); false: own methods only.
      (let inherited = (match args with Cons (VBool false, _) -> false | _ -> true) in
       if inherited then
         (let names = map_new () in
          let _ = collect_methods world c names in
          let out = map_new () in
          let _ = map_iter names (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
          arr_new (idx_to_list out 0 (map_len out)))
       else
         (let (meths0, _, _, _) = world in
          let pfx = c ++ "#" in
          let plen = str_len pfx in
          let tmp = map_new () in
          let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
            if str_len k > plen && str_eq (substring k 0 plen) pfx
               && (if str_contains (substring k plen (str_len k)) "#" then false else true)
            then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
            else ()) in
          arr_new (idx_to_list tmp 0 (map_len tmp))))
    // method_defined? family: resolve the defining ancestor, then check the
    // visibility tables. method_defined? is true for public + protected.
    else if str_eq name "method_defined?" || str_eq name "public_method_defined?" ||
            str_eq name "private_method_defined?" || str_eq name "protected_method_defined?" then
      (let (meths0, _, _, _) = world in
       let nm = (match args with Cons (VSym s2, _) -> s2 | Cons (VStr h2, _) -> sget h2 | _ -> "") in
       let origin = (if map_has meths0 (c ++ "#" ++ nm) then c else lookup_anc world (ancestors_of world c) nm) in
       if str_eq origin "" then VBool false
       else
         // meth_private/meth_protected are the dispatch oracles (they also see
         // the inline `private def` regime, not just the privates table).
         let priv = meth_private world c nm in
         let prot = meth_protected world c nm in
         if str_eq name "method_defined?" then VBool (if priv then false else true)
         else if str_eq name "public_method_defined?" then VBool (if priv || prot then false else true)
         else if str_eq name "private_method_defined?" then VBool priv
         else VBool prot)
    // singleton_methods: the class's own singleton-class methods.
    else if str_eq name "singleton_methods" then
      (let (meths0, _, _, _) = world in
       let pfx = "(sng:" ++ c ++ ")#" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    // private_instance_methods(false) / public_instance_methods(false): the
    // own methods split by the visibility table.
    else if str_eq name "private_instance_methods" || str_eq name "public_instance_methods" then
      (let (meths0, _, _, _) = world in
       let want_priv = str_eq name "private_instance_methods" in
       let pfx = c ++ "#" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
            && (if str_contains (substring k plen (str_len k)) "#" then false else true)
            && (if map_has privates k then want_priv else (if want_priv then false else true))
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    // class variables (@@x) declared directly on this class, as :@@sym.
    else if str_eq name "class_variables" then
      (let pfx = c ++ "@" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter cvars (fn (k: str) -> fn (v: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym ("@@" ++ substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "class_variable_get" then
      (match args with
       | Cons (v, _) -> let nm = ivar_arg_name (ivar_arg_name (to_s v)) in
         (if cvar_overtaken world c nm then raise_exc world "RuntimeError" ("class variable @@" ++ nm ++ " of " ++ c ++ " is overtaken by " ++ c)
          else if cvar_defined_from world c nm then cvar_get_from world c nm
          else raise_exc world "NameError" ("uninitialized class variable @@" ++ nm ++ " in " ++ c))
       | _ -> VNil)
    else if str_eq name "class_variable_set" then
      (match args with
       | Cons (v, Cons (value, _)) -> let nm = ivar_arg_name (ivar_arg_name (to_s v)) in
         let owner0 = cvar_owner world c nm in
         let owner = if str_eq owner0 "" then c else owner0 in
         let _ = map_set cvars (owner ++ "@" ++ nm) value in value
       | _ -> VNil)
    else if str_eq name "class_variable_defined?" then
      (match args with Cons (v, _) -> VBool (map_has cvars (c ++ "@" ++ ivar_arg_name (ivar_arg_name (to_s v)))) | _ -> VBool false)
    else if str_eq name "remove_class_variable" then
      (match args with
       | Cons (v, _) -> let k = c ++ "@" ++ ivar_arg_name (ivar_arg_name (to_s v)) in
         let old = (if map_has cvars k then map_get cvars k else VNil) in
         let _ = if map_has cvars k then map_delete cvars k else () in old
       | _ -> VNil)
    // class-level instance variables (@x on the class object itself), keyed
    // "cls:Name@x" — distinct from an instance's ivars.
    else if str_eq name "instance_variables" then
      (let (_, _, _, ivars0) = world in
       let pfx = "cls:" ++ c ++ "@" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter ivars0 (fn (k: str) -> fn (v: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym ("@" ++ substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "instance_variable_get" then
      (let (_, _, _, ivars0) = world in
       match args with Cons (v, _) -> let k = "cls:" ++ c ++ "@" ++ ivar_arg_name (to_s v) in (if map_has ivars0 k then map_get ivars0 k else VNil) | _ -> VNil)
    else if str_eq name "instance_variable_set" then
      (let (_, _, _, ivars0) = world in
       match args with Cons (v, Cons (value, _)) -> let _ = map_set ivars0 ("cls:" ++ c ++ "@" ++ ivar_arg_name (to_s v)) value in value | _ -> VNil)
    else if str_eq name "instance_variable_defined?" then
      (let (_, _, _, ivars0) = world in
       match args with Cons (v, _) -> VBool (map_has ivars0 ("cls:" ++ c ++ "@" ++ ivar_arg_name (to_s v))) | _ -> VBool false)
    else if str_eq name "remove_instance_variable" then
      (let (_, _, _, ivars0) = world in
       match args with
       | Cons (v, _) -> let k = "cls:" ++ c ++ "@" ++ ivar_arg_name (to_s v) in
         let old = (if map_has ivars0 k then map_get ivars0 k else VNil) in
         let _ = if map_has ivars0 k then map_delete ivars0 k else () in old
       | _ -> VNil)
    // singleton_class of a class/module: a distinct class whose namespace
    // holds the constants/methods defined via the object's instance_eval.
    else if str_eq name "singleton_class" then VClass ("(sng:" ++ c ++ ")")
    // respond_to? on a class/module (also reachable via send).
    else if str_eq name "respond_to?" then
      (match args with
       | Cons (VSym m, _) -> VBool (responds world recv m)
       | Cons (VStr m, _) -> let m = sget m in VBool (responds world recv m)
       | _ -> VBool false)
    // Module#ancestors: the lookup chain (self, included modules, supers);
    // for a singleton class this is the metaclass chain down to Class.
    else if str_eq name "ancestors" then
      arr_new (anc_vclasses (ancestors_of world c))
    // is_a?/kind_of?: a class/module is an INSTANCE of Class/Module (a singleton
    // class of Class's singleton class at the same nesting); walk that chain.
    // instance_of? checks the exact class only.
    else if str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?" then
      (match args with
       | Cons (VClass t, _) ->
         let rc = metaclass_class c in
         if str_eq name "instance_of?" then VBool (str_eq rc t) else VBool (obj_is_a world rc t)
       | _ -> VBool false)
    // constants: the constant names scoped directly under this class/module
    // (stored "Name::Const"), as symbols. Enumerated from the constant table.
    else if str_eq name "constants" then
      (let pfx = c ++ "::" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter consts (fn (k: str) -> fn (v: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
            && (if str_contains (substring k plen (str_len k)) "::" then false else true)
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    // alias_method(new, old): the method form of `alias` — copy the method.
    else if str_eq name "alias_method" then
      (let (methsA, _, _, _) = world in
       match args with
       | Cons (a, Cons (b, _)) ->
         let n1 = (match a with VSym s -> s | VStr h -> sget h | _ -> "") in
         let n2 = (match b with VSym s -> s | VStr h -> sget h | _ -> "") in
         // resolve the source through the ancestor chain (an alias can name an
         // inherited/included method), and remember the origin so a `super`
         // inside the aliased method resumes above where the source was defined.
         let origin = if map_has methsA (c ++ "#" ++ n2) then c
                      else lookup_anc world (ancestors_of world c) n2 in
         let _ = if map_has methsA (origin ++ "#" ++ n2) then
                   (let _ = map_set methsA (c ++ "#" ++ n1) (map_get methsA (origin ++ "#" ++ n2)) in
                    let _ = if str_eq origin c then () else map_set alias_origin (c ++ "#" ++ n1) origin in
                    if str_eq n1 n2 then () else map_set alias_srcname (c ++ "#" ++ n1) n2)
                 // source is a builtin (no AST body) — remember it delegates to
                 // prim_method under the builtin name (e.g. String#+).
                 else map_set builtin_alias (c ++ "#" ++ n1) n2 in
         VSym n1
       | _ -> VNil)
    // GC.start / GC.enable / GC.disable / GC.stress= are no-ops.
    else if str_eq c "GC" && (str_eq name "start" || str_eq name "enable" || str_eq name "disable" || str_eq name "stress=" || str_eq name "stress") then VNil
    // remove_const(:Name) deletes the constant, returning its value.
    else if str_eq name "remove_const" then
      (match args with
       | Cons (v, _) ->
         // the receiver's own constant is keyed qualified (C::N); a top-level
         // constant (self=Object or main) is keyed bare.
         let n0 = to_s v in
         let qn = c ++ "::" ++ n0 in
         let n = if map_has consts qn then qn else n0 in
         let old = if map_has consts n then map_get consts n else VNil in
         let _ = if map_has consts n then map_delete consts n else () in
         old
       | _ -> VNil)
    // remove_method(:m) / undef_method(:m): drop the instance method m from
    // this class (used e.g. on a singleton class to undo a class method).
    else if str_eq name "remove_method" || str_eq name "undef_method" then
      (let (meths0, _, _, _) = world in
       let _ = (match args with
                | Cons (v, _) -> let key = c ++ "#" ++ to_s v in if map_has meths0 key then map_delete meths0 key else ()
                | _ -> ()) in
       recv)
    // const_get(:Name) reads a constant; const_set(:Name, v) defines one.
    else if str_eq name "const_get" then
      (match args with
       | Cons (v, _) -> let n = to_s v in (if map_has consts n then map_get consts n
                                           else if map_has consts (c ++ "::" ++ n) then map_get consts (c ++ "::" ++ n)
                                           else raise_exc world "NameError" ("uninitialized constant " ++ n))
       | _ -> VNil)
    else if str_eq name "const_set" then
      (match args with
       | Cons (v, Cons (value, _)) -> let _ = map_set consts (to_s v) value in value
       | _ -> VNil)
    else if has_meth world ("(sng:" ++ c ++ ")") name then
      (if vischeck && meth_private world ("(sng:" ++ c ++ ")") name
       then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for " ++ c)
       else invoke world noblk recv ("(sng:" ++ c ++ ")") name args)
    // a class object is an instance of Class < Module, so user methods on
    // Module/Class are callable on any class.
    else if has_meth world "Module" name then invoke world noblk recv "Module" name args
    else if has_meth world "Class" name then invoke world noblk recv "Class" name args
    else prim_method recv name args
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls (str_of_int id) in
    if has_meth world cls name then
      (if vischeck && meth_private world cls name
       then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for an instance of " ++ display_cls world cls)
       else if vischeck && meth_protected world cls name && (if protected_ok env world cls then false else true)
       then raise_exc world "NoMethodError" ("protected method '" ++ name ++ "' called for an instance of " ++ display_cls world cls)
       else invoke world noblk recv cls name args)
    else if str_eq name "class" then VClass (display_cls world cls)
    // Object#methods: public + protected method names reachable from this
    // object (its class and ancestors, plus any singleton methods), as
    // symbols, excluding privates. `include(:sym)`-style membership only, so
    // order is unspecified.
    else if str_eq name "methods" || str_eq name "public_methods" then
      (let names = map_new () in
       let _ = collect_methods world cls names in
       let out = map_new () in
       let _ = map_iter names (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
       arr_new (idx_to_list out 0 (map_len out)))
    // Object#singleton_methods: methods defined on this object's singleton.
    else if str_eq name "singleton_methods" then
      (let (meths9, _, _, _) = world in
       let pfx = "(sng:" ++ str_of_int id ++ ")#" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter meths9 (fn (k: str) -> fn (v: Meth) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "instance_variable_get" then
      (match args with Cons (v, _) -> let k = str_of_int id ++ "@" ++ ivar_arg_name (to_s v) in (if map_has ivars k then map_get ivars k else VNil) | _ -> VNil)
    else if str_eq name "instance_variable_set" then
      (match args with Cons (v, Cons (value, _)) -> let _ = map_set ivars (str_of_int id ++ "@" ++ ivar_arg_name (to_s v)) value in value | _ -> VNil)
    else if str_eq name "instance_variable_defined?" then
      (match args with Cons (v, _) -> VBool (map_has ivars (str_of_int id ++ "@" ++ ivar_arg_name (to_s v))) | _ -> VBool false)
    else if str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?" then
      (match args with Cons (VClass c, _) -> VBool (obj_is_a world cls c) | _ -> VBool false)
    // an object's singleton class (created on first use).
    else if str_eq name "singleton_class" then VClass (singleton_cls_of world id)
    // bound Method objects (Kernel#method): call/[]/===, reflection getters,
    // unbind, to_proc (a proc closing over the receiver).
    else if str_eq cls "Method" then
      (let mnm = (match map_get ivars (str_of_int id ++ "@__m_name") with VStr h -> sget h | _ -> "") in
       let mown = (match map_get ivars (str_of_int id ++ "@__m_owner") with VStr h -> sget h | _ -> "") in
       let mrecv = (if map_has ivars (str_of_int id ++ "@__m_recv") then map_get ivars (str_of_int id ++ "@__m_recv") else VMain) in
       if str_eq name "call" || str_eq name "[]" || str_eq name "===" then
         (match mrecv with
          | VMain -> call_method env world blk mnm args
          | _ -> invoke_val_c env world blk mrecv mnm args false)
       else if str_eq name "name" then VSym mnm
       else if str_eq name "receiver" then mrecv
       else if str_eq name "owner" then (if str_eq mown "" then VClass (class_name mrecv) else VClass mown)
       else if str_eq name "arity" then VInt (bm_arity world mown mnm)
       else if str_eq name "unbind" then
         (let uid = map_len ocls in
          let _ = map_set ocls (str_of_int uid) "UnboundMethod" in
          let _ = map_set ivars (str_of_int uid ++ "@__um_cls") (mkstr (if str_eq mown "" then class_name mrecv else mown)) in
          let _ = map_set ivars (str_of_int uid ++ "@__um_name") (mkstr mnm) in
          VObj uid)
       else if str_eq name "to_proc" then
         (let benv = map_new () in
          let _ = map_set benv "__m_self" mrecv in
          let body = (match mrecv with
                      | VMain -> Cons (SExpr (ECall (mnm, Cons (ESplat (EVar "__a"), Nil))), Nil)
                      | _ -> Cons (SExpr (EMethod (EVar "__m_self", mnm, Cons (ESplat (EVar "__a"), Nil))), Nil)) in
          let pid = map_len proc_store in
          let _ = map_set proc_store (str_of_int pid) (true, Cons ("*__a", Nil), body, benv) in
          VProc pid)
       else if str_eq name "inspect" || str_eq name "to_s" then
         mkstr ("#<Method: " ++ (if str_eq mown "" then class_name mrecv else mown) ++ "#" ++ mnm ++ ">")
       else if str_eq name "==" || str_eq name "eql?" then
         (match args with
          | Cons (VObj oid2, _) ->
            VBool (str_eq (map_get ocls (str_of_int oid2)) "Method"
                   && str_eq (to_s (map_get ivars (str_of_int oid2 ++ "@__m_name"))) mnm
                   && rb_identical mrecv (if map_has ivars (str_of_int oid2 ++ "@__m_recv") then map_get ivars (str_of_int oid2 ++ "@__m_recv") else VMain))
          | _ -> VBool false)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Method"))
    // Enumerator::Yielder: << / yield / call forward to the driving block.
    // A break from that block (a bounded materialization) propagates as a
    // break flow so the generator's own loop stops.
    else if str_eq cls "Enumerator::Yielder" then
      (if str_eq name "<<" || str_eq name "yield" || str_eq name "call" then
         (match (if map_has ivars (str_of_int id ++ "@__y_blk") then map_get ivars (str_of_int id ++ "@__y_blk") else VNil) with
          | VProc bpid ->
            (match run_block world (false, (Nil : str list), (Nil : Stmt list), env) (map_get proc_store (str_of_int bpid)) args with
             | FBreak v -> raise_exc world "StopIteration" "iteration reached an end"
             | FNext r -> (if str_eq name "<<" then recv else r)
             | other -> (if str_eq name "<<" then recv else flow_value other))
          | _ -> VNil)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Enumerator::Yielder"))
    // the lazy-pipeline driver callback (see lz_run).
    else if str_eq cls "Enumerator::LzDrv" && str_eq name "__lzstep" then
      (let v = (match args with
                | Cons (a1, Nil) -> a1
                | Nil -> VNil
                | _ -> arr_new args) in
       lz_step env world blk id v)
    // File handles from File.open/File.new: buffered writes, read-through
    // reads, #gets tracked by @__f_pos.
    else if str_eq cls "File" && map_has ivars (str_of_int id ++ "@__f_path") then
      (let k = str_of_int id in
       let path = (match map_get ivars (k ++ "@__f_path") with VStr h -> sget h | _ -> "") in
       let mode = (match map_get ivars (k ++ "@__f_mode") with VStr h -> sget h | _ -> "") in
       if str_eq name "read" then mkstr (if file_exists path then read_file path else "")
       else if str_eq name "write" || str_eq name "print" || str_eq name "<<" then
         (let piece = io_join_go args "" in
          let cur = (match map_get ivars (k ++ "@__f_buf") with VStr h -> sget h | _ -> "") in
          let _ = map_set ivars (k ++ "@__f_buf") (mkstr (cur ++ piece)) in
          if str_eq name "<<" then recv
          else if str_eq name "write" then VInt (str_len piece) else VNil)
       else if str_eq name "puts" then
         (let piece = file_puts_str args "" in
          let cur = (match map_get ivars (k ++ "@__f_buf") with VStr h -> sget h | _ -> "") in
          let _ = map_set ivars (k ++ "@__f_buf") (mkstr (cur ++ piece)) in
          VNil)
       else if str_eq name "gets" || str_eq name "readline" then
         (let content = (if file_exists path then read_file path else "") in
          let pos = (match map_get ivars (k ++ "@__f_pos") with VInt n -> n | _ -> 0) in
          if pos >= str_len content then
            (if str_eq name "readline" then raise_exc world "EOFError" "end of file reached" else VNil)
          else
            let e = line_end_from content pos in
            let _ = map_set ivars (k ++ "@__f_pos") (VInt e) in
            mkstr (substring content pos e))
       else if str_eq name "each_line" || str_eq name "readlines" then
         (let content = (if file_exists path then read_file path else "") in
          let av = file_lines_arr content 0 in
          if str_eq name "readlines" then av
          else invoke_val_c env world blk av "each" Nil vischeck)
       else if str_eq name "close" then (let _ = file_close_obj world id in VNil)
       else if str_eq name "closed?" then VBool (str_eq mode "")
       else if str_eq name "path" || str_eq name "to_path" then mkstr path
       else if str_eq name "rewind" then (let _ = map_set ivars (k ++ "@__f_pos") (VInt 0) in VInt 0)
       else if str_eq name "eof?" || str_eq name "eof" then
         (let content = (if file_exists path then read_file path else "") in
          let pos = (match map_get ivars (k ++ "@__f_pos") with VInt n -> n | _ -> 0) in
          VBool (pos >= str_len content))
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of File"))
    // STDOUT / STDERR: IO objects keyed by @__io_fd (1 = out, 2 = err).
    else if str_eq cls "IO" && map_has ivars (str_of_int id ++ "@__io_fd") then
      (let fd = (match map_get ivars (str_of_int id ++ "@__io_fd") with VInt n -> n | _ -> 1) in
       if str_eq name "puts" then
         (let _ = (if fd == 2 then (match args with Nil -> print_err "" | _ -> err_puts_each world args)
                   else (match args with Nil -> out_print "" | _ -> puts_each world args)) in
          VNil)
       else if str_eq name "print" then
         (let _ = (if fd == 2 then print_err (io_join_go args "") else print_each world args) in VNil)
       else if str_eq name "write" then
         (let s2 = io_join_go args "" in
          let _ = (if fd == 2 then print_err s2 else out_print_no_nl s2) in
          VInt (str_len s2))
       else if str_eq name "<<" then
         (let s2 = io_join_go args "" in
          let _ = (if fd == 2 then print_err s2 else out_print_no_nl s2) in
          recv)
       else if str_eq name "flush" || str_eq name "sync=" then recv
       else if str_eq name "sync" then VBool false
       else if str_eq name "fileno" then VInt fd
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of IO"))
    // ENV: reads consult the write overlay first, then the real environment
    // (env_is_set + getenv, so set-but-empty reads as "" like Ruby).
    else if str_eq cls "EnvHash" then
      (if str_eq name "[]" then
         (match args with Cons (kv, _) -> env_lookup_v (env_key_of env world kv) | _ -> VNil)
       else if str_eq name "[]=" || str_eq name "store" then
         (match args with
          | Cons (kv, Cons (v, _)) -> let _ = map_set env_ovr (env_key_of env world kv) v in v
          | _ -> VNil)
       else if str_eq name "fetch" then
         (match args with
          | Cons (kv, rest) ->
            let k2 = env_key_of env world kv in
            (match env_lookup_v k2 with
             | VNil -> (match rest with
                        | Cons (d, _) -> d
                        | Nil -> raise_exc world "KeyError" ("key not found: \"" ++ k2 ++ "\""))
             | v -> v)
          | _ -> VNil)
       else if str_eq name "key?" || str_eq name "has_key?" || str_eq name "include?" || str_eq name "member?" then
         (match args with
          | Cons (kv, _) -> VBool (match env_lookup_v (env_key_of env world kv) with VNil -> false | _ -> true)
          | _ -> VBool false)
       else if str_eq name "delete" then
         (match args with
          | Cons (kv, _) ->
            let k2 = env_key_of env world kv in
            let old = env_lookup_v k2 in
            let _ = map_set env_ovr k2 VNil in
            old
          | _ -> VNil)
       else if str_eq name "assoc" then
         (match args with
          | Cons (kv, _) ->
            (let k2 = env_key_of env world kv in
             match env_lookup_v k2 with
             | VNil -> VNil
             | v -> arr_new (Cons (mkstr k2, Cons (v, Nil))))
          | _ -> VNil)
       // reverse lookup: the overlay first, then the environ dump.
       else if str_eq name "key" then
         (match args with
          | Cons (kv, _) ->
            let target = env_key_of env world kv in
            let hit = map_new () in
            let _ = map_iter env_ovr (fn (k2: str) -> fn (v: Val) ->
              (match v with
               | VStr h -> if str_eq (sget h) target && (if map_has hit "k" then false else true)
                           then map_set hit "k" (mkstr k2) else ()
               | _ -> ())) in
            (if map_has hit "k" then map_get hit "k"
             else env_key_scan (env_all_pairs ()) target)
          | _ -> VNil)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for ENV"))
    // Enumerator::Lazy surface without a block: take/drop extend the pipeline,
    // first/to_a/force run it (bounded), eager materializes.
    else if str_eq cls "Enumerator::Lazy" then
      (if str_eq name "take" || str_eq name "drop" then
         (match args with
          | Cons (VInt n, _) -> lz_extend world id name (VInt n)
          | _ -> raise_exc world "ArgumentError" "wrong number of arguments")
       else if str_eq name "first" then
         (match args with
          | Cons (VInt n, _) -> lz_run env world blk id n VNil
          | _ -> (match lz_run env world blk id 1 VNil with
                  | VArr aid -> val_nth (deref aid) 0
                  | _ -> VNil))
       else if str_eq name "to_a" || str_eq name "force" then lz_run env world blk id (0 - 1) VNil
       else if str_eq name "eager" then make_enum world (lz_run env world blk id (0 - 1) VNil) "each"
       else if str_eq name "lazy" then recv
       else if str_eq name "inspect" || str_eq name "to_s" then mkstr "#<Enumerator::Lazy>"
       else if is_enum_method name then
         invoke_val_c env world blk (lz_run env world blk id (0 - 1) VNil) name args vischeck
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Enumerator::Lazy"))
    // Enumerator#+ / Chain#+: a chain of self and the given enumerators.
    else if (str_eq cls "Enumerator" || str_eq cls "Enumerator::Chain") && str_eq name "+" then
      (let base = (if str_eq cls "Enumerator::Chain" then chain_srcs world id else Cons (recv, Nil)) in
       mk_chain world (list_append base args))
    // Enumerator::Chain surface: each is handled by the block dispatcher;
    // everything enumerable materializes.
    else if str_eq cls "Enumerator::Chain"
            && (is_enum_method name || str_eq name "size" || str_eq name "each_slice" || str_eq name "each_cons") then
      (let av = chain_to_arr env world blk id in
       invoke_val_c env world blk av name args vischeck)
    // Enumerator#inspect: "#<Enumerator: <recv>:<meth>(args)>".
    else if str_eq cls "Enumerator" && (str_eq name "inspect" || str_eq name "to_s") then
      (if map_has ivars (str_of_int id ++ "@recv") then
         (let recv2 = map_get ivars (str_of_int id ++ "@recv") in
          let meth2 = to_s (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else mkstr "each") in
          let argstr = (match (if map_has ivars (str_of_int id ++ "@eargs") then map_get ivars (str_of_int id ++ "@eargs") else VNil) with
                        | VArr aid2 -> "(" ++ enum_args_str (deref aid2) ++ ")"
                        | _ -> "") in
          mkstr ("#<Enumerator: " ++ to_s (invoke_val_c env world blk recv2 "inspect" Nil false) ++ ":" ++ meth2 ++ argstr ++ ">"))
       else mkstr "#<Enumerator: generator>")
    // Enumerator#size: the size given to Enumerator.new (a proc is called),
    // nil for an unsized generator, else the materialized length.
    else if str_eq cls "Enumerator" && str_eq name "size" then
      (if map_has ivars (str_of_int id ++ "@__e_size") then
         (match map_get ivars (str_of_int id ++ "@__e_size") with
          | VProc spid -> invoke_val_c env world blk (VProc spid) "call" Nil false
          | VObj oid2 ->
            (let (m9, s9, o9, i9) = world in
             if has_meth world (map_get o9 (str_of_int oid2)) "call"
             then invoke_val_c env world blk (VObj oid2) "call" Nil false
             else VObj oid2)
          | v -> v)
       else if map_has ivars (str_of_int id ++ "@__e_blk") then VNil
       else
         (match enum_to_arr env world blk id with
          | VArr aid2 -> VInt (val_list_len (deref aid2))
          | _ -> VNil))
    // Enumerator without a block: enum methods materialize the elements and
    // delegate to the array implementation.
    else if str_eq cls "Enumerator"
            && (if str_eq name "first" || str_eq name "take" then false else true)
            && (is_enum_method name || str_eq name "each_with_index" ||
                str_eq name "drop" || str_eq name "each_slice" || str_eq name "each_cons") then
      (let av = enum_to_arr env world blk id in
       invoke_val_c env world blk av name args vischeck)
    // external iteration (re-drive style: the enumerator is re-run, bounded
    // to pos+1 elements, and indexed by @__e_pos — O(n^2) overall but correct
    // for pure sources, and safe for infinite generators).
    else if str_eq cls "Enumerator" && (str_eq name "next" || str_eq name "peek" || str_eq name "rewind") then
      (if str_eq name "rewind" then
         (let _ = map_set ivars (str_of_int id ++ "@__e_pos") (VInt 0) in recv)
       else
         let pos = (if map_has ivars (str_of_int id ++ "@__e_pos") then (match map_get ivars (str_of_int id ++ "@__e_pos") with VInt k -> k | _ -> 0) else 0) in
         let av = enum_take env world blk id (pos + 1) in
         let xs = (match av with VArr aid -> deref aid | _ -> Nil) in
         if pos >= val_list_len xs then raise_exc world "StopIteration" "iteration reached an end"
         else
           let v = val_nth xs pos in
           let _ = (if str_eq name "next" then map_set ivars (str_of_int id ++ "@__e_pos") (VInt (pos + 1)) else ()) in
           v)
    // with_index(offset = 0) without a block: an Enumerator of [elem, i+offset]
    // pairs; with_object handled by the with-block dispatcher.
    else if str_eq cls "Enumerator" && (str_eq name "with_index" || str_eq name "each_with_index") && (let (h9, _, _, _) = blk in (if h9 then false else true)) then
      (let off = (match args with Cons (VInt o, _) -> o | _ -> 0) in
       let av = enum_to_arr env world blk id in
       (match av with
        | VArr aid2 -> (let _ = () in make_enum world (arr_new (with_index_pairs_off (deref aid2) off)) "each")
        | _ -> VNil))
    // next_values / peek_values: like next/peek but every yield is an array.
    else if str_eq cls "Enumerator" && (str_eq name "next_values" || str_eq name "peek_values") then
      (let pos = (if map_has ivars (str_of_int id ++ "@__e_pos") then (match map_get ivars (str_of_int id ++ "@__e_pos") with VInt k -> k | _ -> 0) else 0) in
       let av = enum_take_m env world blk id (pos + 1) true in
       let xs = (match av with VArr aid -> deref aid | _ -> Nil) in
       if pos >= val_list_len xs then raise_exc world "StopIteration" "iteration reached an end"
       else
         let v = val_nth xs pos in
         let _ = (if str_eq name "next_values" then map_set ivars (str_of_int id ++ "@__e_pos") (VInt (pos + 1)) else ()) in
         v)
    // first / take are bounded (usable on infinite generators).
    else if str_eq cls "Enumerator" && (str_eq name "first" || str_eq name "take") then
      (let n = (match args with Cons (VInt k, _) -> k | _ -> 1) in
       let av = enum_take env world blk id n in
       if str_eq name "take" then av
       else (match args with
             | Cons (VInt _, _) -> av
             | _ -> (match av with VArr aid -> val_nth (deref aid) 0 | _ -> VNil)))
    // UnboundMethod: bind / bind_call and the reflection getters.
    else if str_eq cls "UnboundMethod" then
      (let ucls = (match map_get ivars (str_of_int id ++ "@__um_cls") with VStr h -> sget h | _ -> "") in
       let unm = (match map_get ivars (str_of_int id ++ "@__um_name") with VStr h -> sget h | _ -> "") in
       if str_eq name "bind" || str_eq name "bind_call" then
         (let target = (match args with Cons (v, _) -> v | _ -> VNil) in
          let tcls = dispatch_cls_of world target in
          let ok = (match target with
                    | VObj tid -> obj_is_a world (map_get ocls (str_of_int tid)) ucls
                    | _ -> obj_is_a world (class_name target) ucls || str_eq (class_name target) ucls) in
          if ok then
            (if str_eq name "bind" then mk_bound_method world target ucls unm
             else (match args with
                   | Cons (_, rest) -> invoke_val_c env world blk target unm rest false
                   | _ -> VNil))
          else raise_exc world "TypeError" ("bind argument must be an instance of " ++ ucls))
       else if str_eq name "name" then VSym unm
       else if str_eq name "owner" then VClass ucls
       else if str_eq name "arity" then VInt (bm_arity world ucls unm)
       else if str_eq name "inspect" || str_eq name "to_s" then
         mkstr ("#<UnboundMethod: " ++ ucls ++ "#" ++ unm ++ ">")
       else if str_eq name "==" || str_eq name "eql?" then
         (match args with
          | Cons (VObj oid2, _) ->
            VBool (str_eq (map_get ocls (str_of_int oid2)) "UnboundMethod"
                   && str_eq (to_s (map_get ivars (str_of_int oid2 ++ "@__um_cls"))) ucls
                   && str_eq (to_s (map_get ivars (str_of_int oid2 ++ "@__um_name"))) unm)
          | _ -> VBool false)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of UnboundMethod"))
    // Encoding objects: name/to_s give the label, inspect is #<Encoding:name>.
    // a user exception object answers #message / #to_s with its @message.
    else if (str_eq name "message" || str_eq name "to_s") && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (if map_has ivars (str_of_int id ++ "@message") then map_get ivars (str_of_int id ++ "@message") else mkstr cls)
    else if str_eq cls "MatchData" && (str_eq name "[]" || str_eq name "to_a" || str_eq name "captures") then
      (if str_eq name "[]" then
         (match args with Cons (VInt n, _) -> (if map_has ivars (str_of_int id ++ "@" ++ str_of_int n) then map_get ivars (str_of_int id ++ "@" ++ str_of_int n) else VNil) | _ -> VNil)
       else arr_new (matchdata_arr ivars id (if str_eq name "captures" then 1 else 0)))
    else if str_eq cls "Encoding" && (str_eq name "name" || str_eq name "to_s") then
      (if map_has ivars (str_of_int id ++ "@name") then map_get ivars (str_of_int id ++ "@name") else mkstr "")
    else if str_eq cls "Encoding" && str_eq name "inspect" then
      (let nm = (if map_has ivars (str_of_int id ++ "@name") then to_s (map_get ivars (str_of_int id ++ "@name")) else "") in
       mkstr ("#<Encoding:" ++ nm ++ (if enc_is_dummy nm then " (dummy)" else "") ++ ">"))
    else if str_eq cls "Encoding" && str_eq name "dummy?" then
      VBool (enc_is_dummy (if map_has ivars (str_of_int id ++ "@name") then to_s (map_get ivars (str_of_int id ++ "@name")) else ""))
    else if str_eq cls "Encoding" && str_eq name "ascii_compatible?" then
      VBool (enc_ascii_compat (if map_has ivars (str_of_int id ++ "@name") then to_s (map_get ivars (str_of_int id ++ "@name")) else ""))
    // dup/clone a user object: a fresh object of the same class with copied
    // ivars. A fresh id naturally drops the singleton class (its methods and
    // constants are keyed by the old id) — matching dup, which does not copy
    // the singleton.
    else if str_eq name "dup" || str_eq name "clone" then
      (let nid = map_len ocls in
       // the new object's real class is the ORIGINAL class, not the source's
       // singleton. dup does not copy the singleton; clone does.
       let realcls = if is_sng_cls cls then (if map_has sup cls then map_get sup cls else "Object") else cls in
       // copy the object's instance variables (id@name -> nid@name).
       let oldp = str_of_int id ++ "@" in
       let newp = str_of_int nid ++ "@" in
       let tmp = map_new () in
       let _ = map_iter ivars (fn (k: str) -> fn (v: Val) ->
                 if str_len k > str_len oldp && str_eq (substring k 0 (str_len oldp)) oldp
                 then map_set tmp (newp ++ substring k (str_len oldp) (str_len k)) v
                 else ()) in
       let _ = map_iter tmp (fn (k: str) -> fn (v: Val) -> map_set ivars k v) in
       // clone copies the singleton class (its methods + constants); dup drops
       // it (the new id has none).
       let _ = if str_eq name "clone" && is_sng_cls cls then
                 (let nsng = "(sng:" ++ str_of_int nid ++ ")" in
                  let _ = map_set sup nsng realcls in
                  let _ = map_set ocls (str_of_int nid) nsng in
                  let mpre = cls ++ "#" in
                  let tm = map_new () in
                  let _ = map_iter meths (fn (k: str) -> fn (v: Meth) ->
                            if str_len k > str_len mpre && str_eq (substring k 0 (str_len mpre)) mpre
                            then map_set tm (nsng ++ "#" ++ substring k (str_len mpre) (str_len k)) v
                            else ()) in
                  let _ = map_iter tm (fn (k: str) -> fn (v: Meth) -> map_set meths k v) in
                  let cpre = cls ++ "::" in
                  let tc = map_new () in
                  let _ = map_iter consts (fn (k: str) -> fn (v: Val) ->
                            if str_len k > str_len cpre && str_eq (substring k 0 (str_len cpre)) cpre
                            then map_set tc (nsng ++ "::" ++ substring k (str_len cpre) (str_len k)) v
                            else ()) in
                  let _ = map_iter tc (fn (k: str) -> fn (v: Val) -> map_set consts k v) in ())
               else map_set ocls (str_of_int nid) realcls in
       VObj nid)
    else if is_prim_method name then prim_method recv name args
    // Enumerable (no block): to_a returns the collected array; others delegate.
    else if has_meth world cls "each" && is_enum_method name then
      if enum_needs_block name then make_enum_a world recv name args
      else
      let coll = enum_collect world recv cls in
      if str_eq name "to_a" || str_eq name "entries" then coll else dispatch_prim env world blk coll name args vischeck
    else if has_meth world cls "method_missing" then invoke world noblk recv cls "method_missing" (Cons (VSym name, args))
    // Thread#join / #value: the block already ran synchronously.
    else if str_eq cls "Thread" && str_eq name "value" then
      (match recv with
       | VObj tid -> if map_has ivars (str_of_int tid ++ "@__tval") then map_get ivars (str_of_int tid ++ "@__tval") else recv
       | _ -> recv)
    else if str_eq cls "Thread" && str_eq name "join" then recv
    // Comparable#clamp / #between? on a user object with <=>.
    else if (str_eq name "clamp" || str_eq name "between?") && has_meth world cls "<=>" then
      (if str_eq name "between?" then (match args with Cons (lo, Cons (hi, _)) -> VBool (cmp_vals_w world recv lo >= 0 && cmp_vals_w world recv hi <= 0) | _ -> VBool false)
       else (match args with Cons (lo, Cons (hi, _)) -> (if cmp_vals_w world recv lo < 0 then lo else if cmp_vals_w world recv hi > 0 then hi else recv) | _ -> recv))
    // string-form instance_eval/instance_exec runs code with self = the object.
    else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
      dispatch_prim env world blk recv name args vischeck
    // an object has no such method — raise a catchable NoMethodError.
    else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of " ++ display_cls world cls)
  | VSym s ->
    if str_eq s "&blk" && (str_eq name "call" || str_eq name "()" || str_eq name "[]")
    then flow_value (run_block world noblk blk args)
    else if str_eq s "&blk" && str_eq name "class" then VClass "Proc"
    else dispatch_prim env world blk recv name args vischeck
  | VMain ->
    // explicit self at the top level dispatches to top-level methods.
    let (meths, sup, ocls, ivars) = world in
    if map_has meths name then call_method env world noblk name args
    else dispatch_prim env world blk recv name args vischeck
  | VProc pid ->
    // call/./[]/yield run the stored block; class reports Proc.
    if str_eq name "call" || str_eq name "()" || str_eq name "[]" || str_eq name "yield" || str_eq name "===" then
      let theblk = map_get proc_store (str_of_int pid) in
      // a lambda checks arity strictly (procs stay lenient).
      let _ =
        if map_has lambda_ids (str_of_int pid) then
          (match theblk with (h2, ps, b2, e2) -> lambda_arity_check world ps b2 (vlen args))
        else () in
      if map_has lambda_ids (str_of_int pid) then
        // a lambda is method-like: it establishes a return-boundary frame, so a
        // `return` from the lambda (or from a proc created inside it) returns
        // from the LAMBDA. Give the body env a fresh __fid for the call so
        // procs created inside record it as their home, and consume a return
        // targeted at that frame. Pass the lambda marker for strict arity.
        (match theblk with (h2, ps2, b2, e2) ->
          let lfid = next_fid () in
          let had = map_has e2 "__fid" in
          let saved = (if had then map_get e2 "__fid" else VNil) in
          let _ = map_set e2 "__fid" (VInt lfid) in
          let _ = map_set live_frames (str_of_int lfid) (VBool true) in
          let f = try_or (fn (u: unit) -> run_block world noblk (proc_as_block pid) args) (FRaise VNil) in
          let _ = map_delete live_frames (str_of_int lfid) in
          let _ = if had then map_set e2 "__fid" saved else map_delete e2 "__fid" in
          (match f with
           | FRaise _ ->
             if map_has flow_sig "k" then
               let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
               let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
               let tgt = (if map_has flow_sig "fid" then (match map_get flow_sig "fid" with VInt t -> t | _ -> 0) else 0) in
               if str_eq k "return" then (let _ = map_delete flow_sig "k" in v)
               else if str_eq k "returnret" then
                 // consume iff this lambda is the target; else keep propagating
                 // (flow_sig still holds k/fid/v, so just re-raise).
                 (if tgt == lfid then (let _ = map_delete flow_sig "k" in let _ = map_delete flow_sig "fid" in v)
                  else (let _ = tgt in fail "mere-ruby: (flow signal)"))
               else if str_eq k "breakret" then (let _ = tgt in fail "mere-ruby: (flow signal)")
               else (let _ = map_delete flow_sig "k" in flow_throw k v)
             else fail "mere-ruby: (ruby exception raised)"
           | other -> flow_value other))
      else flow_value (run_block world noblk (proc_as_block pid) args)
    else if str_eq name "class" then VClass "Proc"
    else if str_eq name "lambda?" then VBool (map_has lambda_ids (str_of_int pid))
    else if str_eq name "parameters" then
      (match map_get proc_store (str_of_int pid) with
       (h, ps, body, e) ->
         let is_lam = map_has lambda_ids (str_of_int pid) in
         (match strip_block_params ps with
          // no explicit params: the numbered parameters _1.._N, required for a
          // lambda and optional for a proc.
          | Nil -> arr_new (numbered_params_meta is_lam 1 (max_numbered_stmts body))
          | ps1 -> arr_new (param_meta_list is_lam ps1)))
    else if str_eq name "arity" then
      (match map_get proc_store (str_of_int pid) with
       (h, ps, body, e) ->
         (match strip_block_params ps with
          // no explicit params: arity is the highest numbered parameter used.
          | Nil -> VInt (max_numbered_stmts body)
          // explicit params: count of positional params, negative when a
          // splat makes the count a lower bound.
          | ps1 -> let n = list_str_len (pos_params ps1) in
                   if has_splat ps1 then VInt (0 - n) else VInt n))
    else dispatch_prim env world blk recv name args vischeck
  | VBind bid ->
    // binding.eval(str) runs str against the captured env; local_variable_get
    // reads one captured local. class reports Binding.
    let benv = map_get bind_store (str_of_int bid) in
    if str_eq name "eval" then
      (match args with
       | Cons (VStr code, _) -> let code = sget code in
         let toks = lex_go code 0 in
         let (p2, _) = parse_stmts toks Nil in
         eval_run benv world blk p2
       | _ -> fail "mere-ruby: Binding#eval expects a string")
    else if str_eq name "local_variable_get" then
      (match args with Cons (VSym n, _) -> (if map_has benv n then map_get benv n else VNil) | _ -> VNil)
    else if str_eq name "local_variable_set" then
      (match args with Cons (VSym n, Cons (v, _)) -> let _ = map_set benv n v in v | _ -> VNil)
    else if str_eq name "local_variable_defined?" then
      (match args with Cons (VSym n, _) -> VBool (map_has benv n) | _ -> VBool false)
    else if str_eq name "receiver" || str_eq name "self" then
      (if map_has benv "self" then map_get benv "self" else VMain)
    else if str_eq name "class" then VClass "Binding"
    else dispatch_prim env world blk recv name args vischeck
  | _ -> dispatch_prim env world blk recv name args vischeck

// dispatch `recv.name(args) { block }` — shared by literal-block calls and
// strict-arity check shared by a direct lambda call and a lambda-as-block:
// an explicit param list must receive exactly that many args (a splat or a
// param-less body absorbs any count); otherwise ArgumentError.
// a numbered block parameter name (_1 .. _9).
// the digit of a numbered-parameter name (_1.._9), or 0 if not one.
and numbered_digit = fn (s: str) ->
  if str_len s == 2 && str_eq (char_at s 0) "_" && (let d = char_at s 1 in is_digit d && (if str_eq d "0" then false else true))
  then ord (char_at s 1) - 48 else 0
and imax = fn (a: int) -> fn (b: int) -> if a > b then a else b

// the highest numbered parameter (_1..) referenced in a block body, else 0.
// Over-detection is safe (it only relaxes the arity-0 check / grows arity),
// so descend broadly.
// `[[:req, :_1], ...]` (lambda) / `[[:opt, :_1], ...]` (proc) for _1.._n.
and numbered_params_meta = fn (is_lam: bool) -> fn (i: int) -> fn (n: int) ->
  if i > n then Nil
  else Cons (arr_new (Cons (VSym (if is_lam then "req" else "opt"), Cons (VSym ("_" ++ str_of_int i), Nil))), numbered_params_meta is_lam (i + 1) n)
// #parameters metadata for an explicit block/lambda parameter list.
and param_meta_list = fn (is_lam: bool) -> fn (ps: str list) ->
  match ps with
  | Nil -> Nil
  | Cons (p, rest) ->
    let pair = (if str_len p >= 2 && str_eq (substring p 0 2) "**" then arr_new (Cons (VSym "keyrest", Cons (VSym (substring p 2 (str_len p)), Nil)))
                else if str_len p > 0 && str_eq (char_at p 0) "*" then arr_new (Cons (VSym "rest", Cons (VSym (substring p 1 (str_len p)), Nil)))
                else if str_len p > 0 && str_eq (char_at p 0) "&" then arr_new (Cons (VSym "block", Cons (VSym (substring p 1 (str_len p)), Nil)))
                else arr_new (Cons (VSym (if is_lam then "req" else "opt"), Cons (VSym p, Nil)))) in
    Cons (pair, param_meta_list is_lam rest)
and max_numbered_stmts = fn (body: Stmt list) ->
  match body with
  | Nil -> 0
  | Cons (s, rest) -> imax (max_numbered_stmt s) (max_numbered_stmts rest)
and max_numbered_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> max_numbered_expr e
  | SAssign (_, e) -> max_numbered_expr e
  | SIVarAssign (_, e) -> max_numbered_expr e
  | SReturn e -> max_numbered_expr e
  | SPuts es -> max_numbered_exprs es
  | SWhile (c, b) -> imax (max_numbered_expr c) (max_numbered_stmts b)
  | SIf (clauses, els) -> imax (max_numbered_clauses clauses) (max_numbered_stmts els)
  | _ -> 0
and max_numbered_clauses = fn (clauses: (Expr * Stmt list) list) ->
  match clauses with
  | Nil -> 0
  | Cons ((c, b), rest) -> imax (imax (max_numbered_expr c) (max_numbered_stmts b)) (max_numbered_clauses rest)
and max_numbered_expr = fn (e: Expr) ->
  match e with
  | EVar n -> numbered_digit n
  | EBin (_, a, b) -> imax (max_numbered_expr a) (max_numbered_expr b)
  | EUn (_, a) -> max_numbered_expr a
  | ECall (_, args) -> max_numbered_exprs args
  | EMethod (r, _, args) -> imax (max_numbered_expr r) (max_numbered_exprs args)
  | EMethodB (r, _, args, _, bb) -> imax (imax (max_numbered_expr r) (max_numbered_exprs args)) (max_numbered_stmts bb)
  | ECallB (_, args, _, bb) -> imax (max_numbered_exprs args) (max_numbered_stmts bb)
  | EArr es -> max_numbered_exprs es
  | EHsh es -> max_numbered_exprs es
  | ETern (a, b, c) -> imax (imax (max_numbered_expr a) (max_numbered_expr b)) (max_numbered_expr c)
  | EYield es -> max_numbered_exprs es
  | _ -> 0
and max_numbered_exprs = fn (es: Expr list) ->
  match es with
  | Nil -> 0
  | Cons (e, rest) -> imax (max_numbered_expr e) (max_numbered_exprs rest)

// invalid use of a numbered parameter (Ruby rejects at parse time): a block
// with explicit params whose body uses _1.. ("ordinary parameter is
// defined"), or assigning to _1.. ("reserved for numbered parameter").
and numbered_misuse_stmts = fn (body: Stmt list) ->
  match body with Nil -> false | Cons (s, r) -> numbered_misuse_stmt s || numbered_misuse_stmts r
and numbered_misuse_stmt = fn (s: Stmt) ->
  match s with
  | SAssign (n, e) -> numbered_digit n > 0 || numbered_misuse_expr e
  | SExpr e -> numbered_misuse_expr e
  | SIVarAssign (_, e) -> numbered_misuse_expr e
  | SReturn e -> numbered_misuse_expr e
  | SPuts es -> numbered_misuse_exprs es
  | SWhile (c, b) -> numbered_misuse_expr c || numbered_misuse_stmts b
  | SIf (clauses, els) -> numbered_misuse_clauses clauses || numbered_misuse_stmts els
  | _ -> false
and numbered_misuse_clauses = fn (clauses: (Expr * Stmt list) list) ->
  match clauses with Nil -> false | Cons ((c, b), r) -> numbered_misuse_expr c || numbered_misuse_stmts b || numbered_misuse_clauses r
and blk_num_bad = fn (bp: str list) -> fn (bb: Stmt list) ->
  // a block with explicit params AND a numbered param in its body is invalid.
  (match bp with Nil -> false | _ -> max_numbered_stmts bb > 0)
// a numbered param referenced in THIS block's scope (does not descend into a
// nested block/lambda body, which starts its own numbered-param scope).
and own_num_stmts = fn (b: Stmt list) -> match b with Nil -> 0 | Cons (s, r) -> imax (own_num_stmt s) (own_num_stmts r)
and own_num_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> own_num_expr e
  | SAssign (n, e) -> imax (numbered_digit n) (own_num_expr e)
  | SReturn e -> own_num_expr e
  | SIVarAssign (_, e) -> own_num_expr e
  | SPuts es -> own_num_exprs es
  | SWhile (c, bd) -> imax (own_num_expr c) (own_num_stmts bd)
  | SIf (cl, els) -> imax (own_num_clauses cl) (own_num_stmts els)
  | _ -> 0
and own_num_clauses = fn (cl: (Expr * Stmt list) list) -> match cl with Nil -> 0 | Cons ((c, bd), r) -> imax (imax (own_num_expr c) (own_num_stmts bd)) (own_num_clauses r)
and own_num_expr = fn (e: Expr) ->
  match e with
  | EVar n -> numbered_digit n
  | EBin (_, a, b) -> imax (own_num_expr a) (own_num_expr b)
  | EUn (_, a) -> own_num_expr a
  | ECall (_, args) -> own_num_exprs args
  | EMethod (r, _, args) -> imax (own_num_expr r) (own_num_exprs args)
  | EMethodB (r, _, args, _, _) -> imax (own_num_expr r) (own_num_exprs args)
  | ECallB (_, args, _, _) -> own_num_exprs args
  | EArr es -> own_num_exprs es
  | EHsh es -> own_num_exprs es
  | ETern (a, b, c) -> imax (imax (own_num_expr a) (own_num_expr b)) (own_num_expr c)
  | EYield es -> own_num_exprs es
  | _ -> 0
and own_num_exprs = fn (es: Expr list) -> match es with Nil -> 0 | Cons (e, r) -> imax (own_num_expr e) (own_num_exprs r)
// a nested block/lambda (in this scope) whose OWN scope references a numbered param.
and nested_num_stmts = fn (b: Stmt list) -> match b with Nil -> false | Cons (s, r) -> nested_num_stmt s || nested_num_stmts r
and nested_num_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> nested_num_expr e
  | SAssign (_, e) -> nested_num_expr e
  | SReturn e -> nested_num_expr e
  | SIVarAssign (_, e) -> nested_num_expr e
  | SPuts es -> nested_num_exprs es
  | SWhile (c, bd) -> nested_num_expr c || nested_num_stmts bd
  | SIf (cl, els) -> nested_num_clauses cl || nested_num_stmts els
  | _ -> false
and nested_num_clauses = fn (cl: (Expr * Stmt list) list) -> match cl with Nil -> false | Cons ((c, bd), r) -> nested_num_expr c || nested_num_stmts bd || nested_num_clauses r
and nested_num_expr = fn (e: Expr) ->
  match e with
  | ELambda (ps, b) -> (match ps with Nil -> own_num_stmts b > 0 || nested_num_stmts b | _ -> nested_num_stmts b)
  | ECallB (_, args, bp, bb) -> (match bp with Nil -> own_num_stmts bb > 0 || nested_num_stmts bb | _ -> nested_num_stmts bb) || nested_num_exprs args
  | EMethodB (r, _, args, bp, bb) -> (match bp with Nil -> own_num_stmts bb > 0 || nested_num_stmts bb | _ -> nested_num_stmts bb) || nested_num_expr r || nested_num_exprs args
  | EBin (_, a, b) -> nested_num_expr a || nested_num_expr b
  | EUn (_, a) -> nested_num_expr a
  | ECall (_, args) -> nested_num_exprs args
  | EMethod (r, _, args) -> nested_num_expr r || nested_num_exprs args
  | EArr es -> nested_num_exprs es
  | EHsh es -> nested_num_exprs es
  | ETern (a, b, c) -> nested_num_expr a || nested_num_expr b || nested_num_expr c
  | _ -> false
and nested_num_exprs = fn (es: Expr list) -> match es with Nil -> false | Cons (e, r) -> nested_num_expr e || nested_num_exprs r
// a block using a numbered param whose body also has a nested block using one
// is a SyntaxError ("numbered parameter is already used in outer block").
and num_nested_bad = fn (bb: Stmt list) -> own_num_stmts bb > 0 && nested_num_stmts bb

and numbered_misuse_expr = fn (e: Expr) ->
  match e with
  | ELambda (ps, b) -> (match ps with Nil -> num_nested_bad b || numbered_misuse_stmts b | _ -> if max_numbered_stmts b > 0 then true else numbered_misuse_stmts b)
  | ECallB (_, args, bp, bb) -> blk_num_bad bp bb || (match bp with Nil -> num_nested_bad bb | _ -> false) || numbered_misuse_exprs args || numbered_misuse_stmts bb
  | EMethodB (r, _, args, bp, bb) -> blk_num_bad bp bb || (match bp with Nil -> num_nested_bad bb | _ -> false) || numbered_misuse_expr r || numbered_misuse_exprs args || numbered_misuse_stmts bb
  | EBin (_, a, b) -> numbered_misuse_expr a || numbered_misuse_expr b
  | EUn (_, a) -> numbered_misuse_expr a
  | ECall (_, args) -> numbered_misuse_exprs args
  | EMethod (r, _, args) -> numbered_misuse_expr r || numbered_misuse_exprs args
  | EArr es -> numbered_misuse_exprs es
  | EHsh es -> numbered_misuse_exprs es
  | ETern (a, b, c) -> numbered_misuse_expr a || numbered_misuse_expr b || numbered_misuse_expr c
  | _ -> false
and numbered_misuse_exprs = fn (es: Expr list) ->
  match es with Nil -> false | Cons (e, r) -> numbered_misuse_expr e || numbered_misuse_exprs r

and lambda_arity_check = fn world -> fn (ps0: str list) -> fn (body: Stmt list) -> fn (nargs: int) ->
  // an explicit-empty param list (`{ || }`) behaves like zero params.
  let ps = (match ps0 with Cons (m, Nil) -> if str_eq m empty_bp_marker then (Nil : str list) else ps0 | _ -> ps0) in
  let nps = list_str_len (strip_block_params ps) in
  (match ps with
   // no explicit params: arity 0 (strict) unless the body uses numbered
   // params (_1..), in which case it absorbs args (kept lenient).
   | Nil ->
     if max_numbered_stmts body > 0 then ()
     else if nargs == 0 then ()
     else let _ = raise_exc world "ArgumentError"
            ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected 0)") in ()
   | _ ->
     // positional-only params (drop &blk / **kw / key: keyword params); the
     // required count (no default) is the minimum, and without a splat the
     // total positional count is the maximum.
     let pp = pos_params (drop_dsplat (strip_block_params ps)) in
     let bdefaults = block_defaults body in
     if has_splat pp then
       let before = take_until_splat pp in
       let after = after_splat pp in
       let minreq = list_str_len (req_pre before bdefaults) + list_str_len after in
       // a trailing-comma splat ("|a,|") takes no extra args, so it has an
       // exact upper bound like a splat-free param list; a real "*" does not.
       if str_list_has pp "*," then
         let maxp = list_str_len before + list_str_len after in
         if nargs >= minreq && nargs <= maxp then ()
         else let _ = raise_exc world "ArgumentError"
                ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected " ++ str_of_int maxp ++ ")") in ()
       else if nargs >= minreq then ()
       else let _ = raise_exc world "ArgumentError"
              ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected " ++ str_of_int minreq ++ "+)") in ()
     else
       let minreq = list_str_len (req_pre pp bdefaults) in
       let maxp = list_str_len pp in
       if nargs >= minreq && nargs <= maxp then ()
       else let _ = raise_exc world "ArgumentError"
              ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected " ++ str_of_int maxp ++ ")") in ())

// the block tuple for a proc used as a block; a lambda gets the marker
// prepended to its params so run_block enforces strict arity.
and proc_as_block = fn (pid: int) ->
  let t = map_get proc_store (str_of_int pid) in
  // a lambda enforces strict arity; a proc that captured a defining-method
  // block carries a yblk marker so run_block reinstates that block for `yield`.
  let t = (if map_has lambda_ids (str_of_int pid) then
             (match t with (h, ps, b, e) -> (h, Cons (lambda_blk_marker, ps), b, e))
           else t) in
  if map_has proc_yblk (str_of_int pid) then
    (match t with (h, ps, b, e) -> (h, Cons (yblk_marker ++ str_of_int pid, ps), b, e))
  else t

// &proc block-pass arguments.
// coerce a `&expr` value into a call block: a Proc uses its own block, nil
// means no block, a Symbol becomes a symbol-proc, and anything else is
// converted eagerly via #to_proc (so its side effects run at the call site).
and coerce_to_block = fn env -> fn world -> fn blk -> fn (bv: Val) ->
  match bv with
  | VProc pid ->
    // forward the proc's home frame so the callee's `break` targets it.
    let _ = if map_has proc_home (str_of_int pid) then map_set pending_home "v" (map_get proc_home (str_of_int pid)) else () in
    proc_as_block pid
  | VNil -> (false, (Nil : str list), (Nil : Stmt list), env)
  | VSym s -> (true, Cons ("__bp", Nil), Cons (SExpr (EMethod (EVar "__bp", s, Nil)), Nil), env)
  | _ ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    (match invoke_val_c env world noblk bv "to_proc" Nil false with
     | VProc pid -> proc_as_block pid
     | _ -> noblk)

and invoke_with_block = fn env -> fn world -> fn blk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) -> fn newblk ->
    // Object#then / yield_self: run the block with the receiver.
    if str_eq name "then" || str_eq name "yield_self" then
      flow_value (run_block world blk newblk (Cons (recv, Nil)))
    // Object#tap: run the block with the receiver, then return the receiver.
    else if str_eq name "tap" then
      let _ = flow_value (run_block world blk newblk (Cons (recv, Nil))) in recv
    // recv.send(:m, args) { block } — forward the block to the sent method.
    else if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send") && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
      (match args with
       | Cons (VSym m, rest) -> invoke_with_block env world blk recv m rest newblk
       | Cons (VStr m, rest) -> invoke_with_block env world blk recv (sget m) rest newblk
       | _ -> VNil)
    // recv.define_method(:name) { block } with an explicit class receiver:
    // register the block as an instance method of that class (used on singleton
    // classes, e.g. (class << obj; self).define_method(...)).
    else if str_eq name "define_method" && (match recv with VClass _ -> true | _ -> false) then
      (match recv with
       | VClass c ->
         let (meths, sup, ocls, ivars) = world in
         let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr s, _) -> sget s | _ -> "") in
         let (h2, ps2, bb2, e2) = newblk in
         let _ = map_set meths (c ++ "#" ++ nm) (Meth (ps2, Nil, bb2)) in
         let _ = map_set dm_methods (c ++ "#" ++ nm) VNil in
         VSym nm
       | _ -> VNil)
    // ENV.fetch / ENV.delete with a block: the block supplies the value for
    // a missing key (fetch) or the return value (delete); an existing key
    // never runs the block.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls (str_of_int id)) "EnvHash") | _ -> false)
            && (str_eq name "fetch" || str_eq name "delete") then
      (match args with
       | Cons (kv, _) ->
         (let k2 = env_key_of env world kv in
          match env_lookup_v k2 with
          | VNil -> flow_value (run_block world blk newblk (Cons (mkstr k2, Nil)))
          | v -> (if str_eq name "delete" then (let _ = map_set env_ovr k2 VNil in v) else v))
       | _ -> VNil)
    // File#each_line { block }: materialize the lines and drive Array#each.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls (str_of_int id)) "File") | _ -> false)
            && (str_eq name "each_line" || str_eq name "each") then
      (match recv with
       | VObj id ->
         (let (m0, s0, ocls0, iv0) = world in
          let path = (match (if map_has iv0 (str_of_int id ++ "@__f_path") then map_get iv0 (str_of_int id ++ "@__f_path") else VNil) with VStr h -> sget h | _ -> "") in
          let content = (if file_exists path then read_file path else "") in
          let av = file_lines_arr content 0 in
          invoke_with_block env world blk av "each" Nil newblk)
       | _ -> VNil)
    // Enumerator#each { block }: drive the captured @recv.@meth with this
    // block. `for x in enum_for(:m)` desugars to `enum.each { |__for| ... }`,
    // and #each just forwards to the underlying method (whose `yield` runs the
    // block); the method's return value becomes #each's (and the loop's) value.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls (str_of_int id)) "Enumerator") | _ -> false)
            && str_eq name "each" then
      (match recv with
       | VObj id ->
         (let (m0, s0, ocls0, ivars0) = world in
          if map_has ivars0 (str_of_int id ++ "@__e_blk") then
            // generator form: run the stored block with a yielder that
            // forwards each y << v / y.yield(v) to the caller's block.
            (match map_get ivars0 (str_of_int id ++ "@__e_blk") with
             | VProc gpid ->
               let bpid = map_len proc_store in
               let _ = map_set proc_store (str_of_int bpid) newblk in
               let yid = map_len ocls0 in
               let _ = map_set ocls0 (str_of_int yid) "Enumerator::Yielder" in
               let _ = map_set ivars0 (str_of_int yid ++ "@__y_blk") (VProc bpid) in
               let _ = flow_value (run_block world blk (map_get proc_store (str_of_int gpid)) (Cons (VObj yid, Nil))) in
               recv
             | _ -> VNil)
          else
          let recv2 = (if map_has ivars0 (str_of_int id ++ "@recv") then map_get ivars0 (str_of_int id ++ "@recv") else VNil) in
          let meth2 = (match (if map_has ivars0 (str_of_int id ++ "@meth") then map_get ivars0 (str_of_int id ++ "@meth") else mkstr "each") with VStr h -> sget h | _ -> "each") in
          (match recv2 with
           | VMain -> if map_has m0 meth2 then (let e2 = map_copy env in let _ = map_set e2 "self" recv2 in call_method e2 world newblk meth2 args)
                      else invoke_with_block env world blk recv2 meth2 args newblk
           | _ -> invoke_with_block env world blk recv2 meth2 args newblk))
       | _ -> VNil)
    // Enumerator::Lazy with a block: pipeline ops are appended lazily; #each
    // drives the pipeline with the block as the final consumer.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls (str_of_int id)) "Enumerator::Lazy") | _ -> false) then
      (match recv with
       | VObj id ->
         (if str_eq name "map" || str_eq name "collect" || str_eq name "select" || str_eq name "filter" ||
             str_eq name "find_all" || str_eq name "reject" || str_eq name "filter_map" ||
             str_eq name "take_while" || str_eq name "drop_while" then
            (let pid = map_len proc_store in
             let _ = map_set proc_store (str_of_int pid) newblk in
             let kind = (if str_eq name "collect" then "map"
                         else if str_eq name "filter" || str_eq name "find_all" then "select"
                         else name) in
             lz_extend world id kind (VProc pid))
          else if str_eq name "each" then
            (let pid = map_len proc_store in
             let _ = map_set proc_store (str_of_int pid) newblk in
             let _ = lz_run env world blk id (0 - 1) (VProc pid) in
             recv)
          else invoke_with_block env world blk (lz_run env world blk id (0 - 1) VNil) name args newblk)
       | _ -> VNil)
    // Enumerator::Chain#each { }: drive each source's #each with the block.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls (str_of_int id)) "Enumerator::Chain") | _ -> false)
            && str_eq name "each" then
      (match recv with
       | VObj id -> (let _ = chain_drive env world blk (chain_srcs world id) newblk in recv)
       | _ -> VNil)
    // other Enumerator methods (map/select/... with a block): materialize the
    // elements, then run the array operation with the same block.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls (str_of_int id)) "Enumerator") | _ -> false)
            && (is_enum_method name || str_eq name "each_with_index" || str_eq name "with_index" || str_eq name "with_object" || str_eq name "each_slice" || str_eq name "each_cons") then
      (match recv with
       | VObj id ->
         (if str_eq name "with_index" && (match args with Cons (VInt _, _) -> true | _ -> false) then
            // with_index(offset): iterate [elem, i+offset] pairs with the block.
            (let off = (match args with Cons (VInt o, _) -> o | _ -> 0) in
             let av = enum_to_arr env world blk id in
             (match av with
              | VArr aid2 -> invoke_with_block env world blk (arr_new (with_index_pairs_off (deref aid2) off)) "each" Nil newblk
              | _ -> VNil))
          else if str_eq name "with_object" then
            invoke_with_block env world blk (enum_to_arr env world blk id) "each_with_object" args newblk
          else
            invoke_with_block env world blk (enum_to_arr env world blk id) (if str_eq name "with_index" then "each_with_index" else name) args newblk)
       | _ -> VNil)
    // instance_eval/instance_exec (block form) on a non-class receiver: run
    // the block with `self` rebound to the receiver. instance_exec forwards
    // the call args to the block; instance_eval passes the receiver itself.
    else if (str_eq name "instance_eval" || str_eq name "instance_exec")
            && (match recv with VClass _ -> false | _ -> true) then
      (let (h3, ps3, bb3, e3) = newblk in
       // defining on an immediate's (absent) singleton class is a TypeError.
       if imm_no_singleton recv && body_defines bb3 then raise_exc world "TypeError" "can't define singleton"
       else
       // rebind self in a COPY of the block's captured env, not the shared
       // env itself: a nested call of the same proc (`pr.call` inside the
       // instance_eval'd pr) must still see the proc's own lexical self.
       let e3c = map_copy e3 in
       let _ = map_set e3c "self" recv in
       let blkargs = if str_eq name "instance_exec" then args else Cons (recv, Nil) in
       flow_value (run_block world blk (h3, ps3, bb3, e3c) blkargs))
    else
    (match recv with
     | VClass c ->
       // Proc.new { } captures the block; Class.new { } makes an anonymous
       // class whose body is the block; class_eval reopens the class.
       if str_eq c "Proc" && str_eq name "new" then
         (let id = map_len proc_store in let _ = map_set proc_store (str_of_int id) newblk in
          let _ = if (let (h, _, _, _) = blk in h) then map_set proc_yblk (str_of_int id) blk else () in
          VProc id)
       // File.open(path, mode) { |f| ... }: open, run the block with the
       // handle, flush/close on exit, return the block's value.
       else if str_eq c "File" && (str_eq name "open" || str_eq name "new") then
         (let fobj = file_open_obj world args in
          let r = flow_value (run_block world blk newblk (Cons (fobj, Nil))) in
          let _ = (match fobj with VObj fid -> file_close_obj world fid | _ -> ()) in
          r)
       // Thread.new { } runs the block synchronously but with a FRESH catch
       // stack (a throw can't cross a thread boundary), returning a thread
       // object whose join is a no-op.
       else if str_eq c "Enumerator" && str_eq name "produce" then
         // Enumerator.produce(initial) { |x| next } — an infinite generator:
         // store the step block + seed; enum_take drives it boundedly.
         (let pid = map_len proc_store in
          let _ = map_set proc_store (str_of_int pid) newblk in
          let (m3, s3, ocls3, iv3) = world in
          let eid = map_len ocls3 in
          let _ = map_set ocls3 (str_of_int eid) "Enumerator" in
          let _ = map_set iv3 (str_of_int eid ++ "@__e_step") (VProc pid) in
          let _ = map_set iv3 (str_of_int eid ++ "@__e_seed") (match args with Cons (v, _) -> v | _ -> VNil) in
          VObj eid)
       else if str_eq c "Enumerator" && str_eq name "new" then
         // Enumerator.new(size = nil) { |y| ... }: store the generator block
         // as a proc, and the optional size (#size returns / calls it).
         (let pid = map_len proc_store in
          let _ = map_set proc_store (str_of_int pid) newblk in
          let (m3, s3, ocls3, iv3) = world in
          let eid = map_len ocls3 in
          let _ = map_set ocls3 (str_of_int eid) "Enumerator" in
          let _ = map_set iv3 (str_of_int eid ++ "@__e_blk") (VProc pid) in
          let _ = (match args with Cons (sz, _) -> map_set iv3 (str_of_int eid ++ "@__e_size") sz | _ -> ()) in
          VObj eid)
       else if str_eq c "Thread" && str_eq name "new" then
         (let saved = (if map_has catch_depth "n" then map_get catch_depth "n" else VInt 0) in
          let _ = map_set catch_depth "n" (VInt 0) in
          // a bare `return` inside the block is a LocalJumpError, not a return.
          let savedtf = (if map_has thread_flag "n" then map_get thread_flag "n" else VBool false) in
          let _ = map_set thread_flag "n" (VBool true) in
          let tval = flow_value (run_block world blk newblk Nil) in
          let _ = map_set thread_flag "n" savedtf in
          let _ = map_set catch_depth "n" saved in
          let (m3, s3, ocls3, iv3) = world in
          let tid = map_len ocls3 in
          let _ = map_set ocls3 (str_of_int tid) "Thread" in
          // Thread#value/#join returns the block's value (see the value handler).
          let _ = map_set iv3 (str_of_int tid ++ "@__tval") tval in
          VObj tid)
       else if str_eq c "Class" && str_eq name "new" then
         (let (meths2, sup2, ocls2, iv2) = world in
          let anon = fresh_anon "AnonClass_" in
          let _ = (match args with Cons (VClass sc, _) -> map_set sup2 anon sc | _ -> ()) in
          let (h3, ps3, bb3, e3) = newblk in
          // a block is not a constant scope: classes/constants defined in it
          // go to the block's LEXICAL scope (its captured cref; "" = toplevel).
          let bcref = (if map_has e3 "__cref" then (match map_get e3 "__cref" with VStr s -> let s = sget s in s | _ -> "") else "") in
          let _ = flow_value (register_class_blk world anon bb3 bcref) in
          VClass anon)
       // Module.new { } — an anonymous module whose body is the block. Run the
       // block as a closure (outer locals stay visible/assignable) with self
       // rebound to the module, so top-level defs land on it (SDef keys off
       // self's class) and refine/using inside see the module as self.
       else if str_eq c "Module" && str_eq name "new" then
         (let (meths2, sup2, ocls2, iv2) = world in
          let anon = fresh_anon "AnonModule_" in
          let _ = map_set modules anon VNil in
          let (h3, ps3, bb3, e3) = newblk in
          let saved_self = if map_has e3 "self" then map_get e3 "self" else VNil in
          let _ = map_set e3 "self" (VClass anon) in
          let saved_cref = cur_lex () in
          let _ = set_lex anon in
          // a `using` inside the block is scoped to it (like register_class):
          // snapshot/restore ref_active so refinements don't leak past the body.
          let saved_ref = map_copy ref_active in
          let _ = flow_value (run_block world blk newblk (Cons (VClass anon, Nil))) in
          let _ = restore_ref_active saved_ref in
          let _ = set_lex saved_cref in
          let _ = map_set e3 "self" saved_self in
          VClass anon)
       else if str_eq name "class_eval" || str_eq name "module_eval" then
         // run the body as class-body statements (defs go to the class), but a
         // bare Const inside resolves in the BLOCK's lexical scope (Ruby: a
         // block does not open a constant scope), not the receiver's namespace.
         (let (h3, ps3, bb3, e3) = newblk in
          let cscope = (if map_has e3 "__cref" then (match map_get e3 "__cref" with VStr s -> let s = sget s in s | _ -> "") else "") in
          flow_value (register_class_blk world c bb3 cscope))
       else if str_eq name "instance_eval" then
         (let (h3, ps3, bb3, e3) = newblk in flow_value (register_class world c bb3))
       else if str_eq c "Array" && str_eq name "new" then
         (match args with Cons (VInt n, _) -> arr_new (array_new_blk world blk newblk n 0) | _ -> arr_new Nil)
       else if str_eq c "Hash" && str_eq name "new" then mkhash Nil
       else if str_eq name "new" then new_obj_wb world c args newblk
       else if has_meth world ("(sng:" ++ c ++ ")") name then invoke world newblk recv ("(sng:" ++ c ++ ")") name args
       else if has_meth world "Module" name then invoke world newblk recv "Module" name args
       else if has_meth world "Class" name then invoke world newblk recv "Class" name args
       else prim_method recv name args
     | VObj id ->
       let (meths, sup, ocls, ivars) = world in
       let cls = map_get ocls (str_of_int id) in
       if has_meth world cls name then
         (if meth_private world cls name
          then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for an instance of " ++ display_cls world cls)
          else invoke world newblk recv cls name args)
       // Enumerable: synthesize block iterators from the user's `each`.
       else if has_meth world cls "each" && is_enum_method name then
         builtin_iter world blk newblk (enum_collect world recv cls) name args
       else if has_meth world cls "method_missing" then invoke world newblk recv cls "method_missing" (Cons (VSym name, args))
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of " ++ display_cls world cls)
     // `blk` (the enclosing method's block) is threaded so a yield inside
     // the iterated block reaches it (e.g. `@xs.each { |n| yield(n) }`).
     | _ ->
       // a reopened built-in class's method (with the call-site block) wins
       // over the hardcoded iterators.
       let pcls = class_name recv in
       if has_meth world pcls name then invoke world newblk recv pcls name args
       // in-place Array mutators taking a block: map!/select!/reject!/etc.
       else if (str_eq name "map!" || str_eq name "collect!") && (match recv with VArr _ -> true | _ -> false) then
         (match recv with VArr id -> (match arr_map world blk newblk (deref id) Nil with FNext (VArr nid) -> let _ = arr_set id (deref nid) in recv | other -> flow_value other) | _ -> recv)
       else if (str_eq name "select!" || str_eq name "keep_if" || str_eq name "filter!") && (match recv with VArr _ -> true | _ -> false) then
         (match recv with VArr id -> (match arr_filter world blk newblk (deref id) Nil true with FNext (VArr nid) -> let _ = arr_set id (deref nid) in recv | other -> flow_value other) | _ -> recv)
       else if (str_eq name "reject!" || str_eq name "delete_if") && (match recv with VArr _ -> true | _ -> false) then
         (match recv with VArr id -> (match arr_filter world blk newblk (deref id) Nil false with FNext (VArr nid) -> let _ = arr_set id (deref nid) in recv | other -> flow_value other) | _ -> recv)
       // sort / sort! with a comparator block.
       else if str_eq name "sort" && (match recv with VArr _ -> true | _ -> false) then
         (match recv with VArr id -> arr_new (sort_blk world newblk (deref id)) | _ -> recv)
       else if str_eq name "sort!" && (match recv with VArr _ -> true | _ -> false) then
         (match recv with VArr id -> let _ = arr_set id (sort_blk world newblk (deref id)) in recv | _ -> recv)
       // fetch with a default block: run the block when the key/index is absent.
       else if str_eq name "fetch" && (match recv with VHsh _ -> true | VArr _ -> true | _ -> false) then
         (match recv with
          | VHsh h -> let xs = hderef h in (match args with Cons (k, _) -> (if hash_haskey xs k then hash_get xs k else flow_value (run_block world blk newblk (Cons (k, Nil)))) | _ -> VNil)
          | VArr id -> let ys = deref id in let n = val_list_len ys in (match args with Cons (VInt i, _) -> let j = (if i < 0 then n + i else i) in (if j >= 0 && j < n then val_nth ys j else flow_value (run_block world blk newblk (Cons (VInt i, Nil)))) | _ -> VNil)
          | _ -> recv)
       // Hash#merge/merge!/update with a conflict block.
       else if (str_eq name "merge" || str_eq name "merge!" || str_eq name "update") && (match recv with VHsh _ -> true | _ -> false) then
         (match recv with
          | VHsh h -> let merged = hash_merge_block world newblk (hderef h) args in
            (if str_eq name "merge" then mkhash merged else let _ = hset h merged in recv)
          | _ -> recv)
       // String#gsub/sub with a block: the block computes each replacement.
       else if (str_eq name "gsub" || str_eq name "sub") && (match recv with VStr _ -> true | _ -> false) then
         (match recv with
          | VStr s -> let s = sget s in
            (match args with
             | Cons (VRegex (pat, pf), _) -> mkstr (rx_gsub_blk2 world newblk pat pf s (str_eq name "gsub") 0 "")
             | Cons (VStr pat, _) -> mkstr (rx_gsub_blk world newblk (sget pat) s (str_eq name "gsub") 0 "")
             | _ -> mkstr s)
          | _ -> recv)
       else builtin_iter world blk newblk recv name args)

// dispatch on a primitive receiver: reopened built-in classes win (class
// Integer / class Object monkey-patching), then the hardcoded prims.
// the bare ivar name from an instance_variable_* argument (":@x" / "@x").
and ivar_arg_name = fn (nm: str) ->
  if str_len nm > 0 && str_eq (char_at nm 0) "@" then substring nm 1 (str_len nm) else nm

and dispatch_prim = fn env -> fn world -> fn blk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) -> fn (vischeck: bool) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  let cls = class_name recv in
  // singleton_class: true/false/nil answer their class; immediates raise
  // TypeError; an object gets its own (hidden) singleton class.
  if str_eq name "singleton_class" then
    (match recv with
     | VBool b -> VClass (if b then "TrueClass" else "FalseClass")
     | VNil -> VClass "NilClass"
     | VInt _ -> raise_exc world "TypeError" "can't define singleton"
     | VFlt _ -> raise_exc world "TypeError" "can't define singleton"
     | VSym _ -> raise_exc world "TypeError" "can't define singleton"
     | VObj id -> VClass (singleton_cls_of world id)
     | VClass c -> VClass ("(sng:" ++ c ++ ")")
     // a mutable primitive instance can have a singleton class (superclass is
     // its class); frozen immediates above already raise TypeError.
     | VStr _ -> VClass (prim_sng_cls world recv "String")
     | VArr _ -> VClass (prim_sng_cls world recv "Array")
     | VHsh _ -> VClass (prim_sng_cls world recv "Hash")
     | _ -> raise_exc world "TypeError" "can't define singleton")
  // String#encode: real transcode between UTF-8/ISO-8859-1/US-ASCII (and
  // relabel to/from ASCII-8BIT); an unrepresentable char raises a catchable
  // Encoding::UndefinedConversionError.
  else if (str_eq name "encode" || str_eq name "encode!") && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr h ->
       let to = (match args with Cons (VStr nm, _) -> enc_canon (sget nm) | Cons (VObj oid, _) -> enc_canon (to_s (VObj oid)) | _ -> "UTF-8") in
       let from = enc_canon (senc_get h) in
       let tr = str_transcode (sget h) from to in
       (match tr with
        | (bytes, ok) ->
          if ok then (let c = mkstr bytes in (match c with VStr id -> let _ = senc_set id to in c | _ -> c))
          else raise_exc world "Encoding::UndefinedConversionError" ("conversion undefined from " ++ from ++ " to " ++ to))
     | _ -> VNil)
  // instance_eval/instance_exec with a String arg: parse and run the code
  // with self rebound to the receiver (a fresh scope, like Ruby).
  else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
    (match args with
     | Cons (VStr code, _) ->
       let code = sget code in
       let toks = lex_go code 0 in
       let (p2, _) = parse_stmts toks Nil in
       if imm_no_singleton recv && body_defines p2 then raise_exc world "TypeError" "can't define singleton"
       else
       let env2 = map_new () in
       let _ = map_set env2 "self" recv in
       // string-form instance_eval resolves bare constants in the receiver's
       // class scope (cref).
       let _ = map_set env2 "__cref" (mkstr (class_name recv)) in
       eval_run env2 world blk p2
     | _ -> VNil)
  // is_a? / kind_of? walk the real (exception) hierarchy.
  else if (str_eq name "is_a?" || str_eq name "kind_of?") then
    (match args with
     | Cons (VClass c, _) -> VBool (obj_is_a world cls c)
     | _ -> VBool false)
  else if has_meth world cls name then
    (if vischeck && meth_private world cls name
     then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for an instance of " ++ display_cls world cls)
     else invoke world noblk recv cls name args)
  // explicit operator-method call (r.=~("s")) publishes $~ like the operator.
  else if str_eq name "=~" then
    (match recv with
     | VRegex (p, pf) -> (match args with Cons (VStr sv, _) -> let sv = sget sv in rx_do_match world p pf sv | _ -> VNil)
     | VStr sv -> let sv = sget sv in (match args with Cons (VRegex (p, pf), _) -> rx_do_match world p pf sv | _ -> VNil)
     | _ -> VNil)
  // enumerable methods without a block return an Enumerator over recv.<name>
  // (Ruby: [1,2].map => #<Enumerator: [1, 2]:map>).
  else if enum_needs_block name && (match recv with VArr _ -> true | VHsh _ -> true | VRange (_, _, _) -> true | _ -> false) then
    make_enum_a world recv name args
  // Enumerable extras needing === / world (blockless array forms).
  else if (str_eq name "grep" || str_eq name "grep_v") && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr aid ->
       (match args with
        | Cons (pat, _) -> arr_new (arr_grep world (deref aid) pat (str_eq name "grep_v"))
        | _ -> arr_new Nil)
     | _ -> VNil)
  else if str_eq name "one?" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr aid ->
       (match args with
        | Cons (pat, _) -> VBool (arr_count_eqq world (deref aid) pat 0 == 1)
        | _ -> VBool (arr_count_truthy (deref aid) 0 == 1))
     | _ -> VNil)
  else if str_eq name "minmax" && (match recv with VArr _ -> true | _ -> false) then
    arr_new (Cons (prim_method recv "min" Nil, Cons (prim_method recv "max" Nil, Nil)))
  else if str_eq name "each_entry" && (match recv with VArr _ -> true | _ -> false) then
    make_enum world recv "each"
  else if str_eq name "cycle" && (match recv with VArr _ -> true | VRange _ -> true | _ -> false) then
    make_enum_a world recv name args
  // block-less enumerators return a real Enumerator over recv.<name>
  // (materialized on demand by enum_to_arr; supports next/peek/to_a/map...).
  else if str_eq name "each_with_index" then
    (match recv with
     | VArr _ -> make_enum world recv name
     | VRange (_, _, _) -> make_enum world recv name
     | VStr _ -> make_enum world recv name
     | _ -> prim_method recv name args)
  else if str_eq name "each_char" && (match recv with VStr _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each_byte" && (match recv with VStr _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "times" && (match recv with VInt _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each" && (match recv with VArr _ -> true | VRange _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each_index" && (match recv with VArr _ -> true | _ -> false) then
    make_enum world recv name
  else if (str_eq name "each_slice" || str_eq name "each_cons") && (match recv with VArr _ -> true | VRange _ -> true | _ -> false) then
    make_enum_a world recv name args
  else if str_eq name "upto" && (match recv with VInt _ -> true | _ -> false) then
    make_enum_a world recv name args
  else if str_eq name "downto" && (match recv with VInt _ -> true | _ -> false) then
    make_enum_a world recv name args
  else if str_eq name "bytes" && (match recv with VStr _ -> true | _ -> false) then
    (match recv with VStr s -> arr_new (str_bytes_val (sget s) 0) | _ -> recv)
  else if str_eq name "combination" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with VArr id -> (match args with Cons (VInt k, _) -> arr_new (arr_combinations (deref id) k) | _ -> arr_new Nil) | _ -> recv)
  else if str_eq name "permutation" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with VArr id -> (match args with Cons (VInt k, _) -> arr_new (arr_permutations (deref id) k) | _ -> arr_new (arr_permutations (deref id) (vlen (deref id)))) | _ -> recv)
  else if str_eq name "product" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with VArr id -> (match args with Cons (VArr oid, _) -> arr_new (arr_product2 (deref id) (deref oid)) | _ -> arr_new Nil) | _ -> recv)
  // Comparable#clamp / #between? (any comparable receiver, incl. user <=>).
  else if str_eq name "clamp" then
    (match args with
     | Cons (VRange (lo, hi, _), _) -> (if cmp_vals recv (VInt lo) < 0 then VInt lo else if cmp_vals recv (VInt hi) > 0 then VInt hi else recv)
     | Cons (lo, Cons (hi, _)) -> (if cmp_vals_w world recv lo < 0 then lo else if cmp_vals_w world recv hi > 0 then hi else recv)
     | _ -> recv)
  else if str_eq name "between?" then
    (match args with Cons (lo, Cons (hi, _)) -> VBool (cmp_vals_w world recv lo >= 0 && cmp_vals_w world recv hi <= 0) | _ -> VBool false)
  // String#match? / #match (and the Regexp receiver forms).
  else if str_eq name "match?" && (match recv with VStr _ -> true | VRegex _ -> true | _ -> false) then
    (match recv with
     | VStr h -> let sv = sget h in (match args with Cons (VRegex (p, pf), _) -> VBool (rx_match p pf sv) | Cons (VStr p, _) -> VBool (rx_match (sget p) "" sv) | _ -> VBool false)
     | VRegex (p, pf) -> (match args with Cons (VStr sv, _) -> VBool (rx_match p pf (sget sv)) | _ -> VBool false)
     | _ -> VBool false)
  else if str_eq name "match" && (match recv with VStr _ -> true | VRegex _ -> true | _ -> false) then
    (match recv with
     | VStr h -> let sv = sget h in (match args with Cons (VRegex (p, pf), _) -> (let _ = rx_do_match world p pf sv in if map_has globals "~" then map_get globals "~" else VNil) | _ -> VNil)
     | VRegex (p, pf) -> (match args with Cons (VStr sv, _) -> (let _ = rx_do_match world p pf (sget sv) in if map_has globals "~" then map_get globals "~" else VNil) | _ -> VNil)
     | _ -> VNil)
  // fetch raises a catchable KeyError / IndexError when absent (no default/block).
  else if str_eq name "fetch" && (match recv with VHsh _ -> true | VArr _ -> true | _ -> false) then
    (match recv with
     | VHsh h -> let xs = hderef h in (match args with Cons (k, rest) -> (if hash_haskey xs k then hash_get xs k else (match rest with Cons (d, _) -> d | Nil -> raise_exc world "KeyError" ("key not found: " ++ inspect k))) | _ -> VNil)
     | VArr id -> let ys = deref id in let n = val_list_len ys in (match args with Cons (VInt i, rest) -> let j = (if i < 0 then n + i else i) in (if j >= 0 && j < n then val_nth ys j else (match rest with Cons (d, _) -> d | Nil -> raise_exc world "IndexError" ("index " ++ str_of_int i ++ " outside of array bounds: -" ++ str_of_int n ++ "..." ++ str_of_int n))) | _ -> VNil)
     | _ -> VNil)
  // sort/min/max of an array of user objects use their <=> (pure cmp_vals can't).
  else if str_eq name "sort" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> arr_new (sort_w world (deref id)) | _ -> recv)
  else if str_eq name "min" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> (match sort_w world (deref id) with Nil -> VNil | Cons (h, _) -> h) | _ -> VNil)
  else if str_eq name "max" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> (match val_rev (sort_w world (deref id)) Nil with Nil -> VNil | Cons (h, _) -> h) | _ -> VNil)
  // reduce/inject symbol form (no block): `[1,2,3].reduce(:+)` /
  // `.inject(init, :*)`. The block form is handled in invoke_with_block.
  else if (str_eq name "reduce" || str_eq name "inject") &&
          (match args with Cons (VSym _, _) -> true | Cons (_, Cons (VSym _, _)) -> true | _ -> false) then
    (match recv with
     | VArr id -> reduce_sym env world blk (deref id) args
     | VRange (lo, hi, excl) -> reduce_sym env world blk (range_to_a lo (if excl then hi - 1 else hi)) args
     | _ -> prim_method recv name args)
  else prim_method recv name args

// does `recv` respond to `name`? (used by respond_to?)
// a bound Method object: a synthetic-class VObj carrying receiver + name
// (+ the owner class resolved at creation time, for #owner/#unbind).
and mk_bound_method = fn world -> fn (recv: Val) -> fn (owner: str) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) "Method" in
  let _ = map_set ivars (str_of_int id ++ "@__m_name") (mkstr nm) in
  let _ = map_set ivars (str_of_int id ++ "@__m_owner") (mkstr owner) in
  let _ = map_set ivars (str_of_int id ++ "@__m_recv") recv in
  VObj id

// the class a receiver's method named nm is found in ("" = builtin/unknown).
and bm_owner_of = fn world -> fn (recv: Val) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  match recv with
  | VMain -> ""
  | VObj oid ->
    (let ocl = map_get ocls (str_of_int oid) in
     if map_has meths (ocl ++ "#" ++ nm) then ocl else lookup_anc world (ancestors_of world ocl) nm)
  | VClass c2 ->
    (let sng = "(sng:" ++ c2 ++ ")" in
     if map_has meths (sng ++ "#" ++ nm) then sng else lookup_anc world (ancestors_of world sng) nm)
  | other ->
    (let cn = class_name other in
     if map_has meths (cn ++ "#" ++ nm) then cn else lookup_anc world (ancestors_of world cn) nm)

// Method#arity from a user method's params/defaults (-1 for builtins).
and bm_arity = fn world -> fn (owner: str) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  if str_eq owner "" then 0 - 1
  else if map_has meths (owner ++ "#" ++ nm) then
    (match map_get meths (owner ++ "#" ++ nm) with
     | Meth (params, defaults, _) -> bm_arity_go params defaults 0 false)
  else if map_has meths nm then
    (match map_get meths nm with Meth (params, defaults, _) -> bm_arity_go params defaults 0 false)
  else 0 - 1
and bm_arity_go = fn (params: str list) -> fn (defaults: (str * Expr) list) -> fn (req: int) -> fn (opt: bool) ->
  match params with
  | Nil -> if opt then 0 - (req + 1) else req
  | Cons (pp, rest) ->
    if str_len pp > 0 && (str_eq (char_at pp 0) "*" || str_eq (char_at pp 0) "&") then
      bm_arity_go rest defaults req (opt || str_eq (char_at pp 0) "*")
    else if str_len pp > 0 && str_eq (char_at pp (str_len pp - 1)) ":" then
      bm_arity_go rest defaults req opt
    else if bm_has_default defaults pp then bm_arity_go rest defaults req true
    else bm_arity_go rest defaults (req + 1) opt
and bm_has_default = fn (defaults: (str * Expr) list) -> fn (pp: str) ->
  match defaults with
  | Nil -> false
  | Cons ((dn, _), rest) -> str_eq dn pp || bm_has_default rest pp

and responds = fn world -> fn (recv: Val) -> fn (name: str) ->
  match recv with
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls (str_of_int id) in
    has_meth world cls name || is_prim_method name
    // respond_to_missing?(name, include_private=false): a method_missing-based
    // object can claim to respond to names it has no real method for.
    || (has_meth world cls "respond_to_missing?"
        && truthy (invoke world (false, (Nil : str list), (Nil : Stmt list), map_new ()) (VObj id) cls "respond_to_missing?" (Cons (VSym name, Cons (VBool false, Nil)))))
  // a class/module responds via its class-method (metaclass) chain — the
  // has_meth walk of (sng:C) covers inherited class methods and, through
  // sng_supername's BasicObject -> Class step, Class/Module instance methods.
  // Instance methods of C itself do NOT make C respond (Ruby semantics).
  | VClass c -> str_eq name "new" || has_meth world ("(sng:" ++ c ++ ")") name || is_prim_method name
  | VStr _ -> is_prim_method name || is_str_method name
  | _ -> is_prim_method name

// string-specific method names dispatch_prim implements, for respond_to?.
and is_str_method = fn (name: str) ->
  str_eq name "length" || str_eq name "size" || str_eq name "empty?" ||
  str_eq name "chars" || str_eq name "lines" || str_eq name "bytes" ||
  str_eq name "split" || str_eq name "include?" || str_eq name "index" ||
  str_eq name "upcase" || str_eq name "downcase" || str_eq name "capitalize" ||
  str_eq name "swapcase" || str_eq name "reverse" || str_eq name "strip" ||
  str_eq name "lstrip" || str_eq name "rstrip" || str_eq name "chomp" ||
  str_eq name "chop" || str_eq name "start_with?" || str_eq name "end_with?" ||
  str_eq name "sub" || str_eq name "gsub" || str_eq name "tr" || str_eq name "replace" ||
  str_eq name "concat" || str_eq name "to_i" || str_eq name "to_f" || str_eq name "to_sym" ||
  str_eq name "each_char" || str_eq name "each_line" || str_eq name "count" ||
  str_eq name "scan" || str_eq name "match" || str_eq name "match?"

// a curated set of universally-available primitive method names.
and is_prim_method = fn (name: str) ->
  str_eq name "to_s" || str_eq name "inspect" || str_eq name "class" ||
  str_eq name "nil?" || str_eq name "frozen?" || str_eq name "freeze" ||
  str_eq name "dup" || str_eq name "clone" || str_eq name "itself" ||
  str_eq name "tap" || str_eq name "is_a?" || str_eq name "kind_of?" ||
  str_eq name "instance_of?" || str_eq name "respond_to?" || str_eq name "send" ||
  str_eq name "__send__" || str_eq name "hash" || str_eq name "object_id" ||
  str_eq name "==" || str_eq name "!=" || str_eq name "equal?"

// ---- in-place string mutation --------------------------------------------
// VStr is a handle into str_store, so a mutating method rewrites the store
// entry in place and EVERY alias sees the change (Ruby reference semantics).
and str_concat_vals = fn (args: Val list) ->
  match args with
  | Nil -> ""
  | Cons (v, rest) -> (match v with VStr s -> let s = sget s in s | _ -> to_s v) ++ str_concat_vals rest

// bang methods that delegate to an existing non-bang string transform.
and str_bang_base_ok = fn (b: str) ->
  str_eq b "upcase" || str_eq b "downcase" || str_eq b "capitalize" ||
  str_eq b "reverse" || str_eq b "strip" || str_eq b "succ" ||
  str_eq b "next" || str_eq b "delete" || str_eq b "swapcase" ||
  str_eq b "lstrip" || str_eq b "rstrip" || str_eq b "chomp" ||
  str_eq b "chop" || str_eq b "sub" || str_eq b "gsub" ||
  str_eq b "tr" || str_eq b "squeeze"

and is_str_mut = fn (name: str) ->
  str_eq name "concat" || str_eq name "replace" || str_eq name "clear" ||
  str_eq name "prepend"
  || (let n = str_len name in
      n > 1 && str_eq (char_at name (n - 1)) "!" && str_bang_base_ok (substring name 0 (n - 1)))

// mutate the string behind handle h in place; returns the method's value
// (the receiver itself, nil for an unchanged bang method, the assigned
// value for []=). Out-of-range []= indices are clamped.
and str_mut_do = fn (h: int) -> fn (name: str) -> fn (args: Val list) ->
  let s = sget h in
  if str_eq name "clear" then let _ = sset h "" in VStr h
  else if str_eq name "replace" then
    (match args with
     | Cons (v, _) -> let _ = sset h (match v with VStr a -> sget a | _ -> to_s v) in VStr h
     | Nil -> VStr h)
  else if str_eq name "concat" then let _ = sset h (s ++ str_concat_vals args) in VStr h
  else if str_eq name "prepend" then let _ = sset h (str_concat_vals args ++ s) in VStr h
  else if str_eq name "[]=" then
    (let n = str_len s in
     match args with
     | Cons (VInt i, Cons (VStr r, Nil)) ->
       let idx = if i < 0 then n + i else i in
       let e = if idx + 1 > n then n else idx + 1 in
       let _ = sset h (substring s 0 idx ++ sget r ++ substring s e n) in VStr r
     | Cons (VInt i, Cons (VInt len, Cons (VStr r, Nil))) ->
       let idx = if i < 0 then n + i else i in
       let e = if idx + len > n then n else idx + len in
       let _ = sset h (substring s 0 idx ++ sget r ++ substring s e n) in VStr r
     // s[m..n] = r : splice over the (clamped) range.
     | Cons (VRange (lo, hi, excl), Cons (VStr r, Nil)) ->
       let st = if lo < 0 then n + lo else lo in
       let en0 = if hi < 0 then n + hi else hi in
       let en1 = if excl then en0 else en0 + 1 in
       let e = if en1 > n then n else if en1 < st then st else en1 in
       let _ = sset h (substring s 0 st ++ sget r ++ substring s e n) in VStr r
     // s["sub"] = r : replace the first occurrence of sub.
     | Cons (VStr sub, Cons (VStr r, Nil)) ->
       let sub = sget sub in let i = str_find_from s sub 0 in
       (if i < 0 then VStr r
        else let _ = sset h (substring s 0 i ++ sget r ++ substring s (i + str_len sub) n) in VStr r)
     | _ -> VNil)
  else
    // bang: compute via the non-bang base; nil return when unchanged.
    let base = substring name 0 (str_len name - 1) in
    (match prim_method (mkstr s) base args with
     | VStr ns ->
       let ns2 = sget ns in
       if str_eq ns2 s then VNil else let _ = sset h ns2 in VStr h
     | other -> other)

and range_delegate_name = fn (name: str) ->
  str_eq name "each_slice" || str_eq name "each_cons" || str_eq name "zip" ||
  str_eq name "take" || str_eq name "drop" || str_eq name "values_at" ||
  str_eq name "rotate" || str_eq name "combination" || str_eq name "permutation" ||
  str_eq name "each_index" || str_eq name "product" || str_eq name "join"

and prim_method = fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  // a Range delegates array-only enumeration methods to its materialised form.
  if (match recv with VRange _ -> true | _ -> false) && range_delegate_name name then
    (match recv with VRange (lo, hi, excl) -> prim_method (arr_new (range_to_a lo (if excl then hi - 1 else hi))) name args | _ -> VNil)
  // universal
  else if str_eq name "to_s" then
    (match recv with
     | VInt n -> (match args with Cons (VInt base, _) -> mkstr (int_to_base n base) | _ -> mkstr (to_s recv))
     | _ -> mkstr (to_s recv))
  else if str_eq name "inspect" then mkstr (inspect recv)
  else if str_eq name "class" then VClass (class_name recv)
  else if str_eq name "nil?" then VBool (match recv with VNil -> true | _ -> false)
  else if str_eq name "frozen?" then
    // numbers/symbols/nil/booleans are always frozen; a string is frozen if
    // it was created under --enable-frozen-string-literal or explicitly frozen.
    // an object's singleton class is frozen exactly when the object is.
    VBool (match recv with VInt _ -> true | VFlt _ -> true | VBool _ -> true | VNil -> true | VSym _ -> true | VStr id -> sfrozen_get id | VObj id -> ofrozen_get id | VClass c -> is_sng_cls c && ofrozen_key (sng_inner c) | _ -> false)
  else if str_eq name "freeze" then (match recv with VStr id -> let _ = sfrozen_set id in recv | VObj id -> let _ = ofrozen_set id in recv | _ -> recv)
  else if str_eq name "dup" || str_eq name "clone" then
    // strings are handles now: dup MUST copy, else mutating the dup would
    // write through to the original.
    (match recv with VArr id -> arr_new (deref id) | VStr h -> mkstr (sget h) | VHsh h -> mkhash (hderef h) | _ -> recv)
  else if str_eq name "itself" then recv
  else if str_eq name "hash" then VInt (val_hash recv)
  else if str_eq name "tap" then recv
  else if str_eq name "__regex" then
    (match recv with VStr sp -> let sp = sget sp in VRegex (sp, (match args with Cons (VStr f, _) -> sget f | _ -> "")) | _ -> fail "no __regex")
  else if str_eq name "source" then
    (match recv with VRegex (p, _) -> mkstr p | _ -> fail "no source")
  else if str_eq name "casecmp?" then
    (match recv with
     | VStr a -> let a = sget a in (match args with Cons (VStr b2, _) -> let b2 = sget b2 in VBool (str_eq (str_downcase a) (str_downcase b2)) | _ -> VBool false)
     | _ -> fail "no casecmp?")
  else if str_eq name "ord" then
    (match recv with
     | VStr sv -> let sv = sget sv in (if str_len sv > 0 then VInt (match utf8_cp sv 0 with (c, l) -> c) else fail "no ord")
     | VInt n -> VInt n
     | _ -> fail "no ord")
  else if str_eq name "chr" then
    (match recv with VInt n -> mkstr (chr n) | VStr sv -> let sv = sget sv in mkstr (utf8_char sv 0) | _ -> fail "no chr")
  else if str_eq name "to_sym" then
    (match recv with VStr s -> let s = sget s in VSym s | VSym s -> VSym s | _ -> fail "no to_sym")
  else if str_eq name "equal?" then
    (match args with Cons (b, _) -> VBool (rb_identical recv b) | _ -> VBool false)
  else if str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?" then
    (match args with
     | Cons (VClass c, _) ->
       VBool (str_eq (class_name recv) c || str_eq c "Object" ||
              (str_eq c "Numeric" && (match recv with VInt _ -> true | VFlt _ -> true | _ -> false)))
     | _ -> VBool false)
  else if str_eq name "message" then (match recv with VExc (_, m) -> mkstr m | _ -> mkstr (to_s recv))
  else if str_eq name "to_i" then
    (match recv with
     | VInt n -> VInt n | VFlt f -> VInt (int_of_float f)
     | VBig s -> recv
     | VRat (n, d) -> norm_big (big_div_s n d)
     | VStr s -> let s = sget s in (match args with Cons (VInt base, _) -> VInt (str_to_int_base s base) | _ -> VInt (int_of_str s))
     | _ -> fail "mere-ruby: no to_i")
  else if str_eq name "to_f" then
    (match recv with VInt n -> VFlt (float_of_int n) | VFlt f -> VFlt f | VBig s -> VFlt (float_of_str s) | VRat (n, d) -> VFlt (float_of_str n / float_of_str d) | VStr s -> VFlt (float_of_str (sget s)) | _ -> fail "mere-ruby: no to_f")
  else if str_eq name "to_a" then
    (match recv with
     | VArr id -> VArr id
     | VHsh xs -> let xs = hderef xs in arr_new (hash_to_a xs)
     | VRange (lo, hi, excl) -> arr_new (range_to_a lo (if excl then hi - 1 else hi))
     | VNil -> arr_new Nil
     | _ -> fail "mere-ruby: no to_a")
  else if str_eq name "size" || str_eq name "length" then
    (match recv with
     | VArr id -> VInt (val_list_len (deref id)) | VStr s -> let s = sget s in VInt (utf8_len s)
     | VSym s -> VInt (utf8_len s)
     | VHsh xs -> let xs = hderef xs in VInt (hash_len xs) | _ -> fail "mere-ruby: no size")
  else if str_eq name "empty?" then
    (match recv with
     | VArr id -> VBool (val_list_len (deref id) == 0) | VStr s -> let s = sget s in VBool (str_len s == 0)
     | VHsh xs -> let xs = hderef xs in VBool (hash_len xs == 0) | _ -> fail "mere-ruby: no empty?")
  else if str_eq name "[]" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       (match args with
        | Cons (VInt i, Cons (VInt len, _)) -> arr_slice xs i len
        | Cons (VRange (lo, hi, excl), _) ->
          // a[m..n]: nil if start is past the end; [] if start == size or the
          // range is empty; otherwise the slice with the end index clamped.
          let n = val_list_len xs in
          let st = if lo <= 0 - 4611686018427387903 then 0 else if lo < 0 then n + lo else lo in
          if st < 0 || st > n then VNil
          else
            let en0 = if hi < 0 then n + hi else hi in
            let en1 = if excl then en0 - 1 else en0 in
            let en = if en1 >= n then n - 1 else en1 in
            let len = if en - st + 1 < 0 then 0 else en - st + 1 in
            arr_new (vtake (vdrop xs st) len)
        | Cons (VInt i, _) -> val_nth xs (if i < 0 then val_list_len xs + i else i)
        | _ -> VNil)
     | VStr s -> let s = sget s in let n = utf8_len s in
       (match args with
        // s[i, len]: codepoint substring of length len from i (negative i back).
        | Cons (VInt i, Cons (VInt len, _)) ->
          let st = if i < 0 then n + i else i in
          if st < 0 || st > n || len < 0 then VNil
          else let en = if st + len > n then n else st + len in mkstr (utf8_substr s st (en - st))
        // s[/re/] -> whole match; s[/re/, g] -> capture group g (nil if none).
        | Cons (VRegex (pat, pf), rest) ->
          (match rxv_search pat pf s 0 with
           | RBadPat ->
             (let _ = rx_clear_caps 1 in
              let st = rx_find_start pat s 0 in
              if st < 0 then VNil
              else
                let en = (let e = rxe_alts pat (rxe_start pat) s st in if e < 0 then st else e) in
                (match rest with
                 | Cons (VInt g, _) ->
                   if g == 0 then mkstr (substring s st en)
                   else (let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
                         if map_has rx_caps ks && map_has rx_caps ke then mkstr (substring s (map_get rx_caps ks) (map_get rx_caps ke)) else VNil)
                 | _ -> mkstr (substring s st en)))
           | RNoHit -> VNil
           | RHit (st, en, saves) ->
             let _ = rxv_export_caps saves (rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ pat))) in
             (match rest with
              | Cons (VInt g, _) ->
                if g == 0 then mkstr (substring s st en)
                else (let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
                      if map_has rx_caps ks && map_has rx_caps ke then mkstr (substring s (map_get rx_caps ks) (map_get rx_caps ke)) else VNil)
              | _ -> mkstr (substring s st en)))
        // s[lo..hi] / s[lo...hi]: codepoint substring over the (clamped) range.
        | Cons (VRange (lo, hi, excl), _) ->
          let st = if lo <= 0 - 4611686018427387903 then 0 else if lo < 0 then n + lo else lo in
          let en0 = if hi < 0 then n + hi else hi in
          let en1 = if excl then en0 else en0 + 1 in
          let en = if en1 > n then n else en1 in
          if st < 0 || st > n then VNil
          else mkstr (utf8_substr s st ((if en < st then st else en) - st))
        // s[i]: the one-character (codepoint) string at i, or nil out of range.
        | Cons (VInt i, _) ->
          let j = if i < 0 then n + i else i in
          if j >= 0 && j < n then mkstr (utf8_char s j) else VNil
        // s["sub"]: the substring itself if present, else nil.
        | Cons (VStr sub, _) -> let sub = sget sub in if str_contains s sub then mkstr sub else VNil
        | _ -> VNil)
     | VHsh hid -> let xs = hderef hid in (match args with Cons (k, _) -> if hash_haskey xs k then hash_get xs k else hdflt_get hid | _ -> VNil)
     // Integer#[i]: bit i of the number (0 for out-of-range high bits).
     | VInt n -> (match args with Cons (VInt i, _) -> (if i < 0 then VInt 0 else VInt (int_bitop "&" (n / int_pow 2 i) 1)) | _ -> VNil)
     | _ -> fail "mere-ruby: no []")
  // Integer
  else if str_eq name "gcd" then (match recv with VInt a -> (match args with Cons (VInt b, _) -> VInt (int_gcd a b) | _ -> VInt a) | _ -> fail "no gcd")
  else if str_eq name "lcm" then
    (match recv with VInt a -> (match args with Cons (VInt b, _) -> (let g = int_gcd a b in let l = (a / g) * b in VInt (if l < 0 then 0 - l else l)) | _ -> VInt a) | _ -> fail "no lcm")
  else if str_eq name "gcdlcm" then
    (match recv with VInt a -> (match args with Cons (VInt b, _) -> (let g = int_gcd a b in let l = (a / g) * b in arr_new (Cons (VInt g, Cons (VInt (if l < 0 then 0 - l else l), Nil)))) | _ -> VNil) | _ -> fail "no gcdlcm")
  else if str_eq name "digits" then
    (match recv with VInt n -> (match args with Cons (VInt base, _) -> arr_new (int_digits n base) | _ -> arr_new (int_digits n 10)) | _ -> fail "no digits")
  else if str_eq name "bit_length" then (match recv with VInt n -> VInt (int_bit_length (if n < 0 then 0 - n - 1 else n)) | _ -> fail "no bit_length")
  else if str_eq name "divmod" then
    (match recv with
     | VInt a -> (match args with Cons (VInt b, _) -> arr_new (Cons (VInt (floor_div a b), Cons (VInt (floor_mod a b), Nil))) | Cons (VBig b, _) -> arr_new (Cons (norm_big (big_div_s (str_of_int a) b), Cons (norm_big (big_mod_s (str_of_int a) b), Nil))) | Cons (VFlt b, _) -> let q = flt_floor (float_of_int a / b) in arr_new (Cons (VInt q, Cons (VFlt (float_of_int a - float_of_int q * b), Nil))) | _ -> VNil)
     | VBig a -> (match args with Cons (b, _) -> let bd = num_dec b in arr_new (Cons (norm_big (big_div_s a bd), Cons (norm_big (big_mod_s a bd), Nil))) | _ -> VNil)
     // Float#divmod: quotient floored to an Integer, remainder a Float.
     | VFlt a -> (match args with Cons (b, _) -> let bf = to_f b in let q = flt_floor (a / bf) in arr_new (Cons (VInt q, Cons (VFlt (a - float_of_int q * bf), Nil))) | _ -> VNil)
     | _ -> fail "no divmod")
  else if str_eq name "fdiv" then
    (match recv with
     | VInt a -> (match args with Cons (b, _) -> VFlt (to_f (VInt a) / to_f b) | _ -> VNil)
     | VFlt a -> (match args with Cons (b, _) -> VFlt (a / to_f b) | _ -> VNil)
     | _ -> fail "no fdiv")
  else if str_eq name "pow" then
    (match recv with VInt b -> (match args with Cons (VInt e, Cons (VInt m, _)) -> VInt (int_pow_mod b e m) | Cons (VInt e, _) -> VInt (int_pow b e) | _ -> VInt b) | _ -> fail "no pow")
  else if str_eq name "even?" then (match recv with VInt n -> VBool (floor_mod n 2 == 0) | _ -> fail "no even?")
  else if str_eq name "odd?" then (match recv with VInt n -> VBool (floor_mod n 2 != 0) | _ -> fail "no odd?")
  else if str_eq name "zero?" then (match recv with VInt n -> VBool (n == 0) | VFlt f -> VBool (f == 0.0) | VBig s -> VBool (str_eq s "0") | _ -> fail "no zero?")
  else if str_eq name "positive?" then (match recv with VInt n -> VBool (n > 0) | VFlt f -> VBool (f > 0.0) | VBig s -> VBool (cmp_vals recv (VInt 0) > 0) | VRat (n, d) -> VBool (big_sign n > 0) | _ -> fail "no positive?")
  else if str_eq name "negative?" then (match recv with VInt n -> VBool (n < 0) | VFlt f -> VBool (f < 0.0) | VBig s -> VBool (cmp_vals recv (VInt 0) < 0) | VRat (n, d) -> VBool (big_sign n < 0) | _ -> fail "no negative?")
  else if str_eq name "succ" || str_eq name "next" then (match recv with VInt n -> VInt (n + 1) | VStr s -> mkstr (str_succ (sget s)) | _ -> fail "no succ")
  else if str_eq name "pred" then (match recv with VInt n -> VInt (n - 1) | _ -> fail "no pred")
  else if str_eq name "abs" then
    (match recv with VInt n -> VInt (if n < 0 then 0 - n else n) | VFlt f -> VFlt (if f < 0.0 then 0.0 - f else f) | _ -> fail "no abs")
  else if str_eq name "nan?" then (match recv with VFlt f -> VBool (if f == f then false else true) | _ -> VBool false)
  else if str_eq name "infinite?" then
    (match recv with VFlt f -> (if (if f == f then false else true) then VNil else if (if f == 0.0 then false else true) && f * 0.5 == f then VInt (if f > 0.0 then 1 else 0 - 1) else VNil) | _ -> VNil)
  else if str_eq name "finite?" then
    (match recv with VFlt f -> VBool (if (if f == f then false else true) then false else if (if f == 0.0 then false else true) && f * 0.5 == f then false else true) | VInt _ -> VBool true | _ -> VBool false)
  else if str_eq name "floor" then
    (match recv with
     | VInt n -> (match args with Cons (VInt d, _) -> if d >= 0 then VInt n else (let m = int_pow 10 (0 - d) in VInt (floor_div n m * m)) | _ -> VInt n)
     | VFlt f -> (match args with Cons (VInt d, _) -> if d <= 0 then VInt (flt_floor f) else (let m = float_of_int (int_pow 10 d) in VFlt (float_of_int (flt_floor (f * m)) / m)) | _ -> VInt (flt_floor f))
     | _ -> fail "no floor")
  else if str_eq name "ceil" then
    (match recv with
     | VInt n -> (match args with Cons (VInt d, _) -> if d >= 0 then VInt n else (let m = int_pow 10 (0 - d) in VInt (0 - (floor_div (0 - n) m) * m)) | _ -> VInt n)
     | VFlt f -> (match args with Cons (VInt d, _) -> if d <= 0 then VInt (flt_ceil f) else (let m = float_of_int (int_pow 10 d) in VFlt (float_of_int (flt_ceil (f * m)) / m)) | _ -> VInt (flt_ceil f))
     | _ -> fail "no ceil")
  else if str_eq name "round" then
    (match recv with
     | VInt n -> (match args with Cons (VInt d, _) -> if d >= 0 then VInt n else VInt (int_round_place n (int_pow 10 (0 - d))) | _ -> VInt n)
     | VFlt f -> (match args with Cons (VInt d, _) -> if d <= 0 then VInt (flt_round f) else (let m = float_of_int (int_pow 10 d) in VFlt (float_of_int (flt_round (f * m)) / m)) | _ -> VInt (flt_round f))
     | _ -> fail "no round")
  else if str_eq name "truncate" then
    (match recv with VInt n -> VInt n | VFlt f -> VInt (int_of_float f) | _ -> fail "no truncate")
  else if str_eq name "numerator" then (match recv with VRat (n, d) -> norm_big n | VInt n -> VInt n | _ -> fail "no numerator")
  else if str_eq name "denominator" then (match recv with VRat (n, d) -> norm_big d | VInt n -> VInt 1 | _ -> fail "no denominator")
  else if str_eq name "to_r" then (match recv with VRat (n, d) -> recv | VInt n -> mk_rat n 1 | _ -> fail "no to_r")
  else if str_eq name "real" then (match recv with VCpx (r, i) -> r | VRat (n, d) -> recv | _ -> recv)
  else if str_eq name "imaginary" || str_eq name "imag" then (match recv with VCpx (r, i) -> i | _ -> VInt 0)
  else if str_eq name "real?" then (match recv with VCpx (r, i) -> VBool false | _ -> VBool true)
  else if str_eq name "conjugate" || str_eq name "conj" then (match recv with VCpx (r, i) -> VCpx (r, num_neg i) | _ -> recv)
  // String
  else if str_eq name "encoding" then
    (match recv with
     | VStr h -> let nm = senc_get h in (if map_has enc_objs nm then map_get enc_objs nm else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else mkstr nm)
     | _ -> fail "no encoding")
  else if str_eq name "force_encoding" then
    (match recv with VStr h -> (match args with Cons (VStr nm, _) -> let _ = senc_set h (sget nm) in recv | Cons (VObj _, _) -> (match args with Cons (e, _) -> let _ = senc_set h (to_s e) in recv | _ -> recv) | _ -> recv) | _ -> fail "no force_encoding")
  else if str_eq name "b" then
    (match recv with VStr h -> let c = mkstr (sget h) in (match c with VStr id -> let _ = senc_set id "ASCII-8BIT" in c | _ -> c) | _ -> fail "no b")
  else if str_eq name "bytesize" then (match recv with VStr h -> VInt (str_len (sget h)) | _ -> fail "no bytesize")
  else if str_eq name "ascii_only?" then (match recv with VStr h -> VBool (str_ascii_only (sget h) 0) | _ -> VBool false)
  else if str_eq name "valid_encoding?" then (match recv with VStr _ -> VBool true | _ -> VBool false)
  else if str_eq name "encode" || str_eq name "encode!" then
    (match recv with VStr h -> (match args with Cons (nm, _) -> let c = mkstr (sget h) in (match c with VStr id -> let _ = senc_set id (to_s nm) in c | _ -> c) | _ -> recv) | _ -> fail "no encode")
  else if str_eq name "upcase" then (match recv with VStr s -> let s = sget s in mkstr (str_upcase s) | _ -> fail "no upcase")
  else if str_eq name "downcase" then (match recv with VStr s -> let s = sget s in mkstr (str_downcase s) | _ -> fail "no downcase")
  else if str_eq name "capitalize" then (match recv with VStr s -> let s = sget s in mkstr (str_capitalize s) | _ -> fail "no capitalize")
  else if str_eq name "reverse" then
    (match recv with VStr s -> let s = sget s in mkstr (utf8_reverse s) | VArr id -> arr_new (val_rev (deref id) Nil) | _ -> fail "no reverse")
  else if str_eq name "strip" then (match recv with VStr s -> let s = sget s in mkstr (str_trim s) | _ -> fail "no strip")
  else if str_eq name "swapcase" then (match recv with VStr s -> mkstr (str_swapcase_u (sget s)) | _ -> fail "no swapcase")
  else if str_eq name "lstrip" then (match recv with VStr s -> mkstr (str_lstrip (sget s)) | _ -> fail "no lstrip")
  else if str_eq name "rstrip" then (match recv with VStr s -> mkstr (str_rstrip (sget s)) | _ -> fail "no rstrip")
  else if str_eq name "chomp" then
    (match recv with
     | VStr s -> let s = sget s in
       (match args with
        | Cons (VStr suf, _) -> let suf = sget suf in let ns = str_len s in let ms = str_len suf in
          if ms > 0 && ns >= ms && str_eq (substring s (ns - ms) ns) suf then mkstr (substring s 0 (ns - ms)) else mkstr s
        | _ -> mkstr (str_chomp s))
     | _ -> fail "no chomp")
  else if str_eq name "chop" then (match recv with VStr s -> mkstr (str_chop (sget s)) | _ -> fail "no chop")
  else if str_eq name "slice" then prim_method recv "[]" args
  else if str_eq name "tr" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VStr f, Cons (VStr t, _)) -> mkstr (str_tr s (sget f) (sget t)) | _ -> mkstr s)
     | _ -> fail "no tr")
  else if str_eq name "squeeze" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VStr set, _) -> mkstr (str_squeeze s (sget set) true) | _ -> mkstr (str_squeeze s "" false))
     | _ -> fail "no squeeze")
  else if str_eq name "ljust" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VInt w, Cons (VStr p, _)) -> mkstr (str_ljust s w (sget p)) | Cons (VInt w, _) -> mkstr (str_ljust s w " ") | _ -> mkstr s)
     | _ -> fail "no ljust")
  else if str_eq name "rjust" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VInt w, Cons (VStr p, _)) -> mkstr (str_rjust s w (sget p)) | Cons (VInt w, _) -> mkstr (str_rjust s w " ") | _ -> mkstr s)
     | _ -> fail "no rjust")
  else if str_eq name "center" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VInt w, Cons (VStr p, _)) -> mkstr (str_center s w (sget p)) | Cons (VInt w, _) -> mkstr (str_center s w " ") | _ -> mkstr s)
     | _ -> fail "no center")
  else if str_eq name "partition" then
    (match recv with
     | VStr s -> let s = sget s in
       (match args with
        | Cons (VStr sep, _) -> let sep = sget sep in let i = str_find_from s sep 0 in
          if i < 0 then arr_new (Cons (mkstr s, Cons (mkstr "", Cons (mkstr "", Nil))))
          else arr_new (Cons (mkstr (substring s 0 i), Cons (mkstr sep, Cons (mkstr (substring s (i + str_len sep) (str_len s)), Nil))))
        | _ -> arr_new (Cons (mkstr s, Cons (mkstr "", Cons (mkstr "", Nil)))))
     | _ -> fail "no partition")
  else if str_eq name "rpartition" then
    (match recv with
     | VStr s -> let s = sget s in
       (match args with
        | Cons (VStr sep, _) -> let sep = sget sep in let i = str_rindex_go s sep (str_len s - str_len sep) in
          if i < 0 then arr_new (Cons (mkstr "", Cons (mkstr "", Cons (mkstr s, Nil))))
          else arr_new (Cons (mkstr (substring s 0 i), Cons (mkstr sep, Cons (mkstr (substring s (i + str_len sep) (str_len s)), Nil))))
        | _ -> arr_new (Cons (mkstr "", Cons (mkstr "", Cons (mkstr s, Nil)))))
     | _ -> fail "no rpartition")
  else if str_eq name "delete_prefix" then
    (match recv with VStr s -> let s = sget s in (match args with Cons (VStr p, _) -> let p = sget p in (if str_starts_with s p then mkstr (substring s (str_len p) (str_len s)) else mkstr s) | _ -> mkstr s) | _ -> fail "no delete_prefix")
  else if str_eq name "delete_suffix" then
    (match recv with VStr s -> let s = sget s in (match args with Cons (VStr p, _) -> let p = sget p in (if str_ends_with s p then mkstr (substring s 0 (str_len s - str_len p)) else mkstr s) | _ -> mkstr s) | _ -> fail "no delete_suffix")
  else if str_eq name "sub" || str_eq name "gsub" then
    (match recv with
     | VStr s -> let s = sget s in
       (match args with
        | Cons (VStr pat, Cons (VStr rep, _)) ->
          let pat = sget pat in let rep = sget rep in
          mkstr (if str_eq name "gsub" then str_gsub_lit s pat rep else str_sub_lit s pat rep)
        | Cons (VRegex (pat, pf), Cons (VStr rep, _)) ->
          let rep = sget rep in
          mkstr (rx_gsub_go2 pat pf s rep 0 (str_eq name "gsub") "")
        | _ -> mkstr s)
     | _ -> fail "no sub")
  else if str_eq name "chars" then (match recv with VStr s -> let s = sget s in arr_new (utf8_chars_val s 0) | _ -> fail "no chars")
  else if str_eq name "scan" then
    (match recv with
     | VStr s -> let s = sget s in
       (match args with
        | Cons (VRegex (pat, pf), _) -> arr_new (rx_scan_all2 pat pf s 0)
        | Cons (VStr pat, _) -> let pat = sget pat in arr_new (rx_scan_all2 pat "" s 0)
        | _ -> arr_new Nil)
     | _ -> fail "no scan")
  else if str_eq name "lines" then (match recv with VStr s -> let s = sget s in arr_new (val_list_of_strs (str_lines_go s 0 0 (str_len s))) | _ -> fail "no lines")
  else if str_eq name "split" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VRegex (pat, pf), _) -> arr_new (rx_split pat pf s) | Cons (VStr sep, Cons (VInt lim, _)) -> arr_new (val_list_of_strs (split_with_limit s (sget sep) lim)) | Cons (VStr sep, _) -> let sep = sget sep in arr_new (val_list_of_strs (str_split s sep)) | _ -> arr_new (val_list_of_strs (str_split s " ")))
     | _ -> fail "no split")
  else if str_eq name "include?" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VStr sub, _) -> let sub = sget sub in VBool (str_contains s sub) | _ -> VBool false)
     | VArr id -> (match args with Cons (v, _) -> VBool (val_contains (deref id) v) | _ -> VBool false)
     | VHsh xs -> let xs = hderef xs in (match args with Cons (k, _) -> VBool (hash_haskey xs k) | _ -> VBool false)
     | _ -> fail "no include?")
  else if str_eq name "start_with?" then
    (match recv with VStr s -> let s = sget s in (match args with Cons (VStr p, _) -> let p = sget p in VBool (str_starts_with s p) | _ -> VBool false) | _ -> fail "no start_with?")
  else if str_eq name "end_with?" then
    (match recv with VStr s -> let s = sget s in (match args with Cons (VStr p, _) -> let p = sget p in VBool (str_ends_with s p) | _ -> VBool false) | _ -> fail "no end_with?")
  // Array
  else if str_eq name "first" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       (match args with
        | Cons (VInt n, _) -> arr_new (vtake xs (if n < 0 then 0 else n))
        | _ -> val_nth xs 0)
     | _ -> fail "no first")
  else if str_eq name "last" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       let len = val_list_len xs in
       (match args with
        | Cons (VInt n, _) -> let k = if n < 0 then 0 else n in arr_new (vdrop xs (if len - k < 0 then 0 else len - k))
        | _ -> val_nth xs (len - 1))
     | _ -> fail "no last")
  else if str_eq name "sort" then (match recv with VArr id -> arr_new (val_sort (deref id)) | VHsh xs -> arr_new (val_sort (hash_pairs (hderef xs))) | _ -> fail "no sort")
  else if str_eq name "uniq" then (match recv with VArr id -> arr_new (val_uniq (deref id) Nil) | _ -> fail "no uniq")
  else if str_eq name "flatten" then
    (match recv with VArr id -> (match args with Cons (VInt d, _) -> arr_new (val_flatten (deref id) d) | _ -> arr_new (val_flatten (deref id) (0 - 1))) | _ -> fail "no flatten")
  else if str_eq name "compact" then (match recv with VArr id -> arr_new (val_compact (deref id)) | _ -> fail "no compact")
  else if str_eq name "tally" then (match recv with VArr id -> val_tally (deref id) Nil | _ -> fail "no tally")
  else if str_eq name "minmax" then (match recv with VArr id -> val_minmax (deref id) | _ -> fail "no minmax")
  else if str_eq name "each_slice" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (val_slices (deref id) n) | _ -> recv) | _ -> fail "no each_slice")
  else if str_eq name "each_cons" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (val_cons_windows (deref id) n) | _ -> recv) | _ -> fail "no each_cons")
  else if str_eq name "take" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (vtake (deref id) n) | _ -> arr_new Nil) | _ -> fail "no take")
  else if str_eq name "drop" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (vdrop (deref id) n) | _ -> recv) | _ -> fail "no drop")
  else if str_eq name "zip" then
    (match recv with VArr id -> let xs = deref id in arr_new (val_zip xs args 0 (val_list_len xs)) | _ -> fail "no zip")
  else if str_eq name "transpose" then
    (match recv with
     | VArr id -> let rows = deref id in
       (match rows with Nil -> arr_new Nil | Cons (VArr r0, _) -> arr_new (val_transpose rows 0 (val_list_len (deref r0))) | _ -> fail "transpose: not an array of arrays")
     | _ -> fail "no transpose")
  else if str_eq name "rotate" then
    (match recv with
     | VArr id -> let xs = deref id in let len = val_list_len xs in
       if len == 0 then arr_new Nil
       else let n0 = (match args with Cons (VInt n, _) -> n | _ -> 1) in
            let k = floor_mod n0 len in arr_new (list_append (vdrop xs k) (vtake xs k))
     | _ -> fail "no rotate")
  else if str_eq name "min" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (vtake (val_sort (deref id)) n) | _ -> (match deref id with Nil -> VNil | Cons (h, t) -> val_min t h)) | _ -> fail "no min")
  else if str_eq name "max" then (match recv with VArr id -> (match args with Cons (VInt n, _) -> arr_new (vtake (val_rev (val_sort (deref id)) Nil) n) | _ -> (match deref id with Nil -> VNil | Cons (h, t) -> val_max t h)) | _ -> fail "no max")
  else if str_eq name "sum" then (match recv with VArr id -> val_sum (deref id) (match args with Cons (init, _) -> init | _ -> VInt 0) | VRange (lo, hi, excl) -> val_sum (range_to_a lo (if excl then hi - 1 else hi)) (match args with Cons (init, _) -> init | _ -> VInt 0) | _ -> fail "no sum")
  // Range#step(n) without a block: materialise the stepped values (the usual
  // consumer is `.step(n).to_a`/`.each`/`.map` on the result).
  else if str_eq name "step" then
    (match recv with
     | VRange (lo, hi, excl) -> (match args with Cons (VInt n, _) -> arr_new (range_step_arr lo (if excl then hi - 1 else hi) n) | _ -> arr_new (range_to_a lo (if excl then hi - 1 else hi)))
     | _ -> fail "no step")
  else if str_eq name "index" then
    (match recv with
     | VArr id -> (match args with Cons (v, _) -> val_index_of (deref id) v 0 | _ -> VNil)
     | VStr s -> let s = sget s in (match args with Cons (VStr sub, Cons (VInt off, _)) -> let st = (if off < 0 then str_len s + off else off) in let i = str_find_from s (sget sub) (if st < 0 then 0 else st) in (if i < 0 then VNil else VInt i) | Cons (VStr sub, _) -> let i = str_find_from s (sget sub) 0 in (if i < 0 then VNil else VInt i) | _ -> VNil)
     | _ -> fail "no index")
  else if str_eq name "rindex" then
    (match recv with
     | VStr s -> let s = sget s in (match args with Cons (VStr sub, _) -> let sub = sget sub in let i = str_rindex_go s sub (str_len s - str_len sub) in if i < 0 then VNil else VInt i | _ -> VNil)
     | _ -> fail "no rindex")
  else if str_eq name "count" then
    (match recv with
     | VArr id -> let xs = deref id in (match args with Cons (v, _) -> VInt (val_count_eq xs v) | Nil -> VInt (val_list_len xs))
     | VStr s -> let s = sget s in (match args with Cons (VStr _, _) -> VInt (str_count_sets s (collect_str_args args)) | _ -> VInt 0)
     | VHsh xs -> VInt (vlen (hash_keys (hderef xs)))
     | _ -> fail "no count")
  else if str_eq name "join" then
    (match recv with VArr id -> let xs = deref id in (match args with Cons (VStr sep, _) -> let sep = sget sep in mkstr (val_join xs sep "" true) | _ -> mkstr (val_join xs "" "" true)) | _ -> fail "no join")
  else if str_eq name "to_h" then (match recv with VArr id -> mkhash (val_to_h (deref id)) | VHsh xs -> mkhash (hderef xs) | _ -> fail "no to_h")
  // Hash
  // Array mutation (in place; VArr is a handle into the shared store).
  else if str_eq name "push" || str_eq name "append" then
    (match recv with VArr id -> let _ = arr_set id (list_append (deref id) args) in recv | _ -> fail "no push")
  else if str_eq name "sort!" then
    (match recv with VArr id -> let _ = arr_set id (val_sort (deref id)) in recv | _ -> fail "no sort!")
  else if str_eq name "reverse!" then
    (match recv with VArr id -> let _ = arr_set id (val_rev (deref id) Nil) in recv | _ -> fail "no reverse!")
  else if str_eq name "uniq!" then
    (match recv with VArr id -> let _ = arr_set id (val_uniq (deref id) Nil) in recv | _ -> fail "no uniq!")
  else if str_eq name "insert" then
    (match recv with
     | VArr id -> (match args with Cons (VInt i, rest) -> let xs = deref id in let n = val_list_len xs in let k = (if i < 0 then n + i + 1 else i) in let _ = arr_set id (list_append (vtake xs k) (list_append rest (vdrop xs k))) in recv | _ -> recv)
     | VStr h -> (match args with Cons (VInt i, Cons (VStr ins, _)) -> let s = sget h in let ins = sget ins in let k = (if i < 0 then str_len s + i + 1 else i) in let _ = sset h (substring s 0 k ++ ins ++ substring s k (str_len s)) in recv | _ -> recv)
     | _ -> fail "no insert")
  else if str_eq name "fill" then
    (match recv with VArr id -> (match args with Cons (v, _) -> let _ = arr_set id (val_repeat (val_list_len (deref id)) v) in recv | _ -> recv) | _ -> fail "no fill")
  else if str_eq name "delete" then
    (match recv with
     | VArr id ->
       (match args with
        | Cons (v, _) ->
          let xs = deref id in
          let had = val_member xs v in
          let _ = arr_set id (val_remove xs v) in
          if had then v else VNil
        | Nil -> VNil)
     | VHsh h ->
       (match args with
        | Cons (k, _) ->
          let xs = hderef h in
          let had = hash_haskey xs k in
          let v = (if had then hash_get xs k else VNil) in
          let _ = hset h (hash_del xs k) in v
        | Nil -> VNil)
     | VStr s -> let s = sget s in (match args with Cons (VStr _, _) -> mkstr (str_delete_sets s (collect_str_args args)) | _ -> mkstr s)
     | _ -> fail "no delete")
  else if str_eq name "flatten!" then
    (match recv with VArr id -> let flat = val_flatten (deref id) (match args with Cons (VInt d, _) -> d | _ -> 0 - 1) in let _ = arr_set id flat in recv | _ -> fail "no flatten!")
  else if str_eq name "compact!" then
    (match recv with VArr id -> let xs = deref id in let c = val_compact xs in let _ = arr_set id c in (if val_list_len c == val_list_len xs then VNil else recv) | _ -> fail "no compact!")
  else if str_eq name "pop" then
    (match recv with
     | VArr id -> let xs = deref id in let len = val_list_len xs in
       (match args with
        | Cons (VInt n, _) -> let k = if n < 0 then 0 else if n > len then len else n in
          let _ = arr_set id (vtake xs (len - k)) in arr_new (vdrop xs (len - k))
        | _ -> (match xs with Nil -> VNil | _ -> let _ = arr_set id (val_init xs) in val_last xs))
     | _ -> fail "no pop")
  else if str_eq name "shift" then
    (match recv with
     | VArr id -> let xs = deref id in let len = val_list_len xs in
       (match args with
        | Cons (VInt n, _) -> let k = if n < 0 then 0 else if n > len then len else n in
          let _ = arr_set id (vdrop xs k) in arr_new (vtake xs k)
        | _ -> (match xs with Nil -> VNil | Cons (h, t) -> let _ = arr_set id t in h))
     | _ -> fail "no shift")
  // Array#replace: swap in the other array's contents (aliases see it).
  else if str_eq name "replace" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr id ->
       (match args with
        | Cons (VArr oid, _) -> let _ = arr_set id (deref oid) in recv
        | _ -> recv)
     | _ -> recv)
  else if str_eq name "unshift" || str_eq name "prepend" then
    (match recv with VArr id -> (match args with Cons (v, _) -> let _ = arr_set id (Cons (v, deref id)) in recv | Nil -> recv) | _ -> fail "no unshift")
  else if str_eq name "concat" then
    (match recv with VArr id -> (match args with Cons (VArr oid, _) -> let _ = arr_set id (list_append (deref id) (deref oid)) in recv | _ -> recv) | _ -> fail "no concat")
  else if str_eq name "clear" then
    (match recv with VArr id -> let _ = arr_set id Nil in recv | _ -> fail "no clear")
  else if str_eq name "[]=" then
    (match recv with
     | VArr id ->
       (match args with
        | Cons (VInt i, Cons (VInt len, Cons (v, Nil))) ->
          let _ = arr_set id (arr_splice (deref id) i len v) in v
        | Cons (VRange (lo, hi, excl), Cons (v, Nil)) ->
          let xs = deref id in
          let n = val_list_len xs in
          let st = if lo < 0 then n + lo else lo in
          let en0 = if hi < 0 then n + hi else hi in
          let en = if excl then en0 - 1 else en0 in
          let _ = arr_set id (arr_splice xs st (en - st + 1) v) in v
        | Cons (VInt i, Cons (v, _)) ->
          let xs = deref id in
          let n = val_list_len xs in
          let j = if i < 0 then n + i else i in
          let _ = arr_set id (val_set_at xs j v) in v
        | _ -> VNil)
     | _ -> fail "no []=")
  else if str_eq name "keys" then (match recv with VHsh xs -> let xs = hderef xs in arr_new (hash_keys xs) | _ -> fail "no keys")
  else if str_eq name "values" then (match recv with VHsh xs -> let xs = hderef xs in arr_new (hash_values xs) | _ -> fail "no values")
  else if str_eq name "key?" || str_eq name "has_key?" || str_eq name "include?" || str_eq name "member?" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (k, _) -> VBool (hash_haskey xs k) | _ -> VBool false) | _ -> fail "no key?")
  else if str_eq name "has_value?" || str_eq name "value?" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (v, _) -> VBool (hash_has_value xs v) | _ -> VBool false) | _ -> fail "no value?")
  else if str_eq name "each_pair" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with VHsh xs -> arr_new (hash_pairs (hderef xs)) | _ -> VNil)
  else if str_eq name "merge" then
    (match recv with VHsh xs -> mkhash (hash_merge_all (hderef xs) args) | _ -> fail "no merge")
  else if str_eq name "merge!" || str_eq name "update" then
    (match recv with VHsh h -> let _ = hset h (hash_merge_all (hderef h) args) in recv | _ -> fail "no merge!")
  else if str_eq name "default" then (match recv with VHsh hid -> hdflt_get hid | _ -> VNil)
  else if str_eq name "invert" then
    (match recv with VHsh xs -> mkhash (hash_invert (hderef xs)) | _ -> fail "no invert")
  else if str_eq name "fetch" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (k, rest) -> if hash_haskey xs k then hash_get xs k else (match rest with Cons (d, _) -> d | Nil -> VNil) | _ -> VNil) | _ -> fail "no fetch")
  else if str_eq name "key" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (v, _) -> hash_key_of xs v | _ -> VNil) | _ -> fail "no key")
  else if str_eq name "values_at" then
    (match recv with VHsh xs -> let xs = hderef xs in arr_new (hash_values_at xs args) | VArr id -> arr_new (arr_values_at (deref id) args) | _ -> fail "no values_at")
  else if str_eq name "dig" then
    (match recv with
     | VHsh xs -> let xs = hderef xs in (match args with Cons (k, rest) -> let v = hash_get xs k in (match rest with Nil -> v | _ -> if (match v with VNil -> true | _ -> false) then VNil else prim_method v "dig" rest) | _ -> VNil)
     | VArr id -> (match args with Cons (VInt i, rest) -> let v = val_nth (deref id) (if i < 0 then val_list_len (deref id) + i else i) in (match rest with Nil -> v | _ -> if (match v with VNil -> true | _ -> false) then VNil else prim_method v "dig" rest) | _ -> VNil)
     | _ -> fail "no dig")
  else (let _ = map_set prim_missing "n" (mkstr name) in fail ("mere-ruby: undefined method '" ++ name ++ "' for this value"))

and class_name = fn (recv: Val) ->
  match recv with
  | VInt _ -> "Integer" | VBig _ -> "Integer" | VFlt _ -> "Float" | VStr _ -> "String"
  | VRat _ -> "Rational" | VCpx _ -> "Complex"
  | VBool b -> if b then "TrueClass" else "FalseClass"
  | VNil -> "NilClass" | VArr _ -> "Array" | VHsh _ -> "Hash" | VSym _ -> "Symbol"
  | VRange _ -> "Range" | VClass c -> (if map_has modules c then "Module" else "Class") | VObj _ -> "Object"
  | VExc (c, _) -> c | VProc _ -> "Proc" | VBind _ -> "Binding" | VRegex _ -> "Regexp" | VMain -> "Object"

and range_to_a = fn (i: int) -> fn (last: int) ->
  if i > last then Nil else Cons (VInt i, range_to_a (i + 1) last)

// reduce/inject with an operator symbol: fold by sending `sym` to the
// accumulator with each element (so :+ / :* / any method all work).
and reduce_sym = fn env -> fn world -> fn blk -> fn (xs: Val list) -> fn (args: Val list) ->
  match args with
  | Cons (VSym sym, _) -> (match xs with Nil -> VNil | Cons (h, t) -> reduce_sym_go env world blk t h sym)
  | Cons (init, Cons (VSym sym, _)) -> reduce_sym_go env world blk xs init sym
  | _ -> fail "mere-ruby: reduce expects a symbol or block"

and reduce_sym_go = fn env -> fn world -> fn blk -> fn (xs: Val list) -> fn (acc: Val) -> fn (sym: str) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> reduce_sym_go env world blk t (apply_bin_vals world blk sym acc h) sym

// world-aware compare: a VObj with a user <=> uses it; everything else
// falls back to the pure cmp_vals. Lets sort/min/max/clamp work on
// Comparable user objects.
and cmp_vals_w = fn world -> fn (a: Val) -> fn (b: Val) ->
  match a with
  | VObj oid ->
    let (meths, sup, ocls, ivars) = world in
    let ocl = map_get ocls (str_of_int oid) in
    if has_meth world ocl "<=>" then
      let noblk = (false, (Nil : str list), (Nil : Stmt list), ivars) in
      (match invoke world noblk a ocl "<=>" (Cons (b, Nil)) with VInt n -> n | _ -> 0)
    else cmp_vals a b
  | _ -> cmp_vals a b

// insertion sort using the world-aware comparator.
and sort_w = fn world -> fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> insert_w world h (sort_w world t)
and insert_w = fn world -> fn (x: Val) -> fn (sorted: Val list) ->
  match sorted with
  | Nil -> Cons (x, Nil)
  | Cons (h, t) -> if cmp_vals_w world x h <= 0 then Cons (x, sorted) else Cons (h, insert_w world x t)

// apply a binary operator (named by a symbol like :+) to two runtime values
// by evaluating a real EBin over a scratch env — reuses all operator logic.
and apply_bin_vals = fn world -> fn blk -> fn (op: str) -> fn (a: Val) -> fn (b: Val) ->
  let e2 = map_new () in
  let _ = map_set e2 "__ra" a in
  let _ = map_set e2 "__rb" b in
  eval_e e2 world blk (EBin (op, EVar "__ra", EVar "__rb"))

// Hash#merge with a conflict block: on a duplicate key, the value is
// block(key, old_value, new_value). Folds every VHsh argument left to right.
and hash_merge_block = fn world -> fn nb -> fn (base: Val list) -> fn (args: Val list) ->
  match args with
  | Nil -> base
  | Cons (VHsh o, t) -> hash_merge_block world nb (hash_merge_one_block world nb base (hderef o)) t
  | Cons (_, t) -> hash_merge_block world nb base t

and hash_merge_one_block = fn world -> fn nb -> fn (base: Val list) -> fn (other: Val list) ->
  match other with
  | Nil -> base
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       let amb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
       let nv = (if hash_haskey base k
                 then flow_value (run_block world amb nb (Cons (k, Cons (hash_get base k, Cons (v, Nil)))))
                 else v) in
       hash_merge_one_block world nb (hash_put base k nv) t
     | Nil -> base)

// ---- sprintf/format/`%` string formatting -------------------------------
// %[flags][width][.prec]type ; flags: - + 0 space # ; types: d i u s f x X o b c
and rb_format = fn (fmt: str) -> fn (args: Val list) -> rb_format_go fmt 0 args ""

and rb_format_go = fn (fmt: str) -> fn (i: int) -> fn (args: Val list) -> fn (acc: str) ->
  let n = str_len fmt in
  if i >= n then acc
  else
    let c = char_at fmt i in
    if str_eq c "%" then
      (if i + 1 < n && str_eq (char_at fmt (i + 1)) "%" then rb_format_go fmt (i + 2) args (acc ++ "%")
       else
         let (flags, i1) = rb_fmt_flags fmt (i + 1) "" in
         let (width, i2) = rb_fmt_digits fmt i1 0 false in
         let (prec, i3) = rb_fmt_prec fmt i2 in
         let typ = (if i3 < n then char_at fmt i3 else "") in
         (match args with
          | Cons (av, rest) -> rb_format_go fmt (i3 + 1) rest (acc ++ rb_fmt_one flags width prec typ av)
          | Nil -> rb_format_go fmt (i3 + 1) Nil (acc ++ rb_fmt_one flags width prec typ VNil)))
    else rb_format_go fmt (i + 1) args (acc ++ c)

and rb_fmt_flags = fn (fmt: str) -> fn (i: int) -> fn (acc: str) ->
  if i < str_len fmt &&
     (let c = char_at fmt i in str_eq c "-" || str_eq c "+" || str_eq c "0" || str_eq c " " || str_eq c "#")
  then rb_fmt_flags fmt (i + 1) (acc ++ char_at fmt i)
  else (acc, i)

and rb_fmt_digits = fn (fmt: str) -> fn (i: int) -> fn (acc: int) -> fn (seen: bool) ->
  if i < str_len fmt && is_digit (char_at fmt i)
  then rb_fmt_digits fmt (i + 1) (acc * 10 + (ord (char_at fmt i) - 48)) true
  else ((if seen then acc else 0 - 1), i)

and rb_fmt_prec = fn (fmt: str) -> fn (i: int) ->
  if i < str_len fmt && str_eq (char_at fmt i) "." then
    let (p, j) = rb_fmt_digits fmt (i + 1) 0 false in ((if p < 0 then 0 else p), j)
  else (0 - 1, i)

and fmt_to_int = fn (av: Val) ->
  match av with VInt n -> n | VFlt f -> int_of_float f | VStr h -> int_of_str (sget h) | _ -> 0

and rb_pad_str = fn (s: str) -> fn (flags: str) -> fn (width: int) ->
  let len = str_len s in
  if width <= len then s
  else if str_contains flags "-" then s ++ str_repeat " " (width - len)
  else str_repeat " " (width - len) ++ s

and rb_pad_num = fn (sign: str) -> fn (ds: str) -> fn (flags: str) -> fn (width: int) ->
  let body = sign ++ ds in
  let len = str_len body in
  if width <= len then body
  else if str_contains flags "-" then body ++ str_repeat " " (width - len)
  else if str_contains flags "0" then sign ++ str_repeat "0" (width - len) ++ ds
  else str_repeat " " (width - len) ++ body

and ascii_up = fn (s: str) -> ascii_up_go s 0 ""
and ascii_up_go = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else let c = char_at s i in
       ascii_up_go s (i + 1) (acc ++ (if c >= "a" && c <= "z" then chr (ord c - 32) else c))

and pow10i = fn (p: int) -> if p <= 0 then 1 else 10 * pow10i (p - 1)

and pad_frac = fn (s: str) -> fn (prec: int) ->
  if str_len s >= prec then s else str_repeat "0" (prec - str_len s) ++ s

and fmt_float_abs = fn (av: Val) -> fn (prec: int) ->
  let f0 = to_f av in
  let f = (if f0 < 0.0 then 0.0 - f0 else f0) in
  let scalei = pow10i prec in
  let si = int_of_float (f * float_of_int scalei + 0.5) in
  if prec == 0 then int_to_base si 10
  else
    let ip = si / scalei in
    let fp = si - ip * scalei in
    int_to_base ip 10 ++ "." ++ pad_frac (int_to_base fp 10) prec

and sci_norm_up = fn (f: float) -> fn (e: int) -> if f >= 10.0 then sci_norm_up (f / 10.0) (e + 1) else (f, e)
and sci_norm_down = fn (f: float) -> fn (e: int) -> if f < 1.0 then sci_norm_down (f * 10.0) (e - 1) else (f, e)

// abs value formatted as scientific notation mantissa+e+exp (no leading sign).
and fmt_sci_abs = fn (av: Val) -> fn (prec: int) -> fn (upper: bool) ->
  let f0 = to_f av in
  let f = (if f0 < 0.0 then 0.0 - f0 else f0) in
  let (m0, e0) = (if f == 0.0 then (0.0, 0) else (let (m1, e1) = sci_norm_up f 0 in sci_norm_down m1 e1)) in
  let scalei = pow10i prec in
  let mr0 = int_of_float (m0 * float_of_int scalei + 0.5) in
  let (mr, e) = (if mr0 >= 10 * scalei then (mr0 / 10, e0 + 1) else (mr0, e0)) in
  let ip = mr / scalei in
  let fp = mr - ip * scalei in
  let mant = (if prec == 0 then int_to_base ip 10 else int_to_base ip 10 ++ "." ++ pad_frac (int_to_base fp 10) prec) in
  let eabs = (if e < 0 then 0 - e else e) in
  let estr = (if eabs < 10 then "0" ++ int_to_base eabs 10 else int_to_base eabs 10) in
  mant ++ (if upper then "E" else "e") ++ (if e < 0 then "-" else "+") ++ estr

and rb_fmt_one = fn (flags: str) -> fn (width: int) -> fn (prec: int) -> fn (typ: str) -> fn (av: Val) ->
  if str_eq typ "d" || str_eq typ "i" || str_eq typ "u" then
    let n = fmt_to_int av in
    let neg = n < 0 in
    let ds = int_to_base (if neg then 0 - n else n) 10 in
    let sign = (if neg then "-" else if str_contains flags "+" then "+" else if str_contains flags " " then " " else "") in
    rb_pad_num sign ds flags width
  else if str_eq typ "s" then
    let s0 = to_s av in
    let s = (if prec >= 0 && str_len s0 > prec then substring s0 0 prec else s0) in
    rb_pad_str s flags width
  else if str_eq typ "f" then
    let neg = (to_f av < 0.0) in
    let sign = (if neg then "-" else if str_contains flags "+" then "+" else if str_contains flags " " then " " else "") in
    rb_pad_num sign (fmt_float_abs av (if prec < 0 then 6 else prec)) flags width
  else if str_eq typ "e" || str_eq typ "E" then
    let neg = (to_f av < 0.0) in
    let sign = (if neg then "-" else if str_contains flags "+" then "+" else if str_contains flags " " then " " else "") in
    rb_pad_num sign (fmt_sci_abs av (if prec < 0 then 6 else prec) (str_eq typ "E")) flags width
  else if str_eq typ "x" then rb_pad_num "" (int_to_base (fmt_to_int av) 16) flags width
  else if str_eq typ "X" then rb_pad_num "" (ascii_up (int_to_base (fmt_to_int av) 16)) flags width
  else if str_eq typ "o" then rb_pad_num "" (int_to_base (fmt_to_int av) 8) flags width
  else if str_eq typ "b" then rb_pad_num "" (int_to_base (fmt_to_int av) 2) flags width
  else if str_eq typ "c" then (match av with VInt n -> chr n | VStr h -> sget h | _ -> to_s av)
  else if str_eq typ "" then ""
  else "%" ++ typ

and range_step_arr = fn (i: int) -> fn (last: int) -> fn (n: int) ->
  if n <= 0 then Nil
  else if i > last then Nil else Cons (VInt i, range_step_arr (i + n) last n)

// [elem, index] pairs for a block-less each_with_index (returned as an array
// so .to_a / .map / .each all work on it).
and with_index_pairs = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> Cons (arr_new (Cons (h, Cons (VInt i, Nil))), with_index_pairs t (i + 1))

and downto_arr = fn (a: int) -> fn (b: int) ->
  if a < b then Nil else Cons (VInt a, downto_arr (a - 1) b)

and str_bytes_val = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then Nil else Cons (VInt (ord (char_at s i)), str_bytes_val s (i + 1))

// prepend `h` to each combination array in `combos`.
and combos_prepend = fn (h: Val) -> fn (combos: Val list) ->
  match combos with
  | Nil -> Nil
  | Cons (c, rest) -> (match c with VArr id -> Cons (arr_new (Cons (h, deref id)), combos_prepend h rest) | _ -> Cons (c, combos_prepend h rest))

// all k-combinations of xs, preserving order.
and arr_combinations = fn (xs: Val list) -> fn (k: int) ->
  if k == 0 then Cons (arr_new Nil, Nil)
  else if k < 0 then Nil
  else (match xs with
        | Nil -> Nil
        | Cons (h, t) -> list_append (combos_prepend h (arr_combinations t (k - 1))) (arr_combinations t k))

// all k-permutations of xs.
and arr_permutations = fn (xs: Val list) -> fn (k: int) ->
  if k == 0 then Cons (arr_new Nil, Nil)
  else if k < 0 then Nil
  else perm_each xs Nil k

and perm_each = fn (rest: Val list) -> fn (pre: Val list) -> fn (k: int) ->
  match rest with
  | Nil -> Nil
  | Cons (h, t) ->
    let others = list_append pre t in
    list_append (combos_prepend h (arr_permutations others (k - 1)))
                (perm_each t (list_append pre (Cons (h, Nil))) k)

// cartesian product of xs with ys (two-array form).
and pair_with = fn (h: Val) -> fn (ys: Val list) ->
  match ys with Nil -> Nil | Cons (y, t) -> Cons (arr_new (Cons (h, Cons (y, Nil))), pair_with h t)

and arr_product2 = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> list_append (pair_with h ys) (arr_product2 t ys)

and char_range = fn (i: int) -> fn (last: int) ->
  if i > last then Nil else Cons (mkstr (chr i), char_range (i + 1) last)

and val_list_len = fn (xs: Val list) ->
  match xs with Nil -> 0 | Cons (_, t) -> 1 + val_list_len t

// a bare name that is neither a local nor a top-level method is an
// an undefined name referenced bare could have been a variable (NameError);
// one called with arguments is unambiguously a method (NoMethodError).
and undef_call_exc = fn world -> fn (name: str) -> fn (args: Val list) ->
  undef_call_exc_x world name args false

// `explicit` = the call had parentheses (foo()) so it is unambiguously a
// method call -> NoMethodError even with no arguments.
and undef_call_exc_x = fn world -> fn (name: str) -> fn (args: Val list) -> fn (explicit: bool) ->
  match args with
  | Nil -> if explicit then raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "'")
           else raise_exc world "NameError" ("undefined local variable or method '" ++ name ++ "'")
  | _ -> raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "'")

// implicit-self send when self is a primitive: honour a subclass tag (its own
// method, then an alias-to-builtin) before the base primitive class + prims.
and prim_self_send = fn env -> fn world -> fn (other: Val) -> fn (name: str) -> fn (args: Val list) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  let hk = hng_key other in
  let tagged = if str_eq hk "" then false else map_has hng_store hk in
  let tagcls = if tagged then map_get hng_store hk else "" in
  if tagged && has_meth world tagcls name then invoke world noblk other tagcls name args
  else if tagged && (if str_eq (blt_alias_lookup world (ancestors_of world tagcls) name) "" then false else true) then
    (let src = blt_alias_lookup world (ancestors_of world tagcls) name in
     match args with
     | Cons (arg, _) -> if is_binary_op_name src then arith_bin src other arg else prim_method other src args
     | Nil -> prim_method other src args)
  else
    let cls = class_name other in
    if has_meth world cls name then invoke world noblk other cls name args
    else prim_method other name args

and try_self_call_x = fn env -> fn world -> fn (name: str) -> fn (args: Val list) -> fn (explicit: bool) ->
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  // bare method(:name) — Kernel#method on the implicit self.
  if str_eq name "method" && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
    invoke_val_c env world noblk (if map_has env "self" then map_get env "self" else VMain) "method" args false
  // Kernel#load.
  else if str_eq name "load" && (match args with Cons (VStr _, _) -> true | _ -> false) then
    (match args with Cons (VStr ph, _) -> rb_load env world (sget ph) | _ -> VNil)
  // Kernel#exit / Kernel#abort — terminate through the native exit.
  else if str_eq name "exit" then
    (match args with
     | Cons (VInt n, _) -> exit n
     | Cons (VBool b, _) -> exit (if b then 0 else 1)
     | _ -> exit 0)
  else if str_eq name "abort" then
    (let _ = (match args with Cons (VStr mh, _) -> print_err (sget mh) | _ -> ()) in
     exit 1)
  // expression-position require("x") / require_relative("x") (the statement
  // forms parse as SRequire; parenthesized calls arrive here).
  else if (str_eq name "require" || str_eq name "require_relative") && (match args with Cons (VStr _, _) -> true | _ -> false) then
    (match args with
     | Cons (VStr ph, _) ->
       (match exec_stmt env world noblk (SRequire (str_eq name "require_relative", EStrL (sget ph))) with
        | FNext v -> v
        | FRaise _ -> fail "mere-ruby: (ruby exception raised)"
        | _ -> VNil)
     | _ -> VNil)
  else
  if map_has env "self" then
    (match map_get env "self" with
     | VObj id ->
       let cls = map_get ocls (str_of_int id) in
       if has_meth world cls name then invoke world noblk (VObj id) cls name args
       // the string form of instance_eval/instance_exec on an object self
       // (e.g. inside an instance_exec block) routes to the prim dispatcher,
       // exactly like the VMain special case below.
       else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false)
       then invoke_val_c env world noblk (VObj id) name args false
       else if has_meth world cls "method_missing" then invoke world noblk (VObj id) cls "method_missing" (Cons (VSym name, args))
       else undef_call_exc_x world name args explicit
     // top-level self is main (an Object); route the string form of
     // instance_eval/instance_exec to the prim dispatcher (self stays main).
     | VMain ->
       if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false)
       then dispatch_prim env world noblk VMain name args false
       else undef_call_exc_x world name args explicit
     | VClass c ->
       if str_eq name "new" then new_obj world c args
       else if has_meth world ("(sng:" ++ c ++ ")") name then invoke world noblk (VClass c) ("(sng:" ++ c ++ ")") name args
       // a bare call inside a class/module body (self is the class) routes
       // through the receiver dispatcher so builtins like module_eval/class_eval
       // apply; invoke_val_c raises NoMethodError itself if truly undefined.
       else invoke_val_c env world noblk (VClass c) name args false
     | other -> prim_self_send env world other name args)
  else undef_call_exc_x world name args explicit

// implicit-self method call (a method calling a sibling method).
and try_self_call = fn env -> fn world -> fn (name: str) -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  if str_eq name "method" && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
    invoke_val_c env world noblk (if map_has env "self" then map_get env "self" else VMain) "method" args false
  else
  if map_has env "self" then
    (match map_get env "self" with
     | VObj id ->
       let cls = map_get ocls (str_of_int id) in
       if has_meth world cls name then invoke world noblk (VObj id) cls name args
       else undef_call_exc world name args
     | VMain ->
       if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false)
       then dispatch_prim env world noblk VMain name args false
       else undef_call_exc world name args
     | VClass c ->
       // class-level self (class << self body / class methods): route through
       // the receiver dispatcher so class/module builtins (name, constants,
       // module_eval, ...) resolve; invoke_val_c raises if truly undefined.
       if str_eq name "new" then new_obj world c args
       else if has_meth world ("(sng:" ++ c ++ ")") name then invoke world noblk (VClass c) ("(sng:" ++ c ++ ")") name args
       else invoke_val_c env world noblk (VClass c) name args false
     | other ->
       // primitive self (a reopened built-in class's method body): user
       // methods first, then the built-in prims (implicit-self upcase etc.).
       prim_self_send env world other name args)
  else undef_call_exc world name args

// top-level method call: fresh frame, no self; blk is installed for yield.
and call_method = fn env -> fn world -> fn blk -> fn (name: str) -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  (match map_get meths name with
   | Meth (params, defaults, body) ->
     let frame = map_new () in
     let _ = map_set frame "__fid" (VInt (next_fid ())) in
     // top-level methods run with main as self (their @ivars live there).
     let _ = map_set frame "self" (if map_has env "self" then map_get env "self" else VMain) in
     let _ = map_set frame "__cref" (mkstr (if map_has meth_cref name then map_get meth_cref name else "")) in
     let _ = bind_params frame world blk name params defaults args in
     (match method_body_flow frame world blk body with FNext v -> v | FReturn v -> v | FRaise v -> v | FBreak v -> v | FLoopNext v -> v))

// class-variable helpers: the owning class is self's class (or the class
// itself in a class body); reads walk the superclass chain.
and cvar_cls = fn env -> fn world ->
  // class variables belong to the innermost lexically-enclosing class/module
  // (the method's cref), NOT self's class — so a module method used via
  // `extend` still reads the module's cvar. "" means the top-level scope.
  let (meths, sup, ocls, ivars) = world in
  // purely lexical: no enclosing class/module cref => top-level scope ("").
  if map_has env "__cref" then (match map_get env "__cref" with VStr s -> let s = sget s in s | _ -> "")
  else ""

and cvar_get = fn env -> fn world -> fn (name: str) ->
  let cls = cvar_cls env world in
  // a class variable accessed at the top-level scope is a RuntimeError.
  if str_eq cls "" then raise_exc world "RuntimeError" "class variable access from toplevel"
  // reading an uninitialised class variable is a NameError in Ruby.
  else if cvar_defined_from world cls name then cvar_get_from world cls name
  else raise_exc world "NameError" ("uninitialized class variable @@" ++ name ++ " in " ++ cls)

// a class variable defined both in the nearest owning class and in a strict
// ancestor of it is "overtaken" — reading it is a RuntimeError in Ruby.
and cvar_overtaken = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has cvars (cls ++ "@" ++ name)
  then (if map_has sup cls then cvar_defined_from world (map_get sup cls) name else false)
  else if map_has sup cls then cvar_overtaken world (map_get sup cls) name
  else false

and cvar_defined_from = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has cvars (cls ++ "@" ++ name) then true
  else if map_has sup cls then cvar_defined_from world (map_get sup cls) name
  else false

and cvar_get_from = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has cvars (cls ++ "@" ++ name) then map_get cvars (cls ++ "@" ++ name)
  else if map_has sup cls then cvar_get_from world (map_get sup cls) name
  else VNil

and cvar_set = fn env -> fn world -> fn (name: str) -> fn (v: Val) ->
  let cls = cvar_cls env world in
  if str_eq cls "" then (let _ = raise_exc world "RuntimeError" "class variable access from toplevel" in ())
  else
  let owner0 = cvar_owner world cls name in
  let owner = if str_eq owner0 "" then cls else owner0 in
  map_set cvars (owner ++ "@" ++ name) v

and cvar_owner = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has cvars (cls ++ "@" ++ name) then cls
  else if map_has sup cls then
    let up = cvar_owner world (map_get sup cls) name in
    (if str_eq up "" then cls else up)
  else ""

// is `cls` the class `target` or a descendant of it? (plus universal roots)
and obj_is_a = fn world -> fn (cls: str) -> fn (target: str) ->
  let (meths, sup, ocls, ivars) = world in
  if str_eq cls target then true
  else if str_eq target "Object" || str_eq target "BasicObject" then true
  // a singleton class's superclass chain runs through sng_supername (its
  // entries are not in the plain `sup` map), ending at Class -> Module -> ...
  else if is_sng_cls cls then obj_is_a world (sng_supername world cls) target
  else if map_has sup cls then obj_is_a world (map_get sup cls) target
  else false

// walk the ancestor chain: does `cls` (or a superclass) define `name`?
and is_kernel_builtin = fn (name: str) ->
  str_eq name "puts" || str_eq name "p" || str_eq name "pp" || str_eq name "print" ||
  str_eq name "format" || str_eq name "sprintf" ||
  str_eq name "raise" || str_eq name "loop" || str_eq name "catch" || str_eq name "throw" ||
  str_eq name "proc" || str_eq name "lambda" || str_eq name "eval" || str_eq name "require" ||
  str_eq name "require_relative" || str_eq name "block_given?"

// is `name` callable here — a top-level method, or a method on self's class?
and is_method_defined = fn env -> fn world -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has meths name then true
  else if map_has env "self" then
    (match map_get env "self" with
     | VObj id -> has_meth world (map_get ocls (str_of_int id)) name
     | _ -> false)
  else false

and has_meth = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if str_eq cls "" then false
  else if map_has undefs (cls ++ "#" ++ name) then false   // undef'd here: blocked
  else if map_has meths (cls ++ "#" ++ name) then true
  else if includes_has world cls name then true
  else if map_has sup cls then has_meth world (map_get sup cls) name
  else if is_sng_cls cls then has_meth world (sng_supername world cls) name
  // every class without a declared superclass inherits from Object,
  // so `class Object; def m; end` reaches all values.
  else if str_eq cls "Object" then false
  else has_meth world "Object" name

// does any module `include`d into `cls` define `name` as an instance method?
and includes_has = fn world -> fn (cls: str) -> fn (name: str) ->
  if map_has includes cls then any_mod_has world (str_split (map_get includes cls) "|") name else false

and any_mod_has = fn world -> fn (mods: str list) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  match mods with
  | Nil -> false
  | Cons (m, r) -> if map_has meths (m ++ "#" ++ name) then true else any_mod_has world r name

and mod_lookup = fn world -> fn (mods: str list) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  match mods with
  | Nil -> fail ("mere-ruby: undefined method '" ++ name ++ "'")
  | Cons (m, r) -> if map_has meths (m ++ "#" ++ name) then map_get meths (m ++ "#" ++ name) else mod_lookup world r name

and lookup_meth = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has meths (cls ++ "#" ++ name) then map_get meths (cls ++ "#" ++ name)
  else if includes_has world cls name then mod_lookup world (str_split (map_get includes cls) "|") name
  else if map_has sup cls then lookup_meth world (map_get sup cls) name
  else if is_sng_cls cls then lookup_meth world (sng_supername world cls) name
  else if str_eq cls "Object" then fail ("mere-ruby: undefined method '" ++ name ++ "'")
  else lookup_meth world "Object" name

// like lookup_meth but also returns the class the method was found in, so
// `super` can resume the lookup from that class's superclass.
and lookup_meth_cls = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  // resolve along the linearized ancestor chain so the returned defining class
  // is the actual module/class the method lives in (super resumes from there).
  let a = lookup_anc world (ancestors_of world cls) name in
  if str_eq a "" then fail ("mere-ruby: undefined method '" ++ name ++ "'")
  else (map_get meths (a ++ "#" ++ name), a)

// invoke an instance method: fresh frame binding self + params; blk is the
// block passed at the call site (installed for yield inside the body).
and invoke = fn world -> fn blk -> fn (recv: Val) -> fn (cls: str) -> fn (name: str) -> fn (args: Val list) ->
  let (m, defcls) = lookup_meth_cls world cls name in
  run_meth world blk recv defcls name m args

// run a resolved method with __defcls set to the ancestor it was found in (so
// a bare `super` resumes from the right point in the receiver's chain).
and run_meth = fn world -> fn blk -> fn (recv: Val) -> fn (defcls: str) -> fn (name: str) -> fn (m: Meth) -> fn (args: Val list) ->
  match m with
  | Meth (params, defaults, body) ->
    // a method defined via define_method yields to the block captured at
    // definition time when the call site itself passes no block.
    let blk = (match blk with
               | (true, _, _, _) -> blk
               | _ -> if map_has dm_captured (defcls ++ "#" ++ name)
                      then (match map_get dm_captured (defcls ++ "#" ++ name) with VProc pid -> map_get proc_store (str_of_int pid) | _ -> blk)
                      else blk) in
    let frame = map_new () in
    let _ = map_set frame "__fid" (VInt (next_fid ())) in
    let _ = map_set frame "self" recv in
    // hidden bindings so `super` can resume lookup above the defining class.
    // an aliased method resumes above its ORIGIN, not above the aliasing class.
    let dc = if map_has alias_origin (defcls ++ "#" ++ name)
             then (match map_get alias_origin (defcls ++ "#" ++ name) with s -> s)
             else defcls in
    let mnm = if map_has alias_srcname (defcls ++ "#" ++ name)
              then (match map_get alias_srcname (defcls ++ "#" ++ name) with s -> s)
              else name in
    let _ = map_set frame "__defcls" (VClass dc) in
    let _ = map_set frame "__meth" (mkstr mnm) in
    // lexical scope (cref) for bare-constant resolution in the body.
    let _ = map_set frame "__cref" (mkstr (if map_has meth_cref (defcls ++ "#" ++ name) then map_get meth_cref (defcls ++ "#" ++ name) else "")) in
    let _ = map_set frame "__args" (arr_new args) in
    let _ = map_set frame "__params" (arr_new (param_names_vals params)) in
    let _ = bind_params frame world blk name params defaults args in
    (match method_body_flow frame world blk body with FNext v -> v | FReturn v -> v | FRaise v -> v | FBreak v -> v | FLoopNext v -> v)

// the linearized ancestor chain of a class: the class, then its included
// modules (later includes first, MRO order), then the superclass's chain.
and rev_strs = fn (xs: str list) -> fn (acc: str list) ->
  match xs with Nil -> acc | Cons (h, t) -> rev_strs t (Cons (h, acc))
// a module and its own included modules, linearized (for nesting like
// `module M2; include M1; end`).
and mod_ancestors = fn world -> fn (m: str) ->
  let subs = if map_has includes m then rev_strs (str_split (map_get includes m) "|") Nil else Nil in
  Cons (m, expand_mods world subs)
and expand_mods = fn world -> fn (mods: str list) ->
  match mods with Nil -> Nil | Cons (h, t) -> list_append_str (mod_ancestors world h) (expand_mods world t)
and ancestors_of = fn world -> fn (cls: str) ->
  let (meths, sup, ocls, ivars) = world in
  let mods = if map_has includes cls then expand_mods world (rev_strs (str_split (map_get includes cls) "|") Nil) else Nil in
  let rest = if map_has sup cls then ancestors_of world (map_get sup cls)
             else if is_sng_cls cls then ancestors_of world (sng_supername world cls)
             else if str_eq cls "BasicObject" then Nil
             else if str_eq cls "Object" then Cons ("BasicObject", Nil)
             else ancestors_of world "Object" in
  Cons (cls, list_append_str mods rest)
// ancestor names as class values (Module#ancestors).
and anc_vclasses = fn (anc: str list) ->
  match anc with Nil -> Nil | Cons (a, rest) -> Cons (VClass a, anc_vclasses rest)
// the ancestor sublist strictly after the first occurrence of `x`.
and anc_after = fn (anc: str list) -> fn (x: str) ->
  match anc with Nil -> Nil | Cons (a, rest) -> if str_eq a x then rest else anc_after rest x
// the class where method dispatch for `recv` begins (its object class, or the
// value's class for a primitive) — the head of its ancestor chain.
// resolve a bare constant name `m` referenced inside class `cls`: try each
// enclosing namespace of cls (cls::m, then strip the last ::segment, ...),
// then the bare name; return the first that names a class/module, else `m`.
and resolve_scope_name = fn (cls: str) -> fn (m: str) ->
  if str_contains m "::" then m
  // a singleton class `(sng:X)` shares X's lexical scope (`class << self;
  // include ModA` inside a namespaced class), so resolve against X.
  else if is_sng_cls cls then resolve_scope_name (sng_inner cls) m
  else if (if str_eq cls "" then false else true) && (map_has consts (cls ++ "::" ++ m) || map_has modules (cls ++ "::" ++ m)) then cls ++ "::" ++ m
  else if str_contains cls "::" then resolve_scope_name (strip_last_ns cls) m
  else m
and strip_last_ns = fn (s: str) -> strip_last_ns_go s (str_len s - 1)
and strip_last_ns_go = fn (s: str) -> fn (i: int) ->
  if i <= 0 then ""
  else if str_eq (char_at s i) ":" && str_eq (char_at s (i - 1)) ":" then substring s 0 (i - 1)
  else strip_last_ns_go s (i - 1)
and dispatch_cls_of = fn world -> fn (recv: Val) ->
  let (meths, sup, ocls, ivars) = world in
  match recv with
  | VObj id -> map_get ocls (str_of_int id)
  | VClass c -> c
  // a primitive tagged as a subclass instance reports the subclass (so super
  // resumes above it, reaching the builtin base).
  | _ -> let hk = hng_key recv in
         if (if str_eq hk "" then false else true) && map_has hng_store hk && (if is_sng_cls (map_get hng_store hk) then false else true)
         then map_get hng_store hk else class_name recv
// `extend`: append each module's name to the receiver singleton's includes,
// so its instance methods become singleton methods (found via the sng chain).
and extend_all = fn (sc: str) -> fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (VClass m, rest) ->
    let _ = map_set includes sc (if map_has includes sc then (map_get includes sc) ++ "|" ++ m else m) in
    extend_all sc rest
  | Cons (_, rest) -> extend_all sc rest
// find a bare constant by walking the lexical nesting of `cref` upward
// (M::Base -> M), checking only `consts` (no singleton unwrap, no module
// aliasing), returning the qualified key or "" if not found at any level.
and lex_const_key = fn (cref: str) -> fn (name: str) ->
  if (if str_eq cref "" then false else true) && map_has consts (cref ++ "::" ++ name) then cref ++ "::" ++ name
  else if str_contains cref "::" then lex_const_key (strip_last_ns cref) name
  else ""
// the ancestor chain to walk for a super call: a class receiver means the
// current method is a class method (defined on the singleton class or an
// extended module), so resume in the singleton chain, not the instance chain.
and super_base = fn world -> fn (recv: Val) ->
  match recv with VClass c -> if is_sng_cls c then c else "(sng:" ++ c ++ ")" | _ -> dispatch_cls_of world recv
// super found no superclass method: Ruby routes this through method_missing
// (whose default raises NoMethodError), so call a user-defined method_missing
// if the receiver has one, otherwise raise NoMethodError.
and super_missing = fn world -> fn superblk -> fn (recv: Val) -> fn (meth: str) -> fn (args: Val list) ->
  // super from a method of a primitive subclass (Array/String/Hash) into the
  // builtin base: use the builtin implementation.
  let hk = hng_key recv in
  if (if str_eq hk "" then false else true) then prim_method recv meth args
  else
  let dcls = dispatch_cls_of world recv in
  if has_meth world dcls "method_missing"
  then invoke world superblk recv dcls "method_missing" (Cons (VSym meth, args))
  else raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'")
// the first ancestor in `anc` that defines `name`, or "" if none.
and lookup_anc = fn world -> fn (anc: str list) -> fn (name: str) ->
  let (meths, _, _, _) = world in
  match anc with
  | Nil -> ""
  | Cons (a, rest) -> if map_has meths (a ++ "#" ++ name) then a else lookup_anc world rest name

// ---- Struct.new(:a, :b) --------------------------------------------------
// synthesize an anonymous class with rw accessors, a positional initialize,
// and to_a / values / members / == built from the member list.
and struct_ivar_reads = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (EIVar m, struct_ivar_reads r)

and struct_sym_lits = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (ESym m, struct_sym_lits r)

and struct_init_body = fn (ms: str list) ->
  match ms with Nil -> Nil | Cons (m, r) -> Cons (SIVarAssign (m, EVar m), struct_init_body r)

and struct_members_of_args = fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (VSym s, r) -> Cons (s, struct_members_of_args r)
  | Cons (VStr _, r) -> struct_members_of_args r   // a leading "Name" string: ignored
  | Cons (_, r) -> struct_members_of_args r          // keyword_init: hash etc.: ignored

and struct_build = fn world -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let members = struct_members_of_args args in
  let n = (if map_has struct_ctr "n" then (match map_get struct_ctr "n" with VInt k -> k | _ -> 0) else 0) in
  let _ = map_set struct_ctr "n" (VInt (n + 1)) in
  let anon = "Struct_" ++ str_of_int n in
  let _ = map_set sup anon "Struct" in
  let _ = add_attrs world anon "rw" members in
  let _ = map_set meths (anon ++ "#initialize") (Meth (members, Nil, struct_init_body members)) in
  let toa = Cons (SReturn (EArr (struct_ivar_reads members)), Nil) in
  let _ = map_set meths (anon ++ "#to_a") (Meth (Nil, Nil, toa)) in
  let _ = map_set meths (anon ++ "#to_ary") (Meth (Nil, Nil, toa)) in
  let _ = map_set meths (anon ++ "#values") (Meth (Nil, Nil, toa)) in
  let _ = map_set meths (anon ++ "#deconstruct") (Meth (Nil, Nil, toa)) in
  let _ = map_set meths (anon ++ "#members") (Meth (Nil, Nil, Cons (SReturn (EArr (struct_sym_lits members)), Nil))) in
  let _ = map_set meths (anon ++ "#==")
            (Meth (Cons ("o", Nil), Nil,
                   Cons (SReturn (EBin ("==", EMethod (ESelf, "to_a", Nil), EMethod (EVar "o", "to_a", Nil))), Nil))) in
  VClass anon

// run a method body, converting a `return` flow signal into the method's
// return value (any other signal or a real exception keeps unwinding).
and method_body_flow = fn frame -> fn world -> fn blk -> fn (body: Stmt list) ->
  // mark this frame live so a break targeting it (via a block's home) can find
  // it; once the body has unwound to here (any outcome) the frame is done.
  let fidk = (if map_has frame "__fid" then (match map_get frame "__fid" with VInt t -> str_of_int t | _ -> "") else "") in
  let _ = if str_eq fidk "" then () else map_set live_frames fidk (VBool true) in
  // a method call is a `return` boundary: a return inside the body returns from
  // this method, even when the call happens inside a Thread.new block.
  let savedtf = (if map_has thread_flag "n" then map_get thread_flag "n" else VBool false) in
  let _ = map_set thread_flag "n" (VBool false) in
  let f = try_or (fn (u: unit) -> run_stmts frame world blk body) (FRaise VNil) in
  let _ = map_set thread_flag "n" savedtf in
  let _ = if str_eq fidk "" then () else map_delete live_frames fidk in
  match f with
  | FRaise _ ->
    if map_has flow_sig "k" then
      let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
      let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
      let _ = map_delete flow_sig "k" in
      if str_eq k "return" then FNext v
      else if str_eq k "breakret" || str_eq k "returnret" then
        // a break/return unwinding to its block's home frame: consume it here
        // iff this is that frame, otherwise keep propagating to the outer method.
        let target = (if map_has flow_sig "fid" then (match map_get flow_sig "fid" with VInt t -> t | _ -> 0) else 0) in
        let myfid = (if map_has frame "__fid" then (match map_get frame "__fid" with VInt t -> t | _ -> 0) else 0) in
        if target == myfid then (let _ = map_delete flow_sig "fid" in FNext v)
        else (let _ = map_set flow_sig "k" (mkstr k) in
              let _ = map_set flow_sig "fid" (VInt target) in
              let _ = map_set flow_sig "v" v in
              fail "mere-ruby: (flow signal)")
      else if str_eq k "retry" then FRaise (raise_exc world "SyntaxError" "Invalid retry")
      else flow_rethrow k v
    else fail "mere-ruby: (ruby exception raised)"
  | other -> other

// materialize an Enumerator into an array (unbounded enum_take).
and enum_to_arr = fn env -> fn world -> fn blk -> fn (eid: int) ->
  enum_take env world blk eid (0 - 1)

// like enum_to_arr but bounded: the collector breaks out after n elements
// (so infinite generators can serve first/take/next). n < 0 = unbounded.
and enum_take = fn env -> fn world -> fn blk -> fn (eid: int) -> fn (n: int) ->
  enum_take_m env world blk eid n false
// values mode (next_values/peek_values): every yield gathers as an array,
// even single- and zero-value yields.
and enum_take_m = fn env -> fn world -> fn blk -> fn (eid: int) -> fn (n: int) -> fn (vals: bool) ->
  let (m0, s0, ocls0, ivars0) = world in
  let accv = arr_new Nil in
  if n == 0 then accv else
  let cenv2 = map_new () in
  let _ = map_set cenv2 "__acc" accv in
  let pushst = (if vals then SExpr (EMethod (EVar "__acc", "push", Cons (EVar "__e", Nil)))
                else SExpr (EMethod (EVar "__acc", "push",
                Cons (ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                             EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                             EVar "__e"), Nil)))) in
  let body = (if n < 0 then Cons (pushst, Nil)
              else Cons (pushst,
                   Cons (SIf (Cons ((EBin (">=", EMethod (EVar "__acc", "length", Nil), EInt n),
                                     Cons (SBreak ENil, Nil)), Nil), Nil), Nil))) in
  let collector = (true, Cons ("*__e", Nil), body, cenv2) in
  let _ = (if map_has ivars0 (str_of_int eid ++ "@__e_step") then
             // produce form: yield seed, then step(prev) forever (bounded by
             // the collector's break -> StopIteration).
             (match map_get ivars0 (str_of_int eid ++ "@__e_step") with
              | VProc spid ->
                (let seed = (if map_has ivars0 (str_of_int eid ++ "@__e_seed") then map_get ivars0 (str_of_int eid ++ "@__e_seed") else VNil) in
                 let f = try_or (fn (u: unit) -> let _ = enum_produce_go env world blk collector (map_get proc_store (str_of_int spid)) seed in FNext VNil) (FRaise VNil) in
                 (match f with
                  | FRaise _ ->
                    (let ecls = (if map_has ivars0 "$exc" then (match map_get ivars0 "$exc" with VExc (c2, _) -> c2 | _ -> "") else "") in
                     if str_eq ecls "StopIteration" then (let _ = map_delete ivars0 "$exc" in ())
                     else if map_has flow_sig "k" then
                       (let k = (match map_get flow_sig "k" with VStr kk -> sget kk | _ -> "") in
                        let v2 = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
                        let _ = map_delete flow_sig "k" in
                        if str_eq k "break" then () else (let _ = flow_rethrow k v2 in ()))
                     else fail "mere-ruby: (ruby exception raised)")
                  | _ -> ()))
              | _ -> ())
           else if map_has ivars0 (str_of_int eid ++ "@__e_blk") then
             (match map_get ivars0 (str_of_int eid ++ "@__e_blk") with
              | VProc gpid ->
                let bpid = map_len proc_store in
                let _ = map_set proc_store (str_of_int bpid) collector in
                let yid = map_len ocls0 in
                let _ = map_set ocls0 (str_of_int yid) "Enumerator::Yielder" in
                let _ = map_set ivars0 (str_of_int yid ++ "@__y_blk") (VProc bpid) in
                // a break escaping the generator (no loop of its own) ends here.
                let f = try_or (fn (u: unit) -> let _ = run_block world blk (map_get proc_store (str_of_int gpid)) (Cons (VObj yid, Nil)) in FNext VNil) (FRaise VNil) in
                (match f with
                 | FRaise _ ->
                   (if map_has flow_sig "k" then
                      (let k = (match map_get flow_sig "k" with VStr kk -> sget kk | _ -> "") in
                       let v2 = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
                       let _ = map_delete flow_sig "k" in
                       if str_eq k "break" then () else (let _ = flow_rethrow k v2 in ()))
                    else
                      // the bounded collector ends the generator by raising
                      // StopIteration (consumed here); anything else re-raises.
                      let ecls = (if map_has ivars0 "$exc" then (match map_get ivars0 "$exc" with VExc (c2, _) -> c2 | _ -> "") else "") in
                      if str_eq ecls "StopIteration" then (let _ = map_delete ivars0 "$exc" in ())
                      else fail "mere-ruby: (ruby exception raised)")
                 | _ -> ())
              | _ -> ())
           else
             (let recv2 = (if map_has ivars0 (str_of_int eid ++ "@recv") then map_get ivars0 (str_of_int eid ++ "@recv") else VNil) in
              let meth2 = (match (if map_has ivars0 (str_of_int eid ++ "@meth") then map_get ivars0 (str_of_int eid ++ "@meth") else mkstr "each") with VStr h -> sget h | _ -> "each") in
              let eargs = (match (if map_has ivars0 (str_of_int eid ++ "@eargs") then map_get ivars0 (str_of_int eid ++ "@eargs") else VNil) with VArr aid2 -> deref aid2 | _ -> Nil) in
              let _ = invoke_with_block env world blk recv2 meth2 eargs collector in
              ())) in
  accv

// search the $LOAD_PATH directories for a feature file ("" = not found).
and load_path_find = fn world -> fn (p1: str) ->
  (match (if map_has globals "LOAD_PATH" then map_get globals "LOAD_PATH" else VNil) with
   | VArr aid -> load_path_go (deref aid) p1
   | _ -> "")
and load_path_go = fn (dirs: Val list) -> fn (p1: str) ->
  match dirs with
  | Nil -> ""
  | Cons (VStr dh, rest) ->
    (let cand = sget dh ++ "/" ++ p1 in
     if is_reg_file cand then cand else load_path_go rest p1)
  | Cons (_, rest) -> load_path_go rest p1

// Kernel#load: run the file (no .rb auto-append, no dedup); resolves against
// the $LOAD_PATH, then the current dir. Returns true.
and rb_load = fn env -> fn world -> fn (p0: str) ->
  let dir = (if map_has load_ctx "dir" then (match map_get load_ctx "dir" with VStr d -> sget d | _ -> ".") else ".") in
  let full = if str_len p0 > 0 && str_eq (char_at p0 0) "/" then p0
             else (let hit = load_path_find world p0 in
                   if str_eq hit "" then dir ++ "/" ++ p0 else hit) in
  if is_reg_file full then
    (let src = read_file full in
     let savedc = (if map_has load_ctx "coding" then map_get load_ctx "coding" else mkstr "UTF-8") in
     let cod = src_coding src in
     let _ = map_set load_ctx "coding" (mkstr (if str_eq cod "" then "UTF-8" else cod)) in
     let toks = lex_go src 0 in
     let (prog2, rest2) = parse_stmts toks Nil in
     let _ = rx_check_pending () in
     let _ = (match rest2 with
              | Cons (TEOF, _) -> ()
              | _ -> fail ("mere-ruby: unexpected token at top level in " ++ full)) in
     let fenv = map_new () in
     let _ = map_set fenv "self" VMain in
     let saved = (if map_has load_ctx "dir" then map_get load_ctx "dir" else mkstr ".") in
     let _ = map_set load_ctx "dir" (mkstr (dirname_of full)) in
     let noblk2 = (false, (Nil : str list), (Nil : Stmt list), fenv) in
     let f = run_stmts fenv world noblk2 prog2 in
     let _ = map_set load_ctx "dir" saved in
     let _ = map_set load_ctx "coding" savedc in
     (match f with
      | FRaise _ -> fail "mere-ruby: (ruby exception raised)"
      | _ -> VBool true))
  else raise_exc world "LoadError" ("cannot load such file -- " ++ p0)

// File.basename: the path's final component.
and basename_of = fn (path: str) ->
  basename_go path (str_len path - 1)
and basename_go = fn (path: str) -> fn (i: int) ->
  if i < 0 then path
  else if str_eq (char_at path i) "/" then substring path (i + 1) (str_len path)
  else basename_go path (i - 1)
and file_join_go = fn (args: Val list) -> fn (acc: str) ->
  match args with
  | Nil -> acc
  | Cons (v, rest) ->
    let piece = (match v with VStr h -> sget h | _ -> to_s v) in
    file_join_go rest (if str_eq acc "" then piece else acc ++ "/" ++ piece)
// is this environment variable set? getenv is libc getenv and returns
// NULL — a crash — for unset names, so probe with printenv first (which
// also distinguishes set-but-empty, exit 0, from unset, exit 1).
and env_is_set = fn (k2: str) ->
  run ("printenv " ++ shq k2 ++ " > /dev/null 2>&1") == 0
and env_get = fn (k2: str) ->
  if env_is_set k2 then getenv k2 else ""
// one ENV read: the write overlay wins (VNil = deleted), then the real
// environment.
and env_lookup_v = fn (k2: str) ->
  let v = (if map_has env_ovr k2 then map_get env_ovr k2
           else if env_is_set k2 then mkstr (getenv k2)
           else VNil) in
  // reads carry Encoding.default_internal when set, else the locale (UTF-8).
  (match v with
   | VStr h ->
     let _ = senc_set h
       (if map_has def_int_enc "v" then
          (match map_get def_int_enc "v" with
           | VObj eid -> (if map_has enc_name (str_of_int eid) then map_get enc_name (str_of_int eid) else "UTF-8")
           | _ -> "UTF-8")
        else "UTF-8") in
     v
   | _ -> v)
// coerce an ENV key (or value) to str: String, or anything with #to_str;
// otherwise TypeError.
and env_key_of = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VStr h -> sget h
  | VObj id ->
    (let (m0, s0, ocls0, _) = world in
     let cls0 = map_get ocls0 (str_of_int id) in
     let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
     if has_meth world cls0 "to_str" then
       (match invoke world noblk v cls0 "to_str" Nil with
        | VStr h -> sget h
        | _ -> let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ cls0 ++ " into String") in "")
     // a method_missing responder (e.g. a spec mock) still coerces.
     else if has_meth world cls0 "method_missing" then
       (match invoke_val_c env world noblk v "to_str" Nil false with
        | VStr h -> sget h
        | _ -> let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ cls0 ++ " into String") in "")
     else let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ cls0 ++ " into String") in "")
  | _ -> let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ class_name v ++ " into String") in ""
// the full environment as (key, value) pairs — there is no environ extern,
// so dump env(1) to a temp file and parse it (multiline values are a cap).
and env_all_pairs = fn () ->
  let tmpf = "/tmp/.mrb_env_" ++ str_of_int (random_int 100000000) in
  let _ = run ("env > " ++ shq tmpf ++ " 2> /dev/null") in
  let content = (if file_exists tmpf then read_file tmpf else "") in
  let _ = run ("rm -f " ++ shq tmpf) in
  env_pairs_go content 0
and env_pairs_go = fn (content: str) -> fn (i: int) ->
  if i >= str_len content then (Nil : (str * str) list)
  else
    let e = line_end_from content i in
    let stop = (if e > i && str_eq (char_at content (e - 1)) "\n" then e - 1 else e) in
    let eq = env_eq_at content i stop in
    if eq < 0 then env_pairs_go content e
    else Cons ((substring content i eq, substring content (eq + 1) stop), env_pairs_go content e)
and env_eq_at = fn (content: str) -> fn (j: int) -> fn (stop: int) ->
  if j >= stop then (0 - 1)
  else if str_eq (char_at content j) "=" then j
  else env_eq_at content (j + 1) stop
// reverse lookup for ENV.key: first key whose value matches (skipping keys
// the overlay shadows).
and env_key_scan = fn (pairs: (str * str) list) -> fn (target: str) ->
  match pairs with
  | Nil -> VNil
  | Cons ((k2, v2), rest) ->
    if (if map_has env_ovr k2 then false else true) && str_eq v2 target then mkstr k2
    else env_key_scan rest target
// a regular file? file_exists is true for directories too, and require/
// load must skip those (Ruby skips a matching directory on the load path).
and is_reg_file = fn (p1: str) ->
  file_exists p1 && run ("test -f " ++ shq p1 ++ " 2> /dev/null") == 0
// single-quote a string for the shell (used by the run-backed helpers).
and shq = fn (s2: str) ->
  "'" ++ shq_go s2 0 "" ++ "'"
and shq_go = fn (s2: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s2 then acc
  else
    let c = char_at s2 i in
    shq_go s2 (i + 1) (acc ++ (if str_eq c "'" then "'\\''" else c))

// a File object: @__f_path/@__f_mode/@__f_buf/@__f_pos. Writes buffer and
// flush on #close (or at the end of a File.open block); reads go straight
// through the read_file extern. Mode "" marks the handle closed.
and file_open_obj = fn world -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let path = (match args with Cons (VStr h, _) -> sget h | _ -> "") in
  let mode = (match args with Cons (_, Cons (VStr h, _)) -> sget h | _ -> "r") in
  if (str_contains mode "r" && (if str_contains mode "+" then false else true))
     && (if file_exists path then false else true) then
    raise_exc world "Errno::ENOENT" ("No such file or directory @ rb_sysopen - " ++ path)
  else
    // w truncates at open, so an unwritten-then-closed file ends up empty.
    let _ = (if str_contains mode "w" then write_file path "" else ()) in
    let id = map_len ocls in
    let _ = map_set ocls (str_of_int id) "File" in
    let _ = map_set ivars (str_of_int id ++ "@__f_path") (mkstr path) in
    let _ = map_set ivars (str_of_int id ++ "@__f_mode") (mkstr mode) in
    let _ = map_set ivars (str_of_int id ++ "@__f_buf") (mkstr "") in
    let _ = map_set ivars (str_of_int id ++ "@__f_pos") (VInt 0) in
    VObj id
and file_close_obj = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  let k = str_of_int id in
  let path = (match (if map_has ivars (k ++ "@__f_path") then map_get ivars (k ++ "@__f_path") else VNil) with VStr h -> sget h | _ -> "") in
  let mode = (match (if map_has ivars (k ++ "@__f_mode") then map_get ivars (k ++ "@__f_mode") else VNil) with VStr h -> sget h | _ -> "") in
  let buf = (match (if map_has ivars (k ++ "@__f_buf") then map_get ivars (k ++ "@__f_buf") else VNil) with VStr h -> sget h | _ -> "") in
  let _ =
    (if str_contains mode "w" then write_file path buf
     else if str_contains mode "a" then
       write_file path ((if file_exists path then read_file path else "") ++ buf)
     else ()) in
  map_set ivars (k ++ "@__f_mode") (mkstr "")
// the index one past this line's newline (or end of string).
and line_end_from = fn (s: str) -> fn (i: int) ->
  if i >= str_len s then i
  else if str_eq (char_at s i) "\n" then i + 1
  else line_end_from s (i + 1)
// puts semantics onto stderr: arrays flatten, one trailing newline per item
// (print_err itself appends the newline).
and err_puts_each = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> ()
  | Cons (VArr aid, t) -> let _ = err_puts_each world (deref aid) in err_puts_each world t
  | Cons (VStr sh, t) ->
    let s2 = sget sh in
    let _ = print_err (if str_len s2 > 0 && str_eq (char_at s2 (str_len s2 - 1)) "\n"
                       then substring s2 0 (str_len s2 - 1) else s2) in
    err_puts_each world t
  | Cons (h, t) -> let _ = print_err (to_s h) in err_puts_each world t
and io_join_go = fn (args: Val list) -> fn (acc: str) ->
  match args with
  | Nil -> acc
  | Cons (VStr h, t) -> io_join_go t (acc ++ sget h)
  | Cons (h, t) -> io_join_go t (acc ++ to_s h)
// puts rendered into a string (for a File's write buffer): arrays flatten,
// each item gets exactly one trailing newline.
and file_puts_str = fn (args: Val list) -> fn (acc: str) ->
  match args with
  | Nil -> (if str_eq acc "" then "\n" else acc)
  | Cons (h, t) -> file_puts_str_go (Cons (h, t)) acc
and file_puts_str_go = fn (args: Val list) -> fn (acc: str) ->
  match args with
  | Nil -> acc
  | Cons (VArr aid, t) -> file_puts_str_go t (file_puts_str_go (deref aid) acc)
  | Cons (VStr sh, t) ->
    let s2 = sget sh in
    let s3 = (if str_len s2 > 0 && str_eq (char_at s2 (str_len s2 - 1)) "\n" then s2 else s2 ++ "\n") in
    file_puts_str_go t (acc ++ s3)
  | Cons (h, t) -> file_puts_str_go t (acc ++ to_s h ++ "\n")
// split content into an array of lines, each keeping its newline.
and file_lines_arr = fn (content: str) -> fn (i: int) ->
  arr_new (file_lines_go content i)
and file_lines_go = fn (content: str) -> fn (i: int) ->
  if i >= str_len content then (Nil : Val list)
  else
    let e = line_end_from content i in
    Cons (mkstr (substring content i e), file_lines_go content e)

// an Enumerator::Lazy: a source (anything with #each) + a pipeline of ops
// ([kind, payload] pairs: procs for map/select/..., ints for take/drop).
and mk_lazy = fn world -> fn (src: Val) -> fn (ops: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) "Enumerator::Lazy" in
  let _ = map_set ivars (str_of_int id ++ "@__lz_src") src in
  let _ = map_set ivars (str_of_int id ++ "@__lz_ops") (arr_new ops) in
  VObj id
and lz_src = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  (if map_has ivars (str_of_int id ++ "@__lz_src") then map_get ivars (str_of_int id ++ "@__lz_src") else VNil)
and lz_ops = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  (match (if map_has ivars (str_of_int id ++ "@__lz_ops") then map_get ivars (str_of_int id ++ "@__lz_ops") else VNil) with
   | VArr aid -> deref aid
   | _ -> Nil)
and lz_extend = fn world -> fn (id: int) -> fn (kind: str) -> fn (payload: Val) ->
  mk_lazy world (lz_src world id) (list_append (lz_ops world id) (Cons (arr_new (Cons (VStr (mkstr_h kind), Cons (payload, Nil))), Nil)))
// intern a plain string as a VStr handle payload.
and mkstr_h = fn (s2: str) -> (match mkstr s2 with VStr h -> h | _ -> 0)

// run the pipeline: drive src.each; each element passes through the ops on a
// driver object (Enumerator::LzDrv), accumulating survivors (bound < 0 =
// all; the driver raises StopIteration to stop the source).
and lz_run = fn env -> fn world -> fn blk -> fn (id: int) -> fn (bound: int) -> fn (fin: Val) ->
  let (m0, s0, ocls0, ivars0) = world in
  let accv = arr_new Nil in
  let did = map_len ocls0 in
  let _ = map_set ocls0 (str_of_int did) "Enumerator::LzDrv" in
  let _ = map_set ivars0 (str_of_int did ++ "@__acc") accv in
  let _ = map_set ivars0 (str_of_int did ++ "@__ops") (arr_new (lz_ops world id)) in
  let _ = map_set ivars0 (str_of_int did ++ "@__bound") (VInt bound) in
  let _ = (match fin with VNil -> () | _ -> map_set ivars0 (str_of_int did ++ "@__fin") fin) in
  let cenv2 = map_new () in
  let _ = map_set cenv2 "__lzobj" (VObj did) in
  let collector = (true, Cons ("*__e", Nil),
                   Cons (SExpr (EMethod (EVar "__lzobj", "__lzstep", Cons (ESplat (EVar "__e"), Nil))), Nil),
                   cenv2) in
  let f = try_or (fn (u: unit) -> let _ = invoke_with_block env world blk (lz_src world id) "each" Nil collector in FNext VNil) (FRaise VNil) in
  let _ = (match f with
           | FRaise _ ->
             (if map_has flow_sig "k" then
                (let k = (match map_get flow_sig "k" with VStr kk -> sget kk | _ -> "") in
                 let v2 = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
                 let _ = map_delete flow_sig "k" in
                 if str_eq k "break" then () else (let _ = flow_rethrow k v2 in ()))
              else
                let ecls = (if map_has ivars0 "$exc" then (match map_get ivars0 "$exc" with VExc (c2, _) -> c2 | _ -> "") else "") in
                if str_eq ecls "StopIteration" then (let _ = map_delete ivars0 "$exc" in ())
                else fail "mere-ruby: (ruby exception raised)")
           | _ -> ()) in
  accv

// one element through the pipeline (called from the collector via __lzstep).
and lz_step = fn env -> fn world -> fn blk -> fn (did: int) -> fn (v0: Val) ->
  let (m0, s0, ocls0, ivars0) = world in
  let ops = (match (if map_has ivars0 (str_of_int did ++ "@__ops") then map_get ivars0 (str_of_int did ++ "@__ops") else VNil) with VArr aid -> deref aid | _ -> Nil) in
  lz_step_ops env world blk did ops 0 v0
and lz_step_ops = fn env -> fn world -> fn blk -> fn (did: int) -> fn (ops: Val list) -> fn (i: int) -> fn (v: Val) ->
  let (m0, s0, ocls0, ivars0) = world in
  match ops with
  | Nil ->
    // survivor: hand to the final consumer or accumulate (bound-checked).
    (match (if map_has ivars0 (str_of_int did ++ "@__fin") then map_get ivars0 (str_of_int did ++ "@__fin") else VNil) with
     | VProc fpid ->
       let _ = flow_value (run_block world blk (map_get proc_store (str_of_int fpid)) (Cons (v, Nil))) in
       VNil
     | _ ->
       (match (if map_has ivars0 (str_of_int did ++ "@__acc") then map_get ivars0 (str_of_int did ++ "@__acc") else VNil) with
        | VArr aid ->
          let _ = arr_set aid (list_append (deref aid) (Cons (v, Nil))) in
          let bound = (match (if map_has ivars0 (str_of_int did ++ "@__bound") then map_get ivars0 (str_of_int did ++ "@__bound") else VNil) with VInt bn -> bn | _ -> 0 - 1) in
          if bound >= 0 && val_list_len (deref aid) >= bound then raise_exc world "StopIteration" "iteration reached an end"
          else VNil
        | _ -> VNil))
  | Cons (opv, rest) ->
    let (kind, payload) = (match opv with
                           | VArr oaid -> (match deref oaid with
                                           | Cons (VStr kh, Cons (pl, _)) -> (sget kh, pl)
                                           | _ -> ("", VNil))
                           | _ -> ("", VNil)) in
    let callp = fn (pv: Val) ->
      (match payload with
       | VProc ppid -> flow_value (run_block world blk (map_get proc_store (str_of_int ppid)) (Cons (pv, Nil)))
       | _ -> VNil) in
    if str_eq kind "map" then lz_step_ops env world blk did rest (i + 1) (callp v)
    else if str_eq kind "select" then
      (if truthy (callp v) then lz_step_ops env world blk did rest (i + 1) v else VNil)
    else if str_eq kind "reject" then
      (if truthy (callp v) then VNil else lz_step_ops env world blk did rest (i + 1) v)
    else if str_eq kind "filter_map" then
      (let r = callp v in if truthy r then lz_step_ops env world blk did rest (i + 1) r else VNil)
    else if str_eq kind "take_while" then
      (if truthy (callp v) then lz_step_ops env world blk did rest (i + 1) v
       else raise_exc world "StopIteration" "iteration reached an end")
    else if str_eq kind "drop_while" then
      (let fk = str_of_int did ++ "@__dw" ++ str_of_int i in
       if map_has ivars0 fk then lz_step_ops env world blk did rest (i + 1) v
       else if truthy (callp v) then VNil
       else (let _ = map_set ivars0 fk (VBool true) in lz_step_ops env world blk did rest (i + 1) v))
    else if str_eq kind "take" then
      (let n = (match payload with VInt tn -> tn | _ -> 0) in
       let ck = str_of_int did ++ "@__tk" ++ str_of_int i in
       let c = (match (if map_has ivars0 ck then map_get ivars0 ck else VNil) with VInt cn -> cn | _ -> 0) in
       if c >= n then raise_exc world "StopIteration" "iteration reached an end"
       else (let _ = map_set ivars0 ck (VInt (c + 1)) in lz_step_ops env world blk did rest (i + 1) v))
    else if str_eq kind "drop" then
      (let n = (match payload with VInt dn -> dn | _ -> 0) in
       let ck = str_of_int did ++ "@__dp" ++ str_of_int i in
       let c = (match (if map_has ivars0 ck then map_get ivars0 ck else VNil) with VInt cn -> cn | _ -> 0) in
       if c < n then (let _ = map_set ivars0 ck (VInt (c + 1)) in VNil)
       else lz_step_ops env world blk did rest (i + 1) v)
    else lz_step_ops env world blk did rest (i + 1) v

// an Enumerator::Chain over a list of sources (each must respond to #each).
and mk_chain = fn world -> fn (srcs: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) "Enumerator::Chain" in
  let _ = map_set ivars (str_of_int id ++ "@__ch") (arr_new srcs) in
  VObj id
and chain_srcs = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  (match (if map_has ivars (str_of_int id ++ "@__ch") then map_get ivars (str_of_int id ++ "@__ch") else VNil) with
   | VArr aid -> deref aid
   | _ -> Nil)
// materialize a chain: drive each source's #each into one collector.
and chain_to_arr = fn env -> fn world -> fn blk -> fn (id: int) ->
  let accv = arr_new Nil in
  let cenv2 = map_new () in
  let _ = map_set cenv2 "__acc" accv in
  let collector = (true, Cons ("*__e", Nil),
                   Cons (SExpr (EMethod (EVar "__acc", "push",
                     Cons (ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                                  EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                                  EVar "__e"), Nil))), Nil),
                   cenv2) in
  let _ = chain_drive env world blk (chain_srcs world id) collector in
  accv
and chain_drive = fn env -> fn world -> fn blk -> fn (srcs: Val list) -> fn theblk ->
  match srcs with
  | Nil -> ()
  | Cons (src, rest) ->
    let _ = invoke_with_block env world blk src "each" Nil theblk in
    chain_drive env world blk rest theblk

// Enumerator.produce driver: yield v to the collector block, then step.
and enum_produce_go = fn env -> fn world -> fn blk -> fn collector -> fn stepblk -> fn (v: Val) ->
  let _ = tick () in
  (match run_block world blk collector (Cons (v, Nil)) with
   | FBreak _ -> ()
   | _ ->
     let nv = flow_value (run_block world blk stepblk (Cons (v, Nil))) in
     enum_produce_go env world blk collector stepblk nv)

// an Enumerator is a plain object of the synthetic class "Enumerator" whose
// @recv / @meth ivars remember the receiver and method to drive on #each.
// grep/grep_v: elements the pattern === (or not); one? helpers.
and arr_grep = fn world -> fn (xs: Val list) -> fn (pat: Val) -> fn (inv: bool) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    let hit = case_eqq world pat h in
    if (if inv then (if hit then false else true) else hit)
    then Cons (h, arr_grep world t pat inv)
    else arr_grep world t pat inv
and arr_count_eqq = fn world -> fn (xs: Val list) -> fn (pat: Val) -> fn (acc: int) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> arr_count_eqq world t pat (if case_eqq world pat h then acc + 1 else acc)
and arr_count_truthy = fn (xs: Val list) -> fn (acc: int) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> arr_count_truthy t (if truthy h then acc + 1 else acc)

and with_index_pairs_off = fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> Cons (arr_new (Cons (h, Cons (VInt i, Nil))), with_index_pairs_off t (i + 1))

and enum_args_str = fn (xs: Val list) ->
  match xs with
  | Nil -> ""
  | Cons (v, Nil) -> inspect v
  | Cons (v, rest) -> inspect v ++ ", " ++ enum_args_str rest

and make_enum = fn world -> fn (recv: Val) -> fn (meth: str) ->
  make_enum_a world recv meth Nil
and make_enum_a = fn world -> fn (recv: Val) -> fn (meth: str) -> fn (eargs: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) "Enumerator" in
  let _ = map_set ivars (str_of_int id ++ "@recv") recv in
  let _ = map_set ivars (str_of_int id ++ "@meth") (mkstr meth) in
  let _ = (match eargs with Nil -> () | _ -> map_set ivars (str_of_int id ++ "@eargs") (arr_new eargs)) in
  VObj id

// allocate an object, then run initialize if the class defines one.
// encode Time.new(y[,m,d,h,mi,s]) args into a monotonic ordinal for comparison.
and time_ord = fn (args: Val list) ->
  let y = (match args with Cons (VInt a, _) -> a | _ -> 1970) in
  let m = (match args with Cons (_, Cons (VInt a, _)) -> a | _ -> 1) in
  let d = (match args with Cons (_, Cons (_, Cons (VInt a, _))) -> a | _ -> 1) in
  let h = (match args with Cons (_, Cons (_, Cons (_, Cons (VInt a, _)))) -> a | _ -> 0) in
  let mi = (match args with Cons (_, Cons (_, Cons (_, Cons (_, Cons (VInt a, _))))) -> a | _ -> 0) in
  let s = (match args with Cons (_, Cons (_, Cons (_, Cons (_, Cons (_, Cons (VInt a, _)))))) -> a | _ -> 0) in
  ((((y * 13 + m) * 32 + d) * 24 + h) * 60 + mi) * 60 + s

// the ordinal of a Time object (its @__t ivar), or a sentinel if absent.
and time_ord_of = fn world -> fn (v: Val) ->
  match v with
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let k = str_of_int id ++ "@__t" in
    if map_has ivars k then (match map_get ivars k with VInt n -> n | _ -> 0 - 1) else (0 - 1)
  | _ -> (0 - 1)

and new_obj = fn world -> fn (cls: str) -> fn (args: Val list) ->
  // built-in mutable containers construct their store-backed value, not a
  // generic object (so Array.new / Hash.new via any dispatch path work).
  if str_eq cls "Hash" then
    (let hv = mkhash Nil in (match args with Cons (d, _) -> (match hv with VHsh id -> let _ = hdflt_set id d in hv | _ -> hv) | _ -> hv))
  else if str_eq cls "Array" then
    (match args with Cons (VInt n, Cons (d, _)) -> arr_new (val_repeat n d) | Cons (VInt n, _) -> arr_new (val_repeat n VNil) | _ -> arr_new Nil)
  else if str_eq cls "String" then
    (match args with Cons (VStr h, _) -> mkstr (sget h) | _ -> mkstr "")
  // Time.new(y[,m,d,h,mi,s]) — a minimal, comparable Time object: a Time-class
  // VObj carrying a monotonic ordinal ivar (enough for <=> and range membership).
  else if str_eq cls "Time" then
    (let (meths, sup, ocls, ivars) = world in
     let id = map_len ocls in
     let _ = map_set ocls (str_of_int id) "Time" in
     let _ = map_set ivars (str_of_int id ++ "@__t") (VInt (time_ord args)) in
     VObj id)
  else
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), ivars) in   // placeholder cenv (unused; must be Map[str,Val])
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) cls in
  let obj = VObj id in
  if has_meth world cls "initialize" then
    let _ = invoke world noblk obj cls "initialize" args in obj
  else obj

// like new_obj but forwards a block to initialize, so `C.new { } ` /
// `C.new(&pr)` reaches an `initialize(&b)`. Containers keep their own paths.
and new_obj_wb = fn world -> fn (cls: str) -> fn (args: Val list) -> fn theblk ->
  if str_eq cls "Hash" || str_eq cls "Array" || str_eq cls "String" then new_obj world cls args
  else
  let (meths, sup, ocls, ivars) = world in
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) cls in
  let obj = VObj id in
  if has_meth world cls "initialize" then
    let _ = invoke world theblk obj cls "initialize" args in obj
  else obj

// a `&blk` param is stored as "&name"; it captures the block, not a
// positional arg. Blocks can't be first-class Vals (their env is a Map, the
// Q-001 region wall), so we bind the name to a sentinel VSym "&blk" when a
// block was passed (nil otherwise) and special-case `.call` at the call site
// to run the ambient block.
and is_block_param = fn (p: str) -> str_len p > 0 && str_eq (char_at p 0) "&"

and block_param_name = fn (params: str list) ->
  match params with
  | Nil -> ""
  | Cons (p, r) -> if is_block_param p then substring p 1 (str_len p) else block_param_name r

and strip_block_params = fn (params: str list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if is_block_param p || str_eq p empty_bp_marker then strip_block_params r else Cons (p, strip_block_params r)

// explicit block-local names (encoded ";name"): bind each to a fresh nil.
and bind_block_locals = fn cenv -> fn (params: str list) ->
  match params with
  | Nil -> ()
  | Cons (p, r) ->
    let _ = if str_len p > 0 && str_eq (char_at p 0) ";" then map_set cenv (substring p 1 (str_len p)) VNil else () in
    bind_block_locals cenv r

and drop_block_locals = fn (params: str list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if str_len p > 0 && str_eq (char_at p 0) ";" then drop_block_locals r else Cons (p, drop_block_locals r)

// param names as VStr values (markers kept) — recorded for zsuper.
and param_names_vals = fn (params: str list) ->
  match params with Nil -> Nil | Cons (p, r) -> Cons (mkstr p, param_names_vals r)

// rebuild the argument list for a bare `super` from the current frame:
// positional params by value, a named splat splices its array, &block and
// keyword params are skipped.
and zsuper_args = fn env -> fn (ps: Val list) ->
  match ps with
  | Nil -> Nil
  | Cons (h, rest) ->
    (match h with
     | VStr p -> let p = sget p in
       if str_len p == 0 then zsuper_args env rest
       else if str_eq (char_at p 0) "&" then zsuper_args env rest
       else if str_eq (char_at p (str_len p - 1)) ":" then zsuper_args env rest
       else if str_eq (char_at p 0) "*" then
         let nm = substring p 1 (str_len p) in
         (if str_eq nm "" || not (map_has env nm) then zsuper_args env rest
          else (match map_get env nm with
                | VArr id -> list_append (deref id) (zsuper_args env rest)
                | v -> Cons (v, zsuper_args env rest)))
       else Cons ((if map_has env p then map_get env p else VNil), zsuper_args env rest)
     | _ -> zsuper_args env rest)

// zsuper also forwards the current method's keyword parameters (`name:`) and
// **kwrest as keyword arguments (a marked trailing hash), so a bare `super`
// reaches a parent that takes keywords.
and zsuper_kw_pairs = fn env -> fn (ps: Val list) ->
  match ps with
  | Nil -> Nil
  | Cons (VStr p, rest) ->
    let p = sget p in
    if str_len p > 1 && str_eq (substring p 0 2) "**" then
      let nm = substring p 2 (str_len p) in
      (if str_eq nm "" then zsuper_kw_pairs env rest
       else if map_has env nm then (match map_get env nm with VHsh id -> list_append (hderef id) (zsuper_kw_pairs env rest) | _ -> zsuper_kw_pairs env rest)
       else zsuper_kw_pairs env rest)
    else if str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":" then
      let nm = substring p 0 (str_len p - 1) in
      (if map_has env nm then Cons (VSym nm, Cons (map_get env nm, zsuper_kw_pairs env rest)) else zsuper_kw_pairs env rest)
    else zsuper_kw_pairs env rest
  | Cons (_, rest) -> zsuper_kw_pairs env rest

and zsuper_all = fn env -> fn (ps: Val list) ->
  let pos = zsuper_args env ps in
  match zsuper_kw_pairs env ps with
  | Nil -> pos
  | kw -> (match mkhash kw with VHsh id -> let _ = mark_kw id in list_append pos (Cons (VHsh id, Nil)) | h -> list_append pos (Cons (h, Nil)))

// keyword params are stored as "name:"; they bind from the trailing hash arg.
and is_kw_param = fn (p: str) ->
  (str_len p > 0 && str_eq (char_at p (str_len p - 1)) ":") ||
  (str_len p > 1 && str_eq (substring p 0 2) "**")

and kw_params = fn (params: str list) ->
  match params with Nil -> Nil | Cons (p, r) -> if is_kw_param p then Cons (p, kw_params r) else kw_params r

and pos_params = fn (params: str list) ->
  match params with Nil -> Nil | Cons (p, r) -> if is_kw_param p then pos_params r else Cons (p, pos_params r)

// demote kwarg-origin hashes to plain positional hashes (clear the mark): a
// method/block with no keyword parameters absorbs `key:` args into a normal
// positional hash, and re-splatting it must not re-trigger keyword handling.
and unmark_kwargs = fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (VHsh id, r) -> let _ = if map_has kwarg_marks (str_of_int id) then map_delete kwarg_marks (str_of_int id) else () in unmark_kwargs r
  | Cons (_, r) -> unmark_kwargs r

and peel_trailing_hash = fn (args: Val list) ->
  match rev_app args Nil with
  | Cons (VHsh xs, rrest) -> let xs = hderef xs in (rev_app rrest Nil, xs)
  | _ -> (args, (Nil : Val list))

// like peel_trailing_hash but only peels a kwarg-origin hash (`key:` / `**`);
// a positional `{...}` argument is left in the positional list.
and peel_kw_hash = fn (args: Val list) ->
  match rev_app args Nil with
  | Cons (VHsh xs, rrest) -> if is_kw_hash (VHsh xs) then (rev_app rrest Nil, hderef xs) else (args, (Nil : Val list))
  | _ -> (args, (Nil : Val list))

and str_list_has = fn (xs: str list) -> fn (s: str) ->
  match xs with Nil -> false | Cons (x, r) -> if str_eq x s then true else str_list_has r s

and kw_has_rest = fn (kws: str list) ->
  match kws with Nil -> false | Cons (p, r) -> if str_len p > 1 && str_eq (substring p 0 2) "**" then true else kw_has_rest r

// a required keyword parameter (name:, no default) missing from the call?
and kw_req_missing = fn (kws: str list) -> fn (defaults: (str * Expr) list) -> fn (kwhash: Val list) ->
  match kws with
  | Nil -> false
  | Cons (p, r) ->
    if str_len p > 1 && str_eq (substring p 0 2) "**" then kw_req_missing r defaults kwhash
    else let nm = substring p 0 (str_len p - 1) in
      if hash_haskey kwhash (VSym nm) then kw_req_missing r defaults kwhash
      else if has_default defaults p then kw_req_missing r defaults kwhash
      else true

// a kwarg hash with the given keyword names removed (what **kwrest keeps).
and kwhash_drop = fn (kwhash: Val list) -> fn (names: str list) ->
  match kwhash with
  | Cons (k, Cons (v, rest)) ->
    let kn = (match k with VSym s -> s | _ -> "\{nonsym}") in
    if str_list_has names kn then kwhash_drop rest names
    else Cons (k, Cons (v, kwhash_drop rest names))
  | _ -> Nil

and kw_names_of = fn (kws: str list) ->
  match kws with Nil -> Nil | Cons (p, r) ->
    if str_len p > 1 && str_eq (substring p 0 2) "**" then kw_names_of r
    else Cons (substring p 0 (str_len p - 1), kw_names_of r)

// a keyword passed that no name:/`**` parameter accepts?
and kw_has_unknown = fn (names: str list) -> fn (kwhash: Val list) ->
  match kwhash with
  | Nil -> false
  | Cons (k, Cons (v, rest)) ->
    let kn = (match k with VSym s -> s | _ -> "\{notsym}") in
    if str_list_has names kn then kw_has_unknown names rest else true
  | _ -> false

and bind_kw_params = fn frame -> fn world -> fn blk -> fn (kws: str list) -> fn (defaults: (str * Expr) list) -> fn (kwhash: Val list) ->
  match kws with
  | Nil -> ()
  | Cons (p, rest) ->
    if str_len p > 1 && str_eq (substring p 0 2) "**" then
      // **kwargs takes the whole keyword hash.
      let _ = map_set frame (substring p 2 (str_len p)) (mkhash kwhash) in
      bind_kw_params frame world blk rest defaults kwhash
    else
    let nm = substring p 0 (str_len p - 1) in
    let v = if hash_haskey kwhash (VSym nm) then hash_get kwhash (VSym nm)
            else if has_default defaults p then eval_e frame world blk (get_default defaults p) else VNil in
    let _ = map_set frame nm v in bind_kw_params frame world blk rest defaults kwhash

and bind_params = fn frame -> fn world -> fn blk -> fn (name: str) -> fn (params0: str list) -> fn (defaults: (str * Expr) list) -> fn (args0: Val list) ->
  // a block forwarded as `&proc` carries its home frame in pending_home;
  // record it on this frame so a `break` in that block unwinds to the home.
  let _ = if map_has pending_home "v" then
            (let _ = map_set frame "__blk_home" (map_get pending_home "v") in map_delete pending_home "v")
          else () in
  let bname = block_param_name params0 in
  let params1 = strip_block_params params0 in
  // &blk captures the block as a real proc (storable, re-passable). The proc's
  // home is this method's frame (the block was passed here as a literal), or
  // the inherited home if this method's block was itself a forwarded proc.
  let _ = if str_eq bname "" then ()
          else let (has, _, _, _) = blk in
               map_set frame bname
                 (if has then
                    (let pid = map_len proc_store in
                     let _ = map_set proc_store (str_of_int pid) blk in
                     let _ = map_set proc_home (str_of_int pid) (if map_has frame "__blk_home" then map_get frame "__blk_home" else (if map_has frame "__fid" then map_get frame "__fid" else VInt 0)) in
                     VProc pid)
                  else VNil) in
  // `**kw` (keyword-splat) and `key:` parameters share ONE trailing
  // kwarg-origin hash: peel it once, bind the explicit keywords, and give
  // **kwrest only the leftover keys. A positional `{...}` stays positional.
  let dsname = dsplat_name params1 in
  let params1 = drop_dsplat params1 in
  let kws = kw_params params1 in
  let params = pos_params params1 in
  let want_kw = (match kws with Nil -> (if str_eq dsname "" then false else true) | _ -> true) in
  // no keyword params: a `key:` hash is absorbed positionally, so clear its
  // kwarg mark (Ruby demotes it; a later *args re-splat stays positional).
  // `...` forwarding (*__fwd) and ruby2_keywords methods are exempt — both
  // forward a `key:` hash's keyword-ness faithfully.
  let _ = if want_kw || str_list_has params1 "*__fwd" || map_has r2k_methods (meth_base name) then () else unmark_kwargs args0 in
  let (args, kwhash) = if want_kw then peel_kw_hash args0 else (args0, (Nil : Val list)) in
  let _ = if str_eq dsname "" then ()
          else map_set frame dsname (mkhash (kwhash_drop kwhash (kw_names_of kws))) in
  // keyword arity: a required keyword missing, or (without **kwrest) an
  // unexpected keyword, raises ArgumentError.
  let _ = (match kws with
           | Nil -> ()
           | _ ->
             if kw_req_missing kws defaults kwhash then (let _ = raise_exc world "ArgumentError" "missing keyword" in ())
             // a **kwrest absorbs any extra keyword, so only check "unknown"
             // when the method has none.
             else if str_eq dsname "" && kw_has_unknown (kw_names_of kws) kwhash
                  then (let _ = raise_exc world "ArgumentError" "unknown keyword" in ())
             else ()) in
  let _ = bind_kw_params frame world blk kws defaults kwhash in
  // arity check: too few / too many positional arguments raise ArgumentError.
  let nargs = vlen args in
  let nreq = pos_required params defaults in
  let nmax = list_str_len params in
  let _ = (if nargs < nreq then let _ = arity_error world name nreq nmax nargs in ()
           else if (if has_splat params then false else true) && nargs > nmax then let _ = arity_error world name nreq nmax nargs in ()
           else ()) in
  if has_splat params then
    // *rest collects the middle. Ruby fills required params first (leading
    // requireds, then post-splat requireds), then optionals left-to-right,
    // then the splat takes what remains.
    let before = take_until_splat params in
    let after = after_splat params in
    let sname = splat_name params in
    let pre = req_pre before defaults in
    let opts = drop_req_pre before defaults in
    let npre = list_str_len pre in
    let nopt = list_str_len opts in
    let na = list_str_len after in
    let nv = vlen args in
    let middle = nv - npre - na in
    let middle = if middle < 0 then 0 else middle in
    let kopt = if middle > nopt then nopt else middle in
    let sc = middle - kopt in
    let _ = bind_seq frame world pre (vtake args npre) in
    let _ = bind_defaulted frame world blk opts defaults (vtake (vdrop args npre) kopt) in
    let _ = map_set frame sname (arr_new (vtake (vdrop args (npre + kopt)) sc)) in
    let _ = bind_seq frame world after (vdrop args (npre + kopt + sc)) in
    ()
  else
    // no splat: requireds may follow the optional run (a, o=1, p1, p2) —
    // requireds bind first, optionals share what's left.
    let pre = req_pre params defaults in
    let rest1 = drop_req_pre params defaults in
    let opts = opt_run rest1 defaults in
    let post = drop_opt_run rest1 defaults in
    let npre = list_str_len pre in
    let nopt = list_str_len opts in
    let npost = list_str_len post in
    let nv = vlen args in
    let kopt0 = nv - npre - npost in
    let kopt0 = if kopt0 < 0 then 0 else kopt0 in
    let kopt = if kopt0 > nopt then nopt else kopt0 in
    let _ = bind_seq frame world pre (vtake args npre) in
    let _ = bind_defaulted frame world blk opts defaults (vtake (vdrop args npre) kopt) in
    let _ = bind_seq frame world post (vdrop args (npre + kopt)) in
    ()

// split params around the optional (defaulted) run: leading requireds,
// then the optional run, then trailing requireds.
// number of required positional params (not defaulted, not the splat).
and pos_required = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> 0
  | Cons (p, r) ->
    if tgt_is_splat p then pos_required r defaults
    else if has_default defaults p then pos_required r defaults
    else 1 + pos_required r defaults

and arity_error = fn world -> fn (name: str) -> fn (lo: int) -> fn (hi: int) -> fn (got: int) ->
  let want = (if lo == hi then str_of_int lo else str_of_int lo ++ ".." ++ str_of_int hi) in
  raise_exc world "ArgumentError" ("wrong number of arguments (given " ++ str_of_int got ++ ", expected " ++ want ++ ")")

and req_pre = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then Nil else Cons (p, req_pre r defaults)

and drop_req_pre = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then params else drop_req_pre r defaults

and opt_run = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then Cons (p, opt_run r defaults) else Nil

and drop_opt_run = fn (params: str list) -> fn (defaults: (str * Expr) list) ->
  match params with
  | Nil -> Nil
  | Cons (p, r) -> if has_default defaults p then drop_opt_run r defaults else params

// positional binding with defaults: a param with no arg takes its default
// expression (evaluated in the frame), else nil.
and bind_defaulted = fn frame -> fn world -> fn blk -> fn (params: str list) -> fn (defaults: (str * Expr) list) -> fn (args: Val list) ->
  match params with
  | Nil -> ()
  | Cons (p, ps) ->
    (match args with
     | Cons (a, rest) -> let _ = bind_seq_one frame world p a in bind_defaulted frame world blk ps defaults rest
     | Nil ->
       // Ruby declares the parameter (as nil) before its default runs, so a
       // self-referential default like `a = a` sees nil.
       let v = (if has_default defaults p
                then (let _ = map_set frame p VNil in eval_e frame world blk (get_default defaults p))
                else VNil) in
       let _ = bind_seq_one frame world p v in bind_defaulted frame world blk ps defaults Nil)

and has_default = fn (defaults: (str * Expr) list) -> fn (p: str) ->
  match defaults with Nil -> false | Cons (d, r) -> let (n, _) = d in if str_eq n p then true else has_default r p
and get_default = fn (defaults: (str * Expr) list) -> fn (p: str) ->
  match defaults with Nil -> ENil | Cons (d, r) -> let (n, e) = d in if str_eq n p then e else get_default r p

// fixed-arity binding (exact count required) — kept for reference/callers.
and bind_strict = fn frame -> fn (name: str) -> fn (params: str list) -> fn (args: Val list) ->
  match params with
  | Nil ->
    (match args with
     | Nil -> ()
     | _ -> fail ("mere-ruby: wrong number of arguments calling " ++ name))
  | Cons (p, ps) ->
    (match args with
     | Nil -> fail ("mere-ruby: wrong number of arguments calling " ++ name)
     | Cons (a, rest_a) -> let _ = map_set frame p a in bind_strict frame name ps rest_a)

// positional binding without an arity check (used for the fixed params
// around a splat); missing args bind nil.
and bind_seq = fn frame -> fn world -> fn (params: str list) -> fn (args: Val list) ->
  match params with
  | Nil -> ()
  | Cons (p, ps) ->
    (match args with
     | Nil -> let _ = bind_seq_one frame world p VNil in bind_seq frame world ps Nil
     | Cons (a, r) -> let _ = bind_seq_one frame world p a in bind_seq frame world ps r)

// bind one positional param, destructuring a `(a, b)` spec param.
and bind_seq_one = fn frame -> fn world -> fn (p: str) -> fn (v: Val) ->
  if str_len p > 0 && str_eq (char_at p 0) "(" then
    bind_destructure frame world (substring p 1 (str_len p - 1)) v
  else map_set frame p v

// register a class body: declarations register, everything else EXECUTES
// (a Ruby class body is code). Returns the escaping Flow (break/raise in
// the body propagates out) or FNext when the walk completes.
// the receiver part of a qualified method name ("C#m" -> "C").
and recv_base = fn (nm: str) -> recv_base_go nm 0

and recv_base_go = fn (nm: str) -> fn (i: int) ->
  if i >= str_len nm then nm
  else if str_eq (char_at nm i) "#" then substring nm 0 i
  else recv_base_go nm (i + 1)

// the object's singleton class name, creating it on first use. A singleton
// class name is "(sng:<obj id>)" with the object's current class as its
// superclass; class-name display walks past it (see display_cls).
// a mutable primitive instance (String/Array/Hash) singleton class, keyed by
// the value's handle; superclass is the subclass tag if any, else the base
// primitive class. Does not retag dispatch — just fabricates the sng class.
and prim_sng_cls = fn world -> fn (recv: Val) -> fn (basecls: str) ->
  let (_, sup2, _, _) = world in
  let hk = hng_key recv in
  let sname = "(sng:" ++ hk ++ ")" in
  let base = if map_has hng_store hk then map_get hng_store hk else basecls in
  let _ = if map_has sup2 sname then () else map_set sup2 sname base in
  sname

and singleton_cls_of = fn world -> fn (id: int) ->
  let (meths, sup, ocls, ivars) = world in
  let cur = map_get ocls (str_of_int id) in
  if is_sng_cls cur then cur
  else
    let sname = "(sng:" ++ str_of_int id ++ ")" in
    let _ = map_set sup sname cur in
    let _ = map_set ocls (str_of_int id) sname in
    sname

and is_sng_cls = fn (c: str) ->
  str_len c >= 5 && str_eq (substring c 0 5) "(sng:"

// the value/class named inside a singleton-class name: "(sng:X)" -> "X".
and sng_inner = fn (c: str) -> substring c 5 (str_len c - 1)

// the superclass NAME of a class, honouring the singleton-class hierarchy:
// C.singleton_class.superclass == C.superclass.singleton_class, and
// BasicObject.singleton_class.superclass == Class. An object's singleton class
// keeps its recorded superclass (the object's class).
// collect public+protected method names (excluding privates) along a class's
// ancestor chain into `names` (keyed by name, VSym value, for dedup).
and collect_methods = fn world -> fn (cls: str) -> fn names ->
  let (meths0, sup0, _, _) = world in
  let pfx = cls ++ "#" in
  let plen = str_len pfx in
  let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
    if str_len k > plen && str_eq (substring k 0 plen) pfx
       && (if str_contains (substring k plen (str_len k)) "#" then false else true)
       && (if map_has privates k then false else true)
    then (let nm = substring k plen (str_len k) in if map_has names nm then () else map_set names nm (VSym nm))
    else ()) in
  if map_has sup0 cls then collect_methods world (map_get sup0 cls) names
  else if str_eq cls "Object" || str_eq cls "BasicObject" then ()
  else collect_methods world "Object" names

// the class a class/metaclass is an INSTANCE of, for is_a?/kind_of? (distinct
// from #class, which hides singletons). A class is an instance of Class, a
// module of Module, and a singleton class `(sng:X)` of `(sng: class_of(X))`
// (so A.singleton_class is a kind of Class.singleton_class).
and metaclass_class = fn (c: str) ->
  if is_sng_cls c then "(sng:" ++ metaclass_class (sng_inner c) ++ ")"
  else if map_has modules c then "Module"
  else "Class"

and sng_supername = fn world -> fn (c: str) ->
  let (_, sup0, _, _) = world in
  if is_sng_cls c then
    (if map_has sup0 c then map_get sup0 c
     else
       let inner = sng_inner c in
       if str_eq inner "BasicObject" then "Class"
       // a module's singleton class descends from Module (the module is an
       // instance of Module), so its class methods' super reaches Module then
       // Object instance methods.
       else if map_has modules inner then "Module"
       else "(sng:" ++ sng_supername world inner ++ ")")
  else if str_eq c "BasicObject" then "BasicObject"
  else if map_has sup0 c then map_get sup0 c
  else if str_eq c "Object" then "BasicObject"
  else "Object"

// Record the constant name of a freshly-named anonymous class/module, then
// recurse: any anonymous module reachable through its own constants (C::K = m)
// is named cn::K in turn. The "first name wins" guard also terminates cycles.
and name_anon = fn (cn: str) -> fn (v: Val) ->
  match v with
  | VClass c ->
    if is_anon_cls c && (if map_has anon_name c then false else true) then
      (let _ = map_set anon_name c (mkstr cn) in
       let prefix = c ++ "::" in
       let plen = str_len prefix in
       map_iter consts (fn (k: str) -> fn (kv: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) prefix
            && (if str_contains (substring k plen (str_len k)) "::" then false else true)
         then name_anon (cn ++ "::" ++ substring k plen (str_len k)) kv
         else ()))
    else ()
  | _ -> ()

// the singleton class to open for `class << target`: self/obj/str/arr/hsh
// resolve to their singleton class; anything else falls back to `enclosing`.
and sng_cls_of_val = fn world -> fn (v: Val) -> fn (enclosing: str) ->
  match v with
  | VObj id -> singleton_cls_of world id
  // the singleton class of a class C is (sng:C) — class methods live there.
  // A singleton class has its own (distinct) singleton class too, so nest:
  // the metaclass of a metaclass is (sng:(sng:C)), enabling deeper chains.
  | VClass c -> "(sng:" ++ c ++ ")"
  | VStr h -> hng_cls_of world (VStr h) "String"
  | VArr h -> hng_cls_of world (VArr h) "Array"
  | VHsh h -> hng_cls_of world (VHsh h) "Hash"
  | _ -> enclosing

and sng_target_cls = fn world -> fn env -> fn (tgt: str) -> fn (enclosing: str) ->
  if str_eq tgt "self" then
    (if map_has env "self" then sng_cls_of_val world (map_get env "self") enclosing else enclosing)
  else if map_has env tgt then sng_cls_of_val world (map_get env tgt) enclosing
  else enclosing

// singleton class for a handle-based value (String/Array/Hash), created on
// first `def value.method` and recorded in hng_store for dispatch.
and hng_cls_of = fn world -> fn (recv: Val) -> fn (typename: str) ->
  let (meths, sup, ocls, ivars) = world in
  let k = hng_key recv in
  if map_has hng_store k then map_get hng_store k
  else
    let sname = "(sng:" ++ k ++ ")" in
    let _ = map_set sup sname typename in
    let _ = map_set hng_store k sname in
    sname

// the class an object reports (its first non-singleton ancestor).
and display_cls = fn world -> fn (c: str) ->
  let (meths, sup, ocls, ivars) = world in
  if is_sng_cls c then (if map_has sup c then display_cls world (map_get sup c) else "Object")
  else c

// the bare method name from a possibly receiver-qualified one ("C#m" -> "m");
// `def` evaluates to the method name as a symbol.
and meth_base = fn (nm: str) ->
  meth_base_go nm 0 0

and meth_base_go = fn (nm: str) -> fn (i: int) -> fn (start: int) ->
  if i >= str_len nm then substring nm start (str_len nm)
  else if str_eq (char_at nm i) "#" then meth_base_go nm (i + 1) (i + 1)
  else meth_base_go nm (i + 1) start

// register a refinement of `target` under `refinery`: run its body into a
// fresh impl class and record the triple for a later `using`.
and do_refine = fn world -> fn (refinery: str) -> fn (target: str) -> fn (bb: Stmt list) ->
  let i = (if map_has refine_cnt refinery then (match map_get refine_cnt refinery with VInt n -> n | _ -> 0) else 0) in
  let impl = "Refine_" ++ refinery ++ "_" ++ str_of_int i in
  let _ = flow_value (register_class world impl bb) in
  let _ = map_set refine_tgt (refinery ++ "#" ++ str_of_int i) (mkstr target) in
  let _ = map_set refine_cls (refinery ++ "#" ++ str_of_int i) (mkstr impl) in
  let _ = map_set refine_cnt refinery (VInt (i + 1)) in
  VClass impl

// activate refinery's refinements: for each recorded (target, impl), point the
// target class at the impl in ref_active.
and activate_refinements = fn (refinery: str) -> fn (i: int) -> fn (n: int) ->
  if i >= n then ()
  else
    let key = refinery ++ "#" ++ str_of_int i in
    let tgt = (match map_get refine_tgt key with VStr h -> sget h | _ -> "") in
    let impl = map_get refine_cls key in
    let _ = if str_eq tgt "" then () else map_set ref_active tgt impl in
    activate_refinements refinery (i + 1) n

// delete every entry from a map.
and map_clear = fn m ->
  let cur = map_new () in
  let _ = map_iter m (fn (k: str) -> fn (v: Val) -> map_set cur k v) in
  map_iter cur (fn (k: str) -> fn (v: Val) -> if map_has m k then map_delete m k else ())

// clear ref_active and repopulate from `saved` (restore a scope's snapshot).
and restore_ref_active = fn saved ->
  let cur = map_new () in
  let _ = map_iter ref_active (fn (k: str) -> fn (v: Val) -> map_set cur k v) in
  let _ = map_iter cur (fn (k: str) -> fn (v: Val) -> if map_has ref_active k then map_delete ref_active k else ()) in
  let _ = map_iter saved (fn (k: str) -> fn (v: Val) -> map_set ref_active k v) in
  ()

// like register_class but sets the lexical scope (cref) to the class for the
// body's duration — for real class/singleton bodies, so body-level constant
// reads resolve under the class. (module_eval/class_eval with a BLOCK use plain
// register_class instead, keeping the block's own lexical scope.)
// register the built-in class / module names as constants so a bare reference
// resolves; a genuinely-undefined constant then raises NameError.
and reg_class_list = fn (ns: str list) ->
  match ns with Nil -> () | Cons (n, t) -> let _ = if map_has consts n then () else map_set consts n (VClass n) in reg_class_list t
and reg_mod_list = fn (ns: str list) ->
  match ns with Nil -> () | Cons (n, t) -> let _ = (if map_has consts n then () else map_set consts n (VClass n)) in let _ = map_set modules n VNil in reg_mod_list t
and register_builtin_consts = fn (u: unit) ->
  let _ = reg_class_list (Cons ("Object", Cons ("BasicObject", Cons ("Module", Cons ("Class",
    Cons ("Integer", Cons ("Float", Cons ("Numeric", Cons ("String", Cons ("Array", Cons ("Hash",
    Cons ("Symbol", Cons ("Range", Cons ("Proc", Cons ("NilClass", Cons ("TrueClass", Cons ("FalseClass",
    Cons ("Regexp", Cons ("MatchData", Cons ("Struct", Cons ("Time", Cons ("Method", Cons ("Binding",
    Cons ("Enumerator", Cons ("Thread", Cons ("Complex", Cons ("Rational", Cons ("Encoding", Cons ("IO",
    Cons ("File", Cons ("Dir", Cons ("Data", Cons ("GC", Cons ("ObjectSpace", Cons ("Process", Cons ("Marshal",
    Cons ("Mutex", Cons ("Fiber", Cons ("Random", Cons ("Signal", Cons ("Set", Cons ("Regexp",
    Cons ("Exception", Cons ("StandardError", Cons ("RuntimeError", Cons ("ArgumentError", Cons ("TypeError",
    Cons ("RangeError", Cons ("IndexError", Cons ("KeyError", Cons ("ZeroDivisionError",
    Cons ("NotImplementedError", Cons ("EncodingError", Cons ("RegexpError", Cons ("NameError", Cons ("NoMethodError",
    Cons ("StopIteration", Cons ("FrozenError", Cons ("ScriptError", Cons ("SyntaxError",
    Cons ("LocalJumpError", Cons ("UncaughtThrowError", Cons ("NoMatchingPatternError",
    Cons ("NoMatchingPatternKeyError", Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) in
  reg_mod_list (Cons ("Comparable", Cons ("Enumerable", Cons ("Kernel", Cons ("Math", Nil)))))

and register_class_lex = fn world -> fn (cls: str) -> fn (body: Stmt list) ->
  let saved_lex = cur_lex () in
  let _ = set_lex cls in
  let r = register_class world cls body in
  let _ = set_lex saved_lex in
  r

// Ruby's `inherited` hook: when a new subclass is created, call
// superclass.inherited(subclass) if a (class-level) `inherited` is defined.
and call_inherited = fn world -> fn env -> fn (super_name: str) -> fn (sub_name: str) ->
  if str_eq super_name "" then ()
  else
    let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
    // `inherited` is a class method: it lives in the superclass's singleton
    // namespace "(sng:Super)". Fall back to an instance-method lookup for a
    // builtin/legacy definition.
    if has_meth world ("(sng:" ++ super_name ++ ")") "inherited" then
      let _ = invoke world nb (VClass super_name) ("(sng:" ++ super_name ++ ")") "inherited" (Cons (VClass sub_name, Nil)) in ()
    else if has_meth world super_name "inherited" then
      let _ = invoke_val_c env world nb (VClass super_name) "inherited" (Cons (VClass sub_name, Nil)) false in ()
    else ()

and register_class = fn world -> fn (cls: str) -> fn (body: Stmt list) ->
  // a `using` inside this body is scoped to it: snapshot/restore ref_active.
  let saved = map_copy ref_active in
  let cenv = map_new () in
  let _ = map_set cenv "self" (VClass cls) in
  // a literal class body IS the lexical scope for the constants/classes it
  // defines; __cscope names that scope (a class_eval-style block overrides it
  // via register_class_blk). __cref makes blocks created in the body capture
  // their lexical scope for later constant resolution.
  let _ = map_set cenv "__cscope" (mkstr cls) in
  let _ = map_set cenv "__cref" (mkstr cls) in
  let r = register_class_v world cls body "public" cenv in
  let _ = restore_ref_active saved in
  r

// run a class_eval-style BLOCK body as class `cls`: defs go to the class, but
// constants and nested classes go to `cscope` — the block's LEXICAL scope
// (Ruby: a block does not open a new constant scope).
and register_class_blk = fn world -> fn (cls: str) -> fn (body: Stmt list) -> fn (cscope: str) ->
  let saved = map_copy ref_active in
  let cenv = map_new () in
  let _ = map_set cenv "self" (VClass cls) in
  let _ = map_set cenv "__cscope" (mkstr cscope) in
  let _ = map_set cenv "__cref" (mkstr cscope) in
  // methods defined in the block get the block's lexical scope as their cref
  // (constant resolution in their bodies), not the call site's.
  let saved_lex = cur_lex () in
  let _ = set_lex cscope in
  let r = register_class_v world cls body "public" cenv in
  let _ = set_lex saved_lex in
  let _ = restore_ref_active saved in
  r

// walk the class body tracking the current visibility mode (a bare
// `private` marks every subsequent def private until `public`).
and register_class_v = fn world -> fn (cls: str) -> fn (body: Stmt list) -> fn (vis: str) -> fn cenv ->
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), cenv) in
  // the scope for constants / nested classes defined in this body: the class
  // itself for a literal body, the block's lexical scope for a class_eval-
  // style block ("" = top level).
  let cscope = (if map_has cenv "__cscope" then (match map_get cenv "__cscope" with VStr s -> let s = sget s in s | _ -> cls) else cls) in
  match body with
  | Nil -> FNext VNil
  // a rescue-less `begin ... end` grouping in a class body is spliced inline,
  // so def / visibility-mode threading applies to its statements (needed for
  // `private def m ... end`, which the parser lowers to begin(def; private :m)).
  | Cons (SBegin (bbody, Nil, Nil, Nil), rest) ->
    register_class_v world cls (list_append_stmt bbody rest) vis cenv
  | Cons (s, rest) ->
    let vis2 = (match s with SVis (m, Nil) -> m | _ -> vis) in
    let f =
      (match s with
       // named form: mark (or unmark) those methods directly. `module_function
       // :m` also copies the instance method into the module's singleton
       // namespace so it is callable as a module method.
       | SVis (m, names) ->
         let _ = (match names with
                  | Nil -> ()
                  | _ -> if str_eq m "module_function" then modfunc_promote world cls names
                         else if str_eq m "private_class_method" then mark_vis_mode meths ("(sng:" ++ cls ++ ")") names "private"
                         else mark_vis_mode meths cls names m) in
         FNext VNil
       | SDef (mname0, params, defs, mbody) ->
         // `def self.m` (marked "self.m") is a class method: register under
         // the class, always public regardless of the visibility mode.
         let is_selfdef = str_len mname0 > 5 && str_eq (substring mname0 0 5) "self." in
         let mname = if is_selfdef then substring mname0 5 (str_len mname0) else mname0 in
         // `def C.m` (a receiver-qualified "C#m") is a class method of C, so it
         // lives in C's singleton namespace; `def self.m` likewise on the
         // enclosing class; a plain name is an instance method.
         let key = if str_contains mname "#" then "(sng:" ++ recv_base mname ++ ")#" ++ meth_base mname
                   else if is_selfdef then "(sng:" ++ cls ++ ")#" ++ mname
                   else cls ++ "#" ++ mname in
         let _ = map_set meths key (Meth (params, defs, mbody)) in
         let _ = map_set meth_cref key (cur_lex ()) in
         // `module_function` mode: the instance method is ALSO a module method,
         // so register it in the module's singleton namespace too.
         let _ = if str_eq vis2 "module_function" && (if is_selfdef then false else true) && (if str_contains mname "#" then false else true)
                 then (let mk = "(sng:" ++ cls ++ ")#" ++ mname in let _ = map_set meths mk (Meth (params, defs, mbody)) in map_set meth_cref mk (cur_lex ()))
                 else () in
         let _ = if map_has undefs key then map_delete undefs key else () in
         // a (re)definition is not ruby2_keywords until explicitly marked:
         // clear any stale mark (the mark table is keyed by bare name, so a
         // plain `def m` must not inherit an earlier `ruby2_keywords def m`).
         let _ = if map_has r2k_methods (meth_base mname) then map_delete r2k_methods (meth_base mname) else () in
         // receiver-qualified / singleton defs are always public.
         let _ = if (if is_selfdef then false else true) && (if str_contains mname "#" then false else true) then
                   (if str_eq vis2 "private" then map_set privates key VNil
                    else if str_eq vis2 "protected" then map_set protecteds key VNil
                    else ())
                 else () in
         FNext (VSym (meth_base mname))
       | SAttr (mode, syms) -> let _ = add_attrs world cls mode syms in FNext VNil
       // a nested class / module registers under its qualified name so that
       // `Outer::Inner` resolves (and reports its full name).
       | SClass (cname, csuper, cbody) ->
         if str_eq cname "<<singleton" then
           // class << self / class << obj: open the target's singleton class.
           register_class world (sng_target_cls world cenv csuper cls) cbody
         else
         // `class ::C` inside a class body is a TOP-LEVEL constant (not nested
         // under the enclosing class): strip the `::` and don't qualify.
         let full = if str_len cname >= 2 && str_eq (substring cname 0 2) "::" then substring cname 2 (str_len cname)
                    else if str_eq cscope "" then cname else cscope ++ "::" ++ cname in
         // a sibling nested class referenced as a bare superclass name
         // resolves to its qualified form.
         let qsuper = (if str_eq csuper "" then ""
                       else if (if str_eq cscope "" then false else true) && map_has consts (cscope ++ "::" ++ csuper) then cscope ++ "::" ++ csuper
                       else csuper) in
         let was_new = if map_has consts full then false else true in
         // reopening an existing class with a different, explicit superclass is
         // a TypeError (the superclass stays unchanged).
         let _ = if (if was_new then false else true) && (if str_eq qsuper "" then false else true)
                    && (let existing = (if map_has sup full then map_get sup full else "Object") in if str_eq existing qsuper then false else true)
                 then let _ = raise_exc world "TypeError" ("superclass mismatch for class " ++ full) in ()
                 else () in
         let _ = if str_eq qsuper "" then () else map_set sup full qsuper in
         let _ = if map_has consts full then () else map_set consts full (VClass full) in
         let _ = if was_new then call_inherited world cenv qsuper full else () in
         let saved_lex = cur_lex () in
         let _ = set_lex full in
         let r = register_class world full cbody in
         let _ = set_lex saved_lex in
         r
       // nested class with a runtime-expression superclass: evaluate it first.
       | SClassE (cname, se, cbody) ->
         let scv = eval_e cenv world noblk se in
         (match scv with
          | VClass sc ->
            if map_has modules sc || (str_len sc >= 5 && str_eq (substring sc 0 5) "(sng:") then
              (let _ = raise_exc world "TypeError" "superclass must be a Class" in FNext VNil)
            else
              let full = if str_len cname >= 2 && str_eq (substring cname 0 2) "::" then substring cname 2 (str_len cname)
                         else if str_eq cscope "" then cname else cscope ++ "::" ++ cname in
              let was_new = if map_has consts full then false else true in
              if was_new && str_eq sc full then
                // `class X < remove_const(:X)`: the superclass IS the removed
                // old class, whose internal name equals the one being defined.
                // Give the NEW class a fresh internal name; the constant and
                // display name stay `full` (name_anon), so X.name == full and
                // X.superclass is the old class object.
                (let internal = fresh_anon "AnonClass_" in
                 let _ = map_set sup internal sc in
                 let _ = map_set consts full (VClass internal) in
                 let _ = name_anon full (VClass internal) in
                 let _ = call_inherited world cenv sc internal in
                 let saved_lex = cur_lex () in
                 let _ = set_lex internal in
                 let r = register_class world internal cbody in
                 let _ = set_lex saved_lex in
                 r)
              else
              let _ = if str_eq sc full then () else map_set sup full sc in
              let _ = if map_has consts full then () else map_set consts full (VClass full) in
              let _ = if was_new && (if str_eq sc full then false else true) then call_inherited world cenv sc full else () in
              let saved_lex = cur_lex () in
              let _ = set_lex full in
              let r = register_class world full cbody in
              let _ = set_lex saved_lex in
              r
          | _ -> let _ = raise_exc world "TypeError" "superclass must be a Class" in FNext VNil)
       // a constant assignment in the body runs at definition time; stored
       // stored under the qualified name only (`Klass::CONST`), so it does not
       // clobber a top-level constant of the same name; bare lookups find it
       // via the lexical scope (cref).
       | SAssign (aname, e) ->
         if is_upper_first aname && (if str_contains aname "::" then false else true) then
           let v = eval_e cenv world noblk e in
           let key = if str_eq cscope "" then aname else cscope ++ "::" ++ aname in
           let _ = map_set consts key v in
           // an anonymous class/module assigned to a constant takes that
           // constant name as its display name.
           let _ = name_anon key v in
           FNext VNil
         else exec_stmt cenv world noblk s   // a local / scoped assign in the body
       // `alias new old` inside the class copies the method entry.
       | SAlias (n1, n2) ->
         let _ = if map_has meths (cls ++ "#" ++ n2) then map_set meths (cls ++ "#" ++ n1) (map_get meths (cls ++ "#" ++ n2))
                 else () in
         FNext VNil
       // `include M` records the module for method lookup fallback.
       | SInclude m ->
         // resolve the module name in the enclosing lexical scope so a nested
         // `include ModA` records the qualified name (NS::ModA), matching where
         // its methods live.
         let mq = resolve_scope_name cls m in
         let _ = map_set includes cls (if map_has includes cls then (map_get includes cls) ++ "|" ++ mq else mq) in
         FNext VNil
       // `undef name` removes the method from this class.
       | SUndef names -> let _ = undef_check world cls names in let _ = undef_all meths cls names in FNext VNil
       // `define_method(:name) { body }` registers the block as a method;
       // any other expression statement executes.
       | SExpr (ECallB (fname, fargs, bp, bb)) ->
         if str_eq fname "define_method" then
           let _ = (match fargs with
                    | Cons (ESym nm, _) -> let _ = map_set meths (cls ++ "#" ++ nm) (Meth (bp, Nil, bb)) in map_set dm_methods (cls ++ "#" ++ nm) VNil
                    | _ -> ()) in
           FNext VNil
         else exec_stmt cenv world noblk s
       // everything else is plain code — a class body executes.
       | _ -> exec_stmt cenv world noblk s) in
    (match f with
     // the class expression's value is its body's last statement value.
     | FNext v -> (match rest with
                   | Nil -> FNext v
                   | _ -> register_class_v world cls rest vis2 cenv)
     | esc -> esc)

// shallow scan of a body for local-assignment targets (if-branch locals
// must exist as nil even when the branch did not run).
and body_targets = fn (body: Stmt list) ->
  match body with
  | Nil -> Nil
  | Cons (s, rest) ->
    (match s with
     | SAssign (n, _) -> Cons (n, body_targets rest)
     | SLocalFrom (n, _) -> Cons (n, body_targets rest)
     | SMultiAssign (ts, _) -> list_append_str ts (body_targets rest)
     | SMultiAssignX (ts, _) -> list_append_str (x_target_names ts) (body_targets rest)
     | _ -> body_targets rest)

and declare_clause_targets = fn env -> fn clauses ->
  match clauses with
  | Nil -> ()
  | Cons (cl, rest) ->
    let (c, b) = cl in
    let _ = declare_nils env (body_targets b) in
    declare_clause_targets env rest

// bind each plain-local target to nil unless already bound ("*name" strips
// the splat prefix; @ivars, $globals and constants are skipped).
and declare_nils = fn env -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n0, rest) ->
    let n = if str_len n0 > 0 && str_eq (char_at n0 0) "*" then substring n0 1 (str_len n0) else n0 in
    let skip = str_len n == 0 || str_eq (char_at n 0) "@" || str_eq (char_at n 0) "$" || is_upper_first n in
    let _ = if skip then () else if map_has env n then () else map_set env n VNil in
    declare_nils env rest

// mark (private=true) or unmark each `cls#name` in the privates table.
// `module_function :m` copies each named instance method (cls#m) into the
// module's singleton namespace ((sng:cls)#m) so it is callable as C.m.
and modfunc_promote = fn world -> fn (cls: str) -> fn (names: str list) ->
  let (meths, sup, ocls, ivars) = world in
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let src = cls ++ "#" ++ n in
    let _ = if map_has meths src then map_set meths ("(sng:" ++ cls ++ ")#" ++ n) (map_get meths src) else () in
    modfunc_promote world cls rest

and mark_vis_mode = fn meths -> fn (cls: str) -> fn (names: str list) -> fn (mode: str) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let key = cls ++ "#" ++ n in
    let _ = (if str_eq mode "private" then let _ = map_set privates key VNil in ()
             else if str_eq mode "protected" then let _ = map_set protecteds key VNil in ()
             else (let _ = if map_has privates key then map_delete privates key else () in
                   if map_has protecteds key then map_delete protecteds key else ())) in
    mark_vis_mode meths cls rest mode

and mark_vis = fn meths -> fn (cls: str) -> fn (names: str list) -> fn (priv: bool) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let key = cls ++ "#" ++ n in
    let _ = if priv then map_set privates key VNil
            else if map_has privates key then map_delete privates key else () in
    mark_vis meths cls rest priv

// is the method (as found from `cls`) private? Resolves the defining class
// so a private method inherited by a subclass stays private.
// is `name` a protected method somewhere in cls's ancestry?
and meth_protected = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if str_eq cls "" then false
  else if map_has protecteds (cls ++ "#" ++ name) then true
  else if map_has meths (cls ++ "#" ++ name) then false
  else if map_has sup cls then meth_protected world (map_get sup cls) name
  else if str_eq cls "Object" then false
  else meth_protected world "Object" name

// a protected call is allowed when the caller's self is a kind of the
// method's class.
and protected_ok = fn env -> fn world -> fn (cls: str) ->
  if map_has env "self" then
    (let (meths, sup, ocls, ivars) = world in
     match map_get env "self" with
     | VObj id -> obj_is_a world (map_get ocls (str_of_int id)) cls
     | _ -> false)
  else false

and meth_private = fn world -> fn (cls: str) -> fn (name: str) ->
  // walk from the object's class up: the first ancestor that either marks
  // the method private (`private :foo` override) or defines it decides.
  let (meths, sup, ocls, ivars) = world in
  if str_eq cls "" then false
  else if map_has privates (cls ++ "#" ++ name) then true
  else if map_has meths (cls ++ "#" ++ name) then false   // public definition here
  else if map_has sup cls then meth_private world (map_get sup cls) name
  else if str_eq cls "Object" then false
  else meth_private world "Object" name

// remove each top-level method entry.
and undef_top = fn meths -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) -> let _ = if map_has meths n then map_delete meths n else () in undef_top meths rest

// remove each `cls#name` method entry.
// `undef name` raises NameError when the method is not defined on the class
// (nor inherited / a primitive), matching Ruby.
and undef_check = fn world -> fn (cls: str) -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    if has_meth world cls n || is_prim_method n then undef_check world cls rest
    else (let _ = raise_exc world "NameError" ("undefined method '" ++ n ++ "' for class '" ++ cls ++ "'") in ())

and undef_all = fn meths -> fn (cls: str) -> fn (names: str list) ->
  match names with
  | Nil -> ()
  | Cons (n, rest) ->
    let _ = if map_has meths (cls ++ "#" ++ n) then map_delete meths (cls ++ "#" ++ n) else () in
    // a tombstone blocks the method from being reached via inheritance.
    let _ = map_set undefs (cls ++ "#" ++ n) VNil in
    undef_all meths cls rest

// attr_reader/writer/accessor: synthesize getter and/or setter methods.
and add_attrs = fn world -> fn (cls: str) -> fn (mode: str) -> fn (syms: str list) ->
  let (meths, sup, ocls, ivars) = world in
  match syms with
  | Nil -> ()
  | Cons (name, rest) ->
    let _ =
      if str_eq mode "r" || str_eq mode "rw" then
        map_set meths (cls ++ "#" ++ name)
          (Meth (Nil, Nil, Cons (SReturn (EIVar name), Nil)))
      else () in
    let _ =
      if str_eq mode "w" || str_eq mode "rw" then
        map_set meths (cls ++ "#" ++ name ++ "=")
          (Meth (Cons ("v", Nil), Nil,
                 Cons (SIVarAssign (name, EVar "v"), Cons (SReturn (EVar "v"), Nil))))
      else () in
    add_attrs world cls mode rest

// run a statement list; stop and propagate on an explicit return. The
// value of the list is its last statement's value (Ruby's implicit
// return), or nil when empty.
// run a code unit honouring BEGIN/END: every top-level BEGIN body runs first
// (in appearance order), then the remaining statements, then every END body.
// Nested BEGIN/END (inside a block/method) is left in `run_mid` and reaches
// exec_stmt, where BEGIN raises the required SyntaxError.
and hoist_run = fn env -> fn world -> fn blk -> fn (prog: Stmt list) ->
  let _ = run_pre env world blk prog in
  let r = run_stmts env world blk (filter_mid prog) in
  let _ = run_post env world blk prog in
  r

and run_pre = fn env -> fn world -> fn blk -> fn (prog: Stmt list) ->
  match prog with
  | Nil -> ()
  | Cons (SPreexe body, rest) -> (match run_stmts env world blk body with _ -> run_pre env world blk rest)
  | Cons (_, rest) -> run_pre env world blk rest

and run_post = fn env -> fn world -> fn blk -> fn (prog: Stmt list) ->
  match prog with
  | Nil -> ()
  | Cons (SAtExit body, rest) -> (match run_stmts env world blk body with _ -> run_post env world blk rest)
  | Cons (_, rest) -> run_post env world blk rest

and filter_mid = fn (prog: Stmt list) ->
  match prog with
  | Nil -> Nil
  | Cons (SPreexe _, rest) -> filter_mid rest
  | Cons (SAtExit _, rest) -> filter_mid rest
  | Cons (s, rest) -> Cons (s, filter_mid rest)

and run_stmts = fn env -> fn world -> fn blk -> fn (prog: Stmt list) ->
  match prog with
  | Nil -> FNext VNil
  | Cons (s, rest) ->
    (match rest with
     | Nil -> exec_stmt env world blk s
     | _ ->
       (match exec_stmt env world blk s with
        | FReturn v -> FReturn v
        | FRaise v -> FRaise v
        | FBreak v -> FBreak v
        | FLoopNext v -> FLoopNext v
        | FNext _ -> run_stmts env world blk rest))

and exec_stmt = fn env -> fn world -> fn blk -> fn (s: Stmt) ->
  match s with
  | SPuts es ->
    let _ = (match es with Nil -> out_print "" | _ -> puts_args env world blk es) in
    FNext VNil
  | SExpr e -> FNext (eval_e env world blk e)
  | SAssign (name, e) ->
    // `A::C = v` where A is not a class/module is a TypeError.
    let _ = (if str_contains name "::" then
               let rc = recv_of_scoped name in
               if map_has consts rc && (match map_get consts rc with VClass _ -> false | _ -> true) then
                 let _ = raise_exc world "TypeError" (to_s (map_get consts rc) ++ " is not a class/module") in ()
               else ()
             else ()) in
    // Ruby declares a local at parse time, so a plain `x = <rhs>` makes x
    // visible (as nil) inside its own rhs — e.g. `x = x` yields nil.
    let _ = (if str_len name > 0 && str_eq (char_at name 0) "$" then ()
             else if is_upper_first name then ()
             else if str_contains name "::" then ()
             else if map_has env name then ()
             else map_set env name VNil) in
    let v = eval_e env world blk e in
    let _ = if str_len name > 0 && str_eq (char_at name 0) "$"
            then map_set globals (substring name 1 (str_len name)) v
            else if str_len name >= 2 && str_eq (substring name 0 2) "::" then (let cn = substring name 2 (str_len name) in let _ = map_set consts cn v in name_anon cn v)
            else if is_upper_first name then (let _ = map_set consts name v in name_anon name v)
            else map_set env name v in
    FNext v
  | SIVarAssign (name, e) ->
    let (meths, sup, ocls, ivars) = world in
    let v = eval_e env world blk e in
    if str_len name > 0 && str_eq (char_at name 0) "@" then
      let _ = cvar_set env world (substring name 1 (str_len name)) v in FNext v
    else
    (match map_get env "self" with
     | VObj id -> let _ = map_set ivars (str_of_int id ++ "@" ++ name) v in FNext v
     | VMain -> let _ = map_set ivars ("main@" ++ name) v in FNext v
     | VClass c -> let _ = map_set ivars ("cls:" ++ c ++ "@" ++ name) v in FNext v
     | _ -> fail "mere-ruby: @ivar assignment outside an object")
  | SIf (clauses, els) ->
    // after the if, declare (as nil) any assignment targets in branches
    // that did not run — Ruby defines locals at parse time.
    let f = run_if env world blk clauses els in
    let _ = declare_clause_targets env clauses in
    let _ = declare_nils env (body_targets els) in
    f
  | SWhile (cond, body) -> run_while env world blk cond body
  | SCase (subj, whens, els) ->
    (match subj with
     | ECaseNone -> run_case_truthy env world blk whens els
     | _ -> run_case env world blk (eval_e env world blk subj) whens els)
  | SCaseIn (subj, clauses, has_else, els) ->
    // Ruby declares every pattern variable at parse time (they exist as nil
    // even when no clause matches). Pre-declare, then try each clause.
    let _ = declare_nils env (clauses_pat_vars clauses) in
    // #deconstruct(_keys) is cached across this case's clauses (called once).
    let _ = map_clear deco_memo in
    let v = eval_e env world blk subj in
    run_case_in env world blk v clauses has_else els
  | SDef (name, params, defs, body) ->
    let (meths, sup, ocls, ivars) = world in
    // `def recv.m` where recv is a live local naming an object defines a
    // singleton method: the object gets its own hidden class (superclass =
    // its current class) and the method registers there.
    let key =
      // `def self.m` outside a class body: on main it is a top-level method
      // (bare name); on an object/class it is that receiver's singleton method.
      (if str_len name > 5 && str_eq (substring name 0 5) "self." then
         let m = substring name 5 (str_len name) in
         (if map_has env "self" then
            (match map_get env "self" with
             | VObj id -> singleton_cls_of world id ++ "#" ++ m
             | VClass c -> "(sng:" ++ c ++ ")#" ++ m
             | _ -> m)
          else m)
       else if str_contains name "#" then
         let recv = recv_base name in
         let m = meth_base name in
         if map_has env recv then
           (match map_get env recv with
            | VObj id -> singleton_cls_of world id ++ "#" ++ m
            | VClass c -> "(sng:" ++ c ++ ")#" ++ m
            | VStr h -> hng_cls_of world (VStr h) "String" ++ "#" ++ m
            | VArr h -> hng_cls_of world (VArr h) "Array" ++ "#" ++ m
            | VHsh h -> hng_cls_of world (VHsh h) "Hash" ++ "#" ++ m
            | _ -> name)
         // `def C.m` where C is a constant class (not an env local): class
         // method in C's singleton namespace.
         else if is_upper_first recv && map_has consts recv && (match map_get consts recv with VClass _ -> true | _ -> false) then "(sng:" ++ recv ++ ")#" ++ m
         else name
       // a nested `def` inside a method body defines on self's class.
       else if map_has env "self" then
         (match map_get env "self" with
          | VObj id -> map_get ocls (str_of_int id) ++ "#" ++ name
          | VClass c -> c ++ "#" ++ name
          // nil/true/false are singletons: def in their instance_eval defines
          // on NilClass/TrueClass/FalseClass so nil.<method> can reach it.
          | VNil -> "NilClass#" ++ name
          | VBool b -> (if b then "TrueClass" else "FalseClass") ++ "#" ++ name
          // other immediates (Integer/Float/Symbol/String) can't gain a
          // reachable per-object method this way, so keep the bare name.
          | _ -> name)
       else name) in
    let _ = map_set meths key (Meth (params, defs, body)) in
    let _ = map_set meth_cref key (cur_lex ()) in
    // a (re)definition is not ruby2_keywords until explicitly marked; clear any
    // stale mark so a later plain `def m` does not inherit an earlier one.
    let _ = if map_has r2k_methods (meth_base name) then map_delete r2k_methods (meth_base name) else () in
    FNext (VSym (meth_base name))
  // `class << <expr>` — open the singleton class of the evaluated receiver.
  // Immediates (Integer/Float/Symbol) have no singleton class (TypeError);
  // true/false/nil use their own class as the singleton.
  | SSingletonE (recv_e, body) ->
    let recv = eval_e env world blk recv_e in
    (match recv with
     | VInt _ -> (let _ = raise_exc world "TypeError" "can't define singleton" in FNext VNil)
     | VFlt _ -> (let _ = raise_exc world "TypeError" "can't define singleton" in FNext VNil)
     | VBig _ -> (let _ = raise_exc world "TypeError" "can't define singleton" in FNext VNil)
     | VSym _ -> (let _ = raise_exc world "TypeError" "can't define singleton" in FNext VNil)
     | VBool b -> register_class_lex world (if b then "TrueClass" else "FalseClass") body
     | VNil -> register_class_lex world "NilClass" body
     | _ -> register_class_lex world (sng_cls_of_val world recv "Object") body)
  | SClass (name0, super0, body) ->
    let (meths, sup, ocls, ivars) = world in
    // a leading `::` (class ::C) is a top-level constant; at the top level the
    // name is simply the stripped form.
    let toplevel = str_len name0 >= 2 && str_eq (substring name0 0 2) "::" in
    let name = if toplevel then substring name0 2 (str_len name0) else name0 in
    // resolve a variable-qualified base (`module m::N` with m a local) to the
    // module's real name before registration.
    let name = resolve_scoped_base env name in
    // `class << target` at top level: open the target's singleton class.
    if str_eq name "<<singleton" then
      // `class << self` at the top level opens main's singleton class, whose
      // methods are private top-level methods; mere has no distinct main
      // singleton, so run the body at top level (self stays main) and its
      // `def`s register as bare top-level methods.
      (if str_eq super0 "self" && map_has env "self" && (match map_get env "self" with VMain -> true | _ -> false) then
         run_stmts env world blk body
       else register_class_lex world (sng_target_cls world env super0 "Object") body)
    // `class Base::Name` where Base is nil/true/false or a non-class value
    // is a TypeError (nil is not a class/module).
    else if str_contains name "::" &&
            (let b = recv_of_scoped name in
             str_eq b "nil" || str_eq b "true" || str_eq b "false" ||
             (map_has consts b && (match map_get consts b with VClass _ -> false | _ -> true)) ||
             (map_has env b && (match map_get env b with VClass _ -> false | _ -> true))) then
      (let _ = raise_exc world "TypeError" (recv_of_scoped name ++ " is not a class/module") in FNext VNil)
    else
    // a bare class name reached here inside a class/module body (via control
    // flow such as a begin/if block) is lexically nested: qualify with the
    // current cref so it reopens the right constant (Base::Name), and resolve a
    // sibling superclass in the same scope. A `::`-prefixed name stays top-level.
    let lex = cur_lex () in
    let name = if toplevel || str_contains name "::" || str_eq lex "" then name
               else if map_has consts (lex ++ "::" ++ name) then lex ++ "::" ++ name else name in
    let super0 = if str_eq super0 "" || str_eq super0 "(module)" || str_eq lex "" || str_contains super0 "::" then super0
                 else if map_has consts (lex ++ "::" ++ super0) then lex ++ "::" ++ super0 else super0 in
    let is_module = str_eq super0 "(module)" in
    // reopening: `module C` on an existing class (or `class C` on a module)
    // is a TypeError; so is `class C < D` with a different superclass.
    let already = map_has consts name in
    let was_module = map_has modules name in
    let _ = (if already && (match map_get consts name with VClass _ -> false | _ -> true) then
               let _ = raise_exc world "TypeError" (name ++ " is not a class/module") in ()
             else if already && is_module && (if was_module then false else true) then
               let _ = raise_exc world "TypeError" (name ++ " is not a module") in ()
             else if already && (if is_module then false else true) && was_module then
               let _ = raise_exc world "TypeError" (name ++ " is not a class") in ()
             else if already && (if is_module then false else true) && (if str_eq super0 "" then false else true) &&
                     (let existing = (if map_has sup name then map_get sup name else "Object") in
                      if str_eq existing super0 then false else true) then
               let _ = raise_exc world "TypeError" ("superclass mismatch for class " ++ name) in ()
             else ()) in
    if (if already then false else true) && (if is_module then false else true) && str_eq super0 name then
      // `class X < remove_const(:X)` at the top level: same collision-rename
      // as the nested path (the constant/display name stays `name`).
      (let internal = fresh_anon "AnonClass_" in
       let _ = map_set sup internal super0 in
       let _ = map_set consts name (VClass internal) in
       let _ = name_anon name (VClass internal) in
       let _ = call_inherited world env super0 internal in
       let saved_lex = cur_lex () in
       let _ = set_lex internal in
       let r = register_class world internal body in
       let _ = set_lex saved_lex in
       r)
    else
    let super = (if is_module then (let _ = map_set modules name VNil in "") else super0) in
    let _ = if str_eq super "" || str_eq super name then () else map_set sup name super in
    // record the class itself as a defined constant (const_defined? etc.).
    let _ = if map_has consts name then () else map_set consts name (VClass name) in
    // fire the inherited hook for a freshly-created subclass.
    let _ = if already then () else call_inherited world env super name in
    // a break/raise escaping the class body propagates (a body is code).
    // set the lexical scope (cref) to this class while its body runs.
    let saved_lex = cur_lex () in
    let _ = set_lex name in
    let r = register_class world name body in
    let _ = set_lex saved_lex in
    r
  | SClassE (name, supExpr, body) ->
    // evaluate the superclass expression, then reuse the SClass path. A
    // non-Class value, a module, or a singleton class is not a valid
    // superclass and raises TypeError (Ruby semantics).
    let scv = eval_e env world blk supExpr in
    (match scv with
     | VClass sc ->
       if map_has modules sc || (str_len sc >= 5 && str_eq (substring sc 0 5) "(sng:") then
         (let _ = raise_exc world "TypeError" "superclass must be a Class" in FNext VNil)
       else exec_stmt env world blk (SClass (name, sc, body))
     | _ -> let _ = raise_exc world "TypeError" "superclass must be a Class" in FNext VNil)
  | SAttr (_, _) -> FNext VNil
  | SAlias (n1, n2) ->
    let (meths, sup, ocls, ivars) = world in
    let _ = if map_has meths n2 then map_set meths n1 (map_get meths n2) else () in
    FNext VNil
  | SInclude m ->
    // a runtime `include Mod` (e.g. inside a class method, self = the class)
    // adds the module to that class's ancestor chain; at the top level with no
    // class self it is a no-op. `m` may name a local variable holding a module
    // (e.g. an anonymous `Module.new`), not just a constant.
    (match (if map_has env "self" then map_get env "self" else VMain) with
     | VClass c ->
       let mq = (if map_has env m then (match map_get env m with VClass mc -> mc | _ -> resolve_scope_name c m) else resolve_scope_name c m) in
       let _ = map_set includes c (if map_has includes c then (map_get includes c) ++ "|" ++ mq else mq) in
       FNext VNil
     | _ -> FNext VNil)
  | SUndef names ->
    let (meths, sup, ocls, ivars) = world in
    // when self is a class (class_eval / a block run as a class body), undef
    // targets that class and raises NameError for a missing name.
    (match (if map_has env "self" then map_get env "self" else VMain) with
     | VClass c -> let _ = undef_check world c names in let _ = undef_all meths c names in FNext VNil
     | _ -> let _ = undef_top meths names in FNext VNil)
  | SVis (_, _) -> FNext VNil   // top-level visibility: no-op
  | SDoWhile (s2, cond) -> run_dowhile env world blk s2 cond
  | SAndThen (s1, s2) ->
    (match exec_stmt env world blk s1 with
     | FNext v -> if truthy v then exec_stmt env world blk s2 else FNext v
     | esc -> esc)
  | SOrElse (s1, s2) ->
    (match exec_stmt env world blk s1 with
     | FNext v -> if truthy v then FNext v else exec_stmt env world blk s2
     | esc -> esc)
  | SDeclare names ->
    let _ = declare_nils env names in FNext VNil
  | SRequire (rel, e) ->
    (match eval_e env world blk e with
     | VStr p0 -> let p0 = sget p0 in
       let p1 = if ends_with_rb p0 then p0 else p0 ++ ".rb" in
       let dir = (if map_has load_ctx "dir" then (match map_get load_ctx "dir" with VStr d -> let d = sget d in d | _ -> ".") else ".") in
       // require_relative: against the requiring file's dir; require: an
       // absolute path directly, else the $LOAD_PATH dirs, else the dir.
       let full = if str_len p1 > 0 && str_eq (char_at p1 0) "/" then p1
                  else if rel then dir ++ "/" ++ p1
                  else (let hit = load_path_find world p1 in
                        if str_eq hit "" then dir ++ "/" ++ p1 else hit) in
       if map_has loaded_files full then FNext (VBool false)
       else
         let _ = map_set loaded_files full VNil in
         let _ = (match (if map_has globals "LOADED_FEATURES" then map_get globals "LOADED_FEATURES" else VNil) with
                  | VArr lfid -> arr_set lfid (list_append (deref lfid) (Cons (mkstr full, Nil)))
                  | _ -> ()) in
         let src = read_file full in
         // the file's magic comment sets the script encoding for parse (a
         // parse-time __ENCODING__ capture) and while it runs; a file with no
         // magic comment is UTF-8 (per file, not inherited), as in Ruby.
         let savedc = (if map_has load_ctx "coding" then map_get load_ctx "coding" else mkstr "UTF-8") in
         let cod = src_coding src in
         let _ = map_set load_ctx "coding" (mkstr (if str_eq cod "" then "UTF-8" else cod)) in
         let toks = lex_go src 0 in
         let (prog2, rest2) = parse_stmts toks Nil in
         let _ = rx_check_pending () in
         let _ = (match rest2 with
                  | Cons (TEOF, _) -> ()
                  | _ -> fail ("mere-ruby: unexpected token at top level in " ++ full)) in
         // the required file runs with its own top-level locals but the
         // same world (classes/methods/consts/globals are shared).
         let fenv = map_new () in
         let _ = map_set fenv "self" VMain in
         let saved = (if map_has load_ctx "dir" then map_get load_ctx "dir" else mkstr ".") in
         let _ = map_set load_ctx "dir" (mkstr (dirname_of full)) in
         let noblk2 = (false, (Nil : str list), (Nil : Stmt list), fenv) in
         let f = run_stmts fenv world noblk2 prog2 in
         let _ = map_set load_ctx "dir" saved in
         let _ = map_set load_ctx "coding" savedc in
         (match f with
          | FRaise v -> FRaise v
          | _ -> FNext (VBool true))
     | _ -> FNext VNil)
  | SReturn e ->
    let v = eval_e env world blk e in
    // a bare `return` directly inside a Thread.new block cannot return across
    // the thread boundary — it raises LocalJumpError (catchable in the block).
    if (if map_has thread_flag "n" then (match map_get thread_flag "n" with VBool b -> b | _ -> false) else false)
    then (let _ = raise_exc world "LocalJumpError" "unexpected return" in FRaise VNil)
    else FReturn v
  | SBreak e -> FBreak (eval_e env world blk e)
  | SNext e -> FLoopNext (eval_e env world blk e)
  | SBegin (body, rescues, els, ens) -> run_begin env world blk body rescues els ens
  // reached only when nested (top-level BEGIN/END are handled by hoist_run):
  // a BEGIN inside a block/method is a SyntaxError; a nested END just runs.
  | SPreexe _ -> (let _ = raise_exc world "SyntaxError" "BEGIN is permitted only at toplevel" in FNext VNil)
  | SAtExit body -> run_stmts env world blk body
  | SLocalFrom (name, s) ->
    (match exec_stmt env world blk s with
     | FNext v -> let _ = map_set env name v in FNext v
     | other -> other)
  | SMultiAssign (targets, rhs) ->
    // build the value list: a single array RHS is destructured; several
    // values (or a single non-array) form the list.
    (match rhs with
     | Cons (ESplat inner, Nil) ->
       // `a, b = *x` — a splatted single RHS converts via #to_a.
       let rv = eval_e env world blk inner in
       let values = coerce_splat_rhs env world rv in
       let _ = assign_targets env world targets values in
       FNext (arr_new values)
     | Cons (single, Nil) ->
       let rv = eval_e env world blk single in
       let values = coerce_massign env world rv (has_splat targets && list_str_len targets == 1) in
       let _ = assign_targets env world targets values in
       FNext rv   // the statement's value is the RHS itself (nil stays falsy)
     | _ ->
       let values = eval_args env world blk rhs in
       let _ = assign_targets env world targets values in
       FNext (arr_new values))
  | SMultiAssignX (targets, rhs) ->
    // Ruby order: evaluate every LHS receiver (left to right) first, then the
    // RHS, then run the setters. Pre-evaluate receivers into temps so the RHS
    // and setters see them without re-evaluating (and re-running) the receiver.
    let pts = prep_x_targets env world blk targets in
    (match rhs with
     | Cons (ESplat inner, Nil) ->
       let rv = eval_e env world blk inner in
       let values = coerce_splat_rhs env world rv in
       let _ = assign_x_targets env world blk pts values in
       FNext (arr_new values)
     | Cons (single, Nil) ->
       let rv = eval_e env world blk single in
       let values = coerce_massign env world rv (xhas_splat targets && xlen targets == 1) in
       let _ = assign_x_targets env world blk pts values in
       FNext rv
     | _ ->
       let values = eval_args env world blk rhs in
       let _ = assign_x_targets env world blk pts values in
       FNext (arr_new values))

and run_begin = fn env -> fn world -> fn blk -> fn (body: Stmt list) -> fn rescues -> fn (els: Stmt list) -> fn (ens: Stmt list) ->
    let (meths, sup, ocls, ivars) = world in
    // $! before this construct; restored when it completes without unwinding.
    let prev_bang = (if map_has globals "!" then map_get globals "!" else VNil) in
    let caught = FRaise VNil in
    // run the body; a raise unwinds via fail and try_or yields `caught`.
    let result = try_or (fn (u: unit) -> run_stmts env world blk body) caught in
    // a flow signal (break/next/return crossing this begin) is NOT an
    // exception: remember it, run ensure, then keep unwinding.
    let flowk = (match result with
                 | FRaise _ ->
                   if map_has flow_sig "k" then (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") else ""
                 | _ -> "") in
    let flowv = (if str_eq flowk "" then VNil else (if map_has flow_sig "v" then map_get flow_sig "v" else VNil)) in
    let _ = if str_eq flowk "" then () else map_delete flow_sig "k" in
    // handle rescue / else, itself wrapped so a raise inside a handler
    // (or a re-raise past all rescues) still lets ensure run first.
    let outcome = try_or (fn (u: unit) ->
      (match result with
       | FRaise _ ->
         if str_eq flowk "" then
           let exc = (if map_has ivars "$exc" then map_get ivars "$exc"
                      else if map_has prim_missing "n" then VExc ("NoMethodError", "undefined method '" ++ (match map_get prim_missing "n" with VStr h -> sget h | _ -> "") ++ "'")
                      else VExc ("StandardError", "error")) in
           let _ = map_delete ivars "$exc" in
           let _ = if map_has prim_missing "n" then map_delete prim_missing "n" else () in
           run_rescues env world blk exc rescues
         else FRaise VNil   // flow pending — skip rescue
       | FReturn v -> FReturn v
       | FBreak v -> FBreak v
       | FLoopNext v -> FLoopNext v
       | FNext v -> (match els with Nil -> FNext v | _ -> run_stmts env world blk els))) caught in
    // ensure always runs; an escape (return/break/next) inside ensure
    // OVERRIDES the pending outcome and swallows a pending exception.
    // while an exception is still propagating through this begin (no rescue
    // caught it), `$!` holds the in-flight exception so a bare `raise` / `$!`
    // in the ensure block sees it.
    let _ = (match outcome with
             | FRaise _ -> if (if map_has flow_sig "k" then false else true) && map_has ivars "$exc" then map_set globals "!" (map_get ivars "$exc") else ()
             | _ -> ()) in
    let ensf = (match ens with Nil -> FNext VNil | _ -> run_stmts env world blk ens) in
    // a flow signal raised inside a rescue handler: retry re-runs the
    // whole begin; anything else (redo/break/...) keeps unwinding to the
    // enclosing loop/block after ensure has run.
    let hflowk = (match outcome with
                  | FRaise _ ->
                    if map_has flow_sig "k" then (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") else ""
                  | _ -> "") in
    let hflowv = (if str_eq hflowk "" then VNil else (if map_has flow_sig "v" then map_get flow_sig "v" else VNil)) in
    let _ = if str_eq hflowk "" then () else map_delete flow_sig "k" in
    (match ensf with
     | FNext _ ->
       if str_eq hflowk "retry" then run_begin env world blk body rescues els ens
       // a flow signal (throw/break/...) leaving a rescue handler ends the
       // exception handling: restore $! before unwinding.
       else if not (str_eq hflowk "") then (let _ = map_set globals "!" prev_bang in flow_rethrow hflowk hflowv)
       else if str_eq flowk "retry" then
         // retry NOT in a rescue handler is invalid (SyntaxError in Ruby).
         FRaise (raise_exc world "SyntaxError" "Invalid retry")
       else if str_eq flowk "" then
         (match outcome with
          | FRaise _ -> fail "mere-ruby: (exception propagates after ensure)"
          | other -> let _ = map_set globals "!" prev_bang in other)
       else flow_rethrow flowk flowv
     | esc -> esc)


and run_if = fn env -> fn world -> fn blk -> fn clauses -> fn (els: Stmt list) ->
  match clauses with
  | Nil -> run_stmts env world blk els
  | Cons (cl, rest) ->
    let (c, b) = cl in
    if truthy (eval_e env world blk c) then run_stmts env world blk b
    else run_if env world blk rest els

and run_while = fn env -> fn world -> fn blk -> fn (cond: Expr) -> fn (body: Stmt list) ->
  if truthy (eval_e env world blk cond) then
    let _ = tick () in
    (match while_body_flow env world blk body with
     | FReturn v -> FReturn v
     | FRaise v -> FRaise v
     | FBreak v -> FNext v          // break exits the loop with its value
     | FLoopNext _ -> run_while env world blk cond body   // next: skip to next iteration
     | FNext _ -> run_while env world blk cond body)
  else FNext VNil

// begin..end while/until: the body runs at least once INSIDE the loop
// context (so break/next/redo on the first pass behave correctly).
and run_dowhile = fn env -> fn world -> fn blk -> fn (s: Stmt) -> fn (cond: Expr) ->
  let _ = tick () in
  (match while_body_flow env world blk (Cons (s, Nil)) with
   | FReturn v -> FReturn v
   | FRaise v -> FRaise v
   | FBreak v -> FNext v
   | _ ->
     if truthy (eval_e env world blk cond) then run_dowhile env world blk s cond
     else FNext VNil)

// is there a `yield` that is NOT lexically inside a method definition?
// Ruby rejects that at parse time ("Invalid yield") — a class/module/singleton
// body, or a block not inside a def, is not a valid home for yield. We descend
// into everything EXCEPT def bodies (where yield is legal); a partial walk is
// safe (an unmatched form just isn't flagged, matching current behaviour).
and bare_yield_stmts = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (s, rest) -> bare_yield_stmt s || bare_yield_stmts rest

and bare_yield_stmt = fn (s: Stmt) ->
  match s with
  | SDef (_, _, _, _) -> false
  | SExpr e -> bare_yield_expr e
  | SAssign (_, e) -> bare_yield_expr e
  | SIVarAssign (_, e) -> bare_yield_expr e
  | SReturn e -> bare_yield_expr e
  | SClass (_, _, b) -> bare_yield_stmts b
  | SClassE (_, _, b) -> bare_yield_stmts b
  | SSingletonE (e, b) -> bare_yield_expr e || bare_yield_stmts b
  | SWhile (c, b) -> bare_yield_expr c || bare_yield_stmts b
  | SBegin (b, _, _, _) -> bare_yield_stmts b
  | SIf (clauses, els) -> bare_yield_clauses clauses || bare_yield_stmts els
  | _ -> false

and bare_yield_clauses = fn (clauses: (Expr * Stmt list) list) ->
  match clauses with
  | Nil -> false
  | Cons ((c, b), rest) -> bare_yield_expr c || bare_yield_stmts b || bare_yield_clauses rest

and bare_yield_expr = fn (e: Expr) ->
  match e with
  | EYield _ -> true
  | EMethodB (r, _, args, _, bb) -> bare_yield_expr r || bare_yield_exprs args || bare_yield_stmts bb
  | ECallB (_, args, _, bb) -> bare_yield_exprs args || bare_yield_stmts bb
  | EMethod (r, _, args) -> bare_yield_expr r || bare_yield_exprs args
  | ECall (_, args) -> bare_yield_exprs args
  | EBin (_, a, b) -> bare_yield_expr a || bare_yield_expr b
  | _ -> false

and bare_yield_exprs = fn (es: Expr list) ->
  match es with
  | Nil -> false
  | Cons (e, rest) -> bare_yield_expr e || bare_yield_exprs rest

// does any def/class body contain a directly-invalid retry/redo?
// (Ruby rejects them at parse time; blocks and loops are legal homes.)
and invalid_flow_in_defs = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SDef (_, _, _, b) -> direct_invalid_flow b || invalid_flow_in_defs rest
     | SClass (_, _, b) -> direct_invalid_flow b || invalid_flow_in_defs rest
     | SClassE (_, _, b) -> direct_invalid_flow b || invalid_flow_in_defs rest
     | _ -> invalid_flow_in_defs rest)

// `a = if ... end` where EVERY branch ends in `return` is Ruby's "void
// value expression" SyntaxError (a value-less if cannot be assigned).
and ends_in_return = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, Nil) -> (match st with SReturn _ -> true | _ -> false)
  | Cons (_, rest) -> ends_in_return rest

and all_branches_return = fn clauses ->
  match clauses with
  | Nil -> true
  | Cons ((_, b), rest) -> ends_in_return b && all_branches_return rest

and has_void_assign = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SLocalFrom (_, s2) ->
       (match s2 with
        | SIf (clauses, els) ->
          (match els with
           | Nil -> has_void_assign rest
           | _ -> (all_branches_return clauses && ends_in_return els) || has_void_assign rest)
        | _ -> has_void_assign rest)
     | SDef (_, _, _, b) -> has_void_assign b || has_void_assign rest
     | SClass (_, _, b) -> has_void_assign b || has_void_assign rest
     | SClassE (_, _, b) -> has_void_assign b || has_void_assign rest
     | _ -> has_void_assign rest)

and direct_invalid_flow = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (st, rest) ->
    (match st with
     | SExpr e ->
       (match e with
        | EFlow (k, _) -> str_eq k "retry" || str_eq k "redo"
        | _ -> false) || direct_invalid_flow rest
     // next / break / redo directly in a method body (not in a loop or
     // block) are a SyntaxError, like retry.
     | SNext _ -> true
     | SBreak _ -> true
     | _ -> direct_invalid_flow rest)

// run eval'd code; a bare retry signal surfacing here is Ruby's
// parse-time SyntaxError equivalent.
// Kernel#eval("code"[, binding]): parse and run, mapping parse failures to a
// catchable SyntaxError. Shared by the `eval(...)` call and `send(:eval,...)`.
and do_eval = fn env -> fn world -> fn blk -> fn (args: Val list) ->
  match args with
  | Cons (VStr code, rest) ->
    let codelbl = senc_get code in
    let code = sget code in
    let eenv = (match rest with Cons (VBind bid, _) -> map_get bind_store (str_of_int bid) | _ -> env) in
    let sentinel = Cons (SDeclare (Cons ("__syntax_error__", Nil)), Nil) in
    // the eval'd string's encoding (its magic comment, else its own label)
    // is the script encoding while parsing it (__ENCODING__ capture).
    let savedc = (if map_has load_ctx "coding" then map_get load_ctx "coding" else mkstr "UTF-8") in
    let cod = src_coding code in
    let _ = map_set load_ctx "coding" (mkstr (if str_eq cod "" then str_upcase codelbl else cod)) in
    let prog2 = try_or (fn (u: unit) ->
      let toks = lex_go code 0 in
      let (p2, _) = parse_stmts toks Nil in
      let _ = rx_check_pending () in p2) sentinel in
    let _ = map_set load_ctx "coding" savedc in
    (match prog2 with
     | Cons (SDeclare (Cons (m, Nil)), Nil) ->
       if str_eq m "__syntax_error__" then
         // Ruby's parser reports trailing junk after a complete statement as
         // an unexpected token; reproduce the common identifier case (e.g.
         // eval("1ir") lexes as `1 ir`).
         (let msg = try_or (fn (u: unit) ->
            let toks2 = lex_go code 0 in
            let (st1, rest1) = parse_stmt toks2 in
            (match skip_nls rest1 with
             | Cons (TId _, _) -> ": syntax error, unexpected local variable or method, expecting end-of-input"
             | _ -> "syntax error")) "syntax error" in
          raise_exc world "SyntaxError" msg)
       else if invalid_flow_in_defs prog2 then raise_exc world "SyntaxError" "Invalid retry"
       else if has_void_assign prog2 then raise_exc world "SyntaxError" "void value expression"
       else eval_run eenv world blk prog2
     | _ ->
       if invalid_flow_in_defs prog2 then raise_exc world "SyntaxError" "Invalid retry"
       else if bare_yield_stmts prog2 then raise_exc world "SyntaxError" "Invalid yield"
       else if numbered_misuse_stmts prog2 then raise_exc world "SyntaxError" "invalid numbered parameter"
       else if has_void_assign prog2 then raise_exc world "SyntaxError" "void value expression"
       else eval_run eenv world blk prog2)
  | _ -> fail "mere-ruby: eval expects a string"

and eval_run = fn env -> fn world -> fn blk -> fn (prog2: Stmt list) ->
  // Ruby hoists an eval'd string's local-variable assignments at parse time,
  // so a read that lexically precedes the assignment (or a nested eval sharing
  // the same binding) sees nil rather than a NameError.
  let _ = declare_nils env (body_targets prog2) in
  let f = try_or (fn (u: unit) -> hoist_run env world blk prog2) (FRaise VNil) in
  (match f with
   | FRaise _ ->
     if map_has flow_sig "k" then
       let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
       let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
       let _ = map_delete flow_sig "k" in
       if str_eq k "retry" then raise_exc world "SyntaxError" "Invalid retry"
       else let _ = flow_rethrow k v in VNil
     else fail "mere-ruby: (ruby exception raised)"
   | other -> flow_value other)

// park a flow kind+value and unwind via fail; a runner up the stack
// converts it back into a Flow (or a method return value).
and flow_throw = fn (kind: str) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr kind) in
  let _ = map_set flow_sig "v" v in
  fail "mere-ruby: (flow signal)"

and flow_rethrow_tagged = fn (kind: str) -> fn (tag: Val) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr kind) in
  let _ = map_set flow_sig "tag" tag in
  let _ = map_set flow_sig "v" v in
  fail "mere-ruby: (flow signal)"

and catch_tag_active = fn (t: Val) -> fn (d: int) ->
  if d <= 0 then false
  else if map_has catch_depth ("t" ++ str_of_int d) && rb_eq (map_get catch_depth ("t" ++ str_of_int d)) t then true
  else catch_tag_active t (d - 1)

and run_loop_builtin = fn env -> fn world -> fn blk -> fn theblk ->
  let _ = tick () in
  let f = try_or (fn (u: unit) -> run_block world blk theblk Nil) (FRaise VNil) in
  (match f with
   | FBreak v -> v
   | FRaise _ ->
     if map_has flow_sig "k" then
       let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
       let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
       let _ = map_delete flow_sig "k" in
       if str_eq k "break" then v else flow_throw k v
     else
       // a StopIteration ends the loop quietly; other exceptions re-raise.
       let (meths, sup, ocls, ivars) = world in
       let ecls = (if map_has ivars "$exc" then (match map_get ivars "$exc" with VExc (c, _) -> c | _ -> "") else "") in
       if str_eq ecls "StopIteration" then let _ = map_delete ivars "$exc" in VNil
       else fail "mere-ruby: (ruby exception raised)"
   | _ -> run_loop_builtin env world blk theblk)

// run a loop body once, converting flow signals; redo reruns the body
// without re-evaluating the loop condition.
and while_body_flow = fn env -> fn world -> fn blk -> fn (body: Stmt list) ->
  let f = try_or (fn (u: unit) -> run_stmts env world blk body) (FRaise VNil) in
  match f with
  | FRaise _ ->
    if map_has flow_sig "k" then
      let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
      let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
      let _ = map_delete flow_sig "k" in
      if str_eq k "break" then FBreak v
      else if str_eq k "next" then FLoopNext v
      else if str_eq k "redo" then let _ = tick () in while_body_flow env world blk body
      else if str_eq k "retry" then FRaise (raise_exc world "SyntaxError" "Invalid retry")
      else flow_rethrow k v
    else fail "mere-ruby: (ruby exception raised)"
  | other -> other

and flow_rethrow = fn (k: str) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr k) in
  let _ = map_set flow_sig "v" v in
  fail "mere-ruby: (flow signal)"

// evaluate a defined? receiver, returning a sentinel VSym on a genuine
// exception raise (so defined? answers nil), but RE-PROPAGATING a pending
// flow signal (throw/break/next/return) so `defined?(throw(:x).foo)` performs
// the throw normally instead of swallowing it.
and defined_eval_recv = fn env -> fn world -> fn blk -> fn (recv: Expr) ->
  let rv = try_or (fn (u: unit) -> eval_e env world blk recv) (VSym "__mere_defined_fail__") in
  // a pending flow signal (flow_sig still holds "k") means the receiver did a
  // throw/break/next; re-fail so it propagates instead of being swallowed.
  if (match rv with VSym m -> str_eq m "__mere_defined_fail__" | _ -> false) && map_has flow_sig "k"
  then fail "mere-ruby: (flow signal)"
  else rv

// a break unwinding to a specific method frame (its block's home). The nearest
// method_body_flow whose frame id matches returns v; others keep propagating.
and flow_throw_breakret = fn (fid: int) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr "breakret") in
  let _ = map_set flow_sig "fid" (VInt fid) in
  let _ = map_set flow_sig "v" v in
  fail "mere-ruby: (flow signal)"

// `return` from inside a block/proc unwinds to the block's defining frame
// (a method OR a lambda call), passing through any method that merely yielded.
and flow_throw_returnret = fn (fid: int) -> fn (v: Val) ->
  let _ = map_set flow_sig "k" (mkstr "returnret") in
  let _ = map_set flow_sig "fid" (VInt fid) in
  let _ = map_set flow_sig "v" v in
  fail "mere-ruby: (flow signal)"

// Ruby's `when` uses ===; for the value classes in this subset that is
// plain equality.
and run_case = fn env -> fn world -> fn blk -> fn (v: Val) -> fn whens -> fn (els: Stmt list) ->
  match whens with
  | Nil -> run_stmts env world blk els
  | Cons (w, rest) ->
    let (vs, b) = w in
    if when_matches env world blk v vs then run_stmts env world blk b
    else run_case env world blk v rest els

and when_matches = fn env -> fn world -> fn blk -> fn (v: Val) -> fn (vs: Expr list) ->
  match vs with
  | Nil -> false
  | Cons (e, t) ->
    (match e with
     | ESplat inner -> (match eval_e env world blk inner with VArr id -> when_any_eq v (deref id) | _ -> false)
     | _ -> case_eqq world (eval_e env world blk e) v)
    || when_matches env world blk v t

// Ruby's `===` as used by case/when: a Range tests membership, a Class tests
// is-a, anything else tests ==.
and case_eqq = fn world -> fn (cand: Val) -> fn (v: Val) ->
  match cand with
  | VObj oid ->
    // a user-defined === (called even when private, as case/when does)
    let (m2, s2, ocls2, iv2) = world in
    let ocl = map_get ocls2 (str_of_int oid) in
    if has_meth world ocl "===" then
      let frame0 = map_new () in
      let noblk0 = (false, (Nil : str list), (Nil : Stmt list), frame0) in
      truthy (invoke world noblk0 cand ocl "===" (Cons (v, Nil)))
    else rb_eq cand v
  | VRegex (p, pf) ->
    (match v with
     | VStr sv -> let sv = sget sv in (match rx_do_match world p pf sv with VNil -> false | _ -> true)
     | _ -> false)
  | VRange (lo, hi, excl) ->
    (match v with
     | VInt n -> n >= lo && (if excl then n < hi else n <= hi)
     // a Time value tests membership by its ordinal (Time ranges are stored as
     // ordinal ranges), so `(t1..t2) === t` works.
     | VObj id -> let (m2, s2, ocls2, iv2) = world in
       (if str_eq (map_get ocls2 (str_of_int id)) "Time" then (let n = time_ord_of world v in n >= lo && (if excl then n < hi else n <= hi)) else false)
     | _ -> false)
  | VClass c -> (match v with VObj id -> let (m, s, ocls, iv) = world in obj_is_a world (map_get ocls (str_of_int id)) c | _ -> obj_is_a world (class_name v) c)
  | _ -> rb_eq cand v

and when_any_eq = fn (v: Val) -> fn (xs: Val list) ->
  match xs with Nil -> false | Cons (h, t) -> rb_eq h v || when_any_eq v t

// `cand === v` as used by value/pin patterns: a proc/lambda calls itself, a
// class consults an active singleton-#=== refinement, otherwise case_eqq.
and match_eqq = fn env -> fn world -> fn blk -> fn (cand: Val) -> fn (v: Val) ->
  match cand with
  | VProc _ -> truthy (invoke_val_c env world blk cand "===" (Cons (v, Nil)) false)
  | VClass c ->
    let sk = "(sng:" ++ c ++ ")" in
    if map_has ref_active sk && has_meth world (ref_impl sk) "===" then
      truthy (invoke world (false, (Nil : str list), (Nil : Stmt list), env) cand (ref_impl sk) "===" (Cons (v, Nil)))
    else case_eqq world cand v
  | _ -> case_eqq world cand v

// the active refinement impl class for a target ("" if none/not a string).
and ref_impl = fn (target: str) ->
  if map_has ref_active target then (match map_get ref_active target with VStr h -> sget h | _ -> "") else ""

// ---- pattern matching (case/in) -----------------------------------------
and run_case_in = fn env -> fn world -> fn blk -> fn (v: Val) -> fn clauses -> fn (has_else: bool) -> fn (els: Stmt list) ->
  match clauses with
  | Nil ->
    if has_else then run_stmts env world blk els
    else let _ = raise_exc world "NoMatchingPatternError" (inspect v) in FNext VNil
  | Cons (cl, rest) ->
    let (pat, guard, body) = cl in
    // the guard is only evaluated when the pattern matched (&& short-circuits).
    if pat_match env world blk pat v && truthy (eval_e env world blk guard)
    then run_stmts env world blk body
    else run_case_in env world blk v rest has_else els

// match a value against a pattern, binding variables into env as a side
// effect. Bindings made before a later sub-pattern fails are left in place
// (matching Ruby, which does not roll them back).
and pat_match = fn env -> fn world -> fn blk -> fn (p: Pat) -> fn (v: Val) ->
  match p with
  | PVar nm -> let _ = map_set env nm v in true
  | PVal e -> match_eqq env world blk (eval_e env world blk e) v
  // a pin `^expr` matches via `expr === value` (so ^(/re/), ^(range), ^Class
  // work), matching Ruby.
  | PPin e -> match_eqq env world blk (eval_e env world blk e) v
  | PAltP alts -> pat_match_any env world blk alts v
  | PAsP (sub, nm) -> if pat_match env world blk sub v then (let _ = map_set env nm v in true) else false
  | PArrP elems -> pat_match_array env world blk elems v
  | PHashP (items, rest) -> pat_match_hash env world blk items rest v
  | PConstP (ce, inner) ->
    let cls = eval_e env world blk ce in
    if case_eqq world cls v then pat_match env world blk inner v else false
  | PSplatP _ -> true

and pat_match_any = fn env -> fn world -> fn blk -> fn (alts: Pat list) -> fn (v: Val) ->
  match alts with
  | Nil -> false
  | Cons (a, rest) -> if pat_match env world blk a v then true else pat_match_any env world blk rest v

and pat_match_array = fn env -> fn world -> fn blk -> fn (elems: Pat list) -> fn (v: Val) ->
  let (ok, xs) = deconstruct_of env world blk v in
  if ok then
    let ns = count_splats elems in
    if ns == 0 then
      (if val_list_len xs == pat_list_len elems then match_seq env world blk elems xs else false)
    else if ns == 1 then match_one_splat env world blk elems xs
    else match_find env world blk elems xs
  else false

// deconstruct a value into a Val list for an array pattern. Real arrays are
// used directly; a VObj must define #deconstruct returning an Array.
and deconstruct_of = fn env -> fn world -> fn blk -> fn (v: Val) ->
  match v with
  | VArr id ->
    let hk = hng_key v in
    // a singleton #deconstruct (def arr.deconstruct) or an active Array
    // refinement is used in preference to the array's own elements; otherwise
    // the elements are the deconstruction (Array#deconstruct returns self).
    if (if str_eq hk "" then false else map_has hng_store hk) && has_meth world (map_get hng_store hk) "deconstruct" then
      call_deco env world blk v (map_get hng_store hk)
    else if map_has ref_active "Array" && has_meth world (ref_impl "Array") "deconstruct" then
      call_deco env world blk v (ref_impl "Array")
    else (true, deref id)
  | VObj oid ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls (str_of_int oid) in
    if has_meth world cls "deconstruct" then call_deco env world blk v cls
    else (false, (Nil : Val list))
  | _ -> (false, (Nil : Val list))

// invoke recv.deconstruct on class `cls`, memoised per case; the result must be
// an Array (else TypeError). Returns (ok, elements).
and call_deco = fn env -> fn world -> fn blk -> fn (v: Val) -> fn (cls: str) ->
  let mk = "d:" ++ hng_key v ++ (match v with VObj oid -> "obj:" ++ str_of_int oid | _ -> "") in
  if map_has deco_memo mk then (match map_get deco_memo mk with VArr id2 -> (true, deref id2) | _ -> (false, (Nil : Val list)))
  else
    (match invoke world (false, (Nil : str list), (Nil : Stmt list), env) v cls "deconstruct" Nil with
     | VArr id2 -> let _ = map_set deco_memo mk (VArr id2) in (true, deref id2)
     | _ -> let _ = raise_exc world "TypeError" (class_name v ++ "#deconstruct must return Array") in (false, (Nil : Val list)))

and count_splats = fn (ps: Pat list) ->
  match ps with Nil -> 0 | Cons (p, r) -> (match p with PSplatP _ -> 1 | _ -> 0) + count_splats r

and pat_list_len = fn (ps: Pat list) ->
  match ps with Nil -> 0 | Cons (_, r) -> 1 + pat_list_len r

// match each pattern against each value, in order, requiring equal length.
and match_seq = fn env -> fn world -> fn blk -> fn (ps: Pat list) -> fn (xs: Val list) ->
  match ps with
  | Nil -> (match xs with Nil -> true | _ -> false)
  | Cons (p, pr) ->
    (match xs with
     | Nil -> false
     | Cons (x, xr) -> if pat_match env world blk p x then match_seq env world blk pr xr else false)

// [pre..., *rest, post...] — one splat. pre/post match the ends; rest binds
// the middle slice as an Array.
and match_one_splat = fn env -> fn world -> fn blk -> fn (elems: Pat list) -> fn (xs: Val list) ->
  let (pre, splatname, post) = split_at_splat elems (Nil : Pat list) in
  let np = pat_list_len pre in
  let nq = pat_list_len post in
  let n = val_list_len xs in
  if n < np + nq then false
  else
    let prexs = val_take xs np in
    let midxs = val_slice xs np (n - nq) in
    let postxs = val_drop xs (n - nq) in
    if match_seq env world blk pre prexs && match_seq env world blk post postxs then
      let _ = if str_eq splatname "" then () else map_set env splatname (arr_new midxs) in true
    else false

// split an element list around its (single) splat: (pre, name, post).
and split_at_splat = fn (elems: Pat list) -> fn (pre: Pat list) ->
  match elems with
  | Nil -> (rev_pats pre, "", (Nil : Pat list))
  | Cons (p, r) ->
    (match p with
     | PSplatP nm -> (rev_pats pre, nm, r)
     | _ -> split_at_splat r (Cons (p, pre)))

and rev_pats = fn (ps: Pat list) -> rev_pats_go ps (Nil : Pat list)
and rev_pats_go = fn (ps: Pat list) -> fn (acc: Pat list) ->
  match ps with Nil -> acc | Cons (p, r) -> rev_pats_go r (Cons (p, acc))

// find pattern [*pre, mid..., *post]: locate the leftmost window matching the
// fixed middle; bind pre/post splats to the surrounding slices.
and match_find = fn env -> fn world -> fn blk -> fn (elems: Pat list) -> fn (xs: Val list) ->
  let preName = splat_name_of (pat_head elems) in
  let mids = pat_middle elems in
  let postName = splat_name_of (pat_last elems) in
  let midlen = pat_list_len mids in
  let n = val_list_len xs in
  find_window env world blk mids midlen xs n 0 preName postName

and find_window = fn env -> fn world -> fn blk -> fn (mids: Pat list) -> fn (midlen: int) -> fn (xs: Val list) -> fn (n: int) -> fn (start: int) -> fn (preName: str) -> fn (postName: str) ->
  if start + midlen > n then false
  else
    let window = val_slice xs start (start + midlen) in
    if match_seq env world blk mids window then
      let _ = if str_eq preName "" then () else map_set env preName (arr_new (val_take xs start)) in
      let _ = if str_eq postName "" then () else map_set env postName (arr_new (val_drop xs (start + midlen))) in
      true
    else find_window env world blk mids midlen xs n (start + 1) preName postName

and splat_name_of = fn (p: Pat) -> match p with PSplatP nm -> nm | _ -> ""
and pat_head = fn (ps: Pat list) -> match ps with Cons (p, _) -> p | Nil -> PSplatP ""
and pat_last = fn (ps: Pat list) -> match ps with Nil -> PSplatP "" | Cons (p, Nil) -> p | Cons (_, r) -> pat_last r
// the elements strictly between the first and last.
and pat_middle = fn (ps: Pat list) ->
  match ps with
  | Nil -> Nil
  | Cons (_, r) -> pat_drop_last r
and pat_drop_last = fn (ps: Pat list) ->
  match ps with
  | Nil -> Nil
  | Cons (_, Nil) -> Nil
  | Cons (p, r) -> Cons (p, pat_drop_last r)

// ---- Val-list slicing helpers -------------------------------------------
and val_take = fn (xs: Val list) -> fn (k: int) ->
  if k <= 0 then (Nil : Val list)
  else (match xs with Nil -> Nil | Cons (h, t) -> Cons (h, val_take t (k - 1)))
and val_drop = fn (xs: Val list) -> fn (k: int) ->
  if k <= 0 then xs
  else (match xs with Nil -> Nil | Cons (_, t) -> val_drop t (k - 1))
and val_slice = fn (xs: Val list) -> fn (lo: int) -> fn (hi: int) ->
  val_take (val_drop xs lo) (hi - lo)

// ---- hash patterns -------------------------------------------------------
and pat_match_hash = fn env -> fn world -> fn blk -> fn (items: (str * Pat) list) -> fn (rest: str) -> fn (v: Val) ->
  let (ok, pairs) = deconstruct_keys_of env world blk v items rest in
  if ok then
    // `{}` (no keys, no rest) matches only an empty hash.
    if (match items with Nil -> true | _ -> false) && str_eq rest "" then val_list_len pairs == 0
    else if match_hash_items env world blk items pairs then
      (if str_eq rest "nil" then hash_only_keys pairs items
       else if str_eq rest "" || str_eq rest "*" then true
       else let _ = map_set env rest (hash_without pairs items) in true)
    else false
  else false

and deconstruct_keys_of = fn env -> fn world -> fn blk -> fn (v: Val) -> fn (items: (str * Pat) list) -> fn (rest: str) ->
  match v with
  | VHsh id ->
    if map_has ref_active "Hash" && has_meth world (ref_impl "Hash") "deconstruct_keys" then
      (match invoke world (false, (Nil : str list), (Nil : Stmt list), env) v (ref_impl "Hash") "deconstruct_keys" (Cons (VNil, Nil)) with
       | VHsh id2 -> (true, hderef id2)
       | _ -> let _ = raise_exc world "TypeError" (class_name v ++ "#deconstruct_keys must return Hash") in (false, (Nil : Val list)))
    else (true, hderef id)
  | VObj oid ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls (str_of_int oid) in
    if has_meth world cls "deconstruct_keys" then
      // Ruby passes the list of requested keys, or nil when a **rest binding is
      // present (the method may then need every key).
      let named_rest = if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then false else true in
      let karg = if named_rest then VNil else arr_new (hash_key_syms items) in
      (match invoke_val_c env world blk v "deconstruct_keys" (Cons (karg, Nil)) false with
       | VHsh id2 -> (true, hderef id2)
       | _ -> let _ = raise_exc world "TypeError" (class_name v ++ "#deconstruct_keys must return Hash") in (false, (Nil : Val list)))
    else (false, (Nil : Val list))
  | _ -> (false, (Nil : Val list))

and hash_key_syms = fn (items: (str * Pat) list) ->
  match items with Nil -> Nil | Cons (kp, r) -> let (k, _) = kp in Cons (VSym k, hash_key_syms r)

and match_hash_items = fn env -> fn world -> fn blk -> fn (items: (str * Pat) list) -> fn (pairs: Val list) ->
  match items with
  | Nil -> true
  | Cons (kp, rest) ->
    let (k, sub) = kp in
    let (found, hv) = hash_lookup pairs (VSym k) in
    if found then (if pat_match env world blk sub hv then match_hash_items env world blk rest pairs else false)
    else false

// scan interleaved [k1,v1,k2,v2,...] for a key equal to target.
and hash_lookup = fn (pairs: Val list) -> fn (target: Val) ->
  match pairs with
  | Nil -> (false, VNil)
  | Cons (k, Cons (v, rest)) -> if rb_eq k target then (true, v) else hash_lookup rest target
  | _ -> (false, VNil)

// every key in the hash is one of the pattern keys (for **nil).
and hash_only_keys = fn (pairs: Val list) -> fn (items: (str * Pat) list) ->
  match pairs with
  | Nil -> true
  | Cons (k, Cons (_, rest)) -> if item_has_key items k then hash_only_keys rest items else false
  | _ -> true

and item_has_key = fn (items: (str * Pat) list) -> fn (k: Val) ->
  match items with Nil -> false | Cons (kp, r) -> let (nm, _) = kp in (rb_eq (VSym nm) k) || item_has_key r k

// a fresh hash of the pairs whose keys are NOT named in the pattern (**rest).
and hash_without = fn (pairs: Val list) -> fn (items: (str * Pat) list) ->
  mkhash (hash_without_go pairs items)
and hash_without_go = fn (pairs: Val list) -> fn (items: (str * Pat) list) ->
  match pairs with
  | Cons (k, Cons (v, rest)) -> if item_has_key items k then hash_without_go rest items else Cons (k, Cons (v, hash_without_go rest items))
  | _ -> Nil

// collect the pattern variables bound across all clauses (declared as nil at
// entry, matching Ruby's parse-time hoisting).
and clauses_pat_vars = fn clauses ->
  match clauses with
  | Nil -> Nil
  | Cons (cl, rest) -> let (p, g, b) = cl in list_append_str (pat_vars p) (clauses_pat_vars rest)

and pat_vars = fn (p: Pat) ->
  match p with
  | PVar nm -> Cons (nm, Nil)
  | PVal _ -> Nil
  | PPin _ -> Nil
  | PSplatP nm -> if str_eq nm "" then Nil else Cons (nm, Nil)
  | PArrP elems -> pats_vars elems
  | PHashP (items, rest) ->
    let base = hash_items_vars items in
    if str_eq rest "" || str_eq rest "nil" || str_eq rest "*" then base else Cons (rest, base)
  | PAltP alts -> pats_vars alts
  | PAsP (sub, nm) -> Cons (nm, pat_vars sub)
  | PConstP (_, inner) -> pat_vars inner

and pats_vars = fn (ps: Pat list) ->
  match ps with Nil -> Nil | Cons (p, r) -> list_append_str (pat_vars p) (pats_vars r)

and hash_items_vars = fn (items: (str * Pat) list) ->
  match items with Nil -> Nil | Cons (kp, r) -> let (k, sub) = kp in list_append_str (pat_vars sub) (hash_items_vars r)

and clausesin_targets = fn clauses ->
  match clauses with
  | Nil -> Nil
  | Cons (cl, rest) -> let (p, g, b) = cl in list_append_str (deep_targets b) (clausesin_targets rest)

// ---- regex pattern parser (compiled engine) -------------------------------
// Parses a Ruby regex body into RNode (types near Flow). Flags are resolved
// here: i -> NCharCI / class ci, m -> NAnyNL, x -> whitespace + #-comments
// skipped. Unsupported constructs `fail`; during the migration the caller
// falls back to the legacy matcher below.

and rxp_parse = fn (pat: str) -> fn (fl: str) ->
  let (n, p, g) = rxp_alt pat 0 fl 1 in
  if p < str_len pat then fail "mere-ruby: regexp parse: unmatched )" else n

// number of capture groups in a parsed pattern (next-gnum - 1 from a reparse
// is avoided: count NGroup nodes with gnum > 0).
and rxp_ngroups = fn (n: RNode) ->
  match n with
  | NSeq xs -> rxp_ngroups_list xs
  | NAlt xs -> rxp_ngroups_list xs
  | NRep (b, _, _, _) -> rxp_ngroups b
  | NGroup (b, gn, _) -> (if gn > 0 then 1 else 0) + rxp_ngroups b
  | NLook (b, _) -> rxp_ngroups b
  | NLookB (b, _) -> rxp_ngroups b
  | _ -> 0
and rxp_ngroups_list = fn (xs: RNode list) ->
  match xs with Nil -> 0 | Cons (h, t) -> rxp_ngroups h + rxp_ngroups_list t

// alternation: seq ('|' seq)*
and rxp_alt = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) ->
  let (first, p2, g2) = rxp_seq pat p fl g in
  rxp_alt_more pat p2 fl g2 (Cons (first, Nil))
and rxp_alt_more = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) -> fn (acc: RNode list) ->
  if p < str_len pat && str_eq (char_at pat p) "|" then
    let (n, p2, g2) = rxp_seq pat (p + 1) fl g in
    rxp_alt_more pat p2 fl g2 (Cons (n, acc))
  else
    (match acc with
     | Cons (only, Nil) -> (only, p, g)
     | _ -> (NAlt (rev_app acc Nil), p, g))

// sequence: atoms (each with an optional quantifier) until '|' / ')' / end.
and rxp_seq = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) ->
  rxp_seq_go pat p fl g Nil
and rxp_seq_go = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) -> fn (acc: RNode list) ->
  let p = (if str_contains fl "x" then rxp_skip_x pat p else p) in
  if p >= str_len pat || str_eq (char_at pat p) "|" || str_eq (char_at pat p) ")" then
    (match acc with
     | Nil -> (NEmpty, p, g)
     | Cons (only, Nil) -> (only, p, g)
     | _ -> (NSeq (rev_app acc Nil), p, g))
  else
    let (atom, p2, g2) = rxp_atom pat p fl g in
    (match atom with
     // `(?im)` applies to the rest of the sequence (approximation of Ruby's
     // to-end-of-enclosing-group scope).
     | NFlagsRest fl2 ->
       let (restn, p3, g3) = rxp_seq_go pat p2 fl2 g2 Nil in
       (match acc with
        | Nil -> (restn, p3, g3)
        | _ -> (NSeq (rev_app acc (Cons (restn, Nil))), p3, g3))
     | _ ->
       let (q, p3) = rxp_quant pat atom p2 fl in
       rxp_seq_go pat p3 fl g2 (Cons (q, acc)))

// x-flag: skip whitespace and #-comments (a `\ ` escaped space stays literal).
and rxp_skip_x = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c " " || str_eq c "\t" || str_eq c "\n" then rxp_skip_x pat (p + 1)
    else if str_eq c "#" then rxp_skip_x pat (rxp_line_end pat p)
    else p
and rxp_line_end = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else if str_eq (char_at pat p) "\n" then p + 1
  else rxp_line_end pat (p + 1)

// quantifiers after an atom: * + ? {n,m}, each optionally lazy (?). Nested
// quantifiers stack (/a***/ = ((a*)*)*); after an EXACT {n} a `?` is another
// quantifier, not a lazy marker (/a{2}?/ = (a{2})?).
and rxp_quant = fn (pat: str) -> fn (atom: RNode) -> fn (p: int) -> fn (fl: str) ->
  // x-mode: a quantifier may be separated from its atom by whitespace.
  let p = (if str_contains fl "x" then rxp_skip_x pat p else p) in
  if p >= str_len pat then (atom, p)
  else
    let c = char_at pat p in
    if str_eq c "*" then (let (n2, p2) = rxp_lazy pat atom 0 (0 - 1) (p + 1) fl in rxp_quant pat n2 p2 fl)
    else if str_eq c "+" then (let (n2, p2) = rxp_lazy pat atom 1 (0 - 1) (p + 1) fl in rxp_quant pat n2 p2 fl)
    else if str_eq c "?" then (let (n2, p2) = rxp_lazy pat atom 0 1 (p + 1) fl in rxp_quant pat n2 p2 fl)
    else if str_eq c "\{" then
      (let (found, lo, hi, p2) = rxp_braces pat (p + 1) in
       if found then
         (if lo == hi then rxp_quant pat (NRep (atom, lo, hi, true)) p2 fl
          else (let (n2, p3) = rxp_lazy pat atom lo hi p2 fl in rxp_quant pat n2 p3 fl))
       else (atom, p))
    else (atom, p)
and rxp_lazy = fn (pat: str) -> fn (atom: RNode) -> fn (lo: int) -> fn (hi: int) -> fn (p: int) -> fn (fl: str) ->
  let p = (if str_contains fl "x" then rxp_skip_x pat p else p) in
  if p < str_len pat && str_eq (char_at pat p) "?" then (NRep (atom, lo, hi, false), p + 1)
  else if p < str_len pat && str_eq (char_at pat p) "+" then
    (if map_has rx_lenient "n" then (NRep (atom, lo, hi, true), p + 1) else fail "mere-ruby: regexp: possessive quantifier unsupported")
  else (NRep (atom, lo, hi, true), p)

// {n} {n,} {n,m} {,m}; a brace that is not a quantifier stays a literal.
and rxp_braces = fn (pat: str) -> fn (p: int) ->
  let (lo, p2, ok1) = rxp_num pat p 0 false in
  if p2 < str_len pat && str_eq (char_at pat p2) "," then
    (let (hi, p3, ok2) = rxp_num pat (p2 + 1) 0 false in
     if p3 < str_len pat && str_eq (char_at pat p3) "}" && (ok1 || ok2) then
       (let lo2 = (if ok1 then lo else 0) in
        let hi2 = (if ok2 then hi else (0 - 1)) in
        let _ = (if (lo2 > 1000 || hi2 > 1000) && (if map_has rx_lenient "n" then false else true) then fail "mere-ruby: regexp: quantifier too large" else ()) in
        let _ = (if ok2 && lo2 > hi2 then fail "mere-ruby: regexp: bad repeat range" else ()) in
        (true, lo2, hi2, p3 + 1))
     else (false, 0, 0, p))
  else if p2 < str_len pat && str_eq (char_at pat p2) "}" && ok1 then
    (let _ = (if lo > 1000 && (if map_has rx_lenient "n" then false else true) then fail "mere-ruby: regexp: quantifier too large" else ()) in
     (true, lo, lo, p2 + 1))
  else (false, 0, 0, p)
and rxp_num = fn (pat: str) -> fn (p: int) -> fn (acc: int) -> fn (found: bool) ->
  if p < str_len pat && char_at pat p >= "0" && char_at pat p <= "9" then
    rxp_num pat (p + 1) (acc * 10 + int_of_str (char_at pat p)) true
  else (acc, p, found)

// a single atom: group, class, ., anchors, escape, or a literal byte.
and rxp_atom = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) ->
  let c = char_at pat p in
  if str_eq c "(" then rxp_group pat (p + 1) fl g
  else if str_eq c "[" then
    (let (items, neg, p2) = rxp_class pat (p + 1) in
     (NClass (items, neg, str_contains fl "i"), p2, g))
  else if str_eq c "." then ((if str_contains fl "m" then NAnyNL else NAny), p + 1, g)
  else if str_eq c "^" then (NBOL, p + 1, g)
  else if str_eq c "$" then (NEOL, p + 1, g)
  else if str_eq c "\\" then rxp_escape pat (p + 1) fl g
  else if str_eq c "*" || str_eq c "+" || str_eq c "?" then fail "mere-ruby: regexp: nothing to repeat"
  else ((if str_contains fl "i" && is_alpha c then NCharCI c else NChar c), p + 1, g)

and rxp_escape = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) ->
  if p >= str_len pat then fail "mere-ruby: regexp: trailing backslash"
  else
    let c = char_at pat p in
    if str_eq c "d" then (NClass (Cons (CDigit, Nil), false, false), p + 1, g)
    else if str_eq c "D" then (NClass (Cons (CDigit, Nil), true, false), p + 1, g)
    else if str_eq c "w" then (NClass (Cons (CWord, Nil), false, false), p + 1, g)
    else if str_eq c "W" then (NClass (Cons (CWord, Nil), true, false), p + 1, g)
    else if str_eq c "s" then (NClass (Cons (CSpace, Nil), false, false), p + 1, g)
    else if str_eq c "S" then (NClass (Cons (CSpace, Nil), true, false), p + 1, g)
    else if str_eq c "h" then (NClass (Cons (CHex, Nil), false, false), p + 1, g)
    else if str_eq c "H" then (NClass (Cons (CHex, Nil), true, false), p + 1, g)
    else if str_eq c "b" then (NWordB true, p + 1, g)
    else if str_eq c "B" then (NWordB false, p + 1, g)
    else if str_eq c "A" then (NBOS, p + 1, g)
    else if str_eq c "z" then (NEOS, p + 1, g)
    else if str_eq c "Z" then (NEOSNL, p + 1, g)
    else if str_eq c "n" then (NChar "\n", p + 1, g)
    else if str_eq c "t" then (NChar "\t", p + 1, g)
    else if str_eq c "r" then (NChar "\r", p + 1, g)
    else if str_eq c "f" then (NChar (chr 12), p + 1, g)
    else if str_eq c "v" then (NChar (chr 11), p + 1, g)
    else if str_eq c "e" then (NChar (chr 27), p + 1, g)
    else if str_eq c "a" then (NChar (chr 7), p + 1, g)
    else if str_eq c "x" then rxp_hex pat (p + 1) g
    else if c >= "1" && c <= "9" then (NBackref (int_of_str c, str_contains fl "i"), p + 1, g)
    // \cX / \C-X control escapes: the char's code masked to the control range.
    else if str_eq c "c" then
      (if p + 1 < str_len pat then (NChar (chr (rxp_ord (char_at pat (p + 1)) - (rxp_ord (char_at pat (p + 1)) / 32) * 32)), p + 2, g)
       else fail "mere-ruby: regexp parse: bad \\c")
    else if str_eq c "C" then
      (if p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "-" then
         (NChar (chr (rxp_ord (char_at pat (p + 2)) - (rxp_ord (char_at pat (p + 2)) / 32) * 32)), p + 3, g)
       else fail "mere-ruby: regexp parse: bad \\C-")
    // \0nn octal escape (up to two more octal digits).
    else if str_eq c "0" then rxp_oct pat (p + 1) g 0 2
    // \R: a line break (\r\n or a single line-break char).
    else if str_eq c "R" then
      (NGroup (NAlt (Cons (NSeq (Cons (NChar "\r", Cons (NChar "\n", Nil))),
                           Cons (NClass (Cons (CChr "\n", Cons (CChr "\r", Cons (CChr (chr 11), Cons (CChr (chr 12), Nil)))), false, false), Nil))), 0, ""),
       p + 1, g)
    else if str_eq c "G" || str_eq c "k" || str_eq c "g" || str_eq c "p" ||
            str_eq c "K" || str_eq c "X" || str_eq c "u" then
      (if map_has rx_lenient "n" then (NEmpty, p + 1, g) else fail "mere-ruby: regexp: unsupported escape")
    else ((if str_contains fl "i" && is_alpha c then NCharCI c else NChar c), p + 1, g)

// byte ordinal (parse-time only; compiled programs are cached).
and rxp_ord = fn (c: str) -> rxp_ord_go c 0
and rxp_ord_go = fn (c: str) -> fn (n: int) ->
  if n > 255 then 0 else if str_eq (chr n) c then n else rxp_ord_go c (n + 1)

// \0[oo]: octal char escape.
and rxp_oct = fn (pat: str) -> fn (p: int) -> fn (g: int) -> fn (acc: int) -> fn (k: int) ->
  if k > 0 && p < str_len pat && char_at pat p >= "0" && char_at pat p <= "7" then
    rxp_oct pat (p + 1) g (acc * 8 + int_of_str (char_at pat p)) (k - 1)
  else (NChar (chr acc), p, g)

and rxp_hexv = fn (c: str) ->
  if (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F") then str_to_int_base c 16
  else 0 - 1
and rxp_hex = fn (pat: str) -> fn (p: int) -> fn (g: int) ->
  if p >= str_len pat || rxp_hexv (char_at pat p) < 0 then fail "mere-ruby: regexp: bad \\x"
  else
    let h1 = rxp_hexv (char_at pat p) in
    if p + 1 < str_len pat && rxp_hexv (char_at pat (p + 1)) >= 0 then
      (NChar (chr (h1 * 16 + rxp_hexv (char_at pat (p + 1)))), p + 2, g)
    else (NChar (chr h1), p + 1, g)

// group forms: (...) (?:...) (?<name>...) (?'name'...) (?=...) (?!...)
// (?<=...) (?<!...) (?imx-imx:...) (?imx-imx).
and rxp_group = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (g: int) ->
  if p < str_len pat && str_eq (char_at pat p) "?" then
    (let c2 = (if p + 1 < str_len pat then char_at pat (p + 1) else "") in
     if str_eq c2 ":" then
       (let (n, p2, g2) = rxp_alt pat (p + 2) fl g in
        (NGroup (n, 0, ""), rxp_close pat p2, g2))
     else if str_eq c2 "=" then
       (let (n, p2, g2) = rxp_alt pat (p + 2) fl g in
        (NLook (n, false), rxp_close pat p2, g2))
     else if str_eq c2 "!" then
       (let (n, p2, g2) = rxp_alt pat (p + 2) fl g in
        (NLook (n, true), rxp_close pat p2, g2))
     else if str_eq c2 "<" then
       (let c3 = (if p + 2 < str_len pat then char_at pat (p + 2) else "") in
        if str_eq c3 "=" then
          (let (n, p2, g2) = rxp_alt pat (p + 3) fl g in
           (NLookB (n, false), rxp_close pat p2, g2))
        else if str_eq c3 "!" then
          (let (n, p2, g2) = rxp_alt pat (p + 3) fl g in
           (NLookB (n, true), rxp_close pat p2, g2))
        else
          (let (nm, p2) = rxp_name pat (p + 2) ">" "" in
           let _ = rxp_name_check nm in
           let (n, p3, g2) = rxp_alt pat p2 fl (g + 1) in
           (NGroup (n, g, nm), rxp_close pat p3, g2)))
     else if str_eq c2 "'" then
       (let (nm, p2) = rxp_name pat (p + 2) "'" "" in
        let _ = rxp_name_check nm in
        let (n, p3, g2) = rxp_alt pat p2 fl (g + 1) in
        (NGroup (n, g, nm), rxp_close pat p3, g2))
     // (?(cond)...) conditional, (?>...) atomic, (?~...) absent: valid Ruby
     // that this engine defers — lenient validation skips the balanced group.
     else if str_eq c2 "(" || str_eq c2 ">" || str_eq c2 "~" || str_eq c2 "#" then
       (if str_eq c2 "#" then (NEmpty, rxp_skip_group pat p 1, g)   // (?# comment) is fully supported by skipping
        else if map_has rx_lenient "n" then (NEmpty, rxp_skip_group pat p 1, g)
        else fail "mere-ruby: regexp: unsupported group")
     else
       // (?imx-imx:...) scoped or (?imx-imx) rest-of-sequence flags.
       let (fl2, p2, colon) = rxp_flags pat (p + 1) fl "" false in
       if colon then
         (let (n, p3, g2) = rxp_alt pat p2 fl2 g in
          (NGroup (n, 0, ""), rxp_close pat p3, g2))
       else (NFlagsRest fl2, p2, g))
  else
    let (n, p2, g2) = rxp_alt pat p fl (g + 1) in
    (NGroup (n, g, ""), rxp_close pat p2, g2)

// read [imx]*(-[imx]*)? up to ':' (scoped) or ')' (rest). `neg` = after '-'.
and rxp_flags = fn (pat: str) -> fn (p: int) -> fn (fl: str) -> fn (seen: str) -> fn (neg: bool) ->
  if p >= str_len pat then fail "mere-ruby: regexp: unterminated (?flags"
  else
    let c = char_at pat p in
    if str_eq c ":" then (fl, p + 1, true)
    else if str_eq c ")" then (fl, p + 1, false)
    else if str_eq c "-" then (if neg then fail "mere-ruby: regexp: bad flags" else rxp_flags pat (p + 1) fl seen true)
    else if str_eq c "i" || str_eq c "m" || str_eq c "x" then
      (let fl2 = (if neg then rxp_flag_del fl c else (if str_contains fl c then fl else fl ++ c)) in
       rxp_flags pat (p + 1) fl2 (seen ++ c) neg)
    // a/d/u (char-class semantics selectors) are accepted and ignored.
    else if str_eq c "a" || str_eq c "d" || str_eq c "u" then rxp_flags pat (p + 1) fl seen neg
    else if map_has rx_lenient "n" then rxp_flags pat (p + 1) fl seen neg
    else fail "mere-ruby: regexp: unknown inline flag"
and rxp_flag_del = fn (fl: str) -> fn (c: str) ->
  rxp_flag_del_go fl c 0 ""
and rxp_flag_del_go = fn (fl: str) -> fn (c: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len fl then acc
  else if str_eq (char_at fl i) c then rxp_flag_del_go fl c (i + 1) acc
  else rxp_flag_del_go fl c (i + 1) (acc ++ char_at fl i)

and rxp_close = fn (pat: str) -> fn (p: int) ->
  if p < str_len pat && str_eq (char_at pat p) ")" then p + 1
  else fail "mere-ruby: regexp: unmatched ("

// skip a balanced group body (p is just after the opening paren's contents
// start); returns the position after the matching ")".
and rxp_skip_group = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then fail "mere-ruby: regexp: unmatched ("
  else
    let c = char_at pat p in
    if str_eq c "\\" then rxp_skip_group pat (p + 2) depth
    else if str_eq c "[" then rxp_skip_group pat (rxp_skip_class pat (p + 1)) depth
    else if str_eq c "(" then rxp_skip_group pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth == 1 then p + 1 else rxp_skip_group pat (p + 1) (depth - 1))
    else rxp_skip_group pat (p + 1) depth
and rxp_skip_class = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then fail "mere-ruby: regexp: unterminated class"
  else
    let c = char_at pat p in
    if str_eq c "\\" then rxp_skip_class pat (p + 2)
    else if str_eq c "]" then p + 1
    else rxp_skip_class pat (p + 1)

// a capture-group name cannot start with a digit or a minus.
and rxp_name_check = fn (nm: str) ->
  if str_len nm == 0 then fail "mere-ruby: regexp parse: empty group name"
  else
    let c = char_at nm 0 in
    if (c >= "0" && c <= "9") || str_eq c "-" then fail "mere-ruby: regexp parse: bad group name"
    else ()

// validate a regex literal at ruby-parse time: lenient mode accepts the
// constructs the engine defers to the legacy matcher, so only genuinely
// invalid syntax fails here (Ruby's SyntaxError; RegexpError via Regexp.new).
and rx_validate = fn (body: str) -> fn (fl: str) ->
  let _ = map_set rx_lenient "n" VNil in
  let ok = try_or (fn (u: unit) -> let _ = rxp_parse body fl in true) false in
  let _ = map_delete rx_lenient "n" in
  ok

// validate the regex literals recorded since the last check; the first
// invalid one fails (a SyntaxError at the enclosing parse boundary).
and rx_check_pending = fn (u: unit) ->
  let n = (if map_has rx_pending "n" then (match map_get rx_pending "n" with VInt k -> k | _ -> 0) else 0) in
  let d = (if map_has rx_pending "done" then (match map_get rx_pending "done" with VInt k -> k | _ -> 0) else 0) in
  let _ = rx_check_go d n in
  map_set rx_pending "done" (VInt n)
and rx_check_go = fn (i: int) -> fn (n: int) ->
  if i >= n then ()
  else
    let k = (match map_get rx_pending ("e" ++ str_of_int i) with VStr h -> sget h | _ -> "") in
    let nl = rx_key_nl k 0 in
    let fl = substring k 0 nl in
    let body = substring k (nl + 1) (str_len k) in
    if rx_validate body fl then rx_check_go (i + 1) n
    else fail "mere-ruby: regexp: invalid regular expression"
and rx_key_nl = fn (k: str) -> fn (i: int) ->
  if i >= str_len k then i
  else if str_eq (char_at k i) "\n" then i
  else rx_key_nl k (i + 1)

and rxp_name = fn (pat: str) -> fn (p: int) -> fn (term: str) -> fn (acc: str) ->
  if p >= str_len pat then fail "mere-ruby: regexp: unterminated group name"
  else if str_eq (char_at pat p) term then (acc, p + 1)
  else rxp_name pat (p + 1) term (acc ++ char_at pat p)

// character class [...]: items, negated, resume position (after ']').
and rxp_class = fn (pat: str) -> fn (p: int) ->
  let (neg, p2) = (if p < str_len pat && str_eq (char_at pat p) "^" then (true, p + 1) else (false, p)) in
  rxp_class_items pat p2 neg Nil true
and rxp_class_items = fn (pat: str) -> fn (p: int) -> fn (neg: bool) -> fn (acc: RCls list) -> fn (first: bool) ->
  if p >= str_len pat then fail "mere-ruby: regexp: unterminated class"
  else
    let c = char_at pat p in
    if str_eq c "]" && (if first then false else true) then (rev_app acc Nil, neg, p + 1)
    else if str_eq c "[" && p + 1 < str_len pat && str_eq (char_at pat (p + 1)) ":" then
      (let (nm, negp, p2) = rxp_posix pat (p + 2) in
       rxp_class_items pat p2 neg (Cons (CPosix (nm, negp), acc)) false)
    else if str_eq c "[" && p + 1 < str_len pat && str_eq (char_at pat (p + 1)) "]" then
      // "[]" — a literal '[' then closing... treat '[' as a literal member.
      rxp_class_items pat (p + 1) neg (Cons (CChr "[", acc)) false
    else
      let (lo, p2) = rxp_class_atom pat p in
      (match lo with
       | CChr ch ->
         if p2 + 1 <= str_len pat && p2 < str_len pat && str_eq (char_at pat p2) "-"
            && p2 + 1 < str_len pat && (if str_eq (char_at pat (p2 + 1)) "]" then false else true) then
           (let (hi, p3) = rxp_class_atom pat (p2 + 1) in
            match hi with
            | CChr ch2 -> rxp_class_items pat p3 neg (Cons (CRange (ch, ch2), acc)) false
            | _ -> fail "mere-ruby: regexp: bad class range")
         else rxp_class_items pat p2 neg (Cons (lo, acc)) false
       | _ -> rxp_class_items pat p2 neg (Cons (lo, acc)) false)
and rxp_class_atom = fn (pat: str) -> fn (p: int) ->
  let c = char_at pat p in
  if str_eq c "\\" && p + 1 < str_len pat then
    (let e = char_at pat (p + 1) in
     if str_eq e "d" then (CDigit, p + 2) else if str_eq e "D" then (CNDigit, p + 2)
     else if str_eq e "w" then (CWord, p + 2) else if str_eq e "W" then (CNWord, p + 2)
     else if str_eq e "s" then (CSpace, p + 2) else if str_eq e "S" then (CNSpace, p + 2)
     else if str_eq e "h" then (CHex, p + 2) else if str_eq e "H" then (CNHex, p + 2)
     else if str_eq e "n" then (CChr "\n", p + 2) else if str_eq e "t" then (CChr "\t", p + 2)
     else if str_eq e "r" then (CChr "\r", p + 2)
     else if str_eq e "f" then (CChr (chr 12), p + 2) else if str_eq e "v" then (CChr (chr 11), p + 2)
     else if str_eq e "e" then (CChr (chr 27), p + 2) else if str_eq e "a" then (CChr (chr 7), p + 2)
     else if str_eq e "b" then (CChr (chr 8), p + 2)   // \b inside a class is backspace
     else if str_eq e "x" then
       (let h1 = rxp_hexv (char_at pat (p + 2)) in
        if h1 < 0 then fail "mere-ruby: regexp: bad \\x in class"
        else if p + 3 < str_len pat && rxp_hexv (char_at pat (p + 3)) >= 0 then
          (CChr (chr (h1 * 16 + rxp_hexv (char_at pat (p + 3)))), p + 4)
        else (CChr (chr h1), p + 3))
     else (CChr e, p + 2))
  else (CChr c, p + 1)
and rxp_posix = fn (pat: str) -> fn (p: int) ->
  let (negp, p2) = (if p < str_len pat && str_eq (char_at pat p) "^" then (true, p + 1) else (false, p)) in
  rxp_posix_name pat p2 negp ""
and rxp_posix_name = fn (pat: str) -> fn (p: int) -> fn (negp: bool) -> fn (acc: str) ->
  if p + 1 < str_len pat && str_eq (char_at pat p) ":" && str_eq (char_at pat (p + 1)) "]" then (acc, negp, p + 2)
  else if p >= str_len pat then fail "mere-ruby: regexp: unterminated posix class"
  else rxp_posix_name pat (p + 1) negp (acc ++ char_at pat p)

// ---- regex compiler (RNode -> instruction program) ------------------------
// A program is an int-key Map ("0".."N-1" -> RInst) built by rxc_emit, which
// returns the next free pc. Forward jump targets are reserved with -1 and
// patched (rxc_patch). Loop-guard mark slots use 100000+pc (disjoint from
// the 2g/2g+1 capture slots).

and rxc_patch = fn prog -> fn (at: int) -> fn (target: int) ->
  match map_get prog (str_of_int at) with
  | ISplit (a, b) -> map_set prog (str_of_int at) (ISplit ((if a < 0 then target else a), (if b < 0 then target else b)))
  | IJmp _ -> map_set prog (str_of_int at) (IJmp target)
  | _ -> ()
and rxc_patch_all = fn prog -> fn (ats: int list) -> fn (target: int) ->
  match ats with Nil -> () | Cons (a, rest) -> let _ = rxc_patch prog a target in rxc_patch_all prog rest target

// nullable: can the node match the empty string? (drives the empty-loop guard)
and rxc_nullable = fn (n: RNode) ->
  match n with
  | NChar _ -> false | NCharCI _ -> false | NAny -> false | NAnyNL -> false
  | NClass (_, _, _) -> false
  // a backreference to an empty (or unset-then-set) group matches "" — treat
  // as nullable so star loops over it get the empty-iteration guard.
  | NBackref (_, _) -> true
  | NSeq xs -> rxc_null_all xs
  | NAlt xs -> rxc_null_any xs
  | NRep (b, lo, _, _) -> lo == 0 || rxc_nullable b
  | NGroup (b, _, _) -> rxc_nullable b
  | _ -> true
and rxc_null_all = fn (xs: RNode list) ->
  match xs with Nil -> true | Cons (h, t) -> rxc_nullable h && rxc_null_all t
and rxc_null_any = fn (xs: RNode list) ->
  match xs with Nil -> false | Cons (h, t) -> rxc_nullable h || rxc_null_any t

// fixed byte width of a node (-1 = variable), for lookbehind.
and rxc_width = fn (n: RNode) ->
  match n with
  | NChar _ -> 1 | NCharCI _ -> 1 | NAny -> 1 | NAnyNL -> 1 | NClass (_, _, _) -> 1
  | NSeq xs -> rxc_width_sum xs
  | NAlt xs -> rxc_width_alt xs
  | NRep (b, lo, hi, _) -> (let w = rxc_width b in if w < 0 || (if hi == lo then false else true) then 0 - 1 else w * lo)
  | NGroup (b, _, _) -> rxc_width b
  | NBackref (_, _) -> 0 - 1
  | NEmpty -> 0 | NBOL -> 0 | NEOL -> 0 | NBOS -> 0 | NEOS -> 0 | NEOSNL -> 0
  | NWordB _ -> 0 | NLook (_, _) -> 0 | NLookB (_, _) -> 0
  | NFlagsRest _ -> 0
and rxc_width_sum = fn (xs: RNode list) ->
  match xs with
  | Nil -> 0
  | Cons (h, t) ->
    let w = rxc_width h in
    if w < 0 then 0 - 1 else (let r = rxc_width_sum t in if r < 0 then 0 - 1 else w + r)
and rxc_width_alt = fn (xs: RNode list) ->
  match xs with
  | Nil -> 0
  | Cons (h, Nil) -> rxc_width h
  | Cons (h, t) ->
    let w = rxc_width h in
    let r = rxc_width_alt t in
    if w < 0 || r < 0 || (if w == r then false else true) then 0 - 1 else w

and rxc_emit = fn prog -> fn (pc: int) -> fn (n: RNode) ->
  match n with
  | NEmpty -> pc
  | NFlagsRest _ -> pc
  | NChar c -> let _ = map_set prog (str_of_int pc) (IChar c) in pc + 1
  | NCharCI c -> let _ = map_set prog (str_of_int pc) (ICharCI c) in pc + 1
  | NAny -> let _ = map_set prog (str_of_int pc) IAny in pc + 1
  | NAnyNL -> let _ = map_set prog (str_of_int pc) IAnyNL in pc + 1
  | NClass (items, neg, ci) -> let _ = map_set prog (str_of_int pc) (IClass (items, neg, ci)) in pc + 1
  | NBOL -> let _ = map_set prog (str_of_int pc) IBOL in pc + 1
  | NEOL -> let _ = map_set prog (str_of_int pc) IEOL in pc + 1
  | NBOS -> let _ = map_set prog (str_of_int pc) IBOS in pc + 1
  | NEOS -> let _ = map_set prog (str_of_int pc) IEOS in pc + 1
  | NEOSNL -> let _ = map_set prog (str_of_int pc) IEOSNL in pc + 1
  | NWordB b -> let _ = map_set prog (str_of_int pc) (IWordB b) in pc + 1
  | NBackref (g, ci) -> let _ = map_set prog (str_of_int pc) (IBackref (g, ci)) in pc + 1
  | NSeq xs -> rxc_emit_seq prog pc xs
  | NAlt xs ->
    let (pc2, jmps) = rxc_emit_alt prog pc xs Nil in
    let _ = rxc_patch_all prog jmps pc2 in
    pc2
  | NGroup (b, gn, nm) ->
    if gn == 0 then rxc_emit prog pc b
    else
      (let _ = (if str_eq nm "" then () else map_set prog ("name:" ++ nm) (IMeta (gn, 0))) in
       let _ = map_set prog (str_of_int pc) (ISave (2 * gn)) in
       let pc2 = rxc_emit prog (pc + 1) b in
       let _ = map_set prog (str_of_int pc2) (ISave (2 * gn + 1)) in
       pc2 + 1)
  | NRep (b, lo, hi, greedy) ->
    let pc2 = rxc_emit_times prog pc b lo in
    if hi < 0 then
      // star loop: L1 split(body, out) / body [guarded] jmp L1 / out.
      (let l1 = pc2 in
       let bodypc = l1 + 1 in
       let guard = rxc_nullable b in
       let bstart = (if guard then bodypc + 1 else bodypc) in
       let _ = (if guard then map_set prog (str_of_int bodypc) (IMark (100000 + l1)) else ()) in
       let bend = rxc_emit prog bstart b in
       // ICheck's second arg is the loop exit (jmp-pc + 1), known statically.
       let cend = (if guard then (let _ = map_set prog (str_of_int bend) (ICheck (100000 + l1, bend + 2)) in bend + 1) else bend) in
       let _ = map_set prog (str_of_int cend) (IJmp l1) in
       let out = cend + 1 in
       let _ = map_set prog (str_of_int l1) (if greedy then ISplit (bodypc, out) else ISplit (out, bodypc)) in
       out)
    else
      // (hi - lo) optional copies, all exiting to the shared out label.
      (let (pc3, pends) = rxc_emit_opts prog pc2 b (hi - lo) greedy Nil in
       let _ = rxc_patch_all prog pends pc3 in
       pc3)
  | NLook (b, negd) ->
    // jmp AFTER; SUB: body IOk; AFTER: ILook(SUB, neg).
    (let subpc = pc + 1 in
     let pc2 = rxc_emit prog subpc b in
     let _ = map_set prog (str_of_int pc2) IOk in
     let _ = map_set prog (str_of_int pc) (IJmp (pc2 + 1)) in
     let _ = map_set prog (str_of_int (pc2 + 1)) (ILook (subpc, negd)) in
     pc2 + 2)
  | NLookB (b, negd) ->
    (let w = rxc_width b in
     let _ = (if w < 0 then fail "mere-ruby: regexp: variable-length lookbehind unsupported" else ()) in
     let subpc = pc + 1 in
     let pc2 = rxc_emit prog subpc b in
     let _ = map_set prog (str_of_int pc2) IOk in
     let _ = map_set prog (str_of_int pc) (IJmp (pc2 + 1)) in
     let _ = map_set prog (str_of_int (pc2 + 1)) (ILookB (subpc, w, negd)) in
     pc2 + 2)
and rxc_emit_seq = fn prog -> fn (pc: int) -> fn (xs: RNode list) ->
  match xs with Nil -> pc | Cons (h, t) -> rxc_emit_seq prog (rxc_emit prog pc h) t
and rxc_emit_times = fn prog -> fn (pc: int) -> fn (b: RNode) -> fn (k: int) ->
  if k <= 0 then pc else rxc_emit_times prog (rxc_emit prog pc b) b (k - 1)
and rxc_emit_opts = fn prog -> fn (pc: int) -> fn (b: RNode) -> fn (k: int) -> fn (greedy: bool) -> fn (pends: int list) ->
  if k <= 0 then (pc, pends)
  else
    let bodypc = pc + 1 in
    let pc2 = rxc_emit prog bodypc b in
    let _ = map_set prog (str_of_int pc) (if greedy then ISplit (bodypc, 0 - 1) else ISplit (0 - 1, bodypc)) in
    rxc_emit_opts prog pc2 b (k - 1) greedy (Cons (pc, pends))
and rxc_emit_alt = fn prog -> fn (pc: int) -> fn (xs: RNode list) -> fn (jmps: int list) ->
  match xs with
  | Nil -> (pc, jmps)
  | Cons (b, Nil) -> (rxc_emit prog pc b, jmps)
  | Cons (b, rest) ->
    let bodypc = pc + 1 in
    let pc2 = rxc_emit prog bodypc b in
    let _ = map_set prog (str_of_int pc) (ISplit (bodypc, pc2 + 1)) in
    let _ = map_set prog (str_of_int pc2) (IJmp (0 - 1)) in
    rxc_emit_alt prog (pc2 + 1) rest (Cons (pc2, jmps))

// compile (with per-pattern cache); fails on unsupported constructs.
and rxc_get = fn (pat: str) -> fn (fl: str) ->
  let key = fl ++ chr 1 ++ pat in
  if map_has rx_progs key then map_get rx_progs key
  else
    let n = rxp_parse pat fl in
    let prog = map_new () in
    let ng = rxp_ngroups n in
    let endpc = rxc_emit prog 0 n in
    let _ = map_set prog (str_of_int endpc) IMatch in
    let _ = map_set prog ("meta") (IMeta (endpc + 1, ng)) in
    let _ = map_set rx_progs key prog in
    prog

// ---- regex VM (single executor: end index + immutable capture saves) ------

and rxv_slot_get = fn (saves: (int * int) list) -> fn (k: int) ->
  match saves with
  | Nil -> 0 - 1
  | Cons ((k2, v), rest) -> if k2 == k then v else rxv_slot_get rest k

and rxv_is_word = fn (c: str) ->
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || str_eq c "_"

and rxv_cls_one = fn (it: RCls) -> fn (c: str) ->
  match it with
  | CChr x -> str_eq x c
  | CRange (lo, hi) -> c >= lo && c <= hi
  | CDigit -> c >= "0" && c <= "9"
  | CNDigit -> if c >= "0" && c <= "9" then false else true
  | CWord -> rxv_is_word c
  | CNWord -> if rxv_is_word c then false else true
  | CSpace -> str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" || str_eq c (chr 12) || str_eq c (chr 11)
  | CNSpace -> if str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" || str_eq c (chr 12) || str_eq c (chr 11) then false else true
  | CHex -> (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
  | CNHex -> if (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F") then false else true
  | CPosix (nm, negp) ->
    let r = rxv_posix nm c in
    if negp then (if r then false else true) else r
and rxv_posix = fn (nm: str) -> fn (c: str) ->
  if str_eq nm "alpha" then (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
  else if str_eq nm "alnum" then (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
  else if str_eq nm "digit" then c >= "0" && c <= "9"
  else if str_eq nm "xdigit" then (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
  else if str_eq nm "space" then str_eq c " " || str_eq c "\t" || str_eq c "\n" || str_eq c "\r" || str_eq c (chr 12) || str_eq c (chr 11)
  else if str_eq nm "upper" then c >= "A" && c <= "Z"
  else if str_eq nm "lower" then c >= "a" && c <= "z"
  else if str_eq nm "word" then rxv_is_word c
  else if str_eq nm "blank" then str_eq c " " || str_eq c "\t"
  else if str_eq nm "cntrl" then c < " " || str_eq c (chr 127)
  else if str_eq nm "print" then c >= " " && (if str_eq c (chr 127) then false else true)
  else if str_eq nm "graph" then c > " " && (if str_eq c (chr 127) then false else true)
  else if str_eq nm "punct" then (c > " " && c < "0") || (c > "9" && c < "A") || (c > "Z" && c < "a" && (if str_eq c "_" then false else true)) || (c > "z" && c <= "~")
  else if str_eq nm "ascii" then c <= chr 127
  else fail "mere-ruby: regexp: unknown posix class"

and rxv_cls = fn (items: RCls list) -> fn (neg: bool) -> fn (ci: bool) -> fn (c: str) ->
  let hit = rxv_cls_list items c || (ci && rxv_cls_list items (rxv_swapcase c)) in
  if neg then (if hit then false else true) else hit
and rxv_cls_list = fn (items: RCls list) -> fn (c: str) ->
  match items with Nil -> false | Cons (h, t) -> rxv_cls_one h c || rxv_cls_list t c
and rxv_swapcase = fn (c: str) ->
  if c >= "a" && c <= "z" then str_upcase c
  else if c >= "A" && c <= "Z" then str_downcase_c c
  else c
and str_downcase_c = fn (c: str) ->
  str_downcase_c_go c 0
and str_downcase_c_go = fn (c: str) -> fn (i: int) ->
  if i >= 26 then c
  else if str_eq (char_at "ABCDEFGHIJKLMNOPQRSTUVWXYZ" i) c then char_at "abcdefghijklmnopqrstuvwxyz" i
  else str_downcase_c_go c (i + 1)

and rxv_fetch = fn prog -> fn (pc: int) -> map_get prog (str_of_int pc)

and rxv_run = fn prog -> fn (s: str) -> fn (pc: int) -> fn (i: int)
           -> fn (saves: (int * int) list) -> fn (bt: (int * int * ((int * int) list)) list) ->
  match rxv_fetch prog pc with
  | IMatch -> RFound (i, saves)
  | IOk -> RFound (i, saves)
  | IChar c ->
    if i < str_len s && str_eq (char_at s i) c then rxv_run prog s (pc + 1) (i + 1) saves bt
    else rxv_fail prog s bt
  | ICharCI c ->
    if i < str_len s && (str_eq (char_at s i) c || str_eq (rxv_swapcase (char_at s i)) c || str_eq (char_at s i) (rxv_swapcase c))
    then rxv_run prog s (pc + 1) (i + 1) saves bt
    else rxv_fail prog s bt
  | IAny ->
    if i < str_len s && (if str_eq (char_at s i) "\n" then false else true) then rxv_run prog s (pc + 1) (i + 1) saves bt
    else rxv_fail prog s bt
  | IAnyNL ->
    if i < str_len s then rxv_run prog s (pc + 1) (i + 1) saves bt
    else rxv_fail prog s bt
  | IClass (items, neg, ci) ->
    if i < str_len s && rxv_cls items neg ci (char_at s i) then rxv_run prog s (pc + 1) (i + 1) saves bt
    else rxv_fail prog s bt
  | ISplit (a, b) -> rxv_run prog s a i saves (Cons ((b, i, saves), bt))
  | IJmp t -> rxv_run prog s t i saves bt
  | ISave slot -> rxv_run prog s (pc + 1) i (Cons ((slot, i), saves)) bt
  | IMark k -> rxv_run prog s (pc + 1) i (Cons ((k, i), saves)) bt
  | ICheck (k, out) ->
    // Onigmo's empty check: an iteration that consumed nothing AND changed no
    // capture ends the loop here (keeping this iteration's captures, no
    // backtracking into other alternatives); one that changed a capture is
    // allowed to continue (e.g. /(a|\2b|())*/ needs the () iteration).
    if rxv_slot_get saves k == i then
      (if rxv_caps_changed saves k then rxv_run prog s (pc + 1) i saves bt
       else rxv_run prog s out i saves bt)
    else rxv_run prog s (pc + 1) i saves bt
  | IBOL ->
    // line start: position 0, or right after a \n — but NOT the end-of-string
    // position after a trailing \n (there is no empty last line in Ruby).
    if i == 0 || (i < str_len s && str_eq (char_at s (i - 1)) "\n") then rxv_run prog s (pc + 1) i saves bt
    else rxv_fail prog s bt
  | IEOL ->
    if i >= str_len s || str_eq (char_at s i) "\n" then rxv_run prog s (pc + 1) i saves bt
    else rxv_fail prog s bt
  | IBOS -> if i == 0 then rxv_run prog s (pc + 1) i saves bt else rxv_fail prog s bt
  | IEOS -> if i >= str_len s then rxv_run prog s (pc + 1) i saves bt else rxv_fail prog s bt
  | IEOSNL ->
    if i >= str_len s || (i == str_len s - 1 && str_eq (char_at s i) "\n") then rxv_run prog s (pc + 1) i saves bt
    else rxv_fail prog s bt
  | IWordB want ->
    (let w1 = i > 0 && rxv_is_word (char_at s (i - 1)) in
     let w2 = i < str_len s && rxv_is_word (char_at s i) in
     let atb = (if w1 then (if w2 then false else true) else w2) in
     if (if want then atb else (if atb then false else true)) then rxv_run prog s (pc + 1) i saves bt
     else rxv_fail prog s bt)
  | IBackref (g, ci) ->
    (let a = rxv_slot_get saves (2 * g) in
     let b = rxv_slot_get saves (2 * g + 1) in
     if a < 0 || b < a then rxv_fail prog s bt
     else
       let seg = substring s a b in
       let here = (if i + (b - a) <= str_len s then substring s i (i + (b - a)) else "") in
       let eqv = (if ci then str_eq (str_upcase seg) (str_upcase here) else str_eq seg here) in
       if eqv && i + (b - a) <= str_len s then rxv_run prog s (pc + 1) (i + (b - a)) saves bt
       else rxv_fail prog s bt)
  | ILook (sub, negd) ->
    (match rxv_run prog s sub i saves Nil with
     | RFound (_, sv2) ->
       if negd then rxv_fail prog s bt else rxv_run prog s (pc + 1) i sv2 bt
     | RFail ->
       if negd then rxv_run prog s (pc + 1) i saves bt else rxv_fail prog s bt)
  | ILookB (sub, w, negd) ->
    (if i - w < 0 then (if negd then rxv_run prog s (pc + 1) i saves bt else rxv_fail prog s bt)
     else
       match rxv_run prog s sub (i - w) saves Nil with
       | RFound (e, sv2) ->
         if e == i then (if negd then rxv_fail prog s bt else rxv_run prog s (pc + 1) i sv2 bt)
         else (if negd then rxv_run prog s (pc + 1) i saves bt else rxv_fail prog s bt)
       | RFail ->
         if negd then rxv_run prog s (pc + 1) i saves bt else rxv_fail prog s bt)
  | IMeta (_, _) -> rxv_fail prog s bt

// did this loop iteration (the saves newer than the most recent `k` mark
// entry) change any capture slot's value vs before the iteration?
and rxv_caps_changed = fn (saves: (int * int) list) -> fn (k: int) ->
  rxv_caps_walk saves k Nil
and rxv_caps_walk = fn (saves: (int * int) list) -> fn (k: int) -> fn (newer: (int * int) list) ->
  match saves with
  | Nil -> false
  | Cons ((k2, v), rest) ->
    if k2 == k then rxv_caps_diff newer rest
    else rxv_caps_walk rest k (Cons ((k2, v), newer))
and rxv_caps_diff = fn (newer: (int * int) list) -> fn (older: (int * int) list) ->
  match newer with
  | Nil -> false
  | Cons ((slot, v), rest) ->
    if slot < 100000 && (let old = rxv_slot_get older slot in (if old == v then false else true)) then true
    else rxv_caps_diff rest older

and rxv_fail = fn prog -> fn (s: str) -> fn (bt: (int * int * ((int * int) list)) list) ->
  match bt with
  | Nil -> RFail
  | Cons ((pc, i, saves), rest) -> rxv_run prog s pc i saves rest

// search: the leftmost match at or after `start` (compile cached; RBadPat
// when the new engine cannot handle the pattern -> caller uses the legacy one).
and rxv_search = fn (pat: str) -> fn (fl: str) -> fn (s: str) -> fn (start: int) ->
  let key = fl ++ chr 1 ++ pat in
  if map_has rx_bad key then RBadPat
  else
    let ok = try_or (fn (u: unit) -> let _ = rxc_get pat fl in true) false in
    if ok then rxv_search_go (map_get rx_progs key) s start (str_len s)
    else (let _ = map_set rx_bad key VNil in RBadPat)
and rxv_search_go = fn prog -> fn (s: str) -> fn (i: int) -> fn (len: int) ->
  if i > len then RNoHit
  else
    match rxv_run prog s 0 i Nil Nil with
    | RFound (e, sv) -> RHit (i, e, sv)
    | RFail -> rxv_search_go prog s (i + 1) len

// a minimal regex engine: literals, ^ $ anchors, . any, \d \w \s classes,
// and + * on single elements. Backtracking, no groups.
and rx_match = fn (pat: str) -> fn (fl: str) -> fn (s: str) ->
  match rxv_search pat fl s 0 with
  | RHit (_, _, _) -> true
  | RNoHit -> false
  | RBadPat -> rx_match_legacy pat s

and rx_match_legacy = fn (pat: str) -> fn (s: str) ->
  if str_len pat > 0 && str_eq (char_at pat 0) "^" then rx_alts pat 1 s 0
  else rx_scan pat s 0

// =~ returns the match POSITION or nil.
and rx_index = fn (pat: str) -> fn (s: str) ->
  if str_len pat > 0 && str_eq (char_at pat 0) "^" then
    (if rx_alts pat 1 s 0 then VInt 0 else VNil)
  else rx_index_scan pat s 0

and rx_index_scan = fn (pat: str) -> fn (s: str) -> fn (i: int) ->
  if rx_alts pat 0 s i then VInt i
  else if i >= str_len s then VNil
  else rx_index_scan pat s (i + 1)

and rx_scan = fn (pat: str) -> fn (s: str) -> fn (i: int) ->
  if rx_alts pat 0 s i then true
  else if i >= str_len s then false
  else rx_scan pat s (i + 1)

and rx_here = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) ->
  if p >= str_len pat then true
  else if str_eq (char_at pat p) "$" && p + 1 >= str_len pat then i >= str_len s
  // reaching a top-level `|` means the current alternative matched: the whole
  // alternation succeeds, so skip past the remaining alternatives to the end of
  // the enclosing scope and continue there.
  else if str_eq (char_at pat p) "|" then rx_here pat (rx_alt_scope_end pat p 0) s i
  else if str_eq (char_at pat p) "(" then
    // a capture group opens: record the start, skip a (?<name> header.
    // An optional group `(...)?` either matches once (the ) skips the ?) or is
    // skipped entirely (its capture unset).
    let g = rx_count pat "(" p + 1 in
    let q = rx_close pat (p + 1) 1 in
    let quant = (if q + 1 < str_len pat then char_at pat (q + 1) else "") in
    let _ = map_set rx_caps ("s" ++ str_of_int g) i in
    // remember where this group iteration started, so the ) can detect an
    // empty (non-advancing) match and stop repeating.
    let _ = map_set rx_caps ("it" ++ str_of_int g) i in
    if str_eq quant "?" then
      (if rx_alts pat (rx_group_hdr pat (p + 1)) s i then true
       else (let _ = rx_unset_cap g in rx_here pat (q + 2) s i))
    else if str_eq quant "*" then
      // zero or more, greedy: try matching the group (the ) loops it), else skip.
      (if rx_alts pat (rx_group_hdr pat (p + 1)) s i then true
       else (let _ = rx_unset_cap g in rx_here pat (q + 2) s i))
    else if str_eq quant "+" then
      // one or more: the group must match at least once (the ) loops it).
      rx_alts pat (rx_group_hdr pat (p + 1)) s i
    else rx_alts pat (rx_group_hdr pat (p + 1)) s i
  else if str_eq (char_at pat p) ")" then
    let g = rx_count pat ")" p + 1 in
    let _ = map_set rx_caps ("e" ++ str_of_int g) i in
    let nx = (if p + 1 < str_len pat then char_at pat (p + 1) else "") in
    if str_eq nx "?" then rx_here pat (p + 2) s i
    else if str_eq nx "*" || str_eq nx "+" then
      // repeated group: greedily loop back to the group start when this
      // iteration advanced, else stop and match the rest (past the quantifier).
      // Save this iteration's capture so a failed further iteration (which
      // eagerly rewrites the group start) restores the last good capture.
      (let itstart = (if map_has rx_caps ("it" ++ str_of_int g) then map_get rx_caps ("it" ++ str_of_int g) else i) in
       let ss = map_get rx_caps ("s" ++ str_of_int g) in
       if i > itstart && rx_alts pat (rx_nth_open pat g 0 0) s i then true
       else (let _ = map_set rx_caps ("s" ++ str_of_int g) ss in
             let _ = map_set rx_caps ("e" ++ str_of_int g) i in
             rx_here pat (p + 2) s i))
    else rx_here pat (p + 1) s i
  // \1..\9 backreference: match the text captured by that group (with an
  // optional +/* quantifier). Empty/uncaptured groups fail.
  else if str_eq (char_at pat p) "\\" && p + 1 < str_len pat && is_digit (char_at pat (p + 1)) then
    let g = ord (char_at pat (p + 1)) - 48 in
    let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
    (if map_has rx_caps ks && map_has rx_caps ke then
       let cap = substring s (map_get rx_caps ks) (map_get rx_caps ke) in
       let clen = str_len cap in
       let quant = (if p + 2 < str_len pat then char_at pat (p + 2) else "") in
       if str_eq quant "+" then (if backref_at s i cap clen then rx_backref_many pat (p + 3) s (i + clen) cap clen else false)
       else if str_eq quant "*" then rx_backref_many pat (p + 3) s i cap clen
       else (if backref_at s i cap clen then rx_here pat (p + 2) s (i + clen) else false)
     else false)
  else
    let elen = rx_elen pat p in
    let quant = (if p + elen < str_len pat then char_at pat (p + elen) else "") in
    if str_eq quant "+" then
      (if i < str_len s && rx_elem pat p (char_at s i)
       then rx_many pat p elen s (i + 1) else false)
    else if str_eq quant "*" then rx_many pat p elen s i
    // `x?` — zero or one, greedy: try matching the element then the rest,
    // otherwise skip the element (both element and `?` are consumed).
    else if str_eq quant "?" then
      (if i < str_len s && rx_elem pat p (char_at s i) && rx_here pat (p + elen + 1) s (i + 1) then true
       else rx_here pat (p + elen + 1) s i)
    else
      (if i < str_len s && rx_elem pat p (char_at s i)
       then rx_here pat (p + elen) s (i + 1) else false)

// index of the `]` closing a char class opened at p (past any escapes).
// index of the `)` matching an already-entered group (call with depth 1 just
// past the opening `(`); skips escapes, char classes, and nested groups.
// (rx_class_end is defined below, shared with the matcher's class handling.)
and rx_close = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_close pat (p + 2) depth
    else if str_eq c "[" then rx_close pat (rx_class_end pat (p + 1)) depth
    else if str_eq c "(" then rx_close pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth <= 1 then p else rx_close pat (p + 1) (depth - 1))
    else rx_close pat (p + 1) depth

// alternation support. From position p (inside a scope), find the position
// just after the next top-level `|` (same nesting), or -1 if the scope ends
// (its `)`, at depth 0) or the pattern ends first.
and rx_next_alt = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then (0 - 1)
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_next_alt pat (p + 2) depth
    else if str_eq c "[" then rx_next_alt pat (rx_class_end pat (p + 1)) depth
    else if str_eq c "(" then rx_next_alt pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth <= 0 then (0 - 1) else rx_next_alt pat (p + 1) (depth - 1))
    else if str_eq c "|" && depth <= 0 then p + 1
    else rx_next_alt pat (p + 1) depth
// the end of the alternation scope enclosing p: the `)` closing this group
// (at depth 0), or the pattern end at top level.
and rx_alt_scope_end = fn (pat: str) -> fn (p: int) -> fn (depth: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_alt_scope_end pat (p + 2) depth
    else if str_eq c "[" then rx_alt_scope_end pat (rx_class_end pat (p + 1)) depth
    else if str_eq c "(" then rx_alt_scope_end pat (p + 1) (depth + 1)
    else if str_eq c ")" then (if depth <= 0 then p else rx_alt_scope_end pat (p + 1) (depth - 1))
    else rx_alt_scope_end pat (p + 1) depth
// match a scope that may contain top-level `|` alternatives: try each in turn
// (reaching a `|` mid-match jumps to the scope end via rx_here's `|` case).
and rx_alts = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) ->
  if rx_here pat p s i then true
  else let np = rx_next_alt pat p 0 in
       if np < 0 then false else rx_alts pat np s i

// position of the g-th `(` in pat (1-based), skipping escapes/char classes.
and rx_nth_open = fn (pat: str) -> fn (g: int) -> fn (p: int) -> fn (cnt: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_nth_open pat g (p + 2) cnt
    else if str_eq c "[" then rx_nth_open pat g (rx_class_end pat (p + 1)) cnt
    else if str_eq c "(" then (if cnt + 1 == g then p else rx_nth_open pat g (p + 1) (cnt + 1))
    else rx_nth_open pat g (p + 1) cnt

// unset a group's capture (an optional group that did not participate).
and rx_unset_cap = fn (g: int) ->
  let _ = if map_has rx_caps ("s" ++ str_of_int g) then map_delete rx_caps ("s" ++ str_of_int g) else () in
  (if map_has rx_caps ("e" ++ str_of_int g) then map_delete rx_caps ("e" ++ str_of_int g) else ())

and backref_at = fn (s: str) -> fn (i: int) -> fn (cap: str) -> fn (clen: int) ->
  clen > 0 && i + clen <= str_len s && str_eq (substring s i (i + clen)) cap

and rx_backref_many = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) -> fn (cap: str) -> fn (clen: int) ->
  if backref_at s i cap clen && rx_backref_many pat p s (i + clen) cap clen then true
  else rx_here pat p s i

and rxe_backref_many = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) -> fn (cap: str) -> fn (clen: int) ->
  if backref_at s i cap clen then (let r = rxe_backref_many pat p s (i + clen) cap clen in if r >= 0 then r else rxe_here pat p s i)
  else rxe_here pat p s i

// count occurrences of ch in pat before position p.
and rx_count = fn (pat: str) -> fn (ch: str) -> fn (p: int) ->
  rx_count_go pat ch p 0 0
and rx_count_go = fn (pat: str) -> fn (ch: str) -> fn (p: int) -> fn (i: int) -> fn (n: int) ->
  if i >= p then n
  else rx_count_go pat ch p (i + 1) (if str_eq (char_at pat i) ch then n + 1 else n)

// skip a (?<name> / (?: / (?-mix: style group header (just past it).
and rx_group_hdr = fn (pat: str) -> fn (p: int) ->
  if p < str_len pat && str_eq (char_at pat p) "?" then rx_hdr_end pat (p + 1)
  else p
and rx_hdr_end = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else
    let c = char_at pat p in
    if str_eq c ":" || str_eq c ">" then p + 1
    else if str_eq c ")" then p   // (?flags) with no body — leave at )
    else rx_hdr_end pat (p + 1)

// run a match and publish $~ (a MatchData instance) and $1..$9 globals.
// number of capture groups in a compiled program.
and rxv_prog_ng = fn prog ->
  match map_get prog "meta" with IMeta (_, ng) -> ng | _ -> 0

// export a hit's capture saves into rx_caps ("s{g}"/"e{g}"), so the existing
// consumers (rx_publish_at / rx_expand_rep / rx_scan_groups) work unchanged.
and rxv_export_caps = fn (saves: (int * int) list) -> fn (ng: int) ->
  let _ = rx_clear_caps 1 in
  rxv_export_go saves ng 1
and rxv_export_go = fn (saves: (int * int) list) -> fn (ng: int) -> fn (g: int) ->
  if g > ng || g > 9 then ()
  else
    let a = rxv_slot_get saves (2 * g) in
    let b = rxv_slot_get saves (2 * g + 1) in
    let _ = (if a >= 0 && b >= 0 then
               (let _ = map_set rx_caps ("s" ++ str_of_int g) a in
                map_set rx_caps ("e" ++ str_of_int g) b)
             else ()) in
    rxv_export_go saves ng (g + 1)

// =~ / .match / ===: run the match and publish $~ / $1..$9. New engine with
// legacy fallback for uncompilable patterns.
and rx_do_match = fn world -> fn (pat: str) -> fn (fl: str) -> fn (sv: str) ->
  match rxv_search pat fl sv 0 with
  | RBadPat ->
    (let _ = rx_clear_caps 1 in
     let r = rx_index pat sv in
     let _ = rx_publish world pat sv r in
     r)
  | RNoHit ->
    (let _ = rx_clear_caps 1 in
     let _ = map_set globals "~" VNil in
     let _ = rx_pub_groups sv 1 false in
     VNil)
  | RHit (st, en, saves) ->
    (let ng = rxv_prog_ng (map_get rx_progs (fl ++ chr 1 ++ pat)) in
     let _ = rxv_export_caps saves ng in
     let _ = rx_publish_at world sv st en ng in
     VInt st)

// index of the next `>` at or after p (for a (?<name> header).
and rx_name_end = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then p
  else if str_eq (char_at pat p) ">" then p
  else rx_name_end pat (p + 1)

// `/literal/ =~ str` with named captures assigns a local variable per named
// group (its captured string, or nil). Walks the pattern counting capturing
// groups; each `(?<name>` sets env[name] from the just-published $1..$9.
and set_named_caps = fn env -> fn (pat: str) -> fn (p: int) -> fn (gidx: int) ->
  if p >= str_len pat then ()
  else
    let c = char_at pat p in
    if str_eq c "\\" then set_named_caps env pat (p + 2) gidx
    else if str_eq c "(" then
      (if p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "?" && str_eq (char_at pat (p + 2)) "<"
          && (let d = char_at pat (p + 3) in (if str_eq d "=" then false else if str_eq d "!" then false else true)) then
         let nend = rx_name_end pat (p + 3) in
         let name = substring pat (p + 3) nend in
         let g = gidx + 1 in
         let _ = map_set env name (if map_has globals (str_of_int g) then map_get globals (str_of_int g) else VNil) in
         set_named_caps env pat (nend + 1) g
       else if str_eq (char_at pat (p + 1)) "?" then set_named_caps env pat (p + 1) gidx
       else set_named_caps env pat (p + 1) (gidx + 1))
    else set_named_caps env pat (p + 1) gidx

// the named-capture names in a literal regex, as block-local targets (so
// `/re/ =~ s` inside a block declares them local, matching Ruby).
and rx_capture_names = fn (pat: str) -> fn (p: int) ->
  if p >= str_len pat then Nil
  else
    let c = char_at pat p in
    if str_eq c "\\" then rx_capture_names pat (p + 2)
    else if str_eq c "(" && p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "?" && str_eq (char_at pat (p + 2)) "<"
            && (let d = char_at pat (p + 3) in (if str_eq d "=" then false else if str_eq d "!" then false else true)) then
      let nend = rx_name_end pat (p + 3) in
      Cons (substring pat (p + 3) nend, rx_capture_names pat (nend + 1))
    else rx_capture_names pat (p + 1)

and rx_clear_caps = fn (i: int) ->
  if i > 9 then ()
  else
    let _ = if map_has rx_caps ("s" ++ str_of_int i) then map_delete rx_caps ("s" ++ str_of_int i) else () in
    let _ = if map_has rx_caps ("e" ++ str_of_int i) then map_delete rx_caps ("e" ++ str_of_int i) else () in
    rx_clear_caps (i + 1)

and rx_publish = fn world -> fn (pat: str) -> fn (sv: str) -> fn (r: Val) ->
  (match r with
   | VNil ->
     let _ = map_set globals "~" VNil in rx_pub_groups sv 1 false
   | _ ->
     let st = (match r with VInt p -> p | _ -> 0) in
     let en = (let e = rxe_alts pat (rxe_start pat) sv st in if e < 0 then st else e) in
     rx_publish_at world sv st en (0 - 1))

// publish a match at (st, en): a MatchData in $~ (group 0 = the whole match,
// groups 1..9 read from rx_caps) and the $1..$9 globals. ng >= 0 records the
// pattern's group count on the object (so #to_a nil-fills unparticipated
// groups); -1 = unknown (legacy engine).
and rx_publish_at = fn world -> fn (sv: str) -> fn (st: int) -> fn (en: int) -> fn (ng: int) ->
  let (meths, sup, ocls, ivars) = world in
  let id = map_len ocls in
  let _ = map_set ocls (str_of_int id) "MatchData" in
  let _ = map_set globals "~" (VObj id) in
  let _ = map_set ivars (str_of_int id ++ "@0") (mkstr (substring sv st en)) in
  let _ = (if ng >= 0 then map_set ivars (str_of_int id ++ "@__ng") (VInt ng) else ()) in
  let _ = rx_store_groups ivars id sv 1 in
  rx_pub_groups sv 1 true

and rx_store_groups = fn ivars -> fn (id: int) -> fn (sv: str) -> fn (g: int) ->
  if g > 9 then ()
  else
    let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
    let _ = (if map_has rx_caps ks && map_has rx_caps ke then
               let a = map_get rx_caps ks in let b = map_get rx_caps ke in
               (if b >= a then map_set ivars (str_of_int id ++ "@" ++ str_of_int g) (mkstr (substring sv a b)) else ())
             else ()) in
    rx_store_groups ivars id sv (g + 1)

// MatchData#to_a (start=0, incl. whole match) / #captures (start=1).
and md_max_group = fn ivars -> fn (id: int) -> fn (g: int) ->
  if g < 1 then 0 else if map_has ivars (str_of_int id ++ "@" ++ str_of_int g) then g else md_max_group ivars id (g - 1)
and md_collect = fn ivars -> fn (id: int) -> fn (i: int) -> fn (hi: int) ->
  if i > hi then Nil
  else Cons ((if map_has ivars (str_of_int id ++ "@" ++ str_of_int i) then map_get ivars (str_of_int id ++ "@" ++ str_of_int i) else VNil), md_collect ivars id (i + 1) hi)
and matchdata_arr = fn ivars -> fn (id: int) -> fn (start: int) ->
  // with a recorded group count, nil-fill unparticipated trailing groups.
  let hi = (if map_has ivars (str_of_int id ++ "@__ng")
            then (match map_get ivars (str_of_int id ++ "@__ng") with VInt n -> n | _ -> md_max_group ivars id 9)
            else md_max_group ivars id 9) in
  md_collect ivars id start hi

and rx_pub_groups = fn (sv: str) -> fn (i: int) -> fn (ok: bool) ->
  if i > 9 then ()
  else
    let k_s = "s" ++ str_of_int i in
    let k_e = "e" ++ str_of_int i in
    let v = if ok && map_has rx_caps k_s && map_has rx_caps k_e then
              (let a = map_get rx_caps k_s in
               let b = map_get rx_caps k_e in
               if b >= a then mkstr (substring sv a b) else VNil)
            else VNil in
    let _ = map_set globals (str_of_int i) v in
    rx_pub_groups sv (i + 1) ok

// zero-or-more of the element at p, then the rest (greedy with backtrack).
and rx_many = fn (pat: str) -> fn (p: int) -> fn (elen: int) -> fn (s: str) -> fn (i: int) ->
  if i < str_len s && rx_elem pat p (char_at s i) && rx_many pat p elen s (i + 1) then true
  else rx_here pat (p + elen + 1) s i

and rx_elem = fn (pat: str) -> fn (p: int) -> fn (c: str) ->
  let pc = char_at pat p in
  if str_eq pc "." then true
  else if str_eq pc "[" then rx_class_match pat (p + 1) c
  else if str_eq pc "\\" then
    let e = char_at pat (p + 1) in
    if str_eq e "d" then is_digit c
    else if str_eq e "w" then is_alnum c || str_eq c "_"
    else if str_eq e "s" then str_eq c " " || str_eq c "\t" || str_eq c "\n"
    else str_eq c e
  else str_eq pc c

// length of the regex element at p: 2 for \x, a full [..] class, else 1.
and rx_elen = fn (pat: str) -> fn (p: int) ->
  let c = char_at pat p in
  if str_eq c "\\" && p + 1 < str_len pat then 2
  else if str_eq c "[" then rx_class_end pat (p + 1) - p
  else 1
// index just past the ] that closes a class opened before position i.
and rx_class_end = fn (pat: str) -> fn (i: int) ->
  if i >= str_len pat then i
  else if str_eq (char_at pat i) "]" then i + 1
  else if str_eq (char_at pat i) "\\" then rx_class_end pat (i + 2)
  else rx_class_end pat (i + 1)
// does c match the class body starting at p (just past the '[')?
and rx_class_match = fn (pat: str) -> fn (p: int) -> fn (c: str) ->
  let neg = p < str_len pat && str_eq (char_at pat p) "^" in
  let start = if neg then p + 1 else p in
  let inside = rx_class_test pat start c in
  if neg then (if inside then false else true) else inside
and rx_class_test = fn (pat: str) -> fn (p: int) -> fn (c: str) ->
  if p >= str_len pat || str_eq (char_at pat p) "]" then false
  else if p + 2 < str_len pat && str_eq (char_at pat (p + 1)) "-" && (if str_eq (char_at pat (p + 2)) "]" then false else true) then
    // a range like a-z
    let lo = ord (char_at pat p) in let hi = ord (char_at pat (p + 2)) in let cc = ord c in
    if cc >= lo && cc <= hi then true else rx_class_test pat (p + 3) c
  else if str_eq (char_at pat p) "\\" && p + 1 < str_len pat then
    let e = char_at pat (p + 1) in
    let m = (if str_eq e "d" then is_digit c
             else if str_eq e "w" then is_alnum c || str_eq c "_"
             else if str_eq e "s" then str_eq c " " || str_eq c "\t" || str_eq c "\n"
             else str_eq c e) in
    if m then true else rx_class_test pat (p + 2) c
  else if str_eq (char_at pat p) c then true
  else rx_class_test pat (p + 1) c

// ---- end-position variant of the matcher (for gsub/sub) -------------------
// rxe_here mirrors rx_here exactly but returns the index in s just PAST a
// match (or -1 on failure) instead of a bool. The bool path above is left
// untouched. rx_elem / rx_count / rx_group_hdr are shared.
and rxe_here = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) ->
  if p >= str_len pat then i
  else if str_eq (char_at pat p) "$" && p + 1 >= str_len pat then (if i >= str_len s then i else 0 - 1)
  // a top-level `|` means the current alternative matched: skip to scope end.
  else if str_eq (char_at pat p) "|" then rxe_here pat (rx_alt_scope_end pat p 0) s i
  else if str_eq (char_at pat p) "(" then
    let g = rx_count pat "(" p + 1 in
    let q = rx_close pat (p + 1) 1 in
    let quant = (if q + 1 < str_len pat then char_at pat (q + 1) else "") in
    let _ = map_set rx_caps ("s" ++ str_of_int g) i in
    let _ = map_set rx_caps ("it" ++ str_of_int g) i in
    if str_eq quant "?" || str_eq quant "*" then
      (let r = rxe_alts pat (rx_group_hdr pat (p + 1)) s i in
       if r >= 0 then r else (let _ = rx_unset_cap g in rxe_here pat (q + 2) s i))
    else rxe_alts pat (rx_group_hdr pat (p + 1)) s i
  else if str_eq (char_at pat p) ")" then
    let g = rx_count pat ")" p + 1 in
    let _ = map_set rx_caps ("e" ++ str_of_int g) i in
    let nx = (if p + 1 < str_len pat then char_at pat (p + 1) else "") in
    if str_eq nx "?" then rxe_here pat (p + 2) s i
    else if str_eq nx "*" || str_eq nx "+" then
      (let itstart = (if map_has rx_caps ("it" ++ str_of_int g) then map_get rx_caps ("it" ++ str_of_int g) else i) in
       let ss = map_get rx_caps ("s" ++ str_of_int g) in
       if i > itstart then (let r = rxe_alts pat (rx_nth_open pat g 0 0) s i in
                            if r >= 0 then r
                            else (let _ = map_set rx_caps ("s" ++ str_of_int g) ss in let _ = map_set rx_caps ("e" ++ str_of_int g) i in rxe_here pat (p + 2) s i))
       else (let _ = map_set rx_caps ("s" ++ str_of_int g) ss in let _ = map_set rx_caps ("e" ++ str_of_int g) i in rxe_here pat (p + 2) s i))
    else rxe_here pat (p + 1) s i
  else if str_eq (char_at pat p) "\\" && p + 1 < str_len pat && is_digit (char_at pat (p + 1)) then
    let g = ord (char_at pat (p + 1)) - 48 in
    let ks = "s" ++ str_of_int g in let ke = "e" ++ str_of_int g in
    (if map_has rx_caps ks && map_has rx_caps ke then
       let cap = substring s (map_get rx_caps ks) (map_get rx_caps ke) in
       let clen = str_len cap in
       let quant = (if p + 2 < str_len pat then char_at pat (p + 2) else "") in
       if str_eq quant "+" then (if backref_at s i cap clen then rxe_backref_many pat (p + 3) s (i + clen) cap clen else 0 - 1)
       else if str_eq quant "*" then rxe_backref_many pat (p + 3) s i cap clen
       else (if backref_at s i cap clen then rxe_here pat (p + 2) s (i + clen) else 0 - 1)
     else 0 - 1)
  else
    let elen = rx_elen pat p in
    let quant = (if p + elen < str_len pat then char_at pat (p + elen) else "") in
    if str_eq quant "+" then
      (if i < str_len s && rx_elem pat p (char_at s i) then rxe_many pat p elen s (i + 1) else 0 - 1)
    else if str_eq quant "*" then rxe_many pat p elen s i
    else if str_eq quant "?" then
      (if i < str_len s && rx_elem pat p (char_at s i)
       then (let r = rxe_here pat (p + elen + 1) s (i + 1) in if r >= 0 then r else rxe_here pat (p + elen + 1) s i)
       else rxe_here pat (p + elen + 1) s i)
    else
      (if i < str_len s && rx_elem pat p (char_at s i) then rxe_here pat (p + elen) s (i + 1) else 0 - 1)

// greedy zero-or-more, returning the furthest end that lets the rest match.
and rxe_many = fn (pat: str) -> fn (p: int) -> fn (elen: int) -> fn (s: str) -> fn (i: int) ->
  if i < str_len s && rx_elem pat p (char_at s i) then
    (let r = rxe_many pat p elen s (i + 1) in if r >= 0 then r else rxe_here pat (p + elen + 1) s i)
  else rxe_here pat (p + elen + 1) s i

// end-index variant of rx_alts: try each `|`-alternative, returning the end
// index of the first that matches (or -1).
and rxe_alts = fn (pat: str) -> fn (p: int) -> fn (s: str) -> fn (i: int) ->
  let r = rxe_here pat p s i in
  if r >= 0 then r
  else let np = rx_next_alt pat p 0 in
       if np < 0 then (0 - 1) else rxe_alts pat np s i

// pattern offset past a leading ^ anchor (^ matches only at string start).
and rxe_start = fn (pat: str) ->
  if str_len pat > 0 && str_eq (char_at pat 0) "^" then 1 else 0
// first start position >= i at which pat matches, or -1.
and rx_find_start = fn (pat: str) -> fn (s: str) -> fn (i: int) ->
  if str_len pat > 0 && str_eq (char_at pat 0) "^" then
    (if i <= 0 && rxe_alts pat 1 s 0 >= 0 then 0 else 0 - 1)
  else rx_find_start_go pat s i
and rx_find_start_go = fn (pat: str) -> fn (s: str) -> fn (i: int) ->
  if i > str_len s then 0 - 1
  else if rxe_alts pat 0 s i >= 0 then i
  else rx_find_start_go pat s (i + 1)

// expand backrefs in a gsub replacement against the current match: \& / \0
// is the whole match [mst,men); \1..\9 are capture groups (from rx_caps).
and rx_expand_rep = fn (rep: str) -> fn (s: str) -> fn (mst: int) -> fn (men: int) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len rep in
  if i >= n then acc
  else
    let c = char_at rep i in
    if str_eq c "\\" && i + 1 < n then
      let d = char_at rep (i + 1) in
      if str_eq d "&" || str_eq d "0" then rx_expand_rep rep s mst men (i + 2) (acc ++ substring s mst men)
      else if is_digit d then
        let g = ord d - 48 in
        let gs = "s" ++ str_of_int g in let ge = "e" ++ str_of_int g in
        let piece = if map_has rx_caps gs && map_has rx_caps ge then
                      (let a = map_get rx_caps gs in let b = map_get rx_caps ge in if b >= a then substring s a b else "")
                    else "" in
        rx_expand_rep rep s mst men (i + 2) (acc ++ piece)
      else rx_expand_rep rep s mst men (i + 2) (acc ++ d)
    else rx_expand_rep rep s mst men (i + 1) (acc ++ c)

// gsub/sub with a BLOCK: for each match, publish $~/$1..$9, call the block
// with the whole match string, and use its (to_s'd) result as the
// replacement. all=true replaces every match, all=false only the first.
and rx_gsub_blk = fn world -> fn newblk -> fn (pat: str) -> fn (s: str) -> fn (all: bool) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len s in
  let ps = rxe_start pat in
  let st = rx_find_start pat s i in
  if st < 0 then acc ++ substring s i n
  else
    let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    let _ = rx_clear_caps 1 in
    let en0 = rxe_alts pat ps s st in
    let en = if en0 < 0 then st else en0 in
    let m = substring s st en in
    let _ = rx_publish world pat s (VInt st) in
    let rep = to_s (flow_value (run_block world nb newblk (Cons (mkstr m, Nil)))) in
    if en <= st then
      // zero-width match: insert the replacement, copy one char, advance.
      let acc2 = acc ++ substring s i st ++ rep in
      if all then (if st >= n then acc2 else rx_gsub_blk world newblk pat s all (st + 1) (acc2 ++ substring s st (st + 1)))
      else acc2 ++ substring s st n
    else
      let acc2 = acc ++ substring s i st ++ rep in
      if all then rx_gsub_blk world newblk pat s all en acc2
      else acc2 ++ substring s en n

// gsub/sub against a regex pattern, expanding \& / \0 / \1..\9 in the
// replacement. all=true replaces every match, all=false only the first.
and rx_gsub_go = fn (pat: str) -> fn (s: str) -> fn (rep: str) -> fn (i: int) -> fn (all: bool) -> fn (acc: str) ->
  let n = str_len s in
  let ps = rxe_start pat in
  let st = rx_find_start pat s i in
  if st < 0 then acc ++ substring s i n
  else
    let _ = rx_clear_caps 1 in
    let en0 = rxe_alts pat ps s st in
    let en = if en0 < 0 then st else en0 in
    if en <= st then
      // zero-width match: insert the replacement here, then copy one char and
      // advance (so // interleaves rep around every character, as in Ruby).
      let acc2 = acc ++ substring s i st ++ rx_expand_rep rep s st st 0 "" in
      if all then
        (if st >= n then acc2 else rx_gsub_go pat s rep (st + 1) all (acc2 ++ substring s st (st + 1)))
      else acc2 ++ substring s st n
    else
      let acc2 = acc ++ substring s i st ++ rx_expand_rep rep s st en 0 "" in
      if all then rx_gsub_go pat s rep en all acc2
      else acc2 ++ substring s en n

// String#scan: collect every non-overlapping match. With no capture group
// each item is the whole match; with groups each item is an array of the
// group substrings. (Non-capturing (?: groups are not discounted — the same
// limitation as $1..$9, and rare in scan patterns.)
and rx_group_count = fn (pat: str) -> fn (i: int) -> fn (n: int) ->
  if i >= str_len pat then n
  else if str_eq (char_at pat i) "(" &&
          (if i + 1 < str_len pat then (if str_eq (char_at pat (i + 1)) "?" then false else true) else true)
  then rx_group_count pat (i + 1) (n + 1)
  else rx_group_count pat (i + 1) n

and rx_scan_groups = fn (s: str) -> fn (g: int) -> fn (ng: int) ->
  if g > ng then Nil
  else
    let ks = "s" ++ str_of_int g in
    let ke = "e" ++ str_of_int g in
    let v = (if map_has rx_caps ks && map_has rx_caps ke then
               (let a = map_get rx_caps ks in let b = map_get rx_caps ke in
                if b >= a then mkstr (substring s a b) else VNil)
             else VNil) in
    Cons (v, rx_scan_groups s (g + 1) ng)

and rx_scan_all = fn (pat: str) -> fn (s: str) -> fn (i: int) -> fn (ng: int) ->
  let ps = rxe_start pat in
  let st = rx_find_start pat s i in
  if st < 0 then Nil
  else
    let _ = rx_clear_caps 1 in
    let en0 = rxe_alts pat ps s st in
    let en = (if en0 < 0 then st else en0) in
    let item = (if ng == 0 then mkstr (substring s st en) else arr_new (rx_scan_groups s 1 ng)) in
    let nexti = (if en > st then en else st + 1) in
    Cons (item, rx_scan_all pat s nexti ng)

// ---- new-engine consumers (scan / gsub / gsub-block), legacy fallback -----

and rx_scan_all2 = fn (pat: str) -> fn (fl: str) -> fn (s: str) -> fn (i: int) ->
  match rxv_search pat fl s i with
  | RBadPat -> rx_scan_all pat s i (rx_group_count pat 0 0)
  | RNoHit -> Nil
  | RHit (st, en, saves) ->
    let ng = rxv_prog_ng (map_get rx_progs (fl ++ chr 1 ++ pat)) in
    let _ = rxv_export_caps saves ng in
    let item = (if ng == 0 then mkstr (substring s st en) else arr_new (rx_scan_groups s 1 ng)) in
    let nexti = (if en > st then en else st + 1) in
    Cons (item, rx_scan_all2 pat fl s nexti)

and rx_gsub_go2 = fn (pat: str) -> fn (fl: str) -> fn (s: str) -> fn (rep: str) -> fn (i: int) -> fn (all: bool) -> fn (acc: str) ->
  let n = str_len s in
  match rxv_search pat fl s i with
  | RBadPat -> rx_gsub_go pat s rep i all acc
  | RNoHit -> acc ++ substring s i n
  | RHit (st, en, saves) ->
    let _ = rxv_export_caps saves (rxv_prog_ng (map_get rx_progs (fl ++ chr 1 ++ pat))) in
    if en <= st then
      // zero-width match: insert the replacement here, copy one char, advance.
      (let acc2 = acc ++ substring s i st ++ rx_expand_rep rep s st st 0 "" in
       if all then
         (if st >= n then acc2 else rx_gsub_go2 pat fl s rep (st + 1) all (acc2 ++ substring s st (st + 1)))
       else acc2 ++ substring s st n)
    else
      (let acc2 = acc ++ substring s i st ++ rx_expand_rep rep s st en 0 "" in
       if all then rx_gsub_go2 pat fl s rep en all acc2
       else acc2 ++ substring s en n)

and rx_gsub_blk2 = fn world -> fn newblk -> fn (pat: str) -> fn (fl: str) -> fn (s: str) -> fn (all: bool) -> fn (i: int) -> fn (acc: str) ->
  let n = str_len s in
  match rxv_search pat fl s i with
  | RBadPat -> rx_gsub_blk world newblk pat s all i acc
  | RNoHit -> acc ++ substring s i n
  | RHit (st, en, saves) ->
    let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    let ng2 = rxv_prog_ng (map_get rx_progs (fl ++ chr 1 ++ pat)) in
    let _ = rxv_export_caps saves ng2 in
    let m = substring s st en in
    let _ = rx_publish_at world s st en ng2 in
    let rep = to_s (flow_value (run_block world nb newblk (Cons (mkstr m, Nil)))) in
    if en <= st then
      (let acc2 = acc ++ substring s i st ++ rep in
       if all then (if st >= n then acc2 else rx_gsub_blk2 world newblk pat fl s all (st + 1) (acc2 ++ substring s st (st + 1)))
       else acc2 ++ substring s st n)
    else
      (let acc2 = acc ++ substring s i st ++ rep in
       if all then rx_gsub_blk2 world newblk pat fl s all en acc2
       else acc2 ++ substring s en n)

// String#split with a regex separator: the pieces between matches, captured
// groups spliced in (participating ones), trailing empty strings removed.
and rx_split = fn (pat: str) -> fn (fl: str) -> fn (s: str) ->
  if str_eq s "" then Nil
  else rx_split_trim (rx_split_go pat fl s 0 Nil)
and rx_split_go = fn (pat: str) -> fn (fl: str) -> fn (s: str) -> fn (i: int) -> fn (acc: Val list) ->
  match rxv_search pat fl s i with
  | RBadPat -> rev_app acc (Cons (mkstr (substring s i (str_len s)), Nil))
  | RNoHit -> rev_app acc (Cons (mkstr (substring s i (str_len s)), Nil))
  | RHit (st, en, saves) ->
    let ng = rxv_prog_ng (map_get rx_progs (fl ++ chr 1 ++ pat)) in
    if en <= st then
      (if st >= str_len s then rev_app acc Nil
       else rx_split_go pat fl s (st + 1) (rx_split_caps saves ng s 1 (Cons (mkstr (substring s i (st + 1)), acc))))
    else rx_split_go pat fl s en (rx_split_caps saves ng s 1 (Cons (mkstr (substring s i st), acc)))
and rx_split_caps = fn (saves: (int * int) list) -> fn (ng: int) -> fn (s: str) -> fn (g: int) -> fn (acc: Val list) ->
  if g > ng then acc
  else
    let a = rxv_slot_get saves (2 * g) in
    let b = rxv_slot_get saves (2 * g + 1) in
    rx_split_caps saves ng s (g + 1) (if a >= 0 && b >= a then Cons (mkstr (substring s a b), acc) else acc)
and rx_split_trim = fn (xs: Val list) ->
  rev_app (rx_split_lead (rev_app xs Nil)) Nil
and rx_split_lead = fn (xs: Val list) ->
  match xs with
  | Cons (VStr h, t) -> if str_eq (sget h) "" then rx_split_lead t else xs
  | _ -> xs

// subjectless case: the first when whose any condition is truthy wins.
and run_case_truthy = fn env -> fn world -> fn blk -> fn whens -> fn (els: Stmt list) ->
  match whens with
  | Nil -> run_stmts env world blk els
  | Cons (w, rest) ->
    let (vs, b) = w in
    if any_truthy env world blk vs then run_stmts env world blk b
    else run_case_truthy env world blk rest els

and any_truthy = fn env -> fn world -> fn blk -> fn (vs: Expr list) ->
  match vs with
  | Nil -> false
  | Cons (e, t) ->
    (match e with
     | ESplat inner -> (match eval_e env world blk inner with VArr id -> any_val_truthy (deref id) | _ -> false)
     | _ -> truthy (eval_e env world blk e))
    || any_truthy env world blk t

and any_val_truthy = fn (xs: Val list) ->
  match xs with Nil -> false | Cons (h, t) -> truthy h || any_val_truthy t

and print_each = fn world -> fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (v, t) -> let _ = puts_one_nonl world v in print_each world t

// like puts_one but without the trailing newline (for Kernel#print).
and puts_one_nonl = fn world -> fn (v: Val) ->
  match v with
  | VStr s -> let s = sget s in out_print_no_nl s
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls (str_of_int id) in
    let noblk = (false, (Nil : str list), (Nil : Stmt list), ivars) in
    if has_meth world cls "to_s" then
      (match invoke world noblk v cls "to_s" Nil with VStr s -> let s = sget s in out_print_no_nl s | other -> out_print_no_nl (to_s other))
    else out_print_no_nl (to_s v)
  | _ -> out_print_no_nl (to_s v)

and p_print = fn (args: Val list) ->
  match args with
  | Nil -> ()
  | Cons (v, t) -> let _ = out_print (inspect v) in p_print t

and puts_args = fn env -> fn world -> fn blk -> fn (es: Expr list) ->
  match es with
  | Nil -> ()
  | Cons (e, t) ->
    let _ = puts_one world (eval_e env world blk e) in
    puts_args env world blk t

// puts of one value: arrays flatten recursively; an object uses its
// user-defined to_s if present (Ruby would otherwise print an address,
// which cannot be byte-matched — corpus objects define to_s).
and puts_one = fn world -> fn (v: Val) ->
  match v with
  | VArr id -> puts_each world (deref id)
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls (str_of_int id) in
    let noblk = (false, (Nil : str list), (Nil : Stmt list), ivars) in
    if has_meth world cls "to_s" then
      (match invoke world noblk v cls "to_s" Nil with VStr s -> let s = sget s in out_print s | other -> out_print (to_s other))
    else if map_has enc_name (str_of_int id) then out_print (map_get enc_name (str_of_int id))
    else out_print ("#<" ++ display_cls world cls ++ ">")
  // a string already ending in a newline doesn't get another (Ruby puts).
  | VStr s -> let s = sget s in
    if str_len s > 0 && str_eq (char_at s (str_len s - 1)) "\n"
    then out_print (substring s 0 (str_len s - 1))
    else out_print s
  | _ -> out_print (to_s v)

and puts_each = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> ()
  | Cons (h, t) -> let _ = puts_one world h in puts_each world t;

// run a program; when print_result is true, print the last statement's
// value with no trailing newline (bootstraptest's `print(begin; ...; end)`
// model, used by the --eval-print harness mode).
let run_prog = fn (path: str) -> fn (print_result: bool) ->
  let _ = map_set load_ctx "dir" (mkstr (dirname_of path)) in
  let _ = map_set loaded_files path VNil in
  let src = read_file path in
  let cod0 = src_coding src in
  let _ = map_set load_ctx "coding" (mkstr (if str_eq cod0 "" then "UTF-8" else cod0)) in
  let toks = lex_go src 0 in
  let (prog, rest) = parse_stmts toks Nil in
  let _ = rx_check_pending () in
  let _ =
    (match rest with
     | Cons (TEOF, _) -> ()
     | _ -> fail "mere-ruby: unexpected token at top level") in
  let env = map_new () in
  let meths = map_new () in
  let sup = map_new () in
  let ocls = map_new () in
  let ivars = map_new () in
  // Encoding objects (VObj of class Encoding, name in @name). Shared instances
  // stored in enc_objs; the constants point at them. String#encoding returns
  // the matching one, so `x.encoding == Encoding::UTF_8` holds by identity.
  let mk_enc = fn (nm: str) ->
    let id = map_len ocls in
    let _ = map_set ocls (str_of_int id) "Encoding" in
    let _ = map_set ivars (str_of_int id ++ "@name") (mkstr nm) in
    let o = VObj id in
    let _ = map_set enc_objs nm o in
    let _ = map_set enc_name (str_of_int id) nm in o in
  let _ = map_set consts "Encoding::UTF_8" (mk_enc "UTF-8") in
  let _ = map_set consts "Encoding::US_ASCII" (mk_enc "US-ASCII") in
  let _ = map_set consts "Encoding::ASCII_8BIT" (mk_enc "ASCII-8BIT") in
  let _ = map_set consts "Encoding::BINARY" (if map_has enc_objs "ASCII-8BIT" then map_get enc_objs "ASCII-8BIT" else mkstr "ASCII-8BIT") in
  let _ = map_set consts "Encoding::ISO_8859_1" (mk_enc "ISO-8859-1") in
  let _ = map_set consts "Encoding::ASCII" (if map_has enc_objs "US-ASCII" then map_get enc_objs "US-ASCII" else mkstr "US-ASCII") in
  let _ = map_set consts "Encoding::UTF_16LE" (mk_enc "UTF-16LE") in
  let _ = map_set consts "Encoding::UTF_16BE" (mk_enc "UTF-16BE") in
  let _ = map_set consts "Encoding::UTF_32LE" (mk_enc "UTF-32LE") in
  let _ = map_set consts "Encoding::UTF_32BE" (mk_enc "UTF-32BE") in
  // dummy encodings (see enc_is_dummy).
  let _ = map_set consts "Encoding::UTF_16" (mk_enc "UTF-16") in
  let _ = map_set consts "Encoding::UTF_32" (mk_enc "UTF-32") in
  let _ = map_set consts "Encoding::ISO_2022_JP" (mk_enc "ISO-2022-JP") in
  let _ = map_set consts "Encoding::ISO_2022_JP_2" (mk_enc "ISO-2022-JP-2") in
  let _ = map_set consts "Encoding::ISO_2022_JP_KDDI" (mk_enc "ISO-2022-JP-KDDI") in
  let _ = map_set consts "Encoding::IBM037" (mk_enc "IBM037") in
  let _ = map_set consts "Encoding::IBM437" (mk_enc "IBM437") in
  let _ = map_set consts "Encoding::CP50220" (mk_enc "CP50220") in
  let _ = map_set consts "Encoding::CP50221" (mk_enc "CP50221") in
  let _ = map_set consts "Encoding::UTF_7" (mk_enc "UTF-7") in
  let _ = map_set consts "Encoding::SHIFT_JIS" (mk_enc "Shift_JIS") in
  let _ = map_set consts "Encoding::Shift_JIS" (if map_has enc_objs "Shift_JIS" then map_get enc_objs "Shift_JIS" else mkstr "Shift_JIS") in
  let _ = map_set consts "Encoding::EUC_JP" (mk_enc "EUC-JP") in
  let _ = map_set consts "Enumerator::Chain" (VClass "Enumerator::Chain") in
  let _ = map_set consts "Enumerator::Yielder" (VClass "Enumerator::Yielder") in
  let _ = map_set consts "Enumerator::Lazy" (VClass "Enumerator::Lazy") in
  let _ = map_set consts "Regexp::IGNORECASE" (VInt 1) in
  let _ = map_set consts "Regexp::EXTENDED" (VInt 2) in
  let _ = map_set consts "Regexp::MULTILINE" (VInt 4) in
  let _ = map_set consts "Math::PI" (VFlt 3.141592653589793) in
  let _ = map_set consts "Math::E" (VFlt 2.718281828459045) in
  // TOPLEVEL_BINDING: a binding whose lexical scope is the top level, so
  // eval("Const", TOPLEVEL_BINDING) resolves constants at the top level.
  let _ = (let tenv = map_new () in
           let _ = map_set tenv "__cref" (mkstr "") in
           let _ = map_set tenv "self" VMain in
           let bid = map_len bind_store in
           let _ = map_set bind_store (str_of_int bid) tenv in
           map_set consts "TOPLEVEL_BINDING" (VBind bid)) in
  // Exception#initialize(msg = nil) sets @message, so a user exception's
  // `super(msg)` records the message (read back by make_exc_w).
  let _ = map_set meths "Exception#initialize" (Meth (Cons ("msg", Nil), Cons (("msg", ENil), Nil), Cons (SIVarAssign ("message", EVar "msg"), Nil))) in
  let _ = map_set sup "StandardError" "Exception" in
  let _ = map_set sup "RuntimeError" "StandardError" in
  let _ = map_set sup "ArgumentError" "StandardError" in
  let _ = map_set sup "TypeError" "StandardError" in
  let _ = map_set sup "RangeError" "StandardError" in
  let _ = map_set sup "IndexError" "StandardError" in
  let _ = map_set sup "KeyError" "StandardError" in
  let _ = map_set sup "ZeroDivisionError" "StandardError" in
  let _ = map_set sup "NotImplementedError" "StandardError" in
  let _ = map_set sup "EncodingError" "StandardError" in
  let _ = map_set sup "RegexpError" "StandardError" in
  let _ = map_set sup "Encoding::UndefinedConversionError" "EncodingError" in
  let _ = map_set sup "Encoding::CompatibilityError" "EncodingError" in
  let _ = map_set sup "NameError" "StandardError" in
  let _ = map_set sup "NoMethodError" "NameError" in
  let _ = map_set sup "StopIteration" "StandardError" in
  let _ = map_set sup "FrozenError" "RuntimeError" in
  let _ = map_set sup "ScriptError" "Exception" in
  let _ = map_set sup "SyntaxError" "ScriptError" in
  let _ = map_set sup "LoadError" "ScriptError" in
  let _ = map_set sup "IOError" "StandardError" in
  let _ = map_set sup "SystemCallError" "StandardError" in
  let _ = map_set sup "Errno::ENOENT" "SystemCallError" in
  let _ = map_set sup "EOFError" "IOError" in
  let _ = map_set sup "LocalJumpError" "StandardError" in
  let _ = map_set sup "UncaughtThrowError" "ArgumentError" in
  let _ = map_set sup "NoMatchingPatternError" "StandardError" in
  let _ = map_set sup "NoMatchingPatternKeyError" "NoMatchingPatternError" in
  // built-in value classes, so reopened methods resolve up the real chain
  // (class Integer / class Object monkey-patching reaches every value).
  let _ = map_set sup "Class" "Module" in
  let _ = map_set sup "Module" "Object" in
  let _ = map_set sup "Integer" "Numeric" in
  let _ = map_set sup "Float" "Numeric" in
  let _ = map_set sup "Numeric" "Object" in
  let _ = map_set sup "String" "Object" in
  let _ = map_set sup "Array" "Object" in
  let _ = map_set sup "Hash" "Object" in
  let _ = map_set sup "Symbol" "Object" in
  let _ = map_set sup "Range" "Object" in
  let _ = map_set sup "Proc" "Object" in
  let _ = map_set sup "NilClass" "Object" in
  let _ = map_set sup "TrueClass" "Object" in
  let _ = map_set sup "FalseClass" "Object" in
  let world = (meths, sup, ocls, ivars) in
  let _ = register_builtin_consts () in
  let _ = map_set step_budget "n" 50000000 in   // loop-iteration cap (infinite-loop guard)
  let _ = map_set env "self" VMain in   // top-level self is `main`
  // $: / $LOAD_PATH are the SAME array (aliased by handle); likewise $" /
  // $LOADED_FEATURES. require searches the load path and records features.
  let lp0 = arr_new Nil in
  let _ = map_set globals ":" lp0 in
  let _ = map_set globals "LOAD_PATH" lp0 in
  let lf0 = arr_new Nil in
  let _ = map_set globals "\"" lf0 in
  let _ = map_set globals "LOADED_FEATURES" lf0 in
  // STDOUT / STDERR / STDIN: IO objects keyed by @__io_fd; $stdout/$stderr
  // are globals holding the same objects.
  let outid = map_len ocls in
  let _ = map_set ocls (str_of_int outid) "IO" in
  let _ = map_set ivars (str_of_int outid ++ "@__io_fd") (VInt 1) in
  let _ = map_set consts "STDOUT" (VObj outid) in
  let _ = map_set globals "stdout" (VObj outid) in
  let errid = map_len ocls in
  let _ = map_set ocls (str_of_int errid) "IO" in
  let _ = map_set ivars (str_of_int errid ++ "@__io_fd") (VInt 2) in
  let _ = map_set consts "STDERR" (VObj errid) in
  let _ = map_set globals "stderr" (VObj errid) in
  let inid = map_len ocls in
  let _ = map_set ocls (str_of_int inid) "IO" in
  let _ = map_set ivars (str_of_int inid ++ "@__io_fd") (VInt 0) in
  let _ = map_set consts "STDIN" (VObj inid) in
  let _ = map_set globals "stdin" (VObj inid) in
  // ENV (reads go through getenv, writes overlay), ARGV, $0/$PROGRAM_NAME.
  let envid = map_len ocls in
  let _ = map_set ocls (str_of_int envid) "EnvHash" in
  let _ = map_set consts "ENV" (VObj envid) in
  let _ = map_set consts "ARGV" (if map_has cli_argv "v" then map_get cli_argv "v" else arr_new Nil) in
  let _ = map_set globals "0" (mkstr path) in
  let _ = map_set globals "PROGRAM_NAME" (mkstr path) in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  let final = hoist_run env world noblk prog in
  if print_result then
    (match final with
     | FNext (VObj id) ->
       let cls = map_get ocls (str_of_int id) in
       if has_meth world cls "to_s" then
         (match invoke world noblk (VObj id) cls "to_s" Nil with VStr s -> let s = sget s in print_no_nl s | other -> print_no_nl (to_s other))
       else print_no_nl (to_s (VObj id))
     | FNext v -> print_no_nl (to_s v)
     | _ -> ())
  else ();

// consume CLI flags (--enable/--disable-frozen-string-literal), returning the
// remaining args with those flags removed (mutating cli_fsl as a side effect).
let rec take_flags = fn (argl: str list) ->
  match argl with
  | Nil -> Nil
  | Cons (a, rest) ->
    if str_eq a "--enable-frozen-string-literal" then let _ = map_set cli_fsl "on" "1" in take_flags rest
    else if str_eq a "--disable-frozen-string-literal" then let _ = (if map_has cli_fsl "on" then map_delete cli_fsl "on" else ()) in take_flags rest
    else Cons (a, take_flags rest);

let run_cli = fn () ->
  match take_flags (args ()) with
  | Nil -> let _ = print "usage: mere-ruby <script.rb>" in 2
  | Cons (a0, rest) ->
    if str_eq a0 "--eval-print" then
      (match rest with
       | Cons (path, rest2) -> let _ = map_set cli_file "p" path in let _ = map_set cli_argv "v" (arr_new (strs_to_vals rest2)) in let _ = run_prog path true in 0
       | Nil -> let _ = print "usage: mere-ruby --eval-print <script.rb>" in 2)
    else let _ = map_set cli_file "p" a0 in let _ = map_set cli_argv "v" (arr_new (strs_to_vals rest)) in let _ = run_prog a0 false in 0;

exit (run_cli ())
