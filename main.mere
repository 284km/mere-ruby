          prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | Cons (other, _) ->
          prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 2)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "setbyte") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'setbyte'")) in fail "mere-ruby: undefined method 'setbyte'")))
  else if str_eq name "bytesplice" then
    // bytesplice(idx, len, str[, sidx, slen]) / bytesplice(range, str[, srange]):
    // BYTE offsets, each end checked against character boundaries; the result
    // carries the receiver-vs-piece negotiated encoding; answers self.
    (match recv with
     | VStr h ->
       (let s = sget h in
        let bs = str_len s in
        let e = enc_canon_name (senc_get h) in
        // boundary: a UTF-8 offset must not point INTO a character.
        let ck = fn (t: str) -> fn (te: str) -> fn (i: int) ->
          (if str_eq te "UTF-8"
              && i > 0 && i < str_len t && (let o = ord (char_at t i) in o >= 128 && o < 192)
           then (let _ = prim_raise "IndexError" ("offset " ++ str_of_int i ++ " does not land on character boundary") in ())
           else ()) in
        // (start, length) from an index/length pair -- ruby's own errors.
        let ridl = fn (i0: int) -> fn (l0: int) -> fn (n: int) ->
          (let _ = (if i0 < 0 - n || i0 > n
                    then (let _ = prim_raise "IndexError" ("index " ++ str_of_int i0 ++ " out of string") in ()) else ()) in
           let _ = (if l0 < 0 then (let _ = prim_raise "IndexError" ("negative length " ++ str_of_int l0) in ()) else ()) in
           let st = (if i0 < 0 then i0 + n else i0) in
           (st, (if l0 > n - st then n - st else l0))) in
        // (start, length) from a range -- out-of-range is a RangeError, and a
        // backwards range means length 0.
        let rrng = fn (lov: Val) -> fn (hiv: Val) -> fn (ex: bool) -> fn (n: int) ->
          (let lo = (match lov with VInt x -> x | _ -> 0) in
           let hi = (match hiv with VInt x -> x | _ -> n - 1) in
           let _ = (if lo < 0 - n || lo > n
                    then (let _ = prim_raise "RangeError" (inspect (VRange (lov, hiv, ex)) ++ " out of range") in ()) else ()) in
           let st = (if lo < 0 then lo + n else lo) in
           let en0 = (if hi < 0 then hi + n else hi) in
           let en = (if ex then en0 else en0 + 1) in
           let ln = en - st in
           let ln = (if ln < 0 then 0 else ln) in
           (st, (if ln > n - st then n - st else ln))) in
        let splice = fn (st: int) -> fn (ln: int) -> fn (rh: int) -> fn (sst: int) -> fn (sln: int) ->
          (let sub = sget rh in
           let piece = substring sub sst (sst + sln) in
           let renc = enc_compat2 (senc_get h) s (senc_get rh) piece in
           let _ = (if str_eq renc "" then
                      (let _ = prim_raise "Encoding::CompatibilityError"
                                 ("incompatible character encodings: " ++ e ++ " and " ++ enc_canon_name (senc_get rh)) in ())
                    else ()) in
           let _ = sset h (substring s 0 st ++ piece ++ substring s (st + ln) bs) in
           let _ = senc_set h renc in
           VStr h) in
        // ⚠ FOUR SHAPES, not two. Since ruby 3.3 the replacement can be sliced
        // too -- `bytesplice(idx, len, str, sidx, slen)` and
        // `bytesplice(range, str, srange)` -- and the reference here is 4.0.6.
        // This arm was written against 3.2.2, where those did not exist, and
        // refused them as arity errors; the note saying so outlived its reason.
        // The source slice is checked against the SOURCE's length with the same
        // rules, which is where "index 99 out of string" comes from.
        // ⚠ TWO, THREE or FIVE -- never four. The (idx, len, str) form takes a
        // (sidx, slen) pair or nothing, and the (range, str) form takes a
        // range or nothing, so four arguments is never a shape.
        let na = val_list_len args in
        if na < 2 || na == 4 || na > 5 then
          prim_raise "ArgumentError" ("wrong number of arguments (given " ++ str_of_int na ++ ", expected 2, 3, or 5)")
        else if val_frozen_mut recv then prim_raise "FrozenError" ("can't modify frozen String: " ++ inspect recv)
        else
        match args with
        // (idx, len, str) and (idx, len, str, sidx, slen)
        | Cons (VInt i0, Cons (VInt l0, Cons (VStr rh, srest))) ->
          (let sb = str_len (sget rh) in
           let (sst, sln) =
             (match srest with
              | Nil -> (0, sb)
              | Cons (VInt si, Cons (VInt sl, _)) -> ridl si sl sb
              | _ -> (match prim_raise "TypeError" "no implicit conversion into Integer" with _ -> (0, 0))) in
           match ridl i0 l0 bs with
           | (st, ln) ->
             let _ = ck s e st in
             let _ = ck s e (st + ln) in
             let se9 = enc_canon_name (senc_get rh) in
             let _ = ck (sget rh) se9 sst in
             let _ = ck (sget rh) se9 (sst + sln) in
             splice st ln rh sst sln)
        // (range, str) and (range, str, srange) / (range, str, sidx, slen)
        | Cons (VRange (lo, hi, ex), Cons (VStr rh, srest)) ->
          (let sb = str_len (sget rh) in
           let (sst, sln) =
             (match srest with
              | Nil -> (0, sb)
              | Cons (VRange (slo, shi, sex), _) -> rrng slo shi sex sb
              | _ -> (match prim_raise "TypeError" "no implicit conversion into Integer" with _ -> (0, 0))) in
           match rrng lo hi ex bs with
           | (st, ln) ->
             let _ = ck s e st in
             let _ = ck s e (st + ln) in
             let se9 = enc_canon_name (senc_get rh) in
             let _ = ck (sget rh) se9 sst in
             let _ = ck (sget rh) se9 (sst + sln) in
             splice st ln rh sst sln)
        | Cons (VInt _, Cons (VStr _, _)) ->
          prim_raise "TypeError" "wrong argument type Integer (expected Range)"
        | Cons (_, Nil) -> prim_raise "ArgumentError" "wrong number of arguments (given 1, expected 2, 3, or 5)"
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 2, 3, or 5)"
        // the replacement must be a String: ruby names the class it was given.
        | Cons (VInt _, Cons (VInt _, Cons (other9, _))) ->
          prim_raise "TypeError" ("no implicit conversion of " ++ conv_name other9 ++ " into String")
        | Cons (VRange (_, _, _), Cons (other9, _)) ->
          prim_raise "TypeError" ("no implicit conversion of " ++ conv_name other9 ++ " into String")
        | _ -> prim_raise "TypeError" "no implicit conversion into Integer")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "bytesplice") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'bytesplice'")) in fail "mere-ruby: undefined method 'bytesplice'")))
  else if str_eq name "byteslice" then
    (match recv with
     | VStr h -> let a = sget h in let len = str_len a in
       (match args with
        | Cons (VInt i0, Cons (VInt n0, _)) ->
          let i = if i0 < 0 then i0 + len else i0 in
          if i < 0 || i > len || n0 < 0 then VNil
          else mkstr (substring a i (if i + n0 > len then len else i + n0))
        | Cons (VInt i0, _) ->
          let i = if i0 < 0 then i0 + len else i0 in
          if i < 0 || i >= len then VNil else mkstr (substring a i (i + 1))
        // a Range selects a BYTE span (same bounds rules as #[]'s).
        | Cons (VRange (lov, hiv, ex), _) ->
          (match rng_slice_bounds lov hiv ex len with
           | (st, en) ->
             if st < 0 || st > len then VNil
             else mkstr (substring a st (if en > len then len else if en < st then st else en)))
