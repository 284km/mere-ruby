    "class Set\n" ++
    "  include Enumerable\n" ++
    "\n" ++
    "  def self.[](*items)\n" ++
    "    new(items)\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize(enum = nil)\n" ++
    "    @hash = \{}\n" ++
    "    enum.each \{ |x| @hash[x] = true } if enum\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize_copy(orig)\n" ++
