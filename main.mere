     | _ -> (let _ = map_set prim_missing "n" (mkstr "flatten") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'flatten'")) in fail "mere-ruby: undefined method 'flatten'")))
