        | Cons (VInt d, Nil) -> arr_new (val_flatten (deref id) d)
        | Nil -> arr_new (val_flatten (deref id) (0 - 1))
        | Cons (VNil, Nil) -> arr_new (val_flatten (deref id) (0 - 1))
        | Cons (other, Nil) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | _ -> prim_raise "ArgumentError" ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..1)"))
