        // ASCII-8BIT at or above it, and RangeError outside. With an encoding it
        // is a CODEPOINT in that encoding, so UTF-8 reaches 0x10FFFF and
        // US-ASCII stops at 0x7F -- and out of range is a RangeError naming the
        // number, not an interpreter failure with no class (which is what every
        // one of these answered before).
        //
        // ⚠ ...except that a number ABOVE 255 is not out of range when
        // Encoding.default_internal is set: it is a character in THAT encoding,
        // and `n.chr` means `n.chr(Encoding.default_internal)`. Below 256 the
        // default_internal is ignored entirely -- 0..127 stays US-ASCII and
        // 128..255 stays binary whatever it is set to.
        if str_eq given "" then
          (let di9 = (if map_has def_int_enc "v"
                      then (match map_get def_int_enc "v" with
                            | VObj oi9 -> (if map_has enc_name (str_of_int oi9) then map_get enc_name (str_of_int oi9) else "")
                            | _ -> "")
                      else "") in
           if n >= 0 && n <= 255 then
             (let r = mkstr (chr n) in
              (match r with VStr rid -> (let _ = senc_set rid (if n < 128 then "US-ASCII" else "ASCII-8BIT") in r) | _ -> r))
           else if str_eq di9 "" then prim_raise "RangeError" (str_of_int n ++ " out of char range")
           else prim_method recv name (Cons (mkstr di9, Nil)))
        // the UTF-8 vendor variants encode a single codepoint exactly as UTF-8
        // does; they differ in NORMALISATION on conversion, which chr does not do.
        else if enc_utf8_family given || str_eq given "CESU-8" then
          (if n < 0 || n > 1114111 then prim_raise "RangeError" (str_of_int n ++ " out of char range")
           // ⚠ the SURROGATE half is a number in range that is not a character:
           // D800..DFFF exist only to pair up inside UTF-16, and ruby refuses
           // them by name. utf8_enc encoded them happily, so `0xD800.chr(...)`
           // produced three bytes no UTF-8 reader will accept.
           else if n >= 55296 && n <= 57343 then
