// the four names, as an array, for a receiver whose class chain is `cls`.
and vis_method_list = fn world -> fn (cls: str) -> fn (name: str) -> fn (args: Val list) ->
  let want = (if str_eq name "public_methods" then 1
              else if str_eq name "private_methods" then 2
              else if str_eq name "protected_methods" then 3 else 0) in
  let recur = (match args with
               | Cons (VBool false, _) -> false
               | Cons (VNil, _) -> false
               | _ -> true) in
