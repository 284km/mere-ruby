    "    @pos += 1\n" ++
    "    ch\n" ++
    "  end\n" ++
    "\n" ++
    "  def ungetc(_ch)\n" ++
    "    @pos -= 1 if @pos > 0\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def write(*args)\n" ++
    "    n = 0\n" ++
    "    args.each do |a|\n" ++
    "      s = a.to_s\n" ++
    "      n += s.length\n" ++
    "      @string = @string + s\n" ++
    "      @pos = @string.length\n" ++
    "    end\n" ++
    "    n\n" ++
    "  end\n" ++
    "\n" ++
    "  def <<(obj)\n" ++
    "    write(obj)\n" ++
    "    self\n" ++
    "  end\n" ++
    "\n" ++
    "  def print(*args)\n" ++
    "    args.each do |a|\n" ++
    "      write(a)\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def puts(*args)\n" ++
    "    if args.empty?\n" ++
