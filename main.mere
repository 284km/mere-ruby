and arr_hash_w = fn env -> fn world -> fn (id: int) ->
  let _ = (if map_has cyc_flag "f" then map_delete cyc_flag "f" else ()) in
  let r = arr_hash_rec env world id in
  if map_has cyc_flag "f" then 4919 else r

and arr_hash_rec = fn env -> fn world -> fn (id: int) ->
  if map_has cyc_seen ("h" ++ str_of_int id) then (let _ = map_set cyc_flag "f" 1 in 4919)
  else
