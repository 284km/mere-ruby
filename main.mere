// mere-ruby — a Ruby subset interpreter written in pure Mere. M0 + M1.
// NOTE: no `extern fn getenv` — an extern returning `str` yields a raw C
// pointer, not a Mere string, and using it for anything but printing
// segfaults. The environment is read through env(1); see env_load.
//
// M0: literals (integer, float, string, true/false/nil, array, hash),
// operators with Ruby precedence (** right-assoc, unary - !, * / %, + -,
// comparisons, == !=, && ||), parentheses, comments, and `puts`.
// Ruby semantics where they differ from C: floor division and
// sign-of-divisor modulo, value-returning && / ||, truthiness (only nil
// and false are falsy — 0 is truthy), puts flattening arrays recursively.
//
// M1: local variables (assignment / reassignment; the environment is a
// Mere Map, whose insertion-ordered semantics match Ruby's), and block
// control flow: if / elsif / else, unless, while, until, case / when
// (with multi-value `when a, b`), all with the multi-line ... end form.
//
// Verification: every corpus program must print byte-identical output to
// the reference `ruby` (see run_corpus.sh).
//
//   mere -c main.mere > mr.c && clang -O2 mr.c -o mere-ruby
//   ./mere-ruby script.rb

// ---- values and syntax trees --------------------------------------------
type Tok = TInt of int | TFlt of float | TStrL of str | TId of str
         | TBig of str  // an integer literal too large for a machine int
         // Rational literal as (num, den) canonical decimal strings (bignum /
         // exact-decimal safe); Complex (imaginary) literal `4i`.
         | TRat of str * str | TImag of int | TImagF of float | TImagRat of str * str
         | TSym of str | TP of str | TRegex of str * str | TNL of int | TEOF;

// EHsh / VHsh hold interleaved [k1, v1, k2, v2, ...] lists (M0
// simplification: literal order is preserved, which matches Ruby's
// insertion-ordered Hash for programs that only build literals).
type Expr = EInt of int | EBig of str | ERat of str * str | EImag of int | EImagF of float | EImagRat of str * str | EFlt of float | EStrL of str | EBool of bool
          | ENil | EArr of Expr list | EHsh of Expr list
          | EBin of str * Expr * Expr | EUn of str * Expr
          | EVar of str | ECall of str * Expr list
          // M3 object model:
          | ESym of str          // :name
          | ESelf                // self
          | EConst of str        // a capitalized name (a class reference)
          | EConstOrNil of str   // a const read that yields nil when undefined
          | EScopedAssign of Expr * str * Expr  // recv::Const = value (runtime recv)
          | EScopedRead of Expr * str  // recv::Const read (runtime recv)
          | EScopedReadOrNil of Expr * str  // recv::Const read, nil if undefined (for ||=)
          | EIVar of str         // @name
          | EMethod of Expr * str * Expr list  // recv.name(args)
          // op-assign on an attribute / index, evaluating recv (and indices)
          // exactly once: recv.name op= rhs / recv[idx..] op= rhs.
          | EAttrOp of Expr * str * str * Expr
          | EIdxOp of Expr * Expr list * str * Expr
          // M4 blocks / iterators:
          | ERange of Expr * Expr * bool         // lo..hi (bool = exclusive)
          // `name [items]` (space before bracket): indexing when name is a
          // live local, else a call with one array argument. Decided at eval.
          | EAmbigIdx of str * Expr list
          // a range in condition position: the flip-flop operator. The int
          // is the site id keying its hidden on/off state.
          | EFlipFlop of int * Expr * Expr * bool
          | EYield of Expr list                  // yield(args)
          // a call/method with a trailing block { |bp| body }: block params
          // and block body come last.
          | ECallB of str * Expr list * str list * Stmt list
          | EMethodB of Expr * str * Expr list * str list * Stmt list
          // M6 exceptions:
          | ERaise of Expr list                  // raise [Class][, msg]
          // M9: a splat argument `*expr` at a call site (expands an array).
          | ESplat of Expr
          // 2f: ternary `cond ? a : b`.
          | ETern of Expr * Expr * Expr
          // 2i: subjectless `case` marker (when-conditions are truthiness
          // tests); `defined?(e)` returns a description string or nil.
          | ECaseNone
          | EDefined of Expr
          // 2k: super. bool = zsuper (bare `super`, forward current args);
          // when false the args are explicit (super() or super(a, b)).
          | ESuper of bool * Expr list
          | ESuperB of bool * Expr list * str list * Stmt list  // super with a block
          // 2m: `&expr` block-pass marker in an argument list (only &:sym is
          // turned into a real block; other forms are best-effort).
          | EBlockPass of Expr
          // G2: assignment as an expression (`true && x = 1`, `f(x = 2)`).
          | EAssign of str * Expr
          // G2: -> (params) { body } lambda literal.
          | ELambda of str list * Stmt list
          // G2: a statement (if/unless/case/begin) used as an expression,
          // e.g. `if c ... end.should == x`.
          | EStmt of Stmt
          // G2: /pattern/ regex literal (body, flags e.g. "im").
          | ERegex of str * str
          // G2: break/next/redo/return in EXPRESSION position (fail-unwind).
          | EFlow of str * Expr
          // G3: safe navigation a&.b(args) — nil receiver yields nil.
          | ESafe of Expr * str * Expr list
          | ESafeB of Expr * str * Expr list * str list * Stmt list  // a&.m { blk }
          // G3: **hash argument at a call site.
          | EKwSplat of Expr
          // a trailing keyword-argument hash from `key: value` call syntax
          // (distinct from a `{...}` hash literal so kwargs and a positional
          // hash argument can be kept separate, per Ruby 3.0).
          | EKwHash of Expr list
          // one-line pattern matching: `expr in pat` yields true/false;
          // `expr => pat` matches-or-raises NoMatchingPatternError (value nil).
          | EMatchTest of Expr * Pat
          | EMatchBind of Expr * Pat;

// SIf: clause list ((condition, body) pairs — the if plus each elsif)
// and the else body (Nil when absent). unless / until desugar to a
// negated condition at parse time. SCase: subject, when-clauses (each:
// candidate values, body), else body. SDef: name, params, body.
// M3: SClass name, superclass ("" = none), body (defs / attrs);
// SIVarAssign @name = e; SAttr mode ("r"/"w"/"rw"), symbol names.
type Stmt = SPuts of Expr list | SExpr of Expr
          // where the statement that follows was written. The parser emits one
          // before each statement it reads (see parse_stmts); the evaluator sets
          // the current line from it, which is what lets an error name a line.
          | SLine of int
          // ... and one at the head of each parsed statement list, naming the
          // file. `load_ctx` knows the file being LOADED, which stops being the
          // right answer the moment a method is called after its file finished.
          | SFile of str
          | SAssign of str * Expr
          | SIf of (Expr * Stmt list) list * Stmt list
          | SWhile of Expr * Stmt list
          | SCase of Expr * (Expr list * Stmt list) list * Stmt list
          // SDef: name, param names, (name, default-expr) for defaulted
          // params, body.
          | SDef of str * str list * (str * Expr) list * Stmt list
          | SReturn of Expr
          | SBreak of Expr | SNext of Expr
          | SClass of str * str * Stmt list
          // like SClass but the superclass is a runtime expression (evaluated
          // to a Class; a non-Class / module / singleton raises TypeError).
          | SClassE of str * Expr * Stmt list
          | SIVarAssign of str * Expr
          | SAttr of str * str list
          // M6: begin body / rescue clauses (class names, var, handler) /
          // else body / ensure body.
          | SBegin of Stmt list * (str list * str * Stmt list) list * Stmt list * Stmt list
          // BEGIN { } runs first in its code unit (hoisted); END { } runs at
          // exit. Distinct from a plain begin/end so run_prog/eval can order them.
          | SPreexe of Stmt list
          | SAtExit of int * Stmt list   // END { }: site id, body
          // `class << <expr>` — open the singleton class of an arbitrary
          // expression receiver (a literal / paren-expr / ivar), the general
          // form of `class << self` / `class << obj`.
          | SSingletonE of Expr * Stmt list
          // `var = <stmt>` where stmt is a begin/end used as a value: run
          // the statement, bind its value (else propagate return/raise).
          | SLocalFrom of str * Stmt
          // M8: multiple assignment. Targets are encoded names — a plain
          // local, "@name" for an ivar, "*name" for a splat. The RHS is one
          // or more expressions (one array is destructured; several values
          // form the array).
          | SMultiAssign of str list * Expr list
          // multiple assignment with complex targets (foo[0], bar.baz = ...):
          // each target is EVar / EIVar / ESplat / EMethod (indexing or attr).
          | SMultiAssignX of Expr list * Expr list
          // 2h: `alias new old` (copy a method); `include M` (mix a module's
          // instance methods into the class).
          | SAlias of str * str
          | SInclude of str * bool   // module name, prepend?
          // 2n: `undef name[, name]` removes method definitions.
          | SUndef of str list
          // 2t: visibility — `private` / `private :m, :n` (mode, names;
          // empty names = switch the mode for subsequent defs).
          | SVis of str * str list
          // 2u: declare locals as nil if not yet bound — Ruby defines the
          // targets of an assignment even when a guard skips executing it.
          | SDeclare of str list
          // G2: require / require_relative (bool = relative), path expr.
          | SRequire of bool * Expr
          // G2: low-precedence `stmt and stmt` / `stmt or stmt`.
          | SAndThen of Stmt * Stmt
          | SOrElse of Stmt * Stmt
          // G2: `begin ... end while/until c` — run body, then loop while
          // the (already-negated-for-until) condition holds.
          | SDoWhile of Stmt * Expr
          // pattern matching `case subj / in pat [guard] / ... [else] / end`.
          // Each clause is (pattern, guard-expr, body); the guard is EBool true
          // when absent (an `unless` guard is negated at parse time). The bool
          // is has-else; els is the else body (run when no pattern matches, or
          // NoMatchingPatternError is raised when has-else is false).
          | SCaseIn of Expr * (Pat * Expr * Stmt list) list * bool * Stmt list;

// A case/in pattern.
type Pat = PVar of str                       // binds a local (`_`/`_x` allowed, repeatable)
         | PVal of Expr                      // value pattern — matched with === (case_eqq)
         | PPin of Expr                      // ^expr — matched with == (rb_eq)
         | PSplatP of str                    // *name array element ("" = anonymous)
         | PArrP of Pat list                 // [p, ...] (a PSplatP element = splat)
         // {k: p, ...}; rest: "" open (extra keys allowed unless empty),
         // "nil" = **nil (no extra keys), "*" = ** anonymous rest, else **name.
         | PHashP of (str * Pat) list * str
         | PAltP of Pat list                 // p | p | ...
         | PAsP of Pat * str                 // pat => name
         | PConstP of Expr * Pat;            // Const[..] / Const(..): === then match inner

// VObj holds an object id (a handle into the world's object tables);
// VClass holds a class name. VSym is a Ruby symbol. VRange is lo..hi with
// a bool for the exclusive form (1...5).
// M10: arrays are mutable reference types, so VArr is a HANDLE (an id into
// the top-level arr_store); its contents live in the store and are shared
// by all aliases. VHsh stays an immutable value list (hash mutation is a
// later milestone).
type Val = VInt of int | VFlt of float | VStr of int | VBool of bool
         // arbitrary-precision integer, held as a canonical decimal string
         // (no leading zeros; "-" prefix if negative; never a value that
         // fits in a machine int — those stay VInt).
         | VBig of str
         // Rational num/den (den > 0, gcd-reduced) and Complex real/imag.
         | VRat of str * str
         | VCpx of Val * Val
         | VNil | VArr of int | VHsh of int
         | VObj of int | VClass of str | VSym of str
         // A Range holds its bounds AS VALUES: an integer range is the common
         // one, but ruby also has ("a".."z"), (1.0..2.0), a Time range, and an
         // endless / beginless one (VNil for the missing side). Storing two
         // ints meant a string range materialised into an Array -- a value
         // whose `class` was a lie -- and an endless one clamped to the
         // largest integer.
         | VRange of Val * Val * bool
         | VExc of str * str    // exception: class name, message
         | VProc of int         // a proc/lambda: a handle into proc_store
         | VBind of int         // a Binding: a handle into bind_store (captured env)
         // /pattern/flags, plus the ENCODING the value carries ("" = derive it
         // from the source and flags). A Regexp built from a String keeps that
         // string's encoding, and (source, flags) cannot hold it: every
         // `Regexp.new(s, Regexp::FIXEDENCODING)` over an ASCII-only source has
         // the SAME source and flags whatever s was encoded in, so a side table
         // keyed by the two answered whichever was built last.
         | VRegex of str * str * str
         | VMain;               // the top-level `self` (main), class Object

// A user method: parameter names, defaults ((name, default-expr) for
// params with `= default`), and body. Stored in the methods table (a
// Map[str, Meth]) keyed by bare name (top-level) or "Class#name".
type Meth = Meth of str list * (str * Expr) list * Stmt list;

// Statement execution result: FNext carries the statement's value (so a
// method's implicit return is its last statement's value); FReturn is a
// non-local exit carrying an explicit `return` value up through enclosing
// blocks and loops to the method boundary.
// FRaise signals that a Ruby exception unwound to a begin/rescue (the
// exception value itself is stashed in the world's ivars under "$exc",
// since raise unwinds via Mere's `fail` and try_or yields only a default).
// FBreak / FLoopNext are loop control (break / next), caught by the
// enclosing while loop; FReturn / FRaise propagate to the method / rescue.
type Flow = FNext of Val | FReturn of Val | FRaise of Val
          | FBreak of Val | FLoopNext of Val;

// ---- regex AST (compiled engine) -----------------------------------------
// Character-class atoms. Ranges compare byte strings directly (Mere string
// comparison is lexicographic on bytes).
type RCls = CChr of str | CRange of str * str
          | CDigit | CWord | CSpace | CHex
          | CNDigit | CNWord | CNSpace | CNHex
          | CPosix of str * bool;
// Pattern AST. The i/m/x flags are fully resolved at PARSE time: i turns
// letters into NCharCI and sets the class ci bit, m turns `.` into NAnyNL,
// x is consumed by the parser (whitespace/#-comments). Ruby's ^/$ are always
// line anchors (m affects only `.`); \A/\z/\Z are the string anchors.
// NFlagsRest is parser-internal: `(?im)` applies to the rest of the sequence.
type RNode = NChar of str | NCharCI of str | NAny | NAnyNL
           | NClass of RCls list * bool * bool     // items, negated, ci
           | NSeq of RNode list | NAlt of RNode list
           | NRep of RNode * int * int * bool      // body, min, max (-1 = inf), greedy
           | NGroup of RNode * int * str           // body, gnum (0 = shy), name
           | NBackref of int * bool                // group, ci
           | NBOL | NEOL | NBOS | NEOS | NEOSNL | NGANCHOR
           | NWordB of bool
           | NLook of RNode * bool | NLookB of RNode * bool   // body, negated
           | NAtomic of RNode                       // (?>...) atomic group
           | NFlagsRest of str
           | NEmpty;
// Compiled instructions (a program is an int-key Map "0".."N-1" -> RInst,
// plus "meta" -> IMeta (count, ngroups) and "name:<x>" -> IMeta (gnum, 0)).
type RInst = IChar of str | ICharCI of str | IAny | IAnyNL
           | IClass of RCls list * bool * bool
           | ISplit of int * int | IJmp of int | ISave of int
           | IBOL | IEOL | IBOS | IEOS | IEOSNL | IGANCHOR
           | IWordB of bool | IBackref of int * bool
           | ILook of int * bool | ILookB of int * int * int * bool
           | IAtomic of int
           | IMark of int | ICheck of int * int
           | IOk | IOkAt | IMatch
           | IMeta of int * int;
// VM results: a match's end index + capture saves (immutable assoc list,
// newest first), and the search wrapper's hit / no-hit / uncompilable-pattern.
type RxRes = RFound of int * (int * int) list | RFail;
type RxHit = RHit of int * int * (int * int) list | RNoHit | RBadPat;

// DEFLATE comes from the mgz package, vendored under .mere_modules/. Zlib's
// streams are the same RFC 1951 body under a different wrapper, so mere-ruby
// only adds the zlib header/Adler-32 around what mgz already computes.
import "mgz/inflate.mere";
import "mgz/deflate.mere";

import "m_state.mere";
import "m_parse.mere";
// ---- evaluator -----------------------------------------------------------
// Ruby truthiness: only nil and false are falsy. 0 and "" are truthy.
let truthy = fn (v: Val) ->
  match v with
  | VNil -> false
  | VBool b -> b
  | _ -> true;

let to_f = fn (v: Val) ->
  match v with
  | VInt n -> float_of_int n
  | VFlt f -> f
  | VBig s -> float_of_str s
  | VRat (n, d) -> float_of_str n / float_of_str d
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: not a number")) in fail "mere-ruby: not a number");

// A Numeric the float-based paths can take. VBig and VRat were missing, and
// this predicate is what the operator path and `send(:+, x)` both ask, so
// `(2**70) < 1` raised "comparison of Integer with 1 failed" and
// `Rational(1,2).send(:+, 1)` was a NoMethodError. A Complex is a Numeric but
// is NOT here: every caller converts through to_f, which a Complex has no
// answer for -- it is admitted separately where arith_bin can take it.
let is_num = fn (v: Val) ->
  match v with VInt _ -> true | VFlt _ -> true | VBig _ -> true
             | VRat (_, _) -> true | _ -> false;
let is_cpx = fn (v: Val) -> match v with VCpx (_, _) -> true | _ -> false;

let feq = fn (x: float) -> fn (y: float) -> x <= y && y <= x;

// Ruby integer division floors toward negative infinity (-7 / 2 == -4)
// and modulo takes the sign of the divisor (-7 % 3 == 2). Mere's native
// / and % truncate toward zero (C semantics), so correct after the fact.
let floor_div = fn (a: int) -> fn (b: int) ->
  // ...as a real ZeroDivisionError, which is what a program rescues. This was
  // an internal failure, so it reached the program as a bare StandardError
  // reading "mere-ruby: divided by 0".
  if b == 0 then (let _ = prim_raise "ZeroDivisionError" "divided by 0" in 0)
  else
    let q = a / b in
    let r = a - q * b in
    if r != 0 && (if r < 0 then b > 0 else b < 0) then q - 1 else q;

let floor_mod = fn (a: int) -> fn (b: int) -> a - (floor_div a b) * b;

// integer shifts by repeated doubling / halving (floor semantics). A
// negative shift count reverses direction (x << -n == x >> n).
let rec shl_int = fn (x: int) -> fn (n: int) ->
  if n == 0 then x
  else if n < 0 then shr_int_pos x (0 - n)
  else shl_int (x * 2) (n - 1)
and shr_int = fn (x: int) -> fn (n: int) ->
  if n == 0 then x
  else if n < 0 then shl_int_pos x (0 - n)
  else shr_int_pos x n
and shl_int_pos = fn (x: int) -> fn (n: int) ->
  if n <= 0 then x else shl_int_pos (x * 2) (n - 1)
and shr_int_pos = fn (x: int) -> fn (n: int) ->
  if n <= 0 then x else shr_int_pos (floor_div x 2) (n - 1);

let rec pow_int = fn (b: int) -> fn (e: int) ->
  if e < 0 then (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: negative integer exponent unsupported in M0")) in fail "mere-ruby: negative integer exponent unsupported in M0")
  else if e == 0 then 1
  else b * pow_int b (e - 1);

// (no pow_flt here any more: `b * pow_flt b (e - 1)` is a LINEAR recursion, so
// `9.5 ** 0xffffffff` asked for 4294967295 nested frames and overflowed the
// stack on an expression whose answer is Infinity. Every caller now goes
// through pow_val, which is libm's pow -- and which also rounds the way ruby
// does: the walk gave 2.3 ** 3 as 12.166999999999996 against ruby's
// 12.166999999999998.)

import "m_numeric.mere";
import "m_unicode.mere";
import "m_strutil.mere";
// ---- evaluator + driver (one mutual recursion) ---------------------------
// `env` is a Map[str, Val] of local variables (including "self" inside a
// method). `world` is the global object model, a 4-tuple of Maps bundled
// so a single parameter threads all of it:
//   (meths, sup, ocls, ivars)
//   meths : Map[str, Meth]  — bare name (top-level) or "Class#name"
//   sup   : Map[str, str]   — class name -> superclass name
//   ocls  : Map[str, str]   — object id (as str) -> its class name
//   ivars : Map[str, Val]   — "id@name" -> instance variable value
// (Maps cannot be put in a record/variant field without wrestling the
// region annotations, but a tuple of Maps threads cleanly — so a tuple
// is the bundle. A fresh object's id comes from `alloc_oid ocls`, which
// carries its counter in the map as "$next" -- it was `map_len ocls` once,
// and a site left behind on that rule issued an id alloc_oid had already
// given out.)
//
// Ruby method scope is FLAT: a method body sees only its parameters and
// self, never the caller's locals. Each call runs in a fresh env.
//
// `blk` is the CURRENT block (for yield), a tuple that a call installs for
// the method body it runs: (has: bool, params: str list, body: Stmt list,
// cenv: env). Blocks ARE closures — cenv is the defining scope's env map
// (shared), so a block reads and mutates the enclosing locals. "No block"
// is (false, (Nil : str list), (Nil : Stmt list), env) with any env as an unused placeholder. This is
// the counterpoint to method scope: methods are flat, blocks capture.
// ---- collection state, global so a safepoint can live at ANY depth ------
// gc_state: "t" = the entry threshold, "b" = the byte baseline -- both set by
// gc_collect itself after each collection, read by gc_pressure wherever it is
// called from. gc_unsafe: a depth counter of eval contexts that may hold
// UNROOTED in-flight values (method and block bodies -- their callers'
// half-evaluated expressions are invisible to the mark); a safepoint may
// collect only at zero. A bare `require` chain (the builtin SRequire path)
// never passes through run_meth, so a required file's statement boundaries
// sit at zero -- which is exactly where a gem load needs its collections.
let gc_state = map_new ();
let gc_unsafe = map_new ();
let gc_unsafe_push = fn (u: unit) ->
  let n = (if map_has gc_unsafe "n" then map_get gc_unsafe "n" else 0) in
  map_set gc_unsafe "n" (n + 1);
let gc_unsafe_pop = fn (u: unit) ->
  let n = (if map_has gc_unsafe "n" then map_get gc_unsafe "n" else 0) in
  map_set gc_unsafe "n" (if n > 0 then n - 1 else 0);
// MERE_RUBY_GC_LOG: the env readers live inside the interpreter group,
// after this block -- so the DRIVER (run_src) reads the variable once and
// records it in gc_state ("log": 1/0); the collector only looks it up.
let gc_log_on = fn (u: unit) ->
  (if map_has gc_state "log" then map_get gc_state "log" else 0) == 1;

let gc_safe_now = fn (u: unit) ->
  (if map_has gc_unsafe "n" then map_get gc_unsafe "n" else 0) == 0;

// The bare-call baton: a statement that is exactly `name arg...` with every
// argument a literal or a variable read sets it, and the next run_meth entry
// consumes it and SKIPS the unsafe count -- soundly, because literal
// arguments admit no intervening call to steal the baton, and a bare
// statement holds nothing else in flight. This is what keeps a required
// file's statement boundaries collectable when rubygems has replaced
// Kernel#require with a Ruby method: the require chain is bare calls all
// the way down.
let gc_bare = map_new ();
let gc_arg_simple = fn (e: Expr) ->
  match e with
  | EStrL _ -> true | EInt _ -> true | EVar _ -> true | ESym _ -> true
  | EBool _ -> true | ENil -> true | EFlt _ -> true
  | _ -> false;
let rec gc_args_simple = fn (es: Expr list) ->
  match es with
  | Nil -> true
  | Cons (e, rest) -> gc_arg_simple e && gc_args_simple rest;

// 0 when the target cannot measure an arena. Here that IS the right answer
// rather than a lie: this feeds a pressure threshold, and a target with no arena
// has no arena bytes to be under pressure from. The entry-count axis still
// works, so collection still happens -- see gc_should_run, which ORs the two.
let gc_store_bytes = fn (u: unit) ->
  if arena_measurable then vec_bytes str_store + map_bytes arr_store + vec_bytes hash_store
  else 0;

// Pressure is INCREMENTAL on both axes. Entries: the amortized threshold in
// the driver. Bytes (mere v0.1.299): growth over the post-collection baseline
// -- an ABSOLUTE byte floor dies of stub mass (vec ids are positional and
// never removed), and pinned pressure permanently true at 64 MB in its first
// version: a collection per iteration, each copying every slot ever issued.
let gc_pressure = fn world ->
  let (_, _, ocls, ivars) = world in
  let limit = (if map_has gc_state "t" then map_get gc_state "t" else 4000) in
  let bbase = (if map_has gc_state "b" then map_get gc_state "b" else 0) in
  let tight = (if map_has gc_state "tight" then map_get gc_state "tight" else 0) == 1 in
  map_len ivars + map_len ocls > limit
  || gc_store_bytes () > (if tight then bbase + 8388608 else bbase * 2 + 33554432);


// nth suffix of a list -- the driver's cursor walks the top-level statement
// list this way, so the carry holds an int, never AST.
let rec gc_suffix = fn (xs: Stmt list) -> fn (n: int) ->
  if n <= 0 then xs
  else (match xs with Nil -> Nil | Cons (_, r) -> gc_suffix r (n - 1));

// ---- The collector -------------------------------------------------------
// Mark every reachable object id, then rebuild ivars / ocls keeping only live
// entries. The world maps live in a region loop's arena (see run_src), so the
// REBUILD is what reclaims: the driver passes fresh maps born in the loop's
// lexical scope, fills them here, and Continue deep-copies them into the next
// arena -- everything not copied (dead entries, dead map-internal copies, the
// old maps themselves) is released with the old arena.
//
// What is a root: the top-level env, $globals, constants, encoding objects,
// signal handlers, match data, ARGV, the flow-signal slot -- and, because this
// slice does not compact them, EVERY entry of arr_store / hash_store /
// proc_store / bind_store (a proc's captured env included). ivars keys that
// are not "<id>@..." ("$exc", "cls:Name@x") are always kept. Objects live in
// ivars only through their owner: a second fixpoint pass marks values of
// entries whose owner is live, until the live set stops growing.
// ⚠ THE LIVE SET IS KEYED BY A TAGGED INT, NOT BY "<kind><decimal id>". It
// used to build `"o" ++ str_of_int id` for EVERY VALUE MARKED and, in the
// sweep, once per slot in every store -- an asprintf, a concatenation and a
// string hash each time, on the one pass that walks the whole heap. `id * 8 +
// kind` says the same thing in a register: no id is negative and there are six
// kinds, so the mapping is injective.
//   0 obj   1 str   2 arr   3 hash   4 proc   5 bind
let rec gc_mark_val = fn live -> fn (v: Val) ->
  match v with
  | VObj id -> let k = id * 8 in
               (if map_has live k then () else (let _ = map_set live k VNil in ()))
  | VStr id -> let k = id * 8 + 1 in
               (if map_has live k then () else (let _ = map_set live k VNil in ()))
  | VArr id -> let k = id * 8 + 2 in
               (if map_has live k then ()
                // `deref` folds the pending appends in first, so marking what
                // it returns marks them; nothing queued can be missed.
                else let _ = map_set live k VNil in gc_mark_vals live (deref id))
  | VHsh id -> let k = id * 8 + 3 in
               (if map_has live k then ()
                else let _ = map_set live k VNil in gc_mark_vals live (hderef id))
  | VProc id -> let k = id * 8 + 4 in
                (if map_has live k then ()
                 else let _ = map_set live k VNil in
                      (if map_has proc_store (str_of_int id)
                       then (let (_, _, _, penv) = map_get proc_store (str_of_int id) in
                             map_iter penv (fn (kk: str) -> fn (vv: Val) -> gc_mark_val live vv))
                       else ()))
  | VBind id -> let k = id * 8 + 5 in
                (if map_has live k then ()
                 else let _ = map_set live k VNil in
                      (if map_has bind_store (str_of_int id)
                       then map_iter (map_get bind_store (str_of_int id))
                              (fn (kk: str) -> fn (vv: Val) -> gc_mark_val live vv)
                       else ()))
  | VRange (a, b, _) -> let _ = gc_mark_val live a in gc_mark_val live b
  | VCpx (a, b) -> let _ = gc_mark_val live a in gc_mark_val live b
  | _ -> ()
and gc_mark_vals = fn live -> fn (xs: Val list) ->
  match xs with
  | Nil -> ()
  | Cons (v, rest) -> let _ = gc_mark_val live v in gc_mark_vals live rest;

// owner id of an ivars key: "123@x" -> 123; -1 when the key has no numeric
// owner (specials and class ivars -- those entries are kept unconditionally).
// Reads the digits straight out rather than cutting a substring: this runs
// once per ivars entry per fixpoint pass, and the substring was an allocation
// each time whose only use was to be parsed back into a number.
let rec gc_owner_go = fn (k: str) -> fn (i: int) -> fn (acc: int) ->
  if i >= str_len k then 0 - 1
  else
    let c = char_at k i in
    if str_eq c "@" then (if i > 0 then acc else 0 - 1)
    else if is_digit c then gc_owner_go k (i + 1) (acc * 10 + (ord c - 48))
    else 0 - 1;
let gc_owner_of = fn (k: str) ->
  if str_len k == 0 then 0 - 1
  else if is_digit (char_at k 0) then gc_owner_go k 0 0
  else 0 - 1;

// fixpoint: values of entries whose owner is live (or ownerless) are marked;
// repeat until the live set stops growing.
let gc_fixpoint = fn ivars -> fn live ->
  let rec go = fn (guard: int) ->
    let before = map_len live in
    let _ = map_iter ivars (fn (k: str) -> fn (v: Val) ->
      let owner = gc_owner_of k in
      if owner < 0 then gc_mark_val live v
      else if map_has live (owner * 8) then gc_mark_val live v
      else ()) in
    let _ = (if gc_log_on () then print_err ("gc: fixpoint pass live=" ++ str_of_int (map_len live)) else ()) in
    if map_len live > before && guard > 0 then go (guard - 1) else () in
  go 1000000;

// the root scan, shared by every collection. EVERY top-level map that holds
// Val values is a root -- the list was built by classifying all 120 globals
// by their setter sites, and the first version, which picked ten of them by
// intuition, collected the current Thread object out from under bundler
// (Monitor#synchronize then raised ThreadError). The type checker keeps this
// list honest in one direction: a non-Val map here is a build error. A MISSING
// map is the direction to fear when adding a new global store.
let gc_mark_roots = fn env -> fn live ->
  let mk = fn (k: str) -> fn (v: Val) -> gc_mark_val live v in
  let mkenv = fn (k: str) -> fn (benv) ->
    map_iter benv (fn (kk: str) -> fn (vv: Val) -> gc_mark_val live vv) in
  // the same walk over a table keyed by an INT (lv_up is keyed by frame id).
  // `map_iter`'s callback takes the key, so one callback cannot serve both.
  let mkenvi = fn (k: int) -> fn (benv) ->
    map_iter benv (fn (kk: str) -> fn (vv: Val) -> gc_mark_val live vv) in
  let _ = map_iter env mk in
  let _ = map_iter globals mk in
  let _ = map_iter consts mk in
  let _ = map_iter enc_objs mk in
  let _ = map_iter signal_traps mk in
  let _ = map_iter dm_captured mk in
  let _ = map_iter dm_closenv mk in
  let _ = map_iter dm_methods mk in
  let _ = map_iter flow_sig mk in
  let _ = map_iter cli_argv mk in
  let _ = map_iter all_thr mk in
  let _ = map_iter at_exits mk in
  let _ = map_iter autoloads mk in
  let _ = map_iter catch_depth mk in
  let _ = map_iter cur_thr mk in
  let _ = map_iter cvars mk in
  let _ = map_iter deco_memo mk in
  let _ = map_iter def_ext_enc mk in
  let _ = map_iter def_int_enc mk in
  let _ = map_iter dfl_tg mk in
  let _ = map_iter end_sites mk in
  let _ = map_iter env_ovr mk in
  let _ = map_iter env_cache mk in
  let _ = map_iter ff_state mk in
  let _ = map_iter gvar_alias mk in
  let _ = map_iter gvar_traces mk in
  let _ = map_iter hash_dflt mk in
  let _ = map_iter hash_dproc mk in
  let _ = map_iter hook_flags mk in
  let _ = map_iter io_cap mk in
  let _ = map_iter kwarg_marks mk in
  let _ = map_iter lambda_ids mk in
  let _ = map_iter le_path mk in
  // The interned frozen strings (`"lit".freeze`, `-str`): canonical by
  // content, handed out again and again, and referenced from nowhere else
  // between two uses. Unrooted, a collection during a `require` blanked them
  // (blank_s below empties every id not marked live) and rebuilt str_frozen
  // without them -- so the NEXT `">= 3.0.1".freeze` returned an empty,
  // unfrozen string, which is how `require "bundler"` came to raise
  // `Illformed requirement [""]` (2026-09-03; it depended on whether store
  // pressure happened to trigger a collection during the rubygems preload,
  // which is why it came and went with the environment).
  let _ = map_iter str_intern_tbl mk in
  // Found by listing every global map whose writes store a handle and
  // asking which of them appear above: a proc's / method's source file
  // (`source_location`), a proc's symbol source, and a curried proc's
  // collected arguments are all reached from nowhere but these tables.
  let _ = map_iter proc_src mk in
  let _ = map_iter proc_symsrc mk in
  let _ = map_iter meth_src mk in
  let _ = map_iter curry_args mk in
  let _ = map_iter comp_inner mk in
  let _ = map_iter comp_outer mk in
  let _ = map_iter loaded_files mk in
  let _ = map_iter modules mk in
  let _ = map_iter mrsh_dsyms mk in
  let _ = map_iter mrsh_syms mk in
  let _ = map_iter parser_flags mk in
  let _ = map_iter pending_home mk in
  let _ = map_iter prim_missing mk in
  let _ = map_iter private_consts mk in
  let _ = map_iter privates mk in
  let _ = map_iter proc_arity mk in
  let _ = map_iter proc_home mk in
  let _ = map_iter protecteds mk in
  let _ = map_iter r2k_methods mk in
  let _ = map_iter raise_bt mk in
  let _ = map_iter refine_cnt mk in
  let _ = map_iter resc_ctr mk in
  let _ = map_iter rx_bad mk in
  let _ = map_iter rx_gnums mk in
  let _ = map_iter rx_lenient mk in
  let _ = map_iter struct_mem mk in
  let _ = map_iter tcp_buf mk in
  let _ = map_iter thread_flag mk in
  let _ = map_iter tmp_ctr mk in
  let _ = map_iter trace_fn mk in
  let _ = map_iter undefs mk in
  let _ = map_iter warn_cats mk in
  let _ = map_iter hstored mk in
  let _ = map_iter sym_all mk in
  let _ = map_iter fm_kw mk in
  let _ = map_iter rx_once mk in
  // The second sweep of missed roots -- found by classifier v2, which reads
  // the GENERATED C's map value types instead of guessing from setter sites
  // (v1 read literal-constructor setters only and missed variable-argument
  // ones). load_ctx is the one that bit: it holds the current require's file
  // and directory as VStr, a collection at a new moment blanked those
  // strings, and bundler's Gemfile resolution died three calls later.
  let _ = map_iter load_ctx mk in
  let _ = map_iter anon_name mk in
  let _ = map_iter cli_inc mk in
  let _ = map_iter dm_had_blk mk in
  let _ = map_iter ref_active mk in
  let _ = map_iter refine_cls mk in
  let _ = map_iter refine_tgt mk in
  let _ = map_iter rx_cur mk in
  let _ = map_iter rx_gbodies mk in
  let _ = map_iter rx_pending mk in
  let _ = map_iter warn_pending mk in
  let _ = map_iter rx_prog_names mk in
  let _ = map_iter gc_cenv0 mk in
  let _ = map_iter gc_hold mk in
  // arr_store and hash_store are NOT roots since the collector took them on:
  // a reachable array or hash is marked through the VArr / VHsh arms, and an
  // unreachable one is exactly what gets dropped and compacted away.
  let _ = map_iter proc_store (fn (k: str) -> fn pe ->
    let (_, _, _, penv) = pe in
    map_iter penv (fn (kk: str) -> fn (vv: Val) -> gc_mark_val live vv)) in
  // blk tuples captured for yield: their env member holds Vals
  let _ = map_iter proc_yblk (fn (k: str) -> fn b ->
    let (_, _, _, benv) = b in
    map_iter benv (fn (kk: str) -> fn (vv: Val) -> gc_mark_val live vv)) in
  let _ = map_iter bind_store mkenv in
  // the scope-chain parents: env maps linked by id, each holding Vals
  let _ = (if (if map_has gc_state "nolvup" then map_get gc_state "nolvup" else 0) == 1 then () else map_iter lv_up mkenvi) in
  ();

// THE COLLECTION, as a plain function. Everything it needs reaches it
// through stable handles: the world maps are rebuilt IN PLACE (survivors
// out, map_clear, survivors back, map_compact -- their handles never move,
// mere v0.1.297/298), the value stores compact their own arenas, and the
// scratch maps live in this function's own `region GCC` block and die with
// it. Because nothing swaps, this is callable from ANY stack depth whose
// in-flight values are rooted -- which is what a safepoint inside a require
// chain needs (the driver's between-statement safepoints are the trivially
// safe case).
let gc_collect = fn env -> fn world ->
  region GCC {
    let (meths, sup, ocls, ivars) = world in
    let gclog = gc_log_on () in
    let _ = (if gclog then print_err ("gc: BEGIN ivars=" ++ str_of_int (map_len ivars) ++ " arr=" ++ str_of_int (map_len arr_store) ++ " str=" ++ str_of_int (vec_len str_store)) else ()) in
    let live = map_new () in
    let _ = gc_mark_roots env live in
    let _ = gc_fixpoint ivars live in
    // ivars / ocls: same clear-and-reset as every other store now (the region
    // loop that used to carry them is gone -- compaction made it redundant).
    let ivsave = map_new () in
    let _ = map_iter ivars (fn (k: str) -> fn (v: Val) ->
      let owner = gc_owner_of k in
      if owner < 0 then (let _ = map_set ivsave k v in ())
      else if map_has live (owner * 8) then (let _ = map_set ivsave k v in ())
      else ()) in
    let _ = map_clear ivars in
    let _ = map_iter ivsave (fn (k: str) -> fn (v: Val) -> map_set ivars k v) in
    let _ = map_compact ivars in
    let ocsave = map_new () in
    // every key here IS an object id now -- the one non-numeric entry ("$next")
    // moved to its own table -- so the "keep what is not a number" branch that
    // used to guard it has nothing left to keep.
    let _ = map_iter ocls (fn (k: int) -> fn (v: str) ->
      if map_has live (k * 8) then (let _ = map_set ocsave k v in ()) else ()) in
    let _ = map_clear ocls in
    let _ = map_iter ocsave (fn (k: int) -> fn (v: str) -> map_set ocls k v) in
    let _ = map_compact ocls in
    let liveAK = map_new () in
    let _ = map_iter arr_store (fn (k: int) -> fn (xs: Val list) ->
      if map_has live (k * 8 + 2) then (let _ = map_set liveAK k xs in ()) else ()) in
    // ⚠ and the values queued for an array but not yet folded into it -- they
    // are as reachable as the array is, and dropping them here would free a
    // value the program is about to see.
    let livePK = map_new () in
    let _ = map_iter arr_pending (fn (k: int) -> fn (v: Vec['p, Val]) ->
      if map_has live (k * 8 + 2) then (let _ = map_set livePK k v in ()) else ()) in
    let _ = map_clear arr_pending in
    let _ = map_iter livePK (fn (k: int) -> fn (v: Vec['p, Val]) -> map_set arr_pending k v) in
    let _ = map_clear arr_store in
    let _ = map_iter liveAK (fn (k: int) -> fn (xs: Val list) -> map_set arr_store k xs) in
    let _ = map_compact arr_store in
    let rec blank_h = fn (i: int) ->
      if i >= vec_len hash_store then ()
      else
        let _ = (if map_has live (i * 8 + 3) then ()
                 else (match hderef i with
                       | Nil -> ()
                       | _ -> (let _ = hset i (Nil : Val list) in ()))) in
        blank_h (i + 1) in
    let _ = blank_h 0 in
    let _ = vec_compact hash_store in
    let rec blank_s = fn (i: int) ->
      if i >= vec_len str_store then ()
      else
        let _ = (if map_has live (i * 8 + 1) then ()
                 else (if str_eq (sget i) "" then () else sset i "")) in
        blank_s (i + 1) in
    let _ = blank_s 0 in
    let _ = vec_compact str_store in
    let liveE = map_new () in
    let _ = map_iter str_enc (fn (k: int) -> fn (v: str) ->
      if map_has live (k * 8 + 1) then (let _ = map_set liveE k v in ()) else ()) in
    let _ = map_clear str_enc in
    let _ = map_iter liveE (fn (k: int) -> fn (v: str) -> map_set str_enc k v) in
    let _ = map_compact str_enc in
    let liveF = map_new () in
    let _ = map_iter str_frozen (fn (k: int) -> fn (v: str) ->
      if map_has live (k * 8 + 1) then (let _ = map_set liveF k v in ()) else ()) in
    let _ = map_clear str_frozen in
    let _ = map_iter liveF (fn (k: int) -> fn (v: str) -> map_set str_frozen k v) in
    let _ = map_compact str_frozen in
    // The call-bookkeeping maps: one write per name/file/meth/line PER CALL
    // and a live_frames set+delete per frame, all keyed by depth (or a fixed
    // flag), so the live population is at most the recursion guard's 15000
    // while the write traffic is millions -- measured at ~4.7 GB of a
    // rubocop load's default-region bytes, every orphaned overwrite pinned
    // forever. No liveness filter here: every entry is kept (compact is not
    // collection), the point is only that the churn moves into a private
    // arena that the NEXT compact throws away as a whole.
    let _ = map_compact call_names_s in
    let _ = map_compact call_files_s in
    let _ = map_compact call_meths_s in
    let _ = map_compact cur_pos_s in
    let _ = map_compact call_lines in
    // cur_pos: two keys, one write per STATEMENT executed (the SLine marker) --
    // 14.9M writes and 456 MB of orphaned boxes in a rubocop load, the second
    // biggest emitter after `globals`. Safe to compact because its only reader
    // extracts the int (a Val read out of a compacted map must not be held:
    // see thread_flag).
    let _ = map_compact cur_pos in
    let _ = map_compact live_frames in
    let _ = map_compact struct_ctr in
    let _ = map_compact thread_flag in
    let _ = map_compact gc_bare in
    let _ = (if gclog then print_err ("gc: END live=" ++ str_of_int (map_len live) ++ " ivars2=" ++ str_of_int (map_len ivars)) else ()) in
    // the next thresholds, set HERE so any caller at any depth inherits the
    // same amortization: entries = live + max(scan/2, 4000); bytes = the
    // post-collection baseline (gc_pressure fires at 2x it plus 32 MB).
    let scan = map_len arr_store + vec_len hash_store + vec_len str_store in
    let delta = (if scan / 2 > 4000 then scan / 2 else 4000) in
    let _ = map_set gc_state "t" (map_len ivars + map_len ocls + delta) in
    let _ = map_set gc_state "b" (gc_store_bytes ()) in
    ()
  };

import "m_eval_leaf.mere";

let rec eval_e = fn env -> fn world -> fn blk -> fn (e: Expr) ->
  match e with
  | ESplat inner -> eval_e env world blk inner   // bare splat: evaluate inner
  // `**h` reaching HERE means no list-level walker took it. eval_args and
  // hsh_eval_items intercept the marker and splice the hash's pairs -- but
  // `puts` is a statement in this parser, and puts_args evaluates each element
  // with eval_e directly. So `puts **h` printed NOTHING where ruby prints
  // {a: 1} -- and the reason, measured against the pre-fix binary rather than
  // guessed: the fallthrough ABORTED the process (exit 134), so `puts 1, **h`
  // wrote the 1 and then died. The commit that added this arm said the backend
  // "invented a value"; it did not, and the C backend names the failure since
  // mere v0.1.470. Keywords handed to a method that takes none arrive as a
  // single positional hash, which is exactly the inner expression's value --
  // the same answer `ESplat` gives one line up.
  //
  // What this does NOT reproduce is `**{}`, which passes no keyword arguments
  // AT ALL (Ruby 3.0) and so disappears from the argument list: `puts(**{})`
  // is `puts()` and prints a newline, where this prints `{}`. Getting that
  // right belongs at the list level, not here -- see KNOWN_GAPS.md.
  | EKwSplat inner -> eval_e env world blk inner
  | EInt n -> VInt n
  // ⚠ canonicalised, not taken as written: the parser folds a leading minus
  //   into the literal ("-" ++ b), and -9223372036854775808 DOES fit a machine
  //   int while +9223372036854775808 does not. Left as a VBig, that literal
  //   never equalled the same value reached by arithmetic -- and a VBig never
  //   equals a VInt here, so `9223372036854775808.send(:-@) == -92233...808`
  //   was false.
  | EBig b -> norm_big b
  | ERat (n, d) -> mk_rat_s n d
  | EImag n -> VCpx (VInt 0, VInt n)
  | EImagF f -> VCpx (VInt 0, VFlt f)
  | EImagRat (n, d) -> VCpx (VInt 0, mk_rat_s n d)
  | EFlt f -> VFlt f
  | EStrL s -> (let v = mkstr s in
                // a non-UTF-8 magic comment tags literals at PARSE time (the
                // __lit_enc marker, like __ENCODING__) -- reading the loader's
                // CURRENT coding here tagged a method's literals with whatever
                // file happened to be loading when it ran.
                (let st = fsl_state () in
                 if str_eq st "on" then (match v with VStr id -> let _ = sfrozen_set id in v | _ -> v)
                 else if str_eq st "off" then v
                 else (match v with VStr id -> let _ = schilled_set id in v | _ -> v)))
  | EBool b -> VBool b
  | ENil -> VNil
  | ESym s -> VSym s
  | ESelf -> if lv_has env "self" then lv_get env "self" else VNil
  | EConst name ->
    // `::Name` is top level and nothing else -- no lexical walk.
    if str_len name > 2 && str_eq (substring name 0 2) "::" then
      (let n = substring name 2 (str_len name) in
       if map_has consts n then map_get consts n
       // ⚠ ...and Object's OWN namespace is top level too. A constant assigned
       // inside `class Object` is stored under "Object::X", so `::X` -- which
       // reads exactly that namespace -- could not find what `Object::X` could.
       else if map_has consts ("Object::" ++ n) then map_get consts ("Object::" ++ n)
       // ⚠ ...and along Object's ANCESTORS, which is where `include M` at top
       // level puts M. `::X` names Object's namespace, and that namespace is
       // the whole chain -- the bare `X` already searched it.
       else if (if str_eq (anc_const_key world "Object" n) "" then false else true)
       then map_get consts (anc_const_key world "Object" n)
       else if autoload_fire env world blk n then eval_e env world blk (EConst ("::" ++ n))
       else raise_exc world "NameError" ("uninitialized constant " ++ n))
    // scoped `A::B` keeps its existing handling; a bare `Const` resolves
    // through the lexical scope (cref) first, then top level.
    else if str_contains name "::" then
      // the scope operator is exactly what `private_constant` closes off; the
      // lexical name (the `else` branch below) still reads it.
      (if map_has private_consts name then
         // A private constant is "not there" as far as the scope operator is
         // concerned, so a class with its OWN #const_missing gets asked --
         // Ruby calls the hook here exactly as it does for a name that was
         // never defined. `has_meth` cannot be used for this: it walks up to a
         // builtin const_missing, whose answer is "uninitialized constant",
         // which is the wrong thing to say about a constant that does exist.
         (let ci = str_index_of name "::" in
          let rc0 = substring name 0 ci in
          let cn0 = substring name (ci + 2) (str_len name) in
          if has_own_meth world ("(sng:" ++ rc0 ++ ")") "const_missing"
             || has_own_meth world rc0 "const_missing"
          then invoke_val_c env world blk (VClass rc0) "const_missing" (Cons (VSym cn0, Nil)) false
          else raise_exc world "NameError" ("private constant " ++ name ++ " referenced"))
       else if map_has consts name then map_get consts name
       else
         // walk the segments left to right: the head can itself be lexically
         // scoped (inside `module B`, `E::K` means `B::E::K`), and any segment
         // may still be only an autoload registration, whose file has to run
         // before the next segment even exists.
         let cref0 = (if lv_has env "__cref" then (match lv_get env "__cref" with VStr s -> sget s | _ -> "") else cur_lex ()) in
         (match const_walk env world blk cref0 name with
          | VNil ->
         let rc = recv_of_scoped name in
         let cn = const_of_scoped name in
         // `Logger::WARN` where WARN is defined in an INCLUDED module (or a
         // superclass): ruby looks along the receiver's ancestors. Resolve the
         // receiver to a real class first -- it may itself be lexically scoped
         // or an alias.
         let rcq = (let k = lex_const_key cref0 rc in
                    let k = (if str_eq k "" && map_has consts rc then rc else k) in
                    if str_eq k "" then rc
                    else (match map_get consts k with VClass real -> real | _ -> rc)) in
         let akey = anc_const_key_q world rcq cn in
         // top-level constants live in Object's namespace, so Object::X reads
         // the bare top-level X.
         if str_eq rc "Object" && map_has consts cn then map_get consts cn
         // ⚠ reaching a constant THROUGH an included module does not make it
         // public: `Inc::X` finds PM2::X along the chain, and private_constant
         // closed that name off wherever it is reached from.
         else if (if str_eq akey "" then false else true) && map_has private_consts akey then
           raise_exc world "NameError" ("private constant " ++ akey ++ " referenced")
         else if (if str_eq akey "" then false else true) then map_get consts akey
         else if has_meth world ("(sng:" ++ rc ++ ")") "const_missing" || has_meth world rc "const_missing" then
           invoke_val_c env world blk (VClass rc) "const_missing" (Cons (VSym cn, Nil)) false
         else if autoload_fire env world blk name then eval_e env world blk (EConst name)
         else raise_exc world "NameError" ("uninitialized constant " ++ name)
          | found -> found))
    else
      let cref = (if lv_has env "__cref" then (match lv_get env "__cref" with VStr s -> sget s | _ -> "") else cur_lex ()) in
      // walk the full lexical nesting (M::Base -> M -> top), not just one level.
      let key = lex_const_key cref name in
      let key = (if str_eq key "" then anc_const_key world cref name else key) in
      if (if str_eq key "" then false else true) then map_get consts key
      else if map_has consts name then map_get consts name
      // an autoload registered ANYWHERE along the lexical nesting, or at top
      // level. Only the innermost cref and the bare name were tried, so a
      // library reading its own autoloaded sibling from inside one of its own
      // classes -- `module M; autoload :A, "..."; class B; def f; A; end; end;
      // end`, which is how bundler's Dsl reaches SourceList -- raised
      // NameError. lex_autoload_key walks M::B, then M, then the bare name.
      else if (let k = lex_autoload_key cref name in
               if str_eq k "" then false else autoload_fire env world blk k)
      then eval_e env world blk (EConst name)
      // ⚠ the name ruby reports is QUALIFIED BY THE LEXICAL SCOPE it was
      // looked for in: inside `module A; class B`, a missing MISSING is
      // "uninitialized constant A::B::MISSING". Reporting the bare name lost
      // the one piece of the message that says where the search happened.
      else raise_exc world "NameError"
             ("uninitialized constant " ++ (if str_eq cref "" then name else cref ++ "::" ++ name))
  | EConstOrNil name -> if map_has consts name then map_get consts name else VNil
  | EScopedRead (recv_e, cn) ->
    (match eval_e env world blk recv_e with
     | VClass c ->
       let key = c ++ "::" ++ cn in
       // `Logger::WARN` where WARN comes from an INCLUDED module (or a
       // superclass): ruby looks along the ancestors, not just the class.
       let akey = (if map_has consts key then "" else anc_const_key_q world c cn) in
       // ⚠ private_constant closes the SCOPE OPERATOR off, and this is the
       // scope operator too -- `c::Foo` where c is a value rather than a
       // constant path. Only the name-path form checked, so anything reached
       // through a variable holding the module read straight past it.
       if map_has private_consts key then
         raise_exc world "NameError" ("private constant " ++ key ++ " referenced")
       else if (if str_eq akey "" then false else true) && map_has private_consts akey then
         raise_exc world "NameError" ("private constant " ++ akey ++ " referenced")
       else if map_has consts key then map_get consts key
       else if (if str_eq akey "" then false else true) then map_get consts akey
       else if map_has consts cn then map_get consts cn
       else if autoload_fire env world blk key || autoload_fire env world blk cn then
         (if map_has consts key then map_get consts key
          else if map_has consts cn then map_get consts cn
          else raise_exc world "NameError" ("uninitialized constant " ++ cn))
       else raise_exc world "NameError" ("uninitialized constant " ++ cn)
     // `obj::CONST` where obj is not a class/module is a TypeError (Ruby).
     | other -> raise_exc world "TypeError" (inspect other ++ " is not a class/module"))
  | EScopedReadOrNil (recv_e, cn) ->
    (match eval_e env world blk recv_e with
     | VClass c -> let key = c ++ "::" ++ cn in
       (let akey = (if map_has consts key then "" else anc_const_key_q world c cn) in
        if map_has consts key then map_get consts key
        else if (if str_eq akey "" then false else true) then map_get consts akey
        else if map_has consts cn then map_get consts cn else VNil)
     | _ -> VNil)
  | EScopedAssign (recv_e, cn, val_e) ->
    let rv = eval_e env world blk recv_e in
    let v = eval_e env world blk val_e in
    (match rv with
     | VClass c -> let _ = const_store world (c ++ "::" ++ cn) v in v
     | _ -> raise_exc world "TypeError" (inspect rv ++ " is not a class/module"))
  | EIVar name ->
    let (meths, sup, ocls, ivars) = world in
    // a name still starting with @ is a class variable (@@x).
    if str_len name > 0 && str_eq (char_at name 0) "@" then
      cvar_get env world (substring name 1 (str_len name))
    else
    if lv_has env "self" then
      (let k = ivar_self_key (lv_get env "self") name in
       if (if str_eq k "" then false else true) && map_has ivars k then map_get ivars k else VNil)
    else VNil
  // the flip-flop operator: off -> the left condition may switch it on;
  // on -> the right condition may switch it off. `...` (exclusive) skips
  // the right condition on the switching-on iteration; `..` checks it at
  // once (a single-element range fires exactly one iteration).
  | EFlipFlop (site, c1, c2, excl) ->
    let key = str_of_int site in
    let on = (match map_get ff_state key with VBool b -> b | _ -> false) in
    if on then
      let v2 = eval_e env world blk c2 in
      let _ = if truthy v2 then map_set ff_state key (VBool false) else () in
      VBool true
    else
      let v1 = eval_e env world blk c1 in
      if truthy v1 then
        let _ = map_set ff_state key (VBool true) in
        let _ = (if excl then ()
                 else
                   let v2 = eval_e env world blk c2 in
                   if truthy v2 then map_set ff_state key (VBool false) else ()) in
        VBool true
      else VBool false
  | EAmbigIdx (name, items) ->
    if lv_has env name then eval_e env world blk (EMethod (EVar name, "[]", items))
    else eval_e env world blk (ECall (name, Cons (EArr items, Nil)))
  | ERange (loe, hie, excl) ->
    // Both bounds are kept AS THEY ARE. An absent bound (`(1..)`, `(..9)`)
    // is nil, exactly as in ruby, and no bound is coerced: a string range
    // stays a Range, a float bound stays a float, a Time bound stays a Time.
    (let lo = eval_e env world blk loe in
     let hi = eval_e env world blk hie in
     if rng_bad_bounds world lo hi then raise_exc world "ArgumentError" "bad value for range"
     else VRange (lo, hi, excl))
  | ETern (cond, then_e, else_e) ->
    if truthy (eval_e env world blk cond) then eval_e env world blk then_e
    else eval_e env world blk else_e
  | ECaseNone -> VNil   // only meaningful as an SCase subject marker
  | EDefined e ->
    // A desugared string or regexp LITERAL answers "expression", not the `+`
    // chain (nor the `.__regex` call) it is built from. The lexer opens both
    // with an empty TStrL, so the leftmost leaf of the chain marks it -- and
    // ruby answers "expression" for a literal however many interpolations it
    // has, INCLUDING ones that would raise, because defined? never evaluates
    // it. `"" + x` written by hand is indistinguishable and gets the same
    // answer, where ruby says "method"; that is the price of the marker.
    // ...and the answer is a FROZEN string, which the spec checks. mkstr
    // allocates a fresh id per call, so this freezes only this one object.
    (let ans9 =
      (if interp_literal e then mkstr "expression"
    else
    (match e with
     | ENil -> mkstr "nil"
     | EBool b -> if b then mkstr "true" else mkstr "false"
     // `&&`, `||`, `and` and `or` are CONTROL FLOW, not method calls: ruby
     // answers "expression" for them however undefined their operands are,
     // and evaluates nothing. That is most of what defined? is asked in
     // ruby/spec, and answering "method" was wrong for all of it.
     //
     // Every other operator IS a method call, and there ruby EVALUATES the
     // operands -- side effects and all -- and answers nil if that raises.
     // `defined?(1 == nope)` is nil, `defined?(not DS.raises)` is nil, and
     // `defined?(DS.side_effects == 1)` really does run side_effects.
     | EBin (op, l, r) ->
       (if str_eq op "&&" || str_eq op "||" then mkstr "expression"
        else if defined_operand_failed env world blk l then VNil
        else if defined_operand_failed env world blk r then VNil
        // ...and the operator has to exist ON THE VALUE the left operand
        // produced: `defined?(DS.side_effects / 2)` is nil when what
        // side_effects returns has no #/ , even though both operands are
        // themselves perfectly defined.
        else
          (let lv9 = defined_eval_recv env world blk l in
           match lv9 with
           | VSym m9 -> (if str_eq m9 "__mere_defined_fail__" then VNil else mkstr "method")
           | _ -> (if responds world lv9 op then mkstr "method" else VNil)))
     | EUn (_, x) ->
       (if defined_operand_failed env world blk x then VNil else mkstr "method")
     | ESelf -> mkstr "self"
     | EVar name ->
       // The parser answers some forms WITHOUT evaluating them -- an
       // assignment, a setter call, a compound statement -- and routes them
       // here under a marker name so the answer is frozen like every other
       // one (the spec checks `defined?(x = 1).frozen?`).
       if str_eq name "__defined__assignment" then mkstr "assignment"
       else if str_eq name "__defined__method" then mkstr "method"
       else if str_eq name "__defined__expression" then mkstr "expression"
       // keyword literals reach here as bare names inside defined?(...).
       else if str_eq name "nil" then mkstr "nil"
       else if str_eq name "true" then mkstr "true"
       else if str_eq name "false" then mkstr "false"
       else if str_eq name "self" then mkstr "self"
       // `defined?(yield)` / `defined?(super)` reach here as bare words (the
       // word precedes the closing paren). yield is defined iff a block was
       // given; super iff the current method has an ancestor definition.
       // A bare word inside defined?(...) is taken as a NAME by the parser, so
       // these never reach the nodes they would normally parse to:
       // `defined?(__LINE__)` would be an EInt and `defined?(break)` an EFlow,
       // and both answer "expression" in ruby. Read as names they were neither
       // a local nor a method, so every one of them was nil.
       else if str_eq name "__FILE__" || str_eq name "__LINE__" || str_eq name "__ENCODING__"
               || str_eq name "break" || str_eq name "next" || str_eq name "redo"
               || str_eq name "retry" || str_eq name "return" then mkstr "expression"
       else if str_eq name "yield" then (let (has, _, _, _) = blk in if has then mkstr "yield" else VNil)
       else if str_eq name "super" then defined_super_str env world
       // $globals and @/@@-prefixed names have their own categories.
       else if str_len name > 0 && str_eq (char_at name 0) "$" then
         (let k = gvar_slot (substring name 1 (str_len name)) in
          // MRI special-cases $! and $~: they are "global-variable" even when
          // nothing has been raised or matched. The comment in
          // language/defined_spec says so, and the spec asserts it.
          if str_eq k "!" || str_eq k "~" then mkstr "global-variable"
          // $& / $` / $' are READ OUT of $~, so they are defined exactly when
          // the last match succeeded -- not when a slot of their own exists.
          else if str_eq k "&" || str_eq k "`" || str_eq k "'" || str_eq k "+" then
            (if map_has globals "~" && truthy (map_get globals "~") then mkstr "global-variable" else VNil)
          else if str_len k == 1 && k >= "1" && k <= "9" then
            (if map_has globals k && truthy (map_get globals k) then mkstr "global-variable" else VNil)
          else if map_has globals k then mkstr "global-variable" else VNil)
       else if str_len name >= 2 && str_eq (substring name 0 2) "@@" then
         let (m2, s2, o2, iv2) = world in
         (if map_has cvars (cvar_cls env world ++ "@" ++ substring name 2 (str_len name)) then mkstr "class variable" else VNil)
       else if str_len name > 0 && str_eq (char_at name 0) "@" then
         let (m2, s2, o2, ivars2) = world in
         let iv = substring name 1 (str_len name) in
         (match lv_get env "self" with
          | VObj id -> if map_has ivars2 (str_of_int id ++ "@" ++ iv) then mkstr "instance-variable" else VNil
          | VMain -> if map_has ivars2 ("main@" ++ iv) then mkstr "instance-variable" else VNil
          | VClass c -> if map_has ivars2 ("cls:" ++ c ++ "@" ++ iv) then mkstr "instance-variable" else VNil
          | _ -> VNil)
       // a CONSTANT read walks the lexical nesting and then the ancestors, so
       // `defined?(MixinConstant)` inside a class that includes Mixin is
       // "constant". Only the bare name was tried here.
       else if is_upper_first name then eval_e env world blk (EDefined (EConst name))
       else if lv_has env name then mkstr "local-variable"
       else if is_method_defined env world name || is_kernel_builtin name then mkstr "method"
       else VNil
     | ECall (name, _) -> if is_method_defined env world name || is_kernel_builtin name then mkstr "method" else VNil
     | ECallB (name, _, _, _) -> if is_method_defined env world name || is_kernel_builtin name then mkstr "method" else VNil
     | EIVar name ->
       let (meths, sup, ocls, ivars) = world in
       (let k = ivar_self_key (lv_get env "self") name in
        if (if str_eq k "" then false else true) && map_has ivars k then mkstr "instance-variable" else VNil)
     | EConst name ->
       // a qualified name's head can be lexically scoped: inside `module M`,
       // `I::K` is `M::I::K` (the same walk EConst's evaluation does).
       // `::Name` carries its prefix and is top level only.
       // ⚠ THE PRIVACY CHECK COMES FIRST. A private constant is in `consts`
       // under its qualified name, so the plain membership test below answered
       // "constant" for a name that raises when read -- defined? has to agree
       // with the read.
       (if str_contains name "::" && map_has private_consts name then VNil
        else if str_len name > 2 && str_eq (substring name 0 2) "::" then
          (let n9 = substring name 2 (str_len name) in
           if map_has consts n9 || map_has consts ("Object::" ++ n9) then mkstr "constant" else VNil)
        // an autoload (Set, Pathname) is a constant that exists before it loads
        else if map_has consts name || map_has autoloads name then mkstr "constant"
        else if (let cref9 = (if lv_has env "__cref" then (match lv_get env "__cref" with VStr s9 -> sget s9 | _ -> "") else cur_lex ()) in
                 (if str_eq (lex_const_key cref9 name) "" then false else true)
                 || (if str_eq (anc_const_key world cref9 name) "" then false else true)) then mkstr "constant"
        else if str_contains name "::" then
          // ⚠ a PRIVATE constant is not defined? through the scope operator --
          // the whole point of private_constant is that `M::X` cannot see it,
          // and defined? has to agree with the read rather than answer
          // "constant" for a name that would raise.
          (if map_has private_consts name then VNil
           else
           let cref0 = (if lv_has env "__cref" then (match lv_get env "__cref" with VStr s2 -> sget s2 | _ -> "") else cur_lex ()) in
           let hk = lex_const_key cref0 (const_head name) in
           // ... and, as when reading it, along the receiver's ancestors.
           let anc = (if str_eq (anc_const_key_q world (recv_of_scoped name) (const_of_scoped name)) "" then false else true) in
           if ((if str_eq hk "" then false else true) && map_has consts (hk ++ "::" ++ const_tail name)) || anc
           then mkstr "constant" else VNil)
        else VNil)
     | EMethod (recv, name, _) ->
       let (meths, sup, ocls, ivars) = world in
       // evaluating the receiver may raise (undefined var); defined? is nil.
       // A throw/break/next in the receiver, however, escapes normally.
       let rv = defined_eval_recv env world blk recv in
       if (match rv with VSym m -> str_eq m "__mere_defined_fail__" | _ -> false) then VNil else
       (match rv with
        | VObj id ->
          // ruby answers `defined?(o.m)` by ASKING the object: a singleton or
          // user-defined respond_to? decides it, and a method the dispatcher
          // implements (`o.to_s`) counts as much as one in the table.
          (let cls = map_get ocls id in
           if has_meth world cls name then
             (if meth_private world cls name then VNil
              else if meth_protected world cls name
              then (if protected_ok env world cls then mkstr "method" else VNil)
              else mkstr "method")
           // a method the dispatcher implements (`o.to_s`) is defined too...
           else if is_prim_method name || builtin_obj_has cls name then mkstr "method"
           // ...and so is one the object only CLAIMS, through respond_to? or
           // respond_to_missing? -- which is why ruby ends up asking it.
           else if responds world rv name then mkstr "method" else VNil)
        | VClass c -> if str_eq name "new" || has_meth world c name || has_meth world ("(sng:" ++ c ++ ")") name then mkstr "method" else VNil
        // ...and a PRIMITIVE receiver is asked too. This answered "method"
        // for anything at all, so `defined?(1.foo)` and `defined?("s".nope)`
        // both claimed a method that does not exist.
        | _ ->
          (let cls9 = dispatch_cls_of world rv in
           if has_meth world cls9 name then
             (if meth_private world cls9 name then VNil else mkstr "method")
           else if responds world rv name then mkstr "method"
           else VNil))
     | EScopedRead (recv, cn) ->
       // defined?(recv::Const): the receiver may raise or be a non-class
       // (e.g. `a::B` where a() returns nil) — then the const is undefined.
       let rv = defined_eval_recv env world blk recv in
       if (match rv with VSym m -> str_eq m "__mere_defined_fail__" | _ -> false) then VNil
       else (match rv with
             | VClass c -> if map_has consts (c ++ "::" ++ cn) then mkstr "constant" else VNil
             | _ -> VNil)
     | EYield _ -> let (has, _, _, _) = blk in if has then mkstr "yield" else VNil
     // An array LITERAL is defined only if every element is: ruby answers nil
     // for `defined?([Object, Undefined])`. It was "expression" whatever it
     // held, because the literal fell into the catch-all.
     | EArr es9 -> (if defined_all_elems env world blk es9 then mkstr "expression" else VNil)
     // `defined? super` WITHOUT parens parses as a real super node (the
     // parenthesised spelling reaches EVar "super" instead), so this arm was
     // missing and every one of them answered "expression".
     | ESuper (_, _) -> defined_super_str env world
     | _ -> mkstr "expression")) in   // literals, operators, ranges, ternary
     (match ans9 with VStr h9 -> (let _ = sfrozen_set h9 in ans9) | _ -> ans9))
  | ESuper (zsuper, arges) ->
    let (meths, sup, ocls, ivars) = world in
    let defcls = (match lv_get env "__defcls" with VClass c -> c | _ -> "") in
    let meth = (match lv_get env "__meth" with VStr s -> let s = sget s in s | _ -> "") in
    let recv = if lv_has env "self" then lv_get env "self" else VMain in
    // a bare (implicit-args) `super` from a define_method-defined method has no
    // fixed argument list to forward, so Ruby raises RuntimeError.
    if zsuper && map_has dm_methods (defcls ++ "#" ++ meth) then
      raise_exc world "RuntimeError" "implicit argument passing of super from method defined by define_method() is not supported. Specify all arguments explicitly."
    else
    // `super(args, &block)` / `super(args, &nil)` forwards an explicit block
    // (nil = no block); otherwise super passes along the current block.
    let (arges, superblk) =
      (match rev_app arges Nil with
       | Cons (EBlockPass be, rrest) -> (rev_app rrest Nil, coerce_to_block env world blk (eval_e env world blk be))
       | _ -> (arges, blk)) in
    // zsuper forwards the CURRENT parameter values (defaults applied,
    // splat expanded), not the original call arguments.
    let args = if zsuper then
                 (if lv_has env "__params" then
                    (match lv_get env "__params" with
                     | VArr pid -> zsuper_all env (deref pid)
                     | _ -> (match lv_get env "__args" with VArr id -> deref id | _ -> Nil))
                  else (match lv_get env "__args" with VArr id -> deref id | _ -> Nil))
               else eval_args env world blk arges in
    // resume the method search in the receiver's ancestor chain, strictly
    // after the class/module the current method is defined in — so super walks
    // included modules too. A singleton-class defcls uses the singleton chain.
    if is_sng_cls defcls then
      (let supercls = sng_supername world defcls in
       if has_meth world supercls meth then invoke world superblk recv supercls meth args
       // a definition hook (inherited / included / ...) is a no-op in Ruby,
       // so `super` from an override of one has somewhere to land.
       else if is_definition_hook meth then VNil
       // `super` from a `def self.new` override is Class#new: allocate and
       // run initialize, exactly as the built-in path would have.
       else if str_eq meth "new" then (match recv with VClass c9 -> new_obj_wb world c9 args superblk | _ -> raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'"))
       // the methods Class/Module themselves provide (append_features,
       // autoload, method_missing, ...) are ancestors of a singleton too, so
       // `super` from a `def self.` override of one lands there rather than
       // running out of chain.
       else super_missing world superblk recv meth args)
    else
      (let a2 = lookup_anc world (anc_after (ancestors_of world (super_base world recv)) defcls) meth in
       if str_eq a2 "" then super_missing world superblk recv meth args
       else run_meth world superblk recv a2 meth (map_get meths (a2 ++ "#" ++ meth)) args)
  | ESuperB (zsuper, arges, bp, bb) ->
    let (meths, sup, ocls, ivars) = world in
    // a block written at a call site captures the ENCLOSING method's block, so
    // `yield` inside it reaches the caller's block rather than nothing --
    // `super { |x| yield(x) }` depends on it, exactly as `m { yield }` does.
    let (sbh, sbp, sbb, sbe) = blk_capture blk (true, bp, bb, env) bb in
    let defcls = (match lv_get env "__defcls" with VClass c -> c | _ -> "") in
    let meth = (match lv_get env "__meth" with VStr s -> let s = sget s in s | _ -> "") in
    let recv = if lv_has env "self" then lv_get env "self" else VMain in
    let args = if zsuper then
                 (if lv_has env "__params" then
                    (match lv_get env "__params" with
                     | VArr pid -> zsuper_all env (deref pid)
                     | _ -> (match lv_get env "__args" with VArr id -> deref id | _ -> Nil))
                  else (match lv_get env "__args" with VArr id -> deref id | _ -> Nil))
               else eval_args env world blk arges in
    if is_sng_cls defcls then
      (let supercls = sng_supername world defcls in
       if has_meth world supercls meth then invoke world (sbh, sbp, sbb, sbe) recv supercls meth args
       // a definition hook (inherited / included / ...) is a no-op in Ruby,
       // so `super` from an override of one has somewhere to land.
       else if is_definition_hook meth then VNil
       // `super` from a `def self.new` override is Class#new: allocate and
       // run initialize, exactly as the built-in path would have.
       else if str_eq meth "new" then (match recv with VClass c9 -> new_obj_wb world c9 args (sbh, sbp, sbb, sbe) | _ -> raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'"))
       else raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'"))
    else
