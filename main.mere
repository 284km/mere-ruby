  // value-level flatten then sees plain arrays.
  if (str_eq name "flatten" || str_eq name "flatten!")
     && (match recv with VArr _ -> true | _ -> false)
     && (match args with Nil -> true | Cons (VInt _, Nil) -> true | _ -> false) then
