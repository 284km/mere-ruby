  // while `(a..b).inspect` fell through to the world-free printer and said
  // `#<object>..#<object>`: the same question with two answers, decided by
  // how it was asked. #to_s asks each bound's #to_s, which is a third way of
  // asking it and was wrong for the same reason.
  else if (str_eq name "inspect" || str_eq name "to_s")
          && (match recv with VRange (_, _, _) -> true | _ -> false) then
