     //   do. ruby 4 does it: the copy keeps both.
     | VHsh hid ->
       (let cp9 = mkhash (hash_drop_nil (hderef hid)) in
        let _ = hcbi_copy hid cp9 in
        let _ = (match cp9 with
                 | VHsh d9 ->
                   (let _ = (if map_has hash_dflt (str_of_int hid)
                             then map_set hash_dflt (str_of_int d9) (map_get hash_dflt (str_of_int hid)) else ()) in
                    (if map_has hash_dproc (str_of_int hid)
                     then map_set hash_dproc (str_of_int d9) (map_get hash_dproc (str_of_int hid)) else ()))
                 | _ -> ()) in
