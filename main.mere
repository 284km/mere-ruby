        else if str_eq e "UTF-8" then
          (match utf8_cp_strict sv 0 with
           | (c, l, ok) -> if ok then VInt c else prim_raise "ArgumentError" "invalid byte sequence in UTF-8")
        else if str_eq e "US-ASCII" then
          (let b0 = ord (char_at sv 0) in
           if b0 < 128 then VInt b0 else prim_raise "ArgumentError" "invalid byte sequence in US-ASCII")
        else VInt (match utf8_cp sv 0 with (c, l) -> c))
