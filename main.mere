           else arr_new (val_flatten (hderef h) (d9 - 1)))
        | Cons (VNil, Nil) -> arr_new (val_flatten (hderef h) (0 - 1))
        | Cons (other9, Nil) ->
          prim_raise "TypeError" ("no implicit conversion of " ++ class_name other9 ++ " into Integer")
        | _ -> prim_raise "ArgumentError"
