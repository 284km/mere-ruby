     | VStr h -> let a = sget h in
       let n = str_len a in
       (match args with
        | Cons (VStr sb, rest) ->
          let _ = enc_pair_guard h sb in
          let off0 = (match rest with
                      | Cons (VInt o, _) -> o
                      | Cons (VNil, _) ->
