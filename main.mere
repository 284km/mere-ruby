// key is the element itself or what the block answers for it.
and arr_uniq_w = fn env -> fn world -> fn (xs: Val list) -> fn (keys: Val list) -> fn (seen: Val list) ->
  match xs with
  | Nil -> (Nil : Val list)
  | Cons (h, t) ->
    (let (k, krest) = (match keys with Cons (k9, kr) -> (k9, kr) | Nil -> (h, (Nil : Val list))) in
     if uniq_seen env world seen k then arr_uniq_w env world t krest seen
