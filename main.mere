        if bits <= 0 then VInt total
        else VInt (int_bitop "&" total (shl_int 1 bits - 1)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "sum") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'sum'")) in fail "mere-ruby: undefined method 'sum'")))
  else if str_eq name "scan" then
    // a String pattern scans for the LITERAL string (it is not a regexp).
