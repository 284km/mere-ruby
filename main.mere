                  | Cons (a9, _) -> rng_take_count world a9 false
                  | _ -> 0) in
        let lo_s = rng_int_side lo9 in
        // the last ELEMENT: one back when the end is excluded, and derived
        // from a Float end as well as an integer one. An INFINITE end is
        // endless, like a missing one.
