  // Range#begin / #end / #exclude_end? -- the endpoints as WRITTEN, which is
  // what an arity range is read with (`node.arity_range.begin`). Bare `last`
  // is the written end too; only `last(n)` counts elements.
  else if (str_eq name "begin" || str_eq name "end" || str_eq name "exclude_end?"
           || (str_eq name "last" && (match args with Nil -> true | _ -> false)))
          && (match recv with VRange _ -> true | _ -> false) then
    (match recv with
     // the bounds AS WRITTEN: `(1..).end` is nil, not a huge integer, and
     // `("a".."z").begin` is "a".
     | VRange (lo, hi, excl) ->
