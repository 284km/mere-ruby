  else if str_eq name "grapheme_clusters" then
    (match recv with
     | VStr h -> arr_new (rb_graphemes (sget h) (enc_canon_name (senc_get h)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "grapheme_clusters") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'grapheme_clusters'")) in fail "mere-ruby: undefined method 'grapheme_clusters'")))
