  // whole chain -- outermost first for `order: :top`, deepest first under a
  // single "Traceback" header for `order: :bottom`. Printing only the
  // exception itself lost every "inner" a nested raise had wrapped.
  let chain9 = exc_cause_chain env world recv VNil 8 in
  let _ = map_set fm_kw "v" (match fargs with Cons (VHsh h8, _) -> VHsh h8 | _ -> VNil) in
  let e9 = chr 27 in
  if bottom then
    (if hl then e9 ++ "[1mTraceback" ++ e9 ++ "[m (most recent call last):\n"
     else "Traceback (most recent call last):\n")
    ++ exc_blocks_rev env world (rev_app_str chain9 Nil) hl
  else exc_blocks env world chain9 hl

// the exception and its causes, outermost first, each paired with the frames
// recorded for it beside the link (VNil = ask the exception itself). Bounded
// so a cause cycle (ruby allows `raise x, cause: y` to build one) cannot spin.
// the keywords #detailed_message is called with: ALL of the caller's, in the
// order they were given, plus `highlight` when the caller did not name it.
// ⚠ `order` travels too -- ruby forwards a `order:` the caller WROTE and only
// declines to add its own default for it, which is what the spec's title
// ("with :highlight default value and without :order default value") means.
// Dropping it reordered the hash and lost a key the caller had passed.

and exc_cause_chain = fn env -> fn world -> fn (recv: Val) -> fn (bt9: Val) -> fn (fuel9: int) ->
  if fuel9 <= 0 then Cons ((recv, bt9), Nil)
  else
    let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
    (match invoke_val_c env world noblk9 recv "cause" Nil false with
     | VNil -> Cons ((recv, bt9), Nil)
     | c9 -> (if rb_eq c9 recv then Cons ((recv, bt9), Nil)
              else Cons ((recv, bt9), exc_cause_chain env world c9 (exc_cause_bt world recv) (fuel9 - 1))))

// the frames this exception recorded for its cause, if any.


// `order: :top`: each exception's head line then its frames, outermost first.
and exc_blocks = fn env -> fn world -> fn (xs: (Val * Val) list) -> fn (hl: bool) ->
  match xs with
  | Nil -> ""
  | Cons ((h9, b9), t9) -> exc_one_message env world h9 b9 hl false ++ exc_blocks env world t9 hl

// `order: :bottom`: frames upside down then the head line, deepest cause first.
and exc_blocks_rev = fn env -> fn world -> fn (xs: (Val * Val) list) -> fn (hl: bool) ->
  match xs with
  | Nil -> ""
  | Cons ((h9, b9), t9) -> exc_one_message env world h9 b9 hl true ++ exc_blocks_rev env world t9 hl

and exc_one_message = fn env -> fn world -> fn (recv: Val) -> fn (btov9: Val) -> fn (hl: bool) -> fn (bottom: bool) ->
  let e9 = chr 27 in
  let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  // `highlight:` is a KEYWORD argument, and an override written `def
  // exception.detailed_message(**)` only accepts it as one -- an unmarked hash
  // arrives as a positional argument and earns an ArgumentError from the very
  // method whose customisation is the point of calling it.
  // ⚠ EVERY KEYWORD THE CALLER GAVE IS FORWARDED, not just `highlight`.
  // `e.full_message(foo: "bar")` reaches #detailed_message as
  // {foo: "bar", highlight: Exception.to_tty?} -- `order` is full_message's
  // own and stays behind. Rebuilding the hash from `highlight` alone dropped
  // whatever else was passed.
  let kwh9 = (match mkhash (exc_dm_kw_pairs (if map_has fm_kw "v" then map_get fm_kw "v" else VNil) hl) with
              | VHsh hid9 -> (let _ = mark_kw hid9 in VHsh hid9)
              | other9 -> other9) in
  // ⚠ WHAT detailed_message RETURNS IS NOT ALWAYS THE MESSAGE. Ruby converts
  // it with #to_str -- not #to_s -- and where that is not available (nil, an
  // Integer, anything else) it falls back to the exception's CLASS NAME,
  // underlined like the class always is. Printing to_s of it put "" in the
  // report for an override that answered nil.
  // ...and an exception whose #detailed_message has been UNDEF'd takes the
  // same fallback rather than a NoMethodError. Asked as `responds`, this was
  // false for the cheap VExc representation too, and every real raise lost
  // its message -- the undef question has to be asked as an undef question.
  let dmv9 = (if undef_blocked world (exc_cls_of world recv) "detailed_message"
              then VNil
              else invoke_val_c env world noblk9 recv "detailed_message" (Cons (kwh9, Nil)) false) in
  let dm9 = (match dmv9 with
             | VStr h9 -> sget h9
             | o9 ->
               (if responds world o9 "to_str"
                then (match invoke_val_c env world noblk9 o9 "to_str" Nil false with
                      | VStr h8 -> sget h8
                      | other8 -> to_s other8)
                else (let shown8 = cls_display world (display_cls world (exc_cls_of world recv)) in
                      if hl then e9 ++ "[1;4m" ++ shown8 ++ e9 ++ "[m" else shown8))) in
  let bt9 = (match btov9 with
             | VArr aid8 -> bt_strs_of (deref aid8)
             | _ -> (match invoke_val_c env world noblk9 recv "backtrace" Nil false with
                     | VArr aid9 -> bt_strs_of (deref aid9)
                     | _ -> (Nil : str list))) in
  let e9 = chr 27 in
  match bt9 with
  // ⚠ NO BACKTRACE STILL HAS A HEAD LINE. An exception that was built but
  // never raised has none, and ruby names the place full_message was CALLED
  // ("file:line:in 'full_message'") rather than printing the message bare.
  | Nil ->
    (cur_file () ++ ":" ++ str_of_int (cur_line ()) ++ ":in 'full_message': " ++ dm9 ++ "\n")
  | Cons (top9, rest9) ->
    (if bottom then bt_from_lines_rev rest9 1 ++ top9 ++ ": " ++ dm9 ++ "\n"
     else top9 ++ ": " ++ dm9 ++ "\n" ++ bt_from_lines rest9)
// a keyword read off the trailing options hash: `highlight: true` and
// `order: :bottom`. Absent means the default, and so does a hash that is not
// there at all -- ruby's own defaults for a non-tty.
// `order: :bottom` counts the frames DOWN from the outermost, so the numbers
// read the way a stack trace does when the innermost line is last.

// How ruby names the RECEIVER of an undefined / private / protected method: the
// three singletons by their VALUE ("for nil", "for true", "for false"), and
// everything else by its class ("for an instance of Foo"). Ruby 3.4 introduced
// the second wording and this followed it -- for all five, so `nil.foo` read
// "for an instance of NilClass" where every ruby says "for nil". One rule, three
// spellings of the argument the call sites already had, so that no site has to
// decide it a fourth way.
// The class an OBJECT prints as. Its recorded class may be its own SINGLETON
// (that is how dispatch finds `def o.x`), and ruby prints the class the object
// is an instance of. Written once: it was needed in four places and was in none
// of them, so every object that had ever been given a singleton method printed
// `#<#<Class:#<C:0x..>>:0x..>` through #inspect, #to_s, `p` and the
// "undefined method ... for" message alike.
and for_recv_cls = fn world -> fn (c: str) -> for_recv_msg (display_cls_msg world c)
and for_recv_disp = fn world -> fn (c: str) -> for_recv_msg (cls_display world c)
// ...and an object that HAS a singleton class is named by its own inspect:
// "an instance of C" is a claim about a class the object no longer shares with
// anything, so ruby prints the object instead.
and for_recv_obj = fn env -> fn world -> fn (recv: Val) -> fn (c: str) ->
  (match recv with
   | VObj oid9 ->
     (let (_, _, ocls9, _) = world in
      if is_sng_cls (map_get ocls9 oid9)
      then inspect_w env world recv
      else for_recv_cls world c)
   | _ -> for_recv_cls world c)

and cls_display = fn world -> fn (c: str) ->
  let (meths, sup, ocls, ivars) = world in
  if is_sng_cls c then
    (let inner = sng_inner c in
     if str_len inner > 0 && is_digit (char_at inner 0)
     then (let oid = int_of_str inner in
           // an object WITH a singleton class has that singleton recorded as its
           // class (that is how dispatch finds it), so the name has to be walked
           // back to the real one -- display_cls is that walk.
           let ocn = display_cls world (if map_has ocls oid then map_get ocls oid else "Object") in
           "#<Class:#<" ++ ocn ++ ":0x" ++ hex16_of oid ++ ">>")
     else "#<Class:" ++ cls_display world inner ++ ">")
  else if is_anon_cls c then
    (let addr9 = (let kind = (if str_len c >= 11 && str_eq (substring c 0 11) "AnonModule_" then "Module" else "Class") in
                  "#<" ++ kind ++ ":0x" ++ hex16_of (anon_addr_of c) ++ ">") in
     if map_has anon_name c then (match map_get anon_name c with VStr h -> sget h | _ -> c)
     // ...and a class that answers its own #name decides what it is called.
     // Ruby builds this text by ASKING the class, so an anonymous class with a
     // `def self.name` is reported by that name and not by an address -- four
     // of no_method_error_spec's examples are that one fact.
     else if has_meth world ("(sng:" ++ c ++ ")") "name" then
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        match invoke world nb9 (VClass c) ("(sng:" ++ c ++ ")") "name" Nil with
        | VStr h9 -> sget h9
        | _ -> addr9)
     else addr9)
  else c

// the bare method name from a possibly receiver-qualified one ("C#m" -> "m");
// `def` evaluates to the method name as a symbol.


// register a refinement of `target` under `refinery`: run its body into a
// fresh impl_cls class and record the triple for a later `using`.
// Ruby forces a few hook methods private the moment they are defined, whatever
// the surrounding visibility mode is — so they never show up in
// instance_methods and cannot be called with an explicit receiver.

and do_refine = fn world -> fn (refinery: str) -> fn (target: str) -> fn (bb: Stmt list) ->
  let i = (if map_has refine_cnt refinery then (match map_get refine_cnt refinery with VInt n -> n | _ -> 0) else 0) in
  let impl_cls = "Refine_" ++ refinery ++ "_" ++ str_of_int i in
  // The body is a BLOCK, so it does not open a constant scope: `refine String
  // do Presenter … end` inside `module M` must see M's constants, not the
  // synthetic Refine_M_0 namespace. Defs still land on impl_cls; only the
  // lexical scope for constant lookup is the enclosing module.
  let _ = flow_value (register_class_blk world impl_cls bb refinery (map_new ())) in
  let _ = map_set refine_tgt (refinery ++ "#" ++ str_of_int i) (mkstr target) in
  let _ = map_set refine_cls (refinery ++ "#" ++ str_of_int i) (mkstr impl_cls) in
  let _ = map_set refine_cnt refinery (VInt (i + 1)) in
  VClass impl_cls

// activate refinery's refinements: for each recorded (target, impl_cls), point the
// target class at the impl_cls in ref_active.

// clear ref_active and repopulate from `saved` (restore a scope's snapshot).




// `alias new old` in the body of `cls`. Both the class-body walker and the
// STATEMENT form need it: an alias written inside an `if`, an `unless` or a
// block is not a top-level statement of the body, so the walker never sees it
// and it reaches exec_stmt instead -- which aliased BARE names (top-level
// methods) and left the class without the method. rubygems guards its
// `alias gem_original_require require` with `unless defined?(...)`, so the one
// alias the whole of `require` hangs off was the one that did not happen.
and do_class_alias = fn world -> fn (cls: str) -> fn (n1: str) -> fn (n2: str) ->
  let (meths, sup, ocls, ivars) = world in
  // ⚠ the source may be INHERITED: `class B < A; alias aka pub; end` aliases
  //   A's method. Only this class's table was read, so an inherited source
  //   looked like a BUILTIN and the alias delegated to prim_method under that
  //   name -- which no primitive has, so the alias was a NameError. (The
  //   alias_method form walks the ancestors and always did.)
  let src = (if map_has meths (cls ++ "#" ++ n2) then cls
             else (let a9 = lookup_anc world (ancestors_of world cls) n2 in
                   if str_eq a9 "" then cls else a9)) in
  // the name this alias was made FROM, which is what Method#original_name
  // answers. alias_method recorded it and the `alias` keyword did not, so the
  // same alias written two ways gave two different original_names -- one
  // fact, two writers, and only one of them wrote.
  let _ = (if str_eq n1 n2 then () else map_set alias_srcname (cls ++ "#" ++ n1) n2) in
  // ...and when it CAME from an ancestor, `super` inside the copy has to
  // resume above THAT class, not above the aliasing one: alias_method records
  // the same thing in alias_origin, and without it the copy's super found the
  // module it was copied from again (bootstraptest's `include Forward; alias
  // bar foo` answered [:Forward, [:Forward, :SecondTerminus]]).
  let _ = (if str_eq src cls then () else map_set alias_origin (cls ++ "#" ++ n1) src) in
  let _ = if map_has meths (src ++ "#" ++ n2) then
            (let _ = set_meth meths (cls ++ "#" ++ n1) (map_get meths (src ++ "#" ++ n2)) in
             // an alias keeps the original's lexical scope (see alias_method)
             let _ = copy_meth_src (cls ++ "#" ++ n1) (src ++ "#" ++ n2) in
             if map_has meth_cref (src ++ "#" ++ n2)
             then map_set meth_cref (cls ++ "#" ++ n1) (map_get meth_cref (src ++ "#" ++ n2)) else ())
          // the source is a BUILTIN (no AST body): record that the new name
          // delegates to prim_method under the old one, exactly as alias_method
          // does. `alias _pack pack` in a reopened Array is how a wrapper keeps
          // hold of the original.
          else (let _ = (if str_eq n1 n2 then () else map_set alias_srcname (cls ++ "#" ++ n1) n2) in
                set_builtin_alias world cls n1 n2) in
  // ...and it keeps the ORIGINAL'S VISIBILITY. `alias :aka :bar` under a
  // `private` copies a private method, and the copy is private too: it was
  // public, so `public_send(:aka)` reached a method public_send must refuse.
  let _ = (let k1 = cls ++ "#" ++ n1 in
           let k2 = src ++ "#" ++ n2 in
           let _ = (if map_has privates k1 then map_delete privates k1 else ()) in
           let _ = (if map_has protecteds k1 then map_delete protecteds k1 else ()) in
           if map_has privates k2 then (let _ = map_set privates k1 VNil in ())
           else if map_has protecteds k2 then (let _ = map_set protecteds k1 VNil in ())
           else ()) in
  // an alias ADDS a method, so `method_added` fires for the new name --
  // rubocop-ast registers its visitors from that hook and writes
  // `alias visit_number visit_symbol`, so an alias that stays quiet leaves the
  // visitor unregistered and the compiler recurses forever.
  run_method_added world cls n1
and register_class_lex = fn world -> fn (cls: str) -> fn (body: Stmt list) ->
  let saved_lex = cur_lex () in
  let _ = set_lex cls in
  // The body can raise -- a require that fails inside a class body is
  // ordinary. The lexical scope has to be restored anyway, or every
  // top-level constant assigned afterwards is silently keyed under this
  // class: `TOP = 1` at the top level of a later file becomes Cls::TOP.
  let r = try_or (fn (u: unit) -> register_class world cls body) (FRaise VNil) in
  let _ = set_lex saved_lex in
  (match r with
   | FRaise _ -> fail (if map_has prim_missing "i" then (match map_get prim_missing "i" with VStr h -> sget h | _ -> "exception") else "exception")
   | _ -> r)

// Ruby's `inherited` hook: when a new subclass is created, call
// superclass.inherited(subclass) if a (class-level) `inherited` is defined.
and call_inherited = fn world -> fn env -> fn (super_name: str) -> fn (sub_name: str) ->
  if str_eq super_name "" then ()
  else
    let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
    // `inherited` is a class method: it lives in the superclass's singleton
    // namespace "(sng:Super)". Fall back to an instance-method lookup for a
    // builtin/legacy definition.
    if has_meth world ("(sng:" ++ super_name ++ ")") "inherited" then
      let _ = invoke world nb (VClass super_name) ("(sng:" ++ super_name ++ ")") "inherited" (Cons (VClass sub_name, Nil)) in ()
    else if has_meth world super_name "inherited" then
      let _ = invoke_val_c env world nb (VClass super_name) "inherited" (Cons (VClass sub_name, Nil)) false in ()
    else ()

and register_class_sng_in = fn world -> fn (cls: str) -> fn (body: Stmt list) -> fn (lex: str) ->
  let saved = map_copy ref_active in
  // ⚠ the scope arrives as an ARGUMENT rather than from cur_lex (). Read from
  // there it is "" inside a class body or a method body, so a bare constant in
  // the singleton's body was looked up at top level. `class << self` hid that:
  // the singleton's ANCESTORS include the enclosing module, so its constants
  // were found by the second route, and only a singleton of some OTHER object
  // showed the missing cref. (Kept from register_class_sng, the wrapper that
  // called this with cur_lex () and had no callers left.)
  // The scope KEEPS the singleton as its innermost segment. Two things have to
  // be true at once, and using the enclosing scope alone gave up the first:
  //   - a class defined in the body belongs to THIS singleton, so `class << a`
  //     and `class << b` each get their own X. Naming the enclosing module
  //     made both bodies reopen one shared class, and the second one's CONST
  //     overwrote the first's.
  //   - a constant READ in the body continues up the enclosing chain.
  // lex_const_key already walks a qualified name segment by segment, so
  // splicing the singleton in as a segment gives both: definitions land under
  // N::(sng:111), and a lookup strips back to N.
  let scope = (if str_eq lex "" then cls else lex ++ "::" ++ cls) in
  let cenv = map_new () in
  let _ = map_set cenv "self" (VClass cls) in
  let _ = map_set cenv "__cscope" (mkstr scope) in
  let _ = map_set cenv "__cref" (mkstr scope) in
  // A `def` in the body records cur_lex () as its cref (register_class_v), and
  // nothing here had set it: the methods kept the ENCLOSING class's scope and
  // could not see a constant the body itself defined, though the body could.
  // rubygems 4's vendored uri is exactly that shape -- `class << self;
  // EscapedChars = ...; def escape(name) ... EscapedChars` -- and bundler 4
  // loads it, so every bundlertest step died on `require "bundler"`.
  // register_class_blk sets the scope the same way for a class_eval block.
  let saved_lex = cur_lex () in
  let _ = set_lex scope in
  let r = try_or (fn (u: unit) -> register_class_v world cls body "public" cenv) (FRaise VNil) in
  let _ = set_lex saved_lex in
  let _ = restore_ref_active saved in
  (match r with
   | FRaise _ -> fail (if map_has prim_missing "i" then (match map_get prim_missing "i" with VStr h -> sget h | _ -> "exception") else "exception")
   | _ -> r)

// `K.instance_eval { def m; end }` is the class-body runner with the DEFINEE
// moved to K's singleton namespace: self stays K (and so do the lexical scope
// and cref, which is what bare constants inside resolve against), but the
// methods it defines are class methods. Routing it through register_class made
// them INSTANCE methods -- `K.new.d3` answered and `K.d3` did not.
and register_class_ieval = fn world -> fn (cls: str) -> fn (body: Stmt list) ->
  let saved = map_copy ref_active in
  let cenv = map_new () in
  let _ = map_set cenv "self" (VClass cls) in
  let _ = map_set cenv "__cscope" (mkstr cls) in
  let _ = map_set cenv "__cref" (mkstr cls) in
  let r = try_or (fn (u: unit) -> register_class_v world ("(sng:" ++ cls ++ ")") body "public" cenv) (FRaise VNil) in
  let _ = restore_ref_active saved in
  (match r with
   | FRaise _ -> fail (if map_has prim_missing "i" then (match map_get prim_missing "i" with VStr h -> sget h | _ -> "exception") else "exception")
   | _ -> r)

and register_class = fn world -> fn (cls: str) -> fn (body: Stmt list) ->
  // ruby's TracePoint(:class) fires when a class or module body is ENTERED --
  // zeitwerk watches for exactly that to notice an explicit namespace. The
  // flag is set by TracePoint#enable, so a program with no tracepoint pays one
  // map lookup per class body.
  let _ = (if map_has hook_flags "tp" then
             (let noblk0 = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
              let _ = invoke world noblk0 (VClass "TracePoint") "(sng:TracePoint)" "__fire" (Cons (VClass cls, Nil)) in ())
           else ()) in
  let _ = fire_trace world "class" cls cls in
  // a `using` inside this body is scoped to it: snapshot/restore ref_active.
  let saved = map_copy ref_active in
  let cenv = map_new () in
  let _ = map_set cenv "self" (VClass cls) in
  // a literal class body IS the lexical scope for the constants/classes it
  // defines; __cscope names that scope (a class_eval-style block overrides it
  // via register_class_blk). __cref makes blocks created in the body capture
  // their lexical scope for later constant resolution.
  let _ = map_set cenv "__cscope" (mkstr cls) in
  let _ = map_set cenv "__cref" (mkstr cls) in
  // ...and the refinement snapshot for the same reason.
  let r = try_or (fn (u: unit) -> register_class_v world cls body "public" cenv) (FRaise VNil) in
  let _ = restore_ref_active saved in
  (match r with
   | FRaise _ -> fail (if map_has prim_missing "i" then (match map_get prim_missing "i" with VStr h -> sget h | _ -> "exception") else "exception")
   | _ -> r)

// run a class_eval-style BLOCK body as class `cls`: defs go to the class, but
// constants and nested classes go to `cscope` — the block's LEXICAL scope
// (Ruby: a block does not open a new constant scope).
// `denv` is the BLOCK's defining scope: a class_eval block is still a block,
// so the locals around it stay visible (`us = self; base.class_eval { ... us
// ... }` is how rubocop-ast copies a registry to a subclass). Only `self` and
// the constant scope are rebound.
and register_class_blk = fn world -> fn (cls: str) -> fn (body: Stmt list) -> fn (cscope: str) -> fn denv ->
  let saved = map_copy ref_active in
  let cenv = lv_child denv in
  let _ = map_set cenv "self" (VClass cls) in
  // A CLASS BODY establishes its own definee (the class), and this env is a
  // CHILD of the block's -- so an enclosing instance_eval's definee reached
  // into it and every `def` the body could not handle itself went to the wrong
  // table. Only the forms that fall through to the statement evaluator showed
