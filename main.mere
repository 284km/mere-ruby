// to say names ITSELF instead ("unhandled exception" when it is exactly a
// RuntimeError, the class name otherwise) -- plus one about the class: an
// anonymous class has no name worth adding, so the message stands alone.
and exc_detailed_msg = fn env -> fn world -> fn (recv: Val) -> fn (hl: bool) ->
  let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let msg9 = (match invoke_val_c env world noblk9 recv "to_s" Nil false with
              | VStr h9 -> sget h9
              | o9 -> to_s o9) in
  let raw9 = display_cls world (exc_cls_of world recv) in
  let shown9 = cls_display world raw9 in
  let e9 = chr 27 in
  if str_eq msg9 "" then
