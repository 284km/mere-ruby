  // placeholder cenv: the shared gc_cenv0, not ivars. Reusing ivars here
  // unified the world's ivars type with the env type -- and envs are pinned to
  // __heap through bind_store -- which silently pinned the WHOLE world to
  // __heap and made a region-loop-carried world a type error 5000 lines away.
  let noblk = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
  let id = alloc_oid ocls in
  let _ = map_set ocls id cls in
  let obj = VObj id in
  let _ = seed_builtin_subclass_ivars world cls id args in
  if has_meth world cls "initialize" then
    let _ = invoke world noblk obj cls "initialize" args in obj
  else obj

// like new_obj but forwards a block to initialize, so `C.new { } ` /
// `C.new(&pr)` reaches an `initialize(&b)`. Containers keep their own paths.
and new_obj_wb = fn world -> fn (cls: str) -> fn (args: Val list) -> fn theblk ->
  if str_eq cls "Hash" || str_eq cls "Array" || str_eq cls "String" then new_obj world cls args
