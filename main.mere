        | Cons (VRegex (pat, pf, _), _) -> arr_new (rx_scan_all2 pat pf s 0)
        | Cons (VStr pat, _) -> arr_new (rx_scan_all2 (rx_escape (sget pat)) "" s 0)
        | Cons (other, _) -> prim_raise "TypeError" ("wrong argument type " ++ class_name other ++ " (expected Regexp)")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "scan") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'scan'")) in fail "mere-ruby: undefined method 'scan'")))
  // `lines(chomp: true)` drops each terminator, which is what a caller
