              // Hash's hash-taking methods accept anything with #to_hash
              // (merge, update, replace) -- an object argument was skipped
              // entirely, so `h.merge(obj)` answered h unchanged.
              else if (match recv with VHsh _ -> true | _ -> false)
                      && (str_eq name "merge" || str_eq name "merge!"
                          || str_eq name "update" || str_eq name "replace") then
                (let rec ch9 = fn (az: Val list) ->
                   (match az with
                    | Nil -> (Nil : Val list)
                    | Cons (a9, t9) ->
                      (let a2 = (match a9 with
                                 | VObj _ -> (match conv_try env world a9 "to_hash" with
                                              | VHsh x9 -> VHsh x9
                                              | _ -> a9)
                                 | _ -> a9) in
                       Cons (a2, ch9 t9))) in
                 ch9 args0)
