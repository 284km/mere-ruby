               ++ (match hi9 with
                   | VNil -> (match lo9 with VNil -> "nil" | _ -> "")
                   | _ -> side9 hi9)))
     | _ -> VNil)
  else if (str_eq name "inspect" || str_eq name "to_s")
          && (match recv with
              | VObj oid -> (let (_, _, ocls9, _) = world in is_struct_obj_cls world (map_get ocls9 oid))
              | _ -> false)
