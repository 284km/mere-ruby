// computing the text here directly would make the override unreachable.
and exc_full_message = fn env -> fn world -> fn (recv: Val) -> fn (fargs: Val list) -> fn (hl: bool) -> fn (bottom: bool) ->
  // ⚠ THE CAUSES ARE PART OF THE REPORT. `raise` inside a rescue records the
