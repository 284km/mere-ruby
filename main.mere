and hash_get_w = fn env -> fn world -> fn (hid: int) -> fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Cons (k2, Cons (v, t)) -> (if hkey_eql_w env world hid k2 k then v else hash_get_w env world hid t k)
  | _ -> VNil

and hash_haskey_w = fn env -> fn world -> fn (hid: int) -> fn (xs: Val list) -> fn (k: Val) ->
  match xs with
  | Cons (k2, Cons (_, t)) -> hkey_eql_w env world hid k2 k || hash_haskey_w env world hid t k
  | _ -> false

and hash_put_w = fn env -> fn world -> fn (hid: int) -> fn (xs: Val list) -> fn (k: Val) -> fn (v: Val) ->
  match xs with
  | Cons (k2, Cons (v2, t)) ->
