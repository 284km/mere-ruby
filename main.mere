  // begin, so there an unwalkable begin is what stops it, and ruby's answer
  // for `(1.0..).min(2)` is the TypeError.
  else if str_eq name0 "max"
          && (match args0 with Cons (_, Nil) -> true | _ -> false)
          && (match recv0 with
