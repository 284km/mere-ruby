    "      @string.length + amount\n" ++
    "    elsif whence == 1\n" ++
    "      @pos + amount\n" ++
    "    else\n" ++
    "      amount\n" ++
    "    end\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def tell\n" ++
    "    @pos\n" ++
    "  end\n" ++
    "\n" ++
    "  def read(len = nil)\n" ++
