    // to run and nothing to catch. ruby reports a LocalJumpError; this reached
    // the unknown-method path instead.
    else if str_eq name "catch" && (if map_has meths "catch" then false else true) then
      raise_exc world "LocalJumpError" "no block given"
    else if str_eq name "throw" && (if map_has meths "throw" then false else true) then
      (match args with
       | Cons (_, Cons (_, Cons (_, _))) ->
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 1..2)")
       | Cons (t, rest) ->
         let v = (match rest with Cons (v2, _) -> v2 | Nil -> VNil) in
         let d = (if map_has catch_depth "n" then (match map_get catch_depth "n" with VInt dn -> dn | _ -> 0) else 0) in
         if catch_tag_active t d then flow_rethrow_tagged "throw" t v
         else raise_exc_iv world "UncaughtThrowError" ("uncaught throw " ++ inspect t)
                (Cons (("__tag", t), Cons (("__value", v), Nil)))
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: throw expects a tag")) in fail "mere-ruby: throw expects a tag"))
    // Kernel#p: inspect-print each arg; returns the value (or array).
    // `cmd` command literal → the ` method. Mere HAS had a subprocess since
    // v0.1.13 (`run`, the mk dogfood's), so returning "" here was a silent wrong
    // answer -- the comment that used to be here said mere could not spawn one.
    // The output is captured through a file because `run` answers with the exit
    // status, not the output; stdout only, as ruby's backticks are.
    // On the Wasm host `run` is 127 ("command not found") by construction, so a
    // browser gets an empty string for a command that genuinely did not run.
    else if str_eq name "`" && (if map_has meths "`" then false else true)
            && (if lv_has env "self" then
                  (match lv_get env "self" with
                   | VObj id -> let (mm, sp, ocls, iv) = world in (if has_meth world (map_get ocls id) "`" then false else true)
                   | _ -> true)
                else true) then
      (match args with
       | Cons (VStr cs, _) -> run_backtick (sget cs)
       | _ -> mkstr "")
    // Kernel#system: the same command, reporting only whether it succeeded.
    // Ruby answers nil when the command could not be executed at all and false
    // when it ran and failed; `run` reports one status for both, so this says
    // false for both and KNOWN_GAPS records that it does not tell them apart.
    else if str_eq name "system" && (if kernel_overridden env world "system" then false else true)
            && (match args with Cons (VStr _, _) -> true | _ -> false) then
      (match args with
       | Cons (VStr cs, _) -> VBool (run (sget cs) == 0)
       | _ -> VBool false)
    else if str_eq name "p" || str_eq name "pp" then
      let _ = p_print_w env world args in
      (match args with Nil -> VNil | Cons (v, Nil) -> v | _ -> arr_new args)
    // Kernel#print: write each arg's to_s (no separators, no newline).
    else if str_eq name "print" && (if kernel_overridden env world "print" then false else true) then
      let _ = print_each world args in VNil
    // Kernel#warn: writes to stderr, which stdout byte-comparison never sees,
    // so a no-op is output-equivalent (and avoids a NoMethodError crash).
    // ...but the ARGUMENTS are still checked: `uplevel:` is a number of frames
    // and ruby refuses anything else. A no-op that accepts everything is a
    // no-op that hides a caller's mistake, and `category:` has a fixed set of
    // names too.
    else if str_eq name "warn" && (if kernel_overridden env world "warn" then false else true) then
      (let _ = (match args with
                | Cons (_, _) ->
                  (let (pos9, kw9) = peel_kw_hash args in
                   let _ = (if hash_haskey kw9 (VSym "uplevel") then
                              (match hash_get kw9 (VSym "uplevel") with
                               | VNil -> ()
                               | VInt _ -> ()
                               | VBig _ -> ()
                               | bad9 ->
                                 (let _ = raise_exc world "TypeError"
                                            ("no implicit conversion of "
                                             ++ display_cls_msg world (dispatch_cls_of world bad9)
                                             ++ " into Integer") in ()))
                            else ()) in
                   // `category:` is nil or a name: a Symbol, a String, or an
                   // object with #to_sym. Anything else is refused BY NAME --
                   // it used to be accepted and dropped.
                   let _ = (if hash_haskey kw9 (VSym "category") then
                              (match hash_get kw9 (VSym "category") with
                               | VNil -> ()
                               | VSym _ -> ()
                               | VStr _ -> ()
                               | bad9 ->
                                 (if responds world bad9 "to_sym" then ()
                                  else
                                    (let _ = raise_exc world "TypeError"
                                               ("no implicit conversion of "
                                                ++ display_cls_msg world (dispatch_cls_of world bad9)
                                                ++ " into Symbol") in ())))
                            else ()) in
                   // ⚠ ...AND THEN IT WRITES. This arm validated the keywords
                   //   and returned nil: `warn "x"` produced no output at all,
                   //   anywhere. mspec's `complain` matcher is built on it and
                   //   so are seven recorded rows.
                   //   Asked of ruby rather than assumed:
                   //     warn "a"                       -> "a\n"
                   //     warn "a", "b"                  -> "a\nb\n" (ONE write)
                   //     warn "a\n"                     -> "a\n" (not two)
                   //     warn 42                        -> "42\n"
                   //     warn ["x", "y"]                -> "x\ny\n"
                   //     warn "u", uplevel: 0           -> "FILE:LINE: warning: u\n"
                   //     warn "c", category: :deprecated-> nothing, unless
                   //                                       Warning[:deprecated]
                   //     warn "e", category: :experimental -> "e\n" (on by default)
                   //     warn "b", category: :nope      -> ArgumentError
                   //     warn                           -> nothing
                   let cat9 = (if hash_haskey kw9 (VSym "category")
                               then hash_get kw9 (VSym "category") else VNil) in
                   let on9 = (match cat9 with
                              | VNil -> true
                              | VSym cn ->
                                (if str_eq cn "deprecated" then
                                   (if map_has warn_cats cn then truthy (map_get warn_cats cn) else false)
                                 else if str_eq cn "experimental" || str_eq cn "performance" then
                                   (if map_has warn_cats cn then truthy (map_get warn_cats cn) else true)
                                 else (let _ = raise_exc world "ArgumentError" ("unknown category: " ++ cn) in false))
                              | _ -> true) in
                   let pre9 = (match (if hash_haskey kw9 (VSym "uplevel")
                                      then hash_get kw9 (VSym "uplevel") else VNil) with
                               | VInt _ -> cur_file () ++ ":" ++ str_of_int (cur_line ()) ++ ": warning: "
                               | VBig _ -> cur_file () ++ ":" ++ str_of_int (cur_line ()) ++ ": warning: "
                               | _ -> "") in
                   // ⚠ $VERBOSE = nil silences warn entirely -- and FALSE, the
                   //   default, does not. Measured, because the intuition here
                   //   is the wrong way round:
                   //     $VERBOSE = nil   -> nothing
                   //     $VERBOSE = false -> "x\n"
                   //     $VERBOSE = true  -> "x\n"
                   let vnil9 = (if map_has globals (gvar_slot "VERBOSE")
                                then (match map_get globals (gvar_slot "VERBOSE") with VNil -> true | _ -> false)
                                else false) in
                   // ...and `warn("")` writes a newline while `warn` with NO
                   // arguments writes nothing: the empty case is the ARGUMENT
                   // LIST, never the joined text.
                   let body9 = warn_join world pos9 "" in
                   (if on9 && (if vnil9 then false else true)
                       && (match pos9 with Nil -> false | _ -> true)
                    then err_emit world (pre9 ++ body9) else ()))
                | Nil -> ()) in
       VNil)
    // Kernel#printf: format, then write it (no newline).
    else if str_eq name "printf" && (if kernel_overridden env world "printf" then false else true) then
      (let _ = (match args with
                | Cons (VStr h, rest) -> out_emit world (rb_format env world (sget h) rest)
                | _ -> ()) in VNil)
    // Kernel#format / #sprintf: sprintf-style formatting.
    else if (str_eq name "format" || str_eq name "sprintf") && (if kernel_overridden env world name then false else true) then
      (match args with
       | Cons (VStr h, rest) ->
         let out = rb_format env world (sget h) rest in
         let renc = rb_fmt_enc (senc_get h) (sget h) rest in
         let r = mkstr out in
         (match r with VStr rid -> (let _ = senc_set rid renc in r) | _ -> r)
       | _ -> mkstr "")
    // Kernel#fail is Kernel#raise. `raise` is a parser keyword here (ERaise), so
    // `fail` could not borrow that path and had no branch of its own: `fail "x"`
    // reported an undefined method while `Kernel.fail "x"` worked. This is the
    // same signal ERaise ends up sending -- $exc, the raise site, the backtrace,
    // then the interpreter's own failure carrying the placeholder message.
    else if str_eq name "fail" && (if kernel_overridden env world "fail" then false else true) then
      (let (_, _, _, iv0) = world in
       let exc = (match args with
                  | Nil -> (if map_has globals "!" && (match map_get globals "!" with VNil -> false | _ -> true)
                            then map_get globals "!" else make_exc_w world Nil)
                  | _ -> make_exc_w world args) in
       let _ = map_set iv0 "$exc" exc in
       let _ = note_raise_site () in
       let _ = map_set raise_bt "v" (arr_new (caller_frames 0)) in
       (let m = "mere-ruby: (ruby exception raised)" in
        let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m))
    // implicit-self send/__send__/public_send: dispatch the named method on self.
    // A class that defines its own #send (Ractor) keeps it here too -- the
    // `meths` probe only sees a toplevel definition, so `send(v)` inside
    // `Ractor#<<` was reaching the universal one and dispatching the message.
    else if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send")
            && (if map_has meths name then false else true)
            && (if user_defines_send world (if lv_has env "self" then lv_get env "self" else VMain) name then false else true) then
      (let recv = if lv_has env "self" then lv_get env "self" else VMain in
       let vis = str_eq name "public_send" in
       let m = send_name_arg env world args in
       let rest = (match args with Cons (_, r) -> r | Nil -> Nil) in
       let _ = (if vis then public_send_guard world recv m else ()) in
       if str_eq m "eval" then do_eval env world blk rest
       else invoke_val_c env world blk recv m rest vis)
    // enum_for(:m) / to_enum(:m): an Enumerator that drives self.m on #each.
    else if (str_eq name "enum_for" || str_eq name "to_enum") && (if map_has meths name then false else true) then
      // `to_enum(:m, a, b)` records a and b: they are the arguments the
      // method is called with when the enumerator is driven.
      (let recv = if lv_has env "self" then lv_get env "self" else VMain in
       match args with
       | Cons (VSym m, rest) -> make_enum_a world recv m rest
       | Cons (VStr m, rest) -> make_enum_a world recv (sget m) rest
       | _ -> make_enum world recv "each")
    // Kernel#gets / readline / readlines: read stdin (slurped once). gets and
    // readlines cover the common `while line = gets` / batch cases; readline
    // raises EOFError at end like Ruby. Args (separator/limit) are not modeled.
    else if str_eq name "gets" && (if kernel_overridden env world "gets" then false else true) then rb_gets ()
    else if str_eq name "readline" && (if kernel_overridden env world "readline" then false else true) then
      (match rb_gets () with VNil -> raise_exc world "EOFError" "end of file reached" | v -> v)
    else if str_eq name "readlines" && (if kernel_overridden env world "readlines" then false else true) then arr_new (rb_readlines ())
    else try_self_call_x env world VNil name args true
  | ECallB (name, arges, bp, bb) ->
    let (meths, sup, ocls, ivars) = world in
    let args = eval_args env world blk arges in
    let newblk = (match bp with
                  | Cons (c, Nil) ->
                    (if str_eq c "&coerce"
                     then coerce_to_block env world blk (match bb with Cons (SExpr be, _) -> eval_e env world blk be | _ -> VNil)
                     else (let _ = (if map_has pending_srcproc "v" then map_delete pending_srcproc "v" else ()) in
                           blk_capture blk (true, bp, bb, env) bb))
                  | _ -> (let _ = (if map_has pending_srcproc "v" then map_delete pending_srcproc "v" else ()) in
                          blk_capture blk (true, bp, bb, env) bb)) in
    // Kernel#loop: run the block until break (or a StopIteration raise).
    if str_eq name "loop" && (if map_has meths "loop" then false else true) then
      run_loop_builtin env world blk (true, bp, bb, env)
    // `trace_var(:$g) { |v| ... }` in its block form: the block is the tracer.
    else if str_eq name "trace_var" && (if map_has meths "trace_var" then false else true) then
      (let pid = map_len proc_store in
       let _ = store_proc (str_of_int pid) (true, bp, bb, env) in
       match args with
       | Cons (gv, _) ->
         (let gn = gvar_trace_name (to_s gv) in
          let _ = map_set gvar_traces gn (VProc pid) in
          let _ = map_set hook_flags "gvt" VNil in VNil)
       | _ -> VNil)
    // catch(:tag) { ... throw :tag, v ... } via the flow-signal unwind.
    else if str_eq name "catch" && (if map_has meths "catch" then false else true) then
      (match args with
       | Cons (_, Cons (_, _)) ->
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..1)")
       | _ ->
       // with no tag ruby MAKES one (a fresh Object) and, either way, PASSES
       // it to the block -- `catch(:k) { |y| y }` is :k, and it was nil.
       let tag = (match args with Cons (t, _) -> t | _ -> new_obj world "Object" Nil) in
       let d0 = (if map_has catch_depth "n" then (match map_get catch_depth "n" with VInt dn -> dn | _ -> 0) else 0) in
       let _ = map_set catch_depth "n" (VInt (d0 + 1)) in
       let _ = map_set catch_depth ("t" ++ str_of_int (d0 + 1)) tag in
       let f = try_or (fn (u: unit) -> run_block world blk (true, bp, bb, env) (Cons (tag, Nil))) (FRaise VNil) in
       let _ = map_set catch_depth "n" (VInt d0) in
       (match f with
        | FRaise _ ->
          if map_has flow_sig "k" then
            let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
            let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
            let tg = (if map_has flow_sig "tag" then map_get flow_sig "tag" else VNil) in
            let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

            if str_eq k "throw" && rb_identical tg tag then v
            else flow_rethrow_tagged k tg v
          else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")
        | other -> flow_value other))
    // Kernel#at_exit { }: remember the block and answer it as a Proc.
    else if str_eq name "at_exit" && (if map_has meths "at_exit" then false else true) then
      (let pid = map_len proc_store in
       let _ = store_proc (str_of_int pid) (true, bp, bb, env) in
       let _ = map_set at_exits (str_of_int (map_len at_exits)) (VProc pid) in
       VProc pid)
    // Kernel#fork { }: not implemented (no process extern) — Ruby's own
    // NotImplementedError contract for fork-less platforms.
    else if str_eq name "fork" && (if map_has meths "fork" then false else true) then
      raise_exc world "NotImplementedError" "fork() function is unimplemented on this machine"
    // proc { } / lambda { } capture the block as a first-class VProc.
    else if str_eq name "proc" || str_eq name "lambda" then
      // `proc(&pr)` answers pr ITSELF, not a copy of its body: the two are
      // `equal?` in ruby, and a lambda stays a lambda. pending_srcproc is the
      // proc the block was made from -- Hash.new(&pr) already reads it for the
      // same reason.
      (if map_has pending_srcproc "v" then
         (let pid0 = map_get pending_srcproc "v" in
          let _ = map_delete pending_srcproc "v" in
          VProc pid0)
       else
       let id = map_len proc_store in
       let _ = store_proc (str_of_int id) (true, bp, bb, env) in
       let _ = if (let (h, _, _, _) = blk in h) then store_yblk (str_of_int id) blk else () in
       let _ = if str_eq name "lambda" then map_set lambda_ids (str_of_int id) VNil else () in
       VProc id)
    // define_method(:name) { ... } as a genuine method call (self is a class):
    // register the passed block as an instance method. Works when reached
    // from inside another method (e.g. a Module helper forwarding &block),
    // not just as a literal class-body statement.
    // `define_method(:m) do ... end` with no receiver: on a class it defines
    // there, and at the TOP LEVEL it defines on Object -- which is where ruby
    // puts a method defined at the top level, and what makes the defined
    // method callable from the next line.
    // define_singleton_method(:name, method_or_proc) with an implicit class
    // self (inside a class body): the explicit-receiver arm does the work.
    else if str_eq name "define_singleton_method"
            && (match args with Cons (_, Cons (_, _)) -> true | _ -> false)
            && (match (if lv_has env "self" then lv_get env "self" else VMain) with VClass _ -> true | _ -> false) then
      invoke_val_c env world blk (if lv_has env "self" then lv_get env "self" else VMain) name args false
    else if str_eq name "define_method"
            && (match (if lv_has env "self" then lv_get env "self" else VMain) with
                | VClass _ -> true | VMain -> true | _ -> false) then
      (match (match (if lv_has env "self" then lv_get env "self" else VMain) with
              | VClass c0 -> VClass c0 | _ -> VClass "") with
       | VClass c ->
         let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr s, _) -> sget s | _ -> "") in
         // a top-level define_method goes where a top-level `def` goes: under
         // the bare name, which is what makes `method(:it)` find it.
         let key = (if str_eq c "" then nm else c ++ "#" ++ nm) in
         let (_, ps2, bb2, _) = newblk in
         let _ = set_meth meths key (Meth (drop_yblk_params ps2, block_defaults bb2, drop_defaults_prologue bb2)) in
         let _ = map_set dm_methods key VNil in
         let _ = dm_store_closure key newblk in
         let _ = stamp_meth_src key in
         // capture the block active here so a `yield` in the defined method
         // reaches it (Ruby's define_method closure semantics).
         let _ = (match blk with
                  | (true, _, _, _) -> let pid = map_len proc_store in
                    let _ = store_proc (str_of_int pid) blk in
                    map_set dm_captured key (VProc pid)
                  | _ -> if map_has dm_captured key then map_delete dm_captured key else ()) in
          // `block_given?` inside the body asks about THIS frame -- the one the
          // block was written in -- so the answer is fixed here, at definition,
          // and does not depend on how the method is later called.
          // ...from the enclosing METHOD frame, not from the block value here:
          // `def bar; C.module_eval { define_method(:m) { block_given? } }; end`
          // called as `bar { }` answers true, and `blk` at this point is the
          // module_eval block's, which has none.
          let _ = map_set dm_had_blk key
                    (if lv_has env "__has_blk" then lv_get env "__has_blk"
                     else VBool (match blk with (true, _, _, _) -> true | _ -> false)) in
          VSym nm
       | _ -> VNil)
    // refine Target do <defs> end — inside a Module.new body (self is the
    // refinery module). Run the block's defs into a fresh impl_cls class and record
    // the (refinery, target, impl_cls) triple for a later `using`.
    else if str_eq name "refine" && (match args with Cons (VClass _, _) -> true | _ -> false) && (match lv_get env "self" with VClass _ -> true | _ -> false) then
      (let refinery = (match lv_get env "self" with VClass rc -> rc | _ -> "") in
       let target = (match args with Cons (VClass t, _) -> t | _ -> "") in
       do_refine world refinery target bb)
    else if map_has meths name then call_method env world newblk name args
    // bare method(:name) — Kernel#method on the implicit self.
    else if str_eq name "method" && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
      invoke_val_c env world newblk (if lv_has env "self" then lv_get env "self" else VMain) "method" args false
    // implicit self: a bare `each { }` inside a method is `self.each { }`.
    else if lv_has env "self" then
      (match lv_get env "self" with
       | VObj id ->
         let cls = map_get ocls id in
         if has_meth world cls name then invoke world newblk (VObj id) cls name args
         // not an own method — route through the receiver dispatcher so
         // Enumerable-mixin methods (map/inject/sort_by with a block, driven
         // by the object's #each), method_missing, and builtin fallbacks all
         // apply, exactly as `self.name { }` would.
         else invoke_with_block env world blk (VObj id) name args newblk
       // inside a class method, a bare call with a block is self.name { }.
       | VClass c ->
         // a bare block call inside a class method is `self.name { }`; route
         // through the receiver dispatcher so builtins (module_eval/class_eval/
         // new/...) and Module/Class fallbacks all apply, not just own methods.
         invoke_with_block env world blk (VClass c) name args newblk
       // at the top level self is main, an ordinary Object: a bare block call
       // that is not a top-level method (checked above) is `self.name { }`,
       // which is how `instance_eval do .. end` gets a receiver here.
       | VMain -> invoke_with_block env world blk VMain name args newblk
       // implicit self-send on a primitive: honour a subclass tag (own method
       // or alias-to-builtin) before falling back to the base primitive class.
       | other ->
         let hk = hng_key other in
         let tagged = if str_eq hk "" then false else map_has hng_store hk in
         let tagcls = if tagged then map_get hng_store hk else "" in
         if tagged && has_meth world tagcls name then invoke world newblk other tagcls name args
         else if tagged && (if str_eq (blt_alias_lookup world (ancestors_of world tagcls) name) "" then false else true) then
           (let src = blt_alias_lookup world (ancestors_of world tagcls) name in
            match args with
            | Cons (arg, _) -> if is_binary_op_name src then arith_bin src other arg else prim_method other src args
            | Nil -> prim_method other src args)
         else
           let pcls = class_name other in
           if has_meth world pcls name then invoke world newblk other pcls name args
           // ...and a BUILTIN with a block is still reachable from a bare call:
           // `frozen_hash.instance_eval { initialize { 5 } }` has to reach
           // Hash#initialize (it answered "undefined method 'initialize'").
           else invoke_with_block env world blk other name args newblk)
    else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "'")
  // recv.name op= rhs — evaluate recv once (bound to a temp), then read/op/
  // write the attribute through the normal method dispatch.
  | EAttrOp (recv_e, name, op, rhs_e) ->
    let r = eval_e env world blk recv_e in
    let e2 = lv_flat env in
    let _ = map_set e2 "__opr" r in
    // self-receiver keeps ESelf so private accessors stay reachable (self is
    // side-effect-free, so evaluating it twice is harmless).
    let rx = (match recv_e with ESelf -> ESelf | _ -> EVar "__opr") in
    let cur = eval_e e2 world blk (EMethod (rx, name, Nil)) in
    if str_eq op "||" then
      (if truthy cur then cur
       else let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, name ++ "=", Cons (EVar "__opv", Nil))))
    else if str_eq op "&&" then
      (if truthy cur then (let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, name ++ "=", Cons (EVar "__opv", Nil)))) else cur)
    else
      let v = eval_e env world blk rhs_e in
      let _ = map_set e2 "__opv" (apply_bin_vals world blk op cur v) in
      eval_e e2 world blk (EMethod (rx, name ++ "=", Cons (EVar "__opv", Nil)))
  // recv[idx..] op= rhs — evaluate recv and the indices once (bound to temps).
  | EIdxOp (recv_e, idx_es, op, rhs_e) ->
    let r = eval_e env world blk recv_e in
    let idxs = eval_args env world blk idx_es in
    let e2 = lv_flat env in
    let _ = map_set e2 "__opr" r in
    let rx = (match recv_e with ESelf -> ESelf | _ -> EVar "__opr") in
    let ies = idx_temp_exprs e2 idxs 0 in
    let cur = eval_e e2 world blk (EMethod (rx, "[]", ies)) in
    if str_eq op "||" then
      (if truthy cur then cur
       else let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, "[]=", eapp ies (Cons (EVar "__opv", Nil)))))
    else if str_eq op "&&" then
      (if truthy cur then (let v = eval_e env world blk rhs_e in let _ = map_set e2 "__opv" v in eval_e e2 world blk (EMethod (rx, "[]=", eapp ies (Cons (EVar "__opv", Nil))))) else cur)
    else
      let v = eval_e env world blk rhs_e in
      let _ = map_set e2 "__opv" (apply_bin_vals world blk op cur v) in
      eval_e e2 world blk (EMethod (rx, "[]=", eapp ies (Cons (EVar "__opv", Nil))))
  | EMethod (recv_e, name, arges) ->
    // `"literal".freeze` is ruby's interning special form: every evaluation
    // of the same literal-freeze answers ONE object (CRuby compiles it to
    // opt_str_freeze). Only the syntactic literal form -- a dynamic string's
    // freeze still returns self. A double-quoted literal parses as the
    // interpolation desugaring ("" + "lit"), so the test walks + chains of
    // string literals.
    if str_eq name "freeze" && (match arges with Nil -> true | _ -> false)
       && (let rec statstr = fn (e9: Expr) ->
             (match e9 with
              | EStrL _ -> true
              | EBin (op9, a9, b9) -> str_eq op9 "+" && statstr a9 && statstr b9
              | _ -> false) in
           statstr recv_e) then
      str_fstring (eval_e env world blk recv_e)
    // a parse-time literal-encoding marker (see the TStrL parse): tag the
    // fresh literal with the file's magic-comment encoding.
    else if str_len name > 10 && str_eq (substring name 0 10) "__lit_enc~" then
      (let v = eval_e env world blk recv_e in
       let cd = enc_canon_name (substring name 10 (str_len name)) in
       (match v with
        | VStr h -> (let _ = senc_set h (if str_eq (enc_find_canon cd) "" then cd else enc_find_canon cd) in v)
        | _ -> v))
    else
    // `Kernel.puts` / `::Kernel.format`: the Kernel module functions are
    // reachable as private instance methods (`puts`) but had no module-method
    // form, which is what code that inherits from BasicObject reaches for.
    // The receiver is matched syntactically -- a `Kernel` constant, qualified
    // or not -- so the implicit-self implementation can be reused whole.
    if (match recv_e with
        | EConst c -> (str_eq c "Kernel" || str_eq c "::Kernel")
        | _ -> false)
       && is_kernel_modfunc name
       && (let (mk, _, _, _) = world in if map_has mk ("(sng:Kernel)#" ++ name) then false else true) then
      // `puts` is a STATEMENT in this parser, so ECall would not find it; the
      // rest of the module functions are ordinary implicit-self calls.
      (if str_eq name "puts" then
         (let vs = eval_args env world blk arges in
          let _ = (match vs with Nil -> puts_one world (mkstr "") | _ -> puts_each world vs) in VNil)
       else eval_e env world blk (ECall (name, arges)))
    else
    // a trailing &proc / &var argument becomes the call's block.
    (match rev_app arges Nil with
     | Cons (EBlockPass be, rrest) ->
       let recv = eval_e env world blk recv_e in
       let args = eval_args env world blk (rev_app rrest Nil) in
       (match eval_e env world blk be with
        | VProc pid -> invoke_with_block env world blk recv name args (proc_as_block pid)
        | VSym snm ->
          let cenv2 = map_new () in
          invoke_with_block env world blk recv name args
            (true, Cons ("__bp", Nil), Cons (SExpr (EMethod (EVar "__bp", snm, Nil)), Nil), cenv2)
        | _ -> invoke_val_c env world blk recv name args true)
     | _ ->
       let recv = eval_e env world blk recv_e in
       let args = eval_args env world blk arges in
       // a mutating call on a frozen String/Array/Hash raises FrozenError
       // before the in-place fast paths below (which bypass invoke_val_c) --
       // except for a yielder called with NO block, which mutates nothing and
       // hands back an Enumerator (the error waits for its #each).
       let _ = (if builtin_mut_on_frozen world recv name
                   && (if enum_needs_block name then false else true)
                   && (if delete_is_noop env world recv name args then false else true)
                then let _ = raise_exc_iv world "FrozenError" ("can't modify frozen " ++ class_name recv ++ ": " ++ inspect recv) (Cons (("__recv", recv), Nil)) in ()
                else ()) in
       // a `self.`-receiver call may reach private methods (always for a
       // setter, and generally in modern Ruby).
       let vis = (match recv_e with ESelf -> false | _ -> true) in
       // send / __send__ dispatch a runtime method name; respond_to? probes.
       if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send")
          && (if user_defines_send world recv name then false else true) then
         // public_send respects visibility; send/__send__ bypass it.
         let vis = str_eq name "public_send" in
         let m = send_name_arg env world args in
         let rest = (match args with Cons (_, r) -> r | Nil -> Nil) in
         let _ = (if vis then public_send_guard world recv m else ()) in
         (if str_eq m "eval" then do_eval env world blk rest
          else invoke_val_c env world blk recv m rest vis)
       // ⚠ a class that DEFINES #respond_to? answers with it, and with whatever
       // it returns: this arm used to answer for every receiver, so an override
       // was reached only through the internal probe (which reads it for
       // truthiness) and `def respond_to?(s, a=false); :MINE; end` answered
       // `true`. Falling through dispatches it like any other method.
       else if str_eq name "respond_to?"
               && (if has_meth world (dispatch_cls_of world recv) "respond_to?" then false else true) then
         respond_to_answer env world recv args
       // in-place string mutation: rewrite the receiver's store entry, so
       // every alias sees it (unless the class redefines the method).
       else if (match recv with VStr _ -> true | _ -> false)
               && (is_str_mut name || str_eq name "[]=")
               && (if has_meth world "String" name then false else true) then
         (match recv with
          | VStr h ->
            // []= duck-types its index: something with #begin AND #end is a
            // Range (ruby asks before #to_int, which is how a permissive mock
            // becomes a nil..nil range replacing the whole string); otherwise
            // to_str then to_int, as everywhere else.
            let args = (if str_eq name "[]=" then
                          (match args with
                           // the range protocol applies only to the 2-arg form
                           // (index, value); (index, count, value) converts
                           // both counts with #to_int.
                           | Cons (VObj _, Cons (_, Nil)) ->
                             (match args with
                              | Cons (a0, _) ->
                                (if responds world a0 "begin" && responds world a0 "end" then
                                   (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
                                    let bv = invoke_val_c env world nb a0 "begin" Nil false in
                                    let ev = invoke_val_c env world nb a0 "end" Nil false in
                                    let ex = (if responds world a0 "exclude_end?" then truthy (invoke_val_c env world nb a0 "exclude_end?" Nil false) else false) in
                                    Cons (VRange (bv, ev, ex), coerce_str_int_args env world (match args with Cons (_, r9) -> r9 | _ -> Nil)))
                                 else coerce_str_int_args env world args)
                              | _ -> args)
                           | _ ->
                             (let cv = coerce_str_int_args env world args in
                              // a capture index whose #to_int answered a
                              // non-Integer is ruby's own conversion error.
                              match cv with
                              | Cons (VRegex (_, _, _), Cons (VObj o2, Cons (_, Nil))) ->
                                (if responds world (VObj o2) "to_int" then
                                   (let nb2 = (false, (Nil : str list), (Nil : Stmt list), env) in
                                    match invoke_val_c env world nb2 (VObj o2) "to_int" Nil false with
                                    | VInt _ -> cv
                                    | ov -> (match raise_exc world "TypeError"
                                                     ("can't convert " ++ class_name (VObj o2) ++ " to Integer ("
                                                      ++ class_name (VObj o2) ++ "#to_int gives " ++ class_name ov ++ ")") with
                                             | _ -> cv))
                                 else cv)
                              | _ -> cv))
                        // slice! shares slice's index conversions (range
                        // protocol, per-bound #to_int, Float truncation).
                        else if str_eq name "slice!" then coerce_slice_args env world args
                        // append_as_bytes refuses #to_str -- the same exception
                        // the explicit-receiver path makes, and the same reason
                        // (see there). Two callers of is_str_mut, two places.
                        else if str_eq name "append_as_bytes" then args
                        else coerce_dyck_args env world recv args) in
            (if str_eq name "slice!" && (match args with Cons (VRegex (_, _, _), _) -> true | _ -> false)
             then str_slice_bang_rx env world h args
             else str_mut_do h name args)
          | _ -> VNil)
       // in-place hash mutation: rewrite the receiver's store entry.
       else if (match recv with VHsh _ -> true | _ -> false)
               && (str_eq name "[]=" || str_eq name "store")
               && (if has_meth world "Hash" name then false else true) then
         (match recv with
          | VHsh h -> (match args with
                       | Cons (k, Cons (v, _)) ->
                         (let k9 = hash_store_key env world h k in
                          let _ = hset h (hash_put_wx env world h (hcbi_on h) (hderef h) k9 v) in v)
                       | _ -> VNil)
          | _ -> VNil)
       // an attribute-writer call (`recv.foo = v`, `recv[i] = v`) has the
       // assigned value as its expression result, not the writer's return.
       // A call with no block literal and no `&` passes NO block. `blk` here
       // is the FRAME's block -- the one this method or block body was itself
       // given, which is what `yield` reads -- and handing it on made every
       // builtin that asks "was a block given?" see one that was never passed.
       // The frame block is present exactly when a proc is invoked through an
       // `&b` parameter (`def w(&b); b.call; end`): inside `w { (0...2**64)
       // .min(2) }` the arithmetic arm stood aside for a "given" block and the
       // iterating path answered [], while the same expression at the prompt
       // answered [0, 1]. Every ruby/spec example runs in that shape.
       else if is_setter_name name then
         let _ = invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) recv name args vis in
         (match rev_app args Nil with Cons (v, _) -> v | Nil -> VNil)
       else invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) recv name args vis)
  | EMethodB (recv_e, name, arges, bp, bb) ->
    let recv = eval_e env world blk recv_e in
    let args = eval_args env world blk arges in
    let newblk = (match bp with
                  | Cons (c, Nil) -> if str_eq c "&coerce" then coerce_to_block env world blk (match bb with Cons (SExpr be, _) -> eval_e env world blk be | _ -> VNil) else blk_capture blk (true, bp, bb, env) bb
                  | _ -> blk_capture blk (true, bp, bb, env) bb) in
    invoke_with_block env world blk recv name args newblk
  | EArr items -> arr_new (eval_args env world blk items)
  // fold the evaluated pairs through hash_put so duplicate keys (from an
  // explicit repeat or a **splat then override) collapse last-value-wins,
  // keeping the key's first position — Ruby hash-literal semantics.
  | EHsh items -> hstored_seed env world (mkhash (hash_merge Nil (hsh_eval_items env world blk items)))
  // a keyword-argument hash: same value as EHsh, but its handle is marked so
  // method binding knows it came from `key: value` syntax (not a positional {}).
  | EKwHash items ->
    (match hstored_seed env world (mkhash (hash_merge Nil (hsh_eval_items env world blk items))) with
     | VHsh id -> let _ = mark_kw id in VHsh id
     | v -> v)
  | EUn (op, a) ->
    if str_eq op "!" then
      (let v = eval_e env world blk a in
       match v with
       | VObj id ->
         let (m2, s2, ocls2, iv2) = world in
         let cls = map_get ocls2 id in
         if has_meth world cls "!@" then invoke_val_c env world blk v "!@" Nil false
         else if truthy v then VBool false else VBool true
       // `!` is a method, and a builtin class may have redefined it
       // (`class TrueClass; def !; :ok; end`), so ask the table first.
       | _ ->
         (let dc = dispatch_cls_of world v in
          if has_meth world dc "!@" then invoke_val_c env world blk v "!@" Nil false
          else if has_meth world dc "!" then invoke_val_c env world blk v "!" Nil false
          else if truthy v then VBool false else VBool true))
    else if str_eq op "~" then
      (match eval_e env world blk a with
       | VInt n -> VInt (0 - n - 1)   // bitwise not
       // ~x is -x-1 at every width, so the bignum case is the same identity
       // rather than a bit operation. It used to fall through to "non-integer".
       | VBig b -> norm_big (big_sub_s (big_neg_s b) "1")
       // `~obj` dispatches to the object's own `~` (IPAddr defines one).
       | VObj id ->
         let (m2, s2, ocls2, iv2) = world in
         let cls = map_get ocls2 id in
         if has_meth world cls "~" then invoke_val_c env world blk (VObj id) "~" Nil false
         else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: unary ~ on non-integer")) in fail "mere-ruby: unary ~ on non-integer")
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: unary ~ on non-integer")) in fail "mere-ruby: unary ~ on non-integer"))
    else
      (match eval_e env world blk a with
       // -(machine minimum) does not fit a machine int: it promotes.
       | VInt n -> if str_eq op "-" then num_neg (VInt n) else VInt n
       | VBig s -> if str_eq op "-" then norm_big (big_neg_s s) else VBig s
       | VFlt f -> if str_eq op "-" then VFlt (f * (0.0 - 1.0)) else VFlt f
       | VRat (n, d) -> if str_eq op "-" then VRat (big_neg_s n, d) else VRat (n, d)
       | VCpx (r, i) -> if str_eq op "-" then VCpx (num_neg r, num_neg i) else VCpx (r, i)
       // unary -/+ on an object dispatch to its -@ / +@ method.
       | other -> invoke_val_c env world blk other (op ++ "@") Nil false)
  | EBin (op, a, b) ->
    if str_eq op "&&" then
      let va = eval_e env world blk a in
      if truthy va then eval_e env world blk b else va
    else if str_eq op "||" then
      let va = eval_e env world blk a in
      if truthy va then va else eval_e env world blk b
    // `/literal regex/ =~ str` with named captures binds a local variable per
    // named group (only for a literal regex on the LHS, per Ruby).
    // ...unless the program redefined Regexp#=~, in which case even a literal
    // regex has to go through the method table like any other receiver.
    else if str_eq op "=~" && (match a with ERegex _ -> true | _ -> false)
            && (if has_meth world "Regexp" "=~" then false else true) then
      (match a with
       | ERegex (pat, pfl) ->
         let vb = eval_e env world blk b in
         (match vb with
          | VStr sv -> let se9 = senc_get sv in let sv = sget sv in
            let r = rx_do_match world pat pfl sv se9 in
            let _ = set_named_caps env pat 0 0 in r
          // a Symbol matches like its name
          | VSym sv ->
            let r = rx_do_match world pat pfl sv (sym_enc_name sv) in
            let _ = set_named_caps env pat 0 0 in r
          | _ -> VNil)
       | _ -> VNil)
    else
    // an object whose class defines the operator dispatches to it.
    let va0 = eval_e env world blk a in
    // `<<` mutates a String/Array receiver in place — FrozenError first.
    let _ = (if str_eq op "<<" && builtin_mut_on_frozen world va0 "<<"
             then let _ = raise_exc_iv world "FrozenError" ("can't modify frozen " ++ class_name va0 ++ ": " ++ inspect va0) (Cons (("__recv", va0), Nil)) in ()
             else ()) in
    // `s << x` on a string appends in place (store rewrite: aliases see it).
    // An integer appends the codepoint's character, as in Ruby.
    if str_eq op "<<" && (match va0 with VStr _ -> true | _ -> false) then
      (match va0 with
       | VStr h ->
         (match eval_e env world blk b with
          | VStr y -> let _ = sset h (sget h ++ sget y) in va0
          | VInt n -> let _ = sset h (sget h ++ chr n) in va0
          | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: << string needs a string")) in fail "mere-ruby: << string needs a string"))
       | _ -> VNil)
    else
    // BasicObject#!= is `==` negated, so a class that redefines only `==`
    // still answers `!=` through it. A class with its own `!=` keeps it, and
    // an untouched builtin has neither in the table and pays one lookup.
    // `3.0 == obj` where obj carries its own == is ruby's num_equal: the
    // comparison is REVERSED (`obj == 3.0`) rather than answered false,
    // because a numeric cannot know about the object and the object can.
    // `[2, 3.0, 3, x].find_index(x)` is 1 in ruby for exactly this reason.
    // Two HASHES (or two Arrays) that the structural comparison calls unequal,
    // holding objects: their members' own #== decides, and the value-level
    // comparison cannot ask it. Routed to the dispatcher, which has the arm.
    if (str_eq op "==" || str_eq op "!=")
       && (match va0 with VHsh _ -> true | VArr _ -> true | _ -> false)
       && (let bv8 = eval_e env world blk b in
           (match (va0, bv8) with
            | (VHsh h8, VHsh _) -> (if rb_eq va0 bv8 then false else hash_has_obj world (hderef h8))
            | (VArr a8, VArr _) -> (if rb_eq va0 bv8 then false else arr_has_obj world (deref a8))
            | (_, _) -> false)) then
      // ...compared HERE rather than through the dispatcher: a binary operator
      // on a primitive routes back to this path, and the two would call each
      // other forever.
      (let bv8 = eval_e env world blk b in
       let r8 = (match (va0, bv8) with
                 | (VHsh h8, VHsh h9) -> hash_eq_w env world h8 h9
                 | (VArr a8, VArr a9) -> arr_eq_w env world (deref a8) (deref a9)
                 | (_, _) -> false) in
       VBool (if str_eq op "==" then r8 else (if r8 then false else true)))
    // ⚠ `"abc" == obj` asks the OBJECT when it answers #to_str: ruby's
    //   rb_str_equal returns `obj == self` rather than comparing bytes with
    //   something that is not a String, so a String-like object was never
    //   equal to any string.
    else if (str_eq op "==" || str_eq op "!=")
       && (match va0 with VStr _ -> true | _ -> false)
       && (if has_meth world "String" "==" then false else true)
       && (let bv8 = eval_e env world blk b in
           (match bv8 with VObj _ -> responds world bv8 "to_str" | _ -> false)) then
      (let bv8 = eval_e env world blk b in
       let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
       let r8 = truthy (invoke_val_c env world noblk bv8 "==" (Cons (va0, Nil)) false) in
       VBool (if str_eq op "==" then r8 else (if r8 then false else true)))
    else if (str_eq op "==" || str_eq op "!=")
       && (match va0 with VInt _ -> true | VFlt _ -> true | VBig _ -> true
                        | VRat (_, _) -> true | VCpx (_, _) -> true | _ -> false)
       // ...unless the receiver's own class redefined == (corpus/134 pins that
       // `1 == 2` follows a redefined Integer#==), which the arms below reach.
       && (if has_meth world (dispatch_cls_of world va0) "==" then false else true) then
      (let bv9 = eval_e env world blk b in
       match bv9 with
       | VObj _ ->
         (if has_meth world (dispatch_cls_of world bv9) "==" then
            (let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
             let r9 = truthy (invoke world noblk bv9 (dispatch_cls_of world bv9) "==" (Cons (va0, Nil))) in
             VBool (if str_eq op "==" then r9 else (if r9 then false else true)))
          else VBool (if str_eq op "==" then rb_eq va0 bv9 else (if rb_eq va0 bv9 then false else true)))
       // not an object: the ordinary structural answer (arith_bin has no
       // equality -- routing == there was "unknown operator: ==").
       | _ -> VBool (if str_eq op "==" then rb_eq va0 bv9 else (if rb_eq va0 bv9 then false else true)))
    else
    if str_eq op "!=" && (let dc = dispatch_cls_of world va0 in
                          has_meth world dc "==" && (if has_meth world dc "!=" then false else true)) then
      (let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
       let dc = dispatch_cls_of world va0 in
       VBool (if truthy (invoke world noblk va0 dc "==" (Cons (eval_e env world blk b, Nil))) then false else true))
    else
    (match va0 with
     | VObj oid ->
       let (meths, sup, ocls, ivars) = world in
       let ocl = map_get ocls oid in
       let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
       if has_meth world ocl op then
         invoke world noblk va0 ocl op (Cons (eval_e env world blk b, Nil))
       // a builtin-backed class may answer the operator without a method-table
       // entry: Time compares by its instant, and `t1 < t2` has to reach that
       // rather than fall through to "no method". Through a SINGLETON class as
       // well: after `def t.succ` the object's class is "(sng:111)", and asking
       // the builtin table under that name sent `t + 1` to the coercion path
       // ("Integer can't be coerced into Object").
       else if builtin_obj_has (display_cls world ocl) op then
         invoke_val_c env world blk va0 op (Cons (eval_e env world blk b, Nil)) false
       // a yielder in a generator block: y << value.
       else if str_eq ocl "Enumerator::Yielder" && str_eq op "<<" then
         invoke_val_c env world blk va0 "<<" (Cons (eval_e env world blk b, Nil)) false
       // File / IO handles and queues: recv << data.
       else if (str_eq ocl "File" || str_eq ocl "IO" || str_eq ocl "Queue" || str_eq ocl "SizedQueue") && str_eq op "<<" then
         invoke_val_c env world blk va0 "<<" (Cons (eval_e env world blk b, Nil)) false
       // enumerator chaining: e1 + e2.
       else if (is_enum_cls ocl || str_eq ocl "Enumerator::Chain") && str_eq op "+" then
         invoke_val_c env world blk va0 "+" (Cons (eval_e env world blk b, Nil)) false
       // Comparable: derive < > <= >= from a user-defined <=> when the
       // operator itself is not defined.
       // ⚠ ...only for a class that actually INCLUDES Comparable. Defining
       //   `<=>` alone does not give an object the four operators (ruby answers
       //   NoMethodError), and `==` stays identity.
       else if (str_eq op "<" || str_eq op ">" || str_eq op "<=" || str_eq op ">=")
               && has_meth world ocl "<=>" && obj_is_a world ocl "Comparable" then
         (let bv9 = eval_e env world blk b in
          let c = invoke world noblk va0 ocl "<=>" (Cons (bv9, Nil)) in
          // ⚠ ANY number the comparison answers is compared with zero -- ruby
          //   accepts 0.0, 0.1, -0.1 and Rational(1,2) here, and only an
          //   Integer was read, so three of core/comparable's four files
          //   raised "comparison failed" for a comparison that succeeded.
          //   ...and the refusal NAMES the two sides, as ruby's does.
          if is_num c then
            (let n = cmp_vals c (VInt 0) in
             VBool (if str_eq op "<" then n < 0 else if str_eq op ">" then n > 0
                    else if str_eq op "<=" then n <= 0 else n >= 0))
          else raise_exc world "ArgumentError"
                 ("comparison of " ++ display_cls_msg world (dispatch_cls_of world va0) ++ " with "
                  ++ (if is_num bv9 then to_s bv9 else display_cls_msg world (dispatch_cls_of world bv9)) ++ " failed"))
       // Comparable#==: derive from a user <=> (0 = equal, nil/other = not).
       else if str_eq op "==" && has_meth world ocl "<=>" && obj_is_a world ocl "Comparable"
               && (if has_meth world ocl "==" then false else true) then
         (let bv9 = eval_e env world blk b in
          match invoke world noblk va0 ocl "<=>" (Cons (bv9, Nil)) with
          // nil means "not comparable", which for #== is simply false; ANY
          // OTHER non-number is a broken comparison and ruby says so rather
          // than answering false.
          | VNil -> VBool false
          | c ->
            (if is_num c then VBool (cmp_vals c (VInt 0) == 0)
             else raise_exc world "ArgumentError"
                    ("comparison of " ++ display_cls_msg world (dispatch_cls_of world va0) ++ " with "
                     ++ (if is_num bv9 then to_s bv9 else display_cls_msg world (dispatch_cls_of world bv9)) ++ " failed")))
       // synthetic classes carry their own == / eql? via primitive dispatch
       // (not the meths table), so route the operator there rather than
       // falling through to rb_eq (which is object identity).
       else if (str_eq op "==" || str_eq op "eql?")
               && (str_eq ocl "Enumerator::ArithmeticSequence" || str_eq ocl "Method" || str_eq ocl "UnboundMethod"
                   // (a Time keeps being one behind a singleton class: `def t.x`
                   // made `t == Time.utc(1970)` fall through to identity)
                   || str_eq (display_cls world ocl) "Time"
                   || exc_is_a world ocl "Exception")
               && (if has_meth world ocl op then false else true) then
         invoke_val_c env world blk va0 op (Cons (eval_e env world blk b, Nil)) false
       // Time's arithmetic is a primitive, not an entry in the method table.
       else if str_eq (display_cls world ocl) "Time" && (str_eq op "+" || str_eq op "-") then
         invoke_val_c env world blk va0 op (Cons (eval_e env world blk b, Nil)) false
       // an object with no operator of its own but a method_missing: ruby
       // dispatches the operator like any other message (a matcher's =~).
       // ...but only for operators Object does NOT already define. `==`, `!=`,
       // `===`, `<=>` and `!~` are real Object methods, so ruby answers them
       // from Object and method_missing never runs: `obj <=> 3` is nil, not a
       // missing message. (`=~` is not in the list: Object#=~ was REMOVED in
       // ruby 3.2, so that one really does reach method_missing.)
       else if (if str_eq op "==" || str_eq op "!=" || str_eq op "===" ||
                   str_eq op "<=>" || str_eq op "!~" then false else true)
               && has_meth world ocl "method_missing" && (if builtin_obj_has (display_cls world ocl) op then false else true) then
         invoke world noblk va0 ocl "method_missing" (Cons (VSym op, Cons (eval_e env world blk b, Nil)))
       else eval_bin_prim env world blk op va0 (eval_e env world blk b)
     // a class-level operator (def self.<<) dispatches too.
     | VClass c ->
       if has_meth world ("(sng:" ++ c ++ ")") op then
         let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
         invoke world noblk va0 ("(sng:" ++ c ++ ")") op (Cons (eval_e env world blk b, Nil))
       else eval_bin_prim env world blk op va0 (eval_e env world blk b)
     // a primitive tagged as a subclass instance (String/Array/Hash subclass)
     // whose subclass defines the operator dispatches to that override.
     | _ ->
       // Evaluate the right operand FIRST, then choose. Ruby's order is
       // receiver, arguments, dispatch, and the argument can change what
       // dispatch finds: `str + f(str)` where f opens `class << str` and
       // defines `#+` has to reach the new method. Looking the receiver's
       // singleton up before the argument ran meant it never could.
       let vb = eval_e env world blk b in
       let hk = hng_key va0 in
       if (if str_eq hk "" then false else true) && map_has hng_store hk && has_meth world (map_get hng_store hk) op then
         let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
         invoke world noblk va0 (map_get hng_store hk) op (Cons (vb, Nil))
       // a builtin value class (Integer/Float/String/Array/...) whose operator
       // the user reopened and redefined: dispatch to that method instead of
       // the primitive. Only when the method actually exists in the table
       // (untouched builtins have no entry, so this is a no-op for them).
       else if (let c = class_name va0 in has_meth world c op) then
         (let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
          invoke world noblk va0 (class_name va0) op (Cons (vb, Nil)))
       else eval_bin_prim env world blk op va0 vb)

// v0.1: takes the right operand as a VALUE, not as an expression. Ruby's
// order is receiver, then arguments, then dispatch -- and evaluating the
// argument can change what dispatch finds, because it can open the
// receiver's singleton class and define the operator there. Deciding first
// and evaluating second made `str + f(str)`, where f defines `#+` on str,
// use the primitive. Every operator here evaluates both sides anyway (the
// short-circuit ones are Logic, not Bin), so nothing is evaluated that was
// not before.
and eval_bin_prim = fn env -> fn world -> fn blk -> fn (op: str) -> fn (va0: Val) -> fn (vb: Val) ->
    // Array#== compares ELEMENT BY ELEMENT with each element's own ==, so an
    // array of objects that define == compares by their rule. rb_eq is
    // structural and cannot dispatch, so a pair of arrays whose elements carry
    // a user == is compared here (`[obj] == [obj2]` answered false).
    if str_eq op "==" then
      (match (va0, vb) with
       | (VArr xa, VArr xb) ->
         (if elem_has_user_eq world (deref xa) || elem_has_user_eq world (deref xb)
          then VBool (arr_eq_w env world (deref xa) (deref xb))
          else VBool (rb_eq va0 (vb)))
       | _ -> VBool (rb_eq va0 (vb)))
    else if str_eq op "!=" then
      (match (va0, vb) with
       | (VArr xa, VArr xb) ->
         (if elem_has_user_eq world (deref xa) || elem_has_user_eq world (deref xb)
          then VBool (if arr_eq_w env world (deref xa) (deref xb) then false else true)
          else (if rb_eq va0 (vb) then VBool false else VBool true))
       | _ -> (if rb_eq va0 (vb) then VBool false else VBool true))
    // `(1..10) % 3` is `(1..10).step(3)`: the same arithmetic sequence, and
    // ruby spells it both ways. Answered here rather than in the dispatcher so
    // that the operator and the method form cannot drift apart.
    // ⚠ `a & b` and `a - b` are SET operations: they ask #hash and #eql?,
    // not `==`, so an element that answers eql? true while `==` says no is
    // still the same element. The value-level arms below cannot ask an object
    // anything (they are defined in an earlier chain), so the protocol answer
    // is given here -- and only when an element actually carries one, so an
    // ordinary array keeps the fast path. Answered beside the operator rather
    // than only in #intersection / #difference, or the two spellings of one
    // operation would disagree.
    else if (str_eq op "&" || str_eq op "-")
            && (match (va0, vb) with
                | (VArr xa, VArr xb) -> elem_has_user_eql world (deref xa) || elem_has_user_eql world (deref xb)
                | _ -> false) then
      (match (va0, vb) with
       | (VArr xa, VArr xb) ->
         (if str_eq op "&"
          then arr_new (val_intersect_w env world (val_dedup_into (deref xa) Nil) (deref xb))
          else arr_new (val_subtract_w env world (deref xa) (deref xb)))
       | _ -> VNil)
    // A BEGINLESS range is a sequence too -- `(..5) % 2` starts at nil and
    // slices an array from its front. Requiring an Integer begin sent it to
    // the numeric `%` instead, which refused with "Integer can't be coerced
    // into Integer". For a beginless one it is the END that decides, so the
    // whole family comes here and aseq_pct names the refusal.
    else if str_eq op "%" && (match va0 with
                              | VRange (lo9, hi9, _) ->
                                (match lo9 with
                                 | VNil -> true
                                 | _ -> rng_is_int lo9 && (rng_is_int hi9 || rng_hi_open hi9))
                              | _ -> false) then
      aseq_pct world va0 (Cons (vb, Nil))
    else if str_eq op "===" then
      // TWO QUESTIONS, ONE NAME. `when` needs a truth value, and that is what
      // case_eqq answers. The OPERATOR returns whatever the receiver's #===
      // returned, and for a callable that is the call's own result: ruby's
      // `m === 1` is 1, not true. Answering the `when` question here made a
      // Method comparison print a boolean where ruby prints the value.
      (if (match va0 with
           | VObj oid9 -> (let (_, _, ocls9, _) = world in
                           let c9 = map_get ocls9 oid9 in
                           str_eq c9 "Method" || str_eq c9 "Proc")
           | VProc _ -> true
           | _ -> false)
       then (let noblk = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
             invoke_val_c gc_cenv0 world noblk va0 "call" (Cons (vb, Nil)) false)
       else VBool (case_eqq world va0 (vb)))
    // A Symbol matches like its name does (`:V3_2_2 =~ /\AV\d+/` is 0):
    // regexp_parser selects its version constants that way.
    else if str_eq op "=~" then
      (let vb = vb in
       match va0 with
       | VStr sv0 ->
         (let sv = sget sv0 in
          match vb with
          | VRegex (p, pf, _) -> rx_do_match world p pf sv (senc_get sv0)
          // string =~ string is ruby's own type mismatch; any OTHER object
          // is asked for ITS #=~ with self (a mock's stubbed =~ answers).
          | VStr _ -> raise_exc world "TypeError" "type mismatch: String given"
          | VObj oq ->
            (let (mq, sq, ocq, iq) = world in
             let oclq = map_get ocq oq in
             let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
             if has_meth world oclq "=~" then invoke world nb (VObj oq) oclq "=~" (Cons (va0, Nil))
             // a mock's =~ lives behind method_missing: call that directly.
             else if has_meth world oclq "method_missing"
             then invoke world nb (VObj oq) oclq "method_missing" (Cons (VSym "=~", Cons (va0, Nil)))
             else VNil)
          | _ -> VNil)
       | VSym sv -> (match vb with VRegex (p, pf, _) -> rx_do_match world p pf sv (sym_enc_name sv) | _ -> VNil)
       | VRegex (p, pf, _) -> (match vb with VStr sv -> rx_do_match world p pf (sget sv) (senc_get sv) | VSym sv -> rx_do_match world p pf sv (sym_enc_name sv) | _ -> VNil)
       | _ -> VNil)
    else if str_eq op "!~" then
      (let vb = vb in
       match va0 with
       | VStr sv -> let sv = sget sv in (match vb with VRegex (p, pf, _) -> VBool (if rx_match p pf sv then false else true) | _ -> VBool true)
       | VSym sv -> (match vb with VRegex (p, pf, _) -> VBool (if rx_match p pf sv then false else true) | _ -> VBool true)
       | VRegex (p, pf, _) -> (match vb with VStr sv -> let sv = sget sv in VBool (if rx_match p pf sv then false else true) | VSym sv -> VBool (if rx_match p pf sv then false else true) | _ -> VBool true)
       // `!~` is `=~` negated, and Object has no #=~ since ruby 3.2: a receiver
       // that does not answer it raises rather than saying "no match". A class
       // that defines either one keeps its answer.
       | VObj _ ->
         (if has_meth world (dispatch_cls_of world va0) "!~" then
            invoke_val_c env world blk va0 "!~" (Cons (vb, Nil)) false
          // ...and a method_missing answers `=~` like any other message, so it
          // decides here too: asking only the method TABLE made `obj !~ x`
          // raise for an object that answers every name it is sent.
          else if has_meth world (dispatch_cls_of world va0) "=~"
                  || has_meth world (dispatch_cls_of world va0) "method_missing" then
            VBool (if truthy (invoke_val_c env world blk va0 "=~" (Cons (vb, Nil)) false) then false else true)
          else raise_exc world "NoMethodError"
                 ("undefined method '=~' for " ++ for_recv_cls world (dispatch_cls_of world va0)))
       | _ -> VBool true)
    // For a class/module these five are the SUBCLASS partial order, not a
    // value comparison, so they have to reach the class dispatcher rather
    // than cmp_vals (which has no ordering for a class and raises).
    else if (str_eq op "<" || str_eq op "<=" || str_eq op ">" ||
             str_eq op ">=" || str_eq op "<=>") &&
            (match va0 with VClass _ -> true | _ -> false) then
      invoke_val_c env world blk va0 op (Cons (vb, Nil)) false
    // Hash#< / #<= / #> / #>= are the SUBSET relation, not a value comparison:
    // `h1 <= h2` is "every pair of h1 is in h2", and the strict forms also
    // require different sizes. They had no arm at all, so the pair fell through
    // to the value comparison and raised.
    else if (str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=")
            && (match va0 with VHsh _ -> true | _ -> false) then
      (match va0 with
       | VHsh ha ->
         (match vb with
          | VHsh hb ->
            (let xs = hderef ha in
             let ys = hderef hb in
             let na = hash_len xs in
             let nb2 = hash_len ys in
             let ci = hcbi_on ha || hcbi_on hb in
             if str_eq op "<" then VBool (na < nb2 && hash_subset_of world xs ys ci)
             else if str_eq op "<=" then VBool (hash_subset_of world xs ys ci)
             else if str_eq op ">" then VBool (nb2 < na && hash_subset_of world ys xs ci)
             else VBool (hash_subset_of world ys xs ci))
          | _ -> raise_exc world "TypeError"
                   ("no implicit conversion of " ++ class_name vb ++ " into Hash"))
       | _ -> VNil)
    // Array <=> Array through the OPERATOR: the same element-by-element answer
    // the method form gives, nil included. This arm was missing, so the pair
    // fell through to the value-level comparison, which raises where ruby
    // answers nil.
    else if str_eq op "<=>"
            && (match va0 with VArr _ -> true | _ -> false)
            && (match vb with VArr _ -> true | _ -> false) then
      (match (va0, vb) with
       | (VArr xa, VArr xb) -> arr_spaceship_w env world (deref xa) (deref xb)
       | _ -> VNil)
    // ...and an argument that is not an Array is asked for #to_ary first, the
    // way every other Array method asks. Only the Array/Array pair was handled,
    // so `[4, 5] <=> obj` answered nil for an object that IS array-like.
    else if str_eq op "<=>"
            && (match va0 with VArr _ -> true | _ -> false)
            && (match vb with VObj _ -> true | _ -> false)
            && responds world vb "to_ary" then
      (let nb7 = (false, (Nil : str list), (Nil : Stmt list), env) in
       match invoke_val_c env world nb7 vb "to_ary" Nil false with
       | VArr xb -> (match va0 with VArr xa -> arr_spaceship_w env world (deref xa) (deref xb) | _ -> VNil)
       | _ -> VNil)
    // String <=> : bytes decide; identical bytes in incompatible encodings
    // order by the encodings' registration index. A non-String argument is
    // asked for #to_str (compared as a String) or #<=> (inverted).
    else if str_eq op "<=>" && (match va0 with VStr _ -> true | _ -> false) then
      (match va0 with
       | VStr ah ->
         (match vb with
          | VStr bh2 ->
            (let c = str_compare (sget ah) (sget bh2) in
             if c < 0 then VInt (0 - 1)
             else if c > 0 then VInt 1
             else if str_eq (enc_pair_or ah bh2) "" then
               (let d = enc_index (enc_canon_name (senc_get ah)) - enc_index (enc_canon_name (senc_get bh2)) in
                VInt (if d < 0 then 0 - 1 else if d > 0 then 1 else 0))
             else VInt 0)
          | VObj _ ->
            (if responds world vb "to_str" then
               (match invoke_val_c env world blk vb "to_str" Nil false with
                | VStr bh3 -> (let c = str_compare (sget ah) (sget bh3) in VInt (if c < 0 then 0 - 1 else if c > 0 then 1 else 0))
                | _ -> VNil)
             // ⚠ the INVERSE comparison, and ruby guards it against finding
             // itself (rb_invcmp / rb_exec_recursive_outer): two objects that
             // each defer to the other answer nil, where this ran the stack
             // out. The guard is keyed on the PAIR, so an unrelated comparison
             // inside the callee still works -- and it is removed whether the
             // callee returns OR raises, because a key left behind would make
             // the next comparison of that same pair answer nil.
             else if responds world vb "<=>" then
               (let k9 = "invcmp:" ++ invcmp_id va0 ++ "|" ++ invcmp_id vb in
                if map_has insp_seen k9 then VNil
                else
                  let _ = map_set insp_seen k9 1 in
                  let _ = (if map_has insp_seen (k9 ++ "!ok") then map_delete insp_seen (k9 ++ "!ok") else ()) in
                  let r9 = try_or (fn (u: unit) ->
                             let v9 = invoke_val_c env world blk vb "<=>" (Cons (va0, Nil)) false in
                             let _ = map_set insp_seen (k9 ++ "!ok") 1 in v9) VNil in
                  let ok9 = map_has insp_seen (k9 ++ "!ok") in
                  let _ = (if ok9 then map_delete insp_seen (k9 ++ "!ok") else ()) in
                  let _ = map_delete insp_seen k9 in
                  if ok9 then (match r9 with VInt cc -> VInt (0 - cc) | _ -> VNil)
                  else (let (_, _, _, iv9) = world in
                        flow_value (re_raise world
                          (if map_has iv9 "$exc" then map_get iv9 "$exc" else VNil))))
             else VNil)
          | _ -> VNil)
       | _ -> VNil)
    else if str_eq op "<=>" then
      (let vb = vb in
       // A COMPLEX has an ordering exactly when both imaginary parts are zero:
       // then it is the reals that are compared, and `Complex(2,0) <=> 1` is 1.
       // Otherwise there is no answer (nil) -- which is what this gave for
       // every pair, including the ones ruby orders.
       if (match va0 with VCpx (_, _) -> true | _ -> false) || (match vb with VCpx (_, _) -> true | _ -> false) then
         // ⚠ `is_num` does NOT include Complex (is_cpx is the separate
         // question), so asking it alone sent every Complex-vs-Complex pair
         // straight to nil -- the one case this arm exists for.
         (if (if is_num vb || is_cpx vb then false else true) then VNil
          else if cpx_zero_im (cpx_im_of va0) && cpx_zero_im (cpx_im_of vb) then
            (let c9 = cmp_vals (cpx_re_of va0) (cpx_re_of vb) in
             VInt (if c9 < 0 then 0 - 1 else if c9 > 0 then 1 else 0))
          else VNil)
       // Object#<=> answers 0 for two values that are ==, even when neither has
       // an ordering: `o <=> o` is 0 and `o <=> other` is nil. The identity case
       // has to come BEFORE the incomparable test, which would call them both
       // unorderable and answer nil. (`<=>` is an operator, so it never reaches
       // the dispatcher arm that carries the rest of Object's protocol.)
       //
       // ...and a NUMBER against an object that coerces asks it first: ruby
       // answers `1 <=> obj` from the coerced pair, and this said nil.
       else if (match va0 with VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat _ -> true | _ -> false)
          && (match vb with VObj _ -> true | _ -> false) && (responds world vb "coerce" || has_coerce world vb) then
         (let (ok8, x8, y8) = coerced_pair env world vb va0 in
          if ok8 then coerced_apply env world "<=>" x8 y8 else VNil)
       // ⚠ an INFINITE float asks a non-numeric other for its own #infinite?
       //   and orders by the two signs: ruby's flo_cmp does exactly this, so
       //   `Float::INFINITY <=> obj` is 0 when the object calls itself +1,
       //   1 when it calls itself -1 or nil (finite), and the mirror for
       //   -Infinity. Without it every one of those answered nil.
       else if (match va0 with VFlt f7 -> flt_is_infinite f7 | _ -> false)
               && (match vb with VObj _ -> true | _ -> false)
               && responds world vb "infinite?" then
         (let sgn = (match va0 with VFlt f7 -> (if f7 > 0.0 then 1 else 0 - 1) | _ -> 0) in
          let nb7 = (false, (Nil : str list), (Nil : Stmt list), env) in
          let oi = (match invoke_val_c env world nb7 vb "infinite?" Nil false with
                    | VInt n7 -> n7
                    | _ -> 0) in
          VInt (if sgn < oi then 0 - 1 else if sgn > oi then 1 else 0))
       // ⚠ Object#<=> answers 0 for two values that are ==, and the question
       //   is the OBJECT's #== -- the value-level rb_eq cannot reach a user
       //   definition, so `E.new <=> E.new` was nil for a class whose #== says
       //   they are equal.
       else if cmp_incompatible va0 vb && rb_eq_w env world va0 vb then VInt 0
       // ⚠ NaN is UNORDERED: `1.0 <=> nan` is nil, not 0. cmp_vals has to
       //   answer an int and gave 0. The examples that say so never ran until
       //   mspec's nan_value existed in the shim, and both sides failing the
       //   same way read as MATCH.
       else if (match va0 with VFlt f7 -> (if f7 == f7 then false else true) | _ -> false)
               || (match vb with VFlt f7 -> (if f7 == f7 then false else true) | _ -> false) then VNil
       else if cmp_incompatible va0 vb then VNil
       // world-aware, so `[obj] <=> [obj]` reaches the elements' own <=>: the
       // value-level comparator cannot call one, and this is an OPERATOR, so it
       // never passes through the dispatcher where the world-aware paths live.
       else let c = cmp_vals_w world va0 vb in
       VInt (if c < 0 then 0 - 1 else if c > 0 then 1 else 0))
    else if str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=" then
      // incomparable operands raise ArgumentError with Ruby's message
      // ("comparison of String with 7 failed": numbers by value, others by class).
      (let vb = vb in
       // Complex does not include Comparable at all, so the four ordering
       // operators are not methods it has -- a NoMethodError, not a failed
       // comparison.
       if (match va0 with VCpx (_, _) -> true | _ -> false) then
         raise_exc world "NoMethodError"
           ("undefined method '" ++ op ++ "' for an instance of Complex")
       // ...and a NUMBER against an object that coerces asks it first, exactly
       // as `<=>` does. Only `<=>` had this, so `1 > obj` refused with
       // "comparison of Integer with Object failed" for an object whose whole
       // purpose is to answer that comparison. Four spec files say it in the
       // same words: "dispatches the correct operator after coercion".
       else if (match va0 with VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat _ -> true | _ -> false)
               && (match vb with VObj _ -> true | _ -> false)
               && (responds world vb "coerce" || has_coerce world vb) then
         (let (ok7, x7, y7) = coerced_pair env world vb va0 in
          if ok7 then coerced_apply env world op x7 y7
          else raise_exc world "ArgumentError"
                 ("comparison of " ++ class_name va0 ++ " with "
                  ++ display_cls_msg world (dispatch_cls_of world vb) ++ " failed"))
       // ...and the four relations are all false against a NaN, for the same
       //   reason: it is unordered, not equal-to.
       else if (match va0 with VFlt f7 -> (if f7 == f7 then false else true) | _ -> false)
               || (match vb with VFlt f7 -> (if f7 == f7 then false else true) | _ -> false) then
         VBool false
       else if cmp_incompatible va0 vb then
         raise_exc world "ArgumentError" ("comparison of " ++ class_name va0 ++ " with " ++ (if is_num vb then to_s vb else class_name vb) ++ " failed")
       else
         let c = cmp_vals va0 vb in
         VBool (if str_eq op "<" then c < 0 else if str_eq op "<=" then c <= 0 else if str_eq op ">" then c > 0 else c >= 0))
    else
      let vb = vb in
      // `"fmt" % arg` / `"fmt" % [args]` is sprintf-style formatting.
      if str_eq op "%" && (match va0 with VStr _ -> true | _ -> false) then
        (match va0 with
         | VStr h ->
           let args2 = rb_fmt_args env world vb in
           let out = rb_format env world (sget h) args2 in
           let renc = rb_fmt_enc (senc_get h) (sget h) args2 in
           let r = mkstr out in
           (match r with VStr rid -> (let _ = senc_set rid renc in r) | _ -> r)
         | _ -> va0)
      // INTEGER division / modulo by zero raises a real ZeroDivisionError.
      // Float operands instead yield Infinity / -Infinity / NaN (as in Ruby).
      else if (str_eq op "/" || str_eq op "%")
              && (match vb with VInt z -> z == 0 | _ -> false)
              && (match va0 with VInt _ -> true | VBig _ -> true | _ -> false)
      then raise_exc world "ZeroDivisionError" "divided by 0"
      // nil has no arithmetic/shift operators: Ruby raises NoMethodError
      // (e.g. `nil + 3`), not a generic type error.
      else if (match va0 with VNil -> true | _ -> false)
              && (str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/"
                  || str_eq op "%" || str_eq op "**" || str_eq op "<<" || str_eq op ">>")
      then raise_exc world "NoMethodError" ("undefined method '" ++ op ++ "' for nil")
      // numeric (op) non-matching RHS: the coerce protocol. Arithmetic
      // (+,-,*,/,%,**) accepts any Numeric RHS; bitwise (&,|,^) accepts only
      // Integer/Bignum. A RHS the operator cannot take directly is coerced:
      // a #coerce responder supplies the pair, otherwise TypeError
      // "X can't be coerced into <LHS class>" (X = inspect for an immediate,
      // class name for a heap object — CRuby's coerce_failed).
      else if (match va0 with VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat _ -> true | VCpx _ -> true | _ -> false)
              && (str_eq op "+" || str_eq op "-" || str_eq op "*" || str_eq op "/"
                  || str_eq op "%" || str_eq op "**" || str_eq op "&" || str_eq op "|" || str_eq op "^"
                  // `1 <=> obj` coerces too -- and answers NIL when it cannot,
                  // where the arithmetic operators raise
                  || str_eq op "<=>")
              && (let bitwise = str_eq op "&" || str_eq op "|" || str_eq op "^" in
                  let ok = (if bitwise then (match vb with VInt _ -> true | VBig _ -> true | _ -> false)
                            else (match vb with VInt _ -> true | VFlt _ -> true | VBig _ -> true | VRat _ -> true | VCpx _ -> true | _ -> false)) in
                  if ok then false else true)
      then
        (match vb with
         | VObj oid ->
           (let (m0, s0, ocls0, _) = world in
            let ocl = map_get ocls0 oid in
            if (responds world vb "coerce" || has_coerce world vb) then
              (let (ok9, x9, y9) = coerced_pair env world vb va0 in
               if ok9 then coerced_apply env world op x9 y9
               else raise_exc world "TypeError" "coerce must return [x, y]")
            else if str_eq op "<=>" then VNil
            else raise_exc world "TypeError" (coerce_operand_display world vb ++ " can't be coerced into " ++ class_name va0))
         | _ -> (if str_eq op "<=>" then VNil
                 else raise_exc world "TypeError" (coerce_operand_display world vb ++ " can't be coerced into " ++ class_name va0)))
      // a String/Array receiver + a to_str/to_ary-responding object arg:
      // coerce the arg (implicit conversion) before the primitive op.
      else if str_eq op "+"
              && (match va0 with VStr _ -> true | VArr _ -> true | _ -> false)
              && (match vb with VObj _ -> true | _ -> false)
              && responds world vb (match va0 with VStr _ -> "to_str" | _ -> "to_ary") then
        arith_bin op va0 (invoke_val_c env world blk vb (match va0 with VStr _ -> "to_str" | _ -> "to_ary") Nil false)
      // `"x" * obj` / `[1] * obj` -- the right-hand side is a COUNT, so the
      // conversion asked for is #to_int. The `+` case above already did this
      // for to_str/to_ary; repetition was left refusing an object that answers
      // to_int, which the index and count methods have accepted for a while.
      // an ARRAY receiver asks #to_str FIRST: `[:a,:b,:c] * obj` where obj has
      // both conversions is the JOIN ("a2b2c"), not the repetition. A String
      // receiver has only the count meaning, so it skips this arm.
      // (asked at most ONCE each: a mock counts its calls, so the decision and
      // the use have to share the one conversion.)
      else if str_eq op "*"
              && (match va0 with VArr _ -> true | _ -> false)
              && (match vb with VObj _ -> true | _ -> false)
              && (responds world vb "to_str" || responds world vb "to_int") then
        (let sv = (if responds world vb "to_str"
                   then invoke_val_c env world blk vb "to_str" Nil false else VNil) in
         match sv with
         | VStr _ ->
           (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
            invoke_val_c env world nb va0 "join" (Cons (sv, Nil)) false)
         | _ ->
           (if responds world vb "to_int"
            then arith_bin op va0 (invoke_val_c env world blk vb "to_int" Nil false)
            else raise_exc world "TypeError"
                   ("no implicit conversion of " ++ class_name vb ++ " into Integer")))
      else if str_eq op "*"
              && (match va0 with VStr _ -> true | VArr _ -> true | _ -> false)
              && (match vb with VObj _ -> true | _ -> false)
              && responds world vb "to_int" then
        arith_bin op va0 (invoke_val_c env world blk vb "to_int" Nil false)
      // `arr * "sep"` is `arr.join(sep)`, not repetition -- ruby's Array#* takes
      // either. bundler's ui/shell.rb writes `...collect { ... } * "\n"`, and
      // refusing the String stopped `bundle --version` there. A STRING receiver
      // still refuses a String argument, which is what ruby does.
      else if str_eq op "*"
              && (match va0 with VArr _ -> true | _ -> false)
              && (match vb with VStr _ -> true | _ -> false) then
        (match (va0, vb) with
         | (VArr aid, VStr sh) ->
           (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
            invoke_val_c env world nb va0 "join" (Cons (vb, Nil)) false)
         | _ -> arith_bin op va0 vb)
      // ...and an object that cannot become an Integer is refused, rather than
      // repeated some number of times nobody asked for
      else if str_eq op "*"
              && (match va0 with VStr _ -> true | VArr _ -> true | _ -> false)
              && (match vb with VObj _ -> true | VNil -> true | VSym _ -> true | _ -> false) then
        raise_exc world "TypeError"
          ("no implicit conversion of " ++ (match vb with VNil -> "nil" | _ -> class_name vb)
           ++ (match vb with VNil -> " into Integer" | _ -> " into Integer"))
      // Proc#>> / Proc#<< are METHODS, so the operator hands them to the
      // dispatcher rather than answering here -- `pr.send(:<<, x)` has to
      // reach the same body, and arith_bin would read them as integer shifts.
      else if (str_eq op ">>" || str_eq op "<<")
              && (match va0 with VProc _ -> true | _ -> false) then
        invoke_val_c env world blk va0 op (Cons (vb, Nil)) false
      // Integer#<< and #>> take an INTEGER shift width. A Float, Rational or
      // Complex converts to one; nil, a String, a Symbol and an object with no
      // #to_int do not, and CRuby refuses those by TypeError. arith_bin is a
      // leaf helper with no world to raise from, so every one of them came out
      // as a bare StandardError and core/integer/left_shift_spec and
      // right_shift_spec read the right refusal under the wrong class.
      else if (str_eq op "<<" || str_eq op ">>")
              && (match va0 with VInt _ -> true | VBig _ -> true | _ -> false)
              && (match vb with VInt _ -> false | VBig _ -> false | _ -> true) then
        arith_bin op va0 (shift_width_v env world vb)
      else arith_bin op va0 vb

// The shift width for Integer#<< / #>>, refused the way CRuby refuses it.
// Not Kernel#Integer coercion: this one does NOT fall back to #to_i, and its
// message names the failure as a missing implicit conversion. A user object
// whose #to_int answers something other than an Integer gets the longer form,
// which names what it gave instead.
and shift_width_v = fn env -> fn world -> fn (v: Val) ->
  let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let no_conv = fn (u: unit) ->
    (let nm = (match v with
               | VNil -> "nil"
               | _ -> display_cls_msg world (dispatch_cls_of world v)) in
     let _ = prim_raise "TypeError" ("no implicit conversion of " ++ nm ++ " into Integer") in VNil) in
  match v with
  | VInt _ -> v
  | VBig _ -> v
  | VFlt f ->
    (if str_len (float_special f) > 0
     then (let _ = prim_raise "FloatDomainError" (float_domain_msg f) in VNil)
     else VInt (int_of_float f))
  | VNil -> no_conv ()
  | VStr _ -> no_conv ()
  | VSym _ -> no_conv ()
  | VBool _ -> no_conv ()
  | _ ->
    if responds world v "to_int" then
      (let ti = invoke_val_c env world nb9 v "to_int" Nil false in
       match ti with
       | VInt _ -> ti
       | VBig _ -> ti
       | _ ->
         let cn = display_cls_msg world (dispatch_cls_of world v) in
         let _ = prim_raise "TypeError"
           ("can't convert " ++ cn ++ " to Integer (" ++ cn ++ "#to_int gives "
            ++ display_cls_msg world (dispatch_cls_of world ti) ++ ")") in VNil)
    else no_conv ()

// CRuby coerce_failed display: an immediate (nil/true/false/Integer/Float/
// Symbol) shows its inspect; a heap object shows its class name.
// Is this expression a desugared string / regexp LITERAL? Both are built as
// `("" + seg + ...)` -- a regexp with `.__regex(flags)` on top -- and the
// lexer always starts the chain with an empty TStrL, so the leftmost leaf
// says so. Used only by defined?, which must not evaluate what it looks at.

// every element of an array literal, asked the defined? question
and defined_all_elems = fn env -> fn world -> fn blk -> fn (es: Expr list) ->
  match es with
  | Nil -> true
  | Cons (h, t) ->
    (match eval_e env world blk (EDefined h) with
     | VNil -> false
     | _ -> defined_all_elems env world blk t)

// Is this operand a reason for the whole `defined?` to be nil? Two ways, and
// only one of them is a raise:
//   - the operand is not itself defined -- `defined?(!@unset_iv)` is nil, and
//     READING an unset instance variable raises nothing at all
//   - evaluating it raises -- `defined?(not DS.raises)` is nil
// The defined? question is asked FIRST, because it evaluates receivers only;
// running the operand afterwards keeps ruby's side effects happening once.
and defined_operand_failed = fn env -> fn world -> fn blk -> fn (e: Expr) ->
  if (match eval_e env world blk (EDefined e) with VNil -> true | _ -> false) then true
  else
    (match defined_eval_recv env world blk e with
     | VSym m -> str_eq m "__mere_defined_fail__"
     | _ -> false)

// `defined?(super)` -- shared by the bare-word spelling (which reaches
// EVar "super") and the real super node (`defined? super` without parens).
and defined_super_str = fn env -> fn world ->
  let (m2, s2, o2, i2) = world in
  let defcls = (match (if lv_has env "__defcls" then lv_get env "__defcls" else VNil) with VClass c -> c | _ -> "") in
  let meth = (match (if lv_has env "__meth" then lv_get env "__meth" else VNil) with VStr s -> sget s | _ -> "") in
  let recv9 = (if lv_has env "self" then lv_get env "self" else VMain) in
  if str_eq defcls "" || str_eq meth "" then VNil
  // The SAME walk a real super does -- strictly after the class or module the
  // current method is defined in, along the receiver's ancestors. Reading only
  // the direct superclass missed every super that lands in an included module,
  // which is the shape ruby/spec uses to test super at all.
  else if is_sng_cls defcls then
    (let sc9 = sng_supername world defcls in
     if has_meth world sc9 meth then mkstr "super" else VNil)
  else
    (let a9 = lookup_anc world (anc_after (ancestors_of world (super_base world recv9)) defcls) meth in
     if str_eq a9 "" then VNil else mkstr "super")

and coerce_operand_display = fn world -> fn (v: Val) ->
  match v with
  | VNil -> "nil" | VBool b -> (if b then "true" else "false")
  | VInt _ -> to_s v | VBig _ -> to_s v | VFlt _ -> to_s v
  | VSym s -> ":" ++ s
  // an OBJECT is named by its own class: class_name is world-free and answers
  // "Object" for every one of them, so `4 + obj` reported "Object can't be
  // coerced into Integer" whatever class obj was.
  | VObj _ -> display_cls_msg world (dispatch_cls_of world v)
  | _ -> class_name v
// apply an operator to a coerced pair: a user object dispatches to its own
// operator method, plain numerics go straight to arithmetic.
// Ask the other side for #coerce and require [x, y] back. What ruby answers
// when it does NOT get that is one rule -- a TypeError naming the protocol --
// and it was written at three call sites with three different answers: the
// arithmetic operators raised it, `<=>` returned nil, and `<` `>` `<=` `>=`
// raised "comparison of X with Y failed". Written once, all three agree.
// ...and NIL is a DECLINE, not a malformed answer. ruby's do_coerce separates
// the two, and only the comparison operators can act on the difference:
// `1 <=> x` is nil, `1 < x` is "comparison of Integer with X failed", and
// `1 + x` is the same TypeError a malformed answer gets. The bool says which.
and coerced_pair = fn env -> fn world -> fn (vb: Val) -> fn (va0: Val) ->
  let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let bad9 = fn (u: unit) ->
    (let _ = raise_exc world "TypeError" "coerce must return [x, y]" in (true, va0, vb)) in
  match invoke_val_c env world nb9 vb "coerce" (Cons (va0, Nil)) false with
  | VNil -> (false, va0, vb)
  | VArr aid9 ->
    (match deref aid9 with
     | Cons (x9, Cons (y9, Nil)) -> (true, x9, y9)
     | _ -> bad9 ())
  | _ -> bad9 ()

and coerced_apply = fn env -> fn world -> fn (op: str) -> fn (x: Val) -> fn (y: Val) ->
  // `<=>` and the method forms are not arith_bin's operators, so a coerced pair
  // of NUMBERS is compared (or divided) through the dispatcher instead.
  if (match x with VObj _ -> false | _ -> true)
     && (str_eq op "<=>" || str_eq op "div" || str_eq op "modulo" || str_eq op "quo"
         || str_eq op "fdiv" || str_eq op "remainder" || str_eq op "divmod"
         || str_eq op "<" || str_eq op "<=" || str_eq op ">" || str_eq op ">=") then
    (let nb7 = (false, (Nil : str list), (Nil : Stmt list), env) in
     invoke_val_c env world nb7 x op (Cons (y, Nil)) false)
  else
  match x with
  // Ruby re-SENDS the operator to the coerced left value, so whatever answers
  // an ordinary `x.op(y)` answers here too. Asking the method table directly
  // and raising when it had no entry meant a coerced object with a
  // method_missing (which is what every ruby/spec mock is) got a NoMethodError
  // for the very message the protocol promises to send it.
  | VObj _ ->
    (let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
     invoke_val_c env world noblk x op (Cons (y, Nil)) false)
  | _ -> arith_bin op x y

// hash-literal pairs; a doubled EKwSplat marker splices another hash.
and hsh_eval_items = fn env -> fn world -> fn blk -> fn (items: Expr list) ->
  match items with
  | Nil -> Nil
  | Cons (k, rest0) ->
    (match k with
     | EKwSplat e ->
       (match rest0 with
        | Cons (_, rest) ->
          // ⚠ `**obj` asks obj for #to_hash and REFUSES what it gets back if
          // that is not a Hash. Answering an empty list for everything else
          // made `{ **obj }` silently empty instead of naming the conversion.
          let pairs = (match eval_e env world blk e with
                       | VHsh xs -> hderef xs
                       | VNil -> (Nil : Val list)
                       | other9 ->
                         (match conv_try env world other9 "to_hash" with
                          | VHsh xs -> hderef xs
                          | _ ->
                            (let cn9 = display_cls_msg world (dispatch_cls_of world other9) in
                             match raise_exc world "TypeError"
                               ("can't convert " ++ cn9 ++ " to Hash (" ++ cn9 ++ "#to_hash gives "
                                ++ display_cls_msg world (dispatch_cls_of world (conv_try env world other9 "to_hash")) ++ ")")
                             with _ -> (Nil : Val list)))) in
          list_append pairs (hsh_eval_items env world blk rest)
        | Nil -> Nil)
     | _ ->
       (match rest0 with
        | Cons (v, rest) ->
          // ⚠ A STRING KEY IS COPIED AND FROZEN. `k = "foo"; h = { k => 1 }`
          // stores a frozen duplicate, so `k << "bar"` afterwards leaves the
          // hash's key alone -- storing k itself let the caller mutate a key
          // in place, and `h["foo"]` then found nothing.
          Cons (hsh_key_of (eval_e env world blk k),
                Cons (eval_e env world blk v, hsh_eval_items env world blk rest))
        | Nil -> Cons (hsh_key_of (eval_e env world blk k), Nil)))

// object identity (equal?): reference types are identical only when they
// are the same handle; immediates compare by value.

// bind index values to hidden temp vars (__opi0..) in e2 for op-assign, and
// return EVar references to them (so the index is not re-evaluated).

and eval_args = fn env -> fn world -> fn blk -> fn (items: Expr list) ->
  match items with
  | Nil -> Nil
  // splat argument: expand an array's elements into the argument list.
  | Cons (ESplat e, t) ->
    let spread = (match eval_e env world blk e with
                  | VArr id -> deref id
                  | VHsh xs -> let xs = hderef xs in hash_to_a xs   // *hash spreads as [k, v] pairs
                  | VNil -> Nil   // [*nil] is empty
                  // `[*(0..2)]` is [0, 1, 2]: a splat asks for to_a, and a
                  // Range has one. It used to spread as the Range itself.
                  | VRange (lo, hi, excl) -> range_vals world lo hi excl
                  // a non-array splat calls to_a if the object responds to
                  // it: a real/singleton method, or a user respond_to? that
                  // answers true (covering method_missing mocks).
                  | VObj oid ->
                    let (m2, sp2, ocls2, iv2) = world in
                    let ocl2 = map_get ocls2 oid in
                    let coerce =
                      (if has_meth world ocl2 "to_a" then true
                       else if has_meth world ocl2 "respond_to?" then
                         truthy (invoke_val_c env world blk (VObj oid) "respond_to?" (Cons (VSym "to_a", Nil)) false)
                       else false) in
                    if coerce then
                      // to_a returning nil means "not really convertible", so
                      // the splat wraps the original object as [obj]; a
                      // non-Array, non-nil result is a TypeError.
                      (match invoke_val_c env world blk (VObj oid) "to_a" Nil false with
                       | VArr aid -> deref aid
                       | VNil -> Cons (VObj oid, Nil)
                       | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name (VObj oid) ++ " to Array (" ++ class_name (VObj oid) ++ "#to_a gives " ++ class_name other ++ ")") in Cons (VObj oid, Nil)))
                    else Cons (VObj oid, Nil)
                  | v -> Cons (v, Nil)) in
    list_append spread (eval_args env world blk t)
  // **h passes the hash's pairs as keyword args: a fresh, kwarg-marked copy
  // (so the original hash variable is unaffected and it binds as kwargs).
  | Cons (EKwSplat e, t) ->
    (match eval_e env world blk e with
     // `**{}` (an empty double-splat) passes no keyword arguments at all
     // (Ruby 3.0): omit it rather than leaking an empty positional hash.
     | VHsh id ->
       (match hderef id with
        | Nil -> eval_args env world blk t
        | pairs -> (match mkhash pairs with
                    | VHsh nid -> let _ = mark_kw nid in Cons (VHsh nid, eval_args env world blk t)
                    | v -> Cons (v, eval_args env world blk t)))
     | other -> Cons (other, eval_args env world blk t))
  // ⚠ an EMPTY keyword hash is not an argument. `f(**{})`, and `f(**h)` with
  //   an empty h, pass NOTHING in ruby -- `def m() end; m(**{})` answers nil,
  //   where handing the callee an empty hash makes it "wrong number of
  //   arguments (given 1, expected 0)" and aborted a whole spec file.
  | Cons (EKwHash items9, t) ->
    (match eval_e env world blk (EKwHash items9) with
     | VHsh id9 ->
       (match hderef id9 with
        | Nil -> eval_args env world blk t
        | _ -> Cons (VHsh id9, eval_args env world blk t))
     | v9 -> Cons (v9, eval_args env world blk t))
  | Cons (h, t) -> Cons (eval_e env world blk h, eval_args env world blk t)

// ---- multiple assignment ------------------------------------------------
// the slot a global name refers to, following any `alias` chain.
// `$1`..`$9` and beyond: every character a digit, so the whole name is a
// capture index rather than one of the punctuation globals.

// the slot name a `trace_var(:$g)` argument names ("$g" / :$g / "g" -> "g")
// `/#{expr}/o` interpolates ONCE: the first value built at that source site
// is the regex from then on. The site is named by the literal's offset, which
// the lexer passes along; without the o flag nothing is remembered.

// run the tracer for a global that has one. Every global write goes through
// gvar_write, so a traced variable fires wherever it is assigned.
and gvar_write = fn world -> fn (slot: str) -> fn (v: Val) ->
  let _ = map_set globals slot v in
  if map_has hook_flags "gvt" && map_has gvar_traces slot
     && (if map_has trace_fn "gvbusy" then false else true) then
    (match map_get gvar_traces slot with
     | VProc pid ->
       (let _ = map_set trace_fn "gvbusy" VNil in
        let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
        // a raise inside the tracer belongs to the ASSIGNMENT: ruby lets it
        // out, so the rescue around `$var = 100` is the one that sees it.
        // The busy flag is cleared first, or the unwind would leave it set.
        let _ = map_delete trace_fn "gvbusy" in
        let _ = run_block world nb (proc_as_block pid) (Cons (v, Nil)) in ())
     | _ -> ())
  else ()

// The match globals are READ-ONLY. A literal `$& = ""` is refused by the
// parser (ruby: SyntaxError "Can't set variable $&"); reached through an
// ALIAS it is a NameError at run time, naming the alias -- `alias $x $&;
// $x = ""` says "$x is a read-only variable". Both were silent writes here.

// The other read-only ones. ruby refuses these by NAME (a NameError, not a
// parse error): the exception in flight, the load path, the loaded-features
// list, ARGF and the child status. A program READS them; the interpreter
// writes them. Both the written spelling and the resolved slot are checked,
// because `$LOAD_PATH` and `$:` are separate slots here that happen to share
// one array.

// ...and the ones that must be a String, named in their own message: ruby says
// "value of $/ must be String" using the SPELLING that was written, so `$-0`
// and `$/` -- the same setting -- say different things.

// Some predefined globals COERCE what is assigned to them, and refuse what
// cannot convert: `$. = "x"` and `$0 = nil` are TypeErrors, and $stdout must
// have a #write. All three were accepted as-is.
and gvar_assign_checked = fn env -> fn world -> fn (name: str) -> fn (v: Val) ->
  let body = substring name 1 (str_len name) in
  let slot = gvar_slot body in
  if gvar_readonly slot then
    // The DIRECT spelling and the ALIASED one are different refusals, and the
    // alias table tells them apart: `$& = ""` is written as its own slot, so
    // ruby's parser refuses it ("Can't set variable $&"), while `$x = ""`
    // resolves THROUGH an alias and is a NameError naming $x.
    (if str_eq body slot then
       (let _ = raise_exc world "SyntaxError" ("Can't set variable $" ++ slot) in ())
     else (let _ = raise_exc world "NameError" (name ++ " is a read-only variable") in ()))
  else if gvar_readonly_named body || gvar_readonly_named slot then
    (let _ = raise_exc world "NameError" (name ++ " is a read-only variable") in ())
  // `$~` holds a MatchData or nil, and nothing else.
  else if str_eq slot "~" then
    (match v with
     | VNil -> (let _ = gvar_write world slot v in ())
     | VObj oid9 -> (if map_has md_whole (str_of_int oid9) then (let _ = gvar_write world slot v in ())
                     else (let _ = raise_exc world "TypeError"
                             ("wrong argument type " ++ display_cls_msg world (dispatch_cls_of world v)
                              ++ " (expected MatchData)") in ()))
     | _ -> (let _ = raise_exc world "TypeError"
               ("wrong argument type " ++ display_cls_msg world (dispatch_cls_of world v)
                ++ " (expected MatchData)") in ()))
  else if gvar_must_be_string body || gvar_must_be_string slot then
    (match v with
     | VStr _ -> (let _ = gvar_write world slot v in ())
     | VNil -> (let _ = gvar_write world slot v in ())
     | _ -> (let _ = raise_exc world "TypeError" ("value of " ++ name ++ " must be String") in ()))
  // `$;` takes a String OR a Regexp (it is String#split's default pattern).
  else if str_eq slot ";" || str_eq body ";" then
    (match v with
     | VStr _ -> (let _ = gvar_write world slot v in ())
     | VRegex (_, _, _) -> (let _ = gvar_write world slot v in ())
     | VNil -> (let _ = gvar_write world slot v in ())
     | _ -> (let _ = raise_exc world "TypeError" ("value of " ++ name ++ " must be String or Regexp") in ()))
  else if str_eq slot "." then
    (match v with
     | VInt _ -> (let _ = gvar_write world slot v in ())
     | _ ->
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
        let ti9 = (if responds world v "to_int" then invoke_val_c env world nb9 v "to_int" Nil false else VNil) in
        match ti9 with
        | VInt _ -> (let _ = gvar_write world slot ti9 in ())
        // nil has its own wording in ruby: "from nil to integer", not
        // "of NilClass into Integer".
        | _ -> (let _ = raise_exc world "TypeError"
                  (match v with
                   | VNil -> "no implicit conversion from nil to integer"
                   | _ -> "no implicit conversion of " ++ display_cls_msg world (dispatch_cls_of world v) ++ " into Integer") in ())))
  else if str_eq slot "0" || str_eq slot "PROGRAM_NAME" then
    (match v with
     | VStr _ -> (let _ = gvar_write world slot v in ())
     | _ ->
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
        let ts9 = (if responds world v "to_str" then invoke_val_c env world nb9 v "to_str" Nil false else VNil) in
        match ts9 with
        | VStr _ -> (let _ = gvar_write world slot ts9 in ())
        | _ -> (let _ = raise_exc world "TypeError"
                  ("no implicit conversion of " ++ (match v with VNil -> "nil" | _ -> display_cls_msg world (dispatch_cls_of world v))
                   ++ " into String") in ())))
  // `$VERBOSE = 1` stores TRUE: ruby keeps only the three states nil / false
  // / true, and anything else truthy becomes true.
  else if str_eq slot "VERBOSE" then
    (let v9 = (match v with VNil -> VNil | VBool b -> VBool b | _ -> VBool true) in
     let _ = gvar_write world slot v9 in ())
  else if str_eq slot "stdout" || str_eq slot "stderr" then
    (if responds world v "write" then (let _ = gvar_write world slot v in ())
     else (let _ = raise_exc world "TypeError"
             ("$" ++ slot ++ " must have write method, "
              ++ display_cls_msg world (dispatch_cls_of world v) ++ " given") in ()))
  else (let _ = gvar_write world slot v in ())

and assign_one = fn env -> fn world -> fn (tgt: str) -> fn (v: Val) ->
  let (meths, sup, ocls, ivars) = world in
  if str_len tgt > 0 && str_eq (char_at tgt 0) "$" then
    let _ = gvar_assign_checked env world tgt v in ()
  // "@@x" is a class variable, not an ivar named "@x" — same split SIVarAssign
  // makes, needed here so `@@a, @@b = ...` writes class variables.
  else if str_len tgt > 1 && str_eq (substring tgt 0 2) "@@" then
    let _ = cvar_set env world (substring tgt 2 (str_len tgt)) v in ()
  else if str_len tgt > 0 && str_eq (char_at tgt 0) "@" then
    let n = substring tgt 1 (str_len tgt) in
    // freezing an object seals its ivars too, so an attr writer (or any @x =)
    // on a frozen receiver is a FrozenError, not a silent write.
    (let slf = lv_get env "self" in
     let _ = (if val_frozen_mut slf
              then (let _ = raise_exc world "FrozenError"
                              ("can't modify frozen " ++ class_name slf ++ ": " ++ inspect slf) in ())
              else ()) in
     let k = ivar_self_key slf n in
     if str_eq k "" then () else (let _ = map_set ivars k v in ()))
  // a constant target (Capitalized, unqualified) is stored in the constant
  // table, so a later bare-Const read finds the assigned value. It belongs to
  // the enclosing class/module — the class-body walker namespaces the
  // assignments it can see, but one nested in an if/unless only reaches here.
  else if is_upper_first tgt && (if str_contains tgt "::" then false else true) then
    (let _ = const_store world (const_assign_key env tgt) v in ())
  else let _ = lv_set env tgt v in ()

// where a constant assignment lands: the enclosing class/module, else the top
// level. The class-body walker namespaces the assignments it can see directly;
// one nested in an if/unless only reaches the ordinary statement path, so the
// lexical scope has to be consulted here too.
// A constant that already has a value is being REPLACED, and ruby says so.
// ⚠ only the RUBY-LEVEL assignment sites route through here. `consts` is also
//   the table this interpreter SEEDS at startup -- Regexp::IGNORECASE and a
//   hundred others, and every class name -- and warning there would put a page
//   of noise in front of any program run with -w. Of the 159 writes to the
//   table, seven are a program assigning a constant; these are those.
// `C ||= v` / `C &&= v`: read-then-MAYBE-write. When the short circuit already
// decides the answer there is no write at all -- the same rule SIVarAssign has
// for `@x ||= v`. It matters now that a replacement WARNS: desugared to
// `C = (C || v)` this stored the same value back and announced "already
// initialized constant C" where ruby says nothing.
// ⚠ an assignment has TWO nodes here, the statement and the expression form,
//   so the rule lives in one place and both ask it.
and const_opassign = fn env -> fn world -> fn blk -> fn (name: str) -> fn (e: Expr) ->
  // ⚠ the two spellings read the constant through DIFFERENT nodes: `||=`
  //   desugars with EConstOrNil (an undefined constant is nil there, which is
  //   what makes `C ||= v` define it) and `&&=` with EConst (an undefined one
  //   raises, which is what makes `C &&= v` a NameError). Reading through the
  //   wrong one would turn `UND ||= 5` into a NameError.
  (match e with
   | EBin (o9, EConstOrNil n9, rhs9) ->
     (if str_eq o9 "||" && str_eq n9 name && is_upper_first name then
        (let cur9 = eval_e env world blk (EConstOrNil name) in
         if truthy cur9 then (true, cur9) else (false, eval_e env world blk rhs9))
      else (false, eval_e env world blk e))
   | EBin (o9, EConst n9, rhs9) ->
     (if str_eq o9 "&&" && str_eq n9 name && is_upper_first name then
        (let cur9 = eval_e env world blk (EConst name) in
         if truthy cur9 then (false, eval_e env world blk rhs9) else (true, cur9))
      else (false, eval_e env world blk e))
   | _ -> (false, eval_e env world blk e))

and const_store = fn world -> fn (key: str) -> fn (v: Val) ->
  let _ = (if map_has consts key
           then rb_warn world ("already initialized constant " ++ key) else ()) in
  map_set consts key v



// `**kw` params: the name after the double splat (or "").


// Array#[](start, len): negative start counts from the end; start just past
// the end yields []; out of range or negative length yields nil.

// Array#[]=(start, len, v): replace len elements at start with v (an array
// splices its elements in); writes past the end pad with nils.


// Array.new(n) { |i| ... }: element i is the block's value for index i.
and array_new_blk = fn world -> fn encl -> fn theblk -> fn (n: int) -> fn (i: int) ->
  if i >= n then Nil
  else Cons (flow_value (run_block world encl theblk (Cons (VInt i, Nil))), array_new_blk world encl theblk n (i + 1))

// flatten nested arrays up to `depth` levels; depth < 0 means unlimited.
// A handle already on the flatten stack (self-referential array) is skipped
// rather than recursed into — avoids the infinite recursion / segfault.
// tally: hash of element -> occurrence count (insertion order).
// each_slice: consecutive groups of n; each_cons: sliding windows of n.
// array of [k, v] pairs -> interleaved hash list [k1,v1,k2,v2,...].
// nth element of a list or VNil (for zip padding).
// zip: build [self[i], others[0][i], others[1][i], ...] for each i.
// transpose: rows -> columns (assumes rectangular).

// assign values to targets in parallel (no splat); missing values are nil.
and assign_parallel = fn env -> fn world -> fn (targets: str list) -> fn (values: Val list) ->
  match targets with
  | Nil -> ()
  | Cons (t, ts) ->
    (match values with
     | Nil -> let _ = assign_one env world t VNil in assign_parallel env world ts Nil
     | Cons (v, vs) -> let _ = assign_one env world t v in assign_parallel env world ts vs)

// complex multiple-assignment targets: write one value to one target.
and assign_x_one = fn env -> fn world -> fn blk -> fn (t: Expr) -> fn (v: Val) ->
  match t with
  | EVar n -> assign_one env world n v
  | EIVar n -> assign_one env world ("@" ++ n) v
  | ESplat inner -> assign_x_one env world blk inner v
  // a grouped target destructures its value like a nested masgn, coercing a
  // non-Array via #to_ary just as a top-level MLHS does.
  | EArr ts ->
    let vals = coerce_massign env world v (xhas_splat ts && xlen ts == 1) in
    assign_x_targets env world blk ts vals
  | EMethod (recv, m, args) ->
    let rv = eval_e env world blk recv in
    let argvals = eval_args env world blk args in
    let _ = invoke_val_c env world blk rv (m ++ "=") (vappend argvals (Cons (v, Nil))) false in
    ()
  // `recv::CONST = v` — assign a constant in the receiver module's namespace.
  | EScopedRead (recv, cn) ->
    (match eval_e env world blk recv with
     | VClass c -> let _ = const_store world (c ++ "::" ++ cn) v in ()
     | other -> let _ = raise_exc world "TypeError" (inspect other ++ " is not a class/module") in ())
  // `recv&.attr = v` — assign only when the receiver is non-nil.
  | ESafe (recv, m, args) ->
    (match eval_e env world blk recv with
     | VNil -> ()
     | rv -> let argvals = eval_args env world blk args in
             let _ = invoke_val_c env world blk rv (m ++ "=") (vappend argvals (Cons (v, Nil))) false in ())
  // a bare CONSTANT target (`A, b = 1, 2`).
  | EConst n -> let _ = const_store world n v in ()
  | _ -> ()

// Pre-evaluate a complex masgn target's receiver (and index/method args) into
// fresh temps, left to right, returning a rewritten target that reads those
// temps. This realises Ruby's evaluation order for `a.b, c[d] = ...`: every
// LHS receiver is evaluated (left to right) before the RHS, and every setter
// runs only after the RHS — so `foo[0], bar.baz = a, b` records foo, bar, a,
// b, foo[]=, bar.baz=. A plain variable/ivar/constant target has no receiver
// and is left untouched.
and prep_x_target = fn env -> fn world -> fn blk -> fn (t: Expr) ->
  match t with
  | EMethod (recv, m, args) ->
    let rv = eval_e env world blk recv in
    let rnm = fresh_anon "__mlr" in
    let _ = lv_set env rnm rv in
    EMethod (EVar rnm, m, prep_x_args env world blk args)
  // `(expr; m)::A, (expr; m)::B = ...` -- a constant WRITE has a receiver too,
  // and it was the one target kind left out of the pre-evaluation, so its
  // receiver ran after the RHS and the recorded order came out reversed.
  | EScopedRead (recv, cn) ->
    let rv = eval_e env world blk recv in
    let rnm = fresh_anon "__mlr" in
    let _ = lv_set env rnm rv in
    EScopedRead (EVar rnm, cn)
  | ESplat inner -> ESplat (prep_x_target env world blk inner)
  | EArr ts -> EArr (prep_x_targets env world blk ts)
  | _ -> t
and prep_x_args = fn env -> fn world -> fn blk -> fn (args: Expr list) ->
  match args with
  | Nil -> Nil
  | Cons (ESplat inner, rest) ->
    let av = eval_e env world blk inner in
    let anm = fresh_anon "__mla" in
    let _ = lv_set env anm av in
    Cons (ESplat (EVar anm), prep_x_args env world blk rest)
  | Cons (a, rest) ->
    let av = eval_e env world blk a in
    let anm = fresh_anon "__mla" in
    let _ = lv_set env anm av in
    Cons (EVar anm, prep_x_args env world blk rest)
and prep_x_targets = fn env -> fn world -> fn blk -> fn (ts: Expr list) ->
  match ts with
  | Nil -> Nil
  | Cons (t, rest) -> Cons (prep_x_target env world blk t, prep_x_targets env world blk rest)



and assign_x_parallel = fn env -> fn world -> fn blk -> fn (targets: Expr list) -> fn (values: Val list) ->
  match targets with
  | Nil -> ()
  | Cons (t, ts) ->
    (match values with
     | Nil -> let _ = assign_x_one env world blk t VNil in assign_x_parallel env world blk ts Nil
     | Cons (v, vs) -> let _ = assign_x_one env world blk t v in assign_x_parallel env world blk ts vs)

and assign_x_targets = fn env -> fn world -> fn blk -> fn (targets: Expr list) -> fn (values: Val list) ->
  // a lone grouped target is the whole target list: (b, c) = [1, 2]
  match targets with
  | Cons (EArr inner, Nil) -> assign_x_targets env world blk inner values
  | _ ->
  if xhas_splat targets then
    let before = xbefore_splat targets in
    let after = xafter_splat targets in
    let nb = xlen before in
    let na = xlen after in
    let nv = vlen values in
    let sc = nv - nb - na in
    let sc = if sc < 0 then 0 else sc in
    let _ = assign_x_parallel env world blk before (vtake values nb) in
    let _ = assign_x_one env world blk (xsplat_tgt targets) (arr_new (vtake (vdrop values nb) sc)) in
    assign_x_parallel env world blk after (vdrop values (nb + sc))
  else assign_x_parallel env world blk targets values

// coerce a single RHS value of a multiple assignment into the value list.
// An Array splats directly. A lone-splat LHS (`*a = obj`) wraps the object
// as [obj] without conversion. Any other MLHS (`a, b =` / `a, *b =`) converts
// a non-Array via #to_ary, wrapping as [rv] when it does not respond (or
// returns nil) and raising TypeError when #to_ary returns a non-Array.
// (The #to_a path is for a splatted RHS, e.g. `*a = *x`, handled at the RHS.)
and coerce_massign = fn env -> fn world -> fn (rv: Val) -> fn (lone_splat: bool) ->
  // lone_splat is retained for call-site clarity but no longer suppresses
  // coercion: Ruby coerces `*a = obj` via #to_ary exactly like any MLHS
  // (the coercion path wraps a non-responding object as [obj] on its own).
  let _ = lone_splat in
  match rv with
  | VArr id -> deref id
  | _ ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    // Ruby's protocol: respond_to?(:to_ary) then to_ary. A real/singleton
    // to_ary counts; otherwise a user respond_to? that answers true (covering
    // method_missing mocks). Only invoke respond_to? when it is user-defined,
    // matching the RHS-splat to_a path.
    // The same protocol the block-splat path already used, which this was a
    // poorer copy of: a real to_ary, a user respond_to?, a respond_to_missing?,
    // or a method_missing that answers for :to_ary. Ruby reaches all four --
    // rb_check_funcall ends at method_missing -- and this stopped at the first
    // two, so `a, = obj` on a method_missing mock did not destructure at all.
    // A conversion asks the object for #to_ary regardless of VISIBILITY: Ruby's
    // rb_check_funcall does not consult respond_to? for a private method, so
    // `class NilClass; private; def to_ary; [1,2]; end; end` makes `a, b = nil`
    // destructure there. `responds` deliberately hides private methods (that is
    // what `private :m` means for respond_to?), which is right for respond_to?
    // and wrong for this.
    let priv_conv = (match rv with
                     | VObj _ -> false
                     | _ ->
                       let c0 = class_name rv in
                       has_meth world c0 "to_ary" && meth_private world c0 "to_ary") in
    let can = priv_conv || (match rv with
               | VObj oid ->
                 let (m2, sp2, ocls2, iv2) = world in
                 let ocl2 = map_get ocls2 oid in
                 if has_meth world ocl2 "to_ary" then true
                 else if has_meth world ocl2 "respond_to?" then
                   truthy (invoke_val_c env world noblk rv "respond_to?" (Cons (VSym "to_ary", Nil)) false)
                 else if has_meth world ocl2 "respond_to_missing?" then
                   truthy (invoke_val_c env world noblk rv "respond_to_missing?" (Cons (VSym "to_ary", Cons (VBool false, Nil))) false)
                 else has_meth world ocl2 "method_missing"
               | _ -> responds world rv "to_ary") in
    if can then
      (match invoke_val_c env world noblk rv "to_ary" Nil false with
       | VArr id -> deref id
       | VNil -> Cons (rv, Nil)
       | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name rv ++ " to Array (" ++ class_name rv ++ "#to_ary gives " ++ class_name other ++ ")") in Nil))
    else Cons (rv, Nil)

// coerce a splatted RHS value (`= *x`) into its value list: an Array splats,
// nil becomes empty, any other object converts via #to_a (respond_to?-guarded,
// mock-aware), wrapping as [rv] when it does not respond and raising TypeError
// when #to_a returns a non-Array.
and coerce_splat_rhs = fn env -> fn world -> fn (rv: Val) ->
  match rv with
  | VArr id -> deref id
  | VNil -> Nil
  | VObj oid ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    let (m2, sp2, ocls2, iv2) = world in
    let ocl2 = map_get ocls2 oid in
    let can = (if has_meth world ocl2 "to_a" then true
               else if has_meth world ocl2 "respond_to?" then
                 truthy (invoke_val_c env world noblk rv "respond_to?" (Cons (VSym "to_a", Nil)) false)
               else false) in
    if can then
      (match invoke_val_c env world noblk rv "to_a" Nil false with
       | VArr aid -> deref aid
       | VNil -> Cons (rv, Nil)
       | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name rv ++ " to Array (" ++ class_name rv ++ "#to_a gives " ++ class_name other ++ ")") in Nil))
    else Cons (rv, Nil)
  | _ -> Cons (rv, Nil)

and assign_targets = fn env -> fn world -> fn (targets: str list) -> fn (values: Val list) ->
  if has_splat targets then
    let before = take_until_splat targets in
    let after = after_splat targets in
    let sname = splat_name targets in
    let nb = list_str_len before in
    let na = list_str_len after in
    let nv = vlen values in
    let sc = nv - nb - na in
    let sc = if sc < 0 then 0 else sc in
    let _ = assign_parallel env world before (vtake values nb) in
    let _ = assign_one env world sname (arr_new (vtake (vdrop values nb) sc)) in
    let _ = assign_parallel env world after (vdrop values (nb + sc)) in
    ()
  else assign_parallel env world targets values


// build an exception value from raise's arguments. `raise "m"` is a
// RuntimeError; `raise Cls` / `raise Cls, "m"` uses the class; `raise e`
// re-raises an existing exception.
// world-aware: when raising a class that defines its OWN initialize, build
// an instance, run initialize (so super/@message logic fires), and read the
// resulting @message. Otherwise fall back to the pure make_exc.
// `raise msg, cause: c` names the cause explicitly, and OVERRIDES the one
// that would have been recorded from $!. `cause: nil` is a deliberate "no
// cause", not an absent argument -- and ruby distinguishes the two: giving
// only a cause is an ArgumentError either way.
and make_exc_w = fn world -> fn (args: Val list) ->
  let (pos9, kw9) = peel_kw_hash args in
  if hash_haskey kw9 (VSym "cause") then
    (let cz9 = hash_get kw9 (VSym "cause") in
     match pos9 with
     | Nil -> raise_exc world "ArgumentError" "only cause is given with no arguments"
     | _ ->
       (if (match cz9 with
            | VNil -> false
            | VExc (_, _) -> false
            | VObj oid9 -> (let (_, _, ocls8, _) = world in
                            if obj_is_a world (map_get ocls8 oid9) "Exception" then false else true)
            | _ -> true)
        then raise_exc world "TypeError" "exception object expected"
        else (let base9 = make_exc_w0 world pos9 in
              // an exception is not its own cause, however it is asked for
              if rb_identical base9 cz9 then base9 else exc_set_cause world base9 cz9)))
  else make_exc_w0 world args


and make_exc_w0 = fn world -> fn (args: Val list) ->
  match args with
  | Cons (VClass c, rest) ->
    let (meths, sup, ocls, ivars) = world in
    // ⚠ INHERITED, not just its own. `raise Cls, "msg"` is `Cls.exception(msg)`
    // in ruby, so a class that inherits SystemCallError's or NameError's
    // #initialize has to run it -- `Class.new(Errno::ENOENT)` raised with a
    // message lost the "No such file or directory - " its own `.new` adds,
    // because the anonymous class has no #initialize of its OWN.
    // Exception's own is excluded on purpose: every exception class inherits
    // that one, and it does nothing the pair representation does not already
    // do. Including it would allocate an object for every raise in the program.
    let ini9 = (let a9 = lookup_anc world (ancestors_of world c) "initialize" in
                if str_eq a9 "" && map_has meths (c ++ "#initialize") then c else a9) in
    if map_has meths (c ++ "#initialize")
       || (if str_eq ini9 "" then false else (if str_eq ini9 "Exception" then false else true)) then
      // keep it as a live object so custom ivars/methods (e.g. #code) survive;
      // ensure @message is set (defaults to the class name) for #message.
      let id = alloc_oid ocls in
      let _ = map_set ocls id c in
      let noblk = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in  // shared placeholder cenv (see gc_cenv0)
      let _ = invoke world noblk (VObj id) c "initialize" rest in
      let _ = if map_has ivars (str_of_int id ++ "@message") then () else map_set ivars (str_of_int id ++ "@message") (mkstr c) in
      // whatever was in flight when this was raised becomes its cause, as ruby does
      let _ = (if map_has globals "!" then (match map_get globals "!" with
                                            | VNil -> ()
                                            | prev -> (if rb_identical prev (VObj id) then ()
                                                       else (let _ = map_set ivars (str_of_int id ++ "@__cause") prev in
                                                             match cause_bt_now prev with
                                                             | VNil -> ()
                                                             | b9 -> map_set ivars (str_of_int id ++ "@__cause_bt") b9)))
               else ()) in
      VObj id
    else exc_with_cause world (make_exc args)
  // raising an already-built exception instance (e.g. `raise Err.new(...)`) --
  // which also picks up a cause, since that is decided at the RAISE and not at
  // the construction. bundler raises this shape throughout.
  | Cons (VObj id, rest) ->
    (let (meths2, sup2, ocls2, ivars2) = world in
     let ocl = map_get ocls2 id in
     // `raise obj` / `fail obj, msg` where obj is NOT an exception: ruby calls
     // obj.exception(msg) and raises what that returns, and refuses anything
     // else with a TypeError. Without this the object's own class name became
     // the exception class, so `raise obj, "..."` reported `(sng:111)` -- an
     // internal singleton-class name, escaping into a program's output. The
     // method is usually a SINGLETON one (`def obj.exception`), which is why
     // the lookup is against the receiver's class as recorded, singleton and
     // all, rather than against its nominal class.
     // an object that is neither an exception nor answers #exception cannot be
     // raised at all: ruby says TypeError rather than inventing an exception
     // class out of the object's own class name (which is how `(sng:111)` and
     // `Object` reached a program's stderr as exception class names).
     if (if obj_is_a world ocl "Exception" then false else true)
        && (if has_meth world ocl "exception" then false else true) then
       raise_exc world "TypeError" "exception class/object expected"
     else if (if obj_is_a world ocl "Exception" then false else true)
        && has_meth world ocl "exception" then
       (let noblk = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        let r = invoke world noblk (VObj id) ocl "exception" rest in
        match r with
        | VExc (_, _) -> r
        | VObj rid ->
          (if obj_is_a world (map_get ocls2 rid) "Exception" then r
           else raise_exc world "TypeError" "exception object expected")
        | _ -> raise_exc world "TypeError" "exception object expected")
     else
       // `raise exc` is the exception itself; `raise exc, msg` is
       // exc.exception(msg) -- a COPY carrying the new message, which is the
       // same protocol as the non-exception case above and the reason ruby's
       // rule can be stated once. Going through invoke means a class that
       // overrides #exception decides.
       (let base = (match rest with
                    | Nil -> VObj id
                    | Cons (VNil, _) -> VObj id
                    | Cons (m, _) ->
                      // a class that overrides #exception decides; otherwise the
                      // copy is built here rather than through invoke, which
                      // only looks in the method table and cannot see the
                      // primitive arm that implements Exception#exception.
                      (if has_meth world ocl "exception" then
                         (let noblk = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
                          invoke world noblk (VObj id) ocl "exception" rest)
                       else
                         (let nid = alloc_oid ocls2 in
                          let _ = map_set ocls2 nid ocl in
                          let _ = map_set ivars2 (str_of_int nid ++ "@message") m in
                          let _ = (if map_has ivars2 (str_of_int id ++ "@__bt")
                                   then map_set ivars2 (str_of_int nid ++ "@__bt") (map_get ivars2 (str_of_int id ++ "@__bt")) else ()) in
                          VObj nid))) in
        let bid = (match base with VObj b -> b | _ -> id) in
        let _ = (if map_has ivars2 (str_of_int bid ++ "@__cause") then ()
                 else (if map_has globals "!"
                       then (match map_get globals "!" with
                             | VNil -> ()
                             | prev -> (if rb_identical prev base then ()
                                                       else (let _ = map_set ivars2 (str_of_int bid ++ "@__cause") prev in
                                                             match cause_bt_now prev with
                                                             | VNil -> ()
