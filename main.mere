  // #receiver are the two questions a NameError exists to answer, and every
  // other raise site fills them in. This one -- the bare name, which is where
  // most NameErrors come from -- answered nil for both.
  // A blame of VNil is "no receiver known", which is not nil BEING the
  // receiver, so the field is left off entirely (the prelude has a sentinel
  // for exactly that difference).
  let flds9 = (match blame with
               | VNil -> Cons (("__name", VSym name), Nil)
               | _ -> Cons (("__name", VSym name), Cons (("__recv", blame), Nil))) in
  match args with
  | Nil -> if explicit then raise_exc_iv world "NoMethodError" ("undefined method '" ++ name ++ "'" ++ undef_blame world blame) flds9
           else raise_exc_iv world "NameError" ("undefined local variable or method '" ++ name ++ "'" ++ undef_blame world blame) flds9
  | _ -> raise_exc_iv world "NoMethodError" ("undefined method '" ++ name ++ "'" ++ undef_blame world blame) flds9

// implicit-self send when self is a primitive: honour a subclass tag (its own
// method, then an alias-to-builtin) before the base primitive class + prims.
and prim_self_send = fn env -> fn world -> fn (other: Val) -> fn (name: str) -> fn (args: Val list) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  let hk = hng_key other in
  let tagged = if str_eq hk "" then false else map_has hng_store hk in
  let tagcls = if tagged then map_get hng_store hk else "" in
  if tagged && has_meth world tagcls name then invoke world noblk other tagcls name args
  else if tagged && (if str_eq (blt_alias_lookup world (ancestors_of world tagcls) name) "" then false else true) then
    (let src = blt_alias_lookup world (ancestors_of world tagcls) name in
     match args with
     | Cons (arg, _) -> if is_binary_op_name src then arith_bin src other arg else prim_method other src args
     | Nil -> prim_method other src args)
  else
    let cls = class_name other in
    if has_meth world cls name then invoke world noblk other cls name args
    // a plain builtin value whose class has an alias-to-builtin (e.g.
    // `class Integer; alias_method :old_plus, :+`): delegate to the source.
    else if (if str_eq (blt_alias_lookup world (ancestors_of world cls) name) "" then false else true) then
      (let src = blt_alias_lookup world (ancestors_of world cls) name in
       match args with
       | Cons (arg, _) -> if is_binary_op_name src then arith_bin src other arg else prim_method other src args
       | Nil -> prim_method other src args)
    // the FULL receiver dispatcher, not just prim_method: an implicit-self call
    // inside a builtin subclass (`gsub!` in a String subclass, `store` in a
    // Hash one) must see everything `self.name` would, and get a proper
    // NoMethodError when it really is undefined.
    else invoke_val_c env world noblk other name args false

// does the implicit self define `name` itself? A Kernel built-in must not
// outrank a method the receiver actually has.

// Kernel#`: run the command, answer its standard output. The output travels
// through a file (mere's `run` gives back only the exit status). Shared by
// the literal form and the explicit `Kernel.`(cmd)` call.

and try_self_call_x = fn env -> fn world -> fn (blame: Val) -> fn (name: str) -> fn (args: Val list) -> fn (explicit: bool) ->
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  // VNil = "blame whatever self turned out to be"; a caller that routed an
  // explicit receiver through here passes that receiver instead.
  let blamed = fn (v: Val) -> (match blame with VNil -> v | b -> b) in
  // bare method(:name) — Kernel#method on the implicit self.
  if str_eq name "method" && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
    invoke_val_c env world noblk (if lv_has env "self" then lv_get env "self" else VMain) "method" args false
  // Kernel#load -- unless the implicit self defines its own `load`, which is
  // not exotic: a YAML or JSON module calling its own load from load_file
  // would otherwise reach Kernel's and try to run the data as Ruby.
  else if str_eq name "load" && (match args with Cons (VStr _, _) -> true | _ -> false)
          && (if self_defines env world name then false else true) then
    (match args with Cons (VStr ph, _) -> rb_load env world (sget ph) | _ -> VNil)
  // `set_trace_func(proc)` installs the tracer, `set_trace_func(nil)` removes
  // it. The proc arrives as an ARGUMENT, not a block, so this is the ordinary
  // call path rather than the block-taking one.
  else if str_eq name "set_trace_func" then
    (match args with
     | Cons (VProc pid, _) ->
       (let _ = map_set trace_fn "p" (VProc pid) in
        let _ = map_set hook_flags "stf" VNil in VProc pid)
     | _ ->
       (let _ = (if map_has trace_fn "p" then map_delete trace_fn "p" else ()) in
        let _ = (if map_has hook_flags "stf" then map_delete hook_flags "stf" else ()) in VNil))
  // `trace_var(:$g) { |v| ... }` runs the block on every assignment to that
  // global; `untrace_var(:$g)` takes it off. The proc may arrive as an
  // argument or as a block, so both are accepted here.
  else if str_eq name "trace_var" then
    (match args with
     | Cons (gv, rest) ->
       (let gn = gvar_trace_name (to_s gv) in
        let pv = (match rest with Cons (VProc pid, _) -> VProc pid | _ -> VNil) in
        match pv with
        | VProc _ -> (let _ = map_set gvar_traces gn pv in
                      let _ = map_set hook_flags "gvt" VNil in VNil)
        | _ -> VNil)
     | _ -> VNil)
  else if str_eq name "untrace_var" then
    (match args with
     | Cons (gv, _) ->
       (let gn = gvar_trace_name (to_s gv) in
        let _ = (if map_has gvar_traces gn then map_delete gvar_traces gn else ()) in
        let _ = (if map_len gvar_traces == 0 && map_has hook_flags "gvt"
                 then map_delete hook_flags "gvt" else ()) in VNil)
     | _ -> VNil)
  // Kernel#exit / Kernel#abort — terminate through the native exit, running
  // the at_exit handlers first (which is the only chance they get).
  else if str_eq name "exit" then
    raise_system_exit world
      (match args with
       | Cons (VInt n, _) -> n
       | Cons (VBool b, _) -> (if b then 0 else 1)
       | _ -> 0) "exit"
  else if str_eq name "abort" then
    (let m = (match args with Cons (VStr mh, _) -> sget mh | _ -> "exit") in
     let _ = (match args with Cons (VStr mh, _) -> print_err (sget mh) | _ -> ()) in
     raise_system_exit world 1 m)
  // Kernel#sleep: inside a synchronous thread it parks the thread; on the
  // main thread it is a scheduling no-op (there is nobody to switch to).
  else if str_eq name "sleep" then
    // a NEGATIVE interval and a non-numeric one are both refusals; every
    // argument used to be accepted and slept for none of it.
    (match args with
     | Cons (VInt n9, _) ->
       (if n9 < 0 then raise_exc world "ArgumentError" "time interval must not be negative"
        else if in_thread () then raise_exc world "__ThreadPark" "sleep" else VInt 0)
     | Cons (VFlt f9, _) ->
       (if f9 < 0.0 then raise_exc world "ArgumentError" "time interval must not be negative"
        else if in_thread () then raise_exc world "__ThreadPark" "sleep" else VInt 0)
     | Cons (VNil, _) -> raise_exc world "TypeError" "can't convert nil into time interval"
     | Cons (other9, _) ->
       (match other9 with
        | VBig _ -> (if in_thread () then raise_exc world "__ThreadPark" "sleep" else VInt 0)
        | VRat (_, _) -> (if in_thread () then raise_exc world "__ThreadPark" "sleep" else VInt 0)
        // ...and ANY object that answers #divmod is a time interval to ruby:
        // that is the protocol Kernel#sleep uses to split seconds from the
        // fraction, and it was refused without being asked.
        | VObj _ ->
          (if prim_user_has world other9 "divmod"
           then (if in_thread () then raise_exc world "__ThreadPark" "sleep" else VInt 0)
           else raise_exc world "TypeError"
                  ("can't convert " ++ class_name other9 ++ " into time interval"))
        | _ -> raise_exc world "TypeError"
                 ("can't convert " ++ class_name other9 ++ " into time interval"))
     | Nil -> (if in_thread () then raise_exc world "__ThreadPark" "sleep" else VInt 0))
  // Kernel#caller / caller_locations: mere-ruby keeps no call stack, so the
  // honest answer is an empty backtrace rather than a NoMethodError. Callers
  // that log it print nothing; callers that index it get nil.
  else if str_eq name "caller" && (if map_has meths name then false else true) then
    (match caller_args env world args with
     | Nil -> arr_new (caller_frames 1)
     | Cons (a9, Cons (b9, _)) -> caller_pick2 (caller_frames 0) a9 b9
     | Cons (a9, _) -> caller_pick (caller_frames 0) a9)
  // caller_locations answers with the ONE frame mere-ruby can name honestly:
  // the file currently being executed, which for a method called from a
  // library's body IS the caller's file (there is no separate call stack).
  // There is no line tracking, so lineno is 0. Every level gets that same
  // frame -- with no stack there is nothing to distinguish them by, and a
  // caller that asks for level 3 (rubocop-ast's method definer) needs an
  // answer rather than nil. activesupport's mattr_accessor passes
  // path/lineno to module_eval.
  else if str_eq name "caller_locations" && (if map_has meths name then false else true) then
    (let skip = (match args with Cons (VInt n, _) -> n | _ -> 1) in
     let want = (match args with Cons (_, Cons (VInt m, _)) -> m | _ -> 0 - 1) in
     // a negative level or length is a refusal, not a shorter list
     if skip < 0 then raise_exc world "ArgumentError" ("negative level (" ++ str_of_int skip ++ ")")
     else if (match args with Cons (_, Cons (VInt m, _)) -> m < 0 | _ -> false)
     then raise_exc world "ArgumentError" ("negative size (" ++ str_of_int want ++ ")")
     // ...and then the SAME selection #caller uses, on the same full list, so
     // the two cannot disagree about what `(2..4)` or `(skip, length)` means.
     // ⚠ caller_pick2 is the two-argument one. Routing the integer form
     //   through the one-argument caller_pick dropped the length in silence
     //   and corpus/153 went from [false] to [false, false]; reverting the
     //   whole integer path then lost the nil-past-the-end rule with it. Both
     //   belong to the same selection, which is why there is one function for
     //   it and not a special case per argument shape.
     else (match caller_args env world args with
           | Cons (a9, Cons (b9, _)) -> caller_pick2 (caller_locs world 0 (0 - 1)) a9 b9
           | Cons (a9, _) -> caller_pick (caller_locs world 0 (0 - 1)) a9
           | Nil -> arr_new (caller_locs world 1 (0 - 1))))
  // Kernel#rand: a Float in [0, 1) with no argument, an Integer in [0, n)
  // with a positive one, and a member of a Range.
  else if (str_eq name "rand" || str_eq name "srand") && (if map_has meths name then false else true) then
    // ⚠ rand's argument goes through #to_int: `rand(obj)` is `rand(obj.to_int)`
    //   and an object one made rand answer a Float (the no-argument form),
    //   which is what core/kernel/rand_spec asks about.
    (if str_eq name "srand" then srand_val env world args else rand_val world (coerce_int_args env world args))
  // Kernel#fork is not implemented (no process extern) — Ruby's own
  // NotImplementedError contract for platforms without fork.
  else if str_eq name "fork" then
    raise_exc world "NotImplementedError" "fork() function is unimplemented on this machine"
  // `@@x ||= v`'s read: the class variable's value, or nil when it has never
  // been assigned (a bare read of an undefined class variable is a NameError).
  else if str_eq name "__cvar_or_nil" && (match args with Cons (VStr _, _) -> true | _ -> false) then
    (match args with
     | Cons (VStr nh, _) ->
       (let cn = sget nh in
        let cls0 = cvar_cls env world in
        if str_eq cls0 "" then VNil
        else if cvar_defined_from world cls0 cn then cvar_get_from world cls0 cn
        else VNil)
     | _ -> VNil)
  // the loader itself, reachable only through the default Kernel#require (and
  // through any alias of it — which is how RubyGems keeps the original around
  // while replacing `require`).
  // the body of Module#const_missing: raise with ruby's message, which names
  // the receiver unless it is Object.
  // the body of SystemCallError#initialize: an Errno class's message is the
  // system's own text (errno_message), which is what `raise Errno::EINVAL`
  // already produced -- the constructor now asks the same function instead of
  // falling back to the class name. `self` is the exception being built, so its
  // CLASS is the Errno name.
  else if str_eq name "__errno_message" then
    (match args with
     | Cons (slf, Cons (m, rest9)) ->
       (let (m9, s9, ocls9, i9) = world in
        let c = (match slf with VObj oid -> map_get ocls9 oid | other -> class_name other) in
        // ⚠ the MESSAGE is a String, nil, or something with #to_str -- and
        // anything else is a TypeError, not its #to_s. `Errno::ENOENT.new(:foo)`
        // read "foo" as the message and `SystemCallError.new(5, 1)` read "5",
        // where ruby refuses both by name. This is the one place both the
        // SystemCallError and the Errno::X constructors pass through.
        let m = (match m with
                 | VStr h9 -> VStr h9
                 | VNil -> VNil
                 | other9 ->
                   (match conv_try env world other9 "to_str" with
                    | VStr h9 -> VStr h9
                    | _ -> (let _ = raise_exc world "TypeError"
                              ("no implicit conversion of "
                               ++ display_cls_msg world (dispatch_cls_of world other9)
                               ++ " into String") in VNil))) in
        let has = (match m with VNil -> false | _ -> true) in
        let given = (match m with VStr h -> sget h | VNil -> "" | other -> to_s other) in
        // a STRING second argument is the LOCATION ruby names in the message
        // ("Invalid argument @ location - custom message"); an integer one is
        // the errno, which picked the class before this ran.
        // the location may arrive as the second argument (an Errno class's
        // `new(msg, loc)`) or the third (`SystemCallError.new(msg, errno,
        // loc)`) -- it is the first String among them either way.
        // ...and a location that is not a String is PRINTED (ruby to_s's it:
        // `SystemCallError.new("foo", 1, :sym)` reads "@ sym"), which is why
        // only a String was recognised and every other kind was dropped.
        let loc = (match rest9 with
                   | Cons (VStr lh, _) -> sget lh
                   | Cons (_, Cons (VStr lh, _)) -> sget lh
                   | Cons (VInt _, Cons (v9, _)) -> (match v9 with VNil -> "" | _ -> to_s v9)
                   | Cons (VBig _, Cons (v9, _)) -> (match v9 with VNil -> "" | _ -> to_s v9)
                   | Cons (VFlt _, Cons (v9, _)) -> (match v9 with VNil -> "" | _ -> to_s v9)
                   | Cons (VNil, Cons (v9, _)) -> (match v9 with VNil -> "" | _ -> to_s v9)
                   | _ -> "") in
        // ...and a SUBCLASS of an Errno class inherits its text: the class
        // name is the anonymous subclass's, so walk up to the Errno ancestor.
        // ⚠ keep the ORIGINAL name: errno_ancestor_of answers "" for
        //   SystemCallError itself, and the branch below that writes its
        //   message tested the REWRITTEN name -- so an unknown errno fell all
        //   the way through to "the message as given".
        let c0 = c in
        let c = (if str_len c > 7 && str_eq (substring c 0 7) "Errno::" then c
                 else errno_ancestor_of world c) in
        if str_len c > 7 && str_eq (substring c 0 7) "Errno::"
        then mkstr (if str_eq loc "" then errno_message c given has
                    else errno_desc (substring c 7 (str_len c)) ++ " @ " ++ loc
                         ++ (if has then " - " ++ given else ""))
        // the base class is not an errno: ruby still prefixes it, with the
        // text it uses when it has no number to look up -- "unknown error"
        // when no number was given at all, and "Unknown error: N" (capital,
        // with the number) when the number names no errno. The location goes
        // in the same place either way.
        else if str_eq c "SystemCallError" || str_eq c0 "SystemCallError" then
          (let n9 = (match rest9 with
                     | Cons (VInt k9, _) -> "Unknown error: " ++ str_of_int k9
                     | _ -> "unknown error") in
           let head9 = n9 ++ (if str_eq loc "" then "" else " @ " ++ loc) in
           if has then mkstr (head9 ++ " - " ++ given)
           else if (match rest9 with Cons (VInt _, _) -> true | _ -> false) then mkstr head9
           else VNil)
        else (if has then mkstr given else VNil))
     | _ -> VNil)
  // Errno::X#errno -- the platform's number for the class this exception is.
  // SignalException.new(2) / .new("INT"): the exception carries the signal's
  // number and its "SIG"-prefixed name, and #signo / #signm read them back.
  // The class existed with no constructor of its own, so both were undefined.
  // the default for SystemCallError#initialize's first parameter: reaching it
  // means no argument was given, which ruby refuses.
  else if str_eq name "__sce_no_arg" then
    // ...only for SystemCallError ITSELF: `Errno::ENOENT.new` needs no
    // argument (its class already names the error), and the default fires for
    // every subclass too.
    (match args with
     | Cons (slf9, _) ->
       (let (_, _, ocls9, _) = world in
        let c9 = (match slf9 with VObj oid9 -> map_get ocls9 oid9 | other9 -> class_name other9) in
        if str_eq c9 "SystemCallError"
        then raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1..3)"
        else VNil)
     | Nil -> VNil)
  else if str_eq name "__signal_pair" then
    (match args with
     | Cons (v9, _) ->
       (let (num9, nm9) =
          (match v9 with
           | VInt k9 -> (k9, signal_name_of k9)
           | VStr h9 -> (let raw9 = sget h9 in
                         let short9 = (if str_len raw9 > 3 && str_eq (substring raw9 0 3) "SIG"
                                       then substring raw9 3 (str_len raw9) else raw9) in
                         (signal_num_of short9, short9))
           | VSym sy9 -> (let short9 = (if str_len sy9 > 3 && str_eq (substring sy9 0 3) "SIG"
                                        then substring sy9 3 (str_len sy9) else sy9) in
                          (signal_num_of short9, short9))
           | _ -> (0, "")) in
        // ⚠ A name or number nothing claims is REFUSED: ruby says
        // "unsupported signal 'SIGNOPE'" / "invalid signal number (1000)".
        // signal_num_of answers 0 for an unknown name and signal_name_of "" for
        // an unknown number, and both were handed back as an answer -- so
        // `SignalException.new("NOPE")` built one whose signo was 0 and whose
        // message was "SIGNOPE", a signal that does not exist.
        let _ = (match v9 with
                 | VInt k9 -> (if str_eq nm9 "" || num9 == 0
                               then (let _ = raise_exc world "ArgumentError"
                                       ("invalid signal number (" ++ str_of_int k9 ++ ")") in ())
                               else ())
                 | _ -> (if num9 == 0
                         then (let _ = raise_exc world "ArgumentError"
                                 ("unsupported signal 'SIG" ++ nm9 ++ "'") in ())
                         else ())) in
        arr_new (Cons (VInt num9, Cons (mkstr ("SIG" ++ nm9), Nil))))
     | Nil -> arr_new (Cons (VInt 0, Cons (mkstr "", Nil))))
  else if str_eq name "__errno_number" then
    (match args with
     // an integer the constructor was given wins; anything else (a location
     // string, nil) means the class decides.
     | Cons (_, Cons (VInt k9, _)) -> VInt k9
     | Cons (slf, _) ->
       (let (m9, s9, ocls9, i9) = world in
        let c = (match slf with VObj oid -> map_get ocls9 oid | VClass cc -> cc | other -> class_name other) in
        let _ = errno_build () in
        let short = (if str_len c > 7 && str_eq (substring c 0 7) "Errno::" then substring c 7 (str_len c) else c) in
        if map_has errno_num_tbl short then VInt (map_get errno_num_tbl short) else VNil)
     | _ -> VNil)
  // `SystemCallError.new(msg, 2)` IS an Errno::ENOENT: the number picks the
  // class, and a number nothing claims stays a SystemCallError.
  else if str_eq name "__errno_class_for" then
    (match args with
     | Cons (nv, _) ->
       (let _ = errno_build () in
        match nv with
        | VInt k -> (if map_has errno_by_num (str_of_int k)
                     then VClass ("Errno::" ++ map_get errno_by_num (str_of_int k))
                     else VClass "SystemCallError")
        | _ -> VClass "SystemCallError")
     | _ -> VClass "SystemCallError")
  else if str_eq name "__const_missing_raise" then
    (match args with
     | Cons (owner, Cons (cn, _)) ->
       let n = (match cn with VSym sy -> sy | VStr h -> sget h | _ -> to_s cn) in
       let oc = (match owner with VClass c2 -> c2 | _ -> "Object") in
       raise_exc world "NameError"
         ("uninitialized constant " ++ (if str_eq oc "Object" then n else oc ++ "::" ++ n))
     | _ -> VNil)
  // The path a `require_relative` written in <file> names: its sibling, made
  // absolute. A path that is already absolute is itself (ruby resolves one that
  // way too).
  else if str_eq name "__builtin_relpath" && (match args with Cons (VStr _, Cons (_, _)) -> true | _ -> false) then
    (match args with
     | Cons (VStr fh, Cons (pv, _)) ->
       // ⚠ the fourth door. `to_s` on a non-String turned `require_relative(42)`
       //   into the path "42" and a LoadError; ruby refuses with TypeError
       //   before it ever looks at the filesystem.
       (let p = require_path_of env world pv in
        if str_eq p "" then VNil else
        if str_len p > 0 && str_eq (char_at p 0) "/" then mkstr p
        else (let d0 = dirname_of (sget fh) in
              let d = (if str_len d0 > 0 && str_eq (char_at d0 0) "/" then d0
                       else if str_eq d0 "." then env_get "PWD"
                       else env_get "PWD" ++ "/" ++ d0) in
              mkstr (d ++ "/" ++ p)))
     | _ -> VNil)
  else if (str_eq name "__builtin_require" || str_eq name "__builtin_require_relative") &&
          (match args with Cons (_, _) -> true | _ -> false) then
    (match args with
     | Cons (a9, _) ->
       (let ph9 = require_path_of env world a9 in
        if str_eq ph9 "" then VNil
        else match do_require env world noblk (str_eq name "__builtin_require_relative") ph9 with
        | FNext v -> v
        | _ -> VNil)
     | _ -> VNil)
  // expression-position require("x") / require_relative("x") (the statement
  // forms parse as SRequire; parenthesized calls arrive here).
  else if (str_eq name "require" || str_eq name "require_relative") && (match args with Cons (_, _) -> true | _ -> false) then
    (match args with
     | Cons (a8, _) ->
       (let ph = require_path_of env world a8 in
        if str_eq ph "" then VNil else
        match exec_stmt env world noblk (SRequire (str_eq name "require_relative", EStrL ph)) with
        | FNext v -> v
        | FRaise _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")
        | _ -> VNil)
     | _ -> VNil)
  else
  if lv_has env "self" then
    (match lv_get env "self" with
     | VObj id ->
       let cls = map_get ocls id in
       if has_meth world cls name then invoke world noblk (VObj id) cls name args
       // the string form of instance_eval/instance_exec on an object self
       // (e.g. inside an instance_exec block) routes to the prim dispatcher,
       // exactly like the VMain special case below.
       else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false)
       then invoke_val_c env world noblk (VObj id) name args false
       // a bare call to an Enumerable-mixin method or a universal primitive
       // (instance_variable_get, send, methods, ...) with implicit self routes
       // through the receiver dispatcher, exactly as self.name would, and
       // ahead of method_missing since a real method wins.
       else if is_enum_method name || is_prim_method name then invoke_val_c env world noblk (VObj id) name args false
       else if has_meth world cls "method_missing" then invoke world noblk (VObj id) cls "method_missing" (Cons (VSym name, args))
       else undef_call_exc_x world (blamed (VObj id)) name args explicit
     // top-level self is main (an Object); route the string form of
     // instance_eval/instance_exec to the prim dispatcher (self stays main).
     | VMain ->
       if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false)
       then dispatch_prim env world noblk VMain name args false
       // main IS an Object, so a method added by reopening Object — or Kernel,
       // which Object includes — is callable bare here, exactly as a
       // top-level `def` is. Libraries add their conversion functions that way
       // (`Kernel#Pathname`, `Kernel#Rainbow`).
       else if has_meth world "Object" name then invoke world noblk VMain "Object" name args
       else if has_meth world "Kernel" name then invoke world noblk VMain "Kernel" name args
       // the top-level self answers respond_to? like any other object; this
       // branch went to dispatch_prim, which has no arm for it.
       else if str_eq name "respond_to?" then respond_to_answer env world VMain args
       // a universal primitive (instance_variable_get, frozen?, send, ...)
       // with an implicit self at the top level, exactly as `self.name` would
       else if is_prim_method name then dispatch_prim env world noblk VMain name args false
       else undef_call_exc_x world (blamed VMain) name args explicit
     | VClass c ->
       // a `def self.new` outranks the built-in allocation here exactly as it
       // does for an explicit receiver -- a bare `new` inside another class
       // method must reach it (Date.parse builds its result that way).
       if str_eq name "new" && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then new_obj world c args
       else if has_meth world ("(sng:" ++ c ++ ")") name then invoke world noblk (VClass c) ("(sng:" ++ c ++ ")") name args
       // a bare call inside a class/module body (self is the class) routes
       // through the receiver dispatcher so builtins like module_eval/class_eval
       // apply; invoke_val_c raises NoMethodError itself if truly undefined.
       else invoke_val_c env world noblk (VClass c) name args false
     | other -> prim_self_send env world other name args)
  else undef_call_exc_x world (blamed VMain) name args explicit

// implicit-self method call (a method calling a sibling method).
// does the current self's class define this method? The stdin builtins (gets /
// readline / readlines) must not shadow an object's own method of that name —
// a StringIO defines all three.
// Kernel#rand / Random.rand. No argument (or 0) is a Float in [0, 1); a
// positive Integer n is an Integer in [0, n); a Range picks one of its values.
// srand(n): seed generator 0 and answer the seed it had BEFORE -- which is what
// makes `srand(srand)` restore a run. Without an argument ruby picks its own.
and srand_val = fn env -> fn world -> fn (args: Val list) ->
  // ⚠ the seed is answered back EXACTLY as it was given -- a bignum, a
  // negative, the #to_int of a Float -- while only its MAGNITUDE seeds the
  // generator. Storing the 32 bits that seeded it and answering those made
  // `srand(0x12345678901234567890)` report 4294967295.
  (let _ = (if map_has mt_seed_of "0" then ()
            else (let _ = map_set mt_seed_of "0" (str_of_int (random_int 1000000000 + 1)) in ())) in
   let prev = norm_big (map_get mt_seed_of "0") in
   let sv = (match args with
             | Nil -> VInt (random_int 1000000000 + 1)
             | Cons (v9, _) -> shift_width_v env world v9) in
   let mag = (match sv with
              | VInt k9 -> str_of_int (if k9 < 0 then 0 - k9 else k9)
              | VBig b9 -> big_mag b9
              | _ -> "0") in
   let _ = mt_seed_from 0 mag in
   let _ = map_set mt_seed_of "0" (to_s sv) in
   prev)

and self_defines = fn env -> fn world -> fn (name: str) ->
  if lv_has env "self" then
    (match lv_get env "self" with
     | VObj id -> (let (_, _, ocls0, _) = world in has_meth world (map_get ocls0 id) name)
     | VClass c -> has_meth world ("(sng:" ++ c ++ ")") name
     | _ -> false)
  else false

and try_self_call = fn env -> fn world -> fn (blame: Val) -> fn (name: str) -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  let blamed = fn (v: Val) -> (match blame with VNil -> v | b -> b) in
  if str_eq name "method" && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
    invoke_val_c env world noblk (if lv_has env "self" then lv_get env "self" else VMain) "method" args false
  else
  if lv_has env "self" then
    (match lv_get env "self" with
     | VObj id ->
       let cls = map_get ocls id in
       if has_meth world cls name then invoke world noblk (VObj id) cls name args
       // an Enumerable-mixin method (map/count/inject/...) or a name the
       // object responds to (method_missing) with implicit self routes through
       // the receiver dispatcher, exactly as `self.name` would; a genuinely
       // undefined bare name still raises NameError.
       // ⚠ a PRIMITIVE is reached whatever the object's own #respond_to? says.
       //   This asked `responds`, which CALLS a user-defined respond_to? -- so
       //   a class that redefines it (every mock does) turned a bare
       //   `singleton_class` into "undefined local variable or method" for a
       //   method it has. The with-arguments path next door asks
       //   is_prim_method; two paths, two rules, and only one of them right.
       else if is_enum_method name || is_prim_method name || responds world (VObj id) name then invoke_val_c env world noblk (VObj id) name args false
       // a synthetic class's methods live in the primitive dispatcher, not the
       // method table, so an implicit-self call inside a reopened Time (or
       // MatchData, ...) has to be routed there too.
       else if str_eq (display_cls world cls) "Time" || str_eq cls "MatchData" then invoke_val_c env world noblk (VObj id) name args false
       else undef_call_exc world (blamed (VObj id)) name args
     | VMain ->
       if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false)
       then dispatch_prim env world noblk VMain name args false
       // main IS an Object: a method added by reopening Object or Kernel is
       // callable bare, and so is a universal primitive.
       else if has_meth world "Object" name then invoke world noblk VMain "Object" name args
       else if has_meth world "Kernel" name then invoke world noblk VMain "Kernel" name args
       else if is_prim_method name then dispatch_prim env world noblk VMain name args false
       else undef_call_exc world (blamed VMain) name args
     | VClass c ->
       // class-level self (class << self body / class methods): route through
       // the receiver dispatcher so class/module builtins (name, constants,
       // module_eval, ...) resolve; invoke_val_c raises if truly undefined.
       // a `def self.new` outranks the built-in allocation here exactly as it
       // does for an explicit receiver -- a bare `new` inside another class
       // method must reach it (Date.parse builds its result that way).
       if str_eq name "new" && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then new_obj world c args
       else if has_meth world ("(sng:" ++ c ++ ")") name then invoke world noblk (VClass c) ("(sng:" ++ c ++ ")") name args
       else invoke_val_c env world noblk (VClass c) name args false
     | other ->
       // primitive self (a reopened built-in class's method body): user
       // methods first, then the built-in prims (implicit-self upcase etc.).
       prim_self_send env world other name args)
  else undef_call_exc world (blamed VMain) name args

// top-level method call: fresh frame, no self; blk is installed for yield.
and call_method = fn env -> fn world -> fn blk -> fn (name: str) -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  (match map_get meths name with
   | Meth (params, defaults, body) ->
     // a top-level `define_method` is a CLOSURE: its body reads the locals of
     // the scope it was written in, so the frame is a child of that scope
     // rather than a fresh one. (run_meth does the same for a class's.)
    let from_pool = (if map_has dm_closenv name then false else true) in
     let frame = (if map_has dm_closenv name then
                    (match map_get dm_closenv name with
                     | VProc pid -> (match map_get proc_store (str_of_int pid) with (_, _, _, cenv) -> lv_child cenv)
                     | _ -> frame_pool_get ())
                  else frame_pool_get ()) in
     let _ = map_set frame "__fid" (VInt (next_fid ())) in
     let _ = map_set frame "__meth" (mkstr name) in
     // Whether THIS call was given a block. `block_given?` asks about the
     // enclosing METHOD frame, and Ruby's rule reaches it through any number
     // of blocks -- `m { }` with `def m; [1].each { block_given? }; end` is
     // true, because the block asks about m. Reading the `blk` threaded
     // through evaluation answered about the innermost block call instead.
     let _ = map_set frame "__has_blk" (VBool (match blk with (true, _, _, _) -> true | _ -> false)) in
     // top-level methods run with main as self (their @ivars live there).
     let _ = map_set frame "self" (if lv_has env "self" then lv_get env "self" else VMain) in
     let _ = map_set frame "__cref" (mkstr (if map_has meth_cref name then map_get meth_cref name else "")) in
     let _ = bind_params frame world blk name params defaults args in
     // a top-level method is a frame too, so `$~` is scoped to it as well.
     let mstate = rx_state_save () in
     let _ = fire_trace world "call" name "Object" in
     let _ = fire_tp world "call" name "Object" in
     let out = (match method_body_flow frame world blk body with FNext v -> v | FReturn v -> v | FRaise v -> v | FBreak v -> v | FLoopNext v -> v) in
    // the frame dies here unless something captured it (or its chain):
    // recycled and pooled, its arena wound back to the warm seed. Safe on
    // every exit path -- method_body_flow converts raises to Flow values,
    // so this line always runs.
    let _ = (if from_pool && (if map_has frame "__captured" then false else true)
             then frame_pool_put frame else ()) in
     let _ = fire_trace world "return" name "Object" in
     let _ = fire_tp world "return" name "Object" in
     let _ = rx_state_restore mstate in
     out)

// class-variable helpers: the owning class is self's class (or the class
// itself in a class body); reads walk the superclass chain.


// a class variable defined both in the nearest owning class and in a strict
// ancestor of it is "overtaken" — reading it is a RuntimeError in Ruby.





// is `cls` the class `target` or a descendant of it? (plus universal roots)
and obj_is_a = fn world -> fn (cls: str) -> fn (target: str) ->
  // membership in the full ancestor chain, which unlike the bare `sup` chain
  // also counts included modules (Comparable, Enumerable, Kernel, ...), so
  // is_a?/kind_of? agree with Module#ancestors.
  str_eq cls target || str_eq target "Object" || str_eq target "BasicObject"
  || pp_mem (ancestors_of world cls) target

// walk the ancestor chain: does `cls` (or a superclass) define `name`?
// The Kernel module functions this interpreter implements as implicit-self
// CALLS, so `Kernel.format` can be answered by evaluating `format`. The ones
// the parser turns into statements are NOT here: `raise` and `require` have
// their own receiver-dispatch path already, and routing them through a call
// would undo it. `puts` is a statement too and is special-cased at the call
// site, since it had no module-method form at all.

// The names Kernel provides, as a LIST rather than a predicate, because two
// callers need them two different ways: the dispatch path asks "is this one of
// them" and `Kernel.private_instance_methods` has to ENUMERATE them. A
// predicate cannot be enumerated, and a second hand-written list would drift
// from this one, so the predicate is defined in terms of the list.
// Kernel's PUBLIC instance methods (Object's, in other words): every object
// answers them, and `Kernel.public_instance_methods(false)` lists them.

// ...and Kernel's PRIVATE instance methods: the module functions, which every
// object can call without a receiver. A name missing from this list is missing
// from FOUR answers at once (private_instance_methods, public_methods,
// Kernel's own respond_to?, and the enumeration behind `methods`), which is
// why there is one list rather than a check per door.


// ...and the public half, as a membership test. Kernel's PUBLIC instance
// methods are answered by every object, module objects included, which is what
// makes `Kernel.method(:respond_to?)` a Method owned by Kernel.
// Kernel's private instance methods that are NOT module functions. The one
// list holds both (module_function makes a name both at once), but these four
// are only the instance half: every object answers them, and `Kernel.foo` is
// not one of them.



// is `name` callable here — a top-level method, or a method on self's class?
and is_method_defined = fn env -> fn world -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has meths name then true
  else if lv_has env "self" then
    (match lv_get env "self" with
     | VObj id -> has_meth world (map_get ocls id) name
     | _ -> false)
  else false

// does the current self define `name` as a user method (so it shadows a
// Kernel private method of the same name, per Ruby's method lookup)?
and self_user_defines = fn env -> fn world -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  match (if lv_has env "self" then lv_get env "self" else VMain) with
  | VObj oid -> has_meth world (map_get ocls oid) name
  | VClass c -> has_meth world ("(sng:" ++ c ++ ")") name
  | VMain -> map_has meths name
  | other -> has_meth world (class_name other) name

// Does THIS class define the method itself? `has_meth` answers "can it be
// called", which walks prepends, includes and the superclass chain -- two
// different questions that were sharing one answer. A hook like #const_missing
// has to be the class's own: the chain always ends at a builtin one, so asking
// has_meth means "yes" for every class in the program.

// Is `name` UNREACHABLE on cls because someone undef'd it? The tombstone the
// `undef` statement writes only kept the method out of the user table, so
// `undef :to_s` still reached the BUILTIN to_s and printed #<A:0x..>. Walk the
// ancestors and stop at whichever comes first: a definition (still reachable)
// or a tombstone (gone, builtin included). Nothing is walked at all until the
// program undefs something, so the usual dispatch pays one map_len.
and undef_blocked = fn world -> fn (cls: str) -> fn (name: str) ->
  if map_len undefs == 0 then false
  else if str_eq cls "" then false
  else undef_blocked_anc world (ancestors_of world cls) name


and has_meth = fn world -> fn (cls: str) -> fn (name: str) ->
  // see hm_memo in m_state.mere: the walk below is 26% of a dispatch-heavy
  // profile and answers the same (class, name) pairs over and over.
  if (if mro_cache_on () then false else true) then has_meth_b world cls name false
  else
    let g = mro_now () in
    let k = cls ++ "#" ++ name in
    if map_has hm_memo_gen k && map_get hm_memo_gen k == g then map_get hm_memo k
    else
      (let r = has_meth_b world cls name false in
       let _ = map_set hm_memo k r in
       let _ = map_set hm_memo_gen k g in
       r)

// `blocked` = the walk has already passed a class that owns this name as a
// BUILTIN. Builtins have no `meths` entry, so the ancestor walk cannot see
// them, and a user method installed on the ROOT used to win over the
// subclass's own primitive: `class Object; def size; 99; end; end` made
// [1,2].size, {a: 1}.size, "ab".size and 5.size all answer 99.
// ⚠ only a ROOT entry loses. The per-class lists are REFLECTION lists -- they
//   name methods the prelude implements on an included module too (Array's
//   names include Enumerable#slice_before, which no primitive answers), so
//   refusing every blocked name made those undefined. A module found on the
//   way (includes_has, below) is checked before the block is even set.
and has_meth_b = fn world -> fn (cls: str) -> fn (name: str) -> fn (blocked: bool) ->
  let (meths, sup, ocls, ivars) = world in
  let root = str_eq cls "Object" || str_eq cls "BasicObject" || str_eq cls "Kernel" in
  if str_eq cls "" then false
  else
  // ⚠ ONE key per ancestor level, not two. `cls ++ "#" ++ name` was built for
  // the undefs probe and again for the meths probe, at EVERY level of the
  // walk -- and this walk runs on the way to every method call, so a
  // three-deep chain built six strings per dispatch. `undefs` is empty in
  // almost every program, and asking its size is free, so that probe usually
  // does not happen at all.
  let mk = cls ++ "#" ++ name in
  if map_len undefs > 0 && map_has undefs mk then false   // undef'd here: blocked
  else if prepends_has world cls name then true
  else if map_has meths mk then (if blocked && root then false else true)
  else if includes_has world cls name then (if blocked && root then false else true)
  else
  let blocked = blocked || builtin_owns_here cls name in
  if map_has sup cls then has_meth_b world (map_get sup cls) name blocked
  else if is_sng_cls cls then has_meth_b world (sng_supername world cls) name blocked
  // every class without a declared superclass inherits from Object; the ROOT
  // is BasicObject (Object -> BasicObject by default), so a reopen of the
  // form `class Object < BasicObject` (pp.rb does exactly this) writes a sup
  // entry that agrees with the default chain instead of forming a cycle with
  // it. The old terminal knew only "Object", and that reopen made every
  // lookup walk Object -> BasicObject -> Object forever -- 64 GB of arena in
  // one method call.
  else if str_eq cls "BasicObject" then false
  else if str_eq cls "Object" then has_meth_b world "BasicObject" name blocked
  else has_meth_b world "Object" name blocked

// does any module `include`d into `cls` define `name` as an instance method?
// A module can `include` another module (concurrent-ruby's Concern::Obligation
// includes Concern::Dereferenceable), and the class that includes the OUTER one
// gets both -- so the search has to walk each module's own includes, not just
// the names listed on the class. That is the list `ancestors` already reports.
and cls_mod_ancestors = fn world -> fn (cls: str) ->
  let g = mro_now () in
  if mro_cache_on () && map_has mro_mods_gen cls && map_get mro_mods_gen cls == g
  then map_get mro_mods cls
  else
    (let r = (if map_has includes cls then expand_mods world (str_split (map_get includes cls) "|") else Nil) in
     let _ = (if mro_cache_on () then
                (let _ = map_set mro_mods cls r in map_set mro_mods_gen cls g)
              else ()) in
     r)

// the memo is on unless the environment turns it off (see mro_gen).

and prepends_has = fn world -> fn (cls: str) -> fn (name: str) ->
  if map_has prepends cls
  then any_mod_has world (expand_mods world (str_split (map_get prepends cls) "|")) name
  else false

and includes_has = fn world -> fn (cls: str) -> fn (name: str) ->
  if map_has includes cls then any_mod_has world (cls_mod_ancestors world cls) name else false



and lookup_meth = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  if map_has meths (cls ++ "#" ++ name) then map_get meths (cls ++ "#" ++ name)
  else if includes_has world cls name then mod_lookup world (cls_mod_ancestors world cls) name
  else if map_has sup cls then lookup_meth world (map_get sup cls) name
  else if is_sng_cls cls then lookup_meth world (sng_supername world cls) name
  else if str_eq cls "BasicObject" then (let __fm = ("mere-ruby: undefined method '" ++ name ++ "'") in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  else if str_eq cls "Object" then lookup_meth world "BasicObject" name
  else lookup_meth world "Object" name

// like lookup_meth but also returns the class the method was found in, so
// `super` can resume the lookup from that class's superclass.
and lookup_meth_cls = fn world -> fn (cls: str) -> fn (name: str) ->
  let (meths, sup, ocls, ivars) = world in
  // resolve along the linearized ancestor chain so the returned defining class
  // is the actual module/class the method lives in (super resumes from there).
  let a = lookup_anc world (ancestors_of world cls) name in
  if str_eq a "" then (let __fm = ("mere-ruby: undefined method '" ++ name ++ "'") in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)
  else (map_get meths (a ++ "#" ++ name), a)

// invoke an instance method: fresh frame binding self + params; blk is the
// block passed at the call site (installed for yield inside the body).
and invoke = fn world -> fn blk -> fn (recv: Val) -> fn (cls: str) -> fn (name: str) -> fn (args: Val list) ->
  let (m, defcls) = lookup_meth_cls world cls name in
  run_meth world blk recv defcls name m args

// remember the closure (env-carrying block) behind a define_method, so the
// defined method body can read the locals captured where it was defined.

// run a resolved method with __defcls set to the ancestor it was found in (so
// a bare `super` resumes from the right point in the receiver's chain).
and run_meth = fn world -> fn blk -> fn (recv: Val) -> fn (defcls: str) -> fn (name: str) -> fn (m: Meth) -> fn (args: Val list) ->
  match m with
  | Meth (params, defaults, body) ->
    // ⚠ ONE key for the whole body. `defcls ++ "#" ++ name` is how six
    // different side tables are addressed here (dm_captured, dm_closenv,
    // dm_had_blk, alias_origin, alias_srcname, meth_cref) and it was rebuilt
    // at EVERY probe -- thirteen identical strings per method call, on the
    // function that runs one.
    let dk = defcls ++ "#" ++ name in
    // a method defined via define_method yields to the block captured at
    // definition time when the call site itself passes no block.
    let blk = (match blk with
               | (true, _, _, _) -> blk
               | _ -> if map_has dm_captured dk
                      then (match map_get dm_captured dk with VProc pid -> map_get proc_store (str_of_int pid) | _ -> blk)
                      else blk) in
    // a define_method body is a closure: its frame is a CHILD of the scope the
    // block was written in, so the body reads those locals -- and writes reach
    // them, which copying the values in could not do (`define_method(:bump) {
    // counter += 1 }` has to increment the caller's counter, not a copy that
    // is thrown away after every call). The method's own self / args / params
    // are set below and shadow anything of the same name.
    // the plain frame comes from the pool (returned at the restore point
    // below unless captured); a define_method body's frame is a scope-chain
    // child and stays unpooled -- its parent chain is captured by definition.
    let from_pool = (if map_has dm_closenv dk then false else true) in
    let frame = (if map_has dm_closenv dk then
                   (match map_get dm_closenv dk with
                    | VProc pid -> (match map_get proc_store (str_of_int pid) with (_, _, _, cenv) -> lv_child cenv)
                    | _ -> frame_pool_get ())
                 else frame_pool_get ()) in
    let _ = map_set frame "__fid" (VInt (next_fid ())) in
    // A body that came from define_method is a BLOCK, and a block's
    // `block_given?` asks about the frame it was written in -- never about the
    // call that reached the method. `C.new.dm { }` answered true here where
    // Ruby answers false; `yield` inside such a body is not even legal Ruby
    // (it is a SyntaxError), and `|&b|` still receives the caller's block,
    // which is the supported way to take one.
    let _ = (if map_has dm_closenv dk
             then map_set frame "__in_dm"
                    (if map_has dm_had_blk dk
                     then map_get dm_had_blk dk else VBool false)
             else ()) in
    let _ = map_set frame "self" recv in
    // a method body has no instance_eval definee in force: its `def` goes to
    // self's class. A define_method frame is a scope-chain CHILD, so without
    // this it would read the defining block's definee through the chain.
    let _ = map_set frame "__definee_recv" VNil in
    let _ = map_set frame "__definee_cls" VNil in
    // hidden bindings so `super` can resume lookup above the defining class.
    // an aliased method resumes above its ORIGIN, not above the aliasing class.
    let dc = if map_has alias_origin dk
             then (match map_get alias_origin dk with s -> s)
             else defcls in
    let mnm = if map_has alias_srcname dk
              then (match map_get alias_srcname dk with s -> s)
              else name in
    let _ = map_set frame "__defcls" (VClass dc) in
    let _ = map_set frame "__meth" (mkstr mnm) in
    // __callee__ answers the name the method was CALLED by; only an alias
    // makes it differ from __meth (the name it was defined under).
    let _ = (if str_eq mnm name then () else map_set frame "__callee" (mkstr name)) in
    // Whether THIS call was given a block. `block_given?` asks about the
    // enclosing METHOD frame, and Ruby's rule reaches it through any number
    // of blocks -- `m { }` with `def m; [1].each { block_given? }; end` is
    // true, because the block asks about m. Reading the `blk` threaded
    // through evaluation answered about the innermost block call instead.
    let _ = map_set frame "__has_blk" (VBool (match blk with (true, _, _, _) -> true | _ -> false)) in
    // lexical scope (cref) for bare-constant resolution in the body.
    let _ = map_set frame "__cref" (mkstr (if map_has meth_cref dk then map_get meth_cref dk else "")) in
    let _ = map_set frame "__args" (arr_new args) in
    let _ = map_set frame "__params" (arr_new (param_names_vals params)) in
    let _ = bind_params frame world blk name params defaults args in
    // `$~` (and with it $1..$9, $&, $`, $') belongs to the frame that matched:
    // ruby makes a method's match invisible to its caller, and the caller's
    // invisible to the method. A block is NOT a frame here -- it shares the
    // method's, which is ruby's rule too.
    let mstate = rx_state_save () in
    let _ = fire_trace world "call" name defcls in
    let _ = fire_tp world "call" name defcls in
    let out = (match method_body_flow frame world blk body with FNext v -> v | FReturn v -> v | FRaise v -> v | FBreak v -> v | FLoopNext v -> v) in
    // the frame dies here unless something captured it (or its chain):
    // recycled and pooled, its arena wound back to the warm seed. Safe on
    // every exit path -- method_body_flow converts raises to Flow values,
    // so this line always runs.
    let _ = (if from_pool && (if map_has frame "__captured" then false else true)
             then frame_pool_put frame else ()) in
    let _ = fire_trace world "return" name defcls in
    let _ = fire_tp world "return" name defcls in
    let _ = rx_state_restore mstate in
    out

// the ten globals a match publishes: `$~` and the numbered groups. The frame
// starts with them EMPTY -- a method that has not matched sees nil, whatever
// its caller did -- and they are put back on the way out.
// `$~` is scoped to a method call, so every call saves it and clears the slot,
// and restores it on the way out. Both of those used to WRITE unconditionally,
// twice per call -- and a write to a map orphans the value it replaced in the
// map's arena forever. For a slot that is already clear (no regex has matched
// in this program, or the last one was already consumed) the pair wrote VNil
// over VNil 11 million times in a rubocop load: 500 MB of the default region,
// for a value that did not change.
//
// So: read, compare, write only if it differs. `globals` is deliberately NOT
// compacted -- the Val returned here is a pointer into its arena and is held
// across the whole call body, which compaction would free (see thread_flag) --
// and it does not need to be, because a write that does not happen needs no
// reclaiming.


// the linearized ancestor chain of a class: the class, then its included
// modules (later includes first, MRO order), then the superclass's chain.
// a module and its own included modules, linearized (for nesting like
// `module M2; include M1; end`).
and mod_ancestors = fn world -> fn (m: str) ->
  let subs = if map_has includes m then rev_strs (str_split (map_get includes m) "|") Nil else Nil in
  Cons (m, expand_mods world subs)
and expand_mods = fn world -> fn (mods: str list) ->
  match mods with Nil -> Nil | Cons (h, t) -> list_append_str (mod_ancestors world h) (expand_mods world t)
and ancestors_of = fn world -> fn (cls: str) ->
  let g = mro_now () in
  if mro_cache_on () && map_has mro_anc_gen cls && map_get mro_anc_gen cls == g
  then map_get mro_anc cls
  else
    (let r = ancestors_of_raw world cls in
     let _ = (if mro_cache_on () then
                (let _ = map_set mro_anc cls r in map_set mro_anc_gen cls g)
              else ()) in
     r)

and ancestors_of_raw = fn world -> fn (cls: str) ->
  let (meths, sup, ocls, ivars) = world in
  let pre = if map_has prepends cls then expand_mods world (rev_strs (str_split (map_get prepends cls) "|") Nil) else Nil in
  let mods = if map_has includes cls then expand_mods world (rev_strs (str_split (map_get includes cls) "|") Nil) else Nil in
  let rest = if map_has sup cls then ancestors_of world (map_get sup cls)
             else if is_sng_cls cls then ancestors_of world (sng_supername world cls)
             else if str_eq cls "BasicObject" then Nil
             else if str_eq cls "Object" then Cons ("BasicObject", Nil)
             // Enumerator's builtin subclasses sit under Enumerator, not Object
             else if str_eq cls "Enumerator::ArithmeticSequence" || str_eq cls "Enumerator::Lazy" || str_eq cls "Enumerator::Chain"
             then ancestors_of world "Enumerator"
             else ancestors_of world "Object" in
  // A module already in the chain is NOT re-inserted: ruby keeps the position it
  // already had, so `class B < A; include M; end` where A includes M answers
  // [B, A, M, ...] and not [B, M, A, M, ...]. Without this the chain held the
  // same module twice, and `super` from the first occurrence found the second --
  // an infinite recursion. thor's `method_added` calls `super(meth)` on its
  // first line, and every Thor subclass extends the module its parent already
  // extends, so `bundle` recursed 15000 deep before the guard caught it.
  // Deduped keeping the LAST occurrence, which is the one ruby keeps.
  anc_dedupe (list_append_str pre (Cons (cls, list_append_str mods rest)))

// Drop every occurrence of a name that appears again later in the list.

// ancestor names as class values (Module#ancestors).
// the ancestor sublist strictly after the first occurrence of `x`.
// the class where method dispatch for `recv` begins (its object class, or the
// value's class for a primitive) — the head of its ancestor chain.
// resolve a bare constant name `m` referenced inside class `cls`: try each
// enclosing namespace of cls (cls::m, then strip the last ::segment, ...),
// then the bare name; return the first that names a class/module, else `m`.
// the class/module a NAME denotes, as ruby's constant lookup would answer it:
// through the enclosing lexical scope first (inside `module Cc`, `Concern::Ob`
// is `Cc::Concern::Ob`), then dereferencing the constant, so an alias
// (`Alias = A`, concurrent-ruby's `MapImplementation = MriMapBackend`) names
// the class it is bound to rather than one called "Alias". Both `class X < nm`
// and `include nm` evaluate their argument this way. Identity for a plain name.
// ... and the name may still only be an AUTOLOAD registration (i18n registers
// `autoload :Parents` on the enclosing module and never requires the file
// itself). Referencing it has to run that file first, exactly as reading the
// constant would.
and named_class_of_al = fn env -> fn world -> fn blk -> fn (cref: str) -> fn (nm: str) ->
  let r = named_class_of cref nm in
  if map_has consts r || map_has modules r then r
  else
    (let k = lex_autoload_key cref nm in
     if str_eq k "" then r
     else (let _ = autoload_fire env world blk k in named_class_of cref nm))

// `send` is the one universal name a class is allowed to TAKE BACK: Ractor
// defines its own #send, and Ruby dispatches that one. The primitive arms
// below answered first, so `r.send(:msg)` reported `msg` undefined on Ractor
// -- the name was read as "dispatch this method", never as a method itself.
// `__send__` and `public_send` stay universal, which is why they exist.
and user_defines_send = fn world -> fn (recv: Val) -> fn (name: str) ->
  if str_eq name "send" then has_meth world (dispatch_cls_of world recv) "send" else false
// `extend`: append each module's name to the receiver singleton's includes,
// so its instance methods become singleton methods (found via the sng chain).
// fire `method_added(:name)` on the class that just gained an instance method.
and run_method_added = fn world -> fn (cls: str) -> fn (nm: str) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
  if (if map_has hook_flags "ma" then false else true) then ()
  else if has_meth world ("(sng:" ++ cls ++ ")") "method_added"
  then (let _ = invoke world noblk (VClass cls) ("(sng:" ++ cls ++ ")") "method_added" (Cons (VSym nm, Nil)) in ())
  else ()

// Ruby fires #singleton_method_added on the RECEIVER every time a method is
// installed in its singleton class. Every default is an empty method except
// Numeric's, which refuses -- so this is the mechanism by which `def n.foo` on
// a Numeric is a TypeError, and why a subclass that overrides the hook (as
// ruby/spec's own NumericSpecs::Subclass does, to let its methods be mocked)
// gets to allow it again. Hardcoding "the receiver is a Numeric" here would
// answer the same in the default case and the WRONG thing for both of those.
//
// It fires just BEFORE the table write rather than just after: the only hook
// that does anything raises, and this keeps the caller one expression.
and run_singleton_method_added = fn world -> fn (recv: Val) -> fn (nm: str) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
  let c9 = dispatch_cls_of world recv in
  if has_meth world c9 "singleton_method_added"
  then (let _ = invoke world noblk recv c9 "singleton_method_added" (Cons (VSym nm, Nil)) in ())
  else ()

// ...and the values that have no singleton class to install into at all. Ruby
// answers with two different refusals: the immediates cannot have one
// (TypeError), and Rational/Complex are frozen objects (FrozenError, naming
// the value).

// fire a module's `self.included(base)` hook, if defined, after `base`
// includes it (the ActiveSupport::Concern entry point).
and run_included_hook = fn world -> fn (mq: str) -> fn (base: str) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
  if has_meth world ("(sng:" ++ mq ++ ")") "included"
  then (let _ = invoke world noblk (VClass mq) ("(sng:" ++ mq ++ ")") "included" (Cons (VClass base, Nil)) in ())
  else ()

// Hand one event to the installed trace func. Ruby passes six arguments
// (event, file, line, id, binding, classname); the line is 0 and the binding
// nil here -- this interpreter keeps neither at run time -- and the events are
// the ones it can produce: call / return / class / end.
and fire_trace = fn world -> fn (ev: str) -> fn (mname: str) -> fn (cls: str) ->
  if map_has hook_flags "stf" && (if map_has trace_fn "busy" then false else true) then
    (match (if map_has trace_fn "p" then map_get trace_fn "p" else VNil) with
     | VProc pid ->
       // the tracer's own calls must not trace, or the first event never ends
       (let _ = map_set trace_fn "busy" VNil in
        let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
        let file = (if map_has load_ctx "file" then map_get load_ctx "file" else mkstr "") in
        let argv = Cons (mkstr ev, Cons (file, Cons (VInt 0,
                     Cons (VSym mname, Cons (VNil, Cons (VClass cls, Nil)))))) in
        let _ = try_or (fn (u: unit) -> run_block world nb (proc_as_block pid) argv) (FNext VNil) in
        let _ = map_delete trace_fn "busy" in ())
     | _ -> ())
  else ()

// ...and to any TracePoint watching that event. `set_trace_func` and
// TracePoint are two views on the same three events, so they fire from the
// same place; a program with neither installed pays one map lookup.
and fire_tp = fn world -> fn (ev: str) -> fn (mname: str) -> fn (cls: str) ->
  // `tp.enable` arms the hook inside its own frame, so the RETURN from enable
  // would be the first event -- ruby arms it after that frame instead. Its
  // own :return events are the difference, so they are not reported.
  if map_has hook_flags "tp" && (if map_has trace_fn "tpbusy" then false else true)
     && (if str_eq cls "TracePoint" && str_eq ev "return" then false else true) then
    (let _ = map_set trace_fn "tpbusy" VNil in
     let noblk0 = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
     let file = (if map_has load_ctx "file" then map_get load_ctx "file" else mkstr "") in
     let _ = try_or (fn (u: unit) ->
               let _ = invoke world noblk0 (VClass "TracePoint") "(sng:TracePoint)" "__fire_ev"
                         (Cons (VSym ev, Cons (VSym mname, Cons (VClass cls, Cons (file, Nil))))) in VNil)
               VNil in
     let _ = map_delete trace_fn "tpbusy" in ())
  else ()

and run_prepended_hook = fn world -> fn (mq: str) -> fn (base: str) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
  if has_meth world ("(sng:" ++ mq ++ ")") "prepended"
  then (let _ = invoke world noblk (VClass mq) ("(sng:" ++ mq ++ ")") "prepended" (Cons (VClass base, Nil)) in ())
  else ()

// fire each extended module's `self.extended(base)` hook.
and run_extended_hooks = fn world -> fn (args: Val list) -> fn (base: Val) ->
  match args with
  | Nil -> ()
  | Cons (VClass m, rest) ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    let _ = (if has_meth world ("(sng:" ++ m ++ ")") "extended"
             then (let _ = invoke world noblk (VClass m) ("(sng:" ++ m ++ ")") "extended" (Cons (base, Nil)) in ())
             else ()) in
    run_extended_hooks world rest base
  | Cons (_, rest) -> run_extended_hooks world rest base

// every argument of #extend has to be a MODULE. A Class is not one (ruby's
// "wrong argument type Class (expected Module)"), and neither is anything
// else -- all of them were mixed in without complaint.
// mix ONE module into a receiver's singleton. `#extend` does this, and so
// does `super` from an `extend_object` override -- the documented way to write
// one ends with `super` precisely to get it, so both have to reach the same
// body rather than each having its own.


// find a bare constant by walking the lexical nesting of `cref` upward
// (M::Base -> M), checking only `consts` (no singleton unwrap, no module
// aliasing), returning the qualified key or "" if not found at any level.
// where a self value keeps its instance variables. A subclass of a builtin
// (`class Uncountables < Array`, activesupport) has instances that ARE the
// builtin value, so they need a slot of their own -- ruby lets any object
// carry ivars, and the collection's identity is the handle. "" = nowhere.
// After the lexical scope, Ruby looks along the ancestors of the enclosing
// class/module: an included module's constants are visible in the including
// class, and a subclass sees its superclass's.
// ⚠ A QUALIFIED lookup (`A::X`) does NOT fall through to Object, even though
// Object is on every class's ancestor chain: `class Object; OC = 1; end` then
// `OE2::OC` is a NameError in ruby, while the bare `OC` finds it. So the walk
// for `A::X` skips Object (and its modules) unless A IS Object -- sharing one
// walk with the bare-name case answered every top-level constant for every
// qualifier.
and anc_const_key_q = fn world -> fn (cref: str) -> fn (name: str) ->
  if str_eq cref "Object" then anc_const_key world cref name
  else anc_const_go (anc_drop_object (ancestors_of world cref)) name
// ⚠ ...drops OBJECT ITSELF, not everything from Object down. A module included
// into Object (`include M` at top level) is further along that same chain and
// IS visible to a qualified lookup: `Z2::KT` finds M's constant while
// `Z2::OC` -- assigned in `class Object` -- does not. Cutting the chain at
// Object took both away.
and anc_const_key = fn world -> fn (cref: str) -> fn (name: str) ->
  // ⚠ NO lexical scope still has ancestors: at top level the cref is Object,
  // and `include M` there puts M among Object's. Treating an empty cref as
  // "nothing to walk" meant a bare constant from such a module was never
  // found, though `Object::NAME` was.
  anc_const_go (ancestors_of world (if str_eq cref "" then "Object" else cref)) name
// the ancestor chain to walk for a super call: a class receiver means the
// current method is a class method (defined on the singleton class or an
// extended module), so resume in the singleton chain, not the instance chain.
// super found no superclass method: Ruby routes this through method_missing
// (whose default raises NoMethodError), so call a user-defined method_missing
// if the receiver has one, otherwise raise NoMethodError.
and super_missing = fn world -> fn superblk -> fn (recv: Val) -> fn (meth: str) -> fn (args: Val list) ->
  // super from a method of a primitive subclass (Array/String/Hash) into the
  // builtin base: use the builtin implementation.
  let hk = hng_key recv in
  // `super do |k, v| ... end` from a subclass's ITERATOR needs the block to
  // reach the builtin: prim_method has none, so an each/map/... super answered
  // as if no block had been given.
  if (if str_eq hk "" then false else true) then
    (match superblk with
     | (true, _, _, _) -> builtin_iter world superblk superblk recv meth args
     | _ -> prim_method recv meth args)
  else
  let dcls = dispatch_cls_of world recv in
  // Object's own methods (freeze / dup / to_s / hash / ...) live in the
  // primitive table rather than the user method map, so `super` from an
  // override of one has to reach them here — they are ancestors in Ruby, and
  // therefore win over method_missing.
  // Object#respond_to? needs the world to see user methods, so prim_method
  // cannot answer it; `super` from an override (Delegator does this) lands
  // here instead.
  if str_eq meth "respond_to?" then
    // the BUILTIN answer, not `responds` -- that would dispatch back into the
    // override we are the `super` of.
    (match args with
     | Cons (v, _) ->
       (let nm = ivar_arg_name (to_s v) in
        VBool (has_meth world (dispatch_cls_of world recv) nm || is_prim_method nm || is_enum_method nm))
     | _ -> VBool false)
  // `super` from respond_to_missing? is Object#respond_to_missing?, which
  // answers false. `m == :ok || super` is how the method is written, so it is
  // on the same path as method_missing below and failed the same way.
  else if str_eq meth "respond_to_missing?" then VBool false
  else if is_prim_method meth then prim_method recv meth args
  // BasicObject#initialize is an ancestor too: it takes no arguments and does
  // nothing, so `super()` from an initialize with no user-defined superclass
  // method has somewhere to land instead of raising.
  else if str_eq meth "initialize" then
    (match args with
     | Nil -> VNil
     | _ -> raise_exc world "ArgumentError"
              ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0)"))
  // `super` from an #initialize_copy / #initialize_dup / #initialize_clone
  // override lands on Kernel's -- `super(other)` inside one is how the
  // documented override reaches #initialize_copy at all.
  else if str_eq meth "initialize_copy" || str_eq meth "initialize_dup"
          || str_eq meth "initialize_clone" then
    kernel_copy_hook gc_cenv0 world recv meth args
  // `super` FROM method_missing is BasicObject#method_missing, and that one
  // raises. Answering it by calling method_missing again is a loop, and every
  // well-written method_missing ends in `super` for exactly the case it does
  // not handle: `super` inside it burned 10 GB and died of stack depth where
  // ruby raises NoMethodError. What it raises about is the FIRST ARGUMENT --
  // the name method_missing was called with -- not "method_missing".
  else if str_eq meth "method_missing" then
    (match args with
     | Cons (nm, _) ->
       raise_exc world "NoMethodError"
         ("undefined method '" ++ (match nm with VSym sy -> sy | VStr h -> sget h | other -> to_s other)
          ++ "' for " ++ for_recv_cls world dcls)
     | Nil -> raise_exc world "NoMethodError" ("undefined method for " ++ for_recv_cls world dcls))
  else if has_meth world dcls "method_missing"
  then invoke world superblk recv dcls "method_missing" (Cons (VSym meth, args))
  // Ruby defines the definition hooks as no-ops on Class/Module/BasicObject,
  // so an override that ends with `super` (the documented way to write one)
  // must not blow up when nothing else in the chain defines them.
  else if is_definition_hook meth then VNil
  // `super` from an `extend_object` override IS the default extend.
  else if str_eq meth "extend_object" && (match recv with VClass _ -> true | _ -> false) then
    (match recv with
     | VClass m9 -> (match args with Cons (target, _) -> do_extend_one world m9 target | _ -> VNil)
     | _ -> VNil)
  // `super` from an `append_features` / `prepend_features` override IS the
  // default include: adding the module to the base's ancestors is what
  // Module#append_features does, and ActiveSupport::Concern's override ends
  // with `super` precisely to get it.
  else if (str_eq meth "append_features" || str_eq meth "prepend_features")
          && (match recv with VClass _ -> true | _ -> false) then
    (match recv with
     | VClass m9 ->
       (match args with
        | Cons (VClass b9, _) ->
          (let _ = (if str_eq meth "prepend_features"
                    then set_pre b9 (if map_has prepends b9 then (map_get prepends b9) ++ "|" ++ m9 else m9)
                    else set_inc b9 (if map_has includes b9 then (map_get includes b9) ++ "|" ++ m9 else m9)) in
           VClass b9)
        | _ -> VNil)
     | _ -> VNil)
  // `super` from a `new` defined in an EXTENDED module (concurrent-ruby's
  // SafeInitialization wraps construction that way) is Class#new: allocate and
  // run initialize, exactly as the built-in path would have. The singleton
  // path above does this for `def self.new`; a module is the same call.
  else if str_eq meth "new" && (match recv with VClass _ -> true | _ -> false) then
    (match recv with VClass c9 -> new_obj_wb world c9 args superblk | _ -> VNil)
  // ... and `super` from an `autoload` override reaches Module#autoload, which
  // is where activesupport's Autoload module ends up after computing the path.
  // Called directly rather than through dispatch, which would find the
  // override again.
  else if str_eq meth "autoload" && (match recv with VClass _ -> true | _ -> false) then
    (match recv with
     | VClass c9 ->
       (match args with
        | Cons (nm, Cons (pv, _)) ->
          (let cn = (match nm with VSym sy -> sy | VStr h -> sget h | _ -> "") in
           let pth = (match pv with VStr h -> sget h | _ -> "") in
           let key = (if str_eq c9 "Object" then cn else c9 ++ "::" ++ cn) in
           let _ = map_set autoloads key (mkstr pth) in
           VNil)
        | _ -> VNil)
     | _ -> VNil)
  // `super` from a Regexp-subclass override (match / =~ / ...): rebuild the
  // real regexp from the ivars new_obj_wb stored and dispatch to it.
  else if (match recv with VObj _ -> true | _ -> false) && exc_is_a world dcls "Regexp" then
    (match recv with
     | VObj oid ->
       (let (m9x, s9x, o9x, i9x) = world in
        let src = (if map_has i9x (str_of_int oid ++ "@__rx_src") then to_s (map_get i9x (str_of_int oid ++ "@__rx_src")) else "") in
        let fl = (if map_has i9x (str_of_int oid ++ "@__rx_flags") then to_s (map_get i9x (str_of_int oid ++ "@__rx_flags")) else "") in
        invoke_val_c (map_new ()) world superblk (VRegex (src, fl, "")) meth args false)
     | _ -> raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'"))
  else raise_exc world "NoMethodError" ("super: no superclass method '" ++ meth ++ "'")

// the hooks Ruby ships as empty private methods, so `super` from an override
// always has somewhere to land.
// the first ancestor in `anc` that defines `name`, or "" if none.
// Record the frames a raise happened at, ON the exception where there is
// somewhere to put them: #backtrace is asked long after `$!` has moved on
// (`e = begin; raise; rescue RuntimeError; $!; end` then `e.backtrace`), and
// keying the answer on "is this still $!" answered nil for every one of those.
// An OBJECT exception keeps it in @__bt, which #backtrace already reads -- and
// keeps the FIRST one, because a re-raise does not re-capture. The pair
// representation has no ivars, so the last raise is remembered beside it.


// ⚠ "which class OWNS this method" is not "where is its BODY": `public :m` in
//   a subclass is a method entry in ruby, so #owner answers that subclass --
//   while the body is still the ancestor's, and the dispatcher needs the
//   ancestor. Answering the owner from the body walk sent the caller to a
//   class with no body and the call failed internally; these are two questions
//   and they need two walks.
// ...and the reverse trip: given the OWNER (which may be a class that only
// changed the visibility), where is the body? Everything that reads the
// definition -- #arity, #parameters, #source_location -- asks this.
and body_cls_of = fn world -> fn (owner: str) -> fn (nm: str) ->
  let (meths, _, _, _) = world in
  if str_eq owner "" then ""
  else if map_has meths (owner ++ "#" ++ nm) then owner
  else (let a9 = lookup_anc world (ancestors_of world owner) nm in
        if str_eq a9 "" then owner else a9)


// The ancestor that defines `name` ABOVE `from` -- what Method#super_method
// answers about. Walks past `from` first, so a class that defines the method
// itself does not find itself.
// is this class name in the ancestor list?


// An UnboundMethod object for (class, name). One place, because three callers
// build one now (instance_method, super_method, clone).

// ---- Struct.new(:a, :b) --------------------------------------------------
// synthesize an anonymous class with rw accessors, a positional initialize,
// and to_a / values / members / == built from the member list.
// ⚠ Where a Struct keeps its members. NOT in `@<member>`: ruby stores them
// outside the instance-variable table entirely, so `S.new(1).instance_variables`
// is [] and `s.instance_variable_set(:@a, 99)` makes an ORDINARY ivar that
// leaves the member alone. Storing them as `@a` made all three wrong, and the
// third silently -- setting an ivar that happened to share a member's name
// overwrote the member.
//
// The slot name ends in a byte no Ruby identifier can contain, so a program
// cannot name it by accident and instance_variables can recognise and drop it.
// Hiding `@a` instead was tried and reverted: the struct's own readers (#to_h,
// #[], deconstruct_keys) go through the same table, so half of it cannot be
// hidden from one caller and not the other.


// interleaved [:m1, @m1, :m2, @m2, ...] for a #to_h returning EHsh.

// #[] body: return the ivar whose member symbol or 0-based index matches __k.
// `s[0]`, `s[:a]`, `s["a"]` and `s[-1]` all name one member, and an index past
// the end is an IndexError rather than nil (`s[:nope]` is a NameError).
// no member matched: an Integer key is an IndexError, anything else a NameError
// (`raise` is its own node, not a call, and the message is built with #to_s so
// an Integer key concatenates)

// was keyword_init: mentioned at all? (`nil` and `false` are different answers
// from #keyword_init?)
// `keyword_init: nil` is mentioned AND answers nil


// keyword_init: true among the Struct.new arguments?
// ⚠ `keyword_init:` is TRUTHY, not `== true`: ruby accepts any value that is
// not nil or false, and `keyword_init?` then answers true. Matching only
// `VBool b` made `Struct.new(:m, keyword_init: 42)` a POSITIONAL struct, so
// `k.new(m: 1).m` was the hash `{m: 1}` -- the keyword was stored as the
// member's value instead of naming it.
// members as keyword parameter names ("x" -> "x:") for a keyword_init struct.
// each member defaults to nil, so a missing keyword yields nil (not an error).


// #each body: with no block, return an Enumerator (via enum_for(:each), like
// CRuby); otherwise yield each member value in turn and return self.


// The part of a Struct's surface that does not depend on the member NAMES:
// written once, in ruby, and registered into every struct class. Reading the
// members at run time means a struct of any length gets all of it, and there is
// one place each answer comes from -- the alternative was an Expr tree per
// method per member list.

// The FIRST argument may be a String naming the constant to define; every
// argument after it is a member. Dropping strings wherever they appeared meant
// `Struct.new(:a, "b").members` was [:a] where ruby answers [:a, :b].

// ...and a member has to BE a symbol or a string. Everything else was silently
// ignored, so `Struct.new(:animal, 1.0)` built a one-member struct instead of
// refusing -- and the refusal is the whole of what ruby/spec's new_spec checks
// on that line.

// ...and the same member cannot be named twice.
// Can `c.new(:a, :b)` GENERATE a struct class? `Struct` can, and so can a
// descendant that has no members of its own -- `class SubX < Struct; end`
// inherits Struct's `new`. A generated class HAS members, and its `new` builds
// an instance, so the two questions are told apart by struct_mem.
and struct_generator_cls = fn world -> fn (c: str) ->
  str_eq c "Struct"
  || (str_list_has (ancestors_of world c) "Struct"
      && (if struct_anc_members world (ancestors_of world c) then false else true))

// ⚠ ANY ancestor's members, not just the class's own. `class Named <
// Struct.new(:a); end` has no members of its OWN and is not a generator --
// asking only about `c` made `Named.new("x")` build a second struct class, and
// `Class.new(SomeStruct).new.class` answered Class instead of the subclass.
// the nearest ancestor that HAS members -- the one whose member list an
// instance's fields are read from.
// Is an instance of `c` a STRUCT? Its own members, or any ancestor's --
// `class Named < Struct.new(:a); end` has none of its own. The question was
// written as `map_has struct_mem c` in three places (the printer, the
// inspect/to_s dispatch guard, and that guard's exclusion list) and all three
// answered no for a subclass, so its instances printed as ordinary objects.
and is_struct_obj_cls = fn world -> fn (c: str) ->
  map_has struct_mem c || struct_anc_members world (ancestors_of world c)




// `parent` is the class the generated struct inherits from. It is `Struct` for
// `Struct.new(:a)` and the RECEIVER for `class SubX < Struct; end;
// SubX.new(:a)` -- ruby lets any memberless descendant of Struct generate one,
// and a method the subclass defines (an #initialize that calls super, which is
// what ruby/spec's SubclassX does) then belongs to the generated class.
and struct_build = fn world -> fn (parent: str) -> fn (args: Val list) ->
  let (meths, sup, ocls, ivars) = world in
  // `Struct.new(name, :a)` asks a non-Symbol first argument for #to_str: the
  // NAME may be any object that can become a String, and one that could was
  // silently dropped (the leading-string arm only recognised a real String),
  // so the struct came back anonymous instead of named.
  let args = (match args with
              | Cons (VObj _, rest9) ->
                (match args with
                 | Cons (o9, _) ->
                   (if responds world o9 "to_str"
                    then (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
                          match invoke_val_c gc_cenv0 world nb9 o9 "to_str" Nil false with
                          | VStr h9 -> Cons (mkstr (sget h9), rest9)
                          | _ -> args)
                    else args)
                 | Nil -> args)
              | _ -> args) in
  let members = struct_members_of_args args in
  let _ = struct_dup_check members in
  let n = (if map_has struct_ctr "n" then map_get struct_ctr "n" else 0) in
  let _ = map_set struct_ctr "n" (n + 1) in
  let anon = "Struct_" ++ str_of_int n in
  let _ = set_sup sup anon (if str_eq parent "" then "Struct" else parent) in
  let _ = struct_add_attrs world anon members in
  // keyword_init structs take their members as (nil-defaulted) keyword params;
  // positional structs take them positionally.
  let kw = struct_kw_init args in
  let _ = set_meth meths (anon ++ "#initialize")
            (if kw then Meth (struct_kw_params members, struct_kw_defaults members, struct_init_body members)
             // Positional members default to nil: Struct.new(:a, :b).new takes
             // 0..2 arguments in Ruby, filling what is missing.
             else Meth (members, struct_pos_defaults members, struct_init_body members)) in
  let toa = Cons (SReturn (EArr (struct_ivar_reads members)), Nil) in
  let _ = set_meth meths (anon ++ "#to_a") (Meth (Nil, Nil, toa)) in
  let _ = set_meth meths (anon ++ "#to_ary") (Meth (Nil, Nil, toa)) in
  let _ = set_meth meths (anon ++ "#values") (Meth (Nil, Nil, toa)) in
  let _ = set_meth meths (anon ++ "#deconstruct") (Meth (Nil, Nil, toa)) in
  let _ = set_meth meths (anon ++ "#members") (Meth (Nil, Nil, Cons (SReturn (EArr (struct_sym_lits members)), Nil))) in
  // #members is also a class method (Struct.members).
  let _ = set_meth meths ("(sng:" ++ anon ++ ")#members") (Meth (Nil, Nil, Cons (SReturn (EArr (struct_sym_lits members)), Nil))) in
  let _ = set_meth meths (anon ++ "#to_h") (Meth (Nil, Nil, Cons (SReturn (EHsh (struct_to_h_pairs members)), Nil))) in
  let _ = set_meth meths (anon ++ "#[]") (Meth (Cons ("__k", Nil), Nil, Cons (SReturn (struct_index_body members 0), Nil))) in
  let _ = set_meth meths (anon ++ "#each") (Meth (Nil, Nil, struct_each_body members)) in
  // ⚠ The rest of a Struct's read surface, derived from to_a / to_h rather than
  //   written out per member. These were absent while to_a, values, members,
  //   to_h, [] and each were present -- the same pattern as ENV and the numeric
  //   tower: part of one protocol implemented, the rest never reached for.
  //
  //   Defining them in terms of each other means a member list of any length
  //   gets them for free, and there is one place where each answer comes from.
  let self_m = fn (m: str) -> EMethod (ESelf, m, Nil) in
  let _ = set_meth meths (anon ++ "#size")
            (Meth (Nil, Nil, Cons (SReturn (EMethod (self_m "to_a", "size", Nil)), Nil))) in
  let _ = set_meth meths (anon ++ "#length")
            (Meth (Nil, Nil, Cons (SReturn (EMethod (self_m "to_a", "size", Nil)), Nil))) in
  let _ = set_meth meths (anon ++ "#values_at")
            (Meth (Cons ("*__ix", Nil), Nil,
                   Cons (SReturn (EMethod (self_m "to_a", "values_at", Cons (ESplat (EVar "__ix"), Nil))), Nil))) in
  let _ = set_meth meths (anon ++ "#dig")
            (Meth (Cons ("*__dk", Nil), Nil,
                   Cons (SReturn (EMethod (self_m "to_h", "dig", Cons (ESplat (EVar "__dk"), Nil))), Nil))) in
  // deconstruct_keys(nil) is the whole hash; with a list it is those keys only.
  let _ = set_meth meths (anon ++ "#deconstruct_keys")
            (Meth (Cons ("__ks", Nil), Nil,
                   Cons (SReturn (EMethod (self_m "to_h", "slice", Cons (ESplat (EBin ("||", EVar "__ks", EMethod (ESelf, "members", Nil))), Nil))), Nil))) in
  // each_pair yields [name, value]; each yields the values alone.
  let _ = set_meth meths (anon ++ "#each_pair")
            (Meth (Nil, Nil, Cons (SReturn (EMethod (self_m "to_h", "each_pair", Nil)), Nil))) in
  let _ = set_meth meths (anon ++ "#==")
            (Meth (Cons ("o", Nil), Nil,
                   Cons (SReturn (EBin ("==", EMethod (ESelf, "to_a", Nil), EMethod (EVar "o", "to_a", Nil))), Nil))) in
  // `Struct.new("Foo", :a)` names the struct: it becomes the constant
  // Struct::Foo as well as the returned class.
  // ...and the name has to BE a constant's: ruby refuses `Struct.new("lower", :a)`
  // with "identifier lower needs to be constant" rather than making a constant
  // nothing can refer to. This accepted it and registered `Struct::lower`,
  // which no program can then name.
  let _ = (match args with
           | Cons (VStr nh, _) ->
             (let nm9 = sget nh in
              if str_len nm9 > 0 && (if is_upper (char_at nm9 0) then false else true)
              then (let _ = raise_exc world "NameError"
                              ("identifier " ++ nm9 ++ " needs to be constant") in ())
              else
                (let cn = "Struct::" ++ nm9 in
                 let _ = map_set consts cn (VClass anon) in
                 name_anon cn (VClass anon)))
           | _ -> ()) in
  let _ = map_set struct_mem anon (arr_new (struct_sym_vals members)) in
  // ...and the member-independent half, parsed from ruby and registered into
  // this class. It comes last, so it wins over the generated #[] / #to_h.
  let _ = (let (sprog, _) = parse_stmts (number_nls (struct_common_src ()) (lex_go (struct_common_src ()) 0)) Nil in
           let cenv9 = map_new () in
           let _ = map_set cenv9 "self" (VClass anon) in
           let _ = map_set cenv9 "__cscope" (mkstr anon) in
           let _ = map_set cenv9 "__cref" (mkstr anon) in
           register_class_v world anon sprog "public" cenv9) in
  // Struct[] is a synonym for new, and #keyword_init? answers what the class
  // was built with (nil when it was not mentioned at all, as ruby reports).
  let _ = set_meth meths ("(sng:" ++ anon ++ ")#[]")
            (Meth (Cons ("*__a", Nil), Nil, Cons (SReturn (EMethod (ESelf, "new", Cons (ESplat (EVar "__a"), Nil))), Nil))) in
  // ...and the pairs that are one method under two names: reflection compares
  // the UnboundMethods, and alias_srcname is what says they are the same one.
  // ...and the same pairs on `Struct` itself, which is where reflection asks
  // when the program has no generated class in hand:
  // `Struct.instance_method(:deconstruct) == Struct.instance_method(:to_a)`.
  let _ = map_set alias_srcname "Struct#deconstruct" "to_a" in
  let _ = map_set alias_srcname "Struct#values" "to_a" in
  let _ = map_set alias_srcname "Struct#to_ary" "to_a" in
  let _ = map_set alias_srcname "Struct#length" "size" in
  let _ = map_set alias_srcname (anon ++ "#deconstruct") "to_a" in
  let _ = map_set alias_srcname (anon ++ "#values") "to_a" in
  let _ = map_set alias_srcname (anon ++ "#to_ary") "to_a" in
  let _ = map_set alias_srcname (anon ++ "#length") "size" in
  // Struct#initialize is private, as ruby's is (a spec asks the class for it)
  let _ = mark_vis_mode meths anon (Cons ("initialize", Nil)) "private" in
  let _ = set_meth meths ("(sng:" ++ anon ++ ")#keyword_init?")
            (Meth (Nil, Nil, Cons (SReturn (if struct_kw_nil args then ENil else if struct_kw_mentioned args then EBool kw else ENil), Nil))) in
  VClass anon

// the innermost `n` recorded call names, outermost of that window first.

// run a method body, converting a `return` flow signal into the method's
// return value (any other signal or a real exception keeps unwinding).
and method_body_flow = fn frame -> fn world -> fn blk -> fn (body: Stmt list) ->
  // Interpreter recursion guard: each Ruby method call adds native frames, so
  // unbounded Ruby recursion would eventually overflow the native stack and
  // SIGSEGV. Count call depth and, past a limit chosen safely below where the
  // native stack fails, raise a catchable SystemStackError instead — matching
  // CRuby's "stack level too deep". The counter is restored right after the
  // existing per-body try_or below, so it is decremented on EVERY exit path
  // (normal return, propagating exception, or break/next/return flow signal)
  // and never leaks, without adding a new try_or to the hot path.
  let cd = (if map_has struct_ctr "cd" then map_get struct_ctr "cd" else 0) in
  // 15000 is measured, not guessed. With the required -stack_size (512MB) a
  // heavy frame (block, hash, string, begin/rescue) reaches 100000 native
  // frames before the stack fails, so this is well inside what the stack
  // takes -- deliberately, because the guard also bounds how much stack a
  // RUNAWAY recursion commits before it trips, and a batch of programs in one
  // process has to survive that. The old 1500 predates the -stack_size flag
  // entirely and stopped rubocop-ast mid-load: it needs more than 10000,
  // because each Ruby call costs several interpreter frames.
  if cd >= 15000 then
    (let _ = (if str_eq (env_get "MERE_RUBY_STACKTRACE") "" then ()
              else print_err ("[stack] innermost frames:\n" ++ stack_dump cd 40 "")) in
     let _ = // ruby's message is the four words; the class in parentheses is what the
     // REPORTER adds when nothing rescues it, so having it here printed it twice
     raise_exc world "SystemStackError" "stack level too deep" in FRaise VNil)
  else
  let _ = map_set struct_ctr "cd" (cd + 1) in
  // A method body may run with UNROOTED values in flight above it (the
  // caller's half-evaluated expression); a safepoint may not collect while
  // any such context is on the stack. Two exceptions stay collectable:
  // bare SRequire chains (never come through here) and bare literal-arg
  // calls carrying the gc_bare baton (rubygems' Kernel#require, and every
  // `require "x"` under it).
  let gcbare = map_has gc_bare "y" in
  let _ = (if gcbare then map_delete gc_bare "y" else gc_unsafe_push ()) in
  let _ = map_set_si call_names_s cd
            ((match (if map_has frame "__defcls" then map_get frame "__defcls" else VNil) with
              | VClass c -> c ++ "#"
              | _ -> "")
             ++ (if map_has frame "__meth"
                 then (match map_get frame "__meth" with VStr h -> sget h | _ -> "?")
                 else "?")) in
  // Where the CALL was written: the line the caller is on right now. With the
  // name already recorded per depth, that is a call stack -- which is all
  // `caller` is. It is also what has to be restored when the body is done,
  // because the line is one global: without this, the current line after a call
  // returns would be the last line the CALLEE ran.
  let _ = map_set call_lines cd (cur_line ()) in
  let _ = map_set_si call_files_s cd (cur_file ()) in
  let _ = map_set_si call_meths_s cd (cur_meth ()) in
  let _ = map_set_s cur_pos_s "m" (if map_has call_names_s cd then map_get call_names_s cd else "") in
  // mark this frame live so a break targeting it (via a block's home) can find
  // it; once the body has unwound to here (any outcome) the frame is done.
  let fidk = (if map_has frame "__fid" then (match map_get frame "__fid" with VInt t -> t | _ -> 0 - 1) else 0 - 1) in
  let _ = if fidk < 0 then () else map_set live_frames fidk 1 in
  // a method call is a `return` boundary: a return inside the body returns from
  // this method, even when the call happens inside a Thread.new block.
  // The BOOL, not the Val (see the Thread.new site): thread_flag is compacted
  // at a safepoint and the body below hits safepoints, so a Val read out of it
  // must not be held across the call. Writing only when the value CHANGES is
  // the other half: this runs once per method call, and every write orphans
  // the previous box in the map's arena forever -- 5.5M writes for one bit
  // that is already false almost every time.
  let savedtf = (if map_has thread_flag "n" then (match map_get thread_flag "n" with VBool b -> b | _ -> false) else false) in
  let _ = if savedtf then map_set thread_flag "n" (VBool false) else () in
  // A REGION PER CALL, body only. The 2026-08-20 attempt wrapped the whole
  // call and died on the frame's type (a container born in a block binds to
  // the block, and a frame captured by define_method must outlive it). The
  // frame is created OUTSIDE and only the body runs inside: locals write
  // into the frame by copy-on-store (its region, not this one), ivars into
  // the world stores, and the Flow result is copied out -- while the call
  // MACHINERY of every nested call (argument lists, dispatch strings), which
  // used to land in whatever ancestor statement's region was current and be
  // HELD for that statement's whole extent (13 GB live and climbing at 75
  // seconds into a rubocop load, the require chain's arenas), now dies when
  // the nearest enclosing call returns.
  let f = try_or (fn (u: unit) -> region MCALL { run_stmts frame world blk body }) (FRaise VNil) in
  // restore depth: runs whether the body returned normally, re-raised, or
  // emitted a flow signal (try_or has already caught any fail by this point).
  let _ = map_set struct_ctr "cd" cd in
  let _ = (if gcbare then () else gc_unsafe_pop ()) in
  // ... and with it the caller's line and file, for the same reason
  let _ = map_set cur_pos "l" (if map_has call_lines cd then map_get call_lines cd else 0) in
  let _ = map_set_s cur_pos_s "f" (if map_has call_files_s cd then map_get call_files_s cd else "") in
  let _ = map_set_s cur_pos_s "m" (if map_has call_meths_s cd then map_get call_meths_s cd else "") in
  // read, compare, write only if it differs -- the body may have left the flag
  // set (a nested Thread.new), so "skip the restore because we skipped the
  // entry write" would be wrong.
  let nowtf = (if map_has thread_flag "n" then (match map_get thread_flag "n" with VBool b -> b | _ -> false) else false) in
  let _ = if nowtf == savedtf then () else map_set thread_flag "n" (VBool savedtf) in
  let _ = if fidk < 0 then () else map_delete live_frames fidk in
  match f with
  | FRaise _ ->
    if map_has flow_sig "k" then
      let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
      let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
      let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

      if str_eq k "return" then FNext v
      else if str_eq k "breakret" || str_eq k "returnret" then
        // a break/return unwinding to its block's home frame: consume it here
        // iff this is that frame, otherwise keep propagating to the outer method.
        let target = (if map_has flow_sig "fid" then (match map_get flow_sig "fid" with VInt t -> t | _ -> 0) else 0) in
        let myfid = (if map_has frame "__fid" then (match map_get frame "__fid" with VInt t -> t | _ -> 0) else 0) in
        if target == myfid then (let _ = map_delete flow_sig "fid" in FNext v)
        else (let _ = map_set flow_sig "k" (mkstr k) in
              let _ = map_set flow_sig "fid" (VInt target) in
              let _ = map_set flow_sig "v" v in
              (let m = "mere-ruby: (unhandled " ++ k ++ " looking for its frame)" in
               let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m))
      else if str_eq k "retry" then FRaise (raise_exc world "SyntaxError" "Invalid retry")
      else flow_rethrow k v
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")
  | other -> other

// materialize an Enumerator into an array (unbounded enum_take).
and enum_to_arr = fn env -> fn world -> fn blk -> fn (eid: int) ->
  enum_take env world blk eid (0 - 1)

// like enum_to_arr but bounded: the collector breaks out after n elements
// (so infinite generators can serve first/take/next). n < 0 = unbounded.
and enum_take = fn env -> fn world -> fn blk -> fn (eid: int) -> fn (n: int) ->
  enum_take_m env world blk eid n false
// values mode (next_values/peek_values): every yield gathers as an array,
// even single- and zero-value yields.
and enum_take_m = fn env -> fn world -> fn blk -> fn (eid: int) -> fn (n: int) -> fn (vals: bool) ->
  let (m0, s0, ocls0, ivars0) = world in
  let accv = arr_new Nil in
  if n == 0 then accv else
  let cenv2 = map_new () in
  let _ = map_set cenv2 "__acc" accv in
  let pushst = (if vals then SExpr (EMethod (EVar "__acc", "push", Cons (EVar "__e", Nil)))
                else SExpr (EMethod (EVar "__acc", "push",
                Cons (ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                             EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                             EVar "__e"), Nil)))) in
  // The collector's VALUE decides how far a short-circuiting source walks, and
  // ruby's yielder answers nil. This answered `__acc.push(...)` -- an Array,
  // which is truthy -- so materialising a `find` enumerator stopped at the first
  // element (`[3,1,2].find.to_a` was `[3]`), and `find.with_index` then searched
  // a one-element list and answered nil. The BOUNDED form below already ended in
  // an `if`, whose value is nil when it does not break, so only this one lied.
  let body = (if n < 0 then Cons (pushst, Cons (SExpr ENil, Nil))
              else Cons (pushst,
                   Cons (SIf (Cons ((EBin (">=", EMethod (EVar "__acc", "length", Nil), EInt n),
                                     Cons (SBreak ENil, Nil)), Nil), Nil), Nil))) in
  let collector = (true, Cons ("*__e", Nil), body, cenv2) in
  let _ = (if map_has ivars0 (str_of_int eid ++ "@__e_step") then
             // produce form: yield seed, then step(prev) forever (bounded by
             // the collector's break -> StopIteration).
             (match map_get ivars0 (str_of_int eid ++ "@__e_step") with
              | VProc spid ->
                (let seed = (if map_has ivars0 (str_of_int eid ++ "@__e_seed") then map_get ivars0 (str_of_int eid ++ "@__e_seed") else VNil) in
                 let f = try_or (fn (u: unit) -> let _ = enum_produce_go env world blk collector (map_get proc_store (str_of_int spid)) seed in FNext VNil) (FRaise VNil) in
                 (match f with
                  | FRaise _ ->
                    (let ecls = (if map_has ivars0 "$exc" then (match map_get ivars0 "$exc" with VExc (c2, _) -> c2 | _ -> "") else "") in
                     if str_eq ecls "StopIteration" then (let _ = map_delete ivars0 "$exc" in ())
                     else if map_has flow_sig "k" then
                       (let k = (match map_get flow_sig "k" with VStr kk -> sget kk | _ -> "") in
                        let v2 = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
                        let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

                        if str_eq k "break" then () else (let _ = flow_rethrow k v2 in ()))
                     else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)"))
                  | _ -> ()))
              | _ -> ())
           else if map_has ivars0 (str_of_int eid ++ "@__e_blk") then
             (match map_get ivars0 (str_of_int eid ++ "@__e_blk") with
              | VProc gpid ->
                let bpid = map_len proc_store in
                let _ = store_proc (str_of_int bpid) collector in
                let yid = alloc_oid ocls0 in
                let _ = map_set ocls0 yid "Enumerator::Yielder" in
                let _ = map_set ivars0 (str_of_int yid ++ "@__y_blk") (VProc bpid) in
                // a break escaping the generator (no loop of its own) ends here.
                let f = try_or (fn (u: unit) -> let _ = run_block world blk (map_get proc_store (str_of_int gpid)) (Cons (VObj yid, Nil)) in FNext VNil) (FRaise VNil) in
                (match f with
                 | FRaise _ ->
                   (if map_has flow_sig "k" then
                      (let k = (match map_get flow_sig "k" with VStr kk -> sget kk | _ -> "") in
                       let v2 = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
                       let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

                       if str_eq k "break" then () else (let _ = flow_rethrow k v2 in ()))
                    else
                      // the bounded collector ends the generator by raising
                      // StopIteration (consumed here); anything else re-raises.
                      let ecls = (if map_has ivars0 "$exc" then (match map_get ivars0 "$exc" with VExc (c2, _) -> c2 | _ -> "") else "") in
                      if str_eq ecls "StopIteration" then (let _ = map_delete ivars0 "$exc" in ())
                      else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)"))
                 | _ -> ())
              | _ -> ())
           else
             // ...unless the ENUMERATOR itself has been given an `each`:
             // `e = Object.new.to_enum; class << e; def each; ...` is how four
             // spec files build one, and walking the SOURCE then asked an
             // Object for a method the singleton had.
             (let own_each = (let c0 = map_get ocls0 eid in
                              if is_sng_cls c0 && has_meth world c0 "each" then c0 else "") in
              if (if str_eq own_each "" then false else true)
              then (let _ = invoke world collector (VObj eid) own_each "each" Nil in ())
              else
              let recv2 = (if map_has ivars0 (str_of_int eid ++ "@recv") then map_get ivars0 (str_of_int eid ++ "@recv") else VNil) in
              let meth2 = (match (if map_has ivars0 (str_of_int eid ++ "@meth") then map_get ivars0 (str_of_int eid ++ "@meth") else mkstr "each") with VStr h -> sget h | _ -> "each") in
              let eargs = (match (if map_has ivars0 (str_of_int eid ++ "@eargs") then map_get ivars0 (str_of_int eid ++ "@eargs") else VNil) with VArr aid2 -> deref aid2 | _ -> Nil) in
              let _ = drive_enum env world blk recv2 meth2 eargs collector in
              ())) in
  accv

// search the $LOAD_PATH directories for a feature file ("" = not found).

// Kernel#load: run the file (no .rb auto-append, no dedup); resolves against
// the $LOAD_PATH, then the current dir. Returns true.
and rb_load = fn env -> fn world -> fn (p0: str) ->
  let dir = (if map_has load_ctx "dir" then (match map_get load_ctx "dir" with VStr d -> sget d | _ -> ".") else ".") in
  let full = if str_len p0 > 0 && str_eq (char_at p0 0) "/" then p0
             else if str_len p0 >= 2 && (str_eq (substring p0 0 2) "./" || (str_len p0 >= 3 && str_eq (substring p0 0 3) "../")) then
               env_get "PWD" ++ "/" ++ p0
             else (let hit = load_path_find world p0 in
                   if str_eq hit "" then dir ++ "/" ++ p0 else hit) in
  if is_reg_file full then
    (let src = read_file full in
     let savedc = (if map_has load_ctx "coding" then map_get load_ctx "coding" else mkstr "UTF-8") in
     let cod = src_coding src in
     let _ = map_set load_ctx "coding" (mkstr (if str_eq cod "" then "UTF-8" else cod)) in
     let _ = map_set load_ctx "parsing" (mkstr full) in
     let toks = number_nls src (lex_go src 0) in
     let _ = parse_line_reset (count_nls toks) in
     let (prog2, rest2) = parse_stmts toks Nil in
     let _ = map_set load_ctx "parsing" (mkstr "") in
     let _ = rx_check_pending () in
     let _ = warn_flush world in
     let _ = (match rest2 with
              | Cons (TEOF, _) -> ()
              | _ -> (let __fm = ("mere-ruby: unexpected token at top level in " ++ full ++ parsing_file ()) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)) in
     let fenv = map_new () in
     let _ = map_set fenv "self" VMain in
     let saved = (if map_has load_ctx "dir" then map_get load_ctx "dir" else mkstr ".") in
     let savedf = (if map_has load_ctx "file" then map_get load_ctx "file" else mkstr "") in
     let _ = map_set load_ctx "dir" (mkstr (dirname_of full)) in
     // __FILE__ inside a required file is THAT file, not the script that
     // started everything — libraries build sibling paths out of it.
     let _ = map_set load_ctx "file" (mkstr full) in
     let noblk2 = (false, (Nil : str list), (Nil : Stmt list), fenv) in
     let f = run_stmts fenv world noblk2 prog2 in
     let _ = map_set load_ctx "dir" saved in
     let _ = map_set load_ctx "file" savedf in
     let _ = map_set load_ctx "coding" savedc in
     (match f with
      // name the file: an exception that escapes a load has usually lost its
      // identity by the time it gets here, and "which file" is the part that
      // actually locates it.
      | FRaise _ -> (let m = "mere-ruby: (ruby exception raised) while loading " ++ full in
                     let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)
      | _ -> VBool true))
  else
    (let _ = map_set le_path ("cannot load such file -- " ++ p0) (mkstr p0) in
     raise_exc world "LoadError" ("cannot load such file -- " ++ p0))

// split on ':' -- the separator ruby uses for -I chains and RUBYLIB.
// one ENV read: the write overlay wins (VNil = deleted), then the real
// environment.
// ⚠ ONE rule for what an ENV string is tagged with, because there are two
// readers: ENV[k] goes through env_lookup_v, and everything ELSE (each_pair,
// keys, to_h, shift, ...) is answered from a Hash built by env_hash_list. Only
// the first stamped, so `ENV["X"].encoding` honoured default_internal and
// `ENV.keys.first.encoding` did not.
// coerce an ENV key (or value) to str: String, or anything with #to_str;
// otherwise TypeError.
// ENV's arguments are strings, and ruby asks an object for #to_str to get one.
// Two groups, because they refuse DIFFERENTLY, and getting that backwards is
// wrong in the strict direction -- exactly as wrong as the permissive one:
//   - a key (or a stored value) that cannot become a String is a TypeError:
//     `ENV.values_at(1)` refuses rather than finding nothing.
//   - a SEARCH argument is only asked, never refused: `ENV.value?(1)` is
//     false and `ENV.rassoc(1)` is nil, because no value equals 1.
// `ENV[k] = nil` is the deletion form and keeps its nil.
and env_coerce_args = fn env -> fn world -> fn (name: str) -> fn (args: Val list) ->
  // ([]= and store are not here: they answer the object they were GIVEN, so
  // the conversion happens where the value is stored, not in the argument list)
  if str_eq name "values_at" || str_eq name "assoc"
          || str_eq name "key" || str_eq name "delete" || str_eq name "[]"
          || str_eq name "key?" || str_eq name "has_key?"
          || str_eq name "include?" || str_eq name "member?" then
    env_hard_strs env world args
  // fetch's SECOND argument is the default, and it may be anything at all.
  else if str_eq name "fetch" then
    (match args with
     | Cons (k9, rest9) -> Cons (mkstr (env_key_of env world k9), rest9)
     | Nil -> args)
  else if str_eq name "value?" || str_eq name "has_value?"
          || str_eq name "rassoc" || str_eq name "except" then
    env_soft_strs env world args
  else args
// ENV.clone's only keyword is `freeze:`, whose value must be nil or a boolean.
// "" means there is nothing to complain about.
and env_slice_pairs = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Nil -> (Nil : Val list)
  | Cons (k9, t9) ->
    (match env_lookup_v (env_key_of env world k9) with
     | VNil -> env_slice_pairs env world t9
     | v9 -> Cons (k9, Cons (v9, env_slice_pairs env world t9)))
and env_hard_strs = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Nil -> (Nil : Val list)
  | Cons (v9, t9) -> Cons (mkstr (env_key_of env world v9), env_hard_strs env world t9)
and env_soft_strs = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Nil -> (Nil : Val list)
  | Cons (v9, t9) ->
    Cons ((match v9 with
           | VObj _ -> (if responds world v9 "to_str" then mkstr (env_key_of env world v9) else v9)
           | _ -> v9),
          env_soft_strs env world t9)
and env_key_of = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VStr h -> sget h
  | VObj id ->
    (let (m0, s0, ocls0, _) = world in
     let cls0 = map_get ocls0 id in
     let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
     if has_meth world cls0 "to_str" then
       (match invoke world noblk v cls0 "to_str" Nil with
        | VStr h -> sget h
        | _ -> let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ cls0 ++ " into String") in "")
     // a method_missing responder (e.g. a spec mock) still coerces.
     else if has_meth world cls0 "method_missing" then
       (match invoke_val_c env world noblk v "to_str" Nil false with
        | VStr h -> sget h
        | _ -> let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ cls0 ++ " into String") in "")
     else let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ cls0 ++ " into String") in "")
  | _ -> let _ = raise_exc world "TypeError" ("no implicit conversion of " ++ class_name v ++ " into String") in ""
// the full environment as (key, value) pairs — there is no environ extern, so
// dump env(1) to a temp file and parse it. The dump is NUL-framed where env
// supports -0, which is what makes a value containing a newline survive it.
//
// Wrapped, because on a target with no host there is nothing to ask. `mere -rv`
// builds a program that IS the machine: `random_int`, `run`, `file_exists` and
// `read_file` all stop with a message there, and this is the first thing the
// interpreter does — $LOAD_PATH needs RUBYLIB, RUBYLIB needs the environment, and
// the environment needs a shell. So `ruby -e 'puts 1 + 1'` could not start.
//
// An environment that cannot be read is EMPTY, not an error. That is not an
// approximation: ruby started with no RUBYLIB and no RUBYOPT behaves exactly the
// way this does, so the degraded answer is one of the real ones. The decision
// lives here rather than in the four services because this is the level that
// knows what their absence MEANS — a `read_file` that quietly returned "" would
// be wrong everywhere else.
//
// The `try_or` also catches a ruby-level raise from inside, since raise unwinds
// through Mere's `fail` too. Nothing in the body raises: it is host I/O and
// string parsing.

// the NUL-framed dump: every record ends at a NUL, and the first `=` inside it
// splits name from value. A record with no `=` cannot come from environ.

// ENV as an interleaved [k1, v1, k2, v2, ...] hash body: the environment in
// its own order with the write overlay applied, then the keys the overlay
// added. A VNil overlay entry is a deleted key.
// mark each of these keys deleted in the write overlay.
// ⚠ A WRITE-BACK IS A WRITE. Every pair that lands here is going into the
// environment, so it faces the same refusals `ENV[k] = v` does: a key or value
// that is not a String is a TypeError, and a key holding `=` (or empty) is the
// Errno::EINVAL setenv(3) would give. Writing them straight into the overlay
// let `ENV.merge!({1 => "x"})` and `ENV.replace({"A=B" => "1"})` through --
// entries the real environment could never hold.
// ⚠ CHECK THE WHOLE LIST FIRST. ENV.replace deletes before it writes, so a
// bad pair halfway down used to leave the environment emptied and half filled;
// ruby refuses with ENV untouched. The refusals are the ones env_set_pairs
// makes -- run over the list with nothing written.
and env_check_pairs = fn env -> fn world -> fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (v, t)) ->
    (let _ = env_pair_ok env world k v in env_check_pairs env world t)
  | _ -> ()
// the (key, value) a pair is written as, or the refusal it earns.
and env_pair_ok = fn env -> fn world -> fn (k: Val) -> fn (v: Val) ->
  (let k2 = (match k with
             | VStr h -> sget h
             | other -> (match conv_try env world other "to_str" with
                         | VStr h2 -> sget h2
                         | _ -> (match raise_exc world "TypeError"
                                   ("no implicit conversion of " ++ dispatch_cls_of world other
                                    ++ " into String") with _ -> ""))) in
   let v2 = (match v with
             | VStr _ -> v
             | VNil -> v
             | other -> (match conv_try env world other "to_str" with
                         | VStr h2 -> VStr h2
                         | _ -> raise_exc world "TypeError"
                                  ("no implicit conversion of " ++ dispatch_cls_of world other
                                   ++ " into String"))) in
   let _ = (if (str_eq k2 "" || str_contains k2 "=") && (match v2 with VNil -> false | _ -> true)
            then (let _ = raise_exc_iv world "Errno::EINVAL"
                    ("Invalid argument - setenv(" ++ k2 ++ ")") (Cons (("__recv", k), Nil)) in ())
            else ()) in
   (k2, v2))
and env_set_pairs = fn env -> fn world -> fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (v, t)) ->
    (let k2 = (match k with
               | VStr h -> sget h
               | other -> (match conv_try env world other "to_str" with
                           | VStr h2 -> sget h2
                           | _ -> (match raise_exc world "TypeError"
                                     ("no implicit conversion of " ++ dispatch_cls_of world other
                                      ++ " into String") with _ -> ""))) in
     let v2 = (match v with
               | VStr _ -> v
               | VNil -> v
               | other -> (match conv_try env world other "to_str" with
                           | VStr h2 -> VStr h2
                           | _ -> raise_exc world "TypeError"
                                    ("no implicit conversion of " ++ dispatch_cls_of world other
                                     ++ " into String"))) in
     let _ = (if (str_eq k2 "" || str_contains k2 "=") && (match v2 with VNil -> false | _ -> true)
              then (let _ = raise_exc_iv world "Errno::EINVAL"
                      ("Invalid argument - setenv(" ++ k2 ++ ")") (Cons (("__recv", k), Nil)) in ())
              else ()) in
     let _ = map_set env_ovr k2 v2 in
     env_set_pairs env world t)
  | _ -> ()

// reverse lookup for ENV.key: first key whose value matches (skipping keys
// the overlay shadows).
// a regular file? file_exists is true for directories too, and require/
// load must skip those (Ruby skips a matching directory on the load path).
// single-quote a string for the shell (used by the run-backed helpers).
// the extension of a file name: from its last dot to the end, "" when there
// is no dot or the dot starts the name (".bashrc" has no extension). A
// trailing dot IS the extension ("x." -> "."), as in Ruby 3.

// "~" / "~/x" is the home directory (Ruby's expand_path does this; "~user"
// needs a passwd lookup mere-ruby has no way to do, so it is left alone).
// resolve "." and ".." segments and collapse repeated slashes. Purely textual,
// as Ruby's expand_path is — nothing here touches the filesystem.


// Libraries mere-ruby ships as source instead of searching for on disk: they
// are pure Ruby in CRuby too, but they live in the stdlib, which mere-ruby has
// no copy of. "" means "not one of ours, go look for a file".

// --- glob ------------------------------------------------------------------
// Dir.glob / File.fnmatch?. The entry list comes from find(1) (there is no
// directory-listing extern the Wasm backend supports), but every pattern
// character is interpreted here, so a path with shell metacharacters can never
// reach the command line.

// `{a,b}` alternation: the list of brace-free patterns a pattern stands for.
// split the body at top-level commas ("a,{b,c}" -> ["a"; "{b,c}"]).
and glob_expand = fn (p: str) ->
  let o = glob_brace_open p 0 in
  if o < 0 then Cons (p, Nil)
  else
    let c = glob_brace_close p (o + 1) 1 in
    if c < 0 then Cons (p, Nil)
    else
      glob_expand_alts (glob_brace_split (substring p (o + 1) c) 0 0 0)
        (substring p 0 o) (substring p (c + 1) (str_len p))
and glob_expand_alts = fn (alts: str list) -> fn (pre: str) -> fn (post: str) ->
  match alts with
  | Nil -> (Nil : str list)
  | Cons (a, rest) -> sappend (glob_expand (pre ++ a ++ post)) (glob_expand_alts rest pre post)

// "." at the start of a name is only matched by a literal "." in the pattern
// (that is what keeps `*` from picking up dotfiles). `fl` carries the mode:
// "p" = FNM_PATHNAME — "*", "?" and "[" stop at "/" and every component start
// protects its dot, which is how Dir.glob matches. "d" = FNM_DOTMATCH.
// does a wildcard refuse to step over s[j]? only under FNM_PATHNAME.

// does the brace-free pattern `p` match the whole path `s`?
and glob_match = fn (fl: str) -> fn (p: str) -> fn (s: str) -> glob_go fl p 0 s 0
and glob_go = fn (fl: str) -> fn (p: str) -> fn (i: int) -> fn (s: str) -> fn (j: int) ->
  if i >= str_len p then j >= str_len s
  else
    let c = char_at p i in
    if str_eq c "*" then
      (if i + 1 < str_len p && str_eq (char_at p (i + 1)) "*" then
         // "**" crosses directories; "**/" also stands for zero components.
         (if i + 2 < str_len p && str_eq (char_at p (i + 2)) "/"
          then (if glob_go fl p (i + 3) s j then true else glob_star_dirs fl p (i + 3) s j)
          else glob_star_any fl p (i + 2) s j)
       else glob_star1 fl p (i + 1) s j)
    else if str_eq c "?" then
      (if j < str_len s && (if glob_sep_at fl s j then false else true) &&
          (if glob_dot_at fl s j then false else true)
       then glob_go fl p (i + 1) s (j + 1) else false)
    else if str_eq c "[" then glob_class fl p i s j
    else if str_eq c "\\" && i + 1 < str_len p then
      (if j < str_len s && str_eq (char_at p (i + 1)) (char_at s j) then glob_go fl p (i + 2) s (j + 1) else false)
    else (if j < str_len s && str_eq c (char_at s j) then glob_go fl p (i + 1) s (j + 1) else false)
// "*": zero or more characters, stopping at "/" under FNM_PATHNAME.
and glob_star1 = fn (fl: str) -> fn (p: str) -> fn (i: int) -> fn (s: str) -> fn (j: int) ->
  if glob_go fl p i s j then true
  else if j >= str_len s then false
  else if glob_sep_at fl s j then false
  else if glob_dot_at fl s j then false
  else glob_star1 fl p i s (j + 1)
// bare "**": any number of characters, crossing "/" but never entering a
// component that starts with ".".
and glob_star_any = fn (fl: str) -> fn (p: str) -> fn (i: int) -> fn (s: str) -> fn (j: int) ->
  if glob_go fl p i s j then true
  else if j >= str_len s then false
  else if glob_dot_at fl s j then false
  else glob_star_any fl p i s (j + 1)
// "**/": try the rest of the pattern at each following component start, but
// never descend through a component whose name starts with ".".
and glob_star_dirs = fn (fl: str) -> fn (p: str) -> fn (i: int) -> fn (s: str) -> fn (j: int) ->
  if glob_dot_at fl s j then false
  else
    let e = glob_comp_end s j in
    if e >= str_len s then false
    else
      let k = e + 1 in
      if glob_go fl p i s k then true else glob_star_dirs fl p i s k
// "[abc]" / "[a-z]" / "[^a]".
and glob_class = fn (fl: str) -> fn (p: str) -> fn (i: int) -> fn (s: str) -> fn (j: int) ->
  if j >= str_len s then false
  else if glob_sep_at fl s j then false
  else if glob_dot_at fl s j then false
  else
    let neg = i + 1 < str_len p && (str_eq (char_at p (i + 1)) "^" || str_eq (char_at p (i + 1)) "!") in
    let st = if neg then i + 2 else i + 1 in
    let e = glob_class_end p st in
    if e < 0 then false
    else
      let hit = glob_class_has p st e (char_at s j) in
      if (if neg then (if hit then false else true) else hit) then glob_go fl p (e + 1) s (j + 1) else false

// the longest leading run of the pattern with no metacharacter, cut at the
// last "/" — the directory find(1) can start from.

// relative paths under `root`, one per line, "./" stripped by the caller.
and glob_keep = fn (fl: str) -> fn (pats: str list) -> fn (pre: str) -> fn (rels: str list) ->
  match rels with
  | Nil -> (Nil : Val list)
  | Cons (r, rest) ->
    if glob_any fl pats r then Cons (mkstr (pre ++ r), glob_keep fl pats pre rest)
    else glob_keep fl pats pre rest
// File::FNM_* bits (PATHNAME = 2, DOTMATCH = 4) as the matcher's flag string.
and glob_any = fn (fl: str) -> fn (pats: str list) -> fn (r: str) ->
  match pats with Nil -> false | Cons (p, t) -> if glob_match fl p r then true else glob_any fl t r

// Dir.glob(pattern, base:) -> the matching paths, sorted, relative to the
// pattern (Ruby sorts by default and returns base-relative paths).
and glob_paths = fn (fl: str) -> fn (pat0: str) -> fn (base: str) ->
  let pats0 = glob_expand pat0 in
  // a pattern with no metacharacter at all is just a file test
  let m = glob_first_meta pat0 0 in
  if m >= str_len pat0 then
    (let full = (if str_eq base "" || str_eq (char_at pat0 0) "/" then pat0 else base ++ "/" ++ pat0) in
     if file_exists full then Cons (mkstr pat0, Nil) else Nil)
  else
    let sl = glob_last_slash pat0 0 m (0 - 1) in
    let pre = (if sl < 0 then "" else substring pat0 0 (sl + 1)) in
    let root0 = (if sl < 0 then "" else substring pat0 0 (if sl == 0 then 1 else sl)) in
    let root = (if str_len root0 > 0 && str_eq (char_at root0 0) "/" then root0
                else if str_eq base "" then (if str_eq root0 "" then "." else root0)
                else (if str_eq root0 "" then base else base ++ "/" ++ root0)) in
    // strip the static prefix from each alternative, so matching is relative
    let pats = glob_strip_pre pats0 (str_len pre) in
    let deep = glob_any_deep pats in
    let depth = (if deep then 0 else glob_slashes (glob_head pats) 0 0 + 1) in
    val_sort (glob_keep fl pats pre (glob_lines (glob_find root depth) 0))
// argument shuffling for Dir.glob / Dir[]: a trailing hash is the option hash
// (only `base:` is honoured), everything else is a pattern or array of them.
and glob_all = fn (fl: str) -> fn (pats: str list) -> fn (base: str) ->
  match pats with
  | Nil -> (Nil : Val list)
  | Cons (p, t) -> vappend (glob_paths fl p base) (glob_all fl t base)

// inside a synchronous thread body?
// nucomp_real_check: a Complex with zero imaginary demotes to its real
// part; a Complex with a nonzero one is "not a real".
// a File object: @__f_path/@__f_mode/@__f_buf/@__f_pos. Writes buffer and
// flush on #close (or at the end of a File.open block); reads go straight
// through the read_file extern. Mode "" marks the handle closed.
// A path argument in ruby is any object that answers #to_path, and Pathname is
// the one that matters: bundler writes its lockfile as
// `filesystem_access(file) {|p| File.open(p, "wb") {|f| ... } }`, where p is a
// Pathname. Refusing it is what stopped Bundler.setup, and it arrived at the top
// as an interpreter placeholder rather than an error naming a path, because the
// refusal happens below the level that has a ruby exception to raise.
//
// The no-block value comes from the caller: this runs at the dispatch head,
// before the local one is built.
// What `require` accepts as a path, in ruby's words: a String is itself, and
// anything else is asked for #to_path and then #to_str -- refusing with
// TypeError when neither answers a String. ⚠ THREE doors led to do_require and
// each treated a non-String differently: the statement form answered nil in
// silence, and the two builtin arms matched only `Cons (VStr _, _)` so a
// MockObject fell past them and was reported as an undefined method named
// __builtin_require_relative. One rule, one place.
and require_path_of = fn env -> fn world -> fn (v: Val) ->
  (match v with
   | VStr h9 -> sget h9
   | _ ->
     (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
      let cls9 = dispatch_cls_of world v in
      // ⚠ the two conversions CHAIN, they are not alternatives: #to_path is
      //   asked first, and whatever it answers is then asked for #to_str if it
      //   is not already a String. An object whose #to_path returns another
      //   object is converted twice, and ruby/spec has that exact case.
      let via = (if has_meth world cls9 "to_path" then invoke world nb9 v cls9 "to_path" Nil else v) in
      let via = (match via with
                 | VStr _ -> via
                 | _ -> (let c8 = dispatch_cls_of world via in
                         if has_meth world c8 "to_str" then invoke world nb9 via c8 "to_str" Nil else via)) in
      match via with
      | VStr h9 -> sget h9
      | _ -> (let _ = raise_exc world "TypeError"
                ("no implicit conversion of " ++ conv_name v ++ " into String") in "")))

and to_path_str = fn nb -> fn world -> fn (v: Val) ->
  (match v with
   | VObj _ ->
     (let cls = dispatch_cls_of world v in
      if has_meth world cls "to_path"
      then (match invoke world nb v cls "to_path" Nil with
            | VStr h -> VStr h
            | _ -> v)
      else v)
   | _ -> v)

// Only the leading argument, and the second of the two-path calls: File.write's
// content is not a path, however many methods it happens to answer.
and path_args = fn nb -> fn world -> fn (name: str) -> fn (args: Val list) ->
  (match args with
   | Nil -> Nil
   | Cons (a, rest) ->
     Cons (to_path_str nb world a,
           (if str_eq name "rename" || str_eq name "symlink" || str_eq name "link"
            then (match rest with Cons (b, r2) -> Cons (to_path_str nb world b, r2) | Nil -> Nil)
            else rest)))

// Put what has been written out to the file and keep the handle open. close does
// the same and then marks the handle closed; a buffer that has already been
// flushed is empty, so flushing twice writes nothing twice.
// the index one past this line's newline (or end of string).
// Kernel#gets: slurp stdin once, then return the next line (including its
// trailing "\n", like Ruby) or VNil at EOF. `while line = gets` relies on the
// VNil to stop. read_stdin is "" on the Wasm host (no stdin), so gets there
// simply yields nil immediately.

// ARGF input: the concatenation of every file named in ARGV (read via
// read_file), or stdin when ARGV is empty — the stream ARGF presents.

// --- String#unpack (a byte-safe subset) --------------------------------
// A byte at index i (0..255). char_at/ord are byte-safe on the length-header
// str representation, so embedded NULs read fine.
// n big-endian bytes at i as an unsigned integer.
// n little-endian bytes at i (mul starts at 1, grows *256).
// read a count after a directive: an integer, '*' (rest), or 1 (default).
// returns (count_or_-1_for_star, next_fmt_index).
// Array#pack: walk the format's directives, each consuming `count` values.


// unpack `s` per `fmt`, accumulating Vals (newest-first, reversed at the end).
and rb_unpack = fn (s: str) -> fn (fmt: str) ->
  arr_new (rev_vals (rb_unpack_go s (str_len s) 0 fmt (str_len fmt) 0 Nil))
and rb_unpack_go = fn (s: str) -> fn (slen: int) -> fn (si: int) -> fn (fmt: str) -> fn (fl: int) -> fn (fi: int) -> fn (acc: Val list) ->
  if fi >= fl then acc
  else
    let d = char_at fmt fi in
    if str_eq d " " then rb_unpack_go s slen si fmt fl (fi + 1) acc
    else
      let (cnt, fi2) = rb_count fmt fl (fi + 1) in
      // width per element for fixed-width directives (0 = string-consuming)
      let w = (if str_eq d "N" || str_eq d "V" then 4
               else if str_eq d "n" || str_eq d "v" then 2
               else if str_eq d "C" || str_eq d "c" then 1
               else flt_dir_width d) in
      if w > 0 then
        // repeat the fixed-width read `cnt` times (or until end for '*').
        let reps = (if cnt < 0 then floor_div (slen - si) w else cnt) in
        rb_unpack_fixed s slen si fmt fl fi2 d w reps acc
      else if str_eq d "H" then
        // hex string of `cnt` NIBBLES (or all remaining bytes for '*').
        let nib = (if cnt < 0 then (slen - si) * 2 else cnt) in
        let nb = floor_div (nib + 1) 2 in
        let last = (if si + nb < slen then si + nb else slen) in
        rb_unpack_go s slen last fmt fl fi2 (Cons (mkstr_e (rb_hex_of s si last "") "US-ASCII", acc))
      else if str_eq d "a" || str_eq d "A" then
        let take = (if cnt < 0 then slen - si else cnt) in
        let last = (if si + take < slen then si + take else slen) in
        rb_unpack_go s slen last fmt fl fi2 (Cons (mkstr_e (rb_str_of_bytes s si last "") "ASCII-8BIT", acc))
      else if str_eq d "B" || str_eq d "b" then
        // bit string: "B" walks each byte's bits MSB-first, "b" LSB-first;
        // the count is in BITS ('*' = all of them).
        (let nbits = (if cnt < 0 then (slen - si) * 8 else cnt) in
         let msb = str_eq d "B" in
         let avail = (slen - si) * 8 in
         let take = (if nbits > avail then avail else nbits) in
         let pw2 = fn (k: int) -> (if k == 0 then 1 else if k == 1 then 2 else if k == 2 then 4 else if k == 3 then 8
                                   else if k == 4 then 16 else if k == 5 then 32 else if k == 6 then 64 else 128) in
         let rec bits9 = fn (k: int) -> fn (out: str) ->
           if k >= take then out
           else
             let by = ord (char_at s (si + floor_div k 8)) in
             let pos = floor_mod k 8 in
             let bit = (if msb then floor_mod (floor_div by (pw2 (7 - pos))) 2
                        else floor_mod (floor_div by (pw2 pos)) 2) in
             bits9 (k + 1) (out ++ str_of_int bit) in
         let consumed = floor_div (take + 7) 8 in
         rb_unpack_go s slen (si + consumed) fmt fl fi2 (Cons (mkstr_e (bits9 0 "") "US-ASCII", acc)))
      else if str_eq d "m" then
        // base64: decode the rest of the input, skipping '=' padding and
        // anything outside the alphabet (newlines), as ruby's loose "m" does.
        // "m0" is the STRICT decoder: a byte outside the alphabet refuses.
        (let strict = cnt == 0 in
         let b64v = fn (c: int) ->
           if c >= 65 && c <= 90 then c - 65
           else if c >= 97 && c <= 122 then c - 71
           else if c >= 48 && c <= 57 then c + 4
           else if c == 43 then 62
           else if c == 47 then 63
           else 0 - 1 in
         let rec go9 = fn (i: int) -> fn (bits: int) -> fn (nb: int) -> fn (out: str) ->
           if i >= slen then out
           else
             let v = b64v (ord (char_at s i)) in
             if v < 0 then
               (let _ = (if strict && (if ord (char_at s i) == 61 then false else true)
                         then (let _ = prim_raise "ArgumentError" "invalid base64" in ()) else ()) in
                go9 (i + 1) bits nb out)
             else
               let bits2 = bits * 64 + v in
               let nb2 = nb + 6 in
               if nb2 >= 8 then
                 (let sh = nb2 - 8 in
                  let dv = (if sh == 0 then 1 else if sh == 2 then 4 else 16) in
                  go9 (i + 1) (floor_mod bits2 dv) sh (out ++ chr (floor_div bits2 dv)))
               else go9 (i + 1) bits2 nb2 out in
         rb_unpack_go s slen slen fmt fl fi2 (Cons (mkstr_e (go9 si 0 0 "") "ASCII-8BIT", acc)))
      else rb_unpack_go s slen si fmt fl fi2 acc  // unknown directive: skip
// pack helpers: an integer's low w bytes, big- or little-endian.
and rb_unpack_fixed = fn (s: str) -> fn (slen: int) -> fn (si: int) -> fn (fmt: str) -> fn (fl: int) -> fn (fi2: int) -> fn (d: str) -> fn (w: int) -> fn (reps: int) -> fn (acc: Val list) ->
  if reps <= 0 then rb_unpack_go s slen si fmt fl fi2 acc
  else if si + w > slen then rb_unpack_fixed s slen si fmt fl fi2 d w 0 (Cons (VNil, acc))  // short: nil, stop
  else
    let vv = (if flt_dir_width d > 0 then rb_unpack_flt s si d
              else VInt (if str_eq d "N" then rb_be s si 4 0
                         else if str_eq d "n" then rb_be s si 2 0
                         else if str_eq d "V" then rb_le s si 4 1 0
                         else if str_eq d "v" then rb_le s si 2 1 0
                         else if str_eq d "C" then rb_sbyte s si
                         else // "c": signed byte
                           let b = rb_sbyte s si in (if b >= 128 then b - 256 else b))) in
    rb_unpack_fixed s slen (si + w) fmt fl fi2 d w (reps - 1) (Cons (vv, acc))

// read the bytes of a float back. `k` counts from the most significant end,
// which is where the sign and the exponent live whichever way round they were
// written.

// puts semantics onto stderr: arrays flatten, one trailing newline per item
// (print_err itself appends the newline).
// The text Kernel#warn writes, WITHOUT its final newline (err_emit adds that,
// and print_err on the unhooked path adds it too). An Array argument spreads
// over lines, and a message that already ends in a newline does not get a
// second one -- both measured against ruby rather than assumed.
and warn_join = fn world -> fn (xs: Val list) -> fn (acc: str) ->
  match xs with
  | Nil -> acc
  | Cons (VArr aid, t) -> warn_join world t (warn_join world (deref aid) acc)
  | Cons (h, t) ->
    // ⚠ an object is asked for ITS #to_s, not the value-level one: ruby's
    //   `warn(obj)` calls the method, and a spec mock counts the call.
    (let s9 = (match h with
               | VStr sh -> sget sh
               | VObj oid9 ->
                 (let (m9, s99, ocls9, iv9) = world in
                  let cls9 = map_get ocls9 oid9 in
                  let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
                  if has_meth world cls9 "to_s"
                  then (match invoke world nb9 h cls9 "to_s" Nil with VStr h9 -> sget h9 | o9 -> to_s o9)
                  else to_s h)
               | other -> to_s other) in
     let s9 = (if str_len s9 > 0 && str_eq (char_at s9 (str_len s9 - 1)) "\n"
               then substring s9 0 (str_len s9 - 1) else s9) in
     warn_join world t (if str_eq acc "" then s9 else acc ++ "\n" ++ s9))

and err_puts_each = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> ()
  | Cons (VArr aid, t) -> let _ = err_puts_each world (deref aid) in err_puts_each world t
  | Cons (VStr sh, t) ->
    let s2 = sget sh in
    let _ = err_emit world (if str_len s2 > 0 && str_eq (char_at s2 (str_len s2 - 1)) "\n"
                       then substring s2 0 (str_len s2 - 1) else s2) in
    err_puts_each world t
  | Cons (h, t) -> let _ = err_emit world (to_s h) in err_puts_each world t
// puts rendered into a string (for a File's write buffer): arrays flatten,
// each item gets exactly one trailing newline.
// split content into an array of lines, each keeping its newline.

// an Enumerator::Lazy: a source (anything with #each) + a pipeline of ops
// ([kind, payload] pairs: procs for map/select/..., ints for take/drop).
// intern a plain string as a VStr handle payload.

// run the pipeline: drive src.each; each element passes through the ops on a
// driver object (Enumerator::LzDrv), accumulating survivors (bound < 0 =
// all; the driver raises StopIteration to stop the source).
and lz_run = fn env -> fn world -> fn blk -> fn (id: int) -> fn (bound: int) -> fn (fin: Val) ->
  let (m0, s0, ocls0, ivars0) = world in
  let accv = arr_new Nil in
  let did = alloc_oid ocls0 in
  let _ = map_set ocls0 did "Enumerator::LzDrv" in
  let _ = map_set ivars0 (str_of_int did ++ "@__acc") accv in
  let _ = map_set ivars0 (str_of_int did ++ "@__ops") (arr_new (lz_ops world id)) in
  let _ = map_set ivars0 (str_of_int did ++ "@__bound") (VInt bound) in
  let _ = (match fin with VNil -> () | _ -> map_set ivars0 (str_of_int did ++ "@__fin") fin) in
  let cenv2 = map_new () in
  let _ = map_set cenv2 "__lzobj" (VObj did) in
  let collector = (true, Cons ("*__e", Nil),
                   Cons (SExpr (EMethod (EVar "__lzobj", "__lzstep", Cons (ESplat (EVar "__e"), Nil))), Nil),
                   cenv2) in
  let f = try_or (fn (u: unit) -> let _ = invoke_with_block env world blk (lz_src world id) "each" Nil collector in FNext VNil) (FRaise VNil) in
  let _ = (match f with
           | FRaise _ ->
             (if map_has flow_sig "k" then
                (let k = (match map_get flow_sig "k" with VStr kk -> sget kk | _ -> "") in
                 let v2 = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
                 let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

                 if str_eq k "break" then () else (let _ = flow_rethrow k v2 in ()))
              else
                let ecls = (if map_has ivars0 "$exc" then (match map_get ivars0 "$exc" with VExc (c2, _) -> c2 | _ -> "") else "") in
                if str_eq ecls "StopIteration" then (let _ = map_delete ivars0 "$exc" in ())
                else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)"))
           | _ -> ()) in
  accv

// one element through the pipeline (called from the collector via __lzstep).
and lz_step = fn env -> fn world -> fn blk -> fn (did: int) -> fn (v0: Val) ->
  let (m0, s0, ocls0, ivars0) = world in
  let ops = (match (if map_has ivars0 (str_of_int did ++ "@__ops") then map_get ivars0 (str_of_int did ++ "@__ops") else VNil) with VArr aid -> deref aid | _ -> Nil) in
  lz_step_ops env world blk did ops 0 v0
and lz_step_ops = fn env -> fn world -> fn blk -> fn (did: int) -> fn (ops: Val list) -> fn (i: int) -> fn (v: Val) ->
  let (m0, s0, ocls0, ivars0) = world in
  match ops with
  | Nil ->
    // survivor: hand to the final consumer or accumulate (bound-checked).
    (match (if map_has ivars0 (str_of_int did ++ "@__fin") then map_get ivars0 (str_of_int did ++ "@__fin") else VNil) with
     | VProc fpid ->
       let _ = flow_value (run_block world blk (map_get proc_store (str_of_int fpid)) (Cons (v, Nil))) in
       VNil
     | _ ->
       (match (if map_has ivars0 (str_of_int did ++ "@__acc") then map_get ivars0 (str_of_int did ++ "@__acc") else VNil) with
        | VArr aid ->
          let _ = arr_set aid (list_append (deref aid) (Cons (v, Nil))) in
          let bound = (match (if map_has ivars0 (str_of_int did ++ "@__bound") then map_get ivars0 (str_of_int did ++ "@__bound") else VNil) with VInt bn -> bn | _ -> 0 - 1) in
          if bound >= 0 && val_list_len (deref aid) >= bound then raise_exc world "StopIteration" "iteration reached an end"
          else VNil
        | _ -> VNil))
  | Cons (opv, rest) ->
    let (kind, payload) = (match opv with
                           | VArr oaid -> (match deref oaid with
                                           | Cons (VStr kh, Cons (pl, _)) -> (sget kh, pl)
                                           | _ -> ("", VNil))
                           | _ -> ("", VNil)) in
    let callp = fn (pv: Val) ->
      (match payload with
       | VProc ppid -> flow_value (run_block world blk (map_get proc_store (str_of_int ppid)) (Cons (pv, Nil)))
       | _ -> VNil) in
    if str_eq kind "map" then lz_step_ops env world blk did rest (i + 1) (callp v)
    else if str_eq kind "select" then
      (if truthy (callp v) then lz_step_ops env world blk did rest (i + 1) v else VNil)
    else if str_eq kind "reject" then
      (if truthy (callp v) then VNil else lz_step_ops env world blk did rest (i + 1) v)
    else if str_eq kind "filter_map" then
      (let r = callp v in if truthy r then lz_step_ops env world blk did rest (i + 1) r else VNil)
    else if str_eq kind "take_while" then
      (if truthy (callp v) then lz_step_ops env world blk did rest (i + 1) v
       else raise_exc world "StopIteration" "iteration reached an end")
    else if str_eq kind "drop_while" then
      (let fk = str_of_int did ++ "@__dw" ++ str_of_int i in
       if map_has ivars0 fk then lz_step_ops env world blk did rest (i + 1) v
       else if truthy (callp v) then VNil
       else (let _ = map_set ivars0 fk (VBool true) in lz_step_ops env world blk did rest (i + 1) v))
    else if str_eq kind "take" then
      (let n = (match payload with VInt tn -> tn | _ -> 0) in
       let ck = str_of_int did ++ "@__tk" ++ str_of_int i in
       let c = (match (if map_has ivars0 ck then map_get ivars0 ck else VNil) with VInt cn -> cn | _ -> 0) in
       if c >= n then raise_exc world "StopIteration" "iteration reached an end"
       else (let _ = map_set ivars0 ck (VInt (c + 1)) in lz_step_ops env world blk did rest (i + 1) v))
    else if str_eq kind "drop" then
      (let n = (match payload with VInt dn -> dn | _ -> 0) in
       let ck = str_of_int did ++ "@__dp" ++ str_of_int i in
       let c = (match (if map_has ivars0 ck then map_get ivars0 ck else VNil) with VInt cn -> cn | _ -> 0) in
       if c < n then (let _ = map_set ivars0 ck (VInt (c + 1)) in VNil)
       else lz_step_ops env world blk did rest (i + 1) v)
    else lz_step_ops env world blk did rest (i + 1) v

// an Enumerator::Chain over a list of sources (each must respond to #each).
// materialize a chain: drive each source's #each into one collector.
and chain_to_arr = fn env -> fn world -> fn blk -> fn (id: int) ->
  let accv = arr_new Nil in
  let cenv2 = map_new () in
  let _ = map_set cenv2 "__acc" accv in
  let collector = (true, Cons ("*__e", Nil),
                   Cons (SExpr (EMethod (EVar "__acc", "push",
                     Cons (ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                                  EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                                  EVar "__e"), Nil))), Nil),
                   cenv2) in
  let _ = chain_drive env world blk (chain_srcs world id) collector in
  accv
and chain_drive = fn env -> fn world -> fn blk -> fn (srcs: Val list) -> fn theblk ->
  match srcs with
  | Nil -> ()
  | Cons (src, rest) ->
    let _ = invoke_with_block env world blk src "each" Nil theblk in
    chain_drive env world blk rest theblk

// Enumerator.produce driver: yield v to the collector block, then step.
and enum_produce_go = fn env -> fn world -> fn blk -> fn collector -> fn stepblk -> fn (v: Val) ->
  let _ = tick () in
  (match run_block world blk collector (Cons (v, Nil)) with
   | FBreak _ -> ()
   | _ ->
     let nv = flow_value (run_block world blk stepblk (Cons (v, Nil))) in
     enum_produce_go env world blk collector stepblk nv)

// an Enumerator is a plain object of the synthetic class "Enumerator" whose
// @recv / @meth ivars remember the receiver and method to drive on #each.
// grep/grep_v: elements the pattern === (or not); one? helpers.
and arr_grep = fn world -> fn (xs: Val list) -> fn (pat: Val) -> fn (inv: bool) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    let hit = case_eqq world pat h in
    if (if inv then (if hit then false else true) else hit)
    then Cons (h, arr_grep world t pat inv)
    else arr_grep world t pat inv
// grep / grep_v WITH a block: the test and the yield for one element happen
// together, so `$~` is that element's own match when the block runs.
and arr_grep_map = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (pat: Val) -> fn (inv: bool) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (let hit = case_eqq world pat h in
     if (if inv then (if hit then false else true) else hit) then
       (match run_block world encl theblk (Cons (h, Nil)) with
        | FBreak v -> FBreak v
        | FReturn v -> FReturn v
        | FRaise v -> FRaise v
        | fl -> arr_grep_map world encl theblk t pat inv (Cons (flow_value fl, acc)))
     else arr_grep_map world encl theblk t pat inv acc)
and arr_count_eqq = fn world -> fn (xs: Val list) -> fn (pat: Val) -> fn (acc: int) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> arr_count_eqq world t pat (if case_eqq world pat h then acc + 1 else acc)

// the first element of each [elem, index] pair

// The caller's block, wrapped so a source method calls it with (element,
// index) -- which is what with_index means. The counter lives in a
// one-element ARRAY rather than a local, because a block-local assignment
// would be a fresh binding on every call and the index would never move.

// with_index runs the SOURCE method over (element, index) pairs, so a source
// that answers elements answers pairs and has to be unwrapped again. These name
// the two shapes that answer elements: a list of them, and a single one.
// partition answers two lists of pairs; group_by a hash whose VALUES are lists
// of pairs (a hash is a flat key, value, key, value list here).



// Drive an Enumerator's source method. `to_enum(:name)` keeps working when
// `name` is PRIVATE -- ruby's Enumerator calls it the way `send` does, and
// `to_enum(__method__)` inside a private method is the standard shape (it is
// what rubocop-ast's compiler uses). Everything else stays on the ordinary
// block dispatcher, which knows the builtins.
and drive_enum = fn env -> fn world -> fn blk -> fn (recv: Val) -> fn (meth: str) -> fn (args: Val list) -> fn newblk ->
  let (m0, _, _, _) = world in
  match recv with
  // a top-level method has no class to look it up in
  | VMain ->
    (if map_has m0 meth
     then (let e2 = lv_flat env in let _ = map_set e2 "self" recv in call_method e2 world newblk meth args)
     else invoke_with_block env world blk recv meth args newblk)
  | VObj _ ->
    (let cls = dispatch_cls_of world recv in
     if has_meth world cls meth then invoke world newblk recv cls meth args
     else invoke_with_block env world blk recv meth args newblk)
  | _ -> invoke_with_block env world blk recv meth args newblk

// The Enumerator surface (next / peek / first / size / with_index / ...) is
// keyed on the object's class name; an ArithmeticSequence IS an Enumerator, so
// every such arm asks this instead of the literal name. Lazy and Chain keep
// their own arms (they answer differently).

// Numeric#step / Range#step without a block: an Enumerator::ArithmeticSequence
// -- an Enumerator (make_enum_a drives `recv.step(args)` when it is walked)
// that also knows its begin, end, step and whether the end is excluded.
// ...and the same thing under a NAMED method: `(1..10) % 2` is an
// ArithmeticSequence too, and it inspects as `((1..10).%(2))`. The name was
// hardcoded to "step" in both the builder and the printer, so `%` printed as
// a step and core/range/percent_spec was the whole finding.

// the number of terms an integer arithmetic sequence has (ruby's count rule)

// is this bound a plain number, so the count can be COMPUTED?
// the number of terms when any of begin/end/step is a Float, which is CRuby's
// ruby_float_step_size (error term and all) plus the infinite ends it decides
// before dividing. Without it, size and last MATERIALIZED the sequence:
// 1.step(to: Float::INFINITY, by: 42).size allocated until the memory cap
// killed the process -- the worst possible answer to a question whose answer
// is the single word Infinity.

// keyword lookup in a hash's flat [k, v, k, v ...] pair list
// `by: 2, to: 10` -- keyword pairs printed the way they were written
// n terms from b, stepping st

// `(1..10) % 2` -- the same sequence `step` makes, remembering that it was
// written as `%`.

// the sequence for `recv.step(args)` with no block: Integer with (limit[, by])
// or (by:, to:) keywords or nothing (endless), and an integer Range with an
// optional step.

// the sequence for a NUMERIC receiver: (limit[, by]), (to:, by:) keywords, or
// nothing at all. The bounds are kept AS WRITTEN -- a Float limit or step
// stays a Float, so the walk yields Floats and the count goes through
// aseq_size_flt. Matching only the (VInt, VInt) shapes sent 1.step(10, 2.5)
// to the endless-integer fallback, which walked 1, 2, 3, ... instead, and
// left a Float receiver answering nil.

// `(1.step(10, 2))` / `((1..10).step(3))` / `(1.step(by: 2, to: 10))`: the call
// that made the sequence, from its @recv / @eargs. Called by the object
// inspector directly (dispatching #inspect from there would come back here).

// `#<Enumerator: [1, 2]:each_slice(2)>`: the CALL the enumerator was made
// from, out of its @recv / @meth / @eargs -- and for a lazy one, the chain of
// operations, each wrapping the last: `#<Enumerator::Lazy: #<Enumerator::Lazy:
// [1, 2]>:map>`. Without this an Enumerator fell to the default object printer
// and answered `#<Enumerator:0x.. @recv=[1, 2], @meth="each">` -- publishing
// the ivars this implementation happens to store, with an address in it, where
// ruby prints something stable that a spec can compare. Called by the object
// inspector directly (dispatching #inspect from there would come back here).
and enum_inspect_str = fn env -> fn world -> fn (oid: int) -> fn (cls: str) ->
  let (meths, sup, ocls, ivars) = world in
  let key = str_of_int oid in
  let gv = fn (k: str) -> (if map_has ivars (key ++ k) then map_get ivars (key ++ k) else VNil) in
  let rec join9 = fn (xs: Val list) -> fn (acc: str) ->
    (match xs with
     | Nil -> acc
     | Cons (x, t) -> join9 t (acc ++ (if str_eq acc "" then "" else ", ") ++ inspect_w env world x)) in
  let argstr = fn (xs: Val list) ->
    (match xs with Nil -> "" | _ -> "(" ++ join9 xs "" ++ ")") in
  if str_eq cls "Enumerator::Lazy" then
    // the source, then one wrapper per operation. An operation's stored
    // argument is its BLOCK for map/select and a value for take(2), and only
    // the value is printed -- ruby prints `:map` with no arguments at all.
    (let rec wrap9 = fn (ops: Val list) -> fn (acc: str) ->
       (match ops with
        | Nil -> acc
        | Cons (VArr pid, t) ->
          (match deref pid with
           | Cons (nv, rest) ->
             (let nm = (match nv with VStr h -> sget h | VSym sy -> sy | _ -> "") in
              let vis = (match rest with
                         | Cons (VProc _, _) -> Nil
                         | Cons (v9, _) -> Cons (v9, Nil)
                         | Nil -> Nil) in
              wrap9 t ("#<Enumerator::Lazy: " ++ acc ++ ":" ++ nm ++ argstr vis ++ ">"))
           | Nil -> wrap9 t acc)
        | Cons (_, t) -> wrap9 t acc) in
     let src = (match gv "@__lz_src" with VNil -> VNil | v -> v) in
     let ops = (match gv "@__lz_ops" with VArr aid -> deref aid | _ -> Nil) in
     wrap9 ops ("#<Enumerator::Lazy: " ++ inspect_w env world src ++ ">"))
  else
    // `Enumerator.new { |y| ... }` has no receiver to name: ruby prints the
    // Generator it wraps, address and all.
    (let mn = (match gv "@meth" with VStr h -> sget h | VSym sy -> sy | _ -> "") in
     if str_eq mn "" then
       "#<Enumerator: #<Enumerator::Generator:0x" ++ hex_pad16 oid ++ ">:each>"
     else
       "#<Enumerator: " ++ inspect_w env world (gv "@recv") ++ ":" ++ mn
       ++ argstr (match gv "@eargs" with VArr aid -> deref aid | _ -> Nil) ++ ">")


// allocate an object, then run initialize if the class defines one.
// Howard Hinnant's civil_from_days: the calendar date for a day count since
// the epoch. Time.now would otherwise store epoch seconds while Time.new
// stores the packed ordinal below — two encodings in one ivar.

// the packed ordinal for an epoch-seconds instant (Time.now / Time.at).
// the epoch seconds behind a Time value (the @__epoch ivar when it was built
// from one, else derived from the packed ordinal).
// floor division / modulo, so a pre-1970 epoch still lands on the right day.
// day of the year, 1-based.
// epoch seconds from the ordinal -- an identity since the ordinal became epoch
// seconds, kept because its callers name the intent.
// days since 1970-01-01 (Hinnant's algorithm, the inverse of civil_from_days).
// a fresh Time object at these epoch seconds.
// The ordinal IS epoch seconds now. It used to be a positional packing --
// ((((y*13+m)*32+d)*24+h)*60+mi)*60+s -- which needs 37 bits for the year 2026
// and silently wrapped on the 32-bit backend: Time.now.year answered -4 on the
// RV32 machine while every 64-bit backend answered 2026. Epoch seconds are just
// as monotonic (that is what makes the packing comparable at all), the epoch
// conversions become identities, and the 32-bit range becomes 1901..2038 -- the
// same boundary 32-bit Unix has, instead of "wraps somewhere past 1971".

// the calendar parts back out of the ordinal (epoch seconds).

// encode Time.new(y[,m,d,h,mi,s]) args into the ordinal (epoch seconds).

// the ordinal of a Time object (its @__t ivar), or a sentinel if absent.

// --- Marshal.load ---------------------------------------------------------
// A loader for the subset a data file actually uses: nil / true / false,
// Integer, Symbol (with the back-reference table), String, Array, Hash,
// Float, and the ivar wrapper that carries a String's encoding. Anything
// else (an object, a link, a Bignum, a user class) names its own tag in the
// error rather than loading something wrong.
// String#to_i / #to_f read as far as they can and answer 0 when that is
// nowhere: `"".to_i`, `"abc".to_i` and `"12abc".to_i` are 0, 0 and 12 in ruby,
// where a strict parse raises. Underscores between digits are ignored, as in a
// literal.
// keep in step with the top-level is_ws_ch: \v and \f are whitespace too
// (this shadowing copy lacked them, so "\v1.2".to_f read nothing).







// Marshal's packed integer: one byte carries the small values, and 1..4
// following bytes (little-endian) the rest -- a negative count meaning the
// value is that many bytes below 256^n.

and mrsh_val = fn world -> fn (s: str) -> fn (i: int) ->
  let t = char_at s i in
  if str_eq t "0" then (VNil, i + 1)
  else if str_eq t "T" then (VBool true, i + 1)
  else if str_eq t "F" then (VBool false, i + 1)
  else if str_eq t "i" then (let (n, j) = mrsh_long s (i + 1) in (VInt n, j))
  else if str_eq t ":" then
    (let (n, j) = mrsh_long s (i + 1) in
     let nm = substring s j (j + n) in
     let _ = map_set mrsh_syms (str_of_int (map_len mrsh_syms)) (mkstr nm) in
     (VSym nm, j + n))
  else if str_eq t ";" then
    (let (k, j) = mrsh_long s (i + 1) in
     ((if map_has mrsh_syms (str_of_int k)
       then (match map_get mrsh_syms (str_of_int k) with VStr h -> VSym (sget h) | _ -> VNil)
       else VNil), j))
  else if str_eq t "\"" then
    // a bare string is BINARY; only the `I` wrapper below says otherwise.
    (let (n, j) = mrsh_long s (i + 1) in
     let v = mkstr (substring s j (j + n)) in
     let _ = (match v with VStr h -> senc_set h "ASCII-8BIT" | _ -> ()) in
     (v, j + n))
  else if str_eq t "f" then
    (let (n, j) = mrsh_long s (i + 1) in
     let txt = substring s j (j + n) in
     ((if str_eq txt "inf" then VFlt (1.0 / 0.0)
       else if str_eq txt "-inf" then VFlt (0.0 - 1.0 / 0.0)
       else if str_eq txt "nan" then VFlt (0.0 / 0.0)
       else VFlt (float_of_str txt)), j + n))
  else if str_eq t "[" then
    (let (n, j) = mrsh_long s (i + 1) in
     let (xs, j2) = mrsh_vals world s j n Nil in
     (arr_new xs, j2))
  else if ord t == 123 then
    (let (n, j) = mrsh_long s (i + 1) in
     let (xs, j2) = mrsh_vals world s j (n * 2) Nil in
     (mkhash (hash_merge Nil xs), j2))
  // `I` wraps an object in its instance variables; for a String they are the
  // encoding, which mere-ruby tracks separately, so the pairs are consumed
  // and dropped.
  else if str_eq t "I" then
    (let (v, j) = mrsh_val world s (i + 1) in
     let (n, j2) = mrsh_long s j in
     let j3 = mrsh_ivars world s j2 n v in
     (v, j3))
  else
    (let _ = raise_exc world "TypeError" ("marshal data too short or unsupported (tag " ++ t ++ ")") in (VNil, i + 1))

and mrsh_vals = fn world -> fn (s: str) -> fn (i: int) -> fn (n: int) -> fn (acc: Val list) ->
  if n <= 0 then (rev_app acc Nil, i)
  else (let (v, j) = mrsh_val world s i in mrsh_vals world s j (n - 1) (Cons (v, acc)))
// the ivar pairs of an `I`-wrapped object. For a String the only one that
// carries meaning here is the encoding: `E` true/false is UTF-8/US-ASCII,
// and `encoding` names it outright. The rest are consumed and dropped.
and mrsh_ivars = fn world -> fn (s: str) -> fn (i: int) -> fn (n: int) -> fn (owner: Val) ->
  if n <= 0 then i
  else (let (k, j) = mrsh_val world s i in
        let (v, j2) = mrsh_val world s j in
        let _ = (match owner with
                 | VStr h ->
                   (match k with
                    | VSym kn ->
                      // `E false` is US-ASCII, which inspects like BINARY
                      // (ruby escapes \xNN there, not \uXXXX).
                      (if str_eq kn "E" then senc_set h (match v with VBool true -> "UTF-8" | _ -> "US-ASCII")
                       else if str_eq kn "encoding" then (match v with VStr eh -> senc_set h (sget eh) | _ -> ())
                       else ())
                    | _ -> ())
                 | _ -> ()) in
        mrsh_ivars world s j2 (n - 1) owner)

// ---- Marshal.dump: the writer half of the same subset -------------------
// The length/count encoding: 0 is one zero byte, a small number rides in one
// byte biased by 5, and anything else is a signed byte count followed by that
// many little-endian bytes.



// a symbol is written out once; later mentions are ";" plus its index.

and mrsh_dump_val = fn world -> fn (v: Val) ->
  match v with
  | VNil -> "0"
  | VBool b -> (if b then "T" else "F")
  | VInt n -> "i" ++ mrsh_dump_long n
  | VSym nm -> mrsh_dump_sym nm
  | VFlt f -> (let t = mrsh_float_text f in "f" ++ mrsh_dump_long (str_len t) ++ t)
  | VStr h ->
    // a BINARY string is written bare; any other encoding rides in the `I`
    // wrapper as the :E ivar (true = UTF-8), which is what load reads back.
    (let body = sget h in
     let enc = senc_get h in
     let raw = "\"" ++ mrsh_dump_long (str_len body) ++ body in
     if str_eq enc "ASCII-8BIT" then raw
     else if str_eq enc "UTF-8" || str_eq enc "US-ASCII" then
       "I" ++ raw ++ mrsh_dump_long 1 ++ mrsh_dump_sym "E" ++ (if str_eq enc "UTF-8" then "T" else "F")
     else "I" ++ raw ++ mrsh_dump_long 1 ++ mrsh_dump_sym "encoding"
          ++ "\"" ++ mrsh_dump_long (str_len enc) ++ enc)
  | VArr id -> (let xs = deref id in "[" ++ mrsh_dump_long (vals_len xs 0) ++ mrsh_dump_vals world xs)
  | VHsh h ->
    // the pair list is flat: [k1, v1, k2, v2, ...], so the count is half of it
    (let xs = hderef h in "\{" ++ mrsh_dump_long (vals_len xs 0 / 2) ++ mrsh_dump_vals world xs)
  | _ -> (let _ = raise_exc world "TypeError" ("no _dump_data is defined for class " ++ class_name v) in "")

// Marshal writes a float as its shortest decimal digits: no trailing ".0", an
// exponent with neither "+" nor leading zeros (3.0e-05 is "3e-5"), and the
// exponent form whenever the plain one would need trailing zeros (100.0 is
// "1e2", 123000.0 is "1.23e5", but 105.0 stays "105").

// an integral value whose digits end in zeros is written in exponent form.







and mrsh_dump_vals = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> ""
  | Cons (h, t) -> mrsh_dump_val world h ++ mrsh_dump_vals world t

and mrsh_dump = fn world -> fn (v: Val) ->
  let _ = map_clear mrsh_dsyms in
  chr 4 ++ chr 8 ++ mrsh_dump_val world v

and mrsh_load = fn world -> fn (s: str) ->
  if str_len s < 3 then raise_exc world "ArgumentError" "marshal data too short"
  else if (if mrsh_at s 0 == 4 && mrsh_at s 1 <= 8 then false else true) then
    raise_exc world "TypeError" "incompatible marshal file format"
  else
    (let _ = map_clear mrsh_syms in
     let (v, _) = mrsh_val world s 2 in v)

// a Thread::Backtrace::Location for the file being executed. The class is
// registered on first use, with the readers ruby's own has.
// The call stack as ruby writes it: "file:line:in `meth\'", innermost first.
// Entry i is the line the call at depth i was made ON, with the name of the
// frame that MADE it -- which is one depth further out, so the line and the name
// come from different indices. Depth 0 was called from the top level, which ruby
// labels <main>.
// caller(n) drops n frames, counting the current one as 0; the default is 1,
// which is why `caller` starts at the frame that called us.
// `caller(arg)` / `caller_locations(arg)`: the argument SELECTS from the full
// frame list, and ruby's own rule is the shortest statement of it --
// `caller(x)` is `caller(0)[x]` for a Range and `caller(0)[x..]` for an
// Integer. Ranges were ignored here, so `caller(2..4)` answered the whole
// stack.
// ⚠ the boundary decides between two DIFFERENT answers, and both occur:
//     caller(depth)      []     an empty Array
//     caller(depth + 1)  nil    no Array at all
//   Measured at exactly the depth, because that is the only input that tells
//   those two apart.
// ...and the two-argument form, `caller(skip, length)`. caller_locations kept
// its length and #caller dropped it -- one pair of arguments, two readers, and
// only one of them read both.
// caller / caller_locations coerce their arguments to Integer -- #to_int for an
// object, truncation for a Float, TypeError for anything else -- but a RANGE is
// the argument, not a number, and must reach caller_pick untouched.
and caller_args = fn env -> fn world -> fn (args: Val list) ->
  (match args with
   // ⚠ a RANGE's bounds are coerced too: `caller_locations(1.1..1.1)` is
   //   `caller(1..1)`. Passing the range through untouched left Float bounds
   //   unmatched by caller_pick, which then read them as "no bound" and
   //   answered the whole stack.
   | Cons (VRange (VFlt lo9, VFlt hi9, ex9), r9) ->
     Cons (VRange (VInt (int_of_float lo9), VInt (int_of_float hi9), ex9), r9)
   | Cons (VRange (VFlt lo9, hi9, ex9), r9) -> Cons (VRange (VInt (int_of_float lo9), hi9, ex9), r9)
   | Cons (VRange (lo9, VFlt hi9, ex9), r9) -> Cons (VRange (lo9, VInt (int_of_float hi9), ex9), r9)
   | Cons (VRange (_, _, _), _) -> args
   | Nil -> args
   | _ ->
     // ⚠ the refusal is written HERE rather than in a helper. Three shapes of
     //   a `caller_int_ck world v` helper -- recursive over the list,
     //   list-returning, and a single non-recursive value check -- each made
     //   the Mere compiler stop returning from `-c`: 35 seconds became minutes.
     //   Bisected to the CALL, not the definition: with the function defined
     //   and never called, the emit finished normally. PAIN.md's
     //   type-inference cliff, and inlining is the way around it.
     // caller takes at most two, so both positions are spelled out flat.
     // ⚠ a Float TRUNCATES here; it is not a refusal. `caller(1.1, 1.1)` is
     //   `caller(1, 1)`, and coerce_int_args leaves Floats alone (it converts
     //   objects through #to_int), so the refusal below was catching them.
     (match (match coerce_int_args env world args with
             | Cons (VFlt f9, Cons (VFlt g9, r9)) -> Cons (VInt (int_of_float f9), Cons (VInt (int_of_float g9), r9))
             | Cons (VFlt f9, r9) -> Cons (VInt (int_of_float f9), r9)
             | Cons (a9, Cons (VFlt g9, r9)) -> Cons (a9, Cons (VInt (int_of_float g9), r9))
             | other9 -> other9) with
      | Cons (VInt a9, Cons (VInt b9, r9)) -> Cons (VInt a9, Cons (VInt b9, r9))
      | Cons (VInt a9, Cons (VBig b9, r9)) -> Cons (VInt a9, Cons (VBig b9, r9))
      // ⚠ the two positions are NOT symmetric: a nil FIRST argument is refused
      //   ("no implicit conversion from nil to integer") and a nil LENGTH means
      //   "no limit" and is fine. I had applied the first position's rule to
      //   the second by symmetry, without asking -- `caller(1, nil)` then
      //   raised where ruby answers the whole stack.
      | Cons (VInt a9, Cons (VNil, r9)) -> Cons (VInt a9, (Nil : Val list))
      | Cons (VInt a9, Cons (bad9, r9)) ->
        (let _ = raise_exc world "TypeError"
                   ("no implicit conversion of " ++ class_name bad9 ++ " into Integer") in
         Cons (VInt a9, Cons (bad9, r9)))
      | Cons (VInt a9, Nil) -> Cons (VInt a9, (Nil : Val list))
      | Cons (VBig a9, r9) -> Cons (VBig a9, r9)
      | Cons (VNil, r9) ->
        (let _ = raise_exc world "TypeError" "no implicit conversion from nil to integer" in
         Cons (VNil, r9))
      | Cons (bad9, r9) ->
        (let _ = raise_exc world "TypeError"
                   ("no implicit conversion of " ++ class_name bad9 ++ " into Integer") in
         Cons (bad9, r9))
      | Nil -> (Nil : Val list)))
// ...and whatever #to_int did not turn into an Integer is refused, in ruby's
// words -- nil has its own wording, which is why it is not the general one.
// ⚠ this ANSWERS THE LIST rather than unit. Written as `fn ... -> unit` and
//   called through `let _ = ... in cs9`, the Mere compiler stopped returning
//   from `-c` at all (35s became minutes; bisected by removing this one call).
//   Same family as PAIN.md's type-inference cliff.
// ...and whatever #to_int did not turn into an Integer is refused, in ruby's
// words -- nil has its own wording, which is why it is not the general one.
// ⚠ NOT recursive, and checks one value. A recursive version over the list --
//   in both the unit-returning and the list-returning shape -- made the Mere
//   compiler stop returning from `-c` at all: 35 seconds became minutes, twice,
//   bisected each time by removing the single call. Same family as PAIN.md's
//   type-inference cliff. Two arguments is the whole surface here, so the two
//   are checked by name at the call site.

// One Location per frame, from the same per-depth arrays `caller` reads. The
// previous version answered ONE location with an empty label and lineno 0, and
// said in its comment that there was no call stack and no line tracking to build
// them from -- true when it was written, and not true since the frames and the
// line markers landed. A comment that explains why something cannot be done
// outlives the reason.
and caller_loc_list = fn world -> fn (i: int) ->
  if i < 0 then (Nil : Val list)
  else Cons (loc_obj world (frame_file i) (frame_line i) (frame_label_at i), caller_loc_list world (i - 1))

and caller_locs = fn world -> fn (skip: int) -> fn (want: int) ->
  let cd = caller_depth () in
  let here = loc_obj world (cur_file ()) (cur_line ())
               (if cd <= 0 then "<main>" else meth_label (cur_meth ())) in
  let all = (if cd <= 0 then Cons (here, (Nil : Val list)) else Cons (here, caller_loc_list world (cd - 1))) in
  (if want < 0 then vdrop all skip else vtake (vdrop all skip) want)


// The recorded backtrace is a list of "path:line:in 'label'" strings (that is
// what ruby's #backtrace answers too), and #backtrace_locations wants the same
// frames as objects. Reading them back is the only way to answer both from one
// record.
and bt_locs_of = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> (Nil : Val list)
  | Cons (VStr h9, t9) ->
    (let s9 = sget h9 in
     let c1 = bt_last_colon s9 (str_len s9) 0 in
     let c0 = bt_last_colon s9 c1 0 in
     let pth = (if c0 > 0 then substring s9 0 c0 else s9) in
     let lno = (if c0 > 0 && c1 > c0 then bt_digits s9 (c0 + 1) c1 0 else 0) in
     let lbl = (let i9 = bt_quote_at s9 0 in
                if i9 < 0 then "" else substring s9 (i9 + 1) (bt_quote_end s9 (i9 + 1))) in
     Cons (loc_obj world pth lno lbl, bt_locs_of world t9))
  | Cons (_, t9) -> bt_locs_of world t9


and loc_obj = fn world -> fn (path: str) -> fn (line: int) -> fn (label: str) ->
  let (meths, sup, ocls, ivars) = world in
  let cls = "Thread::Backtrace::Location" in
  let _ = (if map_has consts cls then ()
           else (let _ = map_set consts cls (VClass cls) in
                 let _ = add_attrs world cls "r" (Cons ("path", Cons ("lineno", Cons ("label", Cons ("absolute_path", Nil))))) in
                 ())) in
  (match new_obj world cls Nil with
   | VObj id ->
     (let _ = map_set ivars (str_of_int id ++ "@path") (mkstr path) in
      let _ = map_set ivars (str_of_int id ++ "@absolute_path") (mkstr path) in
      let _ = map_set ivars (str_of_int id ++ "@lineno") (VInt line) in
      let _ = map_set ivars (str_of_int id ++ "@label") (mkstr label) in
      VObj id)
   | other -> other)


and new_obj = fn world -> fn (cls: str) -> fn (args: Val list) ->
  // built-in mutable containers construct their store-backed value, not a
  // generic object (so Array.new / Hash.new via any dispatch path work).
  if str_eq cls "Hash" then
    (let hv = mkhash Nil in (match args with Cons (d, _) -> (match hv with VHsh id -> let _ = hdflt_set id d in hv | _ -> hv) | _ -> hv))
  else if str_eq cls "Array" then
    (match args with Cons (VInt n, Cons (d, _)) -> arr_new (val_repeat n d) | Cons (VInt n, _) -> arr_new (val_repeat n VNil) | _ -> arr_new Nil)
  else if str_eq cls "String" then
    // String.new([str] [, encoding: e, capacity: n]): no source means an
    // empty BINARY string; the encoding keyword overrides the source's; a
    // non-string source refuses by type; capacity is accepted and ignored.
    (let opts = (let rec last9 = fn (xs: Val list) -> fn (acc: Val) ->
                   (match xs with Nil -> acc | Cons (VHsh oh, t9) -> last9 t9 (VHsh oh) | Cons (_, t9) -> last9 t9 acc) in
                 last9 args VNil) in
     let encv = (match opts with
                 | VHsh oh -> (match hash_lookup (hderef oh) (VSym "encoding") with (true, v9) -> v9 | _ -> VNil)
                 | _ -> VNil) in
     let ename = (match encv with
                  | VStr eh -> enc_find_canon (sget eh)
                  | VObj oid9 -> (if map_has enc_name (str_of_int oid9) then map_get enc_name (str_of_int oid9) else "")
                  | _ -> "") in
     match args with
     | Cons (VStr h, _) ->
       (let c = mkstr (sget h) in
        (match c with
         | VStr id -> (let _ = senc_set id (if str_eq ename "" then senc_get h else ename) in c)
         | _ -> c))
     | Cons (VHsh _, _) ->
       (let c = mkstr "" in
        (match c with
         | VStr id -> (let _ = senc_set id (if str_eq ename "" then "ASCII-8BIT" else ename) in c)
         | _ -> c))
     | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
     | Nil ->
       (let c = mkstr "" in
        (match c with
         | VStr id -> (let _ = senc_set id (if str_eq ename "" then "ASCII-8BIT" else ename) in c)
         | _ -> c)))
  // Time.new(y[,m,d,h,mi,s]) — a minimal, comparable Time object: a Time-class
  // VObj carrying a monotonic ordinal ivar (enough for <=> and range membership).
  else if str_eq cls "Time" then
    (let (meths, sup, ocls, ivars) = world in
     let id = alloc_oid ocls in
     let _ = map_set ocls id "Time" in
     let _ = map_set ivars (str_of_int id ++ "@__t") (VInt (time_ord args)) in
     let _ = map_set time_inst (str_of_int id) (time_ord args) in
