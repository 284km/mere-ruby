// Ruby records whatever was in flight AT THE RAISE as the new exception's
// cause. The lightweight class-and-message pair has nowhere to keep one, so
// `raise "boom"` inside a rescue lost it -- and #cause answered nil, which is
// also the answer when there is genuinely nothing, so the loss was invisible.
// Promote exactly those raises to a real exception OBJECT, which does have
// somewhere to put it: same class, same message, plus @__cause. A raise with
// nothing in flight -- almost every raise a program makes -- keeps the cheap
// representation, so this costs an object only where ruby has something to
// record.
// ⚠ A CAUSE MUST KEEP ITS BACKTRACE -- WITHOUT BECOMING A DIFFERENT OBJECT.
// The cheap VExc representation has no ivars, so its backtrace lives in the
// slot beside the LAST raise, and the raise that makes it a cause overwrites
// that slot; the innermost exception in a chain then reported no frames at
// all. Promoting it to an object gave it somewhere to keep them and BROKE
// `e.dup.cause.should.equal?(cause)` -- the cause a program already holds has
// to stay the very same value. So the frames are recorded beside the cause,
// on the exception that owns the link, and the report reads them from there.


// An Errno class puts the system's own text in front of whatever message it is
// given: `raise Errno::ENOENT, "boom"` reads "No such file or directory - boom",
// and with no message it reads the text alone. The table covers exactly the
// names registered as classes (reg_cls_list) -- the two lists have to agree, and
// `errno_desc_missing` is what a gate asks to find out that they do not, since a
// name with a class and no text would silently lose its prefix instead of
// failing.
// the nearest Errno:: class above this one ("" if none): an anonymous subclass
// of Errno::ENOENT is still a "No such file or directory".


// Every registered Errno name that has no text above. Empty is the only correct
// answer; anything in it is a name whose messages are quietly short.



// does exception class `ecls` match one of the rescued classes (walking
// the superclass chain)? A bare rescue (no classes) catches StandardError.



// class names of the VClass values in a list (for rescue *arr).

// expand "*var" (rescue *var) into the array's class names, and "@rexpr~N"
// (a non-constant class expression) by evaluating the stashed expression at
// match time. A "*"-prefixed sentinel splats the evaluated array.
and expand_rescue_classes = fn env -> fn world -> fn blk -> fn (classes: str list) ->
  match classes with
  | Nil -> Nil
  | Cons (c, rest) ->
    if str_len c > 0 && str_eq (char_at c 0) "*" then
      let inner = substring c 1 (str_len c) in
      // "*@rexpr~N": splat the evaluated expression; "*var": splat the local.
      let arr = if str_len inner > 0 && str_eq (char_at inner 0) "@" && str_contains inner "rexpr~"
                then eval_e env world blk (map_get resc_exprs (substring inner 7 (str_len inner)))
                else (if lv_has env inner then lv_get env inner else VNil) in
      (match arr with
       | VArr id ->
         (let names = class_names_of (deref id) in
          let rest2 = expand_rescue_classes env world blk rest in
          match names with
          // An EMPTY splat rescues NOTHING in ruby -- `rescue *[]` is not a bare
          // `rescue`, which rescues StandardError. Both arrived here as an empty
          // list, so this clause caught everything and swallowed the exception:
          // bundler writes `rescue *[const_get_safely(:ENOTSUP, Errno)].compact`,
          // and when that constant is absent the array is empty. A name nothing
          // can be keeps the two apart.
          | Nil -> Cons ("(empty rescue splat)", rest2)
          | _ -> list_append_str names rest2)
       | _ -> expand_rescue_classes env world blk rest)
    else if str_len c > 6 && str_eq (substring c 0 7) "@rexpr~" then
      // a non-constant class expression: evaluate; a Class/Module contributes
      // its name, anything else is a TypeError (class or module required).
      (match eval_e env world blk (map_get resc_exprs (substring c 7 (str_len c))) with
       | VClass cn -> Cons (cn, expand_rescue_classes env world blk rest)
       | _ -> (let _ = raise_exc world "TypeError" "class or module required for rescue clause" in Nil))
    // A plain name in a rescue clause is a CONSTANT, and it resolves through the
    // lexical scope like any other: inside `module Ns`, `rescue MyError` means
    // `Ns::MyError`. It used to be passed through as the bare text, so the clause
    // never matched the class that was raised -- `Bundler.settings` rescues its
    // own `GemfileNotFound` that way, which is why every `bundle` subcommand
    // answered "Could not locate Gemfile" (ruby answers the settings object).
    // A name that resolves to nothing is kept as written.
    else (let cref = (if lv_has env "__cref" then (match lv_get env "__cref" with VStr s2 -> sget s2 | _ -> "") else "") in
          let r = named_class_of_al env world blk cref c in
          Cons ((if map_has consts r || map_has modules r then r else c),
                expand_rescue_classes env world blk rest))

and run_rescues = fn env -> fn world -> fn blk -> fn (exc: Val) -> fn rescues ->
  match rescues with
  | Nil -> re_raise world exc
  | Cons (rc, rest) ->
    let (classes0, var, handler) = rc in
    let classes = expand_rescue_classes env world blk classes0 in
    if rescue_matches world exc classes then
      let _ = if str_eq var "" then () else lv_set env var exc in
      // $! holds the exception being handled (so a bare `raise` re-raises it);
      // run_begin restores $! to its pre-begin value when the construct ends.
      let _ = map_set globals "!" exc in
      run_stmts env world blk handler
    else run_rescues env world blk exc rest

// Kernel#exit / Kernel#abort raise a SystemExit: rescuable, `ensure` runs,
// and if nothing rescues it the top level exits with the carried status and
// prints nothing. They used to call the native exit right here, so
// `begin; exit 42; rescue SystemExit; end` ended the process -- which is what
// core/exception's status_spec and success_spec recorded as "no output
// before aborting".

// raise a built-in exception that CARRIES something -- the key a fetch could
// not find, the receiver a frozen write was aimed at, the tag a throw used.
// raise_exc builds a VExc, a class-and-message pair with nowhere to put a
// field, so every one of those readers answered nil for an exception the
// interpreter raised while answering correctly for one the program built.


// raise a specific built-in exception from inside the interpreter (e.g.
// ZeroDivisionError), setting "$exc" then unwinding via fail.

// run `theblk` and return the resulting Flow, so break/next inside the
// block reach the iterating method. Its params bind into a fresh frame
// chained to the env the block captured (so it still sees and mutates the
// enclosing locals); the body runs with `encl` as the active block so a
// yield inside it reaches the enclosing method's block.
// A block can carry more than one yblk marker (a literal that yields, later
// handed on as a proc): peel them all, innermost wins.
// the same peel, when only the parameter list matters (a block that becomes a
// method body: the marker is bookkeeping, not a parameter).

and run_block = fn world -> fn encl -> fn theblk -> fn (argvals: Val list) ->
  // consume any pending forwarded-block home: a `&proc` passed to a BUILTIN
  // (e.g. arr.each(&p)) sets pending_home but never reaches bind_params, so
  // clear it here to keep it from leaking into a later method's frame.
  let _ = if map_has pending_home "v" then map_delete pending_home "v" else () in
  // ...and the pending SOURCE PROC with it: it is only valid between
  // `m(&pr)`'s conversion and the method reading it. Once any block body
  // starts running, a `Hash.new { }` inside would otherwise pick up the proc
  // that was passed to the OUTER call (`instance_exec(&blk)` made every hash
  // built inside default to blk itself, which then ran again).
  let _ = if map_has pending_srcproc "v" then map_delete pending_srcproc "v" else () in
  let (has, params00, body, cenv) = theblk in
  // ⚠ A BLOCK INVOCATION IS A FRAME. ruby's backtrace carries
  // `block in <where the block was WRITTEN>` between the block body and
  // whatever yielded to it, and language/ensure asks for it by name. Pushed
  // with the same three maps a method frame uses; the depth is restored below,
  // beside blk_ok, which already runs on every exit path.
  // ⚠ the label comes from the DEFINING scope (cenv), not from the frame this
  //   is running in: `def y; yield; end; y { m }` is `block in <main>` in ruby
  //   because that is where the block is written, while the running frame is
  //   Object#y. lv_* walks the chain, so cenv resolves the defining method's
  //   __meth even from a nested block.
  let bcd9 = (if map_has struct_ctr "cd" then map_get struct_ctr "cd" else 0) in
  let blabel9 =
    (if lv_has cenv "__meth"
     then "block in "
          ++ (match (if lv_has cenv "__defcls" then lv_get cenv "__defcls" else VNil) with
              | VClass c9 -> c9 ++ "#"
              | _ -> "")
          ++ (match lv_get cenv "__meth" with VStr h9 -> sget h9 | _ -> "?")
     else "block in <main>") in
  let _ = map_set struct_ctr "cd" (bcd9 + 1) in
  let _ = map_set_si call_names_s bcd9 blabel9 in
  let _ = map_set call_lines bcd9 (cur_line ()) in
  let _ = map_set_si call_files_s bcd9 (cur_file ()) in
  // a proc/lambda that captured its defining method's block carries a yblk
  // marker: strip it and use that captured block as `encl` so `yield` inside
  // the proc body resolves to the defining method's block, not the caller's.
  // The block a `&param` BINDS to and the block `yield` RESOLVES to are two
  // different questions, and `encl` was answering both. The yblk marker means
  // "yield goes to the block captured where this proc was made" -- it says
  // nothing about &param, which is always the block given at the CALL SITE.
  // Binding &param from the stripped encl made `pr.call { }` hand the proc its
  // own defining block: inside a spec example that is the example's own block,
  // so `(one << two).call { }` ran the example again, forever.
  let encl_call = encl in
  // The env is born OUTSIDE the invocation's region (it comes from the pool and
  // may be captured; see blk_env_get), and whether it is pooled is read off the
  // raw param list: a `for` block's hidden "__f" param is first and carries no
  // marker (the markers start "__y", "__l" and "~").
  let pooled = (if is_for_params params00 then false else true) in
  let benv = if pooled then blk_env_get cenv else cenv in
  let prev_ok = (if map_has blk_ok "n" then map_get blk_ok "n" else 0) in
  let _ = map_set blk_ok "n" 0 in
  // ONE REGION PER BLOCK INVOCATION, from parameter stripping through the body
  // -- the same shape as region MCALL around a method body, for the same
  // reason. Everything an invocation builds and does not store (the stripped
  // and re-split param lists, the binding's scratch, dispatch strings, the
  // copies of each statement's value) used to land in the region current at
  // the ITERATOR's call site -- the enclosing statement's -- and be held until
  // the whole `each`/`times` returned: 267 MB for one 400k-iteration statement,
  // measured as that region's peak_cap. Wrapping the body alone moved nothing;
  // the binding was most of it. What matters leaves safely: locals are copied
  // into the env on store, the Flow value is copied out. A raise inside
  // unwinds through the region and is caught by the try_or, as a raise in the
  // body always was.
  let f = region BLK {
   try_or (fn (u: unit) ->
  let (encl, params0) = strip_yblk_markers encl params00 in
  // a lambda installed as a block carries a marker: strip it and enforce
  // strict arity (a plain block stays lenient).
  let is_lam = (match params0 with Cons (m, _) -> str_eq m lambda_blk_marker | _ -> false) in
  let params = if is_lam then (match params0 with Cons (_, rest) -> rest | _ -> params0) else params0 in
  // an explicit-empty param list (`{ || .. }` / `-> () { .. }`) runs with zero
  // params; the sentinel only served to reject numbered params at parse time.
  let params = (match params with Cons (m, Nil) -> if str_eq m empty_bp_marker then (Nil : str list) else params | _ -> params) in
  let _ = if is_lam then lambda_arity_check_args world params body argvals else () in
  // The block's params and the locals it first assigns are block-local, so
  // the body runs in a FRESH frame chained to the block's defining scope.
  // Names bound further out resolve through the chain and stay one shared
  // cell; the frame itself is what a proc/lambda created inside the block
  // captures, so those block-locals outlive this invocation (Ruby's closure
  // semantics). Nothing has to be torn down afterwards — the frame is simply
  // unreachable once the block returns, unless a closure kept it.
  // `for` is the exception: it is not a scope in Ruby, so its desugared
  // block (a hidden "__f..." param) runs directly in the enclosing env and
  // leaves its loop variable and body locals behind, exactly as Ruby does.
  let _ = bind_block_params benv world encl_call (block_defaults body) params argvals is_lam in
  // A raising body used to need explicit cleanup here (restoring saved params
  // and dropping created locals) or the bindings leaked into the shared env
  // and were visible to later sibling blocks; with a per-invocation frame the
  // raise path cannot leak. The flag still distinguishes a raise from a
  // normal return so the exception is re-raised (details live in ivars "$exc").
  let r = block_body_flow benv world encl body in
   let _ = map_set blk_ok "n" 1 in
   r)
   (FRaise VNil) } in
  let ok = (if map_has blk_ok "n" then map_get blk_ok "n" else 0) == 1 in
  let _ = map_set blk_ok "n" prev_ok in
  // the block frame comes back off here, on every exit path (try_or has already
  // turned a raise into FRaise above).
  let _ = map_set struct_ctr "cd" bcd9 in
  // the env dies here unless a closure captured it (see blk_env_put). On every
  // exit path: try_or has already turned a raise into FRaise, so this runs
  // before the re-raise below. The Flow value `f` does not point into the
  // env's arena -- run_stmts copies each statement's value out of its own
  // region STMT block, into the region current here.
  let _ = if pooled then blk_env_put benv else () in
  if ok then f else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")

// `for` desugars to `each` with a hidden "__for" / "__forv" / "__f<n>" param
// and an assignment from it; Ruby's `for` shares the enclosing scope, so that
// block must not open a frame of its own.

// run a block body once, converting flow signals: break/next become Flows
// for the iterator; return keeps unwinding to the enclosing method; redo
// reruns the block body.
and block_body_flow = fn cenv -> fn world -> fn encl -> fn (body: Stmt list) ->
  // A block body runs inside its ITERATOR's evaluation: unrooted values are
  // in flight above it, so its statement boundaries are not safepoints.
  let _ = gc_unsafe_push () in
  let f = try_or (fn (u: unit) -> run_stmts cenv world encl body) (FRaise VNil) in
  let _ = gc_unsafe_pop () in
  match f with
  | FReturn v ->
    // a return from a block/proc returns from the frame that DEFINED it (a
    // method or an enclosing lambda call), targeted so it passes through any
    // method that merely yielded the block. Falls back to a plain return if
    // that frame is unknown or already gone (a proc whose home has returned).
    // __fid lives in the defining method's frame, so read it through the chain.
    let home = (if lv_has cenv "__fid" then (match lv_get cenv "__fid" with VInt t -> t | _ -> 0) else 0) in
    if home == 0 then flow_rethrow "return" v
    // ⚠ ...but a home frame that has already RETURNED cannot be returned
    //   through: that is ruby's LocalJumpError, carrying the value as
    //   #exit_value and :return as #reason. Falling back to a plain return
    //   unwound past every live frame and came out of the driver as an
    //   internal "(unhandled return)" -- `Proc.new { return 42 }.call` after
    //   its method returned is the shape, and `break` next door has raised
    //   here all along.
    else if (if map_has live_frames home then false else true) then
      (let _ = raise_exc_iv world "LocalJumpError" "unexpected return"
                 (Cons (("__exit_value", v), Cons (("__reason", VSym "return"), Nil))) in
       flow_rethrow "return" v)
    else flow_throw_returnret home v
  | FRaise _ ->
    if map_has flow_sig "k" then
      let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
      let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
      let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in

      if str_eq k "break" then FBreak v
      else if str_eq k "next" then FLoopNext v
      else if str_eq k "redo" then let _ = tick () in block_body_flow cenv world encl body
      else if str_eq k "retry" then FRaise (raise_exc world "SyntaxError" "Invalid retry")
      else flow_rethrow k v
    else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")
  | other -> other

// deep scan for local-assignment targets (stops at def/class boundaries;
// the hidden for-loop assignment is excluded so `for` keeps leaking).
and deep_targets = fn (body: Stmt list) ->
  match body with
  | Nil -> Nil
  | Cons (s, rest) -> list_append_str (stmt_targets s) (deep_targets rest)

and stmt_targets = fn (s: Stmt) ->
  match s with
  | SAssign (n, e) ->
    (match e with
     | EVar h ->
       // assignments from the hidden for-loop params leak by design.
       if str_len h > 2 && str_eq (substring h 0 3) "__f" then Nil else Cons (n, Nil)
     | _ -> Cons (n, Nil))
  | SLocalFrom (n, s2) -> Cons (n, stmt_targets s2)
  | SMultiAssign (ts, _) -> ts
  | SMultiAssignX (ts, _) -> x_target_names ts
  | SIf (clauses, els) -> list_append_str (clauses_targets clauses) (deep_targets els)
  | SWhile (_, b) -> deep_targets b
  | SCase (_, whens, els) -> list_append_str (whens_targets whens) (deep_targets els)
  | SCaseIn (_, clauses, _, els) -> list_append_str (clauses_pat_vars clauses) (list_append_str (clausesin_targets clauses) (deep_targets els))
  | SBegin (b, rescues, els, ens) ->
    list_append_str (deep_targets b)
      (list_append_str (rescues_targets rescues) (list_append_str (deep_targets els) (deep_targets ens)))
  | SAndThen (a, b) -> list_append_str (stmt_targets a) (stmt_targets b)
  | SOrElse (a, b) -> list_append_str (stmt_targets a) (stmt_targets b)
  // an expression statement can declare locals: `/re/ =~ s` (named captures)
  // and one-line pattern matching `x => pat` / `x in pat` — the latter even
  // when nested in a larger expression (`(x in pat).should == y`).
  | SExpr e -> expr_pat_vars e
  | _ -> Nil

// collect variables that an expression declares as locals: named captures from
// `=~`, and pattern variables from any nested one-line `=>` / `in`.
and expr_pat_vars = fn (e: Expr) ->
  match e with
  | EMatchBind (_, pat) -> pat_vars pat
  | EMatchTest (_, pat) -> pat_vars pat
  | EBin (o, a, b) ->
    let capt = if str_eq o "=~" then (match a with ERegex (pat, _) -> rx_capture_names pat 0 | _ -> Nil) else Nil in
    list_append_str capt (list_append_str (expr_pat_vars a) (expr_pat_vars b))
  | EUn (_, a) -> expr_pat_vars a
  | EMethod (recv, _, args) -> list_append_str (expr_pat_vars recv) (exprs_pat_vars args)
  | EMethodB (recv, _, args, _, _) -> list_append_str (expr_pat_vars recv) (exprs_pat_vars args)
  | ECall (_, args) -> exprs_pat_vars args
  | ECallB (_, args, _, _) -> exprs_pat_vars args
  | ETern (a, b, c) -> list_append_str (expr_pat_vars a) (list_append_str (expr_pat_vars b) (expr_pat_vars c))
  | EArr es -> exprs_pat_vars es
  | EHsh es -> exprs_pat_vars es
  | ESafe (recv, _, args) -> list_append_str (expr_pat_vars recv) (exprs_pat_vars args)
  | EAssign (_, v) -> expr_pat_vars v
  // a statement used as an expression (`case ... end.should ==`) declares the
  // targets that statement would — including a nested case/in's pattern vars.
  | EStmt s -> stmt_targets s
  | _ -> Nil
and exprs_pat_vars = fn (es: Expr list) ->
  match es with Nil -> Nil | Cons (h, t) -> list_append_str (expr_pat_vars h) (exprs_pat_vars t)

and clauses_targets = fn clauses ->
  match clauses with
  | Nil -> Nil
  | Cons (cl, rest) -> let (c, b) = cl in list_append_str (deep_targets b) (clauses_targets rest)

and whens_targets = fn whens ->
  match whens with
  | Nil -> Nil
  | Cons (w, rest) -> let (vs, b) = w in list_append_str (deep_targets b) (whens_targets rest)

and rescues_targets = fn rescues ->
  match rescues with
  | Nil -> Nil
  | Cons (rc, rest) ->
    let (cs, v, b) = rc in list_append_str (deep_targets b) (rescues_targets rest)

// A value's identity, for a guard that has to tell one PAIR from another. The
// reference types carry a handle; everything else is compared by what it prints,
// which is enough for a recursion guard (two equal immediates cannot defer to
// each other forever).


// block arity is lenient: missing args bind nil, extra args are dropped.
and bind_block_params = fn cenv -> fn world -> fn blk -> fn (bdefaults: (str * Expr) list) -> fn (params0: str list) -> fn (argvals0: Val list) -> fn (is_lam: bool) ->
  // numbered parameters: a block without explicit params binds _1.._9.
  let _ = (match params0 with
           | Nil -> bind_numbered cenv argvals0 1
           | _ -> ()) in
  // A block's own `&b` parameter binds the block given at the CALL SITE, the
  // same way a method's does -- the comment here used to claim blocks are not
  // re-passed through block params, and `proc {|x, &b| b.call(x) }.call(7) { }`
  // says otherwise (ruby answers 8; this answered NoMethodError on nil). It is
  // also what makes `Method#to_proc` able to carry a block to the method.
  let params = strip_block_params params0 in
  let _ = (let b = block_param_name params0 in
           if str_eq b "" then ()
           else map_set cenv b
                  (let (has, _, _, _) = blk in
                   if has then (let pid = map_len proc_store in
                                let _ = store_proc (str_of_int pid) blk in
                                VProc pid)
                   else VNil)) in
  // explicit block-locals (`|x; a, b|`, encoded ";name") start as fresh nil
  // locals in this frame and are excluded from positional binding; the outer
  // binding of the same name is untouched, so they do not leak.
  let _ = bind_block_locals cenv params in
  let params = drop_block_locals params in
  // `**kw` (keyword-splat) + explicit `key:` params share ONE trailing
  // kwarg-origin hash (`key:` / `**h`); a positional {...} stays positional
  // (Ruby 3 separation). Peel it once, bind the explicit keywords (a missing
  // required keyword raises ArgumentError), then give **kw the leftover keys.
  // The presence of any keyword param disables auto-splat.
  let dsname = dsplat_name params in
  let params = drop_dsplat params in
  let kws = kw_params params in
  let params = pos_params params in
  let want_kw = (match kws with Nil -> (if str_eq dsname "" then false else true) | _ -> true) in
  let (argvals0, kwhash) = if want_kw then peel_kw_hash argvals0 else (argvals0, (Nil : Val list)) in
  let _ = bind_block_kws cenv world bdefaults kws kwhash in
  let _ = if str_eq dsname "" then () else map_set cenv dsname (mkhash (kwhash_drop kwhash (kw_names_of kws))) in
  // auto-splat: a block with 2+ params given a single value destructures
  // an Array directly, or an object via to_ary. Lambdas do NOT auto-splat —
  // a single argument stays a single argument (with strict arity).
  let argvals =
    (if is_lam then argvals0 else
    (match kws with
     | Cons (_, _) -> argvals0
     | Nil ->
       (match params with
        | Cons (_, Cons (_, _)) ->
          (match argvals0 with
           | Cons (VArr id, Nil) -> deref id
           | Cons (VObj oid, Nil) ->
             // Ruby's protocol: always call respond_to?(:to_ary) first, then
             // to_ary. A user respond_to? (or respond_to_missing?) is honoured
             // so a method_missing/respond_to? mock works; we do NOT shortcut on
             // a real to_ary, because the respond_to? call itself is observable.
             (let (m2, sp2, ocls2, iv2) = world in
              let ocl2 = map_get ocls2 oid in
              let can = (if has_meth world ocl2 "respond_to?" then
                           truthy (invoke_val_c cenv world blk (VObj oid) "respond_to?" (Cons (VSym "to_ary", Nil)) false)
                         else if responds world (VObj oid) "to_ary" then true
                         else if has_meth world ocl2 "respond_to_missing?" then
                           truthy (invoke_val_c cenv world blk (VObj oid) "respond_to_missing?" (Cons (VSym "to_ary", Cons (VBool false, Nil))) false)
                         else false) in
              if can then
                (match invoke_val_c cenv world blk (VObj oid) "to_ary" Nil false with
                 | VArr aid -> deref aid
                 | VNil -> argvals0
                 | other -> (let _ = raise_exc world "TypeError" ("can't convert " ++ class_name (VObj oid) ++ " to Array (" ++ class_name (VObj oid) ++ "#to_ary gives " ++ class_name other ++ ")") in argvals0))
              else argvals0)
           | _ -> argvals0)
        | _ -> argvals0))) in
  // defaults (from the block body's nil-check prologue) drive the Ruby
  // fill order: leading requireds, then trailing requireds, then optionals.
  if has_splat params then
    let before = take_until_splat params in
    let after = after_splat params in
    let sname = splat_name params in
    let pre = req_pre before bdefaults in
    let opts = drop_req_pre before bdefaults in
    let npre = list_str_len pre in
    let nopt = list_str_len opts in
    let na = list_str_len after in
    let nv = vlen argvals in
    let middle = nv - npre - na in
    let middle = if middle < 0 then 0 else middle in
    let kopt = if middle > nopt then nopt else middle in
    let sc = middle - kopt in
    let _ = bind_seq cenv world pre (vtake argvals npre) in
    let _ = bind_defaulted cenv world blk opts bdefaults (vtake (vdrop argvals npre) kopt) in
    let _ = if str_eq sname "" then () else map_set cenv sname (arr_new (vtake (vdrop argvals (npre + kopt)) sc)) in
    let _ = bind_seq cenv world after (vdrop argvals (npre + kopt + sc)) in
    ()
  else
    let pre = req_pre params bdefaults in
    let rest1 = drop_req_pre params bdefaults in
    let opts = opt_run rest1 bdefaults in
    let post = drop_opt_run rest1 bdefaults in
    let npre = list_str_len pre in
    let nopt = list_str_len opts in
    let npost = list_str_len post in
    let nv = vlen argvals in
    let kopt0 = nv - npre - npost in
    let kopt0 = if kopt0 < 0 then 0 else kopt0 in
    let kopt = if kopt0 > nopt then nopt else kopt0 in
    let _ = bind_seq cenv world pre (vtake argvals npre) in
    let _ = bind_defaulted cenv world blk opts bdefaults (vtake (vdrop argvals npre) kopt) in
    let _ = bind_seq cenv world post (vdrop argvals (npre + kopt)) in
    ()



and bind_block_seq = fn cenv -> fn world -> fn (params: str list) -> fn (argvals: Val list) ->
  match params with
  | Nil -> ()
  | Cons (p, ps) ->
    (match argvals with
     | Nil -> let _ = bind_one_bparam cenv world p VNil in bind_block_seq cenv world ps Nil
     | Cons (a, rest) -> let _ = bind_one_bparam cenv world p a in bind_block_seq cenv world ps rest)

and bind_one_bparam = fn cenv -> fn world -> fn (p: str) -> fn (v: Val) ->
  // a ;block-local always starts nil (it never takes an argument).
  if str_len p > 0 && str_eq (char_at p 0) ";" then
    let _ = map_set cenv (substring p 1 (str_len p)) VNil in ()
  else if str_len p > 0 && str_eq (char_at p 0) "(" then
    bind_destructure cenv world (substring p 1 (str_len p - 1)) v
  else let _ = map_set cenv p v in ()

// bind a destructure spec ("a,(b,c),*r") against a value. An Array spreads; a
// non-Array is coerced via #to_ary (Ruby's destructure protocol), wrapping a
// non-responding object as [obj] and raising TypeError on a bad #to_ary.
and bind_destructure = fn cenv -> fn world -> fn (spec: str) -> fn (v: Val) ->
  let parts = spec_split spec 0 0 "" Nil in
  let vals = (match v with VArr id -> deref id | other -> coerce_massign cenv world other false) in
  bind_spec_parts cenv world parts vals

and bind_spec_parts = fn cenv -> fn world -> fn (parts: str list) -> fn (vals: Val list) ->
  match parts with
  | Nil -> ()
  | Cons (p, ps) ->
    if str_len p > 0 && str_eq (char_at p 0) "*" then
      // splat takes what the trailing fixed parts don't need.
      let nafter = list_str_len ps in
      let take = vlen vals - nafter in
      let take = if take < 0 then 0 else take in
      let nm = substring p 1 (str_len p) in
      let _ = if str_eq nm "" then () else map_set cenv nm (arr_new (vtake vals take)) in
      bind_spec_parts cenv world ps (vdrop vals take)
    else
      (match vals with
       | Nil -> let _ = bind_spec_one cenv world p VNil in bind_spec_parts cenv world ps Nil
       | Cons (a, rest) -> let _ = bind_spec_one cenv world p a in bind_spec_parts cenv world ps rest)

and bind_spec_one = fn cenv -> fn world -> fn (p: str) -> fn (v: Val) ->
  if str_len p > 0 && str_eq (char_at p 0) "(" then
    bind_destructure cenv world (substring p 1 (str_len p - 1)) v
  else if str_eq p "" then ()
  else let _ = map_set cenv p v in ()

// the leaf variable names bound by a destructure spec ("a,(b,c),*r" -> a,b,c,r).
and spec_names = fn (spec: str) -> spec_names_parts (spec_split spec 0 0 "" Nil)
and spec_names_parts = fn (parts: str list) ->
  match parts with
  | Nil -> Nil
  | Cons (p, ps) ->
    let names = (if str_len p > 0 && str_eq (char_at p 0) "(" then spec_names (substring p 1 (str_len p - 1))
                 else if str_len p > 0 && str_eq (char_at p 0) "*" then (let nm = substring p 1 (str_len p) in if str_eq nm "" then (Nil : str list) else Cons (nm, Nil))
                 else if str_eq p "" then (Nil : str list)
                 else Cons (p, Nil)) in
    list_append_str names (spec_names_parts ps)

// split a spec on top-level commas ("a,(b,c),*r" -> [a; (b,c); *r]).

// block predicates on a list (run the block per element, short-circuiting).
// bsearch over a list (val_nth is O(n) but fine for spec sizes). The block
// returns either a bool (find-minimum: first true) or an Integer (find-any:
// 0 = hit, <0 search left, >0 search right). Returns the matching index or -1.
// Answers (index, broke, break_value): a `break` in the block leaves BSEARCH,
// so it cannot be read as a search answer (flow_value alone turned `break 1234`
// into "the block said 1234" and the search went on). A NUMERIC result is a
// three-way comparison against zero -- including a FLOAT one, which used to
// fall in the catch-all and always search left -- and anything that is not
// numeric, true, false or nil is ruby's TypeError.
and arr_bsearch = fn world -> fn encl -> fn theblk -> fn (vec: Val list) -> fn (lo: int) -> fn (hi: int) ->
  if lo >= hi then
    (if lo < val_list_len vec then arr_bsearch_check world encl theblk vec lo
     else (0 - 1, false, VNil))
  else
    let mid = (lo + hi) / 2 in
    (match run_block world encl theblk (Cons (val_nth vec mid, Nil)) with
     | FBreak bv -> (0 - 1, true, bv)
     | fl ->
       (match flow_value fl with
        | VBool true -> arr_bsearch world encl theblk vec lo mid
        | VBool false -> arr_bsearch world encl theblk vec (mid + 1) hi
        | VNil -> arr_bsearch world encl theblk vec (mid + 1) hi
        | VInt 0 -> (mid, false, VNil)
        | VInt k -> if k < 0 then arr_bsearch world encl theblk vec lo mid else arr_bsearch world encl theblk vec (mid + 1) hi
        | VFlt f ->
          (if f == 0.0 then (mid, false, VNil)
           else if f < 0.0 then arr_bsearch world encl theblk vec lo mid
           else arr_bsearch world encl theblk vec (mid + 1) hi)
        | VBig b -> (if big_sign b < 0 then arr_bsearch world encl theblk vec lo mid
                     else arr_bsearch world encl theblk vec (mid + 1) hi)
        | other ->
          (let _ = raise_exc world "TypeError"
                     ("wrong argument type " ++ class_name other
                      ++ " (must be numeric, true, false or nil)") in (0 - 1, false, VNil))))
// at convergence (lo==hi), verify the candidate actually satisfies the block
// (find-minimum can converge on a position past the last true).
and arr_bsearch_check = fn world -> fn encl -> fn theblk -> fn (vec: Val list) -> fn (i: int) ->
  (match run_block world encl theblk (Cons (val_nth vec i, Nil)) with
   | FBreak bv -> (0 - 1, true, bv)
   | fl ->
     (match flow_value fl with
      | VBool true -> (i, false, VNil)
      | VInt 0 -> (i, false, VNil)
      | VFlt f -> (if f == 0.0 then (i, false, VNil) else (0 - 1, false, VNil))
      | VBool false -> (0 - 1, false, VNil)
      | VNil -> (0 - 1, false, VNil)
      | VInt _ -> (0 - 1, false, VNil)
      | VBig _ -> (0 - 1, false, VNil)
      | other ->
        (let _ = raise_exc world "TypeError"
                   ("wrong argument type " ++ class_name other
                    ++ " (must be numeric, true, false or nil)") in (0 - 1, false, VNil))))
// ---- Range#bsearch over the BOUNDS, never over a materialized range ------
// The array path built the whole range first, so `(0...Float::INFINITY)
// .bsearch` recursed until the stack went, an endless range refused with
// "cannot convert endless range to an array", and a Float range refused with
// "can't iterate from Float". None of those is a search: they are all the
// answer to a question about building a list.
//
// how a bound can be searched: 0 = integer, 1 = double, 2 = not at all
// the block's verdict, normalised. 0 = search left AND this one satisfies,
// 1 = search right, 2 = an exact hit, 3 = the block broke, 4 = the block
// answered something that is not numeric, true, false or nil, 5 = search left
// but this one is NOT an answer.
//
// 0 and 5 are the two modes, and collapsing them was wrong. `true` from the
// block means "this element satisfies, look for a smaller one" -- find-minimum
// keeps it as the running answer. A NEGATIVE NUMBER means only "the target is
// to the left"; find-any answers nothing but an exact zero, which is why ruby
// gives nil for `(0..3).bsearch { |x| x <=> 3 }` even though 3 is in the range.
and rng_bs_ask = fn world -> fn encl -> fn theblk -> fn (v: Val) ->
  match run_block world encl theblk (Cons (v, Nil)) with
  | FBreak bv -> (3, bv)
  | fl ->
    (match flow_value fl with
     | VBool true -> (0, VNil)
     | VBool false -> (1, VNil)
     | VNil -> (1, VNil)
     | VInt 0 -> (2, VNil)
     | VInt k -> (if k < 0 then (5, VNil) else (1, VNil))
     | VFlt f -> (if f == 0.0 then (2, VNil) else if f < 0.0 then (5, VNil) else (1, VNil))
     | VBig b -> (if big_sign b < 0 then (5, VNil) else (1, VNil))
     | other -> (4, other))
and rng_bs_type_err = fn world -> fn (other: Val) ->
  let _ = raise_exc world "TypeError"
    ("wrong argument type " ++ display_cls_msg world (dispatch_cls_of world other)
     ++ " (must be numeric, true, false or nil)") in (VNil, false, VNil)
// inclusive [lo, hi] on integers; best/found carry the smallest satisfying one
and rng_bs_int = fn world -> fn encl -> fn theblk -> fn (lo: int) -> fn (hi: int) -> fn (best: int) -> fn (found: bool) ->
  if lo > hi then (if found then (VInt best, false, VNil) else (VNil, false, VNil))
  else
    let mid = lo + (hi - lo) / 2 in
    let (verd, extra) = rng_bs_ask world encl theblk (VInt mid) in
    if verd == 3 then (VNil, true, extra)
    else if verd == 4 then rng_bs_type_err world extra
    else if verd == 2 then (VInt mid, false, VNil)
    else if verd == 0 then rng_bs_int world encl theblk lo (mid - 1) mid true
    else if verd == 5 then rng_bs_int world encl theblk lo (mid - 1) best found
    else rng_bs_int world encl theblk (mid + 1) hi best found
// an endless integer end has no bound to halve, so one is PROBED outward --
// beg+1, beg+2, beg+4 ... -- until the block stops sending the search right.
and rng_bs_int_probe = fn world -> fn encl -> fn theblk -> fn (beg: int) -> fn (w: int) -> fn (n: int) ->
  if n <= 0 || w <= 0 then beg + 1073741824
  else
    let (verd, _) = rng_bs_ask world encl theblk (VInt (beg + w)) in
    if verd == 1 then rng_bs_int_probe world encl theblk beg (w * 2) (n - 1) else beg + w
// the same search on doubles. Halving an interval never lands on either of its
// own endpoints, and ruby's float search bisects the double ENCODINGS of an
// inclusive range -- so both ends are asked explicitly at convergence.
// `hi_ok` says whether the top of the bracket is a legal answer: the end of an
// exclusive range is not, but a bracket end that the probe FOUND is an
// interior point and always is. The end probe accepts only a boolean true --
// find-any mode does not answer at an endpoint ruby never tested, which is why
// `(0.0..1.0).bsearch { |x| x <=> 1.0 }` is nil while `{ |x| x >= 1.0 }` is 1.0.
and rng_bs_flt = fn world -> fn encl -> fn theblk -> fn (lo: float) -> fn (hi: float) -> fn (best: float) -> fn (found: bool) -> fn (hi_ok: bool) -> fn (n: int) ->
  // halved BEFORE adding: lo + (hi - lo) / 2 overflows to Infinity when the
  // bracket spans most of the double range, and the search then never moves.
  let mid = lo / 2.0 + hi / 2.0 in
  if n <= 0 || mid == lo || mid == hi then
    (let (v2, e2) = rng_bs_ask world encl theblk (VFlt lo) in
     if v2 == 3 then (VNil, true, e2)
     else if v2 == 4 then rng_bs_type_err world e2
     else if v2 == 2 || v2 == 0 then (VFlt lo, false, VNil)
     else if found then (VFlt best, false, VNil)
     else if hi_ok then
       (let (v3, e3) = rng_bs_ask world encl theblk (VFlt hi) in
        if v3 == 3 then (VNil, true, e3)
        else if v3 == 4 then rng_bs_type_err world e3
        else if v3 == 0 then (VFlt hi, false, VNil)
        else (VNil, false, VNil))
     else (VNil, false, VNil))
  else
    let (verd, extra) = rng_bs_ask world encl theblk (VFlt mid) in
    if verd == 3 then (VNil, true, extra)
    else if verd == 4 then rng_bs_type_err world extra
    else if verd == 2 then (VFlt mid, false, VNil)
    else if verd == 0 then rng_bs_flt world encl theblk lo mid mid true hi_ok (n - 1)
    else if verd == 5 then rng_bs_flt world encl theblk lo mid best found hi_ok (n - 1)
    else rng_bs_flt world encl theblk mid hi best found hi_ok (n - 1)
// A double's ORDINAL: (biased exponent * 2^52 + fraction), negated for a
// negative value, with -0.0 and 0.0 both at 0. Adjacent doubles are adjacent
// ordinals, so a bisection over ordinals visits every double once and can
// land on Infinity (ordinal 2047 * 2^52) and Float::MAX (one below it).
// ...and back: the exponent and fraction fields recovered by division, the
// value rebuilt with ldexp (subnormals scale the fraction alone).
// the search itself, over ordinals. Verdicts as in rng_bs_ask: 0 satisfies
// (find-minimum keeps it and looks left), 1 looks right, 2 is an exact hit,
// 3 the block broke, 4 a non-comparable answer, 5 looks left without an
// answer. When the bracket closes, the lowest candidate is asked directly, so
// a boundary that satisfies is the answer (`(1.0..3.0).bsearch { |x| 3.0 - x }`
// is 3.0, which the midpoint walk never lands on).
and rng_bs_ord = fn world -> fn encl -> fn theblk -> fn (lo: int) -> fn (hi: int) -> fn (best: int) -> fn (found: bool) -> fn (n: int) ->
  if lo > hi then (if found then (VFlt (flt_of_ord best), false, VNil) else (VNil, false, VNil))
  else if n <= 0 || lo == hi then
    (let (v2, e2) = rng_bs_ask world encl theblk (VFlt (flt_of_ord lo)) in
     if v2 == 3 then (VNil, true, e2)
     else if v2 == 4 then rng_bs_type_err world e2
     else if v2 == 2 || v2 == 0 then (VFlt (flt_of_ord lo), false, VNil)
     else if found then (VFlt (flt_of_ord best), false, VNil)
     else if lo < hi then
       (let (v3, e3) = rng_bs_ask world encl theblk (VFlt (flt_of_ord hi)) in
        if v3 == 3 then (VNil, true, e3)
        else if v3 == 4 then rng_bs_type_err world e3
        else if v3 == 2 || v3 == 0 then (VFlt (flt_of_ord hi), false, VNil)
        else (VNil, false, VNil))
     else (VNil, false, VNil))
  else
    // halves ADDED, not the difference halved: the ordinals of -Infinity and
    // +Infinity are ±2047 * 2^52, and their difference does not fit an int --
    // `(-inf..inf).bsearch { |x| x >= 3 }` answered Infinity off a garbage
    // midpoint. (The float bisection had the same note for the same reason.)
    let mid = floor_div lo 2 + floor_div hi 2 in
    let (verd, extra) = rng_bs_ask world encl theblk (VFlt (flt_of_ord mid)) in
    if verd == 3 then (VNil, true, extra)
    else if verd == 4 then rng_bs_type_err world extra
    else if verd == 2 then (VFlt (flt_of_ord mid), false, VNil)
    else if verd == 0 then rng_bs_ord world encl theblk lo (mid - 1) mid true (n - 1)
    else if verd == 5 then rng_bs_ord world encl theblk lo (mid - 1) best found (n - 1)
    else rng_bs_ord world encl theblk (mid + 1) hi best found (n - 1)
and rng_bs_flt_probe = fn world -> fn encl -> fn theblk -> fn (beg: float) -> fn (w: float) -> fn (n: int) ->
  if n <= 0 then beg + w
  else
    let (verd, _) = rng_bs_ask world encl theblk (VFlt (beg + w)) in
    if verd == 1 then rng_bs_flt_probe world encl theblk beg (w * 2.0) (n - 1) else beg + w
// ...and outward the other way, for a start of -Infinity (or a beginless
// range). A bracket end of -Infinity is not a number the midpoint can use:
// (-inf + (inf - -inf) / 2) is NaN, and a NaN answer is worse than nil.
and rng_bs_flt_probe_down = fn world -> fn encl -> fn theblk -> fn (top: float) -> fn (w: float) -> fn (n: int) ->
  if n <= 0 then top - w
  else
    let (verd, _) = rng_bs_ask world encl theblk (VFlt (top - w)) in
    if verd == 1 then top - w else rng_bs_flt_probe_down world encl theblk top (w * 2.0) (n - 1)
and rng_bsearch = fn world -> fn encl -> fn theblk -> fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) ->
  let kl = rng_bs_kind lo in
  let kh = rng_bs_kind hi in
  let inf = 1.0 / 0.0 in
  let hi_endless = (match hi with VNil -> true | VFlt f -> f == inf | _ -> false) in
  if kl == 2 || kh == 2 then
    (let bad = (if kl == 2 then lo else hi) in
     let _ = raise_exc world "TypeError"
       ("can't do binary search for " ++ display_cls_msg world (dispatch_cls_of world bad)) in
     (VNil, false, VNil))
  // a Float at either end makes the whole search a double search, which is
  // what makes ruby answer 2.0 rather than 2 for (0...Float::INFINITY).
  else if kl == 1 || kh == 1 then
    (let lof0 = (match lo with VNil -> 0.0 - inf | v -> to_f v) in
     let hif0 = (match hi with VNil -> inf | v -> to_f v) in
     let lo_endless = lof0 == (0.0 - inf) in
     // An EMPTY range has nothing to search, and its bounds are not a bracket:
     // (inf..-inf) halves to NaN, the block is then asked about NaN, and a NaN
     // came back as the answer -- worse than nil, which is what ruby says.
     if (lof0 == lof0) == false || (hif0 == hif0) == false then (VNil, false, VNil)
     else if lof0 > hif0 then (VNil, false, VNil)
     else if lof0 == hif0 then
       // one element (or none, if the end is excluded): ask it directly rather
       // than probing outward from a point that is its own bracket.
       (if excl then (VNil, false, VNil)
        else
          (let (v1, e1) = rng_bs_ask world encl theblk (VFlt lof0) in
           if v1 == 3 then (VNil, true, e1)
           else if v1 == 4 then rng_bs_type_err world e1
           else if v1 == 0 || v1 == 2 then (VFlt lof0, false, VNil)
           else (VNil, false, VNil)))
     else
       // Bisect the doubles by their ORDINAL -- sign, exponent and fraction
       // read as one integer, which orders exactly like the values do -- so
       // every double between the bounds, ±Infinity and ±Float::MAX included,
       // is a probe point. Doubling outward from a finite point never reached
       // them: `(-inf..0.0).bsearch { true }` answered -1.8e19 (64 doublings)
       // where ruby answers -Infinity, and an excluded infinite end has to be
       // recognised as the end and refused rather than approached.
       (let lo_ord = flt_ord lof0 in
        let hi_ord = (if excl then flt_ord hif0 - 1 else flt_ord hif0) in
        if lo_ord > hi_ord then (VNil, false, VNil)
        else rng_bs_ord world encl theblk lo_ord hi_ord 0 false 80))
  else
    (let loi = (match lo with VNil -> 0 - int_max | VInt n -> n | VBig b -> int_of_str b | _ -> 0) in
     let hii = (if hi_endless then rng_bs_int_probe world encl theblk loi 1 62
                else (match hi with VInt n -> (if excl then n - 1 else n) | VBig b -> int_of_str b | _ -> int_max)) in
     rng_bs_int world encl theblk loi hii 0 false)

// #find / #rfind over a LIVE array: the length is re-read on every step (so a
// block that shrinks the array stops the walk, and one that grows it keeps
// going), and a `break` answers its own value rather than the element. `rev`
// walks from the end, counting from the CURRENT length each time.
and arr_detect_ix = fn world -> fn encl -> fn theblk -> fn (id: int) -> fn (i: int) -> fn (rev: bool) ->
  let ys = deref id in
  let n = val_list_len ys in
  if i < 0 || i >= n then (false, VNil)
  else
    let h = val_nth ys (if rev then n - 1 - i else i) in
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> (true, v)
     | fl -> (if truthy (flow_value fl) then (true, h)
              else arr_detect_ix world encl theblk id (i + 1) rev))

// the ifnone argument, called with no arguments; absent means nil
// one level of flattening, with the world: an element that is not already an
// Array is asked for #to_ary. An Array is spliced, nil means "append it as it
// is" (ruby's rb_check_array_type), and anything else is a TypeError naming
// what the conversion gave back.
and flatten1_w = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (VArr id, t) -> list_append (deref id) (flatten1_w world t)
  | Cons (h, t) ->
    (let a9 = flatten1_ary world h in
     match a9 with
     | VArr aid -> list_append (deref aid) (flatten1_w world t)
     | _ -> Cons (h, flatten1_w world t))

// #to_ary on an element that is not already an Array: the Array it converts to,
// or nil, which means "append it as it is" (ruby's rb_check_array_type).
// Anything ELSE is ruby's TypeError, named after what the conversion gave back.
// ⚠ Written as its own function on purpose: as a match nested inside the
//   caller's match, the nil arm was never reached -- the arms after the first
//   bound to the OUTER match, so every non-Array conversion took the refusal.
and flatten1_ary = fn world -> fn (h: Val) ->
  match h with
  | VObj _ ->
    (if responds world h "to_ary" then
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        let r9 = invoke_val_c gc_cenv0 world nb9 h "to_ary" Nil false in
        if (match r9 with VArr _ -> true | _ -> false) then r9
        else if rb_eq r9 VNil then VNil
        else
          (let cn9 = display_cls_msg world (dispatch_cls_of world h) in
           let _ = raise_exc world "TypeError"
                     ("can't convert " ++ cn9 ++ " to Array (" ++ cn9 ++ "#to_ary gives "
                      ++ class_name r9 ++ ")") in
           VNil))
     else VNil)
  | _ -> VNil

and arr_ifnone = fn world -> fn encl -> fn (args: Val list) ->
  match args with
  | Cons (VProc pid, _) -> flow_value (run_block world encl (proc_as_block pid) Nil)
  | Nil -> VNil
  | Cons (VNil, _) -> VNil
  // ...and anything ELSE is sent #call as well: ruby does not check first, so
  // an ifnone that cannot answer is a NoMethodError. Answering nil for it made
  // `[1].find(42) { false }` look like an ordinary miss.
  | Cons (o9, _) ->
    (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
     invoke_val_c gc_cenv0 world nb9 o9 "call" Nil false)

and arr_any = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VBool false
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then VBool true else arr_any world encl theblk t

and arr_all = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VBool true
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then arr_all world encl theblk t else VBool false

and arr_none = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> VBool true
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then VBool false else arr_none world encl theblk t

and arr_find_index = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> if truthy (flow_value (run_block world encl theblk (Cons (h, Nil)))) then VInt i else arr_find_index world encl theblk t (i + 1)

// run an object's user `each` with a collector block, returning the yielded
// values as a fresh array (the basis of the synthesized Enumerable methods).
// the argument-taking iterators an Enumerable answers. They are not in
// is_enum_method, which doubles as "names a bare call may enumerate".

// ⚠ A Hash answers Enumerable over its [k, v] PAIRS, and only the
//   BLOCK-taking path converted it: `h.min { }` worked and `h.min` was a
//   NoMethodError, `h.one? { }` worked and `h.one?(pattern)` was not there at
//   all. These are the names whose blockless (or argument) form was missing --
//   measured by asking a Hash for every Enumerable name, not guessed. `index`
//   is NOT among them: ruby has no Hash#index either.

and enum_collect = fn world -> fn (recv: Val) -> fn (cls: str) ->
  enum_collect_a world recv cls Nil

// `to_a(:hello, "world")` hands its arguments to #each -- an Enumerable whose
// each takes some is the reason ruby forwards them.
and enum_collect_a = fn world -> fn (recv: Val) -> fn (cls: str) -> fn (eargs: Val list) ->
  let accv = arr_new Nil in
  (match accv with
   | VArr _ ->
     let cenv = map_new () in
     let _ = map_set cenv "__acc" accv in
     // splat param: a multi-value yield gathers as an array element,
     // a single-value yield stays the bare value (Enumerable#to_a rules).
     let collector = (true, Cons ("*__e", Nil),
                      Cons (SExpr (EMethod (EVar "__acc", "push",
                        Cons (ETern (EBin ("<=", EMethod (EVar "__e", "length", Nil), EInt 1),
                                     EMethod (EVar "__e", "[]", Cons (EInt 0, Nil)),
                                     EVar "__e"), Nil))), Nil),
                      cenv) in
     let _ = invoke world collector recv cls "each" eargs in accv
   | _ -> accv)

// cycle: iterate the list n times (n < 0 = forever, until a break unwinds).
and arr_cycle = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (n: int) ->
  if n == 0 then FNext VNil
  // cycling an empty collection yields nothing and returns nil immediately.
  else if (match xs with Nil -> true | _ -> false) then FNext VNil
  else
    let _ = tick () in
    (match arr_each world encl theblk xs with
     | FNext _ -> arr_cycle world encl theblk xs (if n < 0 then n else n - 1)
     | other -> other)

// the yielders that take no arguments at all (so a blockless call WITH one is
// a wrong-arity error rather than an Enumerator). each_slice / each_cons /
// cycle / each_with_object / each_line take arguments and are deliberately not
// here.

// enumerable methods that, called WITHOUT a block, return an Enumerator.


// built-in block-taking iterators on primitive receivers. `encl` is the
// enclosing method's block (threaded so a yield inside the iterated block
// reaches it); `theblk` is the block being iterated.
and builtin_iter = fn world -> fn encl -> fn theblk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  // The frozen check in invoke_val_c only guards the non-block dispatch, so a
  // block-form mutator (delete_if / keep_if / map! / sort! ...) reached this
  // far without one.
  if builtin_mut_on_frozen world recv name then
    raise_exc_iv world "FrozenError" ("can't modify frozen " ++ class_name recv ++ ": " ++ inspect recv) (Cons (("__recv", recv), Nil))
  else
  // each iterator returns a Flow: FBreak v (a `break v` fired — that value
  // becomes the whole call's result) or FNext <natural result>.
  match recv with
  // String iterators with a block (each_char/each_byte/each_line); other
  // enum methods iterate the chars.
  | VStr h ->
    (let sv = sget h in
     if str_eq name "each_grapheme_cluster" || str_eq name "grapheme_clusters" then
       iter_each_result (arr_each world encl theblk (rb_graphemes sv (enc_canon_name (senc_get h)))) recv
     // split with a block yields each piece and answers SELF, not the array.
     else if str_eq name "split" then
       (match prim_method recv "split" args with
        | VArr aid -> iter_each_result (arr_each world encl theblk (deref aid)) recv
        | other -> other)
     // scrub with a block: each invalid span is yielded and the block's
     // answer replaces it. scrub! writes the result back (frozen refuses
     // only when something actually changed).
     else if str_eq name "scrub" || str_eq name "scrub!" then
       (let e = enc_canon_name (senc_get h) in
        let n = str_len sv in
        let out =
          (if str_eq e "UTF-8" then
             (let rec go = fn (i: int) -> fn (acc: str) ->
                if i >= n then acc
                else (match utf8_cp_strict sv i with
                      | (c, l, ok) ->
                        if ok then go (i + l) (acc ++ substring sv i (i + l))
                        else
                          let sp = scrub_bad_span sv i in
                          let bv = flow_value (run_block world encl theblk (Cons (mkstr (substring sv i (i + sp)), Nil))) in
                          go (i + sp) (acc ++ (match bv with VStr bh -> sget bh | ov -> w_to_s world ov))) in
              go 0 "")
           else sv) in
        if str_eq name "scrub!" then
          (if str_eq out sv then recv
           else if sfrozen_get h then prim_raise "FrozenError" ("can't modify frozen String: " ++ inspect recv)
           else (let _ = sset h out in recv))
        else
          (let c = mkstr out in
           (match c with VStr id -> (let _ = senc_set id (senc_get h) in c) | _ -> c)))
     else if str_eq name "each_char" then iter_each_result (arr_each world encl theblk (utf8_chars_enc sv (enc_canon_name (senc_get h)) 0)) recv
     // String#upto(limit) walks self, self.succ, ... up to limit.
     else if str_eq name "upto" then
       (match args with
        | Cons (VStr lim, rest) ->
          let _ = enc_pair_guard h lim in
          let excl = (match rest with Cons (b, _) -> truthy b | _ -> false) in
          let b = sget lim in
          let lst = (if str_len sv == 1 && str_len b == 1 && ord sv < 128 && ord b < 128
                     then rb_upto_bytes (ord sv) (ord b) excl
                     else str_upto_list sv b excl 0) in
          iter_each_result (arr_each world encl theblk lst) recv
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1..2)")
     else if str_eq name "each_byte" then
       // each_byte re-reads self each step: the block appending to self
       // extends the iteration to the new end.
       (let rec go9 = fn (i: int) ->
          let cur = sget h in
          if i >= str_len cur then FNext VNil
          else (match run_block world encl theblk (Cons (VInt (ord (char_at cur i)), Nil)) with
                | FBreak bv -> FBreak bv
                | fl -> (let _ = flow_value fl in go9 (i + 1))) in
        iter_each_result (go9 0) recv)
     else if str_eq name "bytes" then iter_each_result (arr_each world encl theblk (str_bytes_val sv 0)) recv
     // the plural forms take a block too, iterating instead of collecting.
     else if str_eq name "chars" then iter_each_result (arr_each world encl theblk (utf8_chars_enc sv (enc_canon_name (senc_get h)) 0)) recv
     else if str_eq name "codepoints" || str_eq name "each_codepoint" then
       // decoded under the string's own encoding; ruby yields the valid
       // prefix and THEN raises on the first invalid unit, so the raise
       // comes after the block has seen the prefix.
       (match str_cps_checked sv (enc_canon_name (senc_get h)) with
        | (cps, bad) ->
          let r = iter_each_result (arr_each world encl theblk cps) recv in
          if bad then prim_raise "ArgumentError" ("invalid byte sequence in " ++ enc_canon_name (senc_get h))
          else r)
     else if str_eq name "each_line" then
       // each_line(sep = $/): the same separator rules as String#lines.
       (let sepv = (match args with
                    | Cons (VStr sp, _) -> VStr sp
                    | Cons (VNil, _) -> VNil
                    | _ -> (if map_has globals "/" then map_get globals "/" else mkstr "\n")) in
        let ls = (match sepv with
                  | VNil -> (if str_len sv == 0 then (Nil : Val list) else Cons (mkstr sv, Nil))
                  | VStr sph ->
                    let sep = sget sph in
                    (if str_eq sep "\n" then val_list_of_strs (str_lines_go sv 0 0 (str_len sv))
                     else val_list_of_strs (str_lines_sep sv sep))
                  | _ -> val_list_of_strs (str_lines_go sv 0 0 (str_len sv))) in
        iter_each_result (arr_each world encl theblk (val_strs_tag ls (senc_get h))) recv)
     else if str_eq name "each_with_index" then iter_each_result (arr_each world encl theblk (with_index_pairs (utf8_chars_val sv 0) 0)) recv
     else prim_method recv name args)
  | VArr id -> let xs = deref id in
    if str_eq name "each" then
      iter_each_result (arr_each_live world encl theblk id 0 xs (arr_ver id) 0) recv
    else if str_eq name "each_index" then
      iter_each_result (arr_each_live world encl theblk id 0 xs (arr_ver id) 1) recv
    else if str_eq name "map" || str_eq name "collect" then iter_result (arr_map world encl theblk xs Nil) recv
    else if str_eq name "select" || str_eq name "filter" then iter_result (arr_filter world encl theblk xs Nil true) recv
    else if str_eq name "reject" then iter_result (arr_filter world encl theblk xs Nil false) recv
    else if str_eq name "each_with_index" then
      iter_each_result (arr_each_live world encl theblk id 0 xs (arr_ver id) 2) recv
    // combination / permutation with a block yield each one and return self.
    else if str_eq name "combination" then
      (match args with
       | Cons (VInt k, _) -> iter_each_result (arr_each world encl theblk (arr_combinations xs k)) recv
       | _ -> recv)
    else if str_eq name "permutation" then
      (match args with
       | Cons (VInt k, _) -> iter_each_result (arr_each world encl theblk (arr_permutations xs k)) recv
       | _ -> iter_each_result (arr_each world encl theblk (arr_permutations xs (val_list_len xs))) recv)
    // product with a block yields every tuple and answers SELF (the block form
    // reached prim_method, which has no product at all: NoMethodError).
    else if str_eq name "product" then
      (let _ = arr_product_guard (val_list_len xs) args in
       iter_each_result (arr_each world encl theblk (arr_product_n xs args)) recv)
    // the repeated_* generators with a block yield each tuple and answer self
    // (a Float length truncates -- the block path does no conversion).
    else if str_eq name "repeated_combination" || str_eq name "repeated_permutation" then
      (let k = (match args with
                | Cons (VInt k9, _) -> k9
                | Cons (VFlt f9, _) -> int_of_float f9
                | _ -> 0) in
       let tuples = (if str_eq name "repeated_combination" then arr_rep_combos xs k else arr_rep_perms xs k) in
       iter_each_result (arr_each world encl theblk tuples) recv)
    // Array#initialize(n) { |i| ... } (through `send`): each index gets the
    // block's value, and a break answers its value with the prefix kept.
    else if str_eq name "initialize" then
      (match args with
       | Cons (_, Cons (_, Cons (_, _))) ->
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..2)")
       | _ ->
         (let a9 = coerce_int_args gc_cenv0 world args in
          let n9 = array_new_size gc_cenv0 world a9 in
          // start EMPTY and let the filler grow it, so a break leaves exactly
          // the values the block produced (pre-filling with nils left them).
          let _ = arr_set id (Nil : Val list) in
          match arr_fill_go world encl theblk true id VNil 0 n9 with
          | FBreak v -> v
          | _ -> recv))
    // fill with a block: the block is handed each INDEX and its answer fills
    // that position (the value forms live in the non-block dispatcher).
    else if str_eq name "fill" then
      (match args with
       | Cons (_, Cons (_, Cons (_, _))) ->
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..2)")
       | _ ->
         (let n = val_list_len xs in
          let (b9, l9) = arr_fill_span gc_cenv0 world n args in
          match arr_fill_go world encl theblk true id VNil b9 l9 with
          | FBreak v -> v
          | _ -> recv))
    // zip with a block yields each tuple and answers NIL (not self).
    else if str_eq name "zip" then
      (match arr_each world encl theblk (val_zip xs args 0 (val_list_len xs)) with
       | FBreak v -> v
       | _ -> VNil)
    else if str_eq name "reduce" || str_eq name "inject" then
      (match args with
       | Cons (init, _) -> iter_result (arr_reduce world encl theblk xs init) recv
       | Nil -> (match xs with Nil -> VNil | Cons (h, t) -> iter_result (arr_reduce world encl theblk t h) recv))
    else if str_eq name "count" then iter_result (arr_count_blk world encl theblk xs 0) recv
    // ...and the optional IFNONE argument is CALLED when nothing matched (it is
    // not a default value): `[1].find(-> { :none }) { false }` is :none. The
    // found/not-found answer is a pair, so an element that IS nil does not look
    // like a miss.
    // ⚠ #find re-reads the array's SIZE on every step, so a block that empties
    //   the array stops the walk: `ary.find { seen << x; ary.clear; false }`
    //   sees one element. Walking a snapshot saw all six -- and a `break` in
    //   the block answered the ELEMENT instead of the break value, because the
    //   truthiness of the break's value was read as "found".
    else if str_eq name "detect" || str_eq name "find" then
      (match arr_detect_ix world encl theblk id 0 false with
       | (true, v) -> v
       | (_, _) -> arr_ifnone world encl args)
    // ruby 4.0: Array#rfind is #find walked from the other end
    else if str_eq name "rfind" then
      (match arr_detect_ix world encl theblk id 0 true with
       | (true, v) -> v
       | (_, _) -> arr_ifnone world encl args)
    else if str_eq name "any?" then arr_any world encl theblk xs
    else if str_eq name "all?" then arr_all world encl theblk xs
    else if str_eq name "none?" then arr_none world encl theblk xs
    else if str_eq name "find_index" || str_eq name "index" then arr_find_index world encl theblk xs 0
    // rindex with a block is the same search from the other end (it had no
    // block form at all and answered nil).
    else if str_eq name "rindex" then
      iter_result (arr_rindex_blk world encl theblk id (val_list_len xs)) recv
    else if str_eq name "bsearch" || str_eq name "bsearch_index" then
      (let vec = xs in
       let n = val_list_len vec in
       let (idx, broke, bv) = arr_bsearch world encl theblk vec 0 n in
       if broke then bv
       else if idx < 0 then VNil
       else if str_eq name "bsearch_index" then VInt idx else val_nth vec idx)
    else if str_eq name "flat_map" || str_eq name "collect_concat" then
      (match arr_map world encl theblk xs Nil with
       // an element that is not an Array is asked for #to_ary before it is
       // appended -- flatten1 is world-free and could not ask, so a block
       // answering an object that converts was appended whole.
       | FNext (VArr id) -> iter_result (FNext (arr_new (flatten1_w world (deref id)))) recv
       | other -> iter_result other recv)
    // max / min with a block: the block is a COMPARATOR (a, b), not a key --
    // it was ignored entirely and the plain maximum came back. A one-parameter
    // block still gets two arguments and reads the first, which is what makes
    // `[1,2,3,4,5].max { |x| ... }` yield 2, 3, 4, 5.
    // ...and max(n) / min(n) WITH a block: the block is still the comparator,
    // so the n extremes are the ends of the SORTED list. The fold below can
    // carry only one accumulator, so it answered the single extreme and
    // dropped the n -- `(1..10).max(2) { |a, b| b <=> a }` was 1, not [1, 2].
    else if (str_eq name "max" || str_eq name "min")
            && (match args with Cons (_, Nil) -> true | _ -> false) then
      (let k9 = (match args with
                 | Cons (a9, _) -> rng_take_count world a9 true
                 | _ -> 0) in
       let (st9, broke9, bv9) = sort_blk_b world theblk xs in
       if broke9 then bv9
       else arr_new (val_take (if str_eq name "max" then rev_vals st9 else st9) k9))
    else if str_eq name "max" || str_eq name "min" then
      (let want = str_eq name "max" in
       let rec go = fn (ys: Val list) -> fn (acc: Val) ->
         (match ys with
          | Nil -> acc
          | Cons (h, t) ->
            (match run_block world encl theblk (Cons (h, Cons (acc, Nil))) with
             | FBreak v -> v
             | fl ->
               (let c = (match flow_value fl with
                         | VInt n -> n
                         | VBig b -> big_sign b
                         | VFlt f -> (if f > 0.0 then 1 else if f < 0.0 then 0 - 1 else 0)
                         // ...naming the right operand by VALUE, which is
                         // what rb_cmperr does for a comparable one (and what
                         // the blockless path here already did).
                         | VNil -> (let _ = raise_exc world "ArgumentError"
                                              ("comparison of " ++ class_name h ++ " with "
                                               ++ cmp_other_name acc ++ " failed") in 0)
                         // ruby does not COERCE the block's answer -- it ASKS
                         // it, sending #> and then #< against 0. An object
                         // that answers both (ruby/spec has exactly one) went
                         // to cmp_vals_w instead and came back as "comparison
                         // of Object with Integer failed".
                         | VObj _ ->
                           (let nb8 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
                            let bv8 = flow_value fl in
                            if truthy (invoke_val_c gc_cenv0 world nb8 bv8 ">" (Cons (VInt 0, Nil)) false) then 1
                            else if truthy (invoke_val_c gc_cenv0 world nb8 bv8 "<" (Cons (VInt 0, Nil)) false) then 0 - 1
                            else 0)
                         | other -> cmp_vals_w world other (VInt 0)) in
                go t (if want then (if c > 0 then h else acc) else (if c < 0 then h else acc))))) in
       match xs with
       | Nil -> VNil
       | Cons (h0, t0) -> go t0 h0)
    // ...and #sort with a comparator block, which the Array receiver answers
    // earlier (in the block section of dispatch_prim) but an ENUMERABLE that
    // was collected into an array reaches HERE -- so `enum.sort { |a, b| b <=>
    // a }` dropped its block and answered the natural order.
    else if str_eq name "sort" then
      (let (st9, broke9, bv9) = sort_blk_b world theblk xs in
       if broke9 then bv9 else arr_new st9)
    // minmax with a COMPARATOR block: the ENDS of the list the block sorts.
    // The block was dropped here and the plain minimum and maximum came back,
    // so `[1, 2, 3].minmax { |a, b| b <=> a }` answered [1, 3] -- the answer
    // to a question nobody asked. min and max above already read their block
    // as a comparator; this was the third name of the same shape.
    else if str_eq name "minmax" then
      (let (st9, broke9, bv9) = sort_blk_b world theblk xs in
       if broke9 then bv9
       else (let n9 = val_list_len st9 in
             if n9 == 0 then arr_new (Cons (VNil, Cons (VNil, Nil)))
             else arr_new (Cons (val_nth st9 0, Cons (val_nth st9 (n9 - 1), Nil)))))
    else if str_eq name "min_by" then arr_min_by world encl theblk xs false
    else if str_eq name "max_by" then arr_min_by world encl theblk xs true
    else if str_eq name "minmax_by" then arr_minmax_by world encl theblk xs
    else if str_eq name "chunk" then arr_new (arr_chunk world encl theblk xs)
    else if str_eq name "slice_when" then arr_new (arr_slice_when world encl theblk xs)
    else if str_eq name "chunk_while" then arr_new (arr_chunk_while world encl theblk xs)
    else if str_eq name "sort_by" then
      (let (pairs, broke, bv) = arr_keyed_b world encl theblk xs in
       if broke then bv
       else iter_result (FNext (arr_new (extract_vals (sort_by_key world pairs)))) recv)
    else if str_eq name "sort_by!" then
      (let (pairs, broke, bv) = arr_keyed_b world encl theblk xs in
       // a break leaves the array as it was (ruby's write-back is what the
       // break jumps over) and answers the break value.
       if broke then bv
       else (let _ = arr_set id (extract_vals (sort_by_key world pairs)) in
             iter_result (FNext recv) recv))
    else if str_eq name "sum" then (match args with Cons (init, _) -> arr_sum_blk world encl theblk xs init | Nil -> arr_sum_blk world encl theblk xs (VInt 0))
    else if str_eq name "partition" then arr_partition world encl theblk xs Nil Nil
    else if str_eq name "group_by" then arr_group_by world encl theblk xs Nil
    else if str_eq name "each_with_object" then (match args with Cons (o, _) -> arr_each_with_object world encl theblk xs o | Nil -> VNil)
    else if str_eq name "take_while" then iter_result (arr_take_while world encl theblk xs Nil) recv
    else if str_eq name "drop_while" then iter_result (arr_drop_while world encl theblk xs) recv
    // to_h { |k, v| [k2, v2] } -- the block maps each element to a pair
    else if str_eq name "to_h" then
      (match arr_map world encl theblk xs Nil with
       // the block's answers go through the SAME validation as plain elements,
       // so a block returning a 3-element array is an ArgumentError.
       | FNext (VArr aid) -> mkhash (hash_merge Nil (arr_to_h_pairs gc_cenv0 world (deref aid) 0))
       | FBreak v -> v
       | _ -> mkhash Nil)
    // uniq / uniq! with a block: the block computes the KEY for each element,
    // yielded in order, and the first element per key survives.
    else if str_eq name "uniq" || str_eq name "uniq!" then
      (match arr_map world encl theblk xs Nil with
       | FNext (VArr kid) ->
         (let out = arr_uniq_w gc_cenv0 world xs (deref kid) (Nil : Val list) in
          if str_eq name "uniq" then arr_new out
          else (let changed = (if val_list_len out == val_list_len xs then false else true) in
                let _ = arr_set id out in
                if changed then recv else VNil))
       | FBreak v -> v
       | _ -> recv)
    else if str_eq name "filter_map" then iter_result (arr_filter_map world encl theblk xs Nil) recv
    else if str_eq name "find_all" then iter_result (arr_filter world encl theblk xs Nil true) recv
    else if str_eq name "reverse_each" then
      iter_each_result (arr_reverse_each_live world encl theblk id (val_list_len xs)) recv
    else if str_eq name "one?" then
      (match arr_count_blk world encl theblk xs 0 with
       | FNext (VInt n) -> VBool (n == 1)
       | FBreak v -> v
       | _ -> VBool false)
    else if str_eq name "grep" || str_eq name "grep_v" then
      (match args with
       // ⚠ `$~` inside the block is THAT ELEMENT's match. Selecting every hit
       // first and mapping afterwards left behind the LAST attempt's result
       // for all of them: `grep(/e/) { $~ }` saw the failed match of the
       // element after the last hit, and `grep_v(/e/) { $~ }` saw a MatchData
       // for a string it was never given. Matching immediately before each
       // yield is the only order that makes the global mean what it says.
       | Cons (pat, _) ->
         iter_result (arr_grep_map world encl theblk xs pat (str_eq name "grep_v") Nil) recv
       | _ -> arr_new Nil)
    else if str_eq name "each_entry" then iter_each_result (arr_each world encl theblk xs) recv
    else if str_eq name "cycle" then
      // cycle(n = nil): nil/absent = forever; a Float truncates; anything else
      // must #to_int (TypeError otherwise); extra args ArgumentError. It answers
      // NIL when it finishes -- not self, which is what iter_each_result gave
      // (`[].cycle(2) {}` was [] and `[1,2,3].cycle(0) {}` was the array).
      (let done9 = fn (f: Flow) -> (match f with FBreak v -> v | FReturn v -> v | _ -> VNil) in
       let n9 = (match args with
                 | Nil -> VInt (0 - 1)
                 | Cons (VNil, _) -> VInt (0 - 1)
                 | Cons (VInt n, _) -> VInt n
                 | Cons (VFlt f, _) -> VInt (int_of_float f)
                 | Cons (VObj _, _) ->
                   (match args with
                    | Cons (a0, _) ->
                      // #to_int through the conversion protocol, so a mock that
                      // answers it via method_missing converts too.
                      (match conv_try gc_cenv0 world a0 "to_int" with
                       | VInt n -> VInt n
                       | VNil -> raise_exc world "TypeError"
                                   ("no implicit conversion of " ++ class_name a0 ++ " into Integer")
                       | ov -> raise_exc world "TypeError"
                                 ("can't convert " ++ class_name a0 ++ " to Integer ("
                                  ++ class_name a0 ++ "#to_int gives " ++ class_name ov ++ ")"))
                    | Nil -> VInt (0 - 1))
                 | Cons (other, _) ->
                   raise_exc world "TypeError"
                     ("no implicit conversion of " ++ class_name other ++ " into Integer")) in
       match args with
       | Cons (_, Cons (_, _)) ->
         raise_exc world "ArgumentError" "wrong number of arguments (given 2, expected 0..1)"
       | _ -> (match n9 with
               | VInt n -> done9 (arr_cycle world encl theblk xs n)
               | _ -> VNil))
    // a size below 1 is refused BEFORE the walk: val_slices never shortens on
    // a zero step, so `each_slice(0) { }` ran until the stack gave out.
    // Array#fetch_values with a block: the block supplies the value for an
    // index outside the array (the blockless implementation raises there).
    else if str_eq name "fetch_values" && (match recv with VArr _ -> true | _ -> false) then
      (match recv with
       | VArr id9 ->
         (let ys = deref id9 in
          let n9 = val_list_len ys in
          let rec go9 = fn (ks: Val list) ->
            (match ks with
             | Nil -> (Nil : Val list)
             | Cons (VInt i, t) ->
               (let j = (if i < 0 then n9 + i else i) in
                Cons ((if j >= 0 && j < n9 then val_nth ys j
                       else flow_value (run_block world encl theblk (Cons (VInt i, Nil)))), go9 t))
             | Cons (_, t) -> go9 t) in
          arr_new (go9 args))
       | _ -> VNil)
    else if str_eq name "each_slice" then (match args with Cons (VInt n, _) -> (if n < 1 then raise_exc world "ArgumentError" "invalid slice size" else iter_each_result (arr_each world encl theblk (val_slices xs n)) recv) | _ -> recv)
    else if str_eq name "each_cons" then (match args with Cons (VInt n, _) -> (if n < 1 then raise_exc world "ArgumentError" "invalid size" else iter_each_result (arr_each world encl theblk (val_cons_windows xs n)) recv) | _ -> recv)
    else prim_method recv name args
  | VHsh xs -> let xs = hderef xs in
    if str_eq name "each" || str_eq name "each_pair" then iter_each_result (hash_each world encl theblk xs) recv
    // select / reject answer a NEW hash, which keeps the receiver's
    // compare_by_identity flag (ruby's rule for every derived hash).
    else if str_eq name "select" || str_eq name "filter" || str_eq name "reject" then
      (let src9 = (match recv with VHsh h9 -> h9 | _ -> 0) in
       match hash_filter world encl theblk xs Nil (if str_eq name "reject" then false else true) with
       | FNext r9 -> (let _ = hcbi_copy src9 r9 in iter_result (FNext r9) recv)
       | other -> iter_result other recv)
    else if str_eq name "transform_values" then
      // the identity flag rides along, the DEFAULT does not (ruby 3.2).
      (let src9 = (match recv with VHsh h9 -> h9 | _ -> 0) in
       let r9 = mkhash (hash_tv world encl theblk xs) in
       let _ = hcbi_copy src9 r9 in
       iter_result (FNext r9) recv)
    // two old keys that transform to the SAME new key collapse to one pair,
    // the later one (the flat list was not merged). With a HASH argument as
    // well, the hash decides the keys it names and the block the rest.
    else if str_eq name "transform_keys" then
      (match args with
       | Cons (VHsh mid9, _) ->
         (let mp9 = hderef mid9 in
          let rec go9 = fn (ys: Val list) ->
            (match ys with
             | Cons (k9, Cons (v9, t9)) ->
               Cons ((if hash_haskey mp9 k9 then hash_get mp9 k9
                      else flow_value (run_block world encl theblk (Cons (k9, Nil)))),
                     Cons (v9, go9 t9))
             | _ -> (Nil : Val list)) in
          iter_result (FNext (mkhash (hash_merge Nil (go9 xs)))) recv)
       | _ -> iter_result (FNext (mkhash (hash_merge Nil (hash_tk world encl theblk xs)))) recv)
    // the BANG forms write the result back and answer self (they did not exist).
    // fetch_values with a block: the block supplies the value for a key that
    // is not there (it had no block form and raised KeyError).
    // Hash#sort with a block sorts the [k, v] pairs with that comparator (the
    // block was ignored and the natural order came back).
    else if str_eq name "sort" then
      (let (st9, broke9, bv9) = sort_blk_b world theblk (hash_pairs xs) in
       if broke9 then bv9 else arr_new st9)
    // Hash#to_h with a block hands the block the key and the value as SEPARATE
    // arguments and takes the [k, v] pair it answers.
    else if str_eq name "to_h" then
      (let rec go = fn (ys: Val list) ->
         (match ys with
          | Cons (k, Cons (v, t)) ->
            (match flow_value (run_block world encl theblk (Cons (k, Cons (v, Nil)))) with
             // the pair must have exactly two elements: a longer or shorter one
             // is ruby's ArgumentError, and a non-array its TypeError.
             | VArr aid ->
               (if val_list_len (deref aid) == 2 then list_append (deref aid) (go t)
                else (let _ = raise_exc world "ArgumentError"
                                ("element has wrong array length (expected 2, was "
                                 ++ str_of_int (val_list_len (deref aid)) ++ ")") in go t))
             // ...and a non-Array is asked for #to_ary before it is refused:
             // ruby coerces the pair the block returned.
             | other ->
               // (builtin_iter has no env; the enclosing block's is the one
               // any dispatch here should run in.)
               (let benv = (match encl with (_, _, _, e7) -> e7) in
                let conv = (if responds world other "to_ary"
                            then invoke_val_c benv world (false, (Nil : str list), (Nil : Stmt list), benv)
                                   other "to_ary" Nil false
                            else VNil) in
                match conv with
                | VArr aid2 ->
                  (if val_list_len (deref aid2) == 2 then list_append (deref aid2) (go t)
                   else (let _ = raise_exc world "ArgumentError"
                                   ("element has wrong array length (expected 2, was "
                                    ++ str_of_int (val_list_len (deref aid2)) ++ ")") in go t))
                | _ -> (let _ = raise_exc world "TypeError"
                                  ("wrong element type " ++ class_name other ++ " (expected array)") in go t)))
          | _ -> (Nil : Val list)) in
       mkhash (hash_merge Nil (go xs)))
    else if str_eq name "fetch_values" then
      (let rec go = fn (ks: Val list) ->
         (match ks with
          | Nil -> (Nil : Val list)
          | Cons (k, t) ->
            Cons ((if hash_haskey xs k then hash_get xs k
                   else flow_value (run_block world encl theblk (Cons (k, Nil)))), go t)) in
       arr_new (go args))

    else if str_eq name "transform_keys!" then
      (match recv with
       | VHsh hid ->
         // a `break` leaves the keys already processed TRANSFORMED and the rest
         // as they were -- and a transformed key wins over an untouched pair of
         // the same name (`{a: 1, b: 2, c: 3, d: 4}` broken at :c is
         // {b: 1, c: 2, d: 4}).
         (let rec go9 = fn (ys: Val list) -> fn (acc: Val list) ->
            (match ys with
             | Cons (k9, Cons (v9, t9)) ->
               (match run_block world encl theblk (Cons (k9, Nil)) with
                | FBreak bv9 -> (acc, Cons (k9, Cons (v9, t9)), true, bv9)
                | FReturn rv9 -> (acc, Cons (k9, Cons (v9, t9)), true, rv9)
                | f9 -> go9 t9 (list_append acc (Cons (flow_value f9, Cons (v9, Nil)))))
             | _ -> (acc, (Nil : Val list), false, VNil)) in
          let (done9, rest9, broke9, bv9) = go9 xs (Nil : Val list) in
          let base9 = hash_merge Nil done9 in
          let rec fill9 = fn (ys: Val list) -> fn (acc: Val list) ->
            (match ys with
             | Cons (k9, Cons (v9, t9)) ->
               fill9 t9 (if hash_haskey acc k9 then acc else hash_put acc k9 v9)
             | _ -> acc) in
          let out9 = fill9 rest9 base9 in
          let _ = hset hid out9 in
          if broke9 then bv9 else recv)
       | _ -> recv)
    else if str_eq name "transform_values!" then
      (match recv with
       | VHsh hid ->
         (let (out9, broke9, bv9) = hash_tv_b world encl theblk xs in
          let _ = hset hid out9 in
          if broke9 then bv9 else recv)
       | _ -> recv)
    else if str_eq name "each_key" then iter_each_result (hash_each_one world encl theblk xs true) recv
    else if str_eq name "each_value" then iter_each_result (hash_each_one world encl theblk xs false) recv
    // delete_if / keep_if filter IN PLACE: the receiver is a handle, so the
    // kept pairs are written back to it instead of returned as a new hash.
    else if str_eq name "delete_if" || str_eq name "reject!" ||
            str_eq name "keep_if" || str_eq name "filter!" || str_eq name "select!" then
      (let keep = str_eq name "keep_if" || str_eq name "select!" || str_eq name "filter!" in
       // ⚠ the BANG names answer nil when nothing changed; delete_if / keep_if
       //   always answer self. That is a rule about the name, not a per-method
       //   choice, and it was implemented for Array#compact! and String#upcase!
       //   while reject! / select! / uniq! / flatten! returned self either way.
       let bang = str_eq name "reject!" || str_eq name "select!" || str_eq name "filter!" in
       let before = val_list_len xs in
       let f = hash_filter world encl theblk xs Nil keep in
       let changed = (match f with
                      | FNext (VHsh nid) ->
                        let after = val_list_len (hderef nid) in
                        let _ = (match recv with VHsh hid -> hset hid (hderef nid) | _ -> ()) in
                        not (before == after)
                      | _ -> false) in
       if bang && not changed then (match f with FNext _ -> VNil | other -> iter_each_result other recv)
       else iter_each_result f recv)
    // other Enumerable methods iterate the [k,v] pairs as an array; the
    // block's |k, v| params auto-splat each pair.
    else builtin_iter world encl theblk (arr_new (hash_to_a xs)) name args
  | VRange (lo, hi, excl) ->
    // An ENDLESS integer range iterates: ruby's `(1..).each` runs until the
    // block breaks, and so does this -- the bound is the largest integer, and
    // nothing materialises. `first(n)` / `take(n)` stop after n.
    (if str_eq name "bsearch" then
       (let (v9, broke9, bv9) = rng_bsearch world encl theblk lo hi excl in
        if broke9 then bv9 else v9)
     // Range#reverse_each walks from the END, so it is the end that has to be
     // there and the end whose class a refusal names. It answers the RANGE;
     // going through the materialised array answered the array. An endless
     // range has nothing to start from (a TypeError, not the RangeError of
     // "cannot convert endless range to an array" -- nothing is converted); a
     // BEGINLESS integer range counts down without end, so `(..5).reverse_each
     // .take(3)` is [5, 4, 3]; and a begin that cannot be walked names its
     // own class, with the world to name it (`class_name` reads any object as
     // "Object", so Time was refused as "can't iterate from Object").
     else if str_eq name "reverse_each" then
       (match hi with
        | VNil -> raise_exc world "TypeError" "can't iterate from NilClass"
        | _ ->
          (match lo with
           | VNil ->
             (match hi with
              | VInt b -> iter_each_result (range_down world encl theblk (if excl then b - 1 else b) (0 - int_max)) recv
              | _ -> raise_exc world "TypeError" "can't iterate from NilClass")
           | _ ->
             (if rng_is_int lo && rng_is_int hi then
                iter_each_result (range_down world encl theblk (if excl then rng_int hi - 1 else rng_int hi) (rng_int lo)) recv
              // a non-integer begin with an integer end is ruby's odd one out:
              // the message names the END ("can't iterate from Integer")
              else if rng_is_int hi && (match lo with VFlt _ -> true | _ -> false) then
                raise_exc world "TypeError" "can't iterate from Integer"
              else if (match lo with VFlt _ -> true | _ -> false) then
                raise_exc world "TypeError" "can't iterate from Float"
              else if (match lo with VObj _ -> true | _ -> false) && (if rng_is_succ_obj world lo hi then false else true) then
                raise_exc world "TypeError" ("can't iterate from " ++ display_cls_msg world (dispatch_cls_of world lo))
              else
                (let els9 = (if rng_is_succ_obj world lo hi
                             then rng_succ_vals world lo hi excl 0 Nil
                             else range_vals world lo hi excl) in
                 iter_each_result (arr_each world encl theblk (rev_vals els9)) recv))))
     // `("A"..).each` walks #succ until the block breaks -- the end is missing,
     // not unreachable. It went to the materialiser, which refused to convert
     // an endless range to an array; nothing has to be converted to walk it.
     else if str_eq name "each"
             && (match lo with VStr _ -> true | _ -> false)
             && (match hi with VNil -> true | _ -> false) then
       (match lo with
        | VStr slo -> iter_each_result (rng_str_each_endless world encl theblk (sget slo)) recv
        | _ -> recv)
     // #min / #max with a COMPARATOR block still cannot walk an endless range
     // to the end, and ruby says so by naming the method: "cannot get the
     // minimum of endless range with custom comparison method". mere-ruby
     // reached the materialisation and reported that instead -- "cannot
     // convert endless range to an array", which describes what it tried to
     // do rather than what was asked.
     else if (str_eq name "min" || str_eq name "max" || str_eq name "minmax")
             && (match hi with VNil -> true | _ -> false) then
       (if str_eq name "min"
        then raise_exc world "RangeError" "cannot get the minimum of endless range with custom comparison method"
        else raise_exc world "RangeError" "cannot get the maximum of endless range")
     // ...and the same for a BEGINLESS range, where #min and #max are the ones
     // with nothing to start from. #minmax is NOT among them: ruby reaches the
     // walk there and reports its TypeError, so it is left to do that.
     else if (str_eq name "min" || str_eq name "max")
             && (match lo with VNil -> true | _ -> false) then
       (if str_eq name "min"
        then raise_exc world "RangeError" "cannot get the minimum of beginless range"
        else raise_exc world "RangeError"
               "cannot get the maximum of beginless range with custom comparison method")
     // Range#step with a block over FLOAT bounds (either side, or a Float
     // step) yields Floats: begin + i*step for i in 0..n, n counted once the
     // way ruby counts it, so the walk neither drifts nor overshoots. An
     // exclusive end drops the last value when it lands exactly on the end.
     // This went to the integer walker, which refused a Float begin, and a
     // zero step was walked as "no step" instead of refused.
     else if str_eq name "step"
             && ((match lo with VFlt _ -> true | _ -> false)
                 || (match hi with VFlt _ -> true | _ -> false)
                 || (match args with Cons (VFlt _, _) -> true | _ -> false))
             && (match lo with VNil -> false | VInt _ -> true | VBig _ -> true | VFlt _ -> true | _ -> false)
             && (match hi with VNil -> true | VInt _ -> true | VBig _ -> true | VFlt _ -> true | _ -> false) then
       (let st9 = (match args with Cons (v9, _) -> to_f v9 | _ -> 1.0) in
        if st9 == 0.0 then raise_exc world "ArgumentError" "step can't be 0"
        else if st9 < 0.0 then recv
        else
          (let b9 = to_f lo in
           let lim9 = (match hi with VNil -> 1.0 / 0.0 | _ -> to_f hi) in
           iter_each_result (flt_step_x world encl theblk b9 lim9 st9 excl) recv))
     // ...for a NUMERIC range. A String range answers its first element for a
     // zero (or negative) step instead of raising, so this arm must not reach it.
     else if str_eq name "step" && (match args with Cons (VInt 0, _) -> true | _ -> false)
             && (match lo with VStr _ -> false | _ -> true) then
       raise_exc world "ArgumentError" "step can't be 0"
     // Range#step over STRINGS. Ruby 3.4 settled what the step may be: an
     // INTEGER takes every k-th element of the #succ walk, a STRING is ADDED to
     // each element (`("A".."AAA").step("A")` is A, AA, AAA), and anything else
     // is refused as a String conversion -- an Array, nil or an object, which
     // this walked past with step 1, and one of them (an endless range) is why
     // core/range/step_spec ran for minutes. A non-positive Integer yields the
     // first element and stops; it does NOT raise, as it does for numbers.
     else if str_eq name "step" && (match lo with VStr _ -> true | _ -> false) then
       (match args with
        | Cons (VStr sadd, _) ->
          (match lo with
           | VStr slo ->
             iter_each_result
               (rng_str_step_add world encl theblk (sget slo) (sget sadd)
                  (match hi with VStr sh -> sget sh | _ -> "") (match hi with VStr _ -> true | _ -> false) excl) recv
           | _ -> recv)
        | Cons (VInt k9, _) ->
          (if k9 <= 0 then iter_each_result (arr_each world encl theblk (Cons (lo, Nil))) recv
           else rng_str_step_int world encl theblk recv lo hi excl k9)
        | Nil -> rng_str_step_int world encl theblk recv lo hi excl 1
        | Cons (v9, _) ->
          raise_exc world "TypeError" ("no implicit conversion of " ++ conv_name v9 ++ " into String"))
     // a BEGINLESS range has nothing to step from. With a block ruby says so in
     // one sentence for every kind of end ("#step iteration for beginless
     // ranges is meaningless"); without one, a numeric end still MAKES the
     // sequence and only walking it raises -- that arm is in invoke_val_c.
     else if str_eq name "step" && (match lo with VNil -> true | _ -> false) then
       raise_exc world "ArgumentError" "#step iteration for beginless ranges is meaningless"
     else if rng_is_int lo && rng_hi_open hi then
       (let a = rng_int lo in
        if str_eq name "each" then iter_each_result (range_each world encl theblk a int_max) recv
        else if str_eq name "step" then
          iter_each_result (range_step world encl theblk a int_max (rng_step_int world args)) recv
        else if (str_eq name "first" || str_eq name "take")
                && (match args with Cons (VInt _, _) -> true | _ -> false) then
          (match args with
           | Cons (VInt k, _) -> arr_new (range_to_a a (a + (if k < 0 then 0 else k) - 1))
           | _ -> VNil)
        else if str_eq name "map" || str_eq name "collect" then
          iter_result (range_map world encl theblk a int_max Nil) recv
        else builtin_iter world encl theblk (arr_new (range_vals world lo hi excl)) name args)
     else if rng_is_int lo && rng_is_int hi then
       (let last = (if excl then rng_int hi - 1 else rng_int hi) in
        if str_eq name "each" then iter_each_result (range_each world encl theblk (rng_int lo) last) recv
        // (a..b).step(n) { } walks the range by n; without a block it is an
        // ArithmeticSequence (invoke_val_c), so this arm only ever has one.
        else if str_eq name "step" then
          iter_each_result (range_step world encl theblk (rng_int lo) last (rng_step_int world args)) recv
        else if str_eq name "map" || str_eq name "collect" then iter_result (range_map world encl theblk (rng_int lo) last Nil) recv
        else builtin_iter world encl theblk (arr_new (range_to_a (rng_int lo) last)) name args)
     else
       // `each` answers the RANGE, not the materialized list it walked --
       // `(:a..:c).each { }` returned an Array here. builtin_iter answers
       // about the array it was handed, so the receiver is put back.
       //
       // An OBJECT begin with #succ walks through rng_succ_vals; range_vals
       // refuses it, because there is nothing generic it can do without a
       // world to dispatch #succ through.
       (let els9 = (if rng_is_succ_obj world lo hi
                    then rng_succ_vals world lo hi excl 0 Nil
                    else range_vals world lo hi excl) in
        let r9 = builtin_iter world encl theblk (arr_new els9) name args in
        if str_eq name "each" && (match theblk with (true, _, _, _) -> true | _ -> false)
        then recv else r9))
  // Float#step(limit[, by]) had no arm at all. ruby computes each value as
  // beg + i*by rather than accumulating, so neither the count nor the last
  // value drifts; the same shape answers Integer#step when either argument is
  // a Float (`1.step(2, 0.5)` yields Floats).
  | VFlt fb ->
    if str_eq name "step" then
      (match args with
       // step(to: t, by: b) { }: the KEYWORD form, which this arm did not
       // have -- the hash went to to_f and came back as "not a number", so
       // 1.0.step(to: 10.0, by: 2.0) failed while the positional spelling of
       // the same walk worked.
       | Cons (VHsh hid9, Nil) ->
         (let by9 = aseq_kw (hderef hid9) "by" in
          let to9 = aseq_kw (hderef hid9) "to" in
          iter_each_result (flt_step world encl theblk fb
                              (match to9 with VNil -> 1.0 / 0.0 | v -> to_f v)
                              (match by9 with VNil -> 1.0 | v -> to_f v)) recv)
       | Cons (lim9, rest9) ->
         (let lf9 = to_f lim9 in
          let sf9 = (match rest9 with Cons (sv9, _) -> to_f sv9 | _ -> 1.0) in
          iter_each_result (flt_step world encl theblk fb lf9 sf9) recv)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: step needs a limit")) in fail "mere-ruby: step needs a limit"))
    else prim_method recv name args
  // an Integer walk whose endpoints a machine int cannot hold. `times` is
  // deliberately absent: a bignum count does not terminate, and a gate that
  // hangs is worse than one that fails.
  // Rational#step walks EXACTLY: 1/2, 3/2, 5/2 rather than a float sequence.
  | VRat (rn9, rd9) ->
    if str_eq name "step" then
      (match args with
       // step(by: n, to: m) { }: keywords; a missing `to:` walks on without end
       | Cons (VHsh hid9, Nil) ->
         (let by9 = aseq_kw (hderef hid9) "by" in
          let to9 = aseq_kw (hderef hid9) "to" in
          iter_each_result (num_step world encl theblk recv (match to9 with VNil -> VInt int_max | v -> v)
                              (match by9 with VNil -> VInt 1 | v -> v)) recv)
       | Cons (lim9, rest9) ->
         iter_each_result (num_step world encl theblk recv lim9
                             (match rest9 with Cons (b9, _) -> b9 | _ -> VInt 1)) recv
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: step needs a limit")) in fail "mere-ruby: step needs a limit"))
    else prim_method recv name args
  | VBig bs ->
    // a bignum count does not terminate in practice -- but neither does ruby's,
    // and leaving it out would be the one name an Integer claims and cannot do.
    if str_eq name "times" then
      iter_each_result (big_upto world encl theblk "0" (big_sub_s bs "1") 1) recv
    else if str_eq name "step" then
      (match args with
       | Cons (lim9, rest9) ->
         iter_each_result (num_step world encl theblk recv lim9
                             (match rest9 with Cons (b9, _) -> b9 | _ -> VInt 1)) recv
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: step needs a limit")) in fail "mere-ruby: step needs a limit"))
    else if str_eq name "upto" || str_eq name "downto" then
      (match args with
       | Cons (VInt m9, _) -> iter_each_result (big_upto world encl theblk bs (str_of_int m9) (if str_eq name "upto" then 1 else 0 - 1)) recv
       | Cons (VBig m9, _) -> iter_each_result (big_upto world encl theblk bs m9 (if str_eq name "upto" then 1 else 0 - 1)) recv
       | _ -> (prim_raise "ArgumentError" ((match args with
                  // ⚠ no argument is an ARITY error, and nil names ITSELF --
                  // "NilClass" is the class, not the word ruby uses here.
                  | Nil -> "wrong number of arguments (given 0, expected 1)"
                  | Cons (a9, _) -> "comparison of Integer with " ++ conv_name a9 ++ " failed"))))
    else prim_method recv name args
  | VInt n ->
    if str_eq name "times" then iter_each_result (range_each world encl theblk 0 (n - 1)) recv
    else if str_eq name "upto" then
      (match args with
       | Cons (VInt m, _) -> iter_each_result (range_each world encl theblk n m) recv
       // a FLOAT limit is allowed: it truncates, and Float::INFINITY means no
       // limit at all (`10.upto(Float::INFINITY)` is how an unbounded counter
       // is written -- it was refusing with "upto needs an integer").
       | Cons (VFlt f, _) ->
         iter_each_result
           (range_each world encl theblk n
              (if flt_is_inf f && f > 0.0 then int_max
               else if flt_is_nan f || flt_is_inf f then n - 1
               // ⚠ FLOOR, not truncation. `-5.upto(-1.3)` stops at -2 because
               // the endpoint floors to -2; int_of_float rounds toward zero and
               // made it -1, one step too far -- visible only for a NEGATIVE
               // endpoint, where the two directions differ.
               else (let t9 = int_of_float f in
                     if float_of_int t9 > f then t9 - 1 else t9))) recv
       | _ -> (prim_raise "ArgumentError" ((match args with
                  // ⚠ no argument is an ARITY error, and nil names ITSELF --
                  // "NilClass" is the class, not the word ruby uses here.
                  | Nil -> "wrong number of arguments (given 0, expected 1)"
                  | Cons (a9, _) -> "comparison of Integer with " ++ conv_name a9 ++ " failed"))))
    else if str_eq name "downto" then
      (match args with
       | Cons (VInt m, _) -> iter_each_result (range_down world encl theblk n m) recv
       // ...and a FLOAT limit, which ruby walks down to (3.downto(1.5) yields
       // 3 and 2). It used to be "needs an integer" -- a bare fail.
       | Cons (VFlt f9, _) -> iter_each_result (range_down world encl theblk n
                       (if flt_is_nan f9 then n + 1
                        else if flt_is_inf f9 then (if f9 > 0.0 then n + 1 else 0 - int_max)
                        // walking DOWN stops at the first value below the limit,
                        // so the last integer yielded is ceil(limit)
                        else (let t9 = int_of_float f9 in if float_of_int t9 < f9 then t9 + 1 else t9))) recv
       | _ -> (prim_raise "ArgumentError" ((match args with
                  // ⚠ no argument is an ARITY error, and nil names ITSELF --
                  // "NilClass" is the class, not the word ruby uses here.
                  | Nil -> "wrong number of arguments (given 0, expected 1)"
                  | Cons (a9, _) -> "comparison of Integer with " ++ conv_name a9 ++ " failed"))))
    else if str_eq name "step" then
      (match args with
       | Cons (VInt limit, Cons (VInt by, _)) -> iter_each_result (range_step world encl theblk n limit by) recv
       | Cons (VInt limit, Nil) -> iter_each_result (range_step world encl theblk n limit 1) recv
       // step(by: b, to: t) { }: keywords; no `to:` walks on without end, and a
       // Float in either makes it a Float walk
       | Cons (VHsh hid9, Nil) ->
         (let by9 = aseq_kw (hderef hid9) "by" in
          let to9 = aseq_kw (hderef hid9) "to" in
          (match (by9, to9) with
           | (VInt b9, VInt t9) -> iter_each_result (range_step world encl theblk n t9 b9) recv
           | (VNil, VInt t9) -> iter_each_result (range_step world encl theblk n t9 1) recv
           | (VInt b9, VNil) -> iter_each_result (range_step world encl theblk n int_max b9) recv
           | (VNil, VNil) -> iter_each_result (range_step world encl theblk n int_max 1) recv
           | (b9, t9) -> iter_each_result (flt_step world encl theblk (float_of_int n) (match t9 with VNil -> 1.0 / 0.0 | v -> to_f v) (match b9 with VNil -> 1.0 | v -> to_f v)) recv))
       // (no `Cons (VInt limit, _)` arm here: it matched `1.step(10, 2.5)` and
       // walked with a step of 1, silently dropping the Float. An integer
       // limit with a non-integer step belongs to the Float walk below.)
       // a Float anywhere makes the whole walk a Float walk, as in ruby.
       | Cons (lim9, rest9) ->
         (let lf9 = to_f lim9 in
          let sf9 = (match rest9 with Cons (sv9, _) -> to_f sv9 | _ -> 1.0) in
          iter_each_result (flt_step world encl theblk (float_of_int n) lf9 sf9) recv)
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: step needs an integer")) in fail "mere-ruby: step needs an integer"))
    else prim_method recv name args
  | _ -> prim_method recv name args

// unwrap an iterator's Flow: break -> its value; else the iterator's
// natural result (`dflt`, e.g. the receiver, or the value FNext carries).

// each/times/upto return the RECEIVER on natural completion (their body
// flows return FNext VNil); break still yields the break value.

// beg, beg+by, beg+2*by, ... while the value has not passed `lim`. The count
// is computed once (ruby's n = floor((lim-beg)/by + err)) and each value is
// beg + i*by, so a Float walk neither drifts nor overshoots its end.
// cur, cur+by, cur+2*by, ... while the value has not passed `lim`, in the
// receiver's OWN arithmetic -- a bignum stays exact and a rational stays a
// rational, where a float walk would lose both.
and num_step = fn world -> fn encl -> fn theblk -> fn (cur: Val) -> fn (lim: Val) -> fn (by: Val) ->
  let up = cmp_vals by (VInt 0) > 0 in
  let c = cmp_vals cur lim in
  if up && c > 0 then FNext VNil
  else if (if up then false else true) && c < 0 then FNext VNil
  else
    (match run_block world encl theblk (Cons (cur, Nil)) with
     | FBreak v -> FBreak v
     | FReturn v -> FReturn v
     | FRaise v -> FRaise v
     | _ -> num_step world encl theblk (arith_bin "+" cur by) lim by)

and big_upto = fn world -> fn encl -> fn theblk -> fn (cur: str) -> fn (lim: str) -> fn (dir: int) ->
  let c = big_cmp_s cur lim in
  if dir > 0 && c > 0 then FNext VNil
  else if dir < 0 && c < 0 then FNext VNil
  else
    (match run_block world encl theblk (Cons (norm_big cur, Nil)) with
     | FBreak v -> FBreak v
     | FReturn v -> FReturn v
     | FRaise v -> FRaise v
     | _ -> big_upto world encl theblk (if dir > 0 then big_add_s cur "1" else big_sub_s cur "1") lim dir)

and flt_step = fn world -> fn encl -> fn theblk -> fn (b: float) -> fn (lim: float) -> fn (st: float) ->
  if st == 0.0 then (let _ = prim_raise "ArgumentError" "step can't be 0" in FNext VNil)
  else
    let n = flt_floor ((lim - b) / st + 0.000000000001) in
    flt_step_go world encl theblk b st 0 n

// ...and the same walk for a RANGE, which may exclude its end: the last value
// is dropped when it lands on the end exactly. An infinite end walks until the
// block breaks.
and flt_step_x = fn world -> fn encl -> fn theblk -> fn (b: float) -> fn (lim: float) -> fn (st: float) -> fn (excl: bool) ->
  if flt_is_inf lim then flt_step_go world encl theblk b st 0 int_max
  else
    let n0 = flt_floor ((lim - b) / st + 0.000000000001) in
    let n = (if excl && b + float_of_int n0 * st >= lim then n0 - 1 else n0) in
    flt_step_go world encl theblk b st 0 n

and flt_step_go = fn world -> fn encl -> fn theblk -> fn (b: float) -> fn (st: float) -> fn (i: int) -> fn (n: int) ->
  if i > n then FNext VNil
  else
    (match run_block world encl theblk (Cons (VFlt (b + float_of_int i * st), Nil)) with
     | FBreak v -> FBreak v
     | FReturn v -> FReturn v
     | FRaise v -> FRaise v
     | _ -> flt_step_go world encl theblk b st (i + 1) n)

and arr_each = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> arr_each world encl theblk t)

// Array#each / #each_index / #each_with_index index into the LIVE array: the
// block may shift, pop or unshift, and what comes next is whatever is at the
// next index AFTERWARDS (`[0,1,2,3,4].each { |x| a.shift if x.even? }` yields
// 0, 2, 4). Walking a snapshot yielded the original five. The tail pointer is
// kept while the array's version is unchanged, so an untouched iteration stays
// O(n) and only a mutating one pays the re-index.
//   mode 0 = element, 1 = index, 2 = (element, index)
and arr_each_live = fn world -> fn encl -> fn theblk -> fn (id: int) ->
                    fn (i: int) -> fn (rest0: Val list) -> fn (ver0: int) -> fn (mode: int) ->
  let ver = arr_ver id in
  let rest = (if ver == ver0 then rest0 else vdrop (deref id) i) in
  match rest with
  | Nil -> FNext VNil
  | Cons (h, t) ->
    (let a9 = (if mode == 1 then Cons (VInt i, Nil)
               else if mode == 2 then Cons (h, Cons (VInt i, Nil))
               else Cons (h, Nil)) in
     match run_block world encl theblk a9 with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> arr_each_live world encl theblk id (i + 1) t ver mode)

// reverse_each walks DOWN the live array the way rindex does: the cursor is
// clamped when the block shrinks it, so an array that GROWS during iteration
// yields what is at each position as it goes.
and arr_reverse_each_live = fn world -> fn encl -> fn theblk -> fn (id: int) -> fn (i0: int) ->
  if i0 <= 0 then FNext VNil
  else
    (let i = i0 - 1 in
     match run_block world encl theblk (Cons (val_nth (deref id) i, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> (let n = val_list_len (deref id) in
             arr_reverse_each_live world encl theblk id (if i > n then n else i)))

and arr_map = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> arr_map world encl theblk t (Cons (flow_value f, acc)))

and arr_take_while = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> if truthy (flow_value f) then arr_take_while world encl theblk t (Cons (h, acc)) else FNext (arr_new (val_rev acc Nil)))
and arr_drop_while = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> FNext (arr_new Nil)
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> if truthy (flow_value f) then arr_drop_while world encl theblk t else FNext (arr_new (Cons (h, t))))
and arr_filter_map = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> let r = flow_value f in arr_filter_map world encl theblk t (if truthy r then Cons (r, acc) else acc))

// (there is ONE block-comparator rule, in insert_blk_b below. The plain
// sort_blk / insert_blk pair that used to live here held a second copy of it
// and lost its last caller when sort / sort! / sort_by moved to the
// break-aware form.)

// sort with a comparator that may `break`: the break value becomes the whole
// SORT call's result, so it cannot be read as a comparison. Answers
// (sorted, broke, break_value). (flow_value alone turned `break :a` into a
// comparison answer and the sort finished normally.)
and sort_blk_b = fn world -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> ((Nil : Val list), false, VNil)
  | Cons (h, t) ->
    (let (st, b1, v1) = sort_blk_b world theblk t in
     if b1 then (st, true, v1) else insert_blk_b world theblk h st)

and insert_blk_b = fn world -> fn theblk -> fn (x: Val) -> fn (sorted: Val list) ->
  match sorted with
  | Nil -> (Cons (x, Nil), false, VNil)
  | Cons (h, t) ->
    let amb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    (match run_block world amb theblk (Cons (x, Cons (h, Nil))) with
     | FBreak bv -> (sorted, true, bv)
     | fl ->
       (let c = (match flow_value fl with
                 | VInt n -> n
                 | VBig b -> big_sign b
                 | VFlt f -> (if f > 0.0 then 1 else if f < 0.0 then 0 - 1 else 0)
                 | VNil -> (let _ = raise_exc world "ArgumentError"
                                      ("comparison of " ++ class_name x ++ " with "
                                       ++ cmp_other_name h ++ " failed") in 0)
                 | VStr _ -> (let _ = raise_exc world "ArgumentError"
                                        "comparison of String with 0 failed" in 0)
                 | VSym _ -> (let _ = raise_exc world "ArgumentError"
                                        "comparison of Symbol with 0 failed" in 0)
                 | other -> cmp_vals_w world other (VInt 0)) in
        if c <= 0 then (Cons (x, sorted), false, VNil)
        else (let (rest, b2, v2) = insert_blk_b world theblk x t in
              if b2 then (Cons (h, rest), true, v2) else (Cons (h, rest), false, VNil))))

// keep (want=true) or drop (want=false) elements by block truthiness.
and arr_filter = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) -> fn (want: bool) ->
  match xs with
  | Nil -> FNext (arr_new (val_rev acc Nil))
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f ->
       let keep = if want then truthy (flow_value f) else (if truthy (flow_value f) then false else true) in
       arr_filter world encl theblk t (if keep then Cons (h, acc) else acc) want)

// The in-place forms of filter / map WRITE AFTER EVERY ELEMENT, because that
// is what makes their half-done state observable: when the block raises on the
// third element, ruby has already removed (or replaced) the first two and kept
// the third. Building the whole result and assigning once left the array
// untouched on a raise, which no rescue can tell from "the block never ran".
and arr_filter_ip = fn world -> fn encl -> fn theblk -> fn (id: int) -> fn (want: bool) ->
  let rec go = fn (kept: Val list) -> fn (rest: Val list) ->
    (match rest with
     | Nil -> FNext (arr_new (val_rev kept Nil))
     | Cons (h, t) ->
       (match run_block world encl theblk (Cons (h, Nil)) with
        | FBreak v -> FBreak v
        | FReturn v -> FReturn v
        | f ->
          (let keep = (if want then truthy (flow_value f)
                       else (if truthy (flow_value f) then false else true)) in
           let kept2 = (if keep then Cons (h, kept) else kept) in
           let _ = arr_set id (list_append (val_rev kept2 Nil) t) in
           go kept2 t))) in
  go Nil (deref id)

and arr_map_ip = fn world -> fn encl -> fn theblk -> fn (id: int) ->
  let rec go = fn (done9: Val list) -> fn (rest: Val list) ->
    (match rest with
     | Nil -> FNext (arr_new (val_rev done9 Nil))
     | Cons (h, t) ->
       (match run_block world encl theblk (Cons (h, Nil)) with
        | FBreak v -> FBreak v
        | FReturn v -> FReturn v
        | f ->
          (let d2 = Cons (flow_value f, done9) in
           let _ = arr_set id (list_append (val_rev d2 Nil) t) in
           go d2 t))) in
  go Nil (deref id)

// Array#rindex with a block walks DOWN from the end and re-reads the array
// every step, because ruby lets the block change it: an element that moved is
// visited where it now is, and a shrink clamps the cursor (`i0` is the
// pre-decrement cursor, exactly as CRuby's `while (i--)` reads it).
and arr_rindex_blk = fn world -> fn encl -> fn theblk -> fn (id: int) -> fn (i0: int) ->
  if i0 <= 0 then FNext VNil
  else
    (let i = i0 - 1 in
     let xs = deref id in
     match run_block world encl theblk (Cons (val_nth xs i, Nil)) with
     | FBreak v -> FBreak v
     | FReturn v -> FReturn v
     | f ->
       (if truthy (flow_value f) then FNext (VInt i)
        else (let n = val_list_len (deref id) in
              arr_rindex_blk world encl theblk id (if i > n then n else i))))

and arr_each_idx = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (i: int) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Cons (VInt i, Nil))) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> arr_each_idx world encl theblk t (i + 1))

and range_each = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (last: int) ->
  if i > last then FNext VNil
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | _ -> range_each world encl theblk (i + 1) last)

// The step of an integer walk: an Integer, 1 when absent, and a TypeError for
// anything else -- which is when ruby complains about `(1..2).step(Object.new)`:
// the Enumerator is made without a word, and the walk says "Object can't be
// coerced into Integer". Reading a stray object as 1 walked it silently.
and rng_step_int = fn world -> fn (args: Val list) ->
  match args with
  | Nil -> 1
  | Cons (VInt n, _) -> n
  // ...and an object that COERCES gives the step it coerces to: ruby asks
  // #coerce here (`(1..5).step(obj)` walks by 2 when obj coerces to 2), and
  // this refused before asking.
  | Cons (v, _) ->
    (let cv9 = (if has_coerce world v || responds world v "coerce"
                then (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
                      match invoke_val_c gc_cenv0 world nb9 v "coerce" (Cons (VInt 1, Nil)) false with
                      | VArr aid9 -> (match deref aid9 with Cons (_, Cons (y9, Nil)) -> y9 | _ -> VNil)
                      | _ -> VNil)
                else VNil) in
     match cv9 with
     | VInt n9 -> n9
     | _ -> (let _ = raise_exc world "TypeError"
                       (display_cls_msg world (dispatch_cls_of world v) ++ " can't be coerced into Integer") in 1))

// ("A"..).step(k) { }: every k-th #succ, forever, until the block breaks.
// the Integer-step walk, bounded or not (see the caller for what a step may be)
and rng_str_step_int = fn world -> fn encl -> fn theblk -> fn (recv: Val) -> fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (k: int) ->
  match hi with
  | VNil -> (match lo with
             | VStr slo -> iter_each_result (rng_str_step_endless world encl theblk (sget slo) k) recv
             | _ -> recv)
  | _ -> iter_each_result (arr_each world encl theblk (every_kth (range_vals world lo hi excl) k 0 Nil)) recv

// ...and the String-step walk: each element is the previous one PLUS the step,
// which ends when it passes the end (never, for an endless range).
and rng_str_step_add = fn world -> fn encl -> fn theblk -> fn (cur: str) -> fn (add: str) -> fn (hi: str) -> fn (has_hi: bool) -> fn (excl: bool) ->
  if has_hi && (let c = str_compare cur hi in if excl then c >= 0 else c > 0) then FNext VNil
  else
    (match run_block world encl theblk (Cons (mkstr cur, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | _ -> rng_str_step_add world encl theblk (cur ++ add) add hi has_hi excl)

and rng_str_step_endless = fn world -> fn encl -> fn theblk -> fn (cur: str) -> fn (k: int) ->
  match run_block world encl theblk (Cons (mkstr cur, Nil)) with
  | FBreak v -> FBreak v | FReturn v -> FReturn v
  | _ -> rng_str_step_endless world encl theblk (str_succ_n cur k) k
// every k-th element of a list, starting with the first

// ("A"..).each { }: #succ forever, until the block breaks (or returns).
and rng_str_each_endless = fn world -> fn encl -> fn theblk -> fn (cur: str) ->
  match run_block world encl theblk (Cons (mkstr cur, Nil)) with
  | FBreak v -> FBreak v | FReturn v -> FReturn v
  | _ -> rng_str_each_endless world encl theblk (str_succ cur)

// n.downto(m) { |i| }: descending.
and range_down = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (last: int) ->
  if i < last then FNext VNil
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | _ -> range_down world encl theblk (i - 1) last)

// n.step(limit, by) { |i| }: by may be negative (descending).
and range_step = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (limit: int) -> fn (by: int) ->
  if (by > 0 && i > limit) || (by < 0 && i < limit) || by == 0 then FNext VNil
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | _ -> range_step world encl theblk (i + by) limit by)

and range_map = fn world -> fn encl -> fn theblk -> fn (i: int) -> fn (last: int) -> fn (acc: Val list) ->
  if i > last then FNext (arr_new (val_rev acc Nil))
  else (match run_block world encl theblk (Cons (VInt i, Nil)) with
        | FBreak v -> FBreak v | FReturn v -> FReturn v
        | f -> range_map world encl theblk (i + 1) last (Cons (flow_value f, acc)))

and arr_reduce = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val) ->
  match xs with
  | Nil -> FNext acc
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (acc, Cons (h, Nil))) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> arr_reduce world encl theblk t (flow_value f))

// min_by / max_by: the element whose block value is smallest / largest.
and arr_min_by = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (want_max: bool) ->
  match xs with
  | Nil -> VNil
  | Cons (h, t) -> arr_min_by_go world encl theblk t h (flow_value (run_block world encl theblk (Cons (h, Nil)))) want_max
and arr_min_by_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (best: Val) -> fn (bestk: Val) -> fn (want_max: bool) ->
  match xs with
  | Nil -> best
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    // ...through the world: the block's answers may be objects with a `<=>`
    // of their own, and the world-free comparison raised "comparison of
    // Object with Object failed" for a class that defines one.
    let c = cmp_vals_w world k bestk in
    let better = if want_max then c > 0 else c < 0 in
    if better then arr_min_by_go world encl theblk t h k want_max
    else arr_min_by_go world encl theblk t best bestk want_max

// minmax_by in ONE walk. Asking arr_min_by twice calls the block twice per
// element, which a block with a side effect can see -- and it made the
// enumerator yield everything twice, so `[3,1,2].minmax_by.to_a` had six
// elements where ruby has three (the materialising walk IS that block).
and arr_minmax_by = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> arr_new (Cons (VNil, Cons (VNil, Nil)))
  | Cons (h, t) ->
    (let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
     arr_minmax_by_go world encl theblk t h k h k)
and arr_minmax_by_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (mn: Val) -> fn (mnk: Val) -> fn (mx: Val) -> fn (mxk: Val) ->
  match xs with
  | Nil -> arr_new (Cons (mn, Cons (mx, Nil)))
  | Cons (h, t) ->
    (let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
     let (mn2, mnk2) = (if cmp_vals_w world k mnk < 0 then (h, k) else (mn, mnk)) in
     let (mx2, mxk2) = (if cmp_vals_w world k mxk > 0 then (h, k) else (mx, mxk)) in
     arr_minmax_by_go world encl theblk t mn2 mnk2 mx2 mxk2)

// chunk: group CONSECUTIVE elements sharing a block value -> [key, [elems]].
// ruby's chunk reads THREE special values out of the block, and this read none
// of them: `nil` and `:_separator` DROP the element and close the open chunk,
// and `:_alone` puts it in a chunk of its own -- two adjacent `:_alone`
// elements are two chunks, which "is this key == the last one" cannot express.
// Any OTHER symbol beginning with an underscore is reserved and raises.
and arr_chunk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  chunk_go world encl theblk xs false VNil Nil


// `open9` says whether a chunk is being accumulated: the key alone cannot,
// because nil is a key ruby forbids and :_alone is a key that never continues.
and chunk_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
    fn (open9: bool) -> fn (curk: Val) -> fn (curacc: Val list) ->
  let done9 = (if open9 then Cons (arr_new (Cons (curk, Cons (arr_new (val_rev curacc Nil), Nil))), Nil) else (Nil : Val list)) in
  match xs with
  | Nil -> done9
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    let _ = chunk_check_key world k in
    if chunk_key_drops k then
      list_append done9 (chunk_go world encl theblk t false VNil Nil)
    else if chunk_key_alone k then
      list_append done9
        (Cons (arr_new (Cons (k, Cons (arr_new (Cons (h, Nil)), Nil))),
               chunk_go world encl theblk t false VNil Nil))
    else if open9 && rb_eq k curk then chunk_go world encl theblk t true curk (Cons (h, curacc))
    else list_append done9 (chunk_go world encl theblk t true k (Cons (h, Nil)))

// chunk_while: keep adjacent elements together WHILE block(prev, cur) is
// truthy (split when it is falsy) — the complement of slice_when.
and arr_chunk_while = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> chunk_while_go world encl theblk t h (Cons (h, Nil))
and chunk_while_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (prev: Val) -> fn (curacc: Val list) ->
  match xs with
  | Nil -> Cons (arr_new (val_rev curacc Nil), Nil)
  | Cons (h, t) ->
    if truthy (flow_value (run_block world encl theblk (Cons (prev, Cons (h, Nil)))))
    then chunk_while_go world encl theblk t h (Cons (h, curacc))
    else Cons (arr_new (val_rev curacc Nil), chunk_while_go world encl theblk t h (Cons (h, Nil)))

// slice_when: start a new run whenever block(prev, cur) is truthy.
and arr_slice_when = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) -> slice_when_go world encl theblk t h (Cons (h, Nil))
and slice_when_go = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (prev: Val) -> fn (curacc: Val list) ->
  match xs with
  | Nil -> Cons (arr_new (val_rev curacc Nil), Nil)
  | Cons (h, t) ->
    if truthy (flow_value (run_block world encl theblk (Cons (prev, Cons (h, Nil)))))
    then Cons (arr_new (val_rev curacc Nil), slice_when_go world encl theblk t h (Cons (h, Nil)))
    else slice_when_go world encl theblk t h (Cons (h, curacc))

// sort_by: sort elements by their block value (decorate-sort-undecorate).
and arr_keyed = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    Cons (arr_new (Cons (k, Cons (h, Nil))), arr_keyed world encl theblk t)

// sort_by / sort_by! with a key block that may `break`: the break value is the
// whole call's answer, and the keys computed so far are still keys (sort_by!
// writes back what it had, which is ruby's "makes some modification"). Answers
// (pairs_so_far, broke, break_value).
and arr_keyed_b = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> ((Nil : Val list), false, VNil)
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak bv -> ((Nil : Val list), true, bv)
     | fl ->
       (let k = flow_value fl in
        let (rest, b2, v2) = arr_keyed_b world encl theblk t in
        (Cons (arr_new (Cons (k, Cons (h, Nil))), rest), b2, v2)))
// the world-aware comparator: a sort_by key may be an OBJECT with its own
// `<=>` (regexp_parser sorts its version constants by Gem::Version).
and insert_by_key = fn world -> fn (p: Val) -> fn (ps: Val list) ->
  match ps with Nil -> Cons (p, Nil) | Cons (h, t) -> if cmp_vals_w world (pair_key p) (pair_key h) <= 0 then Cons (p, ps) else Cons (h, insert_by_key world p t)
and sort_by_key = fn world -> fn (ps: Val list) -> match ps with Nil -> Nil | Cons (h, t) -> insert_by_key world h (sort_by_key world t)

// Array.new(size[, fill]) / Array.new(other_array) (copy) / Array.new -> [].

// Array.new / Array#initialize's size: refused BEFORE anything is built.
// A negative size and one past the array ceiling are both ruby's
// ArgumentError; `Array.new(2**62)` otherwise recursed until the stack died.

// the arguments of Array.new / #initialize, with the conversions ruby applies:
// an object offering #to_ary IS the array, otherwise the first argument is a
// size (through #to_int) and the second the filler.
and array_init_args = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (VArr _, Nil) -> args
  | Cons (a0, rest) ->
    (match a0 with
     | VObj _ ->
       (match conv_try env world a0 "to_ary" with
        | VArr x9 -> (match rest with Nil -> Cons (VArr x9, Nil) | _ -> coerce_int_args env world args)
        | _ -> coerce_int_args env world args)
     | _ -> coerce_int_args env world args)

// sum with a block: total of the block values (starting from init).
and arr_sum_blk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> arr_sum_blk world encl theblk t (arith_bin "+" acc (flow_value (run_block world encl theblk (Cons (h, Nil)))))

// partition: [elements where block is truthy, the rest].
and arr_partition = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (yes: Val list) -> fn (no: Val list) ->
  match xs with
  | Nil -> arr_new (Cons (arr_new (val_rev yes Nil), Cons (arr_new (val_rev no Nil), Nil)))
  | Cons (h, t) ->
    if truthy (flow_value (run_block world encl theblk (Cons (h, Nil))))
    then arr_partition world encl theblk t (Cons (h, yes)) no
    else arr_partition world encl theblk t yes (Cons (h, no))

// group_by: hash of block-value -> array of elements (first-seen order).
and arr_group_by = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) ->
  match xs with
  | Nil -> mkhash acc
  | Cons (h, t) ->
    let k = flow_value (run_block world encl theblk (Cons (h, Nil))) in
    let lst = (match hash_get acc k with VArr id -> list_append (deref id) (Cons (h, Nil)) | _ -> Cons (h, Nil)) in
    arr_group_by world encl theblk t (hash_put acc k (arr_new lst))

// each_with_object(o): run block with (elem, o) for each; return o.
and arr_each_with_object = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (o: Val) ->
  match xs with
  | Nil -> o
  | Cons (h, t) -> let _ = flow_value (run_block world encl theblk (Cons (h, Cons (o, Nil)))) in arr_each_with_object world encl theblk t o

and arr_count_blk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (n: int) ->
  match xs with
  | Nil -> FNext (VInt n)
  | Cons (h, t) ->
    (match run_block world encl theblk (Cons (h, Nil)) with
     | FBreak v -> FBreak v | FReturn v -> FReturn v
     | f -> arr_count_blk world encl theblk t (if truthy (flow_value f) then n + 1 else n))

// hash.each { |k, v| ... } iterates key/value pairs of the flat list.
// Hash#each yields ONE value -- the [key, value] pair -- which a `|k, v|`
// block auto-splats. Yielding two looks the same for that shape but not for
// `|pair|` or `|(k, v)|`, where ruby hands over the pair itself (sassc builds
// its unit conversion table with the parenthesised form).
and hash_each = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       (match run_block world encl theblk (Cons (arr_new (Cons (k, Cons (v, Nil))), Nil)) with
        | FBreak bv -> FBreak bv | FReturn bv -> FReturn bv
        | _ -> hash_each world encl theblk t)
     | Nil -> FNext VNil)

// each_key / each_value yield one half of each pair (not the pair).
and hash_each_one = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (want_key: bool) ->
  match xs with
  | Nil -> FNext VNil
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       (match run_block world encl theblk (Cons ((if want_key then k else v), Nil)) with
        | FBreak bv -> FBreak bv | FReturn bv -> FReturn bv
        | _ -> hash_each_one world encl theblk t want_key)
     | Nil -> FNext VNil)

// hash.select { |k, v| ... } keeps matching pairs, rebuilding a Hash.
// transform_values / transform_keys: block-map the values / keys, keep shape.
and hash_tv = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (k, Cons (flow_value (run_block world encl theblk (Cons (v, Nil))), hash_tv world encl theblk t)) | Nil -> Nil)

// ...and the form that STOPS at a break, leaving the pairs after it as they
// were: `transform_values!` that breaks half way keeps the rest of the values
// (flow_value swallowed the break and wrote nil over them).
and hash_tv_b = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (v, t)) ->
    (match run_block world encl theblk (Cons (v, Nil)) with
     | FBreak bv -> (Cons (k, Cons (v, t)), true, bv)
     | FReturn rv -> (Cons (k, Cons (v, t)), true, rv)
     | f ->
       (let (rest9, broke9, bv9) = hash_tv_b world encl theblk t in
        (Cons (k, Cons (flow_value f, rest9)), broke9, bv9)))
  | other -> (other, false, VNil)
and hash_tk = fn world -> fn encl -> fn theblk -> fn (xs: Val list) ->
  match xs with
  | Nil -> Nil
  | Cons (k, rest) -> (match rest with Cons (v, t) -> Cons (flow_value (run_block world encl theblk (Cons (k, Nil))), Cons (v, hash_tk world encl theblk t)) | Nil -> Nil)

and hash_filter = fn world -> fn encl -> fn theblk -> fn (xs: Val list) -> fn (acc: Val list) -> fn (keep: bool) ->
  match xs with
  | Nil -> FNext (mkhash (val_rev acc Nil))
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       (match run_block world encl theblk (Cons (k, Cons (v, Nil))) with
        | FBreak bv -> FBreak bv | FReturn bv -> FReturn bv
        | f -> let cond = truthy (flow_value f) in
               let take = if keep then cond else (if cond then false else true) in
               hash_filter world encl theblk t (if take then Cons (v, Cons (k, acc)) else acc) keep)
     | Nil -> FNext (mkhash (val_rev acc Nil)))

// core methods on primitive receivers (String / Array / Hash / Integer),
// all non-mutating. Indexing (`[]`) and the read-heavy Enumerable methods
// live here; block-taking iterators live in builtin_iter.
// dispatch method `name` on any receiver value (the core of `recv.name`,
// also reused by send/__send__). `vischeck` enforces private on explicit-
// receiver calls; send/__send__ pass false (they bypass visibility).

// immediates that cannot have a singleton class (Integer/Float/Symbol/...).

// does the body define a method/class/constant (needing a definee)?

// a builtin binary operator that arith_bin evaluates (used to route an
// alias-to-builtin like `alias_method :plus, :+` to arith_bin).
// A stand-in VALUE for a builtin class, so the per-value predicates
// (op_responds, num_has) can answer a question asked about the CLASS. "" for a
// class that has no single representative.


// resolve an alias-to-builtin along cls's ancestor chain: returns the builtin
// source name (e.g. "+") for `name`, or "" if none.

// record that `n1` on `cls` delegates to a BUILTIN. Two things have to happen
// that a bare map_set does not do: an alias whose source is itself an alias has
// to point at the real builtin name (`alias old <=>` then `alias <=> old` left
// `<=>` delegating to `old`, which is not a primitive, so Integer#<=> stayed
// broken for the rest of the file), and a user-defined method under n1 has to
// GO, or has_meth keeps answering with the definition the alias replaces.
// The errno argument of SystemCallError.new, read as ruby reads it: through
// #to_int for anything that is not already an Integer. coerce_int_args only
// asks an OBJECT, and the numeric kinds that answer #to_int (Float, Rational,
// a Complex with no imaginary part) reach here as values, not objects.
and errno_arg_int = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Cons (VInt k, rest) -> Cons (VInt k, rest)
  | Cons (VFlt f, rest) -> Cons (VInt (int_of_float f), rest)
  | Cons (v, rest) ->
    (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
     match v with
     | VRat (_, _) -> (match invoke_val_c env world nb9 v "to_int" Nil false with
                       | VInt k -> Cons (VInt k, rest) | _ -> args)
     | VCpx (_, _) -> (match invoke_val_c env world nb9 v "to_int" Nil false with
                       | VInt k -> Cons (VInt k, rest) | _ -> args)
     | VObj _ -> coerce_int_args env world args
     | _ -> args)
  | Nil -> Nil

// A COPY of a proc. `pr.dup` answers a different object in ruby (and drops the
// frozen state, which is only observable once there is a second object), and
// this returned the receiver -- so a dup of a frozen proc was frozen. What a
// proc IS lives in tables keyed by its id, so a copy is those entries under a
// fresh one; the id itself is what `equal?` compares.
// the proc a mark is kept under: itself, or the one it was copied from.
// Bounded by the chain length (a copy of a copy points at the same root).



// coerce a String/Array method's arguments: a non-String object that
// responds to #to_str (or non-Array responding to #to_ary) is converted, so
// String/Array methods that need those arg types work with duck-typed args
// (CRuby's implicit conversion). Objects without to_str/to_ary are left as
// is (so existing behavior / errors are unchanged).
// The integer form of the same protocol: an object that answers #to_int is
// accepted wherever an index or a count is wanted.
and coerce_int_args = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (a, rest) ->
    let a2 = (match a with
              | VObj _ ->
                (if responds world a "to_int"
                 then (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
                       // adopt only a real Integer: a mock answers nil for
                       // methods it was not told about, and nil is a decline.
                       (match invoke_val_c env world nb a "to_int" Nil false with
                        | VInt x -> VInt x
                        | VBig b -> VBig b
                        | _ -> a))
                 else a)
              | _ -> a) in
    Cons (a2, coerce_int_args env world rest)

// string-method arguments that may be either a string or a count: ask for
// #to_str first, then #to_int, and keep the original when both decline (a
// declined argument then earns the method's own TypeError, not a nil).
and coerce_str_int_args = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (a, rest) ->
    let a2 = (match a with
              | VObj _ ->
                let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
                let r1 = (if responds world a "to_str" then invoke_val_c env world nb a "to_str" Nil false else VNil) in
                (match r1 with
                 | VStr _ -> r1
                 | _ ->
                   let r2 = (if responds world a "to_int" then invoke_val_c env world nb a "to_int" Nil false else VNil) in
                   (match r2 with VInt _ -> r2 | _ -> a))
              | _ -> a) in
    Cons (a2, coerce_str_int_args env world rest)

// String#slice / #slice! index arguments (see the dispatch comment): range
// protocol first, then per-bound / per-argument #to_int.
and coerce_slice_args = fn env -> fn world -> fn (args: Val list) ->
  let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
  let toi = fn (v: Val) ->
    (match v with
     | VObj _ ->
       (if responds world v "to_int"
        then (match invoke_val_c env world nb v "to_int" Nil false with VInt n -> VInt n | _ -> v)
        else v)
     | VFlt f ->
       (if (if f == 0.0 then false else f * 0.5 == f)
        then prim_raise "RangeError" ((if f > 0.0 then "Infinity" else "-Infinity") ++ " out of range")
        else VInt (int_of_float f))
     | _ -> v) in
  match args with
  | Cons (VRange (lo, hi, ex), rest) -> Cons (VRange (toi lo, toi hi, ex), rest)
  // a Float index truncates ("hello".slice!(0.5) is the h) -- but an
  // INFINITE one is ruby's RangeError, not a huge integer.
  | Cons (VFlt f, rest) ->
    (if (if f == 0.0 then false else f * 0.5 == f)
     then (match prim_raise "RangeError" ((if f > 0.0 then "Infinity" else "-Infinity") ++ " out of range") with
           | _ -> args)
     else Cons (VInt (int_of_float f), coerce_slice_args env world rest))
  // the range protocol applies only to a SINGLE argument (the two-argument
  // form is (index, length): both go through #to_int).
  | Cons (VObj o0, Nil) ->
    // a Range SUBCLASS instance carries its bounds in ivars (new_obj_wb).
    (let (mw, sw, ow, iw) = world in
     let oclz = map_get ow o0 in
     if exc_is_a world oclz "Range" && map_has iw (str_of_int o0 ++ "@__rg_lo") then
       (let lo9 = map_get iw (str_of_int o0 ++ "@__rg_lo") in
        let hi9 = map_get iw (str_of_int o0 ++ "@__rg_hi") in
        let ex9 = (match (if map_has iw (str_of_int o0 ++ "@__rg_ex") then map_get iw (str_of_int o0 ++ "@__rg_ex") else VBool false) with
                   | VBool b9 -> b9 | _ -> false) in
        Cons (VRange (toi lo9, toi hi9, ex9), Nil))
     else if responds world (VObj o0) "begin" && responds world (VObj o0) "end" then
       (let bv = invoke_val_c env world nb (VObj o0) "begin" Nil false in
        let ev = invoke_val_c env world nb (VObj o0) "end" Nil false in
        let ex = (if responds world (VObj o0) "exclude_end?"
                  then truthy (invoke_val_c env world nb (VObj o0) "exclude_end?" Nil false) else false) in
        Cons (VRange (toi bv, toi ev, ex), Nil))
     // ...and an object that is neither a range nor an index is REFUSED, not
     // answered with nil. `"hello"[obj]` already refused and `"hello".slice!(obj)`
     // returned nil: one protocol, two implementations, and only one of them
     // had this half. #to_str is not part of it ("doesn't call to_str on its
     // argument" is a spec of its own), which is why the refusal is decided
     // here rather than left to coerce_str_int_args, which does ask.
     else if responds world (VObj o0) "to_int" then coerce_str_int_args env world args
     else (let _ = raise_exc world "TypeError"
             ("no implicit conversion of "
              ++ display_cls_msg world (dispatch_cls_of world (VObj o0)) ++ " into Integer") in args))
  | _ -> coerce_str_int_args env world args

// Array's index arguments follow the SAME protocol String's do: for a single
// subscript an object with #begin AND #end is a range (asked BEFORE #to_int --
// which is how a permissive mock becomes nil..nil, the whole array), a real
// Range converts its bounds with #to_int, and everything else converts per
// argument. `values_at` applies it to EVERY argument.
and coerce_arr_index_args = fn env -> fn world -> fn (name: str) -> fn (args: Val list) ->
  let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
  // an Array subscript is an Integer or something that converts to one: a
  // #to_int answering a non-Integer, or no #to_int at all, is ruby's refusal
  // (a subscript that stays an object made the prim answer nil, which reads
  // as "no element there" instead of "that is not a subscript").
  // an index is a C long here, so one that does not fit is a RangeError and
  // NOT a conversion problem: the value converted fine, it is just too big.
  // (`array[bignum_value]` answered TypeError, and `array[8e19]` truncated to
  // whatever int_of_float happened to produce.)
  let long_flt = fn (f: float) ->
    (if flt_is_nan f then raise_exc world "RangeError" "float NaN out of range of integer"
     else if flt_is_inf f then
       raise_exc world "RangeError"
         ("float " ++ (if f > 0.0 then "Inf" else "-Inf") ++ " out of range of integer")
     else if f >= 9223372036854775808.0 || f < 0.0 - 9223372036854775808.0 then
       raise_exc world "RangeError" ("float " ++ str_of_float f ++ " out of range of integer")
     else VInt (int_of_float f)) in
  let toi = fn (v: Val) ->
    (match v with
     | VObj _ ->
       (if responds world v "to_int"
        then (match invoke_val_c env world nb v "to_int" Nil false with
              | VInt n -> VInt n
              | VBig b -> raise_exc world "RangeError" "bignum too big to convert into 'long'"
              | ov -> raise_exc world "TypeError"
                        ("can't convert " ++ class_name v ++ " to Integer ("
                         ++ class_name v ++ "#to_int gives " ++ class_name ov ++ ")"))
        else raise_exc world "TypeError" ("no implicit conversion of " ++ class_name v ++ " into Integer"))
     | VFlt f -> long_flt f
     | VBig b -> raise_exc world "RangeError" "bignum too big to convert into 'long'"
     | VNil -> raise_exc world "TypeError" "no implicit conversion from nil to integer"
     | VStr _ -> raise_exc world "TypeError" "no implicit conversion of String into Integer"
     | VSym _ -> raise_exc world "TypeError" "no implicit conversion of Symbol into Integer"
     | _ -> v) in
  // a range BOUND may be nil -- that is what an endless (`1..`) or beginless
  // (`..5`) range is -- so the bounds use a lenient conversion while a direct
  // subscript uses the refusing one above.
  let bound = fn (v: Val) ->
    (match v with
     | VNil -> VNil
     // everything else is refused exactly as a direct subscript is:
     // `a["a".."b"]` is a TypeError, not an empty slice.
     | other -> toi other) in
  let as_range = fn (v: Val) ->
    (match v with
     | VObj _ ->
       // a Range SUBCLASS instance keeps its bounds in ivars (new_obj_wb), so
       // it never reaches the #begin/#end protocol below.
       (let (mw9, sw9, ow9, iw9) = world in
        let oid9 = (match v with VObj o9 -> o9 | _ -> 0) in
        if exc_is_a world (map_get ow9 oid9) "Range"
           && map_has iw9 (str_of_int oid9 ++ "@__rg_lo") then
          (let lo9 = map_get iw9 (str_of_int oid9 ++ "@__rg_lo") in
           let hi9 = map_get iw9 (str_of_int oid9 ++ "@__rg_hi") in
           let ex9 = (match (if map_has iw9 (str_of_int oid9 ++ "@__rg_ex")
                             then map_get iw9 (str_of_int oid9 ++ "@__rg_ex") else VBool false) with
                      | VBool b9 -> b9 | _ -> false) in
           VRange (bound lo9, bound hi9, ex9))
        else if responds world v "begin" && responds world v "end" then
          (let bv = invoke_val_c env world nb v "begin" Nil false in
           let ev = invoke_val_c env world nb v "end" Nil false in
           let ex = (if responds world v "exclude_end?"
                     then truthy (invoke_val_c env world nb v "exclude_end?" Nil false) else false) in
           VRange (bound bv, bound ev, ex))
        else toi v)
     | VRange (lo, hi, ex) -> VRange (bound lo, bound hi, ex)
     | other -> toi other) in
  // values_at takes any number of subscripts, each an index or a range;
  // insert takes an index and then VALUES (which must not be converted);
  // flatten/rotate take one count; the rest take a subscript and a length.
  if str_eq name "values_at" then
    (let rec go = fn (xs: Val list) ->
       (match xs with Nil -> (Nil : Val list) | Cons (h, t) -> Cons (as_range h, go t)) in
     go args)
  else if str_eq name "insert" then
    (match args with Cons (a0, rest) -> Cons (toi a0, rest) | Nil -> Nil)
  // `a[i] = v` / `a[i, len] = v` / `a[range] = v`: convert the SUBSCRIPTS and
  // leave the value (which may be any object) untouched.
  else if str_eq name "[]=" || str_eq name "store" then
    // the MULTI-element forms (start+length, or a range) take an ARRAY on the
    // right, so an object offering #to_ary is converted there -- but the
    // single-index form assigns the object itself and must not convert.
    (let rhs = fn (v: Val) ->
       (match v with
        | VObj _ -> (match conv_try env world v "to_ary" with VArr x -> VArr x | _ -> v)
        | _ -> v) in
     match args with
     | Cons (a0, Cons (a1, Cons (v, Nil))) -> Cons (toi a0, Cons (toi a1, Cons (rhs v, Nil)))
     | Cons (a0, Cons (v, Nil)) ->
       (let r0 = as_range a0 in
        match r0 with
        | VRange (_, _, _) -> Cons (r0, Cons (rhs v, Nil))
        | _ -> Cons (r0, Cons (v, Nil)))
     | other -> other)
  // `at` / `delete_at` / `fetch` take an INDEX only -- no range protocol
  // (`[1,2,3].at(0..1)` is a TypeError in ruby, not a slice), so a permissive
  // mock must convert through #to_int here rather than become nil..nil.
  else if str_eq name "flatten" || str_eq name "flatten!"
          || str_eq name "rotate" || str_eq name "rotate!"
          || str_eq name "at" || str_eq name "delete_at" || str_eq name "fetch" then
    (match args with Cons (a0, rest) -> Cons (toi a0, rest) | Nil -> Nil)
  else
    (match args with
     | Cons (a0, Nil) -> Cons (as_range a0, Nil)
     | Cons (a0, rest) -> Cons (toi a0, coerce_int_args env world rest)
     | Nil -> Nil)

// A count / index argument is an Integer or something that converts to one:
// ruby truncates a Float and refuses everything else by name. `[1,2,3].first(2.5)`
// answered 1 here -- the Float went through untouched and was taken for the
// no-argument form. (`sum` is deliberately NOT one of these: its argument is an
// initial value, and `[1,2].sum(0.0)` has to stay a Float.)
and coerce_count_args = fn env -> fn world -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (a, rest) ->
    let a2 = (match a with
              | VFlt f -> VInt (int_of_float f)
              // a count that does not fit a C long is ruby's RangeError, not
              // a silent truncation: `[1,2].first(2**70)` answered 1.
              | VBig b -> raise_exc world "RangeError" "bignum too big to convert into 'long'"
              | VStr _ -> raise_exc world "TypeError" "no implicit conversion of String into Integer"
              | VNil -> raise_exc world "TypeError" "no implicit conversion from nil into Integer"
              | VSym _ -> raise_exc world "TypeError" "no implicit conversion of Symbol into Integer"
              | VBool b -> raise_exc world "TypeError"
                             ("no implicit conversion of " ++ (if b then "true" else "false") ++ " into Integer")
              | VObj _ ->
                (if responds world a "to_int"
                 then (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
                       // a #to_int that answers a NON-Integer is the object
                       // lying about its conversion: ruby names both classes
                       // rather than treating the call as "no argument".
                       (match invoke_val_c env world nb a "to_int" Nil false with
                        | VInt n9 -> VInt n9
                        | VBig b9 -> VBig b9
                        | ov9 -> raise_exc world "TypeError"
                                   ("can't convert " ++ class_name a ++ " to Integer ("
                                    ++ class_name a ++ "#to_int gives " ++ class_name ov9 ++ ")")))
                 else raise_exc world "TypeError"
                        ("no implicit conversion of " ++ class_name a ++ " into Integer"))
              | _ -> a) in
    // ...and a negative count is refused, in the words the method uses: ruby
    // says "attempt to take negative size" for take and "negative array size"
    // for first, and a Range adds "(or size too big)" to the latter.
    let _ = (match a2 with
             | VInt n ->
               (if n < 0 then
                  (let _ = raise_exc world "ArgumentError"
                     (if str_eq name "take" then "attempt to take negative size"
                      else if str_eq name "drop" then "attempt to drop negative size"
                      else if (match recv with VRange (_, _, _) -> true | _ -> false)
                      then "negative array size (or size too big)"
                      else "negative array size") in ())
                else ())
             | _ -> ()) in
    Cons (a2, coerce_count_args env world recv name rest)

and coerce_dyck_args = fn env -> fn world -> fn (recv: Val) -> fn (args: Val list) ->
  let conv = (match recv with VStr _ -> "to_str" | VArr _ -> "to_ary" | _ -> "") in
  if str_eq conv "" then args
  else coerce_dyck_go env world conv args
and coerce_dyck_go = fn env -> fn world -> fn (conv: str) -> fn (args: Val list) ->
  match args with
  | Nil -> Nil
  | Cons (a, rest) ->
    let a2 = (match a with
              // adopt only a real conversion: a mock answers nil for methods it
              // was not told about, and nil is a decline. conv_try (not
              // `responds`) is the asker, so a method_missing-based object
              // converts too.
              | VObj _ ->
                (match conv_try env world a conv with
                 | VStr x -> (if str_eq conv "to_str" then VStr x else a)
                 | VArr x -> (if str_eq conv "to_ary" then VArr x else a)
                 | _ -> a)
              | _ -> a) in
    Cons (a2, coerce_dyck_go env world conv rest)

// world-aware inspect: like the value-level `inspect`, but an object element
// gets its user-defined #inspect (Ruby's Array/Hash#inspect call #inspect on
// each element). `inspect` predates the object world and can't dispatch, so
// this variant carries `world` and recurses through containers. Objects with
// no #inspect fall back to the default rendering. (Lives in this rec group so
// it can reach has_meth / invoke.)
// `a == b` with a dispatched to its own == when it defines one.
// Does this object answer == for ITSELF -- a method-table entry, or a class
// whose == is a primitive (Time compares by its instant)? Both have to be
// dispatched rather than read as identity: `[t1] == [t2]` and `[t1].include?
// (t2)` compared identity and said false while `t1 == t2` alone was true,
// because the element search only asked the method table.
and has_own_eq = fn world -> fn (v: Val) ->
  match v with
  | VObj _ ->
    (let c = dispatch_cls_of world v in
     has_meth world c "==" || str_eq (display_cls world c) "Time")
  | _ -> false

and rb_eq_w = fn env -> fn world -> fn (a: Val) -> fn (b: Val) ->
  match a with
  | VObj _ ->
    if has_own_eq world a
    then truthy (invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) a "==" (Cons (b, Nil)) false)
    else rb_eq a b
  // a NUMERIC receiver reverses the question when the other side is an object
  // with its own == (ruby's num_equal), so `3.0 == x` asks x.
  | VInt _ -> rb_eq_num_w env world a b
  | VFlt _ -> rb_eq_num_w env world a b
  | VBig _ -> rb_eq_num_w env world a b
  // ...and a Rational or Complex reverses the question the same way: ruby's
  //   nurat_eqeq_p and nucomp_eqeq_p end in `other == self`.
  | VRat (_, _) -> rb_eq_num_w env world a b
  | VCpx (_, _) -> rb_eq_num_w env world a b
  // ⚠ `"abc" == obj` asks the OBJECT when it answers #to_str: ruby's
  //   rb_str_equal returns `obj == self` rather than comparing bytes with
  //   something that is not a String. Only the byte comparison was here, so a
  //   String-like object was never equal to any string.
  | VStr _ ->
    (match b with
     | VObj _ ->
       (if responds world b "to_str"
        then truthy (invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) b "==" (Cons (a, Nil)) false)
        else rb_eq a b)
     | _ -> rb_eq a b)
  | _ -> rb_eq a b

and rb_eq_num_w = fn env -> fn world -> fn (a: Val) -> fn (b: Val) ->
  match b with
  | VObj _ ->
    (if has_meth world (dispatch_cls_of world b) "=="
     then truthy (invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) b "==" (Cons (a, Nil)) false)
     else rb_eq a b)
  | _ -> rb_eq a b

// does any element (or any element of a nested pair) define its own ==? Only
// then is the slow, dispatching search worth taking.
and elem_has_user_eq = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (h, t) ->
    (match h with
     | VObj _ -> if has_own_eq world h then true else elem_has_user_eq world t
     // one level in, for the pairs assoc/rassoc look at — and no deeper, or a
     // self-referential array (a = []; a << a) would never bottom out.
     | VArr aid -> if shallow_has_user_eq world (deref aid) then true else elem_has_user_eq world t
     | _ -> elem_has_user_eq world t)

and shallow_has_user_eq = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (h, t) ->
    (match h with
     | VObj _ -> if has_own_eq world h then true else shallow_has_user_eq world t
     | _ -> shallow_has_user_eq world t)

// `frozen_array.delete(x)` where x is NOT there changes nothing, and ruby's
// FrozenError is about the change, not the call: it answers nil instead. Only
// Array#delete has this shape, so the predicate names it.
and delete_is_noop = fn env -> fn world -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  str_eq name "delete"
  && (match recv with
      | VArr id -> (match args with
                    | Cons (v, _) -> (if val_member_w env world (deref id) v then false else true)
                    | _ -> true)
      | _ -> false)

// `eql?` semantics, which is NOT `==`: 1.0 and 1 are equal and not eql?, so
// uniq keeps both. Two objects are compared by #hash FIRST and only then by
// #eql? (ruby never asks eql? when the hashes differ), and an object is always
// eql? to itself. uniq used rb_eq and collapsed [1.0, 1] to one element.
and rb_eql_w = fn env -> fn world -> fn (a: Val) -> fn (b: Val) ->
  let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  match a with
  | VInt _ -> (match b with VFlt _ -> false | _ -> rb_eq a b)
  | VBig _ -> (match b with VFlt _ -> false | _ -> rb_eq a b)
  | VFlt _ -> (match b with VInt _ -> false | VBig _ -> false | _ -> rb_eq a b)
  | VObj ia ->
    (match b with
     | VObj ib ->
       (let ha = invoke_val_c env world nb9 a "hash" Nil false in
        let hb = invoke_val_c env world nb9 b "hash" Nil false in
        if (if rb_eq ha hb then false else true) then false
        else if ia == ib then true
        else if has_meth world (dispatch_cls_of world a) "eql?"
        then truthy (invoke_val_c env world nb9 a "eql?" (Cons (b, Nil)) false)
        else ia == ib)
     | _ -> false)
  | _ -> rb_eq a b

// `xs <=> ys` element by element, answering VNil the moment a pair does not
// compare (ruby's Array#<=>), and the length difference when every pair is 0.
// Array#fill's span: (start, length) in element positions, from either
// (start), (start, length) or (range). Ruby's rules differ between the two
// spellings on purpose -- an index before the front CLAMPS to 0, a range that
// begins before it is a RangeError -- and a negative or zero length means
// "change nothing" rather than an error.
and arr_fill_span = fn env -> fn world -> fn (n: int) -> fn (idxargs: Val list) ->
  let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let toi9 = fn (v: Val) ->
    (match v with
     | VInt k -> k
     | VFlt f -> int_of_float f
     | VBig _ -> (let _ = raise_exc world "RangeError" "bignum too big to convert into 'long'" in 0)
     | VObj _ ->
       (match conv_try env world v "to_int" with
        | VInt k -> k
        | _ -> (let _ = raise_exc world "TypeError"
                          ("no implicit conversion of " ++ class_name v ++ " into Integer") in 0))
     | other -> (let _ = raise_exc world "TypeError"
                           ("no implicit conversion of " ++ class_name other ++ " into Integer") in 0)) in
  // a range bound may be nil (endless / beginless), and an object bound
  // converts through #to_int like any other.
  let bnd9 = fn (v: Val) -> fn (dflt: int) ->
    (match v with VNil -> dflt | other -> toi9 other) in
  // the ONE-argument form asks the range protocol first, exactly as a subscript
  // does: an object answering #begin and #end is a range, and a permissive mock
  // becomes nil..nil -- the whole array. (With a length argument there is no
  // range, so the object goes straight to #to_int and may be refused.)
  let idxargs = (match idxargs with
                 | Cons (VObj _, Nil) ->
                   (match idxargs with
                    | Cons (o9, Nil) ->
                      (if responds world o9 "begin" && responds world o9 "end" then
                         (let bv9 = invoke_val_c env world nb9 o9 "begin" Nil false in
                          let ev9 = invoke_val_c env world nb9 o9 "end" Nil false in
                          let ex9 = (if responds world o9 "exclude_end?"
                                     then truthy (invoke_val_c env world nb9 o9 "exclude_end?" Nil false)
                                     else false) in
                          Cons (VRange (bv9, ev9, ex9), Nil))
                       else idxargs)
                    | _ -> idxargs)
                 | _ -> idxargs) in
  match idxargs with
  | Nil -> (0, n)
  | Cons (VNil, Nil) -> (0, n)
  | Cons (VRange (lo, hi, ex), rest9) ->
    (match rest9 with
     | Cons (_, _) ->
       (let _ = raise_exc world "TypeError" "wrong number of arguments" in (0, 0))
     | Nil ->
       (let b0 = bnd9 lo 0 in
        let b = (if b0 < 0 then n + b0 else b0) in
        if b < 0 then
          (let _ = raise_exc world "RangeError"
                     (inspect (VRange (lo, hi, ex)) ++ " out of range") in (0, 0))
        else
          // an ENDLESS range covers to the end whether or not it is exclusive:
          // `(3...)` has no end to exclude, and treating nil as "n-1, minus one
          // for the dots" dropped the last element.
          (match hi with
           | VNil -> (b, (if n - b < 0 then 0 else n - b))
           | _ ->
             (let e0 = bnd9 hi (n - 1) in
              let e1 = (if e0 < 0 then n + e0 else e0) in
              let e2 = (if ex then e1 - 1 else e1) in
              (b, (if e2 < b then 0 else e2 - b + 1))))))
  | Cons (st, rest9) ->
    (let s0 = toi9 st in
     let sb = (if s0 < 0 then (let k = n + s0 in if k < 0 then 0 else k) else s0) in
     match rest9 with
     | Nil -> (sb, (if n - sb < 0 then 0 else n - sb))
     | Cons (VNil, _) -> (sb, (if n - sb < 0 then 0 else n - sb))
     | Cons (l9, _) -> (sb, toi9 l9))

// fill positions beg .. beg+len-1, WRITING AFTER EACH ONE so a block that
// raises leaves the earlier positions changed (and the element it raised on
// untouched), and padding with nils when the span starts past the end.
and arr_fill_go = fn world -> fn encl -> fn theblk -> fn (useblk: bool) -> fn (id: int) ->
                  fn (fillv: Val) -> fn (beg: int) -> fn (len: int) ->
  let rec go = fn (i: int) ->
    (if i >= beg + len then FNext VNil
     else
       (match (if useblk then run_block world encl theblk (Cons (VInt i, Nil)) else FNext fillv) with
        | FBreak v -> FBreak v
        | FReturn v -> FReturn v
        | f ->
          (let v9 = (if useblk then flow_value f else fillv) in
           let cur = deref id in
           let n9 = val_list_len cur in
           let base = (if i >= n9 then list_append cur (val_repeat (i - n9 + 1) VNil) else cur) in
           let _ = arr_set id (val_set_at base i v9) in
           go (i + 1)))) in
  // a span that cannot exist is refused BEFORE anything is written: ruby has an
  // array-size ceiling and raises rather than trying, and `fill(10, 1, 2**62-1)`
  // otherwise walks until the machine gives out (it took the spec run with it).
  if len <= 0 then FNext VNil
  else if beg + len > 1073741823 then
    (let _ = raise_exc world "RangeError" "array size too big" in FNext VNil)
  else go beg

and arr_sum_w = fn env -> fn world -> fn (xs: Val list) -> fn (init: Val) ->
  let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  // A non-numeric init is the ACCUMULATOR and its own `+` runs first:
  // `[1, 2].sum(obj)` is `obj + 1 + 2` in ruby. The numeric runs below sum the
  // elements and then add the init, which is the same rule when the init is a
  // number and the wrong one when it is not -- an object with a `+` was
  // refused for want of a #coerce it never needed.
  if (match init with VInt _ -> false | VFlt _ -> false | VBig _ -> false
                    | VRat (_, _) -> false | VCpx (_, _) -> false | _ -> true) then
    (let rec fold9 = fn (zs: Val list) -> fn (acc: Val) ->
       (match zs with
        | Nil -> acc
        | Cons (h9, t9) -> fold9 t9 (apply_bin_vals world noblk9 "+" acc h9)) in
     fold9 xs init)
  else
  let exact = fn (v: Val) -> (match v with VInt _ -> true | VBig _ -> true | _ -> false) in
  let numv = fn (v: Val) -> (match v with VInt _ -> true | VFlt _ -> true | VBig _ -> true | _ -> false) in
  let tof = fn (v: Val) -> (match v with
                            | VFlt f -> f
                            | VInt n -> float_of_int n
                            | VBig b -> float_of_str b
                            | _ -> 0.0) in
  let isnan9 = fn (f: float) -> (if f == f then false else true) in
  let isinf9 = fn (f: float) -> (if f == 0.0 then false else f * 0.5 == f) in
  // the float run uses NEUMAIER compensation (ruby's, which is why the spec's
  // twelve floats come to exactly 50.0 where a naive fold gives
  // 50.00000000000001), with infinities and NaN short-circuiting rather than
  // feeding the compensation term -- inf minus inf is NaN, and a naive Kahan
  // answered NaN for `[1.0, Float::INFINITY].sum`.
  let rec fsum = fn (ys: Val list) -> fn (f: float) -> fn (c: float) ->
    (match ys with
     | Nil -> f + c
     | Cons (h, t) ->
       (if numv h then
          (let x = tof h in
           if isnan9 f then fsum t f c
           else if isnan9 x then fsum t x 0.0
           else if isinf9 x then
             (if isinf9 f && (if f > 0.0 then x < 0.0 else x > 0.0) then fsum t (0.0 / 0.0) 0.0
              else fsum t x 0.0)
           else if isinf9 f then fsum t f c
           else (let t2 = f + x in
                 let c2 = (if (if f < 0.0 then 0.0 - f else f) >= (if x < 0.0 then 0.0 - x else x)
                           then c + ((f - t2) + x) else c + ((x - t2) + f)) in
                 fsum t t2 c2))
        else
          // a non-number ends the float run: what is left folds with `+`
          (let v9 = VFlt (f + c) in
           let rec go9 = fn (zs: Val list) -> fn (acc: Val) ->
             (match zs with
              | Nil -> acc
              | Cons (h9, t9) -> go9 t9 (apply_bin_vals world noblk9 "+" acc h9)) in
           match go9 ys v9 with
           | VFlt f9 -> f9
           | other -> tof other))) in
  // the exact (Integer/Bignum) run is summed on its own and then added to the
  // init WITH THE NUMBER AS RECEIVER -- `[42].sum(obj)` is `42 + obj`, which is
  // where ruby's "coerce must return [x, y]" comes from. Folding init-first
  // would have called obj's own #+ and answered instead of refusing.
  let rec go = fn (ys: Val list) -> fn (n: int) ->
    (match ys with
     | Nil -> apply_bin_vals world noblk9 "+" (VInt n) init
     | Cons (h, t) ->
       (if exact h then
          (match h with
           | VInt k -> go t (n + k)
           | _ -> (let v9 = apply_bin_vals world noblk9 "+" (VInt n) init in
                   let rec go9 = fn (zs: Val list) -> fn (acc: Val) ->
                     (match zs with
                      | Nil -> acc
                      | Cons (h9, t9) -> go9 t9 (apply_bin_vals world noblk9 "+" acc h9)) in
                   go9 ys v9))
        else if (match h with VFlt _ -> true | _ -> false) && numv init then
