  // answers to the same question depending on how it was asked. #to_s is the
  // class and address without the ivars, as it is in Ruby.
  else if (str_eq name "inspect" || str_eq name "to_s")
          && (match recv with
              | VObj oid ->
                (let (_, _, ocls9, _) = world in
                 let c9 = map_get ocls9 oid in
                 (if map_has enc_name (str_of_int oid) then false
                  else if map_has md_whole (str_of_int oid) then false
                  else if is_struct_obj_cls world c9 then false
                  // a Method / UnboundMethod writes itself the way ruby writes
                  // it, further down; this arm was answering #to_s (not
                  // #inspect) with the default `#<UnboundMethod:0x..>`
                  else if str_eq c9 "Method" || str_eq c9 "UnboundMethod" then false
                  // the object's OWN class, not `class_name recv` -- that
                  // answers "Object" here, so a class with its own #to_s had it
                  // bypassed by this arm
                  else if has_meth world c9 name then false
                  // An EXCEPTION's to_s is its message and its inspect is
                  // "#<Class: message>", answered further down this function.
                  // This arm was catching them first, so every exception OBJECT
                  // reported `#<StandardError:0x..>` as its message -- including
                  // `StandardError.new("s").message`. The exceptions that print
                  // correctly are the ones raised as a class and a message,
                  // which are a different representation and never come here.
                  else if exc_is_a world c9 "Exception" then false
                  // A backtrace Location prints as the frame it names --
                  // "path:line:in `label'" for to_s, and that string's inspect
                  // for inspect, which is how `p caller_locations` reads in ruby.
                  else if str_eq c9 "Thread::Backtrace::Location" then false
                  else true))
              | _ -> false) then
    (match recv with
     | VObj oid ->
       let (_, _, ocls9, _) = world in
       let c9 = map_get ocls9 oid in
       if str_eq name "to_s" then mkstr ("#<" ++ cls_display world (obj_print_cls world c9) ++ ":0x" ++ hex_pad16 oid ++ ">")
       else mkstr (inspect_w env world recv)
     | _ -> mkstr (inspect_w env world recv))
  // `o.singleton_class.to_s` -- an explicit call, so it arrives here rather than
  // at the value printer, and only here is there a world to name the object's
  // class with. `#<Class:#<Object:0x..>>`, not the bookkeeping name.
  else if (str_eq name "to_s" || str_eq name "inspect")
          && (match recv with VClass c8 -> is_sng_cls c8 | _ -> false) then
    (match recv with VClass c8 -> mkstr (cls_display world c8) | _ -> VNil)
  // A backtrace Location prints as the frame it names: "path:line:in `label'"
  // for to_s, and that string's inspect for inspect, which is how
  // `p caller_locations` reads in ruby.
  else if (str_eq name "to_s" || str_eq name "inspect")
          && (match recv with
              | VObj lid -> (let (_, _, ocls8, _) = world in str_eq (map_get ocls8 lid) "Thread::Backtrace::Location")
              | _ -> false) then
    (match recv with
     | VObj lid ->
       (let (_, _, _, ivars8) = world in
        let gv = fn (k: str) -> (if map_has ivars8 (str_of_int lid ++ "@" ++ k) then map_get ivars8 (str_of_int lid ++ "@" ++ k) else VNil) in
        let pth = (match gv "path" with VStr h -> sget h | _ -> "") in
        let lno = (match gv "lineno" with VInt n -> n | _ -> 0) in
        let lbl = (match gv "label" with VStr h -> sget h | _ -> "") in
        let fs = pth ++ ":" ++ str_of_int lno ++ ":in '" ++ lbl ++ "'" in
        if str_eq name "to_s" then mkstr fs else mkstr (inspect (mkstr fs)))
     | _ -> VNil)
  else
  // a singleton method defined on this exact String/Array/Hash wins.
  let hk = hng_key recv in
  if (if str_eq hk "" then false else true) && map_has hng_store hk && has_meth world (map_get hng_store hk) name then
    invoke world noblk recv (map_get hng_store hk) name args
  // an alias-to-builtin (`alias_method :plus, :+`) delegates under the source
  // builtin name: a binary operator goes through arith_bin (prim_method has no
  // "+"), everything else through prim_method.
  else if (if str_eq hk "" then false else true) && map_has hng_store hk && (if str_eq (blt_alias_lookup world (ancestors_of world (map_get hng_store hk)) name) "" then false else true) then
    (let src = blt_alias_lookup world (ancestors_of world (map_get hng_store hk)) name in
     match args with
     | Cons (arg, _) -> if is_binary_op_name src then arith_bin src recv arg else prim_method recv src args
     | Nil -> prim_method recv src args)
  // a plain builtin value (no subclass tag) whose class has an alias-to-builtin
  // registered (e.g. `class Integer; alias_method :old_plus, :+; end`): the
  // alias delegates to the source builtin — a binary operator via arith_bin
  // (prim_method has no "+"), everything else via prim_method.
  else if (if str_eq (blt_alias_lookup world (ancestors_of world (class_name recv)) name) "" then false else true) then
    (let src = blt_alias_lookup world (ancestors_of world (class_name recv)) name in
     match args with
     | Cons (arg, _) -> if is_binary_op_name src then arith_bin src recv arg else prim_method recv src args
     | Nil -> prim_method recv src args)
  // an interpolated regex literal materializes here: validate at runtime —
  // a malformed interpolation is a RegexpError (unlike the SyntaxError a
  // malformed LITERAL raises at parse time).
  else if str_eq name "__regex" && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr sp ->
       (let body = sget sp in
        let fl = (match args with Cons (VStr f, _) -> sget f | _ -> "") in
        // the interpolated pieces already merged into ONE string with ONE
        // encoding; hand it to the pattern so #encoding can answer with it.
        if rx_validate body fl then rx_build_once body fl (rx_one_enc recv) args
        // name the pattern: a runtime-built regex is usually assembled from
        // pieces, and the text is the only way to see which piece is bad.
        else raise_exc world "RegexpError" ("invalid regular expression: /" ++ body ++ "/"))
     | _ -> VNil)
  // Kernel#method(:name): a bound Method object (NameError when undefined).
  // A user-defined `method` method on the receiver's class wins.
  // Kernel#public_method is Kernel#method with one extra refusal, and it was
  // in the name list with nothing behind it: every call was a NoMethodError.
  else if (str_eq name "method" || str_eq name "public_method")
          && (match args with Cons (_, _) -> true | _ -> false)
          && (match recv with
              | VObj oid2 -> (let (m9, s9, o9, i9) = world in
                              if has_meth world (map_get o9 oid2) name then false else true)
              | _ -> true) then
    // the name argument reads the way every other name argument does: a Symbol
    // or a String as written, anything else through #to_str, and a TypeError
    // for what is neither. It used to be a pattern-match that simply did not
    // MATCH for anything else, so `o.method(1)` was a NoMethodError about
    // `method` itself.
    (let nm = (match args with
               | Cons (VSym s2, _) -> s2
               | Cons (VStr h2, _) -> sget h2
               | Cons (other2, _) ->
                 (match conv_try env world other2 "to_str" with
                  | VStr h3 -> sget h3
                  | _ -> (let _ = raise_exc world "TypeError"
                            (inspect other2 ++ " is not a symbol nor a string") in ""))
               | Nil -> "") in
     let owner = bm_owner_of world recv nm in
     let dcls2 = dispatch_cls_of world recv in
     // #public_method refuses what is not public HERE -- a private or
     // protected method is a NameError, not a Method object.
     let _ = (if str_eq name "public_method" && meth_private world dcls2 nm
              then (let _ = raise_exc world "NameError"
                      ("method '" ++ nm ++ "' for class '" ++ display_cls_msg world dcls2 ++ "' is private") in ())
              else if str_eq name "public_method" && meth_protected world dcls2 nm
              then (let _ = raise_exc world "NameError"
                      ("method '" ++ nm ++ "' for class '" ++ display_cls_msg world dcls2 ++ "' is protected") in ())
              else ()) in
     // a binary operator on a primitive is dispatched by arith_bin rather than
     // being an entry anywhere, so respond_to? does not know it; `1.method(:+)`
     // is still a Method (and #call routes it back to arith_bin).
     let exists = (if str_eq owner "" then
                     (match recv with
                      | VMain -> (let (m9, _, _, _) = world in map_has m9 nm)
                      | _ -> responds world recv nm || is_binary_op_name nm
                             // ⚠ Kernel#method includes the PRIVATE ones, so
                             //   respond_to_missing? is asked with the flag
                             //   TRUE: a name the object claims only for a
                             //   private call (`priv` in the fixture's case
                             //   statement) is still a Method. `responds` asks
                             //   with false, which is right for respond_to?
                             //   and wrong here.
                             || (let cls9 = dispatch_cls_of world recv in
                                 has_meth world cls9 "respond_to_missing?"
                                 && truthy (invoke_val_c gc_cenv0 world
                                              (false, (Nil : str list), (Nil : Stmt list), gc_cenv0)
                                              recv "respond_to_missing?"
                                              (Cons (VSym nm, Cons (VBool true, Nil))) false)))
                   else true) in
     if exists then mk_bound_method world recv owner nm
     // ...and the refusal names the CLASS ("for class 'C'"), which is the
     // shape ruby uses for #method -- not the "for an instance of" shape a
     // failed CALL reports.
     else raise_exc world "NameError"
            ("undefined method '" ++ nm ++ "' for class '"
             ++ display_cls_msg world (dispatch_cls_of world recv) ++ "'"))
  // Object#singleton_method(name): the method only if it is defined on the
  // receiver's OWN singleton (for true/false/nil, `def (false).foo` puts it on
  // FalseClass -- they have no singleton class to put it on), else ruby's
  // NameError naming the receiver. `method` would answer for an inherited one,
  // which is the difference between the two.
  else if str_eq name "singleton_method"
          && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
    (let nm = (match args with Cons (VSym s2, _) -> s2 | Cons (VStr h2, _) -> sget h2 | _ -> "") in
     let sng = (match recv with
                | VObj oid3 -> singleton_cls_of world oid3
                | VClass c3 -> "(sng:" ++ c3 ++ ")"
                // ⚠ nil / true / false have NO singleton table: their
                //   singleton class IS the class, so `def (false).foo` defines
                //   a FalseClass INSTANCE method and #singleton_method must
                //   still refuse it. Naming the class here found that method
                //   and answered a Method object -- "raises regardless of
                //   whether FalseClass defines the method" is exactly the
                //   example that says otherwise.
                | VNil -> ""
                | VBool _ -> ""
                | other -> (let hk3 = hng_key other in
                            if (if str_eq hk3 "" then false else true) && map_has hng_store hk3
                            then map_get hng_store hk3 else "")) in
     if (if str_eq sng "" then false else true) && has_own_meth world sng nm
     then mk_bound_method world recv sng nm
     else raise_exc world "NameError"
            // ruby QUOTES the receiver here: "for 'false'", not "for false".
            ("undefined singleton method '" ++ nm ++ "' for '" ++ inspect recv ++ "'"))
  // Enumerable#lazy: a Lazy over any enumerable receiver.
  else if str_eq name "lazy"
          && (match recv with
              | VArr _ -> true | VRange (_, _, _) -> true | VHsh _ -> true
              | VObj oid5 -> (let (m9, s9, o9, i9) = world in
                              let ocl5 = map_get o9 oid5 in
                              (if has_meth world ocl5 "lazy" then false else true)
                              && (has_meth world ocl5 "each" || str_eq ocl5 "Enumerator" || str_eq ocl5 "Enumerator::Chain"))
              | _ -> false) then
    mk_lazy world recv Nil
  // Enumerable#chain(*others): an Enumerator::Chain of self and the others.
  else if str_eq name "chain"
          && (match recv with
              | VArr _ -> true | VRange (_, _, _) -> true | VHsh _ -> true
              | VObj oid4 -> (let (m9, s9, o9, i9) = world in
                              let ocl4 = map_get o9 oid4 in
                              (if has_meth world ocl4 "chain" then false else true)
                              && (has_meth world ocl4 "each" || str_eq ocl4 "Enumerator" || str_eq ocl4 "Enumerator::Chain"))
              | _ -> false) then
    mk_chain world (Cons (recv, args))
  // recv.enum_for(:m) / recv.to_enum(:m) — an Enumerator over recv.m (the
  // bare-call form has its own handler; this is the explicit-receiver one).
  else if (str_eq name "enum_for" || str_eq name "to_enum")
          && (match recv with
              | VObj oid3 -> (let (m9, s9, o9, i9) = world in
                              if has_meth world (map_get o9 oid3) name then false else true)
              | _ -> true) then
    (match args with
     | Cons (VSym m, rest) -> make_enum_a world recv m rest
     | Cons (VStr m, rest) -> make_enum_a world recv (sget m) rest
     | _ -> make_enum world recv "each")
  // `recv.extend(M...)` / bare `extend M` (self is a class/object): mix each
  // module's instance methods into the receiver's singleton class.
  else if str_eq name "extend" && (match recv with VClass _ -> true | VObj _ -> true
                                         | VStr _ -> true | VArr _ -> true | VHsh _ -> true
                                         | _ -> false) then
    // extend mixes a module's instance methods in as singleton methods of the
    // receiver. For an object that means materialising its singleton class (so
    // dispatch actually runs through it); for a class it is the metaclass; a
    // mutable primitive has one too (`ARGV.extend(OptionParser::Arguable)` is
    // how optparse installs itself, and ARGV is an Array).
    // ...and it REFUSES: no argument at all, something that is not a Module
    // (a Class is not one either), and a frozen receiver. All four answered
    // the receiver's singleton class instead.
    (let _ = (match args with
              | Nil -> (let _ = raise_exc world "ArgumentError"
                          "wrong number of arguments (given 0, expected 1+)" in ())
              | _ -> ()) in
     let _ = extend_arg_check world args in
     // ...and the refusal NAMES what it refused, the way ruby's does: the
     // receiver's class and its inspect ("can't modify frozen Object:
     // #<Object:0x...>"), not the word "object" and a placeholder. A frozen
     // CLASS refuses this too, and reports itself as a Class or a Module.
     let _ = (match recv with
              | VClass c9 -> frz_cls_check world c9
              | _ -> ()) in
     let _ = (if val_frozen_mut recv
              then (let _ = raise_exc world "FrozenError"
                      ("can't modify frozen " ++ display_cls_msg world (dispatch_cls_of world recv)
                       ++ ": " ++ inspect_w env world recv) in ()) else ()) in
     let sc = (match recv with
               | VClass c -> "(sng:" ++ c ++ ")"
               | VObj id -> singleton_cls_of world id
               | VStr _ -> prim_sng_cls world recv "String"
               | VArr _ -> prim_sng_cls world recv "Array"
               | VHsh _ -> prim_sng_cls world recv "Hash"
               | _ -> "") in
     // a module with its own `self.extend_object` REPLACES the mixin: ruby
     // calls it instead, and the documented override ends with `super`, which
     // is where the mixin actually happens.
     let hooked = (let rec anyh = fn (xs: Val list) ->
                     (match xs with
                      | Nil -> false
                      | Cons (VClass m9, t9) ->
                        (if has_meth world ("(sng:" ++ m9 ++ ")") "extend_object" then true else anyh t9)
                      | Cons (_, t9) -> anyh t9) in
                   anyh args) in
     let _ = (if hooked then
                (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
                 let rec callh = fn (xs: Val list) ->
                   (match xs with
                    | Nil -> ()
                    | Cons (VClass m9, t9) ->
                      (let _ = (if has_meth world ("(sng:" ++ m9 ++ ")") "extend_object"
                                then (let _ = invoke world nb9 (VClass m9) ("(sng:" ++ m9 ++ ")")
                                                "extend_object" (Cons (recv, Nil)) in ())
                                else (let _ = do_extend_one world m9 recv in ())) in
                       callh t9)
                    | Cons (_, t9) -> callh t9) in
                 callh args)
              else extend_all sc args) in
     // ...and dispatch for a primitive goes through its tagged class, so the
     // singleton has to become that tag or the mixed-in methods are invisible
     // (its superclass is the class the value had, so nothing else moves).
     let _ = (match recv with
              | VStr _ -> map_set hng_store (hng_key recv) sc
              | VArr _ -> map_set hng_store (hng_key recv) sc
              | VHsh _ -> map_set hng_store (hng_key recv) sc
              | _ -> ()) in
     // `M.extended(base)` fires after the mixin, the mirror of `included`.
     // ActiveSupport::LazyLoadHooks initialises its hook tables there, so
     // without it `@load_hooks` stays nil.
     let _ = run_extended_hooks world args recv in
     recv)
  else
  match recv with
  | VClass c ->
    // every writer named in cls_frozen_refuses goes through this ONE check.
    // The empty-store test comes first: this arm is every class-method call in
    // the program, and a program that never freezes a class should pay one map
    // length for it, not a walk down twenty names.
    let _ = (if map_len cls_frozen > 0 && cls_frozen_refuses name args
             then frz_cls_check world c else ()) in
    // a singleton class cannot be instantiated: new / allocate raise TypeError.
    if is_sng_cls c && (str_eq name "new" || str_eq name "allocate") then
      raise_exc world "TypeError" "can't create instance of singleton class"
    // true / false / nil are the ONLY instances of their classes: ruby gives
    // those three classes no allocator (TypeError) and no `new` at all
    // (NoMethodError) -- two different refusals, which is what the specs
    // check one after the other.
    // Proc has no allocator either: a Proc is its block, and there is nothing
    // to allocate without one. (`Proc.new` with no block refuses separately.)
    else if str_eq c "Proc" && str_eq name "allocate"
            && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      raise_exc world "TypeError" "allocator undefined for Proc"
    // MatchData is made by matching, never by the program: ruby gives it
    // neither, and both refusals are NoMethodError.
    else if str_eq c "MatchData" && (str_eq name "new" || str_eq name "allocate")
            && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for class MatchData")
    // Rational and Complex are BUILT, never allocated: ruby removes both names,
    // and both refusals are NoMethodError. `Rational.new(1)` answered a plain
    // object of a class whose every method expects a numerator and a
    // denominator -- and core/rational/rational_spec asks for exactly this.
    else if (str_eq c "Rational" || str_eq c "Complex")
            && (str_eq name "new" || str_eq name "allocate")
            && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for class " ++ c)
    // ...and the classes whose values are IMMEDIATE (or opaque) have no
    // allocator at all: `new` is gone (NoMethodError) and `allocate` refuses
    // with a TypeError, the same two-step the true/false/nil specs check.
    else if (str_eq c "Symbol" || str_eq c "Integer" || str_eq c "Float"
             || str_eq c "Method" || str_eq c "UnboundMethod" || str_eq c "Binding")
            && (str_eq name "new" || str_eq name "allocate")
            && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      (if str_eq name "allocate"
       then raise_exc world "TypeError" ("allocator undefined for " ++ c)
       else raise_exc world "NoMethodError" ("undefined method 'new' for class " ++ c))
    else if (str_eq c "TrueClass" || str_eq c "FalseClass" || str_eq c "NilClass")
            && (str_eq name "new" || str_eq name "allocate")
            && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      (if str_eq name "allocate"
       then raise_exc world "TypeError" ("allocator undefined for " ++ c)
       else raise_exc world "NoMethodError" ("undefined method 'new' for class " ++ c))
    // Class#allocate: an instance with no ivars and NO initialize call. This
    // is how a class that builds its instances some other way (Date, from a
    // Julian day) gets an object to fill in.
    // Ractor REFUSES its allocator (`Ractor.allocate` is a NoMethodError), so
    // the prelude defines that refusal in Ruby and builds its instances
    // through this private door instead. An alias cannot stand in for it: an
    // alias of a builtin resolves by NAME at call time, so it would find the
    // refusal too.
    else if str_eq c "Ractor" && str_eq name "__alloc" then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let id = alloc_oid ocls0 in
       let _ = map_set ocls0 id c in
       VObj id)
    // A class may define its OWN `self.allocate` (Ractor does), and the
    // builtin arm answered first, so the definition was unreachable: the same
    // shape as `new` below.
    else if str_eq name "allocate" && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      // the store-backed builtins allocate their own empty value; anything
      // else is a plain object of that class. allocate takes no arguments.
      (if (match args with Nil -> false | _ -> true) then
         raise_exc world "ArgumentError" ("wrong number of arguments (given " ++ str_of_int (vlen args) ++ ", expected 0)")
       // String.allocate answers a BINARY empty string.
       else if str_eq c "String" then (let v = mkstr "" in (match v with VStr id -> (let _ = senc_set id "ASCII-8BIT" in v) | _ -> v))
       else if str_eq c "Array" || str_eq c "Hash" then new_obj world c Nil
       else
       let (meths0, sup0, ocls0, ivars0) = world in
       let id = alloc_oid ocls0 in
       let _ = map_set ocls0 id c in
       VObj id)
    // `private_class_method :new` (or `private :new` inside `class << self`)
    // makes .new private: the constructor is hidden and the class hands out
    // instances through a factory. The mark was recorded and nothing read it,
    // so the constructor stayed public.
    // `Proc.new` with NO block: the block is the object being asked for, and
    // ruby refuses rather than making an empty one.
    else if str_eq c "Proc" && str_eq name "new" then
      raise_exc world "ArgumentError" "tried to create Proc object without a block"
    else if str_eq name "new" && vischeck && meth_private world ("(sng:" ++ c ++ ")") "new" then
      raise_exc world "NoMethodError"
        ("private method 'new' called for class " ++ display_cls_msg world c)
    // A user-defined `def self.new` (an interning cache, a factory) is an
    // ordinary class method and outranks the built-in allocation, which its
    // `super` still reaches (see the singleton branch of ESuper).
    else if str_eq name "new" && has_meth world ("(sng:" ++ c ++ ")") name then
      invoke world noblk recv ("(sng:" ++ c ++ ")") name args
    else if str_eq c "Class" && str_eq name "new" then
      (let (meths2, sup2, ocls2, iv2) = world in
       let anon = fresh_anon "AnonClass_" in
       let _ = (match args with Cons (VClass sc, _) -> set_sup sup2 anon sc | _ -> ()) in
       VClass anon)
    // Module.new — an anonymous module (registered in `modules` so #class is
    // Module); its constants/methods live under the fresh name's namespace.
    else if str_eq c "Module" && str_eq name "new" then
      (let (meths2, sup2, ocls2, iv2) = world in
       let anon = fresh_anon "AnonModule_" in
       let _ = map_set modules anon VNil in
       VClass anon)
    else if str_eq c "Range" && str_eq name "new" then
      // Range.new(lo, hi[, excl]) -- the bounds are kept as given, nil included.
      let lo = (match args with Cons (a, _) -> a | _ -> VNil) in
      let hi = (match args with Cons (_, Cons (b, _)) -> b | _ -> VNil) in
      let excl = (match args with Cons (_, Cons (_, Cons (e, _))) -> truthy e | _ -> false) in
      if rng_bad_bounds world lo hi then raise_exc world "ArgumentError" "bad value for range"
      else VRange (lo, hi, excl)
    else if str_eq c "Hash" && str_eq name "new" then
      // at most ONE default value (and never together with a block, which the
      // block form refuses): `Hash.new(5, 6)` is a wrong-arity call. The
      // `capacity:` keyword is peeled off first -- it is not a default.
      (let (args, kwerr) = hash_new_kw world args in
       if kwerr then VNil else
       (match args with
        | Cons (_, Cons (_, _)) ->
          raise_exc world "ArgumentError"
            ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..1)")
        | _ ->
          (let hv = mkhash Nil in
           (match args with
            | Cons (d, _) -> (match hv with VHsh id -> let _ = hdflt_set id d in hv | _ -> hv)
            | _ -> hv))))
    // Array.new(n) takes a COUNT, so an object that answers #to_int is one --
    // `Array.new(o)` came back empty rather than [nil].
    else if str_eq c "Array" && str_eq name "new" then
      (match args with
       | Cons (_, Cons (_, Cons (_, _))) ->
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..2)")
       | _ ->
         (let a9 = array_init_args env world args in
          match a9 with
          | Cons (VArr aid9, Nil) -> arr_new (deref aid9)
          | Nil -> arr_new (Nil : Val list)
          | _ -> (let n9 = array_new_size env world a9 in
                  match a9 with
                  | Cons (_, Cons (d9, _)) -> arr_new (val_repeat n9 d9)
                  | _ -> arr_new (val_repeat n9 VNil))))
    // allocate makes an empty instance without running #initialize.
    // Time.now / Time.at(sec): the same minimal Time object new_obj builds,
    // seeded from the clock rather than from calendar arguments.
    // Time.utc / .gm / .local / .mktime build from calendar parts, like Time.new.
    else if str_eq c "Time" && (str_eq name "utc" || str_eq name "gm"
                                || str_eq name "local" || str_eq name "mktime") then
      (let (m9, s9, ocls9, iv9) = world in
       let id = alloc_oid ocls9 in
       let _ = map_set ocls9 id "Time" in
       let _ = map_set iv9 (str_of_int id ++ "@__t") (VInt (time_ord args)) in
       let _ = map_set time_inst (str_of_int id) (time_ord args) in
       let _ = (if str_eq name "utc" || str_eq name "gm" then map_set iv9 (str_of_int id ++ "@__utc") (VBool true) else ()) in
       VObj id)
    else if str_eq c "Time" && (str_eq name "now" || str_eq name "at") then
      (let (m9, s9, ocls9, iv9) = world in
       let id = alloc_oid ocls9 in
       let _ = map_set ocls9 id "Time" in
       let secs = (match args with
                   | Cons (VInt n, _) -> n
                   | Cons (VFlt f, _) -> int_of_float f
                   | _ -> int_of_float (time ())) in
       let _ = map_set iv9 (str_of_int id ++ "@__t") (VInt (time_ord_of_epoch secs)) in
       let _ = map_set time_inst (str_of_int id) (time_ord_of_epoch secs) in
       let _ = map_set iv9 (str_of_int id ++ "@__epoch") (VInt secs) in
       VObj id)
    else if str_eq name "allocate" && (str_eq c "Array" || str_eq c "Hash" || str_eq c "String") then
      (match args with
       | Cons (_, _) -> raise_exc world "ArgumentError" ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0)")
       | Nil -> (if str_eq c "Array" then arr_new Nil else if str_eq c "Hash" then mkhash Nil
                 // String.allocate answers a BINARY empty string, not UTF-8.
                 else (let v = mkstr "" in (match v with VStr id -> (let _ = senc_set id "ASCII-8BIT" in v) | _ -> v))))
    // a subclass of Array with no own #initialize behaves as a plain array
    // (Class.new(Array).new([0,1]) is [0,1]); back it with real array storage
    // so #deconstruct and the other array methods work.
    else if str_eq name "new" && (if str_eq c "Array" then false else obj_is_a world c "Array") then
      // back a subclass instance with real array storage, and tag the handle
      // with the subclass so its own methods dispatch (super reaches Array).
      // With its own #initialize the storage starts EMPTY and initialize runs
      // against it, so a `self << x` in there appends to this array.
      (if has_meth world c "initialize" then
         (let v = arr_new Nil in
          let _ = map_set hng_store (hng_key v) c in
          let _ = invoke world noblk v c "initialize" args in
          v)
       else
         (let v = array_new_args args in
          let _ = (match v with VArr _ -> map_set hng_store (hng_key v) c | _ -> ()) in v))
    // a subclass of Hash is backed by real hash storage and tagged with the
    // subclass, the same way an Array subclass is — otherwise h[:k] = v on an
    // instance has nowhere to write.
    else if str_eq name "new" && (if str_eq c "Hash" then false else obj_is_a world c "Hash") then
      (if has_meth world c "initialize" then
         (let v = mkhash Nil in
          let _ = map_set hng_store (hng_key v) c in
          let _ = invoke world noblk v c "initialize" args in
          v)
       else
         (let v = mkhash Nil in
          let _ = (match args with Cons (d, _) -> (match v with VHsh hid -> hdflt_set hid d | _ -> ()) | _ -> ()) in
          let _ = map_set hng_store (hng_key v) c in v))
    // a subclass of String is backed by real string storage and tagged so its
    // own methods dispatch (super reaches String). With its own #initialize the
    // storage starts EMPTY and initialize runs against it, the same way an
    // Array subclass does -- so a `super(x)` in there fills this string.
    else if str_eq name "new" && (if str_eq c "String" then false else obj_is_a world c "String") then
      (if has_meth world c "initialize" then
         (let v = mkstr "" in
          let _ = map_set hng_store (hng_key v) c in
          let _ = invoke world noblk v c "initialize" args in
          v)
       else
         (let v = (match args with Cons (VStr h, _) -> mkstr (sget h) | _ -> mkstr "") in
          let _ = (match v with VStr _ -> map_set hng_store (hng_key v) c | _ -> ()) in v))
    // Hash[k => v, ...] / Hash[{...}] and Array[...] constructor syntax.
    // Hash[...] takes three shapes: one Hash, one array of [k, v] pairs, or a
    // flat even-length argument list. Only the first was built; the other two
    // answered an empty hash, which is a wrong answer rather than an error.
    else if str_eq c "Hash" && str_eq name "[]" then
      // a SINGLE argument may be an object offering #to_hash or #to_ary --
      // `Hash[obj]` was a wrong-arity error for anything but a Hash or Array.
      (let a9 = (match args with
                 | Cons (VObj _, Nil) ->
                   (match args with
                    | Cons (o9, Nil) ->
                      (match conv_try env world o9 "to_hash" with
                       | VHsh x9 -> Cons (VHsh x9, Nil)
                       | _ -> (match conv_try env world o9 "to_ary" with
                               | VArr y9 -> Cons (VArr y9, Nil)
                               | _ -> args))
                    | _ -> args)
                 | _ -> args) in
       hash_bracket world a9)
    else if str_eq c "Array" && str_eq name "[]" then arr_new args
    // A subclass inherits the [] constructor: MyArray[1, 2] builds an array
    // tagged with the subclass, WITHOUT calling the subclass's #initialize
    // (which is the whole point of the spec fixtures that use it).
    else if str_eq name "[]" && obj_is_a world c "Array" then
      (let v = arr_new args in
       let _ = map_set hng_store (hng_key v) c in v)
    else if str_eq name "[]" && obj_is_a world c "Hash" then hash_bracket world args
    // Hash.ruby2_keywords_hash?(h) / Hash.ruby2_keywords_hash(h): the "keywords
    // hash" mark is the one a `key:` argument already carries here (a
    // ruby2_keywords method keeps it instead of demoting it), so the predicate
    // reads that table and the constructor copies the hash and marks the copy.
    else if str_eq c "Hash" && str_eq name "ruby2_keywords_hash?" then
      (match args with
       | Cons (VHsh h9, _) -> VBool (map_has r2k_marks (str_of_int h9))
       | Cons (other9, _) ->
         raise_exc world "TypeError" ("no implicit conversion of " ++ class_name other9 ++ " into Hash")
       | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)")
    else if str_eq c "Hash" && str_eq name "ruby2_keywords_hash" then
      (match args with
       | Cons (VHsh h9, _) ->
         // (the copy keeps the default, the default_proc, the subclass tag and
         // the ivars.)
         // ⚠ ...and the identity flag, for an EMPTY hash too. ruby 3.2 kept it
         //   only when the source had PAIRS -- there was no table to copy it
         //   from otherwise -- and this was written against that reference;
         //   ruby 4 keeps it either way, which is its own spec's expectation.
         (let cp9 = mkhash (hderef h9) in
          let _ = hcbi_copy h9 cp9 in
          let (m9k, s9k, o9k, iv9k) = world in
          let _ = (match cp9 with
                   | VHsh d9 ->
                     (let _ = (if map_has hash_dflt (str_of_int h9)
                               then map_set hash_dflt (str_of_int d9) (map_get hash_dflt (str_of_int h9)) else ()) in
                      let _ = (if map_has hash_dproc (str_of_int h9)
                               then map_set hash_dproc (str_of_int d9) (map_get hash_dproc (str_of_int h9)) else ()) in
                      // the subclass tag and the instance variables ride along
                      let _ = (let hk9 = hng_key (VHsh h9) in
                               if map_has hng_store hk9 then map_set hng_store (hng_key cp9) (map_get hng_store hk9) else ()) in
                      let oldp9 = hng_key (VHsh h9) ++ "@" in
                      let newp9 = hng_key cp9 ++ "@" in
                      let tmp9 = map_new () in
                      let _ = map_iter iv9k (fn (k9: str) -> fn (v9: Val) ->
                                if str_len k9 > str_len oldp9 && str_eq (substring k9 0 (str_len oldp9)) oldp9
                                then map_set tmp9 (newp9 ++ substring k9 (str_len oldp9) (str_len k9)) v9
                                else ()) in
                      let _ = map_iter tmp9 (fn (k9: str) -> fn (v9: Val) -> map_set iv9k k9 v9) in
                      let _ = map_set r2k_marks (str_of_int d9) VNil in
                      mark_kw d9)
                   | _ -> ()) in
          cp9)
       | Cons (other9, _) ->
         raise_exc world "TypeError" ("no implicit conversion of " ++ class_name other9 ++ " into Hash")
       | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)")
    else if str_eq c "Hash" && str_eq name "try_convert" then
      (match args with
       | Cons (VHsh hid, _) -> VHsh hid
       // a #to_hash answering nil declines; one answering a NON-hash is the
       // object lying about its type, which is a TypeError rather than itself.
       | Cons (VObj oid, _) ->
         (if responds world (VObj oid) "to_hash" then
            (match invoke_val_c env world noblk (VObj oid) "to_hash" Nil false with
             | VHsh r9 -> VHsh r9
             | VNil -> VNil
             | ov -> raise_exc world "TypeError"
                       ("can't convert " ++ class_name (VObj oid) ++ " into Hash ("
                        ++ class_name (VObj oid) ++ "#to_hash gives " ++ class_name ov ++ ")"))
          else VNil)
       | _ -> VNil)
    else if str_eq c "Array" && str_eq name "try_convert" then
      (match args with
       | Cons (VArr aid, _) -> VArr aid
       // a #to_ary that answers nil means "cannot convert"; one that answers a
       // NON-array is the object lying about its type, and that is a TypeError
       // rather than the object itself coming back.
       | Cons (VObj oid, _) ->
         (if responds world (VObj oid) "to_ary" then
            (match invoke_val_c env world noblk (VObj oid) "to_ary" Nil false with
             | VArr r -> VArr r
             | VNil -> VNil
             | ov -> raise_exc world "TypeError"
                       ("can't convert " ++ class_name (VObj oid) ++ " into Array ("
                        ++ class_name (VObj oid) ++ "#to_ary gives " ++ class_name ov ++ ")"))
          else VNil)
       | _ -> VNil)
    else if str_eq c "String" && str_eq name "try_convert" then
      (match args with
       | Cons (VStr sid, _) -> VStr sid
       | Cons (VObj oid, _) ->
         // a #to_str that answers nil means "cannot convert" (nil result);
         // one that answers a NON-string is the object lying about its type.
         (if responds world (VObj oid) "to_str" then
            (match invoke_val_c env world noblk (VObj oid) "to_str" Nil false with
             | VStr r -> VStr r
             | VNil -> VNil
             | ov -> raise_exc world "TypeError"
                       ("can't convert " ++ class_name (VObj oid) ++ " to String ("
                        ++ class_name (VObj oid) ++ "#to_str gives " ++ class_name ov ++ ")"))
          else VNil)
       | _ -> VNil)
    // Module#ruby2_keywords via a receiver path (e.g. `send :ruby2_keywords,
    // :m` routes here): mark the named method, same as the bare-call handler.
    else if str_eq name "ruby2_keywords" && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      (let _ = (match args with
                | Cons (VSym s, _) -> map_set r2k_methods s VNil
                | Cons (VStr s, _) -> map_set r2k_methods (sget s) VNil
                | _ -> ()) in
       VNil)
    // Klass.class_eval("code") / module_eval / *_exec with a string: run the
    // code as class-body statements (def defines methods of the class).
    else if (str_eq name "class_eval" || str_eq name "module_eval" || str_eq name "class_exec" || str_eq name "module_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
      (match args with
       | Cons (VStr code, frest) ->
         // the 2nd and 3rd arguments name the file and line (see eval_file_arg)
         let ef = eval_file_arg (match frest with Cons (fv, _) -> fv | _ -> VNil) in
         let el = eval_line_arg (match frest with Cons (_, Cons (lv, _)) -> lv | _ -> VNil) in
         let savedpf = eval_pfile_push ef in
         let _ = set_parsing_eval (sget code) in
         let toks = number_nls_at (sget code) (lex_go (sget code) 0) el in
         let (p2, _) = parse_stmts toks Nil in
         let _ = map_set load_ctx "parsing" (mkstr "") in
         // string-form *_eval sets the lexical scope (cref) to the receiver.
         let saved = cur_lex () in let _ = set_lex c in
         let r = flow_value (register_class world c p2) in
         let _ = set_lex saved in
         let _ = eval_pfile_pop savedpf in r
       | _ -> VClass c)
    // string-form instance_eval on a class/module runs in the receiver's
    // SINGLETON scope: a constant assigned there lands in the singleton
    // class's namespace, not on the class itself (Module::Const stays absent).
    else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
      (match args with
       | Cons (VStr code, _) -> let (p2, _) = parse_stmts (lex_go (sget code) 0) Nil in
         let sng = "(sng:" ++ c ++ ")" in
         let saved = cur_lex () in let _ = set_lex sng in
         let r = flow_value (register_class world sng p2) in
         let _ = set_lex saved in r
       | _ -> VClass c)
    else if struct_generator_cls world c && str_eq name "new" then struct_build world c args
    // Encoding class methods: the known encodings, and the locale charmap
    // (always UTF-8 in this interpreter — no locale probing).
    else if str_eq c "Encoding" && str_eq name "list" then
      (let out = map_new () in
       let _ = map_iter enc_objs (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
       arr_new (idx_to_list out 0 (map_len out)))
    else if str_eq c "Encoding" && str_eq name "locale_charmap" then mkstr "UTF-8"
    // Encoding.find: special names resolve to the locale (UTF-8 here);
    // "internal" is nil (no default_internal).
    else if str_eq c "Encoding" && str_eq name "find" then
      (match args with
       | Cons (VStr nh, _) ->
         (let nm2 = sget nh in
          if str_eq nm2 "internal" then (if map_has def_int_enc "v" then map_get def_int_enc "v" else VNil)
          else
            let canon = (if str_eq nm2 "locale" || str_eq nm2 "external" || str_eq nm2 "filesystem" then "UTF-8" else enc_find_canon nm2) in
            if map_has enc_objs canon then map_get enc_objs canon
            else raise_exc world "ArgumentError" ("unknown encoding name - " ++ nm2))
       | _ -> raise_exc world "TypeError" "no implicit conversion into String")
    else if str_eq c "Encoding" && str_eq name "default_external" then
      (if map_has def_ext_enc "v" then map_get def_ext_enc "v"
       else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else VNil)
    else if str_eq c "Encoding" && str_eq name "default_external=" then
      (match args with
       | Cons (v, _) -> let _ = map_set def_ext_enc "v" v in v
       | _ -> VNil)
    else if str_eq c "Encoding" && str_eq name "default_internal" then
      (if map_has def_int_enc "v" then map_get def_int_enc "v" else VNil)
    else if str_eq c "Encoding" && str_eq name "default_internal=" then
      (match args with
       | Cons (VNil, _) -> let _ = (if map_has def_int_enc "v" then map_delete def_int_enc "v" else ()) in VNil
       | Cons (v, _) -> let _ = map_set def_int_enc "v" v in v
       | _ -> VNil)
    // Enumerator.new requires a block (the legacy obj/method form is gone).
    else if str_eq c "Enumerator" && str_eq name "new" then
      raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1..)"
    // Thread class methods (synchronous model; see the Thread.new boundary).
    else if str_eq c "Thread" then
      (let (mth0, sup0, ocl0, ivars) = world in
       if str_eq name "current" then
         (if map_has cur_thr "v" then map_get cur_thr "v" else VNil)
       else if str_eq name "main" then
         (if map_has all_thr "0" then map_get all_thr "0" else VNil)
       // pass is a scheduling no-op: the calling thread just continues. A
       // body that spins on it forever parks via the iteration budget.
       else if str_eq name "pass" then VNil
       else if str_eq name "stop" then
         (if in_thread () then raise_exc world "__ThreadPark" "sleep"
          else raise_exc world "ThreadError" "stopping only thread\n\tnote: use sleep to stop forever")
       else if str_eq name "exit" then
         (if in_thread () then raise_exc world "__ThreadPark" "kill" else VNil)
       else if str_eq name "kill" then
         (match args with
          | Cons (t, _) -> invoke_val_c env world blk t "kill" Nil false
          | _ -> VNil)
       else if str_eq name "list" then
         (let out = map_new () in
          let _ = map_iter all_thr (fn (k2: str) -> fn (t: Val) ->
            (match t with
             | VObj tid2 ->
               (match (if map_has ivars (str_of_int tid2 ++ "@__tst") then map_get ivars (str_of_int tid2 ++ "@__tst") else VBool false) with
                | VStr _ -> let i2 = map_len out in map_set out (str_of_int i2) t
                | _ -> ())
             | _ -> ())) in
          arr_new (idx_to_list out 0 (map_len out)))
       else if str_eq name "new" || str_eq name "start" || str_eq name "fork" then
         raise_exc world "ThreadError" "must be called with a block"
       else if str_eq name "abort_on_exception" || str_eq name "report_on_exception" then VBool false
       else if str_eq name "abort_on_exception=" || str_eq name "report_on_exception=" then
         (match args with Cons (v, _) -> v | _ -> VNil)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for Thread"))
    // Queue / SizedQueue / ConditionVariable constructors.
    // ⚠ these three fresh ids come from alloc_oid, NOT from `map_len ocls`.
    //   They were the last three sites left on the old scheme, and one id
    //   space with two allocators issues the same id twice: alloc_oid carries
    //   its counter in the map as "$next", which map_len then COUNTS, so the
    //   two disagree from the first allocation onward. A Queue and a plain
    //   object got the same id, which means the same ivar slots -- `M.new(q)`
    //   read its own `@a` out of the queue's row and answered ITSELF, and the
    //   mspec matcher built that way recursed until the stack ran out. It
    //   needs no collection to happen; see alloc_oid for the reason it exists.
    else if (str_eq c "Queue" || str_eq c "SizedQueue") && str_eq name "new" then
      (let (mth0, sup0, ocl0, iv0) = world in
       // Queue.new(enumerable) seeds from the argument: an Array directly,
       // anything else through #to_a (TypeError when absent or when it
       // returns a non-Array; an exception raised by #to_a propagates).
       let seed =
         (if str_eq c "Queue" then
            (match args with
             | Nil -> Nil
             | Cons (VArr aid, _) -> deref aid
             | Cons (VObj oid, _) ->
               (let ocls2 = map_get ocl0 oid in
                let noblk2 = (false, (Nil : str list), (Nil : Stmt list), env) in
                if has_meth world ocls2 "to_a" || has_meth world ocls2 "method_missing" then
                  (match invoke_val_c env world noblk2 (VObj oid) "to_a" Nil false with
                   | VArr aid -> deref aid
                   | other ->
                     let _ = raise_exc world "TypeError"
                       ("can't convert " ++ display_cls world ocls2 ++ " into Array ("
                        ++ display_cls world ocls2 ++ "#to_a gives " ++ class_name other ++ ")") in
                     Nil)
                else
                  let _ = raise_exc world "TypeError"
                    ("can't convert " ++ display_cls world ocls2 ++ " into Array") in
                  Nil)
             | Cons (v, _) ->
               let _ = raise_exc world "TypeError"
                 ("can't convert " ++ class_name v ++ " into Array") in
               Nil)
          else Nil) in
       let id2 = alloc_oid ocl0 in
       let _ = map_set ocl0 id2 c in
       let _ = map_set iv0 (str_of_int id2 ++ "@__q") (arr_new seed) in
       let _ = (if str_eq c "SizedQueue" then
                  (match args with
                   | Cons (VInt mx, _) ->
                     (if mx <= 0 then (let _ = raise_exc world "ArgumentError" "queue size must be positive" in ())
                      else map_set iv0 (str_of_int id2 ++ "@__qmax") (VInt mx))
                   | _ -> let _ = raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)" in ())
                else ()) in
       VObj id2)
    else if str_eq c "ConditionVariable" && str_eq name "new" then
      (let (mth0, sup0, ocl0, iv0) = world in
       let id2 = alloc_oid ocl0 in
       let _ = map_set ocl0 id2 "ConditionVariable" in
       VObj id2)
    // ThreadGroup: groups are markers on thread objects (@__tgrp).
    else if str_eq c "ThreadGroup" && str_eq name "new" then
      (let (mth0, sup0, ocl0, iv0) = world in
       let id2 = alloc_oid ocl0 in
       let _ = map_set ocl0 id2 "ThreadGroup" in
       VObj id2)
    // Complex class methods: polar / rectangular constructors. A Complex
    // argument with a zero imaginary part demotes to its real part
    // (CRuby's nucomp_real_check); otherwise TypeError "not a real".
    else if str_eq c "Complex" && (str_eq name "polar" || str_eq name "rectangular" || str_eq name "rect") then
      (let args = cpx_realize_args world args in
       match args with
       | Cons (m, Cons (th, _)) ->
         (if str_eq name "polar" then
            (if is_num m && is_num th && (match m with VCpx _ -> false | _ -> true) && (match th with VCpx _ -> false | _ -> true) then
               // CRuby's axis special cases keep the magnitude exact: a zero
               // component, and float angles of exactly pi / pi/2 / 3pi/2.
               (if rb_eq m (VInt 0) || rb_eq th (VInt 0) then VCpx (m, VFlt 0.0)
                else
                  let pi = 3.141592653589793 in
                  (match th with
                   | VFlt arg ->
                     (if arg == pi then VCpx (num_neg m, VFlt 0.0)
                      else if arg == pi * 0.5 then VCpx (VFlt 0.0, m)
                      else if arg == pi * 0.5 + pi then VCpx (VFlt 0.0, num_neg m)
                      else VCpx (VFlt (to_f m * cos arg), VFlt (to_f m * sin arg)))
                   | _ -> VCpx (VFlt (to_f m * cos (to_f th)), VFlt (to_f m * sin (to_f th)))))
             else raise_exc world "TypeError" "not a real")
          // rectangular's two components are reals as well -- it had no check at
          // all, so `Complex.rectangular(Object.new, 1)` built a Complex with an
          // object in it, which then printed as `(#<object>+1i)`.
          else if is_num m && is_num th
                  && (match m with VCpx _ -> false | _ -> true)
                  && (match th with VCpx _ -> false | _ -> true)
          then VCpx (m, th)
          else raise_exc world "TypeError" "not a real")
       | Cons (m, Nil) ->
         (if is_num m && (match m with VCpx _ -> false | _ -> true)
          then (if str_eq name "polar" then VCpx (num_abs m, VInt 0) else VCpx (m, VInt 0))
          else raise_exc world "TypeError" "not a real")
       | _ -> raise_exc world "ArgumentError" "wrong number of arguments")
    // File class methods over the native externs (read/write/exist?/...).
    // `File` is a class, so `Module`'s own methods have to reach the generic
    // class dispatch below rather than stop at this namespace's terminal
    // NoMethodError -- `File.const_defined?` is what devise and sidekiq-pro ask
    // when they check for a constant before using it. (Math and Kernel decline
    // the same set for the same reason, a few branches down.)
    // IO.pipe: a real pipe pair needs the OS, and nothing here can hand one out --
    // the socket FFI does not cover pipes and `run` shells out rather than
    // plumbing descriptors. It refuses by name so a caller sees which primitive
    // is missing instead of a NoMethodError on IO, which says nothing about why.
    // Reached from Open3 (bundler requires it lazily inside the methods that
    // capture a subprocess).
    else if str_eq c "IO" && str_eq name "pipe" then
      prim_raise "NotImplementedError" "IO.pipe is not implemented here (no pipe primitive)"
    // IO.read / IO.write and friends are the same methods as File's in ruby (File
    // < IO, and these are IO's own class methods), so the branch answers for both
    // rather than a second copy drifting from this one.
    else if (str_eq c "File"
             || (str_eq c "IO"
                 && (str_eq name "read" || str_eq name "write" || str_eq name "binread"
                     || str_eq name "binwrite" || str_eq name "readlines" || str_eq name "foreach")))
            && (if is_module_method name then false else true) then
      (if str_eq name "read" || str_eq name "binread" then
         // read / binread both slurp the whole file; mere str is byte-safe
         // (length header), so binary content with NULs round-trips. binread
         // tags the result ASCII-8BIT so slicing/indexing is byte-based.
         (match args with
          | Cons (VStr ph, _) ->
            (let path = sget ph in
             if file_exists path then
               (let r = mkstr (read_file path) in
                if str_eq name "binread" then (match r with VStr rid -> let _ = senc_set rid "ASCII-8BIT" in r | _ -> r) else r)
             else raise_exc world "Errno::ENOENT" ("No such file or directory @ rb_sysopen - " ++ path))
          | _ -> raise_exc world "TypeError" "no implicit conversion into String")
       // write / binwrite both write the string's bytes: a mere str carries its
       // length, so a zero byte in the content is not a terminator.
       else if str_eq name "write" || str_eq name "binwrite" then
         (match args with
          | Cons (VStr ph, Cons (v, _)) ->
            (let content = (match v with VStr ch -> sget ch | _ -> to_s v) in
             let _ = write_file (sget ph) content in
             VInt (str_len content))
          | _ -> raise_exc world "ArgumentError" "wrong number of arguments")
       // File.split(path) -> [dirname, basename]
       else if str_eq name "split" then
         (match args with
          | Cons (VStr ph, _) -> let ph = sget ph in
            arr_new (Cons (mkstr (dirname_of ph), Cons (mkstr (basename_of ph), Nil)))
          | _ -> raise_exc world "TypeError" "no implicit conversion into String")
       else if str_eq name "exist?" || str_eq name "exists?" then
         (match args with Cons (VStr ph, _) -> VBool (file_exists (sget ph)) | _ -> VBool false)
       // ⚠ `file?` IS NOT `exist?`: a directory exists and is not a file.
       // Answering exist? for both made mspec's own mkdir_p refuse every path
       // whose parent it had already created ("path component ... is a file"),
       // and core/kernel/printf read DIFF against an interpreter that had done
       // nothing wrong. `test -f` is the question being asked.
       else if str_eq name "file?" then
         (match args with
          | Cons (VStr ph, _) -> VBool (run ("test -f " ++ shq (sget ph) ++ " 2> /dev/null") == 0)
          | _ -> VBool false)
       // File.fnmatch?(pattern, path): the same matcher Dir.glob uses.
       else if str_eq name "fnmatch" || str_eq name "fnmatch?" then
         (match args with
          | Cons (VStr pp, Cons (VStr sp, _)) -> VBool (glob_any (glob_fnm_flags args) (glob_expand (sget pp)) (sget sp))
          | _ -> VBool false)
       // File.realpath / realdirpath: the absolute path, raising when it does
       // not exist. mere-ruby has no lstat, so symlinks are NOT resolved —
       // the result is expand_path's, which differs only under a symlink.
       else if str_eq name "realpath" || str_eq name "realdirpath" then
         (match args with
          | Cons (VStr ph, rest) ->
            (let p1 = sget ph in
             let base0 = (match rest with Cons (VStr b, _) -> sget b | _ -> env_get "PWD") in
             // ...and a RELATIVE base is expanded first: `File.realpath(p, ".")`
             // answered a relative path, and realpath's answer is absolute.
             let base = (if str_len base0 > 0 && str_eq (char_at base0 0) "/" then base0
                         else env_get "PWD" ++ "/" ++ base0) in
             let abs = (if str_len p1 > 0 && str_eq (char_at p1 0) "/" then p1 else base ++ "/" ++ p1) in
             let full = path_norm abs in
             if file_exists full then mkstr full
             else raise_exc world "Errno::ENOENT" ("No such file or directory @ realpath_rec - " ++ full))
          | _ -> mkstr "")
       // File.path(obj): the string form of a path — the object itself when it
       // is already a String, else its #to_path.
       else if str_eq name "path" then
         (match args with
          | Cons (VStr ph, _) -> mkstr (sget ph)
          | Cons (v, _) -> invoke_val_c env world noblk v "to_path" Nil false
          | _ -> mkstr "")
       else if str_eq name "basename" then
         (match args with
          | Cons (VStr ph, Cons (VStr sf, _)) -> mkstr (basename_suffix (basename_of (sget ph)) (sget sf))
          | Cons (VStr ph, _) -> mkstr (basename_of (sget ph))
          | _ -> mkstr "")
       else if str_eq name "dirname" then
         (match args with Cons (VStr ph, _) -> mkstr (dirname_of (sget ph)) | _ -> mkstr "")
       // File.extname: the last dot and after, in the basename — "" when the
       // name has no dot, or begins with the only one (".bashrc").
       else if str_eq name "extname" then
         (match args with Cons (VStr ph, _) -> mkstr (extname_of (basename_of (sget ph))) | _ -> mkstr "")
       else if str_eq name "directory?" then
         (match args with
          | Cons (VStr ph, _) -> VBool (run ("test -d " ++ shq (sget ph) ++ " 2> /dev/null") == 0)
          | _ -> VBool false)
       // File.symlink(old, new): symlink(2), which answers 0 or -1.
       // ⚠ there is no errno reader here, so the failure is classified by
       //   asking the filesystem the one question that distinguishes the
       //   common two: a link path that already exists is EEXIST, anything
       //   else is reported as ENOENT. A third cause (EACCES, say) is
       //   therefore named wrongly -- said here rather than left to be
       //   discovered.
       else if str_eq name "symlink" then
         (match args with
          | Cons (VStr a9, Cons (VStr b9, _)) ->
            (let src = sget a9 in let dst = sget b9 in
             if symlink src dst == 0 then VInt 0
             else if file_exists dst then
               raise_exc world "Errno::EEXIST" ("File exists @ sys_fail2 - (" ++ src ++ ", " ++ dst ++ ")")
             else
               raise_exc world "Errno::ENOENT" ("No such file or directory @ sys_fail2 - (" ++ src ++ ", " ++ dst ++ ")"))
          | _ -> VInt 0)
       // File.symlink?: the shell's test, as directory? above (bundler asks it
       // of every load path entry while resolving a Gemfile).
       else if str_eq name "symlink?" then
         (match args with
          | Cons (VStr ph, _) -> VBool (run ("test -L " ++ shq (sget ph) ++ " 2> /dev/null") == 0)
          | _ -> VBool false)
       // File.writable? / readable? / executable?: the shell's own tests, as
       // directory? above. There is no stat here, so these three are the whole
       // of it -- world_writable?, which answers with permission bits, is
       // absent rather than approximated.
       else if str_eq name "writable?" || str_eq name "readable?" || str_eq name "executable?" then
         (match args with
          | Cons (VStr ph, _) ->
            (let flag = (if str_eq name "writable?" then "-w" else if str_eq name "readable?" then "-r" else "-x") in
             VBool (run ("test " ++ flag ++ " " ++ shq (sget ph) ++ " 2> /dev/null") == 0))
          | _ -> VBool false)
       else if str_eq name "size" then
         (match args with Cons (VStr ph, _) -> VInt (str_len (if file_exists (sget ph) then read_file (sget ph) else "")) | _ -> VInt 0)
       else if str_eq name "size?" then
         (match args with
          | Cons (VStr ph, _) ->
            (let n = str_len (if file_exists (sget ph) then read_file (sget ph) else "") in
             if n > 0 then VInt n else VNil)
          | _ -> VNil)
       else if str_eq name "readlines" then
         (match args with
          | Cons (VStr ph, _) ->
            (let c = (if file_exists (sget ph) then read_file (sget ph) else "") in
             arr_new (val_list_of_strs (str_lines_go c 0 0 (str_len c))))
          | _ -> arr_new Nil)
       else if str_eq name "absolute_path" then
         (match args with
          | Cons (VStr ph, rest) ->
            (let p1 = sget ph in
             if str_len p1 > 0 && str_eq (char_at p1 0) "/" then mkstr p1
             else mkstr ((match rest with Cons (VStr b, _) -> sget b | _ -> env_get "PWD") ++ "/" ++ p1))
          | _ -> mkstr "")
       else if str_eq name "join" then mkstr (file_join_go args "")
       else if str_eq name "expand_path" then
         // File.expand_path(path[, base]): a relative path resolves against
         // base when given (that is how a library says "next to this file",
         // File.expand_path("x", __dir__)), and against the CWD otherwise.
         // "~" is the home directory, and "." / ".." segments are resolved.
         (match args with
          | Cons (VStr ph, rest) ->
            (let path = tilde_expand (sget ph) in
             if str_len path > 0 && str_eq (char_at path 0) "/" then mkstr (path_norm path)
             else
               let base = (match rest with
                           | Cons (VStr b, _) -> let b = tilde_expand (sget b) in
                             (if str_len b > 0 && str_eq (char_at b 0) "/" then b
                              else env_get "PWD" ++ "/" ++ b)
                           | _ -> env_get "PWD") in
               mkstr (path_norm (base ++ "/" ++ path)))
          | _ -> mkstr "")
       else if str_eq name "delete" || str_eq name "unlink" then
         (match args with
          | Cons (VStr ph, _) -> (let _ = run ("rm -f " ++ shq (sget ph)) in VInt 1)
          | _ -> VInt 0)
       else if str_eq name "new" || str_eq name "open" then file_open_obj world args
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for File"))
    // Dir class methods (pwd via env, mkdir via the shell).
    // Warning[:category] — the warning-category switches. mere-ruby emits no
    // categorised warnings, so every category reads false and a write is
    // accepted and remembered (`Warning[:deprecated] = true` is a common
    // opening line in a test suite).
    else if str_eq c "Warning" && (str_eq name "[]" || str_eq name "[]=") then
      (match args with
       | Cons (VSym k, rest) ->
         (if str_eq name "[]=" then
            (match rest with
             | Cons (v, _) -> let _ = map_set warn_cats k v in v
             | _ -> VNil)
          else if map_has warn_cats k then map_get warn_cats k else VBool false)
       | _ -> VBool false)
    else if str_eq c "Dir" then
      (if str_eq name "pwd" || str_eq name "getwd" then mkstr (env_get "PWD")
       // Dir.chdir(path) with no block: move and stay. The block form is in
       // invoke_with_block, and both go through dir_chdir_to.
       else if str_eq name "chdir" then
         (let tgt = (match args with Cons (VStr ph, _) -> sget ph | _ -> env_get "HOME") in
          if dir_chdir_to tgt == 0 then VInt 0
          else raise_exc world "Errno::ENOENT" ("No such file or directory @ dir_chdir - " ++ tgt))
       else if str_eq name "mkdir" then
         (match args with
          | Cons (VStr ph, _) -> (let _ = run ("mkdir -p " ++ shq (sget ph)) in VInt 0)
          | _ -> VInt 0)
       // ⚠ Dir.rmdir was MISSING while Dir.mkdir was here, and the pair is
       // what a temp directory needs. mspec's own `rm_r` walks a tree and ends
       // at `Dir.rmdir`, so the spec harness -- which clears a per-PID temp
       // directory before it runs -- died with NoMethodError whenever a pid
       // came round again onto a leftover one. It read as a CRASH in whichever
       // spec file drew that pid, which is how a harness gap looks like an
       // interpreter one. Empty directories only, as in ruby: a non-empty one
       // is Errno::ENOTEMPTY and a missing one Errno::ENOENT.
       else if str_eq name "rmdir" || str_eq name "delete" || str_eq name "unlink" then
         (match args with
          | Cons (VStr ph, _) ->
            (let p9 = sget ph in
             if (if file_exists p9 then false else true) then
               raise_exc world "Errno::ENOENT" ("No such file or directory @ dir_s_rmdir - " ++ p9)
             else if run ("rmdir " ++ shq p9 ++ " 2>/dev/null") == 0 then VInt 0
             else raise_exc world "Errno::ENOTEMPTY" ("Directory not empty @ dir_s_rmdir - " ++ p9))
          | _ -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
       else if str_eq name "exist?" || str_eq name "exists?" then
         (match args with Cons (VStr ph, _) -> VBool (file_exists (sget ph)) | _ -> VBool false)
       // Dir.glob(pat[, base:]) / Dir[pat, ...]: `base:` arrives as a trailing
       // hash. Several patterns union (Dir[] takes varargs, glob an array).
       else if str_eq name "glob" || str_eq name "[]" then
         (let base = (match glob_base_arg args with VStr h -> sget h | _ -> "") in
          let pats = glob_pat_args (glob_drop_opts args) in
          arr_new (val_uniq (glob_all ("p" ++ glob_fnm_flags args) pats base) Nil))
       else if str_eq name "entries" || str_eq name "children" then
         (match args with
          | Cons (VStr ph, _) ->
            // glob_lines keeps find's own "." line as a glob candidate; a
            // directory listing names only what is inside.
            (let kids = glob_drop_dot (glob_lines (glob_find (sget ph) 1) 0) in
             let names = val_sort (glob_strs kids) in
             arr_new (if str_eq name "entries" then Cons (mkstr ".", Cons (mkstr "..", names)) else names))
          | _ -> arr_new Nil)
       else if str_eq name "home" then mkstr (env_get "HOME")
       // Dir.open(path) -> a Dir object (the instance side is Ruby, see the
       // prelude); with a block it yields the object and answers the block.
       else if str_eq name "open" || str_eq name "new" then
         (match args with
          | Cons (VStr ph, _) -> new_obj world "Dir" (Cons (mkstr (sget ph), Nil))
          | _ -> VNil)
       // Dir.mktmpdir / Dir.tmpdir: `tmpdir` is a stdlib file in CRuby; here
       // the one thing it adds is this directory name.
       else if str_eq name "tmpdir" then
         (let t = env_get "TMPDIR" in mkstr (if str_eq t "" then "/tmp" else t))
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for Dir"))
    // Regexp.new / Regexp.compile: build from a source string (options: an
    // int of IGNORECASE|EXTENDED|MULTILINE bits, true = i, or a flags string).
    else if str_eq c "Regexp" && (str_eq name "new" || str_eq name "compile") then
      (match args with
       | Cons (VStr src, rest) ->
         (let body = sget src in
          let fl = (match rest with
                    | Cons (VBool true, _) -> "i"
                    | Cons (VInt opt, _) ->
                      (if opt - (opt / 2) * 2 == 1 then "i" else "") ++
                      (if (opt / 2) - (opt / 4) * 2 == 1 then "x" else "") ++
                      (if (opt / 4) - (opt / 8) * 2 == 1 then "m" else "") ++
                      // ...and NOENCODING (32), the `n` flag: it was dropped,
                      // so `Regexp.new(s, Regexp::NOENCODING)` answered a
                      // pattern with no flags and #options said 0.
                      (if (opt / 32) - (opt / 64) * 2 == 1 then "n" else "") ++
                      // ...and FIXEDENCODING (16), the `u` flag, dropped the
                      // same way: `Regexp.new(s, Regexp::FIXEDENCODING)`
                      // answered #fixed_encoding? false for the option that
                      // exists to make it true.
                      (if (opt / 16) - (opt / 32) * 2 == 1 then "u" else "")
                    | Cons (VStr fs, _) -> sget fs
                    | _ -> "") in
          // FIXEDENCODING means "this source string's encoding", so it is kept
          // whether or not the text would contribute one on its own:
          // `Regexp.new("a".encode("ISO-8859-1"), Regexp::FIXEDENCODING)` is an
          // ISO-8859-1 pattern even though every byte in it is ASCII.
          let renc9 = (if str_contains fl "u" then enc_canon_name (senc_get src) else rx_one_enc (VStr src)) in
          if rx_validate body fl then rx_build_once body fl renc9 args
          else raise_exc world "RegexpError" ("invalid regular expression: /" ++ body ++ "/"))
       | Cons (VRegex (b2, f2, e2), _) -> VRegex (b2, f2, e2)
       | Cons (other9, _) -> raise_exc world "TypeError" ("no implicit conversion of " ++ class_name other9 ++ " into String")
       | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1..3)")
    // Regexp.last_match / .last_match(n): the same MatchData `$~` holds, which
    // is how a `method =~ /re/` test reads its capture afterwards.
    else if str_eq c "Regexp" && str_eq name "last_match" then
      (let md = (if map_has globals "~" then map_get globals "~" else VNil) in
       match args with
       | Cons (ix, rest9) ->
         (match rest9 with
          | Cons (_, _) -> raise_exc world "ArgumentError"
                             ("wrong number of arguments (given " ++ str_of_int (vlen args) ++ ", expected 0..1)")
          | Nil -> (match md with VNil -> VNil | _ -> invoke_val_c env world blk md "[]" (Cons (ix, Nil)) false))
       | Nil -> md)
    else if str_eq c "Regexp" && (str_eq name "escape" || str_eq name "quote") then
      (match args with
       | Cons (VStr s, _) ->
         (let e9 = rx_escape (sget s) in
          let v9 = mkstr e9 in
          // an ASCII-only quote is US-ASCII; otherwise the result keeps the
          // ARGUMENT's encoding, which is the whole point of quoting bytes --
          // a BINARY string came back tagged UTF-8 and stopped being usable
          // against the string it was quoted from.
          (match v9 with
           | VStr id9 ->
             (let _ = senc_set id9 (if str_ascii_only e9 0 then "US-ASCII" else senc_get s) in v9)
           | _ -> v9))
       | Cons (VSym s, _) -> mkstr (rx_escape s)
       | Cons (v, _) -> mkstr (rx_escape (to_s v))
       | _ -> mkstr "")
    // Regexp.try_convert: the argument if it IS one, and otherwise whatever
    // #to_regexp answers -- the protocol the method exists FOR. Nothing in the
    // core answers #to_regexp, which is why this went unnoticed: it is a door
    // for a program's own classes, and it was nailed shut.
    else if str_eq c "Regexp" && str_eq name "try_convert" then
      (match args with
       | Cons (VRegex (a9, b9, e9), _) -> VRegex (a9, b9, e9)
       | Cons (VObj _, _) ->
         (match args with
          | Cons (o9, _) ->
            (if responds world o9 "to_regexp"
             then (match invoke_val_c env world blk o9 "to_regexp" Nil false with
                   | VRegex (a9, b9, e9) -> VRegex (a9, b9, e9)
                   | VNil -> VNil
                   | bad9 ->
                     (let cn9 = display_cls_msg world (dispatch_cls_of world o9) in
                      raise_exc world "TypeError"
                        ("can't convert " ++ cn9 ++ " to Regexp ("
                         ++ cn9 ++ "#to_regexp gives " ++ class_name bad9 ++ ")")))
             else VNil)
          | Nil -> VNil)
       | _ -> VNil)
    // Regexp.timeout: a global this engine does not enforce. nil is the honest
    // answer (ruby's default), and the writer keeps what it was told so the
    // reader does not contradict it.
    else if str_eq c "Regexp" && str_eq name "timeout" then
      (if map_has rx_cur "timeout" then map_get rx_cur "timeout" else VNil)
    else if str_eq c "Regexp" && str_eq name "timeout=" then
      (match args with
       | Cons (v9, _) -> (let _ = map_set rx_cur "timeout" v9 in v9)
       | Nil -> VNil)
    // Regexp.linear_time?: whether the pattern can be matched without
    // backtracking. This engine backtracks, so the answer is about the
    // PATTERN: a backreference or a lookaround is what makes one non-linear.
    else if str_eq c "Regexp" && str_eq name "linear_time?" then
      (let src9 = (match args with
                   | Cons (VRegex (sp9, _, _), _) -> sp9
                   | Cons (VStr sh9, _) -> sget sh9
                   | _ -> "") in
       // a lookaround IS linear (ruby answers true for one); a backreference
       // is what makes a match need to remember and go back.
       VBool (if str_contains src9 "\\1" || str_contains src9 "\\2" || str_contains src9 "\\3"
                 || str_contains src9 "\\4" || str_contains src9 "\\5" || str_contains src9 "\\k<"
              then false else true))
    else if str_eq c "Regexp" && str_eq name "union" then
      // one array argument or a varargs list; no alternatives at all is the
      // never-matching pattern.
      (let alts0 = (match args with Cons (VArr id, Nil) -> deref id | _ -> args) in
       let alts = rx_union_conv env world (match alts0 with Cons (_, Nil) -> true | _ -> false) alts0 in
       match alts with
       | Nil -> VRegex ("(?!)", "", "")
       // ⚠ ONE alternative is not a union of one: ruby hands the pattern back
       // as it stands, keeping its flags -- `Regexp.union(/x/i).inspect` is
       // "/x/i" -- rather than wrapping it. Wrapping gave "(?-mix:x)" as the
       // source and dropped `i` into the group header, so #source, #options
       // and #== all read differently from the pattern that went in.
       // (only a REGEXP argument: a single STRING already comes out unwrapped
       // from rx_union_go, and it still has to go through the general path so
       // the encoding it contributes is recorded.)
       | Cons (VRegex (p9, f9, e9), Nil) -> VRegex (p9, f9, e9)
       // a BINARY argument makes the union a byte pattern: ruby answers
       // ASCII-8BIT for `Regexp.union("\xff".b)`, and this answered UTF-8 --
       // the union of bytes claiming to be characters. `n` is how a pattern
       // says "bytes" here, so the flag carries the fact.
       | _ ->
         (match rx_union_scan alts false "" "" with
          | (inc9, fix9, err9) ->
            if (if str_eq err9 "" then false else true) then raise_exc world "ArgumentError" err9
            else
              (let usrc = rx_union_go alts "" true in
               // ...and with nothing contradicted, the encoding the union
               // CARRIES: the ASCII-incompatible one if there was one, else the
               // fixed one, else none at all. The joined SOURCE decides the last
               // step, the way rb_enc_associate + Regexp.new do: an all-ASCII
               // source in an ascii-compatible encoding comes back US-ASCII.
               let renc9 = (if str_eq inc9 "" then (if str_eq fix9 "" then "ASCII-8BIT" else fix9) else inc9) in
               // ⚠ "does the SOURCE have non-ASCII" is the regexp question, not the
               // byte question: `[\x80-\xBF]` is ASCII bytes spelling a
               // non-ASCII character, and reading its bytes said US-ASCII for a
               // union that ruby answers ASCII-8BIT for.
               let final9 = (if enc_ascii_compat renc9 && (if rx_src_nonascii usrc 0 then false else true)
                             then "US-ASCII" else renc9) in
               let ufl = (if str_eq final9 "ASCII-8BIT" then "n" else "") in
               VRegex (usrc, ufl, final9))))
    // Math module functions (only sqrt-derived ones; no trig/log builtin).
    // ...only for the functions Math actually has; anything else (Module's own
    // methods, `class`, `name`, ...) falls through to the general dispatcher.
    else if str_eq c "Math" && (if is_module_method name then false else true)
            && (if is_prim_method name then false else true) then
      (if str_eq name "sqrt" then (match args with Cons (v, _) -> VFlt (sqrt (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "hypot" then (match args with Cons (a, Cons (b, _)) -> VFlt (hypot (to_f a) (to_f b)) | _ -> VFlt 0.0)
       else if str_eq name "sin" then (match args with Cons (v, _) -> VFlt (sin (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "cos" then (match args with Cons (v, _) -> VFlt (cos (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "tan" then (match args with Cons (v, _) -> VFlt (tan (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "atan2" then (match args with Cons (a, Cons (b, _)) -> VFlt (atan2 (to_f a) (to_f b)) | _ -> VFlt 0.0)
       // The rest of Math from the primitives Mere has (sqrt / sin / cos / tan
       // / exp / log / atan2). Each identity below is exact in real arithmetic
       // and was kept only after its whole spread matched ruby's libm byte for
       // byte (bench: corpus/168). The ones that did not are absent rather
       // than approximated -- log2 and log10 through `log x / log b` answer
       // 2.9999999999999996 for an exact power, and a wrong answer wearing the
       // right shape is worse than a missing name.
       // one-argument libm, by name. Kept in the order ruby's Math lists them.
       else if str_eq name "exp" then (match args with Cons (v, _) -> VFlt (exp (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "atan" then (match args with Cons (v, _) -> VFlt (atan (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "asin" then (match args with Cons (v, _) -> VFlt (asin (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "acos" then (match args with Cons (v, _) -> VFlt (acos (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "sinh" then (match args with Cons (v, _) -> VFlt (sinh (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "cosh" then (match args with Cons (v, _) -> VFlt (cosh (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "tanh" then (match args with Cons (v, _) -> VFlt (tanh (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "asinh" then (match args with Cons (v, _) -> VFlt (asinh (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "acosh" then (match args with Cons (v, _) -> VFlt (acosh (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "atanh" then (match args with Cons (v, _) -> VFlt (atanh (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "cbrt" then (match args with Cons (v, _) -> VFlt (cbrt (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "log2" then (match args with Cons (v, _) -> VFlt (log2 (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "log10" then (match args with Cons (v, _) -> VFlt (log10 (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "log1p" then (match args with Cons (v, _) -> VFlt (log1p (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "expm1" then (match args with Cons (v, _) -> VFlt (expm1 (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "erf" then (match args with Cons (v, _) -> VFlt (erf (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "erfc" then (match args with Cons (v, _) -> VFlt (erfc (to_f v)) | _ -> VFlt 0.0)
       else if str_eq name "gamma" then (match args with Cons (v, _) -> VFlt (tgamma (to_f v)) | _ -> VFlt 0.0)
       // Math.lgamma answers the pair [log|gamma(x)|, sign of gamma(x)]
       else if str_eq name "lgamma" then
         (match args with
          | Cons (v, _) ->
            (let x = to_f v in
             arr_new (Cons (VFlt (lgamma x), Cons (VInt (if tgamma x < 0.0 then 0 - 1 else 1), Nil))))
          | _ -> VNil)
       // Math.log(x) / Math.log(x, base) -- ruby divides for the second form too
       else if str_eq name "log" then
         (match args with
          // base 10 and base 2 go through log10 / log2: `log x / log 10`
          // answers 2.9999999999999996 for an exact power and ruby 3.4 does
          // not. (3.2 did -- one of the changes the newer reference brought.)
          | Cons (v, Cons (b, _)) ->
            (let bf = to_f b in
             if bf == 10.0 then VFlt (log10 (to_f v))
             else if bf == 2.0 then VFlt (log2 (to_f v))
             else VFlt (log (to_f v) / log bf))
          | Cons (v, _) -> VFlt (log (to_f v))
          | _ -> VFlt 0.0)
       // x = fraction * 2**exponent with 0.5 <= |fraction| < 1, and its inverse.
       // frexp is the one that stays in Mere: its answer is a pair, which an
       // out-parameter cannot come back through, and the halving loop is exact.
       else if str_eq name "frexp" then
         (match args with
          | Cons (v, _) ->
            (let x = to_f v in
             if x == 0.0 then arr_new (Cons (VFlt 0.0, Cons (VInt 0, Nil)))
             else
               let neg = x < 0.0 in
               let a0 = (if neg then 0.0 - x else x) in
               let rec up = fn (f: float) -> fn (e: int) -> if f >= 1.0 then up (f / 2.0) (e + 1) else (f, e) in
               let rec dn = fn (f: float) -> fn (e: int) -> if f < 0.5 then dn (f * 2.0) (e - 1) else (f, e) in
               let (f1, e1) = up a0 0 in
               let (f2, e2) = dn f1 e1 in
               arr_new (Cons (VFlt (if neg then 0.0 - f2 else f2), Cons (VInt e2, Nil))))
          | _ -> VNil)
       else if str_eq name "ldexp" then
         (match args with Cons (a, Cons (b, _)) -> VFlt (ldexp (to_f a) (int_of_float (to_f b))) | _ -> VFlt 0.0)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for Math"))
    // Integer.sqrt(n): the integer square root (floor of the real sqrt).
    // Integer.try_convert(obj): the object when it IS an Integer, its #to_int
    // when it has one, and nil otherwise -- never a raise, which is the whole
    // difference from Integer().
    else if str_eq c "Integer" && str_eq name "try_convert" then
      (match args with
       | Cons (VInt n9, _) -> VInt n9
       | Cons (VBig b9, _) -> VBig b9
       // ...and what #to_int ANSWERS has to be an Integer (or nil). Handing the
       // answer straight back made `Integer.try_convert(obj)` return a String
       // from a method that promises an Integer -- a conversion that did not
       // convert, and nothing downstream had reason to doubt it.
       | Cons (o9, _) -> (if responds world o9 "to_int"
                          then (match invoke_val_c env world blk o9 "to_int" Nil false with
                                | VInt n9 -> VInt n9
                                | VBig b9 -> VBig b9
                                | VNil -> VNil
                                | bad9 ->
                                  // the receiver's own class name, not the
                                  // value-level one: class_name cannot see a
                                  // user class and called every object "Object"
                                  (let cn9 = display_cls_msg world (dispatch_cls_of world o9) in
                                   raise_exc world "TypeError"
                                     ("can't convert " ++ cn9 ++ " to Integer ("
                                      ++ cn9 ++ "#to_int gives " ++ class_name bad9 ++ ")")))
                          else VNil)
       | _ -> VNil)
    // Integer.sqrt is an INTEGER square root: `sqrt(to_f v)` loses everything
    // past a double, so a bignum argument saturated at 2**63-1 instead of
    // answering. A negative is a DomainError and a non-number a TypeError --
    // both of which came out as an answer or as an internal failure.
    else if str_eq c "Integer" && str_eq name "sqrt" then
      (match args with
       | Cons (VInt n9, _) ->
         (if n9 < 0 then raise_exc world "Math::DomainError"
                           "Numerical argument is out of domain - \"isqrt\""
          else VInt (int_of_float (sqrt (float_of_int n9))))
       | Cons (VBig b9, _) ->
         (if big_sign b9 < 0 then raise_exc world "Math::DomainError"
                                    "Numerical argument is out of domain - \"isqrt\""
          else norm_big (big_isqrt_s (big_mag b9) ()))
       | Cons (VFlt f9, _) ->
         (if f9 < 0.0 then raise_exc world "Math::DomainError"
                             "Numerical argument is out of domain - \"isqrt\""
          else VInt (int_of_float (sqrt f9)))
       | Cons (o9, _) ->
         raise_exc world "TypeError"
           ("no implicit conversion of " ++ class_name o9 ++ " into Integer")
       | _ -> VInt 0)
    // Random: a source of numbers, not state — `Random.new` answers the module
    // itself so `Random.new.rand(n)` reads the same generator.
    // ⚠ Random.new must build an INSTANCE with its own generator. It used to
    // answer the class itself, so `Random.new(42)` shared Kernel#rand's stream
    // and the seed went nowhere: three runs, three sequences.
    else if str_eq c "Random" && str_eq name "new" then
      (let sd9 = (match args with
                  | Cons (VInt k9, _) -> k9
                  | Cons (VFlt f9, _) -> int_of_float f9
                  | Cons (VBig b9, _) -> bit_and (int_of_str (big_mag b9)) mt_mask32
                  | _ -> random_int 1000000000) in
       let g9 = mt_alloc_gid () in
       let _ = mt_init_genrand g9 sd9 in
       let _ = map_set mt_seed_of (str_of_int g9) (str_of_int sd9) in
       let ob9 = new_obj world "Random" Nil in
       (match ob9 with
        | VObj oid9 ->
          (let (_, _, _, iv9) = world in
           let _ = map_set iv9 (str_of_int oid9 ++ "@__gid") (VInt g9) in
           let _ = map_set iv9 (str_of_int oid9 ++ "@__seed") (VInt sd9) in ob9)
        | _ -> ob9))
    else if str_eq c "Random" && str_eq name "new_seed" then VInt (random_int 1000000000)
    else if str_eq c "Random" && (str_eq name "rand" || str_eq name "srand" || str_eq name "bytes") then
      (if str_eq name "srand" then srand_val env world args
       else rand_val world (coerce_int_args env world args))
    // `SystemCallError.new(msg, errno)` is an instance of THAT errno's class:
    // the number picks it, and a number nothing claims stays a SystemCallError.
    // ⚠ A SINGLE Integer argument is the ERRNO, not a message: ruby answers
    // `SystemCallError.new(2)` as an Errno::ENOENT whose #errno is 2. Only the
    // two-argument form was recognised, so the one-argument form built a plain
    // SystemCallError with the number as its message and #errno nil -- a
    // conversion of the argument into the wrong role.
    else if str_eq name "new" && str_eq c "SystemCallError"
            && (match args with Cons (VInt _, Nil) -> true | _ -> false) then
      (let n9 = (match args with Cons (VInt k, _) -> k | _ -> 0) in
       let _ = errno_build () in
       let c9 = (if map_has errno_by_num (str_of_int n9)
                 then "Errno::" ++ map_get errno_by_num (str_of_int n9) else "SystemCallError") in
       new_obj world c9 (Cons (VNil, Cons (VInt n9, Nil))))
    // ...and an errno that converts to nothing is refused BY NAME. Only nil is
    // allowed to be "no number given"; a String in that position is not the
    // location (that is the THIRD argument for this class), and it used to be
    // read as one -- "unknown error @ bar - foo" for a call ruby refuses.
    else if str_eq name "new" && str_eq c "SystemCallError"
            && (match args with
                | Cons (_, Cons (VNil, _)) -> false
                | Cons (_, Cons (_, _)) -> true
                | _ -> false)
            && (match errno_arg_int env world (match args with Cons (_, r9) -> r9 | Nil -> Nil) with
                | Cons (VInt _, _) -> false
                | _ -> true) then
      (let bad9 = (match args with Cons (_, Cons (v9, _)) -> v9 | _ -> VNil) in
       raise_exc world "TypeError"
         ("no implicit conversion of " ++ display_cls_msg world (dispatch_cls_of world bad9) ++ " into Integer"))
    // ...and the errno converts: ruby reads it through #to_int, so a Float (or
    // anything with #to_int) picks the Errno class the same way an Integer does.
    // Only a literal VInt was recognised, so `SystemCallError.new("foo", 2.0)`
    // stayed a bare SystemCallError with "unknown error".
    else if str_eq name "new" && str_eq c "SystemCallError"
            && (match args with
                | Cons (_, Cons (VFlt _, _)) -> true
                | Cons (_, Cons (VObj _, _)) -> true
                // ...and the numbers that are not Integers but convert: ruby
                // reads the errno through #to_int, and Rational(2,1) and
                // Complex(2,0) both answer it.
                | Cons (_, Cons (VRat (_, _), _)) -> true
                | Cons (_, Cons (VCpx (_, _), _)) -> true
                | _ -> false)
            && (match errno_arg_int env world (match args with Cons (_, r9) -> r9 | Nil -> Nil) with
                | Cons (VInt _, _) -> true
                | _ -> false) then
      (let rest9 = (match args with Cons (_, r9) -> r9 | Nil -> Nil) in
       let n9 = (match errno_arg_int env world rest9 with
                 | Cons (VInt k, _) -> k
                 | _ -> 0) in
       let args9 = (match args with Cons (a9, Cons (_, t9)) -> Cons (a9, Cons (VInt n9, t9)) | _ -> args) in
       let _ = errno_build () in
       let c9 = (if map_has errno_by_num (str_of_int n9) then "Errno::" ++ map_get errno_by_num (str_of_int n9) else "SystemCallError") in
       new_obj world c9 args9)
    else if str_eq name "new" && str_eq c "SystemCallError"
            && (match args with Cons (_, Cons (VInt _, _)) -> true | _ -> false) then
      (let n9 = (match args with Cons (_, Cons (VInt k, _)) -> k | _ -> 0) in
       let _ = errno_build () in
       let c9 = (if map_has errno_by_num (str_of_int n9) then "Errno::" ++ map_get errno_by_num (str_of_int n9) else "SystemCallError") in
       new_obj world c9 args)
    else if str_eq name "new" then new_obj world c args
    // an anonymous class/module has no name (nil) until assigned to a constant,
    // at which point anon_name records the constant name.
    // ...unless the class defines its own `name`, which libraries do often
    // enough that zeitwerk exists to see past it. Same guard ruby2_keywords
    // uses above; the singleton lookup itself is much further down this chain.
    else if str_eq name "name" && (if has_meth world ("(sng:" ++ c ++ ")") name then false else true) then
      (if map_has anon_name c then map_get anon_name c
       else if is_anon_cls c then VNil
       else mkstr c)
    // Class#superclass: the recorded superclass, else Object (BasicObject has
    // none; Object's is BasicObject).
    else if str_eq name "superclass" then
      (let (_, sup0, _, _) = world in
       if str_eq c "BasicObject" then VNil
       // a singleton class's superclass mirrors the class hierarchy one level
       // up (K.singleton_class.superclass == H.singleton_class when K < H).
       else if is_sng_cls c then VClass (sng_supername world c)
       else if map_has sup0 c then VClass (map_get sup0 c)
       else if str_eq c "Object" then VClass "BasicObject"
       // Enumerator's builtin subclasses
       else if str_eq c "Enumerator::ArithmeticSequence" || str_eq c "Enumerator::Lazy" || str_eq c "Enumerator::Chain" then VClass "Enumerator"
       else VClass "Object")
    // Hash.ruby2_keywords_hash?(h): whether h carries the ruby2_keywords flag.
    // mere does not expose that flag on a hash value, so it is never true here
    // (the spec only ever asserts false).
    else if str_eq name "ruby2_keywords_hash?" then VBool false
    else if str_eq name "const_defined?" then
      // look in the receiver's own namespace (C::name); top-level constants
      // live in Object, so Object also consults the bare name.
      (match args with
       | Cons (nv, _) ->
         let n = (match nv with VSym s -> s | VStr s -> sget s | _ -> "") in
         // (an autoload -- Set, Pathname -- is defined before it is loaded)
         VBool (map_has consts (c ++ "::" ++ n) || (str_eq c "Object" && (map_has consts n || map_has autoloads n)))
       | _ -> VBool false)
    // instance_method(:name): an UnboundMethod, represented as an
    // UnboundMethod-classed object carrying the origin class (where the method
    // resolves from `c`) and the method name.
    // Module#include?(mod): is that module in this class's ancestors (and not
    // the class itself)? The name is also Array#include?, whose branch would
    // otherwise swallow a class receiver.
    else if str_eq name "include?" && (match args with Cons (VClass _, _) -> true | _ -> false) then
      (match args with
       | Cons (VClass m, _) ->
         VBool ((if str_eq m c then false else true) && str_list_has (ancestors_of world c) m)
       | _ -> VBool false)
    else if str_eq name "instance_method" then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let mname = (match args with Cons (VSym s, _) -> s | Cons (VStr h, _) -> sget h | _ -> "") in
       let origin = (let a = lookup_anc world (ancestors_of world c) mname in
                     if str_eq a "" && map_has meths0 (c ++ "#" ++ mname) then c else a) in
       // a builtin method has no entry in the user method table, but it is
       // still a method of the class and reflection must see it.
       let origin = if str_eq origin "" && builtin_has_meth c mname then c else origin in
       // an OPERATOR on a builtin is dispatched by eval_bin_prim rather than
       // being an entry anywhere, so the per-class name lists do not mention
       // it -- `1.method(:+)` already had this fallback and
       // `Float.instance_method(:===)` did not, which is the same fact asked
       // through two doors.
       // ⚠ ...and it is that class's operators, not every operator. Asking
       // `is_binary_op_name` alone made every builtin class claim all of them:
       // `Float.instance_method(:&)`, `Complex.instance_method(:<)` and
       // `Numeric.instance_method(:*)` all answered methods ruby denies.
       // op_responds already knows the answer per VALUE, and respond_to? has
       // been right all along -- only this door asked the wrong question.
       // ...asked of the class's own operator set. op_responds knows it per
       // VALUE and covers `[]` and `~` as well, which is_binary_op_name does
       // not -- and Numeric has no value to stand in for it, so its own list
       // answers there (ruby's Numeric has `%` and `<=>` and NOT `+ - * / **`;
       // the concrete kinds define those).
       // A class WITH a stand-in value is asked through it -- op_responds is
       // per value, covers `[]`, `~` and `!`, and is what respond_to? has been
       // using all along. Only the classes with no such value (Kernel,
       // Comparable) keep the old blanket test, and a USER class still claims
       // no operator at all.
       let origin = if str_eq origin ""
                       && (if str_eq c "Numeric"
                           then is_numeric_own_method mname || cmp_op_name mname || str_eq mname "!"
                           else match builtin_rep_val c with
                                | VMain -> builtin_cls_name c && is_binary_op_name mname
                                | rv9 -> op_responds rv9 mname)
                    then c else origin in
       // ...and a name `alias_method` (or the Method form of define_method)
       // pointed at a builtin is a method of the class too. `Kernel#method`
       // already found it; asked through this door the class said it had no
       // such method.
       let origin = if str_eq origin ""
                       && (if str_eq (blt_alias_lookup world (ancestors_of world c) mname) "" then false else true)
                    then c else origin in
       if str_eq origin "" then raise_exc world "NameError" ("undefined method '" ++ mname ++ "' for class '" ++ c ++ "'")
       else
         (let id = alloc_oid ocls0 in
          let _ = map_set ocls0 id "UnboundMethod" in
          let _ = map_set ivars0 (str_of_int id ++ "@__um_cls") (mkstr origin) in
          // ...and the OWNER separately, because they are not the same class
          // when a subclass only published the method: @__um_cls is where the
          // body is (what #arity and #bind need) and this is what #owner
          // answers. See owner_anc / body_cls_of.
          let own9 = (let a9 = owner_anc world (ancestors_of world c) mname in
                      if str_eq a9 "" then origin else a9) in
          let _ = map_set ivars0 (str_of_int id ++ "@__um_owner") (mkstr own9) in
          let _ = map_set ivars0 (str_of_int id ++ "@__um_name") (mkstr mname) in
          VObj id))
    // define_method(:name, unbound_or_proc): the non-block form. An
    // UnboundMethod transplants its body into `c` (super then resolves in c's
    // own ancestor chain); a Proc/lambda installs its body as the method.
    // `include <module value>` — the runtime form, for when the module is the
    // result of an expression rather than a constant path.
    else if str_eq name "include" && (match args with Cons (VClass _, _) -> true | _ -> false) then
      (let _ = incl_each world c args in recv)
    // Module#prepend(M): like include, but M goes in FRONT of the class.
    else if str_eq name "prepend" && (match args with Cons (VClass _, _) -> true | _ -> false) then
      (let _ = prep_each world c args in recv)
    // `private(*names)` and friends as a genuine call. The statement parser
    // handles the bare and `:sym`-list forms; this is the parenthesised one,
    // whose argument list is only known once it has been evaluated.
    else if str_eq name "private" || str_eq name "public" || str_eq name "protected" ||
            str_eq name "module_function" || str_eq name "private_class_method" then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let names = vis_arg_names args in
       let _ = (match names with
                | Nil -> ()
                | _ -> if str_eq name "module_function" then modfunc_promote world c names
                       else if str_eq name "private_class_method" then mark_vis_mode meths0 ("(sng:" ++ c ++ ")") names "private"
                       else mark_vis_mode meths0 c names name) in
       // Ruby returns the argument, or the list of them when given several.
       match args with Nil -> VNil | Cons (a, Nil) -> a | _ -> arr_new args)
    // define_singleton_method(:name, method_or_unbound_method) on a class: the
    // same copy as define_method's two-argument form below, landing in the
    // class's singleton namespace. (The block form is in the with-block
    // dispatcher; without this arm the two-argument form was NoMethodError.)
    else if str_eq name "define_singleton_method" && (match args with Cons (_, Cons (_, _)) -> true | _ -> false) then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr h, _) -> sget h | _ -> "") in
       let src = (match args with Cons (_, Cons (s, _)) -> s | _ -> VNil) in
       let target = "(sng:" ++ c ++ ")" in
       (match src with
        | VObj uid ->
          (let ocl9 = map_get ocls0 uid in
           let (scls, snm) =
             (if str_eq ocl9 "UnboundMethod" then
                ((match map_get ivars0 (str_of_int uid ++ "@__um_cls") with VStr h -> sget h | _ -> ""),
                 (match map_get ivars0 (str_of_int uid ++ "@__um_name") with VStr h -> sget h | _ -> ""))
              else if str_eq ocl9 "Method" then
                (let mo = (match map_get ivars0 (str_of_int uid ++ "@__m_owner") with VStr h -> sget h | _ -> "") in
                 let mn = (match map_get ivars0 (str_of_int uid ++ "@__m_name") with VStr h -> sget h | _ -> "") in
                 let mo = (if str_eq mo "" then (match map_get ivars0 (str_of_int uid ++ "@__m_recv") with r9 -> class_name r9) else mo) in
                 (mo, mn))
              else ("", "")) in
           if str_eq snm "" then raise_exc world "TypeError" ("wrong argument type " ++ ocl9 ++ " (expected Proc/Method/UnboundMethod)")
           else
             (let sk = scls ++ "#" ++ snm in
              // a builtin source (`method(:constants)`) has no Meth body: it is
              // installed as an alias the dispatcher resolves to the builtin
              let _ = if map_has meths0 sk then set_meth meths0 (target ++ "#" ++ nm) (map_get meths0 sk)
                      else map_set builtin_alias (target ++ "#" ++ nm) snm in
              let _ = copy_meth_src (target ++ "#" ++ nm) sk in
              let _ = if map_has meth_cref sk then map_set meth_cref (target ++ "#" ++ nm) (map_get meth_cref sk) else () in
              VSym nm))
        | VProc pid -> (let _ = dm_store_closure (target ++ "#" ++ nm) (proc_as_block pid) in
                       let (h2, ps2, bb2, e2) = proc_as_block pid in
                       let _ = set_meth meths0 (target ++ "#" ++ nm)
                                 (Meth (drop_yblk_params ps2, block_defaults bb2, drop_defaults_prologue bb2)) in
                       let _ = map_set dm_methods (target ++ "#" ++ nm) VNil in
                       VSym nm)
        | other -> raise_exc world "TypeError" ("wrong argument type " ++ class_name other ++ " (expected Proc/Method/UnboundMethod)")))
    else if str_eq name "define_method" && (match args with Cons (_, Cons (_, _)) -> true | _ -> false) then
      (let (meths0, sup0, ocls0, ivars0) = world in
       let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr h, _) -> sget h | _ -> "") in
       let src = (match args with Cons (_, Cons (s, _)) -> s | _ -> VNil) in
       (match src with
        | VObj uid ->
          // an UnboundMethod and a bound Method name the same thing here -- a
          // method that already exists somewhere else -- and only the pair of
          // ivars they store it in differs. Handling one and not the other
          // made `define_method :g, obj.method(:f)` silently define nothing.
          (let ocl9 = map_get ocls0 uid in
           let (scls, snm) =
             (if str_eq ocl9 "UnboundMethod" then
                ((match map_get ivars0 (str_of_int uid ++ "@__um_cls") with VStr h -> sget h | _ -> ""),
                 (match map_get ivars0 (str_of_int uid ++ "@__um_name") with VStr h -> sget h | _ -> ""))
              else if str_eq ocl9 "Method" then
                (let mo = (match map_get ivars0 (str_of_int uid ++ "@__m_owner") with VStr h -> sget h | _ -> "") in
                 let mn = (match map_get ivars0 (str_of_int uid ++ "@__m_name") with VStr h -> sget h | _ -> "") in
                 // #owner is "" for a builtin; the receiver's class is then the
                 // only place the definition could have come from.
                 let mo = (if str_eq mo "" then (match map_get ivars0 (str_of_int uid ++ "@__m_recv") with r9 -> class_name r9) else mo) in
                 (mo, mn))
              else ("", "")) in
           if str_eq snm "" then VSym nm
           // ruby REFUSES a method that does not belong here: the class being
           // defined on must be the owner or a subclass of it, or the body's
           // `self` would be an object the method was never written for. Making
           // the Method form work without this check would have widened a
           // silent no-op into a silently WRONG method -- being wrong in the
           // permissive direction is the worse of the two.
           // ...and it is only a question when the owner is a CLASS. A MODULE's
           // UnboundMethod binds to anything -- ruby has allowed that since 3.0,
           // and `class BasicA < BasicObject; define_method(:respond_to?,
           // ::Kernel.instance_method(:respond_to?)); end` (ruby/spec's own
           // fixture) depends on it: BasicObject's chain has no Kernel in it.
           // Asking "is the target below the owner" of a module refused 86 files
           // in one group -- a new check taking out input that used to work.
           else if (if str_eq scls "" then false
                    else if map_has modules scls then false
                    else if str_eq scls c then false
                    else (if str_list_has (ancestors_of world c) scls then false else true))
           then raise_exc world "TypeError" ("bind argument must be a subclass of " ++ scls)
           else
             (let sk = scls ++ "#" ++ snm in
              // a BUILTIN source has no AST body to copy: it is recorded as a
              // delegation, the way `alias_method` records one. Without this the
              // call defined nothing at all --
              // `define_method(:my_inspect, ::Kernel.instance_method(:inspect))`
              // left a name that raised NameError.
              let _ = (if map_has meths0 sk then () else set_builtin_alias world c nm snm) in
              // ...and the name it came FROM, which is what #original_name
              // answers. alias_method records this pair already; the Method form
              // of define_method is the same fact arriving through another door.
              let _ = (if str_eq nm snm then () else map_set alias_srcname (c ++ "#" ++ nm) snm) in
              let _ = if map_has meths0 sk then set_meth meths0 (c ++ "#" ++ nm) (map_get meths0 sk) else () in
              // the copy also carries WHERE the method was written and the
              // scope it was written in -- both are properties of the original
              // definition, not of the define_method call that re-installs it.
              let _ = copy_meth_src (c ++ "#" ++ nm) sk in
              let _ = if map_has meth_cref sk then map_set meth_cref (c ++ "#" ++ nm) (map_get meth_cref sk) else () in
              VSym nm))
        | VProc pid ->
          (match proc_as_block pid with (h2, ps2, bb2, e2) ->
             let ps2 = (match ps2 with Cons (m, rest) -> if str_eq m lambda_blk_marker then rest else ps2 | _ -> ps2) in
             let _ = set_meth meths0 (c ++ "#" ++ nm) (Meth (ps2, block_defaults bb2, drop_defaults_prologue bb2)) in
             let _ = map_set dm_methods (c ++ "#" ++ nm) VNil in
             let _ = dm_store_closure (c ++ "#" ++ nm) (h2, ps2, bb2, e2) in
             let _ = stamp_meth_src_proc (c ++ "#" ++ nm) (str_of_int pid) in
             VSym nm)
        | _ -> VSym nm))
    // instance_methods(false): the method names defined directly on this
    // class, as symbols (enumerated from the method table via map_iter). The
    // inherited form (no arg / true) is not distinguished — own methods only.
    else if str_eq name "instance_methods" then
      // no arg / true: inherited methods included (the ancestor walk of
      // collect_methods, privates excluded); false: own methods only.
      (let inherited = (match args with Cons (VBool false, _) -> false | _ -> true) in
       if inherited then
         (let names = map_new () in
          let _ = collect_methods world c names in
          let out = map_new () in
          let _ = map_iter names (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
          arr_new (idx_to_list out 0 (map_len out)))
       else
         (let (meths0, _, _, _) = world in
          let pfx = c ++ "#" in
          let plen = str_len pfx in
          let tmp = map_new () in
          let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
            if str_len k > plen && str_eq (substring k 0 plen) pfx
               && (if str_contains (substring k plen (str_len k)) "#" then false else true)
               // instance_methods is public + protected; private ones are
               // reported only by private_instance_methods (the inherited
               // branch above already filters them via collect_methods).
               && (if map_has privates k then false else true)
            then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
            else ()) in
          arr_new (idx_to_list tmp 0 (map_len tmp))))
    // method_defined? family: resolve the defining ancestor, then check the
    // visibility tables. method_defined? is true for public + protected.
    else if str_eq name "method_defined?" || str_eq name "public_method_defined?" ||
            str_eq name "private_method_defined?" || str_eq name "protected_method_defined?" then
      (let (meths0, _, _, _) = world in
       let nm = (match args with Cons (VSym s2, _) -> s2 | Cons (VStr h2, _) -> sget h2 | _ -> "") in
       let origin = (if map_has meths0 (c ++ "#" ++ nm) then c else lookup_anc world (ancestors_of world c) nm) in
       // a builtin-backed method is still a method of the class (see
       // instance_method above). "Never private" was true for every class but
       // one: KERNEL's are private instance methods, which is what makes
       // `puts` callable with no receiver and `[].puts` a NoMethodError. Two
       // reflection questions have to give the same answer here as
       // private_instance_methods does, or a program can be told both.
       if str_eq origin "" && str_eq c "Kernel" && is_kernel_builtin nm then
         VBool (str_eq name "private_method_defined?")
       else if str_eq origin "" && builtin_has_meth c nm then
         VBool (str_eq name "method_defined?" || str_eq name "public_method_defined?")
       else if str_eq origin "" then VBool false
       else
         // meth_private/meth_protected are the dispatch oracles (they also see
         // the inline `private def` regime, not just the privates table).
         let priv = meth_private world c nm in
         let prot = meth_protected world c nm in
         if str_eq name "method_defined?" then VBool (if priv then false else true)
         else if str_eq name "public_method_defined?" then VBool (if priv || prot then false else true)
         else if str_eq name "private_method_defined?" then VBool priv
         else VBool prot)
    // Module#methods: the class-method names reachable from this class — its
    // own singleton methods plus the ones it inherits. Like Object#methods,
    // the builtins that live in the primitive table are not enumerated.
    else if is_vis_list_name name then
      (if str_eq name "methods" && (match args with Cons (VBool false, _) -> true | Cons (VNil, _) -> true | _ -> false)
       then invoke_val_c env world blk recv "singleton_methods" (Cons (VBool false, Nil)) false
       else
       let names = map_new () in
       let blocked = map_new () in
       let want9 = (if str_eq name "public_methods" then 1
                    else if str_eq name "private_methods" then 2
                    else if str_eq name "protected_methods" then 3 else 0) in
       let recur9 = (match args with Cons (VBool false, _) -> false | Cons (VNil, _) -> false | _ -> true) in
       // a class answers through its METACLASS chain: its class methods.
       let _ = collect_vis world ("(sng:" ++ c ++ ")") names blocked want9 recur9 in
       // A MODULE FUNCTION IS ALSO A PUBLIC SINGLETON METHOD. That is what
       // `module_function` means, and Kernel's are all of them: ruby answers
       // `Kernel.public_methods(false).include?(:abort)` with true, and a
       // dozen ruby/spec files open by asserting exactly that. They live in
       // the primitive dispatcher, so collect_cls_methods cannot see them --
       // enumerated from kernel_builtin_names, the same list the private
       // INSTANCE method side uses, so the two answers cannot disagree.
       let _ = (if str_eq c "Kernel" && (if want9 == 2 then false else (if want9 == 3 then false else true))
                then list_iter_kernel_names (fn (nm: str) -> map_set names nm (VSym nm))
                else ()) in
       let out = map_new () in
       let _ = map_iter names (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
       arr_new (idx_to_list out 0 (map_len out)))
    // singleton_methods(all = true): the class methods, inherited ones
    // included. `singleton_methods(false)` is this class's own only.
    else if str_eq name "singleton_methods" then
      (if (match args with Cons (VBool false, _) -> true | _ -> false) then
         (let (meths0, _, _, _) = world in
          let pfx = "(sng:" ++ c ++ ")#" in
          let plen = str_len pfx in
          let tmp = map_new () in
          let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
            // #singleton_methods lists the public and protected ones; a
            // `private` inside `class << self` keeps its method OUT of both
            // this and `methods(false)`, which routes here.
            if str_len k > plen && str_eq (substring k 0 plen) pfx
               && (if map_has privates k then false else true)
            then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
            else ()) in
          arr_new (idx_to_list tmp 0 (map_len tmp)))
       else
         (let names = map_new () in
          let _ = collect_cls_methods world c names in
          let out = map_new () in
          let _ = map_iter names (fn (k: str) -> fn (v: Val) -> let i = map_len out in map_set out (str_of_int i) v) in
          arr_new (idx_to_list out 0 (map_len out))))
    // private_instance_methods(false) / public_instance_methods(false): the
    // own methods split by the visibility table.
    else if str_eq name "private_instance_methods" || str_eq name "public_instance_methods" then
      (let (meths0, _, _, _) = world in
       let want_priv = str_eq name "private_instance_methods" in
       // Kernel's own methods live in the primitive dispatcher, so the method
       // table cannot see them: the module functions are its PRIVATE instance
       // methods and Object's are its PUBLIC ones. Read from the same lists
       // `public_methods` uses, so the two answers cannot disagree.
       let kern9 = str_eq c "Kernel" in
       let pfx = c ++ "#" in
       let plen = str_len pfx in
       let tmp = map_new () in
       // ⚠ THREE doors add to this list (the method table, the module-function
       //   list, and the call path's own list), and two of them add the same
       //   names -- so `Kernel.private_instance_methods(false)` answered 137
       //   entries of which 69 were distinct. ruby's list has no duplicates,
       //   and a name is one name however many doors know it: push through one
       //   gate that remembers what it has seen.
       let seen9 = map_new () in
       let push9 = fn (nm9: str) ->
         (if map_has seen9 nm9 then ()
          else (let _ = map_set seen9 nm9 1 in
                let m9 = map_len tmp in
                map_set tmp (str_of_int m9) (VSym nm9))) in
       let _ = map_iter meths0 (fn (k: str) -> fn (v: Meth) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
            && (if str_contains (substring k plen (str_len k)) "#" then false else true)
            && (if map_has privates k then want_priv else (if want_priv then false else true))
         then push9 (substring k plen (str_len k))
         else ()) in
       // :initialize is private on every class (inherited from Object) —
       // include it unless this class defines its own entry (the table
       // already decided that case above).
       // ⚠ Complex and Rational have #marshal_dump as a PRIVATE instance
       //   method (not #marshal_load, which ruby does not list): it lives in
       //   the primitive dispatcher, so the loop above cannot see it, and both
       //   classes' marshal_dump_spec asks for it by name.
       let _ = (if want_priv && (str_eq c "Complex" || str_eq c "Rational")
                then push9 "marshal_dump" else ()) in
       let _ = (if want_priv && (if map_has meths0 (pfx ++ "initialize") then false else true)
                          // ...and Kernel is not where :initialize lives: it is
                          // Object's (BasicObject's, in ruby), so Kernel's own
                          // list claimed a name ruby does not put there.
                          && (if kern9 then false else true)
                then push9 "initialize" else ()) in
       let _ = (if kern9 then
                  (let rec add9 = fn (xs: str list) ->
                     (match xs with
                      | Nil -> ()
                      | Cons (h9, t9) -> (let _ = push9 h9 in add9 t9)) in
                   add9 (if want_priv then kernel_builtin_names () else kernel_public_instance_names ()))
                else ()) in
       // KERNEL'S MODULE FUNCTIONS ARE PRIVATE INSTANCE METHODS. That is not a
       // detail: `puts` and `format` are callable with no receiver from
       // anywhere precisely because Kernel makes them private instance methods
       // of Object, and forty-six ruby/spec files open by asserting it
       // (`Kernel.should have_private_instance_method(:format)`, which is
       // `Kernel.private_instance_methods.include?`). They live in the
       // primitive dispatcher rather than the method table, so the loop above
       // cannot see them -- the list is is_kernel_builtin, the same one the
       // call path uses, so the two cannot disagree about what Kernel has.
       let _ = (if want_priv && str_eq c "Kernel"
                then list_iter_kernel_names (fn (nm: str) ->
                       (if map_has meths0 (pfx ++ nm) then () else push9 nm))
                else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    // class variables (@@x) declared directly on this class, as :@@sym.
    else if str_eq name "class_variables" then
      (let pfx = c ++ "@" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter cvars (fn (k: str) -> fn (v: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym ("@@" ++ substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "class_variable_get" then
      (match args with
       | Cons (v, _) -> let nm = cvar_name_checked world (to_s v) in
         (if cvar_overtaken world c nm then raise_exc world "RuntimeError" ("class variable @@" ++ nm ++ " of " ++ c ++ " is overtaken by " ++ c)
          else if cvar_defined_from world c nm then cvar_get_from world c nm
          else raise_exc world "NameError" ("uninitialized class variable @@" ++ nm ++ " in " ++ c))
       | _ -> VNil)
    else if str_eq name "class_variable_set" then
      (match args with
       | Cons (v, Cons (value, _)) -> let nm = cvar_name_checked world (to_s v) in
         let owner0 = cvar_owner world c nm in
         let owner = if str_eq owner0 "" then c else owner0 in
         let _ = map_set cvars (owner ++ "@" ++ nm) value in value
       | _ -> VNil)
    else if str_eq name "class_variable_defined?" then
      (match args with Cons (v, _) -> VBool (map_has cvars (c ++ "@" ++ cvar_name_checked world (to_s v))) | _ -> VBool false)
    else if str_eq name "remove_class_variable" then
      (match args with
       | Cons (v, _) -> let k = c ++ "@" ++ cvar_name_checked world (to_s v) in
         let old = (if map_has cvars k then map_get cvars k else VNil) in
         let _ = if map_has cvars k then map_delete cvars k else () in old
       | _ -> VNil)
    // class-level instance variables (@x on the class object itself), keyed
    // "cls:Name@x" — distinct from an instance's ivars.
    else if str_eq name "instance_variables" then
      (let (_, _, _, ivars0) = world in
       let pfx = "cls:" ++ c ++ "@" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter ivars0 (fn (k: str) -> fn (v: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym ("@" ++ substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "instance_variable_get" then
      (let (_, _, _, ivars0) = world in
       match args with Cons (v, _) -> let k = "cls:" ++ c ++ "@" ++ ivar_name_val env world v in (if map_has ivars0 k then map_get ivars0 k else VNil) | _ -> VNil)
    else if str_eq name "instance_variable_set" then
      (let (_, _, _, ivars0) = world in
       match args with Cons (v, Cons (value, _)) -> let _ = map_set ivars0 ("cls:" ++ c ++ "@" ++ ivar_name_val env world v) value in value | _ -> VNil)
    else if str_eq name "instance_variable_defined?" then
      (let (_, _, _, ivars0) = world in
       match args with Cons (v, _) -> VBool (map_has ivars0 ("cls:" ++ c ++ "@" ++ ivar_name_val env world v)) | _ -> VBool false)
    else if str_eq name "remove_instance_variable" then
      (let (_, _, _, ivars0) = world in
       match args with
       | Cons (v, _) -> let k = "cls:" ++ c ++ "@" ++ ivar_name_val env world v in
         let old = (if map_has ivars0 k then map_get ivars0 k else VNil) in
         let _ = if map_has ivars0 k then map_delete ivars0 k else () in old
       | _ -> VNil)
    // singleton_class of a class/module: a distinct class whose namespace
    // holds the constants/methods defined via the object's instance_eval.
    else if str_eq name "singleton_class" then VClass ("(sng:" ++ c ++ ")")
    // Module#singleton_class?: activesupport refuses to define module
    // attributes on one.
    else if str_eq name "singleton_class?" then VBool (is_sng_cls c)
    // respond_to? on a class/module (also reachable via send) -- unless the
    // class defines its own singleton #respond_to?, which then answers.
    else if str_eq name "respond_to?"
            && (if has_meth world ("(sng:" ++ c ++ ")") "respond_to?" then false else true) then
      respond_to_answer env world recv args
    // Module#ancestors: the lookup chain (self, included modules, supers);
    // for a singleton class this is the metaclass chain down to Class.
    else if str_eq name "ancestors" then
      arr_new (anc_vclasses (ancestors_of world c))
    // Module#< / <= / > / >= / <=> : the subclass partial order. Unrelated
    // modules compare to nil, which is what makes sorting a list of classes
    // raise "comparison of Class with Class failed" until <=> exists.
    else if str_eq name "<" || str_eq name "<=" || str_eq name ">" ||
            str_eq name ">=" || str_eq name "<=>" then
      (match args with
       | Cons (VClass t, _) ->
         let same = str_eq c t in
         let below = (if same then false else pp_mem (ancestors_of world c) t) in
         let above = (if same then false else pp_mem (ancestors_of world t) c) in
         if str_eq name "<=>" then
           (if same then VInt 0 else if below then VInt (0 - 1) else if above then VInt 1 else VNil)
         else if same then VBool (str_eq name "<=" || str_eq name ">=")
         else if below then VBool (str_eq name "<" || str_eq name "<=")
         else if above then VBool (str_eq name ">" || str_eq name ">=")
         else VNil
       // `A < 1` is a TypeError in Ruby; `A <=> 1` is just nil.
       | Cons (_, _) ->
         if str_eq name "<=>" then VNil
         else raise_exc world "TypeError" "compared with non class/module"
       | _ -> VNil)
    // is_a?/kind_of?: a class/module is an INSTANCE of Class/Module (a singleton
    // class of Class's singleton class at the same nesting); walk that chain.
    // instance_of? checks the exact class only.
    else if str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?" then
      (match args with
       | Cons (VClass t, _) ->
         let rc = metaclass_class c in
         // a class EXTENDED with a module is a kind_of? it, and the module
         // lives in the class's metaclass includes -- metaclass_class alone
         // answers only "Class" or "Module" and never sees it.
         if str_eq name "instance_of?" then VBool (str_eq rc t)
         else VBool (obj_is_a world rc t || obj_is_a world ("(sng:" ++ c ++ ")") t)
       // asking about something that is not a class or module is not a
       // question with a false answer -- ruby refuses it.
       | Cons (_, _) -> raise_exc world "TypeError" "class or module required"
       | _ -> VBool false)
    // constants: the constant names scoped directly under this class/module
    // (stored "Name::Const"), as symbols. Enumerated from the constant table.
    else if str_eq name "constants" then
      (let pfx = c ++ "::" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter consts (fn (k: str) -> fn (v: Val) ->
         if str_len k > plen && str_eq (substring k 0 plen) pfx
            && (if str_contains (substring k plen (str_len k)) "::" then false else true)
            && (if map_has private_consts k then false else true)
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    // alias_method(new, old): the method form of `alias` — copy the method.
    else if str_eq name "alias_method" then
      (let (methsA, _, _, _) = world in
       match args with
       | Cons (a, Cons (b, _)) ->
         let n1 = (match a with VSym s -> s | VStr h -> sget h | _ -> "") in
         let n2 = (match b with VSym s -> s | VStr h -> sget h | _ -> "") in
         // resolve the source through the ancestor chain (an alias can name an
         // inherited/included method), and remember the origin so a `super`
         // inside the aliased method resumes above where the source was defined.
         let origin = if map_has methsA (c ++ "#" ++ n2) then c
                      else lookup_anc world (ancestors_of world c) n2 in
         let _ = if map_has methsA (origin ++ "#" ++ n2) then
                   (let _ = map_set methsA (c ++ "#" ++ n1) (map_get methsA (origin ++ "#" ++ n2)) in
                    // the alias keeps the ORIGINAL's lexical scope, so constants
                    // its body names still resolve where they were written
                    // (RubyGems aliases Kernel#require and its body reads
                    // Kernel::RUBYGEMS_ACTIVATION_MONITOR).
                    let _ = if map_has meth_cref (origin ++ "#" ++ n2)
                            then map_set meth_cref (c ++ "#" ++ n1) (map_get meth_cref (origin ++ "#" ++ n2))
                            else () in
                    // ...and the original's DEFINITION SITE: #source_location
                    // answers where the method was written, which for an alias
                    // is where the method it names was written.
                    let _ = copy_meth_src (c ++ "#" ++ n1) (origin ++ "#" ++ n2) in
                    // an alias inherits the SOURCE's visibility. Only the
                    // top-level branch below said so, because a top-level def
                    // used to live under a bare key; once it became the private
                    // Object#ret1 it is found HERE, and the alias came out
                    // public -- `k2.new.bar` answered where ruby refuses.
                    let _ = if map_has privates (origin ++ "#" ++ n2) then map_set privates (c ++ "#" ++ n1) VNil else () in
                    let _ = if map_has protecteds (origin ++ "#" ++ n2) then map_set protecteds (c ++ "#" ++ n1) VNil else () in
                    let _ = if str_eq origin c then () else map_set alias_origin (c ++ "#" ++ n1) origin in
                    if str_eq n1 n2 then () else map_set alias_srcname (c ++ "#" ++ n1) n2)
                 // A TOP-LEVEL method is stored under its bare name, with no
                 // class prefix -- `alias_method :hash, :ret1` where ret1 is a
                 // top-level def found nothing here and silently made no alias
                 // at all, so the builtin kept answering. Ruby finds it (it is
                 // a private method on Object) and the alias is private too.
                 else if map_has methsA n2 then
                   (let _ = map_set methsA (c ++ "#" ++ n1) (map_get methsA n2) in
                    let _ = if map_has meth_cref n2 then map_set meth_cref (c ++ "#" ++ n1) (map_get meth_cref n2) else () in
                    let _ = copy_meth_src (c ++ "#" ++ n1) n2 in
                    let _ = map_set privates (c ++ "#" ++ n1) VNil in
                    if str_eq n1 n2 then () else map_set alias_srcname (c ++ "#" ++ n1) n2)
                 // source is a builtin (no AST body) — remember it delegates to
                 // prim_method under the builtin name (e.g. String#+).
                 // ...and the source NAME, which #original_name answers. The two
                 // user-method branches above record it and this one did not, so
                 // an alias of a builtin reported its own name as the original.
                 else (let _ = (if str_eq n1 n2 then () else map_set alias_srcname (c ++ "#" ++ n1) n2) in
                       set_builtin_alias world c n1 n2) in
         // aliasing adds a method under a new name, so the hook fires (same
         // reason as the `alias` keyword above).
         let _ = run_method_added world c n1 in
         VSym n1
       | _ -> VNil)
    // GC.start / GC.enable / GC.disable / GC.stress= are no-ops.
    // Signal.trap / Signal.list. The handler is RECORDED and returned as the
    // previous one, and it is never called: nothing in this runtime delivers a
    // signal, so there is no source for it to come from. Refusing instead would
    // be worse in a specific way -- every CLI traps INT on its first line (the
    // `bundle` executable does, line 5), so refusing stops the program before it
    // starts, while accepting loses only a handler that could never fire. The
    // limit is written down in KNOWN_GAPS rather than hidden.
    else if str_eq c "Signal" && (str_eq name "trap" || str_eq name "list" || str_eq name "signame") then
      (if str_eq name "list" then
         mkhash (signal_list_pairs ())
       else if str_eq name "signame" then
         (match args with
          | Cons (VInt n, _) -> (let nm = signal_name_of n in if str_eq nm "" then VNil else mkstr nm)
          | _ -> VNil)
       else
         (let sg = (match args with Cons (VStr h, _) -> sget h | Cons (VSym sy, _) -> sy | Cons (VInt n, _) -> signal_name_of n | _ -> "") in
          let prev = (if map_has signal_traps sg then map_get signal_traps sg else mkstr "DEFAULT") in
          let hnd = (match args with
                     | Cons (_, Cons (v, _)) -> v
                     | _ -> (match blk with (true, _, _, _) -> mkstr "(block)" | _ -> mkstr "DEFAULT")) in
          let _ = map_set signal_traps sg hnd in
          prev))
    // RbConfig.ruby -- the path to "the ruby". RbConfig::CONFIG already carries a
    // borrowed one (derived from GEM_HOME, so the fiction agrees with the tree
    // this interpreter was pointed at), and this answers the same string rather
    // than inventing a second one. It is a fact about the CRuby installation on
    // the load path, NOT about mere-ruby: a program that re-executes it runs
    // CRuby, which is the caveat KNOWN_GAPS records. Answering nothing was worse
    // in a measurable way -- `bundle --version` stopped here.
    else if str_eq c "RbConfig" && str_eq name "ruby" then
      (match (if map_has consts "RbConfig::CONFIG" then map_get consts "RbConfig::CONFIG" else VNil) with
       | VHsh hid -> (match hash_lookup (hderef hid) (mkstr "bindir") with
                      | (true, VStr h) -> mkstr (sget h ++ "/ruby")
                      | _ -> mkstr "/usr/bin/ruby")
       | _ -> mkstr "/usr/bin/ruby")
    else if str_eq c "GC" && (str_eq name "start" || str_eq name "enable" || str_eq name "disable" || str_eq name "stress=" || str_eq name "stress") then VNil
    // Zlib.crc32(str, seed) / Zlib.adler32(str, seed), and the two stream
    // methods, reached as Zlib::Deflate.deflate / Zlib::Inflate.inflate.
    else if (str_eq c "Zlib" || str_eq c "Zlib::Deflate" || str_eq c "Zlib::Inflate")
            && (str_eq name "crc32" || str_eq name "adler32" ||
                str_eq name "deflate" || str_eq name "inflate" ||
                str_eq name "gunzip" || str_eq name "gzip") then
      (let sv = (match args with Cons (VStr h, _) -> sget h | _ -> "") in
       let v = str_to_bytevec sv in
       if str_eq name "crc32" then
         (match args with
          // crc32(str, seed): continue a running CRC, which is how a PNG
          // chunk's checksum covers the type and the content together.
          | Cons (_, Cons (VInt seed, _)) -> VInt (bit_xor (crc32_cont (bit_xor seed mask32) v) mask32)
          | _ -> VInt (crc32_vec v))
       else if str_eq name "adler32" then
         (match args with
          | Cons (_, Cons (VInt seed, _)) -> VInt (adler32_vec v seed)
          | Nil -> VInt 1
          | _ -> VInt (adler32_vec v 1))
       else if str_eq name "deflate" then
         mkstr (bytevec_to_str (zlib_wrap (deflate_body v) (adler32_vec v 1)))
       else if str_eq name "gzip" then
         mkstr (bytevec_to_str (deflate_gzip v))
       // Zlib.gunzip: a whole gzip MEMBER (header, deflate stream, trailer),
       // which is what GzipReader reads and what a .gz data file is. mgz
       // knows the header layout and checks the trailer's CRC and length.
       else if str_eq name "gunzip" then
         (if is_gzip v then
            (let out = gunzip (bytevec_pad v) in
             if gunzip_ok v out then mkstr (bytevec_to_str out)
             else raise_exc world "Zlib::GzipFile::CRCError" "invalid compressed data -- crc error")
          else raise_exc world "Zlib::GzipFile::Error" "not in gzip format")
       else
         mkstr (bytevec_to_str (inflate (bytevec_pad v) (zlib_body_start v))))
    // The socket capability: the raw fd operations the `socket` library (Ruby
    // source, see stdlib_src) builds TCPSocket / TCPServer on. Only names
    // starting with __ are answered, so a program's own `class Socket` is not
    // silently given these.
    else if str_eq c "Socket" && str_len name > 2 && str_eq (substring name 0 2) "__" then
      (if str_eq name "__connect" then
         (match args with
          | Cons (VStr h, Cons (VInt port, _)) -> VInt (tcp_connect (sget h) port)
          | _ -> VInt (0 - 1))
       else if str_eq name "__listen" then
         (match args with Cons (VInt port, _) -> VInt (tcp_listen port) | _ -> VInt (0 - 1))
       else if str_eq name "__accept" then
         (match args with Cons (VInt fd, _) -> VInt (tcp_accept fd) | _ -> VInt (0 - 1))
       else if str_eq name "__read" then
         // a short read is normal; "" means the peer closed (or the read timed
         // out). The bytes are BINARY -- nothing here knows their encoding.
         (match args with
          | Cons (VInt fd, Cons (VInt cap, _)) ->
            (let p = tcp_arena () in
             let n = tcp_read fd p (if cap > 65536 then 65536 else cap) in
             if n <= 0 then (let v = mkstr "" in
                             let _ = (match v with VStr h -> senc_set h "ASCII-8BIT" | _ -> ()) in v)
             else (let v = mkstr (mem_to_str p n) in
                   let _ = (match v with VStr h -> senc_set h "ASCII-8BIT" | _ -> ()) in v))
          | _ -> mkstr "")
       else if str_eq name "__write" then
         (match args with
          | Cons (VInt fd, Cons (VStr h, _)) -> VInt (tcp_put fd (sget h))
          | _ -> VInt (0 - 1))
       else if str_eq name "__close" then
         (match args with Cons (VInt fd, _) -> (let _ = tcp_close fd in VNil) | _ -> VNil)
       else if str_eq name "__timeout" then
         (match args with Cons (VInt fd, Cons (VInt ms, _)) -> VInt (tcp_set_timeout fd ms) | _ -> VInt 0)
       else VNil)
    // TracePoint#enable / #disable tell the interpreter whether to fire at all.
    else if str_eq c "TracePoint" && str_eq name "__active" then
      (let _ = (match args with
                | Cons (VBool true, _) -> map_set hook_flags "tp" VNil
                | _ -> if map_has hook_flags "tp" then map_delete hook_flags "tp" else ()) in VNil)
    else if str_eq c "Marshal" && str_eq name "dump" then
      (match args with
       | Cons (v, _) ->
         (let out = mkstr (mrsh_dump world v) in
          let _ = (match out with VStr h -> senc_set h "ASCII-8BIT" | _ -> ()) in out)
       | _ -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1..3)")
    // Marshal.load: the reader half of the same subset.
    else if str_eq c "Marshal" && (str_eq name "load" || str_eq name "restore") then
      (match args with
       | Cons (VStr h, _) -> mrsh_load world (sget h)
       | Cons (v, _) ->
         // an IO-ish argument: read it first, as ruby does.
         (match invoke_val_c env world blk v "read" Nil false with
          | VStr h -> mrsh_load world (sget h)
          | _ -> raise_exc world "TypeError" "instance of IO needed")
       | _ -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1..2)")
    // Process.clock_gettime(clock_id) -- one clock behind every id, in
    // seconds as a Float. Enough for the elapsed-time measurements libraries
    // use it for; not a separate CPU-time source.
    else if str_eq c "Process" && (str_eq name "pid" || str_eq name "ppid") then VInt (getpid ())
    else if str_eq c "Process" && str_eq name "clock_gettime" then VFlt (time ())
    // remove_const(:Name) deletes the constant, returning its value.
    else if str_eq name "remove_const" then
      (match args with
       | Cons (v, _) ->
         // the receiver's own constant is keyed qualified (C::N); a top-level
         // constant (self=Object or main) is keyed bare.
         let n0 = to_s v in
         let qn = c ++ "::" ++ n0 in
         let n = if map_has consts qn then qn else n0 in
         let old = if map_has consts n then map_get consts n else VNil in
         let _ = if map_has consts n then map_delete consts n else () in
         old
       | _ -> VNil)
    // attr_accessor / attr_reader / attr_writer called with values (a name
    // computed at run time), rather than the literal-symbol statement form.
    else if str_eq name "attr_accessor" || str_eq name "attr_reader" ||
            str_eq name "attr_writer" || str_eq name "attr" then
      (let mode = (if str_eq name "attr_reader" || str_eq name "attr" then "r"
                   else if str_eq name "attr_writer" then "w" else "rw") in
       let _ = add_attrs world c mode (vis_arg_names args) in
       VNil)
    // remove_method(:m) / undef_method(:m): drop the instance method m from
    // this class (used e.g. on a singleton class to undo a class method).
    else if str_eq name "remove_method" || str_eq name "undef_method" then
      (let (meths0, _, _, _) = world in
       // undef_method makes the name UNREACHABLE (a tombstone that also blocks
       // what the ancestors -- and the builtins -- would answer); remove_method
       // only drops this class's own definition and lets the chain answer.
       let tomb = str_eq name "undef_method" in
       let rec go9 = fn (as9: Val list) ->
         (match as9 with
          | Nil -> ()
          | Cons (v, rest9) ->
            let n9 = (match v with VSym sy -> sy | VStr h -> sget h | other -> to_s other) in
            let key = c ++ "#" ++ n9 in
            let _ = if map_has meths0 key then del_meth meths0 key else () in
            let _ = if map_has builtin_alias key then map_delete builtin_alias key else () in
            let _ = if tomb then set_undef key else () in
            go9 rest9) in
       let _ = go9 args in
       recv)
    // private_constant / public_constant as METHODS on the class. Only the
    // statement form inside a class body existed, so `C.private_constant :A`
    // was an undefined method -- and Ruby marks the names it recognises BEFORE
    // raising for one it does not, so a call that fails part way through still
    // took effect for the rest.
    else if str_eq name "private_constant" || str_eq name "public_constant" then
      (let priv = str_eq name "private_constant" in
       let rec go = fn (as0: Val list) ->
         match as0 with
         | Nil -> VNil
         | Cons (a, rest) ->
           let n = (match a with VSym sy -> sy | VStr h -> sget h | other -> to_s other) in
           let full = c ++ "::" ++ n in
           if map_has consts full then
             (let _ = (if priv then map_set private_consts full VNil
                       else (if map_has private_consts full then map_delete private_consts full else ())) in
              go rest)
           else raise_exc world "NameError" ("constant " ++ full ++ " not defined") in
       go args)
    // const_get(:Name) reads a constant; const_set(:Name, v) defines one.
    else if str_eq name "const_get" then
      (match args with
       | Cons (v, _) ->
         (let n = to_s v in
          let key = (if str_eq c "Object" then n else c ++ "::" ++ n) in
          // ⚠ ...and the ANCESTORS, which is where `::` already looks: a
          // constant on a superclass or an included module answers
          // `Child.const_get(:X)` in ruby, and this stopped at the class
          // itself and the top level.
          let akey = anc_const_key world c n in
          if map_has consts key then map_get consts key
          else if (if str_eq akey "" then false else true) then map_get consts akey
          else if map_has consts n then map_get consts n
          // the constant may only be registered as an autoload so far
          else if autoload_fire env world blk key || autoload_fire env world blk n then
            (if map_has consts key then map_get consts key
             else if map_has consts n then map_get consts n
             else raise_exc world "NameError" ("uninitialized constant " ++ n))
          // const_missing is the documented hook and const_get has to honour
          // it, not just a bare `Const` reference: regexp_parser resolves its
          // per-ruby-version syntax classes entirely through const_get.
          else if has_meth world ("(sng:" ++ c ++ ")") "const_missing" || has_meth world c "const_missing" then
            invoke_val_c env world blk (VClass c) "const_missing" (Cons (VSym n, Nil)) false
          else raise_exc world "NameError" ("uninitialized constant " ++ n))
       | _ -> VNil)
    // Module#autoload(:Const, path) / #autoload?(:Const). The registration is
    // qualified with the receiver, so Gem.autoload :Requirement, "..." answers
    // a later Gem::Requirement.
    else if str_eq name "autoload" then
      (match args with
       | Cons (nm, Cons (pv, _)) ->
         let cn = (match nm with VSym sy -> sy | VStr h -> sget h | _ -> "") in
         let pth = (match pv with VStr h -> sget h | _ -> "") in
         let key = (if str_eq c "Object" then cn else c ++ "::" ++ cn) in
         let _ = map_set autoloads key (mkstr pth) in
         VNil
       | _ -> VNil)
    else if str_eq name "autoload?" then
      (match args with
       | Cons (nm, _) ->
         let cn = (match nm with VSym sy -> sy | VStr h -> sget h | _ -> "") in
         let key = (if str_eq c "Object" then cn else c ++ "::" ++ cn) in
         (if map_has autoloads key then map_get autoloads key else VNil)
       | _ -> VNil)
    // Module#deprecate_constant marks a constant as deprecated; the constant
    // keeps working and CRuby only warns on use, which mere-ruby does not do.
    else if str_eq name "deprecate_constant" then recv
    else if str_eq name "const_set" then
      // the constant belongs to the RECEIVER's namespace, the same key rule
      // const_get and autoload use -- writing it bare put `Schemes.const_set
      // "HTTP", URI::HTTP` at top level, where a later `HTTP` would find it.
      (match args with
       | Cons (v, Cons (value, _)) ->
         let key = (if str_eq c "Object" then to_s v else c ++ "::" ++ to_s v) in
         // ruby warns here too: const_set over an existing constant is the
         // same replacement as writing `C = v`.
         let _ = const_store world key value in value
       | _ -> VNil)
    else if has_meth world ("(sng:" ++ c ++ ")") name then
      (if vischeck && meth_private world ("(sng:" ++ c ++ ")") name
       then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for " ++ c)
       else invoke world noblk recv ("(sng:" ++ c ++ ")") name args)
    // a class method aliased to a BUILTIN one (concurrent-ruby writes
    // `singleton_class.send :alias_method, :[], :new`, so `Node[a, b]` is
    // `Node.new(a, b)`): the alias table records the source name.
    else if (if str_eq (blt_alias_lookup world (ancestors_of world ("(sng:" ++ c ++ ")")) name) "" then false else true) then
      invoke_val_c env world blk recv (blt_alias_lookup world (ancestors_of world ("(sng:" ++ c ++ ")")) name) args false
    // a class object is an instance of Class < Module, so user methods on
    // Module/Class are callable on any class.
    else if has_meth world "Module" name then invoke world noblk recv "Module" name args
    else if has_meth world "Class" name then invoke world noblk recv "Class" name args
    // `Kernel.raise` / `Kernel.format` / ... : the module-function form of the
    // private Kernel methods, which is how a library reaches them past a
    // possible override (`::Kernel::raise ::ArgumentError, "..."`).
    // ...only for the module functions; Module's own methods (`class`, `name`,
    // ...) fall through to the general dispatcher, as for Math above.
    // `to_s` and `inspect` are Module's here too, for the same reason `class` is:
    // `Kernel.to_s` is "Kernel", and routing it to the module FUNCTION answered
    // "main" -- the module function runs with self = main, which is exactly
    // right for `Kernel.puts` and exactly wrong for a description of the module.
    else if str_eq c "Kernel" && (if is_module_method name then false else true)
            && (if str_eq name "class" || str_eq name "to_s" || str_eq name "inspect" then false else true) then
      // `raise` is an expression form, not an entry in the method table.
      (if str_eq name "raise" || str_eq name "fail" then
         (let (_, _, _, iv0) = world in
          let exc = (match args with
                     | Nil -> (if map_has globals "!" && (match map_get globals "!" with VNil -> false | _ -> true)
                               then map_get globals "!" else make_exc_w world Nil)
                     | _ -> make_exc_w world args) in
          let _ = map_set iv0 "$exc" exc in
          let _ = note_raise_site () in
  let _ = map_set raise_bt "v" (arr_new (caller_frames 0)) in
          (let m = "mere-ruby: (ruby exception raised)" in
           let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m))
       // `Kernel.`(cmd)`: the command literal's method, called by name.
       else if str_eq name "`" then
         (match args with Cons (VStr cs, _) -> run_backtick (sget cs) | _ -> mkstr "")
       else try_self_call_x env world recv name args true)
    // a class that does `extend Enumerable` and defines `self.each` gets the
    // Enumerable surface on the class object itself (Gem::Specification is
    // built that way: `Gem::Specification.count`, `.find`, `.select`).
    else if has_meth world ("(sng:" ++ c ++ ")") "each" && is_enum_method name then
      (if enum_needs_block name then make_enum_a world recv name args
       else
         let coll = enum_collect world recv ("(sng:" ++ c ++ ")") in
         if str_eq name "to_a" || str_eq name "entries" then coll
         else dispatch_prim env world blk coll name args vischeck)
    else prim_method recv name args
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    // `class << obj` retags ocls with the singleton-class name so mixed-in
    // methods dispatch; but the BUILTIN arms below match by class NAME, and
    // "(sng:...)" matches none of them -- pp.rb's `class << ENV` made
    // ENV['HOME'] a NoMethodError for every later reader. When the singleton
    // chain does not answer the name, dispatch by the singleton's superclass
    // (the class the object had), which is where the builtins live.
    let cls = (let c0 = map_get ocls id in
               if is_sng_cls c0 && (if has_meth world c0 name then false else true)
               then sng_supername world c0 else c0) in
    if has_meth world cls name then
      (if vischeck && meth_private world cls name
       then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for " ++ for_recv_cls world cls)
       else if vischeck && meth_protected world cls name && (if protected_ok env world cls then false else true)
       then raise_exc world "NoMethodError" ("protected method '" ++ name ++ "' called for " ++ for_recv_cls world cls)
       else invoke world noblk recv cls name args)
    // `alias_method :my_inspect, :inspect` in a plain class records a delegation
    // in builtin_alias and NOTHING read it here: the table was consulted for a
    // primitive receiver (String#+) and for a class's singleton, and not for an
    // ordinary object, so aliasing any Kernel or Object method installed a name
    // that answered NoMethodError.
    else if (if str_eq (blt_alias_lookup world (ancestors_of world cls) name) "" then false else true) then
      invoke_val_c env world blk recv (blt_alias_lookup world (ancestors_of world cls) name) args false
    // The four Kernel names ruby keeps PRIVATE whatever a class does with them
    // (is_kernel_priv_only). Their builtin arms are further down, and a plain
    // call has to be refused before reaching one -- `obj.initialize_copy(x)`
    // ran the copy hook, and `obj.respond_to_missing?(:x)` reported the method
    // missing, where ruby says "private method '...' called".
    else if vischeck && is_kernel_priv_only name then
      raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for " ++ for_recv_cls world cls)
    else if str_eq name "class" then VClass (display_cls world cls)
    // Object#methods: public + protected method names reachable from this
    // object (its class and ancestors, plus any singleton methods), as
    // symbols, excluding privates. `include(:sym)`-style membership only, so
    // order is unspecified.
    else if is_vis_list_name name then
      // `methods(false)` is `singleton_methods(false)`, not "this class's own
      // methods": ruby routes it there before the walk even starts.
      (if str_eq name "methods" && (match args with Cons (VBool false, _) -> true | Cons (VNil, _) -> true | _ -> false)
       then invoke_val_c env world blk recv "singleton_methods" (Cons (VBool false, Nil)) false
       // the object's REAL class (singleton included), not the dispatch class:
       // dispatch strips the singleton off for a name the singleton does not
       // define, and none of these four is ever defined there.
       else vis_method_list world (map_get ocls id) name args)
    // Object#singleton_methods: methods defined on this object's singleton.
    else if str_eq name "singleton_methods" then
      (let (meths9, _, _, _) = world in
       let pfx = "(sng:" ++ str_of_int id ++ ")#" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter meths9 (fn (k: str) -> fn (v: Meth) ->
         // the public and protected ones: a `private` in `class << obj` keeps
         // its method out of this list and out of `methods(false)`, which
         // routes here.
         if str_len k > plen && str_eq (substring k 0 plen) pfx
            && (if map_has privates k then false else true)
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym (substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "instance_variable_get" then
      (match args with Cons (v, _) -> let k = str_of_int id ++ "@" ++ ivar_name_val env world v in (if map_has ivars k then map_get ivars k else VNil) | _ -> VNil)
    else if str_eq name "instance_variable_set" then
      // the NAME is checked first: `nil.instance_variable_set(:foo, 42)` is a
      // NameError about the name, not a FrozenError about nil.
      (match args with
       | Cons (v, Cons (value, _)) ->
         (let nm9 = ivar_name_val env world v in
          // ...naming the RECEIVER, which #receiver answers. Every other
          // FrozenError raise records it; these two did not, so the object a
          // program was refused permission to change could not be asked for.
          let _ = (if val_frozen_mut recv
                   then (let _ = raise_exc_iv world "FrozenError"
                                   ("can't modify frozen " ++ cls ++ ": " ++ inspect_w env world recv)
                                   (Cons (("__recv", recv), Nil)) in ())
                   else ()) in
          let _ = map_set ivars (str_of_int id ++ "@" ++ nm9) value in value)
       | _ -> VNil)
    // Object#remove_instance_variable: the name list has claimed it all along
    // with nothing behind it, so every call was a NoMethodError. Removing an
    // undefined one is a NameError, and a frozen receiver a FrozenError.
    else if str_eq name "remove_instance_variable" then
      (match args with
       | Cons (v, _) ->
         (let nm9 = ivar_name_val env world v in
          let _ = (if val_frozen_mut recv
                   then (let _ = raise_exc_iv world "FrozenError"
                                   ("can't modify frozen " ++ cls ++ ": " ++ inspect_w env world recv)
                                   (Cons (("__recv", recv), Nil)) in ())
                   else ()) in
          let k9 = str_of_int id ++ "@" ++ nm9 in
          if map_has ivars k9
          then (let old9 = map_get ivars k9 in let _ = map_delete ivars k9 in old9)
          else raise_exc world "NameError" ("instance variable @" ++ nm9 ++ " not defined"))
       | _ -> VNil)
    else if str_eq name "instance_variable_defined?" then
      (match args with Cons (v, _) -> VBool (map_has ivars (str_of_int id ++ "@" ++ ivar_name_val env world v)) | _ -> VBool false)
    // Kernel#instance_variables_to_inspect (ruby 4.0): the default answers nil,
    // and Kernel#inspect reads an override to pick the ivars it shows.
    else if str_eq name "instance_variables_to_inspect" then VNil
    // Kernel#respond_to_missing?(name, include_all): the default answers false.
    // It has to EXIST -- an override's `super` needs somewhere to land, and
    // `send(:respond_to_missing?, :x, false)` is a question every object can be
    // asked -- while a plain call is refused, because it is private (the name is
    // already in is_kernel_priv_only, which is what the visibility check reads).
    else if str_eq name "respond_to_missing?"
            && (if vischeck && is_kernel_priv_only name then false else true) then VBool false
    // Object#instance_variables: this object's own @ivars, as :@name symbols.
    else if str_eq name "instance_variables" then
      (let pfx = str_of_int id ++ "@" in
       let plen = str_len pfx in
       let tmp = map_new () in
       let _ = map_iter ivars (fn (k: str) -> fn (v: Val) ->
         // a Struct's member SLOTS are not instance variables (struct_slot):
         // ruby keeps members outside this table entirely, so a struct with
         // nothing else set answers [].
         if str_len k > plen && str_eq (substring k 0 plen) pfx
            && (if struct_is_slot k then false else true)
         then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym ("@" ++ substring k plen (str_len k))))
         else ()) in
       arr_new (idx_to_list tmp 0 (map_len tmp)))
    else if str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?" then
      (match args with
       | Cons (VClass c9, _) ->
         // `cls` above is the DISPATCH class, which strips the singleton off
         // for a name the singleton does not define -- and neither of these is
         // ever defined there. #extend puts the module in the SINGLETON's
         // includes, so a walk that started from the stripped class could not
         // see it: `o.extend(M); o.kind_of?(M)` was false while
         // `o.singleton_class.include?(M)` was true.
         (let ocls0 = map_get ocls id in
          let real0 = (if is_sng_cls ocls0 then (if map_has sup ocls0 then map_get sup ocls0 else "Object") else ocls0) in
          if str_eq name "instance_of?" then VBool (str_eq real0 c9)
          else VBool (obj_is_a world ocls0 c9))
       | Cons (_, _) -> raise_exc world "TypeError" "class or module required"
       | _ -> VBool false)
    // an object's singleton class (created on first use).
    else if str_eq name "singleton_class" then VClass (singleton_cls_of world id)
    // bound Method objects (Kernel#method): call/[]/===, reflection getters,
    // unbind, to_proc (a proc closing over the receiver).
    else if str_eq cls "Method" then
      (let mnm = (match map_get ivars (str_of_int id ++ "@__m_name") with VStr h -> sget h | _ -> "") in
       let mown = (match map_get ivars (str_of_int id ++ "@__m_owner") with VStr h -> sget h | _ -> "") in
       let mrecv = (if map_has ivars (str_of_int id ++ "@__m_recv") then map_get ivars (str_of_int id ++ "@__m_recv") else VMain) in
       if str_eq name "call" || str_eq name "[]" || str_eq name "===" then
         (match mrecv with
          | VMain -> call_method env world blk mnm args
          // a binary operator on a primitive is not in the method table -- it
          // is arith_bin -- so `1.method(:+)` has to route there, the same way
          // an alias to a builtin operator does.
          | _ ->
            if is_binary_op_name mnm
               && (if has_meth world (dispatch_cls_of world mrecv) mnm then false else true) then
              (match args with
               | Cons (a1, _) -> arith_bin mnm mrecv a1
               | Nil -> invoke_val_c env world blk mrecv mnm args false)
            // A Method holds the definition it was taken FROM: calling it by
            // name again re-dispatches, so `obj.method(:m).super_method.call`
            // ran the subclass's m forever. Invoke the owner's directly when
            // there is one (a builtin has no entry and keeps the old path).
            else if (if str_eq mown "" then false else true) && has_meth world mown mnm then
              invoke world blk mrecv mown mnm args
            else invoke_val_c env world blk mrecv mnm args false)
       else if str_eq name "name" then VSym mnm
       else if str_eq name "receiver" then mrecv
       // Method#box (ruby 4.0): the Ruby::Box a method was defined in; nil while
       // boxes are not enabled, which is the only state this interpreter has.
       else if str_eq name "box" then VNil
       // ...and when there is no owner recorded (a method reached through
       // method_missing, or on a primitive receiver) it is the RECEIVER's
       // class. class_name is the value-level answer and calls every object
       // "Object", so a Method taken on a program's own class reported Object.
       else if str_eq name "owner" then
         (if str_eq mown ""
          then VClass (display_cls world (dispatch_cls_of world mrecv))
          else VClass mown)
       // The same four as UnboundMethod (see there): the defined-as name, the
       // definition further up, a copy, and a hash. A bound Method's owner may
       // be empty (a method reached on a primitive receiver), in which case the
       // receiver's class is the owner -- the same fallback #owner uses.
       else if str_eq name "original_name" then
         // ⚠ the fallback class is the DISPATCH class, not class_name's: that
         //   one is world-free and answers "Object" for every object, so a
         //   Method with no recorded owner (one reached through
         //   method_missing) asked about Object -- and #owner right above
         //   already used the dispatch class, so the two disagreed.
         (let ocl = (if str_eq mown "" then dispatch_cls_of world mrecv else mown) in
          VSym (original_name_of world ocl mnm))
       else if str_eq name "super_method" then
         // ...a bound Method, on the SAME receiver: ruby answers something
         // callable, and this answered an UnboundMethod that #call refused
         (let ocl = (if str_eq mown "" then dispatch_cls_of world mrecv else mown) in
          // the ORIGINAL name, for the reason given in the UnboundMethod arm.
          let mnm = original_name_of world ocl mnm in
          let anc9 = ancestors_of world ocl in
          let above0 = lookup_anc_above world anc9 ocl mnm in
          // ...or the universal name's home, Kernel (see the UnboundMethod arm)
          let above = (if str_eq above0 "" && is_prim_method mnm
                          && (if str_eq ocl "Kernel" then false else true) && anc_has anc9 "Kernel"
                       then "Kernel" else above0) in
          if str_eq above "" then VNil
          else
            (let nid = alloc_oid ocls in
             let _ = map_set ocls nid "Method" in
             let _ = map_set ivars (str_of_int nid ++ "@__m_name") (mkstr mnm) in
             let _ = map_set ivars (str_of_int nid ++ "@__m_owner") (mkstr above) in
             let _ = map_set ivars (str_of_int nid ++ "@__m_recv") mrecv in
             VObj nid))
       // Method#==: the same receiver, the same owner, and the same definition --
       // two ALIASES of one method are equal (ruby: `m.method(:each) ==
       // m.method(:each_pair)`), which is what canon_alias decides. There was
       // no arm at all here, so comparing two Method objects fell through to
       // object identity and every such assertion was false. UnboundMethod had
       // this and bound Method did not: one question, two implementations, and
       // only one of them answered.
       else if str_eq name "==" || str_eq name "eql?" then
         (match args with
          | Cons (VObj oid2, _) ->
            (let (_, _, ocls2, ivars2) = world in
             if str_eq (map_get ocls2 oid2) "Method" then
               (let own2 = (match map_get ivars2 (str_of_int oid2 ++ "@__m_owner") with VStr h -> sget h | _ -> "") in
                let nm2 = (match map_get ivars2 (str_of_int oid2 ++ "@__m_name") with VStr h -> sget h | _ -> "") in
                let rc2 = (if map_has ivars2 (str_of_int oid2 ++ "@__m_recv") then map_get ivars2 (str_of_int oid2 ++ "@__m_recv") else VMain) in
                // A PRIMITIVE receiver's Method has no owner recorded, and the
                // alias table is keyed by CLASS: `false.method(:inspect) ==
                // false.method(:to_s)` compared "" against "" and never
                // reached FalseClass's inspect/to_s pair. #owner and #hash
                // already fall back to the receiver's class; equality now does.
                // ...and for a CLASS receiver that fallback is the class
                // itself, not `Class`: `Complex.method(:rect)` is a method of
                // Complex's singleton, and the alias table is keyed by
                // Complex ("Class" has no rect/rectangular row and never will).
                let ocl9 = (if str_eq mown "" then
                              (match mrecv with VClass c9 -> c9 | _ -> class_name mrecv)
                            else mown) in
                VBool (str_eq own2 mown
                       && str_eq (defined_as_name world ocl9 nm2) (defined_as_name world ocl9 mnm)
                       && rb_identical rc2 mrecv))
             else VBool false)
          | _ -> VBool false)
       // #dup and #clone answer a NEW Method: they used to answer the receiver
       // itself, so freezing one froze its copies too. clone carries the frozen
       // status over, dup drops it -- which is the whole of the two specs.
       else if str_eq name "clone" || str_eq name "dup" then
         (let nid = alloc_oid ocls in
          let _ = map_set ocls nid "Method" in
          let _ = map_set ivars (str_of_int nid ++ "@__m_name") (mkstr mnm) in
          let _ = map_set ivars (str_of_int nid ++ "@__m_owner") (mkstr mown) in
          let _ = map_set ivars (str_of_int nid ++ "@__m_recv") mrecv in
          let _ = (if str_eq name "clone" && ofrozen_get id then ofrozen_set nid else ()) in
          VObj nid)
       else if str_eq name "freeze" then (let _ = ofrozen_set id in recv)
       else if str_eq name "frozen?" then VBool (ofrozen_get id)
       // ...and the identity questions every object answers: #dup makes a NEW
       // one, and `dup.equal?(m)` is how a spec says so
       else if str_eq name "equal?" then
         (match args with Cons (VObj o2, _) -> VBool (o2 == id) | _ -> VBool false)
       else if str_eq name "object_id" || str_eq name "__id__" then VInt (1000000 + id * 8)
       // #curry and the two compositions are the Proc's, reached through
       // #to_proc: a Method is callable, and ruby gives it the same surface.
       else if str_eq name "curry" || str_eq name ">>" || str_eq name "<<" then
         (let pr = invoke_val_c env world blk recv "to_proc" Nil false in
          invoke_val_c env world blk pr name args false)
       else if str_eq name "hash" then
         // ...by the name the method was DEFINED as (two aliases of one method
         // are eql? and must hash alike), and with the RECEIVER: two Methods of
         // different objects are different methods
         (let ocl = (if str_eq mown "" then dispatch_cls_of world mrecv else mown) in
          VInt (val_hash (mkstr (ocl ++ "#" ++ defined_as_name world ocl mnm))
                + (match mrecv with
                   | VObj oid9 -> oid9 * 8
                   | VStr sid9 -> sid9 * 8 + 1
                   | VInt n9 -> n9
                   | _ -> 0)))
       else if str_eq name "arity" then VInt (bm_arity world mown mnm)
       // Method#source_location: [file, line] of the `def`, or nil for a
       // builtin (there is no ruby source behind one).
       else if str_eq name "source_location" then meth_source_location world mown mnm mrecv
       else if str_eq name "parameters" then
         bm_params world (if str_eq mown "" then dispatch_cls_of world mrecv else mown) mnm
       else if str_eq name "unbind" then
         (let uid = alloc_oid ocls in
          let _ = map_set ocls uid "UnboundMethod" in
          let _ = map_set ivars (str_of_int uid ++ "@__um_cls") (mkstr (if str_eq mown "" then dispatch_cls_of world mrecv else mown)) in
          let _ = map_set ivars (str_of_int uid ++ "@__um_name") (mkstr mnm) in
          VObj uid)
       else if str_eq name "to_proc" then
         // The proc calls the method with the receiver as SELF and no explicit
          // receiver, because `method(:x)` may name a private method and a
          // Method object is allowed to call one (zeitwerk passes
          // `&method(:tracepoint_class_callback)`, which is private).
          (let benv = map_new () in
          let _ = map_set benv "__m_self" mrecv in
          let _ = map_set benv "self" mrecv in
          // the proc calls the Method OBJECT, so it inherits everything #call
          // already handles: a private method, and a builtin operator.
          let _ = map_set benv "__m_meth" (VObj id) in
          // ... and the block the caller gives the PROC belongs to the method:
          // `method(:m).to_proc.call(5) { }` must reach m's yield, so the proc
          // takes a block parameter and passes it on.
          let body = (match mrecv with
                      | VMain -> Cons (SExpr (ECall (mnm, Cons (ESplat (EVar "__a"), Cons (EBlockPass (EVar "__b"), Nil)))), Nil)
                      | _ -> Cons (SExpr (EMethod (EVar "__m_meth", "call", Cons (ESplat (EVar "__a"), Cons (EBlockPass (EVar "__b"), Nil)))), Nil)) in
          let pid = map_len proc_store in
          let _ = store_proc (str_of_int pid) (true, Cons ("*__a", Cons ("&__b", Nil)), body, benv) in
          // ruby's Method#to_proc answers the METHOD's arity and is a lambda;
          // the forwarder's own `*__a` would say -1 and "not a lambda".
          let _ = map_set proc_arity (str_of_int pid) (VInt (bm_arity world mown mnm)) in
          let _ = map_set lambda_ids (str_of_int pid) VNil in
          // the forwarder is not where the method was written, so the proc
          // reports the METHOD's own location -- ruby's Method#to_proc answers
          // exactly what the Method answers, and the forwarder's line would be
          // a wrong location rather than a missing one.
          let _ = (match meth_source_location world mown mnm mrecv with
                   | VArr a8 -> (match deref a8 with
                                 | Cons (f8, Cons (l8, _)) ->
                                   (let _ = map_set proc_src ("f" ++ str_of_int pid) f8 in
                                    map_set proc_src (str_of_int pid) l8)
                                 | _ -> map_set proc_src ("f" ++ str_of_int pid) (mkstr ""))
                   | _ -> map_set proc_src ("f" ++ str_of_int pid) (mkstr "")) in
          VProc pid)
       else if str_eq name "inspect" || str_eq name "to_s" then
         // `#<Method: A#foo(a, b=..., *r, k:, &blk) file:line>` -- the owner, the
         // name, the parameter SHAPE and where it was written. It used to be
         // the class and the name alone, and for an object with ivars the
         // default printer showed the internal ones instead.
         (let ocl9 = (if str_eq mown "" then dispatch_cls_of world mrecv else mown) in
          mkstr (meth_inspect_str world "Method" ocl9 mnm
                   (bm_params world ocl9 mnm) (meth_source_location world mown mnm mrecv)))
       else if str_eq name "==" || str_eq name "eql?" then
         // two names for ONE implementation are one method, which is the
         // question this asks -- UnboundMethod#== has compared through
         // defined_as_name all along and the bound form compared raw names, so
         // `Kernel.method(:fail) == Kernel.method(:raise)` was false while the
         // unbound pair was true.
         (match args with
          | Cons (VObj oid2, _) ->
            (let n2 = to_s (map_get ivars (str_of_int oid2 ++ "@__m_name")) in
             let o2 = (if map_has ivars (str_of_int oid2 ++ "@__m_owner")
                       then (match map_get ivars (str_of_int oid2 ++ "@__m_owner") with
                             | VStr h9 -> sget h9 | other9 -> to_s other9)
                       else "") in
             VBool (str_eq (map_get ocls oid2) "Method"
                    && str_eq (defined_as_name world o2 n2) (defined_as_name world mown mnm)
                    && rb_identical mrecv (if map_has ivars (str_of_int oid2 ++ "@__m_recv") then map_get ivars (str_of_int oid2 ++ "@__m_recv") else VMain)))
          | _ -> VBool false)
       // the universal names, same reason as the ThreadGroup arm above (this
       // one refused `nil?` and `itself`).
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Method"))
    // Enumerator::Yielder: << / yield / call forward to the driving block.
    // A break from that block (a bounded materialization) propagates as a
    // break flow so the generator's own loop stops.
    else if str_eq cls "Enumerator::Yielder" then
      (if str_eq name "<<" || str_eq name "yield" || str_eq name "call" then
         (match (if map_has ivars (str_of_int id ++ "@__y_blk") then map_get ivars (str_of_int id ++ "@__y_blk") else VNil) with
          | VProc bpid ->
            (match run_block world (false, (Nil : str list), (Nil : Stmt list), env) (map_get proc_store (str_of_int bpid)) args with
             | FBreak v -> raise_exc world "StopIteration" "iteration reached an end"
             | FNext r -> (if str_eq name "<<" then recv else r)
             | other -> (if str_eq name "<<" then recv else flow_value other))
          | _ -> VNil)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Enumerator::Yielder"))
    // the lazy-pipeline driver callback (see lz_run).
    else if str_eq cls "Enumerator::LzDrv" && str_eq name "__lzstep" then
      (let v = (match args with
                | Cons (a1, Nil) -> a1
                | Nil -> VNil
                | _ -> arr_new args) in
       lz_step env world blk id v)
    // Fiber instances (synchronous): resume runs the stored block once.
    else if str_eq cls "Fiber" then
      (let k = str_of_int id in
       if str_eq name "resume" then
         (if map_has ivars (k ++ "@__fb_done") then raise_exc world "FiberError" "dead fiber called"
          else
            let _ = map_set ivars (k ++ "@__fb_done") (VBool true) in
            (match (if map_has ivars (k ++ "@__fb_blk") then map_get ivars (k ++ "@__fb_blk") else VNil) with
             | VProc pid ->
               (let noblk2 = (false, (Nil : str list), (Nil : Stmt list), env) in
                // the fiber is its own ownership context (Mutex#owned? is
                // per fiber): run the body with itself as the current thread.
                let savedcur = (if map_has cur_thr "v" then map_get cur_thr "v" else VNil) in
                let _ = map_set cur_thr "v" recv in
                let r = flow_value (run_block world noblk2 (map_get proc_store (str_of_int pid)) args) in
                let _ = map_set cur_thr "v" savedcur in
                r)
             | _ -> VNil))
       else if str_eq name "alive?" then VBool (if map_has ivars (k ++ "@__fb_done") then false else true)
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Fiber"))
    // ThreadGroup instances: #add marks the thread, #list scans the registry.
    else if str_eq cls "ThreadGroup" then
      (if str_eq name "add" then
         (match args with
          | Cons (VObj tid2, _) ->
            // moving into an enclosed group — or out of one — is ThreadError.
            let cur_grp = (if map_has ivars (str_of_int tid2 ++ "@__tgrp") then map_get ivars (str_of_int tid2 ++ "@__tgrp")
                           else if map_has dfl_tg "v" then map_get dfl_tg "v" else VNil) in
            let grp_enc = fn (g: Val) ->
              (match g with VObj gid2 -> map_has ivars (str_of_int gid2 ++ "@__tgenc") | _ -> false) in
            if grp_enc recv then raise_exc world "ThreadError" "can't move to the enclosed thread group"
            else if grp_enc cur_grp then raise_exc world "ThreadError" "can't move from the enclosed thread group"
            else let _ = map_set ivars (str_of_int tid2 ++ "@__tgrp") recv in recv
          | _ -> recv)
       else if str_eq name "enclose" then
         (let _ = map_set ivars (str_of_int id ++ "@__tgenc") (VBool true) in recv)
       else if str_eq name "enclosed?" then VBool (map_has ivars (str_of_int id ++ "@__tgenc"))
       else if str_eq name "list" then
         (let out = map_new () in
          let _ = map_iter all_thr (fn (k2: str) -> fn (t: Val) ->
            (match t with
             | VObj tid2 ->
               (let alive2 = (match (if map_has ivars (str_of_int tid2 ++ "@__tst") then map_get ivars (str_of_int tid2 ++ "@__tst") else VBool false) with VStr _ -> true | _ -> false) in
                let grp = (if map_has ivars (str_of_int tid2 ++ "@__tgrp") then map_get ivars (str_of_int tid2 ++ "@__tgrp")
                           else if map_has dfl_tg "v" then map_get dfl_tg "v" else VNil) in
                if alive2 && rb_eq grp recv then (let i2 = map_len out in map_set out (str_of_int i2) t) else ())
             | _ -> ())) in
          arr_new (idx_to_list out 0 (map_len out)))
       // ⚠ ...and then the UNIVERSAL names, or this arm refuses them all.
       //   `equal?`, `__send__`, `object_id`, `nil?`, `hash`, `==`, `freeze`,
       //   `itself` and six more answered NoMethodError here -- fourteen of
       //   them, the same hole ARGF had: an arm keyed on the class captures
       //   the whole namespace, so every name it does not spell is refused
       //   rather than passed on. The class's own names are all tried above,
       //   so this cannot shadow one.
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of ThreadGroup"))
    // Queue / SizedQueue (synchronous model): a plain FIFO. A pop that
    // would block forever (empty, not closed, nobody left to push) is the
    // deadlock fatal; the non-blocking form is ThreadError.
    else if str_eq cls "Queue" || str_eq cls "SizedQueue" then
      (let k = str_of_int id in
       let qv = (if map_has ivars (k ++ "@__q") then map_get ivars (k ++ "@__q") else arr_new Nil) in
       let items = (match qv with VArr aid -> deref aid | _ -> Nil) in
       let closed = map_has ivars (k ++ "@__qclosed") in
       if str_eq name "push" || str_eq name "<<" || str_eq name "enq" then
         (if closed then raise_exc world "ClosedQueueError" "queue closed"
          else
            let full = (match (if map_has ivars (k ++ "@__qmax") then map_get ivars (k ++ "@__qmax") else VNil) with
                        | VInt mx -> val_list_len items >= mx
                        | _ -> false) in
            if full && (match args with Cons (_, Cons (VBool true, _)) -> false | _ -> true) then
              // a blocking push with no consumer: parks a thread, fatal
              // deadlock on the main thread.
              (if in_thread () then raise_exc world "__ThreadPark" "sleep"
               else raise_exc world "fatal" "No live threads left. Deadlock?")
            else if full then raise_exc world "ThreadError" "queue full"
            else
              (match args with
               | Cons (v, _) -> let _ = (match qv with VArr aid -> arr_set aid (list_append items (Cons (v, Nil))) | _ -> ()) in recv
               | _ -> recv))
       else if str_eq name "pop" || str_eq name "shift" || str_eq name "deq" then
         (match items with
          | Cons (h, t) ->
            let _ = (match qv with VArr aid -> arr_set aid t | _ -> ()) in h
          | Nil ->
            (if closed then VNil
             else if (match args with Cons (VBool true, _) -> true | _ -> false) then
               raise_exc world "ThreadError" "queue empty"
             // a blocking pop with no producer: parks a thread, fatal
             // deadlock on the main thread.
             else if in_thread () then raise_exc world "__ThreadPark" "sleep"
             else raise_exc world "fatal" "No live threads left. Deadlock?"))
       else if str_eq name "empty?" then VBool (match items with Nil -> true | _ -> false)
       else if str_eq name "size" || str_eq name "length" then VInt (val_list_len items)
       else if str_eq name "clear" then
         (let _ = (match qv with VArr aid -> arr_set aid Nil | _ -> ()) in recv)
       else if str_eq name "close" then
         (let _ = map_set ivars (k ++ "@__qclosed") (VBool true) in recv)
       else if str_eq name "closed?" then VBool closed
       else if str_eq name "num_waiting" then VInt 0
       else if str_eq name "max" then
         (if map_has ivars (k ++ "@__qmax") then map_get ivars (k ++ "@__qmax") else VNil)
       else if str_eq name "max=" then
         (match args with Cons (VInt mx, _) -> let _ = map_set ivars (k ++ "@__qmax") (VInt mx) in VInt mx | _ -> VNil)
       // ⚠ ...but NOT dup/clone. A Queue has no #initialize_copy in ruby, so
       //   copying one is a NoMethodError naming THAT -- and handing the two
       //   names to the generic handler answered a COPY instead, which is
       //   wrong in the permissive direction: a program that must not copy a
       //   queue got a second queue and no complaint. Mutex and ThreadGroup
       //   do copy, so this is per-class, not a rule about the group.
       else if str_eq name "dup" || str_eq name "clone" then
         raise_exc world "NoMethodError"
           ("undefined method 'initialize_copy' for an instance of Thread::" ++ cls)
       // the universal names, same reason as the ThreadGroup arm above.
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of " ++ cls))
    // ConditionVariable (synchronous model): wait returns immediately (there
    // is nobody to signal us later); signal/broadcast are no-ops.
    else if str_eq cls "ConditionVariable" then
      (if str_eq name "wait" then
         // waiting with nobody left to signal: parks a thread, and is the
         // real deadlock on the main thread (as in Ruby).
         (if in_thread () then raise_exc world "__ThreadPark" "sleep"
          else raise_exc world "fatal" "No live threads left. Deadlock?")
       else if str_eq name "signal" || str_eq name "broadcast" then recv
       // the universal names, same reason as the ThreadGroup arm above.
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of ConditionVariable"))
    // Mutex (synchronous model): the owner is a thread object; a lock held
    // by a dead thread is reacquirable, a re-lock by the owner (or a lock
    // held by a live other thread, which would block forever) is ThreadError.
    else if str_eq cls "Mutex" then
      (let k = str_of_int id in
       let owner = (if map_has ivars (k ++ "@__mown") then map_get ivars (k ++ "@__mown") else VNil) in
       let cur = (if map_has cur_thr "v" then map_get cur_thr "v" else VNil) in
       let owner_alive =
         (match owner with
          | VObj oid2 -> (match (if map_has ivars (str_of_int oid2 ++ "@__tst") then map_get ivars (str_of_int oid2 ++ "@__tst") else VBool false) with VStr _ -> true | _ -> false)
          | _ -> false) in
       let cur_locks = (match cur with
                        | VObj cid2 -> (match (if map_has ivars (str_of_int cid2 ++ "@__nlk") then map_get ivars (str_of_int cid2 ++ "@__nlk") else VInt 0) with VInt n2 -> n2 | _ -> 0)
                        | _ -> 0) in
       let lk_inc = fn (d: int) ->
         (match cur with
          | VObj cid2 -> map_set ivars (str_of_int cid2 ++ "@__nlk") (VInt (cur_locks + d))
          | _ -> ()) in
       if str_eq name "lock" then
         // a re-lock by the owner deadlocks. A lock held by a live other
         // thread blocks: a thread that blocks parks (it never resumes);
         // the main thread blocking on a parked owner while holding another
         // mutex is a real cycle (fatal), otherwise the parked owner never
         // resumes, so blocking "until it releases" resolves to its death
         // and the lock is taken.
         (if owner_alive && rb_eq owner cur then raise_exc world "ThreadError" "deadlock; recursive locking"
          else if owner_alive && in_thread () then raise_exc world "__ThreadPark" "sleep"
          else if owner_alive && cur_locks > 0 then raise_exc world "fatal" "No live threads left. Deadlock?"
          else let _ = map_set ivars (k ++ "@__mown") cur in let _ = lk_inc 1 in recv)
       else if str_eq name "try_lock" then
         (if owner_alive then VBool false
          else let _ = map_set ivars (k ++ "@__mown") cur in let _ = lk_inc 1 in VBool true)
       else if str_eq name "unlock" then
         (if owner_alive && rb_eq owner cur then (let _ = map_set ivars (k ++ "@__mown") VNil in let _ = lk_inc (0 - 1) in recv)
          else raise_exc world "ThreadError" "Attempt to unlock a mutex which is not locked")
       else if str_eq name "locked?" then VBool owner_alive
       else if str_eq name "owned?" then VBool (owner_alive && rb_eq owner cur)
       // ⚠ #sleep UNLOCKS the mutex for the duration, so it refuses a mutex
       // this thread does not hold -- with the message unlocking one gives,
       // which is what ruby raises and what the spec asks for. It slept and
       // answered 0 for a mutex nobody had locked.
       // ⚠ the DURATION is checked first, before the lock: ruby refuses a
       // negative interval whether or not the mutex is held, and refuses one
       // that is not a time interval at all. Then the mutex must be held --
       // #sleep unlocks it for the duration, so it gives the message unlocking
       // gives. A nil duration sleeps until signalled, which with nobody left
       // to signal is the deadlock fatal.
       else if str_eq name "sleep" then
         (let dur9 = (match args with Cons (v9, _) -> v9 | Nil -> VNil) in
          let neg9 = (match dur9 with
                      | VInt n9 -> n9 < 0
                      | VFlt f9 -> f9 < 0.0
                      | VRat (n9, _) -> str_len n9 > 0 && str_eq (char_at n9 0) "-"
                      | _ -> false) in
          let _ = (if neg9 then (let _ = raise_exc world "ArgumentError" "time interval must not be negative" in ()) else ()) in
          let _ = (match dur9 with
                   | VNil -> () | VInt _ -> () | VFlt _ -> () | VBig _ -> () | VRat (_, _) -> ()
                   | other9 -> (let _ = raise_exc world "TypeError"
                                  ("can't convert " ++ display_cls_msg world (dispatch_cls_of world other9)
                                   ++ " into time interval") in ())) in
          if owner_alive && rb_eq owner cur then
            (if in_thread () then raise_exc world "__ThreadPark" "sleep"
             else match dur9 with
                  | VNil -> raise_exc world "fatal" "No live threads left. Deadlock?"
                  | _ -> VNil)
          else raise_exc world "ThreadError" "Attempt to unlock a mutex which is not locked")
       // the universal names, same reason as the ThreadGroup arm above.
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Mutex"))
    // File handles from File.open/File.new: buffered writes, read-through
    // reads, #gets tracked by @__f_pos.
    else if str_eq cls "File" && map_has ivars (str_of_int id ++ "@__f_path") then
      (let k = str_of_int id in
       let path = (match map_get ivars (k ++ "@__f_path") with VStr h -> sget h | _ -> "") in
       let mode = (match map_get ivars (k ++ "@__f_mode") with VStr h -> sget h | _ -> "") in
       // read CONSUMES: a second `f.read` is "" in ruby, and `eof?` after one is
       // true. This kept the position untouched, so eof? answered false with the
       // whole file already handed over.
       if str_eq name "read" then
         (let content = (if file_exists path then read_file path else "") in
          let pos = (match map_get ivars (k ++ "@__f_pos") with VInt n -> n | _ -> 0) in
          let _ = map_set ivars (k ++ "@__f_pos") (VInt (str_len content)) in
          mkstr (if pos >= str_len content then "" else substring content pos (str_len content)))
       else if str_eq name "write" || str_eq name "print" || str_eq name "<<" then
         (let piece = io_join_go args "" in
          let cur = (match map_get ivars (k ++ "@__f_buf") with VStr h -> sget h | _ -> "") in
          let _ = map_set ivars (k ++ "@__f_buf") (mkstr (cur ++ piece)) in
          let _ = (if map_has ivars (k ++ "@__f_sync") then (let _ = file_flush_obj world id in ()) else ()) in
          if str_eq name "<<" then recv
          else if str_eq name "write" then VInt (str_len piece) else VNil)
       else if str_eq name "puts" then
         (let piece = file_puts_str args "" in
          let cur = (match map_get ivars (k ++ "@__f_buf") with VStr h -> sget h | _ -> "") in
          let _ = map_set ivars (k ++ "@__f_buf") (mkstr (cur ++ piece)) in
          VNil)
       else if str_eq name "gets" || str_eq name "readline" then
         (let content = (if file_exists path then read_file path else "") in
          let pos = (match map_get ivars (k ++ "@__f_pos") with VInt n -> n | _ -> 0) in
          if pos >= str_len content then
            (if str_eq name "readline" then raise_exc world "EOFError" "end of file reached" else VNil)
          else
            let e = line_end_from content pos in
            let _ = map_set ivars (k ++ "@__f_pos") (VInt e) in
            mkstr (substring content pos e))
       else if str_eq name "each_line" || str_eq name "readlines" then
         (let content = (if file_exists path then read_file path else "") in
          let av = file_lines_arr content 0 in
          if str_eq name "readlines" then av
          else invoke_val_c env world blk av "each" Nil vischeck)
       else if str_eq name "close" then (let _ = file_close_obj world id in VNil)
       else if str_eq name "closed?" then VBool (str_eq mode "")
       else if str_eq name "path" || str_eq name "to_path" then mkstr path
       else if str_eq name "rewind" then (let _ = map_set ivars (k ++ "@__f_pos") (VInt 0) in VInt 0)
       else if str_eq name "eof?" || str_eq name "eof" then
         (let content = (if file_exists path then read_file path else "") in
          let pos = (match map_get ivars (k ++ "@__f_pos") with VInt n -> n | _ -> 0) in
          VBool (pos >= str_len content))
       // These four were promised by `responds` and not implemented: respond_to?
       // said yes and calling raised NoMethodError, which is worse than either
       // answer alone (a library that checks first still breaks).
       // A write here lands in @__f_buf and reaches the file at close, so flush
       // is the real thing: put the buffer out now. `sync = true` then means
       // every write flushes, which is what ruby's flag means too.
       else if str_eq name "flush" then (let _ = file_flush_obj world id in recv)
       else if str_eq name "sync" then
         VBool (map_has ivars (k ++ "@__f_sync"))
       else if str_eq name "sync=" then
         (match args with
          | Cons (v, _) ->
            (let _ = (if truthy v then map_set ivars (k ++ "@__f_sync") (VBool true)
                      else (if map_has ivars (k ++ "@__f_sync") then map_delete ivars (k ++ "@__f_sync") else ())) in
             let _ = (if truthy v then (let _ = file_flush_obj world id in ()) else ()) in v)
          | _ -> VNil)
       // a file is not a terminal, and here nothing is
       else if str_eq name "tty?" || str_eq name "isatty" then VBool false
       // There is no descriptor to report: a File here is a path, a mode and a
       // buffer (see file_close_obj), and the host interface reads and writes
       // whole files. Refusing says so where a made-up number would not -- the
       // same choice as the UDP and UNIX sockets.
       else if str_eq name "fileno" then
         raise_exc world "NotImplementedError"
           "fileno is not available: mere-ruby's File has no descriptor"
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of File"))
    // ARGF (no-block methods): read / readlines / to_a over the ARGV files
    // (or stdin). The block form of each is handled in the block dispatch.
    else if str_eq cls "ARGF" then
      (if str_eq name "read" then mkstr (argf_input ())
       else if str_eq name "readlines" || str_eq name "to_a" then
         arr_new (val_list_of_strs (str_lines_go (argf_input ()) 0 0 (str_len (argf_input ()))))
       // ⚠ ...and every object answers the universal names. This arm captured
       //   EVERY name for ARGF, exactly as the IO arm below used to, so
       //   `ARGF.object_id` was a NoMethodError -- which is the first line
       //   csv/parser.rb runs (`ARGF_OBJECT_ID = ARGF.object_id`), so
       //   `require "csv"` could not even load.
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for ARGF"))
    // STDOUT / STDERR: IO objects keyed by @__io_fd (1 = out, 2 = err).
    else if str_eq cls "IO" && map_has ivars (str_of_int id ++ "@__io_fd") then
      (let fd = (match map_get ivars (str_of_int id ++ "@__io_fd") with VInt n -> n | _ -> 1) in
       if str_eq name "puts" then
         (let _ = (if fd == 2 then (match args with Nil -> print_err "" | _ -> err_puts_each world args)
                   else (match args with Nil -> out_print "" | _ -> puts_each world args)) in
          VNil)
       else if str_eq name "print" then
         (let _ = (if fd == 2 then print_err (io_join_go args "") else print_each world args) in VNil)
       else if str_eq name "write" then
         (let s2 = io_join_go args "" in
          let _ = (if fd == 2 then print_err s2 else out_print_no_nl s2) in
          VInt (str_len s2))
       else if str_eq name "<<" then
         (let s2 = io_join_go args "" in
          let _ = (if fd == 2 then print_err s2 else out_print_no_nl s2) in
          recv)
       else if str_eq name "flush" || str_eq name "sync=" then recv
       else if str_eq name "sync" then VBool false
       else if str_eq name "fileno" then VInt fd
       // A standard stream's encodings. STDOUT and STDERR answer nil for both
       // in ruby (they take whatever they are given), STDIN has an external
       // one, and #set_encoding records the pair and answers self. All three
       // were NoMethodError, which also made respond_to? deny them.
       // Object's own methods, before the arm's catch-all refusal: this arm
       // captures every name for an IO, so `STDOUT.equal?(x)` and
       // `STDOUT.object_id` were NoMethodError.
       else if str_eq name "equal?" then
         VBool (match args with Cons (VObj o9, _) -> o9 == id | _ -> false)
       else if str_eq name "object_id" || str_eq name "__id__" then VInt id
       else if str_eq name "frozen?" then VBool false
       else if str_eq name "hash" then VInt (val_hash recv)
       else if str_eq name "dup" || str_eq name "clone" then recv
       else if str_eq name "external_encoding" then
         (if map_has ivars (str_of_int id ++ "@__io_ext") then map_get ivars (str_of_int id ++ "@__io_ext")
          else if fd == 0 then
            (if map_has def_ext_enc "v" then map_get def_ext_enc "v"
             else if map_has enc_objs "UTF-8" then map_get enc_objs "UTF-8" else VNil)
          else VNil)
       else if str_eq name "internal_encoding" then
         (if map_has ivars (str_of_int id ++ "@__io_int") then map_get ivars (str_of_int id ++ "@__io_int")
          else VNil)
       else if str_eq name "set_encoding" then
         (let one9 = fn (a: Val) ->
            (match a with
             | VStr h9 -> (let nm9 = enc_canon (sget h9) in
                           if map_has enc_objs nm9 then map_get enc_objs nm9 else a)
             | _ -> a) in
          let _ = (match args with
                   | Cons (e1, rest9) ->
                     (let _ = map_set ivars (str_of_int id ++ "@__io_ext") (one9 e1) in
                      match rest9 with
                      | Cons (e2, _) -> map_set ivars (str_of_int id ++ "@__io_int") (one9 e2)
                      | Nil -> ())
                   | Nil -> ()) in
          recv)
       // Mere has no isatty capability, and the browser build has no terminal
       // at all, so an IO here is never a tty. That matches the redirected /
       // piped case exactly (which is how CRuby answers under the harnesses),
       // and libraries that colorize only for a tty degrade to plain output.
       else if str_eq name "tty?" || str_eq name "isatty" then VBool false
       // ruby's own Logger asks `log.respond_to?(:path) and log.path` before
       // deciding what to open, and a standard stream answers with its name.
       else if str_eq name "path" || str_eq name "to_path" then
         mkstr (if fd == 0 then "<STDIN>" else if fd == 2 then "<STDERR>" else "<STDOUT>")
       else if str_eq name "close" then VNil
       else if str_eq name "closed?" then VBool false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of IO"))
    // ENV: reads consult the write overlay first, then the environment table
    // (so a set-but-empty variable reads as "" like Ruby).
    // ENV's own surface. The universal object protocol is NOT ENV's business:
    // this arm used to capture every name and end in "undefined method for ENV",
    // which is how `ENV.equal?(ENV)`, `.frozen?`, `.hash`, `.itself`, `.dup`
    // came to raise on an object where they work on every other. A branch that
    // matches on the RECEIVER has to say which NAMES it is answering for, or it
    // shadows everything it did not think of.
    //
    // to_s and inspect are the exceptions ENV does own (ruby answers "ENV" and
    // the environment's contents, not #<Object:0x..>).
    else if str_eq cls "EnvHash"
            && (if is_prim_method name
                then str_eq name "to_s" || str_eq name "inspect"
                     || str_eq name "dup" || str_eq name "clone"
                else true) then
      // ENV takes STRINGS, and ruby asks an object for #to_str before using it
      // as one. Delegating to a plain Hash without asking meant an object that
      // names a key looked up NOTHING (no match, no error), and a value that
      // is not a string was STORED as itself -- so `ENV[k] = obj` put a
      // non-string in the environment and the next reader got it back.
      (let args = env_coerce_args env world name args in
       if str_eq name "[]" then
         (match args with Cons (kv, _) -> env_lookup_v (env_key_of env world kv) | _ -> VNil)
       // ENV[k] = v stores the string v CONVERTS to, and answers the object it
       // was handed: `ENV.send(:[]=, "foo", value).equal?(value)`. Converting in
       // the argument list would have answered the converted copy instead --
       // and storing without converting put a non-string in the environment.
       else if str_eq name "[]=" || str_eq name "store" then
         (match args with
          | Cons (kv, Cons (v, _)) ->
            (let k2 = env_key_of env world kv in
             // ⚠ the NAME is what setenv(3) will take, and ruby refuses what it
             // cannot pass: a name holding `=` or an empty one is Errno::EINVAL
             // naming the call, and a NUL byte in either half is an
             // ArgumentError -- a C string cannot carry one. This accepted all
             // four and wrote an entry the real environment could never hold.
             let _ = (if str_contains k2 (chr 0)
                      then (let _ = raise_exc world "ArgumentError"
                              "bad environment variable name: contains null byte" in ())
                      // ⚠ ...but only when there is a value to SET. `ENV[k] = nil`
                      // deletes, and deleting a key the environment could never
                      // have held is a no-op in ruby, not a refusal. (A NUL in
                      // the name is refused either way: it cannot even be
                      // compared as a C string.)
                      else if (str_eq k2 "" || str_contains k2 "=")
                              && (match v with VNil -> false | _ -> true)
                      then (let _ = raise_exc_iv world "Errno::EINVAL"
                              ("Invalid argument - setenv(" ++ k2 ++ ")")
                              (Cons (("__recv", kv), Nil)) in ())
                      else ()) in
             let _ = (match v with
                      | VStr h9 -> (if str_contains (sget h9) (chr 0)
                                    then (let _ = raise_exc world "ArgumentError"
                                            "bad environment variable value: contains null byte" in ())
                                    else ())
                      | _ -> ()) in
             match v with
             | VNil -> (let _ = map_set env_ovr k2 VNil in VNil)
             // a String is stored and answered AS IS, identity included; anything
             // else is converted, and the answer is the conversion, not the
             // object (ruby: `ENV[k] = obj` is the string, `= str` is that str).
             | VStr _ -> (let _ = map_set env_ovr k2 v in v)
             | _ -> (let s9 = mkstr (env_key_of env world v) in
                     let _ = map_set env_ovr k2 s9 in s9))
          | _ -> VNil)
       else if str_eq name "fetch" then
         (match args with
          | Cons (kv, rest) ->
            let k2 = env_key_of env world kv in
            (match env_lookup_v k2 with
             | VNil -> (match rest with
                        | Cons (d, _) -> d
                        | Nil -> raise_exc world "KeyError" ("key not found: \"" ++ k2 ++ "\""))
             | v -> v)
          | _ -> VNil)
       else if str_eq name "key?" || str_eq name "has_key?" || str_eq name "include?" || str_eq name "member?" then
         (match args with
          | Cons (kv, _) -> VBool (match env_lookup_v (env_key_of env world kv) with VNil -> false | _ -> true)
          | _ -> VBool false)
       else if str_eq name "delete" then
         (match args with
          | Cons (kv, _) ->
            let k2 = env_key_of env world kv in
            let old = env_lookup_v k2 in
            let _ = map_set env_ovr k2 VNil in
            old
          | _ -> VNil)
       else if str_eq name "assoc" then
         (match args with
          | Cons (kv, _) ->
            (let k2 = env_key_of env world kv in
             match env_lookup_v k2 with
             | VNil -> VNil
             | v -> arr_new (Cons (mkstr k2, Cons (v, Nil))))
          | _ -> VNil)
       // reverse lookup: the overlay first, then the environ dump.
       else if str_eq name "key" then
         (match args with
          | Cons (kv, _) ->
            let target = env_key_of env world kv in
            let hit = map_new () in
            let _ = map_iter env_ovr (fn (k2: str) -> fn (v: Val) ->
              (match v with
               | VStr h -> if str_eq (sget h) target && (if map_has hit "k" then false else true)
                           then map_set hit "k" (mkstr k2) else ()
               | _ -> ())) in
            (if map_has hit "k" then map_get hit "k"
             else env_key_scan (env_all_pairs ()) target)
          | _ -> VNil)
       // ENV.to_hash / to_h / keys / values / size: the real environment with
       // the write overlay applied (a VNil entry in the overlay is a deletion).
       else if str_eq name "to_hash" || str_eq name "to_h" then mkhash (env_hash_list ())
       else if str_eq name "keys" then arr_new (env_hl_keys (env_hash_list ()))
       else if str_eq name "values" then arr_new (env_hl_values (env_hash_list ()))
       else if str_eq name "size" || str_eq name "length" || str_eq name "count" then
         VInt (val_list_len (env_hl_keys (env_hash_list ())))
       else if str_eq name "empty?" then
         VBool (match env_hash_list () with Nil -> true | _ -> false)
       else if str_eq name "to_a" then arr_new (env_hl_pairs (env_hash_list ()))
       // ENV.replace(hash): the environment becomes exactly this hash, so
       // every key it does not mention is deleted.
       else if str_eq name "replace" then
         (match args with
          | Cons (VHsh h, _) ->
            let _ = env_check_pairs env world (hderef h) in
            let _ = env_del_keys (env_hl_keys (env_hash_list ())) in
            let _ = env_set_pairs env world (hderef h) in recv
          | Cons (o9, _) -> raise_exc world "TypeError"
                              ("no implicit conversion of " ++ class_name o9 ++ " into Hash")
          | Nil -> recv)
       // ⚠ merge!/update take ANY NUMBER of hashes, applied left to right --
       // `ENV.merge!(a, b)` is both. Reading only the first silently dropped
       // the rest.
       else if str_eq name "update" || str_eq name "merge!" then
         (let rec go9 = fn (az: Val list) ->
            (match az with
             | Nil -> recv
             | Cons (VHsh h, t9) -> (let _ = env_set_pairs env world (hderef h) in go9 t9)
             | Cons (o9, _) -> raise_exc world "TypeError"
                                 ("no implicit conversion of " ++ class_name o9 ++ " into Hash")) in
          go9 args)
       // ENV is not an object you get a second of: ruby refuses both, and names
       // the thing to do instead. Answering a COPY (which is what the delegation
       // did) hands back something that looks like ENV and changes nothing when
       // written to.
       else if str_eq name "dup" then
         raise_exc world "TypeError" "Cannot dup ENV, use ENV.to_h to get a copy of ENV as a hash"
       // ...and clone validates its keyword FIRST: `freeze:` takes nil or a
       // boolean and no other name is accepted, and only then does ENV say it
       // cannot be cloned at all. Refusing before looking made the spec that
       // asks for that ArgumentError get the TypeError instead.
       else if str_eq name "clone" then
         (match env_clone_kw_err args with
          | "" -> raise_exc world "TypeError" "Cannot clone ENV, use ENV.to_h to get a copy of ENV as a hash"
          | m9 -> raise_exc world "ArgumentError" m9)
       else if str_eq name "clear" then
         (let _ = env_del_keys (env_hl_keys (env_hash_list ())) in recv)
       // ENV's to_s is the literal "ENV"; its inspect is the environment.
       else if str_eq name "to_s" then mkstr "ENV"
       else if str_eq name "inspect" then
         invoke_val_c env world blk (mkhash (env_hash_list ())) "inspect" Nil false
       // ENV.shift removes and returns the first pair, or nil when empty.
       else if str_eq name "shift" then
         (match env_hash_list () with
          | Cons (k, Cons (v, _)) ->
            let _ = env_del_keys (Cons (k, Nil)) in
            arr_new (Cons (k, Cons (v, Nil)))
          | _ -> VNil)
       // ENV.rehash answers nil: there is no table to rebuild.
       else if str_eq name "rehash" then VNil
       // ENV.slice looks a key up by the STRING it converts to and answers it
       // under the key it was GIVEN: `ENV.slice(obj)` is `{obj => "..."}`.
       // Coercing the argument list in place (which is what every other key
       // name here wants) would have renamed the result's keys.
       else if str_eq name "slice" then mkhash (env_slice_pairs env world args)
       // ENV.value? answers nil -- not false -- for an argument that is not a
       // string: it did not fail to find one, it never looked.
       else if str_eq name "value?" || str_eq name "has_value?" then
         (match args with
          | Cons (VStr h9, _) -> VBool (env_has_value (env_hash_list ()) (sget h9))
          | _ -> VNil)
       // ⚠ A mutator must not reach the delegation below: it would run on the
       // COPY and report success while the environment stayed as it was --
       // a silently wrong answer, which is the one failure a corpus cannot see.
       // The test is a RULE (a trailing ! or =), so a name nobody thought of
       // fails loudly instead of quietly.
       //
       // reject! / select! / filter! / delete_if / keep_if are exempt HERE
       // because this arm is the one reached with NO block, and without a block
       // they do not mutate anything -- they answer an enumerator over the
       // pairs. The hazard the rule guards against cannot arise.
       // ⚠ ...and WITHOUT a block, the five that WOULD mutate answer an
       // enumerator over ENV ITSELF. Delegating built one over the snapshot
       // Hash below, so running it (`ENV.select!.each { }`) selected inside the
       // copy and left the environment alone. #to_enum re-invokes the method
       // WITH the block when the enumerator runs, which is the whole point of
       // the form.
       // ...and the non-bang SELECTORS the same way: `e = ENV.select` then
       // `ENV["k"]="v"` then `e.each { }` sees the pair, because the enumerator
       // reads ENV when it runs and not when it was made.
       else if (str_eq name "select!" || str_eq name "filter!" || str_eq name "reject!"
                || str_eq name "delete_if" || str_eq name "keep_if"
                || str_eq name "select" || str_eq name "filter" || str_eq name "reject")
               && (match blk with (true, _, _, _) -> false | _ -> true) then
         invoke_val_c env world blk recv "to_enum" (Cons (VSym name, Nil)) false
       // ⚠ merge!/update belong with the names the delegation CAN carry out: it
       // runs them on a copy and writes the copy back, which is exactly what
       // they need. Refusing them by their spelling meant `ENV.merge!(h) { }`
       // raised NotImplementedError while `ENV.merge!(h)` worked -- the same
       // method, refused for having a block.
       else if (str_ends_with name "!" || str_ends_with name "=")
               && not (str_eq name "reject!" || str_eq name "select!" || str_eq name "filter!"
                       || str_eq name "merge!") then
         raise_exc world "NotImplementedError"
           ("mere-ruby: ENV." ++ name ++ " is not implemented (it would change the environment)")
       // Everything else ENV answers, it answers AS a hash -- which is what it
       // is. Delegating gets each / invert / select / values_at / slice /
       // except / merge / rassoc / has_value? and the rest with ruby's own
       // semantics, instead of twenty-five arms written one at a time. A name
       // Hash does not have raises NoMethodError from Hash, naming Hash.
       else invoke_val_c env world blk (mkhash (env_hash_list ())) name args false)
    // Enumerator::Lazy surface without a block: take/drop extend the pipeline,
    // first/to_a/force run it (bounded), eager materializes.
    else if str_eq cls "Enumerator::Lazy" then
      (if str_eq name "take" || str_eq name "drop" then
         (match args with
          | Cons (VInt n, _) -> lz_extend world id name (VInt n)
          | _ -> raise_exc world "ArgumentError" "wrong number of arguments")
       else if str_eq name "first" then
         (match args with
          | Cons (VInt n, _) -> lz_run env world blk id n VNil
          | _ -> (match lz_run env world blk id 1 VNil with
                  | VArr aid -> val_nth (deref aid) 0
                  | _ -> VNil))
       else if str_eq name "to_a" || str_eq name "force" then lz_run env world blk id (0 - 1) VNil
       else if str_eq name "eager" then make_enum world (lz_run env world blk id (0 - 1) VNil) "each"
       else if str_eq name "lazy" then recv
       else if str_eq name "inspect" || str_eq name "to_s" then mkstr "#<Enumerator::Lazy>"
       else if is_enum_method name then
         invoke_val_c env world blk (lz_run env world blk id (0 - 1) VNil) name args vischeck
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Enumerator::Lazy"))
    // Enumerator#+ / Chain#+: a chain of self and the given enumerators.
    else if (is_enum_cls cls || str_eq cls "Enumerator::Chain") && str_eq name "+" then
      (let base = (if str_eq cls "Enumerator::Chain" then chain_srcs world id else Cons (recv, Nil)) in
       mk_chain world (list_append base args))
    // Enumerator::Chain surface: each is handled by the block dispatcher;
    // everything enumerable materializes.
    else if str_eq cls "Enumerator::Chain"
            && (is_enum_method name || str_eq name "size" || str_eq name "each_slice" || str_eq name "each_cons") then
      (let av = chain_to_arr env world blk id in
       invoke_val_c env world blk av name args vischeck)
    // Enumerator#inspect: "#<Enumerator: <recv>:<meth>(args)>".
    // Enumerator::ArithmeticSequence: what it knows beyond an Enumerator.
    else if str_eq cls "Enumerator::ArithmeticSequence"
            && (str_eq name "begin" || str_eq name "end" || str_eq name "step" || str_eq name "exclude_end?"
                || str_eq name "inspect" || str_eq name "to_s" || str_eq name "==" || str_eq name "eql?" || str_eq name "==="
                || str_eq name "hash" || str_eq name "size" || str_eq name "last") then
      // (no closure over `id` here: a lifted inner fn capturing a name that is
      // also a prelude function -- `id` -- resolved to the function)
      (let key = str_of_int id in
       let iv = fn (k: str) -> (if map_has ivars k then map_get ivars k else VNil) in
       let b = iv (key ++ "@__as_begin") in let e = iv (key ++ "@__as_end") in let st = iv (key ++ "@__as_step") in
       let excl = (match iv (key ++ "@__as_excl") with VBool x -> x | _ -> false) in
       if str_eq name "begin" then b
       else if str_eq name "end" then e
       else if str_eq name "step" then st
       else if str_eq name "exclude_end?" then VBool excl
       else if str_eq name "inspect" || str_eq name "to_s" then mkstr (aseq_inspect_str env world id)
       else if str_eq name "==" || str_eq name "eql?" || str_eq name "===" then
         (match args with
          | Cons (VObj oid, _) ->
            (if str_eq (map_get ocls oid) "Enumerator::ArithmeticSequence" then
               (let okey = str_of_int oid in
                VBool (rb_eq b (iv (okey ++ "@__as_begin")) && rb_eq e (iv (okey ++ "@__as_end")) && rb_eq st (iv (okey ++ "@__as_step"))
                       && (match iv (okey ++ "@__as_excl") with VBool x -> x == excl | _ -> false)))
             else VBool false)
          | _ -> VBool false)
       else if str_eq name "hash" then
         VInt (aseq_hi b * 31 + aseq_hi e * 17 + aseq_hi st * 7 + (if excl then 1 else 0))
       else
         // size / last: integer sequences count exactly; anything else walks
         (match (b, e, st) with
          | (VInt bi, VInt ei, VInt si) ->
            (let n = aseq_size bi ei si excl in
             if str_eq name "size" then VInt n
             else (match args with
                   | Cons (VInt k, _) -> arr_new (aseq_terms (bi + (if n - k > 0 then n - k else 0) * si) si (if k < n then k else n))
                   | _ -> if n == 0 then VNil else VInt (bi + (n - 1) * si)))
          | (VNil, _, _) -> raise_exc world "TypeError" "nil can't be coerced into Integer"
          | (_, VNil, _) -> (if str_eq name "size" then VFlt (1.0 / 0.0) else raise_exc world "RangeError" "cannot get the last element of endless arithmetic sequence")
          | _ ->
            // A numeric triple with a Float in it is COUNTED, never walked.
            // Mere has no match guards, so the test lives in the arm body.
            (let inf9 = 1.0 / 0.0 in
             let numeric9 = aseq_is_num b && aseq_is_num e && aseq_is_num st in
             let ef9 = (if numeric9 then aseq_to_flt e else 0.0) in
             let sf9 = (if numeric9 then aseq_to_flt st else 0.0) in
             let endless9 = numeric9 && (ef9 == inf9 || ef9 == (0.0 - inf9)) in
             if numeric9 && str_eq name "size" then aseq_size_flt (aseq_to_flt b) ef9 sf9 excl
             else if endless9 then
               // last of a sequence running to infinity: CRuby names the end
               // it would have reached, signed by the direction of travel.
               raise_exc world "FloatDomainError" (if sf9 > 0.0 then "Infinity" else "-Infinity")
             else
               (let av = enum_to_arr env world blk id in
                (match av with
                 | VArr aid -> (if str_eq name "size" then VInt (val_list_len (deref aid))
                                else (match args with
                                      | Cons (VInt k, _) -> arr_new (vtake (val_rev (deref aid) Nil) k)
                                      | _ -> (match val_rev (deref aid) Nil with Cons (x, _) -> x | Nil -> VNil)))
                 | _ -> VNil)))))
    else if is_enum_cls cls && (str_eq name "inspect" || str_eq name "to_s") then
      (if map_has ivars (str_of_int id ++ "@recv") then
         (let recv2 = map_get ivars (str_of_int id ++ "@recv") in
          let meth2 = to_s (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else mkstr "each") in
          let argstr = (match (if map_has ivars (str_of_int id ++ "@eargs") then map_get ivars (str_of_int id ++ "@eargs") else VNil) with
                        | VArr aid2 -> "(" ++ enum_args_str (deref aid2) ++ ")"
                        | _ -> "") in
          mkstr ("#<Enumerator: " ++ to_s (invoke_val_c env world blk recv2 "inspect" Nil false) ++ ":" ++ meth2 ++ argstr ++ ">"))
       else mkstr "#<Enumerator: generator>")
    // Enumerator#size: the size given to Enumerator.new (a proc is called),
    // nil for an unsized generator, else the materialized length.
    else if is_enum_cls cls && str_eq name "size" then
      (if map_has ivars (str_of_int id ++ "@__e_size") then
         (match map_get ivars (str_of_int id ++ "@__e_size") with
          | VProc spid -> invoke_val_c env world blk (VProc spid) "call" Nil false
          | VObj oid2 ->
            (let (m9, s9, o9, i9) = world in
             if has_meth world (map_get o9 oid2) "call"
             then invoke_val_c env world blk (VObj oid2) "call" Nil false
             else VObj oid2)
          | v -> v)
       else if map_has ivars (str_of_int id ++ "@__e_blk") then VNil
       // a source that cannot know its size without running answers nil
       // (String#upto walks succ until it passes the limit).
       // ⚠ ...and an Integer #upto/#downto over a limit that is not a number
       // refuses HERE: the Enumerator was built happily, and the comparison it
       // cannot make is what #size needs.
       else if (match (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else VNil) with
                | VStr mh -> str_eq (sget mh) "upto" || str_eq (sget mh) "downto"
                | _ -> false)
               && (match (if map_has ivars (str_of_int id ++ "@recv") then map_get ivars (str_of_int id ++ "@recv") else VNil) with
                   | VInt _ -> true | VBig _ -> true | _ -> false)
               && (match (if map_has ivars (str_of_int id ++ "@eargs") then map_get ivars (str_of_int id ++ "@eargs") else VNil) with
                   | VArr aid9 -> (match deref aid9 with
                                   | Cons (VInt _, _) -> false
                                   | Cons (VBig _, _) -> false
                                   | Cons (VFlt _, _) -> false
                                   | _ -> true)
                   | _ -> true) then
         (let lim9 = (match (if map_has ivars (str_of_int id ++ "@eargs") then map_get ivars (str_of_int id ++ "@eargs") else VNil) with
                      | VArr aid9 -> (match deref aid9 with Cons (a9, _) -> a9 | _ -> VNil)
                      | _ -> VNil) in
          raise_exc world "ArgumentError" ("comparison of Integer with " ++ conv_name lim9 ++ " failed"))
       // ⚠ only a STRING's #upto is unknowable -- it walks succ until it
       // passes the limit. An Integer's counts exactly, and naming the METHOD
       // rather than the receiver made `1.upto(3).size` nil as well.
       else if (match (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else VNil) with
                | VStr mh -> str_eq (sget mh) "upto"
                | _ -> false)
               && (match (if map_has ivars (str_of_int id ++ "@recv") then map_get ivars (str_of_int id ++ "@recv") else VNil) with
                   | VStr _ -> true
                   | _ -> false) then VNil
       // ...and so does a STRING range, whose length ruby will not compute:
       // `("A".."E").step(2).size` is nil, and `("A".."E").step("A")` -- legal
       // since 3.4 -- never ends, so materialising to count is not an option
       // either (it took the process out with it).
       else if (match (if map_has ivars (str_of_int id ++ "@recv") then map_get ivars (str_of_int id ++ "@recv") else VNil) with
                | VRange (VStr _, _, _) -> true
                | _ -> false) then VNil
       // a gsub/gsub! enumerator's size is nil (ruby cannot know it without
       // running the matches). bsearch / bsearch_index are the same kind of
       // answer: how many times they yield depends on what the block says, so
       // ruby reports UNKNOWN rather than the number materialising happens to
       // produce (and materialising here now raises, since a collecting block
       // does not answer the comparison bsearch demands).
       else if (match (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else VNil) with
                | VStr mh -> str_eq (sget mh) "gsub" || str_eq (sget mh) "gsub!"
                             || str_eq (sget mh) "bsearch" || str_eq (sget mh) "bsearch_index"
                | _ -> false) then VNil
       // each_codepoint / codepoints know their size without running: the
       // string's character count (materialising would RAISE on a string
       // with an invalid byte, where ruby's #size still answers).
       else if (match (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else VNil) with
                | VStr mh -> str_eq (sget mh) "each_codepoint" || str_eq (sget mh) "codepoints"
                | _ -> false)
               && (match (if map_has ivars (str_of_int id ++ "@recv") then map_get ivars (str_of_int id ++ "@recv") else VNil) with
                   | VStr _ -> true | _ -> false) then
         (match map_get ivars (str_of_int id ++ "@recv") with
          | VStr rh -> VInt (str_rblen rh)
          | _ -> VNil)
       // a per-element yielder over a HASH knows its size without running --
       // and MUST not run: materialising `h.transform_values!` would perform
       // the transformation, so asking its size changed the hash.
       else if (match (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else VNil) with
                | VStr mh -> (let m9 = sget mh in
                              str_eq m9 "transform_values" || str_eq m9 "transform_values!"
                              || str_eq m9 "transform_keys" || str_eq m9 "transform_keys!"
                              || str_eq m9 "each_key" || str_eq m9 "each_value"
                              || str_eq m9 "each_pair" || str_eq m9 "delete_if" || str_eq m9 "keep_if")
                | _ -> false)
               && (match (if map_has ivars (str_of_int id ++ "@recv") then map_get ivars (str_of_int id ++ "@recv") else VNil) with
                   | VHsh _ -> true | _ -> false) then
         (match map_get ivars (str_of_int id ++ "@recv") with
          | VHsh rh9 -> VInt (hash_len (hderef rh9))
          | _ -> VNil)
       // an enumerator over a RANGE knows its size the way the range does:
       // arithmetic for integer bounds (Infinity when endless), nil for a
       // non-numeric range -- `("a".."c").each.size` is nil, not 3, and so is
       // `("a".."z").reverse_each.size`. Materialising answered the count of
       // what a walk happened to produce.
       else if (match (if map_has ivars (str_of_int id ++ "@recv") then map_get ivars (str_of_int id ++ "@recv") else VNil) with
                | VRange (_, _, _) -> true | _ -> false)
               && (match (if map_has ivars (str_of_int id ++ "@meth") then map_get ivars (str_of_int id ++ "@meth") else VNil) with
                   | VStr mh -> str_eq (sget mh) "each" || str_eq (sget mh) "reverse_each"
                   | _ -> false) then
         (match map_get ivars (str_of_int id ++ "@recv") with
          | VRange (lo9, hi9, ex9) ->
            // #each starts at the begin and #reverse_each at the end, so the
            // missing bound that makes each of them impossible is the other
            // one: `(..3).each.size` is a TypeError and `(..5).reverse_each
            // .size` is Infinity, and vice versa for `(1..)`.
            (let rev9 = (match map_get ivars (str_of_int id ++ "@meth") with VStr mh -> str_eq (sget mh) "reverse_each" | _ -> false) in
             let lo_open9 = (match lo9 with VNil -> true | _ -> false) in
             let hi_open9 = rng_hi_open hi9 || (match hi9 with VNil -> true | _ -> false) in
             if rev9 && hi_open9 then raise_exc world "TypeError" "can't iterate from NilClass"
             else if (if rev9 then false else true) && lo_open9 then raise_exc world "TypeError" "can't iterate from NilClass"
             else
               (match lo9 with
                | VInt _ -> (if hi_open9 then VFlt (1.0 / 0.0) else rng_int_span (rng_int_side lo9) (rng_int_top hi9 ex9))
                | VBig _ -> (if hi_open9 then VFlt (1.0 / 0.0) else rng_int_span (rng_int_side lo9) (rng_int_top hi9 ex9))
                // beginless, asked from the END (reverse_each): an Integer end
                // counts down forever; anything else names the end's class
                | VNil -> (match hi9 with
                           | VInt _ -> VFlt (1.0 / 0.0)
                           | VBig _ -> VFlt (1.0 / 0.0)
                           | _ -> raise_exc world "TypeError" ("can't iterate from " ++ class_name hi9))
                | VFlt _ -> raise_exc world "TypeError"
                              ("can't iterate from " ++ (if rng_is_int hi9 then "Integer" else "Float"))
                | _ -> VNil))
          | _ -> VNil)
       else
         (match enum_to_arr env world blk id with
          | VArr aid2 -> VInt (val_list_len (deref aid2))
          | _ -> VNil))
    // Enumerator without a block: enum methods materialize the elements and
    // delegate to the array implementation.
    else if is_enum_cls cls
            && (if str_eq name "first" || str_eq name "take" then false else true)
            && (is_enum_method name || str_eq name "each_with_index" ||
                str_eq name "drop" || str_eq name "each_slice" || str_eq name "each_cons") then
      (let av = enum_to_arr env world blk id in
       invoke_val_c env world blk av name args vischeck)
    // external iteration (re-drive style: the enumerator is re-run, bounded
    // to pos+1 elements, and indexed by @__e_pos — O(n^2) overall but correct
    // for pure sources, and safe for infinite generators).
    else if is_enum_cls cls && (str_eq name "next" || str_eq name "peek" || str_eq name "rewind") then
      (if str_eq name "rewind" then
         (let _ = map_set ivars (str_of_int id ++ "@__e_pos") (VInt 0) in
          // ...and the buffer with it, so a source that can be walked again is.
          let _ = (if map_has ivars (str_of_int id ++ "@__e_buf")
                   then map_delete ivars (str_of_int id ++ "@__e_buf") else ()) in
          recv)
       else
         let pos = (if map_has ivars (str_of_int id ++ "@__e_pos") then (match map_get ivars (str_of_int id ++ "@__e_pos") with VInt k -> k | _ -> 0) else 0) in
         // ⚠ DRIVE THE SOURCE ONCE and keep what it produced. This re-ran it
         //   from the start for every #next, taking pos+1 elements and reading
         //   the last -- right only for a source with no state. A source that
         //   ADVANCES (csv's parser walks a StringScanner) carries on from
         //   where the previous run left it, so the elements between runs are
         //   never seen: a six-element generator answered 1, 3, 6 for three
         //   #next calls instead of 1, 2, 3, and CSV.parse returned every
         //   other row.
         //   ⚠ the cost is that an INFINITE enumerator cannot be stepped: it is
         //   materialised here and never comes back. Real external iteration
         //   needs a coroutine, and this interpreter's Fiber runs its body to
         //   completion, so there is nothing to suspend.
         let bk = str_of_int id ++ "@__e_buf" in
         let av = (if map_has ivars bk then map_get ivars bk
                   else (let a9 = enum_to_arr env world blk id in
                         let _ = map_set ivars bk a9 in a9)) in
         let xs = (match av with VArr aid -> deref aid | _ -> Nil) in
         if pos >= val_list_len xs then raise_exc world "StopIteration" "iteration reached an end"
         else
           let v = val_nth xs pos in
           let _ = (if str_eq name "next" then map_set ivars (str_of_int id ++ "@__e_pos") (VInt (pos + 1)) else ()) in
           v)
    // with_index(offset = 0) without a block: an Enumerator of [elem, i+offset]
    // pairs; with_object handled by the with-block dispatcher.
    else if is_enum_cls cls && (str_eq name "with_index" || str_eq name "each_with_index") && (let (h9, _, _, _) = blk in (if h9 then false else true)) then
      (let off = (match args with Cons (VInt o, _) -> o | _ -> 0) in
       let av = enum_to_arr env world blk id in
       (match av with
        | VArr aid2 -> (let _ = () in make_enum world (arr_new (with_index_pairs_off (deref aid2) off)) "each")
        | _ -> VNil))
    // next_values / peek_values: like next/peek but every yield is an array.
    else if is_enum_cls cls && (str_eq name "next_values" || str_eq name "peek_values") then
      (let pos = (if map_has ivars (str_of_int id ++ "@__e_pos") then (match map_get ivars (str_of_int id ++ "@__e_pos") with VInt k -> k | _ -> 0) else 0) in
       let av = enum_take_m env world blk id (pos + 1) true in
       let xs = (match av with VArr aid -> deref aid | _ -> Nil) in
       if pos >= val_list_len xs then raise_exc world "StopIteration" "iteration reached an end"
       else
         let v = val_nth xs pos in
         let _ = (if str_eq name "next_values" then map_set ivars (str_of_int id ++ "@__e_pos") (VInt (pos + 1)) else ()) in
         v)
    // first / take are bounded (usable on infinite generators).
    else if is_enum_cls cls && (str_eq name "first" || str_eq name "take") then
      (let n = (match args with Cons (VInt k, _) -> k | _ -> 1) in
       let av = enum_take env world blk id n in
       if str_eq name "take" then av
       else (match args with
             | Cons (VInt _, _) -> av
             | _ -> (match av with VArr aid -> val_nth (deref aid) 0 | _ -> VNil)))
    // UnboundMethod: bind / bind_call and the reflection getters.
    else if str_eq cls "UnboundMethod" then
      (let ucls = (match map_get ivars (str_of_int id ++ "@__um_cls") with VStr h -> sget h | _ -> "") in
       let unm = (match map_get ivars (str_of_int id ++ "@__um_name") with VStr h -> sget h | _ -> "") in
       if str_eq name "bind" || str_eq name "bind_call" then
         (let target = (match args with Cons (v, _) -> v | _ -> VNil) in
          let tcls = dispatch_cls_of world target in
          // a method owned by a Module (not a Class) binds to ANY object;
          // a class method requires the target to be kind_of that class.
          // ...and a method taken from a class's SINGLETON binds to that
          // class's subclasses: `Parent.singleton_class.instance_method(:m)`
          // binds to Child, because Child's singleton inherits from Parent's.
          // The check compared "(sng:Parent)" against Child's own class name
          // and refused a binding ruby allows.
          let ok = (if map_has modules ucls then true
                    else if is_sng_cls ucls then
                      (match target with
                       | VClass tc9 -> obj_is_a world ("(sng:" ++ tc9 ++ ")") ucls || str_eq ("(sng:" ++ tc9 ++ ")") ucls
                       | _ -> obj_is_a world tcls ucls)
                    else (match target with
                          | VObj tid -> obj_is_a world (map_get ocls tid) ucls
                          | _ -> obj_is_a world (class_name target) ucls || str_eq (class_name target) ucls)) in
          if ok then
            (if str_eq name "bind" then mk_bound_method world target ucls unm
             else (match args with
                   | Cons (_, rest) -> invoke_val_c env world blk target unm rest false
                   | _ -> VNil))
          else raise_exc world "TypeError" ("bind argument must be an instance of " ++ ucls))
       else if str_eq name "name" then VSym unm
       else if str_eq name "owner" then
         VClass (if map_has ivars (str_of_int id ++ "@__um_owner")
                 then (match map_get ivars (str_of_int id ++ "@__um_owner") with
                       | VStr h9 -> sget h9
                       | _ -> ucls)
                 else ucls)
       else if str_eq name "source_location" then meth_source_location world ucls unm VNil
       else if str_eq name "arity" then VInt (bm_arity world ucls unm)
       else if str_eq name "parameters" then bm_params world ucls unm
       // original_name: the name this method was DEFINED as, which differs from
       // #name only for an alias -- and alias_srcname already records that pair
       // (it exists so that `super` inside an aliased method searches for the
       // source name). Reading it here rather than keeping a second table.
       else if str_eq name "original_name" then
         VSym (original_name_of world ucls unm)
       // super_method: the same name found further up the ancestors, as an
       // UnboundMethod, or nil when this is the topmost definition.
       else if str_eq name "super_method" then
         // ⚠ the name looked for above the owner is the ORIGINAL one, not the
         //   one this handle is called by: an alias made from an inherited
         //   method has no entry under its own name anywhere above, so the
         //   walk found nothing and answered nil where ruby answers the method
         //   the alias was made from. Asked of ruby in four shapes -- an alias
         //   of an inherited method, of an own method with and without a
         //   super, and a plain method -- one rule explains all four: look up
         //   ORIGINAL NAME strictly above the OWNER.
         (let anc = ancestors_of world ucls in
          let unm = original_name_of world ucls unm in
          let above = lookup_anc_above world anc ucls unm in
          if str_eq above "" then
            // ...and the BUILTIN above it: `String.instance_method(:to_s)`
            // answers Kernel#to_s in ruby, because #to_s is Kernel's and
            // String merely overrides it. The method table holds no builtin,
            // so the only ones to look for are the universal names, whose home
            // is Kernel.
            (if is_prim_method unm && (if str_eq ucls "Kernel" then false else true)
                && anc_has anc "Kernel"
             then make_unbound_method world "Kernel" unm
             else VNil)
          else make_unbound_method world above unm)
       // clone: a Method object is immutable here, so a copy is a fresh handle
       // onto the same (class, name) pair -- which is what ruby's clone gives
       // for one (== is by owner and name, and the specs compare that way).
       else if str_eq name "clone" || str_eq name "dup" then
         // a NEW UnboundMethod, carrying the frozen status only for #clone
         (let nid = alloc_oid ocls in
          let _ = map_set ocls nid "UnboundMethod" in
          let _ = map_set ivars (str_of_int nid ++ "@__um_cls") (mkstr ucls) in
          let _ = map_set ivars (str_of_int nid ++ "@__um_name") (mkstr unm) in
          let _ = (if str_eq name "clone" && ofrozen_get id then ofrozen_set nid else ()) in
          VObj nid)
       else if str_eq name "freeze" then (let _ = ofrozen_set id in recv)
       else if str_eq name "hash" then VInt (val_hash (mkstr (ucls ++ "#" ++ defined_as_name world ucls unm)))
       else if str_eq name "frozen?" then VBool (ofrozen_get id)
       // ...and the identity questions every object answers: #dup makes a NEW
       // one, and `dup.equal?(m)` is how a spec says so
       else if str_eq name "equal?" then
         (match args with Cons (VObj o2, _) -> VBool (o2 == id) | _ -> VBool false)
       else if str_eq name "object_id" || str_eq name "__id__" then VInt (1000000 + id * 8)
       else if str_eq name "inspect" || str_eq name "to_s" then
         // the OWNER, not the class it was extracted from: a method reached
         // through a class but defined in a module reads as the module's
         (let own9 = (let a9 = lookup_anc world (ancestors_of world ucls) unm in
                      if str_eq a9 "" then ucls else a9) in
          mkstr (meth_inspect_str world "UnboundMethod" own9 unm
                   (bm_params world ucls unm) (meth_source_location world ucls unm VMain)))
       else if str_eq name "==" || str_eq name "eql?" then
         // two names for one builtin implementation are one method, so compare
         // through canon_alias (String#size == String#length).
         (match args with
          | Cons (VObj oid2, _) ->
            VBool (str_eq (map_get ocls oid2) "UnboundMethod"
                   && str_eq (to_s (map_get ivars (str_of_int oid2 ++ "@__um_cls"))) ucls
                   && str_eq (defined_as_name world ucls (to_s (map_get ivars (str_of_int oid2 ++ "@__um_name"))))
                             (defined_as_name world ucls unm))
          | _ -> VBool false)
       // the universal names, same reason as the ThreadGroup arm above (this
       // one refused `nil?` and `itself`).
       else if is_prim_method name then dispatch_prim env world blk recv name args false
       else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of UnboundMethod"))
    // Encoding objects: name/to_s give the label, inspect is #<Encoding:name>.
    // an exception object answers #message / #to_s with its @message (the
    // class name when none was given), and #inspect as "#<Class: message>"
    // (bare "#<Class>" only when the message equals the class name, matching
    // CRuby's Exception#inspect).
    // Exception#backtrace / set_backtrace / backtrace_locations: mere has no
    // call-stack capture, so backtrace is nil until set; set_backtrace stores
    // and returns the value (enough for specs that compare backtraces).
    else if str_eq name "backtrace" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (if map_has ivars (str_of_int id ++ "@__bt") then map_get ivars (str_of_int id ++ "@__bt") else VNil)
    else if str_eq name "set_backtrace" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (match args with Cons (v, _) -> let _ = map_set ivars (str_of_int id ++ "@__bt") v in v | _ -> VNil)
    else if str_eq name "backtrace_locations" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then VNil
    // LoadError#path / SyntaxError#path on an exception OBJECT: whatever was
    // recorded, nil otherwise. (The loader raises the pair representation, and
    // that path is answered from the message elsewhere -- two representations,
    // one question, and neither may shadow the other.)
    else if str_eq name "path" && (exc_is_a world cls "LoadError" || exc_is_a world cls "SyntaxError")
            && (if has_meth world cls name then false else true) then
      (if map_has ivars (str_of_int id ++ "@__path") then map_get ivars (str_of_int id ++ "@__path") else VNil)
    // Exception#exception: self with no argument, and a COPY carrying the new
    // message with one. This is the method half of the protocol raise uses on a
    // non-exception object (make_exc_w); ruby exposes both, and `raise exc, msg`
    // goes through this one.
    else if str_eq name "exception" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (match args with
       | Nil -> recv
       | Cons (VNil, _) -> recv
       | Cons (m, _) ->
         // ⚠ this is a COPY of the receiver with a new message, "without
         //   reinitializing" (ruby's own words in the spec): every ivar rides
         //   along. Building a fresh instance and setting only the message and
         //   the backtrace dropped the state the exception's own initialize had
         //   put there -- a CustomArgumentError lost its @val.
         (let nid = alloc_oid ocls in
          let _ = map_set ocls nid cls in
          let oldp9 = str_of_int id ++ "@" in
          let newp9 = str_of_int nid ++ "@" in
          let tmp9 = map_new () in
          let _ = map_iter ivars (fn (k9: str) -> fn (v9: Val) ->
                    if str_len k9 > str_len oldp9 && str_eq (substring k9 0 (str_len oldp9)) oldp9
                    then map_set tmp9 (newp9 ++ substring k9 (str_len oldp9) (str_len k9)) v9
                    else ()) in
          let _ = map_iter tmp9 (fn (k9: str) -> fn (v9: Val) -> map_set ivars k9 v9) in
          let _ = map_set ivars (str_of_int nid ++ "@message") m in
          VObj nid))
    // Numeric#+@ and #-@ are real methods of Numeric, so a SUBCLASS of it
    // inherits them: `+obj` is obj, and `-obj` is `0 - obj`, which goes through
    // the subclass's own #coerce. They used to be answered for every receiver
    // in the world by a catch-all that returned the receiver -- which made #+@
    // right by luck and #-@ silently wrong (it answered 100 for -100).
    else if (str_eq name "+@" || str_eq name "-@") && obj_is_a world cls "Numeric"
            && (if has_meth world cls name then false else true) then
      (if str_eq name "+@" then recv else eval_bin_prim env world blk "-" (VInt 0) recv)
    // The rest of Numeric's own instance methods, on the same terms: a SUBCLASS
    // of Numeric that defines none of them inherits these. They are here and not
    // in the ruby prelude because a prelude `class Numeric` would sit AHEAD of
    // Integer's and Float's builtins in the walk -- `1.integer?` would answer
    // Numeric's `false`.
    //   #integer? is false and #real? is true for a Numeric that is not an
    //   Integer; #real is the receiver.
    //   A Numeric is immutable, so #clone and #dup are the receiver itself, and
    //   `clone(freeze: false)` is the refusal every always-frozen value gives.
    //   #div refuses a zero divisor BEFORE asking self#/ (ruby's num_div), which
    //   is what makes div(0), div(0.0) and div(Complex(0,0)) all ZeroDivisionError
    //   rather than whatever the subclass's own #/ would answer.
    // ...and the rest of them, on the same terms and for the same reason: they
    // are DERIVED from the subclass's own operators, which is how ruby's
    // Numeric answers. A user subclass of Numeric got NoMethodError for
    // twenty-five names it inherits -- eight of ruby/spec's core/numeric files
    // ask for exactly these, and they could not even be seen until the shim
    // could install a mock on an ordinary object.
    else if obj_is_a world cls "Numeric" && (if has_meth world cls name then false else true)
            && (str_eq name "abs" || str_eq name "magnitude" || str_eq name "abs2"
                || str_eq name "arg" || str_eq name "angle" || str_eq name "phase"
                || str_eq name "conj" || str_eq name "conjugate"
                || str_eq name "negative?" || str_eq name "positive?"
                || str_eq name "zero?" || str_eq name "nonzero?"
                || str_eq name "to_int" || str_eq name "finite?" || str_eq name "infinite?"
                || str_eq name "imag" || str_eq name "imaginary"
                || str_eq name "rect" || str_eq name "rectangular" || str_eq name "polar"
                || str_eq name "i" || str_eq name "to_c"
                || str_eq name "ceil" || str_eq name "floor" || str_eq name "round"
                || str_eq name "truncate" || str_eq name "fdiv"
                || str_eq name "modulo" || str_eq name "divmod" || str_eq name "remainder"
                || str_eq name "quo" || str_eq name "coerce") then
      (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
       let call1 = fn (nm: str) -> fn (a: Val) -> invoke_val_c env world nb9 recv nm (Cons (a, Nil)) false in
       let call0 = fn (nm: str) -> invoke_val_c env world nb9 recv nm Nil false in
       // `self < 0` is the one question most of these are built on, and it goes
       // through the receiver's own #<=> (or #<) exactly as ruby's does.
       let isneg = fn (u: unit) -> truthy (call1 "<" (VInt 0)) in
       let arg1 = (match args with Cons (a9, _) -> a9 | Nil -> VNil) in
       let need1 = fn (u: unit) ->
         (match args with
          | Nil -> (let _ = raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)" in VNil)
          | _ -> VNil) in
       if str_eq name "abs" || str_eq name "magnitude" then
         (if isneg () then call0 "-@" else recv)
       else if str_eq name "abs2" then call1 "*" recv
       else if str_eq name "arg" || str_eq name "angle" || str_eq name "phase" then
         (if isneg () then VFlt 3.141592653589793 else VInt 0)
       else if str_eq name "conj" || str_eq name "conjugate" then recv
       else if str_eq name "negative?" then VBool (isneg ())
       else if str_eq name "positive?" then VBool (truthy (call1 ">" (VInt 0)))
       // ⚠ `self == 0` through rb_eq_w, not through a DISPATCH of `==`: a
       //   subclass that defines none gets Object#== (false), and dispatching
       //   the name raised "undefined method '=='" for `zero?` on ruby/spec's
       //   own fixture, which defines nothing but singleton_method_added.
       //   rb_eq_w still reaches a subclass's own #== when it has one.
       else if str_eq name "zero?" then VBool (rb_eq_w env world recv (VInt 0))
       // ⚠ #nonzero? asks self's own #zero? -- ruby's num_nonzero calls it, and
       //   the spec mocks it. Computing the equality inline here never called
       //   the method the example was watching for.
       else if str_eq name "nonzero?" then
         (if truthy (call0 "zero?") then VNil else recv)
       else if str_eq name "to_int" then call0 "to_i"
       else if str_eq name "finite?" then VBool true
       else if str_eq name "infinite?" then VNil
       else if str_eq name "imag" || str_eq name "imaginary" then VInt 0
       else if str_eq name "rect" || str_eq name "rectangular" then
         arr_new (Cons (recv, Cons (VInt 0, Nil)))
       else if str_eq name "polar" then
         arr_new (Cons ((if isneg () then call0 "-@" else recv),
                        Cons ((if isneg () then VFlt 3.141592653589793 else VInt 0), Nil)))
       else if str_eq name "i" then VCpx (VInt 0, recv)
       else if str_eq name "to_c" then VCpx (recv, VInt 0)
       // the rounding family is the FLOAT's, which is what ruby's Numeric does
       // (num_ceil and friends are `to_f.ceil`).
       else if str_eq name "ceil" || str_eq name "floor" || str_eq name "round" || str_eq name "truncate" then
         (let f9 = call0 "to_f" in invoke_val_c env world nb9 f9 name args false)
       else if str_eq name "fdiv" then
         (let _ = need1 () in
          let a9 = invoke_val_c env world nb9 arg1 "to_f" Nil false in
          let s9 = call0 "to_f" in
          invoke_val_c env world nb9 s9 "/" (Cons (a9, Nil)) false)
       else if str_eq name "modulo" then (let _ = need1 () in call1 "%" arg1)
       else if str_eq name "divmod" then
         (let _ = need1 () in
          arr_new (Cons (call1 "div" arg1, Cons (call1 "%" arg1, Nil))))
       // #quo is the EXACT division: `to_r / other`, and the conversion has to
       // answer a Rational or ruby refuses.
       else if str_eq name "quo" then
         (let _ = need1 () in
          let r9 = call0 "to_r" in
          // ...a RATIONAL and nothing else: `to_r` answering the Integer 1 is a
          // TypeError in ruby, which is what the spec asks for.
          match r9 with
          | VRat (_, _) -> invoke_val_c env world nb9 r9 "/" (Cons (arg1, Nil)) false
          | _ -> raise_exc world "TypeError"
                   ("can't convert " ++ display_cls_msg world (dispatch_cls_of world recv) ++ " into Rational"))
       // #coerce pairs them: the SAME class answers [other, self] untouched,
       // anything else is both sides through #to_f.
       else if str_eq name "coerce" then
         (let _ = need1 () in
          if str_eq (dispatch_cls_of world arg1) cls
          then arr_new (Cons (arg1, Cons (recv, Nil)))
          else
            // ...through the Float() CONVERSION, not a bare #to_f dispatch:
            // that is what refuses nil, false and a Symbol with a TypeError
            // and a non-numeric String with an ArgumentError, which is five of
            // this spec's ten examples. It still reaches a mock's #to_f.
            (let of9 = kernel_float env world (Cons (arg1, Nil)) in
             let sf9 = kernel_float env world (Cons (recv, Nil)) in
             arr_new (Cons (of9, Cons (sf9, Nil)))))
       // #remainder keeps the DIVIDEND's sign where #% keeps the divisor's, so
       // it differs from the modulo by one |divisor| when the two disagree.
       // ⚠ the two signs are asked of the RECEIVER and the argument with #< and
       //   #>, which is what ruby's num_remainder does and what the spec mocks.
       else
         (let _ = need1 () in
          // ⚠ a NON-Numeric argument is coerced first -- ruby asks
          //   `other.coerce(self)` and works with the pair it answers, which
          //   is what this spec's `before` block sets up. Skipping it left the
          //   mock's #coerce unreceived.
          let (recv, arg1) =
            (if obj_is_a world (dispatch_cls_of world arg1) "Numeric" || is_num arg1 || is_cpx arg1
             then (recv, arg1)
             else
               (match invoke_val_c env world nb9 arg1 "coerce" (Cons (recv, Nil)) false with
                | VArr aid7 ->
                  (match deref aid7 with
                   | Cons (a7, Cons (b7, _)) -> (a7, b7)
                   | _ -> (recv, arg1))
                | _ -> (recv, arg1))) in
          let call1 = fn (nm: str) -> fn (a: Val) -> invoke_val_c env world nb9 recv nm (Cons (a, Nil)) false in
          let m9 = call1 "%" arg1 in
          // ⚠ the zero test is `z == 0`, and the four sign questions are asked
          //   LAZILY, in ruby's order: (x<0 && y>0) || (x>0 && y<0). Computing
          //   all four up front asked #> on a receiver whose example never
          //   mocked it -- the spec is written around exactly which questions
          //   get asked, so the short circuits are part of the behaviour.
          let other_gt0 = fn (u: unit) ->
            truthy (invoke_val_c env world nb9 arg1 ">" (Cons (VInt 0, Nil)) false) in
          let other_lt0 = fn (u: unit) ->
            truthy (invoke_val_c env world nb9 arg1 "<" (Cons (VInt 0, Nil)) false) in
          if truthy (invoke_val_c env world nb9 m9 "==" (Cons (VInt 0, Nil)) false) then m9
          else if (if truthy (call1 "<" (VInt 0)) then other_gt0 () else false)
                  || (if truthy (call1 ">" (VInt 0)) then other_lt0 () else false)
          then invoke_val_c env world nb9 m9 "-" (Cons (arg1, Nil)) false
          else m9))
    else if obj_is_a world cls "Numeric" && (if has_meth world cls name then false else true)
            && (str_eq name "integer?" || str_eq name "real?" || str_eq name "real"
                || str_eq name "div" || str_eq name "clone" || str_eq name "dup") then
      (if str_eq name "integer?" then VBool false
       else if str_eq name "real?" then VBool true
       else if str_eq name "real" then recv
       else if str_eq name "div" then
         (match args with
          | Cons (o9, _) ->
            (if rb_eq_w env world (VInt 0) o9 then raise_exc world "ZeroDivisionError" "divided by 0"
             else
               let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
               let q9 = invoke_val_c env world nb9 recv "/" (Cons (o9, Nil)) false in
               invoke_val_c env world nb9 q9 "floor" Nil false)
          | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)")
       else
         // clone / dup
         (let unfreeze9 = str_eq name "clone" &&
            (match args with
             | Cons (VHsh h9, _) ->
               (match hash_lookup (hderef h9) (VSym "freeze") with
                | (true, VBool false) -> true
                | _ -> false)
             | _ -> false) in
          if unfreeze9
          then raise_exc world "ArgumentError" ("can't unfreeze " ++ (let oc9 = map_get ocls id in
                                                                      if is_sng_cls oc9 then cls else oc9))
          else recv))
    // Exception#== : same class, equal message, and equal backtrace.
    else if (str_eq name "==" || str_eq name "eql?") && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (match args with
       | Cons (VObj oid2, _) ->
         (let cls2 = map_get ocls oid2 in
          if str_eq cls cls2 && exc_is_a world cls2 "Exception" then
            let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
            let m1 = invoke_val_c env world noblk recv "message" Nil false in
            let m2 = invoke_val_c env world noblk (VObj oid2) "message" Nil false in
            let b1 = (if map_has ivars (str_of_int id ++ "@__bt") then map_get ivars (str_of_int id ++ "@__bt") else VNil) in
            let b2 = (if map_has ivars (str_of_int oid2 ++ "@__bt") then map_get ivars (str_of_int oid2 ++ "@__bt") else VNil) in
            VBool (rb_eq m1 m2 && rb_eq b1 b2)
          else VBool false)
       | _ -> VBool false)
    else if (str_eq name "==" || str_eq name "eql?") && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (match args with
       | Cons (VObj oid2, _) ->
         (let cls2 = map_get ocls oid2 in
          if str_eq cls cls2 && exc_is_a world cls2 "Exception" then
            let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
            let m1 = invoke_val_c env world noblk recv "message" Nil false in
            let m2 = invoke_val_c env world noblk (VObj oid2) "message" Nil false in
            VBool (rb_eq m1 m2)
          else VBool false)
       | _ -> VBool false)
    // Exception#to_s: @message (class name when nil). This is the default;
    // a user #to_s override is dispatched before reaching here.
    else if str_eq name "to_s" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (match (if map_has ivars (str_of_int id ++ "@message") then map_get ivars (str_of_int id ++ "@message") else VNil) with
       | VNil -> mkstr (display_cls world cls)
       | VStr h -> VStr h
       // a non-String message is stringified via its own #to_s.
       | m -> (match invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) m "to_s" Nil false with
               | VStr h -> VStr h | other -> mkstr (to_s other)))
    // Exception#message is defined as #to_s in CRuby, so an overridden #to_s
    // flows through — dispatch to to_s rather than reading @message directly.
    else if str_eq name "message" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) recv "to_s" Nil false
    // Exception#cause: the exception that was IN FLIGHT when this one was raised,
    // which ruby records at raise time. Recorded here for an exception OBJECT (a
    // `@__cause` ivar written where the raise happens); the lightweight
    // class-and-message representation has nowhere to keep one, so it answers
    // nil -- which is also ruby's answer whenever nothing was in flight, the
    // common case. bundler's friendly_errors reads it on every error.
    else if str_eq name "cause" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (match recv with
       | VObj eid -> (let (_, _, _, iv9) = world in
                      if map_has iv9 (str_of_int eid ++ "@__cause") then map_get iv9 (str_of_int eid ++ "@__cause") else VNil)
       | _ -> VNil)
    // Exception#detailed_message / #full_message: the report ruby prints for an
    // uncaught exception, and the first line of it on its own. Both honour
    // highlight: and order:, which used to be accepted and ignored -- and the
    // ignoring was invisible, because the un-highlighted form is a PREFIX of
    // nothing and a caller could only tell by looking for escapes.
    else if str_eq name "detailed_message" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      mkstr (exc_detailed_msg env world recv (kw_flag args "highlight" false))
    else if str_eq name "full_message" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      mkstr (exc_full_message env world recv args (kw_flag args "highlight" false)
               (str_eq (kw_sym args "order" "top") "bottom"))
    // Exception#inspect: uses #to_s for the message text. Empty -> just the
    // class name (no #<>); otherwise "#<Class: to_s>".
    else if str_eq name "inspect" && exc_is_a world cls "Exception" && (if has_meth world cls name then false else true) then
      (let disp = display_cls world cls in
       let msgv = invoke_val_c env world (false, (Nil : str list), (Nil : Stmt list), env) recv "to_s" Nil false in
       let msg = (match msgv with VStr h -> sget h | VNil -> disp | other -> to_s other) in
       if str_eq msg "" then mkstr disp
       else mkstr ("#<" ++ disp ++ ": " ++ msg ++ ">"))
    else if str_eq cls "MatchData" &&
            (str_eq name "pre_match" || str_eq name "post_match" ||
             str_eq name "begin" || str_eq name "end" || str_eq name "string" ||
             str_eq name "offset" || str_eq name "byteoffset" ||
             str_eq name "bytebegin" || str_eq name "byteend" ||
             str_eq name "match" || str_eq name "match_length") then
      (let src = (if map_has ivars (str_of_int id ++ "@__src") then (match map_get ivars (str_of_int id ++ "@__src") with VStr h -> sget h | _ -> "") else "") in
       let st = (if map_has ivars (str_of_int id ++ "@__st") then (match map_get ivars (str_of_int id ++ "@__st") with VInt n -> n | _ -> 0) else 0) in
       let en = (if map_has ivars (str_of_int id ++ "@__en") then (match map_get ivars (str_of_int id ++ "@__en") with VInt n -> n | _ -> 0) else 0) in
       let menc = (if map_has ivars (str_of_int id ++ "@__enc") then (match map_get ivars (str_of_int id ++ "@__enc") with VStr h9 -> sget h9 | _ -> "UTF-8") else "UTF-8") in
       if str_eq name "pre_match" then mkstr_e (substring src 0 st) menc
       else if str_eq name "post_match" then mkstr_e (substring src en (str_len src)) menc
       // #string is the SAME frozen String every time, as ruby's is: the
       // subject is not copied per call, so `m.string.equal?(m.string)` holds
       else if str_eq name "string" then
         (if map_has ivars (str_of_int id ++ "@__strobj") then map_get ivars (str_of_int id ++ "@__strobj")
          else (let v9 = mkstr_e src menc in
                let _ = (match v9 with VStr h9 -> sfrozen_set h9 | _ -> ()) in
                let _ = map_set ivars (str_of_int id ++ "@__strobj") v9 in v9))
       else
         // The argument is an EXPOSED index (0 = the whole match) or a group
         // NAME. Out of range is an IndexError rather than an answer, and a
         // group that did not participate answers nil -- this used to fall back
         // to group 0's span, so `(x)?(o)` reported the whole match's offsets
         // for the group that matched nothing.
         (let ns = md_num_list ivars id in
          let cnt = md_num_count ns in
          // an index may be anything that answers #to_int, as everywhere an
          // index is taken
          // A NAME addresses the FARTHEST participating group of that name --
          // the same rule #[] follows -- and anything that is not an index or a
          // name is asked for #to_int (a Rational answers 1).
          let idx = (match args with
                     | Cons (VInt g, _) -> g
                     | Cons (VSym nm, _) -> md_span_num ivars id nm
                     | Cons (VStr nh, _) -> md_span_num ivars id (sget nh)
                     | Cons (v9, _) ->
                       (match conv_try env world v9 "to_int" with
                        | VInt g -> g
                        | _ -> (match v9 with
                                | VFlt f9 -> int_of_float f9
                                | VRat (n9, d9) -> int_of_str n9 / int_of_str d9
                                // ...and something that converts to nothing is
                                // a TypeError rather than group 0
                                | _ -> (let _ = conv_err v9 "Integer" in 0)))
                     | _ -> 0) in
          let by_name = (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) in
          if idx == (0 - 2) then
            raise_exc world "IndexError"
              ("undefined group name reference: " ++ (match args with Cons (VSym nm, _) -> nm | Cons (VStr nh, _) -> sget nh | _ -> ""))
          else if (if by_name then false else true) && (idx < 0 || idx > cnt) then
            raise_exc world "IndexError" ("index " ++ str_of_int idx ++ " out of matches")
          else
            (let g = (if idx == 0 then 0 else if by_name then idx else md_num_at ns idx) in
             let kst = str_of_int id ++ "@__st" ++ str_of_int g in
             let ken = str_of_int id ++ "@__en" ++ str_of_int g in
             let has = g == 0 || (map_has ivars kst && map_has ivars ken) in
             let gst = (if g == 0 then st else (if map_has ivars kst then (match map_get ivars kst with VInt n -> n | _ -> st) else st)) in
             let gen = (if g == 0 then en else (if map_has ivars ken then (match map_get ivars ken with VInt n -> n | _ -> en) else en)) in
             let txt = (if g == 0 then (if map_has ivars (str_of_int id ++ "@0") then map_get ivars (str_of_int id ++ "@0") else VNil)
                        else (if map_has ivars (str_of_int id ++ "@" ++ str_of_int g) then map_get ivars (str_of_int id ++ "@" ++ str_of_int g) else VNil)) in
             if str_eq name "match" then txt
             else if str_eq name "match_length" then
               (match txt with VStr h -> VInt (utf8_len (sget h)) | _ -> VNil)
             else if (if has then false else true) then
               (if str_eq name "offset" || str_eq name "byteoffset" then arr_new (Cons (VNil, Cons (VNil, Nil))) else VNil)
             // #begin / #end / #offset count CHARACTERS; the byte* family
             // answers the byte positions the engine actually recorded.
             else if str_eq name "begin" then VInt (utf8_cidx src gst)
             else if str_eq name "end" then VInt (utf8_cidx src gen)
             else if str_eq name "bytebegin" then VInt gst
             else if str_eq name "byteend" then VInt gen
             else if str_eq name "byteoffset" then arr_new (Cons (VInt gst, Cons (VInt gen, Nil)))
             else arr_new (Cons (VInt (utf8_cidx src gst), Cons (VInt (utf8_cidx src gen), Nil))))))
    // MatchData#to_s is the WHOLE match, and #inspect shows it with its
    // groups. bootstraptest prints its results (`print(...)`, so to_s), and a
    // MatchData printed as "#<object>" is how this was noticed.
    else if str_eq cls "MatchData" && (str_eq name "to_s" || str_eq name "inspect") then
      (let whole = (if map_has ivars (str_of_int id ++ "@0")
                    then (match map_get ivars (str_of_int id ++ "@0") with VStr h -> sget h | _ -> "")
                    else "") in
       if str_eq name "to_s" then mkstr whole
       else mkstr ("#<MatchData " ++ inspect (mkstr whole) ++ md_insp_groups ivars id 1 ++ ">"))
    // MatchData#regexp: the pattern it came from, rebuilt from the key the
    // match recorded (flags, \x01, source -- the same key rx_progs is under).
    else if str_eq cls "MatchData" && str_eq name "regexp" then
      (let key = (if map_has ivars (str_of_int id ++ "@__key")
                  then (match map_get ivars (str_of_int id ++ "@__key") with VStr h -> sget h | _ -> "") else "") in
       let i = str_find_from key (chr 1) 0 in
       if i < 0 then VNil else VRegex (substring key (i + 1) (str_len key), substring key 0 i, ""))
    // #deconstruct is #captures, and #deconstruct_keys answers the named ones
    // as SYMBOL keys (nil = all of them; a name it does not have is simply not
    // in the answer, so a pattern match falls through rather than raising).
    else if str_eq cls "MatchData" && (str_eq name "deconstruct" || str_eq name "deconstruct_keys") then
      (if str_eq name "deconstruct" then arr_new (matchdata_arr ivars id 1)
       else
         (match args with
          | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)"
          | Cons (VNil, _) -> mkhash (md_dk_pairs world ivars id (md_names ivars id) (md_names ivars id))
          | Cons (VArr aid, _) ->
            // the keys must be Symbols: a String among them is a TypeError,
            // not a name that happens not to be there
            (let nms = md_names ivars id in
             let bad = md_first_non_sym (deref aid) in
             if (if str_eq bad "" then false else true) then
               raise_exc world "TypeError" ("wrong argument type " ++ bad ++ " (expected Symbol)")
             // more keys than the match HAS is an empty answer, before any of
             // them is looked at
             else if val_list_len (deref aid) > md_strs_len nms then mkhash Nil
             else mkhash (md_dk_pairs world ivars id nms (md_sym_names (deref aid))))
          | Cons (v9, _) ->
            raise_exc world "TypeError" ("wrong argument type " ++ class_name v9 ++ " (expected Array)")))
    // Two MatchData are equal when they are the same match: same pattern, same
    // subject, same spans. They were plain objects here, so `==` was identity.
    else if str_eq cls "MatchData" && (str_eq name "==" || str_eq name "eql?" || str_eq name "hash") then
      (if str_eq name "hash" then VInt (str_hash_go (md_sig ivars id) 0 7)
       else
         (match args with
          | Cons (VObj oid2, _) ->
            (let (_, _, ocls2, _) = world in
             VBool (str_eq (map_get ocls2 oid2) "MatchData"
                    && str_eq (md_sig ivars id) (md_sig ivars oid2)))
          | _ -> VBool false))
    // a copy is a new object carrying the same tables (the match is immutable,
    // so the copy is only ever read)
    else if str_eq cls "MatchData" && (str_eq name "dup" || str_eq name "clone") then
      (let nid = alloc_oid ocls in
       let (_, _, ocls3, iv3) = world in
       let _ = map_set ocls3 nid "MatchData" in
       let _ = (if map_has md_whole (str_of_int id) then map_set md_whole (str_of_int nid) (map_get md_whole (str_of_int id)) else ()) in
       let pfx = str_of_int id ++ "@" in
       let tmp = map_new () in
       let _ = map_iter iv3 (fn (k: str) -> fn (v: Val) ->
                 if str_len k > str_len pfx && str_eq (substring k 0 (str_len pfx)) pfx
                 then map_set tmp (str_of_int nid ++ "@" ++ substring k (str_len pfx) (str_len k)) v
                 else ()) in
       let _ = map_iter tmp (fn (k: str) -> fn (v: Val) -> map_set iv3 k v) in
       VObj nid)
    // MatchData#names / #named_captures: the pattern's named groups.
    else if str_eq cls "MatchData" && (str_eq name "names" || str_eq name "named_captures") then
      (let nms = md_names ivars id in
       if str_eq name "names" then arr_new (strs_to_vals nms)
       else
         // named_captures(symbolize_names: true) keys the hash with Symbols;
         // any truthy value asks for it, as ruby reads the option
         (let symz = (match args with
                      | Cons (VHsh h9, _) -> (match hash_lookup (hderef h9) (VSym "symbolize_names") with (true, v9) -> truthy v9 | _ -> false)
                      | _ -> false) in
          mkhash (md_named_pairs_k world ivars id nms symz)))
    else if str_eq cls "MatchData" && (str_eq name "[]" || str_eq name "to_a" || str_eq name "captures" || str_eq name "size" || str_eq name "length" || str_eq name "values_at") then
      (if str_eq name "values_at" then
         // a Range asks for a span of the exposed list, nil-filling past its end
         // every argument contributes: an index, a name, or a whole Range of
         // indices -- and they mix
         (let all = matchdata_arr ivars id 0 in
          arr_new (md_values_go world ivars id (md_expand_idxs env world all args) all))
       else if str_eq name "[]" then
         // like Array#[]: an index, a (start, length) pair, a Range, and a
         // negative index counting from the end of the group list
         (let all = matchdata_arr ivars id 0 in
          let n0 = val_list_len all in
          match args with
          | Cons (VInt a1, Cons (VInt len, _)) ->
            (let st = (if a1 < 0 then n0 + a1 else a1) in
             if st < 0 || st > n0 || len < 0 then VNil else arr_new (val_slice all st (st + len)))
          | Cons (VRange (lov, hiv, ex), _) ->
            (let (st, en) = rng_slice_bounds lov hiv ex n0 in
             if st < 0 || st > n0 then VNil else arr_new (val_slice all st en))
          | Cons (VInt n, _) ->
            // through the exposed list, not the raw group numbers: a pattern
            // with named groups has fewer entries than the engine numbered
            (let i2 = (if n < 0 then n0 + n else n) in
             if i2 < 0 || i2 >= n0 then VNil else val_nth all i2)
          // by NAME: `m[:scheme]` / `m["scheme"]`, resolved through the group
          // names recorded when the pattern was compiled.
          | Cons (VSym nm, _) -> md_by_name world ivars id nm
          | Cons (VStr nh, _) -> md_by_name world ivars id (sget nh)
          | _ -> VNil)
       else if str_eq name "size" || str_eq name "length" then
         VInt (val_list_len (matchdata_arr ivars id 0))
       else arr_new (matchdata_arr ivars id (if str_eq name "captures" then 1 else 0)))
    else if str_eq cls "Encoding" && (str_eq name "name" || str_eq name "to_s") then
      (if map_has ivars (str_of_int id ++ "@name") then map_get ivars (str_of_int id ++ "@name") else mkstr "")
    else if str_eq cls "Encoding" && str_eq name "inspect" then
      (let nm = (if map_has ivars (str_of_int id ++ "@name") then to_s (map_get ivars (str_of_int id ++ "@name")) else "") in
       mkstr ("#<Encoding:" ++ enc_display_name nm ++ (if enc_is_dummy nm then " (dummy)" else "") ++ ">"))
    // ---- Random instances -----------------------------------------------
    // Each carries its own generator id, so two of them seeded the same way
    // walk the same sequence and neither disturbs Kernel#rand.
    else if str_eq cls "Random" && (str_eq name "rand" || str_eq name "seed"
                                    || str_eq name "bytes" || str_eq name "==") then
      (let g9 = (if map_has ivars (str_of_int id ++ "@__gid")
                 then (match map_get ivars (str_of_int id ++ "@__gid") with VInt k9 -> k9 | _ -> 0) else 0) in
       let sd9 = (if map_has ivars (str_of_int id ++ "@__seed")
                  then map_get ivars (str_of_int id ++ "@__seed") else VInt 0) in
       if str_eq name "seed" then sd9
       // two Randoms are equal when they were seeded alike.
       else if str_eq name "==" then
         (match args with
          | Cons (VObj o2, _) ->
            (let c2 = map_get ocls o2 in
             if str_eq c2 "Random" && map_has ivars (str_of_int o2 ++ "@__seed")
             then VBool (match (sd9, map_get ivars (str_of_int o2 ++ "@__seed")) with
                          | (VInt x9, VInt y9) -> x9 == y9
                          | _ -> false)
             else VBool false)
          | _ -> VBool false)
       else if str_eq name "bytes" then
         (let n9 = (match args with Cons (VInt k9, _) -> k9 | _ -> 0) in
          // ⚠ FOUR bytes per draw, little-endian, which is how ruby fills a
          // buffer: taking one draw per byte would consume the stream four
          // times as fast and answer different bytes for the same seed.
          let rec go9 = fn (k: int) -> fn (acc: str) ->
            (if k <= 0 then acc
             else
               (let w9 = mt_genrand_int32 g9 in
                let take = (if k > 4 then 4 else k) in
                let rec emit9 = fn (b: int) -> fn (v: int) -> fn (a2: str) ->
                  (if b <= 0 then a2 else emit9 (b - 1) (bit_shr v 8) (a2 ++ chr (bit_and v 255))) in
                go9 (k - take) (emit9 take w9 acc))) in
          let r9 = mkstr (go9 n9 "") in
          (match r9 with VStr h9 -> (let _ = senc_set h9 "ASCII-8BIT" in r9) | _ -> r9))
       else
         // #rand: the same shapes Kernel#rand takes, on THIS generator.
         (match coerce_int_args env world args with
          | Cons (VInt n9, _) ->
            (if n9 <= 0 then raise_exc world "ArgumentError" ("invalid argument - " ++ str_of_int n9)
             else VInt (mt_rand_int g9 n9))
          | Cons (VFlt f9, _) ->
            (if f9 <= 0.0 then raise_exc world "ArgumentError" ("invalid argument - " ++ to_s (VFlt f9))
             else VFlt (mt_rand_real g9 * f9))
          | Cons (VRange (av9, bv9, ex9), _) ->
            (match (av9, bv9) with
             | (VInt a9, VInt b9) ->
               (let span9 = (if ex9 then b9 - a9 else b9 - a9 + 1) in
                if span9 <= 0 then VNil else VInt (a9 + mt_rand_int g9 span9))
             | _ -> (let lo9 = to_f av9 in let hi9 = to_f bv9 in
                     if hi9 <= lo9 then VNil else VFlt (lo9 + mt_rand_real g9 * (hi9 - lo9))))
          | _ -> VFlt (mt_rand_real g9)))
    else if str_eq cls "Encoding" && str_eq name "dummy?" then
      VBool (enc_is_dummy (if map_has ivars (str_of_int id ++ "@name") then to_s (map_get ivars (str_of_int id ++ "@name")) else ""))
    else if str_eq cls "Encoding" && str_eq name "ascii_compatible?" then
      VBool (enc_ascii_compat (if map_has ivars (str_of_int id ++ "@name") then to_s (map_get ivars (str_of_int id ++ "@name")) else ""))
    // `Regexp.allocate` hands back an object with no pattern in it, and ruby
    // refuses BY NAME every method that would have to read one --
    // "uninitialized Regexp" -- rather than reporting the method missing. A
    // Regexp built any other way (literal, .new, a subclass through new_obj_wb)
    // carries @__rx_src, so it never reaches this arm.
    // Not every name: #inspect, #encoding, #fixed_encoding? and #frozen? answer
    // for an uninitialized one in ruby too, so they are left alone.
    else if exc_is_a world cls "Regexp"
            && (if map_has ivars (str_of_int id ++ "@__rx_src") then false else true)
            && (if has_meth world cls name then false else true)
            && (str_eq name "source" || str_eq name "options" || str_eq name "match"
                || str_eq name "match?" || str_eq name "=~" || str_eq name "==="
                || str_eq name "names" || str_eq name "named_captures"
                || str_eq name "casefold?" || str_eq name "to_s" || str_eq name "hash") then
      raise_exc world "TypeError" "uninitialized Regexp"
    // dup/clone a user object: a fresh object of the same class with copied
    // ivars. A fresh id naturally drops the singleton class (its methods and
    // constants are keyed by the old id) — matching dup, which does not copy
    // the singleton.
    else if str_eq name "dup" || str_eq name "clone" then
      (let nid = alloc_oid ocls in
       // `cls` above is the DISPATCH class, which strips the singleton off when
       // the singleton does not define the name being called -- and `clone`
       // never does. What class this object IS is a different question, and
       // asking the dispatch one made clone drop every singleton it was
       // supposed to copy.
       let ocls0 = map_get ocls id in
       // clone(freeze:) takes true, false or nil and nothing else.
       let (fz9, kw9) =
         (match args with
          | Cons (VHsh h9, _) ->
            (match hash_lookup (hderef h9) (VSym "freeze") with
             | (true, VBool b9) -> ((if b9 then 1 else 0), true)
             | (true, VNil) -> (2, true)
             | (true, bad9) -> (let _ = raise_exc world "ArgumentError"
                                  ("unexpected value for freeze: " ++ class_name bad9) in (2, true))
             | _ -> (2, false))
          | _ -> (2, false)) in
       let realcls = if is_sng_cls ocls0 then (if map_has sup ocls0 then map_get sup ocls0 else "Object") else ocls0 in
       // copy the object's instance variables (id@name -> nid@name).
       let oldp = str_of_int id ++ "@" in
       let newp = str_of_int nid ++ "@" in
       let tmp = map_new () in
       let _ = map_iter ivars (fn (k: str) -> fn (v: Val) ->
                 if str_len k > str_len oldp && str_eq (substring k 0 (str_len oldp)) oldp
                 then map_set tmp (newp ++ substring k (str_len oldp) (str_len k)) v
                 else ()) in
       let _ = map_iter tmp (fn (k: str) -> fn (v: Val) -> map_set ivars k v) in
       // clone copies the singleton class (its methods + constants); dup drops
       // it (the new id has none).
       let _ = if str_eq name "clone" && is_sng_cls ocls0 then
                 (let nsng = "(sng:" ++ str_of_int nid ++ ")" in
                  let _ = set_sup sup nsng realcls in
                  let _ = map_set ocls nid nsng in
                  // the modules INCLUDED into the singleton come with it --
                  // `class << obj; include M; end` then clone must still see M.
                  let _ = (if map_has includes ocls0 then map_set includes nsng (map_get includes ocls0) else ()) in
                  let _ = (if map_has prepends ocls0 then map_set prepends nsng (map_get prepends ocls0) else ()) in
                  let mpre = ocls0 ++ "#" in
                  let tm = map_new () in
                  let _ = map_iter meths (fn (k: str) -> fn (v: Meth) ->
                            if str_len k > str_len mpre && str_eq (substring k 0 (str_len mpre)) mpre
                            then map_set tm (nsng ++ "#" ++ substring k (str_len mpre) (str_len k)) v
                            else ()) in
                  let _ = map_iter tm (fn (k: str) -> fn (v: Meth) -> set_meth meths k v) in
                  let cpre = ocls0 ++ "::" in
                  let tc = map_new () in
                  let _ = map_iter consts (fn (k: str) -> fn (v: Val) ->
                            if str_len k > str_len cpre && str_eq (substring k 0 (str_len cpre)) cpre
                            then map_set tc (nsng ++ "::" ++ substring k (str_len cpre) (str_len k)) v
                            else ()) in
                  let _ = map_iter tc (fn (k: str) -> fn (v: Val) -> map_set consts k v) in ())
               else map_set ocls nid realcls in
       let cp9 = VObj nid in
       // the copy hook runs BEFORE the copy is frozen (ruby freezes last), and
       // it is #initialize_clone / #initialize_dup -- which is what reaches a
       // user #initialize_copy.
       let _ = (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
                let hook9 = (if str_eq name "clone" then "initialize_clone" else "initialize_dup") in
                let hargs9 = (if kw9 then (match args with Cons (h9, _) -> Cons (recv, Cons (h9, Nil)) | _ -> Cons (recv, Nil))
                              else Cons (recv, Nil)) in
                invoke_val_c env world nb9 cp9 hook9 hargs9 false) in
       // #clone carries the frozen state over unless `freeze:` overrides it;
       // #dup never does.
       let _ = (if str_eq name "clone"
                   && (if fz9 == 1 then true else (if fz9 == 0 then false else ofrozen_get id))
                then (let _ = ofrozen_set nid in ()) else ()) in
       cp9)
    else if is_prim_method name then prim_method recv name args
    // Enumerable (no block): to_a returns the collected array; others delegate.
    // each_slice / each_cons / cycle take an argument, so is_enum_method leaves
    // them out (it is also the list of names a bare call may enumerate) -- but
    // an object that includes Enumerable answers them, and answered
    // NoMethodError here for want of a row.
    // chunk_while / slice_when have nothing to enumerate without their
    // predicate: ruby refuses them in the words of the Proc it could not make.
    // The Array path already did; an object that includes Enumerable fell to
    // the arm below and answered an ENUMERATOR, which is a value the caller
    // cannot use for anything.
    else if (str_eq name "chunk_while" || str_eq name "slice_when")
            && has_meth world cls "each" then
      raise_exc world "ArgumentError" "tried to create Proc object without a block"
    else if has_meth world cls "each" && (is_enum_method name || enum_arg_iter name) then
      if enum_needs_block name || enum_arg_iter name then
        // each_slice / each_cons need a positive size before anything is
        // built: without one the enumerator re-enters this arm forever.
        (if enum_arg_iter name && (if str_eq name "cycle" then false else true) then
           (match args with
            | Cons (VInt n9, _) ->
              (if n9 < 1
               then raise_exc world "ArgumentError" (if str_eq name "each_slice" then "invalid slice size" else "invalid size")
               else make_enum_a world recv name args)
            | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)"
            | _ -> make_enum_a world recv name args)
         else make_enum_a world recv name args)
      else
      // ...and only to_a / entries hand their arguments to `each`: everywhere
      // else the argument is the METHOD's (`include?(x)`), and passing it on
      // called the receiver's each with it -- an arity error from the inside.
      let coll = (if str_eq name "to_a" || str_eq name "entries"
                  then enum_collect_a world recv cls args
                  else enum_collect world recv cls) in
      if str_eq name "to_a" || str_eq name "entries" then coll else dispatch_prim env world blk coll name args vischeck
    // The string form of instance_eval/instance_exec has to be answered BEFORE
    // method_missing. A class that defines method_missing -- bundler's Dsl does,
    // to name an unknown Gemfile directive -- was asked about `instance_eval`
    // itself, and since the Gemfile DSL *is* `instance_eval(contents, path, 1)`,
    // that answer replaced the whole evaluation. The branch that handled this
    // sat further down the same chain, where those classes never reached it.
    else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
      dispatch_prim env world blk recv name args vischeck
    // a method_missing defined on the object's SINGLETON (def o.method_missing)
    // lives under the (sng:N) class, which `cls` here is not.
    else if (match recv with
             | VObj oid9 -> (let (_, _, o9, _) = world in
                             let c9 = map_get o9 oid9 in
                             is_sng_cls c9 && has_meth world c9 "method_missing")
             | _ -> false) then
      (match recv with
       | VObj oid9 -> (let (_, _, o9, _) = world in
                       invoke world noblk recv (map_get o9 oid9) "method_missing" (Cons (VSym name, args)))
       | _ -> VNil)
    else if has_meth world cls "method_missing" then invoke world noblk recv cls "method_missing" (Cons (VSym name, args))
    // Thread instance surface (synchronous model): the body already ran to
    // completion, a park, or an exception (see the Thread.new boundary).
    else if str_eq cls "Thread" then
      (match recv with
       | VObj tid ->
         (let k = str_of_int tid in
          let tst = (if map_has ivars (k ++ "@__tst") then map_get ivars (k ++ "@__tst") else VBool false) in
          let alive = (match tst with VStr _ -> true | _ -> false) in
          if str_eq name "join" || str_eq name "value" then
            (if map_has ivars (k ++ "@__texc") then flow_value (re_raise world (map_get ivars (k ++ "@__texc")))
             else if str_eq name "value" then
               (if map_has ivars (k ++ "@__tval") then map_get ivars (k ++ "@__tval") else VNil)
             else recv)
          else if str_eq name "status" then tst
          else if str_eq name "alive?" then VBool alive
          else if str_eq name "stop?" then
            VBool (if alive then (match tst with VStr h -> str_eq (sget h) "sleep" | _ -> false) else true)
          else if str_eq name "kill" || str_eq name "exit" || str_eq name "terminate" then
            (let _ = (if alive then map_set ivars (k ++ "@__tst") (VBool false) else ()) in recv)
          else if str_eq name "raise" then
            // raising into a parked thread kills it with the exception (join
            // re-raises); raising into a dead thread is a no-op.
            (let _ =
               (if alive then
                  let exc = (match args with
                             | Cons (VClass ec, Cons (VStr mh, _)) -> VExc (ec, sget mh)
                             | Cons (VClass ec, _) -> VExc (ec, ec)
                             | Cons (VStr mh, _) -> VExc ("RuntimeError", sget mh)
                             | _ -> VExc ("RuntimeError", "")) in
                  let _ = map_set ivars (k ++ "@__texc") exc in
                  map_set ivars (k ++ "@__tst") VNil
                else ()) in
             VNil)
          else if str_eq name "wakeup" || str_eq name "run" then
            (let _ = (if alive then map_set ivars (k ++ "@__tst") (mkstr "run") else ()) in recv)
          else if str_eq name "name" then
            (if map_has ivars (k ++ "@__tname") then map_get ivars (k ++ "@__tname") else VNil)
          else if str_eq name "name=" then
            (match args with Cons (v, _) -> let _ = map_set ivars (k ++ "@__tname") v in v | _ -> VNil)
          else if str_eq name "[]" || str_eq name "thread_variable_get" then
            (match args with
             | Cons (kv, _) ->
               (let kk = (match kv with VSym sy -> sy | VStr h -> sget h | _ -> "") in
                if map_has ivars (k ++ "@__tl_" ++ kk) then map_get ivars (k ++ "@__tl_" ++ kk) else VNil)
             | _ -> VNil)
          else if str_eq name "[]=" || str_eq name "thread_variable_set" then
            (match args with
             | Cons (kv, Cons (v, _)) ->
               (let kk = (match kv with VSym sy -> sy | VStr h -> sget h | _ -> "") in
                let _ = map_set ivars (k ++ "@__tl_" ++ kk) v in v)
             | _ -> VNil)
          else if str_eq name "key?" || str_eq name "thread_variable?" then
            (match args with
             | Cons (kv, _) ->
               (let kk = (match kv with VSym sy -> sy | VStr h -> sget h | _ -> "") in
                VBool (map_has ivars (k ++ "@__tl_" ++ kk)))
             | _ -> VBool false)
          else if str_eq name "fetch" then
            (match args with
             | Cons (kv, rest) ->
               (let kk = (match kv with VSym sy -> sy | VStr h -> sget h | _ -> "") in
                if map_has ivars (k ++ "@__tl_" ++ kk) then map_get ivars (k ++ "@__tl_" ++ kk)
                else (match rest with
                      | Cons (d, _) -> d
                      | Nil -> raise_exc world "KeyError" ("key not found: :" ++ kk)))
             | _ -> VNil)
          else if str_eq name "group" then
            (if map_has ivars (k ++ "@__tgrp") then map_get ivars (k ++ "@__tgrp")
             else if map_has dfl_tg "v" then map_get dfl_tg "v" else VNil)
          else if str_eq name "abort_on_exception" || str_eq name "report_on_exception" then VBool false
          else if str_eq name "abort_on_exception=" || str_eq name "report_on_exception=" then
            (match args with Cons (v, _) -> v | _ -> VNil)
          else if str_eq name "priority" then VInt 0
          else if str_eq name "priority=" then (match args with Cons (v, _) -> v | _ -> VNil)
          else if str_eq name "inspect" || str_eq name "to_s" then
            mkstr ("#<Thread " ++ (match tst with VStr h -> sget h | VBool _ -> "dead" | _ -> "dead") ++ ">")
          // the universal names, same reason as the ThreadGroup arm above --
          // this one refused four of them.
          else if is_prim_method name then dispatch_prim env world blk recv name args false
          else raise_exc world "NoMethodError" ("undefined method '" ++ name ++ "' for an instance of Thread"))
       | _ -> recv)
    // Comparable#clamp / #between? on a user object with <=>.
    else if (str_eq name "clamp" || str_eq name "between?") && has_meth world cls "<=>" then
      (if str_eq name "between?" then (match args with Cons (lo, Cons (hi, _)) -> VBool (cmp_vals_w world recv lo >= 0 && cmp_vals_w world recv hi <= 0) | _ -> VBool false)
       // a user object's clamp took only the two-argument form, so the Range
       // form answered the RECEIVER for every object that includes Comparable.
       else clamp_val world recv args)
    // an object has no such method — raise a catchable NoMethodError.
    else raise_exc_iv world "NoMethodError" ("undefined method '" ++ name ++ "' for " ++ for_recv_obj env world recv cls)
           (Cons (("__name", VSym name), Cons (("__args", arr_new args), Cons (("__recv", recv), Nil))))
  | VSym s ->
    if str_eq s "&blk" && (str_eq name "call" || str_eq name "()" || str_eq name "[]")
    then flow_value (run_block world noblk blk args)
    else if str_eq s "&blk" && str_eq name "class" then VClass "Proc"
    else dispatch_prim env world blk recv name args vischeck
  | VMain ->
    // explicit self at the top level dispatches to top-level methods.
    let (meths, sup, ocls, ivars) = world in
    if map_has meths name then call_method env world noblk name args
    else dispatch_prim env world blk recv name args vischeck
  | VProc pid ->
    // a CURRIED proc collects arguments until it has the arity it was curried
    // at, and only then runs the proc it was made from. It is a proc like any
    // other from the outside -- #lambda? answers what the source answers --
    // so the state lives beside it rather than in a different kind of value.
    if (map_has comp_inner (str_of_int pid) || map_has curry_target (str_of_int pid))
       && (str_eq name "call" || str_eq name "()" || str_eq name "[]" || str_eq name "yield" || str_eq name "===") then
      proc_derived_call env world blk pid args
    else if map_has comp_inner (str_of_int pid) && str_eq name "arity" then VInt (0 - 1)
    // Proc#ruby2_keywords: a *rest-only proc that must keep a trailing `key:`
    // hash MARKED as a keywords hash, so re-splatting it stays keywords. The
    // flag is per PROC, the way ruby2_keywords is per method, and the method
    // side has had r2k_methods all along.
    else if str_eq name "ruby2_keywords" then
      (let ps9 = (match map_get proc_store (str_of_int pid) with (h9, ps9, _, _) -> strip_marker_params ps9) in
       // ruby WARNS (and does nothing) for a proc that cannot carry the flag:
       // one with keyword parameters, or with no bare splat to collect into.
       let ok9 = (match kw_params ps9 with Nil -> str_eq (dsplat_name ps9) "" | _ -> false)
                 && psplat_any ps9 in
       let _ = (if ok9 then map_set r2k_procs (r2k_root (str_of_int pid)) VNil else ()) in
       recv)
    // Proc#>> / Proc#<< compose. `f >> g` runs f then g; `f << g` runs g then
    // f. Both reduce to "outer(inner(*args))", and the argument may be ANY
    // callable (a Method, or an object with #call), so what is stored is the
    // value rather than a proc id. #to_proc is NOT tried: ruby refuses an
    // object that only has one.
    else if str_eq name ">>" || str_eq name "<<" then
      (match args with
       | Cons (other9, _) ->
         (let _ = (if responds world other9 "call" then ()
                   else (let _ = raise_exc world "TypeError" "callable object is expected" in ())) in
          if str_eq name ">>" then mk_composed world recv other9 else mk_composed world other9 recv)
       | _ -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)")
    // Proc#curry([arity]): the curried form of this proc.
    // a curried proc reports itself the way ruby's does: arity -1, one rest
    // parameter, and no source location (it is not written anywhere).
    else if map_has curry_target (str_of_int pid) && str_eq name "arity" then VInt (0 - 1)
    else if map_has curry_target (str_of_int pid) && str_eq name "parameters" then
      arr_new (Cons (arr_new (Cons (VSym "rest", Nil)), Nil))
    else if map_has curry_target (str_of_int pid) && str_eq name "source_location" then VNil
    else if map_has comp_inner (str_of_int pid) && str_eq name "source_location" then VNil
    // Proc#source_location: [file, line] of where the block was written, or nil
    // for a proc with no source of its own.
    else if str_eq name "source_location" then
      (if map_has proc_src (str_of_int pid)
       then (let f9 = (if map_has proc_src ("f" ++ str_of_int pid) then map_get proc_src ("f" ++ str_of_int pid) else mkstr "") in
             match f9 with
             | VStr h9 -> (if str_eq (sget h9) "" then VNil
                           else arr_new (Cons (f9, Cons (map_get proc_src (str_of_int pid), Nil))))
             | _ -> VNil)
       else VNil)
    // currying a curried proc curries the proc BEHIND it, not the collector.
    else if map_has curry_target (str_of_int pid) && str_eq name "curry" then
      (let tgt8 = (match map_get curry_target (str_of_int pid) with VInt t -> t | _ -> 0) in
       let ar8 = (match args with
                  | Cons (VInt n, _) -> n
                  | _ -> (match map_get curry_arity (str_of_int pid) with VInt n -> n | _ -> 0)) in
       mk_curried world tgt8 (Nil : Val list) ar8 pid)
    else if str_eq name "curry" then
      // ⚠ A LAMBDA (and a Method, which curries through one) is strict about
      // its argument count, and curry's own argument is that count: ruby
      // refuses `->(a, b) { }.curry(3)` rather than building a chain that can
      // never be satisfied. A non-lambda proc is not strict and takes any n,
      // and a variadic lambda has no fixed count to disagree with -- so the
      // check is exactly "a lambda with a fixed arity, given a different one".
      (let nat9 = (match invoke_val_c env world blk recv "arity" Nil false with
                   | VInt a -> a
                   | _ -> 0) in
       let _ = (match args with
                | Cons (VInt n9, _) ->
                  (if map_has lambda_ids (str_of_int pid) && nat9 >= 0 && (if n9 == nat9 then false else true)
                   then (let _ = raise_exc world "ArgumentError"
                                   ("wrong number of arguments (given " ++ str_of_int n9
                                    ++ ", expected " ++ str_of_int nat9 ++ ")") in ())
                   else ())
                | _ -> ()) in
       let ar9 = (match args with
                  | Cons (VInt n, _) -> n
                  | _ -> (if nat9 < 0 then 0 - nat9 - 1 else nat9)) in
       mk_curried world pid (Nil : Val list) ar9 pid)
    // Internal, for wi_index_block: run the block and say whether it BROKE, as
    // [broke?, value], so the wrapper can break its OWN iteration instead of
    // swallowing it. `#call` cannot be used for that: a break inside a proc
    // called with #call is that call's value here, so
    // `map.with_index { |x, i| break :b if i == 1; x }` answered [1, :b, 3]
    // where ruby answers :b. The pair is per call rather than a flag somewhere,
    // because with_index nests (a block can drive another enumerator).
    else if str_eq name "__wi_call" then
      (match run_block world blk (map_get proc_store (str_of_int pid)) args with
       | FBreak v -> arr_new (Cons (VBool true, Cons (v, Nil)))
       | fl -> arr_new (Cons (VBool false, Cons (flow_value fl, Nil))))
    // call/./[]/yield run the stored block; class reports Proc.
    else if str_eq name "call" || str_eq name "()" || str_eq name "[]" || str_eq name "yield" || str_eq name "===" then
      // a ruby2_keywords proc keeps its trailing `key:` hash MARKED as
      // keywords -- that is the whole point of the flag: the hash it collects
      // into *rest can be re-splatted and still arrive as keywords.
      let _ = (if map_has r2k_procs (r2k_root (str_of_int pid)) then mark_r2k_tail args else ()) in
      let theblk = map_get proc_store (str_of_int pid) in
      // a lambda checks arity strictly (procs stay lenient).
      let _ =
        if map_has lambda_ids (str_of_int pid) then
          (match theblk with (h2, ps, b2, e2) -> lambda_arity_check_args world (strip_marker_params ps) b2 args)
        else () in
      if map_has lambda_ids (str_of_int pid) then
        // a lambda is method-like: it establishes a return-boundary frame, so a
        // `return` from the lambda (or from a proc created inside it) returns
        // from the LAMBDA. Give the body env a fresh __fid for the call so
        // procs created inside record it as their home, and consume a return
        // targeted at that frame. Pass the lambda marker for strict arity.
        //
        // The fid goes in a frame OF THIS CALL, not in the env the lambda
        // captured: that env is its defining method's frame, and a proc made
        // there reads __fid when its return fires, not when it was made. A
        // lambda that stamped its own fid into that frame would make a sibling
        // proc's return target the lambda -- `def m; l.call(proc{return}); end`
        // has to return from `m`.
        (match theblk with (h2, ps2, b2, e2) ->
          let lfid = next_fid () in
          let e2c = blk_env_get e2 in
          let _ = map_set e2c "__fid" (VInt lfid) in
          let _ = map_set live_frames lfid 1 in
          let (h3, ps3, b3, e3) = proc_as_block pid in
          let _ = e3 in
          // a block given at THIS call site is the block the proc body's &param
          // binds to (`pr.call(1) { }` reaching `proc { |x, &b| b }`). `yield`
          // inside the body still resolves to the block captured where the proc
          // was made -- that comes from the yblk marker, which overrides this.
          let f = try_or (fn (u: unit) -> run_block world blk (h3, ps3, b3, e2c) args) (FRaise VNil) in
          let _ = map_delete live_frames lfid in
          // the lambda's return-boundary frame is pooled like the block env
          // under it (run_block made that one a child of e2c and has already
          // put it back); a proc made inside painted both captured.
          let _ = blk_env_put e2c in
          (match f with
           | FRaise _ ->
             if map_has flow_sig "k" then
               let k = (match map_get flow_sig "k" with VStr kk -> let kk = sget kk in kk | _ -> "") in
               let v = (if map_has flow_sig "v" then map_get flow_sig "v" else VNil) in
               let tgt = (if map_has flow_sig "fid" then (match map_get flow_sig "fid" with VInt t -> t | _ -> 0) else 0) in
               if str_eq k "return" then (let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in
 v)
               else if str_eq k "returnret" then
                 // consume iff this lambda is the target; else keep propagating
                 // (flow_sig still holds k/fid/v, so just re-raise).
                 (if tgt == lfid then (let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in
 let _ = map_delete flow_sig "fid" in v)
                  else (let _ = tgt in (let m = "mere-ruby: (unhandled return past its frame)" in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m)))
               else if str_eq k "breakret" then (let _ = tgt in (let m = "mere-ruby: (unhandled break past its frame)" in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr m)) in fail m))
               else (let _ = map_delete flow_sig "k" in
            // a CONSUMED flow signal must not leave its internal message behind:
            // the next real failure would be reported as that instead.
            let _ = if map_has prim_missing "i" then map_delete prim_missing "i" else () in
           let _ = if map_has prim_missing "f" then map_delete prim_missing "f" else () in
           let _ = if map_has prim_missing "rl" then map_delete prim_missing "rl" else () in
           let _ = if map_has prim_missing "rm" then map_delete prim_missing "rm" else () in
           let _ = if map_has prim_missing "rf" then map_delete prim_missing "rf" else () in
 flow_throw k v)
             else (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")
           | other -> flow_value other))
      // A `break` out of a PROC called with #call breaks the method the block
      // was PASSED to -- `define_method(:m) { |&b| b.call }` with `m { break }`
      // answers the break's value -- and is a LocalJumpError only when that
      // frame is gone, which is the case for `Proc.new { break 1 }.call`.
      // Answering the value in both cases was the earlier behaviour and made
      // the second one a value; refusing in both broke the first.
      else (match run_block world blk (proc_as_block pid) args with
            | FBreak bv9 ->
              // ...the frame the BLOCK was passed to, and only that: a method
              // that merely happens to be running (`def m; Proc.new { break }
              // .call; end`) is not the break's target, and reading its own
              // frame id made that answer the break's value where ruby
              // refuses. __blk_home exists exactly when a block was handed in.
              // ...which the PROC carries (proc_home, recorded when a block
              // became one), not the frame that happens to be running: a
              // method that merely calls a proc is not the break's target.
              (let tgt9 = (if map_has proc_home (str_of_int pid) then map_get proc_home (str_of_int pid)
                           else if lv_has env "__blk_home" then lv_get env "__blk_home" else VInt 0) in
               let tk9 = (match tgt9 with VInt t9 -> t9 | _ -> 0 - 1) in
               if tk9 < 0 || (if map_has live_frames tk9 then false else true)
               // ...with the reason and the value on it, the way ruby's carry
               // them: #reason is :break and #exit_value the break's value.
               then raise_exc_iv world "LocalJumpError" "break from proc-closure"
                      (Cons (("__exit_value", bv9), Cons (("__reason", VSym "break"), Nil)))
               else flow_throw_breakret (match tgt9 with VInt t9 -> t9 | _ -> 0) bv9)
            | other9 -> flow_value other9)
    else if str_eq name "class" then VClass "Proc"
    else if str_eq name "lambda?" then VBool (map_has lambda_ids (str_of_int pid))
    // Proc#binding: the environment the proc CAPTURED, which is the same
    // thing Kernel#binding hands back for the frame it was called in.
    else if str_eq name "binding" then
      (let (h9, ps9, b9, cenv9) = proc_as_block pid in
       let bid = map_len bind_store in
       let _ = map_set bind_store (str_of_int bid) (lv_flat cenv9) in
       VBind bid)
    // Proc#to_proc is the proc ITSELF -- the name was claimed with nothing
    // behind it, so `pr.to_proc` was a NoMethodError on a Proc.
    else if str_eq name "to_proc" then recv
    else if str_eq name "parameters" then
      (match map_get proc_store (str_of_int pid) with
       (h, ps, body, e) ->
         // `parameters(lambda: true)` asks for the answer a LAMBDA would give
         // (leading positionals :req) and `lambda: false` for a proc's (:opt),
         // whatever the receiver is. The keyword was ignored, so the two specs
         // that ask a proc to describe itself as a lambda read :opt.
         let is_lam = (let (_, kw9) = peel_kw_hash args in
                       match hash_lookup kw9 (VSym "lambda") with
                       | (true, VNil) -> map_has lambda_ids (str_of_int pid)
                       | (true, v9) -> truthy v9
                       | _ -> map_has lambda_ids (str_of_int pid)) in
         (match strip_marker_params ps with
          // no explicit params: the numbered parameters _1.._N, required for a
          // lambda and optional for a proc.
          | Nil ->
            (let nn9 = max_numbered_stmts body in
             if nn9 > 0 then arr_new (numbered_params_meta is_lam 1 nn9)
             // ...and `it`'s parameter has no name to report.
             else if uses_it_stmts body && (if lv_has e "it" then false else true)
             then arr_new (Cons (arr_new (Cons (VSym (if is_lam then "req" else "opt"), Nil)), Nil))
             else arr_new (Nil : Val list))
          // ...and Symbol#to_proc's proc has NO parameter NAMES in ruby (it is
          // a C function): it answers [[:req], [:rest]]. Its stand-in here is
          // written with real parameters, so the two internal names leaked
          // into a public answer.
          | ps1 when (match ps1 with
                      | Cons (a9, Cons (b9, Nil)) -> str_eq a9 "__bp" && str_eq b9 "*__ba"
                      | _ -> false) ->
            arr_new (Cons (arr_new (Cons (VSym "req", Nil)),
                           Cons (arr_new (Cons (VSym "rest", Nil)), Nil)))
          | ps1 -> arr_new (param_meta_of is_lam ps1 (block_defaults body))))
    else if str_eq name "arity" && map_has proc_arity (str_of_int pid) then
      map_get proc_arity (str_of_int pid)
    else if str_eq name "arity" then
      (match map_get proc_store (str_of_int pid) with
       (h, ps0, body, e) ->
         // a lambda carries a marker as its first param; it is not one.
         let ps = (match ps0 with Cons (m, rest) -> if str_eq m lambda_blk_marker then rest else ps0 | _ -> ps0) in
         (match strip_block_params ps with
          // no explicit params: arity is the highest numbered parameter used.
          // ⚠ a LOCAL named `it` wins over the parameter -- `it = 5; ->{ it }`
          // takes no arguments and reads the local -- so the captured scope
          // decides whether the body's `it` is a parameter at all.
          | Nil -> VInt (if lv_has e "it" then max_numbered_stmts body else implicit_params_of body)
          // explicit params: the MANDATORY positional ones, negative when a
          // splat or a default makes the count a lower bound. The defaults
          // live in the body prologue, not in the parameter list.
          | ps1 -> VInt (blk_arity (map_has lambda_ids (str_of_int pid)) ps1 (block_defaults body))))
    else dispatch_prim env world blk recv name args vischeck
  | VBind bid ->
    // binding.eval(str) runs str against the captured env; local_variable_get
    // reads one captured local. class reports Binding.
    let benv = map_get bind_store (str_of_int bid) in
    if str_eq name "eval" then
      (match args with
       | Cons (VStr code, _) -> let code = sget code in
         let _ = set_parsing_eval code in
         let toks = number_nls code (lex_go code 0) in
         let _ = parse_line_reset (count_nls toks) in
         let (p2, _) = parse_stmts toks Nil in
         let _ = map_set load_ctx "parsing" (mkstr "") in
         eval_run benv world blk p2
       | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: Binding#eval expects a string")) in fail "mere-ruby: Binding#eval expects a string"))
    // Binding#local_variables: the names the binding can see, as symbols.
    // ⚠ NOT the interpreter's own entries -- `self` and the `__`-prefixed
    //   bookkeeping (__cref, __definee_recv, ...) live in the same map and are
    //   not locals -- and NOT a numbered parameter: since ruby 4.0 `_1` is not
    //   a binding local, which is what the spec here asserts.
    else if str_eq name "local_variables" then
      (let out9 = arr_new Nil in
       let _ = (match out9 with
                | VArr aid9 ->
                  map_iter benv (fn (k9: str) -> fn (v9: Val) ->
                    if bnd_is_local k9
                    then arr_set aid9 (list_append (deref aid9) (Cons (VSym k9, Nil)))
                    else ())
                | _ -> ()) in
       out9)
    else if str_eq name "local_variable_get" then
      (match args with
       | Cons (VSym n, _) ->
         (if numbered_digit n > 0
          then raise_exc world "NameError" ("numbered parameter '" ++ n ++ "' is not a local variable")
          // ⚠ a name the binding does not hold is a NameError, not nil. Answering
          // nil made `binding.local_variable_get(:it)` look like a local holding
          // nothing -- and the same for every misspelt name.
          else if map_has benv n then map_get benv n
          else raise_exc world "NameError"
                 ("local variable '" ++ n ++ "' is not defined for " ++ inspect recv))
       | _ -> VNil)
    else if str_eq name "local_variable_set" then
      (match args with
       | Cons (VSym n, Cons (v, _)) ->
         (if numbered_digit n > 0
          then raise_exc world "NameError" ("numbered parameter '" ++ n ++ "' is not a local variable")
          else (let _ = map_set benv n v in v))
       | _ -> VNil)
    else if str_eq name "local_variable_defined?" then
      (match args with
       | Cons (VSym n, _) ->
         (if numbered_digit n > 0
          then raise_exc world "NameError" ("numbered parameter '" ++ n ++ "' is not a local variable")
          else VBool (map_has benv n))
       | _ -> VBool false)
    else if str_eq name "receiver" || str_eq name "self" then
      (if map_has benv "self" then map_get benv "self" else VMain)
    else if str_eq name "class" then VClass "Binding"
    else dispatch_prim env world blk recv name args vischeck
  | _ -> dispatch_prim env world blk recv name args vischeck

// dispatch `recv.name(args) { block }` — shared by literal-block calls and
// strict-arity check shared by a direct lambda call and a lambda-as-block:
// an explicit param list must receive exactly that many args (a splat or a
// param-less body absorbs any count); otherwise ArgumentError.
// a numbered block parameter name (_1 .. _9).
// the digit of a numbered-parameter name (_1.._9), or 0 if not one.

// Is this key of a binding's env a RUBY local? `self` and the `__`-prefixed
// slots are the interpreter's own, and a numbered parameter stopped being a
// binding local in ruby 4.0.
// A binding's snapshot WITHOUT the numbered parameters. `_1` is reserved by
// ruby -- `_1 = 5` is a SyntaxError anywhere, so nothing else can be hiding
// under that name -- and since 4.0 it is not a binding local: `binding.eval
// "_1"` raises NameError where the value is plainly in scope for the block.
// Filtering at CAPTURE makes every reader agree (eval, local_variables,
// local_variable_get) instead of each excluding it separately.



// `&blk` is a parameter (ruby reports it); the empty-params sentinel is not.
// the two PARSE-TIME markers a parameter list can carry, neither of which is a
// parameter: the explicit-but-empty `||` sentinel and the lambda-as-block flag.
// Only the first was stripped here, so a lambda whose params still carried the
// second was told it needed one argument more than it does -- which is how
// `:upcase.to_proc.call("ok")` came to report "given 1, expected 2+".

// A proc and a lambda count the same mandatory arguments; they differ in
// whether an OPTIONAL one makes the count a lower bound (a lambda checks its
// arity, a proc does not). A required keyword adds one argument to both.


// required (`want_req`) or optional keyword parameters, `**rest` counting as
// an optional one.

// how many positional parameters MUST be given a value.
// Does an override of #respond_to? TAKE the include_all flag? ruby looks at the
// arity: it passes two arguments unless the method takes exactly one. Asking
// for two MANDATORY parameters instead answered no for the ordinary
// `def respond_to?(sym, include_all = false)` -- so every override written that
// way was asked a different question from the one ruby asks, and a spec that
// mocks `.with(:to_int, true)` never matched.

// ⚠ ...and the question ruby asks of a PUBLIC respond_to? is narrower, which
//   is not the same rule. Measured against ruby for four signatures:
//     def respond_to?(s)              -> called with 1
//     def respond_to?(s, p = false)   -> called with 2, and p is FALSE
//     def respond_to?(s, p)           -> called with 1 (so: ArgumentError)
//     def respond_to?(*a)             -> called with 1
//   so the flag goes only to a method whose SECOND positional parameter is
//   OPTIONAL -- not to a splat, and not to a mandatory pair. takes_include_all
//   says yes to all three of those, which is right for the internal protocol
//   probes it was written for and wrong here.


// "does this object say it responds to <name>?", asked the way a PATTERN
// MATCH asks it: the object's own #respond_to? when it has one (with ruby's
// argument count), the method table otherwise.
and responds_pm = fn env -> fn world -> fn (recv: Val) -> fn (name: str) ->
  match recv with
  | VObj id ->
    (let (meths, sup, ocls, ivars) = world in
     let cls = map_get ocls id in
     if has_meth world cls "respond_to?" then
       (let extra = (match lookup_meth world cls "respond_to?" with
                     | Meth (ps, ds, _) -> (if takes_optional_second ps ds then Cons (VBool false, Nil) else Nil)) in
        let nb7 = (false, (Nil : str list), (Nil : Stmt list), env) in
        truthy (invoke_val_c env world nb7 recv "respond_to?" (Cons (VSym name, extra)) false))
     else has_meth world cls name)
  | _ -> responds world recv name

// how many positional slots a parameter list has (required + optional + a
// splat, which can absorb any number)



// Does this block's OWN body name `it`? Same walk as the numbered parameters
// and the same rule about nesting -- `it` belongs to the innermost block that
// mentions it. A block that uses it has one parameter, which is why
// `-> { it }.call("a")` works and `-> {}.call("a")` does not.
//
// ⚠ It is NOT the same answer as _1, only the same arity: the parameter has no
// NAME (`[[:req]]`, not `[[:req, :_1]]`), because `it` is a keyword rather
// than a variable the caller can see.
and uses_it_stmts = fn (body: Stmt list) ->
  match body with
  | Nil -> false
  | Cons (s, rest) -> uses_it_stmt s || uses_it_stmts rest
and uses_it_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> uses_it_expr e
  | SAssign (_, e) -> uses_it_expr e
  | SIVarAssign (_, e) -> uses_it_expr e
  | SReturn e -> uses_it_expr e
  | SPuts es -> uses_it_exprs es
  | SWhile (c, b) -> uses_it_expr c || uses_it_stmts b
  | SIf (clauses, els) -> uses_it_clauses clauses || uses_it_stmts els
  | _ -> false
and uses_it_clauses = fn (clauses: (Expr * Stmt list) list) ->
  match clauses with
  | Nil -> false
  | Cons ((c, b), rest) -> uses_it_expr c || uses_it_stmts b || uses_it_clauses rest
and uses_it_expr = fn (e: Expr) ->
  match e with
  // `it` parses as a bare name, and a bare name with no arguments is the only
  // shape it can take: `it(1)` and `it { }` are ordinary method calls.
  | EVar n -> str_eq n "it"
  | ECall (n, args) -> (match args with Nil -> str_eq n "it" | _ -> uses_it_exprs args)
  | EBin (_, a, b) -> uses_it_expr a || uses_it_expr b
  | EUn (_, a) -> uses_it_expr a
  | EMethod (r, _, args) -> uses_it_expr r || uses_it_exprs args
  | EMethodB (r, _, args, _, _) -> uses_it_expr r || uses_it_exprs args
  | ECallB (_, args, _, _) -> uses_it_exprs args
  | EArr es -> uses_it_exprs es
  | EHsh es -> uses_it_exprs es
  | ETern (a, b, c) -> uses_it_expr a || uses_it_expr b || uses_it_expr c
  | EYield es -> uses_it_exprs es
  | _ -> false
and uses_it_exprs = fn (es: Expr list) ->
  match es with
  | Nil -> false
  | Cons (e, rest) -> uses_it_expr e || uses_it_exprs rest
// the block's implicit parameter count: the numbered ones, or one for `it`.
and implicit_params_of = fn (body: Stmt list) ->
  (let n9 = max_numbered_stmts body in
   if n9 > 0 then n9 else (if uses_it_stmts body then 1 else 0))
and max_numbered_stmts = fn (body: Stmt list) ->
  match body with
  | Nil -> 0
  | Cons (s, rest) -> imax (max_numbered_stmt s) (max_numbered_stmts rest)
and max_numbered_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> max_numbered_expr e
  | SAssign (_, e) -> max_numbered_expr e
  | SIVarAssign (_, e) -> max_numbered_expr e
  | SReturn e -> max_numbered_expr e
  | SPuts es -> max_numbered_exprs es
  | SWhile (c, b) -> imax (max_numbered_expr c) (max_numbered_stmts b)
  | SIf (clauses, els) -> imax (max_numbered_clauses clauses) (max_numbered_stmts els)
  | _ -> 0
and max_numbered_clauses = fn (clauses: (Expr * Stmt list) list) ->
  match clauses with
  | Nil -> 0
  | Cons ((c, b), rest) -> imax (imax (max_numbered_expr c) (max_numbered_stmts b)) (max_numbered_clauses rest)
and max_numbered_expr = fn (e: Expr) ->
  match e with
  | EVar n -> numbered_digit n
  | EBin (_, a, b) -> imax (max_numbered_expr a) (max_numbered_expr b)
  | EUn (_, a) -> max_numbered_expr a
  | ECall (_, args) -> max_numbered_exprs args
  | EMethod (r, _, args) -> imax (max_numbered_expr r) (max_numbered_exprs args)
  // ⚠ NOT into the block's own body. A numbered parameter belongs to the
  // INNERMOST block that mentions it, so `->{ [1].map { _1 } }` takes no
  // arguments -- the _1 is the map block's. Descending gave the outer one
  // arity 1 and, once `it` joined this walk, would have done the same to it.
  | EMethodB (r, _, args, _, _) -> imax (max_numbered_expr r) (max_numbered_exprs args)
  | ECallB (_, args, _, _) -> max_numbered_exprs args
  | EArr es -> max_numbered_exprs es
  | EHsh es -> max_numbered_exprs es
  | ETern (a, b, c) -> imax (imax (max_numbered_expr a) (max_numbered_expr b)) (max_numbered_expr c)
  | EYield es -> max_numbered_exprs es
  | _ -> 0
and max_numbered_exprs = fn (es: Expr list) ->
  match es with
  | Nil -> 0
  | Cons (e, rest) -> imax (max_numbered_expr e) (max_numbered_exprs rest)

// invalid use of a numbered parameter (Ruby rejects at parse time): a block
// with explicit params whose body uses _1.. ("ordinary parameter is
// defined"), or assigning to _1.. ("reserved for numbered parameter").
// A symbol LITERAL whose bytes are not valid in the source encoding is a parse
// error, not a symbol: `:"\xC3"` never becomes a value, so nothing in the same
// eval runs. Accepting it built a Symbol whose name could not be printed.
and bad_sym_stmts = fn (b: Stmt list) ->
  match b with Nil -> false | Cons (s9, r9) -> bad_sym_stmt s9 || bad_sym_stmts r9
and bad_sym_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> bad_sym_expr e
  | SAssign (_, e) -> bad_sym_expr e
  | SIVarAssign (_, e) -> bad_sym_expr e
  | SReturn e -> bad_sym_expr e
  | SPuts es -> bad_sym_exprs es
  | SWhile (c, bd) -> bad_sym_expr c || bad_sym_stmts bd
  | SIf (cls, els) -> bad_sym_clauses cls || bad_sym_stmts els
  | _ -> false
and bad_sym_clauses = fn (cls: (Expr * Stmt list) list) ->
  match cls with
  | Nil -> false
  | Cons ((c, b), r) -> bad_sym_expr c || bad_sym_stmts b || bad_sym_clauses r
and bad_sym_expr = fn (e: Expr) ->
  match e with
  | ESym y -> (if enc_all7 y then false else (if enc_valid_utf8 y then false else true))
  | EBin (_, a, b) -> bad_sym_expr a || bad_sym_expr b
  | EUn (_, a) -> bad_sym_expr a
  | ECall (_, args) -> bad_sym_exprs args
  | EMethod (r, _, args) -> bad_sym_expr r || bad_sym_exprs args
  | EMethodB (r, _, args, _, bb) -> bad_sym_expr r || bad_sym_exprs args || bad_sym_stmts bb
  | ECallB (_, args, _, bb) -> bad_sym_exprs args || bad_sym_stmts bb
  | EArr es -> bad_sym_exprs es
  | EHsh es -> bad_sym_exprs es
  | ETern (a, b, c) -> bad_sym_expr a || bad_sym_expr b || bad_sym_expr c
  | EYield es -> bad_sym_exprs es
  | ELambda (_, b) -> bad_sym_stmts b
  | _ -> false
and bad_sym_exprs = fn (es: Expr list) ->
  match es with Nil -> false | Cons (e, r) -> bad_sym_expr e || bad_sym_exprs r
and numbered_misuse_stmts = fn (body: Stmt list) ->
  match body with Nil -> false | Cons (s, r) -> numbered_misuse_stmt s || numbered_misuse_stmts r
and numbered_misuse_stmt = fn (s: Stmt) ->
  match s with
  | SAssign (n, e) -> numbered_digit n > 0 || numbered_misuse_expr e
  | SExpr e -> numbered_misuse_expr e
  | SIVarAssign (_, e) -> numbered_misuse_expr e
  | SReturn e -> numbered_misuse_expr e
  | SPuts es -> numbered_misuse_exprs es
  | SWhile (c, b) -> numbered_misuse_expr c || numbered_misuse_stmts b
  | SIf (clauses, els) -> numbered_misuse_clauses clauses || numbered_misuse_stmts els
  | _ -> false
and numbered_misuse_clauses = fn (clauses: (Expr * Stmt list) list) ->
  match clauses with Nil -> false | Cons ((c, b), r) -> numbered_misuse_expr c || numbered_misuse_stmts b || numbered_misuse_clauses r
// WHICH misuse it is. ruby words the three differently, and the spec matches
// on the wording: an ordinary parameter beside `it`, numbered parameters after
// `it`, or `it` after a numbered parameter. One sentence for all three said
// "invalid numbered parameter" even when no numbered parameter was involved.
and numbered_misuse_why = fn (bp: str list) -> fn (bb: Stmt list) ->
  (let hasnum = max_numbered_stmts bb > 0 in
   let hasit = uses_it_stmts bb in
   match bp with
   | Cons (_, _) -> (if hasit then "'it' is not allowed when an ordinary parameter is defined"
                     else "numbered parameters are not allowed when an ordinary parameter is defined")
   | Nil ->
     // ⚠ WHICH ONE CAME FIRST decides the sentence: `it` then `_1` blames the
     // numbered parameter, `_1` then `it` blames `it`. Nothing but the order
     // separates them, so the body is walked for whichever appears earlier.
     (if hasnum && hasit then
        (if str_eq (first_implicit_stmts bb) "it"
         then "numbered parameters are not allowed when 'it' is already used"
         else "'it' is not allowed when a numbered parameter is already used")
      else "invalid numbered parameter"))
// "it" or "num" -- whichever this body names first, "" for neither.
and first_implicit_stmts = fn (b: Stmt list) ->
  match b with
  | Nil -> ""
  | Cons (s, r) -> (let f = first_implicit_stmt s in if str_eq f "" then first_implicit_stmts r else f)
and first_implicit_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> first_implicit_expr e
  | SAssign (_, e) -> first_implicit_expr e
  | SIVarAssign (_, e) -> first_implicit_expr e
  | SReturn e -> first_implicit_expr e
  | SPuts es -> first_implicit_exprs es
  | SWhile (c, bd) -> (let f = first_implicit_expr c in if str_eq f "" then first_implicit_stmts bd else f)
  | _ -> ""
and first_implicit_expr = fn (e: Expr) ->
  match e with
  | EVar n -> (if str_eq n "it" then "it" else if numbered_digit n > 0 then "num" else "")
  | ECall (n, args) -> (match args with
                        | Nil -> (if str_eq n "it" then "it" else if numbered_digit n > 0 then "num" else "")
                        | _ -> first_implicit_exprs args)
  | EBin (_, a, b) -> (let f = first_implicit_expr a in if str_eq f "" then first_implicit_expr b else f)
  | EUn (_, a) -> first_implicit_expr a
  | EMethod (r, _, args) -> (let f = first_implicit_expr r in if str_eq f "" then first_implicit_exprs args else f)
  | EArr es -> first_implicit_exprs es
  | EHsh es -> first_implicit_exprs es
  | ETern (a, b, c) -> (let f = first_implicit_expr a in
                        if str_eq f "" then (let g = first_implicit_expr b in
                                             if str_eq g "" then first_implicit_expr c else g) else f)
  | EYield es -> first_implicit_exprs es
  | _ -> ""
and first_implicit_exprs = fn (es: Expr list) ->
  match es with
  | Nil -> ""
  | Cons (e, r) -> (let f = first_implicit_expr e in if str_eq f "" then first_implicit_exprs r else f)
and blk_num_bad = fn (bp: str list) -> fn (bb: Stmt list) ->
  // a block with explicit params AND a numbered param in its body is invalid.
  // ⚠ `it` is one of them: `proc { |x| it }` is refused just as
  // `proc { |x| _1 }` is, and so is mixing the two (`proc { it + _1 }`) --
  // one block cannot take its argument two ways.
  //
  // The WHY is noted here rather than re-derived at the refusal: this walk is
  // the only thing that has seen the offending block, and ruby words the three
  // cases differently (the spec matches on the wording).
  (let bad9 = (match bp with
               | Nil -> max_numbered_stmts bb > 0 && uses_it_stmts bb
               | _ -> max_numbered_stmts bb > 0 || uses_it_stmts bb) in
   let _ = (if bad9 && (if map_has num_misuse_note "why" then false else true)
            then (let _ = map_set num_misuse_note "why" (numbered_misuse_why bp bb) in ()) else ()) in
   bad9)
// a numbered param referenced in THIS block's scope (does not descend into a
// nested block/lambda body, which starts its own numbered-param scope).
and own_num_stmts = fn (b: Stmt list) -> match b with Nil -> 0 | Cons (s, r) -> imax (own_num_stmt s) (own_num_stmts r)
and own_num_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> own_num_expr e
  | SAssign (n, e) -> imax (numbered_digit n) (own_num_expr e)
  | SReturn e -> own_num_expr e
  | SIVarAssign (_, e) -> own_num_expr e
  | SPuts es -> own_num_exprs es
  | SWhile (c, bd) -> imax (own_num_expr c) (own_num_stmts bd)
  | SIf (cl, els) -> imax (own_num_clauses cl) (own_num_stmts els)
  | _ -> 0
and own_num_clauses = fn (cl: (Expr * Stmt list) list) -> match cl with Nil -> 0 | Cons ((c, bd), r) -> imax (imax (own_num_expr c) (own_num_stmts bd)) (own_num_clauses r)
and own_num_expr = fn (e: Expr) ->
  match e with
  | EVar n -> numbered_digit n
  | EBin (_, a, b) -> imax (own_num_expr a) (own_num_expr b)
  | EUn (_, a) -> own_num_expr a
  | ECall (_, args) -> own_num_exprs args
  | EMethod (r, _, args) -> imax (own_num_expr r) (own_num_exprs args)
  | EMethodB (r, _, args, _, _) -> imax (own_num_expr r) (own_num_exprs args)
  | ECallB (_, args, _, _) -> own_num_exprs args
  | EArr es -> own_num_exprs es
  | EHsh es -> own_num_exprs es
  | ETern (a, b, c) -> imax (imax (own_num_expr a) (own_num_expr b)) (own_num_expr c)
  | EYield es -> own_num_exprs es
  | _ -> 0
and own_num_exprs = fn (es: Expr list) -> match es with Nil -> 0 | Cons (e, r) -> imax (own_num_expr e) (own_num_exprs r)
// a nested block/lambda (in this scope) whose OWN scope references a numbered param.
and nested_num_stmts = fn (b: Stmt list) -> match b with Nil -> false | Cons (s, r) -> nested_num_stmt s || nested_num_stmts r
and nested_num_stmt = fn (s: Stmt) ->
  match s with
  | SExpr e -> nested_num_expr e
  | SAssign (_, e) -> nested_num_expr e
  | SReturn e -> nested_num_expr e
  | SIVarAssign (_, e) -> nested_num_expr e
  | SPuts es -> nested_num_exprs es
  | SWhile (c, bd) -> nested_num_expr c || nested_num_stmts bd
  | SIf (cl, els) -> nested_num_clauses cl || nested_num_stmts els
  | _ -> false
and nested_num_clauses = fn (cl: (Expr * Stmt list) list) -> match cl with Nil -> false | Cons ((c, bd), r) -> nested_num_expr c || nested_num_stmts bd || nested_num_clauses r
and nested_num_expr = fn (e: Expr) ->
  match e with
  | ELambda (ps, b) -> (match ps with Nil -> own_num_stmts b > 0 || nested_num_stmts b | _ -> nested_num_stmts b)
  | ECallB (_, args, bp, bb) -> (match bp with Nil -> own_num_stmts bb > 0 || nested_num_stmts bb | _ -> nested_num_stmts bb) || nested_num_exprs args
  | EMethodB (r, _, args, bp, bb) -> (match bp with Nil -> own_num_stmts bb > 0 || nested_num_stmts bb | _ -> nested_num_stmts bb) || nested_num_expr r || nested_num_exprs args
  | EBin (_, a, b) -> nested_num_expr a || nested_num_expr b
  | EUn (_, a) -> nested_num_expr a
  | ECall (_, args) -> nested_num_exprs args
  | EMethod (r, _, args) -> nested_num_expr r || nested_num_exprs args
  | EArr es -> nested_num_exprs es
  | EHsh es -> nested_num_exprs es
  | ETern (a, b, c) -> nested_num_expr a || nested_num_expr b || nested_num_expr c
  | _ -> false
and nested_num_exprs = fn (es: Expr list) -> match es with Nil -> false | Cons (e, r) -> nested_num_expr e || nested_num_exprs r
// a block using a numbered param whose body also has a nested block using one
// is a SyntaxError ("numbered parameter is already used in outer block").
and num_nested_bad = fn (bb: Stmt list) -> own_num_stmts bb > 0 && nested_num_stmts bb

and numbered_misuse_expr = fn (e: Expr) ->
  match e with
  // ⚠ `-> (x) { it }` too. This arm asked only about numbered parameters, so
  // the `->` literal was the one block form that accepted `it` beside an
  // explicit parameter list -- `proc { |x| it }` was already refused.
  | ELambda (ps, b) ->
    (match ps with
     | Nil -> num_nested_bad b || numbered_misuse_stmts b
     | _ -> if blk_num_bad ps b then true else numbered_misuse_stmts b)
  | ECallB (_, args, bp, bb) -> blk_num_bad bp bb || (match bp with Nil -> num_nested_bad bb | _ -> false) || numbered_misuse_exprs args || numbered_misuse_stmts bb
  | EMethodB (r, _, args, bp, bb) -> blk_num_bad bp bb || (match bp with Nil -> num_nested_bad bb | _ -> false) || numbered_misuse_expr r || numbered_misuse_exprs args || numbered_misuse_stmts bb
  | EBin (_, a, b) -> numbered_misuse_expr a || numbered_misuse_expr b
  | EUn (_, a) -> numbered_misuse_expr a
  | ECall (_, args) -> numbered_misuse_exprs args
  | EMethod (r, _, args) -> numbered_misuse_expr r || numbered_misuse_exprs args
  | EArr es -> numbered_misuse_exprs es
  | EHsh es -> numbered_misuse_exprs es
  | ETern (a, b, c) -> numbered_misuse_expr a || numbered_misuse_expr b || numbered_misuse_expr c
  | _ -> false
and numbered_misuse_exprs = fn (es: Expr list) ->
  match es with Nil -> false | Cons (e, r) -> numbered_misuse_expr e || numbered_misuse_exprs r

// a lambda's strict arity counts POSITIONAL arguments: a trailing keyword hash
// belongs to the keyword parameters, and counting it as positional made
// `->(x: 3){ }.call(x: 9)` "wrong number of arguments (given 1, expected 0)".
// Both places that check a lambda's arity go through this.
and lambda_arity_check_args = fn world -> fn (ps: str list) -> fn (body: Stmt list) -> fn (args: Val list) ->
  let wants_kw9 = (match kw_params ps with
                   | Nil -> (if str_eq (dsplat_name ps) "" then false else true)
                   | _ -> true) in
  let n9 = (if wants_kw9 then (match peel_kw_hash args with (pos9, _) -> vlen pos9)
            else vlen args) in
  lambda_arity_check world ps body n9

and lambda_arity_check = fn world -> fn (ps0: str list) -> fn (body: Stmt list) -> fn (nargs: int) ->
  // an explicit-empty param list (`{ || }`) behaves like zero params.
  let ps0 = (match ps0 with Cons (m, rest) -> if str_eq m lambda_blk_marker then rest else ps0 | _ -> ps0) in
  let ps = (match ps0 with Cons (m, Nil) -> if str_eq m empty_bp_marker then (Nil : str list) else ps0 | _ -> ps0) in
  let nps = list_str_len (strip_block_params ps) in
  (match ps with
   // no explicit params: arity 0 (strict) unless the body uses numbered
   // params (_1..), in which case it absorbs args (kept lenient).
   | Nil ->
     // ⚠ a LAMBDA is strict about its implicit parameters too: `-> { _1 }`
     // wants exactly one argument and `-> { _2 }` exactly two, the same way
     // `-> { }` wants none. This arm used to wave through any count once the
     // body named one, so `-> { it }.call("a", "b")` answered "a".
     (let want9 = implicit_params_of body in
      if nargs == want9 then ()
      else let _ = raise_exc world "ArgumentError"
             ("wrong number of arguments (given " ++ str_of_int nargs
              ++ ", expected " ++ str_of_int want9 ++ ")") in ())
   | _ ->
     // positional-only params (drop &blk / **kw / key: keyword params); the
     // required count (no default) is the minimum, and without a splat the
     // total positional count is the maximum.
     let pp = pos_params (drop_dsplat (strip_block_params ps)) in
     let bdefaults = block_defaults body in
     if has_splat pp then
       let before = take_until_splat pp in
       let after = after_splat pp in
       let minreq = list_str_len (req_pre before bdefaults) + list_str_len after in
       // a trailing-comma splat ("|a,|") takes no extra args, so it has an
       // exact upper bound like a splat-free param list; a real "*" does not.
       if str_list_has pp "*," then
         let maxp = list_str_len before + list_str_len after in
         if nargs >= minreq && nargs <= maxp then ()
         else let _ = raise_exc world "ArgumentError"
                ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected " ++ str_of_int maxp ++ ")") in ()
       else if nargs >= minreq then ()
       else let _ = raise_exc world "ArgumentError"
              ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected " ++ str_of_int minreq ++ "+)") in ()
     else
       let minreq = list_str_len (req_pre pp bdefaults) in
       let maxp = list_str_len pp in
       if nargs >= minreq && nargs <= maxp then ()
       else let _ = raise_exc world "ArgumentError"
              ("wrong number of arguments (given " ++ str_of_int nargs ++ ", expected " ++ str_of_int maxp ++ ")") in ())

// the block tuple for a proc used as a block; a lambda gets the marker
// prepended to its params so run_block enforces strict arity.
// A block literal whose body yields remembers the block that was active where
// it was written, so the yield still reaches THAT method's block after the
// literal has been handed to another method (which installs its own). Only
// bodies that actually yield pay for this.
// `public def m` at the top level: copy the top-level method into Object's
// table, where every receiver's lookup ends up.


and blk_capture = fn cur -> fn theblk -> fn (body: Stmt list) ->
  match cur with
  | (true, _, _, _) ->
    (if bare_yield_stmts body then
       (let pid = map_len proc_store in
        let _ = store_proc (str_of_int pid) cur in
        let _ = store_yblk (str_of_int pid) cur in
        match theblk with (h, ps, b, e) -> (h, Cons (yblk_marker ++ str_of_int pid, ps), b, e))
     else theblk)
  | _ -> theblk

// The at_exit handlers, newest first. They are taken out of the store before
// any of them runs, so a handler that calls `exit` (or registers another one)
// cannot make them run twice.

and run_at_exits = fn world ->
  let n = map_len at_exits in
  if n == 0 then ()
  else
    (let xs = at_exit_list 0 n Nil in
     let _ = map_clear at_exits in
     run_at_exit_procs world xs)

and run_at_exit_procs = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> ()
  | Cons (VProc pid, rest) ->
    // one handler raising does not stop the others, as in ruby
    let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    let _ = try_or (fn (u: unit) -> run_block world nb (proc_as_block pid) Nil) (FNext VNil) in
    run_at_exit_procs world rest
  | Cons (_, rest) -> run_at_exit_procs world rest

// a fresh proc that stands for "this target, these arguments so far, this
// arity". `like` is the proc whose lambda-ness it inherits (curry preserves
// it, and so does each partial application).
// a proc that runs `inner` and then `outer` on its result. The composition is
// a lambda exactly when the FIRST-CALLED one is: that is the one whose arity is
// checked, which is why `l >> f` is a lambda and `f >> l` is not.
// calling a proc that has no body of its own -- a composition or a curried
// collector. Both dispatch paths (with a block and without) reach this, so
// neither has to know how the other one works and neither can hand the call
// back to the other.
and proc_derived_call = fn env -> fn world -> fn blk -> fn (pid: int) -> fn (args: Val list) ->
  if map_has comp_inner (str_of_int pid) then
    // a block given to the composition goes to the FIRST-CALLED one only:
    // `(one >> two).call { }` runs one with the block and two without it.
    (let inner9 = map_get comp_inner (str_of_int pid) in
     let outer9 = map_get comp_outer (str_of_int pid) in
     let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
     let mid9 = invoke_val_c env world blk inner9 "call" args false in
     invoke_val_c env world noblk9 outer9 "call" (Cons (mid9, Nil)) false)
  else
    (let tgt9 = (match map_get curry_target (str_of_int pid) with VInt t -> t | _ -> 0) in
     let want9 = (match map_get curry_arity (str_of_int pid) with VInt n -> n | _ -> 0) in
     let got9 = (match map_get curry_args (str_of_int pid) with VArr a -> deref a | _ -> Nil) in
     let all9 = rev_app (rev_app got9 Nil) args in
     if vlen all9 >= want9
     then invoke_val_c env world blk (VProc tgt9) "call" all9 false
     else mk_curried world tgt9 all9 want9 pid)




// &proc block-pass arguments.
// coerce a `&expr` value into a call block: a Proc uses its own block, nil
// means no block, a Symbol becomes a symbol-proc, and anything else is
// converted eagerly via #to_proc (so its side effects run at the call site).
and coerce_to_block = fn env -> fn world -> fn blk -> fn (bv: Val) ->
  match bv with
  | VProc pid ->
    // forward the proc's home frame so the callee's `break` targets it.
    let _ = if map_has proc_home (str_of_int pid) then map_set pending_home "v" (map_get proc_home (str_of_int pid)) else () in
    let _ = map_set pending_srcproc "v" pid in
    proc_as_block pid
  | VNil -> (false, (Nil : str list), (Nil : Stmt list), env)
  | VSym s -> (true, Cons ("__bp", Nil), Cons (SExpr (EMethod (EVar "__bp", s, Nil)), Nil), env)
  | _ ->
    let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
    (match invoke_val_c env world noblk bv "to_proc" Nil false with
     // the proc #to_proc answered IS the proc this block was made from -- a
     // Method's is a lambda, and `&m` lost that by not recording it here the
     // way the VProc arm above does.
     | VProc pid ->
       (let _ = if map_has proc_home (str_of_int pid) then map_set pending_home "v" (map_get proc_home (str_of_int pid)) else () in
        let _ = map_set pending_srcproc "v" pid in
        proc_as_block pid)
     | _ -> noblk)

// ⚠ Seven methods take an ARGUMENT or a block, never both -- and with an
// argument ruby ignores the block, says so, and answers from the argument.
// mere-ruby did the opposite: it used the BLOCK and ignored the argument, so
//
//     ['bar', 'foobar'].any?(/bar/) { false }   ruby true   here false
//     [1, 2, 1].count(1) { false }              ruby 2      here 0
//     [1, 2].find_index(2) { false }            ruby 1      here nil
//
// The missing warning is the visible half; the wrong answer is the half that
// matters, and thirty-five recorded rows sit on one or the other.

// An interpreter-issued warning, in ruby's shape: "<file>:<line>: warning:
// <text>" on $stderr, and SILENT when $VERBOSE is nil -- the same gate
// Kernel#warn answers to (false, the default, still warns).
and rb_warn = fn world -> fn (msg: str) ->
  (if (if map_has globals (gvar_slot "VERBOSE")
       then (match map_get globals (gvar_slot "VERBOSE") with VNil -> true | _ -> false)
       else false)
   then ()
   else err_emit world (cur_file () ++ ":" ++ str_of_int (cur_line ()) ++ ": warning: " ++ msg))

// Is this name answered by the interpreter (or the prelude's own modules)
// rather than by something the program wrote? ⚠ `has_meth` cannot tell: the
// prelude's Enumerable is a module IN the method table (Enumerable__Impl), so
// asking whether the class "has" the name calls every Enumerable receiver
// user-defined. The owner is the question.
and builtin_answers = fn world -> fn (recv: Val) -> fn (name: str) ->
  (let own9 = owner_anc world (ancestors_of world (dispatch_cls_of world recv)) name in
   str_eq own9 "" || str_eq own9 "Enumerable__Impl")

// `h.fetch(k, default) { }` / `[].fetch(i, default) { }` / `ENV.fetch(k, d) { }`
// / `Array.new(n, val) { }` -- a default value AND a block. The block wins (and
// already did here); ruby also says so. One argument plus a block is the
// ordinary form and warns about nothing, which is why the count is checked.

and invoke_with_block = fn env -> fn world -> fn blk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) -> fn newblk ->
    // the count is checked here too: a block is not an argument, and
    // `each_slice(2, 2) { }` is the same wrong count as without one.
    let __amb = builtin_arity_msg_b world recv name args true in
    if (if str_eq __amb "" then false else true) then raise_exc world "ArgumentError" __amb
    // the argument wins and the block is dropped (see arg_beats_block), unless
    // a USER class defines the name itself -- this is CRuby's builtin
    // behaviour, not a rule about the name.
    // ⚠ "does the class define it" is the wrong question: the prelude's own
    //   Enumerable lives in a module (Enumerable__Impl) and IS in the method
    //   table, so asking has_meth excluded every Enumerable receiver -- their
    //   answers were already right and the warning silently never fired. The
    //   question is who OWNS it: nobody (a pure builtin) or the prelude's
    //   module means this rule applies; a real class means the user wrote it.
    else
    // ...and the mirror case: a default value that the block supersedes. The
    // answer was already right here -- only the saying-so was missing -- so
    // this warns and lets the ordinary dispatch below run.
    let _ = (if block_supersedes_default world recv name args
                && (match newblk with (false, _, _, _) -> false | _ -> true)
                && builtin_answers world recv name
             then rb_warn world "block supersedes default value argument" else ()) in
    if arg_beats_block name
            && (match args with Nil -> false | _ -> true)
            && (match newblk with (false, _, _, _) -> false | _ -> true)
            && builtin_answers world recv name then
      (let _ = rb_warn world "given block not used" in
       invoke_val_c env world blk recv name args false)
    else
    // `&nil` (a forwarded &blk that was never given) is NOT a block: the call
    // is plain -- `a.__send__(:=~, x, &blk)` inside a forwarding method used
    // to fall into the iterator path and report =~ undefined. send unwraps
    // its method name FIRST (invoke_val_c has no send arm of its own).
    (match newblk with
     | (false, _, _, _) ->
       (if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send")
           && (if user_defines_send world recv name then false else true)
           && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false)
        // an unwrapped send BYPASSES visibility (public_send keeps it),
        // exactly as the blockless send arm does.
        then (let vis2 = str_eq name "public_send" in
              let m2 = send_name_arg env world args in
              let rest2 = (match args with Cons (_, r) -> r | Nil -> Nil) in
              let _ = (if vis2 then public_send_guard world recv m2 else ()) in
              invoke_val_c env world blk recv m2 rest2 vis2)
        // vischeck TRUE: this path is reached with an explicit receiver (a
        // bare call's own methods were dispatched by the caller), and a
        // forwarded private call must refuse -- `def foo(...) = @o.foo(...)`
        // to a private foo is NoMethodError.
        else invoke_val_c env world blk recv name args true)
     | _ ->
    // ⚠ ...and send unwraps its method name WITH a block too. Only the
    //   blockless branch above did it, so `__send__(:priv, &b)` dispatched the
    //   NAME "__send__" down the ordinary path and the visibility check
    //   refused -- `private method 'x' called`. csv/parser.rb's whole parse
    //   goes through `__send__(@parse_method, &block)` to a private method, so
    //   CSV loaded and then could not parse a single line. One name, two
    //   paths, and only the one without a block bypassed visibility.
    if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send")
       && (if user_defines_send world recv name then false else true)
       && (match args with Cons (VSym _, _) -> true | Cons (VStr _, _) -> true | _ -> false) then
      (let vis3 = str_eq name "public_send" in
       let m3 = send_name_arg env world args in
       let rest3 = (match args with Cons (_, r) -> r | Nil -> Nil) in
       let _ = (if vis3 then public_send_guard world recv m3 else ()) in
       // ⚠ invoke_with_block has no "bypass visibility" argument, so
       //   re-entering it with the unwrapped name would refuse a private
       //   target all over again. A user-defined method is called directly --
       //   `invoke` is the internal call and does not check.
       let cls3 = dispatch_cls_of world recv in
       if (if vis3 then false else true) && has_meth world cls3 m3
       then invoke world newblk recv cls3 m3 rest3
       else invoke_with_block env world blk recv m3 rest3 newblk)
    else
    // the block path skips invoke_val_c's argument conversion, so the string
    // methods that duck-type their arguments convert here too.
    let args = (if (match recv with VStr _ -> true | _ -> false)
                   && (str_eq name "upto" || str_eq name "each_line" || str_eq name "lines"
                       || str_eq name "split" || str_eq name "scan" || str_eq name "gsub" || str_eq name "sub"
                       || str_eq name "gsub!" || str_eq name "sub!")
                then coerce_str_int_args env world args
                else args) in
    // ⚠ Kernel#lambda / #proc / #loop reached with a RECEIVER: `send(:lambda)
    //   { }` inside a method has the enclosing object as its receiver, and this
    //   path answered "undefined method 'lambda'" -- they were only reachable
    //   as a bare call with a literal block. Kernel's methods belong to every
    //   object, however the call is spelled.
    if (str_eq name "proc" || str_eq name "lambda")
       && (let (m9, _, _, _) = world in if map_has m9 name then false else true)
       && (if has_meth world (dispatch_cls_of world recv) name then false else true) then
      (let id9 = map_len proc_store in
       let _ = store_proc (str_of_int id9) newblk in
       let _ = (if str_eq name "lambda" then map_set lambda_ids (str_of_int id9) VNil else ()) in
       VProc id9)
    else if str_eq name "loop"
            && (let (m9, _, _, _) = world in if map_has m9 name then false else true)
            && (if has_meth world (dispatch_cls_of world recv) name then false else true) then
      run_loop_builtin env world blk newblk
    // Object#then / yield_self: run the block with the receiver.
    else if str_eq name "then" || str_eq name "yield_self" then
      flow_value (run_block world blk newblk (Cons (recv, Nil)))
    // Object#tap: run the block with the receiver, then return the receiver.
    else if str_eq name "tap" then
      // `x.tap { break v }` answers v -- a break leaves the METHOD, and tap
      // returning its receiver regardless swallowed it.
      (match run_block world blk newblk (Cons (recv, Nil)) with
       | FBreak bv -> bv
       | other -> (let _ = flow_value other in recv))
    // recv.send(:m, args) { block } — forward the block to the sent method.
    else if (str_eq name "send" || str_eq name "__send__" || str_eq name "public_send") && (if user_defines_send world recv name then false else true) && (match args with Cons (_, _) -> true | _ -> false) then
      (let m3 = send_name_arg env world args in
       let rest3 = (match args with Cons (_, r) -> r | Nil -> Nil) in
       let _ = (if str_eq name "public_send" then public_send_guard world recv m3 else ()) in
       invoke_with_block env world blk recv m3 rest3 newblk)
    // `Method#call` with a BLOCK. tsort builds `method(:tsort_each_node)` and
    // calls it with the block that visits each node, so the block has to reach
    // the method the object names. The plain dispatcher hands a method no block
    // -- that is what makes it the plain one -- so re-dispatch on the Method's
    // own receiver here, carrying the block written at this call site, exactly
    // as `send` above forwards one.
    else if (str_eq name "call" || str_eq name "()" || str_eq name "[]" || str_eq name "===")
            && (if has_meth world "Method" name then false else true)
            && (match recv with
                | VObj mid -> (let (_, _, ocls9, _) = world in str_eq (map_get ocls9 mid) "Method")
                | _ -> false) then
      (match recv with
       | VObj mid ->
         (let (_, _, _, ivars9) = world in
          let mnm = (match map_get ivars9 (str_of_int mid ++ "@__m_name") with VStr h -> sget h | _ -> "") in
          let mrecv = (if map_has ivars9 (str_of_int mid ++ "@__m_recv") then map_get ivars9 (str_of_int mid ++ "@__m_recv") else VMain) in
          let mown = (match map_get ivars9 (str_of_int mid ++ "@__m_owner") with VStr h -> sget h | _ -> "") in
          match mrecv with
          | VMain -> call_method env world newblk mnm args
          | _ ->
            // A Method object may call a PRIVATE method -- it was obtained by
            // name, so calling it is not an implicit-receiver call. tsort does
            // exactly this: `tsort_each_node` is private in bundler's SpecSet.
            // The ordinary route through the block dispatcher applies
            // visibility, so invoke the method itself when it can be found.
            (let dcls = dispatch_cls_of world mrecv in
             let owner = (if str_eq mown "" then dcls else mown) in
             if has_meth world owner mnm then invoke world newblk mrecv owner mnm args
             else if has_meth world dcls mnm then invoke world newblk mrecv dcls mnm args
             else invoke_with_block env world blk mrecv mnm args newblk))
       | _ -> VNil)
    // `Signal.trap("INT") do ... end` -- the form every CLI actually writes, and
    // a block-carrying call never reaches the plain dispatcher where the rest of
    // Signal lives. The handler is recorded and never called (nothing here
    // delivers a signal); what matters is that the program starts.
    else if str_eq name "trap"
            && (match recv with VClass sc -> str_eq sc "Signal" | _ -> false) then
      (let sg = (match args with Cons (VStr h, _) -> sget h | Cons (VSym sy, _) -> sy
                               | Cons (VInt n, _) -> signal_name_of n | _ -> "") in
       let prev = (if map_has signal_traps sg then map_get signal_traps sg else mkstr "DEFAULT") in
       let _ = map_set signal_traps sg (mkstr "(block)") in
       prev)
    // `pr.call(x) { ... }` -- a Proc called with a block. The block belongs to
    // the proc's BODY (that is what makes `Method#to_proc` able to forward one:
    // `method(:m).to_proc.call(5) { }` has to reach `m`'s yield), and without
    // this arm the receiver was a Proc whose `call` could not be found at all,
    // which reported as NoMethodError on Proc.
    else if (str_eq name "call" || str_eq name "()" || str_eq name "[]" || str_eq name "yield")
            && (match recv with VProc _ -> true | _ -> false) then
      (match recv with
       // a COMPOSED or CURRIED proc has no body of its own to run: what it
       // does lives in the dispatcher, so send it back there carrying this
       // block. Running its (empty) stored block answered nil.
       | VProc pid ->
         (if map_has comp_inner (str_of_int pid) || map_has curry_target (str_of_int pid)
          then proc_derived_call env world newblk pid args
          else flow_value (run_block world newblk (map_get proc_store (str_of_int pid)) args))
       | _ -> VNil)
    // recv.define_method(:name) { block } with an explicit class receiver:
    // register the block as an instance method of that class (used on singleton
    // classes, e.g. (class << obj; self).define_method(...)).
    // define_singleton_method(:name) { }: the same as define_method, but the
    // method lands in the receiver's singleton namespace, so it is a class
    // method (or an object's own method).
    else if str_eq name "define_singleton_method" then
      (let (meths, sup, ocls, ivars) = world in
       let target = (match recv with
                     | VClass c -> "(sng:" ++ c ++ ")"
                     | VObj id -> singleton_cls_of world id
                     // nil / true / false have no singleton class of their own
                     // -- theirs IS the class -- and ruby lets you define one
                     // there anyway: `nil.define_singleton_method(:x)` defines
                     // a NilClass method, the way `def (nil).x` does. Refusing
                     // was the only answer here.
                     | VNil -> "NilClass"
                     | VBool b2 -> (if b2 then "TrueClass" else "FalseClass")
                     | _ -> "") in
       let nm = (match args with Cons (VSym s2, _) -> s2 | Cons (VStr s2, _) -> sget s2 | _ -> "") in
       let _ = frz_recv_check env world recv in
       if str_eq target "" then raise_exc world "TypeError" "can't define singleton"
       else
         (let (h2, ps2, bb2, e2) = newblk in
          let _ = set_meth meths (target ++ "#" ++ nm)
                    (Meth (drop_yblk_params ps2, block_defaults bb2, drop_defaults_prologue bb2)) in
          let _ = map_set dm_methods (target ++ "#" ++ nm) VNil in
          let _ = dm_store_closure (target ++ "#" ++ nm) (h2, ps2, bb2, e2) in
          let _ = stamp_meth_src (target ++ "#" ++ nm) in
          VSym nm))
    else if str_eq name "define_method" && (match recv with VClass _ -> true | _ -> false) then
      (match recv with
       | VClass c ->
         let _ = frz_cls_check world c in
         let (meths, sup, ocls, ivars) = world in
         let nm = (match args with Cons (VSym s, _) -> s | Cons (VStr s, _) -> sget s | _ -> "") in
         let (h2, ps2, bb2, e2) = newblk in
         // the block's OPTIONAL parameters are its method's defaults: they
         // live in the body as a prologue, and a Meth with an empty defaults
         // list treats every parameter as mandatory (a zero-argument call to
         // `define_method(:m) { |a = 5| }` was an arity error).
         let _ = set_meth meths (c ++ "#" ++ nm)
                   (Meth (drop_yblk_params ps2, block_defaults bb2, drop_defaults_prologue bb2)) in
         let _ = map_set dm_methods (c ++ "#" ++ nm) VNil in
         let _ = dm_store_closure (c ++ "#" ++ nm) (h2, ps2, bb2, e2) in
         let _ = stamp_meth_src (c ++ "#" ++ nm) in
         VSym nm
       | _ -> VNil)
    // ENV.fetch / ENV.delete with a block: the block supplies the value for
    // a missing key (fetch) or the return value (delete); an existing key
    // never runs the block.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls id) "EnvHash") | _ -> false)
            && (str_eq name "fetch" || str_eq name "delete") then
      (match args with
       | Cons (kv, _) ->
         (let k2 = env_key_of env world kv in
          match env_lookup_v k2 with
          | VNil -> flow_value (run_block world blk newblk (Cons (mkstr k2, Nil)))
          | v -> (if str_eq name "delete" then (let _ = map_set env_ovr k2 VNil in v) else v))
       | _ -> VNil)
    // ENV with a block. Same idea as the block-free arm: what ENV answers, it
    // answers as a hash. Delegate to a hash built from the environment, and for
    // the mutating names write the hash back afterwards -- which gets ruby's
    // own semantics for each / each_pair / select / reject / delete_if /
    // keep_if / partition / group_by / sum / min_by / ... instead of an arm per
    // name, each written once and each able to be subtly different.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls id) "EnvHash") | _ -> false) then
      (// ⚠ a mutator this does not know about must not run on the copy and
       //   report success while the environment stands still. Ends in ! or = is
       //   a rule; the ones that end in neither are named.
       //   ...and the SAME list has to appear in both places the refusal is
       //   written, which is why `ENV.merge!(h) { }` stayed refused after the
       //   block-free path was fixed: one rule, two copies.
       if (str_ends_with name "!" || str_ends_with name "=")
          && not (str_eq name "reject!" || str_eq name "select!" || str_eq name "filter!"
                  || str_eq name "merge!") then
         raise_exc world "NotImplementedError"
           ("mere-ruby: ENV." ++ name ++ " is not implemented (it would change the environment)")
       else
         let mutates = str_eq name "delete_if" || str_eq name "keep_if"
                       || str_eq name "reject!" || str_eq name "select!" || str_eq name "filter!"
                       || str_eq name "merge!" || str_eq name "update" in
         // the names whose answer is ENV itself rather than a new collection
         let self_ret = mutates || str_eq name "each" || str_eq name "each_pair"
                        || str_eq name "each_key" || str_eq name "each_value" in
         let h = mkhash (env_hash_list ()) in
         let r = invoke_with_block env world blk h name args newblk in
         let _ = (if mutates
                  then (let _ = env_del_keys (env_hl_keys (env_hash_list ())) in
                        (match h with VHsh hid -> env_set_pairs env world (hderef hid) | _ -> ()))
                  else ()) in
         // reject!/select!/filter! answer nil when nothing changed; the rest of
         // the self-returning names answer ENV.
         //
         // ⚠ ...unless the block BROKE. `ENV.each_pair { break x }` is x, not
         // ENV, and the delegate hash says which happened: it answers ITSELF
         // when the walk finished and the break's value when it did not.
         // Answering `recv` either way swallowed every break value.
         (let finished9 = (match (r, h) with (VHsh a9, VHsh b9) -> a9 == b9 | _ -> false) in
          match r with
          | VNil -> if mutates then VNil else (if self_ret then recv else r)
          | other -> if self_ret && finished9 then recv else other))
    // Mutex#synchronize { }: lock, run, unlock — the unlock behaves like an
    // ensure (a raising block still releases before the raise continues).
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls id) "Mutex") | _ -> false)
            && str_eq name "synchronize" then
      (let _ = invoke_val_c env world blk recv "lock" Nil false in
       let result = try_or (fn (u: unit) -> run_block world blk newblk Nil) (FRaise VNil) in
       (match result with
        | FRaise _ ->
          let (m0, s0, ocls0, iv0) = world in
          let exc = (if map_has iv0 "$exc" then map_get iv0 "$exc" else VNil) in
          let _ = invoke_val_c env world blk recv "unlock" Nil false in
          (match exc with
           | VNil -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: (ruby exception raised)")) in fail "mere-ruby: (ruby exception raised)")
           | e -> flow_value (re_raise world e))
        | other ->
          let _ = invoke_val_c env world blk recv "unlock" Nil false in
          flow_value other))
    // Thread.new/start/fork with a block routes through the class-method
    // dispatcher below (same file), so nothing needed here.
    // File#each_line { block }: materialize the lines and drive Array#each.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls id) "File") | _ -> false)
            && (str_eq name "each_line" || str_eq name "each") then
      (match recv with
       | VObj id ->
         (let (m0, s0, ocls0, iv0) = world in
          let path = (match (if map_has iv0 (str_of_int id ++ "@__f_path") then map_get iv0 (str_of_int id ++ "@__f_path") else VNil) with VStr h -> sget h | _ -> "") in
          let content = (if file_exists path then read_file path else "") in
          let av = file_lines_arr content 0 in
          invoke_with_block env world blk av "each" Nil newblk)
       | _ -> VNil)
    // Enumerator#each { block }: drive the captured @recv.@meth with this
    // block. `for x in enum_for(:m)` desugars to `enum.each { |__for| ... }`,
    // and #each just forwards to the underlying method (whose `yield` runs the
    // block); the method's return value becomes #each's (and the loop's) value.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in is_enum_cls (map_get ocls id)) | _ -> false)
            && str_eq name "each" then
      (match recv with
       | VObj id ->
         (let (m0, s0, ocls0, ivars0) = world in
          if map_has ivars0 (str_of_int id ++ "@__e_blk") then
            // generator form: run the stored block with a yielder that
            // forwards each y << v / y.yield(v) to the caller's block.
            (match map_get ivars0 (str_of_int id ++ "@__e_blk") with
             | VProc gpid ->
               let bpid = map_len proc_store in
               let _ = store_proc (str_of_int bpid) newblk in
               let yid = alloc_oid ocls0 in
               let _ = map_set ocls0 yid "Enumerator::Yielder" in
               let _ = map_set ivars0 (str_of_int yid ++ "@__y_blk") (VProc bpid) in
               let _ = flow_value (run_block world blk (map_get proc_store (str_of_int gpid)) (Cons (VObj yid, Nil))) in
               recv
             | _ -> VNil)
          else
          let recv2 = (if map_has ivars0 (str_of_int id ++ "@recv") then map_get ivars0 (str_of_int id ++ "@recv") else VNil) in
          let meth2 = (match (if map_has ivars0 (str_of_int id ++ "@meth") then map_get ivars0 (str_of_int id ++ "@meth") else mkstr "each") with VStr h -> sget h | _ -> "each") in
          // the arguments `to_enum(:m, a, b)` recorded are the call's, not
          // whatever was handed to `each`.
          let eargs = (match (if map_has ivars0 (str_of_int id ++ "@eargs") then map_get ivars0 (str_of_int id ++ "@eargs") else VNil) with VArr aid3 -> deref aid3 | _ -> Nil) in
          let cargs = (match eargs with Nil -> args | _ -> eargs) in
          let r9 = drive_enum env world blk recv2 meth2 cargs newblk in
          // an ArithmeticSequence's each { } answers the sequence itself
          if str_eq (map_get ocls0 id) "Enumerator::ArithmeticSequence" then recv else r9)
       | _ -> VNil)
    // Enumerator::Lazy with a block: pipeline ops are appended lazily; #each
    // drives the pipeline with the block as the final consumer.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls id) "Enumerator::Lazy") | _ -> false) then
      (match recv with
       | VObj id ->
         (if str_eq name "map" || str_eq name "collect" || str_eq name "select" || str_eq name "filter" ||
             str_eq name "find_all" || str_eq name "reject" || str_eq name "filter_map" ||
             str_eq name "take_while" || str_eq name "drop_while" then
            (let pid = map_len proc_store in
             let _ = store_proc (str_of_int pid) newblk in
             let kind = (if str_eq name "collect" then "map"
                         else if str_eq name "filter" || str_eq name "find_all" then "select"
                         else name) in
             lz_extend world id kind (VProc pid))
          else if str_eq name "each" then
            (let pid = map_len proc_store in
             let _ = store_proc (str_of_int pid) newblk in
             let _ = lz_run env world blk id (0 - 1) (VProc pid) in
             recv)
          else invoke_with_block env world blk (lz_run env world blk id (0 - 1) VNil) name args newblk)
       | _ -> VNil)
    // Enumerator::Chain#each { }: drive each source's #each with the block.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in str_eq (map_get ocls id) "Enumerator::Chain") | _ -> false)
            && str_eq name "each" then
      (match recv with
       | VObj id -> (let _ = chain_drive env world blk (chain_srcs world id) newblk in recv)
       | _ -> VNil)
    // other Enumerator methods (map/select/... with a block): materialize the
    // elements, then run the array operation with the same block.
    else if (match recv with VObj id -> (let (_, _, ocls, _) = world in is_enum_cls (map_get ocls id)) | _ -> false)
            && (is_enum_method name || str_eq name "each_with_index" || str_eq name "with_index" || str_eq name "with_object" || str_eq name "each_slice" || str_eq name "each_cons") then
      (match recv with
       | VObj id ->
         (if str_eq name "with_index" then
            // `with_index` keeps the SOURCE method's meaning: `map.with_index`
            // collects the block's values, `select.with_index` keeps elements,
            // `each.with_index` answers the receiver. So pair the elements with
            // their index and run that source method over the pairs.
            (let (_, _, _, iv9) = world in
             let off = (match args with Cons (VInt o, _) -> o | _ -> 0) in
             let src = (match (if map_has iv9 (str_of_int id ++ "@meth") then map_get iv9 (str_of_int id ++ "@meth") else mkstr "each") with VStr h -> sget h | _ -> "each") in
             // ruby's with_index does NOT materialise and re-run: it calls the
             // source method ONCE with the block wrapped in an index counter, so a
             // source that decides how far to walk from the block's VALUE -- find,
             // take_while, drop_while, sort_by, the whole *_by family -- sees the
             // caller's real values. Two phases cannot answer that: the walk that
             // materialises has to return something to the source, and whatever it
             // returns is a different walk from the caller's.
             if map_has iv9 (str_of_int id ++ "@recv") then
               (let recv2 = map_get iv9 (str_of_int id ++ "@recv") in
                let eargs = (match (if map_has iv9 (str_of_int id ++ "@eargs") then map_get iv9 (str_of_int id ++ "@eargs") else VNil) with
                             | VArr aid3 -> deref aid3
                             | _ -> Nil) in
                invoke_with_block env world blk recv2 src eargs (wi_index_block newblk off))
             else if map_has iv9 (str_of_int id ++ "@__e_blk") then
               // A generator has no source method to call again, but it has the
               // block that yields: run THAT with the same wrapper, through a
               // Yielder, exactly as materialising it does. Its own value is the
               // answer, as in ruby.
               (match map_get iv9 (str_of_int id ++ "@__e_blk") with
                | VProc gpid ->
                  (let (_, _, ocls9, _) = world in
                   // the wrapper is built FIRST: it stores the caller's block at
                   // `map_len proc_store` itself, so taking the id before building
                   // it hands out the same slot twice -- the wrapper overwrote the
                   // block it wraps and then called itself, forever.
                   let wrapped = wi_index_block newblk off in
                   let bpid = map_len proc_store in
                   let _ = store_proc (str_of_int bpid) wrapped in
                   let yid = alloc_oid ocls9 in
                   let _ = map_set ocls9 yid "Enumerator::Yielder" in
                   let _ = map_set iv9 (str_of_int yid ++ "@__y_blk") (VProc bpid) in
                   flow_value (run_block world blk (map_get proc_store (str_of_int gpid)) (Cons (VObj yid, Nil))))
                | _ -> VNil)
             else
             // Anything else (a produce form) is materialised and walked as pairs.
             let av = enum_to_arr env world blk id in
             (match av with
              | VArr aid2 ->
                (let pairs = arr_new (with_index_pairs_off (deref aid2) off) in
                 // each_with_object's memo is the enumerator's own argument and is
                 // also its answer; running the source again over the pairs would
                 // build a SECOND memo and nest it inside the block's first
                 // parameter, so walk the pairs and answer the memo that exists.
                 if str_eq src "each_with_object" then
                   (let memo = (match (if map_has iv9 (str_of_int id ++ "@eargs") then map_get iv9 (str_of_int id ++ "@eargs") else VNil) with
                                | VArr eid9 -> (match deref eid9 with Cons (m, _) -> m | _ -> VNil)
                                | _ -> VNil) in
                    let _ = invoke_with_block env world blk pairs "each" Nil newblk in
                    memo)
                 else
                 let r = invoke_with_block env world blk pairs (if str_eq src "each" then "each" else src) Nil newblk in
                 // What the source ANSWERS decides how much of the pairing has to
                 // be undone: one that answers ELEMENTS (a filter, a sort, a search)
                 // answers PAIRS here, while one that answers the BLOCK's values
                 // (map, flat_map, sum) is already right. Only the filters were
                 // listed, so `matching.sort_by.with_index { |spec, i| ... }` -- how
                 // rubygems 4 orders platform matches -- answered [spec, index]
                 // pairs, and bundler then called LazySpecification's methods on an
                 // Array. The *_by family, the searches, partition and group_by are
                 // the same question in five shapes.
                 if wi_answers_elems src then
                   (match r with VArr rid -> arr_new (pair_firsts (deref rid)) | _ -> r)
                 else if wi_answers_one_elem src then
                   (match r with VArr rid -> (match deref rid with Cons (a, _) -> a | _ -> r) | _ -> r)
                 else if str_eq src "partition" then
                   (match r with VArr rid -> arr_new (wi_unwrap_each (deref rid)) | _ -> r)
                 else if str_eq src "group_by" then
                   (match r with VHsh hid -> mkhash (wi_unwrap_vals (hderef hid)) | _ -> r)
                 else if str_eq src "each" then
                   (if map_has iv9 (str_of_int id ++ "@recv") then map_get iv9 (str_of_int id ++ "@recv") else r)
                 else r)
              | _ -> VNil))
          else if str_eq name "with_object" then
            invoke_with_block env world blk (enum_to_arr env world blk id) "each_with_object" args newblk
          // Enumerator#each with a block IS the source method with that block --
          // `set.classify.each { |x| x.length }` is `set.classify { ... }`, and
          // materialising instead answered the elements. A generator (no source
          // to call) still materialises, below.
          else if str_eq name "each" && (let (_, _, _, ivb) = world in map_has ivb (str_of_int id ++ "@recv")) then
            (let (_, _, _, ivb) = world in
             let recv2 = map_get ivb (str_of_int id ++ "@recv") in
             let src2 = (match (if map_has ivb (str_of_int id ++ "@meth") then map_get ivb (str_of_int id ++ "@meth") else mkstr "each") with VStr h -> sget h | _ -> "each") in
             let eargs2 = (match (if map_has ivb (str_of_int id ++ "@eargs") then map_get ivb (str_of_int id ++ "@eargs") else VNil) with
                           | VArr aid3 -> deref aid3
                           | _ -> Nil) in
             invoke_with_block env world blk recv2 src2 eargs2 newblk)
          else
            invoke_with_block env world blk (enum_to_arr env world blk id) (if str_eq name "with_index" then "each_with_index" else name) args newblk)
       | _ -> VNil)
    // instance_eval/instance_exec (block form) on a non-class receiver: run
    // the block with `self` rebound to the receiver. instance_exec forwards
    // the call args to the block; instance_eval passes the receiver itself.
    else if (str_eq name "instance_eval" || str_eq name "instance_exec")
            && (match recv with VClass _ -> false | _ -> true) then
      (let (h3, ps3, bb3, e3) = newblk in
       // defining on an immediate's (absent) singleton class is a TypeError.
       if imm_no_singleton recv && body_defines bb3 then raise_exc world "TypeError" "can't define singleton"
       else
       // rebind self in a COPY of the block's captured env, not the shared
       // env itself: a nested call of the same proc (`pr.call` inside the
       // instance_eval'd pr) must still see the proc's own lexical self.
       // the BLOCK form of instance_eval takes no arguments (only instance_exec
       // forwards them), and ruby counts them before running anything. This
       // silently ignored the extras and ran the block.
       if str_eq name "instance_eval" && (match args with Nil -> false | _ -> true) then
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (vlen args) ++ ", expected 0)")
       else
       // ⚠ a CHILD scope, not a flat COPY. The copy kept a nested call of the
       //   same proc seeing its own lexical self -- which a child does too,
       //   since that call builds its frame from the proc's captured env --
       //   but it also threw away every ASSIGNMENT to an outer local:
       //   `x = nil; o.instance_exec { x = 5 }` left x nil, where a plain
       //   block sets it. mspec's `before :each` assigns describe-level locals
       //   exactly that way, so a whole spec file ran against nil.
       let e3c = lv_child e3 in
       let _ = map_set e3c "self" recv in
       // ...and the DEFAULT DEFINEE moves with it: a bare `def` in this block
       // belongs to the receiver's singleton class. Stored as the receiver
       // (not the class name) so the hidden singleton class is only created if
       // a def actually happens -- giving one to every instance_eval'd object
       // would change what `class`, `clone` and `singleton_class?` answer.
       let _ = map_set e3c "__definee_recv" recv in
       let blkargs = if str_eq name "instance_exec" then args else Cons (recv, Nil) in
       flow_value (run_block world blk (h3, ps3, bb3, e3c) blkargs))
    else
    (match recv with
     | VClass c ->
       // Proc.new { } captures the block; Class.new { } makes an anonymous
       // class whose body is the block; class_eval reopens the class.
       // A class with its OWN `self.new` gets it, block or no block: this path
       // went straight to the builtin allocator, so `Klass.new { }` ignored the
       // definition while `Klass.new` used it -- one method, two answers.
       if str_eq name "new" && has_meth world ("(sng:" ++ c ++ ")") name then
         invoke world newblk recv ("(sng:" ++ c ++ ")") name args
       else if str_eq c "Proc" && str_eq name "new" then
         // `Proc.new(&pr)` answers pr ITSELF, exactly as `proc(&pr)` does --
         // pending_srcproc is the proc the block was made from, and rebuilding
         // one out of the block lost both the identity and the lambda-ness.
         (if map_has pending_srcproc "v" then
            (let pid0 = map_get pending_srcproc "v" in
             let _ = map_delete pending_srcproc "v" in
             VProc pid0)
          else
          let id = map_len proc_store in let _ = store_proc (str_of_int id) newblk in
          let _ = if (let (h, _, _, _) = blk in h) then store_yblk (str_of_int id) blk else () in
          VProc id)
       // File.open(path, mode) { |f| ... }: open, run the block with the
       // handle, flush/close on exit, return the block's value.
       // Dir.chdir(path) { }: move, run the block, and move BACK -- including
       // when the block raises, which is what the ensure is for. Answers the
       // block's value, as ruby does. The move itself is dir_chdir_to, shared
       // with the blockless form.
       else if str_eq c "Dir" && str_eq name "chdir" then
         (let tgt = (match args with Cons (VStr ph, _) -> sget ph | _ -> env_get "HOME") in
          let back = env_get "PWD" in
          if (if dir_chdir_to tgt == 0 then false else true) then
            raise_exc world "Errno::ENOENT" ("No such file or directory @ dir_chdir - " ++ tgt)
          else
            let r = try_or (fn (u: unit) -> flow_value (run_block world blk newblk (Cons (mkstr tgt, Nil)))) VNil in
            let _ = dir_chdir_to back in
            r)
       else if str_eq c "File" && (str_eq name "open" || str_eq name "new") then
         (let fobj = file_open_obj world (path_args (false, (Nil : str list), (Nil : Stmt list), env) world "open" args) in
          let r = flow_value (run_block world blk newblk (Cons (fobj, Nil))) in
          let _ = (match fobj with VObj fid -> file_close_obj world fid | _ -> ()) in
          r)
       // Fiber.new { }: minimal synchronous fiber — #resume runs the whole
       // body once (no suspension points in this model).
       else if str_eq c "Fiber" && str_eq name "new" then
         (let pid = map_len proc_store in
          let _ = store_proc (str_of_int pid) newblk in
          let (m3, s3, ocls3, iv3) = world in
          let fid = alloc_oid ocls3 in
          let _ = map_set ocls3 fid "Fiber" in
          let _ = map_set iv3 (str_of_int fid ++ "@__fb_blk") (VProc pid) in
          VObj fid)
       // Thread.new/start/fork { }: the synchronous thread model. The body
       // runs immediately as the "thread"; scheduler points (sleep /
       // Thread.pass / Thread.stop) park it by raising the internal
       // __ThreadPark (which runs ensure blocks and is invisible to a bare
       // rescue), and an exhausted iteration budget parks a spinning body
       // ("preempted, never rescheduled"). The object records the outcome:
       // completed (value), parked (status run/sleep), or died (exception,
       // re-raised by join/value).
       else if str_eq c "Thread" && (str_eq name "new" || str_eq name "start" || str_eq name "fork") then
         (let (m3, s3, ocls3, iv3) = world in
          let tid = alloc_oid ocls3 in
          let _ = map_set ocls3 tid "Thread" in
          let _ = map_set iv3 (str_of_int tid ++ "@__tst") (mkstr "run") in
          let _ = map_set all_thr (str_of_int (map_len all_thr)) (VObj tid) in
          let savedcur = (if map_has cur_thr "v" then map_get cur_thr "v" else VNil) in
          let _ = map_set cur_thr "v" (VObj tid) in
          let saved = (if map_has catch_depth "n" then map_get catch_depth "n" else VInt 0) in
          let _ = map_set catch_depth "n" (VInt 0) in
          // the BOOL, not the Val holding it: thread_flag is compacted at a
          // safepoint, and a Val read out of it is a pointer into the arena
          // that compaction frees. The body below runs safepoints, so keeping
          // the box across it would restore from freed memory -- which reads
          // back correctly almost always, and is a use-after-free every time.
          let savedtf = (if map_has thread_flag "n" then (match map_get thread_flag "n" with VBool b -> b | _ -> false) else false) in
          let _ = map_set thread_flag "n" (VBool true) in
          // $~ is per-thread in Ruby: the body starts with a fresh one and
                 // the Thread body outlives this call: its env chain is captured.
                 let _ = (let (_, _, _, tcenv) = newblk in mark_captured tcenv) in
          // the spawner's is restored afterwards.
          let savedtilde = (if map_has globals "~" then map_get globals "~" else VNil) in
          let _ = map_set globals "~" VNil in
          let savedbud = (if map_has step_budget "n" then map_get step_budget "n" else 0) in
          let _ = map_set step_budget "n" 2000 in
          let result = try_or (fn (u: unit) -> run_block world blk newblk args) (FRaise VNil) in
          let remaining = (if map_has step_budget "n" then map_get step_budget "n" else 0) in
          let newbud = savedbud - (2000 - remaining) in
          let _ = map_set step_budget "n" (if newbud < 1000 then 1000 else newbud) in
          let _ = map_set globals "~" savedtilde in
          let _ = map_set thread_flag "n" (VBool savedtf) in
          let _ = map_set catch_depth "n" saved in
          let _ = map_set cur_thr "v" savedcur in
          let _ =
            (match result with
             | FRaise _ ->
               (let exc = (if map_has iv3 "$exc" then map_get iv3 "$exc" else VNil) in
                let _ = (if map_has iv3 "$exc" then map_delete iv3 "$exc" else ()) in
                let _ = (if map_has prim_missing "n" then map_delete prim_missing "n" else ()) in
                let _ = (if map_has flow_sig "k" then map_delete flow_sig "k" else ()) in
                match exc with
                | VExc (c2, m2) ->
                  (if str_eq c2 "__ThreadPark" then
                     (if str_eq m2 "kill" then map_set iv3 (str_of_int tid ++ "@__tst") (VBool false)
                      else map_set iv3 (str_of_int tid ++ "@__tst") (mkstr m2))
                   else
                     let _ = map_set iv3 (str_of_int tid ++ "@__texc") exc in
                     map_set iv3 (str_of_int tid ++ "@__tst") VNil)
                | VNil ->
                  // no recorded ruby exception: budget exhaustion = a spinning
                  // body that was "preempted" (parked running).
                  (if remaining <= 0 then map_set iv3 (str_of_int tid ++ "@__tst") (mkstr "run")
                   else
                     let _ = map_set iv3 (str_of_int tid ++ "@__texc") (VExc ("StandardError", "error")) in
                     map_set iv3 (str_of_int tid ++ "@__tst") VNil)
                | other ->
                  let _ = map_set iv3 (str_of_int tid ++ "@__texc") other in
                  map_set iv3 (str_of_int tid ++ "@__tst") VNil)
             | other ->
               let _ = map_set iv3 (str_of_int tid ++ "@__tval") (flow_value other) in
               map_set iv3 (str_of_int tid ++ "@__tst") (VBool false)) in
          VObj tid)
       // Thread.new { } runs the block synchronously but with a FRESH catch
       // stack (a throw can't cross a thread boundary), returning a thread
       // object whose join is a no-op.
       else if str_eq c "Enumerator" && str_eq name "produce" then
         // Enumerator.produce(initial) { |x| next } — an infinite generator:
         // store the step block + seed; enum_take drives it boundedly.
         (let pid = map_len proc_store in
          let _ = store_proc (str_of_int pid) newblk in
          let (m3, s3, ocls3, iv3) = world in
          let eid = alloc_oid ocls3 in
          let _ = map_set ocls3 eid "Enumerator" in
          let _ = map_set iv3 (str_of_int eid ++ "@__e_step") (VProc pid) in
          let _ = map_set iv3 (str_of_int eid ++ "@__e_seed") (match args with Cons (v, _) -> v | _ -> VNil) in
          VObj eid)
       else if str_eq c "Enumerator" && str_eq name "new" then
         // Enumerator.new(size = nil) { |y| ... }: store the generator block
         // as a proc, and the optional size (#size returns / calls it).
         (let pid = map_len proc_store in
          let _ = store_proc (str_of_int pid) newblk in
          let (m3, s3, ocls3, iv3) = world in
          let eid = alloc_oid ocls3 in
          let _ = map_set ocls3 eid "Enumerator" in
          let _ = map_set iv3 (str_of_int eid ++ "@__e_blk") (VProc pid) in
          let _ = (match args with Cons (sz, _) -> map_set iv3 (str_of_int eid ++ "@__e_size") sz | _ -> ()) in
          VObj eid)
       // Struct.new(:a, :b) do ... end — build the struct class, then run the
       // block with self = the new class so its `def`s become instance methods.
       else if struct_generator_cls world c && str_eq name "new" then
         (match struct_build world c args with
          | VClass anon ->
            (let (h3, ps3, bb3, e3) = newblk in
             let bcref = (if lv_has e3 "__cref" then (match lv_get e3 "__cref" with VStr s -> let s = sget s in s | _ -> "") else "") in
             let _ = flow_value (register_class_blk world anon bb3 bcref e3) in
             VClass anon)
          | other -> other)
       else if str_eq c "Class" && str_eq name "new" then
         (let (meths2, sup2, ocls2, iv2) = world in
          let anon = fresh_anon "AnonClass_" in
          let _ = (match args with Cons (VClass sc, _) -> set_sup sup2 anon sc | _ -> ()) in
          let (h3, ps3, bb3, e3) = newblk in
          // a block is not a constant scope: classes/constants defined in it
          // go to the block's LEXICAL scope (its captured cref; "" = toplevel).
          let bcref = (if lv_has e3 "__cref" then (match lv_get e3 "__cref" with VStr s -> let s = sget s in s | _ -> "") else "") in
          let _ = flow_value (register_class_blk world anon bb3 bcref e3) in
          VClass anon)
       // Module.new { } — an anonymous module whose body is the block. Run the
       // block as a closure (outer locals stay visible/assignable) with self
       // rebound to the module, so top-level defs land on it (SDef keys off
       // self's class) and refine/using inside see the module as self.
       else if str_eq c "Module" && str_eq name "new" then
         (let (meths2, sup2, ocls2, iv2) = world in
          let anon = fresh_anon "AnonModule_" in
          let _ = map_set modules anon VNil in
          let (h3, ps3, bb3, e3) = newblk in
          let saved_self = if lv_has e3 "self" then lv_get e3 "self" else VNil in
          let _ = lv_set e3 "self" (VClass anon) in
          // ...and the DEFINEE with it. This block runs in the SHARED env, so
          // an enclosing instance_eval's definee was still in force and every
          // `def hello` in a `Module.new do .. end` written inside a spec
          // example became a singleton method of the example object.
          let saved_dr = if lv_has e3 "__definee_recv" then lv_get e3 "__definee_recv" else VNil in
          let saved_dc = if lv_has e3 "__definee_cls" then lv_get e3 "__definee_cls" else VNil in
          let _ = lv_set e3 "__definee_recv" VNil in
          let _ = lv_set e3 "__definee_cls" VNil in
          let saved_cref = cur_lex () in
          let _ = set_lex anon in
          // a `using` inside the block is scoped to it (like register_class):
          // snapshot/restore ref_active so refinements don't leak past the body.
          let saved_ref = map_copy ref_active in
          let _ = flow_value (run_block world blk newblk (Cons (VClass anon, Nil))) in
          let _ = restore_ref_active saved_ref in
          let _ = set_lex saved_cref in
          let _ = lv_set e3 "__definee_recv" saved_dr in
          let _ = lv_set e3 "__definee_cls" saved_dc in
          let _ = lv_set e3 "self" saved_self in
          VClass anon)
       // class_exec / module_exec differ from _eval only in taking arguments
       // (and never a string); with a block body the class-body treatment is
       // the same, and mere-ruby's blocks already ignore extra arguments.
       // `C.class_exec(5) { |x| ... }` -- the _exec forms pass their arguments to
       // the block, and a class BODY has no parameters to bind them to, so
       // every argument-taking form answered NoMethodError. Run it as a block
       // with self rebound to the class and the definee NAMED (the class for
       // class_exec/module_exec, its singleton for instance_exec), which is
       // what makes a `def` inside land in the right table.
       else if (str_eq name "class_exec" || str_eq name "module_exec" || str_eq name "instance_exec")
               && (match args with Nil -> false | _ -> true) then
         (let (h3, ps3, bb3, e3) = newblk in
          let e3c = lv_flat e3 in
          let _ = map_set e3c "self" (VClass c) in
          let _ = map_set e3c "__definee_cls" (mkstr (if str_eq name "instance_exec" then "(sng:" ++ c ++ ")" else c)) in
          flow_value (run_block world blk (h3, ps3, bb3, e3c) args))
       else if (str_eq name "class_eval" || str_eq name "module_eval" || str_eq name "instance_eval")
               && (match args with Nil -> false | _ -> true) then
         raise_exc world "ArgumentError"
           ("wrong number of arguments (given " ++ str_of_int (vlen args) ++ ", expected 0)")
       else if str_eq name "class_eval" || str_eq name "module_eval"
               || str_eq name "class_exec" || str_eq name "module_exec" then
         // run the body as class-body statements (defs go to the class), but a
         // bare Const inside resolves in the BLOCK's lexical scope (Ruby: a
         // block does not open a constant scope), not the receiver's namespace.
         (let (h3, ps3, bb3, e3) = newblk in
          let cscope = (if lv_has e3 "__cref" then (match lv_get e3 "__cref" with VStr s -> let s = sget s in s | _ -> "") else "") in
          flow_value (register_class_blk world c bb3 cscope e3))
       else if str_eq name "instance_eval" || str_eq name "instance_exec" then
         (let (h3, ps3, bb3, e3) = newblk in flow_value (register_class_ieval world c bb3))
       else if str_eq c "Array" && str_eq name "new" then
         // Array.new(n) { |i| ... }: the block's value per index, with the same
         // size refusal the value form gets (and a break answers its value).
         (match args with
          | Nil -> arr_new (Nil : Val list)
          | _ ->
            (let a9 = coerce_int_args env world args in
             let n9 = array_new_size env world a9 in
             let av9 = arr_new (Nil : Val list) in
             match av9 with
             | VArr aid9 ->
               // a `break` in the block is the CALL's answer, not the array
               // (array_new_blk read the break value as an element).
               (match arr_fill_go world blk newblk true aid9 VNil 0 n9 with
                | FBreak v -> v
                | _ -> av9)
             | _ -> av9))
       // Hash.new { |h, k| ... }: the block becomes the default for a miss.
       else if str_eq c "Hash" && str_eq name "new" then
         (let (args, kwerr) = hash_new_kw world args in
          if kwerr then VNil else
          (match args with
           | Cons (_, _) ->
             raise_exc world "ArgumentError" "wrong number of arguments (given 1, expected 0)"
           | Nil ->
         (let hv = mkhash Nil in
          // `Hash.new(&pr)`: the default_proc IS pr, not a copy of its body.
          let pid = (if map_has pending_srcproc "v" then map_get pending_srcproc "v"
                     else (let np = map_len proc_store in
                           let _ = store_proc (str_of_int np) newblk in np)) in
          let _ = (if map_has pending_srcproc "v" then map_delete pending_srcproc "v" else ()) in
          let _ = (match hv with VHsh hid -> hdproc_set hid (VProc pid) | _ -> ()) in
          hv)))
       // a SUBCLASS of Hash built with a block is still a hash: it is tagged and
       // its #initialize runs against real hash storage (`self[:k] = v` in there
       // has to work). Without this arm the block form made a plain object and
       // the first `[]=` inside initialize was a NoMethodError.
       else if str_eq name "new" && (if str_eq c "Hash" then false else obj_is_a world c "Hash") then
         (let v9 = mkhash Nil in
          let _ = map_set hng_store (hng_key v9) c in
          let _ = (if has_meth world c "initialize"
                   then (let _ = invoke world newblk v9 c "initialize" args in ())
                   else (match v9 with
                         | VHsh hid9 ->
                           (let pid9 = (let np9 = map_len proc_store in
                                        let _ = store_proc (str_of_int np9) newblk in np9) in
                            let _ = hdproc_set hid9 (VProc pid9) in ())
                         | _ -> ())) in
          v9)
       else if str_eq name "new" then new_obj_wb world c args newblk
       else if has_meth world ("(sng:" ++ c ++ ")") name then invoke world newblk recv ("(sng:" ++ c ++ ")") name args
       else if has_meth world "Module" name then invoke world newblk recv "Module" name args
       else if has_meth world "Class" name then invoke world newblk recv "Class" name args
       // `extend Enumerable` + `def self.each`: the block iterators come from
       // the class's own each, exactly as they do for an instance.
       else if has_meth world ("(sng:" ++ c ++ ")") "each" && is_enum_method name then
         builtin_iter world blk newblk (enum_collect world recv ("(sng:" ++ c ++ ")")) name args
       else prim_method recv name args
     | VObj id ->
       let (meths, sup, ocls, ivars) = world in
       let cls = map_get ocls id in
       // ARGF.each with a block: each(nil) yields the whole ARGV/stdin stream
       // as one record; plain each / each_line yields it line by line.
       if str_eq cls "ARGF" && (str_eq name "each" || str_eq name "each_line") then
         (match args with
          | Cons (VNil, _) ->
            let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
            let _ = flow_value (run_block world nb newblk (Cons (mkstr (argf_input ()), Nil))) in recv
          | _ ->
            let inp = argf_input () in
            let _ = arr_each world blk newblk (val_list_of_strs (str_lines_go inp 0 0 (str_len inp))) in recv)
       else if has_meth world cls name then
         (if meth_private world cls name
          then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for " ++ for_recv_cls world cls)
          else invoke world newblk recv cls name args)
       // Enumerable: synthesize block iterators from the user's `each`.
       else if has_meth world cls "each" && (is_enum_method name || enum_arg_iter name) then
         // ...but each_slice / each_cons answer the RECEIVER, and the array
         // they were driven through would answer itself.
         (if enum_arg_iter name && (if str_eq name "cycle" then false else true)
          then (let _ = builtin_iter world blk newblk (enum_collect world recv cls) name args in recv)
          else builtin_iter world blk newblk (enum_collect world recv cls) name args)
       // a synthetic class's own method, reached with a block in hand (often a
       // nil one, from `__send__(m, *args, &block)` forwarding): the block
       // dispatcher has no branch for it, so hand it to the plain one.
       else if builtin_obj_has cls name then invoke_val_c env world blk recv name args false
       else if is_sng_cls cls && builtin_obj_has (sng_supername world cls) name then invoke_val_c env world blk recv name args false
       else if has_meth world cls "method_missing" then invoke world newblk recv cls "method_missing" (Cons (VSym name, args))
       else raise_exc_iv world "NoMethodError" ("undefined method '" ++ name ++ "' for " ++ for_recv_obj env world recv cls)
           (Cons (("__name", VSym name), Cons (("__args", arr_new args), Cons (("__recv", recv), Nil))))
     // `blk` (the enclosing method's block) is threaded so a yield inside
     // the iterated block reaches it (e.g. `@xs.each { |n| yield(n) }`).
     | _ ->
       // the in-place mutators below are reached with a block, ahead of
       // builtin_iter's guard, so the frozen check has to happen here too.
       if is_mutating_method name && val_frozen_mut recv then
         raise_exc_iv world "FrozenError" ("can't modify frozen " ++ class_name recv ++ ": " ++ inspect recv) (Cons (("__recv", recv), Nil))
       else
       // a reopened built-in class's method (with the call-site block) wins
       // over the hardcoded iterators.
       let pcls = class_name recv in
       // ...and so does a SUBCLASS's: a tagged Hash/Array whose class defines
       // the method answers with it, and one that defines `each` supplies every
       // Enumerable method through that each (`cls.new.map { }` has to go
       // through the subclass's each, which is where its bookkeeping happens).
       let tcls9 = dispatch_cls_of world recv in
       if (if str_eq tcls9 pcls then false else true) && has_meth world tcls9 name then
         invoke world newblk recv tcls9 name args
       else if (if str_eq tcls9 pcls then false else true)
               && has_meth world tcls9 "each" && is_enum_method name
               && (if str_eq name "each" then false else true) then
         builtin_iter world blk newblk (enum_collect world recv tcls9) name args
       else if has_meth world pcls name then invoke world newblk recv pcls name args
       // in-place Array mutators taking a block: map!/select!/reject!/etc.
       else if (str_eq name "map!" || str_eq name "collect!") && (match recv with VArr _ -> true | _ -> false) then
         (match recv with
          | VArr id -> (match arr_map_ip world blk newblk id with
                        | FNext _ -> recv
                        | other -> flow_value other)
          | _ -> recv)
       // ⚠ select! / reject! answer nil when nothing was removed; keep_if and
       //   delete_if answer self either way. Same rule as Hash's, and it was
       //   missing on both sides.
       else if (str_eq name "select!" || str_eq name "keep_if" || str_eq name "filter!") && (match recv with VArr _ -> true | _ -> false) then
         (match recv with
          | VArr id ->
            let before = val_list_len (deref id) in
            (match arr_filter_ip world blk newblk id true with
             | FNext _ ->
               (if str_eq name "keep_if" then recv
                else if val_list_len (deref id) == before then VNil else recv)
             | other -> flow_value other)
          | _ -> recv)
       else if (str_eq name "reject!" || str_eq name "delete_if") && (match recv with VArr _ -> true | _ -> false) then
         (match recv with
          | VArr id ->
            let before = val_list_len (deref id) in
            (match arr_filter_ip world blk newblk id false with
             | FNext _ ->
               (if str_eq name "delete_if" then recv
                else if val_list_len (deref id) == before then VNil else recv)
             | other -> flow_value other)
          | _ -> recv)
       // sort / sort! with a comparator block.
       else if str_eq name "sort" && (match recv with VArr _ -> true | _ -> false) then
         (match recv with
          | VArr id ->
            (let (st, broke, bv) = sort_blk_b world newblk (deref id) in
             if broke then bv else arr_new st)
          | _ -> recv)
       else if str_eq name "sort!" && (match recv with VArr _ -> true | _ -> false) then
         (match recv with
          // sort! writes back what it managed to order even when the block
          // broke out (ruby's "makes some modification even if finished
          // sorting"), and answers the break value.
          | VArr id ->
            (let (st, broke, bv) = sort_blk_b world newblk (deref id) in
             let _ = arr_set id st in
             if broke then bv else recv)
          | _ -> recv)
       // `h.send(:initialize) { |h, k| ... }` installs the block as the hash's
       // default_proc (and, like the value form, refuses when frozen).
       else if str_eq name "initialize" && (match recv with VHsh _ -> true | _ -> false) then
         (match recv with
          | VHsh hid9 ->
            (if cfrozen_get 1 hid9 then
               raise_exc_iv world "FrozenError" ("can't modify frozen Hash: " ++ inspect recv) (Cons (("__recv", recv), Nil))
             else
               (let pid9 = (if map_has pending_srcproc "v" then map_get pending_srcproc "v"
                            else (let np9 = map_len proc_store in
                                  let _ = store_proc (str_of_int np9) newblk in np9)) in
                let _ = (if map_has pending_srcproc "v" then map_delete pending_srcproc "v" else ()) in
                let _ = (if map_has hash_dflt (str_of_int hid9) then map_delete hash_dflt (str_of_int hid9) else ()) in
                let _ = hdproc_set hid9 (VProc pid9) in
                recv))
          | _ -> recv)
       // Hash#delete with a block: the block runs (with the key) when the key
       // is not there, and its value is the answer.
       else if str_eq name "delete" && (match recv with VHsh _ -> true | _ -> false) then
         (match recv with
          | VHsh h9 ->
            (match args with
             | Cons (k9, _) ->
               (let xs9 = hderef h9 in
                let ci9 = hcbi_on h9 in
                if hash_haskey_x ci9 xs9 k9 then
                  (let v9 = hash_get_x ci9 xs9 k9 in
                   let _ = hset h9 (hash_del xs9 k9) in v9)
                else flow_value (run_block world blk newblk (Cons (k9, Nil))))
             | _ -> VNil)
          | _ -> VNil)
       // Array#delete with a block: the block runs when NOTHING matched (its
       // value becomes the answer). The block form reached the plain prim,
       // which has no block and answered nil.
       else if str_eq name "delete" && (match recv with VArr _ -> true | _ -> false) then
         (match recv with
          | VArr id ->
            (match args with
             | Cons (v, _) ->
               (let xs = deref id in
                let had = val_member_w env world xs v in
                if had then (let _ = arr_set id (val_remove_w env world xs v) in v)
                else flow_value (run_block world blk newblk (Cons (v, Nil))))
             | _ -> VNil)
          | _ -> VNil)
       // fetch with a default block: run the block when the key/index is absent.
       else if str_eq name "fetch" && (match recv with VHsh _ -> true | VArr _ -> true | _ -> false) then
         (match recv with
          | VHsh h -> let xs = hderef h in (match args with Cons (k, _) -> (if hash_haskey xs k then hash_get xs k else flow_value (run_block world blk newblk (Cons (k, Nil)))) | _ -> VNil)
          // the index converts through #to_int for the LOOKUP, but the block
          // receives the ORIGINAL object (spec: `.should.equal?(o)`), and the
          // block path does no argument conversion of its own -- a convertible
          // object used to miss every arm and answer nil.
          | VArr id ->
            (let ys = deref id in
             let n = val_list_len ys in
             match args with
             | Cons (a0, _) ->
               (match coerce_arr_index_args env world "fetch" (Cons (a0, Nil)) with
                | Cons (VInt i, _) ->
                  (let j = (if i < 0 then n + i else i) in
                   if j >= 0 && j < n then val_nth ys j
                   else flow_value (run_block world blk newblk (Cons (a0, Nil))))
                | _ -> flow_value (run_block world blk newblk (Cons (a0, Nil))))
             | _ -> VNil)
          | _ -> recv)
       // Hash#merge/merge!/update with a conflict block.
       else if (str_eq name "merge" || str_eq name "merge!" || str_eq name "update") && (match recv with VHsh _ -> true | _ -> false) then
         (match recv with
          | VHsh h -> let merged = hash_merge_block world newblk (hderef h) args in
            (if str_eq name "merge" then mkhash merged else let _ = hset h merged in recv)
          | _ -> recv)
       // String#gsub/sub with a block: the block computes each replacement.
       // The bang forms write the result back and answer nil when nothing
       // changed -- activesupport's Inflector.underscore is `gsub!` with a
       // block throughout.
       else if (str_eq name "gsub" || str_eq name "sub" || str_eq name "gsub!" || str_eq name "sub!")
               && (match recv with VStr _ -> true | _ -> false)
               // a replacement argument wins over the block (ruby ignores it).
               && (match args with Cons (_, Nil) -> true | _ -> false) then
         (match recv with
          | VStr sid -> let s0 = sget sid in
            (let e9 = enc_canon_name (senc_get sid) in
             // a receiver whose bytes are invalid in its encoding cannot be
             // searched (ruby's ArgumentError, before any matching).
             let _ = (if str_eq e9 "UTF-8" && (if enc_valid_utf8 s0 then false else true)
                      then (let _ = prim_raise "ArgumentError" "invalid byte sequence in UTF-8" in ()) else ()) in
             let (pat9, pf9, okp) = (match args with
                                     | Cons (VRegex (p9, f9, _), _) -> (p9, f9, true)
                                     | Cons (VStr p9, _) -> (rx_escape (sget p9), "", true)
                                     | _ -> ("", "", false)) in
             if okp == false then recv
             else
             let all9 = str_eq name "gsub" || str_eq name "gsub!" in
             let bang9 = str_eq name "gsub!" || str_eq name "sub!" in
             match rx_gsub_blk2 world newblk pat9 pf9 sid all9 bang9 with
             | (r, re) ->
               // the block may have run its own matches: $~ afterwards is THIS
               // method's last (gsub) / first (sub) match again.
               let _ = (if all9 then (let _ = rb_scan_lastpub world pat9 pf9 s0 (senc_get sid) in ())
                        else (let _ = rb_sub_firstpub world pat9 pf9 s0 (senc_get sid) in ())) in
               if bang9 then
                 (if str_eq r s0 then VNil
                  else (let _ = sset sid r in let _ = senc_set sid re in recv))
               else (let c = mkstr r in (match c with VStr rid -> (let _ = senc_set rid re in c) | _ -> c)))
          | _ -> recv)
       // String#match with a block yields the MatchData and answers the
       // BLOCK's result (nil, unyielded, when there is no match).
       // ...for a SYMBOL too: it has the same #match, and this arm named only
       // String, so `:abc.match(/b/) { }` dropped the block and answered the
       // MatchData instead of the block's value.
       else if str_eq name "match" && (match recv with VStr _ -> true | VSym _ -> true | _ -> false) then
         (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
          match invoke_val_c env world nb recv "match" args false with
          | VNil -> VNil
          | md -> flow_value (run_block world nb newblk (Cons (md, Nil))))
       // String#scan with a block: yield each match (the capture array when
       // the pattern has groups, else the matched string), publish $~ per
       // match, and return the receiver. Without a block, scan returns the
       // array (handled by prim_method); the block form was previously unhandled
       // and silently dropped the block.
       else if str_eq name "scan" && (match recv with VStr _ -> true | _ -> false) then
         (match recv with
          | VStr s -> let se9 = senc_get s in let s = sget s in
            (match args with
             | Cons (VRegex (pat, pf, _), _) ->
               let _ = rx_scan_blk world newblk pat pf s 0 se9 in
               let _ = rb_scan_lastpub world pat pf s se9 in recv
             | Cons (VStr p, _) ->
               let _ = rx_scan_blk world newblk (rx_escape (sget p)) "" s 0 se9 in
               let _ = rb_scan_lastpub world (rx_escape (sget p)) "" s se9 in recv
             | _ -> builtin_iter world blk newblk recv name args)
          | _ -> recv)
       // ⚠ `send(:lambda) { }` / `send(:proc) { }` / `send(:loop) { }`: these
       //   are Kernel methods like any other, and here they were only reachable
       //   as a BARE call with a literal block (the ECallB path) -- so
       //   dispatching them by name answered "undefined method 'lambda'". A
       //   name a program can send is a name this path has to know.
       else if (str_eq name "proc" || str_eq name "lambda")
               && (let (m9, _, _, _) = world in
                   if map_has m9 name then false else true) then
         (let id9 = map_len proc_store in
          let _ = store_proc (str_of_int id9) newblk in
          let _ = (if str_eq name "lambda" then map_set lambda_ids (str_of_int id9) VNil else ()) in
          VProc id9)
       else if str_eq name "loop"
               && (let (m9, _, _, _) = world in
                   if map_has m9 name then false else true) then
         run_loop_builtin env world blk newblk
       else builtin_iter world blk newblk recv name args))

// dispatch on a primitive receiver: reopened built-in classes win (class
// Integer / class Object monkey-patching), then the hardcoded prims.
// the bare ivar name from an instance_variable_* argument (":@x" / "@x").

// ruby REFUSES a name that is not shaped like the variable being asked for,
// rather than answering nil for one that could never exist: "x", "@@x", "@",
// "@1" and "@ x" are all NameError from instance_variable_get, and "x" / "@x"
// from class_variable_get. Answering nil instead is the kind of wrong answer
// that is worse than a refusal -- the caller cannot tell "not set" from
// "could never be set". The wording follows the same choice as the rest of the
// errors here (ruby 3.4's straight quotes, not 3.2's `x').

// The name argument of the @ivar reflection methods. A Symbol or a String is
// taken as written and anything else is asked for #to_str: a value with none
// is a TypeError about its TYPE, where `to_s` turned it into a NameError about
// its printed form ("'123' is not allowed as an instance variable name" for the
// Integer 123, which was never a name at all).
and ivar_name_val = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VSym sy -> ivar_name_checked world sy
  | VStr h -> ivar_name_checked world (sget h)
  | other ->
    (match conv_try env world other "to_str" with
     | VStr h -> ivar_name_checked world (sget h)
     | _ -> (let _ = raise_exc world "TypeError"
               (inspect other ++ " is not a symbol nor a string") in ""))


and dispatch_prim = fn env -> fn world -> fn blk -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) -> fn (vischeck: bool) ->
  let noblk = (false, (Nil : str list), (Nil : Stmt list), env) in
  // Array#fetch_values converts each index with #to_int before the leaf reads
  // it (the leaf has no world to ask an object with).
  let args = (if str_eq name "fetch_values" && (match recv with VArr _ -> true | _ -> false)
              then coerce_int_args env world args else args) in
  // `s[1, 2.5]` / `a[0, 2.5]` / `s.byteslice(1, 2.5)`: the LENGTH is an integer
  // CONVERSION too. Only a VInt matched below, so a Float length looked like NO
  // length at all and the one-argument form answered instead -- `"abcd"[1, 2.5]`
  // was "b" and `[1, 2, 3][0, 2.5]` was the ELEMENT 1 rather than [1, 2].
  let args = (if (str_eq name "[]" || str_eq name "slice" || str_eq name "slice!"
                  || str_eq name "byteslice")
                 && (match recv with VStr _ -> true | VArr _ -> true | _ -> false)
              then (match args with
                    | Cons (a9, Cons (VFlt f9, Nil)) -> Cons (a9, Cons (VInt (int_of_float f9), Nil))
                    // an OBJECT length converts through #to_int, and an object
                    // that has none is refused like any other non-number --
                    // coerce_int_args leaves it as it found it, which the arm
                    // below then read as "no length given".
                    | Cons (a8, Cons (VObj _, Nil)) ->
                      (if (match a8 with VRegex (_, _, _) -> true | _ -> false) then args
                       else
                         let cv8 = coerce_int_args env world args in
                         (match cv8 with
                          | Cons (_, Cons (VInt _, Nil)) -> cv8
                          | Cons (_, Cons (VBig _, Nil)) -> cv8
                          | Cons (_, Cons (other8, Nil)) ->
                            (let _ = raise_exc world "TypeError"
                               ("no implicit conversion of "
                                ++ display_cls_msg world (dispatch_cls_of world other8)
                                ++ " into Integer") in cv8)
                          | _ -> cv8))
                    // ...and a BIGNUM length is out of range rather than absent
                    | Cons (_, Cons (VBig _, Nil)) ->
                      (let _ = raise_exc world "RangeError"
                                 "bignum too big to convert into 'long'" in args)
                    // ...and a length that is no kind of number is refused by
                    // name. It used to be dropped, so `"symbol"[1, nil]` quietly
                    // answered the ONE-argument form's character.
                    // ⚠ NOT when the first subscript is a Regexp: `s[re, n]` and
                    // `s[re, "name"]` take a capture number or a capture NAME
                    // there, and a String is the right kind of second argument.
                    | Cons (a9, Cons (len9, Nil)) ->
                      (if (match a9 with VRegex (_, _, _) -> true | _ -> false) then args
                       else
                         match len9 with
                         | VInt _ -> args
                         | VNil -> (let _ = raise_exc world "TypeError"
                                      "no implicit conversion from nil to integer" in args)
                         | VStr _ -> (let _ = raise_exc world "TypeError"
                                        ("no implicit conversion of String into Integer") in args)
                         | VArr _ -> (let _ = raise_exc world "TypeError"
                                        ("no implicit conversion of Array into Integer") in args)
                         | VHsh _ -> (let _ = raise_exc world "TypeError"
                                        ("no implicit conversion of Hash into Integer") in args)
                         | VSym _ -> (let _ = raise_exc world "TypeError"
                                        ("no implicit conversion of Symbol into Integer") in args)
                         | VBool _ -> (let _ = raise_exc world "TypeError"
                                         ("no implicit conversion of " ++ cmp_type_name len9 ++ " into Integer") in args)
                         | _ -> args)
                    | _ -> args)
              else args) in
  // Integer#coerce / Float#coerce go through Float(), which asks an OBJECT for
  // #to_f. The leaf below has no world to ask with, so it refused every object
  // that was not already a number.
  if str_eq name "coerce" && is_num recv
     && (match args with Cons (VObj _, Nil) -> true | _ -> false)
     && (match args with Cons (o9, _) -> prim_user_has world o9 "to_f" | _ -> false) then
    (match args with
     | Cons (o9, _) ->
       (match conv_try env world o9 "to_f" with
        | VFlt f9 -> arr_new (Cons (VFlt f9, Cons (VFlt (to_f recv), Nil)))
        | VInt n9 -> arr_new (Cons (VFlt (float_of_int n9), Cons (VFlt (to_f recv), Nil)))
        | _ -> raise_exc world "TypeError" ("can't convert " ++ class_name o9 ++ " into Float"))
     | Nil -> VNil)
  else
  // #backtrace_locations: the same frames #backtrace answers, as objects. The
  // leaf has the frames and no world to build a Location in, so it answered
  // nil for an exception whose backtrace it could already print.
  if str_eq name "backtrace_locations"
     && (match recv with VExc (_, _) -> true | _ -> false)
     && ((map_has raise_bt "e" && rb_eq (map_get raise_bt "e") recv)
         || (map_has raise_bt "v" && map_has globals "!" && rb_eq (map_get globals "!") recv)) then
    (match (if map_has raise_bt "e" && rb_eq (map_get raise_bt "e") recv
            then map_get raise_bt "eb" else map_get raise_bt "v") with
     | VArr aid9 -> arr_new (bt_locs_of world (deref aid9))
     | _ -> VNil)
  else
  // A Symbol delegates to its text for `[]` / `slice`, and the delegation has
  // to happen HERE rather than in the leaf: the length argument is asked for
  // #to_int by the string layer above, which the leaf skipped -- so
  // `:"mbc"[0, obj]` answered one character where ruby answers two.
  if (str_eq name "[]" || str_eq name "slice")
     && (match recv with VSym _ -> true | _ -> false) then
    (match recv with
     | VSym sy9 -> invoke_val_c env world blk (mkstr sy9) name args false
     | _ -> VNil)
  else
  // #full_message / #detailed_message on the lightweight class-and-message
  // representation. They are the SAME two methods the object representation
  // answers -- the report a program prints does not depend on which shape the
  // raise happened to build -- so both go to the one implementation. Asking
  // the leaf meant `raise "x"` produced an exception whose #full_message was
  // a NoMethodError while `raise Cls.new("x")` produced one that worked.
  if (str_eq name "full_message" || str_eq name "detailed_message")
     && (match recv with VExc (_, _) -> true | _ -> false) then
    (if str_eq name "detailed_message"
     then mkstr (exc_detailed_msg env world recv (kw_flag args "highlight" false))
     else mkstr (exc_full_message env world recv args (kw_flag args "highlight" false)
                   (str_eq (kw_sym args "order" "top") "bottom")))
  else
  // The names whose argument ruby converts (or refuses) BEFORE the arithmetic:
  // the leaf below has no world and cannot call #to_int, so its refusal came
  // out as an internal failure -- a bare StandardError reading
  // "mere-ruby: & type error" where ruby says what it wanted and why.
  let args = (if (str_eq name "allbits?" || str_eq name "anybits?" || str_eq name "nobits?")
                 && (match recv with VInt _ -> true | VBig _ -> true | _ -> false)
              then (let cv9 = coerce_int_args env world args in
                    match cv9 with
                    | Cons (a9, _) ->
                      (match a9 with
                       | VInt _ -> cv9 | VBig _ -> cv9
                       | _ -> (let _ = raise_exc world "TypeError"
                                 ("no implicit conversion of " ++ class_name a9 ++ " into Integer") in cv9))
                    | Nil -> cv9)
              else args) in
  let _ = (if (str_eq name "gcd" || str_eq name "lcm" || str_eq name "gcdlcm")
              && (match recv with VInt _ -> true | VBig _ -> true | _ -> false)
           then (match args with
                 | Cons (a9, _) ->
                   (match a9 with
                    | VInt _ -> () | VBig _ -> ()
                    | _ -> (let _ = raise_exc world "TypeError" "not an integer" in ()))
                 | Nil -> ())
           else ()) in
  let cls = class_name recv in
  // The @ivar reflection primitives on a receiver that is not a plain object:
  // main and the mutable primitives get storage keyed the same way their
  // singleton classes are; an immediate cannot hold one (Ruby: FrozenError).
  if str_eq name "instance_variable_get" || str_eq name "instance_variable_set" ||
     str_eq name "instance_variable_defined?" || str_eq name "instance_variables" ||
     str_eq name "remove_instance_variable" then
    (let (_, _, _, ivars0) = world in
     let base = (match recv with
                 | VMain -> "main"
                 | VStr _ -> hng_key recv | VArr _ -> hng_key recv | VHsh _ -> hng_key recv
                 | _ -> "") in
     if str_eq name "instance_variables" then
       (let pfx = base ++ "@" in
        let plen = str_len pfx in
        let tmp = map_new () in
        let _ = if str_eq base "" then () else
          map_iter ivars0 (fn (k: str) -> fn (v: Val) ->
            if str_len k > plen && str_eq (substring k 0 plen) pfx
            then (let m = map_len tmp in map_set tmp (str_of_int m) (VSym ("@" ++ substring k plen (str_len k))))
            else ()) in
        arr_new (idx_to_list tmp 0 (map_len tmp)))
     else if str_eq name "instance_variable_set" || str_eq name "remove_instance_variable" then
       // the name is read BEFORE the receiver is refused, so
       // `nil.instance_variable_set(:foo, 42)` is a NameError about the name
       // and `nil.instance_variable_set(:@foo, 42)` a FrozenError about nil.
       (match args with
        | Cons (v, _) ->
          (let nm9 = ivar_name_val env world v in
           if str_eq base "" then raise_exc world "FrozenError" ("can't modify frozen " ++ cls ++ ": " ++ inspect recv)
           else if str_eq name "remove_instance_variable" then
             (let k9 = base ++ "@" ++ nm9 in
              if map_has ivars0 k9
              then (let old9 = map_get ivars0 k9 in let _ = map_delete ivars0 k9 in old9)
              else raise_exc world "NameError" ("instance variable @" ++ nm9 ++ " not defined"))
           else (match args with
                 | Cons (_, Cons (value, _)) -> let _ = map_set ivars0 (base ++ "@" ++ nm9) value in value
                 | _ -> VNil))
        | _ -> VNil)
     else
       (match args with
        | Cons (v, _) ->
          (let k = base ++ "@" ++ ivar_name_val env world v in
           if str_eq base "" then (if str_eq name "instance_variable_defined?" then VBool false else VNil)
           else if str_eq name "instance_variable_defined?" then VBool (map_has ivars0 k)
           else if map_has ivars0 k then map_get ivars0 k else VNil)
        | _ -> VNil))
  else
  // Object#methods on a value that is not a plain object: the methods DEFINED
  // in ruby on its class chain. The builtins are not entries in a table, so
  // they cannot be listed -- see KNOWN_GAPS.md. rubocop computes
  // `nil.methods - Object.new.methods` and only needs the call to answer.
  if is_vis_list_name name then
    (if str_eq name "methods" && (match args with Cons (VBool false, _) -> true | Cons (VNil, _) -> true | _ -> false)
     then arr_new (Nil : Val list)
     else
       // a primitive's own methods are not entries in the method table, so the
       // walk finds only what ruby code added to its class. The names the
       // DISPATCHER answers for come from the per-type lists respond_to? reads,
       // each admitted only if `responds` says so -- the two answers are the
       // same answer. (While one shared numeric list claimed `negative?` for a
       // Complex, listing it here published that lie; the lists are split now.)
       (let want9 = (if str_eq name "public_methods" then 1
                     else if str_eq name "private_methods" then 2
                     else if str_eq name "protected_methods" then 3 else 0) in
        let recur9 = (match args with Cons (VBool false, _) -> false | Cons (VNil, _) -> false | _ -> true) in
        let names9 = map_new () in
        let blocked9 = map_new () in
        let _ = collect_vis world (dispatch_cls_of world recv) names9 blocked9 want9 recur9 in
        let _ = (if want9 == 2 then () else if want9 == 3 then () else
                   (let add9 = fn (nm9: str) ->
                      (if map_has names9 nm9 then ()
                       else if responds world recv nm9 then map_set names9 nm9 (VSym nm9)
                       else ()) in
                    let rec go9 = fn (xs9: str list) ->
                      (match xs9 with Nil -> () | Cons (h9, t9) -> (let _ = add9 h9 in go9 t9)) in
                    let _ = (if is_num recv || is_cpx recv then go9 (num_names_for recv) else ()) in
                    go9 (kernel_public_instance_names ()))) in
        let out9 = map_new () in
        let _ = map_iter names9 (fn (k9: str) -> fn (v9: Val) -> let i9 = map_len out9 in map_set out9 (str_of_int i9) v9) in
        arr_new (idx_to_list out9 0 (map_len out9))))
  else if str_eq name "singleton_methods" then arr_new Nil
  // singleton_class: true/false/nil answer their class; immediates raise
  // TypeError; an object gets its own (hidden) singleton class.
  else if str_eq name "singleton_class" then
    (match recv with
     | VBool b -> VClass (if b then "TrueClass" else "FalseClass")
     | VNil -> VClass "NilClass"
     | VInt _ -> raise_exc world "TypeError" "can't define singleton"
     | VFlt _ -> raise_exc world "TypeError" "can't define singleton"
     | VSym _ -> raise_exc world "TypeError" "can't define singleton"
     | VObj id -> VClass (singleton_cls_of world id)
     | VClass c -> VClass ("(sng:" ++ c ++ ")")
     // a mutable primitive instance can have a singleton class (superclass is
     // its class); frozen immediates above already raise TypeError.
     // ⚠ ...but a DEDUPLICATED string is shared, so it cannot carry one:
     //   `(-"string").singleton_class` and `"x".freeze.singleton_class` (the
     //   compiler interns that one) are ruby's "can't define singleton", while
     //   a string frozen at run time (`"y".dup.freeze`) still gets a class.
     //   The intern table is the same one the `-str` operator writes.
     | VStr h9 when (let k9 = senc_get h9 ++ chr 1 ++ sget h9 in
                     if map_has str_intern_tbl k9
                     then (match map_get str_intern_tbl k9 with
                           | VStr hid9 -> hid9 == h9
                           | _ -> false)
                     else false) ->
       raise_exc world "TypeError" "can't define singleton"
     | VStr _ -> VClass (prim_sng_cls world recv "String")
     | VArr _ -> VClass (prim_sng_cls world recv "Array")
     | VHsh _ -> VClass (prim_sng_cls world recv "Hash")
     | _ -> raise_exc world "TypeError" "can't define singleton")
  // String#encode: real transcode between UTF-8/ISO-8859-1/US-ASCII (and
  // relabel to/from ASCII-8BIT); an unrepresentable char raises a catchable
  // Encoding::UndefinedConversionError.
  else if (str_eq name "encode" || str_eq name "encode!") && (match recv with VStr _ -> true | _ -> false) then
    // encode([dst [, src]] [, options]): decode under src (or self's
    // encoding) with :invalid handling per broken SEQUENCE, apply the
    // newline options, then encode per codepoint with :undef handling
    // (:replace or a :fallback proc/hash). encode! writes back.
    (match recv with
     | VStr h ->
       (let encname_of = fn (v: Val) ->
          (match v with
           | VStr nm -> enc_canon_name (sget nm)
           | VObj oid9 ->
             (let (m9e, s9e, o9e, i9e) = world in
              if map_has enc_name (str_of_int oid9) then map_get enc_name (str_of_int oid9)
              else enc_canon_name (to_s (VObj oid9)))
           | _ -> "") in
        let (pos1, pos2, opts) =
          (match args with
           | Cons (VHsh oh, _) -> (VNil, VNil, VHsh oh)
           | Cons (a1, Cons (VHsh oh, _)) -> (a1, VNil, VHsh oh)
           | Cons (a1, Cons (a2, Cons (VHsh oh, _))) -> (a1, a2, VHsh oh)
           | Cons (a1, Cons (a2, _)) -> (a1, a2, VNil)
           | Cons (a1, _) -> (a1, VNil, VNil)
           | Nil -> (VNil, VNil, VNil)) in
        let optv = fn (k: str) ->
          (match opts with
           | VHsh oh -> (match hash_lookup (hderef oh) (VSym k) with (true, v) -> v | _ -> VNil)
           | _ -> VNil) in
        let from = (match pos2 with VNil -> enc_canon_name (senc_get h) | v -> encname_of v) in
        let to = (match pos1 with VNil -> from | v -> encname_of v) in
        let inv_rep = (match optv "invalid" with VSym r9 -> str_eq r9 "replace" | _ -> false) in
        let und_rep = (match optv "undef" with VSym r9 -> str_eq r9 "replace" | _ -> false) in
        let fbv = optv "fallback" in
        // the replacement's codepoints (its own encoding respected).
        let rep_cps = (match optv "replace" with
                       | VStr rh -> decode_cps (sget rh) (enc_canon_name (senc_get rh)) 0
                       | _ -> (if str_eq to "UTF-8" || str_eq (substring to 0 (if str_len to < 3 then str_len to else 3)) "UTF"
                               then Cons (65533, Nil) else Cons (63, Nil))) in
        let cps0 = enc_decode_marked (sget h) from in
        let _ = (let rec anybad = fn (xs: int list) ->
                   (match xs with Nil -> false | Cons (c9, t9) -> (if c9 < 0 then true else anybad t9)) in
                 if anybad cps0 && (if inv_rep then false else true)
                 then (let _ = raise_exc world "Encoding::InvalidByteSequenceError"
                                 ("invalid byte sequence in " ++ from) in ())
                 else ()) in
        // newline options operate on the decoded text.
        let cps1 =
          (if truthy (optv "universal_newline") then
             (let rec un = fn (xs: int list) ->
                (match xs with
                 | Nil -> (Nil : int list)
                 | Cons (13, Cons (10, t9)) -> Cons (10, un t9)
                 | Cons (13, t9) -> Cons (10, un t9)
                 | Cons (c9, t9) -> Cons (c9, un t9)) in
              un cps0)
           else if truthy (optv "cr_newline") then
             (let rec cr = fn (xs: int list) ->
                (match xs with Nil -> (Nil : int list) | Cons (10, t9) -> Cons (13, cr t9) | Cons (c9, t9) -> Cons (c9, cr t9)) in
              cr cps0)
           else if truthy (optv "crlf_newline") then
             (let rec crlf = fn (xs: int list) ->
                (match xs with Nil -> (Nil : int list) | Cons (10, t9) -> Cons (13, Cons (10, crlf t9)) | Cons (c9, t9) -> Cons (c9, crlf t9)) in
              crlf cps0)
           else cps0) in
        // ⚠ THE BYTE-ORDER MARK BELONGS TO THE STRING, NOT TO EACH CHARACTER.
        // encode_cps writes a BOM for the byte-order-free names UTF-16 and
        // UTF-32, and the loop below hands it ONE codepoint at a time -- so
        // `"foo".encode("UTF-16")` came out FE FF 00 66 FE FF 00 6F FE FF 00 6F.
        // The loop encodes through the BE form instead, and the mark is written
        // once, in front, and only for a string that has any characters at all
        // (ruby gives "" no BOM). The RESULT still wears the name it was asked
        // for: `to` is what gets stamped, `to_enc9` is only how it is written.
        let to_enc9 = (if str_eq (enc_up to) "UTF-16" then "UTF-16BE"
                       else if str_eq (enc_up to) "UTF-32" then "UTF-32BE" else to) in
        let bom9 = (if str_eq (enc_up to) "UTF-16" then chr 254 ++ chr 255
                    else if str_eq (enc_up to) "UTF-32" then chr 0 ++ chr 0 ++ chr 254 ++ chr 255
                    else "") in
        let rep_bytes = (match encode_cps rep_cps to_enc9 "" with (b9, _) -> b9) in
        let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
        let rec emit = fn (xs: int list) -> fn (acc: str) ->
          (match xs with
           | Nil -> acc
           | Cons (c9, t9) ->
             if c9 < 0 then emit t9 (acc ++ rep_bytes)
             else
               (match encode_cps (Cons (c9, Nil)) to_enc9 "" with
                | (b9, ok9) ->
                  if ok9 then emit t9 (acc ++ b9)
                  else
                    // undefined in the destination: the fallback decides,
                    // then :undef => :replace, then ruby's own error.
                    (let explicit9 = (match optv "replace" with VStr _ -> true | _ -> false) in
                     if und_rep && explicit9 then emit t9 (acc ++ rep_bytes)
                     else
                     let ch = (let cb = utf8_enc c9 in
                               let cv = mkstr cb in
                               (match cv with VStr ci -> (let _ = senc_set ci from in cv) | _ -> cv)) in
                     let fb = (match fbv with
                               | VHsh fh -> (match hash_lookup (hderef fh) ch with (true, v9) -> v9 | _ -> VNil)
                               | VProc _ -> invoke_val_c env world nb fbv "call" (Cons (ch, Nil)) false
                               | VObj _ -> invoke_val_c env world nb fbv "[]" (Cons (ch, Nil)) false
                               | _ -> VNil) in
                     match fb with
                     | VStr fh2 ->
                       (match encode_cps (decode_cps (sget fh2) (enc_canon_name (senc_get fh2)) 0) to_enc9 "" with
                        | (fb9, _) -> emit t9 (acc ++ fb9))
                     | _ ->
                       if und_rep then emit t9 (acc ++ rep_bytes)
                       else (match raise_exc world "Encoding::UndefinedConversionError"
                                     ("conversion undefined from " ++ from ++ " to " ++ to) with
                             | _ -> acc)))) in
        let bytes = (let b0 = emit cps1 "" in if str_eq b0 "" then b0 else bom9 ++ b0) in
        if str_eq name "encode!" then (let _ = sset h bytes in let _ = senc_set h to in recv)
        else (let c = mkstr bytes in (match c with VStr id -> let _ = senc_set id to in c | _ -> c)))
     | _ -> VNil)
  // instance_eval/instance_exec with a String arg: parse and run the code
  // with self rebound to the receiver (a fresh scope, like Ruby).
  else if (str_eq name "instance_eval" || str_eq name "instance_exec") && (match args with Cons (VStr _, _) -> true | _ -> false) then
    (match args with
     | Cons (VStr code, frest) ->
       let code = sget code in
       // the 2nd and 3rd arguments name the file and line (see eval_file_arg)
       let ef = eval_file_arg (match frest with Cons (fv, _) -> fv | _ -> VNil) in
       let el = eval_line_arg (match frest with Cons (_, Cons (lv, _)) -> lv | _ -> VNil) in
       let savedpf = eval_pfile_push ef in
       let _ = set_parsing_eval code in
       let toks = number_nls_at code (lex_go code 0) el in
       let _ = parse_line_reset (count_nls toks) in
       let (p2, _) = parse_stmts toks Nil in
       let _ = map_set load_ctx "parsing" (mkstr "") in
       // pfile is a PARSE-time slot (see parse_time_file), so it comes back
       // down as soon as the parse is over -- the body runs without it.
       let _ = eval_pfile_pop savedpf in
       if imm_no_singleton recv && body_defines p2 then raise_exc world "TypeError" "can't define singleton"
       else
       let env2 = map_new () in
       let _ = map_set env2 "self" recv in
       // string-form instance_eval resolves bare constants in the receiver's
       // class scope (cref).
       let _ = map_set env2 "__cref" (mkstr (class_name recv)) in
       // ⚠ ...and the DEFAULT DEFINEE moves too, exactly as it does for the
       //   block form next door -- a `def` in this string belongs to the
       //   receiver's SINGLETON class. Without it the def landed on Object
       //   and every other object in the program acquired the method:
       //
       //     o = Object.new
       //     o.instance_eval("def m; end")
       //     Object.new.method(:m)   # answered a Method; ruby raises NameError
       //
       //   The block form was given this and the string form was not, which is
       //   the same rule living in one of its two places.
       let _ = map_set env2 "__definee_recv" recv in
       eval_run env2 world blk p2
     | _ -> VNil)
  // is_a? / kind_of? walk the real (exception) hierarchy.
  else if (str_eq name "is_a?" || str_eq name "kind_of?" || str_eq name "instance_of?") then
    // an extended primitive is_a? the module it was extended with, so the
    // question is asked of the tagged class (its singleton, when there is
    // one) rather than of the bare class name. instance_of? was NOT here at
    // all and fell through to prim_method, which knows only the bare class:
    // an instance of a String SUBCLASS answered instance_of?(TheSubclass)
    // with false.
    (let tag = (let hk = hng_key recv in
                if (if str_eq hk "" then false else true) && map_has hng_store hk
                then map_get hng_store hk else cls) in
     match args with
     | Cons (VClass c, _) ->
       (if str_eq name "instance_of?" then
          // the value's own class, which for a value that has been extended is
          // the singleton's recorded superclass rather than the singleton.
          (let real = (let (_, sup9, _, _) = world in
                       if is_sng_cls tag && map_has sup9 tag then map_get sup9 tag else tag) in
           VBool (str_eq real c))
        else VBool (obj_is_a world tag c || obj_is_a world cls c))
     | Cons (_, _) -> raise_exc world "TypeError" "class or module required"
     | _ -> VBool false)
  else if has_meth world cls name then
    (if vischeck && meth_private world cls name
     then raise_exc world "NoMethodError" ("private method '" ++ name ++ "' called for " ++ for_recv_cls world cls)
     else invoke world noblk recv cls name args)
  // explicit operator-method call (r.=~("s")) publishes $~ like the operator.
  else if str_eq name "=~" then
    (match recv with
     | VRegex (p, pf, _) -> (match args with Cons (VStr sv, _) -> rx_do_match world p pf (sget sv) (senc_get sv) | _ -> VNil)
     | VStr sv ->
       (let se9 = senc_get sv in let sv = sget sv in
        match args with
        | Cons (VRegex (p, pf, _), _) -> rx_do_match world p pf sv se9
        // string =~ string is ruby's own type mismatch; any OTHER object is
        // asked for ITS #=~ with self (a mock's stubbed =~ answers).
        | Cons (VStr _, _) -> raise_exc world "TypeError" "type mismatch: String given"
        | Cons (VObj oq, _) ->
          (let (mq, sq, ocq, iq) = world in
           let oclq = map_get ocq oq in
           let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
           if has_meth world oclq "=~" then invoke world nb (VObj oq) oclq "=~" (Cons (recv, Nil))
           // a mock's =~ lives behind method_missing: call that directly.
           else if has_meth world oclq "method_missing"
           then invoke world nb (VObj oq) oclq "method_missing" (Cons (VSym "=~", Cons (recv, Nil)))
           else VNil)
        | _ -> VNil)
     | _ -> VNil)
  // enumerable methods without a block return an Enumerator over recv.<name>
  // (Ruby: [1,2].map => #<Enumerator: [1, 2]:map>).
  // `rindex` / `index` / `find_index` with NEITHER an argument nor a block is
  // an Enumerator (with an argument they are searches, so the arms above keep
  // them -- which is why they are not in enum_needs_block).
  else if (str_eq name "rindex" || str_eq name "index" || str_eq name "find_index")
          && (match recv with VArr _ -> true | _ -> false)
          && (match args with Nil -> true | _ -> false) then
    make_enum_a world recv name args
  // chunk_while / slice_when have nothing to enumerate without their
  // predicate, and ruby says so in the words of the Proc it could not make.
  else if (str_eq name "chunk_while" || str_eq name "slice_when") then
    raise_exc world "ArgumentError" "tried to create Proc object without a block"
  else if enum_needs_block name && (match recv with VArr _ -> true | VHsh _ -> true | VRange (_, _, _) -> true | _ -> false) then
    // most yielders take NO arguments, so `[1,2,3].map(:foo)` is a wrong-arity
    // call, not an Enumerator over a method that ignores what it was handed.
    (if enum_zero_arity name && (match args with Nil -> false | _ -> true) then
       raise_exc world "ArgumentError"
         ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0)")
     else make_enum_a world recv name args)
  // Enumerable extras needing === / world (blockless array forms).
  // ⚠ WITHOUT a block, grep leaves `$~` exactly as it was: there is no block
  // for it to be visible to, and ruby does not publish the walk's own matches.
  // arr_grep runs `===` on every element, so the last one overwrote whatever
  // the program had matched before the call -- a global changed by a method
  // that answers an Array.
  else if (str_eq name "grep" || str_eq name "grep_v") && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr aid ->
       (match args with
        | Cons (pat, _) ->
          (let had9 = map_has globals "~" in
           let prev9 = (if had9 then map_get globals "~" else VNil) in
           let r9 = arr_new (arr_grep world (deref aid) pat (str_eq name "grep_v")) in
           let _ = (if had9 then map_set globals "~" prev9 else ()) in
           r9)
        | _ -> arr_new Nil)
     | _ -> VNil)
  else if str_eq name "one?" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr aid ->
       (match args with
        | Cons (pat, _) -> VBool (arr_count_eqq world (deref aid) pat 0 == 1)
        | _ -> VBool (arr_count_truthy (deref aid) 0 == 1))
     | _ -> VNil)
  // any? / all? / none? without a block: truthiness of the elements, or how
  // many are `pattern === element` when one is given (the same shape one?
  // already had).
  else if (str_eq name "any?" || str_eq name "all?" || str_eq name "none?")
          && (match recv with VArr _ -> true | VHsh _ -> true | VRange _ -> true | _ -> false) then
    (match (match recv with VArr _ -> recv | _ -> prim_method recv "to_a" Nil) with
     | VArr aid ->
       (let xs = deref aid in
        let n = val_list_len xs in
        let hits = (match args with
                    | Cons (pat, _) -> arr_count_eqq world xs pat 0
                    | _ -> arr_count_truthy xs 0) in
        if str_eq name "any?" then VBool (hits > 0)
        else if str_eq name "none?" then VBool (hits == 0)
        else VBool (hits == n))
     | _ -> VNil)
  else if str_eq name "minmax" && (match recv with VArr _ -> true | _ -> false) then
    // through the world-aware sort, so an array of objects uses their <=>; the
    // value-level min/max this used to call cannot reach one.
    (match recv with
     | VArr id ->
       (let sorted = sort_w world (deref id) in
        arr_new (Cons ((match sorted with Nil -> VNil | Cons (h, _) -> h),
                       Cons ((match val_rev sorted Nil with Nil -> VNil | Cons (h, _) -> h), Nil))))
     | _ -> VNil)
  else if str_eq name "each_entry" && (match recv with VArr _ -> true | _ -> false) then
    make_enum world recv "each"
  else if str_eq name "cycle" && (match recv with VArr _ -> true | VRange _ -> true | _ -> false) then
    make_enum_a world recv name args
  // block-less enumerators return a real Enumerator over recv.<name>
  // (materialized on demand by enum_to_arr; supports next/peek/to_a/map...).
  else if str_eq name "each_with_index" then
    (match recv with
     | VArr _ -> make_enum world recv name
     | VRange (_, _, _) -> make_enum world recv name
     | VStr _ -> make_enum world recv name
     | _ -> prim_method recv name args)
  else if str_eq name "each_char" && (match recv with VStr _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each_byte" && (match recv with VStr _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each_codepoint" && (match recv with VStr _ -> true | _ -> false) then
    make_enum world recv name
  else if (str_eq name "upto" || str_eq name "each_line" || str_eq name "each_grapheme_cluster")
          && (match recv with VStr _ -> true | _ -> false) then
    make_enum_a world recv name args
  else if str_eq name "times" && (match recv with VInt _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each" && (match recv with VArr _ -> true | VRange _ -> true | _ -> false) then
    make_enum world recv name
  else if str_eq name "each_index" && (match recv with VArr _ -> true | _ -> false) then
    make_enum world recv name
  else if (str_eq name "each_slice" || str_eq name "each_cons") && (match recv with VArr _ -> true | VRange _ -> true | _ -> false) then
    // ...but the SIZE has to be positive first. An Enumerator over
    // `each_slice(0)` re-enters this arm when it is forced and the walk never
    // shortens: `[1,2].each_slice(0).to_a` was a stack overflow where ruby
    // raises before anything is built.
    (match args with
     | Cons (VInt n9, _) ->
       (if n9 < 1
        then raise_exc world "ArgumentError" (if str_eq name "each_slice" then "invalid slice size" else "invalid size")
        else make_enum_a world recv name args)
     | _ -> make_enum_a world recv name args)
  // ⚠ ONLY the arity is checked here. A limit of the wrong TYPE is accepted by
  // the blockless form -- `1.upto("x")` is a perfectly good Enumerator, which
  // refuses later, when its #size is asked or its block runs. Refusing at
  // construction made the Enumerator itself raise, which ruby does not.
  else if (str_eq name "upto" || str_eq name "downto")
          && (match recv with VInt _ -> true | _ -> false) then
    (match args with
     | Nil -> raise_exc world "ArgumentError" "wrong number of arguments (given 0, expected 1)"
     | _ -> make_enum_a world recv name args)
  else if str_eq name "bytes" && (match recv with VStr _ -> true | _ -> false) then
    (match recv with VStr s -> arr_new (str_bytes_val (sget s) 0) | _ -> recv)
  // String#unpack — the inverse of the Array#pack subset: "U*" yields
  // codepoints, "C*"/"c*" (and anything else, as a default) yields bytes.
  else if (str_eq name "unpack" || str_eq name "unpack1") && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr s ->
       (match args with
        | Cons (VStr fmt, rest) ->
          let f = sget fmt in
          // unpack(fmt, offset: n) starts n BYTES in; negative refuses, past
          // the end refuses, AT the end unpacks the empty string.
          let sv0 = sget s in
          let off = (match rest with
                     | Cons (VHsh h9, _) ->
                       (match hash_lookup (hderef h9) (VSym "offset") with
                        | (true, VInt o) -> o
                        | _ -> 0)
                     | _ -> 0) in
          let _ = (if off < 0 then (let _ = prim_raise "ArgumentError" "offset can't be negative" in ())
                   else if off > str_len sv0 then (let _ = prim_raise "ArgumentError" "offset outside of string" in ())
                   else ()) in
          let sv = (if off > 0 then substring sv0 off (str_len sv0) else sv0) in
          let d0 = (if str_len f > 0 then char_at f 0 else "") in
          // "U" (UTF-8 codepoints) keeps its own path; everything else goes
          // through the byte-directive unpacker (N/n/V/v/C/c/H/a/A + count/*).
          let arr = (if str_eq d0 "U" then arr_new (utf8_codepoints sv 0)
                     else rb_unpack sv f) in
          // unpack1 returns just the first element (nil when empty).
          if str_eq name "unpack1" then
            (match arr with VArr id -> (match deref id with Cons (v, _) -> v | Nil -> VNil) | _ -> VNil)
          else arr
        | Cons (VNil, _) -> prim_raise "TypeError" "no implicit conversion of nil into String"
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
     | _ -> recv)
  // combination / permutation without a block are ENUMERATORS, not the list of
  // tuples: the enumerator is answered from the array as it is when it is
  // WALKED, so `enum = a.permutation; a << 3; enum.to_a` sees the third element.
  // Materialising here froze the array at the call.
  else if (str_eq name "combination" || str_eq name "permutation")
          && (match recv with VArr _ -> true | _ -> false)
          && (if prim_user_has world recv name then false else true) then
    make_enum_a world recv name args
  else if str_eq name "product" && (match recv with VArr _ -> true | _ -> false)
          && (if prim_user_has world recv "product" then false else true) then
    (match recv with
     | VArr id ->
       // every argument must be an Array (or offer #to_ary, tried upstream);
       // a non-array was silently answering [].
       (let rec chk = fn (az: Val list) ->
          (match az with
           | Nil -> true
           | Cons (VArr _, t) -> chk t
           | Cons (other, _) ->
             (let _ = raise_exc world "TypeError"
                        ("no implicit conversion of " ++ class_name other ++ " into Array") in false)) in
        let _ = chk args in
        let _ = arr_product_guard (val_list_len (deref id)) args in
        arr_new (arr_product_n (deref id) args))
     | _ -> recv)
  // Comparable#clamp / #between? (any comparable receiver, incl. user <=>).
  // #clamp / #between? are Comparable's, and a Complex has no order: it does
  // not include Comparable at all.
  else if (str_eq name "clamp" || str_eq name "between?") && is_cpx recv then
    (let _ = map_set prim_missing "n" (mkstr name) in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr ("mere-ruby: undefined method '" ++ name ++ "'"))) in fail ("mere-ruby: undefined method '" ++ name ++ "'")))
  else if str_eq name "clamp" then clamp_val world recv args
  else if str_eq name "between?" then
    (match args with Cons (lo, Cons (hi, _)) -> VBool (cmp_vals_w world recv lo >= 0 && cmp_vals_w world recv hi <= 0) | _ -> VBool false)
  // String#match? / #match (and the Regexp receiver forms).
  // A Symbol answers both by way of its name, and a String argument on either
  // side is a PATTERN, not a literal (`"abc".match("b")`, `/b/.match(:abc)`).
  else if str_eq name "match?" && (match recv with VStr _ -> true | VRegex _ -> true | VSym _ -> true | _ -> false) then
    (match recv with
     // a Symbol answers #match? through its NAME, position argument included:
     // matching the whole name ignored the 2nd argument, so `:abcd.match?(/b/,
     // 2)` was true where the String form is false. Asking the string re-uses
     // the arm below instead of writing the offset rule a second time.
     | VSym s -> invoke_val_c env world blk (mkstr s) name args false
     | VStr h ->
       // match?(pat, pos): matching starts at the CHARACTER position.
       let sv0 = sget h in
       let sv = (match args with
                 | Cons (_, Cons (VInt off, _)) ->
                   (let cn = utf8_len sv0 in
                    let cst = (if off < 0 then cn + off else off) in
                    if cst < 0 || cst > cn then "" else substring sv0 (utf8_boff sv0 cst 0) (str_len sv0))
                 | _ -> sv0) in
       (match args with
        | Cons (_, Cons (VInt off, _)) ->
          (let cn = utf8_len sv0 in
           let cst = (if off < 0 then cn + off else off) in
           if cst < 0 || cst > cn then VBool false
           else (match args with
                 | Cons (VRegex (p, pf, _), _) -> VBool (rx_match p pf sv)
                 | Cons (VStr p, _) -> VBool (rx_match (sget p) "" sv)
                 | _ -> VBool false))
        | Cons (VRegex (p, pf, _), _) -> VBool (rx_match p pf sv)
        | Cons (VStr p, _) -> VBool (rx_match (sget p) "" sv)
        | _ -> VBool false)
     | VRegex (p, pf, _) -> (match args with Cons (VStr sv, _) -> VBool (rx_match p pf (sget sv)) | Cons (VSym sv, _) -> VBool (rx_match p pf sv) | _ -> VBool false)
     | _ -> VBool false)
  // gsub/sub with a String or Hash replacement, handled where `world` is:
  // $~ ends up holding the last (gsub) / first (sub) match, hash values go
  // through the world (default_proc answers missing keys, values #to_s),
  // and the result's encoding is negotiated PIECE BY PIECE, which is how an
  // ASCII-only prefix lets an incompatible replacement flip the encoding.
  // -str deduplicates through the intern table -- except a frozen string
  // carrying instance variables, which keeps its identity (ruby's rule).
  else if (str_eq name "-@" || str_eq name "dedup") && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr h ->
       (let (m9i, s9i, o9i, iv9i) = world in
        let pfx = "str:" ++ str_of_int h ++ "@" in
        let found = map_new () in
        let _ = map_iter iv9i (fn (k: str) -> fn (v: Val) ->
          (if str_len k > str_len pfx && str_eq (substring k 0 (str_len pfx)) pfx
           then map_set found "y" VNil else ())) in
        if map_has found "y" then prim_method recv "-@" args
        else str_fstring recv)
     | _ -> recv)
  else if (str_eq name "gsub" || str_eq name "gsub!")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with Cons (_, Nil) -> true | _ -> false) then
    make_enum_a world recv name args
  // sub has no enumerator form: one argument and no block is an arity error.
  else if (str_eq name "sub" || str_eq name "sub!")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with Cons (_, Nil) -> true | _ -> false) then
    raise_exc world "ArgumentError" "wrong number of arguments (given 1, expected 2)"
  else if (str_eq name "gsub" || str_eq name "sub" || str_eq name "gsub!" || str_eq name "sub!")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with Cons (_, Cons (rv9, Nil)) -> (match rv9 with VStr _ -> false | VHsh _ -> false | _ -> true) | _ -> false) then
    (match args with
     | Cons (_, Cons (rv9, Nil)) -> raise_exc world "TypeError" ("no implicit conversion of " ++ class_name rv9 ++ " into String")
     | _ -> VNil)
  // ...and a PATTERN that is neither a Regexp nor a String refuses by the
  // pattern's own words, whatever the replacement was.
  else if (str_eq name "gsub" || str_eq name "sub" || str_eq name "gsub!" || str_eq name "sub!")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with
              | Cons (p9, Cons (_, Nil)) -> (match p9 with VStr _ -> false | VRegex (_, _, _) -> false | _ -> true)
              | _ -> false) then
    (match args with
     | Cons (p9, _) -> raise_exc world "TypeError" ("wrong argument type " ++ class_name p9 ++ " (expected Regexp)")
     | _ -> VNil)
  else if (str_eq name "gsub" || str_eq name "sub" || str_eq name "gsub!" || str_eq name "sub!")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with
              | Cons (VRegex (_, _, _), Cons (VStr _, Nil)) -> true
              | Cons (VStr _, Cons (VStr _, Nil)) -> true
              | Cons (VRegex (_, _, _), Cons (VHsh _, Nil)) -> true
              | Cons (VStr _, Cons (VHsh _, Nil)) -> true
              | _ -> false) then
    (match recv with
     | VStr h ->
       (let s0 = sget h in
        let e0 = enc_canon_name (senc_get h) in
        // a receiver invalid in its own encoding refuses before matching.
        let _ = (if str_eq e0 "UTF-8" && (if enc_valid_utf8 s0 then false else true)
                 then (let _ = prim_raise "ArgumentError" "invalid byte sequence in UTF-8" in ()) else ()) in
        let (pat, pf) = (match args with
                         | Cons (VRegex (p9, f9, _), _) -> (p9, f9)
                         | Cons (VStr p9, _) -> (rx_escape (sget p9), "")
                         | _ -> ("", "")) in
        let repv = (match args with Cons (_, Cons (rv, _)) -> rv | _ -> VNil) in
        let all = str_eq name "gsub" || str_eq name "gsub!" in
        let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
        let n = str_len s0 in
        // (acc, accenc) — the encoding folds along with the text.
        let app = fn (acc: str) -> fn (ae: str) -> fn (piece: str) -> fn (pe: str) ->
          (let ae2 = enc_compat2 ae acc pe piece in
           if str_eq ae2 "" then
             (let _ = prim_raise "Encoding::CompatibilityError"
                        ("incompatible character encodings: " ++ ae ++ " and " ++ pe) in (acc, ae))
           else (acc ++ piece, ae2)) in
        let rec go = fn (i: int) -> fn (acc: str) -> fn (ae: str) -> fn (found: bool) ->
          (match rxv_search pat pf s0 i with
           | RNoHit ->
             (let _ = (if found then () else
                         (let _ = rx_clear_caps 1 in
                          let _ = map_set globals "~" VNil in
                          let _ = rx_pub_groups s0 1 false "UTF-8" in ())) in
              app acc ae (substring s0 i n) e0)
           | RBadPat -> (acc ++ substring s0 i n, ae)
           | RHit (st, en, saves) ->
             let ng = rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ pat)) in
             let _ = rxv_export_caps saves ng in
             let _ = rx_publish_at world s0 st en ng (senc_get h) in
             let (rep, re9) = (match repv with
                               | VStr rh -> (rx_expand_rep (sget rh) s0 st en 0 "", enc_canon_name (senc_get rh))
                               | VHsh _ ->
                                 (let m = substring s0 st en in
                                  match invoke_val_c env world nb repv "[]" (Cons (mkstr m, Nil)) false with
                                  | VStr rh2 -> (sget rh2, enc_canon_name (senc_get rh2))
                                  | VNil -> ("", "US-ASCII")
                                  | ov -> (w_to_s world ov, "UTF-8"))
                               | _ -> ("", "US-ASCII")) in
             let (acc1, ae1) = app acc ae (substring s0 i st) e0 in
             let (acc2, ae2) = app acc1 ae1 rep re9 in
             let w9 = (if st < n then utf8_clen s0 st else 1) in
             if en <= st then
               (if all then
                  (if st >= n then (acc2, ae2)
                   else (match app acc2 ae2 (substring s0 st (st + w9)) e0 with
                         | (acc3, ae3) -> go (st + w9) acc3 ae3 true))
                else app acc2 ae2 (substring s0 st n) e0)
             else
               (if all then go en acc2 ae2 true
                else app acc2 ae2 (substring s0 en n) e0)) in
        match go 0 "" e0 false with
        | (r, re) ->
          (if str_eq name "gsub!" || str_eq name "sub!" then
             (if str_eq r s0 then VNil else (let _ = sset h r in let _ = senc_set h re in recv))
           else (let c = mkstr r in (match c with VStr rid -> (let _ = senc_set rid re in c) | _ -> c))))
     | _ -> VNil)
  // blockless String#scan leaves $~ holding the LAST match (nil when none),
  // and every piece carries the receiver's encoding; the prim below has no
  // world for either, so wrap it here.
  else if str_eq name "scan" && (match recv with VStr _ -> true | _ -> false)
          && (match args with Cons (VRegex (_, _, _), _) -> true | Cons (VStr _, _) -> true | _ -> false) then
    (match recv with
     | VStr h ->
       (let e = enc_canon_name (senc_get h) in
        let sv = sget h in
        let (pat, pf) = (match args with
                         | Cons (VRegex (p9, f9, _), _) -> (p9, f9)
                         | Cons (VStr p9, _) -> (rx_escape (sget p9), "")
                         | _ -> ("", "")) in
        let items = rx_scan_all2 pat pf sv 0 in
        let _ = rb_scan_lastpub world pat pf sv (senc_get h) in
        arr_new (rb_scan_tag items e))
     | _ -> VNil)
  // String#index/rindex/byteindex/byterindex/partition/rpartition with a
  // Regexp: search (with a character offset where one is taken), publish $~
  // like =~ does, and answer in characters (bytes for the byte pair).
  // prim_method has no world, so the regexp forms live here.
  // [] / slice with a Regexp: the value-level prim answers, but $~ has to be
  // published (or cleared) around it -- 'hello'[/.(.)/, 1] leaves $~ set.
  else if (str_eq name "[]" || str_eq name "slice")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with Cons (VRegex (_, _, _), _) -> true | _ -> false) then
    (match recv with
     | VStr h ->
       (let s = sget h in
        let _ = (match args with
                 | Cons (VRegex (p, pf, _), _) ->
                   (match rxv_search p pf s 0 with
                    | RHit (st, en, saves) ->
                      (let ng = rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ p)) in
                       let _ = rxv_export_caps saves ng in
                       let _ = rx_publish_at world s st en ng (senc_get h) in ())
                    | _ ->
                      (let _ = rx_clear_caps 1 in
                       let _ = map_set globals "~" VNil in
                       let _ = rx_pub_groups s 1 false "UTF-8" in ()))
                 | _ -> ()) in
        prim_method recv name args)
     | _ -> VNil)
  else if (str_eq name "index" || str_eq name "rindex" || str_eq name "byteindex" || str_eq name "byterindex"
           || str_eq name "partition" || str_eq name "rpartition")
          && (match recv with VStr _ -> true | _ -> false)
          && (match args with Cons (VRegex (_, _, _), _) -> true | _ -> false) then
    (match recv with
     | VStr h ->
       let sv = sget h in
       (match args with
        | Cons (VRegex (p, pf, _), rest) ->
          // a regexp whose SOURCE bytes are not valid UTF-8 was compiled in
          // another encoding: matching it against a UTF-8 string is ruby's
          // CompatibilityError (the exact foreign encoding is not tracked).
          let _ = (if str_eq (enc_canon_name (senc_get h)) "UTF-8" && enc_valid_utf8 sv
                      && (if enc_valid_utf8 p then false else true)
                   then (let _ = prim_raise "Encoding::CompatibilityError"
                                   ("incompatible encoding regexp match (EUC-JP regexp with UTF-8 string)") in ())
                   else ()) in
          let cn = utf8_len sv in
          let n = str_len sv in
          if str_eq name "index" || str_eq name "byteindex" then
            (let off0 = (match rest with Cons (VInt o, _) -> o | _ -> 0) in
             let lim = (if str_eq name "index" then cn else n) in
             let off = (if off0 < 0 then lim + off0 else off0) in
             // an out-of-range offset answers nil WITHOUT touching $~
             // (ruby 3.2.2 leaves the previous match visible there).
             if off < 0 || off > lim then VNil
             else
               let bst = (if str_eq name "index" then utf8_boff sv off 0 else off) in
               (match rx_idx_pub world p pf sv bst (senc_get h) with
                | VInt ci -> (if str_eq name "index" then VInt ci else VInt (utf8_boff sv ci 0))
                | other -> other))
          else if str_eq name "rindex" || str_eq name "byterindex" then
            (let lim0 = (if str_eq name "rindex" then cn else n) in
             let off0 = (match rest with
                         | Cons (VInt o, _) -> o
                         | Cons (VNil, _) ->
                           (match prim_raise "TypeError" "no implicit conversion from nil to integer" with _ -> lim0)
                         | _ -> lim0) in
             let off = (if off0 < 0 then lim0 + off0 else off0) in
             if off < 0 then (let _ = map_set globals "~" VNil in VNil)
             else
               let blim = (if str_eq name "rindex" then utf8_boff sv (if off > cn then cn else off) 0
                           else (if off > n then n else off)) in
               (match rx_last_pub world p pf sv blim (senc_get h) with
                | VInt ci -> (if str_eq name "rindex" then VInt ci else VInt (utf8_boff sv ci 0))
                | other -> other))
          else if str_eq name "partition" then
            (match rxv_search p pf sv 0 with
             | RHit (st, en, saves) ->
               (let ng = rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ p)) in
                let _ = rxv_export_caps saves ng in
                let _ = rx_publish_at world sv st en ng (senc_get h) in
                arr_new (Cons (mkstr_e (substring sv 0 st) (senc_get h), Cons (mkstr_e (substring sv st en) (senc_get h), Cons (mkstr_e (substring sv en n) (senc_get h), Nil)))))
             | _ -> (let _ = map_set globals "~" VNil in
                     arr_new (Cons (mkstr sv, Cons (mkstr "", Cons (mkstr "", Nil))))))
          else
            (let (st, en) = rx_last_hit p pf sv 0 n (0 - 1) (0 - 1) in
             if st < 0 then (let _ = map_set globals "~" VNil in
                             arr_new (Cons (mkstr "", Cons (mkstr "", Cons (mkstr sv, Nil)))))
             else
               (let _ = rx_last_pub world p pf sv n (senc_get h) in
                arr_new (Cons (mkstr_e (substring sv 0 st) (senc_get h), Cons (mkstr_e (substring sv st en) (senc_get h), Cons (mkstr_e (substring sv en n) (senc_get h), Nil))))))
        | _ -> VNil)
     | _ -> VNil)
  else if str_eq name "match" && (match recv with VStr _ -> true | VRegex _ -> true | VSym _ -> true | _ -> false) then
    (let hit = (fn (p: str) -> fn (pf: str) -> fn (sv: str) -> fn (enc: str) ->
                  let _ = rx_do_match_atp world p pf sv 0 enc false in
                  if map_has globals "~" then map_get globals "~" else VNil) in
     // the same, from a BYTE offset into the WHOLE subject -- see
     // rx_do_match_at: the subject stays whole so #begin is the real one.
     // Neither wants the character position: they read $~, which carries the
     // span in bytes and converts only if someone asks for #begin.
     let hit_at = (fn (p: str) -> fn (pf: str) -> fn (sv: str) -> fn (b: int) -> fn (enc: str) ->
                  let _ = rx_do_match_atp world p pf sv b enc false in
                  if map_has globals "~" then map_get globals "~" else VNil) in
     match recv with
     // ...and #match, for the same reason.
     | VSym s -> invoke_val_c env world blk (mkstr s) name args false
     // match(re, pos): the position is in characters, and matching starts there
     | VStr h ->
       let sv = sget h in
       (match args with
        | Cons (VRegex (p, pf, _), Cons (VInt off, _)) ->
          // an ASCII subject needs no walk at all: character index == byte
          // index, so both the bound check and the offset are O(1). This is
          // one anchored match per token for a StringScanner, and the walk
          // made the whole scan quadratic.
          (if str_is_ascii h then
             (let cn = str_len sv in
              if off < 0 && cn + off < 0 then VNil
              else let cst = (if off < 0 then cn + off else off) in
                   if cst > cn then VNil else hit_at p pf sv cst (senc_get h))
           else
             let cn = utf8_len sv in
             let cst = (if off < 0 then cn + off else off) in
             if cst < 0 || cst > cn then VNil
             else hit_at p pf sv (utf8_boff sv cst 0) (senc_get h))
        | Cons (VRegex (p, pf, _), _) -> hit p pf sv (senc_get h)
        | Cons (VStr p, _) -> hit (sget p) "" sv (senc_get h)
        // a Regexp SUBCLASS instance (an object with its own #match) decides
        // itself: ruby calls pattern.match(self).
        | Cons (VObj oq, _) ->
          (let (mq2, sq2, ocq2, iq2) = world in
           let oclq = map_get ocq2 oq in
           let nb2 = (false, (Nil : str list), (Nil : Stmt list), env) in
           if has_meth world oclq "match" then invoke world nb2 (VObj oq) oclq "match" (Cons (recv, Nil))
           else prim_raise "TypeError" ("wrong argument type " ++ class_name (VObj oq) ++ " (expected Regexp)"))
        // a pattern that is neither (and did not convert via #to_str
        // upstream) refuses in the pattern's words.
        | Cons (other, _) -> prim_raise "TypeError" ("wrong argument type " ++ class_name other ++ " (expected Regexp)")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1..2)")
     | VRegex (p, pf, _) ->
       (match args with
        // ⚠ `re.match(str, pos)` starts AT pos, in characters, and a negative
        // one counts from the end -- `String#match` has honoured its second
        // argument all along and this one dropped it, so every match started at
        // 0 whatever it was told. A position past the end matches nothing
        // rather than being clamped.
        | Cons (VStr sv, Cons (VInt off9, _)) ->
          (let s9 = sget sv in
           if str_is_ascii sv then
             (let cn9 = str_len s9 in
              if off9 < 0 && cn9 + off9 < 0 then VNil
              else let cst9 = (if off9 < 0 then cn9 + off9 else off9) in
                   if cst9 > cn9 then VNil else hit_at p pf s9 cst9 (senc_get sv))
           else
             let cn9 = utf8_len s9 in
             let cst9 = (if off9 < 0 then cn9 + off9 else off9) in
             if cst9 < 0 || cst9 > cn9 then VNil
             else hit_at p pf s9 (utf8_boff s9 cst9 0) (senc_get sv))
        | Cons (VStr sv, _) -> hit p pf (sget sv) (senc_get sv)
        | Cons (VSym sv, _) -> hit p pf sv (sym_enc_name sv)
        // nil matches nothing (and does NOT refuse); anything else has to be
        // string-like, and ruby names what it could not convert.
        | Cons (VNil, _) -> VNil
        | Cons (other, _) ->
          (match conv_try env world other "to_str" with
           | VStr sv2 -> hit p pf (sget sv2) (senc_get sv2)
           | _ -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String"))
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1..2)")
     | _ -> VNil)
  // fetch raises a catchable KeyError / IndexError when absent (no default/block).
  else if str_eq name "fetch" && (match recv with VHsh _ -> true | VArr _ -> true | _ -> false)
          && (match args with Nil -> true | _ -> false) then
    prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1..2)"
  // ⚠ div / divmod / modulo / remainder / quo / fdiv / pow COERCE their
  //   argument -- they never ask #to_int -- so an object with no #coerce is a
  //   TypeError however many other conversions it offers, and the message
  //   names the object's OWN class. The leaf has no world to ask with, so it
  //   left the object to the paths below: `13.divmod(obj)` answered nil,
  //   `4.div(obj)` came back as NoMethodError, and `4.quo(obj)` as
  //   ZeroDivisionError -- three shapes for one refusal.
  else if (str_eq name "div" || str_eq name "divmod" || str_eq name "modulo"
           || str_eq name "remainder" || str_eq name "quo" || str_eq name "fdiv"
           || str_eq name "pow")
          && (is_num recv || is_cpx recv)
          && (match args with Cons (VObj _, Nil) -> true | _ -> false)
          && (match args with
              | Cons (o9, _) -> (if has_coerce world o9 then false else true)
              | Nil -> false) then
    (match args with
     | Cons (o9, _) ->
       raise_exc world "TypeError"
         (display_cls_msg world (dispatch_cls_of world o9) ++ " can't be coerced into "
          ++ (if str_eq name "quo" then "Rational" else class_name recv))
     | Nil -> VNil)
  // ...and one that DOES coerce answers through the operator: `4.pow(obj)` is
  // `4 ** obj`, which is the path that already knows the protocol. Sending it
  // to the exponent arithmetic instead raised a bare internal failure.
  else if str_eq name "pow" && (is_num recv || is_cpx recv)
          && (match args with Cons (VObj _, Nil) -> true | _ -> false) then
    invoke_val_c env world blk recv "**" args false

  // Hash's Enumerable surface in the forms that take no block (see
  // hash_enum_delegate): answered over the pairs, which is what ruby answers.
  else if (match recv with VHsh _ -> true | _ -> false) && hash_enum_delegate name then
    (match recv with
     | VHsh h9 ->
       // ...and the names whose blockless form is an ENUMERATOR keep the HASH
       // as its receiver: that is what ruby prints, and asking that enumerator
       // again WITH a block lands on the hash's own iterator.
       (if enum_arg_iter name || str_eq name "find_index"
        then make_enum_a world recv name args
        else invoke_val_c env world blk (arr_new (hash_to_a (hderef h9))) name args false)
     | _ -> recv)
  // String#start_with? / #end_with? take SEVERAL patterns and answer true on
  // the first that matches -- and start_with? takes a REGEXP, anchored at the
  // beginning. Only the first argument was read, and only when it was already
  // a String: `"abc".start_with?("x", "a")` answered false, a Regexp answered
  // false instead of matching, and an Integer answered false instead of
  // raising. The walk converts lazily, left to right, so a hit before a bad
  // argument answers true without ever converting it (ruby's order).
  else if (str_eq name "start_with?" || str_eq name "end_with?")
          && (match recv with VStr _ -> true | _ -> false) then
    (match recv with
     | VStr h ->
       (let sv = sget h in
        let starts = str_eq name "start_with?" in
        // ⚠ the match has to land on a CHARACTER boundary: `"\xe3\x81\x82"
        //   .start_with?("\xe3")` is FALSE in ruby even though the bytes agree,
        //   because the prefix is part of one character. A byte comparison
        //   answered true. The check is the ENCODING's, not the value's -- the
        //   same bytes tagged BINARY are three characters and the answer is
        //   true -- so it only applies to a UTF-8 receiver.
        let utf8 = str_eq (enc_canon_name (senc_get h)) "UTF-8" in
        let bnd = fn (k: int) ->
          (if utf8 then
             (if k >= str_len sv || k <= 0 then true
              else (let b9 = ord (char_at sv k) in
                    if b9 >= 128 && b9 < 192 then false else true))
           else true) in
        let hit1 = fn (pp: str) ->
          (if starts then str_starts_with sv pp && bnd (str_len pp)
           else str_ends_with sv pp && bnd (str_len sv - str_len pp)) in
        let rec go = fn (ps: Val list) ->
          (match ps with
           | Nil -> VBool false
           | Cons (VStr ph, t9) -> (if hit1 (sget ph) then VBool true else go t9)
           | Cons (VRegex (pat, pf, _), t9) ->
             (if starts then
                // a match must begin AT 0, and a miss leaves $~ nil -- which
                // is what ruby leaves behind for a pattern that matched later
                // in the string.
                (let anch = (match rxv_search pat pf sv 0 with
                             | RHit (st9, _, _) -> st9 == 0
                             | RBadPat -> rx_find_start pat sv 0 == 0
                             | RNoHit -> false) in
                 if anch then (let _ = rx_do_match world pat pf sv (senc_get h) in VBool true)
                 else (let _ = rx_clear_caps 1 in
                       let _ = map_set globals "~" VNil in
                       let _ = rx_pub_groups sv 1 false "UTF-8" in
                       go t9))
              // end_with? takes no Regexp at all: it is refused as something
              // that cannot convert to a String, which is what ruby says.
              else (let _ = raise_exc world "TypeError"
                              "no implicit conversion of Regexp into String" in VBool false))
           | Cons (other, t9) ->
             (match conv_try env world other "to_str" with
              | VStr ph -> (if hit1 (sget ph) then VBool true else go t9)
              | _ -> (let _ = raise_exc world "TypeError"
                        ("no implicit conversion of " ++ conv_name other ++ " into String") in VBool false))) in
        go args)
     | _ -> VBool false)

  // Hash#fetch_values without a block: a key that is not there is a KeyError
  // carrying the key and the receiver. The leaf read each value with hash_get,
  // which answers NIL for a missing key, so `{a: 1}.fetch_values(:a, :b)`
  // answered [1, nil] -- #fetch has raised here all along, and its plural did
  // not. (The block form, which supplies the value, is builtin_iter's.)
  else if str_eq name "fetch_values" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     | VHsh h ->
       (let xs = hderef h in
        let ci = hcbi_on h in
        let rec go = fn (ks: Val list) ->
          (match ks with
           | Nil -> (Nil : Val list)
           | Cons (k, t) ->
             Cons ((if hash_haskey_x ci xs k then hash_get_x ci xs k
                    else raise_exc_iv world "KeyError" ("key not found: " ++ inspect k)
                           (Cons (("__key", k), Cons (("__recv", recv), Nil)))), go t)) in
        arr_new (go args))
     | _ -> recv)
  else if str_eq name "fetch" && (match recv with VHsh _ -> true | VArr _ -> true | _ -> false) then
    (match recv with
     | VHsh h -> let xs = hderef h in let ci = hcbi_on h in (match args with Cons (k, rest) -> (if hash_haskey_x ci xs k then hash_get_x ci xs k else (match rest with Cons (d, _) -> d | Nil -> raise_exc_iv world "KeyError" ("key not found: " ++ inspect k) (Cons (("__key", k), Cons (("__recv", recv), Nil))))) | _ -> VNil)
     | VArr id -> let ys = deref id in let n = val_list_len ys in (match args with Cons (VInt i, rest) -> let j = (if i < 0 then n + i else i) in (if j >= 0 && j < n then val_nth ys j else (match rest with Cons (d, _) -> d | Nil -> raise_exc world "IndexError" ("index " ++ str_of_int i ++ " outside of array bounds: -" ++ str_of_int n ++ "..." ++ str_of_int n))) | _ -> VNil)
     | _ -> VNil)
  // Array#min(n) / #max(n): the argument is an integer CONVERSION, and a
  // non-negative one. Matching `VInt n` alone made every other kind of
  // argument look like "no argument at all", so `[1, 2].max(1.5)` answered 2
  // instead of [2] and `[3, 1, 2].max(-1)` answered [] instead of raising --
  // and the user-object arms below dropped the n as well, so an array of
  // objects answered ONE object for `max(2)`. rng_take_count is the conversion
  // Range#max(n) has always used.
  // ...but Array reads a NIL n as "no argument" where Range raises on it, so
  // `[1, 2].max(nil)` is 2 and `(1..3).max(nil)` is a TypeError.
  else if (str_eq name "min" || str_eq name "max")
          && (match recv with VArr _ -> true | _ -> false)
          && (match args with Cons (VNil, _) -> false | Cons (_, _) -> true | _ -> false) then
    (match recv with
     | VArr id ->
       (let k9 = (match args with
                  | Cons (a9, _) -> rng_take_count world a9 true
                  | _ -> 0) in
        let st9 = sort_w world (deref id) in
        arr_new (val_take (if str_eq name "max" then rev_vals st9 else st9) k9))
     | _ -> recv)
  // sort/min/max of an array of user objects use their <=> (pure cmp_vals can't).
  else if str_eq name "sort" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | Cons (VClass _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> arr_new (sort_w world (deref id)) | _ -> recv)
  else if str_eq name "min" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | Cons (VClass _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> (match sort_w world (deref id) with Nil -> VNil | Cons (h, _) -> h) | _ -> VNil)
  else if str_eq name "max" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | Cons (VClass _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> (match val_rev (sort_w world (deref id)) Nil with Nil -> VNil | Cons (h, _) -> h) | _ -> VNil)
  // ... and the ones that were NOT here, which is why they still could not reach
  // a user <=>: sort! (in place), minmax, and the pair sort behind Hash#sort.
  // Array#<=> answers NIL when a pair does not compare -- it is not the
  // sorting comparison, which raises. Returning `VInt (arr_cmp_w ...)` could
  // not express nil at all, so a pair whose #<=> answered nil became an
  // ArgumentError from deeper down. One name, two questions.
  else if str_eq name "<=>" && (match recv with VArr _ -> true | _ -> false)
          && (match args with Cons (VArr _, _) -> true | _ -> false) then
    (match recv with
     | VArr x -> (match args with
                  | Cons (VArr y, _) -> arr_spaceship_w env world (deref x) (deref y)
                  | _ -> VNil)
     | _ -> VNil)
  else if str_eq name "sort!" && (match recv with VArr id -> (match deref id with Cons (VObj _, _) -> true | Cons (VClass _, _) -> true | _ -> false) | _ -> false) then
    (match recv with VArr id -> (let _ = arr_set id (sort_w world (deref id)) in recv) | _ -> recv)
  else if str_eq name "sort" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     | VHsh h -> arr_new (sort_w world (hash_pairs (hderef h)))
     | _ -> VNil)
  // reduce/inject symbol form (no block): `[1,2,3].reduce(:+)` /
  // `.inject(init, :*)`. The block form is handled in invoke_with_block.
  // ⚠ the operator may be a STRING: `[1, 2].inject(10, "-")` is ruby's, and
  //   ruby converts it (to_str, then to_sym). Only a Symbol was matched, so
  //   the String form fell through to the leaf and came back "undefined method
  //   'inject' for an instance of Array" -- the method reported missing was
  //   the one being called.
  else if (str_eq name "reduce" || str_eq name "inject") &&
          (match args with
           | Cons (VSym _, _) -> true | Cons (_, Cons (VSym _, _)) -> true
           | Cons (VStr _, _) -> true | Cons (_, Cons (VStr _, _)) -> true
           // ...and an OBJECT operator converts through #to_str, which is the
           // conversion ruby asks for (a to_str-only object names the method).
           | Cons (VObj _, Nil) -> true | Cons (_, Cons (VObj _, Nil)) -> true
           | _ -> false) then
    (match recv with
     | VArr id -> reduce_sym env world blk (deref id) args
     | VRange (lo, hi, excl) -> reduce_sym env world blk (range_vals world lo hi excl) args
     | _ -> prim_method recv name args)
  else prim_method recv name args

// does `recv` respond to `name`? (used by respond_to?)
// a bound Method object: a synthetic-class VObj carrying receiver + name
// (+ the owner class resolved at creation time, for #owner/#unbind).

// the class a receiver's method named nm is found in ("" = builtin/unknown).
and bm_owner_of = fn world -> fn (recv: Val) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  match recv with
  | VMain -> ""
  | VObj oid ->
    (let ocl = map_get ocls oid in
     let a = owner_anc world (ancestors_of world ocl) nm in
     if str_eq a "" && map_has meths (ocl ++ "#" ++ nm) then ocl
     // a method the object has as a BUILTIN is owned by its class too. Leaving
     // this empty made #owner fall back to a generic class name, and it also
     // decided Method equality: two aliases of one ENV method compared unequal
     // because the alias table is keyed by owner and the owner was blank.
     else if str_eq a "" && builtin_obj_has ocl nm then ocl
     else a)
  | VClass c2 ->
    (let sng = "(sng:" ++ c2 ++ ")" in
     let a = owner_anc world (ancestors_of world sng) nm in
     if str_eq a "" && map_has meths (sng ++ "#" ++ nm) then sng
     // Kernel's module functions are ITS singleton's; its instance methods are
     // Kernel's, whatever module object was asked. Without these the owner
     // fell through to the Module surface the name was found on.
     else if str_eq a "" && str_eq c2 "Kernel" && is_kernel_builtin nm
             && (if is_kernel_priv_only nm then false else true) then sng
     else if str_eq a "" && (is_kernel_pub_instance nm || is_kernel_builtin nm) then "Kernel"
     else a)
  | other ->
    (let cn = class_name other in
     let a = owner_anc world (ancestors_of world cn) nm in
     if str_eq a "" && map_has meths (cn ++ "#" ++ nm) then cn else a)

// Method#arity from a user method's params/defaults (-1 for builtins).
and bm_arity = fn world -> fn (owner0: str) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  // ...and the arity is the BODY's, whatever class owns the method (see
  // body_cls_of: `public :m` in a subclass owns it without defining it).
  let owner = body_cls_of world owner0 nm in
  // the explicit-but-empty `||` sentinel is not a parameter, here either: a
  // `define_method(:m) { || }` counted it and answered arity 1 for a method
  // that takes nothing. #parameters and #arity read the same list and have to
  // strip the same bookkeeping from it.
  if map_has meths (owner ++ "#" ++ nm) then
    (match map_get meths (owner ++ "#" ++ nm) with
     | Meth (params, defaults, _) -> bm_arity_go (strip_marker_params params) defaults 0 false false false)
  else if map_has meths nm then
    (match map_get meths nm with Meth (params, defaults, _) -> bm_arity_go (strip_marker_params params) defaults 0 false false false)
  else builtin_arity_of world owner nm

// The arity of a BUILTIN method. Every one of them answered -1 -- which is not
// "unknown", it is ruby's spelling of "takes any number of arguments" -- so
// `String.instance_method(:size).arity` claimed a method that takes none would
// take anything.
//
// ⚠ It is read from arity_num_tbl, NOT derived from the bounds beside it: the
// bounds say what a call may pass, #arity says what the method DECLARED, and
// they disagree wherever a C function is variadic. `String#sub` accepts exactly
// two arguments without a block and reports -1; `String#size` accepts none and
// reports 0. Deriving arity from min/max gets every fixed one right and every
// variadic one WRONG -- which is how `sub` went from -1 (right by accident) to
// 2 (wrong on purpose). A name with no row keeps -1.
and builtin_arity_of = fn world -> fn (cls: str) -> fn (nm: str) ->
  let _ = (if map_has arity_state "l" then ()
           else (let _ = map_set arity_state "l" 1 in
                 if str_eq (env_get "MERE_RUBY_NO_ARITY") "" then arity_build () else ())) in
  let key0 = cls ++ "#" ++ nm in
  let key = (if map_has arity_num_tbl key0 then key0
             else if obj_is_a world cls "Enumerable" && map_has arity_num_tbl ("Enumerable#" ++ nm)
             then "Enumerable#" ++ nm
             else if obj_is_a world cls "Comparable" && map_has arity_num_tbl ("Comparable#" ++ nm)
             then "Comparable#" ++ nm
             else key0) in
  if map_has arity_num_tbl key then map_get arity_num_tbl key else 0 - 1
// The keywords contribute ONE argument between them (the hash): a required
// keyword makes it mandatory, an optional one only makes the count a lower
// bound. `def f(y:, z:)` is arity 1, `def f(x, y: 1)` is -2.

// Method#parameters: the declaration in order. Whether a name is required or
// optional is the presence of a DEFAULT, which is kept in its own list.
and bm_params = fn world -> fn (owner0: str) -> fn (nm: str) ->
  let (meths, sup, ocls, ivars) = world in
  // the owner may be a class that only PUBLISHED the method; the parameters
  // are the body's.
  let owner = body_cls_of world owner0 nm in
  let key = owner ++ "#" ++ nm in
  if map_has meths key then
    (match map_get meths key with Meth (ps, ds, _) -> arr_new (param_meta_of true ps ds))
  else if map_has meths nm then
    (match map_get meths nm with Meth (ps, ds, _) -> arr_new (param_meta_of true ps ds))
  // ⚠ a BUILTIN method is not in the method table, and neither is one backed
  //   by respond_to_missing? -- this answered an EMPTY parameter list for both,
  //   which claims a method that takes nothing. ruby derives a C method's
  //   parameters from its ARITY, with no names (there are none to give):
  //   `1.method(:+)` is [[:req]], `[].method(:push)` is [[:rest]], and
  //   `[].method(:size)` really is []. Read from arity_num_tbl for the same
  //   reason #arity does -- the bounds beside it say what a CALL may pass, and
  //   they disagree with the declaration wherever a C function is variadic.
  else
    (let a9 = builtin_arity_of world owner nm in
     let k9 = owner ++ "#" ++ nm in
     let has9 = (if map_has arity_num_tbl k9 then true
                 else if obj_is_a world owner "Enumerable"
                         && map_has arity_num_tbl ("Enumerable#" ++ nm) then true
                 else if obj_is_a world owner "Comparable"
                         && map_has arity_num_tbl ("Comparable#" ++ nm) then true
                 else false) in
     if has9 then
       (if a9 >= 0 then arr_new (bm_kind_meta "req" a9)
        else arr_new (list_append (bm_kind_meta "req" (0 - a9 - 1))
                        (Cons (arr_new (Cons (VSym "rest", Nil)), Nil))))
     // ...and a name with NO row is one of two things: a builtin the table
     // does not cover (`Array#each`, whose parameters really are []), or a
     // method the object only CLAIMS through respond_to_missing?, which ruby
     // reports as [[:rest]]. Asking whether the class defines
     // respond_to_missing? is what tells them apart -- a default of [[:rest]]
     // for both would claim arguments for every uncovered builtin.
     else if has_meth world owner "respond_to_missing?" then
       arr_new (Cons (arr_new (Cons (VSym "rest", Nil)), Nil))
     else arr_new Nil)

// n copies of a one-element parameter description ([[:req], [:req]] ...): a C
// method's parameters have no names, and ruby prints them without.

// The synthetic classes whose methods live in the primitive dispatcher rather
// than the method table. respond_to? has to know about them, or a delegator
// asked to forward `write` to a File decides the File cannot take it.

// Ruby's IMPLICIT conversion attempt (rb_check_funcall), which is not the same
// question as respond_to?: a real method wins; otherwise a user-defined
// respond_to? / respond_to_missing?(name, TRUE -- include_private, unlike
// respond_to?'s default) decides, and when it says yes (or says nothing) a
// user method_missing is asked. `responds` alone answered "no" for every
// method_missing-based object, so [obj].flatten kept the object instead of
// flattening what its method_missing returns. Answers nil for "not
// convertible", which is also what a #to_ary answering nil means.
// An argument that is neither a Regexp nor a String is CONVERTED, not printed:
// #to_regexp first, then #to_str, and a TypeError naming the class when it
// offers neither. Quoting its #to_s instead made `Regexp.union(obj, "bar")`
// the pattern /\#<object>|bar/ -- and accepted a Symbol and an Integer, which
// ruby refuses because neither answers #to_str.
// ...named the way ruby names it: nil / true / false spell themselves, and
// everything else answers with its CLASS -- read through the world, because
// class_name has none and stops at "Object" for every user-defined class.
and rx_union_conv = fn env -> fn world -> fn (sym_ok: bool) -> fn (xs: Val list) ->
  match xs with
  | Nil -> (Nil : Val list)
  | Cons (h9, t9) ->
    (let v9 = (match h9 with
               | VRegex (_, _, _) -> h9
               | VStr _ -> h9
               // ⚠ ...and a Symbol, but ONLY as the single argument: that path
               // quotes through Regexp.quote, which takes a Symbol, while two
               // or more go through the String conversion, which does not.
               | VSym _ -> (if sym_ok then h9 else rx_union_refuse world h9)
               | other9 ->
                 (match conv_try env world other9 "to_regexp" with
                  | VRegex (a9, b9, c9) -> VRegex (a9, b9, c9)
                  | _ ->
                    (match conv_try env world other9 "to_str" with
                     | VStr s9 -> VStr s9
                     // ...named the way ruby names it: nil / true / false
                     // spell themselves, everything else answers with its
                     // CLASS (conv_name stops at "Object" for a user class).
                     | _ -> rx_union_refuse world other9))) in
     Cons (v9, rx_union_conv env world sym_ok t9))
and conv_try = fn env -> fn world -> fn (v: Val) -> fn (mname: str) ->
  match v with
  | VObj id ->
    (let (meths, sup, ocls, ivars) = world in
     let cls = map_get ocls id in
     let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
     // an undef'd name is not there to be called, no matter that the builtin
     // (or a superclass) would have answered it -- fall through to the
     // respond_to? / method_missing half, which is where ruby ends up too.
     let live = (if undef_blocked world cls mname then false else true) in
     // ⚠ A user #respond_to? is asked BEFORE the lookup, not only when the
     // lookup fails. ruby's rb_check_funcall goes through rb_respond_to
     // whatever the class has, so an object that DEFINES #to_s and denies it
     // from #respond_to? is not convertible -- `String(obj)` is a TypeError
     // there and answered `obj.to_s` here, because the deny was only consulted
     // on the path where the method was missing anyway.
     let rt_ok =
       (if has_meth world cls "respond_to?" then
          (let extra = (match lookup_meth world cls "respond_to?" with
                        | Meth (ps, ds, _) ->
                          (if takes_include_all ps ds then Cons (VBool true, Nil) else Nil)) in
           truthy (invoke world nb v cls "respond_to?" (Cons (VSym mname, extra))))
        else true) in
     if (if rt_ok then false else true) then VNil
     else if live && has_meth world cls mname then invoke_val_c env world nb v mname Nil false
     else if live && (is_prim_method mname || builtin_obj_has cls mname) then
       invoke_val_c env world nb v mname Nil false
     else
       // ...and respond_to_missing?(name, true) is asked TOO (ruby asks both --
       // the first is not a substitute for the second), and only then
       // method_missing. A missing answer is a decline, never an error.
       (
          (let rtm_ok =
             (if has_meth world cls "respond_to_missing?" then
                truthy (invoke world nb v cls "respond_to_missing?"
                          (Cons (VSym mname, Cons (VBool true, Nil))))
              else true) in
           if (if rtm_ok then false else true) then VNil
           else if has_meth world cls "method_missing" then
             invoke world nb v cls "method_missing" (Cons (VSym mname, Nil))
           else VNil)))
  | _ -> VNil

// The key a hash actually STORES for `h[k] = v`: an existing key that is eql?
// to k stays in place (so a second, equal key object never replaces the first),
// and a fresh String key is stored as a FROZEN COPY -- mutating the original
// must not change the key, and the stored key carries no singleton methods.
// An object key's #eql? is dispatched here, which the value-level comparison
// cannot do.
// The key this hash STORES that is eql? to k, asking the KEY -- the plain
// comparison is identity for an object, so a class that defines #hash and
// #eql? was not honoured on the way OUT (it already was on the way in, which
// is why `h[K.new(1)] = v; h[K.new(1)]` stored one pair and found none).
// Answers (found, the stored key), so the caller can re-ask with a key the
// fast path will find. Only reached when the fast lookup MISSED, so an
// ordinary hash pays one map lookup for it.
// Two hashes are equal when they hold the same pairs -- and "the same" is the
// VALUE's own #==, which the structural comparison cannot ask: a Hash of
// objects (a Set#classify answer, whose values are Sets) compared by identity
// and said false. Only reached when the structural comparison already said no.
and arr_eq_w = fn env -> fn world -> fn (xs: Val list) -> fn (ys: Val list) ->
  match (xs, ys) with
  | (Nil, Nil) -> true
  | (Cons (x, xt), Cons (y, yt)) ->
    (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
     let same = (if obj_answers_eq world x
                 then truthy (invoke_val_c env world nb9 x "==" (Cons (y, Nil)) false)
                 else cmp_member_w env world x y) in
     if same then arr_eq_w env world xt yt else false)
  | (_, _) -> false

and hash_eq_w = fn env -> fn world -> fn (h1: int) -> fn (h2: int) ->
  let xs = hderef h1 in
  let ys = hderef h2 in
  if hash_len xs == hash_len ys then hash_eq_w_go env world h2 xs else false
and hash_eq_w_go = fn env -> fn world -> fn (h2: int) -> fn (xs: Val list) ->
  match xs with
  | Cons (k, Cons (v, t)) ->
    (let ci2 = hcbi_on h2 in
     let found = (if hash_haskey_x ci2 (hderef h2) k then (true, hash_get_x ci2 (hderef h2) k)
                  else (let (f9, kk9) = hash_find_key_w env world h2 k in
                        if f9 then (true, hash_get_x ci2 (hderef h2) kk9) else (false, VNil))) in
     match found with
     | (false, _) -> false
     | (_, v2) ->
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
        let same = (if obj_answers_eq world v
                    then truthy (invoke_val_c env world nb9 v "==" (Cons (v2, Nil)) false)
                    else cmp_member_w env world v v2) in
        if same then hash_eq_w_go env world h2 t else false))
  | _ -> true

and hash_find_key_w = fn env -> fn world -> fn (hid: int) -> fn (k: Val) ->
  if hcbi_on hid then (false, VNil)
  else
    (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
     let rec go = fn (ys: Val list) ->
       (match ys with
        | Cons (k2, Cons (_, t)) ->
          (if truthy (invoke_val_c env world nb9 k "eql?" (Cons (k2, Nil)) false) then (true, k2) else go t)
        | _ -> (false, VNil)) in
     go (hderef hid))

// does this key bring its own #eql? and #hash? (both, as ruby requires)
// does this hash hold an object anywhere? (only such a hash can disagree with
// the structural comparison)
// does this container hold an object whose class defines #== ? Only such a
// member can disagree with the structural comparison, and asking one that does
// NOT define it is a NoMethodError rather than an answer.
and arr_has_obj = fn world -> fn (xs: Val list) ->
  match xs with
  | Nil -> false
  | Cons (VObj o9, t) -> (if obj_answers_eq world (VObj o9) then true else arr_has_obj world t)
  | Cons (_, t) -> arr_has_obj world t

// can the dispatcher answer #== for this object? A user method, or a builtin
// arm (a Time compares by its instant, a Method by its definition). Asking one
// that can answer NEITHER is a NoMethodError, not a false.
// a member that is itself a container is compared the same way, all the way
// down: `[[Version.new(1)]] == [[Version.new(1)]]` is one nesting deeper than
// the structural answer can see
and cmp_member_w = fn env -> fn world -> fn (x: Val) -> fn (y: Val) ->
  if rb_eq x y then true
  else
    (match (x, y) with
     | (VArr a3, VArr b3) -> arr_eq_w env world (deref a3) (deref b3)
     | (VHsh h3, VHsh g3) -> hash_eq_w env world h3 g3
     | (_, _) -> false)

and obj_answers_eq = fn world -> fn (v: Val) ->
  match v with
  // through the DISPLAY class: an object with a singleton (a Time with a
  // `def t.succ` on it) dispatches through "(sng:N)", which no builtin list
  // mentions, and the array of them then compared by identity
  | VObj _ -> (let c9 = dispatch_cls_of world v in
               has_meth world c9 "==" || builtin_obj_has (display_cls world c9) "==")
  | _ -> false

and hash_has_obj = fn world -> fn (xs: Val list) -> arr_has_obj world xs

and key_has_own_eql = fn world -> fn (k: Val) ->
  match k with
  | VObj _ -> (let c9 = dispatch_cls_of world k in has_meth world c9 "eql?" && has_meth world c9 "hash")
  | _ -> false

and hash_store_key = fn env -> fn world -> fn (hid: int) -> fn (k: Val) ->
  let ci = hcbi_on hid in
  let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let rec find9 = fn (ys: Val list) ->
    (match ys with
     | Cons (k2, Cons (_, t)) ->
       // ⚠ through hkey_eql_w, the ONE rule: this was a partial copy of it --
       //   it asked #eql? without asking #hash first, so two keys whose hashes
       //   DIFFER were treated as the same key whenever eql? said yes, and the
       //   second store replaced the first instead of adding a pair.
       (if (if ci then hkey_same true k2 k else hkey_eql_w env world hid k2 k)
        then Cons (k2, Nil) else find9 t)
     | _ -> (Nil : Val list)) in
  match find9 (hderef hid) with
  | Cons (kk, _) -> kk
  | Nil ->
    (match k with
     | VStr sh9 ->
       // ...unless it is ALREADY frozen, in which case it is stored as it is
       // (there is nothing to protect the hash from).
       (if ci || sfrozen_get sh9 then k
        else (let c9 = mkstr (sget sh9) in
              let _ = (match c9 with
                       | VStr nid9 -> (let _ = senc_set nid9 (senc_get sh9) in
                                       let _ = sfrozen_set nid9 in ())
                       | _ -> ()) in
              c9))
     | _ -> k)

// Kernel#respond_to?(name, include_all = false), for every receiver. PUBLIC
// methods only unless include_all is asked for: a PROTECTED method does not
// answer it either, which the include_all half of the old arms knew and the
// default half did not. The name argument reads the same way it does
// everywhere else -- Symbol, String, or #to_str -- and anything that is none
// of those is a TypeError, not a false. There were two copies of this arm (one
// for a plain value, one for an object) and they had drifted apart.
// #public_send is PUBLIC-only, which is a STRONGER question than "may I call
// this from here": a protected method is callable from a sibling instance and
// still refuses public_send. vischeck answers the first question, so the
// second has to be asked separately -- `public_send :protected_method` from
// inside the object's own method ran the method.
and public_send_guard = fn world -> fn (recv: Val) -> fn (m: str) ->
  let c9 = dispatch_cls_of world recv in
  if meth_protected world c9 m
  then (let _ = raise_exc world "NoMethodError"
          ("protected method '" ++ m ++ "' called for " ++ for_recv_cls world c9) in ())
  else ()

// the method-name argument of send / __send__ / public_send, read the way
// every other name argument is: Symbol, String, #to_str, and a TypeError for
// what is none of those. No argument at all is ruby's "no method name given".
and send_name_arg = fn env -> fn world -> fn (args: Val list) ->
  match args with
  | Cons (VSym m, _) -> m
  | Cons (VStr m, _) -> sget m
  | Cons (other, _) ->
    (match conv_try env world other "to_str" with
     | VStr h9 -> sget h9
     | _ -> (let _ = raise_exc world "TypeError"
               (inspect other ++ " is not a symbol nor a string") in ""))
  | Nil -> (let _ = raise_exc world "ArgumentError" "no method name given" in "")

and respond_to_answer = fn env -> fn world -> fn (recv: Val) -> fn (args: Val list) ->
  let all = (match args with
             | Cons (_, Cons (VBool b, _)) -> b
             | Cons (_, Cons (VNil, _)) -> false
             | Cons (_, Cons (_, _)) -> true
             | _ -> false) in
  let nm = (match args with
            | Cons (VSym m, _) -> m
            | Cons (VStr m, _) -> sget m
            | Cons (other, _) ->
              (match conv_try env world other "to_str" with
               | VStr h9 -> sget h9
               | _ -> (let _ = raise_exc world "TypeError"
                         (inspect other ++ " is not a symbol nor a string") in ""))
            | Nil -> (let _ = raise_exc world "ArgumentError"
                        "wrong number of arguments (given 0, expected 1..2)" in "")) in
  let c9 = dispatch_cls_of world recv in
  // the TABLE form: this function is the builtin #respond_to?, so asking the
  // object's own override from here is asking itself.
  if responds_tbl world recv nm then
    (if all then VBool true
     else VBool (if meth_protected world c9 nm then false else true))
  else if all then
    // include_all: the private ones too. A class receiver answers through its
    // METACLASS chain, and `.new` is a builtin with no table entry -- when
    // private_class_method hid it, the mark is the only record that it is there.
    VBool (match recv with
           | VClass c8 ->
             (let sng8 = "(sng:" ++ c8 ++ ")" in
              has_meth world sng8 nm || (str_eq nm "new" && meth_private world sng8 "new"))
           | _ -> has_meth world c9 nm)
  else VBool false

// ruby's coerce protocol does NOT go through respond_to?: it looks the method
// up and calls it, so a PRIVATE #coerce is used like any other (`(10**20) + obj`
// with a private coerce answers the sum in ruby and refused here). This asks
// the method table, which sees private methods too.
and has_coerce = fn world -> fn (v: Val) ->
  match v with
  | VObj _ -> (let c9 = dispatch_cls_of world v in has_meth world c9 "coerce")
  | _ -> false

and responds = fn world -> fn (recv: Val) -> fn (name: str) -> responds_x world recv name true

// ...and the same question WITHOUT asking a user-defined #respond_to?. This is
// what the builtin #respond_to? itself computes, and it is where a `super` from
// an override has to land: routing that back through the asking form made the
// override ask itself, and `MockObject.new('x').respond_to?(:each_entry)` came
// back out of the loop as true while `:each` came back false.
and responds_tbl = fn world -> fn (recv: Val) -> fn (name: str) -> responds_x world recv name false

and responds_x = fn world -> fn (recv: Val) -> fn (name: str) -> fn (ask_user: bool) ->
  match recv with
  | VObj id ->
    let (meths, sup, ocls, ivars) = world in
    let cls = map_get ocls id in
    let nb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
    // a user-defined #respond_to? overrides the internal logic (CRuby asks
    // the object; a spec mock answers true here). Only consult it when the
    // class defines its own (not the builtin), to avoid recursion.
    // an undef'd name does not answer respond_to? -- but a REDEFINED
    // respond_to? still gets to say whatever it likes about it.
    if undef_blocked world cls name && (if ask_user && has_meth world cls "respond_to?" then false else true) then false
    else if ask_user && has_meth world cls "respond_to?" then
      // ruby passes the include_all flag only to a respond_to? that TAKES it
      // (it looks at the arity), so a one-parameter override still works and
      // a two-parameter one does not get an ArgumentError.
      // ...and the flag is TRUE: every caller left here is an internal protocol
      // probe (#to_str, #to_int, #coerce, #each), and ruby asks those through
      // rb_check_funcall, which passes priv=TRUE. The public question is
      // answered by responds_tbl now, so passing false here was asking a
      // different question from the one ruby asks.
      (let extra = (match lookup_meth world cls "respond_to?" with
                    | Meth (ps, ds, _) -> (if takes_include_all ps ds then Cons (VBool true, Nil) else Nil)) in
       truthy (invoke world nb (VObj id) cls "respond_to?" (Cons (VSym name, extra))))
    else
    // a private method does not answer respond_to? (ruby needs the
    // include_all argument for that), so `private :m` really hides it.
    (has_meth world cls name && (if meth_private world cls name then false else true))
    || is_prim_method name || builtin_obj_has cls name
    // an exception really does respond to the methods answered for it further
    // in (respond_to?(:message) said false while #message worked, which is the
    // pair of answers a library checks before calling)
    // ...and a Numeric subclass responds to the two unary operators Numeric
    // itself defines.
    // ...and to a name `alias_method` pointed at a builtin: the delegation is
    // real, so `method(:my_inspect)` and respond_to? have to see it.
    || (if str_eq (blt_alias_lookup world (ancestors_of world cls) name) "" then false else true)
    // ⚠ ...and to the rest of Numeric's DERIVED methods, which the dispatcher
    //   answers for a subclass (see invoke_val_c) but nothing claimed: so
    //   `sub.respond_to?(:zero?)` was false and `sub.method(:abs)` raised for
    //   methods that work -- and Complex()'s own #real? probe goes through
    //   `responds`, so a Numeric subclass component was refused as "not a
    //   real". The answer and the claim have to come from one list.
    || ((str_eq name "+@" || str_eq name "-@" || is_numeric_own_method name)
        && obj_is_a world cls "Numeric")
    || (exc_is_a world cls "Exception"
        && (str_eq name "message" || str_eq name "backtrace" || str_eq name "set_backtrace" || str_eq name "cause"
            || str_eq name "backtrace_locations" || str_eq name "full_message"
            || str_eq name "detailed_message" || str_eq name "exception"))
    // respond_to_missing?(name, include_private=false): a method_missing-based
    // object can claim to respond to names it has no real method for.
    || (has_meth world cls "respond_to_missing?"
        && truthy (invoke world nb (VObj id) cls "respond_to_missing?" (Cons (VSym name, Cons (VBool false, Nil)))))
  // a class/module responds via its class-method (metaclass) chain — the
  // has_meth walk of (sng:C) covers inherited class methods and, through
  // sng_supername's BasicObject -> Class step, Class/Module instance methods.
  // Instance methods of C itself do NOT make C respond (Ruby semantics).
  // ...plus the Module/Class instance methods, which every module really
  // does respond to (zeitwerk asks for `method(:autoload?)` on a module).
  // A module object is an Object: it answers Kernel's public instance methods.
  // And Kernel's MODULE FUNCTIONS are its own public singleton methods, which
  // is what `Kernel.respond_to?(:fail)` asks about -- it answered false, so
  // `Kernel.method(:fail)` was a NameError.
  | VClass c -> (str_eq name "new" && (if meth_private world ("(sng:" ++ c ++ ")") "new" then false else true))
                || has_meth world ("(sng:" ++ c ++ ")") name
                || is_kernel_pub_instance name
                || (str_eq c "Kernel" && is_kernel_builtin name
                    && (if is_kernel_priv_only name then false else true))
                || is_prim_method name || is_module_method name
                || builtin_class_method c name || str_eq name "autoload"
                || str_eq name "autoload?" || str_eq name "define_method"
                || str_eq name "define_singleton_method"
                || str_eq name "instance_variable_set" || str_eq name "private_method_defined?"
  // A primitive may be an instance of a SUBCLASS with methods of its own --
  // optparse's CompletingHash < Hash defines #match, and `respond_to?(:match)`
  // is what decides whether optparse accepts it. Calling the method already
  // worked; only the question was answered wrong.
  | VStr _ -> (if undef_blocked world (dispatch_cls_of world recv) name then false
               else prim_user_has world recv name || is_prim_method name || is_str_method name || str_eq name "to_str"
                    || op_responds recv name)
  | VProc _ -> is_prim_method name || is_proc_method name || op_responds recv name
  // the implicit-conversion protocol is per type, so a duck-type check
  // (`x.respond_to? :to_str`) tells strings from everything else.
  | VArr _ -> prim_user_has world recv name || is_prim_method name || is_arr_method name || op_responds recv name
  | VHsh _ -> prim_user_has world recv name || is_prim_method name || is_hash_method name || op_responds recv name
  // the numeric primitives, so `5.method(:abs)` and respond_to? agree with
  // what the dispatcher actually implements.
  | VInt _ -> prim_user_has world recv name || is_prim_method name || num_has recv name || op_responds recv name
  | VFlt _ -> prim_user_has world recv name || is_prim_method name || num_has recv name || op_responds recv name
  // Bignum, Rational and Complex had no entry at all and fell to the default
  // "no", so Complex#to_r was reachable but respond_to?(:to_r) denied it --
  // and ruby's Rational() decides which protocol to use by asking exactly that.
  | VBig _ -> prim_user_has world recv name || is_prim_method name || num_has recv name || op_responds recv name
  | VRat (_, _) -> prim_user_has world recv name || is_prim_method name || num_has recv name || op_responds recv name
  | VCpx (_, _) -> prim_user_has world recv name || is_prim_method name || num_has recv name || op_responds recv name
  | VRange (_, _, _) ->
    is_range_method name || range_delegate_name name || is_enum_method name || is_prim_method name
    || op_responds recv name
  // a Regexp had no entry at all, so it denied `match` -- and optparse asks
  // exactly that before accepting a pattern (`pat.respond_to?(:match) or
  // raise`), which is where its load stopped.
  | VRegex (_, _, _) -> prim_user_has world recv name || is_regex_method name || is_prim_method name || op_responds recv name
  // every other primitive -- Symbol, nil, true/false -- can have methods too,
  // through its own class or through a reopened Kernel: `module Kernel; def m`
  // makes `:sym.respond_to?(:m)` true, and asking the table is what says so.
  // Symbol had no arm of its own, so `:s.respond_to?(:to_proc)` was false
  // for a method that works -- and `defined?(:s.to_proc)` with it.
  | VSym _ -> prim_user_has world recv name || is_prim_method name || is_sym_method name || op_responds recv name
  | _ -> prim_user_has world recv name || is_prim_method name || op_responds recv name

// The OPERATORS a primitive answers. respond_to? has to agree with the call:
// the dispatcher answers `1.send(:+, 2)` and `1.+(2)` through one allowlist,
// so `1.respond_to?(:+)` saying false was the same fact spelled two ways --
// and it is what made `defined?(42 / 2)` nil and every arithmetic operator
// invisible to a duck-type check.
//
// The sets are ruby's, asked per receiver kind: a Float has no `<<` or `~`, a
// Complex has no ordering, a Hash orders but does not add. `!` and `===` come
// from Object and belong to everything.

// Symbol method names the dispatcher implements, for respond_to?. Taken by
// asking mere-ruby to CALL each of ruby's Symbol instance methods, so the
// claim cannot be wider than the implementation. `id2name` and `name` are the
// two ruby has that this does not (MISSING_NAMES.md).

// Regexp method names the dispatcher implements, for respond_to?.

// does the value's class (a builtin subclass, or a reopened builtin) define
// this method in ruby?
// One random index in [0, k), from the built-in generator or from a `random:`
// object's #rand. ⚠ The object's answer is CHECKED, not trusted: ruby raises
// RangeError naming the number when it falls outside, which is the whole point
// of letting a caller supply the generator. A Float is truncated (0.5 is index
// 0, not the middle of the array), and anything else is asked for #to_int.
and rnd_index = fn env -> fn world -> fn (rng: Val) -> fn (k: int) ->
  match rng with
  | VNil -> mt_rand_int 0 k
  | _ ->
    (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
     let r9 = invoke_val_c env world nb9 rng "rand" (Cons (VInt k, Nil)) false in
     let v9 = (match r9 with
               | VInt i9 -> i9
               | VFlt f9 -> int_of_float f9
               | other9 ->
                 (match conv_try env world other9 "to_int" with
                  | VInt i9 -> i9
                  | _ -> (match prim_raise "TypeError"
                            ("no implicit conversion of " ++ dispatch_cls_of world other9 ++ " into Integer") with _ -> 0))) in
     if v9 < 0 then (match prim_raise "RangeError" ("random number too small " ++ str_of_int v9) with _ -> 0)
     else if v9 >= k then (match prim_raise "RangeError" ("random number too big " ++ str_of_int v9) with _ -> 0)
     else v9)
// take k elements the way val_shuffle does -- pick an index, remove it, recurse
// -- so EVERY POSITION of the result is uniform, which is what the fairness
// spec measures position by position. Taking the first k of a full shuffle
// would do as well; stopping early just avoids the rest of the work.
// ⚠ #shuffle is a BACKWARD Fisher-Yates, and ruby/spec pins the permutation a
// seed produces -- so the order the draws are made in is part of the answer,
// not an implementation detail. CRuby walks i down from len, drawing j in
// [0, i) and swapping element i-1 with j. Picking-and-removing from the front
// (which val_shuffle_r does, and which is just as uniform) consumes the same
// numbers in a different order and lands on a different permutation.
and val_shuffle_fy = fn env -> fn world -> fn (rng: Val) -> fn (xs: Val list) -> fn (n: int) ->
  (let perm = map_new () in
   let pg = fn (i: int) -> (if map_has perm (str_of_int i) then map_get perm (str_of_int i) else i) in
   let rec go = fn (i: int) ->
     (if i <= 1 then ()
      else
        (let j = rnd_index env world rng i in
         let i2 = i - 1 in
         let a = pg i2 in let b = pg j in
         let _ = map_set perm (str_of_int i2) b in
         let _ = map_set perm (str_of_int j) a in
         go i2)) in
   let _ = go n in
   let rec build = fn (k: int) ->
     (if k >= n then (Nil : Val list) else Cons (val_nth xs (pg k), build (k + 1))) in
   build 0)
and val_shuffle_r = fn env -> fn world -> fn (rng: Val) -> fn (xs: Val list) -> fn (n: int) -> fn (k: int) ->
  if k <= 0 || n <= 0 then (Nil : Val list)
  else
    (let i9 = rnd_index env world rng n in
     Cons (val_nth xs i9, val_shuffle_r env world rng (val_without_nth xs i9) (n - 1) (k - 1)))
// ---- Integer#[] : a slice of BITS -------------------------------------
// Transcribed from CRuby's int_aref / int_aref2 rather than approximated. The
// whole method is two operations:
//
//     n[beg, len]  ==  (n >> beg) & ((1 << len) - 1)
//
// and every "special case" falls out of them instead of needing an arm:
//
//   len < 0   1 << -1 is 0, so the mask is -1 and nothing is masked off --
//             which is what "ignores negative length" means.
//   beg < 0   >> by a negative shifts LEFT, moving the window up into the
//             more significant bits.
//
// Writing those as `if beg < 0 || len <= 0 then 0` (which is what stood here)
// answers zero for both, and for the reversed and endless ranges too.
// ...and ONE bit, which is where the index conversions land.
and prim_user_has = fn world -> fn (recv: Val) -> fn (name: str) ->
  let c = dispatch_cls_of world recv in
  ((if str_eq c "" then false else has_meth world c name)
   && (if meth_private world c name then false else true))
  // ...or the value's own SINGLETON class. dispatch_cls_of deliberately looks
  // past it (so `super` resumes above the singleton), which left respond_to?
  // answering false for a method `def a.m` had just defined and calling worked.
  || hng_sng_has world recv name

// does this value's singleton class (from `def value.method`) define `name`?
and hng_sng_has = fn world -> fn (recv: Val) -> fn (name: str) ->
  let hk = hng_key recv in
  (if str_eq hk "" then false else map_has hng_store hk)
  && (let c9 = map_get hng_store hk in is_sng_cls c9 && has_meth world c9 name)

// Proc/lambda method names, for respond_to?.

// string-specific method names dispatch_prim implements, for respond_to?.

// Array's and Hash's builtin method names. Dispatch itself is a name chain
// rather than a table, so these lists are what reflection (instance_method /
// respond_to?) has to consult — without them a container answers `false` to
// respond_to?(:map), which duck-typing code reads as "not enumerable".
// eql? — == with no numeric conversion, so 1.eql?(1.0) is false. Containers
// compare element-wise by the same rule ([1].eql?([1.0]) is false too).
and rb_eql = fn (a: Val) -> fn (b: Val) ->
  if str_eq (class_name a) (class_name b) then
    (match a with
     | VArr ia -> (match b with VArr ib -> val_eql_list (deref ia) (deref ib) | _ -> false)
     // ⚠ Two Complexes are eql? when each PART is eql?, which is stricter than
     // ==: `Complex(1,2).eql?(Complex(1.0,2.0))` is false in ruby. Both are
     // class Complex, so the outer check passed and rb_eq compared them
     // numerically -- true, for two objects ruby says are not interchangeable
     // (they hash differently, which is what eql? is for).
     | VCpx (ar, ai) -> (match b with VCpx (br, bi) -> rb_eql ar br && rb_eql ai bi | _ -> false)
     | _ -> rb_eq a b)
  else false

and val_eql_list = fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (match ys with Nil -> true | _ -> false)
  | Cons (x, xt) ->
    (match ys with
     | Nil -> false
     | Cons (y, yt) -> if rb_eql x y then val_eql_list xt yt else false)



// Ruby gives several builtin methods two names for the same implementation, so
// `String.instance_method(:size) == String.instance_method(:length)` is true.
// Dispatch treats them as separate names; this collapses each pair onto one
// canonical name so reflection can see that they are one method.
// The name a method is DEFINED as, for `cls#n`: an alias made in ruby resolves
// through alias_srcname, and an alias of a BUILTIN through canon_alias. Method
// equality and #original_name both ask this one question, and asking only half
// of it made `m.method(:foo) == m.method(:bar)` false for a ruby-level alias
// while it was true for a builtin one.
// where a `def` was written. A builtin has no ruby source and answers nil,
// which is also what ruby does for one.
and meth_source_location = fn world -> fn (own0: str) -> fn (nm: str) -> fn (recv: Val) ->
  // the source is the BODY's, whatever class owns the method (body_cls_of).
  let own = body_cls_of world own0 nm in
  let k9 = (if str_eq own "" then
              (match recv with
               | VClass c9 -> "(sng:" ++ c9 ++ ")#" ++ nm
               | VMain -> nm
               | other9 -> class_name other9 ++ "#" ++ nm)
            else own ++ "#" ++ nm) in
  let k9 = (if map_has meth_src k9 then k9 else nm) in
  if map_has meth_src k9 && map_has meth_src ("f" ++ k9)
  then (match map_get meth_src ("f" ++ k9) with
        | VStr h9 -> (if str_eq (sget h9) "" then VNil
                      else arr_new (Cons (mkstr (sget h9), Cons (map_get meth_src k9, Nil))))
        | _ -> VNil)
  else VNil


// #original_name is a DIFFERENT question from method equality, and answering
// both from canon_alias got one of them wrong in every group where ruby keeps
// both names. `String.instance_method(:size) == String.instance_method(:length)`
// is true AND `String.instance_method(:size).original_name` is :size -- the pair
// share an implementation without either being "the alias of" the other. Asked of
// the oracle for all 147 names in the groups this interpreter implements: only 25
// collapse, and WHICH way they collapse is per class, not per group. Numeric#conj
// answers :conjugate while Complex#conj answers :conj; Integer#magnitude answers
// :abs while Complex#magnitude answers :magnitude.
//
// The direction here is ruby's own original_name, not the spec prose. Those
// disagree: the specs say "Queue#push is an alias of Queue#<<", and ruby answers
// `Queue.instance_method(:<<).original_name == :push`. The prose describes which
// names share one method; it does not name the definition.

// The name a method reports as #original_name: a ruby-level `alias`/`alias_method`
// resolves through alias_srcname (that table records the pair at the moment the
// name is made), and a builtin through the table above.



// Does builtin class `cls` provide `name` ITSELF -- not counting the shared
// Kernel-ish list every class answers? Two readers need two different
// questions, and one list answering both is what let a reopened Object break
// every builtin: `class Object; def size; end; end` made `[1,2].size` answer
// 99, because has_meth walked past Array (whose #size is a builtin, invisible
// to the walk) and found the user entry on Object. Dispatch asks THIS one --
// a builtin the receiver's own class owns answers before any ancestor's
// user-defined method. Reflection asks builtin_has_meth below, which adds the
// shared list back.
// ⚠ the Range / struct rows name their INCLUDED Enumerable methods too, so a
//   module included into one of those classes does not outrank them here the
//   way ruby's chain would. The reopened-Object case is the one that happens.

// does builtin class `cls` provide method `name`? (reflection only)

// is this one of the classes whose instances the primitive layer implements?
// (the operator fallback above asks it: a user class's `:+` really is absent
// unless its table says otherwise.)
// The methods struct_build writes into every GENERATED class. `Struct` itself
// has no members to answer them with, and reflection still has to see them:
// `Struct.instance_method(:deconstruct)` is a real UnboundMethod in ruby.
// (`to_a` was found here only because Enumerable happens to list it, which is
// why one of the pair answered and the other did not.)
// Exception's OWN instance methods (ruby: Exception.instance_methods(false)).


// The names NUMERIC ITSELF defines. There is no Numeric value to ask num_has
// with, and the union of the four concrete kinds is not this list: ruby's
// `Numeric.instance_method(:even?)` is a NameError while Integer's is a method.
// Enumerated from the oracle (`Numeric.instance_methods(false)`), not from
// what this interpreter happens to implement -- a curated table, because it is
// not derivable from anything here.
// The ordering operators Comparable gives whatever includes it. Numeric does,
// which is why `Numeric.instance_method(:<)` is a method in ruby even though
// Numeric defines none of them itself.

// Numeric's methods that every concrete kind keeps.



// class methods mere-ruby implements on a built-in namespace. `responds` has
// to know them or `Process.method(:clock_gettime)` raises -- timeout.rb opens
// with exactly that line.


// a curated set of universally-available primitive method names.
// Integer / Float methods the primitive dispatcher answers.
// What each kind of Numeric answers to, ONE LIST PER TYPE. There used to be a
// single shared list, and a shared list is as wide as its widest member: it
// claimed `negative?`, `divmod`, `even?` and three dozen more for a Complex,
// which refuses to call every one of them, so respond_to? answered true and
// the call answered NoMethodError. The lists were derived by ASKING both sides
// -- every name x every numeric type, called under ruby and under mere-ruby --
// rather than by remembering which name belongs where.
//
// `rationalize` is claimed because the simplest-fraction search it needs (the
// continued-fraction descent) was implemented; the claim went away while it
// was absent and came back with the implementation, which is the only order in
// which a name list stays true. The complex protocol (imaginary, conj, arg,
// polar, ...) is claimed by all four because every one of them is implemented
// for every Numeric.






// the four as SETS, built once each: `responds` asks this on every primitive
// dispatch, and a linear walk there costs a measurable slice of a spec sweep.



// ---- in-place string mutation --------------------------------------------
// VStr is a handle into str_store, so a mutating method rewrites the store
// entry in place and EVERY alias sees the change (Ruby reference semantics).
// "a".upto("c") -> ["a", "b", "c"]. Ruby stops when the value passes the
// limit in length or order; the guard also bounds a runaway succ chain.

// String#dump: inspect, and additionally escape anything non-ASCII so the
// result is a plain-ASCII literal (which is what dump promises). A multibyte
// CHARACTER escapes as one \uXXXX (or \u{XXXXX} past the BMP, upper-case hex),
// not one \u00nn per byte -- per-byte escapes undump into the wrong string.


// bang methods that delegate to an existing non-bang string transform.

// is this value frozen? (used by the mutation guard)
// The one answer to "is this frozen". #frozen? had its OWN list and said true
// for the immediates while this said false for them, so `1.frozen?` was true
// and `1.send(:initialize_copy, x)` did not refuse. Everything that is not a
// mutable container, a plain object or a Proc is frozen and always was.

// ...and "cannot be modified", which is a different question: it can only be
// asked of a kind that HAS contents. An Integer is frozen, and `0 << 8` is a
// shift, not a mutation -- routing the mutation guards through val_is_frozen
// once it told the truth about immediates refused that shift.
// method names that mutate the receiver in place (String / Array / Hash).
// A trailing-! method is always a mutator; the rest are the non-! in-place
// operations. dup/clone/freeze are NOT mutators.
// ONE rule, one place: a frozen receiver refuses a BUILTIN mutator. Four sites
// were deciding this separately (the two dispatchers, the `<<` operator and the
// block-form iterators), and all four read the NAME -- which is a stand-in for
// "this one writes" and is not true of a method the program defined. Ruby
// raises at the write, so `def zap!; :ok; end` answers on a frozen receiver;
// the Set shipped here has a private `__modify!` that raises with ruby's own
// message, and the guard was answering first, about `Object`.
and builtin_mut_on_frozen = fn world -> fn (recv: Val) -> fn (name: str) ->
  is_mutating_method name && val_frozen_mut recv
  && (if has_meth world (dispatch_cls_of world recv) name then false else true)


// String#slice!(regexp[, group]): remove the GROUP's span (0 = the whole
// match, negative counts back from the last group, out of range or
// non-participating is nil), publish $~ like the non-bang form, and answer
// the removed piece carrying the receiver's encoding. Lives outside
// str_mut_do because publishing $~ needs the world.
and str_slice_bang_rx = fn env -> fn world -> fn (h: int) -> fn (args: Val list) ->
  let s = sget h in
  (match args with
   | Cons (VRegex (p, pf, _), rest) ->
     (match rxv_search p pf s 0 with
      | RHit (st, en, saves) ->
        (let ng = rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ p)) in
         let _ = rxv_export_caps saves ng in
         let _ = rx_publish_at world s st en ng (senc_get h) in
         let gk0 = (match rest with
                    | Cons (VInt g, _) -> g
                    | Cons (VFlt f, _) -> int_of_float f
                    | _ -> 0) in
         let gk = (if gk0 < 0 then ng + 1 + gk0 else gk0) in
         // a negative index cannot reach the whole match (group 0).
         if gk < 0 || gk > ng || (gk0 < 0 && gk == 0) then VNil
         else
           let (gst, gen) = (if gk == 0 then (st, en)
                             else (rxv_slot_get saves (2 * gk), rxv_slot_get saves (2 * gk + 1))) in
           if gst < 0 || gen < gst then VNil
           else
             let piece = substring s gst gen in
             let _ = sset h (substring s 0 gst ++ substring s gen (str_len s)) in
             let c = mkstr piece in
             (match c with VStr rid -> (let _ = senc_set rid (senc_get h) in c) | _ -> c))
      | _ ->
        (let _ = rx_clear_caps 1 in
         let _ = map_set globals "~" VNil in
         let _ = rx_pub_groups s 1 false "UTF-8" in VNil))
   | _ -> VNil)

// mutate the string behind handle h in place; returns the method's value
// (the receiver itself, nil for an unchanged bang method, the assigned
// value for []=). Out-of-range []= indices are clamped.
and str_mut_do = fn (h: int) -> fn (name: str) -> fn (args: Val list) ->
  let s = sget h in
  // slice!(...) removes what #[](...) would return and hands it back. Every
  // form String#[] accepts works here, which is why it delegates rather than
  // repeating the index rules -- and the positions are characters, like #[]'s.
  if str_eq name "slice!" then
    // remove the SPAN #[] would select, not the first occurrence of the text
    // it returns (slice!(-1) on "worl" used to remove the l at index 2).
    (let n = str_len s in
     let cn = utf8_len s in
     let span = (match args with
       | Cons (VInt i, Nil) ->
         (let ci = (if i < 0 then cn + i else i) in
          if ci < 0 || ci >= cn then (0 - 1, 0 - 1)
          else (utf8_boff s ci 0, (if ci + 1 >= cn then n else utf8_boff s (ci + 1) 0)))
       | Cons (VInt i, Cons (VInt l, Nil)) ->
         (let ci = (if i < 0 then cn + i else i) in
          if l < 0 || ci < 0 || ci > cn then (0 - 1, 0 - 1)
          else (utf8_boff s ci 0, utf8_boff s (if ci + l > cn then cn else ci + l) 0))
       | Cons (VRange (lov, hiv, ex), Nil) ->
         (let (st9, en9) = rng_slice_bounds lov hiv ex cn in
          if st9 < 0 || st9 > cn then (0 - 1, 0 - 1)
          else (utf8_boff s st9 0, utf8_boff s (if en9 > cn then cn else if en9 < st9 then st9 else en9) 0))
       | Cons (VStr sub, Nil) ->
         (let i = str_find_from s (sget sub) 0 in
          if i < 0 then (0 - 1, 0 - 1) else (i, i + str_len (sget sub)))
       | Cons (VRegex (p, pf, _), Nil) ->
         (match rxv_search p pf s 0 with RHit (st9, en9, _) -> (st9, en9) | _ -> (0 - 1, 0 - 1))
       | _ -> (0 - 1, 0 - 1)) in
     match span with (b0, b1) ->
     if b0 < 0 then VNil
     else
       let piece = substring s b0 b1 in
       let _ = sset h (substring s 0 b0 ++ substring s b1 n) in
       let c = mkstr piece in
       (match c with VStr rid -> (let _ = senc_set rid (senc_get h) in c) | _ -> c))
  else if str_eq name "clear" then let _ = sset h "" in VStr h
  else if str_eq name "replace" then
    (match args with
     | Cons (v, _) -> let _ = sset h (match v with VStr a -> sget a | _ -> to_s v) in VStr h
     | Nil -> VStr h)
  else if str_eq name "concat" then let _ = sset h (s ++ str_concat_vals args) in VStr h
  // String#append_as_bytes(*args): appends BYTES. A String contributes its
  // bytes as they are and an Integer one byte, its least significant -- so it
  // can build a string that is not valid in its own encoding, which is the
  // point of it. The receiver's encoding never changes.
  // ⚠ no conversion: an object with #to_str is refused, unlike every other
  //   String method that takes one. Measured, not assumed.
  else if str_eq name "append_as_bytes" then
    (let rec go9 = fn (xs: Val list) -> fn (acc: str) ->
       (match xs with
        | Nil -> acc
        | Cons (VStr a9, t9) -> go9 t9 (acc ++ sget a9)
        | Cons (VInt n9, t9) ->
          // the least significant byte, wrapping for a negative (-1 is 255)
          (let b9 = n9 - (n9 / 256) * 256 in
           go9 t9 (acc ++ chr (if b9 < 0 then b9 + 256 else b9)))
        // ⚠ an Integer is TWO representations here, and the spec reaches for
        //   the other one: `append_as_bytes(bignum_value)`. A VBig fell to the
        //   refusal arm and was rejected as "wrong argument type Integer
        //   (expected String or Integer)" -- refusing a value for being the
        //   type it is. big_divmod_s floors toward -infinity, which is ruby's
        //   modulo, so a negative bignum wraps the same way -1 does.
        | Cons (VBig g9, t9) ->
          (let r9 = (match big_divmod_s g9 "256" with (q9, rr9) -> rr9) in
           let b9 = int_of_str r9 in
           go9 t9 (acc ++ chr (if b9 < 0 then b9 + 256 else b9)))
        | Cons (bad9, _) ->
          // prim_raise, not raise_exc: this arm has no world (see prim_method).
          prim_raise "TypeError"
            ("wrong argument type " ++ class_name bad9 ++ " (expected String or Integer)")) in
     let _ = sset h (s ++ go9 args "") in VStr h)
  else if str_eq name "prepend" then
    // every argument must already be a String (#to_str was tried upstream).
    (let rec ck = fn (xs: Val list) ->
       (match xs with
        | Nil -> ()
        | Cons (VStr _, t) -> ck t
        | Cons (other, _) ->
          (let _ = prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String") in ())) in
     let _ = ck args in
     let _ = sset h (str_concat_vals args ++ s) in VStr h)
  else if str_eq name "[]=" then
    // positions are CHARACTERS (an index into "あa" at 1 is the "a"), and a
    // position outside the string is an IndexError / RangeError, not a clamp.
    // A Float position truncates (0.5 indexes at 0), as #to_int would.
    (let n = str_len s in
     let cn = utf8_len s in
     let args = (let fix = fn (v: Val) -> (match v with VFlt f2 -> VInt (int_of_float f2) | _ -> v) in
                 match args with
                 | Cons (a2, Cons (b2, Cons (c2, Nil))) -> Cons (fix a2, Cons (fix b2, Cons (c2, Nil)))
                 | Cons (a2, Cons (b2, Nil)) -> Cons (fix a2, Cons (b2, Nil))
                 | _ -> args) in
     match args with
     | Cons (VInt i, Cons (VStr r, Nil)) ->
       let _ = enc_pair_guard h r in
       let renc = enc_pair_or h r in
       let ci = (if i < 0 then cn + i else i) in
       (if ci < 0 || ci > cn then prim_raise "IndexError" ("index " ++ str_of_int i ++ " out of string")
        else
          let b0 = utf8_boff s ci 0 in
          let b1 = (if ci >= cn then n else utf8_boff s (ci + 1) 0) in
          let _ = sset h (substring s 0 b0 ++ sget r ++ substring s b1 n) in
          let _ = senc_set h renc in VStr r)
     | Cons (VInt i, Cons (VInt len, Cons (VStr r, Nil))) ->
       let _ = enc_pair_guard h r in
       let renc = enc_pair_or h r in
       let ci = (if i < 0 then cn + i else i) in
       (if len < 0 then prim_raise "IndexError" ("negative length " ++ str_of_int len)
        else if ci < 0 || ci > cn then prim_raise "IndexError" ("index " ++ str_of_int i ++ " out of string")
        else
          let ce = (if ci + len > cn then cn else ci + len) in
          let b0 = utf8_boff s ci 0 in
          let b1 = utf8_boff s ce 0 in
          let _ = sset h (substring s 0 b0 ++ sget r ++ substring s b1 n) in
          let _ = senc_set h renc in VStr r)
     // s[m..n] = r : splice over the range (out of bounds is a RangeError).
     | Cons (VRange (lov, hiv, excl), Cons (VStr r, Nil)) ->
       let _ = enc_pair_guard h r in
       let renc = enc_pair_or h r in
       let (st, en1) = rng_slice_bounds lov hiv excl cn in
       (if st < 0 || st > cn then prim_raise "RangeError" (inspect (VRange (lov, hiv, excl)) ++ " out of range")
        else
          let ce = (if en1 > cn then cn else if en1 < st then st else en1) in
          let b0 = utf8_boff s st 0 in
          let b1 = utf8_boff s ce 0 in
          let _ = sset h (substring s 0 b0 ++ sget r ++ substring s b1 n) in
          let _ = senc_set h renc in VStr r)
     // s["sub"] = r : replace the first occurrence of sub, which must exist.
     | Cons (VStr sub, Cons (VStr r, Nil)) ->
       let _ = enc_pair_guard h r in
       let renc = enc_pair_or h r in
       let sub = sget sub in let i = str_find_from s sub 0 in
       (if i < 0 then prim_raise "IndexError" "string not matched"
        else
          let _ = sset h (substring s 0 i ++ sget r ++ substring s (i + str_len sub) n) in
          let _ = senc_set h renc in VStr r)
     // s[/re/] = r : replace the first match, which must exist.
     | Cons (VRegex (p, pf, _), Cons (VStr r, Nil)) ->
       let _ = enc_pair_guard h r in
       let renc = enc_pair_or h r in
       (match rxv_search p pf s 0 with
        | RHit (st, en, _) ->
          (let _ = sset h (substring s 0 st ++ sget r ++ substring s en n) in
           let _ = senc_set h renc in VStr r)
        | _ -> prim_raise "IndexError" "regexp not matched")
     // s[/re/, g] = r : replace capture group g of the first match.
     | Cons (VRegex (p, pf, _), Cons (VInt g, Cons (VStr r, Nil))) ->
       let _ = enc_pair_guard h r in
       let renc = enc_pair_or h r in
       (match rxv_search p pf s 0 with
        | RHit (st, en, saves) ->
          (let ng = rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ p)) in
           let g2 = (if g < 0 then ng + g + 1 else g) in
           // a negative index cannot reach the whole match (group 0).
           if g2 < 0 || g2 > ng || (g < 0 && g2 == 0) then prim_raise "IndexError" ("index " ++ str_of_int g ++ " out of regexp")
           else
             let gs = (if g2 == 0 then st else rxv_slot_get saves (2 * g2)) in
             let ge = (if g2 == 0 then en else rxv_slot_get saves (2 * g2 + 1)) in
             (if gs < 0 || ge < 0 then prim_raise "IndexError" ("regexp group " ++ str_of_int g2 ++ " not matched")
              else
                let _ = sset h (substring s 0 gs ++ sget r ++ substring s ge n) in
                let _ = senc_set h renc in VStr r))
        | _ -> prim_raise "IndexError" "regexp not matched")
     | Cons (VInt _, Cons (other, _)) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
     | Cons (VRange (_, _, _), Cons (other, _)) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
     | Cons (VStr _, Cons (other, _)) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
     // an UNCONVERTED replacement still comes AFTER the match / index checks:
     // ruby raises the IndexError before ever asking the replacement for #to_str.
     | Cons (VRegex (p, pf, _), Cons (VInt g, Cons (other, Nil))) ->
       (match rxv_search p pf s 0 with
        | RHit (st, en, saves) ->
          (let ng = rxv_prog_ng (map_get rx_progs (pf ++ chr 1 ++ p)) in
           let g2 = (if g < 0 then ng + g + 1 else g) in
           if g2 < 0 || g2 > ng || (g < 0 && g2 == 0) then prim_raise "IndexError" ("index " ++ str_of_int g ++ " out of regexp")
           else prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String"))
        | _ -> prim_raise "IndexError" "regexp not matched")
     | Cons (VRegex (p, pf, _), Cons (other, Nil)) ->
       (match rxv_search p pf s 0 with
        | RHit (_, _, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | _ -> prim_raise "IndexError" "regexp not matched")
     | Cons (VRegex (_, _, _), Cons (other, _)) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
     | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
     | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 2..3)")
  else
    // bang: compute via the non-bang base; nil return when unchanged --
    // except succ!/next!, which answer self whether or not anything changed.
    // The scratch copy must CARRY the receiver's encoding (upcase! on a
    // UTF-16 string walked its bytes as UTF-8 without it), and the result's
    // encoding is written back.
    let base = substring name 0 (str_len name - 1) in
    let tmp = mkstr s in
    let _ = (match tmp with VStr tid -> senc_set tid (senc_get h) | _ -> ()) in
    (match prim_method tmp base args with
     | VStr ns ->
       let ns2 = sget ns in
       let _ = senc_set h (senc_get ns) in
       if str_eq base "succ" || str_eq base "next" || str_eq base "reverse" then (let _ = sset h ns2 in VStr h)
       else if str_eq ns2 s then VNil
       // a bang that DOES change a frozen receiver refuses here (the ones the
       // dispatch gate exempts, like scrub!, only pass when nothing changes).
       else if sfrozen_get h then prim_raise "FrozenError" ("can't modify frozen String: " ++ inspect (VStr h))
       else let _ = sset h ns2 in VStr h
     | other -> other)

// Range's own methods (not the ones it borrows from Array by materialising).

// Range#size over numeric bounds: how many integers the walk would hit.



// string methods whose result keeps the receiver's encoding (transformations
// that don't set an encoding of their own — force_encoding/encode/b/scrub are
// excluded). Applied post-hoc so every such method propagates without per-
// method senc_set.
// prim_method wraps the raw dispatch: a String result of an encoding-
// preserving method inherits the receiver's encoding.
// Which (method, receiver) pairs take NO arguments. Every primitive method here
// used to ignore whatever it was handed -- `"bad".to_s(123)` answered "bad" and
// `[].size(1)` answered 0, where Ruby raises ArgumentError. Ignoring an argument
// is a wrong answer twice over: the call was a mistake, and the mistake is
// invisible.
//
// The list is the oracle's, taken by asking CRuby which (name, class) pairs
// answer "wrong number of arguments" -- not which ones raise ArgumentError,
// since `5.to_s(99)` raises that for an invalid radix and DOES take an
// argument. That distinction is why Integer#to_s / #inspect, String#to_i,
// #chomp, #upcase and the rest of the optional-argument family are absent here.

and prim_method = fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  // what the call WAS, for the NoMethodError this may become: the leaf has no
  // world to raise an object with, and the rescue that materialises the
  // exception has only the name. ruby's NoMethodError answers #name, #args and
  // #receiver, and this is the last place that knows all three.
  let _ = map_set prim_missing "av" (arr_new args) in
  let _ = map_set prim_missing "rvv" recv in
  let _ = (match args with
           | Nil -> ()
           | _ ->
             if prim_zero_arity recv name then
               (let _ = prim_raise "ArgumentError"
                          ("wrong number of arguments (given " ++ str_of_int (vlen args)
                           ++ ", expected 0)") in ())
             else ()) in
  let r = prim_method_raw recv name args in
  (match recv with
   | VStr sid ->
     (match r with
      | VStr rid -> (if enc_preserving name then let _ = senc_set rid (senc_get sid) in r else r)
      | _ -> r)
   | _ -> r)
// Symbol answers the String-like queries by looking at its name; the case
// and successor ones answer with a SYMBOL (`:DEBUG.downcase` is `:debug`,
// which is how activesupport derives `debug?` from Logger::Severity).
// One rule for a symbol's encoding, so #encoding, #to_s and #name cannot
// disagree: what to_sym recorded, else US-ASCII when the name is 7-bit and the
// script's encoding otherwise. #to_s only applied the recorded case, so
// `:abc.to_s.encoding` was UTF-8 where #encoding said US-ASCII -- the same
// symbol answering two different encodings depending on which door was used.

and prim_method_raw = fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  // ⚠ ONE refusal, before any of the arithmetic below can compute with it: a
  // zero divisor. `div` / `divmod` / `modulo` / `%` / `remainder` all refuse it
  // whatever the operand TYPES -- including 0.0, which is the case that looked
  // like an exception to the rule and is not. Only `/` and `fdiv` answer
  // Infinity. Each of these arms reached the zero its own way and every one of
  // them came back with a number: `5.0.div(0)` was 9223372036854775807 (the
  // saturating conversion of Infinity) and `5.0 % 0` was 5.0. A fabricated
  // number with no error is the result a caller has no reason to doubt.
  //
  // NaN is the same shape one step further out: it is not zero, so it divides,
  // and floor(x/NaN) saturated to 0 -- ruby refuses it as a FloatDomainError.
  if (str_eq name "div" || str_eq name "divmod" || str_eq name "modulo"
      || str_eq name "%" || str_eq name "remainder")
     && (is_num recv || is_cpx recv)
     && (match args with Cons (a0, Nil) -> num_is_zero a0 | _ -> false) then
    prim_raise "ZeroDivisionError" "divided by 0"
  // ...and pow's SECOND argument is a divisor as well: `2.pow(3, 0)` reached a
  // machine division by zero inside int_pow_mod, so it refused -- but as a
  // bare internal failure rather than by name.
  else if str_eq name "pow" && is_num recv
          && (match args with Cons (_, Cons (m0, _)) -> num_is_zero m0 | _ -> false) then
    prim_raise "ZeroDivisionError" "divided by 0"
  else if (str_eq name "div" || str_eq name "divmod")
          && is_num recv
          && (match args with Cons (a0, Nil) -> num_is_nan a0 | _ -> false) then
    prim_raise "FloatDomainError" "NaN"
  // An operator written as a METHOD is the operator: `10.%(3)` and `s.<<(x)`
  // mean what `10 % 3` and `s << x` mean. Some of these had their own branch
  // below and some did not, so `1.+(2)` worked and `10.%(3)` was an undefined
  // method.
  else
  // `modulo` / `div` / `fdiv` / `remainder` are the named forms of the same
  // arithmetic; they were in the numeric method LIST but had no branch.
  // Rational#div is EXACT: the floor of the fraction, not of a float that
  // rounded it first (Rational(10**20+1, 3).div(1) has no float answer). It
  // goes before the numeric branch below, which converts through to_f.
  if str_eq name "div" && (match recv with VRat _ -> true | _ -> false)
     && (match args with Cons (_, Nil) -> true | _ -> false) then
    (match args with
     // ...but a non-number is refused first, in the receiver's own words: it
     // went into rat_arith, whose zero denominator answered ZeroDivisionError
     // for an argument that is not a number at all.
     | Cons (b9, Nil) when (if is_num b9 then false else true) ->
       prim_raise "TypeError" (conv_name b9 ++ " can't be coerced into Rational")
     | Cons (b, _) ->
       (match rat_arith "/" recv b with
        | VRat (qn, qd) -> norm_big (rat_int_mode "floor" qn qd)
        | VInt qi -> VInt qi
        | VBig qb -> norm_big qb
        | VFlt qf -> VInt (flt_floor qf)
        | v -> v)
     | _ -> VNil)
  // ...and with a RATIONAL argument they are exact as well: this went to the
  // float path, so `(2**64 + 1024).div(Rational(4,1))` came back rounded to a
  // double (4611686018427387904 for a value ruby answers exactly) and
  // `10.remainder(Rational(4,1))` answered the Float 0.0 where ruby answers
  // the exact (2/1).
  else if (str_eq name "div" || str_eq name "remainder")
     && (match recv with VInt _ -> true | VBig _ -> true | _ -> false)
     && (match args with Cons (VRat _, Nil) -> true | _ -> false) then
    (match args with
     | Cons (b9, _) ->
       (if str_eq name "div" then
          (match rat_arith "/" recv b9 with
           | VRat (qn, qd) -> norm_big (rat_int_mode "floor" qn qd)
           | v -> v)
        else
          // remainder keeps the DIVIDEND's sign: self - other * (self/other)
          // truncated toward zero.
          (let q9 = (match rat_arith "/" recv b9 with
                     | VRat (qn, qd) -> norm_big (rat_int_mode "truncate" qn qd)
                     | v -> v) in
           rat_arith "-" recv (rat_arith "*" b9 q9)))
     | _ -> VNil)
  // `div` and `remainder` between INTEGERS are exact. Both went through to_f,
  // so (2**70).div(3) answered the machine maximum and (2**70).remainder(3)
  // answered a Float where ruby answers an Integer.
  else if (str_eq name "div" || str_eq name "remainder")
     && (match recv with VInt _ -> true | VBig _ -> true | _ -> false)
     && (match args with Cons (VInt _, Nil) -> true | Cons (VBig _, Nil) -> true | _ -> false) then
    (match args with
     | Cons (a1, _) ->
       (if str_eq name "div" then arith_bin "/" recv a1
        else
          // remainder keeps the DIVIDEND's sign where % keeps the divisor's,
          // so it differs from % by one |divisor| when the two disagree.
          (let m = arith_bin "%" recv a1 in
           let zero9 = cmp_vals m (VInt 0) == 0 in
           let negr = cmp_vals recv (VInt 0) < 0 in
           let negm = cmp_vals m (VInt 0) < 0 in
           let absb = (if cmp_vals a1 (VInt 0) < 0 then arith_bin "-" (VInt 0) a1 else a1) in
           if zero9 then m
           else if negr && (if negm then false else true) then arith_bin "-" m absb
           else if (if negr then false else true) && negm then arith_bin "+" m absb
           else m))
     | _ -> VNil)
  // a NON-numeric argument to one of these is ruby's TypeError, naming the
  // class it could not coerce INTO -- the arithmetic below took it as an
  // internal failure ("mere-ruby: not a number").
  // ...and `divmod` and `pow` were the two names NOT on this list, so they
  // answered instead of refusing: `1.divmod(nil)` was nil and `1.pow(nil)` was
  // 1 -- the receiver handed back as the answer to an argument it could not
  // read at all.
  else if (str_eq name "modulo" || str_eq name "div" || str_eq name "fdiv" || str_eq name "remainder" || str_eq name "quo"
           || str_eq name "divmod" || str_eq name "pow")
     && is_num recv
     // ...a Complex IS a number here (`1.0.fdiv(Complex(1,2))` divides), and
     // an object is refused only after the conversion below has failed.
     // ...and an OBJECT is left to the paths below, which ask it to convert:
     // only a value that is no number and no object is refused here.
     && (match args with
         | Cons (a1, Nil) -> (match a1 with
                              | VObj _ -> false
                              | _ -> (if is_num a1 || is_cpx a1 then false else true))
         | _ -> false) then
    (match args with
     // ...and quo's target is Rational, not the receiver's class: it is the
     // one name here that does not divide in the receiver's own kind.
     | Cons (a1, _) -> prim_raise "TypeError"
                         (conv_name a1 ++ " can't be coerced into "
                          ++ (if str_eq name "quo" then "Rational" else cmp_type_name recv))
     | Nil -> VNil)
  else if (str_eq name "modulo" || str_eq name "div" || str_eq name "fdiv" || str_eq name "remainder")
     && is_num recv && (match args with Cons (a1, Nil) -> is_num a1 | _ -> false) then
    (match args with
     | Cons (a1, _) ->
       (if str_eq name "modulo" then arith_bin "%" recv a1
        // an INTEGER pair divides in decimal (big_fdiv_s): to_f on each side
        // first loses everything past a double, and loses it as NaN when both
        // overflow rather than as a rounded answer.
        else if str_eq name "fdiv" then
          (if (match recv with VBig _ -> true | VInt _ -> true | _ -> false)
              && (match a1 with VBig _ -> true | VInt _ -> true | _ -> false)
           then VFlt (big_fdiv_s (num_dec recv) (num_dec a1))
           else VFlt (to_f recv / to_f a1))
        else if str_eq name "div" then
          // the floor of the quotient, EXACTLY: int_of_float saturates, so
          // `9223372036854775808.div(1.0)` answered Int64 max.
          (let q = to_f recv / to_f a1 in flt_floor_v q)
        // remainder keeps the DIVIDEND's sign, where % keeps the divisor's
        else
          (let r = (match arith_bin "%" recv a1 with VInt n -> float_of_int n | VFlt f -> f | _ -> 0.0) in
           let neg = (to_f recv < 0.0) in
           let adj = (if feq r 0.0 then 0.0
                      else if neg && r > 0.0 then r - (let y = to_f a1 in if y < 0.0 then 0.0 - y else y)
                      else if (if neg then false else true) && r < 0.0 then r + (let y = to_f a1 in if y < 0.0 then 0.0 - y else y)
                      else r) in
           match recv with
           | VInt _ -> (match a1 with VInt _ -> VInt (int_of_float adj) | _ -> VFlt adj)
           | _ -> VFlt adj))
     | _ -> VNil)
  else if is_binary_op_name name && (is_num recv || is_cpx recv)
     && (match args with Cons (a1, Nil) -> is_num a1 || is_cpx a1 | _ -> false)
     // the four ORDERING operators are not Complex methods (it does not
     // include Comparable); arith_bin would compare it as a number.
     && (if (is_cpx recv || (match args with Cons (a1, Nil) -> is_cpx a1 | _ -> false))
            && (str_eq name "<" || str_eq name "<=" || str_eq name ">" || str_eq name ">=")
         then false else true) then
    (match args with
     | Cons (a1, _) ->
       // the comparisons answer a bool (and <=> an int); the rest are
       // arithmetic. The comparison is only COMPUTED for a comparison: it went
       // through to_f up front, which a Complex has no answer for, so
       // `Complex(1,2).send(:+, 1)` refused before reaching arith_bin. And
       // cmp_vals rather than to_f, so a bignum compares exactly.
       (if str_eq name "<=>" || str_eq name "<" || str_eq name ">"
           || str_eq name "<=" || str_eq name ">=" then
          (let d = cmp_vals recv a1 in
           if str_eq name "<=>" then VInt (if d < 0 then 0 - 1 else if d > 0 then 1 else 0)
           else if str_eq name "<" then VBool (d < 0)
           else if str_eq name ">" then VBool (d > 0)
           else if str_eq name "<=" then VBool (d <= 0)
           else VBool (d >= 0))
        else arith_bin name recv a1)
     | _ -> VNil)
  else
  // An ENDLESS integer range is never materialised: `first(n)` / `take(n)`
  // stop after n elements, and anything that would need every element says so
  // -- which is ruby's RangeError, not the empty array an empty list gives.
  if (match recv with VRange (VNil, _, _) -> true | _ -> false) && range_delegate_name name
     && (str_eq name "first" || str_eq name "take") then
    prim_raise "RangeError" "cannot get the first element of beginless range"
  else if (match recv with VRange (lo, hi, _) -> (match lo with VStr _ -> true | _ -> false) && (match hi with VNil -> true | _ -> false) | _ -> false)
          && (str_eq name "first" || str_eq name "take")
          && (match args with Cons (VInt _, _) -> true | _ -> false) then
    // ("a"..) walks succ n times: the end is missing, not unreachable.
    (match recv with
     | VRange (VStr slo, _, _) ->
       (match args with
        | Cons (VInt k, _) -> arr_new (rng_str_take (sget slo) (if k < 0 then 0 else k) Nil)
        | _ -> VNil)
     | _ -> VNil)
  else if (match recv with VRange (lo, hi, _) -> rng_is_int lo && rng_hi_open hi | _ -> false)
     && range_delegate_name name then
    (match recv with
     | VRange (lo, hi, ex0) ->
       (let a = rng_int lo in
        // `1..Float::INFINITY` has a maximum and `1..` does not; neither has
        // a last element, and neither may be materialised.
        if str_eq name "max" || str_eq name "minmax" then
          (match hi with
           | VNil -> prim_raise "RangeError" "cannot get the maximum of endless range"
           // ...but an EXCLUDED end still has to be named, and Infinity is not
           // an Integer: `(0...Float::INFINITY).max` is ruby's "cannot exclude
           // non Integer end value". Reading an infinite end as merely
           // "endless" skipped that rule and answered Infinity, which is not
           // even in the range.
           | _ ->
             (if ex0 then prim_raise "TypeError" "cannot exclude non Integer end value"
              else if str_eq name "max" then hi
              else arr_new (Cons (VInt a, Cons (hi, Nil)))))
        else if str_eq name "last" && (match args with Nil -> true | _ -> false) then
          prim_raise "RangeError" "cannot get the last element of endless range"
        else if (str_eq name "first" || str_eq name "take") && (match args with Cons (VInt _, _) -> true | _ -> false) then
          (match args with
           | Cons (VInt k, _) -> arr_new (range_to_a a (a + (if k < 0 then 0 else k) - 1))
           | _ -> VNil)
        else if str_eq name "first" && (match args with Nil -> true | _ -> false) then VInt a
        else if str_eq name "min" && (match args with Nil -> true | _ -> false) then VInt a
        else prim_raise "RangeError" "cannot convert endless range to an array")
     | _ -> VNil)
  // #minmax is #min and #max, so it is ASKED of them rather than computed a
  // second way. Materialising the range and taking the ends of the list made
  // it disagree with the very methods it is defined as: `(1...10.0).minmax`
  // was [1, 9] where #max refuses ("cannot exclude non Integer end value"),
  // and `(1.5...3).minmax` was [nil, nil] where #max refuses too. An empty
  // range still answers [nil, nil], because that is what #min and #max say.
  else if str_eq name "minmax" && (match recv with VRange _ -> true | _ -> false)
          && (match args with Nil -> true | _ -> false) then
    arr_new (Cons (prim_method recv "min" Nil, Cons (prim_method recv "max" Nil, Nil)))
  // first(n) / take(n) from an integer begin are COUNTED, not materialised:
  // `(1..2**64).first(2)` is [1, 2]. Slicing the front off a materialised
  // range answered [] instead, because the walk gives up on a bignum end.
  else if (match recv with
           | VRange (lo, hi, _) ->
             (match lo with VInt _ -> true | VBig _ -> true | _ -> false)
             && (match hi with VInt _ -> true | VBig _ -> true | _ -> false)
           | _ -> false)
          && (str_eq name "first" || str_eq name "take")
          && (match args with Cons (VInt _, _) -> true | _ -> false) then
    (match recv with
     | VRange (lo, hi, ex) ->
       (match args with
        | Cons (VInt k, _) ->
          arr_new (rng_n_from (rng_int_side lo) (rng_int_top hi ex) 1 (if k < 0 then 0 else k) Nil)
        | _ -> VNil)
     | _ -> VNil)
  // a Range delegates array-only enumeration methods to its materialised form.
  else if (match recv with VRange _ -> true | _ -> false) && range_delegate_name name
     && (if str_eq name "last" || str_eq name "min" || str_eq name "max"
         then (match args with Nil -> false | _ -> true) else true) then
    (match recv with
     | VRange (lo, hi, excl) ->
       // ...unless the begin cannot be WALKED, in which case there is no
       // materialised form. Its ENDPOINTS still answer -- ruby's
       // `(["a"]..["f"]).first` is ["a"] -- and everything else refuses.
       // range_vals_raw gives up silently on such a begin, and an empty list
       // reads as "no elements" rather than "cannot iterate": #first was nil.
       (let w9 = rng_walk_from lo in
        if str_eq w9 "" then prim_method (arr_new (range_vals_raw lo hi excl)) name args
        else if str_eq name "first" && (match args with Nil -> true | _ -> false) then lo
        else prim_raise "TypeError" ("can't iterate from " ++ w9))
     | _ -> VNil)
  // Hash#store is Hash#[]= under another name, and a bare `store` inside a
  // Hash subclass reaches the primitive dispatcher directly (i18n's
  // `class Fallbacks < Hash` computes into itself that way).
  // Symbol#to_proc: the same lambda `&:sym` desugars to, as a real Proc
  // object (rubocop-ast keeps `:positive?.to_proc` in a constant).
  else if str_eq name "to_proc" && (match recv with VSym _ -> true | _ -> false) then
    (match recv with
     | VSym sy ->
       (let pid = map_len proc_store in
        let _ = store_proc (str_of_int pid)
                  (true, Cons (lambda_blk_marker, Cons ("__bp", Cons ("*__ba", Nil))),
                   Cons (SExpr (EMethod (EVar "__bp", sy, Cons (ESplat (EVar "__ba"), Nil))), Nil),
                   map_new ()) in
        // it was not written at a source line; it names its symbol instead.
        let _ = map_set proc_symsrc (str_of_int pid) (mkstr sy) in
        let _ = map_set proc_src ("f" ++ str_of_int pid) (mkstr "") in
        // ...and it is a LAMBDA: `:x.to_proc.lambda?` is true in ruby, which is
        // not decoration -- it says the proc is strict about its arguments and
        // that a `return` inside it returns from IT. The marker in the params
        // makes it behave as one; lambda_ids is what #lambda? reads.
        let _ = map_set lambda_ids (str_of_int pid) VNil in
        VProc pid)
     | _ -> VNil)
  else if str_eq name "store" && (match recv with VHsh _ -> true | _ -> false) then
    prim_method recv "[]=" args
  else if (match recv with VSym _ -> true | _ -> false) && sym_str_method name then
    (match recv with
     | VSym sy ->
       // ...with SYMBOL arguments turned into strings: `:abc.casecmp(:ABC)`
       // compares two symbols in ruby. A STRING argument stays refused for the
       // comparison names -- `:abc.casecmp("ABC")` is nil, because a Symbol
       // only compares with a Symbol -- so only the symbol form converts.
       (let args = (match args with
                    | Cons (VSym a9, r9) -> Cons (mkstr_e a9 (sym_enc_name a9), r9)
                    | Cons (VStr _, _) ->
                      (if str_eq name "casecmp" || str_eq name "casecmp?" then Cons (VNil, Nil) else args)
                    | other9 -> other9) in
        let r = prim_method (mkstr_e sy (sym_enc_name sy)) name args in
        if sym_str_resym name then (match r with VStr h -> VSym (sget h) | _ -> r) else r)
     | _ -> VNil)
  // universal
  else if str_eq name "to_s" then
    (match recv with
     // a Proc's description is BINARY: it carries an address, which is bytes
     // and not characters, so ruby stamps ASCII-8BIT on it.
     | VProc pid9 -> (let r = mkstr (proc_to_s pid9) in
                      (match r with VStr rid -> (let _ = senc_set rid "ASCII-8BIT" in r) | _ -> r))
     // a number's decimal (or base-N) text is US-ASCII in ruby, not the default
     | VInt n -> (let r = (match args with Cons (VInt base, _) -> mkstr (int_to_base n (check_radix base)) | _ -> mkstr (to_s recv)) in
                  (match r with VStr rid -> (let _ = senc_set rid "US-ASCII" in r) | _ -> r))
     | VBig bs -> (let r = (match args with Cons (VInt base, _) -> mkstr (big_to_base_s bs (check_radix base)) | _ -> mkstr bs) in
                   (match r with VStr rid -> (let _ = senc_set rid "US-ASCII" in r) | _ -> r))
     // ...and a Float's is too. Only Integer and Bignum had an arm here, so
     // `1.5.to_s.encoding` answered the default external where ruby says
     // US-ASCII -- two of core/float/to_s's rows ask for the object itself.
     | VFlt f9 -> (let r = mkstr (rb_float_str f9) in
                   (match r with VStr rid -> (let _ = senc_set rid "US-ASCII" in r) | _ -> r))
     // String#to_s answers the receiver ITSELF, not a copy -- `s.to_s.equal?(s)`
     // is true, and code that calls to_s defensively then mutates relies on it.
     // A subclass instance is the exception: it converts down to a new String.
     | VStr h -> (let hk = hng_key recv in
                  if (if str_eq hk "" then false else true) && map_has hng_store hk
                  then mkstr (sget h) else recv)
     // true / false / nil each have ONE to_s string, frozen: ruby answers the
     // same object every time (`false.to_s.equal?(false.to_s)`), which a fresh
     // mkstr per call cannot. The intern table `-str` uses answers it.
     | VBool _ -> str_fstring (mkstr (to_s recv))
     | VNil -> str_fstring (mkstr "")
     // a Symbol's text carries the symbol's encoding (see sym_enc_name).
     | VSym sy ->
       (let c = mkstr sy in
        (match c with
         | VStr cid -> (let _ = senc_set cid (sym_enc_name sy) in c)
         | _ -> c))
     | _ -> mkstr (to_s recv))
  // true / false / nil inspect to their ONE frozen string too (for the two
  // booleans `inspect` and `to_s` are the same method, so they must also be
  // the same object).
  else if str_eq name "inspect" then
    (match recv with
     | VBool _ -> str_fstring (mkstr (inspect recv))
     | VNil -> str_fstring (mkstr "nil")
     | _ -> mkstr (inspect recv))
  else if str_eq name "class" then
    // a primitive tagged as a user subclass instance (`class P < String`)
    // reports the subclass, not the builtin base — so `self.class` (and thus
    // `self.class.new(...)`) inside a String/Array-subclass method rebuilds the
    // subclass and method chains survive. Mirrors dispatch_cls_of's tag check.
    (let hk = hng_key recv in
     if (if str_eq hk "" then false else true) && map_has hng_store hk && (if is_sng_cls (map_get hng_store hk) then false else true)
     then VClass (map_get hng_store hk)
     else VClass (class_name recv))
  else if str_eq name "nil?" then VBool (match recv with VNil -> true | _ -> false)
  else if str_eq name "frozen?" then
    // numbers/symbols/nil/booleans are always frozen; a string is frozen if
    // it was created under --enable-frozen-string-literal or explicitly frozen.
    // an object's singleton class is frozen exactly when the object is.
    VBool (val_is_frozen recv)
  else if str_eq name "freeze" then (match recv with VStr id -> let _ = sfrozen_set id in recv | VArr id -> let _ = cfrozen_set 0 id in recv | VHsh id -> let _ = cfrozen_set 1 id in recv | VProc id -> let _ = cfrozen_set 2 id in recv | VObj id -> let _ = ofrozen_set id in recv | VClass c -> let _ = clsfrozen_set c in recv | _ -> recv)
  // String#-@ interns: a frozen string is returned as is, otherwise a frozen
  // copy. (CRuby also deduplicates; that is unobservable apart from identity,
  // and mere-ruby strings are handles, so a fresh frozen copy behaves the
  // same for every operation except equal?.) String#+@ is the inverse: a
  // mutable string, dup'd only when the receiver is frozen.
  else if str_eq name "-@" || str_eq name "dedup" then
    // the frozen copy KEEPS the encoding (scrub on a -str walked the copy as
    // UTF-8 whatever the original was tagged).
    (match recv with
     | VStr id -> if sfrozen_get id then recv else (let s2 = mkstr (sget id) in (match s2 with VStr h2 -> let _ = sfrozen_set h2 in let _ = senc_set h2 (senc_get id) in s2 | _ -> s2))
     // ⚠ A NUMBER negates. This arm is what `2.send(:-@)` reaches -- the
     // operator form is handled by the evaluator and never comes here -- and
     // the catch-all below answered the RECEIVER, so `2.send(:-@)` was 2. Two
     // spellings of one method, and only one of them negated.
     // ...through num_neg, which promotes the machine minimum: writing the
     // negation out again here left `(-2**63).send(:-@)` answering itself.
     | VInt n -> num_neg (VInt n)
     | VBig b -> norm_big (big_neg_s b)
     | VFlt f -> VFlt (0.0 - f)
     | VRat (n, d) -> VRat (big_neg_s n, d)
     | VCpx (re, im) -> VCpx (num_neg re, num_neg im)
     | _ -> recv)
  else if str_eq name "+@" then
    (match recv with
     | VStr id -> if sfrozen_get id || schilled_get id then (let s2 = mkstr (sget id) in (match s2 with VStr h2 -> (let _ = senc_set h2 (senc_get id) in s2) | _ -> s2)) else recv
     | _ -> recv)
  else if str_eq name "dup" || str_eq name "clone" then
    // `clone(freeze: false)` asks for an UNFROZEN copy, and the always-frozen
    // values -- every Numeric, Symbol, nil and the booleans -- have none to
    // give. Ruby refuses by name ("can't unfreeze Integer"); this used to hand
    // back the receiver, which is a frozen object answering a request for an
    // unfrozen one. A frozen STRING is not in this list: it can be cloned
    // unfrozen, and is.
    (let _ = (if str_eq name "clone"
                 && (match args with
                     | Cons (VHsh h9, _) ->
                       (match hash_lookup (hderef h9) (VSym "freeze") with
                        | (true, VBool false) -> true
                        | _ -> false)
                     | _ -> false)
                 && (match recv with
                     | VInt _ -> true | VBig _ -> true | VFlt _ -> true
                     | VRat (_, _) -> true | VCpx (_, _) -> true
                     | VSym _ -> true | VNil -> true | VBool _ -> true
                     | _ -> false)
              then (let _ = prim_raise "ArgumentError" ("can't unfreeze " ++ cmp_type_name recv) in ())
              else ()) in
    // strings are handles now: dup MUST copy, else mutating the dup would
    // write through to the original. The copy carries the ENCODING (clear on
    // a dup of a Shift_JIS string used to answer UTF-8).
    (let cp = (match recv with
               | VProc pid9 -> VProc (proc_copy pid9)
               | VArr id -> arr_new (deref id)
               | VStr h -> (let c2 = mkstr (sget h) in (match c2 with VStr nid -> (let _ = senc_set nid (senc_get h) in c2) | _ -> c2))
               // a copy of a compare_by_identity hash compares that way too.
               | VHsh h -> (let c3 = mkhash (hderef h) in let _ = hcbi_copy h c3 in c3)
               | _ -> recv) in
     // #clone carries the frozen state over, #dup drops it. `clone(freeze: false)` opts out.
     let was_frozen = (match recv with VStr id -> sfrozen_get id | VArr id -> cfrozen_get 0 id | VHsh id -> cfrozen_get 1 id | VProc id -> cfrozen_get 2 id | _ -> false) in
     let keep = str_eq name "clone" && was_frozen &&
       (match args with
        | Cons (VHsh h, Nil) -> (match hash_get (hderef h) (VSym "freeze") with VBool b -> b | _ -> true)
        | _ -> true) in
     let _ = if keep then (match cp with VStr id -> let _ = sfrozen_set id in () | VArr id -> let _ = cfrozen_set 0 id in () | VHsh id -> let _ = cfrozen_set 1 id in () | VProc id -> let _ = cfrozen_set 2 id in () | _ -> ()) else () in
     cp))
  // string interpolation: a String is used as it is (Ruby does not call to_s on
  // one, not even on a subclass instance), everything else converts.
  else if str_eq name "__interp_str" then
    (match recv with
     | VStr h -> (let c = mkstr (sget h) in (match c with VStr cid -> (let _ = senc_set cid (senc_get h) in c) | _ -> c))
     | _ -> mkstr (to_s recv))
  else if str_eq name "itself" then recv
  // Object#<=>: 0 for a pair that is ==, nil otherwise. The LAST arm any <=>
  // reaches (Integer, String, Array, Time all have earlier ones), so it answers
  // only for values with no ordering of their own -- where ruby still says
  // "equal to itself, incomparable to anything else".
  else if str_eq name "<=>" then
    (match args with
     | Cons (b, _) -> (if rb_eq recv b then VInt 0 else VNil)
     | _ -> VNil)
  else if str_eq name "hash" then VInt (val_hash recv)
  // `x.tap` with NO block is a LocalJumpError (the block is not optional); it
  // answered the receiver.
  else if str_eq name "tap" then
    prim_raise "LocalJumpError" "no block given (yield)"
  else if str_eq name "__regex" then
    (match recv with VStr sp0 -> (let sp = sget sp0 in rx_build_once sp (match args with Cons (VStr f, _) -> sget f | _ -> "") (rx_one_enc recv) args) | _ -> (let _ = map_set prim_missing "n" (mkstr "__regex") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method '__regex'")) in fail "mere-ruby: undefined method '__regex'")))
  // Regexp#casefold?: the `i` flag, which #options already carries as bit 0.
  else if str_eq name "casefold?" && (match recv with VRegex _ -> true | _ -> false) then
    (match recv with VRegex (_, fl, _) -> VBool (str_contains fl "i") | _ -> VBool false)
  // Regexp#fixed_encoding?: true for a pattern PINNED to one encoding, which
  // is what a non-ASCII source does. `/n` is the opposite -- it says "bytes,
  // no encoding" -- so it answers false.
  else if str_eq name "fixed_encoding?" && (match recv with VRegex _ -> true | _ -> false) then
    (match recv with
     // ⚠ ...or the FIXEDENCODING flag, which fixes US-ASCII just as firmly as
     // any other encoding: `Regexp.new("a".encode("US-ASCII"),
     // Regexp::FIXEDENCODING).fixed_encoding?` is true, and reading the answer
     // off the encoding alone said false for exactly that case.
     | VRegex (p9, fl, ev9) ->
       VBool (str_contains fl "u" || (if str_eq (rx_enc_name p9 fl ev9) "US-ASCII" then false else true))
     | _ -> VBool false)
  // Regexp#options: the same bits Regexp::IGNORECASE and friends name.
  else if str_eq name "options" && (match recv with VRegex _ -> true | _ -> false) then
    (match recv with
     | VRegex (_, fl, _) ->
       VInt ((if str_contains fl "i" then 1 else 0)
             + (if str_contains fl "x" then 2 else 0)
             + (if str_contains fl "m" then 4 else 0)
             + (if str_contains fl "n" then 32 else 0)
             // FIXEDENCODING (16) is the `u` flag here -- `/a/u.options` read 0
             // while #fixed_encoding? answered true for the same regexp, which
             // is the same fact through two doors with two answers.
             + (if str_contains fl "u" then 16 else 0))
     | _ -> VInt 0)
  // Regexp#names / #named_captures: the pattern's own group names, read from
  // the same table a MatchData reads. MatchData#names is specified against
  // these, and there was no arm at all.
  else if (str_eq name "names" || str_eq name "named_captures")
          && (match recv with VRegex (_, _, _) -> true | _ -> false) then
    (match recv with
     | VRegex (pt, pf, _) ->
       // the names table is filled when the pattern is COMPILED, and a Regexp
       // that has never matched anything has not been: compile it first (the
       // result is cached, so this is the same work the first match would do).
       (let key = pf ++ chr 1 ++ pt in
        let _ = try_or (fn (u: unit) -> let _ = rxc_get pt pf in true) false in
        let tbl = (if map_has rx_prog_names key then (match map_get rx_prog_names key with VStr h -> sget h | _ -> "") else "") in
        let nms = (if str_eq tbl "" then Nil else md_names_sorted (str_split tbl "|") 1 Nil) in
        if str_eq name "names" then arr_new (strs_to_vals nms)
        else mkhash (rx_named_pairs tbl nms))
     | _ -> VNil)
  else if str_eq name "source" then
    // ...and the source string is in the PATTERN's encoding, which is the one
    // rule rx_enc_name states: `/x/.source.encoding` is US-ASCII and
    // `/\u{3042}/.source.encoding` is UTF-8 even though those source BYTES are
    // identical in kind. Testing the bytes here answered US-ASCII for the
    // second, so #source and #encoding disagreed about the same regexp.
    (match recv with
     | VRegex (p, fl, ev9) ->
       (let v9 = mkstr p in
        (match v9 with
         | VStr id9 -> (let _ = senc_set id9 (rx_enc_name p fl ev9) in v9)
         | _ -> v9))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "source") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'source'")) in fail "mere-ruby: undefined method 'source'")))
  // casecmp is the three-way form of casecmp? (nil when the other side is
  // not a string, which is how callers tell "incomparable" from "unequal").
  else if str_eq name "dump" && (match recv with VStr _ -> true | _ -> false) then
    // the result keeps SELF's encoding; a non-ASCII-compatible receiver dumps
    // per byte and appends the .force_encoding("NAME") tail undump reads back.
    (match recv with
     | VStr h ->
       (let e = enc_canon_name (senc_get h) in
        if enc_ascii_compat e then
          (let c = mkstr (str_dump_go (inspect (VStr h)) 0 "") in
           (match c with VStr cid -> (let _ = senc_set cid e in c) | _ -> c))
        else
          (let s = sget h in
           let n = str_len s in
           let rec go = fn (i: int) -> fn (acc: str) ->
             if i >= n then acc
             else
               let o = ord (char_at s i) in
               let pc = (if o == 34 then "\\\""
                         else if o == 92 then "\\\\"
                         else if o == 35 then "\\#"
                         else if o == 10 then "\\n" else if o == 9 then "\\t"
                         else if o == 13 then "\\r" else if o == 7 then "\\a"
                         else if o == 8 then "\\b" else if o == 27 then "\\e"
                         else if o == 12 then "\\f" else if o == 11 then "\\v"
                         else if o >= 32 && o < 127 then char_at s i
                         else "\\x" ++ hex2_up o) in
               go (i + 1) (acc ++ pc) in
           let c = mkstr ("\"" ++ go 0 "" ++ "\".force_encoding(\"" ++ e ++ "\")") in
           (match c with VStr cid -> (let _ = senc_set cid "ASCII-8BIT" in c) | _ -> c)))
     | _ -> VNil)
  else if str_eq name "casecmp" then
    (match recv with
     | VStr ah ->
       (match args with
        | Cons (VStr b2, _) ->
          (if str_eq (enc_pair_or ah b2) "" then VNil
           else
             let a = str_downcase_ascii (sget ah) in
             let b3 = str_downcase_ascii (sget b2) in
             VInt (let c = str_compare a b3 in if c < 0 then 0 - 1 else if c > 0 then 1 else 0))
        | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "casecmp") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'casecmp'")) in fail "mere-ruby: undefined method 'casecmp'")))
  // byte-level access. mere-ruby strings are byte-safe (a length header, not
  // NUL termination), so these are plain indexing rather than a re-encode.
  else if str_eq name "getbyte" then
    (match recv with
     | VStr h -> let a = sget h in
       (match args with
        | Cons (VInt i0, Nil) -> let i = if i0 < 0 then i0 + str_len a else i0 in
          if i < 0 || i >= str_len a then VNil else VInt (ord (char_at a i))
        | Cons (other, Nil) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | _ -> prim_raise "ArgumentError"
                 ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 1)"))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "getbyte") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'getbyte'")) in fail "mere-ruby: undefined method 'getbyte'")))
  else if str_eq name "crypt" then
    (match recv with
     | VStr h ->
       (match args with
        | Cons (VStr sh2, _) ->
          (let pw = sget h in
           let salt = sget sh2 in
           if str_contains pw (chr 0) then prim_raise "ArgumentError" "string contains null byte"
           else if str_len salt < 2 then prim_raise "ArgumentError" "salt too short (need >=2 bytes)"
           else if ord (char_at salt 0) == 0 || ord (char_at salt 1) == 0
           then prim_raise "ArgumentError" "salt too short (need >=2 bytes)"
           else mkstr (rb_crypt_des pw salt))
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "crypt") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'crypt'")) in fail "mere-ruby: undefined method 'crypt'")))
  else if str_eq name "setbyte" then
    (match recv with
     | VStr h -> let a = sget h in
       (match args with
        | Cons (VInt i0, Cons (VInt b, _)) ->
