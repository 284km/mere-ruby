  // Time instance methods. The object carries a single ordinal, so the zone
  // conversions are identity and #to_i hands the ordinal back.
  // ...and it stays a Time after `def t.succ`: that gives the object a
  // SINGLETON class, "(sng:111)", and comparing the bookkeeping name to "Time"
  // then failed, so `t + 1` fell through to Object and reported "Integer can't
  // be coerced into Object". display_cls resolves the singleton to the class
  // it stands for; ruby/spec's Range#each Time example is exactly this shape.
  else if (match recv with
           | VObj oid -> (let (_, _, ocls9, _) = world in str_eq (display_cls world (map_get ocls9 oid)) "Time")
           | _ -> false)
          && (str_eq name "utc" || str_eq name "getutc" || str_eq name "localtime"
              || str_eq name "getlocal" || str_eq name "round" || str_eq name "to_i"
              || str_eq name "to_f" || str_eq name "to_time" || str_eq name "utc?"
              || str_eq name "year" || str_eq name "month" || str_eq name "mon"
              || str_eq name "day" || str_eq name "mday" || str_eq name "hour"
              || str_eq name "min" || str_eq name "sec"
              || str_eq name "wday" || str_eq name "yday" || str_eq name "usec"
              || str_eq name "+" || str_eq name "-"
