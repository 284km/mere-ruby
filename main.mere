             (if i < 0 then VNil else VInt (utf8_cidx s i)))
        | Cons (VStr sub, _) ->
          let _ = enc_pair_guard sh0 sub in
          let i = str_find_from s (sget sub) 0 in
          (if i < 0 then VNil else VInt (utf8_cidx s i))
        | Cons (VRegex (pat, pf, _), rest) ->
          let bst = (match rest with
                     | Cons (VInt off, _) ->
                       let cn = utf8_len s in
                       let cst = (if off < 0 then cn + off else off) in
                       utf8_boff s (if cst < 0 then 0 else cst) 0
                     | _ -> 0) in
          (match rxv_search pat pf s bst with
           | RHit (st, _, _) -> VInt (utf8_cidx s st)
           | _ -> VNil)
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1..2)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "index") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'index'")) in fail "mere-ruby: undefined method 'index'")))
  else if str_eq name "count" then
    (match recv with
     | VArr id -> let xs = deref id in (match args with Cons (v, _) -> VInt (val_count_eq xs v) | Nil -> VInt (val_list_len xs))
     | VStr s ->
       (match args with
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1+)"
        | _ -> VInt (str_count_sets (sget s) (str_set_args args)))
     | VHsh xs -> VInt (vlen (hash_keys (hderef xs)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "count") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'count'")) in fail "mere-ruby: undefined method 'count'")))
  else if str_eq name "join" then
    // Value-level fallback: no `world` here, so objects stringify to the
    // default. invoke_val_c intercepts join with a world-aware element
    // stringifier before reaching this path (so user #to_s is honored).
    (match recv with VArr id -> let xs = deref id in (match args with Cons (VStr sep, _) -> let sep = sget sep in mkstr (val_join to_s xs sep "" true) | _ -> mkstr (val_join to_s xs "" "" true)) | _ -> (let _ = map_set prim_missing "n" (mkstr "join") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'join'")) in fail "mere-ruby: undefined method 'join'")))
  // NilClass#to_h is {} (and #to_a is []), which is how a library writes
  // `maybe_nil.to_h.map { ... }` without a guard.
  // Hash#compare_by_identity marks the hash; its lookups then compare keys
  // with `equal?`. Ruby rehashes on the spot, and an already-populated hash
  // can end up with duplicate-looking keys -- so do the same.
  else if str_eq name "compare_by_identity" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     // marking a hash changes how it looks keys up, which a frozen hash refuses.
     | VHsh hid -> (if cfrozen_get 1 hid then
                      prim_raise "FrozenError" ("can't modify frozen Hash: " ++ inspect recv)
                    else (let _ = map_set hcbi (str_of_int hid) 1 in recv))
     | _ -> recv)
  else if str_eq name "compare_by_identity?" then
    (match recv with VHsh hid -> VBool (hcbi_on hid) | _ -> VBool false)
  // `h.to_h` with no block answers SELF for a plain Hash (not a copy), which
  // is why it carries the default, the default_proc and the identity flag.
  // ...through hash_merge, which is what makes a REPEATED key one entry: this
  // leaf built the pair list straight into a hash, so an Enumerable's #to_h
  // (which arrives here, unlike an Array's) answered `{a: 1, b: 2, a: 3}` --
  // a hash printing one key twice, whose [] then found the first.
  else if str_eq name "to_h" then (match recv with VArr id -> mkhash (hash_merge Nil (val_to_h (deref id))) | VHsh _ -> recv | VNil -> mkhash Nil | _ -> (let _ = map_set prim_missing "n" (mkstr "to_h") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'to_h'")) in fail "mere-ruby: undefined method 'to_h'")))
  // Array#pack — a small but common subset: "U"/"U*" encode integer codepoints
  // as UTF-8, "C"/"c" pack the low byte of each integer. A bare directive packs
  // one element, "*" packs all. (Other directives are not implemented.)
  else if str_eq name "pack" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       (match args with
        | Cons (VStr fmt, _) ->
          let fmt = sget fmt in
          // A format has MANY directives, each with its own count: "NN" packs
          // two 32-bit words, not one. Walk them, consuming values as we go.
          let packed = pack_go fmt (str_len fmt) 0 xs "" in
          // `pack(fmt, buffer: s)` APPENDS to s and answers s itself, so the
          // caller can pack into one string repeatedly without reallocating.
          // a packed result is BINARY, except "U" (UTF-8 characters).
          let penc = (if str_contains fmt "U" then "UTF-8" else "ASCII-8BIT") in
          let tag = fn (v: Val) -> (match v with VStr rid -> (let _ = senc_set rid penc in v) | _ -> v) in
          (match args with
           | Cons (_, Cons (VHsh hid, _)) ->
             (match hash_lookup (hderef hid) (VSym "buffer") with
              | (true, VStr bh) -> let _ = sset bh (sget bh ++ packed) in VStr bh
              | _ -> tag (mkstr packed))
           | _ -> tag (mkstr packed))
        | _ -> mkstr "")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "pack") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'pack'")) in fail "mere-ruby: undefined method 'pack'")))
  // Hash
  // Array mutation (in place; VArr is a handle into the shared store).
  else if str_eq name "push" || str_eq name "append" then
    (match recv with VArr id -> let _ = arr_push_many id args in recv | _ -> (let _ = map_set prim_missing "n" (mkstr "push") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'push'")) in fail "mere-ruby: undefined method 'push'")))
  else if str_eq name "sort!" then
    (match recv with VArr id -> let _ = arr_set id (val_sort (deref id)) in recv | _ -> (let _ = map_set prim_missing "n" (mkstr "sort!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'sort!'")) in fail "mere-ruby: undefined method 'sort!'")))
  else if str_eq name "reverse!" then
    (match recv with VArr id -> let _ = arr_set id (val_rev (deref id) Nil) in recv | _ -> (let _ = map_set prim_missing "n" (mkstr "reverse!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'reverse!'")) in fail "mere-ruby: undefined method 'reverse!'")))
  else if str_eq name "uniq!" then
    (match recv with VArr id -> let before = val_list_len (deref id) in let _ = arr_set id (val_uniq (deref id) Nil) in (if val_list_len (deref id) == before then VNil else recv) | _ -> (let _ = map_set prim_missing "n" (mkstr "uniq!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'uniq!'")) in fail "mere-ruby: undefined method 'uniq!'")))
  else if str_eq name "insert" then
    (match recv with
     | VArr id ->
       (match args with
        // insert(pos, *values): a position PAST the end pads with nils, a
        // negative one counts back from after the last element, and one that
        // reaches before the front is an IndexError (it was clamping, which
        // silently inserted at 0). No argument at all is an ArgumentError.
        | Cons (VInt i, rest) ->
          (let xs = deref id in
           let n = val_list_len xs in
           let k = (if i < 0 then n + i + 1 else i) in
           // with nothing to insert the position is never looked at
           // (`[].insert(-2)` is [], while `[].insert(-2, 1)` is an IndexError)
           if (match rest with Nil -> true | _ -> false) then recv
           else if k < 0 then
             prim_raise "IndexError"
               ("index " ++ str_of_int i ++ " too small for array; minimum: -" ++ str_of_int (n + 1))
           else
             (let pad = (if k > n then val_repeat (k - n) VNil else (Nil : Val list)) in
              let head9 = (if k > n then list_append xs pad else vtake xs k) in
              let tail9 = (if k > n then (Nil : Val list) else vdrop xs k) in
              let _ = arr_set id (list_append head9 (list_append rest tail9)) in recv))
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1+)"
        | _ -> recv)
     // the position is in characters: inserting at 1 used to land inside the
     // first character and produce "\xE6X\x97\xA5..."
     | VStr h ->
       (match args with
        | Cons (VInt i, Cons (VStr ins, _)) ->
          let _ = enc_pair_guard h ins in
          let renc = enc_pair_or h ins in
          let s = sget h in let ins = sget ins in
          let cn = utf8_len s in
          let ck = (if i < 0 then cn + i + 1 else i) in
          (if ck < 0 || ck > cn then prim_raise "IndexError" ("index " ++ str_of_int i ++ " out of string")
           else let k = utf8_boff s ck 0 in
                let _ = sset h (substring s 0 k ++ ins ++ substring s k (str_len s)) in
                let _ = senc_set h renc in recv)
        | Cons (VInt _, Cons (other, _)) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into String")
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 2)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "insert") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'insert'")) in fail "mere-ruby: undefined method 'insert'")))
  else if str_eq name "fill" then
    (match recv with VArr id -> (match args with Cons (v, _) -> let _ = arr_set id (val_repeat (val_list_len (deref id)) v) in recv | _ -> recv) | _ -> (let _ = map_set prim_missing "n" (mkstr "fill") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'fill'")) in fail "mere-ruby: undefined method 'fill'")))
  else if str_eq name "delete" then
    (match recv with
     | VArr id ->
       (match args with
        | Cons (v, _) ->
          let xs = deref id in
          let had = val_member xs v in
          let _ = arr_set id (val_remove xs v) in
          if had then v else VNil
        | Nil -> VNil)
     | VHsh h ->
       (match args with
        | Cons (k, _) ->
          let xs = hderef h in
          let ci = (match recv with VHsh hid0 -> hcbi_on hid0 | _ -> false) in
          let had = hash_haskey_x ci xs k in
          let v = (if had then hash_get_x ci xs k else VNil) in
          let _ = hset h (hash_del xs k) in v
        | Nil -> VNil)
     | VStr s ->
       (match args with
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1+)"
        | _ -> mkstr (str_delete_sets (sget s) (str_set_args args)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "delete") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'delete'")) in fail "mere-ruby: undefined method 'delete'")))
  else if str_eq name "flatten!" then
    // nil when nothing was nested to flatten (the same rule as compact!)
    (match recv with VArr id -> let d0 = (match args with Cons (VInt d, _) -> d | _ -> 0 - 1) in let nested = has_arr_elem (deref id) in let flat = val_flatten (deref id) d0 in let _ = arr_set id flat in (if d0 == 0 then VNil else if nested then recv else VNil) | _ -> (let _ = map_set prim_missing "n" (mkstr "flatten!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'flatten!'")) in fail "mere-ruby: undefined method 'flatten!'")))
  else if str_eq name "compact!" then
    (match recv with VArr id -> let xs = deref id in let c = val_compact xs in let _ = arr_set id c in (if val_list_len c == val_list_len xs then VNil else recv) | _ -> (let _ = map_set prim_missing "n" (mkstr "compact!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'compact!'")) in fail "mere-ruby: undefined method 'compact!'")))
  else if str_eq name "pop" then
    (match recv with
     | VArr id -> let xs = deref id in let len = val_list_len xs in
       // one optional count, and a NEGATIVE count is not "pop nothing" -- both
       // spellings were being accepted silently.
       (match args with
        | Cons (_, Cons (_, _)) ->
          prim_raise "ArgumentError"
            ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..1)")
        | Cons (VInt n, _) ->
          (if n < 0 then prim_raise "ArgumentError" "negative array size"
           else let k = if n > len then len else n in
             let _ = arr_set id (vtake xs (len - k)) in arr_new (vdrop xs (len - k)))
        | _ -> (match xs with Nil -> VNil | _ -> let _ = arr_set id (val_init xs) in val_last xs))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "pop") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'pop'")) in fail "mere-ruby: undefined method 'pop'")))
  // Array#at(i): index without the slice forms (negative counts from the end).
  else if str_eq name "at" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       let len = val_list_len xs in
       (match args with
        | Cons (VInt i0, Nil) -> let i = if i0 < 0 then i0 + len else i0 in
          (if i < 0 || i >= len then VNil else val_nth xs i)
        | Cons (VNil, Nil) -> prim_raise "TypeError" "no implicit conversion from nil to integer"
        | Cons (other, Nil) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | _ -> prim_raise "ArgumentError" ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 1)"))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "at") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'at'")) in fail "mere-ruby: undefined method 'at'")))
  // Array#delete_at(i): remove and return that element (nil if out of range).
  else if str_eq name "delete_at" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       let len = val_list_len xs in
       (match args with
        | Cons (VInt i0, _) -> let i = if i0 < 0 then i0 + len else i0 in
          if i < 0 || i >= len then VNil
          else let v = val_nth xs i in
               let _ = arr_set id (list_append (vtake xs i) (vdrop xs (i + 1))) in v
        | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "delete_at") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'delete_at'")) in fail "mere-ruby: undefined method 'delete_at'")))
  // Array#slice!(i) / slice!(start, len) / slice!(range): cut the elements out
  // and return them (nil / the element, matching Array#slice's return shape).
  else if str_eq name "slice!" then
    (match recv with
     | VArr id ->
       let xs = deref id in
       let len = val_list_len xs in
       let norm = fn (i: int) -> if i < 0 then i + len else i in
       (match args with
        | Cons (VInt i0, Cons (VInt n0, _)) ->
          let i = norm i0 in
          if i < 0 || i > len || n0 < 0 then VNil
          else
            let n = if i + n0 > len then len - i else n0 in
            let _ = arr_set id (list_append (vtake xs i) (vdrop xs (i + n))) in
            arr_new (vtake (vdrop xs i) n)
        | Cons (VRange (lov, hiv, excl), _) ->
          (let (lo, enx) = rng_slice_bounds lov hiv excl len in
           if lo < 0 || lo > len then VNil
           else
             let en = if enx > len then len else enx in
             let n = if en - lo < 0 then 0 else en - lo in
             let _ = arr_set id (list_append (vtake xs lo) (vdrop xs (lo + n))) in
             arr_new (vtake (vdrop xs lo) n))
        | Cons (VInt i0, _) ->
          let i = norm i0 in
          if i < 0 || i >= len then VNil
          else
            let v = val_nth xs i in
            let _ = arr_set id (list_append (vtake xs i) (vdrop xs (i + 1))) in
            v
        | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "slice!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'slice!'")) in fail "mere-ruby: undefined method 'slice!'")))
  else if str_eq name "shift" then
    (match recv with
     // Hash#shift removes the FIRST pair and returns it as [key, value].
     | VHsh h -> (match hderef h with
                  | Cons (k, Cons (v, t)) -> let _ = hset h t in arr_new (Cons (k, Cons (v, Nil)))
                  | _ -> VNil)
     | VArr id -> let xs = deref id in let len = val_list_len xs in
       // see pop: one optional count, no negative counts.
       (match args with
        | Cons (_, Cons (_, _)) ->
          prim_raise "ArgumentError"
            ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0..1)")
        | Cons (VInt n, _) ->
          (if n < 0 then prim_raise "ArgumentError" "negative array size"
           else let k = if n > len then len else n in
             let _ = arr_set id (vdrop xs k) in arr_new (vtake xs k))
        | _ -> (match xs with Nil -> VNil | Cons (h, t) -> let _ = arr_set id t in h))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "shift") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'shift'")) in fail "mere-ruby: undefined method 'shift'")))
  // Array#replace: swap in the other array's contents (aliases see it).
  else if str_eq name "replace" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr id ->
       (match args with
        | Cons (VArr oid, _) -> let _ = arr_set id (deref oid) in recv
        | Cons (other, _) -> conv_err other "Array"
        | Nil -> recv)
     | _ -> recv)
  else if str_eq name "unshift" || str_eq name "prepend" then
    // every argument goes in front, in order: [1].unshift(9, 8) is [9, 8, 1]
    (match recv with VArr id -> (match args with Nil -> recv | _ -> let _ = arr_set id (list_append args (deref id)) in recv) | _ -> (let _ = map_set prim_missing "n" (mkstr "unshift") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'unshift'")) in fail "mere-ruby: undefined method 'unshift'")))
  else if str_eq name "concat" then
    (match recv with
     // every argument is appended, and each one is READ BEFORE the receiver
     // grows: `ary.concat ary, ary` appends the ORIGINAL contents twice
     // (appending the live array meant the second read saw the first append).
     | VArr id ->
       (let rec snap = fn (az: Val list) ->
          (match az with
           | Nil -> (Nil : Val list)
           | Cons (VArr oid, t) -> list_append (deref oid) (snap t)
           | Cons (other, _) -> (match conv_err other "Array" with _ -> (Nil : Val list))) in
        match args with
        | Nil -> recv
        | _ -> (let add = snap args in
                let _ = arr_set id (list_append (deref id) add) in recv))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "concat") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'concat'")) in fail "mere-ruby: undefined method 'concat'")))
  else if str_eq name "clear" then
    (match args with
     | Cons (_, _) -> prim_raise "ArgumentError" ("wrong number of arguments (given " ++ str_of_int (val_list_len args) ++ ", expected 0)")
     | Nil ->
    (match recv with
     | VArr id -> let _ = arr_set id Nil in recv
     | VHsh h -> let _ = hset h Nil in recv
     | VStr h -> let _ = sset h "" in recv
     | _ -> (let _ = map_set prim_missing "n" (mkstr "clear") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'clear'")) in fail "mere-ruby: undefined method 'clear'"))))
  else if str_eq name "[]=" then
    (match recv with
     | VArr id ->
       (match args with
        // `a[start, len] = v`: a start below -size has no position to write to
        // and a negative LENGTH is not a span -- both were silently splicing
        // at the front (`[1,2,3,4][-5, -1] = ""` gave ["", 1, 2, 3, 4]).
        | Cons (VInt i, Cons (VInt len, Cons (v, Nil))) ->
          (let xs = deref id in
           let n = val_list_len xs in
           let j = (if i < 0 then n + i else i) in
           if j < 0 then
             prim_raise "IndexError"
               ("index " ++ str_of_int i ++ " too small for array; minimum: -" ++ str_of_int n)
           else if len < 0 then
             prim_raise "IndexError" ("negative length (" ++ str_of_int len ++ ")")
           else let _ = arr_set id (arr_splice xs j len v) in v)
        | Cons (VRange (lov, hiv, excl), Cons (v, Nil)) ->
          (let xs = deref id in
           let n = val_list_len xs in
           // the same out-of-reach begin is a RANGE error when it arrives as a
           // range (ruby distinguishes the two spellings).
           let st0 = (match lov with VInt a -> a | _ -> 0) in
           let st9 = (if st0 < 0 then n + st0 else st0) in
           if st9 < 0 then
             prim_raise "RangeError" (inspect (VRange (lov, hiv, excl)) ++ " out of range")
           else
             (let (st, enx) = rng_slice_bounds lov hiv excl n in
              let _ = arr_set id (arr_splice xs st (if enx - st < 0 then 0 else enx - st) v) in v))
        | Cons (VInt i, Cons (v, _)) ->
          let xs = deref id in
          let n = val_list_len xs in
          let j = if i < 0 then n + i else i in
          // a negative index below -size has no position to write to: ruby's
          // IndexError names the minimum, where this quietly appended.
          (if j < 0 then prim_raise "IndexError"
                           ("index " ++ str_of_int i ++ " too small for array; minimum: -" ++ str_of_int n)
           else let _ = arr_set id (val_set_at xs j v) in v)
        | _ -> VNil)
     // a Hash write reached through the primitive dispatcher rather than the
     // index-assignment statement (a bare `store` in a Hash subclass).
     | VHsh h ->
       (match args with
        | Cons (k, Cons (v, _)) -> let _ = hset h (hash_put_x (hcbi_on h) (hderef h) k v) in v
        | _ -> VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "[]=") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method '[]='")) in fail "mere-ruby: undefined method '[]='")))
  else if str_eq name "keys" then (match recv with VHsh xs -> let xs = hderef xs in arr_new (hash_keys xs) | _ -> (let _ = map_set prim_missing "n" (mkstr "keys") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'keys'")) in fail "mere-ruby: undefined method 'keys'")))
  else if str_eq name "values" then (match recv with VHsh xs -> let xs = hderef xs in arr_new (hash_values xs) | _ -> (let _ = map_set prim_missing "n" (mkstr "values") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'values'")) in fail "mere-ruby: undefined method 'values'")))
  else if str_eq name "key?" || str_eq name "has_key?" || str_eq name "include?" || str_eq name "member?" then
    // #member? is #include? for an ARRAY too -- this arm answered only for a
    // Hash and reported the HASH name it had been dispatched under, so
    // `[2, 3].member?(2)` said "undefined method 'key?'".
    (match recv with
     | VHsh hid -> let xs = hderef hid in (match args with Cons (k, _) -> VBool (hash_haskey_x (hcbi_on hid) xs k) | _ -> VBool false)
     | VArr aid -> (match args with Cons (k, _) -> VBool (val_contains (deref aid) k) | _ -> VBool false)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "key?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'key?'")) in fail "mere-ruby: undefined method 'key?'")))
  else if str_eq name "has_value?" || str_eq name "value?" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (v, _) -> VBool (hash_has_value xs v) | _ -> VBool false) | _ -> (let _ = map_set prim_missing "n" (mkstr "value?") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'value?'")) in fail "mere-ruby: undefined method 'value?'")))
  else if str_eq name "each_pair" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with VHsh xs -> arr_new (hash_pairs (hderef xs)) | _ -> VNil)
  else if str_eq name "merge" then
    // merge answers a NEW hash that keeps the receiver's default, default_proc
    // and compare_by_identity flag (it is derived from it, not built fresh).
    (match recv with VHsh xs -> (let r9 = mkhash (hash_merge_all (hderef xs) args) in
                                 let _ = hcbi_copy xs r9 in
                                 let _ = (match r9 with
                                          | VHsh d9 ->
                                            (let _ = (match hdflt_get xs with
                                                      | VNil -> () | dv -> (let _ = hdflt_set d9 dv in ())) in
                                             (match hdproc_get xs with
                                              | VProc pp -> (let _ = hdproc_set d9 (VProc pp) in ())
                                              | _ -> ()))
                                          | _ -> ()) in
                                 r9)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "merge") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'merge'")) in fail "mere-ruby: undefined method 'merge'")))
  else if str_eq name "merge!" || str_eq name "update" then
    (match recv with VHsh h -> let _ = hset h (hash_merge_all (hderef h) args) in recv | _ -> (let _ = map_set prim_missing "n" (mkstr "merge!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'merge!'")) in fail "mere-ruby: undefined method 'merge!'")))
  else if str_eq name "default" then (match recv with VHsh hid -> hdflt_get hid | _ -> VNil)
  else if str_eq name "default=" then
    (match recv with
     | VHsh hid ->
       (if cfrozen_get 1 hid then
          prim_raise "FrozenError" ("can't modify frozen Hash: " ++ inspect recv)
        else
        (match args with
         | Cons (d, _) ->
           let _ = (if map_has hash_dproc (str_of_int hid) then map_delete hash_dproc (str_of_int hid) else ()) in
           let _ = hdflt_set hid d in d
         | _ -> VNil))
     | _ -> VNil)
  // sample / shuffle
  else if str_eq name "sample" then
    (match recv with
     | VArr id -> let xs = deref id in let n = val_list_len xs in
       (if n == 0 then VNil else val_nth xs (mt_rand_int 0 n))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "sample") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'sample'")) in fail "mere-ruby: undefined method 'sample'")))
  else if str_eq name "shuffle" then
    (match recv with
     | VArr id -> let xs = deref id in arr_new (val_shuffle xs (val_list_len xs))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "shuffle") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'shuffle'")) in fail "mere-ruby: undefined method 'shuffle'")))
  else if str_eq name "shuffle!" then
    (match recv with
     | VArr id -> let xs = deref id in let _ = arr_set id (val_shuffle xs (val_list_len xs)) in recv
     | _ -> (let _ = map_set prim_missing "n" (mkstr "shuffle!") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'shuffle!'")) in fail "mere-ruby: undefined method 'shuffle!'")))
  // replace swaps the contents in place, so every alias of the hash sees it.
  else if str_eq name "replace" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     // replace takes on the ARGUMENT's default, default_proc and identity flag
     // and DROPS its own -- self becomes a copy of the other hash.
     | VHsh h ->
       (match args with
        | Cons (VHsh o, _) ->
          (let _ = hset h (hderef o) in
           let _ = (if map_has hcbi (str_of_int h) then map_delete hcbi (str_of_int h) else ()) in
           let _ = hcbi_copy o recv in
           let _ = (match hdflt_get o with
                    | VNil -> (let _ = hdflt_set h VNil in ())
                    | dv -> (let _ = hdflt_set h dv in ())) in
           let _ = (match hdproc_get o with
                    | VProc pp -> (let _ = hdproc_set h (VProc pp) in ())
                    | _ -> (if map_has hash_dproc (str_of_int h) then map_delete hash_dproc (str_of_int h) else ())) in
           recv)
        | Cons (other, _) ->
          prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Hash")
        | _ -> recv)
     | _ -> recv)
  else if str_eq name "fetch_values" && (match recv with VArr _ -> true | _ -> false) then
    (match recv with
     | VArr id ->
       (let ys = deref id in
        let n = val_list_len ys in
        let rec go = fn (ks: Val list) ->
          (match ks with
           | Nil -> (Nil : Val list)
           | Cons (VInt i, t) ->
             (let j = (if i < 0 then n + i else i) in
              if j >= 0 && j < n then Cons (val_nth ys j, go t)
              else Cons (prim_raise "IndexError"
                           ("index " ++ str_of_int i ++ " outside of array bounds: "
                            ++ str_of_int (0 - n) ++ "..." ++ str_of_int n), go t))
           | Cons (other, t) ->
             Cons (prim_raise "TypeError"
                     ("no implicit conversion of " ++ class_name other ++ " into Integer"), go t)) in
        arr_new (go args))
     | _ -> VNil)
  else if str_eq name "fetch_values" then
    (match recv with
     | VHsh xs -> let xs = hderef xs in arr_new (hash_fetch_values xs args)
     | _ -> (let _ = map_set prim_missing "n" (mkstr "fetch_values") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'fetch_values'")) in fail "mere-ruby: undefined method 'fetch_values'")))
  else if str_eq name "except" then
    (match recv with VHsh xs -> (let r9 = mkhash (hash_except (hderef xs) args) in
                                 let _ = hcbi_copy xs r9 in r9) | _ -> (let _ = map_set prim_missing "n" (mkstr "except") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'except'")) in fail "mere-ruby: undefined method 'except'")))
  // Hash#deconstruct_keys(keys) is the pattern-matching hook: it answers self
  // (the keys argument only tells it what will be read).
  else if str_eq name "deconstruct_keys" then
    (match recv with VHsh _ -> recv | _ -> recv)
  // Hash#compact drops the nil-VALUED pairs (compact! answers nil when there
  // were none). Neither existed.
  else if str_eq name "compact" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     | VHsh hid -> mkhash (hash_drop_nil (hderef hid))
     | _ -> recv)
  else if str_eq name "compact!" && (match recv with VHsh _ -> true | _ -> false) then
    (match recv with
     | VHsh hid ->
       (let before = hash_len (hderef hid) in
        let out = hash_drop_nil (hderef hid) in
        let _ = hset hid out in
        if hash_len out == before then VNil else recv)
     | _ -> recv)
  else if str_eq name "invert" then
    // a value that appears twice becomes ONE key, taking the LATER pair
    // (the flat list was handed to mkhash unmerged, so the hash held it twice).
    (match recv with VHsh xs -> mkhash (hash_merge Nil (hash_invert (hderef xs))) | _ -> (let _ = map_set prim_missing "n" (mkstr "invert") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'invert'")) in fail "mere-ruby: undefined method 'invert'")))
  else if str_eq name "fetch" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (k, rest) -> if hash_haskey xs k then hash_get xs k else (match rest with Cons (d, _) -> d | Nil -> VNil) | _ -> VNil) | _ -> (let _ = map_set prim_missing "n" (mkstr "fetch") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'fetch'")) in fail "mere-ruby: undefined method 'fetch'")))
  else if str_eq name "key" then
    (match recv with VHsh xs -> let xs = hderef xs in (match args with Cons (v, _) -> hash_key_of xs v | _ -> VNil) | _ -> (let _ = map_set prim_missing "n" (mkstr "key") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'key'")) in fail "mere-ruby: undefined method 'key'")))
  else if str_eq name "values_at" then
    (match recv with VHsh xs -> let xs = hderef xs in arr_new (hash_values_at xs args) | VArr id -> arr_new (arr_values_at (deref id) args) | _ -> (let _ = map_set prim_missing "n" (mkstr "values_at") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'values_at'")) in fail "mere-ruby: undefined method 'values_at'")))
  else if str_eq name "dig" then
    (match recv with
     | VHsh xs -> let xs = hderef xs in (match args with Cons (k, rest) -> let v = hash_get xs k in (match rest with Nil -> v | _ -> if (match v with VNil -> true | _ -> false) then VNil else prim_method v "dig" rest) | _ -> VNil)
     | VArr id ->
       (match args with
        | Cons (VInt i, rest) -> let v = val_nth (deref id) (if i < 0 then val_list_len (deref id) + i else i) in (match rest with Nil -> v | _ -> if (match v with VNil -> true | _ -> false) then VNil else prim_method v "dig" rest)
        // an Array subscript must be an Integer: dig answered nil for a
        // Symbol, which reads as "no element there" instead of "not an index".
        | Cons (VNil, _) -> prim_raise "TypeError" "no implicit conversion from nil to integer"
        | Cons (other, _) -> prim_raise "TypeError" ("no implicit conversion of " ++ class_name other ++ " into Integer")
        | Nil -> prim_raise "ArgumentError" "wrong number of arguments (given 0, expected 1+)")
     | _ -> (let _ = map_set prim_missing "n" (mkstr "dig") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'dig'")) in fail "mere-ruby: undefined method 'dig'")))
  // `super` from a builtin subclass's own #initialize (`class Uncountables <
  // Array`). The instance already IS the builtin value -- storage was created
  // before initialize ran -- so the base initialize only applies its arguments
  // to it. Returns nil, as Ruby's does.
  else if str_eq name "initialize" then
    (match recv with
     // Array#initialize REPLACES self (it is what `Array.new` runs), and
     // answers self rather than nil -- `[].send(:initialize, 3, :a)` is
     // [:a, :a, :a]. It also refuses a negative or impossible size, which is
     // checked in the world-level arm that converts the arguments.
     | VArr id ->
       (let _ = (match args with
                 | Nil -> arr_set id (Nil : Val list)
                 | _ -> (match array_new_args args with VArr src -> arr_set id (deref src) | _ -> ())) in recv)
     // Hash#initialize resets the DEFAULT (and clears the default_proc) without
     // touching the pairs, and answers self. It answered nil and left a
     // previously set default in place.
     | VHsh h ->
       (let _ = (if map_has hash_dproc (str_of_int h) then map_delete hash_dproc (str_of_int h) else ()) in
        let _ = (match args with
                 | Cons (d, _) -> hdflt_set h d
                 | Nil -> (if map_has hash_dflt (str_of_int h) then map_delete hash_dflt (str_of_int h) else ())) in
        recv)
     | VStr h -> (let _ = (match args with Cons (v, _) -> sset h (match v with VStr a -> sget a | _ -> to_s v) | Nil -> ()) in VNil)
     | _ -> (let _ = map_set prim_missing "n" (mkstr name) in (let __fm = ("mere-ruby: undefined method '" ++ name ++ "' for this value") in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm)))
  // A class receiver ends up here (invoke_val_c's VClass arm falls through to
  // the primitive dispatcher), and this is the terminal that answers for an
  // unknown name -- so record WHO it was asked of, not just the name. Without
  // it `Gem::Platform.match` reported `undefined method 'match'` and finding
  // the receiver took a separate probe.
  else (let _ = map_set prim_missing "n" (mkstr name) in
        let _ = map_set prim_missing "rv" (mkstr (prim_blame recv)) in
        // ... and the receiver's class NAME, because prim_method has no world
        // and a singleton class of an OBJECT cannot be named without one:
        // "(sng:111)" is bookkeeping, `#<Class:#<Object:0x6f>>` is the answer.
        let _ = (match recv with VClass c9 -> map_set prim_missing "rvc" (mkstr c9) | _ -> ()) in
        let _ = map_set prim_missing "rvn" (mkstr name) in
        (let __fm = ("mere-ruby: undefined method '" ++ name ++ "'" ++ prim_blame recv) in let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr __fm)) in fail __fm))
// prim_method has no `world`, so this describes the receiver without one: a
// class or module by name, a primitive by its class. An object needs `world` to
// name its class, and the world-aware path (undef_blame) covers those.
// The world-free half of cls_display, for the paths that have no `world` (see
// prim_blame): an anonymous class can name itself without one, and a singleton
// class of a CLASS can too. A singleton class of an OBJECT cannot -- naming the
// object's class needs the world -- so it is left to cls_display rather than
// guessed at.


// tr/count/delete/squeeze SET arguments: every one must already be a String
// (the dispatch layer has tried #to_str), and its bytes must be valid in its
// encoding -- ruby refuses the set, not the receiver ("hello".delete("\xFF")
// is ArgumentError, "hell\xFFo".delete("l") is not).

// ---- Range over values ---------------------------------------------------
// The integer case is the fast one and stays as it was; a string range walks
// String#succ the way ruby does; an absent (endless) bound cannot be
// materialised at all, and says so rather than inventing a last element.

// A Range used to SLICE a string or array: the half-open [start, end) pair it
// picks out of `n` elements. A missing bound means "from the start" / "to the
// end", which is what makes `a[1..]` and `a[..3]` work.
// does this range contain the value? A comparison, so it holds for numbers,
// strings and anything else with <=>; an absent bound does not constrain.
// A Range's bounds have to be comparable with each other -- ruby builds one
// only if `lo <=> hi` answers -- so `(1.."x")` is an ArgumentError rather than
// a range that raises later, somewhere else. An absent bound constrains
// nothing, and an object is taken at its word if its class defines `<=>`.
// `Hash[...]`: one Hash, one array of [k, v] pairs (a 1-element pair means a
// nil value), or a flat even-length list. An odd list or a wrong-sized pair is
// an ArgumentError, in ruby's words.




and rng_bad_bounds = fn world -> fn (lo: Val) -> fn (hi: Val) ->
  match lo with
  | VNil -> false
  | _ ->
    (match hi with
     | VNil -> false
     // equal bounds always compare: Object#<=> answers 0 for a pair it
     // considers ==, whatever the class, which is why ruby builds `(//..//)`
     // (two empty Regexps) and refuses `(/a/../b/)`.
     | _ when rb_eq lo hi -> false
     | _ ->
       // every numeric kind compares with every other: a Bignum bound is what
       // sidekiq-pro's (0..2**64) has, and `is_num` does not count those.
       if rng_num_kind lo && rng_num_kind hi then false
       else if (match lo with VStr _ -> true | _ -> false)
               && (match hi with VStr _ -> true | _ -> false) then false
       else if (match lo with VSym _ -> true | _ -> false)
               && (match hi with VSym _ -> true | _ -> false) then false
       // ...and for everything else, ASK. This used to enumerate the kinds
       // that compare -- numeric, String, Symbol, an object whose class
       // brings a `<=>` -- and answer "bad" for every kind not on the list.
       // Array was not on the list, so ruby's `(["a"]..["f"])` (a perfectly
       // ordinary range: Array#<=> is element-wise) was an ArgumentError at
       // CONSTRUCTION, which hid every later question about it: #min, #max,
       // #cover? never ran, and #each / #to_a / #min(2) reported the
       // constructor's ArgumentError where ruby reports TypeError from the
       // walk. A list of comparable kinds cannot keep up with the classes
       // that have a `<=>`; asking `lo <=> hi` and reading nil as "no" is
       // ruby's actual rule, and cmp_possible_w is that question -- including
       // for an object, whose own `<=>` it invokes rather than merely
       // checking that one is defined.
       else not (cmp_possible_w world lo hi))

// Which values can be compared at all? ruby asks `<=>` and reads nil as
// "no", and Range#cover? / #include? / #=== answer FALSE for that. cmp_vals
// RAISES an ArgumentError instead, so `(1..3).include?("x")` was an error
// where ruby says false -- fifteen assertions in core/range/include_spec, and
// #=== and #cover? want the same answer.
// This has no world -- cover?/include? are answered in the leaf dispatcher --
// so an OBJECT on either side is left to cmp_vals as before; the kinds this
// can see are the ones the spec asks about.

// ...and WITH a world, so an OBJECT decides for itself. A nil from its own
// <=> means "not comparable", which is the answer Range#cover? wants -- and
// the leaf version above cannot ask, so an object on either side used to
// reach cmp_vals and come back as an ArgumentError.
// Do two ARRAYS compare? Array#<=> walks the pairs and stops at the first
// that is not ==: that pair decides, and if its `<=>` answers nil the whole
// comparison is nil. So `[1] <=> [2]` is -1 but `[1] <=> ["a"]` is nil, and
// ruby refuses to build a range from the second, while accepting the first.
// Reading "both sides are Arrays, so they compare" accepted both.
//
// The rule is not restated here: arr_spaceship_w IS Array#<=>, cycle guard
// and nested pairs included, so this asks it and reads a non-Integer as "no".
and cmp_arr_possible_w = fn world -> fn (xa: int) -> fn (xb: int) ->
  match try_or (fn (u: unit) -> arr_spaceship_w gc_cenv0 world (deref xa) (deref xb)) VNil with
  | VInt _ -> true
  | _ -> false

and cmp_possible_w = fn world -> fn (a: Val) -> fn (b: Val) ->
  match a with
  | VObj oid ->
    (let (m9, s9, o9, i9) = world in
     let ocl = map_get o9 oid in
     if has_meth world ocl "<=>" then
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        match invoke world nb9 a ocl "<=>" (Cons (b, Nil)) with VInt _ -> true | _ -> false)
     // ...and a BUILTIN <=> answers too. Time's lives in the dispatcher, not
     // in the method table, so asking only for a user definition read Time as
     // "comparable with anything" and `(t1..t2).include?(1)` came back as an
     // ArgumentError from cmp_vals instead of false. The dispatch is guarded:
     // an operator that refuses is a refusal to compare, not an error here.
     // (through a SINGLETON class too: `def t.succ` renames the object's class
     // to "(sng:...)", and the builtin table is keyed by the real name)
     else if builtin_obj_has (display_cls world ocl) "<=>" then
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        match try_or (fn (u: unit) -> invoke_val_c gc_cenv0 world nb9 a "<=>" (Cons (b, Nil)) false) VNil with
        | VInt _ -> true
        | _ -> false)
     // An object with NO <=> at all orders only against ITSELF: ruby's
     // Object#<=> is 0 for the same object and nil for anything else. Reading
     // "either side is an object, so they compare" sent a bare Object.new to
     // cmp_vals, which raised an ArgumentError where ruby answers false.
     else (match b with VObj bid -> oid == bid | _ -> false))
  | VArr xa ->
    (match b with
     | VArr xb -> cmp_arr_possible_w world xa xb
     | VObj _ -> cmp_possible_w world b a
     | _ -> false)
  | _ -> (match b with
          | VObj _ -> cmp_possible_w world b a
          | _ -> cmp_possible a b)

// Do these endpoints COMPARE rather than walk? ruby's Range#include? is
// cover? for numeric endpoints -- which is what lets `(1..).include?(5)` work
// with nothing to enumerate -- and for Time, which it treats the same way. A
// Numeric SUBCLASS counts: the spec tests exactly that.
and rng_cmp_endpoints = fn world -> fn (lo: Val) -> fn (hi: Val) ->
  let kind = fn (x: Val) ->
    (match x with
     | VInt _ -> "n" | VBig _ -> "n" | VFlt _ -> "n" | VRat (_, _) -> "n"
     | VNil -> "?"
     | VObj oid ->
       (let (m9, s9, o9, i9) = world in
        let c9 = map_get o9 oid in
        if obj_is_a world c9 "Numeric" then "n"
        else if str_eq (display_cls world c9) "Time" then "t"
        else "x")
     | _ -> "x") in
  let a = kind lo in
  let b = kind hi in
  (str_eq a "?" && (str_eq b "n" || str_eq b "t"))
  || ((str_eq a "n" || str_eq a "t") && (str_eq b "?" || str_eq a b))

// Walk #succ from `cur` toward `hi`, answering whether `v` is on the walk.
// Membership is `==` on the ELEMENT (ruby asks the element, not the argument),
// and an argument that compares with nothing simply never matches -- which is
// how `include?(Object.new)` is false rather than an error. The step count is
// bounded for the same reason every walk here is.
and rng_succ_member = fn env -> fn world -> fn (cur: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (v: Val) -> fn (n: int) ->
  if n > 100000 then false
  else if (if cmp_possible_w world cur hi then false else true) then false
  else
    (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
     let d9 = cmp_vals_w world cur hi in
     if d9 > 0 then false
     else if excl && d9 == 0 then false
     else if truthy (invoke_val_c env world nb9 cur "==" (Cons (v, Nil)) false) then true
     else rng_succ_member env world (invoke_val_c env world nb9 cur "succ" Nil false) hi excl v (n + 1))

// A String range converts its argument with #to_str, and the three outcomes
// are all different: a String (or something that yields one) is looked for on
// the walk, something that yields a NON-String is a TypeError, and something
// with no #to_str at all is simply not a member.
and rng_str_arg = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VStr _ -> v
  | VObj _ ->
    (if responds world v "to_str" then
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), env) in
        match invoke_val_c env world nb9 v "to_str" Nil false with
        | VStr h9 -> VStr h9
        | other -> (let _ = raise_exc world "TypeError"
                      ("can't convert " ++ display_cls_msg world (dispatch_cls_of world v)
                       ++ " to String (" ++ display_cls_msg world (dispatch_cls_of world v)
                       ++ "#to_str gives " ++ display_cls_msg world (dispatch_cls_of world other) ++ ")") in VNil))
     else VNil)
  | _ -> VNil

// Is this a value ruby could have ORDERED -- something on a line? A Numeric
// (subclasses and Complex included) or a Time. `(nil..nil)` has no endpoint to
// compare against, so ruby answers true for exactly these and refuses the rest
// by name rather than guessing.
and rng_linear_val = fn world -> fn (v: Val) ->
  match v with
  | VInt _ -> true | VBig _ -> true | VFlt _ -> true
  | VRat (_, _) -> true | VCpx (_, _) -> true
  | VObj oid ->
    (let (m9, s9, o9, i9) = world in
     let c9 = map_get o9 oid in
     obj_is_a world c9 "Numeric" || str_eq (display_cls world c9) "Time")
  | _ -> false

// Range#min(n) / #max(n) on INTEGER endpoints are ARITHMETIC, not enumeration.
// `(0...2**64).min(2)` is [0, 1]; materializing to find them answered [] for a
// bignum end and did not finish at all for an endless range. n is small by
// construction -- it is how many values the caller asked for.
// The n of #min(n) / #max(n). It is not required to BE an Integer -- ruby
// converts anything with #to_int, and the spec pins that with a mock -- and it
// must not be negative. The two methods report a negative n differently:
// #max says "negative size (-1)" and #min says "negative array size (or size
// too big)". That is not a distinction worth inventing, so it is copied.
// Accepting only a literal Integer meant `max(Object.new)` was answered (with
// the plain maximum) where ruby refuses, and a negative n was clamped to 0 and
// answered [].
// [floor(a / b), a - floor(a / b) * b] in exact Rational arithmetic.

// ruby 4's `Hash.new(default = nil, capacity: 0)` takes a keyword beside the
// default -- and refuses every other keyword. A keywords hash counted as a
// positional argument here, so `Hash.new(capacity: 42)` built a hash whose
// DEFAULT was {capacity: 42} and `Hash.new(5, capacity: 42)` was a wrong-arity
// call. Answers the POSITIONAL arguments, and whether it already raised.
// every keyword but :capacity is unknown, and ruby names them all in one
// message (singular or plural).

// The n of `min(n)` / `max(n)`, converted the way ruby converts it. `sized`
// picks which of ruby's two negative-n messages this caller gets: the one that
// names the size is what a BLOCK-taking min/max and Array's own blockless
// min/max report, and the array-size one is Range's blockless path. The flag
// used to be "is this max?", which is what neither message depends on -- so
// `(1..3).max(-1)` named the size and `[1, 2].min(-1)` named the array, each
// wearing the other one's message.
and rng_take_count = fn world -> fn (v: Val) -> fn (sized: bool) ->
  let n9 =
    (match v with
     | VInt n -> n
     // a Float n truncates, the way every other integer conversion does
     | VFlt f -> int_of_float f
     // ruby 4 quotes both sides: "into 'long'". This still carried 2.x's
     // "into `long'", one byte off in a message a spec compares whole.
     | VBig _ -> (let _ = raise_exc world "RangeError" "bignum too big to convert into 'long'" in 0)
     | VObj _ ->
       (if responds world v "to_int" then
          (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
           match invoke_val_c gc_cenv0 world nb9 v "to_int" Nil false with
           | VInt n2 -> n2
           | other ->
             (let _ = raise_exc world "TypeError"
                        ("can't convert " ++ display_cls_msg world (dispatch_cls_of world v)
                         ++ " to Integer (" ++ display_cls_msg world (dispatch_cls_of world v)
                         ++ "#to_int gives " ++ class_name other ++ ")") in 0))
        else (let _ = raise_exc world "TypeError"
                        ("no implicit conversion of "
                         ++ display_cls_msg world (dispatch_cls_of world v) ++ " into Integer") in 0))
     // nil is ruby's one worded-differently conversion message: "from nil to
     // integer", not "of NilClass into Integer".
     | VNil -> (let _ = raise_exc world "TypeError"
                          "no implicit conversion from nil to integer" in 0)
     | _ -> (let _ = raise_exc world "TypeError"
                       ("no implicit conversion of " ++ class_name v ++ " into Integer") in 0)) in
  if n9 < 0 then
    (let _ = raise_exc world "ArgumentError"
               (if sized then "negative size (" ++ str_of_int n9 ++ ")"
                else "negative array size (or size too big)") in 0)
  else n9


// The last integer ELEMENT of a range counted from an integer begin. The end
// need not BE an integer: ruby walks integers from the begin and only
// COMPARES against the end, so `(1..10.0).max(2)` is [10, 9] and
// `(1...10.0).max(2)` is [9, 8]. Requiring an integer end refused all three.
// An exclusive end that is not exactly an integer excludes nothing --
// (1...2.5) still ends at 2 -- which is the same rule #size already had.

// How many integers a range holds -- ARITHMETIC, which is what ruby's #size
// and #count both are for integer bounds. Walking them answered [] for a
// bignum end (the walk gave up) and never returned for a wide one.

// ...and their SUM, by Gauss rather than by adding them up: `(1..2**64).sum`
// is an answer ruby produces instantly and a walk cannot produce at all.

// Which class does "can't iterate from X" name? The BEGIN's -- and it is the
// begin ALONE that decides whether a range can be walked at all. Deciding it
// from either endpoint made `(1..10.0)` unwalkable, and hard-coding the name
// as "Float" reported `(["a"]..["f"]).max(2)` as "can't iterate from Float".
// An empty answer means "not for this branch to refuse": an integer, String
// or Symbol begin walks, and an OBJECT begin may walk too (its own #succ
// decides, which needs the world -- the object arm below asks it).

// The ELEMENTS of a range whose begin answers #succ. A String or Symbol range
// has its own walker; this is the general one, for any Comparable object that
// can name its successor -- `(Sc(1)..Sc(3)).to_a` is [Sc(1), Sc(2), Sc(3)] and
// every Enumerable name follows from having the list. Bounded like every other
// walk here: an object whose #succ never reaches the end would not stop.
and rng_succ_vals = fn world -> fn (cur: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (n: int) -> fn (acc: Val list) ->
  if n > 100000 then rev_app acc Nil
  else if (if cmp_possible_w world cur hi then false else true) then rev_app acc Nil
  else
    (let d9 = cmp_vals_w world cur hi in
     if d9 > 0 then rev_app acc Nil
     else if excl && d9 == 0 then rev_app acc Nil
     // at the end, the END is the last element and #succ is NOT asked again:
     // ruby yields the end object itself. Asking succ of a value that merely
     // EQUALS the end reached an object the end never was -- a Time one second
     // on, without the singleton #succ the spec had defined on the end -- and
     // raised NoMethodError where ruby was already done.
     else if d9 == 0 then rev_app (Cons (cur, acc)) Nil
     else
       // gc_cenv0 is the shared placeholder cenv the other world-level
       // helpers use: dispatching #succ needs an env only to build a blk.
       (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        rng_succ_vals world (invoke_val_c gc_cenv0 world nb9 cur "succ" Nil false) hi excl (n + 1) (Cons (cur, acc))))

// Does this range enumerate through #succ on an OBJECT begin? (A String or
// Symbol one does not come here -- range_vals already walks those.)
and rng_is_succ_obj = fn world -> fn (lo: Val) -> fn (hi: Val) ->
  (match lo with VObj _ -> true | _ -> false)
  && (match hi with VNil -> false | _ -> true)
  && responds world lo "succ"

and rng_include = fn env -> fn world -> fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (v: Val) ->
  if (match lo with VNil -> true | _ -> false) && (match hi with VNil -> true | _ -> false) then
    (if rng_linear_val world v then VBool true
     else raise_exc world "TypeError" "cannot determine inclusion in beginless/endless ranges")
  else if rng_cmp_endpoints world lo hi then VBool (rng_covers_w world lo hi excl v)
  else
    // A walk needs BOTH ends, and ruby says so in its own words: membership
    // in a half-open range it cannot compare is "cannot determine inclusion
    // in beginless/endless ranges", not the walk's "can't iterate from X".
    // One message, whichever end is missing -- the two spellings here named
    // the missing end instead, for `("aa"..).include?("a")` and for every
    // object range with one end open.
    (match hi with
     | VNil -> raise_exc world "TypeError" "cannot determine inclusion in beginless/endless ranges"
     | _ ->
       (match lo with
        | VNil -> raise_exc world "TypeError" "cannot determine inclusion in beginless/endless ranges"
        | VStr _ ->
          (match rng_str_arg env world v with
           | VStr h9 -> VBool (val_member_w env world (range_vals_raw lo hi excl) (VStr h9))
           | _ -> VBool false)
        | VSym _ -> VBool (val_member_w env world (range_vals_raw lo hi excl) v)
        | VObj _ ->
          (if responds world lo "succ" then VBool (rng_succ_member env world lo hi excl v 0)
           else raise_exc world "TypeError"
                  ("can't iterate from " ++ display_cls_msg world (dispatch_cls_of world lo)))
        | _ -> raise_exc world "TypeError"
                 ("can't iterate from " ++ display_cls_msg world (dispatch_cls_of world lo))))

and rng_covers_w = fn world -> fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) -> fn (v: Val) ->
  if (match lo with VNil -> false | _ -> (if cmp_possible_w world v lo then false else true)) then false
  else if (match hi with VNil -> false | _ -> (if cmp_possible_w world v hi then false else true)) then false
  else
    (match lo with VNil -> true | _ -> cmp_vals_w world v lo >= 0)
    && (match hi with
        | VNil -> true
        | _ -> if excl then cmp_vals_w world v hi < 0 else cmp_vals_w world v hi <= 0)

// Range#overlap? (ruby 3.3): true when the two ranges share at least one
// element. An empty range overlaps nothing, and a non-Range argument is a
// TypeError rather than a comparison failure.

// Which range BEGINS can be WALKED? ruby's Range#each asks the begin for
// #succ: an Integer, a String and a Symbol have one; a Float does not
// ("can't iterate from Float"). The raw walker answered an EMPTY list for
// every begin it could not do, so `(1.0..3.0).to_a` was [] and not a refusal.
// "" = it can be walked; anything else is the class name for the message.
// Which class does a REFUSAL to walk this range name, or "" for none? The
// begin decides that, and asking it a second way here let the two answers
// disagree: this spelling had an arm for an integer begin with a BIGNUM end
// but none for a bignum BEGIN, so `(2**64..2**64+2).to_a` was "can't iterate
// from Integer" while #each, #map, #count and #include? all walked it. The
// begin is now asked once, in rng_walk_from; what remains here is the END,
// which only has to be of a kind the walk can compare against.


// ...and with a world, so an OBJECT range can be asked. The world-free
// version reaches cmp_vals, which raises for a pair it cannot compare.
and rng_empty_w = fn world -> fn (lo: Val) -> fn (hi: Val) -> fn (excl: bool) ->
  match lo with
  | VNil -> false
  | _ -> (match hi with
          | VNil -> false
          | _ ->
            (if cmp_possible_w world lo hi
             then (let c = cmp_vals_w world lo hi in if excl then c >= 0 else c > 0)
             else false))



// the elements, with no world to raise through: an un-enumerable range is
// empty here, and the raising version below is used where there IS a world.
// Range#sum over integers is GAUSS, not an addition per element: ruby answers
// `(1..2**64).sum` at once, and adding up a materialised range answered 0 --
// the walk gave up on the bignum end and val_sum summed nothing. A begin that
// cannot be walked has no sum at all, which is a TypeError rather than 0.

// The elements of a range with a bignum bound. A bignum end is not an
// UNWALKABLE end -- (2**64..2**64+2) has three elements -- it is just one
// that native ints cannot count to. Past a million elements the walk is not
// attempted: that is where ruby exhausts memory rather than answering.




// ("a"..) has no end to walk toward, so the COUNT is the bound.

// `("a".."e")` walks succ; the guard bounds a range whose end is unreachable
// ("a".."A"), which ruby answers with an empty list rather than looping.
// TWO SINGLE-CHARACTER endpoints walk CODEPOINTS, not #succ. ruby's
// String#upto says so, and it is why `('X'..'z').to_a` runs through the
// punctuation between Z and a: `'Z'.succ` is "AA", which is longer than the
// end, so the succ walk stopped at Z and answered 3 elements where ruby
// answers 35. `(:A..:z).to_a.size` is 58 for the same reason.





// reduce/inject with an operator symbol: fold by sending `sym` to the
// accumulator with each element (so :+ / :* / any method all work).
and reduce_sym = fn env -> fn world -> fn blk -> fn (xs: Val list) -> fn (args: Val list) ->
  match args with
  | Cons (VSym sym, _) -> (match xs with Nil -> VNil | Cons (h, t) -> reduce_sym_go env world blk t h sym)
  | Cons (init, Cons (VSym sym, _)) -> reduce_sym_go env world blk xs init sym
  // ...and the same two shapes with the operator written as a String.
  | Cons (VStr sh, Nil) ->
    (match xs with Nil -> VNil | Cons (h, t) -> reduce_sym_go env world blk t h (sget sh))
  | Cons (init, Cons (VStr sh, _)) -> reduce_sym_go env world blk xs init (sget sh)
  // ...and an object that converts with #to_str names the method too; one that
  // does not is ruby's TypeError, naming what it could not convert.
  | Cons (VObj _, Nil) ->
    (match coerce_str_int_args env world args with
     | Cons (VStr sh, _) ->
       (match xs with Nil -> VNil | Cons (h, t) -> reduce_sym_go env world blk t h (sget sh))
     // ruby names the VALUE here (its inspect), not its class.
     | _ -> (let _ = raise_exc world "TypeError"
                       (inspect_w gc_cenv0 world (match args with Cons (a9, _) -> a9 | Nil -> VNil)
                        ++ " is not a symbol nor a string") in VNil))
  | Cons (init, Cons (VObj _, Nil)) ->
    (match coerce_str_int_args env world (Cons (init, Cons ((match args with Cons (_, Cons (o9, _)) -> o9 | _ -> VNil), Nil))) with
     | Cons (_, Cons (VStr sh, _)) -> reduce_sym_go env world blk xs init (sget sh)
     | _ -> (let _ = raise_exc world "TypeError"
                       (inspect_w gc_cenv0 world (match args with Cons (_, Cons (a9, _)) -> a9 | _ -> VNil)
                        ++ " is not a symbol nor a string") in VNil))
  | _ -> (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: reduce expects a symbol or block")) in fail "mere-ruby: reduce expects a symbol or block")

and reduce_sym_go = fn env -> fn world -> fn blk -> fn (xs: Val list) -> fn (acc: Val) -> fn (sym: str) ->
  match xs with
  | Nil -> acc
  | Cons (h, t) -> reduce_sym_go env world blk t (apply_bin_vals world blk sym acc h) sym

// world-aware compare: a VObj with a user <=> uses it; everything else
// falls back to the pure cmp_vals. Lets sort/min/max/clamp work on
// Comparable user objects.
and cmp_vals_w = fn world -> fn (a: Val) -> fn (b: Val) ->
  match a with
  | VObj oid ->
    let (meths, sup, ocls, ivars) = world in
    let ocl = map_get ocls oid in
    if has_meth world ocl "<=>" then
      let noblk = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in  // shared placeholder cenv (see gc_cenv0)
      (match invoke world noblk a ocl "<=>" (Cons (b, Nil)) with VInt n -> n | _ -> 0)
    // Object#<=> answers 0 for the SAME object, and cmp_possible_w says so --
    // it reads a bare object as comparable with itself and with nothing else.
    // This half did not: it handed the pair to the world-free cmp_vals, which
    // raised "comparison of Object with Object failed". Two functions
    // answering "can these compare" and "what IS the comparison" have to
    // agree, or the first one's yes leads straight into the second one's
    // raise -- which is how `(x..x).minmax` became an ArgumentError.
    else (match b with
          | VObj bid -> (if oid == bid then 0 else cmp_vals a b)
          | _ -> cmp_vals a b)
  // classes/modules order by the subclass relation (Module#<=>), so a list of
  // them sorts; unrelated ones answer nil, which sorts as equal here.
  | VClass ca ->
    (match b with
     | VClass cb ->
       if str_eq ca cb then 0
       else if pp_mem (ancestors_of world ca) cb then 0 - 1
       else if pp_mem (ancestors_of world cb) ca then 1
       else 0
     | _ -> cmp_vals a b)
  // Array vs Array element-wise, with the world: falling through to cmp_vals
  // here meant `[obj] <=> [obj]` (and Hash#sort, which compares [k, v] pairs)
  // could not reach a user <=>.
  | VArr x ->
    (match b with
     // the same cycle guard as cmp_vals: this path exists so a user <=> can be
     // reached, and it recursed forever on the same input.
     | VArr y ->
       let k = "c" ++ str_of_int x ++ ":" ++ str_of_int y in
       if map_has cyc_seen k then 0
       else
         let _ = map_set cyc_seen k 1 in
         let r = arr_cmp_w world (deref x) (deref y) in
         let _ = map_delete cyc_seen k in
         r
     | _ -> cmp_vals a b)
  | _ -> cmp_vals a b
and arr_cmp_w = fn world -> fn (xs: Val list) -> fn (ys: Val list) ->
  match xs with
  | Nil -> (match ys with Nil -> 0 | _ -> 0 - 1)
  | Cons (x, xt) ->
    (match ys with
     | Nil -> 1
     | Cons (y, yt) ->
       (let c = cmp_vals_w world x y in
        if c == 0 then arr_cmp_w world xt yt else c))

// Comparable#clamp, in the ORDER ruby checks: a single argument must be a
// Range, an exclusive range with a real end is refused outright, and min is
// compared with max BEFORE the receiver is compared with either bound.
// Clamping first answered the bound for `5.clamp(3, 1)` and reported the
// RECEIVER's comparison failure for `5.clamp("a", 1)` -- two wrong answers out
// of the same missing order. Both the primitive receivers and the user-object
// path answer through here, so the order is written once.
// does this pair COMPARE at all? cmp_vals_w has to answer an int, so a `<=>`
// that says nil comes back as 0 -- indistinguishable from "equal". #clamp has
// to tell them apart: ruby refuses a min and max that do not compare.
and cmp_defined_w = fn world -> fn (a: Val) -> fn (b: Val) ->
  match a with
  | VObj oid ->
    (let (meths, sup, ocls, ivars) = world in
     let cls = map_get ocls oid in
     if has_meth world cls "<=>" then
       (let nb7 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
        match invoke world nb7 a cls "<=>" (Cons (b, Nil)) with
        | VNil -> false
        | c -> is_num c)
     else true)
  | _ -> true

and clamp_val = fn world -> fn (recv: Val) -> fn (args: Val list) ->
  let nn = fn (v: Val) -> (match v with VNil -> false | _ -> true) in
  let (lo, hi, bad) =
    (match args with
     | Nil ->
       (let _ = raise_exc world "ArgumentError"
                  "wrong number of arguments (given 0, expected 1..2)" in (VNil, VNil, true))
     | Cons (VRange (l, h, ex), Nil) ->
       (if ex && nn h
        then (let _ = raise_exc world "ArgumentError"
                        "cannot clamp with an exclusive range" in (VNil, VNil, true))
        else (l, h, false))
     | Cons (a1, Nil) ->
       (let _ = raise_exc world "TypeError"
                  ("wrong argument type " ++ class_name a1 ++ " (expected Range)") in (VNil, VNil, true))
     | Cons (l, Cons (h, _)) -> (l, h, false)) in
  if bad then recv
  // ⚠ min and max must COMPARE, and "does not compare" is not "equal": a
  //   `<=>` that answers nil came back as 0 here and the refusal never fired.
  else if nn lo && nn hi && (if cmp_defined_w world lo hi then false else true) then
    (let _ = raise_exc world "ArgumentError"
               ("comparison of " ++ display_cls_msg world (dispatch_cls_of world lo) ++ " with "
                ++ display_cls_msg world (dispatch_cls_of world hi) ++ " failed") in recv)
  else if nn lo && nn hi && cmp_vals_w world lo hi > 0 then
    (let _ = raise_exc world "ArgumentError"
               "min argument must be less than or equal to max argument" in recv)
  else if nn lo && cmp_vals_w world recv lo < 0 then lo
  else if nn hi && cmp_vals_w world recv hi > 0 then hi
  else recv

// insertion sort using the world-aware comparator.
and sort_w = fn world -> fn (xs: Val list) ->
  match xs with Nil -> Nil | Cons (h, t) -> insert_w world h (sort_w world t)
and insert_w = fn world -> fn (x: Val) -> fn (sorted: Val list) ->
  match sorted with
  | Nil -> Cons (x, Nil)
  | Cons (h, t) ->
    // a user <=> answering NIL means "these do not compare", and sorting them
    // is ruby's ArgumentError -- cmp_vals_w has to answer with an int, so the
    // nil case is asked about separately here (it read as 0 = equal, and two
    // uncomparable objects sorted "fine").
    let _ = (match x with
             | VObj oid9 ->
               (let (m9, s9, o9, i9) = world in
                let c9 = map_get o9 oid9 in
                // a BasicObject has no #<=> at all (Object is where it comes
                // from), so sorting one is NoMethodError, not "incomparable".
                // Asked as "is it a BasicObject", never as "is it not an
                // Object": an ordinary class's chain does not spell Object out
                // here, and reading that as "not an Object" made every
                // Comparable class raise (corpus/148).
                if str_eq c9 "BasicObject" || exc_is_a world c9 "BasicObject" then
                  (let _ = raise_exc world "NoMethodError"
                             ("undefined method '<=>' for " ++ for_recv_cls world c9) in ())
                else if has_meth world c9 "<=>" then
                  (let nb9 = (false, (Nil : str list), (Nil : Stmt list), gc_cenv0) in
                   match invoke world nb9 x c9 "<=>" (Cons (h, Nil)) with
                   | VNil -> (let _ = raise_exc world "ArgumentError"
                                        ("comparison of " ++ class_name x ++ " with "
                                         ++ cmp_other_name h ++ " failed") in ())
                   | _ -> ())
                else ())
             | _ -> ()) in
    if cmp_vals_w world x h <= 0 then Cons (x, sorted) else Cons (h, insert_w world x t)

// apply a binary operator (named by a symbol like :+) to two runtime values
// by evaluating a real EBin over a scratch env — reuses all operator logic.
and apply_bin_vals = fn world -> fn blk -> fn (op: str) -> fn (a: Val) -> fn (b: Val) ->
  let e2 = map_new () in
  let _ = map_set e2 "__ra" a in
  let _ = map_set e2 "__rb" b in
  eval_e e2 world blk (EBin (op, EVar "__ra", EVar "__rb"))

// Hash#merge with a conflict block: on a duplicate key, the value is
// block(key, old_value, new_value). Folds every VHsh argument left to right.
and hash_merge_block = fn world -> fn nb -> fn (base: Val list) -> fn (args: Val list) ->
  match args with
  | Nil -> base
  | Cons (VHsh o, t) -> hash_merge_block world nb (hash_merge_one_block world nb base (hderef o)) t
  | Cons (_, t) -> hash_merge_block world nb base t

and hash_merge_one_block = fn world -> fn nb -> fn (base: Val list) -> fn (other: Val list) ->
  match other with
  | Nil -> base
  | Cons (k, rest) ->
    (match rest with
     | Cons (v, t) ->
       let amb = (false, (Nil : str list), (Nil : Stmt list), map_new ()) in
       let nv = (if hash_haskey base k
                 then flow_value (run_block world amb nb (Cons (k, Cons (hash_get base k, Cons (v, Nil)))))
                 else v) in
       hash_merge_one_block world nb (hash_put base k nv) t
     | Nil -> base)

// ---- sprintf/format/`%` string formatting -------------------------------
// %[flags][width][.prec]type ; flags: - + 0 space # ; types: d i u s f x X o b c
// ---- Kernel#sprintf / String#% ---------------------------------------------
// One pass over the format string. How the arguments are referenced --
// sequentially (%s), by number (%1$s), or by name (%<x>s / %{x}) -- is a
// property of the WHOLE format, so `mode` rides along the entire pass and
// mixing two styles is an ArgumentError no matter how far apart they sit.
// mode: 0 = undecided, 1 = sequential, 2 = numbered, 3 = named.
and rb_format = fn env -> fn world -> fn (fmt: str) -> fn (args: Val list) ->
  let (out, used, mode) = rb_format_go env world fmt 0 args 0 0 "" in
  // leftover arguments are an error only under $DEBUG, and only for the
  // sequential style: numbered and named formats may leave arguments unread.
  let dbg = (if map_has globals "DEBUG" then (match map_get globals "DEBUG" with VNil -> false | VBool b -> b | _ -> true) else false) in
  if dbg && mode <= 1 && used < val_list_len args then
    (let _ = prim_raise "ArgumentError" "too many arguments for format string" in out)
  else out

and rb_format_go = fn env -> fn world -> fn (fmt: str) -> fn (i: int) -> fn (args: Val list) -> fn (nextarg: int) -> fn (mode: int) -> fn (acc: str) ->
  let n = str_len fmt in
  if i >= n then (acc, nextarg, mode)
  else
    let c = char_at fmt i in
    if str_eq c "%" then
      (if i + 1 < n && str_eq (char_at fmt (i + 1)) "%" then rb_format_go env world fmt (i + 2) args nextarg mode (acc ++ "%")
       // `%{name}` substitutes the hash entry with no format spec at all, and
       // `%<name>05.2f` names the argument for one. rubocop-ast generates its
       // node matchers this way, so a format that does not substitute becomes a
       // syntax error somewhere else entirely.
       else if i + 1 < n && str_eq (char_at fmt (i + 1)) "\{" then
         let (key, j) = rb_fmt_name fmt (i + 2) "" "}" in
         let m2 = rb_fmt_to_named mode in
         rb_format_go env world fmt j args nextarg m2 (acc ++ rb_fmt_one env world "" (0 - 1) (0 - 1) false "s" (rb_fmt_named args key "\{" "}"))
       else if i + 1 < n && str_eq (char_at fmt (i + 1)) "<" then
         let (key, j0) = rb_fmt_name fmt (i + 2) "" ">" in
         let av = rb_fmt_named args key "<" ">" in
         let m2 = rb_fmt_to_named mode in
         // the spec after the name formats exactly this one value: run the
         // directive parser over a one-element argument list in numbered mode
         // with the position preset, so a stray %s inside cannot consume the
         // real argument list.
         let (piece, j, na9, m9) = rb_fmt_dir env world fmt j0 (Cons (av, Nil)) 0 2 "" (0 - 1) false (0 - 1) false 1 in
         let _ = na9 in
         let _ = m9 in
         rb_format_go env world fmt j args nextarg m2 (acc ++ piece)
       else
         let (piece, j, na2, m2) = rb_fmt_dir env world fmt (i + 1) args nextarg mode "" (0 - 1) false (0 - 1) false 0 in
         rb_format_go env world fmt j args na2 m2 (acc ++ piece))
    else rb_format_go env world fmt (i + 1) args nextarg mode (acc ++ c)

// a named reference may not mix with the sequential or numbered styles.

// one directive, from the char after '%'. flags/width/prec/pos accumulate as
// the spec is read left to right; `pset` tells "no precision" apart from an
// explicit one (a negative star precision means none was given). Returns the
// formatted piece, the index past the type char, the argument cursor, and mode.
and rb_fmt_dir = fn env -> fn world -> fn (fmt: str) -> fn (i: int) -> fn (args: Val list) ->
  fn (nextarg: int) -> fn (mode: int) -> fn (flags: str) -> fn (width: int) -> fn (wset: bool) ->
  fn (prec: int) -> fn (pset: bool) -> fn (pos: int) ->
  let n = str_len fmt in
  if i >= n then (let _ = prim_raise "ArgumentError" "incomplete format specifier; use %% (double %) instead" in ("", i, nextarg, mode))
  else
    let c = char_at fmt i in
    if str_eq c "-" || str_eq c "+" || str_eq c " " || str_eq c "#" || str_eq c "0" then
      rb_fmt_dir env world fmt (i + 1) args nextarg mode (flags ++ c) width wset prec pset pos
    else if is_digit c then
      let (k, j) = rb_fmt_digits fmt i 0 false in
      (if j < n && str_eq (char_at fmt j) "$" then
         (if pos > 0 then (let _ = prim_raise "ArgumentError" ("value given twice - " ++ int_to_base k 10 ++ "$") in ("", j, nextarg, mode))
          else if k <= 0 then (let _ = prim_raise "ArgumentError" "invalid index - 0$" in ("", j, nextarg, mode))
          else if mode == 1 || mode == 3 then (let _ = prim_raise "ArgumentError" ("numbered(" ++ int_to_base k 10 ++ "$) after unnumbered(%)") in ("", j, nextarg, mode))
          else rb_fmt_dir env world fmt (j + 1) args nextarg 2 flags width wset prec pset k)
       else if wset then (let _ = prim_raise "ArgumentError" "width given twice" in ("", j, nextarg, mode))
       else rb_fmt_dir env world fmt j args nextarg mode flags k true prec pset pos)
    else if str_eq c "*" then
      (if wset then (let _ = prim_raise "ArgumentError" "width given twice" in ("", i, nextarg, mode))
       else
         let (w, j, na2, m2) = rb_fmt_star env world fmt (i + 1) args nextarg mode in
         (if w < 0 then rb_fmt_dir env world fmt j args na2 m2 (flags ++ "-") (0 - w) true prec pset pos
          else rb_fmt_dir env world fmt j args na2 m2 flags w true prec pset pos))
    else if str_eq c "." then
      (if pset then (let _ = prim_raise "ArgumentError" "precision given twice" in ("", i, nextarg, mode))
       else if i + 1 < n && str_eq (char_at fmt (i + 1)) "*" then
         let (p, j, na2, m2) = rb_fmt_star env world fmt (i + 2) args nextarg mode in
         rb_fmt_dir env world fmt j args na2 m2 flags width wset (if p < 0 then 0 - 1 else p) true pos
       else
         let (p, j) = rb_fmt_digits fmt (i + 1) 0 false in
         // a precision that cannot fit an int is ruby's own refusal (the
         // accumulated value has already wrapped, so measure the DIGITS).
         let _ = (if j - (i + 1) > 9 then (let _ = prim_raise "ArgumentError" "prec too big" in ()) else ()) in
         rb_fmt_dir env world fmt j args nextarg mode flags width wset (if p < 0 then 0 else p) true pos)
    else if rb_fmt_is_type c then
      let (av, na2, m2) =
        (if pos > 0 then (rb_fmt_posarg args pos, nextarg, mode)
         else if mode == 2 || mode == 3 then (let _ = prim_raise "ArgumentError" ("unnumbered(" ++ int_to_base (nextarg + 1) 10 ++ ") mixed with numbered") in (VNil, nextarg, mode))
         else if nextarg >= val_list_len args then (let _ = prim_raise "ArgumentError" "too few arguments" in (VNil, nextarg, mode))
         else (val_nth args nextarg, nextarg + 1, 1)) in
      (rb_fmt_one env world flags width prec pset c av, i + 1, na2, m2)
    else (let _ = prim_raise "ArgumentError" ("malformed format string - %" ++ c) in ("", i + 1, nextarg, mode))


// `*` reads its number from the arguments: a bare `*` takes the next
// sequential argument, `*3$` a numbered one. Digits NOT followed by '$' are
// left unconsumed -- ruby re-reads them after the star, so `%*5s` is a
// width-given-twice error, not width 5.
and rb_fmt_star = fn env -> fn world -> fn (fmt: str) -> fn (i: int) -> fn (args: Val list) -> fn (nextarg: int) -> fn (mode: int) ->
  let n = str_len fmt in
  let (k, j) = rb_fmt_digits fmt i 0 false in
  if k >= 0 && j < n && str_eq (char_at fmt j) "$" then
    (if k <= 0 then (let _ = prim_raise "ArgumentError" "invalid index - 0$" in (0, j + 1, nextarg, mode))
     else if mode == 1 || mode == 3 then (let _ = prim_raise "ArgumentError" ("numbered(" ++ int_to_base k 10 ++ "$) after unnumbered(%)") in (0, j + 1, nextarg, mode))
     else (rb_fmt_int env world (rb_fmt_posarg args k), j + 1, nextarg, 2))
  else
    (if mode == 2 || mode == 3 then (let _ = prim_raise "ArgumentError" ("unnumbered(" ++ int_to_base (nextarg + 1) 10 ++ ") mixed with numbered") in (0, i, nextarg, mode))
     else if nextarg >= val_list_len args then (let _ = prim_raise "ArgumentError" "too few arguments" in (0, i, nextarg, mode))
     else (rb_fmt_int env world (val_nth args nextarg), i, nextarg + 1, 1))


// the encoding of a format's result: the format string's, negotiated with
// every String argument's (an incompatible pair raises, as concat would).

// `"fmt" % arg`: an Array (or anything answering #to_ary, nil result meaning
// "no, wrap me") is the whole argument list; any other value is one argument.
and rb_fmt_args = fn env -> fn world -> fn (vb: Val) ->
  match vb with
  | VArr id -> deref id
  | VObj _ ->
    (if responds world vb "to_ary" then
       (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
        match invoke_val_c env world nb vb "to_ary" Nil false with
        | VArr id -> deref id
        | VNil -> Cons (vb, Nil)
        | other -> (let _ = prim_raise "TypeError" ("can't convert " ++ class_name vb ++ " to Array (" ++ class_name vb ++ "#to_ary gives " ++ class_name other ++ ")") in Cons (vb, Nil)))
     else Cons (vb, Nil))
  | _ -> Cons (vb, Nil)

// the name inside %{...} / %<...>, and the index just past its closing brace.

// a named reference reads the (single) hash argument; an absent key is a
// KeyError, exactly as in ruby -- silently formatting nil would turn a typo
// into a plausible wrong string.


// Kernel#Integer's coercion, as sprintf applies it to %d/%i/%u arguments and
// to star width/precision: Integers pass, a Float must be finite and
// truncates, a String parses by Integer()'s strict syntax, and an object is
// asked for #to_int then #to_i -- a nil answer from either means "declined",
// not zero (the mspec mocks answer nil for everything they were not told).
and rb_fmt_int_v = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VInt x -> VInt x
  | VBig s -> VBig s
  | VFlt f ->
    (if str_len (float_special f) > 0 then (let _ = prim_raise "FloatDomainError" (float_domain_msg f) in VNil) else VInt (int_of_float f))
  | VNil -> (let _ = prim_raise "TypeError" "can't convert nil into Integer" in VNil)
  | VStr h -> rb_int_parse (sget h)
  | _ ->
    let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
    let ti = (if responds world v "to_int" then invoke_val_c env world nb v "to_int" Nil false else VNil) in
    (match ti with
     | VInt x -> VInt x
     | VBig s -> VBig s
     | _ ->
       let ti2 = (if responds world v "to_i" then invoke_val_c env world nb v "to_i" Nil false else VNil) in
       (match ti2 with
        | VInt x -> VInt x
        | VBig s -> VBig s
        | _ -> (let _ = prim_raise "TypeError" ("can't convert " ++ class_name v ++ " into Integer") in VNil)))

and rb_fmt_int = fn env -> fn world -> fn (v: Val) ->
  match rb_fmt_int_v env world v with
  | VInt x -> x
  | VBig s -> int_of_str s
  | _ -> 0

// Kernel#Integer's string syntax: optional surrounding whitespace, optional
// sign, an optional base prefix (0x 0b 0o 0d, or a bare leading 0 meaning
// octal), then digits of that base with single underscores strictly BETWEEN
// digits. Anything else is an ArgumentError, never a zero.
// Kernel#Integer / Kernel#Float. Both take a trailing `exception:` keyword and
// both walk a conversion protocol before they parse anything; the value arms
// used to be a five-line match that truncated bignums, ignored #to_int and
// #to_str, and read a based string with the lax str_to_int_base.

// the trailing hash is the keyword hash only when it actually carries
// `exception:` -- `Integer(h)` must stay a (refused) positional argument.

// how ruby names a value inside "... gives X": the three singletons by their
// literal, everything else by its class.

// The seven Kernel conversion functions, in ONE place: they are reached both
// as implicit-self calls (`Integer("1")`) and, being private instance methods
// of Object, through send (`obj.send(:Float, "20e_")`, which ruby/spec uses).
// A second copy for the send path would be a second set of answers.

// Kernel#initialize_copy / #initialize_dup / #initialize_clone. They are real
// methods on EVERY object -- `1.send(:initialize_copy, x)` is a FrozenError,
// not a NoMethodError -- and they are also what `super` from an override of
// one has to land on, which is the documented way to write one
// (`def initialize_clone(other, **kw); super(other); end`). One body, both
// callers: a second copy for the super path would be a second set of answers.
and kernel_copy_hook = fn env -> fn world -> fn (recv: Val) -> fn (name: str) -> fn (args: Val list) ->
  let noblk9 = (false, (Nil : str list), (Nil : Stmt list), env) in
  let other9 = (match args with Cons (o9, _) -> o9 | Nil -> VNil) in
  // the object's own class, not its singleton: ruby compares rb_obj_class.
  let rcls9 = fn (v9: Val) ->
    (let c9 = dispatch_cls_of world v9 in
     let (_, sup9, _, _) = world in
     if is_sng_cls c9 && map_has sup9 c9 then map_get sup9 c9 else c9) in
  if str_eq name "initialize_copy" then
    // copying a thing onto ITSELF asks nothing of it -- not even that it be
    // unfrozen, which is why the frozen check comes second.
    (if rb_identical recv other9 then recv
     else if val_is_frozen recv
     then raise_exc world "FrozenError"
            ("can't modify frozen " ++ display_cls_msg world (rcls9 recv) ++ ": " ++ inspect recv)
     else if (if str_eq (rcls9 recv) (rcls9 other9) then false else true)
     then raise_exc world "TypeError" "initialize_copy should take same class object"
     else recv)
  else
    (let _ = invoke_val_c env world noblk9 recv "initialize_copy" (Cons (other9, Nil)) false in recv)

and kernel_conv_fn = fn env -> fn world -> fn (name: str) -> fn (args: Val list) ->
    if str_eq name "Integer" then kernel_integer env world args
    else if str_eq name "Float" then kernel_float env world args
    // Kernel#String(obj): #to_str first, then #to_s -- and an object that
    // answers NEITHER with a String is a TypeError, not its inspect text.
    // (`to_s v` printed `#<object>` for every object with a user to_s.)
    else if str_eq name "String" then
      (match args with
       | Cons (VStr h9, _) -> VStr h9
       | Cons (v, _) ->
         (match conv_try env world v "to_str" with
          | VStr r9 -> VStr r9
          | _ ->
            (let r8 = conv_try env world v "to_s" in
             match r8 with
             | VStr r9 -> VStr r9
             | VNil -> (match v with
                        | VObj _ -> raise_exc world "TypeError"
                                      ("can't convert " ++ class_name v ++ " into String")
                        | _ -> mkstr (to_s v))
             | other -> raise_exc world "TypeError"
                          ("can't convert " ++ class_name v ++ " to String ("
                           ++ class_name v ++ "#to_s gives " ++ class_name other ++ ")")))
       | _ -> mkstr "")
    else if str_eq name "Rational" then kernel_rational env world args
    else if str_eq name "Complex" then kernel_complex env world args
    // Kernel#Array(obj): #to_ary, then #to_a, then a one-element array. Both
    // conversions are asked even when PRIVATE (ruby's rb_check_funcall does),
    // and a nil answer from either is a decline rather than the result.
    else if str_eq name "Array" then
      (match args with
       | Cons (VArr id, _) -> VArr id
       | Cons (VNil, _) -> arr_new (Nil : Val list)
       | Nil -> arr_new (Nil : Val list)
       | Cons (v, _) ->
         (let r9 = conv_try env world v "to_ary" in
          match r9 with
          | VArr a9 -> VArr a9
          // a conversion that answers a NON-array (and not nil, which declines)
          // is the object lying about its type.
          | VNil ->
            (let r8 = conv_try env world v "to_a" in
             match r8 with
             | VArr a9 -> VArr a9
             | VNil -> arr_new (Cons (v, Nil))
             | other -> raise_exc world "TypeError"
                          ("can't convert " ++ class_name v ++ " to Array ("
                           ++ class_name v ++ "#to_a gives " ++ class_name other ++ ")"))
          | other -> raise_exc world "TypeError"
                       ("can't convert " ++ class_name v ++ " to Array ("
                        ++ class_name v ++ "#to_ary gives " ++ class_name other ++ ")")))
    // Kernel#Hash(obj): #to_hash; nil and [] are the empty hash; anything else
    // is a TypeError (it answered {} for everything).
    else if str_eq name "Hash" then
      (match args with
       | Cons (VHsh h, _) -> VHsh h
       | Cons (VNil, _) -> mkhash (Nil : Val list)
       | Cons (VArr a9, _) ->
         (match deref a9 with
          | Nil -> mkhash (Nil : Val list)
          | _ -> raise_exc world "TypeError" "can't convert Array into Hash")
       | Cons (v, _) ->
         (match conv_try env world v "to_hash" with
          | VHsh h9 -> VHsh h9
          | _ -> raise_exc world "TypeError"
                   ("can't convert " ++ class_name v ++ " into Hash"))
       | Nil -> mkhash (Nil : Val list))
    else VNil

// Kernel#Rational, following ruby's nurat_convert: a Complex with an exact
// zero imaginary part IS its real part, a String is read STRICTLY (String#to_r
// reads a prefix; this refuses what it cannot read to the end), an object with
// no #to_r gets one chance at #to_int, and only then does the pair have to be
// two integers. The old arm was `rat_parts` on both arguments, which answered
// (0/1) for everything it did not understand -- including nil, [] and :sym.
// Kernel#Complex, following ruby's nucomp_convert. The old arm was
// `VCpx (a, b)` with no conversion at all, so Complex(Complex(3,4), Complex(5,6))
// nested complexes inside a complex and Complex("ruby") became the string
// itself as a real part.
and kernel_complex = fn env -> fn world -> fn (args0: Val list) ->
  let (pos, raising) = kern_conv_kw args0 in
  let has2 = (match pos with Cons (_, Cons (_, _)) -> true | _ -> false) in
  let a1 = (match pos with Cons (a, _) -> a | Nil -> VNil) in
  let a2 = (match pos with Cons (_, Cons (b, _)) -> b | _ -> VNil) in
  // as in Rational: `exception: false` answers for the nil check, the string
  // reading, the single-argument #to_c and a second argument that is not a
  // real -- and NOT for nucomp_real_check, so Complex(:sym, 0, exception:
  // false) is still a TypeError.
  kernel_complex_go env world a1 a2 has2 raising

// ruby's f_real_p: every Numeric but Complex says yes, and a user Numeric is
// ASKED (the specs build mocks whose #real? decides which shape comes back).
and kern_real_p = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VInt _ -> true | VBig _ -> true | VFlt _ -> true | VRat (_, _) -> true
  | VCpx (_, _) -> false
  | other -> (if responds world other "real?" then
                (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
                 truthy (invoke_val_c env world nb other "real?" Nil false))
              else false)

// + and * on a value that may be a user Numeric: arith_bin knows the built-in
// tower only, and the two-argument form is defined as n1 + n2 * (0+1i).
and kern_num_op = fn env -> fn world -> fn (op: str) -> fn (a: Val) -> fn (b: Val) ->
  match a with
  | VObj _ -> (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
               invoke_val_c env world nb a op (Cons (b, Nil)) false)
  | _ -> arith_bin op a b

and kern_to_complex = fn env -> fn world -> fn (v: Val) ->
  if responds world v "to_c" then
    (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
     match invoke_val_c env world nb v "to_c" Nil false with
     | VCpx (r, i) -> VCpx (r, i)
     | bad -> (let _ = prim_raise "TypeError"
                 ("can't convert " ++ class_name v ++ " to Complex ("
                  ++ class_name v ++ "#to_c gives " ++ conv_gives_name bad ++ ")") in VNil))
  else (let _ = prim_raise "TypeError"
          ("can't convert " ++ conv_gives_name v ++ " into Complex") in VNil)

// ruby's nucomp_real_check: only Integer, Float and Rational are real parts.
and kern_real_check = fn env -> fn world -> fn (v: Val) ->
  match v with
  | VInt _ -> v | VBig _ -> v | VFlt _ -> v | VRat (_, _) -> v
  | VCpx (re, im) -> (if exact_zero_val im then re
                      else (let _ = prim_raise "TypeError" "not a real" in VInt 0))
  | other -> (if kern_is_numeric world other && kern_real_p env world other then other
              else (let _ = prim_raise "TypeError" "not a real" in VInt 0))

// a String argument, read to the END and refused otherwise. The encoding and
// the null byte are their own refusals, before the reading.

and kernel_complex_go = fn env -> fn world -> fn (a10: Val) -> fn (a20: Val) -> fn (has2: bool) -> fn (raising: bool) ->
  if (match a10 with VNil -> true | _ -> false)
     || (has2 && (match a20 with VNil -> true | _ -> false))
  then (if raising
        then (let _ = prim_raise "TypeError" "can't convert nil into Complex" in VNil)
        else VNil)
  else
    let b1 = (match a10 with VStr h -> kern_cpx_str world h raising | other -> other) in
    let b2 = (if has2 then (match a20 with VStr h -> kern_cpx_str world h raising | other -> other) else VNil) in
    if (match b1 with VNil -> true | _ -> false) || (has2 && (match b2 with VNil -> true | _ -> false))
    then VNil
    else
    let c1 = kern_unwrap_cpx b1 in
    let c2 = (if has2 then kern_unwrap_cpx b2 else b2) in
    // a Complex first argument with no (or an exactly zero) second argument is
    // already the answer.
    if (match c1 with VCpx (_, _) -> true | _ -> false)
       && ((if has2 then false else true) || exact_zero_val c2)
    then c1
    else if (if has2 then false else true) then
      (if kern_is_numeric world c1 && (if kern_real_p env world c1 then false else true) then c1
       else if kern_is_numeric world c1 then VCpx (kern_real_check env world c1, VInt 0)
       else if raising then kern_to_complex env world c1
       else conv_protect world (fn (u: unit) -> kern_to_complex env world c1))
    else
      (if kern_is_numeric world c1 && kern_is_numeric world c2
          && ((if kern_real_p env world c1 then false else true)
              || (if kern_real_p env world c2 then false else true))
       then kern_num_op env world "+" c1 (kern_num_op env world "*" c2 (VCpx (VInt 0, VInt 1)))
       // a second argument that is not one of the three real types is a plain
       // decline under `exception: false` -- but the FIRST one still gets
       // nucomp_real_check, and its TypeError is not swallowed.
       else if (if raising then false else true)
               && (match c2 with VInt _ -> false | VBig _ -> false | VFlt _ -> false | VRat (_, _) -> false | _ -> true)
       then VNil
       else VCpx (kern_real_check env world c1, kern_real_check env world c2))

and kernel_rational = fn env -> fn world -> fn (args0: Val list) ->
  let (pos, raising) = kern_conv_kw args0 in
  let has2 = (match pos with Cons (_, Cons (_, _)) -> true | _ -> false) in
  let a1 = (match pos with Cons (a, _) -> a | Nil -> VNil) in
  let a2 = (match pos with Cons (_, Cons (b, _)) -> b | _ -> VNil) in
  // `exception: false` is NOT "swallow whatever happens": ruby protects the nil
  // check, the string reading and the #to_r conversion, and leaves the rest to
  // raise -- Rational(1, 0, exception: false) is still a ZeroDivisionError. So
  // the flag is carried down to the places that answer to it rather than
  // wrapped around the whole conversion.
  kernel_rational_go env world a1 a2 has2 raising

// ruby's rb_protect around a conversion: run it, and on an exception answer
// nil instead of unwinding. The caught exception must leave NOTHING behind --
// not the pending message, not $!, not the world's "$exc" slot -- or the next
// real failure is reported as that one (a TypeError came out as an empty
// RuntimeError until $exc was restored too).

// an exception that unwound into a no-exception conversion must not leave its
// message behind: the next real failure would be reported as that one.




// one argument of Rational(), reduced as far as its own type allows.
// VNil is the refusal here: no argument that reaches this is nil already.
and kern_rat_side = fn env -> fn world -> fn (v: Val) -> fn (raising: bool) ->
  match v with
  | VInt n -> VInt n
  | VBig b -> VBig b
  | VFlt f -> (match flt_rat_parts f 0 with (n, d) -> mk_rat_s n d)
  | VRat (n, d) -> VRat (n, d)
  | VStr h ->
    (match rb_str_to_r_x (sget h) with
     | (r, true) -> r
     | (_, _) -> (if raising
                  then (let _ = prim_raise "ArgumentError"
                          ("invalid value for convert(): " ++ inspect (VStr h)) in VNil)
                  else VNil))
  // #to_int is asked ONLY of something with no #to_r (ruby's order).
  | other ->
    (if responds world other "to_r" then other
     else (match conv_protect world (fn (u: unit) -> conv_try env world other "to_int") with
           | VInt n -> VInt n
           | VBig b -> VBig b
           | _ -> other))

// ruby's to_rational: #to_r, raising when there is none and when it answers
// something that is not a Rational.
and kern_to_rational = fn env -> fn world -> fn (v: Val) ->
  if responds world v "to_r" then
    (let nb = (false, (Nil : str list), (Nil : Stmt list), env) in
