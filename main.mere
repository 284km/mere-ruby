    "\n" ++
    "  def isatty\n" ++
    "    false\n" ++
    "  end\n" ++
    "\n" ++
    "  def fileno\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def inspect\n" ++
    "    \"#<StringIO>\"\n" ++
    "  end\n" ++
