     | _ -> (let _ = map_set prim_missing "n" (mkstr "codepoints") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'codepoints'")) in fail "mere-ruby: undefined method 'codepoints'")))
  else if str_eq name "hex" && (match recv with VStr _ -> true | _ -> false) then (match recv with VStr s -> VInt (radix_parse (sget s) 16 false) | _ -> (let _ = map_set prim_missing "n" (mkstr "hex") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'hex'")) in fail "mere-ruby: undefined method 'hex'")))
  else if str_eq name "oct" && (match recv with VStr _ -> true | _ -> false) then (match recv with VStr s -> VInt (radix_parse (sget s) 8 true) | _ -> (let _ = map_set prim_missing "n" (mkstr "oct") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'oct'")) in fail "mere-ruby: undefined method 'oct'")))
  else if str_eq name "sum" && (match recv with VStr _ -> true | _ -> false) then
