        // character's bytes, big-endian. So no character table is needed --
        // only the structural question "are these bytes one character in e",
        // which enc_clen1 answers. Which of the two refusals applies is decided
        // by the encoding's WIDTH: a number that cannot fit in a character of e
        // is out of char range, one that fits but is malformed is an invalid
        // codepoint. (ruby: 0x818181 in Shift_JIS is "out of char range" --
        // three bytes, and Shift_JIS characters are at most two -- while
        // 0xFFFFFF in EUC-JP, which IS three bytes wide, is "invalid
        // codepoint".)
        else if enc_max_clen given > 0 then
          (let w9 = enc_max_clen given in
           let lim9 = (let rec pow9 = fn (k: int) -> (if k <= 0 then 1 else 256 * pow9 (k - 1)) in pow9 w9) in
           if n < 0 || n >= lim9 then prim_raise "RangeError" (str_of_int n ++ " out of char range")
