    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  def truncate(len)\n" ++
    "    @string = @string[0, len] || \"\"\n" ++
    "    0\n" ++
    "  end\n" ++
    "\n" ++
    "  def flush\n" ++
