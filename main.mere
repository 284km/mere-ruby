        | Nil -> mkstr (str_squeeze s "" false)
        | _ ->
          // every argument is a set; ruby intersects them all (and refuses a
          // non-String or a set with bytes invalid in its encoding).
          mkstr (str_squeeze_sets s (str_set_args args)))
     | _ -> (let _ = map_set prim_missing "n" (mkstr "squeeze") in (let _ = (if map_has prim_missing "i" then () else map_set prim_missing "i" (mkstr "mere-ruby: undefined method 'squeeze'")) in fail "mere-ruby: undefined method 'squeeze'")))
  else if str_eq name "ljust" || str_eq name "rjust" || str_eq name "center" then
