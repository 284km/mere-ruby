    "  end\n" ++
    "end\n" ++
    "\n" ++
    "##\n" ++
    "# A concrete implementation of Delegator, this class provides the means to\n" ++
    "# delegate all supported method calls to the object passed into the constructor\n" ++
    "# and even to change the object being delegated to at a later time with\n" ++
    "# #__setobj__.\n" ++
    "#\n" ++
    "#   class User\n" ++
    "#     def born_on\n" ++
    "#       Date.new(1989, 9, 10)\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "#   require 'delegate'\n" ++
    "#\n" ++
    "#   class UserDecorator < SimpleDelegator\n" ++
    "#     def birth_year\n" ++
    "#       born_on.year\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "#   decorated_user = UserDecorator.new(User.new)\n" ++
    "#   decorated_user.birth_year  #=> 1989\n" ++
    "#   decorated_user.__getobj__  #=> #<User: ...>\n" ++
    "#\n" ++
    "# A SimpleDelegator instance can take advantage of the fact that SimpleDelegator\n" ++
    "# is a subclass of +Delegator+ to call <tt>super</tt> to have methods called on\n" ++
    "# the object being delegated to.\n" ++
    "#\n" ++
    "#   class SuperArray < SimpleDelegator\n" ++
    "#     def [](*args)\n" ++
    "#       super + 1\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "#   SuperArray.new([1])[0]  #=> 2\n" ++
    "#\n" ++
    "# Here's a simple example that takes advantage of the fact that\n" ++
    "# SimpleDelegator's delegation object can be changed at any time.\n" ++
    "#\n" ++
    "#   class Stats\n" ++
    "#     def initialize\n" ++
    "#       @source = SimpleDelegator.new([])\n" ++
    "#     end\n" ++
    "#\n" ++
    "#     def stats(records)\n" ++
    "#       @source.__setobj__(records)\n" ++
    "#\n" ++
    "#       \"Elements:  #\{@source.size\}\\n\" +\n" ++
    "#       \" Non-Nil:  #\{@source.compact.size\}\\n\" +\n" ++
    "#       \"  Unique:  #\{@source.uniq.size\}\\n\"\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "#   s = Stats.new\n" ++
    "#   puts s.stats(%w\{James Edward Gray II\})\n" ++
    "#   puts\n" ++
    "#   puts s.stats([1, 2, 3, nil, 4, 5, 1, 2])\n" ++
    "#\n" ++
    "# Prints:\n" ++
    "#\n" ++
    "#   Elements:  4\n" ++
    "#    Non-Nil:  4\n" ++
    "#     Unique:  4\n" ++
    "#\n" ++
    "#   Elements:  8\n" ++
    "#    Non-Nil:  7\n" ++
    "#     Unique:  6\n" ++
    "#\n" ++
    "class SimpleDelegator < Delegator\n" ++
    "  # Returns the current object method calls are being delegated to.\n" ++
    "  def __getobj__\n" ++
    "    unless defined?(@delegate_sd_obj)\n" ++
    "      return yield if block_given?\n" ++
    "      __raise__ ::ArgumentError, \"not delegated\"\n" ++
    "    end\n" ++
    "    @delegate_sd_obj\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Changes the delegate object to _obj_.\n" ++
    "  #\n" ++
    "  # It's important to note that this does *not* cause SimpleDelegator's methods\n" ++
    "  # to change.  Because of this, you probably only want to change delegation\n" ++
    "  # to objects of the same type as the original delegate.\n" ++
    "  #\n" ++
    "  # Here's an example of changing the delegation object.\n" ++
    "  #\n" ++
    "  #   names = SimpleDelegator.new(%w\{James Edward Gray II\})\n" ++
    "  #   puts names[1]    # => Edward\n" ++
    "  #   names.__setobj__(%w\{Gavin Sinclair\})\n" ++
    "  #   puts names[1]    # => Sinclair\n" ++
    "  #\n" ++
    "  def __setobj__(obj)\n" ++
    "    __raise__ ::ArgumentError, \"cannot delegate to self\" if self.equal?(obj)\n" ++
    "    @delegate_sd_obj = obj\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "def Delegator.delegating_block(mid) # :nodoc:\n" ++
    "  lambda do |*args, &block|\n" ++
    "    target = self.__getobj__\n" ++
    "    target.__send__(mid, *args, &block)\n" ++
    "  end.ruby2_keywords\n" ++
    "end\n" ++
    "\n" ++
    "#\n" ++
    "# The primary interface to this library.  Use to setup delegation when defining\n" ++
    "# your class.\n" ++
    "#\n" ++
    "#   class MyClass < DelegateClass(ClassToDelegateTo) # Step 1\n" ++
    "#     def initialize\n" ++
    "#       super(obj_of_ClassToDelegateTo)              # Step 2\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "# or:\n" ++
    "#\n" ++
    "#   MyClass = DelegateClass(ClassToDelegateTo) do    # Step 1\n" ++
    "#     def initialize\n" ++
    "#       super(obj_of_ClassToDelegateTo)              # Step 2\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "# Here's a sample of use from Tempfile which is really a File object with a\n" ++
    "# few special rules about storage location and when the File should be\n" ++
    "# deleted.  That makes for an almost textbook perfect example of how to use\n" ++
    "# delegation.\n" ++
    "#\n" ++
    "#   class Tempfile < DelegateClass(File)\n" ++
    "#     # constant and class member data initialization...\n" ++
    "#\n" ++
    "#     def initialize(basename, tmpdir=Dir::tmpdir)\n" ++
    "#       # build up file path/name in var tmpname...\n" ++
    "#\n" ++
    "#       @tmpfile = File.open(tmpname, File::RDWR|File::CREAT|File::EXCL, 0600)\n" ++
    "#\n" ++
    "#       # ...\n" ++
    "#\n" ++
    "#       super(@tmpfile)\n" ++
    "#\n" ++
    "#       # below this point, all methods of File are supported...\n" ++
    "#     end\n" ++
    "#\n" ++
    "#     # ...\n" ++
    "#   end\n" ++
    "#\n" ++
    "def DelegateClass(superclass, &block)\n" ++
    "  klass = Class.new(Delegator)\n" ++
    "  ignores = [*::Delegator.public_api, :to_s, :inspect, :=~, :!~, :===]\n" ++
    "  protected_instance_methods = superclass.protected_instance_methods\n" ++
    "  protected_instance_methods -= ignores\n" ++
    "  public_instance_methods = superclass.public_instance_methods\n" ++
    "  public_instance_methods -= ignores\n" ++
    "\n" ++
    "  normal, special = public_instance_methods.partition \{ |m| m.match?(/\\A[a-zA-Z]\\w*[!\\?]?\\z/) \}\n" ++
    "\n" ++
    "  source = normal.map do |method|\n" ++
    "    \"def #\{method\}(...); __getobj__.#\{method\}(...); end\"\n" ++
    "  end\n" ++
    "\n" ++
    "  protected_instance_methods.each do |method|\n" ++
    "    source << \"def #\{method\}(...); __getobj__.__send__(#\{method.inspect\}, ...); end\"\n" ++
    "  end\n" ++
    "\n" ++
    "  klass.module_eval do\n" ++
    "    def __getobj__ # :nodoc:\n" ++
    "      unless defined?(@delegate_dc_obj)\n" ++
    "        return yield if block_given?\n" ++
    "        __raise__ ::ArgumentError, \"not delegated\"\n" ++
    "      end\n" ++
    "      @delegate_dc_obj\n" ++
    "    end\n" ++
    "\n" ++
    "    def __setobj__(obj)  # :nodoc:\n" ++
    "      __raise__ ::ArgumentError, \"cannot delegate to self\" if self.equal?(obj)\n" ++
    "      @delegate_dc_obj = obj\n" ++
    "    end\n" ++
    "\n" ++
    "    class_eval(source.join(\";\"), __FILE__, __LINE__)\n" ++
    "\n" ++
    "    special.each do |method|\n" ++
    "      define_method(method, Delegator.delegating_block(method))\n" ++
    "    end\n" ++
    "\n" ++
    "    protected(*protected_instance_methods)\n" ++
    "  end\n" ++
    "\n" ++
    "  klass.define_singleton_method :public_instance_methods do |all=true|\n" ++
    "    super(all) | superclass.public_instance_methods\n" ++
    "  end\n" ++
    "  klass.define_singleton_method :protected_instance_methods do |all=true|\n" ++
    "    super(all) | superclass.protected_instance_methods\n" ++
    "  end\n" ++
    "  klass.define_singleton_method :instance_methods do |all=true|\n" ++
    "    super(all) | superclass.instance_methods\n" ++
    "  end\n" ++
    "  klass.define_singleton_method :public_instance_method do |name|\n" ++
    "    super(name)\n" ++
    "  rescue NameError\n" ++
    "    raise unless self.public_instance_methods.include?(name)\n" ++
    "    superclass.public_instance_method(name)\n" ++
    "  end\n" ++
    "  klass.define_singleton_method :instance_method do |name|\n" ++
    "    super(name)\n" ++
    "  rescue NameError\n" ++
    "    raise unless self.instance_methods.include?(name)\n" ++
    "    superclass.instance_method(name)\n" ++
    "  end\n" ++
    "  klass.module_eval(&block) if block\n" ++
    "  return klass\n" ++
    "end\n"
  else "";
