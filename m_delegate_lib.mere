    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Serialization support for the object returned by +__getobj__+.\n" ++
    "  #\n" ++
    "  def marshal_dump\n" ++
    "    ivars = instance_variables.reject \{|var| /\\A@delegate_/ =~ var\}\n" ++
    "    [\n" ++
    "      :__v2__,\n" ++
    "      ivars, ivars.map \{|var| instance_variable_get(var)\},\n" ++
    "      __getobj__\n" ++
    "    ]\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Reinitializes delegation from a serialized object.\n" ++
    "  #\n" ++
    "  def marshal_load(data)\n" ++
    "    version, vars, values, obj = data\n" ++
    "    if version == :__v2__\n" ++
    "      vars.each_with_index \{|var, i| instance_variable_set(var, values[i])\}\n" ++
    "      __setobj__(obj)\n" ++
    "    else\n" ++
    "      __setobj__(data)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  def initialize_clone(obj, freeze: nil) # :nodoc:\n" ++
    "    self.__setobj__(obj.__getobj__.clone(freeze: freeze))\n" ++
    "  end\n" ++
    "  def initialize_dup(obj) # :nodoc:\n" ++
    "    self.__setobj__(obj.__getobj__.dup)\n" ++
    "  end\n" ++
    "  private :initialize_clone, :initialize_dup\n" ++
    "\n" ++
    "  ##\n" ++
    "  # :method: freeze\n" ++
    "  # Freeze both the object returned by +__getobj__+ and self.\n" ++
    "  #\n" ++
    "  def freeze\n" ++
    "    __getobj__.freeze\n" ++
    "    super()\n" ++
    "  end\n" ++
    "\n" ++
    "  @delegator_api = self.public_instance_methods\n" ++
    "  def self.public_api # :nodoc:\n" ++
