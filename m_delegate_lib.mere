    "  def !=(obj)\n" ++
    "    return false if obj.equal?(self)\n" ++
    "    __getobj__ != obj\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Returns true if two objects are considered of equal value.\n" ++
    "  #\n" ++
    "  def eql?(obj)\n" ++
    "    return true if obj.equal?(self)\n" ++
    "    obj.eql?(__getobj__)\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Delegates ! to the +__getobj__+\n" ++
    "  #\n" ++
    "  def !\n" ++
    "    !__getobj__\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
