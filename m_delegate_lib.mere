    "##\n" ++
    "# This library provides three different ways to delegate method calls to an\n" ++
    "# object.  The easiest to use is SimpleDelegator.  Pass an object to the\n" ++
    "# constructor and all methods supported by the object will be delegated.  This\n" ++
    "# object can be changed later.\n" ++
    "#\n" ++
