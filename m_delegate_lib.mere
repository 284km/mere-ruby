    "# from the abstract class Delegator and customize as needed.  (If you find\n" ++
    "# yourself needing this control, have a look at Forwardable which is also in\n" ++
    "# the standard library.  It may suit your needs better.)\n" ++
    "#\n" ++
    "# SimpleDelegator's implementation serves as a nice example of the use of\n" ++
