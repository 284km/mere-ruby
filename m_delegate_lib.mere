    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Returns the methods available to this delegate object as the union\n" ++
    "  # of this object's and +__getobj__+ methods.\n" ++
    "  #\n" ++
    "  def methods(all=true)\n" ++
    "    __getobj__.methods(all) | super\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Returns the methods available to this delegate object as the union\n" ++
    "  # of this object's and +__getobj__+ public methods.\n" ++
    "  #\n" ++
    "  def public_methods(all=true)\n" ++
    "    __getobj__.public_methods(all) | super\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Returns the methods available to this delegate object as the union\n" ++
    "  # of this object's and +__getobj__+ protected methods.\n" ++
    "  #\n" ++
    "  def protected_methods(all=true)\n" ++
    "    __getobj__.protected_methods(all) | super\n" ++
    "  end\n" ++
    "\n" ++
    "  # Note: no need to specialize private_methods, since they are not forwarded\n" ++
    "\n" ++
    "  #\n" ++
    "  # Returns true if two objects are considered of equal value.\n" ++
    "  #\n" ++
    "  def ==(obj)\n" ++
    "    return true if obj.equal?(self)\n" ++
    "    self.__getobj__ == obj\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
