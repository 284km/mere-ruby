    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Handles the magic of delegation through +__getobj__+.\n" ++
    "  #\n" ++
    "  ruby2_keywords def method_missing(m, *args, &block)\n" ++
    "    r = true\n" ++
    "    target = self.__getobj__ \{r = false\}\n" ++
    "\n" ++
    "    if r && target_respond_to?(target, m, false)\n" ++
    "      target.__send__(m, *args, &block)\n" ++
    "    elsif ::Kernel.method_defined?(m) || ::Kernel.private_method_defined?(m)\n" ++
    "      ::Kernel.instance_method(m).bind_call(self, *args, &block)\n" ++
    "    else\n" ++
    "      super(m, *args, &block)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  #\n" ++
    "  # Checks for a method provided by this the delegate object by forwarding the\n" ++
    "  # call through +__getobj__+.\n" ++
    "  #\n" ++
    "  def respond_to_missing?(m, include_private)\n" ++
    "    r = true\n" ++
    "    target = self.__getobj__ \{r = false\}\n" ++
    "    r &&= target_respond_to?(target, m, include_private)\n" ++
    "    if r && include_private && !target_respond_to?(target, m, false)\n" ++
    "      warn \"delegator does not forward private method \\##\{m\}\", uplevel: 3\n" ++
    "      return false\n" ++
    "    end\n" ++
    "    r\n" ++
    "  end\n" ++
    "\n" ++
    "  KERNEL_RESPOND_TO = ::Kernel.instance_method(:respond_to?) # :nodoc:\n" ++
    "  private_constant :KERNEL_RESPOND_TO\n" ++
    "\n" ++
    "  # Handle BasicObject instances\n" ++
    "  private def target_respond_to?(target, m, include_private)\n" ++
    "    case target\n" ++
    "    when Object\n" ++
