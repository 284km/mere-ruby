// The native ISeq compiler's front end (note 552 §11): prism_compile.c's
// instructions for each node, as lib/iseq_compiler_ext.rb ports them --
// that file's `node` and the functions it hands a node to, in its order.
//
// What is not here yet is refused by name (ic_refuse), as the Ruby compiler
// refuses what it does not compile: the caller then has the Ruby compiler
// or the evaluator take the file.
import "m_ic_export.mere";

let ic_refuse = fn (msg: str) -> fail ("IC-REFUSED: " ++ msg);
let ic_binary = fn (u: unit) -> "ASCII-8BIT";

// VM_CALL_* (vm_callinfo.h)
let ic_f_splat = fn (u: unit) -> 1;
let ic_f_blockarg = fn (u: unit) -> 2;
let ic_f_fcall = fn (u: unit) -> 4;
let ic_f_vcall = fn (u: unit) -> 8;
let ic_f_simple = fn (u: unit) -> 16;
let ic_f_kwarg = fn (u: unit) -> 32;
let ic_f_kw_splat = fn (u: unit) -> 64;
let ic_f_super = fn (u: unit) -> 256;
let ic_f_zsuper = fn (u: unit) -> 512;
let ic_f_kw_splat_mut = fn (u: unit) -> 2048;
let ic_f_splat_mut = fn (u: unit) -> 4096;
let ic_f_forwarding = fn (u: unit) -> 8192;

// the names of a constant[] field
let ic_cnames = fn cx -> fn (off: int) -> fn (cnt: int) ->
  let rec go = fn (i: int) -> if i >= cnt then (Nil : str list) else Cons (ic_cname cx (ic_li cx off i), go (i + 1)) in
  go 0;
// the nodes of a node[] field
let ic_nlist = fn cx -> fn (off: int) -> fn (cnt: int) ->
  let rec go = fn (i: int) -> if i >= cnt then (Nil : int list) else Cons (ic_li cx off i, go (i + 1)) in
  go 0;
let ic_loc4 = fn cx -> fn (n: int) -> (ic_start_line cx n, ic_start_col cx n, ic_end_line cx n, ic_end_col cx n);
let ic_tyis = fn cx -> fn (n: int) -> fn (t: int) -> n >= 0 && ic_ty cx n == t;

// compile.c's new_callinfo: keywords are counted in argc, and a call without
// a splat, a block argument, keywords, forwarding or a block is ARGS_SIMPLE
let ic_ci = fn (mid: str) -> fn (argc: int) -> fn (flag0: int) -> fn (kws: str list) -> fn (has_kw: bool) -> fn (blk: bool) ->
  let f1 = (if has_kw then bit_or flag0 32 else flag0) in
  let f2 = (if bit_and f1 (1 + 2 + 32 + 64 + 8192) == 0 && (if blk then false else true) then bit_or f1 16 else f1) in
  OCall (mid, f2, argc + (if has_kw then ic_llen kws else 0), kws, has_kw);
// (CallData.new: the flag as it is given)
let ic_cd = fn (mid: str) -> fn (flag: int) -> fn (argc: int) -> OCall (mid, flag, argc, Nil, false);
// (PUSH_SEND_R: a send at the current place, of no block)
let ic_push_send = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) ->
  ic_i2 cx u "send" (ic_ci mid argc 0 Nil false false) (OSeq (0 - 1));
let ic_push_send_f = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) -> fn (flag: int) ->
  ic_i2 cx u "send" (ic_ci mid argc flag Nil false false) (OSeq (0 - 1));

// a local's operands: where it is in its table, and how many sequences out
let ic_local_ref = fn cx -> fn (u: int) -> fn (name: str) ->
  let (lv, owner) = ic_level_of cx u name in
  if owner < 0 then ic_refuse ("local " ++ name ++ " not found")
  else
    (let i = ic_index_of cx owner name in
     // (VM_ENV_DATA_SIZE 3)
     Cons (OLoc (name, i, ic_llen (ic_u_locals cx owner) - i + 2), Cons (ONum lv, Nil)));
let ic_getlocal = fn cx -> fn (u: int) -> fn (name: str) -> (let _ = ic_insn cx u "getlocal" (ic_local_ref cx u name) in ());
let ic_setlocal = fn cx -> fn (u: int) -> fn (name: str) -> (let _ = ic_insn cx u "setlocal" (ic_local_ref cx u name) in ());
// (the name of the hidden local a block that reads `it` has for it)
let ic_it_param = fn (u: unit) -> chr 1 ++ "-1";

// -- literals -------------------------------------------------------------------
// parse_string_encoded: an escape can force a String literal's encoding over
// the source's -- binary for `\xFF` in a US-ASCII source, UTF-8 for `é`
// there
let ic_string_value = fn cx -> fn (n: int) ->
  IvStr (ic_str cx (pn_string_unescaped cx n),
         (if pq_string_forced_binary_encoding cx n then ic_binary ()
          else if pq_string_forced_utf8_encoding cx n then "UTF-8" else ic_enc cx));
// (parse_string_symbol: an escape can force the symbol's encoding -- UTF-8,
//  binary, US-ASCII -- over the source's)
let ic_symbol_value = fn cx -> fn (n: int) ->
  let s = ic_str cx (pn_symbol_unescaped cx n) in
  let e = (if pq_symbol_forced_utf8_encoding cx n then "UTF-8"
           else if pq_symbol_forced_binary_encoding cx n then ic_binary ()
           else if pq_symbol_forced_us_ascii_encoding cx n then "US-ASCII" else ic_enc cx) in
  // (a Symbol of ASCII bytes is US-ASCII whatever its String was)
  IvSym (s, (if ic_ascii s then "US-ASCII" else e));
let ic_integer_value = fn cx -> fn (a: int) -> fn (b: int) -> if b == 1 then IvInt a else IvBig (ic_str cx a);

let rec ic_static_value = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == pt_array () then IvArr (ic_map (fn (e: int) -> ic_static_value cx e) (ic_nlist cx (pn_array_elements cx n) (pn_array_elements_b cx n)))
  else if ty == pt_nil () then IvNil
  else if ty == pt_true () then IvTrue
  else if ty == pt_false () then IvFalse
  else if ty == pt_string () then ic_string_value cx n
  else if ty == pt_symbol () then ic_symbol_value cx n
  else if ty == pt_integer () then ic_integer_value cx (pn_integer_value cx n) (pn_integer_value_b cx n)
  else if ty == pt_float () then IvFlt (vec_get (ic_dbls cx) (pn_float_value cx n))
  else if ty == pt_rational () then
    IvRat (ic_integer_value cx (pn_rational_numerator cx n) (pn_rational_numerator_b cx n),
           ic_integer_value cx (pn_rational_denominator cx n) (pn_rational_denominator_b cx n))
  else if ty == pt_imaginary () then IvCpx (IvInt 0, ic_static_value cx (pn_imaginary_numeric cx n))
  // (pm_static_literal_value: __LINE__ is its line -- an element of a
  //  literal Array or Hash, a `when`'s value)
  else if ty == pt_source_line () then IvInt (ic_start_line cx n)
  else ic_static_value2 cx n;

// -- entry ----------------------------------------------------------------------
// (the scope's `leave` is the scope node's, on its closing line when it has
//  one -- a def's `end`, a block's `}` -- and the last line otherwise)
let ic_compile_body = fn cx -> fn (u: int) -> fn (stmts: int) -> fn (node_id: int) -> fn (end_line: int) ->
  // (a block's body sits between its start and end labels, which its redo /
  //  next entries and a `next` in it name)
  let _ = (if ic_u_type cx u == 1 then
             (let a = ic_new_label cx u in
              let b = ic_new_label cx u in
              let _ = ic_u_set cx u 21 a in
              let _ = ic_u_set cx u 22 b in
              ic_emit_label cx u a)
           else ()) in
  // (a body with rescue / ensure is a BeginNode)
  let _ = (if stmts < 0 || (ic_ty cx stmts == pt_statements () && pn_statements_body_b cx stmts == 0) then
             (let _ = ic_at cx u (ic_u_line cx u) node_id in ic_i0 cx u "putnil")
           else ic_node cx u stmts false) in
  let _ = (if ic_u_type cx u == 2 then ic_event cx u (ic_ev_return ())
           else if ic_u_type cx u == 1 then
             (let _ = ic_emit_label cx u (ic_u_block_label1 cx u) in ic_event cx u (ic_ev_b_return ()))
           else ()) in
  let _ = (if end_line >= 0 then ic_u_set cx u 11 end_line else ()) in
  let _ = ic_at cx u (if ic_u_last_line cx u >= 0 then ic_u_last_line cx u else ic_u_line cx u) node_id in
  let _ = ic_i0 cx u "leave" in
  if ic_u_type cx u == 1 then
    (let st = ic_u_block_label0 cx u in
     let en = ic_u_block_label1 cx u in
     // (5 redo, 6 next)
     let _ = ic_add_catch cx u 5 st en (0 - 1) st in
     ic_add_catch cx u 6 st en (0 - 1) en)
  else ();

// The file's top sequence, compiled and finished: its number. The tree is
// read already (ic_tree_load); `label` is "<main>" or "<top (required)>".
let ic_compile = fn cx -> fn (path: str) -> fn (label: str) ->
  let root = vec_get (ic_meta cx) 5 in
  let locals = ic_cnames cx (pn_program_locals cx root) (pn_program_locals_b cx root) in
  let u = ic_unit_new cx 0 label path path 1 locals (0 - 1) (ic_loc4 cx root) (ic_nid cx root) in
  let _ = ic_compile_body cx u (pn_program_statements cx root) (ic_nid cx root) (0 - 1) in
  let _ = ic_finish cx u in
  u;

// -- nodes ----------------------------------------------------------------------
let ic_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let line = ic_start_line cx n in
  let _ = ic_at cx u line (ic_nid cx n) in
  let _ = (if ic_newline cx n && ic_u_last_line cx u != line then
             (let _ = ic_u_set cx u 11 line in ic_event cx u (ic_ev_line ()))
           else ()) in
  let ty = ic_ty cx n in
  if ty == pt_statements () then
    (let off = pn_statements_body cx n in
     let cnt = pn_statements_body_b cx n in
     let rec go = fn (i: int) -> if i >= cnt then () else (let _ = ic_node cx u (ic_li cx off i) (popped || i < cnt - 1) in go (i + 1)) in
     go 0)
  else if ty == pt_call () then ic_call cx u n popped false
  else if ty == pt_integer () || ty == pt_float () || ty == pt_rational () || ty == pt_imaginary () || ty == pt_symbol () then
    (if popped then () else ic_i1 cx u "putobject" (OVal (ic_static_value cx n)))
  else if ty == pt_nil () then (if popped then () else ic_i0 cx u "putnil")
  else if ty == pt_true () then (if popped then () else ic_i1 cx u "putobject" (OVal IvTrue))
  else if ty == pt_false () then (if popped then () else ic_i1 cx u "putobject" (OVal IvFalse))
  else if ty == pt_self () then (if popped then () else ic_i0 cx u "putself")
  else if ty == pt_string () then
    (if popped then ()
     else ic_i1 cx u (if pq_string_frozen cx n then "putobject" else "putchilledstring") (OVal (ic_string_value cx n)))
  else if ty == pt_array () then ic_array cx u n popped
  else if ty == pt_local_variable_read () then
    (if popped then () else ic_getlocal cx u (ic_cname cx (pn_local_variable_read_name cx n)))
  // (`it`: the hidden parameter of the block it is read in, IT_PARAM)
  else if ty == pt_it_local_variable_read () then (if popped then () else ic_getlocal cx u (ic_it_param ()))
  else if ty == pt_local_variable_write () then
    (let _ = ic_node cx u (pn_local_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_setlocal cx u (ic_cname cx (pn_local_variable_write_name cx n)))
  else if ty == pt_local_variable_operator_write () then
    (let name = ic_cname cx (pn_local_variable_operator_write_name cx n) in
     let _ = ic_getlocal cx u name in
     let _ = ic_node cx u (pn_local_variable_operator_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_i2 cx u "send" (ic_cd (ic_cname cx (pn_local_variable_operator_write_binary_operator cx n)) 16 1) (OSeq (0 - 1)) in
     let _ = ic_dup_unless cx u popped in
     ic_setlocal cx u name)
  else ic_node2 cx u n popped ty;

// pm_compile_array_node: a static literal is one duparray; otherwise chunks
// of up to 0x100 elements (newarray, then pushtoarray), a splat (splatarray
// true / concattoarray), and a run of 0x40 or more static elements as one
// array; popped, the array is still built and popped
let ic_array = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let off = pn_array_elements cx n in
  let cnt = pn_array_elements_b cx n in
  if ic_static_literal cx n then
    (if popped then ()
     else
       (let _ = ic_here cx u n in
        if cnt == 0 then ic_in cx u "newarray" 0 else ic_i1 cx u "duparray" (OVal (ic_static_value cx n))))
  else
    (let container = fn (e: int) -> (let t = ic_ty cx e in t == pt_array () || t == pt_hash () || t == pt_range ()) in
     // (the elements not yet in the array, and whether there is one yet)
     let flush = fn (size: int) -> fn (first: bool) ->
       if size > 0 then
         (let _ = ic_here cx u n in
          let _ = ic_in cx u (if first then "newarray" else "pushtoarray") size in
          false)
       else first in
     let rec go = fn (i: int) -> fn (size: int) -> fn (first: bool) -> fn (static_run: bool) ->
       if i >= cnt then (let _ = flush size first in ())
       else
         (let e = ic_li cx off i in
          let ty = ic_ty cx e in
          if ty == pt_splat () then
            (let f1 = flush size first in
             let _ = (if pn_splat_expression cx e >= 0 then ic_node cx u (pn_splat_expression cx e) false
                      // (the method's anonymous *)
                      else (let _ = ic_here cx u n in ic_getlocal cx u "*")) in
             let _ = ic_here cx u n in
             let _ = (if f1 then ic_i1 cx u "splatarray" (OVal IvTrue) else ic_i0 cx u "concattoarray") in
             go (i + 1) 0 false false)
          else if ty == pt_keyword_hash () then
            // (the last element: a hash pushed on, or -- when it is ** alone
            //  -- pushtoarraykwsplat, which pushes it only when it is not empty)
            (let (s1, f1) = (if size == 0 && first then (let _ = ic_here cx u n in let _ = ic_in cx u "newarray" 0 in (0, false))
                             else (0, flush size first)) in
             let eoff = pn_keyword_hash_elements cx e in
             let ecnt = pn_keyword_hash_elements_b cx e in
             let _ = ic_hash_elements cx u e eoff ecnt false in
             let rec all_splat = fn (k: int) ->
               if k >= ecnt then true else if ic_ty cx (ic_li cx eoff k) == pt_assoc_splat () then all_splat (k + 1) else false in
             if all_splat 0 then
               (let _ = ic_here cx u n in
                let _ = ic_i0 cx u "pushtoarraykwsplat" in
                go (i + 1) s1 f1 static_run)
             else go (i + 1) (s1 + 1) f1 static_run)
          // (MIN_TMP_ARRAY 0x40, MAX_NEW_ARRAY 0x100)
          else if ic_static_literal cx e && (if container e then false else true) && (if static_run then false else true) && i + 64 < cnt then
            (let rec run = fn (r: int) ->
               if r < cnt && ic_static_literal cx (ic_li cx off r) && (if container (ic_li cx off r) then false else true) then run (r + 1) else r in
             let r = run (i + 1) in
             if r - i >= 64 then
               (let rec vals = fn (k: int) -> if k >= r then (Nil : Iv list) else Cons (ic_static_value cx (ic_li cx off k), vals (k + 1)) in
                let tmp = OVal (IvArr (vals i)) in
                let f1 = flush size first in
                let _ = ic_here cx u n in
                let _ = (if f1 then ic_i1 cx u "duparray" tmp
                         else (let _ = ic_i1 cx u "putobject" tmp in ic_i0 cx u "concattoarray")) in
                go r 0 false static_run)
             else
               (let _ = ic_node cx u e false in
                if size + 1 >= 256 then go (i + 1) 0 (flush (size + 1) first) true else go (i + 1) (size + 1) first true))
          else
            (let _ = ic_node cx u e false in
             if size + 1 >= 256 then go (i + 1) 0 (flush (size + 1) first) false else go (i + 1) (size + 1) first false)) in
     let _ = go 0 0 true false in
     let _ = ic_here cx u n in
     ic_pop_if cx u popped);

// (is this name the block parameter of the method it is a local of)
let ic_block_param = fn cx -> fn (u: int) -> fn (name: str) ->
  let (_, owner) = ic_level_of cx u name in
  owner >= 0 && (if ic_through (ic_u_type cx owner) then false else true) && ic_u_block_start cx owner >= 0
  && ic_index_str (ic_u_locals cx owner) name 0 == ic_u_block_start cx owner;

// pm_setup_args_dup_rest_p: whether evaluating n could change an array being
// splatted
let rec ic_dup_rest_p = fn cx -> fn (n: int) ->
  let t = ic_ty cx n in
  if t == pt_back_reference_read () || t == pt_class_variable_read () || t == pt_constant_read () || t == pt_false ()
     || t == pt_float () || t == pt_global_variable_read () || t == pt_imaginary () || t == pt_instance_variable_read ()
     || t == pt_integer () || t == pt_lambda () || t == pt_local_variable_read () || t == pt_nil ()
     || t == pt_numbered_reference_read () || t == pt_rational () || t == pt_regular_expression () || t == pt_self ()
     || t == pt_string () || t == pt_symbol () || t == pt_true () then false
  else if t == pt_constant_path () then (if pn_constant_path_parent cx n >= 0 then ic_dup_rest_p cx (pn_constant_path_parent cx n) else false)
  else if t == pt_implicit () then ic_dup_rest_p cx (pn_implicit_value cx n)
  else if t == pt_array () then
    (let off = pn_array_elements cx n in
     let cnt = pn_array_elements_b cx n in
     let rec any = fn (i: int) -> if i >= cnt then false else if ic_dup_rest_p cx (ic_li cx off i) then true else any (i + 1) in
     any 0)
  else true;

// pm_setup_args_core. `st` is dup_rest (SPLATARRAY_TRUE 1, DUP_SINGLE_KW_SPLAT
// 2), which a first splat that is not last takes; (line, node) is what the
// call's own instructions are at. Answers (argc, flag, keywords, whether
// there are keywords, st).
let ic_setup_args_core = fn cx -> fn (u: int) -> fn (an: int) -> fn (flag0: int) -> fn (regular_blockarg: bool) -> fn (st0: int) ->
                         fn (line: int) -> fn (node: int) ->
  // (no arguments to a call that is FCALL already -- `self[] ||= v` -- makes
  //  it VCALL too)
  if an < 0 then (0, (if bit_and flag0 4 != 0 then bit_or flag0 8 else flag0), (Nil : str list), false, st0)
  else
    (let off = pn_arguments_arguments cx an in
     let cnt = pn_arguments_arguments_b cx an in
     let at = fn (x: unit) -> ic_at cx u line node in
     let rec go = fn (index: int) -> fn (argc: int) -> fn (flag: int) -> fn (kws: str list) -> fn (has_kws: bool) ->
                  fn (has_splat: bool) -> fn (has_kw_splat: bool) -> fn (post: int) -> fn (st: int) ->
       if index >= cnt then
         (argc + (if has_splat then 1 else 0) + (if has_kw_splat then 1 else 0), flag, kws, has_kws, st)
       else
         (let a = ic_li cx off index in
          let ty = ic_ty cx a in
          if ty == pt_keyword_hash () then
            (let eoff = pn_keyword_hash_elements cx a in
             let ecnt = pn_keyword_hash_elements_b cx a in
             if has_kw_splat || has_splat then
               (let single_splat = ecnt == 1 && ic_ty cx (ic_li cx eoff 0) == pt_assoc_splat () in
                if ecnt > 1 || (if single_splat then false else true) then
                  (let _ = ic_hash_elements cx u a eoff ecnt true in
                   go (index + 1) argc (bit_or flag (64 + 2048)) kws has_kws has_splat true post st)
                else if bit_and st 2 != 0 then
                  (let _ = at () in
                   let _ = ic_in cx u "putspecialobject" 1 in
                   let _ = ic_in cx u "newhash" 0 in
                   let _ = ic_hash_elements cx u a eoff ecnt true in
                   let _ = at () in
                   let _ = ic_push_send cx u "core#hash_merge_kwd" 2 in
                   go (index + 1) argc (bit_or flag (64 + 2048)) kws has_kws has_splat true post st)
                else
                  (let _ = ic_hash_elements cx u a eoff ecnt true in
                   go (index + 1) argc (bit_or flag 64) kws has_kws has_splat true post st))
             else if pq_keyword_hash_symbol_keys cx a then
               // (a keyword given twice: the last one counts, the earlier
               //  values are compiled popped)
               (let key = fn (i: int) -> ic_str cx (pn_symbol_unescaped cx (pn_assoc_key cx (ic_li cx eoff i))) in
                let rec later = fn (i: int) -> fn (j: int) -> if j >= ecnt then false else if str_eq (key j) (key i) then true else later i (j + 1) in
                let rec each = fn (i: int) ->
                  if i >= ecnt then (Nil : str list)
                  else
                    (let keep = (if later i (i + 1) then false else true) in
                     let _ = ic_node cx u (pn_assoc_value cx (ic_li cx eoff i)) (if keep then false else true) in
                     if keep then Cons (key i, each (i + 1)) else each (i + 1)) in
                let ks = each 0 in
                go (index + 1) argc (bit_or flag 32) ks true has_splat has_kw_splat post st)
             else
               (let rec each = fn (i: int) ->
                  if i >= ecnt then ()
                  else (let e = ic_li cx eoff i in
                        let _ = ic_node cx u (pn_assoc_key cx e) false in
                        let _ = ic_node cx u (pn_assoc_value cx e) false in
                        each (i + 1)) in
                let _ = each 0 in
                let _ = at () in
                let _ = ic_in cx u "newhash" (ecnt * 2) in
                go (index + 1) (argc + 1) (bit_or flag (64 + (if ecnt > 1 then 2048 else 0))) kws has_kws has_splat has_kw_splat post st))
          else if ty == pt_splat () then
            (let _ = (if pn_splat_expression cx a >= 0 then ic_node cx u (pn_splat_expression cx a) false
                      else (let _ = at () in ic_getlocal cx u "*")) in
             let _ = at () in
             if has_splat then
               (let _ = ic_i0 cx u "concattoarray" in
                go (index + 1) argc (bit_or flag 1) kws has_kws true has_kw_splat 0 st)
             else if index + 1 < cnt || regular_blockarg then
               (let _ = ic_i1 cx u "splatarray" (OVal (if bit_and st 1 != 0 then IvTrue else IvFalse)) in
                go (index + 1) argc (bit_or flag 1) kws has_kws true has_kw_splat 0 (bit_and st 2))
             else
               (let _ = ic_i1 cx u "splatarray" (OVal IvFalse) in
                go (index + 1) argc (bit_or flag 1) kws has_kws true has_kw_splat 0 st))
          else if ty == pt_forwarding_arguments () then
            (let local = ic_local_iseq cx u in
             let _ = ic_u_set_pflag cx local 4 in
             let _ = at () in
             if ic_u_pflag cx local 16 then
               (let _ = ic_getlocal cx u "..." in
                go (index + 1) argc (bit_or flag 8192) kws has_kws has_splat has_kw_splat post st)
             else
               (let _ = ic_getlocal cx u "*" in
                let _ = (if has_splat then ic_i0 cx u "concattoarray" else ic_i1 cx u "splatarray" (OVal IvFalse)) in
                let _ = ic_getlocal cx u "**" in
                let _ = ic_insn cx u "getblockparamproxy" (ic_local_ref cx u "&") in
                go (index + 1) (argc + (if has_splat then 1 else 2)) (bit_or flag (1 + 2 + 64)) kws has_kws has_splat has_kw_splat post st))
          else
            (let _ = ic_node cx u a false in
             if has_splat then
               (let _ = at () in
                let _ =
                  (if index == cnt - 1 then ic_in cx u "pushtoarray" (post + 1)
                   else
                     (let nt = ic_ty cx (ic_li cx off (index + 1)) in
                      if nt == pt_keyword_hash () || nt == pt_splat () then
                        (let _ = ic_in cx u "newarray" (post + 1) in ic_i0 cx u "concatarray")
                      else if nt == pt_forwarding_arguments () then ic_in cx u "pushtoarray" (post + 1)
                      else ())) in
                go (index + 1) argc flag kws has_kws has_splat has_kw_splat (post + 1) st)
             else go (index + 1) (argc + 1) flag kws has_kws has_splat has_kw_splat (post + 1) st)) in
     go 0 0 flag0 Nil false false (pq_arguments_contains_keyword_splat cx an) 0 st0);

// pm_setup_args: the arguments as the call takes them (argc, the flags, the
// keywords). A splat is `splatarray` -- one that is not last copied
// (ARGS_SPLAT_MUT), unless a block argument or keywords that cannot touch the
// array allow it not to be -- and what follows it pushed onto it; keywords
// with symbol keys are KWARG, any others a hash (KW_SPLAT, KW_SPLAT_MUT when
// it is a new one); `...` is the method's *, ** and &, or its one `...` local
// when it is forwardable
let ic_setup_args = fn cx -> fn (u: int) -> fn (an: int) -> fn (block: int) -> fn (line: int) -> fn (node: int) -> fn (flag0: int) ->
  let cnt = (if an >= 0 then pn_arguments_arguments_b cx an else 0) in
  let last = (if cnt > 0 then ic_li cx (pn_arguments_arguments cx an) (cnt - 1) else 0 - 1) in
  let dup_rest =
    (if cnt >= 2 && pq_arguments_contains_splat cx an && (if pq_arguments_contains_multiple_splats cx an then false else true)
        && ic_ty cx last == pt_keyword_hash () then
       // (f(1, *a, k: v): no copy, unless a keyword could change the array)
       (let eoff = pn_keyword_hash_elements cx last in
        let ecnt = pn_keyword_hash_elements_b cx last in
        let rec any = fn (i: int) ->
          if i >= ecnt then 0
          else
            (let e = ic_li cx eoff i in
             let t = ic_ty cx e in
             if t == pt_assoc () && (ic_dup_rest_p cx (pn_assoc_key cx e) || ic_dup_rest_p cx (pn_assoc_value cx e)) then 1
             else if t == pt_assoc_splat () && pn_assoc_splat_value cx e >= 0 && ic_dup_rest_p cx (pn_assoc_splat_value cx e) then 1
             else any (i + 1)) in
        any 0)
     else 1) in
  if ic_tyis cx block (pt_block_argument ()) then
    // (the block argument is compiled first and laid out after: what it is
    //  decides whether the splat is copied)
    (let ex = pn_block_argument_expression cx block in
     let initial = (if ex >= 0 && ic_dup_rest_p cx ex then 3 else dup_rest) in
     let saved = ic_capture_begin cx u in
     let _ = ic_node cx u block false in
     let barg = ic_capture_end cx u saved in
     let f = ic_first cx barg in
     let single = ic_kind cx f == 0 && ic_is_end cx (ic_next cx f) in
     let _ = (if single && str_eq (ic_name cx f) "getblockparam" then ic_set_name cx f "getblockparamproxy" else ()) in
     let (argc, flag, kws, has_kws, st) = ic_setup_args_core cx u an (bit_or flag0 2) (if single then false else true) initial line node in
     let _ = ic_append cx u barg in
     (argc, (if bit_and flag 1 != 0 && st != initial then bit_or flag 4096 else flag), kws, has_kws))
  else
    (let (argc, flag, kws, has_kws, st) = ic_setup_args_core cx u an flag0 false dup_rest line node in
     (argc, (if bit_and flag 1 != 0 && st != dup_rest then bit_or flag 4096 else flag), kws, has_kws));

// (PUSH_SEND_R / sendish: a send -- one that forwards `...` a sendforward)
let ic_sendish = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) -> fn (flag: int) -> fn (kws: str list) -> fn (has_kws: bool) -> fn (blk: int) ->
  ic_i2 cx u (if bit_and flag 8192 != 0 then "sendforward" else "send") (ic_ci mid argc flag kws has_kws (blk >= 0)) (OSeq blk);

// pm_compile_call_node and pm_compile_call: at the method name's line; a
// literal string's freeze / -@, an attribute write's value kept under its
// receiver (setn), &. (branchnil), a block parameter's call
// (getblockparamproxy), and `new` inlined (opt_new)
// (recv_done: pm_compile_call alone, the receiver already pushed --
//  defined?'s way with a call's receiver)
let ic_call = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (recv_done: bool) ->
  let line = (if pn_call_message_loc cx n >= 0 then ic_line_of cx (pn_call_message_loc cx n) else ic_start_line cx n) in
  let nid = ic_nid cx n in
  let at = fn (x: unit) -> ic_at cx u line nid in
  let r = pn_call_receiver cx n in
  let name = ic_cname cx (pn_call_name cx n) in
  let safe = pq_call_safe_navigation cx n in
  let args = pn_call_arguments cx n in
  let block = pn_call_block cx n in
  // (`nil&.m(...)` is nil, and nothing of it is evaluated: compile.c's
  //  optimiser folds the branchnil of a written nil and drops what follows,
  //  leaving the receiver's own putnil)
  if (if recv_done then false else true) && safe && ic_tyis cx r (pt_nil ()) then
    (if popped then () else (let _ = ic_here cx u r in ic_i0 cx u "putnil"))
  else
    // (a call with a block starts at a label a break entry may name)
    (let start = ic_new_label cx u in
     let _ = (if block >= 0 && (if recv_done then false else true) then ic_emit_label cx u start else ()) in
     if (if recv_done then false else true) && (str_eq name "-@" || str_eq name "freeze") && ic_tyis cx r (pt_string ())
        && (if safe then false else true) && args < 0 && block < 0 then
       (let _ = at () in
        let _ = ic_i2 cx u (if str_eq name "freeze" then "opt_str_freeze" else "opt_str_uminus") (OVal (ic_string_value cx r)) (ic_cd name 16 0) in
        ic_pop_if cx u popped)
     else
       (let write = pq_call_attribute_write cx n && (if popped then false else true) in
        let _ = at () in
        let _ = (if write && (if recv_done then false else true) then ic_i0 cx u "putnil" else ()) in
        let _ =
          (if recv_done then ()
           else if r < 0 then (let _ = at () in ic_i0 cx u "putself")
           else if str_eq name "call" && ic_ty cx r == pt_local_variable_read ()
                   && ic_block_param cx u (ic_cname cx (pn_local_variable_read_name cx r)) then
             (let _ = ic_at cx u line (ic_nid cx r) in
              let _ = ic_insn cx u "getblockparamproxy" (ic_local_ref cx u (ic_cname cx (pn_local_variable_read_name cx r))) in
              ())
           else ic_node cx u r false) in
        let fcall = r < 0 || pq_call_ignore_visibility cx n in
        let else_l = (if safe then ic_new_label cx u else 0 - 1) in
        let end_l = (if safe then ic_new_label cx u else 0 - 1) in
        let _ = (if safe then
                   (let _ = at () in
                    let _ = ic_i0 cx u "dup" in
                    ic_il cx u "branchnil" else_l)
                 else ()) in
        // (where the arguments start: opt_new's putnil and swap go there)
        let prelude = ic_last cx (ic_u_list cx u) in
        let (argc, flag0, kws, has_kws) = ic_setup_args cx u args block line nid 0 in
        let blk = (if ic_tyis cx block (pt_block ()) then ic_block_unit cx u block (0 - 1) (0 - 1) (0 - 1) else 0 - 1) in
        let flag1 = (if blk < 0 && pq_call_variable_call cx n then bit_or flag0 8 else flag0) in
        let flag = (if fcall then bit_or flag1 4 else flag1) in
        let _ = at () in
        let _ =
          (if write then
             // (the value is the last argument: kept under the receiver,
             //  from the splatted array's end when there is a splat)
             (if bit_and flag 2 != 0 then
                (let _ = ic_in cx u "topn" 1 in
                 let _ = (if bit_and flag 1 != 0 then
                            (let _ = ic_i1 cx u "putobject" (OVal (IvInt (0 - 1))) in ic_push_send cx u "[]" 1)
                          else ()) in
                 let _ = ic_in cx u "setn" (argc + 3) in
                 ic_i0 cx u "pop")
              else if bit_and flag 1 != 0 then
                (let _ = ic_i0 cx u "dup" in
                 let _ = ic_i1 cx u "putobject" (OVal (IvInt (0 - 1))) in
                 let _ = ic_push_send cx u "[]" 1 in
                 let _ = ic_in cx u "setn" (argc + 2) in
                 ic_i0 cx u "pop")
              else ic_in cx u "setn" (argc + 1))
           else ()) in
        // (a keyword splat the callee could keep, passed with a block
        //  argument: splatkw)
        let _ = (if bit_and flag 64 != 0 && bit_and flag 2 != 0 && bit_and flag 2048 == 0 then ic_i0 cx u "splatkw" else ()) in
        let _ =
          (if str_eq name "new" && block < 0 && bit_and flag 2 == 0 then
             (let p1 = ic_mk cx "putnil" Nil line nid in
              let p2 = ic_mk cx "swap" Nil line nid in
              let _ = ic_ins_after cx prelude p1 in
              let _ = ic_ins_after cx p1 p2 in
              let not_basic = ic_new_label cx u in
              let done = ic_new_label cx u in
              let fwd = (if bit_and flag 8192 != 0 then 1 else 0) in
              let _ = ic_i2 cx u "opt_new" (ic_ci "new" (argc + fwd) flag kws has_kws false) (OLab not_basic) in
              let _ = ic_sendish cx u "initialize" argc (bit_or flag 4) kws has_kws (0 - 1) in
              let _ = ic_il cx u "jump" done in
              let _ = ic_emit_label cx u not_basic in
              let _ = ic_sendish cx u "new" argc flag kws has_kws (0 - 1) in
              let _ = ic_i0 cx u "swap" in
              let _ = ic_emit_label cx u done in
              ic_i0 cx u "pop")
           else
             (let _ = ic_sendish cx u name argc flag kws has_kws blk in
              // (a block that keeps a catch table may be broken out of: the
              //  break lands just past the send)
              if blk >= 0 && (match ic_kept_catch cx blk with | Nil -> false | _ -> true) then
                (let retry_end = ic_new_label cx u in
                 let _ = ic_emit_label cx u retry_end in
                 ic_add_catch cx u 4 start retry_end blk retry_end)
              else ())) in
        let _ = (if safe then
                   (let _ = ic_il cx u "jump" end_l in
                    let _ = ic_emit_label cx u else_l in
                    ic_emit_label cx u end_l)
                 else ()) in
        let _ = (if write then ic_i0 cx u "pop" else ()) in
        ic_pop_if cx u popped));

// -- blocks and parameters ----------------------------------------------------
// PM_CONTAINER_P
let ic_container = fn cx -> fn (n: int) -> (let t = ic_ty cx n in t == pt_array () || t == pt_hash () || t == pt_range ());
let ic_hidden = fn (k: int) -> chr 1 ++ str_of_int k;
let ic_is_hidden = fn (s: str) -> str_len s > 0 && ord (char_at s 0) == 1;
// (a parameter node's repeated_parameter? -- ParameterFlags' one flag)
let ic_repeated = fn cx -> fn (p: int) -> p >= 0 && bit_and (ic_flags cx p) 4 != 0;
// a block's or a lambda's locals, parameters and body
let ic_blk_locals = fn cx -> fn (b: int) ->
  if ic_ty cx b == pt_block () then ic_cnames cx (pn_block_locals cx b) (pn_block_locals_b cx b)
  else ic_cnames cx (pn_lambda_locals cx b) (pn_lambda_locals_b cx b);
let ic_blk_params = fn cx -> fn (b: int) -> if ic_ty cx b == pt_block () then pn_block_parameters cx b else pn_lambda_parameters cx b;
let ic_blk_body = fn cx -> fn (b: int) -> if ic_ty cx b == pt_block () then pn_block_body cx b else pn_lambda_body cx b;

// make_name_for_block: one, and one more for each block from the scope the
// block is in up to its method's
let ic_block_label = fn cx -> fn (u: int) ->
  let levels = 1 + ic_blocks_out cx u in
  let name = ic_u_label cx (ic_local_iseq cx u) in
  if levels == 1 then "block in " ++ name else "block (" ++ str_of_int levels ++ " levels) in " ++ name;

let rec ic_str_list_remove = fn (xs: str list) -> fn (gone: str list) ->
  match xs with
  | Nil -> (Nil : str list)
  | Cons (h, t) -> if ic_has_str gone h then ic_str_list_remove t gone else Cons (h, ic_str_list_remove t gone);

// The parameters, as ruby lays them out in the local table: lead, opt, rest,
// post, keywords, the hidden kwbits slot, kwrest, block (or for `...` the
// anonymous *, ** and & and the `...` itself -- that alone when it is the
// only parameter: forwardable), then the names a destructured parameter
// binds, then the body's own locals. (a destructured parameter is a hidden
// local in its place; a block's one required parameter with no optional,
// rest, post or keyword one -- `|y|`, `|y, &b|`, `|(a, b)|`, not `|y,|` --
// is ambiguous_param0: the block takes an Array's first element or the whole
// value, as yield passes it.)
let ic_params = fn cx -> fn (unit: int) -> fn (ps: int) ->
  if ps < 0 then ()
  else
    (let names = vec_new () in
     let lookup = vec_new () in
     let _ = vec_push lookup (Nil : (str * int) list) in
     let multis = vec_new () in
     let _ = vec_push multis (Nil : (int * int) list) in
     // (the index_lookup_table: where a name is looked up -- for one given
     //  twice, `_`, the place that is not the repeated one)
     let add = fn (name: str) -> fn (p: int) ->
       (let _ = (if ic_is_hidden name || ic_repeated cx p then () else vec_set lookup 0 (Cons ((name, vec_len names), vec_get lookup 0))) in
        vec_push names name) in
     let positional = fn (r: int) ->
       if ic_ty cx r == pt_multi_target () then
         (let _ = vec_set multis 0 (Cons ((vec_len names, r), vec_get multis 0)) in
          add (ic_hidden (vec_len names)) (0 - 1))
       else add (ic_cname cx (pn_required_parameter_name cx r)) r in
     let nreq = pn_parameters_requireds_b cx ps in
     let nopt = pn_parameters_optionals_b cx ps in
     let npost = pn_parameters_posts_b cx ps in
     let nkw = pn_parameters_keywords_b cx ps in
     let rest = pn_parameters_rest cx ps in
     let kwrest = pn_parameters_keyword_rest cx ps in
     let blk = pn_parameters_block cx ps in
     let _ = list_iter (ic_nlist cx (pn_parameters_requireds cx ps) nreq) positional in
     let _ = ic_u_set cx unit 24 nreq in
     let opt_nodes = ic_nlist cx (pn_parameters_optionals cx ps) nopt in
     let _ = list_iter opt_nodes (fn (o: int) -> add (ic_cname cx (pn_optional_parameter_name cx o)) o) in
     let _ = (if rest >= 0 && ic_ty cx rest != pt_implicit_rest () then
                (let nm = ic_cname cx (pn_rest_parameter_name cx rest) in
                 let _ = ic_u_set cx unit 27 (vec_len names) in
                 let _ = (if str_len nm == 0 then ic_u_set_pflag cx unit 128 else ()) in
                 add (if str_len nm == 0 then "*" else nm) rest)
              else ()) in
     let _ = (if npost > 0 then
                (let _ = ic_u_set cx unit 26 (vec_len names) in
                 let _ = ic_u_set cx unit 25 npost in
                 list_iter (ic_nlist cx (pn_parameters_posts cx ps) npost) positional)
              else ()) in
     let kw_nodes = ic_nlist cx (pn_parameters_keywords cx ps) nkw in
     let _ =
       (if nkw > 0 then
          // (a default that is a static literal and no container is kept in
          //  the keyword table; any other is compiled behind checkkeyword)
          (let is_req = fn (k: int) -> ic_ty cx k == pt_required_keyword_parameter () in
           let entry = fn (k: int) ->
             if is_req k then ic_sym cx (ic_cname cx (pn_required_keyword_parameter_name cx k))
             else
               (let nm = ic_sym cx (ic_cname cx (pn_optional_keyword_parameter_name cx k)) in
                let v = pn_optional_keyword_parameter_value cx k in
                if ic_static_literal cx v && (if ic_container cx v then false else true) then IvArr (Cons (nm, Cons (ic_static_value cx v, Nil)))
                else IvArr (Cons (nm, Nil))) in
           // (required ones first, as ruby keeps them)
           let rec pick = fn (ks: int list) -> fn (want_req: bool) ->
             (match ks with
              | Nil -> (Nil : int list)
              | Cons (k, t) -> if is_req k == want_req then Cons (k, pick t want_req) else pick t want_req) in
           let reqs = pick kw_nodes true in
           let opts = pick kw_nodes false in
           let _ = vec_set (ic_uw cx) unit (ic_map entry (ic_cat reqs opts)) in
           let _ = ic_u_set_pflag cx unit 32 in
           let _ = ic_u_set cx unit 33 (ic_llen reqs) in
           let _ = list_iter reqs (fn (k: int) -> add (ic_cname cx (pn_required_keyword_parameter_name cx k)) k) in
           let _ = list_iter opts (fn (k: int) -> add (ic_cname cx (pn_optional_keyword_parameter_name cx k)) k) in
           let _ = ic_u_set cx unit 29 (vec_len names) in
           add (ic_hidden (vec_len names)) (0 - 1))
        else ()) in
     let _ =
       (if kwrest < 0 then ()
        // (**nil: accepts_no_kwarg, which neither to_a nor disasm shows)
        else if ic_ty cx kwrest == pt_no_keywords_parameter () then ic_u_set_pflag cx unit 2
        else if ic_ty cx kwrest == pt_forwarding_parameter () then
          (let _ =
             (if nreq == 0 && nopt == 0 && nkw == 0 then (let _ = ic_u_set_pflag cx unit 16 in ic_u_set_pflag cx unit 4)
              else
                (let _ = ic_u_set cx unit 27 (vec_len names) in
                 let _ = ic_u_set_pflag cx unit 128 in
                 let _ = add "*" (0 - 1) in
                 let _ = ic_u_set cx unit 30 (vec_len names) in
                 let _ = ic_u_set_pflag cx unit 256 in
                 let _ = add "**" (0 - 1) in
                 let _ = ic_u_set cx unit 28 (vec_len names) in
                 add "&" (0 - 1))) in
           add "..." (0 - 1))
        else
          (let nm = ic_cname cx (pn_keyword_rest_parameter_name cx kwrest) in
           let _ = ic_u_set cx unit 30 (vec_len names) in
           let _ = (if str_len nm == 0 then ic_u_set_pflag cx unit 256 else ()) in
           add (if str_len nm == 0 then "**" else nm) kwrest)) in
     let _ = (if blk >= 0 then
                (let nm = ic_cname cx (pn_block_parameter_name cx blk) in
                 let _ = ic_u_set cx unit 28 (vec_len names) in
                 let _ = add (if str_len nm == 0 then "&" else nm) blk in
                 ic_u_set_pflag cx unit 4)
              else ()) in
     let ms = ic_rev (vec_get multis 0) in
     let rec dl = fn (m: int) ->
       // pm_compile_destructured_param_locals: the names of a destructured
       // parameter, in order (a repeated one -- `_` again -- has none)
       (let one = fn (r: int) -> if ic_repeated cx r then () else add (ic_cname cx (pn_required_parameter_name cx r)) r in
        let side = fn (x: int) -> if ic_ty cx x == pt_multi_target () then dl x else one x in
        let _ = list_iter (ic_nlist cx (pn_multi_target_lefts cx m) (pn_multi_target_lefts_b cx m)) side in
        let mr = pn_multi_target_rest cx m in
        let _ = (if mr >= 0 && ic_ty cx mr == pt_splat () && pn_splat_expression cx mr >= 0 then one (pn_splat_expression cx mr) else ()) in
        list_iter (ic_nlist cx (pn_multi_target_rights cx m) (pn_multi_target_rights_b cx m)) side) in
     let _ = list_iter ms (fn (im: int * int) -> (let (_, m) = im in dl m)) in
     let ns = vec_to_list names in
     let _ = vec_set (ic_ul cx) unit (ic_cat ns (ic_str_list_remove (ic_u_locals cx unit) ns)) in
     let _ = vec_set (ic_ux cx) unit (vec_get lookup 0) in
     let _ = vec_set (ic_um cx) unit (opt_nodes, kw_nodes, ms) in
     // (ruby asks before it counts **kw and &b: only one local so far)
     if ic_u_type cx unit == 1 && nreq == 1 && rest < 0 && nopt == 0 && npost == 0 && nkw == 0 then ic_u_set_pflag cx unit 1 else ());

// optional parameters' defaults: each behind a label of the opt table, and
// one after the last -- the body's start
let ic_opt_defaults = fn cx -> fn (unit: int) ->
  let (opt_nodes, _, _) = vec_get (ic_um cx) unit in
  match opt_nodes with
  | Nil -> ()
  | _ ->
    (let rec go = fn (os: int list) ->
       (match os with
        | Nil -> (let l = ic_new_label cx unit in let _ = ic_emit_label cx unit l in Cons (l, Nil))
        | Cons (o, t) ->
          (let l = ic_new_label cx unit in
           let _ = ic_emit_label cx unit l in
           let _ = ic_node cx unit (pn_optional_parameter_value cx o) false in
           let _ = ic_here cx unit o in
           let _ = ic_setlocal cx unit (ic_cname cx (pn_optional_parameter_name cx o)) in
           Cons (l, go t))) in
     let labels = go opt_nodes in
     let _ = list_iter labels (fn (l: int) -> (let _ = ic_set_unremovable cx l in ic_ref cx l)) in
     let _ = vec_set (ic_uo cx) unit labels in
     ic_u_set_pflag cx unit 64);

// a local by its place in the sequence's own table
let ic_local_op = fn cx -> fn (owner: int) -> fn (i: int) ->
  let ls = ic_u_locals cx owner in
  let rec nth = fn (xs: str list) -> fn (k: int) -> (match xs with | Nil -> "" | Cons (h, t) -> if k <= 0 then h else nth t (k - 1)) in
  OLoc (nth ls i, i, ic_llen ls - i + 2);

// pm_compile_destructured_param_writes: a multiple assignment whose targets
// are all the parameter's own locals
let rec ic_destructured_writes = fn cx -> fn (unit: int) -> fn (m: int) ->
  let nl = pn_multi_target_lefts_b cx m in
  let nr = pn_multi_target_rights_b cx m in
  let mr = pn_multi_target_rest cx m in
  let has_rest = mr >= 0 && ic_ty cx mr == pt_splat () && pn_splat_expression cx mr >= 0 in
  let has_rights = nr > 0 in
  let write = fn (t: int) ->
    if ic_ty cx t == pt_multi_target () then ic_destructured_writes cx unit t
    else (let _ = ic_here cx unit t in ic_setlocal cx unit (ic_cname cx (pn_required_parameter_name cx t))) in
  let rec each = fn (off: int) -> fn (cnt: int) -> fn (i: int) ->
    if i >= cnt then () else (let _ = write (ic_li cx off i) in each off cnt (i + 1)) in
  let _ = ic_here cx unit m in
  let _ = ic_i2 cx unit "expandarray" (ONum nl) (ONum (if has_rest || has_rights then 1 else 0)) in
  let _ = each (pn_multi_target_lefts cx m) nl 0 in
  let _ = (if has_rest then
             (let _ = (if has_rights then (let _ = ic_here cx unit m in ic_i2 cx unit "expandarray" (ONum nr) (ONum 3)) else ()) in
              write (pn_splat_expression cx mr))
           else ()) in
  if has_rights then
    (let _ = (if has_rest then () else (let _ = ic_here cx unit m in ic_i2 cx unit "expandarray" (ONum nr) (ONum 2))) in
     each (pn_multi_target_rights cx m) nr 0)
  else ();

// pm_compile_scope_node's step 5 past the optional parameters: a keyword
// default that is not in the table, behind checkkeyword (its bit among the
// optional keywords), then each destructured parameter taken apart.
// ((line, node): the scope's place -- its first line, no node)
let ic_param_prologue = fn cx -> fn (unit: int) -> fn (line: int) -> fn (node: int) ->
  let (_, kw_nodes, multis) = vec_get (ic_um cx) unit in
  let rec kws = fn (ks: int list) -> fn (oi: int) ->
    (match ks with
     | Nil -> ()
     | Cons (k, t) ->
       if ic_ty cx k != pt_optional_keyword_parameter () then kws t oi
       else
         (let v = pn_optional_keyword_parameter_value cx k in
          let _ =
            (if ic_static_literal cx v && (if ic_container cx v then false else true) then ()
             else
               (let done = ic_new_label cx unit in
                let _ = ic_at cx unit line node in
                let bits = (match ic_local_op cx unit (ic_u_kwbits cx unit) with | OLoc (_, _, idx) -> idx | _ -> 0) in
                let _ = ic_i2 cx unit "checkkeyword" (ONum bits) (ONum oi) in
                let _ = ic_il cx unit "branchif" done in
                let _ = ic_node cx unit v false in
                let _ = ic_at cx unit line node in
                let _ = ic_setlocal cx unit (ic_cname cx (pn_optional_keyword_parameter_name cx k)) in
                ic_emit_label cx unit done)) in
          kws t (oi + 1))) in
  let _ = kws kw_nodes 0 in
  list_iter multis (fn (im: int * int) ->
    (let (i, m) = im in
     let _ = ic_at cx unit line node in
     let _ = ic_i2 cx unit "getlocal" (ic_local_op cx unit i) (ONum 0) in
     ic_destructured_writes cx unit m));

// A block's sequence. first_line: the line it is from when that is not the
// block's own (-1); (start_line, start_col): where its location starts when
// that is not the block's start (-1) -- a lambda's sequence starts at its
// opening and its location at its parameters, or just after the ->
let ic_block_unit = fn cx -> fn (u: int) -> fn (b: int) -> fn (first_line: int) -> fn (start_line: int) -> fn (start_col: int) ->
  let label = ic_block_label cx u in
  let sl = ic_start_line cx b in
  let loc = ((if start_line >= 0 then start_line else sl), (if start_line >= 0 then start_col else ic_start_col cx b),
             ic_end_line cx b, ic_end_col cx b) in
  let child = ic_unit_new cx 1 label (ic_u_path cx u) (ic_u_abs_path cx u) (if first_line >= 0 then first_line else sl)
                (ic_blk_locals cx b) u loc (ic_nid cx b) in
  let bp = ic_blk_params cx b in
  let _ = ic_params cx child (if ic_tyis cx bp (pt_block_parameters ()) then pn_block_parameters_parameters cx bp else 0 - 1) in
  // (implicit parameters: `_1` .. `_9` are the block's first locals, as many
  //  required parameters as the highest one named; `it` is one hidden
  //  required parameter. One alone takes an Array whole or its first element
  //  as `|x|` does: ambiguous_param0.)
  let _ =
    (if ic_tyis cx bp (pt_numbered_parameters ()) then
       // (the parameters come first in the table, whatever the body named
       //  before them)
       (let mx = pn_numbered_parameters_maximum cx bp in
        let rec nums = fn (i: int) -> if i > mx then (Nil : str list) else Cons ("_" ++ str_of_int i, nums (i + 1)) in
        let ns = nums 1 in
        let _ = vec_set (ic_ul cx) child (ic_cat ns (ic_str_list_remove (ic_u_locals cx child) ns)) in
        let _ = ic_u_set cx child 24 mx in
        let _ = ic_u_set cx child 32 mx in
        if mx == 1 then ic_u_set_pflag cx child 1 else ())
     else if ic_tyis cx bp (pt_it_parameters ()) then
       (let it = Cons (ic_it_param (), Nil) in
        let _ = vec_set (ic_ul cx) child (ic_cat it (ic_str_list_remove (ic_u_locals cx child) it)) in
        let _ = ic_u_set cx child 24 1 in
        let _ = ic_u_set cx child 32 0 in
        ic_u_set_pflag cx child 1)
     else ()) in
  let _ = ic_add_child cx u child in
  let _ = ic_opt_defaults cx child in
  let _ = ic_param_prologue cx child sl 0 in
  let _ = ic_at cx child (ic_u_first_lineno cx child) (ic_nid cx b) in
  let _ = ic_event cx child (ic_ev_b_call ()) in
  // (the b_call is a nop's; iseq_optimize takes the nop out again when
  //  nothing comes before it and nothing needs it)
  let nop = ic_insn cx child "nop" Nil in
  let _ = ic_u_set cx child 20 nop in
  let _ = ic_compile_body cx child (ic_blk_body cx b) (ic_nid cx b) (ic_end_line cx b) in
  let _ = ic_finish cx child in
  child;

// -- the rest of `node` ---------------------------------------------------------
let ic_node2 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == pt_instance_variable_read () then
    (if popped then () else ic_i2 cx u "getinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_read_name cx n))) (OIvc (ic_next_is cx u)))
  else if ty == pt_instance_variable_write () then
    (let _ = ic_node cx u (pn_instance_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_i2 cx u "setinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_write_name cx n))) (OIvc (ic_next_is cx u)))
  else if ty == pt_global_variable_read () then
    (let _ = ic_i1 cx u "getglobal" (ic_osym cx (ic_cname cx (pn_global_variable_read_name cx n))) in
     ic_pop_if cx u popped)
  else if ty == pt_global_variable_write () then
    (let _ = ic_node cx u (pn_global_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_i1 cx u "setglobal" (ic_osym cx (ic_cname cx (pn_global_variable_write_name cx n))))
  else if ty == pt_constant_write () then
    (let _ = ic_node cx u (pn_constant_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     let _ = ic_in cx u "putspecialobject" 3 in
     ic_i1 cx u "setconstant" (ic_osym cx (ic_cname cx (pn_constant_write_name cx n))))
  else if ty == pt_splat () then
    (let _ = (if pn_splat_expression cx n >= 0 then ic_node cx u (pn_splat_expression cx n) popped else ()) in
     let _ = ic_here cx u n in
     if popped then () else ic_i1 cx u "splatarray" (OVal IvTrue))
  else if ty == pt_source_line () then (if popped then () else ic_i1 cx u "putobject" (OVal (IvInt (ic_start_line cx n))))
  else if ty == pt_source_file () then (if popped then () else ic_i1 cx u "putchilledstring" (OVal (IvStr (ic_u_path cx u, "UTF-8"))))
  else if ty == pt_source_encoding () then (if popped then () else ic_i1 cx u "putobject" (OVal (IvEnc (ic_enc cx))))
  // $1 .. $9: getspecial of the number doubled; $&, $`, $', $+: of the
  // character doubled, plus 1
  else if ty == pt_numbered_reference_read () then
    (if popped then ()
     else (let k = pn_numbered_reference_read_number cx n in
           if k == 0 then ic_i0 cx u "putnil" else ic_i2 cx u "getspecial" (ONum 1) (ONum (k * 2))))
  else if ty == pt_back_reference_read () then
    (if popped then ()
     else ic_i2 cx u "getspecial" (ONum 1) (ONum (ord (char_at (ic_cname cx (pn_back_reference_read_name cx n)) 1) * 2 + 1)))
  else if ty == pt_class_variable_read () then
    (if popped then ()
     else (let nm = ic_cname cx (pn_class_variable_read_name cx n) in ic_i2 cx u "getclassvariable" (ic_osym cx nm) (ic_cvc cx u nm)))
  else if ty == pt_class_variable_write () then
    (let nm = ic_cname cx (pn_class_variable_write_name cx n) in
     let _ = ic_node cx u (pn_class_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_i2 cx u "setclassvariable" (ic_osym cx nm) (ic_cvc cx u nm))
  else if ty == pt_parentheses () then
    (if pn_parentheses_body cx n >= 0 then ic_node cx u (pn_parentheses_body cx n) popped
     else if popped then () else ic_i0 cx u "putnil")
  else if ty == pt_assoc () then
    (let _ = ic_node cx u (pn_assoc_key cx n) popped in ic_node cx u (pn_assoc_value cx n) popped)
  else if ty == pt_assoc_splat () then
    (if pn_assoc_splat_value cx n >= 0 then ic_node cx u (pn_assoc_splat_value cx n) popped
     else if popped then () else ic_getlocal cx u "**")
  else if ty == pt_block_argument () then
    // (an anonymous one is the method's &, forwarded)
    (if pn_block_argument_expression cx n >= 0 then ic_node cx u (pn_block_argument_expression cx n) popped
     else (let _ = ic_insn cx u "getblockparamproxy" (ic_local_ref cx u "&") in ()))
  else if ty == pt_implicit () then ic_node cx u (pn_implicit_value cx n) popped
  else ic_node3 cx u n popped ty;

// -- strings, hashes, ranges, patterns ----------------------------------------
// `a << b` of two Strings in their encodings (rb_enc_compatible): the bytes
// joined, in the first's encoding unless only the second can say what its
// bytes are
let ic_str_cat = fn (a: str * str) -> fn (b: str * str) ->
  let (s1, e1) = a in
  let (s2, e2) = b in
  let enc = (if str_eq e1 e2 || str_len s2 == 0 then e1
             else if str_len s1 == 0 then (if ic_ascii s2 then e1 else e2)
             else if ic_ascii s2 then e1
             else if ic_ascii s1 then e2 else e1) in
  (s1 ++ s2, enc);
let ic_str_pair = fn (v: Iv) -> match v with | IvStr (s, e) -> (s, e) | _ -> ("", "UTF-8");

// RegularExpressionFlags, which a pattern, an interpolated one and the two
// match-last-line nodes share: ignore_case 4, extended 8, multi_line 16,
// once 32, euc_jp 64, ascii_8bit 128, windows_31j 256, utf_8 512,
// forced_utf8 1024, forced_binary 2048, forced_us_ascii 4096
let ic_rx = fn cx -> fn (n: int) -> fn (bit: int) -> bit_and (ic_flags cx n) bit != 0;
// (Prism's #options: IGNORECASE 1, EXTENDED 2, MULTILINE 4, FIXEDENCODING 16
//  when it names an encoding, NOENCODING 32 for n)
let ic_rx_options = fn cx -> fn (n: int) ->
  (if ic_rx cx n 4 then 1 else 0) + (if ic_rx cx n 8 then 2 else 0) + (if ic_rx cx n 16 then 4 else 0)
  + (if ic_rx cx n 64 || ic_rx cx n 256 || ic_rx cx n 512 then 16 else 0) + (if ic_rx cx n 128 then 32 else 0);
// parse_regexp_encoding: the encoding a pattern's n / u / e / s names (or
// binary, when an escape forces it), "" when it names none
let ic_rx_explicit_encoding = fn cx -> fn (n: int) ->
  if ic_rx cx n 128 || ic_rx cx n 2048 then ic_binary ()
  else if ic_rx cx n 512 then "UTF-8"
  else if ic_rx cx n 64 then "EUC-JP"
  else if ic_rx cx n 256 then "Windows-31J"
  else "";
// A Regexp literal: what its maker is handed -- the source in the encoding
// the pattern names (or binary, which an escape in it can force:
// parse_regexp_encoding reads no other forced encoding), and the options
// with NOENCODING for n and FIXEDENCODING for u / e / s.
let ic_regexp_literal = fn cx -> fn (src: str * str) -> fn (n: int) ->
  let (s, e) = src in
  let o = bit_and (ic_rx_options cx n) 7 in
  if ic_rx cx n 128 then IvRx (s, o + 32, ic_binary ())
  else if ic_rx cx n 512 then IvRx (s, o + 16, "UTF-8")
  else if ic_rx cx n 64 then IvRx (s, o + 16, "EUC-JP")
  else if ic_rx cx n 256 then IvRx (s, o + 16, "Windows-31J")
  else if ic_rx cx n 2048 then IvRx (s, o, ic_binary ())
  else IvRx (s, o, e);

// the parts of an interpolated string, symbol, command, pattern
let ic_parts = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == pt_interpolated_string () then ic_nlist cx (pn_interpolated_string_parts cx n) (pn_interpolated_string_parts_b cx n)
  else if ty == pt_interpolated_symbol () then ic_nlist cx (pn_interpolated_symbol_parts cx n) (pn_interpolated_symbol_parts_b cx n)
  else if ty == pt_interpolated_xstring () then ic_nlist cx (pn_interpolated_xstring_parts cx n) (pn_interpolated_xstring_parts_b cx n)
  else if ty == pt_interpolated_regular_expression () then
    ic_nlist cx (pn_interpolated_regular_expression_parts cx n) (pn_interpolated_regular_expression_parts_b cx n)
  else ic_nlist cx (pn_interpolated_match_last_line_parts cx n) (pn_interpolated_match_last_line_parts_b cx n);
let ic_stmts_list = fn cx -> fn (st: int) ->
  if st < 0 then (Nil : int list) else ic_nlist cx (pn_statements_body cx st) (pn_statements_body_b cx st);

// pm_static_literal_concat: the pieces of a static string, joined (in their
// own encodings: the first one's is the text's unless a later piece brings
// another)
let rec ic_static_concat = fn cx -> fn (parts: int list) ->
  let rec go = fn (ps: int list) -> fn (have: bool) -> fn (acc: str * str) ->
    (match ps with
     | Nil -> if have then acc else ("", "UTF-8")
     | Cons (part, t) ->
       (let ty = ic_ty cx part in
        let v = (if ty == pt_string () then ic_str_pair (ic_string_value cx part)
                 else if ty == pt_interpolated_string () then ic_static_concat cx (ic_parts cx part)
                 else if ty == pt_embedded_statements () then ic_static_concat cx (ic_stmts_list cx (pn_embedded_statements_statements cx part))
                 else ic_refuse (ic_type_name ty ++ " in a static string is not compiled yet")) in
        go t true (if have then ic_str_cat acc v else v))) in
  go parts false ("", "UTF-8");

// (static values, the rest: a Hash, a Range, a Regexp)
let rec ic_iv_eq = fn (a: Iv) -> fn (b: Iv) ->
  match (a, b) with
  | (IvNil, IvNil) -> true
  | (IvTrue, IvTrue) -> true
  | (IvFalse, IvFalse) -> true
  | (IvInt x, IvInt y) -> x == y
  | (IvBig x, IvBig y) -> str_eq x y
  | (IvFlt x, IvFlt y) -> float_bits_hi x == float_bits_hi y && float_bits_lo x == float_bits_lo y
  | (IvSym (x, _), IvSym (y, _)) -> str_eq x y
  // (two Strings are one key when their bytes are and their encodings
  //  agree -- or both are ASCII)
  | (IvStr (x, e1), IvStr (y, e2)) -> str_eq x y && (str_eq e1 e2 || ic_ascii x)
  | (IvArr xs, IvArr ys) -> ic_iv_list_eq xs ys
  | _ -> false;
let rec ic_iv_list_eq = fn (xs: Iv list) -> fn (ys: Iv list) ->
  match (xs, ys) with
  | (Nil, Nil) -> true
  | (Cons (x, t), Cons (y, s)) -> if ic_iv_eq x y then ic_iv_list_eq t s else false
  | _ -> false;
// a pair put in a literal Hash: a key that is there already keeps its place
// and takes the new value
let rec ic_hash_put = fn (ps: (Iv * Iv) list) -> fn (k: Iv) -> fn (v: Iv) ->
  match ps with
  | Nil -> Cons ((k, v), Nil)
  | Cons ((k0, v0), t) -> if ic_iv_eq k0 k then Cons ((k0, v), t) else Cons ((k0, v0), ic_hash_put t k v);
let ic_static_hash = fn cx -> fn (els: int list) ->
  let rec go = fn (xs: int list) -> fn (acc: (Iv * Iv) list) ->
    (match xs with
     | Nil -> acc
     | Cons (e, t) -> go t (ic_hash_put acc (ic_static_value cx (pn_assoc_key cx e)) (ic_static_value cx (pn_assoc_value cx e)))) in
  IvHsh (go els Nil);
let ic_static_value2 = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == pt_hash () then ic_static_hash cx (ic_nlist cx (pn_hash_elements cx n) (pn_hash_elements_b cx n))
  else if ty == pt_range () then
    (let lo = pn_range_left cx n in
     let hi = pn_range_right cx n in
     IvRng ((if lo >= 0 then ic_static_value cx lo else IvNil), (if hi >= 0 then ic_static_value cx hi else IvNil), pq_range_exclude_end cx n))
  else if ty == pt_regular_expression () then ic_regexp_literal cx (ic_str cx (pn_regular_expression_unescaped cx n), ic_enc cx) n
  else ic_refuse ("a literal " ++ ic_type_name ty ++ " is not compiled yet");

// pm_interpolated_node_compile: adjacent literal pieces are one, the first at
// the string's own place, a later one at its part's end (an interpolation of
// a string alone is a literal piece, at the part's start); a lone
// interpolation has an empty string before it, and pieces that are all
// literal are one string pushed as it is. Answers how many pieces were
// pushed and which they are: L its own text, C computed.
let ic_dstr_parts = fn cx -> fn (u: int) -> fn (n: int) -> fn (regexp: bool) ->
  let parts = ic_parts cx n in
  let nparts = ic_llen parts in
  let is_str = ic_ty cx n == pt_interpolated_string () in
  // (a literal piece of an interpolated pattern is in the pattern's named
  //  encoding when it names one, else as a String literal is)
  let piece = fn (p: int) ->
    (let v = ic_str_pair (ic_string_value cx p) in
     if regexp then
       (let e = ic_rx_explicit_encoding cx n in
        if str_len e > 0 then (ic_str cx (pn_string_unescaped cx p), e) else v)
     else v) in
  let push = fn (cur: str * str) -> fn (line: int) -> fn (node: int) -> fn (name: str) ->
    (let (s, e) = cur in
     let _ = ic_at cx u line node in
     ic_i1 cx u name (OVal (IvStr (s, e)))) in
  let rec go = fn (ps: int list) -> fn (i: int) -> fn (count: int) -> fn (kinds: str) -> fn (have: bool) -> fn (cur: str * str) ->
               fn (cl: int) -> fn (cn: int) -> fn (interpolated: bool) ->
    (match ps with
     | Nil ->
       if have then
         (let _ = push cur cl cn (if count > 0 || (is_str && pq_interpolated_string_frozen cx n) then "putobject"
                                  else if (is_str && pq_interpolated_string_mutable cx n) || interpolated then "putstring"
                                  else "putchilledstring") in
          (count + 1, kinds ++ "L"))
       else (count, kinds)
     | Cons (part, t) ->
       (let ty = ic_ty cx part in
        if ty == pt_string () then
          (if have then go t (i + 1) count kinds true (ic_str_cat cur (piece part)) cl cn interpolated
           else go t (i + 1) count kinds true (piece part) (if i != 0 then ic_end_line cx part else cl) (if i != 0 then ic_nid cx part else cn) interpolated)
        else
          (let st = (if ty == pt_embedded_statements () then pn_embedded_statements_statements cx part else 0 - 1) in
           let lone = (if st >= 0 && pn_statements_body_b cx st == 1 then ic_li cx (pn_statements_body cx st) 0 else 0 - 1) in
           if lone >= 0 && ic_ty cx lone == pt_string () then
             (if have then go t (i + 1) count kinds true (ic_str_cat cur (piece lone)) cl cn true
              else go t (i + 1) count kinds true (piece lone) (ic_start_line cx part) (ic_nid cx part) true)
           else
             // (a lone interpolation starts from an empty String in the
             //  source's encoding; a pattern's in the one its n / u / e / s
             //  names, binary in a US-ASCII source: pm_compile_interpolated's
             //  parts_size == 1)
             (let (have2, cur2) =
                (if (if have then false else true) && nparts == 1 then
                   (let enc0 = ic_enc cx in
                    let enc = (if regexp then
                                 (let x = ic_rx_explicit_encoding cx n in
                                  if str_len x > 0 then x else if str_eq enc0 "US-ASCII" then ic_binary () else enc0)
                               else enc0) in
                    (true, ("", enc)))
                 else (have, cur)) in
              let (count2, kinds2) =
                (if have2 then (let _ = push cur2 cl cn "putobject" in (count + 1, kinds ++ "L")) else (count, kinds)) in
              let _ =
                (if ty == pt_embedded_statements () then
                   // (`#{}`: a nil no node stands for -- PUSH_SYNTHETIC_PUTNIL)
                   (if st < 0 || pn_statements_body_b cx st == 0 then
                      (let _ = ic_at cx u (ic_start_line cx part) (0 - 1) in ic_i0 cx u "putnil")
                    else ic_node cx u st false)
                 else if ty == pt_interpolated_string () then ic_node cx u part false
                 // ("#@a", "#$g", "#@@c": the variable read)
                 else if ty == pt_embedded_variable () then ic_node cx u (pn_embedded_variable_variable cx part) false
                 else ic_refuse (ic_type_name ty ++ " in a string is not compiled yet")) in
              let _ = ic_here cx u part in
              let _ = ic_i0 cx u "dup" in
              let _ = ic_i1 cx u "objtostring" (ic_cd "to_s" 20 0) in
              let _ = ic_i0 cx u "anytostring" in
              go t (i + 1) (count2 + 1) (kinds2 ++ "C") false ("", "UTF-8") cl cn true)))) in
  go parts 0 0 "" false ("", "UTF-8") (ic_start_line cx n) (ic_nid cx n) false;

let ic_dstr = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  if ic_ty cx n == pt_interpolated_string () && ic_static_literal cx n then
    // (a static one -- `"#{"a"}"` -- is its string, at its own place)
    (if popped then ()
     else
       (let (s, e) = ic_static_concat cx (ic_parts cx n) in
        let _ = ic_here cx u n in
        ic_i1 cx u (if pq_interpolated_string_frozen cx n then "putobject"
                    else if pq_interpolated_string_mutable cx n then "putstring" else "putchilledstring") (OVal (IvStr (s, e)))))
  else
    (let (count, _) = ic_dstr_parts cx u n false in
     let _ = ic_here cx u n in
     let _ = (if count > 1 then ic_in cx u "concatstrings" count else ()) in
     ic_pop_if cx u popped);

// pm_compile_regexp_dynamic: the pieces as an interpolated string's, and
// toregexp of them with the literal's options. (`n` under the node id
// `nid`: in a `once` sequence the pattern's instructions are the scope's.)
let ic_dregexp = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let (count, kinds) = ic_dstr_parts cx u n true in
  let _ = ic_here cx u n in
  let ins = ic_insn cx u "toregexp" (Cons (ONum (bit_and (ic_rx_options cx n) 255), Cons (ONum count, Nil))) in
  // (for the VM: the literal's flags as written and which pieces are its own
  //  text, L, and which were computed, C -- what decides the pattern's
  //  encoding and whose clash is whose error)
  let fl = (if ic_rx cx n 4 then "i" else "") ++ (if ic_rx cx n 8 then "x" else "") ++ (if ic_rx cx n 16 then "m" else "")
           ++ (if ic_rx cx n 128 then "n" else "") ++ (if ic_rx cx n 512 then "u" else "") ++ (if ic_rx cx n 64 then "e" else "")
           ++ (if ic_rx cx n 256 then "s" else "") in
  let _ = ic_set_vmx cx ins (Cons (OVal (IvStr (fl ++ "|" ++ kinds, "")), Nil)) in
  ic_pop_if cx u popped;

// pm_compile_hash_elements: runs of pairs pushed and made a hash (newhash,
// then core#hash_merge_ptr onto it), a leading static run -- or one of 0x800
// or more -- as a literal hash, and each ** merged in with
// core#hash_merge_kwd (a call's lone ** is passed as it is)
let ic_hash_elements = fn cx -> fn (u: int) -> fn (n: int) -> fn (off: int) -> fn (cnt: int) -> fn (argument: bool) ->
  let line = ic_start_line cx n in
  let nid = ic_nid cx n in
  let at = fn (x: unit) -> ic_at cx u line nid in
  // (the pairs pushed and not yet in the hash are built aside: `anchor`)
  let flush = fn (stack: int) -> fn (first: bool) -> fn (anchor: int) ->
    if stack == 0 then first
    else if first then
      (let _ = ic_append cx u anchor in
       let _ = at () in
       let _ = ic_in cx u "newhash" stack in
       false)
    else
      (let _ = at () in
       let _ = ic_in cx u "putspecialobject" 1 in
       let _ = ic_i0 cx u "swap" in
       let _ = ic_append cx u anchor in
       let _ = at () in
       let _ = ic_push_send cx u "core#hash_merge_ptr" (stack + 1) in
       false) in
  let rec go = fn (index: int) -> fn (stack: int) -> fn (first: bool) -> fn (static_run: bool) -> fn (anchor: int) ->
    if index >= cnt then (let _ = flush stack first anchor in ())
    else
      (let e = ic_li cx off index in
       if ic_ty cx e == pt_assoc () then
         // (MIN_TMP_HASH 0x800, MAX_HASH_STACK 0x100)
         (let cand = ic_static_literal cx e && (((if static_run then false else true) && index + 2048 < cnt) || (first && stack == 0)) in
          let rec run = fn (c: int) -> if index + c < cnt && ic_static_literal cx (ic_li cx off (index + c)) then run (c + 1) else c in
          let count = (if cand then run 1 else 0) in
          if cand && ((first && stack == 0) || count >= 2048) then
            (let h = ic_static_hash cx (ic_nlist cx (off + index) count) in
             let f1 = flush stack first anchor in
             let _ = at () in
             let _ = (if f1 then ic_i1 cx u "duphash" (OVal h)
                      else
                        (let _ = ic_in cx u "putspecialobject" 1 in
                         let _ = ic_i0 cx u "swap" in
                         let _ = ic_i1 cx u "putobject" (OVal h) in
                         ic_push_send cx u "core#hash_merge_kwd" 2)) in
             go (index + count) 0 false static_run (ic_list_new cx))
          else
            (let saved = ic_capture_begin cx u in
             let _ = ic_node cx u e false in
             let got = ic_capture_end cx u saved in
             let _ = ic_list_append cx anchor got in
             let sr = (if cand then true else (if ic_static_literal cx e && (((if static_run then false else true) && index + 2048 < cnt) || (first && stack == 0)) then static_run else false)) in
             if stack + 2 >= 256 then go (index + 1) 0 (flush (stack + 2) first anchor) sr (ic_list_new cx)
             else go (index + 1) (stack + 2) first sr anchor))
       else
         (let f0 = flush stack first anchor in
          let v = pn_assoc_splat_value cx e in
          let empty = v >= 0 && ((ic_ty cx v == pt_hash () && pn_hash_elements_b cx v == 0) || ic_ty cx v == pt_nil ()) in
          let first_el = f0 in
          let only = first_el && index == cnt - 1 in
          let _ =
            (if empty then
               (let _ = at () in
                if only && argument then ic_i0 cx u "putnil" else if first_el then ic_in cx u "newhash" 0 else ())
             else if only && argument then ic_node cx u e false
             else
               (let _ = at () in
                let _ = ic_in cx u "putspecialobject" 1 in
                let _ = (if first_el then ic_in cx u "newhash" 0 else ic_i0 cx u "swap") in
                let _ = ic_node cx u e false in
                let _ = at () in
                ic_push_send cx u "core#hash_merge_kwd" 2)) in
          go (index + 1) 0 false false (ic_list_new cx))) in
  go 0 0 true false (ic_list_new cx);

// PM_HASH_NODE: a static literal is newhash 0 or duphash; popped, only what
// the elements do; otherwise pm_compile_hash_elements
let ic_hash_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let off = pn_hash_elements cx n in
  let cnt = pn_hash_elements_b cx n in
  if ic_static_literal cx n then
    (if popped then () else if cnt == 0 then ic_in cx u "newhash" 0 else ic_i1 cx u "duphash" (OVal (ic_static_value cx n)))
  else if popped then list_iter (ic_nlist cx off cnt) (fn (e: int) -> ic_node cx u e true)
  else ic_hash_elements cx u n off cnt false;

let ic_range_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let excl = pq_range_exclude_end cx n in
  let lo = pn_range_left cx n in
  let hi = pn_range_right cx n in
  // (pm_optimizable_range_item_p: no bound, an Integer or a written nil)
  let lit = fn (e: int) -> e < 0 || ic_ty cx e == pt_integer () || ic_ty cx e == pt_nil () in
  let val = fn (e: int) -> if e >= 0 && ic_ty cx e == pt_integer () then ic_static_value cx e else IvNil in
  if lit lo && lit hi then (if popped then () else ic_i1 cx u "putobject" (OVal (IvRng (val lo, val hi, excl))))
  else
    // (an absent bound's nil is the range node's own instruction; a Range
    //  nobody reads is only what its bounds do)
    (let side = fn (e: int) ->
       if e >= 0 then ic_node cx u e popped
       else if popped then () else (let _ = ic_here cx u n in ic_i0 cx u "putnil") in
     let _ = side lo in
     let _ = side hi in
     if popped then () else (let _ = ic_here cx u n in ic_in cx u "newrange" (if excl then 1 else 0)));

let ic_logical = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let is_and = ic_ty cx n == pt_and () in
  let l_end = ic_new_label cx u in
  let _ = ic_node cx u (if is_and then pn_and_left cx n else pn_or_left cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = ic_il cx u (if is_and then "branchunless" else "branchif") l_end in
  let _ = (if popped then () else ic_i0 cx u "pop") in
  let _ = ic_node cx u (if is_and then pn_and_right cx n else pn_or_right cx n) popped in
  ic_emit_label cx u l_end;

// -- constants, definitions -----------------------------------------------------
// pm_compile_constant_read: at the name, of the node it is read for
let ic_constant_read = fn cx -> fn (u: int) -> fn (name: str) -> fn (line: int) -> fn (n: int) ->
  let _ = ic_at cx u line (ic_nid cx n) in
  ic_i1 cx u "opt_getconstant_path" (OIc (Cons (ic_sym cx name, Nil)));
// a constant path made of names alone -- `X`, `A::B`, `::C` -- is one
// opt_getconstant_path over its segments: (is it one, the segments)
let rec ic_constant_path = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == pt_constant_read () then (true, Cons (ic_sym cx (ic_cname cx (pn_constant_read_name cx n)), Nil))
  else if ty == pt_constant_path () then
    (let nm = ic_sym cx (ic_cname cx (pn_constant_path_name cx n)) in
     if pn_constant_path_parent cx n < 0 then (true, Cons (IvSym ("", "US-ASCII"), Cons (nm, Nil)))
     else
       (let (ok, segs) = ic_constant_path cx (pn_constant_path_parent cx n) in
        if ok then (true, ic_cat segs (Cons (nm, Nil))) else (false, Nil)))
  else (false, (Nil : Iv list));
// (pm_compile_constant_path: what the path starts from -- nothing when it
//  starts from a name -- into `prefix`, then a getconstant a segment into
//  `body`)
let rec ic_constant_path_split = fn cx -> fn (u: int) -> fn (n: int) -> fn (prefix: int) -> fn (body: int) ->
  let ty = ic_ty cx n in
  let saved = ic_capture_begin cx u in
  if ty == pt_constant_read () then
    (let _ = ic_here cx u n in
     let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
     let _ = ic_i1 cx u "getconstant" (ic_osym cx (ic_cname cx (pn_constant_read_name cx n))) in
     ic_list_append cx body (ic_capture_end cx u saved))
  else if ty == pt_constant_path () then
    (let nm = ic_osym cx (ic_cname cx (pn_constant_path_name cx n)) in
     if pn_constant_path_parent cx n < 0 then
       (let _ = ic_here cx u n in
        let _ = ic_i0 cx u "pop" in
        let _ = ic_i1 cx u "putobject" (OVal (IvCls "Object")) in
        let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
        let _ = ic_i1 cx u "getconstant" nm in
        ic_list_append cx body (ic_capture_end cx u saved))
     else
       (let _ = ic_capture_end cx u saved in
        let _ = ic_constant_path_split cx u (pn_constant_path_parent cx n) prefix body in
        let saved2 = ic_capture_begin cx u in
        let _ = ic_here cx u n in
        let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
        let _ = ic_i1 cx u "getconstant" nm in
        ic_list_append cx body (ic_capture_end cx u saved2)))
  else
    (let _ = ic_node cx u n false in
     ic_list_append cx prefix (ic_capture_end cx u saved));

let ic_define = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let sl = ic_start_line cx n in
  let name = ic_cname cx (pn_def_name cx n) in
  let child = ic_unit_new cx 2 name (ic_u_path cx u) (ic_u_abs_path cx u) sl
                (ic_cnames cx (pn_def_locals cx n) (pn_def_locals_b cx n)) u (ic_loc4 cx n) (ic_nid cx n) in
  let _ = ic_params cx child (pn_def_parameters cx n) in
  let _ = ic_u_set cx child 18 1 in
  // (iseq_location_setup: a method named initialize takes a block)
  let _ = (if str_eq name "initialize" then ic_u_set_pflag cx child 4 else ()) in
  let _ = ic_add_child cx u child in
  let body = pn_def_body cx n in
  let is_st = body >= 0 && ic_ty cx body == pt_statements () in
  let first = (if is_st && pn_statements_body_b cx body > 0 then ic_li cx (pn_statements_body cx body) 0 else 0 - 1) in
  let _ = ic_opt_defaults cx child in
  let _ = ic_param_prologue cx child sl 0 in
  let _ = ic_at cx child (if first >= 0 then ic_start_line cx first else sl) (ic_nid cx n) in
  let _ = ic_event cx child (ic_ev_call ()) in
  let _ = (if body < 0 then (let _ = ic_at cx child (ic_u_line cx child) 0 in ic_i0 cx child "putnil")
           else ic_node cx child body false) in
  let _ = ic_event cx child (ic_ev_return ()) in
  let _ = ic_u_set cx child 11 (ic_end_line cx n) in
  let _ = ic_at cx child (ic_end_line cx n) (ic_nid cx n) in
  let _ = ic_i0 cx child "leave" in
  let _ = ic_finish cx child in
  let _ = (if pn_def_receiver cx n >= 0 then
             (let _ = ic_node cx u (pn_def_receiver cx n) false in
              let _ = ic_here cx u n in
              ic_i2 cx u "definesmethod" (ic_osym cx name) (OSeq child))
           else
             (let _ = ic_here cx u n in
              ic_i2 cx u "definemethod" (ic_osym cx name) (OSeq child))) in
  if popped then () else ic_i1 cx u "putobject" (ic_osym cx name);

let ic_node3 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == pt_def () then ic_define cx u n popped
  else if ty == pt_constant_read () then
    (let _ = ic_constant_read cx u (ic_cname cx (pn_constant_read_name cx n)) (ic_start_line cx n) n in
     ic_pop_if cx u popped)
  else if ty == pt_constant_path () then
    (let (ok, segs) = ic_constant_path cx n in
     let _ =
       (if ok then ic_i1 cx u "opt_getconstant_path" (OIc segs)
        else
          (let prefix = ic_list_new cx in
           let body = ic_list_new cx in
           let _ = ic_constant_path_split cx u n prefix body in
           let _ = ic_here cx u n in
           let _ = (if ic_list_empty cx prefix then ic_i0 cx u "putnil" else ic_append cx u prefix) in
           ic_append cx u body)) in
     let _ = ic_here cx u n in
     ic_pop_if cx u popped)
  else if ty == pt_interpolated_string () then ic_dstr cx u n popped
  else if ty == pt_hash () then ic_hash_node cx u n popped
  // (PM_KEYWORD_HASH_NODE as a value -- `return **h`: its elements made a
  //  Hash, never a literal one)
  else if ty == pt_keyword_hash () then
    (let _ = ic_hash_elements cx u n (pn_keyword_hash_elements cx n) (pn_keyword_hash_elements_b cx n) false in
     ic_pop_if cx u popped)
  else if ty == pt_range () then ic_range_node cx u n popped
  else if ty == pt_and () || ty == pt_or () then ic_logical cx u n popped
  else if ty == pt_regular_expression () then
    (if popped then () else ic_i1 cx u "putobject" (OVal (ic_regexp_literal cx (ic_str cx (pn_regular_expression_unescaped cx n), ic_enc cx) n)))
  else if ty == pt_interpolated_regular_expression () then
    (if ic_rx cx n 32 then ic_refuse "a /o pattern is not compiled yet"
     // (every piece a literal: the Regexp itself)
     else if ic_static_literal cx n then
       (if popped then () else ic_i1 cx u "putobject" (OVal (ic_regexp_literal cx (ic_static_concat cx (ic_parts cx n)) n)))
     else ic_dregexp cx u n popped)
  else if ty == pt_interpolated_symbol () then
    (let (count, _) = ic_dstr_parts cx u n false in
     let _ = ic_here cx u n in
     let _ = (if count > 1 then ic_in cx u "concatstrings" count else ()) in
     let _ = ic_here cx u n in
     let _ = ic_i0 cx u "intern" in
     ic_pop_if cx u popped)
  else if ty == pt_xstring () then
    // (`x`: self.`("x")
    (let _ = ic_i0 cx u "putself" in
     let _ = ic_i1 cx u "putobject" (OVal (IvStr (ic_str cx (pn_xstring_unescaped cx n), ic_enc cx))) in
     let _ = ic_i2 cx u "send" (ic_cd "`" 20 1) (OSeq (0 - 1)) in
     ic_pop_if cx u popped)
  else if ty == pt_interpolated_xstring () then
    (let _ = ic_i0 cx u "putself" in
     let (count, _) = ic_dstr_parts cx u n false in
     let _ = ic_here cx u n in
     let _ = (if count > 1 then ic_in cx u "concatstrings" count else ()) in
     let _ = ic_here cx u n in
     let _ = ic_i2 cx u "send" (ic_cd "`" 20 1) (OSeq (0 - 1)) in
     ic_pop_if cx u popped)
  else if ty == pt_lambda () then
    (let ps = pn_lambda_parameters cx n in
     let ol = pn_lambda_operator_loc cx n + pn_lambda_operator_loc_b cx n in
     let (l0, c0) = (if ps >= 0 then (ic_start_line cx ps, ic_start_col cx ps) else (ic_line_of cx ol, ic_col_of cx ol)) in
     let blk = ic_block_unit cx u n (ic_line_of cx (pn_lambda_opening_loc cx n)) l0 c0 in
     let _ = ic_here cx u n in
     let _ = ic_in cx u "putspecialobject" 1 in
     let _ = ic_i2 cx u "send" (ic_cd "lambda" 4 0) (OSeq blk) in
     ic_pop_if cx u popped)
  else ic_refuse (ic_type_name ty ++ " is not compiled yet");
