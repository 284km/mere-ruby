// The native ISeq compiler's front end (note 552 §11): prism_compile.c's
// instructions for each node, as lib/iseq_compiler_ext.rb ports them --
// that file's `node` and the functions it hands a node to, in its order.
//
// What is not here yet is refused by name (ic_refuse), as the Ruby compiler
// refuses what it does not compile: the caller then has the Ruby compiler
// or the evaluator take the file.
import "m_ic_export.mere";

let ic_refuse = fn (msg: str) -> fail ("IC-REFUSED: " ++ msg);
let ic_binary = fn (u: unit) -> "ASCII-8BIT";

// VM_CALL_* (vm_callinfo.h)
let ic_f_splat = fn (u: unit) -> 1;
let ic_f_blockarg = fn (u: unit) -> 2;
let ic_f_fcall = fn (u: unit) -> 4;
let ic_f_vcall = fn (u: unit) -> 8;
let ic_f_simple = fn (u: unit) -> 16;
let ic_f_kwarg = fn (u: unit) -> 32;
let ic_f_kw_splat = fn (u: unit) -> 64;
let ic_f_super = fn (u: unit) -> 256;
let ic_f_zsuper = fn (u: unit) -> 512;
let ic_f_kw_splat_mut = fn (u: unit) -> 2048;
let ic_f_splat_mut = fn (u: unit) -> 4096;
let ic_f_forwarding = fn (u: unit) -> 8192;

// the names of a constant[] field
let ic_cnames = fn cx -> fn (off: int) -> fn (cnt: int) ->
  let rec go = fn (i: int) -> if i >= cnt then (Nil : str list) else Cons (ic_cname cx (ic_li cx off i), go (i + 1)) in
  go 0;
// the nodes of a node[] field
let ic_nlist = fn cx -> fn (off: int) -> fn (cnt: int) ->
  let rec go = fn (i: int) -> if i >= cnt then (Nil : int list) else Cons (ic_li cx off i, go (i + 1)) in
  go 0;
let ic_loc4 = fn cx -> fn (n: int) -> (ic_start_line cx n, ic_start_col cx n, ic_end_line cx n, ic_end_col cx n);
let ic_tyis = fn cx -> fn (n: int) -> fn (t: int) -> n >= 0 && ic_ty cx n == t;

// compile.c's new_callinfo: keywords are counted in argc, and a call without
// a splat, a block argument, keywords, forwarding or a block is ARGS_SIMPLE
let ic_ci = fn (mid: str) -> fn (argc: int) -> fn (flag0: int) -> fn (kws: str list) -> fn (has_kw: bool) -> fn (blk: bool) ->
  let f1 = (if has_kw then bit_or flag0 32 else flag0) in
  let f2 = (if bit_and f1 (1 + 2 + 32 + 64 + 8192) == 0 && (if blk then false else true) then bit_or f1 16 else f1) in
  OCall (mid, f2, argc + (if has_kw then ic_llen kws else 0), kws, has_kw);
// (CallData.new: the flag as it is given)
let ic_cd = fn (mid: str) -> fn (flag: int) -> fn (argc: int) -> OCall (mid, flag, argc, Nil, false);
// (PUSH_SEND_R: a send at the current place, of no block)
let ic_push_send = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) ->
  ic_i2 cx u "send" (ic_ci mid argc 0 Nil false false) (OSeq (0 - 1));
let ic_push_send_f = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) -> fn (flag: int) ->
  ic_i2 cx u "send" (ic_ci mid argc flag Nil false false) (OSeq (0 - 1));

// a local's operands: where it is in its table, and how many sequences out
let ic_local_ref = fn cx -> fn (u: int) -> fn (name: str) ->
  let (lv, owner) = ic_level_of cx u name in
  if owner < 0 then ic_refuse ("local " ++ name ++ " not found")
  else
    (let i = ic_index_of cx owner name in
     // (VM_ENV_DATA_SIZE 3)
     Cons (OLoc (name, i, ic_llen (ic_u_locals cx owner) - i + 2), Cons (ONum lv, Nil)));
let ic_getlocal = fn cx -> fn (u: int) -> fn (name: str) -> (let _ = ic_insn cx u "getlocal" (ic_local_ref cx u name) in ());
let ic_setlocal = fn cx -> fn (u: int) -> fn (name: str) -> (let _ = ic_insn cx u "setlocal" (ic_local_ref cx u name) in ());
// (the name of the hidden local a block that reads `it` has for it)
let ic_it_param = fn (u: unit) -> chr 1 ++ "-1";

// -- literals -------------------------------------------------------------------
// parse_string_encoded: an escape can force a String literal's encoding over
// the source's -- binary for `\xFF` in a US-ASCII source, UTF-8 for `é`
// there
let ic_string_value = fn cx -> fn (n: int) ->
  IvStr (ic_str cx (pn_string_unescaped cx n),
         (if pq_string_forced_binary_encoding cx n then ic_binary ()
          else if pq_string_forced_utf8_encoding cx n then "UTF-8" else ic_enc cx));
// (parse_string_symbol: an escape can force the symbol's encoding -- UTF-8,
//  binary, US-ASCII -- over the source's)
let ic_symbol_value = fn cx -> fn (n: int) ->
  let s = ic_str cx (pn_symbol_unescaped cx n) in
  let e = (if pq_symbol_forced_utf8_encoding cx n then "UTF-8"
           else if pq_symbol_forced_binary_encoding cx n then ic_binary ()
           else if pq_symbol_forced_us_ascii_encoding cx n then "US-ASCII" else ic_enc cx) in
  // (a Symbol of ASCII bytes is US-ASCII whatever its String was)
  IvSym (s, (if ic_ascii s then "US-ASCII" else e));
let ic_integer_value = fn cx -> fn (a: int) -> fn (b: int) -> if b == 1 then IvInt a else IvBig (ic_str cx a);

let rec ic_static_value = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == px_array () then IvArr (ic_map (fn (e: int) -> ic_static_value cx e) (ic_nlist cx (pn_array_elements cx n) (pn_array_elements_b cx n)))
  else if ty == px_nil () then IvNil
  else if ty == px_true () then IvTrue
  else if ty == px_false () then IvFalse
  else if ty == px_string () then ic_string_value cx n
  else if ty == px_symbol () then ic_symbol_value cx n
  else if ty == px_integer () then ic_integer_value cx (pn_integer_value cx n) (pn_integer_value_b cx n)
  else if ty == px_float () then IvFlt (vec_get (ic_dbls cx) (pn_float_value cx n))
  // (Prism's tree has the literal's numerator and denominator as written:
  //  1.2r is 12/10 there, 6/5 as a Rational)
  else if ty == px_rational () then
    (match (ic_integer_value cx (pn_rational_numerator cx n) (pn_rational_numerator_b cx n),
            ic_integer_value cx (pn_rational_denominator cx n) (pn_rational_denominator_b cx n)) with
     | (IvInt a, IvInt b) ->
       (let rec gcd = fn (x: int) -> fn (y: int) -> if y == 0 then x else gcd y (x % y) in
        let g = gcd (if a < 0 then 0 - a else a) b in
        if g <= 1 then IvRat (IvInt a, IvInt b) else IvRat (IvInt (a / g), IvInt (b / g)))
     | _ -> ic_refuse "a Rational literal past 64 bits is not compiled yet")
  else if ty == px_imaginary () then IvCpx (IvInt 0, ic_static_value cx (pn_imaginary_numeric cx n))
  // (pm_static_literal_value: __LINE__ is its line -- an element of a
  //  literal Array or Hash, a `when`'s value)
  else if ty == px_source_line () then IvInt (ic_start_line cx n)
  else ic_static_value2 cx n;

// -- entry ----------------------------------------------------------------------
// (the scope's `leave` is the scope node's, on its closing line when it has
//  one -- a def's `end`, a block's `}` -- and the last line otherwise)
let ic_compile_body = fn cx -> fn (u: int) -> fn (stmts: int) -> fn (node_id: int) -> fn (end_line: int) ->
  // (a block's body sits between its start and end labels, which its redo /
  //  next entries and a `next` in it name)
  let _ = (if ic_u_type cx u == 1 then
             (let a = ic_new_label cx u in
              let b = ic_new_label cx u in
              let _ = ic_u_set cx u 21 a in
              let _ = ic_u_set cx u 22 b in
              ic_emit_label cx u a)
           else ()) in
  // (a body with rescue / ensure is a BeginNode)
  let _ = (if stmts < 0 || (ic_ty cx stmts == px_statements () && pn_statements_body_b cx stmts == 0) then
             (let _ = ic_at cx u (ic_u_line cx u) node_id in ic_i0 cx u "putnil")
           else ic_node cx u stmts false) in
  let _ = (if ic_u_type cx u == 2 then ic_event cx u (ic_ev_return ())
           else if ic_u_type cx u == 1 then
             (let _ = ic_emit_label cx u (ic_u_block_label1 cx u) in ic_event cx u (ic_ev_b_return ()))
           else ()) in
  let _ = (if end_line >= 0 then ic_u_set cx u 11 end_line else ()) in
  let _ = ic_at cx u (if ic_u_last_line cx u >= 0 then ic_u_last_line cx u else ic_u_line cx u) node_id in
  let _ = ic_i0 cx u "leave" in
  if ic_u_type cx u == 1 then
    (let st = ic_u_block_label0 cx u in
     let en = ic_u_block_label1 cx u in
     // (5 redo, 6 next)
     let _ = ic_add_catch cx u 5 st en (0 - 1) st in
     ic_add_catch cx u 6 st en (0 - 1) en)
  else ();

// The file's top sequence, compiled and finished: its number. The tree is
// read already (ic_tree_load); `label` is "<main>" or "<top (required)>".
let ic_compile = fn cx -> fn (path: str) -> fn (label: str) ->
  let root = vec_get (ic_meta cx) 5 in
  let locals = ic_cnames cx (pn_program_locals cx root) (pn_program_locals_b cx root) in
  let u = ic_unit_new cx 0 label path path 1 locals (0 - 1) (ic_loc4 cx root) (ic_nid cx root) in
  let _ = ic_compile_body cx u (pn_program_statements cx root) (ic_nid cx root) (0 - 1) in
  let _ = ic_finish cx u in
  u;

// -- nodes ----------------------------------------------------------------------
let ic_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let line = ic_start_line cx n in
  let _ = ic_at cx u line (ic_nid cx n) in
  let _ = (if ic_newline cx n && ic_u_last_line cx u != line then
             (let _ = ic_u_set cx u 11 line in ic_event cx u (ic_ev_line ()))
           else ()) in
  let ty = ic_ty cx n in
  if ty == px_statements () then
    (let off = pn_statements_body cx n in
     let cnt = pn_statements_body_b cx n in
     let rec go = fn (i: int) -> if i >= cnt then () else (let _ = ic_node cx u (ic_li cx off i) (popped || i < cnt - 1) in go (i + 1)) in
     go 0)
  else if ty == px_call () then ic_call cx u n popped false
  else if ty == px_integer () || ty == px_float () || ty == px_rational () || ty == px_imaginary () || ty == px_symbol () then
    (if popped then () else ic_i1 cx u "putobject" (OVal (ic_static_value cx n)))
  else if ty == px_nil () then (if popped then () else ic_i0 cx u "putnil")
  else if ty == px_true () then (if popped then () else ic_i1 cx u "putobject" (OVal IvTrue))
  else if ty == px_false () then (if popped then () else ic_i1 cx u "putobject" (OVal IvFalse))
  else if ty == px_self () then (if popped then () else ic_i0 cx u "putself")
  else if ty == px_string () then
    (if popped then ()
     // (`# frozen_string_literal: false` makes a literal mutable: putstring)
     else ic_i1 cx u (if pq_string_frozen cx n then "putobject" else if pq_string_mutable cx n then "putstring" else "putchilledstring") (OVal (ic_string_value cx n)))
  else if ty == px_array () then ic_array cx u n popped
  else if ty == px_local_variable_read () then
    (if popped then () else ic_getlocal cx u (ic_cname cx (pn_local_variable_read_name cx n)))
  // (`it`: the hidden parameter of the block it is read in, IT_PARAM)
  else if ty == px_it_local_variable_read () then (if popped then () else ic_getlocal cx u (ic_it_param ()))
  else if ty == px_local_variable_write () then
    (let _ = ic_node cx u (pn_local_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_setlocal cx u (ic_cname cx (pn_local_variable_write_name cx n)))
  else if ty == px_local_variable_operator_write () then
    (let name = ic_cname cx (pn_local_variable_operator_write_name cx n) in
     let _ = ic_getlocal cx u name in
     let _ = ic_node cx u (pn_local_variable_operator_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_i2 cx u "send" (ic_cd (ic_cname cx (pn_local_variable_operator_write_binary_operator cx n)) 16 1) (OSeq (0 - 1)) in
     let _ = ic_dup_unless cx u popped in
     ic_setlocal cx u name)
  else ic_node2 cx u n popped ty;

// pm_compile_array_node: a static literal is one duparray; otherwise chunks
// of up to 0x100 elements (newarray, then pushtoarray), a splat (splatarray
// true / concattoarray), and a run of 0x40 or more static elements as one
// array; popped, the array is still built and popped
let ic_array = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let off = pn_array_elements cx n in
  let cnt = pn_array_elements_b cx n in
  if ic_static_literal cx n then
    (if popped then ()
     else
       (let _ = ic_here cx u n in
        if cnt == 0 then ic_in cx u "newarray" 0 else ic_i1 cx u "duparray" (OVal (ic_static_value cx n))))
  else ic_array_core cx u n off cnt popped;
// (the elements at `off`, of the node n -- an Array, or the arguments of a
//  return / break / next, which are never one literal)
let ic_array_core = fn cx -> fn (u: int) -> fn (n: int) -> fn (off: int) -> fn (cnt: int) -> fn (popped: bool) ->
    (let container = fn (e: int) -> (let t = ic_ty cx e in t == px_array () || t == px_hash () || t == px_range ()) in
     // (the elements not yet in the array, and whether there is one yet)
     let flush = fn (size: int) -> fn (first: bool) ->
       if size > 0 then
         (let _ = ic_here cx u n in
          let _ = ic_in cx u (if first then "newarray" else "pushtoarray") size in
          false)
       else first in
     let rec go = fn (i: int) -> fn (size: int) -> fn (first: bool) -> fn (static_run: bool) ->
       if i >= cnt then (let _ = flush size first in ())
       else
         (let e = ic_li cx off i in
          let ty = ic_ty cx e in
          if ty == px_splat () then
            (let f1 = flush size first in
             let _ = (if pn_splat_expression cx e >= 0 then ic_node cx u (pn_splat_expression cx e) false
                      // (the method's anonymous *)
                      else (let _ = ic_here cx u n in ic_getlocal cx u "*")) in
             let _ = ic_here cx u n in
             let _ = (if f1 then ic_i1 cx u "splatarray" (OVal IvTrue) else ic_i0 cx u "concattoarray") in
             go (i + 1) 0 false false)
          else if ty == px_keyword_hash () then
            // (the last element: a hash pushed on, or -- when it is ** alone
            //  -- pushtoarraykwsplat, which pushes it only when it is not empty)
            (let (s1, f1) = (if size == 0 && first then (let _ = ic_here cx u n in let _ = ic_in cx u "newarray" 0 in (0, false))
                             else (0, flush size first)) in
             let eoff = pn_keyword_hash_elements cx e in
             let ecnt = pn_keyword_hash_elements_b cx e in
             let _ = ic_hash_elements cx u e eoff ecnt false in
             let rec all_splat = fn (k: int) ->
               if k >= ecnt then true else if ic_ty cx (ic_li cx eoff k) == px_assoc_splat () then all_splat (k + 1) else false in
             if all_splat 0 then
               (let _ = ic_here cx u n in
                let _ = ic_i0 cx u "pushtoarraykwsplat" in
                go (i + 1) s1 f1 static_run)
             else go (i + 1) (s1 + 1) f1 static_run)
          // (MIN_TMP_ARRAY 0x40, MAX_NEW_ARRAY 0x100)
          else if ic_static_literal cx e && (if container e then false else true) && (if static_run then false else true) && i + 64 < cnt then
            (let rec run = fn (r: int) ->
               if r < cnt && ic_static_literal cx (ic_li cx off r) && (if container (ic_li cx off r) then false else true) then run (r + 1) else r in
             let r = run (i + 1) in
             if r - i >= 64 then
               (let rec vals = fn (k: int) -> if k >= r then (Nil : Iv list) else Cons (ic_static_value cx (ic_li cx off k), vals (k + 1)) in
                let tmp = OVal (IvArr (vals i)) in
                let f1 = flush size first in
                let _ = ic_here cx u n in
                let _ = (if f1 then ic_i1 cx u "duparray" tmp
                         else (let _ = ic_i1 cx u "putobject" tmp in ic_i0 cx u "concattoarray")) in
                go r 0 false static_run)
             else
               (let _ = ic_node cx u e false in
                if size + 1 >= 256 then go (i + 1) 0 (flush (size + 1) first) true else go (i + 1) (size + 1) first true))
          else
            (let _ = ic_node cx u e false in
             if size + 1 >= 256 then go (i + 1) 0 (flush (size + 1) first) false else go (i + 1) (size + 1) first false)) in
     let _ = go 0 0 true false in
     let _ = ic_here cx u n in
     ic_pop_if cx u popped);

// (is this name the block parameter of the method it is a local of)
let ic_block_param = fn cx -> fn (u: int) -> fn (name: str) ->
  let (_, owner) = ic_level_of cx u name in
  owner >= 0 && (if ic_through (ic_u_type cx owner) then false else true) && ic_u_block_start cx owner >= 0
  && ic_index_str (ic_u_locals cx owner) name 0 == ic_u_block_start cx owner;

// pm_setup_args_dup_rest_p: whether evaluating n could change an array being
// splatted
let rec ic_dup_rest_p = fn cx -> fn (n: int) ->
  let t = ic_ty cx n in
  if t == px_back_reference_read () || t == px_class_variable_read () || t == px_constant_read () || t == px_false ()
     || t == px_float () || t == px_global_variable_read () || t == px_imaginary () || t == px_instance_variable_read ()
     || t == px_integer () || t == px_lambda () || t == px_local_variable_read () || t == px_nil ()
     || t == px_numbered_reference_read () || t == px_rational () || t == px_regular_expression () || t == px_self ()
     || t == px_string () || t == px_symbol () || t == px_true () then false
  else if t == px_constant_path () then (if pn_constant_path_parent cx n >= 0 then ic_dup_rest_p cx (pn_constant_path_parent cx n) else false)
  else if t == px_implicit () then ic_dup_rest_p cx (pn_implicit_value cx n)
  else if t == px_array () then
    (let off = pn_array_elements cx n in
     let cnt = pn_array_elements_b cx n in
     let rec any = fn (i: int) -> if i >= cnt then false else if ic_dup_rest_p cx (ic_li cx off i) then true else any (i + 1) in
     any 0)
  else true;

// pm_setup_args_core. `st` is dup_rest (SPLATARRAY_TRUE 1, DUP_SINGLE_KW_SPLAT
// 2), which a first splat that is not last takes; (line, node) is what the
// call's own instructions are at. Answers (argc, flag, keywords, whether
// there are keywords, st).
let ic_setup_args_core = fn cx -> fn (u: int) -> fn (an: int) -> fn (flag0: int) -> fn (regular_blockarg: bool) -> fn (st0: int) ->
                         fn (line: int) -> fn (node: int) ->
  // (no arguments to a call that is FCALL already -- `self[] ||= v` -- makes
  //  it VCALL too)
  if an < 0 then (0, (if bit_and flag0 4 != 0 then bit_or flag0 8 else flag0), (Nil : str list), false, st0)
  else
    (let off = pn_arguments_arguments cx an in
     let cnt = pn_arguments_arguments_b cx an in
     let at = fn (x: unit) -> ic_at cx u line node in
     let rec go = fn (index: int) -> fn (argc: int) -> fn (flag: int) -> fn (kws: str list) -> fn (has_kws: bool) ->
                  fn (has_splat: bool) -> fn (has_kw_splat: bool) -> fn (post: int) -> fn (st: int) ->
       if index >= cnt then
         (argc + (if has_splat then 1 else 0) + (if has_kw_splat then 1 else 0), flag, kws, has_kws, st)
       else
         (let a = ic_li cx off index in
          let ty = ic_ty cx a in
          if ty == px_keyword_hash () then
            (let eoff = pn_keyword_hash_elements cx a in
             let ecnt = pn_keyword_hash_elements_b cx a in
             if has_kw_splat || has_splat then
               (let single_splat = ecnt == 1 && ic_ty cx (ic_li cx eoff 0) == px_assoc_splat () in
                if ecnt > 1 || (if single_splat then false else true) then
                  (let _ = ic_hash_elements cx u a eoff ecnt true in
                   go (index + 1) argc (bit_or flag (64 + 2048)) kws has_kws has_splat true post st)
                else if bit_and st 2 != 0 then
                  (let _ = at () in
                   let _ = ic_in cx u "putspecialobject" 1 in
                   let _ = ic_in cx u "newhash" 0 in
                   let _ = ic_hash_elements cx u a eoff ecnt true in
                   let _ = at () in
                   let _ = ic_push_send cx u "core#hash_merge_kwd" 2 in
                   go (index + 1) argc (bit_or flag (64 + 2048)) kws has_kws has_splat true post st)
                else
                  (let _ = ic_hash_elements cx u a eoff ecnt true in
                   go (index + 1) argc (bit_or flag 64) kws has_kws has_splat true post st))
             else if pq_keyword_hash_symbol_keys cx a then
               // (a keyword given twice: the last one counts, the earlier
               //  values are compiled popped)
               (let key = fn (i: int) -> ic_str cx (pn_symbol_unescaped cx (pn_assoc_key cx (ic_li cx eoff i))) in
                let rec later = fn (i: int) -> fn (j: int) -> if j >= ecnt then false else if str_eq (key j) (key i) then true else later i (j + 1) in
                let rec each = fn (i: int) ->
                  if i >= ecnt then (Nil : str list)
                  else
                    (let keep = (if later i (i + 1) then false else true) in
                     let _ = ic_node cx u (pn_assoc_value cx (ic_li cx eoff i)) (if keep then false else true) in
                     if keep then Cons (key i, each (i + 1)) else each (i + 1)) in
                let ks = each 0 in
                go (index + 1) argc (bit_or flag 32) ks true has_splat has_kw_splat post st)
             else
               (let rec each = fn (i: int) ->
                  if i >= ecnt then ()
                  else (let e = ic_li cx eoff i in
                        let _ = ic_node cx u (pn_assoc_key cx e) false in
                        let _ = ic_node cx u (pn_assoc_value cx e) false in
                        each (i + 1)) in
                let _ = each 0 in
                let _ = at () in
                let _ = ic_in cx u "newhash" (ecnt * 2) in
                go (index + 1) (argc + 1) (bit_or flag (64 + (if ecnt > 1 then 2048 else 0))) kws has_kws has_splat has_kw_splat post st))
          else if ty == px_splat () then
            (let _ = (if pn_splat_expression cx a >= 0 then ic_node cx u (pn_splat_expression cx a) false
                      else (let _ = at () in ic_getlocal cx u "*")) in
             let _ = at () in
             if has_splat then
               (let _ = ic_i0 cx u "concattoarray" in
                go (index + 1) argc (bit_or flag 1) kws has_kws true has_kw_splat 0 st)
             else if index + 1 < cnt || regular_blockarg then
               (let _ = ic_i1 cx u "splatarray" (OVal (if bit_and st 1 != 0 then IvTrue else IvFalse)) in
                go (index + 1) argc (bit_or flag 1) kws has_kws true has_kw_splat 0 (bit_and st 2))
             else
               (let _ = ic_i1 cx u "splatarray" (OVal IvFalse) in
                go (index + 1) argc (bit_or flag 1) kws has_kws true has_kw_splat 0 st))
          else if ty == px_forwarding_arguments () then
            (let local = ic_local_iseq cx u in
             let _ = ic_u_set_pflag cx local 4 in
             let _ = at () in
             if ic_u_pflag cx local 16 then
               (let _ = ic_getlocal cx u "..." in
                go (index + 1) argc (bit_or flag 8192) kws has_kws has_splat has_kw_splat post st)
             else
               (let _ = ic_getlocal cx u "*" in
                let _ = (if has_splat then ic_i0 cx u "concattoarray" else ic_i1 cx u "splatarray" (OVal IvFalse)) in
                let _ = ic_getlocal cx u "**" in
                let _ = ic_insn cx u "getblockparamproxy" (ic_local_ref cx u "&") in
                go (index + 1) (argc + (if has_splat then 1 else 2)) (bit_or flag (1 + 2 + 64)) kws has_kws has_splat has_kw_splat post st))
          else
            (let _ = ic_node cx u a false in
             if has_splat then
               (let _ = at () in
                let _ =
                  (if index == cnt - 1 then ic_in cx u "pushtoarray" (post + 1)
                   else
                     (let nt = ic_ty cx (ic_li cx off (index + 1)) in
                      if nt == px_keyword_hash () || nt == px_splat () then
                        (let _ = ic_in cx u "newarray" (post + 1) in ic_i0 cx u "concatarray")
                      else if nt == px_forwarding_arguments () then ic_in cx u "pushtoarray" (post + 1)
                      else ())) in
                go (index + 1) argc flag kws has_kws has_splat has_kw_splat (post + 1) st)
             else go (index + 1) (argc + 1) flag kws has_kws has_splat has_kw_splat (post + 1) st)) in
     go 0 0 flag0 Nil false false (pq_arguments_contains_keyword_splat cx an) 0 st0);

// pm_setup_args: the arguments as the call takes them (argc, the flags, the
// keywords). A splat is `splatarray` -- one that is not last copied
// (ARGS_SPLAT_MUT), unless a block argument or keywords that cannot touch the
// array allow it not to be -- and what follows it pushed onto it; keywords
// with symbol keys are KWARG, any others a hash (KW_SPLAT, KW_SPLAT_MUT when
// it is a new one); `...` is the method's *, ** and &, or its one `...` local
// when it is forwardable
let ic_setup_args = fn cx -> fn (u: int) -> fn (an: int) -> fn (block: int) -> fn (line: int) -> fn (node: int) -> fn (flag0: int) ->
  let cnt = (if an >= 0 then pn_arguments_arguments_b cx an else 0) in
  let last = (if cnt > 0 then ic_li cx (pn_arguments_arguments cx an) (cnt - 1) else 0 - 1) in
  let dup_rest =
    (if cnt >= 2 && pq_arguments_contains_splat cx an && (if pq_arguments_contains_multiple_splats cx an then false else true)
        && ic_ty cx last == px_keyword_hash () then
       // (f(1, *a, k: v): no copy, unless a keyword could change the array)
       (let eoff = pn_keyword_hash_elements cx last in
        let ecnt = pn_keyword_hash_elements_b cx last in
        let rec any = fn (i: int) ->
          if i >= ecnt then 0
          else
            (let e = ic_li cx eoff i in
             let t = ic_ty cx e in
             if t == px_assoc () && (ic_dup_rest_p cx (pn_assoc_key cx e) || ic_dup_rest_p cx (pn_assoc_value cx e)) then 1
             else if t == px_assoc_splat () && pn_assoc_splat_value cx e >= 0 && ic_dup_rest_p cx (pn_assoc_splat_value cx e) then 1
             else any (i + 1)) in
        any 0)
     else 1) in
  if ic_tyis cx block (px_block_argument ()) then
    // (the block argument is compiled first and laid out after: what it is
    //  decides whether the splat is copied)
    (let ex = pn_block_argument_expression cx block in
     let initial = (if ex >= 0 && ic_dup_rest_p cx ex then 3 else dup_rest) in
     let saved = ic_capture_begin cx u in
     let _ = ic_node cx u block false in
     let barg = ic_capture_end cx u saved in
     let f = ic_first cx barg in
     let single = ic_kind cx f == 0 && ic_is_end cx (ic_next cx f) in
     let _ = (if single && str_eq (ic_name cx f) "getblockparam" then ic_set_name cx f "getblockparamproxy" else ()) in
     let (argc, flag, kws, has_kws, st) = ic_setup_args_core cx u an (bit_or flag0 2) (if single then false else true) initial line node in
     let _ = ic_append cx u barg in
     (argc, (if bit_and flag 1 != 0 && st != initial then bit_or flag 4096 else flag), kws, has_kws))
  else
    (let (argc, flag, kws, has_kws, st) = ic_setup_args_core cx u an flag0 false dup_rest line node in
     (argc, (if bit_and flag 1 != 0 && st != dup_rest then bit_or flag 4096 else flag), kws, has_kws));

// (PUSH_SEND_R / sendish: a send -- one that forwards `...` a sendforward)
let ic_sendish = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) -> fn (flag: int) -> fn (kws: str list) -> fn (has_kws: bool) -> fn (blk: int) ->
  ic_i2 cx u (if bit_and flag 8192 != 0 then "sendforward" else "send") (ic_ci mid argc flag kws has_kws (blk >= 0)) (OSeq blk);

// pm_compile_call_node and pm_compile_call: at the method name's line; a
// literal string's freeze / -@, an attribute write's value kept under its
// receiver (setn), &. (branchnil), a block parameter's call
// (getblockparamproxy), and `new` inlined (opt_new)
// (recv_done: pm_compile_call alone, the receiver already pushed --
//  defined?'s way with a call's receiver)
let ic_call = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (recv_done: bool) ->
  let line = (if pn_call_message_loc cx n >= 0 then ic_line_of cx (pn_call_message_loc cx n) else ic_start_line cx n) in
  let nid = ic_nid cx n in
  let at = fn (x: unit) -> ic_at cx u line nid in
  let r = pn_call_receiver cx n in
  let name = ic_cname cx (pn_call_name cx n) in
  let safe = pq_call_safe_navigation cx n in
  let args = pn_call_arguments cx n in
  let block = pn_call_block cx n in
  // (`nil&.m(...)` is nil, and nothing of it is evaluated: compile.c's
  //  optimiser folds the branchnil of a written nil and drops what follows,
  //  leaving the receiver's own putnil)
  if (if recv_done then false else true) && safe && ic_tyis cx r (px_nil ()) then
    (if popped then () else (let _ = ic_here cx u r in ic_i0 cx u "putnil"))
  else
    // (a call with a block starts at a label a break entry may name)
    (let start = ic_new_label cx u in
     let _ = (if block >= 0 && (if recv_done then false else true) then ic_emit_label cx u start else ()) in
     if (if recv_done then false else true) && (str_eq name "-@" || str_eq name "freeze") && ic_tyis cx r (px_string ())
        && (if safe then false else true) && args < 0 && block < 0 then
       (let _ = at () in
        let _ = ic_i2 cx u (if str_eq name "freeze" then "opt_str_freeze" else "opt_str_uminus") (OVal (ic_string_value cx r)) (ic_cd name 16 0) in
        ic_pop_if cx u popped)
     else
       (let write = pq_call_attribute_write cx n && (if popped then false else true) in
        let _ = at () in
        let _ = (if write && (if recv_done then false else true) then ic_i0 cx u "putnil" else ()) in
        let _ =
          (if recv_done then ()
           else if r < 0 then (let _ = at () in ic_i0 cx u "putself")
           else if str_eq name "call" && ic_ty cx r == px_local_variable_read ()
                   && ic_block_param cx u (ic_cname cx (pn_local_variable_read_name cx r)) then
             (let _ = ic_at cx u line (ic_nid cx r) in
              let _ = ic_insn cx u "getblockparamproxy" (ic_local_ref cx u (ic_cname cx (pn_local_variable_read_name cx r))) in
              ())
           else ic_node cx u r false) in
        let fcall = r < 0 || pq_call_ignore_visibility cx n in
        let else_l = (if safe then ic_new_label cx u else 0 - 1) in
        let end_l = (if safe then ic_new_label cx u else 0 - 1) in
        let _ = (if safe then
                   (let _ = at () in
                    let _ = ic_i0 cx u "dup" in
                    ic_il cx u "branchnil" else_l)
                 else ()) in
        // (where the arguments start: opt_new's putnil and swap go there)
        let prelude = ic_last cx (ic_u_list cx u) in
        let (argc, flag0, kws, has_kws) = ic_setup_args cx u args block line nid 0 in
        let blk = (if ic_tyis cx block (px_block ()) then ic_block_unit cx u block (0 - 1) (0 - 1) (0 - 1) else 0 - 1) in
        let flag1 = (if blk < 0 && pq_call_variable_call cx n then bit_or flag0 8 else flag0) in
        let flag = (if fcall then bit_or flag1 4 else flag1) in
        let _ = at () in
        let _ =
          (if write then
             // (the value is the last argument: kept under the receiver,
             //  from the splatted array's end when there is a splat)
             (if bit_and flag 2 != 0 then
                (let _ = ic_in cx u "topn" 1 in
                 let _ = (if bit_and flag 1 != 0 then
                            (let _ = ic_i1 cx u "putobject" (OVal (IvInt (0 - 1))) in ic_push_send cx u "[]" 1)
                          else ()) in
                 let _ = ic_in cx u "setn" (argc + 3) in
                 ic_i0 cx u "pop")
              else if bit_and flag 1 != 0 then
                (let _ = ic_i0 cx u "dup" in
                 let _ = ic_i1 cx u "putobject" (OVal (IvInt (0 - 1))) in
                 let _ = ic_push_send cx u "[]" 1 in
                 let _ = ic_in cx u "setn" (argc + 2) in
                 ic_i0 cx u "pop")
              else ic_in cx u "setn" (argc + 1))
           else ()) in
        // (a keyword splat the callee could keep, passed with a block
        //  argument: splatkw)
        let _ = (if bit_and flag 64 != 0 && bit_and flag 2 != 0 && bit_and flag 2048 == 0 then ic_i0 cx u "splatkw" else ()) in
        let _ =
          (if str_eq name "new" && block < 0 && bit_and flag 2 == 0 then
             (let p1 = ic_mk cx "putnil" Nil line nid in
              let p2 = ic_mk cx "swap" Nil line nid in
              let _ = ic_ins_after cx prelude p1 in
              let _ = ic_ins_after cx p1 p2 in
              let not_basic = ic_new_label cx u in
              let done = ic_new_label cx u in
              let fwd = (if bit_and flag 8192 != 0 then 1 else 0) in
              let _ = ic_i2 cx u "opt_new" (ic_ci "new" (argc + fwd) flag kws has_kws false) (OLab not_basic) in
              let _ = ic_sendish cx u "initialize" argc (bit_or flag (4 + 16384)) kws has_kws (0 - 1) in
              let _ = ic_il cx u "jump" done in
              let _ = ic_emit_label cx u not_basic in
              let _ = ic_sendish cx u "new" argc flag kws has_kws (0 - 1) in
              let _ = ic_i0 cx u "swap" in
              let _ = ic_emit_label cx u done in
              ic_i0 cx u "pop")
           else
             (let _ = ic_sendish cx u name argc flag kws has_kws blk in
              // (a block that keeps a catch table may be broken out of: the
              //  break lands just past the send)
              if blk >= 0 && (match ic_kept_catch cx blk with | Nil -> false | _ -> true) then
                (let retry_end = ic_new_label cx u in
                 let _ = ic_emit_label cx u retry_end in
                 ic_add_catch cx u 4 start retry_end blk retry_end)
              else ())) in
        let _ = (if safe then
                   (let _ = ic_il cx u "jump" end_l in
                    let _ = ic_emit_label cx u else_l in
                    ic_emit_label cx u end_l)
                 else ()) in
        let _ = (if write then ic_i0 cx u "pop" else ()) in
        ic_pop_if cx u popped));

// -- blocks and parameters ----------------------------------------------------
// PM_CONTAINER_P
let ic_container = fn cx -> fn (n: int) -> (let t = ic_ty cx n in t == px_array () || t == px_hash () || t == px_range ());
let ic_hidden = fn (k: int) -> chr 1 ++ str_of_int k;
let ic_is_hidden = fn (s: str) -> str_len s > 0 && ord (char_at s 0) == 1;
// (a parameter node's repeated_parameter? -- ParameterFlags' one flag)
let ic_repeated = fn cx -> fn (p: int) -> p >= 0 && bit_and (ic_flags cx p) 4 != 0;
// a block's or a lambda's locals, parameters and body
let ic_blk_locals = fn cx -> fn (b: int) ->
  if ic_ty cx b == px_block () then ic_cnames cx (pn_block_locals cx b) (pn_block_locals_b cx b)
  else ic_cnames cx (pn_lambda_locals cx b) (pn_lambda_locals_b cx b);
let ic_blk_params = fn cx -> fn (b: int) -> if ic_ty cx b == px_block () then pn_block_parameters cx b else pn_lambda_parameters cx b;
let ic_blk_body = fn cx -> fn (b: int) -> if ic_ty cx b == px_block () then pn_block_body cx b else pn_lambda_body cx b;

// make_name_for_block: one, and one more for each block from the scope the
// block is in up to its method's
let ic_block_label = fn cx -> fn (u: int) ->
  let levels = 1 + ic_blocks_out cx u in
  let name = ic_u_label cx (ic_local_iseq cx u) in
  if levels == 1 then "block in " ++ name else "block (" ++ str_of_int levels ++ " levels) in " ++ name;

let rec ic_str_list_remove = fn (xs: str list) -> fn (gone: str list) ->
  match xs with
  | Nil -> (Nil : str list)
  | Cons (h, t) -> if ic_has_str gone h then ic_str_list_remove t gone else Cons (h, ic_str_list_remove t gone);

// The parameters, as ruby lays them out in the local table: lead, opt, rest,
// post, keywords, the hidden kwbits slot, kwrest, block (or for `...` the
// anonymous *, ** and & and the `...` itself -- that alone when it is the
// only parameter: forwardable), then the names a destructured parameter
// binds, then the body's own locals. (a destructured parameter is a hidden
// local in its place; a block's one required parameter with no optional,
// rest, post or keyword one -- `|y|`, `|y, &b|`, `|(a, b)|`, not `|y,|` --
// is ambiguous_param0: the block takes an Array's first element or the whole
// value, as yield passes it.)
let ic_params = fn cx -> fn (unit: int) -> fn (ps: int) ->
  if ps < 0 then ()
  else
    (let names = vec_new () in
     let lookup = vec_new () in
     let _ = vec_push lookup (Nil : (str * int) list) in
     let multis = vec_new () in
     let _ = vec_push multis (Nil : (int * int) list) in
     // (the index_lookup_table: where a name is looked up -- for one given
     //  twice, `_`, the place that is not the repeated one)
     let add = fn (name: str) -> fn (p: int) ->
       (let _ = (if ic_is_hidden name || ic_repeated cx p then () else vec_set lookup 0 (Cons ((name, vec_len names), vec_get lookup 0))) in
        vec_push names name) in
     let positional = fn (r: int) ->
       if ic_ty cx r == px_multi_target () then
         (let _ = vec_set multis 0 (Cons ((vec_len names, r), vec_get multis 0)) in
          add (ic_hidden (vec_len names)) (0 - 1))
       else add (ic_cname cx (pn_required_parameter_name cx r)) r in
     let nreq = pn_parameters_requireds_b cx ps in
     let nopt = pn_parameters_optionals_b cx ps in
     let npost = pn_parameters_posts_b cx ps in
     let nkw = pn_parameters_keywords_b cx ps in
     let rest = pn_parameters_rest cx ps in
     let kwrest = pn_parameters_keyword_rest cx ps in
     let blk = pn_parameters_block cx ps in
     let _ = list_iter (ic_nlist cx (pn_parameters_requireds cx ps) nreq) positional in
     let _ = ic_u_set cx unit 24 nreq in
     let opt_nodes = ic_nlist cx (pn_parameters_optionals cx ps) nopt in
     let _ = list_iter opt_nodes (fn (o: int) -> add (ic_cname cx (pn_optional_parameter_name cx o)) o) in
     let _ = (if rest >= 0 && ic_ty cx rest != px_implicit_rest () then
                (let nm = ic_cname cx (pn_rest_parameter_name cx rest) in
                 let _ = ic_u_set cx unit 27 (vec_len names) in
                 let _ = (if str_len nm == 0 then ic_u_set_pflag cx unit 128 else ()) in
                 add (if str_len nm == 0 then "*" else nm) rest)
              else ()) in
     let _ = (if npost > 0 then
                (let _ = ic_u_set cx unit 26 (vec_len names) in
                 let _ = ic_u_set cx unit 25 npost in
                 list_iter (ic_nlist cx (pn_parameters_posts cx ps) npost) positional)
              else ()) in
     let kw_nodes = ic_nlist cx (pn_parameters_keywords cx ps) nkw in
     let _ =
       (if nkw > 0 then
          // (a default that is a static literal and no container is kept in
          //  the keyword table; any other is compiled behind checkkeyword)
          (let is_req = fn (k: int) -> ic_ty cx k == px_required_keyword_parameter () in
           let entry = fn (k: int) ->
             if is_req k then ic_sym cx (ic_cname cx (pn_required_keyword_parameter_name cx k))
             else
               (let nm = ic_sym cx (ic_cname cx (pn_optional_keyword_parameter_name cx k)) in
                let v = pn_optional_keyword_parameter_value cx k in
                if ic_static_literal cx v && (if ic_container cx v then false else true) then IvArr (Cons (nm, Cons (ic_static_value cx v, Nil)))
                else IvArr (Cons (nm, Nil))) in
           // (required ones first, as ruby keeps them)
           let rec pick = fn (ks: int list) -> fn (want_req: bool) ->
             (match ks with
              | Nil -> (Nil : int list)
              | Cons (k, t) -> if is_req k == want_req then Cons (k, pick t want_req) else pick t want_req) in
           let reqs = pick kw_nodes true in
           let opts = pick kw_nodes false in
           let _ = vec_set (ic_uw cx) unit (ic_map entry (ic_cat reqs opts)) in
           let _ = ic_u_set_pflag cx unit 32 in
           let _ = ic_u_set cx unit 33 (ic_llen reqs) in
           let _ = list_iter reqs (fn (k: int) -> add (ic_cname cx (pn_required_keyword_parameter_name cx k)) k) in
           let _ = list_iter opts (fn (k: int) -> add (ic_cname cx (pn_optional_keyword_parameter_name cx k)) k) in
           let _ = ic_u_set cx unit 29 (vec_len names) in
           add (ic_hidden (vec_len names)) (0 - 1))
        else ()) in
     let _ =
       (if kwrest < 0 then ()
        // (**nil: accepts_no_kwarg, which neither to_a nor disasm shows)
        else if ic_ty cx kwrest == px_no_keywords_parameter () then ic_u_set_pflag cx unit 2
        else if ic_ty cx kwrest == px_forwarding_parameter () then
          (let _ =
             (if nreq == 0 && nopt == 0 && nkw == 0 then (let _ = ic_u_set_pflag cx unit 16 in ic_u_set_pflag cx unit 4)
              else
                (let _ = ic_u_set cx unit 27 (vec_len names) in
                 let _ = ic_u_set_pflag cx unit 128 in
                 let _ = add "*" (0 - 1) in
                 let _ = ic_u_set cx unit 30 (vec_len names) in
                 let _ = ic_u_set_pflag cx unit 256 in
                 let _ = add "**" (0 - 1) in
                 let _ = ic_u_set cx unit 28 (vec_len names) in
                 add "&" (0 - 1))) in
           add "..." (0 - 1))
        else
          (let nm = ic_cname cx (pn_keyword_rest_parameter_name cx kwrest) in
           let _ = ic_u_set cx unit 30 (vec_len names) in
           let _ = (if str_len nm == 0 then ic_u_set_pflag cx unit 256 else ()) in
           add (if str_len nm == 0 then "**" else nm) kwrest)) in
     let _ = (if blk >= 0 then
                (let nm = ic_cname cx (pn_block_parameter_name cx blk) in
                 let _ = ic_u_set cx unit 28 (vec_len names) in
                 let _ = add (if str_len nm == 0 then "&" else nm) blk in
                 ic_u_set_pflag cx unit 4)
              else ()) in
     let ms = ic_rev (vec_get multis 0) in
     let rec dl = fn (m: int) ->
       // pm_compile_destructured_param_locals: the names of a destructured
       // parameter, in order (a repeated one -- `_` again -- has none)
       (let one = fn (r: int) -> if ic_repeated cx r then () else add (ic_cname cx (pn_required_parameter_name cx r)) r in
        let side = fn (x: int) -> if ic_ty cx x == px_multi_target () then dl x else one x in
        let _ = list_iter (ic_nlist cx (pn_multi_target_lefts cx m) (pn_multi_target_lefts_b cx m)) side in
        let mr = pn_multi_target_rest cx m in
        let _ = (if mr >= 0 && ic_ty cx mr == px_splat () && pn_splat_expression cx mr >= 0 then one (pn_splat_expression cx mr) else ()) in
        list_iter (ic_nlist cx (pn_multi_target_rights cx m) (pn_multi_target_rights_b cx m)) side) in
     let _ = list_iter ms (fn (im: int * int) -> (let (_, m) = im in dl m)) in
     let ns = vec_to_list names in
     let _ = vec_set (ic_ul cx) unit (ic_cat ns (ic_str_list_remove (ic_u_locals cx unit) ns)) in
     let _ = vec_set (ic_ux cx) unit (vec_get lookup 0) in
     let _ = vec_set (ic_um cx) unit (opt_nodes, kw_nodes, ms) in
     // (ruby asks before it counts **kw and &b: only one local so far)
     if ic_u_type cx unit == 1 && nreq == 1 && rest < 0 && nopt == 0 && npost == 0 && nkw == 0 then ic_u_set_pflag cx unit 1 else ());

// optional parameters' defaults: each behind a label of the opt table, and
// one after the last -- the body's start
let ic_opt_defaults = fn cx -> fn (unit: int) ->
  let (opt_nodes, _, _) = vec_get (ic_um cx) unit in
  match opt_nodes with
  | Nil -> ()
  | _ ->
    (let rec go = fn (os: int list) ->
       (match os with
        | Nil -> (let l = ic_new_label cx unit in let _ = ic_emit_label cx unit l in Cons (l, Nil))
        | Cons (o, t) ->
          (let l = ic_new_label cx unit in
           let _ = ic_emit_label cx unit l in
           let _ = ic_node cx unit (pn_optional_parameter_value cx o) false in
           let _ = ic_here cx unit o in
           let _ = ic_setlocal cx unit (ic_cname cx (pn_optional_parameter_name cx o)) in
           Cons (l, go t))) in
     let labels = go opt_nodes in
     let _ = list_iter labels (fn (l: int) -> (let _ = ic_set_unremovable cx l in ic_ref cx l)) in
     let _ = vec_set (ic_uo cx) unit labels in
     ic_u_set_pflag cx unit 64);

// a local by its place in the sequence's own table
let ic_local_op = fn cx -> fn (owner: int) -> fn (i: int) ->
  let ls = ic_u_locals cx owner in
  let rec nth = fn (xs: str list) -> fn (k: int) -> (match xs with | Nil -> "" | Cons (h, t) -> if k <= 0 then h else nth t (k - 1)) in
  OLoc (nth ls i, i, ic_llen ls - i + 2);

// pm_compile_destructured_param_writes: a multiple assignment whose targets
// are all the parameter's own locals
let rec ic_destructured_writes = fn cx -> fn (unit: int) -> fn (m: int) ->
  let nl = pn_multi_target_lefts_b cx m in
  let nr = pn_multi_target_rights_b cx m in
  let mr = pn_multi_target_rest cx m in
  let has_rest = mr >= 0 && ic_ty cx mr == px_splat () && pn_splat_expression cx mr >= 0 in
  let has_rights = nr > 0 in
  let write = fn (t: int) ->
    if ic_ty cx t == px_multi_target () then ic_destructured_writes cx unit t
    else (let _ = ic_here cx unit t in ic_setlocal cx unit (ic_cname cx (pn_required_parameter_name cx t))) in
  let rec each = fn (off: int) -> fn (cnt: int) -> fn (i: int) ->
    if i >= cnt then () else (let _ = write (ic_li cx off i) in each off cnt (i + 1)) in
  let _ = ic_here cx unit m in
  let _ = ic_i2 cx unit "expandarray" (ONum nl) (ONum (if has_rest || has_rights then 1 else 0)) in
  let _ = each (pn_multi_target_lefts cx m) nl 0 in
  let _ = (if has_rest then
             (let _ = (if has_rights then (let _ = ic_here cx unit m in ic_i2 cx unit "expandarray" (ONum nr) (ONum 3)) else ()) in
              write (pn_splat_expression cx mr))
           else ()) in
  if has_rights then
    (let _ = (if has_rest then () else (let _ = ic_here cx unit m in ic_i2 cx unit "expandarray" (ONum nr) (ONum 2))) in
     each (pn_multi_target_rights cx m) nr 0)
  else ();

// pm_compile_scope_node's step 5 past the optional parameters: a keyword
// default that is not in the table, behind checkkeyword (its bit among the
// optional keywords), then each destructured parameter taken apart.
// ((line, node): the scope's place -- its first line, no node)
let ic_param_prologue = fn cx -> fn (unit: int) -> fn (line: int) -> fn (node: int) ->
  let (_, kw_nodes, multis) = vec_get (ic_um cx) unit in
  let rec kws = fn (ks: int list) -> fn (oi: int) ->
    (match ks with
     | Nil -> ()
     | Cons (k, t) ->
       if ic_ty cx k != px_optional_keyword_parameter () then kws t oi
       else
         (let v = pn_optional_keyword_parameter_value cx k in
          let _ =
            (if ic_static_literal cx v && (if ic_container cx v then false else true) then ()
             else
               (let done = ic_new_label cx unit in
                let _ = ic_at cx unit line node in
                let bits = (match ic_local_op cx unit (ic_u_kwbits cx unit) with | OLoc (_, _, idx) -> idx | _ -> 0) in
                let _ = ic_i2 cx unit "checkkeyword" (ONum bits) (ONum oi) in
                let _ = ic_il cx unit "branchif" done in
                let _ = ic_node cx unit v false in
                let _ = ic_at cx unit line node in
                let _ = ic_setlocal cx unit (ic_cname cx (pn_optional_keyword_parameter_name cx k)) in
                ic_emit_label cx unit done)) in
          kws t (oi + 1))) in
  let _ = kws kw_nodes 0 in
  list_iter multis (fn (im: int * int) ->
    (let (i, m) = im in
     let _ = ic_at cx unit line node in
     let _ = ic_i2 cx unit "getlocal" (ic_local_op cx unit i) (ONum 0) in
     ic_destructured_writes cx unit m));

// A block's sequence. first_line: the line it is from when that is not the
// block's own (-1); (start_line, start_col): where its location starts when
// that is not the block's start (-1) -- a lambda's sequence starts at its
// opening and its location at its parameters, or just after the ->
let ic_block_unit = fn cx -> fn (u: int) -> fn (b: int) -> fn (first_line: int) -> fn (start_line: int) -> fn (start_col: int) ->
  let label = ic_block_label cx u in
  let sl = ic_start_line cx b in
  let loc = ((if start_line >= 0 then start_line else sl), (if start_line >= 0 then start_col else ic_start_col cx b),
             ic_end_line cx b, ic_end_col cx b) in
  let child = ic_unit_new cx 1 label (ic_u_path cx u) (ic_u_abs_path cx u) (if first_line >= 0 then first_line else sl)
                (ic_blk_locals cx b) u loc (ic_nid cx b) in
  let bp = ic_blk_params cx b in
  let _ = ic_params cx child (if ic_tyis cx bp (px_block_parameters ()) then pn_block_parameters_parameters cx bp else 0 - 1) in
  // (implicit parameters: `_1` .. `_9` are the block's first locals, as many
  //  required parameters as the highest one named; `it` is one hidden
  //  required parameter. One alone takes an Array whole or its first element
  //  as `|x|` does: ambiguous_param0.)
  let _ =
    (if ic_tyis cx bp (px_numbered_parameters ()) then
       // (the parameters come first in the table, whatever the body named
       //  before them)
       (let mx = pn_numbered_parameters_maximum cx bp in
        let rec nums = fn (i: int) -> if i > mx then (Nil : str list) else Cons ("_" ++ str_of_int i, nums (i + 1)) in
        let ns = nums 1 in
        let _ = vec_set (ic_ul cx) child (ic_cat ns (ic_str_list_remove (ic_u_locals cx child) ns)) in
        let _ = ic_u_set cx child 24 mx in
        let _ = ic_u_set cx child 32 mx in
        if mx == 1 then ic_u_set_pflag cx child 1 else ())
     else if ic_tyis cx bp (px_it_parameters ()) then
       (let it = Cons (ic_it_param (), Nil) in
        let _ = vec_set (ic_ul cx) child (ic_cat it (ic_str_list_remove (ic_u_locals cx child) it)) in
        let _ = ic_u_set cx child 24 1 in
        let _ = ic_u_set cx child 32 0 in
        ic_u_set_pflag cx child 1)
     else ()) in
  let _ = ic_add_child cx u child in
  let _ = ic_opt_defaults cx child in
  let _ = ic_param_prologue cx child sl 0 in
  let _ = ic_at cx child (ic_u_first_lineno cx child) (ic_nid cx b) in
  let _ = ic_event cx child (ic_ev_b_call ()) in
  // (the b_call is a nop's; iseq_optimize takes the nop out again when
  //  nothing comes before it and nothing needs it)
  let nop = ic_insn cx child "nop" Nil in
  let _ = ic_u_set cx child 20 nop in
  let _ = ic_compile_body cx child (ic_blk_body cx b) (ic_nid cx b) (ic_end_line cx b) in
  let _ = ic_finish cx child in
  child;

// -- the rest of `node` ---------------------------------------------------------
let ic_node2 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == px_instance_variable_read () then
    (if popped then () else ic_i2 cx u "getinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_read_name cx n))) (OIvc (ic_next_is cx u)))
  else if ty == px_instance_variable_write () then
    (let _ = ic_node cx u (pn_instance_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_i2 cx u "setinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_write_name cx n))) (OIvc (ic_next_is cx u)))
  else if ty == px_global_variable_read () then
    (let _ = ic_i1 cx u "getglobal" (ic_osym cx (ic_cname cx (pn_global_variable_read_name cx n))) in
     ic_pop_if cx u popped)
  else if ty == px_global_variable_write () then
    (let _ = ic_node cx u (pn_global_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_i1 cx u "setglobal" (ic_osym cx (ic_cname cx (pn_global_variable_write_name cx n))))
  else if ty == px_constant_write () then
    (let _ = ic_node cx u (pn_constant_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     let _ = ic_in cx u "putspecialobject" 3 in
     ic_i1 cx u "setconstant" (ic_osym cx (ic_cname cx (pn_constant_write_name cx n))))
  else if ty == px_splat () then
    (let _ = (if pn_splat_expression cx n >= 0 then ic_node cx u (pn_splat_expression cx n) popped else ()) in
     let _ = ic_here cx u n in
     if popped then () else ic_i1 cx u "splatarray" (OVal IvTrue))
  else if ty == px_source_line () then (if popped then () else ic_i1 cx u "putobject" (OVal (IvInt (ic_start_line cx n))))
  // (as a String literal is pushed: frozen, mutable or chilled)
  else if ty == px_source_file () then
    (if popped then ()
     else ic_i1 cx u (if pq_source_file_frozen cx n then "putobject" else if pq_source_file_mutable cx n then "putstring" else "putchilledstring")
            (OVal (IvStr (ic_u_path cx u, "UTF-8"))))
  else if ty == px_source_encoding () then (if popped then () else ic_i1 cx u "putobject" (OVal (IvEnc (ic_enc cx))))
  // $1 .. $9: getspecial of the number doubled; $&, $`, $', $+: of the
  // character doubled, plus 1
  else if ty == px_numbered_reference_read () then
    (if popped then ()
     else (let k = pn_numbered_reference_read_number cx n in
           if k == 0 then ic_i0 cx u "putnil" else ic_i2 cx u "getspecial" (ONum 1) (ONum (k * 2))))
  else if ty == px_back_reference_read () then
    (if popped then ()
     else ic_i2 cx u "getspecial" (ONum 1) (ONum (ord (char_at (ic_cname cx (pn_back_reference_read_name cx n)) 1) * 2 + 1)))
  else if ty == px_class_variable_read () then
    (if popped then ()
     else (let nm = ic_cname cx (pn_class_variable_read_name cx n) in ic_i2 cx u "getclassvariable" (ic_osym cx nm) (ic_cvc cx u nm)))
  else if ty == px_class_variable_write () then
    (let nm = ic_cname cx (pn_class_variable_write_name cx n) in
     let _ = ic_node cx u (pn_class_variable_write_value cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_dup_unless cx u popped in
     ic_i2 cx u "setclassvariable" (ic_osym cx nm) (ic_cvc cx u nm))
  else if ty == px_parentheses () then
    (if pn_parentheses_body cx n >= 0 then ic_node cx u (pn_parentheses_body cx n) popped
     else if popped then () else ic_i0 cx u "putnil")
  else if ty == px_assoc () then
    (let _ = ic_node cx u (pn_assoc_key cx n) popped in ic_node cx u (pn_assoc_value cx n) popped)
  else if ty == px_assoc_splat () then
    (if pn_assoc_splat_value cx n >= 0 then ic_node cx u (pn_assoc_splat_value cx n) popped
     else if popped then () else ic_getlocal cx u "**")
  else if ty == px_block_argument () then
    // (an anonymous one is the method's &, forwarded)
    (if pn_block_argument_expression cx n >= 0 then ic_node cx u (pn_block_argument_expression cx n) popped
     else (let _ = ic_insn cx u "getblockparamproxy" (ic_local_ref cx u "&") in ()))
  else if ty == px_implicit () then ic_node cx u (pn_implicit_value cx n) popped
  else ic_node3 cx u n popped ty;

// -- strings, hashes, ranges, patterns ----------------------------------------
// `a << b` of two Strings in their encodings (rb_enc_compatible): the bytes
// joined, in the first's encoding unless only the second can say what its
// bytes are
let ic_str_cat = fn (a: str * str) -> fn (b: str * str) ->
  let (s1, e1) = a in
  let (s2, e2) = b in
  let enc = (if str_eq e1 e2 || str_len s2 == 0 then e1
             else if str_len s1 == 0 then (if ic_ascii s2 then e1 else e2)
             else if ic_ascii s2 then e1
             else if ic_ascii s1 then e2 else e1) in
  (s1 ++ s2, enc);
let ic_str_pair = fn (v: Iv) -> match v with | IvStr (s, e) -> (s, e) | _ -> ("", "UTF-8");

// RegularExpressionFlags, which a pattern, an interpolated one and the two
// match-last-line nodes share: ignore_case 4, extended 8, multi_line 16,
// once 32, euc_jp 64, ascii_8bit 128, windows_31j 256, utf_8 512,
// forced_utf8 1024, forced_binary 2048, forced_us_ascii 4096
let ic_rx = fn cx -> fn (n: int) -> fn (bit: int) -> bit_and (ic_flags cx n) bit != 0;
// (Prism's #options: IGNORECASE 1, EXTENDED 2, MULTILINE 4, FIXEDENCODING 16
//  when it names an encoding, NOENCODING 32 for n)
let ic_rx_options = fn cx -> fn (n: int) ->
  (if ic_rx cx n 4 then 1 else 0) + (if ic_rx cx n 8 then 2 else 0) + (if ic_rx cx n 16 then 4 else 0)
  + (if ic_rx cx n 64 || ic_rx cx n 256 || ic_rx cx n 512 then 16 else 0) + (if ic_rx cx n 128 then 32 else 0);
// parse_regexp_encoding: the encoding a pattern's n / u / e / s names (or
// binary, when an escape forces it), "" when it names none
let ic_rx_explicit_encoding = fn cx -> fn (n: int) ->
  if ic_rx cx n 128 || ic_rx cx n 2048 then ic_binary ()
  else if ic_rx cx n 512 then "UTF-8"
  else if ic_rx cx n 64 then "EUC-JP"
  else if ic_rx cx n 256 then "Windows-31J"
  else "";
// A Regexp literal: what its maker is handed -- the source in the encoding
// the pattern names (or binary, which an escape in it can force:
// parse_regexp_encoding reads no other forced encoding), and the options
// with NOENCODING for n and FIXEDENCODING for u / e / s.
let ic_regexp_literal = fn cx -> fn (src: str * str) -> fn (n: int) ->
  let (s, e) = src in
  let o = bit_and (ic_rx_options cx n) 7 in
  if ic_rx cx n 128 then IvRx (s, o + 32, ic_binary ())
  else if ic_rx cx n 512 then IvRx (s, o + 16, "UTF-8")
  else if ic_rx cx n 64 then IvRx (s, o + 16, "EUC-JP")
  else if ic_rx cx n 256 then IvRx (s, o + 16, "Windows-31J")
  else if ic_rx cx n 2048 then IvRx (s, o, ic_binary ())
  else IvRx (s, o, e);

// the parts of an interpolated string, symbol, command, pattern
let ic_parts = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == px_interpolated_string () then ic_nlist cx (pn_interpolated_string_parts cx n) (pn_interpolated_string_parts_b cx n)
  else if ty == px_interpolated_symbol () then ic_nlist cx (pn_interpolated_symbol_parts cx n) (pn_interpolated_symbol_parts_b cx n)
  else if ty == px_interpolated_xstring () then ic_nlist cx (pn_interpolated_xstring_parts cx n) (pn_interpolated_xstring_parts_b cx n)
  else if ty == px_interpolated_regular_expression () then
    ic_nlist cx (pn_interpolated_regular_expression_parts cx n) (pn_interpolated_regular_expression_parts_b cx n)
  else ic_nlist cx (pn_interpolated_match_last_line_parts cx n) (pn_interpolated_match_last_line_parts_b cx n);
let ic_stmts_list = fn cx -> fn (st: int) ->
  if st < 0 then (Nil : int list) else ic_nlist cx (pn_statements_body cx st) (pn_statements_body_b cx st);

// pm_static_literal_concat: the pieces of a static string, joined (in their
// own encodings: the first one's is the text's unless a later piece brings
// another)
let rec ic_static_concat = fn cx -> fn (parts: int list) ->
  let rec go = fn (ps: int list) -> fn (have: bool) -> fn (acc: str * str) ->
    (match ps with
     | Nil -> if have then acc else ("", "UTF-8")
     | Cons (part, t) ->
       (let ty = ic_ty cx part in
        let v = (if ty == px_string () then ic_str_pair (ic_string_value cx part)
                 else if ty == px_interpolated_string () then ic_static_concat cx (ic_parts cx part)
                 else if ty == px_embedded_statements () then ic_static_concat cx (ic_stmts_list cx (pn_embedded_statements_statements cx part))
                 else ic_refuse (ic_type_name ty ++ " in a static string is not compiled yet")) in
        go t true (if have then ic_str_cat acc v else v))) in
  go parts false ("", "UTF-8");

// (static values, the rest: a Hash, a Range, a Regexp)
let rec ic_iv_eq = fn (a: Iv) -> fn (b: Iv) ->
  match (a, b) with
  | (IvNil, IvNil) -> true
  | (IvTrue, IvTrue) -> true
  | (IvFalse, IvFalse) -> true
  | (IvInt x, IvInt y) -> x == y
  | (IvBig x, IvBig y) -> str_eq x y
  | (IvFlt x, IvFlt y) -> float_bits_hi x == float_bits_hi y && float_bits_lo x == float_bits_lo y
  | (IvSym (x, _), IvSym (y, _)) -> str_eq x y
  // (two Strings are one key when their bytes are and their encodings
  //  agree -- or both are ASCII)
  | (IvStr (x, e1), IvStr (y, e2)) -> str_eq x y && (str_eq e1 e2 || ic_ascii x)
  | (IvArr xs, IvArr ys) -> ic_iv_list_eq xs ys
  | _ -> false;
let rec ic_iv_list_eq = fn (xs: Iv list) -> fn (ys: Iv list) ->
  match (xs, ys) with
  | (Nil, Nil) -> true
  | (Cons (x, t), Cons (y, s)) -> if ic_iv_eq x y then ic_iv_list_eq t s else false
  | _ -> false;
// a pair put in a literal Hash: a key that is there already keeps its place
// and takes the new value
let rec ic_hash_put = fn (ps: (Iv * Iv) list) -> fn (k: Iv) -> fn (v: Iv) ->
  match ps with
  | Nil -> Cons ((k, v), Nil)
  | Cons ((k0, v0), t) -> if ic_iv_eq k0 k then Cons ((k0, v), t) else Cons ((k0, v0), ic_hash_put t k v);
let ic_static_hash = fn cx -> fn (els: int list) ->
  let rec go = fn (xs: int list) -> fn (acc: (Iv * Iv) list) ->
    (match xs with
     | Nil -> acc
     | Cons (e, t) -> go t (ic_hash_put acc (ic_static_value cx (pn_assoc_key cx e)) (ic_static_value cx (pn_assoc_value cx e)))) in
  IvHsh (go els Nil);
let ic_static_value2 = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == px_hash () then ic_static_hash cx (ic_nlist cx (pn_hash_elements cx n) (pn_hash_elements_b cx n))
  else if ty == px_range () then
    (let lo = pn_range_left cx n in
     let hi = pn_range_right cx n in
     IvRng ((if lo >= 0 then ic_static_value cx lo else IvNil), (if hi >= 0 then ic_static_value cx hi else IvNil), pq_range_exclude_end cx n))
  else if ty == px_regular_expression () then ic_regexp_literal cx (ic_str cx (pn_regular_expression_unescaped cx n), ic_enc cx) n
  // (a static interpolated string is its pieces joined)
  else if ty == px_interpolated_string () then (let (s, e) = ic_static_concat cx (ic_parts cx n) in IvStr (s, e))
  else ic_refuse ("a literal " ++ ic_type_name ty ++ " is not compiled yet");

// pm_interpolated_node_compile: adjacent literal pieces are one, the first at
// the string's own place, a later one at its part's end (an interpolation of
// a string alone is a literal piece, at the part's start); a lone
// interpolation has an empty string before it, and pieces that are all
// literal are one string pushed as it is. Answers how many pieces were
// pushed and which they are: L its own text, C computed.
let ic_dstr_parts = fn cx -> fn (u: int) -> fn (n: int) -> fn (regexp: bool) ->
  let parts = ic_parts cx n in
  let nparts = ic_llen parts in
  let is_str = ic_ty cx n == px_interpolated_string () in
  // (a literal piece of an interpolated pattern is in the pattern's named
  //  encoding when it names one, else as a String literal is)
  let piece = fn (p: int) ->
    (let v = ic_str_pair (ic_string_value cx p) in
     if regexp then
       (let e = ic_rx_explicit_encoding cx n in
        if str_len e > 0 then (ic_str cx (pn_string_unescaped cx p), e) else v)
     else v) in
  let push = fn (cur: str * str) -> fn (line: int) -> fn (node: int) -> fn (name: str) ->
    (let (s, e) = cur in
     let _ = ic_at cx u line node in
     ic_i1 cx u name (OVal (IvStr (s, e)))) in
  let rec go = fn (ps: int list) -> fn (i: int) -> fn (count: int) -> fn (kinds: str) -> fn (have: bool) -> fn (cur: str * str) ->
               fn (cl: int) -> fn (cn: int) -> fn (interpolated: bool) ->
    (match ps with
     | Nil ->
       if have then
         (let _ = push cur cl cn (if count > 0 || (is_str && pq_interpolated_string_frozen cx n) then "putobject"
                                  else if (is_str && pq_interpolated_string_mutable cx n) || interpolated then "putstring"
                                  else "putchilledstring") in
          (count + 1, kinds ++ "L"))
       else (count, kinds)
     | Cons (part, t) ->
       (let ty = ic_ty cx part in
        if ty == px_string () then
          (if have then go t (i + 1) count kinds true (ic_str_cat cur (piece part)) cl cn interpolated
           else go t (i + 1) count kinds true (piece part) (if i != 0 then ic_end_line cx part else cl) (if i != 0 then ic_nid cx part else cn) interpolated)
        else
          (let st = (if ty == px_embedded_statements () then pn_embedded_statements_statements cx part else 0 - 1) in
           let lone = (if st >= 0 && pn_statements_body_b cx st == 1 then ic_li cx (pn_statements_body cx st) 0 else 0 - 1) in
           if lone >= 0 && ic_ty cx lone == px_string () then
             (if have then go t (i + 1) count kinds true (ic_str_cat cur (piece lone)) cl cn true
              else go t (i + 1) count kinds true (piece lone) (ic_start_line cx part) (ic_nid cx part) true)
           else
             // (a lone interpolation starts from an empty String in the
             //  source's encoding; a pattern's in the one its n / u / e / s
             //  names, binary in a US-ASCII source: pm_compile_interpolated's
             //  parts_size == 1)
             (let (have2, cur2) =
                (if (if have then false else true) && nparts == 1 then
                   (let enc0 = ic_enc cx in
                    let enc = (if regexp then
                                 (let x = ic_rx_explicit_encoding cx n in
                                  if str_len x > 0 then x else if str_eq enc0 "US-ASCII" then ic_binary () else enc0)
                               else enc0) in
                    (true, ("", enc)))
                 else (have, cur)) in
              let (count2, kinds2) =
                (if have2 then (let _ = push cur2 cl cn "putobject" in (count + 1, kinds ++ "L")) else (count, kinds)) in
              let _ =
                (if ty == px_embedded_statements () then
                   // (`#{}`: a nil no node stands for -- PUSH_SYNTHETIC_PUTNIL)
                   (if st < 0 || pn_statements_body_b cx st == 0 then
                      (let _ = ic_at cx u (ic_start_line cx part) (0 - 1) in ic_i0 cx u "putnil")
                    else ic_node cx u st false)
                 else if ty == px_interpolated_string () then ic_node cx u part false
                 // ("#@a", "#$g", "#@@c": the variable read)
                 else if ty == px_embedded_variable () then ic_node cx u (pn_embedded_variable_variable cx part) false
                 else ic_refuse (ic_type_name ty ++ " in a string is not compiled yet")) in
              let _ = ic_here cx u part in
              let _ = ic_i0 cx u "dup" in
              let _ = ic_i1 cx u "objtostring" (ic_cd "to_s" 20 0) in
              let _ = ic_i0 cx u "anytostring" in
              go t (i + 1) (count2 + 1) (kinds2 ++ "C") false ("", "UTF-8") cl cn true)))) in
  go parts 0 0 "" false ("", "UTF-8") (ic_start_line cx n) (ic_nid_in cx u n) false;

let ic_dstr = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  if ic_ty cx n == px_interpolated_string () && ic_static_literal cx n then
    // (a static one -- `"#{"a"}"` -- is its string, at its own place)
    (if popped then ()
     else
       (let (s, e) = ic_static_concat cx (ic_parts cx n) in
        let _ = ic_here cx u n in
        ic_i1 cx u (if pq_interpolated_string_frozen cx n then "putobject"
                    else if pq_interpolated_string_mutable cx n then "putstring" else "putchilledstring") (OVal (IvStr (s, e)))))
  else
    (let (count, _) = ic_dstr_parts cx u n false in
     let _ = ic_here cx u n in
     let _ = (if count > 1 then ic_in cx u "concatstrings" count else ()) in
     ic_pop_if cx u popped);

// pm_compile_regexp_dynamic: the pieces as an interpolated string's, and
// toregexp of them with the literal's options. (`n` under the node id
// `nid`: in a `once` sequence the pattern's instructions are the scope's.)
let ic_dregexp = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let (count, kinds) = ic_dstr_parts cx u n true in
  let _ = ic_here cx u n in
  let ins = ic_insn cx u "toregexp" (Cons (ONum (bit_and (ic_rx_options cx n) 255), Cons (ONum count, Nil))) in
  // (for the VM: the literal's flags as written and which pieces are its own
  //  text, L, and which were computed, C -- what decides the pattern's
  //  encoding and whose clash is whose error)
  let fl = (if ic_rx cx n 4 then "i" else "") ++ (if ic_rx cx n 8 then "x" else "") ++ (if ic_rx cx n 16 then "m" else "")
           ++ (if ic_rx cx n 128 then "n" else "") ++ (if ic_rx cx n 512 then "u" else "") ++ (if ic_rx cx n 64 then "e" else "")
           ++ (if ic_rx cx n 256 then "s" else "") in
  let _ = ic_set_vmx cx ins (Cons (OVal (IvStr (fl ++ "|" ++ kinds, "")), Nil)) in
  ic_pop_if cx u popped;

// pm_compile_hash_elements: runs of pairs pushed and made a hash (newhash,
// then core#hash_merge_ptr onto it), a leading static run -- or one of 0x800
// or more -- as a literal hash, and each ** merged in with
// core#hash_merge_kwd (a call's lone ** is passed as it is)
let ic_hash_elements = fn cx -> fn (u: int) -> fn (n: int) -> fn (off: int) -> fn (cnt: int) -> fn (argument: bool) ->
  let line = ic_start_line cx n in
  let nid = ic_nid cx n in
  let at = fn (x: unit) -> ic_at cx u line nid in
  // (the pairs pushed and not yet in the hash are built aside: `anchor`)
  let flush = fn (stack: int) -> fn (first: bool) -> fn (anchor: int) ->
    if stack == 0 then first
    else if first then
      (let _ = ic_append cx u anchor in
       let _ = at () in
       let _ = ic_in cx u "newhash" stack in
       false)
    else
      (let _ = at () in
       let _ = ic_in cx u "putspecialobject" 1 in
       let _ = ic_i0 cx u "swap" in
       let _ = ic_append cx u anchor in
       let _ = at () in
       let _ = ic_push_send cx u "core#hash_merge_ptr" (stack + 1) in
       false) in
  let rec go = fn (index: int) -> fn (stack: int) -> fn (first: bool) -> fn (static_run: bool) -> fn (anchor: int) ->
    if index >= cnt then (let _ = flush stack first anchor in ())
    else
      (let e = ic_li cx off index in
       if ic_ty cx e == px_assoc () then
         // (MIN_TMP_HASH 0x800, MAX_HASH_STACK 0x100)
         (let cand = ic_static_literal cx e && (((if static_run then false else true) && index + 2048 < cnt) || (first && stack == 0)) in
          let rec run = fn (c: int) -> if index + c < cnt && ic_static_literal cx (ic_li cx off (index + c)) then run (c + 1) else c in
          let count = (if cand then run 1 else 0) in
          if cand && ((first && stack == 0) || count >= 2048) then
            (let h = ic_static_hash cx (ic_nlist cx (off + index) count) in
             let f1 = flush stack first anchor in
             let _ = at () in
             let _ = (if f1 then ic_i1 cx u "duphash" (OVal h)
                      else
                        (let _ = ic_in cx u "putspecialobject" 1 in
                         let _ = ic_i0 cx u "swap" in
                         let _ = ic_i1 cx u "putobject" (OVal h) in
                         ic_push_send cx u "core#hash_merge_kwd" 2)) in
             go (index + count) 0 false static_run (ic_list_new cx))
          else
            (let saved = ic_capture_begin cx u in
             let _ = ic_node cx u e false in
             let got = ic_capture_end cx u saved in
             let _ = ic_list_append cx anchor got in
             let sr = (if cand then true else (if ic_static_literal cx e && (((if static_run then false else true) && index + 2048 < cnt) || (first && stack == 0)) then static_run else false)) in
             if stack + 2 >= 256 then go (index + 1) 0 (flush (stack + 2) first anchor) sr (ic_list_new cx)
             else go (index + 1) (stack + 2) first sr anchor))
       else
         (let f0 = flush stack first anchor in
          let v = pn_assoc_splat_value cx e in
          let empty = v >= 0 && ((ic_ty cx v == px_hash () && pn_hash_elements_b cx v == 0) || ic_ty cx v == px_nil ()) in
          let first_el = f0 in
          let only = first_el && index == cnt - 1 in
          let _ =
            (if empty then
               (let _ = at () in
                if only && argument then ic_i0 cx u "putnil" else if first_el then ic_in cx u "newhash" 0 else ())
             else if only && argument then ic_node cx u e false
             else
               (let _ = at () in
                let _ = ic_in cx u "putspecialobject" 1 in
                let _ = (if first_el then ic_in cx u "newhash" 0 else ic_i0 cx u "swap") in
                let _ = ic_node cx u e false in
                let _ = at () in
                ic_push_send cx u "core#hash_merge_kwd" 2)) in
          go (index + 1) 0 false false (ic_list_new cx))) in
  go 0 0 true false (ic_list_new cx);

// PM_HASH_NODE: a static literal is newhash 0 or duphash; popped, only what
// the elements do; otherwise pm_compile_hash_elements
let ic_hash_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let off = pn_hash_elements cx n in
  let cnt = pn_hash_elements_b cx n in
  if ic_static_literal cx n then
    (if popped then () else if cnt == 0 then ic_in cx u "newhash" 0 else ic_i1 cx u "duphash" (OVal (ic_static_value cx n)))
  else if popped then list_iter (ic_nlist cx off cnt) (fn (e: int) -> ic_node cx u e true)
  else ic_hash_elements cx u n off cnt false;

let ic_range_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let excl = pq_range_exclude_end cx n in
  let lo = pn_range_left cx n in
  let hi = pn_range_right cx n in
  // (pm_optimizable_range_item_p: no bound, an Integer or a written nil)
  let lit = fn (e: int) -> e < 0 || ic_ty cx e == px_integer () || ic_ty cx e == px_nil () in
  let val = fn (e: int) -> if e >= 0 && ic_ty cx e == px_integer () then ic_static_value cx e else IvNil in
  if lit lo && lit hi then (if popped then () else ic_i1 cx u "putobject" (OVal (IvRng (val lo, val hi, excl))))
  else
    // (an absent bound's nil is the range node's own instruction; a Range
    //  nobody reads is only what its bounds do)
    (let side = fn (e: int) ->
       if e >= 0 then ic_node cx u e popped
       else if popped then () else (let _ = ic_here cx u n in ic_i0 cx u "putnil") in
     let _ = side lo in
     let _ = side hi in
     if popped then () else (let _ = ic_here cx u n in ic_in cx u "newrange" (if excl then 1 else 0)));

let ic_logical = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let is_and = ic_ty cx n == px_and () in
  let l_end = ic_new_label cx u in
  let _ = ic_node cx u (if is_and then pn_and_left cx n else pn_or_left cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = ic_il cx u (if is_and then "branchunless" else "branchif") l_end in
  let _ = (if popped then () else ic_i0 cx u "pop") in
  let _ = ic_node cx u (if is_and then pn_and_right cx n else pn_or_right cx n) popped in
  ic_emit_label cx u l_end;

// -- constants, definitions -----------------------------------------------------
// pm_compile_constant_read: at the name, of the node it is read for
let ic_constant_read = fn cx -> fn (u: int) -> fn (name: str) -> fn (line: int) -> fn (n: int) ->
  let _ = ic_at cx u line (ic_nid cx n) in
  ic_i1 cx u "opt_getconstant_path" (OIc (Cons (ic_sym cx name, Nil)));
// a constant path made of names alone -- `X`, `A::B`, `::C` -- is one
// opt_getconstant_path over its segments: (is it one, the segments)
let rec ic_constant_path = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == px_constant_read () then (true, Cons (ic_sym cx (ic_cname cx (pn_constant_read_name cx n)), Nil))
  else if ty == px_constant_path () then
    (let nm = ic_sym cx (ic_cname cx (pn_constant_path_name cx n)) in
     if pn_constant_path_parent cx n < 0 then (true, Cons (IvSym ("", "US-ASCII"), Cons (nm, Nil)))
     else
       (let (ok, segs) = ic_constant_path cx (pn_constant_path_parent cx n) in
        if ok then (true, ic_cat segs (Cons (nm, Nil))) else (false, Nil)))
  else (false, (Nil : Iv list));
// (pm_compile_constant_path: what the path starts from -- nothing when it
//  starts from a name -- into `prefix`, then a getconstant a segment into
//  `body`)
let rec ic_constant_path_split = fn cx -> fn (u: int) -> fn (n: int) -> fn (prefix: int) -> fn (body: int) ->
  let ty = ic_ty cx n in
  let saved = ic_capture_begin cx u in
  if ty == px_constant_read () then
    (let _ = ic_here cx u n in
     let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
     let _ = ic_i1 cx u "getconstant" (ic_osym cx (ic_cname cx (pn_constant_read_name cx n))) in
     ic_list_append cx body (ic_capture_end cx u saved))
  else if ty == px_constant_path () then
    (let nm = ic_osym cx (ic_cname cx (pn_constant_path_name cx n)) in
     if pn_constant_path_parent cx n < 0 then
       (let _ = ic_here cx u n in
        let _ = ic_i0 cx u "pop" in
        let _ = ic_i1 cx u "putobject" (OVal (IvCls "Object")) in
        let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
        let _ = ic_i1 cx u "getconstant" nm in
        ic_list_append cx body (ic_capture_end cx u saved))
     else
       (let _ = ic_capture_end cx u saved in
        let _ = ic_constant_path_split cx u (pn_constant_path_parent cx n) prefix body in
        let saved2 = ic_capture_begin cx u in
        let _ = ic_here cx u n in
        let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
        let _ = ic_i1 cx u "getconstant" nm in
        ic_list_append cx body (ic_capture_end cx u saved2)))
  else
    (let _ = ic_node cx u n false in
     ic_list_append cx prefix (ic_capture_end cx u saved));

let ic_define = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let sl = ic_start_line cx n in
  let name = ic_cname cx (pn_def_name cx n) in
  let child = ic_unit_new cx 2 name (ic_u_path cx u) (ic_u_abs_path cx u) sl
                (ic_cnames cx (pn_def_locals cx n) (pn_def_locals_b cx n)) u (ic_loc4 cx n) (ic_nid cx n) in
  let _ = ic_params cx child (pn_def_parameters cx n) in
  let _ = ic_u_set cx child 18 1 in
  // (iseq_location_setup: a method named initialize takes a block)
  let _ = (if str_eq name "initialize" then ic_u_set_pflag cx child 4 else ()) in
  let _ = ic_add_child cx u child in
  let body = pn_def_body cx n in
  let is_st = body >= 0 && ic_ty cx body == px_statements () in
  let first = (if is_st && pn_statements_body_b cx body > 0 then ic_li cx (pn_statements_body cx body) 0 else 0 - 1) in
  let _ = ic_opt_defaults cx child in
  let _ = ic_param_prologue cx child sl 0 in
  let _ = ic_at cx child (if first >= 0 then ic_start_line cx first else sl) (ic_nid cx n) in
  let _ = ic_event cx child (ic_ev_call ()) in
  let _ = (if body < 0 then (let _ = ic_at cx child (ic_u_line cx child) 0 in ic_i0 cx child "putnil")
           else ic_node cx child body false) in
  let _ = ic_event cx child (ic_ev_return ()) in
  let _ = ic_u_set cx child 11 (ic_end_line cx n) in
  let _ = ic_at cx child (ic_end_line cx n) (ic_nid cx n) in
  let _ = ic_i0 cx child "leave" in
  let _ = ic_finish cx child in
  let _ = (if pn_def_receiver cx n >= 0 then
             (let _ = ic_node cx u (pn_def_receiver cx n) false in
              let _ = ic_here cx u n in
              ic_i2 cx u "definesmethod" (ic_osym cx name) (OSeq child))
           else
             (let _ = ic_here cx u n in
              ic_i2 cx u "definemethod" (ic_osym cx name) (OSeq child))) in
  if popped then () else ic_i1 cx u "putobject" (ic_osym cx name);

let ic_node3 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == px_def () then ic_define cx u n popped
  else if ty == px_constant_read () then
    (let _ = ic_constant_read cx u (ic_cname cx (pn_constant_read_name cx n)) (ic_start_line cx n) n in
     ic_pop_if cx u popped)
  else if ty == px_constant_path () then
    (let (ok, segs) = ic_constant_path cx n in
     let _ =
       (if ok then ic_i1 cx u "opt_getconstant_path" (OIc segs)
        else
          (let prefix = ic_list_new cx in
           let body = ic_list_new cx in
           let _ = ic_constant_path_split cx u n prefix body in
           let _ = ic_here cx u n in
           let _ = (if ic_list_empty cx prefix then ic_i0 cx u "putnil" else ic_append cx u prefix) in
           ic_append cx u body)) in
     let _ = ic_here cx u n in
     ic_pop_if cx u popped)
  else if ty == px_interpolated_string () then ic_dstr cx u n popped
  else if ty == px_hash () then ic_hash_node cx u n popped
  // (PM_KEYWORD_HASH_NODE as a value -- `return **h`: its elements made a
  //  Hash, never a literal one)
  else if ty == px_keyword_hash () then
    (let _ = ic_hash_elements cx u n (pn_keyword_hash_elements cx n) (pn_keyword_hash_elements_b cx n) false in
     ic_pop_if cx u popped)
  else if ty == px_range () then ic_range_node cx u n popped
  else if ty == px_and () || ty == px_or () then ic_logical cx u n popped
  else if ty == px_regular_expression () then
    (if popped then () else ic_i1 cx u "putobject" (OVal (ic_regexp_literal cx (ic_str cx (pn_regular_expression_unescaped cx n), ic_enc cx) n)))
  else if ty == px_interpolated_regular_expression () then
    (if ic_rx cx n 32 then ic_once_regexp cx u n popped
     // (every piece a literal: the Regexp itself)
     else if ic_static_literal cx n then
       (if popped then () else ic_i1 cx u "putobject" (OVal (ic_regexp_literal cx (ic_static_concat cx (ic_parts cx n)) n)))
     else ic_dregexp cx u n popped)
  else if ty == px_interpolated_symbol () then
    (let (count, _) = ic_dstr_parts cx u n false in
     let _ = ic_here cx u n in
     let _ = (if count > 1 then ic_in cx u "concatstrings" count else ()) in
     let _ = ic_here cx u n in
     let _ = ic_i0 cx u "intern" in
     ic_pop_if cx u popped)
  else if ty == px_xstring () then
    // (`x`: self.`("x")
    (let _ = ic_i0 cx u "putself" in
     let _ = ic_i1 cx u "putobject" (OVal (IvStr (ic_str cx (pn_xstring_unescaped cx n), ic_enc cx))) in
     let _ = ic_i2 cx u "send" (ic_cd "`" 20 1) (OSeq (0 - 1)) in
     ic_pop_if cx u popped)
  else if ty == px_interpolated_xstring () then
    (let _ = ic_i0 cx u "putself" in
     let (count, _) = ic_dstr_parts cx u n false in
     let _ = ic_here cx u n in
     let _ = (if count > 1 then ic_in cx u "concatstrings" count else ()) in
     let _ = ic_here cx u n in
     let _ = ic_i2 cx u "send" (ic_cd "`" 20 1) (OSeq (0 - 1)) in
     ic_pop_if cx u popped)
  else if ty == px_lambda () then
    (let ps = pn_lambda_parameters cx n in
     let ol = pn_lambda_operator_loc cx n + pn_lambda_operator_loc_b cx n in
     let (l0, c0) = (if ps >= 0 then (ic_start_line cx ps, ic_start_col cx ps) else (ic_line_of cx ol, ic_col_of cx ol)) in
     let blk = ic_block_unit cx u n (ic_line_of cx (pn_lambda_opening_loc cx n)) l0 c0 in
     let _ = ic_here cx u n in
     let _ = ic_in cx u "putspecialobject" 1 in
     let _ = ic_i2 cx u "send" (ic_cd "lambda" 4 0) (OSeq blk) in
     ic_pop_if cx u popped)
  else ic_node4 cx u n popped ty;

// -- conditions -------------------------------------------------------------------
let ic_truthy = fn (v: Iv) -> match v with | IvNil -> false | IvFalse -> false | _ -> true;
// PUSH_SYNTHETIC_PUTNIL: on the last line, of no node (-1)
let ic_synthetic_putnil = fn cx -> fn (u: int) ->
  let _ = ic_at cx u (if ic_u_last_line cx u >= 0 then ic_u_last_line cx u else ic_u_line cx u) (0 - 1) in
  ic_i0 cx u "putnil";
// (the instructions after `mark` in the list being built)
let ic_insns_after = fn cx -> fn (u: int) -> fn (mark: int) ->
  let rec go = fn (e: int) ->
    if ic_is_end cx e then (Nil : int list) else if ic_kind cx e == 0 then Cons (e, go (ic_next cx e)) else go (ic_next cx e) in
  go (ic_next cx mark);
// pm_compile_branch_condition (its location is the condition it was given,
// kept as it walks into && / ||)
let rec ic_branch_condition = fn cx -> fn (u: int) -> fn (cond: int) -> fn (then_l: int) -> fn (else_l: int) -> fn (at: int) ->
  let ty = ic_ty cx cond in
  if ty == px_false () || ty == px_nil () then (let _ = ic_here cx u at in ic_il cx u "jump" else_l)
  else if ty == px_float () || ty == px_imaginary () || ty == px_integer () || ty == px_rational () || ty == px_string ()
          || ty == px_symbol () || ty == px_true () || ty == px_lambda () || ty == px_regular_expression () then
    (let _ = ic_here cx u at in ic_il cx u "jump" then_l)
  else if ty == px_defined () then
    // (in a condition the answer is true, at the condition's place)
    (let _ = ic_defined_node cx u cond false at true in
     let _ = ic_here cx u at in
     let _ = ic_il cx u "branchunless" else_l in
     ic_il cx u "jump" then_l)
  else if ty == px_flip_flop () then ic_flip_flop cx u cond else_l then_l (ic_start_line cx cond) false
  else if ty == px_and () then
    (let _ = ic_compile_logical cx u (pn_and_left cx cond) (0 - 1) else_l in
     ic_branch_condition cx u (pn_and_right cx cond) then_l else_l at)
  else if ty == px_or () then
    (let _ = ic_compile_logical cx u (pn_or_left cx cond) then_l (0 - 1) in
     ic_branch_condition cx u (pn_or_right cx cond) then_l else_l at)
  else
    (let mark = ic_last cx (ic_u_list cx u) in
     let _ = ic_node cx u cond false in
     match ic_insns_after cx u mark with
     | Cons (e, Nil) when str_eq (ic_name cx e) "putobject" ->
       (let v = (match ic_op0 cx e with | OVal x -> x | _ -> IvTrue) in
        let _ = ic_unlink cx e in
        let _ = ic_here cx u at in
        ic_il cx u "jump" (if ic_truthy v then then_l else else_l))
     | _ ->
       (let _ = ic_here cx u at in
        let _ = ic_il cx u "branchunless" else_l in
        ic_il cx u "jump" then_l));
// pm_compile_logical: one side of && / || in a condition, falling through
// to a label of its own for the other (-1: that one)
let ic_compile_logical = fn cx -> fn (u: int) -> fn (cond: int) -> fn (then0: int) -> fn (else0: int) ->
  let lbl = ic_new_label cx u in
  let then_l = (if then0 >= 0 then then0 else lbl) in
  let else_l = (if else0 >= 0 then else0 else lbl) in
  let mark = ic_last cx (ic_u_list cx u) in
  let _ = ic_branch_condition cx u cond then_l else_l cond in
  match ic_insns_after cx u mark with
  | Cons (e, Nil) when str_eq (ic_name cx e) "jump" && ic_lab_of (ic_op0 cx e) == lbl ->
    (let _ = ic_unref_ops cx (ic_ops cx e) in
     let rec cut = fn (x: int) -> if ic_is_end cx x then () else (let nx = ic_next cx x in let _ = ic_unlink cx x in cut nx) in
     cut (ic_next cx mark))
  | _ -> if ic_refs cx lbl > 0 then ic_emit_label cx u lbl else ();
// a part of an if / unless / else: its statements, or a synthetic nil
let ic_compile_part = fn cx -> fn (u: int) -> fn (part0: int) -> fn (popped: bool) ->
  let part = (if part0 >= 0 && ic_ty cx part0 == px_else () then pn_else_statements cx part0 else part0) in
  if part >= 0 then ic_node cx u part popped else if popped then () else ic_synthetic_putnil cx u;
// prism_compile.c's pm_compile_conditional: the condition jumps to the then-
// or else-label, each part runs if a jump reaches it, and the peephole
// optimiser tidies the jumps up as compile.c's does
let ic_branch = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let unless_ = ic_ty cx n == px_unless () in
  let pred = (if unless_ then pn_unless_predicate cx n else pn_if_predicate cx n) in
  let then_body = (if unless_ then pn_unless_else_clause cx n else pn_if_statements cx n) in
  let else_body = (if unless_ then pn_unless_statements cx n else pn_if_subsequent cx n) in
  let then_l = ic_new_label cx u in
  let else_l = ic_new_label cx u in
  let _ = ic_branch_condition cx u pred then_l else_l pred in
  let end_l =
    (if ic_refs cx then_l > 0 then
       (let _ = ic_emit_label cx u then_l in
        let _ = ic_compile_part cx u then_body popped in
        if ic_refs cx else_l > 0 then
          (let l = ic_new_label cx u in
           let _ = ic_here cx u n in
           let _ = ic_il cx u "jump" l in
           let _ = (if popped then () else ic_i0 cx u "pop") in
           l)
        else 0 - 1)
     else 0 - 1) in
  let _ = (if ic_refs cx else_l > 0 then (let _ = ic_emit_label cx u else_l in ic_compile_part cx u else_body popped) else ()) in
  if end_l >= 0 then ic_emit_label cx u end_l else ();

// -- classes ------------------------------------------------------------------
let ic_class_body = fn cx -> fn (child: int) -> fn (n: int) -> fn (body: int) -> fn (events: bool) ->
  let _ = ic_at cx child (ic_start_line cx n) (ic_nid cx n) in
  let _ = (if events then ic_event cx child (ic_ev_class ()) else ()) in
  // (an empty body's putnil is synthetic: node 0)
  let _ = (if body >= 0 then ic_node cx child body false else (let _ = ic_at cx child (ic_start_line cx n) 0 in ic_i0 cx child "putnil")) in
  let _ = (if events then (let _ = ic_event cx child (ic_ev_end ()) in ic_u_set cx child 11 (ic_end_line cx n)) else ()) in
  let _ = (if ic_u_last_line cx child < 0 then ic_u_set cx child 11 (ic_start_line cx n) else ()) in
  let _ = ic_at cx child (ic_u_last_line cx child) (ic_nid cx n) in
  let _ = ic_i0 cx child "leave" in
  ic_finish cx child;
let ic_class_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let mod_ = ic_ty cx n == px_module () in
  let name = ic_cname cx (if mod_ then pn_module_name cx n else pn_class_name cx n) in
  let locals = (if mod_ then ic_cnames cx (pn_module_locals cx n) (pn_module_locals_b cx n) else ic_cnames cx (pn_class_locals cx n) (pn_class_locals_b cx n)) in
  let child = ic_unit_new cx 3 ("<" ++ (if mod_ then "module" else "class") ++ ":" ++ name ++ ">") (ic_u_path cx u) (ic_u_abs_path cx u)
                (ic_start_line cx n) locals u (ic_loc4 cx n) (ic_nid cx n) in
  let _ = ic_add_child cx u child in
  let _ = ic_class_body cx child n (if mod_ then pn_module_body cx n else pn_class_body cx n) true in
  let cp = (if mod_ then pn_module_constant_path cx n else pn_class_constant_path cx n) in
  let f0 = (if mod_ then 2 else 0) in
  let f1 =
    (if ic_ty cx cp == px_constant_path () then
       (let _ = (if pn_constant_path_parent cx cp >= 0 then ic_node cx u (pn_constant_path_parent cx cp) false
                 else (let _ = ic_here cx u n in ic_i1 cx u "putobject" (OVal (IvCls "Object")))) in
        f0 + 8)
     else (let _ = ic_here cx u n in let _ = ic_in cx u "putspecialobject" 3 in f0)) in
  let sup = (if mod_ then 0 - 1 else pn_class_superclass cx n) in
  let flags = (if sup >= 0 then (let _ = ic_node cx u sup false in f1 + 16) else (let _ = ic_here cx u n in let _ = ic_i0 cx u "putnil" in f1)) in
  let _ = ic_here cx u n in
  let _ = ic_i3 cx u "defineclass" (ic_osym cx name) (OSeq child) (ONum flags) in
  ic_pop_if cx u popped;
// (a singleton class has no class / end events, and its leave stays on the
//  last line)
let ic_singleton_class = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let child = ic_unit_new cx 3 "singleton class" (ic_u_path cx u) (ic_u_abs_path cx u) (ic_start_line cx n)
                (ic_cnames cx (pn_singleton_class_locals cx n) (pn_singleton_class_locals_b cx n)) u (ic_loc4 cx n) (ic_nid cx n) in
  let _ = ic_u_set cx child 18 1 in
  let _ = ic_add_child cx u child in
  let _ = ic_class_body cx child n (pn_singleton_class_body cx n) false in
  let _ = ic_node cx u (pn_singleton_class_expression cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_i3 cx u "defineclass" (ic_osym cx "singletonclass") (OSeq child) (ONum 1) in
  ic_pop_if cx u popped;

// -- loops, jumps, ensures ------------------------------------------------------
let ic_loops = fn cx -> fn (u: int) -> vec_get (ic_up cx) u;
let ic_ensures = fn cx -> fn (u: int) -> vec_get (ic_un cx) u;
let ic_set_ensures = fn cx -> fn (u: int) -> fn (es: (int * int) list) -> vec_set (ic_un cx) u es;
// can_add_ensure_iseq: under a rescue's protected body, an ensure around it
// is not inlined -- the jump is thrown and the catch table runs it
let ic_can_add_ensure = fn cx -> fn (u: int) ->
  let rec any = fn (es: (int * int) list) -> (match es with | Nil -> false | Cons ((k, _), t) -> if k >= 0 then true else any t) in
  if ic_u_in_rescue cx u && any (ic_ensures cx u) then false else true;
// the sequence a throwing break / next goes to: the nearest one that is in a
// loop or is a block, out through rescue and ensure sequences (-1: none)
let rec ic_escape_scope = fn cx -> fn (ip: int) ->
  if ip < 0 then 0 - 1
  else if (match ic_loops cx ip with | Nil -> false | _ -> true) || ic_u_type cx ip == 1 then ip
  else if ic_through (ic_u_type cx ip) then ic_escape_scope cx (ic_u_parent cx ip)
  else 0 - 1;
// pm_add_ensure_iseq: on the way out of ensure regions -- a return, a loop's
// break / next / redo -- each ensure clause left is run here, the innermost
// first, compiled again in place; and the copy is cut out of its region
// (add_ensure_range), since the region's exception path would run it a
// second time. A jump inside a loop stops at the loop.
let ic_no_ensure_escape = fn cx -> fn (u: int) -> fn (is_return: bool) ->
  let saved = ic_ensures cx u in
  let rec go = fn (es: (int * int) list) ->
    (match es with
     | Nil -> ()
     | Cons ((k, id), outer) ->
       if k < 0 then (if is_return then go outer else ())
       else
         (let lstart = ic_new_label cx u in
          let lend = ic_new_label cx u in
          let ur = ic_ur cx in
          let rs = vec_get ur id in
          // (the last piece now ends at the copy; a new one starts after it)
          let rec split = fn (xs: (int * int) list) ->
            (match xs with
             | Nil -> (Nil : (int * int) list)
             | Cons ((st, ed), Nil) -> Cons ((st, lstart), Cons ((lend, ed), Nil))
             | Cons (x, t) -> Cons (x, split t)) in
          let _ = vec_set ur id (split rs) in
          let _ = ic_set_ensures cx u outer in
          let _ = ic_emit_label cx u lstart in
          let st = pn_ensure_statements cx k in
          let _ = (if st >= 0 then ic_node cx u st true else ()) in
          let _ = ic_emit_label cx u lend in
          go outer)) in
  let _ = go saved in
  ic_set_ensures cx u saved;

// what a return (or a break, a next) answers: nil, its one value, or the
// Array of several (compiled as a value: never the duparray of a literal)
let ic_return_value = fn cx -> fn (u: int) -> fn (n: int) -> fn (args: int) ->
  let cnt = (if args >= 0 then pn_arguments_arguments_b cx args else 0) in
  if cnt == 0 then (let _ = ic_here cx u n in ic_i0 cx u "putnil")
  else if cnt == 1 then ic_node cx u (ic_li cx (pn_arguments_arguments cx args) 0) false
  else ic_array_core cx u args (pn_arguments_arguments cx args) cnt false;

let ic_loop_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let until_ = ic_ty cx n == px_until () in
  let pred = (if until_ then pn_until_predicate cx n else pn_while_predicate cx n) in
  let stmts = (if until_ then pn_until_statements cx n else pn_while_statements cx n) in
  let begin_mod = (if until_ then pq_until_begin_modifier cx n else pq_while_begin_modifier cx n) in
  let next_l = ic_new_label cx u in
  let redo_l = ic_new_label cx u in
  let break_l = ic_new_label cx u in
  let end_l = ic_new_label cx u in
  let adjust_l = ic_new_label cx u in
  let next_catch_l = ic_new_label cx u in
  // (begin ... end while runs the body first)
  let tmp_l = (if begin_mod then ic_new_label cx u else 0 - 1) in
  let _ = ic_il cx u "jump" (if tmp_l >= 0 then tmp_l else next_l) in
  let _ = ic_emit_label cx u adjust_l in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_emit_label cx u next_catch_l in
  let _ = ic_i0 cx u "pop" in
  let _ = ic_il cx u "jump" next_l in
  let _ = (if tmp_l >= 0 then ic_emit_label cx u tmp_l else ()) in
  let _ = ic_emit_label cx u redo_l in
  let loops0 = ic_loops cx u in
  let ens0 = ic_ensures cx u in
  let _ = vec_set (ic_up cx) u (Cons ((next_l, break_l, redo_l), loops0)) in
  let _ = ic_set_ensures cx u (Cons ((0 - 1, 0 - 1), ens0)) in
  let _ = (if stmts >= 0 then ic_node cx u stmts true else ()) in
  let _ = ic_set_ensures cx u ens0 in
  let _ = vec_set (ic_up cx) u loops0 in
  let _ = ic_emit_label cx u next_l in
  let _ = (if until_ then ic_branch_condition cx u pred end_l redo_l pred else ic_branch_condition cx u pred redo_l end_l pred) in
  let _ = ic_emit_label cx u end_l in
  let _ = ic_adjust cx u adjust_l true in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_emit_label cx u break_l in
  let _ = ic_pop_if cx u popped in
  let _ = ic_add_catch cx u 4 redo_l break_l (0 - 1) break_l in
  let _ = ic_add_catch cx u 6 redo_l break_l (0 - 1) next_catch_l in
  ic_add_catch cx u 5 redo_l break_l (0 - 1) redo_l;

// THROW_NO_ESCAPE 0x8000
let ic_break_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let args = pn_break_arguments cx n in
  match ic_loops cx u with
  | Cons ((_, brk, redo), _) when ic_can_add_ensure cx u ->
    (let sp = ic_new_label cx u in
     let _ = ic_emit_label cx u sp in
     let _ = ic_here cx u n in
     let _ = ic_adjust cx u redo false in
     let _ = ic_return_value cx u n args in
     let _ = ic_no_ensure_escape cx u false in
     let _ = ic_here cx u n in
     let _ = ic_il cx u "jump" brk in
     let _ = ic_adjust cx u sp true in
     if popped then () else ic_i0 cx u "putnil")
  | _ ->
    (let ip = ic_escape_scope cx u in
     if ip < 0 then ic_refuse "break here is not compiled yet"
     else
       // (a loop's break from a rescue / ensure sequence does not escape the
       //  frame: VM_THROW_NO_ESCAPE_FLAG)
       (let _ = ic_return_value cx u n args in
        let _ = ic_here cx u n in
        let _ = ic_in cx u "throw" (match ic_loops cx ip with | Nil -> 2 | _ -> 32768 + 2) in
        ic_pop_if cx u popped));

let ic_next_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let args = pn_next_arguments cx n in
  let sp = ic_new_label cx u in
  match ic_loops cx u with
  | Cons ((nxt, _, redo), _) when ic_can_add_ensure cx u ->
    (let _ = ic_emit_label cx u sp in
     let _ = ic_return_value cx u n args in
     let _ = ic_no_ensure_escape cx u false in
     let _ = ic_here cx u n in
     let _ = ic_adjust cx u redo false in
     let _ = ic_il cx u "jump" nxt in
     let _ = ic_adjust cx u sp true in
     if popped then () else ic_i0 cx u "putnil")
  | _ ->
    if ic_u_type cx u == 1 && ic_can_add_ensure cx u then
      (let _ = ic_emit_label cx u sp in
       let _ = ic_here cx u n in
       let _ = ic_adjust cx u (ic_u_block_label0 cx u) false in
       let _ = ic_return_value cx u n args in
       let _ = ic_no_ensure_escape cx u false in
       let _ = ic_here cx u n in
       let _ = ic_il cx u "jump" (ic_u_block_label1 cx u) in
       let _ = ic_adjust cx u sp true in
       let _ = ic_e_set cx sp 9 0 in
       if popped then () else ic_i0 cx u "putnil")
    else if ic_escape_scope cx u >= 0 then
      // (from a rescue / ensure sequence: thrown to the block or loop)
      (let _ = ic_return_value cx u n args in
       let _ = ic_here cx u n in
       let _ = ic_in cx u "throw" (32768 + 3) in
       ic_pop_if cx u popped)
    else ic_refuse "next here is not compiled yet";

let ic_redo_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let sp = ic_new_label cx u in
  let tail = fn (x: unit) ->
    (let _ = ic_adjust cx u sp true in
     let _ = ic_e_set cx sp 9 0 in
     if popped then () else ic_i0 cx u "putnil") in
  match ic_loops cx u with
  | Cons ((_, _, redo), _) when ic_can_add_ensure cx u ->
    (let _ = ic_emit_label cx u sp in
     let _ = ic_here cx u n in
     let _ = ic_adjust cx u redo false in
     let _ = ic_no_ensure_escape cx u false in
     let _ = ic_here cx u n in
     let _ = ic_il cx u "jump" redo in
     tail ())
  | _ ->
    if ic_u_type cx u == 1 && ic_can_add_ensure cx u then
      (let _ = ic_emit_label cx u sp in
       let _ = ic_no_ensure_escape cx u false in
       let _ = ic_here cx u n in
       let _ = ic_adjust cx u (ic_u_block_label0 cx u) false in
       let _ = ic_il cx u "jump" (ic_u_block_label0 cx u) in
       tail ())
    else if ic_escape_scope cx u >= 0 then
      (let _ = ic_here cx u n in
       let _ = ic_i0 cx u "putnil" in
       let _ = ic_in cx u "throw" (32768 + 5) in
       ic_pop_if cx u popped)
    else ic_refuse "redo here is not compiled yet";

// pm_compile_return_node, in a method: leave, with an ADJUST before (the
// stack down to the method's) and an ADJUST_RESTORE after (at the top level
// the scope itself is as a method; from a block ruby throws TAG_RETURN,
// which needs the catch table)
let ic_return_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let args = pn_return_arguments cx n in
  let ty = ic_u_type cx u in
  if ty != 2 && ty != 0 then
    (if ic_through ty then
       (let _ = ic_return_value cx u n args in
        let _ = ic_here cx u n in
        let _ = ic_in cx u "throw" 1 in
        ic_pop_if cx u popped)
     else ic_refuse "return from here is not compiled yet")
  // (a file's own return answers nothing, and ruby warns as it compiles:
  //  the Ruby compiler says that)
  else if ty == 0 && args >= 0 then ic_refuse "a top-level return with a value is not compiled yet"
  else
    (let sp_l = ic_new_label cx u in
     let _ = ic_emit_label cx u sp_l in
     let _ = ic_adjust cx u (0 - 1) false in
     let _ = ic_return_value cx u n args in
     if (if ic_can_add_ensure cx u then false else true) then
       (let _ = ic_here cx u n in
        let _ = ic_in cx u "throw" 1 in
        ic_pop_if cx u popped)
     else
       (let _ = ic_no_ensure_escape cx u true in
        let _ = ic_here cx u n in
        let _ = ic_event cx u (ic_ev_return ()) in
        let _ = ic_i0 cx u "leave" in
        let _ = ic_adjust cx u sp_l true in
        if popped then () else ic_i0 cx u "putnil"));

let ic_yield_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let m = ic_local_iseq cx u in
  let _ = (if ic_u_type cx m == 2 then ic_u_set_pflag cx m 4 else ()) in
  let (argc, flag, kws, has_kws) = ic_setup_args cx u (pn_yield_arguments cx n) (0 - 1) (ic_start_line cx n) (ic_nid cx n) 0 in
  let _ = ic_here cx u n in
  let _ = ic_i1 cx u "invokeblock" (ic_ci (chr 0) argc flag kws has_kws false) in
  ic_pop_if cx u popped;

// -- super ----------------------------------------------------------------------
// the method's parameters as zsuper passes them on
let ic_zsuper_args = fn cx -> fn (u: int) -> fn (n: int) -> fn (local: int) ->
  let rec lv = fn (x: int) -> fn (k: int) -> if x == local || x < 0 then k else lv (ic_u_parent cx x) (k + 1) in
  let level = lv u 0 in
  let get = fn (i: int) -> (let _ = ic_here cx u n in ic_i2 cx u "getlocal" (ic_local_op cx local i) (ONum level)) in
  let rec times = fn (k: int) -> fn (from: int) -> if k <= 0 then () else (let _ = get from in times (k - 1) (from + 1)) in
  let lead = ic_u_lead_num cx local in
  let _ = times lead 0 in
  let nopt = (if ic_u_pflag cx local 64 then ic_llen (vec_get (ic_uo cx) local) - 1 else 0) in
  let _ = times nopt lead in
  let argc0 = lead + nopt in
  let rs = ic_u_rest_start cx local in
  let (argc1, flag1) =
    (if rs >= 0 then (let _ = get rs in let _ = ic_i1 cx u "splatarray" (OVal IvFalse) in (rs + 1, 1)) else (argc0, 0)) in
  let pn = ic_u_post_num cx local in
  let argc2 =
    (if pn >= 0 then
       (let _ = times pn (ic_u_post_start cx local) in
        if rs >= 0 then (let _ = ic_in cx u "newarray" pn in let _ = ic_i0 cx u "concatarray" in argc1)
        else pn + ic_u_post_start cx local)
     else argc1) in
  let kwr = ic_u_kwrest cx local in
  if ic_u_pflag cx local 32 then
    (let _ = ic_in cx u "putspecialobject" 1 in
     let _ = (if kwr >= 0 then (let _ = get kwr in ic_i2 cx u "send" (ic_cd "dup" 16 0) (OSeq (0 - 1))) else ic_in cx u "newhash" 0) in
     let names = ic_map (fn (k: Iv) -> (match k with | IvSym (s, _) -> s | IvArr (Cons (IvSym (s, _), _)) -> s | _ -> "")) (vec_get (ic_uw cx) local) in
     let _ = list_iter names (fn (k: str) -> (let _ = ic_i1 cx u "putobject" (ic_osym cx k) in get (ic_index_of cx local k))) in
     let _ = ic_i2 cx u "send" (ic_cd "core#hash_merge_ptr" 16 (ic_llen names * 2 + 1)) (OSeq (0 - 1)) in
     (argc2 + 1, flag1 + 64 + 2048))
  else if kwr >= 0 then (let _ = get kwr in (argc2 + 1, flag1 + 64))
  else (argc2, flag1);

let ic_super_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let zsuper = ic_ty cx n == px_forwarding_super () in
  let block = (if zsuper then pn_forwarding_super_block cx n else pn_super_block cx n) in
  let retry_l = ic_new_label cx u in
  let retry_end = ic_new_label cx u in
  let _ = (if zsuper && block < 0 then () else ic_emit_label cx u retry_l) in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "putself" in
  let local = ic_local_iseq cx u in
  // (ZSUPER 512, SUPER 256, FCALL 4, FORWARDING 8192)
  if zsuper && ic_u_pflag cx local 16 then
    // (pm_compile_forwarding_super_node in a forwardable method: its `...`
    //  passed on with invokesuperforward, and no break entry)
    (let blk = (if block >= 0 then ic_block_unit cx u block (0 - 1) (0 - 1) (0 - 1) else 0 - 1) in
     let _ = (if block < 0 then ic_u_set_pflag cx local 4 else ()) in
     let _ = ic_here cx u n in
     let _ = ic_getlocal cx u "..." in
     let _ = ic_i2 cx u "invokesuperforward" (ic_ci (chr 0) 0 (512 + 256 + 4 + 8192) Nil false (blk >= 0)) (OSeq blk) in
     ic_pop_if cx u popped)
  else
    (let (blk, argc, flag, kws, has_kws) =
       (if zsuper then
          (let blk = (if block >= 0 then ic_block_unit cx u block (0 - 1) (0 - 1) (0 - 1) else 0 - 1) in
           let (argc, flag) = ic_zsuper_args cx u n local in
           (blk, argc, bit_or flag (512 + 256 + 4), (Nil : str list), false))
        else
          (let (argc, flag, kws, has_kws) = ic_setup_args cx u (pn_super_arguments cx n) block (ic_start_line cx n) (ic_nid cx n) 0 in
           let blk = (if ic_tyis cx block (px_block ()) then ic_block_unit cx u block (0 - 1) (0 - 1) (0 - 1) else 0 - 1) in
           (blk, argc, bit_or flag (256 + 4), kws, has_kws))) in
     let _ = (if block < 0 then ic_u_set_pflag cx local 4 else ()) in
     let _ = ic_here cx u n in
     let _ = (if bit_and flag 2 != 0 && bit_and flag 64 != 0 && bit_and flag 2048 == 0 then ic_i0 cx u "splatkw" else ()) in
     let _ =
       (if zsuper then ic_i2 cx u "invokesuper" (ic_ci (chr 0) argc flag Nil false (blk >= 0)) (OSeq blk)
        else
          // (super(...) in a forwardable method: invokesuperforward)
          (let args = pn_super_arguments cx n in
           let fwd = args >= 0 && pq_arguments_contains_forwarding cx args && ic_u_pflag cx local 16 in
           ic_i2 cx u (if fwd then "invokesuperforward" else "invokesuper")
             (ic_ci (chr 0) argc (if fwd then bit_or flag 8192 else flag) kws has_kws (blk >= 0)) (OSeq blk))) in
     let _ = (if (if zsuper then false else true) || block >= 0 then
                (let _ = ic_emit_label cx u retry_end in ic_add_catch cx u 4 retry_l retry_end blk retry_end)
              else ()) in
     ic_pop_if cx u popped);

// -- rescue and ensure ------------------------------------------------------------
// a rescue / ensure sequence: its one local is the error ($!)
let ic_exception_unit = fn cx -> fn (u: int) -> fn (ty: int) -> fn (first_line: int) -> fn (locn: int) -> fn (node_id: int) ->
  let child = ic_unit_new cx ty ((if ty == 4 then "rescue" else "ensure") ++ " in " ++ ic_u_label cx u) (ic_u_path cx u) (ic_u_abs_path cx u)
                first_line (Cons ("$!", Nil)) u (ic_loc4 cx locn) node_id in
  let _ = ic_add_child cx u child in
  child;

// pm_compile_rescue_node, in the rescue sequence: each class against $!
// (checkmatch), the error into its variable, the clause's value left, and
// the next clause -- or $! thrown on
let rec ic_rescue_clause = fn cx -> fn (u: int) -> fn (n: int) ->
  let matched = ic_new_label cx u in
  let none = ic_new_label cx u in
  let at = fn (x: unit) -> ic_here cx u n in
  let exs = ic_nlist cx (pn_rescue_exceptions cx n) (pn_rescue_exceptions_b cx n) in
  let _ =
    (match exs with
     | Nil ->
       (let _ = at () in
        let _ = ic_getlocal cx u "$!" in
        let _ = ic_i1 cx u "putobject" (OVal (IvCls "StandardError")) in
        let _ = ic_in cx u "checkmatch" 3 in
        ic_il cx u "branchif" matched)
     | _ ->
       list_iter exs (fn (ex: int) ->
         (let _ = at () in
          let _ = ic_getlocal cx u "$!" in
          let _ = ic_node cx u ex false in
          let _ = at () in
          let _ = ic_in cx u "checkmatch" (if ic_ty cx ex == px_splat () then 7 else 3) in
          ic_il cx u "branchif" matched))) in
  let _ = at () in
  let _ = ic_il cx u "jump" none in
  let _ = ic_emit_label cx u matched in
  let _ = ic_event cx u (ic_ev_rescue ()) in
  let r = pn_rescue_reference cx n in
  let _ =
    (if r >= 0 then
       (let _ = at () in
        let _ = ic_getlocal cx u "$!" in
        let _ = ic_at cx u (ic_start_line cx r) (ic_nid cx r) in
        let rt = ic_ty cx r in
        if rt == px_local_variable_target () then ic_setlocal cx u (ic_cname cx (pn_local_variable_target_name cx r))
        else if rt == px_instance_variable_target () then
          ic_i2 cx u "setinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_target_name cx r))) (OIvc (ic_next_is cx u))
        else if rt == px_global_variable_target () then ic_i1 cx u "setglobal" (ic_osym cx (ic_cname cx (pn_global_variable_target_name cx r)))
        else if rt == px_class_variable_target () then
          (let nm = ic_cname cx (pn_class_variable_target_name cx r) in ic_i2 cx u "setclassvariable" (ic_osym cx nm) (ic_cvc cx u nm))
        else ic_refuse ("rescue into " ++ ic_type_name rt ++ " is not compiled yet"))
     else ()) in
  let _ = (if pn_rescue_statements cx n >= 0 then ic_node cx u (pn_rescue_statements cx n) false else (let _ = at () in ic_i0 cx u "putnil")) in
  let _ = at () in
  let _ = ic_i0 cx u "leave" in
  let _ = ic_emit_label cx u none in
  if pn_rescue_subsequent cx n >= 0 then ic_node cx u (pn_rescue_subsequent cx n) false
  else (let _ = at () in ic_getlocal cx u "$!");

// pm_compile_rescue: the body between lstart and lend, the else part, a nop,
// and the rescue and retry entries; the rescue clauses are a sequence of
// their own
let ic_rescue_part = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let rc = pn_begin_rescue_clause cx n in
  let lstart = ic_new_label cx u in
  let lend = ic_new_label cx u in
  let lcont = ic_new_label cx u in
  let child = ic_exception_unit cx u 4 (ic_start_line cx rc) rc (ic_nid cx rc) in
  let _ = ic_node cx child rc false in
  let _ = ic_at cx child (ic_start_line cx rc) 0 in
  let _ = ic_in cx child "throw" 0 in
  let _ = ic_finish cx child in
  let _ = ic_emit_label cx u lstart in
  let was = ic_u_get cx u 19 in
  let _ = ic_u_set cx u 19 1 in
  let st = pn_begin_statements cx n in
  let _ = (if st >= 0 then ic_node cx u st false else (let _ = ic_here cx u rc in ic_i0 cx u "putnil")) in
  let _ = ic_u_set cx u 19 was in
  let _ = ic_emit_label cx u lend in
  let el = pn_begin_else_clause cx n in
  let _ = (if el >= 0 then
             (let _ = ic_here cx u n in
              let _ = (if popped then () else ic_i0 cx u "pop") in
              ic_node cx u el popped)
           else ()) in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "nop" in
  let _ = ic_emit_label cx u lcont in
  let _ = ic_pop_if cx u popped in
  let _ = ic_add_catch cx u 1 lstart lend child lcont in
  ic_add_catch cx u 3 lend lcont (0 - 1) lstart;

// x rescue y: the rescue sequence matches StandardError itself
let ic_rescue_modifier = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ex = pn_rescue_modifier_rescue_expression cx n in
  let child = ic_exception_unit cx u 4 (ic_start_line cx ex) n (ic_nid cx n) in
  let matched = ic_new_label cx child in
  let none = ic_new_label cx child in
  // (the scope's own location: the modifier's line -- the sequence's first
  //  line is the rescue expression's -- and no node)
  let _ = ic_at cx child (ic_start_line cx n) 0 in
  let _ = ic_getlocal cx child "$!" in
  let _ = ic_i1 cx child "putobject" (OVal (IvCls "StandardError")) in
  let _ = ic_in cx child "checkmatch" 3 in
  let _ = ic_il cx child "branchif" matched in
  let _ = ic_il cx child "jump" none in
  let _ = ic_emit_label cx child matched in
  let _ = ic_event cx child (ic_ev_rescue ()) in
  let _ = ic_node cx child ex false in
  let _ = ic_at cx child (ic_start_line cx n) 0 in
  let _ = ic_i0 cx child "leave" in
  let _ = ic_emit_label cx child none in
  let _ = ic_getlocal cx child "$!" in
  let _ = ic_in cx child "throw" 0 in
  let _ = ic_finish cx child in
  let lstart = ic_new_label cx u in
  let lend = ic_new_label cx u in
  let lcont = ic_new_label cx u in
  let _ = ic_emit_label cx u lstart in
  let was = ic_u_get cx u 19 in
  let _ = ic_u_set cx u 19 1 in
  let _ = ic_node cx u (pn_rescue_modifier_expression cx n) false in
  let _ = ic_u_set cx u 19 was in
  let _ = ic_emit_label cx u lend in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "nop" in
  let _ = ic_emit_label cx u lcont in
  let _ = ic_pop_if cx u popped in
  let _ = ic_add_catch cx u 1 lstart lend child lcont in
  ic_add_catch cx u 3 lend lcont (0 - 1) lstart;

// pm_compile_ensure: the ensure clause compiled first (inline, after the
// body), the body between lstart and lend, then the ensure sequence and one
// catch entry for each piece of the region the inlined copies left
let ic_ensure_part = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ec = pn_begin_ensure_clause cx n in
  let stmts = pn_ensure_statements cx ec in
  let line = (if stmts >= 0 then ic_start_line cx stmts else ic_start_line cx n) in
  let lstart = ic_new_label cx u in
  let lend = ic_new_label cx u in
  let lcont = ic_new_label cx u in
  let saved = ic_capture_begin cx u in
  let _ = (if stmts >= 0 then ic_node cx u stmts true else ()) in
  let ensr = ic_capture_end cx u saved in
  let rec last_non_trace = fn (e: int) -> if ic_is_end cx e then e else if ic_kind cx e == 2 then last_non_trace (ic_prev cx e) else e in
  let ll = last_non_trace (ic_last cx ensr) in
  let last_leave = ic_kind cx ll == 0 && str_eq (ic_name cx ll) "leave" in
  let ur = ic_ur cx in
  let id = vec_len ur in
  let _ = vec_push ur (Cons ((lstart, lend), Nil)) in
  let ens0 = ic_ensures cx u in
  let _ = ic_set_ensures cx u (Cons ((ec, id), ens0)) in
  let _ = ic_emit_label cx u lstart in
  let pp = popped || last_leave in
  let _ = (if pn_begin_rescue_clause cx n >= 0 then ic_rescue_part cx u n pp
           else if pn_begin_statements cx n >= 0 then ic_node cx u (pn_begin_statements cx n) pp
           else if pp then () else ic_synthetic_putnil cx u) in
  let _ = ic_emit_label cx u lend in
  let _ = ic_set_ensures cx u ens0 in
  let _ = ic_append cx u ensr in
  let _ = ic_here cx u n in
  let _ = (if (if popped then false else true) && last_leave then ic_i0 cx u "putnil" else ()) in
  let _ = ic_emit_label cx u lcont in
  let _ = (if last_leave then ic_i0 cx u "pop" else ()) in
  let child = ic_exception_unit cx u 5 line (if stmts >= 0 then stmts else ec) (ic_nid cx ec) in
  let _ = (if stmts >= 0 then ic_node cx child stmts true else ()) in
  let _ = ic_at cx child (ic_start_line cx ec) (ic_nid cx ec) in
  let _ = ic_getlocal cx child "$!" in
  let _ = ic_in cx child "throw" 0 in
  let _ = ic_finish cx child in
  // (one entry for each piece of the region an inlined copy of the ensure
  //  left: add_ensure_range)
  list_iter (vec_get ur id) (fn (r: int * int) ->
    (let (st, ed) = r in
     if ic_next cx st == ed then () else ic_add_catch cx u 2 st ed child lcont));

// -- multiple assignment ------------------------------------------------------------
// (pm_multi_target_state_t: the topn instructions that reach past the values
//  to a target's receiver, fixed once every target is known). st: a Vec of
//  [stack_size, position]; ents: a Vec of one list of (topns, index, size,
//  position).
let ic_mstate_push = fn cx -> fn st -> fn ents -> fn (topns: int list) -> fn (size: int) ->
  let _ = vec_set ents 0 (Cons ((topns, vec_get st 0 + 1, size, vec_get st 1), vec_get ents 0)) in
  vec_set st 0 (vec_get st 0 + size);
let ic_mstate_update = fn cx -> fn st -> fn ents ->
  let ss = vec_get st 0 in
  if ss == 0 then ()
  else list_iter (vec_get ents 0) (fn (en: int list * int * int * int) ->
         (let (topns, index, _, position) = en in
          list_iter topns (fn (t: int) -> ic_set_ops cx t (Cons (ONum (ss - index + position), Nil)))));
// (an instruction for the writes or the cleanup, at a target's place)
let ic_winsn = fn cx -> fn (l: int) -> fn (t: int) -> fn (name: str) -> fn (ops: IcOp list) ->
  let _ = ic_ref_ops cx ops in
  let e = ic_e_new cx 0 name ops (ic_start_line cx t) (ic_nid cx t) in
  let _ = ic_push cx l e in
  e;
let ic_mt_parts = fn cx -> fn (n: int) ->
  if ic_ty cx n == px_multi_write () then
    (ic_nlist cx (pn_multi_write_lefts cx n) (pn_multi_write_lefts_b cx n), pn_multi_write_rest cx n,
     ic_nlist cx (pn_multi_write_rights cx n) (pn_multi_write_rights_b cx n))
  else
    (ic_nlist cx (pn_multi_target_lefts cx n) (pn_multi_target_lefts_b cx n), pn_multi_target_rest cx n,
     ic_nlist cx (pn_multi_target_rights cx n) (pn_multi_target_rights_b cx n));

let rec ic_multi_target = fn cx -> fn (u: int) -> fn (n: int) -> fn (writes: int) -> fn (cleanup: int) -> fn st -> fn ents ->
  let (lefts, rest, rights) = ic_mt_parts cx n in
  let has_rest = rest >= 0 && ic_ty cx rest == px_splat () && pn_splat_expression cx rest >= 0 in
  let nl = ic_llen lefts in
  let nr = ic_llen rights in
  let has_posts = nr > 0 in
  let _ = ic_winsn cx writes n "expandarray" (Cons (ONum nl, Cons (ONum (if has_rest || has_posts then 1 else 0), Nil))) in
  let base = vec_get st 1 in
  let splat = (if has_rest || has_posts then 1 else 0) in
  let rec each = fn (xs: int list) -> fn (i: int) -> fn (pos: int -> int) ->
    (match xs with
     | Nil -> ()
     | Cons (t, tl) -> (let _ = vec_set st 1 (pos i) in let _ = ic_target cx u t writes cleanup st ents in each tl (i + 1) pos)) in
  let _ = each lefts 0 (fn (i: int) -> nl - i + splat + base) in
  let _ = (if has_rest then
             (let _ = vec_set st 1 (1 + nr + base) in
              let _ = (if has_posts then ic_winsn cx writes n "expandarray" (Cons (ONum nr, Cons (ONum 3, Nil))) else 0) in
              ic_target cx u (pn_splat_expression cx rest) writes cleanup st ents)
           else ()) in
  if has_posts then
    (let _ = (if (if has_rest then false else true) && rest >= 0 then ic_winsn cx writes n "expandarray" (Cons (ONum nr, Cons (ONum 2, Nil))) else 0) in
     each rights 0 (fn (i: int) -> nr - i + base))
  else ();

// pm_compile_target_node: a receiver into the main sequence, the write into
// writes, what it leaves into cleanup
let ic_target = fn cx -> fn (u: int) -> fn (t: int) -> fn (writes: int) -> fn (cleanup: int) -> fn st -> fn ents ->
  let ty = ic_ty cx t in
  if ty == px_local_variable_target () then
    (let ops = ic_local_ref cx u (ic_cname cx (pn_local_variable_target_name cx t)) in
     let _ = ic_winsn cx writes t (ic_local_insn_name cx u "setlocal" ops) ops in ())
  else if ty == px_instance_variable_target () then
    (let _ = ic_winsn cx writes t "setinstancevariable" (Cons (ic_osym cx (ic_cname cx (pn_instance_variable_target_name cx t)), Cons (OIvc (ic_next_is cx u), Nil))) in ())
  else if ty == px_global_variable_target () then
    (let _ = ic_winsn cx writes t "setglobal" (Cons (ic_osym cx (ic_cname cx (pn_global_variable_target_name cx t)), Nil)) in ())
  else if ty == px_class_variable_target () then
    (let nm = ic_cname cx (pn_class_variable_target_name cx t) in
     let _ = ic_winsn cx writes t "setclassvariable" (Cons (ic_osym cx nm, Cons (ic_cvc cx u nm, Nil))) in ())
  else if ty == px_constant_target () then
    (let _ = ic_winsn cx writes t "putspecialobject" (Cons (ONum 3, Nil)) in
     let _ = ic_winsn cx writes t "setconstant" (Cons (ic_osym cx (ic_cname cx (pn_constant_target_name cx t)), Nil)) in ())
  else if ty == px_constant_path_target () then
    (let p = pn_constant_path_target_parent cx t in
     let _ = (if p >= 0 then ic_node cx u p false else (let _ = ic_here cx u t in ic_i1 cx u "putobject" (OVal (IvCls "Object")))) in
     let tn = ic_winsn cx writes t "topn" (Cons (ONum 1, Nil)) in
     let _ = ic_mstate_push cx st ents (Cons (tn, Nil)) 1 in
     let _ = ic_winsn cx writes t "setconstant" (Cons (ic_osym cx (ic_cname cx (pn_constant_path_target_name cx t)), Nil)) in
     let _ = ic_winsn cx cleanup t "pop" Nil in ())
  else if ty == px_call_target () then
    (let _ = ic_node cx u (pn_call_target_receiver cx t) false in
     let safe = (if pq_call_target_safe_navigation cx t then
                   (let l = ic_new_label cx u in
                    let _ = ic_here cx u t in
                    let _ = ic_i0 cx u "dup" in
                    let _ = ic_il cx u "branchnil" l in
                    l)
                 else 0 - 1) in
     let tn = ic_winsn cx writes t "topn" (Cons (ONum 1, Nil)) in
     let _ = ic_mstate_push cx st ents (Cons (tn, Nil)) 1 in
     let _ = ic_winsn cx writes t "swap" Nil in
     let flag = (if pq_call_target_ignore_visibility cx t then 16 + 4 else 16) in
     let _ = ic_winsn cx writes t "send" (Cons (ic_cd (ic_cname cx (pn_call_target_name cx t)) flag 1, Cons (OSeq (0 - 1), Nil))) in
     let _ = ic_winsn cx writes t "pop" Nil in
     let _ = (if safe >= 0 then ic_push cx writes safe else ()) in
     let _ = ic_winsn cx cleanup t "pop" Nil in ())
  else if ty == px_index_target () then
    (let _ = ic_node cx u (pn_index_target_receiver cx t) false in
     let (argc, flag0, _, has_kws) = ic_setup_args cx u (pn_index_target_arguments cx t) (pn_index_target_block cx t) (ic_start_line cx t) (ic_nid cx t) 0 in
     if has_kws then ic_refuse "an index target with keywords is not compiled yet"
     else
       (let first = ic_winsn cx writes t "topn" (Cons (ONum (argc + 1), Nil)) in
        let rec more = fn (k: int) -> if k <= 0 then (Nil : int list) else (let e = ic_winsn cx writes t "topn" (Cons (ONum (argc + 1), Nil)) in Cons (e, more (k - 1))) in
        let topns =
          (if argc == 0 then (let _ = ic_winsn cx writes t "swap" Nil in Cons (first, Nil))
           else
             // (the update reaches the first argc + 1 of them, not the last)
             (let ms = more argc in
              let _ = ic_winsn cx writes t "topn" (Cons (ONum (argc + 1), Nil)) in
              Cons (first, ms))) in
        let _ = ic_mstate_push cx st ents topns (argc + 1) in
        let splat = bit_and flag0 1 != 0 in
        let ci_argc = (if splat then argc else argc + 1) in
        let _ = (if splat then (let _ = ic_winsn cx writes t "newarray" (Cons (ONum 1, Nil)) in let _ = ic_winsn cx writes t "concatarray" Nil in ()) else ()) in
        let flag = (if bit_and flag0 (1 + 2 + 64) == 0 then bit_or flag0 16 else flag0) in
        let _ = ic_winsn cx writes t "send" (Cons (ic_cd "[]=" flag ci_argc, Cons (OSeq (0 - 1), Nil))) in
        let _ = ic_winsn cx writes t "pop" Nil in
        let _ = (if argc != 0 then (let _ = ic_winsn cx writes t "pop" Nil in ()) else ()) in
        let rec pops = fn (k: int) -> if k <= 0 then () else (let _ = ic_winsn cx cleanup t "pop" Nil in pops (k - 1)) in
        pops (argc + 1)))
  else if ty == px_multi_target () then
    (let before = vec_get st 1 in
     let _ = vec_set st 1 (before - 1) in
     let _ = ic_multi_target cx u t writes cleanup st ents in
     vec_set st 1 before)
  else if ty == px_splat () then
    (if pn_splat_expression cx t >= 0 then ic_target cx u (pn_splat_expression cx t) writes cleanup st ents else ())
  else ic_refuse ("a " ++ ic_type_name ty ++ " target is not compiled yet");

let ic_mstate_new = fn (position: int) -> (let v = vec_new () in let _ = vec_push v 0 in let _ = vec_push v position in v);
let ic_ents_new = fn (u: unit) -> (let v = vec_new () in let _ = vec_push v (Nil : (int list * int * int * int) list) in v);

// pm_compile_multi_write_node: the targets' receivers first, the value, its
// expansion and the writes, then what the receivers left
let ic_multi_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let writes = ic_list_new cx in
  let cleanup = ic_list_new cx in
  let st = ic_mstate_new (if popped then 0 else 1) in
  let ents = ic_ents_new () in
  let _ = ic_multi_target cx u n writes cleanup st ents in
  let _ = ic_node cx u (pn_multi_write_value cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = ic_append cx u writes in
  let _ = (if (if popped then false else true) && vec_get st 0 >= 1 then ic_in cx u "setn" (vec_get st 0) else ()) in
  let _ = ic_mstate_update cx st ents in
  ic_append cx u cleanup;

// -- the rest of `node`, again ------------------------------------------------------
let ic_node4 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == px_if () || ty == px_unless () then ic_branch cx u n popped
  else if ty == px_class () || ty == px_module () then ic_class_node cx u n popped
  else if ty == px_singleton_class () then ic_singleton_class cx u n popped
  else if ty == px_while () || ty == px_until () then ic_loop_node cx u n popped
  else if ty == px_break () then ic_break_node cx u n popped
  else if ty == px_next () then ic_next_node cx u n popped
  else if ty == px_redo () then ic_redo_node cx u n popped
  else if ty == px_return () then ic_return_node cx u n popped
  else if ty == px_yield () then ic_yield_node cx u n popped
  else if ty == px_super () || ty == px_forwarding_super () then ic_super_node cx u n popped
  else if ty == px_multi_write () then ic_multi_write cx u n popped
  else if ty == px_begin () then
    (if pn_begin_ensure_clause cx n >= 0 then ic_ensure_part cx u n popped
     else if pn_begin_rescue_clause cx n >= 0 then ic_rescue_part cx u n popped
     else if pn_begin_statements cx n >= 0 then ic_node cx u (pn_begin_statements cx n) popped
     else if popped then () else ic_synthetic_putnil cx u)
  else if ty == px_rescue () then ic_rescue_clause cx u n
  else if ty == px_ensure () then (if pn_ensure_statements cx n >= 0 then ic_node cx u (pn_ensure_statements cx n) popped else ())
  else if ty == px_rescue_modifier () then ic_rescue_modifier cx u n popped
  else if ty == px_retry () then
    (if ic_u_type cx u != 4 then ic_refuse "retry outside a rescue clause is not compiled yet"
     else (let _ = ic_i0 cx u "putnil" in let _ = ic_in cx u "throw" 4 in ic_pop_if cx u popped))
  else if ty == px_else () then ic_compile_part cx u n popped
  else if ty == px_alias_method () then
    // (pm_compile_alias_method_node: core#set_method_alias on the cbase)
    (let _ = ic_in cx u "putspecialobject" 1 in
     let _ = ic_in cx u "putspecialobject" 2 in
     let _ = ic_node cx u (pn_alias_method_new_name cx n) false in
     let _ = ic_node cx u (pn_alias_method_old_name cx n) false in
     let _ = ic_here cx u n in
     let _ = ic_push_send cx u "core#set_method_alias" 3 in
     ic_pop_if cx u popped)
  else if ty == px_alias_global_variable () then
    // (the names as they are written: $a, $&, $1)
    (let _ = ic_in cx u "putspecialobject" 1 in
     let _ = ic_i1 cx u "putobject" (ic_osym cx (ic_node_src cx (pn_alias_global_variable_new_name cx n))) in
     let _ = ic_i1 cx u "putobject" (ic_osym cx (ic_node_src cx (pn_alias_global_variable_old_name cx n))) in
     let _ = ic_push_send cx u "core#set_variable_alias" 2 in
     ic_pop_if cx u popped)
  else if ty == px_undef () then
    // (one core#undef_method a name, the ones but the last popped)
    (let names = ic_nlist cx (pn_undef_names cx n) (pn_undef_names_b cx n) in
     let k = ic_llen names in
     let rec go = fn (xs: int list) -> fn (i: int) ->
       (match xs with
        | Nil -> ()
        | Cons (nm, t) ->
          (let _ = ic_here cx u n in
           let _ = ic_in cx u "putspecialobject" 1 in
           let _ = ic_in cx u "putspecialobject" 2 in
           let _ = ic_node cx u nm false in
           let _ = ic_here cx u n in
           let _ = ic_push_send cx u "core#undef_method" 2 in
           let _ = (if i < k - 1 then ic_i0 cx u "pop" else ()) in
           go t (i + 1))) in
     let _ = go names 0 in
     ic_pop_if cx u popped)
  else ic_node5 cx u n popped ty;

// -- defined? -------------------------------------------------------------------
// (the type's number, and its name -- rb_iseq_defined_string)
let ic_dnum = fn (t: str) ->
  if str_eq t "nil" then 1 else if str_eq t "ivar" then 2 else if str_eq t "lvar" then 3 else if str_eq t "gvar" then 4
  else if str_eq t "cvar" then 5 else if str_eq t "const" then 6 else if str_eq t "method" then 7 else if str_eq t "yield" then 8
  else if str_eq t "zsuper" then 9 else if str_eq t "self" then 10 else if str_eq t "true" then 11 else if str_eq t "false" then 12
  else if str_eq t "asgn" then 13 else if str_eq t "expr" then 14 else if str_eq t "ref" then 15 else if str_eq t "func" then 16 else 17;
let ic_dname = fn (t: str) ->
  if str_eq t "nil" then "nil" else if str_eq t "ivar" then "instance-variable" else if str_eq t "lvar" then "local-variable"
  else if str_eq t "gvar" then "global-variable" else if str_eq t "cvar" then "class variable" else if str_eq t "const" then "constant"
  else if str_eq t "method" then "method" else if str_eq t "yield" then "yield" else if str_eq t "zsuper" then "super"
  else if str_eq t "self" then "self" else if str_eq t "true" then "true" else if str_eq t "false" then "false"
  else if str_eq t "asgn" then "assignment" else "expression";
let ic_asgn_type = fn (s: str) ->
  ic_has_str ["CallAndWriteNode", "CallOperatorWriteNode", "CallOrWriteNode", "ClassVariableAndWriteNode",
    "ClassVariableOperatorWriteNode", "ClassVariableOrWriteNode", "ClassVariableWriteNode", "ConstantAndWriteNode",
    "ConstantOperatorWriteNode", "ConstantOrWriteNode", "ConstantPathAndWriteNode", "ConstantPathOperatorWriteNode",
    "ConstantPathOrWriteNode", "ConstantPathWriteNode", "ConstantWriteNode", "GlobalVariableAndWriteNode",
    "GlobalVariableOperatorWriteNode", "GlobalVariableOrWriteNode", "GlobalVariableWriteNode", "IndexAndWriteNode",
    "IndexOperatorWriteNode", "IndexOrWriteNode", "InstanceVariableAndWriteNode", "InstanceVariableOperatorWriteNode",
    "InstanceVariableOrWriteNode", "InstanceVariableWriteNode", "LocalVariableAndWriteNode",
    "LocalVariableOperatorWriteNode", "LocalVariableOrWriteNode", "LocalVariableWriteNode", "MultiWriteNode"] s;
let ic_expr_type = fn (s: str) ->
  ic_has_str ["AliasGlobalVariableNode", "AliasMethodNode", "AndNode", "BreakNode", "CaseMatchNode", "CaseNode",
    "ClassNode", "DefNode", "DefinedNode", "FlipFlopNode", "FloatNode", "ForNode", "IfNode", "ImaginaryNode", "IntegerNode",
    "InterpolatedMatchLastLineNode", "InterpolatedRegularExpressionNode", "InterpolatedStringNode",
    "InterpolatedSymbolNode", "InterpolatedXStringNode", "LambdaNode", "MatchLastLineNode", "MatchPredicateNode",
    "MatchRequiredNode", "MatchWriteNode", "ModuleNode", "NextNode", "OrNode", "PostExecutionNode", "RangeNode", "RationalNode",
    "RedoNode", "RegularExpressionNode", "RescueModifierNode", "RetryNode", "ReturnNode", "SingletonClassNode",
    "SourceEncodingNode", "SourceFileNode", "SourceLineNode", "StringNode", "SymbolNode", "UndefNode", "UnlessNode", "UntilNode",
    "WhileNode", "XStringNode", "BlockArgumentNode", "ForwardingArgumentsNode"] s;

// pm_compile_defined_expr0: every instruction at the defined? node's place;
// in a condition the answer is true, otherwise the type's name. lfin: a Vec
// of three labels (-1: none yet) -- the end, the "not defined" one a part
// that may raise jumps to, and the one past a call's receiver.
let rec ic_defined0 = fn cx -> fn (u: int) -> fn (n: int) -> fn (at: int) -> fn (cond: bool) -> fn lfin -> fn (explicit: bool) ->
  let val = fn (t: str) -> OVal (if cond then IvTrue else IvStr (ic_dname t, "US-ASCII")) in
  let loc = fn (x: unit) -> ic_here cx u at in
  let dins = fn (t: str) -> fn (operand: IcOp) -> fn (v: str) -> ic_i3 cx u "defined" (ODef (ic_dnum t)) operand (val v) in
  let fin = fn (t: str) -> (let _ = ic_here cx u at in ic_i1 cx u "putobject" (val t)) in
  let need = fn (k: int) -> if vec_get lfin k < 0 then vec_set lfin k (ic_new_label cx u) else () in
  let ty = ic_ty cx n in
  let tn = ic_type_name ty in
  if ty == px_nil () then fin "nil"
  else if ty == px_self () then fin "self"
  else if ty == px_true () then fin "true"
  else if ty == px_false () then fin "false"
  else if ty == px_local_variable_read () then fin "lvar"
  else if ty == px_instance_variable_read () then
    (let _ = loc () in
     ic_i3 cx u "definedivar" (ic_osym cx (ic_cname cx (pn_instance_variable_read_name cx n))) (OIvc (ic_next_is cx u)) (val "ivar"))
  // (a match reference: the number doubled, or the character doubled plus 1)
  else if ty == px_numbered_reference_read () || ty == px_back_reference_read () then
    (let r = (if ty == px_numbered_reference_read () then pn_numbered_reference_read_number cx n * 2
              else ord (char_at (ic_cname cx (pn_back_reference_read_name cx n)) 1) * 2 + 1) in
     let _ = loc () in
     let _ = ic_i0 cx u "putnil" in
     dins "ref" (OVal (IvInt r)) "gvar")
  else if ty == px_global_variable_read () || ty == px_class_variable_read () || ty == px_constant_read () then
    (let (t, nm) = (if ty == px_global_variable_read () then ("gvar", pn_global_variable_read_name cx n)
                    else if ty == px_class_variable_read () then ("cvar", pn_class_variable_read_name cx n)
                    else ("const", pn_constant_read_name cx n)) in
     let _ = loc () in
     let _ = ic_i0 cx u "putnil" in
     dins t (ic_osym cx (ic_cname cx nm)) t)
  else if ty == px_yield () then
    (let _ = ic_u_set_pflag cx (ic_local_iseq cx u) 4 in
     let _ = loc () in
     let _ = ic_i0 cx u "putnil" in
     dins "yield" (OVal IvFalse) "yield")
  else if ty == px_super () || ty == px_forwarding_super () then
    (let b = (if ty == px_super () then pn_super_block cx n else pn_forwarding_super_block cx n) in
     if b >= 0 && (ty == px_forwarding_super () || ic_ty cx b != px_block_argument ()) then fin "expr"
     else (let _ = loc () in let _ = ic_i0 cx u "putnil" in dins "zsuper" (OVal IvFalse) "zsuper"))
  else if ty == px_constant_path () then
    (let p = pn_constant_path_parent cx n in
     let _ =
       (if p >= 0 then
          (let _ = need 1 in
           let _ = ic_defined0 cx u p at true lfin false in
           let _ = loc () in
           let _ = ic_il cx u "branchunless" (vec_get lfin 1) in
           ic_node cx u p false)
        else (let _ = loc () in ic_i1 cx u "putobject" (OVal (IvCls "Object")))) in
     let _ = loc () in
     dins "const_from" (ic_osym cx (ic_cname cx (pn_constant_path_name cx n))) "const")
  else if ty == px_begin () then
    (if pn_begin_rescue_clause cx n < 0 && pn_begin_ensure_clause cx n < 0 && pn_begin_else_clause cx n < 0 then
       (let st = pn_begin_statements cx n in
        if st < 0 then fin "nil"
        else if pn_statements_body_b cx st == 1 then ic_defined0 cx u (ic_li cx (pn_statements_body cx st) 0) at cond lfin false
        else fin "expr")
     else fin "expr")
  else if ty == px_parentheses () then
    (let b = pn_parentheses_body cx n in
     if b < 0 then fin "nil"
     else if ic_ty cx b == px_statements () && (if pq_parentheses_multiple_statements cx n then false else true) then
       ic_defined0 cx u (ic_li cx (pn_statements_body cx b) 0) at cond lfin false
     else fin "expr")
  else if ty == px_array () || ty == px_hash () || ty == px_keyword_hash () || ty == px_arguments () then
    (let (off, cnt) = (if ty == px_array () then (pn_array_elements cx n, pn_array_elements_b cx n)
                       else if ty == px_arguments () then (pn_arguments_arguments cx n, pn_arguments_arguments_b cx n)
                       else if ty == px_hash () then (pn_hash_elements cx n, pn_hash_elements_b cx n)
                       else (pn_keyword_hash_elements cx n, pn_keyword_hash_elements_b cx n)) in
     let _ = (if cnt == 0 || ty == px_arguments () then () else need 1) in
     let _ = list_iter (ic_nlist cx off cnt) (fn (e: int) ->
               (let _ = ic_defined0 cx u e at (if ty == px_arguments () then cond else true) lfin false in
                let _ = loc () in
                ic_il cx u "branchunless" (vec_get lfin 1))) in
     fin "expr")
  else if ty == px_assoc () then
    (let _ = ic_defined0 cx u (pn_assoc_key cx n) at true lfin false in
     let _ = loc () in
     let _ = ic_il cx u "branchunless" (vec_get lfin 1) in
     ic_defined0 cx u (pn_assoc_value cx n) at true lfin false)
  else if ty == px_assoc_splat () then
    (if pn_assoc_splat_value cx n >= 0 then ic_defined0 cx u (pn_assoc_splat_value cx n) at true lfin false else fin "expr")
  else if ty == px_implicit () then ic_defined0 cx u (pn_implicit_value cx n) at cond lfin false
  else if ty == px_splat () then
    (if pn_splat_expression cx n < 0 then fin "expr"
     else
       (let _ = ic_defined0 cx u (pn_splat_expression cx n) at cond lfin false in
        let _ = need 1 in
        let _ = loc () in
        let _ = ic_il cx u "branchunless" (vec_get lfin 1) in
        fin "expr"))
  else if ty == px_call () then
    (let b = pn_call_block cx n in
     if b >= 0 && ic_ty cx b == px_block () then fin "expr"
     else
       (let blockarg = b >= 0 in
        let r = pn_call_receiver cx n in
        let args = pn_call_arguments cx n in
        let name = ic_osym cx (ic_cname cx (pn_call_name cx n)) in
        let _ = (if r >= 0 || args >= 0 || blockarg then (let _ = need 1 in need 2) else ()) in
        let _ = (if args >= 0 then
                   (let _ = ic_defined0 cx u args at true lfin false in
                    let _ = loc () in
                    ic_il cx u "branchunless" (vec_get lfin 1))
                 else ()) in
        let _ = (if blockarg then
                   (let _ = ic_defined0 cx u b at true lfin false in
                    let _ = loc () in
                    ic_il cx u "branchunless" (vec_get lfin 1))
                 else ()) in
        if r >= 0 then
          (let _ =
             (if ic_ty cx r == px_call () && (if ic_tyis cx (pn_call_block cx r) (px_block ()) then false else true) then
                (let _ = ic_defined0 cx u r at true lfin true in
                 let _ = loc () in
                 let _ = ic_il cx u "branchunless" (vec_get lfin 2) in
                 ic_call cx u r false true)
              else
                (let _ = ic_defined0 cx u r at true lfin false in
                 let _ = loc () in
                 let _ = ic_il cx u "branchunless" (vec_get lfin 1) in
                 ic_node cx u r false)) in
           let _ = loc () in
           let _ = (if explicit then ic_i0 cx u "dup" else ()) in
           dins "method" name "method")
        else
          (let _ = loc () in
           let _ = ic_i0 cx u "putself" in
           let _ = (if explicit then ic_i0 cx u "dup" else ()) in
           dins "func" name "method")))
  else if ic_asgn_type tn then fin "asgn"
  else if ic_expr_type tn then fin "expr"
  else ic_refuse ("defined?(" ++ tn ++ ") is not compiled yet");

// pm_compile_defined_expr: nothing when popped; otherwise the test, and when
// a part of it may raise, a putnil before and a swap / pop after for the
// "defined guard" rescue to land on
let ic_defined_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (at: int) -> fn (cond: bool) ->
  let lfin = vec_new () in
  let _ = vec_push lfin (ic_new_label cx u) in
  let _ = vec_push lfin (0 - 1) in
  let _ = vec_push lfin (0 - 1) in
  let mark = ic_last cx (ic_u_list cx u) in
  let _ =
    (if popped then ()
     else
       (let _ = ic_defined0 cx u (pn_defined_value cx n) at cond lfin false in
        if vec_get lfin 1 >= 0 then
          (let lstart = ic_new_label cx u in
           let lend = ic_new_label cx u in
           let guard = ic_unit_new cx 4 ("defined guard in " ++ ic_u_label cx u) (ic_u_path cx u) (ic_u_abs_path cx u) 0
                         (Cons ("$!", Nil)) u (0, 0, 0 - 1, 0 - 1) 0 in
           let _ = ic_add_child cx u guard in
           let _ = ic_u_set_pflag cx guard 512 in
           let _ = ic_at cx guard 0 (0 - 1) in
           let _ = ic_i0 cx guard "putnil" in
           let _ = ic_i0 cx guard "leave" in
           let _ = ic_finish cx guard in
           let _ = ic_ins_after cx mark lstart in
           let _ = ic_emit_label cx u lend in
           ic_add_catch cx u 1 lstart lend guard (vec_get lfin 1))
        else ())) in
  let _ =
    (if vec_get lfin 1 >= 0 then
       (let _ = ic_ins_after cx mark (ic_mk cx "putnil" Nil (ic_start_line cx at) (ic_nid cx at)) in
        let _ = ic_here cx u at in
        let _ = ic_i0 cx u "swap" in
        let _ = (if vec_get lfin 2 >= 0 then ic_emit_label cx u (vec_get lfin 2) else ()) in
        let _ = ic_i0 cx u "pop" in
        ic_emit_label cx u (vec_get lfin 1))
     else ()) in
  ic_emit_label cx u (vec_get lfin 0);

// -- flip-flops -------------------------------------------------------------------
// (an Integer bound is the line just read: `if 2..4` is `$. == 2`)
let ic_flip_flop_bound = fn cx -> fn (u: int) -> fn (b: int) -> fn (popped: bool) ->
  if ic_ty cx b == px_integer () then
    (let _ = ic_node cx u b false in
     let _ = ic_here cx u b in
     let _ = ic_i1 cx u "getglobal" (ic_osym cx "$.") in
     let _ = ic_push_send cx u "==" 1 in
     ic_pop_if cx u popped)
  else ic_node cx u b popped;
// (each one's state is a special variable of the method's frame, numbered
//  from 2)
let ic_flip_flop = fn cx -> fn (u: int) -> fn (n: int) -> fn (else_l: int) -> fn (then_l: int) -> fn (line: int) -> fn (popped: bool) ->
  let lend = ic_new_label cx u in
  let again = (if pq_flip_flop_exclude_end cx n then false else true) in
  let local = ic_local_iseq cx u in
  let key = ic_u_flip_cnt cx local + 2 in
  let _ = ic_u_set cx local 23 (ic_u_flip_cnt cx local + 1) in
  let _ = ic_at cx u line (0 - 1) in
  let _ = ic_i2 cx u "getspecial" (ONum key) (ONum 0) in
  let _ = ic_il cx u "branchif" lend in
  let _ = (if pn_flip_flop_left cx n >= 0 then ic_flip_flop_bound cx u (pn_flip_flop_left cx n) popped else ic_i0 cx u "putnil") in
  let _ = ic_at cx u line (0 - 1) in
  let _ = ic_il cx u "branchunless" else_l in
  let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
  let _ = ic_in cx u "setspecial" key in
  let _ = (if again then () else ic_il cx u "jump" then_l) in
  let _ = ic_emit_label cx u lend in
  let _ = (if pn_flip_flop_right cx n >= 0 then ic_flip_flop_bound cx u (pn_flip_flop_right cx n) popped else ic_i0 cx u "putnil") in
  let _ = ic_at cx u line (0 - 1) in
  let _ = ic_il cx u "branchunless" then_l in
  let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
  let _ = ic_in cx u "setspecial" key in
  ic_il cx u "jump" then_l;

// -- case / when ------------------------------------------------------------------
// (a whole Float is its Integer's key: finite, its own floor)
let ic_float_key = fn (v: float) ->
  let lim = 4.0e18 in
  if v == v && v < lim && v > 0.0 - lim && floor v == v then IvInt (int_of_float v) else IvFlt v;
// pm_compile_case_node_dispatch: the key a literal `when` is under, or none
// (and the hash is given up)
let ic_case_key = fn cx -> fn (u: int) -> fn (c: int) ->
  let ty = ic_ty cx c in
  if ty == px_float () then
    (let v = (vec_get (ic_dbls cx) (pn_float_value cx c) : float) in
     (true, ic_float_key v))
  else if ty == px_false () || ty == px_integer () || ty == px_nil () || ty == px_symbol () || ty == px_true () then (true, ic_static_value cx c)
  else if ty == px_source_line () then (true, IvInt (ic_start_line cx c))
  else if ty == px_source_file () then (true, IvStr (ic_u_path cx u, "UTF-8"))
  else if ty == px_string () then (true, ic_string_value cx c)
  else (false, IvNil);
let rec ic_cdh_has = fn (es: (Iv * int) list) -> fn (k: Iv) ->
  match es with | Nil -> false | Cons ((k0, _), t) -> if ic_iv_eq k0 k then true else ic_cdh_has t k;

// prism_compile.c's pm_compile_case_node: the conditions and the bodies built
// apart; with a subject, a dispatch hash of the literal `when`s, the `===`
// chain, the else part, then the bodies
let ic_case_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let end_l = ic_new_label cx u in
  let bodies = ic_list_new cx in
  let clauses = ic_nlist cx (pn_case_conditions cx n) (pn_case_conditions_b cx n) in
  let els = pn_case_else_clause cx n in
  let pred = pn_case_predicate cx n in
  let body_of = fn (clause: int) -> fn (label: int) -> fn (with_pop: bool) ->
    (let saved = ic_capture_begin cx u in
     let _ = ic_emit_label cx u label in
     let _ = (if with_pop then (let _ = ic_here cx u clause in ic_i0 cx u "pop") else ()) in
     let st = pn_when_statements cx clause in
     let _ = (if st >= 0 then ic_node cx u st popped else if popped then () else ic_synthetic_putnil cx u) in
     let _ = (if with_pop then ic_here cx u clause else ic_here cx u n) in
     let _ = ic_il cx u "jump" end_l in
     ic_list_append cx bodies (ic_capture_end cx u saved)) in
  let conds_of = fn (clause: int) -> ic_nlist cx (pn_when_conditions cx clause) (pn_when_conditions_b cx clause) in
  let _ =
    (if pred < 0 then
       (let saved = ic_capture_begin cx u in
        let _ = list_iter clauses (fn (clause: int) ->
                  (let label = ic_new_label cx u in
                   let _ = body_of clause label false in
                   list_iter (conds_of clause) (fn (c: int) ->
                     if ic_ty cx c == px_splat () then
                       (let _ = ic_here cx u c in
                        let _ = ic_i0 cx u "putnil" in
                        let _ = ic_node cx u c false in
                        let _ = ic_here cx u c in
                        let _ = ic_in cx u "checkmatch" 5 in
                        ic_il cx u "branchif" label)
                     else
                       (let next_l = ic_new_label cx u in
                        let _ = ic_branch_condition cx u c label next_l c in
                        ic_emit_label cx u next_l)))) in
        let _ = (if els >= 0 then ic_node cx u els popped else if popped then () else ic_synthetic_putnil cx u) in
        let _ = ic_here cx u n in
        let _ = ic_il cx u "jump" end_l in
        ic_append cx u (ic_capture_end cx u saved))
     else
       (let else_l = ic_new_label cx u in
        // (the dispatch hash: still being built, and its entries)
        let disp = vec_new () in
        let _ = vec_push disp 1 in
        let ents = vec_new () in
        let _ = vec_push ents (Nil : (Iv * int) list) in
        let saved = ic_capture_begin cx u in
        let _ = list_iter clauses (fn (clause: int) ->
                  (let label = ic_new_label cx u in
                   let _ = list_iter (conds_of clause) (fn (c: int) ->
                             (let _ =
                                (if vec_get disp 0 == 1 then
                                   (let (ok, key) = ic_case_key cx u c in
                                    if (if ok then false else true) then vec_set disp 0 0
                                    else if ic_cdh_has (vec_get ents 0) key then ()
                                    else vec_set ents 0 (ic_cat (vec_get ents 0) (Cons ((key, label), Nil))))
                                 else ()) in
                              let _ =
                                (if ic_ty cx c == px_splat () then
                                   (let _ = ic_here cx u c in
                                    let _ = ic_i0 cx u "dup" in
                                    let _ = ic_node cx u c false in
                                    let _ = ic_here cx u c in
                                    ic_in cx u "checkmatch" 6)
                                 else
                                   (let _ = (if ic_ty cx c == px_string () then
                                               (let _ = ic_here cx u c in ic_i1 cx u "putobject" (OVal (ic_string_value cx c)))
                                             else ic_node cx u c false) in
                                    let _ = ic_here cx u c in
                                    let _ = ic_in cx u "topn" 1 in
                                    ic_i2 cx u "send" (ic_cd "===" 20 1) (OSeq (0 - 1)))) in
                              let _ = ic_here cx u c in
                              ic_il cx u "branchif" label)) in
                   body_of clause label true)) in
        let conds = ic_capture_end cx u saved in
        let _ = ic_node cx u pred false in
        let _ = (if vec_get disp 0 == 1 then
                   (let es = vec_get ents 0 in
                    let _ = list_iter es (fn (kl: Iv * int) -> (let (_, l) = kl in ic_ref cx l)) in
                    let _ = list_iter es (fn (kl: Iv * int) -> (let (_, l) = kl in ic_unref cx l)) in
                    let _ = ic_here cx u n in
                    let _ = ic_i0 cx u "dup" in
                    ic_i2 cx u "opt_case_dispatch" (OCdh es) (OLab else_l))
                 else ()) in
        let _ = ic_append cx u conds in
        let _ = ic_emit_label cx u else_l in
        if els >= 0 then
          (let at = (if pn_else_statements cx els >= 0 then pn_else_statements cx els else els) in
           let _ = ic_here cx u at in
           let _ = ic_i0 cx u "pop" in
           let _ = ic_node cx u els popped in
           let _ = ic_here cx u at in
           ic_il cx u "jump" end_l)
        else
          (let _ = ic_here cx u n in
           let _ = ic_i0 cx u "pop" in
           let _ = (if popped then () else ic_i0 cx u "putnil") in
           ic_il cx u "jump" end_l))) in
  let _ = ic_append cx u bodies in
  ic_emit_label cx u end_l;

// -- writes -----------------------------------------------------------------------
let ic_push_send_k = fn cx -> fn (u: int) -> fn (mid: str) -> fn (argc: int) -> fn (flag: int) -> fn (kws: str list) -> fn (has_kws: bool) ->
  ic_i2 cx u "send" (ic_ci mid argc flag kws has_kws false) (OSeq (0 - 1));

// x ||= v / x &&= v, of a local or an instance variable; a local's ||= opens
// with `putobject true; branchunless` (the peephole drops it)
let ic_or_and_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ty = ic_ty cx n in
  let or_ = ty == px_local_variable_or_write () || ty == px_instance_variable_or_write () in
  let local = ty == px_local_variable_or_write () || ty == px_local_variable_and_write () in
  let (name, value) =
    (if ty == px_local_variable_or_write () then (pn_local_variable_or_write_name cx n, pn_local_variable_or_write_value cx n)
     else if ty == px_local_variable_and_write () then (pn_local_variable_and_write_name cx n, pn_local_variable_and_write_value cx n)
     else if ty == px_instance_variable_or_write () then (pn_instance_variable_or_write_name cx n, pn_instance_variable_or_write_value cx n)
     else (pn_instance_variable_and_write_name cx n, pn_instance_variable_and_write_value cx n)) in
  let nm = ic_cname cx name in
  let end_l = ic_new_label cx u in
  let set_l = (if local && or_ then ic_new_label cx u else 0 - 1) in
  let _ = (if set_l >= 0 then (let _ = ic_i1 cx u "putobject" (OVal IvTrue) in ic_il cx u "branchunless" set_l) else ()) in
  let _ = (if local then ic_getlocal cx u nm else ic_i2 cx u "getinstancevariable" (ic_osym cx nm) (OIvc (ic_next_is cx u))) in
  let _ = ic_dup_unless cx u popped in
  let _ = ic_il cx u (if or_ then "branchif" else "branchunless") end_l in
  let _ = (if popped then () else ic_i0 cx u "pop") in
  let _ = (if set_l >= 0 then ic_emit_label cx u set_l else ()) in
  let _ = ic_node cx u value false in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = (if local then ic_setlocal cx u nm else ic_i2 cx u "setinstancevariable" (ic_osym cx nm) (OIvc (ic_next_is cx u))) in
  ic_emit_label cx u end_l;

// $g / X &&= v and ||= v: an ||= asks defined? first, so that reading what is
// not there yet does not warn or raise
let ic_var_and_or_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ty = ic_ty cx n in
  let or_ = ty == px_global_variable_or_write () || ty == px_constant_or_write () in
  let const = ty == px_constant_and_write () || ty == px_constant_or_write () in
  let (name, value, nloc) =
    (if ty == px_global_variable_or_write () then (pn_global_variable_or_write_name cx n, pn_global_variable_or_write_value cx n, 0)
     else if ty == px_global_variable_and_write () then (pn_global_variable_and_write_name cx n, pn_global_variable_and_write_value cx n, 0)
     else if ty == px_constant_or_write () then (pn_constant_or_write_name cx n, pn_constant_or_write_value cx n, pn_constant_or_write_name_loc cx n)
     else (pn_constant_and_write_name cx n, pn_constant_and_write_value cx n, pn_constant_and_write_name_loc cx n)) in
  let nm = ic_cname cx name in
  let end_l = ic_new_label cx u in
  let set_l = (if or_ then ic_new_label cx u else 0 - 1) in
  let _ = (if or_ then
             (let _ = ic_i0 cx u "putnil" in
              let _ = ic_i3 cx u "defined" (ODef (ic_dnum (if const then "const" else "gvar"))) (ic_osym cx nm) (OVal IvTrue) in
              ic_il cx u "branchunless" set_l)
           else ()) in
  let _ = (if const then ic_constant_read cx u nm (ic_line_of cx nloc) n else ic_i1 cx u "getglobal" (ic_osym cx nm)) in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = ic_il cx u (if or_ then "branchif" else "branchunless") end_l in
  let _ = (if popped then () else ic_i0 cx u "pop") in
  let _ = (if set_l >= 0 then ic_emit_label cx u set_l else ()) in
  let _ = ic_node cx u value false in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = (if const then (let _ = ic_in cx u "putspecialobject" 3 in ic_i1 cx u "setconstant" (ic_osym cx nm))
           else ic_i1 cx u "setglobal" (ic_osym cx nm)) in
  ic_emit_label cx u end_l;

// @@x ||= v (defined first: reading one that is not is a NameError) and
// @@x &&= v
let ic_cvar_or_and_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let or_ = ic_ty cx n == px_class_variable_or_write () in
  let nm = ic_cname cx (if or_ then pn_class_variable_or_write_name cx n else pn_class_variable_and_write_name cx n) in
  let value = (if or_ then pn_class_variable_or_write_value cx n else pn_class_variable_and_write_value cx n) in
  let end_l = ic_new_label cx u in
  let _ =
    (if or_ then
       (let set_l = ic_new_label cx u in
        let _ = ic_i0 cx u "putnil" in
        let _ = ic_i3 cx u "defined" (ODef 5) (ic_osym cx nm) (OVal IvTrue) in
        let _ = ic_il cx u "branchunless" set_l in
        let _ = ic_i2 cx u "getclassvariable" (ic_osym cx nm) (ic_cvc cx u nm) in
        let _ = ic_dup_unless cx u popped in
        let _ = ic_il cx u "branchif" end_l in
        let _ = (if popped then () else ic_i0 cx u "pop") in
        ic_emit_label cx u set_l)
     else
       (let _ = ic_i2 cx u "getclassvariable" (ic_osym cx nm) (ic_cvc cx u nm) in
        let _ = ic_dup_unless cx u popped in
        let _ = ic_il cx u "branchunless" end_l in
        if popped then () else ic_i0 cx u "pop")) in
  let _ = ic_node cx u value false in
  let _ = ic_here cx u n in
  let _ = ic_dup_unless cx u popped in
  let _ = ic_i2 cx u "setclassvariable" (ic_osym cx nm) (ic_cvc cx u nm) in
  ic_emit_label cx u end_l;

// pm_compile_constant_path_*_write_node: the owner (Object for ::X) stays
// under the value; the constant is read with getconstant
let ic_constant_path_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ty = ic_ty cx n in
  let (t, value) =
    (if ty == px_constant_path_write () then (pn_constant_path_write_target cx n, pn_constant_path_write_value cx n)
     else if ty == px_constant_path_operator_write () then (pn_constant_path_operator_write_target cx n, pn_constant_path_operator_write_value cx n)
     else if ty == px_constant_path_or_write () then (pn_constant_path_or_write_target cx n, pn_constant_path_or_write_value cx n)
     else (pn_constant_path_and_write_target cx n, pn_constant_path_and_write_value cx n)) in
  let name = ic_osym cx (ic_cname cx (pn_constant_path_name cx t)) in
  let _ = (if pn_constant_path_parent cx t >= 0 then ic_node cx u (pn_constant_path_parent cx t) false else ic_i1 cx u "putobject" (OVal (IvCls "Object"))) in
  let _ = ic_here cx u n in
  if ty == px_constant_path_write () then
    (let _ = ic_node cx u value false in
     let _ = ic_here cx u n in
     let _ = (if popped then () else (let _ = ic_i0 cx u "swap" in ic_in cx u "topn" 1)) in
     let _ = ic_i0 cx u "swap" in
     ic_i1 cx u "setconstant" name)
  else if ty == px_constant_path_operator_write () then
    (let _ = ic_i0 cx u "dup" in
     let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
     let _ = ic_i1 cx u "getconstant" name in
     let _ = ic_node cx u value false in
     let _ = ic_here cx u n in
     let _ = ic_i2 cx u "send" (ic_cd (ic_cname cx (pn_constant_path_operator_write_binary_operator cx n)) 20 1) (OSeq (0 - 1)) in
     let _ = ic_i0 cx u "swap" in
     let _ = (if popped then () else (let _ = ic_in cx u "topn" 1 in ic_i0 cx u "swap")) in
     ic_i1 cx u "setconstant" name)
  else
    (let or_ = ty == px_constant_path_or_write () in
     let lfin = ic_new_label cx u in
     let lassign = (if or_ then ic_new_label cx u else 0 - 1) in
     let _ = (if or_ then
                (let _ = ic_i0 cx u "dup" in
                 let _ = ic_i3 cx u "defined" (ODef 17) name (OVal IvTrue) in
                 ic_il cx u "branchunless" lassign)
              else ()) in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
     let _ = ic_i1 cx u "getconstant" name in
     let _ = ic_dup_unless cx u popped in
     let _ = ic_il cx u (if or_ then "branchif" else "branchunless") lfin in
     let _ = (if popped then () else ic_i0 cx u "pop") in
     let _ = (if lassign >= 0 then ic_emit_label cx u lassign else ()) in
     let _ = ic_node cx u value false in
     let _ = ic_here cx u n in
     let _ = (if popped then ic_in cx u "topn" 1 else (let _ = ic_in cx u "dupn" 2 in ic_i0 cx u "swap")) in
     let _ = ic_i1 cx u "setconstant" name in
     let _ = ic_emit_label cx u lfin in
     let _ = (if popped then () else ic_i0 cx u "swap") in
     ic_i0 cx u "pop");

// pm_compile_call_and_or_write_node: r.x &&= v / r.x ||= v (FCALL for self
// alone), with &. skipping it all on nil
let ic_call_and_or_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let and_ = ic_ty cx n == px_call_and_write () in
  let r = (if and_ then pn_call_and_write_receiver cx n else pn_call_or_write_receiver cx n) in
  if r < 0 then ic_refuse "a call write without a receiver is not compiled yet"
  else
    (let safe = (if and_ then pq_call_and_write_safe_navigation cx n else pq_call_or_write_safe_navigation cx n) in
     let rname = ic_cname cx (if and_ then pn_call_and_write_read_name cx n else pn_call_or_write_read_name cx n) in
     let wname = ic_cname cx (if and_ then pn_call_and_write_write_name cx n else pn_call_or_write_write_name cx n) in
     let value = (if and_ then pn_call_and_write_value cx n else pn_call_or_write_value cx n) in
     let lfin = ic_new_label cx u in
     let lcfin = ic_new_label cx u in
     let flag = (if ic_ty cx r == px_self () then 4 else 0) in
     let _ = ic_node cx u r false in
     let _ = ic_here cx u n in
     let lskip = (if safe then (let l = ic_new_label cx u in let _ = ic_i0 cx u "dup" in let _ = ic_il cx u "branchnil" l in l) else 0 - 1) in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_push_send_f cx u rname 0 flag in
     let _ = ic_dup_unless cx u popped in
     let _ = ic_il cx u (if and_ then "branchunless" else "branchif") lcfin in
     let _ = (if popped then () else ic_i0 cx u "pop") in
     let _ = ic_node cx u value false in
     let _ = ic_here cx u n in
     let _ = (if popped then () else (let _ = ic_i0 cx u "swap" in ic_in cx u "topn" 1)) in
     let _ = ic_push_send_f cx u wname 1 flag in
     let _ = ic_il cx u "jump" lfin in
     let _ = ic_emit_label cx u lcfin in
     let _ = (if popped then () else ic_i0 cx u "swap") in
     let _ = ic_emit_label cx u lfin in
     let _ = (if lskip >= 0 && popped then ic_emit_label cx u lskip else ()) in
     let _ = ic_i0 cx u "pop" in
     if lskip >= 0 && (if popped then false else true) then ic_emit_label cx u lskip else ());

// pm_compile_call_operator_write_node: r.x op= v
let ic_call_operator_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let flag = (if pq_call_operator_write_ignore_visibility cx n then 4 else 0) in
  let _ = ic_node cx u (pn_call_operator_write_receiver cx n) false in
  let _ = ic_here cx u n in
  let safe = (if pq_call_operator_write_safe_navigation cx n then
                (let l = ic_new_label cx u in let _ = ic_i0 cx u "dup" in let _ = ic_il cx u "branchnil" l in l)
              else 0 - 1) in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_push_send_f cx u (ic_cname cx (pn_call_operator_write_read_name cx n)) 0 flag in
  let _ = ic_node cx u (pn_call_operator_write_value cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_push_send cx u (ic_cname cx (pn_call_operator_write_binary_operator cx n)) 1 in
  let _ = (if popped then () else (let _ = ic_i0 cx u "swap" in ic_in cx u "topn" 1)) in
  let _ = ic_push_send_f cx u (ic_cname cx (pn_call_operator_write_write_name cx n)) 1 flag in
  let _ = (if safe >= 0 && popped then ic_emit_label cx u safe else ()) in
  let _ = ic_i0 cx u "pop" in
  if safe >= 0 && (if popped then false else true) then ic_emit_label cx u safe else ();

// pm_compile_index_operator_write_node and
// pm_compile_index_control_flow_write_node: the receiver and the arguments
// kept (dupn) for the [] and then the []=, the new value moved in under them
// as the last argument -- onto a splat's array, or past keywords (opt_reverse)
let ic_index_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ty = ic_ty cx n in
  let op = ty == px_index_operator_write () in
  let (recv, args, block, value) =
    (if op then (pn_index_operator_write_receiver cx n, pn_index_operator_write_arguments cx n, pn_index_operator_write_block cx n, pn_index_operator_write_value cx n)
     else if ty == px_index_and_write () then (pn_index_and_write_receiver cx n, pn_index_and_write_arguments cx n, pn_index_and_write_block cx n, pn_index_and_write_value cx n)
     else (pn_index_or_write_receiver cx n, pn_index_or_write_arguments cx n, pn_index_or_write_block cx n, pn_index_or_write_value cx n)) in
  let line = ic_start_line cx n in
  let nid = ic_nid cx n in
  let at = fn (x: unit) -> ic_at cx u line nid in
  let _ = (if popped then () else ic_i0 cx u "putnil") in
  let _ = ic_node cx u recv false in
  let boff = (if block >= 0 then 1 else 0) in
  let flag0 = (if ic_ty cx recv == px_self () then 4 else 0) in
  let (argc, flag1, kws, has_kws) = ic_setup_args cx u args block line nid flag0 in
  let _ = at () in
  let _ = (if (argc > 0 || boff == 1) && bit_and flag1 64 != 0 then
             (if boff == 1 then ic_i0 cx u "splatkw"
              else (let _ = ic_i0 cx u "dup" in let _ = ic_i0 cx u "splatkw" in ic_i0 cx u "pop"))
           else ()) in
  let klen = (if has_kws then ic_llen kws else 0) in
  let dup_argn = argc + 1 + boff + klen in
  let _ = ic_in cx u "dupn" dup_argn in
  let _ = ic_push_send_k cx u "[]" argc (flag1 - bit_and flag1 4096 - bit_and flag1 2048) kws has_kws in
  let (label, lfin) =
    (if op then
       (let _ = ic_node cx u value false in
        let _ = at () in
        let _ = ic_push_send cx u (ic_cname cx (pn_index_operator_write_binary_operator cx n)) 1 in
        (0 - 1, 0 - 1))
     else
       (let label = ic_new_label cx u in
        let lfin = ic_new_label cx u in
        let _ = ic_i0 cx u "dup" in
        let _ = ic_il cx u (if ty == px_index_and_write () then "branchunless" else "branchif") label in
        let _ = ic_i0 cx u "pop" in
        let _ = ic_node cx u value false in
        let _ = at () in
        (label, lfin))) in
  let _ = (if popped then () else ic_in cx u "setn" (dup_argn + 1)) in
  let flag =
    (if bit_and flag1 1 != 0 then
       (let f2 =
          (if bit_and flag1 64 != 0 then
             (let _ = ic_in cx u "topn" (2 + boff) in
              let f = (if bit_and flag1 4096 == 0 then (let _ = ic_i1 cx u "splatarray" (OVal IvTrue) in bit_or flag1 4096) else flag1) in
              let _ = ic_i0 cx u "swap" in
              let _ = ic_in cx u "pushtoarray" 1 in
              let _ = ic_in cx u "setn" (2 + boff) in
              let _ = ic_i0 cx u "pop" in
              f)
           else
             (let _ = (if boff > 0 then (let _ = ic_in cx u "dupn" 3 in let _ = ic_i0 cx u "swap" in ic_i0 cx u "pop") else ()) in
              let f = (if bit_and flag1 4096 == 0 then
                         (let _ = ic_i0 cx u "swap" in let _ = ic_i1 cx u "splatarray" (OVal IvTrue) in let _ = ic_i0 cx u "swap" in bit_or flag1 4096)
                       else flag1) in
              let _ = ic_in cx u "pushtoarray" 1 in
              let _ = (if boff > 0 then (let _ = ic_in cx u "setn" 3 in let _ = ic_i0 cx u "pop" in ic_i0 cx u "pop") else ()) in
              f)) in
        let _ = ic_push_send_k cx u "[]=" argc f2 kws has_kws in
        f2)
     else if bit_and flag1 64 != 0 then
       (let _ = (if boff > 0 then (let _ = ic_in cx u "topn" 2 in let _ = ic_i0 cx u "swap" in let _ = ic_in cx u "setn" 3 in ic_i0 cx u "pop") else ()) in
        let _ = ic_i0 cx u "swap" in
        let _ = ic_push_send_k cx u "[]=" (argc + 1) flag1 kws has_kws in
        flag1)
     else if klen > 0 then
       (let _ = (if op then
                   (let _ = ic_i0 cx u "dup" in
                    let _ = ic_in cx u "opt_reverse" (klen + boff + 2) in
                    let _ = ic_in cx u "opt_reverse" (klen + boff + 1) in
                    ic_i0 cx u "pop")
                 else
                   (let _ = ic_in cx u "opt_reverse" (klen + boff + 1) in
                    ic_in cx u "opt_reverse" (klen + boff))) in
        let _ = ic_push_send_k cx u "[]=" (argc + 1) flag1 kws has_kws in
        flag1)
     else
       (let _ = (if boff > 0 then ic_i0 cx u "swap" else ()) in
        let _ = ic_push_send_k cx u "[]=" (argc + 1) flag1 kws has_kws in
        flag1)) in
  let _ = flag in
  let _ = ic_i0 cx u "pop" in
  if op then ()
  else
    (let _ = ic_il cx u "jump" lfin in
     let _ = ic_emit_label cx u label in
     let _ = (if popped then () else ic_in cx u "setn" (dup_argn + 1)) in
     let _ = ic_in cx u "adjuststack" (dup_argn + 1) in
     ic_emit_label cx u lfin);

// pm_compile_node's PM_MATCH_WRITE_NODE: `/(?<n>..)/ =~ s` -- the match, then
// $~'s named groups into their locals, nil each when it failed
let ic_match_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let fail_l = ic_new_label cx u in
  let end_l = ic_new_label cx u in
  let targets = ic_nlist cx (pn_match_write_targets cx n) (pn_match_write_targets_b cx n) in
  let tname = fn (t: int) -> ic_cname cx (pn_local_variable_target_name cx t) in
  let _ = ic_node cx u (pn_match_write_call cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_i1 cx u "getglobal" (ic_osym cx "$~") in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_il cx u "branchunless" fail_l in
  match targets with
  | Cons (t, Nil) ->
    (let _ = ic_i1 cx u "putobject" (ic_osym cx (tname t)) in
     let _ = ic_push_send cx u "[]" 1 in
     let _ = ic_emit_label cx u fail_l in
     let _ = ic_setlocal cx u (tname t) in
     ic_pop_if cx u popped)
  | _ ->
    (let k = ic_llen targets in
     let rec each = fn (ts: int list) -> fn (i: int) ->
       (match ts with
        | Nil -> ()
        | Cons (t, rest) ->
          (let _ = (if i < k - 1 then ic_i0 cx u "dup" else ()) in
           let _ = ic_i1 cx u "putobject" (ic_osym cx (tname t)) in
           let _ = ic_push_send cx u "[]" 1 in
           let _ = ic_setlocal cx u (tname t) in
           each rest (i + 1))) in
     let _ = each targets 0 in
     let _ = ic_il cx u "jump" end_l in
     let _ = ic_emit_label cx u fail_l in
     let _ = ic_i0 cx u "pop" in
     let _ = list_iter targets (fn (t: int) -> (let _ = ic_i0 cx u "putnil" in ic_setlocal cx u (tname t))) in
     let _ = ic_emit_label cx u end_l in
     ic_pop_if cx u popped);

// `x op= v` for an instance variable, a global, a class variable, a constant
let ic_var_op_write = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let ty = ic_ty cx n in
  let _ =
    (if ty == px_instance_variable_operator_write () then
       ic_i2 cx u "getinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_operator_write_name cx n))) (OIvc (ic_next_is cx u))
     else if ty == px_global_variable_operator_write () then
       ic_i1 cx u "getglobal" (ic_osym cx (ic_cname cx (pn_global_variable_operator_write_name cx n)))
     else if ty == px_class_variable_operator_write () then
       (let nm = ic_cname cx (pn_class_variable_operator_write_name cx n) in ic_i2 cx u "getclassvariable" (ic_osym cx nm) (ic_cvc cx u nm))
     else
       ic_constant_read cx u (ic_cname cx (pn_constant_operator_write_name cx n)) (ic_line_of cx (pn_constant_operator_write_name_loc cx n)) n) in
  let (value, op) =
    (if ty == px_instance_variable_operator_write () then (pn_instance_variable_operator_write_value cx n, pn_instance_variable_operator_write_binary_operator cx n)
     else if ty == px_global_variable_operator_write () then (pn_global_variable_operator_write_value cx n, pn_global_variable_operator_write_binary_operator cx n)
     else if ty == px_class_variable_operator_write () then (pn_class_variable_operator_write_value cx n, pn_class_variable_operator_write_binary_operator cx n)
     else (pn_constant_operator_write_value cx n, pn_constant_operator_write_binary_operator cx n)) in
  let _ = ic_node cx u value false in
  let _ = ic_here cx u n in
  let _ = ic_push_send cx u (ic_cname cx op) 1 in
  let _ = ic_dup_unless cx u popped in
  if ty == px_instance_variable_operator_write () then
    ic_i2 cx u "setinstancevariable" (ic_osym cx (ic_cname cx (pn_instance_variable_operator_write_name cx n))) (OIvc (ic_next_is cx u))
  else if ty == px_global_variable_operator_write () then
    ic_i1 cx u "setglobal" (ic_osym cx (ic_cname cx (pn_global_variable_operator_write_name cx n)))
  else if ty == px_class_variable_operator_write () then
    (let nm = ic_cname cx (pn_class_variable_operator_write_name cx n) in ic_i2 cx u "setclassvariable" (ic_osym cx nm) (ic_cvc cx u nm))
  else
    (let _ = ic_in cx u "putspecialobject" 3 in
     ic_i1 cx u "setconstant" (ic_osym cx (ic_cname cx (pn_constant_operator_write_name cx n))));

let ic_node5 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == px_defined () then ic_defined_node cx u n popped n false
  else if ty == px_case () then ic_case_node cx u n popped
  else if ty == px_local_variable_or_write () || ty == px_local_variable_and_write ()
          || ty == px_instance_variable_or_write () || ty == px_instance_variable_and_write () then ic_or_and_write cx u n popped
  else if ty == px_global_variable_or_write () || ty == px_global_variable_and_write ()
          || ty == px_constant_or_write () || ty == px_constant_and_write () then ic_var_and_or_write cx u n popped
  else if ty == px_class_variable_or_write () || ty == px_class_variable_and_write () then ic_cvar_or_and_write cx u n popped
  else if ty == px_instance_variable_operator_write () || ty == px_global_variable_operator_write ()
          || ty == px_class_variable_operator_write () || ty == px_constant_operator_write () then ic_var_op_write cx u n popped
  else if ty == px_constant_path_write () || ty == px_constant_path_operator_write () || ty == px_constant_path_or_write ()
          || ty == px_constant_path_and_write () then ic_constant_path_write cx u n popped
  else if ty == px_call_and_write () || ty == px_call_or_write () then ic_call_and_or_write cx u n popped
  else if ty == px_call_operator_write () then ic_call_operator_write cx u n popped
  else if ty == px_index_operator_write () || ty == px_index_and_write () || ty == px_index_or_write () then ic_index_write cx u n popped
  else if ty == px_match_write () then ic_match_write cx u n popped
  // (PM_FLIP_FLOP_NODE as a value: true or false of it)
  else if ty == px_flip_flop () then
    (let final = ic_new_label cx u in
     let then_l = ic_new_label cx u in
     let else_l = ic_new_label cx u in
     let _ = ic_flip_flop cx u n else_l then_l (ic_start_line cx n) popped in
     let _ = ic_here cx u n in
     let _ = ic_emit_label cx u then_l in
     let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
     let _ = ic_il cx u "jump" final in
     let _ = ic_emit_label cx u else_l in
     let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
     ic_emit_label cx u final)
  // PM_MATCH_LAST_LINE_NODE: a pattern as a condition is `pattern =~ $_`
  else if ty == px_match_last_line () then
    (let _ = ic_here cx u n in
     let _ = ic_i1 cx u "putobject" (OVal (ic_regexp_literal cx (ic_str cx (pn_match_last_line_unescaped cx n), ic_enc cx) n)) in
     let _ = ic_i2 cx u "getspecial" (ONum 0) (ONum 0) in
     let _ = ic_push_send cx u "=~" 1 in
     ic_pop_if cx u popped)
  else ic_node6 cx u n popped ty;

// -- for ------------------------------------------------------------------------
// pm_compile_for_node_index: the block's one parameter written to the loop's
// target -- a local as it is; any other single target as the one element of
// the parameters; several targets as the parameters, or as the one
// parameter when it converts to an Array
let ic_for_index = fn cx -> fn (child: int) -> fn (t: int) -> fn (hidden: str) ->
  let _ = ic_here cx child t in
  let ty = ic_ty cx t in
  if ty == px_local_variable_target () then
    (let _ = ic_insn cx child "getlocal" (Cons (ic_local_op cx child 0, Cons (ONum 0, Nil))) in
     // (where the name is, counted from the block: Prism's depth is the
     //  scope's around the loop)
     ic_setlocal cx child (ic_cname cx (pn_local_variable_target_name cx t)))
  else if ty == px_splat () || ty == px_multi_target () then
    (let writes = ic_list_new cx in
     let cleanup = ic_list_new cx in
     let st = ic_mstate_new 0 in
     let ents = ic_ents_new () in
     // (no state is handed down here, so a call or an index target's topn
     //  stays as it was written -- reaching a value, not its receiver: ruby
     //  4.0's `for o.x, y in [[1, 2]]` calls x= on the 2)
     let _ = (if ty == px_multi_target () then ic_multi_target cx child t writes cleanup st ents
              else ic_target cx child t writes cleanup st ents) in
     // (the four calls are on the value, with FCALL as ruby writes them:
     //  marked for the VM, to which FCALL is a call without a receiver)
     let recv = Cons (OVal (IvSym ("recv", "US-ASCII")), Nil) in
     let mark = fn (mid: str) -> fn (argc: int) ->
       (let e = ic_insn cx child "send" (Cons (ic_cd mid 20 argc, Cons (OSeq (0 - 1), Nil))) in
        ic_set_vmx cx e recv) in
     let not_single = ic_new_label cx child in
     let not_ary = ic_new_label cx child in
     let _ = ic_here cx child t in
     let _ = ic_insn cx child "getlocal" (Cons (ic_local_op cx child 0, Cons (ONum 0, Nil))) in
     let _ = ic_i0 cx child "dup" in
     let _ = mark "length" 0 in
     let _ = ic_i1 cx child "putobject" (OVal (IvInt 1)) in
     let _ = mark "==" 1 in
     let _ = ic_il cx child "branchunless" not_single in
     let _ = ic_i0 cx child "dup" in
     let _ = ic_i1 cx child "putobject" (OVal (IvInt 0)) in
     let _ = mark "[]" 1 in
     let _ = ic_i1 cx child "putobject" (OVal (IvCls "Array")) in
     let _ = ic_i0 cx child "swap" in
     let _ = mark "try_convert" 1 in
     let _ = ic_i0 cx child "dup" in
     let _ = ic_il cx child "branchunless" not_ary in
     let _ = ic_i0 cx child "swap" in
     let _ = ic_emit_label cx child not_ary in
     let _ = ic_i0 cx child "pop" in
     let _ = ic_emit_label cx child not_single in
     let _ = (if ty == px_splat () then ic_i2 cx child "expandarray" (ONum 0) (ONum (if pn_splat_expression cx t < 0 then 0 else 1)) else ()) in
     let _ = ic_append cx child writes in
     ic_append cx child cleanup)
  else
    (let writes = ic_list_new cx in
     let cleanup = ic_list_new cx in
     let st = ic_mstate_new 1 in
     let ents = ic_ents_new () in
     let _ = ic_target cx child t writes cleanup st ents in
     let _ = ic_here cx child t in
     let _ = ic_insn cx child "getlocal" (Cons (ic_local_op cx child 0, Cons (ONum 0, Nil))) in
     let _ = ic_i2 cx child "expandarray" (ONum 1) (ONum 0) in
     let _ = ic_append cx child writes in
     let _ = ic_append cx child cleanup in
     ic_mstate_update cx st ents);

// `for x in c`: c.each with a block whose one parameter is hidden and written
// to x (a local of the scope around) before the block's b_call
let ic_for_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let retry_l = ic_new_label cx u in
  let retry_end = ic_new_label cx u in
  let _ = ic_emit_label cx u retry_l in
  let _ = ic_node cx u (pn_for_collection cx n) false in
  let hidden = ic_hidden 0 in
  let child = ic_unit_new cx 1 (ic_block_label cx u) (ic_u_path cx u) (ic_u_abs_path cx u) (ic_start_line cx n)
                (Cons (hidden, Nil)) u (ic_loc4 cx n) (ic_nid cx n) in
  let t = pn_for_index cx n in
  let _ = (if ic_ty cx t == px_local_variable_target () then ic_u_set cx child 24 1 else ic_u_set cx child 27 0) in
  let _ = ic_u_set_pflag cx child 8 in
  let _ = ic_add_child cx u child in
  let _ = ic_for_index cx child t hidden in
  let _ = ic_at cx child (ic_start_line cx n) (ic_nid cx n) in
  let _ = ic_event cx child (ic_ev_b_call ()) in
  let nop = ic_insn cx child "nop" Nil in
  let _ = ic_u_set cx child 20 nop in
  let _ = ic_compile_body cx child (pn_for_statements cx n) (ic_nid cx n) (ic_end_line cx n) in
  let _ = ic_finish cx child in
  let _ = ic_here cx u n in
  let _ = ic_i2 cx u "send" (ic_cd "each" 0 0) (OSeq child) in
  let _ = ic_emit_label cx u retry_end in
  let _ = ic_pop_if cx u popped in
  ic_add_catch cx u 4 retry_l retry_end child retry_end;

// -- once ---------------------------------------------------------------------------
// (`/#{x}/o`: a sequence of its own -- the pieces and toregexp -- that `once`
//  runs the first time and whose Regexp it answers from then on, kept in an
//  inline storage entry of this sequence. In its own sequence the pattern's
//  instructions are the scope's, of no node; the leave is the node's.)
let ic_once_regexp = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let child = ic_unit_new cx 6 (ic_block_label cx u) (ic_u_path cx u) (ic_u_abs_path cx u) (ic_start_line cx n) Nil u (ic_loc4 cx n) (ic_nid cx n) in
  let _ = ic_add_child cx u child in
  let _ = ic_u_set cx child 34 (n + 1) in
  let _ = ic_dregexp cx child n false in
  let _ = ic_u_set cx child 34 0 in
  // (the leave is on the last line an interpolation in it started)
  let _ = ic_at cx child (if ic_u_last_line cx child >= 0 then ic_u_last_line cx child else ic_start_line cx n) (ic_nid cx n) in
  let _ = ic_i0 cx child "leave" in
  let _ = ic_finish cx child in
  let _ = ic_here cx u n in
  let _ = ic_i2 cx u "once" (OSeq child) (OIse (ic_next_ise cx u)) in
  ic_pop_if cx u popped;

// PM_POST_EXECUTION_NODE: `END { }` -- once, a block that hands the block of
// the statements to core#set_postexe
let ic_post_execution = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let sl = ic_start_line cx n in
  let outer = ic_unit_new cx 1 (ic_block_label cx u) (ic_u_path cx u) (ic_u_abs_path cx u) sl Nil u (ic_loc4 cx n) (ic_nid cx n) in
  let _ = ic_add_child cx u outer in
  let _ = ic_at cx outer sl (ic_nid cx n) in
  let _ = ic_event cx outer (ic_ev_b_call ()) in
  let nop = ic_insn cx outer "nop" Nil in
  let _ = ic_u_set cx outer 20 nop in
  let b0 = ic_new_label cx outer in
  let b1 = ic_new_label cx outer in
  let _ = ic_u_set cx outer 21 b0 in
  let _ = ic_u_set cx outer 22 b1 in
  let _ = ic_emit_label cx outer b0 in
  let st = pn_post_execution_statements cx n in
  let sloc = (if st >= 0 then st else n) in
  let inner = ic_unit_new cx 1 (ic_block_label cx u) (ic_u_path cx u) (ic_u_abs_path cx u) sl Nil outer (ic_loc4 cx sloc) (ic_nid cx sloc) in
  let _ = ic_add_child cx outer inner in
  let _ = ic_at cx inner sl (ic_nid cx sloc) in
  let _ = ic_event cx inner (ic_ev_b_call ()) in
  let nop2 = ic_insn cx inner "nop" Nil in
  let _ = ic_u_set cx inner 20 nop2 in
  let _ = ic_compile_body cx inner st (ic_nid cx sloc) (ic_end_line cx sloc) in
  let _ = ic_finish cx inner in
  let _ = ic_at cx outer sl (ic_nid cx n) in
  let _ = ic_in cx outer "putspecialobject" 1 in
  let _ = ic_i2 cx outer "send" (ic_ci "core#set_postexe" 0 4 Nil false true) (OSeq inner) in
  let _ = ic_emit_label cx outer b1 in
  let _ = ic_event cx outer (ic_ev_b_return ()) in
  let _ = ic_at cx outer (ic_end_line cx n) (ic_nid cx n) in
  let _ = ic_i0 cx outer "leave" in
  let _ = ic_finish cx outer in
  let _ = ic_here cx u n in
  let _ = ic_i2 cx u "once" (OSeq outer) (OIse (ic_next_ise cx u)) in
  ic_pop_if cx u popped;

let ic_node6 = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) -> fn (ty: int) ->
  if ty == px_for () then ic_for_node cx u n popped
  else if ty == px_post_execution () then ic_post_execution cx u n popped
  else if ty == px_case_match () then ic_case_match_node cx u n popped
  else if ty == px_match_predicate () then ic_match_predicate cx u n popped
  else if ty == px_match_required () then ic_match_required cx u n popped
  // (a `shareable_constant_value` constant: compiled only when it is X = a
  //  literal, which is pushed already made shareable)
  else if ty == px_shareable_constant () then
    (let w = pn_shareable_constant_write cx n in
     let (ok, v) = (if ic_ty cx w == px_constant_write () then ic_shareable_literal cx (pn_constant_write_value cx w) else (false, IvNil)) in
     if (if ok then false else true) then ic_refuse "a shareable_constant_value write of this is not compiled yet"
     else
       (let _ = ic_here cx u (pn_constant_write_value cx w) in
        let _ = ic_i1 cx u "putobject" (OVal v) in
        let _ = ic_here cx u n in
        let _ = ic_dup_unless cx u popped in
        let _ = ic_in cx u "putspecialobject" 3 in
        ic_i1 cx u "setconstant" (ic_osym cx (ic_cname cx (pn_constant_write_name cx w)))))
  else ic_refuse (ic_type_name ty ++ " is not compiled yet");

// pm_compile_shareable_constant_literal: (true, the value) when n is a
// literal ruby makes shareable as it compiles
let rec ic_shareable_literal = fn cx -> fn (n: int) ->
  let ty = ic_ty cx n in
  if ty == px_true () || ty == px_false () || ty == px_nil () || ty == px_symbol () || ty == px_regular_expression ()
     || ty == px_integer () || ty == px_float () || ty == px_rational () || ty == px_imaginary () then (true, ic_static_value cx n)
  else if ty == px_source_line () then (true, IvInt (ic_start_line cx n))
  else if ty == px_string () then (true, ic_string_value cx n)
  else if ty == px_array () then
    (let rec go = fn (xs: int list) ->
       (match xs with
        | Nil -> (true, (Nil : Iv list))
        | Cons (e, t) ->
          (let (ok, v) = ic_shareable_literal cx e in
           if ok then (let (ok2, vs) = go t in (ok2, Cons (v, vs))) else (false, Nil))) in
     let (ok, vs) = go (ic_nlist cx (pn_array_elements cx n) (pn_array_elements_b cx n)) in
     (ok, IvArr vs))
  else if ty == px_hash () then
    (let rec go = fn (xs: int list) -> fn (acc: (Iv * Iv) list) ->
       (match xs with
        | Nil -> (true, acc)
        | Cons (e, t) ->
          if ic_ty cx e != px_assoc () then (false, acc)
          else
            (let (ok1, k) = ic_shareable_literal cx (pn_assoc_key cx e) in
             let (ok2, v) = ic_shareable_literal cx (pn_assoc_value cx e) in
             if ok1 && ok2 then go t (ic_hash_put acc k v) else (false, acc))) in
     let (ok, ps) = go (ic_nlist cx (pn_hash_elements cx n) (pn_hash_elements_b cx n)) Nil in
     (ok, IvHsh ps))
  else (false, IvNil);

// -- pattern matching (prism_compile.c's pm_compile_pattern and the nodes that
// use it: `case / in`, `expr => pattern`, `expr in pattern`) ----------------------
// The stack is the scratch space, as there: under the value being matched sit
// a deconstruct cache and, for a single pattern, the error string, the "is it
// a key error" flag and that error's matchee and key. `base` is how far down
// they are from where the pattern started. (PAT_CACHE 0, PAT_ERROR_STRING 1,
// PAT_KEY_ERROR_P 2, PAT_KEY_ERROR_MATCHEE 3, PAT_KEY_ERROR_KEY 4)
let ic_pat_str = fn (s: str) -> OVal (IvStr (s, "US-ASCII"));
let ic_sprintf = fn cx -> fn (u: int) -> fn (argc: int) -> ic_push_send cx u "core#sprintf" argc;
// (the error string and "not a key error" set, the two values popped)
let ic_pat_set_error = fn cx -> fn (u: int) -> fn (base: int) ->
  let _ = ic_in cx u "setn" (base + 1 + 1) in
  let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
  let _ = ic_in cx u "setn" (base + 2 + 2) in
  let _ = ic_i0 cx u "pop" in
  ic_i0 cx u "pop";
// pm_compile_pattern_generic_error
let ic_pattern_generic_error = fn cx -> fn (u: int) -> fn (n: int) -> fn (message: str) -> fn (base: int) ->
  let ok = ic_new_label cx u in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_il cx u "branchif" ok in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_i1 cx u "putobject" (ic_pat_str message) in
  let _ = ic_in cx u "topn" 3 in
  let _ = ic_sprintf cx u 2 in
  let _ = ic_pat_set_error cx u base in
  ic_emit_label cx u ok;
// pm_compile_pattern_length_error
let ic_pattern_length_error = fn cx -> fn (u: int) -> fn (n: int) -> fn (message: str) -> fn (length: int) -> fn (base: int) ->
  let ok = ic_new_label cx u in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_il cx u "branchif" ok in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_i1 cx u "putobject" (ic_pat_str message) in
  let _ = ic_in cx u "topn" 3 in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_push_send cx u "length" 0 in
  let _ = ic_i1 cx u "putobject" (OVal (IvInt length)) in
  let _ = ic_sprintf cx u 4 in
  let _ = ic_pat_set_error cx u base in
  ic_emit_label cx u ok;
// pm_compile_pattern_eqq_error
let ic_pattern_eqq_error = fn cx -> fn (u: int) -> fn (n: int) -> fn (base: int) ->
  let ok = ic_new_label cx u in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_il cx u "branchif" ok in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_i1 cx u "putobject" (ic_pat_str "%p === %p does not return true") in
  let _ = ic_in cx u "topn" 3 in
  let _ = ic_in cx u "topn" 5 in
  let _ = ic_sprintf cx u 3 in
  let _ = ic_pat_set_error cx u base in
  let _ = ic_emit_label cx u ok in
  let _ = ic_in cx u "setn" 2 in
  let _ = ic_i0 cx u "pop" in
  ic_i0 cx u "pop";
// pm_compile_pattern_deconstruct
let ic_pattern_deconstruct = fn cx -> fn (u: int) -> fn (n: int) -> fn (deconstruct: int) -> fn (match_failed: int) -> fn (deconstructed: int) ->
                             fn (type_error: int) -> fn (single: bool) -> fn (cache: bool) -> fn (base: int) ->
  let _ = ic_here cx u n in
  let _ =
    (if cache then
       (let _ = ic_in cx u "topn" base in
        let _ = ic_il cx u "branchnil" deconstruct in
        let _ = ic_in cx u "topn" base in
        let _ = ic_il cx u "branchunless" match_failed in
        let _ = ic_i0 cx u "pop" in
        let _ = ic_in cx u "topn" (base - 1) in
        ic_il cx u "jump" deconstructed)
     else ic_il cx u "jump" deconstruct) in
  let _ = ic_emit_label cx u deconstruct in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_i1 cx u "putobject" (ic_osym cx "deconstruct") in
  let _ = ic_push_send cx u "respond_to?" 1 in
  let _ = (if cache then ic_in cx u "setn" (base + 1) else ()) in
  let _ = (if single then ic_pattern_generic_error cx u n "%p does not respond to #deconstruct" (base + 1) else ()) in
  let _ = ic_here cx u n in
  let _ = ic_il cx u "branchunless" match_failed in
  let _ = ic_push_send cx u "deconstruct" 0 in
  let _ = (if cache then ic_in cx u "setn" base else ()) in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_i1 cx u "checktype" (OChk 7) in
  let _ = ic_il cx u "branchunless" type_error in
  ic_emit_label cx u deconstructed;
// pm_compile_pattern_constant: the constant an array, find or hash pattern
// is written under
let ic_pattern_constant = fn cx -> fn (u: int) -> fn (n: int) -> fn (match_failed: int) -> fn (single: bool) -> fn (base: int) ->
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_node cx u n false in
  let _ = ic_here cx u n in
  let _ = (if single then ic_in cx u "dupn" 2 else ()) in
  let _ = ic_in cx u "checkmatch" 2 in
  let _ = (if single then ic_pattern_eqq_error cx u n (base + 3) else ()) in
  let _ = ic_here cx u n in
  ic_il cx u "branchunless" match_failed;
// the TypeError a #deconstruct or #deconstruct_keys of the wrong type is
let ic_pattern_type_error = fn cx -> fn (u: int) -> fn (type_error: int) -> fn (message: str) ->
  let _ = ic_emit_label cx u type_error in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_i1 cx u "putobject" (OVal (IvCls "TypeError")) in
  let _ = ic_i1 cx u "putobject" (ic_pat_str message) in
  let _ = ic_push_send cx u "core#raise" 2 in
  ic_i0 cx u "pop";
// "key not found: :name", as rb_sprintf's %+ makes it (a binary String)
let ic_key_not_found = fn (name: str) ->
  let n = str_len name in
  let rec simple = fn (i: int) ->
    if i >= n then true
    else (let c = ord (char_at name i) in
          let ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || (i > 0 && c >= 48 && c <= 57)
                   || (i == n - 1 && i > 0 && (c == 63 || c == 33)) in
          if ok then simple (i + 1) else false) in
  if n > 0 && simple 0 then OVal (IvStr ("key not found: :" ++ name, "ASCII-8BIT"))
  else ic_refuse "a hash pattern key that inspects quoted is not compiled yet";

// pm_compile_pattern_match: falls through when the pattern matches
let rec ic_pattern_match = fn cx -> fn (u: int) -> fn (n: int) -> fn (unmatched: int) -> fn (single: bool) -> fn (cache: bool) -> fn (base: int) ->
  let matched = ic_new_label cx u in
  let _ = ic_pattern cx u n matched unmatched single cache base in
  ic_emit_label cx u matched;

// pm_compile_pattern
let ic_pattern = fn cx -> fn (u: int) -> fn (n: int) -> fn (matched: int) -> fn (unmatched: int) -> fn (single: bool) -> fn (cache: bool) -> fn (base0: int) ->
  let at = fn (x: unit) -> ic_here cx u n in
  let ty = ic_ty cx n in
  if ty == px_array_pattern () then
    (let req = ic_nlist cx (pn_array_pattern_requireds cx n) (pn_array_pattern_requireds_b cx n) in
     let posts = ic_nlist cx (pn_array_pattern_posts cx n) (pn_array_pattern_posts_b cx n) in
     let nreq = ic_llen req in
     let min = nreq + ic_llen posts in
     let rest = pn_array_pattern_rest cx n in
     let rest_named = rest >= 0 && ic_ty cx rest == px_splat () && pn_splat_expression cx rest >= 0 in
     let use_rest_size = rest >= 0 && (rest_named || ic_llen posts > 0) in
     let match_failed = ic_new_label cx u in
     let type_error = ic_new_label cx u in
     let deconstruct = ic_new_label cx u in
     let deconstructed = ic_new_label cx u in
     let _ = at () in
     let base = (if use_rest_size then (let _ = ic_i1 cx u "putobject" (OVal (IvInt 0)) in let _ = ic_i0 cx u "swap" in base0 + 1) else base0) in
     let _ = (if pn_array_pattern_constant cx n >= 0 then ic_pattern_constant cx u (pn_array_pattern_constant cx n) match_failed single base else ()) in
     let _ = ic_pattern_deconstruct cx u n deconstruct match_failed deconstructed type_error single cache base in
     let _ = at () in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_push_send cx u "length" 0 in
     let _ = ic_i1 cx u "putobject" (OVal (IvInt min)) in
     let _ = ic_push_send cx u (if rest < 0 then "==" else ">=") 1 in
     let _ = (if single then ic_pattern_length_error cx u n (if rest < 0 then "%p length mismatch (given %p, expected %p)" else "%p length mismatch (given %p, expected %p+)") min (base + 1) else ()) in
     let _ = at () in
     let _ = ic_il cx u "branchunless" match_failed in
     let rec reqs = fn (xs: int list) -> fn (i: int) ->
       (match xs with
        | Nil -> ()
        | Cons (r, t) ->
          (let _ = at () in
           let _ = ic_i0 cx u "dup" in
           let _ = ic_i1 cx u "putobject" (OVal (IvInt i)) in
           let _ = ic_push_send cx u "[]" 1 in
           let _ = ic_pattern_match cx u r match_failed single false (base + 1) in
           reqs t (i + 1))) in
     let _ = reqs req 0 in
     let _ =
       (if rest >= 0 then
          (if rest_named then
             (let _ = at () in
              let _ = ic_i0 cx u "dup" in
              let _ = ic_i1 cx u "putobject" (OVal (IvInt nreq)) in
              let _ = ic_in cx u "topn" 1 in
              let _ = ic_push_send cx u "length" 0 in
              let _ = ic_i1 cx u "putobject" (OVal (IvInt min)) in
              let _ = ic_push_send cx u "-" 1 in
              let _ = ic_in cx u "setn" 4 in
              let _ = ic_push_send cx u "[]" 2 in
              ic_pattern_match cx u (pn_splat_expression cx rest) match_failed single false (base + 1))
           else if ic_llen posts > 0 then
             (let _ = at () in
              let _ = ic_i0 cx u "dup" in
              let _ = ic_push_send cx u "length" 0 in
              let _ = ic_i1 cx u "putobject" (OVal (IvInt min)) in
              let _ = ic_push_send cx u "-" 1 in
              let _ = ic_in cx u "setn" 2 in
              ic_i0 cx u "pop")
           else ())
        else ()) in
     let rec ps = fn (xs: int list) -> fn (i: int) ->
       (match xs with
        | Nil -> ()
        | Cons (q, t) ->
          (let _ = at () in
           let _ = ic_i0 cx u "dup" in
           let _ = ic_i1 cx u "putobject" (OVal (IvInt (nreq + i))) in
           let _ = ic_in cx u "topn" 3 in
           let _ = ic_push_send cx u "+" 1 in
           let _ = ic_push_send cx u "[]" 1 in
           let _ = ic_pattern_match cx u q match_failed single false (base + 1) in
           ps t (i + 1))) in
     let _ = ps posts 0 in
     let _ = at () in
     let _ = ic_i0 cx u "pop" in
     let _ = (if use_rest_size then ic_i0 cx u "pop" else ()) in
     let _ = ic_il cx u "jump" matched in
     let _ = ic_i0 cx u "putnil" in
     let _ = (if use_rest_size then ic_i0 cx u "putnil" else ()) in
     let _ = ic_pattern_type_error cx u type_error "deconstruct must return Array" in
     let _ = ic_emit_label cx u match_failed in
     let _ = ic_i0 cx u "pop" in
     let _ = (if use_rest_size then ic_i0 cx u "pop" else ()) in
     ic_il cx u "jump" unmatched)
  else if ty == px_find_pattern () then
    (let base = base0 in
     let reqs = ic_nlist cx (pn_find_pattern_requireds cx n) (pn_find_pattern_requireds_b cx n) in
     let size = ic_llen reqs in
     let match_failed = ic_new_label cx u in
     let type_error = ic_new_label cx u in
     let deconstruct = ic_new_label cx u in
     let deconstructed = ic_new_label cx u in
     let _ = (if pn_find_pattern_constant cx n >= 0 then ic_pattern_constant cx u (pn_find_pattern_constant cx n) match_failed single base else ()) in
     let _ = ic_pattern_deconstruct cx u n deconstruct match_failed deconstructed type_error single cache base in
     let _ = at () in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_push_send cx u "length" 0 in
     let _ = ic_i1 cx u "putobject" (OVal (IvInt size)) in
     let _ = ic_push_send cx u ">=" 1 in
     let _ = (if single then ic_pattern_length_error cx u n "%p length mismatch (given %p, expected %p+)" size (base + 1) else ()) in
     let _ = at () in
     let _ = ic_il cx u "branchunless" match_failed in
     let while_begin = ic_new_label cx u in
     let next_loop = ic_new_label cx u in
     let find_succeeded = ic_new_label cx u in
     let find_failed = ic_new_label cx u in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_push_send cx u "length" 0 in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_i1 cx u "putobject" (OVal (IvInt size)) in
     let _ = ic_push_send cx u "-" 1 in
     let _ = ic_i1 cx u "putobject" (OVal (IvInt 0)) in
     let _ = ic_emit_label cx u while_begin in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_in cx u "topn" 2 in
     let _ = ic_push_send cx u "<=" 1 in
     let _ = ic_il cx u "branchunless" find_failed in
     let rec each = fn (xs: int list) -> fn (i: int) ->
       (match xs with
        | Nil -> ()
        | Cons (r, t) ->
          (let _ = at () in
           let _ = ic_in cx u "topn" 3 in
           let _ = ic_in cx u "topn" 1 in
           let _ = (if i != 0 then (let _ = ic_i1 cx u "putobject" (OVal (IvInt i)) in ic_push_send cx u "+" 1) else ()) in
           let _ = ic_push_send cx u "[]" 1 in
           let _ = ic_pattern_match cx u r next_loop single false (base + 4) in
           each t (i + 1))) in
     let _ = each reqs 0 in
     let le = pn_splat_expression cx (pn_find_pattern_left cx n) in
     let _ = (if le >= 0 then
                (let _ = at () in
                 let _ = ic_in cx u "topn" 3 in
                 let _ = ic_i1 cx u "putobject" (OVal (IvInt 0)) in
                 let _ = ic_in cx u "topn" 2 in
                 let _ = ic_push_send cx u "[]" 2 in
                 ic_pattern_match cx u le find_failed single false (base + 4))
              else ()) in
     let rn = pn_find_pattern_right cx n in
     let re = (if ic_ty cx rn == px_splat () then pn_splat_expression cx rn else 0 - 1) in
     let _ = (if re >= 0 then
                (let _ = at () in
                 let _ = ic_in cx u "topn" 3 in
                 let _ = ic_in cx u "topn" 1 in
                 let _ = ic_i1 cx u "putobject" (OVal (IvInt size)) in
                 let _ = ic_push_send cx u "+" 1 in
                 let _ = ic_in cx u "topn" 3 in
                 let _ = ic_push_send cx u "[]" 2 in
                 ic_pattern_match cx u re find_failed single false (base + 4))
              else ()) in
     let _ = at () in
     let _ = ic_il cx u "jump" find_succeeded in
     let _ = ic_emit_label cx u next_loop in
     let _ = ic_i1 cx u "putobject" (OVal (IvInt 1)) in
     let _ = ic_push_send cx u "+" 1 in
     let _ = ic_il cx u "jump" while_begin in
     let _ = ic_emit_label cx u find_failed in
     let _ = ic_in cx u "adjuststack" 3 in
     let _ = (if single then
                (let _ = ic_in cx u "putspecialobject" 1 in
                 let _ = ic_i1 cx u "putobject" (ic_pat_str "%p does not match to find pattern") in
                 let _ = ic_in cx u "topn" 2 in
                 let _ = ic_sprintf cx u 2 in
                 ic_pat_set_error cx u base)
              else ()) in
     let _ = ic_il cx u "jump" match_failed in
     let _ = ic_in cx u "dupn" 3 in
     let _ = ic_emit_label cx u find_succeeded in
     let _ = ic_in cx u "adjuststack" 3 in
     let _ = ic_i0 cx u "pop" in
     let _ = ic_il cx u "jump" matched in
     let _ = ic_i0 cx u "putnil" in
     let _ = ic_pattern_type_error cx u type_error "deconstruct must return Array" in
     let _ = ic_emit_label cx u match_failed in
     let _ = ic_i0 cx u "pop" in
     ic_il cx u "jump" unmatched)
  else if ty == px_hash_pattern () then
    (let base = base0 in
     let rest = pn_hash_pattern_rest cx n in
     let els = ic_nlist cx (pn_hash_pattern_elements cx n) (pn_hash_pattern_elements_b cx n) in
     let has_rest = rest >= 0 && (if ic_ty cx rest == px_assoc_splat () && pn_assoc_splat_value cx rest < 0 then false else true) in
     let has_keys = ic_llen els > 0 || rest >= 0 in
     let match_failed = ic_new_label cx u in
     let type_error = ic_new_label cx u in
     let key_of = fn (e: int) -> ic_symbol_value cx (pn_assoc_key cx e) in
     let kname = fn (e: int) -> (match key_of e with | IvSym (s, _) -> s | _ -> "") in
     let _ = (if pn_hash_pattern_constant cx n >= 0 then ic_pattern_constant cx u (pn_hash_pattern_constant cx n) match_failed single base else ()) in
     let _ = at () in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_i1 cx u "putobject" (ic_osym cx "deconstruct_keys") in
     let _ = ic_push_send cx u "respond_to?" 1 in
     let _ = (if single then ic_pattern_generic_error cx u n "%p does not respond to #deconstruct_keys" (base + 1) else ()) in
     let _ = at () in
     let _ = ic_il cx u "branchunless" match_failed in
     let _ = (if has_keys && (if has_rest then false else true) then ic_i1 cx u "duparray" (OVal (IvArr (ic_map key_of els))) else ic_i0 cx u "putnil") in
     let _ = ic_push_send cx u "deconstruct_keys" 1 in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_i1 cx u "checktype" (OChk 8) in
     let _ = ic_il cx u "branchunless" type_error in
     let _ = (if has_rest then ic_push_send cx u "dup" 0 else ()) in
     let _ =
       (if has_keys then
          (let values = ic_list_new cx in
           let _ = list_iter els (fn (e: int) ->
                     (let sym = OVal (key_of e) in
                      let _ = at () in
                      let _ = ic_i0 cx u "dup" in
                      let _ = ic_i1 cx u "putobject" sym in
                      let _ = ic_push_send cx u "key?" 1 in
                      let _ = (if single then
                                 (let ok = ic_new_label cx u in
                                  let _ = ic_i0 cx u "dup" in
                                  let _ = ic_il cx u "branchif" ok in
                                  let _ = ic_i1 cx u "putobject" (ic_key_not_found (kname e)) in
                                  let _ = ic_in cx u "setn" (base + 1 + 2) in
                                  let _ = ic_i1 cx u "putobject" (OVal IvTrue) in
                                  let _ = ic_in cx u "setn" (base + 2 + 3) in
                                  let _ = ic_in cx u "topn" 3 in
                                  let _ = ic_in cx u "setn" (base + 3 + 4) in
                                  let _ = ic_i1 cx u "putobject" sym in
                                  let _ = ic_in cx u "setn" (base + 4 + 5) in
                                  let _ = ic_in cx u "adjuststack" 4 in
                                  ic_emit_label cx u ok)
                               else ()) in
                      let _ = ic_il cx u "branchunless" match_failed in
                      let saved = ic_capture_begin cx u in
                      let _ = at () in
                      let _ = ic_i0 cx u "dup" in
                      let _ = ic_i1 cx u "putobject" sym in
                      let _ = ic_push_send cx u (if has_rest then "delete" else "[]") 1 in
                      let v0 = pn_assoc_value cx e in
                      let v = (if ic_ty cx v0 == px_implicit () then pn_implicit_value cx v0 else v0) in
                      let _ = ic_pattern_match cx u v match_failed single false (base + 1) in
                      ic_list_append cx values (ic_capture_end cx u saved))) in
           ic_append cx u values)
        else
          (let _ = ic_i0 cx u "dup" in
           let _ = ic_push_send cx u "empty?" 0 in
           let _ = (if single then ic_pattern_generic_error cx u n "%p is not empty" (base + 1) else ()) in
           let _ = at () in
           ic_il cx u "branchunless" match_failed)) in
     let _ =
       (if has_rest then
          (let _ = at () in
           if ic_ty cx rest == px_no_keywords_parameter () then
             (let _ = ic_i0 cx u "dup" in
              let _ = ic_push_send cx u "empty?" 0 in
              let _ = (if single then ic_pattern_generic_error cx u n "rest of %p is not empty" (base + 1) else ()) in
              let _ = at () in
              ic_il cx u "branchunless" match_failed)
           else
             (let _ = ic_i0 cx u "dup" in
              ic_pattern_match cx u (pn_assoc_splat_value cx rest) match_failed single false (base + 1)))
        else ()) in
     let _ = at () in
     let _ = ic_i0 cx u "pop" in
     let _ = ic_il cx u "jump" matched in
     let _ = ic_i0 cx u "putnil" in
     let _ = ic_pattern_type_error cx u type_error "deconstruct_keys must return Hash" in
     let _ = ic_emit_label cx u match_failed in
     let _ = ic_i0 cx u "pop" in
     ic_il cx u "jump" unmatched)
  else if ty == px_capture_pattern () then
    (let match_failed = ic_new_label cx u in
     let _ = at () in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_pattern_match cx u (pn_capture_pattern_value cx n) match_failed single cache (base0 + 1) in
     let _ = ic_pattern cx u (pn_capture_pattern_target cx n) matched match_failed single false base0 in
     let _ = at () in
     let _ = ic_i0 cx u "putnil" in
     let _ = ic_emit_label cx u match_failed in
     let _ = ic_i0 cx u "pop" in
     ic_il cx u "jump" unmatched)
  else if ty == px_local_variable_target () then
    (let _ = at () in
     let _ = ic_setlocal cx u (ic_cname cx (pn_local_variable_target_name cx n)) in
     ic_il cx u "jump" matched)
  else if ty == px_alternation_pattern () then
    (let matched_left = ic_new_label cx u in
     let unmatched_left = ic_new_label cx u in
     let _ = at () in
     let _ = ic_i0 cx u "dup" in
     let _ = ic_pattern cx u (pn_alternation_pattern_left cx n) matched_left unmatched_left single cache (base0 + 1) in
     let _ = at () in
     let _ = ic_emit_label cx u matched_left in
     let _ = ic_i0 cx u "pop" in
     let _ = ic_il cx u "jump" matched in
     let _ = ic_i0 cx u "putnil" in
     let _ = ic_emit_label cx u unmatched_left in
     ic_pattern cx u (pn_alternation_pattern_right cx n) matched unmatched single cache base0)
  else if ty == px_parentheses () then ic_pattern cx u (pn_parentheses_body cx n) matched unmatched single cache base0
  else if ty == px_pinned_variable () then ic_pattern cx u (pn_pinned_variable_variable cx n) matched unmatched single true base0
  else if ty == px_if () || ty == px_unless () then
    (let if_ = ty == px_if () in
     let st = (if if_ then pn_if_statements cx n else pn_unless_statements cx n) in
     let _ = ic_pattern_match cx u (ic_li cx (pn_statements_body cx st) 0) unmatched single cache base0 in
     let _ = ic_node cx u (if if_ then pn_if_predicate cx n else pn_unless_predicate cx n) false in
     let _ = at () in
     let _ = (if single then
                (let ok = ic_new_label cx u in
                 let _ = ic_i0 cx u "dup" in
                 let _ = ic_il cx u (if if_ then "branchif" else "branchunless") ok in
                 let _ = ic_i1 cx u "putobject" (ic_pat_str "guard clause does not return true") in
                 let _ = ic_pat_set_error cx u base0 in
                 ic_emit_label cx u ok)
              else ()) in
     let _ = ic_il cx u (if if_ then "branchunless" else "branchif") unmatched in
     ic_il cx u "jump" matched)
  else
    // (a value: `===` of it. A pinned expression is its expression.)
    (let v = (if ty == px_pinned_expression () then pn_pinned_expression_expression cx n else n) in
     let _ = at () in
     let _ = ic_node cx u v false in
     let _ = at () in
     let _ = (if single then ic_in cx u "dupn" 2 else ()) in
     let _ = ic_in cx u "checkmatch" 2 in
     let _ = (if single then ic_pattern_eqq_error cx u v (base0 + 2) else ()) in
     let _ = at () in
     let _ = ic_il cx u "branchif" matched in
     ic_il cx u "jump" unmatched);

// pm_compile_pattern_error_handler: what a single pattern that did not match
// raises
let ic_pattern_error_handler = fn cx -> fn (u: int) -> fn (n: int) -> fn (done: int) -> fn (popped: bool) ->
  let key_error = ic_new_label cx u in
  let cleanup = ic_new_label cx u in
  let _ = ic_here cx u n in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_in cx u "topn" (2 + 2) in
  let _ = ic_il cx u "branchif" key_error in
  let _ = ic_i1 cx u "putobject" (OVal (IvCls "NoMatchingPatternError")) in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_i1 cx u "putobject" (ic_pat_str "%p: %s") in
  let _ = ic_in cx u "topn" 4 in
  let _ = ic_in cx u "topn" (1 + 6) in
  let _ = ic_sprintf cx u 3 in
  let _ = ic_push_send cx u "core#raise" 2 in
  let _ = ic_il cx u "jump" cleanup in
  let _ = ic_emit_label cx u key_error in
  let _ = ic_i1 cx u "putobject" (OVal (IvCls "NoMatchingPatternKeyError")) in
  let _ = ic_in cx u "putspecialobject" 1 in
  let _ = ic_i1 cx u "putobject" (ic_pat_str "%p: %s") in
  let _ = ic_in cx u "topn" 4 in
  let _ = ic_in cx u "topn" (1 + 6) in
  let _ = ic_sprintf cx u 3 in
  let _ = ic_in cx u "topn" (3 + 4) in
  let _ = ic_in cx u "topn" (4 + 5) in
  let _ = ic_push_send_k cx u "new" 1 32 (Cons ("matchee", Cons ("key", Nil))) true in
  let _ = ic_push_send cx u "core#raise" 1 in
  let _ = ic_emit_label cx u cleanup in
  let _ = ic_in cx u "adjuststack" 7 in
  let _ = (if popped then () else ic_i0 cx u "putnil") in
  let _ = ic_il cx u "jump" done in
  let _ = ic_in cx u "dupn" 5 in
  if popped then ic_i0 cx u "putnil" else ();

// pm_compile_case_match_node
let ic_case_match_node = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let end_l = ic_new_label cx u in
  let else_l = ic_new_label cx u in
  let conds_n = ic_nlist cx (pn_case_match_conditions cx n) (pn_case_match_conditions_b cx n) in
  let e = pn_case_match_else_clause cx n in
  let single = e < 0 && ic_llen conds_n == 1 in
  let _ = ic_here cx u n in
  let _ = (if single then
             (let _ = ic_i0 cx u "putnil" in
              let _ = ic_i0 cx u "putnil" in
              let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
              ic_i0 cx u "putnil")
           else ()) in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_node cx u (pn_case_match_predicate cx n) false in
  let bodies = ic_list_new cx in
  let saved = ic_capture_begin cx u in
  let rec each = fn (cs: int list) -> fn (i: int) ->
    (match cs with
     | Nil -> ()
     | Cons (c, t) ->
       (let body_l = ic_new_label cx u in
        let saved2 = ic_capture_begin cx u in
        let _ = ic_here cx u c in
        let _ = (if i > 0 then ic_i0 cx u "putnil" else ()) in
        let _ = ic_emit_label cx u body_l in
        let _ = ic_in cx u "adjuststack" (if single then 6 else 2) in
        let st = pn_in_statements cx c in
        let _ = (if st >= 0 then ic_node cx u st popped else if popped then () else ic_synthetic_putnil cx u) in
        let _ = ic_here cx u c in
        let _ = ic_il cx u "jump" end_l in
        let _ = ic_list_append cx bodies (ic_capture_end cx u saved2) in
        let next_l = ic_new_label cx u in
        let pat = pn_in_pattern cx c in
        let _ = ic_here cx u pat in
        let _ = ic_i0 cx u "dup" in
        let _ = ic_pattern cx u pat body_l next_l single true 2 in
        let _ = ic_emit_label cx u next_l in
        let _ = ic_set_unremovable cx next_l in
        each t (i + 1))) in
  let _ = each conds_n 0 in
  let _ =
    (if e >= 0 then
       (let _ = ic_emit_label cx u else_l in
        let _ = ic_here cx u n in
        let _ = ic_i0 cx u "pop" in
        let _ = ic_i0 cx u "pop" in
        let _ = ic_node cx u e popped in
        let _ = ic_here cx u n in
        let _ = ic_il cx u "jump" end_l in
        let _ = ic_i0 cx u "putnil" in
        if popped then ic_i0 cx u "putnil" else ())
     else
       (let _ = ic_emit_label cx u else_l in
        if single then ic_pattern_error_handler cx u n end_l popped
        else
          (let _ = ic_here cx u n in
           let _ = ic_in cx u "putspecialobject" 1 in
           let _ = ic_i1 cx u "putobject" (OVal (IvCls "NoMatchingPatternError")) in
           let _ = ic_in cx u "topn" 2 in
           let _ = ic_push_send cx u "core#raise" 2 in
           let _ = ic_in cx u "adjuststack" 3 in
           let _ = (if popped then () else ic_i0 cx u "putnil") in
           let _ = ic_il cx u "jump" end_l in
           let _ = ic_in cx u "dupn" 1 in
           (if popped then ic_i0 cx u "putnil" else ())))) in
  let _ = ic_append cx u (ic_capture_end cx u saved) in
  let _ = ic_append cx u bodies in
  ic_emit_label cx u end_l;

// PM_MATCH_PREDICATE_NODE: `expr in pattern`
let ic_match_predicate = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_node cx u (pn_match_predicate_value cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "dup" in
  let matched = ic_new_label cx u in
  let unmatched = ic_new_label cx u in
  let done = ic_new_label cx u in
  let _ = ic_pattern cx u (pn_match_predicate_pattern cx n) matched unmatched false true 2 in
  let _ = ic_here cx u n in
  let _ = ic_emit_label cx u unmatched in
  let _ = ic_i0 cx u "pop" in
  let _ = ic_i0 cx u "pop" in
  let _ = (if popped then () else ic_i1 cx u "putobject" (OVal IvFalse)) in
  let _ = ic_il cx u "jump" done in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_emit_label cx u matched in
  let _ = ic_in cx u "adjuststack" 2 in
  let _ = (if popped then () else ic_i1 cx u "putobject" (OVal IvTrue)) in
  let _ = ic_il cx u "jump" done in
  ic_emit_label cx u done;

// pm_compile_match_required_node: `expr => pattern`
let ic_match_required = fn cx -> fn (u: int) -> fn (n: int) -> fn (popped: bool) ->
  let matched = ic_new_label cx u in
  let unmatched = ic_new_label cx u in
  let done = ic_new_label cx u in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_i1 cx u "putobject" (OVal IvFalse) in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_i0 cx u "putnil" in
  let _ = ic_node cx u (pn_match_required_value cx n) false in
  let _ = ic_here cx u n in
  let _ = ic_i0 cx u "dup" in
  let _ = ic_pattern cx u (pn_match_required_pattern cx n) matched unmatched true true 2 in
  let _ = ic_emit_label cx u unmatched in
  let _ = ic_pattern_error_handler cx u n done popped in
  let _ = ic_emit_label cx u matched in
  let _ = ic_here cx u n in
  let _ = ic_in cx u "adjuststack" 6 in
  let _ = (if popped then () else ic_i0 cx u "putnil") in
  let _ = ic_il cx u "jump" done in
  ic_emit_label cx u done;
