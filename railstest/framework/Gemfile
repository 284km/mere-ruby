# Gems for running Rails 8.1.4.1's own component tests (railstest/framework).
# The published component gems supply lib/; the tests come from the tagged
# source checkout. Test-only gems use the versions in Rails' own Gemfile.lock.
source "https://rubygems.org"
gem "rails", "8.1.4.1"
gem "sqlite3", "2.10.2"
gem "minitest", "6.1.0"
gem "minitest-mock", "5.27.0"
gem "rexml", "3.4.4"
gem "rack-cache", "1.17.0"
gem "bcrypt", "3.1.22"
gem "msgpack", "1.8.0"

# Action Pack's integration and system-testing helpers, at Rails' locked
# versions. MemCacheStore's tests also require a running memcached server.
gem "capybara", "3.40.0"
gem "dalli", "4.3.3"
gem "launchy", "3.1.1"
gem "selenium-webdriver", "4.44.0"
