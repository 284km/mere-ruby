    ++ "  end\n"
    ++ "\n"
    ++ "  def self.valid_ordinal_jd(y, d, sg)\n"
    ++ "    __valid_by_style(y, sg) \{ |yy, s| c_valid_ordinal_p(yy, d, s) \}\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.valid_civil_jd(y, m, d, sg)\n"
