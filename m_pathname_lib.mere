    ++ "    [nth, t - 4712]\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # Each returns the jd (Integer) the fields name, or nil when they name none.\n"
    ++ "  # `yield` is the c_valid_* call over (year, sg).\n"
