    ++ "    elsif hash[:sec] > 59\n"
    ++ "      hash[:sec] = 59\n"
    ++ "    end\n"
    ++ "    hash\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # rt__valid_date_frags_p: the jd the completed fields name, or nil.\n"
    ++ "  def self.valid_date_frags_p(hash, sg)\n"
    ++ "    jd = hash[:jd]\n"
