    ++ "        end\n"
    ++ "      EOS\n"
    ++ "    end\n"
    ++ "    private(*names)\n"
    ++ "    extend self\n"
    ++ "    class << self\n"
    ++ "      public(*::FileUtils::METHODS)\n"
    ++ "    end\n"
