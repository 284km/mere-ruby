    ++ "    \"qyzt\" => 21600, \"ret\" => 14400, \"rott\" => -10800, \"sakt\" => 39600,\n"
    ++ "    \"samt\" => 14400, \"sbt\" => 39600, \"sct\" => 14400, \"sret\" => 39600,\n"
    ++ "    \"srt\" => -10800, \"syot\" => 10800, \"taht\" => -36000, \"tft\" => 18000,\n"
