    ++ "    @st.string.force_encoding(enc) if @st.string && !@st.string.frozen?\n"
    ++ "    self\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.open(string = nil, mode = nil, **opts)\n"
    ++ "    io = new(string, mode, **opts)\n"
    ++ "    return io unless block_given?\n"
    ++ "    begin\n"
