    ++ "\n"
    ++ "  def __marshal_set(jd, df, sf, of, sg)\n"
    ++ "    __set_jd(jd, sg)\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self._load(s) = allocate.marshal_load(Marshal.load(s))\n"
    ++ "\n"
    ++ "  # initialize_copy takes any Date, a DateTime included (d_lite_initialize_copy)\n"
    ++ "  def initialize_copy(other)\n"
