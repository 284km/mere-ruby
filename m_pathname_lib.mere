    ++ "\n"
    ++ "  def inspect_sockaddr\n"
    ++ "    sa = @sockaddr\n"
    ++ "    len = sa.bytesize\n"
    ++ "    return \"empty-sockaddr\" if len == 0\n"
    ++ "    return \"too-short-sockaddr\" if len < 2\n"
    ++ "    case sa.getbyte(1)\n"
    ++ "    when Socket::AF_UNSPEC\n"
    ++ "      \"UNSPEC\"\n"
    ++ "    when Socket::AF_INET\n"
