    ++ "    j\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # ⚠ gets takes a LIMIT as well as a separator -- gets(3), gets(sep, 3) --\n"
    ++ "  # and a chomp: keyword. The limit counts bytes, rounded up to the end of\n"
    ++ "  # the character it lands in.\n"
