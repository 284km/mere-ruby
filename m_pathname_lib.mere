    ++ "      out << (len >= 5 ? sa.getbyte(4).to_s : \"?\")\n"
    ++ "      out << (len >= 6 ? \".#\{sa.getbyte(5)\}\" : \".?\")\n"
    ++ "      out << (len >= 7 ? \".#\{sa.getbyte(6)\}\" : \".?\")\n"
