    ++ "      return jd if jd\n"
    ++ "      d += 1\n"
    ++ "    end\n"
    ++ "    nil\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.__ldoy(y, sg)\n"
    ++ "    i = 0\n"
    ++ "    while i < 30\n"
    ++ "      jd = __valid_civil_jd(y, 12, 31 - i, sg)\n"
    ++ "      return jd if jd\n"
    ++ "      i += 1\n"
    ++ "    end\n"
    ++ "    nil\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.__jd_to_ordinal(jd, sg)\n"
    ++ "    y = jd_to_civil(jd, sg)[0]\n"
