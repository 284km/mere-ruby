    ++ "    jd = (1461 * (y + 4716)).div(4) + (306001 * (m + 1)).div(10000) + d + b - 1524\n"
    ++ "    if jd < sg\n"
    ++ "      [jd - b, 0]\n"
    ++ "    else\n"
    ++ "      [jd, 1]\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.c_jd_to_civil(jd, sg)\n"
    ++ "    if jd < sg\n"
