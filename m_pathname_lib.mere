    ++ "    @__io_fd = fd\n"
    ++ "    IO.__fdnonblock(fd)\n"
    ++ "  end\n"
    ++ "  def do_not_reverse_lookup\n"
    ++ "    @do_not_reverse_lookup\n"
    ++ "  end\n"
    ++ "  def do_not_reverse_lookup=(v)\n"
    ++ "    @do_not_reverse_lookup = v ? true : false\n"
    ++ "  end\n"
    ++ "  # rb_io_s_new: an IO class's ::new takes no block, and says so\n"
    ++ "  def __new_block_warn\n"
