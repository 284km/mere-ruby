    ++ "    end\n"
    ++ "    nil\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # the first and last days of a year, which the reform can move\n"
    ++ "  def self.__fdoy(y, sg)\n"
    ++ "    g = gregorian_to_jd(y, 1, 1)\n"
    ++ "    return g if g >= sg\n"
    ++ "    j = julian_to_jd(y, 1, 1)\n"
    ++ "    return j if j < sg\n"
    ++ "    d = 2\n"
    ++ "    while d <= 30\n"
