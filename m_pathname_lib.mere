    ++ "    return nil if y != ry2 || w != rw || d != rd\n"
    ++ "    [rw, rd, rjd, ns]\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.c_valid_time_p(h, min, s)\n"
    ++ "    h += 24 if h < 0\n"
