    ++ "    tmpfile.autoclose = false\n"
    ++ "    tmpfile = File.new(tmpfile.fileno, mode: File::RDWR, path: path)\n"
    ++ "    PathAttr.set_path(tmpfile, path) if defined?(PathAttr)\n"
    ++ "  end\n"
    ++ "  if block\n"
    ++ "    begin\n"
    ++ "      yield tmpfile\n"
    ++ "    ensure\n"
    ++ "      tmpfile.close\n"
    ++ "    end\n"
    ++ "  else\n"
    ++ "    tmpfile\n"
    ++ "  end\n"
    ++ "end\n"
    ++ "end\n"
    ++ "# ---- mere-ruby ---------------------------------------------------------------\n"
    ++ "#\n"
    ++ "# An anonymous file (Tempfile.create(anonymous: true)) is ruby's\n"
    ++ "# create-and-unlink: a descriptor that outlives its name. mere-ruby's File is\n"
    ++ "# a path and a buffer, and a file unlinked under it cannot be read back, so\n"
    ++ "# the file keeps its generated name until it is closed and is unlinked then\n"
    ++ "# (or at exit). It answers its path as ruby's does -- the directory's,\n"
    ++ "# File.join(tmpdir, \"\") -- and the rest of it is a File.\n"
    ++ "module MereAnonymousTempfile # :nodoc:\n"
    ++ "  def __mere_anonymous(hidden, shown)\n"
    ++ "    @__mere_hidden = hidden\n"
    ++ "    @__mere_shown = shown\n"
    ++ "    self\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def path = @__mere_shown\n"
    ++ "  def to_path = @__mere_shown\n"
    ++ "\n"
    ++ "  def close\n"
    ++ "    super\n"
    ++ "  ensure\n"
    ++ "    (File.unlink(@__mere_hidden) if File.exist?(@__mere_hidden)) rescue nil\n"
    ++ "  end\n"
    ++ "end\n"
    ++ "\n"
    ++ "private def create_anonymous(basename=\"\", tmpdir=nil, mode: 0, **options, &block)\n"
    ++ "  tmpdir = Dir.tmpdir() if tmpdir.nil?\n"
    ++ "  tmpfile = create_with_filename(basename, tmpdir, mode: mode, **options)\n"
    ++ "  hidden = tmpfile.path\n"
    ++ "  tmpfile.extend(MereAnonymousTempfile).__mere_anonymous(hidden, File.join(tmpdir, ''))\n"
    ++ "  at_exit \{ (File.unlink(hidden) if File.exist?(hidden)) rescue nil \}\n"
    ++ "  if block\n"
    ++ "    begin\n"
    ++ "      yield tmpfile\n"
    ++ "    ensure\n"
    ++ "      tmpfile.close\n"
    ++ "    end\n"
    ++ "  else\n"
    ++ "    tmpfile\n"
    ++ "  end\n"
    ++ "end\n"
  else if str_eq n "socket" || str_eq n "socket.so" then
    "# frozen_string_literal: false\n"
    ++ "#\n"
    ++ "# socket, as mere-ruby answers `require \"socket\"`: BasicSocket, IPSocket,\n"
    ++ "# TCPSocket/Server, UDPSocket, UNIXSocket/Server, Socket, Addrinfo and\n"
    ++ "# Socket::Option / AncillaryData, written in Ruby over the interpreter's\n"
