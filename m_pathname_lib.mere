    ++ "    y2, m2, d2 = jd_to_civil(jd, sg)\n"
    ++ "    return nil unless y2 == y && m2 == m && d2 == d\n"
    ++ "    jd\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  def self.__find_ldom(y, m, sg)\n"
    ++ "    d = 31\n"
    ++ "    while d > 0\n"
