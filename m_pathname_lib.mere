    ++ "      return jd unless jd.nil?\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    mday = hash[:mday]\n"
    ++ "    mon = hash[:mon]\n"
    ++ "    if !mday.nil? && !mon.nil? && !year.nil?\n"
    ++ "      jd = valid_civil_jd(year, mon, mday, sg)\n"
    ++ "      return jd unless jd.nil?\n"
    ++ "    end\n"
    ++ "\n"
