    ++ "    dom = b - d - (306001 * e).div(10000)\n"
    ++ "    if e <= 13\n"
    ++ "      [c - 4716, e - 1, dom]\n"
    ++ "    else\n"
    ++ "      [c - 4715, e - 13, dom]\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # -> [rm, rd, rjd, ns] or nil\n"
    ++ "  def self.c_valid_civil_p(y, m, d, sg)\n"
    ++ "    m += 13 if m < 0\n"
