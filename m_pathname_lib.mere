    ++ "class StringIO\n"
    ++ "  VERSION = \"3.2.0\"\n"
    ++ "  MAX_LENGTH = 9223372036854775807\n"
    ++ "\n"
    ++ "  # ⚠ THE POSITION IS A BYTE OFFSET, as in ruby. It used to be a character\n"
    ++ "  #   index, so every multibyte string disagreed: #pos after reading \"é\",\n"
