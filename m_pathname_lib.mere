    ++ "    attr_accessor :string, :pos, :lineno, :null\n"
    ++ "  end\n"
    ++ "  private_constant :State\n"
    ++ "  def __st = @st\n"
    ++ "  def initialize_copy(other)\n"
    ++ "    super\n"
    ++ "    @st = other.__st\n"
    ++ "    self\n"
    ++ "  end\n"
    ++ "  def initialize(string = NO_STRING, mode = nil, **opts)\n"
