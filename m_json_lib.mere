    "class Range\n" ++
    "\n" ++
    "  # See #as_json.\n" ++
    "  def self.json_create(object)\n" ++
    "    new(*object['a'])\n" ++
    "  end\n" ++
    "\n" ++
    "  # Methods <tt>Range#as_json</tt> and +Range.json_create+ may be used\n" ++
    "  # to serialize and deserialize a \\Range object;\n" ++
    "  # see Marshal[rdoc-ref:Marshal].\n" ++
    "  #\n" ++
    "  # \\Method <tt>Range#as_json</tt> serializes +self+,\n" ++
    "  # returning a 2-element hash representing +self+:\n" ++
    "  #\n" ++
    "  #   require 'json/add/range'\n" ++
    "  #   x = (1..4).as_json     # => \{\"json_class\"=>\"Range\", \"a\"=>[1, 4, false]\}\n" ++
    "  #   y = (1...4).as_json    # => \{\"json_class\"=>\"Range\", \"a\"=>[1, 4, true]\}\n" ++
    "  #   z = ('a'..'d').as_json # => \{\"json_class\"=>\"Range\", \"a\"=>[\"a\", \"d\", false]\}\n" ++
    "  #\n" ++
    "  # \\Method +JSON.create+ deserializes such a hash, returning a \\Range object:\n" ++
    "  #\n" ++
    "  #   Range.json_create(x) # => 1..4\n" ++
    "  #   Range.json_create(y) # => 1...4\n" ++
    "  #   Range.json_create(z) # => \"a\"..\"d\"\n" ++
    "  #\n" ++
    "  def as_json(*)\n" ++
    "    \{\n" ++
    "      JSON.create_id  => self.class.name,\n" ++
    "      'a'             => [ first, last, exclude_end? ]\n" ++
    "    \}\n" ++
    "  end\n" ++
    "\n" ++
    "  # Returns a JSON string representing +self+:\n" ++
    "  #\n" ++
    "  #   require 'json/add/range'\n" ++
    "  #   puts (1..4).to_json\n" ++
    "  #   puts (1...4).to_json\n" ++
    "  #   puts ('a'..'d').to_json\n" ++
    "  #\n" ++
    "  # Output:\n" ++
    "  #\n" ++
