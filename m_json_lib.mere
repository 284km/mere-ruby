    "  # returning a 2-element hash representing +self+:\n" ++
    "  #\n" ++
    "  #   require 'json/add/time'\n" ++
    "  #   x = Time.now.as_json\n" ++
    "  #   # => \{\"json_class\"=>\"Time\", \"s\"=>1700931656, \"n\"=>472846644\}\n" ++
