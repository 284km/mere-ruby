    "  #\n" ++
    "  def as_json(*)\n" ++
    "    \{\n" ++
    "      JSON.create_id => self.class.name,\n" ++
    "      's'            => tv_sec,\n" ++
    "      'n'            => tv_nsec,\n" ++
    "    \}\n" ++
    "  end\n" ++
    "\n" ++
    "  # Returns a JSON string representing +self+:\n" ++
    "  #\n" ++
    "  #   require 'json/add/time'\n" ++
    "  #   puts Time.now.to_json\n" ++
    "  #\n" ++
    "  # Output:\n" ++
    "  #\n" ++
    "  #   \{\"json_class\":\"Time\",\"s\":1700931678,\"n\":980650786\}\n" ++
    "  #\n" ++
    "  def to_json(*args)\n" ++
    "    as_json.to_json(*args)\n" ++
    "  end\n" ++
    "end\n"
