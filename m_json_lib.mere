    "  #   z = BigDecimal(Complex(2, 0)).as_json # => \{\"json_class\"=>\"BigDecimal\", \"b\"=>\"27:0.2e1\"\}\n" ++
    "  #\n" ++
    "  # \\Method +JSON.create+ deserializes such a hash, returning a \\BigDecimal object:\n" ++
    "  #\n" ++
    "  #   BigDecimal.json_create(x) # => 0.2e1\n" ++
    "  #   BigDecimal.json_create(y) # => 0.2e1\n" ++
    "  #   BigDecimal.json_create(z) # => 0.2e1\n" ++
    "  #\n" ++
    "  def as_json(*)\n" ++
    "    \{\n" ++
    "      JSON.create_id => self.class.name,\n" ++
    "      'b'            => _dump.force_encoding(Encoding::UTF_8),\n" ++
