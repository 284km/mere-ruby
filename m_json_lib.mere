  else if str_eq n "json/add/time" then
    "# frozen_string_literal: true\n" ++
    "unless defined?(::JSON::JSON_LOADED) and ::JSON::JSON_LOADED\n" ++
    "  require 'json'\n" ++
    "end\n" ++
    "\n" ++
    "class Time\n" ++
    "\n" ++
    "  # See #as_json.\n" ++
    "  def self.json_create(object)\n" ++
    "    if usec = object.delete('u') # used to be tv_usec -> tv_nsec\n" ++
    "      object['n'] = usec * 1000\n" ++
    "    end\n" ++
    "    at(object['s'], Rational(object['n'], 1000))\n" ++
    "  end\n" ++
    "\n" ++
    "  # Methods <tt>Time#as_json</tt> and +Time.json_create+ may be used\n" ++
    "  # to serialize and deserialize a \\Time object;\n" ++
    "  # see Marshal[rdoc-ref:Marshal].\n" ++
    "  #\n" ++
