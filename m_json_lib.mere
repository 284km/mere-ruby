    "require 'date'\n" ++
    "\n" ++
    "class DateTime\n" ++
    "\n" ++
    "  # See #as_json.\n" ++
    "  def self.json_create(object)\n" ++
    "    args = object.values_at('y', 'm', 'd', 'H', 'M', 'S')\n" ++
    "    of_a, of_b = object['of'].split('/')\n" ++
    "    if of_b and of_b != '0'\n" ++
    "      args << Rational(of_a.to_i, of_b.to_i)\n" ++
    "    else\n" ++
    "      args << of_a\n" ++
    "    end\n" ++
    "    args << object['sg']\n" ++
    "    civil(*args)\n" ++
    "  end\n" ++
    "\n" ++
    "  alias start sg unless method_defined?(:start)\n" ++
    "\n" ++
    "  # Methods <tt>DateTime#as_json</tt> and +DateTime.json_create+ may be used\n" ++
    "  # to serialize and deserialize a \\DateTime object;\n" ++
    "  # see Marshal[rdoc-ref:Marshal].\n" ++
