    "#\n" ++
    "# ====== Output Options\n" ++
    "#\n" ++
    "# The default formatting options generate the most compact\n" ++
    "# \\JSON data, all on one line and with no whitespace.\n" ++
    "#\n" ++
    "# You can use these formatting options to generate\n" ++
    "# \\JSON data in a more open format, using whitespace.\n" ++
    "# See also JSON.pretty_generate.\n" ++
    "#\n" ++
    "# - Option +array_nl+ (\\String) specifies a string (usually a newline)\n" ++
    "#   to be inserted after each \\JSON array; defaults to the empty \\String, <tt>''</tt>.\n" ++
    "# - Option +object_nl+ (\\String) specifies a string (usually a newline)\n" ++
    "#   to be inserted after each \\JSON object; defaults to the empty \\String, <tt>''</tt>.\n" ++
    "# - Option +indent+ (\\String) specifies the string (usually spaces) to be\n" ++
    "#   used for indentation; defaults to the empty \\String, <tt>''</tt>;\n" ++
    "#   defaults to the empty \\String, <tt>''</tt>;\n" ++
    "#   has no effect unless options +array_nl+ or +object_nl+ specify newlines.\n" ++
    "# - Option +space+ (\\String) specifies a string (usually a space) to be\n" ++
    "#   inserted after the colon in each \\JSON object's pair;\n" ++
    "#   defaults to the empty \\String, <tt>''</tt>.\n" ++
    "# - Option +space_before+ (\\String) specifies a string (usually a space) to be\n" ++
    "#   inserted before the colon in each \\JSON object's pair;\n" ++
    "#   defaults to the empty \\String, <tt>''</tt>.\n" ++
    "#\n" ++
    "# In this example, +obj+ is used first to generate the shortest\n" ++
    "# \\JSON data (no whitespace), then again with all formatting options\n" ++
    "# specified:\n" ++
    "#\n" ++
    "#   obj = \{foo: [:bar, :baz], bat: \{bam: 0, bad: 1\}\}\n" ++
    "#   json = JSON.generate(obj)\n" ++
    "#   puts 'Compact:', json\n" ++
    "#   opts = \{\n" ++
    "#     array_nl: \"\\n\",\n" ++
    "#     object_nl: \"\\n\",\n" ++
    "#     indent: '  ',\n" ++
    "#     space_before: ' ',\n" ++
    "#     space: ' '\n" ++
    "#   \}\n" ++
    "#   puts 'Open:', JSON.generate(obj, opts)\n" ++
    "#\n" ++
    "# Output:\n" ++
    "#   Compact:\n" ++
    "#   \{\"foo\":[\"bar\",\"baz\"],\"bat\":\{\"bam\":0,\"bad\":1\}\}\n" ++
    "#   Open:\n" ++
    "#   \{\n" ++
    "#     \"foo\" : [\n" ++
    "#       \"bar\",\n" ++
    "#       \"baz\"\n" ++
    "#   ],\n" ++
    "#     \"bat\" : \{\n" ++
    "#       \"bam\" : 0,\n" ++
    "#       \"bad\" : 1\n" ++
    "#     \}\n" ++
    "#   \}\n" ++
    "#\n" ++
    "# == \\JSON Additions\n" ++
    "#\n" ++
    "# Note that JSON Additions must only be used with trusted data, and is\n" ++
    "# deprecated.\n" ++
    "#\n" ++
    "# When you \"round trip\" a non-\\String object from Ruby to \\JSON and back,\n" ++
    "# you have a new \\String, instead of the object you began with:\n" ++
    "#   ruby0 = Range.new(0, 2)\n" ++
    "#   json = JSON.generate(ruby0)\n" ++
    "#   json # => '0..2\"'\n" ++
    "#   ruby1 = JSON.parse(json)\n" ++
    "#   ruby1 # => '0..2'\n" ++
    "#   ruby1.class # => String\n" ++
    "#\n" ++
    "# You can use \\JSON _additions_ to preserve the original object.\n" ++
    "# The addition is an extension of a ruby class, so that:\n" ++
    "# - \\JSON.generate stores more information in the \\JSON string.\n" ++
    "# - \\JSON.parse, called with option +create_additions+,\n" ++
    "#   uses that information to create a proper Ruby object.\n" ++
    "#\n" ++
    "# This example shows a \\Range being generated into \\JSON\n" ++
    "# and parsed back into Ruby, both without and with\n" ++
    "# the addition for \\Range:\n" ++
    "#   ruby = Range.new(0, 2)\n" ++
    "#   # This passage does not use the addition for Range.\n" ++
    "#   json0 = JSON.generate(ruby)\n" ++
    "#   ruby0 = JSON.parse(json0)\n" ++
    "#   # This passage uses the addition for Range.\n" ++
    "#   require 'json/add/range'\n" ++
    "#   json1 = JSON.generate(ruby)\n" ++
    "#   ruby1 = JSON.parse(json1, create_additions: true)\n" ++
    "#   # Make a nice display.\n" ++
    "#   display = <<~EOT\n" ++
    "#     Generated JSON:\n" ++
    "#       Without addition:  #\{json0\} (#\{json0.class\})\n" ++
    "#       With addition:     #\{json1\} (#\{json1.class\})\n" ++
    "#     Parsed JSON:\n" ++
    "#       Without addition:  #\{ruby0.inspect\} (#\{ruby0.class\})\n" ++
    "#       With addition:     #\{ruby1.inspect\} (#\{ruby1.class\})\n" ++
    "#   EOT\n" ++
    "#   puts display\n" ++
    "#\n" ++
    "# This output shows the different results:\n" ++
    "#   Generated JSON:\n" ++
    "#     Without addition:  \"0..2\" (String)\n" ++
    "#     With addition:     \{\"json_class\":\"Range\",\"a\":[0,2,false]\} (String)\n" ++
    "#   Parsed JSON:\n" ++
    "#     Without addition:  \"0..2\" (String)\n" ++
    "#     With addition:     0..2 (Range)\n" ++
    "#\n" ++
    "# The \\JSON module includes additions for certain classes.\n" ++
    "# You can also craft custom additions.\n" ++
    "# See \{Custom \\JSON Additions\}[#module-JSON-label-Custom+JSON+Additions].\n" ++
    "#\n" ++
    "# === Built-in Additions\n" ++
    "#\n" ++
    "# The \\JSON module includes additions for certain classes.\n" ++
    "# To use an addition, +require+ its source:\n" ++
    "# - BigDecimal: <tt>require 'json/add/bigdecimal'</tt>\n" ++
    "# - Complex: <tt>require 'json/add/complex'</tt>\n" ++
    "# - Date: <tt>require 'json/add/date'</tt>\n" ++
    "# - DateTime: <tt>require 'json/add/date_time'</tt>\n" ++
    "# - Exception: <tt>require 'json/add/exception'</tt>\n" ++
    "# - OpenStruct: <tt>require 'json/add/ostruct'</tt>\n" ++
    "# - Range: <tt>require 'json/add/range'</tt>\n" ++
    "# - Rational: <tt>require 'json/add/rational'</tt>\n" ++
    "# - Regexp: <tt>require 'json/add/regexp'</tt>\n" ++
    "# - Set: <tt>require 'json/add/set'</tt>\n" ++
    "# - Struct: <tt>require 'json/add/struct'</tt>\n" ++
    "# - Symbol: <tt>require 'json/add/symbol'</tt>\n" ++
    "# - Time: <tt>require 'json/add/time'</tt>\n" ++
    "#\n" ++
    "# To reduce punctuation clutter, the examples below\n" ++
    "# show the generated \\JSON via +puts+, rather than the usual +inspect+,\n" ++
    "#\n" ++
    "# \\BigDecimal:\n" ++
    "#   require 'json/add/bigdecimal'\n" ++
    "#   ruby0 = BigDecimal(0) # 0.0\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"BigDecimal\",\"b\":\"27:0.0\"\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 0.0\n" ++
    "#   ruby1.class # => BigDecimal\n" ++
    "#\n" ++
    "# \\Complex:\n" ++
    "#   require 'json/add/complex'\n" ++
    "#   ruby0 = Complex(1+0i) # 1+0i\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Complex\",\"r\":1,\"i\":0\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 1+0i\n" ++
    "#   ruby1.class # Complex\n" ++
    "#\n" ++
    "# \\Date:\n" ++
    "#   require 'json/add/date'\n" ++
    "#   ruby0 = Date.today # 2020-05-02\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Date\",\"y\":2020,\"m\":5,\"d\":2,\"sg\":2299161.0\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 2020-05-02\n" ++
    "#   ruby1.class # Date\n" ++
    "#\n" ++
    "# \\DateTime:\n" ++
    "#   require 'json/add/date_time'\n" ++
    "#   ruby0 = DateTime.now # 2020-05-02T10:38:13-05:00\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"DateTime\",\"y\":2020,\"m\":5,\"d\":2,\"H\":10,\"M\":38,\"S\":13,\"of\":\"-5/24\",\"sg\":2299161.0\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 2020-05-02T10:38:13-05:00\n" ++
    "#   ruby1.class # DateTime\n" ++
    "#\n" ++
    "# \\Exception (and its subclasses including \\RuntimeError):\n" ++
    "#   require 'json/add/exception'\n" ++
    "#   ruby0 = Exception.new('A message') # A message\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Exception\",\"m\":\"A message\",\"b\":null\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # A message\n" ++
    "#   ruby1.class # Exception\n" ++
    "#   ruby0 = RuntimeError.new('Another message') # Another message\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"RuntimeError\",\"m\":\"Another message\",\"b\":null\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # Another message\n" ++
    "#   ruby1.class # RuntimeError\n" ++
    "#\n" ++
    "# \\OpenStruct:\n" ++
    "#   require 'json/add/ostruct'\n" ++
    "#   ruby0 = OpenStruct.new(name: 'Matz', language: 'Ruby') # #<OpenStruct name=\"Matz\", language=\"Ruby\">\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"OpenStruct\",\"t\":\{\"name\":\"Matz\",\"language\":\"Ruby\"\}\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # #<OpenStruct name=\"Matz\", language=\"Ruby\">\n" ++
    "#   ruby1.class # OpenStruct\n" ++
    "#\n" ++
    "# \\Range:\n" ++
    "#   require 'json/add/range'\n" ++
    "#   ruby0 = Range.new(0, 2) # 0..2\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Range\",\"a\":[0,2,false]\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 0..2\n" ++
    "#   ruby1.class # Range\n" ++
    "#\n" ++
    "# \\Rational:\n" ++
    "#   require 'json/add/rational'\n" ++
    "#   ruby0 = Rational(1, 3) # 1/3\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Rational\",\"n\":1,\"d\":3\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 1/3\n" ++
    "#   ruby1.class # Rational\n" ++
    "#\n" ++
    "# \\Regexp:\n" ++
    "#   require 'json/add/regexp'\n" ++
    "#   ruby0 = Regexp.new('foo') # (?-mix:foo)\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Regexp\",\"o\":0,\"s\":\"foo\"\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # (?-mix:foo)\n" ++
    "#   ruby1.class # Regexp\n" ++
    "#\n" ++
    "# \\Set:\n" ++
    "#   require 'json/add/set'\n" ++
    "#   ruby0 = Set.new([0, 1, 2]) # #<Set: \{0, 1, 2\}>\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Set\",\"a\":[0,1,2]\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # #<Set: \{0, 1, 2\}>\n" ++
    "#   ruby1.class # Set\n" ++
    "#\n" ++
    "# \\Struct:\n" ++
    "#   require 'json/add/struct'\n" ++
    "#   Customer = Struct.new(:name, :address) # Customer\n" ++
    "#   ruby0 = Customer.new(\"Dave\", \"123 Main\") # #<struct Customer name=\"Dave\", address=\"123 Main\">\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Customer\",\"v\":[\"Dave\",\"123 Main\"]\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # #<struct Customer name=\"Dave\", address=\"123 Main\">\n" ++
    "#   ruby1.class # Customer\n" ++
    "#\n" ++
    "# \\Symbol:\n" ++
    "#   require 'json/add/symbol'\n" ++
    "#   ruby0 = :foo # foo\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Symbol\",\"s\":\"foo\"\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # foo\n" ++
    "#   ruby1.class # Symbol\n" ++
    "#\n" ++
    "# \\Time:\n" ++
    "#   require 'json/add/time'\n" ++
    "#   ruby0 = Time.now # 2020-05-02 11:28:26 -0500\n" ++
    "#   json = JSON.generate(ruby0) # \{\"json_class\":\"Time\",\"s\":1588436906,\"n\":840560000\}\n" ++
    "#   ruby1 = JSON.parse(json, create_additions: true) # 2020-05-02 11:28:26 -0500\n" ++
    "#   ruby1.class # Time\n" ++
    "#\n" ++
    "#\n" ++
    "# === Custom \\JSON Additions\n" ++
    "#\n" ++
    "# In addition to the \\JSON additions provided,\n" ++
    "# you can craft \\JSON additions of your own,\n" ++
    "# either for Ruby built-in classes or for user-defined classes.\n" ++
    "#\n" ++
    "# Here's a user-defined class +Foo+:\n" ++
    "#   class Foo\n" ++
    "#     attr_accessor :bar, :baz\n" ++
    "#     def initialize(bar, baz)\n" ++
    "#       self.bar = bar\n" ++
    "#       self.baz = baz\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "# Here's the \\JSON addition for it:\n" ++
    "#   # Extend class Foo with JSON addition.\n" ++
    "#   class Foo\n" ++
    "#     # Serialize Foo object with its class name and arguments\n" ++
    "#     def to_json(*args)\n" ++
    "#       \{\n" ++
    "#         JSON.create_id  => self.class.name,\n" ++
    "#         'a'             => [ bar, baz ]\n" ++
    "#       \}.to_json(*args)\n" ++
    "#     end\n" ++
    "#     # Deserialize JSON string by constructing new Foo object with arguments.\n" ++
    "#     def self.json_create(object)\n" ++
    "#       new(*object['a'])\n" ++
    "#     end\n" ++
    "#   end\n" ++
    "#\n" ++
    "# Demonstration:\n" ++
    "#   require 'json'\n" ++
    "#   # This Foo object has no custom addition.\n" ++
    "#   foo0 = Foo.new(0, 1)\n" ++
    "#   json0 = JSON.generate(foo0)\n" ++
    "#   obj0 = JSON.parse(json0)\n" ++
    "#   # Lood the custom addition.\n" ++
    "#   require_relative 'foo_addition'\n" ++
    "#   # This foo has the custom addition.\n" ++
    "#   foo1 = Foo.new(0, 1)\n" ++
    "#   json1 = JSON.generate(foo1)\n" ++
    "#   obj1 = JSON.parse(json1, create_additions: true)\n" ++
    "#   #   Make a nice display.\n" ++
    "#   display = <<~EOT\n" ++
    "#     Generated JSON:\n" ++
    "#       Without custom addition:  #\{json0\} (#\{json0.class\})\n" ++
    "#       With custom addition:     #\{json1\} (#\{json1.class\})\n" ++
    "#     Parsed JSON:\n" ++
    "#       Without custom addition:  #\{obj0.inspect\} (#\{obj0.class\})\n" ++
    "#       With custom addition:     #\{obj1.inspect\} (#\{obj1.class\})\n" ++
    "#   EOT\n" ++
    "#   puts display\n" ++
    "#\n" ++
    "# Output:\n" ++
    "#\n" ++
    "#   Generated JSON:\n" ++
    "#     Without custom addition:  \"#<Foo:0x0000000006534e80>\" (String)\n" ++
    "#     With custom addition:     \{\"json_class\":\"Foo\",\"a\":[0,1]\} (String)\n" ++
    "#   Parsed JSON:\n" ++
    "#     Without custom addition:  \"#<Foo:0x0000000006534e80>\" (String)\n" ++
    "#     With custom addition:     #<Foo:0x0000000006473bb8 @bar=0, @baz=1> (Foo)\n" ++
    "#\n" ++
    "module JSON\n" ++
    "  require 'json/version'\n" ++
    "  require 'json/ext'\n" ++
    "end\n"
  else if str_eq n "json/common" then
    "# frozen_string_literal: true\n" ++
    "\n" ++
    "require 'json/version'\n" ++
    "\n" ++
    "module JSON\n" ++
    "  autoload :GenericObject, 'json/generic_object'\n" ++
    "\n" ++
    "  module ParserOptions # :nodoc:\n" ++
    "    class << self\n" ++
    "      def prepare(opts)\n" ++
    "        if opts[:object_class] || opts[:array_class]\n" ++
    "          opts = opts.dup\n" ++
    "          on_load = opts[:on_load]\n" ++
    "\n" ++
    "          on_load = object_class_proc(opts[:object_class], on_load) if opts[:object_class]\n" ++
    "          on_load = array_class_proc(opts[:array_class], on_load) if opts[:array_class]\n" ++
    "          opts[:on_load] = on_load\n" ++
    "        end\n" ++
    "\n" ++
    "        if opts.fetch(:create_additions, false) != false\n" ++
    "          opts = create_additions_proc(opts)\n" ++
    "        end\n" ++
    "\n" ++
    "        opts\n" ++
    "      end\n" ++
    "\n" ++
    "      private\n" ++
    "\n" ++
    "      def object_class_proc(object_class, on_load)\n" ++
    "        ->(obj) do\n" ++
    "          if Hash === obj\n" ++
    "            object = object_class.new\n" ++
    "            obj.each \{ |k, v| object[k] = v \}\n" ++
    "            obj = object\n" ++
    "          end\n" ++
    "          on_load.nil? ? obj : on_load.call(obj)\n" ++
    "        end\n" ++
    "      end\n" ++
    "\n" ++
    "      def array_class_proc(array_class, on_load)\n" ++
    "        ->(obj) do\n" ++
    "          if Array === obj\n" ++
    "            array = array_class.new\n" ++
    "            obj.each \{ |v| array << v \}\n" ++
    "            obj = array\n" ++
    "          end\n" ++
    "          on_load.nil? ? obj : on_load.call(obj)\n" ++
    "        end\n" ++
    "      end\n" ++
    "\n" ++
    "      # TODO: extract :create_additions support to another gem for version 3.0\n" ++
    "      def create_additions_proc(opts)\n" ++
    "        if opts[:symbolize_names]\n" ++
    "          raise ArgumentError, \"options :symbolize_names and :create_additions cannot be  used in conjunction\"\n" ++
    "        end\n" ++
    "\n" ++
    "        opts = opts.dup\n" ++
    "        create_additions = opts.fetch(:create_additions, false)\n" ++
    "        on_load = opts[:on_load]\n" ++
    "        object_class = opts[:object_class] || Hash\n" ++
    "\n" ++
    "        opts[:on_load] = ->(object) do\n" ++
    "          case object\n" ++
    "          when String\n" ++
    "            opts[:match_string]&.each do |pattern, klass|\n" ++
    "              if match = pattern.match(object)\n" ++
    "                create_additions_warning if create_additions.nil?\n" ++
    "                object = klass.json_create(object)\n" ++
    "                break\n" ++
    "              end\n" ++
    "            end\n" ++
    "          when object_class\n" ++
    "            if opts[:create_additions] != false\n" ++
    "              if class_path = object[JSON.create_id]\n" ++
    "                klass = begin\n" ++
    "                  Object.const_get(class_path)\n" ++
    "                rescue NameError => e\n" ++
    "                  raise ArgumentError, \"can't get const #\{class_path\}: #\{e\}\"\n" ++
    "                end\n" ++
    "\n" ++
    "                if klass.respond_to?(:json_creatable?) ? klass.json_creatable? : klass.respond_to?(:json_create)\n" ++
    "                  create_additions_warning if create_additions.nil?\n" ++
    "                  object = klass.json_create(object)\n" ++
    "                end\n" ++
    "              end\n" ++
    "            end\n" ++
    "          end\n" ++
    "\n" ++
    "          on_load.nil? ? object : on_load.call(object)\n" ++
    "        end\n" ++
    "\n" ++
    "        opts\n" ++
    "      end\n" ++
    "\n" ++
    "      def create_additions_warning\n" ++
    "        JSON.deprecation_warning \"JSON.load implicit support for `create_additions: true` is deprecated \" \\\n" ++
    "          \"and will be removed in 3.0, use JSON.unsafe_load or explicitly \" \\\n" ++
    "          \"pass `create_additions: true`\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  class << self\n" ++
    "    def deprecation_warning(message, uplevel = 3) # :nodoc:\n" ++
    "      gem_root = File.expand_path(\"..\", __dir__) + \"/\"\n" ++
    "      caller_locations(uplevel, 10).each do |frame|\n" ++
    "        if frame.path.nil? || frame.path.start_with?(gem_root) || frame.path.end_with?(\"/truffle/cext_ruby.rb\", \".c\")\n" ++
    "          uplevel += 1\n" ++
    "        else\n" ++
    "          break\n" ++
    "        end\n" ++
    "      end\n" ++
    "\n" ++
    "      if RUBY_VERSION >= \"3.0\"\n" ++
    "        warn(message, uplevel: uplevel, category: :deprecated)\n" ++
    "      else\n" ++
    "        warn(message, uplevel: uplevel)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    # :call-seq:\n" ++
    "    #   JSON[object] -> new_array or new_string\n" ++
    "    #\n" ++
    "    # If +object+ is a \\String,\n" ++
    "    # calls JSON.parse with +object+ and +opts+ (see method #parse):\n" ++
    "    #   json = '[0, 1, null]'\n" ++
    "    #   JSON[json]# => [0, 1, nil]\n" ++
    "    #\n" ++
    "    # Otherwise, calls JSON.generate with +object+ and +opts+ (see method #generate):\n" ++
    "    #   ruby = [0, 1, nil]\n" ++
    "    #   JSON[ruby] # => '[0,1,null]'\n" ++
    "    def [](object, opts = nil)\n" ++
    "      if object.is_a?(String)\n" ++
    "        return JSON.parse(object, opts)\n" ++
    "      elsif object.respond_to?(:to_str)\n" ++
    "        str = object.to_str\n" ++
    "        if str.is_a?(String)\n" ++
    "          return JSON.parse(str, opts)\n" ++
    "        end\n" ++
    "      end\n" ++
    "\n" ++
    "      JSON.generate(object, opts)\n" ++
    "    end\n" ++
    "\n" ++
    "    # Returns the JSON parser class that is used by JSON.\n" ++
    "    attr_reader :parser\n" ++
    "\n" ++
    "    # Set the JSON parser class _parser_ to be used by JSON.\n" ++
    "    def parser=(parser) # :nodoc:\n" ++
    "      @parser = parser\n" ++
    "      remove_const :Parser if const_defined?(:Parser, false)\n" ++
    "      const_set :Parser, parser\n" ++
    "    end\n" ++
    "\n" ++
    "    # Set the module _generator_ to be used by JSON.\n" ++
    "    def generator=(generator) # :nodoc:\n" ++
    "      old, $VERBOSE = $VERBOSE, nil\n" ++
    "      @generator = generator\n" ++
    "      generator_methods = generator::GeneratorMethods\n" ++
    "      for const in generator_methods.constants\n" ++
    "        klass = const_get(const)\n" ++
    "        modul = generator_methods.const_get(const)\n" ++
    "        klass.class_eval do\n" ++
    "          instance_methods(false).each do |m|\n" ++
    "            m.to_s == 'to_json' and remove_method m\n" ++
    "          end\n" ++
    "          include modul\n" ++
    "        end\n" ++
    "      end\n" ++
    "      self.state = generator::State\n" ++
    "      const_set :State, state\n" ++
    "    ensure\n" ++
    "      $VERBOSE = old\n" ++
    "    end\n" ++
    "\n" ++
    "    # Returns the JSON generator module that is used by JSON.\n" ++
    "    attr_reader :generator\n" ++
    "\n" ++
    "    # Sets or Returns the JSON generator state class that is used by JSON.\n" ++
    "    attr_accessor :state\n" ++
    "\n" ++
    "    private\n" ++
    "\n" ++
    "    # Called from the extension when a hash has both string and symbol keys\n" ++
    "    def on_mixed_keys_hash(hash, do_raise)\n" ++
    "      set = \{\}\n" ++
    "      hash.each_key do |key|\n" ++
    "        key_str = key.to_s\n" ++
    "\n" ++
    "        if set[key_str]\n" ++
    "          message = \"detected duplicate key #\{key_str.inspect\} in #\{hash.inspect\}\"\n" ++
    "          if do_raise\n" ++
    "            raise GeneratorError, message\n" ++
    "          else\n" ++
    "            deprecation_warning(\"#\{message\}.\\nThis will raise an error in json 3.0 unless enabled via `allow_duplicate_key: true`\")\n" ++
    "          end\n" ++
    "        else\n" ++
    "          set[key_str] = true\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    def deprecated_singleton_attr_accessor(*attrs)\n" ++
    "      args = RUBY_VERSION >= \"3.0\" ? \", category: :deprecated\" : \"\"\n" ++
    "      attrs.each do |attr|\n" ++
    "        singleton_class.class_eval <<~RUBY\n" ++
    "          def #\{attr\}\n" ++
    "            warn \"JSON.#\{attr\} is deprecated and will be removed in json 3.0.0\", uplevel: 1 #\{args\}\n" ++
    "            @#\{attr\}\n" ++
    "          end\n" ++
    "\n" ++
    "          def #\{attr\}=(val)\n" ++
    "            warn \"JSON.#\{attr\}= is deprecated and will be removed in json 3.0.0\", uplevel: 1 #\{args\}\n" ++
    "            @#\{attr\} = val\n" ++
    "          end\n" ++
    "\n" ++
    "          def _#\{attr\}\n" ++
    "            @#\{attr\}\n" ++
    "          end\n" ++
    "        RUBY\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # Sets create identifier, which is used to decide if the _json_create_\n" ++
    "  # hook of a class should be called; initial value is +json_class+:\n" ++
    "  #   JSON.create_id # => 'json_class'\n" ++
    "  def self.create_id=(new_value)\n" ++
    "    Thread.current[:\"JSON.create_id\"] = new_value.dup.freeze\n" ++
    "  end\n" ++
    "\n" ++
    "  # Returns the current create identifier.\n" ++
    "  # See also JSON.create_id=.\n" ++
    "  def self.create_id\n" ++
    "    Thread.current[:\"JSON.create_id\"] || 'json_class'\n" ++
    "  end\n" ++
    "\n" ++
    "  NaN           = Float::NAN\n" ++
    "\n" ++
    "  Infinity      = Float::INFINITY\n" ++
    "\n" ++
    "  MinusInfinity = -Infinity\n" ++
    "\n" ++
    "  # The base exception for JSON errors.\n" ++
    "  class JSONError < StandardError; end\n" ++
    "\n" ++
    "  # This exception is raised if a parser error occurs.\n" ++
    "  class ParserError < JSONError\n" ++
    "    attr_reader :line, :column\n" ++
    "  end\n" ++
    "\n" ++
    "  # This exception is raised if the nesting of parsed data structures is too\n" ++
    "  # deep.\n" ++
    "  class NestingError < ParserError; end\n" ++
    "\n" ++
    "  # This exception is raised if a generator or unparser error occurs.\n" ++
    "  class GeneratorError < JSONError\n" ++
    "    attr_reader :invalid_object\n" ++
    "\n" ++
    "    def initialize(message, invalid_object = nil)\n" ++
    "      super(message)\n" ++
    "      @invalid_object = invalid_object\n" ++
    "    end\n" ++
    "\n" ++
    "    def detailed_message(...)\n" ++
    "      # Exception#detailed_message doesn't exist until Ruby 3.2\n" ++
    "      super_message = defined?(super) ? super : message\n" ++
    "\n" ++
    "      if @invalid_object.nil?\n" ++
    "        super_message\n" ++
    "      else\n" ++
    "        \"#\{super_message\}\\nInvalid object: #\{@invalid_object.inspect\}\"\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # Fragment of JSON document that is to be included as is:\n" ++
    "  #   fragment = JSON::Fragment.new(\"[1, 2, 3]\")\n" ++
    "  #   JSON.generate(\{ count: 3, items: fragments \})\n" ++
    "  #\n" ++
    "  # This allows to easily assemble multiple JSON fragments that have\n" ++
    "  # been persisted somewhere without having to parse them nor resorting\n" ++
    "  # to string interpolation.\n" ++
    "  #\n" ++
    "  # Note: no validation is performed on the provided string. It is the\n" ++
    "  # responsibility of the caller to ensure the string contains valid JSON.\n" ++
    "  Fragment = Struct.new(:json) do\n" ++
    "    def initialize(json)\n" ++
    "      unless string = String.try_convert(json)\n" ++
    "        raise TypeError, \" no implicit conversion of #\{json.class\} into String\"\n" ++
    "      end\n" ++
    "\n" ++
    "      super(string)\n" ++
    "    end\n" ++
    "\n" ++
    "    def to_json(state = nil, *)\n" ++
    "      json\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  module_function\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.parse(source, opts) -> object\n" ++
    "  #\n" ++
    "  # Returns the Ruby objects created by parsing the given +source+.\n" ++
    "  #\n" ++
    "  # Argument +source+ contains the \\String to be parsed.\n" ++
    "  #\n" ++
    "  # Argument +opts+, if given, contains a \\Hash of options for the parsing.\n" ++
    "  # See \{Parsing Options\}[#module-JSON-label-Parsing+Options].\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When +source+ is a \\JSON array, returns a Ruby \\Array:\n" ++
    "  #   source = '[\"foo\", 1.0, true, false, null]'\n" ++
    "  #   ruby = JSON.parse(source)\n" ++
    "  #   ruby # => [\"foo\", 1.0, true, false, nil]\n" ++
    "  #   ruby.class # => Array\n" ++
    "  #\n" ++
    "  # When +source+ is a \\JSON object, returns a Ruby \\Hash:\n" ++
    "  #   source = '\{\"a\": \"foo\", \"b\": 1.0, \"c\": true, \"d\": false, \"e\": null\}'\n" ++
    "  #   ruby = JSON.parse(source)\n" ++
    "  #   ruby # => \{\"a\"=>\"foo\", \"b\"=>1.0, \"c\"=>true, \"d\"=>false, \"e\"=>nil\}\n" ++
    "  #   ruby.class # => Hash\n" ++
    "  #\n" ++
    "  # For examples of parsing for all \\JSON data types, see\n" ++
    "  # \{Parsing \\JSON\}[#module-JSON-label-Parsing+JSON].\n" ++
    "  #\n" ++
    "  # Parses nested JSON objects:\n" ++
    "  #   source = <<~JSON\n" ++
    "  #     \{\n" ++
    "  #     \"name\": \"Dave\",\n" ++
    "  #       \"age\" :40,\n" ++
    "  #       \"hats\": [\n" ++
    "  #         \"Cattleman's\",\n" ++
    "  #         \"Panama\",\n" ++
    "  #         \"Tophat\"\n" ++
    "  #       ]\n" ++
    "  #     \}\n" ++
    "  #   JSON\n" ++
    "  #   ruby = JSON.parse(source)\n" ++
    "  #   ruby # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # Raises an exception if +source+ is not valid JSON:\n" ++
    "  #   # Raises JSON::ParserError (783: unexpected token at ''):\n" ++
    "  #   JSON.parse('')\n" ++
    "  #\n" ++
    "  def parse(source, opts = nil)\n" ++
    "    opts = ParserOptions.prepare(opts) unless opts.nil?\n" ++
    "    Parser.parse(source, opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  PARSE_L_OPTIONS = \{\n" ++
    "    max_nesting: false,\n" ++
    "    allow_nan: true,\n" ++
    "  \}.freeze\n" ++
    "  private_constant :PARSE_L_OPTIONS\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.parse!(source, opts) -> object\n" ++
    "  #\n" ++
    "  # Calls\n" ++
    "  #   parse(source, opts)\n" ++
    "  # with +source+ and possibly modified +opts+.\n" ++
    "  #\n" ++
    "  # Differences from JSON.parse:\n" ++
    "  # - Option +max_nesting+, if not provided, defaults to +false+,\n" ++
    "  #   which disables checking for nesting depth.\n" ++
    "  # - Option +allow_nan+, if not provided, defaults to +true+.\n" ++
    "  def parse!(source, opts = nil)\n" ++
    "    if opts.nil?\n" ++
    "      parse(source, PARSE_L_OPTIONS)\n" ++
    "    else\n" ++
    "      parse(source, PARSE_L_OPTIONS.merge(opts))\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.load_file(path, opts=\{\}) -> object\n" ++
    "  #\n" ++
    "  # Calls:\n" ++
    "  #   parse(File.read(path), opts)\n" ++
    "  #\n" ++
    "  # See method #parse.\n" ++
    "  def load_file(filespec, opts = nil)\n" ++
    "    parse(File.read(filespec, encoding: Encoding::UTF_8), opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.load_file!(path, opts = \{\})\n" ++
    "  #\n" ++
    "  # Calls:\n" ++
    "  #   JSON.parse!(File.read(path, opts))\n" ++
    "  #\n" ++
    "  # See method #parse!\n" ++
    "  def load_file!(filespec, opts = nil)\n" ++
    "    parse!(File.read(filespec, encoding: Encoding::UTF_8), opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.generate(obj, opts = nil) -> new_string\n" ++
    "  #\n" ++
    "  # Returns a \\String containing the generated \\JSON data.\n" ++
    "  #\n" ++
    "  # See also JSON.pretty_generate.\n" ++
    "  #\n" ++
    "  # Argument +obj+ is the Ruby object to be converted to \\JSON.\n" ++
    "  #\n" ++
    "  # Argument +opts+, if given, contains a \\Hash of options for the generation.\n" ++
    "  # See \{Generating Options\}[#module-JSON-label-Generating+Options].\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When +obj+ is an \\Array, returns a \\String containing a \\JSON array:\n" ++
    "  #   obj = [\"foo\", 1.0, true, false, nil]\n" ++
    "  #   json = JSON.generate(obj)\n" ++
    "  #   json # => '[\"foo\",1.0,true,false,null]'\n" ++
    "  #\n" ++
    "  # When +obj+ is a \\Hash, returns a \\String containing a \\JSON object:\n" ++
    "  #   obj = \{foo: 0, bar: 's', baz: :bat\}\n" ++
    "  #   json = JSON.generate(obj)\n" ++
    "  #   json # => '\{\"foo\":0,\"bar\":\"s\",\"baz\":\"bat\"\}'\n" ++
    "  #\n" ++
    "  # For examples of generating from other Ruby objects, see\n" ++
    "  # \{Generating \\JSON from Other Objects\}[#module-JSON-label-Generating+JSON+from+Other+Objects].\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # Raises an exception if any formatting option is not a \\String.\n" ++
    "  #\n" ++
    "  # Raises an exception if +obj+ contains circular references:\n" ++
    "  #   a = []; b = []; a.push(b); b.push(a)\n" ++
    "  #   # Raises JSON::NestingError (nesting of 100 is too deep):\n" ++
    "  #   JSON.generate(a)\n" ++
    "  #\n" ++
    "  def generate(obj, opts = nil)\n" ++
    "    if State === opts\n" ++
    "      opts.generate(obj)\n" ++
    "    else\n" ++
    "      State.generate(obj, opts, nil)\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.fast_generate(obj, opts) -> new_string\n" ++
    "  #\n" ++
    "  # Arguments +obj+ and +opts+ here are the same as\n" ++
    "  # arguments +obj+ and +opts+ in JSON.generate.\n" ++
    "  #\n" ++
    "  # By default, generates \\JSON data without checking\n" ++
    "  # for circular references in +obj+ (option +max_nesting+ set to +false+, disabled).\n" ++
    "  #\n" ++
    "  # Raises an exception if +obj+ contains circular references:\n" ++
    "  #   a = []; b = []; a.push(b); b.push(a)\n" ++
    "  #   # Raises SystemStackError (stack level too deep):\n" ++
    "  #   JSON.fast_generate(a)\n" ++
    "  def fast_generate(obj, opts = nil)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"JSON.fast_generate is deprecated and will be removed in json 3.0.0, just use JSON.generate\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"JSON.fast_generate is deprecated and will be removed in json 3.0.0, just use JSON.generate\", uplevel: 1\n" ++
    "    end\n" ++
    "    generate(obj, opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  PRETTY_GENERATE_OPTIONS = \{\n" ++
    "    indent: '  ',\n" ++
    "    space: ' ',\n" ++
    "    object_nl: \"\\n\",\n" ++
    "    array_nl: \"\\n\",\n" ++
    "  \}.freeze\n" ++
    "  private_constant :PRETTY_GENERATE_OPTIONS\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.pretty_generate(obj, opts = nil) -> new_string\n" ++
    "  #\n" ++
    "  # Arguments +obj+ and +opts+ here are the same as\n" ++
    "  # arguments +obj+ and +opts+ in JSON.generate.\n" ++
    "  #\n" ++
    "  # Default options are:\n" ++
    "  #   \{\n" ++
    "  #     indent: '  ',   # Two spaces\n" ++
    "  #     space: ' ',     # One space\n" ++
    "  #     array_nl: \"\\n\", # Newline\n" ++
    "  #     object_nl: \"\\n\" # Newline\n" ++
    "  #   \}\n" ++
    "  #\n" ++
    "  # Example:\n" ++
    "  #   obj = \{foo: [:bar, :baz], bat: \{bam: 0, bad: 1\}\}\n" ++
    "  #   json = JSON.pretty_generate(obj)\n" ++
    "  #   puts json\n" ++
    "  # Output:\n" ++
    "  #   \{\n" ++
    "  #     \"foo\": [\n" ++
    "  #       \"bar\",\n" ++
    "  #       \"baz\"\n" ++
    "  #     ],\n" ++
    "  #     \"bat\": \{\n" ++
    "  #       \"bam\": 0,\n" ++
    "  #       \"bad\": 1\n" ++
    "  #     \}\n" ++
    "  #   \}\n" ++
    "  #\n" ++
    "  def pretty_generate(obj, opts = nil)\n" ++
    "    return opts.generate(obj) if State === opts\n" ++
    "\n" ++
    "    options = PRETTY_GENERATE_OPTIONS\n" ++
    "\n" ++
    "    if opts\n" ++
    "      unless opts.is_a?(Hash)\n" ++
    "        if opts.respond_to? :to_hash\n" ++
    "          opts = opts.to_hash\n" ++
    "        elsif opts.respond_to? :to_h\n" ++
    "          opts = opts.to_h\n" ++
    "        else\n" ++
    "          raise TypeError, \"can't convert #\{opts.class\} into Hash\"\n" ++
    "        end\n" ++
    "      end\n" ++
    "      options = options.merge(opts)\n" ++
    "    end\n" ++
    "\n" ++
    "    State.generate(obj, options, nil)\n" ++
    "  end\n" ++
    "\n" ++
    "  # Sets or returns default options for the JSON.unsafe_load method.\n" ++
    "  # Initially:\n" ++
    "  #   opts = JSON.load_default_options\n" ++
    "  #   opts # => \{:max_nesting=>false, :allow_nan=>true, :allow_blank=>true, :create_additions=>true\}\n" ++
    "  deprecated_singleton_attr_accessor :unsafe_load_default_options\n" ++
    "\n" ++
    "  @unsafe_load_default_options = \{\n" ++
    "    :max_nesting      => false,\n" ++
    "    :allow_nan        => true,\n" ++
    "    :allow_blank      => true,\n" ++
    "    :create_additions => true,\n" ++
    "  \}\n" ++
    "\n" ++
    "  # Sets or returns default options for the JSON.load method.\n" ++
    "  # Initially:\n" ++
    "  #   opts = JSON.load_default_options\n" ++
    "  #   opts # => \{:max_nesting=>false, :allow_nan=>true, :allow_blank=>true, :create_additions=>true\}\n" ++
    "  deprecated_singleton_attr_accessor :load_default_options\n" ++
    "\n" ++
    "  @load_default_options = \{\n" ++
    "    :allow_nan        => true,\n" ++
    "    :allow_blank      => true,\n" ++
    "    :create_additions => nil,\n" ++
    "  \}\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.unsafe_load(source, options = \{\}) -> object\n" ++
    "  #   JSON.unsafe_load(source, proc = nil, options = \{\}) -> object\n" ++
    "  #\n" ++
    "  # Returns the Ruby objects created by parsing the given +source+.\n" ++
    "  #\n" ++
    "  # BEWARE: This method is meant to serialise data from trusted user input,\n" ++
    "  # like from your own database server or clients under your control, it could\n" ++
    "  # be dangerous to allow untrusted users to pass JSON sources into it.\n" ++
    "  #\n" ++
    "  # - Argument +source+ must be, or be convertible to, a \\String:\n" ++
    "  #   - If +source+ responds to instance method +to_str+,\n" ++
    "  #     <tt>source.to_str</tt> becomes the source.\n" ++
    "  #   - If +source+ responds to instance method +to_io+,\n" ++
    "  #     <tt>source.to_io.read</tt> becomes the source.\n" ++
    "  #   - If +source+ responds to instance method +read+,\n" ++
    "  #     <tt>source.read</tt> becomes the source.\n" ++
    "  #   - If both of the following are true, source becomes the \\String <tt>'null'</tt>:\n" ++
    "  #     - Option +allow_blank+ specifies a truthy value.\n" ++
    "  #     - The source, as defined above, is +nil+ or the empty \\String <tt>''</tt>.\n" ++
    "  #   - Otherwise, +source+ remains the source.\n" ++
    "  # - Argument +proc+, if given, must be a \\Proc that accepts one argument.\n" ++
    "  #   It will be called recursively with each result (depth-first order).\n" ++
    "  #   See details below.\n" ++
    "  # - Argument +opts+, if given, contains a \\Hash of options for the parsing.\n" ++
    "  #   See \{Parsing Options\}[#module-JSON-label-Parsing+Options].\n" ++
    "  #   The default options can be changed via method JSON.unsafe_load_default_options=.\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When no +proc+ is given, modifies +source+ as above and returns the result of\n" ++
    "  # <tt>parse(source, opts)</tt>;  see #parse.\n" ++
    "  #\n" ++
    "  # Source for following examples:\n" ++
    "  #   source = <<~JSON\n" ++
    "  #     \{\n" ++
    "  #       \"name\": \"Dave\",\n" ++
    "  #       \"age\" :40,\n" ++
    "  #       \"hats\": [\n" ++
    "  #         \"Cattleman's\",\n" ++
    "  #         \"Panama\",\n" ++
    "  #         \"Tophat\"\n" ++
    "  #       ]\n" ++
    "  #     \}\n" ++
    "  #   JSON\n" ++
    "  #\n" ++
    "  # Load a \\String:\n" ++
    "  #   ruby = JSON.unsafe_load(source)\n" ++
    "  #   ruby # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # Load an \\IO object:\n" ++
    "  #   require 'stringio'\n" ++
    "  #   object = JSON.unsafe_load(StringIO.new(source))\n" ++
    "  #   object # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # Load a \\File object:\n" ++
    "  #   path = 't.json'\n" ++
    "  #   File.write(path, source)\n" ++
    "  #   File.open(path) do |file|\n" ++
    "  #     JSON.unsafe_load(file)\n" ++
    "  #   end # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When +proc+ is given:\n" ++
    "  # - Modifies +source+ as above.\n" ++
    "  # - Gets the +result+ from calling <tt>parse(source, opts)</tt>.\n" ++
    "  # - Recursively calls <tt>proc(result)</tt>.\n" ++
    "  # - Returns the final result.\n" ++
    "  #\n" ++
    "  # Example:\n" ++
    "  #   require 'json'\n" ++
    "  #\n" ++
    "  #   # Some classes for the example.\n" ++
    "  #   class Base\n" ++
    "  #     def initialize(attributes)\n" ++
    "  #       @attributes = attributes\n" ++
    "  #     end\n" ++
    "  #   end\n" ++
    "  #   class User    < Base; end\n" ++
    "  #   class Account < Base; end\n" ++
    "  #   class Admin   < Base; end\n" ++
    "  #   # The JSON source.\n" ++
    "  #   json = <<-EOF\n" ++
    "  #   \{\n" ++
    "  #     \"users\": [\n" ++
    "  #         \{\"type\": \"User\", \"username\": \"jane\", \"email\": \"jane@example.com\"\},\n" ++
    "  #         \{\"type\": \"User\", \"username\": \"john\", \"email\": \"john@example.com\"\}\n" ++
    "  #     ],\n" ++
    "  #     \"accounts\": [\n" ++
    "  #         \{\"account\": \{\"type\": \"Account\", \"paid\": true, \"account_id\": \"1234\"\}\},\n" ++
    "  #         \{\"account\": \{\"type\": \"Account\", \"paid\": false, \"account_id\": \"1235\"\}\}\n" ++
    "  #     ],\n" ++
    "  #     \"admins\": \{\"type\": \"Admin\", \"password\": \"0wn3d\"\}\n" ++
    "  #   \}\n" ++
    "  #   EOF\n" ++
    "  #   # Deserializer method.\n" ++
    "  #   def deserialize_obj(obj, safe_types = %w(User Account Admin))\n" ++
    "  #     type = obj.is_a?(Hash) && obj[\"type\"]\n" ++
    "  #     safe_types.include?(type) ? Object.const_get(type).new(obj) : obj\n" ++
    "  #   end\n" ++
    "  #   # Call to JSON.unsafe_load\n" ++
    "  #   ruby = JSON.unsafe_load(json, proc \{|obj|\n" ++
    "  #     case obj\n" ++
    "  #     when Hash\n" ++
    "  #       obj.each \{|k, v| obj[k] = deserialize_obj v \}\n" ++
    "  #     when Array\n" ++
    "  #       obj.map! \{|v| deserialize_obj v \}\n" ++
    "  #     end\n" ++
    "  #     obj\n" ++
    "  #   \})\n" ++
    "  #   pp ruby\n" ++
    "  # Output:\n" ++
    "  #   \{\"users\"=>\n" ++
    "  #      [#<User:0x00000000064c4c98\n" ++
    "  #        @attributes=\n" ++
    "  #          \{\"type\"=>\"User\", \"username\"=>\"jane\", \"email\"=>\"jane@example.com\"\}>,\n" ++
    "  #        #<User:0x00000000064c4bd0\n" ++
    "  #        @attributes=\n" ++
    "  #          \{\"type\"=>\"User\", \"username\"=>\"john\", \"email\"=>\"john@example.com\"\}>],\n" ++
    "  #    \"accounts\"=>\n" ++
    "  #      [\{\"account\"=>\n" ++
    "  #          #<Account:0x00000000064c4928\n" ++
    "  #          @attributes=\{\"type\"=>\"Account\", \"paid\"=>true, \"account_id\"=>\"1234\"\}>\},\n" ++
    "  #       \{\"account\"=>\n" ++
    "  #          #<Account:0x00000000064c4680\n" ++
    "  #          @attributes=\{\"type\"=>\"Account\", \"paid\"=>false, \"account_id\"=>\"1235\"\}>\}],\n" ++
    "  #    \"admins\"=>\n" ++
    "  #      #<Admin:0x00000000064c41f8\n" ++
    "  #      @attributes=\{\"type\"=>\"Admin\", \"password\"=>\"0wn3d\"\}>\}\n" ++
    "  #\n" ++
    "  def unsafe_load(source, proc = nil, options = nil)\n" ++
    "    opts = if options.nil?\n" ++
    "      if proc && proc.is_a?(Hash)\n" ++
    "        options, proc = proc, nil\n" ++
    "        options\n" ++
    "      else\n" ++
    "        _unsafe_load_default_options\n" ++
    "      end\n" ++
    "    else\n" ++
    "      _unsafe_load_default_options.merge(options)\n" ++
    "    end\n" ++
    "\n" ++
    "    unless source.is_a?(String)\n" ++
    "      if source.respond_to? :to_str\n" ++
    "        source = source.to_str\n" ++
    "      elsif source.respond_to? :to_io\n" ++
    "        source = source.to_io.read\n" ++
    "      elsif source.respond_to?(:read)\n" ++
    "        source = source.read\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    if opts[:allow_blank] && (source.nil? || source.empty?)\n" ++
    "      source = 'null'\n" ++
    "    end\n" ++
    "\n" ++
    "    if proc\n" ++
    "      opts = opts.dup\n" ++
    "      opts[:on_load] = proc.to_proc\n" ++
    "    end\n" ++
    "\n" ++
    "    parse(source, opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.load(source, options = \{\}) -> object\n" ++
    "  #   JSON.load(source, proc = nil, options = \{\}) -> object\n" ++
    "  #\n" ++
    "  # Returns the Ruby objects created by parsing the given +source+.\n" ++
    "  #\n" ++
    "  # BEWARE: This method is meant to serialise data from trusted user input,\n" ++
    "  # like from your own database server or clients under your control, it could\n" ++
    "  # be dangerous to allow untrusted users to pass JSON sources into it.\n" ++
    "  # If you must use it, use JSON.unsafe_load instead to make it clear.\n" ++
    "  #\n" ++
    "  # Since JSON version 2.8.0, `load` emits a deprecation warning when a\n" ++
    "  # non native type is deserialized, without `create_additions` being explicitly\n" ++
    "  # enabled, and in JSON version 3.0, `load` will have `create_additions` disabled\n" ++
    "  # by default.\n" ++
    "  #\n" ++
    "  # - Argument +source+ must be, or be convertible to, a \\String:\n" ++
    "  #   - If +source+ responds to instance method +to_str+,\n" ++
    "  #     <tt>source.to_str</tt> becomes the source.\n" ++
    "  #   - If +source+ responds to instance method +to_io+,\n" ++
    "  #     <tt>source.to_io.read</tt> becomes the source.\n" ++
    "  #   - If +source+ responds to instance method +read+,\n" ++
    "  #     <tt>source.read</tt> becomes the source.\n" ++
    "  #   - If both of the following are true, source becomes the \\String <tt>'null'</tt>:\n" ++
    "  #     - Option +allow_blank+ specifies a truthy value.\n" ++
    "  #     - The source, as defined above, is +nil+ or the empty \\String <tt>''</tt>.\n" ++
    "  #   - Otherwise, +source+ remains the source.\n" ++
    "  # - Argument +proc+, if given, must be a \\Proc that accepts one argument.\n" ++
    "  #   It will be called recursively with each result (depth-first order).\n" ++
    "  #   See details below.\n" ++
    "  # - Argument +opts+, if given, contains a \\Hash of options for the parsing.\n" ++
    "  #   See \{Parsing Options\}[#module-JSON-label-Parsing+Options].\n" ++
    "  #   The default options can be changed via method JSON.load_default_options=.\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When no +proc+ is given, modifies +source+ as above and returns the result of\n" ++
    "  # <tt>parse(source, opts)</tt>;  see #parse.\n" ++
    "  #\n" ++
    "  # Source for following examples:\n" ++
    "  #   source = <<~JSON\n" ++
    "  #     \{\n" ++
    "  #       \"name\": \"Dave\",\n" ++
    "  #       \"age\" :40,\n" ++
    "  #       \"hats\": [\n" ++
    "  #         \"Cattleman's\",\n" ++
    "  #         \"Panama\",\n" ++
    "  #         \"Tophat\"\n" ++
    "  #       ]\n" ++
    "  #     \}\n" ++
    "  #   JSON\n" ++
    "  #\n" ++
    "  # Load a \\String:\n" ++
    "  #   ruby = JSON.load(source)\n" ++
    "  #   ruby # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # Load an \\IO object:\n" ++
    "  #   require 'stringio'\n" ++
    "  #   object = JSON.load(StringIO.new(source))\n" ++
    "  #   object # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # Load a \\File object:\n" ++
    "  #   path = 't.json'\n" ++
    "  #   File.write(path, source)\n" ++
    "  #   File.open(path) do |file|\n" ++
    "  #     JSON.load(file)\n" ++
    "  #   end # => \{\"name\"=>\"Dave\", \"age\"=>40, \"hats\"=>[\"Cattleman's\", \"Panama\", \"Tophat\"]\}\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When +proc+ is given:\n" ++
    "  # - Modifies +source+ as above.\n" ++
    "  # - Gets the +result+ from calling <tt>parse(source, opts)</tt>.\n" ++
    "  # - Recursively calls <tt>proc(result)</tt>.\n" ++
    "  # - Returns the final result.\n" ++
    "  #\n" ++
    "  # Example:\n" ++
    "  #   require 'json'\n" ++
    "  #\n" ++
    "  #   # Some classes for the example.\n" ++
    "  #   class Base\n" ++
    "  #     def initialize(attributes)\n" ++
    "  #       @attributes = attributes\n" ++
    "  #     end\n" ++
    "  #   end\n" ++
    "  #   class User    < Base; end\n" ++
    "  #   class Account < Base; end\n" ++
    "  #   class Admin   < Base; end\n" ++
    "  #   # The JSON source.\n" ++
    "  #   json = <<-EOF\n" ++
    "  #   \{\n" ++
    "  #     \"users\": [\n" ++
    "  #         \{\"type\": \"User\", \"username\": \"jane\", \"email\": \"jane@example.com\"\},\n" ++
    "  #         \{\"type\": \"User\", \"username\": \"john\", \"email\": \"john@example.com\"\}\n" ++
    "  #     ],\n" ++
    "  #     \"accounts\": [\n" ++
    "  #         \{\"account\": \{\"type\": \"Account\", \"paid\": true, \"account_id\": \"1234\"\}\},\n" ++
    "  #         \{\"account\": \{\"type\": \"Account\", \"paid\": false, \"account_id\": \"1235\"\}\}\n" ++
    "  #     ],\n" ++
    "  #     \"admins\": \{\"type\": \"Admin\", \"password\": \"0wn3d\"\}\n" ++
    "  #   \}\n" ++
    "  #   EOF\n" ++
    "  #   # Deserializer method.\n" ++
    "  #   def deserialize_obj(obj, safe_types = %w(User Account Admin))\n" ++
    "  #     type = obj.is_a?(Hash) && obj[\"type\"]\n" ++
    "  #     safe_types.include?(type) ? Object.const_get(type).new(obj) : obj\n" ++
    "  #   end\n" ++
    "  #   # Call to JSON.load\n" ++
    "  #   ruby = JSON.load(json, proc \{|obj|\n" ++
    "  #     case obj\n" ++
    "  #     when Hash\n" ++
    "  #       obj.each \{|k, v| obj[k] = deserialize_obj v \}\n" ++
    "  #     when Array\n" ++
    "  #       obj.map! \{|v| deserialize_obj v \}\n" ++
    "  #     end\n" ++
    "  #     obj\n" ++
    "  #   \})\n" ++
    "  #   pp ruby\n" ++
    "  # Output:\n" ++
    "  #   \{\"users\"=>\n" ++
    "  #      [#<User:0x00000000064c4c98\n" ++
    "  #        @attributes=\n" ++
    "  #          \{\"type\"=>\"User\", \"username\"=>\"jane\", \"email\"=>\"jane@example.com\"\}>,\n" ++
    "  #        #<User:0x00000000064c4bd0\n" ++
    "  #        @attributes=\n" ++
    "  #          \{\"type\"=>\"User\", \"username\"=>\"john\", \"email\"=>\"john@example.com\"\}>],\n" ++
    "  #    \"accounts\"=>\n" ++
    "  #      [\{\"account\"=>\n" ++
    "  #          #<Account:0x00000000064c4928\n" ++
    "  #          @attributes=\{\"type\"=>\"Account\", \"paid\"=>true, \"account_id\"=>\"1234\"\}>\},\n" ++
    "  #       \{\"account\"=>\n" ++
    "  #          #<Account:0x00000000064c4680\n" ++
    "  #          @attributes=\{\"type\"=>\"Account\", \"paid\"=>false, \"account_id\"=>\"1235\"\}>\}],\n" ++
    "  #    \"admins\"=>\n" ++
    "  #      #<Admin:0x00000000064c41f8\n" ++
    "  #      @attributes=\{\"type\"=>\"Admin\", \"password\"=>\"0wn3d\"\}>\}\n" ++
    "  #\n" ++
    "  def load(source, proc = nil, options = nil)\n" ++
    "    if proc && options.nil? && proc.is_a?(Hash)\n" ++
    "      options = proc\n" ++
    "      proc = nil\n" ++
    "    end\n" ++
    "\n" ++
    "    opts = if options.nil?\n" ++
    "      if proc && proc.is_a?(Hash)\n" ++
    "        options, proc = proc, nil\n" ++
    "        options\n" ++
    "      else\n" ++
    "        _load_default_options\n" ++
    "      end\n" ++
    "    else\n" ++
    "      _load_default_options.merge(options)\n" ++
    "    end\n" ++
    "\n" ++
    "    unless source.is_a?(String)\n" ++
    "      if source.respond_to? :to_str\n" ++
    "        source = source.to_str\n" ++
    "      elsif source.respond_to? :to_io\n" ++
    "        source = source.to_io.read\n" ++
    "      elsif source.respond_to?(:read)\n" ++
    "        source = source.read\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    if opts[:allow_blank] && (source.nil? || source.empty?)\n" ++
    "      source = 'null'\n" ++
    "    end\n" ++
    "\n" ++
    "    if proc\n" ++
    "      opts = opts.dup\n" ++
    "      opts[:on_load] = proc.to_proc\n" ++
    "    end\n" ++
    "\n" ++
    "    parse(source, opts)\n" ++
    "  end\n" ++
    "\n" ++
    "  # Sets or returns the default options for the JSON.dump method.\n" ++
    "  # Initially:\n" ++
    "  #   opts = JSON.dump_default_options\n" ++
    "  #   opts # => \{:max_nesting=>false, :allow_nan=>true\}\n" ++
    "  deprecated_singleton_attr_accessor :dump_default_options\n" ++
    "  @dump_default_options = \{\n" ++
    "    :max_nesting => false,\n" ++
    "    :allow_nan   => true,\n" ++
    "  \}\n" ++
    "\n" ++
    "  # :call-seq:\n" ++
    "  #   JSON.dump(obj, io = nil, limit = nil)\n" ++
    "  #\n" ++
    "  # Dumps +obj+ as a \\JSON string, i.e. calls generate on the object and returns the result.\n" ++
    "  #\n" ++
    "  # The default options can be changed via method JSON.dump_default_options.\n" ++
    "  #\n" ++
    "  # - Argument +io+, if given, should respond to method +write+;\n" ++
    "  #   the \\JSON \\String is written to +io+, and +io+ is returned.\n" ++
    "  #   If +io+ is not given, the \\JSON \\String is returned.\n" ++
    "  # - Argument +limit+, if given, is passed to JSON.generate as option +max_nesting+.\n" ++
    "  #\n" ++
    "  # ---\n" ++
    "  #\n" ++
    "  # When argument +io+ is not given, returns the \\JSON \\String generated from +obj+:\n" ++
    "  #   obj = \{foo: [0, 1], bar: \{baz: 2, bat: 3\}, bam: :bad\}\n" ++
    "  #   json = JSON.dump(obj)\n" ++
    "  #   json # => \"\{\\\"foo\\\":[0,1],\\\"bar\\\":\{\\\"baz\\\":2,\\\"bat\\\":3\},\\\"bam\\\":\\\"bad\\\"\}\"\n" ++
    "  #\n" ++
    "  # When argument +io+ is given, writes the \\JSON \\String to +io+ and returns +io+:\n" ++
    "  #   path = 't.json'\n" ++
    "  #   File.open(path, 'w') do |file|\n" ++
    "  #     JSON.dump(obj, file)\n" ++
    "  #   end # => #<File:t.json (closed)>\n" ++
    "  #   puts File.read(path)\n" ++
    "  # Output:\n" ++
    "  #   \{\"foo\":[0,1],\"bar\":\{\"baz\":2,\"bat\":3\},\"bam\":\"bad\"\}\n" ++
    "  def dump(obj, anIO = nil, limit = nil, kwargs = nil)\n" ++
    "    if kwargs.nil?\n" ++
    "      if limit.nil?\n" ++
    "        if anIO.is_a?(Hash)\n" ++
    "          kwargs = anIO\n" ++
    "          anIO = nil\n" ++
    "        end\n" ++
    "      elsif limit.is_a?(Hash)\n" ++
    "        kwargs = limit\n" ++
    "        limit = nil\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    unless anIO.nil?\n" ++
    "      if anIO.respond_to?(:to_io)\n" ++
    "        anIO = anIO.to_io\n" ++
    "      elsif limit.nil? && !anIO.respond_to?(:write)\n" ++
    "        anIO, limit = nil, anIO\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    opts = JSON._dump_default_options\n" ++
    "    opts = opts.merge(:max_nesting => limit) if limit\n" ++
    "    opts = opts.merge(kwargs) if kwargs\n" ++
    "\n" ++
    "    begin\n" ++
    "      State.generate(obj, opts, anIO)\n" ++
    "    rescue JSON::NestingError\n" ++
    "      raise ArgumentError, \"exceed depth limit\"\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  # :stopdoc:\n" ++
    "  # All these were meant to be deprecated circa 2009, but were just set as undocumented\n" ++
    "  # so usage still exist in the wild.\n" ++
    "  def unparse(...)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"JSON.unparse is deprecated and will be removed in json 3.0.0, just use JSON.generate\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"JSON.unparse is deprecated and will be removed in json 3.0.0, just use JSON.generate\", uplevel: 1\n" ++
    "    end\n" ++
    "    generate(...)\n" ++
    "  end\n" ++
    "  module_function :unparse\n" ++
    "\n" ++
    "  def fast_unparse(...)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"JSON.fast_unparse is deprecated and will be removed in json 3.0.0, just use JSON.generate\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"JSON.fast_unparse is deprecated and will be removed in json 3.0.0, just use JSON.generate\", uplevel: 1\n" ++
    "    end\n" ++
    "    generate(...)\n" ++
    "  end\n" ++
    "  module_function :fast_unparse\n" ++
    "\n" ++
    "  def pretty_unparse(...)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"JSON.pretty_unparse is deprecated and will be removed in json 3.0.0, just use JSON.pretty_generate\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"JSON.pretty_unparse is deprecated and will be removed in json 3.0.0, just use JSON.pretty_generate\", uplevel: 1\n" ++
    "    end\n" ++
    "    pretty_generate(...)\n" ++
    "  end\n" ++
    "  module_function :fast_unparse\n" ++
    "\n" ++
    "  def restore(...)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"JSON.restore is deprecated and will be removed in json 3.0.0, just use JSON.load\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"JSON.restore is deprecated and will be removed in json 3.0.0, just use JSON.load\", uplevel: 1\n" ++
    "    end\n" ++
    "    load(...)\n" ++
    "  end\n" ++
    "  module_function :restore\n" ++
    "\n" ++
    "  class << self\n" ++
    "    private\n" ++
    "\n" ++
    "    def const_missing(const_name)\n" ++
    "      case const_name\n" ++
    "      when :PRETTY_STATE_PROTOTYPE\n" ++
    "        if RUBY_VERSION >= \"3.0\"\n" ++
    "          warn \"JSON::PRETTY_STATE_PROTOTYPE is deprecated and will be removed in json 3.0.0, just use JSON.pretty_generate\", uplevel: 1, category: :deprecated\n" ++
    "        else\n" ++
    "          warn \"JSON::PRETTY_STATE_PROTOTYPE is deprecated and will be removed in json 3.0.0, just use JSON.pretty_generate\", uplevel: 1\n" ++
    "        end\n" ++
    "        state.new(PRETTY_GENERATE_OPTIONS)\n" ++
    "      else\n" ++
    "        super\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "  # :startdoc:\n" ++
    "\n" ++
    "  # JSON::Coder holds a parser and generator configuration.\n" ++
    "  #\n" ++
    "  #   module MyApp\n" ++
    "  #     JSONC_CODER = JSON::Coder.new(\n" ++
    "  #       allow_trailing_comma: true\n" ++
    "  #     )\n" ++
    "  #   end\n" ++
    "  #\n" ++
    "  #   MyApp::JSONC_CODER.load(document)\n" ++
    "  #\n" ++
    "  class Coder\n" ++
    "    # :call-seq:\n" ++
    "    #   JSON.new(options = nil, &block)\n" ++
    "    #\n" ++
    "    # Argument +options+, if given, contains a \\Hash of options for both parsing and generating.\n" ++
    "    # See \{Parsing Options\}[#module-JSON-label-Parsing+Options], and \{Generating Options\}[#module-JSON-label-Generating+Options].\n" ++
    "    #\n" ++
    "    # For generation, the <tt>strict: true</tt> option is always set. When a Ruby object with no native \\JSON counterpart is\n" ++
    "    # encountered, the block provided to the initialize method is invoked, and must return a Ruby object that has a native\n" ++
    "    # \\JSON counterpart:\n" ++
    "    #\n" ++
    "    #  module MyApp\n" ++
    "    #    API_JSON_CODER = JSON::Coder.new do |object|\n" ++
    "    #      case object\n" ++
    "    #      when Time\n" ++
    "    #        object.iso8601(3)\n" ++
    "    #      else\n" ++
    "    #        object # Unknown type, will raise\n" ++
    "    #      end\n" ++
    "    #    end\n" ++
    "    #  end\n" ++
    "    #\n" ++
    "    #  puts MyApp::API_JSON_CODER.dump(Time.now.utc) # => \"2025-01-21T08:41:44.286Z\"\n" ++
    "    #\n" ++
    "    def initialize(options = nil, &as_json)\n" ++
    "      if options.nil?\n" ++
    "        options = \{ strict: true \}\n" ++
    "      else\n" ++
    "        options = options.dup\n" ++
    "        options[:strict] = true\n" ++
    "      end\n" ++
    "      options[:as_json] = as_json if as_json\n" ++
    "\n" ++
    "      @state = State.new(options).freeze\n" ++
    "      @parser_config = Ext::Parser::Config.new(ParserOptions.prepare(options)).freeze\n" ++
    "    end\n" ++
    "\n" ++
    "    # call-seq:\n" ++
    "    #   dump(object) -> String\n" ++
    "    #   dump(object, io) -> io\n" ++
    "    #\n" ++
    "    # Serialize the given object into a \\JSON document.\n" ++
    "    def dump(object, io = nil)\n" ++
    "      @state.generate(object, io)\n" ++
    "    end\n" ++
    "    alias_method :generate, :dump\n" ++
    "\n" ++
    "    # call-seq:\n" ++
    "    #   load(string) -> Object\n" ++
    "    #\n" ++
    "    # Parse the given \\JSON document and return an equivalent Ruby object.\n" ++
    "    def load(source)\n" ++
    "      @parser_config.parse(source)\n" ++
    "    end\n" ++
    "    alias_method :parse, :load\n" ++
    "\n" ++
    "    # call-seq:\n" ++
    "    #   load(path) -> Object\n" ++
    "    #\n" ++
    "    # Parse the given \\JSON document and return an equivalent Ruby object.\n" ++
    "    def load_file(path)\n" ++
    "      load(File.read(path, encoding: Encoding::UTF_8))\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n" ++
    "\n" ++
    "module ::Kernel\n" ++
    "  private\n" ++
    "\n" ++
    "  # Outputs _objs_ to STDOUT as JSON strings in the shortest form, that is in\n" ++
    "  # one line.\n" ++
    "  def j(*objs)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"Kernel#j is deprecated and will be removed in json 3.0.0\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"Kernel#j is deprecated and will be removed in json 3.0.0\", uplevel: 1\n" ++
    "    end\n" ++
    "\n" ++
    "    objs.each do |obj|\n" ++
    "      puts JSON.generate(obj, :allow_nan => true, :max_nesting => false)\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # Outputs _objs_ to STDOUT as JSON strings in a pretty format, with\n" ++
    "  # indentation and over many lines.\n" ++
    "  def jj(*objs)\n" ++
    "    if RUBY_VERSION >= \"3.0\"\n" ++
    "      warn \"Kernel#jj is deprecated and will be removed in json 3.0.0\", uplevel: 1, category: :deprecated\n" ++
    "    else\n" ++
    "      warn \"Kernel#jj is deprecated and will be removed in json 3.0.0\", uplevel: 1\n" ++
    "    end\n" ++
    "\n" ++
    "    objs.each do |obj|\n" ++
    "      puts JSON.pretty_generate(obj, :allow_nan => true, :max_nesting => false)\n" ++
    "    end\n" ++
    "    nil\n" ++
    "  end\n" ++
    "\n" ++
    "  # If _object_ is string-like, parse the string and return the parsed result as\n" ++
    "  # a Ruby data structure. Otherwise, generate a JSON text from the Ruby data\n" ++
    "  # structure object and return it.\n" ++
    "  #\n" ++
    "  # The _opts_ argument is passed through to generate/parse respectively. See\n" ++
    "  # generate and parse for their documentation.\n" ++
    "  def JSON(object, opts = nil)\n" ++
    "    JSON[object, opts]\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "json/ext" then
    "# frozen_string_literal: true\n" ++
    "\n" ++
    "require 'json/common'\n" ++
    "\n" ++
    "module JSON\n" ++
    "  # This module holds all the modules/classes that implement JSON's\n" ++
    "  # functionality as C extensions.\n" ++
    "  module Ext\n" ++
    "    class Parser\n" ++
    "      class << self\n" ++
    "        def parse(...)\n" ++
    "          new(...).parse\n" ++
    "        end\n" ++
    "        alias_method :parse, :parse # Allow redefinition by extensions\n" ++
    "      end\n" ++
    "\n" ++
    "      def initialize(source, opts = nil)\n" ++
    "        @source = source\n" ++
    "        @config = Config.new(opts)\n" ++
    "      end\n" ++
    "\n" ++
    "      def source\n" ++
    "        @source.dup\n" ++
    "      end\n" ++
    "\n" ++
    "      def parse\n" ++
    "        @config.parse(@source)\n" ++
    "      end\n" ++
    "    end\n" ++
    "\n" ++
    "    require 'json/ext/parser'\n" ++
    "    Ext::Parser::Config = Ext::ParserConfig\n" ++
    "    JSON.parser = Ext::Parser\n" ++
    "\n" ++
    "    if RUBY_ENGINE == 'truffleruby'\n" ++
    "      require 'json/truffle_ruby/generator'\n" ++
    "      JSON.generator = JSON::TruffleRuby::Generator\n" ++
    "    else\n" ++
    "      require 'json/ext/generator'\n" ++
    "      JSON.generator = Generator\n" ++
    "    end\n" ++
    "  end\n" ++
    "\n" ++
    "  JSON_LOADED = true unless defined?(JSON::JSON_LOADED)\n" ++
    "end\n"
  else if str_eq n "json/ext/generator/state" then
    "# frozen_string_literal: true\n" ++
    "\n" ++
    "module JSON\n" ++
    "  module Ext\n" ++
    "    module Generator\n" ++
    "      class State\n" ++
    "        # call-seq: new(opts = \{\})\n" ++
    "        #\n" ++
    "        # Instantiates a new State object, configured by _opts_.\n" ++
    "        #\n" ++
    "        # Argument +opts+, if given, contains a \\Hash of options for the generation.\n" ++
    "        # See \{Generating Options\}[#module-JSON-label-Generating+Options].\n" ++
    "        def initialize(opts = nil)\n" ++
    "          if opts && !opts.empty?\n" ++
    "            configure(opts)\n" ++
    "          end\n" ++
    "        end\n" ++
    "\n" ++
    "        # call-seq: configure(opts)\n" ++
    "        #\n" ++
    "        # Configure this State instance with the Hash _opts_, and return\n" ++
    "        # itself.\n" ++
    "        def configure(opts)\n" ++
    "          unless opts.is_a?(Hash)\n" ++
    "            if opts.respond_to?(:to_hash)\n" ++
    "              opts = opts.to_hash\n" ++
    "            elsif opts.respond_to?(:to_h)\n" ++
    "              opts = opts.to_h\n" ++
    "            else\n" ++
    "              raise TypeError, \"can't convert #\{opts.class\} into Hash\"\n" ++
    "            end\n" ++
    "          end\n" ++
    "          _configure(opts)\n" ++
    "        end\n" ++
    "\n" ++
    "        alias_method :merge, :configure\n" ++
    "\n" ++
    "        # call-seq: to_h\n" ++
    "        #\n" ++
    "        # Returns the configuration instance variables as a hash, that can be\n" ++
    "        # passed to the configure method.\n" ++
    "        def to_h\n" ++
    "          result = \{\n" ++
    "            indent: indent,\n" ++
    "            space: space,\n" ++
    "            space_before: space_before,\n" ++
    "            object_nl: object_nl,\n" ++
    "            array_nl: array_nl,\n" ++
    "            as_json: as_json,\n" ++
    "            allow_nan: allow_nan?,\n" ++
    "            ascii_only: ascii_only?,\n" ++
    "            max_nesting: max_nesting,\n" ++
    "            script_safe: script_safe?,\n" ++
    "            strict: strict?,\n" ++
    "            depth: depth,\n" ++
    "            buffer_initial_length: buffer_initial_length,\n" ++
    "          \}\n" ++
    "\n" ++
    "          allow_duplicate_key = allow_duplicate_key?\n" ++
    "          unless allow_duplicate_key.nil?\n" ++
    "            result[:allow_duplicate_key] = allow_duplicate_key\n" ++
    "          end\n" ++
    "\n" ++
    "          instance_variables.each do |iv|\n" ++
    "            iv = iv.to_s[1..-1]\n" ++
    "            result[iv.to_sym] = self[iv]\n" ++
    "          end\n" ++
    "\n" ++
    "          result\n" ++
    "        end\n" ++
    "\n" ++
    "        alias_method :to_hash, :to_h\n" ++
    "\n" ++
    "        # call-seq: [](name)\n" ++
    "        #\n" ++
    "        # Returns the value returned by method +name+.\n" ++
    "        def [](name)\n" ++
    "          ::JSON.deprecation_warning(\"JSON::State#[] is deprecated and will be removed in json 3.0.0\")\n" ++
    "\n" ++
    "          if respond_to?(name)\n" ++
    "            __send__(name)\n" ++
    "          else\n" ++
    "            instance_variable_get(\"@#\{name\}\") if\n" ++
    "              instance_variables.include?(\"@#\{name\}\".to_sym) # avoid warning\n" ++
    "          end\n" ++
    "        end\n" ++
    "\n" ++
    "        # call-seq: []=(name, value)\n" ++
    "        #\n" ++
    "        # Sets the attribute name to value.\n" ++
    "        def []=(name, value)\n" ++
    "          ::JSON.deprecation_warning(\"JSON::State#[]= is deprecated and will be removed in json 3.0.0\")\n" ++
    "\n" ++
    "          if respond_to?(name_writer = \"#\{name\}=\")\n" ++
    "            __send__ name_writer, value\n" ++
    "          else\n" ++
    "            instance_variable_set \"@#\{name\}\", value\n" ++
    "          end\n" ++
    "        end\n" ++
    "      end\n" ++
    "    end\n" ++
    "  end\n" ++
    "end\n"
  else if str_eq n "json/generic_object" then
    "# frozen_string_literal: true\n" ++
    "begin\n" ++
    "  require 'ostruct'\n" ++
    "rescue LoadError\n" ++
    "  warn \"JSON::GenericObject requires 'ostruct'. Please install it with `gem install ostruct`.\"\n" ++
    "end\n" ++
    "\n" ++
    "module JSON\n" ++
    "  class GenericObject < OpenStruct\n" ++
    "    class << self\n" ++
    "      alias [] new\n" ++
    "\n" ++
    "      def json_creatable?\n" ++
    "        @json_creatable\n" ++
    "      end\n" ++
    "\n" ++
    "      attr_writer :json_creatable\n" ++
    "\n" ++
    "      def json_create(data)\n" ++
    "        data = data.dup\n" ++
    "        data.delete JSON.create_id\n" ++
    "        self[data]\n" ++
    "      end\n" ++
    "\n" ++
    "      def from_hash(object)\n" ++
    "        case\n" ++
    "        when object.respond_to?(:to_hash)\n" ++
    "          result = new\n" ++
    "          object.to_hash.each do |key, value|\n" ++
    "            result[key] = from_hash(value)\n" ++
    "          end\n" ++
    "          result\n" ++
    "        when object.respond_to?(:to_ary)\n" ++
    "          object.to_ary.map \{ |a| from_hash(a) \}\n" ++
    "        else\n" ++
    "          object\n" ++
    "        end\n" ++
    "      end\n" ++
    "\n" ++
    "      def load(source, proc = nil, opts = \{\})\n" ++
    "        result = ::JSON.load(source, proc, opts.merge(:object_class => self))\n" ++
    "        result.nil? ? new : result\n" ++
    "      end\n" ++
    "\n" ++
    "      def dump(obj, *args)\n" ++
    "        ::JSON.dump(obj, *args)\n" ++
    "      end\n" ++
    "    end\n" ++
    "    self.json_creatable = false\n" ++
    "\n" ++
    "    def to_hash\n" ++
    "      table\n" ++
    "    end\n" ++
    "\n" ++
    "    def |(other)\n" ++
    "      self.class[other.to_hash.merge(to_hash)]\n" ++
    "    end\n" ++
    "\n" ++
    "    def as_json(*)\n" ++
    "      \{ JSON.create_id => self.class.name \}.merge to_hash\n" ++
    "    end\n" ++
    "\n" ++
    "    def to_json(*a)\n" ++
    "      as_json.to_json(*a)\n" ++
    "    end\n" ++
    "  end if defined?(::OpenStruct)\n" ++
    "end\n"
