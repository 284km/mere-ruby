    "  #   \{\"json_class\":\"Range\",\"a\":[1,4,true]\}\n" ++
    "  #   \{\"json_class\":\"Range\",\"a\":[\"a\",\"d\",false]\}\n" ++
    "  #\n" ++
    "  def to_json(*args)\n" ++
