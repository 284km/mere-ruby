    "\n" ++
    "  # See #as_json.\n" ++
    "  def self.json_create(object)\n" ++
    "    new(*object['v'])\n" ++
    "  end\n" ++
    "\n" ++
    "  # Methods <tt>Struct#as_json</tt> and +Struct.json_create+ may be used\n" ++
    "  # to serialize and deserialize a \\Struct object;\n" ++
