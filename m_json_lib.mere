    "#\n" ++
    "# Options +script_safe+ (boolean) specifies wether <tt>'\\u2028'</tt>, <tt>'\\u2029'</tt>\n" ++
    "# and <tt>'/'</tt> should be escaped as to make the JSON object safe to interpolate in script\n" ++
