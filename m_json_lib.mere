  else if str_eq n "json/add/string" then
    "# frozen_string_literal: true\n" ++
    "unless defined?(::JSON::JSON_LOADED) and ::JSON::JSON_LOADED\n" ++
    "  require 'json'\n" ++
    "end\n" ++
    "\n" ++
    "class String\n" ++
    "  # call-seq: json_create(o)\n" ++
    "  #\n" ++
    "  # Raw Strings are JSON Objects (the raw bytes are stored in an array for the\n" ++
    "  # key \"raw\"). The Ruby String can be created by this class method.\n" ++
    "  def self.json_create(object)\n" ++
    "    object[\"raw\"].pack(\"C*\")\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq: to_json_raw_object()\n" ++
    "  #\n" ++
    "  # This method creates a raw object hash, that can be nested into\n" ++
    "  # other data structures and will be generated as a raw string. This\n" ++
    "  # method should be used, if you want to convert raw strings to JSON\n" ++
    "  # instead of UTF-8 strings, e. g. binary data.\n" ++
    "  def to_json_raw_object\n" ++
    "    \{\n" ++
    "      JSON.create_id => self.class.name,\n" ++
    "      \"raw\" => unpack(\"C*\"),\n" ++
    "    \}\n" ++
    "  end\n" ++
    "\n" ++
    "  # call-seq: to_json_raw(*args)\n" ++
    "  #\n" ++
    "  # This method creates a JSON text from the result of a call to\n" ++
    "  # to_json_raw_object of this String.\n" ++
    "  def to_json_raw(...)\n" ++
    "    to_json_raw_object.to_json(...)\n" ++
    "  end\n" ++
    "end\n"
