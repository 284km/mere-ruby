    "  #   \{\"json_class\":\"BigDecimal\",\"b\":\"27:0.2e1\"\}\n" ++
    "  #\n" ++
    "  def to_json(*args)\n" ++
    "    as_json.to_json(*args)\n" ++
    "  end\n" ++
