    ++ "\n"
    ++ "  # Represents an optional parameter to a method, block, or lambda definition.\n"
    ++ "  #\n"
    ++ "  #     def a(b = 1)\n"
    ++ "  #           ^^^^^\n"
    ++ "  #     end\n"
    ++ "  class OptionalParameterNode < Node\n"
