    ++ "\n"
    ++ "  # Represents the use of the literal `false` keyword.\n"
    ++ "  #\n"
    ++ "  #     false\n"
    ++ "  #     ^^^^^\n"
    ++ "  class FalseNode < Node\n"
    ++ "    # Initialize a new FalseNode node.\n"
