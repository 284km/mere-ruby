    ++ "\n"
    ++ "module Prism\n"
    ++ "  module Translation\n"
    ++ "    # This class is the entry-point for converting a prism syntax tree into the\n"
    ++ "    # whitequark/parser gem's syntax tree. It inherits from the base parser for\n"
