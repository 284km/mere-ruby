    ++ "      def fields(value)\n"
    ++ "        \{ trailing_comments: comments(value.trailing_comments) \}\n"
    ++ "      end\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # A repository is a configured collection of fields and a set of entries\n"
    ++ "    # that knows how to reparse a source and reify the values.\n"
    ++ "    class Repository\n"
