// GENERATED by tools/gen_prism_lib.rb from the reference's lib/prism*
// (Prism 1.8.2) and lib/prism_ext.rb -- do not edit. Answered by
// prism_lib_src, which do_require asks after syslog_lib_src.

let prism_lib_src = fn (name: str) ->
  let n = (if ends_with_rb name then substring name 0 (str_len name - 3) else name) in
  if str_eq n "prism/prism" then
    "# frozen_string_literal: true\n"
    ++ "#\n"
    ++ "# Prism's C half, as mere-ruby answers `require \"prism/prism\"`.\n"
    ++ "#\n"
    ++ "# The reference's lib/prism.rb requires \"prism/prism\" -- the C extension\n"
    ++ "# (prism/extension.c), which builds the Prism::Node tree in C. mere-ruby\n"
    ++ "# cannot load a C extension; what it has instead is libprism itself\n"
    ++ "# (vendor/prism, Prism 1.8.2, the copy Ruby 4.0.9 ships) reached through\n"
    ++ "# five externs (tools/prism_glue.c), each returning the parser's SERIALIZED\n"
    ++ "# answer. Prism's own Ruby library reads that format (lib/prism/serialize.rb),\n"
    ++ "# which is exactly how its FFI backend (lib/prism/ffi.rb) works on other\n"
    ++ "# implementations; this file is that backend with Mere's bytes in place of\n"
    ++ "# FFI::MemoryPointer, and without the ffi gem.\n"
    ++ "#\n"
    ++ "# Prism.__prism_ser(kind, source, options) -> String   the serialized parse (0),\n"
    ++ "#                                                      lex (1), comments (2) or\n"
    ++ "#                                                      parse_lex (3)\n"
    ++ "# Prism.__prism_ok(source, options)        -> true/false  parse_success?\n"
    ++ "# Prism.__prism_more(source, options)      -> true/false  parse_stream's \"read more\"\n"
    ++ "# Prism.__prism_query(kind, s, encoding)   -> -1/0/1      StringQuery\n"
    ++ "# Prism.__prism_version                    -> String\n"
    ++ "#\n"
    ++ "# `options` is the packed string Prism's FFI backend builds (dump_options\n"
    ++ "# below, verbatim from ffi.rb), the format pm_options_read reads.\n"
    ++ "\n"
    ++ "module Prism\n"
    ++ "  # (see Prism.serialize below)\n"
    ++ "  class ByteReader # :nodoc:\n"
    ++ "    attr_accessor :pos\n"
    ++ "\n"
    ++ "    def initialize(string)\n"
    ++ "      @string = string\n"
    ++ "      @pos = 0\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def getbyte\n"
    ++ "      byte = @string.getbyte(@pos)\n"
    ++ "      @pos += 1\n"
    ++ "      byte\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def read(n)\n"
    ++ "      slice = @string.byteslice(@pos, n)\n"
    ++ "      @pos += n\n"
    ++ "      slice\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def eof?\n"
    ++ "      @pos >= @string.bytesize\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  module LoaderBytes # :nodoc:\n"
    ++ "    def initialize(source, serialized)\n"
    ++ "      super\n"
    ++ "      @io = ByteReader.new(serialized)\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "  private_constant :ByteReader, :LoaderBytes\n"
    ++ "\n"
    ++ "  # The version constant is set by reading the result of calling pm_version.\n"
    ++ "  VERSION = Prism.__prism_version.freeze\n"
    ++ "\n"
    ++ "  class << self\n"
    ++ "    # Mirror the Prism.dump API by using the serialization API.\n"
    ++ "    def dump(source, **options)\n"
    ++ "      dump_common(check_string(source), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.dump_file API by using the serialization API.\n"
    ++ "    def dump_file(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      dump_common(read_file(filepath), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.lex API by using the serialization API.\n"
    ++ "    def lex(code, **options)\n"
    ++ "      lex_common(check_string(code), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.lex_file API by using the serialization API.\n"
    ++ "    def lex_file(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      lex_common(read_file(filepath), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse API by using the serialization API.\n"
    ++ "    def parse(code, **options)\n"
    ++ "      parse_common(check_string(code), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_file API by using the serialization API.\n"
    ++ "    def parse_file(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      parse_common(read_file(filepath), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_stream API. pm_parse_stream reads the stream a\n"
    ++ "    # line at a time (gets(4095), as the extension's fgets callback does),\n"
    ++ "    # stops at an `__END__` line, parses, and reads on only while the parser\n"
    ++ "    # still wants more -- an unterminated string or regexp whose body holds\n"
    ++ "    # that `__END__`, or an unterminated heredoc (Prism.__prism_more). So\n"
    ++ "    # `__END__` outside a literal leaves the rest of the stream unread, as\n"
    ++ "    # DATA needs it to be.\n"
    ++ "    def parse_stream(stream, **options)\n"
    ++ "      packed = dump_options(options)\n"
    ++ "      source = +\"\"\n"
    ++ "      eof = read_stream(stream, source)\n"
    ++ "      until eof || !Prism.__prism_more(source, packed)\n"
    ++ "        eof = read_stream(stream, source)\n"
    ++ "      end\n"
    ++ "      Prism.load(source, Prism.__prism_ser(0, source, packed), options.fetch(:freeze, false))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_comments API by using the serialization API.\n"
    ++ "    def parse_comments(code, **options)\n"
    ++ "      parse_comments_common(check_string(code), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_file_comments API by using the serialization\n"
    ++ "    # API.\n"
    ++ "    def parse_file_comments(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      parse_comments_common(read_file(filepath), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_lex API by using the serialization API.\n"
    ++ "    def parse_lex(code, **options)\n"
    ++ "      parse_lex_common(check_string(code), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_lex_file API by using the serialization API.\n"
    ++ "    def parse_lex_file(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      parse_lex_common(read_file(filepath), options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_success? API by using the serialization API.\n"
    ++ "    def parse_success?(code, **options)\n"
    ++ "      Prism.__prism_ok(check_string(code), dump_options(options))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_failure? API by using the serialization API.\n"
    ++ "    def parse_failure?(code, **options)\n"
    ++ "      !parse_success?(code, **options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_file_success? API by using the serialization API.\n"
    ++ "    def parse_file_success?(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      Prism.__prism_ok(read_file(filepath), dump_options(options))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.parse_file_failure? API by using the serialization API.\n"
    ++ "    def parse_file_failure?(filepath, **options)\n"
    ++ "      !parse_file_success?(filepath, **options)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.profile API by using the serialization API.\n"
    ++ "    def profile(source, **options)\n"
    ++ "      Prism.__prism_ser(0, check_string(source), dump_options(options))\n"
    ++ "      nil\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Mirror the Prism.profile_file API by using the serialization API.\n"
    ++ "    def profile_file(filepath, **options)\n"
    ++ "      options[:filepath] = filepath\n"
    ++ "      Prism.__prism_ser(0, read_file(filepath), dump_options(options))\n"
    ++ "      nil\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    private\n"
    ++ "\n"
    ++ "    # The extension's check_string.\n"
    ++ "    def check_string(value)\n"
    ++ "      raise TypeError, \"wrong argument type #\{value.class\} (expected String)\" unless value.is_a?(String)\n"
    ++ "      value\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # pm_string_mapped_init: the file's bytes; a directory is EISDIR and any\n"
    ++ "    # other failure its errno, raised as the extension raises it --\n"
    ++ "    # `SystemCallError.new(filepath, errno)`, whose message is\n"
    ++ "    # \"No such file or directory - idontexist.rb\" with no \"@ rb_sysopen\".\n"
    ++ "    def read_file(filepath)\n"
    ++ "      raise TypeError, \"wrong argument type #\{filepath.class\} (expected String)\" unless filepath.is_a?(String)\n"
    ++ "      File.binread(filepath)\n"
    ++ "    rescue SystemCallError => e\n"
    ++ "      raise SystemCallError.new(filepath, e.errno)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # pm_parse_stream_read: append lines until the stream ends (true) or an\n"
    ++ "    # `__END__` line has been appended (false). A 4095-byte piece is a line\n"
    ++ "    # longer than fgets' buffer, read on without the `__END__` check.\n"
    ++ "    def read_stream(stream, source)\n"
    ++ "      loop do\n"
    ++ "        line = stream.gets(4095)\n"
    ++ "        return true if line.nil?\n"
    ++ "        source << line\n"
    ++ "        next if line.bytesize == 4095\n"
    ++ "        case line\n"
    ++ "        when \"__END__\", \"__END__\\n\", \"__END__\\r\\n\"\n"
    ++ "          return false\n"
    ++ "        end\n"
    ++ "        return true if stream.eof?\n"
    ++ "      end\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Prism's Loader reads the serialized bytes through StringIO, one #getbyte\n"
    ++ "    # per byte (serialize.rb's FastStringIO is ::StringIO on every engine but\n"
    ++ "    # TruffleRuby), and StringIO#getbyte here is half a dozen method calls on\n"
    ++ "    # the state a dup shares. Those reads were 3 of the 5.5 s Prism.parse\n"
    ++ "    # took on mkmf.rb (10,907 nodes). The Loader is given the bare reader\n"
    ++ "    # TruffleRuby's branch of serialize.rb writes instead, once, when the\n"
    ++ "    # first load needs Serialize.\n"
    ++ "    def serialize # :nodoc:\n"
    ++ "      @__serialize ||= Serialize.tap \{ |s| s.const_get(:Loader).prepend(LoaderBytes) \}\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def dump_common(string, options) # :nodoc:\n"
    ++ "      dumped = Prism.__prism_ser(0, string, dump_options(options))\n"
    ++ "      dumped.freeze if options.fetch(:freeze, false)\n"
    ++ "      dumped\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def lex_common(code, options) # :nodoc:\n"
    ++ "      serialize.load_lex(code, Prism.__prism_ser(1, code, dump_options(options)), options.fetch(:freeze, false))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def parse_common(code, options) # :nodoc:\n"
    ++ "      serialize.load_parse(code, dump_common(code, options), options.fetch(:freeze, false))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def parse_comments_common(code, options) # :nodoc:\n"
    ++ "      serialize.load_parse_comments(code, Prism.__prism_ser(2, code, dump_options(options)), options.fetch(:freeze, false))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def parse_lex_common(code, options) # :nodoc:\n"
    ++ "      serialize.load_parse_lex(code, Prism.__prism_ser(3, code, dump_options(options)), options.fetch(:freeze, false))\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Return the value that should be dumped for the command_line option.\n"
    ++ "    def dump_options_command_line(options)\n"
    ++ "      command_line = options.fetch(:command_line, \"\")\n"
    ++ "      raise ArgumentError, \"command_line must be a string\" unless command_line.is_a?(String)\n"
    ++ "\n"
    ++ "      command_line.each_char.inject(0) do |value, char|\n"
    ++ "        case char\n"
    ++ "        when \"a\" then value | 0b000001\n"
    ++ "        when \"e\" then value | 0b000010\n"
    ++ "        when \"l\" then value | 0b000100\n"
    ++ "        when \"n\" then value | 0b001000\n"
    ++ "        when \"p\" then value | 0b010000\n"
    ++ "        when \"x\" then value | 0b100000\n"
    ++ "        else raise ArgumentError, \"invalid command_line option: #\{char\}\"\n"
    ++ "        end\n"
    ++ "      end\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Return the value that should be dumped for the version option.\n"
    ++ "    def dump_options_version(version)\n"
    ++ "      current = version == \"current\"\n"
    ++ "\n"
    ++ "      case current ? RUBY_VERSION : version\n"
    ++ "      when nil, \"latest\"\n"
    ++ "        0 # Handled in pm_parser_init\n"
    ++ "      when /\\A3\\.3(\\.\\d+)?\\z/\n"
    ++ "        1\n"
    ++ "      when /\\A3\\.4(\\.\\d+)?\\z/\n"
    ++ "        2\n"
    ++ "      when /\\A3\\.5(\\.\\d+)?\\z/, /\\A4\\.0(\\.\\d+)?\\z/\n"
    ++ "        3\n"
    ++ "      when /\\A4\\.1(\\.\\d+)?\\z/\n"
    ++ "        4\n"
    ++ "      else\n"
    ++ "        if current\n"
    ++ "          raise CurrentVersionError, RUBY_VERSION\n"
    ++ "        else\n"
    ++ "          raise ArgumentError, \"invalid version: #\{version\}\"\n"
    ++ "        end\n"
    ++ "      end\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Convert the given options into a serialized options string.\n"
    ++ "    def dump_options(options)\n"
    ++ "      template = +\"\"\n"
    ++ "      values = []\n"
    ++ "\n"
    ++ "      template << \"L\"\n"
    ++ "      if (filepath = options[:filepath])\n"
    ++ "        values.push(filepath.bytesize, filepath.b)\n"
    ++ "        template << \"A*\"\n"
    ++ "      else\n"
    ++ "        values << 0\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      template << \"l\"\n"
    ++ "      values << options.fetch(:line, 1)\n"
    ++ "\n"
    ++ "      template << \"L\"\n"
    ++ "      if (encoding = options[:encoding])\n"
    ++ "        name = encoding.is_a?(Encoding) ? encoding.name : encoding\n"
    ++ "        values.push(name.bytesize, name.b)\n"
    ++ "        template << \"A*\"\n"
    ++ "      else\n"
    ++ "        values << 0\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << (options.fetch(:frozen_string_literal, false) ? 1 : 0)\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << dump_options_command_line(options)\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << dump_options_version(options[:version])\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << (options[:encoding] == false ? 1 : 0)\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << (options.fetch(:main_script, false) ? 1 : 0)\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << (options.fetch(:partial_script, false) ? 1 : 0)\n"
    ++ "\n"
    ++ "      template << \"C\"\n"
    ++ "      values << (options.fetch(:freeze, false) ? 1 : 0)\n"
    ++ "\n"
    ++ "      template << \"L\"\n"
    ++ "      if (scopes = options[:scopes])\n"
    ++ "        values << scopes.length\n"
    ++ "\n"
    ++ "        scopes.each do |scope|\n"
    ++ "          locals = nil\n"
    ++ "          forwarding = 0\n"
    ++ "\n"
    ++ "          case scope\n"
    ++ "          when Array\n"
    ++ "            locals = scope\n"
    ++ "          when Scope\n"
    ++ "            locals = scope.locals\n"
    ++ "\n"
    ++ "            scope.forwarding.each do |forward|\n"
    ++ "              case forward\n"
    ++ "              when :*     then forwarding |= 0x1\n"
    ++ "              when :**    then forwarding |= 0x2\n"
    ++ "              when :&     then forwarding |= 0x4\n"
    ++ "              when :\"...\" then forwarding |= 0x8\n"
    ++ "              else raise ArgumentError, \"invalid forwarding value: #\{forward\}\"\n"
    ++ "              end\n"
    ++ "            end\n"
    ++ "          else\n"
    ++ "            raise TypeError, \"wrong argument type #\{scope.class.inspect\} (expected Array or Prism::Scope)\"\n"
    ++ "          end\n"
    ++ "\n"
    ++ "          template << \"L\"\n"
    ++ "          values << locals.length\n"
    ++ "\n"
    ++ "          template << \"C\"\n"
    ++ "          values << forwarding\n"
    ++ "\n"
    ++ "          locals.each do |local|\n"
    ++ "            name = local.name\n"
    ++ "            template << \"L\"\n"
    ++ "            values << name.bytesize\n"
    ++ "\n"
    ++ "            template << \"A*\"\n"
    ++ "            values << name.b\n"
    ++ "          end\n"
    ++ "        end\n"
    ++ "      else\n"
    ++ "        values << 0\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      values.pack(template)\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # The class-level methods the extension puts on StringQuery (the instance\n"
    ++ "  # side is prism/string_query.rb, autoloaded by prism.rb).\n"
    ++ "  class StringQuery\n"
    ++ "    class << self\n"
    ++ "      # Mirrors the C extension's StringQuery::local? method.\n"
    ++ "      def local?(string)\n"
    ++ "        query(0, string)\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      # Mirrors the C extension's StringQuery::constant? method.\n"
    ++ "      def constant?(string)\n"
    ++ "        query(1, string)\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      # Mirrors the C extension's StringQuery::method_name? method.\n"
    ++ "      def method_name?(string)\n"
    ++ "        query(2, string)\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      private\n"
    ++ "\n"
    ++ "      # Ask libprism and turn its enum into the boolean or the error.\n"
    ++ "      def query(kind, string)\n"
    ++ "        raise TypeError, \"wrong argument type #\{string.class\} (expected String)\" unless string.is_a?(String)\n"
    ++ "\n"
    ++ "        case Prism.__prism_query(kind, string, string.encoding.name)\n"
    ++ "        when -1\n"
    ++ "          raise ArgumentError, \"Invalid or non ascii-compatible encoding\"\n"
    ++ "        when 0\n"
    ++ "          false\n"
    ++ "        else\n"
    ++ "          true\n"
    ++ "        end\n"
    ++ "      end\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # RubyVM::AbstractSyntaxTree.node_id_for_backtrace_location, which is how\n"
    ++ "  # error_highlight finds the node a frame was running (its prism_find parses\n"
    ++ "  # the file and looks for this id). ruby reads the id off the instruction the\n"
    ++ "  # frame stopped at; here there is no Prism node behind the evaluator and no\n"
    ++ "  # column in a frame, so the node is picked from the file's Prism tree: among\n"
    ++ "  # the calls (and the constants, the operator writes, the defs) the line\n"
    ++ "  # holds, the one named for the call the frame was making -- @__callee on the\n"
    ++ "  # Location, which Exception#backtrace_locations writes: the method of the\n"
    ++ "  # frame inside it, or the innermost frame's NameError name. A frame named\n"
    ++ "  # like a def on its line is that def (an ArgumentError's callee). With no\n"
    ++ "  # name to go by, the line's only call. -1 when there is no file, and when\n"
    ++ "  # more than one node answers: the line and a name do not tell two calls of\n"
    ++ "  # one name apart.\n"
    ++ "  class << self\n"
    ++ "    def __node_id_for_location(loc) # :nodoc:\n"
    ++ "      path = loc.absolute_path\n"
    ++ "      return -1 unless path && File.file?(path)\n"
    ++ "      stat = File.stat(path)\n"
    ++ "      key = [path, stat.mtime, stat.size]\n"
    ++ "      @__nid_tree = [key, parse_file(path).value] unless @__nid_tree && @__nid_tree[0] == key\n"
    ++ "      line = loc.lineno\n"
    ++ "      cands = []\n"
    ++ "      __nid_walk(@__nid_tree[1], line, cands)\n"
    ++ "      want = loc.instance_variable_get(:@__callee)\n"
    ++ "      own = loc.base_label.to_s.to_sym\n"
    ++ "      tiers =\n"
    ++ "        if want == :\"(entry)\"\n"
    ++ "          # (the frame an ArgumentError of the arguments was raised entering:\n"
    ++ "          #  the def, or the lambda / block define_method was given)\n"
    ++ "          [cands.select \{ |n| n.type == :def_node && n.name == own \},\n"
    ++ "           cands.select \{ |n| n.type == :lambda_node || n.type == :block_node \}]\n"
    ++ "        else\n"
    ++ "          [want ? cands.select \{ |n| __nid_call?(n) && __nid_names(n).include?(want) \} : [],\n"
    ++ "           # (a method written in C has a frame of its own, on its caller's\n"
    ++ "           #  line, named for the method: Integer#+)\n"
    ++ "           cands.select \{ |n| __nid_call?(n) && __nid_names(n).include?(own) \},\n"
    ++ "           cands.select \{ |n| n.type == :call_node \},\n"
    ++ "           cands.select \{ |n| __nid_call?(n) \}]\n"
    ++ "        end\n"
    ++ "      # (the first way of asking that finds anything decides, and it must\n"
    ++ "      #  find ONE: `'a'.upcase; nil.upcase` has two calls named upcase on\n"
    ++ "      #  the line, and which one raised is not known here -- -1, no node,\n"
    ++ "      #  rather than a call that succeeded)\n"
    ++ "      found = tiers.find \{ |t| !t.empty? \}\n"
    ++ "      # (...but an operator write and the constant path it writes are one\n"
    ++ "      #  construct, not two calls: `::X += 1` answers the write, as ruby's id\n"
    ++ "      #  does)\n"
    ++ "      if found && found.size > 1\n"
    ++ "        targets = found.filter_map \{ |n| n.target.node_id if n.respond_to?(:target) \}\n"
    ++ "        found = found.reject \{ |n| targets.include?(n.node_id) \}\n"
    ++ "      end\n"
    ++ "      found && found.size == 1 ? found[0].node_id : -1\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    private\n"
    ++ "\n"
    ++ "    NID_TYPES = %i[call_node call_operator_write_node call_and_write_node call_or_write_node\n"
    ++ "                   index_operator_write_node index_and_write_node index_or_write_node\n"
    ++ "                   local_variable_operator_write_node instance_variable_operator_write_node\n"
    ++ "                   global_variable_operator_write_node class_variable_operator_write_node\n"
    ++ "                   constant_read_node constant_path_node constant_operator_write_node\n"
    ++ "                   constant_path_operator_write_node def_node lambda_node block_node].freeze\n"
    ++ "    private_constant :NID_TYPES\n"
    ++ "\n"
    ++ "    # (children first: the order the line's calls are evaluated in. A call\n"
    ++ "    #  is on the line of its name, as ruby numbers it, or -- as this\n"
    ++ "    #  interpreter numbers a call whose receiver is on an earlier line --\n"
    ++ "    #  on the line it starts on)\n"
    ++ "    def __nid_walk(node, line, out)\n"
    ++ "      node.compact_child_nodes.each \{ |child| __nid_walk(child, line, out) \}\n"
    ++ "      return unless NID_TYPES.include?(node.type)\n"
    ++ "      loc = (node.respond_to?(:message_loc) && node.message_loc) || node.location\n"
    ++ "      out << node if loc.start_line == line || node.location.start_line == line\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    def __nid_call?(node)\n"
    ++ "      node.type != :def_node && node.type != :lambda_node && node.type != :block_node\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # The method names a node calls.\n"
    ++ "    def __nid_names(node)\n"
    ++ "      case node.type\n"
    ++ "      when :call_node, :constant_read_node, :constant_path_node, :def_node then [node.name]\n"
    ++ "      when :call_operator_write_node then [node.read_name, node.write_name, node.binary_operator]\n"
    ++ "      when :call_and_write_node, :call_or_write_node then [node.read_name, node.write_name]\n"
    ++ "      when :index_operator_write_node then [:[], :[]=, node.binary_operator]\n"
    ++ "      when :index_and_write_node, :index_or_write_node then [:[], :[]=]\n"
    ++ "      when :constant_operator_write_node then [node.name, node.binary_operator]\n"
    ++ "      when :constant_path_operator_write_node then [node.target.name, node.binary_operator]\n"
    ++ "      else [node.binary_operator]\n"
    ++ "      end\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "end\n"
  else if str_eq n "prism" then
    "# frozen_string_literal: true\n"
    ++ "# :markup: markdown\n"
    ++ "\n"
    ++ "# The Prism Ruby parser.\n"
    ++ "#\n"
    ++ "# \"Parsing Ruby is suddenly manageable!\"\n"
    ++ "#   - You, hopefully\n"
    ++ "#\n"
    ++ "module Prism\n"
    ++ "  # There are many files in prism that are templated to handle every node type,\n"
    ++ "  # which means the files can end up being quite large. We autoload them to make\n"
    ++ "  # our require speed faster since consuming libraries are unlikely to use all\n"
    ++ "  # of these features.\n"
    ++ "\n"
    ++ "  autoload :BasicVisitor, \"prism/visitor\"\n"
    ++ "  autoload :Compiler, \"prism/compiler\"\n"
    ++ "  autoload :DesugarCompiler, \"prism/desugar_compiler\"\n"
    ++ "  autoload :Dispatcher, \"prism/dispatcher\"\n"
    ++ "  autoload :DotVisitor, \"prism/dot_visitor\"\n"
    ++ "  autoload :DSL, \"prism/dsl\"\n"
    ++ "  autoload :InspectVisitor, \"prism/inspect_visitor\"\n"
    ++ "  autoload :LexCompat, \"prism/lex_compat\"\n"
    ++ "  autoload :LexRipper, \"prism/lex_ripper\"\n"
    ++ "  autoload :MutationCompiler, \"prism/mutation_compiler\"\n"
    ++ "  autoload :Pack, \"prism/pack\"\n"
    ++ "  autoload :Pattern, \"prism/pattern\"\n"
    ++ "  autoload :Reflection, \"prism/reflection\"\n"
    ++ "  autoload :Relocation, \"prism/relocation\"\n"
    ++ "  autoload :Serialize, \"prism/serialize\"\n"
    ++ "  autoload :StringQuery, \"prism/string_query\"\n"
    ++ "  autoload :Translation, \"prism/translation\"\n"
    ++ "  autoload :Visitor, \"prism/visitor\"\n"
    ++ "\n"
    ++ "  # Some of these constants are not meant to be exposed, so marking them as\n"
    ++ "  # private here.\n"
    ++ "\n"
    ++ "  private_constant :LexCompat\n"
    ++ "  private_constant :LexRipper\n"
    ++ "\n"
    ++ "  # Raised when requested to parse as the currently running Ruby version but Prism has no support for it.\n"
    ++ "  class CurrentVersionError < ArgumentError\n"
    ++ "    # Initialize a new exception for the given ruby version string.\n"
    ++ "    def initialize(version)\n"
    ++ "      message = +\"invalid version: Requested to parse as `version: 'current'`; \"\n"
    ++ "      segments =\n"
    ++ "        if version.match?(/\\A\\d+\\.\\d+.\\d+\\z/)\n"
    ++ "          version.split(\".\").map(&:to_i)\n"
    ++ "        end\n"
    ++ "\n"
    ++ "      if segments && ((segments[0] < 3) || (segments[0] == 3 && segments[1] < 3))\n"
    ++ "        message << \" #\{version\} is below the minimum supported syntax.\"\n"
    ++ "      else\n"
    ++ "        message << \" #\{version\} is unknown. Please update the `prism` gem.\"\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      super(message)\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # :call-seq:\n"
    ++ "  #   Prism::lex_compat(source, **options) -> LexCompat::Result\n"
    ++ "  #\n"
    ++ "  # Returns a parse result whose value is an array of tokens that closely\n"
    ++ "  # resembles the return value of Ripper::lex. The main difference is that the\n"
    ++ "  # `:on_sp` token is not emitted.\n"
    ++ "  #\n"
    ++ "  # For supported options, see Prism::parse.\n"
    ++ "  def self.lex_compat(source, **options)\n"
    ++ "    LexCompat.new(source, **options).result # steep:ignore\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # :call-seq:\n"
    ++ "  #   Prism::lex_ripper(source) -> Array\n"
    ++ "  #\n"
    ++ "  # This lexes with the Ripper lex. It drops any space events but otherwise\n"
    ++ "  # returns the same tokens. Raises SyntaxError if the syntax in source is\n"
    ++ "  # invalid.\n"
    ++ "  def self.lex_ripper(source)\n"
    ++ "    LexRipper.new(source).result # steep:ignore\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # :call-seq:\n"
    ++ "  #   Prism::load(source, serialized, freeze) -> ParseResult\n"
    ++ "  #\n"
    ++ "  # Load the serialized AST using the source as a reference into a tree.\n"
    ++ "  def self.load(source, serialized, freeze = false)\n"
    ++ "    Serialize.load_parse(source, serialized, freeze)\n"
    ++ "  end\n"
    ++ "end\n"
    ++ "\n"
    ++ "require_relative \"prism/polyfill/byteindex\"\n"
    ++ "require_relative \"prism/polyfill/warn\"\n"
    ++ "require_relative \"prism/node\"\n"
    ++ "require_relative \"prism/node_ext\"\n"
    ++ "require_relative \"prism/parse_result\"\n"
    ++ "\n"
    ++ "# This is a Ruby implementation of the prism parser. If we're running on CRuby\n"
    ++ "# and we haven't explicitly set the PRISM_FFI_BACKEND environment variable, then\n"
    ++ "# it's going to require the built library. Otherwise, it's going to require a\n"
