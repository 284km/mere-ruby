    ++ "        posts.zip(other.posts).all? \{ |left, right| left === right \} &&\n"
    ++ "        (opening_loc.nil? == other.opening_loc.nil?) &&\n"
    ++ "        (closing_loc.nil? == other.closing_loc.nil?)\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # Represents a hash key/value pair.\n"
    ++ "  #\n"
    ++ "  #     \{ a => b \}\n"
    ++ "  #       ^^^^^^\n"
    ++ "  class AssocNode < Node\n"
    ++ "    # Initialize a new AssocNode node.\n"
    ++ "    def initialize(source, node_id, location, flags, key, value, operator_loc)\n"
    ++ "      @source = source\n"
    ++ "      @node_id = node_id\n"
    ++ "      @location = location\n"
    ++ "      @flags = flags\n"
    ++ "      @key = key\n"
    ++ "      @value = value\n"
    ++ "      @operator_loc = operator_loc\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # def accept: (Visitor visitor) -> void\n"
    ++ "    def accept(visitor)\n"
    ++ "      visitor.visit_assoc_node(self)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # def child_nodes: () -> Array[Node?]\n"
    ++ "    def child_nodes\n"
    ++ "      [key, value]\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # def each_child_node: () \{ (Prism::node) -> void \} -> void | () -> Enumerator[Prism::node]\n"
