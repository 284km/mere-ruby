    ++ "  #         array_node(\n"
    ++ "  #           location: location(start_offset: 0, length: 3),\n"
    ++ "  #           elements: [\n"
    ++ "  #             integer_node(\n"
    ++ "  #               location: location(start_offset: 1, length: 1),\n"
    ++ "  #               flags: integer_base_flag(:decimal),\n"
    ++ "  #               value: 1\n"
    ++ "  #             )\n"
    ++ "  #           ],\n"
