    ++ "      end\n"
    ++ "\n"
    ++ "      # The default encoding for Ruby files is UTF-8.\n"
    ++ "      def default_encoding\n"
    ++ "        Encoding::UTF_8\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      def yyerror # :nodoc:\n"
