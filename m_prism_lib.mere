    ++ "  #     ^^^^^^^^^^^\n"
    ++ "  #\n"
    ++ "  #     foo in Bar[]\n"
    ++ "  #     ^^^^^^^^^^^^\n"
    ++ "  #\n"
    ++ "  #     foo in Bar[1, 2, 3]\n"
    ++ "  #     ^^^^^^^^^^^^^^^^^^^\n"
    ++ "  class ArrayPatternNode < Node\n"
    ++ "    # Initialize a new ArrayPatternNode node.\n"
    ++ "    def initialize(source, node_id, location, flags, constant, requireds, rest, posts, opening_loc, closing_loc)\n"
    ++ "      @source = source\n"
    ++ "      @node_id = node_id\n"
    ++ "      @location = location\n"
    ++ "      @flags = flags\n"
    ++ "      @constant = constant\n"
    ++ "      @requireds = requireds\n"
    ++ "      @rest = rest\n"
    ++ "      @posts = posts\n"
