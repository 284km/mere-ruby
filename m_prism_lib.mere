    ++ "    def copy(node_id: self.node_id, location: self.location, flags: self.flags)\n"
    ++ "      FalseNode.new(source, node_id, location, flags)\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # def deconstruct: () -> Array[Node?]\n"
    ++ "    alias deconstruct child_nodes\n"
