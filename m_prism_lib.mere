    ++ "    def deconstruct_keys(keys)\n"
    ++ "      \{ node_id: node_id, location: location, ensure_keyword_loc: ensure_keyword_loc, statements: statements, end_keyword_loc: end_keyword_loc \}\n"
    ++ "    end\n"
