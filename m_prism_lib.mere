    ++ "      listeners[:on_and_node_enter]&.each \{ |listener| listener.on_and_node_enter(node) \}\n"
    ++ "      super\n"
    ++ "      listeners[:on_and_node_leave]&.each \{ |listener| listener.on_and_node_leave(node) \}\n"
    ++ "    end\n"
    ++ "\n"
