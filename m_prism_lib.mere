    ++ "        when :argument_no_forwarding_star_star\n"
    ++ "          Diagnostic.new(:error, :no_anonymous_kwrestarg, \{\}, diagnostic_location, [])\n"
    ++ "        when :begin_lonely_else\n"
    ++ "          location = location.copy(length: 4)\n"
