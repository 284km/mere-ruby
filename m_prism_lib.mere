    ++ "          offset = 0\n"
    ++ "\n"
    ++ "          source.each_char do |char|\n"
    ++ "            char.bytesize.times \{ offset_cache << offset \}\n"
    ++ "            offset += 1\n"
    ++ "          end\n"
    ++ "\n"
    ++ "          offset_cache << offset\n"
    ++ "        end\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      # Build the parser gem AST from the prism AST.\n"
    ++ "      def build_ast(program, offset_cache)\n"
    ++ "        program.accept(Compiler.new(self, offset_cache))\n"
    ++ "      end\n"
    ++ "\n"
