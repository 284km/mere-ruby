    ++ "      @location = location\n"
    ++ "      @flags = flags\n"
    ++ "      @name = name\n"
    ++ "      @name_loc = name_loc\n"
    ++ "      @value = value\n"
    ++ "      @operator_loc = operator_loc\n"
