    ++ "    end\n"
    ++ "\n"
    ++ "    # The list of arguments, if present. These can be any [non-void expressions](https://github.com/ruby/prism/blob/main/docs/parsing_rules.md#non-void-expression).\n"
    ++ "    #\n"
