    ++ "\n"
    ++ "    # def deconstruct_keys: (Array[Symbol] keys) -> \{ node_id: Integer, location: Location, begin_keyword_loc: Location?, statements: StatementsNode?, rescue_clause: RescueNode?, else_clause: ElseNode?, ensure_clause: EnsureNode?, end_keyword_loc: Location? \}\n"
