    ++ "\n"
    ++ "    # The left-hand side of the range, if present. It can be either `nil` or any [non-void expression](https://github.com/ruby/prism/blob/main/docs/parsing_rules.md#non-void-expression).\n"
    ++ "    #\n"
    ++ "    #     1...\n"
