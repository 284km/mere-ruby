    ++ "          case tok\n"
    ++ "          when /\\w/\n"
    ++ "            buf.concat map_token(tok)\n"
    ++ "          when \"$(\"\n"
    ++ "            buf.concat \"(\"\n"
    ++ "          when \"(\"\n"
    ++ "            buf.concat \"(?:\"\n"
