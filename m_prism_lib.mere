  else if str_eq n "prism/translation/parser" then
    "# frozen_string_literal: true\n"
    ++ "# :markup: markdown\n"
    ++ "\n"
    ++ "begin\n"
    ++ "  required_version = \">= 3.3.7.2\"\n"
    ++ "  gem \"parser\", required_version\n"
    ++ "  require \"parser\"\n"
    ++ "rescue LoadError\n"
