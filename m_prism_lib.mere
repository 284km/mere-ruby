    ++ "      location\n"
    ++ "      super\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # Freeze this object and the objects it contains.\n"
    ++ "    def deep_freeze\n"
    ++ "      value.freeze\n"
    ++ "      location.freeze\n"
    ++ "      freeze\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # This object is passed to the various Prism.* methods that accept the\n"
