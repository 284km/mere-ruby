    ++ "\n"
    ++ "    # The value of the association, if present. This can be any [non-void expression](https://github.com/ruby/prism/blob/main/docs/parsing_rules.md#non-void-expression).\n"
    ++ "    #\n"
    ++ "    #     \{ foo => bar \}\n"
