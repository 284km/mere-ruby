    ++ "      flags = [(\"newline\" if node.newline?), (\"static_literal\" if node.static_literal?), ].compact\n"
    ++ "      commands << [\"├── flags: #\{flags.empty? ? \"∅\" : flags.join(\", \")\}\\n\", indent]\n"
