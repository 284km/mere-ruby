    ++ "  end\n"
    ++ "\n"
    ++ "  # Represents an array literal. This can be a regular array using brackets or a special array using % like %w or %i.\n"
    ++ "  #\n"
    ++ "  #     [1, 2, 3]\n"
    ++ "  #     ^^^^^^^^^\n"
    ++ "  class ArrayNode < Node\n"
