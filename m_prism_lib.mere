    ++ "  #     a, b, c = 1, 2, 3\n"
    ++ "  #     ^^^^^^^^^^^^^^^^^\n"
    ++ "  class MultiWriteNode < Node\n"
    ++ "    # Initialize a new MultiWriteNode node.\n"
    ++ "    def initialize(source, node_id, location, flags, lefts, rest, rights, lparen_loc, rparen_loc, operator_loc, value)\n"
