    ++ "  #\n"
    ++ "  #     for a, b in [[1, 2], [3, 4]]\n"
    ++ "  #         ^^^^\n"
    ++ "  class MultiTargetNode < Node\n"
    ++ "    # Initialize a new MultiTargetNode node.\n"
    ++ "    def initialize(source, node_id, location, flags, lefts, rest, rights, lparen_loc, rparen_loc)\n"
    ++ "      @source = source\n"
    ++ "      @node_id = node_id\n"
