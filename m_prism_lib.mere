    ++ "\n"
    ++ "      # Configure the lines field for this repository and return self.\n"
    ++ "      def lines\n"
    ++ "        field(:lines, LinesField.new)\n"
    ++ "      end\n"
    ++ "\n"
    ++ "      # Configure the offsets field for this repository and return self.\n"
    ++ "      def offsets\n"
    ++ "        field(:offsets, OffsetsField.new)\n"
    ++ "      end\n"
    ++ "\n"
