    ++ "\n"
    ++ "        # ```\n"
    ++ "        # true\n"
    ++ "        # ^^^^\n"
    ++ "        # ```\n"
    ++ "        def visit_true_node(node)\n"
    ++ "          s(node, :true)\n"
    ++ "        end\n"
    ++ "\n"
    ++ "        # ```\n"
    ++ "        # undef foo\n"
    ++ "        # ^^^^^^^^^\n"
    ++ "        # ```\n"
    ++ "        def visit_undef_node(node)\n"
