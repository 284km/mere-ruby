    ++ "        (statements === other.statements) &&\n"
    ++ "        (subsequent === other.subsequent) &&\n"
    ++ "        (end_keyword_loc.nil? == other.end_keyword_loc.nil?)\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  # Represents an imaginary number literal.\n"
    ++ "  #\n"
    ++ "  #     1.0i\n"
    ++ "  #     ^^^^\n"
    ++ "  class ImaginaryNode < Node\n"
    ++ "    # Initialize a new ImaginaryNode node.\n"
