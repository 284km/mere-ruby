    ++ "      deprecated(\"binary_operator_loc\")\n"
    ++ "      binary_operator_loc\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  class CaseMatchNode < Node\n"
    ++ "    # Returns the else clause of the case match node. This method is deprecated\n"
    ++ "    # in favor of #else_clause.\n"
    ++ "    def consequent\n"
    ++ "      deprecated(\"else_clause\")\n"
    ++ "      else_clause\n"
    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  class CaseNode < Node\n"
