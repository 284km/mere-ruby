    ++ "    end\n"
    ++ "  end\n"
    ++ "\n"
    ++ "  class InterpolatedRegularExpressionNode < Node\n"
    ++ "    def newline_flag!(lines) # :nodoc:\n"
    ++ "      first = parts.first\n"
    ++ "      first.newline_flag!(lines) if first\n"
