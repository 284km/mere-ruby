    ++ "    attr_reader :lefts\n"
    ++ "\n"
    ++ "    # Represents a splat node in the target expression.\n"
    ++ "    #\n"
    ++ "    #     a, b, *c = 1, 2, 3, 4\n"
    ++ "    #           ^^\n"
    ++ "    #\n"
    ++ "    # The variable can be empty, this results in a `SplatNode` with a `nil` expression field.\n"
    ++ "    #\n"
    ++ "    #     a, b, * = 1, 2, 3, 4\n"
    ++ "    #           ^\n"
    ++ "    #\n"
