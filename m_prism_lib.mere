    ++ "\n"
    ++ "    # The value to write to the targets. It can be any [non-void expression](https://github.com/ruby/prism/blob/main/docs/parsing_rules.md#non-void-expression).\n"
    ++ "    #\n"
    ++ "    #     a, b, c = 1, 2, 3\n"
    ++ "    #               ^^^^^^^\n"
