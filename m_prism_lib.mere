    ++ "  end\n"
    ++ "\n"
    ++ "  # Represents writing to a local variable.\n"
    ++ "  #\n"
    ++ "  #     foo = 1\n"
    ++ "  #     ^^^^^^^\n"
    ++ "  class LocalVariableWriteNode < Node\n"
