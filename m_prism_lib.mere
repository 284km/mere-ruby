    ++ "  end\n"
    ++ "\n"
    ++ "  # Represents a block argument using `&`.\n"
    ++ "  #\n"
    ++ "  #     bar(&args)\n"
    ++ "  #     ^^^^^^^^^^\n"
    ++ "  class BlockArgumentNode < Node\n"
