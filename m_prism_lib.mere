    ++ "  # The C extension is the default backend on CRuby.\n"
    ++ "  Prism::BACKEND = :CEXT\n"
    ++ "\n"
    ++ "  require \"prism/prism\"\n"
    ++ "else\n"
    ++ "  # The FFI backend is used on other Ruby implementations.\n"
    ++ "  Prism::BACKEND = :FFI\n"
    ++ "\n"
    ++ "  require_relative \"prism/ffi\"\n"
    ++ "end\n"
  else if str_eq n "prism/compiler" then
    "# frozen_string_literal: true\n"
