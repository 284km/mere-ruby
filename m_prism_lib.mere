    ++ "          else\n"
    ++ "            delimiters = Regexp.escape(\"#\{delimiter\}#\{DELIMITER_SYMETRY[delimiter]\}\")\n"
    ++ "            string.gsub(/\\\\([\\\\#\{delimiters\}])/, '\\1')\n"
    ++ "          end\n"
    ++ "        end\n"
    ++ "\n"
    ++ "        # Certain strings are merged into a single string token.\n"
    ++ "        def simplify_string?(value, quote)\n"
    ++ "          case quote\n"
    ++ "          when \"'\"\n"
    ++ "            # Only simplify 'foo'\n"
    ++ "            !value.include?(\"\\n\")\n"
    ++ "          when '\"'\n"
