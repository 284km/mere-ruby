    ++ "      compact << constant if constant\n"
    ++ "      compact.concat(elements)\n"
    ++ "      compact << rest if rest\n"
    ++ "      compact\n"
    ++ "    end\n"
    ++ "\n"
    ++ "    # def comment_targets: () -> Array[Node | Location]\n"
