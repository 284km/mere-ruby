    ++ "    #     a, b, = 1, 2, 3, 4\n"
    ++ "    #         ^\n"
    ++ "    attr_reader :rest\n"
    ++ "\n"
    ++ "    # Represents the targets expressions after a splat node.\n"
    ++ "    #\n"
    ++ "    #     a, *, b, c = 1, 2, 3, 4, 5\n"
    ++ "    #           ^^^^\n"
    ++ "    attr_reader :rights\n"
    ++ "\n"
    ++ "    # The location of the opening parenthesis.\n"
    ++ "    #\n"
    ++ "    #     (a, b, c) = 1, 2, 3\n"
    ++ "    #     ^\n"
    ++ "    def lparen_loc\n"
    ++ "      location = @lparen_loc\n"
    ++ "      case location\n"
