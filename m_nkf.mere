// NKF's portable engine boundary. Each phase is atomic; Ruby string coercions
// occur between phases in main.mere, preserving nested-call ordering.
import "m_digest.mere";
import "m_nkf_lib.mere";

extern fn mr_nkf_reset: int -> int;
extern fn mr_nkf_options: str -> int;
extern fn mr_nkf_convert: bytes -> int;
extern fn mr_nkf_guess: bytes -> int;
extern fn mr_nkf_result: unit -> bytes;
extern fn mr_nkf_encoding_bytes: unit -> bytes;
extern fn mr_nkf_base_encoding_bytes: unit -> bytes;
extern fn mr_nkf_clear_result: unit -> int;
extern fn mr_nkf_cleanup: unit -> int;

let nkf_loaded =
  (let v = vec_new () in
   let _ = vec_push v 0 in
   let _ = vec_push v 0 in
   let _ = vec_push v 0 in
   let _ = vec_compact v in
   v);
let nkf_entry_index = fn (name: str) -> if str_eq name "nkf" then 1 else if str_eq name "guess" then 2 else 0;
let nkf_function = fn (name: str) ->
  vec_get nkf_loaded 0 != 0 && (let i = nkf_entry_index name in i > 0 && vec_get nkf_loaded i != 0);
let nkf_class_function = fn (name: str) ->
  vec_get nkf_loaded 0 != 0 && (let i = nkf_entry_index name in i > 0 && vec_get nkf_loaded i >= 2);
let nkf_instance_function = fn (name: str) ->
  vec_get nkf_loaded 0 != 0 && (let i = nkf_entry_index name in i > 0 && vec_get nkf_loaded i % 2 == 1);
let nkf_module = fn (cls: str) ->
  vec_get nkf_loaded 0 != 0 &&
  (str_eq cls "NKF" || (map_has cls_copy_of cls && str_eq (map_get cls_copy_of cls) "NKF"));
let nkf_native_owner = fn (cls: str) -> fn (name: str) ->
  (nkf_instance_function name && nkf_module cls)
  || (nkf_class_function name && str_len cls > 6 && str_starts_with cls "(sng:"
      && nkf_module (substring cls 5 (str_len cls - 1)));
let nkf_lib_src = fn (u: unit) -> "module NKF; end; NKF.__native_init\n";
